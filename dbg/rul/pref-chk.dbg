        1   block-level on error undo, throw.
        2   define input parameter p-mode as character no-undo .
        3   define input parameter p-from as character no-undo .
        4   define input parameter p-dtm-code as integer no-undo .
        5   define input parameter p-dt-code as integer no-undo .
        6   define output parameter p-ok as logical no-undo .
        7   define output parameter p-mess as character no-undo .
        8   define variable vss-revision    as character no-undo init "$Revision$":U .
        9   define variable vss-author      as character no-undo init "$Author$":U .
       10   define variable vss-date        as character no-undo init "$Date$":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       12   define variable vss-archive     as character no-undo init "$Archive$":U .
       13   define variable vss-description as character no-undo init "Проверка наличия привязок к prop-ref".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       73   define variable v-waitfram-action01         as character   no-undo .
       74   define variable v-waitfram-action02         as character   no-undo .
       75   define variable v-waitfram-action03         as character   no-undo .
       76   define variable mWaitFramTextBeg            as character   no-undo.
       77   define variable mWaitFramTextEnd            as character   no-undo.
       78   define variable mWaitFramView               as logical     no-undo.
       79   define variable mWaitProcEvent              as logical     no-undo init yes.
       80   define variable mWaitFramInterval           as integer     no-undo init 1 .
       81   define variable mWaitFramStop               as logical     no-undo.
       82   define variable mWaitFramStopUser           as logical     no-undo.
       83   define variable mWaitFramStopTimeOut        as logical     no-undo.
       84   define variable mWaitFramStartProc          as datetime-tz no-undo.
       85   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       86   define button B-WaitFramStop auto-end-key
       87        label "Стоп"
       88        size 10 by 1 tooltip "Остоновить процесс".
       89   define button B-viewProcInfo
       90        label "Информация"
       91        size 15 by 1 tooltip "Информация о процесс".
       92   define frame waitfram
       93     v-waitfram-action01 format "x(72)" no-label skip
       94     v-waitfram-action02 format "x(72)" no-label skip
       95     v-waitfram-action03 format "x(72)" no-label skip
       96     B-viewProcInfo
       97     B-WaitFramStop at row 4 col 30
       98     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       99     .
      100   define new global shared variable mBatchMode as logical no-undo init ?.
      101   define variable mFramBachModHandle as handle no-undo.
      102   mFramBachModHandle = frame waitfram:handle.
      103   define variable mFameOldVis as logical no-undo.
      104   define variable mVisCUrentVin as logical no-undo.
      105   if session:batch-mode
      106   then
      107      mBatchMode = yes.
      108   if mBatchMode = ? then do:
      109     mVisCUrentVin = current-window:visible.
      110     mFameOldVis = mFramBachModHandle:visible.
      111     mFramBachModHandle:visible  = yes.
      112     mBatchMode = mFramBachModHandle:visible ne yes.
      113     mFramBachModHandle:visible = mFameOldVis.
      114     current-window:visible = mVisCUrentVin.
      115   end.
      116    if  log-manager:logfile-name ne ?
      117     then DO:
      118         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      119         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      120         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      121     end.
      122   on choose of B-WaitFramStop in frame waitfram
      123   do:
      124     mWaitFramStop = yes.
      125     mWaitFramStopUser = yes.
      126   end.
      127   function waitfram-check-timeout returns logical():
      128      define variable vtime as int64 no-undo.
      129      if mWaitFramStopTimeOut
      130      then
      131         return yes.
      132      vtime = ( now - mWaitFramStartProc ) / 1000 .
      133      if     mWaitFramTimeOut ne ?
      134         and mWaitFramTimeOut ne 0
      135         and mWaitFramTimeOut lt vtime
      136      then do:
      137         mWaitFramStopTimeOut = yes.
      138      end.
      139      return mWaitFramStopTimeOut.
      140   end.
      141   procedure waitfram-hide :
      142     if not session:batch-mode
      143     then do
      144     on error undo, return error return-value
      145     :
      146       pause 0 before-hide .
      147       if not mBatchMode then
      148         hide frame waitfram .
      149     if     not mWaitFramView
      150        and mWaitProcEvent
      151     then
      152       process events .
      153     end.
      154   end procedure.
      155   procedure waitfram-show :
      156     define input  parameter p-message as character no-undo .
      157     define variable v-left-margin as integer   no-undo .
      158     if not session:batch-mode
      159     then do
      160     on error undo, return error return-value
      161     :
      162       if length(p-message) <= 70 then do:
      163         assign
      164           v-left-margin = integer((70 - length(p-message)) / 2)
      165         .
      166         assign
      167           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      168         .
      169         assign
      170           v-waitfram-action01 = " "
      171           v-waitfram-action02 = " "
      172                                    + fill(" ", v-left-margin)
      173                                    + p-message
      174           v-waitfram-action03 = " "
      175         .
      176       end.
      177       else do:
      178         define variable vRindex1 as integer no-undo.
      179         define variable vRindex2 as integer no-undo.
      180         vRindex1 = r-index(p-message," ",70).
      181         if vRindex1 = 0
      182         then
      183            vRindex1 = 70.
      184         if length(p-message)  <= vRindex1 + 70 then do:
      185           assign
      186             v-waitfram-action01 = " "
      187             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      188             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      189           .
      190         end.
      191         else do:
      192           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      193           if vRindex2 <= vRindex1
      194           then
      195              vRindex2 = vRindex1 + 70.
      196           assign
      197             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      198             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      199             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      200           .
      201         end.
      202       end.
      203       B-viewProcInfo:visible   in frame waitfram = no.
      204       B-viewProcInfo:sensitive in frame waitfram = no.
      205       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      206       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      207       if  (   mWaitFramView
      208          or  mWaitProcEvent)
      209          and not mBatchMode
      210       then
      211          display
      212             v-waitfram-action01 skip
      213             v-waitfram-action02 skip
      214             v-waitfram-action03 skip
      215          with frame waitfram .
      216       if     mWaitFramView
      217          then do:
      218             if     mWaitFramInterval ne ?
      219                and not mBatchMode
      220             then
      221                wait-for go of frame waitfram pause mWaitFramInterval.
      222          end.
      223          else
      224             if     mWaitProcEvent
      225                and not mBatchMode
      226             then
      227                process events .
      228     end.
      229   end procedure.
      230      procedure waitfram-show-this:
      231         define input  parameter iInterval as int64 no-undo.
      232         define variable vtime as int64 no-undo.
      233         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      234         mWaitFramInterval = iInterval.
      235         run waitfram-show (substitute("&1&2 &3&4" ,
      236                                       mWaitFramTextBeg ,
      237                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      238                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      239                                       mWaitFramTextEnd
      240                                      )
      241                           ).
      242      end.
      243      procedure WaitFramRunPause:
      244         define input  parameter iInterval as dec no-undo.
      245         define variable vStart  as datetime-tz no-undo.
      246         define variable vend    as datetime-tz no-undo.
      247         define variable vint as int64 no-undo.
      248         define variable vOk as logical no-undo.
      249         vStart = now.
      250         vend   = vStart.
      251         publish "WaitFramPause" (iInterval,output vOk).
      252         vend   =  now.
      253         vint = vend - vStart.
      254         vint = iInterval - vint / 1000.
      255         if     not mWaitFramStop
      256            and (   vint > 0
      257                 or (    not vOk
      258                     and iInterval eq ?
      259                     )
      260                 )
      261         then
      262            run waitfram-show-this (iInterval).
      263         vend   =  now.
      264         vint = vend - vStart.
      265         vint = iInterval - vint / 1000.
      266         if     not mWaitFramStop
      267            and vint > 0
      268         then do:
      269            run gbl/pause.p (vint * 1000).
      270         end.
      271         if iInterval ne ?
      272         then
      273            publish "WaitFramStop".
      274         waitfram-check-timeout().
      275      end.
      276      procedure WaitFramWaitFor:
      277         define input  parameter iInterval as dec no-undo.
      278         assign
      279            mWaitFramStartProc   = now
      280            mWaitFramStopUser    = no
      281            mWaitFramStopTimeOut = no
      282         .
      283         block-wait:
      284         do while not mWaitFramStop:
      285            run WaitFramRunPause (iInterval).
      286            if  waitfram-check-timeout()
      287            then do:
      288               leave block-wait.
      289            end.
      290         end.
      291         run waitfram-hide.
      292      end.
      293   procedure waitfram-join :
      294     define input  parameter p-line-1  as character no-undo .
      295     define input  parameter p-line-2  as character no-undo .
      296     define input  parameter p-line-3  as character no-undo .
      297     define output parameter p-message as character no-undo .
      298     do
      299     on error undo, return error return-value
      300     :
      301       assign
      302         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      303                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      304                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      305       .
      306     end.
      307   end procedure.
      308   function waitfram-join-function returns character
      309     (input p-line-1 as character
      310     ,input p-line-2 as character
      311     ,input p-line-3 as character
      312     ).
      313     define variable v-message as character no-undo .
      314     run waitfram-join in this-procedure
      315       (input  p-line-1
      316       ,input  p-line-2
      317       ,input  p-line-3
      318       ,output v-message
      319       ) .
      320     return v-message .
      321   end function .
      322   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      323   procedure gen-key-rec :
      324     define input  parameter p-tbl-name    as character no-undo.
      325     define input  parameter p-bh_tbl-name as handle    no-undo.
      326     define output parameter p-key-rec     as character no-undo.
      327     do
      328     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      329     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      330     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      331     :
      332       define variable fh               as handle    no-undo .
      333       define variable v-ok             as logical   no-undo .
      334       define variable v-inform         as character no-undo .
      335       define variable v-ind            as integer   no-undo .
      336       define variable v-idx-field-qnty as integer   no-undo .
      337       if p-tbl-name = ?
      338         or p-tbl-name = "":U
      339       then do:
      340         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info1 ).
      341       end.
      342       if not p-bh_tbl-name:available then do:
      343         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info1, p-tbl-name ).
      344       end.
      345       assign
      346         p-key-rec = p-tbl-name
      347         v-inform  = p-bh_tbl-name:index-information(1)
      348         v-ind     = 2
      349       .
      350       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      351       on error undo, return error
      352       :
      353         assign
      354           v-inform = p-bh_tbl-name:index-information( v-ind )
      355           v-ind    = v-ind + 1
      356         .
      357       end.
      358       if v-inform = ?
      359         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      360         or entry( 3, v-inform, ",":U ) <> "1":U
      361       then do:
      362         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, p-tbl-name ).
      363       end.
      364       else do:
      365         assign
      366           v-idx-field-qnty = num-entries( v-inform ) - 4
      367         .
      368         if v-idx-field-qnty < 2 then do:
      369           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, p-tbl-name ).
      370         end.
      371         do v-ind = 1 to v-idx-field-qnty by 2
      372         on error undo, return error
      373         :
      374           assign
      375             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      376             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      377           .
      378         end.
      379       end.
      380       if p-key-rec = ? then do:
      381         assign
      382           p-key-rec = "":U
      383         .
      384         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info1, p-tbl-name ).
      385       end.
      386     end.
      387     return.
      388   end procedure.
      389   procedure gen-where-keyr-tab :
      390     define input  parameter i-tableSerach as character no-undo.
      391     define input  parameter i-tablekey   as character  no-undo.
      392     define input  parameter p-key-rec    as character  no-undo.
      393     define input  parameter p-key-handle as handle     no-undo .
      394     define input  parameter p-db-name    as character  no-undo .
      395     define input  parameter p-tt-handle  as handle     no-undo .
      396     define output parameter o-Where      as character  no-undo.
      397     do
      398     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      399     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      400     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      401     :
      402       define variable v-full-tbl-name  as character no-undo .
      403       define variable bh_tbl-name      as handle    no-undo .
      404       define variable fh_key           as handle    no-undo .
      405       define variable fh_search        as handle    no-undo .
      406       define variable v-field-num      as integer   no-undo .
      407       define variable v-count-fld      as integer   no-undo .
      408       define variable v-inform         as character no-undo .
      409       define variable v-ind            as integer   no-undo .
      410       define variable v-idx-field-qnty as integer   no-undo .
      411       define variable v-field-name     as character no-undo .
      412       define variable v-field-val      as character no-undo .
      413       define variable v-word-link      as character no-undo .
      414       define variable vTable           as character no-undo.
      415       define variable bh_tbl-key       as handle    no-undo .
      416       assign
      417         p-key-rec = trim( p-key-rec )
      418       .
      419       if p-key-handle <> ? then do:
      420         if not valid-handle(p-key-handle)
      421            or p-key-handle:type <> "buffer"
      422         then do:
      423           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info1 ).
      424         end.
      425         if num-entries( p-key-rec, chr(3) ) > 1
      426           or p-key-rec = ?
      427           or p-key-rec = "":U
      428         then do:
      429           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info1, p-key-rec ).
      430         end.
      431       end.
      432       else do:
      433         if p-key-rec = ?
      434           or p-key-rec = "":U
      435         then do:
      436           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      437         end.
      438       end.
      439       assign
      440         vTable = entry( 1 , p-key-rec, chr(3) )
      441       .
      442       if p-tt-handle <> ?
      443         and ( not valid-handle(p-tt-handle)
      444               or p-tt-handle:type <> "buffer"
      445             )
      446       then do:
      447         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info1, vTable, chr(10) ).
      448       end.
      449       if p-tt-handle = ? then do:
      450         assign
      451           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      452         .
      453         create buffer bh_tbl-name for table v-full-tbl-name .
      454       end.
      455       else do:
      456         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      457       end.
      458       assign
      459         v-inform = bh_tbl-name:index-information(1)
      460         v-ind    = 2
      461       .
      462       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      463       on error undo, return error
      464       :
      465         assign
      466           v-inform = bh_tbl-name:index-information( v-ind )
      467           v-ind    = v-ind + 1
      468         .
      469       end.
      470       if v-inform = ?
      471         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      472         or entry( 3, v-inform, ",":U ) <> "1":U
      473       then do:
      474         delete object bh_tbl-name no-error.
      475         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info1, vTable ).
      476       end.
      477       assign
      478         v-idx-field-qnty = num-entries( v-inform ) - 4
      479       .
      480       if v-idx-field-qnty < 2 then do:
      481         delete object bh_tbl-name no-error.
      482         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, vTable ).
      483       end.
      484       assign
      485         o-where     = "where":U
      486         v-word-link = "":U
      487         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      488         v-count-fld = 0
      489       .
      490       if i-tablekey ne "" and i-tablekey ne ?
      491       then do:
      492         assign
      493           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      494         .
      495         create buffer bh_tbl-key for table v-full-tbl-name .
      496       end.
      497       if i-tableSerach ne "" and i-tableSerach ne ?
      498       then do:
      499         delete object bh_tbl-name no-error.
      500         assign
      501           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      502         .
      503         create buffer bh_tbl-name for table v-full-tbl-name .
      504       end.
      505       block_where:
      506       do v-ind = 1 to v-idx-field-qnty by 2
      507       on error undo, return error
      508       :
      509         assign
      510           v-count-fld = v-count-fld + 1
      511         .
      512         if p-key-handle = ?
      513           and v-count-fld > v-field-num
      514         then do:
      515           leave block_where.
      516         end.
      517         define variable VfieldKeyTable as handle no-undo.
      518         assign
      519           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      520           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      521         .
      522         if     bh_tbl-key ne ?
      523         then do:
      524            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      525            if VfieldKeyTable eq ?
      526            then next block_where.
      527         end.
      528         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      529         then
      530            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      531         else
      532            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      533         if p-key-handle = ? then do:
      534           assign
      535             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      536           .
      537         end.
      538         else do:
      539           assign
      540             fh_key = p-key-handle:buffer-field( v-field-name )
      541           .
      542           if fh_key = ?
      543             or not valid-handle( fh_key )
      544           then do:
      545             delete object bh_tbl-name.
      546             if     bh_tbl-key ne ?
      547             then
      548                delete object bh_tbl-key.
      549             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info1, p-key-handle:name, v-field-name ).
      550           end.
      551           assign
      552             v-field-val = fh_key:buffer-value
      553           .
      554         end.
      555         if fh_search:data-type ="character":U then do:
      556           assign
      557             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      558             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      559             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      560             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      561             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      562             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      563             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      564             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      565             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      566             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      567             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      568             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      569             v-field-val = substitute( '"&1"', v-field-val )
      570           .
      571         end.
      572         assign
      573           o-where = substitute( "&1 &2", o-where, v-field-val )
      574         .
      575         if v-word-link = "":U then do:
      576           assign
      577             v-word-link = "and":U
      578           .
      579         end.
      580       end.
      581       delete object bh_tbl-name.
      582       if     bh_tbl-key ne ?
      583       then
      584          delete object bh_tbl-key.
      585       if p-key-handle = ?
      586         and v-count-fld <> v-field-num
      587       then do:
      588         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info1, vTable ).
      589       end.
      590     end.
      591   end procedure.
      592   procedure gen-hn-keyr-tab :
      593     define input  parameter i-tableSerach as character no-undo.
      594     define input  parameter i-tablekey   as character no-undo.
      595     define input  parameter p-key-rec    as character no-undo.
      596     define input  parameter p-key-handle as handle    no-undo .
      597     define input  parameter p-db-name    as character no-undo .
      598     define input  parameter p-tt-handle  as handle    no-undo .
      599     define input  parameter p-stts-lock  as integer   no-undo .
      600     define output parameter o-hn         as handle    no-undo.
      601     define variable v-full-tbl-name as character no-undo.
      602     define variable v-where         as character no-undo.
      603     define variable bh_tbl-name     as handle    no-undo.
      604     define variable vTable          as character no-undo.
      605     do
      606     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      607     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      608     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      609         run gen-where-keyr-tab(i-tableSerach,
      610                                i-tablekey,
      611                                p-key-rec,
      612                                p-key-handle,
      613                                p-db-name,
      614                                p-tt-handle,
      615                                output v-where).
      616         if i-tableSerach ne "" and i-tableSerach ne ?
      617         then do:
      618            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      619            create buffer bh_tbl-name for table v-full-tbl-name .
      620         end.
      621         else do:
      622            if p-tt-handle = ? then do:
      623               assign
      624                  vTable = entry( 1 , p-key-rec, chr(3) )
      625               .
      626               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      627               create buffer bh_tbl-name for table v-full-tbl-name .
      628            end.
      629            else do:
      630               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      631            end.
      632         end.
      633         if p-tt-handle = ? then do:
      634            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      635         end.
      636         else do:
      637            bh_tbl-name:find-first( v-where ) no-error .
      638         end.
      639         o-hn = bh_tbl-name.
      640      end.
      641   end procedure.
      642   procedure gen-hn-keyr :
      643     define input  parameter p-key-rec    as character no-undo.
      644     define input  parameter p-key-handle as handle    no-undo .
      645     define input  parameter p-db-name    as character no-undo .
      646     define input  parameter p-tt-handle  as handle    no-undo .
      647     define input  parameter p-stts-lock  as integer   no-undo .
      648     define output parameter o-hn         as handle    no-undo.
      649     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      650   end.
      651   procedure gen-row-keyr :
      652     define input  parameter p-key-rec    as character no-undo.
      653     define input  parameter p-key-handle as handle    no-undo .
      654     define input  parameter p-db-name    as character no-undo .
      655     define input  parameter p-tt-handle  as handle    no-undo .
      656     define input  parameter p-stts-lock  as integer   no-undo .
      657     define output parameter p-tbl-row    as rowid     no-undo.
      658     define output parameter p-tbl-name   as character no-undo.
      659     define variable vHn as handle no-undo.
      660       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      661       p-tbl-row = if vHn:available then vHn:rowid else ?.
      662       p-tbl-name =  vHn:table.
      663       delete object vHn no-error.
      664     if p-tbl-row = ? then do:
      665       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info1, p-tbl-name, p-key-rec ).
      666     end.
      667     else do:
      668       return.
      669     end.
      670   end procedure.
      671   procedure gen-key-fv :
      672     define input  parameter p-key-rec    as character no-undo .
      673     define output parameter p-field-list as character no-undo .
      674     define output parameter p-value-list as character no-undo.
      675     do
      676     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      677     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      678     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      679     :
      680       define variable v-full-tbl-name  as character no-undo .
      681       define variable bh_tbl-name      as handle    no-undo .
      682       define variable v-tbl-name       as character no-undo .
      683       define variable v-field-num      as integer   no-undo .
      684       define variable v-count-fld      as integer   no-undo .
      685       define variable v-inform         as character no-undo .
      686       define variable v-ind            as integer   no-undo .
      687       define variable v-idx-field-qnty as integer   no-undo .
      688       define variable v-delim-key      as character no-undo .
      689       if p-key-rec = ?
      690         or p-key-rec = "":U
      691       then do:
      692         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      693       end.
      694       assign
      695         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      696         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      697       .
      698       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      699       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info1 ).
      700       assign
      701         v-inform = bh_tbl-name:index-information(1)
      702         v-ind    = 2
      703       .
      704       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      705       on error undo, return error
      706       :
      707         assign
      708           v-inform = bh_tbl-name:index-information( v-ind )
      709           v-ind    = v-ind + 1
      710         .
      711       end.
      712       if v-inform = ?
      713         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      714         or entry( 3, v-inform, ",":U ) <> "1":U
      715       then do:
      716         delete object bh_tbl-name no-error.
      717         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      718       end.
      719       assign
      720         v-idx-field-qnty = num-entries( v-inform ) - 4
      721       .
      722       if v-idx-field-qnty < 2 then do:
      723         delete object bh_tbl-name no-error.
      724         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      725       end.
      726       assign
      727         p-field-list = "":U
      728         p-value-list = "":U
      729         v-delim-key  = "":U
      730         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      731         v-count-fld  = 0
      732       .
      733       block_where:
      734       do v-ind = 1 to v-idx-field-qnty by 2
      735       on error undo, return error
      736       :
      737         assign
      738           v-count-fld = v-count-fld + 1
      739         .
      740         if v-count-fld > v-field-num then do:
      741           leave block_where.
      742         end.
      743         assign
      744           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      745           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      746         .
      747         if v-ind = 1 then do:
      748           assign
      749             v-delim-key = chr(3)
      750           .
      751         end.
      752       end.
      753       delete object bh_tbl-name.
      754       if v-count-fld <> v-field-num then do:
      755         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info1, v-tbl-name ).
      756       end.
      757     end.
      758   end procedure.
      759   procedure gen-key-field :
      760     define input  parameter p-table      as character no-undo .
      761     define output parameter p-field-list as character no-undo .
      762     do
      763     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      764     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      765     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      766     :
      767       define variable v-full-tbl-name  as character no-undo .
      768       define variable bh_tbl-name      as handle    no-undo .
      769       define variable v-tbl-name       as character no-undo .
      770       define variable v-field-num      as integer   no-undo .
      771       define variable v-count-fld      as integer   no-undo .
      772       define variable v-inform         as character no-undo .
      773       define variable v-ind            as integer   no-undo .
      774       define variable v-idx-field-qnty as integer   no-undo .
      775       define variable v-delim-key      as character no-undo .
      776       if p-table = ?
      777         or p-table = "":U
      778       then do:
      779         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info1 ).
      780       end.
      781       assign
      782         v-tbl-name      = p-table
      783         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      784       .
      785       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      786       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info1 ).
      787       assign
      788         v-inform = bh_tbl-name:index-information(1)
      789         v-ind    = 2
      790       .
      791       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      792       on error undo, return error
      793       :
      794         assign
      795           v-inform = bh_tbl-name:index-information( v-ind )
      796           v-ind    = v-ind + 1
      797         .
      798       end.
      799       if v-inform = ?
      800         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      801         or entry( 3, v-inform, ",":U ) <> "1":U
      802       then do:
      803         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      804       end.
      805       assign
      806         v-idx-field-qnty = num-entries( v-inform ) - 4
      807       .
      808       if v-idx-field-qnty < 2 then do:
      809         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      810       end.
      811       assign
      812         p-field-list = "":U
      813         v-delim-key  = "":U
      814         v-count-fld  = 0
      815       .
      816       block_where:
      817       do v-ind = 1 to v-idx-field-qnty by 2
      818       on error undo, return error
      819       :
      820         assign
      821           v-count-fld = v-count-fld + 1
      822         .
      823         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      824         if v-ind = 1 then do:
      825           assign
      826             v-delim-key = chr(3)
      827           .
      828         end.
      829       end.
      830       delete object bh_tbl-name.
      831     end.
      832   end procedure.
      833   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      834   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      835   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      836   FUNCTION get-region RETURNS CHARACTER
      837     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
      838     define variable par-region as character no-undo.
      839     if parhost-code = 0 and
      840          parobj-type = "":U and
      841          parobj-code = 0 then do:
      842          par-region = "Глобально".
      843          return par-region.
      844       end.
      845       if parobj-type = 'орг':U then do:
      846          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
      847          return par-region.
      848       end.
      849       if parobj-type = 'регион':U
      850       then do:
      851          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      852          return par-region.
      853       end.
      854       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      855       return par-region.
      856   END FUNCTION.
      857   FUNCTION get-objregion RETURNS CHARACTER
      858     (  input parobj-type as character, input parobj-code as integer ) :
      859     define variable par-region as character no-undo.
      860     if  parobj-type = "":U and
      861         parobj-code = 0
      862     then do:
      863        par-region = "Глобально".
      864     end.
      865     else if parobj-type = 'орг':U
      866     then do:
      867        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
      868     end.
      869     else if parobj-type = 'регион':U
      870     then do:
      871        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      872     end.
      873     else
      874        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      875     return par-region.
      876   END FUNCTION.
      877   FUNCTION calldscr returns character ( input p-call-id as character):
      878   define variable v-descr as character no-undo .
      879   define variable v-field-list as character no-undo .
      880   define variable v-value-list as character no-undo.
      881   define variable v-prop-label as character no-undo .
      882   define variable v-node-label as character no-undo .
      883   define variable v-dt-code as integer no-undo .
      884   define variable v-host-code as integer no-undo .
      885   define variable v-obj-type as character no-undo .
      886   define variable v-obj-code as integer no-undo .
      887   define variable v-label as character no-undo .
      888   define variable v-node-code as integer no-undo .
      889   define buffer buf_prop-head for ub.prop-head.
      890   define buffer buf_prop-ref for ub.prop-ref.
      891   define buffer buf_prop-map for ub.prop-map.
      892   run gen-key-fv in this-procedure ( input p-call-id
      893                                     ,output v-field-list
      894                                     ,output v-value-list) no-error .
      895   if error-status:error then return p-call-id.
      896   CASE entry(1, p-call-id, chr(3)):
      897     when 'dis-card-type':U then do:
      898       v-descr = substitute("Тип ДК: эмитент &1 тип: &2"
      899                            ,integer(entry(lookup("emitent-host-code", v-field-list, chr(3)), v-value-list, chr(3)) )
      900                            ,entry(lookup("type", v-field-list, chr(3)), v-value-list, chr(3))
      901                            ).
      902     end.
      903     when 'dis-card':U then do:
      904       v-descr = substitute("ДК: № &1"
      905                            ,entry(lookup("d-card", v-field-list, chr(3)), v-value-list, chr(3))
      906                            ).
      907     end.
      908     when 'dis-card-property':U then do:
      909       v-dt-code = integer(entry(lookup("dt-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
      910       v-node-code = integer(entry(lookup("node-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
      911       v-host-code = integer(entry(lookup("host-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
      912       v-obj-type = entry(lookup("obj-type", v-field-list, chr(3)), v-value-list, chr(3)) .
      913       v-obj-code = integer(entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
      914       find first buf_prop-ref no-lock where
      915                 buf_prop-ref.dt-code = v-dt-code no-error .
      916       if available buf_prop-ref then do:
      917         find first buf_prop-head no-lock where
      918                   buf_prop-head.dtm-code = buf_prop-ref.dtm-code no-error .
      919         v-prop-label = buf_prop-head.prop-label.
      920         find first buf_prop-map no-lock where
      921                   buf_prop-map.dtm-code = buf_prop-ref.dtm-code
      922               and buf_prop-map.node-code = v-node-code no-error .
      923         if available buf_prop-map then do:
      924           v-label = buf_prop-map.node-label.
      925         end.
      926       end.
      927       v-descr = substitute("ДК: № &1 &2:&3 &4"
      928                            ,entry(lookup("d-card", v-field-list, chr(3)), v-value-list, chr(3))
      929                            ,v-prop-label
      930                            ,v-label
      931                            ,get-region(v-host-code, v-obj-type, v-obj-code)
      932                            ).
      933     end.
      934     when 'clients':U then do:
      935       v-descr = substitute("&1&2"
      936                            ,entry(lookup("obj-type", v-field-list, chr(3)), v-value-list, chr(3))
      937                            ,integer(entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3)) )
      938                            ).
      939     end.
      940     when 'ext-system':U then do:
      941       v-descr = substitute("Внешняя система &1"
      942                            ,integer(entry(lookup("esys-id", v-field-list, chr(3)), v-value-list, chr(3)))
      943                            ).
      944     end.
      945     WHEN 'thbj-attr':U then do:
      946       if entry(lookup("upper-prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rum':U
      947       or entry(lookup("upper-prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rum_obj':U
      948       then do:
      949         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'goods':U then do:
      950           v-descr = "Операции с товарами".
      951         end.
      952         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'clients':U then do:
      953           v-descr = "Операции с клиентами".
      954         end.
      955         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'gds-grp':U then do:
      956           v-descr = "Операции с группами товаров".
      957         end.
      958         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'cli-grp':U then do:
      959           v-descr = "Операции с группами клиентов".
      960         end.
      961         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'chk-doc_ibs-th':U then do:
      962           v-descr = "Операции с чеками на POS IBS-TH".
      963         end.
      964         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'chk-doc_ibs-th-mob':U then do:
      965           v-descr = "Операции с чеками на POS IBS-TH-MOB".
      966         end.
      967         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'edoc':U then do:
      968           v-descr = "Операции в системе электронного документооборота".
      969         end.
      970         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'thref':U then do:
      971           v-descr = "Операции со справочниками".
      972         end.
      973         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'pdf':U then do:
      974           v-descr = "Операции с ДНЦ и переоценками".
      975         end.
      976         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rep':U then do:
      977           v-descr = "Отчеты".
      978         end.
      979         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'ord':U then do:
      980           v-descr = "Операции с заказами".
      981         end.
      982       end.
      983     end.
      984     when 'cash-desk':U then do:
      985       v-descr = substitute("БД &1 Маг &2 Касса № &4 &3"
      986                            ,entry(lookup("db-num", v-field-list, chr(3)), v-value-list, chr(3))
      987                            ,entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3))
      988                            ,entry(lookup("cash-num", v-field-list, chr(3)), v-value-list, chr(3))
      989                            ,entry(lookup("pos-type", v-field-list, chr(3)), v-value-list, chr(3))
      990                            ).
      991     end.
      992     when 'ext-file':U then do:
      993       v-descr = substitute("БД &1 Файл № &3 (из БД &2)"
      994                            ,entry(lookup("db-num", v-field-list, chr(3)), v-value-list, chr(3))
      995                            ,entry(lookup("from-db-num", v-field-list, chr(3)), v-value-list, chr(3))
      996                            ,entry(lookup("file-num", v-field-list, chr(3)), v-value-list, chr(3))
      997                            ).
      998     end.
      999   end case.
     1000   return v-descr.
     1001   end function.
     1002   define buffer buf_prop-head for ub.prop-head.
     1003   define buffer buf_dis-host for ub.dis-host.
     1004   define buffer buf_dis-obj for ub.dis-obj.
     1005   define buffer buf_dis-card-property for ub.dis-card-property.
     1006   define buffer buf_prop-ref-call for ub.prop-ref-call.
     1007   main-block:
     1008   do
     1009   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1010   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1011   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1012   :
     1013     run waitfram-show in this-procedure ( input "Ждите..." ).
     1014     find first buf_prop-head no-lock where
     1015             buf_prop-head.dtm-code = p-dtm-code.
     1016     CASE buf_prop-head.storage-place:
     1017       when 'dis-host':U then do:
     1018         find first buf_dis-host no-lock where
     1019                   buf_dis-host.dt-code = p-dt-code no-error.
     1020         if available buf_dis-host then do:
     1021           p-mess = substitute("Нельзя удалить срез/итог с кодом &1 - имеются записи в хранилице", p-dt-code ).
     1022           return.
     1023         end.
     1024       end.
     1025       when 'dis-card-property':U then do:
     1026         find first buf_dis-card-property no-lock where
     1027                   buf_dis-card-property.dt-code = p-dt-code no-error.
     1028         if available buf_dis-card-property then do:
     1029           p-mess = substitute("Нельзя удалить срез/итог с кодом &1 - имеются записи в хранилице", p-dt-code ).
     1030           return.
     1031         end.
     1032       end.
     1033     end case.
     1034     CASE buf_prop-head.storage-place-host:
     1035       when 'dis-host':U then do:
     1036         find first buf_dis-host no-lock where
     1037                   buf_dis-host.dt-code = p-dt-code
     1038               and buf_dis-host.host-code > 0
     1039                   no-error.
     1040         if available buf_dis-host then do:
     1041           p-mess = substitute("Нельзя удалить срез/итог с кодом &1 - имеются записи в хранилице", p-dt-code ).
     1042           return.
     1043         end.
     1044       end.
     1045       when 'dis-card-property':U then do:
     1046         find first buf_dis-card-property no-lock where
     1047                   buf_dis-card-property.dt-code = p-dt-code
     1048               and buf_dis-card-property.host-code > 0
     1049                   no-error.
     1050         if available buf_dis-card-property then do:
     1051           p-mess = substitute("Нельзя удалить срез/итог с кодом &1 - имеются записи в хранилице", p-dt-code ).
     1052           return.
     1053         end.
     1054       end.
     1055     end case.
     1056     CASE buf_prop-head.storage-place-obj:
     1057       when 'dis-obj':U then do:
     1058         find first buf_dis-obj no-lock where
     1059                   buf_dis-obj.dt-code = p-dt-code  no-error.
     1060         if available buf_dis-host then do:
     1061           p-mess = substitute("Нельзя удалить срез/итог с кодом &1 - имеются записи в хранилице", p-dt-code ).
     1062           return.
     1063         end.
     1064       end.
     1065       when 'dis-card-property':U then do:
     1066         find first buf_dis-card-property no-lock where
     1067                   buf_dis-card-property.obj-type > '':U
     1068               and buf_dis-card-property.dt-code = p-dt-code
     1069                   no-error.
     1070         if available buf_dis-card-property then do:
     1071           p-mess = substitute("Нельзя удалить срез/итог с кодом &1 - имеются записи в хранилице", p-dt-code ).
     1072           return.
     1073         end.
     1074       end.
     1075     end case.
     1076     if p-from <> "ruprcall" then do:
     1077       find first buf_prop-ref-call no-lock where
     1078                 buf_prop-ref-call.dt-code = p-dt-code no-error.
     1079       if available buf_prop-ref-call
     1080       then do:
     1081         p-mess = substitute("Нельзя удалить срез/итог с кодом &1 - срез используется: &2"
     1082                             , p-dt-code
     1083                             , calldscr(buf_prop-ref-call.call_id) ).
     1084         return.
     1085       end.
     1086     end.
     1087     p-ok = yes.
     1088   end.
