     1902   procedure get-header-by-rec :
     1903   define input  parameter p-gate-rec as character no-undo .
     1904   define output parameter p-tth as handle no-undo .
     1905   define variable v-ii as integer   no-undo .
     1906   define variable glog as logical   no-undo .
     1907   define variable v-rowid as rowid no-undo .
     1908   define variable v-tbl-name as character no-undo .
     1909   define variable v-longchar as longchar no-undo .
     1910   define variable v-txmlh as handle no-undo .
     1911   define buffer buf_clob-data for ub.clob-data.
     1912   main-block:
     1913   do
     1914   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info15, return-value, chr(10), error-status :get-message (1))
     1915   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info15 )
     1916   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info15 )
     1917   :
     1918     run gen-row-keyr in  this-procedure  (
     1919                                           input  p-gate-rec
     1920                                           ,input  ?
     1921                                           ,input  "ub"
     1922                                           ,input  ?
     1923                                           ,input  NO-LOCK
     1924                                           ,output v-rowid
     1925                                           ,output v-tbl-name   ) no-error.
     1926       find first buf_clob-data no-lock where
     1927                 rowid(buf_clob-data) = v-rowid  no-error.
     1928       if not available buf_clob-data then do:
     1929         undo, return error substitute("Не найден CLOB  &1"
     1930                                         , p-gate-rec
     1931                                         ).
     1932       end.
     1933       assign
     1934       v-longchar = buf_clob-data.cdata
     1935       .
     1936       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1937       if error-status :error then do:
     1938         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1939       end.
     1940       create temp-table p-tth .
     1941       glog = p-tth:READ-XMLSCHEMA( "LONGCHAR"
     1942                                     , v-longchar
     1943                                     , ?
     1944                                     , ?
     1945                                     , ?
     1946                                     ) no-error.
     1947       v-longchar = '':U.
     1948       define variable v-esm as character no-undo .
     1949       v-esm = error-status:get-message(1).
     1950       if error-status :error
     1951       or not glog
     1952       then do:
     1953         delete object p-tth no-error.
     1954         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     1955                                    , p-gate-rec
     1956                                    , buf_clob-data.file-name_
     1957                                    , chr(10)
     1958                                    , v-esm
     1959                                     ).
     1960       end.
     1961   end.
     1962   end procedure.
     1963   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1964   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1965   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1966   procedure proc-ord-code :
     1967   define input  parameter  p-type as character no-undo .
     1968   define input  parameter  v-cntxt-db-num   as integer   no-undo .
     1969   define input  parameter  v-cntxt-obj-type as character no-undo .
     1970   define input  parameter  v-cntxt-obj-code as integer   no-undo .
     1971   define input  parameter  p-i-doc    as character no-undo .
     1972   define output parameter  p-ord-doc  as character no-undo .
     1973   define variable          v-idop     as character no-undo .
     1974     do
     1975     on error undo, return error return-value
     1976     :
     1977   case p-type :
     1978       when "main-no-ver" then do:
     1979         if  (v-cntxt-db-num <> 0) then
     1980           p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (v-cntxt-obj-code, ">>>>9")) + substring (v-cntxt-obj-type, (if g#language = "RUS" then 1 else 2), 1).
     1981         else
     1982           p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-".
     1983       end.
     1984       when "main" then do:
     1985             do while true:
     1986             if  (v-cntxt-db-num <> 0) then
     1987               p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (v-cntxt-obj-code, ">>>>9")) + substring (v-cntxt-obj-type, (if g#language = "RUS" then 1 else 2), 1).
     1988             else
     1989               p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-".
     1990             if not can-find (ub.ord-doc where ub.ord-doc.doc-code = p-ord-doc no-lock) then leave.
     1991             End.
     1992       end.
     1993       when "chip" then do:
     1994         assign
     1995           v-idop = p-i-doc .
     1996         do while true :
     1997           if index (v-idop , ".") = 0 then
     1998             v-idop  = replace (v-idop , "-", "-1.").
     1999           else
     2000             v-idop  =
     2001             substring (v-idop , 1, index (v-idop, "-")) +
     2002             string (integer (substring (v-idop, index (v-idop, "-") + 1, index (v-idop, ".") - index (v-idop, "-") - 1)) + 1) +
     2003             substring (v-idop, index (v-idop, ".")).
     2004           if not can-find (ub.ord-doc where ub.ord-doc.doc-code = v-idop no-lock) then leave.
     2005         end.
     2006         assign
     2007           p-ord-doc = v-idop.
     2008       end.
     2009   end case.
     2010     end.
     2011   end procedure.
     2012   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2013   def var vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2014   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2015   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2016   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2017   procedure ordlineattr-value :
     2018     do
     2019     on error undo, return error return-value
     2020     :
     2021       define input  parameter p-doc-code like ub.ord-line-attr.doc-code   no-undo .
     2022       define input  parameter p-gds-code like ub.ord-line-attr.gds-code   no-undo .
     2023       define input  parameter p-code     like ub.ord-line-attr.attr-code  no-undo .
     2024       define output parameter p-value    like ub.ord-line-attr.attr-value no-undo .
     2025       define output parameter p-type     as character no-undo .
     2026       define buffer buf_ord-line-attr for ub.ord-line-attr .
     2027       define variable v-format         as character no-undo .
     2028       define variable v-fillin_width   as integer   no-undo .
     2029       define variable v-fillin_height  as integer   no-undo .
     2030       define variable v-label          as character no-undo .
     2031       define variable v-user-can-edit  as logical   no-undo .
     2032       define variable v-output-display as logical   no-undo .
     2033       define variable v-other          as character no-undo .
     2034       define variable v-proc           as character no-undo .
     2035       define variable v-func           as character no-undo .
     2036       define variable v-sort           as integer   no-undo .
     2037       run ordlineattr-code in this-procedure
     2038         (input  p-code
     2039         ,output p-type
     2040         ,output v-format
     2041         ,output v-fillin_width
     2042         ,output v-fillin_height
     2043         ,output v-label
     2044         ,output v-user-can-edit
     2045         ,output v-output-display
     2046         ,output v-proc
     2047         ,output v-func
     2048         ,output v-sort
     2049         ,output v-other
     2050         ) no-error .
     2051       if error-status :error then do:
     2052         undo, return error return-value .
     2053       end.
     2054       find first buf_ord-line-attr no-lock
     2055         where buf_ord-line-attr.doc-code  = p-doc-code
     2056           and buf_ord-line-attr.gds-code  = p-gds-code
     2057           and buf_ord-line-attr.attr-code = p-code
     2058         no-error .
     2059       if avail buf_ord-line-attr then do:
     2060         assign
     2061           p-value =  buf_ord-line-attr.attr-value
     2062         .
     2063       end.
     2064       else do:
     2065         assign
     2066           p-value = if p-type = 'L':U then "no":U else ""
     2067         .
     2068       end.
     2069     end.
     2070   end procedure.
     2071   procedure ordlineattr-write :
     2072     do
     2073     on error undo, return error return-value
     2074     :
     2075       define input parameter p-doc-code like ub.ord-line-attr.doc-code   no-undo .
     2076       define input parameter p-gds-code like ub.ord-line-attr.gds-code   no-undo .
     2077       define input parameter p-code     like ub.ord-line-attr.attr-code  no-undo .
     2078       define input parameter p-value    like ub.ord-line-attr.attr-value no-undo .
     2079       define buffer buf_ord-line-attr for ub.ord-line-attr .
     2080       define variable v-type           as character no-undo .
     2081       define variable v-format         as character no-undo .
     2082       define variable v-fillin_width   as integer   no-undo .
     2083       define variable v-fillin_height  as integer   no-undo .
     2084       define variable v-label          as character no-undo .
     2085       define variable v-user-can-edit  as logical   no-undo .
     2086       define variable v-output-display as logical   no-undo .
     2087       define variable v-other          as character no-undo .
     2088       define variable v-proc           as character no-undo .
     2089       define variable v-func           as character no-undo .
     2090       define variable v-sort           as integer   no-undo .
     2091       run ordlineattr-code in this-procedure
     2092         (input  p-code
     2093         ,output v-type
     2094         ,output v-format
     2095         ,output v-fillin_width
     2096         ,output v-fillin_height
     2097         ,output v-label
     2098         ,output v-user-can-edit
     2099         ,output v-output-display
     2100         ,output v-proc
     2101         ,output v-func
     2102         ,output v-sort
     2103         ,output v-other
     2104         ) no-error .
     2105       if error-status :error then do:
     2106         message
     2107           vss-workfile vss-revision vss-description skip
     2108           error-status :get-message(1) skip
     2109           return-value skip
     2110           ""
     2111           view-as alert-box error
     2112         .
     2113         undo, return error return-value .
     2114       end.
     2115       find first buf_ord-line-attr exclusive-lock
     2116         where buf_ord-line-attr.doc-code  = p-doc-code
     2117           and buf_ord-line-attr.gds-code  = p-gds-code
     2118           and buf_ord-line-attr.attr-code = p-code
     2119         no-error .
     2120       if not available buf_ord-line-attr then do:
     2121         create buf_ord-line-attr .
     2122         assign
     2123           buf_ord-line-attr.doc-code   = p-doc-code
     2124           buf_ord-line-attr.gds-code   = p-gds-code
     2125           buf_ord-line-attr.attr-code  = p-code
     2126         .
     2127       end.
     2128       assign
     2129         buf_ord-line-attr.attr-value = p-value
     2130       .
     2131   end.
     2132   end procedure.
     2133   procedure ordlineattr-exist :
     2134     do
     2135     on error undo, return error return-value
     2136     :
     2137       define input parameter p-doc-code like ub.ord-line-attr.doc-code   no-undo .
     2138       define input parameter p-gds-code like ub.ord-line-attr.gds-code   no-undo .
     2139       define input parameter p-code     like ub.ord-line-attr.attr-code  no-undo .
     2140       define output parameter p-exist   as logical  no-undo .
     2141       define buffer buf_ord-line-attr for ub.ord-line-attr .
