     2143       define variable v-format         as character no-undo .
     2144       define variable v-fillin_width   as integer   no-undo .
     2145       define variable v-fillin_height  as integer   no-undo .
     2146       define variable v-label          as character no-undo .
     2147       define variable v-user-can-edit  as logical   no-undo .
     2148       define variable v-output-display as logical   no-undo .
     2149       define variable v-other          as character no-undo .
     2150       define variable v-proc           as character no-undo .
     2151       define variable v-func           as character no-undo .
