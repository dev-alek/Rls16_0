     3104   end.
     3105   find first buf_clients no-lock
     3106        where buf_clients.obj-type = p-cli-type
     3107          and buf_clients.obj-code = p-cli-code
     3108          no-error .
     3109   if not available buf_clients then do:
     3110     return no .
     3111   end.
     3112   run gen-key-rec IN THIS-PROCEDURE ( input 'clients':U
     3113                                     , input (buffer buf_clients:handle)
     3114                                     , output v-uniq-key-rec).
     3115   find first buf_ext-classif no-lock
     3116        where buf_ext-classif.uniq-key-rec    = v-uniq-key-rec
     3117          and buf_ext-classif.classif-subject = 'clients':U
     3118          and buf_ext-classif.classif-name    = 'clients-edoc-nn':U
     3119          no-error.
     3120   if available buf_ext-classif then do :
     3121     return yes .
     3122   end.
     3123   return no.
     3124   END FUNCTION.
