     3508          ,output p-esys-cmd-code
     3509          ) no-error.
     3510        if error-status :error
     3511        then do:
     3512          delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при создании команды &1&2&3&1&4"
     3513                                                           , 'cmd-esys-general':U
     3514                                                           , error-status:get-message(1)
     3515                                                           , return-value
     3516                                                           )).
     3517          return no .
     3518        end.
     3519        return yes.
     3520      end.
     3521   end.
