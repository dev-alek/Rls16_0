     3494        if error-status :error
     3495        then do:
     3496           delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( substitute("&1 &2 &3&4Ошибка при запуске процедуры cmd-bush.p&4" +
     3497                                              "&5&4&6"
     3498                                              ,vss-workfile
     3499                                              ,vss-revision
     3500                                              ,vss-description
     3501                                              ,chr(10)
     3502                                              ,error-status:get-message(1)
     3503                                              ,return-value )).
     3504        end.
     3505        run begin-create-command in p-esys-cmd-proc-handle
     3506          (input 'cmd-esys-general':U
