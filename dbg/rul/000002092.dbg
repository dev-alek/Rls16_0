     4362   procedure load-ruleset-context :
     4363   define input parameter p-ruleset-id as integer no-undo .
     4364   define buffer buf_rule-call-param for ub.rule-call-param.
     4365     do
     4366     on error undo, return error
     4367     :
     4368     find first buf_rule-call-param no-lock where
     4369   buf_rule-call-param.codex_id = p-codex-id
     4370   and buf_rule-call-param.ruleset_id = p-ruleset-id
     4371   and buf_rule-call-param.call_id = p-call-id
     4372   and buf_rule-call-param.order_id = p-order-id
     4373   and buf_rule-call-param.rule_id = p-rule-id
     4374   and buf_rule-call-param.param-name = "p-xsd-file"
     4375    no-error.
     4376   if available buf_rule-call-param then do:
     4377   assign p-xsd-file = buf_rule-call-param.param-value-character.
     4378   end.
     4379       case p-ruleset-id:
     4380         when 2
     4381         then do:
     4382           assign
     4383           v-sign = 2
     4384           v-current-host-code = p-host-code
     4385           v-current-obj-type = p-obj-type
     4386           v-current-obj-code = p-obj-code
     4387           v-current-db-num = g#db-num
     4388           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     4389           file-name  = p-process-file-name
     4390           .
     4391         end.
     4392       end case.
     4393     end.
     4394   end procedure.
