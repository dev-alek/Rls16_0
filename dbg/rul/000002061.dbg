     3492   then do:
     3493      run cb_set-view-log in p-parent-handle ( input yes).
     3494   end.
     3495     if v-es then do:
     3496         run garbcoll_clear in this-procedure .
     3497         undo, return error substitute( "&1. &2&3&4", vss-workfile, v-rv, chr(10), v-esm).
     3498     end.
     3499     run garbcoll_clear in this-procedure .
     3500   end.
     3501   procedure proc-main :
     3502   _main:
     3503   do
     3504   on error undo, return error substitute( "&1&2&3&2&4", return-value, chr(10), error-status :get-message (1), v-last-error-message)
     3505   on stop undo, return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message (1))
     3506   :
     3507     define variable v-doc-code as character no-undo .
     3508     define variable v-trn-doc-obj-type as character no-undo .
     3509     define variable v-trn-doc-obj-code as integer no-undo .
     3510     define variable v-obj-db-num as integer no-undo .
     3511     define variable v-obj-uniq-key-rec as character no-undo .
     3512     define variable v-doc-list-doc-type as character no-undo .
     3513     define buffer buf_inkas for ub.inkas.
     3514     define buffer buf_c-inkas for ub.c-inkas.
     3515     define buffer buf_clients for ub.clients.
     3516     define buffer buf_ext-classif for ub.ext-classif.
     3517   _stroka:
     3518   do while true
     3519   on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3520   on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
     3521   on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
     3522   :
     3523     case p-ruleset-id:
     3524       when 30 then do:
     3525         if v-doc-list-bh:available then do:
     3526           v-doc-list-bh:buffer-delete().
     3527         end.
     3528         run cb_get-next-doc-by-doc-code in v-doc-list-handle ( input v-doc-code
     3529                                                               ,input v-doc-list-doc-type
     3530                                                               ,input v-doc-list-bh
     3531                                                               ).
     3532         if v-doc-list-bh:available then do:
     3533           if num-rec-pre > 0 then do:
     3534             run write-counter in p-log-handle ( input substitute("Просмотрено документов списка &1, обработано  &2, из них удачно: &3", num-rec-pre, num-rec, num-rec-ok)).
     3535           end.
     3536           num-rec-pre = num-rec-pre + 1.
     3537           v-trn-doc-obj-type = v-doc-list-bh:buffer-field("obj-type"):buffer-value.
     3538           v-trn-doc-obj-code = v-doc-list-bh:buffer-field("obj-code"):buffer-value.
     3539           v-doc-code = v-doc-list-bh:buffer-field("doc-code"):buffer-value.
     3540           v-doc-list-doc-type = v-doc-list-bh:buffer-field("doc-type"):buffer-value.
     3541           if not (v-doc-list-doc-type = 'касс':U
     3542           or v-doc-list-doc-type  = "-" + 'касс':U)
     3543           then do:
     3544             next _stroka.
     3545           end.
     3546         END.
     3547         else do:
     3548           v-trn-doc-obj-type = ''.
     3549           v-trn-doc-obj-code = 0.
     3550           v-doc-code = ''.
     3551           leave _stroka.
     3552         end.
     3553       end.
     3554       when 130 then do:
     3555         if v-has-newbh then do:
     3556           v-trn-doc-obj-type = v-newbh::obj-type.
     3557           v-trn-doc-obj-code = v-newbh::obj-code.
     3558           v-doc-code = v-newbh:buffer-field("inkas-code"):buffer-value.
     3559         end.
     3560         else do:
     3561           v-trn-doc-obj-type = v-oldbh::obj-type.
     3562           v-trn-doc-obj-code = v-oldbh::obj-code.
     3563           v-doc-code = v-oldbh:buffer-field("inkas-code"):buffer-value.
     3564         end.
     3565       end.
     3566     end case.
     3567     find first buf_clients no-lock where
     3568               buf_clients.obj-type = v-trn-doc-obj-type
     3569          and  buf_clients.obj-code = v-trn-doc-obj-code.
     3570     run gen-key-rec in this-procedure ( input 'clients':U
     3571                                        ,input buffer buf_clients:handle
     3572                                        ,output v-obj-uniq-key-rec).
     3573     v-esys-id-list = ''.
     3574     for each buf_ext-classif no-lock where
     3575         buf_ext-classif.classif-name = 'clients-esys':U
     3576     and buf_ext-classif.classif-subject = 'clients':U
     3577     and buf_ext-classif.db-num = 0
     3578     and buf_Ext-classif.uniq-key-rec = v-obj-uniq-key-rec :
     3579       if lookup(string(buf_ext-classif.key#_one), v-esys-id-list-start, chr(1)) = 0 then next.
     3580       v-esys-id-list = v-esys-id-list + (if v-esys-id-list = '' then '' else chr(1)) + string(buf_ext-classif.key#_one).
     3581     end.
     3582     case p-ruleset-id:
     3583       when 30 then do:
     3584         if v-esys-id-list = '' then next _stroka.
     3585       end.
     3586       when 130 then do:
     3587         if v-esys-id-list = '' then leave _stroka.
     3588       end.
     3589     end case.
     3590     if v-has-newbh
     3591     or p-ruleset-id = 30
     3592     then do:
     3593       if p-save >= 0 then do:
     3594         case p-ruleset-id:
     3595           when 30 then do:
     3596             if v-doc-list-doc-type = 'касс':U then do:
     3597               find first buf_inkas exclusive-lock where
     3598                         buf_inkas.inkas-code = v-doc-code
     3599                       no-error.
     3600               if buf_inkas.status_ <> 'факт':U then next _stroka.
     3601               v-action = 'U':U.
     3602             end.
     3603             if v-doc-list-doc-type = "-" + 'касс':U then do:
     3604               find first buf_c-inkas exclusive-lock where
     3605                         buf_c-inkas.inkas-code = v-doc-code
     3606                     and buf_c-inkas.is-del = yes  no-error.
     3607               if buf_c-inkas.status_ <> 'факт':U then next _stroka.
     3608               v-action = 'D':U.
     3609             end.
     3610           end.
     3611           when 130 then do:
     3612             find first buf_inkas exclusive-lock where
     3613                       buf_inkas.inkas-code = v-doc-code
     3614                     no-error.
     3615           end.
     3616         end case.
     3617       end.
     3618       else do:
     3619         case p-ruleset-id:
     3620           when 130 then do:
     3621             find first buf_inkas no-lock where
     3622                       buf_inkas.inkas-code = v-doc-code
     3623                     no-error.
     3624           end.
     3625         end case.
     3626       end.
     3627     end.
     3628     num-rec = num-rec + 1.
     3629     IF  ExpData1:route-data_read-xmlschema( INPUT p-xsd-file) = false  THEN do:
     3630       undo _main, return error v-last-error-message .
     3631     end.
     3632     IF  context_begin-esys-command( input v-esys-id-list
     3633                                   , input-output v-esys-cmd-proc-handle
     3634                                   , output v-esys-cmd-code) = false  THEN do:
     3635       undo _main, return error v-last-error-message .
     3636     end.
     3637     run edocsinkas_export in this-procedure ( buffer buf_inkas
     3638                                              ,input (if p-ruleset-id = 130
     3639                                                      then (if v-has-newbh then v-newbh else v-oldbh)
     3640                                                      else (if v-doc-list-doc-type = 'касс':U
     3641                                                            then (buffer buf_Inkas:handle)
     3642                                                            else (buffer buf_c-Inkas:handle)
     3643                                                            )
     3644                                                      )
     3645                                           ) no-error.
     3646     if error-status:error then do:
     3647       undo _main, return error ''.
     3648     end.
     3649     IF  context_send-esys-command( input v-esys-id-list
     3650                                 , input v-esys-cmd-proc-handle
     3651                                 , input v-esys-cmd-code
     3652                                 , input g#userid) = false  THEN do:
     3653       undo _main, return error v-last-error-message .
     3654     end.
     3655     num-rec-ok = num-rec-ok + 1.
     3656       ExpData1:Route-data_clear-data ( ) .
     3657     if p-ruleset-id = 130 then do:
     3658       leave _stroka.
     3659     end.
     3660     else do:
     3661       run get-stop-state in p-log-handle ( output v-stop) no-error .
     3662       if v-stop then do:
     3663               run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Процесс прерван пользователем")).
     3664         leave _stroka.
     3665       end.
     3666     end.
     3667     end.
     3668     if p-ruleset-id = 30
     3669     then do:
     3670           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Просмотрено документов списка &1, обработано  &2, из них удачно: &3", num-rec-pre, num-rec, num-rec-ok)).
     3671     end.
     3672   end.
     3673   end procedure.
     3674   procedure load-ruleset-context :
     3675   define input parameter p-ruleset-id as integer no-undo .
     3676   define variable v-flag as logical no-undo .
     3677   define variable v-ii as integer no-undo .
     3678   define variable v-is-waiting-status as logical no-undo .
     3679   define variable v-direction as character no-undo .
     3680   define variable v-direction-2 as character no-undo .
     3681   define variable v-changes-list as character no-undo .
     3682   define variable v-h as handle no-undo .
     3683   define buffer buf_rule-call-param for ub.rule-call-param.
     3684   define buffer buf_temp-rule-call-param for temp-rule-call-param.
     3685   define buffer buf_ext-system for ub.ext-system.
     3686   do
     3687   on error undo, return error
     3688   :
     3689   case p-ruleset-id:
     3690     when 30 then do:
     3691   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3692   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run calltree in g#library
     3693     (input  'cb_get-next-doc-by-doc-code'
     3694     ,input  this-procedure:handle
     3695     ,input  p-cont-handle
     3696     ,output v-doc-list-handle
     3697     )  .
     3698   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3699   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run calltree in g#library
     3700     (input  'cb_rcps-run_fill-rcp-from-tt0'
     3701     ,input  this-procedure:handle
     3702     ,input  p-cont-handle
     3703     ,output v-h
     3704     )  .
     3705       run  cb_rcps-run_fill-rcp-from-tt0 in v-h ( input p-call-id
     3706                                                 ,input buffer buf_temp-rule-call-param:handle
     3707                                                               ).
     3708       for each buf_temp-rule-call-param no-lock where
     3709       buf_temp-rule-call-param.codex_id = p-codex-id
     3710       and buf_temp-rule-call-param.ruleset_id = p-ruleset-id
     3711       and buf_temp-rule-call-param.call_id = p-call-id
     3712       and buf_temp-rule-call-param.order_id = p-order-id
     3713       and buf_temp-rule-call-param.rule_id = p-rule-id
     3714       and buf_temp-rule-call-param.param-name = "p-esys-id-list",
     3715         first buf_ext-system no-lock where
     3716               buf_Ext-system.esys-id = buf_temp-rule-call-param.param-value-integer
     3717           and buf_Ext-system.db-num = 0
     3718           and buf_Ext-system.esys-have-export = yes
     3719           and buf_Ext-system.esys-db-num-exp = g#db-num:
     3720         v-esys-id-list-start = v-esys-id-list-start + (if v-esys-id-list-start = '' then '' else chr(1)) + string(buf_ext-system.esys-id).
     3721       end.
     3722       if v-esys-id-list-start = '' then return "return".
     3723       find first buf_temp-rule-call-param no-lock where
     3724       buf_temp-rule-call-param.codex_id = p-codex-id
     3725       and buf_temp-rule-call-param.ruleset_id = p-ruleset-id
     3726       and buf_temp-rule-call-param.call_id = p-call-id
     3727       and buf_temp-rule-call-param.order_id = p-order-id
     3728       and buf_temp-rule-call-param.rule_id = p-rule-id
     3729       and buf_temp-rule-call-param.param-name = "p-xsd-file"
     3730       no-error.
     3731       if available buf_temp-rule-call-param then do:
     3732         assign p-xsd-file = buf_temp-rule-call-param.param-value-character.
     3733       end.
     3734       v-doc-list-bh = buffer doc-list:handle.
     3735       v-action = 'U':U.
     3736     end.
     3737     when 130 then do:
     3738         assign
     3739         v-oldbh = widget-handle (entry(2, p-doc-code, chr(4)))
     3740         v-newbh = widget-handle (entry(3, p-doc-code, chr(4)))
     3741         v-changes-list = entry(4, p-doc-code, chr(4))
     3742         file-name  = p-process-file-name
     3743         v-has-oldbh = valid-handle(v-oldbh) and v-oldbh:available
     3744         v-has-newbh = valid-handle(v-newbh) and v-newbh:available
     3745         .
     3746         if not v-has-newbh
     3747         and not v-has-oldbh then do:
     3748           undo, return error substitute("Не определено ни одного буфера - ни старый, ни новый").
     3749         end.
     3750         if not v-has-oldbh
     3751         and v-changes-list  = '' then do:
     3752           undo, return error substitute("Не определен старый буфер и список изменений").
     3753         end.
     3754         if v-has-newbh
     3755         and v-newbh:table <> 'inkas':U then do:
     3756           undo, return error substitute("Передан неверный буфер вместо буфера для &1",  'inkas':U).
     3757         end.
     3758         run statq_has-waiting-stat in this-procedure (
     3759                                                         input v-oldbh
     3760                                                       ,input v-newbh
     3761                                                       ,input v-changes-list
     3762                                                       ,input 'факт':U
     3763                                                       ,input ?
     3764                                                       ,input 0
     3765                                                       ,output v-is-waiting-status
     3766                                                       ,output v-direction
     3767                                                       ) no-error.
     3768         if v-is-waiting-status = no then return "return".
     3769         if num-entries(v-direction, chr(4)) > 1 then do:
     3770           v-direction-2 = entry(2, v-direction, chr(4)).
     3771           v-direction = entry(1, v-direction, chr(4)).
     3772           if v-direction-2 <> "to"
     3773           and v-direction-2 <> "from" then return "return".
     3774           if v-direction = '<открытие документа>':U
     3775           and v-direction-2 = "to" then return "return".
     3776           if v-direction = '<закрытие документа>':U
     3777           and v-direction-2 = "from" then return "return".
     3778         end.
     3779         if v-direction = '<открытие документа>':U
     3780         or v-direction = 'удаление':U
     3781         then do:
     3782           v-action = 'D':U.
     3783         end.
     3784         else do:
     3785           v-action = 'U':U.
     3786         end.
     3787       for each buf_rule-call-param no-lock where
     3788       buf_rule-call-param.codex_id = p-codex-id
     3789       and buf_rule-call-param.ruleset_id = p-ruleset-id
     3790       and buf_rule-call-param.call_id = p-call-id
     3791       and buf_rule-call-param.order_id = p-order-id
     3792       and buf_rule-call-param.rule_id = p-rule-id
     3793       and buf_rule-call-param.param-name = "p-esys-id-list",
     3794         first buf_ext-system no-lock where
     3795               buf_Ext-system.esys-id = buf_rule-call-param.param-value-integer
     3796           and buf_Ext-system.db-num = 0
     3797           and buf_Ext-system.esys-have-export = yes
     3798           and buf_Ext-system.esys-db-num-exp = g#db-num:
     3799         v-esys-id-list-start = v-esys-id-list-start + (if v-esys-id-list-start = '' then '' else chr(1)) + string(buf_ext-system.esys-id).
     3800       end.
     3801       if v-esys-id-list-start = '' then return "return".
     3802         find first buf_rule-call-param no-lock where
     3803       buf_rule-call-param.codex_id = p-codex-id
     3804       and buf_rule-call-param.ruleset_id = p-ruleset-id
     3805       and buf_rule-call-param.call_id = p-call-id
     3806       and buf_rule-call-param.order_id = p-order-id
     3807       and buf_rule-call-param.rule_id = p-rule-id
     3808       and buf_rule-call-param.param-name = "p-xsd-file"
     3809       no-error.
     3810       if available buf_rule-call-param then do:
     3811       assign p-xsd-file = buf_rule-call-param.param-value-character.
     3812       end.
     3813     end.
     3814     otherwise do:
     3815       undo, return error substitute("Неверный вызов &1 для набора правил &2", vss-workfile , p-ruleset-id).
     3816     end.
     3817   end case.
     3818   end.
     3819   end procedure.
     3820   define temp-table operation no-undo
     3821   field referenceNo as character
     3822   field isDel as logical
     3823   field codeOperation as character
     3824   field host as integer
     3825   field store as character
     3826   field factOrder as decimal
     3827   field sysDateXml as date
     3828   field sysTime as character
     3829   field dateDelXml as date
     3830   field dateDocXml as date
     3831   field dateFactXml as date
     3832   field timeFact as character
     3833   field comment as character
     3834   field shiftDateXml as date
     3835   field shiftNum as integer
     3836   field shiftName as character
     3837   field techfuel as logical
     3838   field factQnty as decimal column-label "Кол-во факт."
     3839   field totalSum as decimal column-label "Сумма брутто"
     3840   field totalDsc as decimal column-label "Скидка"
     3841   field totalFact as decimal column-label 'Сумма нетто'
     3842   index pi is unique primary
     3843   referenceNo
     3844   .
     3845   define temp-table saleDoc no-undo
     3846   field saleReferenceNo as character
     3847   field referenceNo as character
     3848   field codeOperation as character
     3849   index pi is primary
     3850   saleReferenceNo
     3851   codeOperation
     3852   referenceNo
     3853   .
     3854   define temp-table cassSum no-undo
     3855   field referenceNo as character
     3856   field code as integer
     3857   field currCode as integer
     3858   field sum as decimal
     3859   field sumr as decimal
     3860   field sumb as decimal
     3861   index pi is unique primary
     3862   referenceNo
     3863   code
     3864   .
     3865   define temp-table payCode no-undo
     3866   field referenceNo as character
     3867   field good as integer
     3868   field deskcode as integer
     3869   field payCode as integer
     3870   field quantity as decimal
     3871   field sum as decimal
     3872   field sumb as decimal
     3873   field sumr as decimal
     3874   index pi is unique primary
     3875   referenceNo
     3876   good
     3877   deskcode
     3878   payCode
     3879   .
     3880   define temp-table payCard no-undo
     3881   field referenceNo as character
     3882   field good as integer
     3883   field deskcode as integer
     3884   field payCode as integer
     3885   field num as character
     3886   field quantity as decimal
     3887   field sumr as decimal
     3888   index pi is unique primary
     3889   referenceNo
     3890   good
     3891   deskcode
     3892   payCode
     3893   num
     3894   .
     3895   define temp-table check1 no-undo XML-NODE-NAME "check"
     3896   field referenceNo as character
     3897   field type as character
     3898   field num as integer
     3899   field doccode  as character
     3900   field desk as integer
     3901   field dateXml as date
     3902   field chk-time as character xml-node-name "time"
     3903   field shiftDateXml as date
     3904   field shiftNum as integer
     3905   field dCard as character
     3906   field dCardCliType as character
     3907   field dCardCliCode as integer
     3908   field discnt as decimal
     3909   field cashier as integer
     3910   field cashierPsnCode as integer
     3911   field salesMan as integer
     3912   field zNumber as integer
     3913   field manualMaked as logical
     3914   field manualChanged as logical
     3915   field subDiscnt as decimal
     3916   field totDoc  as decimal
     3917   index pi is unique primary
     3918   referenceNo
     3919   docCode
     3920   .
     3921   define temp-table checkGds no-undo
     3922   field doccode  as character
     3923   field gdsCode as integer
     3924   field qnty as decimal
     3925   field priceBase as decimal
     3926   field priceDiscnt as decimal
     3927   field lineNum as integer
     3928   field pump as integer
     3929   field roadTax as decimal
     3930   field srcCode as character
     3931   field srcQnty as decimal
     3932   field srcPrice as decimal
     3933   index pi is unique primary
     3934   doccode
     3935   linenum
     3936   .
     3937   define temp-table checkPay no-undo
     3938   field docCode as character
     3939   field payCode as integer
     3940   field payCard as character
     3941   field currCode as integer
     3942   field sumBase as decimal
     3943   field sumRubl as decimal
     3944   field sumTot as decimal
     3945   field lineNum as integer
     3946   index pi is unique primary
     3947   doccode
     3948   linenum
     3949   .
     3950   define temp-table checkDiscount no-undo
     3951   field docCode as character
     3952   field recType as integer
     3953   field lineNum as integer
     3954   field discnt-id as integer
     3955   field discntVCode as integer
     3956   field objectLineNum as integer
     3957   field discntTargetCode as integer
     3958   field discntTypeCode as integer
     3959   field discntValueAbs as decimal
     3960   field discntValuePcnt as decimal
     3961   field srcDCard as character
     3962   field discntKategory as integer
     3963   index pi is unique primary
     3964   doccode
     3965   recType
     3966   linenum
     3967   discnt-id
     3968   .
     3969   define dataset inkas-01
     3970   xml-node-name "inkas-01"
     3971   for operation, saleDoc, cassSum,
     3972   paycode, payCard,
     3973   check1, checkGds, checkPay, checkDiscount
     3974   data-relation operation-saleDoc for operation, saleDoc relation-fields (referenceNo, saleReferenceNo) nested
     3975   data-relation saleDoc-cassSum for saleDoc, cassSum relation-fields (referenceNo, referenceNo) nested
     3976   data-relation saleDoc-payCode for saleDoc, payCode relation-fields (referenceNo, referenceNo) nested
     3977   data-relation saleDoc-payCard for payCode, payCard relation-fields (referenceNo, referenceNo, good, good, deskcode, deskcode, payCode, paycode) nested
     3978   data-relation operation-check1 for operation, check1 relation-fields (referenceNo, referenceNo) nested
     3979   data-relation check1-checkGds for check1, checkGds relation-fields (docCode, docCode) nested
     3980   data-relation check1-checkPay for check1, checkPay relation-fields (docCode, docCode) nested
     3981   data-relation check1-checkDiscount for check1, checkDiscount relation-fields (docCode, docCode) nested
     3982   .
     3983   define temp-table temp_inkas-pay no-undo
     3984   field pay-code  like inkas-pay.pay-code
     3985   field curr-code  like inkas-pay.pay-code
     3986   field tot-base  like inkas-pay.tot-base
     3987   field tot-rubl  like inkas-pay.tot-rubl
     3988   field tot-sum   like inkas-pay.tot-sum
     3989   field doc-type as character
     3990   index pi is primary unique pay-code curr-code
     3991   .
     3992   define temp-table temp-inkas no-undo like ub.inkas.
     3993   procedure edocsinkas_export :
     3994   define parameter buffer buf_inkas for ub.inkas.
     3995   define input parameter p-bh as handle no-undo .
     3996   define variable v-err-mess as character no-undo .
     3997   define variable glog as logical no-undo .
     3998   define variable v-attr-type as character no-undo .
     3999   define variable v-is-out as integer no-undo .
     4000   define variable v-scale-is-empty as logical no-undo .
     4001   define variable v-is-petrol                 as logical      no-undo.
     4002   define variable v-is-pieces                 as logical      no-undo.
     4003   define variable v-petrol-weight             as decimal      no-undo.
     4004   define variable v-petrol-density            as decimal      no-undo.
     4005   define variable v-weight-not-specified      as logical      no-undo.
     4006   define variable v-date-valid as logical no-undo .
     4007   define variable v-error-message as character no-undo .
     4008   define variable v-date-char as character no-undo .
     4009   define variable v-temp-bh as handle no-undo .
     4010   define buffer buf_operation for operation.
     4011   define buffer buf_casssum for cassSum.
     4012   define buffer buf_currency for ub.currency.
     4013   define buffer buf_goods for ub.goods.
     4014   define buffer buf_units for ub.units.
     4015   define buffer buf_c-inkas for ub.c-inkas.
     4016   define buffer buf_sale-doc for ub.sale-doc.
     4017   main-block:
     4018   do
     4019   on error undo main-block, retry main-block
     4020   :
     4021     EMPTY TEMP-TABLE operation.
     4022     empty temp-table cassSum.
     4023     empty temp-table payCode.
     4024     empty temp-table temp_inkas-pay.
     4025     empty temp-table payCard.
     4026     empty temp-table temp-inkas.
     4027     if retry then do:
     4028       EMPTY TEMP-TABLE operation.
     4029       empty temp-table cassSum.
     4030       empty temp-table payCode.
     4031       empty temp-table temp_inkas-pay.
     4032       empty temp-table payCard.
     4033       empty temp-table temp-inkas.
     4034           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input v-err-mess).
     4035       return error ''.
     4036     end.
     4037     else do:
     4038       create temp-inkas.
     4039       v-temp-bh = buffer temp-inkas:handle.
     4040       v-temp-bh:buffer-copy (p-bh).
     4041       if v-action = 'D':U then do:
     4042         find first buf_c-inkas no-lock where
     4043                   buf_c-inkas.inkas-code = p-bh::inkas-code
     4044               and buf_c-inkas.is-del = yes no-error.
     4045       end.
     4046       create buf_operation.
     4047       assign
     4048       buf_operation.referenceNo = temp-inkas.inkas-code
     4049       buf_operation.isDel = (v-action = 'D':U)
     4050       buf_operation.dateDelXml = (if v-action = 'D':U
     4051                                   then (if available buf_c-inkas
     4052                                         then buf_c-inkas.corr-date
     4053                                         else ?)
     4054                                   else ?)
     4055       buf_operation.codeOperation = "sale"
     4056       buf_operation.host = temp-inkas.host-code
     4057       buf_operation.factorder = 0
     4058       buf_operation.sysDateXML = temp-inkas.sys-date
     4059       buf_operation.dateDocXML = temp-inkas.doc-date
     4060       buf_operation.dateFactXML = temp-inkas.fact-date
     4061       buf_operation.shiftDateXML = temp-inkas.shift-date
     4062       buf_operation.shiftNum = temp-inkas.shift-num
     4063       buf_operation.shiftName = temp-inkas.shift-name
     4064       buf_operation.comment = temp-inkas.PS
     4065       buf_operation.store = temp-inkas.obj-type + string(temp-inkas.obj-code)
     4066       buf_operation.systime = string(temp-inkas.sys-time, "HH:MM:SS")
     4067       buf_operation.factQnty = temp-inkas.qnty
     4068       buf_operation.totalSum =  temp-inkas.tot-doc
     4069       buf_operation.totalDsc = temp-inkas.discnt
     4070       buf_operation.totalFact = temp-inkas.netto
     4071       .
     4072       if v-action = 'D':U then do:
     4073         ExpData1:route-data_create-record( INPUT "operation") .
     4074         ExpData1:route-data_copy-record ( input "operation", buffer buf_operation:handle).
     4075         IF ExpData1:esys-add-dump( INPUT "operation", INPUT v-esys-cmd-proc-handle, INPUT v-esys-cmd-code, '+update') = false  THEN do:
     4076           v-err-mess = substitute("Ошибка при маршрутизации записи operation &1:&2&3"
     4077                                   , temp-inkas.inkas-code
     4078                                   , chr(10)
     4079                                   , v-last-error-message
     4080                                   ).
     4081           undo main-block, retry main-block.
     4082         end.
     4083         return.
     4084       end.
     4085       ExpData1:route-data_create-record( INPUT "operation") .
     4086       ExpData1:route-data_copy-record ( input "operation", buffer buf_operation:handle).
     4087       IF ExpData1:esys-add-dump( INPUT "operation", INPUT v-esys-cmd-proc-handle, INPUT v-esys-cmd-code, '+update') = false  THEN do:
     4088         v-err-mess = substitute("Ошибка при маршрутизации записи operation &1:&2&3"
     4089                                 , buf_inkas.inkas-code
     4090                                 , chr(10)
     4091                                 , v-last-error-message
     4092                                 ).
     4093         undo main-block, retry main-block.
     4094       end.
     4095       for each buf_sale-doc no-lock where
     4096               buf_sale-doc.inkas-code = buf_inkas.inkas-code
     4097       on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4098       on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     4099       on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     4100       :
     4101         if not available saleDoc then do:
     4102           create saleDoc.
     4103         end.
     4104         assign
     4105         saleDoc.saleReferenceNo = buf_inkas.inkas-code
     4106         saleDoc.referenceNo     = buf_sale-doc.doc-code
     4107         saleDoc.codeOperation   = buf_sale-doc.doc-kind
     4108         .
     4109         ExpData1:route-data_create-record( INPUT "saleDoc") .
     4110         ExpData1:route-data_copy-record ( input "saleDoc", buffer saleDoc:handle).
     4111         IF ExpData1:esys-add-dump( INPUT "saleDoc", INPUT v-esys-cmd-proc-handle, INPUT v-esys-cmd-code, '+update') = false  THEN do:
     4112           v-err-mess = substitute("Ошибка при маршрутизации записи saleDoc &1:&2&3"
     4113                                   , buf_sale-doc.doc-code
     4114                                   , chr(10)
     4115                                   , v-last-error-message
     4116                                   ).
     4117           undo main-block, retry main-block.
     4118         end.
     4119         if buf_sale-doc.in-inkas = yes then do:
     4120           empty temp-table treal-2.
     4121           empty temp-table treal-3.
     4122           empty temp-table treal-4.
     4123           empty temp-table temp_inkas-pay.
     4124           run bge/bgepych2.p (
     4125                 input buf_inkas.inkas-code
     4126               , input buf_sale-doc.ext-doc-type
     4127               , input yes
     4128               , input yes
     4129               , input yes
     4130               , input yes
     4131               , input yes
     4132           ).
     4133           if buf_sale-doc.dir <> 0 then do:
     4134             run get-inkas-pay-desk in this-procedure (
     4135                     input buf_inkas.inkas-code
     4136                   , input buf_inkas.obj-type
     4137                   , input buf_inkas.obj-code
     4138                   , input (if buf_sale-doc.dir = 1
     4139                           then 'при':U
     4140                           else 'рас':U
     4141                           )
     4142               ) no-error .
     4143             if error-status:error
     4144             then do:
     4145                           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("*** ERR: *** Не удалось рассчитать разбивку по кодам оплат по документу N &1", p-doc-code )).
     4146             end.
     4147           end.
     4148           run export-chk-pay-code in this-procedure (
     4149                                                      input buf_Sale-doc.doc-code
     4150                                                     ,input buf_sale-doc.ext-doc-type
     4151                                                     ,input buf_sale-doc.dir
     4152                                                 ).
     4153           create buf_cassSum.
     4154           for each temp_inkas-pay
     4155           on error undo, return error
     4156           :
     4157             assign
     4158             buf_cassSum.referenceNo = buf_sale-doc.doc-code
     4159             buf_cassSum.code = temp_inkas-pay.pay-code
     4160             buf_cassSum.currCode = temp_inkas-pay.curr-code
     4161             buf_cassSum.sum = (if temp_inkas-pay.doc-type = 'при':U then 1 else -1)  * temp_inkas-pay.tot-sum
     4162             buf_cassSum.sumb = (if temp_inkas-pay.doc-type = 'при':U then 1 else -1) * temp_inkas-pay.tot-base
     4163             buf_cassSum.sumr = (if temp_inkas-pay.doc-type = 'при':U then 1 else -1) * temp_inkas-pay.tot-rubl
     4164             .
     4165             ExpData1:route-data_create-record( INPUT "cassSum") .
     4166             ExpData1:route-data_copy-record ( input "cassSum", buffer buf_cassSum:handle).
     4167             IF ExpData1:esys-add-dump( INPUT "cassSum", INPUT v-esys-cmd-proc-handle, INPUT v-esys-cmd-code, '+update') = false  THEN do:
     4168               v-err-mess = substitute("Ошибка при маршрутизации записи cassSum &1:&2&3"
     4169                                       , buf_sale-doc.doc-code
     4170                                       , chr(10)
     4171                                       , v-last-error-message
     4172                                       ).
     4173               undo main-block, retry main-block.
     4174             end.
     4175           end.
     4176           if available buf_cassSum then delete buf_cassSum.
     4177         end.
     4178       end.
     4179       if available saleDoc then delete saleDoc.
     4180       run export-checks in this-procedure (
     4181                                             input buf_inkas.inkas-code
     4182                                           , input buf_inkas.obj-type
     4183                                           , input buf_inkas.obj-code
     4184       ).
     4185       if available buf_operation then delete buf_operation.
     4186     end.
     4187   end.
     4188   end procedure.
     4189   procedure get-inkas-pay-desk :
     4190     do
     4191     on error undo, return error
     4192     :
     4193     define input parameter p-inkas-code like ub.inkas.inkas-code no-undo .
     4194     define input parameter p-obj-type   like ub.inkas.obj-type no-undo .
     4195     define input parameter p-obj-code   like ub.inkas.obj-code no-undo .
     4196     define input parameter p-inkas-pay-desk-type like ub.inkas-pay-desk.doc-type no-undo .
     4197       if can-find( first ub.inkas-pay-desk  NO-LOCK WHERE
     4198                          ub.inkas-pay-desk.inkas-code = p-inkas-code ) then.
     4199       else do:
     4200         run trg/inkpdcr.p (
     4201                        p-inkas-code
     4202                       ,p-obj-type
     4203                       ,p-obj-code
     4204         ) no-error .
     4205         if error-status:error then do:
     4206           return error.
     4207         end.
     4208       end.
     4209       for each temp_inkas-pay
     4210       :
     4211           delete temp_inkas-pay.
     4212       end.
     4213       for each ub.inkas-pay-desk no-lock
     4214          where ub.inkas-pay-desk.inkas-code = p-inkas-code
     4215            and ub.inkas-pay-desk.doc-type = p-inkas-pay-desk-type
     4216       break
     4217       by ub.inkas-pay-desk.pay-code
     4218       by ub.inkas-pay-desk.curr-code
     4219       on error undo, return error
     4220       :
     4221         if first-of( ub.inkas-pay-desk.curr-code )
     4222         then do:
     4223           create temp_inkas-pay.
     4224           assign
     4225           temp_inkas-pay.pay-code  = ub.inkas-pay-desk.pay-code
     4226           temp_inkas-pay.curr-code  = ub.inkas-pay-desk.curr-code
     4227           temp_inkas-pay.tot-base  = 0
     4228           temp_inkas-pay.tot-rubl  = 0
     4229           temp_inkas-pay.tot-sum   = 0
     4230           .
     4231         end.
     4232         assign
     4233         temp_inkas-pay.tot-base  = temp_inkas-pay.tot-base + ub.inkas-pay-desk.tot-base
     4234         temp_inkas-pay.tot-rubl  = temp_inkas-pay.tot-rubl + ub.inkas-pay-desk.tot-rubl
     4235         temp_inkas-pay.tot-sum   = temp_inkas-pay.tot-sum  + ub.inkas-pay-desk.tot-sum
     4236         temp_inkas-pay.doc-type  = p-inkas-pay-desk-type
     4237         .
     4238       end.
     4239     end.
     4240   end procedure.
     4241   procedure export-chk-pay-code :
     4242   define input parameter p-doc-code           as character        no-undo.
     4243   define input parameter p-ext-doc-type       as character        no-undo .
     4244   define input parameter p-is-out             as integer          no-undo .
     4245   define variable v-err-mess as character no-undo .
     4246   define buffer buf_PayCode for paycode .
     4247   define buffer buf_paycard for paycard.
     4248   define buffer buf_goods for ub.goods.
     4249   main-block:
     4250   do
     4251   on error  undo main-block, retry main-block
     4252   on stop   undo main-block, retry main-block
     4253   on endkey undo main-block, retry main-block
     4254   :
     4255     if retry then do:
     4256       empty temp-table payCard.
     4257       empty temp-table payCode.
     4258     end.
     4259     else do:
     4260       empty temp-table payCard.
     4261       empty temp-table payCode.
     4262       for each treal-2 where
     4263            treal-2.is-pay = yes,
     4264       first buf_goods no-lock where buf_goods.gds-code = treal-2.gds-code
     4265       break
     4266       by treal-2.pay-desk
     4267       by treal-2.cpay-code
     4268       by treal-2.curr-code
     4269       by treal-2.prefix
     4270       on error undo, return error
     4271       :
     4272           if treal-2.prefix = '':U then do:
     4273             create buf_PayCode.
     4274             assign
     4275             buf_PayCode.referenceNo = p-doc-code
     4276             buf_PayCode.good = buf_goods.gds-code
     4277             buf_PayCode.deskcode = treal-2.pay-desk
     4278             buf_PayCode.paycode = treal-2.cpay-code
     4279             buf_PayCode.quantity = p-is-out * treal-2.qnty1
     4280             buf_PayCode.sumr = p-is-out * treal-2.netto
     4281             .
     4282             ExpData1:route-data_create-record( INPUT "payCode") .
     4283             ExpData1:route-data_copy-record ( input "payCode", buffer buf_paycode:handle).
     4284             IF ExpData1:esys-add-dump( INPUT "payCode", INPUT v-esys-cmd-proc-handle, INPUT v-esys-cmd-code, '+update') = false  THEN do:
     4285               v-err-mess = substitute("Ошибка при маршрутизации записи payCode &1:&2&3"
     4286                                       , p-doc-code
     4287                                       , chr(10)
     4288                                       , v-last-error-message
     4289                                       ).
     4290               undo main-block, retry main-block.
     4291             end.
     4292           end.
     4293           if treal-2.prefix <> '':U
     4294           then do:
     4295             create buf_payCard.
     4296             assign
     4297             buf_PayCard.good = buf_goods.gds-code
     4298             buf_PayCard.referenceNo = p-doc-code
     4299             buf_PayCard.deskcode = treal-2.pay-desk
     4300             buf_PayCard.paycode = treal-2.cpay-code
     4301             buf_PayCard.num = treal-2.prefix
     4302             buf_PayCard.quantity = p-is-out * treal-2.qnty1
     4303             buf_PayCard.sumr = p-is-out * treal-2.netto
     4304             .
     4305             ExpData1:route-data_create-record( INPUT "payCard") .
     4306             ExpData1:route-data_copy-record ( input "payCard", buffer buf_paycard:handle).
     4307             IF ExpData1:esys-add-dump( INPUT "payCard", INPUT v-esys-cmd-proc-handle, INPUT v-esys-cmd-code, '+update') = false  THEN do:
     4308               v-err-mess = substitute("Ошибка при маршрутизации записи payCard &1:&2&3"
     4309                                       , p-doc-code
     4310                                       , chr(10)
     4311                                       , v-last-error-message
     4312                                       ).
     4313               undo main-block, retry main-block.
     4314             end.
     4315           end.
     4316       end.
     4317       for each treal-3 no-lock  where
     4318           treal-3.is-pay = yes,
     4319       first buf_goods no-lock where buf_goods.gds-code = treal-3.gds-code
     4320       break
     4321       by treal-3.pay-desk
     4322       by treal-3.cpay-code
     4323       by treal-3.curr-code
     4324       by treal-3.prefix
     4325       on error undo, return error
     4326       :
     4327         if treal-3.prefix = '':U then do:
     4328           create buf_PayCode.
     4329           assign
     4330           buf_PayCode.referenceNo = p-doc-code
     4331           buf_PayCode.good = buf_goods.gds-code
     4332           buf_PayCode.deskcode = treal-3.pay-desk
     4333           buf_PayCode.paycode = treal-3.cpay-code
     4334           buf_PayCode.quantity = p-is-out * treal-3.qnty1
     4335           buf_PayCode.sumr = p-is-out * treal-3.netto
     4336           .
     4337           ExpData1:route-data_create-record( INPUT "payCode") .
     4338           ExpData1:route-data_copy-record ( input "payCode", buffer buf_paycode:handle).
     4339           IF ExpData1:esys-add-dump( INPUT "payCode", INPUT v-esys-cmd-proc-handle, INPUT v-esys-cmd-code, '+update') = false  THEN do:
     4340             v-err-mess = substitute("Ошибка при маршрутизации записи payCode2 &1:&2&3"
     4341                                     , p-doc-code
     4342                                     , chr(10)
     4343                                     , v-last-error-message
     4344                                     ).
     4345             undo main-block, retry main-block.
     4346           end.
     4347         end.
     4348         if treal-3.prefix <> '':U then do:
     4349           create buf_payCard.
     4350           assign
     4351           buf_PayCard.referenceNo = p-doc-code
     4352           buf_PayCard.good = buf_goods.gds-code
     4353           buf_PayCard.deskcode = treal-3.pay-desk
     4354           buf_PayCard.paycode = treal-3.cpay-code
     4355           buf_PayCard.num = treal-3.prefix
     4356           buf_PayCard.quantity = p-is-out * treal-3.qnty1
     4357           buf_PayCard.sumr = p-is-out * treal-3.netto
     4358           .
     4359           ExpData1:route-data_create-record( INPUT "payCard") .
     4360           ExpData1:route-data_copy-record ( input "payCard", buffer buf_paycard:handle).
     4361           IF ExpData1:esys-add-dump( INPUT "payCard", INPUT v-esys-cmd-proc-handle, INPUT v-esys-cmd-code, '+update') = false  THEN do:
     4362             v-err-mess = substitute("Ошибка при маршрутизации записи payCard &1:&2&3"
     4363                                     , p-doc-code
     4364                                     , chr(10)
     4365                                     , v-last-error-message
     4366                                     ).
     4367             undo main-block, retry main-block.
     4368           end.
     4369         end.
     4370       end.
     4371       for each treal-4 no-lock where
     4372              treal-4.is-pay = yes,
     4373       first buf_goods no-lock where buf_goods.gds-code = treal-4.gds-code
     4374       break
     4375       by treal-4.pay-desk
     4376       by treal-4.cpay-code
     4377       by treal-4.curr-code
     4378       by treal-4.prefix
     4379       on error undo, return error
     4380         :
     4381         if treal-4.prefix = '':U then do:
     4382           create buf_PayCode.
     4383           assign
     4384           buf_PayCode.referenceNo = p-doc-code
     4385           buf_PayCode.good = buf_Goods.gds-code
     4386           buf_PayCode.deskcode = treal-4.pay-desk
     4387           buf_PayCode.paycode = treal-4.cpay-code
     4388           buf_PayCode.quantity = p-is-out * treal-4.qnty1
     4389           buf_PayCode.sumr = p-is-out * treal-4.netto
     4390           .
     4391           ExpData1:route-data_create-record( INPUT "payCode") .
     4392           ExpData1:route-data_copy-record ( input "payCode", buffer buf_paycode:handle).
     4393           IF ExpData1:esys-add-dump( INPUT "payCode", INPUT v-esys-cmd-proc-handle, INPUT v-esys-cmd-code, '+update') = false  THEN do:
     4394             v-err-mess = substitute("Ошибка при маршрутизации записи payCode &1:&2&3"
     4395                                     , p-doc-code
     4396                                     , chr(10)
     4397                                     , v-last-error-message
     4398                                     ).
     4399             undo main-block, retry main-block.
     4400           end.
     4401         end.
     4402         if treal-4.prefix <> '':U then do:
     4403           create buf_payCard.
     4404           assign
     4405           buf_PayCard.referenceNo = p-doc-code
     4406           buf_PayCard.good = buf_goods.gds-code
     4407           buf_PayCard.deskcode = treal-4.pay-desk
     4408           buf_PayCard.paycode = treal-4.cpay-code
     4409           buf_PayCard.num = treal-4.prefix
     4410           buf_PayCard.quantity = p-is-out * treal-4.qnty1
     4411           buf_PayCard.sumr = p-is-out * treal-4.netto
     4412           .
     4413           ExpData1:route-data_create-record( INPUT "payCard") .
     4414           ExpData1:route-data_copy-record ( input "payCard", buffer buf_paycard:handle).
     4415           IF ExpData1:esys-add-dump( INPUT "payCard", INPUT v-esys-cmd-proc-handle, INPUT v-esys-cmd-code, '+update') = false  THEN do:
     4416             v-err-mess = substitute("Ошибка при маршрутизации записи payCard &1:&2&3"
     4417                                     , p-doc-code
     4418                                     , chr(10)
     4419                                     , v-last-error-message
     4420                                     ).
     4421             undo main-block, retry main-block.
     4422           end.
     4423         end.
     4424       end.
     4425     end.
     4426   end.
     4427   end procedure.
     4428   procedure export-checks :
     4429   define input parameter p-doc-code       as character    no-undo.
     4430   define input parameter p-obj-type       as character    no-undo.
     4431   define input parameter p-obj-code       as integer      no-undo.
     4432   define variable v-write-off as logical no-undo .
     4433   define variable v-doc-bh as handle no-undo .
     4434   define variable v-gds-bh as handle no-undo .
     4435   define variable v-pay-bh as handle no-undo .
     4436   define variable v-discnt-bh as handle no-undo .
     4437   define variable v-err-mess as character no-undo .
     4438   define buffer buf_chk-doc       for ub.chk-doc.
     4439   define buffer buf_chk-gds       for ub.chk-gds.
     4440   define buffer buf_chk-pay       for ub.chk-pay.
     4441   define buffer buf_bar-code      for ub.bar-code.
     4442   define buffer buf_goods         for ub.goods.
     4443   define buffer buf_c-chk-doc     for ub.c-chk-doc.
     4444   define buffer manu_c-chk-doc    for ub.c-chk-doc.
     4445   define buffer buf_chk-discnt    for ub.chk-discnt.
     4446   define buffer buf_dis-card      for ub.dis-card.
     4447   main-block:
     4448   do
     4449   for buf_chk-doc
     4450     , buf_chk-gds
     4451     , buf_chk-pay
     4452     , buf_bar-code
     4453     , buf_goods
     4454     , buf_c-chk-doc
     4455     , buf_chk-discnt
     4456     , buf_dis-card
     4457   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4458   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     4459   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     4460   :
     4461     v-doc-bh = buffer buf_chk-doc:handle.
     4462     v-gds-bh = buffer buf_chk-gds:handle.
     4463     v-pay-bh = buffer buf_chk-pay:handle.
     4464     for each buf_chk-doc no-lock
     4465         where buf_chk-doc.out-code = p-doc-code
     4466     :
     4467       if buf_chk-doc.correct = no then next.
     4468       if lookup(string(buf_chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then next.
     4469       find first buf_dis-card no-lock
     4470             where buf_dis-card.d-card = buf_chk-doc.d-card
     4471       no-error.
     4472       if not available check1 then do:
     4473         create check1.
     4474       end.
     4475       find first manu_c-chk-doc
     4476             where manu_c-chk-doc.doc-code   = buf_chk-doc.doc-code
     4477               and manu_c-chk-doc.obj-type   = buf_chk-doc.obj-type
     4478               and manu_c-chk-doc.obj-code   = buf_chk-doc.obj-code
     4479               and manu_c-chk-doc.is-add     = yes
     4480       use-index pi
     4481       no-error.
     4482       find first buf_c-chk-doc
     4483             where buf_c-chk-doc.doc-code   = buf_chk-doc.doc-code
     4484               and buf_c-chk-doc.obj-type   = buf_chk-doc.obj-type
     4485               and buf_c-chk-doc.obj-code   = buf_chk-doc.obj-code
     4486               and buf_c-chk-doc.is-add     = no
     4487               and buf_c-chk-doc.is-del     = no
     4488       use-index pi
     4489       no-error.
     4490       assign
     4491       v-write-off = no
     4492       .
     4493       if buf_chk-doc.sub-discnt <> 0 then do:
     4494         if buf_chk-doc.chk-type = integer('96':U) then do:
     4495           assign
     4496               v-write-off = yes
     4497           .
     4498         end.
     4499         else do:
     4500           _for:
     4501           for each buf_chk-gds no-lock where
     4502                   buf_chk-gds.doc-code = buf_chk-doc.doc-code :
     4503             if buf_Chk-gds.write-off-code <> ?
     4504             and buf_Chk-gds.write-off-code <> 0 then do:
     4505               assign
     4506               v-write-off = yes.
     4507               leave _for.
     4508             end.
     4509           end.
     4510         end.
     4511       end.
     4512       assign
     4513       check1.referenceNo  = p-doc-code
     4514       check1.doccode      = buf_chk-doc.doc-code
     4515       check1.type         = buf_chk-doc.office
     4516       check1.num          = buf_chk-doc.chk-num
     4517       check1.desk         = buf_chk-doc.pay-desk
     4518       check1.dateXML      = buf_chk-doc.chk-date
     4519       check1.chk-time     = string(buf_chk-doc.chk-time, "HH:MM:SS")
     4520       check1.shiftDateXML = buf_chk-doc.shift-date
     4521       check1.shiftNum     = buf_chk-doc.shift-num
     4522       check1.dCard        = buf_chk-doc.d-card
     4523       check1.dCardCliType = buf_chk-doc.cli-type
     4524       check1.dCardCliCode = buf_chk-doc.cli-code
     4525       check1.discnt       = buf_chk-doc.discnt
     4526       check1.cashier      = buf_chk-doc.cashier
     4527       check1.cashierPsnCode = buf_chk-doc.cashier-psn-code
     4528       check1.salesman       = buf_chk-doc.sales-man
     4529       check1.zNumber        = buf_chk-doc.z-number
     4530       check1.manualMaked    = (if available manu_c-chk-doc then yes else no)
     4531       check1.manualChanged  = (if available buf_c-chk-doc then yes else no)
     4532       check1.subDiscnt      = (if v-write-off then buf_chk-doc.sub-discnt else 0)
     4533       check1.totdoc         = buf_chk-doc.tot-doc
     4534       .
     4535       ExpData1:route-data_create-record( INPUT "check1") .
     4536       ExpData1:route-data_copy-record ( input "check1", input buffer check1:handle).
     4537       IF ExpData1:esys-add-dump( INPUT "check1", INPUT v-esys-cmd-proc-handle, INPUT v-esys-cmd-code, '+update') = false  THEN do:
     4538         v-err-mess = substitute("Ошибка при маршрутизации записи check для продажи &1:&2&3"
     4539                                 , p-doc-code
     4540                                 , chr(10)
     4541                                 , v-last-error-message
     4542                                 ).
     4543         undo main-block, return error v-err-mess.
     4544       end.
     4545       for each buf_chk-gds no-lock
     4546           where buf_chk-gds.doc-code = buf_chk-doc.doc-code
     4547       :
     4548         find first buf_bar-code no-lock
     4549               where buf_bar-code.b-code = buf_chk-gds.b-code no-error.
     4550         if not available checkGds then do:
     4551           create checkGds.
     4552         end.
     4553         assign
     4554         checkGds.doccode = buf_chk-doc.doc-code
     4555         checkGds.gdsCode = (if available buf_bar-code then buf_bar-code.gds-code else 0)
     4556         checkGds.qnty    = buf_chk-gds.doc-qnty
     4557         checkGds.priceBase = buf_chk-gds.price-base
     4558         checkGds.priceDiscnt = buf_chk-gds.discnt
     4559         checkGds.lineNum  = buf_chk-gds.line-num
     4560         checkGds.pump  = buf_chk-gds.pump
     4561         checkGds.roadTax  = buf_chk-gds.road-tax
     4562         checkGds.srcCode  = entry(1, buf_chk-gds.src-code, chr(4) )
     4563         checkGds.srcQnty  = buf_chk-gds.src-qnty
     4564         checkGds.srcprice = buf_chk-gds.src-price
     4565         .
     4566         ExpData1:route-data_create-record( INPUT "checkGds") .
     4567         ExpData1:route-data_copy-record ( "checkGds", input buffer checkgds:handle).
     4568         IF ExpData1:esys-add-dump( INPUT "checkGds", INPUT v-esys-cmd-proc-handle, INPUT v-esys-cmd-code, '+update') = false  THEN do:
     4569           v-err-mess = substitute("Ошибка при маршрутизации записи checkGds для продажи &1:&2&3"
     4570                                   , p-doc-code
     4571                                   , chr(10)
     4572                                   , v-last-error-message
     4573                                   ).
     4574           undo main-block, return error v-err-mess.
     4575         end.
     4576       end.
     4577       for each buf_chk-pay no-lock
     4578           where buf_chk-pay.doc-code = buf_chk-doc.doc-code
     4579       :
     4580         if not available checkPay then do:
     4581           create checkPay.
     4582         end.
     4583         assign
     4584         checkPay.doccode = buf_chk-doc.doc-code
     4585         checkPay.payCode = buf_chk-pay.pay-code
     4586         checkPay.payCard = buf_chk-pay.pay-card
     4587         checkPay.currCode = buf_chk-pay.curr-code
     4588         checkPay.sumBase = buf_chk-pay.tot-base
     4589         checkPay.sumrubl = buf_chk-pay.tot-rubl
     4590         checkPay.sumtot = buf_chk-pay.tot-sum
     4591         checkPay.lineNum = buf_chk-pay.line-num
     4592         .
     4593         ExpData1:route-data_create-record( INPUT "checkPay") .
     4594         ExpData1:route-data_copy-record ( input "checkPay", input buffer checkpay:handle).
     4595         IF ExpData1:esys-add-dump( INPUT "checkPay", INPUT v-esys-cmd-proc-handle, INPUT v-esys-cmd-code, '+update') = false  THEN do:
     4596           v-err-mess = substitute("Ошибка при маршрутизации записи checkPay для продажи &1:&2&3"
     4597                                   , p-doc-code
     4598                                   , chr(10)
     4599                                   , v-last-error-message
     4600                                   ).
     4601           undo main-block, return error v-err-mess.
     4602         end.
     4603       end.
     4604       define variable v-ii as integer no-undo .
     4605       do v-ii = 0 to 2 by 2:
     4606         for each buf_chk-discnt no-lock
     4607           where buf_chk-discnt.doc-code = buf_chk-doc.doc-code
     4608             and buf_chk-discnt.record-type = v-ii
     4609         :
     4610           if not available checkDiscount then do:
     4611             create checkDiscount.
     4612           end.
     4613           assign
     4614           checkDiscount.doccode = buf_chk-discnt.doc-code
     4615           checkDiscount.linenum = buf_chk-discnt.line-num
     4616           checkDiscount.discntvCode = buf_chk-discnt.value-type
     4617           checkDiscount.objectlinenum = buf_chk-discnt.object-line-num
     4618           checkDiscount.discntTargetCode = buf_chk-discnt.line-type
     4619           checkDiscount.discntTypeCode = buf_chk-discnt.discnt-type
     4620           checkDiscount.discntValueAbs = buf_chk-discnt.discnt-value-abs
     4621           checkDiscount.discntValuePcnt = buf_chk-discnt.discnt-value-pcnt
     4622           checkDiscount.srcDCard = buf_chk-discnt.src-d-card
     4623           checkDiscount.discntKategory = ( if buf_chk-discnt.src-d-card <> ''
     4624                                             and buf_chk-discnt.src-d-card <> ?
     4625                                             and available buf_dis-card
     4626                                             and buf_dis-card.d-card = buf_chk-discnt.src-d-card
     4627                                             and buf_chk-discnt.kateg = ?
     4628                                             then buf_dis-card.category
     4629                                             else buf_chk-discnt.kateg )
     4630           .
     4631           ExpData1:route-data_create-record( INPUT "checkDiscount") .
     4632           ExpData1:route-data_copy-record ( input "checkDiscount", input buffer checkdiscount:handle).
     4633                 IF ExpData1:esys-add-dump( INPUT "checkDiscount", INPUT v-esys-cmd-proc-handle, INPUT v-esys-cmd-code, '+update') = false  THEN do:
     4634             v-err-mess = substitute("Ошибка при маршрутизации записи checDiscount для продажи &1:&2&3"
     4635                                     , p-doc-code
     4636                                     , chr(10)
     4637                                     , v-last-error-message
     4638                                     ).
     4639             undo main-block, return error v-err-mess.
     4640           end.
     4641         end.
     4642       end.
     4643     end.
     4644   end.
     4645   end procedure.
