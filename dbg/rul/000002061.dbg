     1928         (input  p-code
     1929         ,output v-type
     1930         ,output v-format
     1931         ,output v-label
     1932         ,output v-range
     1933         ,output v-user-can-edit
     1934         ,output v-output-display
     1935         ,output v-other
     1936         ) no-error .
     1937       if error-status :error then do:
     1938         undo, return error return-value .
     1939       end.
     1940       find first buf_cash-pay-attr exclusive-lock
     1941         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
     1942           and buf_cash-pay-attr.curr-code  = p-curr-code
     1943           and buf_cash-pay-attr.host-code  = p-host-code
     1944           and buf_cash-pay-attr.obj-type   = p-obj-type
     1945           and buf_cash-pay-attr.obj-code   = p-obj-code
     1946           and buf_cash-pay-attr.attr-code = p-code
     1947         no-error NO-WAIT.
     1948       if not available buf_cash-pay-attr then do:
     1949         p-deleted = no.
     1950       end.
     1951       else do:
     1952         delete buf_cash-pay-attr no-error .
     1953         if error-status:error then do:
     1954           undo, return error return-value .
     1955         end.
     1956         p-deleted = yes.
     1957       end.
     1958     end.
     1959   end procedure.
     1960   procedure cp-attr-news :
     1961     do
     1962     on error undo, return error
     1963     :
     1964       define input  parameter p-code           as character no-undo .
     1965       define output parameter p-news           as logical   no-undo .
     1966       case p-code :
     1967               when 'paycard-export-prefix':U then do:     assign     p-news = true.   end.
     1968               when 'grp-code':U then do:     assign     p-news = true.   end.
     1969               when 'is-use':U then do:     assign     p-news = true.   end.
     1970               when 'dop-doc':U then do:     assign     p-news = true.   end.
     1971               when 'paycard-all-prefix':U then do:     assign     p-news = true.   end.
     1972               when 'paycard-edit-prefix':U then do:     assign     p-news = true.   end.
     1973               when 'form_km3':U then do:     assign     p-news = false.   end.
     1974               when 'bal_malina':U then do:     assign     p-news = false.   end.
     1975               when 'max_proc_sum':U then do:     assign     p-news = true.   end.
     1976               when 'mask_card_kup':U then do:     assign     p-news = true.   end.
     1977         otherwise do:
     1978           p-news = no.
     1979         end.
     1980       end.
     1981     end.
     1982   end procedure.
