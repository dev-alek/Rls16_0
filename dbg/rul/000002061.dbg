     2875                    'накл':U +      chr(4) + string(no) + chr(3) +
     2876                    'накл':U +      chr(4) + string(yes) + chr(3) +
     2877                    'разрешен':U + chr(4) + string(no) + chr(3) +
     2878                    'разрешен':U + chr(4) + string(yes) + chr(3) +
