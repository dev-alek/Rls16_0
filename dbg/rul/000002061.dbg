     2747         p-direction = '<закрытие документа>':U + chr(4) + "to".
     2748         return.
     2749       end.
     2750       if v-old-stfl-i < v-waiting-stfl-i
     2751       and v-new-stfl-i > v-waiting-stfl-i then do:
     2752         assign
     2753         p-is-waiting-status = yes
     2754         p-direction = '<закрытие документа>':U + chr(4) + "to-up".
     2755         return.
     2756       end.
     2757       if v-new-stfl-i = v-waiting-stfl-i
     2758       and v-old-stfl-i > v-waiting-stfl-i then do:
     2759         assign
     2760         p-is-waiting-status = yes
     2761         p-direction = '<открытие документа>':U + chr(4) + "to".
     2762         return.
     2763       end.
     2764       if v-new-stfl-i < v-waiting-stfl-i
