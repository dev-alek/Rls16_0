     2611                    'новый':U    +  chr(3) +
     2612                    'запрос':U +  chr(3) +
     2613                    'разрешено':U    +  chr(3) +
     2614                    'отгружено':U  +  chr(3) +
     2615                    'отказ':U
     2616   .
     2617     assign
     2618     v-waiting-stfl = p-waiting-status
     2619     .
     2620     assign
     2621     v-old-stfl = p-oldbh::status_
     2622     .
     2623     assign
     2624     v-new-stfl = p-newbh::status_
     2625     .
     2626     _ii:
     2627     do v-ii = 1 to 5:
     2628       if v-stat-list[v-ii] = '' then next.
     2629       assign
     2630       v-waiting-stfl-i = lookup(v-waiting-stfl, v-stat-list[v-ii], chr(3))
     2631       v-old-stfl-i = lookup(v-old-stfl, v-stat-list[v-ii], chr(3))
     2632       v-new-stfl-i = lookup(v-new-stfl, v-stat-list[v-ii], chr(3))
     2633       .
     2634       if v-waiting-stfl-i = 0
     2635       or v-old-stfl-i = 0
     2636       or v-new-stfl-i = 0
     2637       then do:
     2638         next _ii.
     2639         end.
     2640       if v-old-stfl-i < v-waiting-stfl-i
     2641       and v-new-stfl-i = v-waiting-stfl-i then do:
     2642         assign
     2643         p-is-waiting-status = yes
     2644         p-direction = '<закрытие документа>':U + chr(4) + "to".
     2645         return.
     2646       end.
     2647       if v-old-stfl-i < v-waiting-stfl-i
     2648       and v-new-stfl-i > v-waiting-stfl-i then do:
     2649         assign
     2650         p-is-waiting-status = yes
     2651         p-direction = '<закрытие документа>':U + chr(4) + "to-up".
     2652         return.
     2653       end.
     2654       if v-new-stfl-i = v-waiting-stfl-i
     2655       and v-old-stfl-i > v-waiting-stfl-i then do:
     2656         assign
     2657         p-is-waiting-status = yes
     2658         p-direction = '<открытие документа>':U + chr(4) + "to".
     2659         return.
     2660         end.
     2661       if v-new-stfl-i < v-waiting-stfl-i
     2662       and v-old-stfl-i > v-waiting-stfl-i then do:
     2663         assign
     2664         p-is-waiting-status = yes
     2665         p-direction = '<открытие документа>':U + chr(4) + "to-down".
     2666         return.
     2667         end.
     2668       if v-old-stfl-i = v-waiting-stfl-i
     2669       and v-new-stfl-i > v-waiting-stfl-i then do:
     2670         assign
     2671         p-is-waiting-status = yes
     2672         p-direction = '<закрытие документа>':U + chr(4) + "from".
     2673         return.
     2674       end.
     2675       if v-old-stfl-i = v-waiting-stfl-i
     2676       and v-new-stfl-i < v-waiting-stfl-i then do:
     2677         assign
     2678         p-is-waiting-status = yes
     2679         p-direction = '<открытие документа>':U + chr(4) + "from".
     2680         return.
     2681         end.
     2682         end.
     2683     end.
     2684   end procedure.
     2685   procedure ord-rcv :
     2686   define input parameter p-oldbh              as handle no-undo .
     2687   define input parameter p-newbh              as handle no-undo .
     2688   define input parameter p-changed-fields     as character no-undo .
