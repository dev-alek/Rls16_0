     2773         assign
     2774         p-is-waiting-status = yes
     2775         p-direction = '<закрытие документа>':U + chr(4) + "from".
     2776         return.
     2777       end.
     2778       if v-old-stfl-i = v-waiting-stfl-i
     2779       and v-new-stfl-i < v-waiting-stfl-i then do:
     2780         assign
     2781         p-is-waiting-status = yes
     2782         p-direction = '<открытие документа>':U + chr(4) + "from".
     2783         return.
     2784         end.
     2785         end.
     2786      end.
     2787   end procedure.
     2788   procedure stat-graf-trn :
