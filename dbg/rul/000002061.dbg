     1917       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
     1918       define output parameter p-deleted  as logical no-undo.
     1919       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
     1920       define variable v-type           as character no-undo .
     1921       define variable v-format         as character no-undo .
     1922       define variable v-label          as character no-undo .
     1923       define variable v-range          as integer   no-undo .
     1924       define variable v-user-can-edit  as logical   no-undo .
     1925       define variable v-output-display as logical   no-undo .
