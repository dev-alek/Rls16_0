     2855                                                                   'факт':U         + chr(4) + string(yes)
     2856   v-stat-list[lookup('im':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] =
     2857                                                                   ''              + chr(4) + string(no) + chr(3) +
     2858                                                                   'факт':U         + chr(4) + string(yes)
     2859   v-stat-list[lookup('ap':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] =
     2860                                                                         ''              + chr(4) + string(no) + chr(3) +
     2861                                                                         'накл':U         + chr(4) + string(no) + chr(3) +
     2862                                                                         'факт':U         + chr(4) + string(yes)
     2863   v-stat-list[lookup('mp':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] =
     2864                                                                         ''              + chr(4) + string(no) + chr(3) +
     2865                                                                         'факт':U         + chr(4) + string(yes)
