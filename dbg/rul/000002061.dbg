     2871   v-stat-list[lookup('ie':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 2] =
     2872                    '' +           chr(4) + string(no) + chr(3) +
     2873                    'запрос':U +   chr(4) + string(no) + chr(3) +
