     2880   .
     2881   assign
     2882   v-stat-list[lookup('vt':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] =
     2883                    '' +           chr(4) + string(no) + chr(3) +
     2884                    'запрос':U +   chr(4) + string(no) + chr(3) +
     2885                    'запрос':U +   chr(4) + string(yes) + chr(3) +
     2886                    'накл':U +      chr(4) + string(no) + chr(3) +
     2887                    'накл':U +      chr(4) + string(yes) + chr(3) +
     2888                    'разрешен':U + chr(4) + string(yes) + chr(3) +
     2889                    'разрешен':U + chr(4) + string(no) + chr(3) +
     2890                    'факт':U +      chr(4) + string(yes)
     2891   .
     2892   assign
     2893   v-stat-list[lookup('vt':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 2] =
     2894                    '' +           chr(4) + string(no) + chr(3) +
     2895                    'запрос':U +   chr(4) + string(no) + chr(3) +
     2896                    'запрос':U +   chr(4) + string(yes) + chr(3) +
     2897                    'накл':U +      chr(4) + string(no) + chr(3) +
     2898                    'накл':U +      chr(4) + string(yes) + chr(3) +
     2899                    'разрешен':U + chr(4) + string(yes) + chr(3) +
     2900                    'разрешен':U + chr(4) + string(no) + chr(3) +
     2901                    'факт':U +      chr(4) + string(no)
     2902   .
     2903   assign
     2904   v-stat-list[lookup('es':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] =
     2905                    '' +           chr(4) + string(no) + chr(3) +
     2906                    'касс':U + chr(4) + string(no) + chr(3) +
     2907                    'касс':U + chr(4) + string(yes) + chr(3) +
     2908                    'нередакт':U + chr(4) + string(yes) + chr(3) +
     2909                    'факт':U +      chr(4) + string(yes)
     2910   v-stat-list[lookup('rs':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] =
     2911                    '' +           chr(4) + string(no) + chr(3) +
     2912                    'касс':U + chr(4) + string(no) + chr(3) +
     2913                    'касс':U + chr(4) + string(yes) + chr(3) +
     2914                    'нередакт':U + chr(4) + string(yes) + chr(3) +
     2915                    'факт':U +      chr(4) + string(yes)
     2916   v-stat-list[lookup('es':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 2] =
     2917                    '' +         chr(4) + string(no) + chr(3) +
     2918                    'запрос':U + chr(4) + string(no)
     2919   v-stat-list[lookup('rs':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 2] =
     2920                    '' +         chr(4) + string(no) + chr(3) +
     2921                    'запрос':U + chr(4) + string(no)
     2922   .
     2923   _jj:
     2924   do v-jj = 1 to 2:
     2925     if v-jj = 1 then do:
     2926       assign
     2927       v-waiting-stfl = p-waiting-status + chr(4) + string(if p-waiting-flag = ? then yes else p-waiting-flag)
     2928       .
     2929     end.
     2930     if v-jj = 2 then do:
     2931       if p-waiting-flag <> ? then leave  _jj.
     2932       assign
     2933       v-waiting-stfl = p-waiting-status + chr(4) + string(no)
     2934       .
     2935     end.
     2936     assign
     2937     v-old-stfl = p-oldbh::status_ + chr(4) + string(p-oldbh::flag_)
     2938     .
     2939     assign
     2940     v-new-stfl = p-newbh::status_ + chr(4) + string(p-newbh::flag_)
     2941     .
     2942     _ii:
     2943     do v-ii = (lookup(v-ext-doc-type, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3) to (lookup(v-ext-doc-type, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4):
     2944       if v-stat-list[v-ii] = '' then next.
     2945       assign
     2946       v-waiting-stfl-i = lookup(v-waiting-stfl, v-stat-list[v-ii], chr(3))
     2947       v-old-stfl-i = lookup(v-old-stfl, v-stat-list[v-ii], chr(3))
     2948       v-new-stfl-i = lookup(v-new-stfl, v-stat-list[v-ii], chr(3))
     2949       .
     2950       if v-waiting-stfl-i = 0
     2951       or v-old-stfl-i = 0
     2952       or v-new-stfl-i = 0
     2953       then do:
     2954         next _ii.
     2955       end.
     2956       if v-old-stfl-i < v-waiting-stfl-i
     2957       and v-new-stfl-i = v-waiting-stfl-i then do:
     2958         assign
     2959         p-is-waiting-status = yes
     2960         p-direction = '<закрытие документа>':U + chr(4) + "to".
     2961         return.
     2962       end.
     2963       if v-old-stfl-i < v-waiting-stfl-i
     2964       and v-new-stfl-i > v-waiting-stfl-i then do:
     2965         assign
     2966         p-is-waiting-status = yes
     2967         p-direction = '<закрытие документа>':U + chr(4) + "to-up".
     2968         return.
     2969       end.
     2970       if v-new-stfl-i = v-waiting-stfl-i
     2971       and v-old-stfl-i > v-waiting-stfl-i then do:
     2972         assign
     2973         p-is-waiting-status = yes
     2974         p-direction = '<открытие документа>':U + chr(4) + "to".
     2975         return.
     2976       end.
     2977       if v-new-stfl-i < v-waiting-stfl-i
     2978       and v-old-stfl-i > v-waiting-stfl-i then do:
     2979         assign
     2980         p-is-waiting-status = yes
     2981         p-direction = '<открытие документа>':U + chr(4) + "to-down".
     2982         return.
     2983       end.
     2984       if v-old-stfl-i = v-waiting-stfl-i
     2985       and v-new-stfl-i > v-waiting-stfl-i then do:
     2986         assign
     2987         p-is-waiting-status = yes
     2988         p-direction = '<закрытие документа>':U + chr(4) + "from".
     2989         return.
     2990       end.
     2991       if v-old-stfl-i = v-waiting-stfl-i
     2992       and v-new-stfl-i < v-waiting-stfl-i then do:
     2993         assign
     2994         p-is-waiting-status = yes
     2995         p-direction = '<открытие документа>':U + chr(4) + "from".
     2996         return.
     2997       end.
     2998     end.
     2999   end.
     3000   end.
     3001   end procedure .
     3002   procedure stat-graf-price :
     3003   define input parameter p-oldbh              as handle no-undo .
     3004   define input parameter p-newbh              as handle no-undo .
     3005   define input parameter p-changed-fields     as character no-undo .
     3006   define input parameter p-waiting-status     as character no-undo .
     3007   define input parameter p-waiting-flag       as logical no-undo .
     3008   define output parameter p-is-waiting-status as logical no-undo .
     3009   define output parameter p-direction         as character no-undo .
     3010   define variable v-stat-list as character no-undo extent 5.
     3011   define variable v-waiting-stfl as character no-undo .
     3012   define variable v-old-stfl as character no-undo .
     3013   define variable v-new-stfl as character no-undo .
     3014   define variable v-waiting-stfl-i as integer no-undo .
     3015   define variable v-old-stfl-i as integer no-undo .
     3016   define variable v-new-stfl-i as integer no-undo .
     3017   define variable v-ii as integer no-undo .
     3018   do
     3019   on error undo, return error return-value
     3020   :
     3021   assign
     3022   v-stat-list[1] =
     3023                    ''            +  chr(3) +
     3024                    'новый':U    +  chr(3) +
     3025                    'приказ':U      +  chr(3) +
     3026                    'разрешен':U  +  chr(3) +
     3027                    'акт':U
     3028   .
     3029     assign
     3030     v-waiting-stfl = p-waiting-status
     3031     .
     3032     assign
     3033     v-old-stfl = p-oldbh::status_
     3034     .
     3035     assign
     3036     v-new-stfl = p-newbh::status_
     3037     .
     3038     _ii:
     3039     do v-ii = 1 to 5:
     3040       if v-stat-list[v-ii] = '' then next.
     3041       assign
     3042       v-waiting-stfl-i = lookup(v-waiting-stfl, v-stat-list[v-ii], chr(3))
     3043       v-old-stfl-i = lookup(v-old-stfl, v-stat-list[v-ii], chr(3))
     3044       v-new-stfl-i = lookup(v-new-stfl, v-stat-list[v-ii], chr(3))
     3045       .
     3046       if v-waiting-stfl-i = 0
     3047       or v-old-stfl-i = 0
     3048       or v-new-stfl-i = 0
     3049       then do:
     3050         next _ii.
     3051       end.
     3052       if v-old-stfl-i < v-waiting-stfl-i
     3053       and v-new-stfl-i = v-waiting-stfl-i then do:
     3054         assign
     3055         p-is-waiting-status = yes
     3056         p-direction = '<закрытие документа>':U + chr(4) + "to".
     3057         return.
     3058       end.
     3059       if v-old-stfl-i < v-waiting-stfl-i
     3060       and v-new-stfl-i > v-waiting-stfl-i then do:
     3061         assign
     3062         p-is-waiting-status = yes
     3063         p-direction = '<закрытие документа>':U + chr(4) + "to-up".
     3064         return.
     3065       end.
     3066       if v-new-stfl-i = v-waiting-stfl-i
     3067       and v-old-stfl-i > v-waiting-stfl-i then do:
     3068         assign
     3069         p-is-waiting-status = yes
     3070         p-direction = '<открытие документа>':U + chr(4) + "to".
     3071         return.
     3072       end.
     3073       if v-new-stfl-i < v-waiting-stfl-i
     3074       and v-old-stfl-i > v-waiting-stfl-i then do:
     3075         assign
     3076         p-is-waiting-status = yes
     3077         p-direction = '<открытие документа>':U + chr(4) + "to-down".
     3078         return.
     3079       end.
     3080       if v-old-stfl-i = v-waiting-stfl-i
     3081       and v-new-stfl-i > v-waiting-stfl-i then do:
     3082         assign
     3083         p-is-waiting-status = yes
     3084         p-direction = '<закрытие документа>':U + chr(4) + "from".
     3085         return.
     3086       end.
     3087       if v-old-stfl-i = v-waiting-stfl-i
     3088       and v-new-stfl-i < v-waiting-stfl-i then do:
     3089         assign
     3090         p-is-waiting-status = yes
     3091         p-direction = '<открытие документа>':U + chr(4) + "from".
     3092         return.
     3093       end.
     3094     end.
     3095   end.
     3096   end procedure.
     3097   procedure stat-graf-inkas :
     3098   define input parameter  p-oldbh              as handle no-undo .
     3099   define input parameter  p-newbh              as handle no-undo .
     3100   define input parameter  p-changed-fields     as character no-undo .
     3101   define input parameter  p-waiting-status     as character no-undo .
     3102   define input parameter  p-waiting-flag       as logical no-undo .
     3103   define output parameter p-is-waiting-status  as logical no-undo .
     3104   define output parameter p-direction          as character no-undo .
     3105   define variable v-doc-code as character no-undo .
     3106   define variable v-ext-doc-type as character no-undo .
     3107   define variable v-stat-list as character no-undo extent 3.
     3108   define variable v-jj as integer no-undo .
     3109   define variable v-ii as integer no-undo .
     3110   define variable v-old-stfl as character no-undo .
     3111   define variable v-new-stfl as character no-undo .
     3112   define variable v-waiting-stfl as character no-undo .
     3113   define variable v-old-stfl-i as integer no-undo .
     3114   define variable v-new-stfl-i as integer no-undo .
     3115   define variable v-waiting-stfl-i as integer no-undo .
     3116   do
     3117   on error  undo, return error substitute( "&1. &2&3&4", vss-include-info20, return-value, chr(10), error-status :get-message (1))
     3118   :
     3119   if p-newbh = ?  then do:
     3120     v-doc-code = p-oldbh::inkas-code .
     3121   end.
     3122   else do:
     3123     v-doc-code     = p-newbh::inkas-code .
     3124   end.
     3125   assign
     3126   v-stat-list[1] =
     3127                    '' +           chr(4) + string(no) + chr(3) +
     3128                    'новый':U + chr(4) + string(no) + chr(3) +
     3129                    'факт':U +      chr(4) + string(no)
     3130   v-stat-list[2] =
     3131                    '' +           chr(4) + string(no) + chr(3) +
     3132                    'новый':U + chr(4) + string(no) + chr(3) +
     3133                    'новый':U + chr(4) + string(yes) + chr(3) +
     3134                    'нередакт':U + chr(4) + string(yes) + chr(3) +
     3135                    'факт':U +      chr(4) + string(no)
     3136   v-stat-list[3] =
     3137                    '' +         chr(4) + string(no) + chr(3) +
     3138                    'запрос':U + chr(4) + string(no)
     3139   .
     3140   _jj:
     3141   do v-jj = 1 to 2:
     3142     if v-jj = 1 then do:
     3143       assign
     3144       v-waiting-stfl = p-waiting-status + chr(4) + string(if p-waiting-flag = ? then no else p-waiting-flag)
     3145       .
     3146     end.
     3147     if v-jj = 2 then do:
     3148       if p-waiting-flag <> ? then leave  _jj.
     3149       assign
     3150       v-waiting-stfl = p-waiting-status + chr(4) + string(yes)
     3151       .
     3152     end.
     3153     assign
     3154     v-old-stfl = p-oldbh::status_ + chr(4) + string(p-oldbh::flag_)
     3155     .
     3156     assign
     3157     v-new-stfl = p-newbh::status_ + chr(4) + string(p-newbh::flag_)
     3158     .
     3159     _ii:
     3160     do v-ii = 1 to 3:
     3161       if v-stat-list[v-ii] = '' then next.
     3162       assign
     3163       v-waiting-stfl-i = lookup(v-waiting-stfl, v-stat-list[v-ii], chr(3))
     3164       v-old-stfl-i = lookup(v-old-stfl, v-stat-list[v-ii], chr(3))
     3165       v-new-stfl-i = lookup(v-new-stfl, v-stat-list[v-ii], chr(3))
     3166       .
     3167       if v-waiting-stfl-i = 0
     3168       or v-old-stfl-i = 0
     3169       or v-new-stfl-i = 0
     3170       then do:
     3171         next _ii.
     3172       end.
     3173       if v-old-stfl-i < v-waiting-stfl-i
     3174       and v-new-stfl-i = v-waiting-stfl-i then do:
     3175         assign
     3176         p-is-waiting-status = yes
     3177         p-direction = '<закрытие документа>':U + chr(4) + "to".
     3178         return.
     3179       end.
     3180       if v-old-stfl-i < v-waiting-stfl-i
     3181       and v-new-stfl-i > v-waiting-stfl-i then do:
     3182         assign
     3183         p-is-waiting-status = yes
     3184         p-direction = '<закрытие документа>':U + chr(4) + "to-up".
     3185         return.
     3186       end.
     3187       if v-new-stfl-i = v-waiting-stfl-i
     3188       and v-old-stfl-i > v-waiting-stfl-i then do:
     3189         assign
     3190         p-is-waiting-status = yes
     3191         p-direction = '<открытие документа>':U + chr(4) + "to".
     3192         return.
     3193       end.
     3194       if v-new-stfl-i < v-waiting-stfl-i
     3195       and v-old-stfl-i > v-waiting-stfl-i then do:
     3196         assign
     3197         p-is-waiting-status = yes
     3198         p-direction = '<открытие документа>':U + chr(4) + "to-down".
     3199         return.
     3200       end.
     3201       if v-old-stfl-i = v-waiting-stfl-i
     3202       and v-new-stfl-i > v-waiting-stfl-i then do:
     3203         assign
     3204         p-is-waiting-status = yes
     3205         p-direction = '<закрытие документа>':U + chr(4) + "from".
     3206         return.
     3207       end.
     3208       if v-old-stfl-i = v-waiting-stfl-i
     3209       and v-new-stfl-i < v-waiting-stfl-i then do:
     3210         assign
     3211         p-is-waiting-status = yes
     3212         p-direction = '<открытие документа>':U + chr(4) + "from".
     3213         return.
     3214       end.
     3215     end.
     3216   end.
     3217   end.
     3218   end procedure .
