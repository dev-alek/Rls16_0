     1908   procedure cp-attr-delete :
     1909     do
     1910     on error undo, return error
     1911     :
     1912       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
     1913       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
