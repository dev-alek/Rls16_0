     2109   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2110   procedure strtdate :
     2111     define input  parameter p-str         as character no-undo .
     2112     define output parameter p-value       as date      no-undo .
     2113     define output parameter p-data-valid  as logical   no-undo .
     2114     define output parameter p-message     as character no-undo .
     2115   do
     2116   on error undo, return error return-value
     2117   :
     2118     define variable v-value       as date      no-undo .
     2119     define variable v-i           as integer   no-undo .
     2120     define variable v-num         as integer   no-undo .
     2121     define variable v-delim       as character no-undo .
     2122     define variable v-delim-list  as character no-undo .
     2123     define variable v-day         as integer   no-undo .
     2124     define variable v-month       as integer   no-undo .
     2125     define variable v-year        as integer   no-undo .
     2126     define variable v-day-str     as character no-undo .
     2127     define variable v-month-str   as character no-undo .
     2128     define variable v-year-str    as character no-undo .
     2129     assign
     2130       p-value       = ?
     2131       p-data-valid  = false
     2132     .
     2133     if p-str = ?
     2134     then do:
     2135       assign
     2136         p-message = substitute("Ошибка задания входных параметров. Не задана строка для преобразования. " )
     2137       .
     2138       return .
     2139     end.
     2140     if p-str = ""
     2141     then do:
     2142       assign
     2143         p-message = substitute("Ошибка задания входных параметров. Задана пустая строка для преобразования. " )
     2144       .
     2145       return .
     2146     end.
     2147     if length(p-str)  > 10
     2148     then do:
     2149       assign
     2150         p-message = substitute("Ошибка при преобразовании к дате. Неверная длина строки. " )
     2151       .
     2152       return .
     2153     end.
     2154     assign
     2155       v-delim-list = '/,-,.':U
     2156     .
     2157     _delim:
     2158     do v-i = 1 to num-entries( v-delim-list )
     2159     :
     2160       assign
     2161         v-delim = entry( v-i , v-delim-list )
     2162         v-num   = num-entries( p-str , v-delim )
     2163       .
     2164       if v-num <> 3
     2165       then do:
     2166         assign
     2167           v-delim = ''
     2168         .
     2169       end.
     2170       else do:
     2171         leave _delim.
     2172       end.
     2173     end.
     2174     if v-delim = ''
     2175     then do:
     2176       assign
     2177         p-message = substitute( "Ошибка при преобразовании к дате. Неправильный разделитель, либо ошибочное количество разделителей. " )
     2178       .
     2179       return .
     2180     end.
     2181     assign
     2182       v-day-str   = entry( 1, p-str , v-delim)
     2183       v-month-str = entry( 2, p-str , v-delim)
     2184       v-year-str  = entry( 3, p-str , v-delim)
     2185     .
     2186     if  length(v-day-str) > 2   or
     2187         length(v-day-str) < 1   or
     2188         length(v-month-str) > 2 or
     2189         length(v-month-str) < 1 or
     2190         (
     2191           length(v-year-str) <> 2 and
     2192           length(v-year-str) <> 4
     2193         )
     2194     then do:
     2195       assign
     2196         p-message = substitute("Ошибка при преобразовании к дате. Неправильное количество символов числа, месяца, либо года. " )
     2197       .
     2198       return .
     2199     end.
     2200     if length( v-year-str ) = 2
     2201     then do:
     2202       assign
     2203         v-year-str = substring( string( year(today) ), 1 , 2 ) + v-year-str
     2204       .
     2205     end.
     2206     assign
     2207       v-day   = integer( v-day-str )
     2208       v-month = integer( v-month-str)
     2209       v-year  = integer( v-year-str)
     2210     no-error .
     2211     if error-status :error
     2212     then do:
     2213       assign
     2214         p-message = substitute("Ошибка при преобразовании к дате. Неверный формат символов числа, месяца, либо года. " )
     2215       .
     2216       return .
     2217     end.
     2218     if v-day < 1  or
     2219        v-day > 31 or
     2220        v-month < 1 or
     2221        v-month > 12 or
     2222        v-year < 0   or
     2223        v-year > 5000
     2224     then do:
     2225       assign
     2226         p-message = substitute("Ошибка при преобразовании к дате. Неверный диапозон числа, месяца, года. " )
     2227       .
     2228       return .
     2229     end.
     2230     assign
     2231       v-value = date( v-month, v-day, v-year )
     2232     no-error .
     2233     if error-status :error
     2234     then do:
     2235       assign
     2236         p-message = substitute("Ошибка при преобразовании к дате. &1. " , error-status :get-message(1))
     2237       .
     2238       return .
     2239     end.
     2240     assign
     2241       p-value       = v-value
     2242       p-data-valid  = true
     2243     .
     2244   end.
     2245   end procedure.
     2246   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2247   procedure statq_has-waiting-stat :
     2248   define input parameter p-oldbh              as handle no-undo .
     2249   define input parameter p-newbh              as handle no-undo .
     2250   define input parameter p-changed-fields     as character no-undo .
     2251   define input parameter p-waiting-status     as character no-undo .
     2252   define input parameter p-waiting-flag       as logical no-undo .
     2253   define input parameter p-waiting-stati      as integer no-undo .
     2254   define output parameter p-is-waiting-status as logical no-undo .
     2255   define output parameter p-direction         as character no-undo .
     2256   define variable v-has-newbh as logical no-undo .
     2257   define variable v-has-oldbh as logical no-undo .
     2258   define variable v-changed-fields as character no-undo .
     2259   define variable v-ii as integer no-undo .
     2260   define variable v-flag as logical   no-undo .
     2261   define variable v-some-bh as handle no-undo .
     2262   assign
     2263   v-has-oldbh = valid-handle(p-oldbh) and p-oldbh:available
     2264   v-has-newbh = valid-handle(p-newbh) and p-newbh:available
     2265   v-flag = false
     2266   .
     2267   if v-has-newbh then do:
     2268     if p-changed-fields = '' then do:
     2269       v-changed-fields = "status_,flag_".
     2270       do v-ii = 1 to num-entries(v-changed-fields):
     2271         if p-oldbh:buffer-field(entry(v-ii, v-changed-fields)):buffer-value <> p-newbh:buffer-field(entry(v-ii, v-changed-fields)):buffer-value then do:
     2272           v-flag = yes.
     2273           leave.
     2274         end.
     2275       end.
     2276       if not v-flag then do:
     2277          assign
     2278            p-direction          = ""
     2279            p-is-waiting-status   = false
     2280          .
     2281          return .
     2282       end.
     2283     end.
     2284     else do:
     2285       if lookup("status_", p-changed-fields) = 0
     2286       and lookup("flag_", p-changed-fields) = 0
     2287       and not(p-newbh:new) then do:
     2288          assign
     2289            p-direction          = ""
     2290            p-is-waiting-status   = false
     2291          .
     2292          return .
     2293       end.
     2294       else do:
     2295         if lookup("status_", p-changed-fields) > 0  and lookup("flag_", p-changed-fields) > 0 and
     2296           p-newbh::status_ = p-waiting-status and
     2297           (p-newbh:table = 'price-doc':U or p-newbh::flag_   = p-waiting-flag)   then do:
     2298             assign
     2299                 p-direction          = '<закрытие документа>':U
     2300                 p-is-waiting-status   = true
     2301             .
     2302             return .
     2303          end.
     2304         if lookup("status_", p-changed-fields) > 0  and lookup("flag_", p-changed-fields) = 0 and
     2305           p-newbh::status_ = p-waiting-status  then do:
     2306             assign
     2307                 p-direction          = '<закрытие документа>':U
     2308                 p-is-waiting-status   = true
     2309             .
     2310             return .
     2311          end.
     2312         if lookup("status_", p-changed-fields) = 0  and lookup("flag_", p-changed-fields) > 0 and
     2313         (p-newbh:table = 'price-doc':U or p-newbh::flag_   = p-waiting-flag )  then do:
     2314             assign
     2315                 p-direction          = '<закрытие документа>':U
     2316                 p-is-waiting-status   = true
     2317             .
     2318             return .
     2319          end.
     2320           if lookup("status_", p-changed-fields) > 0  and lookup("flag_", p-changed-fields) > 0 and
     2321           p-newbh::status_ = p-waiting-status and
     2322           (p-newbh:table = 'price-doc':U or p-waiting-flag = ? )  then do:
     2323             assign
     2324                 p-direction          = '<закрытие документа>':U
     2325                 p-is-waiting-status   = true
     2326             .
     2327             return .
     2328          end.
     2329       end.
     2330     end.
     2331   end.
     2332   else do:
     2333     if p-changed-fields = '' then do:
     2334       if p-oldbh::status_ = p-waiting-status
     2335       and (p-oldbh:table = 'price-doc':U
     2336           or
     2337         (p-waiting-flag = ?
     2338         or p-oldbh::flag_ = p-waiting-flag)) then do:
     2339         assign
     2340         p-direction = 'удаление':U
     2341         p-is-waiting-status = yes.
     2342         return.
     2343       end.
     2344       else do:
     2345         assign
     2346         p-direction          = ""
     2347         p-is-waiting-status = no.
     2348         return.
     2349       end.
     2350     end.
     2351     else do:
     2352       if lookup("status_", p-changed-fields) = 0
     2353       and lookup("flag_", p-changed-fields) = 0
     2354       then do:
     2355          assign
     2356             p-is-waiting-status  = false
     2357             p-direction          = ""
     2358          .
     2359          return .
     2360       end.
     2361     end.
     2362   end.
     2363   if v-has-newbh then do:
     2364     v-some-bh = p-newbh.
     2365   end.
     2366   else do:
     2367     v-some-bh = p-oldbh.
     2368   end.
     2369   case v-some-bh:table :
     2370     when 'ord-doc':U  then do:
     2371        if v-some-bh::doc-type = 'ОР':U or v-some-bh::doc-type = 'ОП':U then do:
     2372        if v-some-bh::doc-type = 'ОР':U then do:
     2373           run ord-orc in this-procedure
     2374           ( input  p-oldbh
     2375            ,input  p-newbh
     2376            ,input  p-changed-fields
     2377            ,input  p-waiting-status
     2378            ,input  p-waiting-flag
     2379            ,output p-is-waiting-status
     2380            ,output p-direction  )  .
     2381        end.
     2382        if v-some-bh::doc-type = 'ОП':U then do:
     2383           run ord-op in this-procedure
     2384           ( input  p-oldbh
     2385            ,input  p-newbh
     2386            ,input  p-changed-fields
     2387            ,input  p-waiting-status
     2388            ,input  p-waiting-flag
     2389            ,output p-is-waiting-status
     2390            ,output p-direction  )  .
     2391        end.
     2392        end.
     2393        else do:
     2394          assign
     2395             p-is-waiting-status  = false
     2396             p-direction          = ""
     2397          .
     2398        end.
     2399     end.
     2400     when 'ord-doc-rcv':U  then do:
     2401           run ord-rcv in this-procedure
     2402           ( input  p-oldbh
     2403            ,input  p-newbh
     2404            ,input  p-changed-fields
     2405            ,input  p-waiting-status
     2406            ,input  p-waiting-flag
     2407            ,output p-is-waiting-status
     2408            ,output p-direction  )  .
     2409     end.
     2410     when 'trn-doc':U  then do:
     2411           run stat-graf-trn in this-procedure
     2412           ( input  p-oldbh
     2413            ,input  p-newbh
     2414            ,input  p-changed-fields
     2415            ,input  p-waiting-status
     2416            ,input  p-waiting-flag
     2417            ,output p-is-waiting-status
     2418            ,output p-direction  )  .
     2419     end.
     2420     when 'price-doc':U then do:
     2421       run stat-graf-price in this-procedure
     2422           ( input  p-oldbh
     2423            ,input  p-newbh
     2424            ,input  p-changed-fields
     2425            ,input  p-waiting-status
     2426            ,input  p-waiting-flag
     2427            ,output p-is-waiting-status
     2428            ,output p-direction  )  .
     2429     end.
     2430     when 'inkas':U then do:
     2431           run stat-graf-inkas in this-procedure
     2432           ( input  p-oldbh
     2433            ,input  p-newbh
     2434            ,input  p-changed-fields
     2435            ,input  p-waiting-status
     2436            ,input  p-waiting-flag
     2437            ,output p-is-waiting-status
     2438            ,output p-direction  )  .
     2439     end.
     2440     otherwise do:
     2441          assign
     2442             p-is-waiting-status  = false
     2443             p-direction          = ""
     2444          .
     2445     end.
     2446   end case.
     2447   return .
     2448   end procedure.
     2449   procedure ord-op :
     2450   define input parameter p-oldbh              as handle no-undo .
     2451   define input parameter p-newbh              as handle no-undo .
     2452   define input parameter p-changed-fields     as character no-undo .
     2453   define input parameter p-waiting-status     as character no-undo .
     2454   define input parameter p-waiting-flag       as logical no-undo .
     2455   define output parameter p-is-waiting-status as logical no-undo .
     2456   define output parameter p-direction         as character no-undo .
     2457   define variable v-stat-list as character no-undo extent 5.
     2458   define variable v-waiting-stfl as character no-undo .
     2459   define variable v-old-stfl as character no-undo .
     2460   define variable v-new-stfl as character no-undo .
     2461   define variable v-waiting-stfl-i as integer no-undo .
     2462   define variable v-old-stfl-i as integer no-undo .
     2463   define variable v-new-stfl-i as integer no-undo .
     2464   define variable v-ii as integer no-undo .
     2465     do
     2466     on error undo, return error return-value
     2467     :
     2468   assign
     2469   v-stat-list[1] =
     2470                    ''            +  chr(3) +
     2471                    'новый':U    +  chr(3) +
     2472                    'согласование':U +  chr(3) +
     2473                    'поставка':U    +  chr(3) +
     2474                    'закрыто':U  +  chr(3) +
     2475                    'факт':U
     2476   v-stat-list[2] =
     2477                    ''            +  chr(3) +
     2478                    'новый':U    +  chr(3) +
     2479                    'отказ':U
     2480   v-stat-list[3] =
     2481                    ''            +  chr(3) +
     2482                    'новый':U    +  chr(3) +
     2483                    'согласование':U +  chr(3) +
     2484                    'отказ':U
     2485   v-stat-list[4] =
     2486                    ''            +  chr(3) +
     2487                    'новый':U    +  chr(3) +
     2488                    'согласование':U +  chr(3) +
     2489                    'поставка':U    +  chr(3) +
     2490                    'отказ':U
     2491   v-stat-list[5] =
     2492                    ''            +  chr(3) +
     2493                    'новый':U    +  chr(3) +
     2494                    'согласование':U +  chr(3) +
     2495                    'поставка':U    +  chr(3) +
     2496                    'закрыто':U  +  chr(3) +
     2497                    'отказ':U
     2498   .
     2499     assign
     2500     v-waiting-stfl = p-waiting-status
     2501     .
     2502     assign
     2503     v-old-stfl = p-oldbh::status_
     2504     .
     2505     assign
     2506     v-new-stfl = p-newbh::status_
     2507     .
     2508     _ii:
     2509     do v-ii = 1 to 5:
     2510       if v-stat-list[v-ii] = '' then next.
     2511       assign
     2512       v-waiting-stfl-i = lookup(v-waiting-stfl, v-stat-list[v-ii], chr(3))
     2513       v-old-stfl-i = lookup(v-old-stfl, v-stat-list[v-ii], chr(3))
     2514       v-new-stfl-i = lookup(v-new-stfl, v-stat-list[v-ii], chr(3))
     2515       .
     2516       if v-waiting-stfl-i = 0
     2517       or v-old-stfl-i = 0
     2518       or v-new-stfl-i = 0
     2519       then do:
     2520         next _ii.
     2521         end.
     2522       if v-old-stfl-i < v-waiting-stfl-i
     2523       and v-new-stfl-i = v-waiting-stfl-i then do:
     2524         assign
     2525         p-is-waiting-status = yes
     2526         p-direction = '<закрытие документа>':U + chr(4) + "to".
     2527         return.
     2528         end.
     2529       if v-old-stfl-i < v-waiting-stfl-i
     2530       and v-new-stfl-i > v-waiting-stfl-i then do:
     2531         assign
     2532         p-is-waiting-status = yes
     2533         p-direction = '<закрытие документа>':U + chr(4) + "to-up".
     2534         return.
     2535         end.
     2536       if v-new-stfl-i = v-waiting-stfl-i
     2537       and v-old-stfl-i > v-waiting-stfl-i then do:
     2538         assign
     2539         p-is-waiting-status = yes
     2540         p-direction = '<открытие документа>':U + chr(4) + "to".
     2541         return.
     2542         end.
     2543       if v-new-stfl-i < v-waiting-stfl-i
     2544       and v-old-stfl-i > v-waiting-stfl-i then do:
     2545         assign
     2546         p-is-waiting-status = yes
     2547         p-direction = '<открытие документа>':U + chr(4) + "to-down".
     2548         return.
     2549         end.
     2550       if v-old-stfl-i = v-waiting-stfl-i
     2551       and v-new-stfl-i > v-waiting-stfl-i then do:
     2552         assign
     2553         p-is-waiting-status = yes
     2554         p-direction = '<закрытие документа>':U + chr(4) + "from".
     2555         return.
     2556       end.
     2557       if v-old-stfl-i = v-waiting-stfl-i
     2558       and v-new-stfl-i < v-waiting-stfl-i then do:
     2559         assign
     2560         p-is-waiting-status = yes
     2561         p-direction = '<открытие документа>':U + chr(4) + "from".
     2562         return.
     2563       end.
     2564     end.
     2565     end.
     2566   end procedure.
     2567   procedure ord-orc :
     2568   define input parameter p-oldbh              as handle no-undo .
     2569   define input parameter p-newbh              as handle no-undo .
     2570   define input parameter p-changed-fields     as character no-undo .
