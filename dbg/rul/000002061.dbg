     1697   procedure cp-attr-code :
     1698     do
     1699     on error undo, return error
     1700     :
     1701       define input  parameter p-code           as character no-undo .
     1702       define output parameter p-type           as character no-undo .
     1703       define output parameter p-format         as character no-undo .
     1704       define output parameter p-label          as character no-undo .
     1705       define output parameter p-range          as integer   no-undo .
     1706       define output parameter p-user-can-edit  as logical   no-undo .
     1707       define output parameter p-output-display as logical   no-undo .
     1708       define output parameter p-other          as character no-undo .
     1709       case p-code :
     1710               when 'paycard-export-prefix':U then do:     assign     p-label = "Префиксы платежных карт (для выгрузки в XML)"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт (для выгрузки в XML)"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
     1711               when 'grp-code':U then do:     assign     p-label = "Группа платежа"     p-type = 'C':U      p-format = "X(45)"     p-label = "Группа платежа"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=grp-code':u      .   end.
     1712               when 'is-use':U then do:     assign     p-label = "Используется"     p-type = 'C':U      p-format = "X(255)"     p-label = "Используется"     p-range = 4     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=is-use':u      .   end.
     1713               when 'dop-doc':U then do:     assign     p-label = "Дополнительный документ"     p-type = 'C':U      p-format = "X(255)"     p-label = "Дополнительный документ"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=dop-doc':u      .   end.
     1714               when 'paycard-all-prefix':U then do:     assign     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
     1715               when 'paycard-edit-prefix':U then do:     assign     p-label = "Префиксы платежных карт, разрешенных для редактирования"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт, разрешенных для редактирования"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
     1716               when 'form_km3':U then do:     assign     p-label = "Формировать КМ-3 по чекам возврата"     p-type = 'L':U      p-format = "+/-"     p-label = "Формировать КМ-3 по чекам возврата"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
     1717               when 'bal_malina':U then do:     assign     p-label = "Оплата баллами Малина"     p-type = 'L':U      p-format = "+/-"     p-label = "Оплата баллами Малина"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
     1718               when 'max_proc_sum':U then do:     assign     p-label = "Максимальный % порог от суммы"     p-type = 'D':U      p-format = ">>9.99"     p-label = "Максимальный % порог от суммы"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
     1719               when 'mask_card_kup':U then do:     assign     p-label = "Маска карты\купона"     p-type = 'C':U      p-format = "x(129)"     p-label = "Маска карты\купона"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
     1720         otherwise do:
     1721           undo, return error substitute("неизвестный атрибут типа кассового платежа &1", p-code ).
     1722         end.
     1723       end.
     1724     end.
     1725   end procedure.
     1726   procedure cp-attr-tooltip :
     1727     do
     1728     on error undo, return error
     1729     :
     1730       define input  parameter p-code    as character no-undo .
     1731       define output parameter p-tooltip as character no-undo .
     1732       define output parameter p-label   as character no-undo .
     1733       case p-code :
     1734               when 'paycard-export-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт (для выгрузки в XML)"     p-label = "Префиксы платежных карт (для выгрузки в XML)" .   end.
     1735               when 'grp-code':U then do:     assign     p-tooltip = "Группа платежа"     p-label = "Группа платежа" .   end.
     1736               when 'is-use':U then do:     assign     p-tooltip = "Используется"     p-label = "Используется" .   end.
     1737               when 'dop-doc':U then do:     assign     p-tooltip = "Дополнительный документ"     p-label = "Дополнительный документ" .   end.
     1738               when 'paycard-all-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)" .   end.
     1739               when 'paycard-edit-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт, разрешенных для редактировани"     p-label = "Префиксы платежных карт, разрешенных для редактирования" .   end.
     1740               when 'form_km3':U then do:     assign     p-tooltip = "Формировать КМ-3 по чекам возврата"     p-label = "Формировать КМ-3 по чекам возврата" .   end.
     1741               when 'bal_malina':U then do:     assign     p-tooltip = "Оплата баллами Малина"     p-label = "Оплата баллами Малина" .   end.
     1742               when 'max_proc_sum':U then do:     assign     p-tooltip = "Максимальный % порог от суммы"     p-label = "Максимальный % порог от суммы" .   end.
     1743               when 'mask_card_kup':U then do:     assign     p-tooltip = "Маска карты\купона"     p-label = "Маска карты\купона" .   end.
     1744         otherwise do:
     1745           undo, return error substitute("неизвестный атрибут типа кассового платежа &1", p-code) .
     1746         end.
     1747       end.
     1748     end.
     1749   end procedure.
     1750   procedure cp-attr-value :
     1751     do
     1752     on error undo, return error
     1753     :
     1754       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
     1755       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
     1756       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
     1757       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
     1758       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
     1759       define input  parameter p-code        like ub.cash-pay-attr.attr-code      no-undo .
     1760       define output parameter p-value       like ub.cash-pay-attr.attr-value    no-undo .
     1761       define output parameter p-type        as character no-undo .
     1762       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
     1763       define variable v-format         as character no-undo .
     1764       define variable v-label          as character no-undo .
     1765       define variable v-range          as integer   no-undo .
     1766       define variable v-user-can-edit  as logical   no-undo .
     1767       define variable v-output-display as logical   no-undo .
     1768       define variable v-other          as character no-undo .
     1769       run cp-attr-code in this-procedure
     1770         (input  p-code
     1771         ,output p-type
     1772         ,output v-format
     1773         ,output v-label
     1774         ,output v-range
     1775         ,output v-user-can-edit
     1776         ,output v-output-display
     1777         ,output v-other
     1778         ) no-error .
     1779       if error-status :error then do:
     1780         undo, return error return-value .
     1781       end.
     1782       find first buf_cash-pay-attr no-lock
     1783         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
     1784           and buf_cash-pay-attr.curr-code  = p-curr-code
     1785           and buf_cash-pay-attr.host-code  = p-host-code
     1786           and buf_cash-pay-attr.obj-type   = p-obj-type
     1787           and buf_cash-pay-attr.obj-code   = p-obj-code
     1788           and buf_cash-pay-attr.attr-code  = p-code
     1789         no-error .
     1790       if avail buf_cash-pay-attr then do:
     1791         assign
     1792           p-value =  buf_cash-pay-attr.attr-value
     1793         .
     1794       end.
     1795       else do:
     1796         assign
     1797           p-value = if p-type = 'L':U then "no":U else ""
     1798         .
     1799       end.
     1800     end.
     1801   end procedure.
     1802   procedure cp-attr-write :
     1803     do
     1804     on error undo, return error
     1805     :
     1806       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
     1807       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
     1808       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
     1809       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
     1810       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
     1811       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
     1812       define input parameter p-value    like ub.cash-pay-attr.attr-value no-undo .
     1813       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
     1814       define buffer last_cash-pay-attr for ub.cash-pay-attr .
     1815       define variable v-type           as character no-undo .
     1816       define variable v-format         as character no-undo .
     1817       define variable v-label          as character no-undo .
     1818       define variable v-range          as integer   no-undo .
     1819       define variable v-user-can-edit  as logical   no-undo .
     1820       define variable v-output-display as logical   no-undo .
     1821       define variable v-other          as character no-undo .
     1822       run cp-attr-code in this-procedure
     1823         (input  p-code
     1824         ,output v-type
     1825         ,output v-format
     1826         ,output v-label
     1827         ,output v-range
     1828         ,output v-user-can-edit
     1829         ,output v-output-display
     1830         ,output v-other
     1831         ) no-error .
     1832       if error-status :error then do:
     1833         undo, return error return-value .
     1834       end.
     1835       find first buf_cash-pay-attr exclusive-lock
     1836         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
     1837           and buf_cash-pay-attr.curr-code  = p-curr-code
     1838           and buf_cash-pay-attr.host-code  = p-host-code
     1839           and buf_cash-pay-attr.obj-type   = p-obj-type
     1840           and buf_cash-pay-attr.obj-code   = p-obj-code
     1841           and buf_cash-pay-attr.attr-code = p-code
     1842         no-error .
     1843       if not available buf_cash-pay-attr then do:
     1844         create buf_cash-pay-attr .
     1845         assign
     1846         buf_cash-pay-attr.cdpay-code = p-cdpay-code
     1847         buf_cash-pay-attr.curr-code  = p-curr-code
     1848         buf_cash-pay-attr.host-code  = p-host-code
     1849         buf_cash-pay-attr.obj-type   = p-obj-type
     1850         buf_cash-pay-attr.obj-code   = p-obj-code
     1851         buf_cash-pay-attr.attr-code = p-code
     1852         .
     1853       end.
     1854       assign
     1855         buf_cash-pay-attr.attr-value = p-value
     1856       .
     1857       release buf_cash-pay-attr no-error .
     1858       if error-status:error then do:
     1859         undo, return error return-value .
     1860       end.
     1861     end.
     1862   end procedure.
