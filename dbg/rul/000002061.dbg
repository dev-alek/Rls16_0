     3469   if v-view-log
     3470   and not g#news
     3471   and not g#auto
     3472   then do:
     3473     message
     3474     '!!!При маршрутизации произошли ошибки!!!'  skip
     3475     "!!!Внимательно прочитайте Log-file!!"
     3476     view-as alert-box error .
     3477        define variable v-user-action29   as character no-undo .
     3478     define variable v-printed29       as logical   no-undo .
