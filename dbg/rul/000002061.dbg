     1498   procedure get-header-by-rec :
     1499   define input  parameter p-gate-rec as character no-undo .
     1500   define output parameter p-tth as handle no-undo .
     1501   define variable v-ii as integer   no-undo .
     1502   define variable glog as logical   no-undo .
     1503   define variable v-rowid as rowid no-undo .
     1504   define variable v-tbl-name as character no-undo .
     1505   define variable v-longchar as longchar no-undo .
     1506   define variable v-txmlh as handle no-undo .
     1507   define buffer buf_clob-data for ub.clob-data.
     1508   main-block:
     1509   do
     1510   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info10, return-value, chr(10), error-status :get-message (1))
     1511   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info10 )
     1512   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info10 )
     1513   :
     1514     run gen-row-keyr in  this-procedure  (
     1515                                           input  p-gate-rec
     1516                                           ,input  ?
     1517                                           ,input  "ub"
     1518                                           ,input  ?
     1519                                           ,input  NO-LOCK
     1520                                           ,output v-rowid
     1521                                           ,output v-tbl-name   ) no-error.
     1522       find first buf_clob-data no-lock where
     1523                 rowid(buf_clob-data) = v-rowid  no-error.
     1524       if not available buf_clob-data then do:
     1525         undo, return error substitute("Не найден CLOB  &1"
     1526                                         , p-gate-rec
     1527                                         ).
     1528       end.
     1529       assign
     1530       v-longchar = buf_clob-data.cdata
     1531       .
     1532       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1533       if error-status :error then do:
     1534         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1535       end.
     1536       create temp-table p-tth .
     1537       glog = p-tth:READ-XMLSCHEMA( "LONGCHAR"
     1538                                     , v-longchar
     1539                                     , ?
     1540                                     , ?
     1541                                     , ?
     1542                                     ) no-error.
     1543       v-longchar = '':U.
     1544       define variable v-esm as character no-undo .
     1545       v-esm = error-status:get-message(1).
     1546       if error-status :error
     1547       or not glog
     1548       then do:
     1549         delete object p-tth no-error.
     1550         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     1551                                    , p-gate-rec
     1552                                    , buf_clob-data.file-name_
     1553                                    , chr(10)
     1554                                    , v-esm
     1555                                     ).
     1556       end.
     1557   end.
     1558   end procedure.
