     2711                     ''            +  chr(3) +
     2712                     'новый':U    +  chr(3) +
     2713                     'отказ':U
     2714     v-stat-list[3] =
     2715                     ''            +  chr(3) +
     2716                     'новый':U    +  chr(3) +
     2717                     'поставка':U +  chr(3) +
     2718                     'отказ':U
     2719     .
     2720     assign
     2721     v-waiting-stfl = p-waiting-status
     2722     .
     2723     assign
     2724     v-old-stfl = p-oldbh::status_
     2725     .
     2726     assign
     2727     v-new-stfl = p-newbh::status_
     2728     .
     2729     _ii:
     2730     do v-ii = 1 to 5:
     2731       if v-stat-list[v-ii] = '' then next.
     2732       assign
     2733       v-waiting-stfl-i = lookup(v-waiting-stfl, v-stat-list[v-ii], chr(3))
     2734       v-old-stfl-i = lookup(v-old-stfl, v-stat-list[v-ii], chr(3))
     2735       v-new-stfl-i = lookup(v-new-stfl, v-stat-list[v-ii], chr(3))
     2736       .
     2737       if v-waiting-stfl-i = 0
     2738       or v-old-stfl-i = 0
     2739       or v-new-stfl-i = 0
     2740       then do:
     2741         next _ii.
     2742         end.
     2743       if v-old-stfl-i < v-waiting-stfl-i
