     1893         undo, return error return-value .
     1894       end.
     1895       find first buf_cash-pay-attr exclusive-lock
     1896         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
     1897           and buf_cash-pay-attr.curr-code  = p-curr-code
     1898           and buf_cash-pay-attr.host-code  = p-host-code
     1899           and buf_cash-pay-attr.obj-type   = p-obj-type
     1900           and buf_cash-pay-attr.obj-code   = p-obj-code
     1901           and buf_cash-pay-attr.attr-code = p-code
     1902         no-error .
