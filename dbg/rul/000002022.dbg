     1630   define variable v-current-obj-code as integer no-undo .
     1631   define variable v-current-doc-code as character no-undo .
     1632   define variable v-current-doc-date as date no-undo .
     1633   define variable v-current-doc-type as character no-undo .
     1634   define variable v-current-doc-time as integer no-undo .
     1635   define variable v-current-lock as integer no-undo .
     1636   define variable v-current-wait as integer no-undo .
     1637   define variable v-save as integer no-undo .
     1638   define variable v-current-db-num as integer no-undo .
     1639   define variable v-current-date as date no-undo .
     1640   define variable v-sign as integer no-undo .
     1641   define variable file-name as char.
     1642   define variable num-rec as integer no-undo .
     1643   define variable num-rec-ok as integer no-undo .
     1644   define variable num-rec-ok2 as integer no-undo .
     1645   define variable v-full-path        as character no-undo .
     1646   define variable v-path             as character no-undo .
     1647   define variable v-file-name        as character no-undo .
     1648   define variable v-file-name-no-ext as character no-undo .
     1649   define variable v-file-name-ext    as character no-undo .
     1650   define variable v-end-new-line     as logical no-undo .
     1651   define variable v-last-error-message as character no-undo .
     1652   define variable v-retry-action as integer no-undo .
     1653   define variable v_dataseth as handle no-undo .
     1654   define variable v-xmlh as handle no-undo .
     1655   define variable v_qh as handle no-undo .
     1656   define variable glog as logical no-undo .
     1657   define variable v-ds-read-order as character no-undo .
     1658   define variable v-esys-id as integer no-undo .
     1659   define variable v-err-type as character no-undo .
     1660   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1661   procedure set-error :
     1662   define input parameter p-mess as character no-undo .
     1663     do
     1664     on error undo, return error
     1665     :
     1666        assign
     1667        v-last-error-message = p-mess.
     1668     end.
     1669   end procedure.
     1670   define buffer buf_temp-cmd for temp-cmd.
     1671   define temp-table temp-rule-call-param no-undo like ub.rule-call-param.
     1672   define buffer buf_temp-rule-call-param for temp-rule-call-param.
     1673   define buffer buf_temp-xml-tables for temp-xml-tables.
     1674   define variable log-file-name                as character      no-undo init "process-edoc.txt".
     1675   define variable v-view-log                   as logical        no-undo .
     1676   define variable v-stop                       as logical        no-undo .
     1677   function 00180024_get-error-message returns character :
     1678   define variable v-ii as integer no-undo .
     1679   define variable v-mess as character no-undo .
     1680   DO v-ii = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1681       v-mess = substitute("&1&2ош &3"
     1682                           ,v-mess
     1683                           ,chr(10)
     1684                           ,ERROR-STATUS:GET-MESSAGE(v-ii)).
     1685   END.
     1686   end function.
     1687     define variable p-esys-id as integer no-undo .
     1688     define variable p-xsd-file as character no-undo.
     1689   on delete of this-procedure do:
     1690     run delete-procedure in this-procedure .
     1691   end.
     1692   run load-ruleset-context in this-procedure ( input p-ruleset-id) no-error .
     1693   if error-status:error then undo, return error ''.
     1694    define variable ImpData1 as class Route-data_ no-undo .
     1695   ImpData1 = new Route-data_( input parparentproc, input p-parent-handle, input p-log-handle, input this-procedure:handle, input v_dataseth, input v-xmlh) .
     1696   if not this-procedure:persistent then do:
     1697     run proc-main in this-procedure  no-error .
     1698     if error-status:error then do:
     1699         run delete-procedure in this-procedure .
     1700         undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     1701     end.
     1702     run delete-procedure in this-procedure .
     1703   end.
     1704   procedure proc-main :
     1705   define variable v-ii as integer   no-undo .
     1706   define variable v-current-b-code as integer no-undo .
     1707   define buffer buf_ext-system for ub.ext-system.
     1708   _main:
     1709   do
     1710   on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1711   on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
     1712   on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
     1713   :
     1714   run write-log  in p-log-handle (
     1715                                    input 0
     1716                                  , "&DLine").
     1717     run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute(".............Импорт данных по Спецификациям из ВС")).
     1718       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Импорт данных по Спецификациям из файла &1", file-name)).
     1719       find first buf_ext-system no-lock where
     1720                  buf_ext-system.esys-id = v-esys-id
     1721              and buf_ext-system.db-num = 0 no-error.
     1722       if not available buf_ext-system
     1723       or not (buf_ext-system.esys-type  = integer('3':U)) then do:
     1724              run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не найдена ВС &1 или она не имеет типа ORACLE RETAIL", v-esys-id)).
     1725          undo _main, return error ''.
     1726       end.
     1727     do v-ii = 1 to num-entries(v-ds-read-order):
     1728     find first buf_temp-xml-tables where
     1729               buf_temp-xml-tables.tbl-name = entry(v-ii, v-ds-read-order)
     1730          and  buf_temp-xml-tables.gate-handle_ = v_dataseth.
     1731     create query v_qh.
     1732     glog = v_qh:set-buffers( buf_temp-xml-tables.tbl-handle_) no-error.
     1733     if error-status:error
     1734     or
     1735     not glog then do:
     1736                   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при попытке получить записи &1&2&3&2&4"                                                                 , buf_temp-xml-tables.tbl-name                                                                 , chr(10)                                                                 , error-status:get-message(1)                                                                 , return-value)).
     1737      undo _main, return error ''.
     1738     end.
     1739     glog = v_qh:query-prepare( substitute( "for each &1 ", buf_temp-xml-tables.tbl-name)) no-error .
     1740     if error-status:error
     1741     or
     1742     not glog then do:
     1743                   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при попытке получить записи &1&2&3&2&4"                                                                 , buf_temp-xml-tables.tbl-name                                                                 , chr(10)                                                                 , error-status:get-message(1)                                                                 , return-value)).
     1744           if valid-handle(v_qh) then do:
     1745             delete object v_qh no-error.
     1746           end.
     1747      undo _main, return error ''.
     1748     end.
     1749     glog = v_qh:query-open no-error .
     1750     if error-status:error
     1751     or
     1752     not glog then do:
     1753                   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при попытке получить записи &1&2&3&2&4"                                                                 , buf_temp-xml-tables.tbl-name                                                                 , chr(10)                                                                 , error-status:get-message(1)                                                                 , return-value)).
     1754           if valid-handle(v_qh) then do:
     1755             delete object v_qh no-error.
     1756           end.
     1757       undo _main, return error ''.
     1758     end.
     1759     _stroka:
     1760     REPEAT:
     1761           if buf_temp-xml-tables.is-parent then do:
     1762       num-rec = num-rec + 1.
     1763           end.
     1764       v-retry-action = 0 .
     1765       _release:
     1766       do on error undo, retry:
     1767         if  retry then do:
     1768           v-retry-action = v-retry-action + 1.
     1769                           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при импорте записи &5 &1&2&3&2&4"                                                                     , buf_temp-xml-tables.tbl-name                                                                     , num-rec                                                                     , chr(10)                                                                     , error-status:get-message(1)                                                                     , return-value)).
     1770               if valid-handle(v_qh) then do:
     1771                 delete object v_qh no-error.
     1772               end.
     1773           undo _main, return error ''.
     1774         end.
     1775   if v-retry-action < 1 then do:
     1776   ImpData1:Route-data_dump ( ) .
     1777   end.
     1778         end.
     1779       _rule:
     1780         do on error undo _rule, retry _rule:
     1781           if retry then do:
     1782                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("&1&2&3"                                       , error-status:get-message(1)                                       , chr(10)                                       , return-value)).
     1783             if valid-handle(v_qh) then do:
     1784               delete object v_qh no-error.
     1785             end.
     1786             undo _main, return error ''.
     1787           end.
     1788           else do:
     1789           v_qh:get-next().
     1790           IF v_qh:query-off-end then leave _stroka.
     1791             IF  ImpData1:current-tbl-name( ) = "contract-specif"  THEN do:
     1792               create temp_contract-specif.
     1793                 temp_contract-specif.line-num       = ImpData1:route-data_get-field-integer ( input "contract-specif", input "line-num")      .
     1794                 temp_contract-specif.gds-code       = ImpData1:route-data_get-field-integer ( input "contract-specif", input "gds-code")      .
     1795                 temp_contract-specif.contract-code  = ImpData1:route-data_get-field-integer ( input "contract-specif", input "contract-code") .
     1796                 temp_contract-specif.price-cli      = ImpData1:route-data_get-field-decimal ( input "contract-specif", input "price-cli")     .
     1797                 temp_contract-specif.prc            = ImpData1:route-data_get-field-decimal ( input "contract-specif", input "prc")           .
     1798                 temp_contract-specif.vat-pc         = ImpData1:route-data_get-field-decimal ( input "contract-specif", input "vat-pc")        .
     1799                 temp_contract-specif.vat-type       = ImpData1:route-data_get-field-character ( input "contract-specif", input "payer-vat")        .
     1800                 temp_contract-specif.status_        = ImpData1:route-data_get-field-character ( input "contract-specif", input "status_")       .
     1801                 temp_contract-specif.exch-code      = ImpData1:route-data_get-field-integer ( input "contract-specif", input "exch-code")       .
     1802                release temp_contract-specif.
     1803             end.
     1804         end.
     1805       end.
     1806       v-retry-action = 0 .
     1807       _release:
     1808       do on error undo, retry:
     1809         if  retry then do:
     1810           v-retry-action = v-retry-action + 1.
     1811                   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("&1&2&3"                                     , error-status:get-message(1)                                     , chr(10)                                     , v-last-error-message )).
     1812           undo _main, return error ''.
     1813         end.
     1814         if v-retry-action < 1 then do:
     1815                   ImpData1:Route-data_dump ( ) .
     1816         end.
     1817         end.
     1818         if v-retry-action = 0
     1819         and buf_temp-xml-tables.is-parent
     1820         then do:
     1821           num-rec-ok = num-rec-ok + 1.
     1822         end.
     1823         run write-counter in p-log-handle ( input substitute("Прочитано записей: &1, из них удачно: &2", num-rec, num-rec-ok)).
     1824       end.
     1825       if not v-stop
     1826       and buf_temp-xml-tables.is-parent
     1827       then do:
     1828         num-rec = num-rec - 1.
     1829       end.
     1830       v_qh:query-close().
     1831       if valid-handle(v_qh) then do:
     1832         delete object v_qh.
     1833       end.
     1834     end.
     1835      run utl/ora-i405.p (
     1836         input parparentproc ,
     1837         input this-procedure ,
     1838         input table temp_contract ,
     1839         input table temp_contract-specif ,
     1840         output num-rec-ok2
     1841         ) no-error .
     1842     if error-status:error then do:
     1843       if return-value <> '' then do:
     1844               run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при сохранении данных по спецификации из ВС:&1&2&1&3", chr(10), return-value , error-status :get-message(1)  )).
     1845       end.
     1846       run set-err-type in p-cont-handle
     1847         ( input v-err-type
     1848         ) no-error.
     1849       run delete-procedure in this-procedure .
     1850       undo _main, return error ''.
     1851     end.
     1852       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Прочитано записей: &1, обработано: &2", num-rec, num-rec-ok2)).
     1853   end.
     1854   end procedure.
     1855   procedure load-ruleset-context :
     1856   define input parameter p-ruleset-id as integer no-undo .
     1857   define buffer buf_rule-call-param for ub.rule-call-param.
     1858   define variable v-itop as integer   no-undo .
     1859   define variable v-ichild as integer   no-undo .
     1860   define variable v-pck-num as integer no-undo .
     1861   define buffer buf_esys-pck-keys for ub.esys-pck-keys.
     1862   define buffer buf_ext-system for ub.ext-system.
     1863     do
     1864     on error undo, return error
     1865     :
     1866   find first buf_rule-call-param no-lock where
     1867   buf_rule-call-param.codex_id = p-codex-id
     1868   and buf_rule-call-param.ruleset_id = p-ruleset-id
     1869   and buf_rule-call-param.call_id = p-call-id
     1870   and buf_rule-call-param.order_id = p-order-id
     1871   and buf_rule-call-param.rule_id = p-rule-id
     1872   and buf_rule-call-param.param-name = "p-esys-id"
     1873    no-error.
     1874   if available buf_rule-call-param then do:
     1875   assign p-esys-id = buf_rule-call-param.param-value-integer.
     1876   end.
     1877   find first buf_rule-call-param no-lock where
     1878   buf_rule-call-param.codex_id = p-codex-id
     1879   and buf_rule-call-param.ruleset_id = p-ruleset-id
     1880   and buf_rule-call-param.call_id = p-call-id
     1881   and buf_rule-call-param.order_id = p-order-id
     1882   and buf_rule-call-param.rule_id = p-rule-id
     1883   and buf_rule-call-param.param-name = "p-xsd-file"
     1884    no-error.
     1885   if available buf_rule-call-param then do:
     1886   assign p-xsd-file = buf_rule-call-param.param-value-character.
     1887   end.
     1888       case p-ruleset-id:
     1889         when 24 then do:
     1890           assign
     1891           v-sign = 1
     1892           v-current-host-code = p-host-code
     1893           v-current-obj-type = p-obj-type
     1894           v-current-obj-code = p-obj-code
     1895           v-current-doc-code = p-doc-code
     1896           v-current-db-num = g#db-num
     1897           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     1898           file-name  = entry(1, p-process-file-name, chr(4))
     1899           v_dataseth = handle(entry(2, p-process-file-name, chr(4)))
     1900           v-xmlh = buffer buf_temp-xml-tables:handle
     1901           v-esys-id = integer(p-doc-code)
     1902           v-pck-num = integer(entry(3, p-process-file-name, chr(4)))
     1903           log-file-name = entry(4, p-process-file-name, chr(4))
     1904           no-error
     1905          .
     1906         find first buf_ext-system no-lock where
     1907                   buf_ext-system.esys-id = v-esys-id
     1908               and buf_ext-system.db-num = 0 no-error .
     1909         if not available buf_ext-system then do:
     1910                   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не найдена ВС &1&2 ..."                                       , v-esys-id                                       , chr(10)                                       )).
     1911           undo, return error substitute("Не найдена ВС &1&2 ..."                                       , v-esys-id                                       , chr(10)                                       ).
     1912         end.
     1913           _top-buffers:
     1914           do v-itop = 1 to v_dataseth:num-top-buffers:
     1915             if v_dataseth:get-top-buffer(v-itop):table = "header_" then do:
     1916               next _top-buffers.
     1917             end.
     1918             assign
     1919             v-ds-read-order = v-ds-read-order +
     1920                               (if v-ds-read-order = '':U then '':U else chr(44)) +
     1921                               v_dataseth:get-top-buffer(v-itop):table
     1922                               .
     1923             do v-ichild = 1 to v_dataseth:get-top-buffer(v-itop):num-child-relations:
     1924               assign
     1925               v-ds-read-order = v-ds-read-order + chr(44) + v_dataseth:get-top-buffer(v-itop):get-child-relation(v-ichild):child-buffer:name.
     1926             end.
     1927           end.
     1928         end.
     1929         otherwise do:
     1930           undo, return error "Неправильный вызов".
     1931         end.
     1932       end case.
     1933     end.
     1934   end procedure.
     1935   procedure delete-procedure :
     1936     do
     1937     on error undo, return error
     1938     :
     1939       empty temp-table temp_contract.
     1940       empty temp-table temp_contract-specif.
     1941       run garbcoll_clear in this-procedure .
     1942     end.
     1943   end procedure.
     1944   procedure pcall-log-file :
     1945   define input  parameter p-message as character no-undo .
     1946     do
     1947     on error undo, return error return-value
     1948     :
     1949       run write-log-and-file in p-log-handle (
     1950             input 1
     1951           , input log-file-name
     1952           , input 1
     1953           , input p-message ) .
     1954     end.
     1955   end procedure.
