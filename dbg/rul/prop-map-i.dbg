      518   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
      519   DEFINE BUFFER buf_prop-map FOR ub.prop-map.
      520       run rul/prop-map-s.w (
      521                              input parparentproc
      522                             ,INPUT 'b-sel':U
      523                             ,INPUT "dtm-code"
      524                             ,INPUT tt-prop-map.dtm-code
      525                             ,INPUT-OUTPUT v-rid-list) NO-ERROR.
      526   IF ERROR-STATUS:ERROR
      527   OR v-rid-list = '':U THEN RETURN NO-APPLY.
      528   FIND FIRST buf_prop-map NO-LOCK WHERE
      529             recid(buf_prop-map) = INTEGER(v-rid-list).
      530   ASSIGN
      531   tt-prop-map.upper-node-code = buf_prop-map.node-code
      532   tt-prop-map.upper-node-name = buf_prop-map.node-name
      533   .
      534   DISPLAY
      535   tt-prop-map.upper-node-code
      536   tt-prop-map.upper-node-name
      537   WITH FRAME Dialog-Frame.
      538   END.
      539   ON LEAVE OF tt-prop-map.dtm-code IN FRAME Dialog-Frame
      540   DO:
      541     ASSIGN
      542     tt-prop-map.dtm-code.
      543   END.
      544   ON VALUE-CHANGED OF tt-prop-map.node-value-type IN FRAME Dialog-Frame
      545   DO:
      546     ASSIGN
      547     tt-prop-map.node-value-type.
      548     RUN switch-data-type IN THIS-PROCEDURE .
      549   END.
      550   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      551   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      552   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      553   on help of frame Dialog-Frame
      554   do:
      555     run gbl/app_help.p
      556       (input this-procedure :file-name
      557       ,input ''
      558       ,input ?
      559       ) no-error.
      560     if error-status :error then do:
      561       message
      562         "Œ¯Ë·Í‡ ÔË ‚˚ÁÓ‚Â ÔÓÏÓ˘Ë"
      563         error-status :get-message(1)
      564         view-as alert-box .
      565     end.
      566   end.
      567   run minbtn-set in this-procedure .
      568   on choose of b-help in frame Dialog-Frame
      569   do:
      570     apply "help":u to frame Dialog-Frame .
      571   end.
      572   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      573   procedure minbtn-set :
      574       do
      575           on error undo, return error return-value
      576           :
      577           define variable ii              as integer       no-undo .
      578           define variable fh              as widget-handle no-undo .
      579           define variable hh              as widget-handle no-undo .
      580           define variable v-h             as handle        extent 4 no-undo .
      581           define variable v-name-button   as character     no-undo .
      582           define variable v-help-old-x    as decimal       no-undo .
      583           define variable v-help-old-y    as decimal       no-undo .
      584           define variable v-help-old-size as decimal       no-undo .
      585           define variable v-frame-width   as decimal       no-undo .
      586           define variable jj              as integer       no-undo .
      587           do
      588               on error undo, return error
      589               :
      590               assign
      591                   v-frame-width = frame Dialog-Frame:width - 0.3
      592                   fh            = frame Dialog-Frame:first-child
      593                   hh            = fh:first-child
      594                   ii            = 1
      595                   .
      596               do while valid-handle(hh):
      597                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      598                   do:
      599                       case lc(hh:name) :
      600                           when "b-help" then
      601                               do:
      602                                   hh:load-image-up("cmp/b-help.bmp":u) .
      603                                   hh:load-image-down("cmp/b-help.bmp":u) .
      604                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      605                                   hh:TOOLTIP = "œÓÏÓ˘¸" .
      606                                   v-help-old-x = hh:column .
      607                                   v-help-old-y = hh:row    .
      608                                   v-help-old-size = hh:width .
      609                                   hh:width-chars = 2.5 .
      610                               end.
      611                           when "b-print" then
      612                               do:
      613                                   hh:load-image("cmp/b-print.bmp":u) .
      614                                   hh:TOOLTIP = "œÂ˜‡Ú¸" .
      615                                   v-h[ii] = hh:handle .
      616                                   ii = ii + 1 .
      617                                   hh:width-chars = 3 .
      618                               end.
      619                           when "b-history" or
      620                           when "b-hist" then
      621                               do:
      622                                   hh:load-image("cmp/b-hist.bmp":u) .
      623                                   hh:TOOLTIP = "»ÒÚÓËˇ" .
      624                                   v-h[ii] = hh:handle .
      625                                   ii = ii + 1 .
      626                                   hh:width-chars = 3 .
      627                               end.
      628                           when "b-sch" then
      629                               do:
      630                                   hh:load-image("cmp/b-sch.bmp":u) .
      631                                   hh:TOOLTIP = "”ÒÚ‡ÌÓ‚Í‡ ‘ËÎ¸Ú‡" .
      632                                   v-h[ii] = hh:handle .
      633                                   ii = ii + 1 .
      634                                   hh:width-chars = 3 .
      635                               end.
      636                           when "b-hist-user" then
      637                               do:
      638                                   hh:load-image("cmp/b-hist.bmp":u) .
      639                                   hh:TOOLTIP = "»ÒÚÓËˇ ÔÓÎ¸ÁÓ‚‡ÚÂÎˇ" .
      640                                   ii = ii + 1 .
      641                               end.
      642                       end case.
      643                   end.
      644                   hh = hh:next-sibling.
      645               end.
      646               b-help:column = v-frame-width - b-help:width-chars.
      647               jj = 0.
      648               repeat ii = 4 to 1 by -1 :
      649                   if valid-handle (v-h[ii] ) then
      650                   do:
      651                       jj  = jj + 1 .
      652                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      653                       v-h[ii]:row    = v-help-old-y .
      654                   end.
      655               end.
      656           end.
      657       end.
      658   end procedure.
      659   MAIN-BLOCK:
      660   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      661      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      662      ON stop UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      663     IF p-dtm-code = 0 THEN DO:
      664       MESSAGE "ÕÂ Á‡‰‡Ì ID ÚÂÏËÌ‡ ‚ ÒÎÓ‚‡Â"
      665       VIEW-AS ALERT-BOX ERROR.
      666       UNDO, RETURN ERROR.
      667     END.
      668     IF p-mode = 'ƒŒ¡¿¬À≈Õ»≈':U THEN DO:
      669       FIND FIRST locked_prop-head EXCLUSIVE-LOCK WHERE
      670               LOCKED_prop-head.dtm-code = p-dtm-code .
      671       CREATE tt-prop-map.
      672       FIND LAST LAST_prop-map NO-LOCK WHERE
      673               last_prop-map.dtm-code = p-dtm-code  NO-ERROR.
      674       ASSIGN
      675       tt-prop-map.node-code = (IF AVAILABLE LAST_prop-map
      676                                     THEN LAST_prop-map.node-code + 1
      677                                     ELSE 1)
      678       tt-prop-map.dtm-code = (if p-dtm-code > 0 then p-dtm-code else 0)
      679       .
      680     END.
      681     else do:
      682       IF p-mode = '»«Ã≈Õ≈Õ»≈':U THEN DO:
      683           FIND FIRST locked_prop-head EXCLUSIVE-LOCK WHERE
      684                   LOCKED_prop-head.dtm-code = p-dtm-code .
      685           FIND FIRST locked_prop-map EXCLUSIVE-LOCK WHERE
      686                   LOCKED_prop-map.dtm-code = p-dtm-code
      687               AND LOCKED_prop-map.node-code = p-node-code.
      688       END.
      689       IF p-mode = 'œ–Œ—ÃŒ“–':U THEN DO:
      690           FIND FIRST locked_prop-head no-lock WHERE
      691                   LOCKED_prop-head.dtm-code = p-dtm-code
      692               .
      693           FIND FIRST locked_prop-map no-LOCK WHERE
      694                   LOCKED_prop-map.dtm-code = p-dtm-code
      695               AND LOCKED_prop-map.node-code = p-node-code.
      696       END.
      697       create tt-prop-map.
      698       buffer-copy locked_prop-map to tt-prop-map.
      699     end.
      700     RUN Myenable.
      701     WAIT-FOR GO OF FRAME Dialog-Frame.
      702   END.
      703   RUN disable_UI.
      704   PROCEDURE disable_UI :
      705     HIDE FRAME Dialog-Frame.
      706   END PROCEDURE.
      707   PROCEDURE enable_UI :
      708     OPEN QUERY Dialog-Frame FOR EACH tt-prop-map SHARE-LOCK.
      709     GET FIRST Dialog-Frame.
      710     DISPLAY T-R T-W T-C T-O cb-object-type
      711         WITH FRAME Dialog-Frame.
      712     IF AVAILABLE tt-prop-map THEN
      713       DISPLAY tt-prop-map.dtm-code tt-prop-map.node-code tt-prop-map.upper-node-code
      714             tt-prop-map.upper-node-name tt-prop-map.node-type
      715             tt-prop-map.node-value-type tt-prop-map.is-collection
      716             tt-prop-map.is-term tt-prop-map.node-name tt-prop-map.node-label
      717             tt-prop-map.init-value-character tt-prop-map.init-value-date
      718             tt-prop-map.node-format tt-prop-map.init-value-decimal
      719             tt-prop-map.init-value-integer tt-prop-map.init-value-logical
      720             tt-prop-map.node-description
      721         WITH FRAME Dialog-Frame.
      722     ENABLE B-exit b-quit tt-prop-map.dtm-code tt-prop-map.node-code B-Help
      723            tt-prop-map.upper-node-code b-upper-code T-R T-W T-C T-O
      724            tt-prop-map.node-type tt-prop-map.node-value-type
      725            tt-prop-map.is-collection cb-object-type tt-prop-map.is-term
      726            tt-prop-map.node-name tt-prop-map.node-label
      727            tt-prop-map.init-value-character tt-prop-map.init-value-date
      728            tt-prop-map.node-format tt-prop-map.init-value-decimal
      729            tt-prop-map.init-value-integer tt-prop-map.init-value-logical
      730            tt-prop-map.node-description
      731         WITH FRAME Dialog-Frame.
      732     VIEW FRAME Dialog-Frame.
      733   END PROCEDURE.
      734   PROCEDURE MyEnable :
      735   DEFINE VARIABLE v-ii AS INTEGER NO-UNDO.
      736   DEFINE VARIABLE v-item-pairs AS CHARACTER NO-UNDO.
      737   DO v-ii = 1 TO NUM-ENTRIES('1,3,2,4,5,6,7,8,9':U):
      738     ASSIGN
      739     v-item-pairs = v-item-pairs + chr(44) +
      740                    ENTRY(v-ii,'›ÎÂÏÂÌÚ,“ÂÍÒÚ,“ËÔƒÓÍÛÏÂÌÚ‡,◊‡ÒÚ¸ƒÓÍÛÏÂÌÚ‡,—Ò˚ÎÍ‡,¿ÚË·ÛÚ,CDATA, ÓÏÏÂÌÚ‡ËÈ,»ÌÒÚÛÍˆËˇ':U) + chr(44) + ENTRY(v-ii,'1,3,2,4,5,6,7,8,9':U).
      741   END.
      742   v-item-pairs = TRIM(v-item-pairs, chr(44)).
      743   ASSIGN
      744   tt-prop-map.node-value-type:LIST-ITEMS IN FRAME Dialog-Frame = 'character,date,decimal,integer,logical':U
      745   tt-prop-map.node-type:LIST-ITEM-PAIRS IN FRAME Dialog-Frame = v-item-pairs
      746   cb-object-type:LIST-ITEMS IN FRAME Dialog-Frame = ",r-b,dis-card"
      747   .
      748   assign
      749   cb-object-type = (if num-entries(tt-prop-map.node-value-type) > 1
      750                     then entry(2, tt-prop-map.node-value-type)
      751                     else '':U)
      752   tt-prop-map.node-value-type = entry(1, tt-prop-map.node-value-type)
      753   t-r = (index(tt-prop-map.rw-option, "R") > 0)
      754   t-W = (index(tt-prop-map.rw-option, "W") > 0)
      755   t-C = (index(tt-prop-map.rw-option, "C") > 0)
      756   t-O = (index(tt-prop-map.rw-option, "O") > 0)
      757   .
      758   IF AVAILABLE tt-prop-map THEN
      759   DISPLAY
      760   t-r
      761   t-w
      762   t-c
      763   t-o
      764   tt-prop-map.dtm-code
      765   tt-prop-map.node-code
      766   tt-prop-map.upper-node-code
      767   tt-prop-map.upper-node-name
      768   tt-prop-map.node-type
      769   tt-prop-map.node-value-type
      770   tt-prop-map.node-name
      771   tt-prop-map.node-format
      772   tt-prop-map.is-collection
      773   tt-prop-map.node-label
      774   tt-prop-map.is-term
      775   tt-prop-map.init-value-character WHEN tt-prop-map.node-value-type = 'character':U
      776   tt-prop-map.init-value-date WHEN tt-prop-map.node-value-type = 'date':U
      777   tt-prop-map.init-value-decimal WHEN tt-prop-map.node-value-type = 'decimal':U
      778   tt-prop-map.init-value-integer WHEN tt-prop-map.node-value-type = 'integer':U
      779   tt-prop-map.init-value-logical WHEN tt-prop-map.node-value-type = 'logical':U
      780   tt-prop-map.node-description
      781   WITH FRAME Dialog-Frame .
      782   ENABLE
      783   B-exit  when p-mode <> 'œ–Œ—ÃŒ“–':U
      784   b-quit
      785   B-Help
      786   tt-prop-map.dtm-code when (p-mode = 'ƒŒ¡¿¬À≈Õ»≈':U and p-dtm-code = 0)
      787   tt-prop-map.node-type when p-mode <> 'œ–Œ—ÃŒ“–':U
      788   tt-prop-map.node-value-type when p-mode <> 'œ–Œ—ÃŒ“–':U
      789   tt-prop-map.node-name       when p-mode <> 'œ–Œ—ÃŒ“–':U
      790   tt-prop-map.node-label when p-mode <> 'œ–Œ—ÃŒ“–':U
      791   tt-prop-map.node-format when p-mode <> 'œ–Œ—ÃŒ“–':U
      792   tt-prop-map.node-description when p-mode <> 'œ–Œ—ÃŒ“–':U
      793   tt-prop-map.is-term when p-mode <> 'œ–Œ—ÃŒ“–':U
      794   b-upper-code WHEN p-mode <> 'œ–Œ—ÃŒ“–':U
      795   t-r WHEN p-mode <> 'œ–Œ—ÃŒ“–':U
      796   t-w WHEN p-mode <> 'œ–Œ—ÃŒ“–':U
      797   t-c WHEN p-mode <> 'œ–Œ—ÃŒ“–':U
      798   t-o WHEN p-mode <> 'œ–Œ—ÃŒ“–':U
      799   WITH FRAME Dialog-Frame .
      800   if p-mode = 'œ–Œ—ÃŒ“–':U then do:
      801     assign
      802     b-quit:label = "&¬˚ıÓ‰"
      803     b-quit:column = 1.
      804     hide b-exit in frame Dialog-Frame .
      805   end.
      806   VIEW FRAME Dialog-Frame .
      807   RUN switch-data-type IN THIS-PROCEDURE .
      808   END PROCEDURE.
      809   PROCEDURE proc-save :
      810   DEFINE VARIABLE v-rec AS recID  NO-UNDO.
      811   IF p-mode = 'œ–Œ—ÃŒ“–':U THEN DO:
      812       RETURN.
      813   END.
      814   IF p-mode = '»«Ã≈Õ≈Õ»≈':U THEN DO:
      815     v-rec = p-rec .
      816   END.
      817   ASSIGN
      818   FRAME Dialog-Frame
      819   t-r
      820   t-w
      821   t-c
      822   t-o
      823   tt-prop-map.dtm-code
      824   tt-prop-map.node-code
      825   tt-prop-map.upper-node-code
      826   tt-prop-map.upper-node-name
      827   tt-prop-map.rw-option = (IF t-r THEN "R" ELSE "":U) +
      828                           (IF t-W THEN "W" ELSE "":U) +
      829                           (IF t-c THEN "C" ELSE "":U) +
      830                           (IF t-o THEN "O" ELSE "":U)
      831   tt-prop-map.node-type
      832   tt-prop-map.node-name
      833   tt-prop-map.node-label
      834   tt-prop-map.is-term
      835   cb-object-type
      836   tt-prop-map.node-value-type
      837   tt-prop-map.node-value-type = tt-prop-map.node-value-type + chr(44) + cb-object-type
      838   tt-prop-map.node-description
      839   tt-prop-map.is-collection
      840   tt-prop-map.node-format
      841   tt-prop-map.init-value-character WHEN tt-prop-map.node-value-type = 'character':U
      842   tt-prop-map.init-value-date WHEN tt-prop-map.node-value-type = 'date':U
      843   tt-prop-map.init-value-decimal WHEN tt-prop-map.node-value-type = 'decimal':U
      844   tt-prop-map.init-value-integer WHEN tt-prop-map.node-value-type = 'integer':U
      845   tt-prop-map.init-value-logical WHEN tt-prop-map.node-value-type = 'logical':U
      846   .
      847   run rul/prop-map1.p ( INPUT p-mode
      848                   ,INPUT NO
      849                   ,INPUT-OUTPUT v-rec
      850                   ,INPUT tt-prop-map.dtm-code
      851                   ,INPUT tt-prop-map.node-code
      852                   ,INPUT tt-prop-map.upper-node-code
      853                   ,INPUT tt-prop-map.upper-node-name
      854                   ,INPUT tt-prop-map.node-type
      855                   ,INPUT tt-prop-map.is-collection
      856                   ,INPUT tt-prop-map.rw-option
      857                   ,INPUT tt-prop-map.node-name
      858                   ,INPUT tt-prop-map.node-label
      859                   ,INPUT tt-prop-map.node-value-type
      860                   ,INPUT tt-prop-map.node-format
      861                   ,INPUT tt-prop-map.node-description
      862                   ,INPUT tt-prop-map.is-term
      863                   ,INPUT tt-prop-map.init-value-character
      864                   ,INPUT tt-prop-map.init-value-date
      865                   ,INPUT tt-prop-map.init-value-decimal
      866                   ,INPUT tt-prop-map.init-value-integer
      867                   ,INPUT tt-prop-map.init-value-logical
      868                  ) no-error.
      869   if error-status:error then do:
      870   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      871   define variable fh as widget-handle no-undo .
      872   define variable hh as widget-handle no-undo .
      873   define variable rv as character no-undo .
      874   assign
      875   rv = entry(1, return-value , chr(4)).
      876   if rv <> "":U then do:
      877     assign
      878     fh = frame Dialog-Frame:first-child
      879     hh = fh:first-child
      880     .
      881     do while valid-handle(hh):
      882       if hh:name = rv then do:
      883         APPLY "ENTRY" to hh.
      884         undo ,
      885         return error.
      886       end.
      887       hh = hh:next-sibling.
      888     end.
      889   end.
      890     undo, return error.
      891   end.
      892   p-rec = v-rec.
      893   END PROCEDURE.
      894   PROCEDURE switch-data-type :
      895   HIDE
      896   tt-prop-map.init-value-character  IN FRAME Dialog-Frame
      897   tt-prop-map.init-value-date
      898   tt-prop-map.init-value-decimal
      899   tt-prop-map.init-value-integer
      900   tt-prop-map.init-value-logical
      901   .
      902   DISABLE
      903   tt-prop-map.init-value-character
      904   tt-prop-map.init-value-date
      905   tt-prop-map.init-value-decimal
      906   tt-prop-map.init-value-integer
      907   tt-prop-map.init-value-logical
      908   with FRAME Dialog-Frame.
      909   CASE tt-prop-map.node-value-type:
      910     WHEN 'character':U THEN DO:
      911        DISPLAY
      912        tt-prop-map.init-value-character
      913        WITH FRAME Dialog-Frame.
      914        ENABLE
      915        tt-prop-map.init-value-character WHEN p-mode <> 'œ–Œ—ÃŒ“–':U
      916        WITH FRAME Dialog-Frame.
      917     END.
      918     WHEN 'date':U THEN DO:
      919        DISPLAY
      920        tt-prop-map.init-value-date
      921        WITH FRAME Dialog-Frame.
      922        ENABLE
      923        tt-prop-map.init-value-date WHEN p-mode <> 'œ–Œ—ÃŒ“–':U
      924        WITH FRAME Dialog-Frame.
      925     END.
      926     WHEN 'decimal':U THEN DO:
      927        DISPLAY
      928        tt-prop-map.init-value-decimal
      929        WITH FRAME Dialog-Frame.
      930        ENABLE
      931        tt-prop-map.init-value-decimal WHEN p-mode <> 'œ–Œ—ÃŒ“–':U
      932        WITH FRAME Dialog-Frame.
      933     END.
      934     WHEN 'integer':U THEN DO:
      935        DISPLAY
      936        tt-prop-map.init-value-integer
      937        WITH FRAME Dialog-Frame.
      938        ENABLE
      939        tt-prop-map.init-value-integer WHEN p-mode <> 'œ–Œ—ÃŒ“–':U
      940        WITH FRAME Dialog-Frame.
      941     END.
      942     WHEN 'logical':U THEN DO:
      943        DISPLAY
      944        tt-prop-map.init-value-logical
      945        WITH FRAME Dialog-Frame.
      946        ENABLE
      947        tt-prop-map.init-value-logical WHEN p-mode <> 'œ–Œ—ÃŒ“–':U
      948        WITH FRAME Dialog-Frame.
      949     END.
      950   END CASE.
      951   END PROCEDURE.
      952   PROCEDURE switch-main-widgets :
      953   DEFINE INPUT parameter p-mode AS CHARACTER NO-UNDO.
      954   define buffer buf_prop-script for ub.prop-script.
      955   find first buf_prop-script NO-LOCK WHERE
      956               buf_prop-script.dtm-code = tt-prop-map.dtm-code  no-error.
      957   IF AVAILABLE buf_prop-script THEN DO:
      958   END.
      959   IF (LOCKED_prop-head.storage-place = '':U
      960      OR LOCKED_prop-head.storage-place = chr(63)
      961       )
      962       AND
      963       (LOCKED_prop-head.storage-place-host = '':U
      964        OR
      965        LOCKED_prop-head.storage-place-host = chr(63))
      966   AND
      967       (LOCKED_prop-head.storage-place-obj = '':U
      968        OR
      969        LOCKED_prop-head.storage-place-obj = chr(63))
      970       THEN DO:
      971   END.
      972   END PROCEDURE.
