     1579     field to-sel as logical
     1580     field full-name as character
     1581     index pi  is primary unique node-code
     1582     index ifn full-name
     1583     index is-term
     1584     is-term
     1585     node-name
     1586     index level
     1587     upper-code
     1588     node-name
     1589     index level-num
     1590     lvl-num
     1591     upper-code
     1592     node-name
     1593     index oi order-num
     1594     index isel to-sel
     1595     .
     1596   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1597   define  SHARED  temp-table cgrp-list-hist no-undo
     1598   field list-table as character
     1599   field id as integer
     1600   field line as integer
     1601   field hist-mode as character
     1602   field des as character
     1603   field num-recs as integer
     1604   field option_ as character
     1605   field item_ as character
     1606   field status_ as character
     1607   field num-add as integer
     1608   field num-ignored as integer
     1609   field done as logical
     1610   field err_ as logical
     1611   field err-mes as character
     1612   index pi is primary
     1613   id
     1614   line
     1615   index isdone
     1616   done
     1617   .
     1618   define variable v-current-node-code as integer no-undo .
     1619   define variable v-current-host-code as integer no-undo .
     1620   define variable v-current-obj-type as character no-undo .
     1621   define variable v-current-obj-code as integer no-undo .
     1622   define variable v-current-lock as integer no-undo .
     1623   define variable v-current-wait as integer no-undo .
     1624   define variable v-save as integer no-undo .
     1625   define variable v-esys-cmd-proc-handle as handle no-undo .
     1626   define variable v-esys-cmd-code as integer no-undo .
     1627   define variable log-file-name                as character      no-undo init "process-cli-grp-list.txt".
     1628   define variable v-view-log                   as logical        no-undo .
     1629   define variable v-stop                       as logical        no-undo .
     1630   define variable v-current-db-num as integer no-undo .
     1631   define variable v-last-error-message as character no-undo .
     1632   define variable file-name as char.
     1633   define variable v-sign as integer no-undo .
     1634   define variable v-gate-rec as character no-undo .
     1635   define variable num-rec as integer no-undo .
     1636   define variable num-rec-ok as integer no-undo .
     1637   define variable v-esys-id-list-start as character no-undo .
     1638   define variable v-pck-num-rec as integer no-undo init 1000.
     1639   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1640   procedure set-error :
     1641   define input parameter p-mess as character no-undo .
     1642     do
     1643     on error undo, return error
     1644     :
     1645        assign
     1646        v-last-error-message = p-mess.
     1647     end.
     1648   end procedure.
     1649   define buffer buf_temp-cmd for temp-cmd.
     1650   define shared temp-table tt0-rule-call-param no-undo like ub.rule-call-param.
     1651    define variable p-esys-id-list as integer no-undo.
     1652    define variable p-xsd-file as character no-undo.
     1653   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1654   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
     1655   run gbl/getobjsrvhndl.p (input-output ObjSrv).
     1656   function context_begin-esys-command return logical
     1657   (
     1658       input p-esys-id-list as character
     1659      ,input-output p-esys-cmd-proc-handle as handle
     1660      ,output p-esys-cmd-code as integer
     1661   ):
     1662      if not valid-handle(p-esys-cmd-proc-handle )
     1663      then do:
     1664        run nws/cmd-bush.p persistent set p-esys-cmd-proc-handle no-error .
     1665        if error-status :error
     1666        then do:
     1667           delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( substitute("&1 &2 &3&4Ошибка при запуске процедуры cmd-bush.p&4" +
     1668                                              "&5&4&6"
     1669                                              ,vss-workfile
     1670                                              ,vss-revision
     1671                                              ,vss-description
     1672                                              ,chr(10)
     1673                                              ,error-status:get-message(1)
     1674                                              ,return-value )).
     1675        end.
     1676        run begin-create-command in p-esys-cmd-proc-handle
     1677          (input 'cmd-esys-general':U
     1678          ,input p-esys-id-list
     1679          ,output p-esys-cmd-code
     1680          ) no-error.
     1681        if error-status :error
     1682        then do:
     1683          delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при создании команды &1&2&3&1&4"
     1684                                                           , 'cmd-esys-general':U
     1685                                                           , error-status:get-message(1)
     1686                                                           , return-value
     1687                                                           )).
     1688          return no .
     1689        end.
     1690        return yes.
     1691      end.
     1692   end.
     1693   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1694   function context_send-esys-command return logical
     1695   (
     1696       input p-esys-id-list as character
     1697      ,input p-esys-cmd-proc-handle as handle
     1698      ,input p-esys-cmd-code as integer
     1699      ,input p-user-id as character
     1700   ):
     1701      define variable v-dmp-ord-int64 as int64 no-undo .
     1702      if valid-handle(p-esys-cmd-proc-handle )
     1703      then do:
     1704         run send-command-esys in p-esys-cmd-proc-handle
     1705             (input p-esys-cmd-code
     1706             ,input p-esys-id-list
     1707             ,input p-user-id
     1708             ,output v-dmp-ord-int64
     1709             ) no-error.
     1710         if error-status :error
     1711         then do:
     1712            delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при отсылке во внешнюю систему &1 команды с кодом &2&3&4&3&5"
     1713                                                           , p-esys-id-list
     1714                                                           , p-cmd-code
     1715                                                           , chr(10)
     1716                                                           , error-status:get-message(1)
     1717                                                           , return-value
     1718                                                           )).
     1719            return no .
     1720         end.
     1721         delete procedure p-esys-cmd-proc-handle no-error.
     1722         return yes.
     1723      end.
     1724      else do:
     1725         delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при отсылке во внешнюю систему &1 команды с кодом &2&3&4&3&5"
     1726                                                       , p-esys-id-list
     1727                                                       , p-cmd-code
     1728                                                       , chr(10)
     1729                                                       , error-status:get-message(1)
     1730                                                       , return-value
     1731                                                       )).
     1732         return no .
     1733      end.
     1734   end.
     1735   on delete of this-procedure do:
     1736     run garbcoll_clear in this-procedure .
     1737   end.
     1738   run load-ruleset-context in this-procedure ( input p-ruleset-id) no-error.
     1739   if error-status:error then do:
     1740     undo, return error return-value .
     1741   end.
     1742   define variable ExpData1 as class Route-data_ no-undo .
     1743   ExpData1 = new Route-data_( input parparentproc, input p-parent-handle, input p-log-handle, input this-procedure:handle) .
     1744   if not this-procedure:persistent then do:
     1745     run proc-main in this-procedure no-error .
     1746     if error-status:error then do:
     1747         run garbcoll_clear in this-procedure .
     1748         undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     1749     end.
     1750     run garbcoll_clear in this-procedure .
     1751   end.
     1752   procedure proc-main :
     1753   _main:
     1754   do
     1755   on error undo, return error substitute( "&1&2&3&2&4", return-value, chr(10), error-status :get-message (1), v-last-error-message)
     1756   :
     1757     define variable v-ii as integer no-undo .
     1758     define variable v-pck-num-rec as integer no-undo init 1000.
     1759     define variable v-next-file as logical no-undo .
     1760     define buffer buf_cli-grp for ub.cli-grp.
     1761     define buffer buf_ext-system for ub.ext-system.
     1762     _stroka:
     1763     for each cgrp-list
     1764     break
     1765     by entry(1, cgrp-list.full-name, chr(47))
     1766     On error undo _stroka, next _stroka
     1767     :
     1768       assign
     1769       v-current-node-code = cgrp-list.node-code
     1770       num-rec = num-rec + 1
     1771       .
     1772       IF num-rec = 1
     1773       or num-rec modulo v-pck-num-rec = 1
     1774       THEN do:
     1775         IF  ExpData1:route-data_read-xmlschema( INPUT p-xsd-file) = false  THEN do:
     1776           undo _main, return error v-last-error-message .
     1777         end.
     1778         IF  context_begin-esys-command( input v-esys-id-list-start, input-output v-esys-cmd-proc-handle, output v-esys-cmd-code) = false  THEN do:
     1779           undo _main, return error v-last-error-message .
     1780         end.
     1781       end.
     1782       if p-save >= 0 then do:
     1783         find first buf_cli-grp exclusive-lock where
     1784                   buf_cli-grp.node-code = cgrp-list.node-code no-error.
     1785       end.
     1786       else do:
     1787         find first buf_cli-grp no-lock where
     1788                   buf_cli-grp.node-code = cgrp-list.node-code no-error.
     1789       end.
     1790       if not available buf_cli-grp then do:
     1791               run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не найдена содержащаяся в списке группа клиентов с вн.кодом &1", cgrp-list.node-code)).                      assign v-view-log = yes.
     1792         next _stroka.
     1793       end.
     1794       ExpData1:route-data_create-record( INPUT "cli-grp-01") .
     1795       ExpData1:route-data_copy-record( INPUT "cli-grp-01", INPUT  (buffer cgrp-list:handle) ) .
     1796       ExpData1:route-data_copy-field( INPUT "cli-grp-01"
     1797                                       , INPUT "full-name"
     1798                                       , INPUT (buffer cgrp-list:handle:buffer-field("full-name")) ) .
     1799       IF  ExpData1:esys-add-dump( INPUT "cli-grp-01", INPUT v-esys-cmd-proc-handle, INPUT v-esys-cmd-code, '+update') = false  THEN do:
     1800         undo _main, return error v-last-error-message .
     1801       end.
     1802       num-rec-ok = num-rec-ok + 1.
     1803       run write-counter in p-log-handle ( input substitute("Обработано групп клиентов: &1, из них удачно: &2", num-rec, num-rec-ok)).
     1804       run get-stop-state in p-log-handle ( output v-stop) no-error .
     1805       if v-stop then do:
     1806           run write-log-and-file in p-log-handle (
     1807                                                   input 1
     1808                                                 , input log-file-name
     1809                                                 , input 1
     1810                                                 , input substitute("Процесс прерван пользователем")).
     1811           leave _stroka.
     1812       end.
     1813       if num-rec modulo v-pck-num-rec = 0 then do:
     1814         v-next-file = yes.
     1815       end.
     1816       if last( entry(1, cgrp-list.full-name, chr(47)))
     1817       or (v-next-file  and last-of(entry(1, cgrp-list.full-name, chr(47))))
     1818       then do:
     1819         v-next-file = no.
     1820         IF  context_send-esys-command( input v-esys-id-list-start, input v-esys-cmd-proc-handle, input v-esys-cmd-code, input g#userid) = false  THEN do:
     1821           undo _main, return error v-last-error-message .
     1822         end.
     1823               ExpData1:Route-data_clear-data ( ) .
     1824       end.
     1825     end.
     1826     ExpData1:route-data_clear-xmlschema ( ).
     1827     run write-log-and-file in p-log-handle (
     1828           input 1
     1829         , input log-file-name
     1830         , input 1
     1831         , input substitute("Обработано групп клиентов: &1, из них удачно: &2", num-rec, num-rec-ok)).
     1832     ExpData1:route-data_clear-xmlschema ( ).
     1833   end.
     1834   end procedure.
     1835   procedure load-ruleset-context :
     1836   define input parameter p-ruleset-id as integer no-undo .
     1837   define buffer buf_rule-call-param for tt0-rule-call-param.
     1838   define buffer buf_ext-system for ub.ext-system.
     1839     do
     1840     on error undo, return error
     1841     :
     1842   for each buf_rule-call-param no-lock where
     1843   buf_rule-call-param.codex_id = p-codex-id
     1844   and buf_rule-call-param.ruleset_id = p-ruleset-id
     1845   and buf_rule-call-param.call_id = p-call-id
     1846   and buf_rule-call-param.order_id = p-order-id
     1847   and buf_rule-call-param.rule_id = p-rule-id
     1848   and buf_rule-call-param.param-name = "p-esys-id-list",
     1849     first buf_ext-system no-lock where
     1850           buf_Ext-system.esys-id = buf_rule-call-param.param-value-integer
     1851       and buf_Ext-system.db-num = 0
     1852       and buf_Ext-system.esys-have-export = yes
     1853       and buf_Ext-system.esys-db-num-exp = g#db-num:
     1854     v-esys-id-list-start = v-esys-id-list-start + (if v-esys-id-list-start = '' then '' else chr(1)) + string(buf_ext-system.esys-id).
     1855     assign
     1856     v-pck-num-rec = min(v-pck-num-rec, (if buf_ext-system.esys-max-p-size > 0
     1857                                         then buf_ext-system.esys-max-p-size
     1858                                         else v-pck-num-rec)).
     1859   end.
     1860   if v-esys-id-list-start = '' then return "return".
     1861     find first buf_rule-call-param no-lock where
     1862   buf_rule-call-param.codex_id = p-codex-id
     1863   and buf_rule-call-param.ruleset_id = p-ruleset-id
     1864   and buf_rule-call-param.call_id = p-call-id
     1865   and buf_rule-call-param.order_id = p-order-id
     1866   and buf_rule-call-param.rule_id = p-rule-id
     1867   and buf_rule-call-param.param-name = "p-xsd-file"
     1868    no-error.
     1869   if available buf_rule-call-param then do:
     1870   assign p-xsd-file = buf_rule-call-param.param-value-character.
     1871   end.
     1872       case p-ruleset-id:
     1873         when 1 then do:
     1874           assign
     1875           v-sign = 1
     1876           v-current-host-code = p-host-code
     1877           v-current-obj-type = p-obj-type
     1878           v-current-obj-code = p-obj-code
     1879           v-current-db-num = g#db-num
     1880           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     1881           file-name  = p-process-file-name
     1882           .
     1883         end.
     1884       end case.
     1885     end.
     1886   end procedure.
