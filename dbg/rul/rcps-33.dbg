     1300         subtotal_tt-rule-call-param SCROLLING.
     1301   DEFINE BROWSE br-gds
     1302     QUERY br-gds DISPLAY
     1303         get-param-value( INPUT gds_tt-rule-call-param.param-data-type
     1304                   ,INPUT gds_tt-rule-call-param.param-2-data-type
     1305                   ,INPUT gds_tt-rule-call-param.param-3-data-type
     1306                   ,INPUT gds_tt-rule-call-param.p-index
     1307                   ,INPUT gds_tt-rule-call-param.param-value-character
     1308                   ,INPUT gds_tt-rule-call-param.param-value-date
