     1333         X_rp-rule-param.rp-param-name COLUMN-LABEL "Название пар-ра!профайла" FORMAT "X(20)" width 16
     1334   term_tt-rule-call-param.codex_id COLUMN-LABEL "Кодекс"
     1335   term_tt-rule-call-param.ruleset_id COLUMN-LABEL "Набор"
     1336   term_tt-rule-call-param.order_id  COLUMN-LABEL "Порядок!вызова"
     1337   term_tt-rule-call-param.rule_id  COLUMN-LABEL "Правило"
     1338   term_tt-rule-call-param.profile_id  COLUMN-LABEL "Профайл"
     1339   term_tt-rule-call-param.once-more COLUMN-LABEL "№!Привязки"
     1340   (if lookup (term_tt-rule-call-param.param-data-type, 'character,date,datetime,datetime-tz,decimal,integer,void,logical,memptr,raw,recid,rowid,widget-handle,handle,blob,clob,class,com-handle,longchar,int64':U) > 0 then entry (lookup (term_tt-rule-call-param.param-data-type, 'character,date,datetime,datetime-tz,decimal,integer,void,logical,memptr,raw,recid,rowid,widget-handle,handle,blob,clob,class,com-handle,longchar,int64':U), 'строка,дата,дата-время,дата-время-з,десятичное,целое,пусто,логическое,память,двоичные,номер записи,Номер Записи,ссылка,ссылка,Больш.бин.объект,Больш.стр.объект,Объект,COM-объект,Длинная строка,64Целое':U) else term_tt-rule-call-param.param-data-type) COLUMN-LABEL "Тип пар-ра" FORMAT "X(12)"
     1341   term_tt-rule-call-param.param-num COLUMN-LABEL "№!пар-ра" FORMAT ">9"
     1342   TERM_tt-rule-call-param.p-index COLUMN-LABEL "Инд!екс" FORMAT ">9"
     1343   term_tt-rule-call-param.param-name COLUMN-LABEL "Название пар-ра!правила" FORMAT "X(16)"
     1344   term_tt-rule-call-param.param-label COLUMN-LABEL "Название пар-ра" FORMAT "X(255)" WIDTH 30
     1345   entry (lookup (term_tt-rule-call-param.param-mode, 'input,output,input-output,buffer,input table,output table,input-output table':u), 'вх,вых,вх-вых,курсор,вх табл,вых табл,вх/вых табл':u) COLUMN-LABEL "Вид!пар-ра"
     1346   get-param-value( INPUT term_tt-rule-call-param.param-data-type
     1347                   ,INPUT term_tt-rule-call-param.param-2-data-type
     1348                   ,INPUT term_tt-rule-call-param.param-3-data-type
     1349                   ,INPUT TERM_tt-rule-call-param.p-index
     1350                   ,INPUT term_tt-rule-call-param.param-value-character
     1351                   ,INPUT term_tt-rule-call-param.param-value-date
     1352                   ,INPUT term_tt-rule-call-param.param-value-decimal
     1353                   ,INPUT term_tt-rule-call-param.param-value-integer
     1354                   ,INPUT term_tt-rule-call-param.param-value-logical) COLUMN-LABEL "Значение" FORMAT "X(255)" WIDTH 26
     1355   (IF term_tt-rule-call-param.param-data-type = 'character':U
     1356    THEN term_tt-rule-call-param.param-value-character
     1357    ELSE '':U) COLUMN-LABEL "Значение!(строковое)" FORMAT "X(26)"
     1358   (IF term_tt-rule-call-param.param-data-type = 'date':U
     1359   THEN STRING(term_tt-rule-call-param.param-value-date, "99/99/9999")
     1360   ELSE '':U)    COLUMN-LABEL "Значение!(Дата)" FORMAT "X(10)" WIDTH 12
     1361   (IF term_tt-rule-call-param.param-data-type = 'decimal':U
     1362   THEN STRING(term_tt-rule-call-param.param-value-decimal)
     1363   ELSE '':U) COLUMN-LABEL "Значение!(Десятичное)"   FORMAT "X(16)"
     1364   (IF term_tt-rule-call-param.param-data-type = 'integer':U
     1365   THEN STRING(term_tt-rule-call-param.param-value-integer)
     1366   ELSE '':U) COLUMN-LABEL "Значение!(Целое)" FORMAT "X(10)"
     1367   (IF term_tt-rule-call-param.param-data-type = 'logical':U
     1368   THEN STRING(term_tt-rule-call-param.param-value-logical, "+/-")
     1369   ELSE '':U) COLUMN-LABEL "Значение!(Логическое)" FORMAT "X(2)"
     1370   calldscr(tt-rule-call-param.call_id) COLUMN-LABEL  "Точка вызова" FORMAT "X(40)"
     1371       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 6
