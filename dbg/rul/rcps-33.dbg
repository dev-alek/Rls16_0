     1387            TITLE "Скидки, применяемые к подитогу (в пор-ке убыв. приоритета)" FIT-LAST-COLUMN.
     1388   DEFINE FRAME Dialog-Frame
     1389        B-exit AT ROW 1 COL 1
     1390        b-quit AT ROW 1 COL 11
     1391        b-gds-add AT ROW 1 COL 69 WIDGET-ID 102
     1392        b-gds-delete AT ROW 1 COL 72 WIDGET-ID 104
     1393        B-Help AT ROW 1 COL 95
     1394        br-gds AT ROW 2 COL 41 WIDGET-ID 200
     1395        t-rule-gds AT ROW 2.07 COL 1 WIDGET-ID 96
     1396        t-add-gds-discnts AT ROW 3.13 COL 1 WIDGET-ID 88
     1397        B-gds-up AT ROW 3.13 COL 96 WIDGET-ID 114
     1398        B-gds-down AT ROW 4.13 COL 96 WIDGET-ID 116
     1399        b-subtotal-add AT ROW 7.67 COL 69 WIDGET-ID 106
     1400        b-subtotal-delete AT ROW 7.67 COL 72 WIDGET-ID 108
     1401        t-rule-subtotal AT ROW 8.2 COL 1 WIDGET-ID 98
     1402        br-subtotal AT ROW 8.47 COL 41 WIDGET-ID 300
     1403        t-add-subtotal-discnts AT ROW 9.27 COL 1 WIDGET-ID 92
     1404        B-subtotal-up AT ROW 9.53 COL 96 WIDGET-ID 120
     1405        B-subtotal-down AT ROW 10.53 COL 96 WIDGET-ID 118
     1406        b-pay-add AT ROW 14 COL 69 WIDGET-ID 110
     1407        b-pay-delete AT ROW 14 COL 72 WIDGET-ID 112
     1408        t-rule-pay AT ROW 14.8 COL 1 WIDGET-ID 100
     1409        br-pay AT ROW 14.8 COL 41 WIDGET-ID 400
     1410        B-pay-up AT ROW 15.6 COL 96 WIDGET-ID 124
     1411        t-add-pay-discnts AT ROW 16.13 COL 1 WIDGET-ID 94
     1412        B-pay-down AT ROW 16.6 COL 96 WIDGET-ID 122
     1413        BR-rcp AT ROW 17 COL 1 WIDGET-ID 100
     1414        SPACE(0.00) SKIP(0.25)
     1415       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1416            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1417            TITLE ""
     1418            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
     1419   ASSIGN
     1420          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1421          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1422   ASSIGN
     1423          BR-rcp:HIDDEN  IN FRAME Dialog-Frame                = TRUE.
     1424   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1425   DO:
     1426     APPLY "END-ERROR":U TO SELF.
     1427   END.
     1428   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
     1429   DO:
     1430     RUN proc-save IN THIS-PROCEDURE  NO-ERROR.
     1431     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1432   END.
     1433   ON CHOOSE OF b-gds-add IN FRAME Dialog-Frame
     1434   DO:
     1435   run proc-b-add in this-procedure ( input "p-discnt-roles"
     1436                                     ,input "p-gds-discnt-roles"
     1437                                     ,input 1971
     1438                                     ) no-error.
     1439   if not error-status:error then do:
     1440     OPEN QUERY br-gds FOR EACH gds_tt-rule-call-param where              gds_tt-rule-call-param.param-name = "p-discnt-roles"          and gds_tt-rule-call-param.rule_id = 1971          and gds_tt-rule-call-param.p-index > 0 by gds_tt-rule-call-param.p-index          .
     1441     reposition br-gds to recid recid(term_tt-rule-call-param).
     1442     apply "entry" to br-gds.
     1443   end.
     1444   END.
     1445   ON CHOOSE OF b-gds-delete IN FRAME Dialog-Frame
     1446   DO:
     1447     if not available gds_tt-rule-call-param then do:
     1448       bell.
     1449       return no-apply.
     1450     end.
     1451     delete gds_tt-rule-call-param.
     1452     run resort-rule-call-param in this-procedure( input "p-discnt-roles"
     1453                                                   ,input 1971).
     1454     OPEN QUERY br-gds FOR EACH gds_tt-rule-call-param where              gds_tt-rule-call-param.param-name = "p-discnt-roles"          and gds_tt-rule-call-param.rule_id = 1971          and gds_tt-rule-call-param.p-index > 0 by gds_tt-rule-call-param.p-index          .
     1455     reposition br-gds to row 1.
     1456     apply "entry" to br-gds.
     1457   END.
     1458   ON CHOOSE OF B-gds-down IN FRAME Dialog-Frame
     1459   DO:
     1460   define variable v-recid as recid no-undo .
     1461   run move-up-down in this-procedure ( buffer gds_tt-rule-call-param
     1462                                        ,input "down"
     1463                                        ,input 1971
     1464                                        ,output v-recid) no-error.
     1465   if error-status:error then do:
     1466   message error-status:get-message(1) view-as alert-box.
     1467   end.
     1468     OPEN QUERY br-gds FOR EACH gds_tt-rule-call-param where              gds_tt-rule-call-param.param-name = "p-discnt-roles"          and gds_tt-rule-call-param.rule_id = 1971          and gds_tt-rule-call-param.p-index > 0 by gds_tt-rule-call-param.p-index          .
     1469     reposition br-gds to recid(v-recid) no-error.
     1470     apply "ENTRY" to br-gds.
     1471   END.
     1472   ON CHOOSE OF B-gds-up IN FRAME Dialog-Frame
     1473   DO:
     1474   define variable v-recid as recid no-undo .
     1475   run move-up-down in this-procedure ( buffer gds_tt-rule-call-param
     1476                                        ,input "up"
     1477                                        ,input 1971
     1478                                        ,output v-recid) no-error.
     1479     OPEN QUERY br-gds FOR EACH gds_tt-rule-call-param where              gds_tt-rule-call-param.param-name = "p-discnt-roles"          and gds_tt-rule-call-param.rule_id = 1971          and gds_tt-rule-call-param.p-index > 0 by gds_tt-rule-call-param.p-index          .
     1480     reposition br-gds to recid(v-recid) no-error.
     1481     apply "ENTRY" to br-gds.
     1482   END.
     1483   ON CHOOSE OF b-pay-add IN FRAME Dialog-Frame
     1484   DO:
     1485   run proc-b-add in this-procedure ( input "p-discnt-roles"
     1486                                     ,input "p-pay-discnt-roles"
     1487                                     ,input 1973
     1488                                     ) no-error.
     1489   if not error-status:error then do:
     1490     OPEN QUERY br-pay FOR EACH pay_tt-rule-call-param where              pay_tt-rule-call-param.param-name = "p-discnt-roles"          and pay_tt-rule-call-param.rule_id = 1973          and pay_tt-rule-call-param.p-index > 0 by pay_tt-rule-call-param.p-index           .
     1491     reposition br-pay to recid recid(term_tt-rule-call-param).
     1492     apply "entry" to br-pay.
     1493   end.
     1494   END.
     1495   ON CHOOSE OF b-pay-delete IN FRAME Dialog-Frame
     1496   DO:
     1497     if not available pay_tt-rule-call-param then return no-apply.
     1498     delete pay_tt-rule-call-param.
     1499     run resort-rule-call-param in this-procedure( input "p-discnt-roles"
     1500                                                   ,input 1973).
     1501     OPEN QUERY br-pay FOR EACH pay_tt-rule-call-param where              pay_tt-rule-call-param.param-name = "p-discnt-roles"          and pay_tt-rule-call-param.rule_id = 1973          and pay_tt-rule-call-param.p-index > 0 by pay_tt-rule-call-param.p-index           .
     1502     reposition br-pay to row 1.
     1503     apply "entry" to br-pay.
     1504   END.
     1505   ON CHOOSE OF B-pay-down IN FRAME Dialog-Frame
     1506   DO:
     1507   define variable v-recid as recid no-undo .
     1508   run move-up-down in this-procedure ( buffer pay_tt-rule-call-param
     1509                                        ,input "down"
     1510                                        ,input 1973
     1511                                        ,output v-recid) no-error.
     1512     OPEN QUERY br-pay FOR EACH pay_tt-rule-call-param where              pay_tt-rule-call-param.param-name = "p-discnt-roles"          and pay_tt-rule-call-param.rule_id = 1973          and pay_tt-rule-call-param.p-index > 0 by pay_tt-rule-call-param.p-index           .
     1513     reposition br-pay to recid(v-recid) no-error.
     1514     apply "ENTRY" to br-pay.
     1515   END.
     1516   ON CHOOSE OF B-pay-up IN FRAME Dialog-Frame
     1517   DO:
     1518   define variable v-recid as recid no-undo .
     1519   run move-up-down in this-procedure ( buffer pay_tt-rule-call-param
     1520                                        ,input "up"
     1521                                        ,input 1973
     1522                                        ,output v-recid) no-error.
     1523     OPEN QUERY br-pay FOR EACH pay_tt-rule-call-param where              pay_tt-rule-call-param.param-name = "p-discnt-roles"          and pay_tt-rule-call-param.rule_id = 1973          and pay_tt-rule-call-param.p-index > 0 by pay_tt-rule-call-param.p-index           .
     1524     reposition br-pay to recid(v-recid) no-error.
     1525     apply "ENTRY" to br-pay.
     1526   END.
     1527   ON CHOOSE OF b-subtotal-add IN FRAME Dialog-Frame
     1528   DO:
     1529   run proc-b-add in this-procedure ( input "p-discnt-roles"
     1530                                     ,input "p-subtotal-discnt-roles"
     1531                                     ,input 1972
     1532                                     ) no-error.
     1533   if not error-status:error then do:
     1534     OPEN QUERY br-subtotal FOR EACH subtotal_tt-rule-call-param where              subtotal_tt-rule-call-param.param-name = "p-discnt-roles"          and subtotal_tt-rule-call-param.rule_id = 1972          and subtotal_tt-rule-call-param.p-index > 0 by subtotal_tt-rule-call-param.p-index            .
     1535     reposition br-subtotal to recid recid(term_tt-rule-call-param).
     1536     apply "entry" to br-subtotal.
     1537   end.
     1538   END.
     1539   ON CHOOSE OF b-subtotal-delete IN FRAME Dialog-Frame
     1540   DO:
     1541     if not available subtotal_tt-rule-call-param then return no-apply.
     1542     delete subtotal_tt-rule-call-param.
     1543     run resort-rule-call-param in this-procedure( input "p-discnt-roles"
     1544                                                   ,input 1972).
     1545     OPEN QUERY br-subtotal FOR EACH subtotal_tt-rule-call-param where              subtotal_tt-rule-call-param.param-name = "p-discnt-roles"          and subtotal_tt-rule-call-param.rule_id = 1972          and subtotal_tt-rule-call-param.p-index > 0 by subtotal_tt-rule-call-param.p-index            .
     1546     reposition br-subtotal to row 1.
     1547     apply "entry" to br-subtotal.
     1548   END.
     1549   ON CHOOSE OF B-subtotal-down IN FRAME Dialog-Frame
     1550   DO:
     1551   define variable v-recid as recid no-undo .
     1552   run move-up-down in this-procedure ( buffer subtotal_tt-rule-call-param
     1553                                        ,input "down"
     1554                                        ,input 1972
     1555                                        ,output v-recid) no-error.
     1556     OPEN QUERY br-subtotal FOR EACH subtotal_tt-rule-call-param where              subtotal_tt-rule-call-param.param-name = "p-discnt-roles"          and subtotal_tt-rule-call-param.rule_id = 1972          and subtotal_tt-rule-call-param.p-index > 0 by subtotal_tt-rule-call-param.p-index            .
     1557     reposition br-subtotal to recid(v-recid) no-error.
     1558     apply "ENTRY" to br-subtotal.
     1559   END.
     1560   ON CHOOSE OF B-subtotal-up IN FRAME Dialog-Frame
     1561   DO:
     1562   define variable v-recid as recid no-undo .
     1563   run move-up-down in this-procedure ( buffer subtotal_tt-rule-call-param
     1564                                        ,input "up"
     1565                                        ,input 1972
     1566                                        ,output v-recid) no-error.
     1567     OPEN QUERY br-subtotal FOR EACH subtotal_tt-rule-call-param where              subtotal_tt-rule-call-param.param-name = "p-discnt-roles"          and subtotal_tt-rule-call-param.rule_id = 1972          and subtotal_tt-rule-call-param.p-index > 0 by subtotal_tt-rule-call-param.p-index            .
     1568     reposition br-subtotal to recid(v-recid) no-error.
     1569     apply "ENTRY" to br-subtotal.
     1570   END.
     1571   ON VALUE-CHANGED OF t-rule-gds IN FRAME Dialog-Frame
     1572   DO:
     1573     assign
     1574     t-rule-gds.
     1575     case t-rule-gds:
     1576       when yes then do:
     1577          if p-mode <> 'ПРОСМОТР':U then do:
     1578           enable
     1579           t-add-gds-discnts
     1580           b-gds-add
     1581           b-gds-delete
     1582           b-gds-up
     1583           b-gds-down
     1584           with frame Dialog-Frame.
     1585          end.
     1586       end.
     1587       when no then do:
     1588         for each gds_tt-rule-call-param where
     1589               gds_tt-rule-call-param.param-name = "p-discnt-roles"
     1590           and gds_tt-rule-call-param.rule_id = 1971
     1591           and gds_tt-rule-call-param.p-index > 0:
     1592             delete gds_tt-rule-call-param.
     1593         end.
     1594         assign
     1595         t-add-gds-discnts = no.
     1596         display
     1597         t-add-gds-discnts
     1598         with frame Dialog-Frame.
     1599         disable
     1600         t-add-gds-discnts
     1601         b-gds-add
     1602         b-gds-delete
     1603         b-gds-up
     1604         b-gds-down
     1605         with frame Dialog-Frame.
     1606         OPEN QUERY br-gds FOR EACH gds_tt-rule-call-param where              gds_tt-rule-call-param.param-name = "p-discnt-roles"          and gds_tt-rule-call-param.rule_id = 1971          and gds_tt-rule-call-param.p-index > 0 by gds_tt-rule-call-param.p-index          .
     1607        end.
     1608     end.
     1609   END.
     1610   ON VALUE-CHANGED OF t-rule-pay IN FRAME Dialog-Frame
     1611   DO:
     1612       assign
     1613     t-rule-pay.
     1614     case t-rule-pay:
     1615       when yes then do:
     1616          if p-mode <> 'ПРОСМОТР':U then do:
     1617           enable
     1618           t-add-pay-discnts
     1619           b-pay-add
     1620           b-pay-delete
     1621           b-pay-up
     1622           b-pay-down
     1623           with frame Dialog-Frame.
     1624          end.
     1625       end.
     1626       when no then do:
     1627         for each pay_tt-rule-call-param where
     1628               pay_tt-rule-call-param.param-name = "p-discnt-roles"
     1629           and pay_tt-rule-call-param.rule_id = 1973
     1630           and pay_tt-rule-call-param.p-index > 0:
     1631             delete pay_tt-rule-call-param.
     1632         end.
     1633         assign
     1634         t-add-pay-discnts = no.
     1635         display
     1636         t-add-pay-discnts
     1637         with frame Dialog-Frame.
     1638         disable
     1639         t-add-pay-discnts
     1640         b-pay-add
     1641         b-pay-delete
     1642         b-pay-up
     1643         b-pay-down
     1644         with frame Dialog-Frame.
     1645         OPEN QUERY br-pay FOR EACH pay_tt-rule-call-param where              pay_tt-rule-call-param.param-name = "p-discnt-roles"          and pay_tt-rule-call-param.rule_id = 1973          and pay_tt-rule-call-param.p-index > 0 by pay_tt-rule-call-param.p-index           .
     1646        end.
     1647     end.
     1648   END.
     1649   ON VALUE-CHANGED OF t-rule-subtotal IN FRAME Dialog-Frame
     1650   DO:
     1651       assign
     1652     t-rule-subtotal.
     1653     case t-rule-subtotal:
     1654       when yes then do:
     1655          if p-mode <> 'ПРОСМОТР':U then do:
     1656           enable
     1657           t-add-subtotal-discnts
     1658           b-subtotal-add
     1659           b-subtotal-delete
     1660           b-subtotal-up
     1661           b-subtotal-down
     1662           with frame Dialog-Frame.
     1663          end.
     1664       end.
     1665       when no then do:
     1666         for each subtotal_tt-rule-call-param where
     1667               subtotal_tt-rule-call-param.param-name = "p-discnt-roles"
     1668           and subtotal_tt-rule-call-param.rule_id = 1972
     1669           and subtotal_tt-rule-call-param.p-index > 0:
     1670             delete subtotal_tt-rule-call-param.
     1671         end.
     1672         assign
     1673         t-add-subtotal-discnts = no.
     1674         display
     1675         t-add-subtotal-discnts
     1676         with frame Dialog-Frame.
     1677         disable
     1678         t-add-subtotal-discnts
     1679         b-subtotal-add
     1680         b-subtotal-delete
     1681         b-subtotal-up
     1682         b-subtotal-down
     1683         with frame Dialog-Frame.
     1684         OPEN QUERY br-subtotal FOR EACH subtotal_tt-rule-call-param where              subtotal_tt-rule-call-param.param-name = "p-discnt-roles"          and subtotal_tt-rule-call-param.rule_id = 1972          and subtotal_tt-rule-call-param.p-index > 0 by subtotal_tt-rule-call-param.p-index            .
     1685        end.
     1686     end.
     1687   END.
     1688   ON ROW-DISPLAY OF br-rcp IN frame Dialog-Frame
     1689   DO:
     1690     IF AVAIL tt-rule-call-param THEN DO:
     1691       RUN rcps_set-row-color IN THIS-PROCEDURE ( INPUT term_tt-rule-call-param.param-data-type).
     1692     END.
     1693   END.
     1694   ON f6 anywhere DO:
     1695     ASSIGN
     1696     br-rcp:VISIBLE IN FRAME Dialog-Frame = (NOT br-rcp:VISIBLE IN FRAME Dialog-Frame)
     1697     .
     1698   END.
     1699   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1700   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1701   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1702   on help of frame Dialog-Frame
     1703   do:
     1704     run gbl/app_help.p
     1705       (input this-procedure :file-name
     1706       ,input ''
     1707       ,input ?
     1708       ) no-error.
     1709     if error-status :error then do:
     1710       message
     1711         "Ошибка при вызове помощи"
     1712         error-status :get-message(1)
     1713         view-as alert-box .
     1714     end.
     1715   end.
     1716   run minbtn-set in this-procedure .
     1717   on choose of b-help in frame Dialog-Frame
     1718   do:
     1719     apply "help":u to frame Dialog-Frame .
     1720   end.
     1721   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1722   procedure minbtn-set :
     1723       do
     1724           on error undo, return error return-value
     1725           :
     1726           define variable ii              as integer       no-undo .
     1727           define variable fh              as widget-handle no-undo .
     1728           define variable hh              as widget-handle no-undo .
     1729           define variable v-h             as handle        extent 4 no-undo .
     1730           define variable v-name-button   as character     no-undo .
     1731           define variable v-help-old-x    as decimal       no-undo .
     1732           define variable v-help-old-y    as decimal       no-undo .
     1733           define variable v-help-old-size as decimal       no-undo .
     1734           define variable v-frame-width   as decimal       no-undo .
     1735           define variable jj              as integer       no-undo .
     1736           do
     1737               on error undo, return error
     1738               :
     1739               assign
     1740                   v-frame-width = frame Dialog-Frame:width - 0.3
     1741                   fh            = frame Dialog-Frame:first-child
     1742                   hh            = fh:first-child
     1743                   ii            = 1
     1744                   .
     1745               do while valid-handle(hh):
     1746                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1747                   do:
     1748                       case lc(hh:name) :
     1749                           when "b-help" then
     1750                               do:
     1751                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1752                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1753                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1754                                   hh:TOOLTIP = "Помощь" .
     1755                                   v-help-old-x = hh:column .
     1756                                   v-help-old-y = hh:row    .
     1757                                   v-help-old-size = hh:width .
     1758                                   hh:width-chars = 2.5 .
     1759                               end.
     1760                           when "b-print" then
     1761                               do:
     1762                                   hh:load-image("cmp/b-print.bmp":u) .
     1763                                   hh:TOOLTIP = "Печать" .
     1764                                   v-h[ii] = hh:handle .
     1765                                   ii = ii + 1 .
     1766                                   hh:width-chars = 3 .
     1767                               end.
     1768                           when "b-history" or
     1769                           when "b-hist" then
     1770                               do:
     1771                                   hh:load-image("cmp/b-hist.bmp":u) .
     1772                                   hh:TOOLTIP = "История" .
     1773                                   v-h[ii] = hh:handle .
     1774                                   ii = ii + 1 .
     1775                                   hh:width-chars = 3 .
     1776                               end.
     1777                           when "b-sch" then
     1778                               do:
     1779                                   hh:load-image("cmp/b-sch.bmp":u) .
     1780                                   hh:TOOLTIP = "Установка Фильтра" .
     1781                                   v-h[ii] = hh:handle .
     1782                                   ii = ii + 1 .
     1783                                   hh:width-chars = 3 .
     1784                               end.
     1785                           when "b-hist-user" then
     1786                               do:
     1787                                   hh:load-image("cmp/b-hist.bmp":u) .
     1788                                   hh:TOOLTIP = "История пользователя" .
     1789                                   ii = ii + 1 .
     1790                               end.
     1791                       end case.
     1792                   end.
     1793                   hh = hh:next-sibling.
     1794               end.
     1795               b-help:column = v-frame-width - b-help:width-chars.
     1796               jj = 0.
     1797               repeat ii = 4 to 1 by -1 :
     1798                   if valid-handle (v-h[ii] ) then
     1799                   do:
     1800                       jj  = jj + 1 .
     1801                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1802                       v-h[ii]:row    = v-help-old-y .
     1803                   end.
     1804               end.
     1805           end.
     1806       end.
     1807   end procedure.
     1808   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1809   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1810   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1811   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1812   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1813   define variable v-diasize-current-frame-height as decimal   no-undo .
     1814   define variable v-diasize-change-size          as logical   no-undo .
     1815   define variable v-diasize-resize-button        as handle    no-undo .
     1816   define variable v-diasize-wndmax               as logical   no-undo .
     1817   define variable v-diasize-wndstore             as logical   no-undo .
     1818   define variable v-diasize-proc-name            as character no-undo .
     1819   define variable v-diasize-browse-handle        as handle    no-undo .
     1820   define variable v-diasize-browse-number        as integer   no-undo .
     1821   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1822   define temp-table temp-diasize-handle no-undo
     1823     field handle-value  as handle
     1824     field save-position as decimal
     1825     index xpk is primary unique handle-value
     1826     .
     1827   define temp-table temp-browse-handle no-undo
     1828     field browse-type   as character
     1829     field browse-number as integer
     1830     field browse-handle as handle
     1831     field original-size as decimal
     1832     index xpk is primary unique browse-type browse-number
     1833     index xie browse-type browse-handle
     1834   .
     1835   procedure diasize_change-height :
     1836     define input  parameter p-change-value  as decimal   no-undo .
     1837     define input  parameter p-move-resize   as logical   no-undo .
     1838     define variable v-field-group-handle    as handle    no-undo .
     1839     define variable v-object-handle         as handle    no-undo .
     1840     define variable v-frame-height          as decimal   no-undo .
     1841     define variable v-frame-virtual-height  as decimal   no-undo .
     1842     define variable v-browse-height         as decimal   no-undo .
     1843     define variable v-window-height         as decimal   no-undo .
     1844     define variable v-window-virtual-height as decimal   no-undo .
     1845     define variable v-change-sign           as integer   no-undo .
     1846     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1847     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1848     if p-change-value > 0
     1849     then do:
     1850       if frame Dialog-Frame :height + p-change-value
     1851           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1852       then do:
     1853         assign
     1854           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1855                           - (frame Dialog-Frame :height-chars)
     1856         .
     1857         if p-change-value <= 0
     1858         then do:
     1859           run diasize_position-resize-button in this-procedure .
     1860           return .
     1861         end.
     1862       end.
     1863     end.
     1864     if p-change-value < 0
     1865     then do:
     1866       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1867       then do:
     1868         assign
     1869           p-change-value = v-diasize-orig-frame-height
     1870                          - (frame Dialog-Frame :height-chars)
     1871         .
     1872         if p-change-value >= 0
     1873         then do:
     1874           run diasize_position-resize-button in this-procedure .
     1875           return .
     1876         end.
     1877       end.
     1878     end.
     1879     if p-change-value >= 0
     1880     then do:
     1881       assign
     1882         v-change-sign = 1
     1883       .
     1884     end.
     1885     else do:
     1886       assign
     1887         v-change-sign = -1
     1888       .
     1889     end.
     1890     assign
     1891       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1892     .
     1893     if p-change-value = 0
     1894     then do:
     1895       run diasize_position-resize-button in this-procedure .
     1896       return .
     1897     end.
     1898     move_block:
     1899     do
     1900     on error undo move_block, retry move_block
     1901     :
     1902       if retry
     1903       then do:
     1904         do
     1905         on error undo move_block, leave move_block
     1906         :
     1907           if p-change-value > 0
     1908           then do:
     1909             for each buf_temp-diasize-handle
     1910             on error undo, next
     1911             :
     1912               assign
     1913                 v-object-handle = buf_temp-diasize-handle.handle-value
     1914               .
     1915               if v-object-handle <> v-diasize-resize-button
     1916               then do:
     1917                 assign
     1918                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1919                 .
     1920               end.
     1921             end.
     1922             assign
     1923               v-diasize-browse-handle :height = v-browse-height
     1924             .
     1925             for each buf_temp-browse-handle
     1926               where buf_temp-browse-handle.browse-type = 'height':u
     1927             on error undo, next
     1928             :
     1929               assign
     1930                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1931               .
     1932             end.
     1933             assign
     1934               frame Dialog-Frame :height = v-frame-height
     1935             .
     1936             if frame Dialog-Frame :scrollable = true
     1937             then do:
     1938               assign
     1939                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1940               .
     1941             end.
     1942             run diasize_position-resize-button in this-procedure .
     1943           end.
     1944           else do:
     1945             if frame Dialog-Frame :scrollable = true
     1946             then do:
     1947               assign
     1948                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1949               .
     1950             end.
     1951             assign
     1952               frame Dialog-Frame :height = v-frame-height
     1953             .
     1954             assign
     1955               v-diasize-browse-handle :height = v-browse-height
     1956             .
     1957             for each buf_temp-browse-handle
     1958               where buf_temp-browse-handle.browse-type = 'height':u
     1959             on error undo, next
     1960             :
     1961               assign
     1962                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1963               .
     1964             end.
     1965             for each buf_temp-diasize-handle
     1966             on error undo, next
     1967             :
     1968               assign
     1969                 v-object-handle = buf_temp-diasize-handle.handle-value
     1970               .
     1971               if v-object-handle <> v-diasize-resize-button
     1972               then do:
     1973                 assign
     1974                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1975                 .
     1976               end.
     1977             end.
     1978             run diasize_position-resize-button in this-procedure .
     1979           end.
     1980           assign
     1981             v-diasize-change-size = false
     1982           .
     1983           leave move_block .
     1984         end.
     1985       end.
     1986       assign
     1987         v-diasize-need-full-display = true
     1988       .
     1989       if v-diasize-change-size = false
     1990       then do:
     1991         assign
     1992           v-diasize-change-size = true
     1993         .
     1994       end.
     1995       else do:
     1996         return .
     1997       end.
     1998       assign
     1999         v-frame-height = frame Dialog-Frame :height
     2000         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2001         v-browse-height = v-diasize-browse-handle :height
     2002       .
     2003       for each buf_temp-browse-handle
     2004         where buf_temp-browse-handle.browse-type = 'height':u
     2005       :
     2006         assign
     2007           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2008         .
     2009       end.
     2010       for each buf_temp-diasize-handle
     2011       :
     2012         delete buf_temp-diasize-handle .
     2013       end.
     2014       assign
     2015         v-field-group-handle = frame Dialog-Frame :first-child
     2016       .
     2017       do while valid-handle(v-field-group-handle)
     2018       :
     2019         assign
     2020           v-object-handle = v-field-group-handle :first-child
     2021         .
     2022         do while valid-handle(v-object-handle)
     2023         :
     2024           if  v-object-handle <> v-diasize-browse-handle :handle
     2025           and can-query(v-object-handle, "row")
     2026           and can-query(v-object-handle, "height")
     2027           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2028           then do:
     2029             find first buf_temp-browse-handle
     2030               where buf_temp-browse-handle.browse-type   = 'height':u
     2031                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2032               no-error .
     2033             if available buf_temp-browse-handle
     2034             then do:
     2035             end.
     2036             else do:
     2037               create buf_temp-diasize-handle .
     2038               assign
     2039                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2040                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2041               .
     2042             end.
     2043           end.
     2044           assign
     2045             v-object-handle = v-object-handle :next-sibling
     2046           .
     2047         end.
     2048         assign
     2049           v-field-group-handle = v-field-group-handle :next-sibling
     2050         .
     2051       end.
     2052       do with frame Dialog-Frame
     2053       :
     2054         hide v-diasize-resize-button .
     2055         assign
     2056           v-diasize-resize-button :row    = 1
     2057           v-diasize-resize-button :column = 1
     2058         .
     2059       end.
     2060       if p-change-value > 0
     2061       then do:
     2062         if frame Dialog-Frame :scrollable = true
     2063         then do:
     2064           assign
     2065             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2066             no-error .
     2067           if error-status :error
     2068           or error-status :get-message(1) <> ""
     2069           then do:
     2070             undo move_block, retry move_block .
     2071           end.
     2072         end.
     2073         assign
     2074           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2075           no-error .
     2076         if error-status :error
     2077         or error-status :get-message(1) <> ""
     2078         then do:
     2079           undo move_block, retry move_block .
     2080         end.
     2081         assign
     2082           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2083           no-error .
     2084         if error-status :error
     2085         or error-status :get-message(1) <> ""
     2086         then do:
     2087           undo move_block, retry move_block .
     2088         end.
     2089         for each buf_temp-browse-handle
     2090           where buf_temp-browse-handle.browse-type = 'height':u
     2091         on error undo move_block, retry move_block
     2092         :
     2093           assign
     2094             buf_temp-browse-handle.browse-handle :height
     2095               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2096             no-error .
     2097           if error-status :error
     2098           or error-status :get-message(1) <> ""
     2099           then do:
     2100             undo move_block, retry move_block .
     2101           end.
     2102         end.
     2103         for each buf_temp-diasize-handle
     2104         on error undo move_block, retry move_block
     2105         :
     2106           assign
     2107             v-object-handle = buf_temp-diasize-handle.handle-value
     2108           .
     2109           if v-object-handle <> v-diasize-resize-button
     2110           then do:
     2111             assign
     2112               v-object-handle :row = v-object-handle :row + p-change-value
     2113               no-error .
     2114             if error-status :error
     2115             or error-status :get-message(1) <> ""
     2116             then do:
     2117               undo move_block, retry move_block .
     2118             end.
     2119           end.
     2120         end.
     2121       end.
     2122       else do:
     2123         for each buf_temp-diasize-handle
     2124         on error undo move_block, retry move_block
     2125         :
     2126           assign
     2127             v-object-handle = buf_temp-diasize-handle.handle-value
     2128           .
     2129           if v-object-handle <> v-diasize-resize-button
     2130           then do:
     2131             assign
     2132               v-object-handle :row = v-object-handle :row + p-change-value
     2133               no-error .
     2134             if error-status :error
     2135             or error-status :get-message(1) <> ""
     2136             then do:
     2137               undo move_block, retry move_block .
     2138             end.
     2139           end.
     2140         end.
     2141         assign
     2142           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2143           no-error .
     2144         if error-status :error
     2145         or error-status :get-message(1) <> ""
     2146         then do:
     2147           undo move_block, retry move_block .
     2148         end.
     2149         for each buf_temp-browse-handle
     2150           where buf_temp-browse-handle.browse-type = 'height':u
     2151         on error undo move_block, retry move_block
     2152         :
     2153           assign
     2154             buf_temp-browse-handle.browse-handle :height
     2155               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2156             no-error .
     2157           if error-status :error
     2158           or error-status :get-message(1) <> ""
     2159           then do:
     2160             undo move_block, retry move_block .
     2161           end.
     2162         end.
     2163         assign
     2164           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2165           no-error .
     2166         if error-status :error
     2167         or error-status :get-message(1) <> ""
     2168         then do:
     2169           undo move_block, retry move_block .
     2170         end.
     2171         if frame Dialog-Frame :scrollable = true
     2172         then do:
     2173           assign
     2174             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2175             no-error .
     2176           if error-status :error
     2177           or error-status :get-message(1) <> ""
     2178           then do:
     2179             undo move_block, retry move_block .
     2180           end.
     2181         end.
     2182       end.
     2183       if p-move-resize = true
     2184       then do:
     2185         run diasize_position-resize-button in this-procedure .
     2186       end.
     2187       if v-diasize-wndstore = true
     2188       then do:
     2189         if connected("ub") = true
     2190         then do:
     2191           define variable v-cntxt-db-num        as integer   no-undo .
     2192           define variable v-cntxt-userid        as character no-undo .
     2193           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2194                                             , OUTPUT v-cntxt-userid
     2195                                             ) .
     2196           run gbl/wndsizew.p
     2197             (input  v-cntxt-db-num
     2198             ,input  v-cntxt-userid
     2199             ,input  v-diasize-proc-name
     2200             ,input  'height':u
     2201             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2202             ) .
     2203         end.
     2204       end.
     2205     end.
     2206     assign
     2207       v-diasize-change-size = false
     2208     .
     2209   end procedure.
     2210   procedure diasize_set-height :
     2211     define input  parameter p-new-height  as decimal   no-undo .
     2212     define input  parameter p-move-resize as logical   no-undo .
     2213     do
     2214     on error undo, return error return-value
     2215     :
     2216       run diasize_change-height in this-procedure
     2217         (input  (p-new-height - frame Dialog-Frame :height)
     2218         ,input  p-move-resize
     2219         ) .
     2220     end.
     2221   end procedure.
     2222   procedure diasize_change-width :
     2223     define input  parameter p-change-value as decimal   no-undo .
     2224     define input  parameter p-move-resize  as logical   no-undo .
     2225     define variable v-field-group-handle   as handle    no-undo .
     2226     define variable v-object-handle        as handle    no-undo .
     2227     define variable v-frame-width          as decimal   no-undo .
     2228     define variable v-frame-virtual-width  as decimal   no-undo .
     2229     define variable v-browse-width         as decimal   no-undo .
     2230     define variable v-window-width         as decimal   no-undo .
     2231     define variable v-window-virtual-width as decimal   no-undo .
     2232     define variable v-change-sign          as integer   no-undo .
     2233     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2234     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2235     if p-change-value > 0
     2236     then do:
     2237       if frame Dialog-Frame :width + p-change-value >
     2238           session :width-chars
     2239       then do:
     2240         assign
     2241           p-change-value = session :width-chars - frame Dialog-Frame :width
     2242         .
     2243         if p-change-value <= 0
     2244         then do:
     2245           run diasize_position-resize-button in this-procedure .
     2246           return .
     2247         end.
     2248       end.
     2249     end.
     2250     if p-change-value < 0
     2251     then do:
     2252       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2253       then do:
     2254         assign
     2255           p-change-value = v-diasize-orig-frame-width
     2256                          - frame Dialog-Frame :width
     2257         .
     2258         if p-change-value >= 0
     2259         then do:
     2260           run diasize_position-resize-button in this-procedure .
     2261           return .
     2262         end.
     2263       end.
     2264     end.
     2265     if p-change-value >= 0
     2266     then do:
     2267       assign
     2268         v-change-sign = 1
     2269       .
     2270     end.
     2271     else do:
     2272       assign
     2273         v-change-sign = -1
     2274       .
     2275     end.
     2276     assign
     2277       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2278     .
     2279     if p-change-value = 0
     2280     then do:
     2281       run diasize_position-resize-button in this-procedure .
     2282       return .
     2283     end.
     2284     move_block:
     2285     do
     2286     on error undo move_block, leave move_block
     2287     :
     2288       if retry
     2289       then do:
     2290         do
     2291         on error undo move_block, leave move_block
     2292         :
     2293           if p-change-value > 0
     2294           then do:
     2295             for each buf_temp-diasize-handle
     2296             on error undo, next
     2297             :
     2298               assign
     2299                 v-object-handle = buf_temp-diasize-handle.handle-value
     2300               .
     2301               if v-object-handle <> v-diasize-resize-button
     2302               then do:
     2303                 assign
     2304                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2305                 .
     2306               end.
     2307             end.
     2308             assign
     2309               v-diasize-browse-handle :width = v-browse-width
     2310             .
     2311             for each buf_temp-browse-handle
     2312               where buf_temp-browse-handle.browse-type = 'width':u
     2313             on error undo, next
     2314             :
     2315               assign
     2316                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2317               .
     2318             end.
     2319             assign
     2320               frame Dialog-Frame :width = v-frame-width
     2321             .
     2322             if frame Dialog-Frame :scrollable = true
     2323             then do:
     2324               assign
     2325                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2326               .
     2327             end.
     2328             run diasize_position-resize-button in this-procedure .
     2329           end.
     2330           else do:
     2331             if frame Dialog-Frame :scrollable = true
     2332             then do:
     2333               assign
     2334                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2335               .
     2336             end.
     2337             assign
     2338               frame Dialog-Frame :width = v-frame-width
     2339             .
     2340             for each buf_temp-browse-handle
     2341               where buf_temp-browse-handle.browse-type = 'width':u
     2342             on error undo, next
     2343             :
     2344               assign
     2345                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2346               .
     2347             end.
     2348             assign
     2349               v-diasize-browse-handle :width = v-browse-width
     2350             .
     2351             for each buf_temp-diasize-handle
     2352             on error undo, next
     2353             :
     2354               assign
     2355                 v-object-handle = buf_temp-diasize-handle.handle-value
     2356               .
     2357               if v-object-handle <> v-diasize-resize-button
     2358               then do:
     2359                 assign
     2360                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2361                 .
     2362               end.
     2363             end.
     2364             run diasize_position-resize-button in this-procedure .
     2365           end.
     2366           assign
     2367             v-diasize-change-size = false
     2368           .
     2369           leave move_block .
     2370         end.
     2371       end.
     2372       assign
     2373         v-diasize-need-full-display = true
     2374       .
     2375       if v-diasize-change-size = false
     2376       then do:
     2377         assign
     2378           v-diasize-change-size = true
     2379         .
     2380       end.
     2381       else do:
     2382         return .
     2383       end.
     2384       assign
     2385         v-frame-width = frame Dialog-Frame :width
     2386         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2387         v-browse-width = v-diasize-browse-handle :width
     2388       .
     2389       for each buf_temp-browse-handle
     2390         where buf_temp-browse-handle.browse-type = 'width':u
     2391       :
     2392         assign
     2393           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2394         .
     2395       end.
     2396       for each buf_temp-diasize-handle
     2397       :
     2398         delete buf_temp-diasize-handle .
     2399       end.
     2400       assign
     2401         v-field-group-handle = frame Dialog-Frame :first-child
     2402       .
     2403       do while valid-handle(v-field-group-handle)
     2404       :
     2405         assign
     2406           v-object-handle = v-field-group-handle :first-child
     2407         .
     2408         do while valid-handle(v-object-handle)
     2409         :
     2410           if  v-object-handle <> v-diasize-browse-handle :handle
     2411           and v-object-handle <> v-diasize-resize-button
     2412           and can-query(v-object-handle, "row")
     2413           and can-query(v-object-handle, "height")
     2414           and ( v-object-handle :col + v-object-handle :width
     2415                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2416               )
     2417           then do:
     2418             find first buf_temp-browse-handle
     2419               where buf_temp-browse-handle.browse-type   = 'width':u
     2420                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2421               no-error .
     2422             if available buf_temp-browse-handle
     2423             then do:
     2424             end.
     2425             else do:
     2426               create buf_temp-diasize-handle .
     2427               assign
     2428                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2429                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2430               .
     2431             end.
     2432           end.
     2433           assign
     2434             v-object-handle = v-object-handle :next-sibling
     2435           .
     2436         end.
     2437         assign
     2438           v-field-group-handle = v-field-group-handle :next-sibling
     2439         .
     2440       end.
     2441       do with frame Dialog-Frame
     2442       :
     2443         hide v-diasize-resize-button .
     2444         v-diasize-resize-button :row = 1.
     2445         v-diasize-resize-button :column = 1.
     2446       end.
     2447       if p-change-value > 0
     2448       then do:
     2449         if frame Dialog-Frame :scrollable = true
     2450         then do:
     2451           assign
     2452             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2453             no-error .
     2454           if error-status :error
     2455           or error-status :get-message(1) <> ""
     2456           then do:
     2457             undo move_block, retry move_block.
     2458           end.
     2459         end.
     2460         assign
     2461           frame Dialog-Frame :width = v-frame-width + p-change-value
     2462           no-error .
     2463         if error-status :error
     2464         or error-status :get-message(1) <> ""
     2465         then do:
     2466           undo move_block, retry move_block.
     2467         end.
     2468         assign
     2469           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2470         no-error .
     2471         if error-status :error
     2472         or error-status :get-message(1) <> ""
     2473         then do:
     2474           undo move_block, retry move_block.
     2475         end.
     2476         for each buf_temp-browse-handle
     2477           where buf_temp-browse-handle.browse-type = 'width':u
     2478         on error undo move_block, retry move_block
     2479         :
     2480           assign
     2481             buf_temp-browse-handle.browse-handle :width
     2482               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2483             no-error .
     2484           if error-status :error
     2485           or error-status :get-message(1) <> ""
     2486           then do:
     2487             undo move_block, retry move_block .
     2488           end.
     2489         end.
     2490         for each buf_temp-diasize-handle
     2491         on error undo move_block, retry move_block
     2492         :
     2493           assign
     2494             v-object-handle = buf_temp-diasize-handle.handle-value
     2495           .
     2496           if v-object-handle <> v-diasize-resize-button
     2497           then do:
     2498             assign
     2499               v-object-handle :col = v-object-handle :col + p-change-value
     2500               no-error .
     2501             if error-status :error
     2502             or error-status :get-message(1) <> ""
     2503             then do:
     2504               undo move_block, retry move_block .
     2505             end.
     2506           end.
     2507         end.
     2508       end.
     2509       else do:
     2510         for each buf_temp-diasize-handle
     2511         on error undo move_block, retry move_block
     2512         :
     2513           assign
     2514             v-object-handle = buf_temp-diasize-handle.handle-value
     2515           .
     2516           if v-object-handle <> v-diasize-resize-button
     2517           then do:
     2518             assign
     2519               v-object-handle :col = v-object-handle :col + p-change-value
     2520               no-error .
     2521             if error-status :error
     2522             or error-status :get-message(1) <> ""
     2523             then do:
     2524               undo move_block, retry move_block .
     2525             end.
     2526           end.
     2527         end.
     2528         for each buf_temp-browse-handle
     2529           where buf_temp-browse-handle.browse-type = 'width':u
     2530         on error undo move_block, retry move_block
     2531         :
     2532           assign
     2533             buf_temp-browse-handle.browse-handle :width
     2534               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2535             no-error .
     2536           if error-status :error
     2537           or error-status :get-message(1) <> ""
     2538           then do:
     2539             undo move_block, retry move_block .
     2540           end.
     2541         end.
     2542         assign
     2543           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2544           no-error .
     2545         if error-status :error
     2546         or error-status :get-message(1) <> ""
     2547         then do:
     2548           undo move_block, retry move_block.
     2549         end.
     2550         assign
     2551           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2552         no-error .
     2553         if error-status :error
     2554         or error-status :get-message(1) <> ""
     2555         then do:
     2556           undo move_block, retry move_block.
     2557         end.
     2558         if frame Dialog-Frame :scrollable = true
     2559         then do:
     2560           assign
     2561             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2562           no-error .
     2563           if error-status :error
     2564           or error-status :get-message(1) <> ""
     2565           then do:
     2566             undo move_block, retry move_block.
     2567           end.
     2568         end.
     2569       end.
     2570       if p-move-resize
     2571       then do:
     2572         run diasize_position-resize-button in this-procedure .
     2573       end.
     2574       if v-diasize-wndstore = true
     2575       then do:
     2576         if connected("ub") = true
     2577         then do:
     2578           define variable v-cntxt-db-num        as integer   no-undo .
     2579           define variable v-cntxt-userid        as character no-undo .
     2580           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2581                                             , OUTPUT v-cntxt-userid
     2582                                             ) .
     2583           run gbl/wndsizew.p
     2584             (input  v-cntxt-db-num
     2585             ,input  v-cntxt-userid
     2586             ,input  v-diasize-proc-name
     2587             ,input  'width':u
     2588             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2589             ) .
     2590         end.
     2591       end.
     2592     end.
     2593     assign
     2594       v-diasize-change-size = false
     2595     .
     2596   end procedure.
     2597   procedure diasize_set-width :
     2598     define input  parameter p-new-width  as decimal   no-undo .
     2599     define input  parameter p-move-resize as logical   no-undo .
     2600     do
     2601     on error undo, return error return-value
     2602     :
     2603       run diasize_change-width in this-procedure
     2604         (input  (p-new-width - frame Dialog-Frame :width)
     2605         ,input  p-move-resize
     2606         ) .
     2607     end.
     2608   end procedure.
     2609   procedure diasize_position-resize-button :
     2610     do with frame Dialog-Frame
     2611     :
     2612       hide v-diasize-resize-button .
     2613       assign
     2614         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2615                     - 1
     2616                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2617         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2618                     - 1
     2619                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2620       .
     2621       view v-diasize-resize-button .
     2622     end.
     2623   end procedure.
     2624   on alt-right anywhere
     2625   do:
     2626     run diasize_change-width in this-procedure
     2627       (input 1
     2628       ,input true
     2629       ) .
     2630     return no-apply .
     2631   end.
     2632   on alt-left anywhere
     2633   do:
     2634     run diasize_change-width in this-procedure
     2635       (input -1
     2636       ,input true
     2637       ) .
     2638     return no-apply .
     2639   end.
     2640   on alt-down anywhere
     2641   do:
     2642     run diasize_change-height in this-procedure
     2643       (input 1
     2644       ,input true
     2645       ) .
     2646     return no-apply .
     2647   end.
     2648   on alt-up anywhere
     2649   do:
     2650     run diasize_change-height in this-procedure
     2651       (input -1
     2652       ,input true
     2653       ) .
     2654     return no-apply .
     2655   end.
     2656   on alt-enter of frame Dialog-Frame
     2657   do:
     2658     run diasize_maximize in this-procedure
     2659       (input  ?
     2660       ).
     2661     return no-apply .
     2662   end.
     2663   procedure diasize_end-move :
     2664     do
     2665     on error undo, return error return-value
     2666     :
     2667       define variable v-row-delta as decimal   no-undo .
     2668       define variable v-col-delta as decimal   no-undo .
     2669       define variable v-new-row as decimal   no-undo .
     2670       define variable v-new-col as decimal   no-undo .
     2671       assign
     2672         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2673         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2674       .
     2675       assign
     2676         v-row-delta = v-new-row - frame Dialog-Frame :height
     2677         v-col-delta = v-new-col - frame Dialog-Frame :width
     2678       .
     2679       run diasize_change-height in this-procedure
     2680         (input v-row-delta
     2681         ,input true
     2682         ) .
     2683       run diasize_change-width in this-procedure
     2684         (input v-col-delta
     2685         ,input true
     2686         ) .
     2687     end.
     2688   end procedure.
     2689   procedure diasize_maximize :
     2690     define input  parameter p-action as logical   no-undo .
     2691     do
     2692     on error undo, return error return-value
     2693     :
     2694       if p-action = ?
     2695       then do:
     2696         if v-diasize-need-maximize = true
     2697         then do:
     2698           assign
     2699             p-action = true
     2700           .
     2701         end.
     2702         else do:
     2703           assign
     2704             p-action = false
     2705           .
     2706         end.
     2707       end.
     2708       if p-action = true
     2709       then do:
     2710         run diasize_change-height in this-procedure
     2711           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2712               - frame Dialog-Frame :height-chars
     2713           ,input true
     2714           ) .
     2715         run diasize_change-width in this-procedure
     2716           (input session :width-chars
     2717               - frame Dialog-Frame :width-chars
     2718           ,input true
     2719           ) .
     2720         assign
     2721           v-diasize-need-maximize = false
     2722         .
     2723       end.
     2724       else do:
     2725         run diasize_change-width in this-procedure
     2726           (input v-diasize-orig-frame-width
     2727               - frame Dialog-Frame :width-chars
     2728           ,input true
     2729           ) .
     2730         run diasize_change-height in this-procedure
     2731           (input v-diasize-orig-frame-height
     2732               - frame Dialog-Frame :height-chars
     2733           ,input true
     2734           ) .
     2735         assign
     2736           v-diasize-need-maximize = true
     2737         .
     2738       end.
     2739     end.
     2740   end procedure.
     2741   procedure diasize_restore-orig-size :
     2742     do
     2743     on error undo, return error return-value
     2744     :
     2745       assign
     2746         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2747         v-diasize-current-frame-height = frame Dialog-Frame :height
     2748       .
     2749       run diasize_set-height in this-procedure
     2750         (input  v-diasize-orig-frame-height
     2751         ,input  true
     2752         ) .
     2753       run diasize_set-width in this-procedure
     2754         (input  v-diasize-orig-frame-width
     2755         ,input  true
     2756         ) .
     2757     end.
     2758   end procedure.
     2759   procedure diasize_restore-current-size :
     2760     do
     2761     on error undo, return error return-value
     2762     :
     2763       run diasize_set-height in this-procedure
     2764         (input  v-diasize-current-frame-height
     2765         ,input  true
     2766         ) .
     2767       run diasize_set-width in this-procedure
     2768         (input  v-diasize-current-frame-width
     2769         ,input  true
     2770         ) .
     2771     end.
     2772   end procedure.
     2773   procedure diasize_set-browse-handle :
     2774     define input  parameter p-browse-handle as handle   no-undo .
     2775     define buffer buf_temp-browse-handle for temp-browse-handle .
     2776     do
     2777     on error undo, return error return-value
     2778     :
     2779       assign
     2780         v-diasize-browse-handle = p-browse-handle
     2781       .
     2782       for each buf_temp-browse-handle
     2783       on error undo, return error return-value
     2784       :
     2785         delete buf_temp-browse-handle .
     2786       end.
     2787     end.
     2788   end procedure.
     2789   procedure diasize_add_browse :
     2790     define input  parameter p-browse-type   as character no-undo .
     2791     define input  parameter p-browse-handle as handle    no-undo .
     2792     define buffer buf_temp-browse-handle for temp-browse-handle .
     2793     do
     2794     on error undo, return error return-value
     2795     :
     2796       assign
     2797         v-diasize-browse-number = v-diasize-browse-number + 1
     2798       .
     2799       create buf_temp-browse-handle .
     2800       assign
     2801         buf_temp-browse-handle.browse-type   = p-browse-type
     2802         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2803         buf_temp-browse-handle.browse-handle = p-browse-handle
     2804       .
     2805     end.
     2806   end procedure.
     2807   procedure diasize_init :
     2808     define variable v-default-value    as logical   no-undo .
     2809     define variable v-restore-saved    as logical   no-undo .
     2810     define variable v-resize-value-str as character no-undo .
     2811     do
     2812     on error undo, return error return-value
     2813     :
     2814       do with frame Dialog-Frame
     2815       :
     2816         assign
     2817           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2818           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2819           v-diasize-browse-handle     = browse br-gds :handle
     2820         .
     2821         create button v-diasize-resize-button
     2822         assign
     2823           parent        = frame Dialog-Frame :first-child
     2824           label         = "s"
     2825           height-pixels = 16
     2826           width-pixels  = 16
     2827           visible       = true
     2828           sensitive     = true
     2829           movable       = true
     2830           triggers:
     2831             on end-move persistent run diasize_end-move in this-procedure .
     2832           end triggers.
     2833         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2834         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2835         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2836         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2837         assign
     2838           v-diasize-wndmax = false
     2839         .
     2840         if connected("ub") = true
     2841         then do:
     2842           define variable v-cntxt-db-num        as integer   no-undo .
     2843           define variable v-cntxt-userid        as character no-undo .
     2844           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2845                                             , OUTPUT v-cntxt-userid
     2846                                             ) .
     2847           run gbl/wndpar_r.p
     2848             (input  v-cntxt-db-num
     2849             ,input  v-cntxt-userid
     2850             ,input  'wndmax':U
     2851             ,output v-diasize-wndmax
     2852             ,output v-default-value
     2853             ) .
     2854         end.
     2855         assign
     2856           v-diasize-wndstore = false
     2857         .
     2858         if connected("ub") = true
     2859         then do:
     2860           run gbl/wndpar_r.p
     2861             (input  v-cntxt-db-num
     2862             ,input  v-cntxt-userid
     2863             ,input  'wndstore':U
     2864             ,output v-diasize-wndstore
     2865             ,output v-default-value
     2866             ) .
     2867         end.
     2868         assign
     2869           v-diasize-proc-name = entry(1, program-name(2), '.')
     2870         .
     2871         if v-diasize-wndstore = true
     2872         then do:
     2873           assign
     2874             v-restore-saved = false
     2875           .
     2876           if connected("ub") = true
     2877           then do:
     2878             run gbl/wndsizer.p
     2879               (input  v-cntxt-db-num
     2880               ,input  v-cntxt-userid
     2881               ,input  v-diasize-proc-name
     2882               ,input  'height':u
     2883               ,output v-resize-value-str
     2884               ) .
     2885             if v-resize-value-str <> '':U
     2886             then do:
     2887               run diasize_change-height in this-procedure
     2888                 (input  integer(v-resize-value-str)
     2889                 ,input  true
     2890                 ) .
     2891               assign
     2892                 v-restore-saved = true
     2893               .
     2894             end.
     2895           end.
     2896           if connected("ub") = true
     2897           then do:
     2898             run gbl/wndsizer.p
     2899               (input  v-cntxt-db-num
     2900               ,input  v-cntxt-userid
     2901               ,input  v-diasize-proc-name
     2902               ,input  'width':u
     2903               ,output v-resize-value-str
     2904               ) .
     2905             if v-resize-value-str <> '':U
     2906             then do:
     2907               run diasize_change-width in this-procedure
     2908                 (input  integer(v-resize-value-str)
     2909                 ,input  true
     2910                 ) .
     2911               assign
     2912                 v-restore-saved = true
     2913               .
     2914             end.
     2915           end.
     2916           if v-restore-saved <> true
     2917           then do:
     2918             if v-diasize-wndmax = true
     2919             then do:
     2920               run diasize_maximize in this-procedure
     2921                 (input  true
     2922                 ) .
     2923             end.
     2924           end.
     2925         end.
     2926         else do:
     2927           if v-diasize-wndmax = true
     2928           then do:
     2929             run diasize_maximize in this-procedure
     2930               (input  true
     2931               ) .
     2932           end.
     2933         end.
     2934       end.
     2935     end.
     2936   end procedure.
     2937   procedure diasize_need-full-display :
     2938     define output parameter p-need-full-display as logical   no-undo .
     2939     do
     2940     on error undo, return error return-value
     2941     :
     2942       assign
     2943         p-need-full-display = v-diasize-need-full-display
     2944       .
     2945       assign
     2946         v-diasize-need-full-display = false
     2947       .
     2948     end.
     2949   end procedure.
     2950   procedure get-context :
     2951      define output parameter p-db-num as integer          no-undo.
     2952      define output parameter p-user-id as character        no-undo.
     2953      define variable v-login               as character    no-undo.
     2954      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2955      define buffer buf_user-login  for ub.user-login .
     2956      do
     2957      on error undo, return error
     2958      :
     2959            FIND FIRST buf_sys-ctrl no-lock.
     2960            ASSIGN
     2961               v-login = USERID("ub")
     2962               p-db-num = buf_sys-ctrl.db-num
     2963            .
     2964            FIND FIRST buf_user-login
     2965                 WHERE buf_user-login.db-num = p-db-num
     2966                   AND buf_user-login.user-login = v-login
     2967                 no-lock
     2968                 no-error
     2969                 .
     2970            IF AVAILABLE buf_user-login
     2971            THEN DO:
     2972               assign
     2973                  p-user-id = buf_user-login.user-id
     2974               .
     2975            END.
     2976      end.
     2977   end procedure.
     2978       run diasize_init in this-procedure .
     2979   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2980   procedure rcps_get-profile-id :
     2981   define output parameter p-local-profile-id as integer no-undo .
     2982   do
     2983   on error undo, return error:
     2984   p-local-profile-id = p-profile-id.
     2985   end.
     2986   end procedure.
     2987   PROCEDURE rcps_fill-table :
     2988   define input parameter p-clear-params as logical no-undo .
     2989   if p-clear-params then do:
     2990   FOR EACH tt-rule-call-param:
     2991       DELETE tt-rule-call-param.
     2992   END.
     2993   end.
     2994    FOR EACH tt0-rule-call-param:
     2995      IF p-mode <> 'ДОБАВЛЕНИЕ':U THEN DO:
     2996        IF p-call-id <> '':U and p-call-id <> tt0-rule-call-param.call_id THEN do:
     2997           NEXT.
     2998        end.
     2999        IF p-codex-id <> 0 and p-codex-id <> tt0-rule-call-param.codex_id THEN do:
     3000          NEXT.
     3001        end.
     3002        IF p-ruleset-id <> 0 and p-ruleset-id <> tt0-rule-call-param.ruleset_id THEN do:
     3003          NEXT.
     3004        end.
     3005        IF p-rule-id <> 0 and p-rule-id <> tt0-rule-call-param.RULE_id THEN do:
     3006          NEXT.
     3007        end.
     3008        IF p-order-id <> ? and p-order-id <> tt0-rule-call-param.order_id THEN do:
     3009          NEXT.
     3010        end.
     3011      END.
     3012      if lookup("hidden", tt0-rule-call-param.param-3-data-type) > 0 then do:
     3013        next.
     3014      end.
     3015      IF p-list-mode = 'rp-rule-param':U
     3016      or p-list-mode = 'rp-rule-param':U  + chr(44) + 'все':U
     3017      THEN DO:
     3018         IF p-profile-id <> 0 AND p-profile-id <> tt0-rule-call-param.profile_id THEN do:
     3019           NEXT.
     3020         end.
     3021         IF p-once-more <> ? AND p-once-more <> tt0-rule-call-param.once-more THEN do:
     3022           NEXT.
     3023         end.
     3024      END.
     3025      CREATE tt-rule-call-param.
     3026      BUFFER-COPY tt0-rule-call-param TO tt-rule-call-param.
     3027   END.
     3028   END PROCEDURE.
     3029   procedure rcps_get-value :
     3030   DEFINE INPUT PARAMETER p-profile-id AS integer NO-UNDO.
     3031   DEFINE INPUT PARAMETER p-once-more AS integer NO-UNDO.
     3032   DEFINE INPUT PARAMETER p-call-id AS CHARACTER NO-UNDO.
     3033   DEFINE INPUT PARAMETER p-rp-param-name AS CHARACTER NO-UNDO.
     3034   DEFINE INPUT-output PARAMETER pp-index AS integer NO-UNDO.
     3035   DEFINE output parameter p-value-character AS CHARACTER NO-UNDO.
     3036   DEFINE output parameter p-value-date AS date NO-UNDO.
     3037   DEFINE output parameter p-value-decimal AS decimal NO-UNDO.
     3038   DEFINE output parameter p-value-integer AS integer NO-UNDO.
     3039   DEFINE output parameter p-value-logical AS logical NO-UNDO.
     3040   define variable v-current-index as integer no-undo init -1.
     3041   define variable v-start as logical no-undo init yes.
     3042   DEFINE BUFFER buf_ruledict-param FOR ub.ruledict-param.
     3043   DEFINE BUFFER buf_rp-rule-param FOR ub.rp-rule-param.
     3044   DEFINE BUFFER buf_tt-rule-call-param FOR tt-rule-call-param.
     3045   DEFINE BUFFER buf_term_tt-rule-call-param FOR tt-rule-call-param.
     3046   do
     3047   on error undo, return error
     3048   :
     3049   FOR FIRST buf_rp-rule-param WHERE
     3050         buf_rp-rule-param.profile_id = p-profile-id
     3051     AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     3052   , each buf_tt-rule-call-param WHERE
     3053      buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3054   AND buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3055   AND buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3056   AND buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     3057   AND buf_tt-rule-call-param.p-index >= pp-index
     3058    ,each buf_term_tt-rule-call-param where
     3059          buf_term_tt-rule-call-param.call_id = buf_tt-rule-call-param.call_id
     3060      and buf_term_tt-rule-call-param.codex_id = buf_tt-rule-call-param.codex_id
     3061      and buf_term_tt-rule-call-param.ruleset_id = buf_tt-rule-call-param.ruleset_id
     3062      and buf_term_tt-rule-call-param.order_id = buf_tt-rule-call-param.order_id
     3063      and buf_term_tt-rule-call-param.param-name = buf_tt-rule-call-param.param-name
     3064      and buf_term_tt-rule-call-param.p-index = buf_tt-rule-call-param.p-index
     3065     by buf_term_tt-rule-call-param.call_id
     3066     by buf_term_tt-rule-call-param.codex_id
     3067     by buf_term_tt-rule-call-param.ruleset_id
     3068     by buf_term_tt-rule-call-param.order_id
     3069     by buf_term_tt-rule-call-param.param-name
     3070     by buf_term_tt-rule-call-param.p-index :
     3071       if v-start
     3072       then do:
     3073         assign
     3074         pp-index = buf_term_tt-rule-call-param.p-index
     3075         p-value-character = buf_term_tt-rule-call-param.param-value-character
     3076         p-value-date      = buf_term_tt-rule-call-param.param-value-date
     3077         p-value-decimal   = buf_term_tt-rule-call-param.param-value-decimal
     3078         p-value-integer   = buf_term_tt-rule-call-param.param-value-integer
     3079         p-value-logical   = buf_term_tt-rule-call-param.param-value-logical
     3080         v-start = no
     3081         .
     3082       end.
     3083       else do:
     3084         if buf_term_tt-rule-call-param.p-index > pp-index then do:
     3085           v-current-index = buf_term_tt-rule-call-param.p-index.
     3086           leave.
     3087         end.
     3088             end.
     3089     end.
     3090     pp-index = v-current-index.
     3091   end.
     3092   end procedure.
     3093   PROCEDURE rcps_proc-b-add :
     3094   DEFINE INPUT PARAMETER p-profile-id AS integer NO-UNDO.
     3095   DEFINE INPUT PARAMETER p-once-more AS integer NO-UNDO.
     3096   DEFINE INPUT PARAMETER p-call-id AS CHARACTER NO-UNDO.
     3097   DEFINE INPUT PARAMETER p-rp-param-name AS CHARACTER NO-UNDO.
     3098   DEFINE INPUT PARAMETER p-index AS integer NO-UNDO.
     3099   define variable v-ind as integer no-undo .
     3100   define buffer buf_tt-rule-call-param for tt-rule-call-param.
     3101   define buffer buf0_tt-rule-call-param for tt-rule-call-param.
     3102   define buffer buf2_tt-rule-call-param for tt-rule-call-param.
     3103   define buffer buf_rp-rule-param for ub.rp-rule-param.
     3104   FOR FIRST buf_rp-rule-param WHERE
     3105             buf_rp-rule-param.profile_id = p-profile-id
     3106         AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     3107       , first buf0_tt-rule-call-param WHERE
     3108          buf0_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3109      AND buf0_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3110      AND buf0_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3111      AND buf0_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name:
     3112     LEAVE.
     3113   END.
     3114   IF NOT AVAILABLE buf0_tt-rule-call-param THEN do:
     3115     BELL.
     3116     RETURN.
     3117   END.
     3118   for each buf_rp-rule-param where
     3119           buf_rp-rule-param.rp-param-name = p-rp-param-name
     3120       and buf_rp-rule-param.profile_id = p-profile-id,
     3121       first buf_tt-rule-call-param where
     3122           buf_tt-rule-call-param.call_id = buf0_tt-rule-call-param.call_id
     3123       and buf_tt-rule-call-param.profile_id = buf_rp-rule-param.profile_id
     3124       and buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3125       and buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3126       and buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3127       and buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     3128       and buf_tt-rule-call-param.once-more = buf0_tt-rule-call-param.once-more
     3129       and buf_tt-rule-call-param.p-index = p-index:
     3130     RETURN.
     3131   END.
     3132   IF lookup("LIST", buf0_tt-rule-call-param.param-3-data-type) = 0
     3133   and lookup("SORTED-LIST", buf0_tt-rule-call-param.param-3-data-type) = 0
     3134   THEN DO:
     3135     BELL.
     3136     RETURN.
     3137   END.
     3138   IF buf0_tt-rule-call-param.p-index <> 0 THEN DO:
     3139     BELL.
     3140     RETURN.
     3141   END.
     3142   find last buf_tt-rule-call-param where
     3143            buf_tt-rule-call-param.call_id = buf0_tt-rule-call-param.call_id
     3144        and buf_tt-rule-call-param.codex_id = buf0_tt-rule-call-param.codex_id
     3145        and buf_tt-rule-call-param.ruleset_id = buf0_tt-rule-call-param.ruleset_id
     3146        and buf_tt-rule-call-param.order_id = buf0_tt-rule-call-param.order_id
     3147        and buf_tt-rule-call-param.param-name = buf0_tt-rule-call-param.param-name no-error .
     3148   if available buf_tt-rule-call-param
     3149   and (lookup("LIST", buf_tt-rule-call-param.param-3-data-type) > 0
     3150        or
     3151        lookup("SORTED-LIST", buf_tt-rule-call-param.param-3-data-type) > 0
     3152        )
     3153   and buf_tt-rule-call-param.p-index > 0 then do:
     3154     v-ind = buf_tt-rule-call-param.p-index.
     3155   end.
     3156   for each buf_rp-rule-param where
     3157           buf_rp-rule-param.rp-param-name = p-rp-param-name
     3158       and buf_rp-rule-param.profile_id = p-profile-id,
     3159       first buf_tt-rule-call-param where
     3160           buf_tt-rule-call-param.call_id = buf0_tt-rule-call-param.call_id
     3161       and buf_tt-rule-call-param.profile_id = buf_rp-rule-param.profile_id
     3162       and buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3163       and buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3164       and buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3165       and buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     3166       and buf_tt-rule-call-param.once-more = buf0_tt-rule-call-param.once-more
     3167       and buf_tt-rule-call-param.p-index = 0
     3168   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3169   on stop   undo, return error substitute( "&1. stop", vss-workfile )
     3170   on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     3171   :
     3172     create buf2_tt-rule-call-param.
     3173     buffer-copy buf_tt-rule-call-param
     3174     except p-index
     3175     to buf2_tt-rule-call-param
     3176     assign
     3177     buf2_tt-rule-call-param.p-index = v-ind + 1
     3178     .
     3179   end.
     3180   END PROCEDURE.
     3181   PROCEDURE rcps_proc-b-del :
     3182   DEFINE INPUT PARAMETER p-profile-id AS integer NO-UNDO.
     3183   DEFINE INPUT PARAMETER p-once-more AS integer NO-UNDO.
     3184   DEFINE INPUT PARAMETER p-call-id AS CHARACTER NO-UNDO.
     3185   DEFINE INPUT PARAMETER p-rp-param-name AS CHARACTER NO-UNDO.
     3186   DEFINE INPUT PARAMETER pp-index AS integer NO-UNDO.
     3187   define variable v-ind as integer no-undo .
     3188   define variable v-once-more as integer no-undo .
     3189   define variable v-call-id as character no-undo .
     3190   define buffer buf0_tt-rule-call-param for tt-rule-call-param.
     3191   define buffer buf_tt-rule-call-param for tt-rule-call-param.
     3192   define buffer buf_rp-rule-param for ub.rp-rule-param.
     3193   if pp-index = 0 then do:
     3194     undo, return error substitute("Нельзя удалять корневой параметр &1 (индекс = 0)", p-rp-param-name).
     3195   end.
     3196   FOR first buf_rp-rule-param WHERE
     3197             buf_rp-rule-param.profile_id = p-profile-id
     3198         AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     3199       , first buf0_tt-rule-call-param WHERE
     3200          buf0_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3201      AND buf0_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3202      AND buf0_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3203      AND buf0_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     3204      AND buf0_tt-rule-call-param.p-index = pp-index
     3205      :
     3206     LEAVE.
     3207   END.
     3208   IF NOT AVAILABLE buf0_tt-rule-call-param THEN do:
     3209     FOR first buf_rp-rule-param WHERE
     3210               buf_rp-rule-param.profile_id = p-profile-id
     3211           AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     3212         , last buf0_tt-rule-call-param WHERE
     3213           buf0_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3214       AND buf0_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3215       AND buf0_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3216       AND buf0_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     3217       AND buf0_tt-rule-call-param.p-index > pp-index :
     3218       leave.
     3219     end.
     3220     IF NOT AVAILABLE buf0_tt-rule-call-param THEN do:
     3221     return "not-found".
     3222     end.
     3223     else do:
     3224       return ''.
     3225     end.
     3226   END.
     3227   IF lookup("LIST", buf0_tt-rule-call-param.param-3-data-type) = 0
     3228   and lookup("SORTED-LIST", buf0_tt-rule-call-param.param-3-data-type) = 0
     3229   THEN DO:
     3230     undo, return error substitute("Можно удалять только параметры типа LIST и SORTED-LIST").
     3231   END.
     3232   IF lookup("READ-ONLY", buf0_tt-rule-call-param.param-3-data-type) > 0 THEN DO:
     3233     undo, return error substitute("Нельзя удалять  параметры типа READ-ONLY").
     3234   END.
     3235   for each buf_rp-rule-param where
     3236           buf_rp-rule-param.rp-param-name = buf_rp-rule-param.rp-param-name
     3237       and buf_rp-rule-param.profile_id = buf_rp-rule-param.profile_id,
     3238       each buf_tt-rule-call-param where
     3239           buf_tt-rule-call-param.call_id = p-call-id
     3240       and buf_tt-rule-call-param.profile_id = buf_rp-rule-param.profile_id
     3241       and buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3242       and buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3243       and buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3244       and buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     3245       and buf_tt-rule-call-param.once-more = p-once-more
     3246       and buf_tt-rule-call-param.p-index = pp-index
     3247   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3248   on stop   undo, return error substitute( "&1. stop", vss-workfile )
     3249   on endkey undo, return error substitute( "&1. endkey", vss-workfile ):
     3250       DELETE buf_tt-rule-call-param.
     3251   end.
     3252   return ''.
     3253   END PROCEDURE.
     3254   PROCEDURE rcps_proc-save0 :
     3255   FOR EACH tt-rule-call-param
     3256   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3257   on stop   undo , return error substitute( "&1. stop", vss-workfile )
     3258   on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     3259   :
     3260      find  FIRST tt0-rule-call-param NO-LOCK WHERE
     3261               tt0-rule-call-param.codex_id = tt-rule-call-param.codex_id
     3262          AND  tt0-rule-call-param.ruleset_id = tt-rule-call-param.ruleset_id
     3263          AND tt0-rule-call-param.call_id = tt-rule-call-param.call_id
     3264          AND tt0-rule-call-param.order_id = tt-rule-call-param.order_id
     3265          AND tt0-rule-call-param.param-name = tt-rule-call-param.param-name
     3266          AND tt0-rule-call-param.p-index = tt-rule-call-param.p-index no-error .
     3267      if not available tt0-rule-call-param
     3268      and (lookup("LIST", tt-rule-call-param.param-3-data-type) > 0
     3269           OR
     3270           lookup("SORTED-LIST", tt-rule-call-param.param-3-data-type) > 0
     3271           )
     3272      and tt-rule-call-param.p-index > 0 then do:
     3273        create tt0-rule-call-param.
     3274      end.
     3275      BUFFER-COPY tt-rule-call-param TO tt0-rule-call-param.
     3276   END.
     3277   FOR EACH tt0-rule-call-param
     3278   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3279   on stop   undo , return error substitute( "&1. stop", vss-workfile )
     3280   on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     3281   :
     3282     if tt0-rule-call-param.p-index = 0 then next.
     3283     if lookup("hidden", tt0-rule-call-param.param-3-data-type) > 0 then next.
     3284     find  FIRST tt-rule-call-param NO-LOCK WHERE
     3285             tt-rule-call-param.codex_id = tt0-rule-call-param.codex_id
     3286         AND tt-rule-call-param.ruleset_id = tt0-rule-call-param.ruleset_id
     3287         AND tt-rule-call-param.call_id = tt0-rule-call-param.call_id
     3288         AND tt-rule-call-param.order_id = tt0-rule-call-param.order_id
     3289         AND tt-rule-call-param.param-name = tt0-rule-call-param.param-name
     3290         AND tt-rule-call-param.p-index = tt0-rule-call-param.p-index no-error .
     3291     if not available tt-rule-call-param
     3292     and (lookup("LIST", tt0-rule-call-param.param-3-data-type) > 0
     3293         OR
     3294         lookup("SORTED-LIST", tt0-rule-call-param.param-3-data-type) > 0
     3295         )
     3296     and tt0-rule-call-param.p-index > 0
     3297     then do:
     3298        IF p-call-id <> '':U and p-call-id <> tt0-rule-call-param.call_id THEN do:
     3299           NEXT.
     3300        end.
     3301        IF p-codex-id <> 0 and p-codex-id <> tt0-rule-call-param.codex_id THEN do:
     3302          NEXT.
     3303        end.
     3304        IF p-ruleset-id <> 0 and p-ruleset-id <> tt0-rule-call-param.ruleset_id THEN do:
     3305          NEXT.
     3306        end.
     3307        IF p-rule-id <> 0 and p-rule-id <> tt0-rule-call-param.RULE_id THEN do:
     3308          NEXT.
     3309        end.
     3310        IF p-order-id <> ? and p-order-id <> tt0-rule-call-param.order_id THEN do:
     3311          NEXT.
     3312        end.
     3313       IF p-list-mode = 'rp-rule-param':U
     3314       or p-list-mode = 'rp-rule-param':U  + chr(44) + 'все':U
     3315       THEN DO:
     3316         IF p-profile-id <> 0 AND p-profile-id <> tt0-rule-call-param.profile_id THEN do:
     3317           NEXT.
     3318         end.
     3319         IF p-once-more <> ? AND p-once-more <> tt0-rule-call-param.once-more THEN do:
     3320           NEXT.
     3321         end.
     3322       end.
     3323       delete tt0-rule-call-param.
     3324     end.
     3325   end.
     3326   END PROCEDURE.
     3327   PROCEDURE rcps_set-value :
     3328   DEFINE INPUT PARAMETER p-profile-id AS integer NO-UNDO.
     3329   DEFINE INPUT PARAMETER p-once-more AS integer NO-UNDO.
     3330   DEFINE INPUT PARAMETER p-call-id AS CHARACTER NO-UNDO.
     3331   DEFINE INPUT PARAMETER p-rp-param-name AS CHARACTER NO-UNDO.
     3332   DEFINE INPUT PARAMETER pp-index AS integer NO-UNDO.
     3333   DEFINE INPUT parameter p-value-character AS CHARACTER NO-UNDO.
     3334   DEFINE INPUT parameter p-value-date AS date NO-UNDO.
     3335   DEFINE INPUT parameter p-value-decimal AS decimal NO-UNDO.
     3336   DEFINE INPUT parameter p-value-integer AS integer NO-UNDO.
     3337   DEFINE INPUT parameter p-value-logical AS logical NO-UNDO.
     3338   DEFINE VARIABLE v-codex-id AS integer NO-UNDO.
     3339   DEFINE VARIABLE v-ruleset-id AS integer NO-UNDO.
     3340   DEFINE VARIABLE v-order-id AS integer NO-UNDO.
     3341   DEFINE VARIABLE V-param-name AS character NO-UNDO.
     3342   define variable v-found as logical no-undo .
     3343   DEFINE BUFFER buf_tt-rule-call-param FOR tt-rule-call-param.
     3344   DEFINE BUFFER buf_rp-rule-param FOR ub.rp-rule-param.
     3345   FOR FIRST buf_rp-rule-param WHERE
     3346             buf_rp-rule-param.profile_id = p-profile-id
     3347         AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     3348       , first buf_tt-rule-call-param WHERE
     3349          buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3350      AND buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3351      AND buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3352      AND buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name:
     3353     ASSIGN
     3354     v-codex-id = buf_tt-rule-call-param.codex_id
     3355     v-ruleset-id = buf_tt-rule-call-param.ruleset_id
     3356     v-order-id = buf_tt-rule-call-param.order_id
     3357     V-PARAM-NAME = buf_tt-rule-call-param.PARAM-NAME
     3358     .
     3359     LEAVE.
     3360   END.
     3361   CASE p-list-mode:
     3362     WHEN 'rp-rule-param':U THEN DO:
     3363       if pp-index > 0
     3364       then do:
     3365         FOR EACH  buf_rp-rule-param NO-LOCK where
     3366             buf_rp-rule-param.profile_id = p-profile-id
     3367             AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     3368             ,EACH buf_tt-rule-call-param WHERE
     3369                 buf_tt-rule-call-param.profile_id = p-profile-id
     3370             AND buf_tt-rule-call-param.once-more = p-once-more
     3371             AND buf_tt-rule-call-param.call_id = p-CALL-id
     3372             AND buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3373             AND buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3374             AND buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3375             AND buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     3376             AND buf_tt-rule-call-param.p-index = pp-index
     3377         ON error undo, return error :
     3378           v-found = yes.
     3379         end.
     3380       end.
     3381       if not v-found then do:
     3382         run rcps_proc-b-add in this-procedure (
     3383                                                  input p-profile-id
     3384                                                 ,input p-once-more
     3385                                                 ,input p-call-id
     3386                                                 ,
     3387                                                  input p-rp-param-name
     3388                                                 ,input pp-index).
     3389       end.
     3390       FOR EACH  buf_rp-rule-param NO-LOCK where
     3391           buf_rp-rule-param.profile_id = p-profile-id
     3392           AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     3393           ,EACH buf_tt-rule-call-param WHERE
     3394               buf_tt-rule-call-param.profile_id = p-profile-id
     3395           AND buf_tt-rule-call-param.once-more = p-once-more
     3396           AND buf_tt-rule-call-param.call_id = p-CALL-id
     3397           AND buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3398           AND buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3399           AND buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3400           AND buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     3401           AND buf_tt-rule-call-param.p-index = pp-index
     3402         ON error undo, return error :
     3403         assign
     3404         buf_tt-rule-call-param.param-value-character = p-value-character
     3405         buf_tt-rule-call-param.param-value-date      = p-value-date
     3406         buf_tt-rule-call-param.param-value-decimal   = p-value-decimal
     3407         buf_tt-rule-call-param.param-value-integer   = p-value-integer
     3408         buf_tt-rule-call-param.param-value-logical   = p-value-logical
     3409         .
     3410       END.
     3411     END.
     3412     WHEN 'rule-call-param':U THEN DO:
     3413       FIND FIRST buf_tt-rule-call-param WHERE
     3414           buf_tt-rule-call-param.call_id = p-call-id
     3415       AND buf_tt-rule-call-param.codex_id = v-codex-id
     3416       AND buf_tt-rule-call-param.ruleset_id = v-ruleset-id
     3417       AND buf_tt-rule-call-param.order_id = v-order-id
     3418       AND buf_tt-rule-call-param.param-name = V-PARAM-NAME
     3419       AND buf_tt-rule-call-param.p-index = pp-index.
     3420       assign
     3421       buf_tt-rule-call-param.param-value-character = p-value-character
     3422       buf_tt-rule-call-param.param-value-date      = p-value-date
     3423       buf_tt-rule-call-param.param-value-decimal   = p-value-decimal
     3424       buf_tt-rule-call-param.param-value-integer   = p-value-integer
     3425       buf_tt-rule-call-param.param-value-logical   = p-value-logical
     3426       .
     3427     END.
     3428   END CASE.
     3429   END PROCEDURE.
     3430   procedure rcps_get-rule-on-off :
     3431   define input parameter p-codex-id as integer no-undo .
     3432   define input parameter p-ruleset-id as integer no-undo .
     3433   define input parameter p-rule-id as integer no-undo .
     3434   define input parameter p-profile-id as integer no-undo .
     3435   define input parameter p-once-more as integer no-undo .
     3436   define output parameter p-on-off as logical no-undo .
     3437   if valid-handle(p-call-handle)
     3438   and lookup("rcpscont_get-rule-on-off", p-call-handle:internal-entries) > 0 then do:
     3439     run rcpscont_get-rule-on-off in p-call-handle (
     3440                                              input p-codex-id
     3441                                             ,input p-ruleset-id
     3442                                             ,input p-rule-id
     3443                                             ,input p-profile-id
     3444                                             ,input p-once-more
     3445                                             ,output p-on-off) no-error.
     3446   end.
     3447   end procedure.
     3448   procedure rcps_set-rule-on-off :
     3449   define input parameter p-codex-id as integer no-undo .
     3450   define input parameter p-ruleset-id as integer no-undo .
     3451   define input parameter p-rule-id as integer no-undo .
     3452   define input parameter p-profile-id as integer no-undo .
     3453   define input parameter p-once-more as integer no-undo .
     3454   define input parameter p-on-off as logical no-undo .
     3455   if valid-handle(p-call-handle)
     3456   and lookup("rcpscont_get-rule-on-off", p-call-handle:internal-entries) > 0 then do:
     3457     run rcpscont_set-rule-on-off in p-call-handle (
     3458                                              input p-codex-id
     3459                                             ,input p-ruleset-id
     3460                                             ,input p-rule-id
     3461                                             ,input p-profile-id
     3462                                             ,input p-once-more
     3463                                             ,input p-on-off) no-error.
     3464   end.
     3465   end procedure.
     3466   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3467   PROCEDURE rcps_MyEnable0 :
     3468   DEFINE VARIABLE v-ii AS INTEGER NO-UNDO.
     3469   DEFINE VARIABLE v-ch0 AS widget-handle NO-UNDO.
     3470   ASSIGN
     3471   term_tt-rule-call-param.param-label:RESIZABLE IN browse br-rcp = YES
     3472   X_rp-rule-param.rp-param-name:RESIZABLE IN browse br-rcp = YES
     3473   .
     3474   ASSIGN
     3475   v-ch0 = br-rcp:FIRST-COLUMN IN FRAME Dialog-Frame.
     3476   REPEAT WHILE valid-handle(v-ch0):
     3477      IF v-ch0:LABEL = "Значение!(строковое)" THEN DO:
     3478        v-ch[1] = v-ch0.
     3479        v-ch0:VISIBLE = NO.
     3480      END.
     3481      IF v-ch0:LABEL = "Значение!(Дата)" THEN DO:
     3482        v-ch[2] = v-ch0.
     3483        v-ch0:VISIBLE = NO.
     3484      END.
     3485      IF v-ch0:LABEL = "Значение!(Десятичное)" THEN DO:
     3486        v-ch[3] = v-ch0.
     3487        v-ch0:VISIBLE = NO.
     3488      END.
     3489      IF v-ch0:LABEL = "Значение!(Целое)" THEN DO:
     3490        v-ch[4] = v-ch0.
     3491        v-ch0:VISIBLE = NO.
     3492      END.
     3493      IF v-ch0:LABEL = "Значение!(Логическое)" THEN DO:
     3494        v-ch[5] = v-ch0.
     3495        v-ch0:VISIBLE = NO.
     3496      END.
     3497      IF v-ch0:LABEL = "Точка вызова" THEN DO:
     3498        v-ch[6] = v-ch0.
     3499      END.
     3500      IF v-ch0:LABEL = "Значение" THEN
     3501      v-ch0:RESIZABLE = YES.
     3502      v-ch0 = v-ch0:NEXT-COLUMN.
     3503   END.
     3504   assign
     3505   X_rp-rule-param.rp-param-name:resizable in browse br-rcp = yes
     3506   term_tt-rule-call-param.param-name:resizable in browse br-rcp = yes
     3507   term_tt-rule-call-param.param-label:resizable in browse br-rcp = yes
     3508   .
     3509   CASE p-list-mode:
     3510     WHEN 'rule-call-param':U THEN DO:
     3511        ASSIGN
     3512        X_rp-rule-param.rp-param-name:VISIBLE IN BROWSE br-rcp = NO
     3513        .
     3514     END.
     3515     WHEN 'rp-rule-param':U
     3516     or
     3517     when 'rp-rule-param':U + chr(44) + 'все':U
     3518     THEN DO:
     3519       assign
     3520       term_tt-rule-call-param.codex_id:VISIBLE IN BROWSE br-rcp = NO
     3521       term_tt-rule-call-param.ruleset_id:VISIBLE IN BROWSE br-rcp = NO
     3522       term_tt-rule-call-param.rule_id:VISIBLE IN BROWSE br-rcp = NO
     3523       term_tt-rule-call-param.order_id:VISIBLE IN BROWSE br-rcp = NO
     3524       term_tt-rule-call-param.param-name:VISIBLE IN BROWSE br-rcp = NO
     3525       term_tt-rule-call-param.param-num:VISIBLE IN BROWSE br-rcp = NO
     3526       .
     3527     END.
     3528   END CASE.
     3529    IF p-call-id <> '':U THEN DO:
     3530      v-ch[6]:VISIBLE = NO.
     3531    END.
     3532     IF p-profile-id <> 0 THEN DO:
     3533      term_tt-rule-call-param.profile_id :VISIBLE IN BROWSE br-rcp= NO.
     3534    END.
     3535     IF p-rule-id <> 0 THEN DO:
     3536      term_tt-rule-call-param.RULE_id :VISIBLE IN BROWSE br-rcp= NO.
     3537    END.
     3538     IF p-once-more <> 0 THEN DO:
     3539      term_tt-rule-call-param.once-more :VISIBLE IN BROWSE br-rcp= NO.
     3540    END.
     3541   END PROCEDURE.
     3542   PROCEDURE rcps_Openbr :
     3543   CASE p-list-mode:
     3544     WHEN 'rp-rule-param':U THEN DO:
     3545         OPEN QUERY br-rcp
     3546         FOR EACH  X_ruledict-param NO-LOCK WHERE X_ruledict-param.entry-id = v-rcps-entry-id
     3547             ,FIRST X_rp-rule-param WHERE
     3548                 X_rp-rule-param.profile_id = p-profile-id
     3549             AND X_rp-rule-param.rp-param-name = X_ruledict-param.param-name
     3550           , first tt-rule-call-param WHERE
     3551              tt-rule-call-param.codex_id = X_rp-rule-param.codex_id
     3552          AND tt-rule-call-param.ruleset_id = X_rp-rule-param.ruleset_id
     3553          AND tt-rule-call-param.rule_id = X_rp-rule-param.rule_id
     3554          AND tt-rule-call-param.param-name = X_rp-rule-param.rule-param-name
     3555            ,each term_tt-rule-call-param where
     3556                  term_tt-rule-call-param.call_id = tt-rule-call-param.call_id
     3557              and term_tt-rule-call-param.codex_id = tt-rule-call-param.codex_id
     3558              and term_tt-rule-call-param.ruleset_id = tt-rule-call-param.ruleset_id
     3559              and term_tt-rule-call-param.order_id = tt-rule-call-param.order_id
     3560              and term_tt-rule-call-param.param-name = tt-rule-call-param.param-name
     3561         BY tt-rule-call-param.call_id
     3562         BY tt-rule-call-param.codex_id
     3563         BY tt-rule-call-param.ruleset_id
     3564         BY tt-rule-call-param.order_id
     3565         BY tt-rule-call-param.param-num.
     3566     END.
     3567   END CASE.
     3568   apply "ENTRY" to br-rcp in frame Dialog-Frame .
     3569   APPLy "VALUE-CHANGED" to br-rcp.
     3570   END PROCEDURE.
     3571   PROCEDURE rcps_proc-b-chg PRIVATE :
     3572   DEFINE VARIABLE v-rec1 AS Rowid NO-UNDO.
     3573   DEFINE VARIABLE v-rec2 AS Rowid NO-UNDO.
     3574   DEFINE VARIABLE v-rec3 AS Rowid NO-UNDO.
     3575   DEFINE VARIABLE v-rec4 AS Rowid NO-UNDO.
     3576   define variable v-param-data-type as character no-undo .
     3577   define variable v-rid-list as character no-undo .
     3578   IF NOT AVAILABLE TERM_tt-rule-call-param  THEN DO:
     3579     RETURN ERROR.
     3580   END.
     3581   ASSIGN
     3582   v-rec1 = rowid(X_ruledict-param)
     3583   v-rec2 = rowid(X_rp-rule-param)
     3584   v-rec3 = Rowid(tt-rule-call-param)
     3585   v-rec4 = Rowid(term_tt-rule-call-param)
     3586   .
     3587   run rcps_openbr in this-procedure .
     3588   REPOSITION br-rcp TO Rowid v-rec1, v-rec2,v-rec3, v-rec4 NO-ERROR.
     3589   IF ERROR-STATUS:ERROR THEN DO:
     3590     REPOSITION br-rcp TO ROW 1 NO-ERROR.
     3591   END.
     3592   APPLY "ENTRY" TO br-rcp in frame Dialog-Frame .
     3593   APPLY "VALUE-CHANGED" TO br-rcp in frame Dialog-Frame .
     3594   END PROCEDURE.
     3595   PROCEDURE rcps_set-row-color :
     3596   DEFINE INPUT PARAMETER p-data-type AS CHARACTER NO-UNDO.
     3597   ASSIGN
     3598   v-ch[1]:FGCOLOR = GREY_COLOR
     3599   v-ch[1]:BGCOLOR = GREY_Color
     3600   v-ch[1]:PFCOLOR = GREY_Color
     3601   v-ch[2]:FGCOLOR = GREY_COLOR
     3602   v-ch[2]:BGCOLOR = GREY_Color
     3603   v-ch[2]:PFCOLOR = GREY_Color
     3604   v-ch[3]:FGCOLOR = GREY_COLOR
     3605   v-ch[3]:BGCOLOR = GREY_Color
     3606   v-ch[3]:PFCOLOR = GREY_Color
     3607   v-ch[4]:FGCOLOR = GREY_COLOR
     3608   v-ch[4]:BGCOLOR = GREY_Color
     3609   v-ch[4]:PFCOLOR = GREY_Color
     3610   v-ch[5]:FGCOLOR = GREY_COLOR
     3611   v-ch[5]:BGCOLOR = GREY_Color
     3612   v-ch[5]:PFCOLOR = GREY_Color
     3613   .
     3614   CASE entry(1, p-data-type):
     3615        WHEN 'character':U THEN DO:
     3616         ASSIGN
     3617         v-ch[1]:FGCOLOR = BLACK_COLOR
     3618         v-ch[1]:BGCOLOR = WHITE_Color.
     3619       END.
     3620       WHEN 'decimal':U THEN DO:
     3621         ASSIGN
     3622         v-ch[3]:FGCOLOR = BLACK_COLOR
     3623         v-ch[3]:BGCOLOR = WHITE_Color.
     3624       END.
     3625       WHEN 'integer':U THEN DO:
     3626         ASSIGN
     3627         v-ch[4]:FGCOLOR = BLACK_COLOR
     3628         v-ch[4]:BGCOLOR = WHITE_Color.
     3629       END.
     3630       WHEN 'date':U THEN DO:
     3631         ASSIGN
     3632         v-ch[2]:FGCOLOR = BLACK_COLOR
     3633         v-ch[2]:BGCOLOR = WHITE_Color.
     3634        END.
     3635        WHEN 'logical':U THEN DO:
     3636          ASSIGN
     3637          v-ch[5]:FGCOLOR = BLACK_COLOR
     3638          v-ch[5]:BGCOLOR = WHITE_Color.
     3639        END.
     3640   END CASE.
     3641   END PROCEDURE.
     3642   MAIN-BLOCK:
     3643   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3644      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3645   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3646     run mainmenu_getcntxt in parparentproc
     3647       (output v-cntxt-db-num
     3648       ,output v-cntxt-userid
     3649       ,output v-cntxt-level
     3650       ,output v-cntxt-host-code-obj
     3651       ,output v-cntxt-obj-type
     3652       ,output v-cntxt-obj-code
     3653       ,output v-cntxt-db-num-obj
     3654       ,output v-cntxt-is-admin
     3655       ) .
     3656      run gbl/dftempl.p ( input 'rp-rule-param':U
     3657                        , output v-dflt-rec) no-error.
     3658       if error-status:error then dO:
     3659         message
     3660         vss-workfile vss-revision vss-description skip
     3661         "Невозможно найти recid template записи в таблице rp-rule-param"
     3662         view-as alert-box error .
     3663         return error.
     3664       end.
     3665       run gbl/dftempl.p ( input 'ruledict-param':U
     3666                         , output v-rp-dflt-rec) no-error.
     3667        if error-status:error then dO:
     3668          message
     3669          vss-workfile vss-revision vss-description skip
     3670          "Невозможно найти recid template записи в таблице ruledict-param"
     3671          view-as alert-box error .
     3672          return error.
     3673        end.
     3674     IF p-list-mode = 'rp-rule-param':U
     3675     THEN DO:
     3676       FIND FIRST buf_rule-profile NO-LOCK WHERE
     3677                 buf_rule-profile.profile_id = p-profile-id.
     3678       run gen-key-rec in this-procedure ( input 'rule-profile':U
     3679                                       ,input buffer buf_rule-profile:handle
     3680                                       ,output v-uniq-key-rec).
     3681       FIND FIRST buf_ruledict NO-LOCK WHERE
     3682                 buf_ruledict.entry-type = 'rule-profile':U
     3683          AND  buf_ruledict.uniq-key-rec = v-uniq-key-rec.
     3684       v-rcps-entry-id = buf_ruledict.entry-id.
     3685     END.
     3686     ELSE DO:
     3687        MESSAGE
     3688        substitute("Неверное значение параметра p-list-mode=&1", p-list-mode)
     3689        VIEW-AS alert-box.
     3690     END.
     3691     if p-call-id begins 'schedule':U then do:
     3692       v-running-mode = yes.
     3693     end.
     3694     RUN rcps_fill-table IN THIS-PROCEDURE ( input yes).
     3695     RUN Myenable in THIS-PROCEDURE.
     3696     WAIT-FOR GO OF FRAME Dialog-Frame.
     3697   END.
     3698   RUN disable_UI.
     3699   PROCEDURE disable_UI :
     3700     HIDE FRAME Dialog-Frame.
     3701   END PROCEDURE.
     3702   PROCEDURE enable_UI :
     3703     DISPLAY t-rule-gds t-add-gds-discnts t-rule-subtotal t-add-subtotal-discnts
     3704             t-rule-pay t-add-pay-discnts
     3705         WITH FRAME Dialog-Frame.
     3706     ENABLE B-exit b-quit b-gds-add b-gds-delete B-Help br-gds t-rule-gds
     3707            t-add-gds-discnts B-gds-up B-gds-down b-subtotal-add b-subtotal-delete
     3708            t-rule-subtotal br-subtotal t-add-subtotal-discnts B-subtotal-up
     3709            B-subtotal-down b-pay-add b-pay-delete t-rule-pay br-pay B-pay-up
     3710            t-add-pay-discnts B-pay-down BR-rcp
     3711         WITH FRAME Dialog-Frame.
     3712     VIEW FRAME Dialog-Frame.
     3713   END PROCEDURE.
     3714   PROCEDURE move-up-down :
     3715   define parameter buffer source_tt-rule-call-param for tt-rule-call-param.
     3716   define input parameter p-direction as character no-undo.
     3717   define input parameter p-rule-id as integer no-undo.
     3718   define output parameter p-recid as recid no-undo.
     3719   define variable v-source as integer no-undo .
     3720   define variable v-target as integer no-undo .
     3721   define buffer buf_tt-rule-call-param for tt-rule-call-param.
     3722     if not available source_tt-rule-call-param then do:
     3723       bell.
     3724       return no-apply.
     3725     end.
     3726     assign
     3727     v-source = source_tt-rule-call-param.p-index
     3728     p-recid = recid(source_tt-rule-call-param)
     3729     .
     3730     case p-direction:
     3731       when "down" then do:
     3732         find first buf_tt-rule-call-param where
     3733              buf_tt-rule-call-param.param-name = "p-discnt-roles"
     3734          and buf_tt-rule-call-param.rule_id = p-rule-id
     3735          and buf_tt-rule-call-param.p-index > v-source no-error.
     3736       end.
     3737       when "up" then do:
     3738         find last buf_tt-rule-call-param where
     3739              buf_tt-rule-call-param.param-name = "p-discnt-roles"
     3740          and buf_tt-rule-call-param.rule_id = p-rule-id
     3741          and buf_tt-rule-call-param.p-index < v-source
     3742          and buf_tt-rule-call-param.p-index > 0
     3743          no-error.
     3744       end.
     3745     end case.
     3746     if not available buf_tt-rule-call-param then do:
     3747       bell.
     3748       return no-apply.
     3749     end.
     3750     assign
     3751     v-target = buf_tt-rule-call-param.p-index.
     3752     do transaction
     3753     on error   undo, return no-apply
     3754     on stop    undo, return no-apply
     3755     on end-key undo, return no-apply:
     3756       assign
     3757       buf_tt-rule-call-param.p-index = -99999.
     3758       release buf_tt-rule-call-param.
     3759       assign
     3760       source_tt-rule-call-param.p-index = v-target.
     3761       find first buf_tt-rule-call-param where
     3762              buf_tt-rule-call-param.param-name = "p-discnt-roles"
     3763          and buf_tt-rule-call-param.rule_id = p-rule-id
     3764          and buf_tt-rule-call-param.p-index = -99999.
     3765       assign
     3766       buf_tt-rule-call-param.p-index = v-source.
     3767       release buf_tt-rule-call-param.
     3768       release source_tt-rule-call-param.
     3769     end.
     3770   END PROCEDURE.
     3771   PROCEDURE MyEnable :
     3772   define variable v-list as character no-undo .
     3773   define variable glog as logical no-undo .
     3774   define variable v-index-id as integer no-undo .
     3775   define variable v-value-character as character no-undo .
     3776   define variable v-value-date as date no-undo .
     3777   define variable v-value-decimal as decimal no-undo .
     3778   define variable v-value-integer as integer no-undo .
     3779   define variable v-value-logical as logical no-undo .
     3780   define variable v-shop-code as integer no-undo .
     3781   define buffer buf_clob-bind for ub.clob-bind.
     3782   run rcps_Myenable0 in this-procedure .
     3783   v-index-id = 0.
     3784   RUN rcps_get-value IN THIS-PROCEDURE (
     3785                                    INPUT p-profile-id
     3786                                   ,INPUT p-once-more
     3787                                   ,INPUT p-call-id
     3788                                   ,INPUT "p-add-gds-discnts"
     3789                                   ,INPUT-output v-index-id
     3790                                   ,output v-value-character
     3791                                   ,output v-value-date
     3792                                   ,output v-value-decimal
     3793                                   ,output v-value-integer
     3794                                   ,output t-add-gds-discnts
     3795                                   ).
     3796   v-index-id = 0.
     3797   RUN rcps_get-value IN THIS-PROCEDURE (
     3798                                    INPUT p-profile-id
     3799                                   ,INPUT p-once-more
     3800                                   ,INPUT p-call-id
     3801                                   ,INPUT "p-add-subtotal-discnts"
     3802                                   ,INPUT-output v-index-id
     3803                                   ,output v-value-character
     3804                                   ,output v-value-date
     3805                                   ,output v-value-decimal
     3806                                   ,output v-value-integer
     3807                                   ,output t-add-subtotal-discnts
     3808                                   ).
     3809   run rcps_get-rule-on-off in this-procedure ( input 15
     3810                                               ,input 1
     3811                                               ,input 1971
     3812                                               ,input p-profile-id
     3813                                               ,input p-once-more
     3814                                               ,output t-rule-gds ).
     3815   run rcps_get-rule-on-off in this-procedure ( input 16
     3816                                               ,input 1
     3817                                               ,input 1972
     3818                                               ,input p-profile-id
     3819                                               ,input p-once-more
     3820                                               ,output t-rule-subtotal ).
     3821   run rcps_get-rule-on-off in this-procedure ( input 17
     3822                                               ,input 1
     3823                                               ,input 1973
     3824                                               ,input p-profile-id
     3825                                               ,input p-once-more
     3826                                               ,output t-rule-pay ).
     3827   v-index-id = 0.
     3828   RUN rcps_get-value IN THIS-PROCEDURE (
     3829                                    INPUT p-profile-id
     3830                                   ,INPUT p-once-more
     3831                                   ,INPUT p-call-id
     3832                                   ,INPUT "p-add-pay-discnts"
     3833                                   ,INPUT-output v-index-id
     3834                                   ,output v-value-character
     3835                                   ,output v-value-date
     3836                                   ,output v-value-decimal
     3837                                   ,output v-value-integer
     3838                                   ,output t-add-pay-discnts
     3839                                   ).
     3840   ASSIGN
     3841   term_tt-rule-call-param.param-label:RESIZABLE IN browse br-rcp = YES
     3842   X_rp-rule-param.rp-param-name:RESIZABLE IN browse br-rcp = YES
     3843   .
     3844   DEFINE VARIABLE v-ch0 AS widget-handle NO-UNDO.
     3845   ASSIGN
     3846   v-ch0 = br-rcp:FIRST-COLUMN IN FRAME Dialog-Frame.
     3847   REPEAT WHILE valid-handle(v-ch0):
     3848      IF v-ch0:LABEL = "Значение!(строковое)" THEN DO:
     3849        v-ch[1] = v-ch0.
     3850        v-ch0:VISIBLE = NO.
     3851      END.
     3852      IF v-ch0:LABEL = "Значение!(Дата)" THEN DO:
     3853        v-ch[2] = v-ch0.
     3854        v-ch0:VISIBLE = NO.
     3855      END.
     3856      IF v-ch0:LABEL = "Значение!(Десятичное)" THEN DO:
     3857        v-ch[3] = v-ch0.
     3858        v-ch0:VISIBLE = NO.
     3859      END.
     3860      IF v-ch0:LABEL = "Значение!(Целое)" THEN DO:
     3861        v-ch[4] = v-ch0.
     3862        v-ch0:VISIBLE = NO.
     3863      END.
     3864      IF v-ch0:LABEL = "Значение!(Логическое)" THEN DO:
     3865        v-ch[5] = v-ch0.
     3866        v-ch0:VISIBLE = NO.
     3867      END.
     3868      IF v-ch0:LABEL = "Точка вызова" THEN DO:
     3869        v-ch[6] = v-ch0.
     3870      END.
     3871      IF v-ch0:LABEL = "Значение" THEN
     3872      v-ch0:RESIZABLE = YES.
     3873      v-ch0 = v-ch0:NEXT-COLUMN.
     3874   END.
     3875   assign
     3876   X_rp-rule-param.rp-param-name:resizable in browse br-rcp = yes
     3877   term_tt-rule-call-param.param-name:resizable in browse br-rcp = yes
     3878   term_tt-rule-call-param.param-label:resizable in browse br-rcp = yes
     3879   .
     3880   CASE p-list-mode:
     3881     WHEN 'rule-call-param':U THEN DO:
     3882        ASSIGN
     3883        X_rp-rule-param.rp-param-name:VISIBLE IN BROWSE br-rcp = NO
     3884        .
     3885     END.
     3886     WHEN 'rp-rule-param':U
     3887     or
     3888     when 'rp-rule-param':U + chr(44) + 'все':U
     3889     THEN DO:
     3890       assign
     3891       term_tt-rule-call-param.codex_id:VISIBLE IN BROWSE br-rcp = NO
     3892       term_tt-rule-call-param.ruleset_id:VISIBLE IN BROWSE br-rcp = NO
     3893       term_tt-rule-call-param.rule_id:VISIBLE IN BROWSE br-rcp = NO
     3894       term_tt-rule-call-param.order_id:VISIBLE IN BROWSE br-rcp = NO
     3895       term_tt-rule-call-param.param-name:VISIBLE IN BROWSE br-rcp = NO
     3896       term_tt-rule-call-param.param-num:VISIBLE IN BROWSE br-rcp = NO
     3897       .
     3898     END.
     3899   END CASE.
     3900    IF p-call-id <> '':U THEN DO:
     3901      v-ch[6]:VISIBLE = NO.
     3902    END.
     3903     IF p-profile-id <> 0 THEN DO:
     3904      term_tt-rule-call-param.profile_id :VISIBLE IN BROWSE br-rcp= NO.
     3905    END.
     3906     IF p-rule-id <> 0 THEN DO:
     3907      term_tt-rule-call-param.RULE_id :VISIBLE IN BROWSE br-rcp= NO.
     3908    END.
     3909     IF p-once-more <> 0 THEN DO:
     3910      term_tt-rule-call-param.once-more :VISIBLE IN BROWSE br-rcp= NO.
     3911    END.
     3912   display
     3913   t-add-gds-discnts
     3914   t-add-subtotal-discnts
     3915   t-add-pay-discnts
     3916   t-rule-gds
     3917   t-rule-subtotal
     3918   t-rule-pay
     3919   with frame Dialog-Frame .
     3920   VIEW FRAME Dialog-Frame.
     3921   ENABLE
     3922   br-gds
     3923   br-subtotal
     3924   br-pay
     3925   t-add-gds-discnts          WHEN p-mode <> 'ПРОСМОТР':U
     3926   t-add-subtotal-discnts     WHEN p-mode <> 'ПРОСМОТР':U
     3927   t-add-pay-discnts          WHEN p-mode <> 'ПРОСМОТР':U
     3928   t-rule-gds                WHEN p-mode <> 'ПРОСМОТР':U
     3929   t-rule-subtotal                WHEN p-mode <> 'ПРОСМОТР':U
     3930   t-rule-pay                WHEN p-mode <> 'ПРОСМОТР':U
     3931   b-gds-add WHEN p-mode <> 'ПРОСМОТР':U
     3932   b-gds-delete WHEN p-mode <> 'ПРОСМОТР':U
     3933   b-pay-add WHEN p-mode <> 'ПРОСМОТР':U
     3934   b-pay-delete WHEN p-mode <> 'ПРОСМОТР':U
     3935   b-subtotal-add WHEN p-mode <> 'ПРОСМОТР':U
     3936   b-subtotal-delete WHEN p-mode <> 'ПРОСМОТР':U
     3937   b-gds-up WHEN p-mode <> 'ПРОСМОТР':U
     3938   b-gds-down WHEN p-mode <> 'ПРОСМОТР':U
     3939   b-pay-up WHEN p-mode <> 'ПРОСМОТР':U
     3940   b-pay-down WHEN p-mode <> 'ПРОСМОТР':U
     3941   b-subtotal-up WHEN p-mode <> 'ПРОСМОТР':U
     3942   b-subtotal-down WHEN p-mode <> 'ПРОСМОТР':U
     3943   B-exit WHEN p-mode <> 'ПРОСМОТР':U
     3944   b-quit
     3945   WITH FRAME Dialog-Frame.
     3946   VIEW FRAME Dialog-Frame.
     3947   IF p-mode = 'ПРОСМОТР':U THEN DO:
     3948      ASSIGN
     3949      b-quit:COLUMN = 1
     3950      b-quit:LABEL = "&Выход".
     3951      HIDE
     3952      b-exit
     3953      IN FRAME Dialog-Frame.
     3954   END.
     3955   ASSIGN
     3956   FRAME Dialog-Frame:TITLE = substitute("Параметры стандартного расчета скидки в чеке на IBS TH POS (профайл &1)", p-profile-id).
     3957   OPEN QUERY br-gds FOR EACH gds_tt-rule-call-param where              gds_tt-rule-call-param.param-name = "p-discnt-roles"          and gds_tt-rule-call-param.rule_id = 1971          and gds_tt-rule-call-param.p-index > 0 by gds_tt-rule-call-param.p-index          .
     3958   OPEN QUERY br-subtotal FOR EACH subtotal_tt-rule-call-param where              subtotal_tt-rule-call-param.param-name = "p-discnt-roles"          and subtotal_tt-rule-call-param.rule_id = 1972          and subtotal_tt-rule-call-param.p-index > 0 by subtotal_tt-rule-call-param.p-index            .
     3959   OPEN QUERY br-pay FOR EACH pay_tt-rule-call-param where              pay_tt-rule-call-param.param-name = "p-discnt-roles"          and pay_tt-rule-call-param.rule_id = 1973          and pay_tt-rule-call-param.p-index > 0 by pay_tt-rule-call-param.p-index           .
     3960   APPLY "VALUE-CHANGED" to t-rule-gds.
     3961   APPLY "VALUE-CHANGED" to t-rule-subtotal.
     3962   APPLY "VALUE-CHANGED" to t-rule-pay.
     3963   END PROCEDURE.
     3964   PROCEDURE proc-b-add :
     3965   define input parameter p-rule-param-name as character no-undo.
     3966   define input parameter p-rp-param-name as character no-undo.
     3967   define input parameter p-rule-id as integer no-undo.
     3968   define buffer buf_tt-rule-call-param for tt-rule-call-param.
     3969   define variable v-ii as integer no-undo .
     3970   do v-ii = 1 to 99999:
     3971     find first buf_tt-rule-call-param where
     3972             buf_tt-rule-call-param.param-name = p-rule-param-name
     3973         and buf_tt-rule-call-param.rule_id = p-rule-id
     3974         and buf_tt-rule-call-param.p-index = v-ii no-error.
     3975     if not available buf_tt-rule-call-param then do:
     3976       v-gds-index = v-ii.
     3977       leave.
     3978     end.
     3979   end.
     3980     run rcps_proc-b-add in this-procedure (
     3981                                             input p-profile-id
     3982                                            ,INPUT p-once-more
     3983                                            ,input p-call-id
     3984                                            ,input p-rp-param-name
     3985                                            ,input v-gds-index ) no-error.
     3986     if error-status:error then return error.
     3987     find first TERM_tt-rule-call-param where
     3988               TERM_tt-rule-call-param.param-name = p-rule-param-name
     3989         and term_tt-rule-call-param.rule_id = p-rule-id
     3990         and term_tt-rule-call-param.p-index = v-ii .
     3991     run proc-b-chg in this-procedure ( input p-rp-param-name ) no-error.
     3992     if error-status:error then do:
     3993       delete term_tt-rule-call-param.
     3994       return error.
     3995     end.
     3996   END PROCEDURE.
     3997   PROCEDURE proc-b-chg :
     3998   define input parameter p-rp-param-name as character no-undo.
     3999   DEFINE VARIABLE v-format AS CHARACTER NO-UNDO.
     4000   DEFINE VARIABLE v-value-character AS CHARACTER NO-UNDO.
     4001   DEFINE VARIABLE v-value-integer AS integer NO-UNDO.
     4002   DEFINE VARIABLE v-value-decimal AS decimal NO-UNDO.
     4003   DEFINE VARIABLE v-value-logical AS logical NO-UNDO.
     4004   DEFINE VARIABLE v-value-date AS date NO-UNDO.
     4005   define variable v-ok as logical no-undo .
     4006   define buffer dbl_tt-rule-call-param for tt-rule-call-param.
     4007   assign
     4008   v-value-character = term_tt-rule-call-param.param-value-character
     4009   v-value-date = term_tt-rule-call-param.param-value-date
     4010   v-value-decimal = term_tt-rule-call-param.param-value-decimal
     4011   v-value-integer = term_tt-rule-call-param.param-value-integer
     4012   v-value-logical = term_tt-rule-call-param.param-value-logical
     4013   .
     4014   run ref/rule-dtt.p (
     4015                        input parparentproc
     4016                       ,input 'ИЗМЕНЕНИЕ':U
     4017                       ,input p-call-id
     4018                       ,input term_tt-rule-call-param.param-data-type
     4019                       ,input term_tt-rule-call-param.param-2-data-type
     4020                       ,input term_tt-rule-call-param.param-3-data-type
     4021                       ,input term_tt-rule-call-param.p-index
     4022                       ,input-output v-value-character
     4023                       ,input-output v-value-date
     4024                       ,input-output v-value-decimal
     4025                       ,input-output v-value-integer
     4026                       ,input-output v-value-logical
     4027                       ,output v-ok
     4028                       ) no-error.
     4029   if not error-status:error
     4030   and v-ok then do:
     4031     find first dbl_tt-rule-call-param where
     4032               dbl_tt-rule-call-param.rule_id = term_tt-rule-call-param.rule_id
     4033           and dbl_tt-rule-call-param.param-value-character = v-value-character
     4034           and dbl_tt-rule-call-param.p-index <> term_tt-rule-call-param.p-index no-error.
     4035     if available dbl_tt-rule-call-param then do:
     4036       message
     4037       substitute("Вы уже выбирали этот тип скидки")
     4038       view-as alert-box error .
     4039       return error.
     4040     end.
     4041     define variable v-mess as character no-undo .
     4042     if term_tt-rule-call-param.rule_id = 1971 then do:
     4043       case v-value-character:
     4044         when 'pcnt-kat':U then do:
     4045           find first dbl_tt-rule-call-param where
     4046                     dbl_tt-rule-call-param.rule_id = term_tt-rule-call-param.rule_id
     4047                 and dbl_tt-rule-call-param.param-value-character = 'pcnt-kat-pdf':U
     4048                 and dbl_tt-rule-call-param.p-index > 0 no-error.
     4049           if available dbl_tt-rule-call-param then do:
     4050             v-mess = substitute("Уже применяется тип скидки &1.&2" +
     4051                                 "Нельзя одновременно задавать применение типа скидки <&1>&2и типа скидки <&3>"
     4052                                 , 'Категорийная через ТПЛ':U
     4053                                 , chr(10)
     4054                                 , 'Категорийная скидка':U
     4055                                 ).
     4056           end.
     4057         end.
     4058         when 'pcnt-kat-pdf':U then do:
     4059           find first dbl_tt-rule-call-param where
     4060                     dbl_tt-rule-call-param.rule_id = term_tt-rule-call-param.rule_id
     4061                 and dbl_tt-rule-call-param.param-value-character = 'pcnt-kat':U
     4062                 and dbl_tt-rule-call-param.p-index > 0 no-error.
     4063           if available dbl_tt-rule-call-param then do:
     4064             v-mess = substitute("Уже применяется тип скидки &1.&2" +
     4065                                 "Нельзя одновременно задавать применение типа скидки <&1>&2и типа скидки <&3>"
     4066                                 , 'Категорийная скидка':U
     4067                                 , chr(10)
     4068                                 , 'Категорийная через ТПЛ':U
     4069                                            ).
     4070           end.
     4071         end.
     4072         when 'temp-disc-pdf':U then do:
     4073           find first dbl_tt-rule-call-param where
     4074                     dbl_tt-rule-call-param.rule_id = term_tt-rule-call-param.rule_id
     4075                 and dbl_tt-rule-call-param.param-value-character = 'temp-disc':U
     4076                 and dbl_tt-rule-call-param.p-index > 0 no-error.
     4077           if available dbl_tt-rule-call-param then do:
     4078             v-mess = substitute("Уже применяется тип скидки &1.&2" +
     4079                                 "Нельзя одновременно задавать применение типа скидки <&1>&2и типа скидки <&3>"
     4080                                 , 'Временная скидка':U
     4081                                 , chr(10)
     4082                                 , 'Временная через ТПЛ':U
     4083                                 ).
     4084           end.
     4085         end.
     4086         when 'temp-disc':U then do:
     4087           find first dbl_tt-rule-call-param where
     4088                     dbl_tt-rule-call-param.rule_id = term_tt-rule-call-param.rule_id
     4089                 and dbl_tt-rule-call-param.param-value-character = 'temp-disc-pdf':U
     4090                 and dbl_tt-rule-call-param.p-index > 0 no-error.
     4091           if available dbl_tt-rule-call-param then do:
     4092             v-mess = substitute("Уже применяется тип скидки &1.&2" +
     4093                                 "Нельзя одновременно задавать применение типа скидки <&1>&2и типа скидки <&3>"
     4094                                 , 'Временная через ТПЛ':U
     4095                                 , chr(10)
     4096                                 , 'Временная скидка':U
     4097                                 ).
     4098           end.
     4099         end.
     4100       end case.
     4101     end.
     4102     if v-mess <> '' then do:
     4103       message
     4104       v-mess
     4105       view-as alert-box warning.
     4106       return error.
     4107     end.
     4108     RUN set-value IN THIS-PROCEDURE (
     4109                                      INPUT term_tt-rule-call-param.profile_id
     4110                                     ,INPUT term_tt-rule-call-param.once-more
     4111                                     ,INPUT (if p-list-mode = 'rp-rule-param':U
     4112                                            then p-rp-param-name
     4113                                            else '':U)
     4114                                     ,INPUT term_tt-rule-call-param.call_id
     4115                                     ,INPUT term_tt-rule-call-param.codex_id
     4116                                     ,INPUT term_tt-rule-call-param.ruleset_id
     4117                                     ,INPUT term_tt-rule-call-param.order_id
     4118                                     ,INPUT term_tt-rule-call-param.param-name
     4119                                     ,INPUT term_tt-rule-call-param.p-index
     4120                                      ,INPUT v-value-character
     4121                                      ,INPUT v-value-date
     4122                                      ,INPUT v-value-decimal
     4123                                      ,INPUT v-value-integer
     4124                                      ,INPUT v-value-logical).
     4125   end.
     4126   else do:
     4127     return error.
     4128   end.
     4129   END PROCEDURE.
     4130   PROCEDURE proc-save :
     4131   define variable v-ii as integer   no-undo .
     4132   if not can-find(first tt-rule-call-param where
     4133                         tt-rule-call-param.rule_id = 1971
     4134                    and  tt-rule-call-param.p-index > 0) then do:
     4135     t-rule-gds = no.
     4136     display
     4137     t-rule-gds
     4138     with frame Dialog-Frame .
     4139     message
     4140     "Не найдено ни одного типа скидки для расчета по строке товара!" skip(0)
     4141     "Выключаем возможность применять скидки по строке товара!"
     4142     view-as alert-box  warning.
     4143   end.
     4144   if not can-find(first tt-rule-call-param where
     4145                         tt-rule-call-param.rule_id = 1972
     4146                    and  tt-rule-call-param.p-index > 0) then do:
     4147     t-rule-subtotal = no.
     4148     display
     4149     t-rule-subtotal
     4150     with frame Dialog-Frame .
     4151     message
     4152     "Не найдено ни одного типа скидки для расчета на подитог!" skip(0)
     4153     "Выключаем возможность применять скидки на подитог!"
     4154     view-as alert-box  warning.
     4155   end.
     4156   if not can-find(first tt-rule-call-param where
     4157                         tt-rule-call-param.rule_id = 1973
     4158                    and  tt-rule-call-param.p-index > 0) then do:
     4159     t-rule-pay = no.
     4160     display
     4161     t-rule-pay
     4162     with frame Dialog-Frame .
     4163     message
     4164     "Не найдено ни одного типа скидки для расчета на строку оплат!" skip(0)
     4165     "Выключаем возможность применять скидки на оплат!"
     4166     view-as alert-box  warning.
     4167   end.
     4168   v-ii = 0.
     4169   assign
     4170   frame Dialog-Frame
     4171   t-add-gds-discnts
     4172   t-add-subtotal-discnts
     4173   t-add-pay-discnts
     4174   t-rule-gds
     4175   t-rule-subtotal
     4176   t-rule-pay
     4177   .
     4178   run rcps_set-rule-on-off in this-procedure ( input 15
     4179                                              ,input 1
     4180                                              ,input 1971
     4181                                              ,input p-profile-id
     4182                                              ,input p-once-more
     4183                                              ,input t-rule-gds).
     4184   run rcps_set-rule-on-off in this-procedure ( input 16
     4185                                              ,input 1
     4186                                              ,input 1972
     4187                                              ,input p-profile-id
     4188                                              ,input p-once-more
     4189                                              ,input t-rule-subtotal).
     4190   run rcps_set-rule-on-off in this-procedure ( input 17
     4191                                              ,input 1
     4192                                              ,input 1973
     4193                                              ,input p-profile-id
     4194                                              ,input p-once-more
     4195                                              ,input t-rule-pay).
     4196   RUN rcps_set-value IN THIS-PROCEDURE (
     4197                                   INPUT p-profile-id
     4198                                   ,INPUT p-once-more
     4199                                   ,INPUT p-call-id
     4200                                   ,INPUT "p-add-gds-discnts"
     4201                                   ,INPUT 0
     4202                                   ,INPUT ''
     4203                                   ,INPUT ?
     4204                                   ,INPUT 0.0
     4205                                   ,INPUT 0
     4206                                   ,INPUT t-add-gds-discnts
     4207                                   ).
     4208   RUN rcps_set-value IN THIS-PROCEDURE (
     4209                                   INPUT p-profile-id
     4210                                   ,INPUT p-once-more
     4211                                   ,INPUT p-call-id
     4212                                   ,INPUT "p-add-subtotal-discnts"
     4213                                   ,INPUT 0
     4214                                   ,INPUT ''
     4215                                   ,INPUT ?
     4216                                   ,INPUT 0.0
     4217                                   ,INPUT 0
     4218                                   ,INPUT t-add-subtotal-discnts
     4219                                   ).
     4220   RUN rcps_set-value IN THIS-PROCEDURE (
     4221                                   INPUT p-profile-id
     4222                                   ,INPUT p-once-more
     4223                                   ,INPUT p-call-id
     4224                                   ,INPUT "p-add-pay-discnts"
     4225                                   ,INPUT 0
     4226                                   ,INPUT ''
     4227                                   ,INPUT ?
     4228                                   ,INPUT 0.0
     4229                                   ,INPUT 0
     4230                                   ,INPUT t-add-pay-discnts
     4231                                   ).
     4232   run resort-rule-call-param in this-procedure ( input "p-discnt-roles"
     4233                                                  ,input 1971).
     4234   run resort-rule-call-param in this-procedure ( input "p-discnt-roles"
     4235                                                  ,input 1972).
     4236   run resort-rule-call-param in this-procedure ( input "p-discnt-roles"
     4237                                                  ,input 1973).
     4238   run rcps_proc-save0 in this-procedure .
     4239   END PROCEDURE.
     4240   PROCEDURE resort-rule-call-param :
     4241   define input parameter p-rule-param-name as character no-undo.
     4242   define input parameter p-rule-id as integer no-undo.
     4243   define variable v-ii as integer no-undo.
     4244   define variable v-jj as integer no-undo.
     4245   define buffer buf_tt-rule-call-param for tt-rule-call-param.
     4246   do v-ii = 1 to 99999:
     4247     for each buf_tt-rule-call-param where
     4248               buf_tt-rule-call-param.rule_id = p-rule-id
     4249           and buf_tt-rule-call-param.param-name = p-rule-param-name
     4250           and buf_tt-rule-call-param.p-index >= v-ii
     4251      by buf_tt-rule-call-param.p-index:
     4252       leave.
     4253     end.      .
     4254     if not available buf_tt-rule-call-param then leave.
     4255     if buf_tt-rule-call-param.p-index <> v-ii then do:
     4256       assign
     4257       buf_tt-rule-call-param.p-index = v-ii.
     4258       release buf_tt-rule-call-param.
     4259     end.
     4260   end.
     4261   END PROCEDURE.
     4262   PROCEDURE set-value :
     4263   DEFINE INPUT PARAMETER p-profile-id AS integer NO-UNDO.
     4264   DEFINE INPUT PARAMETER p-once-more AS integer NO-UNDO.
     4265   DEFINE INPUT PARAMETER p-rp-param-name AS CHARACTER NO-UNDO.
     4266   DEFINE INPUT PARAMETER p-call-id AS CHARACTER NO-UNDO.
     4267   DEFINE INPUT PARAMETER p-codex-id AS integer NO-UNDO.
     4268   DEFINE INPUT PARAMETER p-ruleset-id AS integer NO-UNDO.
     4269   DEFINE INPUT PARAMETER p-order-id AS integer NO-UNDO.
     4270   DEFINE INPUT PARAMETER p-param-name AS character NO-UNDO.
     4271   DEFINE INPUT PARAMETER p-index AS integer NO-UNDO.
     4272   DEFINE INPUT parameter p-value-character AS CHARACTER NO-UNDO.
     4273   DEFINE INPUT parameter p-value-date AS date NO-UNDO.
     4274   DEFINE INPUT parameter p-value-decimal AS decimal NO-UNDO.
     4275   DEFINE INPUT parameter p-value-integer AS integer NO-UNDO.
     4276   DEFINE INPUT parameter p-value-logical AS logical NO-UNDO.
     4277   DEFINE BUFFER buf_tt-rule-call-param FOR tt-rule-call-param.
     4278   DEFINE BUFFER buf_rp-rule-param FOR ub.rp-rule-param.
     4279   CASE p-list-mode:
     4280     WHEN 'rp-rule-param':U THEN DO:
     4281         FOR EACH  buf_rp-rule-param NO-LOCK where
     4282             buf_rp-rule-param.profile_id = p-profile-id
     4283             AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     4284             ,EACH buf_tt-rule-call-param WHERE
     4285                buf_tt-rule-call-param.profile_id = p-profile-id
     4286             AND buf_tt-rule-call-param.once-more = p-once-more
     4287             AND buf_tt-rule-call-param.call_id = p-CALL-id
     4288             AND buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     4289             AND buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     4290             AND buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     4291             AND buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     4292             AND buf_tt-rule-call-param.p-index = p-index
     4293           ON error undo, return error :
     4294             assign
     4295             buf_tt-rule-call-param.param-value-character = p-value-character
     4296             buf_tt-rule-call-param.param-value-date      = p-value-date
     4297             buf_tt-rule-call-param.param-value-decimal   = p-value-decimal
     4298             buf_tt-rule-call-param.param-value-integer   = p-value-integer
     4299             buf_tt-rule-call-param.param-value-logical   = p-value-logical
     4300             .
     4301         END.
     4302     END.
     4303     WHEN 'rule-call-param':U THEN DO:
     4304       FIND FIRST buf_tt-rule-call-param WHERE
     4305           buf_tt-rule-call-param.call_id = p-call-id
     4306       AND buf_tt-rule-call-param.codex_id = p-codex-id
     4307       AND buf_tt-rule-call-param.ruleset_id = p-ruleset-id
     4308       AND buf_tt-rule-call-param.order_id = p-order-id
     4309       AND buf_tt-rule-call-param.param-name = p-param-name
     4310       AND buf_tt-rule-call-param.p-index = p-index.
     4311       assign
     4312       buf_tt-rule-call-param.param-value-character = p-value-character
     4313       buf_tt-rule-call-param.param-value-date      = p-value-date
     4314       buf_tt-rule-call-param.param-value-decimal   = p-value-decimal
     4315       buf_tt-rule-call-param.param-value-integer   = p-value-integer
     4316       buf_tt-rule-call-param.param-value-logical   = p-value-logical
     4317       .
     4318     END.
     4319   END CASE.
     4320   END PROCEDURE.
