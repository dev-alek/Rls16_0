     1266   DEFINE VARIABLE t-add-gds-discnts AS LOGICAL INITIAL no
     1267        LABEL "<Складывать> скидки на строку товара"
     1268        VIEW-AS TOGGLE-BOX
     1269        SIZE 40 BY 1 NO-UNDO.
     1270   DEFINE VARIABLE t-add-pay-discnts AS LOGICAL INITIAL no
     1271        LABEL "<Складывать> скидки на строку оплат"
     1272        VIEW-AS TOGGLE-BOX
     1273        SIZE 40 BY 1 NO-UNDO.
     1274   DEFINE VARIABLE t-add-subtotal-discnts AS LOGICAL INITIAL no
     1275        LABEL "<Складывать> скидки на подитог"
     1276        VIEW-AS TOGGLE-BOX
     1277        SIZE 40 BY 1 NO-UNDO.
     1278   DEFINE VARIABLE t-rule-gds AS LOGICAL INITIAL no
     1279        LABEL "Применять скидки на строку товара"
     1280        VIEW-AS TOGGLE-BOX
     1281        SIZE 40 BY 1 NO-UNDO.
