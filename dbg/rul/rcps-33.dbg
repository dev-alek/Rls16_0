     1290   DEFINE QUERY br-gds FOR
     1291         gds_tt-rule-call-param SCROLLING.
     1292   DEFINE QUERY br-pay FOR
     1293         pay_tt-rule-call-param SCROLLING.
     1294   DEFINE QUERY BR-rcp FOR
     1295         X_ruledict-param,
     1296         X_rp-rule-param,
     1297         tt-rule-call-param,
     1298         TERM_tt-rule-call-param SCROLLING.
