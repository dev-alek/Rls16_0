     1324                   ,INPUT pay_tt-rule-call-param.param-value-decimal
     1325                   ,INPUT pay_tt-rule-call-param.param-value-integer
     1326                   ,INPUT pay_tt-rule-call-param.param-value-logical)
     1327   column-label "Тип скидки" format "X(40)"
     1328   pay_tt-rule-call-param.p-index column-label "Приоритет" format ">9"
     1329       WITH NO-ROW-MARKERS SEPARATORS SIZE 55 BY 5.6
     1330            TITLE "Скидки, применяемые к строке опат (в пор-ке убыв. приоритета)" FIT-LAST-COLUMN.
