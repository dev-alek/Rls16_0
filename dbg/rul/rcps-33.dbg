     1381                   ,INPUT subtotal_tt-rule-call-param.param-value-decimal
     1382                   ,INPUT subtotal_tt-rule-call-param.param-value-integer
     1383                   ,INPUT subtotal_tt-rule-call-param.param-value-logical)
     1384   column-label "Тип скидки" format "X(40)"
