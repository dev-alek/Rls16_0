     1617   .
     1618   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1619   FUNCTION rum-fn_get-next-file-name returns character (
     1620                                       input p-base-file-name as character
     1621                                     , input p-index as integer):
     1622   define variable v-loc-file-name as character no-undo .
     1623   v-loc-file-name = substitute("&1_&2.&3"
     1624                               ,substring(p-base-file-name, 1, (if r-index(p-base-file-name, ".") > 1
     1625                                                         then (r-index(p-base-file-name, ".") - 1)
     1626                                                         else length(p-base-file-name)
     1627                                                         )
     1628                                           )
     1629                               ,p-index
     1630                               ,(if r-index(p-base-file-name, ".") > 1
     1631                                 then substring(p-base-file-name, r-index(p-base-file-name, ".") + 1)
     1632                                 else '')
     1633                                 )
     1634                                 .
     1635   return v-loc-file-name.
     1636   end function.
     1637   define variable vss-include-info12 as character format "X(65)" no-undo
     1638   initial "@(#)$Workfile$ $Revision$".
     1639   define temp-table temp_grplib_grp no-undo
     1640       field sel           as character
     1641       field nabor         as character
     1642       field full-name     as character
     1643       field print-code    as character
     1644       field sort-name     as character
     1645       field node-code     as integer
     1646       field upper-code    as integer
     1647       field calc-method   as character
     1648       field round-method  as character
     1649       field increase-pc   as decimal
     1650       field min-marg      as character
     1651       field max-marg      as character
     1652       field cli-type      as character
     1653       field cli-code      as integer
     1654       field notcorr      as character
     1655       field name          as character
     1656       field level         as integer
     1657       field mark          as character
     1658       index pi is primary unique sort-name
     1659       index fn full-name
     1660       index nc is unique node-code
     1661       index sl sel
     1662       index uc upper-code
     1663   .
     1664   define temp-table temp_grplib_found-grp no-undo
     1665       field full-name   as character
     1666       field sort-name   as character
     1667       field node-code   as integer
     1668       field level       as integer
     1669       field is-terminal as logical
     1670       index pi is primary unique sort-name
     1671       index fn full-name
     1672       index lv level
     1673       index it is-terminal
     1674   .
     1675   define temp-table temp_found-result-nodelist no-undo
     1676       field node-code     as recid
     1677       field processed     as logical
     1678       field sort-name     as character
     1679       field full-name     as character
     1680       index pi is primary unique node-code
     1681       index ps processed
     1682   .
     1683   define variable v-grplib-not-fill-extra-info        as logical      no-undo.
     1684   define variable v-grplib-no-warning-grp-amount      as logical      no-undo.
     1685   define variable v-grplib-grp-amount-for-load        as integer      no-undo.
     1686   procedure grplib-get-parameters :
     1687   define input parameter p-store-type     as character        no-undo.
     1688   define input parameter p-store-code     as integer          no-undo.
     1689   do
     1690   on error undo, return error
     1691   :
     1692       assign
     1693           v-grplib-not-fill-extra-info = no
     1694       .
     1695   end.
     1696   end procedure.
     1697   procedure grplib-get-sort-name :
     1698   do
     1699   on error undo, return error
     1700   :
     1701   define input parameter p-node-code  as integer      no-undo.
     1702   define output parameter p-sort-name as character    no-undo.
     1703       define variable v-upper-code    as integer           no-undo.
     1704       define buffer buf_gds-grp       for ub.gds-grp.
     1705       define buffer buf_upper_gds-grp for ub.gds-grp.
     1706       find first buf_gds-grp no-lock
     1707            where buf_gds-grp.node-code = p-node-code
     1708       no-error.
     1709       if not available buf_gds-grp
     1710       then do:
     1711           undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     1712       end.
     1713       assign
     1714           p-sort-name  = ""
     1715           v-upper-code = 1
     1716       .
     1717       do while buf_gds-grp.upper-code <> 0
     1718       on error undo, return error "grplib-get-sort-name: Ошибка составления полного имени группы"
     1719       :
     1720           assign
     1721               p-sort-name  = buf_gds-grp.node-name
     1722                            + (if p-sort-name <> "" then chr(2) else "")
     1723                            + p-sort-name
     1724               v-upper-code = buf_gds-grp.upper-code
     1725           .
     1726           find first buf_gds-grp no-lock
     1727                where buf_gds-grp.node-code = v-upper-code
     1728           no-error.
     1729           if not available buf_gds-grp
     1730           then do:
     1731               undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом "
     1732                                   + string( v-upper-code )
     1733                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1734           end.
     1735       end.
     1736   end.
     1737   end procedure.
     1738   define variable vss-include-info13 as character format "X(65)" no-undo
     1739   initial "@(#)$Workfile$ $Revision$".
     1740   procedure grplib-get-full-name :
     1741      define input parameter p-node-code  as integer      no-undo.
     1742      define output parameter p-full-name as character    no-undo.
     1743      do
     1744   on error undo, return error
     1745   :
     1746       define variable v-upper-code    as integer           no-undo.
     1747       define buffer buf_gds-grp       for ub.gds-grp.
     1748       define buffer buf_upper_gds-grp for ub.gds-grp.
     1749       find first buf_gds-grp no-lock
     1750            where buf_gds-grp.node-code = p-node-code
     1751       no-error.
     1752       if not available buf_gds-grp
     1753       then do:
     1754           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     1755       end.
     1756       assign
     1757           p-full-name  = ""
     1758           v-upper-code = 1
     1759       .
     1760       do while buf_gds-grp.upper-code <> 0
     1761       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     1762       :
     1763           assign
     1764               p-full-name  = buf_gds-grp.node-name
     1765                            + (if p-full-name <> "" then chr(47) else "")
     1766                            + p-full-name
     1767               v-upper-code = buf_gds-grp.upper-code
     1768           .
     1769           find first buf_gds-grp no-lock
     1770                where buf_gds-grp.node-code = v-upper-code
     1771           no-error.
     1772           if not available buf_gds-grp
     1773           then do:
     1774               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     1775                                   + string( v-upper-code )
     1776                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1777           end.
     1778       end.
     1779       assign
     1780       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     1781       .
     1782   end.
     1783   end .
     1784   procedure grplib-get-node-from-full-name :
     1785   define input parameter p-full-name as character no-undo .
     1786   define output parameter p-node-code as integer no-undo .
     1787   define variable v-ii as integer no-undo .
     1788   define variable v-upper-code as integer no-undo .
     1789   define variable v-root-code as integer no-undo .
     1790   define variable v-entry as character no-undo .
     1791   define buffer buf_gds-grp       for ub.gds-grp.
     1792   do
     1793   on error undo, return error
     1794   :
     1795     find first buf_gds-grp no-lock
     1796         where buf_gds-grp.upper-code = 0
     1797     no-error .
     1798     if not available buf_gds-grp
     1799     then do:
     1800         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     1801     end.
     1802     else do:
     1803       assign
     1804       v-root-code = buf_gds-grp.node-code
     1805       .
     1806     end.
     1807     v-upper-code = v-root-code.
     1808     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     1809       assign
     1810       v-entry = entry(v-ii, p-full-name, chr(47)).
     1811       if v-entry = '' then leave.
     1812       find first buf_gds-grp no-lock where
     1813                 buf_gds-grp.node-name = v-entry
     1814             and buf_gds-grp.upper-code = v-upper-code
     1815             no-error.
     1816       if not available buf_gds-grp then do:
     1817         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     1818       end.
     1819       else do:
     1820         p-node-code = buf_gds-grp.node-code.
     1821         v-upper-code = buf_gds-grp.node-code.
     1822       end.
     1823     end.
     1824   end.
     1825   end .
     1826   procedure grplib-get-root-code :
     1827   do
     1828   on error undo, return error
     1829   :
     1830   define output parameter p-root-code as integer      no-undo.
     1831       define buffer buf_gds-grp       for ub.gds-grp.
     1832       find first buf_gds-grp no-lock
     1833           where buf_gds-grp.upper-code = 0
     1834       no-error .
     1835       if not available buf_gds-grp
     1836       then do:
     1837           undo, return error .
     1838       end.
     1839       else do:
     1840           assign
     1841               p-root-code = buf_gds-grp.node-code
     1842           .
     1843       end.
     1844   end.
     1845   end procedure.
     1846   procedure grplib-find-grp-by-full-name :
     1847   do
     1848   on error undo, return error
     1849   :
     1850   define input parameter p-search-name  as character    no-undo.
     1851   define input parameter p-fill-path    as logical      no-undo.
     1852   define output parameter p-found       as logical      no-undo.
     1853       define variable v-upper-code    as integer          no-undo.
     1854       define variable v-counter       as integer           no-undo.
     1855       define variable v-level         as integer           no-undo.
     1856       define variable v-full-name     as character         no-undo.
     1857       define variable v-sort-name     as character         no-undo.
     1858       define buffer buf_gds-grp       for ub.gds-grp.
     1859       assign
     1860           p-search-name = replace( p-search-name, chr(47), chr(2) )
     1861       .
     1862       run grplib-get-root-code ( output v-upper-code ) no-error .
     1863       if error-status :error
     1864       then do:
     1865           undo, return error "grplib-expand-name: Ошибка при поиске корневого узла".
     1866       end.
     1867       assign
     1868           v-full-name  = ""
     1869           v-level      = num-entries( p-search-name, chr(2) )
     1870       .
     1871       for each temp_grplib_found-grp
     1872       :
     1873           delete temp_grplib_found-grp.
     1874       end.
     1875       start-name-analyze:
     1876       do v-counter = 1 to v-level
     1877       :
     1878           if v-counter < v-level
     1879           then do:
     1880               find first buf_gds-grp no-lock
     1881                    where buf_gds-grp.upper-code = v-upper-code
     1882                      and buf_gds-grp.node-name  = entry( v-counter, p-search-name, chr(2) )
     1883               no-error .
     1884               if not available buf_gds-grp
     1885               then do:
     1886                   assign
     1887                       v-full-name  = p-search-name
     1888                       v-sort-name  = p-search-name
     1889                   .
     1890                   return error "grplib-expand-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
     1891               end.
     1892               else do:
     1893                   assign
     1894                       v-full-name = v-full-name + ( if v-full-name = "" then "" else chr(47) )        + buf_gds-grp.node-name
     1895                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_gds-grp.node-name
     1896                       v-upper-code = buf_gds-grp.node-code
     1897                   .
     1898                   if p-fill-path = yes
     1899                   then do:
     1900                       create temp_grplib_found-grp.
     1901                       assign
     1902                           temp_grplib_found-grp.full-name = v-full-name + chr(47)
     1903                           temp_grplib_found-grp.sort-name = v-sort-name
     1904                           temp_grplib_found-grp.node-code = v-upper-code
     1905                           temp_grplib_found-grp.level     = v-counter
     1906                       .
     1907                   end.
     1908               end.
     1909           end.
     1910           else do:
     1911               for each buf_gds-grp no-lock
     1912                  where buf_gds-grp.upper-code = v-upper-code
     1913                    and buf_gds-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
     1914               :
     1915                   assign
     1916                       p-found = yes
     1917                   .
     1918                   create temp_grplib_found-grp.
     1919                   assign
     1920                       temp_grplib_found-grp.full-name = v-full-name
     1921                                                           + (if v-full-name = "" then "" else chr(47) )
     1922                                                           + buf_gds-grp.node-name + chr(47)
     1923                       temp_grplib_found-grp.sort-name = v-sort-name
     1924                                                           + ( if v-sort-name = "" then "" else chr(2) )
     1925                                                           + buf_gds-grp.node-name
     1926                       temp_grplib_found-grp.node-code = buf_gds-grp.node-code
     1927                       temp_grplib_found-grp.level     = v-level
     1928                   .
     1929               end.
     1930               if p-found = no
     1931               then do:
     1932                   assign
     1933                       v-full-name  = p-search-name
     1934                       v-sort-name  = p-search-name
     1935                   .
     1936                   for each temp_grplib_found-grp
     1937                   :
     1938                       delete temp_grplib_found-grp.
     1939                   end.
     1940                   assign
     1941                       p-found = no
     1942                   .
     1943               end.
     1944           end.
     1945       end.
     1946   end.
     1947   end procedure.
     1948   procedure grplib-find-all-subgroup :
     1949   do
     1950   on error undo, return error
     1951   :
     1952   define input parameter p-start-node-code    as integer      no-undo.
     1953   define input parameter p-terminal-only      as logical      no-undo.
     1954       define variable v-start-full-name   as character     no-undo.
     1955       define variable v-start-sort-name   as character     no-undo.
     1956       define variable v-not-found         as logical       no-undo.
     1957       define variable v-is-terminal       as logical       no-undo.
     1958       define buffer buf_gds-grp           for ub.gds-grp.
     1959       create temp_found-result-nodelist.
     1960       assign
     1961           temp_found-result-nodelist.node-code = p-start-node-code
     1962           temp_found-result-nodelist.processed = no
     1963       .
     1964       run grplib-get-full-name in this-procedure (
     1965             input p-start-node-code
     1966           , output v-start-full-name
     1967       ).
     1968       run grplib-get-full-name in this-procedure (
     1969             input p-start-node-code
     1970           , output v-start-sort-name
     1971       ).
     1972       process-nodes:
     1973       do while yes
     1974       :
     1975           find first temp_found-result-nodelist
     1976                where temp_found-result-nodelist.node-code = p-start-node-code
     1977           .
     1978           assign
     1979               temp_found-result-nodelist.processed = yes
     1980           .
     1981           for each buf_gds-grp no-lock
     1982              where buf_gds-grp.upper-code = p-start-node-code
     1983           on error undo, return error
     1984           :
     1985               run grplib-is-terminal in this-procedure (
     1986                     input buf_gds-grp.node-code
     1987                   , output v-is-terminal
     1988               ).
     1989               if v-is-terminal = yes
     1990               then do:
     1991                   create temp_grplib_found-grp.
     1992                   assign
     1993                       temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     1994                                                           chr(47) + buf_gds-grp.node-name + chr(47)
     1995                       temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     1996                                                           chr(2) + buf_gds-grp.node-name + chr(2)
     1997                       temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
     1998                       temp_grplib_found-grp.is-terminal = yes
     1999                   .
     2000               end.
     2001               else do:
     2002                   create temp_found-result-nodelist.
     2003                   assign
     2004                       temp_found-result-nodelist.node-code = buf_gds-grp.node-code
     2005                       temp_found-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
     2006                                                              chr(47) + buf_gds-grp.node-name + chr(47)
     2007                       temp_found-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
     2008                                                              chr(2) + buf_gds-grp.node-name + chr(2)
     2009                       temp_found-result-nodelist.processed = no
     2010                   .
     2011                   if p-terminal-only = no
     2012                   then do:
     2013                       create temp_grplib_found-grp.
     2014                       assign
     2015                           temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     2016                                                               chr(47) + buf_gds-grp.node-name + chr(47)
     2017                           temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     2018                                                               chr(2) + buf_gds-grp.node-name + chr(2)
     2019                           temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
     2020                           temp_grplib_found-grp.is-terminal = no
     2021                       .
     2022                   end.
     2023               end.
     2024           end.
     2025           find first temp_found-result-nodelist
     2026                where temp_found-result-nodelist.processed = no
     2027           no-error.
     2028           if not available temp_found-result-nodelist
     2029           then do:
     2030               leave process-nodes.
     2031           end.
     2032           else do:
     2033               assign
     2034                   p-start-node-code = temp_found-result-nodelist.node-code
     2035                   v-start-full-name = temp_found-result-nodelist.full-name
     2036                   v-start-sort-name = temp_found-result-nodelist.sort-name
     2037               .
     2038           end.
     2039       end.
     2040   end.
     2041   end procedure.
     2042   procedure grplib-expand-name :
     2043   define input parameter p-start-name as character        no-undo.
     2044   define output parameter p-end-name  as character        no-undo.
     2045       define variable v-is-terminal   as logical      no-undo.
     2046       define variable v-found         as character    no-undo.
     2047       define buffer buf_temp_grplib_found-grp     for temp_grplib_found-grp.
     2048   do
     2049   for buf_temp_grplib_found-grp
     2050   on error undo, return error
     2051   :
     2052       run grplib-find-grp-by-full-name in this-procedure (
     2053             input p-start-name
     2054           , input no
     2055           , output v-found
     2056       ) no-error.
     2057       run grplib-get-max-substring in this-procedure (
     2058                   input length( p-start-name )
     2059                 , output p-end-name
     2060       ) no-error .
     2061       if error-status :error
     2062       then do:
     2063           assign
     2064               p-end-name = ""
     2065           .
     2066       end.
     2067       else do:
     2068           find first temp_grplib_found-grp
     2069               where temp_grplib_found-grp.full-name = p-end-name
     2070           no-error.
     2071           if available temp_grplib_found-grp
     2072           then do:
     2073               find first buf_temp_grplib_found-grp
     2074                   where buf_temp_grplib_found-grp.full-name begins p-end-name
     2075                   and recid( buf_temp_grplib_found-grp ) <> recid( temp_grplib_found-grp )
     2076               no-error.
     2077               if not available buf_temp_grplib_found-grp
     2078               then do:
     2079                   run grplib-is-terminal in this-procedure (
     2080                       input temp_grplib_found-grp.node-code
     2081                       , output v-is-terminal
     2082                   ).
     2083               end.
     2084           end.
     2085       end.
     2086   end.
     2087   end procedure.
     2088   procedure grplib-get-max-substring :
     2089   do
     2090   on error undo, return error
     2091   :
     2092   define input parameter p-min-substring-length   as integer      no-undo.
     2093   define output parameter p-substring             as character    no-undo.
     2094           define variable v-char-counter  as integer           no-undo.
     2095           define variable v-current-char  as character         no-undo.
     2096           define variable v-names-counter  as integer           no-undo.
     2097           define variable v-base-string   as character         no-undo.
     2098           assign
     2099               v-char-counter  = p-min-substring-length
     2100           .
     2101           find first temp_grplib_found-grp no-error.
     2102           if not available temp_grplib_found-grp
     2103           then do:
     2104               undo, return error "grplib-get-max-substring: Нет строк для вычисления общей подстроки".
     2105           end.
     2106           else do:
     2107               assign
     2108                   v-base-string  = temp_grplib_found-grp.full-name
     2109                   v-char-counter = 0
     2110               .
     2111               counter-block:
     2112               do while yes
     2113               on error undo, return error "grplib-get-max-substring: Ошибка вычисления продолжения имени группы."
     2114               :
     2115                   assign
     2116                       v-char-counter  = v-char-counter + 1
     2117                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
     2118                       v-names-counter = 0
     2119                   .
     2120                   compare-block:
     2121                   for each temp_grplib_found-grp
     2122                   :
     2123                       assign
     2124                           v-names-counter = v-names-counter + 1
     2125                       .
     2126                       if v-names-counter = 1
     2127                       then do:
     2128                           next compare-block.
     2129                       end.
     2130                       if substring( temp_grplib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
     2131                       then do:
     2132                           leave counter-block.
     2133                       end.
     2134                   end.
     2135                   if v-names-counter = 1
     2136                   then do:
     2137                       assign
     2138                           p-substring = v-base-string
     2139                       .
     2140                       return.
     2141                   end.
     2142               end.
     2143               assign
     2144                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
     2145               .
     2146           end.
     2147   end.
     2148   end procedure.
     2149   procedure grplib-is-terminal :
     2150   do
     2151   on error undo, return error "Ошибка процедуры grplib-is-terminal"
     2152   :
     2153   define input parameter p-node-code      as integer      no-undo.
     2154   define output parameter p-is-terminal   as logical      no-undo.
     2155       define buffer buf_gds-grp       for ub.gds-grp.
     2156       find first buf_gds-grp no-lock
     2157           where buf_gds-grp.upper-code = p-node-code
     2158       no-error .
     2159       if not available buf_gds-grp
     2160       then do:
     2161           assign
     2162               p-is-terminal = yes
     2163           .
     2164       end.
     2165       else do:
     2166           assign
     2167               p-is-terminal = no
     2168           .
     2169       end.
     2170   end.
     2171   end procedure.
     2172   procedure grplib-have-goods :
     2173   do
     2174   on error undo, return error
     2175   :
     2176   define input parameter p-node-code      as integer      no-undo.
     2177   define output parameter p-have-goods   as logical      no-undo.
     2178       define buffer buf_goods         for ub.goods.
     2179       find first buf_goods no-lock
     2180            where buf_goods.grp-code = p-node-code
     2181       no-error .
     2182       if available buf_goods
     2183       then do:
     2184           assign
     2185               p-have-goods = yes
     2186           .
     2187       end.
     2188       else do:
     2189           assign
     2190               p-have-goods = no
     2191           .
     2192       end.
     2193   end.
     2194   end procedure.
     2195   procedure grplib-find-by-substring :
     2196   do
     2197   on error undo, return error
     2198   :
     2199   define input parameter p-start-code         as integer      no-undo.
     2200   define input parameter p-full-search-string as character    no-undo.
     2201   define output parameter p-found-code        as integer      no-undo.
     2202   define output parameter p-full-name         as character    no-undo.
     2203       define variable v-start-code     as integer           no-undo.
     2204       define variable v-found          as logical  init no  no-undo.
     2205       define buffer buf_gds-grp       for ub.gds-grp.
     2206       search-grp:
     2207       for each buf_gds-grp no-lock
     2208           where buf_gds-grp.node-code > p-start-code
     2209       :
     2210           if index( buf_gds-grp.node-name, p-full-search-string ) <> 0
     2211           then do:
     2212               assign
     2213                   p-found-code = buf_gds-grp.node-code
     2214                   v-found      = yes
     2215               .
     2216               run grplib-get-full-name in this-procedure (
     2217                     input p-found-code
     2218                   , output p-full-name
     2219               ) no-error .
     2220               if error-status :error
     2221               then do:
     2222                   undo, return error "grplib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
     2223               end.
     2224               leave search-grp.
     2225           end.
     2226       end.
     2227       if v-found = yes
     2228       then do:
     2229       end.
     2230       else do:
     2231           assign
     2232               p-full-name  = ""
     2233               p-found-code = 0
     2234           .
     2235       end.
     2236   end.
     2237   end procedure.
     2238   procedure grplib-analyze-grp-name :
     2239   do
     2240   on error undo, return error
     2241   :
     2242   define input parameter p-grp-name       as character            no-undo.
     2243   define input parameter p-upper-code     as integer              no-undo.
     2244   define output parameter p-error-message as character init ""    no-undo.
     2245       define variable v-char-list     as character    no-undo.
     2246       define variable v-char-counter  as integer      no-undo.
     2247       define variable v-full-name     as character    no-undo.
     2248       if p-grp-name = "" then do:
     2249           assign
     2250               p-error-message = "Название группы не может быть пустым.".
     2251           .
     2252       end.
     2253       else do:
     2254           assign
     2255               v-char-list = "47,92,58,63,34,60,62,171,187,183"
     2256           .
     2257           do v-char-counter = 1 to num-entries( v-char-list )
     2258           :
     2259               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
     2260               then do:
     2261                   assign
     2262                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
     2263                   .
     2264                   return.
     2265               end.
     2266           end.
     2267           if p-upper-code > 0
     2268           then do:
     2269               run grplib-get-full-name in this-procedure (
     2270                     input p-upper-code
     2271                   , output v-full-name
     2272               ) no-error .
     2273               if error-status :error
     2274               then do:
     2275                   undo, return error "grplib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
     2276               end.
     2277               if length( v-full-name ) + 1 + length( p-grp-name ) > 350
     2278               then do:
     2279                   assign
     2280                       p-error-message = 'Полное название группы не может содержать более 350 символов.'
     2281                   .
     2282               end.
     2283           end.
     2284       end.
     2285   end.
     2286   end procedure.
     2287   procedure grplib-get-lvl-num :
     2288   define input parameter p-node-code  as integer      no-undo.
     2289   define output parameter p-lvl-num   as integer      no-undo.
     2290       define variable v-full-name    as character    no-undo.
     2291   do
     2292   on error undo, return error
     2293   :
     2294       run grplib-get-full-name in this-procedure (
     2295             input p-node-code
     2296           , output v-full-name
     2297       ).
     2298       assign
     2299           p-lvl-num = num-entries( v-full-name, chr(47) ) - 1
     2300       .
     2301       if p-lvl-num = -1
     2302       then do:
     2303           assign
     2304               p-lvl-num = 0
     2305           .
     2306       end.
     2307   end.
     2308   end procedure.
     2309   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2310   procedure grp-obj-write :
     2311   do
     2312   on error undo, return error
     2313   :
     2314   define input parameter p-node-code  like ub.gds-grp-obj.node-code      no-undo.
     2315   define input parameter p-host-code  as integer                          no-undo.
     2316   define input parameter p-obj-type   like ub.clients.obj-type            no-undo.
     2317   define input parameter p-obj-code   like ub.clients.obj-code            no-undo.
     2318   define input parameter p-min-increase like ub.gds-grp-obj.min-increase  no-undo.
     2319   define input parameter p-max-increase like ub.gds-grp-obj.max-increase  no-undo.
     2320   define input parameter p-increase-pc like ub.gds-grp-obj.increase-pc  no-undo.
     2321   define input parameter p-calc-method like ub.gds-grp-obj.calc-method no-undo .
     2322   define input parameter p-round-method like ub.gds-grp-obj.round-method no-undo .
     2323   define input parameter p-round-coef like ub.gds-grp-obj.round-coef no-undo .
     2324   define input parameter p-cli-type   like ub.clients.obj-type            no-undo.
     2325   define input parameter p-cli-code   like ub.clients.obj-code            no-undo.
     2326   define buffer buf_gds-grp-obj for ub.gds-grp-obj.
     2327       find first buf_gds-grp-obj exclusive-lock
     2328            where buf_gds-grp-obj.node-code  = p-node-code
     2329              and buf_gds-grp-obj.host-code  = p-host-code
     2330              and buf_gds-grp-obj.obj-type   = p-obj-type
     2331              and buf_gds-grp-obj.obj-code   = p-obj-code
     2332       no-error.
     2333       if not available buf_gds-grp-obj
     2334       then do:
     2335           create buf_gds-grp-obj.
     2336           assign
     2337                   buf_gds-grp-obj.node-code  = p-node-code
     2338                   buf_gds-grp-obj.host-code  = p-host-code
     2339                   buf_gds-grp-obj.obj-type   = p-obj-type
     2340                   buf_gds-grp-obj.obj-code   = p-obj-code
     2341           .
     2342       end.
     2343       assign
     2344       buf_gds-grp-obj.min-increase = p-min-increase
     2345       buf_gds-grp-obj.max-increase = p-max-increase
     2346       buf_gds-grp-obj.increase-pc = p-increase-pc
     2347       buf_gds-grp-obj.calc-method = p-calc-method
     2348       buf_gds-grp-obj.round-method = p-round-method
     2349       buf_gds-grp-obj.round-coef = p-round-coef
     2350       buf_gds-grp-obj.cli-type   = p-cli-type
     2351       buf_gds-grp-obj.cli-code   = p-cli-code
     2352       .
     2353   end.
     2354   end procedure.
     2355   procedure grp-obj-margin-value :
     2356   do
     2357   on error undo, return error
     2358   :
     2359   define input parameter p-node-code as integer      no-undo.
     2360   define input parameter p-obj-type  as character    no-undo.
     2361   define input parameter p-obj-code  as integer      no-undo.
     2362   define output parameter p-min-value as decimal      no-undo init ?.
     2363   define output parameter p-max-value as decimal      no-undo init ?.
     2364   define output parameter p-increase-pc as decimal      no-undo init ?.
     2365   define output parameter p-round-method as character no-undo init "":U.
     2366   define output parameter p-base as decimal no-undo init ?.
     2367   define output parameter p-range-margin     as integer      no-undo.
     2368   define output parameter p-exists-margin    as logical      no-undo.
     2369   define output parameter p-range-increase     as integer      no-undo.
     2370   define output parameter p-exists-increase    as logical      no-undo.
     2371   define output parameter p-range-rmethod     as integer no-undo .
     2372   define output parameter p-exists-rmethod    as logical no-undo .
     2373   define variable v-host-code as integer      no-undo.
     2374   DEFINE VARIABLE v-found as logical no-undo .
     2375   DEFINE VARIABLE v-exists as logical no-undo .
     2376   DEFINE VARIABLE v-range as integer no-undo .
     2377   DEFINE VARIABLE jj as integer no-undo .
     2378   DEFINE VARIABLE v-margin-found as logical no-undo .
     2379   DEFINE VARIABLE v-increase-found as logical no-undo .
     2380   DEFINE VARIABLE v-min-value as decimal      no-undo.
     2381   DEFINE VARIABLE v-max-value as decimal      no-undo.
     2382   DEFINE VARIABLE v-increase-pc as decimal      no-undo.
     2383   define variable v-round-method as character no-undo .
     2384   define variable v-base as decimal no-undo .
     2385   define variable v-print-code as character no-undo .
     2386   define buffer buf_gds-grp for ub.gds-grp.
     2387   find first buf_gds-grp no-lock where
     2388              buf_gds-grp.node-code = p-node-code no-error .
     2389   if not avail buf_gds-grp and p-node-code <> 0 then do:
     2390     message
     2391       vss-workfile vss-revision vss-description
     2392       skip "Не удалось найти группу товаров с кодом" p-node-code
     2393       view-as alert-box error .
     2394     undo, return error .
     2395   end.
     2396   if p-obj-type <> '' then do:
     2397   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2398   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2399     (input  p-obj-type
     2400     ,input  p-obj-code
     2401     ,output v-host-code
     2402     ) no-error .
     2403     if error-status :error
     2404     then do:
     2405         message
     2406           vss-workfile vss-revision vss-description
     2407           skip "Не удалось найти фирму объекта"
     2408           skip p-obj-type p-obj-code
     2409           skip return-value
     2410           skip trim(error-status :get-message(1))
     2411               trim(error-status :get-message(2))
     2412               trim(error-status :get-message(3))
     2413               trim(error-status :get-message(4))
     2414               trim(error-status :get-message(5))
     2415         view-as alert-box error.
     2416         undo, return error .
     2417     end.
     2418   end.
     2419   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
     2420   do while v-found = no and jj < 2:
     2421     if v-range <> 3 then do:
     2422       find first buf_gds-grp-obj no-lock
     2423           where buf_gds-grp-obj.node-code = p-node-code
     2424             and buf_gds-grp-obj.host-code = v-host-code
     2425             and buf_gds-grp-obj.obj-type  = p-obj-type
     2426             and buf_gds-grp-obj.obj-code  = p-obj-code
     2427       no-error .
     2428     end.
     2429     if v-range = 3 or not available buf_gds-grp-obj
     2430     then do:
     2431        if v-range <> 2 then do:
     2432           find first buf_gds-grp-obj no-lock
     2433               where buf_gds-grp-obj.node-code = p-node-code
     2434                 and buf_gds-grp-obj.host-code = v-host-code
     2435                 and buf_gds-grp-obj.obj-type  = ""
     2436                 and buf_gds-grp-obj.obj-code  = 0
     2437           no-error .
     2438         end.
     2439         if v-range = 2 or not available buf_gds-grp-obj
     2440         then do:
     2441             if v-range <> 1 then do:
     2442               find first buf_gds-grp-obj no-lock
     2443                   where buf_gds-grp-obj.node-code = p-node-code
     2444                   and buf_gds-grp-obj.host-code = 0
     2445                   and buf_gds-grp-obj.obj-type  = ""
     2446                   and buf_gds-grp-obj.obj-code  = 0
     2447               no-error .
     2448             end.
     2449             if v-range = 1 or not available buf_gds-grp-obj
     2450             then do:
     2451                 assign
     2452                     v-exists = no
     2453                 .
     2454             end.
     2455             else do:
     2456                 assign
     2457                     v-exists = yes
     2458                     v-range = 1
     2459                 .
     2460             end.
     2461         end.
     2462         else do:
     2463             assign
     2464                 v-exists = yes
     2465                 v-range  = 2
     2466             .
     2467         end.
     2468     end.
     2469     else do:
     2470         assign
     2471             v-exists = yes
     2472             v-range  = 3
     2473         .
     2474     end.
     2475     if available buf_gds-grp-obj
     2476     then do:
     2477       assign
     2478       v-min-value    = buf_gds-grp-obj.min-increase
     2479       v-max-value    = buf_gds-grp-obj.max-increase
     2480       v-increase-pc  = buf_gds-grp-obj.increase-pc
     2481       v-round-method = buf_gds-grp-obj.round-method
     2482       v-base         = buf_gds-grp-obj.round-coef
     2483       .
     2484       assign
     2485       p-exists-margin = (if v-min-value <> ? and v-max-value <> ? and p-min-value = ?
     2486                           then yes
     2487                           else p-exists-margin)
     2488       p-range-margin = if p-exists-margin and p-min-value = ?
     2489                         then v-range
     2490                         else p-range-margin
     2491       p-min-value   =  if p-exists-margin and  p-min-value = ?
     2492                         then v-min-value
     2493                         else p-min-value
     2494       p-max-value   =  if p-exists-margin and  p-max-value = ?
     2495                         then v-max-value
     2496                         else p-max-value
     2497       p-exists-increase = (if v-increase-pc <> ? and p-increase-pc = ?
     2498                           then yes
     2499                           else p-exists-increase)
     2500       p-range-increase = if p-exists-increase and p-increase-pc = ?
     2501                         then v-range
     2502                         else p-range-increase
     2503       p-increase-pc = (if p-exists-increase and p-increase-pc = ?
     2504                         then v-increase-pc
     2505                         else p-increase-pc)
     2506       p-exists-rmethod = if v-round-method <> "":U and p-round-method = "":U
     2507                           then yes
     2508                           else p-exists-rmethod
     2509       p-range-rmethod = (if p-exists-rmethod and p-round-method = "":U
     2510                           then v-range
     2511                           else p-range-rmethod)
     2512       p-round-method  = (if p-exists-rmethod and p-round-method = "":U
     2513                           then v-round-method
     2514                           else p-round-method)
     2515       p-base          = (if p-exists-rmethod and p-base = ?
     2516                           then v-base
     2517                           else p-base)
     2518       v-found =  (p-exists-margin and p-exists-increase and p-exists-rmethod) or (v-range <= 1)
     2519       jj = jj + 1
     2520       .
     2521     end.
     2522     else do:
     2523       assign
     2524       v-found =  (p-exists-margin and p-exists-increase and p-exists-rmethod ) or (v-range <= 1)
     2525       jj = jj + 1
     2526       .
     2527     end.
     2528   end.
     2529   end.
     2530   end procedure.
     2531   procedure grp-obj-income-cli-value :
     2532   do
     2533   on error undo, return error
     2534   :
     2535   define input parameter p-node-code as integer      no-undo.
     2536   define input parameter p-obj-type  as character    no-undo.
     2537   define input parameter p-obj-code  as integer      no-undo.
     2538   define output parameter p-cli-type as character    no-undo init ?.
     2539   define output parameter p-cli-code as integer      no-undo init ?.
     2540   define output parameter p-range-income-cli     as integer      no-undo.
     2541   define output parameter p-exists-income-cli    as logical      no-undo.
     2542   define variable v-host-code as integer      no-undo.
     2543   DEFINE VARIABLE v-found as logical no-undo .
     2544   DEFINE VARIABLE v-exists as logical no-undo .
     2545   DEFINE VARIABLE v-range as integer no-undo .
     2546   DEFINE VARIABLE jj as integer no-undo .
     2547   DEFINE VARIABLE v-income-cli-found as logical no-undo .
     2548   DEFINE VARIABLE v-cli-type-value as char      no-undo.
     2549   DEFINE VARIABLE v-cli-code-value as int      no-undo.
     2550   define buffer buf_gds-grp for ub.gds-grp.
     2551   find first buf_gds-grp no-lock where
     2552              buf_gds-grp.node-code = p-node-code no-error .
     2553   if not avail buf_gds-grp and p-node-code <> 0 then do:
     2554     message
     2555       vss-workfile vss-revision vss-description
     2556       skip "Не удалось найти группу товаров с кодом" p-node-code
     2557       view-as alert-box error .
     2558     undo, return error .
     2559   end.
     2560   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2561   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2562     (input  p-obj-type
     2563     ,input  p-obj-code
     2564     ,output v-host-code
     2565     ) no-error .
     2566   if error-status :error
     2567   then do:
     2568       message
     2569         vss-workfile vss-revision vss-description
     2570         skip "Не удалось найти фирму объекта"
     2571         skip p-obj-type p-obj-code
     2572         skip return-value
     2573         skip trim(error-status :get-message(1))
     2574              trim(error-status :get-message(2))
     2575              trim(error-status :get-message(3))
     2576              trim(error-status :get-message(4))
     2577              trim(error-status :get-message(5))
     2578       view-as alert-box error.
     2579       undo, return error .
     2580   end.
     2581   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
     2582   do while v-found = no and jj < 2:
     2583     if v-range <> 3 then do:
     2584       find first buf_gds-grp-obj no-lock
     2585           where buf_gds-grp-obj.node-code = p-node-code
     2586             and buf_gds-grp-obj.host-code = v-host-code
     2587             and buf_gds-grp-obj.obj-type  = p-obj-type
     2588             and buf_gds-grp-obj.obj-code  = p-obj-code
     2589       no-error .
     2590     end.
     2591     if v-range = 3 or not available buf_gds-grp-obj
     2592     then do:
     2593        if v-range <> 2 then do:
     2594           find first buf_gds-grp-obj no-lock
     2595               where buf_gds-grp-obj.node-code = p-node-code
     2596                 and buf_gds-grp-obj.host-code = v-host-code
     2597                 and buf_gds-grp-obj.obj-type  = ""
     2598                 and buf_gds-grp-obj.obj-code  = 0
     2599           no-error .
     2600         end.
     2601         if v-range = 2 or not available buf_gds-grp-obj
     2602         then do:
     2603             if v-range <> 1 then do:
     2604               find first buf_gds-grp-obj no-lock
     2605                   where buf_gds-grp-obj.node-code = p-node-code
     2606                   and buf_gds-grp-obj.host-code = 0
     2607                   and buf_gds-grp-obj.obj-type  = ""
     2608                   and buf_gds-grp-obj.obj-code  = 0
     2609               no-error .
     2610             end.
     2611             if v-range = 1 or not available buf_gds-grp-obj
     2612             then do:
     2613                 assign
     2614                     v-exists = no
     2615                 .
     2616             end.
     2617             else do:
     2618                 assign
     2619                     v-exists = yes
     2620                     v-range = 1
     2621                 .
     2622             end.
     2623         end.
     2624         else do:
     2625             assign
     2626                 v-exists = yes
     2627                 v-range  = 2
     2628             .
     2629         end.
     2630     end.
     2631     else do:
     2632         assign
     2633             v-exists = yes
     2634             v-range  = 3
     2635         .
     2636     end.
     2637     if available buf_gds-grp-obj
     2638     then do:
     2639       assign
     2640       v-cli-type-value    = buf_gds-grp-obj.cli-type
     2641       v-cli-code-value    = buf_gds-grp-obj.cli-code
     2642       .
     2643       assign
     2644       p-exists-income-cli = (if v-cli-type-value <> ? and v-cli-code-value <> ? and p-cli-type = ?
     2645                           then yes
     2646                           else p-exists-income-cli)
     2647       p-range-income-cli = if p-exists-income-cli and p-cli-type = ?
     2648                         then v-range
     2649                         else p-range-income-cli
     2650       p-cli-type   =  if p-exists-income-cli and  p-cli-type = ?
     2651                         then v-cli-type-value
     2652                         else p-cli-type
     2653       p-cli-code   =  if p-exists-income-cli and  p-cli-code = ?
     2654                         then v-cli-code-value
     2655                         else p-cli-code
     2656       v-found =  (p-exists-income-cli ) or (v-range <= 1)
     2657       jj = jj + 1
     2658       .
     2659     end.
     2660     else do:
     2661       assign
     2662       v-found =  (p-exists-income-cli  ) or (v-range <= 1)
     2663       jj = jj + 1
     2664       .
     2665     end.
     2666   end.
     2667   end.
     2668   end procedure.
     2669   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2670   define temp-table THpck-sent no-undo
     2671   field THfilename as character field THcrc-pack as character field THcredate as date field THcrenum as integer  field THcretimeint as integer field THcretime as character   field THrcvddate  as date field THpack-num  as integer  field THrcvdtimeint as integer field THrcvdtime  as character   field THrcvd  as logical      field THsendtxtdate as date field THsendtxttimeint as integer field THsendtxttime as character  field THtotal-recs  as integer  field THesys-id  as integer     index pi is unique primary THesys-id                  THpack-num                 index ircvd                THesys-id                  THrcvd
     2672   .
     2673   define temp-table THcurr-pack no-undo
     2674   field THfilename as character field THcrc-pack as character field THcredate as date field THcrenum as integer  field THcretimeint as integer field THcretime as character   field THrcvddate  as date field THpack-num  as integer  field THrcvdtimeint as integer field THrcvdtime  as character   field THrcvd  as logical      field THsendtxtdate as date field THsendtxttimeint as integer field THsendtxttime as character  field THtotal-recs  as integer  field THesys-id  as integer     index pi is unique primary THesys-id                  THpack-num                 index ircvd                THesys-id                  THrcvd
     2675   .
     2676   define temp-table THpck-rcvd no-undo
     2677   field THfilename as character
     2678   field THesys-id  as integer
     2679   field THcrc-pack as character
     2680   field THpack-num  as integer
     2681   field THrcvd-recs  as integer
     2682   field THrcvd as logical
     2683   field THtotal-recs  as integer
     2684   field THrcvddate  as date
     2685   field THrcvdtimeint as integer
     2686   field THrcvdtime  as character
     2687   index pi is unique primary
     2688   THesys-id
     2689   THpack-num
     2690   index rcvd
     2691   THesys-id
     2692   THrcvd
     2693   .
     2694   procedure get-header-by-rec :
     2695   define input  parameter p-gate-rec as character no-undo .
     2696   define output parameter p-tth as handle no-undo .
     2697   define variable v-ii as integer   no-undo .
     2698   define variable glog as logical   no-undo .
     2699   define variable v-rowid as rowid no-undo .
     2700   define variable v-tbl-name as character no-undo .
     2701   define variable v-longchar as longchar no-undo .
     2702   define variable v-txmlh as handle no-undo .
     2703   define buffer buf_clob-data for ub.clob-data.
     2704   main-block:
     2705   do
     2706   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info17, return-value, chr(10), error-status :get-message (1))
     2707   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info17 )
     2708   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info17 )
     2709   :
     2710     run gen-row-keyr in  this-procedure  (
     2711                                           input  p-gate-rec
     2712                                           ,input  ?
     2713                                           ,input  "ub"
     2714                                           ,input  ?
     2715                                           ,input  NO-LOCK
     2716                                           ,output v-rowid
     2717                                           ,output v-tbl-name   ) no-error.
     2718       find first buf_clob-data no-lock where
     2719                 rowid(buf_clob-data) = v-rowid  no-error.
     2720       if not available buf_clob-data then do:
     2721         undo, return error substitute("Не найден CLOB  &1"
     2722                                         , p-gate-rec
     2723                                         ).
     2724       end.
     2725       assign
     2726       v-longchar = buf_clob-data.cdata
     2727       .
     2728       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     2729       if error-status :error then do:
     2730         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     2731       end.
     2732       create temp-table p-tth .
     2733       glog = p-tth:READ-XMLSCHEMA( "LONGCHAR"
     2734                                     , v-longchar
     2735                                     , ?
     2736                                     , ?
     2737                                     , ?
     2738                                     ) no-error.
     2739       v-longchar = '':U.
     2740       define variable v-esm as character no-undo .
     2741       v-esm = error-status:get-message(1).
     2742       if error-status :error
     2743       or not glog
     2744       then do:
     2745         delete object p-tth no-error.
     2746         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     2747                                    , p-gate-rec
     2748                                    , buf_clob-data.file-name_
     2749                                    , chr(10)
     2750                                    , v-esm
     2751                                     ).
     2752       end.
     2753   end.
     2754   end procedure.
     2755   define temp-table temp-gds-grp-obj no-undo like ub.gds-grp-obj.
     2756   define variable v-current-node-code as integer no-undo .
     2757   define variable v-current-host-code as integer no-undo .
     2758   define variable v-current-obj-type as character no-undo .
     2759   define variable v-current-obj-code as integer no-undo .
     2760   define variable v-current-lock as integer no-undo .
     2761   define variable v-current-wait as integer no-undo .
     2762   define variable v-save as integer no-undo .
     2763   define variable v-esys-cmd-proc-handle as handle no-undo .
     2764   define variable v-esys-cmd-code as integer no-undo .
     2765   define variable log-file-name                as character      no-undo init "process-gds-grp-list.txt".
     2766   define variable v-view-log                   as logical        no-undo .
     2767   define variable v-stop                       as logical        no-undo .
     2768   define variable v-current-db-num as integer no-undo .
     2769   define variable v-last-error-message as character no-undo .
     2770   define variable file-name as char.
     2771   define variable v-sign as integer no-undo .
     2772   define variable v-gate-rec as character no-undo .
     2773   define variable num-rec as integer no-undo .
     2774   define variable num-rec-ok as integer no-undo .
     2775   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2776   procedure set-error :
     2777   define input parameter p-mess as character no-undo .
     2778     do
     2779     on error undo, return error
     2780     :
     2781        assign
     2782        v-last-error-message = p-mess.
     2783     end.
     2784   end procedure.
     2785   define buffer buf_temp-cmd for temp-cmd.
     2786   define shared temp-table tt0-rule-call-param no-undo like ub.rule-call-param.
     2787    define variable p-xsd-file as character no-undo.
     2788    define variable p-pck-num-rec as integer no-undo .
     2789   on delete of this-procedure do:
     2790     run garbcoll_clear in this-procedure .
     2791     for each temp-gds-grp-obj:
     2792       delete temp-gds-grp-obj.
     2793     end.
     2794   end.
     2795   run load-ruleset-context in this-procedure ( input p-ruleset-id) no-error.
     2796   if error-status:error then do:
     2797     undo, return error return-value .
     2798   end.
     2799   define variable ExpData1 as class Route-data_ no-undo .
     2800   ExpData1 = new Route-data_( input parparentproc, input p-parent-handle, input p-log-handle, input this-procedure:handle) .
     2801   if not this-procedure:persistent then do:
     2802     run proc-main in this-procedure no-error .
     2803     if error-status:error then do:
     2804         run garbcoll_clear in this-procedure .
     2805       for each temp-gds-grp-obj:
     2806         delete temp-gds-grp-obj.
     2807       end.
     2808         undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     2809     end.
     2810     run garbcoll_clear in this-procedure .
     2811     for each temp-gds-grp-obj:
     2812       delete temp-gds-grp-obj.
     2813     end.
     2814   end.
     2815   procedure proc-main :
     2816   _main:
     2817   do
     2818   on error undo, return error substitute( "&1&2&3&2&4", return-value, chr(10), error-status :get-message (1), v-last-error-message)
     2819   :
     2820     define variable v-ii as integer no-undo .
     2821     define variable v-loc-file-name as character no-undo .
     2822     define variable v-next-file as logical no-undo .
     2823     define variable v-margins-range     as integer           no-undo.
     2824     define variable v-margins-exists    as logical           no-undo.
     2825     define variable v-increase-range    as integer           no-undo.
     2826     define variable v-increase-exists   as logical           no-undo.
     2827     define variable v-min-marg          as decimal           no-undo.
     2828     define variable v-max-marg          as decimal           no-undo.
     2829     define variable v-increase-pc       as decimal           no-undo.
     2830     define variable v-round-method      as character         no-undo .
     2831     define variable v-rmethod-range     as integer           no-undo .
     2832     define variable v-rmethod-exists    as logical           no-undo .
     2833     define variable v-base              as decimal           no-undo .
     2834     define variable v-round-method-str  as character         no-undo .
     2835     define variable v-root-code         as integer no-undo .
     2836     define buffer buf_gds-grp for ub.gds-grp.
     2837     define buffer buf_gds-grp-obj for ub.gds-grp-obj.
     2838     v-loc-file-name = file-name.
     2839     for each temp-gds-grp-obj:
     2840       delete temp-gds-grp-obj.
     2841     end.
     2842     create temp-gds-grp-obj.
     2843     run grplib-get-root-code in this-procedure ( output v-root-code) .
     2844     _stroka:
     2845     for each ggrp-list
     2846     break
     2847     by entry(1, ggrp-list.full-name, chr(47))
     2848     On error undo _stroka, next _stroka
     2849     :
     2850       if ggrp-list.node-code = v-root-code then do:
     2851               run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Корневая группа товаров не экспортируется (вн код.&1)", ggrp-list.node-code)).                      assign v-view-log = yes.
     2852         next _stroka.
     2853       end.
     2854       assign
     2855       v-current-node-code = ggrp-list.node-code
     2856       num-rec = num-rec + 1
     2857       temp-gds-grp-obj.round-method = ?
     2858       temp-gds-grp-obj.round-coef = ?
     2859       .
     2860       IF num-rec = 1
     2861       or num-rec modulo p-pck-num-rec = 1
     2862       THEN do:
     2863         IF  ExpData1:route-data_read-xmlschema( INPUT p-xsd-file) = false  THEN do:
     2864           undo _main, return error v-last-error-message .
     2865         end.
     2866       end.
     2867       if p-save >= 0 then do:
     2868         find first buf_gds-grp exclusive-lock where
     2869                   buf_gds-grp.node-code = ggrp-list.node-code no-error.
     2870       end.
     2871       else do:
     2872         find first buf_gds-grp no-lock where
     2873                   buf_gds-grp.node-code = ggrp-list.node-code no-error.
     2874       end.
     2875       if not available buf_gds-grp then do:
     2876               run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не найдена содержащаяся в списке группа товаров с вн.кодом &1", ggrp-list.node-code)).                      assign v-view-log = yes.
     2877         next _stroka.
     2878       end.
     2879       find first buf_gds-grp-obj no-lock where
     2880               buf_gds-grp-obj.node-code  = ggrp-list.node-code
     2881              and buf_gds-grp-obj.host-code  = 0
     2882              and buf_gds-grp-obj.obj-type   = "":U
     2883              and buf_gds-grp-obj.obj-code   = 0 no-error  .
     2884       ExpData1:route-data_create-record( INPUT "gds-grp-01") .
     2885       ExpData1:route-data_copy-record( INPUT "gds-grp-01", INPUT  (buffer ggrp-list:handle) ) .
     2886       ExpData1:route-data_copy-field( INPUT "gds-grp-01"
     2887                                       , INPUT "full-name"
     2888                                       , INPUT (buffer ggrp-list:handle:buffer-field("full-name")) ) .
     2889       if available buf_gds-grp-obj then do:
     2890         ExpData1:route-data_copy-field( INPUT "gds-grp-01"
     2891                                         , INPUT "round-method"
     2892                                         , INPUT (buffer buf_gds-grp-obj:handle:buffer-field("round-method")) ) .
     2893         ExpData1:route-data_copy-field( INPUT "gds-grp-01"
     2894                                         , INPUT "round-coef"
     2895                                         , INPUT (buffer buf_gds-grp-obj:handle:buffer-field("round-coef")) ) .
     2896       end.
     2897       else do:
     2898         run grp-obj-margin-value in this-procedure (
     2899                                   input ggrp-list.node-code
     2900                                 , input ""
     2901                                 , input 0
     2902                                 , output v-min-marg
     2903                                 , output v-max-marg
     2904                                 , output v-increase-pc
     2905                                 , output v-round-method
     2906                                 , output v-base
     2907                                 , output v-margins-range
     2908                                 , output v-margins-exists
     2909                                 , output v-increase-range
     2910                                 , output v-increase-exists
     2911                                 , output v-rmethod-range
     2912                                 , output v-rmethod-exists
     2913                             ) no-error .
     2914         assign
     2915         temp-gds-grp-obj.round-method = v-round-method
     2916         temp-gds-grp-obj.round-coef = v-base
     2917         .
     2918         ExpData1:route-data_copy-field( INPUT "gds-grp-01"
     2919                                         , INPUT "round-method"
     2920                                         , INPUT (buffer temp-gds-grp-obj:handle:buffer-field("round-method")) ) .
     2921         ExpData1:route-data_copy-field( INPUT "gds-grp-01"
     2922                                         , INPUT "round-coef"
     2923                                         , INPUT (buffer temp-gds-grp-obj:handle:buffer-field("round-coef")) ) .
     2924       end.
     2925       num-rec-ok = num-rec-ok + 1.
     2926       run write-counter in p-log-handle ( input substitute("Обработано групп товаров: &1, из них удачно: &2", num-rec, num-rec-ok)).
     2927       run get-stop-state in p-log-handle ( output v-stop) no-error .
     2928       if v-stop then do:
     2929           run write-log-and-file in p-log-handle (
     2930                                                   input 1
     2931                                                 , input log-file-name
     2932                                                 , input 1
     2933                                                 , input substitute("Процесс прерван пользователем")).
     2934           leave _stroka.
     2935       end.
     2936       if num-rec modulo p-pck-num-rec = 0 then do:
     2937         v-next-file = yes.
     2938       end.
     2939       if last( entry(1, ggrp-list.full-name, chr(47)))
     2940       or (v-next-file and last-of(entry(1, ggrp-list.full-name, chr(47))))
     2941       then do:
     2942         v-next-file = no.
     2943         if not ExpData1:write-xml(v-loc-file-name, integer(trunc(num-rec / p-pck-num-rec, 0))) then do:
     2944           undo _main, return error .
     2945         end.
     2946         v-loc-file-name = rum-fn_get-next-file-name ( file-name , integer(trunc(num-rec / p-pck-num-rec, 0))).
     2947               ExpData1:Route-data_clear-data ( ) .
     2948       end.
     2949     end.
     2950     run write-log-and-file in p-log-handle (
     2951           input 1
     2952         , input log-file-name
     2953         , input 1
     2954         , input substitute("Обработано групп товаров: &1, из них удачно: &2", num-rec, num-rec-ok)).
     2955     ExpData1:route-data_clear-xmlschema ( ).
     2956   end.
     2957   end procedure.
     2958   procedure load-ruleset-context :
     2959   define input parameter p-ruleset-id as integer no-undo .
     2960   define buffer buf_rule-call-param for tt0-rule-call-param.
     2961     do
     2962     on error undo, return error
     2963     :
     2964     find first buf_rule-call-param no-lock where
     2965   buf_rule-call-param.codex_id = p-codex-id
     2966   and buf_rule-call-param.ruleset_id = p-ruleset-id
     2967   and buf_rule-call-param.call_id = p-call-id
     2968   and buf_rule-call-param.order_id = p-order-id
     2969   and buf_rule-call-param.rule_id = p-rule-id
     2970   and buf_rule-call-param.param-name = "p-xsd-file"
     2971    no-error.
     2972   if available buf_rule-call-param then do:
     2973   assign p-xsd-file = buf_rule-call-param.param-value-character.
     2974   end.
     2975    find first buf_rule-call-param no-lock where
     2976   buf_rule-call-param.codex_id = p-codex-id
     2977   and buf_rule-call-param.ruleset_id = p-ruleset-id
     2978   and buf_rule-call-param.call_id = p-call-id
     2979   and buf_rule-call-param.order_id = p-order-id
     2980   and buf_rule-call-param.rule_id = p-rule-id
     2981   and buf_rule-call-param.param-name = "p-pck-num-rec"
     2982    no-error.
     2983   if available buf_rule-call-param then do:
     2984   assign p-pck-num-rec = buf_rule-call-param.param-value-integer.
     2985   end.
     2986       case p-ruleset-id:
     2987         when 1 then do:
     2988           assign
     2989           v-sign = 1
     2990           v-current-host-code = p-host-code
     2991           v-current-obj-type = p-obj-type
     2992           v-current-obj-code = p-obj-code
     2993           v-current-db-num = g#db-num
     2994           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     2995           file-name  = p-process-file-name
     2996           .
     2997         end.
     2998       end case.
     2999     end.
     3000   end procedure.
