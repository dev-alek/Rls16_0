     2694     .
     2695     _ii:
     2696     do v-ii = 1 to 5:
     2697       if v-stat-list[v-ii] = '' then next.
     2698       assign
     2699       v-waiting-stfl-i = lookup(v-waiting-stfl, v-stat-list[v-ii], chr(3))
     2700       v-old-stfl-i = lookup(v-old-stfl, v-stat-list[v-ii], chr(3))
     2701       v-new-stfl-i = lookup(v-new-stfl, v-stat-list[v-ii], chr(3))
     2702       .
     2703       if v-waiting-stfl-i = 0
     2704       or v-old-stfl-i = 0
     2705       or v-new-stfl-i = 0
     2706       then do:
     2707         next _ii.
     2708         end.
     2709       if v-old-stfl-i < v-waiting-stfl-i
     2710       and v-new-stfl-i = v-waiting-stfl-i then do:
     2711         assign
     2712         p-is-waiting-status = yes
     2713         p-direction = '<закрытие документа>':U + chr(4) + "to".
     2714         return.
     2715       end.
     2716       if v-old-stfl-i < v-waiting-stfl-i
     2717       and v-new-stfl-i > v-waiting-stfl-i then do:
     2718         assign
     2719         p-is-waiting-status = yes
     2720         p-direction = '<закрытие документа>':U + chr(4) + "to-up".
     2721         return.
     2722       end.
     2723       if v-new-stfl-i = v-waiting-stfl-i
     2724       and v-old-stfl-i > v-waiting-stfl-i then do:
     2725         assign
     2726         p-is-waiting-status = yes
     2727         p-direction = '<открытие документа>':U + chr(4) + "to".
     2728         return.
     2729         end.
     2730       if v-new-stfl-i < v-waiting-stfl-i
     2731       and v-old-stfl-i > v-waiting-stfl-i then do:
     2732         assign
     2733         p-is-waiting-status = yes
     2734         p-direction = '<открытие документа>':U + chr(4) + "to-down".
     2735         return.
     2736         end.
     2737       if v-old-stfl-i = v-waiting-stfl-i
     2738       and v-new-stfl-i > v-waiting-stfl-i then do:
     2739         assign
     2740         p-is-waiting-status = yes
     2741         p-direction = '<закрытие документа>':U + chr(4) + "from".
     2742         return.
     2743       end.
