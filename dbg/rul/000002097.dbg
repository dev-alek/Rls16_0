     3594     define variable p-xsd-file as character no-undo.
     3595   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3596   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
     3597   run gbl/getobjsrvhndl.p (input-output ObjSrv).
     3598   function context_begin-esys-command return logical
     3599   (
     3600       input p-esys-id-list as character
     3601      ,input-output p-esys-cmd-proc-handle as handle
     3602      ,output p-esys-cmd-code as integer
     3603   ):
     3604      if not valid-handle(p-esys-cmd-proc-handle )
     3605      then do:
     3606        run nws/cmd-bush.p persistent set p-esys-cmd-proc-handle no-error .
     3607        if error-status :error
     3608        then do:
     3609           delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( substitute("&1 &2 &3&4Ошибка при запуске процедуры cmd-bush.p&4" +
     3610                                              "&5&4&6"
     3611                                              ,vss-workfile
     3612                                              ,vss-revision
     3613                                              ,vss-description
     3614                                              ,chr(10)
     3615                                              ,error-status:get-message(1)
     3616                                              ,return-value )).
     3617        end.
     3618        run begin-create-command in p-esys-cmd-proc-handle
     3619          (input 'cmd-esys-general':U
     3620          ,input p-esys-id-list
     3621          ,output p-esys-cmd-code
     3622          ) no-error.
     3623        if error-status :error
     3624        then do:
     3625          delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при создании команды &1&2&3&1&4"
     3626                                                           , 'cmd-esys-general':U
     3627                                                           , error-status:get-message(1)
     3628                                                           , return-value
     3629                                                           )).
     3630          return no .
     3631        end.
     3632        return yes.
     3633      end.
     3634   end.
     3635   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3636   function context_send-esys-command return int64
     3637   (
     3638       input p-esys-id-list as character
     3639      ,input p-esys-cmd-proc-handle as handle
     3640      ,input p-esys-cmd-code as integer
     3641      ,input p-user-id as character
     3642   ):
     3643      define variable v-dmp-ord-int64 as int64 no-undo .
     3644      if valid-handle(p-esys-cmd-proc-handle )
     3645      then do:
     3646         run send-command-esys in p-esys-cmd-proc-handle
     3647             (input p-esys-cmd-code
     3648             ,input p-esys-id-list
     3649             ,input p-user-id
     3650             ,output v-dmp-ord-int64
     3651             ) no-error.
     3652         if error-status :error
     3653         then do:
     3654            delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при отсылке во внешнюю систему &1 команды с кодом &2&3&4&3&5"
     3655                                                           , p-esys-id-list
     3656                                                           , p-cmd-code
     3657                                                           , chr(10)
     3658                                                           , error-status:get-message(1)
     3659                                                           , return-value
     3660                                                           )).
     3661            return 0.
     3662         end.
     3663         delete procedure p-esys-cmd-proc-handle no-error.
     3664         return v-dmp-ord-int64.
     3665      end.
     3666      else do:
     3667         delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при отсылке во внешнюю систему &1 команды с кодом &2&3&4&3&5"
     3668                                                       , p-esys-id-list
     3669                                                       , p-cmd-code
     3670                                                       , chr(10)
     3671                                                       , error-status:get-message(1)
     3672                                                       , return-value
     3673                                                       )).
     3674         return 0 .
     3675      end.
     3676   end.
     3677   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3678   function context_set-custom-esys-pck-name return logical
     3679   (
     3680       input p-esys-cmd-proc-handle as handle
     3681      ,input p-esys-cmd-code as integer
     3682      ,input p-custom-pck-name as character
     3683   ):
