     2813       and v-new-stfl-i = v-waiting-stfl-i then do:
     2814         assign
     2815         p-is-waiting-status = yes
     2816         p-direction = '<закрытие документа>':U + chr(4) + "to".
     2817         return.
     2818       end.
     2819       if v-old-stfl-i < v-waiting-stfl-i
     2820       and v-new-stfl-i > v-waiting-stfl-i then do:
     2821         assign
