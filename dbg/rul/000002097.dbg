     2236         p-exist = yes.
     2237       end.
     2238     end.
     2239   end procedure.
     2240   procedure ordlineattr-delete :
     2241     do
     2242     on error undo, return error return-value
     2243     :
     2244       define input parameter p-doc-code like ub.ord-line-attr.doc-code   no-undo .
     2245       define input parameter p-gds-code like ub.ord-line-attr.gds-code   no-undo .
     2246       define input parameter p-code     like ub.ord-line-attr.attr-code  no-undo .
     2247       define output parameter p-deleted  as logical no-undo.
     2248       define buffer buf_ord-line-attr for ub.ord-line-attr .
     2249       define variable v-type           as character no-undo .
     2250       define variable v-format         as character no-undo .
     2251       define variable v-fillin_width   as integer   no-undo .
     2252       define variable v-fillin_height  as integer   no-undo .
     2253       define variable v-label          as character no-undo .
     2254       define variable v-user-can-edit  as logical   no-undo .
     2255       define variable v-output-display as logical   no-undo .
     2256       define variable v-proc           as character no-undo .
     2257       define variable v-func           as character no-undo .
     2258       define variable v-sort           as integer   no-undo .
     2259       define variable v-other          as character no-undo .
     2260       run ordlineattr-code in this-procedure
     2261         (input  p-code
     2262         ,output v-type
     2263         ,output v-format
     2264         ,output v-fillin_width
     2265         ,output v-fillin_height
     2266         ,output v-label
     2267         ,output v-user-can-edit
     2268         ,output v-output-display
     2269         ,output v-proc
     2270         ,output v-func
     2271         ,output v-sort
     2272         ,output v-other
     2273         ) no-error .
     2274       if error-status :error then do:
     2275         undo, return error return-value .
     2276       end.
     2277       find first buf_ord-line-attr exclusive-lock
     2278         where buf_ord-line-attr.doc-code  = p-doc-code
     2279           and buf_ord-line-attr.gds-code  = p-gds-code
     2280           and buf_ord-line-attr.attr-code = p-code
     2281         no-error NO-WAIT.
     2282       if not available buf_ord-line-attr then do:
     2283         p-deleted = no.
     2284       end.
     2285       else do:
     2286         delete buf_ord-line-attr.
     2287         p-deleted = yes.
     2288       end.
     2289     end.
     2290   end procedure.
     2291   procedure ordlineattr-code :
     2292     do on error undo, return error return-value
     2293     :
     2294       define input  parameter p-code           as character no-undo .
     2295       define output parameter p-type           as character no-undo .
     2296       define output parameter p-format         as character no-undo .
     2297       define output parameter p-fillin_width   as integer   no-undo .
     2298       define output parameter p-fillin_height  as integer   no-undo .
     2299       define output parameter p-label          as character no-undo .
     2300       define output parameter p-user-can-edit  as logical   no-undo .
     2301       define output parameter p-output-display as logical   no-undo .
     2302       define output parameter p-proc           as character no-undo .
     2303       define output parameter p-func           as character no-undo .
     2304       define output parameter p-sort           as integer   no-undo .
     2305       define output parameter p-other          as character no-undo .
     2306       case p-code :
     2307               when 'cycle-cli-qnty':U then do:     assign     p-label          = "Количество"     p-type           = 'D':U      p-format         = ">>>>>>>>>>>>>>>9.999"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "Количество"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
     2308               when 'ord-EAN13':U then do:     assign     p-label          = "EAN в EDI"     p-type           = 'C':U      p-format         = "X(13)"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "EAN в EDI"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
     2309         otherwise do:
     2310           undo, return error "неизвестный атрибут строки заказа" + " " + p-code .
     2311         end.
     2312       end.
     2313     end.
     2314   end procedure.
     2315   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2316   procedure statq_has-waiting-stat :
     2317   define input parameter p-oldbh              as handle no-undo .
     2318   define input parameter p-newbh              as handle no-undo .
     2319   define input parameter p-changed-fields     as character no-undo .
     2320   define input parameter p-waiting-status     as character no-undo .
     2321   define input parameter p-waiting-flag       as logical no-undo .
     2322   define input parameter p-waiting-stati      as integer no-undo .
     2323   define output parameter p-is-waiting-status as logical no-undo .
     2324   define output parameter p-direction         as character no-undo .
     2325   define variable v-has-newbh as logical no-undo .
     2326   define variable v-has-oldbh as logical no-undo .
     2327   define variable v-changed-fields as character no-undo .
     2328   define variable v-ii as integer no-undo .
     2329   define variable v-flag as logical   no-undo .
     2330   define variable v-some-bh as handle no-undo .
     2331   assign
     2332   v-has-oldbh = valid-handle(p-oldbh) and p-oldbh:available
     2333   v-has-newbh = valid-handle(p-newbh) and p-newbh:available
     2334   v-flag = false
     2335   .
     2336   if v-has-newbh then do:
     2337     if p-changed-fields = '' then do:
     2338       v-changed-fields = "status_,flag_".
     2339       do v-ii = 1 to num-entries(v-changed-fields):
     2340         if p-oldbh:buffer-field(entry(v-ii, v-changed-fields)):buffer-value <> p-newbh:buffer-field(entry(v-ii, v-changed-fields)):buffer-value then do:
     2341           v-flag = yes.
     2342           leave.
     2343         end.
     2344       end.
     2345       if not v-flag then do:
     2346          assign
     2347            p-direction          = ""
     2348            p-is-waiting-status   = false
     2349          .
     2350          return .
     2351       end.
     2352     end.
     2353     else do:
     2354       if lookup("status_", p-changed-fields) = 0
     2355       and lookup("flag_", p-changed-fields) = 0
     2356       and not(p-newbh:new) then do:
     2357          assign
     2358            p-direction          = ""
     2359            p-is-waiting-status   = false
     2360          .
     2361          return .
     2362       end.
     2363       else do:
     2364         if lookup("status_", p-changed-fields) > 0  and lookup("flag_", p-changed-fields) > 0 and
     2365           p-newbh::status_ = p-waiting-status and
     2366           (p-newbh:table = 'price-doc':U or p-newbh::flag_   = p-waiting-flag)   then do:
     2367             assign
     2368                 p-direction          = '<закрытие документа>':U
     2369                 p-is-waiting-status   = true
     2370             .
     2371             return .
     2372          end.
     2373         if lookup("status_", p-changed-fields) > 0  and lookup("flag_", p-changed-fields) = 0 and
     2374           p-newbh::status_ = p-waiting-status  then do:
     2375             assign
     2376                 p-direction          = '<закрытие документа>':U
     2377                 p-is-waiting-status   = true
     2378             .
     2379             return .
     2380          end.
     2381         if lookup("status_", p-changed-fields) = 0  and lookup("flag_", p-changed-fields) > 0 and
     2382         (p-newbh:table = 'price-doc':U or p-newbh::flag_   = p-waiting-flag )  then do:
     2383             assign
     2384                 p-direction          = '<закрытие документа>':U
     2385                 p-is-waiting-status   = true
     2386             .
     2387             return .
     2388          end.
     2389           if lookup("status_", p-changed-fields) > 0  and lookup("flag_", p-changed-fields) > 0 and
     2390           p-newbh::status_ = p-waiting-status and
     2391           (p-newbh:table = 'price-doc':U or p-waiting-flag = ? )  then do:
     2392             assign
     2393                 p-direction          = '<закрытие документа>':U
     2394                 p-is-waiting-status   = true
     2395             .
     2396             return .
     2397          end.
     2398       end.
     2399     end.
     2400   end.
     2401   else do:
     2402     if p-changed-fields = '' then do:
     2403       if p-oldbh::status_ = p-waiting-status
     2404       and (p-oldbh:table = 'price-doc':U
     2405           or
     2406         (p-waiting-flag = ?
     2407         or p-oldbh::flag_ = p-waiting-flag)) then do:
     2408         assign
     2409         p-direction = 'удаление':U
     2410         p-is-waiting-status = yes.
     2411         return.
     2412       end.
     2413       else do:
     2414         assign
     2415         p-direction          = ""
     2416         p-is-waiting-status = no.
     2417         return.
     2418       end.
     2419     end.
     2420     else do:
     2421       if lookup("status_", p-changed-fields) = 0
     2422       and lookup("flag_", p-changed-fields) = 0
     2423       then do:
     2424          assign
     2425             p-is-waiting-status  = false
     2426             p-direction          = ""
     2427          .
     2428          return .
     2429       end.
     2430     end.
     2431   end.
     2432   if v-has-newbh then do:
     2433     v-some-bh = p-newbh.
     2434   end.
     2435   else do:
     2436     v-some-bh = p-oldbh.
     2437   end.
     2438   case v-some-bh:table :
     2439     when 'ord-doc':U  then do:
     2440        if v-some-bh::doc-type = 'ОР':U or v-some-bh::doc-type = 'ОП':U then do:
     2441        if v-some-bh::doc-type = 'ОР':U then do:
     2442           run ord-orc in this-procedure
     2443           ( input  p-oldbh
     2444            ,input  p-newbh
     2445            ,input  p-changed-fields
     2446            ,input  p-waiting-status
     2447            ,input  p-waiting-flag
     2448            ,output p-is-waiting-status
     2449            ,output p-direction  )  .
     2450        end.
     2451        if v-some-bh::doc-type = 'ОП':U then do:
     2452           run ord-op in this-procedure
     2453           ( input  p-oldbh
     2454            ,input  p-newbh
     2455            ,input  p-changed-fields
     2456            ,input  p-waiting-status
     2457            ,input  p-waiting-flag
     2458            ,output p-is-waiting-status
     2459            ,output p-direction  )  .
     2460        end.
     2461        end.
     2462        else do:
     2463          assign
     2464             p-is-waiting-status  = false
     2465             p-direction          = ""
     2466          .
     2467        end.
     2468     end.
     2469     when 'ord-doc-rcv':U  then do:
     2470           run ord-rcv in this-procedure
     2471           ( input  p-oldbh
     2472            ,input  p-newbh
     2473            ,input  p-changed-fields
     2474            ,input  p-waiting-status
     2475            ,input  p-waiting-flag
     2476            ,output p-is-waiting-status
     2477            ,output p-direction  )  .
     2478     end.
     2479     when 'trn-doc':U  then do:
     2480           run stat-graf-trn in this-procedure
     2481           ( input  p-oldbh
     2482            ,input  p-newbh
     2483            ,input  p-changed-fields
     2484            ,input  p-waiting-status
     2485            ,input  p-waiting-flag
     2486            ,output p-is-waiting-status
     2487            ,output p-direction  )  .
     2488     end.
     2489     when 'price-doc':U then do:
     2490       run stat-graf-price in this-procedure
     2491           ( input  p-oldbh
     2492            ,input  p-newbh
     2493            ,input  p-changed-fields
     2494            ,input  p-waiting-status
     2495            ,input  p-waiting-flag
     2496            ,output p-is-waiting-status
     2497            ,output p-direction  )  .
     2498     end.
     2499     when 'inkas':U then do:
     2500           run stat-graf-inkas in this-procedure
     2501           ( input  p-oldbh
     2502            ,input  p-newbh
     2503            ,input  p-changed-fields
     2504            ,input  p-waiting-status
     2505            ,input  p-waiting-flag
     2506            ,output p-is-waiting-status
     2507            ,output p-direction  )  .
     2508     end.
     2509     otherwise do:
     2510          assign
     2511             p-is-waiting-status  = false
     2512             p-direction          = ""
     2513          .
     2514     end.
     2515   end case.
     2516   return .
     2517   end procedure.
     2518   procedure ord-op :
     2519   define input parameter p-oldbh              as handle no-undo .
     2520   define input parameter p-newbh              as handle no-undo .
     2521   define input parameter p-changed-fields     as character no-undo .
     2522   define input parameter p-waiting-status     as character no-undo .
     2523   define input parameter p-waiting-flag       as logical no-undo .
     2524   define output parameter p-is-waiting-status as logical no-undo .
     2525   define output parameter p-direction         as character no-undo .
     2526   define variable v-stat-list as character no-undo extent 5.
     2527   define variable v-waiting-stfl as character no-undo .
     2528   define variable v-old-stfl as character no-undo .
     2529   define variable v-new-stfl as character no-undo .
     2530   define variable v-waiting-stfl-i as integer no-undo .
     2531   define variable v-old-stfl-i as integer no-undo .
     2532   define variable v-new-stfl-i as integer no-undo .
     2533   define variable v-ii as integer no-undo .
     2534     do
     2535     on error undo, return error return-value
     2536     :
     2537   assign
     2538   v-stat-list[1] =
     2539                    ''            +  chr(3) +
     2540                    'новый':U    +  chr(3) +
     2541                    'согласование':U +  chr(3) +
     2542                    'поставка':U    +  chr(3) +
     2543                    'закрыто':U  +  chr(3) +
     2544                    'факт':U
     2545   v-stat-list[2] =
     2546                    ''            +  chr(3) +
     2547                    'новый':U    +  chr(3) +
     2548                    'отказ':U
     2549   v-stat-list[3] =
     2550                    ''            +  chr(3) +
     2551                    'новый':U    +  chr(3) +
     2552                    'согласование':U +  chr(3) +
     2553                    'отказ':U
     2554   v-stat-list[4] =
     2555                    ''            +  chr(3) +
     2556                    'новый':U    +  chr(3) +
     2557                    'согласование':U +  chr(3) +
     2558                    'поставка':U    +  chr(3) +
     2559                    'отказ':U
     2560   v-stat-list[5] =
     2561                    ''            +  chr(3) +
     2562                    'новый':U    +  chr(3) +
     2563                    'согласование':U +  chr(3) +
     2564                    'поставка':U    +  chr(3) +
     2565                    'закрыто':U  +  chr(3) +
     2566                    'отказ':U
     2567   .
     2568     assign
     2569     v-waiting-stfl = p-waiting-status
     2570     .
     2571     assign
     2572     v-old-stfl = p-oldbh::status_
     2573     .
     2574     assign
     2575     v-new-stfl = p-newbh::status_
     2576     .
     2577     _ii:
     2578     do v-ii = 1 to 5:
     2579       if v-stat-list[v-ii] = '' then next.
     2580       assign
     2581       v-waiting-stfl-i = lookup(v-waiting-stfl, v-stat-list[v-ii], chr(3))
     2582       v-old-stfl-i = lookup(v-old-stfl, v-stat-list[v-ii], chr(3))
     2583       v-new-stfl-i = lookup(v-new-stfl, v-stat-list[v-ii], chr(3))
     2584       .
     2585       if v-waiting-stfl-i = 0
     2586       or v-old-stfl-i = 0
     2587       or v-new-stfl-i = 0
     2588       then do:
     2589         next _ii.
     2590         end.
     2591       if v-old-stfl-i < v-waiting-stfl-i
     2592       and v-new-stfl-i = v-waiting-stfl-i then do:
     2593         assign
     2594         p-is-waiting-status = yes
     2595         p-direction = '<закрытие документа>':U + chr(4) + "to".
     2596         return.
     2597         end.
     2598       if v-old-stfl-i < v-waiting-stfl-i
     2599       and v-new-stfl-i > v-waiting-stfl-i then do:
     2600         assign
     2601         p-is-waiting-status = yes
     2602         p-direction = '<закрытие документа>':U + chr(4) + "to-up".
     2603         return.
     2604         end.
     2605       if v-new-stfl-i = v-waiting-stfl-i
     2606       and v-old-stfl-i > v-waiting-stfl-i then do:
     2607         assign
     2608         p-is-waiting-status = yes
     2609         p-direction = '<открытие документа>':U + chr(4) + "to".
     2610         return.
     2611         end.
     2612       if v-new-stfl-i < v-waiting-stfl-i
     2613       and v-old-stfl-i > v-waiting-stfl-i then do:
     2614         assign
     2615         p-is-waiting-status = yes
     2616         p-direction = '<открытие документа>':U + chr(4) + "to-down".
     2617         return.
     2618         end.
     2619       if v-old-stfl-i = v-waiting-stfl-i
     2620       and v-new-stfl-i > v-waiting-stfl-i then do:
     2621         assign
     2622         p-is-waiting-status = yes
     2623         p-direction = '<закрытие документа>':U + chr(4) + "from".
     2624         return.
     2625       end.
     2626       if v-old-stfl-i = v-waiting-stfl-i
     2627       and v-new-stfl-i < v-waiting-stfl-i then do:
     2628         assign
     2629         p-is-waiting-status = yes
     2630         p-direction = '<открытие документа>':U + chr(4) + "from".
     2631         return.
     2632       end.
     2633     end.
     2634     end.
     2635   end procedure.
