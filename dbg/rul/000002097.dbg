     2992   _jj:
     2993   do v-jj = 1 to 2:
     2994     if v-jj = 1 then do:
     2995       assign
     2996       v-waiting-stfl = p-waiting-status + chr(4) + string(if p-waiting-flag = ? then yes else p-waiting-flag)
     2997       .
     2998     end.
     2999     if v-jj = 2 then do:
     3000       if p-waiting-flag <> ? then leave  _jj.
     3001       assign
     3002       v-waiting-stfl = p-waiting-status + chr(4) + string(no)
     3003       .
     3004     end.
     3005     assign
     3006     v-old-stfl = p-oldbh::status_ + chr(4) + string(p-oldbh::flag_)
     3007     .
     3008     assign
     3009     v-new-stfl = p-newbh::status_ + chr(4) + string(p-newbh::flag_)
     3010     .
     3011     _ii:
     3012     do v-ii = (lookup(v-ext-doc-type, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3) to (lookup(v-ext-doc-type, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4):
     3013       if v-stat-list[v-ii] = '' then next.
     3014       assign
     3015       v-waiting-stfl-i = lookup(v-waiting-stfl, v-stat-list[v-ii], chr(3))
     3016       v-old-stfl-i = lookup(v-old-stfl, v-stat-list[v-ii], chr(3))
     3017       v-new-stfl-i = lookup(v-new-stfl, v-stat-list[v-ii], chr(3))
     3018       .
     3019       if v-waiting-stfl-i = 0
     3020       or v-old-stfl-i = 0
     3021       or v-new-stfl-i = 0
     3022       then do:
     3023         next _ii.
     3024       end.
     3025       if v-old-stfl-i < v-waiting-stfl-i
     3026       and v-new-stfl-i = v-waiting-stfl-i then do:
     3027         assign
     3028         p-is-waiting-status = yes
     3029         p-direction = '<закрытие документа>':U + chr(4) + "to".
     3030         return.
     3031       end.
     3032       if v-old-stfl-i < v-waiting-stfl-i
     3033       and v-new-stfl-i > v-waiting-stfl-i then do:
     3034         assign
     3035         p-is-waiting-status = yes
     3036         p-direction = '<закрытие документа>':U + chr(4) + "to-up".
     3037         return.
     3038       end.
     3039       if v-new-stfl-i = v-waiting-stfl-i
     3040       and v-old-stfl-i > v-waiting-stfl-i then do:
     3041         assign
     3042         p-is-waiting-status = yes
     3043         p-direction = '<открытие документа>':U + chr(4) + "to".
     3044         return.
     3045       end.
     3046       if v-new-stfl-i < v-waiting-stfl-i
     3047       and v-old-stfl-i > v-waiting-stfl-i then do:
     3048         assign
     3049         p-is-waiting-status = yes
     3050         p-direction = '<открытие документа>':U + chr(4) + "to-down".
     3051         return.
     3052       end.
     3053       if v-old-stfl-i = v-waiting-stfl-i
     3054       and v-new-stfl-i > v-waiting-stfl-i then do:
     3055         assign
     3056         p-is-waiting-status = yes
     3057         p-direction = '<закрытие документа>':U + chr(4) + "from".
     3058         return.
     3059       end.
     3060       if v-old-stfl-i = v-waiting-stfl-i
     3061       and v-new-stfl-i < v-waiting-stfl-i then do:
     3062         assign
     3063         p-is-waiting-status = yes
     3064         p-direction = '<открытие документа>':U + chr(4) + "from".
     3065         return.
     3066       end.
     3067     end.
     3068   end.
     3069   end.
     3070   end procedure .
     3071   procedure stat-graf-price :
     3072   define input parameter p-oldbh              as handle no-undo .
     3073   define input parameter p-newbh              as handle no-undo .
     3074   define input parameter p-changed-fields     as character no-undo .
     3075   define input parameter p-waiting-status     as character no-undo .
     3076   define input parameter p-waiting-flag       as logical no-undo .
     3077   define output parameter p-is-waiting-status as logical no-undo .
     3078   define output parameter p-direction         as character no-undo .
     3079   define variable v-stat-list as character no-undo extent 5.
     3080   define variable v-waiting-stfl as character no-undo .
     3081   define variable v-old-stfl as character no-undo .
     3082   define variable v-new-stfl as character no-undo .
     3083   define variable v-waiting-stfl-i as integer no-undo .
     3084   define variable v-old-stfl-i as integer no-undo .
     3085   define variable v-new-stfl-i as integer no-undo .
     3086   define variable v-ii as integer no-undo .
     3087   do
     3088   on error undo, return error return-value
     3089   :
     3090   assign
     3091   v-stat-list[1] =
     3092                    ''            +  chr(3) +
     3093                    'новый':U    +  chr(3) +
     3094                    'приказ':U      +  chr(3) +
     3095                    'разрешен':U  +  chr(3) +
     3096                    'акт':U
     3097   .
     3098     assign
     3099     v-waiting-stfl = p-waiting-status
     3100     .
     3101     assign
     3102     v-old-stfl = p-oldbh::status_
     3103     .
     3104     assign
     3105     v-new-stfl = p-newbh::status_
     3106     .
     3107     _ii:
     3108     do v-ii = 1 to 5:
     3109       if v-stat-list[v-ii] = '' then next.
     3110       assign
     3111       v-waiting-stfl-i = lookup(v-waiting-stfl, v-stat-list[v-ii], chr(3))
     3112       v-old-stfl-i = lookup(v-old-stfl, v-stat-list[v-ii], chr(3))
     3113       v-new-stfl-i = lookup(v-new-stfl, v-stat-list[v-ii], chr(3))
     3114       .
     3115       if v-waiting-stfl-i = 0
     3116       or v-old-stfl-i = 0
     3117       or v-new-stfl-i = 0
     3118       then do:
     3119         next _ii.
     3120       end.
     3121       if v-old-stfl-i < v-waiting-stfl-i
     3122       and v-new-stfl-i = v-waiting-stfl-i then do:
     3123         assign
     3124         p-is-waiting-status = yes
     3125         p-direction = '<закрытие документа>':U + chr(4) + "to".
     3126         return.
     3127       end.
     3128       if v-old-stfl-i < v-waiting-stfl-i
     3129       and v-new-stfl-i > v-waiting-stfl-i then do:
     3130         assign
     3131         p-is-waiting-status = yes
     3132         p-direction = '<закрытие документа>':U + chr(4) + "to-up".
     3133         return.
     3134       end.
     3135       if v-new-stfl-i = v-waiting-stfl-i
     3136       and v-old-stfl-i > v-waiting-stfl-i then do:
     3137         assign
     3138         p-is-waiting-status = yes
     3139         p-direction = '<открытие документа>':U + chr(4) + "to".
     3140         return.
     3141       end.
     3142       if v-new-stfl-i < v-waiting-stfl-i
     3143       and v-old-stfl-i > v-waiting-stfl-i then do:
     3144         assign
     3145         p-is-waiting-status = yes
     3146         p-direction = '<открытие документа>':U + chr(4) + "to-down".
     3147         return.
     3148       end.
     3149       if v-old-stfl-i = v-waiting-stfl-i
     3150       and v-new-stfl-i > v-waiting-stfl-i then do:
     3151         assign
     3152         p-is-waiting-status = yes
     3153         p-direction = '<закрытие документа>':U + chr(4) + "from".
     3154         return.
     3155       end.
     3156       if v-old-stfl-i = v-waiting-stfl-i
     3157       and v-new-stfl-i < v-waiting-stfl-i then do:
     3158         assign
     3159         p-is-waiting-status = yes
     3160         p-direction = '<открытие документа>':U + chr(4) + "from".
     3161         return.
     3162       end.
     3163     end.
     3164   end.
     3165   end procedure.
     3166   procedure stat-graf-inkas :
     3167   define input parameter  p-oldbh              as handle no-undo .
     3168   define input parameter  p-newbh              as handle no-undo .
     3169   define input parameter  p-changed-fields     as character no-undo .
     3170   define input parameter  p-waiting-status     as character no-undo .
     3171   define input parameter  p-waiting-flag       as logical no-undo .
     3172   define output parameter p-is-waiting-status  as logical no-undo .
     3173   define output parameter p-direction          as character no-undo .
     3174   define variable v-doc-code as character no-undo .
     3175   define variable v-ext-doc-type as character no-undo .
     3176   define variable v-stat-list as character no-undo extent 3.
     3177   define variable v-jj as integer no-undo .
     3178   define variable v-ii as integer no-undo .
     3179   define variable v-old-stfl as character no-undo .
     3180   define variable v-new-stfl as character no-undo .
     3181   define variable v-waiting-stfl as character no-undo .
     3182   define variable v-old-stfl-i as integer no-undo .
     3183   define variable v-new-stfl-i as integer no-undo .
     3184   define variable v-waiting-stfl-i as integer no-undo .
     3185   do
     3186   on error  undo, return error substitute( "&1. &2&3&4", vss-include-info17, return-value, chr(10), error-status :get-message (1))
     3187   :
     3188   if p-newbh = ?  then do:
     3189     v-doc-code = p-oldbh::inkas-code .
     3190   end.
     3191   else do:
     3192     v-doc-code     = p-newbh::inkas-code .
     3193   end.
     3194   assign
     3195   v-stat-list[1] =
     3196                    '' +           chr(4) + string(no) + chr(3) +
     3197                    'новый':U + chr(4) + string(no) + chr(3) +
     3198                    'факт':U +      chr(4) + string(no)
     3199   v-stat-list[2] =
     3200                    '' +           chr(4) + string(no) + chr(3) +
     3201                    'новый':U + chr(4) + string(no) + chr(3) +
     3202                    'новый':U + chr(4) + string(yes) + chr(3) +
     3203                    'нередакт':U + chr(4) + string(yes) + chr(3) +
     3204                    'факт':U +      chr(4) + string(no)
     3205   v-stat-list[3] =
     3206                    '' +         chr(4) + string(no) + chr(3) +
     3207                    'запрос':U + chr(4) + string(no)
     3208   .
     3209   _jj:
     3210   do v-jj = 1 to 2:
     3211     if v-jj = 1 then do:
     3212       assign
     3213       v-waiting-stfl = p-waiting-status + chr(4) + string(if p-waiting-flag = ? then no else p-waiting-flag)
     3214       .
     3215     end.
     3216     if v-jj = 2 then do:
     3217       if p-waiting-flag <> ? then leave  _jj.
     3218       assign
     3219       v-waiting-stfl = p-waiting-status + chr(4) + string(yes)
     3220       .
     3221     end.
     3222     assign
     3223     v-old-stfl = p-oldbh::status_ + chr(4) + string(p-oldbh::flag_)
     3224     .
     3225     assign
     3226     v-new-stfl = p-newbh::status_ + chr(4) + string(p-newbh::flag_)
     3227     .
     3228     _ii:
     3229     do v-ii = 1 to 3:
     3230       if v-stat-list[v-ii] = '' then next.
     3231       assign
     3232       v-waiting-stfl-i = lookup(v-waiting-stfl, v-stat-list[v-ii], chr(3))
     3233       v-old-stfl-i = lookup(v-old-stfl, v-stat-list[v-ii], chr(3))
     3234       v-new-stfl-i = lookup(v-new-stfl, v-stat-list[v-ii], chr(3))
     3235       .
     3236       if v-waiting-stfl-i = 0
     3237       or v-old-stfl-i = 0
     3238       or v-new-stfl-i = 0
     3239       then do:
     3240         next _ii.
     3241       end.
     3242       if v-old-stfl-i < v-waiting-stfl-i
     3243       and v-new-stfl-i = v-waiting-stfl-i then do:
     3244         assign
     3245         p-is-waiting-status = yes
     3246         p-direction = '<закрытие документа>':U + chr(4) + "to".
     3247         return.
     3248       end.
     3249       if v-old-stfl-i < v-waiting-stfl-i
     3250       and v-new-stfl-i > v-waiting-stfl-i then do:
     3251         assign
     3252         p-is-waiting-status = yes
     3253         p-direction = '<закрытие документа>':U + chr(4) + "to-up".
     3254         return.
     3255       end.
     3256       if v-new-stfl-i = v-waiting-stfl-i
     3257       and v-old-stfl-i > v-waiting-stfl-i then do:
     3258         assign
     3259         p-is-waiting-status = yes
     3260         p-direction = '<открытие документа>':U + chr(4) + "to".
     3261         return.
     3262       end.
     3263       if v-new-stfl-i < v-waiting-stfl-i
     3264       and v-old-stfl-i > v-waiting-stfl-i then do:
     3265         assign
     3266         p-is-waiting-status = yes
     3267         p-direction = '<открытие документа>':U + chr(4) + "to-down".
     3268         return.
     3269       end.
     3270       if v-old-stfl-i = v-waiting-stfl-i
     3271       and v-new-stfl-i > v-waiting-stfl-i then do:
     3272         assign
     3273         p-is-waiting-status = yes
     3274         p-direction = '<закрытие документа>':U + chr(4) + "from".
     3275         return.
     3276       end.
     3277       if v-old-stfl-i = v-waiting-stfl-i
     3278       and v-new-stfl-i < v-waiting-stfl-i then do:
     3279         assign
     3280         p-is-waiting-status = yes
     3281         p-direction = '<открытие документа>':U + chr(4) + "from".
     3282         return.
     3283       end.
     3284     end.
     3285   end.
     3286   end.
     3287   end procedure .
     3288   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3289   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3290   FUNCTION cr-edist_get-mess-mean returns character ( input p-mess as character):
     3291   define variable v-ii as integer   no-undo .
     3292   define variable v-dop as character no-undo .
     3293   define variable v-dop1 as character no-undo .
     3294   define variable v-mess as character no-undo .
     3295   do v-ii = 1 to num-entries(p-mess, chr(4) ):
     3296     v-dop = entry(v-ii, p-mess, chr(4) ).
     3297     case entry(1, v-dop, "="):
     3298       when 'pack-num':U then do:
     3299         v-dop1 =  substitute("&1 &2", 'Пакет', entry(2, v-dop, "=")).
     3300       end.
     3301       when 'route':U then do:
     3302         v-dop1 =  substitute("&1 &2", 'Рут':U, entry(2, v-dop, "=")).
     3303       end.
     3304       when 'ediiterchangeid':U then do:
     3305         v-dop1 =  substitute("&1 &2", 'ediiterchangeid':U, entry(2, v-dop, "=")).
     3306       end.
     3307       when 'price-up':U then do:
     3308         v-dop1 =  substitute("&1 &2", 'Цена':U, entry(2, v-dop, "=")).
     3309       end.
     3310       when 'price-down':U then do:
     3311         v-dop1 =  substitute("&1 &2", 'Цена':U, entry(2, v-dop, "=")).
     3312       end.
     3313       when 'vat-change':U then do:
     3314         v-dop1 =  substitute("&1 &2", 'НДС':U, entry(2, v-dop, "=")).
     3315       end.
     3316       when 'ps':U then do:
     3317         v-dop1 =  substitute("&1 &2", ' ':U, entry(2, v-dop, "=")).
     3318       end.
     3319       when 'info':U then do:
     3320         v-dop1 =  substitute("&1 &2", 'Инф:':U, entry(2, v-dop, "=")).
     3321       end.
     3322       when 'qnty-up':U then do:
     3323         v-dop1 =  substitute("&1 &2", 'Кол-во':U, entry(2, v-dop, "=")).
     3324       end.
     3325       when 'qnty-down':U then do:
     3326         v-dop1 =  substitute("&1 &2", 'Кол-во':U, entry(2, v-dop, "=")).
     3327       end.
     3328       when 'bstr-change':U then do:
     3329         v-dop1 =  substitute("&1 &2", 'Штрихкод:':U, entry(2, v-dop, "=")).
     3330       end.
     3331       when 'shipdate-change':U then do:
     3332         v-dop1 =  substitute("&1 &2", 'Дата отгрузки:':U, entry(2, v-dop, "=")).
     3333       end.
     3334       when 'clioutdoc-change':U then do:
     3335         v-dop1 =  substitute("&1 &2", '№ заказа по пост-ку:':U, entry(2, v-dop, "=")).
     3336       end.
     3337     end case.
     3338     v-mess  = v-mess + (if v-mess = '' then '' else chr(32)) + v-dop1.
     3339   end.
     3340   return v-mess.
     3341   end function.
     3342   FUNCTION cr-edist_get-error-mean returns character ( input p-mess as character):
     3343   define variable v-ii as integer   no-undo .
     3344   define variable v-dop as character no-undo .
     3345   define variable v-dop1 as character no-undo .
     3346   define variable v-mess as character no-undo .
     3347   do v-ii = 1 to num-entries(p-mess, chr(4) ):
     3348     v-dop = entry(v-ii, p-mess, chr(4) ).
     3349     case entry(1, v-dop, "="):
     3350       when 'pack-num':U then do:
     3351         v-dop1 =  substitute("&1 &2", 'Пакет', entry(2, v-dop, "=")).
     3352       end.
     3353       when 'route':U then do:
     3354         v-dop1 =  substitute("&1 &2", 'Рут':U, entry(2, v-dop, "=")).
     3355       end.
     3356       when 'ediiterchangeid':U then do:
     3357         v-dop1 =  substitute("&1 &2", 'ediiterchangeid':U, entry(2, v-dop, "=")).
     3358       end.
     3359       when 'price-up':U then do:
     3360         v-dop1 =  substitute("&1 &2", 'Цена':U, entry(2, v-dop, "=")).
     3361       end.
     3362       when 'price-down':U then do:
     3363         v-dop1 =  substitute("&1 &2", 'Цена':U, entry(2, v-dop, "=")).
     3364       end.
     3365       when 'vat-change':U then do:
     3366         v-dop1 =  substitute("&1 &2", 'НДС':U, entry(2, v-dop, "=")).
     3367       end.
     3368       when 'ps':U then do:
     3369         v-dop1 =  substitute("&1 &2", ' ':U, entry(2, v-dop, "=")).
     3370       end.
     3371       when 'info':U then do:
     3372         v-dop1 =  substitute("&1 &2", 'Инф:':U, entry(2, v-dop, "=")).
     3373       end.
     3374       when 'qnty-up':U then do:
     3375         v-dop1 =  substitute("&1 &2", 'Кол-во':U, entry(2, v-dop, "=")).
     3376       end.
     3377       when 'qnty-down':U then do:
     3378         v-dop1 =  substitute("&1 &2", 'Кол-во':U, entry(2, v-dop, "=")).
     3379       end.
     3380       when 'bstr-change':U then do:
     3381         v-dop1 =  substitute("&1 &2", 'Штрихкод:':U, entry(2, v-dop, "=")).
     3382       end.
     3383       when 'shipdate-change':U then do:
     3384         v-dop1 =  substitute("&1 &2", 'Дата отгрузки:':U, entry(2, v-dop, "=")).
     3385       end.
     3386       when 'clioutdoc-change':U then do:
     3387         v-dop1 =  substitute("&1 &2", '№ заказа по пост-ку:':U, entry(2, v-dop, "=")).
     3388       end.
     3389     end case.
     3390     v-mess  = v-mess + (if v-mess = '' then '' else chr(4)) + v-dop1.
     3391   end.
     3392   return v-mess.
     3393   end function.
     3394   FUNCTION cr-edist_get-mess-key-value returns character ( input p-mess as character, input p-key as character):
     3395   define variable v-ii as integer   no-undo .
     3396   define variable v-dop as character no-undo .
     3397   define variable v-dop1 as character no-undo .
     3398   define variable v-value as character no-undo .
     3399   do v-ii = 1 to num-entries(p-mess, chr(4) ):
     3400     v-dop = entry(v-ii, p-mess, chr(4) ).
     3401     if entry(1, v-dop, "=") = p-key then do:
     3402       return entry(2, v-dop, "=").
     3403     end.
     3404   end.
     3405   return v-value.
     3406   end function.
     3407   FUNCTION cr-edist_add-edist-mess returns character ( input p-mess as character
     3408                                                        ,input p-key as character
     3409                                                        ,input p-value as character):
     3410   define variable v-dop as character no-undo .
     3411   define variable v-modificator as character no-undo .
     3412   assign
     3413   v-modificator = entry(2, p-key, "-") no-error .
     3414   case v-modificator:
     3415     when "up" then do:
     3416       v-dop = substitute("&1=&2<&3", p-key, entry(1, p-value, chr(4)) , entry(2, p-value, chr(4))).
     3417     end.
     3418     when "down" then do:
     3419       v-dop = substitute("&1=&2>&3", p-key, entry(1, p-value, chr(4)) , entry(2, p-value, chr(4))).
     3420     end.
     3421     when "change" then do:
     3422       v-dop = substitute("&1=&2 ->&3", p-key, entry(1, p-value, chr(4)) , entry(2, p-value, chr(4))).
     3423     end.
     3424     otherwise do:
     3425       v-dop = substitute("&1=&2", p-key, p-value).
     3426     end.
     3427   end case.
     3428   if p-mess = ''
     3429   or p-mess = ? then do:
     3430     return v-dop .
     3431   end.
     3432   else do:
     3433     return substitute("&1&2&3", p-mess, chr(4), v-dop).
     3434   end.
     3435   end function.
     3436   procedure create-edi-state :
     3437   define input  parameter p-tbl-name   as character no-undo .
     3438   define input  parameter p-doc-code   as character no-undo .
     3439   define input  parameter p-cli-type   as character no-undo .
     3440   define input  parameter p-cli-code   as integer   no-undo .
     3441   define input  parameter p-act        as character no-undo .
     3442   define input  parameter p-state      as character no-undo .
     3443   define input  parameter p-err        as integer   no-undo .
     3444   define input  parameter p-des        as character no-undo .
     3445   define input  parameter p-mess       as character no-undo .
     3446   define input  parameter p-dm         as integer  no-undo .
     3447   define input-output parameter p-date       as date no-undo .
     3448   define input-output parameter p-time       as integer no-undo .
     3449   define buffer buf_EDI-status for ub.EDI-status  .
     3450   define variable v-time as integer   no-undo .
     3451   define variable v-date as date   no-undo .
     3452   do
     3453   on error undo, return error return-value
     3454   :
     3455     if p-date = ? then do:
     3456       run cur-time in this-procedure ( output v-date, output v-time).
     3457     end.
     3458     else do:
     3459       assign
     3460       v-date = p-date
     3461       v-time = p-time
     3462       .
     3463     end.
     3464     find first buf_edi-status exclusive-lock where
     3465                 buf_edi-status.date-status = v-date
     3466             and buf_edi-status.time-status = v-time
     3467             and buf_edi-status.tbl-name    = p-tbl-name
     3468             and buf_edi-status.doc-code    = p-doc-code no-error .
     3469     if not available buf_edi-status  then do:
     3470       create buf_edi-status.
     3471     end.
     3472     assign
     3473     buf_edi-status.act         = p-act        .
     3474     buf_edi-status.cli-type    = p-cli-type   .
     3475     buf_edi-status.cli-code    = p-cli-code   .
     3476     buf_edi-status.des-err     = buf_edi-status.des-err + (if buf_edi-status.des-err = '' then '' else chr(4)) + p-des        .
     3477     buf_edi-status.doc-code    = p-doc-code   .
     3478     buf_edi-status.err-code    = p-err        .
     3479     buf_edi-status.mess-id     = buf_edi-status.mess-id + (if buf_edi-status.mess-id = '' then '' else chr(4)) + p-mess       .
     3480     buf_edi-status.state       = p-state      .
     3481     buf_edi-status.tbl-name    = p-tbl-name   .
     3482     buf_edi-status.date-status = v-date       .
     3483     buf_edi-status.time-status = v-time       .
     3484     buf_edi-status.whole-send-news = p-dm     .
     3485     buf_edi-status.user-name   = (if g#news then (chr(4) +  'СПН':U)
     3486                                       else (if g#esys
     3487                                             then (chr(4) +  'ВС':U)
     3488                                             else g#userid)
     3489                                       )       .
     3490     assign
     3491     p-date = buf_edi-status.date-status
     3492     p-time = buf_edi-status.time-status
     3493     .
     3494   end.
     3495   end procedure.
     3496   procedure update-edi-state-light :
     3497   define input  parameter p-tbl-name   as character no-undo .
     3498   define input  parameter p-doc-code   as character no-undo .
     3499   define input  parameter p-date-status as date no-undo .
     3500   define input  parameter p-time-status as integer no-undo .
     3501   define input  parameter p-state      as character no-undo .
     3502   define input  parameter p-err        as integer   no-undo .
     3503   define input  parameter p-des        as character no-undo .
     3504   define input  parameter p-mess       as character no-undo .
     3505   define buffer buf_edi-status for ub.edi-status.
     3506   do
     3507   on error undo, return error
     3508   :
     3509     find first buf_edi-status exclusive-lock where
     3510                 buf_edi-status.date-status = p-date-status
     3511             and buf_edi-status.time-status = p-time-status
     3512             and buf_edi-status.tbl-name    = p-tbl-name
     3513             and buf_edi-status.doc-code    = p-doc-code no-error .
     3514     if available buf_edi-status  then do:
     3515       assign
     3516       buf_edi-status.des-err     = p-des        .
     3517       buf_edi-status.err-code    = p-err        .
     3518       buf_edi-status.mess-id     = p-mess       .
     3519       buf_edi-status.state       = p-state      .
     3520     end.
     3521   end.
     3522   end procedure.
