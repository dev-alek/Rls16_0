     3687                                                                 input p-esys-cmd-code
     3688                                                                ,input p-custom-pck-name) no-error .
     3689         if error-status :error
     3690         then do:
     3691            delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при установке спец имени пакета для отсылки во внешнюю систему команды с кодом &1&2&3&2&4"
     3692                                                        , p-cmd-code
     3693                                                        , chr(10)
     3694                                                        , error-status:get-message(1)
     3695                                                        , return-value
     3696                                                        )).
     3697            return no .
     3698         end.
     3699         return yes.
     3700      end.
     3701      else do:
     3702         delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при установке спец имени пакета для отсылки во внешнюю систему команды с кодом &1&2&3&2&4"
     3703                                                       , p-cmd-code
     3704                                                       , chr(10)
     3705                                                       , error-status:get-message(1)
     3706                                                       , return-value
     3707                                                       )).
     3708         return no .
     3709      end.
     3710   end.
     3711   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3712   function context_delete-command return logical
     3713   (
     3714       input p-esys-cmd-proc-handle as handle
     3715      ,input p-esys-cmd-code as integer
     3716   ):
     3717      if valid-handle(p-esys-cmd-proc-handle )
     3718      then do:
     3719         run delete-command in p-esys-cmd-proc-handle
     3720             (input p-esys-cmd-code
     3721             ) no-error.
     3722         if error-status :error
     3723         then do:
     3724            delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при удалении команды с кодом &1&2&3&2&4"
     3725                                                              , p-cmd-code
     3726                                                              , chr(10)
     3727                                                              , error-status:get-message(1)
     3728                                                              , return-value
     3729                                                              )).
     3730            return no .
     3731         end.
     3732         delete procedure p-esys-cmd-proc-handle no-error.
     3733         return yes.
     3734      end.
     3735      else do:
     3736         delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при удалении команды с кодом &1&2&3&2&4"
     3737                                                       , p-cmd-code
     3738                                                       , chr(10)
     3739                                                       , error-status:get-message(1)
     3740                                                       , return-value
     3741                                                       )).
     3742         return no .
     3743      end.
     3744   end.
     3745   on delete of this-procedure do:
     3746     run garbcoll_clear in this-procedure .
     3747   end.
     3748   run load-ruleset-context in this-procedure ( input p-ruleset-id) no-error.
     3749   if error-status:error then do:
     3750     undo, return error return-value .
     3751   end.
     3752   if return-value = "return" then return ''.
     3753   define variable ExpData1 as class Route-data_ no-undo .
     3754   ExpData1 = new Route-data_( input parparentproc, input p-parent-handle, input p-log-handle, input this-procedure:handle) .
     3755   define variable v-DATA as memptr no-undo.
     3756   if not this-procedure:persistent then do:
     3757     run proc-main in this-procedure no-error .
     3758     if error-status:error then do:
     3759       v-esm = error-status :get-message (1).
     3760       v-es = error-status:error .
     3761       v-rv = return-value .
     3762     end.
     3763     if v-es then do:
     3764         run garbcoll_clear in this-procedure .
     3765               if valid-handle(p-log-handle) then           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))).
     3766         undo, return error substitute( "&1. &2&3&4", vss-workfile, v-rv, chr(10), v-esm).
     3767     end.
     3768     run garbcoll_clear in this-procedure .
     3769   end.
     3770   procedure proc-main :
     3771   define variable v-ii as integer no-undo .
     3772   define variable v-uniq-key-rec as character no-undo .
     3773   define variable v-cli-uniq-key-rec as character no-undo .
     3774   define variable v-err as logical no-undo .
     3775   define variable v-custom-pack-name as character no-undo .
     3776   define variable v-success as logical   no-undo .
     3777   DEFINE VARIABLE v-date as date no-undo .
     3778   DEFINE VARIABLE v-time as integer no-undo .
     3779   define variable v-ord-int1 as integer no-undo .
     3780   define variable v-obj-gln as character no-undo .
     3781   define variable v-cli-gln as character no-undo .
     3782   define variable v-frm-gln as character no-undo .
     3783   define variable v-transport-gln as character no-undo .
     3784   define variable v-mess as character no-undo .
     3785   define variable v-b-code as character no-undo .
     3786   define variable v-b-str as character no-undo .
     3787   define variable l-prod-bc-weight as logical no-undo .
     3788   define variable l-prod-bc-pgweight as logical no-undo .
     3789   define variable l-is-petrol-code as logical no-undo .
     3790   define variable l-is-scaleable as logical no-undo .
     3791   define variable v-jj as integer   no-undo .
     3792   define variable v-cli-base-rate as decimal no-undo .
     3793   define variable v-dump-ord-int64 as int64 no-undo .
     3794   define variable v-EDIINTERCHANGEID as character no-undo .
     3795   define variable v-edist-mess as character no-undo .
     3796   define variable v-deliverynotenumber as character no-undo .
     3797   define variable v-deliverynotedate as date no-undo .
     3798   define variable v-deliverynotedate-chr as character no-undo .
     3799   define variable v-attr-type as character no-undo .
     3800   define variable v-date-status as date no-undo .
     3801   define variable v-time-status as integer no-undo .
     3802   define variable v-date-chr as character no-undo .
     3803   define variable sw as handle no-undo .
     3804   define variable swa as handle no-undo .
     3805   define buffer buf_ext-system for ub.ext-system.
     3806   define buffer buf_ord-line for ub.ord-line.
     3807   define buffer buf_object for ub.clients.
     3808   define buffer buf_clients for ub.clients.
     3809   define buffer buf_ext-classif for ub.ext-classif.
     3810   define buffer esys_ext-classif for ub.ext-classif.
     3811   define buffer buf_goods for ub.goods.
     3812   define buffer buf_currency for ub.currency.
     3813   define buffer buf_doc-line for ub.doc-line.
     3814   define buffer buf_ext-artic for ub.ext-artic.
     3815   define buffer buf_ord-chain for ub.ord-chain .
     3816   define buffer buf_ord-doc-rcv for ub.ord-doc-rcv .
     3817   define buffer buf_ord-doc for ub.ord-doc .
     3818   define buffer buf_contract for ub.contract .
     3819   _main:
     3820   do
     3821   on error undo _main, return error substitute( "&1&2&3&2&4", return-value, chr(10), error-status :get-message (1), v-last-error-message)
     3822   on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
     3823   on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
     3824   :
     3825    if retry then do:
     3826           if valid-handle(p-log-handle) then           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при обработке накладной &1&2:&3&4"                                    ,v-current-doc-code                                    , chr(10), v-mess)).
     3827       undo _main, return error.
     3828     end.
     3829     else do:
     3830       assign
     3831       v-mess = ''
     3832       .
     3833       find first buf_clients no-lock where
     3834                 buf_clients.obj-type = v-cli-type
     3835             and buf_clients.obj-code = v-cli-code no-error.
     3836       if not available buf_clients then do:
     3837         v-mess =  substitute("Не найден контрагент &1&2", v-cli-type, v-cli-code).
     3838         v-err = yes.
     3839         undo _main, retry _main.
     3840       end.
     3841       run gen-key-rec in this-procedure ( input 'clients':U
     3842                                         ,input (buffer buf_clients:handle)
     3843                                         ,output v-cli-uniq-key-rec) no-error .
     3844       if error-status:error then do:
     3845         v-mess = substitute("gen-key-rec: &1&2&3&2(&4&5)"
     3846                                   , error-status:get-message(1)
     3847                                   , return-value
     3848                                   , chr(10)
     3849                                   , v-cli-type
     3850                                   , v-cli-code).
     3851         v-err = yes.
     3852         undo _main, retry _main.
     3853       end.
     3854       find first esys_ext-classif no-lock where
     3855           esys_ext-classif.classif-name = 'exite-edi':U
     3856       and esys_ext-classif.classif-subject = 'clients':U
     3857       and esys_ext-classif.db-num = -1
     3858       and esys_Ext-classif.uniq-key-rec = v-cli-uniq-key-rec no-error .
     3859       if not available esys_ext-classif then do:
     3860         v-mess = substitute("Поставщик &1&2 заказа НЕ РАБОТАЕТ ПО СИСТЕМЕ EDI", v-cli-type, v-cli-code).
     3861         v-err = yes.
     3862         undo _main, retry _main.
     3863       end.
     3864       find first buf_object no-lock where
     3865                 buf_object.obj-type = v-current-obj-type
     3866             and buf_object.obj-code = v-current-obj-code no-error.
     3867       if not available buf_object then do:
     3868         v-mess =  substitute("Не найден объект &1&2", v-current-obj-type, v-current-obj-code).
     3869         v-err = yes.
     3870         undo _main, retry _main.
     3871       end.
     3872       if buf_object.db-num <> g#db-num then do:
     3873         v-mess = substitute("Объект &1&2 принадлежит другой БД", v-current-obj-type, v-current-obj-code).
     3874         v-err = yes.
     3875         undo _main, retry _main.
     3876       end.
     3877       run gen-key-rec in this-procedure ( input 'clients':U
     3878                                         ,input (buffer buf_object:handle)
     3879                                         ,output v-uniq-key-rec) no-error .
     3880       if error-status:error then do:
     3881         v-mess =  substitute("gen-key-rec: &1&2&3&2(&4&5)"
     3882                                   , error-status:get-message(1)
     3883                                   , return-value
     3884                                   , chr(10)
     3885                                   , buf_object.obj-type
     3886                                   , buf_object.obj-code).
     3887         v-err = yes.
     3888         undo _main, retry _main.
     3889       end.
     3890       assign
     3891       v-obj-gln = get-gln( input buf_object.obj-type
     3892                       ,input buf_object.obj-code) no-error.
     3893       if error-status:error
     3894       or v-obj-gln = chr(63)
     3895       or v-obj-gln = '' then do:
     3896         v-mess =  substitute("Не определен GLN для &1&2"
     3897                                   , buf_object.obj-type
     3898                                   , buf_object.obj-code) .
     3899         undo _main, return.
     3900       end.
     3901       assign
     3902       v-frm-gln = get-gln( input 'орг':U
     3903                           ,input v-current-host-code) no-error.
     3904       if error-status:error
     3905       or v-frm-gln = chr(63)
     3906       or v-frm-gln = '' then do:
     3907         v-mess =  substitute("Не определен GLN для &1&2"
     3908                                   , 'орг':U
     3909                                   , v-current-host-code) .
     3910         undo _main, return.
     3911       end.
     3912       v-cli-gln = get-gln( input v-cli-type
     3913                           ,input v-cli-code) no-error.
     3914       if error-status:error
     3915       or v-cli-gln = chr(63)
     3916       or v-cli-gln = '' then do:
     3917         v-mess =  substitute("Не определен GLN для &1&2"
     3918                                   , v-cli-type
     3919                                   , v-cli-code) .
     3920         undo _main, return.
     3921       end.
     3922       for each esys_ext-classif no-lock where
     3923           esys_ext-classif.classif-name = 'exite-edi':U
     3924       and esys_ext-classif.classif-subject = 'clients':U
     3925       and esys_ext-classif.db-num = -1
     3926       and esys_Ext-classif.uniq-key-rec = v-cli-uniq-key-rec,
     3927         first buf_ext-system no-lock where
     3928                   buf_ext-system.esys-id = esys_ext-classif.key#_one
     3929               and buf_ext-system.db-num = 0
     3930               and buf_ext-system.esys-have-export = yes,
     3931         first buf_ext-classif no-lock where
     3932           buf_ext-classif.classif-name = 'exite-edi':U
     3933       and buf_ext-classif.classif-subject = 'clients':U
     3934       and buf_ext-classif.db-num = -1
     3935       and buf_Ext-classif.uniq-key-rec = v-uniq-key-rec
     3936       and buf_Ext-classif.key#_one = esys_ext-classif.key#_one:
     3937         leave.
     3938       end.
     3939       if not available buf_ext-system then do:
     3940         v-mess = substitute("Для поставщика &1&2 не найдена ВС, у которой есть экспорт в текущей БД").
     3941         v-err = yes.
     3942         undo _main, retry _main.
     3943       end.
     3944       IF  context_begin-esys-command( input string(buf_ext-system.esys-id), input-output v-esys-cmd-proc-handle, output v-esys-cmd-code) = false  THEN do:
     3945         undo _main, return error v-last-error-message .
     3946       end.
     3947       v-custom-pack-name = "RETANN_&pack-num.xml".
     3948       v-date-chr = subst(
     3949           "&1-&2-&3",
     3950           string(year(v-fact-date), "9999"),
     3951           string(month(v-fact-date), "99"),
     3952           string(day(v-fact-date), "99")).
     3953       create sax-writer sw .
     3954       create sax-attributes swa .
     3955       swa:insert-attribute ("unitOfMeasure", "") .
     3956       sw:formatted = true.
     3957       sw:set-output-destination ("memptr", v-DATA).
     3958       sw:encoding = "UTF-8".
     3959       sw:start-document () .
     3960       sw:start-element ("eDIMessage") .
     3961       sw:insert-attribute ("id", (v-current-doc-code + "_" + string(TODAY) + string(TIME))) .
     3962           sw:start-element ("interchangeHeader") .
     3963               sw:write-data-element ("sender", v-frm-gln) .
     3964               sw:write-data-element ("recipient", v-cli-gln) .
     3965               sw:write-data-element ("documentType", "RETANN") .
     3966               sw:write-data-element ("creationDateTime", substring(iso-date(NOW), 1, 23) + "Z")  .
     3967           sw:end-element ("interchangeHeader") .
     3968           sw:start-element ("announcementForReturns") .
     3969           sw:insert-attribute ("number", v-current-doc-code) .
     3970           sw:insert-attribute ("date", v-date-chr) .
     3971               sw:start-element ("seller") .
     3972                   sw:write-data-element ("gln", v-cli-gln) .
     3973                   find first ub.firm no-lock where ub.firm.firm-code = buf_clients.obj-code no-error .
     3974                   sw:start-element ("organization") .
     3975                       sw:write-data-element ("name", buf_clients.obj-name) .
     3976                       sw:write-data-element ("inn", ub.firm.inn) .
     3977                       sw:write-data-element ("kpp", ub.firm.kpp) .
     3978                   sw:end-element ("organization") .
     3979               sw:end-element ("seller") .
     3980               sw:start-element ("buyer") .
     3981                   sw:write-data-element ("gln", v-frm-gln) .
     3982                   find first ub.firm no-lock where ub.firm.firm-code = buf_object.host-code no-error .
     3983                   sw:start-element ("organization") .
     3984                       sw:write-data-element ("name", buf_object.obj-name) .
     3985                       sw:write-data-element ("inn", ub.firm.inn) .
     3986                       sw:write-data-element ("kpp", ub.firm.kpp) .
     3987                   sw:end-element ("organization") .
     3988               sw:end-element ("buyer") .
     3989               sw:start-element ("deliveryInfo") .
     3990                   sw:start-element ("shipFrom") .
     3991                       sw:write-data-element ("gln", v-cli-gln) .
     3992                       find first ub.firm no-lock where ub.firm.firm-code = buf_clients.obj-code no-error .
     3993                       sw:start-element ("organization") .
     3994                           sw:write-data-element ("name", buf_clients.obj-name) .
     3995                           sw:write-data-element ("inn", ub.firm.inn) .
     3996                           sw:write-data-element ("kpp", ub.firm.kpp) .
     3997                       sw:end-element ("organization") .
     3998                   sw:end-element ("shipFrom") .
     3999                   sw:start-element ("shipTo") .
     4000                       sw:write-data-element ("gln", v-obj-gln) .
     4001                       find first ub.firm no-lock where ub.firm.firm-code = buf_object.host-code no-error .
     4002                       sw:start-element ("organization") .
     4003                           sw:write-data-element ("name", buf_object.obj-name) .
     4004                           sw:write-data-element ("inn", ub.firm.inn) .
     4005                           sw:write-data-element ("kpp", ub.firm.kpp) .
     4006                       sw:end-element ("organization") .
     4007                   sw:end-element ("shipTo") .
     4008               sw:end-element ("deliveryInfo") .
     4009               sw:start-element ("lineItems") .
     4010       for each buf_doc-line no-lock where
     4011                 buf_doc-line.doc-code = v-current-doc-code
     4012       on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4013       on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
     4014       on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
     4015       :
     4016         find first buf_goods
     4017           where buf_goods.artic = buf_doc-line.artic
     4018           and buf_goods.prod-type = buf_doc-line.prod-type
     4019           and buf_goods.prod-code = buf_doc-line.prod-code
     4020           no-lock no-error.
     4021         if not avail buf_goods then
     4022           return error subst(
     4023               "Не найден товар Артик: &1, Производитель: &2&3",
     4024               buf_doc-line.artic,
     4025               buf_doc-line.prod-type,
     4026               buf_doc-line.prod-code
     4027           ).
     4028         find first buf_ext-artic
     4029           where buf_ext-artic.cli-type = v-cli-type
     4030           and buf_ext-artic.cli-code = v-cli-code
     4031           and buf_ext-artic.gds-code = buf_goods.gds-code
     4032           and buf_ext-artic.status_ = 'тек':U
     4033           no-lock no-error.
     4034         run find-bcod(buf_goods.gds-code, output v-b-code).
     4035                   sw:start-element ("lineItem") .
     4036                       sw:write-data-element ("gtin", v-b-code) .
     4037                       sw:write-data-element ("internalBuyerCode", string(buf_goods.gds-code)) .
     4038                       sw:write-data-element ("internalSupplierCode", if avail buf_ext-artic then buf_ext-artic.ext-artic else "") .
     4039                       sw:write-data-element ("lineNumber", string(buf_doc-line.line-num)) .
     4040                       sw:write-data-element ("description", buf_goods.gds-name) .
     4041                       find first ub.units no-lock where ub.units.unit-name = buf_goods.unit-base.
     4042                       swa:update-attribute ("unitOfMeasure", (if ub.units.type = 'шту':U then "PCE" else "KGM")) .
     4043                       sw:write-data-element ("returnQuantity", trim(string(buf_doc-line.fact-qnty, "->>>>>>>>9.999")), "", swa) .
     4044                       sw:write-data-element ("netPriceWithVAT", trim(string(buf_doc-line.price-cli, "->>>>>>>>9.9999"))) .
     4045                       sw:write-data-element ("vATRate", trim(string(integer(buf_doc-line.vat-pc)))) .
     4046                   sw:end-element ("lineItem") .
     4047       end.
     4048               sw:end-element ("lineItems") .
     4049           sw:end-element ("order") .
     4050       sw:end-element ("eDIMessage") .
     4051       sw:end-document () .
     4052       delete object sw.
     4053       delete object swa.
     4054       IF ExpData1:esys-add-dump-data ( INPUT v-DATA, INPUT v-esys-cmd-proc-handle, INPUT v-esys-cmd-code, '+update') = false  THEN do:
     4055           undo _main, return error v-last-error-message .
     4056       end.
     4057       IF  context_set-custom-esys-pck-name(  input v-esys-cmd-proc-handle, input v-esys-cmd-code, input v-custom-pack-name) = false  THEN do:
     4058         undo _main, return error v-last-error-message .
     4059       end.
     4060       v-dump-ord-int64 = context_send-esys-command( input string(buf_ext-system.esys-id), input v-esys-cmd-proc-handle, input v-esys-cmd-code, input g#userid).
     4061       if v-dump-ord-int64 = 0 THEN do:
     4062         undo _main, return error v-last-error-message .
     4063       end.
     4064           ExpData1:Route-data_clear-data ( ) .
     4065     end.
     4066   end.
     4067   end procedure.
     4068   procedure load-ruleset-context :
     4069   define input parameter p-ruleset-id as integer no-undo .
     4070   define variable v-is-waiting-status as logical   no-undo .
     4071   define variable v-direction as character no-undo .
     4072   define variable v-dm as integer no-undo .
     4073   define variable v-ext-doc-type as character no-undo .
     4074   define buffer buf_rule-call-param for ub.rule-call-param.
     4075   define buffer buf_ord-chain  for ub.ord-chain.
     4076   do
     4077   on error undo, return error
     4078   :
     4079     if g#news then
     4080       return "return".
     4081     assign
     4082         v-oldbh = widget-handle (entry(2, p-doc-code, chr(4)))
     4083         v-newbh = widget-handle (entry(3, p-doc-code, chr(4)))
     4084         v-changes-list = entry(4, p-doc-code, chr(4))
     4085         file-name  = p-process-file-name
     4086         v-has-oldbh = valid-handle(v-oldbh) and v-oldbh:available
     4087         v-has-newbh = valid-handle(v-newbh) and v-newbh:available
     4088     .
     4089     if not v-has-newbh
     4090     and not v-has-oldbh then do:
     4091       undo, return error substitute("Не определено ни одного буфера - ни старый, ни новый").
     4092     end.
     4093     if not v-has-oldbh
     4094     and v-changes-list  = '' then do:
     4095        undo, return error substitute("Не определен старый буфер и список изменений").
     4096     end.
     4097     case p-ruleset-id:
     4098     when 115 then do:
     4099       if v-has-newbh
     4100       and v-newbh:table <> 'trn-doc':U then do:
     4101         undo, return error substitute("Передан неверный буфер вместо буфера для &1",  'ord-doc-rcv':U).
     4102       end.
     4103     end.
     4104     otherwise do:
     4105       undo, return error substitute("Неверный вызов &1 для набора правил &2", vss-workfile , p-ruleset-id).
     4106     end.
     4107     end case.
     4108     run statq_has-waiting-stat in this-procedure (
     4109                                                     input v-oldbh
     4110                                                    ,input v-newbh
     4111                                                    ,input v-changes-list
     4112                                                    ,input 'факт':U
     4113                                                    ,input ?
     4114                                                    ,input 0
     4115                                                    ,output v-is-waiting-status
     4116                                                    ,output v-direction
     4117                                                    ) no-error.
     4118     if v-is-waiting-status = no
     4119     or entry(1, v-direction, chr(4)) = 'удаление':U
     4120     then do:
     4121       return "return".
     4122     end.
     4123     assign
     4124         v-current-doc-code = v-newbh::doc-code
     4125         v-doc-date = v-newbh::doc-date
     4126         v-fact-date = v-newbh::fact-date
     4127         v-ps = v-newbh::ps
     4128         v-ext-doc-type = v-newbh::ext-doc-type
     4129         v-fact-qnty = v-newbh::fact-qnty
     4130     .
     4131     if v-ext-doc-type <> 'ep':U then do:
     4132       return "return".
     4133     end.
     4134     if not v-has-newbh then return "return".
     4135     v-current-obj-type = v-newbh::obj-type.
     4136     v-current-obj-code = v-newbh::obj-code.
     4137     v-cli-type = v-newbh::cli-type.
     4138     v-cli-code = v-newbh::cli-code.
     4139     v-current-host-code = v-newbh::host-code.
     4140     if not status-is-edi(
     4141         true,
     4142         v-cli-type,
     4143         v-cli-code,
     4144         v-current-obj-type,
     4145         v-current-obj-code,
     4146         output v-dm-edi
     4147     ) then return "return".
     4148     find first buf_rule-call-param no-lock
     4149       where buf_rule-call-param.codex_id = p-codex-id
     4150       and buf_rule-call-param.ruleset_id = p-ruleset-id
     4151       and buf_rule-call-param.call_id = p-call-id
     4152       and buf_rule-call-param.order_id = p-order-id
     4153       and buf_rule-call-param.rule_id = p-rule-id
     4154       and buf_rule-call-param.param-name = "p-xsd-file"
     4155       no-error.
     4156     if available buf_rule-call-param then do:
     4157       assign p-xsd-file = buf_rule-call-param.param-value-character.
     4158     end.
     4159   end.
     4160   end procedure.
     4161   procedure find-bcod:
     4162       define input  parameter p-gds-code    as integer   no-undo.
     4163       define output parameter p-bcod        as character no-undo.
     4164       define variable v-is-new as logical no-undo.
     4165       define variable v-flag   as logical no-undo.
     4166       define variable v-bcod   as integer no-undo.
     4167       define variable v-rec1   as recid   no-undo init 0.
     4168       define buffer lc_goods      for ub.goods.
     4169       define buffer lc_gds-prt    for ub.gds-prt.
     4170       define buffer lc_bar-code   for ub.bar-code.
     4171       define buffer lc_prod-bc    for ub.prod-bc.
     4172       find first lc_goods no-lock
     4173           where lc_goods.gds-code = p-gds-code.
     4174       find first lc_gds-prt
     4175           where lc_gds-prt.upper-code = lc_goods.prt-root
     4176           no-lock.
     4177   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     4178     (input  lc_goods.gds-code
     4179     ,input  ?
     4180     ,output v-bcod
     4181     ) no-error .
     4182       if error-status:ERROR then
     4183           return error subst("Не удалось получить корневой БК для &1", lc_goods.gds-code).
     4184       for each lc_prod-bc no-lock
     4185           where lc_prod-bc.b-code = v-bcod
     4186           and lc_prod-bc.bc-on = true
     4187           :
     4188               if not (length(lc_prod-bc.b-str) = 8
     4189                   or
     4190                   (length(lc_prod-bc.b-str) >= 11
     4191                   and
     4192                   length(lc_prod-bc.b-str) <= 14)
     4193                   )
     4194                   then next.
     4195   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4196   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbcat in g#library
     4197     (buffer lc_prod-bc
     4198     ,input  'petrolium=request':u
     4199     ,output v-flag
     4200     ) no-error .
     4201               if error-status:error then
     4202                   return error subst("Не удалось определить свойство для БК &1", lc_goods.gds-code).
     4203               if v-flag then next.
     4204   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4205   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbcat in g#library
     4206     (buffer lc_prod-bc
     4207     ,input  'pgweight=request':u
     4208     ,output v-flag
     4209     ) no-error .
     4210               if error-status:error then
     4211                   return error subst("Не удалось определить свойство для БК &1", lc_goods.gds-code).
     4212               if v-flag then next.
     4213   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4214   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbcat in g#library
     4215     (buffer lc_prod-bc
     4216     ,input  'pgweight=request':u
     4217     ,output v-flag
     4218     ) no-error .
     4219               if error-status:error then
     4220                   return error subst("Не удалось определить свойство для БК &1", lc_goods.gds-code).
     4221               if v-flag then next.
     4222               v-rec1 = recid(lc_prod-bc).
     4223       end.
     4224       if v-rec1 <> 0 then do:
     4225           find first lc_prod-bc no-lock
     4226               where recid(lc_prod-bc) = v-rec1.
     4227           p-bcod = lc_prod-bc.b-str.
     4228       end.
     4229       else do:
     4230           run gen-bc(v-bcod, output p-bcod).
     4231       end.
     4232   end.
