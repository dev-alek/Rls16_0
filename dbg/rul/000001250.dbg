     3244           if error-status:error then do:
     3245                      run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при сохранении/пересылке по СПН:&1&2&1&3"                                       , chr(10)                                       , error-status:get-message(1)                                       , return-value )).                      assign v-view-log = yes.
     3246             undo _main, return error .
     3247           end.
     3248           run before-command in p-parent-handle (buffer buf_temp-cmd) no-error.
     3249           if error-status:error then do:
     3250                      run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при инициации сохранения/пересылки пакета по СПН:&1&2&1&3"                                       , chr(10)                                       , error-status:get-message(1)                                       , return-value )).                      assign v-view-log = yes.
     3251           end.
     3252           find first buf_temp-cmd use-index pi.
     3253           p-cmd-code = buf_temp-cmd.cmd-code.
     3254         end.
     3255       end.
     3256       if not v-stop then do:
     3257         num-rec = num-rec - 1.
     3258       end.
     3259       input stream instream close.
     3260       run write-log-and-file in p-log-handle (
     3261             input 1
     3262           , input log-file-name
     3263           , input 1
     3264                                             , input substitute("Записи &1-&2: сохранение/пересылка в СПН..."
     3265                                             , (num-rec - num-rec modulo 100 + 1), num-rec)).
     3266       find first buf_temp-cmd use-index pi.
     3267       run after-command in p-parent-handle (buffer buf_temp-cmd) no-error.
     3268       if error-status:error then do:
     3269               run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при сохранении/пересылке по СПН:&1&2&1&3"                                   , chr(10)                                   , error-status:get-message(1)                                   , return-value )).                      assign v-view-log = yes.
     3270         undo _main, return error .
     3271       end.
     3272       run before-command in p-parent-handle (buffer buf_temp-cmd) no-error.
     3273       if error-status:error then do:
     3274               run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при инициации сохранения/пересылки пакета по СПН:&1&2&1&3"                                   , chr(10)                                   , error-status:get-message(1)                                   , return-value )).                      assign v-view-log = yes.
     3275       end.
     3276       find first buf_temp-cmd use-index pi.
     3277       p-cmd-code = buf_temp-cmd.cmd-code.
     3278       run write-log-and-file in p-log-handle (
     3279             input 1
     3280           , input log-file-name
     3281           , input 1
     3282           , input substitute("Обработано строк: &1, из них удачно: &2", num-rec, num-rec-ok)).
     3283     end.
     3284   end procedure.
     3285   procedure load-ruleset-context :
     3286   define input parameter p-ruleset-id as integer no-undo .
     3287   define buffer buf_rule-call-param for tt0-rule-call-param.
     3288     do
     3289     on error undo, return error
     3290     :
     3291    find first buf_rule-call-param no-lock where
     3292   buf_rule-call-param.codex_id = p-codex-id
     3293   and buf_rule-call-param.ruleset_id = p-ruleset-id
     3294   and buf_rule-call-param.call_id = p-call-id
     3295   and buf_rule-call-param.order_id = p-order-id
     3296   and buf_rule-call-param.rule_id = p-rule-id
     3297   and buf_rule-call-param.param-name = "p-cli-type-code"
     3298    no-error.
     3299   if available buf_rule-call-param then do:
     3300   assign p-cli-type-code = buf_rule-call-param.param-value-character.
     3301   end.
     3302    find first buf_rule-call-param no-lock where
     3303   buf_rule-call-param.codex_id = p-codex-id
     3304   and buf_rule-call-param.ruleset_id = p-ruleset-id
     3305   and buf_rule-call-param.call_id = p-call-id
     3306   and buf_rule-call-param.order_id = p-order-id
     3307   and buf_rule-call-param.rule_id = p-rule-id
     3308   and buf_rule-call-param.param-name = "p-issue-code"
     3309    no-error.
     3310   if available buf_rule-call-param then do:
     3311   assign p-issue-code = buf_rule-call-param.param-value-integer.
     3312   end.
     3313    find first buf_rule-call-param no-lock where
     3314   buf_rule-call-param.codex_id = p-codex-id
     3315   and buf_rule-call-param.ruleset_id = p-ruleset-id
     3316   and buf_rule-call-param.call_id = p-call-id
     3317   and buf_rule-call-param.order_id = p-order-id
     3318   and buf_rule-call-param.rule_id = p-rule-id
     3319   and buf_rule-call-param.param-name = "p-issue-date"
     3320    no-error.
     3321   if available buf_rule-call-param then do:
     3322   assign p-issue-date = buf_rule-call-param.param-value-date.
     3323   end.
     3324    find first buf_rule-call-param no-lock where
     3325   buf_rule-call-param.codex_id = p-codex-id
     3326   and buf_rule-call-param.ruleset_id = p-ruleset-id
     3327   and buf_rule-call-param.call_id = p-call-id
     3328   and buf_rule-call-param.order_id = p-order-id
     3329   and buf_rule-call-param.rule_id = p-rule-id
     3330   and buf_rule-call-param.param-name = "p-valid-date"
     3331    no-error.
     3332   if available buf_rule-call-param then do:
     3333   assign p-valid-date = buf_rule-call-param.param-value-date.
     3334   end.
     3335       case p-ruleset-id:
     3336         when 1 then do:
     3337           for each buf_cash-pay no-lock where
     3338                  buf_cash-pay.curr-code = 0
     3339           by buf_cash-pay.cdpay-code:
     3340              if buf_cash-pay.is-cash then do:
     3341                leave.
     3342              end.
     3343           end.
     3344           if not available buf_cash-pay then do:
     3345             run write-log-and-file in p-log-handle (
     3346                   input 1
     3347                 , input log-file-name
     3348                 , input 1
     3349                 , input substitute("Не найдено ни одного типа кассового платежа с валютой &1 и свойством <НАЛИЧНЫЕ>,&2" +
     3350                                    "к которому можно привязать импортируемые суммы покупок по ДК"
     3351                                    , 0
     3352                                    , chr(10)
     3353                                    )).
     3354             assign
     3355             v-view-log = yes.
     3356             .
     3357             return error.
     3358           end.
     3359           assign
     3360           v-sign = 1
     3361           v-current-host-code = p-host-code
     3362           v-current-obj-type = p-obj-type
     3363           v-current-obj-code = p-obj-code
     3364           v-current-doc-code = p-doc-code
     3365           v-current-db-num = g#db-num
     3366           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     3367           v-current-date = p-doc-date
     3368           file-name  = p-process-file-name
     3369           .
     3370           if NOT g#db-num = 0 then do:
     3371             run write-log-and-file in p-log-handle (
     3372                   input 1
     3373                 , input log-file-name
     3374                 , input 1
     3375                 , input substitute("Импорт клиентов и их дисконтных карт возможен только в ГБД")).
     3376             assign
     3377             v-view-log = yes.
     3378             .
     3379             return "return".
     3380           end.
     3381           run gbl/filename.p (
     3382                           input  file-name
     3383                           ,output v-full-path
     3384                           ,output v-path
     3385                           ,output v-file-name
     3386                           ,output v-file-name-no-ext
     3387                           ,output v-file-name-ext
     3388                           ) no-error .
     3389           if error-status:error then do:
     3390             run write-log-and-file in p-log-handle (
     3391                   input 1
     3392                 , input log-file-name
     3393                 , input 1
     3394                 , input substitute("Не найден файл для импорта физ.лиц/ДК &1", file-name)).
     3395             assign
     3396             v-view-log = yes.
     3397             .
     3398             return "return".
     3399           end.
     3400           assign
     3401           file-name = v-full-path.
     3402           run gbl/filnline.p (
     3403                         input file-name
     3404                         ,output v-end-new-line).
     3405           if v-end-new-line = no then do:
     3406             output stream Instream to value(file-name) append.
     3407             put stream instream unformatted skip(1).
     3408             output stream Instream close.
     3409           end.
     3410         end.
     3411       end case.
     3412     end.
     3413   end procedure.
     3414   procedure 00040000_set-vpay-chk  :
     3415   define input parameter p-bh as handle no-undo .
     3416   define buffer buf_vchk-pay for vchk-pay.
     3417   find first buf_vchk-pay no-lock where
     3418             buf_vchk-pay.d-card = p-bh:buffer-field("d-card"):buffer-value
     3419         and buf_vchk-pay.pay-code = buf_cash-pay.cdpay-code
     3420         and buf_vchk-pay.curr-code = 0
     3421         and buf_vchk-pay.doc-date = v-current-date
     3422         and buf_vchk-pay.cre-pay = no
     3423         and buf_vchk-pay.exch-rate = p-bh:buffer-field("pay-tot-rubl"):buffer-value / p-bh:buffer-field("pay-tot-base"):buffer-value
     3424         and buf_vchk-pay.base-rate = p-bh:buffer-field("pay-tot-rubl"):buffer-value / p-bh:buffer-field("pay-tot-base"):buffer-value
     3425         no-error .
     3426    if not available buf_vchk-pay then do:
     3427      create buf_vchk-pay.
     3428      assign
     3429      buf_vchk-pay.d-card = p-bh:buffer-field("d-card"):buffer-value
     3430      buf_vchk-pay.pay-code = buf_cash-pay.cdpay-code
     3431      buf_vchk-pay.curr-code = 0
     3432      buf_vchk-pay.doc-date = v-current-date
     3433      buf_vchk-pay.cre-pay = no
     3434      buf_vchk-pay.exch-rate = p-bh:buffer-field("pay-tot-rubl"):buffer-value / p-bh:buffer-field("pay-tot-base"):buffer-value
     3435      buf_vchk-pay.base-rate = p-bh:buffer-field("pay-tot-rubl"):buffer-value / p-bh:buffer-field("pay-tot-base"):buffer-value
     3436      .
     3437    end.
     3438    assign
     3439    buf_vchk-pay.tot-sum = buf_vchk-pay.tot-sum + p-bh:buffer-field("pay-tot-rubl"):buffer-value
     3440    buf_vchk-pay.tot-base = buf_vchk-pay.tot-base + p-bh:buffer-field("pay-tot-base"):buffer-value
     3441    buf_vchk-pay.tot-rubl = buf_vchk-pay.tot-rubl + p-bh:buffer-field("pay-tot-rubl"):buffer-value
     3442    .
     3443   end procedure.
     3444   procedure create_clients_:
     3445   define input parameter p-obj-type as character no-undo .
     3446   define input parameter p-obj-code as integer no-undo .
     3447   define buffer buf_temp-clients_ for temp-clients_.
     3448   find first buf_temp-clients_ where
     3449             buf_temp-clients_.obj-type = p-obj-type
     3450        and  buf_temp-clients_.obj-code = p-obj-code no-error .
     3451   if not available buf_temp-clients_ then do:
     3452     create buf_temp-clients_.
     3453     assign
     3454     buf_temp-clients_.obj-type = p-obj-type
     3455     buf_temp-clients_.obj-code = p-obj-code
     3456     .
     3457   end.
     3458   end procedure.
     3459   procedure create_dis-card_:
     3460   define input parameter p-d-card as character no-undo .
     3461   define buffer buf_temp-dis-card_ for temp-dis-card_.
     3462   find first buf_temp-dis-card_ where
     3463             buf_temp-dis-card_.d-card = p-d-card no-error .
     3464   if not available buf_temp-dis-card_ then do:
     3465     create buf_temp-dis-card_.
     3466     assign
     3467     buf_temp-dis-card_.d-card = p-d-card
     3468     .
     3469   end.
     3470   end procedure.
     3471   procedure can-find_clients_  :
     3472   define input parameter p-obj-type as character no-undo .
     3473   define input parameter p-obj-code as integer no-undo .
     3474   define output parameter p-find as logical no-undo .
     3475   find first temp-clients_ where
     3476                        temp-clients_.obj-type = p-obj-type
     3477                    and temp-clients_.obj-code = p-obj-code no-error.
     3478   p-find = available temp-clients_.
     3479   end procedure.
     3480   procedure can-find_dis-card_  :
     3481   define input parameter p-d-card as character no-undo .
     3482   define output parameter p-find as logical no-undo .
     3483   find first temp-dis-card_ where
     3484                        temp-dis-card_.d-card = p-d-card no-error.
     3485   p-find = available temp-dis-card_.
     3486   end procedure.
     3487   procedure delete-procedure :
     3488     do
     3489     on error undo, return error
     3490     :
     3491         for each temp-clients_:
     3492           delete temp-clients_.
     3493         end.
     3494         for each temp-dis-card_:
     3495           delete temp-dis-card_.
     3496         end.
     3497         run garbcoll_clear in this-procedure .
     3498     end.
     3499   end procedure.
     3500   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3501   define   temp-table import-temp-d-card no-undo
     3502   field card-num as integer
     3503   field d-card as character
     3504   field dt-code as integer
     3505   field first-card as character
     3506   field first-main-card as character
     3507   field gds-dis-base as decimal
     3508   field gds-dis-rubl as decimal
     3509   field gds-tot-b0   as decimal
     3510   field gds-tot-base as decimal
     3511   field gds-tot-r0   as decimal
     3512   field gds-tot-rubl as decimal
     3513   field host-code as integer
     3514   field main-card as character
     3515   field num-chk as integer
     3516   field obj-code as integer
     3517   field obj-type as character
     3518   field pay-tot-base as decimal
     3519   field pay-tot-rubl as decimal
     3520   field sum-dis-base as decimal
     3521   field sum-dis-rubl as decimal
     3522   field sum-tot-base as decimal
     3523   field sum-tot-rubl as decimal
     3524   field sum-tot-r-b         as decimal
     3525   field gds-tot-r-b         as decimal
     3526   field gds-dis-r-b         as decimal
     3527   field cli-type            as character
     3528   field cli-code            as integer
     3529   field emitent-host-code   as integer
     3530   field type                as character
     3531   field exp-imp             as logical
     3532   field sale-doc            as character
     3533   field sale-type           as character
     3534   field doc-date            as date
     3535   field base-code           as integer
     3536   field smart-nws-log       as logical init ?
     3537   field action              as integer
     3538   index pi is unique primary
     3539   d-card
     3540   obj-type obj-code
     3541   index iobj obj-type obj-code
     3542   index itype type emitent-host-code
     3543   .
     3544   procedure 00040000_after-import :
     3545   define input  parameter p-d-card as character no-undo .
     3546   define variable v-ii as integer   no-undo .
     3547   define variable v-jj as integer   no-undo .
     3548   define variable v-codex-id as integer   no-undo .
     3549   define variable v-ruleset-id as integer   no-undo .
     3550   define variable v-ai-ruleset-id-list as character no-undo extent 4.
     3551   define variable v-ai-codex-id-list as character no-undo .
     3552   define variable v-proc-name as character no-undo .
     3553   define buffer buf_temp-d-card for temp-d-card.
     3554   define buffer buf_Dis-card for ub.dis-card.
     3555   define buffer buf_import-temp-d-card for import-temp-d-card.
     3556   define buffer buf_rule-by-call for ub.rule-by-call.
     3557     main-block:
     3558     do
     3559     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3560     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     3561     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     3562     :
     3563         assign
     3564         v-ai-codex-id-list = (if g#db-num = 0
     3565                            then "1,2"
     3566                            else '':U)
     3567         v-ai-ruleset-id-list[1] = string(5)
     3568         v-ai-ruleset-id-list[2] = "6,5"
     3569         v-ai-ruleset-id-list[3] = ''
     3570         .
     3571         find first buf_temp-d-card where
     3572                  buf_temp-d-card.d-card = p-d-card no-error.
     3573         if not available buf_temp-d-card then do:
     3574           find first buf_Dis-card exclusive-lock where
     3575                     buf_dis-card.d-card = p-d-card no-error.
     3576           if not available  buf_dis-card then do:
     3577             undo main-block, return error substitute("ДК &1 не найдена").
     3578           end.
     3579         end.
     3580         create buf_import-temp-d-card.
     3581         if available buf_temp-d-card then do:
     3582           buffer-copy buf_temp-d-card to buf_import-temp-d-card.
     3583         end.
     3584         else do:
     3585           buffer-copy buf_dis-card to buf_import-temp-d-card
     3586           assign
     3587           buf_import-temp-d-card.obj-type = p-obj-type
     3588           buf_import-temp-d-card.obj-code = p-obj-code
     3589           buf_import-temp-d-card.host-code = p-host-code
     3590           .
     3591         end.
     3592         release buf_temp-d-card.
     3593         _codex:
     3594         do v-jj = 1 to num-entries(v-ai-codex-id-list):
     3595           if entry(v-jj, v-ai-codex-id-list) = '':U then next _codex.
     3596           v-codex-id = integer(entry(v-jj, v-ai-codex-id-list)).
     3597           do v-ii = 1 to num-entries(v-ai-ruleset-id-list[v-jj]):
     3598              if entry(v-ii, v-ai-ruleset-id-list[v-jj]) = '':U then next.
     3599              v-ruleset-id = integer(entry(v-ii, v-ai-ruleset-id-list[v-jj])).
     3600             _rule-by-call:
     3601             for each buf_rule-by-call no-lock where
     3602                       buf_rule-by-call.call_id = p-call-id
     3603                 and buf_rule-by-call.can-calc = yes
     3604                 and buf_rule-by-call.codex_id = v-codex-id
     3605                 and buf_rule-by-call.ruleset_id = v-ruleset-id
     3606             by buf_rule-by-call.call_Id
     3607             by buf_rule-by-call.codex_id
     3608             by buf_rule-by-call.ruleset_id
     3609             by buf_rule-by-call.order_id
     3610             on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3611             on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     3612             on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile ) :
     3613               if not (buf_rule-by-call.profile_id = p-profile-id
     3614                       or
     3615                       buf_rule-by-call.profile_id = 1
     3616                       )
     3617               then next _rule-by-call.
     3618               v-proc-name = "rul/" + string(buf_rule-by-call.rule_id, '999999999') + '.p'.
     3619               run value(v-proc-name)  (
     3620                                                              input parparentproc
     3621                                                             ,input p-parent-handle
     3622                                                             ,input p-log-handle
     3623                                                             ,input p-cont-handle
     3624                                                             ,input v-codex-id
     3625                                                             ,input v-ruleset-id
     3626                                                             ,input p-call-id
     3627                                                             ,input buf_rule-by-call.order_id
     3628                                                             ,input buf_rule-by-call.rule_id
     3629                                                             ,input buf_rule-by-call.profile
     3630                                                             ,input buf_rule-by-call.is_dynamic
     3631                                                             ,input p-doc-type
     3632                                                             ,input buf_import-temp-d-card.host-code
     3633                                                             ,input buf_import-temp-d-card.obj-type
     3634                                                             ,input buf_import-temp-d-card.obj-code
     3635                                                             ,input p-doc-code
     3636                                                             ,input p-process-file-name
     3637                                                             ,input p-doc-date
     3638                                                             ,input p-fact-date
     3639                                                             ,input p-save
     3640                                                             ,input v-curr-r-b
     3641                                                             ,input p-cmd-proc-handle
     3642                                                             ,input p-cmd-code
     3643                                                             ,input p-type
     3644                                                             ,input p-emitent-host-code
     3645                                                             ,input table import-temp-d-card
     3646                                                             ) no-error .
     3647           if error-status:error then do:
     3648             undo main-block, return error substitute("Ошибка при выполнении правила &1 ( профайл &2) для ДК &3&4&5&4&6"
     3649                                                      ,buf_rule-by-call.rule_id
     3650                                                      ,buf_rule-by-call.profile_id
     3651                                                      ,p-d-card
     3652                                                      ,chr(10)
     3653                                                      ,error-status:get-message(1)
     3654                                                      ,return-value ).
     3655           end.
     3656         end.
     3657       end.
     3658     end.
     3659     find first buf_import-temp-d-card where buf_import-temp-d-card.d-card = p-d-card.
     3660     delete buf_import-temp-d-card.
     3661   end.
     3662   end procedure.
