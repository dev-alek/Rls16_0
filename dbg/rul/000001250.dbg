     3029   procedure proc-main :
     3030   define input parameter p-type like ub.dis-card.type no-undo .
     3031   define input parameter p-emitent-host-code like ub.dis-card.emitent-host-code no-undo .
     3032   _main:
     3033   do
     3034   on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3035   on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
     3036   on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
     3037   :
     3038   assign
     3039   v-emitent-host-code = p-emitent-host-code
     3040   v-type = p-type.
     3041   run write-log  in p-log-handle (
     3042                                    input 0
