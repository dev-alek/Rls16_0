     3206             run write-log-and-file in p-log-handle (
     3207                                                     input 1
     3208                                                   , input log-file-name
     3209                                                   , input 1
     3210                                                   , input substitute("&1&2&3"
     3211                                                                     , error-status:get-message(1)
     3212                                                                     , chr(10)
     3213                                                                     , v-last-error-message )).
     3214           end.
