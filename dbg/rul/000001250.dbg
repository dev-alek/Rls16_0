     1881   procedure library-cls_get-handle :
     1882   define input parameter p-library-name as character no-undo .
     1883   define output parameter p-library-handle as handle no-undo .
     1884     do
     1885     on error undo, return error
     1886     :
     1887       CASE p-library-name:
     1888         when "library" then do:
     1889           if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end.
     1890           p-library-handle = g#library.
     1891         end.
     1892         when "library2" then do:
     1893           if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end.
     1894           p-library-handle = g#library2.
     1895         end.
     1896       end case.
     1897     end.
     1898   end procedure.
     1899   def var vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1900   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1901   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1902   define variable tempcxml_v-num_ as integer no-undo .
