     3045         input 1
     3046       , input log-file-name
     3047       , input 1
     3048       , input substitute("Импорт физ лиц/карт из файла &1", file-name)).
     3049       input stream Instream from value(file-name).
     3050       _stroka:
     3051       REPEAT:
     3052         v-retry = no.
     3053         if retry then do:
     3054           v-retry = yes.
     3055         end.
     3056         process events.
     3057         run get-stop-state in p-log-handle ( output v-stop) no-error .
     3058         if v-stop then do:
     3059             run write-log-and-file in p-log-handle (
     3060                                                     input 1
     3061                                                   , input log-file-name
     3062                                                   , input 1
     3063                                                   , input substitute("Процесс импорта прерван пользователем")).
     3064            leave _stroka.
     3065         end.
     3066         if not v-retry then
     3067         num-rec = num-rec + 1.
     3068         if not v-retry then do:
     3069         run get-last-rec-ord in p-cmd-proc-handle ( input p-cmd-code, output v-last-rec-ord).
     3070         v-retry-action = 0 .
     3071         end.
     3072        _release:
     3073         do on error undo, retry:
     3074           if  retry
     3075           or v-retry
     3076           then do:
     3077             v-retry-action = v-retry-action + 1.
     3078             run write-log-and-file in p-log-handle (
     3079                                                     input 1
     3080                                                   , input log-file-name
     3081                                                   , input 1
     3082                                                   , input substitute("Ошибка при импорте строки &1&2&3&2&4"
     3083                                                                     , num-rec
     3084                                                                     , chr(10)
     3085                                                                     , error-status:get-message(1)
     3086                                                                     , return-value)).
     3087           end.
     3088   if v-retry-action < 1 then do:
     3089   Card1:Dis-card_release_ ( ) .
     3090   end.
     3091   if v-retry-action < 2 then do:
     3092   Tot-sum1:Dis-tot_release_ ( ) .
     3093   end.
     3094         end.
     3095          v-seek = seek(instream).
     3096          _rule:
     3097          do transaction on error undo _rule, retry _rule:
     3098            if retry
     3099            or v-retry
     3100            then do:
     3101               run write-log-and-file in p-log-handle (
     3102                                                       input 1
     3103                                                     , input log-file-name
     3104                                                     , input 1
     3105                                                     , input substitute("&1&2&3"
     3106                                                                       , error-status:get-message(1)
     3107                                                                       , chr(10)
     3108                                                                       , return-value)).
     3109              run undo-from-rec-ord in p-cmd-proc-handle ( input p-cmd-code, input v-last-rec-ord).
     3110              run clear-from-rec-ord in this-procedure ( input v-last-rec-ord).
     3111              next _stroka.
     3112            end.
     3113            else do:
     3114   _1250:
     3115   do:
     3116    Card-number1 = "" .
     3117    import stream INstream  DELIMITER ';'  Card-number1 d-pcnt1  no-error .
     3118   IF  error-status:error = true  THEN do:
     3119     _1252:
     3120     do:
