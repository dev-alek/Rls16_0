     3217   end.
     3218   if v-retry-action < 2 then do:
     3219   Tot-sum1:Dis-tot_release_ ( ) .
     3220   end.
     3221         end.
     3222         if v-retry-action = 0 then do:
     3223           num-rec-ok = num-rec-ok + 1.
     3224         end.
     3225         run write-counter in p-log-handle ( input substitute("Обработано строк: &1, из них удачно: &2", num-rec, num-rec-ok)).
     3226         process events.
     3227         run get-stop-state in p-log-handle ( output v-stop) no-error .
     3228         if v-stop then do:
     3229             run write-log-and-file in p-log-handle (
     3230                                                     input 1
     3231                                                   , input log-file-name
     3232                                                   , input 1
     3233                                                   , input substitute("Процесс импорта прерван пользователем")).
     3234            leave _stroka.
     3235         end.
     3236         if num-rec modulo 100 = 0 then do:
     3237           run write-log-and-file in p-log-handle (
     3238                                                   input 1
     3239                                                 , input log-file-name
     3240                                                 , input 1
     3241                                                 , input substitute("Записи &1-&2: сохранение/пересылка в СПН...", num-rec - 100, num-rec)).
     3242           find first buf_temp-cmd use-index pi.
