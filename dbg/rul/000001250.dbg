     3137       end.
     3138     end.
     3139      Message1 = Message1 + "~nСтрока :" + String( num-rec) .
     3140      run write-log-and-file in p-log-handle (
     3141                   input 1
     3142                 , input log-file-name
     3143                 , input 1
     3144                 , input Message1).
     3145   assign v-view-log = yes
     3146    .
     3147      next _stroka .
     3148     end.
     3149   end.
     3150   IF  Card1:find_dis-card_no-error( INPUT Card-number1) = false  THEN do:
     3151     _1253:
     3152     do:
     3153     IF  Card1:create_dis-card_( INPUT v-current-obj-type, INPUT v-current-obj-code, INPUT Card-number1, INPUT v-emitent-host-code, INPUT v-type, INPUT p-cli-type-code) = false  THEN do:
     3154       _1257:
     3155       do:
