     1931   def var vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1932   procedure get-gate-file-name :
     1933   define input parameter p-gate-rec as character no-undo .
     1934   define output  parameter p-gate-file-name as character no-undo .
     1935   define buffer buf_clob-data for ub.clob-data.
     1936   define variable v-tbl-row as rowid no-undo .
     1937   define variable v-tbl-name as character no-undo .
     1938   run gen-row-keyr in this-procedure ( input p-gate-rec
     1939                                       ,input ?
     1940                                       ,input "ub"
     1941                                       ,input ?
     1942                                       ,input no-lock
     1943                                       ,output v-tbl-row
     1944                                       ,output v-tbl-name) no-error.
     1945   if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     1946                                                           ,vss-include-info15
     1947                                                           ,p-gate-rec).
     1948   find first buf_clob-data no-lock where
     1949             rowid(buf_clob-data) = v-tbl-row no-error.
     1950   if not available buf_clob-data then do:
     1951     if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     1952                                                             ,vss-include-info15
     1953                                                             ,p-gate-rec).
     1954   end.
     1955   p-gate-file-name = buf_clob-data.file-name.
     1956   end procedure.
     1957   procedure get-gate-rec :
     1958   define input  parameter p-gate-name as character no-undo .
     1959   define output parameter p-gate-rec as character no-undo .
     1960   define buffer buf_clob-bind for ub.clob-bind.
     1961   define buffer buf_clob-data for ub.clob-data.
     1962   main-block:
     1963   do
     1964   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info15, return-value, chr(10), error-status :get-message (1))
     1965   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info15 )
     1966   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info15 )
     1967   :
     1968       find first buf_clob-bind no-lock where
     1969                 buf_clob-bind.uniq-key-rec = p-gate-name
     1970             and buf_clob-bind.field-name = '':U
     1971             and buf_clob-bind.part-num = 1
     1972             and buf_clob-bind.resource-type = 'gate':U
     1973             no-error.
     1974       if not available buf_clob-bind then do:
     1975         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     1976                                         , p-gate-name
     1977                                         ).
     1978       end.
     1979       find first buf_clob-data no-lock where
     1980                 buf_clob-data.db-num = buf_clob-bind.db-num
     1981             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     1982       if not available buf_clob-data then do:
     1983         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1984                                         , buf_clob-bind.db-num
     1985                                         , buf_clob-bind.int64-id
     1986                                         , p-gate-name
     1987                                         ).
     1988       end.
     1989       run gen-key-rec in this-procedure ( input 'clob-data':U
     1990                                 ,input buffer buf_clob-data:handle
     1991                                 ,output p-gate-rec).
     1992   end.
     1993   end procedure.
     1994   procedure get-gate-by-name :
     1995   define input  parameter p-gate-name as character no-undo .
     1996   define output parameter p-gate-rec as character no-undo .
     1997   define output parameter p-dsh as handle no-undo .
     1998   define input-output  parameter p-xmlh as handle no-undo .
     1999   define variable v-ii as integer   no-undo .
     2000   define variable glog as logical   no-undo .
     2001   define variable v-longchar as longchar no-undo .
     2002   define variable v-txmlh as handle no-undo .
     2003   define variable v-db-num as integer no-undo .
     2004   define variable v-int64-id as int64 no-undo .
     2005   define buffer buf_clob-bind for ub.clob-bind.
     2006   define buffer buf_clob-data for ub.clob-data.
     2007   main-block:
     2008   do
     2009   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info15, return-value, chr(10), error-status :get-message (1))
     2010   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info15 )
     2011   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info15 )
     2012   :
     2013       find first buf_clob-bind no-lock where
     2014                 buf_clob-bind.uniq-key-rec = p-gate-name
     2015             and buf_clob-bind.field-name = '':U
     2016             and buf_clob-bind.part-num = 1
     2017             and buf_clob-bind.resource-type = 'gate':U
     2018             no-error.
     2019       if not available buf_clob-bind then do:
     2020         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     2021                                         , p-gate-name
     2022                                         ).
     2023       end.
     2024       find first buf_clob-data no-lock where
     2025                 buf_clob-data.db-num = buf_clob-bind.db-num
     2026             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     2027       if not available buf_clob-data then do:
     2028         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     2029                                         , buf_clob-bind.db-num
     2030                                         , buf_clob-bind.int64-id
     2031                                         , p-gate-name
     2032                                         ).
     2033       end.
     2034       assign
     2035       v-longchar = buf_clob-data.cdata
     2036       .
     2037       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     2038       if error-status :error then do:
     2039         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     2040       end.
     2041       create dataset p-dsh .
     2042       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     2043                                     , v-longchar
     2044                                     , ?
     2045                                     , ?
     2046                                     , ?
     2047                                     ) no-error.
     2048       v-longchar = '':U.
     2049       if error-status :error
     2050       or not glog
     2051       then do:
     2052         undo, return error substitute("Не удалось прочитать XML-схему &1 из БД:&2&3", p-gate-name, chr(10), error-status:get-message(1) ).
     2053       end.
     2054       if not valid-handle(p-xmlh)
     2055       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     2056         create temp-table v-txmlh.
     2057         v-txmlh:create-like(buffer temp-xml-tables:handle).
     2058         v-txmlh:temp-table-prepare("temp-xml-tables").
     2059         p-xmlh = v-txmlh:default-buffer-handle.
     2060       end.
     2061       run gen-key-rec in this-procedure ( input 'clob-data':U
     2062                                 ,input buffer buf_clob-data:handle
     2063                                 ,output p-gate-rec).
     2064       do v-ii = 1 to p-dsh:num-buffers:
     2065         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     2066         if not p-xmlh:available then do:
     2067           p-xmlh:buffer-create().
     2068           assign
     2069           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     2070           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     2071           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     2072           p-xmlh::gate-handle_ = p-dsh
     2073           p-xmlh::uniq-gate-rec = p-gate-rec
     2074           p-xmlh::gate-name = p-dsh:name
     2075           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     2076           .
     2077           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     2078             assign
     2079             p-xmlh::order = -3.
     2080           end.
     2081         end.
     2082       end.
     2083   end.
     2084   end procedure.
     2085   procedure get-gate-by-rec :
     2086   define input  parameter p-gate-rec as character no-undo .
     2087   define output parameter p-dsh as handle no-undo .
     2088   define input-output  parameter p-xmlh as handle no-undo .
     2089   define input-output parameter p-longchar  as longchar no-undo .
     2090   define variable v-ii as integer   no-undo .
     2091   define variable glog as logical   no-undo .
     2092   define variable v-rowid as rowid no-undo .
     2093   define variable v-tbl-name as character no-undo .
     2094   define variable v-longchar as longchar no-undo .
     2095   define variable v-txmlh as handle no-undo .
     2096   define buffer buf_clob-data for ub.clob-data.
     2097   main-block:
     2098   do
     2099   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info15, return-value, chr(10), error-status :get-message (1))
     2100   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info15 )
     2101   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info15 )
     2102   :
     2103     run gen-row-keyr in this-procedure (
     2104                                           input  p-gate-rec
     2105                                           ,input  ?
     2106                                           ,input  "ub"
     2107                                           ,input  ?
     2108                                           ,input  NO-LOCK
     2109                                           ,output v-rowid
     2110                                           ,output v-tbl-name   ) no-error.
     2111       find first buf_clob-data no-lock where
     2112                 rowid(buf_clob-data) = v-rowid  no-error.
     2113       if not available buf_clob-data then do:
     2114         undo, return error substitute("Не найден CLOB  &1"
     2115                                         , p-gate-rec
     2116                                         ).
     2117       end.
     2118       assign
     2119       v-longchar = buf_clob-data.cdata
     2120       .
     2121       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     2122       if error-status :error then do:
     2123         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     2124       end.
     2125       create dataset p-dsh .
     2126       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     2127                                     , v-longchar
     2128                                     , ?
     2129                                     , ?
     2130                                     , ?
     2131                                     ) no-error.
     2132       define variable v-esm as character no-undo .
     2133       v-esm = error-status:get-message(1) .
     2134       if p-longchar <> ? then do:
     2135         p-longchar = v-longchar.
     2136       end.
     2137       v-longchar = '':U.
     2138       if error-status :error
     2139       or not glog
     2140       then do:
     2141         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     2142                                      , p-gate-rec
     2143                                      , p-gate-rec
     2144                                      , v-esm
     2145                                      ).
     2146       end.
     2147       p-dsh:private-data = buf_clob-data.file-name_ + chr(4) + p-gate-rec.
     2148       if not valid-handle(p-xmlh)
     2149       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     2150         create temp-table v-txmlh.
     2151         v-txmlh:create-like(buffer temp-xml-tables:handle).
     2152         v-txmlh:temp-table-prepare("temp-xml-tables").
     2153         p-xmlh = v-txmlh:default-buffer-handle.
     2154       end.
     2155       do v-ii = 1 to p-dsh:num-buffers:
     2156         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     2157         if not p-xmlh:available then do:
     2158           p-xmlh:buffer-create().
     2159           assign
     2160           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     2161           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     2162           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     2163           p-xmlh::gate-handle_ = p-dsh
     2164           p-xmlh::uniq-gate-rec = p-gate-rec
     2165           p-xmlh::gate-name = p-dsh:name
     2166           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     2167           .
     2168           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     2169             assign
     2170             p-xmlh::order = -3.
     2171           end.
     2172           p-xmlh:buffer-release().
     2173         end.
     2174       end.
     2175   end.
     2176   end procedure.
     2177   procedure get-gate-by-file :
     2178   define input  parameter p-schema-file-name as character no-undo .
     2179   define input  parameter p-gate-rec as character no-undo .
     2180   define output parameter p-dsh as handle no-undo .
     2181   define input-output  parameter p-xmlh as handle no-undo .
     2182   define variable v-ii as integer   no-undo .
     2183   define variable glog as logical   no-undo .
     2184   define variable v-rowid as rowid no-undo .
     2185   define variable v-tbl-name as character no-undo .
     2186   define variable v-longchar as longchar no-undo .
     2187   define variable v-txmlh as handle no-undo .
     2188   main-block:
     2189   do
     2190   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info15, return-value, chr(10), error-status :get-message (1))
     2191   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info15 )
     2192   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info15 )
     2193   :
     2194       COPY-LOB
     2195       FROM  FILE p-schema-file-name
     2196       TO  OBJECT v-longchar
     2197       no-convert
     2198       NO-ERROR .
     2199       if error-status :error then do:
     2200           undo, return error substitute("Не удалось считать файл схемы &1 в память&2&3"
     2201                                     , p-schema-file-name
     2202                                 , chr(10)
     2203                                 , error-status:get-message(1) ).
     2204       end.
     2205       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     2206       if error-status :error then do:
     2207         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, p-schema-file-name, chr(10), error-status:get-message(1) , return-value ).
     2208       end.
     2209       create dataset p-dsh .
     2210       glog = p-dsh:READ-XMLSCHEMA( "longchar"
     2211                                     , v-longchar
     2212                                     , ?
     2213                                     , ?
     2214                                     , ?
     2215                                     ) no-error.
     2216       v-longchar = ''.
     2217       if error-status :error
     2218       or not glog
     2219       then do:
     2220         undo, return error substitute("Не удалось прочитать XML-схему из файла &1&2&3"
     2221                                      , p-schema-file-name
     2222                                      ,chr(10)
     2223                                      , error-status:get-message(1)
     2224                                      ).
     2225       end.
     2226       if not valid-handle(p-xmlh)
     2227       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     2228         create temp-table v-txmlh.
     2229         v-txmlh:create-like(buffer temp-xml-tables:handle).
     2230         v-txmlh:temp-table-prepare("temp-xml-tables").
     2231         p-xmlh = v-txmlh:default-buffer-handle.
     2232       end.
     2233       do v-ii = 1 to p-dsh:num-buffers:
     2234         p-xmlh:find-first(substitute(' where tbl-name = "&1" and  uniq-gate-rec = "&2" '
     2235                                      ,p-dsh:get-buffer-handle(v-ii):name
     2236                                      ,p-gate-rec
     2237                                      )) no-error.
     2238         if not p-xmlh:available then do:
     2239           p-xmlh:buffer-create().
     2240           assign
     2241           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):table
     2242           p-xmlh::uniq-gate-rec = p-gate-rec
     2243           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     2244           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     2245           p-xmlh::gate-handle_ = p-dsh
     2246           p-xmlh::gate-name = p-dsh:name
     2247           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     2248           .
     2249           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     2250             assign
     2251             p-xmlh::order = -3.
     2252           end.
     2253           p-xmlh:buffer-release().
     2254         end.
     2255       end.
     2256   end.
     2257   end procedure.
     2258   procedure gate-clear :
     2259   define input  parameter p-dsh as handle no-undo .
     2260   define input  parameter p-xmlh as handle no-undo .
     2261   define variable v-dsh as handle no-undo .
     2262   define variable v-th as handle no-undo .
     2263     do
     2264     on error undo, return error return-value
     2265     :
     2266       if valid-handle(p-dsh) then do:
     2267         delete object p-dsh.
     2268         v-dsh = p-dsh.
     2269         p-dsh = ?.
     2270       end.
     2271       repeat while true:
     2272         p-xmlh:find-first( substitute( " where gate-handle_ = &1 ", v-dsh)
     2273                            , share-lock) no-error.
     2274         if p-xmlh:available then do:
     2275           assign
     2276           v-th = p-xmlh:buffer-field("table-handle_"):buffer-value.
     2277           if valid-handle(p-xmlh:buffer-field("table-handle_"))
     2278           and valid-handle(v-th)
     2279           and v-th:dynamic = yes
     2280           then do:
     2281             delete object p-xmlh:buffer-field("table-handle_"):buffer-value.
     2282             p-xmlh:buffer-field("table-handle_"):buffer-value = ?.
     2283           end.
     2284           p-xmlh:buffer-delete().
     2285         end.
     2286         else do:
     2287           leave.
     2288         end.
     2289       end.
     2290       if p-xmlh:dynamic = yes
     2291       and valid-handle(p-xmlh)
     2292       then do:
     2293         delete object p-xmlh:table-handle.
     2294         p-xmlh = ?.
     2295       end.
     2296       v-dsh = ?.
     2297     end.
     2298   end procedure.
     2299   procedure all-gates-clear :
     2300   define parameter buffer buf_temp-xml-tables for temp-xml-tables.
     2301   do
     2302   on error undo, return error
     2303   :
     2304     for each buf_temp-xml-tables
     2305     break
     2306     by buf_temp-xml-tables.uniq-gate-rec
     2307     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2308     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     2309     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     2310     :
     2311         if first-of(buf_temp-xml-tables.uniq-gate-rec) then do:
     2312           delete object buf_temp-xml-tables.gate-handle_.
     2313           buf_temp-xml-tables.gate-handle_ = ?.
     2314         end.
     2315         if valid-handle(buf_temp-xml-tables.table-handle_)
     2316         and buf_temp-xml-tables.table-handle_:dynamic = no
     2317         then do:
     2318           delete object buf_temp-xml-tables.table-handle_.
     2319           buf_temp-xml-tables.table-handle_ = ?.
     2320         end.
     2321         delete buf_temp-xml-tables.
     2322     end.
     2323   end.
     2324   end procedure.
     2325   procedure fix-schemalocation :
     2326   define input-output  parameter p-longchar as longchar no-undo .
     2327   DEFINE VARIABLE hdoc AS HANDLE.
     2328   DEFINE VARIABLE hroot AS HANDLE.
     2329   DEFINE VARIABLE hnode-child AS HANDLE.
     2330   DEFINE VARIABLE hnode-attr AS HANDLE.
     2331   define variable v-jj as integer   no-undo .
     2332   define variable ok as logical   no-undo .
     2333   define variable v-path1                    as character                no-undo .
     2334   DEFINE VARIABLE v-full-path1               as character                no-undo .
     2335   DEFINE VARIABLE v-file-name1               as character                no-undo .
     2336   DEFINE VARIABLE v-file-name-no-ext1        as character                no-undo .
     2337   DEFINE VARIABLE v-file-name-ext1           as character                no-undo .
     2338   define variable v-schema-location          as character                no-undo .
     2339   do
     2340   on error undo, return error return-value
     2341   :
     2342     CREATE X-DOCUMENT hdoc.
     2343     CREATE X-noderef hroot.
     2344     CREATE X-noderef hnode-child.
     2345     CREATE X-noderef hnode-attr.
     2346     hdoc:load("longchar", p-longchar, no) no-error.
     2347     iF ERROR-STATUS:GET-MESSAGE(1) <> '' THEN message ERROR-STATUS:GET-MESSAGE(1) view-as alert-box .
     2348     hdoc:get-document-element(hroot).
     2349     _repeat:
     2350     REPEAT v-jj = 1 TO hroot:NUM-CHILDREN:
     2351       ok = hroot:GET-CHILD(hNode-Child, v-jj).
     2352       if not ok then next.
     2353       if hNode-Child:local-name = "include"
     2354       then do:
     2355         ok = hNode-Child:GET-ATTRIBUTE-NODE( hnode-attr, "schemaLocation" ).
     2356           v-schema-location = hnode-attr:node-value.
     2357           run gbl/filename.p (
     2358                           input "exe/" + hnode-attr:node-value
     2359                         ,output v-full-path1
     2360                         ,output v-path1
     2361                         ,output v-file-name1
     2362                         ,output v-file-name-no-ext1
     2363                         ,output v-file-name-ext1
     2364                         ) no-error .
     2365           if error-status :error then do:
     2366             delete object hnode-attr.
     2367             delete object hnode-child.
     2368             delete object hroot.
     2369             delete object hdoc.
     2370             undo, return error substitute("Не удалось определить расположение схемы &1", v-schema-location).
     2371           end.
     2372         ok = hNode-Child:sET-ATTRIBUTE(  "schemaLocation", v-full-path1 ).
     2373         leave  _repeat.
     2374       end.
     2375     END.
     2376     hdoc:save("longchar", p-longchar).
     2377     delete object hnode-attr.
     2378     delete object hnode-child.
     2379     delete object hroot.
     2380     delete object hdoc.
     2381   end.
     2382   end procedure.
     2383   procedure gate-clb_fill-xml-tables :
     2384   define input parameter p-dsh as handle no-undo .
     2385   define input-output parameter p-xmlh as handle no-undo .
     2386   define variable v-ii as integer no-undo .
     2387     do
     2388     on error undo, return error
     2389     :
     2390       do v-ii = 1 to p-dsh:num-buffers:
     2391         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     2392         if not p-xmlh:available then do:
     2393           p-xmlh:buffer-create().
     2394           assign
     2395           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     2396           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     2397           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     2398           p-xmlh::gate-handle_ = p-dsh
     2399           p-xmlh::uniq-gate-rec = entry(2, p-dsh:private-data, chr(4))
     2400           p-xmlh::gate-name = p-dsh:name
     2401           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     2402           .
     2403           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     2404             assign
     2405             p-xmlh::order = -3.
     2406           end.
     2407           p-xmlh:buffer-release().
     2408         end.
     2409       end.
     2410     end.
     2411   end procedure.
     2412   procedure all-gates-empty :
     2413   define buffer buf_temp-xml-tables for temp-xml-tables.
     2414   do
     2415   on error undo, return error
     2416   :
     2417     for each buf_temp-xml-tables
     2418     break
     2419     by buf_temp-xml-tables.uniq-gate-rec
     2420     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2421     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     2422     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     2423     :
     2424       if valid-handle(buf_temp-xml-tables.tbl-handle_) then do:
     2425         buf_temp-xml-tables.tbl-handle_:empty-temp-table().
     2426       end.
     2427     end.
     2428   end.
     2429   end procedure.
     2430   define variable v-current-d-card as character no-undo .
     2431   define variable v-current-host-code as integer no-undo .
     2432   define variable v-current-obj-type as character no-undo .
     2433   define variable v-current-obj-code as integer no-undo .
     2434   define variable v-current-doc-code as character no-undo .
     2435   define variable v-current-lock as integer no-undo .
     2436   define variable v-current-wait as integer no-undo .
     2437   define variable v-save as integer no-undo .
     2438   define variable v-current-db-num as integer no-undo .
     2439   define variable v-current-date as date no-undo .
     2440   define variable v-emitent-host-code as integer no-undo .
     2441   define variable v-type as character no-undo .
     2442   define variable v-sign as integer no-undo .
     2443   define variable file-name as char.
     2444   define variable num-rec as integer no-undo .
     2445   define variable num-rec-ok as integer no-undo .
     2446   define variable v-full-path        as character no-undo .
     2447   define variable v-path             as character no-undo .
