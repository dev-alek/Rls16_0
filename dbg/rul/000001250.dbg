     2485   function 00040000_get-error-message returns character :
     2486   define variable v-ii as integer no-undo .
     2487   define variable v-mess as character no-undo .
     2488   DO v-ii = 1 TO ERROR-STATUS:NUM-MESSAGES:
     2489       v-mess = substitute("&1&2ош &3"
     2490                           ,v-mess
     2491                           ,chr(10)
     2492                           ,ERROR-STATUS:GET-MESSAGE(v-ii)).
     2493   END.
     2494   return v-mess.
     2495   end function.
