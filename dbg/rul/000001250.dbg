     3157                   input 1
     3158                 , input log-file-name
     3159                 , input 1
     3160                 , input (v-last-error-message + chr(10) + "Строка: " + String(num-rec))).
     3161   assign v-view-log = yes .
     3162        undo _stroka, retry _stroka .
     3163       end.
     3164     end.
     3165      Card1:issue-code = p-issue-code .
     3166      Card1:issue-date = p-issue-date .
     3167      Card1:valid-date = p-valid-date .
     3168      Card1:d-pcnt = d-pcnt1 .
