      475   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      476   procedure gen-b-code :
      477     define input  parameter type-code like ub.code-range.range-type no-undo .
      478     define output parameter p-b-code  like ub.bar-code.b-code       no-undo .
      479     do
      480     on error  undo, return error substitute( "&1 (gen-b-code). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      481     on stop   undo, return error substitute( "&1 (gen-b-code). stop", vss-workfile )
      482     on endkey undo, return error substitute( "&1 (gen-b-code). endkey", vss-workfile )
      483     :
      484       define buffer buf_thbj-attr     for ub.thbj-attr .
      485       define buffer buf_sys-ctrl   for ub.sys-ctrl .
      486       define buffer buf_code-range for ub.code-range .
      487       define variable l-code         as   integer              no-undo .
      488       define variable v-db-num       like ub.db.db-num         no-undo .
      489       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
      490       if type-code = 'sslc':U
      491       or type-code = 'ssgb':U
      492       then do:
      493         message
      494           "Нельзя генерировать локальный или глобальный взвешиваемый код." skip
      495           "Обратитесь к администратору системы."
      496           view-as alert-box error .
      497         undo, return error (if type-code = 'sslc':U then "loc-ss-code":U else "gbl-ss-code" ) .
      498       end.
      499       run trg/getpcode.p ( input  type-code
      500                      ,output cfg-param-code
      501                     ).
      502       run get-next-seq( input  type-code,
      503                         output l-code
      504                       ).
      505       find first buf_sys-ctrl no-lock.
      506       if type-code = 'sclc':U
      507       or type-code = 'pglc':U
      508       then do:
      509         assign
      510           v-db-num = 0
      511         .
      512       end.
      513       else do:
      514         assign
      515           v-db-num = buf_sys-ctrl.db-num
      516         .
      517       end.
      518       find first buf_code-range no-lock
      519         where buf_code-range.db-num     = v-db-num
      520           and buf_code-range.range-type = type-code
      521           and buf_code-range.stts       = "a"
      522         use-index stts
      523         no-error .
      524       if available buf_code-range
      525          and l-code <= buf_code-range.last-code
      526          and l-code >= buf_code-range.first-code then do:
      527         assign
      528           p-b-code = l-code
      529         .
      530       end.
      531       else do:
      532         if available buf_code-range
      533            and l-code < buf_code-range.last-code then do:
      534           message
      535             substitute( "Последовательность для создания кодов с типом &1 имеет неверное значение.", type-code ) skip
      536             "Обратитесь к администратору системы."
      537             view-as alert-box error .
      538           undo, return error "sequence":U .
      539         end.
      540         do transaction
      541         on error undo, return error
      542         :
      543           find first buf_thbj-attr exclusive-lock
      544             where buf_thbj-attr.upper-prop-code = 'code-range':U
      545               and buf_thbj-attr.prop-code = cfg-param-code
      546               and buf_thbj-attr.obj-type   = 'БД':U
      547               and buf_thbj-attr.obj-code   = v-db-num
      548             no-error .
      549           if not available buf_thbj-attr then do:
      550             find first buf_thbj-attr exclusive-lock
      551               where buf_thbj-attr.upper-prop-code = 'code-range':U
      552                 and buf_thbj-attr.prop-code = cfg-param-code
      553                 and buf_thbj-attr.obj-type   = ''
      554                 and buf_thbj-attr.obj-code   = 0
      555               no-error .
      556             if not available buf_thbj-attr then do:
      557               if not locked buf_thbj-attr then do:
      558                 message
      559                   substitute( "Отсутствует параметр 'длина диапазона кодов' (&1) для БД &2.", cfg-param-code, buf_sys-ctrl.db-num ) skip
      560                   "Обратитесь к администратору системы."
      561                   view-as alert-box error .
      562               end.
      563               undo, return error "config":U .
      564             end.
      565           end.
      566           run get-next-seq( input type-code,
      567                             output l-code
      568                           ).
      569           find first buf_code-range
      570             where buf_code-range.db-num     = v-db-num
      571               and buf_code-range.range-type = type-code
      572               and buf_code-range.stts       = "a"
      573             use-index stts
      574             no-error .
      575           if available buf_code-range
      576           and l-code <= buf_code-range.last-code
      577           and l-code >= buf_code-range.first-code
      578           then do:
      579             assign
      580               p-b-code = l-code
      581             .
      582           end.
      583           else do:
      584             if available buf_code-range then do:
      585               assign
      586                 buf_code-range.stts = "u"
      587               .
      588             end.
      589             find first buf_code-range
      590               where buf_code-range.db-num     = v-db-num
      591                 and buf_code-range.range-type = type-code
      592                 and buf_code-range.stts       = "f"
      593               use-index stts
      594               no-error .
      595             if not available buf_code-range then do:
      596               message
      597                 substitute( "Отсутствует свободный диапазон для кодов с типом &1.", type-code ) skip
      598                 "Обратитесь к администратору системы"
      599                 view-as alert-box error .
      600               undo, return error "code-range":U .
      601             end.
      602             assign
      603               buf_code-range.stts           = "a"
      604             .
      605             if buf_code-range.first-code = 1 then do:
      606               run set-seq-cr( input type-code,
      607                               input buf_code-range.first-code
      608                             ).
      609               assign
      610                 p-b-code = 1
      611               .
      612             end.
      613             else do:
      614               run set-seq-cr( input type-code,
      615                               input ( buf_code-range.first-code - 1 )
      616                             ).
      617               run get-next-seq( input type-code,
      618                                 output p-b-code
      619                               ).
      620             end.
      621           end.
      622         end.
      623       end.
      624     end.
      625   end procedure.
      626   procedure get-next-seq :
      627     define input  parameter type-code like ub.code-range.range-type no-undo .
      628     define output parameter next-seq  as   integer                  no-undo .
      629     do
      630     on error  undo, return error substitute( "&1 (get-next-seq). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      631     on stop   undo, return error substitute( "&1 (get-next-seq). stop", vss-workfile )
      632     on endkey undo, return error substitute( "&1 (get-next-seq). endkey", vss-workfile )
      633     :
      634       case type-code:
      635         when 'bcgb':U then do:
      636           assign
      637             next-seq = next-value(s-bcgb-code, ub)
      638           .
      639         end.
      640         when 'scgb':U then do:
      641           assign
      642             next-seq = next-value(s-scgb-code, ub)
      643           .
      644         end.
      645         when 'sclc':U then do:
      646           assign
      647             next-seq = next-value(s-sclc-code, ub)
      648           .
      649         end.
      650         when 'pglc':U then do:
      651           assign
      652             next-seq = next-value(s-pglc-code, ub)
      653           .
      654         end.
      655         when 'dcgb':U then do:
      656           assign
      657             next-seq = next-value(s-dcgb-code, ub)
      658           .
      659         end.
      660         when 'ctgb':U then do:
      661           assign
      662             next-seq = next-value(s-ctgb-code, ub)
      663           .
      664         end.
      665         when 'drgb':U then do:
      666           assign
      667             next-seq = next-value(s-drgb-code, ub)
      668           .
      669         end.
      670         when 'fmgb':U then do:
      671           assign
      672             next-seq = next-value(s-fmgb-code, ub)
      673           .
      674         end.
      675         when 'pngb':U then do:
      676           assign
      677             next-seq = next-value(s-pngb-code, ub)
      678           .
      679         end.
      680         when 'cagb':U then do:
      681           assign
      682             next-seq = next-value(s-cagb-code, ub)
      683           .
      684         end.
      685         when 'fdgb':U then do:
      686           assign
      687             next-seq = next-value(s-fin-doc, ub)
      688           .
      689         end.
      690       end case.
      691     end.
      692   end procedure.
      693   procedure set-seq-cr :
      694     define input parameter type-code like ub.code-range.range-type no-undo .
      695     define input parameter set-val   like ub.code-range.first-code no-undo .
      696     do
      697     on error  undo, return error substitute( "&1 (set-seq-cr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      698     on stop   undo, return error substitute( "&1 (set-seq-cr). stop", vss-workfile )
      699     on endkey undo, return error substitute( "&1 (set-seq-cr). endkey", vss-workfile )
      700     :
      701       case type-code:
      702         when 'bcgb':U then do:
      703           assign
      704             current-value(s-bcgb-code, ub) = set-val
      705           .
      706         end.
      707         when 'scgb':U then do:
      708           assign
      709             current-value(s-scgb-code, ub) = set-val
      710           .
      711         end.
      712         when 'sclc':U then do:
      713           assign
      714             current-value(s-sclc-code, ub) = set-val
      715           .
      716         end.
      717         when 'pglc':U then do:
      718           assign
      719             current-value(s-pglc-code, ub) = set-val
      720           .
      721         end.
      722         when 'dcgb':U then do:
      723           assign
      724             current-value(s-dcgb-code, ub) = set-val
      725           .
      726         end.
      727         when 'ctgb':U then do:
      728           assign
      729             current-value(s-ctgb-code, ub) = set-val
      730           .
      731         end.
      732         when 'drgb':U then do:
      733           assign
      734             current-value(s-drgb-code, ub) = set-val
      735           .
      736         end.
      737         when 'fmgb':U then do:
      738           assign
      739             current-value(s-fmgb-code, ub) = set-val
      740           .
      741         end.
      742         when 'pngb':U then do:
      743           assign
      744             current-value(s-pngb-code, ub) = set-val
      745           .
      746         end.
      747         when 'cagb':U then do:
      748           assign
      749             current-value(s-cagb-code, ub) = set-val
      750           .
      751         end.
      752         when 'fdgb':U then do:
      753           assign
      754             current-value(s-fin-doc, ub) = set-val
      755           .
      756         end.
      757       end case.
      758     end.
      759   end procedure.
      760   procedure new-bcod-gen-code-range :
      761     do
      762     on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      763     on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
      764     on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
      765     :
      766       define input parameter p-db-num  like ub.db.db-num             no-undo .
      767       define input parameter type-code like ub.code-range.range-type no-undo .
      768       define buffer buf_code-range      for ub.code-range .
      769       define buffer last_code-range     for ub.code-range .
      770       define buffer last-1_code-range   for ub.code-range .
      771       define buffer last-2_code-range   for ub.code-range .
      772       define buffer last-3_code-range   for ub.code-range .
      773       define buffer buf_sys-ctrl        for ub.sys-ctrl .
      774       define variable conf-par       as character no-undo .
      775       define variable par-type       as character no-undo .
      776       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
      777       define variable v-cre-cdrg as logical   no-undo .
      778       define variable v-cre-str  as character no-undo .
      779       define variable v-cr1      as integer no-undo .
      780       define variable v-cr2      as integer no-undo .
      781       define variable v-cr3      as integer no-undo .
      782       define variable v-cmax     as integer no-undo .
      783       find first buf_sys-ctrl no-lock .
      784       if buf_sys-ctrl.db-num <> 0 and type-code <> 'cagb':U then do:
      785         undo, return error substitute("&1 &2 &3&4Диапазоны кодов можно создавать только в ГБД&4База данных &5"
      786                                       ,vss-workfile
      787                                       ,vss-revision
      788                                       ,vss-description
      789                                       ,chr(10)
      790                                       , p-db-num
      791                                      ).
      792       end.
      793       run trg/getpcode.p ( input  type-code
      794                      ,output cfg-param-code
      795                     ).
      796       for each buf_code-range
      797         where buf_code-range.db-num     = -1
      798           and buf_code-range.range-type = type-code
      799           and buf_code-range.stts       = "f"
      800       by buf_code-range.first-code
      801       on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      802       on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
      803       on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
      804       :
      805         assign
      806           buf_code-range.db-num = p-db-num
      807         .
      808         return .
      809       end.
      810       assign
      811         v-cre-cdrg = TRUE
      812       .
      813       case type-code:
      814         when 'sclc':U
      815         or when 'scgb':U
      816         or when 'pglc':U
      817         then do:
      818           find last last-1_code-range no-lock
      819             where last-1_code-range.range-type = 'sclc':U
      820             no-error .
      821           if available last-1_code-range then do:
      822             v-cr1 = last-1_code-range.last-code.
      823           end.
      824           find last last-2_code-range no-lock
      825             where last-2_code-range.range-type = 'scgb':U
      826             no-error .
      827           if available last-2_code-range then do:
      828             v-cr2 = last-2_code-range.last-code.
      829             end.
      830           find last last-3_code-range no-lock
      831             where last-3_code-range.range-type = 'pglc':U
      832             no-error .
      833           if available last-3_code-range then do:
      834             v-cr3 = last-3_code-range.last-code.
      835           end.
      836           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
      837           .
      838           if v-cmax = v-cr1  then do:
      839               find last last_code-range no-lock
      840                 where recid( last_code-range ) = recid( last-1_code-range )
      841                 .
      842             end.
      843           if v-cmax = v-cr2  then do:
      844               find last last_code-range no-lock
      845                 where recid( last_code-range ) = recid( last-2_code-range )
      846                 .
      847             end.
      848           if v-cmax = v-cr3  then do:
      849             find last last_code-range no-lock
      850               where recid( last_code-range ) = recid( last-3_code-range )
      851               .
      852           end.
      853           if last_code-range.last-code + 1 > 99999 then do:
      854             assign
      855               v-cre-cdrg = FALSE
      856             .
      857           end.
      858         end.
      859         when 'bcgb':U
      860         or when 'sslc':U
      861         or when 'ssgb':U
      862         then do:
      863           find last last-1_code-range no-lock
      864             where last-1_code-range.range-type = 'sslc':U
      865             no-error .
      866           if available last-1_code-range then do:
      867             v-cr1 = last-1_code-range.last-code.
      868           end.
      869           find last last-2_code-range no-lock
      870             where last-2_code-range.range-type = 'bcgb':U
      871             no-error .
      872           if available last-2_code-range then do:
      873             v-cr2 = last-2_code-range.last-code.
      874             end.
      875           find last last-3_code-range no-lock
      876             where last-3_code-range.range-type = 'ssgb':U
      877             no-error .
      878           if available last-3_code-range then do:
      879             v-cr3 = last-3_code-range.last-code.
      880           end.
      881           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
      882           .
      883           if v-cmax = v-cr1  then do:
      884               find last last_code-range no-lock
      885                 where recid( last_code-range ) = recid( last-1_code-range )
      886                 .
      887             end.
      888           if v-cmax = v-cr2  then do:
      889               find last last_code-range no-lock
      890                 where recid( last_code-range ) = recid( last-2_code-range )
      891                 .
      892             end.
      893           if v-cmax = v-cr3  then do:
      894             find last last_code-range no-lock
      895               where recid( last_code-range ) = recid( last-3_code-range )
      896               .
      897           end.
      898         end.
      899         otherwise do:
      900           find last last_code-range no-lock
      901             where last_code-range.range-type = type-code
      902             no-error .
      903         end.
      904       end case.
      905       if not available last_code-range then do:
      906         undo, return error substitute("&1 &2 &3&4В БД нет ни одного диапазона с типом &5&4Не была проведена инициализация диапазонов!"
      907                                       ,vss-workfile
      908                                       ,vss-revision
      909                                       ,vss-description
      910                                       , chr(10)
      911                                       , type-code
      912                                      ) .
      913       end.
      914       define variable v-mes7 as character no-undo .
      915       define variable v-param-type7 as character no-undo .
      916       define variable v-value-character7 as INTEGER no-undo .
      917       define variable v-value-date7 as date no-undo .
      918       define variable v-value-decimal7 as decimal no-undo .
      919       define variable v-value-integer7 AS integer no-undo .
      920       define variable v-value-logical7 AS LOGICAL no-undo .
      921       define variable v-tth7 as handle no-undo .
      922       run adm/shattri.p (
      923           input "get":U
      924           ,input  'БД':U
      925           ,input  p-db-num
      926           ,input  'code-range':U
      927           ,input  cfg-param-code
      928           ,output v-value-character7
      929           ,output v-value-date7
      930           ,output v-value-decimal7
      931           ,output v-value-integer7
      932           ,output v-value-logical7
      933           ,output v-param-type7
      934           ,INPUT-OUTPUT table-handle v-tth7
      935           ) no-error .
      936       if error-status :error then do:
      937         delete object v-tth7.
      938         v-mes7 = substitute("Ошибка при получении размера диапазона собственных глобальных кодов&2&1&2&3"
      939                            , error-status:get-message(1)
      940                            , chr(10)
      941                            , return-value ).
      942         undo, return error v-mes7.
      943       end.
      944       delete object v-tth7.
      945       if v-cre-cdrg = TRUE then do:
      946         create buf_code-range .
      947         assign
      948           buf_code-range.db-num     = p-db-num
      949           buf_code-range.range-type = type-code
      950           buf_code-range.stts       = "f"
      951           buf_code-range.first-code = last_code-range.last-code + 1
      952           buf_code-range.last-code  = last_code-range.last-code + integer(v-value-integer7)
      953           v-cre-str = "Свободный диапазон успешно создан"
      954         .
      955       end.
      956       else do:
      957         assign
      958           v-cre-str = "Нет возможности создать свободный диапазон." + chr(10)
      959                       + substitute( "Превышен предел диапазонов c типом &1", type-code )
      960         .
      961       end.
      962     end.
      963     return v-cre-str .
      964   end procedure.
      965   procedure gen-new-code-range-if-neces :
      966     define input parameter v-db-num           like ub.db.db-num             no-undo .
      967     define input parameter v-range-type       like ub.code-range.range-type no-undo .
      968     define input parameter v-cur-code         as   integer                  no-undo .
      969     define input parameter v-g#news           as   logical                  no-undo .
      970     define input parameter v-g#db-num         like ub.db.db-num             no-undo .
      971     define input parameter v-g#news-source-db like ub.db.db-num             no-undo .
      972     do
      973     on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      974     on stop   undo, return error substitute( "&1 (gen-new-code-range-if-neces). stop", vss-workfile )
      975     on endkey undo, return error substitute( "&1 (gen-new-code-range-if-neces). endkey", vss-workfile )
      976     :
      977       define variable l-code-range-exist as logical   no-undo init false .
      978       define variable v-db-for-send      as character no-undo .
      979       define buffer buf_code-range  for ub.code-range .
      980       define buffer buf1_code-range for ub.code-range .
      981       define buffer buf_db          for ub.db .
      982       find first buf_code-range
      983         where buf_code-range.range-type = v-range-type
      984           and buf_code-range.last-code >= v-cur-code
      985         use-index last-codei
      986         no-error .
      987       if
      988       (
      989          available buf_code-range
      990          and
      991         (buf_code-range.db-num = v-db-num
      992           and
      993         buf_code-range.first-code <= v-cur-code
      994         )
      995       or
      996         (
      997           v-range-type = 'drgb':U
      998           AND
      999           v-cur-code = 0
     1000         )
     1001      )
     1002      then do:
     1003         assign
     1004           l-code-range-exist = true
     1005         .
     1006         if v-g#news
     1007         and buf_code-range.stts = "f" then do:
     1008           assign
     1009             buf_code-range.stts = "u"
     1010           .
     1011         end.
     1012       end.
     1013       if not l-code-range-exist
     1014          and v-g#news-source-db <> 0
     1015       then do:
     1016         undo, return error substitute("&1 &2 &3&4Отсутствует диапазон кодов для БД &5 Тип диапазона кодов &6 Код &7"
     1017                                       ,vss-workfile
     1018                                       ,vss-revision
     1019                                       ,vss-description
     1020                                       ,chr(10)
     1021                                       ,v-db-num
     1022                                       ,v-range-type
     1023                                       ,v-cur-code
     1024                                      ).
     1025       end.
     1026       if (not l-code-range-exist
     1027           or ( v-cur-code >= int( (buf_code-range.first-code + buf_code-range.last-code) / 2 ) )
     1028          )
     1029       and ( not can-find (first buf1_code-range no-lock
     1030                           where buf1_code-range.db-num = v-db-num
     1031                             and buf1_code-range.range-type = v-range-type
     1032                             and buf1_code-range.stts = "f"
     1033                          )
     1034           )
     1035       then do:
     1036         if v-g#db-num = 0 then do:
     1037           run new-bcod-gen-code-range in this-procedure
     1038             (input v-db-num,
     1039              input v-range-type
     1040             ) no-error .
     1041           if error-status :error then do:
     1042             undo, return error substitute("Ошибка при создании нового свободного диапазона &1 Тип диапазона кодов &2 Код &3:&4&5 &6"
     1043                                           , substitute("&1 &2 &3", vss-workfile, vss-revision, vss-description)
     1044                                           ,v-db-num
     1045                                           ,v-range-type
     1046                                           ,v-cur-code
     1047                                           ,chr(10)
     1048                                           ,error-status:get-message(1)
     1049                                           ,return-value
     1050                                          ).
     1051           end.
     1052         end.
     1053         else do:
     1054           if v-range-type = 'sclc':U
     1055           or v-range-type = 'pglc':U
     1056           then do:
     1057             assign
     1058               v-db-for-send = "":U
     1059             .
     1060             if v-g#db-num = 0 then do:
     1061               for each buf_db no-lock
     1062                 where buf_db.db-num > 0
     1063                   and buf_db.db-num <> v-g#news-source-db
     1064               on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1065               :
     1066                 assign
     1067                   v-db-for-send = v-db-for-send + chr(1) + string( buf_db.db-num )
     1068                 .
     1069               end.
     1070               assign
     1071                 v-db-for-send = right-trim( v-db-for-send, chr(1) )
     1072               .
     1073             end.
     1074             else do:
     1075               if not v-g#news then do:
     1076                 assign
     1077                   v-db-for-send = "0":U
     1078                 .
     1079               end.
     1080             end.
     1081             run nws/cr-route.p ( input 'send-cmd':U
     1082                           ,input ("command":U + chr(1) + "create":U + chr(1) +
     1083                                  "code-range":U + chr(1) +
     1084                                  (if v-range-type = 'sclc':U
     1085                                   then string( current-value(s-sclc-code, ub))
     1086                                   else string( current-value(s-pglc-code, ub))
     1087                                   ) + chr(1) +
     1088                                   v-range-type)
     1089                           ,input ?
     1090                           ,input v-db-for-send
     1091                           ) no-error .
     1092             if error-status :error then do:
     1093               undo, return error return-value.
     1094             end.
     1095           end.
     1096         end.
     1097       end.
     1098     end.
     1099   end procedure.
     1100   procedure cre-loc-sc-code-range :
     1101     define input parameter v-cur-code as integer no-undo .
     1102   define input parameter p-cdrg-type as character no-undo .
     1103     do
     1104     on error  undo, return error substitute( "&1 (cre-loc-sc-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1105     on stop   undo, return error substitute( "&1 (cre-loc-sc-code-range). stop", vss-workfile )
     1106     on endkey undo, return error substitute( "&1 (cre-loc-sc-code-range). endkey", vss-workfile )
     1107     :
     1108       define buffer buf_code-range for ub.code-range .
     1109       find first buf_code-range
     1110            where buf_code-range.range-type = p-cdrg-type
     1111              and buf_code-range.first-code >= v-cur-code
     1112            no-error .
     1113       if not available buf_code-range then do:
     1114         run new-bcod-gen-code-range in this-procedure
     1115           ( input 0,
     1116             input p-cdrg-type
     1117           ) no-error .
     1118         if error-status :error then do:
     1119           undo, return error substitute( "Ошибка при создании нового свободного диапазона локальных весовых или штучных кодов&1"
     1120                                          + "Код &2&1&3 &4"
     1121                                         , chr(10)
     1122                                         , v-cur-code
     1123                                         , error-status:get-message(1)
     1124                                         , return-value
     1125                                        ) .
     1126         end.
     1127       end.
     1128     end.
     1129   end procedure.
     1130   procedure mark-used-if-need :
     1131   define input parameter p-cur-code as integer no-undo .
     1132   define input parameter p-range-type like ub.code-range.range-type no-undo .
     1133   define input parameter p-db-num like ub.code-range.db-num no-undo .
     1134     do
     1135     on error  undo, return error substitute( "&1 (mark-used-if-need). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1136     on stop   undo, return error substitute( "&1 (mark-used-if-need). stop", vss-workfile )
     1137     on endkey undo, return error substitute( "&1 (mark-used-if-need). endkey", vss-workfile )
     1138     :
     1139       DEFINE VARIABLE v-db-num like ub.code-range.db-num no-undo .
     1140       define buffer buf_code-range for ub.code-range .
     1141       assign
     1142       v-db-num = if p-range-type = 'sclc':U
     1143                  then 0
     1144                  else p-db-num
     1145       .
     1146   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1147   define buffer locK-batchprocess8 for ub.batchprocess.
     1148   run gbl/lock-prc.p
     1149       (input 'lscc':U
     1150       ,input 0
     1151       ,input 0
     1152       ,input 0
     1153       ,input ""
     1154       ,input ""
     1155       ,input ""
     1156       ,input (
     1157               ",,,Вкл/выкл лок. вес. кодов"
     1158              )
     1159       ,input true
     1160       ,buffer lock-batchprocess8
     1161       ) no-error .
     1162     if error-status :error then do:
     1163       message
     1164         vss-workfile vss-revision vss-description skip
     1165         "В данный момент идет процесс вкл/выкл лок. вес. кодов" skip
     1166         view-as alert-box error .
     1167       undo, return error .
     1168     end.
     1169       find first buf_code-range
     1170            where buf_code-range.range-type = p-range-type
     1171              and buf_code-range.first-code >= p-cur-code
     1172              and buf_code-range.last-code <= p-cur-code
     1173              and buf_code-range.db-num = v-db-num
     1174            no-error .
     1175       if not available buf_code-range then do:
     1176         message
     1177           vss-workfile vss-revision vss-description skip
     1178           "Ошибка при создании поиске диапазона" skip
     1179           "База данных" p-db-num skip
     1180           "Код" p-cur-code skip
     1181           "Тип" p-range-type
     1182           error-status :get-message(1) skip
     1183           return-value skip
     1184           view-as alert-box error .
     1185         undo, return error .
     1186       end.
     1187       if buf_code-range.stts = "f":U then do:
     1188         assign
     1189         buf_code-range.stts = "u":U
     1190         .
     1191       end.
     1192     end.
     1193   end procedure.
     1194   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1195   define new global shared variable g#lib-nws as handle no-undo .
     1196   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1197   def var vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1198   procedure gen-key-rec :
     1199     define input  parameter p-tbl-name    as character no-undo.
     1200     define input  parameter p-bh_tbl-name as handle    no-undo.
     1201     define output parameter p-key-rec     as character no-undo.
     1202     do
     1203     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1204     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     1205     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     1206     :
     1207       define variable fh               as handle    no-undo .
     1208       define variable v-ok             as logical   no-undo .
     1209       define variable v-inform         as character no-undo .
     1210       define variable v-ind            as integer   no-undo .
     1211       define variable v-idx-field-qnty as integer   no-undo .
     1212       if p-tbl-name = ?
     1213         or p-tbl-name = "":U
     1214       then do:
     1215         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info11 ).
     1216       end.
     1217       if not p-bh_tbl-name:available then do:
     1218         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info11, p-tbl-name ).
     1219       end.
     1220       assign
     1221         p-key-rec = p-tbl-name
     1222         v-inform  = p-bh_tbl-name:index-information(1)
     1223         v-ind     = 2
     1224       .
     1225       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1226       on error undo, return error
     1227       :
     1228         assign
     1229           v-inform = p-bh_tbl-name:index-information( v-ind )
     1230           v-ind    = v-ind + 1
     1231         .
     1232       end.
     1233       if v-inform = ?
     1234         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1235         or entry( 3, v-inform, ",":U ) <> "1":U
     1236       then do:
     1237         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info11, p-tbl-name ).
     1238       end.
     1239       else do:
     1240         assign
     1241           v-idx-field-qnty = num-entries( v-inform ) - 4
     1242         .
     1243         if v-idx-field-qnty < 2 then do:
     1244           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info11, v-inform, p-tbl-name ).
     1245         end.
     1246         do v-ind = 1 to v-idx-field-qnty by 2
     1247         on error undo, return error
     1248         :
     1249           assign
     1250             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     1251             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     1252           .
     1253         end.
     1254       end.
     1255       if p-key-rec = ? then do:
     1256         assign
     1257           p-key-rec = "":U
     1258         .
     1259         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info11, p-tbl-name ).
     1260       end.
     1261     end.
     1262     return.
     1263   end procedure.
     1264   procedure gen-where-keyr-tab :
     1265     define input  parameter i-tableSerach as character no-undo.
     1266     define input  parameter i-tablekey   as character  no-undo.
     1267     define input  parameter p-key-rec    as character  no-undo.
     1268     define input  parameter p-key-handle as handle     no-undo .
     1269     define input  parameter p-db-name    as character  no-undo .
     1270     define input  parameter p-tt-handle  as handle     no-undo .
     1271     define output parameter o-Where      as character  no-undo.
     1272     do
     1273     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1274     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1275     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     1276     :
     1277       define variable v-full-tbl-name  as character no-undo .
     1278       define variable bh_tbl-name      as handle    no-undo .
     1279       define variable fh_key           as handle    no-undo .
     1280       define variable fh_search        as handle    no-undo .
     1281       define variable v-field-num      as integer   no-undo .
     1282       define variable v-count-fld      as integer   no-undo .
     1283       define variable v-inform         as character no-undo .
     1284       define variable v-ind            as integer   no-undo .
     1285       define variable v-idx-field-qnty as integer   no-undo .
     1286       define variable v-field-name     as character no-undo .
     1287       define variable v-field-val      as character no-undo .
     1288       define variable v-word-link      as character no-undo .
     1289       define variable vTable           as character no-undo.
     1290       define variable bh_tbl-key       as handle    no-undo .
     1291       assign
     1292         p-key-rec = trim( p-key-rec )
     1293       .
     1294       if p-key-handle <> ? then do:
     1295         if not valid-handle(p-key-handle)
     1296            or p-key-handle:type <> "buffer"
     1297         then do:
     1298           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info11 ).
     1299         end.
     1300         if num-entries( p-key-rec, chr(3) ) > 1
     1301           or p-key-rec = ?
     1302           or p-key-rec = "":U
     1303         then do:
     1304           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info11, p-key-rec ).
     1305         end.
     1306       end.
     1307       else do:
     1308         if p-key-rec = ?
     1309           or p-key-rec = "":U
     1310         then do:
     1311           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info11 ).
     1312         end.
     1313       end.
     1314       assign
     1315         vTable = entry( 1 , p-key-rec, chr(3) )
     1316       .
     1317       if p-tt-handle <> ?
     1318         and ( not valid-handle(p-tt-handle)
     1319               or p-tt-handle:type <> "buffer"
     1320             )
     1321       then do:
     1322         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info11, vTable, chr(10) ).
     1323       end.
     1324       if p-tt-handle = ? then do:
     1325         assign
     1326           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     1327         .
     1328         create buffer bh_tbl-name for table v-full-tbl-name .
     1329       end.
     1330       else do:
     1331         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1332       end.
     1333       assign
     1334         v-inform = bh_tbl-name:index-information(1)
     1335         v-ind    = 2
     1336       .
     1337       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1338       on error undo, return error
     1339       :
     1340         assign
     1341           v-inform = bh_tbl-name:index-information( v-ind )
     1342           v-ind    = v-ind + 1
     1343         .
     1344       end.
     1345       if v-inform = ?
     1346         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1347         or entry( 3, v-inform, ",":U ) <> "1":U
     1348       then do:
     1349         delete object bh_tbl-name no-error.
     1350         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info11, vTable ).
     1351       end.
     1352       assign
     1353         v-idx-field-qnty = num-entries( v-inform ) - 4
     1354       .
     1355       if v-idx-field-qnty < 2 then do:
     1356         delete object bh_tbl-name no-error.
     1357         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info11, v-inform, vTable ).
     1358       end.
     1359       assign
     1360         o-where     = "where":U
     1361         v-word-link = "":U
     1362         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     1363         v-count-fld = 0
     1364       .
     1365       if i-tablekey ne "" and i-tablekey ne ?
     1366       then do:
     1367         assign
     1368           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     1369         .
     1370         create buffer bh_tbl-key for table v-full-tbl-name .
     1371       end.
     1372       if i-tableSerach ne "" and i-tableSerach ne ?
     1373       then do:
     1374         delete object bh_tbl-name no-error.
     1375         assign
     1376           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     1377         .
     1378         create buffer bh_tbl-name for table v-full-tbl-name .
     1379       end.
     1380       block_where:
     1381       do v-ind = 1 to v-idx-field-qnty by 2
     1382       on error undo, return error
     1383       :
     1384         assign
     1385           v-count-fld = v-count-fld + 1
     1386         .
     1387         if p-key-handle = ?
     1388           and v-count-fld > v-field-num
     1389         then do:
     1390           leave block_where.
     1391         end.
     1392         define variable VfieldKeyTable as handle no-undo.
     1393         assign
     1394           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1395           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     1396         .
     1397         if     bh_tbl-key ne ?
     1398         then do:
     1399            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     1400            if VfieldKeyTable eq ?
     1401            then next block_where.
     1402         end.
     1403         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     1404         then
     1405            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     1406         else
     1407            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     1408         if p-key-handle = ? then do:
     1409           assign
     1410             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     1411           .
     1412         end.
     1413         else do:
     1414           assign
     1415             fh_key = p-key-handle:buffer-field( v-field-name )
     1416           .
     1417           if fh_key = ?
     1418             or not valid-handle( fh_key )
     1419           then do:
     1420             delete object bh_tbl-name.
     1421             if     bh_tbl-key ne ?
     1422             then
     1423                delete object bh_tbl-key.
     1424             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info11, p-key-handle:name, v-field-name ).
     1425           end.
     1426           assign
     1427             v-field-val = fh_key:buffer-value
     1428           .
     1429         end.
     1430         if fh_search:data-type ="character":U then do:
     1431           assign
     1432             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1433             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1434             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1435             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1436             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1437             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1438             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1439             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1440             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1441             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1442             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1443             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1444             v-field-val = substitute( '"&1"', v-field-val )
     1445           .
     1446         end.
     1447         assign
     1448           o-where = substitute( "&1 &2", o-where, v-field-val )
     1449         .
     1450         if v-word-link = "":U then do:
     1451           assign
     1452             v-word-link = "and":U
     1453           .
     1454         end.
     1455       end.
     1456       delete object bh_tbl-name.
     1457       if     bh_tbl-key ne ?
     1458       then
     1459          delete object bh_tbl-key.
     1460       if p-key-handle = ?
     1461         and v-count-fld <> v-field-num
     1462       then do:
     1463         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info11, vTable ).
     1464       end.
     1465     end.
     1466   end procedure.
     1467   procedure gen-hn-keyr-tab :
     1468     define input  parameter i-tableSerach as character no-undo.
     1469     define input  parameter i-tablekey   as character no-undo.
     1470     define input  parameter p-key-rec    as character no-undo.
     1471     define input  parameter p-key-handle as handle    no-undo .
     1472     define input  parameter p-db-name    as character no-undo .
     1473     define input  parameter p-tt-handle  as handle    no-undo .
     1474     define input  parameter p-stts-lock  as integer   no-undo .
     1475     define output parameter o-hn         as handle    no-undo.
     1476     define variable v-full-tbl-name as character no-undo.
     1477     define variable v-where         as character no-undo.
     1478     define variable bh_tbl-name     as handle    no-undo.
     1479     define variable vTable          as character no-undo.
     1480     do
     1481     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1482     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1483     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1484         run gen-where-keyr-tab(i-tableSerach,
     1485                                i-tablekey,
     1486                                p-key-rec,
     1487                                p-key-handle,
     1488                                p-db-name,
     1489                                p-tt-handle,
     1490                                output v-where).
     1491         if i-tableSerach ne "" and i-tableSerach ne ?
     1492         then do:
     1493            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1494            create buffer bh_tbl-name for table v-full-tbl-name .
     1495         end.
     1496         else do:
     1497            if p-tt-handle = ? then do:
     1498               assign
     1499                  vTable = entry( 1 , p-key-rec, chr(3) )
     1500               .
     1501               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1502               create buffer bh_tbl-name for table v-full-tbl-name .
     1503            end.
     1504            else do:
     1505               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1506            end.
     1507         end.
     1508         if p-tt-handle = ? then do:
     1509            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1510         end.
     1511         else do:
     1512            bh_tbl-name:find-first( v-where ) no-error .
     1513         end.
     1514         o-hn = bh_tbl-name.
     1515      end.
     1516   end procedure.
     1517   procedure gen-hn-keyr :
     1518     define input  parameter p-key-rec    as character no-undo.
     1519     define input  parameter p-key-handle as handle    no-undo .
     1520     define input  parameter p-db-name    as character no-undo .
     1521     define input  parameter p-tt-handle  as handle    no-undo .
     1522     define input  parameter p-stts-lock  as integer   no-undo .
     1523     define output parameter o-hn         as handle    no-undo.
     1524     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1525   end.
     1526   procedure gen-row-keyr :
     1527     define input  parameter p-key-rec    as character no-undo.
     1528     define input  parameter p-key-handle as handle    no-undo .
     1529     define input  parameter p-db-name    as character no-undo .
     1530     define input  parameter p-tt-handle  as handle    no-undo .
     1531     define input  parameter p-stts-lock  as integer   no-undo .
     1532     define output parameter p-tbl-row    as rowid     no-undo.
     1533     define output parameter p-tbl-name   as character no-undo.
     1534     define variable vHn as handle no-undo.
     1535       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1536       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1537       p-tbl-name =  vHn:table.
     1538       delete object vHn no-error.
     1539     if p-tbl-row = ? then do:
     1540       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info11, p-tbl-name, p-key-rec ).
     1541     end.
     1542     else do:
     1543       return.
     1544     end.
     1545   end procedure.
     1546   procedure gen-key-fv :
     1547     define input  parameter p-key-rec    as character no-undo .
     1548     define output parameter p-field-list as character no-undo .
     1549     define output parameter p-value-list as character no-undo.
     1550     do
     1551     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1552     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1553     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1554     :
     1555       define variable v-full-tbl-name  as character no-undo .
     1556       define variable bh_tbl-name      as handle    no-undo .
     1557       define variable v-tbl-name       as character no-undo .
     1558       define variable v-field-num      as integer   no-undo .
     1559       define variable v-count-fld      as integer   no-undo .
     1560       define variable v-inform         as character no-undo .
     1561       define variable v-ind            as integer   no-undo .
     1562       define variable v-idx-field-qnty as integer   no-undo .
     1563       define variable v-delim-key      as character no-undo .
     1564       if p-key-rec = ?
     1565         or p-key-rec = "":U
     1566       then do:
     1567         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info11 ).
     1568       end.
     1569       assign
     1570         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1571         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1572       .
     1573       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1574       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info11 ).
     1575       assign
     1576         v-inform = bh_tbl-name:index-information(1)
     1577         v-ind    = 2
     1578       .
     1579       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1580       on error undo, return error
     1581       :
     1582         assign
     1583           v-inform = bh_tbl-name:index-information( v-ind )
     1584           v-ind    = v-ind + 1
     1585         .
     1586       end.
     1587       if v-inform = ?
     1588         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1589         or entry( 3, v-inform, ",":U ) <> "1":U
     1590       then do:
     1591         delete object bh_tbl-name no-error.
     1592         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info11, v-tbl-name ).
     1593       end.
     1594       assign
     1595         v-idx-field-qnty = num-entries( v-inform ) - 4
     1596       .
     1597       if v-idx-field-qnty < 2 then do:
     1598         delete object bh_tbl-name no-error.
     1599         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info11, v-inform, v-tbl-name ).
     1600       end.
     1601       assign
     1602         p-field-list = "":U
     1603         p-value-list = "":U
     1604         v-delim-key  = "":U
     1605         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1606         v-count-fld  = 0
     1607       .
     1608       block_where:
     1609       do v-ind = 1 to v-idx-field-qnty by 2
     1610       on error undo, return error
     1611       :
     1612         assign
     1613           v-count-fld = v-count-fld + 1
     1614         .
     1615         if v-count-fld > v-field-num then do:
     1616           leave block_where.
     1617         end.
     1618         assign
     1619           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1620           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1621         .
     1622         if v-ind = 1 then do:
     1623           assign
     1624             v-delim-key = chr(3)
     1625           .
     1626         end.
     1627       end.
     1628       delete object bh_tbl-name.
     1629       if v-count-fld <> v-field-num then do:
     1630         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info11, v-tbl-name ).
     1631       end.
     1632     end.
     1633   end procedure.
     1634   procedure gen-key-field :
     1635     define input  parameter p-table      as character no-undo .
     1636     define output parameter p-field-list as character no-undo .
     1637     do
     1638     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1639     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1640     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1641     :
     1642       define variable v-full-tbl-name  as character no-undo .
     1643       define variable bh_tbl-name      as handle    no-undo .
     1644       define variable v-tbl-name       as character no-undo .
     1645       define variable v-field-num      as integer   no-undo .
     1646       define variable v-count-fld      as integer   no-undo .
     1647       define variable v-inform         as character no-undo .
     1648       define variable v-ind            as integer   no-undo .
     1649       define variable v-idx-field-qnty as integer   no-undo .
     1650       define variable v-delim-key      as character no-undo .
     1651       if p-table = ?
     1652         or p-table = "":U
     1653       then do:
     1654         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info11 ).
     1655       end.
     1656       assign
     1657         v-tbl-name      = p-table
     1658         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1659       .
     1660       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1661       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info11 ).
     1662       assign
     1663         v-inform = bh_tbl-name:index-information(1)
     1664         v-ind    = 2
     1665       .
     1666       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1667       on error undo, return error
     1668       :
     1669         assign
     1670           v-inform = bh_tbl-name:index-information( v-ind )
     1671           v-ind    = v-ind + 1
     1672         .
     1673       end.
     1674       if v-inform = ?
     1675         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1676         or entry( 3, v-inform, ",":U ) <> "1":U
     1677       then do:
     1678         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info11, v-tbl-name ).
     1679       end.
     1680       assign
     1681         v-idx-field-qnty = num-entries( v-inform ) - 4
     1682       .
     1683       if v-idx-field-qnty < 2 then do:
     1684         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info11, v-inform, v-tbl-name ).
     1685       end.
     1686       assign
     1687         p-field-list = "":U
     1688         v-delim-key  = "":U
     1689         v-count-fld  = 0
     1690       .
     1691       block_where:
     1692       do v-ind = 1 to v-idx-field-qnty by 2
     1693       on error undo, return error
     1694       :
     1695         assign
     1696           v-count-fld = v-count-fld + 1
     1697         .
     1698         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1699         if v-ind = 1 then do:
     1700           assign
     1701             v-delim-key = chr(3)
     1702           .
     1703         end.
     1704       end.
     1705       delete object bh_tbl-name.
     1706     end.
     1707   end procedure.
     1708   define SHARED temp-table temp-cmd no-undo
     1709   field cmd-code as integer
     1710   field db-list as character
     1711   index pi is unique primary
     1712   db-list
     1713   index icmd
     1714   cmd-code
     1715   .
     1716   define SHARED temp-table temp-smart-route no-undo
     1717   field key-field as character
     1718   field db-num as integer
     1719   index pi is unique primary
     1720   key-field
     1721   db-num
     1722   .
     1723   define SHARED temp-table temp-no-route no-undo
     1724   field rec-ord as integer
     1725   field db-num as integer
     1726   index pi is unique primary
     1727   db-num
     1728   rec-ord
     1729   index iro
     1730   rec-ord
     1731   .
     1732   define SHARED temp-table temp-smart-link no-undo
     1733   field uniq-key-rec as character
     1734   field key-field as character
     1735   field rec-ord as integer
     1736   field is-smart as logical
     1737   index pi is unique primary
     1738   key-field
     1739   uniq-key-rec
     1740   rec-ord
     1741   index iu
     1742   uniq-key-rec
     1743   index iro
     1744   rec-ord
     1745   .
     1746   define SHARED temp-table temp-nws-outline no-undo
     1747   like ub.nws-outline.
     1748   procedure create-smart-route :
     1749   define input parameter p-key-field as character no-undo .
     1750   define input parameter p-db-num as integer no-undo .
     1751   define buffer buf_temp-smart-route for temp-smart-route.
     1752     do
     1753     on error undo, return error
     1754     :
     1755       find first buf_temp-smart-route where
     1756                 buf_temp-smart-route.key-field = p-key-field
     1757             and buf_temp-smart-route.db-num = p-db-num no-error.
     1758       if not available buf_temp-smart-route then do:
     1759         create buf_temp-smart-route.
     1760         assign
     1761         buf_temp-smart-route.key-field = p-key-field
     1762         buf_temp-smart-route.db-num = p-db-num
     1763         .
     1764       end.
     1765     end.
     1766   end procedure.
     1767   procedure create-smart-route-link :
     1768   define input parameter p-tbl-name as character no-undo .
     1769   define input parameter p-bh_tbl-name as handle no-undo .
     1770   define input parameter p-key-field as character no-undo .
     1771   define input parameter p-rec-ord as integer no-undo .
     1772   define input parameter p-is-smart as logical no-undo .
     1773   define variable v-key-rec as character no-undo .
     1774   define buffer buf_temp-smart-link for temp-smart-link.
     1775     do
     1776     on error undo, return error
     1777     :
     1778       run gen-key-rec in this-procedure ( input p-tbl-name
     1779                                          ,input p-bh_tbl-name
     1780                                          ,output v-key-rec     ).
     1781      find first buf_temp-smart-link where
     1782                 buf_temp-smart-link.uniq-key-rec = v-key-rec
     1783              and buf_temp-smart-link.key-field = p-key-field
     1784              and buf_temp-smart-link.rec-ord = p-rec-ord
     1785              no-error .
     1786      if not available buf_temp-smart-link then do:
     1787        create buf_temp-smart-link.
     1788        assign
     1789        buf_temp-smart-link.uniq-key-rec = v-key-rec
     1790        buf_temp-smart-link.key-field = p-key-field
     1791        buf_temp-smart-link.rec-ord = p-rec-ord
     1792        buf_temp-smart-link.is-smart = p-is-smart
     1793        .
     1794      end.
     1795     end.
     1796   end procedure.
     1797   procedure create-nws-outline :
     1798   define input parameter p-cmd-proc-handle as handle no-undo .
     1799   define input parameter p-cmd-code as integer no-undo .
     1800   define input parameter p-outline-type as character no-undo .
     1801   define input parameter p-charkey_one as character no-undo .
     1802   define input parameter p-charkey_two as character no-undo .
     1803   define input parameter p-charkey_three as character no-undo .
     1804   define input parameter p-key#_one as integer no-undo .
     1805   define input parameter p-key#_two as integer no-undo .
     1806   define input parameter p-key#_three as integer no-undo .
     1807   define variable v-no-id as integer no-undo .
     1808   define variable v-rec-ord as integer no-undo .
     1809     do
     1810     on error undo, return error return-value
     1811     :
     1812       find last temp-nws-outline use-index pi no-error .
     1813       v-no-id = (if available temp-nws-outline
     1814                  then (temp-nws-outline.no-id  + 1)
     1815                  else 1).
     1816       create temp-nws-outline.
     1817       assign
     1818       temp-nws-outline.charkeY_one = p-charkey_one
     1819       temp-nws-outline.charkeY_two = p-charkey_two
     1820       temp-nws-outline.charkeY_three = p-charkey_three
     1821       temp-nws-outline.key#_one = p-key#_one
     1822       temp-nws-outline.key#_two = p-key#_two
     1823       temp-nws-outline.key#_three = p-key#_three
     1824       temp-nws-outline.no-id = v-no-id
     1825       temp-nws-outline.outline-type = p-outline-type
     1826       .
     1827                                   run add-dump in p-cmd-proc-handle                                                                           (input p-cmd-code                                                                                         ,input 'nws-outline':U                                                                                          ,input '+update'                                                                                         ,input (buffer temp-nws-outline:handle)                                                                                    ,input ''                                                                                         ,output v-rec-ord                                                                                         ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                     delete procedure p-cmd-proc-handle .                                                                        undo , return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'nws-outline':U                                                                                                ,p-cmd-code                                                                                               ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
     1828       run  create-smart-route in this-procedure (
     1829                                                   input ('nws-outline':U + chr(4) + string(temp-nws-outline.no-id))
     1830                                                  ,input -1).
     1831       run create-smart-route-link in this-procedure (
     1832                                                      input 'nws-outline':U
     1833                                                     ,input (buffer temp-nws-outline:handle)
     1834                                                     ,input ('nws-outline':U + chr(4) + string(temp-nws-outline.no-id))
     1835                                                     ,input v-rec-ord
     1836                                                     ,input no
     1837                                                     ).
     1838     end.
     1839   end procedure.
     1840   procedure create-no-route :
     1841   define input parameter p-rec-ord as integer no-undo .
     1842   define input parameter p-db-num as integer no-undo .
     1843   define buffer buf_temp-no-route for temp-no-route.
     1844   do
     1845   on error undo, return error
     1846   :
     1847      find first buf_temp-no-route where
     1848                 buf_temp-no-route.rec-ord = p-rec-ord
     1849              and buf_temp-no-route.db-num = p-db-num no-error .
     1850      if not available buf_temp-no-route then do:
     1851        create buf_temp-no-route.
     1852        assign
     1853        buf_temp-no-route.rec-ord = p-rec-ord
     1854        buf_temp-no-route.db-num = p-db-num
     1855        .
     1856      end.
     1857   end.
     1858   end procedure.
     1859   procedure clear-from-rec-ord :
     1860   define input parameter p-rec-ord as integer no-undo .
     1861   define buffer buf_temp-no-route for temp-no-route.
     1862   define buffer buf_temp-smart-link for temp-smart-link.
     1863   do
     1864   on error undo, return error
     1865   :
     1866   for each buf_temp-no-route where
     1867           buf_temp-no-route.rec-ord > p-rec-ord:
     1868     delete buf_temp-no-route.
     1869   end.
     1870   for each buf_temp-smart-link where
     1871           buf_temp-smart-link.rec-ord > p-rec-ord:
     1872      delete buf_temp-smart-link.
     1873   end.
     1874   end.
     1875   end procedure.
