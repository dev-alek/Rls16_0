     2960   procedure get-db-list-for-d-card2 :
     2961   define input parameter p-d-card as character no-undo .
     2962   define variable v-current-db-processed as logical no-undo .
     2963   define buffer buf_clients  for ub.clients.
     2964   define buffer buf_dis-obj for ub.dis-obj.
     2965   define buffer buf_temp-smart-route for temp-smart-route.
     2966     do
     2967     on error undo, return error return-value
     2968     :
     2969       for each buf_dis-obj no-lock where
     2970               buf_dis-obj.d-card = p-d-card,
     2971          first buf_clients no-lock where
     2972               buf_clients.obj-type = buf_dis-obj.obj-type
     2973           and buf_clients.obj-code = buf_dis-obj.obj-code
     2974       break by
     2975       buf_clients.db-num:
     2976         if first-of(buf_Clients.db-num) then do:
     2977           find first buf_temp-smart-route no-lock where
     2978                 buf_temp-smart-route.key-field = p-d-card
     2979             and buf_temp-smart-route.db-num = buf_clients.db-num
     2980                 no-error.
     2981           if available buf_temp-smart-route then return.
     2982           create buf_temp-smart-route.
     2983           assign
     2984           buf_temp-smart-route.key-field = p-d-card
     2985           buf_temp-smart-route.db-num = buf_clients.db-num
     2986           .
     2987           if buf_clients.db-num = g#db-num then do:
     2988             v-current-db-processed = yes.
     2989           end.
     2990         end.
     2991       end.
     2992       if not v-current-db-processed then do:
     2993         find first buf_temp-smart-route no-lock where
     2994               buf_temp-smart-route.key-field = p-d-card
     2995           and buf_temp-smart-route.db-num = g#db-num  no-error.
     2996         if not available buf_temp-smart-route then do:
     2997           create buf_temp-smart-route.
     2998           assign
     2999           buf_temp-smart-route.key-field = p-d-card
     3000           buf_temp-smart-route.db-num = g#db-num
     3001           .
     3002         end.
     3003       end.
     3004     end.
     3005   end procedure.
     3006   on delete of this-procedure do:
