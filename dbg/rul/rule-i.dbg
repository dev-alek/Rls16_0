     1044     END CASE.
     1045   END.
     1046   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1047   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1048   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1049   on help of frame Dialog-Frame
     1050   do:
     1051     run gbl/app_help.p
     1052       (input this-procedure :file-name
     1053       ,input ''
     1054       ,input ?
     1055       ) no-error.
     1056     if error-status :error then do:
     1057       message
     1058         "Ошибка при вызове помощи"
     1059         error-status :get-message(1)
     1060         view-as alert-box .
     1061     end.
     1062   end.
     1063   run minbtn-set in this-procedure .
     1064   on choose of b-help in frame Dialog-Frame
     1065   do:
     1066     apply "help":u to frame Dialog-Frame .
     1067   end.
     1068   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1069   procedure minbtn-set :
     1070       do
     1071           on error undo, return error return-value
     1072           :
     1073           define variable ii              as integer       no-undo .
     1074           define variable fh              as widget-handle no-undo .
     1075           define variable hh              as widget-handle no-undo .
     1076           define variable v-h             as handle        extent 4 no-undo .
     1077           define variable v-name-button   as character     no-undo .
     1078           define variable v-help-old-x    as decimal       no-undo .
     1079           define variable v-help-old-y    as decimal       no-undo .
     1080           define variable v-help-old-size as decimal       no-undo .
     1081           define variable v-frame-width   as decimal       no-undo .
     1082           define variable jj              as integer       no-undo .
     1083           do
     1084               on error undo, return error
     1085               :
     1086               assign
     1087                   v-frame-width = frame Dialog-Frame:width - 0.3
     1088                   fh            = frame Dialog-Frame:first-child
     1089                   hh            = fh:first-child
     1090                   ii            = 1
     1091                   .
     1092               do while valid-handle(hh):
     1093                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1094                   do:
     1095                       case lc(hh:name) :
     1096                           when "b-help" then
     1097                               do:
     1098                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1099                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1100                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1101                                   hh:TOOLTIP = "Помощь" .
     1102                                   v-help-old-x = hh:column .
     1103                                   v-help-old-y = hh:row    .
     1104                                   v-help-old-size = hh:width .
     1105                                   hh:width-chars = 2.5 .
     1106                               end.
     1107                           when "b-print" then
     1108                               do:
     1109                                   hh:load-image("cmp/b-print.bmp":u) .
     1110                                   hh:TOOLTIP = "Печать" .
     1111                                   v-h[ii] = hh:handle .
     1112                                   ii = ii + 1 .
     1113                                   hh:width-chars = 3 .
     1114                               end.
     1115                           when "b-history" or
     1116                           when "b-hist" then
     1117                               do:
     1118                                   hh:load-image("cmp/b-hist.bmp":u) .
     1119                                   hh:TOOLTIP = "История" .
     1120                                   v-h[ii] = hh:handle .
     1121                                   ii = ii + 1 .
     1122                                   hh:width-chars = 3 .
     1123                               end.
     1124                           when "b-sch" then
     1125                               do:
     1126                                   hh:load-image("cmp/b-sch.bmp":u) .
     1127                                   hh:TOOLTIP = "Установка Фильтра" .
     1128                                   v-h[ii] = hh:handle .
     1129                                   ii = ii + 1 .
     1130                                   hh:width-chars = 3 .
     1131                               end.
     1132                           when "b-hist-user" then
     1133                               do:
     1134                                   hh:load-image("cmp/b-hist.bmp":u) .
     1135                                   hh:TOOLTIP = "История пользователя" .
     1136                                   ii = ii + 1 .
     1137                               end.
     1138                       end case.
     1139                   end.
     1140                   hh = hh:next-sibling.
     1141               end.
     1142               b-help:column = v-frame-width - b-help:width-chars.
     1143               jj = 0.
     1144               repeat ii = 4 to 1 by -1 :
     1145                   if valid-handle (v-h[ii] ) then
     1146                   do:
     1147                       jj  = jj + 1 .
     1148                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1149                       v-h[ii]:row    = v-help-old-y .
     1150                   end.
     1151               end.
     1152           end.
     1153       end.
     1154   end procedure.
     1155   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1156   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1157   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1158   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1159   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1160   define variable v-diasize-current-frame-height as decimal   no-undo .
     1161   define variable v-diasize-change-size          as logical   no-undo .
     1162   define variable v-diasize-resize-button        as handle    no-undo .
     1163   define variable v-diasize-wndmax               as logical   no-undo .
     1164   define variable v-diasize-wndstore             as logical   no-undo .
     1165   define variable v-diasize-proc-name            as character no-undo .
     1166   define variable v-diasize-browse-handle        as handle    no-undo .
     1167   define variable v-diasize-browse-number        as integer   no-undo .
     1168   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1169   define temp-table temp-diasize-handle no-undo
     1170     field handle-value  as handle
     1171     field save-position as decimal
     1172     index xpk is primary unique handle-value
     1173     .
     1174   define temp-table temp-browse-handle no-undo
     1175     field browse-type   as character
     1176     field browse-number as integer
     1177     field browse-handle as handle
     1178     field original-size as decimal
     1179     index xpk is primary unique browse-type browse-number
     1180     index xie browse-type browse-handle
     1181   .
     1182   procedure diasize_change-height :
     1183     define input  parameter p-change-value  as decimal   no-undo .
     1184     define input  parameter p-move-resize   as logical   no-undo .
     1185     define variable v-field-group-handle    as handle    no-undo .
     1186     define variable v-object-handle         as handle    no-undo .
     1187     define variable v-frame-height          as decimal   no-undo .
     1188     define variable v-frame-virtual-height  as decimal   no-undo .
     1189     define variable v-browse-height         as decimal   no-undo .
     1190     define variable v-window-height         as decimal   no-undo .
     1191     define variable v-window-virtual-height as decimal   no-undo .
     1192     define variable v-change-sign           as integer   no-undo .
     1193     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1194     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1195     if p-change-value > 0
     1196     then do:
     1197       if frame Dialog-Frame :height + p-change-value
     1198           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1199       then do:
     1200         assign
     1201           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1202                           - (frame Dialog-Frame :height-chars)
     1203         .
     1204         if p-change-value <= 0
     1205         then do:
     1206           run diasize_position-resize-button in this-procedure .
     1207           return .
     1208         end.
     1209       end.
     1210     end.
     1211     if p-change-value < 0
     1212     then do:
     1213       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1214       then do:
     1215         assign
     1216           p-change-value = v-diasize-orig-frame-height
     1217                          - (frame Dialog-Frame :height-chars)
     1218         .
     1219         if p-change-value >= 0
     1220         then do:
     1221           run diasize_position-resize-button in this-procedure .
     1222           return .
     1223         end.
     1224       end.
     1225     end.
     1226     if p-change-value >= 0
     1227     then do:
     1228       assign
     1229         v-change-sign = 1
     1230       .
     1231     end.
     1232     else do:
     1233       assign
     1234         v-change-sign = -1
     1235       .
     1236     end.
     1237     assign
     1238       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1239     .
     1240     if p-change-value = 0
     1241     then do:
     1242       run diasize_position-resize-button in this-procedure .
     1243       return .
     1244     end.
     1245     move_block:
     1246     do
     1247     on error undo move_block, retry move_block
     1248     :
     1249       if retry
     1250       then do:
     1251         do
     1252         on error undo move_block, leave move_block
     1253         :
     1254           if p-change-value > 0
     1255           then do:
     1256             for each buf_temp-diasize-handle
     1257             on error undo, next
     1258             :
     1259               assign
     1260                 v-object-handle = buf_temp-diasize-handle.handle-value
     1261               .
     1262               if v-object-handle <> v-diasize-resize-button
     1263               then do:
     1264                 assign
     1265                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1266                 .
     1267               end.
     1268             end.
     1269             assign
     1270               v-diasize-browse-handle :height = v-browse-height
     1271             .
     1272             for each buf_temp-browse-handle
     1273               where buf_temp-browse-handle.browse-type = 'height':u
     1274             on error undo, next
     1275             :
     1276               assign
     1277                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1278               .
     1279             end.
     1280             assign
     1281               frame Dialog-Frame :height = v-frame-height
     1282             .
     1283             if frame Dialog-Frame :scrollable = true
     1284             then do:
     1285               assign
     1286                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1287               .
     1288             end.
     1289             run diasize_position-resize-button in this-procedure .
     1290           end.
     1291           else do:
     1292             if frame Dialog-Frame :scrollable = true
     1293             then do:
     1294               assign
     1295                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1296               .
     1297             end.
     1298             assign
     1299               frame Dialog-Frame :height = v-frame-height
     1300             .
     1301             assign
     1302               v-diasize-browse-handle :height = v-browse-height
     1303             .
     1304             for each buf_temp-browse-handle
     1305               where buf_temp-browse-handle.browse-type = 'height':u
     1306             on error undo, next
     1307             :
     1308               assign
     1309                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1310               .
     1311             end.
     1312             for each buf_temp-diasize-handle
     1313             on error undo, next
     1314             :
     1315               assign
     1316                 v-object-handle = buf_temp-diasize-handle.handle-value
     1317               .
     1318               if v-object-handle <> v-diasize-resize-button
     1319               then do:
     1320                 assign
     1321                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1322                 .
     1323               end.
     1324             end.
     1325             run diasize_position-resize-button in this-procedure .
     1326           end.
     1327           assign
     1328             v-diasize-change-size = false
     1329           .
     1330           leave move_block .
     1331         end.
     1332       end.
     1333       assign
     1334         v-diasize-need-full-display = true
     1335       .
     1336       if v-diasize-change-size = false
     1337       then do:
     1338         assign
     1339           v-diasize-change-size = true
     1340         .
     1341       end.
     1342       else do:
     1343         return .
     1344       end.
     1345       assign
     1346         v-frame-height = frame Dialog-Frame :height
     1347         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1348         v-browse-height = v-diasize-browse-handle :height
     1349       .
     1350       for each buf_temp-browse-handle
     1351         where buf_temp-browse-handle.browse-type = 'height':u
     1352       :
     1353         assign
     1354           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1355         .
     1356       end.
     1357       for each buf_temp-diasize-handle
     1358       :
     1359         delete buf_temp-diasize-handle .
     1360       end.
     1361       assign
     1362         v-field-group-handle = frame Dialog-Frame :first-child
     1363       .
     1364       do while valid-handle(v-field-group-handle)
     1365       :
     1366         assign
     1367           v-object-handle = v-field-group-handle :first-child
     1368         .
     1369         do while valid-handle(v-object-handle)
     1370         :
     1371           if  v-object-handle <> v-diasize-browse-handle :handle
     1372           and can-query(v-object-handle, "row")
     1373           and can-query(v-object-handle, "height")
     1374           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1375           then do:
     1376             find first buf_temp-browse-handle
     1377               where buf_temp-browse-handle.browse-type   = 'height':u
     1378                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1379               no-error .
     1380             if available buf_temp-browse-handle
     1381             then do:
     1382             end.
     1383             else do:
     1384               create buf_temp-diasize-handle .
     1385               assign
     1386                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1387                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1388               .
     1389             end.
     1390           end.
     1391           assign
     1392             v-object-handle = v-object-handle :next-sibling
     1393           .
     1394         end.
     1395         assign
     1396           v-field-group-handle = v-field-group-handle :next-sibling
     1397         .
     1398       end.
     1399       do with frame Dialog-Frame
     1400       :
     1401         hide v-diasize-resize-button .
     1402         assign
     1403           v-diasize-resize-button :row    = 1
     1404           v-diasize-resize-button :column = 1
     1405         .
     1406       end.
     1407       if p-change-value > 0
     1408       then do:
     1409         if frame Dialog-Frame :scrollable = true
     1410         then do:
     1411           assign
     1412             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1413             no-error .
     1414           if error-status :error
     1415           or error-status :get-message(1) <> ""
     1416           then do:
     1417             undo move_block, retry move_block .
     1418           end.
     1419         end.
     1420         assign
     1421           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1422           no-error .
     1423         if error-status :error
     1424         or error-status :get-message(1) <> ""
     1425         then do:
     1426           undo move_block, retry move_block .
     1427         end.
     1428         assign
     1429           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1430           no-error .
     1431         if error-status :error
     1432         or error-status :get-message(1) <> ""
     1433         then do:
     1434           undo move_block, retry move_block .
     1435         end.
     1436         for each buf_temp-browse-handle
     1437           where buf_temp-browse-handle.browse-type = 'height':u
     1438         on error undo move_block, retry move_block
     1439         :
     1440           assign
     1441             buf_temp-browse-handle.browse-handle :height
     1442               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1443             no-error .
     1444           if error-status :error
     1445           or error-status :get-message(1) <> ""
     1446           then do:
     1447             undo move_block, retry move_block .
     1448           end.
     1449         end.
     1450         for each buf_temp-diasize-handle
     1451         on error undo move_block, retry move_block
     1452         :
     1453           assign
     1454             v-object-handle = buf_temp-diasize-handle.handle-value
     1455           .
     1456           if v-object-handle <> v-diasize-resize-button
     1457           then do:
     1458             assign
     1459               v-object-handle :row = v-object-handle :row + p-change-value
     1460               no-error .
     1461             if error-status :error
     1462             or error-status :get-message(1) <> ""
     1463             then do:
     1464               undo move_block, retry move_block .
     1465             end.
     1466           end.
     1467         end.
     1468       end.
     1469       else do:
     1470         for each buf_temp-diasize-handle
     1471         on error undo move_block, retry move_block
     1472         :
     1473           assign
     1474             v-object-handle = buf_temp-diasize-handle.handle-value
     1475           .
     1476           if v-object-handle <> v-diasize-resize-button
     1477           then do:
     1478             assign
     1479               v-object-handle :row = v-object-handle :row + p-change-value
     1480               no-error .
     1481             if error-status :error
     1482             or error-status :get-message(1) <> ""
     1483             then do:
     1484               undo move_block, retry move_block .
     1485             end.
     1486           end.
     1487         end.
     1488         assign
     1489           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1490           no-error .
     1491         if error-status :error
     1492         or error-status :get-message(1) <> ""
     1493         then do:
     1494           undo move_block, retry move_block .
     1495         end.
     1496         for each buf_temp-browse-handle
     1497           where buf_temp-browse-handle.browse-type = 'height':u
     1498         on error undo move_block, retry move_block
     1499         :
     1500           assign
     1501             buf_temp-browse-handle.browse-handle :height
     1502               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1503             no-error .
     1504           if error-status :error
     1505           or error-status :get-message(1) <> ""
     1506           then do:
     1507             undo move_block, retry move_block .
     1508           end.
     1509         end.
     1510         assign
     1511           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1512           no-error .
     1513         if error-status :error
     1514         or error-status :get-message(1) <> ""
     1515         then do:
     1516           undo move_block, retry move_block .
     1517         end.
     1518         if frame Dialog-Frame :scrollable = true
     1519         then do:
     1520           assign
     1521             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1522             no-error .
     1523           if error-status :error
     1524           or error-status :get-message(1) <> ""
     1525           then do:
     1526             undo move_block, retry move_block .
     1527           end.
     1528         end.
     1529       end.
     1530       if p-move-resize = true
     1531       then do:
     1532         run diasize_position-resize-button in this-procedure .
     1533       end.
     1534       if v-diasize-wndstore = true
     1535       then do:
     1536         if connected("ub") = true
     1537         then do:
     1538           define variable v-cntxt-db-num        as integer   no-undo .
     1539           define variable v-cntxt-userid        as character no-undo .
     1540           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1541                                             , OUTPUT v-cntxt-userid
     1542                                             ) .
     1543           run gbl/wndsizew.p
     1544             (input  v-cntxt-db-num
     1545             ,input  v-cntxt-userid
     1546             ,input  v-diasize-proc-name
     1547             ,input  'height':u
     1548             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1549             ) .
     1550         end.
     1551       end.
     1552     end.
     1553     assign
     1554       v-diasize-change-size = false
     1555     .
     1556   end procedure.
     1557   procedure diasize_set-height :
     1558     define input  parameter p-new-height  as decimal   no-undo .
     1559     define input  parameter p-move-resize as logical   no-undo .
     1560     do
     1561     on error undo, return error return-value
     1562     :
     1563       run diasize_change-height in this-procedure
     1564         (input  (p-new-height - frame Dialog-Frame :height)
     1565         ,input  p-move-resize
     1566         ) .
     1567     end.
     1568   end procedure.
     1569   procedure diasize_change-width :
     1570     define input  parameter p-change-value as decimal   no-undo .
     1571     define input  parameter p-move-resize  as logical   no-undo .
     1572     define variable v-field-group-handle   as handle    no-undo .
     1573     define variable v-object-handle        as handle    no-undo .
     1574     define variable v-frame-width          as decimal   no-undo .
     1575     define variable v-frame-virtual-width  as decimal   no-undo .
     1576     define variable v-browse-width         as decimal   no-undo .
     1577     define variable v-window-width         as decimal   no-undo .
     1578     define variable v-window-virtual-width as decimal   no-undo .
     1579     define variable v-change-sign          as integer   no-undo .
     1580     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1581     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1582     if p-change-value > 0
     1583     then do:
     1584       if frame Dialog-Frame :width + p-change-value >
     1585           session :width-chars
     1586       then do:
     1587         assign
     1588           p-change-value = session :width-chars - frame Dialog-Frame :width
     1589         .
     1590         if p-change-value <= 0
     1591         then do:
     1592           run diasize_position-resize-button in this-procedure .
     1593           return .
     1594         end.
     1595       end.
     1596     end.
     1597     if p-change-value < 0
     1598     then do:
     1599       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1600       then do:
     1601         assign
     1602           p-change-value = v-diasize-orig-frame-width
     1603                          - frame Dialog-Frame :width
     1604         .
     1605         if p-change-value >= 0
     1606         then do:
     1607           run diasize_position-resize-button in this-procedure .
     1608           return .
     1609         end.
     1610       end.
     1611     end.
     1612     if p-change-value >= 0
     1613     then do:
     1614       assign
     1615         v-change-sign = 1
     1616       .
     1617     end.
     1618     else do:
     1619       assign
     1620         v-change-sign = -1
     1621       .
     1622     end.
     1623     assign
     1624       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1625     .
     1626     if p-change-value = 0
     1627     then do:
     1628       run diasize_position-resize-button in this-procedure .
     1629       return .
     1630     end.
     1631     move_block:
     1632     do
     1633     on error undo move_block, leave move_block
     1634     :
     1635       if retry
     1636       then do:
     1637         do
     1638         on error undo move_block, leave move_block
     1639         :
     1640           if p-change-value > 0
     1641           then do:
     1642             for each buf_temp-diasize-handle
     1643             on error undo, next
     1644             :
     1645               assign
     1646                 v-object-handle = buf_temp-diasize-handle.handle-value
     1647               .
     1648               if v-object-handle <> v-diasize-resize-button
     1649               then do:
     1650                 assign
     1651                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1652                 .
     1653               end.
     1654             end.
     1655             assign
     1656               v-diasize-browse-handle :width = v-browse-width
     1657             .
     1658             for each buf_temp-browse-handle
     1659               where buf_temp-browse-handle.browse-type = 'width':u
     1660             on error undo, next
     1661             :
     1662               assign
     1663                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1664               .
     1665             end.
     1666             assign
     1667               frame Dialog-Frame :width = v-frame-width
     1668             .
     1669             if frame Dialog-Frame :scrollable = true
     1670             then do:
     1671               assign
     1672                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1673               .
     1674             end.
     1675             run diasize_position-resize-button in this-procedure .
     1676           end.
     1677           else do:
     1678             if frame Dialog-Frame :scrollable = true
     1679             then do:
     1680               assign
     1681                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1682               .
     1683             end.
     1684             assign
     1685               frame Dialog-Frame :width = v-frame-width
     1686             .
     1687             for each buf_temp-browse-handle
     1688               where buf_temp-browse-handle.browse-type = 'width':u
     1689             on error undo, next
     1690             :
     1691               assign
     1692                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1693               .
     1694             end.
     1695             assign
     1696               v-diasize-browse-handle :width = v-browse-width
     1697             .
     1698             for each buf_temp-diasize-handle
     1699             on error undo, next
     1700             :
     1701               assign
     1702                 v-object-handle = buf_temp-diasize-handle.handle-value
     1703               .
     1704               if v-object-handle <> v-diasize-resize-button
     1705               then do:
     1706                 assign
     1707                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1708                 .
     1709               end.
     1710             end.
     1711             run diasize_position-resize-button in this-procedure .
     1712           end.
     1713           assign
     1714             v-diasize-change-size = false
     1715           .
     1716           leave move_block .
     1717         end.
     1718       end.
     1719       assign
     1720         v-diasize-need-full-display = true
     1721       .
     1722       if v-diasize-change-size = false
     1723       then do:
     1724         assign
     1725           v-diasize-change-size = true
     1726         .
     1727       end.
     1728       else do:
     1729         return .
     1730       end.
     1731       assign
     1732         v-frame-width = frame Dialog-Frame :width
     1733         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1734         v-browse-width = v-diasize-browse-handle :width
     1735       .
     1736       for each buf_temp-browse-handle
     1737         where buf_temp-browse-handle.browse-type = 'width':u
     1738       :
     1739         assign
     1740           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1741         .
     1742       end.
     1743       for each buf_temp-diasize-handle
     1744       :
     1745         delete buf_temp-diasize-handle .
     1746       end.
     1747       assign
     1748         v-field-group-handle = frame Dialog-Frame :first-child
     1749       .
     1750       do while valid-handle(v-field-group-handle)
     1751       :
     1752         assign
     1753           v-object-handle = v-field-group-handle :first-child
     1754         .
     1755         do while valid-handle(v-object-handle)
     1756         :
     1757           if  v-object-handle <> v-diasize-browse-handle :handle
     1758           and v-object-handle <> v-diasize-resize-button
     1759           and can-query(v-object-handle, "row")
     1760           and can-query(v-object-handle, "height")
     1761           and ( v-object-handle :col + v-object-handle :width
     1762                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1763               )
     1764           then do:
     1765             find first buf_temp-browse-handle
     1766               where buf_temp-browse-handle.browse-type   = 'width':u
     1767                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1768               no-error .
     1769             if available buf_temp-browse-handle
     1770             then do:
     1771             end.
     1772             else do:
     1773               create buf_temp-diasize-handle .
     1774               assign
     1775                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1776                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1777               .
     1778             end.
     1779           end.
     1780           assign
     1781             v-object-handle = v-object-handle :next-sibling
     1782           .
     1783         end.
     1784         assign
     1785           v-field-group-handle = v-field-group-handle :next-sibling
     1786         .
     1787       end.
     1788       do with frame Dialog-Frame
     1789       :
     1790         hide v-diasize-resize-button .
     1791         v-diasize-resize-button :row = 1.
     1792         v-diasize-resize-button :column = 1.
     1793       end.
     1794       if p-change-value > 0
     1795       then do:
     1796         if frame Dialog-Frame :scrollable = true
     1797         then do:
     1798           assign
     1799             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1800             no-error .
     1801           if error-status :error
     1802           or error-status :get-message(1) <> ""
     1803           then do:
     1804             undo move_block, retry move_block.
     1805           end.
     1806         end.
     1807         assign
     1808           frame Dialog-Frame :width = v-frame-width + p-change-value
     1809           no-error .
     1810         if error-status :error
     1811         or error-status :get-message(1) <> ""
     1812         then do:
     1813           undo move_block, retry move_block.
     1814         end.
     1815         assign
     1816           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1817         no-error .
     1818         if error-status :error
     1819         or error-status :get-message(1) <> ""
     1820         then do:
     1821           undo move_block, retry move_block.
     1822         end.
     1823         for each buf_temp-browse-handle
     1824           where buf_temp-browse-handle.browse-type = 'width':u
     1825         on error undo move_block, retry move_block
     1826         :
     1827           assign
     1828             buf_temp-browse-handle.browse-handle :width
     1829               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1830             no-error .
     1831           if error-status :error
     1832           or error-status :get-message(1) <> ""
     1833           then do:
     1834             undo move_block, retry move_block .
     1835           end.
     1836         end.
     1837         for each buf_temp-diasize-handle
     1838         on error undo move_block, retry move_block
     1839         :
     1840           assign
     1841             v-object-handle = buf_temp-diasize-handle.handle-value
     1842           .
     1843           if v-object-handle <> v-diasize-resize-button
     1844           then do:
     1845             assign
     1846               v-object-handle :col = v-object-handle :col + p-change-value
     1847               no-error .
     1848             if error-status :error
     1849             or error-status :get-message(1) <> ""
     1850             then do:
     1851               undo move_block, retry move_block .
     1852             end.
     1853           end.
     1854         end.
     1855       end.
     1856       else do:
     1857         for each buf_temp-diasize-handle
     1858         on error undo move_block, retry move_block
     1859         :
     1860           assign
     1861             v-object-handle = buf_temp-diasize-handle.handle-value
     1862           .
     1863           if v-object-handle <> v-diasize-resize-button
     1864           then do:
     1865             assign
     1866               v-object-handle :col = v-object-handle :col + p-change-value
     1867               no-error .
     1868             if error-status :error
     1869             or error-status :get-message(1) <> ""
     1870             then do:
     1871               undo move_block, retry move_block .
     1872             end.
     1873           end.
     1874         end.
     1875         for each buf_temp-browse-handle
     1876           where buf_temp-browse-handle.browse-type = 'width':u
     1877         on error undo move_block, retry move_block
     1878         :
     1879           assign
     1880             buf_temp-browse-handle.browse-handle :width
     1881               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1882             no-error .
     1883           if error-status :error
     1884           or error-status :get-message(1) <> ""
     1885           then do:
     1886             undo move_block, retry move_block .
     1887           end.
     1888         end.
     1889         assign
     1890           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1891           no-error .
     1892         if error-status :error
     1893         or error-status :get-message(1) <> ""
     1894         then do:
     1895           undo move_block, retry move_block.
     1896         end.
     1897         assign
     1898           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1899         no-error .
     1900         if error-status :error
     1901         or error-status :get-message(1) <> ""
     1902         then do:
     1903           undo move_block, retry move_block.
     1904         end.
     1905         if frame Dialog-Frame :scrollable = true
     1906         then do:
     1907           assign
     1908             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1909           no-error .
     1910           if error-status :error
     1911           or error-status :get-message(1) <> ""
     1912           then do:
     1913             undo move_block, retry move_block.
     1914           end.
     1915         end.
     1916       end.
     1917       if p-move-resize
     1918       then do:
     1919         run diasize_position-resize-button in this-procedure .
     1920       end.
     1921       if v-diasize-wndstore = true
     1922       then do:
     1923         if connected("ub") = true
     1924         then do:
     1925           define variable v-cntxt-db-num        as integer   no-undo .
     1926           define variable v-cntxt-userid        as character no-undo .
     1927           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1928                                             , OUTPUT v-cntxt-userid
     1929                                             ) .
     1930           run gbl/wndsizew.p
     1931             (input  v-cntxt-db-num
     1932             ,input  v-cntxt-userid
     1933             ,input  v-diasize-proc-name
     1934             ,input  'width':u
     1935             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1936             ) .
     1937         end.
     1938       end.
     1939     end.
     1940     assign
     1941       v-diasize-change-size = false
     1942     .
     1943   end procedure.
     1944   procedure diasize_set-width :
     1945     define input  parameter p-new-width  as decimal   no-undo .
     1946     define input  parameter p-move-resize as logical   no-undo .
     1947     do
     1948     on error undo, return error return-value
     1949     :
     1950       run diasize_change-width in this-procedure
     1951         (input  (p-new-width - frame Dialog-Frame :width)
     1952         ,input  p-move-resize
     1953         ) .
     1954     end.
     1955   end procedure.
     1956   procedure diasize_position-resize-button :
     1957     do with frame Dialog-Frame
     1958     :
     1959       hide v-diasize-resize-button .
     1960       assign
     1961         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1962                     - 1
     1963                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1964         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1965                     - 1
     1966                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1967       .
     1968       view v-diasize-resize-button .
     1969     end.
     1970   end procedure.
     1971   on alt-right anywhere
     1972   do:
     1973     run diasize_change-width in this-procedure
     1974       (input 1
     1975       ,input true
     1976       ) .
     1977     return no-apply .
     1978   end.
     1979   on alt-left anywhere
     1980   do:
     1981     run diasize_change-width in this-procedure
     1982       (input -1
     1983       ,input true
     1984       ) .
     1985     return no-apply .
     1986   end.
     1987   on alt-down anywhere
     1988   do:
     1989     run diasize_change-height in this-procedure
     1990       (input 1
     1991       ,input true
     1992       ) .
     1993     return no-apply .
     1994   end.
     1995   on alt-up anywhere
     1996   do:
     1997     run diasize_change-height in this-procedure
     1998       (input -1
     1999       ,input true
     2000       ) .
     2001     return no-apply .
     2002   end.
     2003   on alt-enter of frame Dialog-Frame
     2004   do:
     2005     run diasize_maximize in this-procedure
     2006       (input  ?
     2007       ).
     2008     return no-apply .
     2009   end.
     2010   procedure diasize_end-move :
     2011     do
     2012     on error undo, return error return-value
     2013     :
     2014       define variable v-row-delta as decimal   no-undo .
     2015       define variable v-col-delta as decimal   no-undo .
     2016       define variable v-new-row as decimal   no-undo .
     2017       define variable v-new-col as decimal   no-undo .
     2018       assign
     2019         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2020         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2021       .
     2022       assign
     2023         v-row-delta = v-new-row - frame Dialog-Frame :height
     2024         v-col-delta = v-new-col - frame Dialog-Frame :width
     2025       .
     2026       run diasize_change-height in this-procedure
     2027         (input v-row-delta
     2028         ,input true
     2029         ) .
     2030       run diasize_change-width in this-procedure
     2031         (input v-col-delta
     2032         ,input true
     2033         ) .
     2034     end.
     2035   end procedure.
     2036   procedure diasize_maximize :
     2037     define input  parameter p-action as logical   no-undo .
     2038     do
     2039     on error undo, return error return-value
     2040     :
     2041       if p-action = ?
     2042       then do:
     2043         if v-diasize-need-maximize = true
     2044         then do:
     2045           assign
     2046             p-action = true
     2047           .
     2048         end.
     2049         else do:
     2050           assign
     2051             p-action = false
     2052           .
     2053         end.
     2054       end.
     2055       if p-action = true
     2056       then do:
     2057         run diasize_change-height in this-procedure
     2058           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2059               - frame Dialog-Frame :height-chars
     2060           ,input true
     2061           ) .
     2062         run diasize_change-width in this-procedure
     2063           (input session :width-chars
     2064               - frame Dialog-Frame :width-chars
     2065           ,input true
     2066           ) .
     2067         assign
     2068           v-diasize-need-maximize = false
     2069         .
     2070       end.
     2071       else do:
     2072         run diasize_change-width in this-procedure
     2073           (input v-diasize-orig-frame-width
     2074               - frame Dialog-Frame :width-chars
     2075           ,input true
     2076           ) .
     2077         run diasize_change-height in this-procedure
     2078           (input v-diasize-orig-frame-height
     2079               - frame Dialog-Frame :height-chars
     2080           ,input true
     2081           ) .
     2082         assign
     2083           v-diasize-need-maximize = true
     2084         .
     2085       end.
     2086     end.
     2087   end procedure.
     2088   procedure diasize_restore-orig-size :
     2089     do
     2090     on error undo, return error return-value
     2091     :
     2092       assign
     2093         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2094         v-diasize-current-frame-height = frame Dialog-Frame :height
     2095       .
     2096       run diasize_set-height in this-procedure
     2097         (input  v-diasize-orig-frame-height
     2098         ,input  true
     2099         ) .
     2100       run diasize_set-width in this-procedure
     2101         (input  v-diasize-orig-frame-width
     2102         ,input  true
     2103         ) .
     2104     end.
     2105   end procedure.
     2106   procedure diasize_restore-current-size :
     2107     do
     2108     on error undo, return error return-value
     2109     :
     2110       run diasize_set-height in this-procedure
     2111         (input  v-diasize-current-frame-height
     2112         ,input  true
     2113         ) .
     2114       run diasize_set-width in this-procedure
     2115         (input  v-diasize-current-frame-width
     2116         ,input  true
     2117         ) .
     2118     end.
     2119   end procedure.
     2120   procedure diasize_set-browse-handle :
     2121     define input  parameter p-browse-handle as handle   no-undo .
     2122     define buffer buf_temp-browse-handle for temp-browse-handle .
     2123     do
     2124     on error undo, return error return-value
     2125     :
     2126       assign
     2127         v-diasize-browse-handle = p-browse-handle
     2128       .
     2129       for each buf_temp-browse-handle
     2130       on error undo, return error return-value
     2131       :
     2132         delete buf_temp-browse-handle .
     2133       end.
     2134     end.
     2135   end procedure.
     2136   procedure diasize_add_browse :
     2137     define input  parameter p-browse-type   as character no-undo .
     2138     define input  parameter p-browse-handle as handle    no-undo .
     2139     define buffer buf_temp-browse-handle for temp-browse-handle .
     2140     do
     2141     on error undo, return error return-value
     2142     :
     2143       assign
     2144         v-diasize-browse-number = v-diasize-browse-number + 1
     2145       .
     2146       create buf_temp-browse-handle .
     2147       assign
     2148         buf_temp-browse-handle.browse-type   = p-browse-type
     2149         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2150         buf_temp-browse-handle.browse-handle = p-browse-handle
     2151       .
     2152     end.
     2153   end procedure.
     2154   procedure diasize_init :
     2155     define variable v-default-value    as logical   no-undo .
     2156     define variable v-restore-saved    as logical   no-undo .
     2157     define variable v-resize-value-str as character no-undo .
     2158     do
     2159     on error undo, return error return-value
     2160     :
     2161       do with frame Dialog-Frame
     2162       :
     2163         assign
     2164           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2165           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2166           v-diasize-browse-handle     = browse br-rule-script :handle
     2167         .
     2168         create button v-diasize-resize-button
     2169         assign
     2170           parent        = frame Dialog-Frame :first-child
     2171           label         = "s"
     2172           height-pixels = 16
     2173           width-pixels  = 16
     2174           visible       = true
     2175           sensitive     = true
     2176           movable       = true
     2177           triggers:
     2178             on end-move persistent run diasize_end-move in this-procedure .
     2179           end triggers.
     2180         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2181         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2182         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2183         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2184         assign
     2185           v-diasize-wndmax = false
     2186         .
     2187         if connected("ub") = true
     2188         then do:
     2189           define variable v-cntxt-db-num        as integer   no-undo .
     2190           define variable v-cntxt-userid        as character no-undo .
     2191           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2192                                             , OUTPUT v-cntxt-userid
     2193                                             ) .
     2194           run gbl/wndpar_r.p
     2195             (input  v-cntxt-db-num
     2196             ,input  v-cntxt-userid
     2197             ,input  'wndmax':U
     2198             ,output v-diasize-wndmax
     2199             ,output v-default-value
     2200             ) .
     2201         end.
     2202         assign
     2203           v-diasize-wndstore = false
     2204         .
     2205         if connected("ub") = true
     2206         then do:
     2207           run gbl/wndpar_r.p
     2208             (input  v-cntxt-db-num
     2209             ,input  v-cntxt-userid
     2210             ,input  'wndstore':U
     2211             ,output v-diasize-wndstore
     2212             ,output v-default-value
     2213             ) .
     2214         end.
     2215         assign
     2216           v-diasize-proc-name = entry(1, program-name(2), '.')
     2217         .
     2218         if v-diasize-wndstore = true
     2219         then do:
     2220           assign
     2221             v-restore-saved = false
     2222           .
     2223           if connected("ub") = true
     2224           then do:
     2225             run gbl/wndsizer.p
     2226               (input  v-cntxt-db-num
     2227               ,input  v-cntxt-userid
     2228               ,input  v-diasize-proc-name
     2229               ,input  'height':u
     2230               ,output v-resize-value-str
     2231               ) .
     2232             if v-resize-value-str <> '':U
     2233             then do:
     2234               run diasize_change-height in this-procedure
     2235                 (input  integer(v-resize-value-str)
     2236                 ,input  true
     2237                 ) .
     2238               assign
     2239                 v-restore-saved = true
     2240               .
     2241             end.
     2242           end.
     2243           if connected("ub") = true
     2244           then do:
     2245             run gbl/wndsizer.p
     2246               (input  v-cntxt-db-num
     2247               ,input  v-cntxt-userid
     2248               ,input  v-diasize-proc-name
     2249               ,input  'width':u
     2250               ,output v-resize-value-str
     2251               ) .
     2252             if v-resize-value-str <> '':U
     2253             then do:
     2254               run diasize_change-width in this-procedure
     2255                 (input  integer(v-resize-value-str)
     2256                 ,input  true
     2257                 ) .
     2258               assign
     2259                 v-restore-saved = true
     2260               .
     2261             end.
     2262           end.
     2263           if v-restore-saved <> true
     2264           then do:
     2265             if v-diasize-wndmax = true
     2266             then do:
     2267               run diasize_maximize in this-procedure
     2268                 (input  true
     2269                 ) .
     2270             end.
     2271           end.
     2272         end.
     2273         else do:
     2274           if v-diasize-wndmax = true
     2275           then do:
     2276             run diasize_maximize in this-procedure
     2277               (input  true
     2278               ) .
     2279           end.
     2280         end.
     2281       end.
     2282     end.
     2283   end procedure.
     2284   procedure diasize_need-full-display :
     2285     define output parameter p-need-full-display as logical   no-undo .
     2286     do
     2287     on error undo, return error return-value
     2288     :
     2289       assign
     2290         p-need-full-display = v-diasize-need-full-display
     2291       .
     2292       assign
     2293         v-diasize-need-full-display = false
     2294       .
     2295     end.
     2296   end procedure.
     2297   procedure get-context :
     2298      define output parameter p-db-num as integer          no-undo.
     2299      define output parameter p-user-id as character        no-undo.
     2300      define variable v-login               as character    no-undo.
     2301      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2302      define buffer buf_user-login  for ub.user-login .
     2303      do
     2304      on error undo, return error
     2305      :
     2306            FIND FIRST buf_sys-ctrl no-lock.
     2307            ASSIGN
     2308               v-login = USERID("ub")
     2309               p-db-num = buf_sys-ctrl.db-num
     2310            .
     2311            FIND FIRST buf_user-login
     2312                 WHERE buf_user-login.db-num = p-db-num
     2313                   AND buf_user-login.user-login = v-login
     2314                 no-lock
     2315                 no-error
     2316                 .
     2317            IF AVAILABLE buf_user-login
     2318            THEN DO:
     2319               assign
     2320                  p-user-id = buf_user-login.user-id
     2321               .
     2322            END.
     2323      end.
     2324   end procedure.
     2325       run diasize_init in this-procedure .
     2326   MAIN-BLOCK:
     2327   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2328      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2329      ON stop UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2330     if num-entries(p-mode) > 1 then do:
     2331       assign
     2332       v-is-admin-mode = logical(entry(2, p-mode)) no-error .
     2333       p-mode = entry(1, p-mode).
     2334     end.
     2335     RUN fill-main-table IN THIS-PROCEDURE NO-ERROR.
     2336     IF ERROR-STATUS:ERROR THEN UNDO, RETURN ERROR.
     2337     IF p-mode <> 'ДОБАВЛЕНИЕ':U  THEN DO:
     2338       RUN fill-tables IN THIS-PROCEDURE (  INPUT tt-rule.RULE_id
     2339                                       ,INPUT tt-rule.root_RULE_id
     2340                                       ,INPUT-OUTPUT v-level
     2341                                       ,INPUT "") no-error.
     2342       IF ERROR-STATUS:ERROR THEN UNDO, RETURN ERROR.
     2343     END.
     2344     RUN Myenable.
     2345     WAIT-FOR GO OF FRAME Dialog-Frame.
     2346   END.
     2347   RUN disable_UI.
     2348   PROCEDURE disable_UI :
     2349     HIDE FRAME Dialog-Frame.
     2350   END PROCEDURE.
     2351   PROCEDURE enable_UI :
     2352     OPEN QUERY Dialog-Frame FOR EACH tt-rule SHARE-LOCK.
     2353     GET FIRST Dialog-Frame.
     2354     DISPLAY T-hidden RS-language
     2355         WITH FRAME Dialog-Frame.
     2356     IF AVAILABLE tt-rule THEN
     2357       DISPLAY tt-rule.rule_id tt-rule.codex_id tt-rule.reusable-params tt-rule.name
     2358             tt-rule.image-file-name tt-rule.documentation
     2359         WITH FRAME Dialog-Frame.
     2360     ENABLE B-exit b-quit T-hidden b-print B-Help tt-rule.reusable-params B-codex
     2361            tt-rule.name b-image tt-rule.documentation b-sel B-add B-del B-chg
     2362            b-move B-text b-params RS-language br-rule-script
     2363         WITH FRAME Dialog-Frame.
     2364     VIEW FRAME Dialog-Frame.
     2365     OPEN QUERY br-rule-script FOR EACH tt-rule-script WHERE     tt-rule-script.root_RULE_id  = tt-rule.RULE_id AND tt-rule-script.LANGUAGE = rs-language NO-LOCK INDEXED-REPOSITION.
     2366   END PROCEDURE.
     2367   PROCEDURE fill-main-table :
     2368   DEFINE BUFFER buf_tt-ruledict-param FOR tt-ruledict-param.
     2369   DEFINE BUFFER buf_ruledict-param FOR ub.ruledict-param.
     2370   DEFINE BUFFER buf_ruledict FOR ub.ruledict.
     2371   define buffer buf_rule-i-script for ub.rule-i-script.
     2372   define buffer buf_tt-rule-i-script for tt-rule-i-script.
     2373   FOR EACH tt-rule:
     2374     DELETE tt-rule.
     2375   END.
     2376   FOR EACH tt-rule-script:
     2377     DELETE tt-rule-script.
     2378   END.
     2379   FOR EACH tt-rule-i-script:
     2380     DELETE tt-rule-i-script.
     2381   END.
     2382   FOR EACH tt-ruledict-param:
     2383     DELETE tt-ruledict-param.
     2384   END.
     2385   IF p-mode = 'ДОБАВЛЕНИЕ':U THEN DO:
     2386       FIND FIRST first_rule EXCLUSIVE-LOCK.
     2387       CREATE tt-rule.
     2388       ASSIGN
     2389       tt-rule.upper_rule_id = 0
     2390       tt-rule.RULE_id = next-value(s-rule-id, ub)
     2391       tt-rule.root_rule_id = tt-rule.rule_id
     2392       .
     2393   END.
     2394   else do:
     2395     IF p-mode = 'ИЗМЕНЕНИЕ':U THEN DO:
     2396       FIND FIRST LOCKED_rule EXCLUSIVE-LOCK WHERE
     2397                 LOCKED_rule.RULE_id = p-rule-id.
     2398       if locked_rule.upper_rule_id <> 0 then do:
     2399         message
     2400         "Нельзя вызвать интерейс редактирования для НЕКОРНЕВОГО (upper_rule_id <> 0) правила"
     2401         view-as alert-box error .
     2402         undo, return error .
     2403       end.
     2404       if v-is-admin-mode = no then do:
     2405         run trg/rule-chk.p ( input 'ИЗМЕНЕНИЕ':U
     2406                             ,input p-rule-id
     2407                             ,output v-ok
     2408                             ,output v-mess) no-error.
     2409         if error-status:error
     2410         or not v-ok then do:
     2411           message
     2412           "Нельзя изменить правило" skip
     2413           error-status:get-message(1) skip
     2414           v-mess
     2415           view-as alert-box error .
     2416           undo, return error .
     2417         end.
     2418       end.
     2419       for each buf_rule-i-script where
     2420               buf_rule-i-script.root_rule_id = p-rule-id:
     2421         create buf_tt-rule-i-script.
     2422         buffer-copy buf_rule-i-script
     2423         to buf_tt-rule-i-script.
     2424       end.
     2425       FIND FIRST locked_ruledict EXCLUSIVE-LOCK WHERE
     2426                 locked_ruledict.ENTRY-type = 'rule':U
     2427           AND locked_ruledict.uniq-key-rec = locked_rule.uniq-key-rec NO-ERROR.
     2428     END.
     2429     IF p-mode = 'ПРОСМОТР':U THEN DO:
     2430         FIND FIRST LOCKED_rule no-lock WHERE
     2431                   LOCKED_rule.rule_id = p-rule-id.
     2432         FIND FIRST locked_ruledict NO-LOCK WHERE
     2433                   locked_ruledict.ENTRY-type = 'rule':U
     2434             AND locked_ruledict.uniq-key-rec = locked_rule.uniq-key-rec NO-ERROR.
     2435         IF NOT AVAILABLE locked_ruledict THEN DO:
     2436           MESSAGE
     2437           substitute("Для правила &1 не найден термин в словаре", p-rule-id)
     2438           VIEW-AS ALERT-BOX ERROR.
     2439           UNDO, RETURN ERROR.
     2440         END.
     2441     END.
     2442     create tt-rule.
     2443     buffer-copy locked_rule to tt-rule.
     2444     FOR EACH buf_ruledict-param NO-LOCK WHERE
     2445           buf_ruledict-param.entry-id = locked_ruledict.ENTRY-id:
     2446       CREATE buf_tt-ruledict-param.
     2447       BUFFER-COPY buf_ruledict-param TO buf_tt-ruledict-param.
     2448     END.
     2449   end.
     2450   END PROCEDURE.
     2451   PROCEDURE fill-tables :
     2452   DEFINE INPUT PARAMETER p-rule-id AS INTEGER NO-UNDO.
     2453   DEFINE INPUT PARAMETER p-root-rule-id AS INTEGER NO-UNDO.
     2454   DEFINE INPUT-OUTPUT PARAMETER p-level AS INTEGER NO-UNDO.
     2455   DEFINE INPUT PARAMETER p-gen-order AS character NO-UNDO.
     2456   DEFINE BUFFER buf_rule FOR ub.RULE.
     2457   DEFINE BUFFER buf_rule-script FOR ub.RULE-script.
     2458   DEFINE BUFFER buf_tt-rule FOR tt-RULE.
     2459   DEFINE BUFFER buf_tt-rule-script FOR tt-RULE-script.
     2460   p-level = p-level + 1.
     2461   FOR EACH buf_rule NO-LOCK WHERE
     2462           buf_rule.UPPER_rule_id = p-rule-id:
     2463      find first buf_tt-rule where
     2464               buf_tt-rule.rule_id = buf_rule.rule_id no-error.
     2465      if not available buf_tt-rule then do:
     2466       CREATE buf_tt-rule.
     2467       buffer-copy buf_rule to buf_tt-rule.
     2468       ASSIGN
     2469       buf_tt-rule.root_rule_id = p-root-rule-id
     2470       .
     2471      end.
     2472      buf_tt-rule.level = p-level.
     2473      RUN fill-tables IN THIS-PROCEDURE (  INPUT buf_tt-rule.RULE_id
     2474                                          ,INPUT p-root-rule-id
     2475                                          ,INPUT-OUTPUT p-level
     2476                                          ,INPUT (p-gen-order +
     2477                                           STRING(p-level, "99") +
     2478                                           STRING(buf_tt-rule.salience, "999"))).
     2479   END.
     2480   FOR EACH buf_rule-script NO-LOCK WHERE
     2481           buf_rule-script.rule_id = p-rule-id:
     2482      find first buf_tt-rule-script where
     2483               buf_tt-rule-script.script_id = buf_rule-script.script_id
     2484          AND  buf_tt-rule-script.LANGUAGE = buf_rule-script.LANGUAGE
     2485          no-error.
     2486      if not available buf_tt-rule-script
     2487      then do:
     2488       find first buf_tt-rule no-lock where
     2489                 buf_tt-rule.rule_id = buf_rule-script.rule_id.
     2490       CREATE buf_tt-rule-script.
     2491       buffer-copy buf_rule-script to buf_tt-rule-script.
     2492       ASSIGN
     2493       buf_tt-rule-script.root_rule_id = p-root-rule-id
     2494       buf_tt-rule-script.upper_rule_id = buf_tt-rule.upper_rule_id
     2495       .
     2496      end.
     2497      assign
     2498      buf_tt-rule-script.level = p-level
     2499      buf_tt-rule-script.gen-order = p-gen-order +
     2500                                     STRING(buf_tt-rule-script.level, "99") +
     2501                                     STRING(buf_tt-rule-script.salience, "999").
     2502      .
     2503   END.
     2504   p-level = p-level - 1.
     2505   END PROCEDURE.
     2506   PROCEDURE fill-tt-ruledict-param :
     2507   DEFINE INPUT PARAMETER p-bh AS HANDLE NO-UNDO.
     2508   DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
     2509   FOR EACH tt-ruledict-param
     2510   ON error  UNDO, RETURN ERROR
     2511   ON stop  UNDO, RETURN ERROR:
     2512     ASSIGN
     2513     glog = p-bh:BUFFER-CREATE() NO-ERROR.
     2514     IF NOT glog THEN DO:
     2515        UNDO, RETURN ERROR substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     2516     END.
     2517     ASSIGN
     2518     glog = p-bh:BUFFER-Copy( BUFFER tt-ruledict-param:HANDLE) NO-ERROR.
     2519     IF NOT glog THEN DO:
     2520        UNDO, RETURN ERROR substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     2521     END.
     2522   END.
     2523   END PROCEDURE.
     2524   PROCEDURE fill-tt-tables :
     2525   DEFINE INPUT PARAMETER p-rule-id AS INTEGER NO-UNDO.
     2526   DEFINE INPUT PARAMETER p-root-rule-id AS INTEGER NO-UNDO.
     2527   DEFINE INPUT-OUTPUT PARAMETER p-level AS INTEGER NO-UNDO.
     2528   DEFINE INPUT PARAMETER p-gen-order AS character NO-UNDO.
     2529   DEFINE BUFFER buf_tt-rule FOR tt-RULE.
     2530   DEFINE BUFFER buf_tt-rule-script FOR tt-RULE-script.
     2531   p-level = p-level + 1.
     2532   FOR EACH buf_tt-rule NO-LOCK WHERE
     2533           buf_tt-rule.UPPER_rule_id = p-rule-id:
     2534      buf_tt-rule.level = p-level.
     2535      RUN fill-tt-tables IN THIS-PROCEDURE (  INPUT buf_tt-rule.RULE_id
     2536                                          ,INPUT p-root-rule-id
     2537                                          ,INPUT-OUTPUT p-level
     2538                                          ,INPUT (p-gen-order +
     2539                                           STRING(p-level, "99") +
     2540                                           STRING(buf_tt-rule.salience, "999"))).
     2541   END.
     2542   OUTPUT TO kk.txt.
     2543   FOR EACH buf_tt-rule-script NO-LOCK WHERE
     2544           buf_tt-rule-script.rule_id = p-rule-id,
     2545      FIRST buf_tt-rule WHERE buf_tt-rule.RULE_id = buf_tt-rule-script.RULE_id:
     2546      assign
     2547      buf_tt-rule-script.UPPER_rule_id = buf_tt-rule.UPPER_rule_id
     2548      buf_tt-rule-script.level = p-level
     2549      buf_tt-rule-script.gen-order = p-gen-order +
     2550                                     STRING(buf_tt-rule-script.level, "99") +
     2551                                     STRING(buf_tt-rule-script.salience, "999").
     2552      .
     2553      EXPORT buf_tt-rule-script.
     2554   END.
     2555   OUTPUT CLOSE.
     2556   p-level = p-level - 1.
     2557   END PROCEDURE.
     2558   PROCEDURE MyEnable :
     2559   DEFINE VARIABLE v-h AS WIDGET-HANDLE NO-UNDO.
     2560   assign
     2561   rs-language:radio-buttons in frame Dialog-Frame = "ABL" + chr(44) + "ABL" + chr(44) +
     2562                                                      "rus" + chr(44) + "rus"
     2563   v-h = br-rule-script:FIRST-COLUMN IN FRAME Dialog-Frame
     2564   b-add:menu-mouse IN FRAME Dialog-Frame = 1
     2565   b-sel:menu-mouse IN FRAME Dialog-Frame = 1
     2566   .
     2567   tt-rule-script.gen-order:RESIZABLE IN BROWSE br-rule-script = YES.
     2568   DO while valid-handle(v-h) :
     2569     if v-h:LABEL = "Выражение" then do:
     2570       v-h:RESIZABLE = YES.
     2571       LEAVE.
     2572     end.
     2573     ELSE DO:
     2574       v-h = v-h:NEXT-COLUMN.
     2575     END.
     2576   END.
     2577   ASSIGN
     2578   t-hidden = tt-rule.HIDDEN-content > 0
     2579   .
     2580   DISPLAY RS-language
     2581   WITH FRAME Dialog-Frame .
     2582   IF AVAILABLE tt-rule THEN
     2583   DISPLAY
     2584   tt-rule.rule_id
     2585   tt-rule.reusable-params
     2586   tt-rule.codex_id
     2587   tt-rule.documentation
     2588   tt-rule.name
     2589   t-HIDDEN
     2590   tt-rule.image-file-name
     2591   WITH FRAME Dialog-Frame .
     2592   ENABLE
     2593   B-exit  when p-mode <> 'ПРОСМОТР':U
     2594   b-quit
     2595   tt-rule.reusable-params when p-mode <> 'ПРОСМОТР':U
     2596   B-Help
     2597   tt-rule.name
     2598   tt-rule.documentation
     2599   b-image when p-mode <> 'ПРОСМОТР':U
     2600   RS-language
     2601   B-add   when p-mode <> 'ПРОСМОТР':U
     2602   B-del   when p-mode <> 'ПРОСМОТР':U
     2603   B-chg   when p-mode <> 'ПРОСМОТР':U
     2604   B-move   when p-mode <> 'ПРОСМОТР':U
     2605   B-text   when p-mode <> 'ПРОСМОТР':U
     2606   t-hIDDEN WHEN p-mode <> 'ПРОСМОТР':U
     2607   b-print
     2608   b-codex WHEN (p-mode <> 'ПРОСМОТР':U
     2609                 AND NOT CAN-FIND (FIRST ub.rule-i-script WHERE
     2610                                         ub.rule-script.RULE_id = tt-rule.RULE_id)
     2611                 AND NOT CAN-FIND (FIRST ub.rule WHERE
     2612                                         ub.rule.upper_RULE_id = tt-rule.RULE_id)
     2613                 AND NOT CAN-FIND (FIRST ub.rule-script WHERE
     2614                                         ub.rule-script.RULE_id = tt-rule.RULE_id)
     2615                )
     2616   br-rule-script
     2617   b-params
     2618   WITH FRAME Dialog-Frame .
     2619   ASSIGN
     2620   tt-rule.documentation:READ-ONLY IN FRAME Dialog-Frame = (p-mode = 'ПРОСМОТР':U)
     2621   tt-rule.name:READ-ONLY IN FRAME Dialog-Frame = (p-mode = 'ПРОСМОТР':U).
     2622   if p-mode = 'ПРОСМОТР':U then do:
     2623     hide
     2624     b-exit
     2625     b-add
     2626     b-chg
     2627     b-del
     2628     b-move
     2629     in frame Dialog-Frame .
     2630     assign
     2631     b-quit:label = "&Выход"
     2632     b-quit:column = 1.
     2633     if tt-rule.codex_id <> 19 then do:
     2634       hide
     2635       b-image
     2636       tt-rule.image-file-name
     2637       in frame Dialog-Frame .
     2638     end.
     2639   end.
     2640   VIEW FRAME Dialog-Frame .
     2641   APPLY "VALUE-CHANGED" to t-hidden.
     2642   RUN Openbr IN THIS-PROCEDURE NO-ERROR.
     2643   END PROCEDURE.
     2644   PROCEDURE openbr :
     2645   OPEN QUERY br-rule-script FOR EACH tt-rule-script NO-LOCK  WHERE
     2646       tt-rule-script.root_RULE_id  = tt-rule.RULE_id
     2647   AND tt-rule-script.LANGUAGE = rs-language
     2648   BY tt-rule-script.gen-order
     2649   INDEXED-REPOSITION.
     2650   APPLY "ENTRY" to browse br-rule-script .
     2651   APPLY "VALUE-CHANGED" to browse br-rule-script.
     2652   END PROCEDURE.
     2653   PROCEDURE proc-aff-move :
     2654   define input parameter p-move-rule-id as integer no-undo .
     2655   define input parameter p-move-script-id as integer no-undo .
     2656   define input parameter p-dest-rule-id as integer no-undo .
     2657   define input parameter p-dest-script-id as integer no-undo .
     2658   define input parameter p-move-option as character no-undo .
     2659   DEFINE VARIABLE v-add-option AS CHARACTER NO-UNDO extent 3.
     2660   DEFINE VARIABLE v-script-al AS CHARACTER NO-UNDO  extent 3.
     2661   DEFINE VARIABLE v-script-nl AS CHARACTER NO-UNDO extent 3.
     2662   define variable v-script-type as character no-undo  extent 3.
     2663   define variable v-script-id as integer no-undo extent 3.
     2664   define variable v-rule-id as integer no-undo extent 3.
     2665   DEFINE BUFFER MOVE_tt-rule-script FOR tt-rule-script.
     2666   DEFINE BUFFER MOVE2_tt-rule-script FOR tt-rule-script.
     2667   DEFINE BUFFER dest_tt-rule-script FOR tt-rule-script.
     2668   define buffer move_tt-rule  for tt-rule.
     2669   FOR each MOVE_tt-rule-script WHERE
     2670              MOVE_tt-rule-script.RULE_id = p-move-rule-id
     2671         AND  MOVE_tt-rule-script.script_id = p-move-script-id:
     2672     IF MOVE_tt-rule-script.LANGUAGE = "ABL" THEN DO:
     2673        v-script-al[1] = MOVE_tt-rule-script.script.
     2674        v-script-type[1] = move_tt-rule-script.script-type.
     2675     END.
     2676     IF MOVE_tt-rule-script.LANGUAGE = "rus" THEN DO:
     2677        v-script-nl[1] = MOVE_tt-rule-script.script.
     2678     END.
     2679     case  move_tt-rule-script.script-type:
     2680       when 'COND':U
     2681       or
     2682       when 'CYCLE-COND':U
     2683       then do:
     2684         for each move2_tt-rule-script where
     2685             move2_tt-rule-script.rule_id = move_tt-rule-script.rule_id
     2686         and move2_tt-rule-script.salience > move_tt-rule-script.salience :
     2687           if move2_tt-rule-script.script-type = 'RULE':U
     2688           and v-script-type[2] = '':U
     2689           then do:
     2690             v-add-option[2] = 'RULE':U.
     2691             v-script-al[2] = MOVE2_tt-rule-script.script.
     2692             v-script-type[2] = move2_tt-rule-script.script-type.
     2693             v-script-nl[2] = MOVE2_tt-rule-script.script.
     2694             v-script-id[2] = MOVE2_tt-rule-script.script_id.
     2695             find first move_tt-rule  where
     2696                       move_tt-rule.upper_rule_id = move2_tt-rule-script.rule_id
     2697                  and  move_tt-rule.salience = move2_tt-rule-script.salience.
     2698             v-rule-id[2] = move_tt-rule.rule_id.
     2699           end.
     2700           if move2_tt-rule-script.script-type = 'ELSE-RULE':U
     2701           and v-script-type[3] = '':U
     2702           then do:
     2703             v-add-option[3] = 'ELSE-RULE':U.
     2704             v-script-al[3] = MOVE2_tt-rule-script.script.
     2705             v-script-type[3] = move2_tt-rule-script.script-type.
     2706             v-script-nl[3] = MOVE2_tt-rule-script.script.
     2707             v-script-id[3] = MOVE2_tt-rule-script.script_id.
     2708             find first move_tt-rule  where
     2709                       move_tt-rule.upper_rule_id = move2_tt-rule-script.rule_id
     2710                  and  move_tt-rule.salience = move2_tt-rule-script.salience.
     2711             v-rule-id[3] = move_tt-rule.rule_id.
     2712           end.
     2713         end.
     2714       end.
     2715     end case.
     2716   END.
     2717   FIND FIRST dest_tt-rule-script WHERE
     2718              dest_tt-rule-script.RULE_id = p-dest-rule-id
     2719         AND  dest_tt-rule-script.script_id = p-dest-script-id.
     2720   case p-move-option:
     2721     WHEN "script" THEN DO:
     2722       IF v-script-type[1] = 'COND':U THEN DO:
     2723         v-add-option[1] = 'COND':U.
     2724       END.
     2725       IF v-script-type[1] = 'CYCLE-COND':U THEN DO:
     2726         v-add-option[1] = 'CYCLE-COND':U.
     2727       END.
     2728       IF v-script-type[1] = 'CONS':U THEN DO:
     2729         v-add-option[1] = 'CONS':U.
     2730       END.
     2731       IF v-script-type[1] = 'GOTO':U THEN DO:
     2732         v-add-option[1] = 'GOTO':U.
     2733       END.
     2734     END.
     2735     WHEN "script0" THEN DO:
     2736       IF v-script-type[1] = 'COND':U THEN DO:
     2737           v-add-option[1] = ('COND':U + chr(44) + "0").
     2738       END.
     2739       IF v-script-type[1] = 'CYCLE-COND':U THEN DO:
     2740           v-add-option[1] = ('CYCLE-COND':U + chr(44) + "0").
     2741       END.
     2742       IF v-script-type[1] = 'CONS':U THEN DO:
     2743           v-add-option[1] = ('CONS':U + chr(44) + "0").
     2744       END.
     2745       IF v-script-type[1] = 'GOTO':U THEN DO:
     2746           v-add-option[1] = ('GOTO':U + chr(44) + "0").
     2747       END.
     2748     END.
     2749   END CASE.
     2750   do transaction:
     2751     RUN proc-b-add IN THIS-PROCEDURE ( INPUT v-add-option[1]
     2752                                       ,INPUT v-script-al[1]
     2753                                       ,INPUT v-script-nl[1]
     2754                                       ,input p-move-script-id
     2755                                       ,input 0
     2756                                       ,input 0
     2757                                       ) NO-ERROR.
     2758     IF ERROR-STATUS:ERROR THEN DO:
     2759       RETURN.
     2760     END.
     2761     if v-add-option[2] <> '':U then do:
     2762       RUN proc-b-add IN THIS-PROCEDURE ( INPUT v-add-option[2]
     2763                                         ,INPUT v-script-al[2]
     2764                                         ,INPUT v-script-nl[2]
     2765                                         ,input v-script-id[2]
     2766                                         ,input v-rule-id[2]
     2767                                         ,input p-move-script-id
     2768                                         ) NO-ERROR.
     2769       IF ERROR-STATUS:ERROR THEN DO:
     2770         RETURN.
     2771       END.
     2772     end.
     2773     if v-add-option[3] <> '':U then do:
     2774       RUN proc-b-add IN THIS-PROCEDURE ( INPUT v-add-option[3]
     2775                                         ,INPUT v-script-al[3]
     2776                                         ,INPUT v-script-nl[3]
     2777                                         ,input v-script-id[3]
     2778                                         ,input v-rule-id[3]
     2779                                         ,input p-move-script-id
     2780                                         ) NO-ERROR.
     2781       IF ERROR-STATUS:ERROR THEN DO:
     2782         RETURN.
     2783       END.
     2784     end.
     2785     if not v-add-option[1] begins 'COND':U
     2786     and not v-add-option[1] begins 'CYCLE-COND':U
     2787     then do:
     2788       FOR each MOVE_tt-rule-script WHERE
     2789                 MOVE_tt-rule-script.RULE_id = p-move-rule-id
     2790             AND  MOVE_tt-rule-script.script_id = p-move-script-id:
     2791         RUN proc-b-del IN THIS-PROCEDURE ( INPUT p-move-rule-id
     2792                                           ,INPUT p-move-script-id).
     2793       END.
     2794     end.
     2795   end.
     2796   END PROCEDURE.
     2797   PROCEDURE proc-b-add :
     2798   DEFINE INPUT PARAMETER p-add-option AS CHARACTER NO-UNDO.
     2799   DEFINE INPUT PARAMETER p-move-script-al AS CHARACTER NO-UNDO.
     2800   DEFINE INPUT PARAMETER p-move-script-nl AS CHARACTER NO-UNDO.
     2801   define input parameter p-move-script-id as integer no-undo .
     2802   define input parameter p-move-rule-id as integer no-undo .
     2803   define input parameter p-move-cond-id as integer no-undo .
     2804   DEFINE VARIABLE v-add-option AS character NO-UNDO.
     2805   DEFINE VARIABLE v-rec AS RECID NO-UNDO.
     2806   DEFINE VARIABLE v-upper-rule-id AS INTEGER.
     2807   DEFINE VARIABLE v-rule-id AS INTEGER.
     2808   DEFINE VARIABLE v-script-id AS INTEGER.
     2809   define variable v-salience as integer no-undo .
     2810   define variable v-level as integer no-undo .
     2811   DEFINE BUFFER buf_tt-rule FOR tt-rule.
     2812   DEFINE BUFFER buf2_tt-rule FOR tt-rule.
     2813   DEFINE BUFFER buf_tt-rule-script FOR tt-rule-script.
     2814   DEFINE BUFFER buf2_tt-rule-script FOR tt-rule-script.
     2815   DEFINE BUFFER buf_tt-l_rule-script FOR tt-rule-script.
     2816   DEFINE BUFFER bufm_tt-l_rule-script FOR tt-rule-script.
     2817   DEFINE BUFFER bufm_tt-rule-script FOR tt-rule-script.
     2818   define buffer buf_tt-rule-i-script for tt-rule-i-script.
     2819   define buffer bufm_tt-rule-i-script for tt-rule-i-script.
     2820   IF tt-rule.codex_id = 0  THEN DO:
     2821        MESSAGE
     2822        "Для редактирования необходимо сначала выбрать кодекс правил"
     2823         VIEW-AS ALERT-BOX ERROR.
     2824        RETURN NO-APPLY.
     2825    END.
     2826   IF AVAILABLE tt-rule-script THEN DO:
     2827     v-rec = RECID(tt-rule-script).
     2828   END.
     2829   CASE p-add-option:
     2830     WHEN 'RULE':U THEN DO:
     2831       v-add-option = 'RULE':U.
     2832       if p-move-rule-id = 0 then do:
     2833         IF NOT AVAILABLE tt-rule-script THEN DO:
     2834           assign
     2835           v-upper-rule-id = tt-rule.rule_id
     2836           v-rule-id = 0
     2837           v-salience =0
     2838           .
     2839         END.
     2840         ELSE DO:
     2841           assign
     2842           v-upper-rule-id = tt-rule-script.rule_id
     2843           v-rule-id = 0
     2844           v-salience = tt-rule-script.salience + 1
     2845           .
     2846         END.
     2847         create buf_tt-rule.
     2848         assign
     2849         buf_tt-rule.upper_rule_id = v-upper-rule-id
     2850         buf_tt-rule.root_rule_id = tt-rule.root_rule_id
     2851         buf_tt-rule.name = '':U
     2852         buf_tt-rule.documentation = '':U
     2853         buf_tt-rule.salience = v-salience
     2854         buf_tt-rule.codex_id = tt-rule.codex_id
     2855         buf_tt-rule.RULE_id = next-value(s-rule-id, ub)
     2856         .
     2857         IF NOT AVAILABLE tt-rule-script THEN DO:
     2858           assign
     2859           v-rule-id = tt-rule.rule_id
     2860           v-salience =0
     2861           .
     2862         END.
     2863         ELSE DO:
     2864           assign
     2865           v-rule-id = tt-rule-script.rule_id
     2866           v-salience = tt-rule-script.salience + 1
     2867           .
     2868         END.
     2869         CREATE buf_tt-rule-script.
     2870         ASSIGN
     2871         v-script-id = next-value(s-rule-script-id, ub)
     2872         buf_tt-rule-script.script_id = v-script-id
     2873         buf_tt-rule-script.RULE_id = v-rule-id
     2874         buf_tt-rule-script.root_RULE_id = buf_tt-rule.root_rule_id
     2875         buf_tt-rule-script.salience = v-salience
     2876         buf_tt-rule-script.script-type = 'RULE':U
     2877         buf_tt-rule-script.LANGUAGE = "ABL".
     2878         RELEASE buf_tt-rule-script.
     2879         CREATE buf_tt-l_rule-script.
     2880         ASSIGN
     2881         buf_tt-l_rule-script.script_id = v-script-id
     2882         buf_tt-l_rule-script.RULE_id = v-rule-id
     2883         buf_tt-l_rule-script.root_RULE_id = tt-rule.root_rule_id
     2884         buf_tt-l_rule-script.salience = v-salience
     2885         buf_tt-l_rule-script.script-type = 'RULE':U
     2886         buf_tt-l_rule-script.LANGUAGE = "rus".
     2887         RELEASE buf_tt-l_rule-script.
     2888       end.
     2889       else do:
     2890         find first buf_tt-rule-script where
     2891                   buf_tt-rule-script.script_id = p-move-cond-id .
     2892         assign
     2893         v-upper-rule-id = buf_tt-rule-script.rule_id
     2894         v-salience = buf_tt-rule-script.salience + 1
     2895         .
     2896         find first buf_tt-rule where buf_tt-rule.rule_id = p-move-rule-id.
     2897         assign
     2898         buf_tt-rule.upper_rule_id = v-upper-rule-id
     2899         buf_tt-rule.salience = v-salience
     2900         .
     2901         find first buf_tt-rule-script where
     2902                   buf_tt-rule-script.script_id = p-move-script-id
     2903               and buf_tt-rule-script.language = "ABL".
     2904         ASSIGN
     2905         buf_tt-rule-script.RULE_id = v-rule-id
     2906         buf_tt-rule-script.salience = v-salience
     2907         .
     2908         RELEASE buf_tt-rule-script.
     2909         find first buf_tt-l_rule-script where
     2910                   buf_tt-l_rule-script.script_id = p-move-script-id
     2911               and buf_tt-l_rule-script.language = "rus".
     2912         ASSIGN
     2913         buf_tt-l_rule-script.RULE_id = v-rule-id
     2914         buf_tt-l_rule-script.salience = v-salience.
     2915         RELEASE buf_tt-l_rule-script.
     2916       end.
     2917     END.
     2918     WHEN 'ELSE-RULE':U THEN DO:
     2919       v-add-option = 'ELSE-RULE':U.
     2920       IF NOT AVAILABLE tt-rule-script THEN DO:
     2921         message "Нельзя создать" view-as alert-box error .
     2922         return error.
     2923       END.
     2924       ELSE DO:
     2925         assign
     2926         v-upper-rule-id = tt-rule-script.rule_id
     2927         v-rule-id = 0
     2928         v-salience = tt-rule-script.salience + 1
     2929         .
     2930       END.
     2931       if p-move-rule-id = 0 then do:
     2932         create buf_tt-rule.
     2933         assign
     2934         buf_tt-rule.upper_rule_id = v-upper-rule-id
     2935         buf_tt-rule.root_rule_id = tt-rule.root_rule_id
     2936         buf_tt-rule.name = '':U
     2937         buf_tt-rule.documentation = '':U
     2938         buf_tt-rule.salience = v-salience
     2939         buf_tt-rule.codex_id = tt-rule.codex_id
     2940         buf_tt-rule.RULE_id = next-value(s-rule-id, ub)
     2941         .
     2942         assign
     2943         v-rule-id = tt-rule-script.rule_id
     2944         v-salience = tt-rule-script.salience + 1
     2945         .
     2946         CREATE buf_tt-rule-script.
     2947         ASSIGN
     2948         v-script-id = next-value(s-rule-script-id, ub)
     2949         buf_tt-rule-script.script_id = v-script-id
     2950         buf_tt-rule-script.RULE_id = v-rule-id
     2951         buf_tt-rule-script.root_RULE_id = buf_tt-rule.root_rule_id
     2952         buf_tt-rule-script.salience = v-salience
     2953         buf_tt-rule-script.script-type = 'ELSE-RULE':U
     2954         buf_tt-rule-script.LANGUAGE = "ABL".
     2955         RELEASE buf_tt-rule-script.
     2956         CREATE buf_tt-l_rule-script.
     2957         ASSIGN
     2958         buf_tt-l_rule-script.script_id = v-script-id
     2959         buf_tt-l_rule-script.RULE_id = v-rule-id
     2960         buf_tt-l_rule-script.root_RULE_id = tt-rule.root_rule_id
     2961         buf_tt-l_rule-script.salience = v-salience
     2962         buf_tt-l_rule-script.script-type = 'ELSE-RULE':U
     2963         buf_tt-l_rule-script.LANGUAGE = "rus".
     2964         RELEASE buf_tt-l_rule-script.
     2965       end.
     2966       else do:
     2967         find first buf_tt-rule where buf_tt-rule.rule_id = p-move-rule-id.
     2968         assign
     2969         buf_tt-rule.upper_rule_id = v-upper-rule-id
     2970         buf_tt-rule.salience = v-salience
     2971         .
     2972         assign
     2973         v-rule-id = tt-rule-script.rule_id
     2974         v-salience = tt-rule-script.salience + 1
     2975         .
     2976         find first buf_tt-rule-script where
     2977                   buf_tt-rule-script.script_id = p-move-script-id
     2978               and buf_tt-rule-script.language = "ABL".
     2979         ASSIGN
     2980         buf_tt-rule-script.RULE_id = v-rule-id
     2981         buf_tt-rule-script.salience = v-salience.
     2982         RELEASE buf_tt-rule-script.
     2983         find first buf_tt-l_rule-script where
     2984                   buf_tt-l_rule-script.script_id = p-move-script-id
     2985               and buf_tt-l_rule-script.language = "rus".
     2986         ASSIGN
     2987         buf_tt-l_rule-script.RULE_id = v-rule-id
     2988         buf_tt-l_rule-script.salience = v-salience.
     2989         RELEASE buf_tt-l_rule-script.
     2990       end.
     2991     END.
     2992     WHEN 'CONS':U
     2993     or
     2994     WHEN ('CONS':U + chr(44) + "0")
     2995     or
     2996     WHEN 'GOTO':U
     2997     or
     2998     WHEN ('GOTO':U + chr(44) + "0")
     2999     THEN DO:
     3000        if p-add-option begins 'CONS':U then do:
     3001          v-add-option = 'CONS':U.
     3002        end.
     3003        if p-add-option begins 'GOTO':U then do:
     3004          v-add-option = 'GOTO':U.
     3005        end.
     3006        IF NOT AVAILABLE tt-rule-script THEN DO:
     3007          assign
     3008          v-upper-rule-id = tt-rule.UPPER_rule_id
     3009          v-rule-id = tt-rule.RULE_id
     3010          v-salience = 0
     3011          .
     3012        END.
     3013        ELSE DO:
     3014          if (tt-rule-script.script-type = 'RULE':U
     3015          or tt-rule-script.script-type = 'ELSE-RULE':U)
     3016          AND (p-add-option = 'CONS':U
     3017               or
     3018               p-add-option = 'GOTO':U)
     3019          then do:
     3020            find first buf_tt-rule no-lock where
     3021                      buf_tt-rule.upper_RULE_id = tt-rule-script.RULE_id
     3022                 and  buf_tt-rule.salience = tt-rule-script.salience  .
     3023            assign
     3024            v-upper-rule-id = buf_tt-rule.UPPER_rule_id
     3025            v-rule-id = buf_tt-rule.RULE_id
     3026            v-salience = 0.
     3027          end.
     3028          else do:
     3029            FIND FIRST buf_tt-rule NO-LOCK WHERE
     3030                      buf_tt-rule.RULE_id = tt-rule-script.RULE_id.
     3031           assign
     3032           v-upper-rule-id = buf_tt-rule.UPPER_rule_id.
     3033           v-rule-id = buf_tt-rule.RULE_id.
     3034           v-salience = tt-rule-script.salience + 1
     3035          .
     3036         end.
     3037       eND.
     3038     END.
     3039     WHEN 'COND':U
     3040     or
     3041     WHEN ('COND':U + chr(44) + "0")
     3042     or
     3043     when 'CYCLE-COND':U
     3044     or
     3045     when ('CYCLE-COND':U + chr(44) + "0")
     3046     THEN DO:
     3047        v-add-option = entry(1, p-add-option).
     3048        IF NOT AVAILABLE tt-rule-script THEN DO:
     3049          assign
     3050          v-upper-rule-id = tt-rule.upper_rule_id
     3051          v-rule-id = tt-rule.RULE_id
     3052          v-salience =  0
     3053          .
     3054        END.
     3055        ELSE DO:
     3056          if (tt-rule-script.script-type = 'RULE':U
     3057          or tt-rule-script.script-type = 'ELSE-RULE':U)
     3058          AND (p-add-option = 'COND':U
     3059               or
     3060               p-add-option = 'CYCLE-COND':U)
     3061          then do:
     3062            find first buf_tt-rule no-lock where
     3063                      buf_tt-rule.upper_RULE_id = tt-rule-script.RULE_id
     3064                 and  buf_tt-rule.salience = tt-rule-script.salience  .
     3065            assign
     3066            v-upper-rule-id = buf_tt-rule.UPPER_rule_id
     3067            v-rule-id = buf_tt-rule.RULE_id
     3068            v-salience = 0.
     3069          end.
     3070          else do:
     3071           FIND FIRST buf_tt-rule NO-LOCK WHERE
     3072               buf_tt-rule.RULE_id = tt-rule-script.RULE_id.
     3073           assign
     3074           v-upper-rule-id = buf_tt-rule.UPPER_rule_id
     3075           v-rule-id = buf_tt-rule.RULE_id
     3076           v-salience = tt-rule-script.salience + 1
     3077           .
     3078         end.
     3079       END.
     3080     END.
     3081   END CASE.
     3082    IF p-add-option = 'RULE':U
     3083    or p-add-option = 'ELSE-RULE':U
     3084    THEN DO:
     3085      ERROR-STATUS:ERROR = NO.
     3086    END.
     3087    ELSE DO:
     3088      IF p-move-script-id = 0 THEN DO:
     3089          run rul/updrule.w ( INPUT parparentproc
     3090                                 ,input  'ДОБАВЛЕНИЕ':U
     3091                                 ,INPUT tt-rule.codex_id
     3092                                 ,input tt-rule.root_rule_id
     3093                                 ,input v-upper-rule-id
     3094                                 ,input v-rule-id
     3095                                 ,INPUT v-add-option
     3096                                 ,input v-salience
     3097                                 ,INPUT-OUTPUT v-script-id
     3098                                 ) NO-ERROR.
     3099      END.
     3100      ELSE DO:
     3101        if p-move-script-id = 0
     3102        or p-add-option begins 'CONS':U
     3103        or p-add-option begins 'GOTO':U
     3104        then do:
     3105         v-script-id = next-value(s-rule-script-id, ub).
     3106         CREATE bufm_tt-rule-script.
     3107         ASSIGN
     3108         bufm_tt-rule-script.script_id = v-script-id
     3109         bufm_tt-rule-script.RULE_id = v-rule-id
     3110         bufm_tt-rule-script.root_RULE_id = tt-rule.root_rule_id
     3111         bufm_tt-rule-script.salience = v-salience
     3112         bufm_tt-rule-script.script-type = v-add-option
     3113         bufm_tt-rule-script.LANGUAGE = "ABL"
     3114         bufm_tt-rule-script.script = p-move-script-al
     3115         .
     3116         CREATE bufm_tt-l_rule-script.
     3117         ASSIGN
     3118         bufm_tt-l_rule-script.script_id = v-script-id
     3119         bufm_tt-l_rule-script.RULE_id = v-rule-id
     3120         bufm_tt-l_rule-script.root_RULE_id = tt-rule.root_rule_id
     3121         bufm_tt-l_rule-script.salience = v-salience
     3122         bufm_tt-l_rule-script.script-type = v-add-option
     3123         bufm_tt-l_rule-script.LANGUAGE = "rus"
     3124         bufm_tt-l_rule-script.script = p-move-script-nl
     3125         .
     3126         for each bufm_tt-rule-i-script where
     3127                 bufm_tt-rule-i-script.root_rule_id = tt-rule.root_rule_id
     3128             and bufm_tt-rule-i-script.script_id = p-move-script-id
     3129         on error undo, return error:
     3130           create  buf_tt-rule-i-script.
     3131           buffer-copy bufm_tt-rule-i-script
     3132           except script_id to buf_tt-rule-i-script
     3133           assign
     3134           buf_tt-rule-i-script.script_id = v-script-id
     3135           .
     3136           delete bufm_tt-rule-i-script.
     3137         end.
     3138         RELEASE bufm_tt-l_rule-script.
     3139         RELEASE bufm_tt-rule-script.
     3140       END.
     3141       else do:
     3142         find first bufm_tt-rule-script where
     3143                   bufm_tt-rule-script.script_id = p-move-script-id
     3144               and bufm_tt-rule-script.LANGUAGE = "ABL".
     3145         ASSIGN
     3146         bufm_tt-rule-script.RULE_id = v-rule-id
     3147         bufm_tt-rule-script.salience = v-salience
     3148         .
     3149         find first bufm_tt-l_rule-script where
     3150                   bufm_tt-l_rule-script.script_id = p-move-script-id
     3151               and bufm_tt-l_rule-script.LANGUAGE = "rus".
     3152         ASSIGN
     3153         bufm_tt-l_rule-script.RULE_id = v-rule-id
     3154         bufm_tt-l_rule-script.salience = v-salience
     3155         .
     3156         RELEASE bufm_tt-l_rule-script.
     3157         RELEASE bufm_tt-rule-script.
     3158       end.
     3159     end.
     3160    END.
     3161    IF NOT ERROR-STATUS:ERROR THEN DO:
     3162      repeat preselect each buf_tt-rule-script WHERE
     3163              buf_tt-rule-script.rule_id = v-rule-id:
     3164        find next buf_tt-rule-script.
     3165        if available buf_tt-rule-script
     3166        and  buf_tt-rule-script.salience >= v-salience then do:
     3167          if buf_tt-rule-script.script_id = v-script-id then do:
     3168            next.
     3169          end.
     3170          else do:
     3171            if buf_tt-rule-script.script-type = 'RULE':U
     3172            or buf_tt-rule-script.script-type = 'ELSE-RULE':U
     3173            then do:
     3174              find first buf2_tt-rule where
     3175                        buf2_tt-rule.upper_rule_id = buf_tt-rule-script.rule_id
     3176                   and  buf2_tt-rule.salience = buf_tt-rule-script.salience no-error .
     3177            end.
     3178            ASSIGN
     3179            buf_tt-rule-script.salience = buf_tt-rule-script.salience + 1
     3180            .
     3181            if available buf2_tt-rule then do:
     3182             ASSIGN
     3183             buf2_tt-rule.salience = buf2_tt-rule.salience + 1
     3184             .
     3185             release buf2_tt-rule.
     3186            end.
     3187          end.
     3188        end.
     3189      END.
     3190      RUN fill-tt-tables IN THIS-PROCEDURE (  INPUT tt-rule.RULE_id
     3191                                           ,INPUT tt-rule.root_RULE_id
     3192                                           ,INPUT-OUTPUT v-level
     3193                                           ,INPUT "") no-error.
     3194   END.
     3195   ASSIGN
     3196   add-option = '':U.
     3197   RUN openbr IN THIS-PROCEDURE NO-ERROR.
     3198   REPOSITION br-rule-script TO RECID v-rec NO-ERROR.
     3199   APPLY "VALUE-CHANGED" to browse br-rule-script.
     3200   END PROCEDURE.
     3201   PROCEDURE proc-b-del :
     3202   define input parameter p-rule-id as integer no-undo .
     3203   define input parameter p-script-id as integer no-undo .
     3204   define variable v-delete-rule as logical no-undo .
     3205   define buffer buf_tt-rule for tt-rule.
     3206   define buffer buf2_tt-rule for tt-rule.
     3207   DEFINE BUFFER buf_tt-rule-script FOR tt-rule-script.
     3208   DEFINE BUFFER buf2_tt-rule-script FOR tt-rule-script.
     3209   define buffer buf_tt-rule-i-script for tt-rule-i-script.
     3210   do
     3211   on error undo, return error
     3212   :
     3213     find first buf_tt-rule where buf_tt-rule.rule_id = p-rule-id.
     3214     find first buf_tt-rule-script where
     3215               buf_tt-rule-script.script_id = p-script-id.
     3216     if buf_tt-rule-script.script-type = 'RULE':U
     3217     or buf_tt-rule-script.script-type = 'ELSE-RULE':U
     3218     then do:
     3219        find first buf2_tt-rule where
     3220                 buf2_tt-rule.upper_rule_id = p-rule-id
     3221            and  buf2_tt-rule.salience = buf_tt-rule-script.salience.
     3222        v-delete-rule = yes.
     3223     end.
     3224     if (buf_tt-rule-script.script-type = 'COND':U
     3225         or
     3226         buf_tt-rule-script.script-type = 'CYCLE-COND':U)
     3227     and buf_tt-rule-script.rule_id <> buf_tt-rule-script.root_rule_id
     3228     then do:
     3229       for each buf2_tt-rule-script where
     3230               buf2_tt-rule-script.rule_id = buf_tt-rule-script.rule_id
     3231       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3232       :
     3233         if buf2_tt-rule-script.script_id = p-script-id
     3234         or buf2_tt-rule-script.script-type = 'RULE':U
     3235         or buf2_tt-rule-script.script-type = 'ELSE-RULE':U
     3236         or buf2_tt-rule-script.salience < buf_tt-rule-script.salience
     3237         or buf2_tt-rule-script.salience >  buf_tt-rule-script.salience + 1
     3238         then do:
     3239           next.
     3240         end.
     3241         message
     3242         substitute("Вы пытаетесь удалить условие (1-ю строку) подправила  &1, которое содержит другие строки(&2)&3" +
     3243                    "это недопустимо"
     3244                    ,buf_tt-rule-script.rule_id
     3245                    ,buf2_tt-rule-script.script_id
     3246                    , chr(10))
     3247         view-as alert-box error .
     3248         undo, return error .
     3249       end.
     3250     end.
     3251     FIND last buf2_tt-rule-script WHERE
     3252         buf2_tt-rule-script.root_RULE_id  = buf_tt-rule.RULE_id
     3253     AND buf2_tt-rule-script.LANGUAGE = rs-language
     3254     AND ((buf2_tt-rule-script.level = buf_tt-rule.level
     3255     AND buf2_tt-rule-script.salience < buf_tt-rule-script.salience)
     3256         OR
     3257         buf2_tt-rule-script.level < buf_tt-rule.level ) NO-ERROR.
     3258     for each buf_tt-rule-i-script where
     3259             buf_tt-rule-i-script.root_rule_id = tt-rule.rule_id
     3260         and buf_tt-rule-i-script.script_id = p-script-id
     3261     on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3262     :
     3263       delete buf_tt-rule-i-script.
     3264     end.
     3265     for each buf_tt-rule-script where
     3266             buf_tt-rule-script.script_id = p-script-id
     3267     on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3268     :
     3269       DELETE buf_tt-rule-script.
     3270     end.
     3271     if v-delete-rule then do:
     3272       delete buf2_tt-rule.
     3273     end.
     3274   end.
     3275   RUN OpenBr IN THIS-PROCEDURE NO-ERROR.
     3276   IF AVAILABLE buf2_tt-rule-script  THEN DO:
     3277     REPOSITION br-rule-script TO RECID RECID(buf2_tt-rule-script) NO-ERROR.
     3278   END.
     3279   END PROCEDURE.
     3280   PROCEDURE proc-b-move :
     3281   define input parameter p-rule-id as integer no-undo .
     3282   define input parameter p-script-id as integer no-undo .
     3283   FIND FIRST MOVE_tt-rule-script WHERE
     3284             recid(MOVE_tt-rule-script) = RECID(tt-rule-script).
     3285   IF MOVE_tt-rule-script.script-type = 'RULE':U
     3286   or MOVE_tt-rule-script.script-type = 'ELSE-RULE':U THEN DO:
     3287     MESSAGE
     3288     substitute("Нельзя переносить скрипты типа &1", MOVE_tt-rule-script.script-type)
     3289     VIEW-AS ALERT-BOX ERROR.
     3290     RELEASE MOVE_tt-rule-script.
     3291     RETURN ERROR.
     3292   END.
     3293   HIDE
     3294   b-add IN FRAME Dialog-Frame
     3295   b-del
     3296   b-params
     3297   b-move
     3298   IN FRAME Dialog-Frame.
     3299   ENABLE
     3300   b-sel
     3301   WITH FRAME Dialog-Frame.
     3302   END PROCEDURE.
     3303   PROCEDURE proc-b-params :
     3304   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     3305   define variable v-return-value as character no-undo .
     3306   DEFINE BUFFER buf_tt-ruledict-param FOR tt-ruledict-param.
     3307   IF p-mode = 'ПРОСМОТР':U THEN DO:
     3308     FIND FIRST buf_tt-ruledict-param NO-ERROR.
     3309     IF NOT AVAILABLE buf_tt-ruledict-param THEN DO:
     3310       MESSAGE
     3311       "У этого правила нет параметров"
     3312       VIEW-AS ALERT-BOX.
     3313       RETURN.
     3314     END.
     3315   END.
     3316   ELSE DO:
     3317     v-param-num-list = '':U.
     3318   END.
     3319   run rul/ruledict-param-s.w ( INPUT parparentproc
     3320                               ,input this-procedure:handle
     3321                               ,INPUT (IF p-mode = 'ИЗМЕНЕНИЕ':U
     3322                                       OR p-mode = 'ДОБАВЛЕНИЕ':U
     3323                                       THEN "b-add"
     3324                                       ELSE "":U)
     3325                               ,INPUT (if p-mode = 'ПРОСМОТР':U
     3326                                       then "entry-id"
     3327                                       else 'ИЗМЕНЕНИЕ':U)
     3328                               ,INPUT (if p-mode = 'ИЗМЕНЕНИЕ':U
     3329                                       or p-mode = 'ПРОСМОТР':U
     3330                                       then locked_ruledict.entry-id
     3331                                       else 0)
     3332                               ,input 'rule':U
     3333                               ,INPUT-OUTPUT v-rid-list) NO-ERROR.
     3334   IF ERROR-STATUS:ERROR THEN DO:
     3335      UNDO, RETURN ERROR.
     3336   END.
     3337   v-return-value = return-value .
     3338   if (p-mode = 'ИЗМЕНЕНИЕ':U
     3339   or p-mode = 'ДОБАВЛЕНИЕ':U)
     3340   and v-return-value <> "quit" then do:
     3341     FOR EACH tt-ruledict-param:
     3342       IF LOOKUP(string(tt-ruledict-param.param-num), v-param-num-list) = 0 THEN DO:
     3343           DELETE tt-ruledict-param.
     3344       END.
     3345     END.
     3346   end.
     3347   END PROCEDURE.
     3348   PROCEDURE proc-b-print :
     3349   run waitfram-show in this-procedure ( "Ждите..." ).
     3350   output to value (string(p-rule-id, "999999999") + ".rul-str").
     3351   DEFINE BUFFER buf_tt-rule-script FOR tt-rule-script.
     3352   for each buf_tt-rule-script no-lock where
     3353           buf_tt-rule-script.root_rule_id = p-rule-id
     3354       and buf_tt-rule-script.language = rs-language
     3355      by buf_tt-rule-script.gen-order:
     3356     export
     3357     buf_tt-rule-script.rule_id    "~t"
     3358     buf_tt-rule-script.gen-order        "~t"
     3359     buf_tt-rule-script.level            "~t"
     3360     buf_tt-rule-script.upper_rule_id    "~t"
     3361     buf_tt-rule-script.script-type      "~t"
     3362     buf_tt-rule-script.script_id        "~t"
     3363     buf_tt-rule-script.salience         "~t"
     3364     (fill(chr(32), buf_tt-rule-script.level * 2)  + buf_tt-rule-script.script) skip.
     3365   end.
     3366   output close.
     3367   run waitfram-hide in this-procedure .
     3368   END PROCEDURE.
     3369   PROCEDURE proc-cancel-move :
     3370   move-option = '':U.
     3371   RELEASE MOVE_tt-rule-script.
     3372   HIDE
     3373   b-sel IN FRAME Dialog-Frame.
     3374   ENABLE
     3375   b-add
     3376   b-del
     3377   b-chg
     3378   b-params
     3379   b-move
     3380   WITH FRAME Dialog-Frame.
     3381   END PROCEDURE.
     3382   PROCEDURE proc-save :
     3383   DEFINE VARIABLE v-rec AS RECID NO-UNDO.
     3384   IF p-mode = 'ПРОСМОТР':U THEN DO:
     3385     RETURN error.
     3386   END.
     3387   IF p-mode = 'ИЗМЕНЕНИЕ':U THEN DO:
     3388     v-rec = p-rec.
     3389   END.
     3390   ASSIGN
     3391   FRAME Dialog-Frame
     3392   tt-rule.NAME
     3393   tt-rule.codex_id
     3394   tt-rule.reusable-params
     3395   tt-rule.documentation
     3396   tt-rule.image-file-name
     3397   t-hidden
     3398   tt-rule.hidden-content = (IF t-hidden = YES THEN 1 ELSE 0)
     3399   .
     3400   run rul/rule1.p ( INPUT (p-mode + chr(44) + string(v-is-admin-mode))
     3401                   ,INPUT NO
     3402                   ,INPUT-OUTPUT v-rec
     3403                   ,INPUT tt-rule.rule_id
     3404                   ,INPUT tt-rule.codex_id
     3405                   ,INPUT tt-rule.upper_rule_id
     3406                   ,INPUT tt-rule.root_rule_id
     3407                   ,INPUT tt-rule.reusable-params
     3408                   ,INPUT tt-rule.salience
     3409                   ,INPUT tt-rule.name
     3410                   ,INPUT tt-rule.documentation
     3411                   ,input tt-rule.no-save-mode
     3412                   ,INPUT tt-rule.hidden-content
     3413                   ,input tt-rule.image-file-name
     3414                   ,input table tt-rule
     3415                   ,input table tt-rule-script
     3416                   ,input table tt-rule-i-script
     3417                   ,input table tt-ruledict-param
     3418                 ) no-error.
     3419   if error-status:error then do:
     3420   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3421   define variable fh as widget-handle no-undo .
     3422   define variable hh as widget-handle no-undo .
     3423   define variable rv as character no-undo .
     3424   assign
     3425   rv = entry(1, return-value , chr(4)).
     3426   if rv <> "":U then do:
     3427     assign
     3428     fh = frame Dialog-Frame:first-child
     3429     hh = fh:first-child
     3430     .
     3431     do while valid-handle(hh):
     3432       if hh:name = rv then do:
     3433         APPLY "ENTRY" to hh.
     3434         undo ,
     3435         return error.
     3436       end.
     3437       hh = hh:next-sibling.
     3438     end.
     3439   end.
     3440     undo, return error.
     3441   end.
     3442   p-rec = v-rec.
     3443   END PROCEDURE.
     3444   PROCEDURE save-tt-ruledict-param :
     3445   DEFINE INPUT PARAMETER p-bh AS HANDLE NO-UNDO.
     3446   DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
     3447   FIND FIRST tt-ruledict-param WHERE
     3448              tt-ruledict-param.param-num = p-bh::param-num NO-ERROR.
     3449   IF NOT AVAILABLE tt-ruledict-param THEN DO:
     3450      CREATE tt-ruledict-param.
     3451   END.
     3452   ASSIGN
     3453   glog = BUFFER tt-ruledict-param:handle:BUFFER-Copy( p-bh) NO-ERROR.
     3454   IF NOT glog THEN DO:
     3455     UNDO, RETURN ERROR substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     3456   END.
     3457   v-param-num-list = v-param-num-list + chr(44) + STRING( tt-ruledict-param.param-num).
     3458   END PROCEDURE.
     3459   PROCEDURE switch-rule :
     3460   IF NOT AVAILABLE tt-rule-script
     3461   OR not (tt-rule-script.script-type = 'COND':U
     3462          or
     3463          tt-rule-script.script-type = 'CYCLE-COND':U) THEN DO:
     3464     MENU-ITEM m_rule:SENSITIVE IN MENU menu-b-add = NO .
     3465   END.
     3466   ELSE DO:
     3467      MENU-ITEM m_rule:SENSITIVE IN MENU menu-b-add = yes .
     3468   END.
     3469   IF NOT AVAILABLE tt-rule-script
     3470   OR not tt-rule-script.script-type = 'RULE':U then do:
     3471     MENU-ITEM m_else-rule:SENSITIVE IN MENU menu-b-add = NO .
     3472   end.
     3473   else do:
     3474     MENU-ITEM m_else-rule:SENSITIVE IN MENU menu-b-add = yes .
     3475   end.
     3476   IF AVAILABLE tt-rule-script
     3477   AND (tt-rule-script.script-type = 'RULE':U
     3478   or  tt-rule-script.script-type = 'ELSE-RULE':U )
     3479   THEN DO:
     3480     ASSIGN
     3481     MENU-ITEM m_cond:SENSITIVE IN MENU menu-b-add = YES
     3482     MENU-ITEM m_cons:SENSITIVE IN MENU menu-b-add = YES.
     3483     MENU-ITEM m_goto:SENSITIVE IN MENU menu-b-add = YES.
     3484     MENU-ITEM m_script:SENSITIVE IN MENU menu-b-sel = YES.
     3485   END.
     3486   ELSE DO:
     3487     MENU-ITEM m_cond:SENSITIVE IN MENU menu-b-add = NO .
     3488     MENU-ITEM m_cons:SENSITIVE IN MENU menu-b-add = NO .
     3489     MENU-ITEM m_goto:SENSITIVE IN MENU menu-b-add = NO .
     3490     MENU-ITEM m_script:SENSITIVE IN MENU menu-b-sel = NO.
     3491   END.
     3492   END PROCEDURE.
