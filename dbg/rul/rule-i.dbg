     1019   ON VALUE-CHANGED OF T-hidden IN FRAME Dialog-Frame
     1020   DO:
     1021     ASSIGN
     1022     t-hidden.
     1023     CASE t-hidden:
     1024       WHEN YES THEN DO:
     1025           DISABLE
     1026           b-add
     1027           b-chg
     1028           b-move
     1029           b-del
     1030           b-text
     1031           WITH FRAME Dialog-Frame.
     1032       END.
     1033       WHEN NO THEN DO:
     1034         IF p-mode <> 'ПРОСМОТР':U THEN DO:
     1035           enable
     1036           b-add
     1037           b-chg
     1038           b-move
     1039           b-del
     1040           b-text
     1041           WITH FRAME Dialog-Frame.
     1042         END.
