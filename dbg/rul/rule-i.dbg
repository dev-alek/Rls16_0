      520            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      521            TITLE "Правило"
      522            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      523   ASSIGN
      524          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      525          FRAME Dialog-Frame:HIDDEN           = TRUE.
      526   ASSIGN
      527          B-add:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-B-add:HANDLE.
      528   ASSIGN
      529          b-sel:HIDDEN IN FRAME Dialog-Frame           = TRUE
      530          b-sel:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-b-sel:HANDLE.
      531   ASSIGN
      532          br-rule-script:COLUMN-RESIZABLE IN FRAME Dialog-Frame       = TRUE.
      533   ON END-ERROR OF FRAME Dialog-Frame
      534   DO:
      535     DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
      536     DEFINE BUFFER buf_tt-rule-script FOR tt-rule-script.
      537     IF p-mode = 'ДОБАВЛЕНИЕ':U THEN do:
      538       FIND FIRST buf_tt-rule-script NO-LOCK WHERE
      539                   buf_tt-rule-script.RULE_id = tt-rule.RULE_id NO-ERROR.
      540       IF AVAILABLE buf_tt-rule-script THEN DO:
      541         MESSAGE
      542         "Выйти из режима редактирования и не сохранять правило"
      543         VIEW-AS ALERT-BOX ERROR BUTTONS YES-NO UPDATE glog.
      544         IF NOT glog  THEN DO:
      545            RETURN NO-APPLY.
      546         END.
      547       END.
      548     END.
      549   END.
      550   ON GO OF FRAME Dialog-Frame
      551   DO:
      552     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
      553     IF ERROR-STATUS:ERROR THEN DO:
      554       RETURN NO-APPLY.
      555     END.
      556   END.
      557   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      558   DO:
      559     APPLY "END-ERROR":U TO SELF.
      560   END.
      561   ON CHOOSE OF B-add IN FRAME Dialog-Frame
      562   DO:
      563    IF add-option = '':U  THEN DO:
      564       run gbl/pop-up.p ( INPUT self :handle, input no ) no-error.
      565       if error-status :error then do: return no-apply. end.
      566     end.
      567     if add-option = "":U then do:
      568         return no-apply.
      569     end.
      570     RUN proc-b-add IN THIS-PROCEDURE ( INPUT add-option
      571                                       ,INPUT '':U
      572                                       ,INPUT '':U
      573                                       ,input 0
      574                                       ,input 0
      575                                       ,input 0
      576                                       ) NO-ERROR.
      577     IF error-status:ERROR THEN DO:
      578         add-option = '':u.
      579         RETURN NO-APPLY.
      580     END.
      581     add-option = '':u.
      582   END.
      583   ON CHOOSE OF B-chg IN FRAME Dialog-Frame
      584   DO:
      585     if not available tt-rule-script then return no-apply.
      586     IF tt-rule.codex_id = 0  THEN DO:
      587        MESSAGE
      588        "Для редактирования необходима сначала выбрать кодекс правил"
      589         VIEW-AS ALERT-BOX ERROR.
      590        RETURN NO-APPLY.
      591     END.
      592     run rul/updrule.w (
      593                         INPUT parparentproc
      594                        ,input 'ИЗМЕНЕНИЕ':U
      595                        ,INPUT tt-rule.codex_id
      596                        ,input tt-rule.root_rule_id
      597                        ,input tt-rule.upper_rule_id
      598                        ,input tt-rule-script.rule_id
      599                        ,input tt-rule-script.script-type
      600                        ,input tt-rule-script.salience
      601                        ,input-output tt-rule-script.script_id
      602                        ) no-error.
      603     if error-status:error then do:
      604       return no-apply.
      605     end.
      606     br-rule-script:refresh().
      607   END.
      608   ON CHOOSE OF B-codex IN FRAME Dialog-Frame
      609   DO:
      610   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
      611   DEFINE BUFFER buf_ruleset FOR ub.ruleset.
      612   if tt-rule.codex_id <> 0 then do:
      613     find first buf_ruleset no-lock where
      614             buf_ruleset.codex_id = tt-rule.codex_id
      615         and buf_ruleset.ruleset_id = 0 .
      616     v-rid-list = string(recid(buf_ruleset)).
      617   end.
      618   run rul/ruleset-s.w ( INPUT parparentproc
      619                        ,INPUT 'b-sel':U
      620                        ,input "only-codex"
      621                        ,input 0
      622                        ,INPUT-OUTPUT v-rid-list) NO-ERROR.
      623   IF v-rid-list <> '':U THEN DO:
      624      FIND FIRST buf_ruleset NO-LOCK WHERE
      625               recid(buf_ruleset) = INTEGER(v-rid-list) NO-ERROR.
      626     IF NOT AVAILABLE buf_RULESET THEN RETURN NO-APPLY.
      627     ASSIGN
      628     tt-rule.codex_id = buf_ruleset.codex_id.
      629     DISPLAY
      630     tt-rule.CODEx_id
      631     WITH FRAME Dialog-Frame.
      632   END.
      633   END.
      634   ON CHOOSE OF B-del IN FRAME Dialog-Frame
      635   DO:
      636    DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
      637     IF NOT AVAILABLE tt-rule-script THEN RETURN NO-APPLY.
      638     MESSAGE
      639     substitute("Вы уверены, что хотите удалить данный скрипт&1"  +
      640                "&2&1" +
      641                "код подправила &3, уровень &4 тип скрипта &5 код скрипта &6 порядок &7"
      642                , chr(10)
      643                ,tt-rule-script.script
      644                ,tt-rule-script.rule_id
      645                ,tt-rule-script.level
      646                ,tt-rule-script.script-type
      647                ,tt-rule-script.script_id
      648                ,tt-rule-script.salience  )
      649     VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO  UPDATE glog.
      650     IF not glog THEN RETURN NO-APPLY.
      651     RUN proc-b-del IN THIS-PROCEDURE ( input tt-rule-script.rule_id
      652                                       ,input tt-rule-script.script_id) NO-ERROR.
      653     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      654   END.
      655   ON CHOOSE OF b-image IN FRAME Dialog-Frame
      656   DO:
      657    define variable v_os-file   AS CHAR NO-UNDO INIT "".
      658   define variable ll_commit AS LOG    NO-UNDO INIT NO.
      659   define variable file-name        as character no-undo .
      660   define variable v-full-path        as character no-undo .
      661   define variable v-path             as character no-undo .
      662   define variable v-file-name        as character no-undo .
      663   define variable v-file-name-no-ext as character no-undo .
      664   define variable v-file-name-ext    as character no-undo .
      665   define variable glog as logical no-undo .
      666     SYSTEM-DIALOG GET-FILE v_os-file
      667     TITLE "Задайте файла изображения"
      668     FILTERS
      669       " Все bmp файлы (*.bmp) " "*.bmp",
      670       " Все ico файлы (*.ico) " "*.ico",
      671       " Все gif файлы (*.gif) " "*.gif",
      672       " Все jpg файлы (*.jpg) " "*.jpg",
      673       " Все файлы (*.*) "                      "*.*"
      674     INITIAL-FILTER 1
      675     DEFAULT-EXTENSION ".xml"
      676     USE-FILENAME
      677     MUST-EXIST
      678     UPDATE ll_commit
      679     .
      680     IF ll_commit <> YES THEN do:
      681         RETURN NO-APPLY.
      682     end.
      683     IF v_os-file = PROGRAM-NAME( 1 ) THEN DO:
      684         BELL.
      685         MESSAGE "Рекурсия!" VIEW-AS ALERT-BOX ERROR.
      686         RETURN NO-APPLY.
      687     END.
      688     ASSIGN file-name = ( IF SEARCH( v_os-file ) = ? THEN v_os-file ELSE SEARCH( v_os-file ) ).
      689     run gbl/filename.p (
      690                     input  v_os-file
      691                     ,output v-full-path
      692                     ,output v-path
      693                     ,output v-file-name
      694                     ,output v-file-name-no-ext
      695                     ,output v-file-name-ext
      696                     ) no-error .
      697     if error-status:error  = ? then do:
      698       return no-apply.
      699     end.
      700     assign
      701     file-name = v-full-path.
      702     DISPlay
      703     file-name @ tt-rule.image-file-name WITH FRAME Dialog-Frame.
      704   END.
      705   ON CHOOSE OF b-move IN FRAME Dialog-Frame
      706   DO:
      707     IF NOT AVAILABLE tt-rule-script THEN DO:
