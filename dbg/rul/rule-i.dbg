      728   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
      729   DO:
      730     DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
      731     DEFINE VARIABLE v-cont AS LOGICAL NO-UNDO.
      732     IF NOT AVAILABLE tt-rule-script THEN DO:
      733     END.
      734     IF RECID(tt-rule-script) = recid(move_tt-rule-script) THEN DO:
      735        MESSAGE
      736        "Используйте стрелки"
      737        VIEW-AS ALERT-BOX.
      738     END.
      739     ELSE DO:
      740      IF move-option = '':U THEN DO:
      741         run gbl/pop-up.p ( INPUT b-sel:handle, input no ) no-error.
      742         IF ERROR-STATUS:ERROR
      743         OR move-option = '':U THEN DO:
      744         END.
      745         ELSE DO:
      746            v-cont = YES.
      747         END.
      748      END.
      749      else do:
      750        v-cont = yes.
      751      end.
      752      IF v-cont = YES THEN
      753         MESSAGE
      754         substitute("Вы уверены, что хотите перенести скрипт&1"  +
      755                    "&2&1" +
      756                    "код подправила &3, уровень &4 тип скрипта &5 код скрипта &6 порядок &7&1"
      757                    , chr(10)
      758                    ,move_tt-rule-script.script
      759                    ,move_tt-rule-script.rule_id
      760                    ,move_tt-rule-script.level
      761                    ,move_tt-rule-script.script-type
      762                    ,move_tt-rule-script.script_id
      763                    ,move_tt-rule-script.salience  )
      764         SUBSTITUTE("после скрипта&1" +
      765                    "&2&1" +
      766                    "код подправила &3, уровень &4 тип скрипта &5 код скрипта &6 порядок &7"
      767                    , chr(10)
      768                    ,tt-rule-script.script
      769                    ,tt-rule-script.rule_id
      770                    ,tt-rule-script.level
      771                    ,tt-rule-script.script-type
      772                    ,tt-rule-script.script_id
      773                    ,tt-rule-script.salience  )
      774         VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO  UPDATE glog.
      775         IF not glog THEN do:
      776           v-cont = NO.
      777         END.
      778     END.
      779     IF v-cont = YES then DO:
      780       RUN proc-aff-move IN THIS-PROCEDURE ( input move_tt-rule-script.rule_id
      781                                                ,input move_tt-rule-script.script_id
      782                                                ,INPUT tt-rule-script.RULE_id
      783                                                ,INPUT tt-rule-script.script_id
      784                                                ,INPUT move-option) NO-ERROR.
      785     END.
      786     RUN proc-cancel-move IN THIS-PROCEDURE.
      787   END.
