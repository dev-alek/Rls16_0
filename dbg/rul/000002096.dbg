     3684       .
     3685     end.
     3686     if v-jj = 2 then do:
     3687       if p-waiting-flag <> ? then leave  _jj.
     3688       assign
     3689       v-waiting-stfl = p-waiting-status + chr(4) + string(no)
     3690       .
     3691     end.
     3692     assign
