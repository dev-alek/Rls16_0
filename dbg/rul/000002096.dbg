     4052   function context_begin-esys-command return logical
     4053   (
     4054       input p-esys-id-list as character
     4055      ,input-output p-esys-cmd-proc-handle as handle
     4056      ,output p-esys-cmd-code as integer
     4057   ):
     4058      if not valid-handle(p-esys-cmd-proc-handle )
     4059      then do:
     4060        run nws/cmd-bush.p persistent set p-esys-cmd-proc-handle no-error .
     4061        if error-status :error
     4062        then do:
     4063           delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( substitute("&1 &2 &3&4Ошибка при запуске процедуры cmd-bush.p&4" +
     4064                                              "&5&4&6"
     4065                                              ,vss-workfile
     4066                                              ,vss-revision
     4067                                              ,vss-description
     4068                                              ,chr(10)
     4069                                              ,error-status:get-message(1)
     4070                                              ,return-value )).
     4071        end.
     4072        run begin-create-command in p-esys-cmd-proc-handle
     4073          (input 'cmd-esys-general':U
     4074          ,input p-esys-id-list
     4075          ,output p-esys-cmd-code
     4076          ) no-error.
     4077        if error-status :error
     4078        then do:
     4079          delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при создании команды &1&2&3&1&4"
     4080                                                           , 'cmd-esys-general':U
     4081                                                           , error-status:get-message(1)
     4082                                                           , return-value
     4083                                                           )).
     4084          return no .
     4085        end.
     4086        return yes.
     4087      end.
     4088   end.
     4089   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4090   function context_send-esys-command return int64
     4091   (
     4092       input p-esys-id-list as character
     4093      ,input p-esys-cmd-proc-handle as handle
     4094      ,input p-esys-cmd-code as integer
     4095      ,input p-user-id as character
     4096   ):
     4097      define variable v-dmp-ord-int64 as int64 no-undo .
     4098      if valid-handle(p-esys-cmd-proc-handle )
     4099      then do:
     4100         run send-command-esys in p-esys-cmd-proc-handle
     4101             (input p-esys-cmd-code
     4102             ,input p-esys-id-list
     4103             ,input p-user-id
     4104             ,output v-dmp-ord-int64
     4105             ) no-error.
     4106         if error-status :error
     4107         then do:
     4108            delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при отсылке во внешнюю систему &1 команды с кодом &2&3&4&3&5"
     4109                                                           , p-esys-id-list
     4110                                                           , p-cmd-code
     4111                                                           , chr(10)
     4112                                                           , error-status:get-message(1)
     4113                                                           , return-value
     4114                                                           )).
     4115            return 0.
     4116         end.
     4117         delete procedure p-esys-cmd-proc-handle no-error.
     4118         return v-dmp-ord-int64.
     4119      end.
     4120      else do:
     4121         delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при отсылке во внешнюю систему &1 команды с кодом &2&3&4&3&5"
     4122                                                       , p-esys-id-list
     4123                                                       , p-cmd-code
     4124                                                       , chr(10)
     4125                                                       , error-status:get-message(1)
     4126                                                       , return-value
     4127                                                       )).
     4128         return 0 .
     4129      end.
     4130   end.
     4131   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
