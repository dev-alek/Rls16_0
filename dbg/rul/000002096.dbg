     3645                    'разрешен':U + chr(4) + string(no) + chr(3) +
     3646                    'факт':U +      chr(4) + string(yes)
     3647   .
     3648   assign
     3649   v-stat-list[lookup('vt':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 2] =
     3650                    '' +           chr(4) + string(no) + chr(3) +
     3651                    'запрос':U +   chr(4) + string(no) + chr(3) +
     3652                    'запрос':U +   chr(4) + string(yes) + chr(3) +
     3653                    'накл':U +      chr(4) + string(no) + chr(3) +
     3654                    'накл':U +      chr(4) + string(yes) + chr(3) +
     3655                    'разрешен':U + chr(4) + string(yes) + chr(3) +
     3656                    'разрешен':U + chr(4) + string(no) + chr(3) +
