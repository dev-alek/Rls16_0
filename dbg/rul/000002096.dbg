     1837     do
     1838     on error undo, return error return-value
     1839     :
     1840       define input parameter p-doc-code like ub.ord-line-attr.doc-code   no-undo .
     1841       define input parameter p-gds-code like ub.ord-line-attr.gds-code   no-undo .
     1842       define input parameter p-code     like ub.ord-line-attr.attr-code  no-undo .
     1843       define output parameter p-exist   as logical  no-undo .
     1844       define buffer buf_ord-line-attr for ub.ord-line-attr .
