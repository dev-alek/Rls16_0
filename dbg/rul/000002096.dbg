     3666   v-stat-list[lookup('rs':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] =
     3667                    '' +           chr(4) + string(no) + chr(3) +
     3668                    'касс':U + chr(4) + string(no) + chr(3) +
     3669                    'касс':U + chr(4) + string(yes) + chr(3) +
     3670                    'нередакт':U + chr(4) + string(yes) + chr(3) +
