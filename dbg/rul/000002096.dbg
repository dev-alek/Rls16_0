     3544   procedure stat-graf-trn :
     3545   define input parameter  p-oldbh              as handle no-undo .
     3546   define input parameter  p-newbh              as handle no-undo .
     3547   define input parameter  p-changed-fields     as character no-undo .
     3548   define input parameter  p-waiting-status     as character no-undo .
     3549   define input parameter  p-waiting-flag       as logical no-undo .
     3550   define output parameter p-is-waiting-status  as logical no-undo .
     3551   define output parameter p-direction          as character no-undo .
     3552   define variable v-doc-code as character no-undo .
     3553   define variable v-ext-doc-type as character no-undo .
     3554   define variable v-stat-list as character no-undo extent 84.
     3555   define variable v-stat-list-all as character no-undo .
     3556   define variable v-jj as integer no-undo .
     3557   define variable v-ii as integer no-undo .
     3558   define variable v-old-stfl as character no-undo .
     3559   define variable v-new-stfl as character no-undo .
     3560   define variable v-waiting-stfl as character no-undo .
     3561   define variable v-old-stfl-i as integer no-undo .
     3562   define variable v-new-stfl-i as integer no-undo .
     3563   define variable v-waiting-stfl-i as integer no-undo .
     3564   do
     3565   on error  undo, return error substitute( "&1. &2&3&4", vss-include-info23, return-value, chr(10), error-status :get-message (1))
     3566   :
     3567   if p-newbh = ?  then do:
     3568     v-doc-code = p-oldbh::doc-code .
     3569     v-ext-doc-type = p-oldbh::ext-doc-type .
     3570   end.
     3571   else do:
     3572     v-doc-code     = p-newbh::doc-code .
     3573     v-ext-doc-type = p-newbh::ext-doc-type .
     3574   end.
     3575   assign
     3576   v-stat-list-all =
     3577                    '' +           chr(4) + string(no) + chr(3) +
     3578                    'запрос':U +   chr(4) + string(no) + chr(3) +
     3579                    'запрос':U +   chr(4) + string(yes) + chr(3) +
     3580                    'накл':U +      chr(4) + string(no) + chr(3) +
     3581                    'накл':U +      chr(4) + string(yes) + chr(3) +
     3582                    'разрешен':U + chr(4) + string(no) + chr(3) +
     3583                    'разрешен':U + chr(4) + string(yes) + chr(3) +
     3584                    'факт':U +      chr(4) + string(yes)
     3585   .
     3586   assign
     3587   v-stat-list[lookup('ie':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] = v-stat-list-all
     3588   v-stat-list[lookup('ee':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] = v-stat-list-all
     3589   v-stat-list[lookup('ee':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 2] =
     3590                                                                    '' +           chr(4) + string(no) + chr(3) +
     3591                                                                    'готов':U     + chr(4) + string(yes)
     3592   v-stat-list[lookup('ee':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 1] =
     3593                                                                    '' +           chr(4) + string(no) + chr(3) +
     3594                                                                    'отказ':U  +  chr(4) + string(yes)
     3595   v-stat-list[lookup('ep':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] = v-stat-list-all
     3596   v-stat-list[lookup('re':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] = v-stat-list-all
     3597   v-stat-list[lookup('we':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] = v-stat-list-all
     3598   v-stat-list[lookup('vp':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] =
     3599                                                                   ''              + chr(4) + string(no) + chr(3) +
     3600                                                                   'накл':U         + chr(4) + string(no) + chr(3) +
     3601                                                                   'факт':U         + chr(4) + string(yes)
     3602   v-stat-list[lookup('iv':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] = v-stat-list-all
     3603   v-stat-list[lookup('ev':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] = v-stat-list-all
     3604   v-stat-list[lookup('io':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] = v-stat-list-all
