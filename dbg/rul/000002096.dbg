     3703       v-old-stfl-i = lookup(v-old-stfl, v-stat-list[v-ii], chr(3))
     3704       v-new-stfl-i = lookup(v-new-stfl, v-stat-list[v-ii], chr(3))
     3705       .
     3706       if v-waiting-stfl-i = 0
     3707       or v-old-stfl-i = 0
     3708       or v-new-stfl-i = 0
     3709       then do:
     3710         next _ii.
     3711       end.
     3712       if v-old-stfl-i < v-waiting-stfl-i
     3713       and v-new-stfl-i = v-waiting-stfl-i then do:
     3714         assign
     3715         p-is-waiting-status = yes
     3716         p-direction = '<закрытие документа>':U + chr(4) + "to".
     3717         return.
     3718       end.
     3719       if v-old-stfl-i < v-waiting-stfl-i
     3720       and v-new-stfl-i > v-waiting-stfl-i then do:
     3721         assign
     3722         p-is-waiting-status = yes
     3723         p-direction = '<закрытие документа>':U + chr(4) + "to-up".
     3724         return.
     3725       end.
     3726       if v-new-stfl-i = v-waiting-stfl-i
     3727       and v-old-stfl-i > v-waiting-stfl-i then do:
     3728         assign
     3729         p-is-waiting-status = yes
     3730         p-direction = '<открытие документа>':U + chr(4) + "to".
     3731         return.
     3732       end.
     3733       if v-new-stfl-i < v-waiting-stfl-i
     3734       and v-old-stfl-i > v-waiting-stfl-i then do:
     3735         assign
     3736         p-is-waiting-status = yes
     3737         p-direction = '<открытие документа>':U + chr(4) + "to-down".
     3738         return.
     3739       end.
     3740       if v-old-stfl-i = v-waiting-stfl-i
     3741       and v-new-stfl-i > v-waiting-stfl-i then do:
     3742         assign
     3743         p-is-waiting-status = yes
     3744         p-direction = '<закрытие документа>':U + chr(4) + "from".
     3745         return.
     3746       end.
     3747       if v-old-stfl-i = v-waiting-stfl-i
     3748       and v-new-stfl-i < v-waiting-stfl-i then do:
     3749         assign
     3750         p-is-waiting-status = yes
     3751         p-direction = '<открытие документа>':U + chr(4) + "from".
     3752         return.
     3753       end.
     3754     end.
     3755   end.
     3756   end.
     3757   end procedure .
     3758   procedure stat-graf-price :
     3759   define input parameter p-oldbh              as handle no-undo .
     3760   define input parameter p-newbh              as handle no-undo .
     3761   define input parameter p-changed-fields     as character no-undo .
     3762   define input parameter p-waiting-status     as character no-undo .
     3763   define input parameter p-waiting-flag       as logical no-undo .
     3764   define output parameter p-is-waiting-status as logical no-undo .
     3765   define output parameter p-direction         as character no-undo .
     3766   define variable v-stat-list as character no-undo extent 5.
     3767   define variable v-waiting-stfl as character no-undo .
     3768   define variable v-old-stfl as character no-undo .
     3769   define variable v-new-stfl as character no-undo .
     3770   define variable v-waiting-stfl-i as integer no-undo .
     3771   define variable v-old-stfl-i as integer no-undo .
     3772   define variable v-new-stfl-i as integer no-undo .
     3773   define variable v-ii as integer no-undo .
     3774   do
     3775   on error undo, return error return-value
     3776   :
     3777   assign
     3778   v-stat-list[1] =
     3779                    ''            +  chr(3) +
     3780                    'новый':U    +  chr(3) +
     3781                    'приказ':U      +  chr(3) +
     3782                    'разрешен':U  +  chr(3) +
     3783                    'акт':U
     3784   .
     3785     assign
     3786     v-waiting-stfl = p-waiting-status
     3787     .
     3788     assign
     3789     v-old-stfl = p-oldbh::status_
     3790     .
     3791     assign
     3792     v-new-stfl = p-newbh::status_
     3793     .
     3794     _ii:
     3795     do v-ii = 1 to 5:
     3796       if v-stat-list[v-ii] = '' then next.
     3797       assign
     3798       v-waiting-stfl-i = lookup(v-waiting-stfl, v-stat-list[v-ii], chr(3))
     3799       v-old-stfl-i = lookup(v-old-stfl, v-stat-list[v-ii], chr(3))
     3800       v-new-stfl-i = lookup(v-new-stfl, v-stat-list[v-ii], chr(3))
     3801       .
     3802       if v-waiting-stfl-i = 0
     3803       or v-old-stfl-i = 0
     3804       or v-new-stfl-i = 0
     3805       then do:
     3806         next _ii.
     3807       end.
     3808       if v-old-stfl-i < v-waiting-stfl-i
     3809       and v-new-stfl-i = v-waiting-stfl-i then do:
     3810         assign
     3811         p-is-waiting-status = yes
     3812         p-direction = '<закрытие документа>':U + chr(4) + "to".
     3813         return.
     3814       end.
     3815       if v-old-stfl-i < v-waiting-stfl-i
     3816       and v-new-stfl-i > v-waiting-stfl-i then do:
     3817         assign
     3818         p-is-waiting-status = yes
     3819         p-direction = '<закрытие документа>':U + chr(4) + "to-up".
     3820         return.
     3821       end.
     3822       if v-new-stfl-i = v-waiting-stfl-i
     3823       and v-old-stfl-i > v-waiting-stfl-i then do:
     3824         assign
     3825         p-is-waiting-status = yes
     3826         p-direction = '<открытие документа>':U + chr(4) + "to".
     3827         return.
     3828       end.
     3829       if v-new-stfl-i < v-waiting-stfl-i
     3830       and v-old-stfl-i > v-waiting-stfl-i then do:
     3831         assign
     3832         p-is-waiting-status = yes
     3833         p-direction = '<открытие документа>':U + chr(4) + "to-down".
     3834         return.
     3835       end.
     3836       if v-old-stfl-i = v-waiting-stfl-i
     3837       and v-new-stfl-i > v-waiting-stfl-i then do:
     3838         assign
     3839         p-is-waiting-status = yes
     3840         p-direction = '<закрытие документа>':U + chr(4) + "from".
     3841         return.
     3842       end.
     3843       if v-old-stfl-i = v-waiting-stfl-i
     3844       and v-new-stfl-i < v-waiting-stfl-i then do:
     3845         assign
     3846         p-is-waiting-status = yes
     3847         p-direction = '<открытие документа>':U + chr(4) + "from".
     3848         return.
     3849       end.
     3850     end.
     3851   end.
     3852   end procedure.
     3853   procedure stat-graf-inkas :
     3854   define input parameter  p-oldbh              as handle no-undo .
     3855   define input parameter  p-newbh              as handle no-undo .
