     1604   procedure get-header-by-rec :
     1605   define input  parameter p-gate-rec as character no-undo .
     1606   define output parameter p-tth as handle no-undo .
     1607   define variable v-ii as integer   no-undo .
     1608   define variable glog as logical   no-undo .
     1609   define variable v-rowid as rowid no-undo .
     1610   define variable v-tbl-name as character no-undo .
     1611   define variable v-longchar as longchar no-undo .
     1612   define variable v-txmlh as handle no-undo .
     1613   define buffer buf_clob-data for ub.clob-data.
     1614   main-block:
     1615   do
     1616   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info8, return-value, chr(10), error-status :get-message (1))
     1617   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info8 )
     1618   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info8 )
     1619   :
     1620     run gen-row-keyr in  this-procedure  (
     1621                                           input  p-gate-rec
     1622                                           ,input  ?
     1623                                           ,input  "ub"
     1624                                           ,input  ?
     1625                                           ,input  NO-LOCK
     1626                                           ,output v-rowid
     1627                                           ,output v-tbl-name   ) no-error.
     1628       find first buf_clob-data no-lock where
     1629                 rowid(buf_clob-data) = v-rowid  no-error.
     1630       if not available buf_clob-data then do:
     1631         undo, return error substitute("Не найден CLOB  &1"
     1632                                         , p-gate-rec
     1633                                         ).
     1634       end.
     1635       assign
     1636       v-longchar = buf_clob-data.cdata
     1637       .
     1638       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1639       if error-status :error then do:
     1640         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1641       end.
     1642       create temp-table p-tth .
     1643       glog = p-tth:READ-XMLSCHEMA( "LONGCHAR"
     1644                                     , v-longchar
     1645                                     , ?
     1646                                     , ?
     1647                                     , ?
     1648                                     ) no-error.
     1649       v-longchar = '':U.
     1650       define variable v-esm as character no-undo .
     1651       v-esm = error-status:get-message(1).
     1652       if error-status :error
     1653       or not glog
     1654       then do:
     1655         delete object p-tth no-error.
     1656         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     1657                                    , p-gate-rec
     1658                                    , buf_clob-data.file-name_
     1659                                    , chr(10)
     1660                                    , v-esm
     1661                                     ).
     1662       end.
     1663   end.
     1664   end procedure.
     1665   define new global shared variable g#lib-gate as handle no-undo .
     1666   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1667   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1668   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1669   procedure proc-ord-code :
     1670   define input  parameter  p-type as character no-undo .
     1671   define input  parameter  v-cntxt-db-num   as integer   no-undo .
     1672   define input  parameter  v-cntxt-obj-type as character no-undo .
     1673   define input  parameter  v-cntxt-obj-code as integer   no-undo .
     1674   define input  parameter  p-i-doc    as character no-undo .
     1675   define output parameter  p-ord-doc  as character no-undo .
     1676   define variable          v-idop     as character no-undo .
     1677     do
     1678     on error undo, return error return-value
     1679     :
     1680   case p-type :
     1681       when "main-no-ver" then do:
     1682         if  (v-cntxt-db-num <> 0) then
     1683           p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (v-cntxt-obj-code, ">>>>9")) + substring (v-cntxt-obj-type, (if g#language = "RUS" then 1 else 2), 1).
     1684         else
     1685           p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-".
     1686       end.
     1687       when "main" then do:
     1688             do while true:
     1689             if  (v-cntxt-db-num <> 0) then
     1690               p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (v-cntxt-obj-code, ">>>>9")) + substring (v-cntxt-obj-type, (if g#language = "RUS" then 1 else 2), 1).
     1691             else
     1692               p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-".
     1693             if not can-find (ub.ord-doc where ub.ord-doc.doc-code = p-ord-doc no-lock) then leave.
     1694             End.
     1695       end.
     1696       when "chip" then do:
     1697         assign
     1698           v-idop = p-i-doc .
     1699         do while true :
     1700           if index (v-idop , ".") = 0 then
     1701             v-idop  = replace (v-idop , "-", "-1.").
     1702           else
     1703             v-idop  =
     1704             substring (v-idop , 1, index (v-idop, "-")) +
     1705             string (integer (substring (v-idop, index (v-idop, "-") + 1, index (v-idop, ".") - index (v-idop, "-") - 1)) + 1) +
     1706             substring (v-idop, index (v-idop, ".")).
     1707           if not can-find (ub.ord-doc where ub.ord-doc.doc-code = v-idop no-lock) then leave.
     1708         end.
     1709         assign
     1710           p-ord-doc = v-idop.
     1711       end.
     1712   end case.
     1713     end.
     1714   end procedure.
     1715   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1716   def var vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1717   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1718   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1719   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1720   procedure ordlineattr-value :
     1721     do
     1722     on error undo, return error return-value
     1723     :
     1724       define input  parameter p-doc-code like ub.ord-line-attr.doc-code   no-undo .
     1725       define input  parameter p-gds-code like ub.ord-line-attr.gds-code   no-undo .
     1726       define input  parameter p-code     like ub.ord-line-attr.attr-code  no-undo .
     1727       define output parameter p-value    like ub.ord-line-attr.attr-value no-undo .
     1728       define output parameter p-type     as character no-undo .
     1729       define buffer buf_ord-line-attr for ub.ord-line-attr .
     1730       define variable v-format         as character no-undo .
     1731       define variable v-fillin_width   as integer   no-undo .
     1732       define variable v-fillin_height  as integer   no-undo .
     1733       define variable v-label          as character no-undo .
     1734       define variable v-user-can-edit  as logical   no-undo .
     1735       define variable v-output-display as logical   no-undo .
     1736       define variable v-other          as character no-undo .
     1737       define variable v-proc           as character no-undo .
     1738       define variable v-func           as character no-undo .
     1739       define variable v-sort           as integer   no-undo .
     1740       run ordlineattr-code in this-procedure
     1741         (input  p-code
     1742         ,output p-type
     1743         ,output v-format
     1744         ,output v-fillin_width
     1745         ,output v-fillin_height
     1746         ,output v-label
     1747         ,output v-user-can-edit
     1748         ,output v-output-display
     1749         ,output v-proc
     1750         ,output v-func
     1751         ,output v-sort
     1752         ,output v-other
     1753         ) no-error .
     1754       if error-status :error then do:
     1755         undo, return error return-value .
     1756       end.
     1757       find first buf_ord-line-attr no-lock
     1758         where buf_ord-line-attr.doc-code  = p-doc-code
     1759           and buf_ord-line-attr.gds-code  = p-gds-code
     1760           and buf_ord-line-attr.attr-code = p-code
     1761         no-error .
     1762       if avail buf_ord-line-attr then do:
     1763         assign
     1764           p-value =  buf_ord-line-attr.attr-value
     1765         .
     1766       end.
     1767       else do:
     1768         assign
     1769           p-value = if p-type = 'L':U then "no":U else ""
     1770         .
     1771       end.
     1772     end.
     1773   end procedure.
     1774   procedure ordlineattr-write :
     1775     do
     1776     on error undo, return error return-value
     1777     :
     1778       define input parameter p-doc-code like ub.ord-line-attr.doc-code   no-undo .
     1779       define input parameter p-gds-code like ub.ord-line-attr.gds-code   no-undo .
     1780       define input parameter p-code     like ub.ord-line-attr.attr-code  no-undo .
     1781       define input parameter p-value    like ub.ord-line-attr.attr-value no-undo .
     1782       define buffer buf_ord-line-attr for ub.ord-line-attr .
     1783       define variable v-type           as character no-undo .
     1784       define variable v-format         as character no-undo .
     1785       define variable v-fillin_width   as integer   no-undo .
     1786       define variable v-fillin_height  as integer   no-undo .
     1787       define variable v-label          as character no-undo .
     1788       define variable v-user-can-edit  as logical   no-undo .
     1789       define variable v-output-display as logical   no-undo .
     1790       define variable v-other          as character no-undo .
     1791       define variable v-proc           as character no-undo .
     1792       define variable v-func           as character no-undo .
     1793       define variable v-sort           as integer   no-undo .
     1794       run ordlineattr-code in this-procedure
     1795         (input  p-code
     1796         ,output v-type
     1797         ,output v-format
     1798         ,output v-fillin_width
     1799         ,output v-fillin_height
     1800         ,output v-label
     1801         ,output v-user-can-edit
     1802         ,output v-output-display
     1803         ,output v-proc
     1804         ,output v-func
     1805         ,output v-sort
     1806         ,output v-other
     1807         ) no-error .
     1808       if error-status :error then do:
     1809         message
     1810           vss-workfile vss-revision vss-description skip
     1811           error-status :get-message(1) skip
     1812           return-value skip
     1813           ""
     1814           view-as alert-box error
     1815         .
     1816         undo, return error return-value .
     1817       end.
     1818       find first buf_ord-line-attr exclusive-lock
     1819         where buf_ord-line-attr.doc-code  = p-doc-code
     1820           and buf_ord-line-attr.gds-code  = p-gds-code
     1821           and buf_ord-line-attr.attr-code = p-code
     1822         no-error .
     1823       if not available buf_ord-line-attr then do:
     1824         create buf_ord-line-attr .
     1825         assign
     1826           buf_ord-line-attr.doc-code   = p-doc-code
     1827           buf_ord-line-attr.gds-code   = p-gds-code
     1828           buf_ord-line-attr.attr-code  = p-code
     1829         .
     1830       end.
     1831       assign
     1832         buf_ord-line-attr.attr-value = p-value
     1833       .
     1834   end.
     1835   end procedure.
