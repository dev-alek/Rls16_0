     3860   define output parameter p-direction          as character no-undo .
     3861   define variable v-doc-code as character no-undo .
     3862   define variable v-ext-doc-type as character no-undo .
     3863   define variable v-stat-list as character no-undo extent 3.
     3864   define variable v-jj as integer no-undo .
     3865   define variable v-ii as integer no-undo .
