     4166   function context_delete-command return logical
     4167   (
     4168       input p-esys-cmd-proc-handle as handle
     4169      ,input p-esys-cmd-code as integer
     4170   ):
     4171      if valid-handle(p-esys-cmd-proc-handle )
     4172      then do:
     4173         run delete-command in p-esys-cmd-proc-handle
     4174             (input p-esys-cmd-code
     4175             ) no-error.
     4176         if error-status :error
     4177         then do:
     4178            delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при удалении команды с кодом &1&2&3&2&4"
     4179                                                              , p-cmd-code
     4180                                                              , chr(10)
     4181                                                              , error-status:get-message(1)
     4182                                                              , return-value
     4183                                                              )).
     4184            return no .
     4185         end.
     4186         delete procedure p-esys-cmd-proc-handle no-error.
     4187         return yes.
     4188      end.
     4189      else do:
     4190         delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при удалении команды с кодом &1&2&3&2&4"
     4191                                                       , p-cmd-code
     4192                                                       , chr(10)
     4193                                                       , error-status:get-message(1)
     4194                                                       , return-value
     4195                                                       )).
     4196         return no .
     4197      end.
     4198   end.
     4199   on delete of this-procedure do:
     4200     run garbcoll_clear in this-procedure .
     4201   end.
     4202   run load-ruleset-context in this-procedure ( input p-ruleset-id) no-error.
     4203   if error-status:error then do:
     4204     undo, return error return-value .
     4205   end.
     4206   if return-value = "return" then return ''.
     4207   define variable ExpData1 as class Route-data_ no-undo .
     4208   ExpData1 = new Route-data_( input parparentproc, input p-parent-handle, input p-log-handle, input this-procedure:handle) .
     4209   define variable v-DATA as memptr no-undo.
     4210   if not this-procedure:persistent then do:
     4211     run proc-main in this-procedure no-error .
     4212     if error-status:error then do:
     4213       v-esm = error-status :get-message (1).
     4214       v-es = error-status:error .
     4215       v-rv = return-value .
     4216     end.
     4217     if v-es then do:
     4218         run garbcoll_clear in this-procedure .
     4219               if valid-handle(p-log-handle) then           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))).
     4220         undo, return error substitute( "&1. &2&3&4", vss-workfile, v-rv, chr(10), v-esm).
     4221     end.
     4222     run garbcoll_clear in this-procedure .
     4223   end.
     4224   procedure proc-main :
     4225   define variable v-ii as integer no-undo .
     4226   define variable v-uniq-key-rec as character no-undo .
     4227   define variable v-cli-uniq-key-rec as character no-undo .
     4228   define variable v-err as logical no-undo .
     4229   define variable v-custom-pack-name as character no-undo .
     4230   define variable v-success as logical   no-undo .
     4231   DEFINE VARIABLE v-date as date no-undo .
     4232   DEFINE VARIABLE v-time as integer no-undo .
     4233   define variable v-ord-int1 as integer no-undo .
     4234   define variable v-obj-gln as character no-undo .
     4235   define variable v-cli-gln as character no-undo .
     4236   define variable v-frm-gln as character no-undo .
     4237   define variable v-transport-gln as character no-undo .
     4238   define variable v-mess as character no-undo .
     4239   define variable v-b-code as integer no-undo .
     4240   define variable v-b-str as character no-undo .
     4241   define variable l-prod-bc-weight as logical no-undo .
     4242   define variable l-prod-bc-pgweight as logical no-undo .
     4243   define variable l-is-petrol-code as logical no-undo .
     4244   define variable l-is-scaleable as logical no-undo .
     4245   define variable v-jj as integer   no-undo .
     4246   define variable v-cli-base-rate as decimal no-undo .
     4247   define variable v-dump-ord-int64 as int64 no-undo .
     4248   define variable v-cli-type as character no-undo .
     4249   define variable v-cli-code as integer   no-undo .
     4250   define variable v-EDIINTERCHANGEID as character no-undo .
     4251   define variable v-edist-mess as character no-undo .
     4252   define variable v-deliverynotenumber as character no-undo .
     4253   define variable v-deliverynotedate as date no-undo .
     4254   define variable v-deliverynotedate-chr as character no-undo .
     4255   define variable v-attr-type as character no-undo .
     4256   define variable v-date-status as date no-undo .
     4257   define variable v-time-status as integer no-undo .
     4258   define variable v-date-chr as character no-undo .
     4259   define variable sw as handle no-undo .
     4260   define variable swa as handle no-undo .
     4261   define buffer buf_ext-system for ub.ext-system.
     4262   define buffer buf_ord-line for ub.ord-line.
     4263   define buffer buf_object for ub.clients.
     4264   define buffer buf_clients for ub.clients.
     4265   define buffer buf_ext-classif for ub.ext-classif.
     4266   define buffer esys_ext-classif for ub.ext-classif.
     4267   define buffer buf_goods for ub.goods.
     4268   define buffer buf_currency for ub.currency.
     4269   define buffer buf_doc-line for ub.doc-line.
     4270   _main:
     4271   do
     4272   on error undo _main, return error substitute( "&1&2&3&2&4", return-value, chr(10), error-status :get-message (1), v-last-error-message)
     4273   on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
     4274   on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
     4275   :
     4276    if retry then do:
     4277           if valid-handle(p-log-handle) then           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при обработке накладной &1&2:&3&4"                                    ,v-current-doc-code                                    , chr(10), v-mess)).
     4278       undo _main, return error.
     4279     end.
     4280     else do:
     4281       if v-has-newbh then do:
     4282         v-current-obj-type = v-newbh::obj-type.
     4283         v-current-obj-code = v-newbh::obj-code.
     4284         v-cli-type = v-newbh::cli-type.
     4285         v-cli-code = v-newbh::cli-code.
     4286         v-current-host-code = v-newbh::host-code.
     4287       end.
     4288       assign
     4289       v-mess = ''
     4290       .
     4291       find first buf_clients no-lock where
     4292                 buf_clients.obj-type = v-cli-type
     4293             and buf_clients.obj-code = v-cli-code no-error.
     4294       if not available buf_clients then do:
     4295         v-mess =  substitute("Не найден контрагент &1&2", v-cli-type, v-cli-code).
     4296         v-err = yes.
     4297         undo _main, retry _main.
     4298       end.
     4299       if buf_ord-doc.doc-type = 'ОП':U
     4300       and (buf_ord-doc.status_  = 'факт':U or buf_ord-doc.status_ = 'поставка':U)
     4301       and (buf_ord-doc.ord-int1 = integer('7':U)
     4302       or buf_ord-doc.ord-int1 = integer('8':U)
     4303       or buf_ord-doc.ord-int1 = integer('9':U)
     4304       or buf_ord-doc.ord-int1 = integer('11':U)
     4305       )
     4306       and buf_ord-doc.whole-send-news = integer('2':U)
     4307       then do:
     4308         assign
     4309         v-ord-int1 = integer('9':U).
     4310       end.
     4311       else do:
     4312         return "проверка заказа не пройдена!".
     4313       end.
     4314       run gen-key-rec in this-procedure ( input 'clients':U
     4315                                         ,input (buffer buf_clients:handle)
     4316                                         ,output v-cli-uniq-key-rec) no-error .
     4317       if error-status:error then do:
     4318         v-mess = substitute("gen-key-rec: &1&2&3&2(&4&5)"
     4319                                   , error-status:get-message(1)
     4320                                   , return-value
     4321                                   , chr(10)
     4322                                   , v-cli-type
     4323                                   , v-cli-code).
     4324         v-err = yes.
     4325         undo _main, retry _main.
     4326       end.
     4327       find first esys_ext-classif no-lock where
     4328           esys_ext-classif.classif-name = 'exite-edi':U
     4329       and esys_ext-classif.classif-subject = 'clients':U
     4330       and esys_ext-classif.db-num = -1
     4331       and esys_Ext-classif.uniq-key-rec = v-cli-uniq-key-rec no-error .
     4332       if not available esys_ext-classif then do:
     4333         v-mess = substitute("Поставщик &1&2 заказа НЕ РАБОТАЕТ ПО СИСТЕМЕ EDI", v-cli-type, v-cli-code).
     4334         v-err = yes.
     4335         undo _main, retry _main.
     4336       end.
     4337       find first buf_object no-lock where
     4338                 buf_object.obj-type = v-current-obj-type
     4339             and buf_object.obj-code = v-current-obj-code no-error.
     4340       if not available buf_object then do:
     4341         v-mess =  substitute("Не найден объект &1&2", v-current-obj-type, v-current-obj-code).
     4342         v-err = yes.
     4343         undo _main, retry _main.
     4344       end.
     4345       if buf_object.db-num <> g#db-num then do:
     4346         v-mess = substitute("Объект &1&2 принадлежит другой БД", v-current-obj-type, v-current-obj-code).
     4347         v-err = yes.
     4348         undo _main, retry _main.
     4349       end.
     4350       run gen-key-rec in this-procedure ( input 'clients':U
     4351                                         ,input (buffer buf_object:handle)
     4352                                         ,output v-uniq-key-rec) no-error .
     4353       if error-status:error then do:
     4354         v-mess =  substitute("gen-key-rec: &1&2&3&2(&4&5)"
     4355                                   , error-status:get-message(1)
     4356                                   , return-value
     4357                                   , chr(10)
     4358                                   , buf_object.obj-type
     4359                                   , buf_object.obj-code).
     4360         v-err = yes.
     4361         undo _main, retry _main.
     4362       end.
     4363       assign
     4364       v-obj-gln = get-gln( input buf_object.obj-type
     4365                       ,input buf_object.obj-code) no-error.
     4366       if error-status:error
     4367       or v-obj-gln = chr(63)
     4368       or v-obj-gln = '' then do:
     4369         v-mess =  substitute("Не определен GLN для &1&2"
     4370                                   , buf_object.obj-type
     4371                                   , buf_object.obj-code) .
     4372         v-err = yes.
     4373         undo _main, retry _main.
     4374       end.
     4375       v-cli-gln = get-gln( input v-cli-type
     4376                           ,input v-cli-code) no-error.
     4377       if error-status:error
     4378       or v-cli-gln = chr(63)
     4379       or v-cli-gln = '' then do:
     4380         v-mess =  substitute("Не определен GLN для &1&2"
     4381                                   , buf_object.obj-type
     4382                                   , buf_object.obj-code) .
     4383         v-err = yes.
     4384         undo _main, retry _main.
     4385       end.
     4386       assign
     4387       v-frm-gln = get-gln( input 'орг':U
     4388                           ,input v-current-host-code) no-error.
     4389       if error-status:error
     4390       or v-frm-gln = chr(63)
     4391       or v-frm-gln = '' then do:
     4392         v-mess =  substitute("Не определен GLN для &1&2"
     4393                                   , 'орг':U
     4394                                   , v-current-host-code) .
     4395         v-err = yes.
     4396         undo _main, retry _main.
     4397       end.
     4398       assign
     4399       v-transport-gln = get-gln( input buf_ord-doc-rcv.transport-cli-type
     4400                                 ,input buf_ord-doc-rcv.transport-cli-code) no-error.
     4401       for each esys_ext-classif no-lock where
     4402           esys_ext-classif.classif-name = 'exite-edi':U
     4403       and esys_ext-classif.classif-subject = 'clients':U
     4404       and esys_ext-classif.db-num = -1
     4405       and esys_Ext-classif.uniq-key-rec = v-cli-uniq-key-rec,
     4406         first buf_ext-system no-lock where
     4407                   buf_ext-system.esys-id = esys_ext-classif.key#_one
     4408               and buf_ext-system.db-num = 0
     4409               and buf_ext-system.esys-have-export = yes,
     4410         first buf_ext-classif no-lock where
     4411           buf_ext-classif.classif-name = 'exite-edi':U
     4412       and buf_ext-classif.classif-subject = 'clients':U
     4413       and buf_ext-classif.db-num = -1
     4414       and buf_Ext-classif.uniq-key-rec = v-uniq-key-rec
     4415       and buf_Ext-classif.key#_one = esys_ext-classif.key#_one:
     4416         leave.
     4417       end.
     4418       if not available buf_ext-system then do:
     4419         v-mess = substitute("Для поставщика &1&2 не найдена ВС, у которой есть экспорт в текущей БД").
     4420         v-err = yes.
     4421         undo _main, retry _main.
     4422       end.
     4423       IF  context_begin-esys-command( input string(buf_ext-system.esys-id), input-output v-esys-cmd-proc-handle, output v-esys-cmd-code) = false  THEN do:
     4424         undo _main, return error v-last-error-message .
     4425       end.
     4426       v-custom-pack-name = "RECADV_&pack-num.xml".
     4427   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input v-current-doc-code ,
     4428                           input 'nids':U ,
     4429                          output v-DELIVERYNOTENUMBER ,
     4430                          output v-attr-type ) no-error .
     4431   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input v-current-doc-code ,
     4432                           input 'dids':U ,
     4433                          output v-DELIVERYNOTEDATE-chr ,
     4434                          output v-attr-type ) no-error .
     4435       if not error-status:error then do:
     4436         v-DELIVERYNOTEDATE = date(v-DELIVERYNOTEDATE-chr).
     4437       end.
     4438       if num-entries(buf_ord-doc.cli-out-doc, chr(4)) > 1 then do:
     4439         assign
     4440         v-date-chr = entry(2, buf_ord-doc.cli-out-doc, chr(4))
     4441         v-date = date (integer(entry(2, v-date-chr, "-"))
     4442                        ,integer(entry(3, v-date-chr, "-"))
     4443                        ,integer(entry(1, v-date-chr, "-"))
     4444                        ) no-error.
     4445         if error-status:error then do:
     4446           run cur-time in this-procedure ( output v-date, output v-time).
     4447         end.
     4448       end.
     4449       else do:
     4450         run cur-time in this-procedure ( output v-date, output v-time).
     4451       end.
     4452       create sax-writer sw .
     4453       create sax-attributes swa .
     4454       swa:insert-attribute ("unitOfMeasure", "") .
     4455       sw:formatted = true.
     4456       sw:set-output-destination ("memptr", v-DATA).
     4457       sw:encoding = "UTF-8".
     4458       sw:start-document () .
     4459       sw:start-element ("eDIMessage") .
     4460       sw:insert-attribute ("id", (v-current-doc-code + "_" + string(TODAY) + string(TIME))) .
     4461           sw:start-element ("interchangeHeader") .
     4462               sw:write-data-element ("sender", v-frm-gln) .
     4463               sw:write-data-element ("recipient", v-cli-gln) .
     4464               sw:write-data-element ("documentType", "RECADV") .
     4465               sw:write-data-element ("creationDateTime", substring(iso-date(NOW), 1, 23) + "Z")  .
     4466           sw:end-element ("interchangeHeader") .
     4467           sw:start-element ("receivingAdvice") .
     4468           sw:insert-attribute ("number", v-current-doc-code) .
     4469           sw:insert-attribute ("date", iso-date(v-fact-date)) .
     4470               sw:write-empty-element ("originOrder") .
     4471               sw:insert-attribute ("number", string(buf_ord-doc.doc-code)) .
     4472               sw:insert-attribute ("date", iso-date(buf_ord-doc.doc-date)) .
     4473               sw:write-empty-element ("despatchIdentificator") .
     4474               sw:insert-attribute ("number", entry(1, buf_ord-doc-rcv.sub-par, chr(4))) .
     4475               sw:insert-attribute ("date", iso-date(buf_ord-doc-rcv.doc-date)) .
     4476               sw:start-element ("seller") .
     4477                   sw:write-data-element ("gln", v-cli-gln) .
     4478                   find first ub.firm no-lock where ub.firm.firm-code = buf_clients.obj-code no-error .
     4479                   sw:start-element ("organization") .
     4480                       sw:write-data-element ("name", buf_clients.obj-name) .
     4481                       sw:write-data-element ("inn", ub.firm.inn) .
     4482                       sw:write-data-element ("kpp", ub.firm.kpp) .
     4483                   sw:end-element ("organization") .
     4484               sw:end-element ("seller") .
     4485               sw:start-element ("buyer") .
     4486                   sw:write-data-element ("gln", v-frm-gln) .
     4487                   find first ub.firm no-lock where ub.firm.firm-code = buf_object.host-code no-error .
     4488                   sw:start-element ("organization") .
     4489                       sw:write-data-element ("name", buf_object.obj-name) .
     4490                       sw:write-data-element ("inn", ub.firm.inn) .
     4491                       sw:write-data-element ("kpp", ub.firm.kpp) .
     4492                   sw:end-element ("organization") .
     4493               sw:end-element ("buyer") .
     4494               sw:start-element ("deliveryInfo") .
     4495                   sw:write-data-element ("receptionDateTime", (iso-date(v-fact-date) + "T00:00:00.000Z")) .
     4496                   sw:start-element ("shipFrom") .
     4497                       sw:write-data-element ("gln", v-transport-gln) .
     4498                   sw:end-element ("shipFrom") .
     4499                   sw:start-element ("shipTo") .
     4500                       sw:write-data-element ("gln", v-obj-gln) .
     4501                       find first ub.firm no-lock where ub.firm.firm-code = buf_object.host-code no-error .
     4502                       sw:start-element ("organization") .
     4503                           sw:write-data-element ("name", buf_object.obj-name) .
     4504                           sw:write-data-element ("inn", ub.firm.inn) .
     4505                           sw:write-data-element ("kpp", ub.firm.kpp) .
     4506                       sw:end-element ("organization") .
     4507                   sw:end-element ("shipTo") .
     4508               sw:end-element ("deliveryInfo") .
     4509               sw:start-element ("lineItems") .
     4510       for each buf_doc-line no-lock where
     4511                 buf_doc-line.doc-code = v-current-doc-code
     4512       on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4513       on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
     4514       on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
     4515       :
     4516         find first buf_ord-line no-lock where
     4517                   buf_ord-line.doc-code = buf_ord-doc.doc-code
     4518               and buf_ord-line.artic     = buf_doc-line.artic
     4519               and buf_ord-line.prod-type = buf_doc-line.prod-type
     4520               and buf_ord-line.prod-code = buf_doc-line.prod-code no-error.
     4521         if not available buf_ord-line then do:
     4522           undo _main, return error substitute("Не найден строка заказа с товаром &1 &273"
     4523                                               , buf_doc-line.artic
     4524                                               , buf_doc-line.prod-type
     4525                                               , buf_doc-line.prod-code
     4526                                               ).
     4527         end.
     4528         find first buf_goods no-lock where
     4529                   buf_goods.gds-code = buf_ord-line.gds-code no-error.
     4530         if not available buf_goods then do:
     4531           undo _main, return error substitute("Не найден товар с кодом &1", buf_ord-line.gds-code).
     4532         end.
     4533         find first lineItem where lineItem.internalSupplierCode = buf_ord-line.cli-art no-error .
     4534         if available lineItem then do:
     4535           v-mess =  substitute("В заказе две строки с одинаковым артикулом поставщика &1"
     4536                                       , v-current-doc-code
     4537                                       , buf_ord-line.cli-art
     4538                                       ).
     4539           IF  context_delete-command( input v-esys-cmd-proc-handle, input v-esys-cmd-code) = false  THEN do:
     4540             undo _main, return error v-last-error-message .
     4541           end.
     4542         end.
     4543         else do:
     4544           RUN ordlineattr-value  IN THIS-PROCEDURE ( input  buf_ord-line.doc-code
     4545                                                     ,input  buf_ord-line.gds-code
     4546                                                     ,input  'ord-EAN13':U
     4547                                                     ,output v-b-str
     4548                                                     ,output v-type
     4549                                                     ) NO-ERROR.
     4550                   sw:start-element ("lineItem") .
     4551                       sw:write-data-element ("gtin", v-b-str) .
     4552                       sw:write-data-element ("internalBuyerCode", string(buf_ord-line.gds-code)) .
     4553                       sw:write-data-element ("internalSupplierCode", buf_ord-line.cli-art) .
     4554                       sw:write-data-element ("lineNumber", string(buf_ord-line.line-num)) .
     4555                       sw:write-data-element ("description", buf_goods.gds-name) .
     4556                       find first ub.units no-lock where ub.units.unit-name = buf_goods.unit-base.
     4557                       if  buf_doc-line.fact-qnty > buf_doc-line.cli-qnty then do :
     4558                           swa:update-attribute ("unitOfMeasure", "PA") .
     4559                       end.
     4560                       else do :
     4561                           swa:update-attribute ("unitOfMeasure", (if ub.units.type = 'шту':U then "PCE" else "KGM")) .
     4562                       end.
     4563                       sw:write-data-element ("despatchedQuantity", trim(string((buf_doc-line.doc-qnty  / buf_ord-line.cli-base-rate), "->>>>>>>>9.999")), "", swa) .
     4564                       sw:write-data-element ("acceptedQuantity", trim(string((buf_doc-line.fact-qnty / buf_ord-line.cli-base-rate), "->>>>>>>>9.999")), "", swa) .
     4565                       if  buf_doc-line.fact-qnty <> buf_doc-line.cli-qnty then do :
     4566                           swa:update-attribute ("unitOfMeasure", (if ub.units.type = 'шту':U then "PCE" else "KGM")) .
     4567                           sw:write-data-element ("onePlaceQuantity", trim(string((buf_doc-line.fact-qnty / buf_doc-line.cli-qnty), "->>>>>>>>9.999")), "", swa) .
     4568                       end.
     4569                       sw:write-data-element ("netPriceWithVAT", trim(string(buf_doc-line.price-cli, "->>>>>>>>9.9999"))) .
     4570                       sw:write-data-element ("vATRate", trim(string(integer(buf_doc-line.vat-pc)))) .
     4571                       sw:write-data-element ("amount", trim(string((buf_doc-line.fact-qnty * buf_doc-line.price-cli / buf_ord-line.cli-base-rate), "->>>>>>>>9.9999"))) .
     4572                   sw:end-element ("lineItem") .
     4573             create lineItem .
     4574             assign
     4575               lineItem.gtin               = v-b-str
     4576               lineItem.internalBuyerCode  = string(buf_ord-line.gds-code)
     4577               lineItem.internalSupplierCode = buf_ord-line.cli-art
     4578             .
     4579         end.
     4580       end.
     4581       empty temp-table lineItem.
     4582                   sw:end-element ("lineItems") .
     4583               sw:end-element ("receivingAdvice") .
     4584           sw:end-element ("eDIMessage") .
     4585           sw:end-document () .
     4586           delete object sw.
     4587           delete object swa.
     4588       IF ExpData1:esys-add-dump-data ( INPUT v-DATA, INPUT v-esys-cmd-proc-handle, INPUT v-esys-cmd-code, '+update') = false  THEN do:
     4589           undo _main, return error v-last-error-message .
     4590       end.
     4591       run edocsord_export in this-procedure ( buffer buf_ord-doc
     4592                                           ,input entry(1, buf_ord-doc-rcv.sub-par, chr(4))
     4593                                           ,input '9':U
     4594                                           ) no-error.
     4595       if error-status:error then do:
     4596         v-mess = substitute("Ошибка при переводе статуса маршрутизированного заказа:&1&2&1&3"
     4597                             , chr(10)
     4598                             , error-status:get-message(1)
     4599                             , return-value ).
     4600         undo _main, retry _main.
     4601       end.
     4602       IF  context_set-custom-esys-pck-name(  input v-esys-cmd-proc-handle, input v-esys-cmd-code, input v-custom-pack-name) = false  THEN do:
     4603         undo _main, return error v-last-error-message .
     4604       end.
     4605       v-dump-ord-int64 = context_send-esys-command( input string(buf_ext-system.esys-id), input v-esys-cmd-proc-handle, input v-esys-cmd-code, input g#userid).
     4606       if v-dump-ord-int64 = 0 THEN do:
     4607         undo _main, return error v-last-error-message .
     4608       end.
     4609       v-edist-mess = ''.
     4610       v-edist-mess = cr-edist_add-edist-mess( v-edist-mess, 'route':U, string(v-dump-ord-int64)).
     4611       v-date-status = ?.
     4612       run create-edi-state in this-procedure (
     4613                                               input 'trn-doc':U
     4614                                             , input v-current-doc-code
     4615                                             , input v-cli-type
     4616                                             , input v-cli-code
     4617                                             , input 'ИЗМЕНЕНИЕ':U
     4618                                             , input buf_ord-doc.ord-int1
     4619                                             , input integer('0':U)
     4620                                             , input v-PS
     4621                                             , input v-edist-mess
     4622                                             , input integer('2':U)
     4623                                             , input-output v-date-status
     4624                                             , input-output v-time-status
     4625                                             ).
     4626           ExpData1:Route-data_clear-data ( ) .
     4627     end.
     4628   end.
     4629   end procedure.
     4630   procedure load-ruleset-context :
     4631   define input parameter p-ruleset-id as integer no-undo .
     4632   define variable v-is-waiting-status as logical   no-undo .
     4633   define variable v-direction as character no-undo .
     4634   define variable v-dm as integer no-undo .
     4635   define variable v-ext-doc-type as character no-undo .
     4636   define buffer buf_rule-call-param for ub.rule-call-param.
     4637   define buffer buf_ord-chain  for ub.ord-chain.
     4638   do
     4639   on error undo, return error
     4640   :
     4641     if g#news then  return "return".
     4642     assign
     4643     v-oldbh = widget-handle (entry(2, p-doc-code, chr(4)))
     4644     v-newbh = widget-handle (entry(3, p-doc-code, chr(4)))
     4645     v-changes-list = entry(4, p-doc-code, chr(4))
     4646     file-name  = p-process-file-name
     4647     v-has-oldbh = valid-handle(v-oldbh) and v-oldbh:available
     4648     v-has-newbh = valid-handle(v-newbh) and v-newbh:available
     4649     .
     4650     if not v-has-newbh
     4651     and not v-has-oldbh then do:
     4652       undo, return error substitute("Не определено ни одного буфера - ни старый, ни новый").
     4653     end.
     4654     if not v-has-oldbh
     4655     and v-changes-list  = '' then do:
     4656        undo, return error substitute("Не определен старый буфер и список изменений").
     4657     end.
     4658     case p-ruleset-id:
     4659     when 115 then do:
     4660       if v-has-newbh
     4661       and v-newbh:table <> 'trn-doc':U then do:
     4662         undo, return error substitute("Передан неверный буфер вместо буфера для &1",  'ord-doc-rcv':U).
     4663       end.
     4664     end.
     4665     otherwise do:
     4666       undo, return error substitute("Неверный вызов &1 для набора правил &2", vss-workfile , p-ruleset-id).
     4667     end.
     4668     end case.
     4669     run statq_has-waiting-stat in this-procedure (
     4670                                                     input v-oldbh
     4671                                                    ,input v-newbh
     4672                                                    ,input v-changes-list
     4673                                                    ,input 'факт':U
     4674                                                    ,input ?
     4675                                                    ,input 0
     4676                                                    ,output v-is-waiting-status
     4677                                                    ,output v-direction
     4678                                                    ) no-error.
     4679     if v-is-waiting-status = no
     4680     or entry(1, v-direction, chr(4)) = 'удаление':U
     4681     then do:
     4682       return "return".
     4683     end.
     4684     v-dm = v-newbh:Buffer-field("whole-send-news"):buffer-value.
     4685     v-current-doc-code = v-newbh:buffer-field("doc-code"):buffer-value.
     4686     v-doc-date = v-newbh:buffer-field("doc-date"):buffer-value.
     4687     v-fact-date = v-newbh:buffer-field("fact-date"):buffer-value.
     4688     v-ps = v-newbh:buffer-field("ps"):buffer-value.
     4689     v-ext-doc-type = v-newbh:buffer-field("ext-doc-type"):buffer-value.
     4690     if v-dm <> integer('2':U) then do:
     4691       return "return".
     4692     end.
     4693     if v-ext-doc-type <> 'ie':U then do:
     4694       return "return".
     4695     end.
     4696     find first buf_ord-chain   no-lock where
     4697             buf_ord-chain.rel-doc-code = v-current-doc-code
     4698        and  buf_ord-chain.rel-doc-type = "trn"
     4699        and buf_ord-chain.doc-type = "rcv" no-error .
     4700     if not available buf_ord-chain then return "return".
     4701     find first buf_ord-doc-rcv no-lock where
     4702               buf_ord-doc-rcv.rcv-code = buf_ord-chain.doc-code no-error .
     4703     if not available buf_ord-doc-rcv then do:
     4704       return "return".
     4705     end.
     4706     find first buf_ord-doc exclusive-lock where
     4707               buf_ord-doc.doc-code = buf_ord-doc-rcv.doc-code no-error .
     4708     if not available buf_ord-doc
     4709     or buf_ord-doc.doc-type <> 'ОП':U
     4710     then do:
     4711       return "return".
     4712     end.
     4713     find first buf_rule-call-param no-lock where
     4714   buf_rule-call-param.codex_id = p-codex-id
     4715   and buf_rule-call-param.ruleset_id = p-ruleset-id
     4716   and buf_rule-call-param.call_id = p-call-id
     4717   and buf_rule-call-param.order_id = p-order-id
     4718   and buf_rule-call-param.rule_id = p-rule-id
     4719   and buf_rule-call-param.param-name = "p-xsd-file"
     4720    no-error.
     4721   if available buf_rule-call-param then do:
     4722   assign p-xsd-file = buf_rule-call-param.param-value-character.
     4723   end.
     4724   end.
     4725   end procedure.
