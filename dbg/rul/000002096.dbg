     3870   define variable v-new-stfl-i as integer no-undo .
     3871   define variable v-waiting-stfl-i as integer no-undo .
     3872   do
     3873   on error  undo, return error substitute( "&1. &2&3&4", vss-include-info23, return-value, chr(10), error-status :get-message (1))
     3874   :
     3875   if p-newbh = ?  then do:
     3876     v-doc-code = p-oldbh::inkas-code .
     3877   end.
     3878   else do:
     3879     v-doc-code     = p-newbh::inkas-code .
     3880   end.
     3881   assign
     3882   v-stat-list[1] =
     3883                    '' +           chr(4) + string(no) + chr(3) +
     3884                    'новый':U + chr(4) + string(no) + chr(3) +
     3885                    'факт':U +      chr(4) + string(no)
     3886   v-stat-list[2] =
     3887                    '' +           chr(4) + string(no) + chr(3) +
     3888                    'новый':U + chr(4) + string(no) + chr(3) +
     3889                    'новый':U + chr(4) + string(yes) + chr(3) +
     3890                    'нередакт':U + chr(4) + string(yes) + chr(3) +
     3891                    'факт':U +      chr(4) + string(no)
     3892   v-stat-list[3] =
     3893                    '' +         chr(4) + string(no) + chr(3) +
     3894                    'запрос':U + chr(4) + string(no)
     3895   .
     3896   _jj:
     3897   do v-jj = 1 to 2:
     3898     if v-jj = 1 then do:
     3899       assign
     3900       v-waiting-stfl = p-waiting-status + chr(4) + string(if p-waiting-flag = ? then no else p-waiting-flag)
     3901       .
     3902     end.
     3903     if v-jj = 2 then do:
     3904       if p-waiting-flag <> ? then leave  _jj.
     3905       assign
     3906       v-waiting-stfl = p-waiting-status + chr(4) + string(yes)
     3907       .
     3908     end.
     3909     assign
     3910     v-old-stfl = p-oldbh::status_ + chr(4) + string(p-oldbh::flag_)
     3911     .
     3912     assign
     3913     v-new-stfl = p-newbh::status_ + chr(4) + string(p-newbh::flag_)
     3914     .
     3915     _ii:
     3916     do v-ii = 1 to 3:
     3917       if v-stat-list[v-ii] = '' then next.
     3918       assign
     3919       v-waiting-stfl-i = lookup(v-waiting-stfl, v-stat-list[v-ii], chr(3))
     3920       v-old-stfl-i = lookup(v-old-stfl, v-stat-list[v-ii], chr(3))
     3921       v-new-stfl-i = lookup(v-new-stfl, v-stat-list[v-ii], chr(3))
     3922       .
     3923       if v-waiting-stfl-i = 0
     3924       or v-old-stfl-i = 0
     3925       or v-new-stfl-i = 0
     3926       then do:
     3927         next _ii.
     3928       end.
     3929       if v-old-stfl-i < v-waiting-stfl-i
     3930       and v-new-stfl-i = v-waiting-stfl-i then do:
     3931         assign
     3932         p-is-waiting-status = yes
     3933         p-direction = '<закрытие документа>':U + chr(4) + "to".
     3934         return.
     3935       end.
     3936       if v-old-stfl-i < v-waiting-stfl-i
     3937       and v-new-stfl-i > v-waiting-stfl-i then do:
     3938         assign
     3939         p-is-waiting-status = yes
     3940         p-direction = '<закрытие документа>':U + chr(4) + "to-up".
     3941         return.
     3942       end.
     3943       if v-new-stfl-i = v-waiting-stfl-i
     3944       and v-old-stfl-i > v-waiting-stfl-i then do:
     3945         assign
     3946         p-is-waiting-status = yes
     3947         p-direction = '<открытие документа>':U + chr(4) + "to".
     3948         return.
     3949       end.
     3950       if v-new-stfl-i < v-waiting-stfl-i
     3951       and v-old-stfl-i > v-waiting-stfl-i then do:
     3952         assign
     3953         p-is-waiting-status = yes
     3954         p-direction = '<открытие документа>':U + chr(4) + "to-down".
     3955         return.
     3956       end.
     3957       if v-old-stfl-i = v-waiting-stfl-i
     3958       and v-new-stfl-i > v-waiting-stfl-i then do:
     3959         assign
     3960         p-is-waiting-status = yes
     3961         p-direction = '<закрытие документа>':U + chr(4) + "from".
     3962         return.
     3963       end.
     3964       if v-old-stfl-i = v-waiting-stfl-i
     3965       and v-new-stfl-i < v-waiting-stfl-i then do:
     3966         assign
     3967         p-is-waiting-status = yes
     3968         p-direction = '<открытие документа>':U + chr(4) + "from".
     3969         return.
     3970       end.
     3971     end.
     3972   end.
     3973   end.
     3974   end procedure .
