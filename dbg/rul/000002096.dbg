     1846       define variable v-format         as character no-undo .
     1847       define variable v-fillin_width   as integer   no-undo .
     1848       define variable v-fillin_height  as integer   no-undo .
     1849       define variable v-label          as character no-undo .
     1850       define variable v-user-can-edit  as logical   no-undo .
     1851       define variable v-output-display as logical   no-undo .
     1852       define variable v-other          as character no-undo .
     1853       define variable v-proc           as character no-undo .
