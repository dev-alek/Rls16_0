     1539   define buffer buf_ext-classif for ub.ext-classif.
     1540   define buffer buf_clients for ub.clients.
     1541   define buffer buf_goods for ub.goods.
     1542   do
     1543   on error undo, return error
     1544   :
     1545     find first buf_goods no-lock where
     1546               buf_goods.gds-code = p-gds-code.
     1547     do v-ii = 1 to num-entries(p-esys-id-list, chr(1)):
     1548       for each buf_ext-classif no-lock where
     1549           buf_ext-classif.classif-name = 'clients-esys':U
     1550       and buf_ext-classif.classif-subject = 'clients':U
     1551       and buf_ext-classif.db-num = 0
     1552       and buf_ext-classif.key#_one = integer(entry(v-ii, p-esys-id-list, chr(1))):
     1553         v-obj-uniq-key-rec  =  buf_Ext-classif.uniq-key-rec.
     1554         run gen-row-keyr  in this-procedure (
     1555                                                input  v-obj-uniq-key-rec
     1556                                               ,input  ?
     1557                                               ,input  "ub"
     1558                                               ,input  ?
     1559                                               ,input  NO-LOCK
     1560                                               ,output v-tbl-row
     1561                                               ,output v-tbl-name
     1562                                               ) .
     1563         find first buf_clients no-lock where
     1564                   rowid(buf_clients) = v-tbl-row .
     1565   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1566   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     1567     (input  buf_clients.obj-type
     1568     ,input  buf_clients.obj-code
     1569     ,input  buf_goods.artic
     1570     ,input  buf_goods.prod-type
     1571     ,input  buf_goods.prod-code
     1572     ,input  'cash-parts=request'
     1573     ,output l-cash-parts
     1574     ) no-error .
     1575          if l-cash-parts then do:
     1576            p-need = yes.
     1577            return .
     1578          end.
     1579       end.
     1580     end.
     1581   end.
