     1530   procedure dtlpbcod_need-part-b-code  :
     1531   define input parameter p-gds-code as integer no-undo .
     1532   define input parameter p-esys-id-list as character no-undo .
     1533   define output parameter p-need as logical no-undo .
     1534   define variable v-ii as integer no-undo .
     1535   define variable v-obj-uniq-key-rec as character no-undo .
     1536   define variable l-cash-parts as logical no-undo .
     1537   define variable v-tbl-row as rowid no-undo .
