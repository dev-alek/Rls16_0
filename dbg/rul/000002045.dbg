     2187             on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2188             on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
     2189             on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
     2190             :
     2191               if buf_prod-bc.bc-on = no then next.
     2192               assign
     2193               l-prod-bc-weight = no
     2194               l-prod-bc-pgweight = no
     2195               .
     2196               if length(buf_prod-bc.b-str) <= 5 then do:
     2197                 v-b-str-list = buf_prod-bc.b-str.
     2198   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2199   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbcat in g#library
     2200     (buffer buf_prod-bc
     2201     ,input  'weight=request':u
     2202     ,output l-prod-bc-weight
     2203     ) no-error .
     2204                 if not l-prod-bc-weight then do:
     2205   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2206   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbcat in g#library
     2207     (buffer buf_prod-bc
     2208     ,input  'pgweight=request':u
     2209     ,output l-prod-bc-pgweight
     2210     ) no-error .
     2211                 end.
     2212                 if l-prod-bc-weight then do:
     2213                   do v-ii = 1 to num-entries(varscales-pref):
     2214                     assign
     2215                     v-b-str-list = v-b-str-list +
     2216                                   (if v-b-str-list = '' then '' else chr(44)) +
     2217                                   entry(v-ii, varscales-pref) + buf_prod-bc.b-str.
     2218                   end.
     2219                 end.
     2220                 if l-prod-bc-pgweight then do:
     2221                   next _prod-bc.
     2222                 end.
     2223               end.
     2224               else do:
     2225                 v-b-str-list = buf_prod-bc.b-str.
     2226               end.
     2227               do v-ii = 1 to num-entries (v-b-str-list):
     2228                 ExpData1:route-data_create-record( INPUT "smprices") .
     2229                 if v-smprices-dump-ord = no then do:
     2230                   IF ExpData1:esys-add-dump( INPUT "smprices", INPUT v-esys-cmd-proc-handle, INPUT v-esys-cmd-code, '_dump-order=Rec_ID') = false  THEN do:
     2231                     v-err-mess = substitute("Ошибка при маршрутизации цен для кода &1:&2&3"
     2232                                             , buf_bar-code.b-code
     2233                                             , chr(10)
     2234                                             , v-last-error-message
     2235                                             ).
     2236                     undo _main, return error ''.
     2237                   end.
     2238                   v-smprices-dump-ord = yes.
     2239                 end.
     2240                 ExpData1:route-data_copy-field-character( INPUT "smprices", "REC_ID", INPUT  string(v-obj-type-code)) .
     2241                 ExpData1:route-data_copy-field( INPUT "smprices", "GoodsID", INPUT  buffer buf_goods:buffer-field("gds-code") ) .
     2242                 ExpData1:route-data_copy-field-character( INPUT "smprices", "BC", INPUT  entry(v-ii, v-b-str-list)) .
     2243                 ExpData1:route-data_copy-field-integer( INPUT "smprices", "PriceID", INPUT  v-obj-type-code ) .
     2244                 ExpData1:route-data_copy-field-character( INPUT "smprices", "Action", INPUT  'U':U) .
     2245                 ExpData1:route-data_copy-field-decimal( INPUT "smprices", "Price", INPUT  v-price-sale ) .
     2246                 IF ExpData1:esys-add-dump( INPUT "smprices", INPUT v-esys-cmd-proc-handle, INPUT v-esys-cmd-code, '+update') = false  THEN do:
     2247                   v-err-mess = substitute("Ошибка при маршрутизации цен для кода &1 ДопБК &2:&3&4"
     2248                                           , buf_bar-code.b-code
     2249                                           , buf_prod-bc.b-str
     2250                                           , chr(10)
     2251                                           , v-last-error-message
     2252                                           ).
     2253                   undo _main, return error ''.
     2254                 end.
     2255               end.
     2256             end.
     2257           end.
     2258         end.
     2259       end.
     2260       num-rec-ok = num-rec-ok + 1.
     2261       run write-counter in p-log-handle ( input substitute("Обработано товаров списка: &1, из них удачно: &2", num-rec, num-rec-ok)).
     2262       run get-stop-state in p-log-handle ( output v-stop) no-error .
     2263       if v-stop then do:
     2264           run write-log-and-file in p-log-handle (
     2265                                                   input 1
     2266                                                 , input log-file-name
     2267                                                 , input 1
     2268                                                 , input substitute("Процесс прерван пользователем")).
     2269           leave _stroka.
     2270       end.
     2271       if last( gds-list.gds-code)
     2272       or num-rec modulo v-pck-num-rec = 0
     2273       then do:
     2274         IF  context_send-esys-command( input v-esys-id-list, input v-esys-cmd-proc-handle, input v-esys-cmd-code, input g#userid) = false  THEN do:
     2275           undo _main, return error v-last-error-message .
     2276         end.
     2277               ExpData1:Route-data_clear-data ( ) .
     2278       end.
     2279     end.
     2280   end.
     2281   end procedure.
     2282   procedure load-ruleset-context :
     2283   define input parameter p-ruleset-id as integer no-undo .
     2284   define variable v-flag as logical no-undo .
     2285   define variable v-ii as integer no-undo .
     2286   define variable v-changes-list2 as character no-undo .
     2287   define variable v-h as handle no-undo .
     2288   define buffer buf_rule-call-param for ub.rule-call-param.
     2289   define buffer buf_ext-system for ub.ext-system.
     2290   define buffer buf_temp-rule-call-param for temp-rule-call-param.
     2291   do
     2292   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2293   on stop   undo , return error substitute( "&1. stop", vss-workfile )
     2294   on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     2295   :
     2296   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2297   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run calltree in g#library
     2298     (input  'cb_rcps-run_fill-rcp-from-tt0'
     2299     ,input  this-procedure:handle
     2300     ,input  p-cont-handle
     2301     ,output v-h
     2302     )  .
     2303     run  cb_rcps-run_fill-rcp-from-tt0 in v-h ( input p-call-id
     2304                                                ,input buffer buf_temp-rule-call-param:handle
     2305                                                             ).
     2306     for each buf_temp-rule-call-param no-lock where
     2307     buf_temp-rule-call-param.codex_id = p-codex-id
     2308     and buf_temp-rule-call-param.ruleset_id = p-ruleset-id
     2309     and buf_temp-rule-call-param.call_id = p-call-id
     2310     and buf_temp-rule-call-param.order_id = p-order-id
     2311     and buf_temp-rule-call-param.rule_id = p-rule-id
     2312     and buf_temp-rule-call-param.param-name = "p-esys-id-list",
     2313       first buf_ext-system no-lock where
     2314             buf_Ext-system.esys-id = buf_temp-rule-call-param.param-value-integer
     2315         and buf_Ext-system.db-num = 0
     2316         and buf_Ext-system.esys-have-export = yes
     2317         and buf_Ext-system.esys-db-num-exp = g#db-num:
     2318       v-esys-id-list = v-esys-id-list + (if v-esys-id-list = '' then '' else chr(1)) + string(buf_ext-system.esys-id).
     2319     end.
     2320     if v-esys-id-list = '' then return "return".
     2321     find first buf_temp-rule-call-param no-lock where
     2322   buf_temp-rule-call-param.codex_id = p-codex-id
     2323   and buf_temp-rule-call-param.ruleset_id = p-ruleset-id
     2324   and buf_temp-rule-call-param.call_id = p-call-id
     2325   and buf_temp-rule-call-param.order_id = p-order-id
     2326   and buf_temp-rule-call-param.rule_id = p-rule-id
     2327   and buf_temp-rule-call-param.param-name = "p-xsd-file"
     2328    no-error.
     2329   if available buf_temp-rule-call-param then do:
     2330     assign p-xsd-file = buf_temp-rule-call-param.param-value-character.
     2331   end.
     2332       case p-ruleset-id:
     2333         when 2 then do:
     2334           assign
     2335           v-current-host-code = p-host-code
     2336           v-current-obj-type = p-obj-type
     2337           v-current-obj-code = p-obj-code
     2338           .
     2339         end.
     2340         otherwise do:
     2341           undo, return error substitute("Неверный вызов &1 для набора правил &2", vss-workfile , p-ruleset-id).
     2342         end.
     2343       end case.
     2344   end.
     2345   end procedure.
