     1991             find first buf_temp-browse-handle
     1992               where buf_temp-browse-handle.browse-type   = 'width':u
     1993                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1994               no-error .
     1995             if available buf_temp-browse-handle
     1996             then do:
     1997             end.
     1998             else do:
     1999               create buf_temp-diasize-handle .
     2000               assign
     2001                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2002                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2003               .
     2004             end.
     2005           end.
     2006           assign
     2007             v-object-handle = v-object-handle :next-sibling
     2008           .
     2009         end.
     2010         assign
     2011           v-field-group-handle = v-field-group-handle :next-sibling
     2012         .
     2013       end.
     2014       do with frame Dialog-Frame
     2015       :
     2016         hide v-diasize-resize-button .
     2017         v-diasize-resize-button :row = 1.
     2018         v-diasize-resize-button :column = 1.
     2019       end.
     2020       if p-change-value > 0
     2021       then do:
     2022         if frame Dialog-Frame :scrollable = true
     2023         then do:
     2024           assign
     2025             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2026             no-error .
     2027           if error-status :error
     2028           or error-status :get-message(1) <> ""
     2029           then do:
     2030             undo move_block, retry move_block.
     2031           end.
     2032         end.
     2033         assign
     2034           frame Dialog-Frame :width = v-frame-width + p-change-value
     2035           no-error .
     2036         if error-status :error
     2037         or error-status :get-message(1) <> ""
     2038         then do:
     2039           undo move_block, retry move_block.
     2040         end.
     2041         assign
     2042           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2043         no-error .
     2044         if error-status :error
     2045         or error-status :get-message(1) <> ""
     2046         then do:
     2047           undo move_block, retry move_block.
     2048         end.
     2049         for each buf_temp-browse-handle
     2050           where buf_temp-browse-handle.browse-type = 'width':u
     2051         on error undo move_block, retry move_block
     2052         :
     2053           assign
     2054             buf_temp-browse-handle.browse-handle :width
     2055               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2056             no-error .
     2057           if error-status :error
     2058           or error-status :get-message(1) <> ""
     2059           then do:
     2060             undo move_block, retry move_block .
     2061           end.
     2062         end.
     2063         for each buf_temp-diasize-handle
     2064         on error undo move_block, retry move_block
     2065         :
     2066           assign
     2067             v-object-handle = buf_temp-diasize-handle.handle-value
     2068           .
     2069           if v-object-handle <> v-diasize-resize-button
     2070           then do:
     2071             assign
     2072               v-object-handle :col = v-object-handle :col + p-change-value
     2073               no-error .
     2074             if error-status :error
     2075             or error-status :get-message(1) <> ""
     2076             then do:
     2077               undo move_block, retry move_block .
     2078             end.
     2079           end.
     2080         end.
     2081       end.
     2082       else do:
     2083         for each buf_temp-diasize-handle
     2084         on error undo move_block, retry move_block
     2085         :
     2086           assign
     2087             v-object-handle = buf_temp-diasize-handle.handle-value
     2088           .
     2089           if v-object-handle <> v-diasize-resize-button
     2090           then do:
     2091             assign
     2092               v-object-handle :col = v-object-handle :col + p-change-value
     2093               no-error .
     2094             if error-status :error
     2095             or error-status :get-message(1) <> ""
     2096             then do:
