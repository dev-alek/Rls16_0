      925        LABEL "&Добавить"
      926        SIZE 10 BY 1.
      927   DEFINE BUTTON b-chg
      928        LABEL "&Изменить"
      929        SIZE 10 BY 1.
      930   DEFINE BUTTON B-cmp
      931        LABEL "&Компилить"
      932        SIZE 10 BY 1.
      933   DEFINE BUTTON b-del
      934        LABEL "&Удалить"
      935        SIZE 10 BY 1.
      936   DEFINE BUTTON B-Help
      937        LABEL "Помо&щь"
      938        SIZE 3 BY 1
      939        BGCOLOR 8 .
      940   DEFINE BUTTON b-link
      941        LABEL "Связи"
      942        SIZE 10 BY 1.
      943   DEFINE BUTTON b-lkp
      944        LABEL "&Просмотр"
      945        SIZE 10 BY 1.
      946   DEFINE BUTTON b-mark
      947        LABEL "&*"
      948        SIZE 4 BY 1.
      949   DEFINE BUTTON b-quit AUTO-END-KEY
      950        LABEL "&Выход"
      951        SIZE 10 BY 1
      952        BGCOLOR 8 .
      953   DEFINE BUTTON b-sel AUTO-GO
      954        LABEL "Выбор"
      955        SIZE 10 BY 1.
      956   DEFINE VARIABLE mark-num AS INTEGER FORMAT "->,>>>,>>9":U INITIAL 0
      957         VIEW-AS TEXT
      958        SIZE 9 BY .67
      959        FGCOLOR 10  NO-UNDO.
      960   DEFINE QUERY br-rule-profile FOR
      961         X_rule-profile SCROLLING.
      962   DEFINE BROWSE br-rule-profile
      963   QUERY br-rule-profile NO-LOCK  DISPLAY
      964         mark-string(recid(X_rule-profile), v-rid-list) Format "X(1)" COLUMN-LABEL "*"
      965   X_rule-profile.profile_id COLUMN-LABEL "ID" FORMAT ">>>>>>>>9"
      966   X_rule-profile.profile-type COLUMN-LABEL "Тип" FORMAT "X(20)"
      967   X_rule-profile.name COLUMN-LABEL "Название" FORMAT "X(255)" WIDTH 80
      968   X_rule-profile.param-code COLUMN-LABEL "Конф.пар-р" FORMAT "X(8)"
      969   X_rule-profile.param-value COLUMN-LABEL "Значение конф.пар-ра" FORMAT "X(255)"  WIDTH 40
      970       WITH NO-ROW-MARKERS SEPARATORS SIZE 97 BY 20.53 FIT-LAST-COLUMN.
      971   DEFINE FRAME Dialog-Frame
      972        b-quit AT ROW 1 COL 1
      973        b-mark AT ROW 1 COL 20 WIDGET-ID 12
      974        b-sel AT ROW 1 COL 24 WIDGET-ID 10
      975        b-add AT ROW 1 COL 34 WIDGET-ID 2
      976        b-chg AT ROW 1 COL 44 WIDGET-ID 4
      977        b-del AT ROW 1 COL 54 WIDGET-ID 8
      978        b-lkp AT ROW 1 COL 64 WIDGET-ID 6
      979        b-link AT ROW 1 COL 74 WIDGET-ID 16
      980        B-cmp AT ROW 1 COL 84 WIDGET-ID 18
      981        B-Help AT ROW 1 COL 95
      982        br-rule-profile AT ROW 2.33 COL 1.5 WIDGET-ID 100
      983        mark-num AT ROW 1 COL 11 NO-LABEL WIDGET-ID 14
      984        SPACE(78.50) SKIP(21.19)
      985       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      986            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      987            TITLE ""
      988            CANCEL-BUTTON b-quit.
      989   ASSIGN
      990          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      991          FRAME Dialog-Frame:HIDDEN           = TRUE.
      992   ASSIGN
      993          b-link:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-b-link:HANDLE.
      994   ASSIGN
      995          b-lkp:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-b-lkp:HANDLE.
      996   ON GO OF FRAME Dialog-Frame
      997   DO:
      998     p-rid-list = v-rid-list.
      999   END.
     1000   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1001   DO:
     1002     APPLY "END-ERROR":U TO SELF.
     1003   END.
     1004   ON CHOOSE OF b-add IN FRAME Dialog-Frame
     1005   DO:
     1006    define variable v-rec as recid no-undo.
     1007     if p-list-mode = "term" then do:
     1008       run proc-b-term in this-procedure ( input integer(p-general-view)
     1009                                         , input 'ДОБАВЛЕНИЕ':U
     1010                                         , output v-rec
     1011                                          ) no-error.
     1012       if error-status:error then return no-apply.
     1013     end.
     1014     else do:
     1015     run rul/rule-profile-i.w ( input parparentproc
     1016                          ,input 'ДОБАВЛЕНИЕ':U
     1017                          ,input 0
     1018                          ,input-output v-rec) no-error.
     1019     end.
     1020     if v-rec <> ? then do:
     1021       RUN openbr IN THIS-PROCEDURE.
     1022     end.
     1023   END.
     1024   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
     1025   DO:
     1026     define variable v-rec as recid no-undo.
     1027     if not available X_rule-profile then return no-apply.
     1028     v-rec = recid(X_rule-profile).
     1029     run rul/rule-profile-i.w ( input parparentproc
     1030                          ,input 'ИЗМЕНЕНИЕ':U
     1031                          ,input X_rule-profile.profile_id
     1032                          ,input-output v-rec) no-error.
     1033     if v-rec <> ? then do:
     1034        br-rule-profile:refresh().
     1035     end.
     1036   END.
     1037   ON CHOOSE OF B-cmp IN FRAME Dialog-Frame
     1038   DO:
     1039     IF NOT AVAILABLE X_rule-profile THEN RETURN NO-APPLY.
     1040     if X_rule-profile.profile-type <> 'trn-doc':U
     1041     and entry(1, X_rule-profile.profile-type, "_") <> 'chk-doc':U
     1042     then do:
     1043       message
     1044       "Компилиться по правилам!"
     1045       view-as alert-box error .
     1046       return no-apply.
     1047     end.
     1048       run waitfram-show in this-procedure ( substitute("Компиляция профайла &1", X_rule-profile.profile_id) ).
     1049       run rul/rp-prep.p ( input X_rule-profile.profile_id ) no-error.
     1050       if error-status:error then do:
     1051           run waitfram-hide in this-procedure .
     1052           message
     1053           substitute("Ошибка при компиляции профайла&1&2" +
     1054                     "&3&2&4&2"
     1055                     , X_rule-profile.profile_id
     1056                     , chr(10)
     1057                     , error-status:error
     1058                     , return-value
     1059                     )
     1060           view-as alert-box error .
     1061       end.
     1062       run waitfram-hide in this-procedure .
     1063   END.
     1064   ON CHOOSE OF b-del IN FRAME Dialog-Frame
     1065   DO:
     1066     define variable v-rec as recid no-undo.
     1067     define variable glog as logical no-undo.
     1068     if not available X_rule-profile then return no-apply.
     1069     v-rec = recid(X_rule-profile).
     1070     if p-list-mode = "term" then do:
     1071       run proc-b-term in this-procedure ( input integer(p-general-view)
     1072                                          , input 'удаление':U
     1073                                          , output v-rec
     1074                                          ) no-error.
     1075     end.
     1076     else do:
     1077     message
     1078     "Вы уверены, что хотите удалить профайл?"
     1079     view-as alert-box question buttons yes-no update glog.
     1080     if not glog then return no-apply.
     1081    run rul/rule-profile3.p (
     1082                              input no
     1083                             ,input v-rec
     1084                             ) no-error.
     1085     end.
     1086    if error-status:error then return no-apply.
     1087    run Openbr in this-procedure .
     1088   END.
     1089   ON CHOOSE OF b-link IN FRAME Dialog-Frame
