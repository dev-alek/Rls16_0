     1596         :
     1597           if  v-object-handle <> v-diasize-browse-handle :handle
     1598           and can-query(v-object-handle, "row")
     1599           and can-query(v-object-handle, "height")
     1600           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1601           then do:
     1602             find first buf_temp-browse-handle
     1603               where buf_temp-browse-handle.browse-type   = 'height':u
     1604                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1605               no-error .
     1606             if available buf_temp-browse-handle
     1607             then do:
     1608             end.
     1609             else do:
     1610               create buf_temp-diasize-handle .
     1611               assign
     1612                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1613                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1614               .
     1615             end.
     1616           end.
     1617           assign
     1618             v-object-handle = v-object-handle :next-sibling
     1619           .
     1620         end.
     1621         assign
     1622           v-field-group-handle = v-field-group-handle :next-sibling
     1623         .
     1624       end.
     1625       do with frame Dialog-Frame
     1626       :
     1627         hide v-diasize-resize-button .
     1628         assign
     1629           v-diasize-resize-button :row    = 1
     1630           v-diasize-resize-button :column = 1
     1631         .
     1632       end.
     1633       if p-change-value > 0
     1634       then do:
     1635         if frame Dialog-Frame :scrollable = true
     1636         then do:
     1637           assign
     1638             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1639             no-error .
     1640           if error-status :error
     1641           or error-status :get-message(1) <> ""
     1642           then do:
     1643             undo move_block, retry move_block .
     1644           end.
     1645         end.
     1646         assign
     1647           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1648           no-error .
     1649         if error-status :error
     1650         or error-status :get-message(1) <> ""
     1651         then do:
     1652           undo move_block, retry move_block .
     1653         end.
     1654         assign
