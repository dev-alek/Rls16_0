     1274   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1275   on help of frame Dialog-Frame
     1276   do:
     1277     run gbl/app_help.p
     1278       (input this-procedure :file-name
     1279       ,input ''
     1280       ,input ?
     1281       ) no-error.
     1282     if error-status :error then do:
     1283       message
     1284         "Ошибка при вызове помощи"
     1285         error-status :get-message(1)
     1286         view-as alert-box .
     1287     end.
     1288   end.
     1289   run minbtn-set in this-procedure .
     1290   on choose of b-help in frame Dialog-Frame
     1291   do:
     1292     apply "help":u to frame Dialog-Frame .
     1293   end.
     1294   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1295   procedure minbtn-set :
     1296       do
     1297           on error undo, return error return-value
     1298           :
     1299           define variable ii              as integer       no-undo .
     1300           define variable fh              as widget-handle no-undo .
     1301           define variable hh              as widget-handle no-undo .
     1302           define variable v-h             as handle        extent 4 no-undo .
     1303           define variable v-name-button   as character     no-undo .
     1304           define variable v-help-old-x    as decimal       no-undo .
     1305           define variable v-help-old-y    as decimal       no-undo .
     1306           define variable v-help-old-size as decimal       no-undo .
     1307           define variable v-frame-width   as decimal       no-undo .
     1308           define variable jj              as integer       no-undo .
     1309           do
     1310               on error undo, return error
     1311               :
     1312               assign
     1313                   v-frame-width = frame Dialog-Frame:width - 0.3
     1314                   fh            = frame Dialog-Frame:first-child
     1315                   hh            = fh:first-child
     1316                   ii            = 1
     1317                   .
     1318               do while valid-handle(hh):
     1319                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1320                   do:
     1321                       case lc(hh:name) :
     1322                           when "b-help" then
     1323                               do:
     1324                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1325                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1326                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1327                                   hh:TOOLTIP = "Помощь" .
     1328                                   v-help-old-x = hh:column .
     1329                                   v-help-old-y = hh:row    .
     1330                                   v-help-old-size = hh:width .
     1331                                   hh:width-chars = 2.5 .
     1332                               end.
     1333                           when "b-print" then
     1334                               do:
     1335                                   hh:load-image("cmp/b-print.bmp":u) .
     1336                                   hh:TOOLTIP = "Печать" .
     1337                                   v-h[ii] = hh:handle .
     1338                                   ii = ii + 1 .
     1339                                   hh:width-chars = 3 .
     1340                               end.
     1341                           when "b-history" or
     1342                           when "b-hist" then
     1343                               do:
     1344                                   hh:load-image("cmp/b-hist.bmp":u) .
     1345                                   hh:TOOLTIP = "История" .
     1346                                   v-h[ii] = hh:handle .
     1347                                   ii = ii + 1 .
     1348                                   hh:width-chars = 3 .
     1349                               end.
     1350                           when "b-sch" then
     1351                               do:
     1352                                   hh:load-image("cmp/b-sch.bmp":u) .
     1353                                   hh:TOOLTIP = "Установка Фильтра" .
     1354                                   v-h[ii] = hh:handle .
     1355                                   ii = ii + 1 .
     1356                                   hh:width-chars = 3 .
     1357                               end.
     1358                           when "b-hist-user" then
     1359                               do:
     1360                                   hh:load-image("cmp/b-hist.bmp":u) .
     1361                                   hh:TOOLTIP = "История пользователя" .
     1362                                   ii = ii + 1 .
     1363                               end.
     1364                       end case.
     1365                   end.
     1366                   hh = hh:next-sibling.
     1367               end.
     1368               b-help:column = v-frame-width - b-help:width-chars.
     1369               jj = 0.
     1370               repeat ii = 4 to 1 by -1 :
     1371                   if valid-handle (v-h[ii] ) then
     1372                   do:
     1373                       jj  = jj + 1 .
     1374                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1375                       v-h[ii]:row    = v-help-old-y .
     1376                   end.
     1377               end.
     1378           end.
     1379       end.
     1380   end procedure.
     1381   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1382   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1383   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1384   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1385   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1386   define variable v-diasize-current-frame-height as decimal   no-undo .
     1387   define variable v-diasize-change-size          as logical   no-undo .
     1388   define variable v-diasize-resize-button        as handle    no-undo .
     1389   define variable v-diasize-wndmax               as logical   no-undo .
     1390   define variable v-diasize-wndstore             as logical   no-undo .
     1391   define variable v-diasize-proc-name            as character no-undo .
     1392   define variable v-diasize-browse-handle        as handle    no-undo .
     1393   define variable v-diasize-browse-number        as integer   no-undo .
     1394   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1395   define temp-table temp-diasize-handle no-undo
     1396     field handle-value  as handle
     1397     field save-position as decimal
     1398     index xpk is primary unique handle-value
     1399     .
     1400   define temp-table temp-browse-handle no-undo
     1401     field browse-type   as character
     1402     field browse-number as integer
     1403     field browse-handle as handle
     1404     field original-size as decimal
     1405     index xpk is primary unique browse-type browse-number
     1406     index xie browse-type browse-handle
     1407   .
     1408   procedure diasize_change-height :
     1409     define input  parameter p-change-value  as decimal   no-undo .
     1410     define input  parameter p-move-resize   as logical   no-undo .
     1411     define variable v-field-group-handle    as handle    no-undo .
     1412     define variable v-object-handle         as handle    no-undo .
     1413     define variable v-frame-height          as decimal   no-undo .
     1414     define variable v-frame-virtual-height  as decimal   no-undo .
     1415     define variable v-browse-height         as decimal   no-undo .
     1416     define variable v-window-height         as decimal   no-undo .
     1417     define variable v-window-virtual-height as decimal   no-undo .
     1418     define variable v-change-sign           as integer   no-undo .
     1419     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1420     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1421     if p-change-value > 0
     1422     then do:
     1423       if frame Dialog-Frame :height + p-change-value
     1424           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1425       then do:
     1426         assign
     1427           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1428                           - (frame Dialog-Frame :height-chars)
     1429         .
     1430         if p-change-value <= 0
     1431         then do:
     1432           run diasize_position-resize-button in this-procedure .
     1433           return .
     1434         end.
     1435       end.
     1436     end.
     1437     if p-change-value < 0
     1438     then do:
     1439       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1440       then do:
     1441         assign
     1442           p-change-value = v-diasize-orig-frame-height
     1443                          - (frame Dialog-Frame :height-chars)
     1444         .
     1445         if p-change-value >= 0
     1446         then do:
     1447           run diasize_position-resize-button in this-procedure .
     1448           return .
     1449         end.
     1450       end.
     1451     end.
     1452     if p-change-value >= 0
     1453     then do:
     1454       assign
     1455         v-change-sign = 1
     1456       .
     1457     end.
     1458     else do:
     1459       assign
     1460         v-change-sign = -1
     1461       .
     1462     end.
     1463     assign
     1464       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1465     .
     1466     if p-change-value = 0
     1467     then do:
     1468       run diasize_position-resize-button in this-procedure .
     1469       return .
     1470     end.
     1471     move_block:
     1472     do
     1473     on error undo move_block, retry move_block
     1474     :
     1475       if retry
     1476       then do:
     1477         do
     1478         on error undo move_block, leave move_block
     1479         :
     1480           if p-change-value > 0
     1481           then do:
     1482             for each buf_temp-diasize-handle
     1483             on error undo, next
     1484             :
     1485               assign
     1486                 v-object-handle = buf_temp-diasize-handle.handle-value
     1487               .
     1488               if v-object-handle <> v-diasize-resize-button
     1489               then do:
     1490                 assign
     1491                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1492                 .
     1493               end.
     1494             end.
     1495             assign
     1496               v-diasize-browse-handle :height = v-browse-height
     1497             .
     1498             for each buf_temp-browse-handle
     1499               where buf_temp-browse-handle.browse-type = 'height':u
     1500             on error undo, next
     1501             :
     1502               assign
     1503                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1504               .
     1505             end.
     1506             assign
     1507               frame Dialog-Frame :height = v-frame-height
     1508             .
     1509             if frame Dialog-Frame :scrollable = true
     1510             then do:
     1511               assign
     1512                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1513               .
     1514             end.
     1515             run diasize_position-resize-button in this-procedure .
     1516           end.
     1517           else do:
     1518             if frame Dialog-Frame :scrollable = true
     1519             then do:
     1520               assign
     1521                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1522               .
     1523             end.
     1524             assign
     1525               frame Dialog-Frame :height = v-frame-height
     1526             .
     1527             assign
     1528               v-diasize-browse-handle :height = v-browse-height
     1529             .
     1530             for each buf_temp-browse-handle
     1531               where buf_temp-browse-handle.browse-type = 'height':u
     1532             on error undo, next
     1533             :
     1534               assign
     1535                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1536               .
     1537             end.
     1538             for each buf_temp-diasize-handle
     1539             on error undo, next
     1540             :
     1541               assign
     1542                 v-object-handle = buf_temp-diasize-handle.handle-value
     1543               .
     1544               if v-object-handle <> v-diasize-resize-button
