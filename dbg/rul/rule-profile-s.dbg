     2098             end.
     2099           end.
     2100         end.
     2101         for each buf_temp-browse-handle
     2102           where buf_temp-browse-handle.browse-type = 'width':u
     2103         on error undo move_block, retry move_block
     2104         :
     2105           assign
     2106             buf_temp-browse-handle.browse-handle :width
     2107               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2108             no-error .
     2109           if error-status :error
     2110           or error-status :get-message(1) <> ""
     2111           then do:
     2112             undo move_block, retry move_block .
     2113           end.
     2114         end.
     2115         assign
     2116           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2117           no-error .
     2118         if error-status :error
     2119         or error-status :get-message(1) <> ""
     2120         then do:
     2121           undo move_block, retry move_block.
     2122         end.
     2123         assign
     2124           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2125         no-error .
     2126         if error-status :error
     2127         or error-status :get-message(1) <> ""
     2128         then do:
     2129           undo move_block, retry move_block.
     2130         end.
     2131         if frame Dialog-Frame :scrollable = true
     2132         then do:
     2133           assign
     2134             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2135           no-error .
     2136           if error-status :error
     2137           or error-status :get-message(1) <> ""
     2138           then do:
     2139             undo move_block, retry move_block.
     2140           end.
     2141         end.
     2142       end.
     2143       if p-move-resize
     2144       then do:
     2145         run diasize_position-resize-button in this-procedure .
     2146       end.
     2147       if v-diasize-wndstore = true
     2148       then do:
     2149         if connected("ub") = true
     2150         then do:
     2151           define variable v-cntxt-db-num        as integer   no-undo .
     2152           define variable v-cntxt-userid        as character no-undo .
     2153           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2154                                             , OUTPUT v-cntxt-userid
     2155                                             ) .
     2156           run gbl/wndsizew.p
     2157             (input  v-cntxt-db-num
     2158             ,input  v-cntxt-userid
     2159             ,input  v-diasize-proc-name
     2160             ,input  'width':u
     2161             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2162             ) .
     2163         end.
     2164       end.
     2165     end.
     2166     assign
     2167       v-diasize-change-size = false
     2168     .
     2169   end procedure.
     2170   procedure diasize_set-width :
     2171     define input  parameter p-new-width  as decimal   no-undo .
     2172     define input  parameter p-move-resize as logical   no-undo .
     2173     do
     2174     on error undo, return error return-value
     2175     :
     2176       run diasize_change-width in this-procedure
     2177         (input  (p-new-width - frame Dialog-Frame :width)
     2178         ,input  p-move-resize
     2179         ) .
     2180     end.
     2181   end procedure.
     2182   procedure diasize_position-resize-button :
     2183     do with frame Dialog-Frame
     2184     :
     2185       hide v-diasize-resize-button .
     2186       assign
     2187         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2188                     - 1
     2189                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2190         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2191                     - 1
     2192                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2193       .
     2194       view v-diasize-resize-button .
     2195     end.
     2196   end procedure.
     2197   on alt-right anywhere
     2198   do:
     2199     run diasize_change-width in this-procedure
     2200       (input 1
     2201       ,input true
     2202       ) .
     2203     return no-apply .
     2204   end.
     2205   on alt-left anywhere
     2206   do:
     2207     run diasize_change-width in this-procedure
     2208       (input -1
     2209       ,input true
     2210       ) .
     2211     return no-apply .
     2212   end.
     2213   on alt-down anywhere
     2214   do:
     2215     run diasize_change-height in this-procedure
     2216       (input 1
     2217       ,input true
     2218       ) .
     2219     return no-apply .
     2220   end.
     2221   on alt-up anywhere
     2222   do:
     2223     run diasize_change-height in this-procedure
     2224       (input -1
     2225       ,input true
     2226       ) .
     2227     return no-apply .
     2228   end.
     2229   on alt-enter of frame Dialog-Frame
     2230   do:
     2231     run diasize_maximize in this-procedure
     2232       (input  ?
     2233       ).
     2234     return no-apply .
     2235   end.
     2236   procedure diasize_end-move :
     2237     do
     2238     on error undo, return error return-value
     2239     :
     2240       define variable v-row-delta as decimal   no-undo .
     2241       define variable v-col-delta as decimal   no-undo .
     2242       define variable v-new-row as decimal   no-undo .
     2243       define variable v-new-col as decimal   no-undo .
     2244       assign
     2245         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2246         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2247       .
     2248       assign
     2249         v-row-delta = v-new-row - frame Dialog-Frame :height
     2250         v-col-delta = v-new-col - frame Dialog-Frame :width
     2251       .
     2252       run diasize_change-height in this-procedure
     2253         (input v-row-delta
     2254         ,input true
     2255         ) .
     2256       run diasize_change-width in this-procedure
     2257         (input v-col-delta
     2258         ,input true
     2259         ) .
     2260     end.
     2261   end procedure.
     2262   procedure diasize_maximize :
     2263     define input  parameter p-action as logical   no-undo .
     2264     do
     2265     on error undo, return error return-value
     2266     :
     2267       if p-action = ?
     2268       then do:
     2269         if v-diasize-need-maximize = true
     2270         then do:
     2271           assign
     2272             p-action = true
     2273           .
     2274         end.
     2275         else do:
     2276           assign
     2277             p-action = false
     2278           .
     2279         end.
     2280       end.
     2281       if p-action = true
     2282       then do:
     2283         run diasize_change-height in this-procedure
     2284           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2285               - frame Dialog-Frame :height-chars
     2286           ,input true
     2287           ) .
     2288         run diasize_change-width in this-procedure
     2289           (input session :width-chars
     2290               - frame Dialog-Frame :width-chars
     2291           ,input true
     2292           ) .
     2293         assign
     2294           v-diasize-need-maximize = false
     2295         .
     2296       end.
     2297       else do:
     2298         run diasize_change-width in this-procedure
     2299           (input v-diasize-orig-frame-width
     2300               - frame Dialog-Frame :width-chars
     2301           ,input true
     2302           ) .
     2303         run diasize_change-height in this-procedure
     2304           (input v-diasize-orig-frame-height
     2305               - frame Dialog-Frame :height-chars
     2306           ,input true
     2307           ) .
     2308         assign
     2309           v-diasize-need-maximize = true
     2310         .
     2311       end.
     2312     end.
     2313   end procedure.
     2314   procedure diasize_restore-orig-size :
     2315     do
     2316     on error undo, return error return-value
     2317     :
     2318       assign
     2319         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2320         v-diasize-current-frame-height = frame Dialog-Frame :height
     2321       .
     2322       run diasize_set-height in this-procedure
     2323         (input  v-diasize-orig-frame-height
     2324         ,input  true
     2325         ) .
     2326       run diasize_set-width in this-procedure
     2327         (input  v-diasize-orig-frame-width
     2328         ,input  true
     2329         ) .
     2330     end.
     2331   end procedure.
     2332   procedure diasize_restore-current-size :
     2333     do
     2334     on error undo, return error return-value
     2335     :
     2336       run diasize_set-height in this-procedure
     2337         (input  v-diasize-current-frame-height
     2338         ,input  true
     2339         ) .
     2340       run diasize_set-width in this-procedure
     2341         (input  v-diasize-current-frame-width
     2342         ,input  true
     2343         ) .
     2344     end.
     2345   end procedure.
     2346   procedure diasize_set-browse-handle :
     2347     define input  parameter p-browse-handle as handle   no-undo .
     2348     define buffer buf_temp-browse-handle for temp-browse-handle .
     2349     do
     2350     on error undo, return error return-value
     2351     :
     2352       assign
     2353         v-diasize-browse-handle = p-browse-handle
     2354       .
     2355       for each buf_temp-browse-handle
     2356       on error undo, return error return-value
     2357       :
     2358         delete buf_temp-browse-handle .
     2359       end.
     2360     end.
     2361   end procedure.
     2362   procedure diasize_add_browse :
     2363     define input  parameter p-browse-type   as character no-undo .
     2364     define input  parameter p-browse-handle as handle    no-undo .
     2365     define buffer buf_temp-browse-handle for temp-browse-handle .
     2366     do
     2367     on error undo, return error return-value
     2368     :
     2369       assign
     2370         v-diasize-browse-number = v-diasize-browse-number + 1
     2371       .
     2372       create buf_temp-browse-handle .
     2373       assign
     2374         buf_temp-browse-handle.browse-type   = p-browse-type
     2375         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2376         buf_temp-browse-handle.browse-handle = p-browse-handle
     2377       .
     2378     end.
     2379   end procedure.
     2380   procedure diasize_init :
     2381     define variable v-default-value    as logical   no-undo .
     2382     define variable v-restore-saved    as logical   no-undo .
     2383     define variable v-resize-value-str as character no-undo .
     2384     do
     2385     on error undo, return error return-value
     2386     :
     2387       do with frame Dialog-Frame
     2388       :
     2389         assign
     2390           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2391           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2392           v-diasize-browse-handle     = browse br-rule-profile :handle
     2393         .
     2394         create button v-diasize-resize-button
     2395         assign
     2396           parent        = frame Dialog-Frame :first-child
     2397           label         = "s"
     2398           height-pixels = 16
     2399           width-pixels  = 16
     2400           visible       = true
     2401           sensitive     = true
     2402           movable       = true
     2403           triggers:
     2404             on end-move persistent run diasize_end-move in this-procedure .
     2405           end triggers.
     2406         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2407         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2408         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2409         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2410         assign
     2411           v-diasize-wndmax = false
     2412         .
     2413         if connected("ub") = true
     2414         then do:
     2415           define variable v-cntxt-db-num        as integer   no-undo .
     2416           define variable v-cntxt-userid        as character no-undo .
     2417           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2418                                             , OUTPUT v-cntxt-userid
     2419                                             ) .
     2420           run gbl/wndpar_r.p
     2421             (input  v-cntxt-db-num
     2422             ,input  v-cntxt-userid
     2423             ,input  'wndmax':U
     2424             ,output v-diasize-wndmax
     2425             ,output v-default-value
     2426             ) .
     2427         end.
     2428         assign
     2429           v-diasize-wndstore = false
     2430         .
     2431         if connected("ub") = true
     2432         then do:
     2433           run gbl/wndpar_r.p
     2434             (input  v-cntxt-db-num
     2435             ,input  v-cntxt-userid
     2436             ,input  'wndstore':U
     2437             ,output v-diasize-wndstore
     2438             ,output v-default-value
     2439             ) .
     2440         end.
     2441         assign
     2442           v-diasize-proc-name = entry(1, program-name(2), '.')
     2443         .
     2444         if v-diasize-wndstore = true
     2445         then do:
     2446           assign
     2447             v-restore-saved = false
     2448           .
     2449           if connected("ub") = true
     2450           then do:
     2451             run gbl/wndsizer.p
     2452               (input  v-cntxt-db-num
     2453               ,input  v-cntxt-userid
     2454               ,input  v-diasize-proc-name
     2455               ,input  'height':u
     2456               ,output v-resize-value-str
     2457               ) .
     2458             if v-resize-value-str <> '':U
     2459             then do:
     2460               run diasize_change-height in this-procedure
     2461                 (input  integer(v-resize-value-str)
     2462                 ,input  true
     2463                 ) .
     2464               assign
     2465                 v-restore-saved = true
     2466               .
     2467             end.
     2468           end.
     2469           if connected("ub") = true
     2470           then do:
     2471             run gbl/wndsizer.p
     2472               (input  v-cntxt-db-num
     2473               ,input  v-cntxt-userid
     2474               ,input  v-diasize-proc-name
     2475               ,input  'width':u
     2476               ,output v-resize-value-str
     2477               ) .
     2478             if v-resize-value-str <> '':U
     2479             then do:
     2480               run diasize_change-width in this-procedure
     2481                 (input  integer(v-resize-value-str)
     2482                 ,input  true
     2483                 ) .
     2484               assign
     2485                 v-restore-saved = true
     2486               .
     2487             end.
     2488           end.
     2489           if v-restore-saved <> true
     2490           then do:
     2491             if v-diasize-wndmax = true
     2492             then do:
     2493               run diasize_maximize in this-procedure
     2494                 (input  true
     2495                 ) .
     2496             end.
     2497           end.
     2498         end.
     2499         else do:
     2500           if v-diasize-wndmax = true
     2501           then do:
     2502             run diasize_maximize in this-procedure
     2503               (input  true
     2504               ) .
     2505           end.
     2506         end.
     2507       end.
     2508     end.
     2509   end procedure.
     2510   procedure diasize_need-full-display :
     2511     define output parameter p-need-full-display as logical   no-undo .
     2512     do
     2513     on error undo, return error return-value
     2514     :
     2515       assign
     2516         p-need-full-display = v-diasize-need-full-display
     2517       .
     2518       assign
     2519         v-diasize-need-full-display = false
     2520       .
     2521     end.
     2522   end procedure.
     2523   procedure get-context :
     2524      define output parameter p-db-num as integer          no-undo.
     2525      define output parameter p-user-id as character        no-undo.
     2526      define variable v-login               as character    no-undo.
     2527      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2528      define buffer buf_user-login  for ub.user-login .
     2529      do
     2530      on error undo, return error
     2531      :
     2532            FIND FIRST buf_sys-ctrl no-lock.
     2533            ASSIGN
     2534               v-login = USERID("ub")
     2535               p-db-num = buf_sys-ctrl.db-num
     2536            .
     2537            FIND FIRST buf_user-login
     2538                 WHERE buf_user-login.db-num = p-db-num
     2539                   AND buf_user-login.user-login = v-login
     2540                 no-lock
     2541                 no-error
     2542                 .
     2543            IF AVAILABLE buf_user-login
     2544            THEN DO:
     2545               assign
     2546                  p-user-id = buf_user-login.user-id
     2547               .
     2548            END.
     2549      end.
     2550   end procedure.
     2551       run diasize_init in this-procedure .
     2552   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2553   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2554   MAIN-BLOCK:
     2555   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2556      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2557   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2558     run mainmenu_getcntxt in parparentproc
     2559       (output v-cntxt-db-num
     2560       ,output v-cntxt-userid
     2561       ,output v-cntxt-level
     2562       ,output v-cntxt-host-code-obj
     2563       ,output v-cntxt-obj-type
     2564       ,output v-cntxt-obj-code
     2565       ,output v-cntxt-db-num-obj
     2566       ,output v-cntxt-is-admin
     2567       ) .
     2568     run Myenable in this-procedure .
     2569     v-rid-list = p-rid-list.
     2570     WAIT-FOR GO OF FRAME Dialog-Frame.
     2571   END.
     2572   RUN disable_UI.
     2573   PROCEDURE disable_UI :
     2574     HIDE FRAME Dialog-Frame.
     2575   END PROCEDURE.
     2576   PROCEDURE enable_UI :
     2577     DISPLAY mark-num
     2578         WITH FRAME Dialog-Frame.
     2579     ENABLE b-quit b-mark b-sel b-add b-chg b-del b-lkp b-link B-cmp B-Help
     2580            br-rule-profile mark-num
     2581         WITH FRAME Dialog-Frame.
     2582     VIEW FRAME Dialog-Frame.
     2583     RUN openbr IN THIS-PROCEDURE.
     2584   END PROCEDURE.
     2585   PROCEDURE MyEnable :
     2586   ASSIGN
     2587   X_rule-profile.NAME:RESIZABLE IN BROWSE br-rule-profile = YES
     2588   X_rule-profile.param-value:RESIZABLE IN BROWSE br-rule-profile = YES
     2589   b-link:MENU-MOUSE IN FRAME Dialog-Frame = 1
     2590   b-lkp:MENU-MOUSE IN FRAME Dialog-Frame = 1
     2591   .
     2592   if p-list-mode = "general-view" then do:
     2593     case p-general-view:
     2594       when 'dis-card-type':U then do:
     2595         assign
     2596         frame Dialog-Frame :title = substitute("Профайлы работы с ДК").
     2597       end.
     2598       when 'chk-doc':U then do:
     2599         assign
     2600         frame Dialog-Frame :title = substitute("Профайлы для расчета скидок и бонусов на POS IBS TH").
     2601       end.
     2602     end case.
     2603   end.
     2604   ENABLE
     2605   b-quit
     2606   b-add when (lookup("b-add", bttns) > 0 and v-cntxt-db-num = 0)
     2607   b-chg when (lookup("b-add", bttns) > 0 and v-cntxt-db-num = 0 and p-list-mode <> "term")
     2608   b-del when (lookup("b-add", bttns) > 0 and v-cntxt-db-num = 0 and p-list-mode = "term")
     2609   b-lkp
     2610   B-Help
     2611   b-mark when lookup("b-mark", bttns) > 0
     2612   b-sel when lookup("b-sel", bttns) > 0
     2613   b-link
     2614   b-cmp when (lookup("b-add", bttns) > 0 and v-cntxt-db-num = 0 and p-list-mode <> "term")
     2615   br-rule-profile
     2616   WITH FRAME Dialog-Frame.
     2617   VIEW FRAME Dialog-Frame.
     2618   if p-list-mode = "general-view" then do:
     2619     assign
     2620     X_rule-profile.profile-type:visible in browse br-rule-profile = no.
     2621   end.
     2622   if p-list-mode = "term" then do:
     2623     assign
     2624     frame Dialog-Frame:title = substitute("Профайлы, подчиненные профайлу &1", p-general-view).
     2625   end.
     2626   if lookup("b-add", bttns) = 0 then do:
     2627     hide
     2628     b-cmp in frame Dialog-Frame .
     2629   end.
     2630   run Openbr in this-procedure .
     2631   END PROCEDURE.
     2632   PROCEDURE Openbr :
     2633   define variable v-term-rp-list as character no-undo .
     2634   define buffer buf_profile-by-profile for ub.profile-by-profile.
     2635   CASE p-list-mode:
     2636      when 'все':U then do:
     2637         frame Dialog-Frame :title = "Все профайлы".
     2638         OPEN QUERY br-rule-profile
     2639         FOR EACH X_rule-profile NO-LOCK INDEXED-REPOSITION.
     2640      end.
     2641      when "general-view" then do:
     2642         frame Dialog-Frame :title = substitute("Профайлы типа &1", p-general-view).
     2643         OPEN QUERY br-rule-profile
     2644         FOR EACH X_rule-profile NO-LOCK where
     2645                  entry(1, X_rule-profile.profile-type, "_")  = p-general-view
     2646         by X_rule-profile.profile_id
     2647        INDEXED-REPOSITION
     2648         .
     2649      end.
     2650      when "term" then do:
     2651            frame Dialog-Frame :title = substitute("Профайлы подчиненные профайлу &1", p-general-view).
     2652         for each buf_profile-by-profile no-lock where
     2653                 buf_profile-by-profile.profile_id = integer(p-general-view):
     2654           v-term-rp-list = v-term-rp-list + (if v-term-rp-list = '' then '' else chr(44)) + string(buf_profile-by-profile.child-profile_id).
     2655         end.
     2656         OPEN QUERY br-rule-profile
     2657         FOR EACH X_rule-profile NO-LOCK where
     2658                  lookup(string(X_rule-profile.profile_id), v-term-rp-list) > 0
     2659         by X_rule-profile.profile_id
     2660        INDEXED-REPOSITION
     2661         .
     2662      end.
     2663   end case.
     2664   END PROCEDURE.
     2665   PROCEDURE proc-b-link :
     2666   DEFINE INPUT PARAMETER p-option AS CHARACTER NO-UNDO.
     2667   DEFINE variable v-rid-list AS CHARACTER NO-undo.
     2668   DEFINE variable v-uniq-key-rec AS CHARACTER NO-undo.
     2669   define buffer buf_rule-by-call for ub.rule-by-call.
     2670   define buffer buf_ruledict for ub.ruledict.
     2671   define buffer buf_rule-call-param for ub.rule-call-param.
     2672   define buffer buf_rp-rule-param for ub.rp-rule-param.
     2673   CASE p-option:
     2674     WHEN 'rule-profile':U THEN DO:
     2675       run rul/rule-profile-s.w ( INPUT parparentproc
     2676                                 ,INPUT (if v-cntxt-db-num = 0
     2677                                         and lookup("b-add", bttns) > 0
     2678                                         then "b-add":U
     2679                                         else "")
     2680                                 ,INPUT "term"
     2681                                 ,INPUT string(X_rule-profile.profile_id)
     2682                                 ,INPUT-OUTPUT v-rid-list) NO-ERROR.
     2683     end.
     2684     WHEN 'rule':U THEN DO:
     2685       run rul/rule-by-profile-s.w ( INPUT parparentproc
     2686                                 ,INPUT (if v-cntxt-db-num = 0
     2687                                         and lookup("b-add", bttns) > 0
     2688                                         then "b-add":U
     2689                                         else "")
     2690                                 ,INPUT "profile"
     2691                                 ,INPUT X_rule-profile.profile_id
     2692                                 ,INPUT 0
     2693                                 ,INPUT 0
     2694                                 ,INPUT 0
     2695                                 ,INPUT-OUTPUT v-rid-list) NO-ERROR.
     2696     END.
     2697     WHEN 'rp-by-call':U THEN DO:
     2698       run rul/rp-by-call-s.w ( INPUT parparentproc
     2699                               ,INPUT "":U
     2700                               ,INPUT "profile-id"
     2701                               ,INPUT X_rule-profile.profile_id
     2702                               ,INPUT '':U
     2703                               ,input ''
     2704                               ,input 0
     2705                               ,input 0
     2706                               ,INPUT-OUTPUT v-rid-list
     2707                               ) NO-ERROR.
     2708     END.
     2709     WHEN 'ruledict-param':U THEN DO:
     2710       run gen-key-rec in this-procedure (
     2711                                           input 'rule-profile':U
     2712                                           ,input  buffer X_rule-profile:handle
     2713                                           ,output v-uniq-key-rec
     2714                                           ).
     2715       FIND FIRST buf_ruledict NO-LOCK WHERE
     2716                 buf_ruledict.entry-type = 'rule-profile':U
     2717             AND buf_ruledict.uniq-key-rec = v-uniq-key-rec.
     2718       run rul/ruledict-param-s.w ( INPUT parparentproc
     2719                                 ,input ?
     2720                                 ,INPUT "":U
     2721                                 ,INPUT "entry-id"
     2722                                 ,INPUT buf_ruledict.entry-id
     2723                                 ,input 'rule':U
     2724                                 ,INPUT-OUTPUT v-rid-list) NO-ERROR.
     2725     END.
     2726      WHEN 'rule-call-param':U THEN DO:
     2727       for each tt0-rule-call-param:
     2728         delete tt0-rule-call-param.
     2729       end.
     2730       define variable jj as integer no-undo .
     2731       define buffer buf_tt0-rule-call-param for tt0-rule-call-param.
     2732       for each buf_rule-by-call no-lock where
     2733               buf_rule-by-call.profile_id = X_rule-profile.profile_id,
     2734         each buf_rp-rule-param no-lock where
     2735               buf_rp-rule-param.profile_id = X_rule-profile.profile_id,
     2736         each buf_rule-call-param no-lock where
     2737                 buf_Rule-call-param.call#_id = buf_rule-by-call.call#_id
     2738             and buf_Rule-call-param.codex_id = buf_rule-by-call.codex_id
     2739             and buf_Rule-call-param.ruleset_id = buf_rule-by-call.ruleset_id
     2740             and buf_Rule-call-param.order_id = buf_rule-by-call.order_id
     2741             and buf_Rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     2742       break
     2743       by  buf_rule-call-param.call_id
     2744       by  buf_rp-rule-param.profile_id
     2745       by  buf_rp-rule-param.rp-param-name
     2746       :
     2747         find first tt0-rule-call-param where
     2748                   tt0-rule-call-param.call_id = buf_rule-call-param.call_id
     2749               and tt0-rule-call-param.codex_id = buf_rule-call-param.codex_id
     2750               and tt0-rule-call-param.ruleset_id = buf_rule-call-param.ruleset_id
     2751               and tt0-rule-call-param.order_id = buf_rule-call-param.order_id
     2752               and tt0-rule-call-param.param-name = buf_rule-call-param.param-name no-error .
     2753         if not available tt0-rule-call-param then do:
     2754           find first buf_tt0-rule-call-param no-lock where
     2755                   buf_tt0-rule-call-param.call_id = buf_rule-call-param.call_id
     2756               and buf_tt0-rule-call-param.whole-send-news = jj no-error.
     2757           create tt0-rule-call-param.
     2758           buffer-copy buf_rule-call-param to tt0-rule-call-param.
     2759           release tt0-rule-call-param.
     2760         end.
     2761       end.
     2762       run ref/rulercps.w ( INPUT parparentproc
     2763                           ,input this-procedure:handle
     2764                           ,INPUT "":U
     2765                           ,input 'ПРОСМОТР':U
     2766                           ,input 'rp-rule-param':U + chr(44) + 'все':U
     2767                           ,input X_rule-profile.profile_id
     2768                           ,input ?
     2769                           ,input '':U
     2770                           ,input 0
     2771                           ,input 0
     2772                           ,input ?
     2773                           ,input 0
     2774                           ,input substitute("Параметры вызова профайла &1"
     2775                                             , X_rule-profile.profile_id
     2776                                             )
     2777                           ,input-output table tt0-rule-call-param ) no-error.
     2778     END.
     2779   END CASE.
     2780   END PROCEDURE.
     2781   PROCEDURE proc-b-lkp :
     2782   DEFINE INPUT PARAMETER p-option AS CHARACTER NO-UNDO.
     2783   define variable v-rec as recid no-undo.
     2784   CASE p-option:
     2785     WHEN 'rule-profile':U THEN DO:
     2786         v-rec = recid(X_rule-profile).
     2787         run rul/rule-profile-i.w ( input parparentproc
     2788                              ,input 'ПРОСМОТР':U
     2789                              ,input X_rule-profile.profile_id
     2790                              ,input-output v-rec) no-error.
     2791     END.
     2792     WHEN "ruleproc-text" THEN DO:
     2793       run rul/run-rule-proc-view.p ( INPUT X_rule-profile.profile-type
     2794                                     ,INPUT '':U
     2795                                     ,INPUT X_rule-profile.profile_id
     2796                                     ,INPUT "text"
     2797                                     ) NO-ERROR.
     2798     END.
     2799     WHEN "ruleproc-graph" THEN DO:
     2800       run rul/run-rule-proc-view.p ( INPUT X_rule-profile.profile-type
     2801                                     ,INPUT '':U
     2802                                     ,INPUT X_rule-profile.profile_id
     2803                                     ,INPUT "graph"
     2804                                     ) NO-ERROR.
     2805     END.
     2806   END CASE.
     2807   IF ERROR-STATUS:ERROR THEN UNDO, RETURN ERROR.
     2808   END PROCEDURE.
     2809   PROCEDURE proc-b-term :
     2810   define input parameter p-parent-profile-id as integer no-undo .
     2811   define input parameter p-mode as character no-undo .
     2812   define output parameter p-rec as recid no-undo .
     2813   define variable v-rid-list as character no-undo .
     2814   define variable v-rec as recid no-undo .
     2815   define buffer buf_rule-profile for ub.rule-profile.
     2816   if p-list-mode <> "term" then do:
     2817     message
     2818     "Нельзя добавлять/удалять в этом режиме"
     2819     view-as alert-box .
     2820     return error.
     2821   end.
     2822   case p-mode :
     2823     when 'ДОБАВЛЕНИЕ':U then do:
     2824       message
     2825       "Выберите подчиненный профайл"
     2826       view-as alert-box .
     2827       run rul/rule-profile-s.w ( INPUT parparentproc
     2828                                 ,INPUT "b-sel"
     2829                                 ,INPUT 'все':U
     2830                                 ,INPUT ""
     2831                                 ,INPUT-OUTPUT v-rid-list) NO-ERROR.
     2832       if v-rid-list <> '' then do:
     2833           find first buf_rule-profile no-lock where
     2834                       recid(buf_rule-profile) = integer(v-rid-list).
     2835               run rul/profile-by-profile1.p ( input 'ДОБАВЛЕНИЕ':U
     2836                                     ,input no
     2837                                     ,input-output v-rec
     2838                                     ,input p-parent-profile-id
     2839                                     ,input buf_rule-profile.profile_id
     2840                                     ) no-error.
     2841           if error-status:error then do:
     2842             undo, return error .
     2843           end.
     2844           p-rec = v-rec.
     2845       end.
     2846     end.
     2847     when 'удаление':U then do:
     2848       define buffer buf_profile-by-profile for ub.profile-by-profile.
     2849       find first buf_profile-by-profile no-lock where
     2850                 buf_profile-by-profile.profile_id = integer(p-general-view)
     2851            and  buf_profile-by-profile.child-profile_id = X_rule-profile.profile_id.
     2852       v-rec = recid(buf_profile-by-profile).
     2853       run rul/profile-by-profile3.p ( input no
     2854                                   ,input v-rec) no-error.
     2855       if error-status:error then do:
     2856         undo, return error .
     2857       end.
     2858     end.
     2859   end case.
     2860   END PROCEDURE.
     2861   PROCEDURE set-row-color :
     2862   DEFINE INPUT PARAMETER p-parent-feature AS integer NO-UNDO.
     2863   if p-parent-feature = integer('1':U) then do:
     2864     assign
     2865     X_rule-profile.name:BGCOLOR IN BROWSE br-rule-profile = GRAY_COLOR
     2866       .
     2867   end.
     2868   else do:
     2869     assign
     2870     X_rule-profile.name:BGCOLOR IN BROWSE br-rule-profile = ?
     2871       .
     2872   end.
     2873   END PROCEDURE.
