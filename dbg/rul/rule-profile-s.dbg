     1557         end.
     1558       end.
     1559       assign
     1560         v-diasize-need-full-display = true
     1561       .
     1562       if v-diasize-change-size = false
     1563       then do:
     1564         assign
     1565           v-diasize-change-size = true
     1566         .
     1567       end.
     1568       else do:
     1569         return .
     1570       end.
     1571       assign
     1572         v-frame-height = frame Dialog-Frame :height
     1573         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1574         v-browse-height = v-diasize-browse-handle :height
     1575       .
     1576       for each buf_temp-browse-handle
     1577         where buf_temp-browse-handle.browse-type = 'height':u
     1578       :
     1579         assign
     1580           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1581         .
     1582       end.
