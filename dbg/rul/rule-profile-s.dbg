     1145     glog = br-rule-profile:refresh() .
     1146     if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1147         glog = br-rule-profile:select-next-row ().
     1148         apply "VALUE-CHANGED" to br-rule-profile in frame Dialog-Frame.
     1149     end.
     1150     if num-entries( v-rid-list ) = 0
     1151     then
     1152         hide mark-num in frame Dialog-Frame.
     1153     else
     1154         disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1155   end.
     1156   apply "entry" to br-rule-profile in frame Dialog-Frame.
     1157   END.
