     1781     .
     1782   end procedure.
     1783   procedure diasize_set-height :
     1784     define input  parameter p-new-height  as decimal   no-undo .
     1785     define input  parameter p-move-resize as logical   no-undo .
     1786     do
     1787     on error undo, return error return-value
     1788     :
     1789       run diasize_change-height in this-procedure
     1790         (input  (p-new-height - frame Dialog-Frame :height)
     1791         ,input  p-move-resize
     1792         ) .
     1793     end.
     1794   end procedure.
     1795   procedure diasize_change-width :
     1796     define input  parameter p-change-value as decimal   no-undo .
     1797     define input  parameter p-move-resize  as logical   no-undo .
     1798     define variable v-field-group-handle   as handle    no-undo .
     1799     define variable v-object-handle        as handle    no-undo .
     1800     define variable v-frame-width          as decimal   no-undo .
     1801     define variable v-frame-virtual-width  as decimal   no-undo .
     1802     define variable v-browse-width         as decimal   no-undo .
     1803     define variable v-window-width         as decimal   no-undo .
     1804     define variable v-window-virtual-width as decimal   no-undo .
     1805     define variable v-change-sign          as integer   no-undo .
     1806     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1807     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1808     if p-change-value > 0
     1809     then do:
     1810       if frame Dialog-Frame :width + p-change-value >
     1811           session :width-chars
     1812       then do:
     1813         assign
     1814           p-change-value = session :width-chars - frame Dialog-Frame :width
     1815         .
     1816         if p-change-value <= 0
     1817         then do:
     1818           run diasize_position-resize-button in this-procedure .
     1819           return .
     1820         end.
     1821       end.
     1822     end.
     1823     if p-change-value < 0
     1824     then do:
     1825       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1826       then do:
     1827         assign
     1828           p-change-value = v-diasize-orig-frame-width
     1829                          - frame Dialog-Frame :width
     1830         .
     1831         if p-change-value >= 0
     1832         then do:
     1833           run diasize_position-resize-button in this-procedure .
     1834           return .
     1835         end.
     1836       end.
     1837     end.
     1838     if p-change-value >= 0
     1839     then do:
     1840       assign
     1841         v-change-sign = 1
     1842       .
     1843     end.
     1844     else do:
     1845       assign
     1846         v-change-sign = -1
     1847       .
     1848     end.
     1849     assign
     1850       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1851     .
     1852     if p-change-value = 0
     1853     then do:
     1854       run diasize_position-resize-button in this-procedure .
     1855       return .
     1856     end.
     1857     move_block:
     1858     do
     1859     on error undo move_block, leave move_block
     1860     :
     1861       if retry
     1862       then do:
     1863         do
     1864         on error undo move_block, leave move_block
     1865         :
     1866           if p-change-value > 0
     1867           then do:
     1868             for each buf_temp-diasize-handle
     1869             on error undo, next
     1870             :
     1871               assign
     1872                 v-object-handle = buf_temp-diasize-handle.handle-value
     1873               .
