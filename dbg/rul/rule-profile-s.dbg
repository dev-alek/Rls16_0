     1658         or error-status :get-message(1) <> ""
     1659         then do:
     1660           undo move_block, retry move_block .
     1661         end.
     1662         for each buf_temp-browse-handle
     1663           where buf_temp-browse-handle.browse-type = 'height':u
     1664         on error undo move_block, retry move_block
     1665         :
     1666           assign
     1667             buf_temp-browse-handle.browse-handle :height
     1668               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1669             no-error .
     1670           if error-status :error
     1671           or error-status :get-message(1) <> ""
     1672           then do:
     1673             undo move_block, retry move_block .
