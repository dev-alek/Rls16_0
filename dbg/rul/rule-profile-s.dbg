     1126     if available X_rule-profile then do:
     1127   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1128   define variable v-str-recid6 as character no-undo .
     1129   define variable v-num-entry6 as integer   no-undo .
     1130   assign
