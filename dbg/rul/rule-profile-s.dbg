     1952         .
     1953       end.
     1954       else do:
     1955         return .
     1956       end.
     1957       assign
     1958         v-frame-width = frame Dialog-Frame :width
     1959         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1960         v-browse-width = v-diasize-browse-handle :width
     1961       .
