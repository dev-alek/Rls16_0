     2213   procedure get-db-list-for-d-card2 :
     2214   define input parameter p-d-card as character no-undo .
     2215   define variable v-current-db-processed as logical no-undo .
     2216   define buffer buf_clients  for ub.clients.
     2217   define buffer buf_dis-obj for ub.dis-obj.
     2218   define buffer buf_temp-smart-route for temp-smart-route.
     2219     do
     2220     on error undo, return error return-value
     2221     :
     2222       for each buf_dis-obj no-lock where
     2223               buf_dis-obj.d-card = p-d-card,
     2224          first buf_clients no-lock where
     2225               buf_clients.obj-type = buf_dis-obj.obj-type
     2226           and buf_clients.obj-code = buf_dis-obj.obj-code
     2227       break by
     2228       buf_clients.db-num:
     2229         if first-of(buf_Clients.db-num) then do:
     2230           find first buf_temp-smart-route no-lock where
     2231                 buf_temp-smart-route.key-field = p-d-card
     2232             and buf_temp-smart-route.db-num = buf_clients.db-num
     2233                 no-error.
     2234           if available buf_temp-smart-route then return.
     2235           create buf_temp-smart-route.
     2236           assign
     2237           buf_temp-smart-route.key-field = p-d-card
     2238           buf_temp-smart-route.db-num = buf_clients.db-num
     2239           .
     2240           if buf_clients.db-num = g#db-num then do:
     2241             v-current-db-processed = yes.
     2242           end.
     2243         end.
     2244       end.
     2245       if not v-current-db-processed then do:
     2246         find first buf_temp-smart-route no-lock where
     2247               buf_temp-smart-route.key-field = p-d-card
     2248           and buf_temp-smart-route.db-num = g#db-num  no-error.
