     1215   def var vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1216   procedure get-gate-file-name :
     1217   define input parameter p-gate-rec as character no-undo .
     1218   define output  parameter p-gate-file-name as character no-undo .
     1219   define buffer buf_clob-data for ub.clob-data.
     1220   define variable v-tbl-row as rowid no-undo .
     1221   define variable v-tbl-name as character no-undo .
     1222   run gen-row-keyr in this-procedure ( input p-gate-rec
     1223                                       ,input ?
     1224                                       ,input "ub"
     1225                                       ,input ?
     1226                                       ,input no-lock
     1227                                       ,output v-tbl-row
     1228                                       ,output v-tbl-name) no-error.
     1229   if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     1230                                                           ,vss-include-info13
     1231                                                           ,p-gate-rec).
     1232   find first buf_clob-data no-lock where
     1233             rowid(buf_clob-data) = v-tbl-row no-error.
     1234   if not available buf_clob-data then do:
     1235     if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     1236                                                             ,vss-include-info13
     1237                                                             ,p-gate-rec).
     1238   end.
     1239   p-gate-file-name = buf_clob-data.file-name.
     1240   end procedure.
     1241   procedure get-gate-rec :
     1242   define input  parameter p-gate-name as character no-undo .
     1243   define output parameter p-gate-rec as character no-undo .
     1244   define buffer buf_clob-bind for ub.clob-bind.
     1245   define buffer buf_clob-data for ub.clob-data.
     1246   main-block:
     1247   do
     1248   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info13, return-value, chr(10), error-status :get-message (1))
     1249   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info13 )
     1250   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info13 )
     1251   :
     1252       find first buf_clob-bind no-lock where
     1253                 buf_clob-bind.uniq-key-rec = p-gate-name
     1254             and buf_clob-bind.field-name = '':U
     1255             and buf_clob-bind.part-num = 1
     1256             and buf_clob-bind.resource-type = 'gate':U
     1257             no-error.
     1258       if not available buf_clob-bind then do:
     1259         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     1260                                         , p-gate-name
     1261                                         ).
     1262       end.
     1263       find first buf_clob-data no-lock where
     1264                 buf_clob-data.db-num = buf_clob-bind.db-num
     1265             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     1266       if not available buf_clob-data then do:
     1267         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1268                                         , buf_clob-bind.db-num
     1269                                         , buf_clob-bind.int64-id
     1270                                         , p-gate-name
     1271                                         ).
     1272       end.
     1273       run gen-key-rec in this-procedure ( input 'clob-data':U
     1274                                 ,input buffer buf_clob-data:handle
     1275                                 ,output p-gate-rec).
     1276   end.
     1277   end procedure.
     1278   procedure get-gate-by-name :
     1279   define input  parameter p-gate-name as character no-undo .
     1280   define output parameter p-gate-rec as character no-undo .
     1281   define output parameter p-dsh as handle no-undo .
     1282   define input-output  parameter p-xmlh as handle no-undo .
     1283   define variable v-ii as integer   no-undo .
     1284   define variable glog as logical   no-undo .
     1285   define variable v-longchar as longchar no-undo .
     1286   define variable v-txmlh as handle no-undo .
     1287   define variable v-db-num as integer no-undo .
     1288   define variable v-int64-id as int64 no-undo .
     1289   define buffer buf_clob-bind for ub.clob-bind.
     1290   define buffer buf_clob-data for ub.clob-data.
     1291   main-block:
     1292   do
     1293   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info13, return-value, chr(10), error-status :get-message (1))
     1294   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info13 )
     1295   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info13 )
     1296   :
     1297       find first buf_clob-bind no-lock where
     1298                 buf_clob-bind.uniq-key-rec = p-gate-name
     1299             and buf_clob-bind.field-name = '':U
     1300             and buf_clob-bind.part-num = 1
     1301             and buf_clob-bind.resource-type = 'gate':U
     1302             no-error.
     1303       if not available buf_clob-bind then do:
     1304         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     1305                                         , p-gate-name
     1306                                         ).
     1307       end.
     1308       find first buf_clob-data no-lock where
     1309                 buf_clob-data.db-num = buf_clob-bind.db-num
     1310             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     1311       if not available buf_clob-data then do:
     1312         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1313                                         , buf_clob-bind.db-num
     1314                                         , buf_clob-bind.int64-id
     1315                                         , p-gate-name
     1316                                         ).
     1317       end.
     1318       assign
     1319       v-longchar = buf_clob-data.cdata
     1320       .
     1321       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1322       if error-status :error then do:
     1323         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1324       end.
     1325       create dataset p-dsh .
     1326       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1327                                     , v-longchar
     1328                                     , ?
     1329                                     , ?
     1330                                     , ?
     1331                                     ) no-error.
     1332       v-longchar = '':U.
     1333       if error-status :error
     1334       or not glog
     1335       then do:
     1336         undo, return error substitute("Не удалось прочитать XML-схему &1 из БД:&2&3", p-gate-name, chr(10), error-status:get-message(1) ).
     1337       end.
     1338       if not valid-handle(p-xmlh)
     1339       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1340         create temp-table v-txmlh.
     1341         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1342         v-txmlh:temp-table-prepare("temp-xml-tables").
     1343         p-xmlh = v-txmlh:default-buffer-handle.
     1344       end.
     1345       run gen-key-rec in this-procedure ( input 'clob-data':U
     1346                                 ,input buffer buf_clob-data:handle
     1347                                 ,output p-gate-rec).
     1348       do v-ii = 1 to p-dsh:num-buffers:
     1349         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1350         if not p-xmlh:available then do:
     1351           p-xmlh:buffer-create().
     1352           assign
     1353           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1354           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1355           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1356           p-xmlh::gate-handle_ = p-dsh
     1357           p-xmlh::uniq-gate-rec = p-gate-rec
     1358           p-xmlh::gate-name = p-dsh:name
     1359           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1360           .
     1361           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1362             assign
     1363             p-xmlh::order = -3.
     1364           end.
     1365         end.
     1366       end.
     1367   end.
     1368   end procedure.
     1369   procedure get-gate-by-rec :
     1370   define input  parameter p-gate-rec as character no-undo .
     1371   define output parameter p-dsh as handle no-undo .
     1372   define input-output  parameter p-xmlh as handle no-undo .
     1373   define input-output parameter p-longchar  as longchar no-undo .
     1374   define variable v-ii as integer   no-undo .
     1375   define variable glog as logical   no-undo .
     1376   define variable v-rowid as rowid no-undo .
     1377   define variable v-tbl-name as character no-undo .
     1378   define variable v-longchar as longchar no-undo .
     1379   define variable v-txmlh as handle no-undo .
     1380   define buffer buf_clob-data for ub.clob-data.
     1381   main-block:
     1382   do
     1383   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info13, return-value, chr(10), error-status :get-message (1))
     1384   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info13 )
     1385   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info13 )
     1386   :
     1387     run gen-row-keyr in this-procedure (
     1388                                           input  p-gate-rec
     1389                                           ,input  ?
     1390                                           ,input  "ub"
     1391                                           ,input  ?
     1392                                           ,input  NO-LOCK
     1393                                           ,output v-rowid
     1394                                           ,output v-tbl-name   ) no-error.
     1395       find first buf_clob-data no-lock where
     1396                 rowid(buf_clob-data) = v-rowid  no-error.
     1397       if not available buf_clob-data then do:
     1398         undo, return error substitute("Не найден CLOB  &1"
     1399                                         , p-gate-rec
     1400                                         ).
     1401       end.
     1402       assign
     1403       v-longchar = buf_clob-data.cdata
     1404       .
     1405       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1406       if error-status :error then do:
     1407         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1408       end.
     1409       create dataset p-dsh .
     1410       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1411                                     , v-longchar
     1412                                     , ?
     1413                                     , ?
     1414                                     , ?
     1415                                     ) no-error.
     1416       define variable v-esm as character no-undo .
     1417       v-esm = error-status:get-message(1) .
     1418       if p-longchar <> ? then do:
     1419         p-longchar = v-longchar.
     1420       end.
     1421       v-longchar = '':U.
     1422       if error-status :error
     1423       or not glog
     1424       then do:
     1425         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     1426                                      , p-gate-rec
     1427                                      , p-gate-rec
     1428                                      , v-esm
     1429                                      ).
     1430       end.
     1431       p-dsh:private-data = buf_clob-data.file-name_ + chr(4) + p-gate-rec.
     1432       if not valid-handle(p-xmlh)
     1433       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1434         create temp-table v-txmlh.
     1435         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1436         v-txmlh:temp-table-prepare("temp-xml-tables").
     1437         p-xmlh = v-txmlh:default-buffer-handle.
     1438       end.
     1439       do v-ii = 1 to p-dsh:num-buffers:
     1440         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1441         if not p-xmlh:available then do:
     1442           p-xmlh:buffer-create().
     1443           assign
     1444           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1445           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1446           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1447           p-xmlh::gate-handle_ = p-dsh
     1448           p-xmlh::uniq-gate-rec = p-gate-rec
     1449           p-xmlh::gate-name = p-dsh:name
     1450           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1451           .
     1452           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1453             assign
     1454             p-xmlh::order = -3.
     1455           end.
     1456           p-xmlh:buffer-release().
     1457         end.
     1458       end.
     1459   end.
     1460   end procedure.
     1461   procedure get-gate-by-file :
     1462   define input  parameter p-schema-file-name as character no-undo .
     1463   define input  parameter p-gate-rec as character no-undo .
     1464   define output parameter p-dsh as handle no-undo .
     1465   define input-output  parameter p-xmlh as handle no-undo .
     1466   define variable v-ii as integer   no-undo .
     1467   define variable glog as logical   no-undo .
     1468   define variable v-rowid as rowid no-undo .
     1469   define variable v-tbl-name as character no-undo .
     1470   define variable v-longchar as longchar no-undo .
     1471   define variable v-txmlh as handle no-undo .
     1472   main-block:
     1473   do
     1474   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info13, return-value, chr(10), error-status :get-message (1))
     1475   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info13 )
     1476   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info13 )
     1477   :
     1478       COPY-LOB
     1479       FROM  FILE p-schema-file-name
     1480       TO  OBJECT v-longchar
     1481       no-convert
     1482       NO-ERROR .
     1483       if error-status :error then do:
     1484           undo, return error substitute("Не удалось считать файл схемы &1 в память&2&3"
     1485                                     , p-schema-file-name
     1486                                 , chr(10)
     1487                                 , error-status:get-message(1) ).
     1488       end.
     1489       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1490       if error-status :error then do:
     1491         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, p-schema-file-name, chr(10), error-status:get-message(1) , return-value ).
     1492       end.
     1493       create dataset p-dsh .
     1494       glog = p-dsh:READ-XMLSCHEMA( "longchar"
     1495                                     , v-longchar
     1496                                     , ?
     1497                                     , ?
     1498                                     , ?
     1499                                     ) no-error.
     1500       v-longchar = ''.
     1501       if error-status :error
     1502       or not glog
     1503       then do:
     1504         undo, return error substitute("Не удалось прочитать XML-схему из файла &1&2&3"
     1505                                      , p-schema-file-name
     1506                                      ,chr(10)
     1507                                      , error-status:get-message(1)
     1508                                      ).
     1509       end.
     1510       if not valid-handle(p-xmlh)
     1511       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1512         create temp-table v-txmlh.
     1513         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1514         v-txmlh:temp-table-prepare("temp-xml-tables").
     1515         p-xmlh = v-txmlh:default-buffer-handle.
     1516       end.
     1517       do v-ii = 1 to p-dsh:num-buffers:
     1518         p-xmlh:find-first(substitute(' where tbl-name = "&1" and  uniq-gate-rec = "&2" '
     1519                                      ,p-dsh:get-buffer-handle(v-ii):name
     1520                                      ,p-gate-rec
     1521                                      )) no-error.
     1522         if not p-xmlh:available then do:
     1523           p-xmlh:buffer-create().
     1524           assign
     1525           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):table
     1526           p-xmlh::uniq-gate-rec = p-gate-rec
     1527           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1528           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1529           p-xmlh::gate-handle_ = p-dsh
     1530           p-xmlh::gate-name = p-dsh:name
     1531           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1532           .
     1533           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1534             assign
     1535             p-xmlh::order = -3.
     1536           end.
     1537           p-xmlh:buffer-release().
     1538         end.
     1539       end.
     1540   end.
     1541   end procedure.
     1542   procedure gate-clear :
     1543   define input  parameter p-dsh as handle no-undo .
     1544   define input  parameter p-xmlh as handle no-undo .
     1545   define variable v-dsh as handle no-undo .
     1546   define variable v-th as handle no-undo .
     1547     do
     1548     on error undo, return error return-value
     1549     :
     1550       if valid-handle(p-dsh) then do:
     1551         delete object p-dsh.
     1552         v-dsh = p-dsh.
     1553         p-dsh = ?.
     1554       end.
     1555       repeat while true:
     1556         p-xmlh:find-first( substitute( " where gate-handle_ = &1 ", v-dsh)
     1557                            , share-lock) no-error.
     1558         if p-xmlh:available then do:
     1559           assign
     1560           v-th = p-xmlh:buffer-field("table-handle_"):buffer-value.
     1561           if valid-handle(p-xmlh:buffer-field("table-handle_"))
     1562           and valid-handle(v-th)
     1563           and v-th:dynamic = yes
     1564           then do:
     1565             delete object p-xmlh:buffer-field("table-handle_"):buffer-value.
     1566             p-xmlh:buffer-field("table-handle_"):buffer-value = ?.
     1567           end.
     1568           p-xmlh:buffer-delete().
     1569         end.
     1570         else do:
     1571           leave.
     1572         end.
     1573       end.
     1574       if p-xmlh:dynamic = yes
     1575       and valid-handle(p-xmlh)
     1576       then do:
     1577         delete object p-xmlh:table-handle.
     1578         p-xmlh = ?.
     1579       end.
     1580       v-dsh = ?.
     1581     end.
     1582   end procedure.
     1583   procedure all-gates-clear :
     1584   define parameter buffer buf_temp-xml-tables for temp-xml-tables.
     1585   do
     1586   on error undo, return error
     1587   :
     1588     for each buf_temp-xml-tables
     1589     break
     1590     by buf_temp-xml-tables.uniq-gate-rec
     1591     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1592     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1593     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1594     :
     1595         if first-of(buf_temp-xml-tables.uniq-gate-rec) then do:
     1596           delete object buf_temp-xml-tables.gate-handle_.
     1597           buf_temp-xml-tables.gate-handle_ = ?.
     1598         end.
     1599         if valid-handle(buf_temp-xml-tables.table-handle_)
     1600         and buf_temp-xml-tables.table-handle_:dynamic = no
     1601         then do:
     1602           delete object buf_temp-xml-tables.table-handle_.
     1603           buf_temp-xml-tables.table-handle_ = ?.
     1604         end.
     1605         delete buf_temp-xml-tables.
     1606     end.
     1607   end.
     1608   end procedure.
     1609   procedure fix-schemalocation :
     1610   define input-output  parameter p-longchar as longchar no-undo .
     1611   DEFINE VARIABLE hdoc AS HANDLE.
     1612   DEFINE VARIABLE hroot AS HANDLE.
     1613   DEFINE VARIABLE hnode-child AS HANDLE.
     1614   DEFINE VARIABLE hnode-attr AS HANDLE.
     1615   define variable v-jj as integer   no-undo .
     1616   define variable ok as logical   no-undo .
     1617   define variable v-path1                    as character                no-undo .
     1618   DEFINE VARIABLE v-full-path1               as character                no-undo .
     1619   DEFINE VARIABLE v-file-name1               as character                no-undo .
     1620   DEFINE VARIABLE v-file-name-no-ext1        as character                no-undo .
     1621   DEFINE VARIABLE v-file-name-ext1           as character                no-undo .
     1622   define variable v-schema-location          as character                no-undo .
     1623   do
     1624   on error undo, return error return-value
     1625   :
     1626     CREATE X-DOCUMENT hdoc.
     1627     CREATE X-noderef hroot.
     1628     CREATE X-noderef hnode-child.
     1629     CREATE X-noderef hnode-attr.
     1630     hdoc:load("longchar", p-longchar, no) no-error.
     1631     iF ERROR-STATUS:GET-MESSAGE(1) <> '' THEN message ERROR-STATUS:GET-MESSAGE(1) view-as alert-box .
     1632     hdoc:get-document-element(hroot).
     1633     _repeat:
     1634     REPEAT v-jj = 1 TO hroot:NUM-CHILDREN:
     1635       ok = hroot:GET-CHILD(hNode-Child, v-jj).
     1636       if not ok then next.
     1637       if hNode-Child:local-name = "include"
     1638       then do:
     1639         ok = hNode-Child:GET-ATTRIBUTE-NODE( hnode-attr, "schemaLocation" ).
     1640           v-schema-location = hnode-attr:node-value.
     1641           run gbl/filename.p (
     1642                           input "exe/" + hnode-attr:node-value
     1643                         ,output v-full-path1
     1644                         ,output v-path1
     1645                         ,output v-file-name1
     1646                         ,output v-file-name-no-ext1
     1647                         ,output v-file-name-ext1
     1648                         ) no-error .
     1649           if error-status :error then do:
     1650             delete object hnode-attr.
     1651             delete object hnode-child.
     1652             delete object hroot.
     1653             delete object hdoc.
     1654             undo, return error substitute("Не удалось определить расположение схемы &1", v-schema-location).
     1655           end.
     1656         ok = hNode-Child:sET-ATTRIBUTE(  "schemaLocation", v-full-path1 ).
     1657         leave  _repeat.
     1658       end.
     1659     END.
     1660     hdoc:save("longchar", p-longchar).
     1661     delete object hnode-attr.
     1662     delete object hnode-child.
     1663     delete object hroot.
     1664     delete object hdoc.
     1665   end.
     1666   end procedure.
     1667   procedure gate-clb_fill-xml-tables :
     1668   define input parameter p-dsh as handle no-undo .
     1669   define input-output parameter p-xmlh as handle no-undo .
     1670   define variable v-ii as integer no-undo .
     1671     do
     1672     on error undo, return error
     1673     :
     1674       do v-ii = 1 to p-dsh:num-buffers:
     1675         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1676         if not p-xmlh:available then do:
     1677           p-xmlh:buffer-create().
     1678           assign
     1679           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1680           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1681           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1682           p-xmlh::gate-handle_ = p-dsh
     1683           p-xmlh::uniq-gate-rec = entry(2, p-dsh:private-data, chr(4))
     1684           p-xmlh::gate-name = p-dsh:name
     1685           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1686           .
     1687           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1688             assign
     1689             p-xmlh::order = -3.
     1690           end.
     1691           p-xmlh:buffer-release().
     1692         end.
     1693       end.
     1694     end.
     1695   end procedure.
     1696   procedure all-gates-empty :
     1697   define buffer buf_temp-xml-tables for temp-xml-tables.
     1698   do
     1699   on error undo, return error
     1700   :
     1701     for each buf_temp-xml-tables
     1702     break
     1703     by buf_temp-xml-tables.uniq-gate-rec
     1704     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1705     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1706     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1707     :
     1708       if valid-handle(buf_temp-xml-tables.tbl-handle_) then do:
     1709         buf_temp-xml-tables.tbl-handle_:empty-temp-table().
     1710       end.
     1711     end.
     1712   end.
     1713   end procedure.
     1714   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
