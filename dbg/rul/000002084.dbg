     1723   define variable v-current-doc-code as character no-undo .
     1724   define variable v-current-doc-date as date no-undo .
     1725   define variable v-current-doc-time as integer no-undo .
     1726   define variable v-current-doc-fact-date as date no-undo .
     1727   define variable v-current-date as date no-undo .
     1728   define variable v-current-fact-date as date no-undo .
     1729   define variable v-current-doc-type as character no-undo .
     1730   define variable v-last-error-message as character no-undo .
