      478   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      479   define new global shared variable g#lib-nws as handle no-undo .
      480   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      481   def var vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      482   procedure gen-key-rec :
      483     define input  parameter p-tbl-name    as character no-undo.
      484     define input  parameter p-bh_tbl-name as handle    no-undo.
      485     define output parameter p-key-rec     as character no-undo.
      486     do
      487     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      488     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      489     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      490     :
      491       define variable fh               as handle    no-undo .
      492       define variable v-ok             as logical   no-undo .
      493       define variable v-inform         as character no-undo .
      494       define variable v-ind            as integer   no-undo .
      495       define variable v-idx-field-qnty as integer   no-undo .
      496       if p-tbl-name = ?
      497         or p-tbl-name = "":U
      498       then do:
      499         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info9 ).
      500       end.
      501       if not p-bh_tbl-name:available then do:
      502         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info9, p-tbl-name ).
      503       end.
      504       assign
      505         p-key-rec = p-tbl-name
      506         v-inform  = p-bh_tbl-name:index-information(1)
      507         v-ind     = 2
      508       .
      509       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      510       on error undo, return error
      511       :
      512         assign
      513           v-inform = p-bh_tbl-name:index-information( v-ind )
      514           v-ind    = v-ind + 1
      515         .
      516       end.
      517       if v-inform = ?
      518         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      519         or entry( 3, v-inform, ",":U ) <> "1":U
      520       then do:
      521         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info9, p-tbl-name ).
      522       end.
      523       else do:
      524         assign
      525           v-idx-field-qnty = num-entries( v-inform ) - 4
      526         .
      527         if v-idx-field-qnty < 2 then do:
      528           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info9, v-inform, p-tbl-name ).
      529         end.
      530         do v-ind = 1 to v-idx-field-qnty by 2
      531         on error undo, return error
      532         :
      533           assign
      534             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      535             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      536           .
      537         end.
      538       end.
      539       if p-key-rec = ? then do:
      540         assign
      541           p-key-rec = "":U
      542         .
      543         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info9, p-tbl-name ).
      544       end.
      545     end.
      546     return.
      547   end procedure.
      548   procedure gen-where-keyr-tab :
      549     define input  parameter i-tableSerach as character no-undo.
      550     define input  parameter i-tablekey   as character  no-undo.
      551     define input  parameter p-key-rec    as character  no-undo.
      552     define input  parameter p-key-handle as handle     no-undo .
      553     define input  parameter p-db-name    as character  no-undo .
      554     define input  parameter p-tt-handle  as handle     no-undo .
      555     define output parameter o-Where      as character  no-undo.
      556     do
      557     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      558     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      559     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      560     :
      561       define variable v-full-tbl-name  as character no-undo .
      562       define variable bh_tbl-name      as handle    no-undo .
      563       define variable fh_key           as handle    no-undo .
      564       define variable fh_search        as handle    no-undo .
      565       define variable v-field-num      as integer   no-undo .
      566       define variable v-count-fld      as integer   no-undo .
      567       define variable v-inform         as character no-undo .
      568       define variable v-ind            as integer   no-undo .
      569       define variable v-idx-field-qnty as integer   no-undo .
      570       define variable v-field-name     as character no-undo .
      571       define variable v-field-val      as character no-undo .
      572       define variable v-word-link      as character no-undo .
      573       define variable vTable           as character no-undo.
      574       define variable bh_tbl-key       as handle    no-undo .
      575       assign
      576         p-key-rec = trim( p-key-rec )
      577       .
      578       if p-key-handle <> ? then do:
      579         if not valid-handle(p-key-handle)
      580            or p-key-handle:type <> "buffer"
      581         then do:
      582           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info9 ).
      583         end.
      584         if num-entries( p-key-rec, chr(3) ) > 1
      585           or p-key-rec = ?
      586           or p-key-rec = "":U
      587         then do:
      588           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info9, p-key-rec ).
      589         end.
      590       end.
      591       else do:
      592         if p-key-rec = ?
      593           or p-key-rec = "":U
      594         then do:
      595           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info9 ).
      596         end.
      597       end.
      598       assign
      599         vTable = entry( 1 , p-key-rec, chr(3) )
      600       .
      601       if p-tt-handle <> ?
      602         and ( not valid-handle(p-tt-handle)
      603               or p-tt-handle:type <> "buffer"
      604             )
      605       then do:
      606         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info9, vTable, chr(10) ).
      607       end.
      608       if p-tt-handle = ? then do:
      609         assign
      610           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      611         .
      612         create buffer bh_tbl-name for table v-full-tbl-name .
      613       end.
      614       else do:
      615         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      616       end.
      617       assign
      618         v-inform = bh_tbl-name:index-information(1)
      619         v-ind    = 2
      620       .
      621       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      622       on error undo, return error
      623       :
      624         assign
      625           v-inform = bh_tbl-name:index-information( v-ind )
      626           v-ind    = v-ind + 1
      627         .
      628       end.
      629       if v-inform = ?
      630         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      631         or entry( 3, v-inform, ",":U ) <> "1":U
      632       then do:
      633         delete object bh_tbl-name no-error.
      634         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info9, vTable ).
      635       end.
      636       assign
      637         v-idx-field-qnty = num-entries( v-inform ) - 4
      638       .
      639       if v-idx-field-qnty < 2 then do:
      640         delete object bh_tbl-name no-error.
      641         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info9, v-inform, vTable ).
      642       end.
      643       assign
      644         o-where     = "where":U
      645         v-word-link = "":U
      646         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      647         v-count-fld = 0
      648       .
      649       if i-tablekey ne "" and i-tablekey ne ?
      650       then do:
      651         assign
      652           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      653         .
      654         create buffer bh_tbl-key for table v-full-tbl-name .
      655       end.
      656       if i-tableSerach ne "" and i-tableSerach ne ?
      657       then do:
      658         delete object bh_tbl-name no-error.
      659         assign
      660           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      661         .
      662         create buffer bh_tbl-name for table v-full-tbl-name .
      663       end.
      664       block_where:
      665       do v-ind = 1 to v-idx-field-qnty by 2
      666       on error undo, return error
      667       :
      668         assign
      669           v-count-fld = v-count-fld + 1
      670         .
      671         if p-key-handle = ?
      672           and v-count-fld > v-field-num
      673         then do:
      674           leave block_where.
      675         end.
      676         define variable VfieldKeyTable as handle no-undo.
      677         assign
      678           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      679           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      680         .
      681         if     bh_tbl-key ne ?
      682         then do:
      683            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      684            if VfieldKeyTable eq ?
      685            then next block_where.
      686         end.
      687         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      688         then
      689            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      690         else
      691            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      692         if p-key-handle = ? then do:
      693           assign
      694             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      695           .
      696         end.
      697         else do:
      698           assign
      699             fh_key = p-key-handle:buffer-field( v-field-name )
      700           .
      701           if fh_key = ?
      702             or not valid-handle( fh_key )
      703           then do:
      704             delete object bh_tbl-name.
      705             if     bh_tbl-key ne ?
      706             then
      707                delete object bh_tbl-key.
      708             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info9, p-key-handle:name, v-field-name ).
      709           end.
      710           assign
      711             v-field-val = fh_key:buffer-value
      712           .
      713         end.
      714         if fh_search:data-type ="character":U then do:
      715           assign
      716             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      717             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      718             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      719             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      720             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      721             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      722             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      723             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      724             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      725             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      726             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      727             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      728             v-field-val = substitute( '"&1"', v-field-val )
      729           .
      730         end.
      731         assign
      732           o-where = substitute( "&1 &2", o-where, v-field-val )
      733         .
      734         if v-word-link = "":U then do:
      735           assign
      736             v-word-link = "and":U
      737           .
      738         end.
      739       end.
      740       delete object bh_tbl-name.
      741       if     bh_tbl-key ne ?
      742       then
      743          delete object bh_tbl-key.
      744       if p-key-handle = ?
      745         and v-count-fld <> v-field-num
      746       then do:
      747         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info9, vTable ).
      748       end.
      749     end.
      750   end procedure.
      751   procedure gen-hn-keyr-tab :
      752     define input  parameter i-tableSerach as character no-undo.
      753     define input  parameter i-tablekey   as character no-undo.
      754     define input  parameter p-key-rec    as character no-undo.
      755     define input  parameter p-key-handle as handle    no-undo .
      756     define input  parameter p-db-name    as character no-undo .
      757     define input  parameter p-tt-handle  as handle    no-undo .
      758     define input  parameter p-stts-lock  as integer   no-undo .
      759     define output parameter o-hn         as handle    no-undo.
      760     define variable v-full-tbl-name as character no-undo.
      761     define variable v-where         as character no-undo.
      762     define variable bh_tbl-name     as handle    no-undo.
      763     define variable vTable          as character no-undo.
      764     do
      765     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      766     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      767     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      768         run gen-where-keyr-tab(i-tableSerach,
      769                                i-tablekey,
      770                                p-key-rec,
      771                                p-key-handle,
      772                                p-db-name,
      773                                p-tt-handle,
      774                                output v-where).
      775         if i-tableSerach ne "" and i-tableSerach ne ?
      776         then do:
      777            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      778            create buffer bh_tbl-name for table v-full-tbl-name .
      779         end.
      780         else do:
      781            if p-tt-handle = ? then do:
      782               assign
      783                  vTable = entry( 1 , p-key-rec, chr(3) )
      784               .
      785               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      786               create buffer bh_tbl-name for table v-full-tbl-name .
      787            end.
      788            else do:
      789               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      790            end.
      791         end.
      792         if p-tt-handle = ? then do:
      793            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      794         end.
      795         else do:
      796            bh_tbl-name:find-first( v-where ) no-error .
      797         end.
      798         o-hn = bh_tbl-name.
      799      end.
      800   end procedure.
      801   procedure gen-hn-keyr :
      802     define input  parameter p-key-rec    as character no-undo.
      803     define input  parameter p-key-handle as handle    no-undo .
      804     define input  parameter p-db-name    as character no-undo .
      805     define input  parameter p-tt-handle  as handle    no-undo .
      806     define input  parameter p-stts-lock  as integer   no-undo .
      807     define output parameter o-hn         as handle    no-undo.
      808     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      809   end.
      810   procedure gen-row-keyr :
      811     define input  parameter p-key-rec    as character no-undo.
      812     define input  parameter p-key-handle as handle    no-undo .
      813     define input  parameter p-db-name    as character no-undo .
      814     define input  parameter p-tt-handle  as handle    no-undo .
      815     define input  parameter p-stts-lock  as integer   no-undo .
      816     define output parameter p-tbl-row    as rowid     no-undo.
      817     define output parameter p-tbl-name   as character no-undo.
      818     define variable vHn as handle no-undo.
      819       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      820       p-tbl-row = if vHn:available then vHn:rowid else ?.
      821       p-tbl-name =  vHn:table.
      822       delete object vHn no-error.
      823     if p-tbl-row = ? then do:
      824       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info9, p-tbl-name, p-key-rec ).
      825     end.
      826     else do:
      827       return.
      828     end.
      829   end procedure.
      830   procedure gen-key-fv :
      831     define input  parameter p-key-rec    as character no-undo .
      832     define output parameter p-field-list as character no-undo .
      833     define output parameter p-value-list as character no-undo.
      834     do
      835     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      836     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      837     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      838     :
      839       define variable v-full-tbl-name  as character no-undo .
      840       define variable bh_tbl-name      as handle    no-undo .
      841       define variable v-tbl-name       as character no-undo .
      842       define variable v-field-num      as integer   no-undo .
      843       define variable v-count-fld      as integer   no-undo .
      844       define variable v-inform         as character no-undo .
      845       define variable v-ind            as integer   no-undo .
      846       define variable v-idx-field-qnty as integer   no-undo .
      847       define variable v-delim-key      as character no-undo .
      848       if p-key-rec = ?
      849         or p-key-rec = "":U
      850       then do:
      851         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info9 ).
      852       end.
      853       assign
      854         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      855         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      856       .
      857       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      858       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info9 ).
      859       assign
      860         v-inform = bh_tbl-name:index-information(1)
      861         v-ind    = 2
      862       .
      863       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      864       on error undo, return error
      865       :
      866         assign
      867           v-inform = bh_tbl-name:index-information( v-ind )
      868           v-ind    = v-ind + 1
      869         .
      870       end.
      871       if v-inform = ?
      872         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      873         or entry( 3, v-inform, ",":U ) <> "1":U
      874       then do:
      875         delete object bh_tbl-name no-error.
      876         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info9, v-tbl-name ).
      877       end.
      878       assign
      879         v-idx-field-qnty = num-entries( v-inform ) - 4
      880       .
      881       if v-idx-field-qnty < 2 then do:
      882         delete object bh_tbl-name no-error.
      883         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info9, v-inform, v-tbl-name ).
      884       end.
      885       assign
      886         p-field-list = "":U
      887         p-value-list = "":U
      888         v-delim-key  = "":U
      889         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      890         v-count-fld  = 0
      891       .
      892       block_where:
      893       do v-ind = 1 to v-idx-field-qnty by 2
      894       on error undo, return error
      895       :
      896         assign
      897           v-count-fld = v-count-fld + 1
      898         .
      899         if v-count-fld > v-field-num then do:
      900           leave block_where.
      901         end.
      902         assign
      903           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      904           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      905         .
      906         if v-ind = 1 then do:
      907           assign
      908             v-delim-key = chr(3)
      909           .
      910         end.
      911       end.
      912       delete object bh_tbl-name.
      913       if v-count-fld <> v-field-num then do:
      914         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info9, v-tbl-name ).
      915       end.
      916     end.
      917   end procedure.
      918   procedure gen-key-field :
      919     define input  parameter p-table      as character no-undo .
      920     define output parameter p-field-list as character no-undo .
      921     do
      922     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      923     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      924     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      925     :
      926       define variable v-full-tbl-name  as character no-undo .
      927       define variable bh_tbl-name      as handle    no-undo .
      928       define variable v-tbl-name       as character no-undo .
      929       define variable v-field-num      as integer   no-undo .
      930       define variable v-count-fld      as integer   no-undo .
      931       define variable v-inform         as character no-undo .
      932       define variable v-ind            as integer   no-undo .
      933       define variable v-idx-field-qnty as integer   no-undo .
      934       define variable v-delim-key      as character no-undo .
      935       if p-table = ?
      936         or p-table = "":U
      937       then do:
      938         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info9 ).
      939       end.
      940       assign
      941         v-tbl-name      = p-table
      942         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      943       .
      944       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      945       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info9 ).
      946       assign
      947         v-inform = bh_tbl-name:index-information(1)
      948         v-ind    = 2
      949       .
      950       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      951       on error undo, return error
      952       :
      953         assign
      954           v-inform = bh_tbl-name:index-information( v-ind )
      955           v-ind    = v-ind + 1
      956         .
      957       end.
      958       if v-inform = ?
      959         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      960         or entry( 3, v-inform, ",":U ) <> "1":U
      961       then do:
      962         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info9, v-tbl-name ).
      963       end.
      964       assign
      965         v-idx-field-qnty = num-entries( v-inform ) - 4
      966       .
      967       if v-idx-field-qnty < 2 then do:
      968         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info9, v-inform, v-tbl-name ).
      969       end.
      970       assign
      971         p-field-list = "":U
      972         v-delim-key  = "":U
      973         v-count-fld  = 0
      974       .
      975       block_where:
      976       do v-ind = 1 to v-idx-field-qnty by 2
      977       on error undo, return error
      978       :
      979         assign
      980           v-count-fld = v-count-fld + 1
      981         .
      982         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      983         if v-ind = 1 then do:
      984           assign
      985             v-delim-key = chr(3)
      986           .
      987         end.
      988       end.
      989       delete object bh_tbl-name.
      990     end.
      991   end procedure.
      992   define SHARED temp-table temp-cmd no-undo
      993   field cmd-code as integer
      994   field db-list as character
      995   index pi is unique primary
      996   db-list
      997   index icmd
      998   cmd-code
      999   .
     1000   define SHARED temp-table temp-smart-route no-undo
     1001   field key-field as character
     1002   field db-num as integer
     1003   index pi is unique primary
     1004   key-field
     1005   db-num
     1006   .
     1007   define SHARED temp-table temp-no-route no-undo
     1008   field rec-ord as integer
     1009   field db-num as integer
     1010   index pi is unique primary
     1011   db-num
     1012   rec-ord
     1013   index iro
     1014   rec-ord
     1015   .
     1016   define SHARED temp-table temp-smart-link no-undo
     1017   field uniq-key-rec as character
     1018   field key-field as character
     1019   field rec-ord as integer
     1020   field is-smart as logical
