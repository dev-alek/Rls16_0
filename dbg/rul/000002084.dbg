     1750   define temp-table temp-rule-call-param no-undo like ub.rule-call-param.
     1751   define buffer buf_temp-rule-call-param for temp-rule-call-param.
     1752   define buffer buf_temp-cmd for temp-cmd.
     1753   define buffer buf_dis-card-sale_obj for temp-d-card.
     1754   define variable vh_dis-card-sale_obj as handle no-undo .
     1755   define temp-table temp-dis-rule no-undo like ub.dis-rule.
     1756    define variable p-r-b as character no-undo.
     1757    define variable p-is-over as logical no-undo.
     1758   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1759   procedure discardh_write-dis-card-rul  :
     1760   define parameter buffer buf_dis-card for ub.dis-card .
     1761   define input parameter p-type as character no-undo .
     1762   define input parameter p-emitent-host-code as integer no-undo .
     1763   define input parameter p-action as integer no-undo .
     1764   define variable v-date as date      no-undo.
     1765   define variable v-time  as integer   no-undo.
     1766   define variable v-rec-ord1 as integer no-undo .
     1767   define variable v-rec-ord2 as integer no-undo .
     1768   define variable v-rec-ord3 as integer no-undo .
     1769   define variable v-rec-hno as integer no-undo .
     1770   define buffer buf_c-dc-hist for ub.c-dc-hist.
     1771   define buffer buf_c-dis-card for ub.c-dis-card.
     1772   define buffer buf_temp-hist-nws-option for temp-hist-nws-option.
     1773   define buffer last_temp-hist-nws-option for temp-hist-nws-option.
     1774   do
     1775   on error undo, return error
     1776   :
     1777     if not available buf_dis-card then do:
     1778       message
     1779         vss-workfile vss-revision vss-description skip
     1780         "Ошибка задания входных параметров" skip
     1781         "Не определена ДК" skip
     1782         view-as alert-box error .
     1783       undo, return error .
     1784     end.
     1785     find first buf_temp-hist-nws-option where
     1786               buf_temp-hist-nws-option.table-name = 'dis-card':U
     1787           and buf_temp-hist-nws-option.db-num = g#db-num
     1788           and buf_temp-hist-nws-option.key#_one = 2
     1789           and buf_temp-hist-nws-option.charkey_one = p-type
     1790           and buf_temp-hist-nws-option.host-code = p-emitent-host-code no-error .
     1791     if not available buf_temp-hist-nws-option then do:
     1792       find first last_temp-hist-nws-option where
     1793                last_temp-hist-nws-option.db-num = g#db-num
     1794             and last_temp-hist-nws-option.hn-id < 0 no-error.
     1795       create buf_temp-hist-nws-option.
     1796       assign
     1797       buf_temp-hist-nws-option.db-num = g#db-num
     1798       buf_temp-hist-nws-option.hn-id = (if available last_temp-hist-nws-option
     1799                                   then - (abs(last_temp-hist-nws-option.hn-id) + 1)
     1800                                   else -1 )
     1801       buf_temp-hist-nws-option.table-name = 'dis-card':U
     1802       buf_temp-hist-nws-option.key#_one = 2
     1803       buf_temp-hist-nws-option.charkey_one = p-type
     1804       buf_temp-hist-nws-option.host-code = p-emitent-host-code
     1805       buf_temp-hist-nws-option.smart-nws = integer('-1':U)
     1806       .
     1807   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1808   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option-record in g#lib-nws
     1809     (input  g#db-num
     1810     ,input  buffer buf_temp-hist-nws-option:handle
     1811     )  .
     1812     end.
     1813     if not g#news
     1814     and buf_temp-hist-nws-option.hist-from-prim < 0 then do:
     1815       return.
     1816     end.
     1817     if g#news
     1818     and buf_temp-hist-nws-option.nws-to-hist < 0 then do:
     1819       return.
     1820     end.
     1821     run cur-time in this-procedure(output v-date, output v-time).
     1822     create buf_c-dis-card.
     1823     buffer-copy buf_dis-card to buf_c-dis-card
     1824     assign
     1825     buf_c-dis-card.d-card             = buf_dis-card.d-card
     1826     buf_c-dis-card.card-num           = buf_dis-card.card-num
     1827     buf_c-dis-card.chip-num           = next-value (s-dc-chip, ub)
     1828     buf_c-dis-card.corr-time          = v-time
     1829     buf_c-dis-card.corr-user-db-num   = g#db-num
     1830     buf_c-dis-card.corr-user-name     = (if g#news
     1831                                           then (chr(4) +  'СПН':U)
     1832                                           else (if g#esys
     1833                                                 then (chr(4) +  'ВС':U)
     1834                                                 else g#userid
     1835                                               )
     1836                                           )
     1837     buf_c-dis-card.corr-date          = v-date
     1838     .
     1839     create buf_c-dc-hist.
     1840     buffer-copy buf_c-dis-card to buf_c-dc-hist
     1841     assign
     1842     buf_c-dc-hist.action =  p-action
     1843     buf_c-dc-hist.subject = 'dis-card':U
     1844     buf_c-dc-hist.host-code =  buf_dis-card.emitent-host-code
     1845     buf_c-dc-hist.is-news = g#news
     1846     buf_c-dc-hist.source-type = p-doc-type
     1847     buf_c-dc-hist.source-ref = (if p-doc-type = '':U
     1848                                  then '':U
     1849                                  else p-doc-code)
     1850     .
     1851     if g#db-num > 0
     1852     or (g#db-num = 0
     1853         and buf_temp-hist-nws-option.hist-to-nws >= 0)
     1854     then do:
     1855       run add-dump in p-cmd-proc-handle                                                                           (input p-cmd-code                                                                                         ,input 'c-dis-card':U                                                                                          ,input '+update'                                                                                         ,input buffer buf_c-dis-card:handle                                                                                    ,input ''                                                                                         ,output v-rec-ord2                                                                                         ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                     delete procedure p-cmd-proc-handle .                                                                        undo , return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'c-dis-card':U                                                                                                ,p-cmd-code                                                                                               ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
     1856       run add-dump in p-cmd-proc-handle                                                                           (input p-cmd-code                                                                                         ,input 'c-dc-hist':U                                                                                          ,input '+update'                                                                                         ,input buffer buf_c-dc-hist:handle                                                                                    ,input ''                                                                                         ,output v-rec-ord3                                                                                         ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                     delete procedure p-cmd-proc-handle .                                                                        undo , return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'c-dc-hist':U                                                                                                ,p-cmd-code                                                                                               ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
     1857       if g#db-num = 0 then do:
     1858         run create-smart-route-link in this-procedure ( input 'c-dis-card':U
     1859                                                       ,input buffer buf_c-dis-card:handle
     1860                                                       ,input buf_dis-card.d-card
     1861                                                       ,input v-rec-ord2
     1862                                                       ,input no
     1863                                                       ).
     1864         run create-smart-route-link in this-procedure ( input 'c-dc-hist':U
     1865                                                       ,input buffer buf_c-dc-hist:handle
     1866                                                       ,input buf_dis-card.d-card
     1867                                                       ,input v-rec-ord3
     1868                                                       ,input no
     1869                                                       ).
