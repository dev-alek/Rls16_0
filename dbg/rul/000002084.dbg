     2498   procedure get-db-list-for-d-card3 :
     2499   define input parameter p-d-card as character no-undo .
     2500   define variable v-current-db-processed as logical no-undo .
     2501   define buffer buf_clients  for ub.clients.
     2502   define buffer buf_dis-obj for ub.dis-obj.
     2503   define buffer buf_temp-smart-route for temp-smart-route.
     2504     do
     2505     on error undo, return error return-value
     2506     :
     2507       for each buf_dis-obj no-lock where
     2508               buf_dis-obj.d-card = p-d-card,
     2509          first buf_clients no-lock where
     2510               buf_clients.obj-type = buf_dis-obj.obj-type
     2511           and buf_clients.obj-code = buf_dis-obj.obj-code
     2512       break by
     2513       buf_clients.db-num:
     2514         if first-of(buf_Clients.db-num) then do:
     2515           find first buf_temp-smart-route no-lock where
     2516                 buf_temp-smart-route.key-field = p-d-card
     2517             and buf_temp-smart-route.db-num = buf_clients.db-num
     2518                 no-error.
     2519           if available buf_temp-smart-route then return.
     2520           create buf_temp-smart-route.
     2521           assign
     2522           buf_temp-smart-route.key-field = p-d-card
     2523           buf_temp-smart-route.db-num = buf_clients.db-num
     2524           .
     2525           if buf_clients.db-num = g#db-num then do:
     2526             v-current-db-processed = yes.
     2527           end.
     2528         end.
     2529       end.
     2530       if not v-current-db-processed then do:
     2531         find first buf_temp-smart-route no-lock where
     2532               buf_temp-smart-route.key-field = p-d-card
     2533           and buf_temp-smart-route.db-num = g#db-num
     2534               no-error.
     2535         if not available buf_temp-smart-route then do:
     2536           create buf_temp-smart-route.
     2537           assign
     2538           buf_temp-smart-route.key-field = p-d-card
     2539           buf_temp-smart-route.db-num = g#db-num
     2540           .
     2541         end.
     2542       end.
     2543     end.
     2544   end procedure.
