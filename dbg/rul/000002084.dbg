     1143   procedure clear-from-rec-ord :
     1144   define input parameter p-rec-ord as integer no-undo .
     1145   define buffer buf_temp-no-route for temp-no-route.
     1146   define buffer buf_temp-smart-link for temp-smart-link.
     1147   do
     1148   on error undo, return error
     1149   :
     1150   for each buf_temp-no-route where
     1151           buf_temp-no-route.rec-ord > p-rec-ord:
     1152     delete buf_temp-no-route.
     1153   end.
     1154   for each buf_temp-smart-link where
     1155           buf_temp-smart-link.rec-ord > p-rec-ord:
     1156      delete buf_temp-smart-link.
     1157   end.
     1158   end.
