     2617   end function.
     2618   FUNCTION DIS-TIME-RULE_00006 returns logical ( input p-time-rule-num as integer, input p-date as date, input p-time as integer):
     2619   define buffer buf_dis-time-rule for ub.dis-time-rule.
     2620   find first buf_dis-time-rule no-lock where
     2621             buf_dis-time-rule.time-rule-num = p-time-rule-num no-error.
     2622   if available buf_dis-time-rule
     2623   and buf_dis-time-rule.sts = integer ('0':U) then do:
     2624     if buf_dis-time-rule.month-day = day(p-date) then do:
     2625       return yes.
     2626     end.
     2627     return no.
     2628   end.
     2629   else do:
     2630     return no.
     2631   end.
     2632   end function.
     2633   FUNCTION DIS-TIME-RULE_00007 returns logical ( input p-time-rule-num as integer, input p-date as date, input p-time as integer):
     2634   define buffer buf_dis-time-rule for ub.dis-time-rule.
     2635   find first buf_dis-time-rule no-lock where
     2636             buf_dis-time-rule.time-rule-num = p-time-rule-num no-error.
     2637   if available buf_dis-time-rule
     2638   and buf_dis-time-rule.sts = integer ('0':U) then do:
     2639     if buf_dis-time-rule.date-from <= p-date
     2640     and buf_dis-time-rule.date-to >= p-date
     2641     and buf_dis-time-rule.time-from <= p-time
     2642     and buf_dis-time-rule.time-to >= p-time then do:
     2643       return yes.
     2644     end.
     2645   end.
     2646   return no.
     2647   end function.
     2648   FUNCTION DIS-TIME-RULE_00008 returns logical ( input p-time-rule-num as integer, input p-date as date, input p-time as integer):
     2649   define buffer buf_dis-time-rule for ub.dis-time-rule.
     2650   find first buf_dis-time-rule no-lock where
     2651             buf_dis-time-rule.time-rule-num = p-time-rule-num no-error.
     2652   if available buf_dis-time-rule
     2653   and buf_dis-time-rule.sts = integer ('0':U) then do:
     2654     if buf_dis-time-rule.date-from <= p-date
     2655     and buf_dis-time-rule.date-to >= p-date
     2656     and (buffer buf_dis-time-rule:buffer-field("week-day-" + string(loc-weekday(p-date) )):buffer-value = yes
     2657          or buf_dis-time-rule.week-day-0 = yes)
     2658     and buf_dis-time-rule.time-from <= p-time
     2659     and buf_dis-time-rule.time-to >= p-time
     2660     then do:
     2661       return yes.
     2662     end.
     2663   end.
     2664   return no.
     2665   end function.
     2666   FUNCTION DIS-TIME-RULE_00009 returns logical ( input p-time-rule-num as integer, input p-date as date, input p-time as integer):
     2667   define buffer buf_dis-time-rule for ub.dis-time-rule.
     2668   define buffer buf_term-dis-time-rule for ub.dis-time-rule.
     2669   find first buf_dis-time-rule no-lock where
     2670             buf_dis-time-rule.time-rule-num = p-time-rule-num no-error.
     2671   if available buf_dis-time-rule
     2672   and buf_dis-time-rule.sts = integer ('0':U) then do:
     2673     for each buf_term-dis-time-rule no-lock where
     2674             buf_term-dis-time-rule.upper-time-rule-num = buf_dis-time-rule.time-rule-num:
     2675       if buf_term-dis-time-rule.time-from <= p-time
     2676       and buf_term-dis-time-rule.time-to >= p-time
     2677       and buffer buf_term-dis-time-rule:buffer-field("week-day-" + string(loc-weekday(p-date) )):buffer-value = yes
     2678       then do:
     2679         return yes.
     2680       end.
     2681     end.
     2682   end.
     2683   return no.
     2684   end function.
     2685   FUNCTION DIS-TIME-RULE_00010 returns logical ( input p-time-rule-num as integer, input p-date as date, input p-time as integer):
     2686   define buffer buf_dis-time-rule for ub.dis-time-rule.
     2687   find first buf_dis-time-rule no-lock where
     2688             buf_dis-time-rule.time-rule-num = p-time-rule-num no-error.
     2689   if available buf_dis-time-rule
     2690   and buf_dis-time-rule.sts = integer ('0':U) then do:
     2691     if buffer buf_dis-time-rule:buffer-field("week-day-" + string(loc-weekday(p-date) )):buffer-value = yes
     2692     then do:
     2693       return yes.
     2694     end.
     2695   end.
     2696   return no.
     2697   end function.
     2698   FUNCTION DIS-TIME-RULE_00011 returns logical ( input p-time-rule-num as integer, input p-date as date, input p-time as integer):
     2699   define buffer buf_dis-time-rule for ub.dis-time-rule.
     2700   find first buf_dis-time-rule no-lock where
     2701             buf_dis-time-rule.time-rule-num = p-time-rule-num no-error.
     2702   if available buf_dis-time-rule
     2703   and buf_dis-time-rule.sts = integer ('0':U) then do:
     2704     if (buf_dis-time-rule.week-day-0 = yes
     2705     or (buffer buf_dis-time-rule:buffer-field("week-day-" + string(loc-weekday(p-date) )):buffer-value = yes))
     2706     and (buf_dis-time-rule.time-from <= p-time
     2707     and buf_dis-time-rule.time-to >= p-time)
     2708     then do:
     2709       return yes.
     2710     end.
     2711   end.
     2712   return no.
     2713   end function.
     2714   FUNCTION DIS-TIME-RULE_00012 returns logical ( input p-time-rule-num as integer, input p-date as date, input p-time as integer):
     2715   define buffer buf_dis-time-rule for ub.dis-time-rule.
     2716   find first buf_dis-time-rule no-lock where
     2717             buf_dis-time-rule.time-rule-num = p-time-rule-num no-error.
     2718   if available buf_dis-time-rule
     2719   and buf_dis-time-rule.sts = integer ('0':U) then do:
     2720     if buf_dis-time-rule.time-from <= p-time
     2721     then do:
     2722       return yes.
     2723     end.
     2724   end.
     2725   return no.
     2726   end function.
     2727   FUNCTION dis-rule_00020 returns decimal ( input p-rule-num as integer
     2728                                           , input p-date as date
     2729                                           , input p-time as integer
     2730                                           , input p-tot-sum as decimal
     2731                                           ):
     2732   define variable v-delta as decimal no-undo .
     2733   define variable v-start as logical no-undo init yes.
     2734   define variable v-discnt-value as decimal no-undo .
     2735   define buffer buf_dis-rule for ub.dis-rule.
     2736   define buffer buf_term-dis-rule for ub.dis-rule.
     2737   find first buf_dis-rule no-lock where
     2738           buf_dis-rule.rule-num = p-rule-num no-error.
     2739   if available buf_dis-rule
     2740   and buf_dis-rule.sts = integer('0':U)
     2741   and (buf_Dis-rule.time-templ-rl-root <= 50000 or dynamic-function( "dis-time-rule_" + string(buf_dis-rule.time-templ-rl-root - 50000, "99999")                                        , input buf_dis-rule.time-rule-num                                         , input p-date                                        , input p-time ))
     2742   then do:
     2743     for each buf_term-dis-rule no-lock where
     2744             buf_term-dis-rule.upper-rule-num = buf_dis-rule.rule-num:
     2745       if buf_term-dis-rule.tot-sum <= p-tot-sum then do:
     2746         if v-start
     2747         or v-delta  > (p-tot-sum - buf_term-dis-rule.tot-sum)
     2748         then do:
     2749           assign
     2750           v-discnt-value = buf_term-dis-rule.discnt-value
     2751           v-start = no
     2752           v-delta = p-tot-sum - buf_term-dis-rule.tot-sum
     2753           .
     2754         end.
     2755       end.
     2756     end.
     2757     return v-discnt-value.
     2758   end.
     2759   return 0.0.
     2760   end function.
     2761   FUNCTION dis-rule_00057 returns decimal ( input p-rule-num as integer
     2762                                           , input p-date as date
     2763                                           , input p-time as integer
     2764                                           , input p-tot-sum as decimal ) map to dis-rule_00020 in this-procedure .
     2765   on delete of this-procedure do:
     2766     run garbcoll_clear in this-procedure .
     2767   end.
     2768   run load-ruleset-context in this-procedure ( input p-ruleset-id).
     2769   if return-value = "return" then return ''.
     2770    define variable Card1 as class Dis-card_ no-undo .
     2771   Card1 = new Dis-card_( input parparentproc, input p-parent-handle, input p-log-handle, input this-procedure:handle, input p-cont-handle, input v-current-lock, input v-current-wait, input v-save) .
     2772    define variable Tot-sum-host1 as class Dis-tot_host no-undo .
     2773   Tot-sum-host1 = new Dis-tot_host( input parparentproc, input p-parent-handle, input p-log-handle, input this-procedure:handle, input p-cont-handle, input v-current-lock, input v-current-wait, input v-save) .
     2774    define variable Discount-host1 as class Discount_host no-undo .
     2775   Discount-host1 = new Discount_host( input parparentproc, input p-parent-handle, input p-log-handle, input this-procedure:handle, input p-cont-handle, input v-current-lock, input v-current-wait, input v-save, input 26) .
     2776    define variable Tot-sum-obj1 as class Dis-tot_obj no-undo .
     2777   Tot-sum-obj1 = new Dis-tot_obj( input parparentproc, input p-parent-handle, input p-log-handle, input this-procedure:handle, input p-cont-handle, input v-current-lock, input v-current-wait, input v-save) .
     2778    define variable Discount-obj1 as class Discount_obj no-undo .
     2779   Discount-obj1 = new Discount_obj( input parparentproc, input p-parent-handle, input p-log-handle, input this-procedure:handle, input p-cont-handle, input v-current-lock, input v-current-wait, input v-save, input 26) .
     2780    define variable v-netto-sum1 as  decimal no-undo .
     2781   if not this-procedure:persistent then do:
     2782     run proc-main in this-procedure ( input p-type
     2783                                 ,input p-emitent-host-code ) no-error .
     2784     if error-status:error then do:
     2785         run garbcoll_clear in this-procedure .
     2786         undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     2787     end.
     2788     run garbcoll_clear in this-procedure .
     2789     empty temp-table temp-dis-rule.
     2790   end.
     2791   procedure proc-main :
     2792   define input parameter p-type like ub.dis-card.type no-undo .
     2793   define input parameter p-emitent-host-code like ub.dis-card.emitent-host-code no-undo .
     2794   _main:
     2795   do
     2796   on error undo, return error return-value
     2797   :
     2798   assign
     2799   v-emitent-host-code = p-emitent-host-code
     2800   v-type = p-type.
     2801     _d-card:
     2802     for each temp-d-card where
     2803             temp-d-card.type = p-type
     2804         and temp-d-card.emitent-host-code = p-emitent-host-code
     2805     break
     2806     by temp-d-card.d-card
     2807     On error undo _d-card, retry _d-card:
     2808       if temp-d-card.d-card = '_' then next.
     2809       num-rec = num-rec + 1.
     2810       if retry then do:
     2811         if p-ruleset-id = 5 then do:
     2812           num-rec-calc-err = num-rec-calc-err + 1.
     2813           undo _d-card, next _d-card .
     2814         end.
     2815         else do:
     2816           undo _main, return error return-value .
     2817         end.
     2818       end.
     2819       assign
     2820       v-current-d-card = temp-d-card.d-card
     2821       .
     2822       do transaction
     2823       On end-key undo _d-card, retry _d-card
     2824       On stop undo _d-card, retry _d-card
     2825       On error undo _d-card, retry _d-card:
     2826       IF  Card1:find_dis-card_( INPUT v-current-d-card) = true  THEN do:
     2827         for each temp-dis-rule no-lock
     2828         on error  undo _d-card, retry _d-card
     2829         on stop   undo _d-Card, retry _d-card
     2830         on endkey undo _d-card, retry _d-card
     2831         :
     2832           if retry then do:
     2833           end.
     2834           if temp-dis-rule.obj-type = ''
     2835           and temp-dis-rule.obj-code = 0 then do:
     2836             v-netto-sum1 = 0.
     2837             v-current-host-code = temp-dis-rule.host-code.
     2838             v-current-obj-type = ''.
     2839             v-current-obj-code = 0.
     2840             IF  Tot-sum-host1:find_Dis-tot_host( INPUT v-current-d-card, INPUT v-current-host-code) = true  THEN do:
     2841               IF  p-r-b = "rubl" AND p-is-over = false  THEN do:
     2842                 v-netto-sum1 = Tot-sum-host1:pay-tot-rubl .
     2843               end.
     2844               IF  p-r-b = "rubl" AND p-is-over = true  THEN do:
     2845                 v-netto-sum1 = Tot-sum-host1:pay-tot-rubl_byf# .
     2846               end.
     2847               IF  p-r-b = "base" AND p-is-over = false  THEN do:
     2848                 v-netto-sum1 = Tot-sum-host1:pay-tot-base .
     2849               end.
     2850               IF  p-r-b = "base" AND p-is-over = true  THEN do:
     2851                 v-netto-sum1 = Tot-sum-host1:pay-tot-base_byf# .
     2852               end.
     2853             end.
     2854             IF  Discount-host1:find_Discount_host( INPUT v-current-d-card, INPUT v-current-host-code) = false  THEN do:
     2855               IF  Discount-host1:create_Discount_host( INPUT v-current-d-card, INPUT v-current-host-code) = false  THEN do:
     2856                 undo _main, return error v-last-error-message .
     2857               end.
     2858             end.
     2859             Discount-host1:d-pcnt = dis-rule_00057( INPUT temp-dis-rule.rule-num, INPUT v-current-doc-date, INPUT v-current-doc-time, INPUT v-netto-sum1) .
     2860             IF  Discount-host1:Discount_hostsave( ) = false  THEN do:
     2861               undo _main, return error v-last-error-message .
     2862             end.
     2863                       Tot-sum-host1:Dis-tot_hostrelease_ ( ) .
     2864                       Discount-host1:Discount_hostrelease_ ( ) .
     2865           end.
     2866           else do:
     2867             v-netto-sum1 = 0.
     2868             v-current-host-code = temp-dis-rule.host-code.
     2869             v-current-obj-type = temp-dis-rule.obj-type.
     2870             v-current-obj-code = temp-dis-rule.obj-code.
     2871             IF  Tot-sum-obj1:find_Dis-tot_obj( INPUT v-current-d-card, INPUT temp-dis-rule.obj-type, temp-dis-rule.obj-code) = true  THEN do:
     2872               IF  p-r-b = "rubl" AND p-is-over = false  THEN do:
     2873                 v-netto-sum1 = Tot-sum-obj1:pay-tot-rubl .
     2874               end.
     2875               IF  p-r-b = "rubl" AND p-is-over = true  THEN do:
     2876                 v-netto-sum1 = Tot-sum-obj1:pay-tot-rubl_byf# .
     2877               end.
     2878               IF  p-r-b = "base" AND p-is-over = false  THEN do:
     2879                 v-netto-sum1 = Tot-sum-obj1:pay-tot-base .
     2880               end.
     2881               IF  p-r-b = "base" AND p-is-over = true  THEN do:
     2882                 v-netto-sum1 = Tot-sum-obj1:pay-tot-base_byf# .
     2883               end.
     2884               IF  Discount-obj1:find_Discount_obj( INPUT v-current-d-card, INPUT v-current-obj-type, INPUT v-current-obj-code) = false  THEN do:
     2885                 IF  Discount-obj1:create_Discount_obj( INPUT v-current-d-card, INPUT v-current-obj-type, INPUT v-current-obj-code) = false  THEN do:
     2886                   undo _main, return error v-last-error-message .
     2887                 end.
     2888               end.
     2889               Discount-obj1:d-pcnt = dis-rule_00057( INPUT temp-dis-rule.rule-num, INPUT v-current-doc-date, INPUT v-current-doc-time, INPUT v-netto-sum1) .
     2890               IF  Discount-obj1:Discount_objsave( ) = false  THEN do:
     2891                 undo _main, return error v-last-error-message .
     2892               end.
     2893             end.
     2894                       Tot-sum-obj1:Dis-tot_objrelease_ ( ) .
     2895                       Discount-obj1:Discount_objrelease_ ( ) .
     2896           end.
     2897       Card1:Dis-card_release_ ( ) .
     2898          end.
     2899           num-rec-ok = num-rec-ok + 1.
     2900           if p-ruleset-id = 5 then do:
     2901             run set-num-rec in p-parent-handle ( input num-rec
     2902                                                 ,input num-rec-calc-err
     2903                                                 ,input num-rec-value-err
     2904                                                 ,input num-rec-ok
     2905                                                 ,input no
     2906                                                 ) no-error .
     2907           end.
     2908           end.
     2909         end.
     2910       end.
     2911       if p-ruleset-id = 5 then do:
     2912         run set-num-rec in p-parent-handle ( input num-rec
     2913                                             ,input num-rec-calc-err
     2914                                             ,input num-rec-value-err
     2915                                             ,input num-rec-ok
     2916                                             ,input yes
     2917                                             ) no-error .
     2918       end.
     2919     end.
     2920   end procedure.
     2921   procedure load-ruleset-context :
     2922   define input parameter p-ruleset-id as integer no-undo .
     2923   define buffer buf_rule-call-param for ub.rule-call-param.
     2924   define buffer buf_dis-rule for ub.dis-rule.
     2925     do
     2926     on error undo, return error
     2927     :
     2928    find first buf_rule-call-param no-lock where
     2929   buf_rule-call-param.codex_id = p-codex-id
     2930   and buf_rule-call-param.ruleset_id = p-ruleset-id
     2931   and buf_rule-call-param.call_id = p-call-id
     2932   and buf_rule-call-param.order_id = p-order-id
     2933   and buf_rule-call-param.rule_id = p-rule-id
     2934   and buf_rule-call-param.param-name = "p-r-b"
     2935    no-error.
     2936   if available buf_rule-call-param then do:
     2937   assign p-r-b = buf_rule-call-param.param-value-character.
     2938   end.
     2939    find first buf_rule-call-param no-lock where
     2940   buf_rule-call-param.codex_id = p-codex-id
     2941   and buf_rule-call-param.ruleset_id = p-ruleset-id
     2942   and buf_rule-call-param.call_id = p-call-id
     2943   and buf_rule-call-param.order_id = p-order-id
     2944   and buf_rule-call-param.rule_id = p-rule-id
     2945   and buf_rule-call-param.param-name = "p-is-over"
     2946    no-error.
     2947   if available buf_rule-call-param then do:
     2948   assign p-is-over = buf_rule-call-param.param-value-logical.
     2949   end.
     2950    for each buf_rule-call-param no-lock where
     2951   buf_rule-call-param.codex_id = p-codex-id
     2952   and buf_rule-call-param.ruleset_id = p-ruleset-id
     2953   and buf_rule-call-param.call_id = p-call-id
     2954   and buf_rule-call-param.order_id = p-order-id
     2955   and buf_rule-call-param.rule_id = p-rule-id
     2956   and buf_rule-call-param.param-name = "p-rule-num-host"
     2957   and buf_rule-call-param.p-index > 0,
     2958     first Buf_dis-rule no-lock where
     2959           buf_dis-rule.rule-num = buf_rule-call-param.param-value-integer:
     2960     find first temp-dis-rule no-lock where
     2961               temp-dis-rule.rule-num = buf_dis-rule.rule-num no-error.
     2962     if not available temp-dis-rule then do:
     2963       create temp-dis-rule.
     2964       buffer-copy buf_dis-rule to temp-dis-rule.
     2965       release temp-dis-rule.
     2966     end.
     2967   end.
     2968    for each buf_rule-call-param no-lock where
     2969   buf_rule-call-param.codex_id = p-codex-id
     2970   and buf_rule-call-param.ruleset_id = p-ruleset-id
     2971   and buf_rule-call-param.call_id = p-call-id
     2972   and buf_rule-call-param.order_id = p-order-id
     2973   and buf_rule-call-param.rule_id = p-rule-id
     2974   and buf_rule-call-param.param-name = "p-rule-num-obj"
     2975   and buf_rule-call-param.p-index > 0,
     2976     first Buf_dis-rule no-lock where
     2977           buf_dis-rule.rule-num = buf_rule-call-param.param-value-integer:
     2978     find first temp-dis-rule no-lock where
     2979               temp-dis-rule.rule-num = buf_dis-rule.rule-num no-error.
     2980     if not available temp-dis-rule then do:
     2981       create temp-dis-rule.
     2982       buffer-copy buf_dis-rule to temp-dis-rule.
     2983       release temp-dis-rule.
     2984     end.
     2985   end.
     2986       assign
     2987       vh_dis-card-sale_obj = buffer temp-d-card:handle
     2988       v-save = p-save
     2989       .
     2990       case p-ruleset-id:
     2991         when 5 then do:
     2992           assign
     2993           v-sign = 1
     2994           v-current-host-code = p-host-code
     2995           v-current-obj-type = p-obj-type
     2996           v-current-obj-code = p-obj-code
     2997           v-current-db-num = g#db-num
     2998           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     2999           v-current-doc-code = p-doc-code
     3000           v-current-doc-date = p-doc-date
     3001           v-current-doc-time = 0
     3002           v-current-doc-fact-date = p-fact-date
     3003           v-current-date = p-doc-date
     3004           v-current-fact-date = p-fact-date
     3005           .
     3006         end.
     3007         otherwise do:
     3008           undo, return error substitute("Неверный вызов &1 для набора правил &2", vss-workfile , p-ruleset-id).
     3009         end.
     3010       end case.
     3011     end.
     3012   end procedure.
     3013   procedure delete-procedure :
     3014     do
     3015     on error undo, return error
     3016     :
     3017         run garbcoll_clear in this-procedure .
     3018     end.
     3019   end procedure.
