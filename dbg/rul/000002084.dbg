     2566   FUNCTION DIS-TIME-RULE_00002 returns logical ( input p-time-rule-num as integer, input p-date as date, input p-time as integer):
     2567   define buffer buf_dis-time-rule for ub.dis-time-rule.
     2568   find first buf_dis-time-rule no-lock where
     2569             buf_dis-time-rule.time-rule-num = p-time-rule-num no-error.
     2570   if available buf_dis-time-rule
     2571   and buf_dis-time-rule.sts = integer ('0':U) then do:
     2572     if buf_dis-time-rule.time-from <= p-time
     2573     and buf_dis-time-rule.time-to >= p-time then do:
     2574       return yes.
     2575     end.
     2576   end.
     2577   return no.
     2578   end function.
     2579   FUNCTION DIS-TIME-RULE_00003 returns logical ( input p-time-rule-num as integer, input p-date as date, input p-time as integer):
