     1165   procedure library-cls_get-handle :
     1166   define input parameter p-library-name as character no-undo .
     1167   define output parameter p-library-handle as handle no-undo .
     1168     do
     1169     on error undo, return error
     1170     :
     1171       CASE p-library-name:
     1172         when "library" then do:
     1173           if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end.
     1174           p-library-handle = g#library.
     1175         end.
     1176         when "library2" then do:
     1177           if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end.
     1178           p-library-handle = g#library2.
     1179         end.
     1180       end case.
     1181     end.
     1182   end procedure.
     1183   def var vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1184   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1185   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1186   define variable tempcxml_v-num_ as integer no-undo .
     1187   define  temp-table temp-xml-tables no-undo
