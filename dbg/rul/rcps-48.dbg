     3152   if valid-handle(p-call-handle)
     3153   and lookup("rcpscont_get-rule-on-off", p-call-handle:internal-entries) > 0 then do:
     3154     run rcpscont_set-rule-on-off in p-call-handle (
     3155                                              input p-codex-id
     3156                                             ,input p-ruleset-id
     3157                                             ,input p-rule-id
