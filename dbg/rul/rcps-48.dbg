     3163   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3164   PROCEDURE rcps_MyEnable0 :
     3165   DEFINE VARIABLE v-ii AS INTEGER NO-UNDO.
     3166   DEFINE VARIABLE v-ch0 AS widget-handle NO-UNDO.
     3167   ASSIGN
     3168   term_tt-rule-call-param.param-label:RESIZABLE IN browse br-rcp = YES
     3169   X_rp-rule-param.rp-param-name:RESIZABLE IN browse br-rcp = YES
     3170   .
     3171   ASSIGN
     3172   v-ch0 = br-rcp:FIRST-COLUMN IN FRAME Dialog-Frame.
     3173   REPEAT WHILE valid-handle(v-ch0):
     3174      IF v-ch0:LABEL = "Значение!(строковое)" THEN DO:
     3175        v-ch[1] = v-ch0.
     3176        v-ch0:VISIBLE = NO.
     3177      END.
     3178      IF v-ch0:LABEL = "Значение!(Дата)" THEN DO:
     3179        v-ch[2] = v-ch0.
     3180        v-ch0:VISIBLE = NO.
     3181      END.
     3182      IF v-ch0:LABEL = "Значение!(Десятичное)" THEN DO:
     3183        v-ch[3] = v-ch0.
     3184        v-ch0:VISIBLE = NO.
     3185      END.
     3186      IF v-ch0:LABEL = "Значение!(Целое)" THEN DO:
     3187        v-ch[4] = v-ch0.
     3188        v-ch0:VISIBLE = NO.
     3189      END.
     3190      IF v-ch0:LABEL = "Значение!(Логическое)" THEN DO:
     3191        v-ch[5] = v-ch0.
     3192        v-ch0:VISIBLE = NO.
     3193      END.
     3194      IF v-ch0:LABEL = "Точка вызова" THEN DO:
     3195        v-ch[6] = v-ch0.
     3196      END.
     3197      IF v-ch0:LABEL = "Значение" THEN
     3198      v-ch0:RESIZABLE = YES.
     3199      v-ch0 = v-ch0:NEXT-COLUMN.
     3200   END.
     3201   assign
     3202   X_rp-rule-param.rp-param-name:resizable in browse br-rcp = yes
     3203   term_tt-rule-call-param.param-name:resizable in browse br-rcp = yes
     3204   term_tt-rule-call-param.param-label:resizable in browse br-rcp = yes
     3205   .
     3206   CASE p-list-mode:
     3207     WHEN 'rule-call-param':U THEN DO:
     3208        ASSIGN
     3209        X_rp-rule-param.rp-param-name:VISIBLE IN BROWSE br-rcp = NO
     3210        .
     3211     END.
     3212     WHEN 'rp-rule-param':U
     3213     or
     3214     when 'rp-rule-param':U + chr(44) + 'все':U
     3215     THEN DO:
     3216       assign
     3217       term_tt-rule-call-param.codex_id:VISIBLE IN BROWSE br-rcp = NO
     3218       term_tt-rule-call-param.ruleset_id:VISIBLE IN BROWSE br-rcp = NO
     3219       term_tt-rule-call-param.rule_id:VISIBLE IN BROWSE br-rcp = NO
     3220       term_tt-rule-call-param.order_id:VISIBLE IN BROWSE br-rcp = NO
     3221       term_tt-rule-call-param.param-name:VISIBLE IN BROWSE br-rcp = NO
     3222       term_tt-rule-call-param.param-num:VISIBLE IN BROWSE br-rcp = NO
     3223       .
     3224     END.
     3225   END CASE.
     3226    IF p-call-id <> '':U THEN DO:
     3227      v-ch[6]:VISIBLE = NO.
     3228    END.
     3229     IF p-profile-id <> 0 THEN DO:
     3230      term_tt-rule-call-param.profile_id :VISIBLE IN BROWSE br-rcp= NO.
     3231    END.
     3232     IF p-rule-id <> 0 THEN DO:
     3233      term_tt-rule-call-param.RULE_id :VISIBLE IN BROWSE br-rcp= NO.
     3234    END.
     3235     IF p-once-more <> 0 THEN DO:
     3236      term_tt-rule-call-param.once-more :VISIBLE IN BROWSE br-rcp= NO.
     3237    END.
     3238   END PROCEDURE.
     3239   PROCEDURE rcps_Openbr :
     3240   CASE p-list-mode:
     3241     WHEN 'rp-rule-param':U THEN DO:
     3242         OPEN QUERY br-rcp
     3243         FOR EACH  X_ruledict-param NO-LOCK WHERE X_ruledict-param.entry-id = v-rcps-entry-id
     3244             ,FIRST X_rp-rule-param WHERE
     3245                 X_rp-rule-param.profile_id = p-profile-id
     3246             AND X_rp-rule-param.rp-param-name = X_ruledict-param.param-name
     3247           , first tt-rule-call-param WHERE
     3248              tt-rule-call-param.codex_id = X_rp-rule-param.codex_id
     3249          AND tt-rule-call-param.ruleset_id = X_rp-rule-param.ruleset_id
     3250          AND tt-rule-call-param.rule_id = X_rp-rule-param.rule_id
     3251          AND tt-rule-call-param.param-name = X_rp-rule-param.rule-param-name
     3252            ,each term_tt-rule-call-param where
     3253                  term_tt-rule-call-param.call_id = tt-rule-call-param.call_id
     3254              and term_tt-rule-call-param.codex_id = tt-rule-call-param.codex_id
     3255              and term_tt-rule-call-param.ruleset_id = tt-rule-call-param.ruleset_id
     3256              and term_tt-rule-call-param.order_id = tt-rule-call-param.order_id
     3257              and term_tt-rule-call-param.param-name = tt-rule-call-param.param-name
     3258         BY tt-rule-call-param.call_id
     3259         BY tt-rule-call-param.codex_id
     3260         BY tt-rule-call-param.ruleset_id
     3261         BY tt-rule-call-param.order_id
     3262         BY tt-rule-call-param.param-num.
     3263     END.
     3264   END CASE.
     3265   apply "ENTRY" to br-rcp in frame Dialog-Frame .
     3266   APPLy "VALUE-CHANGED" to br-rcp.
     3267   END PROCEDURE.
     3268   PROCEDURE rcps_proc-b-chg PRIVATE :
     3269   DEFINE VARIABLE v-rec1 AS Rowid NO-UNDO.
     3270   DEFINE VARIABLE v-rec2 AS Rowid NO-UNDO.
     3271   DEFINE VARIABLE v-rec3 AS Rowid NO-UNDO.
     3272   DEFINE VARIABLE v-rec4 AS Rowid NO-UNDO.
     3273   define variable v-param-data-type as character no-undo .
     3274   define variable v-rid-list as character no-undo .
     3275   IF NOT AVAILABLE TERM_tt-rule-call-param  THEN DO:
     3276     RETURN ERROR.
     3277   END.
     3278   ASSIGN
     3279   v-rec1 = rowid(X_ruledict-param)
     3280   v-rec2 = rowid(X_rp-rule-param)
     3281   v-rec3 = Rowid(tt-rule-call-param)
     3282   v-rec4 = Rowid(term_tt-rule-call-param)
     3283   .
     3284   run rcps_openbr in this-procedure .
     3285   REPOSITION br-rcp TO Rowid v-rec1, v-rec2,v-rec3, v-rec4 NO-ERROR.
     3286   IF ERROR-STATUS:ERROR THEN DO:
     3287     REPOSITION br-rcp TO ROW 1 NO-ERROR.
     3288   END.
     3289   APPLY "ENTRY" TO br-rcp in frame Dialog-Frame .
     3290   APPLY "VALUE-CHANGED" TO br-rcp in frame Dialog-Frame .
     3291   END PROCEDURE.
     3292   PROCEDURE rcps_set-row-color :
     3293   DEFINE INPUT PARAMETER p-data-type AS CHARACTER NO-UNDO.
     3294   ASSIGN
     3295   v-ch[1]:FGCOLOR = GREY_COLOR
     3296   v-ch[1]:BGCOLOR = GREY_Color
     3297   v-ch[1]:PFCOLOR = GREY_Color
     3298   v-ch[2]:FGCOLOR = GREY_COLOR
     3299   v-ch[2]:BGCOLOR = GREY_Color
     3300   v-ch[2]:PFCOLOR = GREY_Color
     3301   v-ch[3]:FGCOLOR = GREY_COLOR
     3302   v-ch[3]:BGCOLOR = GREY_Color
     3303   v-ch[3]:PFCOLOR = GREY_Color
     3304   v-ch[4]:FGCOLOR = GREY_COLOR
     3305   v-ch[4]:BGCOLOR = GREY_Color
     3306   v-ch[4]:PFCOLOR = GREY_Color
     3307   v-ch[5]:FGCOLOR = GREY_COLOR
     3308   v-ch[5]:BGCOLOR = GREY_Color
     3309   v-ch[5]:PFCOLOR = GREY_Color
     3310   .
     3311   CASE entry(1, p-data-type):
     3312        WHEN 'character':U THEN DO:
     3313         ASSIGN
     3314         v-ch[1]:FGCOLOR = BLACK_COLOR
     3315         v-ch[1]:BGCOLOR = WHITE_Color.
     3316       END.
     3317       WHEN 'decimal':U THEN DO:
     3318         ASSIGN
     3319         v-ch[3]:FGCOLOR = BLACK_COLOR
     3320         v-ch[3]:BGCOLOR = WHITE_Color.
     3321       END.
     3322       WHEN 'integer':U THEN DO:
     3323         ASSIGN
     3324         v-ch[4]:FGCOLOR = BLACK_COLOR
     3325         v-ch[4]:BGCOLOR = WHITE_Color.
     3326       END.
     3327       WHEN 'date':U THEN DO:
     3328         ASSIGN
     3329         v-ch[2]:FGCOLOR = BLACK_COLOR
     3330         v-ch[2]:BGCOLOR = WHITE_Color.
     3331        END.
     3332        WHEN 'logical':U THEN DO:
     3333          ASSIGN
     3334          v-ch[5]:FGCOLOR = BLACK_COLOR
     3335          v-ch[5]:BGCOLOR = WHITE_Color.
     3336        END.
     3337   END CASE.
     3338   END PROCEDURE.
     3339   MAIN-BLOCK:
     3340   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3341      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3342      run gbl/dftempl.p ( input 'rp-rule-param':U
     3343                        , output v-dflt-rec) no-error.
     3344       if error-status:error then dO:
     3345         message
     3346         vss-workfile vss-revision vss-description skip
     3347         "Невозможно найти recid template записи в таблице rp-rule-param"
     3348         view-as alert-box error .
     3349         return error.
     3350       end.
     3351       run gbl/dftempl.p ( input 'ruledict-param':U
     3352                         , output v-rp-dflt-rec) no-error.
     3353        if error-status:error then dO:
     3354          message
     3355          vss-workfile vss-revision vss-description skip
     3356          "Невозможно найти recid template записи в таблице ruledict-param"
     3357          view-as alert-box error .
     3358          return error.
     3359        end.
     3360     IF p-list-mode = 'rp-rule-param':U
     3361     or p-list-mode = 'rp-rule-param':U  + chr(44) + 'все':U
     3362     THEN DO:
     3363       FIND FIRST buf_rule-profile NO-LOCK WHERE
     3364                 buf_rule-profile.profile_id = p-profile-id.
     3365       run gen-key-rec in this-procedure ( input 'rule-profile':U
     3366                                       ,input buffer buf_rule-profile:handle
     3367                                       ,output v-uniq-key-rec).
     3368       FIND FIRST buf_ruledict NO-LOCK WHERE
     3369                 buf_ruledict.entry-type = 'rule-profile':U
     3370          AND  buf_ruledict.uniq-key-rec = v-uniq-key-rec.
     3371       v-rcps-entry-id = buf_ruledict.entry-id.
     3372     END.
     3373     ELSE DO:
     3374        MESSAGE
     3375        substitute("Неверное значение параметра p-list-mode=&1", p-list-mode)
     3376        VIEW-AS alert-box.
     3377     END.
     3378     RUN rcps_fill-table IN THIS-PROCEDURE ( input yes).
     3379     RUN Myenable in THIS-PROCEDURE.
     3380     WAIT-FOR GO OF FRAME Dialog-Frame.
     3381   END.
     3382   RUN disable_UI.
     3383   PROCEDURE disable_UI :
     3384     HIDE FRAME Dialog-Frame.
     3385   END PROCEDURE.
     3386   PROCEDURE enable_UI :
     3387     DISPLAY E-shops f-host-code SelectObject rs-period-type TEXT-1 TEXT-2
     3388         WITH FRAME Dialog-Frame.
     3389     ENABLE B-exit b-quit B-Help E-shops SelectObject BUTTON-obj rs-period-type
     3390            BR-rcp TEXT-1 TEXT-2
     3391         WITH FRAME Dialog-Frame.
     3392     VIEW FRAME Dialog-Frame.
     3393   END PROCEDURE.
     3394   PROCEDURE MyEnable :
     3395   define variable v-list as character no-undo .
     3396   define variable glog as logical no-undo .
     3397   define variable v-index-id as integer no-undo .
     3398   define variable v-value-character as character no-undo .
     3399   define variable v-value-date as date no-undo .
     3400   define variable v-value-decimal as decimal no-undo .
     3401   define variable v-value-integer as integer no-undo .
     3402   define variable v-value-logical as logical no-undo .
     3403   define variable v-shop-code as integer no-undo .
     3404   define buffer buf_shop for ub.shop.
     3405   run rcps_Myenable0 in this-procedure .
     3406   v-index-id = 0.
     3407   RUN rcps_get-value IN THIS-PROCEDURE (
     3408                                    INPUT p-profile-id
     3409                                   ,INPUT p-once-more
     3410                                   ,INPUT p-call-id
     3411                                   ,INPUT "p-period-type"
     3412                                   ,INPUT-output v-index-id
     3413                                   ,output rs-period-type
     3414                                   ,output v-value-date
     3415                                   ,output v-value-decimal
     3416                                   ,output v-value-integer
     3417                                   ,output v-value-logical
     3418                                   ).
     3419   v-index-id = 0.
     3420   RUN rcps_get-value IN THIS-PROCEDURE (
     3421                                   INPUT p-profile-id
     3422                                   ,INPUT p-once-more
     3423                                   ,INPUT p-call-id
     3424                                   ,INPUT "p-host-code"
     3425                                   ,INPUT-output v-index-id
     3426                                   ,output v-value-character
     3427                                   ,output v-value-date
     3428                                   ,output v-value-decimal
     3429                                   ,output v-host-code
     3430                                   ,output v-value-logical
     3431                                   ).
     3432   v-index-id = 0.
     3433   do while v-index-id >= 0 :
     3434     RUN rcps_get-value IN THIS-PROCEDURE (
     3435                                      INPUT p-profile-id
     3436                                     ,INPUT p-once-more
     3437                                     ,INPUT p-call-id
     3438                                     ,INPUT "p-shops"
     3439                                     ,INPUT-output v-index-id
     3440                                     ,output v-value-character
     3441                                     ,output v-value-date
     3442                                     ,output v-value-decimal
     3443                                     ,output v-shop-code
     3444                                     ,output v-value-logical
     3445                                     ) no-error .
     3446     if error-status:error then v-index-id = -1.
     3447     else do:
     3448   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3449   run create_obj-list in this-procedure
     3450    ( input 'маг':U ,
     3451      input v-shop-code )
     3452      .
     3453       find first obj-list where
     3454             obj-list.obj-code = v-shop-code
     3455           and obj-list.obj-type = 'маг':U no-error.
     3456       if available obj-list then do:
     3457         glog = e-shops:INSERT-STRING ( display-shop(v-shop-code
     3458                                                     ,obj-list.obj-name )) in frame Dialog-Frame .
     3459         glog = e-shops:INSERT-STRING ( chr(10) ) in frame Dialog-Frame .
     3460       end.
     3461     end.
     3462   end.
     3463   define variable v-ii as integer no-undo .
     3464   define variable v-jj as integer no-undo .
     3465   define variable v-period-type as character no-undo .
     3466   do v-ii = 1 to num-entries('day,week,month,year,hour,hour-last,shift,shift-last,yesterday,week-last,month-last,year-last,halfyear,halfyear-last,quarter,quarter-last':U):
     3467     v-period-type = entry(v-ii, 'day,week,month,year,hour,hour-last,shift,shift-last,yesterday,week-last,month-last,year-last,halfyear,halfyear-last,quarter,quarter-last':U).
     3468     if not (v-period-type = 'yesterday':U
     3469            or
     3470            v-period-type = 'week-last':U
     3471            or
     3472            v-period-type = 'month-last':U)
     3473     then next.
     3474     v-jj = v-jj + 1.
     3475     assign
     3476     v-list = v-list + (if v-jj = 1 then '' else chr(44)) +
     3477                                  entry (lookup (v-period-type, 'day,week,month,year,hour,hour-last,shift,shift-last,yesterday,week-last,month-last,year-last,halfyear,halfyear-last,quarter,quarter-last':U) + 1, ',' + 'День,Неделя,Месяц,Год,Час (текущий),Час (прошлый),Смена,Смена (прошлая),Вчера,Неделя (прошлая),Месяц (прошлый),Год (прошлый),Полугодие,Полугодие (прошлое),Квартал,Квартал (прошлый)':U) + chr(44) + v-period-type .
     3478   end.
     3479   rs-period-type:radio-buttons in frame Dialog-Frame = v-list.
     3480   selectobject:RADIO-BUTTONS IN FRAME Dialog-Frame =
     3481       'Все' + chr(44) + string(0) + chr(44) +
     3482       'Фирма' + chr(44) + string(1) + chr(44) +
     3483       'Выборочно' + chr(44) + string(-1).
     3484   f-host-code = v-host-code.
     3485   if can-find(first obj-list) then do:
     3486     selectobject = integer(string(-1)).
     3487   end.
     3488   else do:
     3489     if v-host-code = 0 then do:
     3490       selectobject =integer( string(0)).
     3491       for each buf_shop no-lock:
     3492   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3493   run create_obj-list in this-procedure
     3494    ( input 'маг':U ,
     3495      input buf_shop.obj-code )
     3496      .
     3497       find first obj-list where
     3498             obj-list.obj-code = buf_shop.obj-code
     3499           and obj-list.obj-type = 'маг':U.
     3500       glog = e-shops:INSERT-STRING ( display-shop(buf_shop.obj-code
     3501                                                   , obj-list.obj-name )) in frame Dialog-Frame .
     3502         glog = e-shops:INSERT-STRING ( chr(10) ) in frame Dialog-Frame .
     3503       end.
     3504     end.
     3505     else do:
     3506       for each buf_shop no-lock where buf_shop.host-code = v-host-code:
     3507   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3508   run create_obj-list in this-procedure
     3509    ( input 'маг':U ,
     3510      input buf_shop.obj-code )
     3511      .
     3512       find first obj-list where
     3513             obj-list.obj-code = buf_shop.obj-code
     3514           and obj-list.obj-type = 'маг':U.
     3515         glog = e-shops:INSERT-STRING ( display-shop(
     3516                                                   buf_shop.obj-code
     3517                                                   , obj-list.obj-name )) in frame Dialog-Frame .
     3518         glog = e-shops:INSERT-STRING ( chr(10) ) in frame Dialog-Frame .
     3519       end.
     3520       selectobject = integer(string(1)).
     3521     end.
     3522   end.
     3523   display
     3524   rs-period-type
     3525   selectobject
     3526   f-host-code when selectobject = 1
     3527   with frame Dialog-Frame .
     3528   ENABLE
     3529   B-exit WHEN p-mode <> 'ПРОСМОТР':U
     3530   b-quit
     3531   selectobject WHEN p-mode <> 'ПРОСМОТР':U
     3532   rs-period-type  WHEN p-mode <> 'ПРОСМОТР':U
     3533   button-obj  WHEN p-mode <> 'ПРОСМОТР':U
     3534   br-rcp
     3535   e-shops
     3536   WITH FRAME Dialog-Frame.
     3537   VIEW FRAME Dialog-Frame.
     3538   IF p-mode = 'ПРОСМОТР':U THEN DO:
     3539      ASSIGN
     3540      b-quit:COLUMN = 1
     3541      b-quit:LABEL = "&Выход".
     3542      HIDE
     3543      b-exit
     3544      IN FRAME Dialog-Frame.
     3545   END.
     3546   ASSIGN
     3547   FRAME Dialog-Frame:TITLE = substitute("Параметры вызова правил: &1", p-title).
     3548   RUN rcps_OpenBr in THIS-PROCEDURE.
     3549   END PROCEDURE.
     3550   PROCEDURE proc-save :
     3551   define variable v-ii as integer   no-undo .
     3552   assign
     3553   frame Dialog-Frame
     3554   rs-period-type
     3555   selectobject
     3556   .
     3557   RUN rcps_set-value IN THIS-PROCEDURE (
     3558                                   INPUT p-profile-id
     3559                                   ,INPUT p-once-more
     3560                                   ,INPUT p-call-id
     3561                                   ,INPUT "p-period-type"
     3562                                   ,INPUT 0
     3563                                   ,INPUT rs-period-type
     3564                                   ,INPUT ?
     3565                                   ,INPUT 0.0
     3566                                   ,INPUT 0
     3567                                   ,INPUT NO
     3568                                   ).
     3569   case selectobject:
     3570     when integer(string(-1)) then do:
     3571      v-ii = 0.
     3572      for each obj-list :
     3573       v-ii = v-ii + 1.
     3574       RUN rcps_set-value IN THIS-PROCEDURE (
     3575                                       INPUT p-profile-id
     3576                                       ,INPUT p-once-more
     3577                                       ,INPUT p-call-id
     3578                                       ,INPUT "p-shops"
     3579                                       ,INPUT v-ii
     3580                                       ,INPUT ''
     3581                                       ,INPUT ?
     3582                                       ,INPUT 0.0
     3583                                       ,INPUT obj-list.obj-code
     3584                                       ,INPUT NO
     3585                                       ).
     3586      end.
     3587       RUN rcps_set-value IN THIS-PROCEDURE (
     3588                                       INPUT p-profile-id
     3589                                       ,INPUT p-once-more
     3590                                       ,INPUT p-call-id
     3591                                       ,INPUT "p-host-code"
     3592                                       ,INPUT 0
     3593                                       ,INPUT ''
     3594                                       ,INPUT ?
     3595                                       ,INPUT 0.0
     3596                                       ,INPUT 0
     3597                                       ,INPUT NO
     3598                                       ).
     3599     end.
     3600     when integer(string(0)) then do:
     3601       for each obj-list:
     3602         delete obj-list.
     3603       end.
     3604       RUN rcps_set-value IN THIS-PROCEDURE (
     3605                                       INPUT p-profile-id
     3606                                       ,INPUT p-once-more
     3607                                       ,INPUT p-call-id
     3608                                       ,INPUT "p-host-code"
     3609                                       ,INPUT 0
     3610                                       ,INPUT ''
     3611                                       ,INPUT ?
     3612                                       ,INPUT 0.0
     3613                                       ,INPUT 0
     3614                                       ,INPUT NO
     3615                                       ).
     3616     end.
     3617     when integer(string(1)) then do:
     3618       assign
     3619       f-host-code
     3620       v-host-code = f-host-code.
     3621       for each obj-list:
     3622         delete obj-list.
     3623       end.
     3624       RUN rcps_set-value IN THIS-PROCEDURE (
     3625                                       INPUT p-profile-id
     3626                                       ,INPUT p-once-more
     3627                                       ,INPUT p-call-id
     3628                                       ,INPUT "p-host-code"
     3629                                       ,INPUT 0
     3630                                       ,INPUT ''
     3631                                       ,INPUT ?
     3632                                       ,INPUT 0.0
     3633                                       ,INPUT v-host-code
     3634                                       ,INPUT NO
     3635                                       ).
     3636     end.
     3637   end case.
     3638   v-ii = v-ii + 1.
     3639   do while true:
     3640     run rcps_proc-b-del in this-procedure  (
     3641                                            INPUT p-profile-id
     3642                                           ,INPUT p-once-more
     3643                                           ,INPUT p-call-id
     3644                                           ,input "p-shops"
     3645                                           ,input v-ii) no-error.
     3646     if error-status:error
     3647     or return-value = "not-found" then leave.
     3648     v-ii = v-ii + 1.
     3649   end.
     3650   run rcps_proc-save0 in this-procedure .
     3651   END PROCEDURE.
     3652   PROCEDURE select-objects-proc :
     3653   define input parameter p-save-objects as logical no-undo .
     3654   define variable v-ii as integer   no-undo .
     3655   define variable v-rid-list as character no-undo .
     3656   define variable glog AS LOGICAL no-undo .
     3657   define buffer buf_sysconf for ub.sysconf.
     3658   define buffer buf_shop for ub.shop.
     3659   ASSIGN
     3660   e-shops:SCREEN-VALUE IN FRAME Dialog-Frame = ''.
     3661   case selectobject :
     3662     when integer(string(0)) then   do:
     3663       for each obj-list :
     3664         delete obj-list.
     3665       end.
     3666       for each buf_shop no-lock:
     3667   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3668   run create_obj-list in this-procedure
     3669    ( input 'маг':U ,
     3670      input buf_shop.obj-code )
     3671      .
     3672       find first obj-list where
     3673             obj-list.obj-code = buf_shop.obj-code
     3674           and obj-list.obj-type = 'маг':U.
     3675       glog = e-shops:INSERT-STRING ( display-shop(
     3676                                                   buf_shop.obj-code
     3677                                                   , obj-list.obj-name )) in frame Dialog-Frame .
     3678         glog = e-shops:INSERT-STRING ( chr(10) ) in frame Dialog-Frame .
     3679       end.
     3680     end.
     3681     when integer(string(1)) then   do:
     3682       for each obj-list :
     3683       delete obj-list.
     3684       end.
     3685         define variable v-firm-code as integer no-undo .
     3686         if f-host-code > 0 then do:
     3687           find first buf_sysconf no-lock where
     3688                     buf_sysconf.host-code = f-host-code no-error .
     3689          if available buf_sysconf then do:
     3690             v-rid-list = STRING(recid(buf_sysconf)).
     3691          end.
     3692         end.
     3693         run adm/sconfs.w (
     3694               input parParentProc
     3695             , input "b-sel":U
     3696             , input no
     3697             , input 0
     3698             , output v-firm-code
     3699             , input-output v-rid-list
     3700         ) no-error.
     3701       if v-rid-list <> '' then do:
     3702         find first buf_sysconf no-lock where
     3703                   recid(buf_sysconf) = integer(v-rid-list) .
     3704         for each buf_shop no-lock where
     3705                 buf_shop.host-code = buf_sysconf.host-code:
     3706   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3707   run create_obj-list in this-procedure
     3708    ( input 'маг':U ,
     3709      input buf_shop.obj-code )
     3710      .
     3711             find first obj-list where
     3712                   obj-list.obj-code = buf_shop.obj-code
     3713                and obj-list.obj-type = 'маг':U.
     3714             glog = e-shops:INSERT-STRING ( display-shop(
     3715                                                         buf_shop.obj-code
     3716                                                        , obj-list.obj-name )) in frame Dialog-Frame .
     3717              glog = e-shops:INSERT-STRING ( chr(10) ) in frame Dialog-Frame .
     3718           f-host-code = buf_sysconf.host-code.
     3719           display
     3720           f-host-code
     3721           with frame Dialog-Frame .
     3722         end.
     3723       end.
     3724       else do:
     3725         undo, return error .
     3726       end.
     3727     end.
     3728     when integer(string(-1)) then do:
     3729       for each obj-list :
     3730         if p-save-objects then do:
     3731           find first buf_shop no-lock where
     3732                     buf_shop.obj-code = obj-list.obj-code no-error.
     3733           if available buf_shop then do:
     3734             v-rid-list = v-rid-list + (if v-rid-list = '' then '' else chr(44)) + string(recID(BUF_SHOP)).
     3735           end.
     3736         end.
     3737         delete obj-list.
     3738       end.
     3739       v-save-objects = yes.
     3740       run adm/shops.w ( input parparentproc
     3741                         ,input "b-sel,b-mark"
     3742                         ,input-output v-rid-list
     3743                         ,no ) no-error.
     3744       if v-rid-list <> '' then do:
     3745         do v-ii = 1 to num-entries(v-rid-list):
     3746           find first buf_shop no-lock where
     3747                     recid(buf_shop) = integer(entry(v-ii, v-rid-list)) no-error.
     3748           if available buf_shop then do:
     3749   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3750   run create_obj-list in this-procedure
     3751    ( input 'маг':U ,
     3752      input buf_shop.obj-code )
     3753      .
     3754             find first obj-list where
     3755                   obj-list.obj-code = buf_shop.obj-code
     3756                and obj-list.obj-type = 'маг':U.
     3757             glog = e-shops:INSERT-STRING ( display-shop(
     3758                                                        buf_shop.obj-code
     3759                                                        , obj-list.obj-name )) in frame Dialog-Frame .
     3760              glog = e-shops:INSERT-STRING ( chr(10) ) in frame Dialog-Frame .
     3761           end.
     3762         end.
     3763       end.
     3764       else do:
     3765         undo, return error .
     3766       end.
     3767     end.
     3768   end case.
     3769   END PROCEDURE.
     3770   PROCEDURE val-obj :
     3771   If SelectObject:SCREEN-VALUE IN FRAME Dialog-Frame = STRING(string(-1))
     3772    THEN  do:
     3773     enable
     3774     BUTTON-obj
     3775     with frame Dialog-Frame .
     3776   end.
     3777   else do:
     3778     Disable
     3779     BUTTON-obj
     3780     with frame Dialog-Frame .
     3781   end.
     3782   If  SelectObject:screen-value
     3783   IN FRAME Dialog-Frame =  string(string(1))
     3784   then  do:
     3785     view
     3786     f-host-code
     3787     in frame Dialog-Frame .
     3788   end.
     3789   else do:
     3790     hide
     3791     f-host-code
     3792     in frame Dialog-Frame .
     3793   end.
     3794   END PROCEDURE.
