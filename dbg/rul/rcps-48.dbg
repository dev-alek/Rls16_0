     1247        IMAGE-UP FILE "btn-down-arrow":U
     1248        IMAGE-DOWN FILE "btn-down-arrow":U
     1249        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1250        LABEL "BUTTON-obj"
     1251        SIZE 3 BY .87.
     1252   DEFINE VARIABLE E-shops AS CHARACTER
     1253        VIEW-AS EDITOR SCROLLBAR-VERTICAL
     1254        SIZE 55 BY 13.87 NO-UNDO.
     1255   DEFINE VARIABLE f-host-code AS INTEGER FORMAT ">>>>9":U INITIAL 0
     1256        LABEL "Фирма"
     1257        VIEW-AS FILL-IN NATIVE
     1258        SIZE 7 BY 1 NO-UNDO.
     1259   DEFINE VARIABLE TEXT-1 AS CHARACTER FORMAT "X(256)":U INITIAL "Выбор объекта"
     1260         VIEW-AS TEXT
     1261        SIZE 14 BY .67
     1262        FGCOLOR 4  NO-UNDO.
     1263   DEFINE VARIABLE TEXT-2 AS CHARACTER FORMAT "X(256)":U INITIAL "Выбор диапазона"
     1264         VIEW-AS TEXT
     1265        SIZE 15.5 BY .67
     1266        FGCOLOR 4  NO-UNDO.
     1267   DEFINE VARIABLE rs-period-type AS CHARACTER
     1268        VIEW-AS RADIO-SET VERTICAL
     1269        RADIO-BUTTONS
     1270             "Вчера", "yesterday",
     1271   "Пр.неделя", "week-last",
     1272   "Пр.месяц", "month-last"
     1273        SIZE 21 BY 8.8 NO-UNDO.
     1274   DEFINE VARIABLE SelectObject AS INTEGER
     1275        VIEW-AS RADIO-SET VERTICAL
     1276        RADIO-BUTTONS
     1277             "Все по фирме", 1,
     1278   "Выборочно", 2,
     1279   "Все", 0
     1280        SIZE 16.4 BY 2.77 NO-UNDO.
     1281   DEFINE QUERY BR-rcp FOR
     1282         X_ruledict-param,
     1283         X_rp-rule-param,
     1284         tt-rule-call-param,
     1285         TERM_tt-rule-call-param SCROLLING.
     1286   DEFINE BROWSE BR-rcp
     1287     QUERY BR-rcp DISPLAY
     1288         X_rp-rule-param.rp-param-name COLUMN-LABEL "Название пар-ра!профайла" FORMAT "X(20)" width 16
     1289   term_tt-rule-call-param.codex_id COLUMN-LABEL "Кодекс"
     1290   term_tt-rule-call-param.ruleset_id COLUMN-LABEL "Набор"
     1291   term_tt-rule-call-param.order_id  COLUMN-LABEL "Порядок!вызова"
     1292   term_tt-rule-call-param.rule_id  COLUMN-LABEL "Правило"
     1293   term_tt-rule-call-param.profile_id  COLUMN-LABEL "Профайл"
     1294   term_tt-rule-call-param.once-more COLUMN-LABEL "№!Привязки"
     1295   (if lookup (term_tt-rule-call-param.param-data-type, 'character,date,datetime,datetime-tz,decimal,integer,void,logical,memptr,raw,recid,rowid,widget-handle,handle,blob,clob,class,com-handle,longchar,int64':U) > 0 then entry (lookup (term_tt-rule-call-param.param-data-type, 'character,date,datetime,datetime-tz,decimal,integer,void,logical,memptr,raw,recid,rowid,widget-handle,handle,blob,clob,class,com-handle,longchar,int64':U), 'строка,дата,дата-время,дата-время-з,десятичное,целое,пусто,логическое,память,двоичные,номер записи,Номер Записи,ссылка,ссылка,Больш.бин.объект,Больш.стр.объект,Объект,COM-объект,Длинная строка,64Целое':U) else term_tt-rule-call-param.param-data-type) COLUMN-LABEL "Тип пар-ра" FORMAT "X(12)"
     1296   term_tt-rule-call-param.param-num COLUMN-LABEL "№!пар-ра" FORMAT ">9"
     1297   TERM_tt-rule-call-param.p-index COLUMN-LABEL "Инд!екс" FORMAT ">9"
     1298   term_tt-rule-call-param.param-name COLUMN-LABEL "Название пар-ра!правила" FORMAT "X(16)"
     1299   term_tt-rule-call-param.param-label COLUMN-LABEL "Название пар-ра" FORMAT "X(255)" WIDTH 30
     1300   entry (lookup (term_tt-rule-call-param.param-mode, 'input,output,input-output,buffer,input table,output table,input-output table':u), 'вх,вых,вх-вых,курсор,вх табл,вых табл,вх/вых табл':u) COLUMN-LABEL "Вид!пар-ра"
     1301   get-param-value( INPUT term_tt-rule-call-param.param-data-type
     1302                   ,INPUT term_tt-rule-call-param.param-2-data-type
     1303                   ,INPUT term_tt-rule-call-param.param-3-data-type
     1304                   ,INPUT TERM_tt-rule-call-param.p-index
     1305                   ,INPUT term_tt-rule-call-param.param-value-character
     1306                   ,INPUT term_tt-rule-call-param.param-value-date
     1307                   ,INPUT term_tt-rule-call-param.param-value-decimal
     1308                   ,INPUT term_tt-rule-call-param.param-value-integer
     1309                   ,INPUT term_tt-rule-call-param.param-value-logical) COLUMN-LABEL "Значение" FORMAT "X(255)" WIDTH 26
     1310   (IF term_tt-rule-call-param.param-data-type = 'character':U
     1311    THEN term_tt-rule-call-param.param-value-character
     1312    ELSE '':U) COLUMN-LABEL "Значение!(строковое)" FORMAT "X(26)"
     1313   (IF term_tt-rule-call-param.param-data-type = 'date':U
     1314   THEN STRING(term_tt-rule-call-param.param-value-date, "99/99/9999")
     1315   ELSE '':U)    COLUMN-LABEL "Значение!(Дата)" FORMAT "X(10)" WIDTH 12
     1316   (IF term_tt-rule-call-param.param-data-type = 'decimal':U
     1317   THEN STRING(term_tt-rule-call-param.param-value-decimal)
     1318   ELSE '':U) COLUMN-LABEL "Значение!(Десятичное)"   FORMAT "X(16)"
     1319   (IF term_tt-rule-call-param.param-data-type = 'integer':U
     1320   THEN STRING(term_tt-rule-call-param.param-value-integer)
     1321   ELSE '':U) COLUMN-LABEL "Значение!(Целое)" FORMAT "X(10)"
     1322   (IF term_tt-rule-call-param.param-data-type = 'logical':U
     1323   THEN STRING(term_tt-rule-call-param.param-value-logical, "+/-")
     1324   ELSE '':U) COLUMN-LABEL "Значение!(Логическое)" FORMAT "X(2)"
     1325   calldscr(tt-rule-call-param.call_id) COLUMN-LABEL  "Точка вызова" FORMAT "X(40)"
     1326       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 6.27
     1327            FONT 4 ROW-HEIGHT-CHARS .67 FIT-LAST-COLUMN.
     1328   DEFINE FRAME Dialog-Frame
     1329        B-exit AT ROW 1 COL 1
     1330        b-quit AT ROW 1 COL 11
     1331        B-Help AT ROW 1 COL 95
     1332        E-shops AT ROW 2 COL 41 NO-LABEL WIDGET-ID 18
     1333        f-host-code AT ROW 3.93 COL 29 COLON-ALIGNED WIDGET-ID 26
     1334        SelectObject AT ROW 4 COL 2 NO-LABEL WIDGET-ID 8
     1335        BUTTON-obj AT ROW 4.47 COL 19 WIDGET-ID 14
     1336        rs-period-type AT ROW 7.93 COL 2.5 NO-LABEL WIDGET-ID 20
     1337        BR-rcp AT ROW 16.97 COL 1 WIDGET-ID 100
     1338        TEXT-1 AT ROW 3 COL 1 COLON-ALIGNED NO-LABEL WIDGET-ID 16
     1339        TEXT-2 AT ROW 7.13 COL 2.5 NO-LABEL WIDGET-ID 24
     1340        SPACE(81.00) SKIP(15.45)
     1341       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1342            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1343            TITLE ""
     1344            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
     1345   ASSIGN
     1346          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1347          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1348   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1349   DO:
     1350     APPLY "END-ERROR":U TO SELF.
     1351   END.
     1352   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
     1353   DO:
     1354     RUN proc-save IN THIS-PROCEDURE  NO-ERROR.
     1355     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1356   END.
     1357   ON CHOOSE OF BUTTON-obj IN FRAME Dialog-Frame
     1358   DO:
     1359   define variable v-old-selectobject as integer no-undo .
     1360     assign
     1361     v-old-selectobject = SelectObject
     1362     SelectObject.
     1363     run select-objects-proc in this-procedure ( v-save-objects ) no-error.
     1364     if error-status:error then do:
     1365       assign
     1366       selectobject = v-old-selectobject
     1367       .
     1368       display
     1369       selectobject
     1370       with frame Dialog-Frame .
     1371     end.
     1372   END.
     1373   ON VALUE-CHANGED OF rs-period-type IN FRAME Dialog-Frame
     1374   DO:
     1375     ASSIGN
     1376     rs-period-type.
     1377   END.
     1378   ON VALUE-CHANGED OF SelectObject IN FRAME Dialog-Frame
     1379   DO:
     1380   Assign SelectObject.
     1381   v-save-objects = no.
     1382   run select-objects-proc in this-procedure ( input v-save-objects).
     1383   run val-obj in this-procedure .
     1384   END.
     1385   ON ROW-DISPLAY OF br-rcp IN frame Dialog-Frame
     1386   DO:
     1387     IF AVAIL tt-rule-call-param THEN DO:
     1388       RUN rcps_set-row-color IN THIS-PROCEDURE ( INPUT term_tt-rule-call-param.param-data-type).
     1389     END.
     1390   END.
     1391   ON f6 anywhere DO:
     1392     ASSIGN
     1393     br-rcp:VISIBLE IN FRAME Dialog-Frame = (NOT br-rcp:VISIBLE IN FRAME Dialog-Frame)
     1394     .
     1395   END.
     1396   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1397   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1398   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1399   on help of frame Dialog-Frame
     1400   do:
     1401     run gbl/app_help.p
     1402       (input this-procedure :file-name
     1403       ,input ''
     1404       ,input ?
     1405       ) no-error.
     1406     if error-status :error then do:
     1407       message
     1408         "Ошибка при вызове помощи"
     1409         error-status :get-message(1)
     1410         view-as alert-box .
     1411     end.
     1412   end.
     1413   run minbtn-set in this-procedure .
     1414   on choose of b-help in frame Dialog-Frame
     1415   do:
     1416     apply "help":u to frame Dialog-Frame .
     1417   end.
     1418   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1419   procedure minbtn-set :
     1420       do
     1421           on error undo, return error return-value
     1422           :
     1423           define variable ii              as integer       no-undo .
     1424           define variable fh              as widget-handle no-undo .
     1425           define variable hh              as widget-handle no-undo .
     1426           define variable v-h             as handle        extent 4 no-undo .
     1427           define variable v-name-button   as character     no-undo .
     1428           define variable v-help-old-x    as decimal       no-undo .
     1429           define variable v-help-old-y    as decimal       no-undo .
     1430           define variable v-help-old-size as decimal       no-undo .
     1431           define variable v-frame-width   as decimal       no-undo .
     1432           define variable jj              as integer       no-undo .
     1433           do
     1434               on error undo, return error
     1435               :
     1436               assign
     1437                   v-frame-width = frame Dialog-Frame:width - 0.3
     1438                   fh            = frame Dialog-Frame:first-child
     1439                   hh            = fh:first-child
     1440                   ii            = 1
     1441                   .
     1442               do while valid-handle(hh):
     1443                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1444                   do:
     1445                       case lc(hh:name) :
     1446                           when "b-help" then
     1447                               do:
     1448                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1449                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1450                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1451                                   hh:TOOLTIP = "Помощь" .
     1452                                   v-help-old-x = hh:column .
     1453                                   v-help-old-y = hh:row    .
     1454                                   v-help-old-size = hh:width .
     1455                                   hh:width-chars = 2.5 .
     1456                               end.
     1457                           when "b-print" then
     1458                               do:
     1459                                   hh:load-image("cmp/b-print.bmp":u) .
     1460                                   hh:TOOLTIP = "Печать" .
     1461                                   v-h[ii] = hh:handle .
     1462                                   ii = ii + 1 .
     1463                                   hh:width-chars = 3 .
     1464                               end.
     1465                           when "b-history" or
     1466                           when "b-hist" then
     1467                               do:
     1468                                   hh:load-image("cmp/b-hist.bmp":u) .
     1469                                   hh:TOOLTIP = "История" .
     1470                                   v-h[ii] = hh:handle .
     1471                                   ii = ii + 1 .
     1472                                   hh:width-chars = 3 .
     1473                               end.
     1474                           when "b-sch" then
     1475                               do:
     1476                                   hh:load-image("cmp/b-sch.bmp":u) .
     1477                                   hh:TOOLTIP = "Установка Фильтра" .
     1478                                   v-h[ii] = hh:handle .
     1479                                   ii = ii + 1 .
     1480                                   hh:width-chars = 3 .
     1481                               end.
     1482                           when "b-hist-user" then
     1483                               do:
     1484                                   hh:load-image("cmp/b-hist.bmp":u) .
     1485                                   hh:TOOLTIP = "История пользователя" .
     1486                                   ii = ii + 1 .
     1487                               end.
     1488                       end case.
     1489                   end.
     1490                   hh = hh:next-sibling.
     1491               end.
     1492               b-help:column = v-frame-width - b-help:width-chars.
     1493               jj = 0.
     1494               repeat ii = 4 to 1 by -1 :
     1495                   if valid-handle (v-h[ii] ) then
     1496                   do:
     1497                       jj  = jj + 1 .
     1498                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1499                       v-h[ii]:row    = v-help-old-y .
     1500                   end.
     1501               end.
     1502           end.
     1503       end.
     1504   end procedure.
     1505   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1506   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1507   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1508   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1509   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1510   define variable v-diasize-current-frame-height as decimal   no-undo .
     1511   define variable v-diasize-change-size          as logical   no-undo .
     1512   define variable v-diasize-resize-button        as handle    no-undo .
     1513   define variable v-diasize-wndmax               as logical   no-undo .
     1514   define variable v-diasize-wndstore             as logical   no-undo .
     1515   define variable v-diasize-proc-name            as character no-undo .
     1516   define variable v-diasize-browse-handle        as handle    no-undo .
     1517   define variable v-diasize-browse-number        as integer   no-undo .
     1518   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1519   define temp-table temp-diasize-handle no-undo
     1520     field handle-value  as handle
     1521     field save-position as decimal
     1522     index xpk is primary unique handle-value
     1523     .
     1524   define temp-table temp-browse-handle no-undo
     1525     field browse-type   as character
     1526     field browse-number as integer
     1527     field browse-handle as handle
     1528     field original-size as decimal
     1529     index xpk is primary unique browse-type browse-number
     1530     index xie browse-type browse-handle
     1531   .
     1532   procedure diasize_change-height :
     1533     define input  parameter p-change-value  as decimal   no-undo .
     1534     define input  parameter p-move-resize   as logical   no-undo .
     1535     define variable v-field-group-handle    as handle    no-undo .
     1536     define variable v-object-handle         as handle    no-undo .
     1537     define variable v-frame-height          as decimal   no-undo .
     1538     define variable v-frame-virtual-height  as decimal   no-undo .
     1539     define variable v-browse-height         as decimal   no-undo .
     1540     define variable v-window-height         as decimal   no-undo .
     1541     define variable v-window-virtual-height as decimal   no-undo .
     1542     define variable v-change-sign           as integer   no-undo .
     1543     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1544     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1545     if p-change-value > 0
     1546     then do:
     1547       if frame Dialog-Frame :height + p-change-value
     1548           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1549       then do:
     1550         assign
     1551           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1552                           - (frame Dialog-Frame :height-chars)
     1553         .
     1554         if p-change-value <= 0
     1555         then do:
     1556           run diasize_position-resize-button in this-procedure .
     1557           return .
     1558         end.
     1559       end.
     1560     end.
     1561     if p-change-value < 0
     1562     then do:
     1563       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1564       then do:
     1565         assign
     1566           p-change-value = v-diasize-orig-frame-height
     1567                          - (frame Dialog-Frame :height-chars)
     1568         .
     1569         if p-change-value >= 0
     1570         then do:
     1571           run diasize_position-resize-button in this-procedure .
     1572           return .
     1573         end.
     1574       end.
     1575     end.
     1576     if p-change-value >= 0
     1577     then do:
     1578       assign
     1579         v-change-sign = 1
     1580       .
     1581     end.
     1582     else do:
     1583       assign
     1584         v-change-sign = -1
     1585       .
     1586     end.
     1587     assign
     1588       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1589     .
     1590     if p-change-value = 0
     1591     then do:
     1592       run diasize_position-resize-button in this-procedure .
     1593       return .
     1594     end.
     1595     move_block:
     1596     do
     1597     on error undo move_block, retry move_block
     1598     :
     1599       if retry
     1600       then do:
     1601         do
     1602         on error undo move_block, leave move_block
     1603         :
     1604           if p-change-value > 0
     1605           then do:
     1606             for each buf_temp-diasize-handle
     1607             on error undo, next
     1608             :
     1609               assign
     1610                 v-object-handle = buf_temp-diasize-handle.handle-value
     1611               .
     1612               if v-object-handle <> v-diasize-resize-button
     1613               then do:
     1614                 assign
     1615                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1616                 .
     1617               end.
     1618             end.
     1619             assign
     1620               v-diasize-browse-handle :height = v-browse-height
     1621             .
     1622             for each buf_temp-browse-handle
     1623               where buf_temp-browse-handle.browse-type = 'height':u
     1624             on error undo, next
     1625             :
     1626               assign
     1627                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1628               .
     1629             end.
     1630             assign
     1631               frame Dialog-Frame :height = v-frame-height
     1632             .
     1633             if frame Dialog-Frame :scrollable = true
     1634             then do:
     1635               assign
     1636                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1637               .
     1638             end.
     1639             run diasize_position-resize-button in this-procedure .
     1640           end.
     1641           else do:
     1642             if frame Dialog-Frame :scrollable = true
     1643             then do:
     1644               assign
     1645                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1646               .
     1647             end.
     1648             assign
     1649               frame Dialog-Frame :height = v-frame-height
     1650             .
     1651             assign
     1652               v-diasize-browse-handle :height = v-browse-height
     1653             .
     1654             for each buf_temp-browse-handle
     1655               where buf_temp-browse-handle.browse-type = 'height':u
     1656             on error undo, next
     1657             :
     1658               assign
     1659                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1660               .
     1661             end.
     1662             for each buf_temp-diasize-handle
     1663             on error undo, next
     1664             :
     1665               assign
     1666                 v-object-handle = buf_temp-diasize-handle.handle-value
     1667               .
     1668               if v-object-handle <> v-diasize-resize-button
     1669               then do:
     1670                 assign
     1671                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1672                 .
     1673               end.
     1674             end.
     1675             run diasize_position-resize-button in this-procedure .
     1676           end.
     1677           assign
     1678             v-diasize-change-size = false
     1679           .
     1680           leave move_block .
     1681         end.
     1682       end.
     1683       assign
     1684         v-diasize-need-full-display = true
     1685       .
     1686       if v-diasize-change-size = false
     1687       then do:
     1688         assign
     1689           v-diasize-change-size = true
     1690         .
     1691       end.
     1692       else do:
     1693         return .
     1694       end.
     1695       assign
     1696         v-frame-height = frame Dialog-Frame :height
     1697         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1698         v-browse-height = v-diasize-browse-handle :height
     1699       .
     1700       for each buf_temp-browse-handle
     1701         where buf_temp-browse-handle.browse-type = 'height':u
     1702       :
     1703         assign
     1704           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1705         .
     1706       end.
     1707       for each buf_temp-diasize-handle
     1708       :
     1709         delete buf_temp-diasize-handle .
     1710       end.
     1711       assign
     1712         v-field-group-handle = frame Dialog-Frame :first-child
     1713       .
     1714       do while valid-handle(v-field-group-handle)
     1715       :
     1716         assign
     1717           v-object-handle = v-field-group-handle :first-child
     1718         .
     1719         do while valid-handle(v-object-handle)
     1720         :
     1721           if  v-object-handle <> v-diasize-browse-handle :handle
     1722           and can-query(v-object-handle, "row")
     1723           and can-query(v-object-handle, "height")
     1724           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1725           then do:
     1726             find first buf_temp-browse-handle
     1727               where buf_temp-browse-handle.browse-type   = 'height':u
     1728                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1729               no-error .
     1730             if available buf_temp-browse-handle
     1731             then do:
     1732             end.
     1733             else do:
     1734               create buf_temp-diasize-handle .
     1735               assign
     1736                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1737                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1738               .
     1739             end.
     1740           end.
     1741           assign
     1742             v-object-handle = v-object-handle :next-sibling
     1743           .
     1744         end.
     1745         assign
     1746           v-field-group-handle = v-field-group-handle :next-sibling
     1747         .
     1748       end.
     1749       do with frame Dialog-Frame
     1750       :
     1751         hide v-diasize-resize-button .
     1752         assign
     1753           v-diasize-resize-button :row    = 1
     1754           v-diasize-resize-button :column = 1
     1755         .
     1756       end.
     1757       if p-change-value > 0
     1758       then do:
     1759         if frame Dialog-Frame :scrollable = true
     1760         then do:
     1761           assign
     1762             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1763             no-error .
     1764           if error-status :error
     1765           or error-status :get-message(1) <> ""
     1766           then do:
     1767             undo move_block, retry move_block .
     1768           end.
     1769         end.
     1770         assign
     1771           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1772           no-error .
     1773         if error-status :error
     1774         or error-status :get-message(1) <> ""
     1775         then do:
     1776           undo move_block, retry move_block .
     1777         end.
     1778         assign
     1779           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1780           no-error .
     1781         if error-status :error
     1782         or error-status :get-message(1) <> ""
     1783         then do:
     1784           undo move_block, retry move_block .
     1785         end.
     1786         for each buf_temp-browse-handle
     1787           where buf_temp-browse-handle.browse-type = 'height':u
     1788         on error undo move_block, retry move_block
     1789         :
     1790           assign
     1791             buf_temp-browse-handle.browse-handle :height
     1792               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1793             no-error .
     1794           if error-status :error
     1795           or error-status :get-message(1) <> ""
     1796           then do:
     1797             undo move_block, retry move_block .
     1798           end.
     1799         end.
     1800         for each buf_temp-diasize-handle
     1801         on error undo move_block, retry move_block
     1802         :
     1803           assign
     1804             v-object-handle = buf_temp-diasize-handle.handle-value
     1805           .
     1806           if v-object-handle <> v-diasize-resize-button
     1807           then do:
     1808             assign
     1809               v-object-handle :row = v-object-handle :row + p-change-value
     1810               no-error .
     1811             if error-status :error
     1812             or error-status :get-message(1) <> ""
     1813             then do:
     1814               undo move_block, retry move_block .
     1815             end.
     1816           end.
     1817         end.
     1818       end.
     1819       else do:
     1820         for each buf_temp-diasize-handle
     1821         on error undo move_block, retry move_block
     1822         :
     1823           assign
     1824             v-object-handle = buf_temp-diasize-handle.handle-value
     1825           .
     1826           if v-object-handle <> v-diasize-resize-button
     1827           then do:
     1828             assign
     1829               v-object-handle :row = v-object-handle :row + p-change-value
     1830               no-error .
     1831             if error-status :error
     1832             or error-status :get-message(1) <> ""
     1833             then do:
     1834               undo move_block, retry move_block .
     1835             end.
     1836           end.
     1837         end.
     1838         assign
     1839           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1840           no-error .
     1841         if error-status :error
     1842         or error-status :get-message(1) <> ""
     1843         then do:
     1844           undo move_block, retry move_block .
     1845         end.
     1846         for each buf_temp-browse-handle
     1847           where buf_temp-browse-handle.browse-type = 'height':u
     1848         on error undo move_block, retry move_block
     1849         :
     1850           assign
     1851             buf_temp-browse-handle.browse-handle :height
     1852               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1853             no-error .
     1854           if error-status :error
     1855           or error-status :get-message(1) <> ""
     1856           then do:
     1857             undo move_block, retry move_block .
     1858           end.
     1859         end.
     1860         assign
     1861           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1862           no-error .
     1863         if error-status :error
     1864         or error-status :get-message(1) <> ""
     1865         then do:
     1866           undo move_block, retry move_block .
     1867         end.
     1868         if frame Dialog-Frame :scrollable = true
     1869         then do:
     1870           assign
     1871             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1872             no-error .
     1873           if error-status :error
     1874           or error-status :get-message(1) <> ""
     1875           then do:
     1876             undo move_block, retry move_block .
     1877           end.
     1878         end.
     1879       end.
     1880       if p-move-resize = true
     1881       then do:
     1882         run diasize_position-resize-button in this-procedure .
     1883       end.
     1884       if v-diasize-wndstore = true
     1885       then do:
     1886         if connected("ub") = true
     1887         then do:
     1888           define variable v-cntxt-db-num        as integer   no-undo .
     1889           define variable v-cntxt-userid        as character no-undo .
     1890           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1891                                             , OUTPUT v-cntxt-userid
     1892                                             ) .
     1893           run gbl/wndsizew.p
     1894             (input  v-cntxt-db-num
     1895             ,input  v-cntxt-userid
     1896             ,input  v-diasize-proc-name
     1897             ,input  'height':u
     1898             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1899             ) .
     1900         end.
     1901       end.
     1902     end.
     1903     assign
     1904       v-diasize-change-size = false
     1905     .
     1906   end procedure.
     1907   procedure diasize_set-height :
     1908     define input  parameter p-new-height  as decimal   no-undo .
     1909     define input  parameter p-move-resize as logical   no-undo .
     1910     do
     1911     on error undo, return error return-value
     1912     :
     1913       run diasize_change-height in this-procedure
     1914         (input  (p-new-height - frame Dialog-Frame :height)
     1915         ,input  p-move-resize
     1916         ) .
     1917     end.
     1918   end procedure.
     1919   procedure diasize_change-width :
     1920     define input  parameter p-change-value as decimal   no-undo .
     1921     define input  parameter p-move-resize  as logical   no-undo .
     1922     define variable v-field-group-handle   as handle    no-undo .
     1923     define variable v-object-handle        as handle    no-undo .
     1924     define variable v-frame-width          as decimal   no-undo .
     1925     define variable v-frame-virtual-width  as decimal   no-undo .
     1926     define variable v-browse-width         as decimal   no-undo .
     1927     define variable v-window-width         as decimal   no-undo .
     1928     define variable v-window-virtual-width as decimal   no-undo .
     1929     define variable v-change-sign          as integer   no-undo .
     1930     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1931     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1932     if p-change-value > 0
     1933     then do:
     1934       if frame Dialog-Frame :width + p-change-value >
     1935           session :width-chars
     1936       then do:
     1937         assign
     1938           p-change-value = session :width-chars - frame Dialog-Frame :width
     1939         .
     1940         if p-change-value <= 0
     1941         then do:
     1942           run diasize_position-resize-button in this-procedure .
     1943           return .
     1944         end.
     1945       end.
     1946     end.
     1947     if p-change-value < 0
     1948     then do:
     1949       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1950       then do:
     1951         assign
     1952           p-change-value = v-diasize-orig-frame-width
     1953                          - frame Dialog-Frame :width
     1954         .
     1955         if p-change-value >= 0
     1956         then do:
     1957           run diasize_position-resize-button in this-procedure .
     1958           return .
     1959         end.
     1960       end.
     1961     end.
     1962     if p-change-value >= 0
     1963     then do:
     1964       assign
     1965         v-change-sign = 1
     1966       .
     1967     end.
     1968     else do:
     1969       assign
     1970         v-change-sign = -1
     1971       .
     1972     end.
     1973     assign
     1974       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1975     .
     1976     if p-change-value = 0
     1977     then do:
     1978       run diasize_position-resize-button in this-procedure .
     1979       return .
     1980     end.
     1981     move_block:
     1982     do
     1983     on error undo move_block, leave move_block
     1984     :
     1985       if retry
     1986       then do:
     1987         do
     1988         on error undo move_block, leave move_block
     1989         :
     1990           if p-change-value > 0
     1991           then do:
     1992             for each buf_temp-diasize-handle
     1993             on error undo, next
     1994             :
     1995               assign
     1996                 v-object-handle = buf_temp-diasize-handle.handle-value
     1997               .
     1998               if v-object-handle <> v-diasize-resize-button
     1999               then do:
     2000                 assign
     2001                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2002                 .
     2003               end.
     2004             end.
     2005             assign
     2006               v-diasize-browse-handle :width = v-browse-width
     2007             .
     2008             for each buf_temp-browse-handle
     2009               where buf_temp-browse-handle.browse-type = 'width':u
     2010             on error undo, next
     2011             :
     2012               assign
     2013                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2014               .
     2015             end.
     2016             assign
     2017               frame Dialog-Frame :width = v-frame-width
     2018             .
     2019             if frame Dialog-Frame :scrollable = true
     2020             then do:
     2021               assign
     2022                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2023               .
     2024             end.
     2025             run diasize_position-resize-button in this-procedure .
     2026           end.
     2027           else do:
     2028             if frame Dialog-Frame :scrollable = true
     2029             then do:
     2030               assign
     2031                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2032               .
     2033             end.
     2034             assign
     2035               frame Dialog-Frame :width = v-frame-width
     2036             .
     2037             for each buf_temp-browse-handle
     2038               where buf_temp-browse-handle.browse-type = 'width':u
     2039             on error undo, next
     2040             :
     2041               assign
     2042                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2043               .
     2044             end.
     2045             assign
     2046               v-diasize-browse-handle :width = v-browse-width
     2047             .
     2048             for each buf_temp-diasize-handle
     2049             on error undo, next
     2050             :
     2051               assign
     2052                 v-object-handle = buf_temp-diasize-handle.handle-value
     2053               .
     2054               if v-object-handle <> v-diasize-resize-button
     2055               then do:
     2056                 assign
     2057                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2058                 .
     2059               end.
     2060             end.
     2061             run diasize_position-resize-button in this-procedure .
     2062           end.
     2063           assign
     2064             v-diasize-change-size = false
     2065           .
     2066           leave move_block .
     2067         end.
     2068       end.
     2069       assign
     2070         v-diasize-need-full-display = true
     2071       .
     2072       if v-diasize-change-size = false
     2073       then do:
     2074         assign
     2075           v-diasize-change-size = true
     2076         .
     2077       end.
     2078       else do:
     2079         return .
     2080       end.
     2081       assign
     2082         v-frame-width = frame Dialog-Frame :width
     2083         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2084         v-browse-width = v-diasize-browse-handle :width
     2085       .
     2086       for each buf_temp-browse-handle
     2087         where buf_temp-browse-handle.browse-type = 'width':u
     2088       :
     2089         assign
     2090           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2091         .
     2092       end.
     2093       for each buf_temp-diasize-handle
     2094       :
     2095         delete buf_temp-diasize-handle .
     2096       end.
     2097       assign
     2098         v-field-group-handle = frame Dialog-Frame :first-child
     2099       .
     2100       do while valid-handle(v-field-group-handle)
     2101       :
     2102         assign
     2103           v-object-handle = v-field-group-handle :first-child
     2104         .
     2105         do while valid-handle(v-object-handle)
     2106         :
     2107           if  v-object-handle <> v-diasize-browse-handle :handle
     2108           and v-object-handle <> v-diasize-resize-button
     2109           and can-query(v-object-handle, "row")
     2110           and can-query(v-object-handle, "height")
     2111           and ( v-object-handle :col + v-object-handle :width
     2112                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2113               )
     2114           then do:
     2115             find first buf_temp-browse-handle
     2116               where buf_temp-browse-handle.browse-type   = 'width':u
     2117                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2118               no-error .
     2119             if available buf_temp-browse-handle
     2120             then do:
     2121             end.
     2122             else do:
     2123               create buf_temp-diasize-handle .
     2124               assign
     2125                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2126                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2127               .
     2128             end.
     2129           end.
     2130           assign
     2131             v-object-handle = v-object-handle :next-sibling
     2132           .
     2133         end.
     2134         assign
     2135           v-field-group-handle = v-field-group-handle :next-sibling
     2136         .
     2137       end.
     2138       do with frame Dialog-Frame
     2139       :
     2140         hide v-diasize-resize-button .
     2141         v-diasize-resize-button :row = 1.
     2142         v-diasize-resize-button :column = 1.
     2143       end.
     2144       if p-change-value > 0
     2145       then do:
     2146         if frame Dialog-Frame :scrollable = true
     2147         then do:
     2148           assign
     2149             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2150             no-error .
     2151           if error-status :error
     2152           or error-status :get-message(1) <> ""
     2153           then do:
     2154             undo move_block, retry move_block.
     2155           end.
     2156         end.
     2157         assign
     2158           frame Dialog-Frame :width = v-frame-width + p-change-value
     2159           no-error .
     2160         if error-status :error
     2161         or error-status :get-message(1) <> ""
     2162         then do:
     2163           undo move_block, retry move_block.
     2164         end.
     2165         assign
     2166           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2167         no-error .
     2168         if error-status :error
     2169         or error-status :get-message(1) <> ""
     2170         then do:
     2171           undo move_block, retry move_block.
     2172         end.
     2173         for each buf_temp-browse-handle
     2174           where buf_temp-browse-handle.browse-type = 'width':u
     2175         on error undo move_block, retry move_block
     2176         :
     2177           assign
     2178             buf_temp-browse-handle.browse-handle :width
     2179               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2180             no-error .
     2181           if error-status :error
     2182           or error-status :get-message(1) <> ""
     2183           then do:
     2184             undo move_block, retry move_block .
     2185           end.
     2186         end.
     2187         for each buf_temp-diasize-handle
     2188         on error undo move_block, retry move_block
     2189         :
     2190           assign
     2191             v-object-handle = buf_temp-diasize-handle.handle-value
     2192           .
     2193           if v-object-handle <> v-diasize-resize-button
     2194           then do:
     2195             assign
     2196               v-object-handle :col = v-object-handle :col + p-change-value
     2197               no-error .
     2198             if error-status :error
     2199             or error-status :get-message(1) <> ""
     2200             then do:
     2201               undo move_block, retry move_block .
     2202             end.
     2203           end.
     2204         end.
     2205       end.
     2206       else do:
     2207         for each buf_temp-diasize-handle
     2208         on error undo move_block, retry move_block
     2209         :
     2210           assign
     2211             v-object-handle = buf_temp-diasize-handle.handle-value
     2212           .
     2213           if v-object-handle <> v-diasize-resize-button
     2214           then do:
     2215             assign
     2216               v-object-handle :col = v-object-handle :col + p-change-value
     2217               no-error .
     2218             if error-status :error
     2219             or error-status :get-message(1) <> ""
     2220             then do:
     2221               undo move_block, retry move_block .
     2222             end.
     2223           end.
     2224         end.
     2225         for each buf_temp-browse-handle
     2226           where buf_temp-browse-handle.browse-type = 'width':u
     2227         on error undo move_block, retry move_block
     2228         :
     2229           assign
     2230             buf_temp-browse-handle.browse-handle :width
     2231               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2232             no-error .
     2233           if error-status :error
     2234           or error-status :get-message(1) <> ""
     2235           then do:
     2236             undo move_block, retry move_block .
     2237           end.
     2238         end.
     2239         assign
     2240           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2241           no-error .
     2242         if error-status :error
     2243         or error-status :get-message(1) <> ""
     2244         then do:
     2245           undo move_block, retry move_block.
     2246         end.
     2247         assign
     2248           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2249         no-error .
     2250         if error-status :error
     2251         or error-status :get-message(1) <> ""
     2252         then do:
     2253           undo move_block, retry move_block.
     2254         end.
     2255         if frame Dialog-Frame :scrollable = true
     2256         then do:
     2257           assign
     2258             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2259           no-error .
     2260           if error-status :error
     2261           or error-status :get-message(1) <> ""
     2262           then do:
     2263             undo move_block, retry move_block.
     2264           end.
     2265         end.
     2266       end.
     2267       if p-move-resize
     2268       then do:
     2269         run diasize_position-resize-button in this-procedure .
     2270       end.
     2271       if v-diasize-wndstore = true
     2272       then do:
     2273         if connected("ub") = true
     2274         then do:
     2275           define variable v-cntxt-db-num        as integer   no-undo .
     2276           define variable v-cntxt-userid        as character no-undo .
     2277           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2278                                             , OUTPUT v-cntxt-userid
     2279                                             ) .
     2280           run gbl/wndsizew.p
     2281             (input  v-cntxt-db-num
     2282             ,input  v-cntxt-userid
     2283             ,input  v-diasize-proc-name
     2284             ,input  'width':u
     2285             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2286             ) .
     2287         end.
     2288       end.
     2289     end.
     2290     assign
     2291       v-diasize-change-size = false
     2292     .
     2293   end procedure.
     2294   procedure diasize_set-width :
     2295     define input  parameter p-new-width  as decimal   no-undo .
     2296     define input  parameter p-move-resize as logical   no-undo .
     2297     do
     2298     on error undo, return error return-value
     2299     :
     2300       run diasize_change-width in this-procedure
     2301         (input  (p-new-width - frame Dialog-Frame :width)
     2302         ,input  p-move-resize
     2303         ) .
     2304     end.
     2305   end procedure.
     2306   procedure diasize_position-resize-button :
     2307     do with frame Dialog-Frame
     2308     :
     2309       hide v-diasize-resize-button .
     2310       assign
     2311         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2312                     - 1
     2313                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2314         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2315                     - 1
     2316                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2317       .
     2318       view v-diasize-resize-button .
     2319     end.
     2320   end procedure.
     2321   on alt-right anywhere
     2322   do:
     2323     run diasize_change-width in this-procedure
     2324       (input 1
     2325       ,input true
     2326       ) .
     2327     return no-apply .
     2328   end.
     2329   on alt-left anywhere
     2330   do:
     2331     run diasize_change-width in this-procedure
     2332       (input -1
     2333       ,input true
     2334       ) .
     2335     return no-apply .
     2336   end.
     2337   on alt-down anywhere
     2338   do:
     2339     run diasize_change-height in this-procedure
     2340       (input 1
     2341       ,input true
     2342       ) .
     2343     return no-apply .
     2344   end.
     2345   on alt-up anywhere
     2346   do:
     2347     run diasize_change-height in this-procedure
     2348       (input -1
     2349       ,input true
     2350       ) .
     2351     return no-apply .
     2352   end.
     2353   on alt-enter of frame Dialog-Frame
     2354   do:
     2355     run diasize_maximize in this-procedure
     2356       (input  ?
     2357       ).
     2358     return no-apply .
     2359   end.
     2360   procedure diasize_end-move :
     2361     do
     2362     on error undo, return error return-value
     2363     :
     2364       define variable v-row-delta as decimal   no-undo .
     2365       define variable v-col-delta as decimal   no-undo .
     2366       define variable v-new-row as decimal   no-undo .
     2367       define variable v-new-col as decimal   no-undo .
     2368       assign
     2369         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2370         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2371       .
     2372       assign
     2373         v-row-delta = v-new-row - frame Dialog-Frame :height
     2374         v-col-delta = v-new-col - frame Dialog-Frame :width
     2375       .
     2376       run diasize_change-height in this-procedure
     2377         (input v-row-delta
     2378         ,input true
     2379         ) .
     2380       run diasize_change-width in this-procedure
     2381         (input v-col-delta
     2382         ,input true
     2383         ) .
     2384     end.
     2385   end procedure.
     2386   procedure diasize_maximize :
     2387     define input  parameter p-action as logical   no-undo .
     2388     do
     2389     on error undo, return error return-value
     2390     :
     2391       if p-action = ?
     2392       then do:
     2393         if v-diasize-need-maximize = true
     2394         then do:
     2395           assign
     2396             p-action = true
     2397           .
     2398         end.
     2399         else do:
     2400           assign
     2401             p-action = false
     2402           .
     2403         end.
     2404       end.
     2405       if p-action = true
     2406       then do:
     2407         run diasize_change-height in this-procedure
     2408           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2409               - frame Dialog-Frame :height-chars
     2410           ,input true
     2411           ) .
     2412         run diasize_change-width in this-procedure
     2413           (input session :width-chars
     2414               - frame Dialog-Frame :width-chars
     2415           ,input true
     2416           ) .
     2417         assign
     2418           v-diasize-need-maximize = false
     2419         .
     2420       end.
     2421       else do:
     2422         run diasize_change-width in this-procedure
     2423           (input v-diasize-orig-frame-width
     2424               - frame Dialog-Frame :width-chars
     2425           ,input true
     2426           ) .
     2427         run diasize_change-height in this-procedure
     2428           (input v-diasize-orig-frame-height
     2429               - frame Dialog-Frame :height-chars
     2430           ,input true
     2431           ) .
     2432         assign
     2433           v-diasize-need-maximize = true
     2434         .
     2435       end.
     2436     end.
     2437   end procedure.
     2438   procedure diasize_restore-orig-size :
     2439     do
     2440     on error undo, return error return-value
     2441     :
     2442       assign
     2443         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2444         v-diasize-current-frame-height = frame Dialog-Frame :height
     2445       .
     2446       run diasize_set-height in this-procedure
     2447         (input  v-diasize-orig-frame-height
     2448         ,input  true
     2449         ) .
     2450       run diasize_set-width in this-procedure
     2451         (input  v-diasize-orig-frame-width
     2452         ,input  true
     2453         ) .
     2454     end.
     2455   end procedure.
     2456   procedure diasize_restore-current-size :
     2457     do
     2458     on error undo, return error return-value
     2459     :
     2460       run diasize_set-height in this-procedure
     2461         (input  v-diasize-current-frame-height
     2462         ,input  true
     2463         ) .
     2464       run diasize_set-width in this-procedure
     2465         (input  v-diasize-current-frame-width
     2466         ,input  true
     2467         ) .
     2468     end.
     2469   end procedure.
     2470   procedure diasize_set-browse-handle :
     2471     define input  parameter p-browse-handle as handle   no-undo .
     2472     define buffer buf_temp-browse-handle for temp-browse-handle .
     2473     do
     2474     on error undo, return error return-value
     2475     :
     2476       assign
     2477         v-diasize-browse-handle = p-browse-handle
     2478       .
     2479       for each buf_temp-browse-handle
     2480       on error undo, return error return-value
     2481       :
     2482         delete buf_temp-browse-handle .
     2483       end.
     2484     end.
     2485   end procedure.
     2486   procedure diasize_add_browse :
     2487     define input  parameter p-browse-type   as character no-undo .
     2488     define input  parameter p-browse-handle as handle    no-undo .
     2489     define buffer buf_temp-browse-handle for temp-browse-handle .
     2490     do
     2491     on error undo, return error return-value
     2492     :
     2493       assign
     2494         v-diasize-browse-number = v-diasize-browse-number + 1
     2495       .
     2496       create buf_temp-browse-handle .
     2497       assign
     2498         buf_temp-browse-handle.browse-type   = p-browse-type
     2499         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2500         buf_temp-browse-handle.browse-handle = p-browse-handle
     2501       .
     2502     end.
     2503   end procedure.
     2504   procedure diasize_init :
     2505     define variable v-default-value    as logical   no-undo .
     2506     define variable v-restore-saved    as logical   no-undo .
     2507     define variable v-resize-value-str as character no-undo .
     2508     do
     2509     on error undo, return error return-value
     2510     :
     2511       do with frame Dialog-Frame
     2512       :
     2513         assign
     2514           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2515           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2516           v-diasize-browse-handle     = browse BR-rcp :handle
     2517         .
     2518         create button v-diasize-resize-button
     2519         assign
     2520           parent        = frame Dialog-Frame :first-child
     2521           label         = "s"
     2522           height-pixels = 16
     2523           width-pixels  = 16
     2524           visible       = true
     2525           sensitive     = true
     2526           movable       = true
     2527           triggers:
     2528             on end-move persistent run diasize_end-move in this-procedure .
     2529           end triggers.
     2530         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2531         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2532         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2533         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2534         assign
     2535           v-diasize-wndmax = false
     2536         .
     2537         if connected("ub") = true
     2538         then do:
     2539           define variable v-cntxt-db-num        as integer   no-undo .
     2540           define variable v-cntxt-userid        as character no-undo .
     2541           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2542                                             , OUTPUT v-cntxt-userid
     2543                                             ) .
     2544           run gbl/wndpar_r.p
     2545             (input  v-cntxt-db-num
     2546             ,input  v-cntxt-userid
     2547             ,input  'wndmax':U
     2548             ,output v-diasize-wndmax
     2549             ,output v-default-value
     2550             ) .
     2551         end.
     2552         assign
     2553           v-diasize-wndstore = false
     2554         .
     2555         if connected("ub") = true
     2556         then do:
     2557           run gbl/wndpar_r.p
     2558             (input  v-cntxt-db-num
     2559             ,input  v-cntxt-userid
     2560             ,input  'wndstore':U
     2561             ,output v-diasize-wndstore
     2562             ,output v-default-value
     2563             ) .
     2564         end.
     2565         assign
     2566           v-diasize-proc-name = entry(1, program-name(2), '.')
     2567         .
     2568         if v-diasize-wndstore = true
     2569         then do:
     2570           assign
     2571             v-restore-saved = false
     2572           .
     2573           if connected("ub") = true
     2574           then do:
     2575             run gbl/wndsizer.p
     2576               (input  v-cntxt-db-num
     2577               ,input  v-cntxt-userid
     2578               ,input  v-diasize-proc-name
     2579               ,input  'height':u
     2580               ,output v-resize-value-str
     2581               ) .
     2582             if v-resize-value-str <> '':U
     2583             then do:
     2584               run diasize_change-height in this-procedure
     2585                 (input  integer(v-resize-value-str)
     2586                 ,input  true
     2587                 ) .
     2588               assign
     2589                 v-restore-saved = true
     2590               .
     2591             end.
     2592           end.
     2593           if connected("ub") = true
     2594           then do:
     2595             run gbl/wndsizer.p
     2596               (input  v-cntxt-db-num
     2597               ,input  v-cntxt-userid
     2598               ,input  v-diasize-proc-name
     2599               ,input  'width':u
     2600               ,output v-resize-value-str
     2601               ) .
     2602             if v-resize-value-str <> '':U
     2603             then do:
     2604               run diasize_change-width in this-procedure
     2605                 (input  integer(v-resize-value-str)
     2606                 ,input  true
     2607                 ) .
     2608               assign
     2609                 v-restore-saved = true
     2610               .
     2611             end.
     2612           end.
     2613           if v-restore-saved <> true
     2614           then do:
     2615             if v-diasize-wndmax = true
     2616             then do:
     2617               run diasize_maximize in this-procedure
     2618                 (input  true
     2619                 ) .
     2620             end.
     2621           end.
     2622         end.
     2623         else do:
     2624           if v-diasize-wndmax = true
     2625           then do:
     2626             run diasize_maximize in this-procedure
     2627               (input  true
     2628               ) .
     2629           end.
     2630         end.
     2631       end.
     2632     end.
     2633   end procedure.
     2634   procedure diasize_need-full-display :
     2635     define output parameter p-need-full-display as logical   no-undo .
     2636     do
     2637     on error undo, return error return-value
     2638     :
     2639       assign
     2640         p-need-full-display = v-diasize-need-full-display
     2641       .
     2642       assign
     2643         v-diasize-need-full-display = false
     2644       .
     2645     end.
     2646   end procedure.
     2647   procedure get-context :
     2648      define output parameter p-db-num as integer          no-undo.
     2649      define output parameter p-user-id as character        no-undo.
     2650      define variable v-login               as character    no-undo.
     2651      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2652      define buffer buf_user-login  for ub.user-login .
     2653      do
     2654      on error undo, return error
     2655      :
     2656            FIND FIRST buf_sys-ctrl no-lock.
     2657            ASSIGN
     2658               v-login = USERID("ub")
     2659               p-db-num = buf_sys-ctrl.db-num
     2660            .
     2661            FIND FIRST buf_user-login
     2662                 WHERE buf_user-login.db-num = p-db-num
     2663                   AND buf_user-login.user-login = v-login
     2664                 no-lock
     2665                 no-error
     2666                 .
     2667            IF AVAILABLE buf_user-login
     2668            THEN DO:
     2669               assign
     2670                  p-user-id = buf_user-login.user-id
     2671               .
     2672            END.
     2673      end.
     2674   end procedure.
     2675       run diasize_init in this-procedure .
     2676   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2677   procedure rcps_get-profile-id :
     2678   define output parameter p-local-profile-id as integer no-undo .
     2679   do
     2680   on error undo, return error:
     2681   p-local-profile-id = p-profile-id.
     2682   end.
     2683   end procedure.
     2684   PROCEDURE rcps_fill-table :
     2685   define input parameter p-clear-params as logical no-undo .
     2686   if p-clear-params then do:
     2687   FOR EACH tt-rule-call-param:
     2688       DELETE tt-rule-call-param.
     2689   END.
     2690   end.
     2691    FOR EACH tt0-rule-call-param:
     2692      IF p-mode <> 'ДОБАВЛЕНИЕ':U THEN DO:
     2693        IF p-call-id <> '':U and p-call-id <> tt0-rule-call-param.call_id THEN do:
     2694           NEXT.
     2695        end.
     2696        IF p-codex-id <> 0 and p-codex-id <> tt0-rule-call-param.codex_id THEN do:
     2697          NEXT.
     2698        end.
     2699        IF p-ruleset-id <> 0 and p-ruleset-id <> tt0-rule-call-param.ruleset_id THEN do:
     2700          NEXT.
     2701        end.
     2702        IF p-rule-id <> 0 and p-rule-id <> tt0-rule-call-param.RULE_id THEN do:
     2703          NEXT.
     2704        end.
     2705        IF p-order-id <> ? and p-order-id <> tt0-rule-call-param.order_id THEN do:
     2706          NEXT.
     2707        end.
     2708      END.
     2709      if lookup("hidden", tt0-rule-call-param.param-3-data-type) > 0 then do:
     2710        next.
     2711      end.
     2712      IF p-list-mode = 'rp-rule-param':U
     2713      or p-list-mode = 'rp-rule-param':U  + chr(44) + 'все':U
     2714      THEN DO:
     2715         IF p-profile-id <> 0 AND p-profile-id <> tt0-rule-call-param.profile_id THEN do:
     2716           NEXT.
     2717         end.
     2718         IF p-once-more <> ? AND p-once-more <> tt0-rule-call-param.once-more THEN do:
     2719           NEXT.
     2720         end.
     2721      END.
     2722      CREATE tt-rule-call-param.
     2723      BUFFER-COPY tt0-rule-call-param TO tt-rule-call-param.
     2724   END.
     2725   END PROCEDURE.
     2726   procedure rcps_get-value :
     2727   DEFINE INPUT PARAMETER p-profile-id AS integer NO-UNDO.
     2728   DEFINE INPUT PARAMETER p-once-more AS integer NO-UNDO.
     2729   DEFINE INPUT PARAMETER p-call-id AS CHARACTER NO-UNDO.
     2730   DEFINE INPUT PARAMETER p-rp-param-name AS CHARACTER NO-UNDO.
     2731   DEFINE INPUT-output PARAMETER pp-index AS integer NO-UNDO.
     2732   DEFINE output parameter p-value-character AS CHARACTER NO-UNDO.
     2733   DEFINE output parameter p-value-date AS date NO-UNDO.
     2734   DEFINE output parameter p-value-decimal AS decimal NO-UNDO.
     2735   DEFINE output parameter p-value-integer AS integer NO-UNDO.
     2736   DEFINE output parameter p-value-logical AS logical NO-UNDO.
     2737   define variable v-current-index as integer no-undo init -1.
     2738   define variable v-start as logical no-undo init yes.
     2739   DEFINE BUFFER buf_ruledict-param FOR ub.ruledict-param.
     2740   DEFINE BUFFER buf_rp-rule-param FOR ub.rp-rule-param.
     2741   DEFINE BUFFER buf_tt-rule-call-param FOR tt-rule-call-param.
     2742   DEFINE BUFFER buf_term_tt-rule-call-param FOR tt-rule-call-param.
     2743   do
     2744   on error undo, return error
     2745   :
     2746   FOR FIRST buf_rp-rule-param WHERE
     2747         buf_rp-rule-param.profile_id = p-profile-id
     2748     AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     2749   , each buf_tt-rule-call-param WHERE
     2750      buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     2751   AND buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     2752   AND buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     2753   AND buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     2754   AND buf_tt-rule-call-param.p-index >= pp-index
     2755    ,each buf_term_tt-rule-call-param where
     2756          buf_term_tt-rule-call-param.call_id = buf_tt-rule-call-param.call_id
     2757      and buf_term_tt-rule-call-param.codex_id = buf_tt-rule-call-param.codex_id
     2758      and buf_term_tt-rule-call-param.ruleset_id = buf_tt-rule-call-param.ruleset_id
     2759      and buf_term_tt-rule-call-param.order_id = buf_tt-rule-call-param.order_id
     2760      and buf_term_tt-rule-call-param.param-name = buf_tt-rule-call-param.param-name
     2761      and buf_term_tt-rule-call-param.p-index = buf_tt-rule-call-param.p-index
     2762     by buf_term_tt-rule-call-param.call_id
     2763     by buf_term_tt-rule-call-param.codex_id
     2764     by buf_term_tt-rule-call-param.ruleset_id
     2765     by buf_term_tt-rule-call-param.order_id
     2766     by buf_term_tt-rule-call-param.param-name
     2767     by buf_term_tt-rule-call-param.p-index :
     2768       if v-start
     2769       then do:
     2770         assign
     2771         pp-index = buf_term_tt-rule-call-param.p-index
     2772         p-value-character = buf_term_tt-rule-call-param.param-value-character
     2773         p-value-date      = buf_term_tt-rule-call-param.param-value-date
     2774         p-value-decimal   = buf_term_tt-rule-call-param.param-value-decimal
     2775         p-value-integer   = buf_term_tt-rule-call-param.param-value-integer
     2776         p-value-logical   = buf_term_tt-rule-call-param.param-value-logical
     2777         v-start = no
     2778         .
     2779       end.
     2780       else do:
     2781         if buf_term_tt-rule-call-param.p-index > pp-index then do:
     2782           v-current-index = buf_term_tt-rule-call-param.p-index.
     2783           leave.
     2784         end.
     2785             end.
     2786     end.
     2787     pp-index = v-current-index.
     2788   end.
     2789   end procedure.
     2790   PROCEDURE rcps_proc-b-add :
     2791   DEFINE INPUT PARAMETER p-profile-id AS integer NO-UNDO.
     2792   DEFINE INPUT PARAMETER p-once-more AS integer NO-UNDO.
     2793   DEFINE INPUT PARAMETER p-call-id AS CHARACTER NO-UNDO.
     2794   DEFINE INPUT PARAMETER p-rp-param-name AS CHARACTER NO-UNDO.
     2795   DEFINE INPUT PARAMETER p-index AS integer NO-UNDO.
     2796   define variable v-ind as integer no-undo .
     2797   define buffer buf_tt-rule-call-param for tt-rule-call-param.
     2798   define buffer buf0_tt-rule-call-param for tt-rule-call-param.
     2799   define buffer buf2_tt-rule-call-param for tt-rule-call-param.
     2800   define buffer buf_rp-rule-param for ub.rp-rule-param.
     2801   FOR FIRST buf_rp-rule-param WHERE
     2802             buf_rp-rule-param.profile_id = p-profile-id
     2803         AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     2804       , first buf0_tt-rule-call-param WHERE
     2805          buf0_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     2806      AND buf0_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     2807      AND buf0_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     2808      AND buf0_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name:
     2809     LEAVE.
     2810   END.
     2811   IF NOT AVAILABLE buf0_tt-rule-call-param THEN do:
     2812     BELL.
     2813     RETURN.
     2814   END.
     2815   for each buf_rp-rule-param where
     2816           buf_rp-rule-param.rp-param-name = p-rp-param-name
     2817       and buf_rp-rule-param.profile_id = p-profile-id,
     2818       first buf_tt-rule-call-param where
     2819           buf_tt-rule-call-param.call_id = buf0_tt-rule-call-param.call_id
     2820       and buf_tt-rule-call-param.profile_id = buf_rp-rule-param.profile_id
     2821       and buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     2822       and buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     2823       and buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     2824       and buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     2825       and buf_tt-rule-call-param.once-more = buf0_tt-rule-call-param.once-more
     2826       and buf_tt-rule-call-param.p-index = p-index:
     2827     RETURN.
     2828   END.
     2829   IF lookup("LIST", buf0_tt-rule-call-param.param-3-data-type) = 0
     2830   and lookup("SORTED-LIST", buf0_tt-rule-call-param.param-3-data-type) = 0
     2831   THEN DO:
     2832     BELL.
     2833     RETURN.
     2834   END.
     2835   IF buf0_tt-rule-call-param.p-index <> 0 THEN DO:
     2836     BELL.
     2837     RETURN.
     2838   END.
     2839   find last buf_tt-rule-call-param where
     2840            buf_tt-rule-call-param.call_id = buf0_tt-rule-call-param.call_id
     2841        and buf_tt-rule-call-param.codex_id = buf0_tt-rule-call-param.codex_id
     2842        and buf_tt-rule-call-param.ruleset_id = buf0_tt-rule-call-param.ruleset_id
     2843        and buf_tt-rule-call-param.order_id = buf0_tt-rule-call-param.order_id
     2844        and buf_tt-rule-call-param.param-name = buf0_tt-rule-call-param.param-name no-error .
     2845   if available buf_tt-rule-call-param
     2846   and (lookup("LIST", buf_tt-rule-call-param.param-3-data-type) > 0
     2847        or
     2848        lookup("SORTED-LIST", buf_tt-rule-call-param.param-3-data-type) > 0
     2849        )
     2850   and buf_tt-rule-call-param.p-index > 0 then do:
     2851     v-ind = buf_tt-rule-call-param.p-index.
     2852   end.
     2853   for each buf_rp-rule-param where
     2854           buf_rp-rule-param.rp-param-name = p-rp-param-name
     2855       and buf_rp-rule-param.profile_id = p-profile-id,
     2856       first buf_tt-rule-call-param where
     2857           buf_tt-rule-call-param.call_id = buf0_tt-rule-call-param.call_id
     2858       and buf_tt-rule-call-param.profile_id = buf_rp-rule-param.profile_id
     2859       and buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     2860       and buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     2861       and buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     2862       and buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     2863       and buf_tt-rule-call-param.once-more = buf0_tt-rule-call-param.once-more
     2864       and buf_tt-rule-call-param.p-index = 0
     2865   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2866   on stop   undo, return error substitute( "&1. stop", vss-workfile )
     2867   on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     2868   :
     2869     create buf2_tt-rule-call-param.
     2870     buffer-copy buf_tt-rule-call-param
     2871     except p-index
     2872     to buf2_tt-rule-call-param
     2873     assign
     2874     buf2_tt-rule-call-param.p-index = v-ind + 1
     2875     .
     2876   end.
     2877   END PROCEDURE.
     2878   PROCEDURE rcps_proc-b-del :
     2879   DEFINE INPUT PARAMETER p-profile-id AS integer NO-UNDO.
     2880   DEFINE INPUT PARAMETER p-once-more AS integer NO-UNDO.
     2881   DEFINE INPUT PARAMETER p-call-id AS CHARACTER NO-UNDO.
     2882   DEFINE INPUT PARAMETER p-rp-param-name AS CHARACTER NO-UNDO.
     2883   DEFINE INPUT PARAMETER pp-index AS integer NO-UNDO.
     2884   define variable v-ind as integer no-undo .
     2885   define variable v-once-more as integer no-undo .
     2886   define variable v-call-id as character no-undo .
     2887   define buffer buf0_tt-rule-call-param for tt-rule-call-param.
     2888   define buffer buf_tt-rule-call-param for tt-rule-call-param.
     2889   define buffer buf_rp-rule-param for ub.rp-rule-param.
     2890   if pp-index = 0 then do:
     2891     undo, return error substitute("Нельзя удалять корневой параметр &1 (индекс = 0)", p-rp-param-name).
     2892   end.
     2893   FOR first buf_rp-rule-param WHERE
     2894             buf_rp-rule-param.profile_id = p-profile-id
     2895         AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     2896       , first buf0_tt-rule-call-param WHERE
     2897          buf0_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     2898      AND buf0_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     2899      AND buf0_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     2900      AND buf0_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     2901      AND buf0_tt-rule-call-param.p-index = pp-index
     2902      :
     2903     LEAVE.
     2904   END.
     2905   IF NOT AVAILABLE buf0_tt-rule-call-param THEN do:
     2906     FOR first buf_rp-rule-param WHERE
     2907               buf_rp-rule-param.profile_id = p-profile-id
     2908           AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     2909         , last buf0_tt-rule-call-param WHERE
     2910           buf0_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     2911       AND buf0_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     2912       AND buf0_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     2913       AND buf0_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     2914       AND buf0_tt-rule-call-param.p-index > pp-index :
     2915       leave.
     2916     end.
     2917     IF NOT AVAILABLE buf0_tt-rule-call-param THEN do:
     2918     return "not-found".
     2919     end.
     2920     else do:
     2921       return ''.
     2922     end.
     2923   END.
     2924   IF lookup("LIST", buf0_tt-rule-call-param.param-3-data-type) = 0
     2925   and lookup("SORTED-LIST", buf0_tt-rule-call-param.param-3-data-type) = 0
     2926   THEN DO:
     2927     undo, return error substitute("Можно удалять только параметры типа LIST и SORTED-LIST").
     2928   END.
     2929   IF lookup("READ-ONLY", buf0_tt-rule-call-param.param-3-data-type) > 0 THEN DO:
     2930     undo, return error substitute("Нельзя удалять  параметры типа READ-ONLY").
     2931   END.
     2932   for each buf_rp-rule-param where
     2933           buf_rp-rule-param.rp-param-name = buf_rp-rule-param.rp-param-name
     2934       and buf_rp-rule-param.profile_id = buf_rp-rule-param.profile_id,
     2935       each buf_tt-rule-call-param where
     2936           buf_tt-rule-call-param.call_id = p-call-id
     2937       and buf_tt-rule-call-param.profile_id = buf_rp-rule-param.profile_id
     2938       and buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     2939       and buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     2940       and buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     2941       and buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     2942       and buf_tt-rule-call-param.once-more = p-once-more
     2943       and buf_tt-rule-call-param.p-index = pp-index
     2944   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2945   on stop   undo, return error substitute( "&1. stop", vss-workfile )
     2946   on endkey undo, return error substitute( "&1. endkey", vss-workfile ):
     2947       DELETE buf_tt-rule-call-param.
     2948   end.
     2949   return ''.
     2950   END PROCEDURE.
     2951   PROCEDURE rcps_proc-save0 :
     2952   FOR EACH tt-rule-call-param
     2953   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2954   on stop   undo , return error substitute( "&1. stop", vss-workfile )
     2955   on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     2956   :
     2957      find  FIRST tt0-rule-call-param NO-LOCK WHERE
     2958               tt0-rule-call-param.codex_id = tt-rule-call-param.codex_id
     2959          AND  tt0-rule-call-param.ruleset_id = tt-rule-call-param.ruleset_id
     2960          AND tt0-rule-call-param.call_id = tt-rule-call-param.call_id
     2961          AND tt0-rule-call-param.order_id = tt-rule-call-param.order_id
     2962          AND tt0-rule-call-param.param-name = tt-rule-call-param.param-name
     2963          AND tt0-rule-call-param.p-index = tt-rule-call-param.p-index no-error .
     2964      if not available tt0-rule-call-param
     2965      and (lookup("LIST", tt-rule-call-param.param-3-data-type) > 0
     2966           OR
     2967           lookup("SORTED-LIST", tt-rule-call-param.param-3-data-type) > 0
     2968           )
     2969      and tt-rule-call-param.p-index > 0 then do:
     2970        create tt0-rule-call-param.
     2971      end.
     2972      BUFFER-COPY tt-rule-call-param TO tt0-rule-call-param.
     2973   END.
     2974   FOR EACH tt0-rule-call-param
     2975   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2976   on stop   undo , return error substitute( "&1. stop", vss-workfile )
     2977   on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     2978   :
     2979     if tt0-rule-call-param.p-index = 0 then next.
     2980     if lookup("hidden", tt0-rule-call-param.param-3-data-type) > 0 then next.
     2981     find  FIRST tt-rule-call-param NO-LOCK WHERE
     2982             tt-rule-call-param.codex_id = tt0-rule-call-param.codex_id
     2983         AND tt-rule-call-param.ruleset_id = tt0-rule-call-param.ruleset_id
     2984         AND tt-rule-call-param.call_id = tt0-rule-call-param.call_id
     2985         AND tt-rule-call-param.order_id = tt0-rule-call-param.order_id
     2986         AND tt-rule-call-param.param-name = tt0-rule-call-param.param-name
     2987         AND tt-rule-call-param.p-index = tt0-rule-call-param.p-index no-error .
     2988     if not available tt-rule-call-param
     2989     and (lookup("LIST", tt0-rule-call-param.param-3-data-type) > 0
     2990         OR
     2991         lookup("SORTED-LIST", tt0-rule-call-param.param-3-data-type) > 0
     2992         )
     2993     and tt0-rule-call-param.p-index > 0
     2994     then do:
     2995        IF p-call-id <> '':U and p-call-id <> tt0-rule-call-param.call_id THEN do:
     2996           NEXT.
     2997        end.
     2998        IF p-codex-id <> 0 and p-codex-id <> tt0-rule-call-param.codex_id THEN do:
     2999          NEXT.
     3000        end.
     3001        IF p-ruleset-id <> 0 and p-ruleset-id <> tt0-rule-call-param.ruleset_id THEN do:
     3002          NEXT.
     3003        end.
     3004        IF p-rule-id <> 0 and p-rule-id <> tt0-rule-call-param.RULE_id THEN do:
     3005          NEXT.
     3006        end.
     3007        IF p-order-id <> ? and p-order-id <> tt0-rule-call-param.order_id THEN do:
     3008          NEXT.
     3009        end.
     3010       IF p-list-mode = 'rp-rule-param':U
     3011       or p-list-mode = 'rp-rule-param':U  + chr(44) + 'все':U
     3012       THEN DO:
     3013         IF p-profile-id <> 0 AND p-profile-id <> tt0-rule-call-param.profile_id THEN do:
     3014           NEXT.
     3015         end.
     3016         IF p-once-more <> ? AND p-once-more <> tt0-rule-call-param.once-more THEN do:
     3017           NEXT.
     3018         end.
     3019       end.
     3020       delete tt0-rule-call-param.
     3021     end.
     3022   end.
     3023   END PROCEDURE.
     3024   PROCEDURE rcps_set-value :
     3025   DEFINE INPUT PARAMETER p-profile-id AS integer NO-UNDO.
     3026   DEFINE INPUT PARAMETER p-once-more AS integer NO-UNDO.
     3027   DEFINE INPUT PARAMETER p-call-id AS CHARACTER NO-UNDO.
     3028   DEFINE INPUT PARAMETER p-rp-param-name AS CHARACTER NO-UNDO.
     3029   DEFINE INPUT PARAMETER pp-index AS integer NO-UNDO.
     3030   DEFINE INPUT parameter p-value-character AS CHARACTER NO-UNDO.
     3031   DEFINE INPUT parameter p-value-date AS date NO-UNDO.
     3032   DEFINE INPUT parameter p-value-decimal AS decimal NO-UNDO.
     3033   DEFINE INPUT parameter p-value-integer AS integer NO-UNDO.
     3034   DEFINE INPUT parameter p-value-logical AS logical NO-UNDO.
     3035   DEFINE VARIABLE v-codex-id AS integer NO-UNDO.
     3036   DEFINE VARIABLE v-ruleset-id AS integer NO-UNDO.
     3037   DEFINE VARIABLE v-order-id AS integer NO-UNDO.
     3038   DEFINE VARIABLE V-param-name AS character NO-UNDO.
     3039   define variable v-found as logical no-undo .
     3040   DEFINE BUFFER buf_tt-rule-call-param FOR tt-rule-call-param.
     3041   DEFINE BUFFER buf_rp-rule-param FOR ub.rp-rule-param.
     3042   FOR FIRST buf_rp-rule-param WHERE
     3043             buf_rp-rule-param.profile_id = p-profile-id
     3044         AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     3045       , first buf_tt-rule-call-param WHERE
     3046          buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3047      AND buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3048      AND buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3049      AND buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name:
     3050     ASSIGN
     3051     v-codex-id = buf_tt-rule-call-param.codex_id
     3052     v-ruleset-id = buf_tt-rule-call-param.ruleset_id
     3053     v-order-id = buf_tt-rule-call-param.order_id
     3054     V-PARAM-NAME = buf_tt-rule-call-param.PARAM-NAME
     3055     .
     3056     LEAVE.
     3057   END.
     3058   CASE p-list-mode:
     3059     WHEN 'rp-rule-param':U THEN DO:
     3060       if pp-index > 0
     3061       then do:
     3062         FOR EACH  buf_rp-rule-param NO-LOCK where
     3063             buf_rp-rule-param.profile_id = p-profile-id
     3064             AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     3065             ,EACH buf_tt-rule-call-param WHERE
     3066                 buf_tt-rule-call-param.profile_id = p-profile-id
     3067             AND buf_tt-rule-call-param.once-more = p-once-more
     3068             AND buf_tt-rule-call-param.call_id = p-CALL-id
     3069             AND buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3070             AND buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3071             AND buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3072             AND buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     3073             AND buf_tt-rule-call-param.p-index = pp-index
     3074         ON error undo, return error :
     3075           v-found = yes.
     3076         end.
     3077       end.
     3078       if not v-found then do:
     3079         run rcps_proc-b-add in this-procedure (
     3080                                                  input p-profile-id
     3081                                                 ,input p-once-more
     3082                                                 ,input p-call-id
     3083                                                 ,
     3084                                                  input p-rp-param-name
     3085                                                 ,input pp-index).
     3086       end.
     3087       FOR EACH  buf_rp-rule-param NO-LOCK where
     3088           buf_rp-rule-param.profile_id = p-profile-id
     3089           AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     3090           ,EACH buf_tt-rule-call-param WHERE
     3091               buf_tt-rule-call-param.profile_id = p-profile-id
     3092           AND buf_tt-rule-call-param.once-more = p-once-more
     3093           AND buf_tt-rule-call-param.call_id = p-CALL-id
     3094           AND buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3095           AND buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3096           AND buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3097           AND buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     3098           AND buf_tt-rule-call-param.p-index = pp-index
     3099         ON error undo, return error :
     3100         assign
     3101         buf_tt-rule-call-param.param-value-character = p-value-character
     3102         buf_tt-rule-call-param.param-value-date      = p-value-date
     3103         buf_tt-rule-call-param.param-value-decimal   = p-value-decimal
     3104         buf_tt-rule-call-param.param-value-integer   = p-value-integer
     3105         buf_tt-rule-call-param.param-value-logical   = p-value-logical
     3106         .
     3107       END.
     3108     END.
     3109     WHEN 'rule-call-param':U THEN DO:
     3110       FIND FIRST buf_tt-rule-call-param WHERE
     3111           buf_tt-rule-call-param.call_id = p-call-id
     3112       AND buf_tt-rule-call-param.codex_id = v-codex-id
     3113       AND buf_tt-rule-call-param.ruleset_id = v-ruleset-id
     3114       AND buf_tt-rule-call-param.order_id = v-order-id
     3115       AND buf_tt-rule-call-param.param-name = V-PARAM-NAME
     3116       AND buf_tt-rule-call-param.p-index = pp-index.
     3117       assign
     3118       buf_tt-rule-call-param.param-value-character = p-value-character
     3119       buf_tt-rule-call-param.param-value-date      = p-value-date
     3120       buf_tt-rule-call-param.param-value-decimal   = p-value-decimal
     3121       buf_tt-rule-call-param.param-value-integer   = p-value-integer
     3122       buf_tt-rule-call-param.param-value-logical   = p-value-logical
     3123       .
     3124     END.
     3125   END CASE.
     3126   END PROCEDURE.
     3127   procedure rcps_get-rule-on-off :
