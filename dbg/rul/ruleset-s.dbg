      573                           ,input 'ПРОСМОТР':U
      574                           ,input buf_ruleset.codex_id
      575                           ,input buf_ruleset.ruleset_id
      576                           ,input-output v-rec) no-error.
      577     end.
      578     else do:
      579       if not available X_ruleset then return no-apply.
