     1287             (input  v-cntxt-db-num
     1288             ,input  v-cntxt-userid
     1289             ,input  v-diasize-proc-name
     1290             ,input  'height':u
     1291             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1292             ) .
     1293         end.
     1294       end.
     1295     end.
     1296     assign
     1297       v-diasize-change-size = false
     1298     .
     1299   end procedure.
     1300   procedure diasize_set-height :
     1301     define input  parameter p-new-height  as decimal   no-undo .
     1302     define input  parameter p-move-resize as logical   no-undo .
     1303     do
     1304     on error undo, return error return-value
     1305     :
     1306       run diasize_change-height in this-procedure
     1307         (input  (p-new-height - frame Dialog-Frame :height)
     1308         ,input  p-move-resize
     1309         ) .
     1310     end.
     1311   end procedure.
     1312   procedure diasize_change-width :
     1313     define input  parameter p-change-value as decimal   no-undo .
     1314     define input  parameter p-move-resize  as logical   no-undo .
     1315     define variable v-field-group-handle   as handle    no-undo .
     1316     define variable v-object-handle        as handle    no-undo .
     1317     define variable v-frame-width          as decimal   no-undo .
     1318     define variable v-frame-virtual-width  as decimal   no-undo .
     1319     define variable v-browse-width         as decimal   no-undo .
     1320     define variable v-window-width         as decimal   no-undo .
     1321     define variable v-window-virtual-width as decimal   no-undo .
     1322     define variable v-change-sign          as integer   no-undo .
     1323     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1324     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1325     if p-change-value > 0
     1326     then do:
     1327       if frame Dialog-Frame :width + p-change-value >
     1328           session :width-chars
     1329       then do:
     1330         assign
     1331           p-change-value = session :width-chars - frame Dialog-Frame :width
     1332         .
     1333         if p-change-value <= 0
     1334         then do:
     1335           run diasize_position-resize-button in this-procedure .
     1336           return .
     1337         end.
     1338       end.
     1339     end.
     1340     if p-change-value < 0
     1341     then do:
     1342       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1343       then do:
     1344         assign
     1345           p-change-value = v-diasize-orig-frame-width
     1346                          - frame Dialog-Frame :width
     1347         .
     1348         if p-change-value >= 0
     1349         then do:
     1350           run diasize_position-resize-button in this-procedure .
     1351           return .
     1352         end.
     1353       end.
     1354     end.
     1355     if p-change-value >= 0
     1356     then do:
     1357       assign
     1358         v-change-sign = 1
     1359       .
     1360     end.
     1361     else do:
     1362       assign
     1363         v-change-sign = -1
     1364       .
     1365     end.
     1366     assign
     1367       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1368     .
     1369     if p-change-value = 0
     1370     then do:
     1371       run diasize_position-resize-button in this-procedure .
     1372       return .
     1373     end.
     1374     move_block:
     1375     do
     1376     on error undo move_block, leave move_block
     1377     :
     1378       if retry
     1379       then do:
     1380         do
     1381         on error undo move_block, leave move_block
     1382         :
     1383           if p-change-value > 0
     1384           then do:
     1385             for each buf_temp-diasize-handle
     1386             on error undo, next
     1387             :
     1388               assign
     1389                 v-object-handle = buf_temp-diasize-handle.handle-value
     1390               .
