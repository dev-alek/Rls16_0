      811   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      812   procedure minbtn-set :
      813       do
      814           on error undo, return error return-value
      815           :
      816           define variable ii              as integer       no-undo .
      817           define variable fh              as widget-handle no-undo .
      818           define variable hh              as widget-handle no-undo .
      819           define variable v-h             as handle        extent 4 no-undo .
      820           define variable v-name-button   as character     no-undo .
      821           define variable v-help-old-x    as decimal       no-undo .
      822           define variable v-help-old-y    as decimal       no-undo .
      823           define variable v-help-old-size as decimal       no-undo .
      824           define variable v-frame-width   as decimal       no-undo .
      825           define variable jj              as integer       no-undo .
      826           do
      827               on error undo, return error
      828               :
      829               assign
      830                   v-frame-width = frame Dialog-Frame:width - 0.3
      831                   fh            = frame Dialog-Frame:first-child
      832                   hh            = fh:first-child
      833                   ii            = 1
      834                   .
      835               do while valid-handle(hh):
      836                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      837                   do:
      838                       case lc(hh:name) :
      839                           when "b-help" then
      840                               do:
      841                                   hh:load-image-up("cmp/b-help.bmp":u) .
      842                                   hh:load-image-down("cmp/b-help.bmp":u) .
      843                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      844                                   hh:TOOLTIP = "Помощь" .
      845                                   v-help-old-x = hh:column .
      846                                   v-help-old-y = hh:row    .
      847                                   v-help-old-size = hh:width .
      848                                   hh:width-chars = 2.5 .
      849                               end.
      850                           when "b-print" then
      851                               do:
      852                                   hh:load-image("cmp/b-print.bmp":u) .
      853                                   hh:TOOLTIP = "Печать" .
      854                                   v-h[ii] = hh:handle .
      855                                   ii = ii + 1 .
      856                                   hh:width-chars = 3 .
      857                               end.
      858                           when "b-history" or
      859                           when "b-hist" then
      860                               do:
      861                                   hh:load-image("cmp/b-hist.bmp":u) .
      862                                   hh:TOOLTIP = "История" .
      863                                   v-h[ii] = hh:handle .
      864                                   ii = ii + 1 .
      865                                   hh:width-chars = 3 .
      866                               end.
      867                           when "b-sch" then
      868                               do:
      869                                   hh:load-image("cmp/b-sch.bmp":u) .
      870                                   hh:TOOLTIP = "Установка Фильтра" .
      871                                   v-h[ii] = hh:handle .
      872                                   ii = ii + 1 .
      873                                   hh:width-chars = 3 .
      874                               end.
      875                           when "b-hist-user" then
      876                               do:
      877                                   hh:load-image("cmp/b-hist.bmp":u) .
      878                                   hh:TOOLTIP = "История пользователя" .
      879                                   ii = ii + 1 .
      880                               end.
      881                       end case.
      882                   end.
      883                   hh = hh:next-sibling.
      884               end.
      885               b-help:column = v-frame-width - b-help:width-chars.
      886               jj = 0.
      887               repeat ii = 4 to 1 by -1 :
      888                   if valid-handle (v-h[ii] ) then
      889                   do:
      890                       jj  = jj + 1 .
      891                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      892                       v-h[ii]:row    = v-help-old-y .
      893                   end.
      894               end.
      895           end.
      896       end.
      897   end procedure.
      898   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      899   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      900   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      901   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      902   define variable v-diasize-current-frame-width  as decimal   no-undo .
      903   define variable v-diasize-current-frame-height as decimal   no-undo .
      904   define variable v-diasize-change-size          as logical   no-undo .
      905   define variable v-diasize-resize-button        as handle    no-undo .
      906   define variable v-diasize-wndmax               as logical   no-undo .
      907   define variable v-diasize-wndstore             as logical   no-undo .
      908   define variable v-diasize-proc-name            as character no-undo .
      909   define variable v-diasize-browse-handle        as handle    no-undo .
      910   define variable v-diasize-browse-number        as integer   no-undo .
      911   define variable v-diasize-need-full-display    as logical   no-undo init false .
      912   define temp-table temp-diasize-handle no-undo
      913     field handle-value  as handle
      914     field save-position as decimal
      915     index xpk is primary unique handle-value
      916     .
      917   define temp-table temp-browse-handle no-undo
      918     field browse-type   as character
      919     field browse-number as integer
      920     field browse-handle as handle
      921     field original-size as decimal
      922     index xpk is primary unique browse-type browse-number
      923     index xie browse-type browse-handle
      924   .
      925   procedure diasize_change-height :
      926     define input  parameter p-change-value  as decimal   no-undo .
      927     define input  parameter p-move-resize   as logical   no-undo .
      928     define variable v-field-group-handle    as handle    no-undo .
      929     define variable v-object-handle         as handle    no-undo .
      930     define variable v-frame-height          as decimal   no-undo .
      931     define variable v-frame-virtual-height  as decimal   no-undo .
      932     define variable v-browse-height         as decimal   no-undo .
      933     define variable v-window-height         as decimal   no-undo .
      934     define variable v-window-virtual-height as decimal   no-undo .
      935     define variable v-change-sign           as integer   no-undo .
      936     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      937     define buffer buf_temp-browse-handle  for temp-browse-handle .
      938     if p-change-value > 0
      939     then do:
      940       if frame Dialog-Frame :height + p-change-value
      941           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      942       then do:
      943         assign
      944           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      945                           - (frame Dialog-Frame :height-chars)
      946         .
      947         if p-change-value <= 0
      948         then do:
      949           run diasize_position-resize-button in this-procedure .
      950           return .
      951         end.
      952       end.
      953     end.
      954     if p-change-value < 0
      955     then do:
      956       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      957       then do:
      958         assign
      959           p-change-value = v-diasize-orig-frame-height
      960                          - (frame Dialog-Frame :height-chars)
      961         .
      962         if p-change-value >= 0
      963         then do:
      964           run diasize_position-resize-button in this-procedure .
      965           return .
      966         end.
      967       end.
      968     end.
      969     if p-change-value >= 0
      970     then do:
      971       assign
      972         v-change-sign = 1
      973       .
      974     end.
      975     else do:
      976       assign
      977         v-change-sign = -1
      978       .
      979     end.
      980     assign
      981       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      982     .
      983     if p-change-value = 0
      984     then do:
      985       run diasize_position-resize-button in this-procedure .
      986       return .
      987     end.
      988     move_block:
      989     do
      990     on error undo move_block, retry move_block
      991     :
      992       if retry
      993       then do:
      994         do
      995         on error undo move_block, leave move_block
      996         :
      997           if p-change-value > 0
      998           then do:
      999             for each buf_temp-diasize-handle
     1000             on error undo, next
     1001             :
     1002               assign
     1003                 v-object-handle = buf_temp-diasize-handle.handle-value
     1004               .
     1005               if v-object-handle <> v-diasize-resize-button
     1006               then do:
     1007                 assign
     1008                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1009                 .
     1010               end.
     1011             end.
     1012             assign
     1013               v-diasize-browse-handle :height = v-browse-height
     1014             .
     1015             for each buf_temp-browse-handle
     1016               where buf_temp-browse-handle.browse-type = 'height':u
     1017             on error undo, next
     1018             :
     1019               assign
     1020                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1021               .
     1022             end.
     1023             assign
     1024               frame Dialog-Frame :height = v-frame-height
     1025             .
     1026             if frame Dialog-Frame :scrollable = true
     1027             then do:
     1028               assign
     1029                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1030               .
     1031             end.
     1032             run diasize_position-resize-button in this-procedure .
     1033           end.
     1034           else do:
     1035             if frame Dialog-Frame :scrollable = true
     1036             then do:
     1037               assign
     1038                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1039               .
     1040             end.
     1041             assign
     1042               frame Dialog-Frame :height = v-frame-height
     1043             .
     1044             assign
     1045               v-diasize-browse-handle :height = v-browse-height
     1046             .
     1047             for each buf_temp-browse-handle
     1048               where buf_temp-browse-handle.browse-type = 'height':u
     1049             on error undo, next
     1050             :
     1051               assign
     1052                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1053               .
     1054             end.
     1055             for each buf_temp-diasize-handle
     1056             on error undo, next
     1057             :
     1058               assign
     1059                 v-object-handle = buf_temp-diasize-handle.handle-value
     1060               .
     1061               if v-object-handle <> v-diasize-resize-button
     1062               then do:
     1063                 assign
     1064                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1065                 .
     1066               end.
     1067             end.
     1068             run diasize_position-resize-button in this-procedure .
     1069           end.
     1070           assign
     1071             v-diasize-change-size = false
     1072           .
     1073           leave move_block .
     1074         end.
     1075       end.
     1076       assign
     1077         v-diasize-need-full-display = true
     1078       .
     1079       if v-diasize-change-size = false
     1080       then do:
     1081         assign
     1082           v-diasize-change-size = true
     1083         .
     1084       end.
     1085       else do:
     1086         return .
     1087       end.
     1088       assign
     1089         v-frame-height = frame Dialog-Frame :height
     1090         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1091         v-browse-height = v-diasize-browse-handle :height
     1092       .
     1093       for each buf_temp-browse-handle
     1094         where buf_temp-browse-handle.browse-type = 'height':u
     1095       :
     1096         assign
     1097           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1098         .
     1099       end.
     1100       for each buf_temp-diasize-handle
     1101       :
     1102         delete buf_temp-diasize-handle .
