      612         glog = br-ruleset:select-next-row ().
      613         apply "VALUE-CHANGED" to br-ruleset in frame Dialog-Frame.
      614     end.
      615     if num-entries( v-rid-list ) = 0
      616     then
      617         hide mark-num in frame Dialog-Frame.
      618     else
      619         disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
      620   end.
      621   apply "entry" to br-ruleset in frame Dialog-Frame.
      622   END.
