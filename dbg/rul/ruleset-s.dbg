     1146           v-diasize-resize-button :row    = 1
     1147           v-diasize-resize-button :column = 1
     1148         .
     1149       end.
     1150       if p-change-value > 0
     1151       then do:
     1152         if frame Dialog-Frame :scrollable = true
     1153         then do:
     1154           assign
     1155             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1156             no-error .
     1157           if error-status :error
     1158           or error-status :get-message(1) <> ""
     1159           then do:
     1160             undo move_block, retry move_block .
     1161           end.
     1162         end.
     1163         assign
     1164           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1165           no-error .
     1166         if error-status :error
     1167         or error-status :get-message(1) <> ""
     1168         then do:
     1169           undo move_block, retry move_block .
     1170         end.
     1171         assign
     1172           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1173           no-error .
