     1675             ,input  v-cntxt-userid
     1676             ,input  v-diasize-proc-name
     1677             ,input  'width':u
     1678             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1679             ) .
     1680         end.
     1681       end.
     1682     end.
     1683     assign
     1684       v-diasize-change-size = false
     1685     .
     1686   end procedure.
     1687   procedure diasize_set-width :
     1688     define input  parameter p-new-width  as decimal   no-undo .
     1689     define input  parameter p-move-resize as logical   no-undo .
     1690     do
     1691     on error undo, return error return-value
     1692     :
     1693       run diasize_change-width in this-procedure
     1694         (input  (p-new-width - frame Dialog-Frame :width)
     1695         ,input  p-move-resize
     1696         ) .
     1697     end.
     1698   end procedure.
     1699   procedure diasize_position-resize-button :
     1700     do with frame Dialog-Frame
     1701     :
     1702       hide v-diasize-resize-button .
     1703       assign
     1704         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1705                     - 1
     1706                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1707         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1708                     - 1
     1709                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1710       .
     1711       view v-diasize-resize-button .
     1712     end.
     1713   end procedure.
     1714   on alt-right anywhere
     1715   do:
     1716     run diasize_change-width in this-procedure
     1717       (input 1
     1718       ,input true
     1719       ) .
     1720     return no-apply .
     1721   end.
     1722   on alt-left anywhere
     1723   do:
     1724     run diasize_change-width in this-procedure
     1725       (input -1
     1726       ,input true
     1727       ) .
     1728     return no-apply .
     1729   end.
     1730   on alt-down anywhere
     1731   do:
     1732     run diasize_change-height in this-procedure
     1733       (input 1
     1734       ,input true
     1735       ) .
     1736     return no-apply .
     1737   end.
     1738   on alt-up anywhere
     1739   do:
     1740     run diasize_change-height in this-procedure
     1741       (input -1
     1742       ,input true
     1743       ) .
     1744     return no-apply .
     1745   end.
     1746   on alt-enter of frame Dialog-Frame
     1747   do:
     1748     run diasize_maximize in this-procedure
     1749       (input  ?
     1750       ).
     1751     return no-apply .
     1752   end.
     1753   procedure diasize_end-move :
     1754     do
     1755     on error undo, return error return-value
     1756     :
     1757       define variable v-row-delta as decimal   no-undo .
     1758       define variable v-col-delta as decimal   no-undo .
     1759       define variable v-new-row as decimal   no-undo .
     1760       define variable v-new-col as decimal   no-undo .
     1761       assign
     1762         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1763         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1764       .
     1765       assign
     1766         v-row-delta = v-new-row - frame Dialog-Frame :height
     1767         v-col-delta = v-new-col - frame Dialog-Frame :width
     1768       .
     1769       run diasize_change-height in this-procedure
     1770         (input v-row-delta
     1771         ,input true
     1772         ) .
     1773       run diasize_change-width in this-procedure
     1774         (input v-col-delta
     1775         ,input true
     1776         ) .
     1777     end.
     1778   end procedure.
     1779   procedure diasize_maximize :
     1780     define input  parameter p-action as logical   no-undo .
     1781     do
     1782     on error undo, return error return-value
     1783     :
     1784       if p-action = ?
     1785       then do:
     1786         if v-diasize-need-maximize = true
     1787         then do:
     1788           assign
     1789             p-action = true
     1790           .
     1791         end.
     1792         else do:
     1793           assign
     1794             p-action = false
     1795           .
     1796         end.
     1797       end.
     1798       if p-action = true
     1799       then do:
     1800         run diasize_change-height in this-procedure
     1801           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1802               - frame Dialog-Frame :height-chars
     1803           ,input true
     1804           ) .
     1805         run diasize_change-width in this-procedure
     1806           (input session :width-chars
     1807               - frame Dialog-Frame :width-chars
     1808           ,input true
     1809           ) .
     1810         assign
     1811           v-diasize-need-maximize = false
     1812         .
     1813       end.
     1814       else do:
     1815         run diasize_change-width in this-procedure
     1816           (input v-diasize-orig-frame-width
     1817               - frame Dialog-Frame :width-chars
     1818           ,input true
     1819           ) .
     1820         run diasize_change-height in this-procedure
     1821           (input v-diasize-orig-frame-height
     1822               - frame Dialog-Frame :height-chars
     1823           ,input true
     1824           ) .
     1825         assign
     1826           v-diasize-need-maximize = true
     1827         .
     1828       end.
     1829     end.
     1830   end procedure.
     1831   procedure diasize_restore-orig-size :
     1832     do
     1833     on error undo, return error return-value
     1834     :
     1835       assign
     1836         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1837         v-diasize-current-frame-height = frame Dialog-Frame :height
     1838       .
     1839       run diasize_set-height in this-procedure
     1840         (input  v-diasize-orig-frame-height
     1841         ,input  true
     1842         ) .
     1843       run diasize_set-width in this-procedure
     1844         (input  v-diasize-orig-frame-width
     1845         ,input  true
     1846         ) .
     1847     end.
     1848   end procedure.
     1849   procedure diasize_restore-current-size :
     1850     do
     1851     on error undo, return error return-value
     1852     :
     1853       run diasize_set-height in this-procedure
     1854         (input  v-diasize-current-frame-height
     1855         ,input  true
     1856         ) .
     1857       run diasize_set-width in this-procedure
     1858         (input  v-diasize-current-frame-width
     1859         ,input  true
     1860         ) .
     1861     end.
     1862   end procedure.
     1863   procedure diasize_set-browse-handle :
     1864     define input  parameter p-browse-handle as handle   no-undo .
     1865     define buffer buf_temp-browse-handle for temp-browse-handle .
     1866     do
     1867     on error undo, return error return-value
     1868     :
     1869       assign
     1870         v-diasize-browse-handle = p-browse-handle
     1871       .
     1872       for each buf_temp-browse-handle
     1873       on error undo, return error return-value
     1874       :
     1875         delete buf_temp-browse-handle .
     1876       end.
     1877     end.
     1878   end procedure.
     1879   procedure diasize_add_browse :
     1880     define input  parameter p-browse-type   as character no-undo .
     1881     define input  parameter p-browse-handle as handle    no-undo .
     1882     define buffer buf_temp-browse-handle for temp-browse-handle .
     1883     do
     1884     on error undo, return error return-value
     1885     :
     1886       assign
     1887         v-diasize-browse-number = v-diasize-browse-number + 1
     1888       .
     1889       create buf_temp-browse-handle .
     1890       assign
     1891         buf_temp-browse-handle.browse-type   = p-browse-type
     1892         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1893         buf_temp-browse-handle.browse-handle = p-browse-handle
     1894       .
     1895     end.
     1896   end procedure.
     1897   procedure diasize_init :
     1898     define variable v-default-value    as logical   no-undo .
     1899     define variable v-restore-saved    as logical   no-undo .
     1900     define variable v-resize-value-str as character no-undo .
     1901     do
     1902     on error undo, return error return-value
     1903     :
     1904       do with frame Dialog-Frame
     1905       :
     1906         assign
     1907           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1908           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1909           v-diasize-browse-handle     = browse br-ruleset :handle
     1910         .
     1911         create button v-diasize-resize-button
     1912         assign
     1913           parent        = frame Dialog-Frame :first-child
     1914           label         = "s"
     1915           height-pixels = 16
     1916           width-pixels  = 16
     1917           visible       = true
     1918           sensitive     = true
     1919           movable       = true
     1920           triggers:
     1921             on end-move persistent run diasize_end-move in this-procedure .
     1922           end triggers.
     1923         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1924         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1925         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1926         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1927         assign
     1928           v-diasize-wndmax = false
     1929         .
     1930         if connected("ub") = true
     1931         then do:
     1932           define variable v-cntxt-db-num        as integer   no-undo .
     1933           define variable v-cntxt-userid        as character no-undo .
     1934           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1935                                             , OUTPUT v-cntxt-userid
     1936                                             ) .
     1937           run gbl/wndpar_r.p
     1938             (input  v-cntxt-db-num
     1939             ,input  v-cntxt-userid
     1940             ,input  'wndmax':U
     1941             ,output v-diasize-wndmax
     1942             ,output v-default-value
     1943             ) .
     1944         end.
     1945         assign
     1946           v-diasize-wndstore = false
     1947         .
     1948         if connected("ub") = true
     1949         then do:
     1950           run gbl/wndpar_r.p
     1951             (input  v-cntxt-db-num
     1952             ,input  v-cntxt-userid
     1953             ,input  'wndstore':U
     1954             ,output v-diasize-wndstore
     1955             ,output v-default-value
     1956             ) .
     1957         end.
     1958         assign
     1959           v-diasize-proc-name = entry(1, program-name(2), '.')
     1960         .
     1961         if v-diasize-wndstore = true
     1962         then do:
     1963           assign
     1964             v-restore-saved = false
     1965           .
     1966           if connected("ub") = true
     1967           then do:
     1968             run gbl/wndsizer.p
     1969               (input  v-cntxt-db-num
     1970               ,input  v-cntxt-userid
     1971               ,input  v-diasize-proc-name
     1972               ,input  'height':u
     1973               ,output v-resize-value-str
     1974               ) .
     1975             if v-resize-value-str <> '':U
     1976             then do:
     1977               run diasize_change-height in this-procedure
     1978                 (input  integer(v-resize-value-str)
     1979                 ,input  true
     1980                 ) .
     1981               assign
     1982                 v-restore-saved = true
     1983               .
     1984             end.
     1985           end.
     1986           if connected("ub") = true
     1987           then do:
     1988             run gbl/wndsizer.p
     1989               (input  v-cntxt-db-num
     1990               ,input  v-cntxt-userid
     1991               ,input  v-diasize-proc-name
     1992               ,input  'width':u
     1993               ,output v-resize-value-str
     1994               ) .
     1995             if v-resize-value-str <> '':U
     1996             then do:
     1997               run diasize_change-width in this-procedure
     1998                 (input  integer(v-resize-value-str)
     1999                 ,input  true
     2000                 ) .
     2001               assign
     2002                 v-restore-saved = true
     2003               .
     2004             end.
     2005           end.
     2006           if v-restore-saved <> true
     2007           then do:
     2008             if v-diasize-wndmax = true
     2009             then do:
     2010               run diasize_maximize in this-procedure
     2011                 (input  true
     2012                 ) .
     2013             end.
     2014           end.
     2015         end.
     2016         else do:
     2017           if v-diasize-wndmax = true
     2018           then do:
     2019             run diasize_maximize in this-procedure
     2020               (input  true
     2021               ) .
     2022           end.
     2023         end.
     2024       end.
     2025     end.
     2026   end procedure.
     2027   procedure diasize_need-full-display :
     2028     define output parameter p-need-full-display as logical   no-undo .
     2029     do
     2030     on error undo, return error return-value
     2031     :
     2032       assign
     2033         p-need-full-display = v-diasize-need-full-display
     2034       .
     2035       assign
     2036         v-diasize-need-full-display = false
     2037       .
     2038     end.
     2039   end procedure.
     2040   procedure get-context :
     2041      define output parameter p-db-num as integer          no-undo.
     2042      define output parameter p-user-id as character        no-undo.
     2043      define variable v-login               as character    no-undo.
     2044      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2045      define buffer buf_user-login  for ub.user-login .
     2046      do
     2047      on error undo, return error
     2048      :
     2049            FIND FIRST buf_sys-ctrl no-lock.
     2050            ASSIGN
     2051               v-login = USERID("ub")
     2052               p-db-num = buf_sys-ctrl.db-num
     2053            .
     2054            FIND FIRST buf_user-login
     2055                 WHERE buf_user-login.db-num = p-db-num
     2056                   AND buf_user-login.user-login = v-login
     2057                 no-lock
     2058                 no-error
     2059                 .
     2060            IF AVAILABLE buf_user-login
     2061            THEN DO:
     2062               assign
     2063                  p-user-id = buf_user-login.user-id
     2064               .
     2065            END.
     2066      end.
     2067   end procedure.
     2068       run diasize_init in this-procedure .
     2069   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2070   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2071   MAIN-BLOCK:
     2072   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2073      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2074   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2075     run mainmenu_getcntxt in parparentproc
     2076       (output v-cntxt-db-num
     2077       ,output v-cntxt-userid
     2078       ,output v-cntxt-level
     2079       ,output v-cntxt-host-code-obj
     2080       ,output v-cntxt-obj-type
     2081       ,output v-cntxt-obj-code
     2082       ,output v-cntxt-db-num-obj
     2083       ,output v-cntxt-is-admin
     2084       ) .
     2085     if lookup( entry(1, p-list-mode, chr(4)), 'все':U + chr(44) +
     2086                             "codex" + chr(44) +
     2087                             "only-codex" + chr(44) +
     2088                             "only-ruleset" + chr(44) +
     2089                             "profile-type") = 0 then do:
     2090       message
     2091       substitute("Неверное значение параметра p-list-mode=&1", p-list-mode)
     2092       view-as alert-box error .
     2093       undo main-block, return error .
     2094     end.
     2095     v-rid-list = p-rid-list.
     2096     if entry(1, p-list-mode, chr(4)) = "profile-type" then do:
     2097       run fill-table in this-procedure ( input entry(2, p-list-mode, chr(4))).
     2098     end.
     2099     run Myenable in this-procedure .
     2100     WAIT-FOR GO OF FRAME Dialog-Frame.
     2101   END.
     2102   RUN disable_UI.
     2103   PROCEDURE disable_UI :
     2104     HIDE FRAME Dialog-Frame.
     2105   END PROCEDURE.
     2106   PROCEDURE enable_UI :
     2107     DISPLAY mark-num
     2108         WITH FRAME Dialog-Frame.
     2109     ENABLE b-quit b-mark b-sel b-add b-chg b-del b-lkp b-links B-Help
     2110            br-temp-ruleset br-ruleset mark-num
     2111         WITH FRAME Dialog-Frame.
     2112     VIEW FRAME Dialog-Frame.
     2113     OPEN QUERY br-ruleset FOR EACH X_ruleset.    OPEN QUERY br-temp-ruleset FOR EACH tt-ruleset.
     2114   END PROCEDURE.
     2115   PROCEDURE fill-table :
     2116   DEFINE INPUT PARAMETER p-profile-type AS CHARACTER NO-UNDO.
     2117   DEFINE buffer buf_rule-profile FOR ub.rule-profile.
     2118   DEFINE buffer buf_rule-by-profile FOR ub.rule-by-profile.
     2119   DEFINE buffer buf_ruleset FOR ub.ruleset.
     2120   DEFINE buffer buf_tt-ruleset FOR tt-ruleset.
     2121   FOR EACH buf_tt-ruleset:
     2122       DELETE buf_tt-ruleset.
     2123   END.
     2124   FOR EACH buf_rule-profile NO-LOCK WHERE
     2125           buf_rule-profile.profile-type begins (entry(1, p-profile-type, "_") + "_")
     2126           or buf_rule-profile.profile-type = p-profile-type
     2127           ,
     2128       EACH buf_rule-by-profile NO-LOCK WHERE
     2129           buf_rule-by-profile.profile_id = buf_rule-profile.profile_id
     2130   BREAK
     2131   BY buf_rule-by-profile.codex_id
     2132   BY buf_rule-by-profile.ruleset_id:
     2133      IF FIRST-OF(buf_rule-by-profile.ruleset_id) THEN DO:
     2134        case entry(3, p-list-mode, chr(4)):
     2135          when "ruleset" then do:
     2136             FIND FIRST buf_tt-ruleset NO-LOCK WHERE
     2137                       buf_tt-ruleset.codex_id = buf_rule-by-profile.codex_id
     2138                 AND buf_tt-ruleset.ruleset_id = buf_rule-by-profile.ruleset_id NO-ERROR.
     2139             IF NOT AVAILABLE( buf_tt-ruleset) THEN DO:
     2140                 FIND FIRST buf_ruleset NO-LOCK WHERE
     2141                     buf_ruleset.codex_id = buf_rule-by-profile.codex_id
     2142               AND buf_ruleset.ruleset_id = buf_rule-by-profile.ruleset_id NO-ERROR.
     2143               IF AVAILABLE buf_ruleset THEN DO:
     2144                   CREATE buf_tt-ruleset.
     2145                   BUFFER-COPY buf_ruleset TO buf_tt-ruleset.
     2146               END.
     2147             END.
     2148          end.
     2149          when "codex" then do:
     2150             FIND FIRST buf_tt-ruleset NO-LOCK WHERE
     2151                       buf_tt-ruleset.codex_id = buf_rule-by-profile.codex_id
     2152                 AND buf_tt-ruleset.ruleset_id = 0 NO-ERROR.
     2153             IF NOT AVAILABLE( buf_tt-ruleset) THEN DO:
     2154                 FIND FIRST buf_ruleset NO-LOCK WHERE
     2155                     buf_ruleset.codex_id = buf_rule-by-profile.codex_id
     2156               AND buf_ruleset.ruleset_id = 0 NO-ERROR.
     2157               IF AVAILABLE buf_ruleset THEN DO:
     2158                   CREATE buf_tt-ruleset.
     2159                   BUFFER-COPY buf_ruleset TO buf_tt-ruleset.
     2160               END.
     2161             END.
     2162          end.
     2163          when "all" then do:
     2164             FIND FIRST buf_tt-ruleset NO-LOCK WHERE
     2165                       buf_tt-ruleset.codex_id = buf_rule-by-profile.codex_id
     2166                 AND buf_tt-ruleset.ruleset_id = buf_rule-by-profile.ruleset_id NO-ERROR.
     2167             IF NOT AVAILABLE( buf_tt-ruleset) THEN DO:
     2168                 FIND FIRST buf_ruleset NO-LOCK WHERE
     2169                     buf_ruleset.codex_id = buf_rule-by-profile.codex_id
     2170               AND buf_ruleset.ruleset_id = buf_rule-by-profile.ruleset_id NO-ERROR.
     2171               IF AVAILABLE buf_ruleset THEN DO:
     2172                   CREATE buf_tt-ruleset.
     2173                   BUFFER-COPY buf_ruleset TO buf_tt-ruleset.
     2174               END.
     2175             END.
     2176             FIND FIRST buf_tt-ruleset NO-LOCK WHERE
     2177                       buf_tt-ruleset.codex_id = buf_rule-by-profile.codex_id
     2178                 AND buf_tt-ruleset.ruleset_id = 0 NO-ERROR.
     2179             IF NOT AVAILABLE( buf_tt-ruleset) THEN DO:
     2180                 FIND FIRST buf_ruleset NO-LOCK WHERE
     2181                     buf_ruleset.codex_id = buf_rule-by-profile.codex_id
     2182               AND buf_ruleset.ruleset_id = 0 NO-ERROR.
     2183               IF AVAILABLE buf_ruleset THEN DO:
     2184                   CREATE buf_tt-ruleset.
     2185                   BUFFER-COPY buf_ruleset TO buf_tt-ruleset.
     2186               END.
     2187             END.
     2188          end.
     2189        end case.
     2190      END.
     2191   END.
     2192   END PROCEDURE.
     2193   PROCEDURE MyEnable :
     2194   b-links:MENU-MOUSE IN FRAME Dialog-Frame = 1.
     2195   if entry(1, p-list-mode, chr(4)) = "profile-type" THEN DO:
     2196     v-browse-mode = "temp".
     2197       ASSIGN
     2198       tt-ruleset.NAME:RESIZABLE IN BROWSE br-temp-ruleset = YES.
     2199       ENABLE
     2200       b-quit
     2201       b-lkp
     2202       B-Help
     2203       b-links
     2204       b-sel when lookup("b-sel", bttns) > 0
     2205       br-temp-ruleset
     2206       WITH FRAME Dialog-Frame.
     2207       VIEW FRAME Dialog-Frame.
     2208       run OpentempBr in this-procedure .
     2209       DISABLE
     2210       b-add
     2211       b-chg
     2212       b-del
     2213       br-ruleset
     2214       WITH FRAME Dialog-Frame.
     2215       HIDE
     2216       br-ruleset
     2217       IN FRAME Dialog-Frame.
     2218       assign
     2219       menu-item m_prop-ruleset:sensitive in menu menu-b-links = no
     2220       menu-item m_pscript-ruleset:sensitive in menu menu-b-links = no
     2221       .
     2222     apply "entry" to br-ruleset in frame Dialog-Frame .
     2223     apply "VALUE-CHANGED" to br-ruleset in frame Dialog-Frame .
     2224   END.
     2225   ELSE DO:
     2226       ASSIGN
     2227       X_ruleset.NAME:RESIZABLE IN BROWSE br-ruleset = YES .
     2228       ENABLE
     2229       b-quit
     2230       b-add when (v-cntxt-db-num = 0 and lookup("b-add", bttns) > 0)
     2231       b-chg when (v-cntxt-db-num = 0 and lookup("b-add", bttns) > 0)
     2232       b-del when (v-cntxt-db-num = 0 and lookup("b-add", bttns) > 0)
     2233       b-lkp
     2234       B-Help
     2235       b-mark when lookup("b-mark", bttns) > 0
     2236       b-sel when lookup("b-sel", bttns) > 0
     2237       b-links
     2238       br-ruleset
     2239       WITH FRAME Dialog-Frame.
     2240       VIEW FRAME Dialog-Frame.
     2241       DISABLE
     2242       br-temp-ruleset
     2243       WITH FRAME Dialog-Frame.
     2244       HIDE
     2245       br-temp-ruleset
     2246       IN FRAME Dialog-Frame.
     2247       run OpenBr in this-procedure .
     2248     apply "entry" to br-temp-ruleset in frame Dialog-Frame .
     2249     apply "VALUE-CHANGED" to br-temp-ruleset in frame Dialog-Frame .
     2250   END.
     2251   END PROCEDURE.
     2252   PROCEDURE Openbr :
     2253   case p-list-mode:
     2254     when 'все':U then do:
     2255       frame Dialog-Frame :title = "Все кодексы и наборы правил RULE машины".
     2256       OPEN QUERY br-ruleset FOR EACH X_ruleset NO-LOCK INDEXED-REPOSITION.
     2257     end.
     2258     when "codex" then do:
     2259       frame Dialog-Frame :title = substitute("Все наборы правил для кодекса &1", p-codex-id).
     2260       OPEN QUERY br-ruleset
     2261       FOR EACH X_ruleset NO-LOCK where
     2262              X_ruleset.codex_id = p-codex-id
     2263          and X_ruleset.ruleset_id > 0 INDEXED-REPOSITION.
     2264     end.
     2265     when "only-codex" then do:
     2266       frame Dialog-Frame :title = substitute("Кодексы правил").
     2267       OPEN QUERY br-ruleset FOR EACH X_ruleset NO-LOCK where X_ruleset.ruleset_id = 0 INDEXED-REPOSITION.
     2268     end.
     2269     when "only-ruleset" then do:
     2270       frame Dialog-Frame :title = substitute("Наборы правил").
     2271       OPEN QUERY br-ruleset FOR EACH X_ruleset NO-LOCK where X_ruleset.ruleset_id > 0 INDEXED-REPOSITION.
     2272     end.
     2273   END CASE.
     2274   APPLY "ENTRY" to br-ruleset.
     2275   APPLY "VALUE-CHANGED" to br-ruleset.
     2276   END PROCEDURE.
     2277   PROCEDURE Opentempbr :
     2278   define variable v-call-type as character no-undo .
     2279   case entry(2, p-list-mode, chr(4)):
     2280     when 'dis-card-type':U then do:
     2281       v-call-type = "для типов ДК".
     2282     end.
     2283     when 'clients':U then do:
     2284       v-call-type = "для клиентов".
     2285     end.
     2286     when 'goods':U then do:
     2287       v-call-type = "для товаров".
     2288     end.
     2289     when 'gds-grp':U then do:
     2290       v-call-type = "для групп товаров".
     2291     end.
     2292     when 'cli-grp':U then do:
     2293       v-call-type = "для групп клиентов".
     2294     end.
     2295   end.
     2296   case entry(1, p-list-mode, chr(4)):
     2297     WHEN "profile-type" THEN DO:
     2298       case entry(3, p-list-mode, chr(4)) :
     2299         when "ruleset" then do:
     2300           frame Dialog-Frame :title = SUBSTITUTE("Все наборы правил RULE машины (точки вызова правил) при работе с профайлами &1", v-call-type).
     2301         end.
     2302         when "codex" then do:
     2303           frame Dialog-Frame :title = SUBSTITUTE("Все кодексы правил RULE машины (точки вызова правил) при работе с профайлами &1", v-call-type).
     2304         end.
     2305         when "all" then do:
     2306           frame Dialog-Frame :title = SUBSTITUTE("Все кодексы и наборы правил RULE машины (точки вызова правил) при работе с профайлами &1", v-call-type).
     2307         end.
     2308       end case.
     2309       OPEN QUERY br-temp-ruleset FOR EACH tt-ruleset NO-LOCK INDEXED-REPOSITION.
     2310     end.
     2311   END CASE.
     2312   APPLY "ENTRY" to br-temp-ruleset.
     2313   APPLY "VALUE-CHANGED" to br-temp-ruleset.
     2314   END PROCEDURE.
     2315   PROCEDURE proc-b-link :
     2316   DEFINE INPUT PARAMETER p-option AS CHARACTER NO-UNDO.
     2317   define variable v-rid-list as character no-undo .
     2318   define variable v-ruleset-id as integer no-undo .
     2319   define variable v-codex-id as integer no-undo .
     2320   define buffer buf_rule-by-set for ub.rule-by-set.
     2321   define buffer buf_rule for ub.rule.
     2322   define buffer buf_rule-call-param for ub.rule-call-param.
     2323   case v-browse-mode:
     2324     when "temp" then do:
     2325       assign
     2326       v-ruleset-id = tt-ruleset.ruleset_id
     2327       v-codex-id = tt-ruleset.codex_id
     2328       .
     2329     end.
     2330     otherwise do:
     2331       assign
     2332       v-ruleset-id = X_ruleset.ruleset_id
     2333       v-codex-id = X_ruleset.codex_id
     2334       .
     2335     end.
     2336   end.
     2337   CASE p-option:
     2338     WHEN 'prop-ruleset':U THEN DO:
     2339       run rul/prop-ruleset-s.w ( INPUT parparentproc
     2340                                 ,INPUT "":U
     2341                                 ,INPUT "ruleset"
     2342                                 ,INPUT v-codex-id
     2343                                 ,INPUT v-ruleset-id
     2344                                 ,INPUT 0
     2345                                 ,INPUT-OUTPUT v-rid-list) NO-ERROR.
     2346     END.
     2347     when 'pscript-ruleset':U then do:
     2348       run rul/pscript-ruleset-s.w ( INPUT parparentproc
     2349                                 ,INPUT "":U
     2350                                 ,INPUT "ruleset"
     2351                                 ,INPUT v-codex-id
     2352                                 ,INPUT v-ruleset-id
     2353                                 ,INPUT 0
     2354                                 ,input '':U
     2355                                 ,input '':U
     2356                                 ,INPUT-OUTPUT v-rid-list) NO-ERROR.
     2357     end.
     2358     when 'rule':U then do:
     2359       run rul/rule-by-set-s.w ( INPUT parparentproc
     2360                         ,INPUT "":U
     2361                         ,INPUT "codex"
     2362                         ,INPUT v-codex-id
     2363                         ,input 0
     2364                         ,INPUT 0
     2365                         ,INPUT-OUTPUT v-rid-list) NO-ERROR.
     2366     end.
     2367     when 'rule-by-set':U then do:
     2368       run rul/rule-by-set-s.w ( INPUT parparentproc
     2369                         ,INPUT "":U
     2370                         ,INPUT "ruleset"
     2371                         ,INPUT v-codex-id
     2372                         ,INPUT v-ruleset-id
     2373                         ,input 0
     2374                         ,INPUT-OUTPUT v-rid-list) NO-ERROR.
     2375     end.
     2376     when 'rule-by-profile':U then do:
     2377       run rul/rule-by-profile-s.w ( INPUT parparentproc
     2378                         ,INPUT "":U
     2379                         ,INPUT "ruleset"
     2380                         ,INPUT 0
     2381                         ,INPUT v-codex-id
     2382                         ,INPUT v-ruleset-id
     2383                         ,INPUT 0
     2384                         ,INPUT-OUTPUT v-rid-list) NO-ERROR.
     2385     end.
     2386     when 'rule-call-param':U then do:
     2387       for each tt0-rule-call-param:
     2388         delete tt0-rule-call-param.
     2389       end.
     2390       if v-ruleset-id <> 0 then do:
     2391         for each buf_rule-by-set where
     2392                 buf_rule-by-set.codex_id = v-codex-id
     2393             and buf_rule-by-set.ruleset_id = v-ruleset-id,
     2394             each buf_rule-call-param no-lock where
     2395                 buf_Rule-call-param.rule_id = buf_rule-by-set.rule_id:
     2396           create tt0-rule-call-param.
     2397           buffer-copy buf_rule-call-param to tt0-rule-call-param.
     2398         end.
     2399       end.
     2400       else do:
     2401         for each buf_rule where
     2402                 buf_rule.codex_id = v-codex-id,
     2403             each buf_rule-call-param no-lock where
     2404                 buf_Rule-call-param.rule_id = buf_rule.rule_id:
     2405           create tt0-rule-call-param.
     2406           buffer-copy buf_rule-call-param to tt0-rule-call-param.
     2407         end.
     2408       end.
     2409       run ref/rulercps.w ( INPUT parparentproc
     2410                           ,input this-procedure:handle
     2411                           ,INPUT "":U
     2412                           ,input 'ПРОСМОТР':U
     2413                           ,input 'rule-call-param':U
     2414                           ,input 0
     2415                           ,input ?
     2416                           ,input '':U
     2417                           ,input v-codex-id
     2418                           ,input v-ruleset-id
     2419                           ,input ?
     2420                           ,input 0
     2421                           ,input substitute("Параметры вызова правил: кодекс &1 набор правил &2"
     2422                                             , v-codex-id
     2423                                             , v-ruleset-id)
     2424                           ,input-output table tt0-rule-call-param ) no-error.
     2425     end.
     2426   END CASE.
     2427   END PROCEDURE.
     2428   PROCEDURE refresh :
     2429   if v-browse-mode  = "temp" THEN DO:
     2430       v-doc-rec = recid(tt-ruleset).
     2431       RUn OpentempBR in this-procedure.
     2432       REPOSITION br-temp-ruleset to recid v-doc-rec No-ERROR.
     2433       apply 'value-changed' to br-temp-ruleset in frame Dialog-Frame .
     2434   END.
     2435   ELSE DO:
     2436       v-doc-rec = recid(X_ruleset).
     2437       RUn OpenBR in this-procedure.
     2438       REPOSITION br-ruleset to recid v-doc-rec No-ERROR.
     2439       apply 'value-changed' to br-ruleset in frame Dialog-Frame .
     2440   END.
     2441   END PROCEDURE.
     2442   PROCEDURE set-row-color :
     2443   DEFINE INPUT PARAMETER p-ruleset-id AS INTEGER.
     2444   DEFINE VARIABLE iFGColor AS INTEGER NO-UNDO.
     2445   DEFINE VARIABLE iBGColor AS INTEGER NO-UNDO.
     2446   CASE p-ruleset-id:
     2447     WHEN 0 THEN DO:
     2448     IF p-ruleset-id = 0 THEN DO:
     2449         ASSIGN
     2450           iFGColor = WHITE_COLOR
     2451           iBGColor = DARK_GREEN_COLOR
     2452         .
     2453       end.
     2454       ELSE do:
     2455         ASSIGN
     2456           iFGColor = Black_COLOR
     2457           iBGColor = White_COLOR
     2458         .
     2459       end.
     2460       if v-browse-mode = "temp" then do:
     2461         ASSIGN
     2462         tt-ruleset.name:FGCOLOR IN BROWSE br-temp-ruleset = iFGColor
     2463         tt-ruleset.name:BGCOLOR IN BROWSE br-temp-ruleset = iBGColor
     2464         .
     2465       end.
     2466       else do:
     2467         ASSIGN
     2468         X_ruleset.name:FGCOLOR IN BROWSE br-ruleset = iFGColor
     2469         X_ruleset.name:BGCOLOR IN BROWSE br-ruleset = iBGColor
     2470         .
     2471       end.
     2472     END.
     2473     OTHERWISE DO:
     2474     END.
     2475   END CASE.
     2476   END PROCEDURE.
