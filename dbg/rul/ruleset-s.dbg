      395   FUNCTION mark-string RETURNS CHARACTER
      396     ( input p-recid as recid, input mark-list as character  ) :
      397     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      398   END FUNCTION.
      399   DEFINE VARIABLE v-doc-rec AS RECID NO-UNDO.
      400   DEFINE VARIABLE link-option AS CHARACTER NO-UNDO.
      401   define variable v-rid-list as character no-undo .
      402   define temp-table tt0-rule-call-param no-undo  like ub.rule-call-param.
      403   DEFINE VARIABLE v-browse-mode as character no-undo .
      404   DEFINE MENU MENU-b-links
      405          MENU-ITEM m_prop-ruleset LABEL "Объекты-операнды"
      406          MENU-ITEM m_rule         LABEL "Правила"
      407          MENU-ITEM m_pscript-ruleset LABEL "Скрипты для объектов"
      408          MENU-ITEM m_rule-by-profile LABEL "Правила профайлов"
      409          MENU-ITEM m_rule-call-param LABEL "Параметры вызова правил".
      410   DEFINE BUTTON b-add
      411        LABEL "&Добавить"
      412        SIZE 10 BY 1.
      413   DEFINE BUTTON b-chg
      414        LABEL "&Изменить"
      415        SIZE 10 BY 1.
      416   DEFINE BUTTON b-del
      417        LABEL "&Удалить"
      418        SIZE 10 BY 1.
      419   DEFINE BUTTON B-Help
      420        LABEL "Помо&щь"
      421        SIZE 3 BY 1
      422        BGCOLOR 8 .
      423   DEFINE BUTTON b-links
      424        LABEL "Связи"
      425        SIZE 10 BY 1.
      426   DEFINE BUTTON b-lkp
      427        LABEL "&Просмотр"
      428        SIZE 10 BY 1.
      429   DEFINE BUTTON b-mark
      430        LABEL "&*"
      431        SIZE 4 BY 1.
      432   DEFINE BUTTON b-quit AUTO-END-KEY
      433        LABEL "&Выход"
      434        SIZE 10 BY 1
      435        BGCOLOR 8 .
      436   DEFINE BUTTON b-sel AUTO-GO
      437        LABEL "Выбор"
      438        SIZE 10 BY 1.
      439   DEFINE VARIABLE mark-num AS INTEGER FORMAT "->,>>>,>>9":U INITIAL 0
      440         VIEW-AS TEXT
      441        SIZE 9 BY .67
      442        FGCOLOR 10  NO-UNDO.
      443   DEFINE QUERY br-ruleset FOR
      444         X_ruleset SCROLLING.
      445   DEFINE QUERY br-temp-ruleset FOR
      446         tt-ruleset SCROLLING.
      447   DEFINE BROWSE br-ruleset
      448     QUERY br-ruleset NO-LOCK DISPLAY
      449         mark-string(recid(X_ruleset), v-rid-list) Format "X(1)" COLUMN-LABEL "*"
      450   X_ruleset.codex_id COLUMN-LABEL "Кодекс!правил" FORMAT ">>>>>>>>9"
      451   X_ruleset.ruleset_id COLUMN-LABEL "Набор!правил" FORMAT ">>>>>>>>9"
      452   X_ruleset.name COLUMN-LABEL "Название" FORMAT "X(255)" WIDTH 60
      453       WITH NO-ROW-MARKERS SEPARATORS SIZE 97 BY 20.53 FIT-LAST-COLUMN.
      454   DEFINE BROWSE br-temp-ruleset
      455     QUERY br-temp-ruleset NO-LOCK DISPLAY
      456         tt-ruleset.codex_id COLUMN-LABEL "Кодекс!правил" FORMAT ">>>>>>>>9"
      457   tt-ruleset.ruleset_id COLUMN-LABEL "Набор!правил" FORMAT ">>>>>>>>9"
      458   tt-ruleset.name COLUMN-LABEL "Название" FORMAT "X(255)" WIDTH 60
      459       WITH NO-ROW-MARKERS SEPARATORS SIZE 97 BY 20.53 FIT-LAST-COLUMN.
      460   DEFINE FRAME Dialog-Frame
      461        b-quit AT ROW 1 COL 1
      462        b-mark AT ROW 1 COL 24 WIDGET-ID 12
      463        b-sel AT ROW 1 COL 28 WIDGET-ID 10
      464        b-add AT ROW 1 COL 38 WIDGET-ID 2
      465        b-chg AT ROW 1 COL 48 WIDGET-ID 4
      466        b-del AT ROW 1 COL 58 WIDGET-ID 8
      467        b-lkp AT ROW 1 COL 68 WIDGET-ID 6
      468        b-links AT ROW 1 COL 78 WIDGET-ID 16
      469        B-Help AT ROW 1 COL 95
      470        br-temp-ruleset AT ROW 2.33 COL 1.5 WIDGET-ID 200
      471        br-ruleset AT ROW 2.33 COL 1.5 WIDGET-ID 100
      472        mark-num AT ROW 1 COL 13 COLON-ALIGNED NO-LABEL WIDGET-ID 14
      473        SPACE(74.50) SKIP(21.20)
      474       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      475            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      476            TITLE ""
      477            CANCEL-BUTTON b-quit.
      478   ASSIGN
      479          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      480          FRAME Dialog-Frame:HIDDEN           = TRUE.
      481   ASSIGN
      482          b-links:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-b-links:HANDLE.
      483   ASSIGN
      484          br-temp-ruleset:HIDDEN  IN FRAME Dialog-Frame                = TRUE.
      485   ON GO OF FRAME Dialog-Frame
      486   DO:
      487     p-rid-list = v-rid-list.
      488   END.
      489   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      490   DO:
      491     APPLY "END-ERROR":U TO SELF.
      492   END.
      493   ON CHOOSE OF b-add IN FRAME Dialog-Frame
      494   DO:
      495    define variable v-rec as recid no-undo.
      496     v-rec = recid(X_ruleset).
      497     run rul/ruleset-i.w ( input parparentproc
      498                          ,input 'ДОБАВЛЕНИЕ':U
      499                          ,input 0
      500                          ,input 0
      501                          ,input-output v-rec) no-error.
      502     if v-rec <> ? then do:
      503       RUN openbr IN THIS-PROCEDURE.
      504       reposition br-ruleset to recid v-rec no-error.
      505       apply "Entry" to br-ruleset.
      506     end.
      507   END.
      508   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
      509   DO:
      510     define variable v-rec as recid no-undo.
      511     if not available X_ruleset then return no-apply.
      512     v-rec = recid(X_ruleset).
      513     run rul/ruleset-i.w ( input parparentproc
      514                          ,input 'ИЗМЕНЕНИЕ':U
      515                          ,input X_ruleset.codex_id
      516                          ,input X_ruleset.ruleset_id
      517                          ,input-output v-rec) no-error.
      518     if v-rec <> ? then do:
      519        br-ruleset:refresh().
      520     end.
      521   END.
      522   ON CHOOSE OF b-del IN FRAME Dialog-Frame
      523   DO:
      524     define variable v-rec as recid no-undo.
