     1114           if  v-object-handle <> v-diasize-browse-handle :handle
     1115           and can-query(v-object-handle, "row")
     1116           and can-query(v-object-handle, "height")
     1117           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1118           then do:
     1119             find first buf_temp-browse-handle
     1120               where buf_temp-browse-handle.browse-type   = 'height':u
     1121                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1122               no-error .
     1123             if available buf_temp-browse-handle
     1124             then do:
     1125             end.
     1126             else do:
     1127               create buf_temp-diasize-handle .
     1128               assign
     1129                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1130                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1131               .
     1132             end.
     1133           end.
     1134           assign
     1135             v-object-handle = v-object-handle :next-sibling
     1136           .
     1137         end.
     1138         assign
     1139           v-field-group-handle = v-field-group-handle :next-sibling
     1140         .
     1141       end.
