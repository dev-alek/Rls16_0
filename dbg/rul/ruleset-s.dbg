      588   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
      589   DO:
      590       define variable glog as logical no-undo .
      591     if available X_ruleset then do:
      592   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      593   define variable v-str-recid5 as character no-undo .
      594   define variable v-num-entry5 as integer   no-undo .
      595   assign
      596     v-str-recid5 = trim( string( recid( X_ruleset ) , "->>>>>>>>>>>9":U ) )
      597     v-num-entry5 = lookup( v-str-recid5 , v-rid-list )
      598   .
      599   if v-num-entry5 > 0 then do:
      600     assign
      601       entry( v-num-entry5, v-rid-list ) = "":U
      602       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
      603     .
      604   end.
      605   else do:
      606     assign
      607       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid5
      608     .
      609   end.
      610     glog = br-ruleset:refresh() .
