     3933   function context_begin-esys-command return logical
     3934   (
     3935       input p-esys-id-list as character
     3936      ,input-output p-esys-cmd-proc-handle as handle
     3937      ,output p-esys-cmd-code as integer
     3938   ):
     3939      if not valid-handle(p-esys-cmd-proc-handle )
     3940      then do:
     3941        run nws/cmd-bush.p persistent set p-esys-cmd-proc-handle no-error .
     3942        if error-status :error
     3943        then do:
     3944           delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( substitute("&1 &2 &3&4Ошибка при запуске процедуры cmd-bush.p&4" +
     3945                                              "&5&4&6"
     3946                                              ,vss-workfile
     3947                                              ,vss-revision
     3948                                              ,vss-description
     3949                                              ,chr(10)
     3950                                              ,error-status:get-message(1)
     3951                                              ,return-value )).
