     4080   procedure send-stat_contour :
     4081     define input parameter p-doc-type as character no-undo .
     4082     define input parameter p-state as character no-undo .
     4083     define input parameter p-stage as character no-undo .
     4084     define input parameter p-description as character no-undo .
     4085     define input parameter p-messID as character no-undo .
     4086     define variable v-ii as integer no-undo .
     4087     define variable v-uniq-key-rec as character no-undo .
     4088     define variable v-cli-uniq-key-rec as character no-undo .
     4089     define variable v-err as logical no-undo .
     4090     define variable v-custom-pack-name as character no-undo .
     4091     define variable v-success as logical   no-undo .
     4092     DEFINE VARIABLE v-today as date no-undo .
     4093     DEFINE VARIABLE v-time as integer no-undo .
     4094     define variable v-ord-int1 as integer no-undo .
     4095     define variable v-obj-gln as character no-undo .
     4096     define variable v-cli-gln as character no-undo .
     4097     define variable v-gln-net as character no-undo .
     4098     define variable v-type as character no-undo .
     4099     define variable v-mess as character no-undo .
     4100     define variable v-b-code as integer no-undo .
     4101     define variable v-b-str as character no-undo .
     4102     define variable v-jj as integer   no-undo .
     4103     define variable v-cli-base-rate as decimal no-undo .
     4104     define variable v-dump-ord-int64 as int64 no-undo .
     4105     define variable v-rcv-code as character no-undo .
     4106     define variable v-cli-rcv-code as character no-undo .
     4107     define variable v-EDIINTERCHANGEID as character no-undo .
     4108     define variable v-edist-mess as character no-undo .
     4109     define variable v-date-status as character no-undo .
     4110     define variable v-time-status as integer no-undo .
     4111     define variable v-error as character no-undo .
     4112     define variable v-stringdate as character no-undo .
     4113     define variable v-documentNumber as character no-undo .
     4114     define variable v-documentDate as character no-undo .
     4115     define variable sw as handle no-undo .
     4116     define buffer buf_ext-system for ub.ext-system.
     4117     define buffer buf_ord-doc for ub.ord-doc.
     4118     define buffer buf_ord-line for ub.ord-line.
     4119     define buffer buf_object for ub.clients.
     4120     define buffer buf_clients for ub.clients.
     4121     define buffer buf_ext-classif for ub.ext-classif.
     4122     define buffer esys_ext-classif for ub.ext-classif.
     4123     define buffer buf_goods for ub.goods.
     4124     define buffer buf_ord-doc-rcv for ub.ord-doc-rcv.
     4125     define buffer buf_currency for ub.currency.
     4126     define buffer buf_ord-line-attr for ub.ord-line-attr.
     4127     define buffer buf_edi-status for ub.edi-status.
     4128   _main:
     4129   do
     4130   on error undo, return error substitute( "&1&2&3&2&4", return-value, chr(10), error-status :get-message (1), v-last-error-message)
     4131   on stop undo, return error substitute( "&1&2&3&2&4", return-value, chr(10), error-status :get-message (1), v-last-error-message)
     4132   :
     4133     if retry then do:
     4134           .
     4135       undo _main, return error.
     4136     end.
     4137     else do:
     4138       assign
     4139       v-mess = ''
     4140       .
     4141       find first buf_ord-doc exclusive-lock where
     4142                 buf_ord-doc.doc-code = v-current-doc-code no-error .
     4143       if not available buf_ord-doc then do:
     4144         v-mess = substitute("Не найден заказ для поставки").
     4145         v-err = yes.
     4146         undo _main, retry _main.
     4147       end.
     4148       if p-doc-type = "DESADV" then do :
     4149           find first buf_ord-doc-rcv no-lock where buf_ord-doc-rcv.doc-code = v-current-doc-code no-error .
     4150           if available buf_ord-doc-rcv then assign v-rcv-code = buf_ord-doc-rcv.rcv-code .
     4151       end.
     4152       find first buf_clients no-lock where
     4153                 buf_clients.obj-type = buf_ord-doc.cli-type
     4154             and buf_clients.obj-code = buf_ord-doc.cli-code no-error.
     4155       if not available buf_clients then do:
     4156         v-mess =  substitute("Не найден контрагент &1&2", buf_ord-doc.cli-type, buf_ord-doc.cli-code).
     4157         v-err = yes.
     4158         undo _main, retry _main.
     4159       end.
     4160       run gen-key-rec in this-procedure ( input 'clients':U
     4161                                         ,input (buffer buf_clients:handle)
     4162                                         ,output v-cli-uniq-key-rec) no-error .
     4163       if error-status:error then do:
     4164         v-mess = substitute("gen-key-rec: &1&2&3&2(&4&5)"
     4165                                   , error-status:get-message(1)
     4166                                   , return-value
     4167                                   , chr(10)
     4168                                   , buf_ord-doc.cli-type
     4169                                   , buf_ord-doc.cli-code).
     4170         v-err = yes.
     4171         undo _main, retry _main.
     4172       end.
     4173       find first esys_ext-classif no-lock where
     4174           esys_ext-classif.classif-name = 'exite-edi':U
     4175       and esys_ext-classif.classif-subject = 'clients':U
     4176       and esys_ext-classif.db-num = -1
     4177       and esys_Ext-classif.uniq-key-rec = v-cli-uniq-key-rec no-error .
     4178       if not available esys_ext-classif then do:
     4179         v-mess = substitute("Поставщик &1&2 заказа НЕ РАБОТАЕТ ПО СИСТЕМЕ EDI", buf_ord-doc.cli-type, buf_ord-doc.cli-code).
     4180         v-err = yes.
     4181         undo _main, retry _main.
     4182       end.
     4183       find first buf_object no-lock where
     4184                 buf_object.obj-type = v-current-obj-type
     4185             and buf_object.obj-code = v-current-obj-code no-error.
     4186       if not available buf_object then do:
     4187         v-mess =  substitute("Не найден объект &1&2", v-current-obj-type, v-current-obj-code).
     4188         v-err = yes.
     4189         undo _main, retry _main.
     4190       end.
     4191       run gen-key-rec in this-procedure ( input 'clients':U
     4192                                         ,input (buffer buf_object:handle)
     4193                                         ,output v-uniq-key-rec) no-error .
     4194       if error-status:error then do:
     4195         v-mess =  substitute("gen-key-rec: &1&2&3&2(&4&5)"
     4196                                   , error-status:get-message(1)
     4197                                   , return-value
     4198                                   , chr(10)
     4199                                   , buf_object.obj-type
     4200                                   , buf_object.obj-code).
     4201         v-err = yes.
     4202         undo _main, retry _main.
     4203       end.
     4204       assign
     4205       v-obj-gln = get-gln( input buf_object.obj-type
     4206                       ,input buf_object.obj-code) no-error.
     4207       if error-status:error
     4208       or v-obj-gln = chr(63)
     4209       or v-obj-gln = '' then do:
     4210         v-mess =  substitute("Не определен GLN для &1&2"
     4211                                   , buf_object.obj-type
     4212                                   , buf_object.obj-code) .
     4213         v-err = yes.
     4214         undo _main, retry _main.
     4215       end.
     4216       v-cli-gln = get-gln( input buf_ord-doc.cli-type
     4217                           ,input buf_ord-doc.cli-code) no-error.
     4218       if error-status:error
     4219       or v-cli-gln = chr(63)
     4220       or v-cli-gln = '' then do:
     4221         v-mess =  substitute("Не определен GLN для &1&2"
     4222                                   , buf_object.obj-type
     4223                                   , buf_object.obj-code) .
     4224         v-err = yes.
     4225         undo _main, retry _main.
     4226       end.
     4227       for each esys_ext-classif no-lock where
     4228           esys_ext-classif.classif-name = 'exite-edi':U
     4229       and esys_ext-classif.classif-subject = 'clients':U
     4230       and esys_ext-classif.db-num = -1
     4231       and esys_Ext-classif.uniq-key-rec = v-cli-uniq-key-rec,
     4232         first buf_ext-system no-lock where
     4233                   buf_ext-system.esys-id = esys_ext-classif.key#_one
     4234               and buf_ext-system.db-num = 0
     4235               and buf_ext-system.esys-have-export = yes,
     4236         first buf_ext-classif no-lock where
     4237           buf_ext-classif.classif-name = 'exite-edi':U
     4238       and buf_ext-classif.classif-subject = 'clients':U
     4239       and buf_ext-classif.db-num = -1
     4240       and buf_Ext-classif.uniq-key-rec = v-uniq-key-rec
     4241       and buf_Ext-classif.key#_one = esys_ext-classif.key#_one:
     4242         leave.
     4243       end.
     4244       if not available buf_ext-system then do:
     4245         v-mess = substitute("Для поставщика &1&2 не найдена ВС, у которой есть экспорт в текущей БД").
     4246         v-err = yes.
     4247         undo _main, retry _main.
     4248       end.
     4249       run ext-system-attr-value in this-procedure ( input buf_ext-system.esys-id
     4250                                                    ,input buf_ext-system.db-num
     4251                                                    ,input 'gln-net':U
     4252                                                    ,output v-gln-net
     4253                                                    ,output v-type) no-error.
     4254       IF  context_begin-esys-command( input string(buf_ext-system.esys-id), input-output v-esys-cmd-proc-handle, output v-esys-cmd-code) = false  THEN do:
     4255         undo _main, return error v-last-error-message .
     4256       end.
     4257       v-stringdate = substring(string(NOW), 7, 4) + substring(string(NOW), 4, 2) + substring(string(NOW), 1, 2)
     4258                    + substring(string(NOW), 12, 2) + substring(string(NOW), 15, 2) + substring(string(NOW), 18, 2).
     4259       v-custom-pack-name = p-state + "_" + v-stringdate + "_" + p-doc-type + "_" + buf_ord-doc.doc-code + "_&pack-num.xml".
     4260       if p-doc-type = "ORDRSP" then do :
     4261           if p-stage = "Read" then
     4262           assign
     4263               v-documentNumber = entry(1, v-cli-out-doc, chr(4))
     4264               v-documentDate = entry(2, v-cli-out-doc, chr(4))
     4265           .
     4266           else
     4267           assign
     4268               v-documentNumber = entry(1, buf_ord-doc.cli-out-doc, chr(4))
     4269               v-documentDate = entry(2, buf_ord-doc.cli-out-doc, chr(4))
     4270           .
     4271           for each buf_edi-status no-lock where
     4272                   buf_edi-status.tbl-name = 'ord-doc':U
     4273              and buf_edi-status.doc-code = v-current-doc-code
     4274              and (buf_edi-status.state = '1':U or buf_edi-status.state = '12':U or buf_edi-status.state = '6':U or buf_edi-status.state = '3':U)
     4275              and buf_edi-status.err-code < 3 :
     4276             assign
     4277               v-EDIINTERCHANGEID = cr-edist_get-mess-key-value(buf_edi-status.mess, 'ediiterchangeid':U)
     4278             .
     4279             if v-EDIINTERCHANGEID <> ? and trim(v-EDIINTERCHANGEID) <> "" then leave .
     4280           end.
     4281           for each temp-edi-status no-lock where
     4282                   temp-edi-status.tbl-name = 'ord-doc':U
     4283              and temp-edi-status.doc-code begins v-current-doc-code :
     4284             assign
     4285               v-error = v-error +
     4286                              (if v-error = '' then ''
     4287                               else if trim(cr-edist_get-error-mean(input temp-edi-status.des-err) ) begins "Арт." then chr(30)
     4288                               else if r-index(v-error, ";") = length(v-error) then ''
     4289                               else ';')
     4290                                +
     4291                               if (cr-edist_get-error-mean(input temp-edi-status.des-err) ) begins "Инф:" then ""
     4292                               else cr-edist_get-error-mean(input temp-edi-status.des-err)
     4293             .
     4294           end.
     4295           for each temp-edi-status no-lock where
     4296                   temp-edi-status.tbl-name = 'ord-line':U
     4297              and temp-edi-status.doc-code begins v-current-doc-code :
     4298             assign
     4299               v-error = v-error +
     4300                              (if v-error = '' then ''
     4301                               else if trim(cr-edist_get-error-mean(input temp-edi-status.des-err) ) begins "Арт." then chr(30)
     4302                               else if r-index(v-error, ";") = length(v-error) then ''
     4303                               else ';')
     4304                                +
     4305                               if (cr-edist_get-error-mean(input temp-edi-status.des-err) ) begins "Инф:" then ""
     4306                               else cr-edist_get-error-mean(input temp-edi-status.des-err)
     4307             .
     4308           end.
     4309       end.
     4310       if p-doc-type = "DESADV" then do :
     4311           assign
     4312               v-documentNumber = v-desadv-DELIVERYNOTENUMBER
     4313               v-documentDate = iso-date(v-desadv-DELIVERYNOTEDATE)
     4314           .
     4315           for each buf_edi-status no-lock where
     4316                   buf_edi-status.tbl-name = 'ord-doc-rcv':U
     4317              and buf_edi-status.doc-code = v-rcv-code
     4318              and buf_edi-status.state = '8':U
     4319              and buf_edi-status.err-code < 3 :
     4320             assign
     4321             v-EDIINTERCHANGEID = cr-edist_get-mess-key-value(buf_edi-status.mess, 'ediiterchangeid':U).
     4322             if v-EDIINTERCHANGEID <> ? and trim(v-EDIINTERCHANGEID) <> "" then leave .
     4323           end.
     4324           for each temp-edi-status no-lock where
     4325                   temp-edi-status.tbl-name = 'ord-doc':U
     4326              and temp-edi-status.doc-code begins v-current-doc-code :
     4327             assign
     4328               v-error = v-error +
     4329                              (if v-error = '' then ''
     4330                               else if trim(cr-edist_get-error-mean(input temp-edi-status.des-err) ) begins "Арт." then chr(30)
     4331                               else if r-index(v-error, ";") = length(v-error) then ''
     4332                               else ';')
     4333                                +
     4334                               if (cr-edist_get-error-mean(input temp-edi-status.des-err) ) begins "Инф:" then ""
     4335                               else cr-edist_get-error-mean(input temp-edi-status.des-err)
     4336             .
     4337           end.
     4338           for each temp-edi-status no-lock where
     4339                   temp-edi-status.tbl-name = 'ord-line':U
     4340              and temp-edi-status.doc-code begins v-current-doc-code :
     4341             assign
     4342               v-error = v-error +
     4343                              (if v-error = '' then ''
     4344                               else if trim(cr-edist_get-error-mean(input temp-edi-status.des-err) ) begins "Арт." then chr(30)
     4345                               else if r-index(v-error, ";") = length(v-error) then ''
     4346                               else ';')
     4347                                +
     4348                               if (cr-edist_get-error-mean(input temp-edi-status.des-err) ) begins "Инф:" then ""
     4349                               else cr-edist_get-error-mean(input temp-edi-status.des-err)
     4350             .
     4351           end.
     4352           for each temp-edi-status no-lock where
     4353                   temp-edi-status.tbl-name = 'ord-doc-rcv':U
     4354              and temp-edi-status.doc-code begins v-rcv-code :
     4355             assign
     4356               v-error = v-error +
     4357                              (if v-error = '' then ''
     4358                               else if trim(cr-edist_get-error-mean(input temp-edi-status.des-err) ) begins "Арт." then chr(30)
     4359                               else if r-index(v-error, ";") = length(v-error) then ''
     4360                               else ';')
     4361                                +
     4362                               if (cr-edist_get-error-mean(input temp-edi-status.des-err) ) begins "Инф:" then ""
     4363                               else cr-edist_get-error-mean(input temp-edi-status.des-err)
     4364             .
     4365           end.
     4366           for each temp-edi-status no-lock where
     4367                   temp-edi-status.tbl-name = 'ord-line-rcv':U
     4368              and temp-edi-status.doc-code begins v-rcv-code :
     4369             assign
     4370               v-error = v-error +
     4371                              (if v-error = '' then ''
     4372                               else if trim(cr-edist_get-error-mean(input temp-edi-status.des-err) ) begins "Арт." then chr(30)
     4373                               else if r-index(v-error, ";") = length(v-error) then ''
     4374                               else ';')
     4375                                +
     4376                               if (cr-edist_get-error-mean(input temp-edi-status.des-err) ) begins "Инф:" then ""
     4377                               else cr-edist_get-error-mean(input temp-edi-status.des-err)
     4378             .
     4379           end.
     4380       end.
     4381       if v-EDIINTERCHANGEID <> ? and v-EDIINTERCHANGEID <> "" and p-messID = ? then p-messID = v-EDIINTERCHANGEID .
     4382       if p-messID = ? then p-messID = "" .
     4383       create sax-writer sw .
     4384       sw:formatted = true.
     4385       sw:set-output-destination ("memptr", v-DATA).
     4386       sw:encoding = "UTF-8".
     4387       sw:start-document () .
     4388       sw:start-element ("statusReport") .
     4389           sw:write-data-element ("reportDateTime", substring(iso-date(NOW), 1, 23) + "Z") .
     4390           sw:write-data-element ("reportRecipient", v-cli-gln) .
     4391           sw:start-element ("reportItem") .
     4392               sw:write-data-element ("messageId", p-messID) .
     4393               sw:write-data-element ("documentId", p-messID) .
     4394               sw:write-data-element ("messageSender", v-cli-gln) .
     4395               sw:write-data-element ("messageRecepient", v-gln-net) .
     4396               sw:write-data-element ("documentType", p-doc-type) .
     4397               sw:write-data-element ("documentNumber", v-documentNumber) .
     4398               sw:write-data-element ("documentDate", v-documentDate) no-error .
     4399               sw:start-element ("statusItem") .
     4400                   sw:write-data-element ("dateTime", substring(iso-date(NOW), 1, 23) + "Z") .
     4401                   sw:write-data-element ("stage", p-stage) .
     4402                   sw:write-data-element ("state", p-state) .
     4403                   sw:write-data-element ("description", p-description) .
     4404                   if p-stage = "Checking" and p-state = "Ok" and p-description = "Сообщение отклонено на стороне получателя" then
     4405                   do :
     4406                       sw:write-data-element ("error", "Заказ УЖЕ в статусе Подтвержден или ПодтвержденОК") .
     4407                   end.
     4408                   else if p-stage = "Checking" and p-state = "Fail" and p-doc-type = "DESADV" and p-description = "Сообщение отклонено на стороне получателя в УБД" then
     4409                   do :
     4410                       sw:write-data-element ("error", "Поставка уже в работе в УБД") .
     4411                   end.
     4412                   else if p-state = "Fail" then
     4413                   do :
     4414                       v-error = replace(v-error, chr(4), " ") .
     4415                       v-error = replace(v-error, ";", "; ") .
     4416                       if trim(v-error) <> "" then
     4417                       do v-ii = 1 to num-entries(v-error, chr(30) ):
     4418                           if trim(entry(v-ii, v-error, chr(30) )) <> "" then
     4419                           sw:write-data-element ("error", trim(entry(v-ii, v-error, chr(30)))) .
     4420                       end.
     4421                   end.
     4422                   else do :
     4423                   end.
     4424               sw:end-element ("statusItem") .
     4425           sw:end-element ("reportItem") .
     4426       sw:end-element ("statusReport") .
     4427       sw:end-document () .
     4428       delete object sw.
     4429       IF ExpData1:esys-add-dump-data ( INPUT v-DATA, INPUT v-esys-cmd-proc-handle, INPUT v-esys-cmd-code, '+update') = false  THEN do:
     4430         undo _main, return error v-last-error-message .
     4431       end.
     4432       IF  context_set-custom-esys-pck-name(  input v-esys-cmd-proc-handle, input v-esys-cmd-code, input v-custom-pack-name) = false  THEN do:
     4433         undo _main, return error v-last-error-message .
     4434       end.
     4435       v-dump-ord-int64 = context_send-esys-command( input string(buf_ext-system.esys-id), input v-esys-cmd-proc-handle, input v-esys-cmd-code, input g#userid).
     4436       if v-dump-ord-int64 = 0 THEN do:
     4437         undo _main, return error v-last-error-message .
     4438       end.
     4439       v-edist-mess = ''.
     4440       v-edist-mess = cr-edist_add-edist-mess( v-edist-mess, 'route':U, string(v-dump-ord-int64)).
     4441       v-date-status = ?.
     4442       run create-edi-state in this-procedure (
     4443                                               input 'ord-doc-rcv':U
     4444                                             , input v-rcv-code
     4445                                             , input buf_ord-doc.cli-type
     4446                                             , input buf_ord-doc.cli-code
     4447                                             , input 'ИЗМЕНЕНИЕ':U
     4448                                             , input buf_ord-doc.ord-int1
     4449                                             , input integer('0':U)
     4450                                             , input buf_ord-doc.PS
     4451                                             , input v-edist-mess
     4452                                             , input integer('2':U)
     4453                                             , input-output v-date-status
     4454                                             , input-output v-time-status
     4455                                             ).
     4456           ExpData1:Route-data_clear-data ( ) .
     4457     end.
     4458   end.
     4459   end procedure.
     4460     define variable p-xsd-file as character no-undo.
     4461   on delete of this-procedure do:
     4462     run delete-procedure in this-procedure .
     4463   end.
     4464   run load-ruleset-context in this-procedure ( input p-ruleset-id) no-error .
     4465   if error-status:error
     4466   or return-value = "return" then return.
     4467   if not this-procedure:persistent then do:
     4468     run proc-main in this-procedure  no-error .
     4469     if error-status:error then do:
     4470         v-esm = error-status :get-message (1).
     4471         v-es = error-status:error .
     4472         v-rv = return-value .
     4473         run delete-procedure in this-procedure .
     4474               run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute( "&1. &2&3&4", vss-workfile, v-rv, chr(10), v-esm)).                      assign v-view-log = yes.
     4475         undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     4476     end.
     4477     run delete-procedure in this-procedure .
     4478   end.
     4479   procedure proc-main :
     4480   define variable v-ii as integer   no-undo .
     4481   define variable v-mess as character no-undo .
     4482   define variable v-doc-uniq-key-rec as character no-undo .
     4483   define variable v-tbl-row as rowid no-undo .
     4484   define variable v-tbl-name as character no-undo .
     4485   define variable v-trn-code as character no-undo .
     4486   define variable v-dump-ord-int64 as int64 no-undo .
     4487   define variable v-trn-doc as character no-undo .
     4488   define variable v-new-ps as character no-undo .
     4489   define variable v-new-st as integer no-undo .
     4490   define variable v-cli-out-doc as character no-undo .
     4491   define variable v-edist-mess as character no-undo .
     4492   define variable v-cli-type as character no-undo .
     4493   define variable v-cli-code as integer no-undo .
     4494   define variable v-date-status as date no-undo .
     4495   define variable v-time-status as integer no-undo .
     4496   define variable v-transport-cli-type as character no-undo .
     4497   define variable v-transport-cli-code as integer no-undo .
     4498   define variable v-transport-type-code as logical no-undo .
     4499   DEFINE VARIABLE v-today as date no-undo .
     4500   DEFINE VARIABLE v-time as integer no-undo .
     4501   define variable v-crc-pack as character no-undo .
     4502   define buffer buf_clients for ub.clients.
     4503   define buffer buf_ord-doc for ub.ord-doc.
     4504   define buffer buf_ord-chain for ub.ord-chain.
     4505   define buffer buf_ord-doc-rcv for ub.ord-doc-rcv.
     4506   define buffer buf_trn-doc for ub.trn-doc.
     4507   define buffer buf_ext-classif for ub.ext-classif.
     4508   _desadv:
     4509   do transaction
     4510   on error  undo _desadv, retry _desadv
     4511   on stop   undo _desadv, retry _desadv
     4512   on endkey undo _desadv, retry _desadv
     4513   :
     4514     if retry then do:
     4515       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при импорте поставок по  заказу &1 из ВС &2&3&4"                                 ,v-current-doc-code                                 , v-esys-id                                  , chr(10)                                 , v-mess)).                      assign v-view-log = yes.
     4516       assign
     4517       v-view-log = yes.
     4518       undo _desadv, return error.
     4519     end.
     4520     else do:
     4521   run write-log  in p-log-handle (
     4522                                    input 0
     4523                                  , "&DLine").
     4524     run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute(".............Импорт поставок из ВС")).                      assign v-view-log = yes.
     4525       find first desadv.
     4526       num-rec = num-rec + 1.
     4527       find first buf_ord-doc exclusive-lock where
     4528                 buf_ord-doc.doc-code = desadv.ordernumber no-error.
     4529       if not available buf_ord-doc then do:
     4530         v-mess =  substitute("Не найден заказ поставщику с номером &1", desadv.ordernumber).
     4531         assign v-view-log = yes.
     4532         undo _desadv, retry _desadv.
     4533       end.
     4534       assign
     4535       v-current-doc-code = buf_ord-doc.doc-code
     4536       v-cli-type = buf_ord-doc.cli-type
     4537       v-cli-code = buf_ord-doc.cli-code
     4538       .
     4539       find first ub.ord-rcv-attr no-lock
     4540            where ub.ord-rcv-attr.doc-code = buf_ord-doc.doc-code
     4541              and ub.ord-rcv-attr.attr-code = 'nids':U
     4542              and ub.ord-rcv-attr.attr-value = v-desadv-DELIVERYNOTENUMBER no-error.
     4543       if available ub.ord-rcv-attr then do :
     4544           find first buf_ord-doc-rcv no-lock
     4545                where buf_ord-doc-rcv.doc-code = buf_ord-doc.doc-code
     4546                  and buf_ord-doc-rcv.rcv-code = ub.ord-rcv-attr.rcv-code no-error .
     4547           if available buf_ord-doc-rcv then do :
     4548               find first buf_ord-chain   no-lock where
     4549                          buf_ord-chain.doc-code = buf_ord-doc-rcv.rcv-code
     4550                      and buf_ord-chain.rel-doc-type = "trn"
     4551                      and buf_ord-chain.doc-type = "rcv" no-error .
     4552               if available buf_ord-chain then do :
     4553                   find first buf_trn-doc no-lock where
     4554                              buf_trn-doc.doc-code = buf_ord-chain.rel-doc-code  no-error .
     4555                   if available buf_trn-doc then do :
     4556                       v-edist-mess = ''.
     4557                       v-edist-mess = cr-edist_add-edist-mess( v-edist-mess, 'ps':U, "Поставка уже в работе" ).
     4558                       v-date-status = ?.
     4559                       run create-edi-statett in this-procedure (
     4560                                                             input 'ord-doc':U
     4561                                                           , input buf_ord-doc.doc-code
     4562                                                           , input buf_ord-doc.cli-type
     4563                                                           , input buf_ord-doc.cli-code
     4564                                                           , input 'ИЗМЕНЕНИЕ':U
     4565                                                           , input buf_ord-doc.ord-int1
     4566                                                           , input integer('0':U)
     4567                                                           , input v-edist-mess
     4568                                                           , input ""
     4569                                                           , input integer('2':U)
     4570                                                           ).
     4571                       run send-stat_contour ( input "DESADV"
     4572                                              ,input "Fail"
     4573                                              ,input "Checking"
     4574                                              ,input "Сообщение отклонено на стороне получателя"
     4575                                              ,input desadv.id) .
     4576                                           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при импорте поставки по заказу &1 из ВС &2&3Поставка уже в работе"                                             ,v-current-doc-code                                             , v-esys-id                                              , chr(10))).                      assign v-view-log = yes.
     4577                       assign
     4578                       v-view-log = yes.
     4579                       return substitute("Ошибка при импорте поставки по заказу &1 из ВС &2&3Поставка уже в работе"                                             ,v-current-doc-code                                             , v-esys-id                                              , chr(10)).
     4580                   end.
     4581               end.
     4582           end.
     4583       end.
     4584       v-ediinterchangeid = desadv.id.
     4585       assign
     4586       glog = status-is-edi ( input yes
     4587                           , input buf_ord-doc.cli-type
     4588                           , input buf_ord-doc.cli-code
     4589                           , input buf_ord-doc.obj-type
     4590                           , input buf_ord-doc.obj-code
     4591                           , output v-dm-edi
     4592                           ) no-error.
     4593       if not glog = yes then do:
     4594         v-mess = substitute("Нет обмена Документами по EDI для поставщика &1&2 и &3&4 в БД &5)"
     4595                           , buf_ord-doc.cli-type
     4596                           , buf_ord-doc.cli-code
     4597                           , buf_ord-doc.obj-type
     4598                           , buf_ord-doc.obj-code
     4599                           , g#db-num).
     4600         undo _desadv, retry _desadv.
     4601       end.
     4602       assign
     4603       v-transport-type-code = get-type-code-from-gln ( input desadv.shipFrom_gln
     4604                                                       , output v-transport-cli-type
     4605                                                       , output v-transport-cli-code
     4606                                                       ) no-error.
     4607       run edocsord_edi-import in this-procedure (
     4608                                               buffer buf_ord-doc
     4609                                             ,input buf_ord-doc.cli-out-doc
     4610                                             ,input desadv.desadvNumber + chr(4) +
     4611                                                     string(date(substring(desadv.desadvDate, 9, 2) + "/" + substring(desadv.desadvDate, 6, 2) + "/" + substring(desadv.desadvDate, 1, 4)), "99/99/9999") +
     4612                                                     (if v-transport-type-code then (chr(4) + substitute("&1&2", v-transport-cli-type,
     4613                                                                                                                       v-transport-cli-code ))
     4614                                                                             else "" )
     4615                                             ,input integer('8':U)
     4616                                             ,input (if desadv.estimatedDeliveryDateTime = ? or desadv.estimatedDeliveryDateTime = ""
     4617                                                     then buf_ord-doc.ship-date
     4618                                                     else date(substring(desadv.estimatedDeliveryDateTime, 9, 2) + "/" + substring(desadv.estimatedDeliveryDateTime, 6, 2) + "/" + substring(desadv.estimatedDeliveryDateTime, 1, 4))
     4619                                                     )
     4620                                             ,input buf_ord-doc.ps
     4621                                             ,input v-pack-num-chr
     4622                                             ,input v-ediinterchangeid
     4623                                             ,output v-new-ps
     4624                                             ,output v-new-st
     4625                                             ) no-error.
     4626       if error-status:error then do:
     4627         if return-value <> '' then do:
     4628           v-mess = substitute("Ошибка при изменении статуса заказа при приеме данных:&1&2", chr(10), return-value ).
     4629           undo _desadv, retry _desadv.
     4630         end.
     4631       end.
     4632       else do:
     4633         if v-new-st = ? then do:
     4634           define variable v-tmp-file as character no-undo .
     4635           run gbl/_tmpfile.p ( input "mes":U  , input ".txt":U, output v-tmp-file ).
     4636           COPY-LOB  FROM OBJECT cr-edist_full-mess
     4637           TO FILE v-tmp-file NO-ERROR.
     4638           cr-edist_full-mess = ''.
     4639           run send-msg-to-email in parparentproc
     4640               ( input substitute( "ТН БД &1. Ошибка EDI при импорте пакета &2 из ВС &3"
     4641                                   , g#db-num
     4642                                   , v-pack-num-chr
     4643                                   , v-esys-id )
     4644               ,input substitute("Пакет принят без сохранения данных в БД. См. EDI-информацию по заказу &1&2"
     4645                                 , buf_ord-doc.doc-code
     4646                                 , chr(10)
     4647                                 )
     4648               ,input v-tmp-file
     4649               ) no-error .
     4650           os-delete value(v-tmp-file).
     4651         end.
     4652         v-rv = return-value .
     4653         v-edist-mess = ''.
     4654         v-edist-mess = cr-edist_add-edist-mess( v-edist-mess, 'pack-num':U, "->" + v-pack-num-chr ).
     4655         v-edist-mess = cr-edist_add-edist-mess( v-edist-mess, 'ediiterchangeid':U, desadv.id ).
     4656         v-date-status = ?.
     4657         run create-edi-state in this-procedure (
     4658                                                 input 'ord-doc':U
     4659                                               , input buf_ord-doc.doc-code
     4660                                               , input buf_ord-doc.cli-type
     4661                                               , input buf_ord-doc.cli-code
     4662                                               , input 'ИЗМЕНЕНИЕ':U
     4663                                               , input (if v-new-st = ? then -1 else buf_ord-doc.ord-int1)
     4664                                               , input (if v-new-st = ?
     4665                                                        then  integer('4':U)
     4666                                                        else integer('0':U))
     4667                                               , input buf_ord-doc.PS
     4668                                               , input v-edist-mess
     4669                                               , input integer('2':U)
     4670                                               , input-output v-date-status
     4671                                               , input-output v-time-status
     4672                                               ).
     4673         if v-new-st = ? then do:
     4674                   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input v-rv).                      assign v-view-log = yes.
     4675         end.
     4676         _edist:
     4677         for each temp-edi-status
     4678         on error  undo _edist, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4679         on stop   undo _edist, return error substitute( "&1. stop", vss-workfile )
     4680         on endkey undo _edist, return error substitute( "&1. endkey", vss-workfile )
     4681         :
     4682           v-edist-mess = temp-edi-status.mess.
     4683           v-edist-mess = cr-edist_add-edist-mess( v-edist-mess, 'pack-num':U, "->" + v-pack-num-chr ).
     4684           v-edist-mess = cr-edist_add-edist-mess( v-edist-mess, 'ediiterchangeid':U, desadv.id ).
     4685           run create-edi-state in this-procedure (
     4686                                                   input temp-edi-status.tbl-name
     4687                                                 , input (if temp-edi-status.tbl-name = 'ord-line-rcv':U
     4688                                                         then v-new-ps
     4689                                                         else temp-edi-status.doc-code)
     4690                                                 , input temp-edi-status.cli-type
     4691                                                 , input temp-edi-status.cli-code
     4692                                                 , input temp-edi-status.act
     4693                                                 , input (if v-new-st = ? then -1 else buf_ord-doc.ord-int1)
     4694                                                 , input temp-edi-status.err-code
     4695                                                 , input temp-edi-status.des-err
     4696                                                 , input v-edist-mess
     4697                                                 , input integer('2':U)
     4698                                                 , input-output v-date-status
     4699                                                 , input-output v-time-status
     4700                                                 ).
     4701         end.
     4702         if v-new-st <> ? then do:
     4703           run cur-time in this-procedure ( output v-today, output v-time).
     4704           run get-xcnf_create-temp-esys-pck-sent in p-cont-handle (
     4705                                                                     input v-esys-id
     4706                                                                   ,input integer(v-pack-num-chr)
     4707                                                                   ,input v-crc-pack
     4708                                                                   ,input yes
     4709                                                                   ,input 1
     4710                                                                   ,input 1
     4711                                                                   ,input v-today
     4712                                                                   ,input v-time
     4713                                                                   ,input string(v-time, "HH:MM:SS")
     4714                                                                   ) .
     4715           num-rec-ok = num-rec-ok + 1.
     4716         end.
     4717       end.
     4718     end.
     4719     run write-counter in p-log-handle ( input substitute("Прочитано записей: &1, из них удачно: &2", num-rec, num-rec-ok)).
     4720   end.
     4721   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Прочитано записей: &1, из них удачно обработано: &2", num-rec, num-rec-ok)).                      assign v-view-log = yes.
     4722   end procedure.
     4723   PROCEDURE GetChildren:
     4724   DEFINE INPUT PARAMETER hParent AS HANDLE NO-UNDO.
     4725   DEFINE INPUT PARAMETER level AS INTEGER NO-UNDO.
     4726   DEFINE VARIABLE i AS INTEGER NO-UNDO.
     4727   DEFINE VARIABLE hNoderef AS HANDLE NO-UNDO.
     4728   DEFINE VARIABLE hText AS HANDLE NO-UNDO.
     4729   define variable client as character no-undo.
     4730   CREATE X-NODEREF hNoderef.
     4731   CREATE X-NODEREF hText .
     4732   if hParent:name = "eDIMessage" then
     4733   assign
     4734       desadv.id = hParent:get-attribute("id")
     4735       desadv.creationDateTime = hParent:get-attribute("creationDateTime")
     4736   .
     4737   REPEAT i = 1 TO hParent:NUM-CHILDREN:
     4738       good = hParent:GET-CHILD(hNoderef,i).
     4739       IF NOT good THEN
     4740           LEAVE.
     4741       IF hNoderef:SUBTYPE <> "element" THEN
     4742           NEXT.
     4743       hNoderef:GET-CHILD(hText, 1) no-error .
     4744       IF hNoderef:NAME = "sender" THEN
     4745           assign desadv.sender = hText:node-value .
     4746       IF hNoderef:NAME = "recipient" THEN
     4747           assign desadv.recipient = hText:node-value .
     4748       IF hNoderef:NAME = "despatchAdvice" THEN
     4749           assign
     4750               desadv.desadvNumber = hNoderef:get-attribute("number")
     4751               desadv.desadvDate = hNoderef:get-attribute("date")
     4752           .
     4753       IF hNoderef:NAME = "originOrder" THEN
     4754           assign
     4755               desadv.orderNumber = hNoderef:get-attribute("number")
     4756               desadv.orderDate = hNoderef:get-attribute("date")
     4757           .
     4758       IF hNoderef:NAME = "invoiceIdentificator" THEN
     4759           assign
     4760               desadv.invoiceNumber = hNoderef:get-attribute("number")
     4761               desadv.invoiceDate = hNoderef:get-attribute("date")
     4762           .
     4763       IF hNoderef:NAME = "documentType" THEN
     4764           assign desadv.documentType = hText:node-value .
     4765       IF hNoderef:NAME = "seller" THEN
     4766           assign client = "seller".
     4767       IF hNoderef:NAME = "buyer" THEN
     4768           assign client = "buyer".
     4769       IF hNoderef:NAME = "shipFrom" THEN
     4770           assign client = "shipFrom".
     4771       IF hNoderef:NAME = "shipTo" THEN
     4772           assign client = "shipTo".
     4773       IF hNoderef:NAME = "gln" THEN do :
     4774           case client :
     4775               when "seller" then assign desadv.seller_gln = hText:node-value .
     4776               when "buyer" then assign desadv.buyer_gln = hText:node-value .
     4777               when "shipFrom" then assign desadv.shipFrom_gln = hText:node-value .
     4778               when "shipTo" then assign desadv.shipTo_gln = hText:node-value .
     4779           end case.
     4780       end.
     4781       IF hNoderef:NAME = "estimatedDeliveryDateTime" THEN
     4782           assign desadv.estimatedDeliveryDateTime = hText:node-value .
     4783       IF hNoderef:NAME = "shippingDateTime" THEN
     4784           assign desadv.shippingDateTime = hText:node-value .
     4785       IF hNoderef:NAME = "currencyISOCode" THEN
     4786           assign desadv.currencyISOCode = hText:node-value .
     4787       IF hNoderef:NAME = "lineItem" THEN do :
     4788           create lineItem .
     4789           assign
     4790               lineItem.NUMBER  = desadv.desadvNumber
     4791           .
     4792       end.
     4793       IF hNoderef:NAME = "gtin" THEN
     4794           assign lineItem.gtin = hText:node-value .
     4795       IF hNoderef:NAME = "description" THEN
     4796           assign lineItem.description = hText:node-value .
     4797       IF hNoderef:NAME = "internalBuyerCode" THEN
     4798           assign lineItem.internalBuyerCode = hText:node-value .
     4799       IF hNoderef:NAME = "internalSupplierCode" THEN
     4800           assign lineItem.internalSupplierCode = hText:node-value .
     4801       IF hNoderef:NAME = "despatchedQuantity" THEN
     4802           assign
     4803               lineItem.despatchedQuantity = decimal(hText:node-value)
     4804               lineItem.unitOfMeasure = hNoderef:get-attribute("unitOfMeasure")
     4805           .
     4806       IF hNoderef:NAME = "netPrice" THEN
     4807           assign lineItem.netPrice = decimal(hText:node-value) .
     4808       IF hNoderef:NAME = "netAmount" THEN
     4809           assign lineItem.netAmount = decimal(hText:node-value) .
     4810       IF hNoderef:NAME = "vATAmount" THEN
     4811           assign lineItem.vATAmount = decimal(hText:node-value) .
     4812       IF hNoderef:NAME = "netPriceWithVAT" THEN
     4813           assign lineItem.netPriceWithVAT = decimal(hText:node-value) .
     4814       IF hNoderef:NAME = "amount" THEN
     4815           assign lineItem.amount = decimal(hText:node-value) .
     4816       IF hNoderef:NAME = "vATRate" THEN
     4817           assign lineItem.vATRate = decimal(hText:node-value) .
     4818       RUN GetChildren(hNoderef, (level + 1)).
     4819   END.
     4820   DELETE OBJECT hNoderef.
     4821   DELETE OBJECT hText.
     4822   END PROCEDURE.
     4823   procedure load-ruleset-context :
     4824   define input parameter p-ruleset-id as integer no-undo .
     4825   define variable glog as logical no-undo .
     4826   define variable v-mess as character no-undo .
     4827   define buffer buf_rule-call-param for ub.rule-call-param.
     4828   define buffer buf_esys-pck-keys for ub.esys-pck-keys.
     4829   define buffer buf_ext-system for ub.ext-system.
     4830     do
     4831     on error undo, return error
     4832     :
     4833    find first buf_rule-call-param no-lock where
     4834   buf_rule-call-param.codex_id = p-codex-id
     4835   and buf_rule-call-param.ruleset_id = p-ruleset-id
     4836   and buf_rule-call-param.call_id = p-call-id
     4837   and buf_rule-call-param.order_id = p-order-id
     4838   and buf_rule-call-param.rule_id = p-rule-id
     4839   and buf_rule-call-param.param-name = "p-xsd-file"
     4840    no-error.
     4841   if available buf_rule-call-param then do:
     4842   assign p-xsd-file = buf_rule-call-param.param-value-character.
     4843   end.
     4844       case p-ruleset-id:
     4845         when 8 then do:
     4846           assign
     4847           v-sign = 1
     4848           v-current-host-code = p-host-code
     4849           v-current-obj-type = p-obj-type
     4850           v-current-obj-code = p-obj-code
     4851           v-current-doc-code = p-doc-code
     4852           v-current-db-num = g#db-num
     4853           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     4854           file-name  = entry(1, p-process-file-name, chr(4))
     4855           v_dataseth = handle(entry(2, p-process-file-name, chr(4)))
     4856           v-xmlh = buffer buf_temp-xml-tables:handle
     4857           v-esys-id = integer(p-doc-code)
     4858           v-pack-num-chr = entry(3, p-process-file-name, chr(4))
     4859           no-error
     4860          .
     4861           find first buf_ext-system no-lock where
     4862                     buf_ext-system.esys-id = v-esys-id
     4863                 and buf_ext-system.db-num = 0 no-error .
     4864           if not available buf_ext-system
     4865           or buf_ext-system.esys-type <> integer('9':U)
     4866           then do:
     4867                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не найдена ВС &1&2пропускаем ..."                                         , v-esys-id                                         , chr(10)                                         )).                      assign v-view-log = yes.
     4868             undo, return error substitute("Не найдена ВС &1&2пропускаем ..."                                         , v-esys-id                                         , chr(10)                                         ).
     4869           end.
     4870           empty temp-table desadv .
     4871           empty temp-table lineItem .
     4872           CREATE X-DOCUMENT hDoc.
     4873           CREATE X-NODEREF hRoot.
     4874           hDoc:LOAD("file",file-name,FALSE).
     4875           hDoc:GET-DOCUMENT-ELEMENT(hRoot).
     4876           create desadv .
     4877           RUN GetChildren(hRoot, 1).
     4878           DELETE OBJECT hDoc.
     4879           DELETE OBJECT hRoot.
     4880           find first ub.ord-doc no-lock where ub.ord-doc.doc-code = desadv.orderNumber no-error.
     4881           if not available ub.ord-doc then do:
     4882             v-mess =  substitute("Не найден заказ поставщику с номером &1", desadv.ordernumber).
     4883             run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при импорте поставок по  заказу &1 из ВС &2&3&4"                                 ,desadv.ordernumber                                 , v-esys-id                                  , chr(10)                                 , v-mess)).                      assign v-view-log = yes.
     4884           end.
     4885           if available ub.ord-doc then
     4886           assign
     4887           v-current-doc-code = ub.ord-doc.doc-code
     4888           v-current-obj-type = ub.ord-doc.obj-type
     4889           v-current-obj-code = ub.ord-doc.obj-code
     4890           .
     4891           assign
     4892           v-desadv-DELIVERYNOTENUMBER = desadv.desadvNumber
     4893           v-desadv-DELIVERYNOTEDATE = date(substring(desadv.desadvDate, 9, 2) + "/" + substring(desadv.desadvDate, 6, 2) + "/" + substring(desadv.desadvDate, 1, 4))
     4894           v-desadv-invoiceNUMBER = desadv.invoiceNumber
     4895           v-desadv-invoiceDATE = date(substring(desadv.invoiceDate, 9, 2) + "/" + substring(desadv.invoiceDate, 6, 2) + "/" + substring(desadv.invoiceDate, 1, 4))
     4896           .
     4897           run send-stat_contour ( input "DESADV"
     4898                                  ,input "Ok"
     4899                                  ,input "Read"
     4900                                  ,input "Сообщение доставлено"
     4901                                  ,input desadv.id) .
     4902         end.
     4903         otherwise do:
     4904           undo, return error "Неправильный вызов".
     4905         end.
     4906       end case.
     4907     end.
     4908   end procedure.
     4909   procedure delete-procedure :
     4910     do
     4911     on error undo, return error
     4912     :
     4913         run garbcoll_clear in this-procedure .
     4914     end.
     4915   end procedure.
