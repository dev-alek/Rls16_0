     3970   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3971   function context_send-esys-command return int64
     3972   (
     3973       input p-esys-id-list as character
     3974      ,input p-esys-cmd-proc-handle as handle
     3975      ,input p-esys-cmd-code as integer
     3976      ,input p-user-id as character
     3977   ):
     3978      define variable v-dmp-ord-int64 as int64 no-undo .
