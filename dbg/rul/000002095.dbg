     2163                           else (chr(13) + chr(10))) +
     2164                           (if num-entries(p-doc-code, chr(4)) > 1
     2165                           then substitute("Товар с кодом &1: ", entry(2, p-doc-code, chr(4)))
     2166                           else '') +
     2167                           cr-edist_get-mess-mean (p-des)
     2168     .
     2169   end.
     2170   end procedure.
     2171   procedure update-edi-state-lighttt :
     2172   define input  parameter p-tbl-name   as character no-undo .
     2173   define input  parameter p-doc-code   as character no-undo .
     2174   define input  parameter p-date-status as date no-undo .
