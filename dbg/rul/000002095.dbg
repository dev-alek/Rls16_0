      395   index pi is primary unique
      396       gtin
      397   .
      398   define variable log-file-name                as character      no-undo init "process-edoc.txt".
      399   define variable v-view-log                   as logical        no-undo .
      400   define variable v-stop                       as logical        no-undo .
      401   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      402   def var vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      403   procedure gen-key-rec :
      404     define input  parameter p-tbl-name    as character no-undo.
      405     define input  parameter p-bh_tbl-name as handle    no-undo.
      406     define output parameter p-key-rec     as character no-undo.
      407     do
      408     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      409     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      410     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      411     :
      412       define variable fh               as handle    no-undo .
      413       define variable v-ok             as logical   no-undo .
      414       define variable v-inform         as character no-undo .
      415       define variable v-ind            as integer   no-undo .
      416       define variable v-idx-field-qnty as integer   no-undo .
      417       if p-tbl-name = ?
      418         or p-tbl-name = "":U
      419       then do:
      420         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info4 ).
      421       end.
      422       if not p-bh_tbl-name:available then do:
      423         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info4, p-tbl-name ).
      424       end.
      425       assign
      426         p-key-rec = p-tbl-name
      427         v-inform  = p-bh_tbl-name:index-information(1)
      428         v-ind     = 2
      429       .
      430       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      431       on error undo, return error
      432       :
      433         assign
      434           v-inform = p-bh_tbl-name:index-information( v-ind )
      435           v-ind    = v-ind + 1
      436         .
      437       end.
      438       if v-inform = ?
      439         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      440         or entry( 3, v-inform, ",":U ) <> "1":U
      441       then do:
      442         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, p-tbl-name ).
      443       end.
      444       else do:
      445         assign
      446           v-idx-field-qnty = num-entries( v-inform ) - 4
      447         .
      448         if v-idx-field-qnty < 2 then do:
      449           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, p-tbl-name ).
      450         end.
      451         do v-ind = 1 to v-idx-field-qnty by 2
      452         on error undo, return error
      453         :
      454           assign
      455             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      456             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      457           .
      458         end.
      459       end.
      460       if p-key-rec = ? then do:
      461         assign
      462           p-key-rec = "":U
      463         .
      464         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info4, p-tbl-name ).
      465       end.
      466     end.
      467     return.
      468   end procedure.
      469   procedure gen-where-keyr-tab :
      470     define input  parameter i-tableSerach as character no-undo.
      471     define input  parameter i-tablekey   as character  no-undo.
      472     define input  parameter p-key-rec    as character  no-undo.
      473     define input  parameter p-key-handle as handle     no-undo .
      474     define input  parameter p-db-name    as character  no-undo .
      475     define input  parameter p-tt-handle  as handle     no-undo .
      476     define output parameter o-Where      as character  no-undo.
      477     do
      478     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      479     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      480     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      481     :
      482       define variable v-full-tbl-name  as character no-undo .
      483       define variable bh_tbl-name      as handle    no-undo .
      484       define variable fh_key           as handle    no-undo .
      485       define variable fh_search        as handle    no-undo .
      486       define variable v-field-num      as integer   no-undo .
      487       define variable v-count-fld      as integer   no-undo .
      488       define variable v-inform         as character no-undo .
      489       define variable v-ind            as integer   no-undo .
      490       define variable v-idx-field-qnty as integer   no-undo .
      491       define variable v-field-name     as character no-undo .
      492       define variable v-field-val      as character no-undo .
      493       define variable v-word-link      as character no-undo .
      494       define variable vTable           as character no-undo.
      495       define variable bh_tbl-key       as handle    no-undo .
      496       assign
      497         p-key-rec = trim( p-key-rec )
      498       .
      499       if p-key-handle <> ? then do:
      500         if not valid-handle(p-key-handle)
      501            or p-key-handle:type <> "buffer"
      502         then do:
      503           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info4 ).
      504         end.
      505         if num-entries( p-key-rec, chr(3) ) > 1
      506           or p-key-rec = ?
      507           or p-key-rec = "":U
      508         then do:
      509           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info4, p-key-rec ).
      510         end.
      511       end.
      512       else do:
      513         if p-key-rec = ?
      514           or p-key-rec = "":U
      515         then do:
      516           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info4 ).
      517         end.
      518       end.
      519       assign
      520         vTable = entry( 1 , p-key-rec, chr(3) )
      521       .
      522       if p-tt-handle <> ?
      523         and ( not valid-handle(p-tt-handle)
      524               or p-tt-handle:type <> "buffer"
      525             )
      526       then do:
      527         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info4, vTable, chr(10) ).
      528       end.
      529       if p-tt-handle = ? then do:
      530         assign
      531           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      532         .
      533         create buffer bh_tbl-name for table v-full-tbl-name .
      534       end.
      535       else do:
      536         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      537       end.
      538       assign
      539         v-inform = bh_tbl-name:index-information(1)
      540         v-ind    = 2
      541       .
      542       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      543       on error undo, return error
      544       :
      545         assign
      546           v-inform = bh_tbl-name:index-information( v-ind )
      547           v-ind    = v-ind + 1
      548         .
      549       end.
      550       if v-inform = ?
      551         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      552         or entry( 3, v-inform, ",":U ) <> "1":U
      553       then do:
      554         delete object bh_tbl-name no-error.
      555         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info4, vTable ).
      556       end.
      557       assign
      558         v-idx-field-qnty = num-entries( v-inform ) - 4
      559       .
      560       if v-idx-field-qnty < 2 then do:
      561         delete object bh_tbl-name no-error.
      562         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, vTable ).
      563       end.
      564       assign
      565         o-where     = "where":U
      566         v-word-link = "":U
      567         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      568         v-count-fld = 0
      569       .
      570       if i-tablekey ne "" and i-tablekey ne ?
      571       then do:
      572         assign
      573           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      574         .
      575         create buffer bh_tbl-key for table v-full-tbl-name .
      576       end.
      577       if i-tableSerach ne "" and i-tableSerach ne ?
      578       then do:
      579         delete object bh_tbl-name no-error.
      580         assign
      581           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      582         .
      583         create buffer bh_tbl-name for table v-full-tbl-name .
      584       end.
      585       block_where:
      586       do v-ind = 1 to v-idx-field-qnty by 2
      587       on error undo, return error
      588       :
      589         assign
      590           v-count-fld = v-count-fld + 1
      591         .
      592         if p-key-handle = ?
      593           and v-count-fld > v-field-num
      594         then do:
      595           leave block_where.
      596         end.
      597         define variable VfieldKeyTable as handle no-undo.
      598         assign
      599           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      600           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      601         .
      602         if     bh_tbl-key ne ?
      603         then do:
      604            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      605            if VfieldKeyTable eq ?
      606            then next block_where.
      607         end.
      608         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      609         then
      610            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      611         else
      612            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      613         if p-key-handle = ? then do:
      614           assign
      615             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      616           .
      617         end.
      618         else do:
      619           assign
      620             fh_key = p-key-handle:buffer-field( v-field-name )
      621           .
      622           if fh_key = ?
      623             or not valid-handle( fh_key )
      624           then do:
      625             delete object bh_tbl-name.
      626             if     bh_tbl-key ne ?
      627             then
      628                delete object bh_tbl-key.
      629             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info4, p-key-handle:name, v-field-name ).
      630           end.
      631           assign
      632             v-field-val = fh_key:buffer-value
      633           .
      634         end.
      635         if fh_search:data-type ="character":U then do:
      636           assign
      637             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      638             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      639             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      640             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      641             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      642             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      643             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      644             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      645             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      646             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      647             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      648             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      649             v-field-val = substitute( '"&1"', v-field-val )
      650           .
      651         end.
      652         assign
      653           o-where = substitute( "&1 &2", o-where, v-field-val )
      654         .
      655         if v-word-link = "":U then do:
      656           assign
      657             v-word-link = "and":U
      658           .
      659         end.
      660       end.
      661       delete object bh_tbl-name.
      662       if     bh_tbl-key ne ?
      663       then
      664          delete object bh_tbl-key.
      665       if p-key-handle = ?
      666         and v-count-fld <> v-field-num
      667       then do:
      668         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info4, vTable ).
      669       end.
      670     end.
      671   end procedure.
      672   procedure gen-hn-keyr-tab :
      673     define input  parameter i-tableSerach as character no-undo.
      674     define input  parameter i-tablekey   as character no-undo.
      675     define input  parameter p-key-rec    as character no-undo.
      676     define input  parameter p-key-handle as handle    no-undo .
      677     define input  parameter p-db-name    as character no-undo .
      678     define input  parameter p-tt-handle  as handle    no-undo .
      679     define input  parameter p-stts-lock  as integer   no-undo .
      680     define output parameter o-hn         as handle    no-undo.
      681     define variable v-full-tbl-name as character no-undo.
      682     define variable v-where         as character no-undo.
      683     define variable bh_tbl-name     as handle    no-undo.
      684     define variable vTable          as character no-undo.
      685     do
      686     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      687     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      688     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      689         run gen-where-keyr-tab(i-tableSerach,
      690                                i-tablekey,
      691                                p-key-rec,
      692                                p-key-handle,
      693                                p-db-name,
      694                                p-tt-handle,
      695                                output v-where).
      696         if i-tableSerach ne "" and i-tableSerach ne ?
      697         then do:
      698            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      699            create buffer bh_tbl-name for table v-full-tbl-name .
      700         end.
      701         else do:
      702            if p-tt-handle = ? then do:
      703               assign
      704                  vTable = entry( 1 , p-key-rec, chr(3) )
      705               .
      706               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      707               create buffer bh_tbl-name for table v-full-tbl-name .
      708            end.
      709            else do:
      710               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      711            end.
      712         end.
      713         if p-tt-handle = ? then do:
      714            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      715         end.
      716         else do:
      717            bh_tbl-name:find-first( v-where ) no-error .
      718         end.
      719         o-hn = bh_tbl-name.
      720      end.
      721   end procedure.
      722   procedure gen-hn-keyr :
      723     define input  parameter p-key-rec    as character no-undo.
      724     define input  parameter p-key-handle as handle    no-undo .
      725     define input  parameter p-db-name    as character no-undo .
      726     define input  parameter p-tt-handle  as handle    no-undo .
      727     define input  parameter p-stts-lock  as integer   no-undo .
      728     define output parameter o-hn         as handle    no-undo.
      729     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      730   end.
      731   procedure gen-row-keyr :
      732     define input  parameter p-key-rec    as character no-undo.
      733     define input  parameter p-key-handle as handle    no-undo .
      734     define input  parameter p-db-name    as character no-undo .
      735     define input  parameter p-tt-handle  as handle    no-undo .
      736     define input  parameter p-stts-lock  as integer   no-undo .
      737     define output parameter p-tbl-row    as rowid     no-undo.
      738     define output parameter p-tbl-name   as character no-undo.
      739     define variable vHn as handle no-undo.
      740       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      741       p-tbl-row = if vHn:available then vHn:rowid else ?.
      742       p-tbl-name =  vHn:table.
      743       delete object vHn no-error.
      744     if p-tbl-row = ? then do:
      745       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info4, p-tbl-name, p-key-rec ).
      746     end.
      747     else do:
      748       return.
      749     end.
      750   end procedure.
      751   procedure gen-key-fv :
      752     define input  parameter p-key-rec    as character no-undo .
      753     define output parameter p-field-list as character no-undo .
      754     define output parameter p-value-list as character no-undo.
      755     do
      756     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      757     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      758     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      759     :
      760       define variable v-full-tbl-name  as character no-undo .
      761       define variable bh_tbl-name      as handle    no-undo .
      762       define variable v-tbl-name       as character no-undo .
      763       define variable v-field-num      as integer   no-undo .
      764       define variable v-count-fld      as integer   no-undo .
      765       define variable v-inform         as character no-undo .
      766       define variable v-ind            as integer   no-undo .
      767       define variable v-idx-field-qnty as integer   no-undo .
      768       define variable v-delim-key      as character no-undo .
      769       if p-key-rec = ?
      770         or p-key-rec = "":U
      771       then do:
      772         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info4 ).
      773       end.
      774       assign
      775         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      776         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      777       .
      778       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      779       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info4 ).
      780       assign
      781         v-inform = bh_tbl-name:index-information(1)
      782         v-ind    = 2
      783       .
      784       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      785       on error undo, return error
      786       :
      787         assign
      788           v-inform = bh_tbl-name:index-information( v-ind )
      789           v-ind    = v-ind + 1
      790         .
      791       end.
      792       if v-inform = ?
      793         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      794         or entry( 3, v-inform, ",":U ) <> "1":U
      795       then do:
      796         delete object bh_tbl-name no-error.
      797         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, v-tbl-name ).
      798       end.
      799       assign
      800         v-idx-field-qnty = num-entries( v-inform ) - 4
      801       .
      802       if v-idx-field-qnty < 2 then do:
      803         delete object bh_tbl-name no-error.
      804         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, v-tbl-name ).
      805       end.
      806       assign
      807         p-field-list = "":U
      808         p-value-list = "":U
      809         v-delim-key  = "":U
      810         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      811         v-count-fld  = 0
      812       .
      813       block_where:
      814       do v-ind = 1 to v-idx-field-qnty by 2
      815       on error undo, return error
      816       :
      817         assign
      818           v-count-fld = v-count-fld + 1
      819         .
      820         if v-count-fld > v-field-num then do:
      821           leave block_where.
      822         end.
      823         assign
      824           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      825           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      826         .
      827         if v-ind = 1 then do:
      828           assign
      829             v-delim-key = chr(3)
      830           .
      831         end.
      832       end.
      833       delete object bh_tbl-name.
      834       if v-count-fld <> v-field-num then do:
      835         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info4, v-tbl-name ).
      836       end.
      837     end.
      838   end procedure.
      839   procedure gen-key-field :
      840     define input  parameter p-table      as character no-undo .
      841     define output parameter p-field-list as character no-undo .
      842     do
      843     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      844     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      845     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      846     :
      847       define variable v-full-tbl-name  as character no-undo .
      848       define variable bh_tbl-name      as handle    no-undo .
      849       define variable v-tbl-name       as character no-undo .
      850       define variable v-field-num      as integer   no-undo .
      851       define variable v-count-fld      as integer   no-undo .
      852       define variable v-inform         as character no-undo .
      853       define variable v-ind            as integer   no-undo .
      854       define variable v-idx-field-qnty as integer   no-undo .
      855       define variable v-delim-key      as character no-undo .
      856       if p-table = ?
      857         or p-table = "":U
      858       then do:
      859         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info4 ).
      860       end.
      861       assign
      862         v-tbl-name      = p-table
      863         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      864       .
      865       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      866       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info4 ).
      867       assign
      868         v-inform = bh_tbl-name:index-information(1)
      869         v-ind    = 2
      870       .
      871       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      872       on error undo, return error
      873       :
      874         assign
      875           v-inform = bh_tbl-name:index-information( v-ind )
      876           v-ind    = v-ind + 1
      877         .
      878       end.
      879       if v-inform = ?
      880         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      881         or entry( 3, v-inform, ",":U ) <> "1":U
      882       then do:
      883         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, v-tbl-name ).
      884       end.
      885       assign
      886         v-idx-field-qnty = num-entries( v-inform ) - 4
      887       .
      888       if v-idx-field-qnty < 2 then do:
      889         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, v-tbl-name ).
      890       end.
      891       assign
      892         p-field-list = "":U
      893         v-delim-key  = "":U
      894         v-count-fld  = 0
      895       .
      896       block_where:
      897       do v-ind = 1 to v-idx-field-qnty by 2
      898       on error undo, return error
      899       :
      900         assign
      901           v-count-fld = v-count-fld + 1
      902         .
      903         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      904         if v-ind = 1 then do:
      905           assign
      906             v-delim-key = chr(3)
      907           .
      908         end.
      909       end.
      910       delete object bh_tbl-name.
      911     end.
      912   end procedure.
      913   define SHARED temp-table temp-cmd no-undo
      914   field cmd-code as integer
      915   field db-list as character
      916   index pi is unique primary
      917   db-list
      918   index icmd
      919   cmd-code
      920   .
      921   define SHARED temp-table temp-smart-route no-undo
      922   field key-field as character
      923   field db-num as integer
      924   index pi is unique primary
      925   key-field
      926   db-num
      927   .
      928   define SHARED temp-table temp-no-route no-undo
      929   field rec-ord as integer
      930   field db-num as integer
      931   index pi is unique primary
      932   db-num
      933   rec-ord
      934   index iro
      935   rec-ord
      936   .
      937   define SHARED temp-table temp-smart-link no-undo
      938   field uniq-key-rec as character
      939   field key-field as character
      940   field rec-ord as integer
      941   field is-smart as logical
      942   index pi is unique primary
      943   key-field
      944   uniq-key-rec
      945   rec-ord
      946   index iu
      947   uniq-key-rec
      948   index iro
      949   rec-ord
      950   .
      951   define SHARED temp-table temp-nws-outline no-undo
      952   like ub.nws-outline.
      953   procedure create-smart-route :
      954   define input parameter p-key-field as character no-undo .
      955   define input parameter p-db-num as integer no-undo .
      956   define buffer buf_temp-smart-route for temp-smart-route.
      957     do
      958     on error undo, return error
      959     :
      960       find first buf_temp-smart-route where
      961                 buf_temp-smart-route.key-field = p-key-field
      962             and buf_temp-smart-route.db-num = p-db-num no-error.
      963       if not available buf_temp-smart-route then do:
      964         create buf_temp-smart-route.
      965         assign
      966         buf_temp-smart-route.key-field = p-key-field
      967         buf_temp-smart-route.db-num = p-db-num
      968         .
      969       end.
      970     end.
      971   end procedure.
      972   procedure create-smart-route-link :
      973   define input parameter p-tbl-name as character no-undo .
      974   define input parameter p-bh_tbl-name as handle no-undo .
      975   define input parameter p-key-field as character no-undo .
      976   define input parameter p-rec-ord as integer no-undo .
      977   define input parameter p-is-smart as logical no-undo .
      978   define variable v-key-rec as character no-undo .
      979   define buffer buf_temp-smart-link for temp-smart-link.
      980     do
      981     on error undo, return error
      982     :
      983       run gen-key-rec in this-procedure ( input p-tbl-name
      984                                          ,input p-bh_tbl-name
      985                                          ,output v-key-rec     ).
      986      find first buf_temp-smart-link where
      987                 buf_temp-smart-link.uniq-key-rec = v-key-rec
      988              and buf_temp-smart-link.key-field = p-key-field
      989              and buf_temp-smart-link.rec-ord = p-rec-ord
      990              no-error .
      991      if not available buf_temp-smart-link then do:
      992        create buf_temp-smart-link.
      993        assign
      994        buf_temp-smart-link.uniq-key-rec = v-key-rec
      995        buf_temp-smart-link.key-field = p-key-field
      996        buf_temp-smart-link.rec-ord = p-rec-ord
      997        buf_temp-smart-link.is-smart = p-is-smart
      998        .
      999      end.
     1000     end.
     1001   end procedure.
     1002   procedure create-nws-outline :
     1003   define input parameter p-cmd-proc-handle as handle no-undo .
     1004   define input parameter p-cmd-code as integer no-undo .
     1005   define input parameter p-outline-type as character no-undo .
     1006   define input parameter p-charkey_one as character no-undo .
     1007   define input parameter p-charkey_two as character no-undo .
     1008   define input parameter p-charkey_three as character no-undo .
     1009   define input parameter p-key#_one as integer no-undo .
     1010   define input parameter p-key#_two as integer no-undo .
     1011   define input parameter p-key#_three as integer no-undo .
     1012   define variable v-no-id as integer no-undo .
     1013   define variable v-rec-ord as integer no-undo .
     1014     do
     1015     on error undo, return error return-value
     1016     :
     1017       find last temp-nws-outline use-index pi no-error .
     1018       v-no-id = (if available temp-nws-outline
     1019                  then (temp-nws-outline.no-id  + 1)
     1020                  else 1).
     1021       create temp-nws-outline.
     1022       assign
     1023       temp-nws-outline.charkeY_one = p-charkey_one
     1024       temp-nws-outline.charkeY_two = p-charkey_two
     1025       temp-nws-outline.charkeY_three = p-charkey_three
     1026       temp-nws-outline.key#_one = p-key#_one
     1027       temp-nws-outline.key#_two = p-key#_two
     1028       temp-nws-outline.key#_three = p-key#_three
     1029       temp-nws-outline.no-id = v-no-id
     1030       temp-nws-outline.outline-type = p-outline-type
     1031       .
     1032                                   run add-dump in p-cmd-proc-handle                                                                           (input p-cmd-code                                                                                         ,input 'nws-outline':U                                                                                          ,input '+update'                                                                                         ,input (buffer temp-nws-outline:handle)                                                                                    ,input ''                                                                                         ,output v-rec-ord                                                                                         ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                     delete procedure p-cmd-proc-handle .                                                                        undo , return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'nws-outline':U                                                                                                ,p-cmd-code                                                                                               ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
     1033       run  create-smart-route in this-procedure (
     1034                                                   input ('nws-outline':U + chr(4) + string(temp-nws-outline.no-id))
     1035                                                  ,input -1).
     1036       run create-smart-route-link in this-procedure (
     1037                                                      input 'nws-outline':U
     1038                                                     ,input (buffer temp-nws-outline:handle)
     1039                                                     ,input ('nws-outline':U + chr(4) + string(temp-nws-outline.no-id))
     1040                                                     ,input v-rec-ord
     1041                                                     ,input no
     1042                                                     ).
     1043     end.
