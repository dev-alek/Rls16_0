     3988         then do:
     3989            delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при отсылке во внешнюю систему &1 команды с кодом &2&3&4&3&5"
     3990                                                           , p-esys-id-list
     3991                                                           , p-cmd-code
     3992                                                           , chr(10)
     3993                                                           , error-status:get-message(1)
     3994                                                           , return-value
     3995                                                           )).
     3996            return 0.
     3997         end.
     3998         delete procedure p-esys-cmd-proc-handle no-error.
     3999         return v-dmp-ord-int64.
     4000      end.
     4001      else do:
     4002         delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при отсылке во внешнюю систему &1 команды с кодом &2&3&4&3&5"
     4003                                                       , p-esys-id-list
     4004                                                       , p-cmd-code
     4005                                                       , chr(10)
     4006                                                       , error-status:get-message(1)
     4007                                                       , return-value
     4008                                                       )).
