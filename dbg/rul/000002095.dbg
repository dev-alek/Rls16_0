     3915   function 00180008_get-error-message returns character :
     3916   define variable v-ii as integer no-undo .
     3917   define variable v-mess as character no-undo .
     3918   DO v-ii = 1 TO ERROR-STATUS:NUM-MESSAGES:
     3919       v-mess = substitute("&1&2ош &3"
     3920                           ,v-mess
     3921                           ,chr(10)
     3922                           ,ERROR-STATUS:GET-MESSAGE(v-ii)).
     3923   END.
     3924   end function.
     3925   define variable ExpData1 as class Route-data_ no-undo .
