     1138   procedure get-gate-file-name :
     1139   define input parameter p-gate-rec as character no-undo .
     1140   define output  parameter p-gate-file-name as character no-undo .
     1141   define buffer buf_clob-data for ub.clob-data.
     1142   define variable v-tbl-row as rowid no-undo .
     1143   define variable v-tbl-name as character no-undo .
     1144   run gen-row-keyr in this-procedure ( input p-gate-rec
     1145                                       ,input ?
     1146                                       ,input "ub"
     1147                                       ,input ?
     1148                                       ,input no-lock
     1149                                       ,output v-tbl-row
     1150                                       ,output v-tbl-name) no-error.
     1151   if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     1152                                                           ,vss-include-info9
     1153                                                           ,p-gate-rec).
     1154   find first buf_clob-data no-lock where
     1155             rowid(buf_clob-data) = v-tbl-row no-error.
     1156   if not available buf_clob-data then do:
     1157     if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     1158                                                             ,vss-include-info9
     1159                                                             ,p-gate-rec).
     1160   end.
     1161   p-gate-file-name = buf_clob-data.file-name.
     1162   end procedure.
     1163   procedure get-gate-rec :
     1164   define input  parameter p-gate-name as character no-undo .
     1165   define output parameter p-gate-rec as character no-undo .
     1166   define buffer buf_clob-bind for ub.clob-bind.
     1167   define buffer buf_clob-data for ub.clob-data.
     1168   main-block:
     1169   do
     1170   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info9, return-value, chr(10), error-status :get-message (1))
     1171   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info9 )
     1172   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info9 )
     1173   :
     1174       find first buf_clob-bind no-lock where
     1175                 buf_clob-bind.uniq-key-rec = p-gate-name
     1176             and buf_clob-bind.field-name = '':U
     1177             and buf_clob-bind.part-num = 1
     1178             and buf_clob-bind.resource-type = 'gate':U
     1179             no-error.
     1180       if not available buf_clob-bind then do:
     1181         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     1182                                         , p-gate-name
     1183                                         ).
     1184       end.
     1185       find first buf_clob-data no-lock where
     1186                 buf_clob-data.db-num = buf_clob-bind.db-num
     1187             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     1188       if not available buf_clob-data then do:
     1189         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1190                                         , buf_clob-bind.db-num
     1191                                         , buf_clob-bind.int64-id
     1192                                         , p-gate-name
     1193                                         ).
     1194       end.
     1195       run gen-key-rec in this-procedure ( input 'clob-data':U
     1196                                 ,input buffer buf_clob-data:handle
     1197                                 ,output p-gate-rec).
     1198   end.
     1199   end procedure.
     1200   procedure get-gate-by-name :
     1201   define input  parameter p-gate-name as character no-undo .
     1202   define output parameter p-gate-rec as character no-undo .
     1203   define output parameter p-dsh as handle no-undo .
     1204   define input-output  parameter p-xmlh as handle no-undo .
     1205   define variable v-ii as integer   no-undo .
     1206   define variable glog as logical   no-undo .
     1207   define variable v-longchar as longchar no-undo .
     1208   define variable v-txmlh as handle no-undo .
     1209   define variable v-db-num as integer no-undo .
     1210   define variable v-int64-id as int64 no-undo .
     1211   define buffer buf_clob-bind for ub.clob-bind.
     1212   define buffer buf_clob-data for ub.clob-data.
     1213   main-block:
     1214   do
     1215   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info9, return-value, chr(10), error-status :get-message (1))
     1216   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info9 )
     1217   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info9 )
     1218   :
     1219       find first buf_clob-bind no-lock where
     1220                 buf_clob-bind.uniq-key-rec = p-gate-name
     1221             and buf_clob-bind.field-name = '':U
     1222             and buf_clob-bind.part-num = 1
     1223             and buf_clob-bind.resource-type = 'gate':U
     1224             no-error.
     1225       if not available buf_clob-bind then do:
     1226         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     1227                                         , p-gate-name
     1228                                         ).
     1229       end.
     1230       find first buf_clob-data no-lock where
     1231                 buf_clob-data.db-num = buf_clob-bind.db-num
     1232             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     1233       if not available buf_clob-data then do:
     1234         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1235                                         , buf_clob-bind.db-num
     1236                                         , buf_clob-bind.int64-id
     1237                                         , p-gate-name
     1238                                         ).
     1239       end.
     1240       assign
     1241       v-longchar = buf_clob-data.cdata
     1242       .
     1243       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1244       if error-status :error then do:
     1245         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1246       end.
     1247       create dataset p-dsh .
     1248       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1249                                     , v-longchar
     1250                                     , ?
     1251                                     , ?
     1252                                     , ?
     1253                                     ) no-error.
     1254       v-longchar = '':U.
     1255       if error-status :error
     1256       or not glog
     1257       then do:
     1258         undo, return error substitute("Не удалось прочитать XML-схему &1 из БД:&2&3", p-gate-name, chr(10), error-status:get-message(1) ).
     1259       end.
     1260       if not valid-handle(p-xmlh)
     1261       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1262         create temp-table v-txmlh.
     1263         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1264         v-txmlh:temp-table-prepare("temp-xml-tables").
     1265         p-xmlh = v-txmlh:default-buffer-handle.
     1266       end.
     1267       run gen-key-rec in this-procedure ( input 'clob-data':U
     1268                                 ,input buffer buf_clob-data:handle
     1269                                 ,output p-gate-rec).
     1270       do v-ii = 1 to p-dsh:num-buffers:
     1271         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1272         if not p-xmlh:available then do:
     1273           p-xmlh:buffer-create().
     1274           assign
     1275           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1276           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1277           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1278           p-xmlh::gate-handle_ = p-dsh
     1279           p-xmlh::uniq-gate-rec = p-gate-rec
     1280           p-xmlh::gate-name = p-dsh:name
     1281           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1282           .
     1283           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1284             assign
     1285             p-xmlh::order = -3.
     1286           end.
     1287         end.
     1288       end.
     1289   end.
     1290   end procedure.
     1291   procedure get-gate-by-rec :
     1292   define input  parameter p-gate-rec as character no-undo .
     1293   define output parameter p-dsh as handle no-undo .
     1294   define input-output  parameter p-xmlh as handle no-undo .
     1295   define input-output parameter p-longchar  as longchar no-undo .
     1296   define variable v-ii as integer   no-undo .
     1297   define variable glog as logical   no-undo .
     1298   define variable v-rowid as rowid no-undo .
     1299   define variable v-tbl-name as character no-undo .
     1300   define variable v-longchar as longchar no-undo .
     1301   define variable v-txmlh as handle no-undo .
     1302   define buffer buf_clob-data for ub.clob-data.
     1303   main-block:
     1304   do
     1305   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info9, return-value, chr(10), error-status :get-message (1))
     1306   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info9 )
     1307   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info9 )
     1308   :
     1309     run gen-row-keyr in this-procedure (
     1310                                           input  p-gate-rec
     1311                                           ,input  ?
     1312                                           ,input  "ub"
     1313                                           ,input  ?
     1314                                           ,input  NO-LOCK
     1315                                           ,output v-rowid
     1316                                           ,output v-tbl-name   ) no-error.
     1317       find first buf_clob-data no-lock where
     1318                 rowid(buf_clob-data) = v-rowid  no-error.
     1319       if not available buf_clob-data then do:
     1320         undo, return error substitute("Не найден CLOB  &1"
     1321                                         , p-gate-rec
     1322                                         ).
     1323       end.
     1324       assign
     1325       v-longchar = buf_clob-data.cdata
     1326       .
     1327       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1328       if error-status :error then do:
     1329         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1330       end.
     1331       create dataset p-dsh .
     1332       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1333                                     , v-longchar
     1334                                     , ?
     1335                                     , ?
     1336                                     , ?
     1337                                     ) no-error.
     1338       define variable v-esm as character no-undo .
     1339       v-esm = error-status:get-message(1) .
     1340       if p-longchar <> ? then do:
     1341         p-longchar = v-longchar.
     1342       end.
     1343       v-longchar = '':U.
     1344       if error-status :error
     1345       or not glog
     1346       then do:
     1347         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     1348                                      , p-gate-rec
     1349                                      , p-gate-rec
     1350                                      , v-esm
     1351                                      ).
     1352       end.
     1353       p-dsh:private-data = buf_clob-data.file-name_ + chr(4) + p-gate-rec.
     1354       if not valid-handle(p-xmlh)
     1355       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1356         create temp-table v-txmlh.
     1357         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1358         v-txmlh:temp-table-prepare("temp-xml-tables").
     1359         p-xmlh = v-txmlh:default-buffer-handle.
     1360       end.
     1361       do v-ii = 1 to p-dsh:num-buffers:
     1362         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1363         if not p-xmlh:available then do:
     1364           p-xmlh:buffer-create().
     1365           assign
     1366           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1367           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1368           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1369           p-xmlh::gate-handle_ = p-dsh
     1370           p-xmlh::uniq-gate-rec = p-gate-rec
     1371           p-xmlh::gate-name = p-dsh:name
     1372           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1373           .
     1374           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1375             assign
     1376             p-xmlh::order = -3.
     1377           end.
     1378           p-xmlh:buffer-release().
     1379         end.
     1380       end.
     1381   end.
     1382   end procedure.
     1383   procedure get-gate-by-file :
     1384   define input  parameter p-schema-file-name as character no-undo .
     1385   define input  parameter p-gate-rec as character no-undo .
     1386   define output parameter p-dsh as handle no-undo .
     1387   define input-output  parameter p-xmlh as handle no-undo .
     1388   define variable v-ii as integer   no-undo .
     1389   define variable glog as logical   no-undo .
     1390   define variable v-rowid as rowid no-undo .
     1391   define variable v-tbl-name as character no-undo .
     1392   define variable v-longchar as longchar no-undo .
     1393   define variable v-txmlh as handle no-undo .
     1394   main-block:
     1395   do
     1396   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info9, return-value, chr(10), error-status :get-message (1))
     1397   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info9 )
     1398   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info9 )
     1399   :
     1400       COPY-LOB
     1401       FROM  FILE p-schema-file-name
     1402       TO  OBJECT v-longchar
     1403       no-convert
     1404       NO-ERROR .
     1405       if error-status :error then do:
     1406           undo, return error substitute("Не удалось считать файл схемы &1 в память&2&3"
     1407                                     , p-schema-file-name
     1408                                 , chr(10)
     1409                                 , error-status:get-message(1) ).
     1410       end.
     1411       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1412       if error-status :error then do:
     1413         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, p-schema-file-name, chr(10), error-status:get-message(1) , return-value ).
     1414       end.
     1415       create dataset p-dsh .
     1416       glog = p-dsh:READ-XMLSCHEMA( "longchar"
     1417                                     , v-longchar
     1418                                     , ?
     1419                                     , ?
     1420                                     , ?
     1421                                     ) no-error.
     1422       v-longchar = ''.
     1423       if error-status :error
     1424       or not glog
     1425       then do:
     1426         undo, return error substitute("Не удалось прочитать XML-схему из файла &1&2&3"
     1427                                      , p-schema-file-name
     1428                                      ,chr(10)
     1429                                      , error-status:get-message(1)
     1430                                      ).
     1431       end.
     1432       if not valid-handle(p-xmlh)
     1433       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1434         create temp-table v-txmlh.
     1435         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1436         v-txmlh:temp-table-prepare("temp-xml-tables").
     1437         p-xmlh = v-txmlh:default-buffer-handle.
     1438       end.
     1439       do v-ii = 1 to p-dsh:num-buffers:
     1440         p-xmlh:find-first(substitute(' where tbl-name = "&1" and  uniq-gate-rec = "&2" '
     1441                                      ,p-dsh:get-buffer-handle(v-ii):name
     1442                                      ,p-gate-rec
     1443                                      )) no-error.
     1444         if not p-xmlh:available then do:
     1445           p-xmlh:buffer-create().
     1446           assign
     1447           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):table
     1448           p-xmlh::uniq-gate-rec = p-gate-rec
     1449           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1450           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1451           p-xmlh::gate-handle_ = p-dsh
     1452           p-xmlh::gate-name = p-dsh:name
     1453           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1454           .
     1455           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1456             assign
     1457             p-xmlh::order = -3.
     1458           end.
     1459           p-xmlh:buffer-release().
     1460         end.
     1461       end.
     1462   end.
     1463   end procedure.
     1464   procedure gate-clear :
     1465   define input  parameter p-dsh as handle no-undo .
     1466   define input  parameter p-xmlh as handle no-undo .
     1467   define variable v-dsh as handle no-undo .
     1468   define variable v-th as handle no-undo .
     1469     do
     1470     on error undo, return error return-value
     1471     :
     1472       if valid-handle(p-dsh) then do:
     1473         delete object p-dsh.
     1474         v-dsh = p-dsh.
     1475         p-dsh = ?.
     1476       end.
     1477       repeat while true:
     1478         p-xmlh:find-first( substitute( " where gate-handle_ = &1 ", v-dsh)
     1479                            , share-lock) no-error.
     1480         if p-xmlh:available then do:
     1481           assign
     1482           v-th = p-xmlh:buffer-field("table-handle_"):buffer-value.
     1483           if valid-handle(p-xmlh:buffer-field("table-handle_"))
     1484           and valid-handle(v-th)
     1485           and v-th:dynamic = yes
     1486           then do:
     1487             delete object p-xmlh:buffer-field("table-handle_"):buffer-value.
     1488             p-xmlh:buffer-field("table-handle_"):buffer-value = ?.
     1489           end.
     1490           p-xmlh:buffer-delete().
     1491         end.
     1492         else do:
     1493           leave.
     1494         end.
     1495       end.
     1496       if p-xmlh:dynamic = yes
     1497       and valid-handle(p-xmlh)
     1498       then do:
     1499         delete object p-xmlh:table-handle.
     1500         p-xmlh = ?.
     1501       end.
     1502       v-dsh = ?.
     1503     end.
     1504   end procedure.
     1505   procedure all-gates-clear :
     1506   define parameter buffer buf_temp-xml-tables for temp-xml-tables.
     1507   do
     1508   on error undo, return error
     1509   :
     1510     for each buf_temp-xml-tables
     1511     break
     1512     by buf_temp-xml-tables.uniq-gate-rec
     1513     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1514     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1515     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1516     :
     1517         if first-of(buf_temp-xml-tables.uniq-gate-rec) then do:
     1518           delete object buf_temp-xml-tables.gate-handle_.
     1519           buf_temp-xml-tables.gate-handle_ = ?.
     1520         end.
     1521         if valid-handle(buf_temp-xml-tables.table-handle_)
     1522         and buf_temp-xml-tables.table-handle_:dynamic = no
     1523         then do:
     1524           delete object buf_temp-xml-tables.table-handle_.
     1525           buf_temp-xml-tables.table-handle_ = ?.
     1526         end.
     1527         delete buf_temp-xml-tables.
     1528     end.
     1529   end.
     1530   end procedure.
     1531   procedure fix-schemalocation :
     1532   define input-output  parameter p-longchar as longchar no-undo .
     1533   DEFINE VARIABLE hdoc AS HANDLE.
     1534   DEFINE VARIABLE hroot AS HANDLE.
     1535   DEFINE VARIABLE hnode-child AS HANDLE.
     1536   DEFINE VARIABLE hnode-attr AS HANDLE.
     1537   define variable v-jj as integer   no-undo .
     1538   define variable ok as logical   no-undo .
     1539   define variable v-path1                    as character                no-undo .
     1540   DEFINE VARIABLE v-full-path1               as character                no-undo .
     1541   DEFINE VARIABLE v-file-name1               as character                no-undo .
     1542   DEFINE VARIABLE v-file-name-no-ext1        as character                no-undo .
     1543   DEFINE VARIABLE v-file-name-ext1           as character                no-undo .
     1544   define variable v-schema-location          as character                no-undo .
     1545   do
     1546   on error undo, return error return-value
     1547   :
     1548     CREATE X-DOCUMENT hdoc.
     1549     CREATE X-noderef hroot.
     1550     CREATE X-noderef hnode-child.
     1551     CREATE X-noderef hnode-attr.
     1552     hdoc:load("longchar", p-longchar, no) no-error.
     1553     iF ERROR-STATUS:GET-MESSAGE(1) <> '' THEN message ERROR-STATUS:GET-MESSAGE(1) view-as alert-box .
     1554     hdoc:get-document-element(hroot).
     1555     _repeat:
     1556     REPEAT v-jj = 1 TO hroot:NUM-CHILDREN:
     1557       ok = hroot:GET-CHILD(hNode-Child, v-jj).
     1558       if not ok then next.
     1559       if hNode-Child:local-name = "include"
     1560       then do:
     1561         ok = hNode-Child:GET-ATTRIBUTE-NODE( hnode-attr, "schemaLocation" ).
     1562           v-schema-location = hnode-attr:node-value.
     1563           run gbl/filename.p (
     1564                           input "exe/" + hnode-attr:node-value
     1565                         ,output v-full-path1
     1566                         ,output v-path1
     1567                         ,output v-file-name1
     1568                         ,output v-file-name-no-ext1
     1569                         ,output v-file-name-ext1
     1570                         ) no-error .
     1571           if error-status :error then do:
     1572             delete object hnode-attr.
     1573             delete object hnode-child.
     1574             delete object hroot.
     1575             delete object hdoc.
     1576             undo, return error substitute("Не удалось определить расположение схемы &1", v-schema-location).
     1577           end.
     1578         ok = hNode-Child:sET-ATTRIBUTE(  "schemaLocation", v-full-path1 ).
     1579         leave  _repeat.
     1580       end.
     1581     END.
     1582     hdoc:save("longchar", p-longchar).
     1583     delete object hnode-attr.
     1584     delete object hnode-child.
     1585     delete object hroot.
     1586     delete object hdoc.
     1587   end.
     1588   end procedure.
     1589   procedure gate-clb_fill-xml-tables :
     1590   define input parameter p-dsh as handle no-undo .
     1591   define input-output parameter p-xmlh as handle no-undo .
     1592   define variable v-ii as integer no-undo .
     1593     do
     1594     on error undo, return error
     1595     :
     1596       do v-ii = 1 to p-dsh:num-buffers:
     1597         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1598         if not p-xmlh:available then do:
     1599           p-xmlh:buffer-create().
     1600           assign
     1601           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1602           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1603           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1604           p-xmlh::gate-handle_ = p-dsh
     1605           p-xmlh::uniq-gate-rec = entry(2, p-dsh:private-data, chr(4))
     1606           p-xmlh::gate-name = p-dsh:name
     1607           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1608           .
     1609           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1610             assign
     1611             p-xmlh::order = -3.
     1612           end.
     1613           p-xmlh:buffer-release().
     1614         end.
     1615       end.
     1616     end.
     1617   end procedure.
     1618   procedure all-gates-empty :
     1619   define buffer buf_temp-xml-tables for temp-xml-tables.
     1620   do
     1621   on error undo, return error
     1622   :
     1623     for each buf_temp-xml-tables
     1624     break
     1625     by buf_temp-xml-tables.uniq-gate-rec
     1626     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1627     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1628     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1629     :
     1630       if valid-handle(buf_temp-xml-tables.tbl-handle_) then do:
     1631         buf_temp-xml-tables.tbl-handle_:empty-temp-table().
     1632       end.
     1633     end.
     1634   end.
     1635   end procedure.
     1636   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1637   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1638   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1639   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1640   procedure ordlineattr-value :
     1641     do
     1642     on error undo, return error return-value
     1643     :
     1644       define input  parameter p-doc-code like ub.ord-line-attr.doc-code   no-undo .
     1645       define input  parameter p-gds-code like ub.ord-line-attr.gds-code   no-undo .
     1646       define input  parameter p-code     like ub.ord-line-attr.attr-code  no-undo .
     1647       define output parameter p-value    like ub.ord-line-attr.attr-value no-undo .
     1648       define output parameter p-type     as character no-undo .
     1649       define buffer buf_ord-line-attr for ub.ord-line-attr .
     1650       define variable v-format         as character no-undo .
     1651       define variable v-fillin_width   as integer   no-undo .
     1652       define variable v-fillin_height  as integer   no-undo .
     1653       define variable v-label          as character no-undo .
     1654       define variable v-user-can-edit  as logical   no-undo .
     1655       define variable v-output-display as logical   no-undo .
     1656       define variable v-other          as character no-undo .
     1657       define variable v-proc           as character no-undo .
     1658       define variable v-func           as character no-undo .
     1659       define variable v-sort           as integer   no-undo .
     1660       run ordlineattr-code in this-procedure
     1661         (input  p-code
     1662         ,output p-type
     1663         ,output v-format
     1664         ,output v-fillin_width
     1665         ,output v-fillin_height
     1666         ,output v-label
     1667         ,output v-user-can-edit
     1668         ,output v-output-display
     1669         ,output v-proc
     1670         ,output v-func
     1671         ,output v-sort
     1672         ,output v-other
     1673         ) no-error .
     1674       if error-status :error then do:
     1675         undo, return error return-value .
     1676       end.
     1677       find first buf_ord-line-attr no-lock
     1678         where buf_ord-line-attr.doc-code  = p-doc-code
     1679           and buf_ord-line-attr.gds-code  = p-gds-code
     1680           and buf_ord-line-attr.attr-code = p-code
     1681         no-error .
     1682       if avail buf_ord-line-attr then do:
     1683         assign
     1684           p-value =  buf_ord-line-attr.attr-value
     1685         .
     1686       end.
     1687       else do:
     1688         assign
     1689           p-value = if p-type = 'L':U then "no":U else ""
     1690         .
     1691       end.
     1692     end.
     1693   end procedure.
     1694   procedure ordlineattr-write :
     1695     do
     1696     on error undo, return error return-value
     1697     :
     1698       define input parameter p-doc-code like ub.ord-line-attr.doc-code   no-undo .
     1699       define input parameter p-gds-code like ub.ord-line-attr.gds-code   no-undo .
     1700       define input parameter p-code     like ub.ord-line-attr.attr-code  no-undo .
     1701       define input parameter p-value    like ub.ord-line-attr.attr-value no-undo .
     1702       define buffer buf_ord-line-attr for ub.ord-line-attr .
     1703       define variable v-type           as character no-undo .
     1704       define variable v-format         as character no-undo .
     1705       define variable v-fillin_width   as integer   no-undo .
     1706       define variable v-fillin_height  as integer   no-undo .
     1707       define variable v-label          as character no-undo .
     1708       define variable v-user-can-edit  as logical   no-undo .
     1709       define variable v-output-display as logical   no-undo .
     1710       define variable v-other          as character no-undo .
     1711       define variable v-proc           as character no-undo .
     1712       define variable v-func           as character no-undo .
     1713       define variable v-sort           as integer   no-undo .
     1714       run ordlineattr-code in this-procedure
     1715         (input  p-code
     1716         ,output v-type
     1717         ,output v-format
     1718         ,output v-fillin_width
     1719         ,output v-fillin_height
     1720         ,output v-label
     1721         ,output v-user-can-edit
     1722         ,output v-output-display
     1723         ,output v-proc
     1724         ,output v-func
     1725         ,output v-sort
     1726         ,output v-other
     1727         ) no-error .
     1728       if error-status :error then do:
     1729         message
     1730           vss-workfile vss-revision vss-description skip
     1731           error-status :get-message(1) skip
     1732           return-value skip
     1733           ""
     1734           view-as alert-box error
     1735         .
     1736         undo, return error return-value .
     1737       end.
     1738       find first buf_ord-line-attr exclusive-lock
     1739         where buf_ord-line-attr.doc-code  = p-doc-code
     1740           and buf_ord-line-attr.gds-code  = p-gds-code
     1741           and buf_ord-line-attr.attr-code = p-code
     1742         no-error .
     1743       if not available buf_ord-line-attr then do:
     1744         create buf_ord-line-attr .
     1745         assign
     1746           buf_ord-line-attr.doc-code   = p-doc-code
     1747           buf_ord-line-attr.gds-code   = p-gds-code
     1748           buf_ord-line-attr.attr-code  = p-code
     1749         .
     1750       end.
     1751       assign
     1752         buf_ord-line-attr.attr-value = p-value
     1753       .
     1754   end.
     1755   end procedure.
     1756   procedure ordlineattr-exist :
     1757     do
     1758     on error undo, return error return-value
     1759     :
     1760       define input parameter p-doc-code like ub.ord-line-attr.doc-code   no-undo .
     1761       define input parameter p-gds-code like ub.ord-line-attr.gds-code   no-undo .
     1762       define input parameter p-code     like ub.ord-line-attr.attr-code  no-undo .
     1763       define output parameter p-exist   as logical  no-undo .
     1764       define buffer buf_ord-line-attr for ub.ord-line-attr .
     1765       define variable v-type           as character no-undo .
     1766       define variable v-format         as character no-undo .
     1767       define variable v-fillin_width   as integer   no-undo .
     1768       define variable v-fillin_height  as integer   no-undo .
     1769       define variable v-label          as character no-undo .
     1770       define variable v-user-can-edit  as logical   no-undo .
     1771       define variable v-output-display as logical   no-undo .
     1772       define variable v-other          as character no-undo .
     1773       define variable v-proc           as character no-undo .
     1774       define variable v-func           as character no-undo .
     1775       define variable v-sort           as integer   no-undo .
     1776       run ordlineattr-code in this-procedure
     1777         (input  p-code
     1778         ,output v-type
     1779         ,output v-format
     1780         ,output v-fillin_width
     1781         ,output v-fillin_height
     1782         ,output v-label
     1783         ,output v-user-can-edit
     1784         ,output v-output-display
     1785         ,output v-proc
     1786         ,output v-func
     1787         ,output v-sort
     1788         ,output v-other
     1789         ) no-error .
     1790       if error-status :error then do:
     1791         undo, return error return-value .
     1792       end.
     1793       find first buf_ord-line-attr no-lock
     1794         where buf_ord-line-attr.doc-code  = p-doc-code
     1795           and buf_ord-line-attr.gds-code = p-gds-code
     1796           and buf_ord-line-attr.attr-code = p-code
     1797         no-error .
     1798       if  available buf_ord-line-attr then do:
     1799         p-exist = yes.
     1800       end.
     1801     end.
     1802   end procedure.
     1803   procedure ordlineattr-delete :
     1804     do
     1805     on error undo, return error return-value
     1806     :
     1807       define input parameter p-doc-code like ub.ord-line-attr.doc-code   no-undo .
     1808       define input parameter p-gds-code like ub.ord-line-attr.gds-code   no-undo .
     1809       define input parameter p-code     like ub.ord-line-attr.attr-code  no-undo .
     1810       define output parameter p-deleted  as logical no-undo.
     1811       define buffer buf_ord-line-attr for ub.ord-line-attr .
     1812       define variable v-type           as character no-undo .
     1813       define variable v-format         as character no-undo .
     1814       define variable v-fillin_width   as integer   no-undo .
     1815       define variable v-fillin_height  as integer   no-undo .
     1816       define variable v-label          as character no-undo .
     1817       define variable v-user-can-edit  as logical   no-undo .
     1818       define variable v-output-display as logical   no-undo .
     1819       define variable v-proc           as character no-undo .
     1820       define variable v-func           as character no-undo .
     1821       define variable v-sort           as integer   no-undo .
     1822       define variable v-other          as character no-undo .
     1823       run ordlineattr-code in this-procedure
     1824         (input  p-code
     1825         ,output v-type
     1826         ,output v-format
     1827         ,output v-fillin_width
     1828         ,output v-fillin_height
     1829         ,output v-label
     1830         ,output v-user-can-edit
     1831         ,output v-output-display
     1832         ,output v-proc
     1833         ,output v-func
     1834         ,output v-sort
     1835         ,output v-other
     1836         ) no-error .
     1837       if error-status :error then do:
     1838         undo, return error return-value .
     1839       end.
     1840       find first buf_ord-line-attr exclusive-lock
     1841         where buf_ord-line-attr.doc-code  = p-doc-code
     1842           and buf_ord-line-attr.gds-code  = p-gds-code
     1843           and buf_ord-line-attr.attr-code = p-code
     1844         no-error NO-WAIT.
     1845       if not available buf_ord-line-attr then do:
     1846         p-deleted = no.
     1847       end.
     1848       else do:
     1849         delete buf_ord-line-attr.
     1850         p-deleted = yes.
     1851       end.
     1852     end.
     1853   end procedure.
     1854   procedure ordlineattr-code :
     1855     do on error undo, return error return-value
     1856     :
     1857       define input  parameter p-code           as character no-undo .
     1858       define output parameter p-type           as character no-undo .
     1859       define output parameter p-format         as character no-undo .
     1860       define output parameter p-fillin_width   as integer   no-undo .
     1861       define output parameter p-fillin_height  as integer   no-undo .
     1862       define output parameter p-label          as character no-undo .
     1863       define output parameter p-user-can-edit  as logical   no-undo .
     1864       define output parameter p-output-display as logical   no-undo .
     1865       define output parameter p-proc           as character no-undo .
     1866       define output parameter p-func           as character no-undo .
     1867       define output parameter p-sort           as integer   no-undo .
     1868       define output parameter p-other          as character no-undo .
     1869       case p-code :
     1870               when 'cycle-cli-qnty':U then do:     assign     p-label          = "Количество"     p-type           = 'D':U      p-format         = ">>>>>>>>>>>>>>>9.999"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "Количество"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
     1871               when 'ord-EAN13':U then do:     assign     p-label          = "EAN в EDI"     p-type           = 'C':U      p-format         = "X(13)"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "EAN в EDI"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
     1872         otherwise do:
     1873           undo, return error "неизвестный атрибут строки заказа" + " " + p-code .
     1874         end.
     1875       end.
     1876     end.
     1877   end procedure.
     1878   FUNCTION cr-edist_get-mess-mean returns character ( input p-mess as character):
     1879   define variable v-ii as integer   no-undo .
     1880   define variable v-dop as character no-undo .
     1881   define variable v-dop1 as character no-undo .
     1882   define variable v-mess as character no-undo .
     1883   do v-ii = 1 to num-entries(p-mess, chr(4) ):
     1884     v-dop = entry(v-ii, p-mess, chr(4) ).
     1885     case entry(1, v-dop, "="):
     1886       when 'pack-num':U then do:
     1887         v-dop1 =  substitute("&1 &2", 'Пакет', entry(2, v-dop, "=")).
     1888       end.
     1889       when 'route':U then do:
     1890         v-dop1 =  substitute("&1 &2", 'Рут':U, entry(2, v-dop, "=")).
     1891       end.
     1892       when 'ediiterchangeid':U then do:
     1893         v-dop1 =  substitute("&1 &2", 'ediiterchangeid':U, entry(2, v-dop, "=")).
     1894       end.
     1895       when 'price-up':U then do:
     1896         v-dop1 =  substitute("&1 &2", 'Цена':U, entry(2, v-dop, "=")).
     1897       end.
     1898       when 'price-down':U then do:
     1899         v-dop1 =  substitute("&1 &2", 'Цена':U, entry(2, v-dop, "=")).
     1900       end.
     1901       when 'vat-change':U then do:
     1902         v-dop1 =  substitute("&1 &2", 'НДС':U, entry(2, v-dop, "=")).
     1903       end.
     1904       when 'ps':U then do:
     1905         v-dop1 =  substitute("&1 &2", ' ':U, entry(2, v-dop, "=")).
     1906       end.
     1907       when 'info':U then do:
     1908         v-dop1 =  substitute("&1 &2", 'Инф:':U, entry(2, v-dop, "=")).
     1909       end.
     1910       when 'qnty-up':U then do:
     1911         v-dop1 =  substitute("&1 &2", 'Кол-во':U, entry(2, v-dop, "=")).
     1912       end.
     1913       when 'qnty-down':U then do:
     1914         v-dop1 =  substitute("&1 &2", 'Кол-во':U, entry(2, v-dop, "=")).
     1915       end.
     1916       when 'bstr-change':U then do:
     1917         v-dop1 =  substitute("&1 &2", 'Штрихкод:':U, entry(2, v-dop, "=")).
     1918       end.
     1919       when 'shipdate-change':U then do:
     1920         v-dop1 =  substitute("&1 &2", 'Дата отгрузки:':U, entry(2, v-dop, "=")).
     1921       end.
     1922       when 'clioutdoc-change':U then do:
     1923         v-dop1 =  substitute("&1 &2", '№ заказа по пост-ку:':U, entry(2, v-dop, "=")).
     1924       end.
     1925     end case.
     1926     v-mess  = v-mess + (if v-mess = '' then '' else chr(32)) + v-dop1.
     1927   end.
     1928   return v-mess.
     1929   end function.
     1930   FUNCTION cr-edist_get-error-mean returns character ( input p-mess as character):
     1931   define variable v-ii as integer   no-undo .
     1932   define variable v-dop as character no-undo .
     1933   define variable v-dop1 as character no-undo .
     1934   define variable v-mess as character no-undo .
     1935   do v-ii = 1 to num-entries(p-mess, chr(4) ):
     1936     v-dop = entry(v-ii, p-mess, chr(4) ).
     1937     case entry(1, v-dop, "="):
     1938       when 'pack-num':U then do:
     1939         v-dop1 =  substitute("&1 &2", 'Пакет', entry(2, v-dop, "=")).
     1940       end.
     1941       when 'route':U then do:
     1942         v-dop1 =  substitute("&1 &2", 'Рут':U, entry(2, v-dop, "=")).
     1943       end.
     1944       when 'ediiterchangeid':U then do:
     1945         v-dop1 =  substitute("&1 &2", 'ediiterchangeid':U, entry(2, v-dop, "=")).
     1946       end.
     1947       when 'price-up':U then do:
     1948         v-dop1 =  substitute("&1 &2", 'Цена':U, entry(2, v-dop, "=")).
     1949       end.
     1950       when 'price-down':U then do:
     1951         v-dop1 =  substitute("&1 &2", 'Цена':U, entry(2, v-dop, "=")).
     1952       end.
     1953       when 'vat-change':U then do:
     1954         v-dop1 =  substitute("&1 &2", 'НДС':U, entry(2, v-dop, "=")).
     1955       end.
     1956       when 'ps':U then do:
     1957         v-dop1 =  substitute("&1 &2", ' ':U, entry(2, v-dop, "=")).
     1958       end.
     1959       when 'info':U then do:
     1960         v-dop1 =  substitute("&1 &2", 'Инф:':U, entry(2, v-dop, "=")).
     1961       end.
     1962       when 'qnty-up':U then do:
     1963         v-dop1 =  substitute("&1 &2", 'Кол-во':U, entry(2, v-dop, "=")).
     1964       end.
     1965       when 'qnty-down':U then do:
     1966         v-dop1 =  substitute("&1 &2", 'Кол-во':U, entry(2, v-dop, "=")).
     1967       end.
     1968       when 'bstr-change':U then do:
     1969         v-dop1 =  substitute("&1 &2", 'Штрихкод:':U, entry(2, v-dop, "=")).
     1970       end.
     1971       when 'shipdate-change':U then do:
     1972         v-dop1 =  substitute("&1 &2", 'Дата отгрузки:':U, entry(2, v-dop, "=")).
     1973       end.
     1974       when 'clioutdoc-change':U then do:
     1975         v-dop1 =  substitute("&1 &2", '№ заказа по пост-ку:':U, entry(2, v-dop, "=")).
     1976       end.
     1977     end case.
     1978     v-mess  = v-mess + (if v-mess = '' then '' else chr(4)) + v-dop1.
     1979   end.
     1980   return v-mess.
     1981   end function.
     1982   FUNCTION cr-edist_get-mess-key-value returns character ( input p-mess as character, input p-key as character):
     1983   define variable v-ii as integer   no-undo .
     1984   define variable v-dop as character no-undo .
     1985   define variable v-dop1 as character no-undo .
     1986   define variable v-value as character no-undo .
     1987   do v-ii = 1 to num-entries(p-mess, chr(4) ):
     1988     v-dop = entry(v-ii, p-mess, chr(4) ).
     1989     if entry(1, v-dop, "=") = p-key then do:
     1990       return entry(2, v-dop, "=").
     1991     end.
     1992   end.
     1993   return v-value.
     1994   end function.
     1995   FUNCTION cr-edist_add-edist-mess returns character ( input p-mess as character
     1996                                                        ,input p-key as character
     1997                                                        ,input p-value as character):
     1998   define variable v-dop as character no-undo .
     1999   define variable v-modificator as character no-undo .
     2000   assign
     2001   v-modificator = entry(2, p-key, "-") no-error .
     2002   case v-modificator:
     2003     when "up" then do:
     2004       v-dop = substitute("&1=&2<&3", p-key, entry(1, p-value, chr(4)) , entry(2, p-value, chr(4))).
     2005     end.
     2006     when "down" then do:
     2007       v-dop = substitute("&1=&2>&3", p-key, entry(1, p-value, chr(4)) , entry(2, p-value, chr(4))).
     2008     end.
     2009     when "change" then do:
     2010       v-dop = substitute("&1=&2 ->&3", p-key, entry(1, p-value, chr(4)) , entry(2, p-value, chr(4))).
     2011     end.
     2012     otherwise do:
     2013       v-dop = substitute("&1=&2", p-key, p-value).
     2014     end.
     2015   end case.
     2016   if p-mess = ''
     2017   or p-mess = ? then do:
     2018     return v-dop .
     2019   end.
     2020   else do:
     2021     return substitute("&1&2&3", p-mess, chr(4), v-dop).
     2022   end.
     2023   end function.
     2024   procedure create-edi-state :
     2025   define input  parameter p-tbl-name   as character no-undo .
     2026   define input  parameter p-doc-code   as character no-undo .
     2027   define input  parameter p-cli-type   as character no-undo .
     2028   define input  parameter p-cli-code   as integer   no-undo .
     2029   define input  parameter p-act        as character no-undo .
     2030   define input  parameter p-state      as character no-undo .
     2031   define input  parameter p-err        as integer   no-undo .
     2032   define input  parameter p-des        as character no-undo .
     2033   define input  parameter p-mess       as character no-undo .
     2034   define input  parameter p-dm         as integer  no-undo .
     2035   define input-output parameter p-date       as date no-undo .
     2036   define input-output parameter p-time       as integer no-undo .
     2037   define buffer buf_EDI-status for ub.EDI-status  .
     2038   define variable v-time as integer   no-undo .
     2039   define variable v-date as date   no-undo .
     2040   do
     2041   on error undo, return error return-value
     2042   :
     2043     if p-date = ? then do:
     2044       run cur-time in this-procedure ( output v-date, output v-time).
     2045     end.
     2046     else do:
     2047       assign
     2048       v-date = p-date
     2049       v-time = p-time
     2050       .
     2051     end.
     2052     find first buf_edi-status exclusive-lock where
     2053                 buf_edi-status.date-status = v-date
     2054             and buf_edi-status.time-status = v-time
     2055             and buf_edi-status.tbl-name    = p-tbl-name
     2056             and buf_edi-status.doc-code    = p-doc-code no-error .
     2057     if not available buf_edi-status  then do:
     2058       create buf_edi-status.
     2059     end.
     2060     assign
     2061     buf_edi-status.act         = p-act        .
     2062     buf_edi-status.cli-type    = p-cli-type   .
     2063     buf_edi-status.cli-code    = p-cli-code   .
     2064     buf_edi-status.des-err     = buf_edi-status.des-err + (if buf_edi-status.des-err = '' then '' else chr(4)) + p-des        .
     2065     buf_edi-status.doc-code    = p-doc-code   .
     2066     buf_edi-status.err-code    = p-err        .
     2067     buf_edi-status.mess-id     = buf_edi-status.mess-id + (if buf_edi-status.mess-id = '' then '' else chr(4)) + p-mess       .
     2068     buf_edi-status.state       = p-state      .
     2069     buf_edi-status.tbl-name    = p-tbl-name   .
     2070     buf_edi-status.date-status = v-date       .
     2071     buf_edi-status.time-status = v-time       .
     2072     buf_edi-status.whole-send-news = p-dm     .
     2073     buf_edi-status.user-name   = (if g#news then (chr(4) +  'СПН':U)
     2074                                       else (if g#esys
     2075                                             then (chr(4) +  'ВС':U)
     2076                                             else g#userid)
     2077                                       )       .
     2078     assign
     2079     p-date = buf_edi-status.date-status
     2080     p-time = buf_edi-status.time-status
     2081     .
     2082   end.
     2083   end procedure.
     2084   procedure update-edi-state-light :
     2085   define input  parameter p-tbl-name   as character no-undo .
