     3953        run begin-create-command in p-esys-cmd-proc-handle
     3954          (input 'cmd-esys-general':U
     3955          ,input p-esys-id-list
     3956          ,output p-esys-cmd-code
     3957          ) no-error.
     3958        if error-status :error
     3959        then do:
