     1045   procedure create-no-route :
     1046   define input parameter p-rec-ord as integer no-undo .
     1047   define input parameter p-db-num as integer no-undo .
     1048   define buffer buf_temp-no-route for temp-no-route.
     1049   do
     1050   on error undo, return error
     1051   :
     1052      find first buf_temp-no-route where
     1053                 buf_temp-no-route.rec-ord = p-rec-ord
     1054              and buf_temp-no-route.db-num = p-db-num no-error .
     1055      if not available buf_temp-no-route then do:
     1056        create buf_temp-no-route.
     1057        assign
     1058        buf_temp-no-route.rec-ord = p-rec-ord
     1059        buf_temp-no-route.db-num = p-db-num
     1060        .
     1061      end.
     1062   end.
     1063   end procedure.
     1064   procedure clear-from-rec-ord :
     1065   define input parameter p-rec-ord as integer no-undo .
     1066   define buffer buf_temp-no-route for temp-no-route.
     1067   define buffer buf_temp-smart-link for temp-smart-link.
     1068   do
     1069   on error undo, return error
     1070   :
     1071   for each buf_temp-no-route where
     1072           buf_temp-no-route.rec-ord > p-rec-ord:
     1073     delete buf_temp-no-route.
     1074   end.
     1075   for each buf_temp-smart-link where
     1076           buf_temp-smart-link.rec-ord > p-rec-ord:
     1077      delete buf_temp-smart-link.
     1078   end.
     1079   end.
     1080   end procedure.
