     4105   function 00130004_get-error-message returns character :
     4106   define variable v-ii as integer no-undo .
     4107   define variable v-mess as character no-undo .
     4108   DO v-ii = 1 TO ERROR-STATUS:NUM-MESSAGES:
     4109       v-mess = substitute("&1&2ош &3"
     4110                           ,v-mess
     4111                           ,chr(10)
     4112                           ,ERROR-STATUS:GET-MESSAGE(v-ii)).
     4113   END.
     4114   return v-mess.
     4115   end function.
     4116   function 00130004_after-import_f returns logical ( input p-d-card as character):
     4117     run 00130004_after-import in this-procedure ( input p-d-card) no-error.
     4118     run set-error in this-procedure ( input return-value ).
     4119     return not (error-status:error).
     4120   end function.
     4121   define variable p-esys-id as integer no-undo .
     4122   define variable p-xsd-file as character no-undo.
     4123   on delete of this-procedure do:
     4124     run delete-procedure in this-procedure .
     4125     run gate-clear in this-procedure ( input v_dataseth, input v-xmlh) no-error.
     4126   end.
     4127   run load-ruleset-context in this-procedure ( input p-ruleset-id) no-error .
     4128   if error-status:error
     4129   or return-value = "return" then return error.
     4130   define variable ImpData1 as class Route-data_ no-undo .
     4131   ImpData1 = new Route-data_( input parparentproc, input p-parent-handle, input p-log-handle, input this-procedure:handle, input v_dataseth, input v-xmlh) .
     4132   if not this-procedure:persistent then do:
     4133     run proc-main in this-procedure no-error .
     4134     if error-status:error then do:
     4135         run delete-procedure in this-procedure .
     4136         undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     4137     end.
     4138     run delete-procedure in this-procedure .
     4139   end.
     4140   procedure proc-main :
     4141   define variable v-current-node-code as integer no-undo .
     4142   define variable v-current-upper-node-code as integer no-undo .
     4143   define variable v-current-node-name as character no-undo .
     4144   define variable v-calc-method as character no-undo .
     4145   define variable v-increase-pc as decimal no-undo .
     4146   define variable v-print-code  as character  no-undo .
     4147   define variable v-round-method as character no-undo .
     4148   define variable v-base as decimal no-undo .
     4149   define variable v-mode as character no-undo .
     4150   define variable v-line-num as integer no-undo .
     4151   define variable v-present as logical no-undo .
     4152   define variable v-current-group-code as integer no-undo .
     4153   define variable v-current-depart-code as integer no-undo .
     4154   define variable v-current-class-code as integer no-undo .
     4155   define variable v-current-subclass-code as integer no-undo .
     4156   define variable v-current-rpm-grp-name as character no-undo .
     4157   define variable v-line-status_ as character no-undo .
     4158   define variable v-upper-group-code as integer no-undo .
     4159   define variable v-upper-depart-code as integer no-undo .
     4160   define variable v-upper-class-code as integer no-undo .
     4161   define variable v-upper-subclass-code as integer no-undo .
     4162   define variable v-upper-rpm-grp-name as integer no-undo .
     4163   define variable v-rowid as rowid no-undo .
     4164   define variable v-table-name as character no-undo .
     4165   define variable v-uniq-key-rec as character no-undo .
     4166   define variable v-rec as recid no-undo .
     4167   define variable v-root-code as integer   no-undo .
     4168   define variable v-rid as recid no-undo .
     4169   define buffer buf_gds-grp for ub.gds-grp.
     4170   define buffer upper_gds-grp for ub.gds-grp.
     4171   define buffer buf_ext-classif for ub.ext-classif.
     4172   define buffer upper_ext-classif for ub.ext-classif.
     4173   _main:
     4174   do transaction
     4175   on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4176   on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
     4177   on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
     4178   :
     4179   run write-log  in p-log-handle (
     4180                                    input 0
     4181                                  , "&DLine").
     4182     run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute(".............Импорт данных по группам товаров из ВС")).
     4183   run write-log-and-file in p-log-handle (
     4184         input 1
     4185       , input log-file-name
     4186       , input 1
     4187       , input substitute("Импорт данных по группам товаров из файла &1", file-name)).
     4188   for each buf_temp-xml-tables where buf_temp-xml-tables.order >= 0:
     4189     create query v_qh.
     4190     glog = v_qh:set-buffers( buf_temp-xml-tables.tbl-handle_) no-error.
     4191     if error-status:error
     4192     or
     4193     not glog then do:
     4194           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при попытке получить записи &1&2&3&2&4"                                                             , buf_temp-xml-tables.tbl-name                                                             , chr(10)                                                             , error-status:get-message(1)                                                             , return-value)).
     4195       undo _main, return error ''.
     4196     end.
     4197     glog = v_qh:query-prepare( substitute( "for each &1 by &1.line-num", buf_temp-xml-tables.tbl-name)) no-error .
     4198     if error-status:error
     4199     or
     4200     not glog then do:
     4201           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при попытке получить записи &1&2&3&2&4"                                                             , buf_temp-xml-tables.tbl-name                                                             , chr(10)                                                             , error-status:get-message(1)                                                             , return-value)).
     4202       if valid-handle(v_qh) then do:
     4203         delete object v_qh no-error.
     4204       end.
     4205       undo _main, return error ''.
     4206     end.
     4207     glog = v_qh:query-open no-error .
     4208     if error-status:error
     4209     or not glog then do:
     4210       run write-log-and-file in p-log-handle (
     4211                                               input 1
     4212                                             , input log-file-name
     4213                                             , input 1
     4214                                             , input substitute("Ошибка при попытке получить записи &1&2&3&2&4"
     4215                                                               , buf_temp-xml-tables.tbl-name
     4216                                                               , chr(10)
     4217                                                               , error-status:get-message(1)
     4218                                                               , return-value)).
     4219       if valid-handle(v_qh) then do:
     4220         delete object v_qh no-error.
     4221       end.
     4222       undo _main, return error ''.
     4223     end.
     4224       _stroka:
     4225       REPEAT:
     4226         v-retry-action = 0 .
     4227        _release:
     4228         do on error undo, retry:
     4229           if  retry then do:
     4230             v-retry-action = v-retry-action + 1.
     4231                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при импорте записи &5 &1&2&3&2&4"                                                                   , buf_temp-xml-tables.tbl-name                                                                   , num-rec                                                                   , chr(10)                                                                   , error-status:get-message(1)                                                                   , return-value)).
     4232             if valid-handle(v_qh) then do:
     4233               delete object v_qh no-error.
     4234             end.
     4235             undo _main, return error ''.
     4236           end.
     4237         if v-retry-action < 1 then do:
     4238                   ImpData1:Route-data_dump ( ) .
     4239         end.
     4240         end.
     4241         _rule:
     4242          do on error undo _rule, retry _rule:
     4243            if retry then do:
     4244              if valid-handle(v_qh) then do:
     4245                delete object v_qh no-error.
     4246              end.
     4247                         run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("&1&2&3"                                       , error-status:get-message(1)                                       , chr(10)                                       , return-value)).
     4248              undo _main, return error ''.
     4249            end.
     4250            else do:
     4251             v_qh:get-next().
     4252             IF v_qh:query-off-end then leave _stroka.
     4253             IF  ImpData1:current-tbl-name( ) = "rpm-gds-grp"  THEN do:
     4254               _tr:
     4255               do
     4256               on error undo _rule, retry _rule
     4257               :
     4258                 v-current-node-code = 0.
     4259                 v-current-upper-node-code = 0.
     4260                 v-line-num = ImpData1:route-data_get-field-integer( input "rpm-gds-grp", input "line-num") .
     4261                 v-present = no.
     4262                 num-rec = num-rec + 1.
     4263                 v-current-group-code = ImpData1:route-data_get-field-integer( input "rpm-gds-grp", input "group-code") .
     4264                 v-current-depart-code = ImpData1:route-data_get-field-integer( input "rpm-gds-grp", input "depart-code") .
     4265                 v-current-class-code = ImpData1:route-data_get-field-integer( input "rpm-gds-grp", input "class-code") .
     4266                 v-current-subclass-code = ImpData1:route-data_get-field-integer( input "rpm-gds-grp", input "subclass-code") .
     4267                 v-current-rpm-grp-name = ImpData1:route-data_get-field-character( input "rpm-gds-grp", input "rpm-grp-name") .
     4268                 v-line-status_ = ImpData1:route-data_get-field-character( input "rpm-gds-grp", input "status_") .
     4269                 find first buf_ext-classif no-lock where
     4270                           buf_ext-classif.classif-subject = 'gds-grp':U
     4271                       and buf_ext-classif.classif-name = 'rpm_gds-grp':U
     4272                       AND buf_ext-classif.db-num = - 1
     4273                       and buf_ext-classif.charkey_one = string(v-current-group-code)
     4274                       and buf_ext-classif.key#_one = v-current-depart-code
     4275                       and buf_ext-classif.key#_two = v-current-class-code
     4276                       and buf_ext-classif.key#_three = v-current-subclass-code no-error.
     4277                 if available buf_ext-classif then do:
     4278                   RUN gen-row-keyr IN THIS-PROCEDURE ( INPUT buf_ext-classif.uniq-key-rec
     4279                                                       ,INPUT ?
     4280                                                       ,INPUT "ub"
     4281                                                       ,INPUT ?
     4282                                                       ,INPUT NO-LOCK
     4283                                                       ,OUTPUT v-rowid
     4284                                                       ,OUTPUT v-table-name) NO-ERROR.
     4285                   find first buf_gds-grp no-lock where
     4286                             rowid(buf_gds-grp) = v-rowid no-error.
     4287                   assign
     4288                   v-current-node-code = buf_gds-grp.node-code
     4289                   v-current-upper-node-code = buf_gds-grp.upper-code
     4290                   .
     4291                 end.
     4292                 assign
     4293                 v-upper-group-code = (if v-current-depart-code > 0 then v-current-group-code else 0)
     4294                 v-upper-depart-code = (if v-current-class-code > 0 then v-current-depart-code else 0)
     4295                 v-upper-class-code = (if v-current-subclass-code > 0 then v-current-class-code else 0)
     4296                 v-upper-subclass-code = 0
     4297                 .
     4298                 if v-upper-group-code = 0
     4299                 and v-upper-depart-code = 0
     4300                 and v-upper-class-code = 0
     4301                 and v-upper-subclass-code = 0 then do:
     4302                    run grplib-get-root-code in this-procedure ( output v-root-code ) no-error.
     4303                    v-current-upper-node-code = v-root-code.
     4304                 end.
     4305                 else do:
     4306                   find first upper_ext-classif no-lock where
     4307                             upper_ext-classif.classif-subject = 'gds-grp':U
     4308                         and upper_ext-classif.classif-name = 'rpm_gds-grp':U
     4309                         AND upper_ext-classif.db-num = - 1
     4310                         and upper_ext-classif.charkey_one = string(v-upper-group-code)
     4311                         and upper_ext-classif.key#_one = v-upper-depart-code
     4312                         and upper_ext-classif.key#_two = v-upper-class-code
     4313                         and upper_ext-classif.key#_three = v-upper-subclass-code no-error.
     4314                   if available upper_ext-classif then do:
     4315                     RUN gen-row-keyr IN THIS-PROCEDURE ( INPUT upper_ext-classif.uniq-key-rec
     4316                                                         ,INPUT ?
     4317                                                         ,INPUT "ub"
     4318                                                         ,INPUT ?
     4319                                                         ,INPUT NO-LOCK
     4320                                                         ,OUTPUT v-rowid
     4321                                                         ,OUTPUT v-table-name) NO-ERROR.
     4322                     find first upper_gds-grp no-lock where
     4323                               rowid(upper_gds-grp) = v-rowid no-error.
     4324                     assign
     4325                     v-current-upper-node-code = upper_gds-grp.node-code.
     4326                   end.
     4327                 end.
     4328                 v-current-node-name = v-current-rpm-grp-name.
     4329                 v-calc-method = 'Учетная':U.
     4330                 v-increase-pc = 0.
     4331                 v-round-method = 'Отключено':U.
     4332                 v-base = 0.
     4333                 case v-line-status_:
     4334                   when 'U' then do:
     4335                     v-mode = 'ИЗМЕНЕНИЕ':U.
     4336                     if not available buf_ext-classif then do:
     4337                                           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Запись &1: Не найден изменяемый узел товарного классификатора RPM &2/&3/&4/&6"                                                   ,v-line-num                                                   ,v-current-group-code                                                      ,v-current-depart-code                                                     ,v-current-class-code                                                      ,v-current-subclass-code)).
     4338                         run set-err-type in p-cont-handle
     4339                           ( input 'SYNCHRONIZATION'
     4340                           ) no-error.
     4341                       undo _rule, retry _rule .
     4342                     end.
     4343                     if not available upper_ext-classif
     4344                     and v-current-upper-node-code = 0
     4345                     then do:
     4346                                           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Запись &1: Не найден вышестоящий узел изменяемого узла товарного классификатора RPM &2/&3/&4/&5"                                                   ,v-line-num                                                   ,v-upper-group-code                                                      ,v-upper-depart-code                                                     ,v-upper-class-code                                                      ,v-upper-subclass-code)).
     4347                         run set-err-type in p-cont-handle
     4348                           ( input 'SYNCHRONIZATION'
     4349                           ) no-error.
     4350                       undo _rule, retry _rule .
     4351                     end.
     4352                     v-uniq-key-rec = buf_ext-classif.uniq-key-rec.
     4353                   end.
     4354                   when 'N' then do:
     4355                     v-mode = 'ДОБАВЛЕНИЕ':U.
     4356                     if available buf_ext-classif then do:
     4357                                           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Запись &1: Уже есть добавляемый узел товарного классификатора RPM &2/&3/&4/&6"                                                   ,v-line-num                                                   ,v-current-group-code                                                      ,v-current-depart-code                                                     ,v-current-class-code                                                      ,v-current-subclass-code)).
     4358                         run set-err-type in p-cont-handle
     4359                           ( input 'SYNCHRONIZATION'
     4360                           ) no-error.
     4361                       undo _rule, retry _rule .
     4362                     end.
     4363                     if not available upper_ext-classif
     4364                     and v-current-upper-node-code = 0
     4365                     then do:
     4366                                           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Запись &1: Не найден вышестоящий узел добавляемого узла товарного классификатора RPM &2/&3/&4/&5"                                                   ,v-line-num                                                   ,v-upper-group-code                                                      ,v-upper-depart-code                                                     ,v-upper-class-code                                                      ,v-upper-subclass-code)).
     4367                         run set-err-type in p-cont-handle
     4368                           ( input 'SYNCHRONIZATION'
     4369                           ) no-error.
     4370                       undo _rule, retry _rule .
     4371                     end.
     4372                   end.
     4373                   when 'D' then do:
     4374                     v-mode = 'удаление':U.
     4375                     if not available buf_ext-classif then do:
     4376                                           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Запиь &1: Не найден удаляемый узел товарного классификатора RPM &2/&3/&4/&5"                                                   ,v-line-num                                                   ,v-current-group-code                                                      ,v-current-depart-code                                                     ,v-current-class-code                                                      ,v-current-subclass-code)).
     4377                         run set-err-type in p-cont-handle
     4378                           ( input 'SYNCHRONIZATION'
     4379                           ) no-error.
     4380                       undo _rule, retry _rule .
     4381                     end.
     4382                   end.
     4383                 end case.
     4384                 if v-mode = 'удаление':U then do:
     4385                   run ref/gdsgrp03.p ( input yes
     4386                                       ,input recid(buf_gds-grp)
     4387                                       ,input ""
     4388                                       ,input ""
     4389                                       ) no-error.
     4390                 end.
     4391                 else do:
     4392                   run ref/gdsgrp01.p ( input v-mode
     4393                                         ,input yes
     4394                                         ,input no
     4395                                         ,input (if v-mode = 'ДОБАВЛЕНИЕ':U then yes else no)
     4396                                         ,input-output v-current-node-code
     4397                                         ,input-output v-current-upper-node-code
     4398                                         ,input v-current-node-name
     4399                                         ,input v-calc-method
     4400                                         ,input v-increase-pc
     4401                                         ,input v-print-code
     4402                                         ,input v-round-method
     4403                                         ,input v-base
     4404                                         ,output v-rid ) no-error.
     4405                 end.
     4406                 if error-status:error then do:
     4407                   run set-err-type in p-cont-handle
     4408                     ( input 'PROCESSING'
     4409                     ) no-error.
     4410                   if valid-handle(v_qh) then do:
     4411                     delete object v_qh no-error.
     4412                   end.
     4413                                   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Запись &1: &2&3&4"                                              , v-line-num                                             , error-status:get-message(1)                                             , chr(10)                                             , return-value)).
     4414                   undo _rule, retry _rule .
     4415                 end.
     4416                 define variable v-old-name as character no-undo .
     4417                 v-old-name = (if available buf_ext-classif then buf_ext-classif.charkey_two else '').
     4418                 if v-mode = 'удаление':U
     4419                 or (v-mode = 'ИЗМЕНЕНИЕ':U
     4420                 and buf_ext-classif.charkey_two <> v-current-node-name)
     4421                 then do:
     4422                   run ref/extclas3.p (
     4423                                   input yes
     4424                                  ,input recid(buf_ext-classif)
     4425                                  ) no-error.
     4426                   if error-status :error then do:
     4427                     run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Запись &1: Ошибка при удалении узла товарного классификатора RPM &2/&3/&4/&5"                                                   , v-line-num                                                   ,v-current-group-code                                                      ,v-current-depart-code                                                     ,v-current-class-code                                                      ,v-current-subclass-code)).
     4428                     undo _rule, retry _rule .
     4429                   end.
     4430                 end.
     4431                 if ((v-mode = 'ИЗМЕНЕНИЕ':U
     4432                      and v-old-name <> v-current-node-name)
     4433                     or
     4434                     v-mode = 'ДОБАВЛЕНИЕ':U)
     4435                 then do:
     4436                   if v-mode = 'ДОБАВЛЕНИЕ':U then do:
     4437                     find first buf_gds-grp no-lock where
     4438                               recid(buf_gds-grp) = v-rid no-error.
     4439                     if available buf_gds-grp then do:
     4440                        run gen-key-rec in this-procedure ( input 'gds-grp':U
     4441                                                           ,input (buffer buf_gds-grp:handle)
     4442                                                           ,output v-uniq-key-rec) .
     4443                     end.
     4444                     else do:
     4445                                           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Запись &1: Не найдена вновь созданная группа товара с rid &2"                                                  , v-line-num                                                 , v-rid                                                 )).
     4446                       undo _rule, retry _rule .
     4447                     end.
     4448                   end.
     4449                   v-rec = ?.
     4450                   run ref/extclas1.p (
     4451                                         input 'ДОБАВЛЕНИЕ':U
     4452                                       ,input yes
     4453                                       ,input-output v-rec
     4454                                       ,input 'gds-grp':U
     4455                                       ,input 'rpm_gds-grp':U
     4456                                       ,input -1
     4457                                       ,input v-current-depart-code
     4458                                       ,input v-current-class-code
     4459                                       ,input v-current-subclass-code
     4460                                       ,input v-current-group-code
     4461                                       ,input v-current-node-name
     4462                                       ,input ''
     4463                                       ,input ''
     4464                                       ,input v-uniq-key-rec
     4465                                       ) no-error.
     4466                 end.
     4467                 if error-status:error then do:
     4468                   run set-err-type in p-cont-handle
     4469                     ( input 'PROCESSING'
     4470                     ) no-error.
     4471                   if valid-handle(v_qh) then do:
     4472                     delete object v_qh no-error.
     4473                   end.
     4474                                   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Запись &1: &2&3&4"                                              , v-line-num                                             , error-status:get-message(1)                                             , chr(10)                                             , return-value)).
     4475                   undo _rule, retry _rule .
     4476                 end.
     4477               end.
     4478             end.
     4479           end.
     4480         end.
     4481         v-retry-action = 0 .
     4482        _release:
     4483         do on error undo, retry:
     4484           if  retry then do:
     4485             v-retry-action = v-retry-action + 1.
     4486                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("&1&2&3"                                       , error-status:get-message(1)                                       , chr(10)                                       , v-last-error-message )).
     4487             undo _main, return error ''.
     4488           end.
     4489         if v-retry-action < 1 then do:
     4490                   ImpData1:Route-data_dump ( ) .
     4491         end.
     4492         end.
     4493         if v-retry-action = 0 then do:
     4494           num-rec-ok = num-rec-ok + 1.
     4495         end.
     4496         run write-counter in p-log-handle ( input substitute("Обработано записей: &1, из них удачно: &2", num-rec, num-rec-ok)).
     4497       end.
     4498       v_qh:query-close().
     4499       if valid-handle(v_qh) then do:
     4500         delete object v_qh.
     4501       end.
     4502     end.
     4503     run write-log-and-file in p-log-handle (
     4504           input 1
     4505         , input log-file-name
     4506         , input 1
     4507         , input substitute("Обработано записей: &1, из них удачно: &2", num-rec, num-rec-ok)).
     4508   end.
     4509   end procedure.
     4510   procedure load-ruleset-context :
     4511   define input parameter p-ruleset-id as integer no-undo .
     4512   define buffer buf_rule-call-param for ub.rule-call-param.
     4513   define buffer buf_ext-system for ub.ext-system.
     4514   do
     4515   on error undo, return error
     4516   :
     4517    find first buf_rule-call-param no-lock where
     4518   buf_rule-call-param.codex_id = p-codex-id
     4519   and buf_rule-call-param.ruleset_id = p-ruleset-id
     4520   and buf_rule-call-param.call_id = p-call-id
     4521   and buf_rule-call-param.order_id = p-order-id
     4522   and buf_rule-call-param.rule_id = p-rule-id
     4523   and buf_rule-call-param.param-name = "p-esys-id"
     4524    no-error.
     4525   if available buf_rule-call-param then do:
     4526   assign p-esys-id = buf_rule-call-param.param-value-integer.
     4527   end.
     4528       find first buf_rule-call-param no-lock where
     4529   buf_rule-call-param.codex_id = p-codex-id
     4530   and buf_rule-call-param.ruleset_id = p-ruleset-id
     4531   and buf_rule-call-param.call_id = p-call-id
     4532   and buf_rule-call-param.order_id = p-order-id
     4533   and buf_rule-call-param.rule_id = p-rule-id
     4534   and buf_rule-call-param.param-name = "p-xsd-file"
     4535    no-error.
     4536   if available buf_rule-call-param then do:
     4537   assign p-xsd-file = buf_rule-call-param.param-value-character.
     4538   end.
     4539       case p-ruleset-id:
     4540         when 4 then do:
     4541           assign
     4542           v-sign = 1
     4543           v-current-host-code = p-host-code
     4544           v-current-obj-type = p-obj-type
     4545           v-current-obj-code = p-obj-code
     4546           v-current-db-num = g#db-num
     4547           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     4548           file-name  = entry(1, p-process-file-name, chr(4))
     4549           v_dataseth = handle(entry(2, p-process-file-name, chr(4)))
     4550           v-xmlh = buffer buf_temp-xml-tables:handle
     4551           v-esys-id = integer(p-doc-code)
     4552           v-extension = entry(num-entries(file-name, "."), file-name, ".")
     4553           v-pck-num = integer(entry(3, p-process-file-name, chr(4)))
     4554           log-file-name = entry(4, p-process-file-name, chr(4))
     4555           no-error
     4556           .
     4557           if error-status:error then do:
     4558                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибки параметров&1&2 ..."                                         , chr(10)                                         , error-status:get-message(1) )).
     4559             undo, return error substitute("Ошибки параметров&1&2 ..."                                         , chr(10)                                         , error-status:get-message(1) ).
     4560           end.
     4561           find first buf_ext-system no-lock where
     4562                     buf_ext-system.esys-id = v-esys-id
     4563                 and buf_ext-system.db-num = 0 no-error .
     4564           if not available buf_ext-system then do:
     4565                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не найдена ВС &1&2 ..."                                         , v-esys-id                                         , chr(10)                                         )).
     4566             undo, return error substitute("Не найдена ВС &1&2 ..."                                         , v-esys-id                                         , chr(10)                                         ).
     4567           end.
     4568           if v-extension = ''
     4569           or lookup(v-extension, "dat") = 0 then do:
     4570                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Файл &1 имеет недопустимое расширение &3&2 ..."                                         ,file-name                                         , chr(10)                                         , v-extension                                         )).
     4571             undo, return error substitute("Файл &1 имеет недопустимое расширение &3&2 ..."                                         ,file-name                                         , chr(10)                                         , v-extension                                         ).
     4572           end.
     4573         end.
     4574         otherwise do:
     4575           undo, return error "Неправильный вызов".
     4576         end.
     4577       end case.
     4578     end.
     4579   end procedure.
     4580   procedure create_gds-grp_:
     4581   define input parameter p-node-code as integer no-undo .
     4582   define buffer buf_temp-gds-grp_ for temp-gds-grp_.
     4583   find first buf_temp-gds-grp_ where
     4584             buf_temp-gds-grp_.node-code = p-node-code no-error .
     4585   if not available buf_temp-gds-grp_ then do:
     4586     create buf_temp-gds-grp_.
     4587     assign
     4588     buf_temp-gds-grp_.node-code = p-node-code
     4589     .
     4590   end.
     4591   end procedure.
     4592   procedure can-find_gds-grp_  :
     4593   define input parameter p-node-code as integer no-undo .
     4594   define output parameter p-find as logical no-undo .
     4595   find first temp-gds-grp_ where
     4596                        temp-gds-grp_.node-code = p-node-code no-error.
     4597   p-find = available temp-gds-grp_.
     4598   end procedure.
     4599   procedure delete-procedure :
     4600     do
     4601     on error undo, return error
     4602     :
     4603         for each temp-gds-grp_:
     4604           delete temp-gds-grp_.
     4605         end.
     4606         run garbcoll_clear in this-procedure .
     4607     end.
     4608   end procedure.
