     3844                       end.
     3845                       when chr(6)
     3846                       then do:
     3847                           assign
     3848                               p-out-string = p-out-string + " ":U
     3849                           .
     3850                       end.
     3851                       when chr(7)
     3852                       then do:
     3853                           assign
     3854                               p-out-string = p-out-string + " ":U
