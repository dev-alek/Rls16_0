     3623   procedure xmlchar-test :
     3624   define input parameter p-in-string          as character        no-undo.
     3625   define output parameter p-out-string-enc    as character        no-undo.
     3626   define output parameter p-out-string-dec    as character        no-undo.
     3627   do
     3628   on error undo, return error
     3629   :
     3630          run xmlchar-encode in this-procedure
     3631       (
     3632             input p-in-string
     3633           , output p-out-string-enc
     3634       ).
     3635          run xmlchar-decode in this-procedure
     3636       (
     3637             input p-out-string-enc
     3638           , output p-out-string-dec
     3639       ).
     3640   end.
     3641   end .
     3642   procedure xmlchar-encode :
     3643   define input parameter p-in-string      as character        no-undo.
     3644   define output parameter p-out-string    as character        no-undo.
     3645       define variable v-position      as integer      no-undo.
     3646       define variable v-current-char  as character    no-undo.
     3647   do
     3648   on error undo, return error
     3649   :
     3650       assign
     3651           p-out-string = "":U
     3652       .
     3653       case p-in-string
     3654       :
     3655           when ?
     3656           then do:
     3657               assign
     3658                   p-out-string = "?":U
     3659               .
     3660           end.
     3661           when "?":U
     3662           then do:
     3663               assign
     3664                   p-out-string = "&#63;":U
     3665               .
     3666           end.
     3667           otherwise do:
     3668               do v-position = 1 to length( p-in-string )
     3669               :
     3670                   assign
     3671                       v-current-char = substring( p-in-string, v-position, 1 )
     3672                   .
     3673                   case v-current-char
     3674                   :
     3675                       when "&":U
     3676                       then do:
     3677                           assign
     3678                               p-out-string = p-out-string + "&amp;":U
     3679                           .
     3680                       end.
     3681                       when ">":U
     3682                       then do:
     3683                           assign
     3684                               p-out-string = p-out-string + "&gt;":U
     3685                           .
     3686                       end.
     3687                       when "<":U
     3688                       then do:
     3689                           assign
     3690                               p-out-string = p-out-string + "&lt;":U
     3691                           .
     3692                       end.
     3693                       when "'":U
     3694                       then do:
     3695                           assign
     3696                               p-out-string = p-out-string + "&apos;":U
     3697                           .
     3698                       end.
     3699                       when '"':U
     3700                       then do:
     3701                           assign
     3702                               p-out-string = p-out-string + "&quot;":U
     3703                           .
     3704                       end.
     3705                       when chr(1)
     3706                       then do:
     3707                           assign
     3708                               p-out-string = p-out-string + "":U
     3709                           .
     3710                       end.
     3711                       when chr(2)
     3712                       then do:
     3713                           assign
     3714                               p-out-string = p-out-string + "":U
     3715                           .
     3716                       end.
     3717                       when chr(3)
     3718                       then do:
     3719                           assign
     3720                               p-out-string = p-out-string + "":U
     3721                           .
     3722                       end.
     3723                       when chr(4)
     3724                       then do:
     3725                           assign
     3726                               p-out-string = p-out-string + "":U
     3727                           .
     3728                       end.
     3729                       when chr(5)
     3730                       then do:
     3731                           assign
     3732                               p-out-string = p-out-string + "":U
     3733                           .
     3734                       end.
     3735                       when chr(6)
     3736                       then do:
     3737                           assign
     3738                               p-out-string = p-out-string + "":U
     3739                           .
     3740                       end.
     3741                       when chr(7)
     3742                       then do:
     3743                           assign
     3744                               p-out-string = p-out-string + "":U
     3745                           .
     3746                       end.
     3747                       when chr(8)
     3748                       then do:
     3749                           assign
     3750                               p-out-string = p-out-string + "":U
     3751                           .
     3752                       end.
     3753                       when chr(9)
     3754                       then do:
     3755                           assign
     3756                               p-out-string = p-out-string + "":U
     3757                           .
     3758                       end.
     3759                       when chr(29)
     3760                       then do:
     3761                           assign
     3762                               p-out-string = p-out-string + "":U
     3763                           .
     3764                       end.
     3765                       when chr(10)
     3766                       then do:
     3767                           assign
     3768                               p-out-string = p-out-string + "&#10;":U
     3769                           .
     3770                       end.
     3771                       when chr(13)
     3772                       then do:
     3773                           assign
     3774                               p-out-string = p-out-string + "&#13;":U
     3775                           .
     3776                       end.
     3777                       otherwise do:
     3778                           assign
     3779                               p-out-string = p-out-string + v-current-char
     3780                           .
     3781                       end.
     3782                   end case.
     3783               end.
     3784           end.
     3785       end case.
     3786   end.
     3787   end .
     3788   procedure xmlchar-encode-1c :
