     2390       field rec-key       as integer
     2391       field recLevel      as integer
     2392       field recOpenLine   as integer
     2393       field recCloseLine  as integer
     2394       field recName       as character
     2395       field closed        as logical
     2396       index pi is primary unique
     2397           rec-key
     2398       index nm
     2399           recName
     2400           closed
     2401           rec-key
     2402       index cl
     2403           closed
     2404       index rlv
     2405           recName
     2406           recLevel
     2407           closed
     2408           rec-key
     2409   .
