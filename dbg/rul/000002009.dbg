     3898   procedure xmlchar-decode :
     3899   define input parameter p-in-string      as character        no-undo.
     3900   define output parameter p-out-string    as character        no-undo.
     3901       define variable v-position      as integer      no-undo.
     3902       define variable v-last-position as integer      no-undo.
     3903       define variable v-temp-integer  as integer      no-undo.
     3904       define variable v-current-char  as character    no-undo.
     3905       define variable v-next-char     as character    no-undo.
     3906       define variable v-success       as logical      no-undo.
     3907   do
     3908   on error undo, return error
     3909   :
     3910       assign
     3911           p-out-string = "":U
     3912           v-position   = 0
     3913       .
     3914       replace-cycle:
     3915       do while yes
     3916       on error undo, return error
     3917       :
     3918           assign
     3919               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     3920           .
     3921           if v-last-position <= v-position
     3922           then do:
     3923               if v-position = 0
     3924               then do:
     3925                   assign
     3926                       p-out-string = p-in-string
     3927                   .
     3928               end.
     3929               else do:
     3930                   assign
     3931                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     3932                   .
     3933               end.
     3934               leave replace-cycle.
     3935           end.
     3936           else do:
     3937               assign
     3938                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     3939                   v-position      = v-last-position
     3940                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     3941               .
     3942               if v-current-char = "#":U
     3943               then do:
     3944                   assign
     3945                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     3946                   .
     3947                   if v-last-position > 0
     3948                   then do:
     3949                       run xmlchar-read-integer in this-procedure
     3950                        (
     3951                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     3952                           , output v-temp-integer
     3953                           , output v-success
     3954                       ).
     3955                       if v-success = yes
     3956                       and v-temp-integer >= 1
     3957                       and v-temp-integer <= 255
     3958                       then do:
     3959                           assign
     3960                               p-out-string = p-out-string + chr( v-temp-integer )
     3961                               v-position   = v-last-position + 1
     3962                           .
     3963                       end.
     3964                       else do:
     3965                           assign
     3966                               p-out-string = p-out-string + "&":U
     3967                               v-position   = v-position   + 1
     3968                           .
     3969                       end.
     3970                   end.
     3971                   else do:
     3972                       assign
     3973                           p-out-string = p-out-string + "&":U
     3974                           v-position   = v-position   + 1
     3975                       .
     3976                   end.
     3977               end.
     3978               else do:
     3979                   case substring( p-in-string, v-position + 1, 3 )
     3980                   :
     3981                       when "lt;":U
     3982                       then do:
     3983                           assign
     3984                               p-out-string = p-out-string + "<":U
     3985                               v-position   = v-position   + 3
     3986                           .
     3987                       end.
     3988                       when "gt;":U
     3989                       then do:
     3990                           assign
     3991                               p-out-string = p-out-string + ">":U
     3992                               v-position   = v-position   + 3
     3993                           .
     3994                       end.
     3995                       otherwise do:
     3996                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     3997                           then do:
     3998                               assign
     3999                                   p-out-string = p-out-string + "&":U
     4000                                   v-position   = v-position   + 4
     4001                               .
     4002                           end.
     4003                           else do:
     4004                               case substring( p-in-string, v-position + 1, 5 )
     4005                               :
     4006                                   when "quot;":U
     4007                                   then do:
     4008                                       assign
     4009                                           p-out-string = p-out-string + '"':U
     4010                                           v-position   = v-position   + 5
     4011                                       .
     4012                                   end.
     4013                                   when "apos;":U
     4014                                   then do:
     4015                                       assign
     4016                                           p-out-string = p-out-string + "'":U
     4017                                           v-position   = v-position   + 5
     4018                                       .
     4019                                   end.
     4020                                   otherwise do:
     4021                                       assign
     4022                                           p-out-string = p-out-string + "&":U
     4023                                       .
     4024                                   end.
     4025                               end case.
     4026                           end.
     4027                       end.
     4028                   end case.
     4029               end.
     4030           end.
     4031       end.
     4032   end.
     4033   end .
     4034   procedure xmlchar-read-integer :
     4035   define input parameter p-input-string      as character        no-undo.
     4036   define output parameter p-output-integer   as integer          no-undo.
     4037   define output parameter p-success       as logical          no-undo.
     4038   do
     4039   on error undo, return error
     4040   :
     4041       assign
     4042           p-output-integer = integer( p-input-string )
     4043       no-error.
     4044       if error-status :error
     4045       then do:
     4046           assign
     4047               p-success           = no
     4048               p-output-integer    = 0
     4049           .
     4050       end.
     4051       else do:
     4052           assign
     4053               p-success           = yes
     4054           .
     4055       end.
     4056   end.
     4057   end.
