     3127   if valid-handle(p-call-handle)
     3128   and lookup("rcpscont_get-rule-on-off", p-call-handle:internal-entries) > 0 then do:
     3129     run rcpscont_set-rule-on-off in p-call-handle (
     3130                                              input p-codex-id
     3131                                             ,input p-ruleset-id
     3132                                             ,input p-rule-id
