     3138   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3139   PROCEDURE rcps_MyEnable0 :
     3140   DEFINE VARIABLE v-ii AS INTEGER NO-UNDO.
     3141   DEFINE VARIABLE v-ch0 AS widget-handle NO-UNDO.
     3142   ASSIGN
     3143   term_tt-rule-call-param.param-label:RESIZABLE IN browse br-rcp = YES
     3144   X_rp-rule-param.rp-param-name:RESIZABLE IN browse br-rcp = YES
     3145   .
     3146   ASSIGN
     3147   v-ch0 = br-rcp:FIRST-COLUMN IN FRAME Dialog-Frame.
     3148   REPEAT WHILE valid-handle(v-ch0):
     3149      IF v-ch0:LABEL = "Значение!(строковое)" THEN DO:
     3150        v-ch[1] = v-ch0.
     3151        v-ch0:VISIBLE = NO.
     3152      END.
     3153      IF v-ch0:LABEL = "Значение!(Дата)" THEN DO:
     3154        v-ch[2] = v-ch0.
     3155        v-ch0:VISIBLE = NO.
     3156      END.
     3157      IF v-ch0:LABEL = "Значение!(Десятичное)" THEN DO:
     3158        v-ch[3] = v-ch0.
     3159        v-ch0:VISIBLE = NO.
     3160      END.
     3161      IF v-ch0:LABEL = "Значение!(Целое)" THEN DO:
     3162        v-ch[4] = v-ch0.
     3163        v-ch0:VISIBLE = NO.
     3164      END.
     3165      IF v-ch0:LABEL = "Значение!(Логическое)" THEN DO:
     3166        v-ch[5] = v-ch0.
     3167        v-ch0:VISIBLE = NO.
     3168      END.
     3169      IF v-ch0:LABEL = "Точка вызова" THEN DO:
     3170        v-ch[6] = v-ch0.
     3171      END.
     3172      IF v-ch0:LABEL = "Значение" THEN
     3173      v-ch0:RESIZABLE = YES.
     3174      v-ch0 = v-ch0:NEXT-COLUMN.
     3175   END.
     3176   assign
     3177   X_rp-rule-param.rp-param-name:resizable in browse br-rcp = yes
     3178   term_tt-rule-call-param.param-name:resizable in browse br-rcp = yes
     3179   term_tt-rule-call-param.param-label:resizable in browse br-rcp = yes
     3180   .
     3181   CASE p-list-mode:
     3182     WHEN 'rule-call-param':U THEN DO:
     3183        ASSIGN
     3184        X_rp-rule-param.rp-param-name:VISIBLE IN BROWSE br-rcp = NO
     3185        .
     3186     END.
     3187     WHEN 'rp-rule-param':U
     3188     or
     3189     when 'rp-rule-param':U + chr(44) + 'все':U
     3190     THEN DO:
     3191       assign
     3192       term_tt-rule-call-param.codex_id:VISIBLE IN BROWSE br-rcp = NO
     3193       term_tt-rule-call-param.ruleset_id:VISIBLE IN BROWSE br-rcp = NO
     3194       term_tt-rule-call-param.rule_id:VISIBLE IN BROWSE br-rcp = NO
     3195       term_tt-rule-call-param.order_id:VISIBLE IN BROWSE br-rcp = NO
     3196       term_tt-rule-call-param.param-name:VISIBLE IN BROWSE br-rcp = NO
     3197       term_tt-rule-call-param.param-num:VISIBLE IN BROWSE br-rcp = NO
     3198       .
     3199     END.
     3200   END CASE.
     3201    IF p-call-id <> '':U THEN DO:
     3202      v-ch[6]:VISIBLE = NO.
     3203    END.
     3204     IF p-profile-id <> 0 THEN DO:
     3205      term_tt-rule-call-param.profile_id :VISIBLE IN BROWSE br-rcp= NO.
     3206    END.
     3207     IF p-rule-id <> 0 THEN DO:
     3208      term_tt-rule-call-param.RULE_id :VISIBLE IN BROWSE br-rcp= NO.
     3209    END.
     3210     IF p-once-more <> 0 THEN DO:
     3211      term_tt-rule-call-param.once-more :VISIBLE IN BROWSE br-rcp= NO.
     3212    END.
     3213   END PROCEDURE.
     3214   PROCEDURE rcps_Openbr :
     3215   CASE p-list-mode:
     3216     WHEN 'rp-rule-param':U THEN DO:
     3217         OPEN QUERY br-rcp
     3218         FOR EACH  X_ruledict-param NO-LOCK WHERE X_ruledict-param.entry-id = v-rcps-entry-id
     3219             ,FIRST X_rp-rule-param WHERE
     3220                 X_rp-rule-param.profile_id = p-profile-id
     3221             AND X_rp-rule-param.rp-param-name = X_ruledict-param.param-name
     3222           , first tt-rule-call-param WHERE
     3223              tt-rule-call-param.codex_id = X_rp-rule-param.codex_id
     3224          AND tt-rule-call-param.ruleset_id = X_rp-rule-param.ruleset_id
     3225          AND tt-rule-call-param.rule_id = X_rp-rule-param.rule_id
     3226          AND tt-rule-call-param.param-name = X_rp-rule-param.rule-param-name
     3227            ,each term_tt-rule-call-param where
     3228                  term_tt-rule-call-param.call_id = tt-rule-call-param.call_id
     3229              and term_tt-rule-call-param.codex_id = tt-rule-call-param.codex_id
     3230              and term_tt-rule-call-param.ruleset_id = tt-rule-call-param.ruleset_id
     3231              and term_tt-rule-call-param.order_id = tt-rule-call-param.order_id
     3232              and term_tt-rule-call-param.param-name = tt-rule-call-param.param-name
     3233         BY tt-rule-call-param.call_id
     3234         BY tt-rule-call-param.codex_id
     3235         BY tt-rule-call-param.ruleset_id
     3236         BY tt-rule-call-param.order_id
     3237         BY tt-rule-call-param.param-num.
     3238     END.
     3239   END CASE.
     3240   apply "ENTRY" to br-rcp in frame Dialog-Frame .
     3241   APPLy "VALUE-CHANGED" to br-rcp.
     3242   END PROCEDURE.
     3243   PROCEDURE rcps_proc-b-chg PRIVATE :
     3244   DEFINE VARIABLE v-rec1 AS Rowid NO-UNDO.
     3245   DEFINE VARIABLE v-rec2 AS Rowid NO-UNDO.
     3246   DEFINE VARIABLE v-rec3 AS Rowid NO-UNDO.
     3247   DEFINE VARIABLE v-rec4 AS Rowid NO-UNDO.
     3248   define variable v-param-data-type as character no-undo .
     3249   define variable v-rid-list as character no-undo .
     3250   IF NOT AVAILABLE TERM_tt-rule-call-param  THEN DO:
     3251     RETURN ERROR.
     3252   END.
     3253   ASSIGN
     3254   v-rec1 = rowid(X_ruledict-param)
     3255   v-rec2 = rowid(X_rp-rule-param)
     3256   v-rec3 = Rowid(tt-rule-call-param)
     3257   v-rec4 = Rowid(term_tt-rule-call-param)
     3258   .
     3259   run rcps_openbr in this-procedure .
     3260   REPOSITION br-rcp TO Rowid v-rec1, v-rec2,v-rec3, v-rec4 NO-ERROR.
     3261   IF ERROR-STATUS:ERROR THEN DO:
     3262     REPOSITION br-rcp TO ROW 1 NO-ERROR.
     3263   END.
     3264   APPLY "ENTRY" TO br-rcp in frame Dialog-Frame .
     3265   APPLY "VALUE-CHANGED" TO br-rcp in frame Dialog-Frame .
     3266   END PROCEDURE.
     3267   PROCEDURE rcps_set-row-color :
     3268   DEFINE INPUT PARAMETER p-data-type AS CHARACTER NO-UNDO.
     3269   ASSIGN
     3270   v-ch[1]:FGCOLOR = GREY_COLOR
     3271   v-ch[1]:BGCOLOR = GREY_Color
     3272   v-ch[1]:PFCOLOR = GREY_Color
     3273   v-ch[2]:FGCOLOR = GREY_COLOR
     3274   v-ch[2]:BGCOLOR = GREY_Color
     3275   v-ch[2]:PFCOLOR = GREY_Color
     3276   v-ch[3]:FGCOLOR = GREY_COLOR
     3277   v-ch[3]:BGCOLOR = GREY_Color
     3278   v-ch[3]:PFCOLOR = GREY_Color
     3279   v-ch[4]:FGCOLOR = GREY_COLOR
     3280   v-ch[4]:BGCOLOR = GREY_Color
     3281   v-ch[4]:PFCOLOR = GREY_Color
     3282   v-ch[5]:FGCOLOR = GREY_COLOR
     3283   v-ch[5]:BGCOLOR = GREY_Color
     3284   v-ch[5]:PFCOLOR = GREY_Color
     3285   .
     3286   CASE entry(1, p-data-type):
     3287        WHEN 'character':U THEN DO:
     3288         ASSIGN
     3289         v-ch[1]:FGCOLOR = BLACK_COLOR
     3290         v-ch[1]:BGCOLOR = WHITE_Color.
     3291       END.
     3292       WHEN 'decimal':U THEN DO:
     3293         ASSIGN
     3294         v-ch[3]:FGCOLOR = BLACK_COLOR
     3295         v-ch[3]:BGCOLOR = WHITE_Color.
     3296       END.
     3297       WHEN 'integer':U THEN DO:
     3298         ASSIGN
     3299         v-ch[4]:FGCOLOR = BLACK_COLOR
     3300         v-ch[4]:BGCOLOR = WHITE_Color.
     3301       END.
     3302       WHEN 'date':U THEN DO:
     3303         ASSIGN
     3304         v-ch[2]:FGCOLOR = BLACK_COLOR
     3305         v-ch[2]:BGCOLOR = WHITE_Color.
     3306        END.
     3307        WHEN 'logical':U THEN DO:
     3308          ASSIGN
     3309          v-ch[5]:FGCOLOR = BLACK_COLOR
     3310          v-ch[5]:BGCOLOR = WHITE_Color.
     3311        END.
     3312   END CASE.
     3313   END PROCEDURE.
     3314   MAIN-BLOCK:
     3315   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3316      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3317   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3318     run mainmenu_getcntxt in parparentproc
     3319       (output v-cntxt-db-num
     3320       ,output v-cntxt-userid
     3321       ,output v-cntxt-level
     3322       ,output v-cntxt-host-code-obj
     3323       ,output v-cntxt-obj-type
     3324       ,output v-cntxt-obj-code
     3325       ,output v-cntxt-db-num-obj
     3326       ,output v-cntxt-is-admin
     3327       ) .
     3328      run gbl/dftempl.p ( input 'rp-rule-param':U
     3329                        , output v-dflt-rec) no-error.
     3330       if error-status:error then dO:
     3331         message
     3332         vss-workfile vss-revision vss-description skip
     3333         "Невозможно найти recid template записи в таблице rp-rule-param"
     3334         view-as alert-box error .
     3335         return error.
     3336       end.
     3337       run gbl/dftempl.p ( input 'ruledict-param':U
     3338                         , output v-rp-dflt-rec) no-error.
     3339        if error-status:error then dO:
     3340          message
     3341          vss-workfile vss-revision vss-description skip
     3342          "Невозможно найти recid template записи в таблице ruledict-param"
     3343          view-as alert-box error .
     3344          return error.
     3345        end.
     3346     IF p-list-mode = 'rp-rule-param':U
     3347     THEN DO:
     3348       FIND FIRST buf_rule-profile NO-LOCK WHERE
     3349                 buf_rule-profile.profile_id = p-profile-id.
     3350       run gen-key-rec in this-procedure ( input 'rule-profile':U
     3351                                       ,input buffer buf_rule-profile:handle
     3352                                       ,output v-uniq-key-rec).
     3353       FIND FIRST buf_ruledict NO-LOCK WHERE
     3354                 buf_ruledict.entry-type = 'rule-profile':U
     3355          AND  buf_ruledict.uniq-key-rec = v-uniq-key-rec.
     3356       v-rcps-entry-id = buf_ruledict.entry-id.
     3357     END.
     3358     ELSE DO:
     3359        MESSAGE
     3360        substitute("Неверное значение параметра p-list-mode=&1", p-list-mode)
     3361        VIEW-AS alert-box.
     3362     END.
     3363     if p-call-id begins 'schedule':U then do:
     3364       v-running-mode = yes.
     3365     end.
     3366     RUN rcps_fill-table IN THIS-PROCEDURE ( input yes).
     3367     RUN Myenable in THIS-PROCEDURE.
     3368     WAIT-FOR GO OF FRAME Dialog-Frame.
     3369   END.
     3370   RUN disable_UI.
     3371   PROCEDURE disable_UI :
     3372     HIDE FRAME Dialog-Frame.
     3373   END PROCEDURE.
     3374   PROCEDURE enable_UI :
     3375     DISPLAY e-shops f-keep-days f-luft-days
     3376         WITH FRAME Dialog-Frame.
     3377     ENABLE B-exit b-quit B-Help BR-rcp button-obj f-keep-days f-luft-days
     3378         WITH FRAME Dialog-Frame.
     3379     VIEW FRAME Dialog-Frame.
     3380   END PROCEDURE.
     3381   PROCEDURE MyEnable :
     3382   define variable v-list as character no-undo .
     3383   define variable glog as logical no-undo .
     3384   define variable v-index-id as integer no-undo .
     3385   define variable v-value-character as character no-undo .
     3386   define variable v-value-date as date no-undo .
     3387   define variable v-value-decimal as decimal no-undo .
     3388   define variable v-value-integer as integer no-undo .
     3389   define variable v-value-logical as logical no-undo .
     3390   define variable v-shop-code as integer no-undo .
     3391   define buffer buf_clob-bind for ub.clob-bind.
     3392   run rcps_Myenable0 in this-procedure .
     3393   v-index-id = -1.
     3394   for each obj-list:
     3395     delete obj-list.
     3396   end.
     3397   RUN rcps_get-value IN THIS-PROCEDURE (
     3398                                    INPUT p-profile-id
     3399                                   ,INPUT p-once-more
     3400                                   ,INPUT p-call-id
     3401                                   ,INPUT "p-keep-days"
     3402                                   ,INPUT-output v-index-id
     3403                                   ,output v-value-character
     3404                                   ,output v-value-date
     3405                                   ,output v-value-decimal
     3406                                   ,output f-keep-days
     3407                                   ,output v-value-logical
     3408                                   ).
     3409   v-index-id = 0.
     3410   RUN rcps_get-value IN THIS-PROCEDURE (
     3411                                    INPUT p-profile-id
     3412                                   ,INPUT p-once-more
     3413                                   ,INPUT p-call-id
     3414                                   ,INPUT "p-luft-days"
     3415                                   ,INPUT-output v-index-id
     3416                                   ,output v-value-character
     3417                                   ,output v-value-date
     3418                                   ,output v-value-decimal
     3419                                   ,output f-luft-days
     3420                                   ,output v-value-logical
     3421                                   ).
     3422   v-index-id = 0.
     3423   do while v-index-id >= 0 :
     3424     RUN rcps_get-value IN THIS-PROCEDURE (
     3425                                      INPUT p-profile-id
     3426                                     ,INPUT p-once-more
     3427                                     ,INPUT p-call-id
     3428                                     ,INPUT "p-shops"
     3429                                     ,INPUT-output v-index-id
     3430                                     ,output v-value-character
     3431                                     ,output v-value-date
     3432                                     ,output v-value-decimal
     3433                                     ,output v-shop-code
     3434                                     ,output v-value-logical
     3435                                     ) no-error .
     3436     if error-status:error then v-index-id = -1.
     3437     else do:
     3438         find first obj-list where
     3439                 obj-list.obj-type =  'маг':U
     3440             and obj-list.obj-code =  v-shop-code no-error.
     3441         if available obj-list then  next.
     3442   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3443   run create_obj-list in this-procedure
     3444    ( input 'маг':U ,
     3445      input v-shop-code )
     3446      .
     3447       find first obj-list where
     3448             obj-list.obj-code = v-shop-code
     3449           and obj-list.obj-type = 'маг':U no-error.
     3450       if available obj-list then do:
     3451         glog = e-shops:INSERT-STRING ( display-shop(v-shop-code
     3452                                                     ,obj-list.obj-name )) in frame Dialog-Frame .
     3453         glog = e-shops:INSERT-STRING ( chr(10) ) in frame Dialog-Frame .
     3454       end.
     3455     end.
     3456   end.
     3457   ASSIGN
     3458   term_tt-rule-call-param.param-label:RESIZABLE IN browse br-rcp = YES
     3459   X_rp-rule-param.rp-param-name:RESIZABLE IN browse br-rcp = YES
     3460   .
     3461   DEFINE VARIABLE v-ch0 AS widget-handle NO-UNDO.
     3462   ASSIGN
     3463   v-ch0 = br-rcp:FIRST-COLUMN IN FRAME Dialog-Frame.
     3464   REPEAT WHILE valid-handle(v-ch0):
     3465      IF v-ch0:LABEL = "Значение!(строковое)" THEN DO:
     3466        v-ch[1] = v-ch0.
     3467        v-ch0:VISIBLE = NO.
     3468      END.
     3469      IF v-ch0:LABEL = "Значение!(Дата)" THEN DO:
     3470        v-ch[2] = v-ch0.
     3471        v-ch0:VISIBLE = NO.
     3472      END.
     3473      IF v-ch0:LABEL = "Значение!(Десятичное)" THEN DO:
     3474        v-ch[3] = v-ch0.
     3475        v-ch0:VISIBLE = NO.
     3476      END.
     3477      IF v-ch0:LABEL = "Значение!(Целое)" THEN DO:
     3478        v-ch[4] = v-ch0.
     3479        v-ch0:VISIBLE = NO.
     3480      END.
     3481      IF v-ch0:LABEL = "Значение!(Логическое)" THEN DO:
     3482        v-ch[5] = v-ch0.
     3483        v-ch0:VISIBLE = NO.
     3484      END.
     3485      IF v-ch0:LABEL = "Точка вызова" THEN DO:
     3486        v-ch[6] = v-ch0.
     3487      END.
     3488      IF v-ch0:LABEL = "Значение" THEN
     3489      v-ch0:RESIZABLE = YES.
     3490      v-ch0 = v-ch0:NEXT-COLUMN.
     3491   END.
     3492   assign
     3493   X_rp-rule-param.rp-param-name:resizable in browse br-rcp = yes
     3494   term_tt-rule-call-param.param-name:resizable in browse br-rcp = yes
     3495   term_tt-rule-call-param.param-label:resizable in browse br-rcp = yes
     3496   .
     3497   CASE p-list-mode:
     3498     WHEN 'rule-call-param':U THEN DO:
     3499        ASSIGN
     3500        X_rp-rule-param.rp-param-name:VISIBLE IN BROWSE br-rcp = NO
     3501        .
     3502     END.
     3503     WHEN 'rp-rule-param':U
     3504     or
     3505     when 'rp-rule-param':U + chr(44) + 'все':U
     3506     THEN DO:
     3507       assign
     3508       term_tt-rule-call-param.codex_id:VISIBLE IN BROWSE br-rcp = NO
     3509       term_tt-rule-call-param.ruleset_id:VISIBLE IN BROWSE br-rcp = NO
     3510       term_tt-rule-call-param.rule_id:VISIBLE IN BROWSE br-rcp = NO
     3511       term_tt-rule-call-param.order_id:VISIBLE IN BROWSE br-rcp = NO
     3512       term_tt-rule-call-param.param-name:VISIBLE IN BROWSE br-rcp = NO
     3513       term_tt-rule-call-param.param-num:VISIBLE IN BROWSE br-rcp = NO
     3514       .
     3515     END.
     3516   END CASE.
     3517    IF p-call-id <> '':U THEN DO:
     3518      v-ch[6]:VISIBLE = NO.
     3519    END.
     3520     IF p-profile-id <> 0 THEN DO:
     3521      term_tt-rule-call-param.profile_id :VISIBLE IN BROWSE br-rcp= NO.
     3522    END.
     3523     IF p-rule-id <> 0 THEN DO:
     3524      term_tt-rule-call-param.RULE_id :VISIBLE IN BROWSE br-rcp= NO.
     3525    END.
     3526     IF p-once-more <> 0 THEN DO:
     3527      term_tt-rule-call-param.once-more :VISIBLE IN BROWSE br-rcp= NO.
     3528    END.
     3529   display
     3530   f-keep-days
     3531   f-luft-days
     3532   with frame Dialog-Frame .
     3533   VIEW FRAME Dialog-Frame.
     3534   ENABLE
     3535   f-keep-days WHEN p-mode <> 'ПРОСМОТР':U
     3536   f-luft-days WHEN p-mode <> 'ПРОСМОТР':U
     3537   B-exit WHEN p-mode <> 'ПРОСМОТР':U
     3538   b-quit
     3539   button-obj  WHEN p-mode <> 'ПРОСМОТР':U
     3540   e-shops
     3541   WITH FRAME Dialog-Frame.
     3542   VIEW FRAME Dialog-Frame.
     3543   assign
     3544   e-shops:read-only in frame Dialog-Frame = yes.
     3545   IF p-mode = 'ПРОСМОТР':U THEN DO:
     3546      ASSIGN
     3547      b-quit:COLUMN = 1
     3548      b-quit:LABEL = "&Выход".
     3549      HIDE
     3550      b-exit
     3551      IN FRAME Dialog-Frame.
     3552   END.
     3553   ASSIGN
     3554   FRAME Dialog-Frame:TITLE = substitute("Параметры удаления с касс партионных кодов по флагам ЗАКОНЧИВШИХСЯ партий по товару, продающемуся по партиям (профайл &1)", p-profile-id).
     3555   APPLY "ENTRY" to e-shops.
     3556   APPLY "CTRL-HOME" to e-shops.
     3557   if p-mode = 'ПРОСМОТР':U then do:
     3558     APPLY "ENTRY" to b-quit.
     3559   end.
     3560   else do:
     3561     APPLY "ENTRY" to f-keep-days.
     3562   end.
     3563   END PROCEDURE.
     3564   PROCEDURE proc-save :
     3565   define variable v-ii as integer   no-undo .
     3566   v-ii = 0.
     3567   assign
     3568   frame Dialog-Frame
     3569   f-keep-days
     3570   f-luft-days
     3571   .
     3572   RUN rcps_set-value IN THIS-PROCEDURE (
     3573                                   INPUT p-profile-id
     3574                                   ,INPUT p-once-more
     3575                                   ,INPUT p-call-id
     3576                                   ,INPUT "p-keep-days"
     3577                                   ,INPUT 0
     3578                                   ,INPUT ''
     3579                                   ,INPUT ?
     3580                                   ,INPUT 0.0
     3581                                   ,INPUT f-keep-days
     3582                                   ,INPUT NO
     3583                                   ).
     3584   RUN rcps_set-value IN THIS-PROCEDURE (
     3585                                   INPUT p-profile-id
     3586                                   ,INPUT p-once-more
     3587                                   ,INPUT p-call-id
     3588                                   ,INPUT "p-luft-days"
     3589                                   ,INPUT 0
     3590                                   ,INPUT ''
     3591                                   ,INPUT ?
     3592                                   ,INPUT 0.0
     3593                                   ,INPUT f-luft-days
     3594                                   ,INPUT NO
     3595                                   ).
     3596   for each obj-list :
     3597   v-ii = v-ii + 1.
     3598   RUN rcps_set-value IN THIS-PROCEDURE (
     3599                                   INPUT p-profile-id
     3600                                   ,INPUT p-once-more
     3601                                   ,INPUT p-call-id
     3602                                   ,INPUT "p-shops"
     3603                                   ,INPUT v-ii
     3604                                   ,INPUT ''
     3605                                   ,INPUT ?
     3606                                   ,INPUT 0.0
     3607                                   ,INPUT obj-list.obj-code
     3608                                   ,INPUT NO
     3609                                   ).
     3610   END.
     3611   v-ii = v-ii + 1.
     3612   do while true:
     3613     run rcps_proc-b-del in this-procedure  (
     3614                                            INPUT p-profile-id
     3615                                           ,INPUT p-once-more
     3616                                           ,INPUT p-call-id
     3617                                           ,input "p-shops"
     3618                                           ,input v-ii) no-error.
     3619     if error-status:error
     3620     or return-value = "not-found" then leave.
     3621     v-ii = v-ii + 1.
     3622   end.
     3623   run rcps_proc-save0 in this-procedure .
     3624   END PROCEDURE.
     3625   PROCEDURE select-objects-proc :
     3626   define variable v-ii as integer   no-undo .
     3627   define variable v-rid-list as character no-undo .
     3628   define variable glog AS LOGICAL no-undo .
     3629   define buffer buf_sysconf for ub.sysconf.
     3630   define buffer buf_clients for ub.clients.
     3631   ASSIGN
     3632   e-shops:SCREEN-VALUE IN FRAME Dialog-Frame = ''.
     3633   for each obj-list :
     3634       find first buf_clients no-lock where
     3635                 buf_clients.obj-type = obj-list.obj-type
     3636             and buf_clients.obj-code = obj-list.obj-code
     3637                 no-error.
     3638       if available buf_clients then do:
     3639         v-rid-list = v-rid-list + (if v-rid-list = '' then '' else chr(44)) + string(recID(BUF_clients)).
     3640       end.
     3641     delete obj-list.
     3642   end.
     3643   run ref/thobjs.w
     3644       ( input parparentproc
     3645       , input this-procedure:handle
     3646       , input "b-mark,b-sel"
     3647       , input (if v-running-mode then "db" else 'все':U)
     3648       , input 'маг':U
     3649       , input (if v-running-mode then v-cntxt-db-num else ?)
     3650       , input ?
     3651       , input-output v-rid-list ) no-error .
     3652   if v-rid-list <> '' then do:
     3653     do v-ii = 1 to num-entries(v-rid-list):
     3654       find first buf_clients no-lock where
     3655                 recid(buf_clients) = integer(entry(v-ii, v-rid-list)) no-error.
     3656       if available buf_clients then do:
     3657   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3658   run create_obj-list in this-procedure
     3659    ( input buf_clients.obj-type ,
     3660      input buf_clients.obj-code )
     3661      .
     3662          find first obj-list where
     3663               obj-list.obj-code = buf_clients.obj-code
     3664            and obj-list.obj-type = buf_clients.obj-type.
     3665         glog = e-shops:INSERT-STRING ( display-shop(
     3666                                                    buf_clients.obj-code
     3667                                                    , obj-list.obj-name )) in frame Dialog-Frame .
     3668          glog = e-shops:INSERT-STRING ( chr(10) ) in frame Dialog-Frame .
     3669       end.
     3670     end.
     3671   end.
     3672   else do:
     3673     undo, return error .
     3674   end.
     3675   END PROCEDURE.
