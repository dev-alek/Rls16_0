     1249        LABEL "Помо&щь"
     1250        SIZE 3 BY 1
     1251        BGCOLOR 8 .
     1252   DEFINE BUTTON b-quit AUTO-END-KEY
     1253        LABEL "&Отмена"
     1254        SIZE 10 BY 1
     1255        BGCOLOR 8 .
     1256   DEFINE BUTTON button-obj
     1257        IMAGE-UP FILE "btn-down-arrow":U
     1258        IMAGE-DOWN FILE "btn-down-arrow":U
     1259        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1260        LABEL "..."
     1261        SIZE 3.6 BY 1.03.
     1262   DEFINE VARIABLE e-shops AS CHARACTER
     1263        VIEW-AS EDITOR SCROLLBAR-VERTICAL NO-BOX
     1264        SIZE 66.5 BY 13.07
     1265        FGCOLOR 1  NO-UNDO.
     1266   DEFINE VARIABLE f-keep-days AS INTEGER FORMAT ">>,>>9":U INITIAL 0
     1267        LABEL "Код ЗАКОНЧИВШЕЙСЯ партии будет удалятся с кассы через (дн.)"
     1268        VIEW-AS FILL-IN
     1269        SIZE 10.5 BY 1 NO-UNDO.
     1270   DEFINE VARIABLE f-luft-days AS INTEGER FORMAT ">>,>>9":U INITIAL 0
     1271        LABEL "Код считается удаленным через (дн)"
     1272        VIEW-AS FILL-IN
     1273        SIZE 10.5 BY 1 NO-UNDO.
     1274   DEFINE QUERY BR-rcp FOR
     1275         X_ruledict-param,
     1276         X_rp-rule-param,
     1277         tt-rule-call-param,
     1278         TERM_tt-rule-call-param SCROLLING.
     1279   DEFINE BROWSE BR-rcp
     1280     QUERY BR-rcp DISPLAY
     1281         X_rp-rule-param.rp-param-name COLUMN-LABEL "Название пар-ра!профайла" FORMAT "X(20)" width 16
     1282   term_tt-rule-call-param.codex_id COLUMN-LABEL "Кодекс"
     1283   term_tt-rule-call-param.ruleset_id COLUMN-LABEL "Набор"
     1284   term_tt-rule-call-param.order_id  COLUMN-LABEL "Порядок!вызова"
     1285   term_tt-rule-call-param.rule_id  COLUMN-LABEL "Правило"
     1286   term_tt-rule-call-param.profile_id  COLUMN-LABEL "Профайл"
     1287   term_tt-rule-call-param.once-more COLUMN-LABEL "№!Привязки"
     1288   (if lookup (term_tt-rule-call-param.param-data-type, 'character,date,datetime,datetime-tz,decimal,integer,void,logical,memptr,raw,recid,rowid,widget-handle,handle,blob,clob,class,com-handle,longchar,int64':U) > 0 then entry (lookup (term_tt-rule-call-param.param-data-type, 'character,date,datetime,datetime-tz,decimal,integer,void,logical,memptr,raw,recid,rowid,widget-handle,handle,blob,clob,class,com-handle,longchar,int64':U), 'строка,дата,дата-время,дата-время-з,десятичное,целое,пусто,логическое,память,двоичные,номер записи,Номер Записи,ссылка,ссылка,Больш.бин.объект,Больш.стр.объект,Объект,COM-объект,Длинная строка,64Целое':U) else term_tt-rule-call-param.param-data-type) COLUMN-LABEL "Тип пар-ра" FORMAT "X(12)"
     1289   term_tt-rule-call-param.param-num COLUMN-LABEL "№!пар-ра" FORMAT ">9"
     1290   TERM_tt-rule-call-param.p-index COLUMN-LABEL "Инд!екс" FORMAT ">9"
     1291   term_tt-rule-call-param.param-name COLUMN-LABEL "Название пар-ра!правила" FORMAT "X(16)"
     1292   term_tt-rule-call-param.param-label COLUMN-LABEL "Название пар-ра" FORMAT "X(255)" WIDTH 30
     1293   entry (lookup (term_tt-rule-call-param.param-mode, 'input,output,input-output,buffer,input table,output table,input-output table':u), 'вх,вых,вх-вых,курсор,вх табл,вых табл,вх/вых табл':u) COLUMN-LABEL "Вид!пар-ра"
     1294   get-param-value( INPUT term_tt-rule-call-param.param-data-type
     1295                   ,INPUT term_tt-rule-call-param.param-2-data-type
     1296                   ,INPUT term_tt-rule-call-param.param-3-data-type
     1297                   ,INPUT TERM_tt-rule-call-param.p-index
     1298                   ,INPUT term_tt-rule-call-param.param-value-character
     1299                   ,INPUT term_tt-rule-call-param.param-value-date
     1300                   ,INPUT term_tt-rule-call-param.param-value-decimal
     1301                   ,INPUT term_tt-rule-call-param.param-value-integer
     1302                   ,INPUT term_tt-rule-call-param.param-value-logical) COLUMN-LABEL "Значение" FORMAT "X(255)" WIDTH 26
     1303   (IF term_tt-rule-call-param.param-data-type = 'character':U
     1304    THEN term_tt-rule-call-param.param-value-character
     1305    ELSE '':U) COLUMN-LABEL "Значение!(строковое)" FORMAT "X(26)"
     1306   (IF term_tt-rule-call-param.param-data-type = 'date':U
     1307   THEN STRING(term_tt-rule-call-param.param-value-date, "99/99/9999")
     1308   ELSE '':U)    COLUMN-LABEL "Значение!(Дата)" FORMAT "X(10)" WIDTH 12
     1309   (IF term_tt-rule-call-param.param-data-type = 'decimal':U
     1310   THEN STRING(term_tt-rule-call-param.param-value-decimal)
     1311   ELSE '':U) COLUMN-LABEL "Значение!(Десятичное)"   FORMAT "X(16)"
     1312   (IF term_tt-rule-call-param.param-data-type = 'integer':U
     1313   THEN STRING(term_tt-rule-call-param.param-value-integer)
     1314   ELSE '':U) COLUMN-LABEL "Значение!(Целое)" FORMAT "X(10)"
     1315   (IF term_tt-rule-call-param.param-data-type = 'logical':U
     1316   THEN STRING(term_tt-rule-call-param.param-value-logical, "+/-")
     1317   ELSE '':U) COLUMN-LABEL "Значение!(Логическое)" FORMAT "X(2)"
     1318   calldscr(tt-rule-call-param.call_id) COLUMN-LABEL  "Точка вызова" FORMAT "X(40)"
     1319       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 6
     1320            FONT 4 ROW-HEIGHT-CHARS .67 FIT-LAST-COLUMN.
     1321   DEFINE FRAME Dialog-Frame
     1322        B-exit AT ROW 1 COL 1
     1323        b-quit AT ROW 1 COL 11
     1324        B-Help AT ROW 1 COL 95
     1325        BR-rcp AT ROW 2 COL 1 WIDGET-ID 100
     1326        button-obj AT ROW 3.13 COL 3 WIDGET-ID 52
     1327        e-shops AT ROW 3.13 COL 7.5 NO-LABEL WIDGET-ID 54
     1328        f-keep-days AT ROW 17 COL 60 COLON-ALIGNED WIDGET-ID 74
     1329        f-luft-days AT ROW 18.33 COL 60 COLON-ALIGNED WIDGET-ID 76
     1330        "от начала удаления" VIEW-AS TEXT
     1331             SIZE 20 BY .8 AT ROW 18.33 COL 73 WIDGET-ID 80
     1332        "Магазины, в которых удаляются партионные коды" VIEW-AS TEXT
     1333             SIZE 48 BY 1.07 AT ROW 2.07 COL 2.5 WIDGET-ID 72
     1334             FGCOLOR 4
     1335        SPACE(48.50) SKIP(20.11)
     1336       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1337            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1338            TITLE ""
     1339            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
     1340   ASSIGN
     1341          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1342          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1343   ASSIGN
     1344          BR-rcp:HIDDEN  IN FRAME Dialog-Frame                = TRUE.
     1345   ASSIGN
     1346          e-shops:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     1347   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1348   DO:
     1349     APPLY "END-ERROR":U TO SELF.
     1350   END.
     1351   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
     1352   DO:
     1353     RUN proc-save IN THIS-PROCEDURE  NO-ERROR.
     1354     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1355   END.
     1356   ON CHOOSE OF button-obj IN FRAME Dialog-Frame
     1357   DO:
     1358     run select-objects-proc in this-procedure no-error.
     1359   END.
     1360   ON ROW-DISPLAY OF br-rcp IN frame Dialog-Frame
     1361   DO:
     1362     IF AVAIL tt-rule-call-param THEN DO:
     1363       RUN rcps_set-row-color IN THIS-PROCEDURE ( INPUT term_tt-rule-call-param.param-data-type).
     1364     END.
     1365   END.
     1366   ON f6 anywhere DO:
     1367     ASSIGN
     1368     br-rcp:VISIBLE IN FRAME Dialog-Frame = (NOT br-rcp:VISIBLE IN FRAME Dialog-Frame)
     1369     .
     1370   END.
     1371   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1372   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1373   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1374   on help of frame Dialog-Frame
     1375   do:
     1376     run gbl/app_help.p
     1377       (input this-procedure :file-name
     1378       ,input ''
     1379       ,input ?
     1380       ) no-error.
     1381     if error-status :error then do:
     1382       message
     1383         "Ошибка при вызове помощи"
     1384         error-status :get-message(1)
     1385         view-as alert-box .
     1386     end.
     1387   end.
     1388   run minbtn-set in this-procedure .
     1389   on choose of b-help in frame Dialog-Frame
     1390   do:
     1391     apply "help":u to frame Dialog-Frame .
     1392   end.
     1393   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1394   procedure minbtn-set :
     1395       do
     1396           on error undo, return error return-value
     1397           :
     1398           define variable ii              as integer       no-undo .
     1399           define variable fh              as widget-handle no-undo .
     1400           define variable hh              as widget-handle no-undo .
     1401           define variable v-h             as handle        extent 4 no-undo .
     1402           define variable v-name-button   as character     no-undo .
     1403           define variable v-help-old-x    as decimal       no-undo .
     1404           define variable v-help-old-y    as decimal       no-undo .
     1405           define variable v-help-old-size as decimal       no-undo .
     1406           define variable v-frame-width   as decimal       no-undo .
     1407           define variable jj              as integer       no-undo .
     1408           do
     1409               on error undo, return error
     1410               :
     1411               assign
     1412                   v-frame-width = frame Dialog-Frame:width - 0.3
     1413                   fh            = frame Dialog-Frame:first-child
     1414                   hh            = fh:first-child
     1415                   ii            = 1
     1416                   .
     1417               do while valid-handle(hh):
     1418                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1419                   do:
     1420                       case lc(hh:name) :
     1421                           when "b-help" then
     1422                               do:
     1423                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1424                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1425                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1426                                   hh:TOOLTIP = "Помощь" .
     1427                                   v-help-old-x = hh:column .
     1428                                   v-help-old-y = hh:row    .
     1429                                   v-help-old-size = hh:width .
     1430                                   hh:width-chars = 2.5 .
     1431                               end.
     1432                           when "b-print" then
     1433                               do:
     1434                                   hh:load-image("cmp/b-print.bmp":u) .
     1435                                   hh:TOOLTIP = "Печать" .
     1436                                   v-h[ii] = hh:handle .
     1437                                   ii = ii + 1 .
     1438                                   hh:width-chars = 3 .
     1439                               end.
     1440                           when "b-history" or
     1441                           when "b-hist" then
     1442                               do:
     1443                                   hh:load-image("cmp/b-hist.bmp":u) .
     1444                                   hh:TOOLTIP = "История" .
     1445                                   v-h[ii] = hh:handle .
     1446                                   ii = ii + 1 .
     1447                                   hh:width-chars = 3 .
     1448                               end.
     1449                           when "b-sch" then
     1450                               do:
     1451                                   hh:load-image("cmp/b-sch.bmp":u) .
     1452                                   hh:TOOLTIP = "Установка Фильтра" .
     1453                                   v-h[ii] = hh:handle .
     1454                                   ii = ii + 1 .
     1455                                   hh:width-chars = 3 .
     1456                               end.
     1457                           when "b-hist-user" then
     1458                               do:
     1459                                   hh:load-image("cmp/b-hist.bmp":u) .
     1460                                   hh:TOOLTIP = "История пользователя" .
     1461                                   ii = ii + 1 .
     1462                               end.
     1463                       end case.
     1464                   end.
     1465                   hh = hh:next-sibling.
     1466               end.
     1467               b-help:column = v-frame-width - b-help:width-chars.
     1468               jj = 0.
     1469               repeat ii = 4 to 1 by -1 :
     1470                   if valid-handle (v-h[ii] ) then
     1471                   do:
     1472                       jj  = jj + 1 .
     1473                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1474                       v-h[ii]:row    = v-help-old-y .
     1475                   end.
     1476               end.
     1477           end.
     1478       end.
     1479   end procedure.
     1480   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1481   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1482   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1483   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1484   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1485   define variable v-diasize-current-frame-height as decimal   no-undo .
     1486   define variable v-diasize-change-size          as logical   no-undo .
     1487   define variable v-diasize-resize-button        as handle    no-undo .
     1488   define variable v-diasize-wndmax               as logical   no-undo .
     1489   define variable v-diasize-wndstore             as logical   no-undo .
     1490   define variable v-diasize-proc-name            as character no-undo .
     1491   define variable v-diasize-browse-handle        as handle    no-undo .
     1492   define variable v-diasize-browse-number        as integer   no-undo .
     1493   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1494   define temp-table temp-diasize-handle no-undo
     1495     field handle-value  as handle
     1496     field save-position as decimal
     1497     index xpk is primary unique handle-value
     1498     .
     1499   define temp-table temp-browse-handle no-undo
     1500     field browse-type   as character
     1501     field browse-number as integer
     1502     field browse-handle as handle
     1503     field original-size as decimal
     1504     index xpk is primary unique browse-type browse-number
     1505     index xie browse-type browse-handle
     1506   .
     1507   procedure diasize_change-height :
     1508     define input  parameter p-change-value  as decimal   no-undo .
     1509     define input  parameter p-move-resize   as logical   no-undo .
     1510     define variable v-field-group-handle    as handle    no-undo .
     1511     define variable v-object-handle         as handle    no-undo .
     1512     define variable v-frame-height          as decimal   no-undo .
     1513     define variable v-frame-virtual-height  as decimal   no-undo .
     1514     define variable v-browse-height         as decimal   no-undo .
     1515     define variable v-window-height         as decimal   no-undo .
     1516     define variable v-window-virtual-height as decimal   no-undo .
     1517     define variable v-change-sign           as integer   no-undo .
     1518     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1519     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1520     if p-change-value > 0
     1521     then do:
     1522       if frame Dialog-Frame :height + p-change-value
     1523           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1524       then do:
     1525         assign
     1526           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1527                           - (frame Dialog-Frame :height-chars)
     1528         .
     1529         if p-change-value <= 0
     1530         then do:
     1531           run diasize_position-resize-button in this-procedure .
     1532           return .
     1533         end.
     1534       end.
     1535     end.
     1536     if p-change-value < 0
     1537     then do:
     1538       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1539       then do:
     1540         assign
     1541           p-change-value = v-diasize-orig-frame-height
     1542                          - (frame Dialog-Frame :height-chars)
     1543         .
     1544         if p-change-value >= 0
     1545         then do:
     1546           run diasize_position-resize-button in this-procedure .
     1547           return .
     1548         end.
     1549       end.
     1550     end.
     1551     if p-change-value >= 0
     1552     then do:
     1553       assign
     1554         v-change-sign = 1
     1555       .
     1556     end.
     1557     else do:
     1558       assign
     1559         v-change-sign = -1
     1560       .
     1561     end.
     1562     assign
     1563       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1564     .
     1565     if p-change-value = 0
     1566     then do:
     1567       run diasize_position-resize-button in this-procedure .
     1568       return .
     1569     end.
     1570     move_block:
     1571     do
     1572     on error undo move_block, retry move_block
     1573     :
     1574       if retry
     1575       then do:
     1576         do
     1577         on error undo move_block, leave move_block
     1578         :
     1579           if p-change-value > 0
     1580           then do:
     1581             for each buf_temp-diasize-handle
     1582             on error undo, next
     1583             :
     1584               assign
     1585                 v-object-handle = buf_temp-diasize-handle.handle-value
     1586               .
     1587               if v-object-handle <> v-diasize-resize-button
     1588               then do:
     1589                 assign
     1590                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1591                 .
     1592               end.
     1593             end.
     1594             assign
     1595               v-diasize-browse-handle :height = v-browse-height
     1596             .
     1597             for each buf_temp-browse-handle
     1598               where buf_temp-browse-handle.browse-type = 'height':u
     1599             on error undo, next
     1600             :
     1601               assign
     1602                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1603               .
     1604             end.
     1605             assign
     1606               frame Dialog-Frame :height = v-frame-height
     1607             .
     1608             if frame Dialog-Frame :scrollable = true
     1609             then do:
     1610               assign
     1611                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1612               .
     1613             end.
     1614             run diasize_position-resize-button in this-procedure .
     1615           end.
     1616           else do:
     1617             if frame Dialog-Frame :scrollable = true
     1618             then do:
     1619               assign
     1620                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1621               .
     1622             end.
     1623             assign
     1624               frame Dialog-Frame :height = v-frame-height
     1625             .
     1626             assign
     1627               v-diasize-browse-handle :height = v-browse-height
     1628             .
     1629             for each buf_temp-browse-handle
     1630               where buf_temp-browse-handle.browse-type = 'height':u
     1631             on error undo, next
     1632             :
     1633               assign
     1634                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1635               .
     1636             end.
     1637             for each buf_temp-diasize-handle
     1638             on error undo, next
     1639             :
     1640               assign
     1641                 v-object-handle = buf_temp-diasize-handle.handle-value
     1642               .
     1643               if v-object-handle <> v-diasize-resize-button
     1644               then do:
     1645                 assign
     1646                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1647                 .
     1648               end.
     1649             end.
     1650             run diasize_position-resize-button in this-procedure .
     1651           end.
     1652           assign
     1653             v-diasize-change-size = false
     1654           .
     1655           leave move_block .
     1656         end.
     1657       end.
     1658       assign
     1659         v-diasize-need-full-display = true
     1660       .
     1661       if v-diasize-change-size = false
     1662       then do:
     1663         assign
     1664           v-diasize-change-size = true
     1665         .
     1666       end.
     1667       else do:
     1668         return .
     1669       end.
     1670       assign
     1671         v-frame-height = frame Dialog-Frame :height
     1672         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1673         v-browse-height = v-diasize-browse-handle :height
     1674       .
     1675       for each buf_temp-browse-handle
     1676         where buf_temp-browse-handle.browse-type = 'height':u
     1677       :
     1678         assign
     1679           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1680         .
     1681       end.
     1682       for each buf_temp-diasize-handle
     1683       :
     1684         delete buf_temp-diasize-handle .
     1685       end.
     1686       assign
     1687         v-field-group-handle = frame Dialog-Frame :first-child
     1688       .
     1689       do while valid-handle(v-field-group-handle)
     1690       :
     1691         assign
     1692           v-object-handle = v-field-group-handle :first-child
     1693         .
     1694         do while valid-handle(v-object-handle)
     1695         :
     1696           if  v-object-handle <> v-diasize-browse-handle :handle
     1697           and can-query(v-object-handle, "row")
     1698           and can-query(v-object-handle, "height")
     1699           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1700           then do:
     1701             find first buf_temp-browse-handle
     1702               where buf_temp-browse-handle.browse-type   = 'height':u
     1703                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1704               no-error .
     1705             if available buf_temp-browse-handle
     1706             then do:
     1707             end.
     1708             else do:
     1709               create buf_temp-diasize-handle .
     1710               assign
     1711                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1712                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1713               .
     1714             end.
     1715           end.
     1716           assign
     1717             v-object-handle = v-object-handle :next-sibling
     1718           .
     1719         end.
     1720         assign
     1721           v-field-group-handle = v-field-group-handle :next-sibling
     1722         .
     1723       end.
     1724       do with frame Dialog-Frame
     1725       :
     1726         hide v-diasize-resize-button .
     1727         assign
     1728           v-diasize-resize-button :row    = 1
     1729           v-diasize-resize-button :column = 1
     1730         .
     1731       end.
     1732       if p-change-value > 0
     1733       then do:
     1734         if frame Dialog-Frame :scrollable = true
     1735         then do:
     1736           assign
     1737             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1738             no-error .
     1739           if error-status :error
     1740           or error-status :get-message(1) <> ""
     1741           then do:
     1742             undo move_block, retry move_block .
     1743           end.
     1744         end.
     1745         assign
     1746           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1747           no-error .
     1748         if error-status :error
     1749         or error-status :get-message(1) <> ""
     1750         then do:
     1751           undo move_block, retry move_block .
     1752         end.
     1753         assign
     1754           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1755           no-error .
     1756         if error-status :error
     1757         or error-status :get-message(1) <> ""
     1758         then do:
     1759           undo move_block, retry move_block .
     1760         end.
     1761         for each buf_temp-browse-handle
     1762           where buf_temp-browse-handle.browse-type = 'height':u
     1763         on error undo move_block, retry move_block
     1764         :
     1765           assign
     1766             buf_temp-browse-handle.browse-handle :height
     1767               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1768             no-error .
     1769           if error-status :error
     1770           or error-status :get-message(1) <> ""
     1771           then do:
     1772             undo move_block, retry move_block .
     1773           end.
     1774         end.
     1775         for each buf_temp-diasize-handle
     1776         on error undo move_block, retry move_block
     1777         :
     1778           assign
     1779             v-object-handle = buf_temp-diasize-handle.handle-value
     1780           .
     1781           if v-object-handle <> v-diasize-resize-button
     1782           then do:
     1783             assign
     1784               v-object-handle :row = v-object-handle :row + p-change-value
     1785               no-error .
     1786             if error-status :error
     1787             or error-status :get-message(1) <> ""
     1788             then do:
     1789               undo move_block, retry move_block .
     1790             end.
     1791           end.
     1792         end.
     1793       end.
     1794       else do:
     1795         for each buf_temp-diasize-handle
     1796         on error undo move_block, retry move_block
     1797         :
     1798           assign
     1799             v-object-handle = buf_temp-diasize-handle.handle-value
     1800           .
     1801           if v-object-handle <> v-diasize-resize-button
     1802           then do:
     1803             assign
     1804               v-object-handle :row = v-object-handle :row + p-change-value
     1805               no-error .
     1806             if error-status :error
     1807             or error-status :get-message(1) <> ""
     1808             then do:
     1809               undo move_block, retry move_block .
     1810             end.
     1811           end.
     1812         end.
     1813         assign
     1814           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1815           no-error .
     1816         if error-status :error
     1817         or error-status :get-message(1) <> ""
     1818         then do:
     1819           undo move_block, retry move_block .
     1820         end.
     1821         for each buf_temp-browse-handle
     1822           where buf_temp-browse-handle.browse-type = 'height':u
     1823         on error undo move_block, retry move_block
     1824         :
     1825           assign
     1826             buf_temp-browse-handle.browse-handle :height
     1827               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1828             no-error .
     1829           if error-status :error
     1830           or error-status :get-message(1) <> ""
     1831           then do:
     1832             undo move_block, retry move_block .
     1833           end.
     1834         end.
     1835         assign
     1836           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1837           no-error .
     1838         if error-status :error
     1839         or error-status :get-message(1) <> ""
     1840         then do:
     1841           undo move_block, retry move_block .
     1842         end.
     1843         if frame Dialog-Frame :scrollable = true
     1844         then do:
     1845           assign
     1846             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1847             no-error .
     1848           if error-status :error
     1849           or error-status :get-message(1) <> ""
     1850           then do:
     1851             undo move_block, retry move_block .
     1852           end.
     1853         end.
     1854       end.
     1855       if p-move-resize = true
     1856       then do:
     1857         run diasize_position-resize-button in this-procedure .
     1858       end.
     1859       if v-diasize-wndstore = true
     1860       then do:
     1861         if connected("ub") = true
     1862         then do:
     1863           define variable v-cntxt-db-num        as integer   no-undo .
     1864           define variable v-cntxt-userid        as character no-undo .
     1865           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1866                                             , OUTPUT v-cntxt-userid
     1867                                             ) .
     1868           run gbl/wndsizew.p
     1869             (input  v-cntxt-db-num
     1870             ,input  v-cntxt-userid
     1871             ,input  v-diasize-proc-name
     1872             ,input  'height':u
     1873             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1874             ) .
     1875         end.
     1876       end.
     1877     end.
     1878     assign
     1879       v-diasize-change-size = false
     1880     .
     1881   end procedure.
     1882   procedure diasize_set-height :
     1883     define input  parameter p-new-height  as decimal   no-undo .
     1884     define input  parameter p-move-resize as logical   no-undo .
     1885     do
     1886     on error undo, return error return-value
     1887     :
     1888       run diasize_change-height in this-procedure
     1889         (input  (p-new-height - frame Dialog-Frame :height)
     1890         ,input  p-move-resize
     1891         ) .
     1892     end.
     1893   end procedure.
     1894   procedure diasize_change-width :
     1895     define input  parameter p-change-value as decimal   no-undo .
     1896     define input  parameter p-move-resize  as logical   no-undo .
     1897     define variable v-field-group-handle   as handle    no-undo .
     1898     define variable v-object-handle        as handle    no-undo .
     1899     define variable v-frame-width          as decimal   no-undo .
     1900     define variable v-frame-virtual-width  as decimal   no-undo .
     1901     define variable v-browse-width         as decimal   no-undo .
     1902     define variable v-window-width         as decimal   no-undo .
     1903     define variable v-window-virtual-width as decimal   no-undo .
     1904     define variable v-change-sign          as integer   no-undo .
     1905     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1906     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1907     if p-change-value > 0
     1908     then do:
     1909       if frame Dialog-Frame :width + p-change-value >
     1910           session :width-chars
     1911       then do:
     1912         assign
     1913           p-change-value = session :width-chars - frame Dialog-Frame :width
     1914         .
     1915         if p-change-value <= 0
     1916         then do:
     1917           run diasize_position-resize-button in this-procedure .
     1918           return .
     1919         end.
     1920       end.
     1921     end.
     1922     if p-change-value < 0
     1923     then do:
     1924       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1925       then do:
     1926         assign
     1927           p-change-value = v-diasize-orig-frame-width
     1928                          - frame Dialog-Frame :width
     1929         .
     1930         if p-change-value >= 0
     1931         then do:
     1932           run diasize_position-resize-button in this-procedure .
     1933           return .
     1934         end.
     1935       end.
     1936     end.
     1937     if p-change-value >= 0
     1938     then do:
     1939       assign
     1940         v-change-sign = 1
     1941       .
     1942     end.
     1943     else do:
     1944       assign
     1945         v-change-sign = -1
     1946       .
     1947     end.
     1948     assign
     1949       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1950     .
     1951     if p-change-value = 0
     1952     then do:
     1953       run diasize_position-resize-button in this-procedure .
     1954       return .
     1955     end.
     1956     move_block:
     1957     do
     1958     on error undo move_block, leave move_block
     1959     :
     1960       if retry
     1961       then do:
     1962         do
     1963         on error undo move_block, leave move_block
     1964         :
     1965           if p-change-value > 0
     1966           then do:
     1967             for each buf_temp-diasize-handle
     1968             on error undo, next
     1969             :
     1970               assign
     1971                 v-object-handle = buf_temp-diasize-handle.handle-value
     1972               .
     1973               if v-object-handle <> v-diasize-resize-button
     1974               then do:
     1975                 assign
     1976                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1977                 .
     1978               end.
     1979             end.
     1980             assign
     1981               v-diasize-browse-handle :width = v-browse-width
     1982             .
     1983             for each buf_temp-browse-handle
     1984               where buf_temp-browse-handle.browse-type = 'width':u
     1985             on error undo, next
     1986             :
     1987               assign
     1988                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1989               .
     1990             end.
     1991             assign
     1992               frame Dialog-Frame :width = v-frame-width
     1993             .
     1994             if frame Dialog-Frame :scrollable = true
     1995             then do:
     1996               assign
     1997                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1998               .
     1999             end.
     2000             run diasize_position-resize-button in this-procedure .
     2001           end.
     2002           else do:
     2003             if frame Dialog-Frame :scrollable = true
     2004             then do:
     2005               assign
     2006                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2007               .
     2008             end.
     2009             assign
     2010               frame Dialog-Frame :width = v-frame-width
     2011             .
     2012             for each buf_temp-browse-handle
     2013               where buf_temp-browse-handle.browse-type = 'width':u
     2014             on error undo, next
     2015             :
     2016               assign
     2017                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2018               .
     2019             end.
     2020             assign
     2021               v-diasize-browse-handle :width = v-browse-width
     2022             .
     2023             for each buf_temp-diasize-handle
     2024             on error undo, next
     2025             :
     2026               assign
     2027                 v-object-handle = buf_temp-diasize-handle.handle-value
     2028               .
     2029               if v-object-handle <> v-diasize-resize-button
     2030               then do:
     2031                 assign
     2032                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2033                 .
     2034               end.
     2035             end.
     2036             run diasize_position-resize-button in this-procedure .
     2037           end.
     2038           assign
     2039             v-diasize-change-size = false
     2040           .
     2041           leave move_block .
     2042         end.
     2043       end.
     2044       assign
     2045         v-diasize-need-full-display = true
     2046       .
     2047       if v-diasize-change-size = false
     2048       then do:
     2049         assign
     2050           v-diasize-change-size = true
     2051         .
     2052       end.
     2053       else do:
     2054         return .
     2055       end.
     2056       assign
     2057         v-frame-width = frame Dialog-Frame :width
     2058         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2059         v-browse-width = v-diasize-browse-handle :width
     2060       .
     2061       for each buf_temp-browse-handle
     2062         where buf_temp-browse-handle.browse-type = 'width':u
     2063       :
     2064         assign
     2065           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2066         .
     2067       end.
     2068       for each buf_temp-diasize-handle
     2069       :
     2070         delete buf_temp-diasize-handle .
     2071       end.
     2072       assign
     2073         v-field-group-handle = frame Dialog-Frame :first-child
     2074       .
     2075       do while valid-handle(v-field-group-handle)
     2076       :
     2077         assign
     2078           v-object-handle = v-field-group-handle :first-child
     2079         .
     2080         do while valid-handle(v-object-handle)
     2081         :
     2082           if  v-object-handle <> v-diasize-browse-handle :handle
     2083           and v-object-handle <> v-diasize-resize-button
     2084           and can-query(v-object-handle, "row")
     2085           and can-query(v-object-handle, "height")
     2086           and ( v-object-handle :col + v-object-handle :width
     2087                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2088               )
     2089           then do:
     2090             find first buf_temp-browse-handle
     2091               where buf_temp-browse-handle.browse-type   = 'width':u
     2092                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2093               no-error .
     2094             if available buf_temp-browse-handle
     2095             then do:
     2096             end.
     2097             else do:
     2098               create buf_temp-diasize-handle .
     2099               assign
     2100                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2101                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2102               .
     2103             end.
     2104           end.
     2105           assign
     2106             v-object-handle = v-object-handle :next-sibling
     2107           .
     2108         end.
     2109         assign
     2110           v-field-group-handle = v-field-group-handle :next-sibling
     2111         .
     2112       end.
     2113       do with frame Dialog-Frame
     2114       :
     2115         hide v-diasize-resize-button .
     2116         v-diasize-resize-button :row = 1.
     2117         v-diasize-resize-button :column = 1.
     2118       end.
     2119       if p-change-value > 0
     2120       then do:
     2121         if frame Dialog-Frame :scrollable = true
     2122         then do:
     2123           assign
     2124             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2125             no-error .
     2126           if error-status :error
     2127           or error-status :get-message(1) <> ""
     2128           then do:
     2129             undo move_block, retry move_block.
     2130           end.
     2131         end.
     2132         assign
     2133           frame Dialog-Frame :width = v-frame-width + p-change-value
     2134           no-error .
     2135         if error-status :error
     2136         or error-status :get-message(1) <> ""
     2137         then do:
     2138           undo move_block, retry move_block.
     2139         end.
     2140         assign
     2141           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2142         no-error .
     2143         if error-status :error
     2144         or error-status :get-message(1) <> ""
     2145         then do:
     2146           undo move_block, retry move_block.
     2147         end.
     2148         for each buf_temp-browse-handle
     2149           where buf_temp-browse-handle.browse-type = 'width':u
     2150         on error undo move_block, retry move_block
     2151         :
     2152           assign
     2153             buf_temp-browse-handle.browse-handle :width
     2154               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2155             no-error .
     2156           if error-status :error
     2157           or error-status :get-message(1) <> ""
     2158           then do:
     2159             undo move_block, retry move_block .
     2160           end.
     2161         end.
     2162         for each buf_temp-diasize-handle
     2163         on error undo move_block, retry move_block
     2164         :
     2165           assign
     2166             v-object-handle = buf_temp-diasize-handle.handle-value
     2167           .
     2168           if v-object-handle <> v-diasize-resize-button
     2169           then do:
     2170             assign
     2171               v-object-handle :col = v-object-handle :col + p-change-value
     2172               no-error .
     2173             if error-status :error
     2174             or error-status :get-message(1) <> ""
     2175             then do:
     2176               undo move_block, retry move_block .
     2177             end.
     2178           end.
     2179         end.
     2180       end.
     2181       else do:
     2182         for each buf_temp-diasize-handle
     2183         on error undo move_block, retry move_block
     2184         :
     2185           assign
     2186             v-object-handle = buf_temp-diasize-handle.handle-value
     2187           .
     2188           if v-object-handle <> v-diasize-resize-button
     2189           then do:
     2190             assign
     2191               v-object-handle :col = v-object-handle :col + p-change-value
     2192               no-error .
     2193             if error-status :error
     2194             or error-status :get-message(1) <> ""
     2195             then do:
     2196               undo move_block, retry move_block .
     2197             end.
     2198           end.
     2199         end.
     2200         for each buf_temp-browse-handle
     2201           where buf_temp-browse-handle.browse-type = 'width':u
     2202         on error undo move_block, retry move_block
     2203         :
     2204           assign
     2205             buf_temp-browse-handle.browse-handle :width
     2206               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2207             no-error .
     2208           if error-status :error
     2209           or error-status :get-message(1) <> ""
     2210           then do:
     2211             undo move_block, retry move_block .
     2212           end.
     2213         end.
     2214         assign
     2215           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2216           no-error .
     2217         if error-status :error
     2218         or error-status :get-message(1) <> ""
     2219         then do:
     2220           undo move_block, retry move_block.
     2221         end.
     2222         assign
     2223           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2224         no-error .
     2225         if error-status :error
     2226         or error-status :get-message(1) <> ""
     2227         then do:
     2228           undo move_block, retry move_block.
     2229         end.
     2230         if frame Dialog-Frame :scrollable = true
     2231         then do:
     2232           assign
     2233             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2234           no-error .
     2235           if error-status :error
     2236           or error-status :get-message(1) <> ""
     2237           then do:
     2238             undo move_block, retry move_block.
     2239           end.
     2240         end.
     2241       end.
     2242       if p-move-resize
     2243       then do:
     2244         run diasize_position-resize-button in this-procedure .
     2245       end.
     2246       if v-diasize-wndstore = true
     2247       then do:
     2248         if connected("ub") = true
     2249         then do:
     2250           define variable v-cntxt-db-num        as integer   no-undo .
     2251           define variable v-cntxt-userid        as character no-undo .
     2252           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2253                                             , OUTPUT v-cntxt-userid
     2254                                             ) .
     2255           run gbl/wndsizew.p
     2256             (input  v-cntxt-db-num
     2257             ,input  v-cntxt-userid
     2258             ,input  v-diasize-proc-name
     2259             ,input  'width':u
     2260             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2261             ) .
     2262         end.
     2263       end.
     2264     end.
     2265     assign
     2266       v-diasize-change-size = false
     2267     .
     2268   end procedure.
     2269   procedure diasize_set-width :
     2270     define input  parameter p-new-width  as decimal   no-undo .
     2271     define input  parameter p-move-resize as logical   no-undo .
     2272     do
     2273     on error undo, return error return-value
     2274     :
     2275       run diasize_change-width in this-procedure
     2276         (input  (p-new-width - frame Dialog-Frame :width)
     2277         ,input  p-move-resize
     2278         ) .
     2279     end.
     2280   end procedure.
     2281   procedure diasize_position-resize-button :
     2282     do with frame Dialog-Frame
     2283     :
     2284       hide v-diasize-resize-button .
     2285       assign
     2286         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2287                     - 1
     2288                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2289         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2290                     - 1
     2291                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2292       .
     2293       view v-diasize-resize-button .
     2294     end.
     2295   end procedure.
     2296   on alt-right anywhere
     2297   do:
     2298     run diasize_change-width in this-procedure
     2299       (input 1
     2300       ,input true
     2301       ) .
     2302     return no-apply .
     2303   end.
     2304   on alt-left anywhere
     2305   do:
     2306     run diasize_change-width in this-procedure
     2307       (input -1
     2308       ,input true
     2309       ) .
     2310     return no-apply .
     2311   end.
     2312   on alt-down anywhere
     2313   do:
     2314     run diasize_change-height in this-procedure
     2315       (input 1
     2316       ,input true
     2317       ) .
     2318     return no-apply .
     2319   end.
     2320   on alt-up anywhere
     2321   do:
     2322     run diasize_change-height in this-procedure
     2323       (input -1
     2324       ,input true
     2325       ) .
     2326     return no-apply .
     2327   end.
     2328   on alt-enter of frame Dialog-Frame
     2329   do:
     2330     run diasize_maximize in this-procedure
     2331       (input  ?
     2332       ).
     2333     return no-apply .
     2334   end.
     2335   procedure diasize_end-move :
     2336     do
     2337     on error undo, return error return-value
     2338     :
     2339       define variable v-row-delta as decimal   no-undo .
     2340       define variable v-col-delta as decimal   no-undo .
     2341       define variable v-new-row as decimal   no-undo .
     2342       define variable v-new-col as decimal   no-undo .
     2343       assign
     2344         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2345         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2346       .
     2347       assign
     2348         v-row-delta = v-new-row - frame Dialog-Frame :height
     2349         v-col-delta = v-new-col - frame Dialog-Frame :width
     2350       .
     2351       run diasize_change-height in this-procedure
     2352         (input v-row-delta
     2353         ,input true
     2354         ) .
     2355       run diasize_change-width in this-procedure
     2356         (input v-col-delta
     2357         ,input true
     2358         ) .
     2359     end.
     2360   end procedure.
     2361   procedure diasize_maximize :
     2362     define input  parameter p-action as logical   no-undo .
     2363     do
     2364     on error undo, return error return-value
     2365     :
     2366       if p-action = ?
     2367       then do:
     2368         if v-diasize-need-maximize = true
     2369         then do:
     2370           assign
     2371             p-action = true
     2372           .
     2373         end.
     2374         else do:
     2375           assign
     2376             p-action = false
     2377           .
     2378         end.
     2379       end.
     2380       if p-action = true
     2381       then do:
     2382         run diasize_change-height in this-procedure
     2383           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2384               - frame Dialog-Frame :height-chars
     2385           ,input true
     2386           ) .
     2387         run diasize_change-width in this-procedure
     2388           (input session :width-chars
     2389               - frame Dialog-Frame :width-chars
     2390           ,input true
     2391           ) .
     2392         assign
     2393           v-diasize-need-maximize = false
     2394         .
     2395       end.
     2396       else do:
     2397         run diasize_change-width in this-procedure
     2398           (input v-diasize-orig-frame-width
     2399               - frame Dialog-Frame :width-chars
     2400           ,input true
     2401           ) .
     2402         run diasize_change-height in this-procedure
     2403           (input v-diasize-orig-frame-height
     2404               - frame Dialog-Frame :height-chars
     2405           ,input true
     2406           ) .
     2407         assign
     2408           v-diasize-need-maximize = true
     2409         .
     2410       end.
     2411     end.
     2412   end procedure.
     2413   procedure diasize_restore-orig-size :
     2414     do
     2415     on error undo, return error return-value
     2416     :
     2417       assign
     2418         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2419         v-diasize-current-frame-height = frame Dialog-Frame :height
     2420       .
     2421       run diasize_set-height in this-procedure
     2422         (input  v-diasize-orig-frame-height
     2423         ,input  true
     2424         ) .
     2425       run diasize_set-width in this-procedure
     2426         (input  v-diasize-orig-frame-width
     2427         ,input  true
     2428         ) .
     2429     end.
     2430   end procedure.
     2431   procedure diasize_restore-current-size :
     2432     do
     2433     on error undo, return error return-value
     2434     :
     2435       run diasize_set-height in this-procedure
     2436         (input  v-diasize-current-frame-height
     2437         ,input  true
     2438         ) .
     2439       run diasize_set-width in this-procedure
     2440         (input  v-diasize-current-frame-width
     2441         ,input  true
     2442         ) .
     2443     end.
     2444   end procedure.
     2445   procedure diasize_set-browse-handle :
     2446     define input  parameter p-browse-handle as handle   no-undo .
     2447     define buffer buf_temp-browse-handle for temp-browse-handle .
     2448     do
     2449     on error undo, return error return-value
     2450     :
     2451       assign
     2452         v-diasize-browse-handle = p-browse-handle
     2453       .
     2454       for each buf_temp-browse-handle
     2455       on error undo, return error return-value
     2456       :
     2457         delete buf_temp-browse-handle .
     2458       end.
     2459     end.
     2460   end procedure.
     2461   procedure diasize_add_browse :
     2462     define input  parameter p-browse-type   as character no-undo .
     2463     define input  parameter p-browse-handle as handle    no-undo .
     2464     define buffer buf_temp-browse-handle for temp-browse-handle .
     2465     do
     2466     on error undo, return error return-value
     2467     :
     2468       assign
     2469         v-diasize-browse-number = v-diasize-browse-number + 1
     2470       .
     2471       create buf_temp-browse-handle .
     2472       assign
     2473         buf_temp-browse-handle.browse-type   = p-browse-type
     2474         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2475         buf_temp-browse-handle.browse-handle = p-browse-handle
     2476       .
     2477     end.
     2478   end procedure.
     2479   procedure diasize_init :
     2480     define variable v-default-value    as logical   no-undo .
     2481     define variable v-restore-saved    as logical   no-undo .
     2482     define variable v-resize-value-str as character no-undo .
     2483     do
     2484     on error undo, return error return-value
     2485     :
     2486       do with frame Dialog-Frame
     2487       :
     2488         assign
     2489           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2490           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2491           v-diasize-browse-handle     = browse BR-rcp :handle
     2492         .
     2493         create button v-diasize-resize-button
     2494         assign
     2495           parent        = frame Dialog-Frame :first-child
     2496           label         = "s"
     2497           height-pixels = 16
     2498           width-pixels  = 16
     2499           visible       = true
     2500           sensitive     = true
     2501           movable       = true
     2502           triggers:
     2503             on end-move persistent run diasize_end-move in this-procedure .
     2504           end triggers.
     2505         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2506         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2507         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2508         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2509         assign
     2510           v-diasize-wndmax = false
     2511         .
     2512         if connected("ub") = true
     2513         then do:
     2514           define variable v-cntxt-db-num        as integer   no-undo .
     2515           define variable v-cntxt-userid        as character no-undo .
     2516           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2517                                             , OUTPUT v-cntxt-userid
     2518                                             ) .
     2519           run gbl/wndpar_r.p
     2520             (input  v-cntxt-db-num
     2521             ,input  v-cntxt-userid
     2522             ,input  'wndmax':U
     2523             ,output v-diasize-wndmax
     2524             ,output v-default-value
     2525             ) .
     2526         end.
     2527         assign
     2528           v-diasize-wndstore = false
     2529         .
     2530         if connected("ub") = true
     2531         then do:
     2532           run gbl/wndpar_r.p
     2533             (input  v-cntxt-db-num
     2534             ,input  v-cntxt-userid
     2535             ,input  'wndstore':U
     2536             ,output v-diasize-wndstore
     2537             ,output v-default-value
     2538             ) .
     2539         end.
     2540         assign
     2541           v-diasize-proc-name = entry(1, program-name(2), '.')
     2542         .
     2543         if v-diasize-wndstore = true
     2544         then do:
     2545           assign
     2546             v-restore-saved = false
     2547           .
     2548           if connected("ub") = true
     2549           then do:
     2550             run gbl/wndsizer.p
     2551               (input  v-cntxt-db-num
     2552               ,input  v-cntxt-userid
     2553               ,input  v-diasize-proc-name
     2554               ,input  'height':u
     2555               ,output v-resize-value-str
     2556               ) .
     2557             if v-resize-value-str <> '':U
     2558             then do:
     2559               run diasize_change-height in this-procedure
     2560                 (input  integer(v-resize-value-str)
     2561                 ,input  true
     2562                 ) .
     2563               assign
     2564                 v-restore-saved = true
     2565               .
     2566             end.
     2567           end.
     2568           if connected("ub") = true
     2569           then do:
     2570             run gbl/wndsizer.p
     2571               (input  v-cntxt-db-num
     2572               ,input  v-cntxt-userid
     2573               ,input  v-diasize-proc-name
     2574               ,input  'width':u
     2575               ,output v-resize-value-str
     2576               ) .
     2577             if v-resize-value-str <> '':U
     2578             then do:
     2579               run diasize_change-width in this-procedure
     2580                 (input  integer(v-resize-value-str)
     2581                 ,input  true
     2582                 ) .
     2583               assign
     2584                 v-restore-saved = true
     2585               .
     2586             end.
     2587           end.
     2588           if v-restore-saved <> true
     2589           then do:
     2590             if v-diasize-wndmax = true
     2591             then do:
     2592               run diasize_maximize in this-procedure
     2593                 (input  true
     2594                 ) .
     2595             end.
     2596           end.
     2597         end.
     2598         else do:
     2599           if v-diasize-wndmax = true
     2600           then do:
     2601             run diasize_maximize in this-procedure
     2602               (input  true
     2603               ) .
     2604           end.
     2605         end.
     2606       end.
     2607     end.
     2608   end procedure.
     2609   procedure diasize_need-full-display :
     2610     define output parameter p-need-full-display as logical   no-undo .
     2611     do
     2612     on error undo, return error return-value
     2613     :
     2614       assign
     2615         p-need-full-display = v-diasize-need-full-display
     2616       .
     2617       assign
     2618         v-diasize-need-full-display = false
     2619       .
     2620     end.
     2621   end procedure.
     2622   procedure get-context :
     2623      define output parameter p-db-num as integer          no-undo.
     2624      define output parameter p-user-id as character        no-undo.
     2625      define variable v-login               as character    no-undo.
     2626      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2627      define buffer buf_user-login  for ub.user-login .
     2628      do
     2629      on error undo, return error
     2630      :
     2631            FIND FIRST buf_sys-ctrl no-lock.
     2632            ASSIGN
     2633               v-login = USERID("ub")
     2634               p-db-num = buf_sys-ctrl.db-num
     2635            .
     2636            FIND FIRST buf_user-login
     2637                 WHERE buf_user-login.db-num = p-db-num
     2638                   AND buf_user-login.user-login = v-login
     2639                 no-lock
     2640                 no-error
     2641                 .
     2642            IF AVAILABLE buf_user-login
     2643            THEN DO:
     2644               assign
     2645                  p-user-id = buf_user-login.user-id
     2646               .
     2647            END.
     2648      end.
     2649   end procedure.
     2650       run diasize_init in this-procedure .
     2651   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2652   procedure rcps_get-profile-id :
     2653   define output parameter p-local-profile-id as integer no-undo .
     2654   do
     2655   on error undo, return error:
     2656   p-local-profile-id = p-profile-id.
     2657   end.
     2658   end procedure.
     2659   PROCEDURE rcps_fill-table :
     2660   define input parameter p-clear-params as logical no-undo .
     2661   if p-clear-params then do:
     2662   FOR EACH tt-rule-call-param:
     2663       DELETE tt-rule-call-param.
     2664   END.
     2665   end.
     2666    FOR EACH tt0-rule-call-param:
     2667      IF p-mode <> 'ДОБАВЛЕНИЕ':U THEN DO:
     2668        IF p-call-id <> '':U and p-call-id <> tt0-rule-call-param.call_id THEN do:
     2669           NEXT.
     2670        end.
     2671        IF p-codex-id <> 0 and p-codex-id <> tt0-rule-call-param.codex_id THEN do:
     2672          NEXT.
     2673        end.
     2674        IF p-ruleset-id <> 0 and p-ruleset-id <> tt0-rule-call-param.ruleset_id THEN do:
     2675          NEXT.
     2676        end.
     2677        IF p-rule-id <> 0 and p-rule-id <> tt0-rule-call-param.RULE_id THEN do:
     2678          NEXT.
     2679        end.
     2680        IF p-order-id <> ? and p-order-id <> tt0-rule-call-param.order_id THEN do:
     2681          NEXT.
     2682        end.
     2683      END.
     2684      if lookup("hidden", tt0-rule-call-param.param-3-data-type) > 0 then do:
     2685        next.
     2686      end.
     2687      IF p-list-mode = 'rp-rule-param':U
     2688      or p-list-mode = 'rp-rule-param':U  + chr(44) + 'все':U
     2689      THEN DO:
     2690         IF p-profile-id <> 0 AND p-profile-id <> tt0-rule-call-param.profile_id THEN do:
     2691           NEXT.
     2692         end.
     2693         IF p-once-more <> ? AND p-once-more <> tt0-rule-call-param.once-more THEN do:
     2694           NEXT.
     2695         end.
     2696      END.
     2697      CREATE tt-rule-call-param.
     2698      BUFFER-COPY tt0-rule-call-param TO tt-rule-call-param.
     2699   END.
     2700   END PROCEDURE.
     2701   procedure rcps_get-value :
     2702   DEFINE INPUT PARAMETER p-profile-id AS integer NO-UNDO.
     2703   DEFINE INPUT PARAMETER p-once-more AS integer NO-UNDO.
     2704   DEFINE INPUT PARAMETER p-call-id AS CHARACTER NO-UNDO.
     2705   DEFINE INPUT PARAMETER p-rp-param-name AS CHARACTER NO-UNDO.
     2706   DEFINE INPUT-output PARAMETER pp-index AS integer NO-UNDO.
     2707   DEFINE output parameter p-value-character AS CHARACTER NO-UNDO.
     2708   DEFINE output parameter p-value-date AS date NO-UNDO.
     2709   DEFINE output parameter p-value-decimal AS decimal NO-UNDO.
     2710   DEFINE output parameter p-value-integer AS integer NO-UNDO.
     2711   DEFINE output parameter p-value-logical AS logical NO-UNDO.
     2712   define variable v-current-index as integer no-undo init -1.
     2713   define variable v-start as logical no-undo init yes.
     2714   DEFINE BUFFER buf_ruledict-param FOR ub.ruledict-param.
     2715   DEFINE BUFFER buf_rp-rule-param FOR ub.rp-rule-param.
     2716   DEFINE BUFFER buf_tt-rule-call-param FOR tt-rule-call-param.
     2717   DEFINE BUFFER buf_term_tt-rule-call-param FOR tt-rule-call-param.
     2718   do
     2719   on error undo, return error
     2720   :
     2721   FOR FIRST buf_rp-rule-param WHERE
     2722         buf_rp-rule-param.profile_id = p-profile-id
     2723     AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     2724   , each buf_tt-rule-call-param WHERE
     2725      buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     2726   AND buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     2727   AND buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     2728   AND buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     2729   AND buf_tt-rule-call-param.p-index >= pp-index
     2730    ,each buf_term_tt-rule-call-param where
     2731          buf_term_tt-rule-call-param.call_id = buf_tt-rule-call-param.call_id
     2732      and buf_term_tt-rule-call-param.codex_id = buf_tt-rule-call-param.codex_id
     2733      and buf_term_tt-rule-call-param.ruleset_id = buf_tt-rule-call-param.ruleset_id
     2734      and buf_term_tt-rule-call-param.order_id = buf_tt-rule-call-param.order_id
     2735      and buf_term_tt-rule-call-param.param-name = buf_tt-rule-call-param.param-name
     2736      and buf_term_tt-rule-call-param.p-index = buf_tt-rule-call-param.p-index
     2737     by buf_term_tt-rule-call-param.call_id
     2738     by buf_term_tt-rule-call-param.codex_id
     2739     by buf_term_tt-rule-call-param.ruleset_id
     2740     by buf_term_tt-rule-call-param.order_id
     2741     by buf_term_tt-rule-call-param.param-name
     2742     by buf_term_tt-rule-call-param.p-index :
     2743       if v-start
     2744       then do:
     2745         assign
     2746         pp-index = buf_term_tt-rule-call-param.p-index
     2747         p-value-character = buf_term_tt-rule-call-param.param-value-character
     2748         p-value-date      = buf_term_tt-rule-call-param.param-value-date
     2749         p-value-decimal   = buf_term_tt-rule-call-param.param-value-decimal
     2750         p-value-integer   = buf_term_tt-rule-call-param.param-value-integer
     2751         p-value-logical   = buf_term_tt-rule-call-param.param-value-logical
     2752         v-start = no
     2753         .
     2754       end.
     2755       else do:
     2756         if buf_term_tt-rule-call-param.p-index > pp-index then do:
     2757           v-current-index = buf_term_tt-rule-call-param.p-index.
     2758           leave.
     2759         end.
     2760             end.
     2761     end.
     2762     pp-index = v-current-index.
     2763   end.
     2764   end procedure.
     2765   PROCEDURE rcps_proc-b-add :
     2766   DEFINE INPUT PARAMETER p-profile-id AS integer NO-UNDO.
     2767   DEFINE INPUT PARAMETER p-once-more AS integer NO-UNDO.
     2768   DEFINE INPUT PARAMETER p-call-id AS CHARACTER NO-UNDO.
     2769   DEFINE INPUT PARAMETER p-rp-param-name AS CHARACTER NO-UNDO.
     2770   DEFINE INPUT PARAMETER p-index AS integer NO-UNDO.
     2771   define variable v-ind as integer no-undo .
     2772   define buffer buf_tt-rule-call-param for tt-rule-call-param.
     2773   define buffer buf0_tt-rule-call-param for tt-rule-call-param.
     2774   define buffer buf2_tt-rule-call-param for tt-rule-call-param.
     2775   define buffer buf_rp-rule-param for ub.rp-rule-param.
     2776   FOR FIRST buf_rp-rule-param WHERE
     2777             buf_rp-rule-param.profile_id = p-profile-id
     2778         AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     2779       , first buf0_tt-rule-call-param WHERE
     2780          buf0_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     2781      AND buf0_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     2782      AND buf0_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     2783      AND buf0_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name:
     2784     LEAVE.
     2785   END.
     2786   IF NOT AVAILABLE buf0_tt-rule-call-param THEN do:
     2787     BELL.
     2788     RETURN.
     2789   END.
     2790   for each buf_rp-rule-param where
     2791           buf_rp-rule-param.rp-param-name = p-rp-param-name
     2792       and buf_rp-rule-param.profile_id = p-profile-id,
     2793       first buf_tt-rule-call-param where
     2794           buf_tt-rule-call-param.call_id = buf0_tt-rule-call-param.call_id
     2795       and buf_tt-rule-call-param.profile_id = buf_rp-rule-param.profile_id
     2796       and buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     2797       and buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     2798       and buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     2799       and buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     2800       and buf_tt-rule-call-param.once-more = buf0_tt-rule-call-param.once-more
     2801       and buf_tt-rule-call-param.p-index = p-index:
     2802     RETURN.
     2803   END.
     2804   IF lookup("LIST", buf0_tt-rule-call-param.param-3-data-type) = 0
     2805   and lookup("SORTED-LIST", buf0_tt-rule-call-param.param-3-data-type) = 0
     2806   THEN DO:
     2807     BELL.
     2808     RETURN.
     2809   END.
     2810   IF buf0_tt-rule-call-param.p-index <> 0 THEN DO:
     2811     BELL.
     2812     RETURN.
     2813   END.
     2814   find last buf_tt-rule-call-param where
     2815            buf_tt-rule-call-param.call_id = buf0_tt-rule-call-param.call_id
     2816        and buf_tt-rule-call-param.codex_id = buf0_tt-rule-call-param.codex_id
     2817        and buf_tt-rule-call-param.ruleset_id = buf0_tt-rule-call-param.ruleset_id
     2818        and buf_tt-rule-call-param.order_id = buf0_tt-rule-call-param.order_id
     2819        and buf_tt-rule-call-param.param-name = buf0_tt-rule-call-param.param-name no-error .
     2820   if available buf_tt-rule-call-param
     2821   and (lookup("LIST", buf_tt-rule-call-param.param-3-data-type) > 0
     2822        or
     2823        lookup("SORTED-LIST", buf_tt-rule-call-param.param-3-data-type) > 0
     2824        )
     2825   and buf_tt-rule-call-param.p-index > 0 then do:
     2826     v-ind = buf_tt-rule-call-param.p-index.
     2827   end.
     2828   for each buf_rp-rule-param where
     2829           buf_rp-rule-param.rp-param-name = p-rp-param-name
     2830       and buf_rp-rule-param.profile_id = p-profile-id,
     2831       first buf_tt-rule-call-param where
     2832           buf_tt-rule-call-param.call_id = buf0_tt-rule-call-param.call_id
     2833       and buf_tt-rule-call-param.profile_id = buf_rp-rule-param.profile_id
     2834       and buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     2835       and buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     2836       and buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     2837       and buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     2838       and buf_tt-rule-call-param.once-more = buf0_tt-rule-call-param.once-more
     2839       and buf_tt-rule-call-param.p-index = 0
     2840   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2841   on stop   undo, return error substitute( "&1. stop", vss-workfile )
     2842   on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     2843   :
     2844     create buf2_tt-rule-call-param.
     2845     buffer-copy buf_tt-rule-call-param
     2846     except p-index
     2847     to buf2_tt-rule-call-param
     2848     assign
     2849     buf2_tt-rule-call-param.p-index = v-ind + 1
     2850     .
     2851   end.
     2852   END PROCEDURE.
     2853   PROCEDURE rcps_proc-b-del :
     2854   DEFINE INPUT PARAMETER p-profile-id AS integer NO-UNDO.
     2855   DEFINE INPUT PARAMETER p-once-more AS integer NO-UNDO.
     2856   DEFINE INPUT PARAMETER p-call-id AS CHARACTER NO-UNDO.
     2857   DEFINE INPUT PARAMETER p-rp-param-name AS CHARACTER NO-UNDO.
     2858   DEFINE INPUT PARAMETER pp-index AS integer NO-UNDO.
     2859   define variable v-ind as integer no-undo .
     2860   define variable v-once-more as integer no-undo .
     2861   define variable v-call-id as character no-undo .
     2862   define buffer buf0_tt-rule-call-param for tt-rule-call-param.
     2863   define buffer buf_tt-rule-call-param for tt-rule-call-param.
     2864   define buffer buf_rp-rule-param for ub.rp-rule-param.
     2865   if pp-index = 0 then do:
     2866     undo, return error substitute("Нельзя удалять корневой параметр &1 (индекс = 0)", p-rp-param-name).
     2867   end.
     2868   FOR first buf_rp-rule-param WHERE
     2869             buf_rp-rule-param.profile_id = p-profile-id
     2870         AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     2871       , first buf0_tt-rule-call-param WHERE
     2872          buf0_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     2873      AND buf0_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     2874      AND buf0_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     2875      AND buf0_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     2876      AND buf0_tt-rule-call-param.p-index = pp-index
     2877      :
     2878     LEAVE.
     2879   END.
     2880   IF NOT AVAILABLE buf0_tt-rule-call-param THEN do:
     2881     FOR first buf_rp-rule-param WHERE
     2882               buf_rp-rule-param.profile_id = p-profile-id
     2883           AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     2884         , last buf0_tt-rule-call-param WHERE
     2885           buf0_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     2886       AND buf0_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     2887       AND buf0_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     2888       AND buf0_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     2889       AND buf0_tt-rule-call-param.p-index > pp-index :
     2890       leave.
     2891     end.
     2892     IF NOT AVAILABLE buf0_tt-rule-call-param THEN do:
     2893     return "not-found".
     2894     end.
     2895     else do:
     2896       return ''.
     2897     end.
     2898   END.
     2899   IF lookup("LIST", buf0_tt-rule-call-param.param-3-data-type) = 0
     2900   and lookup("SORTED-LIST", buf0_tt-rule-call-param.param-3-data-type) = 0
     2901   THEN DO:
     2902     undo, return error substitute("Можно удалять только параметры типа LIST и SORTED-LIST").
     2903   END.
     2904   IF lookup("READ-ONLY", buf0_tt-rule-call-param.param-3-data-type) > 0 THEN DO:
     2905     undo, return error substitute("Нельзя удалять  параметры типа READ-ONLY").
     2906   END.
     2907   for each buf_rp-rule-param where
     2908           buf_rp-rule-param.rp-param-name = buf_rp-rule-param.rp-param-name
     2909       and buf_rp-rule-param.profile_id = buf_rp-rule-param.profile_id,
     2910       each buf_tt-rule-call-param where
     2911           buf_tt-rule-call-param.call_id = p-call-id
     2912       and buf_tt-rule-call-param.profile_id = buf_rp-rule-param.profile_id
     2913       and buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     2914       and buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     2915       and buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     2916       and buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     2917       and buf_tt-rule-call-param.once-more = p-once-more
     2918       and buf_tt-rule-call-param.p-index = pp-index
     2919   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2920   on stop   undo, return error substitute( "&1. stop", vss-workfile )
     2921   on endkey undo, return error substitute( "&1. endkey", vss-workfile ):
     2922       DELETE buf_tt-rule-call-param.
     2923   end.
     2924   return ''.
     2925   END PROCEDURE.
     2926   PROCEDURE rcps_proc-save0 :
     2927   FOR EACH tt-rule-call-param
     2928   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2929   on stop   undo , return error substitute( "&1. stop", vss-workfile )
     2930   on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     2931   :
     2932      find  FIRST tt0-rule-call-param NO-LOCK WHERE
     2933               tt0-rule-call-param.codex_id = tt-rule-call-param.codex_id
     2934          AND  tt0-rule-call-param.ruleset_id = tt-rule-call-param.ruleset_id
     2935          AND tt0-rule-call-param.call_id = tt-rule-call-param.call_id
     2936          AND tt0-rule-call-param.order_id = tt-rule-call-param.order_id
     2937          AND tt0-rule-call-param.param-name = tt-rule-call-param.param-name
     2938          AND tt0-rule-call-param.p-index = tt-rule-call-param.p-index no-error .
     2939      if not available tt0-rule-call-param
     2940      and (lookup("LIST", tt-rule-call-param.param-3-data-type) > 0
     2941           OR
     2942           lookup("SORTED-LIST", tt-rule-call-param.param-3-data-type) > 0
     2943           )
     2944      and tt-rule-call-param.p-index > 0 then do:
     2945        create tt0-rule-call-param.
     2946      end.
     2947      BUFFER-COPY tt-rule-call-param TO tt0-rule-call-param.
     2948   END.
     2949   FOR EACH tt0-rule-call-param
     2950   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2951   on stop   undo , return error substitute( "&1. stop", vss-workfile )
     2952   on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     2953   :
     2954     if tt0-rule-call-param.p-index = 0 then next.
     2955     if lookup("hidden", tt0-rule-call-param.param-3-data-type) > 0 then next.
     2956     find  FIRST tt-rule-call-param NO-LOCK WHERE
     2957             tt-rule-call-param.codex_id = tt0-rule-call-param.codex_id
     2958         AND tt-rule-call-param.ruleset_id = tt0-rule-call-param.ruleset_id
     2959         AND tt-rule-call-param.call_id = tt0-rule-call-param.call_id
     2960         AND tt-rule-call-param.order_id = tt0-rule-call-param.order_id
     2961         AND tt-rule-call-param.param-name = tt0-rule-call-param.param-name
     2962         AND tt-rule-call-param.p-index = tt0-rule-call-param.p-index no-error .
     2963     if not available tt-rule-call-param
     2964     and (lookup("LIST", tt0-rule-call-param.param-3-data-type) > 0
     2965         OR
     2966         lookup("SORTED-LIST", tt0-rule-call-param.param-3-data-type) > 0
     2967         )
     2968     and tt0-rule-call-param.p-index > 0
     2969     then do:
     2970        IF p-call-id <> '':U and p-call-id <> tt0-rule-call-param.call_id THEN do:
     2971           NEXT.
     2972        end.
     2973        IF p-codex-id <> 0 and p-codex-id <> tt0-rule-call-param.codex_id THEN do:
     2974          NEXT.
     2975        end.
     2976        IF p-ruleset-id <> 0 and p-ruleset-id <> tt0-rule-call-param.ruleset_id THEN do:
     2977          NEXT.
     2978        end.
     2979        IF p-rule-id <> 0 and p-rule-id <> tt0-rule-call-param.RULE_id THEN do:
     2980          NEXT.
     2981        end.
     2982        IF p-order-id <> ? and p-order-id <> tt0-rule-call-param.order_id THEN do:
     2983          NEXT.
     2984        end.
     2985       IF p-list-mode = 'rp-rule-param':U
     2986       or p-list-mode = 'rp-rule-param':U  + chr(44) + 'все':U
     2987       THEN DO:
     2988         IF p-profile-id <> 0 AND p-profile-id <> tt0-rule-call-param.profile_id THEN do:
     2989           NEXT.
     2990         end.
     2991         IF p-once-more <> ? AND p-once-more <> tt0-rule-call-param.once-more THEN do:
     2992           NEXT.
     2993         end.
     2994       end.
     2995       delete tt0-rule-call-param.
     2996     end.
     2997   end.
     2998   END PROCEDURE.
     2999   PROCEDURE rcps_set-value :
     3000   DEFINE INPUT PARAMETER p-profile-id AS integer NO-UNDO.
     3001   DEFINE INPUT PARAMETER p-once-more AS integer NO-UNDO.
     3002   DEFINE INPUT PARAMETER p-call-id AS CHARACTER NO-UNDO.
     3003   DEFINE INPUT PARAMETER p-rp-param-name AS CHARACTER NO-UNDO.
     3004   DEFINE INPUT PARAMETER pp-index AS integer NO-UNDO.
     3005   DEFINE INPUT parameter p-value-character AS CHARACTER NO-UNDO.
     3006   DEFINE INPUT parameter p-value-date AS date NO-UNDO.
     3007   DEFINE INPUT parameter p-value-decimal AS decimal NO-UNDO.
     3008   DEFINE INPUT parameter p-value-integer AS integer NO-UNDO.
     3009   DEFINE INPUT parameter p-value-logical AS logical NO-UNDO.
     3010   DEFINE VARIABLE v-codex-id AS integer NO-UNDO.
     3011   DEFINE VARIABLE v-ruleset-id AS integer NO-UNDO.
     3012   DEFINE VARIABLE v-order-id AS integer NO-UNDO.
     3013   DEFINE VARIABLE V-param-name AS character NO-UNDO.
     3014   define variable v-found as logical no-undo .
     3015   DEFINE BUFFER buf_tt-rule-call-param FOR tt-rule-call-param.
     3016   DEFINE BUFFER buf_rp-rule-param FOR ub.rp-rule-param.
     3017   FOR FIRST buf_rp-rule-param WHERE
     3018             buf_rp-rule-param.profile_id = p-profile-id
     3019         AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     3020       , first buf_tt-rule-call-param WHERE
     3021          buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3022      AND buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3023      AND buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3024      AND buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name:
     3025     ASSIGN
     3026     v-codex-id = buf_tt-rule-call-param.codex_id
     3027     v-ruleset-id = buf_tt-rule-call-param.ruleset_id
     3028     v-order-id = buf_tt-rule-call-param.order_id
     3029     V-PARAM-NAME = buf_tt-rule-call-param.PARAM-NAME
     3030     .
     3031     LEAVE.
     3032   END.
     3033   CASE p-list-mode:
     3034     WHEN 'rp-rule-param':U THEN DO:
     3035       if pp-index > 0
     3036       then do:
     3037         FOR EACH  buf_rp-rule-param NO-LOCK where
     3038             buf_rp-rule-param.profile_id = p-profile-id
     3039             AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     3040             ,EACH buf_tt-rule-call-param WHERE
     3041                 buf_tt-rule-call-param.profile_id = p-profile-id
     3042             AND buf_tt-rule-call-param.once-more = p-once-more
     3043             AND buf_tt-rule-call-param.call_id = p-CALL-id
     3044             AND buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3045             AND buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3046             AND buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3047             AND buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     3048             AND buf_tt-rule-call-param.p-index = pp-index
     3049         ON error undo, return error :
     3050           v-found = yes.
     3051         end.
     3052       end.
     3053       if not v-found then do:
     3054         run rcps_proc-b-add in this-procedure (
     3055                                                  input p-profile-id
     3056                                                 ,input p-once-more
     3057                                                 ,input p-call-id
     3058                                                 ,
     3059                                                  input p-rp-param-name
     3060                                                 ,input pp-index).
     3061       end.
     3062       FOR EACH  buf_rp-rule-param NO-LOCK where
     3063           buf_rp-rule-param.profile_id = p-profile-id
     3064           AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     3065           ,EACH buf_tt-rule-call-param WHERE
     3066               buf_tt-rule-call-param.profile_id = p-profile-id
     3067           AND buf_tt-rule-call-param.once-more = p-once-more
     3068           AND buf_tt-rule-call-param.call_id = p-CALL-id
     3069           AND buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3070           AND buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3071           AND buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3072           AND buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     3073           AND buf_tt-rule-call-param.p-index = pp-index
     3074         ON error undo, return error :
     3075         assign
     3076         buf_tt-rule-call-param.param-value-character = p-value-character
     3077         buf_tt-rule-call-param.param-value-date      = p-value-date
     3078         buf_tt-rule-call-param.param-value-decimal   = p-value-decimal
     3079         buf_tt-rule-call-param.param-value-integer   = p-value-integer
     3080         buf_tt-rule-call-param.param-value-logical   = p-value-logical
     3081         .
     3082       END.
     3083     END.
     3084     WHEN 'rule-call-param':U THEN DO:
     3085       FIND FIRST buf_tt-rule-call-param WHERE
     3086           buf_tt-rule-call-param.call_id = p-call-id
     3087       AND buf_tt-rule-call-param.codex_id = v-codex-id
     3088       AND buf_tt-rule-call-param.ruleset_id = v-ruleset-id
     3089       AND buf_tt-rule-call-param.order_id = v-order-id
     3090       AND buf_tt-rule-call-param.param-name = V-PARAM-NAME
     3091       AND buf_tt-rule-call-param.p-index = pp-index.
     3092       assign
     3093       buf_tt-rule-call-param.param-value-character = p-value-character
     3094       buf_tt-rule-call-param.param-value-date      = p-value-date
     3095       buf_tt-rule-call-param.param-value-decimal   = p-value-decimal
     3096       buf_tt-rule-call-param.param-value-integer   = p-value-integer
     3097       buf_tt-rule-call-param.param-value-logical   = p-value-logical
     3098       .
     3099     END.
     3100   END CASE.
     3101   END PROCEDURE.
     3102   procedure rcps_get-rule-on-off :
