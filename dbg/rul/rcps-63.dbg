     3106   define input parameter p-profile-id as integer no-undo .
     3107   define input parameter p-once-more as integer no-undo .
     3108   define output parameter p-on-off as logical no-undo .
     3109   if valid-handle(p-call-handle)
     3110   and lookup("rcpscont_get-rule-on-off", p-call-handle:internal-entries) > 0 then do:
     3111     run rcpscont_get-rule-on-off in p-call-handle (
     3112                                              input p-codex-id
     3113                                             ,input p-ruleset-id
     3114                                             ,input p-rule-id
     3115                                             ,input p-profile-id
     3116                                             ,input p-once-more
