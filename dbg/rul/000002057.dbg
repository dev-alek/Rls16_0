     1411   procedure stat-graf-trn :
     1412   define input parameter  p-oldbh              as handle no-undo .
     1413   define input parameter  p-newbh              as handle no-undo .
     1414   define input parameter  p-changed-fields     as character no-undo .
     1415   define input parameter  p-waiting-status     as character no-undo .
     1416   define input parameter  p-waiting-flag       as logical no-undo .
     1417   define output parameter p-is-waiting-status  as logical no-undo .
     1418   define output parameter p-direction          as character no-undo .
     1419   define variable v-doc-code as character no-undo .
     1420   define variable v-ext-doc-type as character no-undo .
     1421   define variable v-stat-list as character no-undo extent 84.
     1422   define variable v-stat-list-all as character no-undo .
     1423   define variable v-jj as integer no-undo .
     1424   define variable v-ii as integer no-undo .
     1425   define variable v-old-stfl as character no-undo .
     1426   define variable v-new-stfl as character no-undo .
     1427   define variable v-waiting-stfl as character no-undo .
     1428   define variable v-old-stfl-i as integer no-undo .
     1429   define variable v-new-stfl-i as integer no-undo .
     1430   define variable v-waiting-stfl-i as integer no-undo .
     1431   do
     1432   on error  undo, return error substitute( "&1. &2&3&4", vss-include-info3, return-value, chr(10), error-status :get-message (1))
     1433   :
     1434   if p-newbh = ?  then do:
     1435     v-doc-code = p-oldbh::doc-code .
     1436     v-ext-doc-type = p-oldbh::ext-doc-type .
     1437   end.
     1438   else do:
     1439     v-doc-code     = p-newbh::doc-code .
     1440     v-ext-doc-type = p-newbh::ext-doc-type .
     1441   end.
     1442   assign
     1443   v-stat-list-all =
     1444                    '' +           chr(4) + string(no) + chr(3) +
     1445                    'запрос':U +   chr(4) + string(no) + chr(3) +
     1446                    'запрос':U +   chr(4) + string(yes) + chr(3) +
     1447                    'накл':U +      chr(4) + string(no) + chr(3) +
     1448                    'накл':U +      chr(4) + string(yes) + chr(3) +
     1449                    'разрешен':U + chr(4) + string(no) + chr(3) +
     1450                    'разрешен':U + chr(4) + string(yes) + chr(3) +
     1451                    'факт':U +      chr(4) + string(yes)
     1452   .
     1453   assign
     1454   v-stat-list[lookup('ie':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] = v-stat-list-all
     1455   v-stat-list[lookup('ee':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] = v-stat-list-all
     1456   v-stat-list[lookup('ee':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 2] =
     1457                                                                    '' +           chr(4) + string(no) + chr(3) +
     1458                                                                    'готов':U     + chr(4) + string(yes)
     1459   v-stat-list[lookup('ee':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 1] =
     1460                                                                    '' +           chr(4) + string(no) + chr(3) +
     1461                                                                    'отказ':U  +  chr(4) + string(yes)
     1462   v-stat-list[lookup('ep':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] = v-stat-list-all
     1463   v-stat-list[lookup('re':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] = v-stat-list-all
     1464   v-stat-list[lookup('we':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] = v-stat-list-all
     1465   v-stat-list[lookup('vp':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] =
     1466                                                                   ''              + chr(4) + string(no) + chr(3) +
     1467                                                                   'накл':U         + chr(4) + string(no) + chr(3) +
     1468                                                                   'факт':U         + chr(4) + string(yes)
     1469   v-stat-list[lookup('iv':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] = v-stat-list-all
     1470   v-stat-list[lookup('ev':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] = v-stat-list-all
     1471   v-stat-list[lookup('io':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] = v-stat-list-all
     1472   v-stat-list[lookup('eo':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] = v-stat-list-all
     1473   v-stat-list[lookup('rv':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] = v-stat-list-all
     1474   v-stat-list[lookup('em':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] = v-stat-list-all
     1475   v-stat-list[lookup('wm':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] =
     1476                                                                   ''              + chr(4) + string(no) + chr(3) +
