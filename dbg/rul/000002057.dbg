     1849   define variable v-changes-list as character no-undo .
     1850   define variable v-esys-cmd-proc-handle as handle no-undo .
     1851   define variable v-esys-cmd-code as integer no-undo .
     1852   define variable log-file-name                as character      no-undo init "process-thref.txt".
     1853   define variable v-view-log                   as logical        no-undo .
     1854   define variable v-stop                       as logical        no-undo .
     1855   define variable v-last-error-message as character no-undo .
     1856   define variable file-name as char.
     1857   define variable v-sign as integer no-undo .
     1858   define variable num-rec as integer no-undo .
     1859   define variable num-rec-ok as integer no-undo .
     1860   define variable l-res as integer no-undo .
     1861   define variable v-es as logical no-undo .
     1862   define variable v-esm as character no-undo .
     1863   define variable v-rv as character no-undo .
     1864   define variable v-err-mess as character no-undo .
     1865   define variable v-action as character no-undo .
     1866   define variable v-doc-code          as character  no-undo .
     1867   define variable v-ext-doc-type      as character  no-undo .
     1868   define variable v-trn-doc-obj-type  as character  no-undo .
     1869   define variable v-trn-doc-obj-code  as integer    no-undo .
     1870   define variable v-trn-doc-cli-type as character no-undo .
     1871   define variable v-trn-doc-cli-code as integer no-undo .
     1872   define variable v-trn-doc-doc-type as character no-undo .
     1873   define variable v-obj-db-num        as integer    no-undo .
     1874   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1875   procedure write-to-screen :
     1876   define input param p-str as character no-undo .
     1877   run write-log-and-file in p-log-handle (
     1878         input 1
     1879       , input log-file-name
     1880       , input 1
     1881       , input p-str).
     1882   end procedure.
     1883   procedure write-to-log :
     1884   define input param p-str as character no-undo .
     1885   run write-log-and-file in p-log-handle (
     1886         input 1
     1887       , input log-file-name
     1888       , input 1
     1889       , input p-str).
     1890   end procedure.
     1891   procedure write-to-log-notime :
     1892   define input param p-str as character no-undo .
     1893   run write-log-and-file in p-log-handle (
     1894         input 1
     1895       , input log-file-name
     1896       , input 1
     1897       , input p-str).
     1898   end procedure.
     1899   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1900   procedure set-error :
     1901   define input parameter p-mess as character no-undo .
     1902     do
     1903     on error undo, return error
     1904     :
     1905        assign
     1906        v-last-error-message = p-mess.
     1907     end.
     1908   end procedure.
     1909     define variable p-xsd-file as character no-undo.
     1910   on delete of this-procedure do:
     1911     run garbcoll_clear in this-procedure .
     1912   end.
     1913   run load-ruleset-context in this-procedure ( input p-ruleset-id) no-error.
     1914   if error-status:error then do:
     1915     undo, return error return-value .
     1916   end.
     1917   if return-value = "return" then return ''.
     1918   if not this-procedure:persistent then do:
     1919     run proc-main in this-procedure no-error .
     1920     if error-status:error then do:
     1921       v-esm = error-status :get-message (1).
     1922       v-es = error-status:error .
     1923       v-rv = return-value .
     1924     end.
     1925     if v-es then do:
     1926         run garbcoll_clear in this-procedure .
     1927         undo, return error substitute( "&1. &2&3&4", vss-workfile, v-rv, chr(10), v-esm).
     1928     end.
     1929     run garbcoll_clear in this-procedure .
     1930   end.
     1931   procedure proc-main :
     1932   _main:
     1933   do
     1934   on error undo, return error substitute( "&1&2&3&2&4", return-value, chr(10), error-status :get-message (1), v-last-error-message)
     1935   :
     1936   define variable v-err               as logical    no-undo .
     1937   define variable v-rsrv-code as character no-undo .
     1938   define variable v-unrv-code as character no-undo .
     1939   define variable v-need-rsrv as logical   no-undo .
     1940   define variable v-need-unrv as logical   no-undo .
     1941   define variable v-rsrv-sign as integer   no-undo .
     1942   define variable v-unrv-sign as integer   no-undo .
     1943   define variable v-action as character no-undo .
     1944   DEFINE VARIABLE v-today as date no-undo .
     1945   DEFINE VARIABLE v-time as integer no-undo .
     1946   define variable v-value as character no-undo .
     1947   define variable v-deleted as logical no-undo .
     1948   define buffer buf_doc-line for ub.doc-line.
     1949   define buffer buf_parts for ub.parts.
     1950   define buffer free_parts for ub.parts.
     1951   define buffer buf_gds-obj for ub.gds-obj.
     1952   define buffer buf_goods for ub.goods.
     1953   for each buf_doc-line no-lock where
     1954           buf_doc-line.doc-code = v-doc-code,
     1955     first  buf_gds-obj no-lock where
     1956           buf_gds-obj.obj-type = v-trn-doc-obj-type
     1957       and buf_gds-obj.obj-code = v-trn-doc-obj-code
     1958       and buf_gds-obj.artic = buf_doc-line.artic
     1959       and buf_gds-obj.prod-type = buf_doc-line.prod-type
     1960       and buf_gds-obj.prod-code = buf_doc-line.prod-code
     1961       :
     1962     if buf_gds-obj.cash-parts = no then next.
     1963     FOR EACH buf_parts NO-LOCK WHERE
     1964             buf_parts.artic = buf_doc-line.artic AND
     1965             buf_parts.prod-type = buf_doc-line.prod-type AND
     1966             buf_parts.prod-code = buf_doc-line.prod-code AND
     1967             buf_parts.out-code = v-doc-code AND
     1968             buf_parts.obj-type = buf_doc-line.obj-type AND
     1969             buf_parts.obj-code = buf_doc-line.obj-code:
     1970       find first free_parts no-lock where
     1971             free_parts.obj-type = buf_parts.obj-type
     1972           and free_parts.obj-code = buf_parts.obj-code
     1973           and free_parts.artic = buf_parts.artic
     1974           and free_parts.prod-type = buf_parts.prod-type
     1975           and free_parts.prod-code = buf_parts.prod-code
     1976           and free_parts.in-code = buf_parts.in-code
     1977           and free_parts.part-code = buf_parts.part-code
     1978           and free_parts.out-code  = 'free-zone':U
     1979           and free_parts.status_   = false no-error.
     1980       if available free_parts then do:
     1981   if valid-handle( g#partolib ) <> yes then do:       run str/partolib.p persistent no-error.       if error-status :error or valid-handle( g#partolib ) <> yes then do:         message "Error starting partolib.p"    skip( 0 )                 g#partolib                     skip( 0 )                 g#partolib   :type             skip( 0 )                 g#partolib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run partolib_partodel in g#partolib (  input buf_parts.obj-type
     1982                          ,input buf_parts.obj-code
     1983                          ,input buf_gds-obj.gds-code
     1984                          ,input buf_parts.prt-code
     1985                          ,input buf_parts.in-code
     1986                          ,input 'out-zone':U
     1987                          ,input ''
     1988                          ,input 'parts-end':U
     1989                          ,output v-deleted )  .
     1990       end.
     1991       else do:
     1992        if v-action = 'удаление':U then do:
     1993           assign
     1994           v-unrv-code = ''
     1995           v-need-unrv = no.
     1996           if buf_parts.fact-qnty <> 0
     1997           then do:
     1998             define variable v-create-part as logical   no-undo .
     1999             define variable v-old-return  as logical   no-undo .
     2000             assign
     2001               v-create-part = false
     2002               v-old-return  = false
     2003             .
     2004             if buf_parts.in-code = v-doc-code
     2005             then do:
     2006               assign
     2007                 v-create-part = true
     2008               .
     2009               if buf_parts.supp-type <>
     2010           ( if v-trn-doc-doc-type = 'при':U then v-trn-doc-cli-type else v-trn-doc-obj-type )
     2011               or buf_parts.supp-code <>
     2012           ( if v-trn-doc-doc-type = 'при':U then v-trn-doc-cli-code else v-trn-doc-obj-code )
     2013               then do:
     2014                 assign
     2015                   v-old-return = true
     2016                 .
     2017               end.
     2018             end.
     2019             define variable v-is-hold as logical   no-undo .
     2020   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2021   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hold-doc in g#library
     2022     (input  v-doc-code
     2023     ,output v-is-hold
     2024     ) no-error .
     2025             if error-status :error
     2026             then do:
     2027                           undo, return error substitute("&1 &2 &3&4Ошибка при определении типа документа hold-doc.i&4" +                                        "Документ &5 &6&7&4&8&4&9"                                       ,vss-workfile                                                 ,vss-revision                                                 ,vss-description                                              ,chr(10)                                        ,v-doc-code                                           ,v-trn-doc-obj-type                                       ,v-trn-doc-obj-code                                        , error-status:get-message(1)                                       , return-value ).
     2028             end.
     2029   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run partcond in g#library
     2030     (input  v-ext-doc-type
     2031     ,input  v-is-hold
     2032     ,input  buf_parts.fact-qnty
     2033     ,input  v-create-part
     2034     ,input  v-old-return
     2035     ,output v-rsrv-code
     2036     ,output v-unrv-code
     2037     ,output v-need-rsrv
     2038     ,output v-need-unrv
     2039     ,output v-rsrv-sign
     2040     ,output v-unrv-sign
     2041     ) no-error .
     2042             if error-status :error
     2043             then do:
     2044                           undo, return error substitute("&1 &2 &3&4Ошибка при определении параметров резервирования партии.i&4" +                                 "Документ &5 &6&7&4&8&4&9"                               , vss-workfile                                           ,vss-revision                                            ,vss-description                                         ,chr(10)                              ,v-doc-code                                 ,v-trn-doc-obj-type                              ,v-trn-doc-obj-code                               , error-status:get-message(1)                              , return-value ).
     2045             end.
     2046           end.
     2047           if v-need-unrv
     2048           and v-unrv-code = 'free-zone':U then do:
     2049   if valid-handle( g#partolib ) <> yes then do:       run str/partolib.p persistent no-error.       if error-status :error or valid-handle( g#partolib ) <> yes then do:         message "Error starting partolib.p"    skip( 0 )                 g#partolib                     skip( 0 )                 g#partolib   :type             skip( 0 )                 g#partolib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run partolib_partodel in g#partolib (  input buf_parts.obj-type
     2050                          ,input buf_parts.obj-code
     2051                          ,input buf_gds-obj.gds-code
     2052                          ,input buf_parts.prt-code
     2053                          ,input buf_parts.in-code
     2054                          ,input 'out-zone':U
     2055                          ,input ''
     2056                          ,input 'parts-end':U
     2057                          ,output v-deleted )  .
     2058           end.
     2059         end.
     2060        else do:
     2061         run cur-time in this-procedure ( output v-today, output v-time).
     2062         v-value = substitute("&1-&2-&3", string(year(v-today),"9999"), string(month(v-today), "99"), string(day(v-today), "99")).
     2063   if valid-handle( g#partolib ) <> yes then do:       run str/partolib.p persistent no-error.       if error-status :error or valid-handle( g#partolib ) <> yes then do:         message "Error starting partolib.p"    skip( 0 )                 g#partolib                     skip( 0 )                 g#partolib   :type             skip( 0 )                 g#partolib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run partolib_partowrt in g#partolib (  input buf_parts.obj-type
     2064                          ,input buf_parts.obj-code
     2065                          ,input buf_gds-obj.gds-code
     2066                          ,input buf_parts.prt-code
     2067                          ,input buf_parts.in-code
     2068                          ,input buf_parts.out-code
     2069                          ,input 'out-zone':U
     2070                          ,input 'parts-end':U
     2071                          ,input v-value) .
     2072         end.
     2073       end.
     2074     end.
     2075   end.
     2076   end.
     2077   end procedure.
     2078   procedure load-ruleset-context :
     2079   define input parameter p-ruleset-id as integer no-undo .
     2080   define variable v-flag as logical no-undo .
     2081   define variable v-ii as integer no-undo .
     2082   define variable v-changes-list2 as character no-undo .
     2083   define variable v-obj-db-num as integer no-undo .
     2084   define variable v-is-waiting-status as logical no-undo .
     2085   define variable v-direction as character no-undo .
     2086   define buffer buf_rule-call-param for ub.rule-call-param.
     2087   define buffer buf_clients for ub.clients.
     2088   do
     2089   on error undo, return error
     2090   :
     2091     assign
     2092     v-oldbh = widget-handle (entry(2, p-doc-code, chr(4)))
     2093     v-newbh = widget-handle (entry(3, p-doc-code, chr(4)))
     2094     v-changes-list = entry(4, p-doc-code, chr(4))
     2095     file-name  = p-process-file-name
     2096     v-has-oldbh = valid-handle(v-oldbh) and v-oldbh:available
     2097     v-has-newbh = valid-handle(v-newbh) and v-newbh:available
     2098     .
     2099     if not v-has-newbh
     2100     and not v-has-oldbh then do:
     2101       undo, return error substitute("Не определено ни одного буфера - ни старый, ни новый").
     2102     end.
     2103     if not v-has-oldbh
     2104     and v-changes-list  = '' then do:
     2105        undo, return error substitute("Не определен старый буфер и список изменений").
     2106     end.
     2107     case p-ruleset-id:
     2108       when 115 then do:
     2109         if v-has-newbh
     2110         and v-newbh:table <> 'trn-doc':U then do:
     2111           undo, return error substitute("Передан неверный буфер вместо буфера для &1",  'trn-doc':U).
     2112         end.
     2113         if v-has-oldbh
     2114         and v-oldbh:table <> 'trn-doc':U then do:
     2115           undo, return error substitute("Передан неверный буфер вместо буфера для &1",  'trn-doc':U).
     2116         end.
     2117       end.
     2118       otherwise do:
     2119         undo, return error substitute("Неверный вызов &1 для набора правил &2", vss-workfile , p-ruleset-id).
     2120       end.
     2121     end case.
     2122     if v-has-newbh then do:
     2123       v-trn-doc-obj-type = v-newbh::obj-type.
     2124       v-trn-doc-obj-code = v-newbh::obj-code.
     2125       v-doc-code = v-newbh:buffer-field("doc-code"):buffer-value.
     2126       v-ext-doc-type = v-newbh:buffer-field("ext-doc-type"):buffer-value.
     2127       assign
     2128       v-trn-doc-doc-type = v-newbh::doc-type
     2129       v-trn-doc-cli-type = v-newbh::cli-type
     2130       v-trn-doc-cli-code = v-newbh::cli-code
     2131       v-trn-doc-doc-type = v-newbh::doc-type
     2132       .
     2133     end.
     2134     else do:
     2135       v-trn-doc-obj-type = v-oldbh::obj-type.
     2136       v-trn-doc-obj-code = v-oldbh::obj-code.
     2137       v-doc-code = v-oldbh:buffer-field("doc-code"):buffer-value.
     2138       v-ext-doc-type = v-oldbh:buffer-field("ext-doc-type"):buffer-value.
     2139       assign
     2140       v-trn-doc-doc-type = v-oldbh::doc-type
     2141       v-trn-doc-cli-type = v-oldbh::cli-type
     2142       v-trn-doc-cli-code = v-oldbh::cli-code
     2143       v-trn-doc-doc-type = v-oldbh::doc-type.
     2144       v-action = 'удаление':U.
     2145     end.
     2146   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2147   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     2148     (input  v-trn-doc-obj-type
     2149     ,input  v-trn-doc-obj-code
     2150     ,output v-obj-db-num
     2151     )  .
     2152     if g#db-num <> 0 and v-obj-db-num <> g#db-num then do:
     2153       return 'return'.
     2154     end.
     2155     for each buf_rule-call-param no-lock where
     2156     buf_rule-call-param.codex_id = p-codex-id
     2157     and buf_rule-call-param.ruleset_id = p-ruleset-id
     2158     and buf_rule-call-param.call_id = p-call-id
     2159     and buf_rule-call-param.order_id = p-order-id
     2160     and buf_rule-call-param.rule_id = p-rule-id
     2161     and buf_rule-call-param.param-name = "p-objects"
     2162     and buf_rule-call-param.p-index > 0
     2163     :
     2164       if buf_rule-call-param.param-value-character = v-trn-doc-obj-type + string(v-trn-doc-obj-code) then leave.
     2165     end.
     2166     if not available buf_rule-call-param then return "return".
     2167       run statq_has-waiting-stat in this-procedure (
     2168                                                     input v-oldbh
     2169                                                    ,input v-newbh
     2170                                                    ,input v-changes-list
     2171                                                    ,input 'факт':U
     2172                                                    ,input ?
     2173                                                    ,input 0
     2174                                                    ,output v-is-waiting-status
     2175                                                    ,output v-direction
     2176                                                    ) no-error.
     2177     if v-is-waiting-status = no then return "return".
     2178   end.
     2179   end procedure.
