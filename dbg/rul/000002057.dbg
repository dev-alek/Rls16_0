     1478                                                                   'факт':U         + chr(4) + string(yes)
     1479   v-stat-list[lookup('im':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] =
     1480                                                                   ''              + chr(4) + string(no) + chr(3) +
     1481                                                                   'факт':U         + chr(4) + string(yes)
     1482   v-stat-list[lookup('ap':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] =
     1483                                                                         ''              + chr(4) + string(no) + chr(3) +
     1484                                                                         'накл':U         + chr(4) + string(no) + chr(3) +
     1485                                                                         'факт':U         + chr(4) + string(yes)
     1486   v-stat-list[lookup('mp':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] =
     1487                                                                         ''              + chr(4) + string(no) + chr(3) +
     1488                                                                         'факт':U         + chr(4) + string(yes)
     1489   v-stat-list[lookup('pc':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] =
     1490                                                                         ''              + chr(4) + string(no) + chr(3) +
     1491                                                                         'факт':U         + chr(4) + string(yes)
     1492   .
     1493   assign
     1494   v-stat-list[lookup('ie':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 2] =
     1495                    '' +           chr(4) + string(no) + chr(3) +
     1496                    'запрос':U +   chr(4) + string(no) + chr(3) +
     1497                    'запрос':U +   chr(4) + string(yes) + chr(3) +
     1498                    'накл':U +      chr(4) + string(no) + chr(3) +
     1499                    'накл':U +      chr(4) + string(yes) + chr(3) +
     1500                    'разрешен':U + chr(4) + string(no) + chr(3) +
     1501                    'разрешен':U + chr(4) + string(yes) + chr(3) +
     1502                    'факт':U +      chr(4) + string(no)
     1503   .
     1504   assign
     1505   v-stat-list[lookup('vt':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] =
     1506                    '' +           chr(4) + string(no) + chr(3) +
     1507                    'запрос':U +   chr(4) + string(no) + chr(3) +
     1508                    'запрос':U +   chr(4) + string(yes) + chr(3) +
     1509                    'накл':U +      chr(4) + string(no) + chr(3) +
     1510                    'накл':U +      chr(4) + string(yes) + chr(3) +
     1511                    'разрешен':U + chr(4) + string(yes) + chr(3) +
     1512                    'разрешен':U + chr(4) + string(no) + chr(3) +
     1513                    'факт':U +      chr(4) + string(yes)
     1514   .
     1515   assign
     1516   v-stat-list[lookup('vt':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 2] =
     1517                    '' +           chr(4) + string(no) + chr(3) +
     1518                    'запрос':U +   chr(4) + string(no) + chr(3) +
     1519                    'запрос':U +   chr(4) + string(yes) + chr(3) +
     1520                    'накл':U +      chr(4) + string(no) + chr(3) +
     1521                    'накл':U +      chr(4) + string(yes) + chr(3) +
     1522                    'разрешен':U + chr(4) + string(yes) + chr(3) +
     1523                    'разрешен':U + chr(4) + string(no) + chr(3) +
     1524                    'факт':U +      chr(4) + string(no)
     1525   .
     1526   assign
     1527   v-stat-list[lookup('es':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] =
     1528                    '' +           chr(4) + string(no) + chr(3) +
     1529                    'касс':U + chr(4) + string(no) + chr(3) +
     1530                    'касс':U + chr(4) + string(yes) + chr(3) +
     1531                    'нередакт':U + chr(4) + string(yes) + chr(3) +
     1532                    'факт':U +      chr(4) + string(yes)
     1533   v-stat-list[lookup('rs':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] =
     1534                    '' +           chr(4) + string(no) + chr(3) +
     1535                    'касс':U + chr(4) + string(no) + chr(3) +
     1536                    'касс':U + chr(4) + string(yes) + chr(3) +
     1537                    'нередакт':U + chr(4) + string(yes) + chr(3) +
     1538                    'факт':U +      chr(4) + string(yes)
     1539   v-stat-list[lookup('es':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 2] =
     1540                    '' +         chr(4) + string(no) + chr(3) +
     1541                    'запрос':U + chr(4) + string(no)
     1542   v-stat-list[lookup('rs':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 2] =
     1543                    '' +         chr(4) + string(no) + chr(3) +
     1544                    'запрос':U + chr(4) + string(no)
     1545   .
     1546   _jj:
     1547   do v-jj = 1 to 2:
     1548     if v-jj = 1 then do:
     1549       assign
     1550       v-waiting-stfl = p-waiting-status + chr(4) + string(if p-waiting-flag = ? then yes else p-waiting-flag)
     1551       .
     1552     end.
     1553     if v-jj = 2 then do:
     1554       if p-waiting-flag <> ? then leave  _jj.
     1555       assign
     1556       v-waiting-stfl = p-waiting-status + chr(4) + string(no)
     1557       .
     1558     end.
     1559     assign
     1560     v-old-stfl = p-oldbh::status_ + chr(4) + string(p-oldbh::flag_)
     1561     .
     1562     assign
     1563     v-new-stfl = p-newbh::status_ + chr(4) + string(p-newbh::flag_)
     1564     .
     1565     _ii:
     1566     do v-ii = (lookup(v-ext-doc-type, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3) to (lookup(v-ext-doc-type, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4):
     1567       if v-stat-list[v-ii] = '' then next.
     1568       assign
     1569       v-waiting-stfl-i = lookup(v-waiting-stfl, v-stat-list[v-ii], chr(3))
     1570       v-old-stfl-i = lookup(v-old-stfl, v-stat-list[v-ii], chr(3))
     1571       v-new-stfl-i = lookup(v-new-stfl, v-stat-list[v-ii], chr(3))
     1572       .
     1573       if v-waiting-stfl-i = 0
     1574       or v-old-stfl-i = 0
     1575       or v-new-stfl-i = 0
     1576       then do:
     1577         next _ii.
     1578       end.
     1579       if v-old-stfl-i < v-waiting-stfl-i
     1580       and v-new-stfl-i = v-waiting-stfl-i then do:
     1581         assign
     1582         p-is-waiting-status = yes
     1583         p-direction = '<закрытие документа>':U + chr(4) + "to".
     1584         return.
     1585       end.
     1586       if v-old-stfl-i < v-waiting-stfl-i
     1587       and v-new-stfl-i > v-waiting-stfl-i then do:
     1588         assign
     1589         p-is-waiting-status = yes
     1590         p-direction = '<закрытие документа>':U + chr(4) + "to-up".
     1591         return.
     1592       end.
     1593       if v-new-stfl-i = v-waiting-stfl-i
     1594       and v-old-stfl-i > v-waiting-stfl-i then do:
     1595         assign
     1596         p-is-waiting-status = yes
     1597         p-direction = '<открытие документа>':U + chr(4) + "to".
     1598         return.
     1599       end.
     1600       if v-new-stfl-i < v-waiting-stfl-i
     1601       and v-old-stfl-i > v-waiting-stfl-i then do:
     1602         assign
     1603         p-is-waiting-status = yes
     1604         p-direction = '<открытие документа>':U + chr(4) + "to-down".
     1605         return.
     1606       end.
     1607       if v-old-stfl-i = v-waiting-stfl-i
     1608       and v-new-stfl-i > v-waiting-stfl-i then do:
     1609         assign
     1610         p-is-waiting-status = yes
     1611         p-direction = '<закрытие документа>':U + chr(4) + "from".
     1612         return.
     1613       end.
     1614       if v-old-stfl-i = v-waiting-stfl-i
     1615       and v-new-stfl-i < v-waiting-stfl-i then do:
     1616         assign
     1617         p-is-waiting-status = yes
     1618         p-direction = '<открытие документа>':U + chr(4) + "from".
     1619         return.
     1620       end.
     1621     end.
     1622   end.
     1623   end.
     1624   end procedure .
     1625   procedure stat-graf-price :
     1626   define input parameter p-oldbh              as handle no-undo .
     1627   define input parameter p-newbh              as handle no-undo .
     1628   define input parameter p-changed-fields     as character no-undo .
     1629   define input parameter p-waiting-status     as character no-undo .
     1630   define input parameter p-waiting-flag       as logical no-undo .
     1631   define output parameter p-is-waiting-status as logical no-undo .
     1632   define output parameter p-direction         as character no-undo .
     1633   define variable v-stat-list as character no-undo extent 5.
     1634   define variable v-waiting-stfl as character no-undo .
     1635   define variable v-old-stfl as character no-undo .
     1636   define variable v-new-stfl as character no-undo .
     1637   define variable v-waiting-stfl-i as integer no-undo .
     1638   define variable v-old-stfl-i as integer no-undo .
     1639   define variable v-new-stfl-i as integer no-undo .
     1640   define variable v-ii as integer no-undo .
     1641   do
     1642   on error undo, return error return-value
     1643   :
     1644   assign
     1645   v-stat-list[1] =
     1646                    ''            +  chr(3) +
     1647                    'новый':U    +  chr(3) +
     1648                    'приказ':U      +  chr(3) +
     1649                    'разрешен':U  +  chr(3) +
     1650                    'акт':U
     1651   .
     1652     assign
     1653     v-waiting-stfl = p-waiting-status
     1654     .
     1655     assign
     1656     v-old-stfl = p-oldbh::status_
     1657     .
     1658     assign
     1659     v-new-stfl = p-newbh::status_
     1660     .
     1661     _ii:
     1662     do v-ii = 1 to 5:
     1663       if v-stat-list[v-ii] = '' then next.
     1664       assign
     1665       v-waiting-stfl-i = lookup(v-waiting-stfl, v-stat-list[v-ii], chr(3))
     1666       v-old-stfl-i = lookup(v-old-stfl, v-stat-list[v-ii], chr(3))
     1667       v-new-stfl-i = lookup(v-new-stfl, v-stat-list[v-ii], chr(3))
     1668       .
     1669       if v-waiting-stfl-i = 0
     1670       or v-old-stfl-i = 0
     1671       or v-new-stfl-i = 0
     1672       then do:
     1673         next _ii.
     1674       end.
     1675       if v-old-stfl-i < v-waiting-stfl-i
     1676       and v-new-stfl-i = v-waiting-stfl-i then do:
     1677         assign
     1678         p-is-waiting-status = yes
     1679         p-direction = '<закрытие документа>':U + chr(4) + "to".
     1680         return.
     1681       end.
     1682       if v-old-stfl-i < v-waiting-stfl-i
     1683       and v-new-stfl-i > v-waiting-stfl-i then do:
     1684         assign
     1685         p-is-waiting-status = yes
     1686         p-direction = '<закрытие документа>':U + chr(4) + "to-up".
     1687         return.
     1688       end.
     1689       if v-new-stfl-i = v-waiting-stfl-i
     1690       and v-old-stfl-i > v-waiting-stfl-i then do:
     1691         assign
     1692         p-is-waiting-status = yes
     1693         p-direction = '<открытие документа>':U + chr(4) + "to".
     1694         return.
     1695       end.
     1696       if v-new-stfl-i < v-waiting-stfl-i
     1697       and v-old-stfl-i > v-waiting-stfl-i then do:
     1698         assign
     1699         p-is-waiting-status = yes
     1700         p-direction = '<открытие документа>':U + chr(4) + "to-down".
     1701         return.
     1702       end.
     1703       if v-old-stfl-i = v-waiting-stfl-i
     1704       and v-new-stfl-i > v-waiting-stfl-i then do:
     1705         assign
     1706         p-is-waiting-status = yes
     1707         p-direction = '<закрытие документа>':U + chr(4) + "from".
     1708         return.
     1709       end.
     1710       if v-old-stfl-i = v-waiting-stfl-i
     1711       and v-new-stfl-i < v-waiting-stfl-i then do:
     1712         assign
     1713         p-is-waiting-status = yes
     1714         p-direction = '<открытие документа>':U + chr(4) + "from".
     1715         return.
     1716       end.
     1717     end.
     1718   end.
     1719   end procedure.
     1720   procedure stat-graf-inkas :
     1721   define input parameter  p-oldbh              as handle no-undo .
     1722   define input parameter  p-newbh              as handle no-undo .
     1723   define input parameter  p-changed-fields     as character no-undo .
     1724   define input parameter  p-waiting-status     as character no-undo .
     1725   define input parameter  p-waiting-flag       as logical no-undo .
     1726   define output parameter p-is-waiting-status  as logical no-undo .
     1727   define output parameter p-direction          as character no-undo .
     1728   define variable v-doc-code as character no-undo .
     1729   define variable v-ext-doc-type as character no-undo .
     1730   define variable v-stat-list as character no-undo extent 3.
     1731   define variable v-jj as integer no-undo .
     1732   define variable v-ii as integer no-undo .
     1733   define variable v-old-stfl as character no-undo .
     1734   define variable v-new-stfl as character no-undo .
     1735   define variable v-waiting-stfl as character no-undo .
     1736   define variable v-old-stfl-i as integer no-undo .
     1737   define variable v-new-stfl-i as integer no-undo .
     1738   define variable v-waiting-stfl-i as integer no-undo .
     1739   do
     1740   on error  undo, return error substitute( "&1. &2&3&4", vss-include-info3, return-value, chr(10), error-status :get-message (1))
     1741   :
     1742   if p-newbh = ?  then do:
     1743     v-doc-code = p-oldbh::inkas-code .
     1744   end.
     1745   else do:
     1746     v-doc-code     = p-newbh::inkas-code .
     1747   end.
     1748   assign
     1749   v-stat-list[1] =
     1750                    '' +           chr(4) + string(no) + chr(3) +
     1751                    'новый':U + chr(4) + string(no) + chr(3) +
     1752                    'факт':U +      chr(4) + string(no)
     1753   v-stat-list[2] =
     1754                    '' +           chr(4) + string(no) + chr(3) +
     1755                    'новый':U + chr(4) + string(no) + chr(3) +
     1756                    'новый':U + chr(4) + string(yes) + chr(3) +
     1757                    'нередакт':U + chr(4) + string(yes) + chr(3) +
     1758                    'факт':U +      chr(4) + string(no)
     1759   v-stat-list[3] =
     1760                    '' +         chr(4) + string(no) + chr(3) +
     1761                    'запрос':U + chr(4) + string(no)
     1762   .
     1763   _jj:
     1764   do v-jj = 1 to 2:
     1765     if v-jj = 1 then do:
     1766       assign
     1767       v-waiting-stfl = p-waiting-status + chr(4) + string(if p-waiting-flag = ? then no else p-waiting-flag)
     1768       .
     1769     end.
     1770     if v-jj = 2 then do:
     1771       if p-waiting-flag <> ? then leave  _jj.
     1772       assign
     1773       v-waiting-stfl = p-waiting-status + chr(4) + string(yes)
     1774       .
     1775     end.
     1776     assign
     1777     v-old-stfl = p-oldbh::status_ + chr(4) + string(p-oldbh::flag_)
     1778     .
     1779     assign
     1780     v-new-stfl = p-newbh::status_ + chr(4) + string(p-newbh::flag_)
     1781     .
     1782     _ii:
     1783     do v-ii = 1 to 3:
     1784       if v-stat-list[v-ii] = '' then next.
     1785       assign
     1786       v-waiting-stfl-i = lookup(v-waiting-stfl, v-stat-list[v-ii], chr(3))
     1787       v-old-stfl-i = lookup(v-old-stfl, v-stat-list[v-ii], chr(3))
     1788       v-new-stfl-i = lookup(v-new-stfl, v-stat-list[v-ii], chr(3))
     1789       .
     1790       if v-waiting-stfl-i = 0
     1791       or v-old-stfl-i = 0
     1792       or v-new-stfl-i = 0
     1793       then do:
     1794         next _ii.
     1795       end.
     1796       if v-old-stfl-i < v-waiting-stfl-i
     1797       and v-new-stfl-i = v-waiting-stfl-i then do:
     1798         assign
     1799         p-is-waiting-status = yes
     1800         p-direction = '<закрытие документа>':U + chr(4) + "to".
     1801         return.
     1802       end.
     1803       if v-old-stfl-i < v-waiting-stfl-i
     1804       and v-new-stfl-i > v-waiting-stfl-i then do:
     1805         assign
     1806         p-is-waiting-status = yes
     1807         p-direction = '<закрытие документа>':U + chr(4) + "to-up".
     1808         return.
     1809       end.
     1810       if v-new-stfl-i = v-waiting-stfl-i
     1811       and v-old-stfl-i > v-waiting-stfl-i then do:
     1812         assign
     1813         p-is-waiting-status = yes
     1814         p-direction = '<открытие документа>':U + chr(4) + "to".
     1815         return.
     1816       end.
     1817       if v-new-stfl-i < v-waiting-stfl-i
     1818       and v-old-stfl-i > v-waiting-stfl-i then do:
     1819         assign
     1820         p-is-waiting-status = yes
     1821         p-direction = '<открытие документа>':U + chr(4) + "to-down".
     1822         return.
     1823       end.
     1824       if v-old-stfl-i = v-waiting-stfl-i
     1825       and v-new-stfl-i > v-waiting-stfl-i then do:
     1826         assign
     1827         p-is-waiting-status = yes
     1828         p-direction = '<закрытие документа>':U + chr(4) + "from".
     1829         return.
     1830       end.
     1831       if v-old-stfl-i = v-waiting-stfl-i
     1832       and v-new-stfl-i < v-waiting-stfl-i then do:
     1833         assign
     1834         p-is-waiting-status = yes
     1835         p-direction = '<открытие документа>':U + chr(4) + "from".
     1836         return.
     1837       end.
     1838     end.
     1839   end.
     1840   end.
     1841   end procedure .
