      902   id
      903   line
      904   index isdone
      905   done
      906   .
      907   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      908   def
      909   new shared
      910   temp-table  obj-list no-undo
      911     field obj-type like ub.clients.obj-type
      912     field obj-code like ub.clients.obj-code
      913     field obj-name like ub.clients.obj-name
      914     field obj-id   as integer
      915     field db-num   as integer
      916     index pi is primary unique obj-id
      917     index ie1 obj-type obj-code
      918     index ie2 obj-name
      919   .
      920   procedure create_obj-list :
      921      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      922      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      923      do
      924      on error undo, return error return-value
      925      :
      926         define buffer cli-obj for ub.clients .
      927         define variable p-var as integer no-undo .
      928         define buffer buf_obj-list for obj-list .
      929         find last buf_obj-list  use-index pi no-error .
      930         if available buf_obj-list
      931         then
      932            p-var = buf_obj-list.obj-id + 1.
      933         else
      934            p-var = 1.
      935         find first cli-obj where
      936                   cli-obj.obj-type = p-obj-type
      937               and cli-obj.obj-code = p-obj-code
      938         no-lock no-error.
      939         if available cli-obj
      940         then do:
      941            create buf_obj-list.
      942            assign
      943               buf_obj-list.obj-id   = p-var
      944               buf_obj-list.obj-code = cli-obj.obj-code
      945               buf_obj-list.obj-type = cli-obj.obj-type
      946               buf_obj-list.obj-name = cli-obj.obj-name
      947               buf_obj-list.db-num   = cli-obj.db-num
      948            .
      949         end.
      950      end.
      951   end.
      952   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      953   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      954   define     temp-table macro-list-hist no-undo
      955   field list-table as character
      956   field id as integer
      957   field line as integer
      958   field hist-mode as character
      959   field des as character
      960   field num-recs as integer
      961   field option_ as character
      962   field item_ as character
      963   field status_ as character
      964   field num-add as integer
      965   field num-ignored as integer
      966   field done as logical
      967   field err_ as logical
      968   field err-mes as character
      969   index pi is primary
      970   id
      971   line
      972   index isdone
      973   done
      974   .
      975   PROCEDURE request-create-macro-list-hist :
      976   DEFINE INPUT PARAMETER p-child-handle AS HANDLE NO-UNDO.
      977   define buffer buf_macro-list-hist for macro-list-hist.
      978   for each buf_macro-list-hist :
      979      RUN proc-create-macro-list-hist IN p-child-handle (
      980                                                          input buf_macro-list-hist.list-table
      981                                                         ,input buf_macro-list-hist.id
      982                                                         ,input buf_macro-list-hist.line
      983                                                         ,input buf_macro-list-hist.hist-mode
      984                                                         ,input buf_macro-list-hist.des
      985                                                         ,input buf_macro-list-hist.option_
      986                                                         ,input buf_macro-list-hist.item_
      987                                                         ,input buf_macro-list-hist.status_
      988                                                          ) no-error .
      989   end.
      990   end procedure.
