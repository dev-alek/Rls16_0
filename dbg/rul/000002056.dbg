     1250             and buf_clob-data.int64-id = buf_clob-bind.int64-id no-error.
     1251       if not available buf_clob-data then do:
     1252                     if valid-handle(p-log-handle) then           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не найден хранимый в БД макрос формирования списка товаров &1", p-list-macro)).
     1253         if valid-handle(p-log-handle) then           run send-msg-to-email in p-log-handle (                 input substitute( "ТН БД &1. Операции с товарами в автоматическом режиме - пересылка/удаление на кассу/с укассы"                                         , g#db-num)               , input substitute("Не найден хранимый в БД макрос формирования списка товаров &1", p-list-macro)               , input '').
     1254         return error.
     1255       end.
     1256       run gbl/_tmpfile.p ( input ""
     1257                     ,input "tmp"
     1258                     ,output f-name) .
     1259       copy-lob from object buf_clob-data.cdata
     1260       to file f-name.
     1261       run gbl/filename.p
     1262         (input  f-name
     1263         ,output v-full-path
     1264         ,output v-path
     1265         ,output v-file-name
     1266         ,output v-file-name-no-ext
     1267         ,output v-file-name-ext
     1268         ) no-error .
     1269       if error-status:error then do:
     1270                     if valid-handle(p-log-handle) then           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не удалось получить хранимый в БД макрос формирования списка товаров &1 из временного файла &2&3&4&3&5"                                   , p-list-macro                                   , f-name                                   , chr(10)                                   , error-status:get-message(1)                                    , return-value  )).
     1271         if valid-handle(p-log-handle) then           run send-msg-to-email in p-log-handle (                 input substitute( "ТН БД &1. Операции с товарами в автоматическом режиме - пересылка/удаление на кассу/с укассы"                                         , g#db-num)               , input substitute("Не удалось получить хранимый в БД макрос формирования списка товаров &1 из временного файла &2&3&4&3&5"                                   , p-list-macro                                   , f-name                                   , chr(10)                                   , error-status:get-message(1)                                    , return-value  )               , input '').
     1272         return error.
     1273       end.
     1274       input stream ext-file from value (v-full-path).
     1275       _macro:
     1276       repeat:
     1277         v-ii = v-ii + 1.
     1278         create macro-list-hist.
