     1282           if valid-handle(p-log-handle) then           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не удалось загрузить хранимый в БД список товаров &1 из временного файла &2&3&4Неверный формат"                                     , p-list                                     , f-name                                     , chr(10)                                     , error-status:get-message(1) )).
     1283           if valid-handle(p-log-handle) then           run send-msg-to-email in p-log-handle (                 input substitute( "ТН БД &1. Операции с товарами в автоматическом режиме - пересылка/удаление на кассу/с укассы"                                         , g#db-num)               , input substitute("Не удалось загрузить хранимый в БД список товаров &1 из временного файла &2&3&4Неверный формат"                                     , p-list                                     , f-name                                     , chr(10)                                     , error-status:get-message(1) )               , input '').
     1284           return error .
     1285         end.
     1286         assign
     1287         macro-list-hist.num-rec = 0
     1288         macro-list-hist.num-add = 0
     1289         macro-list-hist.num-ignored = 0
     1290         v-id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     1291         macro-list-hist.done = no
     1292         .
     1293       end.
     1294       find first macro-list-hist where
     1295               macro-list-hist.id = 0.
     1296       delete macro-list-hist.
     1297       input stream ext-file close.
     1298       os-delete value(v-full-path).
     1299       for each obj-list:
     1300         empty temp-table gds-list.
     1301   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1302   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1303     (input  obj-list.obj-type
     1304     ,input  obj-list.obj-code
     1305     ,output v-host-code
     1306     )  .
     1307         run str/gdsqlist.w (
     1308                          input parparentproc
     1309                         ,input this-procedure:handle
     1310                         ,input v-host-code
     1311                         ,input obj-list.obj-type
     1312                         ,input obj-list.obj-code
     1313                         ,input 'hide'
     1314                         ,input substitute("Товары, отобранные макросом из файла &1", v-file-name)
     1315                         ,input yes
