     1317         if error-status:error then do:
     1318                           if valid-handle(p-log-handle) then           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute( " Ошибка отсылки/удаления на кассу/с кассы списка товаров по расписанию: Ошибка при заполнении списка товаров согласно макросу&1&2"                                          , chr(10)                                         , error-status:get-message(1) )).
     1319           if valid-handle(p-log-handle) then           run send-msg-to-email in p-log-handle (                 input substitute( "ТН БД &1. Операции с товарами в автоматическом режиме - пересылка/удаление на кассу/с укассы"                                         , g#db-num)               , input substitute( " Ошибка отсылки/удаления на кассу/с кассы списка товаров по расписанию: Ошибка при заполнении списка товаров согласно макросу&1&2"                                          , chr(10)                                         , error-status:get-message(1) )               , input '').
     1320           input stream ext-file close.
     1321           return error .
     1322         end.
     1323         if can-find (first gds-list) then do:
     1324           run str/diallog.w ( input parparentproc
     1325                       , input this-procedure
     1326                       , input (if p-action = "U" then 'str/send-gds.p':U else "str/del-gds.p ")
     1327                       , input (if p-action = "U"
     1328                                then ( string( - obj-list.obj-code) + chr(4) +  "no":U)
     1329                                else string(obj-list.obj-code) + chr(4) + chr(63))
     1330                       , input yes
     1331                       , input ''
