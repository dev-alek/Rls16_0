     1090   define variable imp-art as character no-undo .
     1091   define variable lns-cnt as integer no-undo .
     1092   define variable line-rec as recid no-undo .
     1093   define variable v-ii as integer no-undo .
     1094   define variable v-host-code as integer no-undo .
