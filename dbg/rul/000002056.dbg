     1098   run gbl/filename.p
     1099     (input "send-cd.txt"
     1100     ,output v-full-path
     1101     ,output v-path
     1102     ,output v-file-name
     1103     ,output v-file-name-no-ext
     1104     ,output v-file-name-ext
     1105     ) no-error .
     1106   os-delete value(v-full-path).
