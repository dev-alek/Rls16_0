     1241            and  buf_clob-bind.uniq-key-rec = entry(1, p-list-macro, "_")
     1242            and  buf_clob-bind.field-name_ = entry(2, p-list-macro, "_") no-error.
     1243       if not available buf_clob-bind then do:
     1244                     if valid-handle(p-log-handle) then           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не найдена ссылка на хранимый в БД макрос формирования списка товаров &1", p-list-macro)).
     1245         if valid-handle(p-log-handle) then           run send-msg-to-email in p-log-handle (                 input substitute( "ТН БД &1. Операции с товарами в автоматическом режиме - пересылка/удаление на кассу/с укассы"                                         , g#db-num)               , input substitute("Не найдена ссылка на хранимый в БД макрос формирования списка товаров &1", p-list-macro)               , input '').
     1246         return ''.
     1247       end.
     1248       find first buf_clob-data no-lock where
