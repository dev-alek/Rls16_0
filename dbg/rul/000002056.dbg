     1108     when 'list':U then do:
     1109       find first buf_clob-bind no-lock where
     1110                 buf_clob-bind.resource-type = p-method
     1111            and  buf_clob-bind.uniq-key-rec = entry(1, p-list, "_")
     1112            and  buf_clob-bind.field-name_ = entry(2, p-list, "_") no-error.
     1113       if not available buf_clob-bind then do:
     1114                     if valid-handle(p-log-handle) then           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не найдена ссылка на хранимый в БД список товаров &1", p-list)).
     1115         if valid-handle(p-log-handle) then           run send-msg-to-email in p-log-handle (                 input substitute( "ТН БД &1. Операции с товарами в автоматическом режиме - пересылка/удаление на кассу/с укассы"                                         , g#db-num)               , input substitute("Не найдена ссылка на хранимый в БД список товаров &1", p-list)               , input '').
     1116         return error.
     1117       end.
     1118       find first buf_clob-data no-lock where
     1119                 buf_clob-data.db-num = buf_clob-bind.db-num
     1120             and buf_clob-data.int64-id = buf_clob-bind.int64-id no-error.
     1121       if not available buf_clob-data then do:
