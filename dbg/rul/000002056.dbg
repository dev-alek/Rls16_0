     1036         input 1
     1037       , input log-file-name
     1038       , input 1
     1039       , input p-str).
     1040   end procedure.
     1041   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1042   procedure set-error :
     1043   define input parameter p-mess as character no-undo .
     1044     do
     1045     on error undo, return error
     1046     :
     1047        assign
     1048        v-last-error-message = p-mess.
     1049     end.
     1050   end procedure.
     1051     define variable p-method as character no-undo.
     1052     define variable p-action as character no-undo .
     1053     define variable p-list as character no-undo .
     1054     define variable p-list-macro as character no-undo .
     1055   on delete of this-procedure do:
     1056     run garbcoll_clear in this-procedure .
     1057   end.
     1058   run load-ruleset-context in this-procedure ( input p-ruleset-id) no-error.
     1059   if error-status:error then do:
     1060     undo, return error return-value .
     1061   end.
     1062   if return-value = "return" then return ''.
     1063   if not this-procedure:persistent then do:
     1064     run proc-main in this-procedure no-error .
     1065     if error-status:error then do:
     1066       v-esm = error-status :get-message (1).
     1067       v-es = error-status:error .
     1068       v-rv = return-value .
     1069     end.
     1070     if v-es then do:
     1071         run garbcoll_clear in this-procedure .
     1072         undo, return error substitute( "&1. &2&3&4", vss-workfile, v-rv, chr(10), v-esm).
     1073     end.
     1074     run garbcoll_clear in this-procedure .
     1075   end.
     1076   procedure proc-main :
     1077   _main:
     1078   do
     1079   on error undo, return error substitute( "&1&2&3&2&4", return-value, chr(10), error-status :get-message (1), v-last-error-message)
     1080   :
     1081   define variable v-err as logical no-undo .
     1082   define variable f-name as character no-undo .
     1083   define variable v-full-path        as character no-undo .
     1084   define variable v-path             as character no-undo .
     1085   define variable v-file-name        as character no-undo .
     1086   define variable v-file-name-no-ext as character no-undo .
     1087   define variable v-file-name-ext    as character no-undo .
     1088   define variable imp-type as character no-undo .
