     1345                         ,output v-file-name-no-ext
     1346                         ,output v-file-name-ext
     1347                         ) no-error .
     1348                   if valid-handle(p-log-handle) then           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute( " Ошибка отсылки/удаления на кассу/с кассы списка товаров по расписанию: Ошибка в процессе отсылки на кассы маг&1"                                          , obj-list.obj-code )).
     1349           if valid-handle(p-log-handle) then           run send-msg-to-email in p-log-handle (                 input substitute( "ТН БД &1. Операции с товарами в автоматическом режиме - пересылка/удаление на кассу/с укассы"                                         , g#db-num)               , input substitute( " Ошибка отсылки/удаления на кассу/с кассы списка товаров по расписанию: Ошибка в процессе отсылки на кассы маг&1"                                          , obj-list.obj-code )               , input v-full-path).
     1350           end.
     1351         end.
     1352         else do:
     1353               if valid-handle(p-log-handle) then           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute(" При отсылке/удалении на кассу/с кассы списка товаров по расписанию после формирования списка в список не попало ни одного товара: Ошибка в процессе отсылки на кассы маг&1"                                            , obj-list.obj-code )).
     1354         end.
     1355       end.
     1356     end.
     1357   end case.
     1358   end.
     1359   end procedure.
     1360   procedure load-ruleset-context :
     1361   define input parameter p-ruleset-id as integer no-undo .
     1362   define buffer buf_rule-call-param for ub.rule-call-param.
     1363   define buffer buf_temp-rule-call-param for temp-rule-call-param.
     1364   define buffer buf_clients for ub.clients.
     1365   do
     1366   on error undo, return error
     1367   :
     1368     find first buf_rule-call-param no-lock where
     1369   buf_rule-call-param.codex_id = p-codex-id
     1370   and buf_rule-call-param.ruleset_id = p-ruleset-id
     1371   and buf_rule-call-param.call_id = p-call-id
     1372   and buf_rule-call-param.order_id = p-order-id
     1373   and buf_rule-call-param.rule_id = p-rule-id
     1374   and buf_rule-call-param.param-name = "p-method"
     1375    no-error.
     1376   if available buf_rule-call-param then do:
     1377     assign p-method = buf_rule-call-param.param-value-character.
     1378   end.
     1379     find first buf_rule-call-param no-lock where
     1380   buf_rule-call-param.codex_id = p-codex-id
     1381   and buf_rule-call-param.ruleset_id = p-ruleset-id
     1382   and buf_rule-call-param.call_id = p-call-id
     1383   and buf_rule-call-param.order_id = p-order-id
     1384   and buf_rule-call-param.rule_id = p-rule-id
     1385   and buf_rule-call-param.param-name = "p-action"
     1386    no-error.
     1387   if available buf_rule-call-param then do:
     1388     assign p-action = buf_rule-call-param.param-value-character.
     1389   end.
     1390     find first buf_rule-call-param no-lock where
     1391   buf_rule-call-param.codex_id = p-codex-id
     1392   and buf_rule-call-param.ruleset_id = p-ruleset-id
     1393   and buf_rule-call-param.call_id = p-call-id
     1394   and buf_rule-call-param.order_id = p-order-id
     1395   and buf_rule-call-param.rule_id = p-rule-id
     1396   and buf_rule-call-param.param-name = "p-list"
     1397    no-error.
     1398   if available buf_rule-call-param then do:
     1399     assign p-list = buf_rule-call-param.param-value-character.
     1400   end.
     1401     find first buf_rule-call-param no-lock where
     1402   buf_rule-call-param.codex_id = p-codex-id
     1403   and buf_rule-call-param.ruleset_id = p-ruleset-id
     1404   and buf_rule-call-param.call_id = p-call-id
     1405   and buf_rule-call-param.order_id = p-order-id
     1406   and buf_rule-call-param.rule_id = p-rule-id
     1407   and buf_rule-call-param.param-name = "p-list-macro"
     1408    no-error.
     1409   if available buf_rule-call-param then do:
     1410     assign p-list-macro = buf_rule-call-param.param-value-character.
     1411   end.
     1412   for each buf_rule-call-param no-lock where
     1413   buf_rule-call-param.codex_id = p-codex-id
     1414   and buf_rule-call-param.ruleset_id = p-ruleset-id
     1415   and buf_rule-call-param.call_id = p-call-id
     1416   and buf_rule-call-param.order_id = p-order-id
     1417   and buf_rule-call-param.rule_id = p-rule-id
     1418   and buf_rule-call-param.param-name = "p-shops"
     1419   and buf_rule-call-param.p-index > 0:
     1420     create buf_temp-rule-call-param.
     1421     buffer-copy buf_rule-call-param to buf_temp-rule-call-param.
     1422     release buf_temp-rule-call-param.
     1423   end.
     1424     if not can-find(first temp-rule-call-param where
     1425                    temp-rule-call-param.param-name = "p-shops") then do:
     1426       for each buf_clients no-lock where
     1427               buf_clients.obj-type = 'маг':U
     1428           and buf_clients.db-num = g#db-num:
     1429         run create_obj-list in this-procedure ( input buf_clients.obj-type
     1430                                                 ,input buf_clients.obj-code).
     1431       end.
     1432     end.
     1433     else do:
     1434       for each buf_temp-rule-call-param where
     1435              buf_temp-rule-call-param.param-name = "p-shops":
     1436         find first buf_clients no-lock
     1437           where buf_clients.obj-type  = 'маг':U
     1438             and buf_clients.obj-code = buf_temp-rule-call-param.param-value-integer
     1439         no-error.
     1440         if not available buf_clients
     1441         then do:
     1442                                 if valid-handle(p-log-handle) then           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute( " Ошибка отсылки/удаления на кассу/с кассы списка товаров по расписанию&3: Не найден заданный объект &1&2"                                            , 'маг':U                                           , buf_temp-rule-call-param.param-value-integer                                           , chr(10))).
     1443             if valid-handle(p-log-handle) then           run send-msg-to-email in p-log-handle (                 input substitute( "ТН БД &1. Операции с товарами в автоматическом режиме - пересылка/удаление на кассу/с укассы"                                         , g#db-num)               , input substitute( " Ошибка отсылки/удаления на кассу/с кассы списка товаров по расписанию&3: Не найден заданный объект &1&2"                                            , 'маг':U                                           , buf_temp-rule-call-param.param-value-integer                                           , chr(10))               , input '').
     1444             undo, return error .
     1445         end.
     1446         else do:
     1447           if buf_clients.db-num = g#db-num
     1448           and buf_clients.obj-type = 'маг':U
     1449           then do:
     1450             run create_obj-list in this-procedure ( input buf_clients.obj-type
     1451                                                     ,input buf_clients.obj-code).
     1452           end.
     1453         end.
     1454       end.
     1455     end.
     1456       case p-ruleset-id:
     1457         when 10 then do:
     1458         end.
     1459         otherwise do:
     1460           undo, return error substitute("Вызов процедуры &1 в неверном контексте", p-rule-id).
     1461         end.
     1462       end case.
     1463   end.
     1464   end procedure.
     1465   procedure cb_get-gds-list :
     1466   define input parameter p-handle as handle no-undo .
     1467   for each gds-list:
     1468     run cb_set-gds-list in p-handle ( input (buffer gds-list:handle)).
     1469   end.
     1470   end procedure.
     1471   procedure cb_set-view-log :
     1472   define input parameter p-view-log as logical no-undo .
     1473   v-view-log = yes.
     1474   end procedure.
