      884     .
      885   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      886   define  new shared  temp-table gds-list-hist no-undo
      887   field list-table as character
      888   field id as integer
      889   field line as integer
      890   field hist-mode as character
      891   field des as character
      892   field num-recs as integer
      893   field option_ as character
      894   field item_ as character
      895   field status_ as character
      896   field num-add as integer
      897   field num-ignored as integer
      898   field done as logical
      899   field err_ as logical
      900   field err-mes as character
