     1123         if valid-handle(p-log-handle) then           run send-msg-to-email in p-log-handle (                 input substitute( "ТН БД &1. Операции с товарами в автоматическом режиме - пересылка/удаление на кассу/с укассы"                                         , g#db-num)               , input substitute("Не найден хранимый в БД список товаров &1", p-list)               , input '').
     1124         return error.
     1125       end.
     1126       run gbl/_tmpfile.p ( input ""
     1127                     ,input "tmp"
     1128                     ,output f-name) .
     1129       copy-lob from object buf_clob-data.cdata
     1130       to file f-name.
     1131       run gbl/filename.p
     1132         (input  f-name
     1133         ,output v-full-path
     1134         ,output v-path
     1135         ,output v-file-name
     1136         ,output v-file-name-no-ext
     1137         ,output v-file-name-ext
     1138         ) no-error .
     1139       if error-status:error then do:
     1140                     if valid-handle(p-log-handle) then           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не удалось получить хранимый в БД список товаров &1 из временного файла &2&3&4&3&5"                                   , p-list                                   , f-name                                   , chr(10)                                   , error-status:get-message(1)                                    , return-value  )).
     1141         if valid-handle(p-log-handle) then           run send-msg-to-email in p-log-handle (                 input substitute( "ТН БД &1. Операции с товарами в автоматическом режиме - пересылка/удаление на кассу/с укассы"                                         , g#db-num)               , input substitute("Не удалось получить хранимый в БД список товаров &1 из временного файла &2&3&4&3&5"                                   , p-list                                   , f-name                                   , chr(10)                                   , error-status:get-message(1)                                    , return-value  )               , input '').
     1142         return error.
     1143       end.
     1144       input stream ext-file from value (v-full-path).
     1145       repeat:
     1146         imp-type = ''.
     1147         v-ii = v-ii + 1.
     1148         import stream ext-file imp-type imp-code imp-art no-error.
     1149         if error-status:error
     1150         and (imp-type <> ''
     1151              or v-ii = 1) then do:
     1152           input stream ext-file close.
     1153                           if valid-handle(p-log-handle) then           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не удалось загрузить хранимый в БД список товаров &1 из временного файла &2&3&4Неверный формат"                                     , p-list                                     , f-name                                     , chr(10)                                     , error-status:get-message(1) )).
     1154           if valid-handle(p-log-handle) then           run send-msg-to-email in p-log-handle (                 input substitute( "ТН БД &1. Операции с товарами в автоматическом режиме - пересылка/удаление на кассу/с укассы"                                         , g#db-num)               , input substitute("Не удалось загрузить хранимый в БД список товаров &1 из временного файла &2&3&4Неверный формат"                                     , p-list                                     , f-name                                     , chr(10)                                     , error-status:get-message(1) )               , input '').
     1155           return error.
     1156         end.
     1157         find first buf_goods where buf_goods.prod-type = imp-type
     1158                     and buf_goods.prod-code = imp-code
     1159                     and buf_goods.artic     = imp-art no-lock no-error.
     1160         if available buf_goods then do:
     1161   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1162   find gds-list
     1163     where gds-list.prod-type = buf_goods.prod-type
     1164       and gds-list.prod-code = buf_goods.prod-code
     1165       and gds-list.artic     = buf_goods.artic
     1166     no-error .
     1167   if available gds-list then do:
     1168     assign
     1169       gds-list.to-del = no
     1170     .
     1171   end.
     1172   else do:
     1173     define variable v-last11 as integer no-undo .
     1174     find last gds-list use-index oi no-error.
     1175     if available gds-list then do:
     1176       v-last11 = gds-list.order-num .
     1177     end.
     1178     else do:
     1179       v-last11 = 0 .
     1180     end.
     1181     create gds-list .
     1182     buffer-copy buf_goods to gds-list
     1183     assign
     1184       gds-list.to-del = no
     1185       gds-list.order-num = v-last11 + 1
     1186     .
     1187     assign
     1188       lns-cnt = lns-cnt + 1
     1189       line-rec = recid (gds-list)
     1190     .
     1191   end.
     1192         end.
     1193       end.
     1194       input stream ext-file close.
     1195       os-delete value(v-full-path) .
     1196       if can-find(first gds-list no-lock) then do:
     1197         for each obj-list:
     1198           run str/diallog.w ( input parparentproc
     1199                       , input this-procedure
     1200                       , input (if p-action = "U" then 'str/send-gds.p':U else "str/del-gds.p ")
     1201                       , input (if p-action = "U"
     1202                                then ( string( - obj-list.obj-code) + chr(4) +  "no":U)
     1203                                else string(obj-list.obj-code) + chr(4) + chr(63))
     1204                       , input yes
     1205                       , input ''
     1206                       , input (if p-action = "U"
     1207                         then substitute('Отсылка товаров на кассу маг &1', obj-list.obj-code)
     1208                         else substitute("Удаление товаров с кассы маг &1", obj-list.obj-code)
     1209                             )
     1210                         ) no-error .
     1211           if error-status:error
     1212           then do:
     1213                       v-full-path = ''.
     1214             run gbl/filename.p (
     1215                           input "send-cd.txt"
     1216                           ,output v-full-path
     1217                           ,output v-path
     1218                           ,output v-file-name
     1219                           ,output v-file-name-no-ext
     1220                           ,output v-file-name-ext
     1221                           ) no-error .
     1222                       if valid-handle(p-log-handle) then           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute( " Ошибка отсылки/удаления на кассу/с кассы списка товаров по расписанию: Ошибка в процессе отсылки на кассы маг&1"                                            , obj-list.obj-code )).
     1223             if valid-handle(p-log-handle) then           run send-msg-to-email in p-log-handle (                 input substitute( "ТН БД &1. Операции с товарами в автоматическом режиме - пересылка/удаление на кассу/с укассы"                                         , g#db-num)               , input substitute( " Ошибка отсылки/удаления на кассу/с кассы списка товаров по расписанию: Ошибка в процессе отсылки на кассы маг&1"                                            , obj-list.obj-code )               , input v-full-path).
     1224           end.
     1225         end.
     1226       end.
     1227       else do:
     1228               if valid-handle(p-log-handle) then           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute(" При отсылке/удалении на кассу/с кассы списка товаров по расписанию в списке не было обнаружено товаров: Ошибка в процессе отсылки на кассы маг&1"                                            , obj-list.obj-code )).
     1229     end.
     1230     end.
     1231     when 'list-macro':U then do:
     1232       define variable v-id as integer no-undo .
     1233       for each macro-list-hist:
     1234         delete macro-list-hist.
     1235       end.
