      992   define variable v-current-artic as character no-undo .
      993   define variable v-current-prod-type as character no-undo .
      994   define variable v-current-prod-code as integer no-undo .
      995   define variable v-current-host-code as integer no-undo .
      996   define variable v-current-obj-type as character no-undo .
      997   define variable v-current-obj-code as integer no-undo .
      998   define variable v-current-doc-code as character no-undo .
      999   define variable v-esys-cmd-proc-handle as handle no-undo .
     1000   define variable v-esys-cmd-code as integer no-undo .
     1001   define variable log-file-name                as character      no-undo init "shd-free.log".
     1002   define variable v-view-log                   as logical        no-undo .
     1003   define variable v-stop                       as logical        no-undo .
     1004   define variable v-last-error-message as character no-undo .
     1005   define variable file-name as char.
     1006   define variable v-sign as integer no-undo .
     1007   define variable num-rec as integer no-undo .
     1008   define variable num-rec-ok as integer no-undo .
     1009   define variable l-res as integer no-undo .
     1010   define variable v-es as logical no-undo .
     1011   define variable v-esm as character no-undo .
     1012   define variable v-rv as character no-undo .
     1013   define variable v-err-mess as character no-undo .
     1014   define temp-table temp-rule-call-param no-undo like ub.rule-call-param.
     1015   define stream ext-file.
     1016   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1017   procedure write-to-screen :
     1018   define input param p-str as character no-undo .
     1019   run write-log-and-file in p-log-handle (
     1020         input 1
     1021       , input log-file-name
     1022       , input 1
     1023       , input p-str).
     1024   end procedure.
     1025   procedure write-to-log :
     1026   define input param p-str as character no-undo .
     1027   run write-log-and-file in p-log-handle (
     1028         input 1
     1029       , input log-file-name
     1030       , input 1
     1031       , input p-str).
     1032   end procedure.
     1033   procedure write-to-log-notime :
     1034   define input param p-str as character no-undo .
