     1047   procedure library-cls_get-handle :
     1048   define input parameter p-library-name as character no-undo .
     1049   define output parameter p-library-handle as handle no-undo .
     1050     do
     1051     on error undo, return error
     1052     :
     1053       CASE p-library-name:
     1054         when "library" then do:
     1055           if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end.
     1056           p-library-handle = g#library.
     1057         end.
     1058         when "library2" then do:
     1059           if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end.
     1060           p-library-handle = g#library2.
     1061         end.
     1062       end case.
     1063     end.
     1064   end procedure.
     1065   def var vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1066   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1067   define variable tempcxml_v-num_ as integer no-undo .
     1068   define shared temp-table temp-xml-tables no-undo
     1069   field order as integer
     1070   field tbl-name as character
     1071   field tbl-handle_ as handle
     1072   field table-handle_ as handle
     1073   field uniq-gate-rec as character
     1074   field gate-name as character
     1075   field gate-handle_ as handle
     1076   field is-parent as logical
