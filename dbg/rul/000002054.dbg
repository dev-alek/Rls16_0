     1652   procedure thdl-prc_map-obj :
     1653     define input  parameter p-obj-type  as character no-undo .
     1654     define input  parameter p-obj-code  as integer   no-undo .
     1655     define output parameter p-code      as integer   no-undo .
     1656     define buffer buf_store   for ub.store.
     1657     define buffer buf_shop    for ub.shop.
     1658     define buffer buf_clients for ub.clients.
     1659   do for
     1660     buf_store
     1661   , buf_shop
     1662   , buf_clients
     1663   on error undo, return error return-value
     1664   :
     1665     assign
     1666       p-code = ?
     1667     .
     1668     case p-obj-type
     1669     :
     1670       when 'маг':U
     1671       then do:
     1672         find first buf_shop no-lock
     1673           where buf_shop.obj-code = p-obj-code
     1674         no-error .
     1675         if not available buf_shop
     1676         then do:
     1677           return error substitute( "Не найден магазин с кодом:&1":U , p-obj-code ) .
     1678         end.
     1679         assign
     1680           p-code = buf_shop.obj-code
     1681         .
     1682       end.
     1683       when 'скл':U
     1684       then do:
     1685         find first buf_store no-lock
     1686           where buf_store.obj-code = p-obj-code
     1687         no-error .
     1688         if not available buf_store
     1689         then do:
     1690           return error substitute( "Не найден склад с кодом:&1":U , p-obj-code ) .
     1691         end.
     1692         assign
     1693           p-code = 100000 + buf_store.obj-code
     1694         .
     1695       end.
     1696       when 'чел':U
     1697       then do:
     1698         find first buf_clients no-lock
     1699           where buf_clients.obj-type = p-obj-type
     1700             and buf_clients.obj-code = p-obj-code
     1701         no-error .
     1702         if not available buf_clients
     1703         then do:
     1704           return error substitute( "Не найден контрагент &1 &2" , p-obj-type, p-obj-code ) .
     1705         end.
     1706         assign
     1707           p-code = buf_clients.obj-code
     1708         .
     1709       end.
     1710       when 'орг':U
     1711       then do:
     1712         find first buf_clients no-lock
     1713           where buf_clients.obj-type = p-obj-type
     1714             and buf_clients.obj-code = p-obj-code
     1715         no-error .
     1716         if not available buf_clients
     1717         then do:
     1718           return error substitute( "Не найден контрагент &1 &2" , p-obj-type, p-obj-code ) .
     1719         end.
     1720         assign
     1721           p-code = 1000000000 + buf_clients.obj-code
     1722         .
     1723       end.
     1724       otherwise do:
     1725         return error substitute( "Недопустимый тип контрагента:&1":U , p-obj-type ).
     1726       end.
     1727     end case.
     1728   end.
     1729   end procedure.
     1730   procedure thdl-prc_unmap-store :
     1731     define input  parameter p-code      as integer   no-undo .
     1732     define output parameter p-obj-type  as character no-undo .
     1733     define output parameter p-obj-code  as integer   no-undo .
     1734     define buffer buf_store   for ub.store.
     1735     define buffer buf_shop    for ub.shop.
     1736     define variable v-code as integer   no-undo .
     1737   do for
     1738     buf_store
     1739   , buf_shop
     1740   on error undo, return error return-value
     1741   :
     1742     assign
     1743       p-obj-type = ?
     1744       p-obj-code = ?
     1745     .
     1746     if p-code > 100000
     1747     then do :
     1748       assign
     1749         v-code = p-code - 100000
     1750       .
     1751       find first buf_store no-lock
     1752         where buf_store.obj-code = v-code
     1753       no-error .
     1754       if not available buf_store
     1755       then do:
     1756         return .
     1757       end.
     1758       assign
     1759         p-obj-type = 'скл':U
     1760         p-obj-code = buf_store.obj-code
     1761       .
     1762     end.
     1763     else do:
     1764       find first buf_shop no-lock
     1765         where buf_shop.obj-code = p-code
     1766       no-error .
     1767       if not available buf_shop
     1768       then do:
     1769         return .
     1770       end.
     1771       assign
     1772         p-obj-type = 'маг':U
     1773         p-obj-code = buf_shop.obj-code
     1774       .
     1775     end.
     1776   end.
     1777   end procedure.
     1778   procedure thdl-prc_unmap-agent :
     1779     define input  parameter p-code      as integer   no-undo .
     1780     define output parameter p-obj-type  as character no-undo .
     1781     define output parameter p-obj-code  as integer   no-undo .
     1782     define variable v-code as integer   no-undo .
     1783     define buffer buf_clients for ub.clients.
     1784   do for
     1785     buf_clients
     1786   on error undo, return error return-value
     1787   :
     1788     assign
     1789       p-obj-type = ?
     1790       p-obj-code = ?
     1791     .
     1792     if p-code > 1000000000
     1793     then do:
     1794       assign
     1795         v-code = p-code - 1000000000
     1796       .
     1797       find first buf_clients no-lock
     1798         where buf_clients.obj-type = 'орг':U
     1799           and buf_clients.obj-code = v-code
     1800       no-error .
     1801       if not available buf_clients
     1802       then do:
     1803         return .
     1804       end.
     1805       assign
     1806         p-obj-type = 'орг':U
     1807         p-obj-code = buf_clients.obj-code
     1808       .
     1809     end.
     1810     else do:
     1811       find first buf_clients no-lock
     1812         where buf_clients.obj-type = 'чел':U
     1813           and buf_clients.obj-code = p-code
     1814       no-error .
     1815       if not available buf_clients
     1816       then do:
     1817         return .
     1818       end.
     1819       assign
     1820         p-obj-type = 'чел':U
     1821         p-obj-code = buf_clients.obj-code
     1822       .
     1823     end.
     1824   end.
     1825   end procedure.
