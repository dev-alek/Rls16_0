        1   using Ibs.Th.Rul.Route-data_.
        2   block-level on error undo, throw.
        3   define input parameter parparentproc as widget-handle no-undo .
        4   define input parameter p-parent-handle as handle no-undo .
        5   define input parameter p-log-handle  as handle no-undo .
        6   define input parameter p-cont-handle  as handle no-undo .
        7   define input parameter p-codex-id as integer no-undo .
        8   define input parameter p-ruleset-id as integer no-undo .
        9   define input parameter p-call-id as character no-undo .
       10   define input parameter p-order-id as integer no-undo .
       11   define input parameter p-rule-id as integer no-undo .
       12   define input parameter p-profile-id as integer no-undo .
       13   define input parameter p-is-dynamic as logical no-undo .
       14   define input parameter p-doc-type as character no-undo .
       15   define input parameter p-host-code like ub.sysconf.host-code no-undo .
       16   define input parameter p-obj-type like ub.clients.obj-type no-undo .
       17   define input parameter p-obj-code like ub.clients.obj-code no-undo .
       18   define input parameter p-doc-code as character no-undo .
       19   define input parameter p-process-file-name as character no-undo .
       20   define input parameter p-save       as integer no-undo .
       21   define input parameter v-curr-r-b   as character no-undo .
       22   define input parameter p-cmd-proc-handle as handle no-undo .
       23   define input parameter p-cmd-code  as integer no-undo .
       24   define variable vss-revision    as character no-undo init "$Revision$":U .
       25   define variable vss-author      as character no-undo init "$Author$":U .
       26   define variable vss-date        as character no-undo init "$Date$":U .
       27   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       28   define variable vss-archive     as character no-undo init "$Archive$":U .
       29   define variable vss-description as character no-undo init "Библиотека процедур для работы с кодексом 18 набор правил 16".
       30   procedure vss-get-info :
       31     define output parameter p-vss-revision    like vss-revision    no-undo .
       32     define output parameter p-vss-author      like vss-author      no-undo .
       33     define output parameter p-vss-date        like vss-date        no-undo .
       34     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       35     define output parameter p-vss-archive     like vss-archive     no-undo .
       36     define output parameter p-vss-description like vss-description no-undo .
       37     assign
       38       p-vss-revision    = vss-revision
       39       p-vss-author      = vss-author
       40       p-vss-date        = vss-date
       41       p-vss-workfile    = vss-workfile
       42       p-vss-archive     = vss-archive
       43       p-vss-description = vss-description
       44     .
       45   end procedure.
       46   procedure vss-get-parameters :
       47     define output parameter p-vss-parameters as character no-undo .
       48   end procedure.
       49   define new global shared variable g#vssrevis-logger as handle    no-undo .
       50   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       51   define variable v-vssrevis-logger                   as handle    no-undo .
       52   procedure vss-logevent :
       53     define input  parameter p-extra-paramters as character no-undo .
       54     define variable v-vssrevis-parameters as character no-undo .
       55     do
       56     on error undo, return error return-value
       57     :
       58       if  valid-handle(v-vssrevis-logger)
       59       and v-vssrevis-logger :get-signature("logevent") <> ""
       60       then do:
       61         run vss-get-parameters in this-procedure
       62           (output v-vssrevis-parameters
       63           ).
       64         run logevent in v-vssrevis-logger
       65           (input vss-workfile
       66           ,input vss-revision
       67           ,input v-vssrevis-parameters
       68           ,input p-extra-paramters
       69           ).
       70       end.
       71     end.
       72   end procedure.
       73   assign
       74     v-vssrevis-logger = g#vssrevis-logger
       75   .
       76   if  valid-handle(v-vssrevis-logger)
       77   and v-vssrevis-logger :get-signature("logevent") <> ""
       78   then do:
       79     assign
       80       v-vssrevis-logevent = true
       81     .
       82     run vss-logevent in this-procedure (input vss-description) .
       83   end.
       84   define new global shared variable g#language as character no-undo .
       85   if g#language <> '' and g#language <> 'rus':U then do:
       86     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       87   end.
       88   define new global shared variable g#library  as handle no-undo .
       89   define new global shared variable g#library2 as handle no-undo .
       90   define   shared variable g#auto as logical no-undo.
       91   define   shared variable g#news as logical no-undo.
       92   define   shared variable g#oxml as logical no-undo.
       93   define   shared variable g#esys as logical no-undo.
       94   define   shared variable g#news-source-db as integer no-undo.
       95   define   shared variable g#esys-source-esys as integer no-undo.
       96   define   shared variable g#db-num as integer   no-undo .
       97   define   shared variable g#userid as character no-undo .
       98   define   shared variable g#passwd as character no-undo .
       99   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      100   define  variable garbcoll_ii as integer no-undo .
      101   define  temp-table temp-gc no-undo
      102   field ii as integer
      103   field obj-r as handle
      104   field cn as character
      105   index pi is unique primary
      106   ii
      107   index icn
      108   cn.
      109   procedure garbcoll_create-gc-entry :
      110   define input parameter p-cn as character no-undo .
      111   define input parameter p-obj-r as handle no-undo .
      112     do
      113     on error undo, return error
      114     :
      115       create temp-gc.
      116       assign
      117       temp-gc.ii = garbcoll_ii
      118       garbcoll_ii = garbcoll_ii + 1
      119       temp-gc.cn = p-cn
      120       temp-gc.obj-r = p-obj-r
      121       .
      122     end.
      123   end procedure.
      124   procedure garbcoll_clear :
      125     do
      126     on error undo, return error
      127     :
      128       for each temp-gc:
      129         delete object temp-gc.obj-r.
      130         delete temp-gc.
      131       end.
      132     end.
      133   end procedure.
      134   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      135   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      136   procedure cur-time :
      137      define output parameter p-today as date      no-undo .
      138      define output parameter p-time  as integer   no-undo .
      139     do
      140     on error undo, return error
      141     :
      142       define variable v-date1 as date      no-undo .
      143       define variable v-date2 as date      no-undo .
      144       define variable v-time  as integer   no-undo .
      145       assign
      146         v-date1 = today
      147         v-time  = time
      148         v-date2 = today
      149       .
      150       if v-date1 <> v-date2
      151       then do:
      152         assign
      153           v-date1 = today
      154           v-time  = v-time
      155         .
      156       end.
      157       assign
      158         p-today = v-date1
      159         p-time  = v-time
      160       .
      161     end.
      162   end.
      163   function cur-time-date returns character
      164   :
      165     return string(today, '99/99/9999':U) .
      166   end.
      167   function cur-time-mjd returns decimal
      168   :
      169     define variable v-date as date      no-undo .
      170     define variable v-time as integer   no-undo .
      171     run cur-time in this-procedure
      172       (output v-date
      173       ,output v-time
      174       ) .
      175     return integer(v-date) - 2400002 + (v-time / 86400) .
      176   end.
      177   function cur-time-get-ending-index returns integer
      178   (input p-number as integer
      179   )
      180   :
      181     if p-number < 0
      182     or p-number = ?
      183     then do:
      184       return 1 .
      185     end.
      186     define variable v-rest as integer   no-undo .
      187     assign
      188       p-number = p-number modulo 100
      189     .
      190     if p-number < 20
      191     then do:
      192       assign
      193         v-rest = p-number
      194       .
      195     end.
      196     else do:
      197       assign
      198         v-rest = p-number modulo 10
      199       .
      200     end.
      201     case v-rest :
      202       when 1
      203       then do:
      204         return 2 .
      205       end.
      206       when 2 or
      207       when 3 or
      208       when 4
      209       then do:
      210         return 3 .
      211       end.
      212       otherwise do:
      213         return 1 .
      214       end.
      215     end case .
      216   end.
      217   procedure cur-time-mjd-to-date :
      218      define input  parameter i-mjd-diff as decimal no-undo.
      219      define output parameter o-Date     as date    no-undo.
      220      define output parameter o-Time     as integer no-undo.
      221      define variable v-day-number as integer   no-undo .
      222      if    i-mjd-diff < 0
      223         or i-mjd-diff = ?
      224      then do:
      225         return "?" .
      226      end.
      227      assign
      228         v-day-number = truncate(i-mjd-diff,0).
      229         o-Date = date(v-day-number + 2400002).
      230         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      231     .
      232   end.
      233   function cur-time-mjd-to-string returns character
      234   (input p-mjd-diff as decimal
      235   )
      236   :
      237     define variable v-day-number as integer   no-undo .
      238     define variable v-seconds    as integer   no-undo .
      239     define variable v-hour       as integer   no-undo .
      240     define variable v-min        as integer   no-undo .
      241     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      242     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      243     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      244     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      245     if p-mjd-diff < 0
      246     or p-mjd-diff = ?
      247     then do:
      248       return "?" .
      249     end.
      250     assign
      251       v-day-number = integer(truncate(p-mjd-diff,0))
      252       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      253     .
      254     if v-seconds > 86400
      255     then do:
      256       assign
      257         v-seconds = 86400 - 1
      258       .
      259     end.
      260     if v-seconds < 0
      261     then do:
      262       assign
      263         v-seconds = 0
      264       .
      265     end.
      266     assign
      267       v-hour = truncate(v-seconds / 3600, 0)
      268     .
      269     assign
      270       v-seconds = v-seconds modulo 3600
      271     .
      272     assign
      273       v-min = truncate(v-seconds / 60, 0)
      274     .
      275     assign
      276       v-seconds = v-seconds modulo 60
      277     .
      278     return
      279         (if v-day-number <> 0
      280           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      281           else ""
      282         )
      283       + (if v-day-number <> 0 or v-hour <> 0
      284           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      285           else ""
      286         )
      287       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      288           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      289           else ""
      290         )
      291       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      292       .
      293   end.
      294   function cur-time-string returns character
      295   :
      296     define variable v-date as date      no-undo .
      297     define variable v-time as integer   no-undo .
      298     run cur-time in this-procedure
      299       (output v-date
      300       ,output v-time
      301       ) .
      302     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      303   end.
      304   function cur-time-string-sec returns character
      305   :
      306     define variable v-date as date      no-undo .
      307     define variable v-time as integer   no-undo .
      308     run cur-time in this-procedure
      309       (output v-date
      310       ,output v-time
      311       ) .
      312     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      313   end.
      314   function cur-time-custom  returns character
      315   (input p-prefix as character
      316   ,input p-date-format as character
      317   ,input p-delimiter as character
      318   ,input p-time-format as character
      319   ,input p-suffix as character
      320   )
      321   :
      322     define variable v-date as date      no-undo .
      323     define variable v-time as integer   no-undo .
      324     run cur-time in this-procedure
      325       (output v-date
      326       ,output v-time
      327       ) .
      328     return
      329       p-prefix
      330       + string(v-date, p-date-format)
      331       + p-delimiter
      332       + string(v-time, p-time-format)
      333       + p-suffix
      334       .
      335   end.
      336   function cur-time-print  returns character
      337   :
      338     define variable v-date as date      no-undo .
      339     define variable v-time as integer   no-undo .
      340     run cur-time in this-procedure
      341       (output v-date
      342       ,output v-time
      343       ) .
      344     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      345   end.
      346   function cur-time-datetime returns datetime
      347   :
      348     define variable v-char as character no-undo .
      349     define variable v-datetime as datetime no-undo .
      350     v-char = cur-time-string().
      351     v-datetime = datetime(v-char).
      352     return  v-datetime.
      353   end.
      354   function cur-time-string-msec returns character
      355   :
      356     define variable v-date as datetime  no-undo .
      357     v-date = now.
      358     return string(v-date) .
      359   end.
      360   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      361   define new global shared variable g#lib-nws as handle no-undo .
      362   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      363   def var vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      364   procedure gen-key-rec :
      365     define input  parameter p-tbl-name    as character no-undo.
      366     define input  parameter p-bh_tbl-name as handle    no-undo.
      367     define output parameter p-key-rec     as character no-undo.
      368     do
      369     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      370     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      371     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      372     :
      373       define variable fh               as handle    no-undo .
      374       define variable v-ok             as logical   no-undo .
      375       define variable v-inform         as character no-undo .
      376       define variable v-ind            as integer   no-undo .
      377       define variable v-idx-field-qnty as integer   no-undo .
      378       if p-tbl-name = ?
      379         or p-tbl-name = "":U
      380       then do:
      381         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info5 ).
      382       end.
      383       if not p-bh_tbl-name:available then do:
      384         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info5, p-tbl-name ).
      385       end.
      386       assign
      387         p-key-rec = p-tbl-name
      388         v-inform  = p-bh_tbl-name:index-information(1)
      389         v-ind     = 2
      390       .
      391       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      392       on error undo, return error
      393       :
      394         assign
      395           v-inform = p-bh_tbl-name:index-information( v-ind )
      396           v-ind    = v-ind + 1
      397         .
      398       end.
      399       if v-inform = ?
      400         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      401         or entry( 3, v-inform, ",":U ) <> "1":U
      402       then do:
      403         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, p-tbl-name ).
      404       end.
      405       else do:
      406         assign
      407           v-idx-field-qnty = num-entries( v-inform ) - 4
      408         .
      409         if v-idx-field-qnty < 2 then do:
      410           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, p-tbl-name ).
      411         end.
      412         do v-ind = 1 to v-idx-field-qnty by 2
      413         on error undo, return error
      414         :
      415           assign
      416             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      417             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      418           .
      419         end.
      420       end.
      421       if p-key-rec = ? then do:
      422         assign
      423           p-key-rec = "":U
      424         .
      425         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info5, p-tbl-name ).
      426       end.
      427     end.
      428     return.
      429   end procedure.
      430   procedure gen-where-keyr-tab :
      431     define input  parameter i-tableSerach as character no-undo.
      432     define input  parameter i-tablekey   as character  no-undo.
      433     define input  parameter p-key-rec    as character  no-undo.
      434     define input  parameter p-key-handle as handle     no-undo .
      435     define input  parameter p-db-name    as character  no-undo .
      436     define input  parameter p-tt-handle  as handle     no-undo .
      437     define output parameter o-Where      as character  no-undo.
      438     do
      439     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      440     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      441     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      442     :
      443       define variable v-full-tbl-name  as character no-undo .
      444       define variable bh_tbl-name      as handle    no-undo .
      445       define variable fh_key           as handle    no-undo .
      446       define variable fh_search        as handle    no-undo .
      447       define variable v-field-num      as integer   no-undo .
      448       define variable v-count-fld      as integer   no-undo .
      449       define variable v-inform         as character no-undo .
      450       define variable v-ind            as integer   no-undo .
      451       define variable v-idx-field-qnty as integer   no-undo .
      452       define variable v-field-name     as character no-undo .
      453       define variable v-field-val      as character no-undo .
      454       define variable v-word-link      as character no-undo .
      455       define variable vTable           as character no-undo.
      456       define variable bh_tbl-key       as handle    no-undo .
      457       assign
      458         p-key-rec = trim( p-key-rec )
      459       .
      460       if p-key-handle <> ? then do:
      461         if not valid-handle(p-key-handle)
      462            or p-key-handle:type <> "buffer"
      463         then do:
      464           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info5 ).
      465         end.
      466         if num-entries( p-key-rec, chr(3) ) > 1
      467           or p-key-rec = ?
      468           or p-key-rec = "":U
      469         then do:
      470           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info5, p-key-rec ).
      471         end.
      472       end.
      473       else do:
      474         if p-key-rec = ?
      475           or p-key-rec = "":U
      476         then do:
      477           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info5 ).
      478         end.
      479       end.
      480       assign
      481         vTable = entry( 1 , p-key-rec, chr(3) )
      482       .
      483       if p-tt-handle <> ?
      484         and ( not valid-handle(p-tt-handle)
      485               or p-tt-handle:type <> "buffer"
      486             )
      487       then do:
      488         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info5, vTable, chr(10) ).
      489       end.
      490       if p-tt-handle = ? then do:
      491         assign
      492           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      493         .
      494         create buffer bh_tbl-name for table v-full-tbl-name .
      495       end.
      496       else do:
      497         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      498       end.
      499       assign
      500         v-inform = bh_tbl-name:index-information(1)
      501         v-ind    = 2
      502       .
      503       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      504       on error undo, return error
      505       :
      506         assign
      507           v-inform = bh_tbl-name:index-information( v-ind )
      508           v-ind    = v-ind + 1
      509         .
      510       end.
      511       if v-inform = ?
      512         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      513         or entry( 3, v-inform, ",":U ) <> "1":U
      514       then do:
      515         delete object bh_tbl-name no-error.
      516         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info5, vTable ).
      517       end.
      518       assign
      519         v-idx-field-qnty = num-entries( v-inform ) - 4
      520       .
      521       if v-idx-field-qnty < 2 then do:
      522         delete object bh_tbl-name no-error.
      523         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, vTable ).
      524       end.
      525       assign
      526         o-where     = "where":U
      527         v-word-link = "":U
      528         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      529         v-count-fld = 0
      530       .
      531       if i-tablekey ne "" and i-tablekey ne ?
      532       then do:
      533         assign
      534           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      535         .
      536         create buffer bh_tbl-key for table v-full-tbl-name .
      537       end.
      538       if i-tableSerach ne "" and i-tableSerach ne ?
      539       then do:
      540         delete object bh_tbl-name no-error.
      541         assign
      542           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      543         .
      544         create buffer bh_tbl-name for table v-full-tbl-name .
      545       end.
      546       block_where:
      547       do v-ind = 1 to v-idx-field-qnty by 2
      548       on error undo, return error
      549       :
      550         assign
      551           v-count-fld = v-count-fld + 1
      552         .
      553         if p-key-handle = ?
      554           and v-count-fld > v-field-num
      555         then do:
      556           leave block_where.
      557         end.
      558         define variable VfieldKeyTable as handle no-undo.
      559         assign
      560           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      561           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      562         .
      563         if     bh_tbl-key ne ?
      564         then do:
      565            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      566            if VfieldKeyTable eq ?
      567            then next block_where.
      568         end.
      569         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      570         then
      571            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      572         else
      573            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      574         if p-key-handle = ? then do:
      575           assign
      576             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      577           .
      578         end.
      579         else do:
      580           assign
      581             fh_key = p-key-handle:buffer-field( v-field-name )
      582           .
      583           if fh_key = ?
      584             or not valid-handle( fh_key )
      585           then do:
      586             delete object bh_tbl-name.
      587             if     bh_tbl-key ne ?
      588             then
      589                delete object bh_tbl-key.
      590             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info5, p-key-handle:name, v-field-name ).
      591           end.
      592           assign
      593             v-field-val = fh_key:buffer-value
      594           .
      595         end.
      596         if fh_search:data-type ="character":U then do:
      597           assign
      598             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      599             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      600             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      601             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      602             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      603             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      604             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      605             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      606             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      607             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      608             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      609             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      610             v-field-val = substitute( '"&1"', v-field-val )
      611           .
      612         end.
      613         assign
      614           o-where = substitute( "&1 &2", o-where, v-field-val )
      615         .
      616         if v-word-link = "":U then do:
      617           assign
      618             v-word-link = "and":U
      619           .
      620         end.
      621       end.
      622       delete object bh_tbl-name.
      623       if     bh_tbl-key ne ?
      624       then
      625          delete object bh_tbl-key.
      626       if p-key-handle = ?
      627         and v-count-fld <> v-field-num
      628       then do:
      629         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info5, vTable ).
      630       end.
      631     end.
      632   end procedure.
      633   procedure gen-hn-keyr-tab :
      634     define input  parameter i-tableSerach as character no-undo.
      635     define input  parameter i-tablekey   as character no-undo.
      636     define input  parameter p-key-rec    as character no-undo.
      637     define input  parameter p-key-handle as handle    no-undo .
      638     define input  parameter p-db-name    as character no-undo .
      639     define input  parameter p-tt-handle  as handle    no-undo .
      640     define input  parameter p-stts-lock  as integer   no-undo .
      641     define output parameter o-hn         as handle    no-undo.
      642     define variable v-full-tbl-name as character no-undo.
      643     define variable v-where         as character no-undo.
      644     define variable bh_tbl-name     as handle    no-undo.
      645     define variable vTable          as character no-undo.
      646     do
      647     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      648     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      649     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      650         run gen-where-keyr-tab(i-tableSerach,
      651                                i-tablekey,
      652                                p-key-rec,
      653                                p-key-handle,
      654                                p-db-name,
      655                                p-tt-handle,
      656                                output v-where).
      657         if i-tableSerach ne "" and i-tableSerach ne ?
      658         then do:
      659            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      660            create buffer bh_tbl-name for table v-full-tbl-name .
      661         end.
      662         else do:
      663            if p-tt-handle = ? then do:
      664               assign
      665                  vTable = entry( 1 , p-key-rec, chr(3) )
      666               .
      667               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      668               create buffer bh_tbl-name for table v-full-tbl-name .
      669            end.
      670            else do:
      671               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      672            end.
      673         end.
      674         if p-tt-handle = ? then do:
      675            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      676         end.
      677         else do:
      678            bh_tbl-name:find-first( v-where ) no-error .
      679         end.
      680         o-hn = bh_tbl-name.
      681      end.
      682   end procedure.
      683   procedure gen-hn-keyr :
      684     define input  parameter p-key-rec    as character no-undo.
      685     define input  parameter p-key-handle as handle    no-undo .
      686     define input  parameter p-db-name    as character no-undo .
      687     define input  parameter p-tt-handle  as handle    no-undo .
      688     define input  parameter p-stts-lock  as integer   no-undo .
      689     define output parameter o-hn         as handle    no-undo.
      690     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      691   end.
      692   procedure gen-row-keyr :
      693     define input  parameter p-key-rec    as character no-undo.
      694     define input  parameter p-key-handle as handle    no-undo .
      695     define input  parameter p-db-name    as character no-undo .
      696     define input  parameter p-tt-handle  as handle    no-undo .
      697     define input  parameter p-stts-lock  as integer   no-undo .
      698     define output parameter p-tbl-row    as rowid     no-undo.
      699     define output parameter p-tbl-name   as character no-undo.
      700     define variable vHn as handle no-undo.
      701       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      702       p-tbl-row = if vHn:available then vHn:rowid else ?.
      703       p-tbl-name =  vHn:table.
      704       delete object vHn no-error.
      705     if p-tbl-row = ? then do:
      706       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info5, p-tbl-name, p-key-rec ).
      707     end.
      708     else do:
      709       return.
      710     end.
      711   end procedure.
      712   procedure gen-key-fv :
      713     define input  parameter p-key-rec    as character no-undo .
      714     define output parameter p-field-list as character no-undo .
      715     define output parameter p-value-list as character no-undo.
      716     do
      717     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      718     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      719     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      720     :
      721       define variable v-full-tbl-name  as character no-undo .
      722       define variable bh_tbl-name      as handle    no-undo .
      723       define variable v-tbl-name       as character no-undo .
      724       define variable v-field-num      as integer   no-undo .
      725       define variable v-count-fld      as integer   no-undo .
      726       define variable v-inform         as character no-undo .
      727       define variable v-ind            as integer   no-undo .
      728       define variable v-idx-field-qnty as integer   no-undo .
      729       define variable v-delim-key      as character no-undo .
      730       if p-key-rec = ?
      731         or p-key-rec = "":U
      732       then do:
      733         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info5 ).
      734       end.
      735       assign
      736         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      737         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      738       .
      739       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      740       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info5 ).
      741       assign
      742         v-inform = bh_tbl-name:index-information(1)
      743         v-ind    = 2
      744       .
      745       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      746       on error undo, return error
      747       :
      748         assign
      749           v-inform = bh_tbl-name:index-information( v-ind )
      750           v-ind    = v-ind + 1
      751         .
      752       end.
      753       if v-inform = ?
      754         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      755         or entry( 3, v-inform, ",":U ) <> "1":U
      756       then do:
      757         delete object bh_tbl-name no-error.
      758         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, v-tbl-name ).
      759       end.
      760       assign
      761         v-idx-field-qnty = num-entries( v-inform ) - 4
      762       .
      763       if v-idx-field-qnty < 2 then do:
      764         delete object bh_tbl-name no-error.
      765         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, v-tbl-name ).
      766       end.
      767       assign
      768         p-field-list = "":U
      769         p-value-list = "":U
      770         v-delim-key  = "":U
      771         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      772         v-count-fld  = 0
      773       .
      774       block_where:
      775       do v-ind = 1 to v-idx-field-qnty by 2
      776       on error undo, return error
      777       :
      778         assign
      779           v-count-fld = v-count-fld + 1
      780         .
      781         if v-count-fld > v-field-num then do:
      782           leave block_where.
      783         end.
      784         assign
      785           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      786           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      787         .
      788         if v-ind = 1 then do:
      789           assign
      790             v-delim-key = chr(3)
      791           .
      792         end.
      793       end.
      794       delete object bh_tbl-name.
      795       if v-count-fld <> v-field-num then do:
      796         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info5, v-tbl-name ).
      797       end.
      798     end.
      799   end procedure.
      800   procedure gen-key-field :
      801     define input  parameter p-table      as character no-undo .
      802     define output parameter p-field-list as character no-undo .
      803     do
      804     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      805     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      806     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      807     :
      808       define variable v-full-tbl-name  as character no-undo .
      809       define variable bh_tbl-name      as handle    no-undo .
      810       define variable v-tbl-name       as character no-undo .
      811       define variable v-field-num      as integer   no-undo .
      812       define variable v-count-fld      as integer   no-undo .
      813       define variable v-inform         as character no-undo .
      814       define variable v-ind            as integer   no-undo .
      815       define variable v-idx-field-qnty as integer   no-undo .
      816       define variable v-delim-key      as character no-undo .
      817       if p-table = ?
      818         or p-table = "":U
      819       then do:
      820         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info5 ).
      821       end.
      822       assign
      823         v-tbl-name      = p-table
      824         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      825       .
      826       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      827       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info5 ).
      828       assign
      829         v-inform = bh_tbl-name:index-information(1)
      830         v-ind    = 2
      831       .
      832       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      833       on error undo, return error
      834       :
      835         assign
      836           v-inform = bh_tbl-name:index-information( v-ind )
      837           v-ind    = v-ind + 1
      838         .
      839       end.
      840       if v-inform = ?
      841         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      842         or entry( 3, v-inform, ",":U ) <> "1":U
      843       then do:
      844         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, v-tbl-name ).
      845       end.
      846       assign
      847         v-idx-field-qnty = num-entries( v-inform ) - 4
      848       .
      849       if v-idx-field-qnty < 2 then do:
      850         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, v-tbl-name ).
      851       end.
      852       assign
      853         p-field-list = "":U
      854         v-delim-key  = "":U
      855         v-count-fld  = 0
      856       .
      857       block_where:
      858       do v-ind = 1 to v-idx-field-qnty by 2
      859       on error undo, return error
      860       :
      861         assign
      862           v-count-fld = v-count-fld + 1
      863         .
      864         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      865         if v-ind = 1 then do:
      866           assign
      867             v-delim-key = chr(3)
      868           .
      869         end.
      870       end.
      871       delete object bh_tbl-name.
      872     end.
      873   end procedure.
      874   define SHARED temp-table temp-cmd no-undo
      875   field cmd-code as integer
      876   field db-list as character
      877   index pi is unique primary
      878   db-list
      879   index icmd
      880   cmd-code
      881   .
      882   define SHARED temp-table temp-smart-route no-undo
      883   field key-field as character
      884   field db-num as integer
      885   index pi is unique primary
      886   key-field
      887   db-num
      888   .
      889   define SHARED temp-table temp-no-route no-undo
      890   field rec-ord as integer
      891   field db-num as integer
      892   index pi is unique primary
      893   db-num
      894   rec-ord
      895   index iro
      896   rec-ord
      897   .
      898   define SHARED temp-table temp-smart-link no-undo
      899   field uniq-key-rec as character
      900   field key-field as character
      901   field rec-ord as integer
      902   field is-smart as logical
      903   index pi is unique primary
      904   key-field
      905   uniq-key-rec
      906   rec-ord
      907   index iu
      908   uniq-key-rec
      909   index iro
      910   rec-ord
      911   .
      912   define SHARED temp-table temp-nws-outline no-undo
      913   like ub.nws-outline.
      914   procedure create-smart-route :
      915   define input parameter p-key-field as character no-undo .
      916   define input parameter p-db-num as integer no-undo .
      917   define buffer buf_temp-smart-route for temp-smart-route.
      918     do
      919     on error undo, return error
      920     :
      921       find first buf_temp-smart-route where
      922                 buf_temp-smart-route.key-field = p-key-field
      923             and buf_temp-smart-route.db-num = p-db-num no-error.
      924       if not available buf_temp-smart-route then do:
      925         create buf_temp-smart-route.
      926         assign
      927         buf_temp-smart-route.key-field = p-key-field
      928         buf_temp-smart-route.db-num = p-db-num
      929         .
      930       end.
      931     end.
      932   end procedure.
      933   procedure create-smart-route-link :
      934   define input parameter p-tbl-name as character no-undo .
      935   define input parameter p-bh_tbl-name as handle no-undo .
      936   define input parameter p-key-field as character no-undo .
      937   define input parameter p-rec-ord as integer no-undo .
      938   define input parameter p-is-smart as logical no-undo .
      939   define variable v-key-rec as character no-undo .
      940   define buffer buf_temp-smart-link for temp-smart-link.
      941     do
      942     on error undo, return error
      943     :
      944       run gen-key-rec in this-procedure ( input p-tbl-name
      945                                          ,input p-bh_tbl-name
      946                                          ,output v-key-rec     ).
      947      find first buf_temp-smart-link where
      948                 buf_temp-smart-link.uniq-key-rec = v-key-rec
      949              and buf_temp-smart-link.key-field = p-key-field
      950              and buf_temp-smart-link.rec-ord = p-rec-ord
      951              no-error .
      952      if not available buf_temp-smart-link then do:
      953        create buf_temp-smart-link.
      954        assign
      955        buf_temp-smart-link.uniq-key-rec = v-key-rec
      956        buf_temp-smart-link.key-field = p-key-field
      957        buf_temp-smart-link.rec-ord = p-rec-ord
      958        buf_temp-smart-link.is-smart = p-is-smart
      959        .
      960      end.
      961     end.
      962   end procedure.
      963   procedure create-nws-outline :
      964   define input parameter p-cmd-proc-handle as handle no-undo .
      965   define input parameter p-cmd-code as integer no-undo .
      966   define input parameter p-outline-type as character no-undo .
      967   define input parameter p-charkey_one as character no-undo .
      968   define input parameter p-charkey_two as character no-undo .
      969   define input parameter p-charkey_three as character no-undo .
      970   define input parameter p-key#_one as integer no-undo .
      971   define input parameter p-key#_two as integer no-undo .
      972   define input parameter p-key#_three as integer no-undo .
      973   define variable v-no-id as integer no-undo .
      974   define variable v-rec-ord as integer no-undo .
      975     do
      976     on error undo, return error return-value
      977     :
      978       find last temp-nws-outline use-index pi no-error .
      979       v-no-id = (if available temp-nws-outline
      980                  then (temp-nws-outline.no-id  + 1)
      981                  else 1).
      982       create temp-nws-outline.
      983       assign
      984       temp-nws-outline.charkeY_one = p-charkey_one
      985       temp-nws-outline.charkeY_two = p-charkey_two
      986       temp-nws-outline.charkeY_three = p-charkey_three
      987       temp-nws-outline.key#_one = p-key#_one
      988       temp-nws-outline.key#_two = p-key#_two
      989       temp-nws-outline.key#_three = p-key#_three
      990       temp-nws-outline.no-id = v-no-id
      991       temp-nws-outline.outline-type = p-outline-type
      992       .
      993                                   run add-dump in p-cmd-proc-handle                                                                           (input p-cmd-code                                                                                         ,input 'nws-outline':U                                                                                          ,input '+update'                                                                                         ,input (buffer temp-nws-outline:handle)                                                                                    ,input ''                                                                                         ,output v-rec-ord                                                                                         ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                     delete procedure p-cmd-proc-handle .                                                                        undo , return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'nws-outline':U                                                                                                ,p-cmd-code                                                                                               ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
      994       run  create-smart-route in this-procedure (
      995                                                   input ('nws-outline':U + chr(4) + string(temp-nws-outline.no-id))
      996                                                  ,input -1).
      997       run create-smart-route-link in this-procedure (
      998                                                      input 'nws-outline':U
      999                                                     ,input (buffer temp-nws-outline:handle)
     1000                                                     ,input ('nws-outline':U + chr(4) + string(temp-nws-outline.no-id))
     1001                                                     ,input v-rec-ord
     1002                                                     ,input no
     1003                                                     ).
     1004     end.
     1005   end procedure.
     1006   procedure create-no-route :
     1007   define input parameter p-rec-ord as integer no-undo .
     1008   define input parameter p-db-num as integer no-undo .
     1009   define buffer buf_temp-no-route for temp-no-route.
     1010   do
     1011   on error undo, return error
     1012   :
     1013      find first buf_temp-no-route where
     1014                 buf_temp-no-route.rec-ord = p-rec-ord
     1015              and buf_temp-no-route.db-num = p-db-num no-error .
     1016      if not available buf_temp-no-route then do:
     1017        create buf_temp-no-route.
     1018        assign
     1019        buf_temp-no-route.rec-ord = p-rec-ord
     1020        buf_temp-no-route.db-num = p-db-num
     1021        .
     1022      end.
     1023   end.
     1024   end procedure.
     1025   procedure clear-from-rec-ord :
     1026   define input parameter p-rec-ord as integer no-undo .
     1027   define buffer buf_temp-no-route for temp-no-route.
     1028   define buffer buf_temp-smart-link for temp-smart-link.
     1029   do
     1030   on error undo, return error
     1031   :
     1032   for each buf_temp-no-route where
     1033           buf_temp-no-route.rec-ord > p-rec-ord:
     1034     delete buf_temp-no-route.
     1035   end.
     1036   for each buf_temp-smart-link where
     1037           buf_temp-smart-link.rec-ord > p-rec-ord:
     1038      delete buf_temp-smart-link.
     1039   end.
     1040   end.
     1041   end procedure.
     1042   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1043   define shared temp-table temp-hist-nws-option no-undo
     1044   like ub.hist-nws-option
     1045   .
