     1078   uniq-gate-rec
     1079   tbl-name
     1080   index iorder
     1081   order
     1082   index gr
     1083   uniq-gate-rec
     1084   index gh
     1085   gate-handle_
     1086   index iparent
     1087   is-parent
     1088   .
     1089   define shared temp-table temp-xml-records no-undo
     1090   field tbl-name as character
     1091   field uniq-key-rec as character
     1092   index pi is unique primary
     1093   tbl-name
     1094   uniq-key-rec
     1095   .
     1096   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1097   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1098   def var vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1099   procedure get-gate-file-name :
     1100   define input parameter p-gate-rec as character no-undo .
     1101   define output  parameter p-gate-file-name as character no-undo .
     1102   define buffer buf_clob-data for ub.clob-data.
     1103   define variable v-tbl-row as rowid no-undo .
     1104   define variable v-tbl-name as character no-undo .
     1105   run gen-row-keyr in this-procedure ( input p-gate-rec
     1106                                       ,input ?
     1107                                       ,input "ub"
     1108                                       ,input ?
     1109                                       ,input no-lock
     1110                                       ,output v-tbl-row
     1111                                       ,output v-tbl-name) no-error.
     1112   if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     1113                                                           ,vss-include-info10
     1114                                                           ,p-gate-rec).
     1115   find first buf_clob-data no-lock where
     1116             rowid(buf_clob-data) = v-tbl-row no-error.
     1117   if not available buf_clob-data then do:
     1118     if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     1119                                                             ,vss-include-info10
     1120                                                             ,p-gate-rec).
     1121   end.
     1122   p-gate-file-name = buf_clob-data.file-name.
     1123   end procedure.
     1124   procedure get-gate-rec :
     1125   define input  parameter p-gate-name as character no-undo .
     1126   define output parameter p-gate-rec as character no-undo .
     1127   define buffer buf_clob-bind for ub.clob-bind.
     1128   define buffer buf_clob-data for ub.clob-data.
     1129   main-block:
     1130   do
     1131   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info10, return-value, chr(10), error-status :get-message (1))
     1132   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info10 )
     1133   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info10 )
     1134   :
     1135       find first buf_clob-bind no-lock where
     1136                 buf_clob-bind.uniq-key-rec = p-gate-name
     1137             and buf_clob-bind.field-name = '':U
     1138             and buf_clob-bind.part-num = 1
     1139             and buf_clob-bind.resource-type = 'gate':U
     1140             no-error.
     1141       if not available buf_clob-bind then do:
     1142         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     1143                                         , p-gate-name
     1144                                         ).
     1145       end.
     1146       find first buf_clob-data no-lock where
     1147                 buf_clob-data.db-num = buf_clob-bind.db-num
     1148             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     1149       if not available buf_clob-data then do:
     1150         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1151                                         , buf_clob-bind.db-num
     1152                                         , buf_clob-bind.int64-id
     1153                                         , p-gate-name
     1154                                         ).
     1155       end.
     1156       run gen-key-rec in this-procedure ( input 'clob-data':U
     1157                                 ,input buffer buf_clob-data:handle
     1158                                 ,output p-gate-rec).
     1159   end.
     1160   end procedure.
     1161   procedure get-gate-by-name :
     1162   define input  parameter p-gate-name as character no-undo .
     1163   define output parameter p-gate-rec as character no-undo .
     1164   define output parameter p-dsh as handle no-undo .
     1165   define input-output  parameter p-xmlh as handle no-undo .
     1166   define variable v-ii as integer   no-undo .
     1167   define variable glog as logical   no-undo .
     1168   define variable v-longchar as longchar no-undo .
     1169   define variable v-txmlh as handle no-undo .
     1170   define variable v-db-num as integer no-undo .
     1171   define variable v-int64-id as int64 no-undo .
     1172   define buffer buf_clob-bind for ub.clob-bind.
     1173   define buffer buf_clob-data for ub.clob-data.
     1174   main-block:
     1175   do
     1176   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info10, return-value, chr(10), error-status :get-message (1))
     1177   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info10 )
     1178   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info10 )
     1179   :
     1180       find first buf_clob-bind no-lock where
     1181                 buf_clob-bind.uniq-key-rec = p-gate-name
     1182             and buf_clob-bind.field-name = '':U
     1183             and buf_clob-bind.part-num = 1
     1184             and buf_clob-bind.resource-type = 'gate':U
     1185             no-error.
     1186       if not available buf_clob-bind then do:
     1187         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     1188                                         , p-gate-name
     1189                                         ).
     1190       end.
     1191       find first buf_clob-data no-lock where
     1192                 buf_clob-data.db-num = buf_clob-bind.db-num
     1193             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     1194       if not available buf_clob-data then do:
     1195         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1196                                         , buf_clob-bind.db-num
     1197                                         , buf_clob-bind.int64-id
     1198                                         , p-gate-name
     1199                                         ).
     1200       end.
     1201       assign
     1202       v-longchar = buf_clob-data.cdata
     1203       .
     1204       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1205       if error-status :error then do:
     1206         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1207       end.
     1208       create dataset p-dsh .
     1209       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1210                                     , v-longchar
     1211                                     , ?
     1212                                     , ?
     1213                                     , ?
     1214                                     ) no-error.
     1215       v-longchar = '':U.
     1216       if error-status :error
     1217       or not glog
     1218       then do:
     1219         undo, return error substitute("Не удалось прочитать XML-схему &1 из БД:&2&3", p-gate-name, chr(10), error-status:get-message(1) ).
     1220       end.
     1221       if not valid-handle(p-xmlh)
     1222       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1223         create temp-table v-txmlh.
     1224         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1225         v-txmlh:temp-table-prepare("temp-xml-tables").
     1226         p-xmlh = v-txmlh:default-buffer-handle.
     1227       end.
     1228       run gen-key-rec in this-procedure ( input 'clob-data':U
     1229                                 ,input buffer buf_clob-data:handle
     1230                                 ,output p-gate-rec).
     1231       do v-ii = 1 to p-dsh:num-buffers:
     1232         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1233         if not p-xmlh:available then do:
     1234           p-xmlh:buffer-create().
     1235           assign
     1236           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1237           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1238           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1239           p-xmlh::gate-handle_ = p-dsh
     1240           p-xmlh::uniq-gate-rec = p-gate-rec
     1241           p-xmlh::gate-name = p-dsh:name
     1242           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1243           .
     1244           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1245             assign
     1246             p-xmlh::order = -3.
     1247           end.
     1248         end.
     1249       end.
     1250   end.
     1251   end procedure.
     1252   procedure get-gate-by-rec :
     1253   define input  parameter p-gate-rec as character no-undo .
     1254   define output parameter p-dsh as handle no-undo .
     1255   define input-output  parameter p-xmlh as handle no-undo .
     1256   define input-output parameter p-longchar  as longchar no-undo .
     1257   define variable v-ii as integer   no-undo .
     1258   define variable glog as logical   no-undo .
     1259   define variable v-rowid as rowid no-undo .
     1260   define variable v-tbl-name as character no-undo .
     1261   define variable v-longchar as longchar no-undo .
     1262   define variable v-txmlh as handle no-undo .
     1263   define buffer buf_clob-data for ub.clob-data.
     1264   main-block:
     1265   do
     1266   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info10, return-value, chr(10), error-status :get-message (1))
     1267   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info10 )
     1268   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info10 )
     1269   :
     1270     run gen-row-keyr in this-procedure (
     1271                                           input  p-gate-rec
     1272                                           ,input  ?
     1273                                           ,input  "ub"
     1274                                           ,input  ?
     1275                                           ,input  NO-LOCK
     1276                                           ,output v-rowid
     1277                                           ,output v-tbl-name   ) no-error.
     1278       find first buf_clob-data no-lock where
     1279                 rowid(buf_clob-data) = v-rowid  no-error.
     1280       if not available buf_clob-data then do:
     1281         undo, return error substitute("Не найден CLOB  &1"
     1282                                         , p-gate-rec
     1283                                         ).
     1284       end.
     1285       assign
     1286       v-longchar = buf_clob-data.cdata
     1287       .
     1288       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1289       if error-status :error then do:
     1290         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1291       end.
     1292       create dataset p-dsh .
     1293       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1294                                     , v-longchar
     1295                                     , ?
     1296                                     , ?
     1297                                     , ?
     1298                                     ) no-error.
     1299       define variable v-esm as character no-undo .
     1300       v-esm = error-status:get-message(1) .
     1301       if p-longchar <> ? then do:
     1302         p-longchar = v-longchar.
     1303       end.
     1304       v-longchar = '':U.
     1305       if error-status :error
     1306       or not glog
     1307       then do:
     1308         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     1309                                      , p-gate-rec
     1310                                      , p-gate-rec
     1311                                      , v-esm
     1312                                      ).
     1313       end.
     1314       p-dsh:private-data = buf_clob-data.file-name_ + chr(4) + p-gate-rec.
     1315       if not valid-handle(p-xmlh)
     1316       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1317         create temp-table v-txmlh.
     1318         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1319         v-txmlh:temp-table-prepare("temp-xml-tables").
     1320         p-xmlh = v-txmlh:default-buffer-handle.
     1321       end.
     1322       do v-ii = 1 to p-dsh:num-buffers:
     1323         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1324         if not p-xmlh:available then do:
     1325           p-xmlh:buffer-create().
     1326           assign
     1327           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1328           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1329           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1330           p-xmlh::gate-handle_ = p-dsh
     1331           p-xmlh::uniq-gate-rec = p-gate-rec
     1332           p-xmlh::gate-name = p-dsh:name
     1333           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1334           .
     1335           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1336             assign
     1337             p-xmlh::order = -3.
     1338           end.
     1339           p-xmlh:buffer-release().
     1340         end.
     1341       end.
     1342   end.
     1343   end procedure.
     1344   procedure get-gate-by-file :
     1345   define input  parameter p-schema-file-name as character no-undo .
     1346   define input  parameter p-gate-rec as character no-undo .
     1347   define output parameter p-dsh as handle no-undo .
     1348   define input-output  parameter p-xmlh as handle no-undo .
     1349   define variable v-ii as integer   no-undo .
     1350   define variable glog as logical   no-undo .
     1351   define variable v-rowid as rowid no-undo .
     1352   define variable v-tbl-name as character no-undo .
     1353   define variable v-longchar as longchar no-undo .
     1354   define variable v-txmlh as handle no-undo .
     1355   main-block:
     1356   do
     1357   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info10, return-value, chr(10), error-status :get-message (1))
     1358   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info10 )
     1359   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info10 )
     1360   :
     1361       COPY-LOB
     1362       FROM  FILE p-schema-file-name
     1363       TO  OBJECT v-longchar
     1364       no-convert
     1365       NO-ERROR .
     1366       if error-status :error then do:
     1367           undo, return error substitute("Не удалось считать файл схемы &1 в память&2&3"
     1368                                     , p-schema-file-name
     1369                                 , chr(10)
     1370                                 , error-status:get-message(1) ).
     1371       end.
     1372       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1373       if error-status :error then do:
     1374         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, p-schema-file-name, chr(10), error-status:get-message(1) , return-value ).
     1375       end.
     1376       create dataset p-dsh .
     1377       glog = p-dsh:READ-XMLSCHEMA( "longchar"
     1378                                     , v-longchar
     1379                                     , ?
     1380                                     , ?
     1381                                     , ?
     1382                                     ) no-error.
     1383       v-longchar = ''.
     1384       if error-status :error
     1385       or not glog
     1386       then do:
     1387         undo, return error substitute("Не удалось прочитать XML-схему из файла &1&2&3"
     1388                                      , p-schema-file-name
     1389                                      ,chr(10)
     1390                                      , error-status:get-message(1)
     1391                                      ).
     1392       end.
     1393       if not valid-handle(p-xmlh)
     1394       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1395         create temp-table v-txmlh.
     1396         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1397         v-txmlh:temp-table-prepare("temp-xml-tables").
     1398         p-xmlh = v-txmlh:default-buffer-handle.
     1399       end.
     1400       do v-ii = 1 to p-dsh:num-buffers:
     1401         p-xmlh:find-first(substitute(' where tbl-name = "&1" and  uniq-gate-rec = "&2" '
     1402                                      ,p-dsh:get-buffer-handle(v-ii):name
     1403                                      ,p-gate-rec
     1404                                      )) no-error.
     1405         if not p-xmlh:available then do:
     1406           p-xmlh:buffer-create().
     1407           assign
     1408           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):table
     1409           p-xmlh::uniq-gate-rec = p-gate-rec
     1410           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1411           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1412           p-xmlh::gate-handle_ = p-dsh
     1413           p-xmlh::gate-name = p-dsh:name
     1414           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1415           .
     1416           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1417             assign
     1418             p-xmlh::order = -3.
     1419           end.
     1420           p-xmlh:buffer-release().
     1421         end.
     1422       end.
     1423   end.
     1424   end procedure.
     1425   procedure gate-clear :
     1426   define input  parameter p-dsh as handle no-undo .
     1427   define input  parameter p-xmlh as handle no-undo .
     1428   define variable v-dsh as handle no-undo .
     1429   define variable v-th as handle no-undo .
     1430     do
     1431     on error undo, return error return-value
     1432     :
     1433       if valid-handle(p-dsh) then do:
     1434         delete object p-dsh.
     1435         v-dsh = p-dsh.
     1436         p-dsh = ?.
     1437       end.
     1438       repeat while true:
     1439         p-xmlh:find-first( substitute( " where gate-handle_ = &1 ", v-dsh)
     1440                            , share-lock) no-error.
     1441         if p-xmlh:available then do:
     1442           assign
     1443           v-th = p-xmlh:buffer-field("table-handle_"):buffer-value.
     1444           if valid-handle(p-xmlh:buffer-field("table-handle_"))
     1445           and valid-handle(v-th)
     1446           and v-th:dynamic = yes
     1447           then do:
     1448             delete object p-xmlh:buffer-field("table-handle_"):buffer-value.
     1449             p-xmlh:buffer-field("table-handle_"):buffer-value = ?.
     1450           end.
     1451           p-xmlh:buffer-delete().
     1452         end.
     1453         else do:
     1454           leave.
     1455         end.
     1456       end.
     1457       if p-xmlh:dynamic = yes
     1458       and valid-handle(p-xmlh)
     1459       then do:
     1460         delete object p-xmlh:table-handle.
     1461         p-xmlh = ?.
     1462       end.
     1463       v-dsh = ?.
     1464     end.
     1465   end procedure.
     1466   procedure all-gates-clear :
     1467   define parameter buffer buf_temp-xml-tables for temp-xml-tables.
     1468   do
     1469   on error undo, return error
     1470   :
     1471     for each buf_temp-xml-tables
     1472     break
     1473     by buf_temp-xml-tables.uniq-gate-rec
     1474     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1475     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1476     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1477     :
     1478         if first-of(buf_temp-xml-tables.uniq-gate-rec) then do:
     1479           delete object buf_temp-xml-tables.gate-handle_.
     1480           buf_temp-xml-tables.gate-handle_ = ?.
     1481         end.
     1482         if valid-handle(buf_temp-xml-tables.table-handle_)
     1483         and buf_temp-xml-tables.table-handle_:dynamic = no
     1484         then do:
     1485           delete object buf_temp-xml-tables.table-handle_.
     1486           buf_temp-xml-tables.table-handle_ = ?.
     1487         end.
     1488         delete buf_temp-xml-tables.
     1489     end.
     1490   end.
     1491   end procedure.
     1492   procedure fix-schemalocation :
     1493   define input-output  parameter p-longchar as longchar no-undo .
     1494   DEFINE VARIABLE hdoc AS HANDLE.
     1495   DEFINE VARIABLE hroot AS HANDLE.
     1496   DEFINE VARIABLE hnode-child AS HANDLE.
     1497   DEFINE VARIABLE hnode-attr AS HANDLE.
     1498   define variable v-jj as integer   no-undo .
     1499   define variable ok as logical   no-undo .
     1500   define variable v-path1                    as character                no-undo .
     1501   DEFINE VARIABLE v-full-path1               as character                no-undo .
     1502   DEFINE VARIABLE v-file-name1               as character                no-undo .
     1503   DEFINE VARIABLE v-file-name-no-ext1        as character                no-undo .
     1504   DEFINE VARIABLE v-file-name-ext1           as character                no-undo .
     1505   define variable v-schema-location          as character                no-undo .
     1506   do
     1507   on error undo, return error return-value
     1508   :
     1509     CREATE X-DOCUMENT hdoc.
     1510     CREATE X-noderef hroot.
     1511     CREATE X-noderef hnode-child.
     1512     CREATE X-noderef hnode-attr.
     1513     hdoc:load("longchar", p-longchar, no) no-error.
     1514     iF ERROR-STATUS:GET-MESSAGE(1) <> '' THEN message ERROR-STATUS:GET-MESSAGE(1) view-as alert-box .
     1515     hdoc:get-document-element(hroot).
     1516     _repeat:
     1517     REPEAT v-jj = 1 TO hroot:NUM-CHILDREN:
     1518       ok = hroot:GET-CHILD(hNode-Child, v-jj).
     1519       if not ok then next.
     1520       if hNode-Child:local-name = "include"
     1521       then do:
     1522         ok = hNode-Child:GET-ATTRIBUTE-NODE( hnode-attr, "schemaLocation" ).
     1523           v-schema-location = hnode-attr:node-value.
     1524           run gbl/filename.p (
     1525                           input "exe/" + hnode-attr:node-value
     1526                         ,output v-full-path1
     1527                         ,output v-path1
     1528                         ,output v-file-name1
     1529                         ,output v-file-name-no-ext1
     1530                         ,output v-file-name-ext1
     1531                         ) no-error .
     1532           if error-status :error then do:
     1533             delete object hnode-attr.
     1534             delete object hnode-child.
     1535             delete object hroot.
     1536             delete object hdoc.
     1537             undo, return error substitute("Не удалось определить расположение схемы &1", v-schema-location).
     1538           end.
     1539         ok = hNode-Child:sET-ATTRIBUTE(  "schemaLocation", v-full-path1 ).
     1540         leave  _repeat.
     1541       end.
     1542     END.
     1543     hdoc:save("longchar", p-longchar).
     1544     delete object hnode-attr.
     1545     delete object hnode-child.
     1546     delete object hroot.
     1547     delete object hdoc.
     1548   end.
     1549   end procedure.
     1550   procedure gate-clb_fill-xml-tables :
     1551   define input parameter p-dsh as handle no-undo .
     1552   define input-output parameter p-xmlh as handle no-undo .
     1553   define variable v-ii as integer no-undo .
     1554     do
     1555     on error undo, return error
     1556     :
     1557       do v-ii = 1 to p-dsh:num-buffers:
     1558         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1559         if not p-xmlh:available then do:
     1560           p-xmlh:buffer-create().
     1561           assign
     1562           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1563           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1564           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1565           p-xmlh::gate-handle_ = p-dsh
     1566           p-xmlh::uniq-gate-rec = entry(2, p-dsh:private-data, chr(4))
     1567           p-xmlh::gate-name = p-dsh:name
     1568           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1569           .
     1570           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1571             assign
     1572             p-xmlh::order = -3.
     1573           end.
     1574           p-xmlh:buffer-release().
     1575         end.
     1576       end.
     1577     end.
     1578   end procedure.
     1579   procedure all-gates-empty :
     1580   define buffer buf_temp-xml-tables for temp-xml-tables.
     1581   do
     1582   on error undo, return error
     1583   :
     1584     for each buf_temp-xml-tables
     1585     break
     1586     by buf_temp-xml-tables.uniq-gate-rec
     1587     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1588     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1589     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1590     :
     1591       if valid-handle(buf_temp-xml-tables.tbl-handle_) then do:
     1592         buf_temp-xml-tables.tbl-handle_:empty-temp-table().
     1593       end.
     1594     end.
     1595   end.
     1596   end procedure.
