     1868   define buffer buf_temp-cmd for temp-cmd.
     1869   define temp-table temp-rule-call-param no-undo like ub.rule-call-param.
     1870   define buffer buf_temp-rule-call-param for temp-rule-call-param.
     1871   define buffer buf_temp-xml-tables for temp-xml-tables.
     1872   define variable log-file-name                as character      no-undo init "process-edoc.txt".
     1873   define variable v-view-log                   as logical        no-undo .
     1874   define variable v-stop                       as logical        no-undo .
     1875   function 00180016_get-error-message returns character :
     1876   define variable v-ii as integer no-undo .
     1877   define variable v-mess as character no-undo .
     1878   DO v-ii = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1879       v-mess = substitute("&1&2ош &3"
     1880                           ,v-mess
     1881                           ,chr(10)
     1882                           ,ERROR-STATUS:GET-MESSAGE(v-ii)).
     1883   END.
     1884   end function.
     1885     define variable p-esys-id as integer no-undo .
     1886     define variable p-xsd-file as character no-undo.
     1887   on delete of this-procedure do:
     1888     run delete-procedure in this-procedure .
     1889   end.
     1890   run load-ruleset-context in this-procedure ( input p-ruleset-id) no-error .
     1891   if error-status:error then undo, return error ''.
     1892   define variable ImpData1 as class Route-data_ no-undo .
     1893   ImpData1 = new Route-data_( input parparentproc, input p-parent-handle, input p-log-handle, input this-procedure:handle, input v_dataseth, input v-xmlh) .
     1894   if not this-procedure:persistent then do:
     1895     run proc-main in this-procedure  no-error .
     1896     if error-status:error then do:
     1897         run delete-procedure in this-procedure .
     1898         undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     1899     end.
     1900     run delete-procedure in this-procedure .
     1901   end.
     1902   procedure proc-main :
     1903   define variable v-ii as integer   no-undo .
     1904   define variable v-current-b-code as integer no-undo .
     1905   define variable v_dsheader as handle no-undo .
     1906   define variable v_dsline as handle no-undo .
     1907   define variable v-field-map as character no-undo .
     1908   define variable v-thds as handle no-undo .
     1909   define variable v-bh as handle no-undo .
     1910   define buffer buf_ext-system for ub.ext-system.
     1911   _main:
     1912   do
     1913   on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1914   on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
     1915   on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
     1916   :
     1917   run write-log  in p-log-handle (
     1918                                    input 0
     1919                                  , "&DLine").
     1920     run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute(".............Импорт данных по Складским документам из ВС")).
     1921       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Импорт данных по складским документам из файла &1", file-name)).
     1922     _release:
     1923     do on error undo, retry:
     1924       if  retry then do:
     1925         v-retry-action = v-retry-action + 1.
     1926                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при импорте данных &1&2&1&3"                                                                   , chr(10)                                                                   , error-status:get-message(1)                                                                   , return-value)).
     1927         undo _main, return error ''.
     1928       end.
     1929       create data-source v_dsheader.
     1930       create data-source v_dsline.
     1931       for each buf_temp-xml-tables
     1932       on error  undo _main, retry _main
     1933       on stop   undo _main, retry _main
     1934       on endkey undo _main, retry _main
     1935       :
     1936         case buf_temp-xml-tables.tbl-name:
     1937           when "doc_header" then do:
     1938             v_dsheader:add-source-buffer( buf_temp-xml-tables.tbl-handle, "").
     1939           end.
     1940           when "doc_line" then do:
     1941             v_dsline:add-source-buffer( buf_temp-xml-tables.tbl-handle, "").
     1942           end.
     1943         end case.
     1944       end.
     1945       v-thds = dataset thdoc:handle.
     1946       v-field-map = "ID,doc-id" + chr(44) +
     1947                     "ExtNum,ext-num" + chr(44) +
     1948                     "AgentID,agent-id" + chr(44) +
     1949                     "FromStoreID,from-store-id" + chr(44) +
     1950                     "ToStoreID,to-store-id" + chr(44) +
     1951                     "StartDate,start-date" + chr(44) +
     1952                     "FinishDate,finish-date".
     1953       v-bh = v-thds:get-buffer-handle("temp_doc-header").
     1954       v-bh:attach-data-source(v_dsheader, v-field-map).
     1955       v-field-map = "DocID,doc-id" + chr(44) +
     1956                     "GoodsID,goods-id" + chr(44) +
     1957                     "StoreID,store-id".
     1958       v-bh = v-thds:get-buffer-handle("temp_doc-line").
     1959       v-bh:attach-data-source(v_dsline, v-field-map).
     1960       v-thds:handle:fill().
     1961       v-thds:get-buffer-handle("temp_doc-header"):detach-data-source().
     1962       v-thds:get-buffer-handle("temp_doc-line"):detach-data-source().
     1963       delete object v_dsheader.
     1964       delete object v_dsline.
     1965     end.
     1966     for each temp_doc-header
     1967     :
     1968       assign
     1969         num-rec = num-rec + 1
     1970       .
     1971     end.
     1972     run proc-save in this-procedure  no-error.
     1973     if error-status:error then do:
     1974       if return-value <> '' then do:
     1975               run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при сохранении данных по накладным из ВС:&1&2&1&3", chr(10), return-value , error-status :get-message(1)  )).
     1976       end.
     1977       run set-err-type in p-cont-handle
     1978         ( input v-err-type
     1979         ) no-error.
     1980       run delete-procedure in this-procedure .
     1981       undo _main, return error ''.
     1982     end.
     1983       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Прочитано записей: &1, из них удачно обработано: &2", num-rec, num-rec-ok2)).
     1984   end.
     1985   end procedure.
     1986   procedure load-ruleset-context :
     1987   define input parameter p-ruleset-id as integer no-undo .
     1988   define buffer buf_rule-call-param for ub.rule-call-param.
     1989   define variable v-itop as integer   no-undo .
     1990   define variable v-ichild as integer   no-undo .
     1991   define variable v-pck-num as integer no-undo .
     1992     do
     1993   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1994   on stop   undo, return error substitute( "&1. stop", vss-workfile )
     1995   on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     1996     :
     1997    find first buf_rule-call-param no-lock where
     1998   buf_rule-call-param.codex_id = p-codex-id
     1999   and buf_rule-call-param.ruleset_id = p-ruleset-id
     2000   and buf_rule-call-param.call_id = p-call-id
     2001   and buf_rule-call-param.order_id = p-order-id
     2002   and buf_rule-call-param.rule_id = p-rule-id
     2003   and buf_rule-call-param.param-name = "p-xsd-file"
     2004    no-error.
     2005   if available buf_rule-call-param then do:
     2006   assign p-xsd-file = buf_rule-call-param.param-value-character.
     2007   end.
     2008       case p-ruleset-id:
     2009         when 16 then do:
     2010           assign
     2011           v-sign = 1
     2012           v-current-host-code = p-host-code
     2013           v-current-obj-type = p-obj-type
     2014           v-current-obj-code = p-obj-code
     2015           v-current-doc-code = p-doc-code
     2016           v-current-db-num = g#db-num
     2017           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     2018           file-name  = entry(1, p-process-file-name, chr(4))
     2019           v_dataseth = handle(entry(2, p-process-file-name, chr(4)))
     2020           v-xmlh = buffer buf_temp-xml-tables:handle
     2021           v-esys-id = integer(p-doc-code)
     2022           v-pck-num = integer(entry(3, p-process-file-name, chr(4)))
     2023           log-file-name = entry(4, p-process-file-name, chr(4))
     2024           no-error
     2025          .
     2026           _top-buffers:
     2027           do v-itop = 1 to v_dataseth:num-top-buffers:
     2028             if v_dataseth:get-top-buffer(v-itop):table = "header_" then do:
     2029               next _top-buffers.
     2030             end.
     2031             assign
     2032             v-ds-read-order = v-ds-read-order +
     2033                               (if v-ds-read-order = '':U then '':U else chr(44)) +
     2034                               v_dataseth:get-top-buffer(v-itop):table
     2035                               .
     2036             do v-ichild = 1 to v_dataseth:get-top-buffer(v-itop):num-child-relations:
     2037               assign
     2038               v-ds-read-order = v-ds-read-order + chr(44) + v_dataseth:get-top-buffer(v-itop):get-child-relation(v-ichild):child-buffer:name.
     2039             end.
     2040           end.
     2041         end.
     2042         otherwise do:
     2043           undo, return error substitute("Неверный вызов &1 для набора правил &2", vss-workfile , p-ruleset-id).
     2044         end.
     2045       end case.
     2046     end.
     2047   end procedure.
     2048   procedure delete-procedure :
     2049     do
     2050     on error undo, return error
     2051     :
     2052         run garbcoll_clear in this-procedure .
     2053     end.
     2054   end procedure.
     2055   procedure proc-save :
     2056   define variable v-obj-uniq-key-rec as character no-undo .
     2057   define buffer buf_clients for ub.clients.
     2058   define buffer buf_ext-classif for ub.ext-classif.
     2059   define buffer buf_temp_doc-header for temp_doc-header.
     2060   define buffer buf_temp_doc-line for temp_doc-line.
     2061   main-block:
     2062   do
     2063   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2064   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     2065   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     2066   :
     2067     run rul/i2054.p ( input parparentproc
     2068                     , input this-procedure
     2069                     , input table temp_doc-header
     2070                     , input table temp_doc-line
     2071                     , output num-rec-ok2
     2072                     ) .
     2073   end.
     2074   end procedure.
     2075   procedure pcall-log-file :
     2076   define input  parameter p-message as character no-undo .
     2077     do
     2078     on error undo, return error return-value
     2079     :
     2080       run write-log-and-file in p-log-handle (
     2081             input 1
     2082           , input log-file-name
     2083           , input 1
     2084           , input p-message ) .
     2085     end.
     2086   end procedure.
