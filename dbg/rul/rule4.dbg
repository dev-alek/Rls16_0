        1   block-level on error undo, throw.
        2   define input parameter p-rule-id-1 as integer no-undo .
        3   define input parameter p-rule-id-2 as integer no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision$":U .
        5   define variable vss-author      as character no-undo init "$Author$":U .
        6   define variable vss-date        as character no-undo init "$Date$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        8   define variable vss-archive     as character no-undo init "$Archive$":U .
        9   define variable vss-description as character no-undo init "ѕеренос прив€зок с одного правила на другое".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define variable v-log as logical no-undo .
       69   define variable v-chr as character no-undo .
       70   define buffer src_rule for ub.rule.
       71   define buffer trg_rule for ub.rule.
       72   define buffer src_rule-by-set for ub.rule-by-set.
       73   define buffer trg_rule-by-set for ub.rule-by-set.
       74   define buffer src_ruledict for ub.ruledict.
       75   define buffer trg_ruledict for ub.ruledict.
       76   define buffer src_ruledict-param for ub.ruledict-param.
       77   define buffer trg_ruledict-param for ub.ruledict-param.
       78   define buffer src_rule-by-call for ub.rule-by-call.
       79   define buffer trg_rule-by-call for ub.rule-by-call.
       80   define buffer src_rule-by-profile for ub.rule-by-profile.
       81   define buffer trg_rule-by-profile for ub.rule-by-profile.
       82   define buffer src_rule-call-param for ub.rule-call-param.
       83   define buffer trg_rule-call-param for ub.rule-call-param.
       84   define buffer src_rp-rule-param for ub.rp-rule-param.
       85   define buffer trg_rp-rule-param for ub.rp-rule-param.
       86   main-block:
       87   do
       88   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
       89   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
       90   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
       91   :
       92     find first trg_rule exclusive-lock where
       93             trg_rule.rule_id = p-rule-id-1 no-error.
       94     find first src_rule exclusive-lock where
       95             src_rule.rule_id = p-rule-id-2 no-error.
       96     if src_rule.rule_id = trg_rule.rule_id then do:
       97       undo main-block, return error substitute( "Ќельз€ замен€ть правило самим собой: замен€емое правило &1, замен€ющее правило &2"
       98                                                , p-rule-id-1
       99                                                , p-rule-id-2).
      100     end.
      101     if not (src_rule.sts = integer('-1':U)
      102            or
      103            src_rule.sts = integer('0':U)) then do:
      104       undo main-block, return error substitute( "«амен€ющее правило &1 имеет статус &2"
      105                                                , p-rule-id-2
      106                                                , entry (lookup (string(src_rule.sts), '-1,-10,0,1,99,98':U), 'готов,нов,исп,удал,удаление,запр.удал':U)).
      107     end.
      108     if src_rule.codex_id  <> trg_rule.codex_id then do:
      109       undo main-block, return error substitute( "«амен€емое правило &1 принадлежит кодексу &2, замен€ющее правило &3 - кодексу &4"
      110                                                , trg_rule.rule_id
      111                                                , trg_rule.codex_id
      112                                                , src_rule.rule_id
      113                                                , src_rule.codex_id
      114                                                ).
      115     end.
      116     for each trg_rule-by-set no-lock where
      117             trg_rule-by-set.rule_id = trg_rule.rule_id
      118     on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)):
      119        find first src_rule-by-set no-lock where
      120                   src_rule-by-set.rule_id = src_rule.rule_id
      121               and src_rule-by-set.codex_id = trg_rule-by-set.codex_id
      122               and src_rule-by-set.ruleset_id = trg_rule-by-set.ruleset_id no-error.
      123       if not available src_rule-by-set then do:
      124         undo main-block, return error substitute( "” замен€ющего правила &1 отсутствует прив€зка к кодексу &2 набору правил &3, имеюща€с€ у замен€емого правила &4"
      125                                                 , src_rule.rule_id
      126                                                 , trg_rule-by-set.codex_id
      127                                                 , trg_rule-by-set.ruleset_id
      128                                                 , trg_rule.rule_id
      129                                                 ).
      130       end.
      131     end.
      132     find first trg_ruledict where
      133               trg_ruledict.entry-type = 'rule':U
      134           and trg_ruledict.uniq-key-rec = trg_rule.uniq-key-rec no-error.
      135     if not available trg_ruledict then do:
      136       undo main-block, return error substitute( "” замен€емого правила &1 отсутствует прив€зка к словарю правил"
      137                                               , trg_rule.rule_id
      138                                               ).
      139     end.
      140     find first src_ruledict where
      141               src_ruledict.entry-type = 'rule':U
      142           and src_ruledict.uniq-key-rec = src_rule.uniq-key-rec no-error.
      143     if not available src_ruledict then do:
      144       undo main-block, return error substitute( "” замен€еющего правила &1 отсутствует прив€зка к словарю правил"
      145                                               , src_rule.rule_id
      146                                               ).
      147     end.
      148     for each trg_ruledict-param no-lock where
      149             trg_ruledict-param.entry-id = trg_ruledict.entry-id
      150     on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)):
      151        find first src_ruledict-param no-lock where
      152                   src_ruledict-param.entry-id = src_ruledict.entry-id
      153               and src_ruledict-param.language = trg_ruledict-param.language
      154               and src_ruledict-param.param-num = trg_ruledict-param.param-num no-error.
      155       if not available src_rule-by-set then do:
      156         undo main-block, return error substitute( "” замен€ющего правила &1 отсутствует параметр &2 (&3), имеющийс€ у замен€емого правила &4"
      157                                                 , src_rule.rule_id
      158                                                 , trg_ruledict-param.param-num
      159                                                 , trg_ruledict-param.param-name
      160                                                 , trg_rule.rule_id
      161                                                 ).
      162       end.
      163       buffer-compare trg_ruledict-param
      164       except entry-id whole-send-news documentation param-label
      165       init-value-character init-value-date init-value-decimal init-value-integer init-value-logical
      166       to src_ruledict-param
      167       save result in v-chr.
      168       if v-chr <> '':U then do:
      169         undo main-block, return error substitute( "ѕараметр &2(&3) замен€ющего правила &1, отличаетс€ от аналогичного параметра замен€емого правила &4&5&6"
      170                                                 , src_rule.rule_id
      171                                                 , trg_ruledict-param.param-num
      172                                                 , trg_ruledict-param.param-name
      173                                                 , trg_rule.rule_id
      174                                                 , chr(10)
      175                                                 , v-chr
      176                                                 ).
      177       end.
      178     end.
      179     for each src_ruledict-param no-lock where
      180             src_ruledict-param.entry-id = src_ruledict.entry-id
      181     on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)):
      182        find first trg_ruledict-param no-lock where
      183                   trg_ruledict-param.entry-id = trg_ruledict.entry-id
      184               and trg_ruledict-param.language = src_ruledict-param.language
      185               and trg_ruledict-param.param-num = src_ruledict-param.param-num no-error.
      186       if not available src_rule-by-set then do:
      187         undo main-block, return error substitute( "” замен€ющего правила &1 присутствует параметр &2 (&3), отсутствующий у замен€емого правила &4"
      188                                                 , src_rule.rule_id
      189                                                 , trg_ruledict-param.param-num
      190                                                 , trg_ruledict-param.param-name
      191                                                 , trg_rule.rule_id
      192                                                 ).
      193       end.
      194     end.
      195     for each trg_rule-by-call where
      196             trg_rule-by-call.rule_id = trg_rule.rule_id
      197     on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)):
      198       for each trg_rule-call-param where
      199               trg_rule-call-param.rule_id = trg_rule.rule_id
      200           and trg_rule-call-param.codex_id = trg_rule-by-call.codex_id
      201           and trg_rule-call-param.ruleset_id = trg_rule-by-call.ruleset_id
      202           and trg_rule-call-param.call#_id = trg_rule-by-call.call#_id
      203           and trg_rule-call-param.order_id = trg_rule-by-call.order_id
      204       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)):
      205         assign
      206         trg_rule-call-param.rule_id = src_rule.rule_id.
      207       end.
      208       assign
      209       trg_rule-by-call.rule_id = src_rule.rule_id
      210       .
      211     end.
      212     for each trg_rule-by-profile where
      213             trg_rule-by-profile.rule_id = trg_rule.rule_id
      214     on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)):
      215       create
      216       src_rule-by-profile.
      217       buffer-copy trg_rule-by-profile
      218       except rule_id
      219       to src_rule-by-profile
      220       assign
      221       src_rule-by-profile.rule_id = src_rule.rule_id
      222       .
      223       trg_rule-by-profile.is_dynamic = ?.
      224       delete trg_rule-by-profile.
      225     end.
      226     for each trg_rp-rule-param where
      227             trg_rp-rule-param.rule_id = trg_rule.rule_id
      228     on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)):
      229       create src_rp-rule-param .
      230       buffer-copy trg_rp-rule-param except rule_id to src_rp-rule-param
      231       assign
      232       src_rp-rule-param.rule_id = src_rule.rule_id
      233       .
      234       delete trg_rp-rule-param.
      235     end.
      236   end.
