     2094       .
     2095       if v-waiting-stfl-i = 0
     2096       or v-old-stfl-i = 0
     2097       or v-new-stfl-i = 0
     2098       then do:
     2099         next _ii.
     2100         end.
     2101       if v-old-stfl-i < v-waiting-stfl-i
     2102       and v-new-stfl-i = v-waiting-stfl-i then do:
     2103         assign
     2104         p-is-waiting-status = yes
     2105         p-direction = '<закрытие документа>':U + chr(4) + "to".
     2106         return.
     2107       end.
     2108       if v-old-stfl-i < v-waiting-stfl-i
     2109       and v-new-stfl-i > v-waiting-stfl-i then do:
     2110         assign
     2111         p-is-waiting-status = yes
     2112         p-direction = '<закрытие документа>':U + chr(4) + "to-up".
     2113         return.
     2114       end.
     2115       if v-new-stfl-i = v-waiting-stfl-i
     2116       and v-old-stfl-i > v-waiting-stfl-i then do:
     2117         assign
     2118         p-is-waiting-status = yes
     2119         p-direction = '<открытие документа>':U + chr(4) + "to".
     2120         return.
     2121       end.
