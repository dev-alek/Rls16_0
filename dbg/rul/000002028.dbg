     1497   .
     1498   procedure get-header-by-rec :
     1499   define input  parameter p-gate-rec as character no-undo .
     1500   define output parameter p-tth as handle no-undo .
     1501   define variable v-ii as integer   no-undo .
     1502   define variable glog as logical   no-undo .
     1503   define variable v-rowid as rowid no-undo .
     1504   define variable v-tbl-name as character no-undo .
     1505   define variable v-longchar as longchar no-undo .
     1506   define variable v-txmlh as handle no-undo .
     1507   define buffer buf_clob-data for ub.clob-data.
     1508   main-block:
     1509   do
     1510   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info10, return-value, chr(10), error-status :get-message (1))
     1511   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info10 )
     1512   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info10 )
     1513   :
     1514     run gen-row-keyr in  this-procedure  (
     1515                                           input  p-gate-rec
     1516                                           ,input  ?
     1517                                           ,input  "ub"
     1518                                           ,input  ?
     1519                                           ,input  NO-LOCK
     1520                                           ,output v-rowid
     1521                                           ,output v-tbl-name   ) no-error.
     1522       find first buf_clob-data no-lock where
     1523                 rowid(buf_clob-data) = v-rowid  no-error.
     1524       if not available buf_clob-data then do:
     1525         undo, return error substitute("Не найден CLOB  &1"
     1526                                         , p-gate-rec
     1527                                         ).
     1528       end.
     1529       assign
     1530       v-longchar = buf_clob-data.cdata
     1531       .
     1532       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1533       if error-status :error then do:
     1534         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1535       end.
     1536       create temp-table p-tth .
     1537       glog = p-tth:READ-XMLSCHEMA( "LONGCHAR"
     1538                                     , v-longchar
     1539                                     , ?
     1540                                     , ?
     1541                                     , ?
     1542                                     ) no-error.
     1543       v-longchar = '':U.
     1544       define variable v-esm as character no-undo .
     1545       v-esm = error-status:get-message(1).
     1546       if error-status :error
     1547       or not glog
     1548       then do:
     1549         delete object p-tth no-error.
     1550         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     1551                                    , p-gate-rec
     1552                                    , buf_clob-data.file-name_
     1553                                    , chr(10)
     1554                                    , v-esm
     1555                                     ).
     1556       end.
     1557   end.
     1558   end procedure.
     1559   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1560   define new global shared variable g#trdcalib as handle no-undo.
     1561   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1562   define temp-table operation no-undo
     1563   field referenceNo as character
     1564   field codeOperation as character
     1565   field host as integer
     1566   field store as character
     1567   field factOrder as decimal
     1568   field sysDateXML as date
     1569   field sysTime as character
     1570   field dateDocXML as date
     1571   field dateFactXML as date
     1572   field factTime as character
     1573   field valutCode as integer
     1574   field valutCodeOKV as integer
     1575   field comment as character
     1576   field suppInDocNo as character
     1577   index pi is unique primary
     1578   referenceNo
     1579   .
     1580   define temp-table linedoc no-undo
     1581   field referenceNo as character
     1582   field good as integer
     1583   field bCode as integer
     1584   field artic as character
     1585   field prodType as character
     1586   field prodCode as integer
     1587   field type as character
     1588   field unitType as character
     1589   field unitCli as character
     1590   field cliBaseRate as decimal
     1591   field doc_ID as character
     1592   field partCode as character
     1593   field priceSale as decimal
     1594   field priceListQnty as decimal
     1595   field pricePrev as decimal
     1596   index pi is unique primary
     1597   referenceNo
     1598   bCode
     1599   .
     1600   define dataset price-doc-01
     1601   for operation, linedoc
