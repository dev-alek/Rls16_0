     2707        run nws/cmd-bush.p persistent set p-esys-cmd-proc-handle no-error .
     2708        if error-status :error
     2709        then do:
     2710           delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( substitute("&1 &2 &3&4Ошибка при запуске процедуры cmd-bush.p&4" +
     2711                                              "&5&4&6"
     2712                                              ,vss-workfile
     2713                                              ,vss-revision
     2714                                              ,vss-description
     2715                                              ,chr(10)
     2716                                              ,error-status:get-message(1)
     2717                                              ,return-value )).
     2718        end.
     2719        run begin-create-command in p-esys-cmd-proc-handle
     2720          (input 'cmd-esys-general':U
     2721          ,input p-esys-id-list
     2722          ,output p-esys-cmd-code
     2723          ) no-error.
     2724        if error-status :error
     2725        then do:
     2726          delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при создании команды &1&2&3&1&4"
     2727                                                           , 'cmd-esys-general':U
     2728                                                           , error-status:get-message(1)
     2729                                                           , return-value
     2730                                                           )).
     2731          return no .
     2732        end.
     2733        return yes.
     2734      end.
     2735   end.
