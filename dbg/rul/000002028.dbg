     2802      else do:
     2803         delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при удалении команды с кодом &1&2&3&2&4"
     2804                                                       , p-cmd-code
     2805                                                       , chr(10)
     2806                                                       , error-status:get-message(1)
     2807                                                       , return-value
     2808                                                       )).
     2809         return no .
     2810      end.
     2811   end.
     2812   on delete of this-procedure do:
     2813     run garbcoll_clear in this-procedure .
     2814   end.
     2815   run load-ruleset-context in this-procedure ( input p-ruleset-id) no-error.
     2816   if error-status:error then do:
     2817     undo, return error return-value .
     2818   end.
     2819   if return-value = "return" then return ''.
     2820   define variable ExpData1 as class Route-data_ no-undo .
     2821   ExpData1 = new Route-data_( input parparentproc, input p-parent-handle, input p-log-handle, input this-procedure:handle) .
     2822   if not this-procedure:persistent then do:
     2823     run proc-main in this-procedure no-error .
     2824     if error-status:error then do:
     2825       v-esm = error-status :get-message (1).
     2826       v-es = error-status:error .
     2827       v-rv = return-value .
     2828     end.
     2829   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2830   if v-view-log
     2831   and not g#news
     2832   and not g#auto
     2833   then do:
     2834     message
     2835     '!!!При маршрутизации произошли ошибки!!!'  skip
     2836     "!!!Внимательно прочитайте Log-file!!"
     2837     view-as alert-box error .
     2838        define variable v-user-action22   as character no-undo .
     2839     define variable v-printed22       as logical   no-undo .
     2840     run gbl/prnfilen.w
     2841       (input  ('!!!При маршрутизации произошли ошибки!!!')
     2842       ,input  0
     2843       ,input  (string("./":U) + log-file-name)
     2844       ,input  7
     2845       ,output v-user-action22
     2846       ,output v-printed22
     2847       ) .
     2848   end.
     2849   if v-view-log = true
     2850   and (g#news
     2851   or g#auto)
     2852   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
     2853   then do:
     2854      run cb_set-view-log in p-parent-handle ( input yes).
     2855   end.
     2856     if v-es then do:
     2857         run garbcoll_clear in this-procedure .
     2858         undo, return error substitute( "&1. &2&3&4", vss-workfile, v-rv, chr(10), v-esm).
     2859     end.
     2860     run garbcoll_clear in this-procedure .
     2861   end.
     2862   procedure proc-main :
     2863   _main:
     2864   do
     2865   on error undo, return error substitute( "&1&2&3&2&4", return-value, chr(10), error-status :get-message (1), v-last-error-message)
     2866   :
     2867     define variable v-doc-code as character no-undo .
     2868     define variable v-price-doc-obj-type as character no-undo .
     2869     define variable v-price-doc-obj-code as integer no-undo .
     2870     define variable v-obj-db-num as integer no-undo .
     2871     define variable v-obj-uniq-key-rec as character no-undo .
     2872     define variable v-doc-list-doc-type as character no-undo .
     2873     define buffer buf_price-doc for ub.price-doc.
     2874     define buffer buf_clients for ub.clients.
     2875     define buffer buf_ext-classif for ub.ext-classif.
     2876   _stroka:
     2877   do while true
     2878   on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2879   on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
     2880   on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
     2881   :
     2882   v-esys-id-list = ''.
     2883   v-price-doc-obj-type = ''.
     2884   v-price-doc-obj-code = 0.
     2885   case p-ruleset-id:
     2886     when 10 then do:
     2887       if v-doc-list-bh:available then do:
     2888         v-doc-list-bh:buffer-delete().
     2889       end.
     2890       run cb_get-next-doc-by-doc-code in v-doc-list-handle ( input v-doc-code
     2891                                                             ,input v-doc-list-doc-type
     2892                                                             ,input v-doc-list-bh
     2893                                                             ).
     2894       if v-doc-list-bh:available then do:
     2895         v-price-doc-obj-type = v-doc-list-bh:buffer-field("obj-type"):buffer-value.
     2896         v-price-doc-obj-code = v-doc-list-bh:buffer-field("obj-code"):buffer-value.
     2897         v-doc-code = v-doc-list-bh:buffer-field("doc-code"):buffer-value.
     2898         v-doc-list-doc-type = v-doc-list-bh:buffer-field("doc-type"):buffer-value.
     2899         if v-doc-list-doc-type <> 'переоценка':U
     2900         then do:
     2901           case p-ruleset-id:
     2902             when 10 then do:
     2903               next _stroka.
     2904             end.
     2905             when 110 then do:
     2906               leave _stroka.
     2907             end.
     2908           end case.
     2909         end.
     2910       END.
     2911       else do:
     2912         v-price-doc-obj-type = ''.
     2913         v-price-doc-obj-code = 0.
     2914         v-doc-code = ''.
     2915         leave _stroka.
     2916       end.
     2917     end.
     2918     when 110 then do:
     2919       if v-has-newbh then do:
     2920         v-price-doc-obj-type = v-newbh::obj-type.
     2921         v-price-doc-obj-code = v-newbh::obj-code.
     2922         v-doc-code = v-newbh:buffer-field("doc-num"):buffer-value.
     2923       end.
     2924       else do:
     2925         v-price-doc-obj-type = v-oldbh::obj-type.
     2926         v-price-doc-obj-code = v-oldbh::obj-code.
     2927         v-doc-code = v-oldbh:buffer-field("doc-num"):buffer-value.
     2928       end.
     2929     end.
     2930   end case.
     2931     find first buf_clients no-lock where
     2932               buf_clients.obj-type = v-price-doc-obj-type
     2933         and  buf_clients.obj-code = v-price-doc-obj-code.
     2934     run gen-key-rec in this-procedure ( input 'clients':U
     2935                                       ,input buffer buf_clients:handle
     2936                                       ,output v-obj-uniq-key-rec).
     2937     v-esys-id-list = ''.
     2938     for each buf_ext-classif no-lock where
     2939         buf_ext-classif.classif-name = 'clients-esys':U
     2940     and buf_ext-classif.classif-subject = 'clients':U
     2941     and buf_ext-classif.db-num = 0
     2942     and buf_Ext-classif.uniq-key-rec = v-obj-uniq-key-rec :
     2943       if lookup(string(buf_ext-classif.key#_one), v-esys-id-list-start, chr(1)) = 0 then next.
     2944       v-esys-id-list = v-esys-id-list + (if v-esys-id-list = '' then '' else chr(1)) + string(buf_ext-classif.key#_one).
     2945     end.
     2946     case p-ruleset-id:
     2947       when 10 then do:
     2948         if v-esys-id-list = '' then next _stroka.
     2949       end.
     2950       when 110 then do:
     2951         if v-esys-id-list = '' then leave _stroka.
     2952       end.
     2953     end case.
     2954     IF  ExpData1:route-data_read-xmlschema( INPUT p-xsd-file) = false  THEN do:
     2955       undo _main, return error v-last-error-message .
     2956     end.
     2957     IF  context_begin-esys-command( input v-esys-id-list
     2958                                   , input-output v-esys-cmd-proc-handle
     2959                                   , output v-esys-cmd-code) = false  THEN do:
     2960       undo _main, return error v-last-error-message .
     2961     end.
     2962     if p-save >= 0 then do:
     2963         find first buf_price-doc exclusive-lock where
     2964                   buf_price-doc.doc-num = v-doc-code
     2965                 no-error.
     2966     end.
     2967     else do:
     2968         find first buf_price-doc no-lock where
     2969                   buf_price-doc.doc-num = v-doc-code
     2970                 no-error.
     2971     end.
     2972     run edocsprc_export in this-procedure ( buffer buf_price-doc
     2973                                           ) no-error.
     2974     if error-status:error then do:
     2975        undo _main, return error ''.
     2976     end.
     2977     IF  context_send-esys-command( input v-esys-id-list
     2978                                 , input v-esys-cmd-proc-handle
     2979                                 , input v-esys-cmd-code
     2980                                 , input g#userid) = false  THEN do:
     2981       undo _main, return error v-last-error-message .
     2982     end.
     2983       ExpData1:Route-data_clear-data ( ) .
     2984     if p-ruleset-id = 110 then leave _stroka.
     2985   end.
     2986   end.
     2987   end procedure.
     2988   procedure load-ruleset-context :
     2989   define input parameter p-ruleset-id as integer no-undo .
     2990   define variable v-flag as logical no-undo .
     2991   define variable v-ii as integer no-undo .
     2992   define variable v-is-waiting-status as logical no-undo .
     2993   define variable v-direction as character no-undo .
     2994   define variable v-direction-2 as character no-undo .
     2995   define variable v-changes-list as character no-undo .
     2996   define variable v-h as handle no-undo .
     2997   define buffer buf_rule-call-param for ub.rule-call-param.
     2998   define buffer buf_temp-rule-call-param for temp-rule-call-param.
     2999   define buffer buf_ext-system for ub.ext-system.
     3000   do
     3001   on error undo, return error
     3002   :
     3003     case p-ruleset-id:
     3004       when 10 then do:
     3005   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3006   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run calltree in g#library
     3007     (input  'cb_get-next-doc-by-doc-code'
     3008     ,input  this-procedure:handle
     3009     ,input  p-cont-handle
     3010     ,output v-doc-list-handle
     3011     )  .
     3012   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3013   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run calltree in g#library
     3014     (input  'cb_rcps-run_fill-rcp-from-tt0'
     3015     ,input  this-procedure:handle
     3016     ,input  p-cont-handle
     3017     ,output v-h
     3018     )  .
     3019         run  cb_rcps-run_fill-rcp-from-tt0 in v-h ( input p-call-id
     3020                                                   ,input buffer buf_temp-rule-call-param:handle
     3021                                                                 ).
     3022         for each buf_temp-rule-call-param no-lock where
     3023         buf_temp-rule-call-param.codex_id = p-codex-id
     3024         and buf_temp-rule-call-param.ruleset_id = p-ruleset-id
     3025         and buf_temp-rule-call-param.call_id = p-call-id
     3026         and buf_temp-rule-call-param.order_id = p-order-id
     3027         and buf_temp-rule-call-param.rule_id = p-rule-id
     3028         and buf_temp-rule-call-param.param-name = "p-esys-id-list",
     3029           first buf_ext-system no-lock where
     3030                 buf_Ext-system.esys-id = buf_temp-rule-call-param.param-value-integer
     3031             and buf_Ext-system.db-num = 0
     3032             and buf_Ext-system.esys-have-export = yes
     3033             and buf_Ext-system.esys-db-num-exp = g#db-num:
     3034           v-esys-id-list-start = v-esys-id-list-start + (if v-esys-id-list-start = '' then '' else chr(1)) + string(buf_ext-system.esys-id).
     3035         end.
     3036         if v-esys-id-list-start = '' then return "return".
     3037         find first buf_temp-rule-call-param no-lock where
     3038         buf_temp-rule-call-param.codex_id = p-codex-id
     3039         and buf_temp-rule-call-param.ruleset_id = p-ruleset-id
     3040         and buf_temp-rule-call-param.call_id = p-call-id
     3041         and buf_temp-rule-call-param.order_id = p-order-id
     3042         and buf_temp-rule-call-param.rule_id = p-rule-id
     3043         and buf_temp-rule-call-param.param-name = "p-xsd-file"
     3044         no-error.
     3045         if available buf_temp-rule-call-param then do:
     3046           assign p-xsd-file = buf_temp-rule-call-param.param-value-character.
     3047         end.
     3048         v-doc-list-bh = buffer doc-list:handle.
     3049         v-action = 'U':U.
     3050       end.
     3051       when 110 then do:
     3052         assign
     3053         v-oldbh = widget-handle (entry(2, p-doc-code, chr(4)))
     3054         v-newbh = widget-handle (entry(3, p-doc-code, chr(4)))
     3055         v-changes-list = entry(4, p-doc-code, chr(4))
     3056         file-name  = p-process-file-name
     3057         v-has-oldbh = valid-handle(v-oldbh) and v-oldbh:available
     3058         v-has-newbh = valid-handle(v-newbh) and v-newbh:available
     3059         .
     3060         if not v-has-newbh
     3061         and not v-has-oldbh then do:
     3062           undo, return error substitute("Не определено ни одного буфера - ни старый, ни новый").
     3063         end.
     3064         if not v-has-oldbh
     3065         and v-changes-list  = '' then do:
     3066           undo, return error substitute("Не определен старый буфер и список изменений").
     3067         end.
     3068         if v-has-newbh
     3069         and v-newbh:table <> 'price-doc':U then do:
     3070           undo, return error substitute("Передан неверный буфер вместо буфера для &1",  'price-doc':U).
     3071         end.
     3072         run statq_has-waiting-stat in this-procedure (
     3073                                                         input v-oldbh
     3074                                                       ,input v-newbh
     3075                                                       ,input v-changes-list
     3076                                                       ,input 'акт':U
     3077                                                       ,input ?
     3078                                                       ,input 0
     3079                                                       ,output v-is-waiting-status
     3080                                                       ,output v-direction
     3081                                                       ) no-error.
     3082         if v-is-waiting-status = no then return "return".
     3083         if num-entries(v-direction, chr(4)) > 1 then do:
     3084           v-direction-2 = entry(2, v-direction, chr(4)).
     3085           v-direction = entry(1, v-direction, chr(4)).
     3086           if v-direction-2 <> "to"
     3087           and v-direction-2 <> "from" then return "return".
     3088           if v-direction = '<открытие документа>':U
     3089           and v-direction-2 = "to" then return "return".
     3090           if v-direction = '<закрытие документа>':U
     3091           and v-direction-2 = "from" then return "return".
     3092         end.
     3093         if v-direction = '<открытие документа>':U
     3094         or v-direction = 'удаление':U
     3095         then do:
     3096           v-action = 'D':U.
     3097         end.
     3098         else do:
     3099           v-action = 'U':U.
     3100         end.
     3101         for each buf_rule-call-param no-lock where
     3102         buf_rule-call-param.codex_id = p-codex-id
     3103         and buf_rule-call-param.ruleset_id = p-ruleset-id
     3104         and buf_rule-call-param.call_id = p-call-id
     3105         and buf_rule-call-param.order_id = p-order-id
     3106         and buf_rule-call-param.rule_id = p-rule-id
     3107         and buf_rule-call-param.param-name = "p-esys-id-list",
     3108           first buf_ext-system no-lock where
     3109                 buf_Ext-system.esys-id = buf_rule-call-param.param-value-integer
     3110             and buf_Ext-system.db-num = 0
     3111             and buf_Ext-system.esys-have-export = yes
     3112             and buf_Ext-system.esys-db-num-exp = g#db-num:
     3113           v-esys-id-list-start = v-esys-id-list-start + (if v-esys-id-list-start = '' then '' else chr(1)) + string(buf_ext-system.esys-id).
     3114         end.
     3115         if v-esys-id-list-start = '' then return "return".
     3116           find first buf_rule-call-param no-lock where
     3117         buf_rule-call-param.codex_id = p-codex-id
     3118         and buf_rule-call-param.ruleset_id = p-ruleset-id
     3119         and buf_rule-call-param.call_id = p-call-id
     3120         and buf_rule-call-param.order_id = p-order-id
     3121         and buf_rule-call-param.rule_id = p-rule-id
     3122         and buf_rule-call-param.param-name = "p-xsd-file"
     3123         no-error.
     3124         if available buf_rule-call-param then do:
     3125           assign p-xsd-file = buf_rule-call-param.param-value-character.
     3126         end.
     3127       end.
     3128       otherwise do:
     3129         undo, return error substitute("Неверный вызов &1 для набора правил &2", vss-workfile , p-ruleset-id).
     3130       end.
     3131     end case.
     3132   end.
     3133   end procedure.
     3134   procedure edocsprc_export :
     3135   define parameter buffer buf_price-doc for ub.price-doc.
     3136   define buffer buf_price-list for ub.price-list.
     3137   define variable v-bh as handle no-undo .
     3138   define variable v-bh-line as handle no-undo .
     3139   define variable v-err-mess as character no-undo .
     3140   define variable glog as logical no-undo .
     3141   define variable v-attr-type as character no-undo .
     3142   define variable v-hidden-referenceNo as logical no-undo .
     3143   define buffer buf_operation for operation.
     3144   define buffer buf_linedoc for linedoc.
     3145   define buffer buf_currency for ub.currency.
     3146   define buffer buf_goods for ub.goods.
     3147   define buffer buf_units for ub.units.
     3148   define buffer buf_bar-code for ub.bar-code.
     3149   main-block:
     3150   do
     3151   on error undo main-block, retry main-block
     3152   :
     3153     if retry then do:
     3154       EMPTY TEMP-TABLE operation.
     3155       EMPTY TEMP-TABLE linedoc.
     3156           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input v-err-mess).
     3157       return error ''.
     3158     end.
     3159     else do:
     3160       v-bh = buffer buf_operation:handle.
     3161       v-bh-line = buffer buf_linedoc:handle.
     3162       for each buf_operation:
     3163         delete buf_operation.
     3164       end.
     3165       for each buf_linedoc:
     3166         delete buf_linedoc.
     3167       end.
     3168       create buf_operation.
     3169       assign
     3170       buf_operation.referenceNo = buf_price-doc.doc-num
     3171       buf_operation.host = buf_price-doc.host-code
     3172       buf_operation.codeOperation = 'ot':U
     3173       buf_operation.store = buf_price-doc.obj-type + string(buf_price-doc.obj-code)
     3174       buf_operation.sysDateXML = buf_price-doc.sys-date
     3175       buf_operation.systime = string(buf_price-doc.sys-time-int, "HH:MM:SS")
     3176       buf_operation.dateDocXML = buf_price-doc.doc-date
     3177       buf_operation.dateFactXML = buf_price-doc.fact-dat
     3178       buf_operation.factTime = string(buf_price-doc.fact-time, "HH:MM:SS")
     3179       buf_operation.factOrder = buf_price-doc.fact-Order
     3180       buf_operation.comment = buf_price-doc.PS
     3181       .
     3182   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     3183   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run r-b-curr in g#library
     3184     (input  buf_price-doc.host-code
     3185     ,output buf_operation.valutCode
     3186     )  .
     3187       find first buf_currency no-lock where
     3188                 buf_currency.curr-code = buf_operation.valutCode.
     3189       buf_operation.valutCodeOKV = buf_currency.okv-code.
     3190   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input buf_price-doc.doc-num ,
     3191                           input 'nids':U ,
     3192                          output buf_operation.suppInDocNo ,
     3193                          output v-attr-type )  .
     3194       ExpData1:route-data_create-record( INPUT "operation") .
     3195       ExpData1:route-data_copy-record ( input "operation", v-bh).
     3196       IF ExpData1:esys-add-dump( INPUT "operation", INPUT v-esys-cmd-proc-handle, INPUT v-esys-cmd-code, '+update') = false  THEN do:
     3197         v-err-mess = substitute("Ошибка при маршрутизации записи &1:&2&3"
     3198                                 , buf_price-doc.doc-num
     3199                                 , chr(10)
     3200                                 , v-last-error-message
     3201                                 ).
     3202         undo main-block, retry main-block.
     3203       end.
     3204       create buf_linedoc.
     3205       for each buf_price-list no-lock where
     3206               buf_price-list.doc-num = buf_price-doc.doc-num
     3207       on error  undo main-block, retry  main-block
     3208       on stop   undo main-block, retry  main-block
     3209       on endkey undo main-block, retry  main-block
     3210       :
     3211         find first buf_goods no-lock where
     3212                 buf_goods.artic = buf_price-list.artic
     3213             and buf_goods.prod-type = buf_price-list.prod-type
     3214             and buf_goods.prod-code = buf_price-list.prod-code no-error.
     3215         if available buf_goods then do:
     3216           find first buf_units no-lock where
     3217                   buf_units.unit-name = buf_goods.unit-base no-error.
     3218         end.
     3219         define variable v-price-prev as decimal   no-undo .
     3220         define variable v-void-char as character no-undo .
     3221         define variable v-void-dec as decimal no-undo .
     3222         assign
     3223         v-price-prev = 0.0
     3224         .
     3225         find first buf_bar-code no-lock where
     3226                   buf_bar-code.b-code = buf_price-list.b-code.
     3227   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3228   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     3229     (input  buf_price-list.obj-type
     3230     ,input  buf_price-list.obj-code
     3231     ,input  buf_price-list.b-code
     3232     ,input  0
     3233     ,input  buf_price-list.fact-order
     3234     ,output v-void-char
     3235     ,output v-price-prev
     3236     ,output v-void-dec
     3237     ,output v-void-dec
     3238     )  .
     3239         assign
     3240         buf_linedoc.referenceNo = buf_price-list.doc-num
     3241         buf_linedoc.bCode = buf_price-list.b-code
     3242         buf_linedoc.good = (if available buf_goods then buf_goods.gds-code else 0)
     3243         buf_linedoc.artic = buf_price-list.artic
     3244         buf_linedoc.prodType = buf_price-list.prod-Type
     3245         buf_linedoc.prodCode = buf_price-list.prod-Code
     3246         buf_linedoc.type = (if available buf_goods then buf_goods.gds-type else '')
     3247         buf_linedoc.unittype = (if available buf_units then buf_units.type else '')
     3248         buf_linedoc.unitCli = (if available buf_bar-code then buf_bar-code.unit-cli else '')
     3249         buf_linedoc.cliBaseRate = (if available buf_bar-code then buf_bar-code.cli-base-rate else  ?)
     3250         buf_linedoc.doc_id = (if available buf_bar-code then buf_bar-code.in-code else  '')
     3251         buf_linedoc.partCOde = (if available buf_bar-code then buf_bar-code.part-code else  '')
     3252         buf_linedoc.priceSAle = buf_price-list.price-Sale
     3253         buf_linedoc.priceListQnty  = buf_price-list.doc-qnty
     3254         buf_linedoc.pricePrev = v-price-prev
     3255         .
     3256         ExpData1:route-data_create-record( INPUT "linedoc") .
     3257         ExpData1:route-data_copy-record ( input "linedoc", v-bh-line).
     3258         if not v-hidden-referenceNo then do:
     3259           IF ExpData1:esys-add-dump( INPUT "linedoc", INPUT v-esys-cmd-proc-handle, INPUT v-esys-cmd-code, '_hidden=referenceNo') = false  THEN do:
     3260             v-err-mess = substitute("Ошибка при маршрутизации записи по переоценке &1:&2&3"
     3261                                     , buf_price-doc.doc-num
     3262                                     , chr(10)
     3263                                     , v-last-error-message
     3264                                     ).
     3265             undo main-block, retry main-block.
     3266           end.
     3267           v-hidden-referenceNo = yes.
     3268         end.
     3269         IF ExpData1:esys-add-dump( INPUT "linedoc", INPUT v-esys-cmd-proc-handle, INPUT v-esys-cmd-code, '+update') = false  THEN do:
     3270           v-err-mess = substitute("Ошибка при маршрутизации записи по переоценке &1 (баркод &2):&3&4"
     3271                                   , buf_price-doc.doc-num
     3272                                   , buf_price-list.b-code
     3273                                   , chr(10)
     3274                                   , v-last-error-message
     3275                                   ).
     3276           undo main-block, retry main-block.
     3277         end.
     3278       end.
     3279       delete buf_operation.
     3280       delete buf_linedoc.
     3281     end.
     3282   end.
     3283   end procedure.
