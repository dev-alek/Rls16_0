     1603   .
     1604   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1605   procedure statq_has-waiting-stat :
     1606   define input parameter p-oldbh              as handle no-undo .
     1607   define input parameter p-newbh              as handle no-undo .
     1608   define input parameter p-changed-fields     as character no-undo .
     1609   define input parameter p-waiting-status     as character no-undo .
     1610   define input parameter p-waiting-flag       as logical no-undo .
     1611   define input parameter p-waiting-stati      as integer no-undo .
     1612   define output parameter p-is-waiting-status as logical no-undo .
     1613   define output parameter p-direction         as character no-undo .
     1614   define variable v-has-newbh as logical no-undo .
     1615   define variable v-has-oldbh as logical no-undo .
     1616   define variable v-changed-fields as character no-undo .
     1617   define variable v-ii as integer no-undo .
     1618   define variable v-flag as logical   no-undo .
     1619   define variable v-some-bh as handle no-undo .
     1620   assign
     1621   v-has-oldbh = valid-handle(p-oldbh) and p-oldbh:available
     1622   v-has-newbh = valid-handle(p-newbh) and p-newbh:available
     1623   v-flag = false
     1624   .
     1625   if v-has-newbh then do:
     1626     if p-changed-fields = '' then do:
     1627       v-changed-fields = "status_,flag_".
     1628       do v-ii = 1 to num-entries(v-changed-fields):
     1629         if p-oldbh:buffer-field(entry(v-ii, v-changed-fields)):buffer-value <> p-newbh:buffer-field(entry(v-ii, v-changed-fields)):buffer-value then do:
     1630           v-flag = yes.
     1631           leave.
     1632         end.
     1633       end.
     1634       if not v-flag then do:
     1635          assign
     1636            p-direction          = ""
     1637            p-is-waiting-status   = false
     1638          .
     1639          return .
     1640       end.
     1641     end.
     1642     else do:
     1643       if lookup("status_", p-changed-fields) = 0
     1644       and lookup("flag_", p-changed-fields) = 0
     1645       and not(p-newbh:new) then do:
     1646          assign
     1647            p-direction          = ""
     1648            p-is-waiting-status   = false
     1649          .
     1650          return .
     1651       end.
     1652       else do:
     1653         if lookup("status_", p-changed-fields) > 0  and lookup("flag_", p-changed-fields) > 0 and
     1654           p-newbh::status_ = p-waiting-status and
     1655           (p-newbh:table = 'price-doc':U or p-newbh::flag_   = p-waiting-flag)   then do:
     1656             assign
     1657                 p-direction          = '<закрытие документа>':U
     1658                 p-is-waiting-status   = true
     1659             .
     1660             return .
     1661          end.
     1662         if lookup("status_", p-changed-fields) > 0  and lookup("flag_", p-changed-fields) = 0 and
     1663           p-newbh::status_ = p-waiting-status  then do:
     1664             assign
     1665                 p-direction          = '<закрытие документа>':U
     1666                 p-is-waiting-status   = true
     1667             .
     1668             return .
     1669          end.
     1670         if lookup("status_", p-changed-fields) = 0  and lookup("flag_", p-changed-fields) > 0 and
     1671         (p-newbh:table = 'price-doc':U or p-newbh::flag_   = p-waiting-flag )  then do:
     1672             assign
     1673                 p-direction          = '<закрытие документа>':U
     1674                 p-is-waiting-status   = true
     1675             .
     1676             return .
     1677          end.
     1678           if lookup("status_", p-changed-fields) > 0  and lookup("flag_", p-changed-fields) > 0 and
     1679           p-newbh::status_ = p-waiting-status and
     1680           (p-newbh:table = 'price-doc':U or p-waiting-flag = ? )  then do:
     1681             assign
     1682                 p-direction          = '<закрытие документа>':U
     1683                 p-is-waiting-status   = true
     1684             .
     1685             return .
     1686          end.
     1687       end.
     1688     end.
     1689   end.
     1690   else do:
     1691     if p-changed-fields = '' then do:
     1692       if p-oldbh::status_ = p-waiting-status
     1693       and (p-oldbh:table = 'price-doc':U
     1694           or
     1695         (p-waiting-flag = ?
     1696         or p-oldbh::flag_ = p-waiting-flag)) then do:
     1697         assign
     1698         p-direction = 'удаление':U
     1699         p-is-waiting-status = yes.
     1700         return.
     1701       end.
     1702       else do:
     1703         assign
     1704         p-direction          = ""
     1705         p-is-waiting-status = no.
     1706         return.
     1707       end.
     1708     end.
     1709     else do:
     1710       if lookup("status_", p-changed-fields) = 0
     1711       and lookup("flag_", p-changed-fields) = 0
     1712       then do:
     1713          assign
     1714             p-is-waiting-status  = false
     1715             p-direction          = ""
     1716          .
     1717          return .
     1718       end.
     1719     end.
     1720   end.
     1721   if v-has-newbh then do:
     1722     v-some-bh = p-newbh.
     1723   end.
     1724   else do:
     1725     v-some-bh = p-oldbh.
     1726   end.
     1727   case v-some-bh:table :
     1728     when 'ord-doc':U  then do:
     1729        if v-some-bh::doc-type = 'ОР':U or v-some-bh::doc-type = 'ОП':U then do:
     1730        if v-some-bh::doc-type = 'ОР':U then do:
     1731           run ord-orc in this-procedure
     1732           ( input  p-oldbh
     1733            ,input  p-newbh
     1734            ,input  p-changed-fields
     1735            ,input  p-waiting-status
     1736            ,input  p-waiting-flag
     1737            ,output p-is-waiting-status
     1738            ,output p-direction  )  .
     1739        end.
     1740        if v-some-bh::doc-type = 'ОП':U then do:
     1741           run ord-op in this-procedure
     1742           ( input  p-oldbh
     1743            ,input  p-newbh
     1744            ,input  p-changed-fields
     1745            ,input  p-waiting-status
     1746            ,input  p-waiting-flag
     1747            ,output p-is-waiting-status
     1748            ,output p-direction  )  .
     1749        end.
     1750        end.
     1751        else do:
     1752          assign
     1753             p-is-waiting-status  = false
     1754             p-direction          = ""
     1755          .
     1756        end.
     1757     end.
     1758     when 'ord-doc-rcv':U  then do:
     1759           run ord-rcv in this-procedure
     1760           ( input  p-oldbh
     1761            ,input  p-newbh
     1762            ,input  p-changed-fields
     1763            ,input  p-waiting-status
     1764            ,input  p-waiting-flag
     1765            ,output p-is-waiting-status
     1766            ,output p-direction  )  .
     1767     end.
     1768     when 'trn-doc':U  then do:
     1769           run stat-graf-trn in this-procedure
     1770           ( input  p-oldbh
     1771            ,input  p-newbh
     1772            ,input  p-changed-fields
     1773            ,input  p-waiting-status
     1774            ,input  p-waiting-flag
     1775            ,output p-is-waiting-status
     1776            ,output p-direction  )  .
     1777     end.
     1778     when 'price-doc':U then do:
     1779       run stat-graf-price in this-procedure
     1780           ( input  p-oldbh
     1781            ,input  p-newbh
     1782            ,input  p-changed-fields
     1783            ,input  p-waiting-status
     1784            ,input  p-waiting-flag
     1785            ,output p-is-waiting-status
     1786            ,output p-direction  )  .
     1787     end.
     1788     when 'inkas':U then do:
     1789           run stat-graf-inkas in this-procedure
     1790           ( input  p-oldbh
     1791            ,input  p-newbh
     1792            ,input  p-changed-fields
     1793            ,input  p-waiting-status
     1794            ,input  p-waiting-flag
     1795            ,output p-is-waiting-status
     1796            ,output p-direction  )  .
     1797     end.
     1798     otherwise do:
     1799          assign
     1800             p-is-waiting-status  = false
     1801             p-direction          = ""
     1802          .
     1803     end.
     1804   end case.
     1805   return .
     1806   end procedure.
     1807   procedure ord-op :
     1808   define input parameter p-oldbh              as handle no-undo .
     1809   define input parameter p-newbh              as handle no-undo .
     1810   define input parameter p-changed-fields     as character no-undo .
     1811   define input parameter p-waiting-status     as character no-undo .
     1812   define input parameter p-waiting-flag       as logical no-undo .
     1813   define output parameter p-is-waiting-status as logical no-undo .
     1814   define output parameter p-direction         as character no-undo .
     1815   define variable v-stat-list as character no-undo extent 5.
     1816   define variable v-waiting-stfl as character no-undo .
     1817   define variable v-old-stfl as character no-undo .
     1818   define variable v-new-stfl as character no-undo .
     1819   define variable v-waiting-stfl-i as integer no-undo .
     1820   define variable v-old-stfl-i as integer no-undo .
     1821   define variable v-new-stfl-i as integer no-undo .
     1822   define variable v-ii as integer no-undo .
     1823     do
     1824     on error undo, return error return-value
     1825     :
     1826   assign
     1827   v-stat-list[1] =
     1828                    ''            +  chr(3) +
     1829                    'новый':U    +  chr(3) +
     1830                    'согласование':U +  chr(3) +
     1831                    'поставка':U    +  chr(3) +
     1832                    'закрыто':U  +  chr(3) +
     1833                    'факт':U
     1834   v-stat-list[2] =
     1835                    ''            +  chr(3) +
     1836                    'новый':U    +  chr(3) +
     1837                    'отказ':U
     1838   v-stat-list[3] =
     1839                    ''            +  chr(3) +
     1840                    'новый':U    +  chr(3) +
     1841                    'согласование':U +  chr(3) +
     1842                    'отказ':U
     1843   v-stat-list[4] =
     1844                    ''            +  chr(3) +
     1845                    'новый':U    +  chr(3) +
     1846                    'согласование':U +  chr(3) +
     1847                    'поставка':U    +  chr(3) +
     1848                    'отказ':U
     1849   v-stat-list[5] =
     1850                    ''            +  chr(3) +
     1851                    'новый':U    +  chr(3) +
     1852                    'согласование':U +  chr(3) +
     1853                    'поставка':U    +  chr(3) +
     1854                    'закрыто':U  +  chr(3) +
     1855                    'отказ':U
     1856   .
     1857     assign
     1858     v-waiting-stfl = p-waiting-status
     1859     .
     1860     assign
     1861     v-old-stfl = p-oldbh::status_
     1862     .
     1863     assign
     1864     v-new-stfl = p-newbh::status_
     1865     .
     1866     _ii:
     1867     do v-ii = 1 to 5:
     1868       if v-stat-list[v-ii] = '' then next.
     1869       assign
     1870       v-waiting-stfl-i = lookup(v-waiting-stfl, v-stat-list[v-ii], chr(3))
     1871       v-old-stfl-i = lookup(v-old-stfl, v-stat-list[v-ii], chr(3))
     1872       v-new-stfl-i = lookup(v-new-stfl, v-stat-list[v-ii], chr(3))
     1873       .
     1874       if v-waiting-stfl-i = 0
     1875       or v-old-stfl-i = 0
     1876       or v-new-stfl-i = 0
     1877       then do:
     1878         next _ii.
     1879         end.
     1880       if v-old-stfl-i < v-waiting-stfl-i
     1881       and v-new-stfl-i = v-waiting-stfl-i then do:
     1882         assign
     1883         p-is-waiting-status = yes
     1884         p-direction = '<закрытие документа>':U + chr(4) + "to".
     1885         return.
     1886         end.
     1887       if v-old-stfl-i < v-waiting-stfl-i
     1888       and v-new-stfl-i > v-waiting-stfl-i then do:
     1889         assign
     1890         p-is-waiting-status = yes
     1891         p-direction = '<закрытие документа>':U + chr(4) + "to-up".
     1892         return.
     1893         end.
     1894       if v-new-stfl-i = v-waiting-stfl-i
     1895       and v-old-stfl-i > v-waiting-stfl-i then do:
     1896         assign
     1897         p-is-waiting-status = yes
     1898         p-direction = '<открытие документа>':U + chr(4) + "to".
     1899         return.
     1900         end.
     1901       if v-new-stfl-i < v-waiting-stfl-i
     1902       and v-old-stfl-i > v-waiting-stfl-i then do:
     1903         assign
     1904         p-is-waiting-status = yes
     1905         p-direction = '<открытие документа>':U + chr(4) + "to-down".
     1906         return.
     1907         end.
     1908       if v-old-stfl-i = v-waiting-stfl-i
     1909       and v-new-stfl-i > v-waiting-stfl-i then do:
     1910         assign
     1911         p-is-waiting-status = yes
     1912         p-direction = '<закрытие документа>':U + chr(4) + "from".
     1913         return.
     1914       end.
     1915       if v-old-stfl-i = v-waiting-stfl-i
     1916       and v-new-stfl-i < v-waiting-stfl-i then do:
     1917         assign
     1918         p-is-waiting-status = yes
     1919         p-direction = '<открытие документа>':U + chr(4) + "from".
     1920         return.
     1921       end.
     1922     end.
     1923     end.
     1924   end procedure.
     1925   procedure ord-orc :
     1926   define input parameter p-oldbh              as handle no-undo .
     1927   define input parameter p-newbh              as handle no-undo .
     1928   define input parameter p-changed-fields     as character no-undo .
     1929   define input parameter p-waiting-status     as character no-undo .
     1930   define input parameter p-waiting-flag       as logical no-undo .
     1931   define output parameter p-is-waiting-status as logical no-undo .
     1932   define output parameter p-direction         as character no-undo .
     1933   define variable v-stat-list as character no-undo extent 5.
     1934   define variable v-waiting-stfl as character no-undo .
     1935   define variable v-old-stfl as character no-undo .
     1936   define variable v-new-stfl as character no-undo .
     1937   define variable v-waiting-stfl-i as integer no-undo .
     1938   define variable v-old-stfl-i as integer no-undo .
     1939   define variable v-new-stfl-i as integer no-undo .
     1940   define variable v-ii as integer no-undo .
     1941     do
     1942     on error undo, return error return-value
     1943     :
     1944   assign
     1945   v-stat-list[1] =
     1946                    ''            +  chr(3) +
     1947                    'новый':U    +  chr(3) +
     1948                    'запрос':U +  chr(3) +
     1949                    'разрешено':U    +  chr(3) +
     1950                    'отгружено':U  +  chr(3) +
     1951                    'факт':U
     1952   v-stat-list[2] =
     1953                    ''            +  chr(3) +
     1954                    'новый':U    +  chr(3) +
     1955                    'отказ':U
     1956   v-stat-list[3] =
     1957                    ''            +  chr(3) +
     1958                    'новый':U    +  chr(3) +
     1959                    'запрос':U +  chr(3) +
     1960                    'отказ':U
     1961   v-stat-list[4] =
     1962                    ''            +  chr(3) +
     1963                    'новый':U    +  chr(3) +
     1964                    'запрос':U +  chr(3) +
     1965                    'разрешено':U    +  chr(3) +
     1966                    'отказ':U
     1967   v-stat-list[5] =
     1968                    ''            +  chr(3) +
     1969                    'новый':U    +  chr(3) +
     1970                    'запрос':U +  chr(3) +
     1971                    'разрешено':U    +  chr(3) +
     1972                    'отгружено':U  +  chr(3) +
     1973                    'отказ':U
     1974   .
     1975     assign
     1976     v-waiting-stfl = p-waiting-status
     1977     .
     1978     assign
     1979     v-old-stfl = p-oldbh::status_
     1980     .
     1981     assign
     1982     v-new-stfl = p-newbh::status_
     1983     .
     1984     _ii:
     1985     do v-ii = 1 to 5:
     1986       if v-stat-list[v-ii] = '' then next.
     1987       assign
     1988       v-waiting-stfl-i = lookup(v-waiting-stfl, v-stat-list[v-ii], chr(3))
     1989       v-old-stfl-i = lookup(v-old-stfl, v-stat-list[v-ii], chr(3))
     1990       v-new-stfl-i = lookup(v-new-stfl, v-stat-list[v-ii], chr(3))
     1991       .
     1992       if v-waiting-stfl-i = 0
     1993       or v-old-stfl-i = 0
     1994       or v-new-stfl-i = 0
     1995       then do:
     1996         next _ii.
     1997         end.
     1998       if v-old-stfl-i < v-waiting-stfl-i
     1999       and v-new-stfl-i = v-waiting-stfl-i then do:
     2000         assign
     2001         p-is-waiting-status = yes
     2002         p-direction = '<закрытие документа>':U + chr(4) + "to".
     2003         return.
     2004       end.
     2005       if v-old-stfl-i < v-waiting-stfl-i
     2006       and v-new-stfl-i > v-waiting-stfl-i then do:
     2007         assign
     2008         p-is-waiting-status = yes
     2009         p-direction = '<закрытие документа>':U + chr(4) + "to-up".
     2010         return.
     2011       end.
     2012       if v-new-stfl-i = v-waiting-stfl-i
     2013       and v-old-stfl-i > v-waiting-stfl-i then do:
     2014         assign
     2015         p-is-waiting-status = yes
     2016         p-direction = '<открытие документа>':U + chr(4) + "to".
     2017         return.
     2018         end.
     2019       if v-new-stfl-i < v-waiting-stfl-i
     2020       and v-old-stfl-i > v-waiting-stfl-i then do:
     2021         assign
     2022         p-is-waiting-status = yes
     2023         p-direction = '<открытие документа>':U + chr(4) + "to-down".
     2024         return.
     2025         end.
     2026       if v-old-stfl-i = v-waiting-stfl-i
     2027       and v-new-stfl-i > v-waiting-stfl-i then do:
     2028         assign
     2029         p-is-waiting-status = yes
     2030         p-direction = '<закрытие документа>':U + chr(4) + "from".
     2031         return.
     2032       end.
     2033       if v-old-stfl-i = v-waiting-stfl-i
     2034       and v-new-stfl-i < v-waiting-stfl-i then do:
     2035         assign
     2036         p-is-waiting-status = yes
     2037         p-direction = '<открытие документа>':U + chr(4) + "from".
     2038         return.
     2039         end.
     2040         end.
     2041     end.
     2042   end procedure.
     2043   procedure ord-rcv :
     2044   define input parameter p-oldbh              as handle no-undo .
     2045   define input parameter p-newbh              as handle no-undo .
