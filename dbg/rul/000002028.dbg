     2213                                                                   'факт':U         + chr(4) + string(yes)
     2214   v-stat-list[lookup('im':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] =
     2215                                                                   ''              + chr(4) + string(no) + chr(3) +
     2216                                                                   'факт':U         + chr(4) + string(yes)
     2217   v-stat-list[lookup('ap':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] =
     2218                                                                         ''              + chr(4) + string(no) + chr(3) +
     2219                                                                         'накл':U         + chr(4) + string(no) + chr(3) +
     2220                                                                         'факт':U         + chr(4) + string(yes)
     2221   v-stat-list[lookup('mp':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] =
     2222                                                                         ''              + chr(4) + string(no) + chr(3) +
     2223                                                                         'факт':U         + chr(4) + string(yes)
     2224   v-stat-list[lookup('pc':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] =
     2225                                                                         ''              + chr(4) + string(no) + chr(3) +
     2226                                                                         'факт':U         + chr(4) + string(yes)
     2227   .
     2228   assign
     2229   v-stat-list[lookup('ie':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 2] =
     2230                    '' +           chr(4) + string(no) + chr(3) +
     2231                    'запрос':U +   chr(4) + string(no) + chr(3) +
     2232                    'запрос':U +   chr(4) + string(yes) + chr(3) +
     2233                    'накл':U +      chr(4) + string(no) + chr(3) +
     2234                    'накл':U +      chr(4) + string(yes) + chr(3) +
     2235                    'разрешен':U + chr(4) + string(no) + chr(3) +
     2236                    'разрешен':U + chr(4) + string(yes) + chr(3) +
     2237                    'факт':U +      chr(4) + string(no)
     2238   .
     2239   assign
     2240   v-stat-list[lookup('vt':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] =
     2241                    '' +           chr(4) + string(no) + chr(3) +
     2242                    'запрос':U +   chr(4) + string(no) + chr(3) +
     2243                    'запрос':U +   chr(4) + string(yes) + chr(3) +
     2244                    'накл':U +      chr(4) + string(no) + chr(3) +
     2245                    'накл':U +      chr(4) + string(yes) + chr(3) +
     2246                    'разрешен':U + chr(4) + string(yes) + chr(3) +
     2247                    'разрешен':U + chr(4) + string(no) + chr(3) +
     2248                    'факт':U +      chr(4) + string(yes)
     2249   .
     2250   assign
     2251   v-stat-list[lookup('vt':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 2] =
     2252                    '' +           chr(4) + string(no) + chr(3) +
     2253                    'запрос':U +   chr(4) + string(no) + chr(3) +
     2254                    'запрос':U +   chr(4) + string(yes) + chr(3) +
     2255                    'накл':U +      chr(4) + string(no) + chr(3) +
     2256                    'накл':U +      chr(4) + string(yes) + chr(3) +
     2257                    'разрешен':U + chr(4) + string(yes) + chr(3) +
     2258                    'разрешен':U + chr(4) + string(no) + chr(3) +
     2259                    'факт':U +      chr(4) + string(no)
     2260   .
     2261   assign
     2262   v-stat-list[lookup('es':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] =
     2263                    '' +           chr(4) + string(no) + chr(3) +
     2264                    'касс':U + chr(4) + string(no) + chr(3) +
     2265                    'касс':U + chr(4) + string(yes) + chr(3) +
     2266                    'нередакт':U + chr(4) + string(yes) + chr(3) +
     2267                    'факт':U +      chr(4) + string(yes)
     2268   v-stat-list[lookup('rs':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] =
     2269                    '' +           chr(4) + string(no) + chr(3) +
     2270                    'касс':U + chr(4) + string(no) + chr(3) +
     2271                    'касс':U + chr(4) + string(yes) + chr(3) +
     2272                    'нередакт':U + chr(4) + string(yes) + chr(3) +
     2273                    'факт':U +      chr(4) + string(yes)
     2274   v-stat-list[lookup('es':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 2] =
     2275                    '' +         chr(4) + string(no) + chr(3) +
     2276                    'запрос':U + chr(4) + string(no)
     2277   v-stat-list[lookup('rs':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 2] =
     2278                    '' +         chr(4) + string(no) + chr(3) +
     2279                    'запрос':U + chr(4) + string(no)
     2280   .
     2281   _jj:
     2282   do v-jj = 1 to 2:
     2283     if v-jj = 1 then do:
     2284       assign
     2285       v-waiting-stfl = p-waiting-status + chr(4) + string(if p-waiting-flag = ? then yes else p-waiting-flag)
     2286       .
     2287     end.
     2288     if v-jj = 2 then do:
     2289       if p-waiting-flag <> ? then leave  _jj.
     2290       assign
     2291       v-waiting-stfl = p-waiting-status + chr(4) + string(no)
     2292       .
     2293     end.
     2294     assign
     2295     v-old-stfl = p-oldbh::status_ + chr(4) + string(p-oldbh::flag_)
     2296     .
     2297     assign
     2298     v-new-stfl = p-newbh::status_ + chr(4) + string(p-newbh::flag_)
     2299     .
     2300     _ii:
     2301     do v-ii = (lookup(v-ext-doc-type, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3) to (lookup(v-ext-doc-type, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4):
     2302       if v-stat-list[v-ii] = '' then next.
     2303       assign
     2304       v-waiting-stfl-i = lookup(v-waiting-stfl, v-stat-list[v-ii], chr(3))
     2305       v-old-stfl-i = lookup(v-old-stfl, v-stat-list[v-ii], chr(3))
     2306       v-new-stfl-i = lookup(v-new-stfl, v-stat-list[v-ii], chr(3))
     2307       .
     2308       if v-waiting-stfl-i = 0
     2309       or v-old-stfl-i = 0
     2310       or v-new-stfl-i = 0
     2311       then do:
     2312         next _ii.
     2313       end.
     2314       if v-old-stfl-i < v-waiting-stfl-i
     2315       and v-new-stfl-i = v-waiting-stfl-i then do:
     2316         assign
     2317         p-is-waiting-status = yes
     2318         p-direction = '<закрытие документа>':U + chr(4) + "to".
     2319         return.
     2320       end.
     2321       if v-old-stfl-i < v-waiting-stfl-i
     2322       and v-new-stfl-i > v-waiting-stfl-i then do:
     2323         assign
     2324         p-is-waiting-status = yes
     2325         p-direction = '<закрытие документа>':U + chr(4) + "to-up".
     2326         return.
     2327       end.
     2328       if v-new-stfl-i = v-waiting-stfl-i
     2329       and v-old-stfl-i > v-waiting-stfl-i then do:
     2330         assign
     2331         p-is-waiting-status = yes
     2332         p-direction = '<открытие документа>':U + chr(4) + "to".
     2333         return.
     2334       end.
     2335       if v-new-stfl-i < v-waiting-stfl-i
     2336       and v-old-stfl-i > v-waiting-stfl-i then do:
     2337         assign
     2338         p-is-waiting-status = yes
     2339         p-direction = '<открытие документа>':U + chr(4) + "to-down".
     2340         return.
     2341       end.
     2342       if v-old-stfl-i = v-waiting-stfl-i
     2343       and v-new-stfl-i > v-waiting-stfl-i then do:
     2344         assign
     2345         p-is-waiting-status = yes
     2346         p-direction = '<закрытие документа>':U + chr(4) + "from".
     2347         return.
     2348       end.
     2349       if v-old-stfl-i = v-waiting-stfl-i
     2350       and v-new-stfl-i < v-waiting-stfl-i then do:
     2351         assign
     2352         p-is-waiting-status = yes
     2353         p-direction = '<открытие документа>':U + chr(4) + "from".
     2354         return.
     2355       end.
     2356     end.
     2357   end.
     2358   end.
     2359   end procedure .
     2360   procedure stat-graf-price :
     2361   define input parameter p-oldbh              as handle no-undo .
     2362   define input parameter p-newbh              as handle no-undo .
     2363   define input parameter p-changed-fields     as character no-undo .
     2364   define input parameter p-waiting-status     as character no-undo .
     2365   define input parameter p-waiting-flag       as logical no-undo .
     2366   define output parameter p-is-waiting-status as logical no-undo .
     2367   define output parameter p-direction         as character no-undo .
     2368   define variable v-stat-list as character no-undo extent 5.
     2369   define variable v-waiting-stfl as character no-undo .
     2370   define variable v-old-stfl as character no-undo .
     2371   define variable v-new-stfl as character no-undo .
     2372   define variable v-waiting-stfl-i as integer no-undo .
     2373   define variable v-old-stfl-i as integer no-undo .
     2374   define variable v-new-stfl-i as integer no-undo .
     2375   define variable v-ii as integer no-undo .
     2376   do
     2377   on error undo, return error return-value
     2378   :
     2379   assign
     2380   v-stat-list[1] =
     2381                    ''            +  chr(3) +
     2382                    'новый':U    +  chr(3) +
     2383                    'приказ':U      +  chr(3) +
     2384                    'разрешен':U  +  chr(3) +
     2385                    'акт':U
     2386   .
     2387     assign
     2388     v-waiting-stfl = p-waiting-status
     2389     .
     2390     assign
     2391     v-old-stfl = p-oldbh::status_
     2392     .
     2393     assign
     2394     v-new-stfl = p-newbh::status_
     2395     .
     2396     _ii:
     2397     do v-ii = 1 to 5:
     2398       if v-stat-list[v-ii] = '' then next.
     2399       assign
     2400       v-waiting-stfl-i = lookup(v-waiting-stfl, v-stat-list[v-ii], chr(3))
     2401       v-old-stfl-i = lookup(v-old-stfl, v-stat-list[v-ii], chr(3))
     2402       v-new-stfl-i = lookup(v-new-stfl, v-stat-list[v-ii], chr(3))
     2403       .
     2404       if v-waiting-stfl-i = 0
     2405       or v-old-stfl-i = 0
     2406       or v-new-stfl-i = 0
     2407       then do:
     2408         next _ii.
     2409       end.
     2410       if v-old-stfl-i < v-waiting-stfl-i
     2411       and v-new-stfl-i = v-waiting-stfl-i then do:
     2412         assign
     2413         p-is-waiting-status = yes
     2414         p-direction = '<закрытие документа>':U + chr(4) + "to".
     2415         return.
     2416       end.
     2417       if v-old-stfl-i < v-waiting-stfl-i
     2418       and v-new-stfl-i > v-waiting-stfl-i then do:
     2419         assign
     2420         p-is-waiting-status = yes
     2421         p-direction = '<закрытие документа>':U + chr(4) + "to-up".
     2422         return.
     2423       end.
     2424       if v-new-stfl-i = v-waiting-stfl-i
     2425       and v-old-stfl-i > v-waiting-stfl-i then do:
     2426         assign
     2427         p-is-waiting-status = yes
     2428         p-direction = '<открытие документа>':U + chr(4) + "to".
     2429         return.
     2430       end.
     2431       if v-new-stfl-i < v-waiting-stfl-i
     2432       and v-old-stfl-i > v-waiting-stfl-i then do:
     2433         assign
     2434         p-is-waiting-status = yes
     2435         p-direction = '<открытие документа>':U + chr(4) + "to-down".
     2436         return.
     2437       end.
     2438       if v-old-stfl-i = v-waiting-stfl-i
     2439       and v-new-stfl-i > v-waiting-stfl-i then do:
     2440         assign
     2441         p-is-waiting-status = yes
     2442         p-direction = '<закрытие документа>':U + chr(4) + "from".
     2443         return.
     2444       end.
     2445       if v-old-stfl-i = v-waiting-stfl-i
     2446       and v-new-stfl-i < v-waiting-stfl-i then do:
     2447         assign
     2448         p-is-waiting-status = yes
     2449         p-direction = '<открытие документа>':U + chr(4) + "from".
     2450         return.
     2451       end.
     2452     end.
     2453   end.
     2454   end procedure.
     2455   procedure stat-graf-inkas :
     2456   define input parameter  p-oldbh              as handle no-undo .
     2457   define input parameter  p-newbh              as handle no-undo .
     2458   define input parameter  p-changed-fields     as character no-undo .
     2459   define input parameter  p-waiting-status     as character no-undo .
     2460   define input parameter  p-waiting-flag       as logical no-undo .
     2461   define output parameter p-is-waiting-status  as logical no-undo .
     2462   define output parameter p-direction          as character no-undo .
     2463   define variable v-doc-code as character no-undo .
     2464   define variable v-ext-doc-type as character no-undo .
     2465   define variable v-stat-list as character no-undo extent 3.
     2466   define variable v-jj as integer no-undo .
     2467   define variable v-ii as integer no-undo .
     2468   define variable v-old-stfl as character no-undo .
     2469   define variable v-new-stfl as character no-undo .
     2470   define variable v-waiting-stfl as character no-undo .
     2471   define variable v-old-stfl-i as integer no-undo .
     2472   define variable v-new-stfl-i as integer no-undo .
     2473   define variable v-waiting-stfl-i as integer no-undo .
     2474   do
     2475   on error  undo, return error substitute( "&1. &2&3&4", vss-include-info13, return-value, chr(10), error-status :get-message (1))
     2476   :
     2477   if p-newbh = ?  then do:
     2478     v-doc-code = p-oldbh::inkas-code .
     2479   end.
     2480   else do:
     2481     v-doc-code     = p-newbh::inkas-code .
     2482   end.
     2483   assign
     2484   v-stat-list[1] =
     2485                    '' +           chr(4) + string(no) + chr(3) +
     2486                    'новый':U + chr(4) + string(no) + chr(3) +
     2487                    'факт':U +      chr(4) + string(no)
     2488   v-stat-list[2] =
     2489                    '' +           chr(4) + string(no) + chr(3) +
     2490                    'новый':U + chr(4) + string(no) + chr(3) +
     2491                    'новый':U + chr(4) + string(yes) + chr(3) +
     2492                    'нередакт':U + chr(4) + string(yes) + chr(3) +
     2493                    'факт':U +      chr(4) + string(no)
     2494   v-stat-list[3] =
     2495                    '' +         chr(4) + string(no) + chr(3) +
     2496                    'запрос':U + chr(4) + string(no)
     2497   .
     2498   _jj:
     2499   do v-jj = 1 to 2:
     2500     if v-jj = 1 then do:
     2501       assign
     2502       v-waiting-stfl = p-waiting-status + chr(4) + string(if p-waiting-flag = ? then no else p-waiting-flag)
     2503       .
     2504     end.
     2505     if v-jj = 2 then do:
     2506       if p-waiting-flag <> ? then leave  _jj.
     2507       assign
     2508       v-waiting-stfl = p-waiting-status + chr(4) + string(yes)
     2509       .
     2510     end.
     2511     assign
     2512     v-old-stfl = p-oldbh::status_ + chr(4) + string(p-oldbh::flag_)
     2513     .
     2514     assign
     2515     v-new-stfl = p-newbh::status_ + chr(4) + string(p-newbh::flag_)
     2516     .
     2517     _ii:
     2518     do v-ii = 1 to 3:
     2519       if v-stat-list[v-ii] = '' then next.
     2520       assign
     2521       v-waiting-stfl-i = lookup(v-waiting-stfl, v-stat-list[v-ii], chr(3))
     2522       v-old-stfl-i = lookup(v-old-stfl, v-stat-list[v-ii], chr(3))
     2523       v-new-stfl-i = lookup(v-new-stfl, v-stat-list[v-ii], chr(3))
     2524       .
     2525       if v-waiting-stfl-i = 0
     2526       or v-old-stfl-i = 0
     2527       or v-new-stfl-i = 0
     2528       then do:
     2529         next _ii.
     2530       end.
     2531       if v-old-stfl-i < v-waiting-stfl-i
     2532       and v-new-stfl-i = v-waiting-stfl-i then do:
     2533         assign
     2534         p-is-waiting-status = yes
     2535         p-direction = '<закрытие документа>':U + chr(4) + "to".
     2536         return.
     2537       end.
     2538       if v-old-stfl-i < v-waiting-stfl-i
     2539       and v-new-stfl-i > v-waiting-stfl-i then do:
     2540         assign
     2541         p-is-waiting-status = yes
     2542         p-direction = '<закрытие документа>':U + chr(4) + "to-up".
     2543         return.
     2544       end.
     2545       if v-new-stfl-i = v-waiting-stfl-i
     2546       and v-old-stfl-i > v-waiting-stfl-i then do:
     2547         assign
     2548         p-is-waiting-status = yes
     2549         p-direction = '<открытие документа>':U + chr(4) + "to".
     2550         return.
     2551       end.
     2552       if v-new-stfl-i < v-waiting-stfl-i
     2553       and v-old-stfl-i > v-waiting-stfl-i then do:
     2554         assign
     2555         p-is-waiting-status = yes
     2556         p-direction = '<открытие документа>':U + chr(4) + "to-down".
     2557         return.
     2558       end.
     2559       if v-old-stfl-i = v-waiting-stfl-i
     2560       and v-new-stfl-i > v-waiting-stfl-i then do:
     2561         assign
     2562         p-is-waiting-status = yes
     2563         p-direction = '<закрытие документа>':U + chr(4) + "from".
     2564         return.
     2565       end.
     2566       if v-old-stfl-i = v-waiting-stfl-i
     2567       and v-new-stfl-i < v-waiting-stfl-i then do:
     2568         assign
     2569         p-is-waiting-status = yes
     2570         p-direction = '<открытие документа>':U + chr(4) + "from".
     2571         return.
     2572       end.
     2573     end.
     2574   end.
     2575   end.
     2576   end procedure .
