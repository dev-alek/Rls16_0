     2176   DEFINE new shared TEMP-TABLE thbjattr-list no-undo like ub.thbj-attr .
     2177   define new shared var sendEMRC   as logical no-undo.
     2178   define new shared var settingUpd as logical no-undo.
     2179   define new shared var sendMarkType as logical no-undo.
     2180   define new shared var sendGisMt as logical no-undo.
     2181   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2182   procedure send-to-cash:
     2183     if not can-find(first ub.cash-desk where
     2184                     ub.cash-desk.db-num = ibs.th.gbl.gbl-var:g#db-num AND
     2185                     ub.cash-desk.cash-on = yes) then return.
     2186     do
     2187     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2188     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     2189     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     2190     :
     2191       if can-find(first gds-list no-lock)
     2192       or can-find(first gdsolist no-lock)
     2193       or can-find(first bc-list no-lock)
     2194       or can-find(first pbc-list no-lock)
     2195       or can-find(first cash-txn no-lock)
     2196       or can-find(first cash-txr no-lock)
     2197       or can-find(first dc-list no-lock)
     2198       or can-find(first dc-dis-card-mask no-lock)
     2199       or can-find(first stpl-list no-lock)
     2200       or can-find(first pdf-list no-lock)
     2201       or can-find(first cash-pay-list no-lock)
     2202       or can-find(first ext-classif-list no-lock)
     2203       or can-find(first c-ext-classif-list no-lock)
     2204       or can-find(first PromoAction-list no-lock)
     2205       or can-find(first thbjattr-list no-lock)
     2206       or sendEMRC
     2207       or settingUpd
     2208       or sendMarkType
     2209       then do:
     2210         run str/diallog.w (
     2211                            input parparentproc
     2212                           ,input ?
     2213                           ,input 'str/sendnall.p':U
     2214                           ,input string(ibs.th.gbl.gbl-var:g#db-num)
     2215                           ,input yes
     2216                           ,input '':U
     2217                           ,input 'Отправка информации на кассу') no-error .
     2218       end.
     2219     end.
     2220   end procedure.
     2221   procedure fill-setting :
     2222      define input parameter i-obj      as character no-undo .
     2223      define input parameter i-obj-type as character no-undo .
     2224      define input parameter i-obj-code as integer   no-undo .
     2225      define input parameter i-parent   as character no-undo .
     2226      define input parameter i-code     as character no-undo .
     2227      define buffer buf_thbj-attr for ub.thbj-attr.
     2228      define buffer buf_sys-ctrl for ub.sys-ctrl.
     2229      define buffer buf_clients for ub.clients.
     2230      define variable v-db-num    as integer no-undo.
     2231      define variable v-shop-code as integer no-undo.
     2232      define variable v-reg-code  as integer no-undo.
     2233      settingUpd = yes.
     2234      sendGisMt = no.
     2235      if i-obj = "thbj-attr"
     2236      then do:
     2237         v-db-num  = ibs.th.gbl.gbl-var:g#db-num.
     2238         if v-db-num <> 0 then do:
     2239             find first buf_clients no-lock
     2240                  where buf_clients.obj-type = 'маг':U
     2241                    and buf_clients.db-num   = v-db-num
     2242                no-error.
     2243             if available buf_clients then v-shop-code = buf_clients.obj-code.
     2244         end.
     2245      end.
     2246      if i-obj = "thbj-attr" and
     2247         (i-parent = 'gisMT':U or i-parent = 'marking':U)
     2248      then do:
     2249         if i-parent = 'gisMT':U and i-obj-type = "" and i-obj-code = 0 then do:
     2250             if not can-find(first buf_thbj-attr no-lock where
     2251                                   buf_thbj-attr.obj-type = 'БД':U
     2252                               and buf_thbj-attr.obj-code = v-db-num
     2253                               and buf_thbj-attr.upper-prop-code = i-parent
     2254                               and buf_thbj-attr.prop-code = i-code)
     2255             then sendGisMt = yes.
     2256         end.
     2257         if i-parent = 'gisMT':U and i-obj-type = 'регион':U then do:
     2258             sendGisMt = yes.
     2259         end.
     2260         else if (i-parent = 'gisMT':U and i-obj-type = 'БД':U and i-obj-code = v-db-num)
     2261            then sendGisMt = yes.
     2262         else if i-parent = 'marking':U and i-obj-type = 'маг':U and i-obj-code = v-shop-code
     2263            then sendGisMt = yes.
     2264         else if i-parent = 'marking':U and i-obj-type = "" then do:
     2265             if not can-find(first buf_thbj-attr no-lock where
     2266                                   buf_thbj-attr.obj-type = 'маг':U
     2267                               and buf_thbj-attr.obj-code = v-shop-code
     2268                               and buf_thbj-attr.upper-prop-code = i-parent
     2269                               and buf_thbj-attr.prop-code = i-code)
     2270             then sendGisMt = yes.
     2271         end.
     2272         if sendGisMt = yes then do:
     2273             if not can-find(first thbjattr-list where
     2274                                   thbjattr-list.obj-type = i-obj-type
     2275                               and thbjattr-list.obj-code = i-obj-code
     2276                               and thbjattr-list.upper-prop-code = i-parent
     2277                               and thbjattr-list.prop-code = i-code)
     2278             then do:
     2279                 create thbjattr-list.
     2280                 assign
     2281                    thbjattr-list.obj-type = i-obj-type
     2282                    thbjattr-list.obj-code = i-obj-code
     2283                    thbjattr-list.upper-prop-code = i-parent
     2284                    thbjattr-list.prop-code = i-code
     2285                    .
     2286             end.
     2287         end.
     2288      end.
     2289   end procedure.
     2290   procedure fill-code :
     2291      define input parameter i-parent as character no-undo .
     2292      define input parameter i-code   as character no-undo .
     2293      if i-parent begins "EMC"
     2294      then
     2295         sendEMRC = yes.
     2296      if i-parent begins "MarkType"
     2297      then
     2298         sendMarkType = yes.
     2299   end procedure.
     2300   procedure fill-gds-list :
     2301   define parameter buffer buf_goods for ub.goods.
     2302   do
     2303   on error undo, return error
     2304   :
     2305     for first gds-list where gds-list.gds-code = buf_goods.gds-code:
     2306       delete gds-list.
     2307     end.
     2308     create gds-list.
     2309     buffer-copy buf_goods to gds-list no-error.
     2310     if error-status:error then message error-status:get-message(1) view-as alert-box.
     2311     release gds-list.
     2312   end.
     2313   end procedure.
     2314   procedure fill-dc-list :
     2315   define parameter buffer buf_dis-card for ub.dis-card .
     2316   do
     2317   on error undo, return error
     2318   :
     2319     find first dc-list where
     2320               dc-list.d-card = buf_dis-card.d-card no-lock no-error.
     2321     if not available dc-list then do:
     2322       create dc-list.
     2323       buffer-copy buf_dis-card to dc-list.
     2324       release dc-list.
     2325     end.
     2326   end.
     2327   end procedure.
     2328   procedure fill-dc-list-mask :
     2329   define parameter buffer buf_dis-card-mask for ub.dis-card-mask .
     2330   do
     2331   on error undo, return error
     2332   :
     2333      find first dc-list where
     2334               dc-list.d-card = buf_dis-card-mask.mask no-lock no-error.
     2335      if not available dc-list
     2336      then do:
     2337         find first ub.dis-card no-lock where
     2338                    ub.dis-card.d-card = buf_dis-card-mask.mask no-error .
     2339         if  available dis-card
     2340         then
     2341            run fill-dc-list(buffer dis-card) .
     2342      end.
     2343     find first dc-dis-card-mask where
     2344                dc-dis-card-mask.mask-num = buf_dis-card-mask.mask-num no-lock no-error.
     2345     buffer-copy buf_dis-card-mask to dc-dis-card-mask.
     2346     release dc-dis-card-mask.
     2347   end.
     2348   end procedure.
     2349   procedure fill-dc-list-mask-attr :
     2350   define parameter buffer buf_dis-card-mask-attr for ub.dis-card-mask-attr .
     2351   define buffer dis-card-mask for ub.dis-card-mask .
     2352   do
     2353   on error undo, return error
     2354   :
     2355     find first dc-dis-card-mask where
     2356                dc-dis-card-mask.mask-num = buf_dis-card-mask-attr.mask-num no-lock no-error.
     2357     if not available dc-dis-card-mask
     2358     then do:
     2359        find first dis-card-mask where dis-card-mask.mask-num eq buf_dis-card-mask-attr.mask-num no-lock no-error.
     2360        if available dis-card-mask
     2361        then
     2362           run  fill-dc-list-mask (buffer dis-card-mask).
     2363     end.
     2364     find first dc-dis-card-mask-attr where
     2365               dc-dis-card-mask-attr.mask-num  = buf_dis-card-mask-attr.mask-num
     2366          and  dc-dis-card-mask-attr.attr-code = buf_dis-card-mask-attr.attr-code
     2367               no-lock no-error.
     2368     buffer-copy buf_dis-card-mask-attr to dc-dis-card-mask-attr.
     2369     release dc-dis-card-mask-attr.
     2370   end.
     2371   end procedure.
     2372   procedure fill-dc-list-attr :
     2373   define input parameter p-d-card as character no-undo .
     2374   define input parameter p-emitent-host-code as integer no-undo .
     2375   do
     2376   on error undo, return error
     2377   :
     2378     find first dc-list where
     2379               dc-list.d-card = p-d-card no-error .
     2380     if not avail dc-list then do:
     2381       create dc-list.
     2382       assign
     2383       dc-list.d-card = p-d-card
     2384       dc-list.emitent-host-code = p-emitent-host-code
     2385       .
     2386       release dc-list.
     2387     end.
     2388   end.
     2389   end procedure.
     2390   procedure fill-cash-pay :
