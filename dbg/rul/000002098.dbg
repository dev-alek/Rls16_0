       53   define new global shared variable g#vssrevis-logger as handle    no-undo .
       54   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       55   define variable v-vssrevis-logger                   as handle    no-undo .
       56   procedure vss-logevent :
       57     define input  parameter p-extra-paramters as character no-undo .
       58     define variable v-vssrevis-parameters as character no-undo .
       59     do
       60     on error undo, return error return-value
       61     :
       62       if  valid-handle(v-vssrevis-logger)
       63       and v-vssrevis-logger :get-signature("logevent") <> ""
       64       then do:
       65         run vss-get-parameters in this-procedure
       66           (output v-vssrevis-parameters
       67           ).
       68         run logevent in v-vssrevis-logger
       69           (input vss-workfile
       70           ,input vss-revision
       71           ,input v-vssrevis-parameters
       72           ,input p-extra-paramters
       73           ).
       74       end.
       75     end.
       76   end procedure.
       77   assign
       78     v-vssrevis-logger = g#vssrevis-logger
       79   .
       80   if  valid-handle(v-vssrevis-logger)
       81   and v-vssrevis-logger :get-signature("logevent") <> ""
       82   then do:
       83     assign
       84       v-vssrevis-logevent = true
       85     .
       86     run vss-logevent in this-procedure (input vss-description) .
       87   end.
       88   define new global shared variable g#language as character no-undo .
       89   if g#language <> '' and g#language <> 'rus':U then do:
       90     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       91   end.
