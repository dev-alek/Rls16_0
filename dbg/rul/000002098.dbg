     1640     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1641     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1642     :
     1643       if valid-handle(buf_temp-xml-tables.tbl-handle_) then do:
     1644         buf_temp-xml-tables.tbl-handle_:empty-temp-table().
     1645       end.
     1646     end.
     1647   end.
     1648   end procedure.
