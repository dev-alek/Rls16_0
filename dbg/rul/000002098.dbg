     1148   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1149   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1150   def var vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1151   procedure get-gate-file-name :
     1152   define input parameter p-gate-rec as character no-undo .
     1153   define output  parameter p-gate-file-name as character no-undo .
     1154   define buffer buf_clob-data for ub.clob-data.
     1155   define variable v-tbl-row as rowid no-undo .
     1156   define variable v-tbl-name as character no-undo .
     1157   run gen-row-keyr in this-procedure ( input p-gate-rec
     1158                                       ,input ?
     1159                                       ,input "ub"
     1160                                       ,input ?
     1161                                       ,input no-lock
     1162                                       ,output v-tbl-row
     1163                                       ,output v-tbl-name) no-error.
     1164   if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     1165                                                           ,vss-include-info10
     1166                                                           ,p-gate-rec).
     1167   find first buf_clob-data no-lock where
     1168             rowid(buf_clob-data) = v-tbl-row no-error.
     1169   if not available buf_clob-data then do:
     1170     if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     1171                                                             ,vss-include-info10
     1172                                                             ,p-gate-rec).
     1173   end.
     1174   p-gate-file-name = buf_clob-data.file-name.
     1175   end procedure.
     1176   procedure get-gate-rec :
     1177   define input  parameter p-gate-name as character no-undo .
     1178   define output parameter p-gate-rec as character no-undo .
     1179   define buffer buf_clob-bind for ub.clob-bind.
     1180   define buffer buf_clob-data for ub.clob-data.
     1181   main-block:
     1182   do
     1183   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info10, return-value, chr(10), error-status :get-message (1))
     1184   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info10 )
     1185   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info10 )
     1186   :
     1187       find first buf_clob-bind no-lock where
     1188                 buf_clob-bind.uniq-key-rec = p-gate-name
     1189             and buf_clob-bind.field-name = '':U
     1190             and buf_clob-bind.part-num = 1
     1191             and buf_clob-bind.resource-type = 'gate':U
     1192             no-error.
     1193       if not available buf_clob-bind then do:
     1194         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     1195                                         , p-gate-name
     1196                                         ).
     1197       end.
     1198       find first buf_clob-data no-lock where
     1199                 buf_clob-data.db-num = buf_clob-bind.db-num
     1200             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     1201       if not available buf_clob-data then do:
     1202         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1203                                         , buf_clob-bind.db-num
     1204                                         , buf_clob-bind.int64-id
     1205                                         , p-gate-name
     1206                                         ).
     1207       end.
     1208       run gen-key-rec in this-procedure ( input 'clob-data':U
     1209                                 ,input buffer buf_clob-data:handle
     1210                                 ,output p-gate-rec).
     1211   end.
     1212   end procedure.
     1213   procedure get-gate-by-name :
     1214   define input  parameter p-gate-name as character no-undo .
     1215   define output parameter p-gate-rec as character no-undo .
     1216   define output parameter p-dsh as handle no-undo .
     1217   define input-output  parameter p-xmlh as handle no-undo .
     1218   define variable v-ii as integer   no-undo .
     1219   define variable glog as logical   no-undo .
     1220   define variable v-longchar as longchar no-undo .
     1221   define variable v-txmlh as handle no-undo .
     1222   define variable v-db-num as integer no-undo .
     1223   define variable v-int64-id as int64 no-undo .
     1224   define buffer buf_clob-bind for ub.clob-bind.
     1225   define buffer buf_clob-data for ub.clob-data.
     1226   main-block:
     1227   do
     1228   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info10, return-value, chr(10), error-status :get-message (1))
     1229   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info10 )
     1230   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info10 )
     1231   :
     1232       find first buf_clob-bind no-lock where
     1233                 buf_clob-bind.uniq-key-rec = p-gate-name
     1234             and buf_clob-bind.field-name = '':U
     1235             and buf_clob-bind.part-num = 1
     1236             and buf_clob-bind.resource-type = 'gate':U
     1237             no-error.
     1238       if not available buf_clob-bind then do:
     1239         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     1240                                         , p-gate-name
     1241                                         ).
     1242       end.
     1243       find first buf_clob-data no-lock where
     1244                 buf_clob-data.db-num = buf_clob-bind.db-num
     1245             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     1246       if not available buf_clob-data then do:
     1247         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1248                                         , buf_clob-bind.db-num
     1249                                         , buf_clob-bind.int64-id
     1250                                         , p-gate-name
     1251                                         ).
     1252       end.
     1253       assign
     1254       v-longchar = buf_clob-data.cdata
     1255       .
     1256       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1257       if error-status :error then do:
     1258         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1259       end.
     1260       create dataset p-dsh .
     1261       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1262                                     , v-longchar
     1263                                     , ?
     1264                                     , ?
     1265                                     , ?
     1266                                     ) no-error.
     1267       v-longchar = '':U.
     1268       if error-status :error
     1269       or not glog
     1270       then do:
     1271         undo, return error substitute("Не удалось прочитать XML-схему &1 из БД:&2&3", p-gate-name, chr(10), error-status:get-message(1) ).
     1272       end.
     1273       if not valid-handle(p-xmlh)
     1274       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1275         create temp-table v-txmlh.
     1276         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1277         v-txmlh:temp-table-prepare("temp-xml-tables").
     1278         p-xmlh = v-txmlh:default-buffer-handle.
     1279       end.
     1280       run gen-key-rec in this-procedure ( input 'clob-data':U
     1281                                 ,input buffer buf_clob-data:handle
     1282                                 ,output p-gate-rec).
     1283       do v-ii = 1 to p-dsh:num-buffers:
     1284         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1285         if not p-xmlh:available then do:
     1286           p-xmlh:buffer-create().
     1287           assign
     1288           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1289           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1290           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1291           p-xmlh::gate-handle_ = p-dsh
     1292           p-xmlh::uniq-gate-rec = p-gate-rec
     1293           p-xmlh::gate-name = p-dsh:name
     1294           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1295           .
     1296           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1297             assign
     1298             p-xmlh::order = -3.
     1299           end.
     1300         end.
     1301       end.
     1302   end.
     1303   end procedure.
     1304   procedure get-gate-by-rec :
     1305   define input  parameter p-gate-rec as character no-undo .
     1306   define output parameter p-dsh as handle no-undo .
     1307   define input-output  parameter p-xmlh as handle no-undo .
     1308   define input-output parameter p-longchar  as longchar no-undo .
     1309   define variable v-ii as integer   no-undo .
     1310   define variable glog as logical   no-undo .
     1311   define variable v-rowid as rowid no-undo .
     1312   define variable v-tbl-name as character no-undo .
     1313   define variable v-longchar as longchar no-undo .
     1314   define variable v-txmlh as handle no-undo .
     1315   define buffer buf_clob-data for ub.clob-data.
     1316   main-block:
     1317   do
     1318   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info10, return-value, chr(10), error-status :get-message (1))
     1319   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info10 )
     1320   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info10 )
     1321   :
     1322     run gen-row-keyr in this-procedure (
     1323                                           input  p-gate-rec
     1324                                           ,input  ?
     1325                                           ,input  "ub"
     1326                                           ,input  ?
     1327                                           ,input  NO-LOCK
     1328                                           ,output v-rowid
     1329                                           ,output v-tbl-name   ) no-error.
     1330       find first buf_clob-data no-lock where
     1331                 rowid(buf_clob-data) = v-rowid  no-error.
     1332       if not available buf_clob-data then do:
     1333         undo, return error substitute("Не найден CLOB  &1"
     1334                                         , p-gate-rec
     1335                                         ).
     1336       end.
     1337       assign
     1338       v-longchar = buf_clob-data.cdata
     1339       .
     1340       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1341       if error-status :error then do:
     1342         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1343       end.
     1344       create dataset p-dsh .
     1345       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1346                                     , v-longchar
     1347                                     , ?
     1348                                     , ?
     1349                                     , ?
     1350                                     ) no-error.
     1351       define variable v-esm as character no-undo .
     1352       v-esm = error-status:get-message(1) .
     1353       if p-longchar <> ? then do:
     1354         p-longchar = v-longchar.
     1355       end.
     1356       v-longchar = '':U.
     1357       if error-status :error
     1358       or not glog
     1359       then do:
     1360         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     1361                                      , p-gate-rec
     1362                                      , p-gate-rec
     1363                                      , v-esm
     1364                                      ).
     1365       end.
     1366       p-dsh:private-data = buf_clob-data.file-name_ + chr(4) + p-gate-rec.
     1367       if not valid-handle(p-xmlh)
     1368       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1369         create temp-table v-txmlh.
     1370         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1371         v-txmlh:temp-table-prepare("temp-xml-tables").
     1372         p-xmlh = v-txmlh:default-buffer-handle.
     1373       end.
     1374       do v-ii = 1 to p-dsh:num-buffers:
     1375         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1376         if not p-xmlh:available then do:
     1377           p-xmlh:buffer-create().
     1378           assign
     1379           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1380           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1381           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1382           p-xmlh::gate-handle_ = p-dsh
     1383           p-xmlh::uniq-gate-rec = p-gate-rec
     1384           p-xmlh::gate-name = p-dsh:name
     1385           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1386           .
     1387           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1388             assign
     1389             p-xmlh::order = -3.
     1390           end.
     1391           p-xmlh:buffer-release().
     1392         end.
     1393       end.
     1394   end.
     1395   end procedure.
     1396   procedure get-gate-by-file :
     1397   define input  parameter p-schema-file-name as character no-undo .
     1398   define input  parameter p-gate-rec as character no-undo .
     1399   define output parameter p-dsh as handle no-undo .
     1400   define input-output  parameter p-xmlh as handle no-undo .
     1401   define variable v-ii as integer   no-undo .
     1402   define variable glog as logical   no-undo .
     1403   define variable v-rowid as rowid no-undo .
     1404   define variable v-tbl-name as character no-undo .
     1405   define variable v-longchar as longchar no-undo .
     1406   define variable v-txmlh as handle no-undo .
     1407   main-block:
     1408   do
     1409   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info10, return-value, chr(10), error-status :get-message (1))
     1410   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info10 )
     1411   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info10 )
     1412   :
     1413       COPY-LOB
     1414       FROM  FILE p-schema-file-name
     1415       TO  OBJECT v-longchar
     1416       no-convert
     1417       NO-ERROR .
     1418       if error-status :error then do:
     1419           undo, return error substitute("Не удалось считать файл схемы &1 в память&2&3"
     1420                                     , p-schema-file-name
     1421                                 , chr(10)
     1422                                 , error-status:get-message(1) ).
     1423       end.
     1424       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1425       if error-status :error then do:
     1426         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, p-schema-file-name, chr(10), error-status:get-message(1) , return-value ).
     1427       end.
     1428       create dataset p-dsh .
     1429       glog = p-dsh:READ-XMLSCHEMA( "longchar"
     1430                                     , v-longchar
     1431                                     , ?
     1432                                     , ?
     1433                                     , ?
     1434                                     ) no-error.
     1435       v-longchar = ''.
     1436       if error-status :error
     1437       or not glog
     1438       then do:
     1439         undo, return error substitute("Не удалось прочитать XML-схему из файла &1&2&3"
     1440                                      , p-schema-file-name
     1441                                      ,chr(10)
     1442                                      , error-status:get-message(1)
     1443                                      ).
     1444       end.
     1445       if not valid-handle(p-xmlh)
     1446       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1447         create temp-table v-txmlh.
     1448         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1449         v-txmlh:temp-table-prepare("temp-xml-tables").
     1450         p-xmlh = v-txmlh:default-buffer-handle.
     1451       end.
     1452       do v-ii = 1 to p-dsh:num-buffers:
     1453         p-xmlh:find-first(substitute(' where tbl-name = "&1" and  uniq-gate-rec = "&2" '
     1454                                      ,p-dsh:get-buffer-handle(v-ii):name
     1455                                      ,p-gate-rec
     1456                                      )) no-error.
     1457         if not p-xmlh:available then do:
     1458           p-xmlh:buffer-create().
     1459           assign
     1460           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):table
     1461           p-xmlh::uniq-gate-rec = p-gate-rec
     1462           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1463           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1464           p-xmlh::gate-handle_ = p-dsh
     1465           p-xmlh::gate-name = p-dsh:name
     1466           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1467           .
     1468           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1469             assign
     1470             p-xmlh::order = -3.
     1471           end.
     1472           p-xmlh:buffer-release().
     1473         end.
     1474       end.
     1475   end.
     1476   end procedure.
     1477   procedure gate-clear :
     1478   define input  parameter p-dsh as handle no-undo .
     1479   define input  parameter p-xmlh as handle no-undo .
     1480   define variable v-dsh as handle no-undo .
     1481   define variable v-th as handle no-undo .
     1482     do
     1483     on error undo, return error return-value
     1484     :
     1485       if valid-handle(p-dsh) then do:
     1486         delete object p-dsh.
     1487         v-dsh = p-dsh.
     1488         p-dsh = ?.
     1489       end.
     1490       repeat while true:
     1491         p-xmlh:find-first( substitute( " where gate-handle_ = &1 ", v-dsh)
     1492                            , share-lock) no-error.
     1493         if p-xmlh:available then do:
     1494           assign
     1495           v-th = p-xmlh:buffer-field("table-handle_"):buffer-value.
     1496           if valid-handle(p-xmlh:buffer-field("table-handle_"))
     1497           and valid-handle(v-th)
     1498           and v-th:dynamic = yes
     1499           then do:
     1500             delete object p-xmlh:buffer-field("table-handle_"):buffer-value.
     1501             p-xmlh:buffer-field("table-handle_"):buffer-value = ?.
     1502           end.
     1503           p-xmlh:buffer-delete().
     1504         end.
     1505         else do:
     1506           leave.
     1507         end.
     1508       end.
     1509       if p-xmlh:dynamic = yes
     1510       and valid-handle(p-xmlh)
     1511       then do:
     1512         delete object p-xmlh:table-handle.
     1513         p-xmlh = ?.
     1514       end.
     1515       v-dsh = ?.
     1516     end.
     1517   end procedure.
     1518   procedure all-gates-clear :
     1519   define parameter buffer buf_temp-xml-tables for temp-xml-tables.
     1520   do
     1521   on error undo, return error
     1522   :
     1523     for each buf_temp-xml-tables
     1524     break
     1525     by buf_temp-xml-tables.uniq-gate-rec
     1526     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1527     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1528     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1529     :
     1530         if first-of(buf_temp-xml-tables.uniq-gate-rec) then do:
     1531           delete object buf_temp-xml-tables.gate-handle_.
     1532           buf_temp-xml-tables.gate-handle_ = ?.
     1533         end.
     1534         if valid-handle(buf_temp-xml-tables.table-handle_)
     1535         and buf_temp-xml-tables.table-handle_:dynamic = no
     1536         then do:
     1537           delete object buf_temp-xml-tables.table-handle_.
     1538           buf_temp-xml-tables.table-handle_ = ?.
     1539         end.
     1540         delete buf_temp-xml-tables.
     1541     end.
     1542   end.
     1543   end procedure.
     1544   procedure fix-schemalocation :
     1545   define input-output  parameter p-longchar as longchar no-undo .
     1546   DEFINE VARIABLE hdoc AS HANDLE.
     1547   DEFINE VARIABLE hroot AS HANDLE.
     1548   DEFINE VARIABLE hnode-child AS HANDLE.
     1549   DEFINE VARIABLE hnode-attr AS HANDLE.
     1550   define variable v-jj as integer   no-undo .
     1551   define variable ok as logical   no-undo .
     1552   define variable v-path1                    as character                no-undo .
     1553   DEFINE VARIABLE v-full-path1               as character                no-undo .
     1554   DEFINE VARIABLE v-file-name1               as character                no-undo .
     1555   DEFINE VARIABLE v-file-name-no-ext1        as character                no-undo .
     1556   DEFINE VARIABLE v-file-name-ext1           as character                no-undo .
     1557   define variable v-schema-location          as character                no-undo .
     1558   do
     1559   on error undo, return error return-value
     1560   :
     1561     CREATE X-DOCUMENT hdoc.
     1562     CREATE X-noderef hroot.
     1563     CREATE X-noderef hnode-child.
     1564     CREATE X-noderef hnode-attr.
     1565     hdoc:load("longchar", p-longchar, no) no-error.
     1566     iF ERROR-STATUS:GET-MESSAGE(1) <> '' THEN message ERROR-STATUS:GET-MESSAGE(1) view-as alert-box .
     1567     hdoc:get-document-element(hroot).
     1568     _repeat:
     1569     REPEAT v-jj = 1 TO hroot:NUM-CHILDREN:
     1570       ok = hroot:GET-CHILD(hNode-Child, v-jj).
     1571       if not ok then next.
     1572       if hNode-Child:local-name = "include"
     1573       then do:
     1574         ok = hNode-Child:GET-ATTRIBUTE-NODE( hnode-attr, "schemaLocation" ).
     1575           v-schema-location = hnode-attr:node-value.
     1576           run gbl/filename.p (
     1577                           input "exe/" + hnode-attr:node-value
     1578                         ,output v-full-path1
     1579                         ,output v-path1
     1580                         ,output v-file-name1
     1581                         ,output v-file-name-no-ext1
     1582                         ,output v-file-name-ext1
     1583                         ) no-error .
     1584           if error-status :error then do:
     1585             delete object hnode-attr.
     1586             delete object hnode-child.
     1587             delete object hroot.
     1588             delete object hdoc.
     1589             undo, return error substitute("Не удалось определить расположение схемы &1", v-schema-location).
     1590           end.
     1591         ok = hNode-Child:sET-ATTRIBUTE(  "schemaLocation", v-full-path1 ).
     1592         leave  _repeat.
     1593       end.
     1594     END.
     1595     hdoc:save("longchar", p-longchar).
     1596     delete object hnode-attr.
     1597     delete object hnode-child.
     1598     delete object hroot.
     1599     delete object hdoc.
     1600   end.
     1601   end procedure.
     1602   procedure gate-clb_fill-xml-tables :
     1603   define input parameter p-dsh as handle no-undo .
     1604   define input-output parameter p-xmlh as handle no-undo .
     1605   define variable v-ii as integer no-undo .
     1606     do
     1607     on error undo, return error
     1608     :
     1609       do v-ii = 1 to p-dsh:num-buffers:
     1610         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1611         if not p-xmlh:available then do:
     1612           p-xmlh:buffer-create().
     1613           assign
     1614           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1615           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1616           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1617           p-xmlh::gate-handle_ = p-dsh
     1618           p-xmlh::uniq-gate-rec = entry(2, p-dsh:private-data, chr(4))
     1619           p-xmlh::gate-name = p-dsh:name
     1620           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1621           .
     1622           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1623             assign
     1624             p-xmlh::order = -3.
     1625           end.
     1626           p-xmlh:buffer-release().
     1627         end.
     1628       end.
     1629     end.
     1630   end procedure.
     1631   procedure all-gates-empty :
     1632   define buffer buf_temp-xml-tables for temp-xml-tables.
     1633   do
     1634   on error undo, return error
     1635   :
     1636     for each buf_temp-xml-tables
