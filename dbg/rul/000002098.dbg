     1099   procedure library-cls_get-handle :
     1100   define input parameter p-library-name as character no-undo .
     1101   define output parameter p-library-handle as handle no-undo .
     1102     do
     1103     on error undo, return error
     1104     :
     1105       CASE p-library-name:
     1106         when "library" then do:
     1107           if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end.
     1108           p-library-handle = g#library.
     1109         end.
     1110         when "library2" then do:
     1111           if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end.
     1112           p-library-handle = g#library2.
     1113         end.
     1114       end case.
     1115     end.
     1116   end procedure.
     1117   def var vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1118   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1119   define variable tempcxml_v-num_ as integer no-undo .
     1120   define shared temp-table temp-xml-tables no-undo
     1121   field order as integer
     1122   field tbl-name as character
     1123   field tbl-handle_ as handle
     1124   field table-handle_ as handle
