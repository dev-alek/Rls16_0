        7   define input parameter parparentproc as widget-handle no-undo .
        8   define input parameter p-parent-handle as handle no-undo .
        9   define input parameter p-log-handle  as handle no-undo .
       10   define input parameter p-cont-handle  as handle no-undo .
       11   define input parameter p-codex-id as integer no-undo .
       12   define input parameter p-ruleset-id as integer no-undo .
       13   define input parameter p-call-id as character no-undo .
       14   define input parameter p-order-id as integer no-undo .
       15   define input parameter p-rule-id as integer no-undo .
       16   define input parameter p-profile-id as integer no-undo .
       17   define input parameter p-is-dynamic as logical no-undo .
       18   define input parameter p-doc-type as character no-undo .
       19   define input parameter p-host-code like ub.sysconf.host-code no-undo .
       20   define input parameter p-obj-type like ub.clients.obj-type no-undo .
       21   define input parameter p-obj-code like ub.clients.obj-code no-undo .
       22   define input parameter p-doc-code as character no-undo .
       23   define input parameter p-process-file-name as character no-undo .
       24   define input parameter p-save       as integer no-undo .
       25   define input parameter v-curr-r-b   as character no-undo .
       26   define input parameter p-cmd-proc-handle as handle no-undo .
       27   define input parameter p-cmd-code  as integer no-undo .
       28   define variable vss-revision    as character no-undo init "$Revision: c05e0a69ef9d, 3077, rls $":U .
       29   define variable vss-author      as character no-undo init "$Author: DRuban $":U .
       30   define variable vss-date        as character no-undo init "$Date: Пт авг 05 19:16:16 2022 +0300 $":U .
       31   define variable vss-workfile    as character no-undo init "$Workfile: 000002098.p $":U .
       32   define variable vss-archive     as character no-undo init "$Archive: rul/000002098.p $":U .
       33   define variable vss-description as character no-undo init "Библиотека процедур для работы с кодексом 20 набор правил 4".
       34   procedure vss-get-info :
       35     define output parameter p-vss-revision    like vss-revision    no-undo .
       36     define output parameter p-vss-author      like vss-author      no-undo .
       37     define output parameter p-vss-date        like vss-date        no-undo .
       38     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       39     define output parameter p-vss-archive     like vss-archive     no-undo .
       40     define output parameter p-vss-description like vss-description no-undo .
