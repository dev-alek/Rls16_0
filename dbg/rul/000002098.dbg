     2477   procedure fill-g-list :
     2478   define input parameter p-gds-code as integer no-undo .
     2479   define input parameter p-obj-type as character no-undo .
     2480   define input parameter p-obj-code as integer no-undo .
     2481   define buffer buf_goods for ub.goods.
     2482   do
     2483   on error undo, return error
     2484   :
     2485     find first gds-list where
     2486               gds-list.gds-code = p-gds-code no-error .
     2487     if not avail gds-list then do:
     2488       if p-obj-type = 'маг':U then do:
     2489         find first gdsolist where
     2490                   gdsolist.gds-code = p-gds-code
     2491             AND  gdsolist.obj-type = p-obj-type
     2492             AND  gdsolist.obj-code = p-obj-code   no-error .
     2493       end.
     2494       else do:
     2495         find first buf_goods no-lock where
     2496                     buf_goods.gds-code = p-gds-code no-error .
     2497         create gds-list.
     2498         buffer-copy buf_goods to gds-list.
     2499       end.
     2500     end.
     2501     if p-obj-type = 'маг':U and not avail gdsolist then do:
     2502       find first gdsolist where
     2503                 gdsolist.gds-code = p-gds-code
     2504           AND  gdsolist.obj-type = p-obj-type
     2505           AND  gdsolist.obj-code = p-obj-code   no-error .
     2506       if not available gdsolist then do:
     2507         find first buf_goods no-lock where
     2508                     buf_goods.gds-code = p-gds-code no-error .
     2509         if avail buf_goods then do:
     2510           create gdsolist.
     2511           buffer-copy buf_goods to gdsolist
     2512           assign
     2513           gdsolist.obj-type = p-obj-type
     2514           gdsolist.obj-code = p-obj-code
     2515           .
     2516         end.
     2517       end.
     2518     end.
     2519     if avail gdsolist then do:
     2520       assign
     2521       gdsolist.to-del = no
     2522       .
     2523       release gdsolist.
     2524     end.
     2525     if avail gds-list then do:
     2526       assign
     2527       gds-list.to-del = no
     2528       .
     2529       release gds-list.
     2530     end.
     2531   end.
     2532   end procedure.
     2533   procedure fill-cash-txn :
     2534   define parameter buffer buf_tax for ub.tax.
     2535   do
     2536   on error undo, return error
     2537   :
     2538     if not can-find( cash-txn where
     2539                     cash-txn.tax-code = buf_tax.tax-code
     2540                 and cash-txn.tax-name = buf_tax.tax-name
     2541                    ) then do:
     2542       create cash-txn.
     2543       assign
     2544       cash-txn.tax-code = buf_tax.tax-code
     2545       cash-txn.tax-name = buf_tax.tax-name
     2546       .
     2547       release cash-txn.
     2548     end.
     2549   end.
     2550   end procedure.
     2551   procedure fill-cash-txr :
     2552   define input parameter p-tax-code as integer no-undo .
     2553   define input parameter p-rate-code as integer no-undo .
     2554   define input parameter p-status_ as character no-undo .
     2555   define input parameter p-host-code as integer no-undo .
     2556   define input parameter p-obj-type as character no-undo .
     2557   define input parameter p-obj-code as integer no-undo .
     2558   define input parameter p-tax-type as character no-undo .
     2559   define input parameter p-value as decimal no-undo .
     2560   define input parameter p-crf as integer no-undo .
     2561   define input parameter p-rec as recid no-undo .
     2562   define buffer buf_tax for ub.tax.
     2563   do
     2564   on error undo, return error
     2565   :
     2566     find first cash-txr where
     2567             cash-txr.tax-code = p-tax-code
     2568         AND cash-txr.host-code = p-host-code
     2569         AND cash-txr.rate-code = p-rate-code
     2570         AND cash-txr.obj-type = p-obj-type
     2571         AND cash-txr.obj-code = p-obj-code
     2572         AND cash-txr.rc = p-rec no-error .
     2573     if not avail cash-txr then do:
     2574       find first  cash-txn where
     2575                       cash-txn.tax-code = p-tax-code no-error .
     2576       if not available cash-txn then do:
     2577         find first buf_tax no-lock where buf_tax.tax-code = p-tax-code.
     2578         create cash-txn.
     2579         assign
     2580         cash-txn.tax-code = buf_tax.tax-code
     2581         cash-txn.tax-name = buf_tax.tax-name
     2582         .
     2583         release cash-txn.
     2584         define variable II as integer no-undo.
     2585         find last  cash-txr where cash-txr.crf > 0 no-error.
     2586         if available cash-txr
     2587         then
     2588            II = cash-txr.crf + 1.
     2589         else
     2590            II = 1.
     2591            _tax-rate:
     2592         FOR EACH ub.tax-rate NO-LOCK WHERE
     2593                             ub.tax-rate.tax-code = buf_tax.tax-code
     2594                         and ub.tax-rate.status_  <>   'удал':U:
     2595                           create cash-txr.
     2596                           assign
     2597                           cash-txr.tax-code = tax-rate.tax-code
     2598                           cash-txr.rate-code = tax-rate.rate-code
     2599                           cash-txr.tax-type = buf_tax.tax-type
     2600                           cash-txr.host-code = p-host-code
     2601                           cash-txr.obj-type = p-obj-type
     2602                           cash-txr.obj-code = p-obj-code
     2603                           cash-txr.status_ = tax-rate.status_
     2604                           cash-txr.rc = RECID(tax-rate)
     2605                           cash-txr.crf = ii
     2606                           ii = ii + 1
     2607                           .
     2608   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2609   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftaxval in g#library
     2610     (input  recid(ub.tax-rate)
     2611     ,input  0
     2612     ,input  0
     2613     ,input  ?
     2614     ,input  p-host-code
     2615     ,input  p-obj-type
     2616     ,input  p-obj-code
     2617     ,output cash-txr.rate-value
     2618     ) no-error .
     2619                           if error-status:error then next _tax-rate.
     2620          END.
     2621       end.
     2622       else do:
     2623          for each cash-txr where cash-txr.tax-code = tax-rate.tax-code:
     2624             delete cash-txr.
     2625          end.
     2626          _tax-rate2:
     2627           FOR EACH ub.tax-rate NO-LOCK WHERE
     2628                             ub.tax-rate.tax-code = buf_tax.tax-code
     2629                         and ub.tax-rate.status_  <>   'удал':U:
     2630                           create cash-txr.
     2631                           assign
     2632                           cash-txr.tax-code = tax-rate.tax-code
     2633                           cash-txr.rate-code = tax-rate.rate-code
     2634                           cash-txr.tax-type = buf_tax.tax-type
     2635                           cash-txr.host-code = p-host-code
     2636                           cash-txr.obj-type = p-obj-type
     2637                           cash-txr.obj-code = p-obj-code
     2638                           cash-txr.status_ = tax-rate.status_
     2639                           cash-txr.rc = RECID(tax-rate)
     2640                           cash-txr.crf = ii
     2641                           ii = ii + 1
     2642                           .
     2643   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2644   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftaxval in g#library
     2645     (input  recid(ub.tax-rate)
     2646     ,input  0
     2647     ,input  0
     2648     ,input  ?
     2649     ,input  p-host-code
     2650     ,input  p-obj-type
     2651     ,input  p-obj-code
     2652     ,output cash-txr.rate-value
     2653     ) no-error .
     2654                           if error-status:error then next _tax-rate2.
     2655          END.
     2656       end.
     2657       find first cash-txr where
     2658             cash-txr.tax-code = p-tax-code
     2659         AND cash-txr.rate-code = p-rate-code
     2660         no-error .
     2661       if not avail cash-txr and  p-status_ <> 'удал':U
     2662       then do:
     2663          create cash-txr.
     2664          assign
     2665          cash-txr.tax-code  = p-tax-code
     2666          cash-txr.rate-code = p-rate-code
     2667          cash-txr.host-code = p-host-code
     2668          cash-txr.obj-type  = p-obj-type
     2669          cash-txr.obj-code  = p-obj-code
     2670          cash-txr.tax-type  = p-tax-type
     2671          cash-txr.crf       = p-crf
     2672          cash-txr.rc        = p-rec
     2673          cash-txr.status_   = (if p-status_ = ? then 'тек':U else p-status_)
     2674          .
     2675       end.
     2676       if  avail cash-txr
     2677       then do:
     2678          if p-status_ eq 'удал':U
     2679          then
     2680             delete cash-txr.
     2681          else assign
     2682          cash-txr.tax-code  = p-tax-code
     2683          cash-txr.rate-code = p-rate-code
     2684          cash-txr.host-code = p-host-code
     2685          cash-txr.obj-type  = p-obj-type
     2686          cash-txr.obj-code  = p-obj-code
     2687          cash-txr.tax-type  = p-tax-type
     2688          cash-txr.crf       = p-crf
     2689          cash-txr.rc        = p-rec
     2690          cash-txr.status_   = (if p-status_ = ? then 'тек':U else p-status_)
     2691          .
     2692       end.
     2693       release cash-txr.
     2694     end.
     2695   end.
     2696   end procedure.
     2697   procedure fill-stpl-list :
     2698   define parameter buffer buf_stop-list for ub.stop-list.
     2699   do
     2700   on error undo, return error
     2701   :
     2702     find first stpl-list where
     2703               stpl-list.classif-type =  buf_stop-list.classif-type
     2704           and stpl-list.stop-list-code = buf_stop-list.stop-list-code no-error .
     2705     if not avail stpl-list then do:
     2706       create stpl-list.
     2707       buffer-copy buf_stop-list
     2708       to stpl-list.
     2709       release stpl-list.
     2710     end.
     2711   end.
     2712   end procedure.
     2713   procedure fill-pbc-list :
     2714   define input parameter p-rc as recid no-undo .
     2715   define input parameter p-gds-code as integer no-undo .
     2716   define input parameter p-b-code as integer no-undo .
     2717   define input parameter p-b-str as character no-undo .
     2718   define input parameter p-bc-on as logical no-undo .
     2719   define input parameter p-del as logical no-undo .
     2720   do
     2721   on error undo, return error
     2722   :
     2723     if p-bc-on = false
     2724     or p-del = yes
     2725     or not can-find(gds-list where gds-list.gds-code     = p-gds-code
     2726                               no-lock ) then do:
     2727       find first pbc-list where pbc-list.rc = p-rc no-error.
     2728       if not available pbc-list then do:
     2729         create pbc-list.
     2730       end.
     2731       assign
     2732       pbc-list.b-code = p-b-code
     2733       pbc-list.b-str = p-b-str
     2734       pbc-list.rc = p-rc
     2735       pbc-list.bc-on = p-bc-on
     2736       pbc-list.del = p-del
     2737       .
     2738       release pbc-list .
     2739     end.
     2740   end.
     2741   end procedure.
     2742   procedure fill-bar-code :
     2743   define input parameter p-b-code as integer no-undo .
     2744   define input parameter p-gds-code as integer no-undo .
     2745   define input parameter p-del as logical no-undo .
     2746   define input parameter p-node-code as integer no-undo .
     2747   define input parameter p-in-code as character no-undo .
     2748   define input parameter p-part-code as character no-undo .
     2749   define input parameter p-cli-base-rate as decimal no-undo .
     2750   define input parameter p-unit-cli as character no-undo .
     2751   do
     2752   on error undo, return error
     2753   :
     2754     if p-del = yes
     2755     or not can-find(gds-list where gds-list.gds-code     = p-gds-code
     2756                               no-lock ) then do:
     2757       find first bc-list where
     2758               bc-list.b-code = p-b-code and bc-list.del = p-del no-error.
     2759       if not avail bc-list then do:
     2760         create bc-list.
     2761         assign
     2762         bc-list.gds-code = p-gds-code
     2763         bc-list.b-code = p-b-code
     2764         bc-list.node-code = p-node-code
     2765         bc-list.in-code = p-in-code
     2766         bc-list.part-code = p-part-code
     2767         bc-list.cli-base-rate = p-cli-base-rate
     2768         bc-list.unit-cli = p-unit-cli
     2769         bc-list.del = p-del
     2770         .
     2771       end.
     2772     end.
     2773   end.
     2774   end procedure.
     2775   procedure fill-pdf :
     2776   define input parameter p-plt-id as integer no-undo .
     2777   define input parameter p-plt-db-num as integer no-undo .
     2778   define input parameter p-pdf-id as integer no-undo .
     2779   define input parameter p-pdf-db-num as integer no-undo .
     2780   define input parameter p-del as logical no-undo .
     2781   define buffer buf_pdf-list for pdf-list.
     2782   do
     2783   on error undo, return error
     2784   :
     2785     find first pdf-list where
     2786              pdf-list.plt-id = p-plt-id
     2787          and pdf-list.plt-db-num = p-plt-db-num
     2788          and pdf-list.pdf-id = p-pdf-id
     2789          and pdf-list.pdf-db = p-pdf-db-num no-error.
     2790     if not available pdf-list then do:
     2791       find last buf_pdf-list use-index oi no-error.
     2792       create pdf-list.
     2793       assign
     2794       pdf-list.plt-id = p-plt-id
     2795       pdf-list.plt-db-num = p-plt-db-num
     2796       pdf-list.pdf-id = p-pdf-id
     2797       pdf-list.pdf-db = p-pdf-db-num
     2798       pdf-list.to-del = p-del
     2799       pdf-list.order-num = (if available buf_pdf-list then buf_pdf-list.order-num + 1 else 1)
     2800       .
     2801       release pdf-list.
     2802     end.
     2803   end.
     2804   end procedure.
     2805   define temp-table temp-asmg no-undo
     2806   field gds-code as integer
     2807   field asmg-des as character
     2808   field obj-type  as character
     2809   field gdop-igt as character
     2810   field gdop-assort-min as logical
     2811   field obj-code as integer
     2812   field mode as character
     2813   index pi obj-code obj-type
     2814   .
     2815   define variable v-current-host-code as integer no-undo .
     2816   define variable v-current-obj-type as character no-undo .
     2817   define variable v-current-obj-code as integer no-undo .
     2818   define variable v-current-doc-code as character no-undo .
     2819   define variable v-current-doc-date as date no-undo .
     2820   define variable v-current-doc-type as character no-undo .
     2821   define variable v-current-doc-time as integer no-undo .
     2822   define variable v-current-lock as integer no-undo .
     2823   define variable v-current-wait as integer no-undo .
     2824   define variable v-save as integer no-undo .
     2825   define variable v-current-db-num as integer no-undo .
     2826   define variable v-current-date as date no-undo .
     2827   define variable v-sign as integer no-undo .
     2828   define variable file-name as char.
     2829   define variable num-rec as integer no-undo .
     2830   define variable num-rec-ok as integer no-undo .
     2831   define variable num-rec-ok2 as integer no-undo .
     2832   define variable v-full-path        as character no-undo .
     2833   define variable v-path             as character no-undo .
     2834   define variable v-file-name        as character no-undo .
     2835   define variable v-file-name-no-ext as character no-undo .
     2836   define variable v-file-name-ext    as character no-undo .
     2837   define variable v-end-new-line     as logical no-undo .
     2838   define variable v-last-error-message as character no-undo .
     2839   define variable v-retry-action as integer no-undo .
     2840   define variable v-xmlh as handle no-undo .
     2841   define variable v_qh as handle no-undo .
     2842   define variable glog as logical no-undo .
     2843   define variable v-ds-read-order as character no-undo .
     2844   define variable v-esys-id as integer no-undo .
     2845   define variable v-err-message as character no-undo .
     2846   define variable v-pack-num as character no-undo .
     2847   define new shared variable g#LogStr as character no-undo.
     2848   define variable v-oxml-log-name as character no-undo .
     2849   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2850   procedure set-error :
     2851   define input parameter p-mess as character no-undo .
     2852     do
     2853     on error undo, return error
     2854     :
     2855        assign
     2856        v-last-error-message = p-mess.
     2857     end.
     2858   end procedure.
     2859   define buffer buf_temp-cmd for temp-cmd.
     2860   define temp-table temp-rule-call-param no-undo like ub.rule-call-param.
     2861   define buffer buf_temp-rule-call-param for temp-rule-call-param.
     2862   define buffer buf_temp-xml-tables for temp-xml-tables.
     2863   define variable log-file-name                as character      no-undo init "imp-1crn.txt".
     2864   define variable v-view-log                   as logical        no-undo .
     2865   define variable v-stop                       as logical        no-undo .
     2866   function 00200004_get-error-message returns character :
     2867   define variable v-ii as integer no-undo .
     2868   define variable v-mess as character no-undo .
     2869   do v-ii = 1 to error-status:num-messages:
     2870       v-mess = substitute("&1&2ош &3"
     2871                           ,v-mess
     2872                           ,chr(10)
     2873                           ,error-status:get-message(v-ii)).
     2874   end.
     2875   end function.
     2876   function notnull returns character (input str as character):
     2877   if str = ? then return "" . else return str .
     2878   end function.
     2879   function get-time returns character(p-time as integer):
     2880       return string(p-time, "HH:MM:SS").
     2881   end.
     2882   function get-date returns character(p-date as date):
     2883       return subst("&1.&2.&3", string(day(p-date), "99"), string(month(p-date), "99"), string(year(p-date), "9999")).
     2884   end.
     2885     define variable p-esys-id     as integer   no-undo .
     2886     define variable p-sub-type    as character no-undo.
     2887     define variable p-reciever-id as character no-undo .
     2888     define variable p-sender-id   as character no-undo.
     2889   define variable v-attr-type        as character no-undo . // для чтения значений из ext-system-attr
     2890   define variable v-cert-enstr       as character no-undo . // чтение v-cert-enabled строкой
     2891   define variable v-cert-enabled     as logical no-undo . // true - добавить цифровую подпись
     2892   define variable v-cert-issuer-name as character no-undo .
     2893   define variable v-cert-subj-name   as character no-undo .
     2894   define variable v-sign-fileext     as character no-undo .
     2895   define variable v-cert-repository  as integer no-undo .
     2896   define variable v-pkcs             as class ibs.th.gbl.pkcs no-undo .
     2897   on delete of this-procedure do:
     2898     run delete-procedure in this-procedure .
     2899   end.
     2900   run load-ruleset-context in this-procedure ( input p-ruleset-id) no-error .
     2901   if error-status:error
     2902   or return-value = "return" then return.
     2903   if not this-procedure:persistent then do:
     2904     run proc-main in this-procedure  no-error .
     2905     if error-status:error then do:
     2906         v-err-message = return-value.
     2907         run delete-procedure in this-procedure .
     2908         undo, return error v-err-message.
     2909     end.
     2910     run delete-procedure in this-procedure .
     2911   end.
     2912   define variable mySeqUtd as int64 no-undo init ?.
     2913   define variable myStopGroucRec as logical no-undo init yes .
     2914   procedure startStop:
     2915      myStopGroucRec = not myStopGroucRec.
     2916      if not myStopGroucRec
     2917      then
     2918         mySeqUtd = ?.
     2919   end.
     2920   procedure MySeqTable:
     2921      define input  parameter iTable       as character no-undo.
     2922      define input  parameter iseqnamehist as character no-undo.
     2923      define input  parameter idb-name     as character no-undo.
     2924      define output parameter Oseq         as int64 no-undo.
     2925      if myStopGroucRec
     2926      then
     2927         Oseq = ?.
     2928      else if iTable begins "utd"
     2929      then do:
     2930         if myseqUtd eq ?
     2931         then
     2932            myseqUtd = dynamic-next-value(iseqnamehist,idb-name).
     2933         Oseq = myseqUtd.
     2934      end.
     2935      else
     2936         Oseq = ?.
     2937      return.
     2938   end.
     2939   define stream sReadfile.
     2940   procedure proc-main :
     2941   define variable v-ii as integer   no-undo .
     2942   define variable v-current-b-code as integer no-undo .
     2943   define buffer buf_ext-system for ub.ext-system.
     2944   define variable v-sender-id as character no-undo .
     2945   define variable v-type as character no-undo .
     2946   _main:
     2947   do
     2948   on error  undo _main, return error substitute( "&1. &2&3&4&3&5", vss-workfile, return-value, chr(10), error-status :get-message (1),v-err-message)
     2949   on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
     2950   on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
     2951   :
     2952   run write-log  in p-log-handle (
     2953                                    input 0
     2954                                  , "&DLine").
     2955     run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute(".............Импорт данных по пакету 1С (РОСНФЕТЬ) из ВС")) .                     if v-oxml-log-name > ''                            then do :                                            run writelog in p-log-handle (                         input v-oxml-log-name                            , input 1                                          , input substitute(".............Импорт данных по пакету 1С (РОСНФЕТЬ) из ВС")) .                     end.
     2956       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Импорт данных по пакету 1С (РОСНФЕТЬ) из файла &1", file-name)) .                     if v-oxml-log-name > ''                            then do :                                            run writelog in p-log-handle (                         input v-oxml-log-name                            , input 1                                          , input substitute("Импорт данных по пакету 1С (РОСНФЕТЬ) из файла &1", file-name)) .                     end.
     2957       find first buf_ext-system no-lock where
     2958                 buf_ext-system.esys-id = v-esys-id
     2959             and buf_ext-system.db-num = 0 no-error.
     2960       if not available buf_ext-system
     2961       or not (buf_ext-system.esys-type  > integer('0':U)) then do:
     2962              run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не найдена ВС &1 или она не имеет типа СПЕЦИАЛЬНАЯ", v-esys-id)) .                     if v-oxml-log-name > ''                            then do :                                            run writelog in p-log-handle (                         input v-oxml-log-name                            , input 1                                          , input substitute("Не найдена ВС &1 или она не имеет типа СПЕЦИАЛЬНАЯ", v-esys-id)) .                     end.
     2963          undo _main, return error ''.
     2964       end.
     2965       run db-attr-value in this-procedure
     2966              (input ibs.th.gbl.gbl-var:g#db-num
     2967              ,input 'int-point':U
     2968              ,output v-sender-id
     2969              ,output v-type
     2970              ) no-error .
     2971     run str/imp2cdseth.p(this-procedure).
     2972     ibs.th.bge.1crn.import.impmsgs:clearMsg().
     2973     do transaction:
     2974       v-err-message = "" .
     2975       subscribe "getNextseq" anywhere run-procedure "MySeqTable".
     2976       subscribe "startStopGroupRec" anywhere run-procedure "startStop".
     2977       MySeqUtd = ?.
     2978       output to "oxmerrprogres.log".
     2979       parseSubObj = new parsesub ().
     2980       parseSubObj:setParent(parparentproc, p-parent-handle, p-log-handle) .
     2981       impSubObj = new impsubject (parseSubObj).
     2982       parseSubObj:Parse1CRNSub(file-name).
     2983       unsubscribe "startStopGroupRec".
     2984       unsubscribe "getNextseq" .
     2985                 run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("пакет из файла &1 обработан без ошибок", file-name)) .                     if v-oxml-log-name > ''                            then do :                                            run writelog in p-log-handle (                         input v-oxml-log-name                            , input 1                                          , input substitute("пакет из файла &1 обработан без ошибок", file-name)) .                     end.
     2986       // ack_ со статусом Ok отправится только если всё выполнилось без ошибок
     2987       run rul/send-ack_1c.p ( input v-sender-id
     2988                             , input v-pack-num
     2989                              ,input 0
     2990                              ,input ""
     2991                              ,input buf_ext-system.esys-id
     2992                              ,input v-cert-subj-name
     2993                              ,input v-cert-issuer-name
     2994                              ,input v-sign-fileext
     2995                              ,input v-cert-repository
     2996                              ,input v-pkcs
     2997                             ) .
     2998           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("создан ack_ со статусом Ok в exch &1 - ES &2 по пакету N&3", g#db-num, buf_ext-system.esys-id, v-pack-num)) .                     if v-oxml-log-name > ''                            then do :                                            run writelog in p-log-handle (                         input v-oxml-log-name                            , input 1                                          , input substitute("создан ack_ со статусом Ok в exch &1 - ES &2 по пакету N&3", g#db-num, buf_ext-system.esys-id, v-pack-num)) .                     end.
     2999       v-err-message = "" .
     3000       catch exAppErrors as class Progress.Lang.AppError :
     3001         v-err-message = trim(parseSubObj:Msg, ";") .
     3002         v-err-message = trim(v-err-message) .
     3003         v-err-message = trim(v-err-message, ";") .
     3004         put skip.
     3005         output close.
     3006         define variable vStr as character no-undo.
     3007         input STREAM sReadfile FROM  "oxmerrprogres.log".
     3008         repeat:
     3009            import stream sReadfile unformatted vStr.
     3010                     run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input vStr) .                     if v-oxml-log-name > ''                            then do :                                            run writelog in p-log-handle (                         input v-oxml-log-name                            , input 1                                          , input vStr) .                     end.
     3011         end.
     3012         run rul/send-ack_1c.p ( input v-sender-id
     3013                               , input v-pack-num
     3014                                 ,input 4
     3015                                 ,input v-err-message
     3016                                 ,input buf_ext-system.esys-id
     3017                                 ,input v-cert-subj-name
     3018                                 ,input v-cert-issuer-name
     3019                                 ,input v-sign-fileext
     3020                                 ,input v-cert-repository
     3021                                 ,input v-pkcs
     3022                                 ) no-error .
     3023         if error-status:error then do :
     3024               v-err-message = substitute("Ошибка при отправке ack_ на ошибку сохранения данных по пакету 1С (РОСНФЕТЬ) из ВС") .
     3025         run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при отправке ack_ на ошибку сохранения данных по пакету 1С (РОСНФЕТЬ) из ВС")) .                     if v-oxml-log-name > ''                            then do :                                            run writelog in p-log-handle (                         input v-oxml-log-name                            , input 1                                          , input substitute("Ошибка при отправке ack_ на ошибку сохранения данных по пакету 1С (РОСНФЕТЬ) из ВС")) .                     end.
     3026         end .
     3027       end catch .
     3028       catch exProErrors as class Progress.Lang.ProError :
     3029         undo, throw exProErrors .
     3030       end catch .
     3031       catch exAnyErrors as class Progress.Lang.Error:
     3032         undo, throw exAnyErrors .
     3033       end catch .
     3034       finally :
     3035         delete object parseSubObj no-error.
     3036         put skip.
     3037         output close.
     3038         delete object impSubObj no-error.
     3039         if valid-object(v-pkcs) then delete object v-pkcs .
     3040         if v-err-message > "" then return error v-err-message .
     3041       end finally .
     3042     end.
     3043     run send-to-cash in this-procedure no-error.
     3044   end.
     3045   end procedure.
     3046   procedure load-ruleset-context :
     3047   define input parameter p-ruleset-id as integer no-undo .
     3048   define buffer buf_rule-call-param for ub.rule-call-param.
     3049   define variable v-itop as integer   no-undo .
     3050   define variable v-ichild as integer   no-undo .
     3051   define variable v-pck-num as integer no-undo .
     3052   define variable v-my-message as character no-undo .
     3053   define buffer buf_esys-pck-keys for ub.esys-pck-keys.
     3054   define buffer buf_ext-system for ub.ext-system.
     3055     do
     3056     on error undo, return error
     3057     :
     3058    find first buf_rule-call-param no-lock where
     3059   buf_rule-call-param.codex_id = p-codex-id
     3060   and buf_rule-call-param.ruleset_id = p-ruleset-id
     3061   and buf_rule-call-param.call_id = p-call-id
     3062   and buf_rule-call-param.order_id = p-order-id
     3063   and buf_rule-call-param.rule_id = p-rule-id
     3064   and buf_rule-call-param.param-name = "p-esys-id"
     3065    no-error.
     3066   if available buf_rule-call-param then do:
     3067   assign p-esys-id = buf_rule-call-param.param-value-integer.
     3068   end.
     3069    find first buf_rule-call-param no-lock where
     3070   buf_rule-call-param.codex_id = p-codex-id
     3071   and buf_rule-call-param.ruleset_id = p-ruleset-id
     3072   and buf_rule-call-param.call_id = p-call-id
     3073   and buf_rule-call-param.order_id = p-order-id
     3074   and buf_rule-call-param.rule_id = p-rule-id
     3075   and buf_rule-call-param.param-name = "p-sub-type"
     3076    no-error.
     3077   if available buf_rule-call-param then do:
     3078   assign p-sub-type = buf_rule-call-param.param-value-character.
     3079   end.
     3080    find first buf_rule-call-param no-lock where
     3081   buf_rule-call-param.codex_id = p-codex-id
     3082   and buf_rule-call-param.ruleset_id = p-ruleset-id
     3083   and buf_rule-call-param.call_id = p-call-id
     3084   and buf_rule-call-param.order_id = p-order-id
     3085   and buf_rule-call-param.rule_id = p-rule-id
     3086   and buf_rule-call-param.param-name = "p-sender-id"
     3087    no-error.
     3088   if available buf_rule-call-param then do:
     3089   assign p-sender-id = buf_rule-call-param.param-value-character.
     3090   end.
     3091    find first buf_rule-call-param no-lock where
     3092   buf_rule-call-param.codex_id = p-codex-id
     3093   and buf_rule-call-param.ruleset_id = p-ruleset-id
     3094   and buf_rule-call-param.call_id = p-call-id
     3095   and buf_rule-call-param.order_id = p-order-id
     3096   and buf_rule-call-param.rule_id = p-rule-id
     3097   and buf_rule-call-param.param-name = "p-reciever-id"
     3098    no-error.
     3099   if available buf_rule-call-param then do:
     3100   assign p-reciever-id = buf_rule-call-param.param-value-character.
     3101   end.
     3102       case p-ruleset-id:
     3103         when 4 then do:
     3104           assign
     3105           v-sign = 1
     3106           v-current-host-code = p-host-code
     3107           v-current-obj-type = p-obj-type
     3108           v-current-obj-code = p-obj-code
     3109           v-current-doc-code = p-doc-code
     3110           v-current-db-num = g#db-num
     3111           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     3112           file-name  = entry(2, p-process-file-name, chr(4))
     3113           v-esys-id = integer(trim(p-doc-code))
     3114           no-error
     3115          .
     3116          v-pack-num = entry(3, entry(num-entries(file-name, "\"), file-name, "\") ,"_") no-error.
     3117          v-oxml-log-name = entry(4, p-process-file-name, chr(4)) no-error .
     3118           find first buf_ext-system no-lock where
     3119                     buf_ext-system.esys-id = v-esys-id
     3120                 and buf_ext-system.db-num = 0 no-error .
     3121           if not available buf_ext-system
     3122           or buf_ext-system.esys-type <> integer('1':U)
     3123           then do:
     3124                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не найдена ВС &1&2пропускаем ..."                                         , v-esys-id                                         , chr(10)                                         )) .                     if v-oxml-log-name > ''                            then do :                                            run writelog in p-log-handle (                         input v-oxml-log-name                            , input 1                                          , input substitute("Не найдена ВС &1&2пропускаем ..."                                         , v-esys-id                                         , chr(10)                                         )) .                     end.
     3125             undo, return error substitute("Не найдена ВС &1&2пропускаем ..."                                         , v-esys-id                                         , chr(10)                                         ).
     3126           end.
     3127           run ext-system-attr-value in this-procedure (
     3128                                         input  buf_ext-system.esys-id
     3129                                        ,input  buf_ext-system.db-num
     3130                                        ,input  'cert-sign':U
     3131                                        ,output v-cert-enstr
     3132                                        ,output v-attr-type) no-error .
     3133           if not error-status:error then v-cert-enabled = logical (v-cert-enstr) no-error .
     3134           if error-status:error then do:
     3135             v-my-message = substitute("Ошибка чтения параметра &1 настроек ВС &2&3&4&3&5&3пропускаем ..."
     3136                                           , 'cert-sign':U
     3137                                           , v-esys-id
     3138                                           , chr(10)
     3139                                           ,error-status:get-message(error-status:num-messages)
     3140                                           ,return-value
     3141                                      ) .
     3142                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input v-my-message) .                     if v-oxml-log-name > ''                            then do :                                            run writelog in p-log-handle (                         input v-oxml-log-name                            , input 1                                          , input v-my-message) .                     end.
     3143             undo, return error v-my-message.
     3144           end.
     3145           if v-cert-enabled then do :
     3146           run ext-system-attr-value in this-procedure (
     3147                                         input  buf_ext-system.esys-id
     3148                                        ,input  buf_ext-system.db-num
     3149                                        ,input  'cert-sign-issuer':U
     3150                                        ,output v-cert-issuer-name
     3151                                        ,output v-attr-type) no-error .
     3152           if not error-status:error then
     3153           run ext-system-attr-value in this-procedure (
     3154                                         input  buf_ext-system.esys-id
     3155                                        ,input  buf_ext-system.db-num
     3156                                        ,input  'cert-sign-subject':U
     3157                                        ,output v-cert-subj-name
     3158                                        ,output v-attr-type) no-error .
     3159           if not error-status:error then
     3160           run ext-system-attr-value in this-procedure (
     3161                                         input  buf_ext-system.esys-id
     3162                                        ,input  buf_ext-system.db-num
     3163                                        ,input  'cert-file-ext':U
     3164                                        ,output v-sign-fileext
     3165                                        ,output v-attr-type) no-error .
     3166           if error-status:error then do:
     3167                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка чтения настроек ЭЦП для ВС &1&2пропускаем ..."                                         , v-esys-id                                         , chr(10)                                         )) .                     if v-oxml-log-name > ''                            then do :                                            run writelog in p-log-handle (                         input v-oxml-log-name                            , input 1                                          , input substitute("Ошибка чтения настроек ЭЦП для ВС &1&2пропускаем ..."                                         , v-esys-id                                         , chr(10)                                         )) .                     end.
     3168             undo, return error substitute("Ошибка чтения настроек ЭЦП для ВС &1&2пропускаем ..."                                         , v-esys-id                                         , chr(10)                                         ).
     3169           end.
     3170           v-cert-repository = ? .
     3171           run ext-system-attr-value in this-procedure (
     3172                                     input  buf_ext-system.esys-id
     3173                                    ,input  buf_ext-system.db-num
     3174                                    ,input  'cert-repository':U
     3175                                    ,output v-cert-enstr
     3176                                    ,output v-attr-type) no-error .
     3177           if v-cert-enstr > ""
     3178           then
     3179             v-cert-repository = integer(v-cert-enstr) no-error .
     3180           if v-cert-repository = ?
     3181           then
     3182             v-cert-repository = 0 .
     3183           if v-cert-subj-name > "" then . else do :
     3184                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Отсутствует имя Владельца сертификата в параметрах настройки внешней системы ВС &1&2пропускаем ..."                                         , v-esys-id                                         , chr(10)                                         )) .                     if v-oxml-log-name > ''                            then do :                                            run writelog in p-log-handle (                         input v-oxml-log-name                            , input 1                                          , input substitute("Отсутствует имя Владельца сертификата в параметрах настройки внешней системы ВС &1&2пропускаем ..."                                         , v-esys-id                                         , chr(10)                                         )) .                     end.
     3185             undo, return error substitute("Отсутствует имя Владельца сертификата в параметрах настройки внешней системы ВС &1&2пропускаем ..."                                         , v-esys-id                                         , chr(10)                                         ).
     3186           end .
     3187           if v-cert-issuer-name > "" then . else do :
     3188                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Отсутствует имя Издателя сертификата в параметрах настройки внешней системы ВС &1&2пропускаем ..."                                         , v-esys-id                                         , chr(10)                                         )) .                     if v-oxml-log-name > ''                            then do :                                            run writelog in p-log-handle (                         input v-oxml-log-name                            , input 1                                          , input substitute("Отсутствует имя Издателя сертификата в параметрах настройки внешней системы ВС &1&2пропускаем ..."                                         , v-esys-id                                         , chr(10)                                         )) .                     end.
     3189             undo, return error substitute("Отсутствует имя Издателя сертификата в параметрах настройки внешней системы ВС &1&2пропускаем ..."                                         , v-esys-id                                         , chr(10)                                         ).
     3190           end .
     3191           v-pkcs = new ibs.th.gbl.pkcs().
     3192         end .
     3193         else assign
     3194           v-cert-issuer-name = ""
     3195           v-cert-subj-name   = ""
     3196           v-sign-fileext     = ""
     3197         .
     3198         end. // end_of &thref-proc_20_xml-esys-import
     3199         otherwise do:
     3200           undo, return error "Неправильный вызов".
     3201         end.
     3202       end case.
     3203     end.
     3204   end procedure.
     3205   procedure delete-procedure :
     3206     do
     3207     on error undo, return error
     3208     :
     3209         run garbcoll_clear in this-procedure .
     3210     end.
     3211   end procedure.
     3212   procedure pcall-log-file :
     3213   define input  parameter p-message as character no-undo .
     3214     do
     3215     on error undo, return error return-value
     3216     :
     3217       run write-log-and-file in p-log-handle (
     3218             input 1
     3219           , input log-file-name
     3220           , input 1
     3221           , input p-message ) .
     3222     end.
     3223   end procedure.
     3224   procedure cre-status :
     3225     define variable hSAXWriter as handle no-undo.
     3226     define variable v-str as character no-undo.
     3227     define variable v-dt-1c as character no-undo.
     3228     define variable dir_crt as logical no-undo.
     3229   end.
