      103   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      104   define  variable garbcoll_ii as integer no-undo .
      105   define  temp-table temp-gc no-undo
      106   field ii as integer
      107   field obj-r as handle
      108   field cn as character
      109   index pi is unique primary
      110   ii
      111   index icn
      112   cn.
      113   procedure garbcoll_create-gc-entry :
      114   define input parameter p-cn as character no-undo .
      115   define input parameter p-obj-r as handle no-undo .
      116     do
      117     on error undo, return error
      118     :
      119       create temp-gc.
      120       assign
      121       temp-gc.ii = garbcoll_ii
      122       garbcoll_ii = garbcoll_ii + 1
      123       temp-gc.cn = p-cn
      124       temp-gc.obj-r = p-obj-r
      125       .
      126     end.
      127   end procedure.
      128   procedure garbcoll_clear :
      129     do
      130     on error undo, return error
      131     :
      132       for each temp-gc:
      133         delete object temp-gc.obj-r.
      134         delete temp-gc.
      135       end.
      136     end.
      137   end procedure.
      138   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      139   procedure cur-time :
      140      define output parameter p-today as date      no-undo .
      141      define output parameter p-time  as integer   no-undo .
      142     do
      143     on error undo, return error
      144     :
      145       define variable v-date1 as date      no-undo .
      146       define variable v-date2 as date      no-undo .
      147       define variable v-time  as integer   no-undo .
      148       assign
      149         v-date1 = today
      150         v-time  = time
      151         v-date2 = today
      152       .
      153       if v-date1 <> v-date2
      154       then do:
      155         assign
      156           v-date1 = today
      157           v-time  = v-time
      158         .
      159       end.
      160       assign
      161         p-today = v-date1
      162         p-time  = v-time
      163       .
      164     end.
      165   end.
      166   function cur-time-date returns character
      167   :
      168     return string(today, '99/99/9999':U) .
      169   end.
      170   function cur-time-mjd returns decimal
      171   :
      172     define variable v-date as date      no-undo .
      173     define variable v-time as integer   no-undo .
      174     run cur-time in this-procedure
      175       (output v-date
      176       ,output v-time
      177       ) .
      178     return integer(v-date) - 2400002 + (v-time / 86400) .
      179   end.
      180   function cur-time-get-ending-index returns integer
      181   (input p-number as integer
      182   )
      183   :
      184     if p-number < 0
      185     or p-number = ?
      186     then do:
      187       return 1 .
      188     end.
      189     define variable v-rest as integer   no-undo .
      190     assign
      191       p-number = p-number modulo 100
      192     .
      193     if p-number < 20
      194     then do:
      195       assign
      196         v-rest = p-number
      197       .
      198     end.
      199     else do:
      200       assign
      201         v-rest = p-number modulo 10
      202       .
      203     end.
      204     case v-rest :
      205       when 1
      206       then do:
      207         return 2 .
      208       end.
      209       when 2 or
      210       when 3 or
      211       when 4
      212       then do:
      213         return 3 .
      214       end.
      215       otherwise do:
      216         return 1 .
      217       end.
      218     end case .
      219   end.
      220   procedure cur-time-mjd-to-date :
      221      define input  parameter i-mjd-diff as decimal no-undo.
      222      define output parameter o-Date     as date    no-undo.
      223      define output parameter o-Time     as integer no-undo.
      224      define variable v-day-number as integer   no-undo .
      225      if    i-mjd-diff < 0
      226         or i-mjd-diff = ?
      227      then do:
      228         return "?" .
      229      end.
      230      assign
      231         v-day-number = truncate(i-mjd-diff,0).
      232         o-Date = date(v-day-number + 2400002).
      233         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      234     .
      235   end.
      236   function cur-time-mjd-to-string returns character
      237   (input p-mjd-diff as decimal
      238   )
      239   :
      240     define variable v-day-number as integer   no-undo .
      241     define variable v-seconds    as integer   no-undo .
      242     define variable v-hour       as integer   no-undo .
      243     define variable v-min        as integer   no-undo .
      244     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      245     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      246     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      247     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      248     if p-mjd-diff < 0
      249     or p-mjd-diff = ?
      250     then do:
      251       return "?" .
      252     end.
      253     assign
      254       v-day-number = integer(truncate(p-mjd-diff,0))
      255       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      256     .
      257     if v-seconds > 86400
      258     then do:
      259       assign
      260         v-seconds = 86400 - 1
      261       .
      262     end.
      263     if v-seconds < 0
      264     then do:
      265       assign
      266         v-seconds = 0
      267       .
      268     end.
      269     assign
      270       v-hour = truncate(v-seconds / 3600, 0)
      271     .
      272     assign
      273       v-seconds = v-seconds modulo 3600
      274     .
      275     assign
      276       v-min = truncate(v-seconds / 60, 0)
      277     .
      278     assign
      279       v-seconds = v-seconds modulo 60
      280     .
      281     return
      282         (if v-day-number <> 0
      283           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      284           else ""
      285         )
      286       + (if v-day-number <> 0 or v-hour <> 0
      287           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      288           else ""
      289         )
      290       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      291           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      292           else ""
      293         )
      294       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      295       .
      296   end.
      297   function cur-time-string returns character
      298   :
      299     define variable v-date as date      no-undo .
      300     define variable v-time as integer   no-undo .
      301     run cur-time in this-procedure
      302       (output v-date
      303       ,output v-time
      304       ) .
      305     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      306   end.
      307   function cur-time-string-sec returns character
      308   :
      309     define variable v-date as date      no-undo .
      310     define variable v-time as integer   no-undo .
      311     run cur-time in this-procedure
      312       (output v-date
      313       ,output v-time
      314       ) .
      315     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      316   end.
      317   function cur-time-custom  returns character
      318   (input p-prefix as character
      319   ,input p-date-format as character
      320   ,input p-delimiter as character
      321   ,input p-time-format as character
      322   ,input p-suffix as character
      323   )
      324   :
      325     define variable v-date as date      no-undo .
      326     define variable v-time as integer   no-undo .
      327     run cur-time in this-procedure
      328       (output v-date
      329       ,output v-time
      330       ) .
      331     return
      332       p-prefix
      333       + string(v-date, p-date-format)
      334       + p-delimiter
      335       + string(v-time, p-time-format)
      336       + p-suffix
      337       .
      338   end.
      339   function cur-time-print  returns character
      340   :
      341     define variable v-date as date      no-undo .
      342     define variable v-time as integer   no-undo .
      343     run cur-time in this-procedure
      344       (output v-date
      345       ,output v-time
      346       ) .
      347     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      348   end.
      349   function cur-time-datetime returns datetime
      350   :
      351     define variable v-char as character no-undo .
      352     define variable v-datetime as datetime no-undo .
      353     v-char = cur-time-string().
      354     v-datetime = datetime(v-char).
      355     return  v-datetime.
      356   end.
      357   function cur-time-string-msec returns character
      358   :
      359     define variable v-date as datetime  no-undo .
      360     v-date = now.
      361     return string(v-date) .
      362   end.
      363   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      364   define new global shared variable g#lib-nws as handle no-undo .
      365   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      366   PROCEDURE verify-ini-entry:
      367   DEFINE INPUT  PARAMETER ini-key-name     as character no-undo.
      368   DEFINE INPUT  PARAMETER ini-section-name as character no-undo.
      369   DEFINE INPUT  PARAMETER error-msg-text   as character no-undo.
      370   DEFINE INPUT  PARAMETER silence          as logical no-undo.
      371   DEFINE OUTPUT PARAMETER ini-entry-value  as character no-undo INIt ?.
      372   define variable v-mess as character no-undo .
      373   get-key-value section ini-section-name key ini-key-name value ini-entry-value.
      374   if ini-entry-value = ? and ini-key-name begins "spl"
      375   then
      376   get-key-value section ini-section-name key "splall" value ini-entry-value.
      377   if ini-entry-value = ? and ini-key-name begins "sav"
      378   then
      379   get-key-value section ini-section-name key "savall" value ini-entry-value.
      380   if ini-entry-value = ? then do:
      381     assign
      382     v-mess = substitute("Ошибка ini - файла:&1Секция &2&1Ключ &3&1&4"
      383                       , chr(10)
      384                       , ini-section-name
      385                       , ini-key-name
      386                       , error-msg-text).
      387       if not silence then do:
      388         message
      389         v-mess
      390         view-as alert-box ERROR  .
      391         return error.
      392       end.
      393       else do:
      394         return error v-mess.
      395       end.
      396   end.
      397   END PROCEDURE.
      398   PROCEDURE verify-file:
      399   DEFINE INPUT  PARAMETER filename       as character no-undo.
      400   DEFINE INPUT  PARAMETER error-msg-text as character no-undo.
      401   DEFINE INPUT  PARAMETER silence        as logical no-undo.
      402   DEFINE OUTPUT PARAMETER found          as logical no-undo.
      403   file-info:file-name = filename.
      404   found = NOT (file-info:full-pathname = ?).
      405   if NOT found  then do:
      406     if not silence then do:
      407       message error-msg-text
      408       view-as alert-box ERROR.
      409       return error.
      410     end.
      411     else return error error-msg-text.
      412   end.
      413   END PROCEDURE.
      414   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      415   def var vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      416   procedure gen-key-rec :
      417     define input  parameter p-tbl-name    as character no-undo.
      418     define input  parameter p-bh_tbl-name as handle    no-undo.
      419     define output parameter p-key-rec     as character no-undo.
      420     do
      421     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      422     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      423     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      424     :
      425       define variable fh               as handle    no-undo .
      426       define variable v-ok             as logical   no-undo .
      427       define variable v-inform         as character no-undo .
      428       define variable v-ind            as integer   no-undo .
      429       define variable v-idx-field-qnty as integer   no-undo .
      430       if p-tbl-name = ?
      431         or p-tbl-name = "":U
      432       then do:
      433         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info5 ).
      434       end.
      435       if not p-bh_tbl-name:available then do:
      436         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info5, p-tbl-name ).
      437       end.
      438       assign
      439         p-key-rec = p-tbl-name
      440         v-inform  = p-bh_tbl-name:index-information(1)
      441         v-ind     = 2
      442       .
      443       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      444       on error undo, return error
      445       :
      446         assign
      447           v-inform = p-bh_tbl-name:index-information( v-ind )
      448           v-ind    = v-ind + 1
      449         .
      450       end.
      451       if v-inform = ?
      452         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      453         or entry( 3, v-inform, ",":U ) <> "1":U
      454       then do:
      455         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, p-tbl-name ).
      456       end.
      457       else do:
      458         assign
      459           v-idx-field-qnty = num-entries( v-inform ) - 4
      460         .
      461         if v-idx-field-qnty < 2 then do:
      462           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, p-tbl-name ).
      463         end.
      464         do v-ind = 1 to v-idx-field-qnty by 2
      465         on error undo, return error
      466         :
      467           assign
      468             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      469             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      470           .
      471         end.
      472       end.
      473       if p-key-rec = ? then do:
      474         assign
      475           p-key-rec = "":U
      476         .
      477         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info5, p-tbl-name ).
      478       end.
      479     end.
      480     return.
      481   end procedure.
      482   procedure gen-where-keyr-tab :
      483     define input  parameter i-tableSerach as character no-undo.
      484     define input  parameter i-tablekey   as character  no-undo.
      485     define input  parameter p-key-rec    as character  no-undo.
      486     define input  parameter p-key-handle as handle     no-undo .
      487     define input  parameter p-db-name    as character  no-undo .
      488     define input  parameter p-tt-handle  as handle     no-undo .
      489     define output parameter o-Where      as character  no-undo.
      490     do
      491     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      492     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      493     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      494     :
      495       define variable v-full-tbl-name  as character no-undo .
      496       define variable bh_tbl-name      as handle    no-undo .
      497       define variable fh_key           as handle    no-undo .
      498       define variable fh_search        as handle    no-undo .
      499       define variable v-field-num      as integer   no-undo .
      500       define variable v-count-fld      as integer   no-undo .
      501       define variable v-inform         as character no-undo .
      502       define variable v-ind            as integer   no-undo .
      503       define variable v-idx-field-qnty as integer   no-undo .
      504       define variable v-field-name     as character no-undo .
      505       define variable v-field-val      as character no-undo .
      506       define variable v-word-link      as character no-undo .
      507       define variable vTable           as character no-undo.
      508       define variable bh_tbl-key       as handle    no-undo .
      509       assign
      510         p-key-rec = trim( p-key-rec )
      511       .
      512       if p-key-handle <> ? then do:
      513         if not valid-handle(p-key-handle)
      514            or p-key-handle:type <> "buffer"
      515         then do:
      516           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info5 ).
      517         end.
      518         if num-entries( p-key-rec, chr(3) ) > 1
      519           or p-key-rec = ?
      520           or p-key-rec = "":U
      521         then do:
      522           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info5, p-key-rec ).
      523         end.
      524       end.
      525       else do:
      526         if p-key-rec = ?
      527           or p-key-rec = "":U
      528         then do:
      529           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info5 ).
      530         end.
      531       end.
      532       assign
      533         vTable = entry( 1 , p-key-rec, chr(3) )
      534       .
      535       if p-tt-handle <> ?
      536         and ( not valid-handle(p-tt-handle)
      537               or p-tt-handle:type <> "buffer"
      538             )
      539       then do:
      540         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info5, vTable, chr(10) ).
      541       end.
      542       if p-tt-handle = ? then do:
      543         assign
      544           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      545         .
      546         create buffer bh_tbl-name for table v-full-tbl-name .
      547       end.
      548       else do:
      549         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      550       end.
      551       assign
      552         v-inform = bh_tbl-name:index-information(1)
      553         v-ind    = 2
      554       .
      555       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      556       on error undo, return error
      557       :
      558         assign
      559           v-inform = bh_tbl-name:index-information( v-ind )
      560           v-ind    = v-ind + 1
      561         .
      562       end.
      563       if v-inform = ?
      564         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      565         or entry( 3, v-inform, ",":U ) <> "1":U
      566       then do:
      567         delete object bh_tbl-name no-error.
      568         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info5, vTable ).
      569       end.
      570       assign
      571         v-idx-field-qnty = num-entries( v-inform ) - 4
      572       .
      573       if v-idx-field-qnty < 2 then do:
      574         delete object bh_tbl-name no-error.
      575         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, vTable ).
      576       end.
      577       assign
      578         o-where     = "where":U
      579         v-word-link = "":U
      580         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      581         v-count-fld = 0
      582       .
      583       if i-tablekey ne "" and i-tablekey ne ?
      584       then do:
      585         assign
      586           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      587         .
      588         create buffer bh_tbl-key for table v-full-tbl-name .
      589       end.
      590       if i-tableSerach ne "" and i-tableSerach ne ?
      591       then do:
      592         delete object bh_tbl-name no-error.
      593         assign
      594           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      595         .
      596         create buffer bh_tbl-name for table v-full-tbl-name .
      597       end.
      598       block_where:
      599       do v-ind = 1 to v-idx-field-qnty by 2
      600       on error undo, return error
      601       :
      602         assign
      603           v-count-fld = v-count-fld + 1
      604         .
      605         if p-key-handle = ?
      606           and v-count-fld > v-field-num
      607         then do:
      608           leave block_where.
      609         end.
      610         define variable VfieldKeyTable as handle no-undo.
      611         assign
      612           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      613           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      614         .
      615         if     bh_tbl-key ne ?
      616         then do:
      617            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      618            if VfieldKeyTable eq ?
      619            then next block_where.
      620         end.
      621         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      622         then
      623            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      624         else
      625            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      626         if p-key-handle = ? then do:
      627           assign
      628             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      629           .
      630         end.
      631         else do:
      632           assign
      633             fh_key = p-key-handle:buffer-field( v-field-name )
      634           .
      635           if fh_key = ?
      636             or not valid-handle( fh_key )
      637           then do:
      638             delete object bh_tbl-name.
      639             if     bh_tbl-key ne ?
      640             then
      641                delete object bh_tbl-key.
      642             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info5, p-key-handle:name, v-field-name ).
      643           end.
      644           assign
      645             v-field-val = fh_key:buffer-value
      646           .
      647         end.
      648         if fh_search:data-type ="character":U then do:
      649           assign
      650             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      651             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      652             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      653             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      654             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      655             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      656             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      657             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      658             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      659             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      660             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      661             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      662             v-field-val = substitute( '"&1"', v-field-val )
      663           .
      664         end.
      665         assign
      666           o-where = substitute( "&1 &2", o-where, v-field-val )
      667         .
      668         if v-word-link = "":U then do:
      669           assign
      670             v-word-link = "and":U
      671           .
      672         end.
      673       end.
      674       delete object bh_tbl-name.
      675       if     bh_tbl-key ne ?
      676       then
      677          delete object bh_tbl-key.
      678       if p-key-handle = ?
      679         and v-count-fld <> v-field-num
      680       then do:
      681         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info5, vTable ).
      682       end.
      683     end.
      684   end procedure.
      685   procedure gen-hn-keyr-tab :
      686     define input  parameter i-tableSerach as character no-undo.
      687     define input  parameter i-tablekey   as character no-undo.
      688     define input  parameter p-key-rec    as character no-undo.
      689     define input  parameter p-key-handle as handle    no-undo .
      690     define input  parameter p-db-name    as character no-undo .
      691     define input  parameter p-tt-handle  as handle    no-undo .
      692     define input  parameter p-stts-lock  as integer   no-undo .
      693     define output parameter o-hn         as handle    no-undo.
      694     define variable v-full-tbl-name as character no-undo.
      695     define variable v-where         as character no-undo.
      696     define variable bh_tbl-name     as handle    no-undo.
      697     define variable vTable          as character no-undo.
      698     do
      699     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      700     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      701     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      702         run gen-where-keyr-tab(i-tableSerach,
      703                                i-tablekey,
      704                                p-key-rec,
      705                                p-key-handle,
      706                                p-db-name,
      707                                p-tt-handle,
      708                                output v-where).
      709         if i-tableSerach ne "" and i-tableSerach ne ?
      710         then do:
      711            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      712            create buffer bh_tbl-name for table v-full-tbl-name .
      713         end.
      714         else do:
      715            if p-tt-handle = ? then do:
      716               assign
      717                  vTable = entry( 1 , p-key-rec, chr(3) )
      718               .
      719               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      720               create buffer bh_tbl-name for table v-full-tbl-name .
      721            end.
      722            else do:
      723               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      724            end.
      725         end.
      726         if p-tt-handle = ? then do:
      727            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      728         end.
      729         else do:
      730            bh_tbl-name:find-first( v-where ) no-error .
      731         end.
      732         o-hn = bh_tbl-name.
      733      end.
      734   end procedure.
      735   procedure gen-hn-keyr :
      736     define input  parameter p-key-rec    as character no-undo.
      737     define input  parameter p-key-handle as handle    no-undo .
      738     define input  parameter p-db-name    as character no-undo .
      739     define input  parameter p-tt-handle  as handle    no-undo .
      740     define input  parameter p-stts-lock  as integer   no-undo .
      741     define output parameter o-hn         as handle    no-undo.
      742     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      743   end.
      744   procedure gen-row-keyr :
      745     define input  parameter p-key-rec    as character no-undo.
      746     define input  parameter p-key-handle as handle    no-undo .
      747     define input  parameter p-db-name    as character no-undo .
      748     define input  parameter p-tt-handle  as handle    no-undo .
      749     define input  parameter p-stts-lock  as integer   no-undo .
      750     define output parameter p-tbl-row    as rowid     no-undo.
      751     define output parameter p-tbl-name   as character no-undo.
      752     define variable vHn as handle no-undo.
      753       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      754       p-tbl-row = if vHn:available then vHn:rowid else ?.
      755       p-tbl-name =  vHn:table.
      756       delete object vHn no-error.
      757     if p-tbl-row = ? then do:
      758       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info5, p-tbl-name, p-key-rec ).
      759     end.
      760     else do:
      761       return.
      762     end.
      763   end procedure.
      764   procedure gen-key-fv :
      765     define input  parameter p-key-rec    as character no-undo .
      766     define output parameter p-field-list as character no-undo .
      767     define output parameter p-value-list as character no-undo.
      768     do
      769     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      770     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      771     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      772     :
      773       define variable v-full-tbl-name  as character no-undo .
      774       define variable bh_tbl-name      as handle    no-undo .
      775       define variable v-tbl-name       as character no-undo .
      776       define variable v-field-num      as integer   no-undo .
      777       define variable v-count-fld      as integer   no-undo .
      778       define variable v-inform         as character no-undo .
      779       define variable v-ind            as integer   no-undo .
      780       define variable v-idx-field-qnty as integer   no-undo .
      781       define variable v-delim-key      as character no-undo .
      782       if p-key-rec = ?
      783         or p-key-rec = "":U
      784       then do:
      785         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info5 ).
      786       end.
      787       assign
      788         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      789         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      790       .
      791       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      792       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info5 ).
      793       assign
      794         v-inform = bh_tbl-name:index-information(1)
      795         v-ind    = 2
      796       .
      797       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      798       on error undo, return error
      799       :
      800         assign
      801           v-inform = bh_tbl-name:index-information( v-ind )
      802           v-ind    = v-ind + 1
      803         .
      804       end.
      805       if v-inform = ?
      806         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      807         or entry( 3, v-inform, ",":U ) <> "1":U
      808       then do:
      809         delete object bh_tbl-name no-error.
      810         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, v-tbl-name ).
      811       end.
      812       assign
      813         v-idx-field-qnty = num-entries( v-inform ) - 4
      814       .
      815       if v-idx-field-qnty < 2 then do:
      816         delete object bh_tbl-name no-error.
      817         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, v-tbl-name ).
      818       end.
      819       assign
      820         p-field-list = "":U
      821         p-value-list = "":U
      822         v-delim-key  = "":U
      823         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      824         v-count-fld  = 0
      825       .
      826       block_where:
      827       do v-ind = 1 to v-idx-field-qnty by 2
      828       on error undo, return error
      829       :
      830         assign
      831           v-count-fld = v-count-fld + 1
      832         .
      833         if v-count-fld > v-field-num then do:
      834           leave block_where.
      835         end.
      836         assign
      837           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      838           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      839         .
      840         if v-ind = 1 then do:
      841           assign
      842             v-delim-key = chr(3)
      843           .
      844         end.
      845       end.
      846       delete object bh_tbl-name.
      847       if v-count-fld <> v-field-num then do:
      848         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info5, v-tbl-name ).
      849       end.
      850     end.
      851   end procedure.
      852   procedure gen-key-field :
      853     define input  parameter p-table      as character no-undo .
      854     define output parameter p-field-list as character no-undo .
      855     do
      856     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      857     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      858     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      859     :
      860       define variable v-full-tbl-name  as character no-undo .
      861       define variable bh_tbl-name      as handle    no-undo .
      862       define variable v-tbl-name       as character no-undo .
      863       define variable v-field-num      as integer   no-undo .
      864       define variable v-count-fld      as integer   no-undo .
      865       define variable v-inform         as character no-undo .
      866       define variable v-ind            as integer   no-undo .
      867       define variable v-idx-field-qnty as integer   no-undo .
      868       define variable v-delim-key      as character no-undo .
      869       if p-table = ?
      870         or p-table = "":U
      871       then do:
      872         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info5 ).
      873       end.
      874       assign
      875         v-tbl-name      = p-table
      876         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      877       .
      878       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      879       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info5 ).
      880       assign
      881         v-inform = bh_tbl-name:index-information(1)
      882         v-ind    = 2
      883       .
      884       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      885       on error undo, return error
      886       :
      887         assign
      888           v-inform = bh_tbl-name:index-information( v-ind )
      889           v-ind    = v-ind + 1
      890         .
      891       end.
      892       if v-inform = ?
      893         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      894         or entry( 3, v-inform, ",":U ) <> "1":U
      895       then do:
      896         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, v-tbl-name ).
      897       end.
      898       assign
      899         v-idx-field-qnty = num-entries( v-inform ) - 4
      900       .
      901       if v-idx-field-qnty < 2 then do:
      902         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, v-tbl-name ).
      903       end.
      904       assign
      905         p-field-list = "":U
      906         v-delim-key  = "":U
      907         v-count-fld  = 0
      908       .
      909       block_where:
      910       do v-ind = 1 to v-idx-field-qnty by 2
      911       on error undo, return error
      912       :
      913         assign
      914           v-count-fld = v-count-fld + 1
      915         .
      916         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      917         if v-ind = 1 then do:
      918           assign
      919             v-delim-key = chr(3)
      920           .
      921         end.
      922       end.
      923       delete object bh_tbl-name.
      924     end.
      925   end procedure.
      926   define SHARED temp-table temp-cmd no-undo
      927   field cmd-code as integer
      928   field db-list as character
      929   index pi is unique primary
      930   db-list
      931   index icmd
      932   cmd-code
      933   .
      934   define SHARED temp-table temp-smart-route no-undo
      935   field key-field as character
      936   field db-num as integer
      937   index pi is unique primary
      938   key-field
      939   db-num
      940   .
      941   define SHARED temp-table temp-no-route no-undo
      942   field rec-ord as integer
      943   field db-num as integer
      944   index pi is unique primary
      945   db-num
      946   rec-ord
      947   index iro
      948   rec-ord
      949   .
      950   define SHARED temp-table temp-smart-link no-undo
      951   field uniq-key-rec as character
      952   field key-field as character
      953   field rec-ord as integer
      954   field is-smart as logical
      955   index pi is unique primary
      956   key-field
      957   uniq-key-rec
      958   rec-ord
      959   index iu
      960   uniq-key-rec
      961   index iro
      962   rec-ord
      963   .
      964   define SHARED temp-table temp-nws-outline no-undo
      965   like ub.nws-outline.
      966   procedure create-smart-route :
      967   define input parameter p-key-field as character no-undo .
      968   define input parameter p-db-num as integer no-undo .
      969   define buffer buf_temp-smart-route for temp-smart-route.
      970     do
      971     on error undo, return error
      972     :
      973       find first buf_temp-smart-route where
      974                 buf_temp-smart-route.key-field = p-key-field
      975             and buf_temp-smart-route.db-num = p-db-num no-error.
      976       if not available buf_temp-smart-route then do:
      977         create buf_temp-smart-route.
      978         assign
      979         buf_temp-smart-route.key-field = p-key-field
      980         buf_temp-smart-route.db-num = p-db-num
      981         .
      982       end.
      983     end.
      984   end procedure.
      985   procedure create-smart-route-link :
      986   define input parameter p-tbl-name as character no-undo .
      987   define input parameter p-bh_tbl-name as handle no-undo .
      988   define input parameter p-key-field as character no-undo .
      989   define input parameter p-rec-ord as integer no-undo .
      990   define input parameter p-is-smart as logical no-undo .
      991   define variable v-key-rec as character no-undo .
      992   define buffer buf_temp-smart-link for temp-smart-link.
      993     do
      994     on error undo, return error
      995     :
      996       run gen-key-rec in this-procedure ( input p-tbl-name
      997                                          ,input p-bh_tbl-name
      998                                          ,output v-key-rec     ).
      999      find first buf_temp-smart-link where
     1000                 buf_temp-smart-link.uniq-key-rec = v-key-rec
     1001              and buf_temp-smart-link.key-field = p-key-field
     1002              and buf_temp-smart-link.rec-ord = p-rec-ord
     1003              no-error .
     1004      if not available buf_temp-smart-link then do:
     1005        create buf_temp-smart-link.
     1006        assign
     1007        buf_temp-smart-link.uniq-key-rec = v-key-rec
     1008        buf_temp-smart-link.key-field = p-key-field
     1009        buf_temp-smart-link.rec-ord = p-rec-ord
     1010        buf_temp-smart-link.is-smart = p-is-smart
     1011        .
     1012      end.
     1013     end.
     1014   end procedure.
     1015   procedure create-nws-outline :
     1016   define input parameter p-cmd-proc-handle as handle no-undo .
     1017   define input parameter p-cmd-code as integer no-undo .
     1018   define input parameter p-outline-type as character no-undo .
     1019   define input parameter p-charkey_one as character no-undo .
     1020   define input parameter p-charkey_two as character no-undo .
     1021   define input parameter p-charkey_three as character no-undo .
     1022   define input parameter p-key#_one as integer no-undo .
     1023   define input parameter p-key#_two as integer no-undo .
     1024   define input parameter p-key#_three as integer no-undo .
     1025   define variable v-no-id as integer no-undo .
     1026   define variable v-rec-ord as integer no-undo .
     1027     do
     1028     on error undo, return error return-value
     1029     :
     1030       find last temp-nws-outline use-index pi no-error .
     1031       v-no-id = (if available temp-nws-outline
     1032                  then (temp-nws-outline.no-id  + 1)
     1033                  else 1).
     1034       create temp-nws-outline.
     1035       assign
     1036       temp-nws-outline.charkeY_one = p-charkey_one
     1037       temp-nws-outline.charkeY_two = p-charkey_two
     1038       temp-nws-outline.charkeY_three = p-charkey_three
     1039       temp-nws-outline.key#_one = p-key#_one
     1040       temp-nws-outline.key#_two = p-key#_two
     1041       temp-nws-outline.key#_three = p-key#_three
     1042       temp-nws-outline.no-id = v-no-id
     1043       temp-nws-outline.outline-type = p-outline-type
     1044       .
     1045                                   run add-dump in p-cmd-proc-handle                                                                           (input p-cmd-code                                                                                         ,input 'nws-outline':U                                                                                          ,input '+update'                                                                                         ,input (buffer temp-nws-outline:handle)                                                                                    ,input ''                                                                                         ,output v-rec-ord                                                                                         ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                     delete procedure p-cmd-proc-handle .                                                                        undo , return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'nws-outline':U                                                                                                ,p-cmd-code                                                                                               ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
     1046       run  create-smart-route in this-procedure (
     1047                                                   input ('nws-outline':U + chr(4) + string(temp-nws-outline.no-id))
     1048                                                  ,input -1).
     1049       run create-smart-route-link in this-procedure (
     1050                                                      input 'nws-outline':U
     1051                                                     ,input (buffer temp-nws-outline:handle)
     1052                                                     ,input ('nws-outline':U + chr(4) + string(temp-nws-outline.no-id))
     1053                                                     ,input v-rec-ord
     1054                                                     ,input no
     1055                                                     ).
     1056     end.
     1057   end procedure.
     1058   procedure create-no-route :
     1059   define input parameter p-rec-ord as integer no-undo .
     1060   define input parameter p-db-num as integer no-undo .
     1061   define buffer buf_temp-no-route for temp-no-route.
     1062   do
     1063   on error undo, return error
     1064   :
     1065      find first buf_temp-no-route where
     1066                 buf_temp-no-route.rec-ord = p-rec-ord
     1067              and buf_temp-no-route.db-num = p-db-num no-error .
     1068      if not available buf_temp-no-route then do:
     1069        create buf_temp-no-route.
     1070        assign
     1071        buf_temp-no-route.rec-ord = p-rec-ord
     1072        buf_temp-no-route.db-num = p-db-num
     1073        .
     1074      end.
     1075   end.
     1076   end procedure.
     1077   procedure clear-from-rec-ord :
     1078   define input parameter p-rec-ord as integer no-undo .
     1079   define buffer buf_temp-no-route for temp-no-route.
     1080   define buffer buf_temp-smart-link for temp-smart-link.
     1081   do
     1082   on error undo, return error
     1083   :
     1084   for each buf_temp-no-route where
     1085           buf_temp-no-route.rec-ord > p-rec-ord:
     1086     delete buf_temp-no-route.
     1087   end.
     1088   for each buf_temp-smart-link where
     1089           buf_temp-smart-link.rec-ord > p-rec-ord:
     1090      delete buf_temp-smart-link.
     1091   end.
     1092   end.
     1093   end procedure.
     1094   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1095   define shared temp-table temp-hist-nws-option no-undo
     1096   like ub.hist-nws-option
     1097   .
