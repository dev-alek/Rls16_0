        1   block-level on error undo, throw.
        2   define input parameter        p-mode as character no-undo .
        3   define input parameter        p-silent as logical no-undo .
        4   define input-output parameter p-rec  as recid     no-undo .
        5   define input parameter        p-pchain-type as character no-undo .
        6   define input parameter        p-pchain-id as character no-undo .
        7   define input parameter        p-start-from as integer no-undo .
        8   define input parameter        p-link-id as integer no-undo .
        9   define input parameter        p-codex-id as integer no-undo .
       10   define input parameter        p-ruleset-id as integer no-undo .
       11   define input parameter        p-run-db0 as integer no-undo .
       12   define input parameter        p-run-rdb as integer no-undo .
       13   define input parameter        p-link-btwn-profiles as integer no-undo .
       14   define input parameter        p-is-export as integer no-undo .
       15   define input parameter        p-is-import as integer no-undo .
       16   define input parameter        p-needs-efile as integer no-undo .
       17   define input parameter        p-needs-ifile as integer no-undo .
       18   define input parameter        p-is-routing as integer no-undo .
       19   define input parameter        p-is-esys-import as integer no-undo .
       20   define input parameter        p-main-link as integer no-undo .
       21   define input parameter        p-can-be-start as integer no-undo .
       22   define input parameter        p-documentation as character no-undo .
       23   define variable vss-revision    as character no-undo init "$Revision$":U .
       24   define variable vss-author      as character no-undo init "$Author$":U .
       25   define variable vss-date        as character no-undo init "$Date$":U .
       26   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       27   define variable vss-archive     as character no-undo init "$Archive$":U .
       28   define variable vss-description as character no-undo init "Сохранение rule-process".
       29   procedure vss-get-info :
       30     define output parameter p-vss-revision    like vss-revision    no-undo .
       31     define output parameter p-vss-author      like vss-author      no-undo .
       32     define output parameter p-vss-date        like vss-date        no-undo .
       33     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       34     define output parameter p-vss-archive     like vss-archive     no-undo .
       35     define output parameter p-vss-description like vss-description no-undo .
       36     assign
       37       p-vss-revision    = vss-revision
       38       p-vss-author      = vss-author
       39       p-vss-date        = vss-date
       40       p-vss-workfile    = vss-workfile
       41       p-vss-archive     = vss-archive
       42       p-vss-description = vss-description
       43     .
       44   end procedure.
       45   procedure vss-get-parameters :
       46     define output parameter p-vss-parameters as character no-undo .
       47   end procedure.
       48   define new global shared variable g#vssrevis-logger as handle    no-undo .
       49   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       50   define variable v-vssrevis-logger                   as handle    no-undo .
       51   procedure vss-logevent :
       52     define input  parameter p-extra-paramters as character no-undo .
       53     define variable v-vssrevis-parameters as character no-undo .
       54     do
       55     on error undo, return error return-value
       56     :
       57       if  valid-handle(v-vssrevis-logger)
       58       and v-vssrevis-logger :get-signature("logevent") <> ""
       59       then do:
       60         run vss-get-parameters in this-procedure
       61           (output v-vssrevis-parameters
       62           ).
       63         run logevent in v-vssrevis-logger
       64           (input vss-workfile
       65           ,input vss-revision
       66           ,input v-vssrevis-parameters
       67           ,input p-extra-paramters
       68           ).
       69       end.
       70     end.
       71   end procedure.
       72   assign
       73     v-vssrevis-logger = g#vssrevis-logger
       74   .
       75   if  valid-handle(v-vssrevis-logger)
       76   and v-vssrevis-logger :get-signature("logevent") <> ""
       77   then do:
       78     assign
       79       v-vssrevis-logevent = true
       80     .
       81     run vss-logevent in this-procedure (input vss-description) .
       82   end.
       83   define new global shared variable g#language as character no-undo .
       84   if g#language <> '' and g#language <> 'rus':U then do:
       85     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       86   end.
       87   define new global shared variable g#library  as handle no-undo .
       88   define new global shared variable g#library2 as handle no-undo .
       89   define   shared variable g#auto as logical no-undo.
       90   define   shared variable g#news as logical no-undo.
       91   define   shared variable g#oxml as logical no-undo.
       92   define   shared variable g#esys as logical no-undo.
       93   define   shared variable g#news-source-db as integer no-undo.
       94   define   shared variable g#esys-source-esys as integer no-undo.
       95   define   shared variable g#db-num as integer   no-undo .
       96   define   shared variable g#userid as character no-undo .
       97   define   shared variable g#passwd as character no-undo .
       98   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       99   procedure gen-key-rec :
      100     define input  parameter p-tbl-name    as character no-undo.
      101     define input  parameter p-bh_tbl-name as handle    no-undo.
      102     define output parameter p-key-rec     as character no-undo.
      103     do
      104     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      105     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      106     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      107     :
      108       define variable fh               as handle    no-undo .
      109       define variable v-ok             as logical   no-undo .
      110       define variable v-inform         as character no-undo .
      111       define variable v-ind            as integer   no-undo .
      112       define variable v-idx-field-qnty as integer   no-undo .
      113       if p-tbl-name = ?
      114         or p-tbl-name = "":U
      115       then do:
      116         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info0 ).
      117       end.
      118       if not p-bh_tbl-name:available then do:
      119         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info0, p-tbl-name ).
      120       end.
      121       assign
      122         p-key-rec = p-tbl-name
      123         v-inform  = p-bh_tbl-name:index-information(1)
      124         v-ind     = 2
      125       .
      126       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      127       on error undo, return error
      128       :
      129         assign
      130           v-inform = p-bh_tbl-name:index-information( v-ind )
      131           v-ind    = v-ind + 1
      132         .
      133       end.
      134       if v-inform = ?
      135         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      136         or entry( 3, v-inform, ",":U ) <> "1":U
      137       then do:
      138         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, p-tbl-name ).
      139       end.
      140       else do:
      141         assign
      142           v-idx-field-qnty = num-entries( v-inform ) - 4
      143         .
      144         if v-idx-field-qnty < 2 then do:
      145           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, p-tbl-name ).
      146         end.
      147         do v-ind = 1 to v-idx-field-qnty by 2
      148         on error undo, return error
      149         :
      150           assign
      151             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      152             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      153           .
      154         end.
      155       end.
      156       if p-key-rec = ? then do:
      157         assign
      158           p-key-rec = "":U
      159         .
      160         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info0, p-tbl-name ).
      161       end.
      162     end.
      163     return.
      164   end procedure.
      165   procedure gen-where-keyr-tab :
      166     define input  parameter i-tableSerach as character no-undo.
      167     define input  parameter i-tablekey   as character  no-undo.
      168     define input  parameter p-key-rec    as character  no-undo.
      169     define input  parameter p-key-handle as handle     no-undo .
      170     define input  parameter p-db-name    as character  no-undo .
      171     define input  parameter p-tt-handle  as handle     no-undo .
      172     define output parameter o-Where      as character  no-undo.
      173     do
      174     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      175     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      176     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      177     :
      178       define variable v-full-tbl-name  as character no-undo .
      179       define variable bh_tbl-name      as handle    no-undo .
      180       define variable fh_key           as handle    no-undo .
      181       define variable fh_search        as handle    no-undo .
      182       define variable v-field-num      as integer   no-undo .
      183       define variable v-count-fld      as integer   no-undo .
      184       define variable v-inform         as character no-undo .
      185       define variable v-ind            as integer   no-undo .
      186       define variable v-idx-field-qnty as integer   no-undo .
      187       define variable v-field-name     as character no-undo .
      188       define variable v-field-val      as character no-undo .
      189       define variable v-word-link      as character no-undo .
      190       define variable vTable           as character no-undo.
      191       define variable bh_tbl-key       as handle    no-undo .
      192       assign
      193         p-key-rec = trim( p-key-rec )
      194       .
      195       if p-key-handle <> ? then do:
      196         if not valid-handle(p-key-handle)
      197            or p-key-handle:type <> "buffer"
      198         then do:
      199           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info0 ).
      200         end.
      201         if num-entries( p-key-rec, chr(3) ) > 1
      202           or p-key-rec = ?
      203           or p-key-rec = "":U
      204         then do:
      205           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info0, p-key-rec ).
      206         end.
      207       end.
      208       else do:
      209         if p-key-rec = ?
      210           or p-key-rec = "":U
      211         then do:
      212           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info0 ).
      213         end.
      214       end.
      215       assign
      216         vTable = entry( 1 , p-key-rec, chr(3) )
      217       .
      218       if p-tt-handle <> ?
      219         and ( not valid-handle(p-tt-handle)
      220               or p-tt-handle:type <> "buffer"
      221             )
      222       then do:
      223         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info0, vTable, chr(10) ).
      224       end.
      225       if p-tt-handle = ? then do:
      226         assign
      227           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      228         .
      229         create buffer bh_tbl-name for table v-full-tbl-name .
      230       end.
      231       else do:
      232         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      233       end.
      234       assign
      235         v-inform = bh_tbl-name:index-information(1)
      236         v-ind    = 2
      237       .
      238       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      239       on error undo, return error
      240       :
      241         assign
      242           v-inform = bh_tbl-name:index-information( v-ind )
      243           v-ind    = v-ind + 1
      244         .
      245       end.
      246       if v-inform = ?
      247         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      248         or entry( 3, v-inform, ",":U ) <> "1":U
      249       then do:
      250         delete object bh_tbl-name no-error.
      251         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info0, vTable ).
      252       end.
      253       assign
      254         v-idx-field-qnty = num-entries( v-inform ) - 4
      255       .
      256       if v-idx-field-qnty < 2 then do:
      257         delete object bh_tbl-name no-error.
      258         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, vTable ).
      259       end.
      260       assign
      261         o-where     = "where":U
      262         v-word-link = "":U
      263         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      264         v-count-fld = 0
      265       .
      266       if i-tablekey ne "" and i-tablekey ne ?
      267       then do:
      268         assign
      269           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      270         .
      271         create buffer bh_tbl-key for table v-full-tbl-name .
      272       end.
      273       if i-tableSerach ne "" and i-tableSerach ne ?
      274       then do:
      275         delete object bh_tbl-name no-error.
      276         assign
      277           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      278         .
      279         create buffer bh_tbl-name for table v-full-tbl-name .
      280       end.
      281       block_where:
      282       do v-ind = 1 to v-idx-field-qnty by 2
      283       on error undo, return error
      284       :
      285         assign
      286           v-count-fld = v-count-fld + 1
      287         .
      288         if p-key-handle = ?
      289           and v-count-fld > v-field-num
      290         then do:
      291           leave block_where.
      292         end.
      293         define variable VfieldKeyTable as handle no-undo.
      294         assign
      295           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      296           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      297         .
      298         if     bh_tbl-key ne ?
      299         then do:
      300            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      301            if VfieldKeyTable eq ?
      302            then next block_where.
      303         end.
      304         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      305         then
      306            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      307         else
      308            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      309         if p-key-handle = ? then do:
      310           assign
      311             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      312           .
      313         end.
      314         else do:
      315           assign
      316             fh_key = p-key-handle:buffer-field( v-field-name )
      317           .
      318           if fh_key = ?
      319             or not valid-handle( fh_key )
      320           then do:
      321             delete object bh_tbl-name.
      322             if     bh_tbl-key ne ?
      323             then
      324                delete object bh_tbl-key.
      325             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info0, p-key-handle:name, v-field-name ).
      326           end.
      327           assign
      328             v-field-val = fh_key:buffer-value
      329           .
      330         end.
      331         if fh_search:data-type ="character":U then do:
      332           assign
      333             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      334             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      335             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      336             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      337             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      338             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      339             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      340             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      341             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      342             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      343             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      344             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      345             v-field-val = substitute( '"&1"', v-field-val )
      346           .
      347         end.
      348         assign
      349           o-where = substitute( "&1 &2", o-where, v-field-val )
      350         .
      351         if v-word-link = "":U then do:
      352           assign
      353             v-word-link = "and":U
      354           .
      355         end.
      356       end.
      357       delete object bh_tbl-name.
      358       if     bh_tbl-key ne ?
      359       then
      360          delete object bh_tbl-key.
      361       if p-key-handle = ?
      362         and v-count-fld <> v-field-num
      363       then do:
      364         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info0, vTable ).
      365       end.
      366     end.
      367   end procedure.
      368   procedure gen-hn-keyr-tab :
      369     define input  parameter i-tableSerach as character no-undo.
      370     define input  parameter i-tablekey   as character no-undo.
      371     define input  parameter p-key-rec    as character no-undo.
      372     define input  parameter p-key-handle as handle    no-undo .
      373     define input  parameter p-db-name    as character no-undo .
      374     define input  parameter p-tt-handle  as handle    no-undo .
      375     define input  parameter p-stts-lock  as integer   no-undo .
      376     define output parameter o-hn         as handle    no-undo.
      377     define variable v-full-tbl-name as character no-undo.
      378     define variable v-where         as character no-undo.
      379     define variable bh_tbl-name     as handle    no-undo.
      380     define variable vTable          as character no-undo.
      381     do
      382     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      383     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      384     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      385         run gen-where-keyr-tab(i-tableSerach,
      386                                i-tablekey,
      387                                p-key-rec,
      388                                p-key-handle,
      389                                p-db-name,
      390                                p-tt-handle,
      391                                output v-where).
      392         if i-tableSerach ne "" and i-tableSerach ne ?
      393         then do:
      394            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      395            create buffer bh_tbl-name for table v-full-tbl-name .
      396         end.
      397         else do:
      398            if p-tt-handle = ? then do:
      399               assign
      400                  vTable = entry( 1 , p-key-rec, chr(3) )
      401               .
      402               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      403               create buffer bh_tbl-name for table v-full-tbl-name .
      404            end.
      405            else do:
      406               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      407            end.
      408         end.
      409         if p-tt-handle = ? then do:
      410            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      411         end.
      412         else do:
      413            bh_tbl-name:find-first( v-where ) no-error .
      414         end.
      415         o-hn = bh_tbl-name.
      416      end.
      417   end procedure.
      418   procedure gen-hn-keyr :
      419     define input  parameter p-key-rec    as character no-undo.
      420     define input  parameter p-key-handle as handle    no-undo .
      421     define input  parameter p-db-name    as character no-undo .
      422     define input  parameter p-tt-handle  as handle    no-undo .
      423     define input  parameter p-stts-lock  as integer   no-undo .
      424     define output parameter o-hn         as handle    no-undo.
      425     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      426   end.
      427   procedure gen-row-keyr :
      428     define input  parameter p-key-rec    as character no-undo.
      429     define input  parameter p-key-handle as handle    no-undo .
      430     define input  parameter p-db-name    as character no-undo .
      431     define input  parameter p-tt-handle  as handle    no-undo .
      432     define input  parameter p-stts-lock  as integer   no-undo .
      433     define output parameter p-tbl-row    as rowid     no-undo.
      434     define output parameter p-tbl-name   as character no-undo.
      435     define variable vHn as handle no-undo.
      436       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      437       p-tbl-row = if vHn:available then vHn:rowid else ?.
      438       p-tbl-name =  vHn:table.
      439       delete object vHn no-error.
      440     if p-tbl-row = ? then do:
      441       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info0, p-tbl-name, p-key-rec ).
      442     end.
      443     else do:
      444       return.
      445     end.
      446   end procedure.
      447   procedure gen-key-fv :
      448     define input  parameter p-key-rec    as character no-undo .
      449     define output parameter p-field-list as character no-undo .
      450     define output parameter p-value-list as character no-undo.
      451     do
      452     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      453     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      454     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      455     :
      456       define variable v-full-tbl-name  as character no-undo .
      457       define variable bh_tbl-name      as handle    no-undo .
      458       define variable v-tbl-name       as character no-undo .
      459       define variable v-field-num      as integer   no-undo .
      460       define variable v-count-fld      as integer   no-undo .
      461       define variable v-inform         as character no-undo .
      462       define variable v-ind            as integer   no-undo .
      463       define variable v-idx-field-qnty as integer   no-undo .
      464       define variable v-delim-key      as character no-undo .
      465       if p-key-rec = ?
      466         or p-key-rec = "":U
      467       then do:
      468         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info0 ).
      469       end.
      470       assign
      471         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      472         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      473       .
      474       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      475       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info0 ).
      476       assign
      477         v-inform = bh_tbl-name:index-information(1)
      478         v-ind    = 2
      479       .
      480       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      481       on error undo, return error
      482       :
      483         assign
      484           v-inform = bh_tbl-name:index-information( v-ind )
      485           v-ind    = v-ind + 1
      486         .
      487       end.
      488       if v-inform = ?
      489         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      490         or entry( 3, v-inform, ",":U ) <> "1":U
      491       then do:
      492         delete object bh_tbl-name no-error.
      493         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, v-tbl-name ).
      494       end.
      495       assign
      496         v-idx-field-qnty = num-entries( v-inform ) - 4
      497       .
      498       if v-idx-field-qnty < 2 then do:
      499         delete object bh_tbl-name no-error.
      500         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, v-tbl-name ).
      501       end.
      502       assign
      503         p-field-list = "":U
      504         p-value-list = "":U
      505         v-delim-key  = "":U
      506         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      507         v-count-fld  = 0
      508       .
      509       block_where:
      510       do v-ind = 1 to v-idx-field-qnty by 2
      511       on error undo, return error
      512       :
      513         assign
      514           v-count-fld = v-count-fld + 1
      515         .
      516         if v-count-fld > v-field-num then do:
      517           leave block_where.
      518         end.
      519         assign
      520           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      521           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      522         .
      523         if v-ind = 1 then do:
      524           assign
      525             v-delim-key = chr(3)
      526           .
      527         end.
      528       end.
      529       delete object bh_tbl-name.
      530       if v-count-fld <> v-field-num then do:
      531         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info0, v-tbl-name ).
      532       end.
      533     end.
      534   end procedure.
      535   procedure gen-key-field :
      536     define input  parameter p-table      as character no-undo .
      537     define output parameter p-field-list as character no-undo .
      538     do
      539     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      540     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      541     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      542     :
      543       define variable v-full-tbl-name  as character no-undo .
      544       define variable bh_tbl-name      as handle    no-undo .
      545       define variable v-tbl-name       as character no-undo .
      546       define variable v-field-num      as integer   no-undo .
      547       define variable v-count-fld      as integer   no-undo .
      548       define variable v-inform         as character no-undo .
      549       define variable v-ind            as integer   no-undo .
      550       define variable v-idx-field-qnty as integer   no-undo .
      551       define variable v-delim-key      as character no-undo .
      552       if p-table = ?
      553         or p-table = "":U
      554       then do:
      555         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info0 ).
      556       end.
      557       assign
      558         v-tbl-name      = p-table
      559         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      560       .
      561       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      562       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info0 ).
      563       assign
      564         v-inform = bh_tbl-name:index-information(1)
      565         v-ind    = 2
      566       .
      567       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      568       on error undo, return error
      569       :
      570         assign
      571           v-inform = bh_tbl-name:index-information( v-ind )
      572           v-ind    = v-ind + 1
      573         .
      574       end.
      575       if v-inform = ?
      576         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      577         or entry( 3, v-inform, ",":U ) <> "1":U
      578       then do:
      579         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, v-tbl-name ).
      580       end.
      581       assign
      582         v-idx-field-qnty = num-entries( v-inform ) - 4
      583       .
      584       if v-idx-field-qnty < 2 then do:
      585         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, v-tbl-name ).
      586       end.
      587       assign
      588         p-field-list = "":U
      589         v-delim-key  = "":U
      590         v-count-fld  = 0
      591       .
      592       block_where:
      593       do v-ind = 1 to v-idx-field-qnty by 2
      594       on error undo, return error
      595       :
      596         assign
      597           v-count-fld = v-count-fld + 1
      598         .
      599         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      600         if v-ind = 1 then do:
      601           assign
      602             v-delim-key = chr(3)
      603           .
      604         end.
      605       end.
      606       delete object bh_tbl-name.
      607     end.
      608   end procedure.
      609   define variable v-mess as character no-undo .
      610   define variable v-entry as character no-undo .
      611   define variable v-entry-id as integer no-undo .
      612   define buffer buf_rule-process for ub.rule-process.
      613   define buffer buf_ruleset for ub.ruleset.
      614   if p-mode <> 'ДОБАВЛЕНИЕ':U
      615   AND p-mode <> 'ИЗМЕНЕНИЕ':U then do:
      616     message vss-workfile vss-revision vss-description skip
      617             "Неверный параметр p-mode - " p-mode
      618     view-as alert-box error .
      619     return error '':u.
      620   end.
      621   if g#db-num <> 0 then do:
      622     message vss-workfile vss-revision vss-description skip
      623             "Запрещено вызывать процедуру в УБД"
      624     view-as alert-box error .
      625     return error '':u.
      626   end.
      627   _main:
      628   do for buf_rule-process
      629   on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      630   on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
      631   on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
      632   :
      633     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      634       find first buf_rule-process no-lock where
      635                buf_rule-process.pchain-type = p-pchain-type
      636            and buf_rule-process.pchain-id = p-pchain-id
      637            and buf_rule-process.start-from = p-start-from
      638            and buf_rule-process.link-id = p-link-id
      639                  no-error.
      640       if available buf_rule-process then do:
      641         assign
      642         v-mess = "Уже существует такое звено".
      643         run err-mess in this-procedure ( input-output v-mess).
      644         return error (if p-silent = yes then v-mess else '':U).
      645       end.
      646       if lookup( entry(1, p-pchain-type, "_") , 'dis-card-type,goods,clients,gds-grp,cli-grp,chk-doc,edoc,thref,pdf,rep,ord,fdoc':U) = 0 then do:
      647         assign
      648         v-mess = substitute("Неверный тип процесса &1", p-pchain-type).
      649         run err-mess in this-procedure ( input-output v-mess).
      650         return error (if p-silent = yes then v-mess else '':U).
      651       end.
      652       create buf_rule-process.
      653       assign
      654       buf_rule-process.pchain-type = p-pchain-type
      655       buf_rule-process.pchain-id = p-pchain-id
      656       buf_rule-process.start-from = p-start-from
      657       buf_rule-process.link-id = p-link-id
      658       .
      659     end.
      660     if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      661       find first buf_rule-process exclusive-lock where
      662                 recid(buf_rule-process) = p-rec .
      663       if buf_rule-process.pchain-type <> p-pchain-type
      664       or buf_rule-process.pchain-id <> p-pchain-id
      665       or buf_rule-process.start-from <> p-start-from
      666       or buf_rule-process.link-id <> p-link-id
      667       then do:
      668         assign
      669         v-mess = substitute("Для уже существующего звена процесса невозможно изменение тип процесса, id, места старта и ID звена&1"
      670                                 , chr(10)
      671                                 )
      672         .
      673         run err-mess in this-procedure ( input-output v-mess).
      674         return error (if p-silent = yes then v-mess else '':U).
      675       end.
      676     end.
      677     find first buf_ruleset no-lock where
      678               buf_ruleset.codex_id = p-codex-id
      679           and buf_ruleset.ruleset_id = p-ruleset-id no-error.
      680     if not available buf_ruleset then do:
      681       assign
      682       v-mess = substitute("Не найден набор правил &2 в кодексе &1"
      683                               ,p-codex-id
      684                               ,p-ruleset-id)
      685       .
      686       run err-mess in this-procedure ( input-output v-mess).
      687       return error (if p-silent = yes then v-mess else '':U).
      688     end.
      689     assign
      690     buf_rule-process.pchain-type = p-pchain-type
      691     buf_rule-process.pchain-id = p-pchain-id
      692     buf_rule-process.start-from = p-start-from
      693     buf_rule-process.link-id = p-link-id
      694     buf_rule-process.codex_id = p-codex-id
      695     buf_rule-process.ruleset_id = p-ruleset-id
      696     buf_rule-process.run-db0 = p-run-db0
      697     buf_rule-process.run-rdb = p-run-rdb
      698     buf_rule-process.link-btwn-profiles = p-link-btwn-profiles
      699     buf_rule-process.is-export = p-is-export
      700     buf_rule-process.is-import = p-is-import
      701     buf_rule-process.needs-efile = p-needs-efile
      702     buf_rule-process.needs-ifile = p-needs-ifile
      703     buf_rule-process.is-routing = p-is-routing
      704     buf_rule-process.is-esys-import = p-is-esys-import
      705     buf_rule-process.main-link = p-main-link
      706     buf_rule-process.can-be-start = p-can-be-start
      707     buf_rule-process.documentation = p-documentation
      708     p-rec = recid(buf_rule-process)
      709     .
      710   end.
      711   PROCEDURE err-mess:
      712     DEFINE INPUT-OUTPUT PARAMETER p-mess as character No-UNDO.
      713     CASE p-silent:
      714       when yes then do:
      715         assign
      716         p-mess = substitute("Звено процесса: тип &1 id &2 Старт из &3 link-id &4&5:&6"
      717                            , p-pchain-type
      718                            , p-pchain-id
      719                            , p-start-from
      720                            , p-link-id
      721                            , chr(10)
      722                            , p-mess)
      723         .
      724       end.
      725       when no then do:
      726         message
      727         p-mess
      728         view-as alert-box error .
      729       end.
      730     end.
      731   END PROCEDURE.
