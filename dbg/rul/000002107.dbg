      102   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      103   define  variable garbcoll_ii as integer no-undo .
      104   define  temp-table temp-gc no-undo
      105   field ii as integer
      106   field obj-r as handle
      107   field cn as character
      108   index pi is unique primary
      109   ii
      110   index icn
      111   cn.
      112   procedure garbcoll_create-gc-entry :
      113   define input parameter p-cn as character no-undo .
      114   define input parameter p-obj-r as handle no-undo .
      115     do
      116     on error undo, return error
      117     :
      118       create temp-gc.
      119       assign
      120       temp-gc.ii = garbcoll_ii
      121       garbcoll_ii = garbcoll_ii + 1
      122       temp-gc.cn = p-cn
      123       temp-gc.obj-r = p-obj-r
      124       .
      125     end.
      126   end procedure.
      127   procedure garbcoll_clear :
      128     do
      129     on error undo, return error
      130     :
      131       for each temp-gc:
      132         delete object temp-gc.obj-r.
      133         delete temp-gc.
      134       end.
      135     end.
      136   end procedure.
      137   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      138   procedure cur-time :
      139      define output parameter p-today as date      no-undo .
      140      define output parameter p-time  as integer   no-undo .
      141     do
      142     on error undo, return error
      143     :
      144       define variable v-date1 as date      no-undo .
      145       define variable v-date2 as date      no-undo .
      146       define variable v-time  as integer   no-undo .
      147       assign
      148         v-date1 = today
      149         v-time  = time
      150         v-date2 = today
      151       .
      152       if v-date1 <> v-date2
      153       then do:
      154         assign
      155           v-date1 = today
      156           v-time  = v-time
      157         .
      158       end.
      159       assign
      160         p-today = v-date1
      161         p-time  = v-time
      162       .
      163     end.
      164   end.
      165   function cur-time-date returns character
      166   :
      167     return string(today, '99/99/9999':U) .
      168   end.
      169   function cur-time-mjd returns decimal
      170   :
      171     define variable v-date as date      no-undo .
      172     define variable v-time as integer   no-undo .
      173     run cur-time in this-procedure
      174       (output v-date
      175       ,output v-time
      176       ) .
      177     return integer(v-date) - 2400002 + (v-time / 86400) .
      178   end.
      179   function cur-time-get-ending-index returns integer
      180   (input p-number as integer
      181   )
      182   :
      183     if p-number < 0
      184     or p-number = ?
      185     then do:
      186       return 1 .
      187     end.
      188     define variable v-rest as integer   no-undo .
      189     assign
      190       p-number = p-number modulo 100
      191     .
      192     if p-number < 20
      193     then do:
      194       assign
      195         v-rest = p-number
      196       .
      197     end.
      198     else do:
      199       assign
      200         v-rest = p-number modulo 10
      201       .
      202     end.
      203     case v-rest :
      204       when 1
      205       then do:
      206         return 2 .
      207       end.
      208       when 2 or
      209       when 3 or
      210       when 4
      211       then do:
      212         return 3 .
      213       end.
      214       otherwise do:
      215         return 1 .
      216       end.
      217     end case .
      218   end.
      219   procedure cur-time-mjd-to-date :
      220      define input  parameter i-mjd-diff as decimal no-undo.
      221      define output parameter o-Date     as date    no-undo.
      222      define output parameter o-Time     as integer no-undo.
      223      define variable v-day-number as integer   no-undo .
      224      if    i-mjd-diff < 0
      225         or i-mjd-diff = ?
      226      then do:
      227         return "?" .
      228      end.
      229      assign
      230         v-day-number = truncate(i-mjd-diff,0).
      231         o-Date = date(v-day-number + 2400002).
      232         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      233     .
      234   end.
      235   function cur-time-mjd-to-string returns character
      236   (input p-mjd-diff as decimal
      237   )
      238   :
      239     define variable v-day-number as integer   no-undo .
      240     define variable v-seconds    as integer   no-undo .
      241     define variable v-hour       as integer   no-undo .
      242     define variable v-min        as integer   no-undo .
      243     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      244     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      245     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      246     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      247     if p-mjd-diff < 0
      248     or p-mjd-diff = ?
      249     then do:
      250       return "?" .
      251     end.
      252     assign
      253       v-day-number = integer(truncate(p-mjd-diff,0))
      254       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      255     .
      256     if v-seconds > 86400
      257     then do:
      258       assign
      259         v-seconds = 86400 - 1
      260       .
      261     end.
      262     if v-seconds < 0
      263     then do:
      264       assign
      265         v-seconds = 0
      266       .
      267     end.
      268     assign
      269       v-hour = truncate(v-seconds / 3600, 0)
      270     .
      271     assign
      272       v-seconds = v-seconds modulo 3600
      273     .
      274     assign
      275       v-min = truncate(v-seconds / 60, 0)
      276     .
      277     assign
      278       v-seconds = v-seconds modulo 60
      279     .
      280     return
      281         (if v-day-number <> 0
      282           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      283           else ""
      284         )
      285       + (if v-day-number <> 0 or v-hour <> 0
      286           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      287           else ""
      288         )
      289       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      290           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      291           else ""
      292         )
      293       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      294       .
      295   end.
      296   function cur-time-string returns character
      297   :
      298     define variable v-date as date      no-undo .
      299     define variable v-time as integer   no-undo .
      300     run cur-time in this-procedure
      301       (output v-date
      302       ,output v-time
      303       ) .
      304     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      305   end.
      306   function cur-time-string-sec returns character
      307   :
      308     define variable v-date as date      no-undo .
      309     define variable v-time as integer   no-undo .
      310     run cur-time in this-procedure
      311       (output v-date
      312       ,output v-time
      313       ) .
      314     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      315   end.
      316   function cur-time-custom  returns character
      317   (input p-prefix as character
      318   ,input p-date-format as character
      319   ,input p-delimiter as character
      320   ,input p-time-format as character
      321   ,input p-suffix as character
      322   )
      323   :
      324     define variable v-date as date      no-undo .
      325     define variable v-time as integer   no-undo .
      326     run cur-time in this-procedure
      327       (output v-date
      328       ,output v-time
      329       ) .
      330     return
      331       p-prefix
      332       + string(v-date, p-date-format)
      333       + p-delimiter
      334       + string(v-time, p-time-format)
      335       + p-suffix
      336       .
      337   end.
      338   function cur-time-print  returns character
      339   :
      340     define variable v-date as date      no-undo .
      341     define variable v-time as integer   no-undo .
      342     run cur-time in this-procedure
      343       (output v-date
      344       ,output v-time
      345       ) .
      346     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      347   end.
      348   function cur-time-datetime returns datetime
      349   :
      350     define variable v-char as character no-undo .
      351     define variable v-datetime as datetime no-undo .
      352     v-char = cur-time-string().
      353     v-datetime = datetime(v-char).
      354     return  v-datetime.
      355   end.
      356   function cur-time-string-msec returns character
      357   :
      358     define variable v-date as datetime  no-undo .
      359     v-date = now.
      360     return string(v-date) .
      361   end.
      362   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      363   define new global shared variable g#lib-nws as handle no-undo .
      364   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      365   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      366   define variable tempcxml_v-num_ as integer no-undo .
      367   define  temp-table temp-xml-tables no-undo
      368   field order as integer
      369   field tbl-name as character
      370   field tbl-handle_ as handle
      371   field table-handle_ as handle
      372   field uniq-gate-rec as character
      373   field gate-name as character
      374   field gate-handle_ as handle
      375   field is-parent as logical
      376   index pi is unique primary
      377   uniq-gate-rec
      378   tbl-name
      379   index iorder
      380   order
      381   index gr
      382   uniq-gate-rec
      383   index gh
      384   gate-handle_
      385   index iparent
      386   is-parent
      387   .
      388   define  temp-table temp-xml-records no-undo
      389   field tbl-name as character
      390   field uniq-key-rec as character
      391   index pi is unique primary
      392   tbl-name
      393   uniq-key-rec
      394   .
      395   def var vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      396   procedure gen-key-rec :
      397     define input  parameter p-tbl-name    as character no-undo.
      398     define input  parameter p-bh_tbl-name as handle    no-undo.
      399     define output parameter p-key-rec     as character no-undo.
      400     do
      401     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      402     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      403     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      404     :
      405       define variable fh               as handle    no-undo .
      406       define variable v-ok             as logical   no-undo .
      407       define variable v-inform         as character no-undo .
      408       define variable v-ind            as integer   no-undo .
      409       define variable v-idx-field-qnty as integer   no-undo .
      410       if p-tbl-name = ?
      411         or p-tbl-name = "":U
      412       then do:
      413         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info5 ).
      414       end.
      415       if not p-bh_tbl-name:available then do:
      416         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info5, p-tbl-name ).
      417       end.
      418       assign
      419         p-key-rec = p-tbl-name
      420         v-inform  = p-bh_tbl-name:index-information(1)
      421         v-ind     = 2
      422       .
      423       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      424       on error undo, return error
      425       :
      426         assign
      427           v-inform = p-bh_tbl-name:index-information( v-ind )
      428           v-ind    = v-ind + 1
      429         .
      430       end.
      431       if v-inform = ?
      432         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      433         or entry( 3, v-inform, ",":U ) <> "1":U
      434       then do:
      435         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, p-tbl-name ).
      436       end.
      437       else do:
      438         assign
      439           v-idx-field-qnty = num-entries( v-inform ) - 4
      440         .
      441         if v-idx-field-qnty < 2 then do:
      442           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, p-tbl-name ).
      443         end.
      444         do v-ind = 1 to v-idx-field-qnty by 2
      445         on error undo, return error
      446         :
      447           assign
      448             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      449             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      450           .
      451         end.
      452       end.
      453       if p-key-rec = ? then do:
      454         assign
      455           p-key-rec = "":U
      456         .
      457         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info5, p-tbl-name ).
      458       end.
      459     end.
      460     return.
      461   end procedure.
      462   procedure gen-where-keyr-tab :
      463     define input  parameter i-tableSerach as character no-undo.
      464     define input  parameter i-tablekey   as character  no-undo.
      465     define input  parameter p-key-rec    as character  no-undo.
      466     define input  parameter p-key-handle as handle     no-undo .
      467     define input  parameter p-db-name    as character  no-undo .
      468     define input  parameter p-tt-handle  as handle     no-undo .
      469     define output parameter o-Where      as character  no-undo.
      470     do
      471     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      472     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      473     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      474     :
      475       define variable v-full-tbl-name  as character no-undo .
      476       define variable bh_tbl-name      as handle    no-undo .
      477       define variable fh_key           as handle    no-undo .
      478       define variable fh_search        as handle    no-undo .
      479       define variable v-field-num      as integer   no-undo .
      480       define variable v-count-fld      as integer   no-undo .
      481       define variable v-inform         as character no-undo .
      482       define variable v-ind            as integer   no-undo .
      483       define variable v-idx-field-qnty as integer   no-undo .
      484       define variable v-field-name     as character no-undo .
      485       define variable v-field-val      as character no-undo .
      486       define variable v-word-link      as character no-undo .
      487       define variable vTable           as character no-undo.
      488       define variable bh_tbl-key       as handle    no-undo .
      489       assign
      490         p-key-rec = trim( p-key-rec )
      491       .
      492       if p-key-handle <> ? then do:
      493         if not valid-handle(p-key-handle)
      494            or p-key-handle:type <> "buffer"
      495         then do:
      496           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info5 ).
      497         end.
      498         if num-entries( p-key-rec, chr(3) ) > 1
      499           or p-key-rec = ?
      500           or p-key-rec = "":U
      501         then do:
      502           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info5, p-key-rec ).
      503         end.
      504       end.
      505       else do:
      506         if p-key-rec = ?
      507           or p-key-rec = "":U
      508         then do:
      509           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info5 ).
      510         end.
      511       end.
      512       assign
      513         vTable = entry( 1 , p-key-rec, chr(3) )
      514       .
      515       if p-tt-handle <> ?
      516         and ( not valid-handle(p-tt-handle)
      517               or p-tt-handle:type <> "buffer"
      518             )
      519       then do:
      520         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info5, vTable, chr(10) ).
      521       end.
      522       if p-tt-handle = ? then do:
      523         assign
      524           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      525         .
      526         create buffer bh_tbl-name for table v-full-tbl-name .
      527       end.
      528       else do:
      529         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      530       end.
      531       assign
      532         v-inform = bh_tbl-name:index-information(1)
      533         v-ind    = 2
      534       .
      535       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      536       on error undo, return error
      537       :
      538         assign
      539           v-inform = bh_tbl-name:index-information( v-ind )
      540           v-ind    = v-ind + 1
      541         .
      542       end.
      543       if v-inform = ?
      544         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      545         or entry( 3, v-inform, ",":U ) <> "1":U
      546       then do:
      547         delete object bh_tbl-name no-error.
      548         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info5, vTable ).
      549       end.
      550       assign
      551         v-idx-field-qnty = num-entries( v-inform ) - 4
      552       .
      553       if v-idx-field-qnty < 2 then do:
      554         delete object bh_tbl-name no-error.
      555         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, vTable ).
      556       end.
      557       assign
      558         o-where     = "where":U
      559         v-word-link = "":U
      560         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      561         v-count-fld = 0
      562       .
      563       if i-tablekey ne "" and i-tablekey ne ?
      564       then do:
      565         assign
      566           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      567         .
      568         create buffer bh_tbl-key for table v-full-tbl-name .
      569       end.
      570       if i-tableSerach ne "" and i-tableSerach ne ?
      571       then do:
      572         delete object bh_tbl-name no-error.
      573         assign
      574           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      575         .
      576         create buffer bh_tbl-name for table v-full-tbl-name .
      577       end.
      578       block_where:
      579       do v-ind = 1 to v-idx-field-qnty by 2
      580       on error undo, return error
      581       :
      582         assign
      583           v-count-fld = v-count-fld + 1
      584         .
      585         if p-key-handle = ?
      586           and v-count-fld > v-field-num
      587         then do:
      588           leave block_where.
      589         end.
      590         define variable VfieldKeyTable as handle no-undo.
      591         assign
      592           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      593           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      594         .
      595         if     bh_tbl-key ne ?
      596         then do:
      597            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      598            if VfieldKeyTable eq ?
      599            then next block_where.
      600         end.
      601         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      602         then
      603            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      604         else
      605            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      606         if p-key-handle = ? then do:
      607           assign
      608             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      609           .
      610         end.
      611         else do:
      612           assign
      613             fh_key = p-key-handle:buffer-field( v-field-name )
      614           .
      615           if fh_key = ?
      616             or not valid-handle( fh_key )
      617           then do:
      618             delete object bh_tbl-name.
      619             if     bh_tbl-key ne ?
      620             then
      621                delete object bh_tbl-key.
      622             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info5, p-key-handle:name, v-field-name ).
      623           end.
      624           assign
      625             v-field-val = fh_key:buffer-value
      626           .
      627         end.
      628         if fh_search:data-type ="character":U then do:
      629           assign
      630             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      631             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      632             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      633             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      634             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      635             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      636             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      637             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      638             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      639             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      640             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      641             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      642             v-field-val = substitute( '"&1"', v-field-val )
      643           .
      644         end.
      645         assign
      646           o-where = substitute( "&1 &2", o-where, v-field-val )
      647         .
      648         if v-word-link = "":U then do:
      649           assign
      650             v-word-link = "and":U
      651           .
      652         end.
      653       end.
      654       delete object bh_tbl-name.
      655       if     bh_tbl-key ne ?
      656       then
      657          delete object bh_tbl-key.
      658       if p-key-handle = ?
      659         and v-count-fld <> v-field-num
      660       then do:
      661         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info5, vTable ).
      662       end.
      663     end.
      664   end procedure.
      665   procedure gen-hn-keyr-tab :
      666     define input  parameter i-tableSerach as character no-undo.
      667     define input  parameter i-tablekey   as character no-undo.
      668     define input  parameter p-key-rec    as character no-undo.
      669     define input  parameter p-key-handle as handle    no-undo .
      670     define input  parameter p-db-name    as character no-undo .
      671     define input  parameter p-tt-handle  as handle    no-undo .
      672     define input  parameter p-stts-lock  as integer   no-undo .
      673     define output parameter o-hn         as handle    no-undo.
      674     define variable v-full-tbl-name as character no-undo.
      675     define variable v-where         as character no-undo.
      676     define variable bh_tbl-name     as handle    no-undo.
      677     define variable vTable          as character no-undo.
      678     do
      679     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      680     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      681     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      682         run gen-where-keyr-tab(i-tableSerach,
      683                                i-tablekey,
      684                                p-key-rec,
      685                                p-key-handle,
      686                                p-db-name,
      687                                p-tt-handle,
      688                                output v-where).
      689         if i-tableSerach ne "" and i-tableSerach ne ?
      690         then do:
      691            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      692            create buffer bh_tbl-name for table v-full-tbl-name .
      693         end.
      694         else do:
      695            if p-tt-handle = ? then do:
      696               assign
      697                  vTable = entry( 1 , p-key-rec, chr(3) )
      698               .
      699               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      700               create buffer bh_tbl-name for table v-full-tbl-name .
      701            end.
      702            else do:
      703               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      704            end.
      705         end.
      706         if p-tt-handle = ? then do:
      707            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      708         end.
      709         else do:
      710            bh_tbl-name:find-first( v-where ) no-error .
      711         end.
      712         o-hn = bh_tbl-name.
      713      end.
      714   end procedure.
      715   procedure gen-hn-keyr :
      716     define input  parameter p-key-rec    as character no-undo.
      717     define input  parameter p-key-handle as handle    no-undo .
      718     define input  parameter p-db-name    as character no-undo .
      719     define input  parameter p-tt-handle  as handle    no-undo .
      720     define input  parameter p-stts-lock  as integer   no-undo .
      721     define output parameter o-hn         as handle    no-undo.
      722     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      723   end.
      724   procedure gen-row-keyr :
      725     define input  parameter p-key-rec    as character no-undo.
      726     define input  parameter p-key-handle as handle    no-undo .
      727     define input  parameter p-db-name    as character no-undo .
      728     define input  parameter p-tt-handle  as handle    no-undo .
      729     define input  parameter p-stts-lock  as integer   no-undo .
      730     define output parameter p-tbl-row    as rowid     no-undo.
      731     define output parameter p-tbl-name   as character no-undo.
      732     define variable vHn as handle no-undo.
      733       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      734       p-tbl-row = if vHn:available then vHn:rowid else ?.
      735       p-tbl-name =  vHn:table.
      736       delete object vHn no-error.
      737     if p-tbl-row = ? then do:
      738       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info5, p-tbl-name, p-key-rec ).
      739     end.
      740     else do:
      741       return.
      742     end.
      743   end procedure.
      744   procedure gen-key-fv :
      745     define input  parameter p-key-rec    as character no-undo .
      746     define output parameter p-field-list as character no-undo .
      747     define output parameter p-value-list as character no-undo.
      748     do
      749     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      750     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      751     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      752     :
      753       define variable v-full-tbl-name  as character no-undo .
      754       define variable bh_tbl-name      as handle    no-undo .
      755       define variable v-tbl-name       as character no-undo .
      756       define variable v-field-num      as integer   no-undo .
      757       define variable v-count-fld      as integer   no-undo .
      758       define variable v-inform         as character no-undo .
      759       define variable v-ind            as integer   no-undo .
      760       define variable v-idx-field-qnty as integer   no-undo .
      761       define variable v-delim-key      as character no-undo .
      762       if p-key-rec = ?
      763         or p-key-rec = "":U
      764       then do:
      765         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info5 ).
      766       end.
      767       assign
      768         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      769         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      770       .
      771       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      772       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info5 ).
      773       assign
      774         v-inform = bh_tbl-name:index-information(1)
      775         v-ind    = 2
      776       .
      777       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      778       on error undo, return error
      779       :
      780         assign
      781           v-inform = bh_tbl-name:index-information( v-ind )
      782           v-ind    = v-ind + 1
      783         .
      784       end.
      785       if v-inform = ?
      786         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      787         or entry( 3, v-inform, ",":U ) <> "1":U
      788       then do:
      789         delete object bh_tbl-name no-error.
      790         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, v-tbl-name ).
      791       end.
      792       assign
      793         v-idx-field-qnty = num-entries( v-inform ) - 4
      794       .
      795       if v-idx-field-qnty < 2 then do:
      796         delete object bh_tbl-name no-error.
      797         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, v-tbl-name ).
      798       end.
      799       assign
      800         p-field-list = "":U
      801         p-value-list = "":U
      802         v-delim-key  = "":U
      803         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      804         v-count-fld  = 0
      805       .
      806       block_where:
      807       do v-ind = 1 to v-idx-field-qnty by 2
      808       on error undo, return error
      809       :
      810         assign
      811           v-count-fld = v-count-fld + 1
      812         .
      813         if v-count-fld > v-field-num then do:
      814           leave block_where.
      815         end.
      816         assign
      817           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      818           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      819         .
      820         if v-ind = 1 then do:
      821           assign
      822             v-delim-key = chr(3)
      823           .
      824         end.
      825       end.
      826       delete object bh_tbl-name.
      827       if v-count-fld <> v-field-num then do:
      828         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info5, v-tbl-name ).
      829       end.
      830     end.
      831   end procedure.
      832   procedure gen-key-field :
      833     define input  parameter p-table      as character no-undo .
      834     define output parameter p-field-list as character no-undo .
      835     do
      836     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      837     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      838     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      839     :
      840       define variable v-full-tbl-name  as character no-undo .
      841       define variable bh_tbl-name      as handle    no-undo .
      842       define variable v-tbl-name       as character no-undo .
      843       define variable v-field-num      as integer   no-undo .
      844       define variable v-count-fld      as integer   no-undo .
      845       define variable v-inform         as character no-undo .
      846       define variable v-ind            as integer   no-undo .
      847       define variable v-idx-field-qnty as integer   no-undo .
      848       define variable v-delim-key      as character no-undo .
      849       if p-table = ?
      850         or p-table = "":U
      851       then do:
      852         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info5 ).
      853       end.
      854       assign
      855         v-tbl-name      = p-table
      856         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      857       .
      858       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      859       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info5 ).
      860       assign
      861         v-inform = bh_tbl-name:index-information(1)
      862         v-ind    = 2
      863       .
      864       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      865       on error undo, return error
      866       :
      867         assign
      868           v-inform = bh_tbl-name:index-information( v-ind )
      869           v-ind    = v-ind + 1
      870         .
      871       end.
      872       if v-inform = ?
      873         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      874         or entry( 3, v-inform, ",":U ) <> "1":U
      875       then do:
      876         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, v-tbl-name ).
      877       end.
      878       assign
      879         v-idx-field-qnty = num-entries( v-inform ) - 4
      880       .
      881       if v-idx-field-qnty < 2 then do:
      882         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, v-tbl-name ).
      883       end.
      884       assign
      885         p-field-list = "":U
      886         v-delim-key  = "":U
      887         v-count-fld  = 0
      888       .
      889       block_where:
      890       do v-ind = 1 to v-idx-field-qnty by 2
      891       on error undo, return error
      892       :
      893         assign
      894           v-count-fld = v-count-fld + 1
      895         .
      896         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      897         if v-ind = 1 then do:
      898           assign
      899             v-delim-key = chr(3)
      900           .
      901         end.
      902       end.
      903       delete object bh_tbl-name.
      904     end.
      905   end procedure.
      906   procedure get-gate-file-name :
      907   define input parameter p-gate-rec as character no-undo .
      908   define output  parameter p-gate-file-name as character no-undo .
      909   define buffer buf_clob-data for ub.clob-data.
      910   define variable v-tbl-row as rowid no-undo .
      911   define variable v-tbl-name as character no-undo .
      912   run gen-row-keyr in this-procedure ( input p-gate-rec
      913                                       ,input ?
      914                                       ,input "ub"
      915                                       ,input ?
      916                                       ,input no-lock
      917                                       ,output v-tbl-row
      918                                       ,output v-tbl-name) no-error.
      919   if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
      920                                                           ,vss-include-info3
      921                                                           ,p-gate-rec).
      922   find first buf_clob-data no-lock where
      923             rowid(buf_clob-data) = v-tbl-row no-error.
      924   if not available buf_clob-data then do:
      925     if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
      926                                                             ,vss-include-info3
      927                                                             ,p-gate-rec).
      928   end.
      929   p-gate-file-name = buf_clob-data.file-name.
      930   end procedure.
      931   procedure get-gate-rec :
      932   define input  parameter p-gate-name as character no-undo .
      933   define output parameter p-gate-rec as character no-undo .
      934   define buffer buf_clob-bind for ub.clob-bind.
      935   define buffer buf_clob-data for ub.clob-data.
      936   main-block:
      937   do
      938   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info3, return-value, chr(10), error-status :get-message (1))
      939   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info3 )
      940   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info3 )
      941   :
      942       find first buf_clob-bind no-lock where
      943                 buf_clob-bind.uniq-key-rec = p-gate-name
      944             and buf_clob-bind.field-name = '':U
      945             and buf_clob-bind.part-num = 1
      946             and buf_clob-bind.resource-type = 'gate':U
      947             no-error.
      948       if not available buf_clob-bind then do:
      949         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
      950                                         , p-gate-name
      951                                         ).
      952       end.
      953       find first buf_clob-data no-lock where
      954                 buf_clob-data.db-num = buf_clob-bind.db-num
      955             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
      956       if not available buf_clob-data then do:
      957         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
      958                                         , buf_clob-bind.db-num
      959                                         , buf_clob-bind.int64-id
      960                                         , p-gate-name
      961                                         ).
      962       end.
      963       run gen-key-rec in this-procedure ( input 'clob-data':U
      964                                 ,input buffer buf_clob-data:handle
      965                                 ,output p-gate-rec).
      966   end.
      967   end procedure.
      968   procedure get-gate-by-name :
      969   define input  parameter p-gate-name as character no-undo .
      970   define output parameter p-gate-rec as character no-undo .
      971   define output parameter p-dsh as handle no-undo .
      972   define input-output  parameter p-xmlh as handle no-undo .
      973   define variable v-ii as integer   no-undo .
      974   define variable glog as logical   no-undo .
      975   define variable v-longchar as longchar no-undo .
      976   define variable v-txmlh as handle no-undo .
      977   define variable v-db-num as integer no-undo .
      978   define variable v-int64-id as int64 no-undo .
      979   define buffer buf_clob-bind for ub.clob-bind.
      980   define buffer buf_clob-data for ub.clob-data.
      981   main-block:
      982   do
      983   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info3, return-value, chr(10), error-status :get-message (1))
      984   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info3 )
      985   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info3 )
      986   :
      987       find first buf_clob-bind no-lock where
      988                 buf_clob-bind.uniq-key-rec = p-gate-name
      989             and buf_clob-bind.field-name = '':U
      990             and buf_clob-bind.part-num = 1
      991             and buf_clob-bind.resource-type = 'gate':U
      992             no-error.
      993       if not available buf_clob-bind then do:
      994         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
      995                                         , p-gate-name
      996                                         ).
      997       end.
      998       find first buf_clob-data no-lock where
      999                 buf_clob-data.db-num = buf_clob-bind.db-num
     1000             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     1001       if not available buf_clob-data then do:
     1002         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1003                                         , buf_clob-bind.db-num
     1004                                         , buf_clob-bind.int64-id
     1005                                         , p-gate-name
     1006                                         ).
     1007       end.
     1008       assign
     1009       v-longchar = buf_clob-data.cdata
     1010       .
     1011       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1012       if error-status :error then do:
     1013         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1014       end.
     1015       create dataset p-dsh .
     1016       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1017                                     , v-longchar
     1018                                     , ?
     1019                                     , ?
     1020                                     , ?
     1021                                     ) no-error.
     1022       v-longchar = '':U.
     1023       if error-status :error
     1024       or not glog
     1025       then do:
     1026         undo, return error substitute("Не удалось прочитать XML-схему &1 из БД:&2&3", p-gate-name, chr(10), error-status:get-message(1) ).
     1027       end.
     1028       if not valid-handle(p-xmlh)
     1029       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1030         create temp-table v-txmlh.
     1031         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1032         v-txmlh:temp-table-prepare("temp-xml-tables").
     1033         p-xmlh = v-txmlh:default-buffer-handle.
     1034       end.
     1035       run gen-key-rec in this-procedure ( input 'clob-data':U
     1036                                 ,input buffer buf_clob-data:handle
     1037                                 ,output p-gate-rec).
     1038       do v-ii = 1 to p-dsh:num-buffers:
     1039         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1040         if not p-xmlh:available then do:
     1041           p-xmlh:buffer-create().
     1042           assign
     1043           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1044           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1045           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1046           p-xmlh::gate-handle_ = p-dsh
     1047           p-xmlh::uniq-gate-rec = p-gate-rec
     1048           p-xmlh::gate-name = p-dsh:name
     1049           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1050           .
     1051           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1052             assign
     1053             p-xmlh::order = -3.
     1054           end.
     1055         end.
     1056       end.
     1057   end.
     1058   end procedure.
     1059   procedure get-gate-by-rec :
     1060   define input  parameter p-gate-rec as character no-undo .
     1061   define output parameter p-dsh as handle no-undo .
     1062   define input-output  parameter p-xmlh as handle no-undo .
     1063   define input-output parameter p-longchar  as longchar no-undo .
     1064   define variable v-ii as integer   no-undo .
     1065   define variable glog as logical   no-undo .
     1066   define variable v-rowid as rowid no-undo .
     1067   define variable v-tbl-name as character no-undo .
     1068   define variable v-longchar as longchar no-undo .
     1069   define variable v-txmlh as handle no-undo .
     1070   define buffer buf_clob-data for ub.clob-data.
     1071   main-block:
     1072   do
     1073   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info3, return-value, chr(10), error-status :get-message (1))
     1074   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info3 )
     1075   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info3 )
     1076   :
     1077     run gen-row-keyr in this-procedure (
     1078                                           input  p-gate-rec
     1079                                           ,input  ?
     1080                                           ,input  "ub"
     1081                                           ,input  ?
     1082                                           ,input  NO-LOCK
     1083                                           ,output v-rowid
     1084                                           ,output v-tbl-name   ) no-error.
     1085       find first buf_clob-data no-lock where
     1086                 rowid(buf_clob-data) = v-rowid  no-error.
     1087       if not available buf_clob-data then do:
     1088         undo, return error substitute("Не найден CLOB  &1"
     1089                                         , p-gate-rec
     1090                                         ).
     1091       end.
     1092       assign
     1093       v-longchar = buf_clob-data.cdata
     1094       .
     1095       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1096       if error-status :error then do:
     1097         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1098       end.
     1099       create dataset p-dsh .
     1100       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1101                                     , v-longchar
     1102                                     , ?
     1103                                     , ?
     1104                                     , ?
     1105                                     ) no-error.
     1106       define variable v-esm as character no-undo .
     1107       v-esm = error-status:get-message(1) .
     1108       if p-longchar <> ? then do:
     1109         p-longchar = v-longchar.
     1110       end.
     1111       v-longchar = '':U.
     1112       if error-status :error
     1113       or not glog
     1114       then do:
     1115         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     1116                                      , p-gate-rec
     1117                                      , p-gate-rec
     1118                                      , v-esm
     1119                                      ).
     1120       end.
     1121       p-dsh:private-data = buf_clob-data.file-name_ + chr(4) + p-gate-rec.
     1122       if not valid-handle(p-xmlh)
     1123       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1124         create temp-table v-txmlh.
     1125         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1126         v-txmlh:temp-table-prepare("temp-xml-tables").
     1127         p-xmlh = v-txmlh:default-buffer-handle.
     1128       end.
     1129       do v-ii = 1 to p-dsh:num-buffers:
     1130         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1131         if not p-xmlh:available then do:
     1132           p-xmlh:buffer-create().
     1133           assign
     1134           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1135           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1136           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1137           p-xmlh::gate-handle_ = p-dsh
     1138           p-xmlh::uniq-gate-rec = p-gate-rec
     1139           p-xmlh::gate-name = p-dsh:name
     1140           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1141           .
     1142           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1143             assign
     1144             p-xmlh::order = -3.
     1145           end.
     1146           p-xmlh:buffer-release().
     1147         end.
     1148       end.
     1149   end.
     1150   end procedure.
     1151   procedure get-gate-by-file :
     1152   define input  parameter p-schema-file-name as character no-undo .
     1153   define input  parameter p-gate-rec as character no-undo .
     1154   define output parameter p-dsh as handle no-undo .
     1155   define input-output  parameter p-xmlh as handle no-undo .
     1156   define variable v-ii as integer   no-undo .
     1157   define variable glog as logical   no-undo .
     1158   define variable v-rowid as rowid no-undo .
     1159   define variable v-tbl-name as character no-undo .
     1160   define variable v-longchar as longchar no-undo .
     1161   define variable v-txmlh as handle no-undo .
     1162   main-block:
     1163   do
     1164   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info3, return-value, chr(10), error-status :get-message (1))
     1165   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info3 )
     1166   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info3 )
     1167   :
     1168       COPY-LOB
     1169       FROM  FILE p-schema-file-name
     1170       TO  OBJECT v-longchar
     1171       no-convert
     1172       NO-ERROR .
     1173       if error-status :error then do:
     1174           undo, return error substitute("Не удалось считать файл схемы &1 в память&2&3"
     1175                                     , p-schema-file-name
     1176                                 , chr(10)
     1177                                 , error-status:get-message(1) ).
     1178       end.
     1179       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1180       if error-status :error then do:
     1181         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, p-schema-file-name, chr(10), error-status:get-message(1) , return-value ).
     1182       end.
     1183       create dataset p-dsh .
     1184       glog = p-dsh:READ-XMLSCHEMA( "longchar"
     1185                                     , v-longchar
     1186                                     , ?
     1187                                     , ?
     1188                                     , ?
     1189                                     ) no-error.
     1190       v-longchar = ''.
     1191       if error-status :error
     1192       or not glog
     1193       then do:
     1194         undo, return error substitute("Не удалось прочитать XML-схему из файла &1&2&3"
     1195                                      , p-schema-file-name
     1196                                      ,chr(10)
     1197                                      , error-status:get-message(1)
     1198                                      ).
     1199       end.
     1200       if not valid-handle(p-xmlh)
     1201       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1202         create temp-table v-txmlh.
     1203         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1204         v-txmlh:temp-table-prepare("temp-xml-tables").
     1205         p-xmlh = v-txmlh:default-buffer-handle.
     1206       end.
     1207       do v-ii = 1 to p-dsh:num-buffers:
     1208         p-xmlh:find-first(substitute(' where tbl-name = "&1" and  uniq-gate-rec = "&2" '
     1209                                      ,p-dsh:get-buffer-handle(v-ii):name
     1210                                      ,p-gate-rec
     1211                                      )) no-error.
     1212         if not p-xmlh:available then do:
     1213           p-xmlh:buffer-create().
     1214           assign
     1215           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):table
     1216           p-xmlh::uniq-gate-rec = p-gate-rec
     1217           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1218           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1219           p-xmlh::gate-handle_ = p-dsh
     1220           p-xmlh::gate-name = p-dsh:name
     1221           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1222           .
     1223           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1224             assign
     1225             p-xmlh::order = -3.
     1226           end.
     1227           p-xmlh:buffer-release().
     1228         end.
     1229       end.
     1230   end.
     1231   end procedure.
     1232   procedure gate-clear :
     1233   define input  parameter p-dsh as handle no-undo .
     1234   define input  parameter p-xmlh as handle no-undo .
     1235   define variable v-dsh as handle no-undo .
     1236   define variable v-th as handle no-undo .
     1237     do
     1238     on error undo, return error return-value
     1239     :
     1240       if valid-handle(p-dsh) then do:
     1241         delete object p-dsh.
     1242         v-dsh = p-dsh.
     1243         p-dsh = ?.
     1244       end.
     1245       repeat while true:
     1246         p-xmlh:find-first( substitute( " where gate-handle_ = &1 ", v-dsh)
     1247                            , share-lock) no-error.
     1248         if p-xmlh:available then do:
     1249           assign
     1250           v-th = p-xmlh:buffer-field("table-handle_"):buffer-value.
     1251           if valid-handle(p-xmlh:buffer-field("table-handle_"))
     1252           and valid-handle(v-th)
     1253           and v-th:dynamic = yes
     1254           then do:
     1255             delete object p-xmlh:buffer-field("table-handle_"):buffer-value.
     1256             p-xmlh:buffer-field("table-handle_"):buffer-value = ?.
     1257           end.
     1258           p-xmlh:buffer-delete().
     1259         end.
     1260         else do:
     1261           leave.
     1262         end.
     1263       end.
     1264       if p-xmlh:dynamic = yes
     1265       and valid-handle(p-xmlh)
     1266       then do:
     1267         delete object p-xmlh:table-handle.
     1268         p-xmlh = ?.
     1269       end.
     1270       v-dsh = ?.
     1271     end.
     1272   end procedure.
     1273   procedure all-gates-clear :
     1274   define parameter buffer buf_temp-xml-tables for temp-xml-tables.
     1275   do
     1276   on error undo, return error
     1277   :
     1278     for each buf_temp-xml-tables
     1279     break
     1280     by buf_temp-xml-tables.uniq-gate-rec
     1281     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1282     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1283     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1284     :
     1285         if first-of(buf_temp-xml-tables.uniq-gate-rec) then do:
     1286           delete object buf_temp-xml-tables.gate-handle_.
     1287           buf_temp-xml-tables.gate-handle_ = ?.
     1288         end.
     1289         if valid-handle(buf_temp-xml-tables.table-handle_)
     1290         and buf_temp-xml-tables.table-handle_:dynamic = no
     1291         then do:
     1292           delete object buf_temp-xml-tables.table-handle_.
     1293           buf_temp-xml-tables.table-handle_ = ?.
     1294         end.
     1295         delete buf_temp-xml-tables.
     1296     end.
     1297   end.
     1298   end procedure.
     1299   procedure fix-schemalocation :
     1300   define input-output  parameter p-longchar as longchar no-undo .
     1301   DEFINE VARIABLE hdoc AS HANDLE.
     1302   DEFINE VARIABLE hroot AS HANDLE.
     1303   DEFINE VARIABLE hnode-child AS HANDLE.
     1304   DEFINE VARIABLE hnode-attr AS HANDLE.
     1305   define variable v-jj as integer   no-undo .
     1306   define variable ok as logical   no-undo .
     1307   define variable v-path1                    as character                no-undo .
     1308   DEFINE VARIABLE v-full-path1               as character                no-undo .
     1309   DEFINE VARIABLE v-file-name1               as character                no-undo .
     1310   DEFINE VARIABLE v-file-name-no-ext1        as character                no-undo .
     1311   DEFINE VARIABLE v-file-name-ext1           as character                no-undo .
     1312   define variable v-schema-location          as character                no-undo .
     1313   do
     1314   on error undo, return error return-value
     1315   :
     1316     CREATE X-DOCUMENT hdoc.
     1317     CREATE X-noderef hroot.
     1318     CREATE X-noderef hnode-child.
     1319     CREATE X-noderef hnode-attr.
     1320     hdoc:load("longchar", p-longchar, no) no-error.
     1321     iF ERROR-STATUS:GET-MESSAGE(1) <> '' THEN message ERROR-STATUS:GET-MESSAGE(1) view-as alert-box .
     1322     hdoc:get-document-element(hroot).
     1323     _repeat:
     1324     REPEAT v-jj = 1 TO hroot:NUM-CHILDREN:
     1325       ok = hroot:GET-CHILD(hNode-Child, v-jj).
     1326       if not ok then next.
     1327       if hNode-Child:local-name = "include"
     1328       then do:
     1329         ok = hNode-Child:GET-ATTRIBUTE-NODE( hnode-attr, "schemaLocation" ).
     1330           v-schema-location = hnode-attr:node-value.
     1331           run gbl/filename.p (
     1332                           input "exe/" + hnode-attr:node-value
     1333                         ,output v-full-path1
     1334                         ,output v-path1
     1335                         ,output v-file-name1
     1336                         ,output v-file-name-no-ext1
     1337                         ,output v-file-name-ext1
     1338                         ) no-error .
     1339           if error-status :error then do:
     1340             delete object hnode-attr.
     1341             delete object hnode-child.
     1342             delete object hroot.
     1343             delete object hdoc.
     1344             undo, return error substitute("Не удалось определить расположение схемы &1", v-schema-location).
     1345           end.
     1346         ok = hNode-Child:sET-ATTRIBUTE(  "schemaLocation", v-full-path1 ).
     1347         leave  _repeat.
     1348       end.
     1349     END.
     1350     hdoc:save("longchar", p-longchar).
     1351     delete object hnode-attr.
     1352     delete object hnode-child.
     1353     delete object hroot.
     1354     delete object hdoc.
     1355   end.
     1356   end procedure.
     1357   procedure gate-clb_fill-xml-tables :
     1358   define input parameter p-dsh as handle no-undo .
     1359   define input-output parameter p-xmlh as handle no-undo .
     1360   define variable v-ii as integer no-undo .
     1361     do
     1362     on error undo, return error
     1363     :
     1364       do v-ii = 1 to p-dsh:num-buffers:
     1365         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1366         if not p-xmlh:available then do:
     1367           p-xmlh:buffer-create().
     1368           assign
     1369           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1370           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1371           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1372           p-xmlh::gate-handle_ = p-dsh
     1373           p-xmlh::uniq-gate-rec = entry(2, p-dsh:private-data, chr(4))
     1374           p-xmlh::gate-name = p-dsh:name
     1375           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1376           .
     1377           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1378             assign
     1379             p-xmlh::order = -3.
     1380           end.
     1381           p-xmlh:buffer-release().
     1382         end.
     1383       end.
     1384     end.
     1385   end procedure.
     1386   procedure all-gates-empty :
     1387   define buffer buf_temp-xml-tables for temp-xml-tables.
     1388   do
     1389   on error undo, return error
     1390   :
     1391     for each buf_temp-xml-tables
     1392     break
     1393     by buf_temp-xml-tables.uniq-gate-rec
     1394     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1395     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1396     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1397     :
     1398       if valid-handle(buf_temp-xml-tables.tbl-handle_) then do:
     1399         buf_temp-xml-tables.tbl-handle_:empty-temp-table().
     1400       end.
     1401     end.
     1402   end.
     1403   end procedure.
     1404   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1405   FUNCTION rum-fn_get-next-file-name returns character (
     1406                                       input p-base-file-name as character
     1407                                     , input p-index as integer):
     1408   define variable v-loc-file-name as character no-undo .
     1409   v-loc-file-name = substitute("&1_&2.&3"
     1410                               ,substring(p-base-file-name, 1, (if r-index(p-base-file-name, ".") > 1
     1411                                                         then (r-index(p-base-file-name, ".") - 1)
     1412                                                         else length(p-base-file-name)
     1413                                                         )
     1414                                           )
     1415                               ,p-index
     1416                               ,(if r-index(p-base-file-name, ".") > 1
     1417                                 then substring(p-base-file-name, r-index(p-base-file-name, ".") + 1)
     1418                                 else '')
     1419                                 )
     1420                                 .
     1421   return v-loc-file-name.
     1422   end function.
     1423   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1424   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
     1425   run gbl/getobjsrvhndl.p (input-output ObjSrv).
     1426   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1427   function context_get-thobj-es return logical
     1428   (
     1429      input p-esys-id as integer
     1430     ,input p-eobj-type as character
     1431     ,input p-eobj-code as integer
     1432     ,output p-obj-type as character
     1433     ,output p-obj-code as integer
     1434   ):
     1435      define variable v-value-list as character no-undo .
     1436      define variable v-field-list as character no-undo .
     1437      define buffer buf_clients for ub.clients.
     1438      define buffer buf_ext-classif for ub.ext-classif.
     1439      find first buf_ext-classif no-lock where
     1440                buf_ext-classif.classif-name = 'clients-esys':U
     1441            and buf_ext-classif.classif-subject = 'clients':U
     1442            and buf_ext-classif.db-num = 0
     1443            and buf_Ext-classif.key#_one = p-esys-id
     1444            and buf_Ext-classif.charkey_one = p-eobj-type
     1445            and buf_Ext-classif.key#_two = p-eobj-code no-error .
     1446      if available buf_Ext-classif
     1447      then do:
     1448         ObjSrv:Lib:KeyRec:GenKeyFv (
     1449                                         input buf_Ext-classif.uniq-key-rec
     1450                                         ,output v-field-list
     1451                                         ,output v-value-list).
     1452         assign
     1453            p-obj-type = entry(lookup("obj-type":U
     1454                                     , v-field-list
     1455                                     , chr(3))
     1456                                     , v-value-list, chr(3))
     1457            p-obj-code = integer(entry(lookup("obj-code":U
     1458                                            , v-field-list
     1459                                            , chr(3))
     1460                                      , v-value-list
     1461                                      , chr(3)))
     1462         no-error .
     1463      end.
     1464      if     available buf_ext-classif
     1465         and (p-obj-type = 'маг':U
     1466              or
     1467              p-obj-type = 'скл':U
     1468              )
     1469         and (p-obj-code > 0 and p-obj-code <= 99999)
     1470      then do:
     1471         find first buf_clients no-lock where
     1472                    buf_clients.obj-type = p-obj-type
     1473                and buf_clients.obj-code = p-obj-code no-error.
     1474         if available buf_clients then do:
     1475            return yes.
     1476         end.
     1477         else do:
     1478            assign
     1479               p-obj-type = '':U
     1480               p-obj-code = 0
     1481            .
     1482            return no.
     1483         end.
     1484      end.
     1485      else do:
     1486         assign
     1487            p-obj-type = '':U
     1488            p-obj-code = 0
     1489         .
     1490         return no.
     1491      end.
     1492   end.
