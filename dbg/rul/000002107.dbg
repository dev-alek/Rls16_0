     2304     define variable v-ext-doc-type          as character  no-undo .
     2305     define variable v-trn-doc-obj-type  as character  no-undo .
     2306     define variable v-trn-doc-obj-code  as integer    no-undo .
     2307     define variable v-obj-db-num        as integer    no-undo .
     2308     define variable v-obj-uniq-key-rec  as character  no-undo .
     2309     define variable v-b-code            as integer    no-undo .
     2310     define variable v-main-b-code       as integer    no-undo .
     2311     define variable v-gds-name-full     as character  no-undo .
     2312     define variable v-node-name         as character  no-undo .
     2313     define variable v-agnt-id           as integer    no-undo .
     2314     define variable v-obj-type          as character  no-undo .
     2315     define variable v-obj-code          as integer    no-undo .
     2316     define variable v-tot-rubl          as decimal    no-undo .
     2317     define variable v-ext-num           as character  no-undo .
     2318     define variable v-table-name        as character  no-undo .
     2319     define variable v-cli-type          as character  no-undo .
     2320     define variable v-cli-code          as integer    no-undo .
     2321     define variable v-cli-id            as integer    no-undo .
     2322     define variable v-obj-id            as integer    no-undo .
     2323     define variable v-from-store-id     as integer    no-undo .
     2324     define variable v-to-store-id       as integer    no-undo .
     2325     define variable v-p-date            as datetime-tz  no-undo .
     2326     define variable v-ext-artic         as character  no-undo .
     2327     define buffer buf_clients for ub.clients.
     2328     define buffer buf_ext-classif for ub.ext-classif.
     2329     define buffer buf_trn-doc for ub.trn-doc .
     2330     define buffer buf_gds-dtl for ub.gds-dtl.
     2331     define buffer buf_doc-line for ub.doc-line.
     2332     define buffer buf_gds-prt for ub.gds-prt.
     2333     define buffer buf_goods for ub.goods.
     2334     define buffer buf_ext-artic for ub.ext-artic.
     2335     define buffer buf_ext-system for ub.ext-system.
     2336     define variable expObj as class expsubject no-undo .
     2337     define variable subDocObj as class iexpsubject no-undo .
     2338     if v-has-newbh then do:
     2339       v-trn-doc-obj-type = v-newbh::obj-type.
     2340       v-trn-doc-obj-code = v-newbh::obj-code.
     2341       v-doc-code = v-newbh:buffer-field("doc-code"):buffer-value.
     2342       v-ext-doc-type = v-newbh:buffer-field("doc-type"):buffer-value.
     2343       v-p-date = v-newbh:buffer-field("doc-date"):buffer-value.
     2344     end.
     2345     else do:
     2346       v-trn-doc-obj-type = v-oldbh::obj-type.
     2347       v-trn-doc-obj-code = v-oldbh::obj-code.
     2348       v-doc-code = v-oldbh:buffer-field("doc-code"):buffer-value.
     2349       v-ext-doc-type = v-oldbh:buffer-field("doc-type"):buffer-value.
     2350     end.
     2351     if v-has-newbh
     2352     then do:
     2353       v-doc-status = v-newbh:buffer-field("status_"):buffer-value.
     2354     end.
     2355     v-doc-status-old = v-oldbh:buffer-field("status_"):buffer-value.
     2356     if not (v-doc-status-old = 'факт':U and not v-has-newbh) and (v-doc-status = v-doc-status-old or not v-doc-status = 'факт':U)
     2357       then return.
     2358     IF  context_begin-esys-command( input string(v-esys-id-list), input-output v-esys-cmd-proc-handle, output v-esys-cmd-code) = false  THEN do:
     2359       undo _main, return error v-last-error-message .
     2360     end.
     2361     subDocObj = new fbr-gd-doc ().
     2362     cast (subDocObj, fbr-gd-doc):BufTableHndlNew = v-newbh.
     2363     cast (subDocObj, fbr-gd-doc):BufTableHndlOld = v-oldbh.
     2364     expObj = new expsubject ().
     2365     expObj:GetContent(subDocObj) no-error.
     2366     if error-status:error
     2367     then
     2368        undo _main, return error if expObj:Msg <> "" then expObj:Msg else return-value  .
     2369   IF ExpData1:esys-add-dump-data ( INPUT expObj:Data,
     2370                                    INPUT v-esys-cmd-proc-handle,
     2371                                    INPUT v-esys-cmd-code,
     2372                                    '+update' + chr(4) + expObj:InitSecTag +
     2373                                     (if expObj:sendTableName <> ""
     2374                                      then substitute("&1&2&3&4",chr(4),
     2375                                                      expObj:sendTableName,
     2376                                                      if expObj:sendOldRowid <> ? then substitute("&1&2",chr(3),expObj:sendOldRowid) else "",
     2377                                                      if expObj:sendNewRowid <> ? then substitute("&1&2",chr(3),expObj:sendNewRowid) else "")
     2378                                      else "")) = false  THEN do:
     2379       undo _main, return error v-last-error-message .
     2380     end.
     2381     IF  context_set-custom-esys-pck-name(  input v-esys-cmd-proc-handle, input v-esys-cmd-code, input v-custom-pack-name) = false  THEN do:
     2382       undo _main, return error v-last-error-message .
     2383     end.
     2384     v-dump-ord-int64 = context_send-esys-command( input v-esys-id-list
     2385                                 , input v-esys-cmd-proc-handle
     2386                                 , input v-esys-cmd-code
     2387                                 , input g#userid).
     2388     if v-dump-ord-int64 = 0 THEN do:
     2389       undo _main, return error v-last-error-message .
     2390     end.
     2391       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute( "Успешно. " + subDocObj:Msg)).
     2392     num-rec-ok = num-rec-ok + 1.
     2393       ExpData1:Route-data_clear-data ( ) .
     2394   end.
     2395   end procedure.
     2396   procedure load-ruleset-context :
     2397   define input parameter p-ruleset-id as integer    no-undo .
     2398   define variable v-flag              as logical    no-undo .
     2399   define variable v-ii                as integer    no-undo .
     2400   define variable v-changes-list2     as character  no-undo .
     2401   define variable v-obj-db-num        as integer    no-undo .
     2402   define variable v-is-waiting-status as logical    no-undo .
     2403   define variable v-direction         as character  no-undo .
     2404   define variable v-direction-2       as character  no-undo .
     2405   define variable v-waiting-status    as character  no-undo .
     2406   define variable v-ext-doc-type      as character  no-undo .
     2407   define buffer buf_rule-call-param for ub.rule-call-param.
     2408   define buffer buf_ext-system for ub.ext-system.
     2409   define buffer buf_clients for ub.clients.
     2410   do
     2411   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2412   on stop   undo, return error substitute( "&1. stop", vss-workfile )
     2413   on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     2414   :
     2415     assign
     2416       v-oldbh = widget-handle (entry(2, p-doc-code, chr(4)))
     2417       v-newbh = widget-handle (entry(3, p-doc-code, chr(4)))
     2418       v-changes-list = entry(4, p-doc-code, chr(4))
     2419       file-name  = p-process-file-name
     2420       v-has-oldbh = valid-handle(v-oldbh) and v-oldbh:available
     2421       v-has-newbh = valid-handle(v-newbh) and v-newbh:available
     2422     .
     2423     if not v-has-newbh
     2424     and not v-has-oldbh then do:
     2425       undo, return error substitute("Не определено ни одного буфера - ни старый, ни новый").
     2426     end.
     2427     if not v-has-oldbh
     2428     and v-changes-list  = '' then do:
     2429        undo, return error substitute("Не определен старый буфер и список изменений").
     2430     end.
     2431     case p-ruleset-id:
     2432       when 155 then do:
     2433         if v-has-newbh
     2434         and v-newbh:table <> 'fbr-doc':U then do:
     2435           undo, return error substitute("Передан неверный буфер вместо буфера для &1",  'trn-doc':U).
     2436         end.
     2437         if v-has-oldbh
     2438         and v-oldbh:table <> 'fbr-doc':U and v-oldbh:TABLE <> "tt-fbr" then do:
     2439           undo, return error substitute("Передан неверный буфер вместо буфера для &1",  'trn-doc':U).
     2440         end.
     2441       end.
     2442       otherwise do:
     2443         undo, return error substitute("Неверный вызов &1 для набора правил &2", vss-workfile , p-ruleset-id).
     2444       end.
     2445     end case.
     2446       if num-entries(v-direction, chr(4)) > 1 then do:
     2447       v-direction-2 = entry(2, v-direction, chr(4)).
     2448       v-direction = entry(1, v-direction, chr(4)).
     2449       if v-direction-2 <> "to"
     2450       and v-direction-2 <> "from" then return "return".
     2451       if v-direction = '<открытие документа>':U
     2452       and v-direction-2 = "to" then return "return".
     2453     end.
     2454     if v-direction = '<открытие документа>':U
     2455     or v-direction = 'удаление':U
     2456     or (v-direction = '<закрытие документа>':U and v-newbh::status_ = 'факт':U )
     2457     then do:
     2458       v-action = 'D':U.
     2459     end.
     2460     else do:
     2461       v-action = 'U':U.
     2462     end.
     2463     for each buf_rule-call-param no-lock where
     2464     buf_rule-call-param.codex_id = p-codex-id
     2465     and buf_rule-call-param.ruleset_id = p-ruleset-id
     2466     and buf_rule-call-param.call_id = p-call-id
     2467     and buf_rule-call-param.order_id = p-order-id
     2468     and buf_rule-call-param.rule_id = p-rule-id
     2469     and buf_rule-call-param.param-name = "p-esys-id",
     2470       first buf_ext-system no-lock where
     2471             buf_Ext-system.esys-id = buf_rule-call-param.param-value-integer
     2472         and buf_Ext-system.db-num = 0
     2473         and buf_Ext-system.esys-have-export = yes
     2474         and buf_Ext-system.esys-db-num-exp = g#db-num:
     2475       v-esys-id-list = v-esys-id-list + (if v-esys-id-list = '' then '' else chr(1)) + string(buf_ext-system.esys-id).
     2476     end.
     2477     if v-esys-id-list = '' then return "return".
     2478     find first buf_rule-call-param no-lock where
     2479   buf_rule-call-param.codex_id = p-codex-id
     2480   and buf_rule-call-param.ruleset_id = p-ruleset-id
     2481   and buf_rule-call-param.call_id = p-call-id
     2482   and buf_rule-call-param.order_id = p-order-id
     2483   and buf_rule-call-param.rule_id = p-rule-id
     2484   and buf_rule-call-param.param-name = "p-xsd-file"
     2485    no-error.
     2486   if available buf_rule-call-param then do:
     2487     assign p-xsd-file = buf_rule-call-param.param-value-character.
     2488   end.
     2489   end.
     2490   end procedure.
