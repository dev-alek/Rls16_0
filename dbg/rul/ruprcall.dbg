     2132                 and buf_rule-call-param.param-name = tt0-rule-call-param.param-name
     2133                 and buf_rule-call-param.p-index = tt0-rule-call-param.p-index
     2134                 no-error.
     2135           if not available buf_rule-call-param then do:
     2136             if v-call#-id = 0 then do:
     2137               run rul/g-callid.p ( input p-call-type
     2138                                   ,input p-call-id
     2139                                   ,output v-call#-id).
     2140             end.
     2141             create buf_rule-call-param.
     2142             assign
     2143             v-cmp-loc = no
     2144             v-cmp = v-cmp and v-cmp-loc
     2145             .
     2146           end.
     2147           else do:
     2148             buffer-compare tt0-rule-call-param
     2149             except call#_id to buf_rule-call-param save result in v-cmp-loc.
     2150           end.
     2151           buffer-copy tt0-rule-call-param
     2152           except call#_id
     2153           to buf_rule-call-param
     2154           assign
     2155           buf_rule-call-param.call#_id = v-call#-id
     2156           .
     2157           if not v-cmp-loc and v-run-bush-command then do:
     2158              run add-dump in p-cmd-proc-handle                                                                              (input p-cmd-code                                                                                            ,input 'rule-call-param':U                                                                                          ,input '+update'                                                                                         ,input buffer buf_rule-call-param:handle                                                                                    ,input '':U                                                                                                  ,output v-rec-ord                                                                                            ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                       if v-create-command then delete procedure p-cmd-proc-handle.                                                 undo _main, return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'rule-call-param':U                                                                                                ,p-cmd-code                                                                                                  ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
     2159           end.
     2160         end.
     2161       end.
     2162       define variable v-can-run as logical no-undo .
     2163       _rule-by-call:
     2164       for each buf_rule-by-call exclusive-lock where
     2165                 buf_rule-by-call.call_id = p-call-id,
     2166         first buf_rule no-lock where
     2167               buf_rule.rule_id = buf_rule-by-call.rule_id
     2168       by buf_rule-by-call.call_Id
     2169       by buf_rule-by-call.codex_id
     2170       by buf_rule-by-call.ruleset_id
     2171       by buf_rule-by-call.order_id
     2172       on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2173       on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
     2174       on endkey undo _main, return error substitute( "&1. endkey", vss-workfile ) :
     2175         run check-reusable in this-procedure ( input p-call-id
     2176                                                 ,input buf_rule-by-call.codex_id
     2177                                                 ,input buf_rule-by-call.ruleset_id
     2178                                                 ,input buf_rule-by-call.order_id
     2179                                                 ,input buf_rule-by-call.profile_id
     2180                                                 ,input buf_rule-by-call.rule_id
     2181                                                 ,input buf_rule.reusable-params
     2182                                                 ,output v-can-run
     2183                                                 ).
     2184         if buf_rule-by-call.can-run <> v-can-run
     2185         or (v-can-run = no and buf_rule-by-call.can-calc = yes)
     2186         or (v-can-run = yes and buf_rule-by-call.can-calc = no and not buf_rule-by-call.is_dynamic  )
     2187         then do:
     2188           assign
     2189           v-old-can-run = buf_rule-by-call.can-run
     2190           v-old-can-calc = buf_rule-by-call.can-calc
     2191           buf_rule-by-call.can-run = v-can-run
     2192           buf_rule-by-call.can-calc = (if v-can-run
     2193                                         then (if not buf_rule-by-call.is_dynamic
     2194                                               then yes
     2195                                               else buf_rule-by-call.can-calc)
     2196                                         else no)
     2197           v-cmp-loc = ((v-old-can-run = buf_rule-by-call.can-run)
     2198                         and
     2199                         (v-old-can-calc = buf_rule-by-call.can-calc)
     2200                       )
     2201           .
     2202           if not v-cmp-loc and v-run-bush-command then do:
     2203             run add-dump in p-cmd-proc-handle                                                                              (input p-cmd-code                                                                                            ,input 'rule-by-call':U                                                                                          ,input '+update'                                                                                         ,input buffer buf_rule-by-call:handle                                                                                    ,input '':U                                                                                                  ,output v-rec-ord                                                                                            ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                       if v-create-command then delete procedure p-cmd-proc-handle.                                                 undo _main, return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'rule-by-call':U                                                                                                ,p-cmd-code                                                                                                  ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
     2204           end.
     2205         end.
     2206       end.
     2207     end.
     2208     if v-create-command then do:
     2209       run send-command in p-cmd-proc-handle
     2210         ( input p-cmd-code
     2211           ,input '':U
     2212           ) no-error .
     2213       if error-status:error then do:
     2214         delete procedure p-cmd-proc-handle .
     2215         message
     2216         vss-workfile vss-revision vss-description skip
     2217         substitute( "Ошибка при отсылке команды &1", v-command ) skip
     2218         error-status :get-message(1) skip
     2219         return-value skip
     2220         view-as alert-box error .
     2221         undo _main, return error .
     2222       end.
     2223     end.
     2224   end.
     2225   procedure update-prop-ref-call :
     2226   define input parameter p-param-data-type as character no-undo .
     2227   define input parameter p-param-2-data-type as character no-undo .
     2228   define input parameter p-param-3-data-type as character no-undo .
     2229   define input parameter p-value-character as character no-undo .
     2230   define input parameter p-call-id as character no-undo .
     2231   define variable v-dtm-code as integer no-undo init -1.
     2232   define buffer buf_prop-ref for ub.prop-ref.
     2233   define buffer buf_prop-ref-call for ub.prop-ref-call.
     2234   _main:
     2235   do
     2236   on error undo, return error
     2237   :
     2238     if p-param-2-data-type begins ('prop-ref':U + "_") then do:
     2239       assign
     2240       v-dtm-code = integer(entry(2, p-param-2-data-type, "_"))
     2241       no-error
     2242       .
     2243       find first buf_prop-ref no-lock where
     2244           buf_prop-ref.dtm-code = v-dtm-code
     2245       and buf_prop-ref.sum-id = p-value-character no-error .
     2246       if available buf_prop-ref then do:
     2247         find first buf_prop-ref-call where
     2248                   buf_prop-ref-call.dt-code = buf_prop-ref.dt-code
     2249               and buf_prop-ref-call.call_id = p-call-id no-error .
     2250         if not available buf_prop-ref-call then do:
     2251           if v-call#-id = 0 then do:
     2252             run rul/g-callid.p ( input p-call-type
     2253                                 ,input p-call-id
     2254                                 ,output v-call#-id).
     2255           end.
     2256           create buf_prop-ref-call.
     2257           assign
     2258           buf_prop-ref-call.call_id = p-call-id
     2259           buf_prop-ref-call.dt-code = buf_prop-ref.dt-code
     2260           buf_prop-ref-call.dtm-code = buf_prop-ref.dtm-code
     2261           buf_prop-ref-call.call#_id = v-call#-id
     2262           .
     2263         end.
     2264         find first temp-prop-ref-call where
     2265                   temp-prop-ref-call.dt-code = buf_prop-ref.dt-code no-error.
     2266         if not available temp-prop-ref-call then do:
     2267           create temp-prop-ref-call.
     2268           buffer-copy buf_prop-ref-call to temp-prop-ref-call.
     2269         end.
     2270         assign
     2271         temp-prop-ref-call.counter = temp-prop-ref-call.counter + 1
     2272         buf_prop-ref-call.counter = temp-prop-ref-call.counter.
     2273         release temp-prop-ref-call.
     2274         if v-run-bush-command then do:
     2275              run add-dump in p-cmd-proc-handle                                                                              (input p-cmd-code                                                                                            ,input 'prop-ref-call':U                                                                                          ,input '+update'                                                                                         ,input buffer buf_prop-ref-call:handle                                                                                    ,input '':U                                                                                                  ,output v-rec-ord                                                                                            ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                       if v-create-command then delete procedure p-cmd-proc-handle.                                                 undo _main, return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'prop-ref-call':U                                                                                                ,p-cmd-code                                                                                                  ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
     2276         end.
     2277       end.
     2278     end.
     2279   end.
     2280   end procedure.
     2281   procedure delete-prop-ref-call :
     2282   define input parameter p-param-data-type as character no-undo .
     2283   define input parameter p-param-2-data-type as character no-undo .
     2284   define input parameter p-param-3-data-type as character no-undo .
     2285   define input parameter p-value-character as character no-undo .
     2286   define input parameter p-call-id as character no-undo .
     2287   define variable v-dtm-code as integer no-undo init -1.
     2288   define variable v-ok as logical no-undo .
     2289   define variable v-mwss as character no-undo .
     2290   define buffer buf_prop-ref for ub.prop-ref.
     2291   define buffer buf_prop-ref-call for ub.prop-ref-call.
     2292   _main:
     2293   do
     2294   on error undo, return error
     2295   :
     2296     if  p-param-2-data-type begins ('prop-ref':U + "_") then do:
     2297       assign
     2298       v-dtm-code = integer(entry(2, p-param-2-data-type, "_"))
     2299       no-error
     2300       .
     2301       find first buf_prop-ref no-lock where
     2302           buf_prop-ref.dtm-code = v-dtm-code
     2303       and buf_prop-ref.sum-id = p-value-character no-error .
     2304       if available buf_prop-ref then do:
     2305         find first buf_prop-ref-call where
     2306                   buf_prop-ref-call.dt-code = buf_prop-ref.dt-code
     2307               and buf_prop-ref-call.call_id = p-call-id no-error .
     2308         if available buf_prop-ref-call then do:
     2309           buf_prop-ref-call.counter = buf_prop-ref-call.counter - 1.
     2310           if buf_prop-ref-call.counter = 0 then do:
     2311             run rul/pref-chk.p ( input 'удаление':U
     2312                                 ,input "ruprcall"
     2313                                 ,input buf_prop-ref-call.dtm-code
     2314                                 ,input buf_prop-ref-call.dt-code
     2315                                 ,output v-ok
     2316                                 ,output v-mess) no-error .
     2317             if v-ok then do:
     2318               if v-run-bush-command then do:
     2319                             run add-dump in p-cmd-proc-handle                                                                              (input p-cmd-code                                                                                            ,input 'prop-ref-call':U                                                                                          ,input '+delete'                                                                                         ,input buffer buf_prop-ref-call:handle                                                                                    ,input '':U                                                                                                  ,output v-rec-ord                                                                                            ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                       if v-create-command then delete procedure p-cmd-proc-handle.                                                 undo _main, return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'prop-ref-call':U                                                                                                ,p-cmd-code                                                                                                  ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
     2320               end.
     2321               delete buf_prop-ref-call.
     2322             end.
     2323           end.
     2324         end.
     2325       end.
     2326     end.
     2327   end.
     2328   end procedure.
     2329   procedure update-dis-rule :
     2330   define input parameter p-param-data-type as character no-undo .
     2331   define input parameter p-param-2-data-type as character no-undo .
     2332   define input parameter p-param-3-data-type as character no-undo .
     2333   define input parameter p-param-value-integer as integer no-undo .
     2334   define input parameter p-call-id as character no-undo .
     2335   define variable v-templ-rl-root as integer no-undo.
     2336   define variable v-type as character no-undo .
     2337   define variable v-emitent-host-code as integer no-undo .
     2338   define variable v-field-list as character no-undo .
     2339   define variable v-value-list as character no-undo .
     2340   define variable jj as integer no-undo .
     2341   define variable v-nonunique as character no-undo .
     2342   define variable v-curr-field as character no-undo .
     2343   define buffer buf_dis-rule for ub.dis-rule.
     2344   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
     2345   define buffer buf_dis-dct-rule for ub.dis-dct-rule.
     2346   _main:
     2347   do
     2348   on error undo, return error
     2349   :
     2350     if p-param-2-data-type begins ('dis-rule':U + "_")
     2351     then do:
     2352       assign
     2353       v-templ-rl-root = integer(entry(2, p-param-2-data-type, "_"))
     2354       no-error
     2355       .
     2356       case p-call-type:
     2357         when 'dis-card-type':U then do:
     2358           run gen-key-fv in this-procedure ( input p-call-id
     2359                                             ,output v-field-list
     2360                                             ,output v-value-list).
     2361           assign
     2362           v-type =  entry(lookup("type", v-field-list, chr(3)), v-value-list, chr(3))
     2363           v-emitent-host-code = integer(entry(lookup("emitent-host-code", v-field-list, chr(3)), v-value-list, chr(3)))
     2364           .
     2365           find first buf_dis-cfg-rule no-lock where
     2366               buf_dis-cfg-rule.templ-rl-root = v-templ-rl-root
     2367           and buf_dis-cfg-rule.pos-type = 'bo':U
     2368           and buf_dis-cfg-rule.table-name = 'dis-dct-rule':U no-error .
     2369           if available buf_Dis-cfg-rule then do:
     2370             find first buf_dis-rule no-lock where
     2371                         buf_dis-rule.rule-num = p-param-value-integer no-error.
     2372             if available buf_dis-rule then do:
     2373               do jj = 1 to num-entries(buf_dis-cfg-rule.nonunique):
     2374                 assign
     2375                 v-curr-field = entry(jj, buf_dis-cfg-rule.nonunique)
     2376                 .
     2377                 assign
     2378                 v-nonunique = v-nonunique + (if v-nonunique = '':u then '':U else chr(4)) +
     2379                               string(buffer buf_dis-rule:buffer-field(v-curr-field):buffer-value).
     2380               end.
     2381               find first buf_dis-dct-rule where
     2382                     buf_dis-dct-rule.type = v-type
     2383                 and buf_dis-dct-rule.emitent-host-code = v-emitent-host-code
     2384                 and buf_dis-dct-rule.host-code = buf_dis-rule.host-code
     2385                 and buf_dis-dct-rule.obj-type = buf_dis-rule.obj-type
     2386                 and buf_dis-dct-rule.obj-code = buf_dis-rule.obj-code
     2387                 and buf_dis-dct-rule.pos-type = 'bo':U
     2388                 and buf_dis-dct-rule.nonunique = v-nonunique
     2389                 and buf_dis-dct-rule.discnt-role = buf_dis-cfg-rule.discnt-role
     2390                 no-error .
     2391               if not available buf_dis-dct-rule then do:
     2392                 create buf_dis-dct-rule.
     2393                 assign
     2394                 buf_dis-dct-rule.type = v-type
     2395                 buf_dis-dct-rule.emitent-host-code = v-emitent-host-code
     2396                 buf_dis-dct-rule.templ-rl-root = buf_dis-rule.templ-rl-root
     2397                 buf_dis-dct-rule.time-templ-rl-root = buf_dis-rule.time-templ-rl-root
     2398                 buf_dis-dct-rule.rule-num = buf_dis-rule.rule-num
     2399                 buf_dis-dct-rule.host-code = buf_dis-rule.host-code
     2400                 buf_dis-dct-rule.obj-type = buf_dis-rule.obj-type
     2401                 buf_dis-dct-rule.obj-code = buf_dis-rule.obj-code
     2402                 buf_dis-dct-rule.pos-type = 'bo':U
     2403                 buf_dis-dct-rule.nonunique = v-nonunique
     2404                 buf_dis-dct-rule.discnt-role = buf_dis-cfg-rule.discnt-role
     2405                 buf_dis-dct-rule.rl-root = buf_dis-rule.rl-root
     2406                 .
     2407                 if v-run-bush-command then do:
     2408                                             run add-dump in p-cmd-proc-handle                                                                              (input p-cmd-code                                                                                            ,input 'dis-dct-rule':U                                                                                          ,input '+update'                                                                                         ,input buffer buf_dis-dct-rule:handle                                                                                    ,input '':U                                                                                                  ,output v-rec-ord                                                                                            ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                       if v-create-command then delete procedure p-cmd-proc-handle.                                                 undo _main, return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'dis-dct-rule':U                                                                                                ,p-cmd-code                                                                                                  ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
     2409                 end.
     2410               end.
     2411             end.
     2412           end.
     2413         end.
     2414       end case.
     2415     end.
     2416   end.
     2417   end procedure.
     2418   procedure delete-dis-rule :
     2419   define input parameter p-param-data-type as character no-undo .
     2420   define input parameter p-param-2-data-type as character no-undo .
     2421   define input parameter p-param-3-data-type as character no-undo .
     2422   define input parameter p-value-integer as integer no-undo .
     2423   define input parameter p-call-id as character no-undo .
     2424   define parameter buffer buf_rule-call-param for ub.rule-call-param.
     2425   define variable v-templ-rl-root as integer no-undo.
     2426   define variable v-type as character no-undo .
     2427   define variable v-emitent-host-code as integer no-undo .
     2428   define variable v-field-list as character no-undo .
     2429   define variable v-value-list as character no-undo .
     2430   define variable v-found as logical no-undo .
     2431   define buffer buf_dis-rule for ub.dis-rule.
     2432   define buffer buf_dis-dct-rule for ub.dis-dct-rule.
     2433   define buffer buf_tt0-rule-call-param for tt0-rule-call-param.
     2434   _main:
     2435   do
     2436   on error undo, return error
     2437   :
     2438     if  p-param-2-data-type begins ('dis-rule':U + "_") then do:
     2439       assign
     2440       v-templ-rl-root = integer(entry(2, p-param-2-data-type, "_"))
     2441       no-error
     2442       .
     2443       case p-call-type:
     2444         when 'dis-card-type':U then do:
     2445           run gen-key-fv in this-procedure ( input p-call-id
     2446                                             ,output v-field-list
     2447                                             ,output v-value-list).
     2448           assign
     2449           v-type =  entry(lookup("type", v-field-list, chr(3)), v-value-list, chr(3))
     2450           v-emitent-host-code = integer(entry(lookup("emitent-host-code", v-field-list, chr(3)), v-value-list, chr(3)))
     2451           .
     2452           v-found = no.
     2453           _buf_tt0-rule-call-param:
     2454           for each buf_tt0-rule-call-param no-lock where
     2455                   buf_tt0-rule-call-param.call_id = p-call-id:
     2456             if buf_tt0-rule-call-param.param-2-data-type = p-param-2-data-type
     2457             and buf_tt0-rule-call-param.param-value-integer = p-value-integer
     2458             then do:
     2459               v-found = yes.
     2460               leave _buf_tt0-rule-call-param.
     2461             end.
     2462           end.
     2463           if not v-found then do:
     2464             for each buf_dis-dct-rule where
     2465                       buf_dis-dct-rule.rule-num = p-value-integer
     2466                   and buf_dis-dct-rule.templ-rl-root = v-templ-rl-root
     2467                   and buf_dis-dct-rule.type = v-type
     2468                   and buf_dis-dct-rule.emitent-host-code = v-emitent-host-code
     2469             on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2470             on stop   undo , return error substitute( "&1. stop", vss-workfile )
     2471             on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     2472             :
     2473               if v-run-bush-command then do:
     2474                             run add-dump in p-cmd-proc-handle                                                                              (input p-cmd-code                                                                                            ,input 'dis-dct-rule':U                                                                                          ,input '+delete'                                                                                         ,input buffer buf_dis-dct-rule:handle                                                                                    ,input '':U                                                                                                  ,output v-rec-ord                                                                                            ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                       if v-create-command then delete procedure p-cmd-proc-handle.                                                 undo _main, return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'dis-dct-rule':U                                                                                                ,p-cmd-code                                                                                                  ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
     2475               end.
     2476               delete buf_dis-dct-rule.
     2477             end.
     2478           end.
     2479         end.
     2480       end case.
     2481     end.
     2482   end.
     2483   end procedure.
     2484   procedure update-ext-system :
     2485   define input parameter p-param-data-type as character no-undo .
     2486   define input parameter p-param-2-data-type as character no-undo .
     2487   define input parameter p-param-3-data-type as character no-undo .
     2488   define input parameter p-param-value-integer as integer no-undo .
     2489   define input parameter p-call-id as character no-undo .
     2490   define variable v-resource-id as character no-undo .
     2491   define buffer buf_ext-system for ub.ext-system.
     2492   _main:
     2493   do
     2494   on error undo, return error
     2495   :
     2496     if p-param-2-data-type =  'ext-system':U
     2497     then do:
     2498       case p-call-type:
     2499         when 'dis-card-type':U then do:
     2500           find first buf_ext-system no-lock where
     2501                     buf_ext-system.esys-id = p-param-value-integer
     2502                 and buf_ext-system.db-num = 0.
     2503           run gen-key-rec in this-procedure (
     2504                                               input 'ext-system':U
     2505                                              ,input (buffer buf_ext-system:handle)
     2506                                              ,output v-resource-id).
     2507           if v-call#-id = 0 then do:
     2508             run rul/g-callid.p ( input p-call-type
     2509                                 ,input p-call-id
     2510                                 ,output v-call#-id).
     2511           end.
     2512           run who-lk_make-some-lk in this-procedure (
     2513                                                      input v-resource-id
     2514                                                     ,input p-call-id
     2515                                                     ,input v-call#-id
     2516                                                     ,input 'update-delete':U
     2517                                                     ,input g#db-num
     2518                                                     ,input substitute("&1: Параметр работы алгоритма", calldscr(p-call-id))
     2519                                                     ,input ""
     2520                                                     ).
     2521         end.
     2522       end case.
     2523     end.
     2524   end.
     2525   end procedure.
     2526   procedure delete-ext-system :
     2527   define input parameter p-param-data-type as character no-undo .
     2528   define input parameter p-param-2-data-type as character no-undo .
     2529   define input parameter p-param-3-data-type as character no-undo .
     2530   define input parameter p-value-integer as integer no-undo .
     2531   define input parameter p-call-id as character no-undo .
     2532   define parameter buffer buf_rule-call-param for ub.rule-call-param.
     2533   define variable v-resource-id as character no-undo .
     2534   define buffer buf_ext-system for ub.ext-system.
     2535   _main:
     2536   do
     2537   on error undo, return error
     2538   :
     2539     if  p-param-2-data-type = 'ext-system':U then do:
     2540       case p-call-type:
     2541         when 'dis-card-type':U then do:
     2542           find first buf_ext-system no-lock where
     2543                     buf_ext-system.esys-id = p-value-integer
     2544                 and buf_ext-system.db-num = 0 no-error.
     2545           if not available buf_Ext-system then return.
     2546           run gen-key-rec in this-procedure (
     2547                                               input 'ext-system':U
     2548                                              ,input (buffer buf_ext-system:handle)
     2549                                              ,output v-resource-id).
     2550           run who-lk_delete-some-lk in this-procedure (
     2551                                                      input v-resource-id
     2552                                                     ,input p-call-id
     2553                                                     ,input 'update-delete':U
     2554                                                     ,input g#db-num
     2555                                                     ).
     2556         end.
     2557       end case.
     2558     end.
     2559   end.
     2560   end procedure.
     2561   procedure delete-from-rp-by-call:
     2562   define input parameter p-call-id as character no-undo .
     2563   define input parameter p-profile-id as integer no-undo .
     2564   define input parameter p-once-more as integer no-undo .
     2565   define buffer buf_rule-by-call for ub.rule-by-call.
     2566   define buffer buf_rule-call-param for ub.rule-call-param.
     2567   _main:
     2568   do
     2569   on error undo, return error
     2570   :
     2571     for each buf_rule-by-call share-lock where
     2572            buf_rule-by-call.call_id = p-call-id
     2573        and buf_rule-by-call.profile_id = p-profile-id
     2574        and buf_rule-by-call.once-more = p-once-more
     2575     on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2576     on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
     2577     on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
     2578     :
     2579       for each buf_rule-call-param share-lock where
     2580              buf_rule-call-param.call_id = buf_rule-by-call.call_id
     2581          and buf_rule-call-param.codex_id = buf_rule-by-call.codex_id
     2582          and buf_rule-call-param.ruleset_id = buf_rule-by-call.ruleset_id
     2583          and buf_rule-call-param.order_id = buf_rule-by-call.order_id
     2584       on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2585       on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
     2586       on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
     2587       :
     2588           if buf_rule-call-param.p-index > 0
     2589           or lookup("LIST", buf_rule-call-param.param-3-data-type) = 0
     2590           or lookup("SORTED-LIST", buf_rule-call-param.param-3-data-type) = 0
     2591           then do:
     2592             run delete-prop-ref-call in this-procedure ( input buf_rule-call-param.param-data-type
     2593                                                         ,input buf_rule-call-param.param-2-data-type
     2594                                                         ,input buf_rule-call-param.param-3-data-type
     2595                                                         ,input buf_rule-call-param.param-value-character
     2596                                                         ,input buf_rule-call-param.call_id).
     2597             run delete-dis-rule in this-procedure (  input buf_rule-call-param.param-data-type
     2598                                                     ,input buf_rule-call-param.param-2-data-type
     2599                                                     ,input buf_rule-call-param.param-3-data-type
     2600                                                     ,input buf_rule-call-param.param-value-integer
     2601                                                     ,input buf_rule-call-param.call_id
     2602                                                     ,buffer buf_rule-call-param
     2603                                                     ).
     2604             run delete-ext-system in this-procedure (  input buf_rule-call-param.param-data-type
     2605                                                     ,input buf_rule-call-param.param-2-data-type
     2606                                                     ,input buf_rule-call-param.param-3-data-type
     2607                                                     ,input buf_rule-call-param.param-value-integer
     2608                                                     ,input buf_rule-call-param.call_id
     2609                                                     ,buffer buf_rule-call-param
     2610                                                     ).
     2611           end.
     2612           if v-run-bush-command then do:
     2613             run add-dump in p-cmd-proc-handle                                                                              (input p-cmd-code                                                                                            ,input 'rule-call-param':U                                                                                          ,input '+delete'                                                                                         ,input buffer buf_rule-call-param:handle                                                                                    ,input '':U                                                                                                  ,output v-rec-ord                                                                                            ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                       if v-create-command then delete procedure p-cmd-proc-handle.                                                 undo _main, return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'rule-call-param':U                                                                                                ,p-cmd-code                                                                                                  ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
     2614           end.
     2615       end.
     2616       if v-run-bush-command then do:
     2617             run add-dump in p-cmd-proc-handle                                                                              (input p-cmd-code                                                                                            ,input 'rule-by-call':U                                                                                          ,input '+delete'                                                                                         ,input buffer buf_rule-by-call:handle                                                                                    ,input '':U                                                                                                  ,output v-rec-ord                                                                                            ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                       if v-create-command then delete procedure p-cmd-proc-handle.                                                 undo _main, return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'rule-by-call':U                                                                                                ,p-cmd-code                                                                                                  ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
     2618       end.
     2619      end.
     2620   end.
     2621   end procedure.
     2622   procedure check-list-unique :
     2623   define input parameter p-call-id as character no-undo .
     2624   define input parameter p-codex-id as integer no-undo .
     2625   define input parameter p-ruleset-id as integer no-undo .
     2626   define input parameter p-order-id as integer no-undo .
     2627   define input parameter p-param-name as character no-undo .
     2628   define input parameter p-param-data-type as character no-undo .
     2629   define variable v-current-index as integer no-undo .
     2630   define buffer buf_tt0-rule-call-param for tt0-rule-call-param.
     2631   define buffer buf2_tt0-rule-call-param for tt0-rule-call-param.
     2632   find first buf_tt0-rule-call-param where
     2633           buf_tt0-rule-call-param.call_id = p-call-id
     2634       and buf_tt0-rule-call-param.codex_id = p-codex-id
     2635       and buf_tt0-rule-call-param.ruleset_id = p-ruleset-id
     2636       and buf_tt0-rule-call-param.order_id = p-order-id
     2637       and buf_tt0-rule-call-param.param-name = p-param-name
     2638       and buf_tt0-rule-call-param.p-index > 0
     2639       no-error.
     2640   do while available buf_tt0-rule-call-param:
     2641     v-current-index = buf_tt0-rule-call-param.p-index.
     2642     for each buf2_tt0-rule-call-param where
     2643           buf2_tt0-rule-call-param.call_id = p-call-id
     2644       and buf2_tt0-rule-call-param.codex_id = p-codex-id
     2645       and buf2_tt0-rule-call-param.ruleset_id = p-ruleset-id
     2646       and buf2_tt0-rule-call-param.order_id = p-order-id
     2647       and buf2_tt0-rule-call-param.param-name = p-param-name
     2648       and buf2_tt0-rule-call-param.p-index > buf_tt0-rule-call-param.p-index   :
     2649       if buffer buf_tt0-rule-call-param:handle:buffer-field( substitute("param-value-&1", p-param-data-type)):buffer-value =
     2650          buffer buf2_tt0-rule-call-param:handle:buffer-field( substitute("param-value-&1", p-param-data-type)):buffer-value
     2651       then do:
     2652         undo, return error ''.
     2653       end.
     2654     end.
     2655     find first buf_tt0-rule-call-param where
     2656             buf_tt0-rule-call-param.call_id = p-call-id
     2657         and buf_tt0-rule-call-param.codex_id = p-codex-id
     2658         and buf_tt0-rule-call-param.ruleset_id = p-ruleset-id
     2659         and buf_tt0-rule-call-param.order_id = p-order-id
     2660         and buf_tt0-rule-call-param.param-name = p-param-name
     2661         and buf_tt0-rule-call-param.p-index > v-current-index
     2662         no-error.
     2663   end.
     2664   end procedure.
