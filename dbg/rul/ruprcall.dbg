        1   block-level on error undo, throw.
        2   define input parameter p-call-type as character no-undo .
        3   define input parameter p-call-id as character no-undo .
        4   define input parameter p-data-completeness  as character no-undo .
        5   define input parameter p-cmd-proc-handle as handle no-undo .
        6   define input parameter p-cmd-code as integer no-undo .
        7   define temp-table tt0-rp-by-call no-undo like ub.rp-by-call.
        8   define temp-table tt0-rule-by-call no-undo like ub.rule-by-call.
        9   define temp-table tt0-rule-call-param no-undo like ub.rule-call-param.
       10   define input parameter table for tt0-rp-by-call.
       11   define input parameter table for tt0-rule-by-call.
       12   define input parameter table for tt0-rule-call-param.
       13   define variable vss-revision    as character no-undo init "$Revision$":U .
       14   define variable vss-author      as character no-undo init "$Author$":U .
       15   define variable vss-date        as character no-undo init "$Date$":U .
       16   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       17   define variable vss-archive     as character no-undo init "$Archive$":U .
       18   define variable vss-description as character no-undo init "Сохранение привязки профайла, правил, параметров вызова правил".
       19   procedure vss-get-info :
       20     define output parameter p-vss-revision    like vss-revision    no-undo .
       21     define output parameter p-vss-author      like vss-author      no-undo .
       22     define output parameter p-vss-date        like vss-date        no-undo .
       23     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       24     define output parameter p-vss-archive     like vss-archive     no-undo .
       25     define output parameter p-vss-description like vss-description no-undo .
       26     assign
       27       p-vss-revision    = vss-revision
       28       p-vss-author      = vss-author
       29       p-vss-date        = vss-date
       30       p-vss-workfile    = vss-workfile
       31       p-vss-archive     = vss-archive
       32       p-vss-description = vss-description
       33     .
       34   end procedure.
       35   procedure vss-get-parameters :
       36     define output parameter p-vss-parameters as character no-undo .
       37   end procedure.
       38   define new global shared variable g#vssrevis-logger as handle    no-undo .
       39   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       40   define variable v-vssrevis-logger                   as handle    no-undo .
       41   procedure vss-logevent :
       42     define input  parameter p-extra-paramters as character no-undo .
       43     define variable v-vssrevis-parameters as character no-undo .
       44     do
       45     on error undo, return error return-value
       46     :
       47       if  valid-handle(v-vssrevis-logger)
       48       and v-vssrevis-logger :get-signature("logevent") <> ""
       49       then do:
       50         run vss-get-parameters in this-procedure
       51           (output v-vssrevis-parameters
       52           ).
       53         run logevent in v-vssrevis-logger
       54           (input vss-workfile
       55           ,input vss-revision
       56           ,input v-vssrevis-parameters
       57           ,input p-extra-paramters
       58           ).
       59       end.
       60     end.
       61   end procedure.
       62   assign
       63     v-vssrevis-logger = g#vssrevis-logger
       64   .
       65   if  valid-handle(v-vssrevis-logger)
       66   and v-vssrevis-logger :get-signature("logevent") <> ""
       67   then do:
       68     assign
       69       v-vssrevis-logevent = true
       70     .
       71     run vss-logevent in this-procedure (input vss-description) .
       72   end.
       73   define new global shared variable g#language as character no-undo .
       74   if g#language <> '' and g#language <> 'rus':U then do:
       75     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       76   end.
       77   define new global shared variable g#library  as handle no-undo .
       78   define new global shared variable g#library2 as handle no-undo .
       79   define   shared variable g#auto as logical no-undo.
       80   define   shared variable g#news as logical no-undo.
       81   define   shared variable g#oxml as logical no-undo.
       82   define   shared variable g#esys as logical no-undo.
       83   define   shared variable g#news-source-db as integer no-undo.
       84   define   shared variable g#esys-source-esys as integer no-undo.
       85   define   shared variable g#db-num as integer   no-undo .
       86   define   shared variable g#userid as character no-undo .
       87   define   shared variable g#passwd as character no-undo .
       88   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       89   define temp-table temp-rule-reusable no-undo
       90   field call_id as character
       91   field codex_id as integer
       92   field ruleset_id as integer
       93   field order_id as integer
       94   field profile_id as integer
       95   field rule_id as integer
       96   field reusable-string as character
       97   index pi is unique primary
       98   call_id codex_id  ruleset_id order_id
       99   index ireuse
      100   call_id
      101   codex_id
      102   ruleset_id
      103   rule_id
      104   reusable-string
      105   .
      106   procedure check-reusable :
      107   define input parameter p-call-id as character no-undo .
      108   define input parameter p-codex-id as integer no-undo .
      109   define input parameter p-ruleset-id as integer no-undo .
      110   define input parameter p-order-id as integer no-undo .
      111   define input parameter p-profile-id as integer no-undo .
      112   define input parameter p-rule-id as integer no-undo .
      113   define input parameter p-reusable-string as character no-undo .
      114   define output parameter p-can-run as logical no-undo init yes.
      115   define buffer buf_temp-rule-reusable for temp-rule-reusable.
      116   define buffer buf_rule-call-param for ub.rule-call-param.
      117   define variable v-ii as integer no-undo .
      118   define variable v-reusable-string as character no-undo .
      119   do
      120   on error undo, return error return-value
      121   :
      122      if p-reusable-string = "0" then return.
      123      if p-reusable-string = "-":u then do:
      124        v-reusable-string = string(p-rule-id).
      125      end.
      126      else do:
      127        do v-ii = 1 to num-entries(p-reusable-string):
      128           find first buf_rule-call-param no-lock where
      129                    buf_rule-call-param.codex_id = p-codex-id
      130                and buf_rule-call-param.ruleset_id = p-ruleset-id
      131                and buf_rule-call-param.call_id = p-call-id
      132                and buf_rule-call-param.order_id = p-order-id
      133                and buf_rule-call-param.rule_id = p-rule-id
      134                and buf_rule-call-param.param-name = entry(v-ii, p-reusable-string)
      135                and buf_rule-call-param.p-index = 0
      136                no-error.
      137           if available buf_rule-call-param then do:
      138             assign
      139             v-reusable-string = v-reusable-string + (if v-reusable-string = '':u then '':U else chr(3)) +
      140                                 buffer buf_rule-call-param:buffer-field(substitute("param-value-&1"
      141                                                                        , entry(1, buf_rule-call-param.param-data-type, "_"))):string-value
      142             .
      143           end.
      144        end.
      145      end.
      146      find first buf_temp-rule-reusable no-lock where
      147               buf_temp-rule-reusable.reusable-string = v-reusable-string
      148           and buf_temp-rule-reusable.rule_id = p-rule-id
      149           and buf_temp-rule-reusable.call_id = p-call-id
      150           and buf_temp-rule-reusable.codex_id = p-codex-id
      151           and buf_temp-rule-reusable.ruleset_id = p-ruleset-id  no-error.
      152      if available buf_temp-rule-reusable then do:
      153        p-can-run = no.
      154      end.
      155      create buf_temp-rule-reusable.
      156      assign
      157      buf_temp-rule-reusable.call_id = p-call-id
      158      buf_temp-rule-reusable.codex_id = p-codex-id
      159      buf_temp-rule-reusable.ruleset_id = p-ruleset-id
      160      buf_temp-rule-reusable.order_id = p-order-id
      161      buf_temp-rule-reusable.profile_id = p-profile-id
      162      buf_temp-rule-reusable.rule_id = p-rule-id
      163      buf_temp-rule-reusable.reusable-string = v-reusable-string
      164      .
      165   end.
      166   end procedure.
      167   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      168   procedure gen-key-rec :
      169     define input  parameter p-tbl-name    as character no-undo.
      170     define input  parameter p-bh_tbl-name as handle    no-undo.
      171     define output parameter p-key-rec     as character no-undo.
      172     do
      173     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      174     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      175     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      176     :
      177       define variable fh               as handle    no-undo .
      178       define variable v-ok             as logical   no-undo .
      179       define variable v-inform         as character no-undo .
      180       define variable v-ind            as integer   no-undo .
      181       define variable v-idx-field-qnty as integer   no-undo .
      182       if p-tbl-name = ?
      183         or p-tbl-name = "":U
      184       then do:
      185         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info1 ).
      186       end.
      187       if not p-bh_tbl-name:available then do:
      188         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info1, p-tbl-name ).
      189       end.
      190       assign
      191         p-key-rec = p-tbl-name
      192         v-inform  = p-bh_tbl-name:index-information(1)
      193         v-ind     = 2
      194       .
      195       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      196       on error undo, return error
      197       :
      198         assign
      199           v-inform = p-bh_tbl-name:index-information( v-ind )
      200           v-ind    = v-ind + 1
      201         .
      202       end.
      203       if v-inform = ?
      204         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      205         or entry( 3, v-inform, ",":U ) <> "1":U
      206       then do:
      207         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, p-tbl-name ).
      208       end.
      209       else do:
      210         assign
      211           v-idx-field-qnty = num-entries( v-inform ) - 4
      212         .
      213         if v-idx-field-qnty < 2 then do:
      214           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, p-tbl-name ).
      215         end.
      216         do v-ind = 1 to v-idx-field-qnty by 2
      217         on error undo, return error
      218         :
      219           assign
      220             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      221             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      222           .
      223         end.
      224       end.
      225       if p-key-rec = ? then do:
      226         assign
      227           p-key-rec = "":U
      228         .
      229         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info1, p-tbl-name ).
      230       end.
      231     end.
      232     return.
      233   end procedure.
      234   procedure gen-where-keyr-tab :
      235     define input  parameter i-tableSerach as character no-undo.
      236     define input  parameter i-tablekey   as character  no-undo.
      237     define input  parameter p-key-rec    as character  no-undo.
      238     define input  parameter p-key-handle as handle     no-undo .
      239     define input  parameter p-db-name    as character  no-undo .
      240     define input  parameter p-tt-handle  as handle     no-undo .
      241     define output parameter o-Where      as character  no-undo.
      242     do
      243     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      244     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      245     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      246     :
      247       define variable v-full-tbl-name  as character no-undo .
      248       define variable bh_tbl-name      as handle    no-undo .
      249       define variable fh_key           as handle    no-undo .
      250       define variable fh_search        as handle    no-undo .
      251       define variable v-field-num      as integer   no-undo .
      252       define variable v-count-fld      as integer   no-undo .
      253       define variable v-inform         as character no-undo .
      254       define variable v-ind            as integer   no-undo .
      255       define variable v-idx-field-qnty as integer   no-undo .
      256       define variable v-field-name     as character no-undo .
      257       define variable v-field-val      as character no-undo .
      258       define variable v-word-link      as character no-undo .
      259       define variable vTable           as character no-undo.
      260       define variable bh_tbl-key       as handle    no-undo .
      261       assign
      262         p-key-rec = trim( p-key-rec )
      263       .
      264       if p-key-handle <> ? then do:
      265         if not valid-handle(p-key-handle)
      266            or p-key-handle:type <> "buffer"
      267         then do:
      268           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info1 ).
      269         end.
      270         if num-entries( p-key-rec, chr(3) ) > 1
      271           or p-key-rec = ?
      272           or p-key-rec = "":U
      273         then do:
      274           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info1, p-key-rec ).
      275         end.
      276       end.
      277       else do:
      278         if p-key-rec = ?
      279           or p-key-rec = "":U
      280         then do:
      281           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      282         end.
      283       end.
      284       assign
      285         vTable = entry( 1 , p-key-rec, chr(3) )
      286       .
      287       if p-tt-handle <> ?
      288         and ( not valid-handle(p-tt-handle)
      289               or p-tt-handle:type <> "buffer"
      290             )
      291       then do:
      292         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info1, vTable, chr(10) ).
      293       end.
      294       if p-tt-handle = ? then do:
      295         assign
      296           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      297         .
      298         create buffer bh_tbl-name for table v-full-tbl-name .
      299       end.
      300       else do:
      301         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      302       end.
      303       assign
      304         v-inform = bh_tbl-name:index-information(1)
      305         v-ind    = 2
      306       .
      307       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      308       on error undo, return error
      309       :
      310         assign
      311           v-inform = bh_tbl-name:index-information( v-ind )
      312           v-ind    = v-ind + 1
      313         .
      314       end.
      315       if v-inform = ?
      316         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      317         or entry( 3, v-inform, ",":U ) <> "1":U
      318       then do:
      319         delete object bh_tbl-name no-error.
      320         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info1, vTable ).
      321       end.
      322       assign
      323         v-idx-field-qnty = num-entries( v-inform ) - 4
      324       .
      325       if v-idx-field-qnty < 2 then do:
      326         delete object bh_tbl-name no-error.
      327         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, vTable ).
      328       end.
      329       assign
      330         o-where     = "where":U
      331         v-word-link = "":U
      332         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      333         v-count-fld = 0
      334       .
      335       if i-tablekey ne "" and i-tablekey ne ?
      336       then do:
      337         assign
      338           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      339         .
      340         create buffer bh_tbl-key for table v-full-tbl-name .
      341       end.
      342       if i-tableSerach ne "" and i-tableSerach ne ?
      343       then do:
      344         delete object bh_tbl-name no-error.
      345         assign
      346           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      347         .
      348         create buffer bh_tbl-name for table v-full-tbl-name .
      349       end.
      350       block_where:
      351       do v-ind = 1 to v-idx-field-qnty by 2
      352       on error undo, return error
      353       :
      354         assign
      355           v-count-fld = v-count-fld + 1
      356         .
      357         if p-key-handle = ?
      358           and v-count-fld > v-field-num
      359         then do:
      360           leave block_where.
      361         end.
      362         define variable VfieldKeyTable as handle no-undo.
      363         assign
      364           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      365           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      366         .
      367         if     bh_tbl-key ne ?
      368         then do:
      369            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      370            if VfieldKeyTable eq ?
      371            then next block_where.
      372         end.
      373         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      374         then
      375            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      376         else
      377            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      378         if p-key-handle = ? then do:
      379           assign
      380             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      381           .
      382         end.
      383         else do:
      384           assign
      385             fh_key = p-key-handle:buffer-field( v-field-name )
      386           .
      387           if fh_key = ?
      388             or not valid-handle( fh_key )
      389           then do:
      390             delete object bh_tbl-name.
      391             if     bh_tbl-key ne ?
      392             then
      393                delete object bh_tbl-key.
      394             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info1, p-key-handle:name, v-field-name ).
      395           end.
      396           assign
      397             v-field-val = fh_key:buffer-value
      398           .
      399         end.
      400         if fh_search:data-type ="character":U then do:
      401           assign
      402             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      403             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      404             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      405             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      406             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      407             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      408             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      409             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      410             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      411             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      412             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      413             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      414             v-field-val = substitute( '"&1"', v-field-val )
      415           .
      416         end.
      417         assign
      418           o-where = substitute( "&1 &2", o-where, v-field-val )
      419         .
      420         if v-word-link = "":U then do:
      421           assign
      422             v-word-link = "and":U
      423           .
      424         end.
      425       end.
      426       delete object bh_tbl-name.
      427       if     bh_tbl-key ne ?
      428       then
      429          delete object bh_tbl-key.
      430       if p-key-handle = ?
      431         and v-count-fld <> v-field-num
      432       then do:
      433         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info1, vTable ).
      434       end.
      435     end.
      436   end procedure.
      437   procedure gen-hn-keyr-tab :
      438     define input  parameter i-tableSerach as character no-undo.
      439     define input  parameter i-tablekey   as character no-undo.
      440     define input  parameter p-key-rec    as character no-undo.
      441     define input  parameter p-key-handle as handle    no-undo .
      442     define input  parameter p-db-name    as character no-undo .
      443     define input  parameter p-tt-handle  as handle    no-undo .
      444     define input  parameter p-stts-lock  as integer   no-undo .
      445     define output parameter o-hn         as handle    no-undo.
      446     define variable v-full-tbl-name as character no-undo.
      447     define variable v-where         as character no-undo.
      448     define variable bh_tbl-name     as handle    no-undo.
      449     define variable vTable          as character no-undo.
      450     do
      451     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      452     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      453     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      454         run gen-where-keyr-tab(i-tableSerach,
      455                                i-tablekey,
      456                                p-key-rec,
      457                                p-key-handle,
      458                                p-db-name,
      459                                p-tt-handle,
      460                                output v-where).
      461         if i-tableSerach ne "" and i-tableSerach ne ?
      462         then do:
      463            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      464            create buffer bh_tbl-name for table v-full-tbl-name .
      465         end.
      466         else do:
      467            if p-tt-handle = ? then do:
      468               assign
      469                  vTable = entry( 1 , p-key-rec, chr(3) )
      470               .
      471               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      472               create buffer bh_tbl-name for table v-full-tbl-name .
      473            end.
      474            else do:
      475               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      476            end.
      477         end.
      478         if p-tt-handle = ? then do:
      479            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      480         end.
      481         else do:
      482            bh_tbl-name:find-first( v-where ) no-error .
      483         end.
      484         o-hn = bh_tbl-name.
      485      end.
      486   end procedure.
      487   procedure gen-hn-keyr :
      488     define input  parameter p-key-rec    as character no-undo.
      489     define input  parameter p-key-handle as handle    no-undo .
      490     define input  parameter p-db-name    as character no-undo .
      491     define input  parameter p-tt-handle  as handle    no-undo .
      492     define input  parameter p-stts-lock  as integer   no-undo .
      493     define output parameter o-hn         as handle    no-undo.
      494     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      495   end.
      496   procedure gen-row-keyr :
      497     define input  parameter p-key-rec    as character no-undo.
      498     define input  parameter p-key-handle as handle    no-undo .
      499     define input  parameter p-db-name    as character no-undo .
      500     define input  parameter p-tt-handle  as handle    no-undo .
      501     define input  parameter p-stts-lock  as integer   no-undo .
      502     define output parameter p-tbl-row    as rowid     no-undo.
      503     define output parameter p-tbl-name   as character no-undo.
      504     define variable vHn as handle no-undo.
      505       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      506       p-tbl-row = if vHn:available then vHn:rowid else ?.
      507       p-tbl-name =  vHn:table.
      508       delete object vHn no-error.
      509     if p-tbl-row = ? then do:
      510       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info1, p-tbl-name, p-key-rec ).
      511     end.
      512     else do:
      513       return.
      514     end.
      515   end procedure.
      516   procedure gen-key-fv :
      517     define input  parameter p-key-rec    as character no-undo .
      518     define output parameter p-field-list as character no-undo .
      519     define output parameter p-value-list as character no-undo.
      520     do
      521     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      522     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      523     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      524     :
      525       define variable v-full-tbl-name  as character no-undo .
      526       define variable bh_tbl-name      as handle    no-undo .
      527       define variable v-tbl-name       as character no-undo .
      528       define variable v-field-num      as integer   no-undo .
      529       define variable v-count-fld      as integer   no-undo .
      530       define variable v-inform         as character no-undo .
      531       define variable v-ind            as integer   no-undo .
      532       define variable v-idx-field-qnty as integer   no-undo .
      533       define variable v-delim-key      as character no-undo .
      534       if p-key-rec = ?
      535         or p-key-rec = "":U
      536       then do:
      537         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      538       end.
      539       assign
      540         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      541         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      542       .
      543       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      544       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info1 ).
      545       assign
      546         v-inform = bh_tbl-name:index-information(1)
      547         v-ind    = 2
      548       .
      549       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      550       on error undo, return error
      551       :
      552         assign
      553           v-inform = bh_tbl-name:index-information( v-ind )
      554           v-ind    = v-ind + 1
      555         .
      556       end.
      557       if v-inform = ?
      558         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      559         or entry( 3, v-inform, ",":U ) <> "1":U
      560       then do:
      561         delete object bh_tbl-name no-error.
      562         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      563       end.
      564       assign
      565         v-idx-field-qnty = num-entries( v-inform ) - 4
      566       .
      567       if v-idx-field-qnty < 2 then do:
      568         delete object bh_tbl-name no-error.
      569         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      570       end.
      571       assign
      572         p-field-list = "":U
      573         p-value-list = "":U
      574         v-delim-key  = "":U
      575         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      576         v-count-fld  = 0
      577       .
      578       block_where:
      579       do v-ind = 1 to v-idx-field-qnty by 2
      580       on error undo, return error
      581       :
      582         assign
      583           v-count-fld = v-count-fld + 1
      584         .
      585         if v-count-fld > v-field-num then do:
      586           leave block_where.
      587         end.
      588         assign
      589           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      590           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      591         .
      592         if v-ind = 1 then do:
      593           assign
      594             v-delim-key = chr(3)
      595           .
      596         end.
      597       end.
      598       delete object bh_tbl-name.
      599       if v-count-fld <> v-field-num then do:
      600         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info1, v-tbl-name ).
      601       end.
      602     end.
      603   end procedure.
      604   procedure gen-key-field :
      605     define input  parameter p-table      as character no-undo .
      606     define output parameter p-field-list as character no-undo .
      607     do
      608     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      609     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      610     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      611     :
      612       define variable v-full-tbl-name  as character no-undo .
      613       define variable bh_tbl-name      as handle    no-undo .
      614       define variable v-tbl-name       as character no-undo .
      615       define variable v-field-num      as integer   no-undo .
      616       define variable v-count-fld      as integer   no-undo .
      617       define variable v-inform         as character no-undo .
      618       define variable v-ind            as integer   no-undo .
      619       define variable v-idx-field-qnty as integer   no-undo .
      620       define variable v-delim-key      as character no-undo .
      621       if p-table = ?
      622         or p-table = "":U
      623       then do:
      624         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info1 ).
      625       end.
      626       assign
      627         v-tbl-name      = p-table
      628         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      629       .
      630       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      631       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info1 ).
      632       assign
      633         v-inform = bh_tbl-name:index-information(1)
      634         v-ind    = 2
      635       .
      636       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      637       on error undo, return error
      638       :
      639         assign
      640           v-inform = bh_tbl-name:index-information( v-ind )
      641           v-ind    = v-ind + 1
      642         .
      643       end.
      644       if v-inform = ?
      645         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      646         or entry( 3, v-inform, ",":U ) <> "1":U
      647       then do:
      648         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      649       end.
      650       assign
      651         v-idx-field-qnty = num-entries( v-inform ) - 4
      652       .
      653       if v-idx-field-qnty < 2 then do:
      654         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      655       end.
      656       assign
      657         p-field-list = "":U
      658         v-delim-key  = "":U
      659         v-count-fld  = 0
      660       .
      661       block_where:
      662       do v-ind = 1 to v-idx-field-qnty by 2
      663       on error undo, return error
      664       :
      665         assign
      666           v-count-fld = v-count-fld + 1
      667         .
      668         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      669         if v-ind = 1 then do:
      670           assign
      671             v-delim-key = chr(3)
      672           .
      673         end.
      674       end.
      675       delete object bh_tbl-name.
      676     end.
      677   end procedure.
      678   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      679   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      680   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      681   FUNCTION get-region RETURNS CHARACTER
      682     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
      683     define variable par-region as character no-undo.
      684     if parhost-code = 0 and
      685          parobj-type = "":U and
      686          parobj-code = 0 then do:
      687          par-region = "Глобально".
      688          return par-region.
      689       end.
      690       if parobj-type = 'орг':U then do:
      691          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
      692          return par-region.
      693       end.
      694       if parobj-type = 'регион':U
      695       then do:
      696          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      697          return par-region.
      698       end.
      699       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      700       return par-region.
      701   END FUNCTION.
      702   FUNCTION get-objregion RETURNS CHARACTER
      703     (  input parobj-type as character, input parobj-code as integer ) :
      704     define variable par-region as character no-undo.
      705     if  parobj-type = "":U and
      706         parobj-code = 0
      707     then do:
      708        par-region = "Глобально".
      709     end.
      710     else if parobj-type = 'орг':U
      711     then do:
      712        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
      713     end.
      714     else if parobj-type = 'регион':U
      715     then do:
      716        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      717     end.
      718     else
      719        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      720     return par-region.
      721   END FUNCTION.
      722   FUNCTION calldscr returns character ( input p-call-id as character):
      723   define variable v-descr as character no-undo .
      724   define variable v-field-list as character no-undo .
      725   define variable v-value-list as character no-undo.
      726   define variable v-prop-label as character no-undo .
      727   define variable v-node-label as character no-undo .
      728   define variable v-dt-code as integer no-undo .
      729   define variable v-host-code as integer no-undo .
      730   define variable v-obj-type as character no-undo .
      731   define variable v-obj-code as integer no-undo .
      732   define variable v-label as character no-undo .
      733   define variable v-node-code as integer no-undo .
      734   define buffer buf_prop-head for ub.prop-head.
      735   define buffer buf_prop-ref for ub.prop-ref.
      736   define buffer buf_prop-map for ub.prop-map.
      737   run gen-key-fv in this-procedure ( input p-call-id
      738                                     ,output v-field-list
      739                                     ,output v-value-list) no-error .
      740   if error-status:error then return p-call-id.
      741   CASE entry(1, p-call-id, chr(3)):
      742     when 'dis-card-type':U then do:
      743       v-descr = substitute("Тип ДК: эмитент &1 тип: &2"
      744                            ,integer(entry(lookup("emitent-host-code", v-field-list, chr(3)), v-value-list, chr(3)) )
      745                            ,entry(lookup("type", v-field-list, chr(3)), v-value-list, chr(3))
      746                            ).
      747     end.
      748     when 'dis-card':U then do:
      749       v-descr = substitute("ДК: № &1"
      750                            ,entry(lookup("d-card", v-field-list, chr(3)), v-value-list, chr(3))
      751                            ).
      752     end.
      753     when 'dis-card-property':U then do:
      754       v-dt-code = integer(entry(lookup("dt-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
      755       v-node-code = integer(entry(lookup("node-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
      756       v-host-code = integer(entry(lookup("host-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
      757       v-obj-type = entry(lookup("obj-type", v-field-list, chr(3)), v-value-list, chr(3)) .
      758       v-obj-code = integer(entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
      759       find first buf_prop-ref no-lock where
      760                 buf_prop-ref.dt-code = v-dt-code no-error .
      761       if available buf_prop-ref then do:
      762         find first buf_prop-head no-lock where
      763                   buf_prop-head.dtm-code = buf_prop-ref.dtm-code no-error .
      764         v-prop-label = buf_prop-head.prop-label.
      765         find first buf_prop-map no-lock where
      766                   buf_prop-map.dtm-code = buf_prop-ref.dtm-code
      767               and buf_prop-map.node-code = v-node-code no-error .
      768         if available buf_prop-map then do:
      769           v-label = buf_prop-map.node-label.
      770         end.
      771       end.
      772       v-descr = substitute("ДК: № &1 &2:&3 &4"
      773                            ,entry(lookup("d-card", v-field-list, chr(3)), v-value-list, chr(3))
      774                            ,v-prop-label
      775                            ,v-label
      776                            ,get-region(v-host-code, v-obj-type, v-obj-code)
      777                            ).
      778     end.
      779     when 'clients':U then do:
      780       v-descr = substitute("&1&2"
      781                            ,entry(lookup("obj-type", v-field-list, chr(3)), v-value-list, chr(3))
      782                            ,integer(entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3)) )
      783                            ).
      784     end.
      785     when 'ext-system':U then do:
      786       v-descr = substitute("Внешняя система &1"
      787                            ,integer(entry(lookup("esys-id", v-field-list, chr(3)), v-value-list, chr(3)))
      788                            ).
      789     end.
      790     WHEN 'thbj-attr':U then do:
      791       if entry(lookup("upper-prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rum':U
      792       or entry(lookup("upper-prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rum_obj':U
      793       then do:
      794         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'goods':U then do:
      795           v-descr = "Операции с товарами".
      796         end.
      797         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'clients':U then do:
      798           v-descr = "Операции с клиентами".
      799         end.
      800         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'gds-grp':U then do:
      801           v-descr = "Операции с группами товаров".
      802         end.
      803         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'cli-grp':U then do:
      804           v-descr = "Операции с группами клиентов".
      805         end.
      806         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'chk-doc_ibs-th':U then do:
      807           v-descr = "Операции с чеками на POS IBS-TH".
      808         end.
      809         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'chk-doc_ibs-th-mob':U then do:
      810           v-descr = "Операции с чеками на POS IBS-TH-MOB".
      811         end.
      812         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'edoc':U then do:
      813           v-descr = "Операции в системе электронного документооборота".
      814         end.
      815         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'thref':U then do:
      816           v-descr = "Операции со справочниками".
      817         end.
      818         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'pdf':U then do:
      819           v-descr = "Операции с ДНЦ и переоценками".
      820         end.
      821         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rep':U then do:
      822           v-descr = "Отчеты".
      823         end.
      824         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'ord':U then do:
      825           v-descr = "Операции с заказами".
      826         end.
      827       end.
      828     end.
      829     when 'cash-desk':U then do:
      830       v-descr = substitute("БД &1 Маг &2 Касса № &4 &3"
      831                            ,entry(lookup("db-num", v-field-list, chr(3)), v-value-list, chr(3))
      832                            ,entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3))
      833                            ,entry(lookup("cash-num", v-field-list, chr(3)), v-value-list, chr(3))
      834                            ,entry(lookup("pos-type", v-field-list, chr(3)), v-value-list, chr(3))
      835                            ).
      836     end.
      837     when 'ext-file':U then do:
      838       v-descr = substitute("БД &1 Файл № &3 (из БД &2)"
      839                            ,entry(lookup("db-num", v-field-list, chr(3)), v-value-list, chr(3))
      840                            ,entry(lookup("from-db-num", v-field-list, chr(3)), v-value-list, chr(3))
      841                            ,entry(lookup("file-num", v-field-list, chr(3)), v-value-list, chr(3))
      842                            ).
      843     end.
      844   end case.
      845   return v-descr.
      846   end function.
      847   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      848   def var vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      849   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      850   procedure cur-time :
      851      define output parameter p-today as date      no-undo .
      852      define output parameter p-time  as integer   no-undo .
      853     do
      854     on error undo, return error
      855     :
      856       define variable v-date1 as date      no-undo .
      857       define variable v-date2 as date      no-undo .
      858       define variable v-time  as integer   no-undo .
      859       assign
      860         v-date1 = today
      861         v-time  = time
      862         v-date2 = today
      863       .
      864       if v-date1 <> v-date2
      865       then do:
      866         assign
      867           v-date1 = today
      868           v-time  = v-time
      869         .
      870       end.
      871       assign
      872         p-today = v-date1
      873         p-time  = v-time
      874       .
      875     end.
      876   end.
      877   function cur-time-date returns character
      878   :
      879     return string(today, '99/99/9999':U) .
      880   end.
      881   function cur-time-mjd returns decimal
      882   :
      883     define variable v-date as date      no-undo .
      884     define variable v-time as integer   no-undo .
      885     run cur-time in this-procedure
      886       (output v-date
      887       ,output v-time
      888       ) .
      889     return integer(v-date) - 2400002 + (v-time / 86400) .
      890   end.
      891   function cur-time-get-ending-index returns integer
      892   (input p-number as integer
      893   )
      894   :
      895     if p-number < 0
      896     or p-number = ?
      897     then do:
      898       return 1 .
      899     end.
      900     define variable v-rest as integer   no-undo .
      901     assign
      902       p-number = p-number modulo 100
      903     .
      904     if p-number < 20
      905     then do:
      906       assign
      907         v-rest = p-number
      908       .
      909     end.
      910     else do:
      911       assign
      912         v-rest = p-number modulo 10
      913       .
      914     end.
      915     case v-rest :
      916       when 1
      917       then do:
      918         return 2 .
      919       end.
      920       when 2 or
      921       when 3 or
      922       when 4
      923       then do:
      924         return 3 .
      925       end.
      926       otherwise do:
      927         return 1 .
      928       end.
      929     end case .
      930   end.
      931   procedure cur-time-mjd-to-date :
      932      define input  parameter i-mjd-diff as decimal no-undo.
      933      define output parameter o-Date     as date    no-undo.
      934      define output parameter o-Time     as integer no-undo.
      935      define variable v-day-number as integer   no-undo .
      936      if    i-mjd-diff < 0
      937         or i-mjd-diff = ?
      938      then do:
      939         return "?" .
      940      end.
      941      assign
      942         v-day-number = truncate(i-mjd-diff,0).
      943         o-Date = date(v-day-number + 2400002).
      944         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      945     .
      946   end.
      947   function cur-time-mjd-to-string returns character
      948   (input p-mjd-diff as decimal
      949   )
      950   :
      951     define variable v-day-number as integer   no-undo .
      952     define variable v-seconds    as integer   no-undo .
      953     define variable v-hour       as integer   no-undo .
      954     define variable v-min        as integer   no-undo .
      955     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      956     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      957     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      958     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      959     if p-mjd-diff < 0
      960     or p-mjd-diff = ?
      961     then do:
      962       return "?" .
      963     end.
      964     assign
      965       v-day-number = integer(truncate(p-mjd-diff,0))
      966       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      967     .
      968     if v-seconds > 86400
      969     then do:
      970       assign
      971         v-seconds = 86400 - 1
      972       .
      973     end.
      974     if v-seconds < 0
      975     then do:
      976       assign
      977         v-seconds = 0
      978       .
      979     end.
      980     assign
      981       v-hour = truncate(v-seconds / 3600, 0)
      982     .
      983     assign
      984       v-seconds = v-seconds modulo 3600
      985     .
      986     assign
      987       v-min = truncate(v-seconds / 60, 0)
      988     .
      989     assign
      990       v-seconds = v-seconds modulo 60
      991     .
      992     return
      993         (if v-day-number <> 0
      994           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      995           else ""
      996         )
      997       + (if v-day-number <> 0 or v-hour <> 0
      998           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      999           else ""
     1000         )
     1001       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1002           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1003           else ""
     1004         )
     1005       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1006       .
     1007   end.
     1008   function cur-time-string returns character
     1009   :
     1010     define variable v-date as date      no-undo .
     1011     define variable v-time as integer   no-undo .
     1012     run cur-time in this-procedure
     1013       (output v-date
     1014       ,output v-time
     1015       ) .
     1016     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1017   end.
     1018   function cur-time-string-sec returns character
     1019   :
     1020     define variable v-date as date      no-undo .
     1021     define variable v-time as integer   no-undo .
     1022     run cur-time in this-procedure
     1023       (output v-date
     1024       ,output v-time
     1025       ) .
     1026     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1027   end.
     1028   function cur-time-custom  returns character
     1029   (input p-prefix as character
     1030   ,input p-date-format as character
     1031   ,input p-delimiter as character
     1032   ,input p-time-format as character
     1033   ,input p-suffix as character
     1034   )
     1035   :
     1036     define variable v-date as date      no-undo .
     1037     define variable v-time as integer   no-undo .
     1038     run cur-time in this-procedure
     1039       (output v-date
     1040       ,output v-time
     1041       ) .
     1042     return
     1043       p-prefix
     1044       + string(v-date, p-date-format)
     1045       + p-delimiter
     1046       + string(v-time, p-time-format)
     1047       + p-suffix
     1048       .
     1049   end.
     1050   function cur-time-print  returns character
     1051   :
     1052     define variable v-date as date      no-undo .
     1053     define variable v-time as integer   no-undo .
     1054     run cur-time in this-procedure
     1055       (output v-date
     1056       ,output v-time
     1057       ) .
     1058     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1059   end.
     1060   function cur-time-datetime returns datetime
     1061   :
     1062     define variable v-char as character no-undo .
     1063     define variable v-datetime as datetime no-undo .
     1064     v-char = cur-time-string().
     1065     v-datetime = datetime(v-char).
     1066     return  v-datetime.
     1067   end.
     1068   function cur-time-string-msec returns character
     1069   :
     1070     define variable v-date as datetime  no-undo .
     1071     v-date = now.
     1072     return string(v-date) .
     1073   end.
     1074   procedure who-lk_make-some-lk :
     1075   define input  parameter p-resource-id as character no-undo .
     1076   define input  parameter p-call-id as character no-undo .
     1077   define input  parameter p-call#-id as integer   no-undo .
     1078   define input  parameter p-lk-type as character no-undo .
     1079   define input  parameter p-corr-user-db-num as integer   no-undo .
     1080   define input  parameter p-lk-mess as character no-undo .
     1081   define input  parameter p-ps as character no-undo .
     1082   define variable v-today as date      no-undo.
     1083   define variable v-time  as integer   no-undo.
     1084   define variable v-resource#-id as integer   no-undo .
     1085   define buffer buf_who-lk for ub.who-lk.
     1086   define buffer buf_some-lk for ub.some-lk.
     1087   do
     1088   on error undo, return error return-value
     1089   :
     1090      find first buf_who-lk no-lock where
     1091               buf_who-lk.resource_id = p-resource-id
     1092          and buf_who-lk.call_id = p-call-id
     1093          and buf_who-lk.lk-type = p-lk-type
     1094          and buf_who-lk.corr-user-db-num = p-corr-user-db-num
     1095          no-error.
     1096      if available buf_who-lk then return ''.
     1097      find first buf_some-lk no-lock where
     1098               buf_some-lk.resource_id = p-resource-id
     1099           and buf_some-lk.lk-type = p-lk-type
     1100               no-error.
     1101      if not available buf_some-lk then do:
     1102        run rul/g-callid.p ( input 'some-lk':U
     1103                            ,input p-resource-id
     1104                            ,output v-resource#-id).
     1105        create buf_some-lk.
     1106        assign
     1107        buf_some-lk.resource_id = p-resource-id
     1108        buf_some-lk.resource#_id = v-resource#-id
     1109        buf_some-lk.lk-type = p-lk-type
     1110        .
     1111      end.
     1112      else do:
     1113        find current buf_some-lk exclusive-lock.
     1114      end.
     1115      assign
     1116      buf_some-lk.counter = buf_some-lk.counter + 1
     1117      .
     1118      run cur-time in this-procedure(output v-today, output v-time).
     1119      create buf_who-lk.
     1120      assign
     1121      buf_who-lk.call_id = p-call-id
     1122      buf_who-lk.call#_id = p-call#-id
     1123      buf_who-lk.chip-num = next-value(s-lk-chip, ub)
     1124      buf_who-lk.lk-mess      = p-lk-mess
     1125      buf_who-lk.lk-type      = p-lk-type
     1126      buf_who-lk.PS           = p-ps
     1127      buf_who-lk.resource#_id = buf_some-lk.resource#_id
     1128      buf_who-lk.resource_id = buf_some-lk.resource_id
     1129      buf_who-lk.corr-user-db-num = p-corr-user-db-num
     1130      buf_who-lk.corr-user-name = g#userid
     1131      buf_who-lk.corr-date = v-today
     1132      buf_who-lk.corr-time = v-time
     1133      .
     1134   end.
     1135   end procedure.
     1136   procedure who-lk_delete-some-lk :
     1137   define input  parameter p-resource-id as character no-undo .
     1138   define input  parameter p-call-id as character no-undo .
     1139   define input  parameter p-lk-type as character no-undo .
     1140   define input  parameter p-corr-user-db-num as integer   no-undo .
     1141   define buffer buf_who-lk for ub.who-lk.
     1142   define buffer buf_some-lk for ub.some-lk.
     1143   do
     1144   on error undo, return error return-value
     1145   :
     1146      find first buf_some-lk no-lock where
     1147               buf_some-lk.resource_id = p-resource-id
     1148           and buf_some-lk.lk-type = p-lk-type
     1149               no-error.
     1150      if not available buf_some-lk then return ''.
     1151      find first buf_who-lk no-lock where
     1152               buf_who-lk.resource_id = p-resource-id
     1153          and buf_who-lk.call_id = p-call-id
     1154          and buf_who-lk.lk-type = p-lk-type
     1155          and buf_who-lk.corr-user-db-num = p-corr-user-db-num
     1156          no-error.
     1157      if not available buf_who-lk then return ''.
     1158      find current buf_who-lk exclusive-lock.
     1159      find current buf_some-lk exclusive-lock .
     1160      assign
     1161      buf_some-lk.counter = buf_some-lk.counter - 1.
     1162      delete buf_who-lk.
     1163   end.
     1164   end procedure.
     1165   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1166   function octal-to-char return character
     1167   ( p-string as character ) :
     1168     def var v-asc     as integer no-undo .
     1169     def var v-new-asc as integer no-undo .
     1170     def var ind       as integer no-undo .
     1171     if length(p-string) <> 3 then do:
     1172       return ? .
     1173     end.
     1174     assign
     1175       v-asc = 0
     1176     .
     1177     do ind = 1 to length(p-string)
     1178     :
     1179       assign
     1180         v-new-asc = asc(substring(p-string, ind, 1)) - asc('0')
     1181       .
     1182       if v-new-asc < 0 or v-new-asc >= 8 then do:
     1183         return ? .
     1184       end.
     1185       assign
     1186         v-asc = v-asc * 8 + v-new-asc
     1187       .
     1188     end.
     1189     return chr(v-asc) .
     1190   end function .
     1191   function char-to-octal return character
     1192   ( p-chr as character ) :
     1193     def var v-asc    as integer   no-undo .
     1194     def var ind      as integer   no-undo .
     1195     def var v-string as character no-undo .
     1196     if length(p-chr) <> 1 then do:
     1197       return ? .
     1198     end.
     1199     assign
     1200       v-asc    = asc(p-chr)
     1201       v-string = ""
     1202     .
     1203     do ind = 1 to 3
     1204     :
     1205       assign
     1206         v-string = chr( v-asc mod 8 + asc('0')) + v-string
     1207       .
     1208       assign
     1209         v-asc = truncate(v-asc / 8, 0)
     1210       .
     1211     end.
     1212     return v-string .
     1213   end.
     1214   function str-encode return character
     1215   (   p-init-string       as character
     1216     , p-encode-char       as character
     1217     , p-special-char-list as character
     1218   ) :
     1219     def var p-encode-string as character no-undo .
     1220     def var ind                as integer no-undo .
     1221     def var v-num-special-char as integer no-undo .
     1222     def var v-special-char     as character no-undo .
     1223     if p-encode-char = ?
     1224     or p-encode-char = "" then do:
     1225       assign
     1226         p-encode-char = "~~"
     1227       .
     1228     end.
     1229     if p-init-string = ? then do:
     1230       return "?" .
     1231     end.
     1232     if p-init-string = "?" then do:
     1233       return p-encode-char + char-to-octal("?") .
     1234     end.
     1235     assign
     1236       v-num-special-char = length(p-special-char-list)
     1237       p-encode-string    = replace(p-init-string
     1238                                   ,p-encode-char
     1239                                   ,p-encode-char + char-to-octal(p-encode-char)
     1240                                   )
     1241     .
     1242     do ind = 1 to v-num-special-char
     1243     :
     1244       assign
     1245         v-special-char = substring(p-special-char-list, ind, 1)
     1246       .
     1247       if v-special-char <> p-encode-char then do:
     1248         assign
     1249           p-encode-string = replace (p-encode-string
     1250                                     ,v-special-char
     1251                                     ,p-encode-char + char-to-octal(v-special-char)
     1252                                     )
     1253         .
     1254       end.
     1255     end.
     1256     return p-encode-string .
     1257   end.
     1258   function str-decode returns character
     1259     (p-init-string   as character
     1260     ,p-encode-char   as character
     1261     ) :
     1262     def var p-decode-string as character no-undo .
     1263     def var ind                       as integer no-undo .
     1264     def var v-num-entries-init-string as integer no-undo .
     1265     def var v-sub-phrase              as character no-undo .
     1266     def var v-special-char            as character no-undo .
     1267     if p-encode-char = ?
     1268     or p-encode-char = "" then do:
     1269       assign
     1270         p-encode-char = "~~"
     1271       .
     1272     end.
     1273     if p-init-string = "?" then do:
     1274       return ? .
     1275     end.
     1276     assign
     1277       v-num-entries-init-string = num-entries(p-init-string, p-encode-char)
     1278     .
     1279     if v-num-entries-init-string > 1 then do:
     1280       assign
     1281         p-decode-string = entry(1, p-init-string, p-encode-char)
     1282       .
     1283       do ind = 2 to v-num-entries-init-string
     1284       :
     1285         assign
     1286           v-sub-phrase = entry(ind, p-init-string, p-encode-char)
     1287         .
     1288         assign
     1289           v-special-char = octal-to-char(substring(v-sub-phrase, 1, 3))
     1290         .
     1291         if v-special-char <> ? then do:
     1292           assign
     1293             p-decode-string = p-decode-string
     1294                             + v-special-char
     1295                             + substring(v-sub-phrase, 4)
     1296           .
     1297         end.
     1298         else do:
     1299           assign
     1300             p-decode-string = p-decode-string
     1301                             + p-encode-char
     1302                             + v-sub-phrase
     1303           .
     1304         end.
     1305       end.
     1306     end.
     1307     else do:
     1308       assign
     1309         p-decode-string = p-init-string
     1310       .
     1311     end.
     1312     return p-decode-string .
     1313   end.
     1314   define variable vss-include-info9 as character format "X(65)":U no-undo initial "@(#)$Workfile$ $Revision$".
     1315   function check-entry-with-mask returns logical ( input p-element as character, input p-list as character, input p-delimiter as character ) :
     1316     define variable p-entry   as logical   no-undo .
     1317     define variable v-ind as integer   no-undo .
     1318     if p-delimiter = "*":U then do:
     1319       message
     1320         vss-workfile "(check-entry-with-mask)" vss-revision vss-description skip
     1321         substitute('Разделитель не может быть равный "&1"', p-delimiter ) skip
     1322         view-as alert-box error .
     1323       return ? .
     1324     end.
     1325     assign
     1326       p-entry = true
     1327     .
     1328     if lookup( p-element, p-list, p-delimiter ) = 0 then do:
     1329       assign
     1330         p-entry = false
     1331       .
     1332       if num-entries( p-list, "*":U ) > 1 then do:
     1333         block_check-list:
     1334         do v-ind = 1 to num-entries( p-list, p-delimiter )
     1335         :
     1336           if p-element matches entry( v-ind, p-list, p-delimiter ) then do:
     1337             assign
     1338               p-entry = true
     1339             .
     1340             leave block_check-list .
     1341           end.
     1342         end.
     1343       end.
     1344     end.
     1345     return p-entry .
     1346   end function .
     1347   define variable v-call#-id as integer no-undo .
     1348   DEFINE VARIABLE v-value-character AS CHARACTER NO-UNDO.
     1349   DEFINE VARIABLE v-value-integer AS integer NO-UNDO.
     1350   DEFINE VARIABLE v-value-decimal AS decimal NO-UNDO.
     1351   DEFINE VARIABLE v-value-logical AS logical NO-UNDO.
     1352   DEFINE VARIABLE v-value-date AS date NO-UNDO.
     1353   define variable v-ok as logical no-undo .
     1354   define variable v-run-bush-command as logical no-undo .
     1355   define variable v-cmp as logical no-undo .
     1356   define variable v-cmp-loc as logical no-undo .
     1357   define variable v-old-can-run as logical no-undo .
     1358   define variable v-old-can-calc as logical no-undo .
     1359   define variable v-create-command as logical no-undo .
     1360   define variable v-command as character no-undo .
     1361   define variable v-field-list as character no-undo .
     1362   define variable v-value-list as character no-undo .
     1363   define variable v-par-val as character no-undo .
     1364   define variable v-par-type as character no-undo .
     1365   define variable v-rec-ord as integer no-undo .
     1366   define variable v-rcp-key-rec as character no-undo .
     1367   define variable v-db-list as character no-undo .
     1368   define buffer buf_db for ub.db .
     1369   define buffer buf_rp-by-call for ub.rp-by-call.
     1370   define buffer buf_rule-by-call for ub.rule-by-call.
     1371   define buffer buf_rule-call-param for ub.rule-call-param.
     1372   define buffer buf_rule-profile for ub.rule-profile.
     1373   define buffer buf_rule for ub.rule.
     1374   define buffer buf_ruledict for ub.ruledict.
     1375   define buffer buf_ruledict-param for ub.ruledict-param.
     1376   define buffer buf_tt0-rule-call-param for tt0-rule-call-param.
     1377   define temp-table temp-prop-ref-call  no-undo like ub.prop-ref-call.
     1378   define temp-table temp-uniq-key no-undo
     1379   field key-rec as character
     1380   index pi is unique primary key-rec
     1381   .
     1382   _main:
     1383   do
     1384   on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1385   on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
     1386   on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
     1387   :
     1388     assign
     1389     v-run-bush-command = valid-handle(p-cmd-proc-handle).
     1390     if v-call#-id = 0 then do:
     1391       run rul/g-callid.p ( input p-call-type
     1392                           ,input p-call-id
     1393                           ,output v-call#-id).
     1394     end.
     1395     if not v-run-bush-command then do:
     1396       if p-cmd-code = 0 then do:
     1397         v-create-command = yes.
     1398         run  gen-key-fv in this-procedure (
     1399                                             input p-call-id
     1400                                            ,output v-field-list
     1401                                            ,output v-value-list).
     1402         case p-call-type:
     1403           when 'dis-card-type':U then do:
     1404             assign
     1405             v-command =  substitute("&2&1&3&1&4"
     1406                                   , chr(6)
     1407                                   , 'cmd-dct-send':U
     1408                                   , integer(entry(lookup("emitent-host-code", v-field-list, chr(3)), v-value-list, chr(3)))
     1409                                   , entry(lookup("type", v-field-list, chr(3)), v-value-list, chr(3))
     1410                                   ).
     1411           end.
     1412           when 'goods':U
     1413           or
     1414           when 'clients':U
     1415           or
     1416           when 'gds-grp':U
     1417           or
     1418           when 'cli-grp':U
     1419           or
     1420           when 'thref':U
     1421           or
     1422           when 'edoc':U
     1423           or
     1424           when 'rep':U
     1425           or
     1426           when 'chk-doc':U + "_" + 'IBS-TH':U
     1427           or
     1428           when 'chk-doc':U + "_" + 'IBS-TH-MOB':U
     1429           or
     1430           when 'ord':U
     1431           then do:
     1432             if p-call-type = 'rep':U
     1433             or p-call-type = 'ord':U
     1434             then do:
     1435               if entry(1, p-call-id, chr(3)) = 'schedule':U then do:
     1436                 define variable v-cre-db-num as integer no-undo .
     1437                 v-cre-db-num =  integer(entry(lookup("cre-db-num", v-field-list, chr(3)), v-value-list, chr(3))).
     1438                 if v-cre-db-num > 0
     1439                 then do:
     1440                   if g#db-num > 0 then do:
     1441                     v-db-list = string(0).
     1442                   end.
     1443                   else do:
     1444                     v-db-list = string(v-cre-db-num).
     1445                   end.
     1446                 end.
     1447                 else do:
     1448                   v-create-command = no.
     1449                 end.
     1450               end.
     1451             end.
     1452             if v-create-command then do:
     1453             assign
     1454               v-command =  substitute("&2&1&3&1"
     1455                                   , chr(6)
     1456                                     , 'cmd-rum-send':U
     1457                                   ,  str-encode( p-call-id
     1458                                          , ""
     1459                                          , chr(3))
     1460                                   ).
