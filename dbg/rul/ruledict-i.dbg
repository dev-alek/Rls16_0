      454   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      455   procedure minbtn-set :
      456       do
      457           on error undo, return error return-value
      458           :
      459           define variable ii              as integer       no-undo .
      460           define variable fh              as widget-handle no-undo .
      461           define variable hh              as widget-handle no-undo .
      462           define variable v-h             as handle        extent 4 no-undo .
      463           define variable v-name-button   as character     no-undo .
      464           define variable v-help-old-x    as decimal       no-undo .
      465           define variable v-help-old-y    as decimal       no-undo .
      466           define variable v-help-old-size as decimal       no-undo .
      467           define variable v-frame-width   as decimal       no-undo .
      468           define variable jj              as integer       no-undo .
      469           do
      470               on error undo, return error
      471               :
      472               assign
      473                   v-frame-width = frame Dialog-Frame:width - 0.3
      474                   fh            = frame Dialog-Frame:first-child
      475                   hh            = fh:first-child
      476                   ii            = 1
      477                   .
      478               do while valid-handle(hh):
      479                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      480                   do:
      481                       case lc(hh:name) :
      482                           when "b-help" then
      483                               do:
      484                                   hh:load-image-up("cmp/b-help.bmp":u) .
      485                                   hh:load-image-down("cmp/b-help.bmp":u) .
      486                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      487                                   hh:TOOLTIP = "œÓÏÓ˘¸" .
      488                                   v-help-old-x = hh:column .
      489                                   v-help-old-y = hh:row    .
      490                                   v-help-old-size = hh:width .
      491                                   hh:width-chars = 2.5 .
      492                               end.
      493                           when "b-print" then
      494                               do:
      495                                   hh:load-image("cmp/b-print.bmp":u) .
      496                                   hh:TOOLTIP = "œÂ˜‡Ú¸" .
      497                                   v-h[ii] = hh:handle .
      498                                   ii = ii + 1 .
      499                                   hh:width-chars = 3 .
      500                               end.
      501                           when "b-history" or
      502                           when "b-hist" then
      503                               do:
      504                                   hh:load-image("cmp/b-hist.bmp":u) .
      505                                   hh:TOOLTIP = "»ÒÚÓËˇ" .
      506                                   v-h[ii] = hh:handle .
      507                                   ii = ii + 1 .
      508                                   hh:width-chars = 3 .
      509                               end.
      510                           when "b-sch" then
      511                               do:
      512                                   hh:load-image("cmp/b-sch.bmp":u) .
      513                                   hh:TOOLTIP = "”ÒÚ‡ÌÓ‚Í‡ ‘ËÎ¸Ú‡" .
      514                                   v-h[ii] = hh:handle .
      515                                   ii = ii + 1 .
      516                                   hh:width-chars = 3 .
      517                               end.
      518                           when "b-hist-user" then
      519                               do:
      520                                   hh:load-image("cmp/b-hist.bmp":u) .
      521                                   hh:TOOLTIP = "»ÒÚÓËˇ ÔÓÎ¸ÁÓ‚‡ÚÂÎˇ" .
      522                                   ii = ii + 1 .
      523                               end.
      524                       end case.
      525                   end.
      526                   hh = hh:next-sibling.
      527               end.
      528               b-help:column = v-frame-width - b-help:width-chars.
      529               jj = 0.
      530               repeat ii = 4 to 1 by -1 :
      531                   if valid-handle (v-h[ii] ) then
      532                   do:
      533                       jj  = jj + 1 .
      534                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      535                       v-h[ii]:row    = v-help-old-y .
      536                   end.
      537               end.
      538           end.
      539       end.
      540   end procedure.
      541   MAIN-BLOCK:
      542   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      543      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      544      ON stop UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      545     IF p-mode = ' Œœ»–Œ¬¿Õ»≈':U THEN DO:
      546       v-is-copy = yes.
      547       p-mode = 'ƒŒ¡¿¬À≈Õ»≈':U.
      548     end.
      549     IF p-mode = 'ƒŒ¡¿¬À≈Õ»≈':U THEN DO:
      550       FIND FIRST first_ruledict EXCLUSIVE-LOCK.
      551       if v-is-copy then do:
      552         FIND FIRST LOCKED_ruledict EXCLUSIVE-LOCK WHERE
      553                   LOCKED_ruledict.entry-id = p-entry-id .
      554         create tt-ruledict.
      555         buffer-copy locked_ruledict except entry-id
      556         to tt-ruledict.
      557         release locked_ruledict.
      558       end.
      559       else do:
      560         CREATE tt-ruledict.
      561         if p-entry-type <> '':U then do:
      562           tt-ruledict.entry-type = p-entry-type.
      563         end.
      564       end.
      565     END.
      566     else do:
      567       IF p-mode = '»«Ã≈Õ≈Õ»≈':U THEN DO:
      568         FIND FIRST LOCKED_ruledict EXCLUSIVE-LOCK WHERE
      569                   LOCKED_ruledict.entry-id = p-entry-id .
      570       END.
      571       IF p-mode = 'œ–Œ—ÃŒ“–':U THEN DO:
      572           FIND FIRST LOCKED_ruledict no-LOCK WHERE
      573                     LOCKED_ruledict.entry-id = p-entry-id  NO-ERROR.
      574       END.
      575       create tt-ruledict.
      576       buffer-copy locked_ruledict to tt-ruledict.
      577     end.
      578     RUN Myenable.
      579     WAIT-FOR GO OF FRAME Dialog-Frame.
      580   END.
      581   RUN disable_UI.
      582   PROCEDURE disable_UI :
      583     HIDE FRAME Dialog-Frame.
      584   END PROCEDURE.
      585   PROCEDURE enable_UI :
      586     OPEN QUERY Dialog-Frame FOR EACH tt-ruledict SHARE-LOCK.
      587     GET FIRST Dialog-Frame.
      588     IF AVAILABLE tt-ruledict THEN
      589       DISPLAY tt-ruledict.entry-id tt-ruledict.entry-type tt-ruledict.script-al
      590             tt-ruledict.script-nl tt-ruledict.documentation
      591         WITH FRAME Dialog-Frame.
      592     ENABLE B-exit b-quit B-Help tt-ruledict.entry-id tt-ruledict.entry-type
      593            tt-ruledict.script-al tt-ruledict.script-nl tt-ruledict.documentation
      594         WITH FRAME Dialog-Frame.
      595     VIEW FRAME Dialog-Frame.
      596   END PROCEDURE.
      597   PROCEDURE MyEnable :
      598   ASSIGN
      599   tt-ruledict.entry-type:LIST-ITEMS IN FRAME Dialog-Frame = 'constant,operator,control,prop-name_,prop-name_host,prop-name_obj,node-name_,node-name_host,node-name_obj,prop-script,sum-id,rule,rule-profile,datatype,parameter':u.
      600   IF AVAILABLE tt-ruledict THEN
      601   DISPLAY
      602   tt-ruledict.entry-type
      603   tt-ruledict.entry-id
      604   tt-ruledict.script-al
      605   tt-ruledict.script-nl
      606   tt-ruledict.documentation
      607   WITH FRAME Dialog-Frame .
      608   assign
      609   tt-ruledict.script-al:read-only in frame Dialog-Frame = (p-mode = 'œ–Œ—ÃŒ“–':U)
      610   tt-ruledict.script-nl:read-only in frame Dialog-Frame = (p-mode = 'œ–Œ—ÃŒ“–':U)
      611   .
      612   ENABLE
      613   B-exit  when p-mode <> 'œ–Œ—ÃŒ“–':U
      614   b-quit
      615   B-Help
      616   tt-ruledict.entry-type  when (p-mode = 'ƒŒ¡¿¬À≈Õ»≈':U and p-entry-type = '':U)
      617   tt-ruledict.entry-id when p-mode = 'ƒŒ¡¿¬À≈Õ»≈':U
      618   tt-ruledict.documentation when p-mode <> 'œ–Œ—ÃŒ“–':U
      619   tt-ruledict.script-al
      620   tt-ruledict.script-nl
      621   WITH FRAME Dialog-Frame .
      622   if p-mode = 'œ–Œ—ÃŒ“–':U then do:
      623     assign
      624     b-quit:label = "&¬˚ıÓ‰"
      625     b-quit:column = 1.
      626     hide b-exit in frame Dialog-Frame .
      627   end.
      628   VIEW FRAME Dialog-Frame .
      629   END PROCEDURE.
      630   PROCEDURE proc-save :
      631   DEFINE VARIABLE v-rec AS recID  NO-UNDO.
      632   IF p-mode = 'œ–Œ—ÃŒ“–':U THEN DO:
      633       RETURN.
      634   END.
      635   if p-mode = '»«Ã≈Õ≈Õ»≈':U then do:
      636     v-rec = p-rec.
      637   end.
      638   ASSIGN
      639   FRAME Dialog-Frame
      640   tt-ruledict.entry-type
      641   tt-ruledict.entry-id
      642   tt-ruledict.script-al
      643   tt-ruledict.script-nl
      644   tt-ruledict.documentation.
      645   run rul/ruledict1.p ( INPUT p-mode
      646                   ,INPUT NO
      647                   ,INPUT-OUTPUT v-rec
      648                   ,INPUT tt-ruledict.entry-id
      649                   ,INPUT tt-ruledict.entry-type
      650                   ,INPUT tt-ruledict.script-al
      651                   ,INPUT tt-ruledict.script-nl
      652                   ,INPUT tt-ruledict.documentation
      653                   ) no-error.
      654   if error-status:error then do:
      655   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      656   define variable fh as widget-handle no-undo .
      657   define variable hh as widget-handle no-undo .
      658   define variable rv as character no-undo .
      659   assign
      660   rv = entry(1, return-value , chr(4)).
      661   if rv <> "":U then do:
      662     assign
      663     fh = frame Dialog-Frame:first-child
      664     hh = fh:first-child
      665     .
      666     do while valid-handle(hh):
      667       if hh:name = rv then do:
      668         APPLY "ENTRY" to hh.
      669         undo ,
      670         return error.
      671       end.
      672       hh = hh:next-sibling.
      673     end.
      674   end.
      675     undo, return error.
      676   end.
      677   p-rec = v-rec.
      678   END PROCEDURE.
