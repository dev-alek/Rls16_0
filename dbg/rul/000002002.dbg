     5292   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5293   define temp-table temp-edi-status no-undo
     5294   like ub.edi-status.
     5295   define variable cr-edist_full-mess as longchar  no-undo .
     5296   procedure create-edi-statett :
     5297   define input  parameter p-tbl-name   as character no-undo .
     5298   define input  parameter p-doc-code   as character no-undo .
     5299   define input  parameter p-cli-type   as character no-undo .
     5300   define input  parameter p-cli-code   as integer   no-undo .
     5301   define input  parameter p-act        as character no-undo .
     5302   define input  parameter p-state      as character no-undo .
     5303   define input  parameter p-err        as integer   no-undo .
     5304   define input  parameter p-des        as character no-undo .
     5305   define input  parameter p-mess       as character no-undo .
     5306   define input  parameter p-dm         as integer  no-undo .
     5307   define buffer buf_EDI-status for temp-EDI-status  .
     5308   define variable v-time as integer   no-undo .
     5309   define variable v-date as date   no-undo .
     5310   do
     5311   on error undo, return error return-value
     5312   :
     5313     find first buf_edi-status exclusive-lock where
     5314                 buf_edi-status.date-status = v-date
     5315             and buf_edi-status.time-status = v-time
     5316             and buf_edi-status.tbl-name    = p-tbl-name
     5317             and buf_edi-status.doc-code    = p-doc-code no-error .
     5318     if not available buf_edi-status  then do:
     5319       create buf_edi-status.
     5320     end.
     5321     assign
     5322     buf_edi-status.act         = p-act        .
     5323     buf_edi-status.cli-type    = p-cli-type   .
     5324     buf_edi-status.cli-code    = p-cli-code   .
     5325     buf_edi-status.des-err     = buf_edi-status.des-err + (if buf_edi-status.des-err = '' then '' else chr(4)) + p-des        .
     5326     buf_edi-status.doc-code    = p-doc-code   .
     5327     buf_edi-status.err-code    = p-err        .
     5328     buf_edi-status.mess-id     = buf_edi-status.mess-id + (if buf_edi-status.mess-id = '' then '' else chr(4)) + p-mess       .
     5329     buf_edi-status.state       = p-state      .
     5330     buf_edi-status.tbl-name    = p-tbl-name   .
     5331     buf_edi-status.date-status = v-date       .
     5332     buf_edi-status.time-status = v-time       .
     5333     buf_edi-status.whole-send-news = p-dm     .
     5334     buf_edi-status.user-name   = (if g#news then (chr(4) +  'СПН':U)
     5335                                       else (if g#esys
     5336                                             then (chr(4) +  'ВС':U)
     5337                                             else g#userid)
     5338                                       )       .
     5339     assign
     5340     cr-edist_full-mess = cr-edist_full-mess +
     5341                           (if cr-edist_full-mess = ''
     5342                           then ''
     5343                           else (chr(13) + chr(10))) +
     5344                           (if num-entries(p-doc-code, chr(4)) > 1
     5345                           then substitute("Товар с кодом &1: ", entry(2, p-doc-code, chr(4)))
     5346                           else '') +
     5347                           cr-edist_get-mess-mean (p-des)
     5348     .
     5349   end.
     5350   end procedure.
     5351   procedure update-edi-state-lighttt :
     5352   define input  parameter p-tbl-name   as character no-undo .
     5353   define input  parameter p-doc-code   as character no-undo .
     5354   define input  parameter p-date-status as date no-undo .
