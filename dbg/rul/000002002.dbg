     3030           otherwise do:
     3031               do v-position = 1 to length( p-in-string )
     3032               :
     3033                   assign
     3034                       v-current-char = substring( p-in-string, v-position, 1 )
     3035                   .
     3036                   case v-current-char
     3037                   :
     3038                       when "&":U
     3039                       then do:
     3040                           assign
     3041                               p-out-string = p-out-string + "&amp;":U
     3042                           .
     3043                       end.
     3044                       when ">":U
     3045                       then do:
     3046                           assign
     3047                               p-out-string = p-out-string + "&gt;":U
     3048                           .
     3049                       end.
