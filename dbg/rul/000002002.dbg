     5469   function 00180004_get-error-message returns character :
     5470   define variable v-ii as integer no-undo .
     5471   define variable v-mess as character no-undo .
     5472   DO v-ii = 1 TO ERROR-STATUS:NUM-MESSAGES:
     5473       v-mess = substitute("&1&2ош &3"
     5474                           ,v-mess
     5475                           ,chr(10)
     5476                           ,ERROR-STATUS:GET-MESSAGE(v-ii)).
     5477   END.
     5478   return v-mess.
     5479   end function.
     5480     define variable p-xsd-file as character no-undo.
