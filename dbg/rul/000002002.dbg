     6195     buf_esys-pck-rcvd.esys-id    = temp-esys.esys-id
     6196     buf_esys-pck-rcvd.db-num     = temp-esys.db-num
     6197     buf_esys-pck-rcvd.espr-cr-db-num     = g#db-num
     6198     buf_esys-pck-rcvd.espr-pack-num   = v-pack-num
     6199     .
     6200   end.
     6201             assign
     6202             buf_esys-pck-rcvd.espr-rcvd-recs  = 1
     6203             buf_esys-pck-rcvd.espr-total-recs = 2
     6204             buf_esys-pck-rcvd.espr-CRC-pack   = ''
     6205             buf_esys-pck-rcvd.custom-pack-name = v-short-file-name
     6206             buf_esys-pck-rcvd.espr-rcvd = yes
     6207             .
     6208           num-rec-ok2 = num-rec-ok2 + 1.
     6209         end.
     6210     END.
     6211         process events.
     6212         run get-stop-state in p-log-handle ( output v-stop) no-error .
     6213         if v-stop then do:
     6214             run write-log-and-file in p-log-handle (
     6215                                                     input 1
     6216                                                   , input log-file-name
     6217                                                   , input 1
     6218                                                   , input substitute("Процесс импорта прерван пользователем")).
     6219           run gate-clear in this-procedure ( input v_dataseth, input v-xmlh).
     6220           empty temp-table temp-xml-tables.
     6221           leave _repeat.
     6222         end.
     6223       end.
     6224       if temp-esys.delivery-method = integer('1':U) then do:
     6225         input stream instream close.
     6226       end.
     6227     end.
     6228     run write-log-and-file in p-log-handle (
     6229           input 1
     6230         , input log-file-name
     6231         , input 1
     6232         , input substitute("Прочитано записей при импорте: &1, из них удачно обработано: &2", num-rec, num-rec-ok2)).
     6233   end.
     6234   end procedure.
     6235   procedure load-ruleset-context :
     6236   define input parameter p-ruleset-id as integer no-undo .
     6237   define buffer buf_rule-call-param for ub.rule-call-param.
     6238   define variable v-itop as integer   no-undo .
     6239   define variable v-ichild as integer   no-undo .
     6240   define variable v-pck-num as integer no-undo .
     6241   define buffer buf_esys-pck-keys for ub.esys-pck-keys.
     6242     do
     6243     on error undo, return error
     6244     :
     6245    find first buf_rule-call-param no-lock where
     6246   buf_rule-call-param.codex_id = p-codex-id
     6247   and buf_rule-call-param.ruleset_id = p-ruleset-id
     6248   and buf_rule-call-param.call_id = p-call-id
     6249   and buf_rule-call-param.order_id = p-order-id
     6250   and buf_rule-call-param.rule_id = p-rule-id
     6251   and buf_rule-call-param.param-name = "p-xsd-file"
     6252    no-error.
     6253   if available buf_rule-call-param then do:
     6254   assign p-xsd-file = buf_rule-call-param.param-value-character.
     6255   end.
     6256       case p-ruleset-id:
     6257         when 3 then do:
     6258           assign
     6259           v-sign = 1
     6260           v-current-host-code = p-host-code
     6261           v-current-obj-type = p-obj-type
     6262           v-current-obj-code = p-obj-code
     6263           v-current-db-num = g#db-num
     6264           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     6265           file-name  = entry(1, p-process-file-name, chr(4))
     6266           v-xmlh = buffer buf_temp-xml-tables:handle:table-handle:default-buffer-handle
     6267           .
     6268           IF FILE-NAME = '' THEN DO:
     6269             run bge/oxmlinir.p ( output v-oxml-exch-dir
     6270                                 ,output v-oxml-heap-dir) .
     6271           end.
     6272           else do:
     6273             run rul/rum-xmli.p  (
     6274                                 input parparentproc
     6275                                 ,input p-log-handle
     6276                                 ,input file-name
     6277                                 ,input p-profile-id
     6278                                 ,input p-xsd-file
     6279                                 ,input 0
     6280                                 ,input 0
     6281                                 ,input-output v_dataseth
     6282                                 ,input-output v-xmlh
     6283                                 ) no-error.
     6284             if error-status:error then do:
     6285               undo, return error substitute("&1&2&3"
     6286                                               , error-status:get-message(1)
     6287                                               , chr(10)
     6288                                               , return-value ).
     6289             end.
     6290           end.
     6291           v-xmlh = buffer buf_temp-xml-tables:handle.
     6292         end.
     6293         otherwise do:
     6294           undo, return error "Неправильный вызов".
     6295         end.
     6296       end case.
     6297     end.
     6298   end procedure.
     6299   procedure delete-procedure :
     6300     do
     6301     on error undo, return error
     6302     :
     6303         run garbcoll_clear in this-procedure .
     6304     end.
     6305   end procedure.
     6306   procedure delete-ord-list :
     6307   define input parameter p-doc-code as character no-undo .
     6308   define input parameter p-trn-doc as character no-undo .
     6309   define buffer buf_ord-list for ord-list.
     6310   for each temp-ord-line where
     6311           temp-ord-line.doc-code = p-doc-code
     6312       and temp-ord-line.trn-doc = p-trn-doc
     6313           :
     6314     delete temp-ord-line.
     6315   end.
     6316   find first buf_ord-list where
     6317             buf_ord-list.doc-code = p-doc-code
     6318         and buf_ord-list.trn-doc = p-trn-doc no-error .
     6319   if available buf_ord-list then delete buf_ord-list.
     6320   end procedure.
     6321   procedure cb_getnextfilename :
     6322   define input-output parameter p-rfile-name as character no-undo .
     6323   define input-output parameter p-lfile-name as character no-undo .
     6324   define buffer buf_temp-filelist for temp-filelist.
     6325   do
     6326   on error undo, return error
     6327   :
     6328     find first buf_temp-filelist where
     6329               buf_temp-filelist.full-name > p-rfile-name no-error .
     6330     if available buf_temp-filelist then do:
     6331       assign
     6332       p-rfile-name = buf_temp-filelist.full-name
     6333       p-lfile-name =  v-exchange-dir + chr(47) + buf_temp-filelist.file-name
     6334       .
     6335     end.
     6336     else do:
     6337       assign
     6338       p-rfile-name = ''
     6339       p-lfile-name = ''
     6340       .
     6341     end.
     6342   end.
     6343   end procedure.
