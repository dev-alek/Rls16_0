     3005   procedure xmlchar-encode :
     3006   define input parameter p-in-string      as character        no-undo.
     3007   define output parameter p-out-string    as character        no-undo.
     3008       define variable v-position      as integer      no-undo.
     3009       define variable v-current-char  as character    no-undo.
     3010   do
     3011   on error undo, return error
     3012   :
     3013       assign
     3014           p-out-string = "":U
     3015       .
     3016       case p-in-string
     3017       :
     3018           when ?
     3019           then do:
     3020               assign
     3021                   p-out-string = "?":U
     3022               .
     3023           end.
     3024           when "?":U
     3025           then do:
     3026               assign
     3027                   p-out-string = "&#63;":U
     3028               .
