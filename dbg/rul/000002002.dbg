     1655   .
     1656   procedure get-header-by-rec :
     1657   define input  parameter p-gate-rec as character no-undo .
     1658   define output parameter p-tth as handle no-undo .
     1659   define variable v-ii as integer   no-undo .
     1660   define variable glog as logical   no-undo .
     1661   define variable v-rowid as rowid no-undo .
     1662   define variable v-tbl-name as character no-undo .
     1663   define variable v-longchar as longchar no-undo .
     1664   define variable v-txmlh as handle no-undo .
     1665   define buffer buf_clob-data for ub.clob-data.
     1666   main-block:
     1667   do
     1668   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info13, return-value, chr(10), error-status :get-message (1))
     1669   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info13 )
     1670   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info13 )
     1671   :
     1672     run gen-row-keyr in  this-procedure  (
     1673                                           input  p-gate-rec
     1674                                           ,input  ?
     1675                                           ,input  "ub"
     1676                                           ,input  ?
     1677                                           ,input  NO-LOCK
     1678                                           ,output v-rowid
     1679                                           ,output v-tbl-name   ) no-error.
     1680       find first buf_clob-data no-lock where
     1681                 rowid(buf_clob-data) = v-rowid  no-error.
     1682       if not available buf_clob-data then do:
     1683         undo, return error substitute("Не найден CLOB  &1"
     1684                                         , p-gate-rec
     1685                                         ).
     1686       end.
     1687       assign
     1688       v-longchar = buf_clob-data.cdata
     1689       .
     1690       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1691       if error-status :error then do:
     1692         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1693       end.
     1694       create temp-table p-tth .
     1695       glog = p-tth:READ-XMLSCHEMA( "LONGCHAR"
     1696                                     , v-longchar
     1697                                     , ?
     1698                                     , ?
     1699                                     , ?
     1700                                     ) no-error.
     1701       v-longchar = '':U.
     1702       define variable v-esm as character no-undo .
     1703       v-esm = error-status:get-message(1).
     1704       if error-status :error
     1705       or not glog
     1706       then do:
     1707         delete object p-tth no-error.
     1708         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     1709                                    , p-gate-rec
     1710                                    , buf_clob-data.file-name_
     1711                                    , chr(10)
     1712                                    , v-esm
     1713                                     ).
     1714       end.
     1715   end.
     1716   end procedure.
     1717   // { bge/getoxmlh.i } 23/VIII-2018 xmllib.i и tmpcxmlh.i вставлены напрямую
     1718   define variable vss-include-info14 as character format "X(65)" no-undo
     1719   initial "@(#)$Workfile$ $Revision$".
     1720   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1721   define stream stmXMLOut.
     1722   define stream stmXMLLog.
     1723   define stream strXMLIn.
     1724   define temp-table temp_xmllib_rec-list no-undo
     1725       field recName       as character
     1726       field recLevel      as integer
     1727       field recOpenLine   as integer
     1728       field recCloseLine  as integer
     1729       field closed        as logical
     1730       index pi is primary unique
     1731           recName
     1732           recLevel
     1733       index cl
     1734           closed
     1735   .
     1736   define temp-table temp_xmllib_rec-fld-list no-undo
     1737       field recName       as character
     1738       field recLevel      as integer
     1739       field fldName       as character
     1740       field fldOpenLine   as integer
     1741       field fldCloseLine  as integer
     1742       field closed        as logical
     1743       index pi is primary unique
     1744           recName
     1745           recLevel
     1746           fldName
     1747       index fn
     1748           fldName
     1749       index cl
     1750           closed
     1751   .
     1752   define temp-table temp_xmllib_rec no-undo
     1753       field rec-key       as integer
     1754       field recLevel      as integer
     1755       field recOpenLine   as integer
     1756       field recCloseLine  as integer
     1757       field recName       as character
     1758       field closed        as logical
     1759       index pi is primary unique
     1760           rec-key
     1761       index nm
     1762           recName
     1763           closed
     1764           rec-key
     1765       index cl
     1766           closed
     1767       index rlv
     1768           recName
     1769           recLevel
     1770           closed
     1771           rec-key
     1772   .
     1773   define temp-table temp_xmllib_rec-fld no-undo
     1774       field fld-key       as integer
     1775       field rec-key       as integer
     1776       field fldOpenLine   as integer
     1777       field fldCloseLine  as integer
     1778       field fldName       as character
     1779       field fldValue      as character
     1780       field closed        as logical
     1781       index pi is primary unique
     1782           fld-key
     1783       index nm
     1784           rec-key
     1785           fldName
     1786           closed
     1787           fld-key
     1788       index cl
     1789           closed
     1790   .
     1791   define variable v-xmllib-rec-key            as integer      no-undo .
     1792   define variable v-xmllib-rec-fld-key        as integer      no-undo .
     1793   define variable v-xmllib-dirname            as character    no-undo .
     1794   define variable v-xmllib-filename           as character    no-undo .
     1795   define variable v-xmllib-log-filename       as character    no-undo .
     1796   define variable v-xmllib-log-handle         as handle       no-undo .
     1797   define variable v-xmllib-log-proc-name      as character    no-undo .
     1798   define variable v-xmllib-error-status       as logical      no-undo .
     1799   define variable v-xmllib-sax-reader-handle  as handle       no-undo .
     1800   define variable v-xmllib-prg-bar-handle     as handle       no-undo .
     1801   define variable v-xmllib-codepage-convert   as logical      no-undo .
     1802   define variable v-xmllib-codepage-source    as character    no-undo .
     1803   define variable v-xmllib-codepage-target    as character    no-undo .
     1804   procedure xmllib-clear-parse-data :
     1805   do
     1806   on error undo, return error
     1807   :
     1808       empty temp-table temp_xmllib_rec-list.
     1809       empty temp-table temp_xmllib_rec-fld-list.
     1810       empty temp-table temp_xmllib_rec.
     1811       empty temp-table temp_xmllib_rec-fld.
     1812   end.
     1813   end procedure.
     1814   procedure xmllib-add-rec-fld :
     1815   define input parameter p-rec-name       as character        no-undo.
     1816   define input parameter p-rec-fld-name   as character        no-undo.
     1817       define buffer buf_rec-list        for temp_xmllib_rec-list.
     1818       define buffer buf_rec-fld-list    for temp_xmllib_rec-fld-list.
     1819   do
     1820   for buf_rec-list
     1821     , buf_rec-fld-list
     1822   on error undo, return error
     1823   :
     1824       find first buf_rec-list
     1825            where buf_rec-list.recName = p-rec-name
     1826       no-error.
     1827       if not available buf_rec-list
     1828       then do:
     1829           create buf_rec-list.
     1830           assign
     1831               buf_rec-list.recName        = p-rec-name
     1832               buf_rec-list.recOpenLine    = 0
     1833               buf_rec-list.recCloseLine   = 0
     1834               buf_rec-list.closed         = yes
     1835           .
     1836       end.
     1837       find first buf_rec-fld-list
     1838            where buf_rec-fld-list.recName = p-rec-name
     1839              and buf_rec-fld-list.fldName = p-rec-fld-name
     1840       no-error.
     1841       if not available buf_rec-fld-list
     1842       then do:
     1843           create buf_rec-fld-list.
     1844           assign
     1845               buf_rec-fld-list.recName        = p-rec-name
     1846               buf_rec-fld-list.fldName        = p-rec-fld-name
     1847               buf_rec-fld-list.fldOpenLine    = 0
     1848               buf_rec-fld-list.fldCloseLine   = 0
     1849               buf_rec-fld-list.closed         = yes
     1850           .
     1851       end.
     1852   end.
     1853   end procedure.
     1854   procedure xmllib-tag-open:
     1855   define input parameter v-tag-level  as integer      no-undo.
     1856   define input parameter v-tag-name   as character    no-undo.
     1857   define input parameter v-tag-value  as character    no-undo.
     1858   do
     1859   on error undo, return error
     1860   :
     1861       assign
     1862           v-tag-name = trim( v-tag-name )
     1863       .
     1864       put stream stmXMLOut unformatted
     1865           substitute( "&1&2<&3&4&5>"
     1866               , chr(10)
     1867               , fill(" ", 4 * v-tag-level)
     1868               , v-tag-name
     1869               , ( if v-tag-value = "":U or v-tag-value = ? then "":U else " ":U )
     1870               , v-tag-value
     1871           )
     1872       .
     1873   end.
     1874   end procedure.
     1875   procedure xmllib-tag-put:
     1876   define input parameter v-tag-level      as integer      no-undo.
     1877   define input parameter v-tag-name       as character    no-undo.
     1878   define input parameter v-tag-value      as character    no-undo.
     1879   define input parameter v-empty-mode     as integer      no-undo.
     1880   do
     1881   on error undo, return error
     1882   :
     1883       assign
     1884           v-tag-name = trim( v-tag-name )
     1885       .
     1886       if  v-empty-mode = 1
     1887       or (v-empty-mode = 0 and (v-tag-value <> "":U and v-tag-value <> ?) )
     1888       or (v-empty-mode = 2 and (v-tag-value <> "":U and v-tag-value <> ? and v-tag-value <> "0":U))
     1889       or (v-empty-mode = 3 and (v-tag-value <> "":U and v-tag-value <> ? and caps(v-tag-value) <> "no":U))
     1890       then do:
     1891           run xmlchar-encode in this-procedure (
     1892                 input v-tag-value
     1893               , output v-tag-value
     1894           ).
     1895           put stream stmXMLOut unformatted
     1896               substitute( "&1&2<&3>&4</&3>"
     1897                   , chr(10)
     1898                   , fill(" ":U, 4 * v-tag-level)
     1899                   , v-tag-name
     1900                   , v-tag-value
     1901               )
     1902           .
     1903       end.
     1904   end.
     1905   end procedure.
     1906   procedure xmllib-tag-put-null :
     1907   define input parameter p-tag-level  as integer      no-undo.
     1908   define input parameter p-tag-name   as character    no-undo.
     1909   do
     1910   on error undo, return error
     1911   :
     1912       assign
     1913           p-tag-name = trim( p-tag-name )
     1914       .
     1915       put stream stmXMLOut unformatted
     1916           substitute( '&1&2<&3 nil="true" /&3>'
     1917               , chr(10)
     1918               , fill(" ":U, 4 * p-tag-level)
     1919               , p-tag-name
     1920           )
     1921       .
     1922   end.
     1923   end procedure.
     1924   procedure xmllib-tag-close:
     1925   define input parameter v-tag-level as integer      no-undo.
     1926   define input parameter v-tag-name  as character    no-undo.
     1927   do
     1928   on error undo, return error
     1929   :
     1930       assign
     1931           v-tag-name = trim( v-tag-name )
     1932       .
     1933       put stream stmXMLOut unformatted
     1934           substitute( "&1&2</&3>"
     1935               , chr(10)
     1936               , fill( " ":U, 4 * v-tag-level)
     1937               , v-tag-name
     1938           )
     1939       .
     1940   end.
     1941   end procedure.
     1942   procedure xmllib-write-log:
     1943   define input parameter v-filename   as character    no-undo.
     1944   define input parameter v-log-level  as integer      no-undo.
     1945   define input parameter v-out-string as character    no-undo.
     1946   do
     1947   on error undo, return error
     1948   :
     1949       output stream stmXMLLog to value( v-filename ) append.
     1950       put stream stmXMLLog unformatted
     1951           chr(10)
     1952       .
     1953       put stream stmXMLLog unformatted
     1954           ( if v-log-level = 0
     1955             or v-out-string = "&DLine":U
     1956             or v-out-string = "&Line":U
     1957             then "":U
     1958             else cur-time-string-sec() + " ":U )
     1959       .
     1960       put stream stmXMLLog unformatted
     1961           ( if v-out-string = "&Line":U
     1962             then fill( "-":U, 80 )
     1963             else if v-out-string = "&DLine":U
     1964                  then fill( "=":U, 80 )
     1965                  else v-out-string )
     1966       .
     1967       output stream stmXMLLog close.
     1968   end.
     1969   end procedure.
     1970   procedure xmllib-write-edt:
     1971   define input parameter v-editor-handle    as handle       no-undo.
     1972   define input parameter v-log-level        as integer      no-undo.
     1973   define input parameter v-out-string       as character    no-undo.
     1974   do
     1975   on error undo, return error
     1976   :
     1977       if valid-handle ( v-editor-handle )
     1978       then do:
     1979           v-editor-handle :move-to-eof().
     1980           v-editor-handle :insert-string( ( if v-log-level = 0
     1981                                             or v-out-string = "&DLine":U
     1982                                             or v-out-string = "&Line":U
     1983                                             then "":U
     1984                                             else cur-time-string-sec() + " ":U
     1985                                         ) ).
     1986           v-editor-handle :insert-string( ( if v-out-string = "&Line":U
     1987                                             then fill( "-":U, 80 )
     1988                                             else if v-out-string = "&DLine":U then fill("=":U, 80)
     1989                                             else fill( " ":U, v-log-level) + v-out-string
     1990                                         ) ).
     1991           v-editor-handle :insert-string( chr(10) ).
     1992       end.
     1993   end.
     1994   end procedure.
     1995   procedure xmllib-show-cnt:
     1996   define input parameter v-fillin-handle     as handle   no-undo.
     1997   do
     1998   on error undo, return error
     1999   :
     2000       if valid-handle( v-fillin-handle )
     2001       then do:
     2002           assign
     2003               v-fillin-handle :visible = true
     2004           .
     2005       end.
     2006   end.
     2007   end procedure.
     2008   procedure xmllib-hide-cnt:
     2009   define input parameter v-fillin-handle     as handle   no-undo.
     2010   do
     2011   on error undo, return error
     2012   :
     2013       if valid-handle( v-fillin-handle )
     2014       then do:
     2015           assign v-fillin-handle :visible = false.
     2016       end.
     2017   end.
     2018   end procedure.
     2019   procedure xmllib-write-cnt:
     2020   define input parameter v-fillin-handle    as handle       no-undo.
     2021   define input parameter v-fillin-string    as character    no-undo.
     2022   do
     2023   on error undo, return error
     2024   :
     2025       if valid-handle( v-fillin-handle )
     2026       then do:
     2027           assign
     2028               v-fillin-handle :SCREEN-value = v-fillin-string
     2029           .
     2030       end.
     2031   end.
     2032   end procedure.
     2033   procedure xmllib-write-header:
     2034   define input parameter p-first-file     as logical      no-undo.
     2035   define input parameter p-xml-file-name  as character    no-undo.
     2036   define input parameter p-list-file-name as character    no-undo.
     2037   define input parameter p-file-number    as integer      no-undo.
     2038   define input parameter p-have-prev      as logical      no-undo.
     2039   define input parameter p-prev-filename  as character    no-undo.
     2040   define input parameter p-parameter-list as character    no-undo.
     2041       define variable v-counter    as integer        no-undo.
     2042   do
     2043   on error undo, return error
     2044   :
     2045       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     2046       put stream stmXMLOut unformatted
     2047           "<?xml version='1.0' encoding='windows-1251'?>"
     2048       .
     2049       run xmllib-tag-open( input 0, input "root"          , input "":U ).
     2050       run xmllib-tag-open( input 0, input "THheader"        , input "":U ).
     2051       run xmllib-tag-put( input 1 , input "THfileName"      , input p-xml-file-name + "xml":U  , input 0 ).
     2052       run xmllib-tag-put( input 1 , input "THfileNumber"    , input string( p-file-number     ), input 0 ).
     2053       run xmllib-tag-put( input 1 , input "THhavePrev"      , input string( p-have-prev       ), input 3 ).
     2054       run xmllib-tag-put( input 1 , input "THprevFileName"  , input p-prev-filename            , input 0 ).
     2055       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     2056       :
     2057           run xmllib-tag-put(
     2058                 input 1
     2059               , input entry( 2 * v-counter, p-parameter-list )
     2060               , input entry( 2 * v-counter + 1, p-parameter-list )
     2061               , input 0
     2062           ).
     2063       end.
     2064       run xmllib-tag-close( input 0, input "THheader" ).
     2065       output stream stmXMLOut close.
     2066       if p-list-file-name <> "":U
     2067       then do:
     2068           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     2069           if p-first-file = yes
     2070           then do:
     2071               put stream stmXMLOut unformatted
     2072                   "<?xml version='1.0' encoding='windows-1251'?>"
     2073               .
     2074               run xmllib-tag-open( input 0, input "OpenXML", input "" ).
     2075           end.
     2076           run xmllib-tag-open( input 1, input "THfile", input "" ).
     2077           run xmllib-tag-put( input 2, input "THfileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     2078           run xmllib-tag-put( input 2, input "THfileNumber"     , input string( p-file-number     ), input 0 ).
     2079           run xmllib-tag-put( input 2, input "THhavePrev"       , input string( p-have-prev       ), input 3 ).
     2080           run xmllib-tag-put( input 2, input "THprevFileName"   , input p-prev-filename            , input 0 ).
     2081           do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     2082           :
     2083               run xmllib-tag-put(
     2084                   input 2
     2085                   , input entry( 2 * v-counter, p-parameter-list )
     2086                   , input entry( 2 * v-counter + 1, p-parameter-list )
     2087                   , input 0
     2088               ).
     2089           end.
     2090           run xmllib-tag-close( input 1, input "THfile" ).
     2091           output stream stmXMLOut close.
     2092       end.
     2093   end.
     2094   end procedure.
     2095   procedure xmllib-write-footer:
     2096   define input parameter p-last-file      as logical      no-undo.
     2097   define input parameter p-xml-file-name  as character    no-undo.
     2098   define input parameter p-list-file-name as character    no-undo.
     2099   define input parameter p-have-next      as logical      no-undo.
     2100   define input parameter p-next-file-name as character    no-undo.
     2101       define variable v-error-num     as integer           no-undo.
     2102   do
     2103   on error undo, return error
     2104   :
     2105       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     2106       if p-have-next = yes
     2107       then do:
     2108           run xmllib-tag-open( input 0, input "footer", "" ).
     2109           run xmllib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     2110           run xmllib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     2111           run xmllib-tag-close( input 0, input "footer" ).
     2112       end.
     2113       run xmllib-tag-close( input 0, input "root" ).
     2114       output stream stmXMLOut close.
     2115       run bge/os_copy.p (
     2116             input "M"
     2117           , input p-xml-file-name + "tmp"
     2118           , input p-xml-file-name + "xml"
     2119           , output v-error-num
     2120       ).
     2121       if p-last-file = yes
     2122       and p-list-file-name <> "":U
     2123       then do:
     2124           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     2125               run xmllib-tag-close( input 0, input "OpenXML" ).
     2126           output stream stmXMLOut close.
     2127           run bge/os_copy.p (
     2128                 input "M"
     2129               , input p-list-file-name + "tmp"
     2130               , input p-list-file-name + "xml":U
     2131               , output v-error-num
     2132           ).
     2133       end.
     2134   end.
     2135   end procedure.
     2136   procedure xmllib-filename :
     2137   define input parameter p-subdir             as character        no-undo.
     2138   define input parameter p-prefix             as character    no-undo.
     2139   define output parameter p-xml-file-name     as character    no-undo.
     2140   define output parameter p-log-file-name     as character    no-undo.
     2141   define output parameter p-list-file-name    as character    no-undo.
     2142       define variable v-home-dir  as character    no-undo.
     2143       define variable v-error-num as integer      no-undo.
     2144   do
     2145   on error undo, return error
     2146   :
     2147       get-key-value section "OXML" key "oxml-dir" value v-home-dir.
     2148       if v-home-dir = ?
     2149       then do:
     2150           message
     2151             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     2152             skip "Нет параметра oxml-dir в секции [OXML]."
     2153             skip(1)
     2154             skip "Обратитесь к администратору."
     2155           view-as alert-box error.
     2156           undo, return error .
     2157       end.
     2158       if p-subdir <> "":U
     2159       then do:
     2160           assign
     2161               v-home-dir = substitute( "&1/out/&2", v-home-dir, p-subdir )
     2162           .
     2163       end.
     2164       run gbl/dir-cre.p (
     2165           input v-home-dir
     2166       ) no-error.
     2167       if error-status :error
     2168       then do:
     2169           message
     2170             skip "Неверно задан каталог экспорта в ini-файле."
     2171             skip "Не удаётся создать каталог, указанный параметром"
     2172             skip "oxml-dir в секции [OXML]."
     2173             skip(1)
     2174             skip "Обратитесь к администратору."
     2175           view-as alert-box error.
     2176           undo, return error .
     2177       end.
     2178       run bge/genfname.p (
     2179             input v-home-dir
     2180           , input p-prefix
     2181           , input ""
     2182           , input "xml"
     2183           , input "tmp"
     2184           , output p-xml-file-name
     2185       ).
     2186       assign
     2187           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     2188           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     2189           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     2190       .
     2191   end.
     2192   end procedure.
     2193   procedure xmllib-check-file-size :
     2194   define input parameter p-out-filename   as character    no-undo.
     2195   define output parameter p-is-big        as logical      no-undo.
     2196       define variable v-current-position    as integer        no-undo.
     2197   do
     2198   on error undo, return error
     2199   :
     2200       assign
     2201           v-current-position = seek( stmXMLOut )
     2202       .
     2203       if v-current-position / 1024 / 1024  >= 100
     2204       then do:
     2205           assign
     2206               p-is-big = yes
     2207           .
     2208       end.
     2209   end.
     2210   end procedure.
     2211   procedure xmllib-parse-file :
     2212   define input parameter p-full-filename      as character        no-undo.
     2213       define variable v-num-dirs              as integer      no-undo .
     2214       define variable v-str                   as character    no-undo .
     2215       define variable v-str-count             as int64        no-undo .
     2216   do
     2217   on error undo, return error
     2218   :
     2219       assign
     2220           v-num-dirs              = num-entries( p-full-filename,"\/":U )
     2221           v-xmllib-error-status   = no
     2222       .
     2223       if v-num-dirs > 1
     2224       then do:
     2225           assign
     2226               v-xmllib-filename = entry( v-num-dirs, p-full-filename, "\/":U )
     2227               v-xmllib-dirname  = substring( p-full-filename, 1, length( p-full-filename ) - length( v-xmllib-filename ) - 1 )
     2228           .
     2229       end.
     2230       else do:
     2231           assign
     2232               v-xmllib-filename = p-full-filename
     2233               v-xmllib-dirname  = "":U
     2234           .
     2235       end.
     2236       if valid-handle(v-xmllib-prg-bar-handle)
     2237       then do:
     2238   if session :set-wait-state( "compiler" ) then.
     2239         input stream strXMLIn from value(p-full-filename) .
     2240         repeat
     2241         :
     2242           import stream strXMLIn unformatted v-str no-error .
     2243           assign
     2244             v-str-count = v-str-count + 1
     2245           .
     2246         end.
     2247         input stream strXMLIn close .
     2248   if session :set-wait-state( "" ) then.
     2249         run prg-bar_init-cb-handle in this-procedure ( input v-xmllib-prg-bar-handle ) .
     2250         run prg-bar_new in this-procedure ( input 1 , input v-str-count) .
     2251         run prg-bar_show in this-procedure .
     2252       end.
     2253       create sax-reader v-xmllib-sax-reader-handle.
     2254       v-xmllib-sax-reader-handle :set-input-source( "FILE":U, p-full-filename ).
     2255       v-xmllib-sax-reader-handle :sax-parse( ) no-error.
     2256       if error-status :error
     2257       then do:
     2258           run xmllib-parse-error in this-procedure ( input substitute("&1 &2 &3&4Ошибка обработки XML файла.&4&5&4&5&4&7&4&8"
     2259                                                                       ,vss-workfile
     2260                                                                       ,vss-revision
     2261                                                                       ,vss-description
     2262                                                                       ,chr(10)
     2263                                                                       ,return-value
     2264                                                                       ,trim(error-status :get-message(1))
     2265                                                                       ,trim(error-status :get-message(2))
     2266                                                                       ,trim(error-status :get-message(3)))
     2267                                                     ).
     2268           undo, return error .
     2269       end.
     2270       if v-xmllib-error-status <> no
     2271       then do:
     2272           run xmllib-parse-error in this-procedure (
     2273               input "*** При обработке XML файла были ошибки."
     2274           ).
     2275           delete object v-xmllib-sax-reader-handle.
     2276       end.
     2277       delete object v-xmllib-sax-reader-handle.
     2278       if valid-handle(v-xmllib-prg-bar-handle)
     2279       then do:
     2280         run prg-bar_delete in this-procedure .
     2281       end.
     2282   end.
     2283   end procedure.
     2284   procedure xmllib-parse-progressive :
     2285   define input parameter p-full-filename      as character no-undo .
     2286   define input parameter p-pack-data          as memptr no-undo .
     2287   define input parameter p-parse-first        as logical no-undo .
     2288   define input parameter p-first-err          as logical no-undo .
     2289   define output parameter p-parse-status as integer no-undo .
     2290   define variable v-num-dirs              as integer no-undo .
     2291   define variable glog                    as logical no-undo .
     2292   define variable v-pack-size             as int64 no-undo .
     2293   do
     2294   on error undo, return error
     2295   :
     2296     if p-parse-first then do:
     2297       if valid-handle(v-xmllib-sax-reader-handle)
     2298       then do:
     2299       end.
     2300       assign
     2301           v-num-dirs              = num-entries( p-full-filename,"\/":U )
     2302           v-xmllib-error-status   = no
     2303       .
     2304       if v-num-dirs > 1
     2305       then do:
     2306           assign
     2307               v-xmllib-filename = entry( v-num-dirs, p-full-filename, "\/":U )
     2308               v-xmllib-dirname  = substring( p-full-filename, 1, length( p-full-filename ) - length( v-xmllib-filename ) - 1 )
     2309           .
     2310       end.
     2311       else do:
     2312           assign
     2313               v-xmllib-filename = p-full-filename
     2314               v-xmllib-dirname  = "":U
     2315           .
     2316       end.
     2317       create sax-reader v-xmllib-sax-reader-handle.
     2318       v-pack-size = get-size (p-pack-data) .
     2319       if v-pack-size > 0 then
     2320         glog = v-xmllib-sax-reader-handle :set-input-source( "MEMPTR":U, p-pack-data ) no-error.
     2321       else
     2322         glog = v-xmllib-sax-reader-handle :set-input-source( "FILE":U, p-full-filename ) no-error.
     2323       if error-status :error
     2324       or not glog
     2325       then do:
     2326         delete object v-xmllib-sax-reader-handle.
     2327         run xmllib-parse-error in this-procedure ( input substitute("&1 &2 &3&4Ошибка обработки XML файла.&4&5&4&5&4&7&4&8"
     2328                                                                     ,vss-workfile
     2329                                                                     ,vss-revision
     2330                                                                     ,vss-description
     2331                                                                     ,chr(10)
     2332                                                                     ,return-value
     2333                                                                     ,trim(error-status :get-message(1))
     2334                                                                     ,trim(error-status :get-message(2))
     2335                                                                     ,trim(error-status :get-message(3)) )
     2336                                                   ).
     2337         undo, return error .
     2338       end.
     2339       v-xmllib-sax-reader-handle :sax-parse-first( ) no-error.
     2340     end.
     2341     else do:
     2342       v-xmllib-sax-reader-handle :sax-parse-next( ) no-error.
     2343     end.
     2344     if error-status :error
     2345     then do:
     2346       delete object v-xmllib-sax-reader-handle.
     2347       run xmllib-parse-error in this-procedure ( input substitute("&1 &2 &3&4Ошибка обработки XML файла.&4&5&4&5&4&7&4&8"
     2348                                                                   ,vss-workfile
     2349                                                                   ,vss-revision
     2350                                                                   ,vss-description
     2351                                                                   ,chr(10)
     2352                                                                   ,return-value
     2353                                                                   ,trim(error-status :get-message(1))
     2354                                                                   ,trim(error-status :get-message(2))
     2355                                                                   ,trim(error-status :get-message(3)) )
     2356                                                 ).
     2357       undo, return error .
     2358     end.
     2359     if v-xmllib-error-status <> no
     2360     then do:
     2361       run xmllib-parse-error in this-procedure (
     2362           input "*** При обработке XML файла были ошибки."
     2363       ).
     2364       if p-first-err then do:
     2365         delete object v-xmllib-sax-reader-handle.
     2366       end.
     2367       else do:
     2368         v-xmllib-error-status = no.
     2369       end.
     2370     end.
     2371     if v-xmllib-sax-reader-handle:parse-status = SAX-COMPLETE  then do:
     2372       p-parse-status = SAX-COMPLETE.
     2373       delete object v-xmllib-sax-reader-handle.
     2374       return '':U.
     2375     end.
     2376     else do:
     2377       p-parse-status = v-xmllib-sax-reader-handle:parse-status.
     2378       return '':U.
     2379     end.
     2380   end.
     2381   end procedure.
     2382   procedure StartElement :
     2383   define input parameter p-name-space     as character        no-undo.
     2384   define input parameter p-local-name     as character        no-undo.
     2385   define input parameter p-q-name         as character        no-undo.
     2386   define input parameter p-attributes     as handle           no-undo.
     2387       define buffer buf_rec             for temp_xmllib_rec.
     2388       define buffer buf_rec-fld         for temp_xmllib_rec-fld.
     2389       define buffer buf_rec-list        for temp_xmllib_rec-list.
     2390       define buffer buf_rec-fld-list    for temp_xmllib_rec-fld-list.
     2391   do
     2392   for buf_rec
     2393     , buf_rec-fld
     2394     , buf_rec-list
     2395     , buf_rec-fld-list
     2396   on error undo, return error
     2397   :
     2398       if valid-handle(v-xmllib-prg-bar-handle)
     2399       then do:
     2400         run prg-bar_stepto in this-procedure ( input SELF:LOCATOR-LINE-NUMBER ) .
     2401       end.
     2402       find first buf_rec-list
     2403            where buf_rec-list.recName = p-q-name
     2404       no-error.
     2405       if available buf_rec-list
     2406       then do:
     2407           if buf_rec-list.closed = no
     2408           then do:
     2409               find first buf_rec-fld-list
     2410                    where buf_rec-fld-list.recName = buf_rec-list.recName
     2411                      and buf_rec-fld-list.fldName = p-q-name
     2412               no-error.
     2413               if available buf_rec-fld-list
     2414               and buf_rec-list.recName = buf_rec-fld-list.recName
     2415               then do:
     2416                   if buf_rec-fld-list.closed = no
     2417                   then do:
     2418                       run xmllib-parse-error in this-procedure (
     2419                           input substitute( "Ошибка 1 открытия поля <&1> записи <&2>: Поле с этим именем уже открыто на строке &3."
     2420                                           , p-q-name
     2421                                           , p-q-name
     2422                                           , buf_rec-fld-list.fldOpenLine
     2423                                           )
     2424                       ).
     2425                   end.
     2426                   else do:
     2427                       run xmllib-parse-rec-fld-open in this-procedure (
     2428                             input buf_rec-list.recName
     2429                           , input buf_rec-list.recLevel
     2430                           , input buf_rec-fld-list.fldName
     2431                       ).
     2432                       assign
     2433                           buf_rec-fld-list.closed         = no
     2434                           buf_rec-fld-list.fldOpenLine    = v-xmllib-sax-reader-handle :locator-line-number
     2435                           buf_rec-fld-list.fldCloseLine   = 0
     2436                       .
     2437                   end.
     2438               end.
     2439               else do:
     2440                   assign
     2441                       buf_rec-list.recLevel = buf_rec-list.recLevel + 1
     2442                   .
     2443                   run xmllib-parse-rec-open in this-procedure (
     2444                         input buf_rec-list.recName
     2445                       , input buf_rec-list.recLevel
     2446                   ).
     2447                   assign
     2448                       buf_rec-list.closed         = no
     2449                       buf_rec-list.recOpenLine    = v-xmllib-sax-reader-handle :locator-line-number
     2450                       buf_rec-list.recCloseLine   = 0
     2451                   .
     2452               end.
     2453           end.
     2454           else do:
     2455               run xmllib-parse-rec-open in this-procedure (
     2456                     input buf_rec-list.recName
     2457                   , input buf_rec-list.recLevel
     2458               ).
     2459               assign
     2460                   buf_rec-list.closed         = no
     2461                   buf_rec-list.recOpenLine    = v-xmllib-sax-reader-handle :locator-line-number
     2462                   buf_rec-list.recCloseLine   = 0
     2463               .
     2464           end.
     2465       end.
     2466       else do:
     2467           open-record:
     2468           for each buf_rec-fld-list
     2469              where buf_rec-fld-list.fldName = p-q-name
     2470           :
     2471               find first buf_rec-list
     2472                    where buf_rec-list.recName = buf_rec-fld-list.recName
     2473                      and buf_rec-list.closed  = no
     2474               no-error.
     2475               if available buf_rec-list
     2476               then do:
     2477                   run xmllib-parse-rec-fld-open in this-procedure (
     2478                         input buf_rec-list.recName
     2479                       , input buf_rec-list.recLevel
     2480                       , input buf_rec-fld-list.fldName
     2481                   ).
     2482                   assign
     2483                       buf_rec-fld-list.recLevel       = buf_rec-list.recLevel
     2484                       buf_rec-fld-list.closed         = no
     2485                       buf_rec-fld-list.fldOpenLine    = v-xmllib-sax-reader-handle :locator-line-number
     2486                       buf_rec-fld-list.fldCloseLine   = 0
     2487                   .
     2488                   leave open-record.
     2489               end.
     2490           end.
     2491       end.
     2492   end.
     2493   end procedure.
     2494   procedure Characters :
     2495   define input parameter p-char-data  as memptr.
     2496   define input parameter p-numchars   as integer.
     2497       define variable v-data-string    as character    no-undo.
     2498       define variable v-cp-utf8           as integer no-undo init 65001 .
     2499       define variable v-cp-windows1251    as integer no-undo init 1251 .
     2500       define buffer buf_xmllib_rec             for temp_xmllib_rec.
     2501       define buffer buf_xmllib_rec-fld         for temp_xmllib_rec-fld.
     2502       define buffer buf_xmllib_rec-list        for temp_xmllib_rec-list.
     2503       define buffer buf_xmllib_rec-fld-list    for temp_xmllib_rec-fld-list.
     2504   do
     2505   for buf_xmllib_rec
     2506     , buf_xmllib_rec-fld
     2507     , buf_xmllib_rec-list
     2508     , buf_xmllib_rec-fld-list
     2509   on error undo, return error
     2510   :
     2511       find first buf_xmllib_rec-list
     2512            where buf_xmllib_rec-list.closed = no
     2513       no-error.
     2514       if available buf_xmllib_rec-list
     2515       then do:
     2516           find first buf_xmllib_rec-fld-list
     2517                where buf_xmllib_rec-fld-list.closed = no
     2518           no-error.
     2519           if available buf_xmllib_rec-fld-list
     2520           and buf_xmllib_rec-fld-list.recName  = buf_xmllib_rec-list.recName
     2521           and buf_xmllib_rec-fld-list.recLevel = buf_xmllib_rec-list.recLevel
     2522           then do:
     2523               find last buf_xmllib_rec
     2524                   where buf_xmllib_rec.recName  = buf_xmllib_rec-list.recName
     2525                     and buf_xmllib_rec.recLevel = buf_xmllib_rec-list.recLevel
     2526                     and buf_xmllib_rec.closed   = no
     2527               use-index nm
     2528               no-error.
     2529               if available buf_xmllib_rec
     2530               then do:
     2531                   find last buf_xmllib_rec-fld
     2532                       where buf_xmllib_rec-fld.rec-key = buf_xmllib_rec.rec-key
     2533                         and buf_xmllib_rec-fld.fldName = buf_xmllib_rec-fld-list.fldName
     2534                         and buf_xmllib_rec-fld.closed = no
     2535                   use-index nm
     2536                   no-error.
     2537                   if available buf_xmllib_rec-fld
     2538                   then do:
     2539                       assign
     2540                           v-data-string = get-string( p-char-data, 1, get-size( p-char-data ) )
     2541                       .
     2542                       if v-xmllib-codepage-convert = yes
     2543                       then do:
     2544                         assign
     2545                             v-data-string = codepage-convert( v-data-string , v-xmllib-codepage-target , v-xmllib-codepage-source )
     2546                         .
     2547                       end.
     2548                       run xmlchar-decode in this-procedure (
     2549                           input v-data-string
     2550                           , output v-data-string
     2551                       ).
     2552                       assign
     2553                           buf_xmllib_rec-fld.fldValue = trim( substitute( "&1&2", buf_xmllib_rec-fld.fldValue, v-data-string ) )
     2554                       .
     2555                   end.
     2556               end.
     2557           end.
     2558       end.
     2559   end.
     2560   end procedure.
     2561   procedure EndElement :
     2562   define input parameter p-name-space     as character        no-undo.
     2563   define input parameter p-local-name     as character        no-undo.
     2564   define input parameter p-q-name         as character        no-undo.
     2565       define buffer buf_rec             for temp_xmllib_rec.
     2566       define buffer buf_rec-fld         for temp_xmllib_rec-fld.
     2567       define buffer buf_rec-list        for temp_xmllib_rec-list.
     2568       define buffer buf_rec-fld-list    for temp_xmllib_rec-fld-list.
     2569   do
     2570   for buf_rec
     2571     , buf_rec-fld
     2572     , buf_rec-list
     2573     , buf_rec-fld-list
     2574   on error undo, return error
     2575   :
     2576       find last buf_rec-list
     2577           where buf_rec-list.recName = p-q-name
     2578       use-index pi
     2579       no-error.
     2580       if available buf_rec-list
     2581       then do:
     2582           if buf_rec-list.closed = yes
     2583           then do:
     2584               run xmllib-parse-error in this-procedure (
     2585                   input substitute( "Ошибка закрытия записи или поля <&1>: Нет метки открытой записи."
     2586                                   , p-q-name
     2587                                   )
     2588               ).
     2589           end.
     2590           else do:
     2591               find last buf_rec
     2592                   where buf_rec.recName  = buf_rec-list.recName
     2593                     and buf_rec.recLevel = buf_rec-list.recLevel
     2594                     and buf_rec.closed   = no
     2595               use-index nm
     2596               no-error.
     2597               if not available buf_rec
     2598               then do:
     2599                   run xmllib-parse-error in this-procedure (
     2600                       input substitute( "Ошибка закрытия записи или поля <&1> уровня &2: Нет открытой записи."
     2601                                       , p-q-name
     2602                                       , buf_rec-list.recLevel
     2603                                       )
     2604                   ).
     2605               end.
     2606               else do:
     2607                   find first buf_rec-fld-list
     2608                        where buf_rec-fld-list.recName  = buf_rec.recName
     2609                          and buf_rec-fld-list.recLevel = buf_rec.recLevel
     2610                          and buf_rec-fld-list.fldName  = p-q-name
     2611                          and buf_rec-fld-list.closed   = no
     2612                   no-error.
     2613                   if not available buf_rec-fld-list
     2614                   then do:
     2615                       if buf_rec.recName <> p-q-name
     2616                       then do:
     2617                           run xmllib-parse-error in this-procedure (
     2618                               input substitute( "Ошибка закрытия записи <&1>: Имя открытой записи не совпадает с именем метки."
     2619                                               , buf_rec.recName
     2620                                               )
     2621                           ).
     2622                       end.
     2623                       else do:
     2624                           assign
     2625                               buf_rec.closed              = yes
     2626                               buf_rec.recCloseLine        = v-xmllib-sax-reader-handle :locator-line-number
     2627                               buf_rec-list.recCloseLine   = v-xmllib-sax-reader-handle :locator-line-number
     2628                           .
     2629                           if buf_rec-list.recLevel > 0
     2630                           then do:
     2631                               assign
     2632                                   buf_rec-list.recLevel = buf_rec-list.recLevel - 1
     2633                               .
     2634                               for each buf_rec-fld-list
     2635                                  where buf_rec-fld-list.recName = buf_rec-list.recName
     2636                               :
     2637                                   assign
     2638                                       buf_rec-fld-list.recLevel = buf_rec-fld-list.recLevel - 1
     2639                                   .
     2640                               end.
     2641                           end.
     2642                           else do:
     2643                               assign
     2644                                   buf_rec-list.closed         = yes
     2645                               .
     2646                           end.
     2647                       end.
     2648                   end.
     2649                   else do:
     2650                       find last buf_rec-fld
     2651                           where buf_rec-fld.rec-key = buf_rec.rec-key
     2652                             and buf_rec-fld.fldName = buf_rec-fld-list.fldName
     2653                             and buf_rec-fld.closed  = no
     2654                       use-index nm
     2655                       no-error.
     2656                       if not available buf_rec-fld
     2657                       then do:
     2658                           run xmllib-parse-error in this-procedure (
     2659                               input substitute( "Ошибка 2 закрытия поля <&1>: Не найдено открытое поле с этим именем в записи <&2> уровня &3."
     2660                                               , buf_rec-fld-list.fldName
     2661                                               , buf_rec.recName
     2662                                               , buf_rec.recLevel
     2663                                               )
     2664                           ).
     2665                       end.
     2666                       else do:
     2667                           assign
     2668                               buf_rec-fld.closed              = yes
     2669                               buf_rec-fld-list.closed         = yes
     2670                               buf_rec-fld.fldCloseLine        = v-xmllib-sax-reader-handle :locator-line-number
     2671                               buf_rec-fld-list.fldCloseLine   = v-xmllib-sax-reader-handle :locator-line-number
     2672                           .
     2673                       end.
     2674                   end.
     2675               end.
     2676           end.
     2677       end.
     2678       else do:
     2679           close-field-rec:
     2680           for each buf_rec-fld-list
     2681              where buf_rec-fld-list.fldName = p-q-name
     2682           :
     2683               find first buf_rec-list
     2684                    where buf_rec-list.recName  = buf_rec-fld-list.recName
     2685                      and buf_rec-list.recLevel = buf_rec-fld-list.recLevel
     2686                      and buf_rec-list.closed   = no
     2687               no-error.
     2688               if available buf_rec-list
     2689               then do:
     2690                   find last buf_rec
     2691                       where buf_rec.recName  = buf_rec-list.recName
     2692                         and buf_rec.recLevel = buf_rec-list.recLevel
     2693                         and buf_rec.closed   = no
     2694                   use-index nm
     2695                   no-error.
     2696                   if not available buf_rec
     2697                   then do:
     2698                       run xmllib-parse-error in this-procedure (
     2699                           input substitute( "Ошибка закрытия поля <&1>: Нет открытой записи."
     2700                                           , p-q-name
     2701                                           )
     2702                       ).
     2703                   end.
     2704                   else do:
     2705                       find last buf_rec-fld
     2706                           where buf_rec-fld.rec-key = buf_rec.rec-key
     2707                             and buf_rec-fld.fldName = buf_rec-fld-list.fldName
     2708                             and buf_rec-fld.closed  = no
     2709                       use-index nm
     2710                       no-error.
     2711                       if not available buf_rec-fld
     2712                       then do:
     2713                           run xmllib-parse-error in this-procedure (
     2714                               input substitute( "Ошибка 1 закрытия поля <&1>: Не найдено открытое поле с этим именем в записи <&2> уровня &3."
     2715                                               , buf_rec-fld-list.fldName
     2716                                               , buf_rec.recName
     2717                                               , buf_rec.recLevel
     2718                                               )
     2719                           ).
     2720                       end.
     2721                       else do:
     2722                           assign
     2723                               buf_rec-fld.closed              = yes
     2724                               buf_rec-fld-list.closed         = yes
     2725                               buf_rec-fld.fldCloseLine        = v-xmllib-sax-reader-handle :locator-line-number
     2726                               buf_rec-fld-list.fldCloseLine   = v-xmllib-sax-reader-handle :locator-line-number
     2727                           .
     2728                       end.
     2729                   end.
     2730                   leave close-field-rec.
     2731               end.
     2732           end.
     2733       end.
     2734   end.
     2735   end procedure.
     2736   procedure Error :
     2737   define input parameter p-error-message     as character        no-undo.
     2738   do
     2739   on error undo, return error
     2740   :
     2741       run xmllib-parse-error in this-procedure (
     2742           input p-error-message
     2743       ).
     2744       assign
     2745           v-xmllib-error-status = yes
     2746       .
     2747   end.
     2748   end procedure.
     2749   procedure xmllib-parse-error :
     2750   define input parameter p-err-message    as character        no-undo.
     2751   do
     2752   on error undo, return error
     2753   :
     2754       if valid-handle(v-xmllib-log-handle) then do:
     2755         run value(v-xmllib-log-proc-name) in  v-xmllib-log-handle
     2756                  (input substitute("&1Файл:    &2 &3&1Строка &4&1&5"
     2757                                    ,chr(10)
     2758                                    ,v-xmllib-dirname
     2759                                    ,v-xmllib-filename
     2760                                    ,(if valid-handle(v-xmllib-sax-reader-handle)
     2761                                      then v-xmllib-sax-reader-handle :locator-line-number
     2762                                      else ?)
     2763                                    ,p-err-message)).
     2764       end.
     2765       else do:
     2766         if v-xmllib-log-filename = "":U
     2767         then do:
     2768             message
     2769                     vss-workfile vss-revision vss-description
     2770                 skip "Файл:   " v-xmllib-dirname v-xmllib-filename
     2771                 skip "Строка: " (if valid-handle(v-xmllib-sax-reader-handle)
     2772                                  then v-xmllib-sax-reader-handle :locator-line-number
     2773                                  else ?)
     2774                 skip(1)
     2775                 skip p-err-message
     2776                 skip return-value
     2777                 skip trim( error-status :get-message( 1 ) )
     2778                     trim( error-status :get-message( 2 ) )
     2779                     trim( error-status :get-message( 3 ) )
     2780             view-as alert-box error.
     2781             undo, return error.
     2782         end.
     2783         else do:
     2784           output to value( v-xmllib-log-filename ).
     2785           put unformatted
     2786               substitute( "&1&2", chr(10), p-err-message )
     2787           .
     2788           output close.
     2789         end.
     2790       end.
     2791   end.
     2792   end procedure.
     2793   procedure xmllib-set-log-filename :
     2794   define input parameter p-log-filename   as character        no-undo.
     2795   do
     2796   on error undo, return error
     2797   :
     2798       run gbl/fileapnd.p (
     2799             input p-log-filename
     2800           , input "":U
     2801           , input 10
     2802       ) no-error.
     2803       if error-status :error
     2804       then do:
     2805           assign
     2806               v-xmllib-log-filename = "":U
     2807           .
     2808       end.
     2809       else do:
     2810           assign
     2811               v-xmllib-log-filename = p-log-filename
     2812           .
     2813       end.
     2814   end.
     2815   end procedure.
     2816   procedure xmllib-set-log-handle :
     2817   define input parameter p-log-handle    as handle        no-undo.
     2818   define input parameter p-log-proc-name as character no-undo .
     2819   do
     2820   on error undo, return error
     2821   :
     2822       if valid-handle(p-log-handle)
     2823       and lookup(p-log-proc-name, p-log-handle:internal-entries) > 0
     2824       then do:
     2825         assign
     2826         v-xmllib-log-handle    = p-log-handle
     2827         v-xmllib-log-proc-name = p-log-proc-name
     2828         .
     2829       end.
     2830       else do:
     2831         assign
     2832         v-xmllib-log-handle    = ?
     2833         v-xmllib-log-proc-name = '':U
     2834         .
     2835       end.
     2836   end.
     2837   end procedure.
     2838   procedure xmllib-set-prg-bar-handle :
     2839   define input parameter p-handle    as handle        no-undo.
     2840   do
     2841   on error undo, return error
     2842   :
     2843       if valid-handle(p-handle)
     2844       then do:
     2845         assign
     2846           v-xmllib-prg-bar-handle = p-handle
     2847         .
     2848       end.
     2849       else do:
     2850         assign
     2851           v-xmllib-prg-bar-handle = ?
     2852         .
     2853       end.
     2854   end.
     2855   end procedure.
     2856   procedure xmllib-set-codepage-convert :
     2857     define input  parameter p-codepage-source as character no-undo .
     2858     define input  parameter p-codepage-target as character no-undo .
     2859   do
     2860   on error undo, return error return-value
     2861   :
     2862     if ( p-codepage-source <> "" and p-codepage-target <> "" )
     2863     then do:
     2864       assign
     2865         v-xmllib-codepage-convert = yes
     2866         v-xmllib-codepage-source  = p-codepage-source
     2867         v-xmllib-codepage-target  = p-codepage-target
     2868       .
     2869     end.
     2870     else do:
     2871       assign
     2872         v-xmllib-codepage-convert = no
     2873         v-xmllib-codepage-source  = ""
     2874         v-xmllib-codepage-target  = ""
     2875       .
     2876     end.
     2877   end.
     2878   end procedure.
     2879   procedure xmllib-parse-rec-open :
     2880   define input parameter p-rec-name   as character        no-undo.
     2881   define input parameter p-rec-level  as integer          no-undo.
     2882       define buffer buf_temp_xmllib_rec       for temp_xmllib_rec.
     2883   do
     2884   for buf_temp_xmllib_rec
     2885   on error undo, return error
     2886   :
     2887        find first buf_temp_xmllib_rec
     2888            where buf_temp_xmllib_rec.recName = p-rec-name
     2889              and buf_temp_xmllib_rec.recLevel = p-rec-level
     2890              and buf_temp_xmllib_rec.closed  = no
     2891       use-index nm
     2892       no-error.
     2893       if available buf_temp_xmllib_rec
     2894       then do:
     2895           run xmllib-parse-error in this-procedure (
     2896               input substitute( "Ошибка 2 открытия записи <&1>: Запись с этим именем и уровнем &2 уже открыта на строке &3."
     2897                               , p-rec-name
     2898                               , p-rec-level
     2899                               , buf_temp_xmllib_rec.recOpenLine
     2900                               )
     2901           ).
     2902       end.
     2903       else do:
     2904           assign
     2905               v-xmllib-rec-key    = v-xmllib-rec-key + 1
     2906           .
     2907           create buf_temp_xmllib_rec.
     2908           assign
     2909               buf_temp_xmllib_rec.rec-key         = v-xmllib-rec-key
     2910               buf_temp_xmllib_rec.recOpenLine     = v-xmllib-sax-reader-handle :locator-line-number
     2911               buf_temp_xmllib_rec.recCloseLine    = 0
     2912               buf_temp_xmllib_rec.recName         = p-rec-name
     2913               buf_temp_xmllib_rec.recLevel        = p-rec-level
     2914               buf_temp_xmllib_rec.closed          = no
     2915           .
     2916       end.
     2917   end.
     2918   end procedure.
     2919   procedure xmllib-parse-rec-fld-open :
     2920   define input parameter p-rec-name   as character        no-undo.
     2921   define input parameter p-rec-level  as integer          no-undo.
     2922   define input parameter p-fld-name   as character        no-undo.
     2923       define buffer buf_temp_xmllib_rec       for temp_xmllib_rec.
     2924       define buffer buf_temp_xmllib_rec-fld   for temp_xmllib_rec-fld.
     2925   do
     2926   for buf_temp_xmllib_rec
     2927     , buf_temp_xmllib_rec-fld
     2928   on error undo, return error substitute( "Ошибка в xmllib-parse-rec-fld-open. &1. &2. &3"
     2929                                           , return-value
     2930                                           , trim( error-status :get-message( 1 ) )
     2931                                           , trim( error-status :get-message( 2 ) ) )
     2932   :
     2933       find last buf_temp_xmllib_rec
     2934           where buf_temp_xmllib_rec.recName   = p-rec-name
     2935             and buf_temp_xmllib_rec.recLevel  = p-rec-level
     2936             and buf_temp_xmllib_rec.closed    = no
     2937       use-index nm
     2938       no-error.
     2939       if not available buf_temp_xmllib_rec
     2940       then do:
     2941           run xmllib-parse-error in this-procedure (
     2942               input substitute( "Ошибка 2 открытия поля <&2> в записи <&1> уровня &3: Нет открытой записи."
     2943                               , p-rec-name
     2944                               , p-fld-name
     2945                               , p-rec-level
     2946                               )
     2947           ).
     2948       end.
     2949       else do:
     2950           find last buf_temp_xmllib_rec-fld
     2951               where buf_temp_xmllib_rec-fld.rec-key  = buf_temp_xmllib_rec.rec-key
     2952                 and buf_temp_xmllib_rec-fld.fldName  = p-fld-name
     2953                 and buf_temp_xmllib_rec-fld.closed   = no
     2954           use-index nm
     2955           no-error.
     2956           if available buf_temp_xmllib_rec-fld
     2957           then do:
     2958               run xmllib-parse-error in this-procedure (
     2959                   input substitute( "Ошибка 3 открытия поля <&2> в записи <&1>: Поле с этим именем уже открыто на строке &3."
     2960                                   , p-rec-name
     2961                                   , p-fld-name
     2962                                   , buf_temp_xmllib_rec-fld.fldOpenLine
     2963                                   )
     2964               ).
     2965           end.
     2966           else do:
     2967               assign
     2968                   v-xmllib-rec-fld-key    = v-xmllib-rec-fld-key + 1
     2969               .
     2970               create buf_temp_xmllib_rec-fld.
     2971               assign
     2972                   buf_temp_xmllib_rec-fld.fld-key         = v-xmllib-rec-fld-key
     2973                   buf_temp_xmllib_rec-fld.rec-key         = buf_temp_xmllib_rec.rec-key
     2974                   buf_temp_xmllib_rec-fld.fldOpenLine     = v-xmllib-sax-reader-handle :locator-line-number
     2975                   buf_temp_xmllib_rec-fld.fldCloseLine    = 0
     2976                   buf_temp_xmllib_rec-fld.fldName         = p-fld-name
     2977                   buf_temp_xmllib_rec-fld.closed          = no
     2978               .
     2979           end.
     2980       end.
     2981   end.
     2982   end procedure.
