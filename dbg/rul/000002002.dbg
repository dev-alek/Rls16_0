        1   using Ibs.Th.Rul.Route-data_.
        2   block-level on error undo, throw.
        3   define input parameter parparentproc as widget-handle no-undo .
        4   define input parameter p-parent-handle as handle no-undo .
        5   define input parameter p-log-handle  as handle no-undo .
        6   define input parameter p-cont-handle  as handle no-undo .
        7   define input parameter p-codex-id as integer no-undo .
        8   define input parameter p-ruleset-id as integer no-undo .
        9   define input parameter p-call-id as character no-undo .
       10   define input parameter p-order-id as integer no-undo .
       11   define input parameter p-rule-id as integer no-undo .
       12   define input parameter p-profile-id as integer no-undo .
       13   define input parameter p-is-dynamic as logical no-undo .
       14   define input parameter p-doc-type as character no-undo .
       15   define input parameter p-host-code like ub.sysconf.host-code no-undo .
       16   define input parameter p-obj-type like ub.clients.obj-type no-undo .
       17   define input parameter p-obj-code like ub.clients.obj-code no-undo .
       18   define input parameter p-doc-code as character no-undo .
       19   define input parameter p-process-file-name as character no-undo .
       20   define input parameter p-save       as integer no-undo .
       21   define input parameter v-curr-r-b   as character no-undo .
       22   define input parameter p-cmd-proc-handle as handle no-undo .
       23   define input parameter p-cmd-code  as integer no-undo .
       24   define variable vss-revision    as character no-undo init "$Revision$":U .
       25   define variable vss-author      as character no-undo init "$Author$":U .
       26   define variable vss-date        as character no-undo init "$Date$":U .
       27   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       28   define variable vss-archive     as character no-undo init "$Archive$":U .
       29   define variable vss-description as character no-undo init "Библиотека процедур для работы с кодексом 18 набор правил 4".
       30   procedure vss-get-info :
       31     define output parameter p-vss-revision    like vss-revision    no-undo .
       32     define output parameter p-vss-author      like vss-author      no-undo .
       33     define output parameter p-vss-date        like vss-date        no-undo .
       34     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       35     define output parameter p-vss-archive     like vss-archive     no-undo .
       36     define output parameter p-vss-description like vss-description no-undo .
       37     assign
       38       p-vss-revision    = vss-revision
       39       p-vss-author      = vss-author
       40       p-vss-date        = vss-date
       41       p-vss-workfile    = vss-workfile
       42       p-vss-archive     = vss-archive
       43       p-vss-description = vss-description
       44     .
       45   end procedure.
       46   procedure vss-get-parameters :
       47     define output parameter p-vss-parameters as character no-undo .
       48   end procedure.
       49   define new global shared variable g#vssrevis-logger as handle    no-undo .
       50   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       51   define variable v-vssrevis-logger                   as handle    no-undo .
       52   procedure vss-logevent :
       53     define input  parameter p-extra-paramters as character no-undo .
       54     define variable v-vssrevis-parameters as character no-undo .
       55     do
       56     on error undo, return error return-value
       57     :
       58       if  valid-handle(v-vssrevis-logger)
       59       and v-vssrevis-logger :get-signature("logevent") <> ""
       60       then do:
       61         run vss-get-parameters in this-procedure
       62           (output v-vssrevis-parameters
       63           ).
       64         run logevent in v-vssrevis-logger
       65           (input vss-workfile
       66           ,input vss-revision
       67           ,input v-vssrevis-parameters
       68           ,input p-extra-paramters
       69           ).
       70       end.
       71     end.
       72   end procedure.
       73   assign
       74     v-vssrevis-logger = g#vssrevis-logger
       75   .
       76   if  valid-handle(v-vssrevis-logger)
       77   and v-vssrevis-logger :get-signature("logevent") <> ""
       78   then do:
       79     assign
       80       v-vssrevis-logevent = true
       81     .
       82     run vss-logevent in this-procedure (input vss-description) .
       83   end.
       84   define new global shared variable g#language as character no-undo .
       85   if g#language <> '' and g#language <> 'rus':U then do:
       86     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       87   end.
       88   define new global shared variable g#library  as handle no-undo .
       89   define new global shared variable g#library2 as handle no-undo .
       90   define   shared variable g#auto as logical no-undo.
       91   define   shared variable g#news as logical no-undo.
       92   define   shared variable g#oxml as logical no-undo.
       93   define   shared variable g#esys as logical no-undo.
       94   define   shared variable g#news-source-db as integer no-undo.
       95   define   shared variable g#esys-source-esys as integer no-undo.
       96   define   shared variable g#db-num as integer   no-undo .
       97   define   shared variable g#userid as character no-undo .
       98   define   shared variable g#passwd as character no-undo .
       99   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      100   define  variable garbcoll_ii as integer no-undo .
      101   define  temp-table temp-gc no-undo
      102   field ii as integer
      103   field obj-r as handle
      104   field cn as character
      105   index pi is unique primary
      106   ii
      107   index icn
      108   cn.
      109   procedure garbcoll_create-gc-entry :
      110   define input parameter p-cn as character no-undo .
      111   define input parameter p-obj-r as handle no-undo .
      112     do
      113     on error undo, return error
      114     :
      115       create temp-gc.
      116       assign
      117       temp-gc.ii = garbcoll_ii
      118       garbcoll_ii = garbcoll_ii + 1
      119       temp-gc.cn = p-cn
      120       temp-gc.obj-r = p-obj-r
      121       .
      122     end.
      123   end procedure.
      124   procedure garbcoll_clear :
      125     do
      126     on error undo, return error
      127     :
      128       for each temp-gc:
      129         delete object temp-gc.obj-r.
      130         delete temp-gc.
      131       end.
      132     end.
      133   end procedure.
      134   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      135   procedure cur-time :
      136      define output parameter p-today as date      no-undo .
      137      define output parameter p-time  as integer   no-undo .
      138     do
      139     on error undo, return error
      140     :
      141       define variable v-date1 as date      no-undo .
      142       define variable v-date2 as date      no-undo .
      143       define variable v-time  as integer   no-undo .
      144       assign
      145         v-date1 = today
      146         v-time  = time
      147         v-date2 = today
      148       .
      149       if v-date1 <> v-date2
      150       then do:
      151         assign
      152           v-date1 = today
      153           v-time  = v-time
      154         .
      155       end.
      156       assign
      157         p-today = v-date1
      158         p-time  = v-time
      159       .
      160     end.
      161   end.
      162   function cur-time-date returns character
      163   :
      164     return string(today, '99/99/9999':U) .
      165   end.
      166   function cur-time-mjd returns decimal
      167   :
      168     define variable v-date as date      no-undo .
      169     define variable v-time as integer   no-undo .
      170     run cur-time in this-procedure
      171       (output v-date
      172       ,output v-time
      173       ) .
      174     return integer(v-date) - 2400002 + (v-time / 86400) .
      175   end.
      176   function cur-time-get-ending-index returns integer
      177   (input p-number as integer
      178   )
      179   :
      180     if p-number < 0
      181     or p-number = ?
      182     then do:
      183       return 1 .
      184     end.
      185     define variable v-rest as integer   no-undo .
      186     assign
      187       p-number = p-number modulo 100
      188     .
      189     if p-number < 20
      190     then do:
      191       assign
      192         v-rest = p-number
      193       .
      194     end.
      195     else do:
      196       assign
      197         v-rest = p-number modulo 10
      198       .
      199     end.
      200     case v-rest :
      201       when 1
      202       then do:
      203         return 2 .
      204       end.
      205       when 2 or
      206       when 3 or
      207       when 4
      208       then do:
      209         return 3 .
      210       end.
      211       otherwise do:
      212         return 1 .
      213       end.
      214     end case .
      215   end.
      216   procedure cur-time-mjd-to-date :
      217      define input  parameter i-mjd-diff as decimal no-undo.
      218      define output parameter o-Date     as date    no-undo.
      219      define output parameter o-Time     as integer no-undo.
      220      define variable v-day-number as integer   no-undo .
      221      if    i-mjd-diff < 0
      222         or i-mjd-diff = ?
      223      then do:
      224         return "?" .
      225      end.
      226      assign
      227         v-day-number = truncate(i-mjd-diff,0).
      228         o-Date = date(v-day-number + 2400002).
      229         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      230     .
      231   end.
      232   function cur-time-mjd-to-string returns character
      233   (input p-mjd-diff as decimal
      234   )
      235   :
      236     define variable v-day-number as integer   no-undo .
      237     define variable v-seconds    as integer   no-undo .
      238     define variable v-hour       as integer   no-undo .
      239     define variable v-min        as integer   no-undo .
      240     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      241     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      242     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      243     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      244     if p-mjd-diff < 0
      245     or p-mjd-diff = ?
      246     then do:
      247       return "?" .
      248     end.
      249     assign
      250       v-day-number = integer(truncate(p-mjd-diff,0))
      251       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      252     .
      253     if v-seconds > 86400
      254     then do:
      255       assign
      256         v-seconds = 86400 - 1
      257       .
      258     end.
      259     if v-seconds < 0
      260     then do:
      261       assign
      262         v-seconds = 0
      263       .
      264     end.
      265     assign
      266       v-hour = truncate(v-seconds / 3600, 0)
      267     .
      268     assign
      269       v-seconds = v-seconds modulo 3600
      270     .
      271     assign
      272       v-min = truncate(v-seconds / 60, 0)
      273     .
      274     assign
      275       v-seconds = v-seconds modulo 60
      276     .
      277     return
      278         (if v-day-number <> 0
      279           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      280           else ""
      281         )
      282       + (if v-day-number <> 0 or v-hour <> 0
      283           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      284           else ""
      285         )
      286       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      287           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      288           else ""
      289         )
      290       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      291       .
      292   end.
      293   function cur-time-string returns character
      294   :
      295     define variable v-date as date      no-undo .
      296     define variable v-time as integer   no-undo .
      297     run cur-time in this-procedure
      298       (output v-date
      299       ,output v-time
      300       ) .
      301     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      302   end.
      303   function cur-time-string-sec returns character
      304   :
      305     define variable v-date as date      no-undo .
      306     define variable v-time as integer   no-undo .
      307     run cur-time in this-procedure
      308       (output v-date
      309       ,output v-time
      310       ) .
      311     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      312   end.
      313   function cur-time-custom  returns character
      314   (input p-prefix as character
      315   ,input p-date-format as character
      316   ,input p-delimiter as character
      317   ,input p-time-format as character
      318   ,input p-suffix as character
      319   )
      320   :
      321     define variable v-date as date      no-undo .
      322     define variable v-time as integer   no-undo .
      323     run cur-time in this-procedure
      324       (output v-date
      325       ,output v-time
      326       ) .
      327     return
      328       p-prefix
      329       + string(v-date, p-date-format)
      330       + p-delimiter
      331       + string(v-time, p-time-format)
      332       + p-suffix
      333       .
      334   end.
      335   function cur-time-print  returns character
      336   :
      337     define variable v-date as date      no-undo .
      338     define variable v-time as integer   no-undo .
      339     run cur-time in this-procedure
      340       (output v-date
      341       ,output v-time
      342       ) .
      343     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      344   end.
      345   function cur-time-datetime returns datetime
      346   :
      347     define variable v-char as character no-undo .
      348     define variable v-datetime as datetime no-undo .
      349     v-char = cur-time-string().
      350     v-datetime = datetime(v-char).
      351     return  v-datetime.
      352   end.
      353   function cur-time-string-msec returns character
      354   :
      355     define variable v-date as datetime  no-undo .
      356     v-date = now.
      357     return string(v-date) .
      358   end.
      359   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      360   define shared temp-table ord-list no-undo
      361   field host-code  like ub.ord-doc.host-code
      362   field cli-type   like ub.ord-doc.cli-type
      363   field cli-code   like ub.ord-doc.cli-code
      364   field doc-date   like ub.ord-doc.doc-date
      365   field doc-code   like ub.ord-doc.doc-code
      366   field obj-type   like ub.ord-doc.obj-type
      367   field obj-code   like ub.ord-doc.obj-code
      368   field fact-num   like ub.ord-doc.fact-num
      369   field fact-date  like ub.ord-doc.fact-date
      370   field shift-date like ub.ord-doc.shift-date
      371   field shift-num  like ub.ord-doc.shift-num
      372   field shift-name like ub.ord-doc.shift-name
      373   field ord-int1   like ub.ord-doc.ord-int1
      374   field cli-out-doc like ub.ord-doc.cli-out-doc
      375   field ship-date  like ub.ord-doc.ship-date
      376   field ship-time  like ub.ord-doc.ship-time
      377   field status_    as character
      378   field trn-doc    as character
      379   field fact-order as decimal
      380   field is-trn-doc as logical
      381   field doc-type   like ub.ord-doc.doc-type
      382   field sel-order  as integer
      383   field znak       as integer
      384   field to-del     as logical
      385   field ps         as character
      386   field dm         as integer
      387   field charkey_one as character
      388   index xpk is primary unique doc-code doc-type trn-doc
      389   index xfact fact-num
      390   index xfact-date fact-date
      391   index sel-order sel-order
      392   index znak-order znak sel-order
      393   .
      394   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      395   define new global shared variable g#lib-nws as handle no-undo .
      396   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      397   def var vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      398   procedure gen-key-rec :
      399     define input  parameter p-tbl-name    as character no-undo.
      400     define input  parameter p-bh_tbl-name as handle    no-undo.
      401     define output parameter p-key-rec     as character no-undo.
      402     do
      403     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      404     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      405     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      406     :
      407       define variable fh               as handle    no-undo .
      408       define variable v-ok             as logical   no-undo .
      409       define variable v-inform         as character no-undo .
      410       define variable v-ind            as integer   no-undo .
      411       define variable v-idx-field-qnty as integer   no-undo .
      412       if p-tbl-name = ?
      413         or p-tbl-name = "":U
      414       then do:
      415         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info5 ).
      416       end.
      417       if not p-bh_tbl-name:available then do:
      418         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info5, p-tbl-name ).
      419       end.
      420       assign
      421         p-key-rec = p-tbl-name
      422         v-inform  = p-bh_tbl-name:index-information(1)
      423         v-ind     = 2
      424       .
      425       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      426       on error undo, return error
      427       :
      428         assign
      429           v-inform = p-bh_tbl-name:index-information( v-ind )
      430           v-ind    = v-ind + 1
      431         .
      432       end.
      433       if v-inform = ?
      434         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      435         or entry( 3, v-inform, ",":U ) <> "1":U
      436       then do:
      437         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, p-tbl-name ).
      438       end.
      439       else do:
      440         assign
      441           v-idx-field-qnty = num-entries( v-inform ) - 4
      442         .
      443         if v-idx-field-qnty < 2 then do:
      444           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, p-tbl-name ).
      445         end.
      446         do v-ind = 1 to v-idx-field-qnty by 2
      447         on error undo, return error
      448         :
      449           assign
      450             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      451             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      452           .
      453         end.
      454       end.
      455       if p-key-rec = ? then do:
      456         assign
      457           p-key-rec = "":U
      458         .
      459         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info5, p-tbl-name ).
      460       end.
      461     end.
      462     return.
      463   end procedure.
      464   procedure gen-where-keyr-tab :
      465     define input  parameter i-tableSerach as character no-undo.
      466     define input  parameter i-tablekey   as character  no-undo.
      467     define input  parameter p-key-rec    as character  no-undo.
      468     define input  parameter p-key-handle as handle     no-undo .
      469     define input  parameter p-db-name    as character  no-undo .
      470     define input  parameter p-tt-handle  as handle     no-undo .
      471     define output parameter o-Where      as character  no-undo.
      472     do
      473     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      474     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      475     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      476     :
      477       define variable v-full-tbl-name  as character no-undo .
      478       define variable bh_tbl-name      as handle    no-undo .
      479       define variable fh_key           as handle    no-undo .
      480       define variable fh_search        as handle    no-undo .
      481       define variable v-field-num      as integer   no-undo .
      482       define variable v-count-fld      as integer   no-undo .
      483       define variable v-inform         as character no-undo .
      484       define variable v-ind            as integer   no-undo .
      485       define variable v-idx-field-qnty as integer   no-undo .
      486       define variable v-field-name     as character no-undo .
      487       define variable v-field-val      as character no-undo .
      488       define variable v-word-link      as character no-undo .
      489       define variable vTable           as character no-undo.
      490       define variable bh_tbl-key       as handle    no-undo .
      491       assign
      492         p-key-rec = trim( p-key-rec )
      493       .
      494       if p-key-handle <> ? then do:
      495         if not valid-handle(p-key-handle)
      496            or p-key-handle:type <> "buffer"
      497         then do:
      498           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info5 ).
      499         end.
      500         if num-entries( p-key-rec, chr(3) ) > 1
      501           or p-key-rec = ?
      502           or p-key-rec = "":U
      503         then do:
      504           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info5, p-key-rec ).
      505         end.
      506       end.
      507       else do:
      508         if p-key-rec = ?
      509           or p-key-rec = "":U
      510         then do:
      511           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info5 ).
      512         end.
      513       end.
      514       assign
      515         vTable = entry( 1 , p-key-rec, chr(3) )
      516       .
      517       if p-tt-handle <> ?
      518         and ( not valid-handle(p-tt-handle)
      519               or p-tt-handle:type <> "buffer"
      520             )
      521       then do:
      522         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info5, vTable, chr(10) ).
      523       end.
      524       if p-tt-handle = ? then do:
      525         assign
      526           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      527         .
      528         create buffer bh_tbl-name for table v-full-tbl-name .
      529       end.
      530       else do:
      531         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      532       end.
      533       assign
      534         v-inform = bh_tbl-name:index-information(1)
      535         v-ind    = 2
      536       .
      537       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      538       on error undo, return error
      539       :
      540         assign
      541           v-inform = bh_tbl-name:index-information( v-ind )
      542           v-ind    = v-ind + 1
      543         .
      544       end.
      545       if v-inform = ?
      546         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      547         or entry( 3, v-inform, ",":U ) <> "1":U
      548       then do:
      549         delete object bh_tbl-name no-error.
      550         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info5, vTable ).
      551       end.
      552       assign
      553         v-idx-field-qnty = num-entries( v-inform ) - 4
      554       .
      555       if v-idx-field-qnty < 2 then do:
      556         delete object bh_tbl-name no-error.
      557         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, vTable ).
      558       end.
      559       assign
      560         o-where     = "where":U
      561         v-word-link = "":U
      562         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      563         v-count-fld = 0
      564       .
      565       if i-tablekey ne "" and i-tablekey ne ?
      566       then do:
      567         assign
      568           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      569         .
      570         create buffer bh_tbl-key for table v-full-tbl-name .
      571       end.
      572       if i-tableSerach ne "" and i-tableSerach ne ?
      573       then do:
      574         delete object bh_tbl-name no-error.
      575         assign
      576           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      577         .
      578         create buffer bh_tbl-name for table v-full-tbl-name .
      579       end.
      580       block_where:
      581       do v-ind = 1 to v-idx-field-qnty by 2
      582       on error undo, return error
      583       :
      584         assign
      585           v-count-fld = v-count-fld + 1
      586         .
      587         if p-key-handle = ?
      588           and v-count-fld > v-field-num
      589         then do:
      590           leave block_where.
      591         end.
      592         define variable VfieldKeyTable as handle no-undo.
      593         assign
      594           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      595           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      596         .
      597         if     bh_tbl-key ne ?
      598         then do:
      599            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      600            if VfieldKeyTable eq ?
      601            then next block_where.
      602         end.
      603         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      604         then
      605            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      606         else
      607            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      608         if p-key-handle = ? then do:
      609           assign
      610             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      611           .
      612         end.
      613         else do:
      614           assign
      615             fh_key = p-key-handle:buffer-field( v-field-name )
      616           .
      617           if fh_key = ?
      618             or not valid-handle( fh_key )
      619           then do:
      620             delete object bh_tbl-name.
      621             if     bh_tbl-key ne ?
      622             then
      623                delete object bh_tbl-key.
      624             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info5, p-key-handle:name, v-field-name ).
      625           end.
      626           assign
      627             v-field-val = fh_key:buffer-value
      628           .
      629         end.
      630         if fh_search:data-type ="character":U then do:
      631           assign
      632             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      633             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      634             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      635             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      636             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      637             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      638             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      639             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      640             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      641             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      642             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      643             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      644             v-field-val = substitute( '"&1"', v-field-val )
      645           .
      646         end.
      647         assign
      648           o-where = substitute( "&1 &2", o-where, v-field-val )
      649         .
      650         if v-word-link = "":U then do:
      651           assign
      652             v-word-link = "and":U
      653           .
      654         end.
      655       end.
      656       delete object bh_tbl-name.
      657       if     bh_tbl-key ne ?
      658       then
      659          delete object bh_tbl-key.
      660       if p-key-handle = ?
      661         and v-count-fld <> v-field-num
      662       then do:
      663         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info5, vTable ).
      664       end.
      665     end.
      666   end procedure.
      667   procedure gen-hn-keyr-tab :
      668     define input  parameter i-tableSerach as character no-undo.
      669     define input  parameter i-tablekey   as character no-undo.
      670     define input  parameter p-key-rec    as character no-undo.
      671     define input  parameter p-key-handle as handle    no-undo .
      672     define input  parameter p-db-name    as character no-undo .
      673     define input  parameter p-tt-handle  as handle    no-undo .
      674     define input  parameter p-stts-lock  as integer   no-undo .
      675     define output parameter o-hn         as handle    no-undo.
      676     define variable v-full-tbl-name as character no-undo.
      677     define variable v-where         as character no-undo.
      678     define variable bh_tbl-name     as handle    no-undo.
      679     define variable vTable          as character no-undo.
      680     do
      681     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      682     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      683     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      684         run gen-where-keyr-tab(i-tableSerach,
      685                                i-tablekey,
      686                                p-key-rec,
      687                                p-key-handle,
      688                                p-db-name,
      689                                p-tt-handle,
      690                                output v-where).
      691         if i-tableSerach ne "" and i-tableSerach ne ?
      692         then do:
      693            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      694            create buffer bh_tbl-name for table v-full-tbl-name .
      695         end.
      696         else do:
      697            if p-tt-handle = ? then do:
      698               assign
      699                  vTable = entry( 1 , p-key-rec, chr(3) )
      700               .
      701               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      702               create buffer bh_tbl-name for table v-full-tbl-name .
      703            end.
      704            else do:
      705               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      706            end.
      707         end.
      708         if p-tt-handle = ? then do:
      709            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      710         end.
      711         else do:
      712            bh_tbl-name:find-first( v-where ) no-error .
      713         end.
      714         o-hn = bh_tbl-name.
      715      end.
      716   end procedure.
      717   procedure gen-hn-keyr :
      718     define input  parameter p-key-rec    as character no-undo.
      719     define input  parameter p-key-handle as handle    no-undo .
      720     define input  parameter p-db-name    as character no-undo .
      721     define input  parameter p-tt-handle  as handle    no-undo .
      722     define input  parameter p-stts-lock  as integer   no-undo .
      723     define output parameter o-hn         as handle    no-undo.
      724     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      725   end.
      726   procedure gen-row-keyr :
      727     define input  parameter p-key-rec    as character no-undo.
      728     define input  parameter p-key-handle as handle    no-undo .
      729     define input  parameter p-db-name    as character no-undo .
      730     define input  parameter p-tt-handle  as handle    no-undo .
      731     define input  parameter p-stts-lock  as integer   no-undo .
      732     define output parameter p-tbl-row    as rowid     no-undo.
      733     define output parameter p-tbl-name   as character no-undo.
      734     define variable vHn as handle no-undo.
      735       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      736       p-tbl-row = if vHn:available then vHn:rowid else ?.
      737       p-tbl-name =  vHn:table.
      738       delete object vHn no-error.
      739     if p-tbl-row = ? then do:
      740       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info5, p-tbl-name, p-key-rec ).
      741     end.
      742     else do:
      743       return.
      744     end.
      745   end procedure.
      746   procedure gen-key-fv :
      747     define input  parameter p-key-rec    as character no-undo .
      748     define output parameter p-field-list as character no-undo .
      749     define output parameter p-value-list as character no-undo.
      750     do
      751     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      752     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      753     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      754     :
      755       define variable v-full-tbl-name  as character no-undo .
      756       define variable bh_tbl-name      as handle    no-undo .
      757       define variable v-tbl-name       as character no-undo .
      758       define variable v-field-num      as integer   no-undo .
      759       define variable v-count-fld      as integer   no-undo .
      760       define variable v-inform         as character no-undo .
      761       define variable v-ind            as integer   no-undo .
      762       define variable v-idx-field-qnty as integer   no-undo .
      763       define variable v-delim-key      as character no-undo .
      764       if p-key-rec = ?
      765         or p-key-rec = "":U
      766       then do:
      767         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info5 ).
      768       end.
      769       assign
      770         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      771         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      772       .
      773       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      774       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info5 ).
      775       assign
      776         v-inform = bh_tbl-name:index-information(1)
      777         v-ind    = 2
      778       .
      779       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      780       on error undo, return error
      781       :
      782         assign
      783           v-inform = bh_tbl-name:index-information( v-ind )
      784           v-ind    = v-ind + 1
      785         .
      786       end.
      787       if v-inform = ?
      788         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      789         or entry( 3, v-inform, ",":U ) <> "1":U
      790       then do:
      791         delete object bh_tbl-name no-error.
      792         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, v-tbl-name ).
      793       end.
      794       assign
      795         v-idx-field-qnty = num-entries( v-inform ) - 4
      796       .
      797       if v-idx-field-qnty < 2 then do:
      798         delete object bh_tbl-name no-error.
      799         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, v-tbl-name ).
      800       end.
      801       assign
      802         p-field-list = "":U
      803         p-value-list = "":U
      804         v-delim-key  = "":U
      805         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      806         v-count-fld  = 0
      807       .
      808       block_where:
      809       do v-ind = 1 to v-idx-field-qnty by 2
      810       on error undo, return error
      811       :
      812         assign
      813           v-count-fld = v-count-fld + 1
      814         .
      815         if v-count-fld > v-field-num then do:
      816           leave block_where.
      817         end.
      818         assign
      819           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      820           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      821         .
      822         if v-ind = 1 then do:
      823           assign
      824             v-delim-key = chr(3)
      825           .
      826         end.
      827       end.
      828       delete object bh_tbl-name.
      829       if v-count-fld <> v-field-num then do:
      830         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info5, v-tbl-name ).
      831       end.
      832     end.
      833   end procedure.
      834   procedure gen-key-field :
      835     define input  parameter p-table      as character no-undo .
      836     define output parameter p-field-list as character no-undo .
      837     do
      838     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      839     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      840     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      841     :
      842       define variable v-full-tbl-name  as character no-undo .
      843       define variable bh_tbl-name      as handle    no-undo .
      844       define variable v-tbl-name       as character no-undo .
      845       define variable v-field-num      as integer   no-undo .
      846       define variable v-count-fld      as integer   no-undo .
      847       define variable v-inform         as character no-undo .
      848       define variable v-ind            as integer   no-undo .
      849       define variable v-idx-field-qnty as integer   no-undo .
      850       define variable v-delim-key      as character no-undo .
      851       if p-table = ?
      852         or p-table = "":U
      853       then do:
      854         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info5 ).
      855       end.
      856       assign
      857         v-tbl-name      = p-table
      858         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      859       .
      860       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      861       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info5 ).
      862       assign
      863         v-inform = bh_tbl-name:index-information(1)
      864         v-ind    = 2
      865       .
      866       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      867       on error undo, return error
      868       :
      869         assign
      870           v-inform = bh_tbl-name:index-information( v-ind )
      871           v-ind    = v-ind + 1
      872         .
      873       end.
      874       if v-inform = ?
      875         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      876         or entry( 3, v-inform, ",":U ) <> "1":U
      877       then do:
      878         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, v-tbl-name ).
      879       end.
      880       assign
      881         v-idx-field-qnty = num-entries( v-inform ) - 4
      882       .
      883       if v-idx-field-qnty < 2 then do:
      884         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, v-tbl-name ).
      885       end.
      886       assign
      887         p-field-list = "":U
      888         v-delim-key  = "":U
      889         v-count-fld  = 0
      890       .
      891       block_where:
      892       do v-ind = 1 to v-idx-field-qnty by 2
      893       on error undo, return error
      894       :
      895         assign
      896           v-count-fld = v-count-fld + 1
      897         .
      898         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      899         if v-ind = 1 then do:
      900           assign
      901             v-delim-key = chr(3)
      902           .
      903         end.
      904       end.
      905       delete object bh_tbl-name.
      906     end.
      907   end procedure.
      908   define SHARED temp-table temp-cmd no-undo
      909   field cmd-code as integer
      910   field db-list as character
      911   index pi is unique primary
      912   db-list
      913   index icmd
      914   cmd-code
      915   .
      916   define SHARED temp-table temp-smart-route no-undo
      917   field key-field as character
      918   field db-num as integer
      919   index pi is unique primary
      920   key-field
      921   db-num
      922   .
      923   define SHARED temp-table temp-no-route no-undo
      924   field rec-ord as integer
      925   field db-num as integer
      926   index pi is unique primary
      927   db-num
      928   rec-ord
      929   index iro
      930   rec-ord
      931   .
      932   define SHARED temp-table temp-smart-link no-undo
      933   field uniq-key-rec as character
      934   field key-field as character
      935   field rec-ord as integer
      936   field is-smart as logical
      937   index pi is unique primary
      938   key-field
      939   uniq-key-rec
      940   rec-ord
      941   index iu
      942   uniq-key-rec
      943   index iro
      944   rec-ord
      945   .
      946   define SHARED temp-table temp-nws-outline no-undo
      947   like ub.nws-outline.
      948   procedure create-smart-route :
      949   define input parameter p-key-field as character no-undo .
      950   define input parameter p-db-num as integer no-undo .
      951   define buffer buf_temp-smart-route for temp-smart-route.
      952     do
      953     on error undo, return error
      954     :
      955       find first buf_temp-smart-route where
      956                 buf_temp-smart-route.key-field = p-key-field
      957             and buf_temp-smart-route.db-num = p-db-num no-error.
      958       if not available buf_temp-smart-route then do:
      959         create buf_temp-smart-route.
      960         assign
      961         buf_temp-smart-route.key-field = p-key-field
      962         buf_temp-smart-route.db-num = p-db-num
      963         .
      964       end.
      965     end.
      966   end procedure.
      967   procedure create-smart-route-link :
      968   define input parameter p-tbl-name as character no-undo .
      969   define input parameter p-bh_tbl-name as handle no-undo .
      970   define input parameter p-key-field as character no-undo .
      971   define input parameter p-rec-ord as integer no-undo .
      972   define input parameter p-is-smart as logical no-undo .
      973   define variable v-key-rec as character no-undo .
      974   define buffer buf_temp-smart-link for temp-smart-link.
      975     do
      976     on error undo, return error
      977     :
      978       run gen-key-rec in this-procedure ( input p-tbl-name
      979                                          ,input p-bh_tbl-name
      980                                          ,output v-key-rec     ).
      981      find first buf_temp-smart-link where
      982                 buf_temp-smart-link.uniq-key-rec = v-key-rec
      983              and buf_temp-smart-link.key-field = p-key-field
      984              and buf_temp-smart-link.rec-ord = p-rec-ord
      985              no-error .
      986      if not available buf_temp-smart-link then do:
      987        create buf_temp-smart-link.
      988        assign
      989        buf_temp-smart-link.uniq-key-rec = v-key-rec
      990        buf_temp-smart-link.key-field = p-key-field
      991        buf_temp-smart-link.rec-ord = p-rec-ord
      992        buf_temp-smart-link.is-smart = p-is-smart
      993        .
      994      end.
      995     end.
      996   end procedure.
      997   procedure create-nws-outline :
      998   define input parameter p-cmd-proc-handle as handle no-undo .
      999   define input parameter p-cmd-code as integer no-undo .
     1000   define input parameter p-outline-type as character no-undo .
     1001   define input parameter p-charkey_one as character no-undo .
     1002   define input parameter p-charkey_two as character no-undo .
     1003   define input parameter p-charkey_three as character no-undo .
     1004   define input parameter p-key#_one as integer no-undo .
     1005   define input parameter p-key#_two as integer no-undo .
     1006   define input parameter p-key#_three as integer no-undo .
     1007   define variable v-no-id as integer no-undo .
     1008   define variable v-rec-ord as integer no-undo .
     1009     do
     1010     on error undo, return error return-value
     1011     :
     1012       find last temp-nws-outline use-index pi no-error .
     1013       v-no-id = (if available temp-nws-outline
     1014                  then (temp-nws-outline.no-id  + 1)
     1015                  else 1).
     1016       create temp-nws-outline.
     1017       assign
     1018       temp-nws-outline.charkeY_one = p-charkey_one
     1019       temp-nws-outline.charkeY_two = p-charkey_two
     1020       temp-nws-outline.charkeY_three = p-charkey_three
     1021       temp-nws-outline.key#_one = p-key#_one
     1022       temp-nws-outline.key#_two = p-key#_two
     1023       temp-nws-outline.key#_three = p-key#_three
     1024       temp-nws-outline.no-id = v-no-id
     1025       temp-nws-outline.outline-type = p-outline-type
     1026       .
     1027                                   run add-dump in p-cmd-proc-handle                                                                           (input p-cmd-code                                                                                         ,input 'nws-outline':U                                                                                          ,input '+update'                                                                                         ,input (buffer temp-nws-outline:handle)                                                                                    ,input ''                                                                                         ,output v-rec-ord                                                                                         ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                     delete procedure p-cmd-proc-handle .                                                                        undo , return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'nws-outline':U                                                                                                ,p-cmd-code                                                                                               ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
     1028       run  create-smart-route in this-procedure (
     1029                                                   input ('nws-outline':U + chr(4) + string(temp-nws-outline.no-id))
     1030                                                  ,input -1).
     1031       run create-smart-route-link in this-procedure (
     1032                                                      input 'nws-outline':U
     1033                                                     ,input (buffer temp-nws-outline:handle)
     1034                                                     ,input ('nws-outline':U + chr(4) + string(temp-nws-outline.no-id))
     1035                                                     ,input v-rec-ord
     1036                                                     ,input no
     1037                                                     ).
     1038     end.
     1039   end procedure.
     1040   procedure create-no-route :
     1041   define input parameter p-rec-ord as integer no-undo .
     1042   define input parameter p-db-num as integer no-undo .
     1043   define buffer buf_temp-no-route for temp-no-route.
     1044   do
     1045   on error undo, return error
     1046   :
     1047      find first buf_temp-no-route where
     1048                 buf_temp-no-route.rec-ord = p-rec-ord
     1049              and buf_temp-no-route.db-num = p-db-num no-error .
     1050      if not available buf_temp-no-route then do:
     1051        create buf_temp-no-route.
     1052        assign
     1053        buf_temp-no-route.rec-ord = p-rec-ord
     1054        buf_temp-no-route.db-num = p-db-num
     1055        .
     1056      end.
     1057   end.
     1058   end procedure.
     1059   procedure clear-from-rec-ord :
     1060   define input parameter p-rec-ord as integer no-undo .
     1061   define buffer buf_temp-no-route for temp-no-route.
     1062   define buffer buf_temp-smart-link for temp-smart-link.
     1063   do
     1064   on error undo, return error
     1065   :
     1066   for each buf_temp-no-route where
     1067           buf_temp-no-route.rec-ord > p-rec-ord:
     1068     delete buf_temp-no-route.
     1069   end.
     1070   for each buf_temp-smart-link where
     1071           buf_temp-smart-link.rec-ord > p-rec-ord:
     1072      delete buf_temp-smart-link.
     1073   end.
     1074   end.
     1075   end procedure.
