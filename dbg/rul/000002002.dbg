     3132                           .
     3133                       end.
     3134                       when chr(13)
     3135                       then do:
     3136                           assign
     3137                               p-out-string = p-out-string + "&#13;":U
     3138                           .
     3139                       end.
     3140                       otherwise do:
     3141                           assign
