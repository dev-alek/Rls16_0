     3051                       then do:
     3052                           assign
     3053                               p-out-string = p-out-string + "&lt;":U
     3054                           .
     3055                       end.
     3056                       when "'":U
     3057                       then do:
     3058                           assign
     3059                               p-out-string = p-out-string + "&apos;":U
     3060                           .
     3061                       end.
     3062                       when '"':U
     3063                       then do:
     3064                           assign
     3065                               p-out-string = p-out-string + "&quot;":U
     3066                           .
     3067                       end.
     3068                       when chr(1)
     3069                       then do:
     3070                           assign
     3071                               p-out-string = p-out-string + "":U
     3072                           .
     3073                       end.
     3074                       when chr(2)
     3075                       then do:
     3076                           assign
     3077                               p-out-string = p-out-string + "":U
     3078                           .
     3079                       end.
     3080                       when chr(3)
     3081                       then do:
     3082                           assign
     3083                               p-out-string = p-out-string + "":U
     3084                           .
     3085                       end.
     3086                       when chr(4)
     3087                       then do:
     3088                           assign
     3089                               p-out-string = p-out-string + "":U
     3090                           .
     3091                       end.
     3092                       when chr(5)
     3093                       then do:
     3094                           assign
     3095                               p-out-string = p-out-string + "":U
     3096                           .
     3097                       end.
     3098                       when chr(6)
     3099                       then do:
     3100                           assign
     3101                               p-out-string = p-out-string + "":U
     3102                           .
     3103                       end.
     3104                       when chr(7)
     3105                       then do:
     3106                           assign
     3107                               p-out-string = p-out-string + "":U
     3108                           .
     3109                       end.
     3110                       when chr(8)
     3111                       then do:
     3112                           assign
     3113                               p-out-string = p-out-string + "":U
     3114                           .
     3115                       end.
     3116                       when chr(9)
     3117                       then do:
     3118                           assign
     3119                               p-out-string = p-out-string + "":U
     3120                           .
     3121                       end.
     3122                       when chr(29)
     3123                       then do:
     3124                           assign
     3125                               p-out-string = p-out-string + "":U
     3126                           .
     3127                       end.
     3128                       when chr(10)
