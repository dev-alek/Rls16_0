     5484   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5485   function context_get-thobj-es return logical
     5486   (
     5487      input p-esys-id as integer
     5488     ,input p-eobj-type as character
     5489     ,input p-eobj-code as integer
     5490     ,output p-obj-type as character
     5491     ,output p-obj-code as integer
     5492   ):
     5493      define variable v-value-list as character no-undo .
     5494      define variable v-field-list as character no-undo .
     5495      define buffer buf_clients for ub.clients.
     5496      define buffer buf_ext-classif for ub.ext-classif.
     5497      find first buf_ext-classif no-lock where
     5498                buf_ext-classif.classif-name = 'clients-esys':U
     5499            and buf_ext-classif.classif-subject = 'clients':U
     5500            and buf_ext-classif.db-num = 0
     5501            and buf_Ext-classif.key#_one = p-esys-id
     5502            and buf_Ext-classif.charkey_one = p-eobj-type
     5503            and buf_Ext-classif.key#_two = p-eobj-code no-error .
     5504      if available buf_Ext-classif
     5505      then do:
     5506         ObjSrv:Lib:KeyRec:GenKeyFv (
     5507                                         input buf_Ext-classif.uniq-key-rec
     5508                                         ,output v-field-list
     5509                                         ,output v-value-list).
     5510         assign
     5511            p-obj-type = entry(lookup("obj-type":U
     5512                                     , v-field-list
     5513                                     , chr(3))
     5514                                     , v-value-list, chr(3))
     5515            p-obj-code = integer(entry(lookup("obj-code":U
     5516                                            , v-field-list
     5517                                            , chr(3))
     5518                                      , v-value-list
     5519                                      , chr(3)))
     5520         no-error .
     5521      end.
     5522      if     available buf_ext-classif
     5523         and (p-obj-type = 'маг':U
     5524              or
     5525              p-obj-type = 'скл':U
     5526              )
     5527         and (p-obj-code > 0 and p-obj-code <= 99999)
     5528      then do:
     5529         find first buf_clients no-lock where
     5530                    buf_clients.obj-type = p-obj-type
     5531                and buf_clients.obj-code = p-obj-code no-error.
     5532         if available buf_clients then do:
     5533            return yes.
     5534         end.
     5535         else do:
     5536            assign
     5537               p-obj-type = '':U
     5538               p-obj-code = 0
     5539            .
     5540            return no.
     5541         end.
     5542      end.
     5543      else do:
     5544         assign
     5545            p-obj-type = '':U
     5546            p-obj-code = 0
     5547         .
     5548         return no.
     5549      end.
     5550   end.
     5551   on delete of this-procedure do:
     5552     run delete-procedure in this-procedure .
     5553     run gate-clear in this-procedure ( input v_dataseth, input v-xmlh) no-error .
     5554   end.
     5555   run load-ruleset-context in this-procedure ( input p-ruleset-id) no-error .
     5556   if error-status:error
     5557   or return-value = "return" then return.
     5558    define variable ImpData1 as class Route-data_ no-undo .
     5559   ImpData1 = new Route-data_( input parparentproc, input p-parent-handle, input p-log-handle, input this-procedure:handle, input v_dataseth, input v-xmlh) .
     5560   if not this-procedure:persistent then do:
     5561     run proc-main in this-procedure  no-error .
     5562     if error-status:error then do:
     5563       v-esm = error-status :get-message (1).
     5564       v-es = error-status:error .
     5565       v-rv = return-value .
     5566     end.
     5567   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5568   if v-view-log
     5569   and not g#news
     5570   and not g#auto
     5571   then do:
     5572     message
     5573     '!!!При импорте произошли ошибки!!!'  skip
     5574     "!!!Внимательно прочитайте Log-file!!"
     5575     view-as alert-box error .
     5576        define variable v-user-action36   as character no-undo .
     5577     define variable v-printed36       as logical   no-undo .
     5578     run gbl/prnfilen.w
     5579       (input  ('!!!При импорте произошли ошибки!!!')
     5580       ,input  0
     5581       ,input  (string("./":U) + log-file-name)
     5582       ,input  7
     5583       ,output v-user-action36
     5584       ,output v-printed36
     5585       ) .
     5586   end.
     5587   if v-view-log = true
     5588   and (g#news
     5589   or g#auto)
     5590   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
     5591   then do:
     5592      run cb_set-view-log in p-parent-handle ( input yes).
     5593   end.
     5594     if v-es then do:
     5595         run delete-procedure in this-procedure .
     5596         undo, return error substitute( "&1. &2&3&4", vss-workfile, v-rv, chr(10), v-esm).
     5597     end.
     5598     run delete-procedure in this-procedure .
     5599   end.
     5600   procedure proc-main :
     5601   define variable v-ii as integer   no-undo .
     5602   define variable v-trn-doc as character no-undo .
     5603   define variable v-ext-obj-code as integer   no-undo .
     5604   define variable v-ship-date as date no-undo .
     5605   define variable v-status_ as character no-undo .
     5606   define variable v-desstatus as character no-undo .
     5607   define variable v-artic as character no-undo .
     5608   define variable v-cli-art as character no-undo .
     5609   define variable v-price as decimal no-undo .
     5610   define variable v-qnty as decimal no-undo .
     5611   define variable v-line-status_ as integer no-undo .
     5612   define variable v-nameth as character no-undo .
     5613   define variable v-hdesstatus as character no-undo .
     5614   define variable v-loc-file-name as character no-undo .
     5615   define variable v-custom-pack-name as character no-undo .
     5616   define variable v-success as logical   no-undo .
     5617   define variable v-pack-num as integer   no-undo .
     5618   define variable v-heap-dir as character no-undo .
     5619   define variable v-temp-dir as character no-undo .
     5620   define variable v-log-file-name as character no-undo .
     5621   define variable v-list-file-name as character no-undo .
     5622   define variable v-custom-pack-flag as logical   no-undo .
     5623   define variable v-short-file-name as character no-undo .
     5624   define variable v-filetype as character no-undo .
     5625   define variable v-extension as character no-undo .
     5626   define variable v-type as character no-undo .
     5627   define variable v-parameter as character no-undo .
     5628   define variable v-cli-uniq-key-rec as character no-undo .
     5629   define variable v-code39 as character no-undo .
     5630   define buffer buf_ext-system for ub.ext-system.
     5631   define buffer buf_ord-doc for ub.ord-doc.
     5632   define buffer buf_ord-line for ub.ord-line.
     5633   define buffer buf_temp-filelist for temp-filelist.
     5634   define buffer buf_esys-pck-rcvd for ub.esys-pck-rcvd.
     5635   define buffer buf_clients for ub.clients.
     5636   define buffer esys_ext-classif for ub.ext-classif.
     5637   _main:
     5638   do
     5639   on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     5640   on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
     5641   on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
     5642   :
     5643     run write-log  in p-log-handle (
     5644                                     input 0
     5645                                   , "&DLine").
     5646       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute(".............Импорт данных по заказам из XML-файлов")).
     5647     for each temp-esys:
     5648       delete temp-esys.
     5649     end.
     5650       for each buf_ext-system no-lock where
     5651                 buf_ext-system.esys-have-import
     5652             and buf_ext-system.esys-db-num-imp = g#db-num
     5653             and buf_ext-system.db-num = 0
     5654             and buf_ext-system.esys-type = integer('5':U):
     5655         create temp-esys.
     5656         assign
     5657         temp-esys.esys-id = buf_ext-system.esys-id
     5658         temp-esys.db-num  = buf_ext-system.db-num
     5659         temp-esys.esys-name  = buf_ext-system.esys-name
     5660         temp-esys.delivery-method  = buf_ext-system.delivery-method
     5661         temp-esys.rowid_  = rowid(buf_ext-system)
     5662         .
     5663       run ext-system-attr-value in this-procedure ( input buf_ext-system.esys-id
     5664                                                     ,input buf_ext-system.db-num
     5665                                                     ,input 'FTP':U
     5666                                                     ,output temp-esys.ftp-ip
     5667                                                     ,output v-type) no-error.
     5668       run ext-system-attr-value in this-procedure ( input buf_ext-system.esys-id
     5669                                                     ,input buf_ext-system.db-num
     5670                                                     ,input 'Login':U
     5671                                                     ,output temp-esys.ftp-login
     5672                                                     ,output v-type) no-error.
     5673       run ext-system-attr-value in this-procedure ( input buf_ext-system.esys-id
     5674                                                     ,input buf_ext-system.db-num
     5675                                                     ,input 'Password':U
     5676                                                     ,output temp-esys.ftp-password
     5677                                                     ,output v-type) no-error.
     5678       run ext-system-attr-value in this-procedure ( input buf_ext-system.esys-id
     5679                                                     ,input buf_ext-system.db-num
     5680                                                     ,input 'Path':U
     5681                                                     ,output temp-esys.ftp-path
     5682                                                     ,output v-type) no-error.
     5683         release temp-esys.
     5684       end.
     5685     _esys:
     5686     for each temp-esys:
     5687       if temp-esys.delivery-method = integer('1':U) then do:
     5688         v-pack-num = 0.
     5689       end.
     5690       else do:
     5691         v-pack-num = -1.
     5692       end.
     5693         v-custom-pack-name = ''.
     5694       run bge/espcknum.p (
     5695                      input (if temp-esys.delivery-method = integer('1':U)
     5696                             then "fget":U
     5697                             else "get":U)
     5698                       ,input temp-esys.esys-id
     5699                       ,input temp-esys.db-num
     5700                     ,input temp-esys.delivery-method
     5701                       ,input v-oxml-exch-dir
     5702                       ,input v-oxml-heap-dir
     5703                       ,input ""
     5704                       ,input-output v-pack-num
     5705                       ,input-output v-custom-pack-name
     5706                       ,output v-loc-file-name
     5707                       ,output v-exchange-dir
     5708                       ,output v-heap-dir
     5709                       ,output v-temp-dir
     5710                       ,output v-log-file-name
     5711                       ,output v-list-file-name
     5712                       ,output v-custom-pack-flag
     5713                     ) no-error.
     5714         if error-status:error then do:
     5715         end.
     5716       if temp-esys.delivery-method <> integer('1':U) then do:
     5717         v-loc-file-name  = v-loc-file-name + "xml".
     5718       end.
     5719       if temp-esys.delivery-method = integer('2':U)
     5720       or temp-esys.delivery-method = integer('1':U)
     5721       then do:
     5722         assign
     5723         v-parameter = temp-esys.ftp-ip + chr(4) +
     5724                       temp-esys.ftp-login + chr(4) +
     5725                       temp-esys.ftp-password + chr(4) +
     5726                       string(0) + chr(4) +
     5727                       (if temp-esys.ftp-path <> ''
     5728                       then (trim (trim (trim(temp-esys.ftp-path
     5729                                       , chr(92))
     5730                                   ,chr(47))
     5731                             ,chr(92)) + chr(47))
     5732                       else '') +
     5733                       "in" + chr(4) +
     5734                       "ftp-fl_CreateFileList" + chr(4) +
     5735                       "process-edoc.txt"
     5736         .
     5737         for each buf_temp-filelist :
     5738           delete buf_temp-filelist.
     5739         end.
     5740         run gbl/ftp-ls.p ( input parparentproc
     5741                           ,input this-procedure:handle
     5742                           ,input p-log-handle
     5743                           ,input v-parameter ) no-error.
     5744         if error-status:error then do:
     5745                   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при чтении списка файлов на FTP &1", temp-esys.ftp-ip)).
     5746           assign v-view-log = yes.
     5747           next _esys.
     5748         end.
     5749         if not can-find (first buf_temp-filelist) then do:
     5750                   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Нет новых файлов на FTP &1", temp-esys.ftp-ip)).
     5751         end.
     5752         else do:
     5753           assign
     5754           v-parameter = temp-esys.ftp-ip + chr(4) +
     5755                         temp-esys.ftp-login + chr(4) +
     5756                         temp-esys.ftp-password + chr(4) +
     5757                         string(0) + chr(4) +
     5758                         '' + chr(4) +
     5759                         '' + chr(4) +
     5760                         string(yes) + chr(4) +
     5761                         "cb_getnextfilename" + chr(4) +
     5762                         "process-edoc.txt"
     5763           .
     5764           run gbl/ftp-get.p ( input parparentproc
     5765                             ,input this-procedure:handle
     5766                             ,input p-log-handle
     5767                             ,input v-parameter ) no-error.
     5768           if error-status:error then do:
     5769           end.
     5770         end.
     5771       end.
     5772           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Просматриваем директорию обмена &1 ... ", v-exchange-dir)).
     5773       if temp-esys.delivery-method = integer('1':U) then do:
     5774         input stream instream from os-dir ( v-exchange-dir ) .
     5775       end.
     5776       _repeat:
     5777       repeat
     5778       on error undo, return error
     5779       :
     5780         if temp-esys.delivery-method = integer('1':U) then do:
     5781           import stream Instream v-short-file-name file-name v-filetype.
     5782           if not (v-filetype begins "F"
     5783           and num-entries( v-short-file-name, "." ) > 1)
     5784           then do:
     5785           next _repeat.
     5786         end.
     5787         assign
     5788         v-extension = ''
     5789         v-extension = entry(num-entries(v-short-file-name, "."), v-short-file-name, ".")
     5790         no-error
     5791         .
     5792         if v-extension = ''
     5793           or lookup(v-extension, "stk-ok,rpl,pst,acc-ok") = 0
     5794           then do:
