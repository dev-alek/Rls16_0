     4253                                                       , p-cmd-code
     4254                                                       , chr(10)
     4255                                                       , error-status:get-message(1)
     4256                                                       , return-value
     4257                                                       )).
     4258         return no .
     4259      end.
     4260   end.
     4261   on delete of this-procedure do:
     4262     run garbcoll_clear in this-procedure .
     4263   end.
     4264   run load-ruleset-context in this-procedure ( input p-ruleset-id) no-error.
     4265   if error-status:error then do:
     4266     undo, return error return-value .
     4267   end.
     4268   if return-value = "return" then return ''.
     4269   define variable ExpData1 as class Route-data_ no-undo .
     4270   ExpData1 = new Route-data_( input parparentproc, input p-parent-handle, input p-log-handle, input this-procedure:handle) .
     4271   if not this-procedure:persistent then do:
     4272     run proc-main in this-procedure no-error .
     4273     if error-status:error then do:
     4274       v-esm = error-status :get-message (1).
     4275       v-es = error-status:error .
     4276       v-rv = return-value .
     4277     end.
     4278     if v-es then do:
     4279         run garbcoll_clear in this-procedure .
     4280               if valid-handle(p-log-handle) then           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))).
     4281         undo, return error substitute( "&1. &2&3&4", vss-workfile, v-rv, chr(10), v-esm).
     4282     end.
     4283     run garbcoll_clear in this-procedure .
     4284   end.
     4285   procedure proc-main :
     4286   define variable v-ii as integer no-undo .
     4287   define variable v-uniq-key-rec as character no-undo .
     4288   define variable v-cli-uniq-key-rec as character no-undo .
     4289   define variable v-err as logical no-undo .
     4290   define variable v-custom-pack-name as character no-undo .
     4291   define variable v-success as logical   no-undo .
     4292   DEFINE VARIABLE v-date as date no-undo .
     4293   DEFINE VARIABLE v-time as integer no-undo .
     4294   define variable v-ord-int1 as integer no-undo .
     4295   define variable v-obj-gln as character no-undo .
     4296   define variable v-cli-gln as character no-undo .
     4297   define variable v-frm-gln as character no-undo .
     4298   define variable v-transport-gln as character no-undo .
     4299   define variable v-mess as character no-undo .
     4300   define variable v-b-code as integer no-undo .
     4301   define variable v-b-str as character no-undo .
     4302   define variable l-prod-bc-weight as logical no-undo .
     4303   define variable l-prod-bc-pgweight as logical no-undo .
     4304   define variable l-is-petrol-code as logical no-undo .
     4305   define variable l-is-scaleable as logical no-undo .
     4306   define variable v-jj as integer   no-undo .
     4307   define variable v-cli-base-rate as decimal no-undo .
     4308   define variable v-dump-ord-int64 as int64 no-undo .
     4309   define variable v-cli-type as character no-undo .
     4310   define variable v-cli-code as integer   no-undo .
     4311   define variable v-EDIINTERCHANGEID as character no-undo .
     4312   define variable v-edist-mess as character no-undo .
     4313   define variable v-deliverynotenumber as character no-undo .
     4314   define variable v-deliverynotedate as date no-undo .
     4315   define variable v-deliverynotedate-chr as character no-undo .
     4316   define variable v-attr-type as character no-undo .
     4317   define variable v-date-status as date no-undo .
     4318   define variable v-time-status as integer no-undo .
     4319   define variable v-date-chr as character no-undo .
     4320   define buffer buf_ext-system for ub.ext-system.
     4321   define buffer buf_ord-line for ub.ord-line.
     4322   define buffer buf_object for ub.clients.
     4323   define buffer buf_clients for ub.clients.
     4324   define buffer buf_ext-classif for ub.ext-classif.
     4325   define buffer esys_ext-classif for ub.ext-classif.
     4326   define buffer buf_goods for ub.goods.
     4327   define buffer buf_currency for ub.currency.
     4328   define buffer buf_doc-line for ub.doc-line.
     4329   _main:
     4330   do
     4331   on error undo _main, return error substitute( "&1&2&3&2&4", return-value, chr(10), error-status :get-message (1), v-last-error-message)
     4332   on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
     4333   on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
     4334   :
     4335    dataset recadv_-t:handle:empty-dataset() .
     4336    if retry then do:
     4337           if valid-handle(p-log-handle) then           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при обработке накладной &1&2:&3&4"                                    ,v-current-doc-code                                    , chr(10), v-mess)).
     4338       undo _main, return error.
     4339     end.
     4340     else do:
     4341       if v-has-newbh then do:
     4342         v-current-obj-type = v-newbh::obj-type.
     4343         v-current-obj-code = v-newbh::obj-code.
     4344         v-cli-type = v-newbh::cli-type.
     4345         v-cli-code = v-newbh::cli-code.
     4346         v-current-host-code = v-newbh::host-code.
     4347       end.
     4348       assign
     4349       v-mess = ''
     4350       .
     4351       IF  ExpData1:route-data_read-xmlschema( INPUT p-xsd-file) = false  THEN do:
     4352         undo _main, return error v-last-error-message .
     4353       end.
     4354       find first buf_clients no-lock where
     4355                 buf_clients.obj-type = v-cli-type
     4356             and buf_clients.obj-code = v-cli-code no-error.
     4357       if not available buf_clients then do:
     4358         v-mess =  substitute("Не найден контрагент &1&2", v-cli-type, v-cli-code).
     4359         v-err = yes.
     4360         undo _main, retry _main.
     4361       end.
     4362       if buf_ord-doc.doc-type = 'ОП':U
     4363       and (buf_ord-doc.status_  = 'поставка':U OR buf_ord-doc.status_ = 'факт':U)
     4364       and (buf_ord-doc.ord-int1 = integer('7':U)
     4365       or buf_ord-doc.ord-int1 = integer('8':U)
     4366       or buf_ord-doc.ord-int1 = integer('9':U)
     4367       or buf_ord-doc.ord-int1 = integer('11':U)
     4368       )
     4369       and buf_ord-doc.whole-send-news = integer('2':U)
     4370       then do:
     4371         assign
     4372         v-ord-int1 = integer('9':U).
     4373       end.
     4374       else do:
     4375         return "return".
     4376       end.
     4377       run gen-key-rec in this-procedure ( input 'clients':U
     4378                                         ,input (buffer buf_clients:handle)
     4379                                         ,output v-cli-uniq-key-rec) no-error .
     4380       if error-status:error then do:
     4381         v-mess = substitute("gen-key-rec: &1&2&3&2(&4&5)"
     4382                                   , error-status:get-message(1)
     4383                                   , return-value
     4384                                   , chr(10)
     4385                                   , v-cli-type
     4386                                   , v-cli-code).
     4387         v-err = yes.
     4388         undo _main, retry _main.
     4389       end.
     4390       find first esys_ext-classif no-lock where
     4391           esys_ext-classif.classif-name = 'exite-edi':U
     4392       and esys_ext-classif.classif-subject = 'clients':U
     4393       and esys_ext-classif.db-num = -1
     4394       and esys_Ext-classif.uniq-key-rec = v-cli-uniq-key-rec no-error .
     4395       if not available esys_ext-classif then do:
     4396         v-mess = substitute("Поставщик &1&2 заказа НЕ РАБОТАЕТ ПО СИСТЕМЕ EDI", v-cli-type, v-cli-code).
     4397         v-err = yes.
     4398         undo _main, retry _main.
     4399       end.
     4400       find first buf_object no-lock where
     4401                 buf_object.obj-type = v-current-obj-type
     4402             and buf_object.obj-code = v-current-obj-code no-error.
     4403       if not available buf_object then do:
     4404         v-mess =  substitute("Не найден объект &1&2", v-current-obj-type, v-current-obj-code).
     4405         v-err = yes.
     4406         undo _main, retry _main.
     4407       end.
     4408       if buf_object.db-num <> g#db-num then do:
     4409         v-mess = substitute("Объект &1&2 принадлежит другой БД", v-current-obj-type, v-current-obj-code).
     4410         v-err = yes.
     4411         undo _main, retry _main.
     4412       end.
     4413       run gen-key-rec in this-procedure ( input 'clients':U
     4414                                         ,input (buffer buf_object:handle)
     4415                                         ,output v-uniq-key-rec) no-error .
     4416       if error-status:error then do:
     4417         v-mess =  substitute("gen-key-rec: &1&2&3&2(&4&5)"
     4418                                   , error-status:get-message(1)
     4419                                   , return-value
     4420                                   , chr(10)
     4421                                   , buf_object.obj-type
     4422                                   , buf_object.obj-code).
     4423         v-err = yes.
     4424         undo _main, retry _main.
     4425       end.
     4426       assign
     4427       v-obj-gln = get-gln( input buf_object.obj-type
     4428                       ,input buf_object.obj-code) no-error.
     4429       if error-status:error
     4430       or v-obj-gln = chr(63)
     4431       or v-obj-gln = '' then do:
     4432         v-mess =  substitute("Не определен GLN для &1&2"
     4433                                   , buf_object.obj-type
     4434                                   , buf_object.obj-code) .
     4435         v-err = yes.
     4436         undo _main, retry _main.
     4437       end.
     4438       v-cli-gln = get-gln( input v-cli-type
     4439                           ,input v-cli-code) no-error.
     4440       if error-status:error
     4441       or v-cli-gln = chr(63)
     4442       or v-cli-gln = '' then do:
     4443         v-mess =  substitute("Не определен GLN для &1&2"
     4444                                   , buf_object.obj-type
     4445                                   , buf_object.obj-code) .
     4446         v-err = yes.
     4447         undo _main, retry _main.
     4448       end.
     4449       assign
     4450       v-frm-gln = get-gln( input 'орг':U
     4451                           ,input v-current-host-code) no-error.
     4452       if error-status:error
     4453       or v-frm-gln = chr(63)
     4454       or v-frm-gln = '' then do:
     4455         v-mess =  substitute("Не определен GLN для &1&2"
     4456                                   , 'орг':U
     4457                                   , v-current-host-code) .
     4458         v-err = yes.
     4459         undo _main, retry _main.
     4460       end.
     4461       assign
     4462       v-transport-gln = get-gln( input buf_ord-doc-rcv.transport-cli-type
     4463                                 ,input buf_ord-doc-rcv.transport-cli-code) no-error.
     4464       for each esys_ext-classif no-lock where
     4465           esys_ext-classif.classif-name = 'exite-edi':U
     4466       and esys_ext-classif.classif-subject = 'clients':U
     4467       and esys_ext-classif.db-num = -1
     4468       and esys_Ext-classif.uniq-key-rec = v-cli-uniq-key-rec,
     4469         first buf_ext-system no-lock where
     4470                   buf_ext-system.esys-id = esys_ext-classif.key#_one
     4471               and buf_ext-system.db-num = 0
     4472               and buf_ext-system.esys-have-export = yes,
     4473         first buf_ext-classif no-lock where
     4474           buf_ext-classif.classif-name = 'exite-edi':U
     4475       and buf_ext-classif.classif-subject = 'clients':U
     4476       and buf_ext-classif.db-num = -1
     4477       and buf_Ext-classif.uniq-key-rec = v-uniq-key-rec
     4478       and buf_Ext-classif.key#_one = esys_ext-classif.key#_one:
     4479         leave.
     4480       end.
     4481       if not available buf_ext-system then do:
     4482         v-mess = substitute("Для поставщика &1&2 не найдена ВС, у которой есть экспорт в текущей БД").
     4483         v-err = yes.
     4484         undo _main, retry _main.
     4485       end.
     4486       IF  context_begin-esys-command( input string(buf_ext-system.esys-id), input-output v-esys-cmd-proc-handle, output v-esys-cmd-code) = false  THEN do:
     4487         undo _main, return error v-last-error-message .
     4488       end.
     4489       v-custom-pack-name = substitute("RECADV_&1_&&pack-num.xml"
     4490                                     ,v-obj-gln).
     4491   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input v-current-doc-code ,
     4492                           input 'nids':U ,
     4493                          output v-DELIVERYNOTENUMBER ,
     4494                          output v-attr-type ) no-error .
     4495   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input v-current-doc-code ,
     4496                           input 'dids':U ,
     4497                          output v-DELIVERYNOTEDATE-chr ,
     4498                          output v-attr-type ) no-error .
     4499       if not error-status:error then do:
     4500         v-DELIVERYNOTEDATE = date(v-DELIVERYNOTEDATE-chr).
     4501       end.
     4502       if num-entries(buf_ord-doc.cli-out-doc, chr(4)) > 1 then do:
     4503         assign
     4504         v-date-chr = entry(2, buf_ord-doc.cli-out-doc, chr(4))
     4505         v-date = date (integer(entry(2, v-date-chr, "-"))
     4506                        ,integer(entry(3, v-date-chr, "-"))
     4507                        ,integer(entry(1, v-date-chr, "-"))
     4508                        ) no-error.
     4509         if error-status:error then do:
     4510           run cur-time in this-procedure ( output v-date, output v-time).
     4511         end.
     4512       end.
     4513       else do:
     4514         run cur-time in this-procedure ( output v-date, output v-time).
     4515       end.
     4516       create recadv-t.
     4517       assign
     4518       recadv-t.NUMBER              = v-current-doc-code
     4519       recadv-t.DATE                = v-doc-date
     4520       recadv-t.RECEPTIONDATE       = v-fact-date
     4521       recadv-t.ORDERNUMBER         = buf_ord-doc.doc-code
     4522       recadv-t.ORDERDATE           = buf_ord-doc.doc-date
     4523       recadv-t.DESADVNUMBER        = entry(1, buf_ord-doc-rcv.sub-par, chr(4))
     4524       recadv-t.DESADVDATE          = buf_ord-doc-rcv.doc-date
     4525       recadv-t.DELIVERYNOTENUMBER  = v-DELIVERYNOTENUMBER
     4526       recadv-t.DELIVERYNOTEDATE    = v-DELIVERYNOTEdate
     4527       recadv-t.CAMPAIGNNUMBER      = ''
     4528       recadv-t.SUPPLIERORDERNUMBER = entry(1, buf_ord-doc.cli-out-doc, chr(4))
     4529       recadv-t.SUPPLIERORDERDATE   = v-date
     4530       recadv-t.INFO                = v-ps
     4531       .
     4532       ExpData1:route-data_create-record( INPUT "recadv") .
     4533       ExpData1:route-data_copy-record( INPUT "recadv", INPUT  (buffer recadv-t:handle) ) .
     4534       IF ExpData1:esys-add-dump( INPUT "recadv", INPUT v-esys-cmd-proc-handle, INPUT v-esys-cmd-code, '+update') = false  THEN do:
     4535         undo _main, return error v-last-error-message .
     4536       end.
     4537       create head-t.
     4538       assign
     4539       head-t.NUMBER           = v-current-doc-code
     4540       head-t.SUPPLIER         = v-cli-gln
     4541       head-t.BUYER            = v-frm-gln
     4542       head-t.DELIVERYPLACE    = v-obj-gln
     4543       head-t.FINALRECIPIENT   = v-obj-gln
     4544       head-t.LOGISTICPARTNER  = v-transport-gln
     4545       head-t.SENDER           = v-obj-gln
     4546       head-t.RECIPIENT        = v-cli-gln
     4547       head-t.EDIINTERCHANGEID = ""
     4548       head-t.EDIMESSAGE       = "RECADV"
     4549       .
     4550       ExpData1:route-data_create-record( INPUT "head") .
     4551       ExpData1:route-data_copy-record( INPUT "head", INPUT  (buffer head-t:handle) ) .
     4552       IF ExpData1:esys-add-dump( INPUT "head", INPUT v-esys-cmd-proc-handle, INPUT v-esys-cmd-code, '+update') = false  THEN do:
     4553         undo _main, return error v-last-error-message .
     4554       end.
     4555       for each buf_doc-line no-lock where
     4556                 buf_doc-line.doc-code = v-current-doc-code
     4557       on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4558       on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
     4559       on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
     4560       :
     4561         find first buf_ord-line no-lock where
     4562                   buf_ord-line.doc-code = buf_ord-doc.doc-code
     4563               and buf_ord-line.artic     = buf_doc-line.artic
     4564               and buf_ord-line.prod-type = buf_doc-line.prod-type
     4565               and buf_ord-line.prod-code = buf_doc-line.prod-code no-error.
     4566         if not available buf_ord-line then do:
     4567           undo _main, return error substitute("Не найден строка заказа с товаром &1 &273"
     4568                                               , buf_doc-line.artic
     4569                                               , buf_doc-line.prod-type
     4570                                               , buf_doc-line.prod-code
     4571                                               ).
     4572         end.
     4573         find first buf_goods no-lock where
     4574                   buf_goods.gds-code = buf_ord-line.gds-code no-error.
     4575         if not available buf_goods then do:
     4576           undo _main, return error substitute("Не найден товар с кодом &1", buf_ord-line.gds-code).
     4577         end.
     4578         find first position-t where
     4579                   position-t.number = buf_ord-doc.doc-code
     4580               and position-t.productidsupplier = buf_ord-line.cli-art no-error .
     4581         if available position-t then do:
     4582           v-mess =  substitute("В заказе две строки с одинаковым артикулом поставщика &1"
     4583                                       , v-current-doc-code
     4584                                       , buf_ord-line.cli-art
     4585                                       ).
     4586           IF  context_delete-command( input v-esys-cmd-proc-handle, input v-esys-cmd-code) = false  THEN do:
     4587             undo _main, return error v-last-error-message .
     4588           end.
     4589                   ExpData1:Route-data_clear-data ( ) .
     4590           undo _main, retry  _main.
     4591         end.
     4592         else do:
     4593           RUN ordlineattr-value  IN THIS-PROCEDURE ( input  buf_ord-line.doc-code
     4594                                                     ,input  buf_ord-line.gds-code
     4595                                                     ,input  'ord-EAN13':U
     4596                                                     ,output v-b-str
     4597                                                     ,output v-type
     4598                                                     ) NO-ERROR.
     4599           create position-t.
     4600           assign
     4601           position-t.NUMBER            = v-current-doc-code
     4602           position-t.POSITIONNUMBER    = buf_ord-line.line-num
     4603           position-t.PRODUCT           = v-b-str
     4604           position-t.PRODUCTIDSUPPLIER = buf_ord-line.cli-art
     4605           position-t.PRODUCTIDBUYER    = string(buf_ord-line.gds-code)
     4606           position-t.ACCEPTEDQUANTITY  = buf_doc-line.fact-qnty / buf_ord-line.cli-base-rate
     4607           position-t.ACCEPTEDUNIT      = buf_ord-line.unit-cli
     4608           position-t.DELIVERQUANTITY   = buf_doc-line.doc-qnty  / buf_ord-line.cli-base-rate
     4609           position-t.DELIVERUNIT       = buf_ord-line.unit-cli
     4610           position-t.ORDERQUANTITY     = buf_ord-line.order-cli-qnty
     4611           position-t.ORDERUNIT         = buf_ord-line.unit-cli
     4612           position-t.PRICE             = (buf_doc-line.price-cli / buf_doc-line.cli-base-rate )
     4613                                          * buf_ord-line.cli-base-rate
     4614          .
     4615           ExpData1:route-data_create-record( INPUT "position") .
     4616           ExpData1:route-data_copy-record( INPUT "position", INPUT  (buffer position-t:handle) ) .
     4617           IF  ExpData1:esys-add-dump( INPUT "position", INPUT v-esys-cmd-proc-handle, INPUT v-esys-cmd-code, '+update') = false  THEN do:
     4618             undo _main, return error v-last-error-message .
     4619           end.
     4620           release position-t.
     4621         end.
     4622       end.
     4623       empty temp-table position-t.
     4624       empty temp-table head-t.
     4625       run edocsord_export in this-procedure ( buffer buf_ord-doc
     4626                                           ,input entry(1, buf_ord-doc-rcv.sub-par, chr(4))
     4627                                           ,input '9':U
     4628                                           ) no-error.
     4629       if error-status:error then do:
     4630         v-mess = substitute("Ошибка при переводе статуса маршрутизированного заказа:&1&2&1&3"
     4631                             , chr(10)
     4632                             , error-status:get-message(1)
     4633                             , return-value ).
     4634         undo _main, retry _main.
     4635       end.
     4636       IF  context_set-custom-esys-pck-name(  input v-esys-cmd-proc-handle, input v-esys-cmd-code, input v-custom-pack-name) = false  THEN do:
     4637         undo _main, return error v-last-error-message .
     4638       end.
     4639       v-dump-ord-int64 = context_send-esys-command( input string(buf_ext-system.esys-id), input v-esys-cmd-proc-handle, input v-esys-cmd-code, input g#userid).
     4640       if v-dump-ord-int64 = 0 THEN do:
     4641         undo _main, return error v-last-error-message .
     4642       end.
     4643       v-edist-mess = ''.
     4644       v-edist-mess = cr-edist_add-edist-mess( v-edist-mess, 'route':U, string(v-dump-ord-int64)).
     4645       v-date-status = ?.
     4646       run create-edi-state in this-procedure (
     4647                                               input 'trn-doc':U
     4648                                             , input v-current-doc-code
     4649                                             , input v-cli-type
     4650                                             , input v-cli-code
     4651                                             , input 'ИЗМЕНЕНИЕ':U
     4652                                             , input buf_ord-doc.ord-int1
     4653                                             , input integer('0':U)
     4654                                             , input v-PS
     4655                                             , input v-edist-mess
     4656                                             , input integer('2':U)
     4657                                             , input-output v-date-status
     4658                                             , input-output v-time-status
     4659                                             ).
     4660           ExpData1:Route-data_clear-data ( ) .
     4661     end.
     4662   end.
     4663   end procedure.
     4664   procedure load-ruleset-context :
     4665   define input parameter p-ruleset-id as integer no-undo .
     4666   define variable v-is-waiting-status as logical   no-undo .
     4667   define variable v-direction as character no-undo .
     4668   define variable v-dm as integer no-undo .
     4669   define variable v-ext-doc-type as character no-undo .
     4670   define buffer buf_rule-call-param for ub.rule-call-param.
     4671   define buffer buf_ord-chain  for ub.ord-chain.
     4672   do
     4673   on error undo, return error
     4674   :
     4675     if g#news then  return "return".
     4676     assign
     4677     v-oldbh = widget-handle (entry(2, p-doc-code, chr(4)))
     4678     v-newbh = widget-handle (entry(3, p-doc-code, chr(4)))
     4679     v-changes-list = entry(4, p-doc-code, chr(4))
     4680     file-name  = p-process-file-name
     4681     v-has-oldbh = valid-handle(v-oldbh) and v-oldbh:available
     4682     v-has-newbh = valid-handle(v-newbh) and v-newbh:available
     4683     .
     4684     if not v-has-newbh
     4685     and not v-has-oldbh then do:
     4686       undo, return error substitute("Не определено ни одного буфера - ни старый, ни новый").
     4687     end.
     4688     if not v-has-oldbh
     4689     and v-changes-list  = '' then do:
     4690        undo, return error substitute("Не определен старый буфер и список изменений").
     4691     end.
     4692     case p-ruleset-id:
     4693     when 115 then do:
     4694       if v-has-newbh
     4695       and v-newbh:table <> 'trn-doc':U then do:
     4696         undo, return error substitute("Передан неверный буфер вместо буфера для &1",  'ord-doc-rcv':U).
     4697       end.
     4698     end.
     4699     otherwise do:
     4700       undo, return error substitute("Неверный вызов &1 для набора правил &2", vss-workfile , p-ruleset-id).
     4701     end.
     4702     end case.
     4703     run statq_has-waiting-stat in this-procedure (
     4704                                                     input v-oldbh
     4705                                                    ,input v-newbh
     4706                                                    ,input v-changes-list
     4707                                                    ,input 'факт':U
     4708                                                    ,input ?
     4709                                                    ,input 0
     4710                                                    ,output v-is-waiting-status
     4711                                                    ,output v-direction
     4712                                                    ) no-error.
     4713     if v-is-waiting-status = no
     4714     or entry(1, v-direction, chr(4)) = 'удаление':U
     4715     then do:
     4716       return "return".
     4717     end.
     4718     v-dm = v-newbh:Buffer-field("whole-send-news"):buffer-value.
     4719     v-current-doc-code = v-newbh:buffer-field("doc-code"):buffer-value.
     4720     v-doc-date = v-newbh:buffer-field("doc-date"):buffer-value.
     4721     v-fact-date = v-newbh:buffer-field("fact-date"):buffer-value.
     4722     v-ps = v-newbh:buffer-field("ps"):buffer-value.
     4723     v-ext-doc-type = v-newbh:buffer-field("ext-doc-type"):buffer-value.
     4724     if v-dm <> integer('2':U) then do:
     4725       return "return".
     4726     end.
     4727     if v-ext-doc-type <> 'ie':U then do:
     4728       return "return".
     4729     end.
     4730     find first buf_ord-chain   no-lock where
     4731             buf_ord-chain.rel-doc-code = v-current-doc-code
     4732        and  buf_ord-chain.rel-doc-type = "trn"
     4733        and buf_ord-chain.doc-type = "rcv" no-error .
     4734     if not available buf_ord-chain then return "return".
     4735     find first buf_ord-doc-rcv no-lock where
     4736               buf_ord-doc-rcv.rcv-code = buf_ord-chain.doc-code no-error .
     4737     if not available buf_ord-doc-rcv then do:
     4738       return "return".
     4739     end.
     4740     find first buf_ord-doc exclusive-lock where
     4741               buf_ord-doc.doc-code = buf_ord-doc-rcv.doc-code no-error .
     4742     if not available buf_ord-doc
     4743     or buf_ord-doc.doc-type <> 'ОП':U
     4744     then do:
     4745       return "return".
     4746     end.
     4747     find first buf_rule-call-param no-lock where
     4748   buf_rule-call-param.codex_id = p-codex-id
     4749   and buf_rule-call-param.ruleset_id = p-ruleset-id
     4750   and buf_rule-call-param.call_id = p-call-id
     4751   and buf_rule-call-param.order_id = p-order-id
     4752   and buf_rule-call-param.rule_id = p-rule-id
     4753   and buf_rule-call-param.param-name = "p-xsd-file"
     4754    no-error.
     4755   if available buf_rule-call-param then do:
     4756   assign p-xsd-file = buf_rule-call-param.param-value-character.
     4757   end.
     4758   end.
     4759   end procedure.
