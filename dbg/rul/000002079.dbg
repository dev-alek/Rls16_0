     3449     .
     3450     _ii:
     3451     do v-ii = 1 to 5:
     3452       if v-stat-list[v-ii] = '' then next.
     3453       assign
     3454       v-waiting-stfl-i = lookup(v-waiting-stfl, v-stat-list[v-ii], chr(3))
     3455       v-old-stfl-i = lookup(v-old-stfl, v-stat-list[v-ii], chr(3))
