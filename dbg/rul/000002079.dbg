     3709                    'запрос':U +   chr(4) + string(yes) + chr(3) +
     3710                    'накл':U +      chr(4) + string(no) + chr(3) +
     3711                    'накл':U +      chr(4) + string(yes) + chr(3) +
     3712                    'разрешен':U + chr(4) + string(yes) + chr(3) +
     3713                    'разрешен':U + chr(4) + string(no) + chr(3) +
     3714                    'факт':U +      chr(4) + string(yes)
     3715   .
     3716   assign
     3717   v-stat-list[lookup('vt':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 2] =
     3718                    '' +           chr(4) + string(no) + chr(3) +
     3719                    'запрос':U +   chr(4) + string(no) + chr(3) +
     3720                    'запрос':U +   chr(4) + string(yes) + chr(3) +
     3721                    'накл':U +      chr(4) + string(no) + chr(3) +
     3722                    'накл':U +      chr(4) + string(yes) + chr(3) +
     3723                    'разрешен':U + chr(4) + string(yes) + chr(3) +
     3724                    'разрешен':U + chr(4) + string(no) + chr(3) +
     3725                    'факт':U +      chr(4) + string(no)
     3726   .
     3727   assign
     3728   v-stat-list[lookup('es':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] =
     3729                    '' +           chr(4) + string(no) + chr(3) +
     3730                    'касс':U + chr(4) + string(no) + chr(3) +
     3731                    'касс':U + chr(4) + string(yes) + chr(3) +
     3732                    'нередакт':U + chr(4) + string(yes) + chr(3) +
     3733                    'факт':U +      chr(4) + string(yes)
     3734   v-stat-list[lookup('rs':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] =
     3735                    '' +           chr(4) + string(no) + chr(3) +
     3736                    'касс':U + chr(4) + string(no) + chr(3) +
     3737                    'касс':U + chr(4) + string(yes) + chr(3) +
     3738                    'нередакт':U + chr(4) + string(yes) + chr(3) +
     3739                    'факт':U +      chr(4) + string(yes)
     3740   v-stat-list[lookup('es':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 2] =
     3741                    '' +         chr(4) + string(no) + chr(3) +
     3742                    'запрос':U + chr(4) + string(no)
     3743   v-stat-list[lookup('rs':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 2] =
     3744                    '' +         chr(4) + string(no) + chr(3) +
     3745                    'запрос':U + chr(4) + string(no)
     3746   .
     3747   _jj:
     3748   do v-jj = 1 to 2:
     3749     if v-jj = 1 then do:
     3750       assign
     3751       v-waiting-stfl = p-waiting-status + chr(4) + string(if p-waiting-flag = ? then yes else p-waiting-flag)
     3752       .
     3753     end.
     3754     if v-jj = 2 then do:
     3755       if p-waiting-flag <> ? then leave  _jj.
     3756       assign
     3757       v-waiting-stfl = p-waiting-status + chr(4) + string(no)
     3758       .
     3759     end.
     3760     assign
     3761     v-old-stfl = p-oldbh::status_ + chr(4) + string(p-oldbh::flag_)
     3762     .
     3763     assign
     3764     v-new-stfl = p-newbh::status_ + chr(4) + string(p-newbh::flag_)
     3765     .
     3766     _ii:
     3767     do v-ii = (lookup(v-ext-doc-type, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3) to (lookup(v-ext-doc-type, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4):
     3768       if v-stat-list[v-ii] = '' then next.
     3769       assign
     3770       v-waiting-stfl-i = lookup(v-waiting-stfl, v-stat-list[v-ii], chr(3))
     3771       v-old-stfl-i = lookup(v-old-stfl, v-stat-list[v-ii], chr(3))
     3772       v-new-stfl-i = lookup(v-new-stfl, v-stat-list[v-ii], chr(3))
     3773       .
     3774       if v-waiting-stfl-i = 0
     3775       or v-old-stfl-i = 0
     3776       or v-new-stfl-i = 0
     3777       then do:
     3778         next _ii.
     3779       end.
     3780       if v-old-stfl-i < v-waiting-stfl-i
     3781       and v-new-stfl-i = v-waiting-stfl-i then do:
     3782         assign
     3783         p-is-waiting-status = yes
     3784         p-direction = '<закрытие документа>':U + chr(4) + "to".
     3785         return.
     3786       end.
     3787       if v-old-stfl-i < v-waiting-stfl-i
     3788       and v-new-stfl-i > v-waiting-stfl-i then do:
     3789         assign
     3790         p-is-waiting-status = yes
     3791         p-direction = '<закрытие документа>':U + chr(4) + "to-up".
     3792         return.
     3793       end.
     3794       if v-new-stfl-i = v-waiting-stfl-i
     3795       and v-old-stfl-i > v-waiting-stfl-i then do:
     3796         assign
     3797         p-is-waiting-status = yes
     3798         p-direction = '<открытие документа>':U + chr(4) + "to".
     3799         return.
     3800       end.
     3801       if v-new-stfl-i < v-waiting-stfl-i
     3802       and v-old-stfl-i > v-waiting-stfl-i then do:
     3803         assign
     3804         p-is-waiting-status = yes
     3805         p-direction = '<открытие документа>':U + chr(4) + "to-down".
     3806         return.
     3807       end.
     3808       if v-old-stfl-i = v-waiting-stfl-i
     3809       and v-new-stfl-i > v-waiting-stfl-i then do:
     3810         assign
     3811         p-is-waiting-status = yes
     3812         p-direction = '<закрытие документа>':U + chr(4) + "from".
     3813         return.
     3814       end.
     3815       if v-old-stfl-i = v-waiting-stfl-i
     3816       and v-new-stfl-i < v-waiting-stfl-i then do:
     3817         assign
     3818         p-is-waiting-status = yes
     3819         p-direction = '<открытие документа>':U + chr(4) + "from".
     3820         return.
     3821       end.
     3822     end.
     3823   end.
     3824   end.
     3825   end procedure .
     3826   procedure stat-graf-price :
     3827   define input parameter p-oldbh              as handle no-undo .
     3828   define input parameter p-newbh              as handle no-undo .
     3829   define input parameter p-changed-fields     as character no-undo .
     3830   define input parameter p-waiting-status     as character no-undo .
     3831   define input parameter p-waiting-flag       as logical no-undo .
     3832   define output parameter p-is-waiting-status as logical no-undo .
     3833   define output parameter p-direction         as character no-undo .
     3834   define variable v-stat-list as character no-undo extent 5.
     3835   define variable v-waiting-stfl as character no-undo .
     3836   define variable v-old-stfl as character no-undo .
     3837   define variable v-new-stfl as character no-undo .
     3838   define variable v-waiting-stfl-i as integer no-undo .
     3839   define variable v-old-stfl-i as integer no-undo .
     3840   define variable v-new-stfl-i as integer no-undo .
     3841   define variable v-ii as integer no-undo .
     3842   do
     3843   on error undo, return error return-value
     3844   :
     3845   assign
     3846   v-stat-list[1] =
     3847                    ''            +  chr(3) +
     3848                    'новый':U    +  chr(3) +
     3849                    'приказ':U      +  chr(3) +
     3850                    'разрешен':U  +  chr(3) +
     3851                    'акт':U
     3852   .
     3853     assign
     3854     v-waiting-stfl = p-waiting-status
     3855     .
     3856     assign
     3857     v-old-stfl = p-oldbh::status_
     3858     .
     3859     assign
     3860     v-new-stfl = p-newbh::status_
     3861     .
     3862     _ii:
     3863     do v-ii = 1 to 5:
     3864       if v-stat-list[v-ii] = '' then next.
     3865       assign
     3866       v-waiting-stfl-i = lookup(v-waiting-stfl, v-stat-list[v-ii], chr(3))
     3867       v-old-stfl-i = lookup(v-old-stfl, v-stat-list[v-ii], chr(3))
     3868       v-new-stfl-i = lookup(v-new-stfl, v-stat-list[v-ii], chr(3))
     3869       .
     3870       if v-waiting-stfl-i = 0
     3871       or v-old-stfl-i = 0
     3872       or v-new-stfl-i = 0
     3873       then do:
     3874         next _ii.
     3875       end.
     3876       if v-old-stfl-i < v-waiting-stfl-i
     3877       and v-new-stfl-i = v-waiting-stfl-i then do:
     3878         assign
     3879         p-is-waiting-status = yes
     3880         p-direction = '<закрытие документа>':U + chr(4) + "to".
     3881         return.
     3882       end.
     3883       if v-old-stfl-i < v-waiting-stfl-i
     3884       and v-new-stfl-i > v-waiting-stfl-i then do:
     3885         assign
     3886         p-is-waiting-status = yes
     3887         p-direction = '<закрытие документа>':U + chr(4) + "to-up".
     3888         return.
     3889       end.
     3890       if v-new-stfl-i = v-waiting-stfl-i
     3891       and v-old-stfl-i > v-waiting-stfl-i then do:
     3892         assign
     3893         p-is-waiting-status = yes
     3894         p-direction = '<открытие документа>':U + chr(4) + "to".
     3895         return.
     3896       end.
     3897       if v-new-stfl-i < v-waiting-stfl-i
     3898       and v-old-stfl-i > v-waiting-stfl-i then do:
     3899         assign
     3900         p-is-waiting-status = yes
     3901         p-direction = '<открытие документа>':U + chr(4) + "to-down".
     3902         return.
     3903       end.
     3904       if v-old-stfl-i = v-waiting-stfl-i
     3905       and v-new-stfl-i > v-waiting-stfl-i then do:
     3906         assign
     3907         p-is-waiting-status = yes
     3908         p-direction = '<закрытие документа>':U + chr(4) + "from".
     3909         return.
     3910       end.
     3911       if v-old-stfl-i = v-waiting-stfl-i
     3912       and v-new-stfl-i < v-waiting-stfl-i then do:
     3913         assign
     3914         p-is-waiting-status = yes
     3915         p-direction = '<открытие документа>':U + chr(4) + "from".
     3916         return.
     3917       end.
     3918     end.
     3919   end.
     3920   end procedure.
     3921   procedure stat-graf-inkas :
     3922   define input parameter  p-oldbh              as handle no-undo .
     3923   define input parameter  p-newbh              as handle no-undo .
     3924   define input parameter  p-changed-fields     as character no-undo .
     3925   define input parameter  p-waiting-status     as character no-undo .
     3926   define input parameter  p-waiting-flag       as logical no-undo .
     3927   define output parameter p-is-waiting-status  as logical no-undo .
     3928   define output parameter p-direction          as character no-undo .
     3929   define variable v-doc-code as character no-undo .
     3930   define variable v-ext-doc-type as character no-undo .
     3931   define variable v-stat-list as character no-undo extent 3.
     3932   define variable v-jj as integer no-undo .
     3933   define variable v-ii as integer no-undo .
     3934   define variable v-old-stfl as character no-undo .
     3935   define variable v-new-stfl as character no-undo .
     3936   define variable v-waiting-stfl as character no-undo .
     3937   define variable v-old-stfl-i as integer no-undo .
     3938   define variable v-new-stfl-i as integer no-undo .
     3939   define variable v-waiting-stfl-i as integer no-undo .
     3940   do
     3941   on error  undo, return error substitute( "&1. &2&3&4", vss-include-info24, return-value, chr(10), error-status :get-message (1))
     3942   :
     3943   if p-newbh = ?  then do:
     3944     v-doc-code = p-oldbh::inkas-code .
     3945   end.
     3946   else do:
     3947     v-doc-code     = p-newbh::inkas-code .
     3948   end.
     3949   assign
     3950   v-stat-list[1] =
     3951                    '' +           chr(4) + string(no) + chr(3) +
     3952                    'новый':U + chr(4) + string(no) + chr(3) +
     3953                    'факт':U +      chr(4) + string(no)
     3954   v-stat-list[2] =
     3955                    '' +           chr(4) + string(no) + chr(3) +
     3956                    'новый':U + chr(4) + string(no) + chr(3) +
     3957                    'новый':U + chr(4) + string(yes) + chr(3) +
     3958                    'нередакт':U + chr(4) + string(yes) + chr(3) +
     3959                    'факт':U +      chr(4) + string(no)
     3960   v-stat-list[3] =
     3961                    '' +         chr(4) + string(no) + chr(3) +
     3962                    'запрос':U + chr(4) + string(no)
     3963   .
     3964   _jj:
     3965   do v-jj = 1 to 2:
     3966     if v-jj = 1 then do:
     3967       assign
     3968       v-waiting-stfl = p-waiting-status + chr(4) + string(if p-waiting-flag = ? then no else p-waiting-flag)
     3969       .
     3970     end.
     3971     if v-jj = 2 then do:
     3972       if p-waiting-flag <> ? then leave  _jj.
     3973       assign
     3974       v-waiting-stfl = p-waiting-status + chr(4) + string(yes)
     3975       .
     3976     end.
     3977     assign
     3978     v-old-stfl = p-oldbh::status_ + chr(4) + string(p-oldbh::flag_)
     3979     .
     3980     assign
     3981     v-new-stfl = p-newbh::status_ + chr(4) + string(p-newbh::flag_)
     3982     .
     3983     _ii:
     3984     do v-ii = 1 to 3:
     3985       if v-stat-list[v-ii] = '' then next.
     3986       assign
     3987       v-waiting-stfl-i = lookup(v-waiting-stfl, v-stat-list[v-ii], chr(3))
     3988       v-old-stfl-i = lookup(v-old-stfl, v-stat-list[v-ii], chr(3))
     3989       v-new-stfl-i = lookup(v-new-stfl, v-stat-list[v-ii], chr(3))
     3990       .
     3991       if v-waiting-stfl-i = 0
     3992       or v-old-stfl-i = 0
     3993       or v-new-stfl-i = 0
     3994       then do:
     3995         next _ii.
     3996       end.
     3997       if v-old-stfl-i < v-waiting-stfl-i
     3998       and v-new-stfl-i = v-waiting-stfl-i then do:
     3999         assign
     4000         p-is-waiting-status = yes
     4001         p-direction = '<закрытие документа>':U + chr(4) + "to".
     4002         return.
     4003       end.
     4004       if v-old-stfl-i < v-waiting-stfl-i
     4005       and v-new-stfl-i > v-waiting-stfl-i then do:
     4006         assign
     4007         p-is-waiting-status = yes
     4008         p-direction = '<закрытие документа>':U + chr(4) + "to-up".
     4009         return.
     4010       end.
     4011       if v-new-stfl-i = v-waiting-stfl-i
     4012       and v-old-stfl-i > v-waiting-stfl-i then do:
     4013         assign
     4014         p-is-waiting-status = yes
     4015         p-direction = '<открытие документа>':U + chr(4) + "to".
     4016         return.
     4017       end.
     4018       if v-new-stfl-i < v-waiting-stfl-i
     4019       and v-old-stfl-i > v-waiting-stfl-i then do:
     4020         assign
     4021         p-is-waiting-status = yes
     4022         p-direction = '<открытие документа>':U + chr(4) + "to-down".
     4023         return.
     4024       end.
     4025       if v-old-stfl-i = v-waiting-stfl-i
     4026       and v-new-stfl-i > v-waiting-stfl-i then do:
     4027         assign
     4028         p-is-waiting-status = yes
     4029         p-direction = '<закрытие документа>':U + chr(4) + "from".
     4030         return.
     4031       end.
     4032       if v-old-stfl-i = v-waiting-stfl-i
     4033       and v-new-stfl-i < v-waiting-stfl-i then do:
     4034         assign
     4035         p-is-waiting-status = yes
     4036         p-direction = '<открытие документа>':U + chr(4) + "from".
     4037         return.
     4038       end.
     4039     end.
     4040   end.
     4041   end.
     4042   end procedure .
