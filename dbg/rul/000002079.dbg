     3612   procedure stat-graf-trn :
     3613   define input parameter  p-oldbh              as handle no-undo .
     3614   define input parameter  p-newbh              as handle no-undo .
     3615   define input parameter  p-changed-fields     as character no-undo .
     3616   define input parameter  p-waiting-status     as character no-undo .
     3617   define input parameter  p-waiting-flag       as logical no-undo .
     3618   define output parameter p-is-waiting-status  as logical no-undo .
     3619   define output parameter p-direction          as character no-undo .
     3620   define variable v-doc-code as character no-undo .
     3621   define variable v-ext-doc-type as character no-undo .
     3622   define variable v-stat-list as character no-undo extent 84.
     3623   define variable v-stat-list-all as character no-undo .
     3624   define variable v-jj as integer no-undo .
     3625   define variable v-ii as integer no-undo .
     3626   define variable v-old-stfl as character no-undo .
     3627   define variable v-new-stfl as character no-undo .
     3628   define variable v-waiting-stfl as character no-undo .
     3629   define variable v-old-stfl-i as integer no-undo .
     3630   define variable v-new-stfl-i as integer no-undo .
     3631   define variable v-waiting-stfl-i as integer no-undo .
     3632   do
     3633   on error  undo, return error substitute( "&1. &2&3&4", vss-include-info24, return-value, chr(10), error-status :get-message (1))
     3634   :
     3635   if p-newbh = ?  then do:
     3636     v-doc-code = p-oldbh::doc-code .
     3637     v-ext-doc-type = p-oldbh::ext-doc-type .
     3638   end.
     3639   else do:
     3640     v-doc-code     = p-newbh::doc-code .
     3641     v-ext-doc-type = p-newbh::ext-doc-type .
     3642   end.
     3643   assign
     3644   v-stat-list-all =
     3645                    '' +           chr(4) + string(no) + chr(3) +
     3646                    'запрос':U +   chr(4) + string(no) + chr(3) +
     3647                    'запрос':U +   chr(4) + string(yes) + chr(3) +
     3648                    'накл':U +      chr(4) + string(no) + chr(3) +
     3649                    'накл':U +      chr(4) + string(yes) + chr(3) +
     3650                    'разрешен':U + chr(4) + string(no) + chr(3) +
