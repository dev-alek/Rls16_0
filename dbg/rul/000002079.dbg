     4114   function context_begin-esys-command return logical
     4115   (
     4116       input p-esys-id-list as character
     4117      ,input-output p-esys-cmd-proc-handle as handle
     4118      ,output p-esys-cmd-code as integer
     4119   ):
     4120      if not valid-handle(p-esys-cmd-proc-handle )
     4121      then do:
     4122        run nws/cmd-bush.p persistent set p-esys-cmd-proc-handle no-error .
     4123        if error-status :error
     4124        then do:
     4125           delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( substitute("&1 &2 &3&4Ошибка при запуске процедуры cmd-bush.p&4" +
     4126                                              "&5&4&6"
     4127                                              ,vss-workfile
     4128                                              ,vss-revision
     4129                                              ,vss-description
     4130                                              ,chr(10)
     4131                                              ,error-status:get-message(1)
     4132                                              ,return-value )).
     4133        end.
     4134        run begin-create-command in p-esys-cmd-proc-handle
     4135          (input 'cmd-esys-general':U
     4136          ,input p-esys-id-list
     4137          ,output p-esys-cmd-code
     4138          ) no-error.
     4139        if error-status :error
     4140        then do:
     4141          delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при создании команды &1&2&3&1&4"
     4142                                                           , 'cmd-esys-general':U
     4143                                                           , error-status:get-message(1)
     4144                                                           , return-value
     4145                                                           )).
     4146          return no .
     4147        end.
     4148        return yes.
     4149      end.
     4150   end.
     4151   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4152   function context_send-esys-command return int64
     4153   (
     4154       input p-esys-id-list as character
     4155      ,input p-esys-cmd-proc-handle as handle
     4156      ,input p-esys-cmd-code as integer
     4157      ,input p-user-id as character
     4158   ):
