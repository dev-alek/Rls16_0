     3487         assign
     3488         p-is-waiting-status = yes
     3489         p-direction = '<открытие документа>':U + chr(4) + "to-down".
     3490         return.
     3491         end.
     3492       if v-old-stfl-i = v-waiting-stfl-i
     3493       and v-new-stfl-i > v-waiting-stfl-i then do:
     3494         assign
     3495         p-is-waiting-status = yes
     3496         p-direction = '<закрытие документа>':U + chr(4) + "from".
     3497         return.
     3498       end.
     3499       if v-old-stfl-i = v-waiting-stfl-i
     3500       and v-new-stfl-i < v-waiting-stfl-i then do:
     3501         assign
     3502         p-is-waiting-status = yes
     3503         p-direction = '<открытие документа>':U + chr(4) + "from".
     3504         return.
     3505         end.
     3506         end.
