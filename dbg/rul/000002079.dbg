     3464       if v-old-stfl-i < v-waiting-stfl-i
     3465       and v-new-stfl-i = v-waiting-stfl-i then do:
     3466         assign
     3467         p-is-waiting-status = yes
     3468         p-direction = '<закрытие документа>':U + chr(4) + "to".
     3469         return.
     3470       end.
     3471       if v-old-stfl-i < v-waiting-stfl-i
     3472       and v-new-stfl-i > v-waiting-stfl-i then do:
     3473         assign
     3474         p-is-waiting-status = yes
     3475         p-direction = '<закрытие документа>':U + chr(4) + "to-up".
     3476         return.
     3477       end.
     3478       if v-new-stfl-i = v-waiting-stfl-i
     3479       and v-old-stfl-i > v-waiting-stfl-i then do:
     3480         assign
     3481         p-is-waiting-status = yes
     3482         p-direction = '<открытие документа>':U + chr(4) + "to".
     3483         return.
     3484         end.
     3485       if v-new-stfl-i < v-waiting-stfl-i
