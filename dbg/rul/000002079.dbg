     4170            delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при отсылке во внешнюю систему &1 команды с кодом &2&3&4&3&5"
     4171                                                           , p-esys-id-list
     4172                                                           , p-cmd-code
     4173                                                           , chr(10)
     4174                                                           , error-status:get-message(1)
     4175                                                           , return-value
     4176                                                           )).
     4177            return 0.
     4178         end.
     4179         delete procedure p-esys-cmd-proc-handle no-error.
     4180         return v-dmp-ord-int64.
     4181      end.
     4182      else do:
     4183         delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при отсылке во внешнюю систему &1 команды с кодом &2&3&4&3&5"
     4184                                                       , p-esys-id-list
     4185                                                       , p-cmd-code
     4186                                                       , chr(10)
     4187                                                       , error-status:get-message(1)
     4188                                                       , return-value
     4189                                                       )).
