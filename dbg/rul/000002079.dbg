     1604   procedure get-header-by-rec :
     1605   define input  parameter p-gate-rec as character no-undo .
     1606   define output parameter p-tth as handle no-undo .
     1607   define variable v-ii as integer   no-undo .
     1608   define variable glog as logical   no-undo .
     1609   define variable v-rowid as rowid no-undo .
     1610   define variable v-tbl-name as character no-undo .
     1611   define variable v-longchar as longchar no-undo .
     1612   define variable v-txmlh as handle no-undo .
     1613   define buffer buf_clob-data for ub.clob-data.
     1614   main-block:
     1615   do
     1616   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info8, return-value, chr(10), error-status :get-message (1))
     1617   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info8 )
     1618   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info8 )
     1619   :
     1620     run gen-row-keyr in  this-procedure  (
     1621                                           input  p-gate-rec
     1622                                           ,input  ?
     1623                                           ,input  "ub"
     1624                                           ,input  ?
     1625                                           ,input  NO-LOCK
     1626                                           ,output v-rowid
     1627                                           ,output v-tbl-name   ) no-error.
     1628       find first buf_clob-data no-lock where
     1629                 rowid(buf_clob-data) = v-rowid  no-error.
     1630       if not available buf_clob-data then do:
     1631         undo, return error substitute("Не найден CLOB  &1"
     1632                                         , p-gate-rec
     1633                                         ).
     1634       end.
     1635       assign
     1636       v-longchar = buf_clob-data.cdata
     1637       .
     1638       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1639       if error-status :error then do:
     1640         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1641       end.
     1642       create temp-table p-tth .
     1643       glog = p-tth:READ-XMLSCHEMA( "LONGCHAR"
     1644                                     , v-longchar
     1645                                     , ?
     1646                                     , ?
     1647                                     , ?
     1648                                     ) no-error.
     1649       v-longchar = '':U.
     1650       define variable v-esm as character no-undo .
     1651       v-esm = error-status:get-message(1).
     1652       if error-status :error
     1653       or not glog
     1654       then do:
     1655         delete object p-tth no-error.
     1656         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     1657                                    , p-gate-rec
     1658                                    , buf_clob-data.file-name_
     1659                                    , chr(10)
     1660                                    , v-esm
     1661                                     ).
     1662       end.
     1663   end.
     1664   end procedure.
     1665   define new global shared variable g#lib-gate as handle no-undo .
     1666   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1667   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1668   define temp-table RECADV-t no-undo
     1669   field NUMBER  as character
     1670   field DATE as date
