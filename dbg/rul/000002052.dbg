     2120                    'накл':U +      chr(4) + string(no) + chr(3) +
     2121                    'накл':U +      chr(4) + string(yes) + chr(3) +
     2122                    'разрешен':U + chr(4) + string(no) + chr(3) +
     2123                    'разрешен':U + chr(4) + string(yes) + chr(3) +
