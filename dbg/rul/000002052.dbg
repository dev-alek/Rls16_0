     2173       .
     2174     end.
     2175     if v-jj = 2 then do:
     2176       if p-waiting-flag <> ? then leave  _jj.
     2177       assign
     2178       v-waiting-stfl = p-waiting-status + chr(4) + string(no)
     2179       .
     2180     end.
     2181     assign
     2182     v-old-stfl = p-oldbh::status_ + chr(4) + string(p-oldbh::flag_)
     2183     .
