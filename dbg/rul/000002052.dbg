     2259   define variable v-waiting-stfl-i as integer no-undo .
     2260   define variable v-old-stfl-i as integer no-undo .
     2261   define variable v-new-stfl-i as integer no-undo .
     2262   define variable v-ii as integer no-undo .
     2263   do
     2264   on error undo, return error return-value
     2265   :
     2266   assign
     2267   v-stat-list[1] =
     2268                    ''            +  chr(3) +
     2269                    'новый':U    +  chr(3) +
     2270                    'приказ':U      +  chr(3) +
     2271                    'разрешен':U  +  chr(3) +
     2272                    'акт':U
     2273   .
     2274     assign
     2275     v-waiting-stfl = p-waiting-status
     2276     .
     2277     assign
