     2820   if error-status:error then do:
     2821     undo, return error return-value .
     2822   end.
     2823   if return-value = "return" then return ''.
     2824   define variable ExpData1 as class Route-data_ no-undo .
     2825   ExpData1 = new Route-data_( input parparentproc, input p-parent-handle, input p-log-handle, input this-procedure:handle) .
     2826   if not this-procedure:persistent then do:
     2827     run proc-main in this-procedure no-error .
     2828     if error-status:error then do:
     2829       v-esm = error-status :get-message (1).
     2830       v-es = error-status:error .
     2831       v-rv = return-value .
     2832     end.
     2833     if v-es then do:
     2834         run garbcoll_clear in this-procedure .
     2835         undo, return error substitute( "&1. &2&3&4", vss-workfile, v-rv, chr(10), v-esm).
     2836     end.
     2837     run garbcoll_clear in this-procedure .
     2838   end.
     2839   procedure proc-main :
     2840   _main:
     2841   do
     2842   on error undo, return error substitute( "&1&2&3&2&4", return-value, chr(10), error-status :get-message (1), v-last-error-message)
     2843   on stop undo, return error substitute( "&1&2&3&2&4", return-value, chr(10), error-status :get-message (1), v-last-error-message)
     2844   :
     2845   define variable v-err               as logical    no-undo .
     2846   define variable v-status_           as character  no-undo .
     2847   define variable v-flag              as logical    no-undo .
     2848   define variable v-doc-code          as character  no-undo .
     2849   define variable v-rcv-code          as character  no-undo .
     2850   define variable v-dklink-doc-type   as integer    no-undo .
     2851   define variable v-agentid           as integer    no-undo .
     2852   define variable v-ext-doc-type      as character  no-undo .
     2853   define variable v-ord-rcv-obj-type  as character  no-undo .
     2854   define variable v-ord-rcv-obj-code  as integer    no-undo .
     2855   define variable v-obj-db-num        as integer    no-undo .
     2856   define variable v-obj-uniq-key-rec  as character  no-undo .
     2857   define variable v-b-code            as integer    no-undo .
     2858   define variable v-main-b-code       as integer    no-undo .
     2859   define variable v-gds-name-full     as character  no-undo .
     2860   define variable v-node-name         as character  no-undo .
     2861   define variable v-ext-num           as character  no-undo .
     2862   define variable v-agnt-id           as integer    no-undo .
     2863   define variable v-obj-type          as character  no-undo .
     2864   define variable v-obj-code          as integer    no-undo .
     2865   define variable v-cli-type          as character  no-undo .
     2866   define variable v-cli-code          as integer    no-undo .
     2867   define variable v-to-store-id       as integer    no-undo .
     2868   define variable v-ext-artic         as character  no-undo .
     2869   define buffer buf_clients for ub.clients.
     2870   define buffer buf_ext-classif for ub.ext-classif.
     2871   define buffer buf_ord-doc-rcv for ub.ord-doc-rcv.
     2872   define buffer buf_ord-line-rcv for ub.ord-line-rcv.
     2873   define buffer buf_ord-dtl-rcv for ub.ord-dtl-rcv.
     2874   define buffer buf_gds-prt for ub.gds-prt.
     2875   define buffer buf_goods for ub.goods.
     2876   define buffer buf_ext-artic for ub.ext-artic.
     2877     if v-has-newbh then do:
     2878       v-obj-type = v-newbh::obj-type.
     2879       v-obj-code = v-newbh::obj-code.
     2880       v-cli-type = v-newbh::cli-type.
     2881       v-cli-code = v-newbh::cli-code.
     2882       v-doc-code = v-newbh:buffer-field("doc-code"):buffer-value.
     2883       v-rcv-code = v-newbh:buffer-field("rcv-code"):buffer-value.
     2884     end.
     2885     else do:
     2886       v-obj-type = v-oldbh::obj-type.
     2887       v-obj-code = v-oldbh::obj-code.
     2888       v-cli-type = v-oldbh::cli-type.
     2889       v-cli-code = v-oldbh::cli-code.
     2890       v-doc-code = v-oldbh:buffer-field("doc-code"):buffer-value.
     2891       v-rcv-code = v-oldbh:buffer-field("rcv-code"):buffer-value.
     2892     end.
     2893   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2894   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     2895     (input  v-obj-type
     2896     ,input  v-obj-code
     2897     ,output v-obj-db-num
     2898     )  .
     2899     if v-obj-db-num <> g#db-num then do:
     2900       return 'return'.
     2901     end.
     2902     find first buf_clients no-lock
     2903       where buf_clients.obj-type = v-obj-type
     2904         and buf_clients.obj-code = v-obj-code
     2905     .
     2906     run gen-key-rec in this-procedure ( input 'clients':U
     2907                                        ,input buffer buf_clients:handle
     2908                                        ,output v-obj-uniq-key-rec).
     2909     v-esys-id-list = ''.
     2910     for each buf_ext-classif no-lock where
     2911         buf_ext-classif.classif-name = 'clients-esys':U
     2912     and buf_ext-classif.classif-subject = 'clients':U
     2913     and buf_ext-classif.db-num = 0
     2914     and buf_Ext-classif.uniq-key-rec = v-obj-uniq-key-rec :
     2915       if lookup(string(buf_ext-classif.key#_one), v-esys-id-list-start, chr(1)) = 0 then next.
     2916       v-esys-id-list = v-esys-id-list + (if v-esys-id-list = '' then '' else chr(1)) + string(buf_ext-classif.key#_one).
     2917     end.
     2918     if v-esys-id-list = '' then return "return".
     2919     IF  ExpData1:route-data_read-xmlschema( INPUT p-xsd-file) = false  THEN do:
     2920       undo _main, return error v-last-error-message .
     2921     end.
     2922     IF  context_begin-esys-command( input v-esys-id-list
     2923                                   , input-output v-esys-cmd-proc-handle
     2924                                   , output v-esys-cmd-code) = false  THEN do:
     2925       undo _main, return error v-last-error-message .
     2926     end.
     2927     ExpData1:route-data_create-record( INPUT "doc_header") .
     2928     IF ExpData1:esys-add-dump( INPUT "doc_header", INPUT v-esys-cmd-proc-handle, INPUT v-esys-cmd-code, '_dump-order=Rec_ID') = false  THEN do:
     2929       v-err-mess = substitute("Ошибка при маршрутизации поставки &1:&2&3"
     2930                               , v-doc-code
     2931                               , chr(10)
     2932                               , v-last-error-message
     2933                               ).
     2934       undo _main, return error v-last-error-message .
     2935     end.
     2936     run thdl-prc_map-obj in this-procedure ( input  v-obj-type
     2937                                            , input  v-obj-code
     2938                                            , output v-to-store-id
     2939                                            )  no-error .
     2940     if error-status :error = yes
     2941     then do:
     2942       assign
     2943         v-last-error-message = substitute( "Ошибка преобразования контрагента: &1 &2. &3 &4"
     2944                                           , v-obj-type
     2945                                           , v-obj-code
     2946                                           , return-value
     2947                                           , error-status :get-message(1)
     2948                                           )
     2949       .
     2950       undo _main, return error v-last-error-message .
     2951     end.
     2952     run thdl-prc_map-obj in this-procedure ( input  v-cli-type
     2953                                            , input  v-cli-code
     2954                                            , output v-agnt-id
     2955                                            )  no-error .
     2956     if error-status :error = yes
     2957     then do:
     2958       assign
     2959         v-last-error-message = substitute( "Ошибка преобразования контрагента: &1 &2. &3 &4"
     2960                                           , v-cli-type
     2961                                           , v-cli-code
     2962                                           , return-value
     2963                                           , error-status :get-message(1)
     2964                                           )
     2965       .
     2966       undo _main, return error v-last-error-message .
     2967     end.
     2968     assign
     2969       v-dklink-doc-type = 0
     2970       v-ext-num = substitute("&1;&2;&3"
     2971                             , v-rcv-code
     2972                             , 'ord-doc-rcv':U
     2973                             , v-ext-doc-type
     2974                             )
     2975     .
     2976     ExpData1:route-data_copy-field-integer( INPUT "doc_header", "ID", INPUT  0 ) .
     2977     ExpData1:route-data_copy-field-character( INPUT "doc_header", "Action", INPUT  v-action ) .
     2978     ExpData1:route-data_copy-field-character( INPUT "doc_header", "ExtNum", INPUT  v-ext-num).
     2979     ExpData1:route-data_copy-field-integer( INPUT "doc_header", "Type", INPUT  v-dklink-doc-type).
     2980     ExpData1:route-data_copy-field-integer( INPUT "doc_header", "AgentID", INPUT  v-agnt-id).
     2981     ExpData1:route-data_copy-field-integer( INPUT "doc_header", "ToStoreID", INPUT v-to-store-id ).
     2982     ExpData1:route-data_copy-field-decimal( INPUT "doc_line", "PCount", INPUT  0.0 ) .
     2983     IF ExpData1:esys-add-dump( INPUT "doc_header", INPUT v-esys-cmd-proc-handle, INPUT v-esys-cmd-code, '+update') = false  THEN do:
     2984       v-err-mess = substitute("Ошибка при маршрутизации поставки &1:&2&3"
     2985                               , v-doc-code
     2986                               , chr(10)
     2987                               , v-last-error-message
     2988                               ).
     2989       undo _main, return error v-last-error-message .
     2990     end.
     2991     for each buf_ord-line-rcv no-lock
     2992       where buf_ord-line-rcv.doc-code = v-doc-code
     2993         and buf_ord-line-rcv.rcv-code = v-rcv-code
     2994     on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2995     on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
     2996     on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
     2997     :
     2998       find first buf_goods no-lock where
     2999                 buf_goods.gds-code = buf_ord-line-rcv.gds-code.
     3000       ExpData1:route-data_create-record( INPUT "doc_line") .
     3001       IF ExpData1:esys-add-dump( INPUT "doc_line", INPUT v-esys-cmd-proc-handle, INPUT v-esys-cmd-code, '_dump-order=Rec_ID') = false  THEN do:
     3002         v-err-mess = substitute("Ошибка при маршрутизации накладной &1:&2&3"
     3003                                 , v-doc-code
     3004                                 , chr(10)
     3005                                 , v-last-error-message
     3006                                 ).
     3007         undo _main, return error v-last-error-message .
     3008       end.
     3009   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3010     (input  buf_goods.gds-code
     3011     ,input  ?
     3012     ,output v-main-b-code
     3013     )  .
     3014       find first buf_ext-artic no-lock
     3015             where buf_ext-artic.cli-type = v-cli-type
     3016               and buf_ext-artic.cli-code = v-cli-code
     3017               and buf_ext-artic.gds-code = buf_goods.gds-code
     3018               and buf_ext-artic.status_  = 'тек':U
     3019             no-error .
     3020       if available buf_ext-artic then do:
     3021         assign v-ext-artic = buf_ext-artic.ext-artic .
     3022       end.
     3023       else do:
     3024         assign v-ext-artic = '' .
     3025             end.
     3026       ExpData1:route-data_copy-field-integer( INPUT "doc_line", "ID", INPUT  0 ) .
     3027       ExpData1:route-data_copy-field-integer( INPUT "doc_line", "Pos", INPUT  buf_ord-line-rcv.line-num ) .
     3028       ExpData1:route-data_copy-field-integer( INPUT "doc_line", "GoodsID", INPUT  buf_goods.gds-code ) .
     3029       ExpData1:route-data_copy-field-integer( INPUT "doc_line", "StoreID", INPUT  v-to-store-id ) .
     3030       ExpData1:route-data_copy-field-integer( INPUT "doc_line", "BC", INPUT  v-main-b-code ) .
     3031       ExpData1:route-data_copy-field-character( INPUT "doc_line", "Name", INPUT  buf_goods.gds-name ) .
     3032       ExpData1:route-data_copy-field-character( INPUT "doc_line", "Comment", INPUT  ""  ) .
     3033       ExpData1:route-data_copy-field-character( INPUT "doc_line", "SN", INPUT  ""  ) .
     3034       ExpData1:route-data_copy-field-decimal( INPUT "doc_line", "PCount", INPUT  buf_ord-line-rcv.qnty) .
     3035       ExpData1:route-data_copy-field-decimal( INPUT "doc_line", "FCount", INPUT  0.0) .
     3036       ExpData1:route-data_copy-field-decimal( INPUT "doc_line", "PPrice", INPUT  buf_ord-line-rcv.price-cli).
     3037       ExpData1:route-data_copy-field-decimal( INPUT "doc_line", "FPrice", INPUT  0.0).
     3038       ExpData1:route-data_copy-field-character( INPUT "doc_line", "ExtArtic", INPUT v-ext-artic ) .
     3039       IF ExpData1:esys-add-dump( INPUT "doc_line", INPUT v-esys-cmd-proc-handle, INPUT v-esys-cmd-code, '+update') = false  THEN do:
     3040         v-err-mess = substitute("Ошибка при маршрутизации накладной &1:&2&3"
     3041                                 , v-doc-code
     3042                                 , chr(10)
     3043                                 , v-last-error-message
     3044                                 ).
     3045         undo _main, return error v-last-error-message .
     3046       end.
     3047     end.
     3048     IF  context_send-esys-command( input v-esys-id-list
     3049                                 , input v-esys-cmd-proc-handle
     3050                                 , input v-esys-cmd-code
     3051                                 , input g#userid) = false  THEN do:
     3052       undo _main, return error v-last-error-message .
     3053     end.
     3054       ExpData1:Route-data_clear-data ( ) .
     3055     ExpData1:route-data_clear-xmlschema ( ).
     3056   end.
     3057   end procedure.
     3058   procedure load-ruleset-context :
     3059   define input parameter p-ruleset-id as integer no-undo .
     3060   define variable v-flag as logical no-undo .
     3061   define variable v-ii as integer no-undo .
     3062   define variable v-is-waiting-status as logical no-undo .
     3063   define variable v-direction as character no-undo .
     3064   define variable v-changes-list2 as character no-undo .
     3065   define variable v-obj-db-num as integer no-undo .
     3066   define buffer buf_rule-call-param for ub.rule-call-param.
     3067   define buffer buf_ext-system for ub.ext-system.
     3068   define buffer buf_clients for ub.clients.
     3069   do
     3070   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3071   on stop   undo, return error substitute( "&1. stop", vss-workfile )
     3072   on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     3073   :
     3074     assign
     3075     v-oldbh = widget-handle (entry(2, p-doc-code, chr(4)))
     3076     v-newbh = widget-handle (entry(3, p-doc-code, chr(4)))
     3077     v-changes-list = entry(4, p-doc-code, chr(4))
     3078     file-name  = p-process-file-name
     3079     v-has-oldbh = valid-handle(v-oldbh) and v-oldbh:available
     3080     v-has-newbh = valid-handle(v-newbh) and v-newbh:available
     3081     .
     3082     if not v-has-newbh
     3083     and not v-has-oldbh then do:
     3084       undo, return error substitute("Не определено ни одного буфера - ни старый, ни новый").
     3085     end.
     3086     if not v-has-oldbh
     3087     and v-changes-list  = '' then do:
     3088        undo, return error substitute("Не определен старый буфер и список изменений").
     3089     end.
     3090     case p-ruleset-id:
     3091       when 105 then do:
     3092         if v-has-newbh
     3093         and v-newbh:table <> 'ord-doc-rcv':U then do:
     3094           undo, return error substitute("Передан неверный буфер вместо буфера для &1",  'ord-doc-rcv':U).
     3095         end.
     3096       end.
     3097       otherwise do:
     3098         undo, return error substitute("Неверный вызов &1 для набора правил &2", vss-workfile , p-ruleset-id).
     3099       end.
     3100     end case.
     3101     run statq_has-waiting-stat in this-procedure (
     3102                                                     input v-oldbh
     3103                                                    ,input v-newbh
     3104                                                    ,input v-changes-list
     3105                                                    ,input 'поставка':U
     3106                                                    ,input no
     3107                                                    ,input 0
     3108                                                    ,output v-is-waiting-status
     3109                                                    ,output v-direction
     3110                                                    ) no-error.
     3111     if v-is-waiting-status = no then return "return".
     3112     if entry(1, v-direction, chr(4)) = '<открытие документа>':U
     3113     or entry(1, v-direction, chr(4)) = 'удаление':U
     3114     or ( v-direction = '<закрытие документа>':U + chr(4) + "from" )
     3115     then do:
     3116       v-action = 'D':U.
     3117     end.
     3118     else do:
     3119       v-action = 'U':U.
     3120     end.
     3121     for each buf_rule-call-param no-lock where
     3122     buf_rule-call-param.codex_id = p-codex-id
     3123     and buf_rule-call-param.ruleset_id = p-ruleset-id
     3124     and buf_rule-call-param.call_id = p-call-id
     3125     and buf_rule-call-param.order_id = p-order-id
     3126     and buf_rule-call-param.rule_id = p-rule-id
     3127     and buf_rule-call-param.param-name = "p-esys-id-list",
     3128       first buf_ext-system no-lock where
     3129             buf_Ext-system.esys-id = buf_rule-call-param.param-value-integer
     3130         and buf_Ext-system.db-num = 0
     3131         and buf_Ext-system.esys-have-export = yes
     3132         and buf_Ext-system.esys-db-num-exp = g#db-num:
     3133       v-esys-id-list-start = v-esys-id-list-start + (if v-esys-id-list-start = '' then '' else chr(1)) + string(buf_ext-system.esys-id).
     3134     end.
     3135     if v-esys-id-list-start = '' then return "return".
     3136     find first buf_rule-call-param no-lock where
     3137   buf_rule-call-param.codex_id = p-codex-id
     3138   and buf_rule-call-param.ruleset_id = p-ruleset-id
     3139   and buf_rule-call-param.call_id = p-call-id
     3140   and buf_rule-call-param.order_id = p-order-id
     3141   and buf_rule-call-param.rule_id = p-rule-id
     3142   and buf_rule-call-param.param-name = "p-xsd-file"
     3143    no-error.
     3144   if available buf_rule-call-param then do:
     3145     assign p-xsd-file = buf_rule-call-param.param-value-character.
     3146   end.
     3147   end.
     3148   end procedure.
