     2703   function context_begin-esys-command return logical
     2704   (
     2705       input p-esys-id-list as character
     2706      ,input-output p-esys-cmd-proc-handle as handle
     2707      ,output p-esys-cmd-code as integer
     2708   ):
     2709      if not valid-handle(p-esys-cmd-proc-handle )
     2710      then do:
     2711        run nws/cmd-bush.p persistent set p-esys-cmd-proc-handle no-error .
     2712        if error-status :error
     2713        then do:
     2714           delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( substitute("&1 &2 &3&4Ошибка при запуске процедуры cmd-bush.p&4" +
     2715                                              "&5&4&6"
     2716                                              ,vss-workfile
     2717                                              ,vss-revision
     2718                                              ,vss-description
     2719                                              ,chr(10)
     2720                                              ,error-status:get-message(1)
     2721                                              ,return-value )).
     2722        end.
     2723        run begin-create-command in p-esys-cmd-proc-handle
     2724          (input 'cmd-esys-general':U
     2725          ,input p-esys-id-list
     2726          ,output p-esys-cmd-code
     2727          ) no-error.
     2728        if error-status :error
     2729        then do:
     2730          delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при создании команды &1&2&3&1&4"
     2731                                                           , 'cmd-esys-general':U
     2732                                                           , error-status:get-message(1)
     2733                                                           , return-value
     2734                                                           )).
     2735          return no .
     2736        end.
     2737        return yes.
     2738      end.
     2739   end.
     2740   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
