     2279     .
     2280     assign
     2281     v-new-stfl = p-newbh::status_
     2282     .
     2283     _ii:
     2284     do v-ii = 1 to 5:
     2285       if v-stat-list[v-ii] = '' then next.
     2286       assign
     2287       v-waiting-stfl-i = lookup(v-waiting-stfl, v-stat-list[v-ii], chr(3))
     2288       v-old-stfl-i = lookup(v-old-stfl, v-stat-list[v-ii], chr(3))
     2289       v-new-stfl-i = lookup(v-new-stfl, v-stat-list[v-ii], chr(3))
     2290       .
     2291       if v-waiting-stfl-i = 0
     2292       or v-old-stfl-i = 0
     2293       or v-new-stfl-i = 0
     2294       then do:
     2295         next _ii.
     2296       end.
     2297       if v-old-stfl-i < v-waiting-stfl-i
     2298       and v-new-stfl-i = v-waiting-stfl-i then do:
     2299         assign
     2300         p-is-waiting-status = yes
     2301         p-direction = '<закрытие документа>':U + chr(4) + "to".
     2302         return.
     2303       end.
     2304       if v-old-stfl-i < v-waiting-stfl-i
     2305       and v-new-stfl-i > v-waiting-stfl-i then do:
     2306         assign
     2307         p-is-waiting-status = yes
     2308         p-direction = '<закрытие документа>':U + chr(4) + "to-up".
     2309         return.
     2310       end.
     2311       if v-new-stfl-i = v-waiting-stfl-i
     2312       and v-old-stfl-i > v-waiting-stfl-i then do:
     2313         assign
     2314         p-is-waiting-status = yes
     2315         p-direction = '<открытие документа>':U + chr(4) + "to".
     2316         return.
     2317       end.
     2318       if v-new-stfl-i < v-waiting-stfl-i
     2319       and v-old-stfl-i > v-waiting-stfl-i then do:
     2320         assign
     2321         p-is-waiting-status = yes
     2322         p-direction = '<открытие документа>':U + chr(4) + "to-down".
     2323         return.
     2324       end.
     2325       if v-old-stfl-i = v-waiting-stfl-i
     2326       and v-new-stfl-i > v-waiting-stfl-i then do:
     2327         assign
     2328         p-is-waiting-status = yes
     2329         p-direction = '<закрытие документа>':U + chr(4) + "from".
     2330         return.
     2331       end.
     2332       if v-old-stfl-i = v-waiting-stfl-i
     2333       and v-new-stfl-i < v-waiting-stfl-i then do:
     2334         assign
     2335         p-is-waiting-status = yes
     2336         p-direction = '<открытие документа>':U + chr(4) + "from".
     2337         return.
     2338       end.
     2339     end.
     2340   end.
     2341   end procedure.
     2342   procedure stat-graf-inkas :
     2343   define input parameter  p-oldbh              as handle no-undo .
     2344   define input parameter  p-newbh              as handle no-undo .
     2345   define input parameter  p-changed-fields     as character no-undo .
     2346   define input parameter  p-waiting-status     as character no-undo .
     2347   define input parameter  p-waiting-flag       as logical no-undo .
     2348   define output parameter p-is-waiting-status  as logical no-undo .
     2349   define output parameter p-direction          as character no-undo .
     2350   define variable v-doc-code as character no-undo .
     2351   define variable v-ext-doc-type as character no-undo .
     2352   define variable v-stat-list as character no-undo extent 3.
     2353   define variable v-jj as integer no-undo .
     2354   define variable v-ii as integer no-undo .
     2355   define variable v-old-stfl as character no-undo .
     2356   define variable v-new-stfl as character no-undo .
     2357   define variable v-waiting-stfl as character no-undo .
     2358   define variable v-old-stfl-i as integer no-undo .
     2359   define variable v-new-stfl-i as integer no-undo .
     2360   define variable v-waiting-stfl-i as integer no-undo .
     2361   do
     2362   on error  undo, return error substitute( "&1. &2&3&4", vss-include-info10, return-value, chr(10), error-status :get-message (1))
     2363   :
     2364   if p-newbh = ?  then do:
     2365     v-doc-code = p-oldbh::inkas-code .
     2366   end.
     2367   else do:
     2368     v-doc-code     = p-newbh::inkas-code .
     2369   end.
     2370   assign
     2371   v-stat-list[1] =
     2372                    '' +           chr(4) + string(no) + chr(3) +
     2373                    'новый':U + chr(4) + string(no) + chr(3) +
     2374                    'факт':U +      chr(4) + string(no)
     2375   v-stat-list[2] =
     2376                    '' +           chr(4) + string(no) + chr(3) +
     2377                    'новый':U + chr(4) + string(no) + chr(3) +
     2378                    'новый':U + chr(4) + string(yes) + chr(3) +
     2379                    'нередакт':U + chr(4) + string(yes) + chr(3) +
     2380                    'факт':U +      chr(4) + string(no)
     2381   v-stat-list[3] =
     2382                    '' +         chr(4) + string(no) + chr(3) +
     2383                    'запрос':U + chr(4) + string(no)
     2384   .
     2385   _jj:
     2386   do v-jj = 1 to 2:
     2387     if v-jj = 1 then do:
     2388       assign
     2389       v-waiting-stfl = p-waiting-status + chr(4) + string(if p-waiting-flag = ? then no else p-waiting-flag)
     2390       .
     2391     end.
     2392     if v-jj = 2 then do:
     2393       if p-waiting-flag <> ? then leave  _jj.
     2394       assign
     2395       v-waiting-stfl = p-waiting-status + chr(4) + string(yes)
     2396       .
     2397     end.
     2398     assign
     2399     v-old-stfl = p-oldbh::status_ + chr(4) + string(p-oldbh::flag_)
     2400     .
     2401     assign
     2402     v-new-stfl = p-newbh::status_ + chr(4) + string(p-newbh::flag_)
     2403     .
     2404     _ii:
     2405     do v-ii = 1 to 3:
     2406       if v-stat-list[v-ii] = '' then next.
     2407       assign
     2408       v-waiting-stfl-i = lookup(v-waiting-stfl, v-stat-list[v-ii], chr(3))
     2409       v-old-stfl-i = lookup(v-old-stfl, v-stat-list[v-ii], chr(3))
     2410       v-new-stfl-i = lookup(v-new-stfl, v-stat-list[v-ii], chr(3))
     2411       .
     2412       if v-waiting-stfl-i = 0
     2413       or v-old-stfl-i = 0
     2414       or v-new-stfl-i = 0
     2415       then do:
     2416         next _ii.
     2417       end.
     2418       if v-old-stfl-i < v-waiting-stfl-i
     2419       and v-new-stfl-i = v-waiting-stfl-i then do:
     2420         assign
     2421         p-is-waiting-status = yes
     2422         p-direction = '<закрытие документа>':U + chr(4) + "to".
     2423         return.
     2424       end.
     2425       if v-old-stfl-i < v-waiting-stfl-i
     2426       and v-new-stfl-i > v-waiting-stfl-i then do:
     2427         assign
     2428         p-is-waiting-status = yes
     2429         p-direction = '<закрытие документа>':U + chr(4) + "to-up".
     2430         return.
     2431       end.
     2432       if v-new-stfl-i = v-waiting-stfl-i
     2433       and v-old-stfl-i > v-waiting-stfl-i then do:
     2434         assign
     2435         p-is-waiting-status = yes
     2436         p-direction = '<открытие документа>':U + chr(4) + "to".
     2437         return.
     2438       end.
     2439       if v-new-stfl-i < v-waiting-stfl-i
     2440       and v-old-stfl-i > v-waiting-stfl-i then do:
     2441         assign
     2442         p-is-waiting-status = yes
     2443         p-direction = '<открытие документа>':U + chr(4) + "to-down".
     2444         return.
     2445       end.
     2446       if v-old-stfl-i = v-waiting-stfl-i
     2447       and v-new-stfl-i > v-waiting-stfl-i then do:
     2448         assign
     2449         p-is-waiting-status = yes
     2450         p-direction = '<закрытие документа>':U + chr(4) + "from".
     2451         return.
     2452       end.
     2453       if v-old-stfl-i = v-waiting-stfl-i
     2454       and v-new-stfl-i < v-waiting-stfl-i then do:
     2455         assign
     2456         p-is-waiting-status = yes
     2457         p-direction = '<открытие документа>':U + chr(4) + "from".
     2458         return.
     2459       end.
     2460     end.
     2461   end.
     2462   end.
     2463   end procedure .
     2464   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2465   procedure thdl-prc_map-obj :
     2466     define input  parameter p-obj-type  as character no-undo .
     2467     define input  parameter p-obj-code  as integer   no-undo .
     2468     define output parameter p-code      as integer   no-undo .
     2469     define buffer buf_store   for ub.store.
     2470     define buffer buf_shop    for ub.shop.
     2471     define buffer buf_clients for ub.clients.
     2472   do for
     2473     buf_store
     2474   , buf_shop
     2475   , buf_clients
     2476   on error undo, return error return-value
     2477   :
     2478     assign
     2479       p-code = ?
     2480     .
     2481     case p-obj-type
     2482     :
     2483       when 'маг':U
     2484       then do:
     2485         find first buf_shop no-lock
     2486           where buf_shop.obj-code = p-obj-code
     2487         no-error .
     2488         if not available buf_shop
     2489         then do:
     2490           return error substitute( "Не найден магазин с кодом:&1":U , p-obj-code ) .
     2491         end.
     2492         assign
     2493           p-code = buf_shop.obj-code
     2494         .
     2495       end.
     2496       when 'скл':U
     2497       then do:
     2498         find first buf_store no-lock
     2499           where buf_store.obj-code = p-obj-code
     2500         no-error .
     2501         if not available buf_store
     2502         then do:
     2503           return error substitute( "Не найден склад с кодом:&1":U , p-obj-code ) .
     2504         end.
     2505         assign
     2506           p-code = 100000 + buf_store.obj-code
     2507         .
     2508       end.
     2509       when 'чел':U
     2510       then do:
     2511         find first buf_clients no-lock
     2512           where buf_clients.obj-type = p-obj-type
     2513             and buf_clients.obj-code = p-obj-code
     2514         no-error .
     2515         if not available buf_clients
     2516         then do:
     2517           return error substitute( "Не найден контрагент &1 &2" , p-obj-type, p-obj-code ) .
     2518         end.
     2519         assign
     2520           p-code = buf_clients.obj-code
     2521         .
     2522       end.
     2523       when 'орг':U
     2524       then do:
     2525         find first buf_clients no-lock
     2526           where buf_clients.obj-type = p-obj-type
     2527             and buf_clients.obj-code = p-obj-code
     2528         no-error .
     2529         if not available buf_clients
     2530         then do:
     2531           return error substitute( "Не найден контрагент &1 &2" , p-obj-type, p-obj-code ) .
     2532         end.
     2533         assign
     2534           p-code = 1000000000 + buf_clients.obj-code
     2535         .
     2536       end.
     2537       otherwise do:
     2538         return error substitute( "Недопустимый тип контрагента:&1":U , p-obj-type ).
     2539       end.
     2540     end case.
     2541   end.
     2542   end procedure.
     2543   procedure thdl-prc_unmap-store :
     2544     define input  parameter p-code      as integer   no-undo .
     2545     define output parameter p-obj-type  as character no-undo .
     2546     define output parameter p-obj-code  as integer   no-undo .
     2547     define buffer buf_store   for ub.store.
     2548     define buffer buf_shop    for ub.shop.
     2549     define variable v-code as integer   no-undo .
     2550   do for
     2551     buf_store
     2552   , buf_shop
     2553   on error undo, return error return-value
     2554   :
     2555     assign
     2556       p-obj-type = ?
     2557       p-obj-code = ?
     2558     .
     2559     if p-code > 100000
     2560     then do :
     2561       assign
     2562         v-code = p-code - 100000
     2563       .
     2564       find first buf_store no-lock
     2565         where buf_store.obj-code = v-code
     2566       no-error .
     2567       if not available buf_store
     2568       then do:
     2569         return .
     2570       end.
     2571       assign
     2572         p-obj-type = 'скл':U
     2573         p-obj-code = buf_store.obj-code
     2574       .
     2575     end.
     2576     else do:
     2577       find first buf_shop no-lock
     2578         where buf_shop.obj-code = p-code
     2579       no-error .
     2580       if not available buf_shop
     2581       then do:
     2582         return .
     2583       end.
     2584       assign
     2585         p-obj-type = 'маг':U
     2586         p-obj-code = buf_shop.obj-code
     2587       .
     2588     end.
     2589   end.
     2590   end procedure.
     2591   procedure thdl-prc_unmap-agent :
     2592     define input  parameter p-code      as integer   no-undo .
     2593     define output parameter p-obj-type  as character no-undo .
     2594     define output parameter p-obj-code  as integer   no-undo .
     2595     define variable v-code as integer   no-undo .
     2596     define buffer buf_clients for ub.clients.
     2597   do for
     2598     buf_clients
     2599   on error undo, return error return-value
     2600   :
     2601     assign
     2602       p-obj-type = ?
     2603       p-obj-code = ?
     2604     .
     2605     if p-code > 1000000000
     2606     then do:
     2607       assign
     2608         v-code = p-code - 1000000000
     2609       .
     2610       find first buf_clients no-lock
     2611         where buf_clients.obj-type = 'орг':U
     2612           and buf_clients.obj-code = v-code
     2613       no-error .
     2614       if not available buf_clients
     2615       then do:
     2616         return .
     2617       end.
     2618       assign
     2619         p-obj-type = 'орг':U
     2620         p-obj-code = buf_clients.obj-code
     2621       .
     2622     end.
     2623     else do:
     2624       find first buf_clients no-lock
     2625         where buf_clients.obj-type = 'чел':U
     2626           and buf_clients.obj-code = p-code
     2627       no-error .
     2628       if not available buf_clients
     2629       then do:
     2630         return .
     2631       end.
     2632       assign
     2633         p-obj-type = 'чел':U
     2634         p-obj-code = buf_clients.obj-code
     2635       .
     2636     end.
     2637   end.
     2638   end procedure.
