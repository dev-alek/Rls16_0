     2192       v-old-stfl-i = lookup(v-old-stfl, v-stat-list[v-ii], chr(3))
     2193       v-new-stfl-i = lookup(v-new-stfl, v-stat-list[v-ii], chr(3))
     2194       .
     2195       if v-waiting-stfl-i = 0
     2196       or v-old-stfl-i = 0
     2197       or v-new-stfl-i = 0
     2198       then do:
     2199         next _ii.
     2200       end.
     2201       if v-old-stfl-i < v-waiting-stfl-i
     2202       and v-new-stfl-i = v-waiting-stfl-i then do:
     2203         assign
     2204         p-is-waiting-status = yes
     2205         p-direction = '<закрытие документа>':U + chr(4) + "to".
     2206         return.
     2207       end.
     2208       if v-old-stfl-i < v-waiting-stfl-i
     2209       and v-new-stfl-i > v-waiting-stfl-i then do:
     2210         assign
     2211         p-is-waiting-status = yes
     2212         p-direction = '<закрытие документа>':U + chr(4) + "to-up".
     2213         return.
     2214       end.
     2215       if v-new-stfl-i = v-waiting-stfl-i
     2216       and v-old-stfl-i > v-waiting-stfl-i then do:
     2217         assign
     2218         p-is-waiting-status = yes
     2219         p-direction = '<открытие документа>':U + chr(4) + "to".
     2220         return.
     2221       end.
     2222       if v-new-stfl-i < v-waiting-stfl-i
     2223       and v-old-stfl-i > v-waiting-stfl-i then do:
     2224         assign
     2225         p-is-waiting-status = yes
     2226         p-direction = '<открытие документа>':U + chr(4) + "to-down".
     2227         return.
     2228       end.
     2229       if v-old-stfl-i = v-waiting-stfl-i
     2230       and v-new-stfl-i > v-waiting-stfl-i then do:
     2231         assign
     2232         p-is-waiting-status = yes
     2233         p-direction = '<закрытие документа>':U + chr(4) + "from".
     2234         return.
     2235       end.
     2236       if v-old-stfl-i = v-waiting-stfl-i
     2237       and v-new-stfl-i < v-waiting-stfl-i then do:
     2238         assign
     2239         p-is-waiting-status = yes
     2240         p-direction = '<открытие документа>':U + chr(4) + "from".
     2241         return.
     2242       end.
     2243     end.
     2244   end.
     2245   end.
     2246   end procedure .
     2247   procedure stat-graf-price :
     2248   define input parameter p-oldbh              as handle no-undo .
     2249   define input parameter p-newbh              as handle no-undo .
     2250   define input parameter p-changed-fields     as character no-undo .
     2251   define input parameter p-waiting-status     as character no-undo .
     2252   define input parameter p-waiting-flag       as logical no-undo .
     2253   define output parameter p-is-waiting-status as logical no-undo .
     2254   define output parameter p-direction         as character no-undo .
     2255   define variable v-stat-list as character no-undo extent 5.
