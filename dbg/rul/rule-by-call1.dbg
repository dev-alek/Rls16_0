        1   block-level on error undo, throw.
        2   define input parameter        p-mode as character no-undo .
        3   define input parameter        p-silent as logical no-undo .
        4   define input-output parameter p-rec  as recid     no-undo .
        5   define input parameter        p-cmd-proc-handle as handle no-undo .
        6   define input parameter        p-cmd-code as integer no-undo .
        7   define input parameter        p-call#-id as integer no-undo .
        8   define input parameter        p-codex-id as integer no-undo .
        9   define input parameter        p-ruleset-id as integer no-undo .
       10   define input parameter        p-order-id as integer no-undo .
       11   define input parameter        p-call-id as character no-undo .
       12   define input parameter        p-rule-id as integer no-undo .
       13   define input parameter        p-profile-id as integer no-undo .
       14   define input parameter        p-once-more as integer no-undo .
       15   define input parameter        p-is-dynamic as logical no-undo .
       16   define input parameter        p-can-calc as logical no-undo .
       17   define input parameter        p-algo-des as character no-undo .
       18   define variable vss-revision    as character no-undo init "$Revision$":U .
       19   define variable vss-author      as character no-undo init "$Author$":U .
       20   define variable vss-date        as character no-undo init "$Date$":U .
       21   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       22   define variable vss-archive     as character no-undo init "$Archive$":U .
       23   define variable vss-description as character no-undo init "Сохранение привязки rule к точке вызова".
       24   procedure vss-get-info :
       25     define output parameter p-vss-revision    like vss-revision    no-undo .
       26     define output parameter p-vss-author      like vss-author      no-undo .
       27     define output parameter p-vss-date        like vss-date        no-undo .
       28     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       29     define output parameter p-vss-archive     like vss-archive     no-undo .
       30     define output parameter p-vss-description like vss-description no-undo .
       31     assign
       32       p-vss-revision    = vss-revision
       33       p-vss-author      = vss-author
       34       p-vss-date        = vss-date
       35       p-vss-workfile    = vss-workfile
       36       p-vss-archive     = vss-archive
       37       p-vss-description = vss-description
       38     .
       39   end procedure.
       40   procedure vss-get-parameters :
       41     define output parameter p-vss-parameters as character no-undo .
       42   end procedure.
       43   define new global shared variable g#vssrevis-logger as handle    no-undo .
       44   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       45   define variable v-vssrevis-logger                   as handle    no-undo .
       46   procedure vss-logevent :
       47     define input  parameter p-extra-paramters as character no-undo .
       48     define variable v-vssrevis-parameters as character no-undo .
       49     do
       50     on error undo, return error return-value
       51     :
       52       if  valid-handle(v-vssrevis-logger)
       53       and v-vssrevis-logger :get-signature("logevent") <> ""
       54       then do:
       55         run vss-get-parameters in this-procedure
       56           (output v-vssrevis-parameters
       57           ).
       58         run logevent in v-vssrevis-logger
       59           (input vss-workfile
       60           ,input vss-revision
       61           ,input v-vssrevis-parameters
       62           ,input p-extra-paramters
       63           ).
       64       end.
       65     end.
       66   end procedure.
       67   assign
       68     v-vssrevis-logger = g#vssrevis-logger
       69   .
       70   if  valid-handle(v-vssrevis-logger)
       71   and v-vssrevis-logger :get-signature("logevent") <> ""
       72   then do:
       73     assign
       74       v-vssrevis-logevent = true
       75     .
       76     run vss-logevent in this-procedure (input vss-description) .
       77   end.
       78   define new global shared variable g#language as character no-undo .
       79   if g#language <> '' and g#language <> 'rus':U then do:
       80     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       81   end.
       82   define new global shared variable g#library  as handle no-undo .
       83   define new global shared variable g#library2 as handle no-undo .
       84   define   shared variable g#auto as logical no-undo.
       85   define   shared variable g#news as logical no-undo.
       86   define   shared variable g#oxml as logical no-undo.
       87   define   shared variable g#esys as logical no-undo.
       88   define   shared variable g#news-source-db as integer no-undo.
       89   define   shared variable g#esys-source-esys as integer no-undo.
       90   define   shared variable g#db-num as integer   no-undo .
       91   define   shared variable g#userid as character no-undo .
       92   define   shared variable g#passwd as character no-undo .
       93   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       94   procedure gen-key-rec :
       95     define input  parameter p-tbl-name    as character no-undo.
       96     define input  parameter p-bh_tbl-name as handle    no-undo.
       97     define output parameter p-key-rec     as character no-undo.
       98     do
       99     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      100     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      101     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      102     :
      103       define variable fh               as handle    no-undo .
      104       define variable v-ok             as logical   no-undo .
      105       define variable v-inform         as character no-undo .
      106       define variable v-ind            as integer   no-undo .
      107       define variable v-idx-field-qnty as integer   no-undo .
      108       if p-tbl-name = ?
      109         or p-tbl-name = "":U
      110       then do:
      111         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info0 ).
      112       end.
      113       if not p-bh_tbl-name:available then do:
      114         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info0, p-tbl-name ).
      115       end.
      116       assign
      117         p-key-rec = p-tbl-name
      118         v-inform  = p-bh_tbl-name:index-information(1)
      119         v-ind     = 2
      120       .
      121       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      122       on error undo, return error
      123       :
      124         assign
      125           v-inform = p-bh_tbl-name:index-information( v-ind )
      126           v-ind    = v-ind + 1
      127         .
      128       end.
      129       if v-inform = ?
      130         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      131         or entry( 3, v-inform, ",":U ) <> "1":U
      132       then do:
      133         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, p-tbl-name ).
      134       end.
      135       else do:
      136         assign
      137           v-idx-field-qnty = num-entries( v-inform ) - 4
      138         .
      139         if v-idx-field-qnty < 2 then do:
      140           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, p-tbl-name ).
      141         end.
      142         do v-ind = 1 to v-idx-field-qnty by 2
      143         on error undo, return error
      144         :
      145           assign
      146             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      147             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      148           .
      149         end.
      150       end.
      151       if p-key-rec = ? then do:
      152         assign
      153           p-key-rec = "":U
      154         .
      155         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info0, p-tbl-name ).
      156       end.
      157     end.
      158     return.
      159   end procedure.
      160   procedure gen-where-keyr-tab :
      161     define input  parameter i-tableSerach as character no-undo.
      162     define input  parameter i-tablekey   as character  no-undo.
      163     define input  parameter p-key-rec    as character  no-undo.
      164     define input  parameter p-key-handle as handle     no-undo .
      165     define input  parameter p-db-name    as character  no-undo .
      166     define input  parameter p-tt-handle  as handle     no-undo .
      167     define output parameter o-Where      as character  no-undo.
      168     do
      169     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      170     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      171     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      172     :
      173       define variable v-full-tbl-name  as character no-undo .
      174       define variable bh_tbl-name      as handle    no-undo .
      175       define variable fh_key           as handle    no-undo .
      176       define variable fh_search        as handle    no-undo .
      177       define variable v-field-num      as integer   no-undo .
      178       define variable v-count-fld      as integer   no-undo .
      179       define variable v-inform         as character no-undo .
      180       define variable v-ind            as integer   no-undo .
      181       define variable v-idx-field-qnty as integer   no-undo .
      182       define variable v-field-name     as character no-undo .
      183       define variable v-field-val      as character no-undo .
      184       define variable v-word-link      as character no-undo .
      185       define variable vTable           as character no-undo.
      186       define variable bh_tbl-key       as handle    no-undo .
      187       assign
      188         p-key-rec = trim( p-key-rec )
      189       .
      190       if p-key-handle <> ? then do:
      191         if not valid-handle(p-key-handle)
      192            or p-key-handle:type <> "buffer"
      193         then do:
      194           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info0 ).
      195         end.
      196         if num-entries( p-key-rec, chr(3) ) > 1
      197           or p-key-rec = ?
      198           or p-key-rec = "":U
      199         then do:
      200           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info0, p-key-rec ).
      201         end.
      202       end.
      203       else do:
      204         if p-key-rec = ?
      205           or p-key-rec = "":U
      206         then do:
      207           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info0 ).
      208         end.
      209       end.
      210       assign
      211         vTable = entry( 1 , p-key-rec, chr(3) )
      212       .
      213       if p-tt-handle <> ?
      214         and ( not valid-handle(p-tt-handle)
      215               or p-tt-handle:type <> "buffer"
      216             )
      217       then do:
      218         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info0, vTable, chr(10) ).
      219       end.
      220       if p-tt-handle = ? then do:
      221         assign
      222           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      223         .
      224         create buffer bh_tbl-name for table v-full-tbl-name .
      225       end.
      226       else do:
      227         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      228       end.
      229       assign
      230         v-inform = bh_tbl-name:index-information(1)
      231         v-ind    = 2
      232       .
      233       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      234       on error undo, return error
      235       :
      236         assign
      237           v-inform = bh_tbl-name:index-information( v-ind )
      238           v-ind    = v-ind + 1
      239         .
      240       end.
      241       if v-inform = ?
      242         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      243         or entry( 3, v-inform, ",":U ) <> "1":U
      244       then do:
      245         delete object bh_tbl-name no-error.
      246         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info0, vTable ).
      247       end.
      248       assign
      249         v-idx-field-qnty = num-entries( v-inform ) - 4
      250       .
      251       if v-idx-field-qnty < 2 then do:
      252         delete object bh_tbl-name no-error.
      253         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, vTable ).
      254       end.
      255       assign
      256         o-where     = "where":U
      257         v-word-link = "":U
      258         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      259         v-count-fld = 0
      260       .
      261       if i-tablekey ne "" and i-tablekey ne ?
      262       then do:
      263         assign
      264           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      265         .
      266         create buffer bh_tbl-key for table v-full-tbl-name .
      267       end.
      268       if i-tableSerach ne "" and i-tableSerach ne ?
      269       then do:
      270         delete object bh_tbl-name no-error.
      271         assign
      272           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      273         .
      274         create buffer bh_tbl-name for table v-full-tbl-name .
      275       end.
      276       block_where:
      277       do v-ind = 1 to v-idx-field-qnty by 2
      278       on error undo, return error
      279       :
      280         assign
      281           v-count-fld = v-count-fld + 1
      282         .
      283         if p-key-handle = ?
      284           and v-count-fld > v-field-num
      285         then do:
      286           leave block_where.
      287         end.
      288         define variable VfieldKeyTable as handle no-undo.
      289         assign
      290           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      291           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      292         .
      293         if     bh_tbl-key ne ?
      294         then do:
      295            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      296            if VfieldKeyTable eq ?
      297            then next block_where.
      298         end.
      299         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      300         then
      301            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      302         else
      303            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      304         if p-key-handle = ? then do:
      305           assign
      306             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      307           .
      308         end.
      309         else do:
      310           assign
      311             fh_key = p-key-handle:buffer-field( v-field-name )
      312           .
      313           if fh_key = ?
      314             or not valid-handle( fh_key )
      315           then do:
      316             delete object bh_tbl-name.
      317             if     bh_tbl-key ne ?
      318             then
      319                delete object bh_tbl-key.
      320             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info0, p-key-handle:name, v-field-name ).
      321           end.
      322           assign
      323             v-field-val = fh_key:buffer-value
      324           .
      325         end.
      326         if fh_search:data-type ="character":U then do:
      327           assign
      328             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      329             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      330             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      331             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      332             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      333             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      334             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      335             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      336             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      337             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      338             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      339             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      340             v-field-val = substitute( '"&1"', v-field-val )
      341           .
      342         end.
      343         assign
      344           o-where = substitute( "&1 &2", o-where, v-field-val )
      345         .
      346         if v-word-link = "":U then do:
      347           assign
      348             v-word-link = "and":U
      349           .
      350         end.
      351       end.
      352       delete object bh_tbl-name.
      353       if     bh_tbl-key ne ?
      354       then
      355          delete object bh_tbl-key.
      356       if p-key-handle = ?
      357         and v-count-fld <> v-field-num
      358       then do:
      359         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info0, vTable ).
      360       end.
      361     end.
      362   end procedure.
      363   procedure gen-hn-keyr-tab :
      364     define input  parameter i-tableSerach as character no-undo.
      365     define input  parameter i-tablekey   as character no-undo.
      366     define input  parameter p-key-rec    as character no-undo.
      367     define input  parameter p-key-handle as handle    no-undo .
      368     define input  parameter p-db-name    as character no-undo .
      369     define input  parameter p-tt-handle  as handle    no-undo .
      370     define input  parameter p-stts-lock  as integer   no-undo .
      371     define output parameter o-hn         as handle    no-undo.
      372     define variable v-full-tbl-name as character no-undo.
      373     define variable v-where         as character no-undo.
      374     define variable bh_tbl-name     as handle    no-undo.
      375     define variable vTable          as character no-undo.
      376     do
      377     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      378     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      379     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      380         run gen-where-keyr-tab(i-tableSerach,
      381                                i-tablekey,
      382                                p-key-rec,
      383                                p-key-handle,
      384                                p-db-name,
      385                                p-tt-handle,
      386                                output v-where).
      387         if i-tableSerach ne "" and i-tableSerach ne ?
      388         then do:
      389            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      390            create buffer bh_tbl-name for table v-full-tbl-name .
      391         end.
      392         else do:
      393            if p-tt-handle = ? then do:
      394               assign
      395                  vTable = entry( 1 , p-key-rec, chr(3) )
      396               .
      397               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      398               create buffer bh_tbl-name for table v-full-tbl-name .
      399            end.
      400            else do:
      401               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      402            end.
      403         end.
      404         if p-tt-handle = ? then do:
      405            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      406         end.
      407         else do:
      408            bh_tbl-name:find-first( v-where ) no-error .
      409         end.
      410         o-hn = bh_tbl-name.
      411      end.
      412   end procedure.
      413   procedure gen-hn-keyr :
      414     define input  parameter p-key-rec    as character no-undo.
      415     define input  parameter p-key-handle as handle    no-undo .
      416     define input  parameter p-db-name    as character no-undo .
      417     define input  parameter p-tt-handle  as handle    no-undo .
      418     define input  parameter p-stts-lock  as integer   no-undo .
      419     define output parameter o-hn         as handle    no-undo.
      420     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      421   end.
      422   procedure gen-row-keyr :
      423     define input  parameter p-key-rec    as character no-undo.
      424     define input  parameter p-key-handle as handle    no-undo .
      425     define input  parameter p-db-name    as character no-undo .
      426     define input  parameter p-tt-handle  as handle    no-undo .
      427     define input  parameter p-stts-lock  as integer   no-undo .
      428     define output parameter p-tbl-row    as rowid     no-undo.
      429     define output parameter p-tbl-name   as character no-undo.
      430     define variable vHn as handle no-undo.
      431       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      432       p-tbl-row = if vHn:available then vHn:rowid else ?.
      433       p-tbl-name =  vHn:table.
      434       delete object vHn no-error.
      435     if p-tbl-row = ? then do:
      436       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info0, p-tbl-name, p-key-rec ).
      437     end.
      438     else do:
      439       return.
      440     end.
      441   end procedure.
      442   procedure gen-key-fv :
      443     define input  parameter p-key-rec    as character no-undo .
      444     define output parameter p-field-list as character no-undo .
      445     define output parameter p-value-list as character no-undo.
      446     do
      447     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      448     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      449     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      450     :
      451       define variable v-full-tbl-name  as character no-undo .
      452       define variable bh_tbl-name      as handle    no-undo .
      453       define variable v-tbl-name       as character no-undo .
      454       define variable v-field-num      as integer   no-undo .
      455       define variable v-count-fld      as integer   no-undo .
      456       define variable v-inform         as character no-undo .
      457       define variable v-ind            as integer   no-undo .
      458       define variable v-idx-field-qnty as integer   no-undo .
      459       define variable v-delim-key      as character no-undo .
      460       if p-key-rec = ?
      461         or p-key-rec = "":U
      462       then do:
      463         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info0 ).
      464       end.
      465       assign
      466         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      467         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      468       .
      469       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      470       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info0 ).
      471       assign
      472         v-inform = bh_tbl-name:index-information(1)
      473         v-ind    = 2
      474       .
      475       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      476       on error undo, return error
      477       :
      478         assign
      479           v-inform = bh_tbl-name:index-information( v-ind )
      480           v-ind    = v-ind + 1
      481         .
      482       end.
      483       if v-inform = ?
      484         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      485         or entry( 3, v-inform, ",":U ) <> "1":U
      486       then do:
      487         delete object bh_tbl-name no-error.
      488         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, v-tbl-name ).
      489       end.
      490       assign
      491         v-idx-field-qnty = num-entries( v-inform ) - 4
      492       .
      493       if v-idx-field-qnty < 2 then do:
      494         delete object bh_tbl-name no-error.
      495         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, v-tbl-name ).
      496       end.
      497       assign
      498         p-field-list = "":U
      499         p-value-list = "":U
      500         v-delim-key  = "":U
      501         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      502         v-count-fld  = 0
      503       .
      504       block_where:
      505       do v-ind = 1 to v-idx-field-qnty by 2
      506       on error undo, return error
      507       :
      508         assign
      509           v-count-fld = v-count-fld + 1
      510         .
      511         if v-count-fld > v-field-num then do:
      512           leave block_where.
      513         end.
      514         assign
      515           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      516           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      517         .
      518         if v-ind = 1 then do:
      519           assign
      520             v-delim-key = chr(3)
      521           .
      522         end.
      523       end.
      524       delete object bh_tbl-name.
      525       if v-count-fld <> v-field-num then do:
      526         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info0, v-tbl-name ).
      527       end.
      528     end.
      529   end procedure.
      530   procedure gen-key-field :
      531     define input  parameter p-table      as character no-undo .
      532     define output parameter p-field-list as character no-undo .
      533     do
      534     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      535     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      536     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      537     :
      538       define variable v-full-tbl-name  as character no-undo .
      539       define variable bh_tbl-name      as handle    no-undo .
      540       define variable v-tbl-name       as character no-undo .
      541       define variable v-field-num      as integer   no-undo .
      542       define variable v-count-fld      as integer   no-undo .
      543       define variable v-inform         as character no-undo .
      544       define variable v-ind            as integer   no-undo .
      545       define variable v-idx-field-qnty as integer   no-undo .
      546       define variable v-delim-key      as character no-undo .
      547       if p-table = ?
      548         or p-table = "":U
      549       then do:
      550         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info0 ).
      551       end.
      552       assign
      553         v-tbl-name      = p-table
      554         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      555       .
      556       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      557       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info0 ).
      558       assign
      559         v-inform = bh_tbl-name:index-information(1)
      560         v-ind    = 2
      561       .
      562       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      563       on error undo, return error
      564       :
      565         assign
      566           v-inform = bh_tbl-name:index-information( v-ind )
      567           v-ind    = v-ind + 1
      568         .
      569       end.
      570       if v-inform = ?
      571         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      572         or entry( 3, v-inform, ",":U ) <> "1":U
      573       then do:
      574         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, v-tbl-name ).
      575       end.
      576       assign
      577         v-idx-field-qnty = num-entries( v-inform ) - 4
      578       .
      579       if v-idx-field-qnty < 2 then do:
      580         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, v-tbl-name ).
      581       end.
      582       assign
      583         p-field-list = "":U
      584         v-delim-key  = "":U
      585         v-count-fld  = 0
      586       .
      587       block_where:
      588       do v-ind = 1 to v-idx-field-qnty by 2
      589       on error undo, return error
      590       :
      591         assign
      592           v-count-fld = v-count-fld + 1
      593         .
      594         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      595         if v-ind = 1 then do:
      596           assign
      597             v-delim-key = chr(3)
      598           .
      599         end.
      600       end.
      601       delete object bh_tbl-name.
      602     end.
      603   end procedure.
      604   define variable v-mess as character no-undo .
      605   define variable v-entry as character no-undo .
      606   define variable v-cmp as logical no-undo .
      607   define variable v-uniq-key-rec as character no-undo .
      608   define variable v-rec-ord as integer no-undo .
      609   define buffer buf_ruleset for dictdb.ruleset.
      610   define buffer buf_rule-by-call for dictdb.rule-by-call.
      611   define buffer buf_rule-profile for ub.rule-profile.
      612   define buffer buf_rule for dictdb.rule.
      613   define temp-table temp-rule-by-call no-undo like ub.rule-by-call.
      614   if p-mode <> 'ДОБАВЛЕНИЕ':U
      615   and p-mode <> 'ИЗМЕНЕНИЕ':U
      616   then do:
      617     message vss-workfile vss-revision vss-description skip
      618             "Неверный параметр p-mode - " p-mode
      619     view-as alert-box error .
      620     return error '':u.
      621   end.
      622   _main:
      623   do for buf_ruleset
      624   on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      625   on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
      626   on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
      627   :
      628     find first buf_ruleset no-lock where
      629               buf_ruleset.codex_id = p-codex-id
      630           and buf_ruleset.ruleset_id = p-ruleset-id no-error.
      631     if not available buf_ruleset then do:
      632       assign
      633       v-mess = "Не найден набор правил".
      634       run err-mess in this-procedure ( input-output v-mess).
      635       return error (if p-silent = yes then v-mess else '':U).
      636     end.
      637     find first buf_rule-profile no-lock where
      638             buf_rule-profile.profile_id = p-profile-id no-error.
      639     if not available buf_rule-profile then do:
      640       assign
      641       v-mess = "Не найден профайл".
      642       run err-mess in this-procedure ( input-output v-mess).
      643       return error (if p-silent = yes then v-mess else '':U).
      644     end.
      645     find first buf_rule no-lock where
      646               buf_rule.rule_id = p-rule-id no-error.
      647     if not available buf_rule then do:
      648       assign
      649       v-mess = "Не найдено правило c таким №".
      650       run err-mess in this-procedure ( input-output v-mess).
      651       return error (if p-silent = yes then v-mess else '':U).
      652     end.
      653     find first buf_rule exclusive-lock where
      654               buf_rule.rule_id = p-rule-id no-error.
      655     if buf_rule.sts = integer('-10':U)
      656     or buf_rule.sts = integer('1':U)
      657     or buf_rule.sts = integer('99':U)
      658     or buf_rule.sts = integer('98':U) then do:
      659       assign
      660       v-mess = substitute("Правило находится в статусе &1", entry (lookup (string( buf_rule.sts), '-1,-10,0,1,99,98':U), 'готов,нов,исп,удал,удаление,запр.удал':U)).
      661       run err-mess in this-procedure ( input-output v-mess).
      662       return error (if p-silent = yes then v-mess else 'sts':U).
      663     end.
      664     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      665       find first buf_rule-by-call no-lock where
      666                 buf_rule-by-call.call#_id = p-call#-id
      667             and buf_rule-by-call.codex_id = p-codex-id
      668             and buf_rule-by-call.ruleset_id = p-ruleset-id
      669             and buf_rule-by-call.order_id = p-order-id   no-error.
      670       if available buf_rule-by-call
      671       then do:
      672         assign
      673         v-mess = "Уже есть такая привязка правила к точке вызова".
      674         run err-mess in this-procedure ( input-output v-mess).
      675         return error (if p-silent = yes then v-mess else '':U).
      676       end.
      677       create buf_rule-by-call.
      678       assign
      679       buf_rule-by-call.call#_id = p-call#-id
      680       buf_rule-by-call.call_id = p-call-id
      681       buf_rule-by-call.codex_id = p-codex-id
      682       buf_rule-by-call.ruleset_id = p-ruleset-id
      683       buf_rule-by-call.order_id = p-order-id
      684       buf_rule-by-call.uniq-key-rec = v-uniq-key-rec
      685       p-rec = recid(buf_rule-by-call)
      686       .
      687       run gen-key-rec in this-procedure ( input 'rule-by-call':U
      688                                       ,input buffer buf_rule-by-call:handle
      689                                       ,output v-uniq-key-rec).
      690     end.
      691     if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      692       find first buf_rule-by-call exclusive-lock where
      693                 recid(buf_rule-by-call) = p-rec .
      694       if buf_rule-by-call.codex_id <> p-codex-id
      695       or buf_rule-by-call.ruleset_id <> p-ruleset-id
      696       or buf_rule-by-call.call_id <> p-call-id
      697       or buf_rule-by-call.call#_id <> p-call#-id
      698       or buf_rule-by-call.order_id <> p-order-id
      699       then do:
      700         assign
      701         v-mess = substitute("Для уже существующей привязки правила невозможно изменение кодекса и набора правил&1" +
      702                             "идентификатора точки вызова и порядка вызова&1" +
      703                             "старые значения идентификатора точки вызова, кодекса, набора правил и порядка вызова:&1" +
      704                             "&2(&3) &4 &5 &6"
      705                             , chr(10)
      706                             , buf_rule-by-call.call#_id
      707                             , buf_rule-by-call.call_id
      708                             , buf_rule-by-call.codex_id
      709                             , buf_rule-by-call.ruleset_id
      710                             , buf_rule-by-call.order_id
      711                             )
      712         .
      713         run err-mess in this-procedure ( input-output v-mess).
      714         return error (if p-silent = yes then v-mess else '':U).
      715       end.
      716     end.
      717     create temp-rule-by-call.
      718     buffer-copy buf_rule-by-call to temp-rule-by-call.
      719     assign
      720     buf_rule-by-call.profile_id = p-profile-id
      721     buf_rule-by-call.once-more = p-once-more
      722     buf_rule-by-call.rule_id = p-rule-id
      723     buf_rule-by-call.is_dynamic  = p-is-dynamic
      724     buf_rule-by-call.can-calc  = p-can-calc
      725     buf_rule-by-call.algo-des  = p-algo-des
      726     .
      727     if buf_rule.sts <> integer('0':U) then do:
      728       buf_rule.sts = integer('0':U).
      729     end.
      730     buffer-compare buf_rule-by-call to temp-rule-by-call save result in v-cmp.
      731     if  valid-handle(p-cmd-proc-handle)
      732     and (p-mode = 'ДОБАВЛЕНИЕ':U
      733         or v-cmp = no )
      734     then do:
      735       run add-dump in p-cmd-proc-handle
      736         (input p-cmd-code
      737         ,input 'rule-by-call':U
      738         ,input '+update'
      739         ,input buffer buf_rule-by-call:handle
      740         ,input '':U
      741         ,output v-rec-ord
      742         ) no-error .
      743       if error-status :error
      744       then do:
      745         v-mess = substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"
      746                                             ,vss-workfile
      747                                             ,vss-revision
      748                                             ,vss-description
      749                                             ,chr(10)
      750                                             ,'rule-by-call':U
      751                                             ,p-cmd-code
      752                                             ,error-status:get-message(1)
      753                                             ,return-value
      754                                             ) .
      755         run err-mess in this-procedure ( input-output v-mess).
      756         undo _main, return error (if p-silent = yes then v-mess else '':U).
      757       end.
      758     end.
      759     p-rec = recid(buf_rule-by-call).
      760   end.
      761   PROCEDURE err-mess:
      762     DEFINE INPUT-OUTPUT PARAMETER p-mess as character No-UNDO.
      763     CASE p-silent:
      764       when yes then do:
      765         assign
      766         p-mess = substitute("rule-by-call идент точки вызова &1(&2) кодекс &3 набор &4 порядок вызова &5&6:&7"
      767                            , p-call#-id
      768                            , p-call-id
      769                            , p-codex-id
      770                            , p-ruleset-id
      771                            , p-order-id
      772                            , chr(10)
      773                            , p-mess)
      774         .
      775       end.
      776       when no then do:
      777         message
      778         p-mess
      779         view-as alert-box error .
      780       end.
      781     end.
      782   END PROCEDURE.
