     1649   procedure get-header-by-rec :
     1650   define input  parameter p-gate-rec as character no-undo .
     1651   define output parameter p-tth as handle no-undo .
     1652   define variable v-ii as integer   no-undo .
     1653   define variable glog as logical   no-undo .
     1654   define variable v-rowid as rowid no-undo .
     1655   define variable v-tbl-name as character no-undo .
     1656   define variable v-longchar as longchar no-undo .
     1657   define variable v-txmlh as handle no-undo .
     1658   define buffer buf_clob-data for ub.clob-data.
     1659   main-block:
     1660   do
     1661   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info14, return-value, chr(10), error-status :get-message (1))
     1662   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info14 )
     1663   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info14 )
     1664   :
     1665     run gen-row-keyr in  this-procedure  (
     1666                                           input  p-gate-rec
     1667                                           ,input  ?
     1668                                           ,input  "ub"
     1669                                           ,input  ?
     1670                                           ,input  NO-LOCK
     1671                                           ,output v-rowid
     1672                                           ,output v-tbl-name   ) no-error.
     1673       find first buf_clob-data no-lock where
     1674                 rowid(buf_clob-data) = v-rowid  no-error.
     1675       if not available buf_clob-data then do:
     1676         undo, return error substitute("Не найден CLOB  &1"
     1677                                         , p-gate-rec
     1678                                         ).
     1679       end.
     1680       assign
     1681       v-longchar = buf_clob-data.cdata
     1682       .
     1683       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1684       if error-status :error then do:
     1685         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1686       end.
     1687       create temp-table p-tth .
     1688       glog = p-tth:READ-XMLSCHEMA( "LONGCHAR"
     1689                                     , v-longchar
     1690                                     , ?
     1691                                     , ?
     1692                                     , ?
     1693                                     ) no-error.
     1694       v-longchar = '':U.
     1695       define variable v-esm as character no-undo .
     1696       v-esm = error-status:get-message(1).
     1697       if error-status :error
     1698       or not glog
     1699       then do:
     1700         delete object p-tth no-error.
     1701         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     1702                                    , p-gate-rec
     1703                                    , buf_clob-data.file-name_
     1704                                    , chr(10)
     1705                                    , v-esm
     1706                                     ).
     1707       end.
     1708   end.
     1709   end procedure.
     1710   // { bge/getoxmlh.i } 23/VIII-2018 xmllib.i и tmpcxmlh.i вставлены напрямую
     1711   define variable vss-include-info15 as character format "X(65)" no-undo
     1712   initial "@(#)$Workfile$ $Revision$".
     1713   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1714   define stream stmXMLOut.
     1715   define stream stmXMLLog.
     1716   define stream strXMLIn.
     1717   define temp-table temp_xmllib_rec-list no-undo
