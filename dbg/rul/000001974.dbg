     3254   procedure xmlchar-decode :
     3255   define input parameter p-in-string      as character        no-undo.
     3256   define output parameter p-out-string    as character        no-undo.
     3257       define variable v-position      as integer      no-undo.
     3258       define variable v-last-position as integer      no-undo.
     3259       define variable v-temp-integer  as integer      no-undo.
     3260       define variable v-current-char  as character    no-undo.
     3261       define variable v-next-char     as character    no-undo.
     3262       define variable v-success       as logical      no-undo.
     3263   do
     3264   on error undo, return error
     3265   :
     3266       assign
     3267           p-out-string = "":U
     3268           v-position   = 0
     3269       .
     3270       replace-cycle:
     3271       do while yes
     3272       on error undo, return error
     3273       :
     3274           assign
     3275               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     3276           .
     3277           if v-last-position <= v-position
     3278           then do:
     3279               if v-position = 0
     3280               then do:
     3281                   assign
     3282                       p-out-string = p-in-string
     3283                   .
     3284               end.
     3285               else do:
     3286                   assign
     3287                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     3288                   .
     3289               end.
     3290               leave replace-cycle.
     3291           end.
     3292           else do:
     3293               assign
     3294                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     3295                   v-position      = v-last-position
     3296                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     3297               .
     3298               if v-current-char = "#":U
     3299               then do:
     3300                   assign
     3301                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     3302                   .
     3303                   if v-last-position > 0
     3304                   then do:
     3305                       run xmlchar-read-integer in this-procedure
     3306                        (
     3307                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     3308                           , output v-temp-integer
     3309                           , output v-success
     3310                       ).
     3311                       if v-success = yes
     3312                       and v-temp-integer >= 1
     3313                       and v-temp-integer <= 255
     3314                       then do:
     3315                           assign
     3316                               p-out-string = p-out-string + chr( v-temp-integer )
     3317                               v-position   = v-last-position + 1
     3318                           .
     3319                       end.
     3320                       else do:
     3321                           assign
     3322                               p-out-string = p-out-string + "&":U
     3323                               v-position   = v-position   + 1
     3324                           .
     3325                       end.
     3326                   end.
     3327                   else do:
     3328                       assign
     3329                           p-out-string = p-out-string + "&":U
     3330                           v-position   = v-position   + 1
     3331                       .
     3332                   end.
     3333               end.
     3334               else do:
     3335                   case substring( p-in-string, v-position + 1, 3 )
     3336                   :
     3337                       when "lt;":U
     3338                       then do:
     3339                           assign
     3340                               p-out-string = p-out-string + "<":U
     3341                               v-position   = v-position   + 3
     3342                           .
     3343                       end.
     3344                       when "gt;":U
     3345                       then do:
     3346                           assign
     3347                               p-out-string = p-out-string + ">":U
     3348                               v-position   = v-position   + 3
     3349                           .
     3350                       end.
     3351                       otherwise do:
     3352                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     3353                           then do:
     3354                               assign
     3355                                   p-out-string = p-out-string + "&":U
     3356                                   v-position   = v-position   + 4
     3357                               .
     3358                           end.
     3359                           else do:
     3360                               case substring( p-in-string, v-position + 1, 5 )
     3361                               :
     3362                                   when "quot;":U
     3363                                   then do:
     3364                                       assign
     3365                                           p-out-string = p-out-string + '"':U
     3366                                           v-position   = v-position   + 5
     3367                                       .
     3368                                   end.
     3369                                   when "apos;":U
     3370                                   then do:
     3371                                       assign
     3372                                           p-out-string = p-out-string + "'":U
     3373                                           v-position   = v-position   + 5
     3374                                       .
     3375                                   end.
     3376                                   otherwise do:
     3377                                       assign
     3378                                           p-out-string = p-out-string + "&":U
     3379                                       .
     3380                                   end.
     3381                               end case.
     3382                           end.
     3383                       end.
     3384                   end case.
     3385               end.
     3386           end.
     3387       end.
     3388   end.
     3389   end .
     3390   procedure xmlchar-read-integer :
     3391   define input parameter p-input-string      as character        no-undo.
     3392   define output parameter p-output-integer   as integer          no-undo.
     3393   define output parameter p-success       as logical          no-undo.
     3394   do
     3395   on error undo, return error
     3396   :
     3397       assign
     3398           p-output-integer = integer( p-input-string )
     3399       no-error.
     3400       if error-status :error
     3401       then do:
     3402           assign
     3403               p-success           = no
     3404               p-output-integer    = 0
     3405           .
     3406       end.
     3407       else do:
     3408           assign
     3409               p-success           = yes
     3410           .
     3411       end.
     3412   end.
     3413   end.
     3414   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3415   define temp-table temp-rel-handle no-undo
     3416   field dh as handle
     3417   field ii as integer
     3418   field active_ as logical
     3419   field child-buffer_ as character
     3420   field parent-buffer_ as character
     3421   field child-buffer-handle as handle
     3422   field parent-buffer-handle as handle
     3423   field name_ as character
     3424   field nested_ as logical
     3425   field relation-fields_ as character
     3426   field reposition_ as logical
     3427   field type_ as character
     3428   field query_ as handle
     3429   field where-string_ as character
     3430   field tbl-handle_ as handle
     3431   index pi is unique primary
     3432   ii
     3433   index iparentname parent-buffer_ child-buffer_
     3434   index iparenthandle parent-buffer-handle child-buffer-handle
     3435   .
     3436   procedure tmpreldf_get-relations :
     3437   define input parameter p-dataseth as handle no-undo .
     3438   define variable v-ii as integer no-undo .
     3439   define buffer buf_temp-rel-handle for temp-rel-handle.
     3440   do
     3441   on error undo, return error
     3442   :
     3443     if not valid-handle(p-dataseth)
     3444     or p-dataseth:type <> "DATASET"
     3445     then do:
     3446       return error substitute("Не определен dataset с handle &1", p-dataseth).
     3447     end.
     3448     for each buf_temp-rel-handle where
     3449             buf_temp-rel-handle.dh = p-dataseth:
     3450       delete buf_temp-rel-handle.
     3451     end.
     3452     do v-ii = 1 to p-dataseth:num-relations:
     3453       create buf_temp-rel-handle.
     3454       assign
     3455       buf_temp-rel-handle.ii = v-ii
     3456       buf_temp-rel-handle.dh = p-dataseth
     3457       buf_temp-rel-handle.active_ = p-dataseth:get-relation(v-ii):active
     3458       buf_temp-rel-handle.child-buffer_ = p-dataseth:get-relation(v-ii):child-buffer:name
     3459       buf_temp-rel-handle.parent-buffer_ = p-dataseth:get-relation(v-ii):parent-buffer:name
     3460       buf_temp-rel-handle.child-buffer-handle = p-dataseth:get-relation(v-ii):child-buffer
     3461       buf_temp-rel-handle.tbl-handle_ = buf_temp-rel-handle.child-buffer-handle
     3462       buf_temp-rel-handle.parent-buffer-handle = p-dataseth:get-relation(v-ii):parent-buffer
     3463       buf_temp-rel-handle.name_ = p-dataseth:get-relation(v-ii):name
     3464       buf_temp-rel-handle.nested_ = p-dataseth:get-relation(v-ii):nested
     3465       buf_temp-rel-handle.relation-fields_ = p-dataseth:get-relation(v-ii):relation-fields
     3466       buf_temp-rel-handle.reposition_ = p-dataseth:get-relation(v-ii):reposition
     3467       buf_temp-rel-handle.type_ = p-dataseth:get-relation(v-ii):type
     3468       buf_temp-rel-handle.query_ = p-dataseth:get-relation(v-ii):query
     3469       buf_temp-rel-handle.where-string_ = p-dataseth:get-relation(v-ii):where-string
     3470       .
     3471     end.
     3472   end.
     3473   end procedure.
     3474   procedure tmpreldf_set-relations :
     3475   define input parameter p-srcdataseth as handle no-undo .
     3476   define input parameter p-trgdataseth as handle no-undo .
     3477   define variable gh as handle no-undo .
     3478   define buffer buf_temp-rel-handle for temp-rel-handle.
     3479   do
     3480   on error undo, return error
     3481   :
     3482     if not valid-handle(p-srcdataseth)
     3483     or p-srcdataseth:type <> "DATASET"
     3484     then do:
     3485       return error substitute("Не определен dataset-источник с handle &1", p-srcdataseth).
     3486     end.
     3487     if not valid-handle(p-trgdataseth)
     3488     or p-trgdataseth:type <> "DATASET"
     3489     then do:
     3490       return error substitute("Не определен dataset-приемник с handle &1", p-trgdataseth).
     3491     end.
     3492     for each buf_temp-rel-handle no-lock where
     3493             buf_temp-rel-handle.dh = p-srcdataseth
     3494     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3495     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     3496     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     3497     :
     3498       gh = p-trgdataseth:ADD-RELATION ( buf_temp-rel-handle.parent-buffer-handle
     3499                                         , buf_temp-rel-handle.child-buffer-handle
     3500                                         , buf_temp-rel-handle.relation-fields_
     3501                                         , buf_temp-rel-handle.reposition_
     3502                                         , buf_temp-rel-handle.nested_).
     3503      if error-status:error
     3504      or not valid-handle(gh) then do:
     3505        undo, return error substitute("Ошибка при добавлении relation &1 в dataset &2", buf_temp-rel-handle.name, p-trgdataseth:name).
     3506      end.
     3507     end.
     3508   end.
     3509   end procedure.
     3510   procedure tmpreld2_query :
     3511   define  parameter buffer buf_temp-rel-handle for temp-rel-handle.
     3512   define input-output parameter p-child-qh as handle no-undo .
     3513   define variable glog as logical no-undo .
     3514   define variable v-mess as character no-undo .
     3515   _main:
     3516   do
     3517   on error undo, return error
     3518   :
     3519     create query p-child-qh .
     3520     glog = p-child-qh:set-buffers( buf_temp-rel-handle.child-buffer-handle) no-error.
     3521     if error-status:error
     3522     or
     3523     not glog then do:
     3524       v-mess = substitute("Ошибка при попытке получить записи &1&2&3"
     3525                           , buf_temp-rel-handle.child-buffer_
     3526                           , chr(10)
     3527                           , error-status:get-message(1)
     3528                           ).
     3529       delete object p-child-qh no-error.
     3530       undo _main, return error v-mess.
     3531     end.
     3532     glog = p-child-qh:query-prepare( substitute( "for each &1 &2 "
     3533                                               , buf_temp-rel-handle.child-buffer_
     3534                                               , buf_temp-rel-handle.where-string_
     3535                                               )) no-error .
     3536     if error-status:error
     3537     or
     3538     not glog then do:
     3539       v-mess =  substitute("Ошибка при попытке получить записи &1&2&3"
     3540                           , buf_temp-rel-handle.child-buffer_
     3541                           , chr(10)
     3542                           , error-status:get-message(1)
     3543                           ).
     3544       delete object p-child-qh no-error.
     3545       undo _main, return error v-mess.
     3546     end.
     3547     glog = p-child-qh:query-open no-error .
     3548     if error-status:error
     3549     or
     3550     not glog then do:
     3551       v-mess = substitute("Ошибка при попытке получить записи &1&2&3"
     3552                           , buf_temp-rel-handle.child-buffer_
     3553                           , chr(10)
     3554                           , error-status:get-message(1)
     3555                           ).
     3556       delete object p-child-qh no-error.
     3557       undo _main, return error v-mess.
     3558     end.
     3559   end.
     3560   end procedure.
     3561   define variable v-current-cli-type as character no-undo .
     3562   define variable v-current-cli-code as integer no-undo .
     3563   define variable v-current-cli-name as character no-undo .
     3564   define variable v-current-host-code as integer no-undo .
     3565   define variable v-current-obj-type as character no-undo .
     3566   define variable v-current-obj-code as integer no-undo .
     3567   define variable v-current-lock as integer no-undo .
     3568   define variable v-current-wait as integer no-undo .
