     3602   define buffer buf_temp-cmd for temp-cmd.
     3603   define shared temp-table tt0-rule-call-param no-undo like ub.rule-call-param.
     3604   define temp-table temp-clients_ no-undo like ub.clients.
     3605   define temp-table temp-firm_ no-undo like ub.firm.
     3606   define temp-table temp-person_ no-undo like ub.person.
     3607   define temp-table temp-staff no-undo like ub.staff.
     3608   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3609   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3610   FUNCTION gbclcode-is-this-db-code returns logical ( input p-db-num as integer
     3611                                                       ,input p-range-type as character
     3612                                                       ,input p-code as integer):
     3613   define variable v-seq-val as integer no-undo .
     3614   define buffer buf_code-range for ub.code-range.
     3615   find first buf_code-range no-lock where
     3616             buf_code-range.db-num = p-db-num
     3617       and  buf_code-range.range-type = p-range-type
     3618       and  buf_code-range.stts = 'u'
     3619       and buf_code-range.first-code <= p-code
     3620       and buf_code-range.last-code >= p-code no-error .
     3621   if available buf_code-range then return yes.
     3622   CASE p-range-type:
     3623     when 'pngb':U then do:
     3624       v-seq-val = current-value(s-pngb-code, ub).
     3625     end.
     3626     when 'fmgb':U then do:
     3627       v-seq-val = current-value(s-fmgb-code, ub).
     3628     end.
     3629   END CASE.
     3630   if p-code <= v-seq-val then do:
     3631     find first buf_code-range no-lock where
     3632               buf_code-range.db-num = p-db-num
     3633         and  buf_code-range.range-type = p-range-type
     3634         and  buf_code-range.stts = 'a'
     3635         and buf_code-range.first-code <= p-code
     3636         no-error .
     3637    if available buf_code-range then return yes.
     3638   end.
     3639   find first buf_code-range no-lock where
     3640             buf_code-range.db-num = p-db-num
     3641       and  buf_code-range.range-type = p-range-type
     3642       and  buf_code-range.stts = 'f'
     3643       and buf_code-range.first-code <= p-code
     3644       and buf_code-range.last-code >= p-code
     3645       no-error .
     3646   if available buf_code-range then return yes.
     3647   return no.
     3648   END FUNCTION.
     3649   FUNCTION gbclcode-is-this-db-code-short returns logical ( input p-db-num as integer
     3650                                                       ,input p-range-type as character
     3651                                                       ,input p-code as integer):
     3652   define variable v-seq-val as integer no-undo .
     3653   define buffer buf_code-range for ub.code-range.
     3654   CASE p-range-type:
     3655     when 'pngb':U then do:
     3656       v-seq-val = current-value(s-pngb-code, ub).
     3657     end.
     3658     when 'fmgb':U then do:
     3659       v-seq-val = current-value(s-fmgb-code, ub).
     3660     end.
     3661   END CASE.
     3662   if p-code <= v-seq-val then do:
     3663     find first buf_code-range no-lock where
     3664               buf_code-range.db-num = p-db-num
     3665         and  buf_code-range.range-type = p-range-type
     3666         and buf_code-range.first-code <= p-code
     3667         and buf_code-range.last-code >= p-code no-error .
     3668     if available buf_code-range then return yes.
     3669   end.
     3670   return no.
     3671   END FUNCTION.
     3672   FUNCTION gbclcode-is-this-db-role returns integer ( input p-role as character
     3673                                                       ,input p-db-num as integer
     3674                                                       ,input p-staff-code as integer
     3675                                                       ,input p-date as date
     3676                                                        ):
     3677   define buffer buf_staff for ub.staff.
     3678   if p-date = ? then do:
     3679     p-date = today .
     3680   end.
     3681   find first buf_staff no-lock where
     3682             buf_staff.role = p-role
     3683         and buf_staff.role-level = 'db':U
     3684         and buf_staff.db-num = p-db-num
     3685         and buf_staff.staff-code = p-staff-code
     3686         and buf_staff.date-end >= p-date use-index pi  no-error .
     3687   if available buf_staff then do:
     3688     return buf_staff.psn-code.
     3689   end.
     3690   return 0.
     3691   end FUNCTION.
     3692   FUNCTION gbclcode-get-this-db-first-role returns integer ( input p-role as character
     3693                                                             ,input p-db-num as integer
     3694                                                             ,input p-date as date
     3695                                                                 ):
     3696   define buffer buf_staff for ub.staff.
     3697   define buffer buf2_staff for ub.staff.
     3698   if p-date = ? then do:
     3699     p-date = today .
     3700   end.
     3701   for each  buf_staff no-lock where
     3702             buf_staff.role = p-role
     3703         and buf_staff.db-num = p-db-num,
     3704   first buf2_staff no-lock where
     3705         buf2_staff.role = p-role
     3706     and buf2_staff.role-level = 'db':U
     3707     and buf2_staff.staff-code = buf_staff.staff-code
     3708     and buf2_staff.date-start <= p-date
     3709     and buf2_staff.date-end >= p-date
     3710   by buf_staff.staff-code
     3711   by date-start descending:
     3712     return buf_staff.staff-code.
     3713   end.
     3714   end FUNCTION.
     3715   FUNCTION gbclcode-get-db-role returns integer ( input p-role as character
     3716                                                  ,input p-db-num as integer
     3717                                                  ,input p-psn-code as integer
     3718                                                  ,input p-date as date
     3719                                                  ,output p-c-password as character
     3720                                                        ):
     3721   define buffer buf_staff for ub.staff.
     3722   if p-date = ? then do:
     3723     p-date = today .
     3724   end.
     3725   find first buf_staff no-lock where
     3726             buf_staff.role = p-role
     3727         and buf_staff.role-level = 'db':U
     3728         and buf_staff.db-num = p-db-num
     3729        and buf_staff.date-end >= p-date
     3730        and buf_staff.psn-code = p-psn-code use-index irole-psn no-error .
     3731   if available buf_staff
     3732   then do:
     3733     assign
     3734     p-c-password = buf_staff.password.
     3735     return buf_staff.staff-code.
     3736   end.
     3737   p-c-password = ''.
     3738   return 0.
     3739   end FUNCTION.
     3740   FUNCTION gbclcode-is-psn-role returns integer (
     3741                                                 input p-role as character
     3742                                                 ,input p-psn-code as integer
     3743                                                 ,input p-date as date
     3744                                                     ):
     3745   define buffer buf_staff for ub.staff.
     3746   if p-date = ? then do:
     3747     p-date = today .
     3748   end.
     3749   for each buf_staff no-lock where
     3750             buf_staff.psn-code = p-psn-code
     3751        and  buf_staff.role = p-role
     3752   by buf_staff.role-level
     3753   by buf_staff.date-start
     3754        :
     3755     if  buf_staff.date-start <= p-date and
     3756     buf_staff.date-end >= p-date  then do:
     3757       return buf_staff.staff-code.
     3758     end.
     3759   end.
     3760   return 0.
     3761   end FUNCTION.
     3762   FUNCTION gbclcode-get-role-name returns character ( input p-role as character):
     3763   define variable v-role-name as character no-undo .
     3764   assign
     3765   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
     3766   no-error .
     3767   return v-role-name.
     3768   END.
     3769   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3770   FUNCTION gbclcode-get-position returns character ( input p-role as character
     3771                                                     ,input p-role-level as character
     3772                                                     ,input p-work-place as character
     3773                                                     ,input p-staff-code as integer
     3774                                                                ):
     3775   define variable v-role-name as character no-undo .
     3776   define variable v-role-level as character no-undo .
     3777   define variable v-staff-code as integer no-undo .
     3778   assign
     3779   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
     3780   v-role-level = substitute("&1 &2", entry (lookup (p-role-level, 'global,db,firm,object':U) + 1, ',':U + 'Глобально,БД,Фирма,Объект':U) , p-work-place)
     3781   v-staff-code = p-staff-code
     3782   no-error .
     3783   return substitute("&1, &2, Код &3"
     3784                   ,v-role-name
     3785                   ,v-role-level
     3786                   ,(if p-staff-code = 0 then chr(63) else string(p-staff-code))).
     3787   END.
     3788   FUNCTION gbclcode-get-work-place returns character (
     3789                                                   input p-role as character
     3790                                                  ,input p-role-level as character
     3791                                                  ,input p-db-num as integer
     3792                                                  ,input p-host-code as integer
     3793                                                  ,input p-obj-type as character
     3794                                                  ,input p-obj-code as integer
     3795                                                  ) :
     3796   define variable v-work-place as character no-undo .
     3797   define variable v-obj-type as character no-undo .
     3798     case p-role-level:
     3799       when 'db':U then do:
     3800         v-work-place = string(p-db-num, "99999").
     3801       end.
     3802       when 'firm':U then do:
     3803         v-work-place = string(p-host-code, "99999").
     3804       end.
     3805       when 'object':U then do:
     3806         assign
     3807         v-work-place = p-obj-type + string(p-obj-code, "999999999")
     3808         .
     3809       end.
     3810     END CASE.
     3811     return v-work-place.
     3812   END FUNCTION.
     3813   FUNCTION gbclcode-get-level-last-code returns integer (
     3814                                                           input p-role as character
     3815                                                         , input p-role-level as character
     3816                                                         , input p-work-place as character
     3817                                                         , input p-date-start as date
     3818                                                         ):
     3819   DEFINE VARIABLE v-today as date no-undo .
     3820   define buffer buf_staff for ub.staff.
     3821   if p-work-place = chr(63) then return ?.
     3822   if p-date-start = ? then do:
     3823     v-today = today .
     3824   end.
     3825   else do:
     3826     v-today = p-date-start.
     3827   end.
     3828   find last buf_staff no-lock where
     3829             buf_staff.role = p-role
     3830        and  buf_staff.role-level = p-role-level
     3831        and  buf_staff.work-place = p-work-place
     3832        and  buf_staff.date-start <= v-today + 1
     3833        and  buf_staff.date-end >= v-today + 1
     3834        use-index pi  no-error .
     3835   if available buf_staff
     3836   then return buf_staff.staff-code.
     3837   return 0.
     3838   end FUNCTION.
     3839   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3840   PROCEDURE request-proc-save-staff :
     3841   DEFINE INPUT PARAMETER p-child-handle AS HANDLE NO-UNDO.
     3842   define input parameter p-mode as character no-undo .
     3843   define input parameter p-callpoint as character no-undo .
     3844   define buffer buf_tt-staff for temp-staff.
     3845   IF p-mode <> 'ДОБАВЛЕНИЕ':U
     3846   OR LOOKUP(p-callpoint , 'C,S':U) = 0 THEN RETURN.
     3847   for each buf_tt-staff :
     3848       RUN proc-save-staff IN p-child-handle (
     3849                                              INPUT buf_tt-staff.role
     3850                                             ,INPUT buf_tt-staff.staff-code
     3851                                             ,INPUT buf_tt-staff.role-level
     3852                                             ,INPUT buf_tt-staff.db-num
     3853                                             ,INPUT buf_tt-staff.host-code
     3854                                             ,INPUT buf_tt-staff.obj-type
     3855                                             ,INPUT buf_tt-staff.obj-code
     3856                                             ,INPUT buf_tt-staff.password
     3857                                             ,input buf_tt-staff.date-start
     3858                                             ,input buf_tt-staff.date-end
     3859                                             ,input buf_tt-staff.work-place
     3860                                               ) NO-ERROR.
     3861       IF ERROR-STATUS:ERROR THEN DO:
     3862         UNDO, RETURN ERROR RETURN-VALUE.
     3863       END.
     3864   END.
     3865   END PROCEDURE.
     3866   define buffer buf_temp-xml-tables for temp-xml-tables.
     3867   function 00120003_get-error-message returns character :
     3868   define variable v-ii as integer no-undo .
     3869   define variable v-mess as character no-undo .
     3870   DO v-ii = 1 TO ERROR-STATUS:NUM-MESSAGES:
     3871       v-mess = substitute("&1&2ош &3"
     3872                           ,v-mess
     3873                           ,chr(10)
     3874                           ,ERROR-STATUS:GET-MESSAGE(v-ii)).
     3875   END.
     3876   return v-mess.
     3877   end function.
     3878   function 00120003_after-import_f returns logical ( input p-cli-type as character, input p-cli-code as integer):
     3879     run 00120003_after-import in this-procedure ( input p-cli-type, input p-cli-code) no-error.
     3880     run set-error in this-procedure ( input return-value ).
     3881     return not (error-status:error).
     3882   end function.
     3883   define variable p-xsd-file as character no-undo.
     3884   on delete of this-procedure do:
     3885     run delete-procedure in this-procedure .
     3886     run gate-clear in this-procedure ( input v_dataseth, input v-xmlh) no-error.
     3887   end.
     3888   run load-ruleset-context in this-procedure ( input p-ruleset-id) no-error .
     3889   if error-status:error
     3890   or return-value = "return" then return.
     3891   define variable ImpData1 as class Route-data_ no-undo .
     3892   ImpData1 = new Route-data_( input parparentproc, input p-parent-handle, input p-log-handle, input this-procedure:handle, input v_dataseth, input v-xmlh) .
     3893   if not this-procedure:persistent then do:
     3894     run proc-main in this-procedure no-error .
     3895     if error-status:error then do:
     3896         run delete-procedure in this-procedure .
     3897         undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     3898     end.
     3899     run delete-procedure in this-procedure .
     3900   end.
     3901   procedure proc-main :
     3902   define variable v-current-upper-node-code as integer no-undo .
     3903   define variable v-current-node-name as character no-undo .
     3904   define variable v-rid as recid no-undo .
     3905   define variable v-current-tbl-name as character no-undo .
     3906   define variable glog as logical no-undo .
     3907   define variable v_child-qh as handle no-undo .
     3908   define variable v-current-firm-code as integer no-undo .
     3909   define variable v-current-psn-code as integer no-undo .
     3910   define buffer buf_clients for ub.clients.
     3911   define buffer buf_temp-clients_ for temp-clients_.
     3912   define buffer buf_temp-firm_ for temp-firm_.
     3913   define buffer buf_temp-person_ for temp-person_.
     3914   define buffer buf_temp-rel-handle for temp-rel-handle.
     3915   _main:
     3916   do
     3917   on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3918   on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
     3919   on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
     3920   :
     3921   run write-log  in p-log-handle (
     3922                                    input 0
     3923                                  , "&DLine").
     3924   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Импорт данных по клиентам из файла &1", file-name)).
     3925   run tmpreldf_get-relations in this-procedure ( input  v_dataseth).
     3926   for each buf_temp-xml-tables where
     3927           buf_temp-xml-tables.order >= 0
     3928       and buf_temp-xml-tables.is-parent = yes
     3929           :
     3930     if buf_temp-xml-tables.tbl-name = "THheader" then next.
     3931     create query v_qh.
     3932     glog = v_qh:set-buffers( buf_temp-xml-tables.tbl-handle_) no-error.
     3933     if error-status:error
     3934     or
     3935     not glog then do:
     3936           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при попытке получить записи &1&2&3&2&4"                                 , buf_temp-xml-tables.tbl-name                                 , chr(10)                                 , error-status:get-message(1)                                 , return-value)).
     3937       v-view-log = yes.
     3938       undo _main, return error ''.
     3939     end.
     3940     glog = v_qh:query-prepare( substitute( "for each &1 ", buf_temp-xml-tables.tbl-name)) no-error .
     3941     if error-status:error
     3942     or
     3943     not glog then do:
     3944           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при попытке получить записи &1&2&3&2&4"                                 , buf_temp-xml-tables.tbl-name                                 , chr(10)                                 , error-status:get-message(1)                                 , return-value)).
     3945       v-view-log = yes.
     3946       undo _main, return error ''.
     3947     end.
     3948     glog = v_qh:query-open no-error .
     3949     if error-status:error
     3950     or
     3951     not glog then do:
     3952           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при попытке получить записи &1&2&3&2&4"                               , buf_temp-xml-tables.tbl-name                               , chr(10)                               , error-status:get-message(1)                               , return-value)).
     3953       v-view-log = yes.
     3954       undo _main, return error ''.
     3955     end.
     3956       _stroka:
     3957       REPEAT:
     3958         if buf_temp-xml-tables.is-parent = yes then do:
     3959           num-rec = num-rec + 1.
     3960         end.
     3961         v-retry-action = 0 .
     3962        _release:
     3963         do on error undo, retry:
     3964           if  retry then do:
     3965             v-retry-action = v-retry-action + 1.
     3966                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при импорте записи &5 &1&2&3&2&4"                                     , buf_temp-xml-tables.tbl-name                                     , num-rec                                     , chr(10)                                     , error-status:get-message(1)                                     , return-value)).
     3967             v-view-log = yes.
     3968           end.
     3969         if v-retry-action < 1 then do:
     3970                   ImpData1:Route-data_dump ( ) .
     3971         end.
     3972         end.
     3973         _rule:
     3974          do on error undo _rule, retry _rule:
     3975            if retry then do:
     3976                        run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("&1&2&3"                                       , error-status:get-message(1)                                       , chr(10)                                       , return-value)).
     3977             v-view-log = yes.
     3978              next _stroka.
     3979            end.
     3980            else do:
     3981             v_qh:get-next().
     3982             IF v_qh:query-off-end then leave _stroka.
     3983             assign
     3984             v-current-tbl-name = ''
     3985             v-current-tbl-name = ImpData1:current-tbl-name( ) no-error .
     3986             case v-current-tbl-name :
     3987               when "clients-01"  THEN do:
     3988                 v-current-cli-type = ImpData1:route-data_get-field-character( input "clients-01", input "obj-type") .
     3989                 v-current-cli-code = ImpData1:route-data_get-field-integer( input "clients-01", input "obj-code") .
     3990                 v-current-cli-name = ImpData1:route-data_get-field-character( input "clients-01", input "obj-name") .
     3991                 find first buf_clients no-lock where
     3992                           buf_clients.obj-type = v-current-cli-type
     3993                       and buf_clients.obj-code = v-current-cli-code no-error.
     3994                 if available buf_clients then do:
     3995                                   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Уже есть клиент &1&2. Пропускаем ...", v-current-cli-type, v-current-cli-code)).
     3996                   next _stroka.
     3997                 end.
     3998                 find first buf_temp-clients_ where
     3999                           buf_temp-clients_.obj-type = v-current-cli-type
     4000                       and buf_temp-clients_.obj-code = v-current-cli-code no-error.
     4001                 if not available buf_temp-clients_ then do:
     4002                   create  buf_temp-clients_.
     4003                   assign
     4004                   buf_temp-clients_.obj-type = v-current-cli-type
     4005                   buf_temp-clients_.obj-code = v-current-cli-code
     4006                   .
     4007                 end.
     4008                 assign
     4009                 buf_temp-clients_.obj-name = v-current-cli-name
     4010                 .
     4011                 assign
     4012                 glog = buffer buf_temp-clients_:handle:buffer-copy(ImpData1:route-data_get-record("clients-01"), "obj-type,obj-code,obj-name") no-error.
     4013                 if not glog
     4014                 or error-status:error then do:
     4015                                   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не удалось получить данные записи <clients-01>: &1&2&3"                                               , error-status:get-message(1)                                               , chr(10)                                               , return-value)).
     4016                   next _stroka.
     4017                 end.
     4018                 _rel:
     4019                 for each buf_temp-rel-handle where
     4020                         buf_temp-rel-handle.parent-buffer_ = v-current-tbl-name:
     4021                   run tmpreld2_query in this-procedure ( buffer buf_temp-rel-handle, input-output v_child-qh) no-error.
     4022                   if error-status:error then do:
     4023                                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input return-value).
     4024                     undo _rule, retry _rule.
     4025                   end.
     4026                     _child:
     4027                     repeat:
     4028                     v_child-qh:get-next().
     4029                     IF v_child-qh:query-off-end then do:
     4030                       delete object v_child-qh no-error.
     4031                       next _rel.
     4032                     end.
     4033                     case buf_temp-rel-handle.child-buffer_:
     4034                       when "firm-01"
     4035                       THEN do:
     4036                         v-current-firm-code = ImpData1:route-data_get-field-integer( buffer buf_temp-rel-handle:handle, input buf_temp-rel-handle.child-buffer_ , input "firm-code") .
     4037                         find first buf_temp-firm_ where
     4038                                   buf_temp-firm_.firm = v-current-firm-code no-error.
     4039                         if not available buf_temp-firm_ then do:
     4040                           create  buf_temp-firm_.
     4041                           assign
     4042                           buf_temp-firm_.firm-code = v-current-firm-code
     4043                           .
     4044                         end.
     4045                         assign
     4046                         glog = buffer buf_temp-firm_:handle:buffer-copy(buf_temp-rel-handle.child-buffer-handle
     4047                                                                         ,"firm-code"
     4048                                                                       ) no-error.
     4049                         if not glog
     4050                         or error-status:error then do:
     4051                                                   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не удалось получить данные записи <&4>: &1&2&3"                                                     , error-status:get-message(1)                                                     , chr(10)                                                     , return-value                                                     , buf_temp-rel-handle.child-buffer_)).
     4052                           undo _rule, retry _rule.
     4053                         end.
     4054                         release buf_temp-firm_ .
     4055                       end.
     4056                       when "person-01"
     4057                       THEN do:
     4058                         v-current-psn-code = ImpData1:route-data_get-field-integer( buffer buf_temp-rel-handle:handle, input buf_temp-rel-handle.child-buffer_, input "psn-code") .
     4059                         find first buf_temp-person_ where
     4060                                   buf_temp-person_.psn-code = v-current-psn-code no-error.
     4061                         if not available buf_temp-person_ then do:
     4062                           create  buf_temp-person_.
     4063                           assign
     4064                           buf_temp-person_.psn-code = v-current-psn-code
     4065                           .
     4066                         end.
     4067                         assign
     4068                         glog = buffer buf_temp-person_:handle:buffer-copy(buf_temp-rel-handle.child-buffer-handle
     4069                                                                           ,"psn-code"
     4070                                                                                                         ) no-error.
     4071                         if not glog
     4072                         or error-status:error then do:
     4073                                                   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не удалось получить данные записи <&4>: &1&2&3"                                                     , error-status:get-message(1)                                                     , chr(10)                                                     , return-value                                                     , buf_temp-rel-handle.child-buffer_ )).
     4074                           undo _rule, retry _rule.
     4075                         end.
     4076                         release buf_temp-person_ .
     4077                       end.
     4078                     end case.
     4079                   end.
     4080                   delete object v_child-qh no-error.
     4081                 end.
     4082                 case v-current-cli-type:
     4083                   when 'орг':U then do:
     4084                     find first buf_temp-firm_ where
     4085                               buf_temp-firm_.firm-code = v-current-cli-code.
     4086                     run ref/firm1.p (
     4087                         input parparentproc
     4088                         ,input-output v-rid
     4089                         ,input 'ДОБАВЛЕНИЕ':U
     4090                         ,input "cli-all":U
     4091                         ,input yes
     4092                         ,input - abs(buf_temp-clients_.obj-code)
     4093                         ,input 0
     4094                         ,input buf_temp-clients_.obj-name
     4095                         ,input 0
     4096                         ,input "":U
     4097                         ,input buf_temp-clients_.grp-code
     4098                         ,input buf_temp-firm_.addres1
     4099                         ,input buf_temp-firm_.addres2
     4100                         ,input buf_temp-firm_.city
     4101                         ,input buf_temp-firm_.contact-psn
     4102                         ,input buf_temp-firm_.director
     4103                         ,input buf_temp-firm_.e-mail
     4104                         ,input buf_temp-firm_.engl-name
     4105                         ,input buf_temp-firm_.fax
     4106                         ,input buf_temp-firm_.given-by
     4107                         ,input buf_temp-firm_.ind
     4108                         ,input buf_temp-firm_.inn
     4109                         ,input no
     4110                         ,input buf_temp-firm_.is-pboul
     4111                         ,input buf_temp-firm_.kpp
     4112                         ,input buf_temp-firm_.okonh
     4113                         ,input buf_temp-firm_.okpo
     4114                         ,input buf_temp-firm_.passp-num
     4115                         ,input buf_temp-firm_.passp-ser
     4116                         ,input buf_temp-firm_.phone
     4117                         ,input buf_temp-firm_.phone1-note
     4118                         ,input buf_temp-firm_.post-addr1
     4119                         ,input buf_temp-firm_.post-addr2
     4120                         ,input buf_temp-firm_.post-city
     4121                         ,input buf_temp-firm_.post-ind
     4122                         ,input buf_temp-clients_.reg-code
     4123                         ,input buf_temp-firm_.telex
     4124                         ,input buf_temp-firm_.tobj-code
     4125                         ,input no
     4126                         ,input no
     4127                       ) no-error .
     4128                   end.
     4129                   when 'чел':U then do:
     4130                     find first buf_temp-person_ where
     4131                               buf_temp-person_.psn-code = v-current-cli-code.
     4132                     run ref/person1.p (
     4133                         input parparentproc
     4134                       ,input this-procedure:handle
     4135                       ,input-output v-rid
     4136                       ,input 'ДОБАВЛЕНИЕ':U
     4137                       ,input "cli-all":U
     4138                       ,input yes
     4139                       ,input - abs(buf_temp-clients_.obj-code)
     4140                       ,input 0
     4141                       ,input buf_temp-clients_.obj-name
     4142                       ,input 0
     4143                       ,input "":U
     4144                       ,input buf_temp-clients_.grp-code
     4145                       ,input buf_temp-person_.address
     4146                       ,input buf_temp-person_.city
     4147                       ,input buf_temp-person_.date-birth
     4148                       ,input buf_temp-person_.e-mail
     4149                       ,input buf_temp-person_.fax
     4150                       ,input buf_temp-person_.firm-code
     4151                       ,input buf_temp-person_.firm-name
     4152                       ,input buf_temp-person_.gender
     4153                       ,input buf_temp-person_.given-by
     4154                       ,input buf_temp-person_.ind
     4155                       ,input buf_temp-person_.inn
     4156                       ,input no
     4157                       ,input buf_temp-person_.is-pboul
     4158                       ,input buf_temp-person_.kpp
     4159                       ,input buf_temp-person_.name1
     4160                       ,input buf_temp-person_.name2
     4161                       ,input buf_temp-person_.okonh
     4162                       ,input buf_temp-person_.okpo
     4163                       ,input buf_temp-person_.passp-num
     4164                       ,input buf_temp-person_.passp-ser
     4165                       ,input buf_temp-person_.phone1
     4166                       ,input buf_temp-person_.phone1-note
     4167                       ,input buf_temp-person_.position
     4168                       ,input buf_temp-person_.post-box
     4169                       ,input buf_temp-person_.post-address
     4170                       ,input buf_temp-person_.post-city
     4171                       ,input buf_temp-person_.post-ind
     4172                       ,input buf_temp-clients_.reg-code
     4173                       ,input no
     4174                       ,input no
     4175                       ) no-error .
     4176                   end.
     4177                 end case.
     4178                 if available buf_temp-clients_ then delete buf_temp-clients_.
     4179                 if available buf_temp-firm_ then delete buf_temp-firm_.
     4180                 if available buf_temp-person_ then delete buf_temp-person_.
     4181               end.
     4182             end case.
     4183             if error-status:error then do:
     4184                           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("&1&2&3"                                       , error-status:get-message(1)                                       , chr(10)                                       , return-value)).
     4185               v-view-log = yes.
     4186               next _stroka.
     4187             end.
     4188           end.
     4189         end.
     4190         v-retry-action = 0 .
     4191        _release:
     4192         do on error undo, retry:
     4193           if  retry then do:
     4194             v-retry-action = v-retry-action + 1.
     4195                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("&1&2&3"                                     , error-status:get-message(1)                                     , chr(10)                                     , v-last-error-message )).
     4196             v-view-log = yes.
     4197           end.
     4198         if v-retry-action < 1 then do:
     4199                   ImpData1:Route-data_dump ( ) .
     4200         end.
     4201         end.
     4202         if v-retry-action = 0 then do:
     4203           if buf_temp-xml-tables.is-parent = yes then do:
     4204             num-rec-ok = num-rec-ok + 1.
     4205           end.
     4206         end.
     4207         run write-counter in p-log-handle ( input substitute("Обработано строк: &1, из них удачно: &2", num-rec, num-rec-ok)).
     4208         process events.
     4209         run get-stop-state in p-log-handle ( output v-stop) no-error .
     4210         if v-stop then do:
     4211             run write-log-and-file in p-log-handle (
     4212                                                     input 1
     4213                                                   , input log-file-name
     4214                                                   , input 1
     4215                                                   , input substitute("Процесс импорта прерван пользователем")).
     4216            leave _stroka.
     4217         end.
     4218       end.
     4219       if not v-stop then do:
     4220         if buf_temp-xml-tables.is-parent = yes then do:
     4221           num-rec = num-rec - 1.
     4222         end.
     4223       end.
     4224       v_qh:query-close().
     4225       if valid-handle(v_qh) then do:
     4226         delete object v_qh.
     4227       end.
     4228     end.
     4229       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Обработано строк: &1, из них удачно: &2", num-rec, num-rec-ok)).
     4230   end.
     4231   end procedure.
     4232   procedure load-ruleset-context :
     4233   define input parameter p-ruleset-id as integer no-undo .
     4234   define buffer buf_rule-call-param for tt0-rule-call-param.
     4235   do
     4236   on error undo, return error
     4237   :
     4238     find first buf_rule-call-param no-lock where
     4239   buf_rule-call-param.codex_id = p-codex-id
     4240   and buf_rule-call-param.ruleset_id = p-ruleset-id
     4241   and buf_rule-call-param.call_id = p-call-id
     4242   and buf_rule-call-param.order_id = p-order-id
     4243   and buf_rule-call-param.rule_id = p-rule-id
     4244   and buf_rule-call-param.param-name = "p-xsd-file"
     4245    no-error.
     4246   if available buf_rule-call-param then do:
     4247   assign p-xsd-file = buf_rule-call-param.param-value-character.
     4248   end.
     4249       case p-ruleset-id:
     4250         when 3 then do:
     4251           assign
     4252           v-sign = 1
     4253           v-current-host-code = p-host-code
     4254           v-current-obj-type = p-obj-type
     4255           v-current-obj-code = p-obj-code
     4256           v-current-db-num = g#db-num
     4257           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     4258           file-name  = entry(1, p-process-file-name, chr(4))
     4259           v-xmlh = buffer buf_temp-xml-tables:handle:table-handle:default-buffer-handle
     4260           .
     4261           run rul/rum-xmli.p  (
     4262                                input parparentproc
     4263                               ,input p-log-handle
     4264                               ,input file-name
     4265                               ,input p-profile-id
     4266                               ,input p-xsd-file
     4267                               ,input 0
     4268                               ,input 0
     4269                               ,input-output v_dataseth
     4270                               ,input-output v-xmlh
     4271                               ) no-error.
     4272           if error-status:error then do:
     4273             undo, return error substitute("&1&2&3"
     4274                                             , error-status:get-message(1)
     4275                                             , chr(10)
     4276                                             , return-value ).
     4277           end.
     4278           v-xmlh = buffer buf_temp-xml-tables:handle.
     4279         end.
     4280         otherwise do:
     4281           undo, return error "Неправильный вызов".
     4282         end.
     4283       end case.
     4284     end.
     4285   end procedure.
     4286   procedure create_clients_:
     4287   define input parameter p-cli-type as character no-undo .
     4288   define input parameter p-cli-code as integer no-undo .
     4289   define buffer buf_temp-clients_ for temp-clients_.
     4290   find first buf_temp-clients_ where
     4291             buf_temp-clients_.obj-type = p-obj-type
     4292         and buf_temp-clients_.obj-code = p-obj-code  no-error .
     4293   if not available buf_temp-clients_ then do:
     4294     create buf_temp-clients_.
     4295     assign
     4296     buf_temp-clients_.obj-type = p-obj-type
     4297     buf_temp-clients_.obj-code = p-obj-code
     4298     .
     4299   end.
     4300   end procedure.
     4301   procedure can-find_clients_  :
     4302   define input parameter p-obj-type as character no-undo .
     4303   define input parameter p-obj-code as integer no-undo .
     4304   define output parameter p-find as logical no-undo .
     4305   find first temp-clients_ where
     4306             temp-clients_.obj-type = p-obj-type
     4307         and temp-clients_.obj-code = p-obj-code no-error.
     4308   p-find = available temp-clients_.
     4309   end procedure.
     4310   procedure delete-procedure :
     4311     do
     4312     on error undo, return error
     4313     :
     4314         for each temp-clients_:
     4315           delete temp-clients_.
     4316         end.
     4317         run garbcoll_clear in this-procedure .
     4318     end.
     4319   end procedure.
     4320   procedure 00120003_after-import :
     4321   define input  parameter p-obj-type as character no-undo .
     4322   define input  parameter p-obj-code as integer no-undo .
     4323   define buffer buf_cli-list for cli-list.
     4324   find first buf_cli-list where
     4325             buf_cli-list.obj-type = p-obj-type
     4326        and buf_cli-list.obj-code = p-obj-code
     4327   .
     4328   delete buf_cli-list.
     4329   end procedure.
