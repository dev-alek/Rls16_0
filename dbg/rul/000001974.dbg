     2998   procedure xmlchar-encode :
     2999   define input parameter p-in-string      as character        no-undo.
     3000   define output parameter p-out-string    as character        no-undo.
     3001       define variable v-position      as integer      no-undo.
     3002       define variable v-current-char  as character    no-undo.
     3003   do
     3004   on error undo, return error
     3005   :
     3006       assign
     3007           p-out-string = "":U
     3008       .
     3009       case p-in-string
     3010       :
     3011           when ?
     3012           then do:
     3013               assign
     3014                   p-out-string = "?":U
     3015               .
     3016           end.
     3017           when "?":U
     3018           then do:
     3019               assign
     3020                   p-out-string = "&#63;":U
     3021               .
     3022           end.
     3023           otherwise do:
     3024               do v-position = 1 to length( p-in-string )
     3025               :
     3026                   assign
     3027                       v-current-char = substring( p-in-string, v-position, 1 )
     3028                   .
     3029                   case v-current-char
     3030                   :
     3031                       when "&":U
     3032                       then do:
     3033                           assign
     3034                               p-out-string = p-out-string + "&amp;":U
     3035                           .
     3036                       end.
     3037                       when ">":U
     3038                       then do:
     3039                           assign
     3040                               p-out-string = p-out-string + "&gt;":U
     3041                           .
     3042                       end.
     3043                       when "<":U
     3044                       then do:
     3045                           assign
     3046                               p-out-string = p-out-string + "&lt;":U
     3047                           .
     3048                       end.
     3049                       when "'":U
     3050                       then do:
     3051                           assign
     3052                               p-out-string = p-out-string + "&apos;":U
     3053                           .
     3054                       end.
     3055                       when '"':U
     3056                       then do:
     3057                           assign
     3058                               p-out-string = p-out-string + "&quot;":U
     3059                           .
     3060                       end.
     3061                       when chr(1)
     3062                       then do:
     3063                           assign
     3064                               p-out-string = p-out-string + "":U
     3065                           .
     3066                       end.
     3067                       when chr(2)
     3068                       then do:
     3069                           assign
     3070                               p-out-string = p-out-string + "":U
     3071                           .
     3072                       end.
     3073                       when chr(3)
     3074                       then do:
     3075                           assign
     3076                               p-out-string = p-out-string + "":U
     3077                           .
     3078                       end.
     3079                       when chr(4)
     3080                       then do:
     3081                           assign
     3082                               p-out-string = p-out-string + "":U
     3083                           .
     3084                       end.
     3085                       when chr(5)
     3086                       then do:
     3087                           assign
     3088                               p-out-string = p-out-string + "":U
     3089                           .
     3090                       end.
     3091                       when chr(6)
     3092                       then do:
     3093                           assign
     3094                               p-out-string = p-out-string + "":U
     3095                           .
     3096                       end.
     3097                       when chr(7)
     3098                       then do:
     3099                           assign
     3100                               p-out-string = p-out-string + "":U
     3101                           .
     3102                       end.
     3103                       when chr(8)
     3104                       then do:
     3105                           assign
     3106                               p-out-string = p-out-string + "":U
     3107                           .
     3108                       end.
     3109                       when chr(9)
     3110                       then do:
     3111                           assign
     3112                               p-out-string = p-out-string + "":U
     3113                           .
     3114                       end.
     3115                       when chr(29)
     3116                       then do:
     3117                           assign
     3118                               p-out-string = p-out-string + "":U
     3119                           .
     3120                       end.
     3121                       when chr(10)
     3122                       then do:
     3123                           assign
     3124                               p-out-string = p-out-string + "&#10;":U
     3125                           .
     3126                       end.
     3127                       when chr(13)
     3128                       then do:
     3129                           assign
     3130                               p-out-string = p-out-string + "&#13;":U
     3131                           .
     3132                       end.
     3133                       otherwise do:
     3134                           assign
     3135                               p-out-string = p-out-string + v-current-char
     3136                           .
     3137                       end.
     3138                   end case.
     3139               end.
     3140           end.
     3141       end case.
     3142   end.
     3143   end .
