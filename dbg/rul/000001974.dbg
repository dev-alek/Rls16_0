     1790   define variable v-xmllib-log-proc-name      as character    no-undo .
     1791   define variable v-xmllib-error-status       as logical      no-undo .
     1792   define variable v-xmllib-sax-reader-handle  as handle       no-undo .
     1793   define variable v-xmllib-prg-bar-handle     as handle       no-undo .
     1794   define variable v-xmllib-codepage-convert   as logical      no-undo .
