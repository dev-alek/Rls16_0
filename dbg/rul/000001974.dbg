     3582   define variable v-file-name-no-ext as character no-undo .
     3583   define variable v-file-name-ext    as character no-undo .
     3584   define variable v-end-new-line     as logical no-undo .
     3585   define variable v-last-error-message as character no-undo .
     3586   define variable v-retry-action as integer no-undo .
     3587   define variable v_dataseth as handle no-undo .
     3588   define variable v-xmlh as handle no-undo .
     3589   define variable v_qh as handle no-undo .
