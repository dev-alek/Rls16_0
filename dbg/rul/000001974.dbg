     3200                       end.
     3201                       when chr(6)
     3202                       then do:
     3203                           assign
     3204                               p-out-string = p-out-string + " ":U
     3205                           .
     3206                       end.
     3207                       when chr(7)
     3208                       then do:
     3209                           assign
     3210                               p-out-string = p-out-string + " ":U
     3211                           .
     3212                       end.
     3213                       when chr(8)
     3214                       then do:
     3215                           assign
     3216                               p-out-string = p-out-string + " ":U
