     3592   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3593   procedure set-error :
     3594   define input parameter p-mess as character no-undo .
     3595     do
     3596     on error undo, return error
     3597     :
     3598        assign
     3599        v-last-error-message = p-mess.
     3600     end.
