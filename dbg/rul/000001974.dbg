     1796   define variable v-xmllib-codepage-target    as character    no-undo .
     1797   procedure xmllib-clear-parse-data :
     1798   do
     1799   on error undo, return error
     1800   :
     1801       empty temp-table temp_xmllib_rec-list.
     1802       empty temp-table temp_xmllib_rec-fld-list.
     1803       empty temp-table temp_xmllib_rec.
     1804       empty temp-table temp_xmllib_rec-fld.
     1805   end.
     1806   end procedure.
     1807   procedure xmllib-add-rec-fld :
     1808   define input parameter p-rec-name       as character        no-undo.
     1809   define input parameter p-rec-fld-name   as character        no-undo.
     1810       define buffer buf_rec-list        for temp_xmllib_rec-list.
     1811       define buffer buf_rec-fld-list    for temp_xmllib_rec-fld-list.
     1812   do
     1813   for buf_rec-list
     1814     , buf_rec-fld-list
     1815   on error undo, return error
     1816   :
     1817       find first buf_rec-list
     1818            where buf_rec-list.recName = p-rec-name
     1819       no-error.
     1820       if not available buf_rec-list
     1821       then do:
     1822           create buf_rec-list.
     1823           assign
     1824               buf_rec-list.recName        = p-rec-name
     1825               buf_rec-list.recOpenLine    = 0
     1826               buf_rec-list.recCloseLine   = 0
     1827               buf_rec-list.closed         = yes
     1828           .
     1829       end.
     1830       find first buf_rec-fld-list
     1831            where buf_rec-fld-list.recName = p-rec-name
     1832              and buf_rec-fld-list.fldName = p-rec-fld-name
     1833       no-error.
     1834       if not available buf_rec-fld-list
     1835       then do:
     1836           create buf_rec-fld-list.
     1837           assign
     1838               buf_rec-fld-list.recName        = p-rec-name
     1839               buf_rec-fld-list.fldName        = p-rec-fld-name
     1840               buf_rec-fld-list.fldOpenLine    = 0
     1841               buf_rec-fld-list.fldCloseLine   = 0
     1842               buf_rec-fld-list.closed         = yes
     1843           .
     1844       end.
     1845   end.
     1846   end procedure.
     1847   procedure xmllib-tag-open:
     1848   define input parameter v-tag-level  as integer      no-undo.
     1849   define input parameter v-tag-name   as character    no-undo.
     1850   define input parameter v-tag-value  as character    no-undo.
     1851   do
     1852   on error undo, return error
     1853   :
     1854       assign
     1855           v-tag-name = trim( v-tag-name )
     1856       .
     1857       put stream stmXMLOut unformatted
     1858           substitute( "&1&2<&3&4&5>"
     1859               , chr(10)
     1860               , fill(" ", 4 * v-tag-level)
     1861               , v-tag-name
     1862               , ( if v-tag-value = "":U or v-tag-value = ? then "":U else " ":U )
     1863               , v-tag-value
     1864           )
     1865       .
     1866   end.
     1867   end procedure.
     1868   procedure xmllib-tag-put:
     1869   define input parameter v-tag-level      as integer      no-undo.
     1870   define input parameter v-tag-name       as character    no-undo.
     1871   define input parameter v-tag-value      as character    no-undo.
     1872   define input parameter v-empty-mode     as integer      no-undo.
     1873   do
     1874   on error undo, return error
     1875   :
     1876       assign
     1877           v-tag-name = trim( v-tag-name )
     1878       .
     1879       if  v-empty-mode = 1
     1880       or (v-empty-mode = 0 and (v-tag-value <> "":U and v-tag-value <> ?) )
     1881       or (v-empty-mode = 2 and (v-tag-value <> "":U and v-tag-value <> ? and v-tag-value <> "0":U))
     1882       or (v-empty-mode = 3 and (v-tag-value <> "":U and v-tag-value <> ? and caps(v-tag-value) <> "no":U))
     1883       then do:
     1884           run xmlchar-encode in this-procedure (
     1885                 input v-tag-value
     1886               , output v-tag-value
     1887           ).
     1888           put stream stmXMLOut unformatted
     1889               substitute( "&1&2<&3>&4</&3>"
     1890                   , chr(10)
     1891                   , fill(" ":U, 4 * v-tag-level)
     1892                   , v-tag-name
     1893                   , v-tag-value
     1894               )
     1895           .
     1896       end.
     1897   end.
     1898   end procedure.
     1899   procedure xmllib-tag-put-null :
     1900   define input parameter p-tag-level  as integer      no-undo.
     1901   define input parameter p-tag-name   as character    no-undo.
     1902   do
     1903   on error undo, return error
     1904   :
     1905       assign
     1906           p-tag-name = trim( p-tag-name )
     1907       .
     1908       put stream stmXMLOut unformatted
     1909           substitute( '&1&2<&3 nil="true" /&3>'
     1910               , chr(10)
     1911               , fill(" ":U, 4 * p-tag-level)
     1912               , p-tag-name
     1913           )
     1914       .
     1915   end.
     1916   end procedure.
     1917   procedure xmllib-tag-close:
     1918   define input parameter v-tag-level as integer      no-undo.
     1919   define input parameter v-tag-name  as character    no-undo.
     1920   do
     1921   on error undo, return error
     1922   :
     1923       assign
     1924           v-tag-name = trim( v-tag-name )
     1925       .
     1926       put stream stmXMLOut unformatted
     1927           substitute( "&1&2</&3>"
     1928               , chr(10)
     1929               , fill( " ":U, 4 * v-tag-level)
     1930               , v-tag-name
     1931           )
     1932       .
     1933   end.
     1934   end procedure.
     1935   procedure xmllib-write-log:
     1936   define input parameter v-filename   as character    no-undo.
     1937   define input parameter v-log-level  as integer      no-undo.
     1938   define input parameter v-out-string as character    no-undo.
     1939   do
     1940   on error undo, return error
     1941   :
     1942       output stream stmXMLLog to value( v-filename ) append.
     1943       put stream stmXMLLog unformatted
     1944           chr(10)
     1945       .
     1946       put stream stmXMLLog unformatted
     1947           ( if v-log-level = 0
     1948             or v-out-string = "&DLine":U
     1949             or v-out-string = "&Line":U
     1950             then "":U
     1951             else cur-time-string-sec() + " ":U )
     1952       .
     1953       put stream stmXMLLog unformatted
     1954           ( if v-out-string = "&Line":U
     1955             then fill( "-":U, 80 )
     1956             else if v-out-string = "&DLine":U
     1957                  then fill( "=":U, 80 )
     1958                  else v-out-string )
     1959       .
     1960       output stream stmXMLLog close.
     1961   end.
     1962   end procedure.
     1963   procedure xmllib-write-edt:
     1964   define input parameter v-editor-handle    as handle       no-undo.
     1965   define input parameter v-log-level        as integer      no-undo.
     1966   define input parameter v-out-string       as character    no-undo.
     1967   do
     1968   on error undo, return error
     1969   :
     1970       if valid-handle ( v-editor-handle )
     1971       then do:
     1972           v-editor-handle :move-to-eof().
     1973           v-editor-handle :insert-string( ( if v-log-level = 0
     1974                                             or v-out-string = "&DLine":U
     1975                                             or v-out-string = "&Line":U
     1976                                             then "":U
     1977                                             else cur-time-string-sec() + " ":U
     1978                                         ) ).
     1979           v-editor-handle :insert-string( ( if v-out-string = "&Line":U
     1980                                             then fill( "-":U, 80 )
     1981                                             else if v-out-string = "&DLine":U then fill("=":U, 80)
     1982                                             else fill( " ":U, v-log-level) + v-out-string
     1983                                         ) ).
     1984           v-editor-handle :insert-string( chr(10) ).
     1985       end.
     1986   end.
     1987   end procedure.
     1988   procedure xmllib-show-cnt:
     1989   define input parameter v-fillin-handle     as handle   no-undo.
     1990   do
     1991   on error undo, return error
     1992   :
     1993       if valid-handle( v-fillin-handle )
     1994       then do:
     1995           assign
     1996               v-fillin-handle :visible = true
     1997           .
     1998       end.
     1999   end.
     2000   end procedure.
     2001   procedure xmllib-hide-cnt:
     2002   define input parameter v-fillin-handle     as handle   no-undo.
     2003   do
     2004   on error undo, return error
     2005   :
     2006       if valid-handle( v-fillin-handle )
     2007       then do:
     2008           assign v-fillin-handle :visible = false.
     2009       end.
     2010   end.
     2011   end procedure.
     2012   procedure xmllib-write-cnt:
     2013   define input parameter v-fillin-handle    as handle       no-undo.
     2014   define input parameter v-fillin-string    as character    no-undo.
     2015   do
     2016   on error undo, return error
     2017   :
     2018       if valid-handle( v-fillin-handle )
     2019       then do:
     2020           assign
     2021               v-fillin-handle :SCREEN-value = v-fillin-string
     2022           .
     2023       end.
     2024   end.
     2025   end procedure.
     2026   procedure xmllib-write-header:
     2027   define input parameter p-first-file     as logical      no-undo.
     2028   define input parameter p-xml-file-name  as character    no-undo.
     2029   define input parameter p-list-file-name as character    no-undo.
     2030   define input parameter p-file-number    as integer      no-undo.
     2031   define input parameter p-have-prev      as logical      no-undo.
     2032   define input parameter p-prev-filename  as character    no-undo.
     2033   define input parameter p-parameter-list as character    no-undo.
     2034       define variable v-counter    as integer        no-undo.
     2035   do
     2036   on error undo, return error
     2037   :
     2038       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     2039       put stream stmXMLOut unformatted
     2040           "<?xml version='1.0' encoding='windows-1251'?>"
     2041       .
     2042       run xmllib-tag-open( input 0, input "root"          , input "":U ).
     2043       run xmllib-tag-open( input 0, input "THheader"        , input "":U ).
     2044       run xmllib-tag-put( input 1 , input "THfileName"      , input p-xml-file-name + "xml":U  , input 0 ).
     2045       run xmllib-tag-put( input 1 , input "THfileNumber"    , input string( p-file-number     ), input 0 ).
     2046       run xmllib-tag-put( input 1 , input "THhavePrev"      , input string( p-have-prev       ), input 3 ).
     2047       run xmllib-tag-put( input 1 , input "THprevFileName"  , input p-prev-filename            , input 0 ).
     2048       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     2049       :
     2050           run xmllib-tag-put(
     2051                 input 1
     2052               , input entry( 2 * v-counter, p-parameter-list )
     2053               , input entry( 2 * v-counter + 1, p-parameter-list )
     2054               , input 0
     2055           ).
     2056       end.
     2057       run xmllib-tag-close( input 0, input "THheader" ).
     2058       output stream stmXMLOut close.
     2059       if p-list-file-name <> "":U
     2060       then do:
     2061           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     2062           if p-first-file = yes
     2063           then do:
     2064               put stream stmXMLOut unformatted
     2065                   "<?xml version='1.0' encoding='windows-1251'?>"
     2066               .
     2067               run xmllib-tag-open( input 0, input "OpenXML", input "" ).
     2068           end.
     2069           run xmllib-tag-open( input 1, input "THfile", input "" ).
     2070           run xmllib-tag-put( input 2, input "THfileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     2071           run xmllib-tag-put( input 2, input "THfileNumber"     , input string( p-file-number     ), input 0 ).
     2072           run xmllib-tag-put( input 2, input "THhavePrev"       , input string( p-have-prev       ), input 3 ).
     2073           run xmllib-tag-put( input 2, input "THprevFileName"   , input p-prev-filename            , input 0 ).
     2074           do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     2075           :
     2076               run xmllib-tag-put(
     2077                   input 2
     2078                   , input entry( 2 * v-counter, p-parameter-list )
     2079                   , input entry( 2 * v-counter + 1, p-parameter-list )
     2080                   , input 0
     2081               ).
     2082           end.
     2083           run xmllib-tag-close( input 1, input "THfile" ).
     2084           output stream stmXMLOut close.
     2085       end.
     2086   end.
     2087   end procedure.
     2088   procedure xmllib-write-footer:
     2089   define input parameter p-last-file      as logical      no-undo.
     2090   define input parameter p-xml-file-name  as character    no-undo.
     2091   define input parameter p-list-file-name as character    no-undo.
     2092   define input parameter p-have-next      as logical      no-undo.
     2093   define input parameter p-next-file-name as character    no-undo.
     2094       define variable v-error-num     as integer           no-undo.
     2095   do
     2096   on error undo, return error
     2097   :
     2098       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     2099       if p-have-next = yes
     2100       then do:
     2101           run xmllib-tag-open( input 0, input "footer", "" ).
     2102           run xmllib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     2103           run xmllib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     2104           run xmllib-tag-close( input 0, input "footer" ).
     2105       end.
     2106       run xmllib-tag-close( input 0, input "root" ).
     2107       output stream stmXMLOut close.
     2108       run bge/os_copy.p (
     2109             input "M"
     2110           , input p-xml-file-name + "tmp"
     2111           , input p-xml-file-name + "xml"
     2112           , output v-error-num
     2113       ).
     2114       if p-last-file = yes
     2115       and p-list-file-name <> "":U
     2116       then do:
     2117           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     2118               run xmllib-tag-close( input 0, input "OpenXML" ).
     2119           output stream stmXMLOut close.
     2120           run bge/os_copy.p (
     2121                 input "M"
     2122               , input p-list-file-name + "tmp"
     2123               , input p-list-file-name + "xml":U
     2124               , output v-error-num
     2125           ).
     2126       end.
     2127   end.
     2128   end procedure.
     2129   procedure xmllib-filename :
     2130   define input parameter p-subdir             as character        no-undo.
     2131   define input parameter p-prefix             as character    no-undo.
     2132   define output parameter p-xml-file-name     as character    no-undo.
     2133   define output parameter p-log-file-name     as character    no-undo.
     2134   define output parameter p-list-file-name    as character    no-undo.
     2135       define variable v-home-dir  as character    no-undo.
     2136       define variable v-error-num as integer      no-undo.
     2137   do
     2138   on error undo, return error
     2139   :
     2140       get-key-value section "OXML" key "oxml-dir" value v-home-dir.
     2141       if v-home-dir = ?
     2142       then do:
     2143           message
     2144             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     2145             skip "Нет параметра oxml-dir в секции [OXML]."
     2146             skip(1)
     2147             skip "Обратитесь к администратору."
     2148           view-as alert-box error.
     2149           undo, return error .
     2150       end.
     2151       if p-subdir <> "":U
     2152       then do:
     2153           assign
     2154               v-home-dir = substitute( "&1/out/&2", v-home-dir, p-subdir )
     2155           .
     2156       end.
     2157       run gbl/dir-cre.p (
     2158           input v-home-dir
     2159       ) no-error.
     2160       if error-status :error
     2161       then do:
     2162           message
     2163             skip "Неверно задан каталог экспорта в ini-файле."
     2164             skip "Не удаётся создать каталог, указанный параметром"
     2165             skip "oxml-dir в секции [OXML]."
     2166             skip(1)
     2167             skip "Обратитесь к администратору."
     2168           view-as alert-box error.
     2169           undo, return error .
     2170       end.
     2171       run bge/genfname.p (
     2172             input v-home-dir
     2173           , input p-prefix
     2174           , input ""
     2175           , input "xml"
     2176           , input "tmp"
     2177           , output p-xml-file-name
     2178       ).
     2179       assign
     2180           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     2181           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     2182           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     2183       .
     2184   end.
     2185   end procedure.
     2186   procedure xmllib-check-file-size :
     2187   define input parameter p-out-filename   as character    no-undo.
     2188   define output parameter p-is-big        as logical      no-undo.
     2189       define variable v-current-position    as integer        no-undo.
     2190   do
     2191   on error undo, return error
     2192   :
     2193       assign
     2194           v-current-position = seek( stmXMLOut )
     2195       .
     2196       if v-current-position / 1024 / 1024  >= 100
     2197       then do:
     2198           assign
     2199               p-is-big = yes
     2200           .
     2201       end.
     2202   end.
     2203   end procedure.
     2204   procedure xmllib-parse-file :
     2205   define input parameter p-full-filename      as character        no-undo.
     2206       define variable v-num-dirs              as integer      no-undo .
     2207       define variable v-str                   as character    no-undo .
     2208       define variable v-str-count             as int64        no-undo .
     2209   do
     2210   on error undo, return error
     2211   :
     2212       assign
     2213           v-num-dirs              = num-entries( p-full-filename,"\/":U )
     2214           v-xmllib-error-status   = no
     2215       .
     2216       if v-num-dirs > 1
     2217       then do:
     2218           assign
     2219               v-xmllib-filename = entry( v-num-dirs, p-full-filename, "\/":U )
     2220               v-xmllib-dirname  = substring( p-full-filename, 1, length( p-full-filename ) - length( v-xmllib-filename ) - 1 )
     2221           .
     2222       end.
     2223       else do:
     2224           assign
     2225               v-xmllib-filename = p-full-filename
     2226               v-xmllib-dirname  = "":U
     2227           .
     2228       end.
     2229       if valid-handle(v-xmllib-prg-bar-handle)
     2230       then do:
     2231   if session :set-wait-state( "compiler" ) then.
     2232         input stream strXMLIn from value(p-full-filename) .
     2233         repeat
     2234         :
     2235           import stream strXMLIn unformatted v-str no-error .
     2236           assign
     2237             v-str-count = v-str-count + 1
     2238           .
     2239         end.
     2240         input stream strXMLIn close .
     2241   if session :set-wait-state( "" ) then.
     2242         run prg-bar_init-cb-handle in this-procedure ( input v-xmllib-prg-bar-handle ) .
     2243         run prg-bar_new in this-procedure ( input 1 , input v-str-count) .
     2244         run prg-bar_show in this-procedure .
     2245       end.
     2246       create sax-reader v-xmllib-sax-reader-handle.
     2247       v-xmllib-sax-reader-handle :set-input-source( "FILE":U, p-full-filename ).
     2248       v-xmllib-sax-reader-handle :sax-parse( ) no-error.
     2249       if error-status :error
     2250       then do:
     2251           run xmllib-parse-error in this-procedure ( input substitute("&1 &2 &3&4Ошибка обработки XML файла.&4&5&4&5&4&7&4&8"
     2252                                                                       ,vss-workfile
     2253                                                                       ,vss-revision
     2254                                                                       ,vss-description
     2255                                                                       ,chr(10)
     2256                                                                       ,return-value
     2257                                                                       ,trim(error-status :get-message(1))
     2258                                                                       ,trim(error-status :get-message(2))
     2259                                                                       ,trim(error-status :get-message(3)))
     2260                                                     ).
     2261           undo, return error .
     2262       end.
     2263       if v-xmllib-error-status <> no
     2264       then do:
     2265           run xmllib-parse-error in this-procedure (
     2266               input "*** При обработке XML файла были ошибки."
     2267           ).
     2268           delete object v-xmllib-sax-reader-handle.
     2269       end.
     2270       delete object v-xmllib-sax-reader-handle.
     2271       if valid-handle(v-xmllib-prg-bar-handle)
     2272       then do:
     2273         run prg-bar_delete in this-procedure .
     2274       end.
     2275   end.
     2276   end procedure.
     2277   procedure xmllib-parse-progressive :
     2278   define input parameter p-full-filename      as character no-undo .
     2279   define input parameter p-pack-data          as memptr no-undo .
     2280   define input parameter p-parse-first        as logical no-undo .
     2281   define input parameter p-first-err          as logical no-undo .
     2282   define output parameter p-parse-status as integer no-undo .
     2283   define variable v-num-dirs              as integer no-undo .
     2284   define variable glog                    as logical no-undo .
     2285   define variable v-pack-size             as int64 no-undo .
     2286   do
     2287   on error undo, return error
     2288   :
     2289     if p-parse-first then do:
     2290       if valid-handle(v-xmllib-sax-reader-handle)
     2291       then do:
     2292       end.
     2293       assign
     2294           v-num-dirs              = num-entries( p-full-filename,"\/":U )
     2295           v-xmllib-error-status   = no
     2296       .
     2297       if v-num-dirs > 1
     2298       then do:
     2299           assign
     2300               v-xmllib-filename = entry( v-num-dirs, p-full-filename, "\/":U )
     2301               v-xmllib-dirname  = substring( p-full-filename, 1, length( p-full-filename ) - length( v-xmllib-filename ) - 1 )
     2302           .
     2303       end.
     2304       else do:
     2305           assign
     2306               v-xmllib-filename = p-full-filename
     2307               v-xmllib-dirname  = "":U
     2308           .
     2309       end.
     2310       create sax-reader v-xmllib-sax-reader-handle.
     2311       v-pack-size = get-size (p-pack-data) .
     2312       if v-pack-size > 0 then
     2313         glog = v-xmllib-sax-reader-handle :set-input-source( "MEMPTR":U, p-pack-data ) no-error.
     2314       else
     2315         glog = v-xmllib-sax-reader-handle :set-input-source( "FILE":U, p-full-filename ) no-error.
     2316       if error-status :error
     2317       or not glog
     2318       then do:
     2319         delete object v-xmllib-sax-reader-handle.
     2320         run xmllib-parse-error in this-procedure ( input substitute("&1 &2 &3&4Ошибка обработки XML файла.&4&5&4&5&4&7&4&8"
     2321                                                                     ,vss-workfile
     2322                                                                     ,vss-revision
     2323                                                                     ,vss-description
     2324                                                                     ,chr(10)
     2325                                                                     ,return-value
     2326                                                                     ,trim(error-status :get-message(1))
     2327                                                                     ,trim(error-status :get-message(2))
     2328                                                                     ,trim(error-status :get-message(3)) )
     2329                                                   ).
     2330         undo, return error .
     2331       end.
     2332       v-xmllib-sax-reader-handle :sax-parse-first( ) no-error.
     2333     end.
     2334     else do:
     2335       v-xmllib-sax-reader-handle :sax-parse-next( ) no-error.
     2336     end.
     2337     if error-status :error
     2338     then do:
     2339       delete object v-xmllib-sax-reader-handle.
     2340       run xmllib-parse-error in this-procedure ( input substitute("&1 &2 &3&4Ошибка обработки XML файла.&4&5&4&5&4&7&4&8"
     2341                                                                   ,vss-workfile
     2342                                                                   ,vss-revision
     2343                                                                   ,vss-description
     2344                                                                   ,chr(10)
     2345                                                                   ,return-value
     2346                                                                   ,trim(error-status :get-message(1))
     2347                                                                   ,trim(error-status :get-message(2))
     2348                                                                   ,trim(error-status :get-message(3)) )
     2349                                                 ).
     2350       undo, return error .
     2351     end.
     2352     if v-xmllib-error-status <> no
     2353     then do:
     2354       run xmllib-parse-error in this-procedure (
     2355           input "*** При обработке XML файла были ошибки."
     2356       ).
     2357       if p-first-err then do:
     2358         delete object v-xmllib-sax-reader-handle.
     2359       end.
     2360       else do:
     2361         v-xmllib-error-status = no.
     2362       end.
     2363     end.
     2364     if v-xmllib-sax-reader-handle:parse-status = SAX-COMPLETE  then do:
     2365       p-parse-status = SAX-COMPLETE.
     2366       delete object v-xmllib-sax-reader-handle.
     2367       return '':U.
     2368     end.
     2369     else do:
     2370       p-parse-status = v-xmllib-sax-reader-handle:parse-status.
     2371       return '':U.
     2372     end.
     2373   end.
     2374   end procedure.
     2375   procedure StartElement :
     2376   define input parameter p-name-space     as character        no-undo.
     2377   define input parameter p-local-name     as character        no-undo.
     2378   define input parameter p-q-name         as character        no-undo.
     2379   define input parameter p-attributes     as handle           no-undo.
     2380       define buffer buf_rec             for temp_xmllib_rec.
     2381       define buffer buf_rec-fld         for temp_xmllib_rec-fld.
     2382       define buffer buf_rec-list        for temp_xmllib_rec-list.
     2383       define buffer buf_rec-fld-list    for temp_xmllib_rec-fld-list.
     2384   do
     2385   for buf_rec
     2386     , buf_rec-fld
     2387     , buf_rec-list
     2388     , buf_rec-fld-list
     2389   on error undo, return error
     2390   :
     2391       if valid-handle(v-xmllib-prg-bar-handle)
     2392       then do:
     2393         run prg-bar_stepto in this-procedure ( input SELF:LOCATOR-LINE-NUMBER ) .
     2394       end.
     2395       find first buf_rec-list
     2396            where buf_rec-list.recName = p-q-name
     2397       no-error.
     2398       if available buf_rec-list
     2399       then do:
     2400           if buf_rec-list.closed = no
     2401           then do:
     2402               find first buf_rec-fld-list
     2403                    where buf_rec-fld-list.recName = buf_rec-list.recName
     2404                      and buf_rec-fld-list.fldName = p-q-name
     2405               no-error.
     2406               if available buf_rec-fld-list
     2407               and buf_rec-list.recName = buf_rec-fld-list.recName
     2408               then do:
     2409                   if buf_rec-fld-list.closed = no
     2410                   then do:
     2411                       run xmllib-parse-error in this-procedure (
     2412                           input substitute( "Ошибка 1 открытия поля <&1> записи <&2>: Поле с этим именем уже открыто на строке &3."
     2413                                           , p-q-name
     2414                                           , p-q-name
     2415                                           , buf_rec-fld-list.fldOpenLine
     2416                                           )
     2417                       ).
     2418                   end.
     2419                   else do:
     2420                       run xmllib-parse-rec-fld-open in this-procedure (
     2421                             input buf_rec-list.recName
     2422                           , input buf_rec-list.recLevel
     2423                           , input buf_rec-fld-list.fldName
     2424                       ).
     2425                       assign
     2426                           buf_rec-fld-list.closed         = no
     2427                           buf_rec-fld-list.fldOpenLine    = v-xmllib-sax-reader-handle :locator-line-number
     2428                           buf_rec-fld-list.fldCloseLine   = 0
     2429                       .
     2430                   end.
     2431               end.
     2432               else do:
     2433                   assign
     2434                       buf_rec-list.recLevel = buf_rec-list.recLevel + 1
     2435                   .
     2436                   run xmllib-parse-rec-open in this-procedure (
     2437                         input buf_rec-list.recName
     2438                       , input buf_rec-list.recLevel
     2439                   ).
     2440                   assign
     2441                       buf_rec-list.closed         = no
     2442                       buf_rec-list.recOpenLine    = v-xmllib-sax-reader-handle :locator-line-number
     2443                       buf_rec-list.recCloseLine   = 0
     2444                   .
     2445               end.
     2446           end.
     2447           else do:
     2448               run xmllib-parse-rec-open in this-procedure (
     2449                     input buf_rec-list.recName
     2450                   , input buf_rec-list.recLevel
     2451               ).
     2452               assign
     2453                   buf_rec-list.closed         = no
     2454                   buf_rec-list.recOpenLine    = v-xmllib-sax-reader-handle :locator-line-number
     2455                   buf_rec-list.recCloseLine   = 0
     2456               .
     2457           end.
     2458       end.
     2459       else do:
     2460           open-record:
     2461           for each buf_rec-fld-list
     2462              where buf_rec-fld-list.fldName = p-q-name
     2463           :
     2464               find first buf_rec-list
     2465                    where buf_rec-list.recName = buf_rec-fld-list.recName
     2466                      and buf_rec-list.closed  = no
     2467               no-error.
     2468               if available buf_rec-list
     2469               then do:
     2470                   run xmllib-parse-rec-fld-open in this-procedure (
     2471                         input buf_rec-list.recName
     2472                       , input buf_rec-list.recLevel
     2473                       , input buf_rec-fld-list.fldName
     2474                   ).
     2475                   assign
     2476                       buf_rec-fld-list.recLevel       = buf_rec-list.recLevel
     2477                       buf_rec-fld-list.closed         = no
     2478                       buf_rec-fld-list.fldOpenLine    = v-xmllib-sax-reader-handle :locator-line-number
     2479                       buf_rec-fld-list.fldCloseLine   = 0
     2480                   .
     2481                   leave open-record.
     2482               end.
     2483           end.
     2484       end.
     2485   end.
     2486   end procedure.
     2487   procedure Characters :
     2488   define input parameter p-char-data  as memptr.
     2489   define input parameter p-numchars   as integer.
     2490       define variable v-data-string    as character    no-undo.
     2491       define variable v-cp-utf8           as integer no-undo init 65001 .
     2492       define variable v-cp-windows1251    as integer no-undo init 1251 .
     2493       define buffer buf_xmllib_rec             for temp_xmllib_rec.
     2494       define buffer buf_xmllib_rec-fld         for temp_xmllib_rec-fld.
     2495       define buffer buf_xmllib_rec-list        for temp_xmllib_rec-list.
     2496       define buffer buf_xmllib_rec-fld-list    for temp_xmllib_rec-fld-list.
     2497   do
     2498   for buf_xmllib_rec
     2499     , buf_xmllib_rec-fld
     2500     , buf_xmllib_rec-list
     2501     , buf_xmllib_rec-fld-list
     2502   on error undo, return error
     2503   :
     2504       find first buf_xmllib_rec-list
     2505            where buf_xmllib_rec-list.closed = no
     2506       no-error.
     2507       if available buf_xmllib_rec-list
     2508       then do:
     2509           find first buf_xmllib_rec-fld-list
     2510                where buf_xmllib_rec-fld-list.closed = no
     2511           no-error.
     2512           if available buf_xmllib_rec-fld-list
     2513           and buf_xmllib_rec-fld-list.recName  = buf_xmllib_rec-list.recName
     2514           and buf_xmllib_rec-fld-list.recLevel = buf_xmllib_rec-list.recLevel
     2515           then do:
     2516               find last buf_xmllib_rec
     2517                   where buf_xmllib_rec.recName  = buf_xmllib_rec-list.recName
     2518                     and buf_xmllib_rec.recLevel = buf_xmllib_rec-list.recLevel
     2519                     and buf_xmllib_rec.closed   = no
     2520               use-index nm
     2521               no-error.
     2522               if available buf_xmllib_rec
     2523               then do:
     2524                   find last buf_xmllib_rec-fld
     2525                       where buf_xmllib_rec-fld.rec-key = buf_xmllib_rec.rec-key
     2526                         and buf_xmllib_rec-fld.fldName = buf_xmllib_rec-fld-list.fldName
     2527                         and buf_xmllib_rec-fld.closed = no
     2528                   use-index nm
     2529                   no-error.
     2530                   if available buf_xmllib_rec-fld
     2531                   then do:
     2532                       assign
     2533                           v-data-string = get-string( p-char-data, 1, get-size( p-char-data ) )
     2534                       .
     2535                       if v-xmllib-codepage-convert = yes
     2536                       then do:
     2537                         assign
     2538                             v-data-string = codepage-convert( v-data-string , v-xmllib-codepage-target , v-xmllib-codepage-source )
     2539                         .
     2540                       end.
     2541                       run xmlchar-decode in this-procedure (
     2542                           input v-data-string
     2543                           , output v-data-string
     2544                       ).
     2545                       assign
     2546                           buf_xmllib_rec-fld.fldValue = trim( substitute( "&1&2", buf_xmllib_rec-fld.fldValue, v-data-string ) )
     2547                       .
     2548                   end.
     2549               end.
     2550           end.
     2551       end.
     2552   end.
     2553   end procedure.
     2554   procedure EndElement :
     2555   define input parameter p-name-space     as character        no-undo.
     2556   define input parameter p-local-name     as character        no-undo.
     2557   define input parameter p-q-name         as character        no-undo.
     2558       define buffer buf_rec             for temp_xmllib_rec.
     2559       define buffer buf_rec-fld         for temp_xmllib_rec-fld.
     2560       define buffer buf_rec-list        for temp_xmllib_rec-list.
     2561       define buffer buf_rec-fld-list    for temp_xmllib_rec-fld-list.
     2562   do
     2563   for buf_rec
     2564     , buf_rec-fld
     2565     , buf_rec-list
     2566     , buf_rec-fld-list
     2567   on error undo, return error
     2568   :
     2569       find last buf_rec-list
     2570           where buf_rec-list.recName = p-q-name
     2571       use-index pi
     2572       no-error.
     2573       if available buf_rec-list
     2574       then do:
     2575           if buf_rec-list.closed = yes
     2576           then do:
     2577               run xmllib-parse-error in this-procedure (
     2578                   input substitute( "Ошибка закрытия записи или поля <&1>: Нет метки открытой записи."
     2579                                   , p-q-name
     2580                                   )
     2581               ).
     2582           end.
     2583           else do:
     2584               find last buf_rec
     2585                   where buf_rec.recName  = buf_rec-list.recName
     2586                     and buf_rec.recLevel = buf_rec-list.recLevel
     2587                     and buf_rec.closed   = no
     2588               use-index nm
     2589               no-error.
     2590               if not available buf_rec
     2591               then do:
     2592                   run xmllib-parse-error in this-procedure (
     2593                       input substitute( "Ошибка закрытия записи или поля <&1> уровня &2: Нет открытой записи."
     2594                                       , p-q-name
     2595                                       , buf_rec-list.recLevel
     2596                                       )
     2597                   ).
     2598               end.
     2599               else do:
     2600                   find first buf_rec-fld-list
     2601                        where buf_rec-fld-list.recName  = buf_rec.recName
     2602                          and buf_rec-fld-list.recLevel = buf_rec.recLevel
     2603                          and buf_rec-fld-list.fldName  = p-q-name
     2604                          and buf_rec-fld-list.closed   = no
     2605                   no-error.
     2606                   if not available buf_rec-fld-list
     2607                   then do:
     2608                       if buf_rec.recName <> p-q-name
     2609                       then do:
     2610                           run xmllib-parse-error in this-procedure (
     2611                               input substitute( "Ошибка закрытия записи <&1>: Имя открытой записи не совпадает с именем метки."
     2612                                               , buf_rec.recName
     2613                                               )
     2614                           ).
     2615                       end.
     2616                       else do:
     2617                           assign
     2618                               buf_rec.closed              = yes
     2619                               buf_rec.recCloseLine        = v-xmllib-sax-reader-handle :locator-line-number
     2620                               buf_rec-list.recCloseLine   = v-xmllib-sax-reader-handle :locator-line-number
     2621                           .
     2622                           if buf_rec-list.recLevel > 0
     2623                           then do:
     2624                               assign
     2625                                   buf_rec-list.recLevel = buf_rec-list.recLevel - 1
     2626                               .
     2627                               for each buf_rec-fld-list
     2628                                  where buf_rec-fld-list.recName = buf_rec-list.recName
     2629                               :
     2630                                   assign
     2631                                       buf_rec-fld-list.recLevel = buf_rec-fld-list.recLevel - 1
     2632                                   .
     2633                               end.
     2634                           end.
     2635                           else do:
     2636                               assign
     2637                                   buf_rec-list.closed         = yes
     2638                               .
     2639                           end.
     2640                       end.
     2641                   end.
     2642                   else do:
     2643                       find last buf_rec-fld
     2644                           where buf_rec-fld.rec-key = buf_rec.rec-key
     2645                             and buf_rec-fld.fldName = buf_rec-fld-list.fldName
     2646                             and buf_rec-fld.closed  = no
     2647                       use-index nm
     2648                       no-error.
     2649                       if not available buf_rec-fld
     2650                       then do:
     2651                           run xmllib-parse-error in this-procedure (
     2652                               input substitute( "Ошибка 2 закрытия поля <&1>: Не найдено открытое поле с этим именем в записи <&2> уровня &3."
     2653                                               , buf_rec-fld-list.fldName
     2654                                               , buf_rec.recName
     2655                                               , buf_rec.recLevel
     2656                                               )
     2657                           ).
     2658                       end.
     2659                       else do:
     2660                           assign
     2661                               buf_rec-fld.closed              = yes
     2662                               buf_rec-fld-list.closed         = yes
     2663                               buf_rec-fld.fldCloseLine        = v-xmllib-sax-reader-handle :locator-line-number
     2664                               buf_rec-fld-list.fldCloseLine   = v-xmllib-sax-reader-handle :locator-line-number
     2665                           .
     2666                       end.
     2667                   end.
     2668               end.
     2669           end.
     2670       end.
     2671       else do:
     2672           close-field-rec:
     2673           for each buf_rec-fld-list
     2674              where buf_rec-fld-list.fldName = p-q-name
     2675           :
     2676               find first buf_rec-list
     2677                    where buf_rec-list.recName  = buf_rec-fld-list.recName
     2678                      and buf_rec-list.recLevel = buf_rec-fld-list.recLevel
     2679                      and buf_rec-list.closed   = no
     2680               no-error.
     2681               if available buf_rec-list
     2682               then do:
     2683                   find last buf_rec
     2684                       where buf_rec.recName  = buf_rec-list.recName
     2685                         and buf_rec.recLevel = buf_rec-list.recLevel
     2686                         and buf_rec.closed   = no
     2687                   use-index nm
     2688                   no-error.
     2689                   if not available buf_rec
     2690                   then do:
     2691                       run xmllib-parse-error in this-procedure (
     2692                           input substitute( "Ошибка закрытия поля <&1>: Нет открытой записи."
     2693                                           , p-q-name
     2694                                           )
     2695                       ).
     2696                   end.
     2697                   else do:
     2698                       find last buf_rec-fld
     2699                           where buf_rec-fld.rec-key = buf_rec.rec-key
     2700                             and buf_rec-fld.fldName = buf_rec-fld-list.fldName
     2701                             and buf_rec-fld.closed  = no
     2702                       use-index nm
     2703                       no-error.
     2704                       if not available buf_rec-fld
     2705                       then do:
     2706                           run xmllib-parse-error in this-procedure (
     2707                               input substitute( "Ошибка 1 закрытия поля <&1>: Не найдено открытое поле с этим именем в записи <&2> уровня &3."
     2708                                               , buf_rec-fld-list.fldName
     2709                                               , buf_rec.recName
     2710                                               , buf_rec.recLevel
     2711                                               )
     2712                           ).
     2713                       end.
     2714                       else do:
     2715                           assign
     2716                               buf_rec-fld.closed              = yes
     2717                               buf_rec-fld-list.closed         = yes
     2718                               buf_rec-fld.fldCloseLine        = v-xmllib-sax-reader-handle :locator-line-number
     2719                               buf_rec-fld-list.fldCloseLine   = v-xmllib-sax-reader-handle :locator-line-number
     2720                           .
     2721                       end.
     2722                   end.
     2723                   leave close-field-rec.
     2724               end.
     2725           end.
     2726       end.
     2727   end.
     2728   end procedure.
     2729   procedure Error :
     2730   define input parameter p-error-message     as character        no-undo.
     2731   do
     2732   on error undo, return error
     2733   :
     2734       run xmllib-parse-error in this-procedure (
     2735           input p-error-message
     2736       ).
     2737       assign
     2738           v-xmllib-error-status = yes
     2739       .
     2740   end.
     2741   end procedure.
     2742   procedure xmllib-parse-error :
     2743   define input parameter p-err-message    as character        no-undo.
     2744   do
     2745   on error undo, return error
     2746   :
     2747       if valid-handle(v-xmllib-log-handle) then do:
     2748         run value(v-xmllib-log-proc-name) in  v-xmllib-log-handle
     2749                  (input substitute("&1Файл:    &2 &3&1Строка &4&1&5"
     2750                                    ,chr(10)
     2751                                    ,v-xmllib-dirname
     2752                                    ,v-xmllib-filename
     2753                                    ,(if valid-handle(v-xmllib-sax-reader-handle)
     2754                                      then v-xmllib-sax-reader-handle :locator-line-number
     2755                                      else ?)
     2756                                    ,p-err-message)).
     2757       end.
     2758       else do:
     2759         if v-xmllib-log-filename = "":U
     2760         then do:
     2761             message
     2762                     vss-workfile vss-revision vss-description
     2763                 skip "Файл:   " v-xmllib-dirname v-xmllib-filename
     2764                 skip "Строка: " (if valid-handle(v-xmllib-sax-reader-handle)
     2765                                  then v-xmllib-sax-reader-handle :locator-line-number
     2766                                  else ?)
     2767                 skip(1)
     2768                 skip p-err-message
     2769                 skip return-value
     2770                 skip trim( error-status :get-message( 1 ) )
     2771                     trim( error-status :get-message( 2 ) )
     2772                     trim( error-status :get-message( 3 ) )
     2773             view-as alert-box error.
     2774             undo, return error.
     2775         end.
     2776         else do:
     2777           output to value( v-xmllib-log-filename ).
     2778           put unformatted
     2779               substitute( "&1&2", chr(10), p-err-message )
     2780           .
     2781           output close.
     2782         end.
     2783       end.
     2784   end.
     2785   end procedure.
     2786   procedure xmllib-set-log-filename :
     2787   define input parameter p-log-filename   as character        no-undo.
     2788   do
     2789   on error undo, return error
     2790   :
     2791       run gbl/fileapnd.p (
     2792             input p-log-filename
     2793           , input "":U
     2794           , input 10
     2795       ) no-error.
     2796       if error-status :error
     2797       then do:
     2798           assign
     2799               v-xmllib-log-filename = "":U
     2800           .
     2801       end.
     2802       else do:
     2803           assign
     2804               v-xmllib-log-filename = p-log-filename
     2805           .
     2806       end.
     2807   end.
     2808   end procedure.
     2809   procedure xmllib-set-log-handle :
     2810   define input parameter p-log-handle    as handle        no-undo.
     2811   define input parameter p-log-proc-name as character no-undo .
     2812   do
     2813   on error undo, return error
     2814   :
     2815       if valid-handle(p-log-handle)
     2816       and lookup(p-log-proc-name, p-log-handle:internal-entries) > 0
     2817       then do:
     2818         assign
     2819         v-xmllib-log-handle    = p-log-handle
     2820         v-xmllib-log-proc-name = p-log-proc-name
     2821         .
     2822       end.
     2823       else do:
     2824         assign
     2825         v-xmllib-log-handle    = ?
     2826         v-xmllib-log-proc-name = '':U
     2827         .
     2828       end.
     2829   end.
     2830   end procedure.
     2831   procedure xmllib-set-prg-bar-handle :
     2832   define input parameter p-handle    as handle        no-undo.
     2833   do
     2834   on error undo, return error
     2835   :
     2836       if valid-handle(p-handle)
     2837       then do:
     2838         assign
     2839           v-xmllib-prg-bar-handle = p-handle
     2840         .
     2841       end.
     2842       else do:
     2843         assign
     2844           v-xmllib-prg-bar-handle = ?
     2845         .
     2846       end.
     2847   end.
     2848   end procedure.
     2849   procedure xmllib-set-codepage-convert :
     2850     define input  parameter p-codepage-source as character no-undo .
     2851     define input  parameter p-codepage-target as character no-undo .
     2852   do
     2853   on error undo, return error return-value
     2854   :
     2855     if ( p-codepage-source <> "" and p-codepage-target <> "" )
     2856     then do:
     2857       assign
     2858         v-xmllib-codepage-convert = yes
     2859         v-xmllib-codepage-source  = p-codepage-source
     2860         v-xmllib-codepage-target  = p-codepage-target
     2861       .
     2862     end.
     2863     else do:
     2864       assign
     2865         v-xmllib-codepage-convert = no
     2866         v-xmllib-codepage-source  = ""
     2867         v-xmllib-codepage-target  = ""
     2868       .
     2869     end.
     2870   end.
     2871   end procedure.
     2872   procedure xmllib-parse-rec-open :
     2873   define input parameter p-rec-name   as character        no-undo.
     2874   define input parameter p-rec-level  as integer          no-undo.
     2875       define buffer buf_temp_xmllib_rec       for temp_xmllib_rec.
     2876   do
     2877   for buf_temp_xmllib_rec
     2878   on error undo, return error
     2879   :
     2880        find first buf_temp_xmllib_rec
     2881            where buf_temp_xmllib_rec.recName = p-rec-name
     2882              and buf_temp_xmllib_rec.recLevel = p-rec-level
     2883              and buf_temp_xmllib_rec.closed  = no
     2884       use-index nm
     2885       no-error.
     2886       if available buf_temp_xmllib_rec
     2887       then do:
     2888           run xmllib-parse-error in this-procedure (
     2889               input substitute( "Ошибка 2 открытия записи <&1>: Запись с этим именем и уровнем &2 уже открыта на строке &3."
     2890                               , p-rec-name
     2891                               , p-rec-level
     2892                               , buf_temp_xmllib_rec.recOpenLine
     2893                               )
     2894           ).
     2895       end.
     2896       else do:
     2897           assign
     2898               v-xmllib-rec-key    = v-xmllib-rec-key + 1
     2899           .
     2900           create buf_temp_xmllib_rec.
     2901           assign
     2902               buf_temp_xmllib_rec.rec-key         = v-xmllib-rec-key
     2903               buf_temp_xmllib_rec.recOpenLine     = v-xmllib-sax-reader-handle :locator-line-number
     2904               buf_temp_xmllib_rec.recCloseLine    = 0
     2905               buf_temp_xmllib_rec.recName         = p-rec-name
     2906               buf_temp_xmllib_rec.recLevel        = p-rec-level
     2907               buf_temp_xmllib_rec.closed          = no
     2908           .
     2909       end.
     2910   end.
     2911   end procedure.
     2912   procedure xmllib-parse-rec-fld-open :
     2913   define input parameter p-rec-name   as character        no-undo.
     2914   define input parameter p-rec-level  as integer          no-undo.
     2915   define input parameter p-fld-name   as character        no-undo.
     2916       define buffer buf_temp_xmllib_rec       for temp_xmllib_rec.
     2917       define buffer buf_temp_xmllib_rec-fld   for temp_xmllib_rec-fld.
     2918   do
     2919   for buf_temp_xmllib_rec
     2920     , buf_temp_xmllib_rec-fld
     2921   on error undo, return error substitute( "Ошибка в xmllib-parse-rec-fld-open. &1. &2. &3"
     2922                                           , return-value
     2923                                           , trim( error-status :get-message( 1 ) )
     2924                                           , trim( error-status :get-message( 2 ) ) )
     2925   :
     2926       find last buf_temp_xmllib_rec
     2927           where buf_temp_xmllib_rec.recName   = p-rec-name
     2928             and buf_temp_xmllib_rec.recLevel  = p-rec-level
     2929             and buf_temp_xmllib_rec.closed    = no
     2930       use-index nm
     2931       no-error.
     2932       if not available buf_temp_xmllib_rec
     2933       then do:
     2934           run xmllib-parse-error in this-procedure (
     2935               input substitute( "Ошибка 2 открытия поля <&2> в записи <&1> уровня &3: Нет открытой записи."
     2936                               , p-rec-name
     2937                               , p-fld-name
     2938                               , p-rec-level
     2939                               )
     2940           ).
     2941       end.
     2942       else do:
     2943           find last buf_temp_xmllib_rec-fld
     2944               where buf_temp_xmllib_rec-fld.rec-key  = buf_temp_xmllib_rec.rec-key
     2945                 and buf_temp_xmllib_rec-fld.fldName  = p-fld-name
     2946                 and buf_temp_xmllib_rec-fld.closed   = no
     2947           use-index nm
     2948           no-error.
     2949           if available buf_temp_xmllib_rec-fld
     2950           then do:
     2951               run xmllib-parse-error in this-procedure (
     2952                   input substitute( "Ошибка 3 открытия поля <&2> в записи <&1>: Поле с этим именем уже открыто на строке &3."
     2953                                   , p-rec-name
     2954                                   , p-fld-name
     2955                                   , buf_temp_xmllib_rec-fld.fldOpenLine
     2956                                   )
     2957               ).
     2958           end.
     2959           else do:
     2960               assign
     2961                   v-xmllib-rec-fld-key    = v-xmllib-rec-fld-key + 1
     2962               .
