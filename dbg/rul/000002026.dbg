     3637   procedure pdf-write :
     3638   define input  parameter p-pdf-id     as integer   no-undo .
     3639   define input  parameter p-pdf-db-num as integer   no-undo .
     3640   define input  parameter p-plt-id     as integer   no-undo .
     3641   define input  parameter p-plt-db-num as integer   no-undo .
     3642   define input  parameter p-attr-code as character no-undo .
     3643   define input  parameter p-attr-value as character no-undo .
     3644   define buffer buf_price-doc-forming-attr for ub.price-doc-forming-attr  .
     3645     do
     3646     on error undo, return error return-value
     3647     :
     3648     find first buf_price-doc-forming-attr exclusive-lock where
     3649                buf_price-doc-forming-attr.pdf-id     = p-pdf-id      and
     3650                buf_price-doc-forming-attr.pdf-db     = p-pdf-db-num  and
     3651                buf_price-doc-forming-attr.plt-id     = p-plt-id      and
     3652                buf_price-doc-forming-attr.plt-db-num = p-plt-db-num  and
