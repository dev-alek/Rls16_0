     3668   procedure pdf-value :
     3669   define input  parameter p-pdf-id     as integer   no-undo .
     3670   define input  parameter p-pdf-db-num as integer   no-undo .
     3671   define input  parameter p-plt-id     as integer   no-undo .
     3672   define input  parameter p-plt-db-num as integer   no-undo .
     3673   define input  parameter p-attr-code  as character no-undo .
     3674   define output parameter p-attr-value as character no-undo .
     3675   define buffer buf_price-doc-forming-attr for ub.price-doc-forming-attr  .
     3676     do
     3677     on error undo, return error return-value
     3678     :
     3679     p-attr-value = "" .
     3680     find first buf_price-doc-forming-attr exclusive-lock where
     3681                buf_price-doc-forming-attr.pdf-id     = p-pdf-id      and
     3682                buf_price-doc-forming-attr.pdf-db     = p-pdf-db-num  and
     3683                buf_price-doc-forming-attr.plt-id     = p-plt-id      and
     3684                buf_price-doc-forming-attr.plt-db-num = p-plt-db-num  and
     3685                buf_price-doc-forming-attr.attr-code  = p-attr-code
     3686                no-error .
     3687         if available buf_price-doc-forming-attr then do:
     3688            p-attr-value = buf_price-doc-forming-attr.attr-value .
     3689         end.
     3690     end.
     3691   end procedure.
     3692   define variable v-current-host-code as integer no-undo .
     3693   define variable v-current-obj-type as character no-undo .
