     2970   procedure xmlchar-encode :
     2971   define input parameter p-in-string      as character        no-undo.
     2972   define output parameter p-out-string    as character        no-undo.
     2973       define variable v-position      as integer      no-undo.
     2974       define variable v-current-char  as character    no-undo.
     2975   do
     2976   on error undo, return error
     2977   :
     2978       assign
     2979           p-out-string = "":U
     2980       .
     2981       case p-in-string
     2982       :
     2983           when ?
     2984           then do:
     2985               assign
     2986                   p-out-string = "?":U
     2987               .
     2988           end.
     2989           when "?":U
     2990           then do:
     2991               assign
     2992                   p-out-string = "&#63;":U
     2993               .
     2994           end.
     2995           otherwise do:
     2996               do v-position = 1 to length( p-in-string )
     2997               :
     2998                   assign
     2999                       v-current-char = substring( p-in-string, v-position, 1 )
     3000                   .
     3001                   case v-current-char
     3002                   :
     3003                       when "&":U
     3004                       then do:
     3005                           assign
     3006                               p-out-string = p-out-string + "&amp;":U
     3007                           .
     3008                       end.
     3009                       when ">":U
     3010                       then do:
     3011                           assign
     3012                               p-out-string = p-out-string + "&gt;":U
     3013                           .
     3014                       end.
     3015                       when "<":U
     3016                       then do:
     3017                           assign
     3018                               p-out-string = p-out-string + "&lt;":U
     3019                           .
     3020                       end.
     3021                       when "'":U
     3022                       then do:
     3023                           assign
     3024                               p-out-string = p-out-string + "&apos;":U
     3025                           .
     3026                       end.
     3027                       when '"':U
     3028                       then do:
     3029                           assign
     3030                               p-out-string = p-out-string + "&quot;":U
     3031                           .
     3032                       end.
     3033                       when chr(1)
     3034                       then do:
     3035                           assign
     3036                               p-out-string = p-out-string + "":U
     3037                           .
     3038                       end.
     3039                       when chr(2)
     3040                       then do:
     3041                           assign
     3042                               p-out-string = p-out-string + "":U
     3043                           .
     3044                       end.
     3045                       when chr(3)
     3046                       then do:
     3047                           assign
     3048                               p-out-string = p-out-string + "":U
     3049                           .
     3050                       end.
     3051                       when chr(4)
     3052                       then do:
     3053                           assign
     3054                               p-out-string = p-out-string + "":U
     3055                           .
     3056                       end.
     3057                       when chr(5)
     3058                       then do:
     3059                           assign
     3060                               p-out-string = p-out-string + "":U
     3061                           .
     3062                       end.
     3063                       when chr(6)
     3064                       then do:
     3065                           assign
     3066                               p-out-string = p-out-string + "":U
     3067                           .
     3068                       end.
     3069                       when chr(7)
     3070                       then do:
     3071                           assign
     3072                               p-out-string = p-out-string + "":U
     3073                           .
     3074                       end.
     3075                       when chr(8)
     3076                       then do:
     3077                           assign
     3078                               p-out-string = p-out-string + "":U
     3079                           .
     3080                       end.
     3081                       when chr(9)
     3082                       then do:
     3083                           assign
     3084                               p-out-string = p-out-string + "":U
     3085                           .
     3086                       end.
     3087                       when chr(29)
     3088                       then do:
     3089                           assign
     3090                               p-out-string = p-out-string + "":U
     3091                           .
     3092                       end.
     3093                       when chr(10)
     3094                       then do:
     3095                           assign
     3096                               p-out-string = p-out-string + "&#10;":U
     3097                           .
     3098                       end.
     3099                       when chr(13)
     3100                       then do:
     3101                           assign
     3102                               p-out-string = p-out-string + "&#13;":U
     3103                           .
     3104                       end.
     3105                       otherwise do:
     3106                           assign
     3107                               p-out-string = p-out-string + v-current-char
     3108                           .
     3109                       end.
     3110                   end case.
     3111               end.
     3112           end.
     3113       end case.
     3114   end.
     3115   end .
