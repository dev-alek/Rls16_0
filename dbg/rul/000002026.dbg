     3695   define variable v-current-lock as integer no-undo .
     3696   define variable v-current-wait as integer no-undo .
     3697   define variable v-save as integer no-undo .
     3698   define variable log-file-name                as character      no-undo .
     3699   define variable v-view-log                   as logical        no-undo .
     3700   define variable v-stop                       as logical        no-undo .
     3701   define variable v-current-db-num as integer no-undo .
     3702   define variable v-current-date as date no-undo .
     3703   define variable v-sign as integer no-undo .
     3704   define variable file-name as char.
     3705   define variable num-rec as integer no-undo .
     3706   define variable num-rec-ok as integer no-undo .
     3707   define variable v-full-path        as character no-undo .
