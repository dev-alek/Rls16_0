     5273             ,INPUT buf_clients.obj-code
     5274             ,INPUT buf_tot-dis-rule_.discnt-value
     5275             ,input table term_tt-dis-rule
     5276             ,input-output v-rid
     5277             ,input 'ДОБАВЛЕНИЕ':U
     5278             ,input yes
     5279             ) NO-ERROR.
     5280             if error-status:error then do:
     5281               v-err-mess = substitute("Ошибка при создании правила скидки на итог в &1&2:&3&4&3&5"
     5282                                       , buf_clients.obj-type
     5283                                       , buf_clients.obj-code
     5284                                       , chr(10)
     5285                                       , error-status:get-message(1)
     5286                                       , return-value
     5287                                       ).
     5288             end.
     5289           end.
     5290         end.
     5291       end case.
     5292     end.
     5293   end.
     5294   end procedure.
