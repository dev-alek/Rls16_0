     4872       ,output v-value-logical21
     4873       ,output v-param-type21
     4874       ,INPUT-OUTPUT table-handle v-tth21
     4875       )  .
     4876   delete object v-tth21 no-error.
     4877             find first buf_dis-thbj-rule share-lock where
     4878                       buf_dis-thbj-rule.obj-type = buf_clients.obj-type
     4879                   and buf_dis-thbj-rule.obj-code = buf_clients.obj-code
     4880                   and buf_dis-thbj-rule.host-code = buf_clients.host-code
     4881                   and buf_dis-thbj-rule.pos-type = dflt-cd
     4882                   and buf_dis-thbj-rule.discnt-role = 'pcnt-tot-kateg':U
     4883                   and buf_dis-thbj-rule.nonunique = '' no-error.
     4884             if available buf_dis-thbj-rule then do:
     4885               v-rule-num = buf_dis-thbj-rule.rule-num.
     4886               v-templ-rl-root = buf_dis-thbj-rule.templ-rl-root.
     4887               find first buf_Dis-rule exclusive-lock where
     4888                        buf_Dis-rule.rule-num = v-rule-num no-error.
     4889               delete buf_dis-thbj-rule no-error.
     4890               if error-status:error then do:
     4891                 v-err-mess = substitute("Ошибка при удалении привязки к правилу скидок на итог &1 (типа &2) по &3&4:&5&6&5&7"
     4892                                         , v-rule-num
     4893                                         , v-templ-rl-root
     4894                                         , buf_clients.obj-type
     4895                                         , buf_clients.obj-code
     4896                                         , chr(10)
     4897                                         , error-status:get-message(1)
     4898                                         , return-value
     4899                                         ).
     4900                 undo main-block, retry main-block .
     4901               end.
     4902               if available buf_dis-rule then do:
     4903                 run ref/disrul30.p (
     4904                                   buffer buf_dis-rule
     4905                                 ) no-error.
     4906                 if error-status:error then do:
     4907                   v-err-mess = substitute("Ошибка при удалении правила скидок на итог &1 (типа &2):&3&4&3&5"
     4908                                           , v-rule-num
