     3710   define variable v-file-name-no-ext as character no-undo .
     3711   define variable v-file-name-ext    as character no-undo .
     3712   define variable v-end-new-line     as logical no-undo .
     3713   define variable v-last-error-message as character no-undo .
     3714   define variable v-retry-action as integer no-undo .
