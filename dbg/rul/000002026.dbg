     4978                   if not available buf_term-dis-rule
     4979                   and term_tot-dis-rule_.status_ <> 'N' then do:
     4980                     v-err-mess = substitute("Ошибка при изменении правила скидок на итог &1 (типа &2)&3нет ветки с суммой &4"
     4981                                             , v-rule-num
     4982                                             , v-templ-rl-root
     4983                                             , chr(10)
     4984                                             , term_tot-dis-rule_.tot-sum
