     4831   define buffer buf_dis-thbj-rule for ub.dis-thbj-rule.
     4832   define buffer term_tt-dis-rule for tt-dis-rule.
     4833   main-block:
     4834   do transaction
     4835   on error  undo main-block, retry main-block
     4836   on stop   undo main-block, retry main-block
     4837   on endkey undo main-block, retry main-block
     4838   :
     4839     if retry then do:
     4840       empty temp-table tot-dis-rule_.
     4841           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input v-err-mess).
     4842       return error ''.
     4843     end.
     4844     else do:
     4845       case p-status_:
     4846         when 'D'  then do:
     4847           for each buf_clients no-lock where
     4848                   buf_clients.db-num = g#db-num
     4849               and buf_clients.obj-type = 'маг':U
     4850           on error  undo main-block, retry main-block
     4851           on stop   undo main-block, retry main-block
     4852           on endkey undo main-block, retry main-block
     4853           :
     4854             dflt-cd = ''.
     4855   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4856   define variable v-param-type21 as character no-undo .
     4857   define variable v-value-date21 as date no-undo .
