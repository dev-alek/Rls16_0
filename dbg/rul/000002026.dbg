     3659                buf_price-doc-forming-attr.pdf-db     = p-pdf-db-num
     3660                buf_price-doc-forming-attr.plt-id     = p-plt-id
     3661                buf_price-doc-forming-attr.plt-db-num = p-plt-db-num
     3662                buf_price-doc-forming-attr.attr-code  = p-attr-code
     3663            .
     3664         end.
     3665         buf_price-doc-forming-attr.attr-value = p-attr-value .
     3666     end.
