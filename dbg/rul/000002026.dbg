     3226   procedure xmlchar-decode :
     3227   define input parameter p-in-string      as character        no-undo.
     3228   define output parameter p-out-string    as character        no-undo.
     3229       define variable v-position      as integer      no-undo.
     3230       define variable v-last-position as integer      no-undo.
     3231       define variable v-temp-integer  as integer      no-undo.
     3232       define variable v-current-char  as character    no-undo.
     3233       define variable v-next-char     as character    no-undo.
     3234       define variable v-success       as logical      no-undo.
     3235   do
     3236   on error undo, return error
     3237   :
     3238       assign
     3239           p-out-string = "":U
     3240           v-position   = 0
     3241       .
     3242       replace-cycle:
     3243       do while yes
     3244       on error undo, return error
     3245       :
     3246           assign
     3247               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     3248           .
     3249           if v-last-position <= v-position
     3250           then do:
     3251               if v-position = 0
     3252               then do:
     3253                   assign
     3254                       p-out-string = p-in-string
     3255                   .
     3256               end.
     3257               else do:
     3258                   assign
     3259                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     3260                   .
     3261               end.
     3262               leave replace-cycle.
     3263           end.
     3264           else do:
     3265               assign
     3266                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     3267                   v-position      = v-last-position
     3268                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     3269               .
     3270               if v-current-char = "#":U
     3271               then do:
     3272                   assign
     3273                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     3274                   .
     3275                   if v-last-position > 0
     3276                   then do:
     3277                       run xmlchar-read-integer in this-procedure
     3278                        (
     3279                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     3280                           , output v-temp-integer
     3281                           , output v-success
     3282                       ).
     3283                       if v-success = yes
     3284                       and v-temp-integer >= 1
     3285                       and v-temp-integer <= 255
     3286                       then do:
     3287                           assign
     3288                               p-out-string = p-out-string + chr( v-temp-integer )
     3289                               v-position   = v-last-position + 1
     3290                           .
     3291                       end.
     3292                       else do:
     3293                           assign
     3294                               p-out-string = p-out-string + "&":U
     3295                               v-position   = v-position   + 1
     3296                           .
     3297                       end.
     3298                   end.
     3299                   else do:
     3300                       assign
     3301                           p-out-string = p-out-string + "&":U
     3302                           v-position   = v-position   + 1
     3303                       .
     3304                   end.
     3305               end.
     3306               else do:
     3307                   case substring( p-in-string, v-position + 1, 3 )
     3308                   :
     3309                       when "lt;":U
     3310                       then do:
     3311                           assign
     3312                               p-out-string = p-out-string + "<":U
     3313                               v-position   = v-position   + 3
     3314                           .
     3315                       end.
     3316                       when "gt;":U
     3317                       then do:
     3318                           assign
     3319                               p-out-string = p-out-string + ">":U
     3320                               v-position   = v-position   + 3
     3321                           .
     3322                       end.
     3323                       otherwise do:
     3324                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     3325                           then do:
     3326                               assign
     3327                                   p-out-string = p-out-string + "&":U
     3328                                   v-position   = v-position   + 4
     3329                               .
     3330                           end.
     3331                           else do:
     3332                               case substring( p-in-string, v-position + 1, 5 )
     3333                               :
     3334                                   when "quot;":U
     3335                                   then do:
     3336                                       assign
     3337                                           p-out-string = p-out-string + '"':U
     3338                                           v-position   = v-position   + 5
     3339                                       .
     3340                                   end.
     3341                                   when "apos;":U
     3342                                   then do:
     3343                                       assign
     3344                                           p-out-string = p-out-string + "'":U
     3345                                           v-position   = v-position   + 5
     3346                                       .
     3347                                   end.
     3348                                   otherwise do:
     3349                                       assign
     3350                                           p-out-string = p-out-string + "&":U
     3351                                       .
     3352                                   end.
     3353                               end case.
     3354                           end.
     3355                       end.
     3356                   end case.
     3357               end.
     3358           end.
     3359       end.
     3360   end.
     3361   end .
     3362   procedure xmlchar-read-integer :
     3363   define input parameter p-input-string      as character        no-undo.
     3364   define output parameter p-output-integer   as integer          no-undo.
     3365   define output parameter p-success       as logical          no-undo.
     3366   do
     3367   on error undo, return error
     3368   :
     3369       assign
     3370           p-output-integer = integer( p-input-string )
     3371       no-error.
     3372       if error-status :error
     3373       then do:
     3374           assign
     3375               p-success           = no
     3376               p-output-integer    = 0
     3377           .
     3378       end.
     3379       else do:
     3380           assign
     3381               p-success           = yes
     3382           .
     3383       end.
     3384   end.
     3385   end.
     3386   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3387   define temp-table temp-rel-handle no-undo
     3388   field dh as handle
     3389   field ii as integer
     3390   field active_ as logical
     3391   field child-buffer_ as character
     3392   field parent-buffer_ as character
     3393   field child-buffer-handle as handle
     3394   field parent-buffer-handle as handle
     3395   field name_ as character
     3396   field nested_ as logical
     3397   field relation-fields_ as character
     3398   field reposition_ as logical
     3399   field type_ as character
     3400   field query_ as handle
     3401   field where-string_ as character
     3402   field tbl-handle_ as handle
     3403   index pi is unique primary
     3404   ii
     3405   index iparentname parent-buffer_ child-buffer_
     3406   index iparenthandle parent-buffer-handle child-buffer-handle
     3407   .
     3408   procedure tmpreldf_get-relations :
     3409   define input parameter p-dataseth as handle no-undo .
     3410   define variable v-ii as integer no-undo .
     3411   define buffer buf_temp-rel-handle for temp-rel-handle.
     3412   do
     3413   on error undo, return error
     3414   :
     3415     if not valid-handle(p-dataseth)
     3416     or p-dataseth:type <> "DATASET"
     3417     then do:
     3418       return error substitute("Не определен dataset с handle &1", p-dataseth).
     3419     end.
     3420     for each buf_temp-rel-handle where
     3421             buf_temp-rel-handle.dh = p-dataseth:
     3422       delete buf_temp-rel-handle.
     3423     end.
     3424     do v-ii = 1 to p-dataseth:num-relations:
     3425       create buf_temp-rel-handle.
     3426       assign
     3427       buf_temp-rel-handle.ii = v-ii
     3428       buf_temp-rel-handle.dh = p-dataseth
     3429       buf_temp-rel-handle.active_ = p-dataseth:get-relation(v-ii):active
     3430       buf_temp-rel-handle.child-buffer_ = p-dataseth:get-relation(v-ii):child-buffer:name
     3431       buf_temp-rel-handle.parent-buffer_ = p-dataseth:get-relation(v-ii):parent-buffer:name
     3432       buf_temp-rel-handle.child-buffer-handle = p-dataseth:get-relation(v-ii):child-buffer
     3433       buf_temp-rel-handle.tbl-handle_ = buf_temp-rel-handle.child-buffer-handle
     3434       buf_temp-rel-handle.parent-buffer-handle = p-dataseth:get-relation(v-ii):parent-buffer
     3435       buf_temp-rel-handle.name_ = p-dataseth:get-relation(v-ii):name
     3436       buf_temp-rel-handle.nested_ = p-dataseth:get-relation(v-ii):nested
     3437       buf_temp-rel-handle.relation-fields_ = p-dataseth:get-relation(v-ii):relation-fields
     3438       buf_temp-rel-handle.reposition_ = p-dataseth:get-relation(v-ii):reposition
     3439       buf_temp-rel-handle.type_ = p-dataseth:get-relation(v-ii):type
     3440       buf_temp-rel-handle.query_ = p-dataseth:get-relation(v-ii):query
     3441       buf_temp-rel-handle.where-string_ = p-dataseth:get-relation(v-ii):where-string
     3442       .
     3443     end.
     3444   end.
     3445   end procedure.
     3446   procedure tmpreldf_set-relations :
     3447   define input parameter p-srcdataseth as handle no-undo .
     3448   define input parameter p-trgdataseth as handle no-undo .
     3449   define variable gh as handle no-undo .
     3450   define buffer buf_temp-rel-handle for temp-rel-handle.
     3451   do
     3452   on error undo, return error
     3453   :
     3454     if not valid-handle(p-srcdataseth)
     3455     or p-srcdataseth:type <> "DATASET"
     3456     then do:
     3457       return error substitute("Не определен dataset-источник с handle &1", p-srcdataseth).
     3458     end.
     3459     if not valid-handle(p-trgdataseth)
     3460     or p-trgdataseth:type <> "DATASET"
     3461     then do:
     3462       return error substitute("Не определен dataset-приемник с handle &1", p-trgdataseth).
     3463     end.
     3464     for each buf_temp-rel-handle no-lock where
     3465             buf_temp-rel-handle.dh = p-srcdataseth
     3466     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3467     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     3468     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     3469     :
     3470       gh = p-trgdataseth:ADD-RELATION ( buf_temp-rel-handle.parent-buffer-handle
     3471                                         , buf_temp-rel-handle.child-buffer-handle
     3472                                         , buf_temp-rel-handle.relation-fields_
     3473                                         , buf_temp-rel-handle.reposition_
     3474                                         , buf_temp-rel-handle.nested_).
     3475      if error-status:error
     3476      or not valid-handle(gh) then do:
     3477        undo, return error substitute("Ошибка при добавлении relation &1 в dataset &2", buf_temp-rel-handle.name, p-trgdataseth:name).
     3478      end.
     3479     end.
     3480   end.
     3481   end procedure.
     3482   procedure tmpreld2_query :
     3483   define  parameter buffer buf_temp-rel-handle for temp-rel-handle.
     3484   define input-output parameter p-child-qh as handle no-undo .
     3485   define variable glog as logical no-undo .
     3486   define variable v-mess as character no-undo .
     3487   _main:
     3488   do
     3489   on error undo, return error
     3490   :
     3491     create query p-child-qh .
     3492     glog = p-child-qh:set-buffers( buf_temp-rel-handle.child-buffer-handle) no-error.
     3493     if error-status:error
     3494     or
     3495     not glog then do:
     3496       v-mess = substitute("Ошибка при попытке получить записи &1&2&3"
     3497                           , buf_temp-rel-handle.child-buffer_
     3498                           , chr(10)
     3499                           , error-status:get-message(1)
     3500                           ).
     3501       delete object p-child-qh no-error.
     3502       undo _main, return error v-mess.
     3503     end.
     3504     glog = p-child-qh:query-prepare( substitute( "for each &1 &2 "
     3505                                               , buf_temp-rel-handle.child-buffer_
     3506                                               , buf_temp-rel-handle.where-string_
     3507                                               )) no-error .
     3508     if error-status:error
     3509     or
     3510     not glog then do:
     3511       v-mess =  substitute("Ошибка при попытке получить записи &1&2&3"
     3512                           , buf_temp-rel-handle.child-buffer_
     3513                           , chr(10)
     3514                           , error-status:get-message(1)
     3515                           ).
     3516       delete object p-child-qh no-error.
     3517       undo _main, return error v-mess.
     3518     end.
     3519     glog = p-child-qh:query-open no-error .
     3520     if error-status:error
     3521     or
     3522     not glog then do:
     3523       v-mess = substitute("Ошибка при попытке получить записи &1&2&3"
     3524                           , buf_temp-rel-handle.child-buffer_
     3525                           , chr(10)
     3526                           , error-status:get-message(1)
     3527                           ).
     3528       delete object p-child-qh no-error.
     3529       undo _main, return error v-mess.
     3530     end.
     3531   end.
     3532   end procedure.
     3533   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3534   procedure del-pdf-attr-objdel :
     3535   define input  parameter p-pdf-id     as integer   no-undo .
     3536   define input  parameter p-pdf-db-num as integer   no-undo .
     3537   define input  parameter p-plt-id     as integer   no-undo .
     3538   define input  parameter p-plt-db-num as integer   no-undo .
     3539   define input  parameter p-obj-type   as character no-undo .
     3540   define input  parameter p-obj-code   as integer   no-undo .
     3541   define buffer buf_price-doc-forming-attr for ub.price-doc-forming-attr  .
     3542     do
     3543     on error undo, return error return-value
     3544     :
     3545     find first buf_price-doc-forming-attr exclusive-lock where
     3546                buf_price-doc-forming-attr.pdf-id     = p-pdf-id      and
     3547                buf_price-doc-forming-attr.pdf-db     = p-pdf-db-num  and
     3548                buf_price-doc-forming-attr.plt-id     = p-plt-id      and
     3549                buf_price-doc-forming-attr.plt-db-num = p-plt-db-num  and
     3550                buf_price-doc-forming-attr.attr-code  = "obj" + p-obj-type + string(p-obj-code)
     3551                no-error .
     3552         if available buf_price-doc-forming-attr then do:
     3553            delete buf_price-doc-forming-attr .
     3554         end.
     3555     end.
     3556   end procedure.
     3557   procedure ins-pdf-attr-objdel :
     3558   define input  parameter p-pdf-id     as integer   no-undo .
     3559   define input  parameter p-pdf-db-num as integer   no-undo .
     3560   define input  parameter p-plt-id     as integer   no-undo .
     3561   define input  parameter p-plt-db-num as integer   no-undo .
     3562   define input  parameter p-obj-type   as character no-undo .
     3563   define input  parameter p-obj-code   as integer   no-undo .
     3564   define buffer buf_price-doc-forming-attr for ub.price-doc-forming-attr  .
     3565     do
     3566     on error undo, return error return-value
     3567     :
     3568     find first buf_price-doc-forming-attr exclusive-lock where
     3569                buf_price-doc-forming-attr.pdf-id     = p-pdf-id      and
     3570                buf_price-doc-forming-attr.pdf-db     = p-pdf-db-num  and
     3571                buf_price-doc-forming-attr.plt-id     = p-plt-id      and
     3572                buf_price-doc-forming-attr.plt-db-num = p-plt-db-num  and
     3573                buf_price-doc-forming-attr.attr-code  = "obj" + p-obj-type + string(p-obj-code)
     3574                no-error .
     3575         if not available  buf_price-doc-forming-attr then do:
     3576            create buf_price-doc-forming-attr.
     3577            assign
     3578                buf_price-doc-forming-attr.pdf-id     = p-pdf-id
     3579                buf_price-doc-forming-attr.pdf-db     = p-pdf-db-num
     3580                buf_price-doc-forming-attr.plt-id     = p-plt-id
     3581                buf_price-doc-forming-attr.plt-db-num = p-plt-db-num
     3582                buf_price-doc-forming-attr.attr-code  = "obj" + p-obj-type + string(p-obj-code)
     3583                buf_price-doc-forming-attr.attr-value = ""
     3584            .
     3585         end.
     3586     end.
     3587   end procedure.
     3588   procedure ex-pdf-attr-objdel :
     3589   define input  parameter p-pdf-id     as integer   no-undo .
     3590   define input  parameter p-pdf-db-num as integer   no-undo .
     3591   define input  parameter p-plt-id     as integer   no-undo .
     3592   define input  parameter p-plt-db-num as integer   no-undo .
     3593   define input  parameter p-obj-type   as character no-undo .
     3594   define input  parameter p-obj-code   as integer   no-undo .
     3595   define output parameter p-exist      as logical   no-undo .
     3596   define buffer buf_price-doc-forming-attr for ub.price-doc-forming-attr  .
     3597     do
     3598     on error undo, return error return-value
     3599     :
     3600     p-exist = false .
     3601     find first buf_price-doc-forming-attr exclusive-lock where
     3602                buf_price-doc-forming-attr.pdf-id     = p-pdf-id      and
     3603                buf_price-doc-forming-attr.pdf-db     = p-pdf-db-num  and
     3604                buf_price-doc-forming-attr.plt-id     = p-plt-id      and
     3605                buf_price-doc-forming-attr.plt-db-num = p-plt-db-num  and
     3606                buf_price-doc-forming-attr.attr-code  = "obj" + p-obj-type + string(p-obj-code)
     3607                no-error .
     3608         if available buf_price-doc-forming-attr then do:
     3609            p-exist = true .
     3610         end.
     3611     end.
     3612   end procedure.
     3613   procedure pdf-exist :
     3614   define input  parameter p-pdf-id     as integer   no-undo .
     3615   define input  parameter p-pdf-db-num as integer   no-undo .
     3616   define input  parameter p-plt-id     as integer   no-undo .
     3617   define input  parameter p-plt-db-num as integer   no-undo .
     3618   define input  parameter p-attr-code as character no-undo .
     3619   define output parameter p-exist      as logical   no-undo .
     3620   define buffer buf_price-doc-forming-attr for ub.price-doc-forming-attr  .
     3621     do
     3622     on error undo, return error return-value
     3623     :
     3624     p-exist = false .
