     3716   define variable v-xmlh as handle no-undo .
     3717   define variable v_qh as handle no-undo .
     3718   define variable glog as logical no-undo .
     3719   define variable v-esys-id as integer no-undo .
     3720   define variable v-extension as character no-undo .
     3721   define variable v-last-rec-ord as integer no-undo .
     3722   define variable v-err-type as character no-undo .
     3723   define variable v-pck-num as integer no-undo .
     3724   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3725   procedure set-error :
     3726   define input parameter p-mess as character no-undo .
     3727     do
     3728     on error undo, return error
     3729     :
     3730        assign
     3731        v-last-error-message = p-mess.
     3732     end.
     3733   end procedure.
     3734   define buffer buf_temp-cmd for temp-cmd.
     3735   define temp-table tt-dis-rule no-undo like ub.dis-rule.
     3736   define temp-table tot-dis-rule_ no-undo like ub.dis-rule
     3737   field status_ as character
     3738   .
     3739   define temp-table temp-dis-rule_ no-undo like ub.dis-rule
     3740   field pos-type as character
     3741   field status_ as character
     3742   .
     3743   define temp-table temp-dis-gds-rule_ no-undo like ub.dis-gds-rule
     3744   field status_ as character
     3745   .
     3746   define buffer buf_temp-xml-tables for temp-xml-tables.
     3747   function 00200004_get-error-message returns character :
     3748   define variable v-ii as integer no-undo .
     3749   define variable v-mess as character no-undo .
     3750   DO v-ii = 1 TO ERROR-STATUS:NUM-MESSAGES:
     3751       v-mess = substitute("&1&2ош &3"
     3752                           ,v-mess
     3753                           ,chr(10)
     3754                           ,ERROR-STATUS:GET-MESSAGE(v-ii)).
     3755   END.
     3756   return v-mess.
     3757   end function.
     3758   function 00200004_after-import_f returns logical ( input p-d-card as character):
     3759     run 00200004_after-import in this-procedure ( input p-d-card) no-error.
     3760     run set-error in this-procedure ( input return-value ).
     3761     return not (error-status:error).
     3762   end function.
     3763   define variable p-esys-id as integer no-undo .
     3764   define variable p-xsd-file as character no-undo.
     3765   on delete of this-procedure do:
     3766     run delete-procedure in this-procedure .
     3767     run gate-clear in this-procedure ( input v_dataseth, input v-xmlh) no-error.
     3768   end.
     3769   run load-ruleset-context in this-procedure ( input p-ruleset-id) no-error .
     3770   if error-status:error
     3771   or return-value = "return" then return error.
     3772   define variable ImpData1 as class Route-data_ no-undo .
     3773   ImpData1 = new Route-data_( input parparentproc, input p-parent-handle, input p-log-handle, input this-procedure:handle, input v_dataseth, input v-xmlh) .
     3774   if not this-procedure:persistent then do:
     3775     run proc-main in this-procedure no-error .
     3776     if error-status:error then do:
     3777         run delete-procedure in this-procedure .
     3778         undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     3779     end.
     3780     run delete-procedure in this-procedure .
     3781   end.
     3782   procedure proc-main :
     3783   define variable v-mode as character no-undo .
     3784   define variable v-line-num as integer no-undo .
     3785   define variable v-present as logical no-undo .
     3786   define variable v-current-tbl-name as character no-undo .
     3787   define variable v_child-qh as handle no-undo .
     3788   define variable v_child2-qh as handle no-undo .
     3789   define variable v-status_ as character no-undo .
     3790   define variable v-category_id as integer no-undo .
     3791   define variable v-discnt-type as character no-undo .
     3792   define variable v-category-name as character no-undo .
     3793   define variable v-dtl_id as integer no-undo .
     3794   define variable v-b-dtl_id as integer no-undo .
     3795   define variable v-dtl-category_id as integer no-undo .
     3796   define variable v-b-category_id as integer no-undo .
     3797   define variable v-discnt as decimal no-undo .
     3798   define variable v-dtl-status_ as character no-undo .
     3799   define variable v-b-code as integer no-undo .
     3800   define variable v-cat-item-status_ as character no-undo .
     3801   define variable v-threshold as decimal no-undo .
     3802   define variable v-rid as recid no-undo .
     3803   define buffer buf_tot-dis-rule_ for tot-dis-rule_.
     3804   define buffer term_tot-dis-rule_ for tot-dis-rule_.
     3805   define buffer buf_temp-dis-rule_ for temp-dis-rule_.
     3806   define buffer buf_temp-dis-gds-rule_ for temp-dis-gds-rule_.
     3807   define buffer buf_temp-rel-handle for temp-rel-handle.
     3808   define buffer buf2_temp-rel-handle for temp-rel-handle.
     3809   define buffer buf_Dis-rule for ub.dis-rule.
     3810   define buffer buf_dis-time-rule for ub.dis-time-rule.
     3811   _main:
     3812   do transaction
     3813   on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3814   on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
     3815   on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
     3816   :
     3817   run write-log  in p-log-handle (
     3818                                    input 0
     3819                                  , "&DLine").
     3820     run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute(".............Импорт данных по скидкам из ВС")).
     3821   run write-log-and-file in p-log-handle (
     3822         input 1
     3823       , input log-file-name
     3824       , input 1
     3825       , input substitute("Импорт данных по скидкам из файла &1", file-name)).
     3826   for each buf_temp-xml-tables where
     3827          buf_temp-xml-tables.order >= 0
     3828      and buf_temp-xml-tables.is-parent = yes
     3829   :
     3830     if buf_temp-xml-tables.tbl-name = "Header_" then next.
     3831     create query v_qh.
     3832     glog = v_qh:set-buffers( buf_temp-xml-tables.tbl-handle_) no-error.
     3833     if error-status:error
     3834     or
     3835     not glog then do:
     3836           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при попытке получить записи &1&2&3&2&4"                                                             , buf_temp-xml-tables.tbl-name                                                             , chr(10)                                                             , error-status:get-message(1)                                                             , return-value)).
     3837       undo _main, return error ''.
     3838     end.
     3839     glog = v_qh:query-prepare( substitute( "for each &1 by &1.line-num", buf_temp-xml-tables.tbl-name)) no-error .
     3840     if error-status:error
     3841     or
     3842     not glog then do:
     3843           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при попытке получить записи &1&2&3&2&4"                                                             , buf_temp-xml-tables.tbl-name                                                             , chr(10)                                                             , error-status:get-message(1)                                                             , return-value)).
     3844       if valid-handle(v_qh) then do:
     3845         delete object v_qh no-error.
     3846       end.
     3847       undo _main, return error ''.
     3848     end.
     3849     glog = v_qh:query-open no-error .
     3850     if error-status:error
     3851     or not glog then do:
     3852           .
     3853       if valid-handle(v_qh) then do:
     3854         delete object v_qh no-error.
     3855       end.
     3856       undo _main, return error ''.
     3857     end.
     3858       _stroka:
     3859       REPEAT:
     3860         v-retry-action = 0 .
     3861        _release:
     3862         do on error undo, retry:
     3863           if  retry then do:
     3864             v-retry-action = v-retry-action + 1.
     3865                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при импорте записи &5 &1&2&3&2&4"                                                                   , buf_temp-xml-tables.tbl-name                                                                   , num-rec                                                                   , chr(10)                                                                   , error-status:get-message(1)                                                                   , return-value)).
     3866             if valid-handle(v_qh) then do:
     3867               delete object v_qh no-error.
     3868             end.
     3869             undo _main, return error ''.
     3870           end.
     3871           if v-retry-action < 1 then do:
     3872                       ImpData1:Route-data_dump ( ) .
     3873           end.
     3874         end.
     3875         _rule:
     3876          do on error undo _rule, retry _rule:
     3877            if retry then do:
     3878             empty temp-table buf_tot-dis-rule_.
     3879             empty temp-table buf_temp-dis-rule_.
     3880             empty temp-table buf_temp-dis-gds-rule_.
     3881              if valid-handle(v_qh) then do:
     3882                delete object v_qh no-error.
     3883              end.
     3884              if valid-handle(v_child-qh) then do:
     3885                delete object v_child-qh no-error.
     3886              end.
     3887              if valid-handle(v_child2-qh) then do:
     3888                delete object v_child2-qh no-error.
     3889              end.
     3890                        run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("&1&2&3"                                       , error-status:get-message(1)                                       , chr(10)                                       , return-value)).
     3891              undo _main, return error ''.
     3892            end.
     3893            else do:
     3894             v_qh:get-next().
     3895             IF v_qh:query-off-end then leave _stroka.
     3896             assign
     3897             v-current-tbl-name = ''
     3898             v-current-tbl-name = ImpData1:current-tbl-name() no-error.
     3899             case v-current-tbl-name:
     3900               when "category"  THEN do:
     3901                 empty temp-table buf_tot-dis-rule_.
     3902                 empty temp-table buf_temp-dis-rule_.
     3903                 empty temp-table buf_temp-dis-gds-rule_.
     3904                 _tr:
     3905                 do
     3906                 on error undo _rule, retry _rule
     3907                 :
     3908                   v-line-num = ImpData1:route-data_get-field-integer( input "Category", input "line-num") .
     3909                   v-present = no.
     3910                   num-rec = num-rec + 1.
     3911                   v-line-num = ImpData1:route-data_get-field-integer( input "category", input "line-num") .
     3912                   v-status_ = ImpData1:route-data_get-field-character( input "category", input "status_") .
     3913                   v-category_id = ImpData1:route-data_get-field-integer( input "category", input "category_id") .
     3914                   v-discnt-type = ImpData1:route-data_get-field-character( input "category", input "discnt-type") .
     3915                   v-category-name = ImpData1:route-data_get-field-character( input "category", input "category_name") .
     3916                   case v-discnt-type :
     3917                     when "temp-disc" then do:
     3918                     end.
     3919                     when "pcnt-tot-kateg" then do:
     3920                       find first buf_tot-dis-rule_ where
     3921                                 buf_tot-dis-rule_.rule-num = v-category_id no-error.
     3922                       if not available buf_tot-dis-rule_ then do:
     3923                         find first buf_dis-rule no-lock where
     3924                                   buf_Dis-rule.rule-num = 20.
     3925                         create  buf_tot-dis-rule_.
     3926                         buffer-copy buf_dis-rule except
     3927                         rule-num
     3928                         time-templ-rl-root
     3929                         root
     3930                         rl-root
     3931                         host-code
     3932                         obj-type
     3933                         obj-code
     3934                         lvl-num
     3935                         is-term
     3936                         sts
     3937                         time-rule-num
     3938                         upper-rule-num
     3939                         to buf_tot-dis-rule_
     3940                         assign
     3941                         buf_tot-dis-rule_.rule-num = v-category_id
     3942                         buf_tot-dis-rule_.templ-rl-root = buf_dis-rule.rule-num
     3943                         buf_tot-dis-rule_.time-templ-rl-root = 0
     3944                         buf_tot-dis-rule_.root = yes
     3945                         buf_tot-dis-rule_.rl-root = buf_tot-dis-rule_.rule-num
     3946                         buf_tot-dis-rule_.host-code = 0
     3947                         buf_tot-dis-rule_.obj-type = ''
     3948                         buf_tot-dis-rule_.obj-code = 0
     3949                         buf_tot-dis-rule_.is-term = no
     3950                         buf_tot-dis-rule_.lvl-num = 1
     3951                         buf_tot-dis-rule_.sts = integer('0':U)
     3952                         buf_tot-dis-rule_.time-rule-num = 0
     3953                         buf_tot-dis-rule_.upper-rule-num = buf_dis-rule.rule-num
     3954                         .
     3955                       end.
     3956                       assign
     3957                       buf_tot-dis-rule_.des = v-category-name
     3958                       buf_tot-dis-rule_.status_ = v-status_
     3959                       .
     3960                     end.
     3961                   end case.
     3962                   _rel:
     3963                   for each buf_temp-rel-handle where
     3964                           buf_temp-rel-handle.parent-buffer_ = v-current-tbl-name:
     3965                     run tmpreld2_query in this-procedure ( buffer buf_temp-rel-handle, input-output v_child-qh) no-error.
     3966                     if error-status:error then do:
     3967                                           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input return-value).
     3968                       undo _rule, retry _rule.
     3969                     end.
     3970                       _child:
     3971                       repeat:
     3972                         v_child-qh:get-next().
     3973                         IF v_child-qh:query-off-end then do:
     3974                           delete object v_child-qh no-error.
     3975                           next _rel.
     3976                         end.
     3977                         v-dtl_id = ImpData1:route-data_get-field-integer( buffer buf_temp-rel-handle:handle, input buf_temp-rel-handle.child-buffer_ , input "dtl_id") .
     3978                         v-dtl-category_id = ImpData1:route-data_get-field-integer( buffer buf_temp-rel-handle:handle, input buf_temp-rel-handle.child-buffer_ , input "category_id") .
     3979                         v-discnt = ImpData1:route-data_get-field-decimal( buffer buf_temp-rel-handle:handle, input buf_temp-rel-handle.child-buffer_ , input "discount") .
     3980                         v-dtl-status_ = ImpData1:route-data_get-field-character( buffer buf_temp-rel-handle:handle, input buf_temp-rel-handle.child-buffer_ , input "status_") .
     3981                         if v-dtl-category_id <> v-category_id then do:
     3982                                                   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Запись &1: нарушение схемы")).
     3983                           delete object v_child-qh no-error.
     3984                           undo _rule, retry _rule.
     3985                         end.
     3986                         case buf_temp-rel-handle.child-buffer_:
     3987                           when "cat-dtl" THEN do:
     3988                             case v-discnt-type:
     3989                               when "temp-disc" then do:
     3990                                 define variable v-jj as integer no-undo .
     3991                                 define variable v-pos-type as character no-undo .
     3992                                 do v-jj = 1 to 2:
     3993                                   if v-jj = 1 then do:
     3994                                     find first buf_dis-rule no-lock where
     3995                                               buf_dis-rule.rule-num = 82 .
     3996                                     v-pos-type = 'IBM':U.
     3997                                   end.
     3998                                   if v-jj = 2 then do:
     3999                                     find first buf_dis-rule no-lock where
     4000                                               buf_dis-rule.rule-num = 85 .
     4001                                     v-pos-type = 'IBS-TH':U.
     4002                                   end.
     4003                                   find first buf_temp-dis-rule_ where
     4004                                             buf_temp-dis-rule_.rule-num = v-dtl_id
     4005                                         and buf_temp-dis-rule_.templ-rl-root = buf_dis-rule.rule-num
     4006                                         no-error.
     4007                                   if not available buf_temp-dis-rule_ then do:
     4008                                     find first buf_dis-time-rule no-lock where
     4009                                               buf_dis-time-rule.templ-rl-root = 50001 .
     4010                                     create  buf_temp-dis-rule_.
     4011                                     buffer-copy buf_dis-rule
     4012                                     except
     4013                                     rule-num
     4014                                     time-templ-rl-root
     4015                                     root
     4016                                     rl-root
     4017                                     host-code
     4018                                     obj-type
     4019                                     obj-code
     4020                                     lvl-num
     4021                                     is-term
     4022                                     sts
     4023                                     time-rule-num
     4024                                     upper-rule-num
     4025                                     to
     4026                                     buf_temp-dis-rule_
     4027                                     assign
     4028                                     buf_temp-dis-rule_.rule-num = v-dtl_id
     4029                                     buf_temp-dis-rule_.time-templ-rl-root = 50001
     4030                                     buf_temp-dis-rule_.root = yes
     4031                                     buf_temp-dis-rule_.rl-root = v-dtl_id
     4032                                     buf_temp-dis-rule_.host-code = 0
     4033                                     buf_temp-dis-rule_.obj-type = ''
     4034                                     buf_temp-dis-rule_.obj-code = 0
     4035                                     buf_temp-dis-rule_.lvl-num = 1
     4036                                     buf_temp-dis-rule_.is-term = yes
     4037                                     buf_temp-dis-rule_.sts = integer('0':U)
     4038                                     buf_temp-dis-rule_.time-rule-num = buf_dis-time-rule.time-rule-num
     4039                                     buf_temp-dis-rule_.upper-rule-num =  buf_dis-rule.rule-num
     4040                                     buf_temp-dis-rule_.pos-type = v-pos-type
     4041                                     .
     4042                                   end.
     4043                                   buf_temp-dis-rule_.des = v-category-name.
     4044                                   buf_temp-dis-rule_.status_ = v-dtl-status_.
     4045                                   buf_temp-dis-rule_.discnt-value = v-discnt.
     4046                                   release buf_temp-dis-rule_.
     4047                                 end.
     4048                                 for each buf_temp-dis-rule_:
     4049                                 _rel2:
     4050                                 for each buf2_temp-rel-handle where
     4051                                         buf2_temp-rel-handle.parent-buffer_ = "cat-dtl":
     4052                                   run tmpreld2_query in this-procedure ( buffer buf2_temp-rel-handle, input-output v_child2-qh) no-error .
     4053                                   if error-status:error then do:
     4054                                                                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input return-value).
     4055                                     undo _rule, retry _rule.
     4056                                   end.
     4057                                   _child2:
     4058                                   repeat:
     4059                                     v_child2-qh:get-next().
     4060                                     IF v_child2-qh:query-off-end then do:
     4061                                       delete object v_child2-qh no-error.
     4062                                       next _rel2.
     4063                                     end.
     4064                                     case buf2_temp-rel-handle.child-buffer_:
     4065                                       when "cat-item" THEN do:
     4066                                         v-b-code = ImpData1:route-data_get-field-integer( buffer buf2_temp-rel-handle:handle, input buf2_temp-rel-handle.child-buffer_, input "b-code") .
     4067                                         v-b-dtl_id = ImpData1:route-data_get-field-integer( buffer buf2_temp-rel-handle:handle, input buf2_temp-rel-handle.child-buffer_, input "dtl_id") .
     4068                                         v-b-category_id = ImpData1:route-data_get-field-integer( buffer buf2_temp-rel-handle:handle, input buf2_temp-rel-handle.child-buffer_, input "category_id") .
     4069                                         v-cat-item-status_ = ImpData1:route-data_get-field-character( buffer buf2_temp-rel-handle:handle, input buf2_temp-rel-handle.child-buffer_, input "status_") .
     4070                                         if v-dtl_id <> v-b-dtl_id
     4071                                         or v-b-category_id <> v-category_id
     4072                                         then do:
     4073                                                                                   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Запись &1: нарушение схемы")).
     4074                                           delete object v_child-qh no-error.
     4075                                           delete object v_child2-qh no-error.
     4076                                           undo _rule, retry _rule.
     4077                                         end.
     4078                                         find first buf_temp-dis-gds-rule_ where
     4079                                                 buf_temp-dis-gds-rule_.templ-rl-root = buf_temp-dis-rule_.templ-rl-root
     4080                                             and buf_temp-dis-gds-rule_.obj-type = ''
     4081                                             and buf_temp-dis-gds-rule_.obj-code = 0
     4082                                             and buf_temp-dis-gds-rule_.discnt-role = 'temp-disc':U
     4083                                             and buf_temp-dis-gds-rule_.rule-num = buf_temp-dis-rule_.rule-num
     4084                                             and buf_temp-dis-gds-rule_.gds-code = 0
     4085                                             and buf_temp-dis-gds-rule_.pos-type = buf_temp-dis-rule_.pos-type
     4086                                             and buf_temp-dis-gds-rule_.nonunique = string(v-b-code)  no-error.
     4087                                         if not available buf_temp-dis-gds-rule_ then do:
     4088                                           create  buf_temp-dis-gds-rule_.
     4089                                           assign
     4090                                           buf_temp-dis-gds-rule_.obj-type = ''
     4091                                           buf_temp-dis-gds-rule_.obj-code = 0
     4092                                           buf_temp-dis-gds-rule_.templ-rl-root = buf_temp-dis-rule_.templ-rl-root
     4093                                           buf_temp-dis-gds-rule_.discnt-role = 'temp-disc':U
     4094                                           buf_temp-dis-gds-rule_.time-templ-rl-root = buf_temp-dis-rule_.time-templ-rl-root
     4095                                           buf_temp-dis-gds-rule_.gds-code = 0
     4096                                           buf_temp-dis-gds-rule_.pos-type = 'IBM':U
     4097                                           buf_temp-dis-gds-rule_.nonunique = string(v-b-code)
     4098                                           buf_temp-dis-gds-rule_.rule-num = v-dtl_id
     4099                                           buf_temp-dis-gds-rule_.rl-root = buf_temp-dis-rule_.rule-num
     4100                                           .
     4101                                         end.
     4102                                         buf_temp-dis-gds-rule_.status_ = v-cat-item-status_.
     4103                                         release buf_temp-dis-gds-rule_ .
     4104                                       end.
     4105                                     end case.
     4106                                   end.
     4107                                   delete object v_child2-qh no-error.
     4108                                 end.
     4109                                 release buf_temp-dis-rule_.
     4110                                 end.
     4111                               end.
     4112                               when "pcnt-tot-kateg" then do:
     4113                                 v-threshold = ImpData1:route-data_get-field-decimal( buffer buf_temp-rel-handle:handle, input buf_temp-rel-handle.child-buffer_ , input "threshold") .
     4114                                 find first term_tot-dis-rule_ where
     4115                                           term_tot-dis-rule_.rule-num = v-dtl_id no-error.
     4116                               if not available term_tot-dis-rule_ then do:
     4117                                   create term_tot-dis-rule_.
     4118                                   buffer-copy buf_tot-dis-rule_
     4119                                   except rule-num
     4120                                   upper-rule-num
     4121                                   lvl-num
     4122                                   root
     4123                                   is-term
     4124                                   sts
     4125                                   to term_tot-dis-rule_
     4126                                   assign
     4127                                   term_tot-dis-rule_.upper-rule-num = v-category_id
     4128                                   term_tot-dis-rule_.rule-num = v-dtl_id
     4129                                   term_tot-dis-rule_.lvl-num = 2
     4130                                   term_tot-dis-rule_.root = no
     4131                                   term_tot-dis-rule_.is-term = yes
     4132                                     term_tot-dis-rule_.status_ = v-dtl-status_
     4133                                   term_tot-dis-rule_.sts = integer('2':U)
     4134                                   .
     4135                                 end.
     4136                                 assign
     4137                                 term_tot-dis-rule_.tot-sum = v-threshold
     4138                                 term_tot-dis-rule_.des = string(term_tot-dis-rule_.tot-sum)
     4139                                 term_tot-dis-rule_.discnt-value = v-discnt
     4140                                 term_tot-dis-rule_.status_ = v-dtl-status_
     4141                                 .
     4142                                   release term_tot-dis-rule_.
     4143                               end.
     4144                             end case.
     4145                           end.
     4146                         end case.
     4147                     end.
     4148                     delete object v_child-qh no-error.
     4149                   end.
     4150                   case v-discnt-type:
     4151                     when "temp-disc" then do:
     4152                       run proc-save-temp-disc-rule in this-procedure (  input v-line-num
     4153                                                         ,input v-status_
     4154                                                         ) no-error.
     4155                     end.
     4156                     when "pcnt-tot-kateg" then do:
     4157                        run proc-save-tot-pcnt in this-procedure ( input v-line-num
     4158                                                          ,input v-status_
     4159                                                          ,buffer buf_tot-dis-rule_) no-error.
     4160                     end.
     4161                   end case.
     4162                   if error-status:error then do:
     4163                     run set-err-type in p-cont-handle
     4164                       ( input 'PROCESSING'
     4165                       ) no-error.
     4166                     if valid-handle(v_qh) then do:
     4167                       delete object v_qh no-error.
     4168                     end.
     4169                                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("&1&2&3"                                                , error-status:get-message(1)                                               , chr(10)                                               , return-value)).
     4170                     undo _rule, retry _rule .
     4171                   end.
     4172                 end.
     4173               end.
     4174             end case.
     4175           end.
     4176         end.
     4177         v-retry-action = 0 .
     4178        _release:
     4179         do on error undo, retry:
     4180           if  retry then do:
     4181             v-retry-action = v-retry-action + 1.
     4182                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("&1&2&3"                                       , error-status:get-message(1)                                       , chr(10)                                       , v-last-error-message )).
     4183             undo _main, return error ''.
     4184           end.
     4185         if v-retry-action < 1 then do:
     4186                   ImpData1:Route-data_dump ( ) .
     4187         end.
     4188         end.
     4189         if v-retry-action = 0 then do:
     4190           num-rec-ok = num-rec-ok + 1.
     4191         end.
     4192         run write-counter in p-log-handle ( input substitute("Обработано записей: &1, из них удачно: &2", num-rec, num-rec-ok)).
     4193       end.
     4194       v_qh:query-close().
     4195       if valid-handle(v_qh) then do:
     4196         delete object v_qh.
     4197       end.
     4198     end.
     4199     run write-log-and-file in p-log-handle (
     4200           input 1
     4201         , input log-file-name
     4202         , input 1
     4203         , input substitute("Обработано записей: &1, из них удачно: &2", num-rec, num-rec-ok)).
     4204   end.
     4205   end procedure.
     4206   procedure load-ruleset-context :
     4207   define input parameter p-ruleset-id as integer no-undo .
     4208   define buffer buf_rule-call-param for ub.rule-call-param.
     4209   define buffer buf_ext-system for ub.ext-system.
     4210   define buffer buf_dis-rule for ub.dis-rule.
     4211   define buffer buf_dis-time-rule for ub.dis-time-rule.
     4212   do
     4213   on error undo, return error
     4214   :
     4215    find first buf_rule-call-param no-lock where
     4216   buf_rule-call-param.codex_id = p-codex-id
     4217   and buf_rule-call-param.ruleset_id = p-ruleset-id
     4218   and buf_rule-call-param.call_id = p-call-id
     4219   and buf_rule-call-param.order_id = p-order-id
     4220   and buf_rule-call-param.rule_id = p-rule-id
     4221   and buf_rule-call-param.param-name = "p-esys-id"
     4222    no-error.
     4223   if available buf_rule-call-param then do:
     4224   assign p-esys-id = buf_rule-call-param.param-value-integer.
     4225   end.
     4226       find first buf_rule-call-param no-lock where
     4227   buf_rule-call-param.codex_id = p-codex-id
     4228   and buf_rule-call-param.ruleset_id = p-ruleset-id
     4229   and buf_rule-call-param.call_id = p-call-id
     4230   and buf_rule-call-param.order_id = p-order-id
     4231   and buf_rule-call-param.rule_id = p-rule-id
     4232   and buf_rule-call-param.param-name = "p-xsd-file"
     4233    no-error.
     4234   if available buf_rule-call-param then do:
     4235   assign p-xsd-file = buf_rule-call-param.param-value-character.
     4236   end.
     4237       case p-ruleset-id:
     4238         when 4 then do:
     4239           assign
     4240           v-sign = 1
     4241           v-current-host-code = p-host-code
     4242           v-current-obj-type = p-obj-type
     4243           v-current-obj-code = p-obj-code
     4244           v-current-db-num = g#db-num
     4245           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     4246           file-name  = entry(1, p-process-file-name, chr(4))
     4247           v_dataseth = handle(entry(2, p-process-file-name, chr(4)))
     4248           v-xmlh = buffer buf_temp-xml-tables:handle
     4249           v-esys-id = integer(p-doc-code)
     4250           v-extension = entry(num-entries(file-name, "."), file-name, ".")
     4251           v-pck-num = integer(entry(3, p-process-file-name, chr(4)))
     4252           log-file-name = entry(4, p-process-file-name, chr(4))
     4253           no-error
     4254           .
     4255           if error-status:error then do:
     4256                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибки параметров&1&2 ..."                                         , chr(10)                                         , error-status:get-message(1) )).
     4257             undo, return error substitute("Ошибки параметров&1&2 ..."                                         , chr(10)                                         , error-status:get-message(1) ).
     4258           end.
     4259           find first buf_ext-system no-lock where
     4260                     buf_ext-system.esys-id = v-esys-id
     4261                 and buf_ext-system.db-num = 0 no-error .
     4262           if not available buf_ext-system then do:
     4263                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не найдена ВС &1&2 ..."                                         , v-esys-id                                         , chr(10)                                         )).
     4264             undo, return error substitute("Не найдена ВС &1&2 ..."                                         , v-esys-id                                         , chr(10)                                         ).
     4265           end.
     4266           if v-extension = ''
     4267           or lookup(v-extension, "dat") = 0 then do:
     4268                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Файл &1 имеет недопустимое расширение &3&2 ..."                                         ,file-name                                         , chr(10)                                         , v-extension                                         )).
     4269             undo, return error substitute("Файл &1 имеет недопустимое расширение &3&2 ..."                                         ,file-name                                         , chr(10)                                         , v-extension                                         ).
     4270           end.
     4271           find first buf_dis-time-rule no-lock where
     4272                     buf_Dis-time-rule.templ-rl-root = 50001 no-error.
     4273           if not available buf_Dis-time-rule then do:
     4274                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не найдено расписание правил скидок с типом ВСЕГДА")).
     4275             undo, return error substitute("Не найдено расписание правил скидок с типом ВСЕГДА").
     4276           end.
     4277           find first buf_dis-rule no-lock where
     4278                     buf_Dis-rule.rule-num = 20 no-error.
     4279           if not available buf_Dis-rule then do:
     4280                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не найден ШАБЛОН правил скидок 20")).
     4281             undo, return error substitute("Не найден ШАБЛОН правил скидок 20").
     4282           end.
     4283           find first buf_dis-rule no-lock where
     4284                     buf_Dis-rule.rule-num = 82 no-error.
     4285           if not available buf_Dis-rule then do:
     4286                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не найден ШАБЛОН правил скидок 82 (POS IBM)")).
     4287             undo, return error substitute("Не найден ШАБЛОН правил скидок 82 (POS IBM)").
     4288           end.
     4289           find first buf_dis-rule no-lock where
     4290                     buf_Dis-rule.rule-num = 85 no-error.
     4291           if not available buf_Dis-rule then do:
     4292                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не найден ШАБЛОН правил скидок 85 (POS IBS TH)")).
     4293             undo, return error substitute("Не найден ШАБЛОН правил скидок 85 (POS IBS TH)").
     4294           end.
     4295           run tmpreldf_get-relations in this-procedure ( input  v_dataseth).
     4296         end.
     4297         otherwise do:
     4298           undo, return error "Неправильный вызов".
     4299         end.
     4300       end case.
     4301     end.
     4302   end procedure.
     4303   procedure delete-procedure :
     4304     do
     4305     on error undo, return error
     4306     :
     4307         for each temp-dis-rule_:
     4308           delete temp-dis-rule_.
     4309         end.
     4310         for each tot-dis-rule_:
     4311           delete tot-dis-rule_.
     4312         end.
     4313         for each temp-dis-gds-rule_:
     4314           delete temp-dis-gds-rule_.
     4315         end.
     4316         run garbcoll_clear in this-procedure .
     4317     end.
     4318   end procedure.
     4319   procedure proc-save-temp-disc-rule :
     4320   define input  parameter p-line-num as integer   no-undo .
     4321   define input  parameter p-status_ as character no-undo .
     4322   define variable v-rid as recid no-undo .
     4323   define variable v-mode as character no-undo .
     4324   define variable v-work-place as character no-undo .
     4325   define variable v-today as date      no-undo.
     4326   define variable v-time  as integer   no-undo.
     4327   define variable v-err-mess as character no-undo .
     4328   define variable v-is-terminal as logical no-undo .
     4329   define variable v-templ-rl-root as integer no-undo .
     4330   define variable dflt-cd as character no-undo .
     4331   define buffer buf_temp-dis-gds-rule_ for temp-dis-gds-rule_.
     4332   define buffer buf_clients for ub.clients.
     4333   define buffer buf_dis-gds-rule for ub.dis-gds-rule.
     4334   define buffer buf_dis-rule for ub.dis-rule.
     4335   define buffer buf_temp-dis-rule_ for temp-dis-rule_.
     4336   define buffer term_tt-dis-rule for tt-dis-rule.
     4337   define buffer buf_bar-code for ub.bar-code.
     4338   main-block:
     4339   do transaction
     4340   on error  undo main-block, retry main-block
     4341   on stop   undo main-block, retry main-block
     4342   on endkey undo main-block, retry main-block
     4343   :
     4344     if retry then do:
     4345       empty temp-table temp-dis-rule_.
     4346       empty temp-table temp-dis-gds-rule_.
     4347       empty temp-table tot-dis-rule_.
     4348           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input v-err-mess).
     4349       return error ''.
     4350     end.
     4351     else do:
     4352       case p-status_:
     4353         when 'D' then do:
     4354           _buf-clients:
     4355           for each buf_clients no-lock where
     4356                   buf_clients.db-num = g#db-num
     4357               and buf_clients.obj-type = 'маг':U
     4358           on error  undo main-block, retry main-block
     4359           on stop   undo main-block, retry main-block
     4360           on endkey undo main-block, retry main-block
     4361           :
     4362             dflt-cd = ''.
     4363   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4364   define variable v-param-type19 as character no-undo .
     4365   define variable v-value-date19 as date no-undo .
     4366   define variable v-value-decimal19 as decimal no-undo .
     4367   define variable v-value-integer19 as INTEGER no-undo .
     4368   define variable v-value-logical19 AS LOGICAL no-undo .
     4369   define variable v-tth19 as handle no-undo .
     4370   run adm/shattri.p (
     4371       input "get":U
     4372       ,input  buf_Clients.obj-type
     4373       ,input  buf_clients.obj-code
     4374       ,input  'cd-sending':U
     4375       ,input  'dflt-cd':U
     4376       ,output dflt-cd
     4377       ,output v-value-date19
     4378       ,output v-value-decimal19
     4379       ,output v-value-integer19
     4380       ,output v-value-logical19
     4381       ,output v-param-type19
     4382       ,INPUT-OUTPUT table-handle v-tth19
     4383       )  .
