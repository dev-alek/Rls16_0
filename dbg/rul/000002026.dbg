     4922                   buf_clients.db-num = g#db-num
     4923               and buf_clients.obj-type = 'маг':U
     4924           on error  undo main-block, retry main-block
     4925           on stop   undo main-block, retry main-block
     4926           on endkey undo main-block, retry main-block
     4927           :
     4928             empty temp-table term_tt-dis-rule.
