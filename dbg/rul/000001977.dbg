     2238   define output parameter v-prc-min as decimal   no-undo .
     2239     do
     2240     on error undo, return error return-value
     2241     :
     2242   find first ub.contract-specif-attr no-lock  where
     2243              ub.contract-specif-attr.contract-num = p-contract-num  and
     2244              ub.contract-specif-attr.host-code    = p-host-code     and
     2245              ub.contract-specif-attr.gds-code     = p-gds-code      and
     2246              ub.contract-specif-attr.attr-code    = 'prc-min':U
     2247              no-error .
     2248      if available ub.contract-specif-attr then  v-prc-min = decimal (ub.contract-specif-attr.attr-value ) .
     2249                                           else  v-prc-min = 0 .
     2250   end.
     2251   END PROCEDURE.
     2252   PROCEDURE write-retro-bonus :
     2253   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     2254   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     2255   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     2256   define input  parameter v-retro-bonus as character   no-undo .
     2257     do
     2258     on error undo, return error return-value
     2259     :
     2260       find first ub.contract-specif-attr exclusive-lock  where
     2261                 ub.contract-specif-attr.contract-num = p-contract-num  and
     2262                 ub.contract-specif-attr.host-code    = p-host-code     and
     2263                 ub.contract-specif-attr.gds-code     = p-gds-code      and
     2264                 ub.contract-specif-attr.attr-code    = "retro-bonus"
     2265                 no-error .
     2266         if not available ub.contract-specif-attr then do:
     2267            create ub.contract-specif-attr .
     2268            assign
     2269                 ub.contract-specif-attr.contract-num = p-contract-num
     2270                 ub.contract-specif-attr.host-code    = p-host-code
     2271                 ub.contract-specif-attr.gds-code     = p-gds-code
     2272                 ub.contract-specif-attr.attr-code    = "retro-bonus"
     2273            .
     2274            ub.contract-specif-attr.attr-value  = v-retro-bonus no-error.
     2275            if error-status:error then
     2276               message "Превышен допустимый объем информации о ретро-бонусах. Удалите исторические или неактуальны периоды" view-as alert-box error.
     2277         end.
     2278         else do:
     2279            ub.contract-specif-attr.attr-value  = v-retro-bonus no-error.
     2280            if error-status:error then
     2281               message "Превышен допустимый объем информации о ретро-бонусах. Удалите исторические или неактуальны периоды" view-as alert-box error.
     2282         end.
     2283       find first ub.contract-specif exclusive-lock where
     2284           ub.contract-specif.contract-num = p-contract-num and
     2285           ub.contract-specif.host-code    = p-host-code    and
     2286           ub.contract-specif.gds-code     = p-gds-code.
     2287           ub.contract-specif.whole-send-news  = ub.contract-specif.whole-send-news + 1.
     2288   end.
     2289   END PROCEDURE.
     2290   PROCEDURE read-retro-bonus :
     2291   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     2292   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
