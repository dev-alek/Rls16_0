     2992   function 00180004_get-error-message returns character :
     2993   define variable v-ii as integer no-undo .
     2994   define variable v-mess as character no-undo .
     2995   DO v-ii = 1 TO ERROR-STATUS:NUM-MESSAGES:
     2996       v-mess = substitute("&1&2ош &3"
     2997                           ,v-mess
     2998                           ,chr(10)
     2999                           ,ERROR-STATUS:GET-MESSAGE(v-ii)).
     3000   END.
     3001   return v-mess.
     3002   end function.
     3003    define variable p-xsd-file as character no-undo.
     3004   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3005   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
     3006   run gbl/getobjsrvhndl.p (input-output ObjSrv).
     3007   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3008   function context_get-thobj-es return logical
     3009   (
     3010      input p-esys-id as integer
     3011     ,input p-eobj-type as character
     3012     ,input p-eobj-code as integer
     3013     ,output p-obj-type as character
     3014     ,output p-obj-code as integer
     3015   ):
     3016      define variable v-value-list as character no-undo .
     3017      define variable v-field-list as character no-undo .
     3018      define buffer buf_clients for ub.clients.
     3019      define buffer buf_ext-classif for ub.ext-classif.
     3020      find first buf_ext-classif no-lock where
     3021                buf_ext-classif.classif-name = 'clients-esys':U
     3022            and buf_ext-classif.classif-subject = 'clients':U
     3023            and buf_ext-classif.db-num = 0
     3024            and buf_Ext-classif.key#_one = p-esys-id
     3025            and buf_Ext-classif.charkey_one = p-eobj-type
     3026            and buf_Ext-classif.key#_two = p-eobj-code no-error .
     3027      if available buf_Ext-classif
     3028      then do:
     3029         ObjSrv:Lib:KeyRec:GenKeyFv (
     3030                                         input buf_Ext-classif.uniq-key-rec
     3031                                         ,output v-field-list
     3032                                         ,output v-value-list).
     3033         assign
     3034            p-obj-type = entry(lookup("obj-type":U
     3035                                     , v-field-list
     3036                                     , chr(3))
     3037                                     , v-value-list, chr(3))
     3038            p-obj-code = integer(entry(lookup("obj-code":U
     3039                                            , v-field-list
     3040                                            , chr(3))
     3041                                      , v-value-list
     3042                                      , chr(3)))
     3043         no-error .
     3044      end.
     3045      if     available buf_ext-classif
     3046         and (p-obj-type = 'маг':U
     3047              or
     3048              p-obj-type = 'скл':U
     3049              )
     3050         and (p-obj-code > 0 and p-obj-code <= 99999)
     3051      then do:
     3052         find first buf_clients no-lock where
     3053                    buf_clients.obj-type = p-obj-type
     3054                and buf_clients.obj-code = p-obj-code no-error.
     3055         if available buf_clients then do:
     3056            return yes.
     3057         end.
     3058         else do:
     3059            assign
     3060               p-obj-type = '':U
     3061               p-obj-code = 0
     3062            .
     3063            return no.
     3064         end.
     3065      end.
     3066      else do:
     3067         assign
     3068            p-obj-type = '':U
     3069            p-obj-code = 0
     3070         .
     3071         return no.
     3072      end.
     3073   end.
