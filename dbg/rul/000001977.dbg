     2299              ub.contract-specif-attr.contract-num = p-contract-num  and
     2300              ub.contract-specif-attr.host-code    = p-host-code     and
     2301              ub.contract-specif-attr.gds-code     = p-gds-code      and
     2302              ub.contract-specif-attr.attr-code    = "retro-bonus"
     2303              no-error .
     2304      if available ub.contract-specif-attr then  v-retro-bonus = ub.contract-specif-attr.attr-value  .
     2305                                           else  v-retro-bonus = "" .
