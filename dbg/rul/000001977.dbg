     1133   procedure get-gate-file-name :
     1134   define input parameter p-gate-rec as character no-undo .
     1135   define output  parameter p-gate-file-name as character no-undo .
     1136   define buffer buf_clob-data for ub.clob-data.
     1137   define variable v-tbl-row as rowid no-undo .
     1138   define variable v-tbl-name as character no-undo .
     1139   run gen-row-keyr in this-procedure ( input p-gate-rec
     1140                                       ,input ?
     1141                                       ,input "ub"
     1142                                       ,input ?
     1143                                       ,input no-lock
     1144                                       ,output v-tbl-row
     1145                                       ,output v-tbl-name) no-error.
     1146   if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     1147                                                           ,vss-include-info10
     1148                                                           ,p-gate-rec).
     1149   find first buf_clob-data no-lock where
     1150             rowid(buf_clob-data) = v-tbl-row no-error.
     1151   if not available buf_clob-data then do:
     1152     if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     1153                                                             ,vss-include-info10
     1154                                                             ,p-gate-rec).
     1155   end.
     1156   p-gate-file-name = buf_clob-data.file-name.
     1157   end procedure.
     1158   procedure get-gate-rec :
     1159   define input  parameter p-gate-name as character no-undo .
     1160   define output parameter p-gate-rec as character no-undo .
     1161   define buffer buf_clob-bind for ub.clob-bind.
     1162   define buffer buf_clob-data for ub.clob-data.
     1163   main-block:
     1164   do
     1165   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info10, return-value, chr(10), error-status :get-message (1))
     1166   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info10 )
     1167   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info10 )
     1168   :
     1169       find first buf_clob-bind no-lock where
     1170                 buf_clob-bind.uniq-key-rec = p-gate-name
     1171             and buf_clob-bind.field-name = '':U
     1172             and buf_clob-bind.part-num = 1
     1173             and buf_clob-bind.resource-type = 'gate':U
     1174             no-error.
     1175       if not available buf_clob-bind then do:
     1176         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     1177                                         , p-gate-name
     1178                                         ).
     1179       end.
     1180       find first buf_clob-data no-lock where
     1181                 buf_clob-data.db-num = buf_clob-bind.db-num
     1182             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     1183       if not available buf_clob-data then do:
     1184         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1185                                         , buf_clob-bind.db-num
     1186                                         , buf_clob-bind.int64-id
     1187                                         , p-gate-name
     1188                                         ).
     1189       end.
     1190       run gen-key-rec in this-procedure ( input 'clob-data':U
     1191                                 ,input buffer buf_clob-data:handle
     1192                                 ,output p-gate-rec).
     1193   end.
     1194   end procedure.
     1195   procedure get-gate-by-name :
     1196   define input  parameter p-gate-name as character no-undo .
     1197   define output parameter p-gate-rec as character no-undo .
     1198   define output parameter p-dsh as handle no-undo .
     1199   define input-output  parameter p-xmlh as handle no-undo .
     1200   define variable v-ii as integer   no-undo .
     1201   define variable glog as logical   no-undo .
     1202   define variable v-longchar as longchar no-undo .
     1203   define variable v-txmlh as handle no-undo .
     1204   define variable v-db-num as integer no-undo .
     1205   define variable v-int64-id as int64 no-undo .
     1206   define buffer buf_clob-bind for ub.clob-bind.
     1207   define buffer buf_clob-data for ub.clob-data.
     1208   main-block:
     1209   do
     1210   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info10, return-value, chr(10), error-status :get-message (1))
     1211   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info10 )
     1212   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info10 )
     1213   :
     1214       find first buf_clob-bind no-lock where
     1215                 buf_clob-bind.uniq-key-rec = p-gate-name
     1216             and buf_clob-bind.field-name = '':U
     1217             and buf_clob-bind.part-num = 1
     1218             and buf_clob-bind.resource-type = 'gate':U
     1219             no-error.
     1220       if not available buf_clob-bind then do:
     1221         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     1222                                         , p-gate-name
     1223                                         ).
     1224       end.
     1225       find first buf_clob-data no-lock where
     1226                 buf_clob-data.db-num = buf_clob-bind.db-num
     1227             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     1228       if not available buf_clob-data then do:
     1229         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1230                                         , buf_clob-bind.db-num
     1231                                         , buf_clob-bind.int64-id
     1232                                         , p-gate-name
     1233                                         ).
     1234       end.
     1235       assign
     1236       v-longchar = buf_clob-data.cdata
     1237       .
     1238       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1239       if error-status :error then do:
     1240         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1241       end.
     1242       create dataset p-dsh .
     1243       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1244                                     , v-longchar
     1245                                     , ?
     1246                                     , ?
     1247                                     , ?
     1248                                     ) no-error.
     1249       v-longchar = '':U.
     1250       if error-status :error
     1251       or not glog
     1252       then do:
     1253         undo, return error substitute("Не удалось прочитать XML-схему &1 из БД:&2&3", p-gate-name, chr(10), error-status:get-message(1) ).
     1254       end.
     1255       if not valid-handle(p-xmlh)
     1256       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1257         create temp-table v-txmlh.
     1258         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1259         v-txmlh:temp-table-prepare("temp-xml-tables").
     1260         p-xmlh = v-txmlh:default-buffer-handle.
     1261       end.
     1262       run gen-key-rec in this-procedure ( input 'clob-data':U
     1263                                 ,input buffer buf_clob-data:handle
     1264                                 ,output p-gate-rec).
     1265       do v-ii = 1 to p-dsh:num-buffers:
     1266         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1267         if not p-xmlh:available then do:
     1268           p-xmlh:buffer-create().
     1269           assign
     1270           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1271           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1272           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1273           p-xmlh::gate-handle_ = p-dsh
     1274           p-xmlh::uniq-gate-rec = p-gate-rec
     1275           p-xmlh::gate-name = p-dsh:name
     1276           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1277           .
     1278           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1279             assign
     1280             p-xmlh::order = -3.
     1281           end.
     1282         end.
     1283       end.
     1284   end.
     1285   end procedure.
     1286   procedure get-gate-by-rec :
     1287   define input  parameter p-gate-rec as character no-undo .
     1288   define output parameter p-dsh as handle no-undo .
     1289   define input-output  parameter p-xmlh as handle no-undo .
     1290   define input-output parameter p-longchar  as longchar no-undo .
     1291   define variable v-ii as integer   no-undo .
     1292   define variable glog as logical   no-undo .
     1293   define variable v-rowid as rowid no-undo .
     1294   define variable v-tbl-name as character no-undo .
     1295   define variable v-longchar as longchar no-undo .
     1296   define variable v-txmlh as handle no-undo .
     1297   define buffer buf_clob-data for ub.clob-data.
     1298   main-block:
     1299   do
     1300   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info10, return-value, chr(10), error-status :get-message (1))
     1301   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info10 )
     1302   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info10 )
     1303   :
     1304     run gen-row-keyr in this-procedure (
     1305                                           input  p-gate-rec
     1306                                           ,input  ?
     1307                                           ,input  "ub"
     1308                                           ,input  ?
     1309                                           ,input  NO-LOCK
     1310                                           ,output v-rowid
     1311                                           ,output v-tbl-name   ) no-error.
     1312       find first buf_clob-data no-lock where
     1313                 rowid(buf_clob-data) = v-rowid  no-error.
     1314       if not available buf_clob-data then do:
     1315         undo, return error substitute("Не найден CLOB  &1"
     1316                                         , p-gate-rec
     1317                                         ).
     1318       end.
     1319       assign
     1320       v-longchar = buf_clob-data.cdata
     1321       .
     1322       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1323       if error-status :error then do:
     1324         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1325       end.
     1326       create dataset p-dsh .
     1327       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1328                                     , v-longchar
     1329                                     , ?
     1330                                     , ?
     1331                                     , ?
     1332                                     ) no-error.
     1333       define variable v-esm as character no-undo .
     1334       v-esm = error-status:get-message(1) .
     1335       if p-longchar <> ? then do:
     1336         p-longchar = v-longchar.
     1337       end.
     1338       v-longchar = '':U.
     1339       if error-status :error
     1340       or not glog
     1341       then do:
     1342         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     1343                                      , p-gate-rec
     1344                                      , p-gate-rec
     1345                                      , v-esm
     1346                                      ).
     1347       end.
     1348       p-dsh:private-data = buf_clob-data.file-name_ + chr(4) + p-gate-rec.
     1349       if not valid-handle(p-xmlh)
     1350       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1351         create temp-table v-txmlh.
     1352         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1353         v-txmlh:temp-table-prepare("temp-xml-tables").
     1354         p-xmlh = v-txmlh:default-buffer-handle.
     1355       end.
     1356       do v-ii = 1 to p-dsh:num-buffers:
     1357         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1358         if not p-xmlh:available then do:
     1359           p-xmlh:buffer-create().
     1360           assign
     1361           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1362           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1363           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1364           p-xmlh::gate-handle_ = p-dsh
     1365           p-xmlh::uniq-gate-rec = p-gate-rec
     1366           p-xmlh::gate-name = p-dsh:name
     1367           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1368           .
     1369           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1370             assign
     1371             p-xmlh::order = -3.
     1372           end.
     1373           p-xmlh:buffer-release().
     1374         end.
     1375       end.
     1376   end.
     1377   end procedure.
     1378   procedure get-gate-by-file :
     1379   define input  parameter p-schema-file-name as character no-undo .
     1380   define input  parameter p-gate-rec as character no-undo .
     1381   define output parameter p-dsh as handle no-undo .
     1382   define input-output  parameter p-xmlh as handle no-undo .
     1383   define variable v-ii as integer   no-undo .
     1384   define variable glog as logical   no-undo .
     1385   define variable v-rowid as rowid no-undo .
     1386   define variable v-tbl-name as character no-undo .
     1387   define variable v-longchar as longchar no-undo .
     1388   define variable v-txmlh as handle no-undo .
     1389   main-block:
     1390   do
     1391   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info10, return-value, chr(10), error-status :get-message (1))
     1392   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info10 )
     1393   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info10 )
     1394   :
     1395       COPY-LOB
     1396       FROM  FILE p-schema-file-name
     1397       TO  OBJECT v-longchar
     1398       no-convert
     1399       NO-ERROR .
     1400       if error-status :error then do:
     1401           undo, return error substitute("Не удалось считать файл схемы &1 в память&2&3"
     1402                                     , p-schema-file-name
     1403                                 , chr(10)
     1404                                 , error-status:get-message(1) ).
     1405       end.
     1406       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1407       if error-status :error then do:
     1408         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, p-schema-file-name, chr(10), error-status:get-message(1) , return-value ).
     1409       end.
     1410       create dataset p-dsh .
     1411       glog = p-dsh:READ-XMLSCHEMA( "longchar"
     1412                                     , v-longchar
     1413                                     , ?
     1414                                     , ?
     1415                                     , ?
     1416                                     ) no-error.
     1417       v-longchar = ''.
     1418       if error-status :error
     1419       or not glog
     1420       then do:
     1421         undo, return error substitute("Не удалось прочитать XML-схему из файла &1&2&3"
     1422                                      , p-schema-file-name
     1423                                      ,chr(10)
     1424                                      , error-status:get-message(1)
     1425                                      ).
     1426       end.
     1427       if not valid-handle(p-xmlh)
     1428       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1429         create temp-table v-txmlh.
     1430         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1431         v-txmlh:temp-table-prepare("temp-xml-tables").
     1432         p-xmlh = v-txmlh:default-buffer-handle.
     1433       end.
     1434       do v-ii = 1 to p-dsh:num-buffers:
     1435         p-xmlh:find-first(substitute(' where tbl-name = "&1" and  uniq-gate-rec = "&2" '
     1436                                      ,p-dsh:get-buffer-handle(v-ii):name
     1437                                      ,p-gate-rec
     1438                                      )) no-error.
     1439         if not p-xmlh:available then do:
     1440           p-xmlh:buffer-create().
     1441           assign
     1442           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):table
     1443           p-xmlh::uniq-gate-rec = p-gate-rec
     1444           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1445           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1446           p-xmlh::gate-handle_ = p-dsh
     1447           p-xmlh::gate-name = p-dsh:name
     1448           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1449           .
     1450           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1451             assign
     1452             p-xmlh::order = -3.
     1453           end.
     1454           p-xmlh:buffer-release().
     1455         end.
     1456       end.
     1457   end.
     1458   end procedure.
     1459   procedure gate-clear :
     1460   define input  parameter p-dsh as handle no-undo .
     1461   define input  parameter p-xmlh as handle no-undo .
     1462   define variable v-dsh as handle no-undo .
     1463   define variable v-th as handle no-undo .
     1464     do
     1465     on error undo, return error return-value
     1466     :
     1467       if valid-handle(p-dsh) then do:
     1468         delete object p-dsh.
     1469         v-dsh = p-dsh.
     1470         p-dsh = ?.
     1471       end.
     1472       repeat while true:
     1473         p-xmlh:find-first( substitute( " where gate-handle_ = &1 ", v-dsh)
     1474                            , share-lock) no-error.
     1475         if p-xmlh:available then do:
     1476           assign
     1477           v-th = p-xmlh:buffer-field("table-handle_"):buffer-value.
     1478           if valid-handle(p-xmlh:buffer-field("table-handle_"))
     1479           and valid-handle(v-th)
     1480           and v-th:dynamic = yes
     1481           then do:
     1482             delete object p-xmlh:buffer-field("table-handle_"):buffer-value.
     1483             p-xmlh:buffer-field("table-handle_"):buffer-value = ?.
     1484           end.
     1485           p-xmlh:buffer-delete().
     1486         end.
     1487         else do:
     1488           leave.
     1489         end.
     1490       end.
     1491       if p-xmlh:dynamic = yes
     1492       and valid-handle(p-xmlh)
     1493       then do:
     1494         delete object p-xmlh:table-handle.
     1495         p-xmlh = ?.
     1496       end.
     1497       v-dsh = ?.
     1498     end.
     1499   end procedure.
     1500   procedure all-gates-clear :
     1501   define parameter buffer buf_temp-xml-tables for temp-xml-tables.
     1502   do
     1503   on error undo, return error
     1504   :
     1505     for each buf_temp-xml-tables
     1506     break
     1507     by buf_temp-xml-tables.uniq-gate-rec
     1508     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1509     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1510     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1511     :
     1512         if first-of(buf_temp-xml-tables.uniq-gate-rec) then do:
     1513           delete object buf_temp-xml-tables.gate-handle_.
     1514           buf_temp-xml-tables.gate-handle_ = ?.
     1515         end.
     1516         if valid-handle(buf_temp-xml-tables.table-handle_)
     1517         and buf_temp-xml-tables.table-handle_:dynamic = no
     1518         then do:
     1519           delete object buf_temp-xml-tables.table-handle_.
     1520           buf_temp-xml-tables.table-handle_ = ?.
     1521         end.
     1522         delete buf_temp-xml-tables.
     1523     end.
     1524   end.
     1525   end procedure.
     1526   procedure fix-schemalocation :
     1527   define input-output  parameter p-longchar as longchar no-undo .
     1528   DEFINE VARIABLE hdoc AS HANDLE.
     1529   DEFINE VARIABLE hroot AS HANDLE.
     1530   DEFINE VARIABLE hnode-child AS HANDLE.
     1531   DEFINE VARIABLE hnode-attr AS HANDLE.
     1532   define variable v-jj as integer   no-undo .
     1533   define variable ok as logical   no-undo .
     1534   define variable v-path1                    as character                no-undo .
     1535   DEFINE VARIABLE v-full-path1               as character                no-undo .
     1536   DEFINE VARIABLE v-file-name1               as character                no-undo .
     1537   DEFINE VARIABLE v-file-name-no-ext1        as character                no-undo .
     1538   DEFINE VARIABLE v-file-name-ext1           as character                no-undo .
     1539   define variable v-schema-location          as character                no-undo .
     1540   do
     1541   on error undo, return error return-value
     1542   :
     1543     CREATE X-DOCUMENT hdoc.
     1544     CREATE X-noderef hroot.
     1545     CREATE X-noderef hnode-child.
     1546     CREATE X-noderef hnode-attr.
     1547     hdoc:load("longchar", p-longchar, no) no-error.
     1548     iF ERROR-STATUS:GET-MESSAGE(1) <> '' THEN message ERROR-STATUS:GET-MESSAGE(1) view-as alert-box .
     1549     hdoc:get-document-element(hroot).
     1550     _repeat:
     1551     REPEAT v-jj = 1 TO hroot:NUM-CHILDREN:
     1552       ok = hroot:GET-CHILD(hNode-Child, v-jj).
     1553       if not ok then next.
     1554       if hNode-Child:local-name = "include"
     1555       then do:
     1556         ok = hNode-Child:GET-ATTRIBUTE-NODE( hnode-attr, "schemaLocation" ).
     1557           v-schema-location = hnode-attr:node-value.
     1558           run gbl/filename.p (
     1559                           input "exe/" + hnode-attr:node-value
     1560                         ,output v-full-path1
     1561                         ,output v-path1
     1562                         ,output v-file-name1
     1563                         ,output v-file-name-no-ext1
     1564                         ,output v-file-name-ext1
     1565                         ) no-error .
     1566           if error-status :error then do:
     1567             delete object hnode-attr.
     1568             delete object hnode-child.
     1569             delete object hroot.
     1570             delete object hdoc.
     1571             undo, return error substitute("Не удалось определить расположение схемы &1", v-schema-location).
     1572           end.
     1573         ok = hNode-Child:sET-ATTRIBUTE(  "schemaLocation", v-full-path1 ).
     1574         leave  _repeat.
     1575       end.
     1576     END.
     1577     hdoc:save("longchar", p-longchar).
     1578     delete object hnode-attr.
     1579     delete object hnode-child.
     1580     delete object hroot.
     1581     delete object hdoc.
     1582   end.
     1583   end procedure.
     1584   procedure gate-clb_fill-xml-tables :
     1585   define input parameter p-dsh as handle no-undo .
     1586   define input-output parameter p-xmlh as handle no-undo .
     1587   define variable v-ii as integer no-undo .
     1588     do
     1589     on error undo, return error
     1590     :
     1591       do v-ii = 1 to p-dsh:num-buffers:
     1592         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1593         if not p-xmlh:available then do:
     1594           p-xmlh:buffer-create().
     1595           assign
     1596           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1597           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1598           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1599           p-xmlh::gate-handle_ = p-dsh
     1600           p-xmlh::uniq-gate-rec = entry(2, p-dsh:private-data, chr(4))
     1601           p-xmlh::gate-name = p-dsh:name
     1602           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1603           .
     1604           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1605             assign
     1606             p-xmlh::order = -3.
     1607           end.
     1608           p-xmlh:buffer-release().
     1609         end.
     1610       end.
     1611     end.
     1612   end procedure.
     1613   procedure all-gates-empty :
     1614   define buffer buf_temp-xml-tables for temp-xml-tables.
     1615   do
     1616   on error undo, return error
     1617   :
     1618     for each buf_temp-xml-tables
     1619     break
     1620     by buf_temp-xml-tables.uniq-gate-rec
     1621     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1622     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1623     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1624     :
     1625       if valid-handle(buf_temp-xml-tables.tbl-handle_) then do:
     1626         buf_temp-xml-tables.tbl-handle_:empty-temp-table().
     1627       end.
     1628     end.
     1629   end.
     1630   end procedure.
     1631   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1632   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1633   procedure proc-ord-code :
     1634   define input  parameter  p-type as character no-undo .
     1635   define input  parameter  v-cntxt-db-num   as integer   no-undo .
     1636   define input  parameter  v-cntxt-obj-type as character no-undo .
     1637   define input  parameter  v-cntxt-obj-code as integer   no-undo .
     1638   define input  parameter  p-i-doc    as character no-undo .
     1639   define output parameter  p-ord-doc  as character no-undo .
     1640   define variable          v-idop     as character no-undo .
     1641     do
     1642     on error undo, return error return-value
     1643     :
     1644   case p-type :
     1645       when "main-no-ver" then do:
     1646         if  (v-cntxt-db-num <> 0) then
     1647           p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (v-cntxt-obj-code, ">>>>9")) + substring (v-cntxt-obj-type, (if g#language = "RUS" then 1 else 2), 1).
     1648         else
     1649           p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-".
     1650       end.
     1651       when "main" then do:
     1652             do while true:
     1653             if  (v-cntxt-db-num <> 0) then
     1654               p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (v-cntxt-obj-code, ">>>>9")) + substring (v-cntxt-obj-type, (if g#language = "RUS" then 1 else 2), 1).
     1655             else
     1656               p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-".
     1657             if not can-find (ub.ord-doc where ub.ord-doc.doc-code = p-ord-doc no-lock) then leave.
     1658             End.
     1659       end.
     1660       when "chip" then do:
     1661         assign
     1662           v-idop = p-i-doc .
     1663         do while true :
     1664           if index (v-idop , ".") = 0 then
     1665             v-idop  = replace (v-idop , "-", "-1.").
     1666           else
     1667             v-idop  =
     1668             substring (v-idop , 1, index (v-idop, "-")) +
     1669             string (integer (substring (v-idop, index (v-idop, "-") + 1, index (v-idop, ".") - index (v-idop, "-") - 1)) + 1) +
     1670             substring (v-idop, index (v-idop, ".")).
     1671           if not can-find (ub.ord-doc where ub.ord-doc.doc-code = v-idop no-lock) then leave.
     1672         end.
     1673         assign
     1674           p-ord-doc = v-idop.
     1675       end.
     1676   end case.
     1677     end.
     1678   end procedure.
     1679   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1680   def var vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1681   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1682   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1683   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1684   procedure ordlineattr-value :
     1685     do
     1686     on error undo, return error return-value
     1687     :
     1688       define input  parameter p-doc-code like ub.ord-line-attr.doc-code   no-undo .
     1689       define input  parameter p-gds-code like ub.ord-line-attr.gds-code   no-undo .
     1690       define input  parameter p-code     like ub.ord-line-attr.attr-code  no-undo .
     1691       define output parameter p-value    like ub.ord-line-attr.attr-value no-undo .
     1692       define output parameter p-type     as character no-undo .
     1693       define buffer buf_ord-line-attr for ub.ord-line-attr .
     1694       define variable v-format         as character no-undo .
     1695       define variable v-fillin_width   as integer   no-undo .
     1696       define variable v-fillin_height  as integer   no-undo .
     1697       define variable v-label          as character no-undo .
     1698       define variable v-user-can-edit  as logical   no-undo .
     1699       define variable v-output-display as logical   no-undo .
     1700       define variable v-other          as character no-undo .
     1701       define variable v-proc           as character no-undo .
     1702       define variable v-func           as character no-undo .
     1703       define variable v-sort           as integer   no-undo .
     1704       run ordlineattr-code in this-procedure
     1705         (input  p-code
     1706         ,output p-type
     1707         ,output v-format
     1708         ,output v-fillin_width
     1709         ,output v-fillin_height
     1710         ,output v-label
     1711         ,output v-user-can-edit
     1712         ,output v-output-display
     1713         ,output v-proc
     1714         ,output v-func
     1715         ,output v-sort
     1716         ,output v-other
     1717         ) no-error .
     1718       if error-status :error then do:
     1719         undo, return error return-value .
     1720       end.
     1721       find first buf_ord-line-attr no-lock
     1722         where buf_ord-line-attr.doc-code  = p-doc-code
     1723           and buf_ord-line-attr.gds-code  = p-gds-code
     1724           and buf_ord-line-attr.attr-code = p-code
     1725         no-error .
     1726       if avail buf_ord-line-attr then do:
     1727         assign
     1728           p-value =  buf_ord-line-attr.attr-value
     1729         .
     1730       end.
     1731       else do:
     1732         assign
     1733           p-value = if p-type = 'L':U then "no":U else ""
     1734         .
     1735       end.
     1736     end.
     1737   end procedure.
     1738   procedure ordlineattr-write :
     1739     do
     1740     on error undo, return error return-value
     1741     :
     1742       define input parameter p-doc-code like ub.ord-line-attr.doc-code   no-undo .
     1743       define input parameter p-gds-code like ub.ord-line-attr.gds-code   no-undo .
     1744       define input parameter p-code     like ub.ord-line-attr.attr-code  no-undo .
     1745       define input parameter p-value    like ub.ord-line-attr.attr-value no-undo .
     1746       define buffer buf_ord-line-attr for ub.ord-line-attr .
     1747       define variable v-type           as character no-undo .
     1748       define variable v-format         as character no-undo .
     1749       define variable v-fillin_width   as integer   no-undo .
     1750       define variable v-fillin_height  as integer   no-undo .
     1751       define variable v-label          as character no-undo .
     1752       define variable v-user-can-edit  as logical   no-undo .
     1753       define variable v-output-display as logical   no-undo .
     1754       define variable v-other          as character no-undo .
     1755       define variable v-proc           as character no-undo .
     1756       define variable v-func           as character no-undo .
     1757       define variable v-sort           as integer   no-undo .
     1758       run ordlineattr-code in this-procedure
     1759         (input  p-code
     1760         ,output v-type
     1761         ,output v-format
     1762         ,output v-fillin_width
     1763         ,output v-fillin_height
     1764         ,output v-label
     1765         ,output v-user-can-edit
     1766         ,output v-output-display
     1767         ,output v-proc
     1768         ,output v-func
     1769         ,output v-sort
     1770         ,output v-other
     1771         ) no-error .
     1772       if error-status :error then do:
     1773         message
     1774           vss-workfile vss-revision vss-description skip
     1775           error-status :get-message(1) skip
     1776           return-value skip
     1777           ""
     1778           view-as alert-box error
     1779         .
     1780         undo, return error return-value .
     1781       end.
     1782       find first buf_ord-line-attr exclusive-lock
     1783         where buf_ord-line-attr.doc-code  = p-doc-code
     1784           and buf_ord-line-attr.gds-code  = p-gds-code
     1785           and buf_ord-line-attr.attr-code = p-code
     1786         no-error .
     1787       if not available buf_ord-line-attr then do:
     1788         create buf_ord-line-attr .
     1789         assign
     1790           buf_ord-line-attr.doc-code   = p-doc-code
     1791           buf_ord-line-attr.gds-code   = p-gds-code
     1792           buf_ord-line-attr.attr-code  = p-code
     1793         .
     1794       end.
     1795       assign
     1796         buf_ord-line-attr.attr-value = p-value
     1797       .
     1798   end.
     1799   end procedure.
     1800   procedure ordlineattr-exist :
     1801     do
     1802     on error undo, return error return-value
     1803     :
     1804       define input parameter p-doc-code like ub.ord-line-attr.doc-code   no-undo .
     1805       define input parameter p-gds-code like ub.ord-line-attr.gds-code   no-undo .
     1806       define input parameter p-code     like ub.ord-line-attr.attr-code  no-undo .
     1807       define output parameter p-exist   as logical  no-undo .
     1808       define buffer buf_ord-line-attr for ub.ord-line-attr .
     1809       define variable v-type           as character no-undo .
     1810       define variable v-format         as character no-undo .
     1811       define variable v-fillin_width   as integer   no-undo .
     1812       define variable v-fillin_height  as integer   no-undo .
     1813       define variable v-label          as character no-undo .
     1814       define variable v-user-can-edit  as logical   no-undo .
     1815       define variable v-output-display as logical   no-undo .
     1816       define variable v-other          as character no-undo .
     1817       define variable v-proc           as character no-undo .
     1818       define variable v-func           as character no-undo .
     1819       define variable v-sort           as integer   no-undo .
     1820       run ordlineattr-code in this-procedure
     1821         (input  p-code
     1822         ,output v-type
     1823         ,output v-format
     1824         ,output v-fillin_width
     1825         ,output v-fillin_height
     1826         ,output v-label
     1827         ,output v-user-can-edit
     1828         ,output v-output-display
     1829         ,output v-proc
     1830         ,output v-func
     1831         ,output v-sort
     1832         ,output v-other
     1833         ) no-error .
     1834       if error-status :error then do:
     1835         undo, return error return-value .
     1836       end.
     1837       find first buf_ord-line-attr no-lock
     1838         where buf_ord-line-attr.doc-code  = p-doc-code
     1839           and buf_ord-line-attr.gds-code = p-gds-code
     1840           and buf_ord-line-attr.attr-code = p-code
     1841         no-error .
     1842       if  available buf_ord-line-attr then do:
     1843         p-exist = yes.
     1844       end.
     1845     end.
     1846   end procedure.
     1847   procedure ordlineattr-delete :
     1848     do
     1849     on error undo, return error return-value
     1850     :
     1851       define input parameter p-doc-code like ub.ord-line-attr.doc-code   no-undo .
     1852       define input parameter p-gds-code like ub.ord-line-attr.gds-code   no-undo .
     1853       define input parameter p-code     like ub.ord-line-attr.attr-code  no-undo .
     1854       define output parameter p-deleted  as logical no-undo.
     1855       define buffer buf_ord-line-attr for ub.ord-line-attr .
     1856       define variable v-type           as character no-undo .
     1857       define variable v-format         as character no-undo .
     1858       define variable v-fillin_width   as integer   no-undo .
     1859       define variable v-fillin_height  as integer   no-undo .
     1860       define variable v-label          as character no-undo .
     1861       define variable v-user-can-edit  as logical   no-undo .
     1862       define variable v-output-display as logical   no-undo .
     1863       define variable v-proc           as character no-undo .
     1864       define variable v-func           as character no-undo .
     1865       define variable v-sort           as integer   no-undo .
     1866       define variable v-other          as character no-undo .
     1867       run ordlineattr-code in this-procedure
     1868         (input  p-code
     1869         ,output v-type
     1870         ,output v-format
     1871         ,output v-fillin_width
     1872         ,output v-fillin_height
     1873         ,output v-label
     1874         ,output v-user-can-edit
     1875         ,output v-output-display
     1876         ,output v-proc
     1877         ,output v-func
     1878         ,output v-sort
     1879         ,output v-other
     1880         ) no-error .
     1881       if error-status :error then do:
     1882         undo, return error return-value .
     1883       end.
     1884       find first buf_ord-line-attr exclusive-lock
     1885         where buf_ord-line-attr.doc-code  = p-doc-code
     1886           and buf_ord-line-attr.gds-code  = p-gds-code
     1887           and buf_ord-line-attr.attr-code = p-code
     1888         no-error NO-WAIT.
     1889       if not available buf_ord-line-attr then do:
     1890         p-deleted = no.
     1891       end.
     1892       else do:
     1893         delete buf_ord-line-attr.
     1894         p-deleted = yes.
     1895       end.
     1896     end.
     1897   end procedure.
     1898   procedure ordlineattr-code :
     1899     do on error undo, return error return-value
     1900     :
     1901       define input  parameter p-code           as character no-undo .
     1902       define output parameter p-type           as character no-undo .
     1903       define output parameter p-format         as character no-undo .
     1904       define output parameter p-fillin_width   as integer   no-undo .
     1905       define output parameter p-fillin_height  as integer   no-undo .
     1906       define output parameter p-label          as character no-undo .
     1907       define output parameter p-user-can-edit  as logical   no-undo .
     1908       define output parameter p-output-display as logical   no-undo .
     1909       define output parameter p-proc           as character no-undo .
     1910       define output parameter p-func           as character no-undo .
     1911       define output parameter p-sort           as integer   no-undo .
     1912       define output parameter p-other          as character no-undo .
     1913       case p-code :
     1914               when 'cycle-cli-qnty':U then do:     assign     p-label          = "Количество"     p-type           = 'D':U      p-format         = ">>>>>>>>>>>>>>>9.999"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "Количество"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
     1915               when 'ord-EAN13':U then do:     assign     p-label          = "EAN в EDI"     p-type           = 'C':U      p-format         = "X(13)"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "EAN в EDI"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
     1916         otherwise do:
     1917           undo, return error "неизвестный атрибут строки заказа" + " " + p-code .
     1918         end.
     1919       end.
     1920     end.
     1921   end procedure.
     1922   FUNCTION cr-edist_get-mess-mean returns character ( input p-mess as character):
     1923   define variable v-ii as integer   no-undo .
     1924   define variable v-dop as character no-undo .
     1925   define variable v-dop1 as character no-undo .
     1926   define variable v-mess as character no-undo .
     1927   do v-ii = 1 to num-entries(p-mess, chr(4) ):
     1928     v-dop = entry(v-ii, p-mess, chr(4) ).
     1929     case entry(1, v-dop, "="):
     1930       when 'pack-num':U then do:
     1931         v-dop1 =  substitute("&1 &2", 'Пакет', entry(2, v-dop, "=")).
     1932       end.
     1933       when 'route':U then do:
     1934         v-dop1 =  substitute("&1 &2", 'Рут':U, entry(2, v-dop, "=")).
     1935       end.
     1936       when 'ediiterchangeid':U then do:
     1937         v-dop1 =  substitute("&1 &2", 'ediiterchangeid':U, entry(2, v-dop, "=")).
     1938       end.
     1939       when 'price-up':U then do:
     1940         v-dop1 =  substitute("&1 &2", 'Цена':U, entry(2, v-dop, "=")).
     1941       end.
     1942       when 'price-down':U then do:
     1943         v-dop1 =  substitute("&1 &2", 'Цена':U, entry(2, v-dop, "=")).
     1944       end.
     1945       when 'vat-change':U then do:
     1946         v-dop1 =  substitute("&1 &2", 'НДС':U, entry(2, v-dop, "=")).
     1947       end.
     1948       when 'ps':U then do:
     1949         v-dop1 =  substitute("&1 &2", ' ':U, entry(2, v-dop, "=")).
     1950       end.
     1951       when 'info':U then do:
     1952         v-dop1 =  substitute("&1 &2", 'Инф:':U, entry(2, v-dop, "=")).
     1953       end.
     1954       when 'qnty-up':U then do:
     1955         v-dop1 =  substitute("&1 &2", 'Кол-во':U, entry(2, v-dop, "=")).
     1956       end.
     1957       when 'qnty-down':U then do:
     1958         v-dop1 =  substitute("&1 &2", 'Кол-во':U, entry(2, v-dop, "=")).
     1959       end.
     1960       when 'bstr-change':U then do:
     1961         v-dop1 =  substitute("&1 &2", 'Штрихкод:':U, entry(2, v-dop, "=")).
     1962       end.
     1963       when 'shipdate-change':U then do:
     1964         v-dop1 =  substitute("&1 &2", 'Дата отгрузки:':U, entry(2, v-dop, "=")).
     1965       end.
     1966       when 'clioutdoc-change':U then do:
     1967         v-dop1 =  substitute("&1 &2", '№ заказа по пост-ку:':U, entry(2, v-dop, "=")).
     1968       end.
     1969     end case.
     1970     v-mess  = v-mess + (if v-mess = '' then '' else chr(32)) + v-dop1.
     1971   end.
     1972   return v-mess.
     1973   end function.
     1974   FUNCTION cr-edist_get-error-mean returns character ( input p-mess as character):
     1975   define variable v-ii as integer   no-undo .
     1976   define variable v-dop as character no-undo .
     1977   define variable v-dop1 as character no-undo .
     1978   define variable v-mess as character no-undo .
     1979   do v-ii = 1 to num-entries(p-mess, chr(4) ):
     1980     v-dop = entry(v-ii, p-mess, chr(4) ).
     1981     case entry(1, v-dop, "="):
     1982       when 'pack-num':U then do:
     1983         v-dop1 =  substitute("&1 &2", 'Пакет', entry(2, v-dop, "=")).
     1984       end.
     1985       when 'route':U then do:
     1986         v-dop1 =  substitute("&1 &2", 'Рут':U, entry(2, v-dop, "=")).
     1987       end.
     1988       when 'ediiterchangeid':U then do:
     1989         v-dop1 =  substitute("&1 &2", 'ediiterchangeid':U, entry(2, v-dop, "=")).
     1990       end.
     1991       when 'price-up':U then do:
     1992         v-dop1 =  substitute("&1 &2", 'Цена':U, entry(2, v-dop, "=")).
     1993       end.
     1994       when 'price-down':U then do:
     1995         v-dop1 =  substitute("&1 &2", 'Цена':U, entry(2, v-dop, "=")).
     1996       end.
     1997       when 'vat-change':U then do:
     1998         v-dop1 =  substitute("&1 &2", 'НДС':U, entry(2, v-dop, "=")).
     1999       end.
     2000       when 'ps':U then do:
     2001         v-dop1 =  substitute("&1 &2", ' ':U, entry(2, v-dop, "=")).
     2002       end.
     2003       when 'info':U then do:
     2004         v-dop1 =  substitute("&1 &2", 'Инф:':U, entry(2, v-dop, "=")).
     2005       end.
     2006       when 'qnty-up':U then do:
     2007         v-dop1 =  substitute("&1 &2", 'Кол-во':U, entry(2, v-dop, "=")).
     2008       end.
     2009       when 'qnty-down':U then do:
     2010         v-dop1 =  substitute("&1 &2", 'Кол-во':U, entry(2, v-dop, "=")).
     2011       end.
     2012       when 'bstr-change':U then do:
     2013         v-dop1 =  substitute("&1 &2", 'Штрихкод:':U, entry(2, v-dop, "=")).
     2014       end.
     2015       when 'shipdate-change':U then do:
     2016         v-dop1 =  substitute("&1 &2", 'Дата отгрузки:':U, entry(2, v-dop, "=")).
     2017       end.
     2018       when 'clioutdoc-change':U then do:
     2019         v-dop1 =  substitute("&1 &2", '№ заказа по пост-ку:':U, entry(2, v-dop, "=")).
     2020       end.
     2021     end case.
     2022     v-mess  = v-mess + (if v-mess = '' then '' else chr(4)) + v-dop1.
     2023   end.
     2024   return v-mess.
     2025   end function.
     2026   FUNCTION cr-edist_get-mess-key-value returns character ( input p-mess as character, input p-key as character):
     2027   define variable v-ii as integer   no-undo .
     2028   define variable v-dop as character no-undo .
     2029   define variable v-dop1 as character no-undo .
     2030   define variable v-value as character no-undo .
     2031   do v-ii = 1 to num-entries(p-mess, chr(4) ):
     2032     v-dop = entry(v-ii, p-mess, chr(4) ).
     2033     if entry(1, v-dop, "=") = p-key then do:
     2034       return entry(2, v-dop, "=").
     2035     end.
     2036   end.
     2037   return v-value.
     2038   end function.
     2039   FUNCTION cr-edist_add-edist-mess returns character ( input p-mess as character
     2040                                                        ,input p-key as character
     2041                                                        ,input p-value as character):
     2042   define variable v-dop as character no-undo .
     2043   define variable v-modificator as character no-undo .
     2044   assign
     2045   v-modificator = entry(2, p-key, "-") no-error .
     2046   case v-modificator:
     2047     when "up" then do:
     2048       v-dop = substitute("&1=&2<&3", p-key, entry(1, p-value, chr(4)) , entry(2, p-value, chr(4))).
     2049     end.
     2050     when "down" then do:
     2051       v-dop = substitute("&1=&2>&3", p-key, entry(1, p-value, chr(4)) , entry(2, p-value, chr(4))).
     2052     end.
     2053     when "change" then do:
     2054       v-dop = substitute("&1=&2 ->&3", p-key, entry(1, p-value, chr(4)) , entry(2, p-value, chr(4))).
     2055     end.
     2056     otherwise do:
     2057       v-dop = substitute("&1=&2", p-key, p-value).
     2058     end.
     2059   end case.
     2060   if p-mess = ''
     2061   or p-mess = ? then do:
     2062     return v-dop .
     2063   end.
     2064   else do:
     2065     return substitute("&1&2&3", p-mess, chr(4), v-dop).
     2066   end.
     2067   end function.
     2068   procedure create-edi-state :
     2069   define input  parameter p-tbl-name   as character no-undo .
     2070   define input  parameter p-doc-code   as character no-undo .
     2071   define input  parameter p-cli-type   as character no-undo .
     2072   define input  parameter p-cli-code   as integer   no-undo .
     2073   define input  parameter p-act        as character no-undo .
     2074   define input  parameter p-state      as character no-undo .
     2075   define input  parameter p-err        as integer   no-undo .
     2076   define input  parameter p-des        as character no-undo .
     2077   define input  parameter p-mess       as character no-undo .
     2078   define input  parameter p-dm         as integer  no-undo .
     2079   define input-output parameter p-date       as date no-undo .
     2080   define input-output parameter p-time       as integer no-undo .
     2081   define buffer buf_EDI-status for ub.EDI-status  .
     2082   define variable v-time as integer   no-undo .
     2083   define variable v-date as date   no-undo .
     2084   do
     2085   on error undo, return error return-value
     2086   :
     2087     if p-date = ? then do:
     2088       run cur-time in this-procedure ( output v-date, output v-time).
     2089     end.
     2090     else do:
     2091       assign
     2092       v-date = p-date
     2093       v-time = p-time
     2094       .
     2095     end.
     2096     find first buf_edi-status exclusive-lock where
     2097                 buf_edi-status.date-status = v-date
     2098             and buf_edi-status.time-status = v-time
     2099             and buf_edi-status.tbl-name    = p-tbl-name
     2100             and buf_edi-status.doc-code    = p-doc-code no-error .
     2101     if not available buf_edi-status  then do:
     2102       create buf_edi-status.
     2103     end.
     2104     assign
     2105     buf_edi-status.act         = p-act        .
     2106     buf_edi-status.cli-type    = p-cli-type   .
     2107     buf_edi-status.cli-code    = p-cli-code   .
     2108     buf_edi-status.des-err     = buf_edi-status.des-err + (if buf_edi-status.des-err = '' then '' else chr(4)) + p-des        .
     2109     buf_edi-status.doc-code    = p-doc-code   .
     2110     buf_edi-status.err-code    = p-err        .
     2111     buf_edi-status.mess-id     = buf_edi-status.mess-id + (if buf_edi-status.mess-id = '' then '' else chr(4)) + p-mess       .
     2112     buf_edi-status.state       = p-state      .
     2113     buf_edi-status.tbl-name    = p-tbl-name   .
     2114     buf_edi-status.date-status = v-date       .
     2115     buf_edi-status.time-status = v-time       .
     2116     buf_edi-status.whole-send-news = p-dm     .
     2117     buf_edi-status.user-name   = (if g#news then (chr(4) +  'СПН':U)
     2118                                       else (if g#esys
     2119                                             then (chr(4) +  'ВС':U)
     2120                                             else g#userid)
     2121                                       )       .
     2122     assign
     2123     p-date = buf_edi-status.date-status
     2124     p-time = buf_edi-status.time-status
     2125     .
     2126   end.
     2127   end procedure.
     2128   procedure update-edi-state-light :
     2129   define input  parameter p-tbl-name   as character no-undo .
     2130   define input  parameter p-doc-code   as character no-undo .
     2131   define input  parameter p-date-status as date no-undo .
     2132   define input  parameter p-time-status as integer no-undo .
     2133   define input  parameter p-state      as character no-undo .
     2134   define input  parameter p-err        as integer   no-undo .
     2135   define input  parameter p-des        as character no-undo .
     2136   define input  parameter p-mess       as character no-undo .
     2137   define buffer buf_edi-status for ub.edi-status.
     2138   do
     2139   on error undo, return error
     2140   :
     2141     find first buf_edi-status exclusive-lock where
     2142                 buf_edi-status.date-status = p-date-status
     2143             and buf_edi-status.time-status = p-time-status
     2144             and buf_edi-status.tbl-name    = p-tbl-name
     2145             and buf_edi-status.doc-code    = p-doc-code no-error .
     2146     if available buf_edi-status  then do:
     2147       assign
     2148       buf_edi-status.des-err     = p-des        .
     2149       buf_edi-status.err-code    = p-err        .
     2150       buf_edi-status.mess-id     = p-mess       .
     2151       buf_edi-status.state       = p-state      .
     2152     end.
     2153   end.
     2154   end procedure.
     2155   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2156   PROCEDURE write-bonus :
     2157   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     2158   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     2159   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     2160   define input  parameter v-bonus as decimal   no-undo .
     2161     do
     2162     on error undo, return error return-value
     2163     :
     2164       find first ub.contract-specif-attr exclusive-lock  where
     2165                  ub.contract-specif-attr.contract-num = p-contract-num  and
     2166                  ub.contract-specif-attr.host-code    = p-host-code     and
     2167                  ub.contract-specif-attr.gds-code     = p-gds-code      and
     2168                  ub.contract-specif-attr.attr-code    = 'bonus':U
     2169                 no-error .
     2170         if not available ub.contract-specif-attr then do:
     2171            create ub.contract-specif-attr .
     2172            assign
     2173                 ub.contract-specif-attr.contract-num = p-contract-num
     2174                 ub.contract-specif-attr.host-code    = p-host-code
     2175                 ub.contract-specif-attr.gds-code     = p-gds-code
     2176                 ub.contract-specif-attr.attr-code    = 'bonus':U
     2177            .
     2178         end.
     2179         ub.contract-specif-attr.attr-value  = string (v-bonus) .
     2180   end.
     2181   END PROCEDURE.
     2182   PROCEDURE read-bonus :
     2183   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     2184   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     2185   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     2186   define output parameter v-bonus as decimal   no-undo .
     2187     do
     2188     on error undo, return error return-value
     2189     :
     2190   find first ub.contract-specif-attr no-lock  where
     2191              ub.contract-specif-attr.contract-num = p-contract-num  and
     2192              ub.contract-specif-attr.host-code    = p-host-code     and
     2193              ub.contract-specif-attr.gds-code     = p-gds-code      and
     2194              ub.contract-specif-attr.attr-code    = 'bonus':U
     2195              no-error .
     2196      if available ub.contract-specif-attr then  v-bonus = decimal (ub.contract-specif-attr.attr-value ) .
     2197                                           else  v-bonus = 0 .
     2198   end.
     2199   END PROCEDURE.
     2200   PROCEDURE write-prc-min :
     2201   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
