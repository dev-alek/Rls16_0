     2222            .
     2223         end.
     2224         else do:
     2225            ub.contract-specif-attr.attr-value  = string (v-prc-min) .
     2226         end.
     2227       find first ub.contract-specif exclusive-lock where
     2228           ub.contract-specif.contract-num = p-contract-num and
     2229           ub.contract-specif.host-code    = p-host-code    and
