     3080    define variable ImpData1 as class Route-data_ no-undo .
     3081   ImpData1 = new Route-data_( input parparentproc, input p-parent-handle, input p-log-handle, input this-procedure:handle, input v_dataseth, input v-xmlh) .
     3082   if not this-procedure:persistent then do:
     3083     run proc-main in this-procedure  no-error .
     3084     if error-status:error then do:
     3085         run delete-procedure in this-procedure .
     3086         undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     3087     end.
