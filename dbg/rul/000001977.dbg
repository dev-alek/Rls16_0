     2216            assign
     2217                 ub.contract-specif-attr.contract-num = p-contract-num
     2218                 ub.contract-specif-attr.host-code    = p-host-code
     2219                 ub.contract-specif-attr.gds-code     = p-gds-code
     2220                 ub.contract-specif-attr.attr-code    = 'prc-min':U
