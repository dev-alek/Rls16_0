      433   define variable log-file-name                as character      no-undo init "process-edoc.txt".
      434   define variable v-view-log                   as logical        no-undo .
      435   define variable v-stop                       as logical        no-undo .
      436   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      437   def var vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      438   procedure gen-key-rec :
      439     define input  parameter p-tbl-name    as character no-undo.
      440     define input  parameter p-bh_tbl-name as handle    no-undo.
      441     define output parameter p-key-rec     as character no-undo.
      442     do
      443     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      444     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      445     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      446     :
      447       define variable fh               as handle    no-undo .
      448       define variable v-ok             as logical   no-undo .
      449       define variable v-inform         as character no-undo .
      450       define variable v-ind            as integer   no-undo .
      451       define variable v-idx-field-qnty as integer   no-undo .
      452       if p-tbl-name = ?
      453         or p-tbl-name = "":U
      454       then do:
      455         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info5 ).
      456       end.
      457       if not p-bh_tbl-name:available then do:
      458         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info5, p-tbl-name ).
      459       end.
      460       assign
      461         p-key-rec = p-tbl-name
      462         v-inform  = p-bh_tbl-name:index-information(1)
      463         v-ind     = 2
      464       .
      465       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      466       on error undo, return error
      467       :
      468         assign
      469           v-inform = p-bh_tbl-name:index-information( v-ind )
      470           v-ind    = v-ind + 1
      471         .
      472       end.
      473       if v-inform = ?
      474         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      475         or entry( 3, v-inform, ",":U ) <> "1":U
      476       then do:
      477         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, p-tbl-name ).
      478       end.
      479       else do:
      480         assign
      481           v-idx-field-qnty = num-entries( v-inform ) - 4
      482         .
      483         if v-idx-field-qnty < 2 then do:
      484           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, p-tbl-name ).
      485         end.
      486         do v-ind = 1 to v-idx-field-qnty by 2
      487         on error undo, return error
      488         :
      489           assign
      490             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      491             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      492           .
      493         end.
      494       end.
      495       if p-key-rec = ? then do:
      496         assign
      497           p-key-rec = "":U
      498         .
      499         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info5, p-tbl-name ).
      500       end.
      501     end.
      502     return.
      503   end procedure.
      504   procedure gen-where-keyr-tab :
      505     define input  parameter i-tableSerach as character no-undo.
      506     define input  parameter i-tablekey   as character  no-undo.
      507     define input  parameter p-key-rec    as character  no-undo.
      508     define input  parameter p-key-handle as handle     no-undo .
      509     define input  parameter p-db-name    as character  no-undo .
      510     define input  parameter p-tt-handle  as handle     no-undo .
      511     define output parameter o-Where      as character  no-undo.
      512     do
      513     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      514     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      515     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      516     :
      517       define variable v-full-tbl-name  as character no-undo .
      518       define variable bh_tbl-name      as handle    no-undo .
      519       define variable fh_key           as handle    no-undo .
      520       define variable fh_search        as handle    no-undo .
      521       define variable v-field-num      as integer   no-undo .
      522       define variable v-count-fld      as integer   no-undo .
      523       define variable v-inform         as character no-undo .
      524       define variable v-ind            as integer   no-undo .
      525       define variable v-idx-field-qnty as integer   no-undo .
      526       define variable v-field-name     as character no-undo .
      527       define variable v-field-val      as character no-undo .
      528       define variable v-word-link      as character no-undo .
      529       define variable vTable           as character no-undo.
      530       define variable bh_tbl-key       as handle    no-undo .
      531       assign
      532         p-key-rec = trim( p-key-rec )
      533       .
      534       if p-key-handle <> ? then do:
      535         if not valid-handle(p-key-handle)
      536            or p-key-handle:type <> "buffer"
      537         then do:
      538           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info5 ).
      539         end.
      540         if num-entries( p-key-rec, chr(3) ) > 1
      541           or p-key-rec = ?
      542           or p-key-rec = "":U
      543         then do:
      544           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info5, p-key-rec ).
      545         end.
      546       end.
      547       else do:
      548         if p-key-rec = ?
      549           or p-key-rec = "":U
      550         then do:
      551           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info5 ).
      552         end.
      553       end.
      554       assign
      555         vTable = entry( 1 , p-key-rec, chr(3) )
      556       .
      557       if p-tt-handle <> ?
      558         and ( not valid-handle(p-tt-handle)
      559               or p-tt-handle:type <> "buffer"
      560             )
      561       then do:
      562         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info5, vTable, chr(10) ).
      563       end.
      564       if p-tt-handle = ? then do:
      565         assign
      566           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      567         .
      568         create buffer bh_tbl-name for table v-full-tbl-name .
      569       end.
      570       else do:
      571         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      572       end.
      573       assign
      574         v-inform = bh_tbl-name:index-information(1)
      575         v-ind    = 2
      576       .
      577       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      578       on error undo, return error
      579       :
      580         assign
      581           v-inform = bh_tbl-name:index-information( v-ind )
      582           v-ind    = v-ind + 1
      583         .
      584       end.
      585       if v-inform = ?
      586         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      587         or entry( 3, v-inform, ",":U ) <> "1":U
      588       then do:
      589         delete object bh_tbl-name no-error.
      590         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info5, vTable ).
      591       end.
      592       assign
      593         v-idx-field-qnty = num-entries( v-inform ) - 4
      594       .
      595       if v-idx-field-qnty < 2 then do:
      596         delete object bh_tbl-name no-error.
      597         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, vTable ).
      598       end.
      599       assign
      600         o-where     = "where":U
      601         v-word-link = "":U
      602         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      603         v-count-fld = 0
      604       .
      605       if i-tablekey ne "" and i-tablekey ne ?
      606       then do:
      607         assign
      608           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      609         .
      610         create buffer bh_tbl-key for table v-full-tbl-name .
      611       end.
      612       if i-tableSerach ne "" and i-tableSerach ne ?
      613       then do:
      614         delete object bh_tbl-name no-error.
      615         assign
      616           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      617         .
      618         create buffer bh_tbl-name for table v-full-tbl-name .
      619       end.
      620       block_where:
      621       do v-ind = 1 to v-idx-field-qnty by 2
      622       on error undo, return error
      623       :
      624         assign
      625           v-count-fld = v-count-fld + 1
      626         .
      627         if p-key-handle = ?
      628           and v-count-fld > v-field-num
      629         then do:
      630           leave block_where.
      631         end.
      632         define variable VfieldKeyTable as handle no-undo.
      633         assign
      634           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      635           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      636         .
      637         if     bh_tbl-key ne ?
      638         then do:
      639            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      640            if VfieldKeyTable eq ?
      641            then next block_where.
      642         end.
      643         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      644         then
      645            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      646         else
      647            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      648         if p-key-handle = ? then do:
      649           assign
      650             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      651           .
      652         end.
      653         else do:
      654           assign
      655             fh_key = p-key-handle:buffer-field( v-field-name )
      656           .
      657           if fh_key = ?
      658             or not valid-handle( fh_key )
      659           then do:
      660             delete object bh_tbl-name.
      661             if     bh_tbl-key ne ?
      662             then
      663                delete object bh_tbl-key.
      664             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info5, p-key-handle:name, v-field-name ).
      665           end.
      666           assign
      667             v-field-val = fh_key:buffer-value
      668           .
      669         end.
      670         if fh_search:data-type ="character":U then do:
      671           assign
      672             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      673             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      674             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      675             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      676             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      677             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      678             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      679             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      680             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      681             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      682             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      683             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      684             v-field-val = substitute( '"&1"', v-field-val )
      685           .
      686         end.
      687         assign
      688           o-where = substitute( "&1 &2", o-where, v-field-val )
      689         .
      690         if v-word-link = "":U then do:
      691           assign
      692             v-word-link = "and":U
      693           .
      694         end.
      695       end.
      696       delete object bh_tbl-name.
      697       if     bh_tbl-key ne ?
      698       then
      699          delete object bh_tbl-key.
      700       if p-key-handle = ?
      701         and v-count-fld <> v-field-num
      702       then do:
      703         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info5, vTable ).
      704       end.
      705     end.
      706   end procedure.
      707   procedure gen-hn-keyr-tab :
      708     define input  parameter i-tableSerach as character no-undo.
      709     define input  parameter i-tablekey   as character no-undo.
      710     define input  parameter p-key-rec    as character no-undo.
      711     define input  parameter p-key-handle as handle    no-undo .
      712     define input  parameter p-db-name    as character no-undo .
      713     define input  parameter p-tt-handle  as handle    no-undo .
      714     define input  parameter p-stts-lock  as integer   no-undo .
      715     define output parameter o-hn         as handle    no-undo.
      716     define variable v-full-tbl-name as character no-undo.
      717     define variable v-where         as character no-undo.
      718     define variable bh_tbl-name     as handle    no-undo.
      719     define variable vTable          as character no-undo.
      720     do
      721     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      722     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      723     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      724         run gen-where-keyr-tab(i-tableSerach,
      725                                i-tablekey,
      726                                p-key-rec,
      727                                p-key-handle,
      728                                p-db-name,
      729                                p-tt-handle,
      730                                output v-where).
      731         if i-tableSerach ne "" and i-tableSerach ne ?
      732         then do:
      733            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      734            create buffer bh_tbl-name for table v-full-tbl-name .
      735         end.
      736         else do:
      737            if p-tt-handle = ? then do:
      738               assign
      739                  vTable = entry( 1 , p-key-rec, chr(3) )
      740               .
      741               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      742               create buffer bh_tbl-name for table v-full-tbl-name .
      743            end.
      744            else do:
      745               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      746            end.
      747         end.
      748         if p-tt-handle = ? then do:
      749            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      750         end.
      751         else do:
      752            bh_tbl-name:find-first( v-where ) no-error .
      753         end.
      754         o-hn = bh_tbl-name.
      755      end.
      756   end procedure.
      757   procedure gen-hn-keyr :
      758     define input  parameter p-key-rec    as character no-undo.
      759     define input  parameter p-key-handle as handle    no-undo .
      760     define input  parameter p-db-name    as character no-undo .
      761     define input  parameter p-tt-handle  as handle    no-undo .
      762     define input  parameter p-stts-lock  as integer   no-undo .
      763     define output parameter o-hn         as handle    no-undo.
      764     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      765   end.
      766   procedure gen-row-keyr :
      767     define input  parameter p-key-rec    as character no-undo.
      768     define input  parameter p-key-handle as handle    no-undo .
      769     define input  parameter p-db-name    as character no-undo .
      770     define input  parameter p-tt-handle  as handle    no-undo .
      771     define input  parameter p-stts-lock  as integer   no-undo .
      772     define output parameter p-tbl-row    as rowid     no-undo.
      773     define output parameter p-tbl-name   as character no-undo.
      774     define variable vHn as handle no-undo.
      775       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      776       p-tbl-row = if vHn:available then vHn:rowid else ?.
      777       p-tbl-name =  vHn:table.
      778       delete object vHn no-error.
      779     if p-tbl-row = ? then do:
      780       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info5, p-tbl-name, p-key-rec ).
      781     end.
      782     else do:
      783       return.
      784     end.
      785   end procedure.
      786   procedure gen-key-fv :
      787     define input  parameter p-key-rec    as character no-undo .
      788     define output parameter p-field-list as character no-undo .
      789     define output parameter p-value-list as character no-undo.
      790     do
      791     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      792     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      793     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      794     :
      795       define variable v-full-tbl-name  as character no-undo .
      796       define variable bh_tbl-name      as handle    no-undo .
      797       define variable v-tbl-name       as character no-undo .
      798       define variable v-field-num      as integer   no-undo .
      799       define variable v-count-fld      as integer   no-undo .
      800       define variable v-inform         as character no-undo .
      801       define variable v-ind            as integer   no-undo .
      802       define variable v-idx-field-qnty as integer   no-undo .
      803       define variable v-delim-key      as character no-undo .
      804       if p-key-rec = ?
      805         or p-key-rec = "":U
      806       then do:
      807         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info5 ).
      808       end.
      809       assign
      810         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      811         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      812       .
      813       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      814       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info5 ).
      815       assign
      816         v-inform = bh_tbl-name:index-information(1)
      817         v-ind    = 2
      818       .
      819       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      820       on error undo, return error
      821       :
      822         assign
      823           v-inform = bh_tbl-name:index-information( v-ind )
      824           v-ind    = v-ind + 1
      825         .
      826       end.
      827       if v-inform = ?
      828         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      829         or entry( 3, v-inform, ",":U ) <> "1":U
      830       then do:
      831         delete object bh_tbl-name no-error.
      832         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, v-tbl-name ).
      833       end.
      834       assign
      835         v-idx-field-qnty = num-entries( v-inform ) - 4
      836       .
      837       if v-idx-field-qnty < 2 then do:
      838         delete object bh_tbl-name no-error.
      839         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, v-tbl-name ).
      840       end.
      841       assign
      842         p-field-list = "":U
      843         p-value-list = "":U
      844         v-delim-key  = "":U
      845         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      846         v-count-fld  = 0
      847       .
      848       block_where:
      849       do v-ind = 1 to v-idx-field-qnty by 2
      850       on error undo, return error
      851       :
      852         assign
      853           v-count-fld = v-count-fld + 1
      854         .
      855         if v-count-fld > v-field-num then do:
      856           leave block_where.
      857         end.
      858         assign
      859           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      860           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      861         .
      862         if v-ind = 1 then do:
      863           assign
      864             v-delim-key = chr(3)
      865           .
      866         end.
      867       end.
      868       delete object bh_tbl-name.
      869       if v-count-fld <> v-field-num then do:
      870         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info5, v-tbl-name ).
      871       end.
      872     end.
      873   end procedure.
      874   procedure gen-key-field :
      875     define input  parameter p-table      as character no-undo .
      876     define output parameter p-field-list as character no-undo .
      877     do
      878     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      879     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      880     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      881     :
      882       define variable v-full-tbl-name  as character no-undo .
      883       define variable bh_tbl-name      as handle    no-undo .
      884       define variable v-tbl-name       as character no-undo .
      885       define variable v-field-num      as integer   no-undo .
      886       define variable v-count-fld      as integer   no-undo .
      887       define variable v-inform         as character no-undo .
      888       define variable v-ind            as integer   no-undo .
      889       define variable v-idx-field-qnty as integer   no-undo .
      890       define variable v-delim-key      as character no-undo .
      891       if p-table = ?
      892         or p-table = "":U
      893       then do:
      894         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info5 ).
      895       end.
      896       assign
      897         v-tbl-name      = p-table
      898         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      899       .
      900       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      901       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info5 ).
      902       assign
      903         v-inform = bh_tbl-name:index-information(1)
      904         v-ind    = 2
      905       .
      906       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      907       on error undo, return error
      908       :
      909         assign
      910           v-inform = bh_tbl-name:index-information( v-ind )
      911           v-ind    = v-ind + 1
      912         .
      913       end.
      914       if v-inform = ?
      915         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      916         or entry( 3, v-inform, ",":U ) <> "1":U
      917       then do:
      918         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, v-tbl-name ).
      919       end.
      920       assign
      921         v-idx-field-qnty = num-entries( v-inform ) - 4
      922       .
      923       if v-idx-field-qnty < 2 then do:
      924         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, v-tbl-name ).
      925       end.
      926       assign
      927         p-field-list = "":U
      928         v-delim-key  = "":U
      929         v-count-fld  = 0
      930       .
      931       block_where:
      932       do v-ind = 1 to v-idx-field-qnty by 2
      933       on error undo, return error
      934       :
      935         assign
      936           v-count-fld = v-count-fld + 1
      937         .
      938         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      939         if v-ind = 1 then do:
      940           assign
      941             v-delim-key = chr(3)
      942           .
      943         end.
      944       end.
      945       delete object bh_tbl-name.
      946     end.
      947   end procedure.
      948   define SHARED temp-table temp-cmd no-undo
      949   field cmd-code as integer
      950   field db-list as character
      951   index pi is unique primary
      952   db-list
      953   index icmd
      954   cmd-code
      955   .
      956   define SHARED temp-table temp-smart-route no-undo
      957   field key-field as character
      958   field db-num as integer
      959   index pi is unique primary
      960   key-field
      961   db-num
      962   .
      963   define SHARED temp-table temp-no-route no-undo
      964   field rec-ord as integer
      965   field db-num as integer
      966   index pi is unique primary
      967   db-num
      968   rec-ord
      969   index iro
      970   rec-ord
      971   .
      972   define SHARED temp-table temp-smart-link no-undo
      973   field uniq-key-rec as character
      974   field key-field as character
      975   field rec-ord as integer
      976   field is-smart as logical
      977   index pi is unique primary
      978   key-field
      979   uniq-key-rec
      980   rec-ord
      981   index iu
      982   uniq-key-rec
      983   index iro
      984   rec-ord
      985   .
      986   define SHARED temp-table temp-nws-outline no-undo
      987   like ub.nws-outline.
      988   procedure create-smart-route :
      989   define input parameter p-key-field as character no-undo .
      990   define input parameter p-db-num as integer no-undo .
      991   define buffer buf_temp-smart-route for temp-smart-route.
      992     do
      993     on error undo, return error
      994     :
      995       find first buf_temp-smart-route where
      996                 buf_temp-smart-route.key-field = p-key-field
      997             and buf_temp-smart-route.db-num = p-db-num no-error.
      998       if not available buf_temp-smart-route then do:
      999         create buf_temp-smart-route.
     1000         assign
     1001         buf_temp-smart-route.key-field = p-key-field
     1002         buf_temp-smart-route.db-num = p-db-num
     1003         .
     1004       end.
     1005     end.
     1006   end procedure.
     1007   procedure create-smart-route-link :
     1008   define input parameter p-tbl-name as character no-undo .
     1009   define input parameter p-bh_tbl-name as handle no-undo .
     1010   define input parameter p-key-field as character no-undo .
     1011   define input parameter p-rec-ord as integer no-undo .
     1012   define input parameter p-is-smart as logical no-undo .
     1013   define variable v-key-rec as character no-undo .
     1014   define buffer buf_temp-smart-link for temp-smart-link.
     1015     do
     1016     on error undo, return error
     1017     :
     1018       run gen-key-rec in this-procedure ( input p-tbl-name
     1019                                          ,input p-bh_tbl-name
     1020                                          ,output v-key-rec     ).
     1021      find first buf_temp-smart-link where
     1022                 buf_temp-smart-link.uniq-key-rec = v-key-rec
     1023              and buf_temp-smart-link.key-field = p-key-field
     1024              and buf_temp-smart-link.rec-ord = p-rec-ord
     1025              no-error .
     1026      if not available buf_temp-smart-link then do:
     1027        create buf_temp-smart-link.
     1028        assign
     1029        buf_temp-smart-link.uniq-key-rec = v-key-rec
     1030        buf_temp-smart-link.key-field = p-key-field
     1031        buf_temp-smart-link.rec-ord = p-rec-ord
     1032        buf_temp-smart-link.is-smart = p-is-smart
     1033        .
     1034      end.
     1035     end.
     1036   end procedure.
     1037   procedure create-nws-outline :
     1038   define input parameter p-cmd-proc-handle as handle no-undo .
     1039   define input parameter p-cmd-code as integer no-undo .
     1040   define input parameter p-outline-type as character no-undo .
     1041   define input parameter p-charkey_one as character no-undo .
     1042   define input parameter p-charkey_two as character no-undo .
     1043   define input parameter p-charkey_three as character no-undo .
     1044   define input parameter p-key#_one as integer no-undo .
     1045   define input parameter p-key#_two as integer no-undo .
     1046   define input parameter p-key#_three as integer no-undo .
     1047   define variable v-no-id as integer no-undo .
     1048   define variable v-rec-ord as integer no-undo .
     1049     do
     1050     on error undo, return error return-value
     1051     :
     1052       find last temp-nws-outline use-index pi no-error .
     1053       v-no-id = (if available temp-nws-outline
     1054                  then (temp-nws-outline.no-id  + 1)
     1055                  else 1).
     1056       create temp-nws-outline.
     1057       assign
     1058       temp-nws-outline.charkeY_one = p-charkey_one
     1059       temp-nws-outline.charkeY_two = p-charkey_two
     1060       temp-nws-outline.charkeY_three = p-charkey_three
     1061       temp-nws-outline.key#_one = p-key#_one
     1062       temp-nws-outline.key#_two = p-key#_two
     1063       temp-nws-outline.key#_three = p-key#_three
     1064       temp-nws-outline.no-id = v-no-id
     1065       temp-nws-outline.outline-type = p-outline-type
     1066       .
     1067                                   run add-dump in p-cmd-proc-handle                                                                           (input p-cmd-code                                                                                         ,input 'nws-outline':U                                                                                          ,input '+update'                                                                                         ,input (buffer temp-nws-outline:handle)                                                                                    ,input ''                                                                                         ,output v-rec-ord                                                                                         ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                     delete procedure p-cmd-proc-handle .                                                                        undo , return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'nws-outline':U                                                                                                ,p-cmd-code                                                                                               ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
     1068       run  create-smart-route in this-procedure (
     1069                                                   input ('nws-outline':U + chr(4) + string(temp-nws-outline.no-id))
     1070                                                  ,input -1).
     1071       run create-smart-route-link in this-procedure (
     1072                                                      input 'nws-outline':U
     1073                                                     ,input (buffer temp-nws-outline:handle)
     1074                                                     ,input ('nws-outline':U + chr(4) + string(temp-nws-outline.no-id))
     1075                                                     ,input v-rec-ord
     1076                                                     ,input no
     1077                                                     ).
     1078     end.
     1079   end procedure.
     1080   procedure create-no-route :
     1081   define input parameter p-rec-ord as integer no-undo .
     1082   define input parameter p-db-num as integer no-undo .
     1083   define buffer buf_temp-no-route for temp-no-route.
     1084   do
     1085   on error undo, return error
     1086   :
     1087      find first buf_temp-no-route where
     1088                 buf_temp-no-route.rec-ord = p-rec-ord
     1089              and buf_temp-no-route.db-num = p-db-num no-error .
     1090      if not available buf_temp-no-route then do:
     1091        create buf_temp-no-route.
     1092        assign
     1093        buf_temp-no-route.rec-ord = p-rec-ord
     1094        buf_temp-no-route.db-num = p-db-num
     1095        .
     1096      end.
     1097   end.
     1098   end procedure.
     1099   procedure clear-from-rec-ord :
     1100   define input parameter p-rec-ord as integer no-undo .
     1101   define buffer buf_temp-no-route for temp-no-route.
     1102   define buffer buf_temp-smart-link for temp-smart-link.
     1103   do
     1104   on error undo, return error
     1105   :
     1106   for each buf_temp-no-route where
     1107           buf_temp-no-route.rec-ord > p-rec-ord:
     1108     delete buf_temp-no-route.
     1109   end.
     1110   for each buf_temp-smart-link where
     1111           buf_temp-smart-link.rec-ord > p-rec-ord:
     1112      delete buf_temp-smart-link.
     1113   end.
     1114   end.
     1115   end procedure.
     1116   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1117   define shared temp-table temp-hist-nws-option no-undo
