     3684   function 00180004_get-error-message returns character :
     3685   define variable v-ii as integer no-undo .
     3686   define variable v-mess as character no-undo .
     3687   DO v-ii = 1 TO ERROR-STATUS:NUM-MESSAGES:
     3688       v-mess = substitute("&1&2ош &3"
     3689                           ,v-mess
     3690                           ,chr(10)
     3691                           ,ERROR-STATUS:GET-MESSAGE(v-ii)).
     3692   END.
     3693   end function.
