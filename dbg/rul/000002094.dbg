     3849   procedure send-stat_contour :
     3850     define input parameter p-doc-type as character no-undo .
     3851     define input parameter p-state as character no-undo .
     3852     define input parameter p-stage as character no-undo .
     3853     define input parameter p-description as character no-undo .
     3854     define input parameter p-messID as character no-undo .
     3855     define variable v-ii as integer no-undo .
     3856     define variable v-uniq-key-rec as character no-undo .
     3857     define variable v-cli-uniq-key-rec as character no-undo .
     3858     define variable v-err as logical no-undo .
     3859     define variable v-custom-pack-name as character no-undo .
     3860     define variable v-success as logical   no-undo .
     3861     DEFINE VARIABLE v-today as date no-undo .
     3862     DEFINE VARIABLE v-time as integer no-undo .
     3863     define variable v-ord-int1 as integer no-undo .
     3864     define variable v-obj-gln as character no-undo .
     3865     define variable v-cli-gln as character no-undo .
     3866     define variable v-gln-net as character no-undo .
     3867     define variable v-type as character no-undo .
     3868     define variable v-mess as character no-undo .
     3869     define variable v-b-code as integer no-undo .
     3870     define variable v-b-str as character no-undo .
     3871     define variable v-jj as integer   no-undo .
     3872     define variable v-cli-base-rate as decimal no-undo .
     3873     define variable v-dump-ord-int64 as int64 no-undo .
     3874     define variable v-rcv-code as character no-undo .
     3875     define variable v-cli-rcv-code as character no-undo .
     3876     define variable v-EDIINTERCHANGEID as character no-undo .
     3877     define variable v-edist-mess as character no-undo .
     3878     define variable v-date-status as character no-undo .
     3879     define variable v-time-status as integer no-undo .
     3880     define variable v-error as character no-undo .
     3881     define variable v-stringdate as character no-undo .
     3882     define variable v-documentNumber as character no-undo .
     3883     define variable v-documentDate as character no-undo .
     3884     define variable sw as handle no-undo .
     3885     define buffer buf_ext-system for ub.ext-system.
     3886     define buffer buf_ord-doc for ub.ord-doc.
     3887     define buffer buf_ord-line for ub.ord-line.
     3888     define buffer buf_object for ub.clients.
     3889     define buffer buf_clients for ub.clients.
     3890     define buffer buf_ext-classif for ub.ext-classif.
     3891     define buffer esys_ext-classif for ub.ext-classif.
     3892     define buffer buf_goods for ub.goods.
     3893     define buffer buf_ord-doc-rcv for ub.ord-doc-rcv.
     3894     define buffer buf_currency for ub.currency.
     3895     define buffer buf_ord-line-attr for ub.ord-line-attr.
     3896     define buffer buf_edi-status for ub.edi-status.
     3897   _main:
     3898   do
     3899   on error undo, return error substitute( "&1&2&3&2&4", return-value, chr(10), error-status :get-message (1), v-last-error-message)
     3900   on stop undo, return error substitute( "&1&2&3&2&4", return-value, chr(10), error-status :get-message (1), v-last-error-message)
     3901   :
     3902     if retry then do:
     3903           .
     3904       undo _main, return error.
     3905     end.
     3906     else do:
     3907       assign
     3908       v-mess = ''
     3909       .
     3910       find first buf_ord-doc exclusive-lock where
     3911                 buf_ord-doc.doc-code = v-current-doc-code no-error .
     3912       if not available buf_ord-doc then do:
     3913         v-mess = substitute("Не найден заказ для поставки").
     3914         v-err = yes.
     3915         undo _main, retry _main.
     3916       end.
     3917       if p-doc-type = "DESADV" then do :
     3918           find first buf_ord-doc-rcv no-lock where buf_ord-doc-rcv.doc-code = v-current-doc-code no-error .
     3919           if available buf_ord-doc-rcv then assign v-rcv-code = buf_ord-doc-rcv.rcv-code .
     3920       end.
     3921       find first buf_clients no-lock where
     3922                 buf_clients.obj-type = buf_ord-doc.cli-type
     3923             and buf_clients.obj-code = buf_ord-doc.cli-code no-error.
     3924       if not available buf_clients then do:
     3925         v-mess =  substitute("Не найден контрагент &1&2", buf_ord-doc.cli-type, buf_ord-doc.cli-code).
     3926         v-err = yes.
     3927         undo _main, retry _main.
     3928       end.
     3929       run gen-key-rec in this-procedure ( input 'clients':U
     3930                                         ,input (buffer buf_clients:handle)
     3931                                         ,output v-cli-uniq-key-rec) no-error .
     3932       if error-status:error then do:
     3933         v-mess = substitute("gen-key-rec: &1&2&3&2(&4&5)"
     3934                                   , error-status:get-message(1)
     3935                                   , return-value
     3936                                   , chr(10)
     3937                                   , buf_ord-doc.cli-type
     3938                                   , buf_ord-doc.cli-code).
     3939         v-err = yes.
     3940         undo _main, retry _main.
     3941       end.
     3942       find first esys_ext-classif no-lock where
     3943           esys_ext-classif.classif-name = 'exite-edi':U
     3944       and esys_ext-classif.classif-subject = 'clients':U
     3945       and esys_ext-classif.db-num = -1
     3946       and esys_Ext-classif.uniq-key-rec = v-cli-uniq-key-rec no-error .
     3947       if not available esys_ext-classif then do:
     3948         v-mess = substitute("Поставщик &1&2 заказа НЕ РАБОТАЕТ ПО СИСТЕМЕ EDI", buf_ord-doc.cli-type, buf_ord-doc.cli-code).
     3949         v-err = yes.
     3950         undo _main, retry _main.
     3951       end.
     3952       find first buf_object no-lock where
     3953                 buf_object.obj-type = v-current-obj-type
     3954             and buf_object.obj-code = v-current-obj-code no-error.
     3955       if not available buf_object then do:
     3956         v-mess =  substitute("Не найден объект &1&2", v-current-obj-type, v-current-obj-code).
     3957         v-err = yes.
     3958         undo _main, retry _main.
     3959       end.
     3960       run gen-key-rec in this-procedure ( input 'clients':U
     3961                                         ,input (buffer buf_object:handle)
     3962                                         ,output v-uniq-key-rec) no-error .
     3963       if error-status:error then do:
     3964         v-mess =  substitute("gen-key-rec: &1&2&3&2(&4&5)"
     3965                                   , error-status:get-message(1)
     3966                                   , return-value
     3967                                   , chr(10)
     3968                                   , buf_object.obj-type
     3969                                   , buf_object.obj-code).
     3970         v-err = yes.
     3971         undo _main, retry _main.
     3972       end.
     3973       assign
     3974       v-obj-gln = get-gln( input buf_object.obj-type
     3975                       ,input buf_object.obj-code) no-error.
     3976       if error-status:error
     3977       or v-obj-gln = chr(63)
     3978       or v-obj-gln = '' then do:
     3979         v-mess =  substitute("Не определен GLN для &1&2"
     3980                                   , buf_object.obj-type
     3981                                   , buf_object.obj-code) .
     3982         v-err = yes.
     3983         undo _main, retry _main.
     3984       end.
     3985       v-cli-gln = get-gln( input buf_ord-doc.cli-type
     3986                           ,input buf_ord-doc.cli-code) no-error.
     3987       if error-status:error
     3988       or v-cli-gln = chr(63)
     3989       or v-cli-gln = '' then do:
     3990         v-mess =  substitute("Не определен GLN для &1&2"
