     3702   function context_begin-esys-command return logical
     3703   (
     3704       input p-esys-id-list as character
     3705      ,input-output p-esys-cmd-proc-handle as handle
     3706      ,output p-esys-cmd-code as integer
     3707   ):
     3708      if not valid-handle(p-esys-cmd-proc-handle )
     3709      then do:
     3710        run nws/cmd-bush.p persistent set p-esys-cmd-proc-handle no-error .
     3711        if error-status :error
     3712        then do:
     3713           delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( substitute("&1 &2 &3&4Ошибка при запуске процедуры cmd-bush.p&4" +
     3714                                              "&5&4&6"
     3715                                              ,vss-workfile
     3716                                              ,vss-revision
     3717                                              ,vss-description
     3718                                              ,chr(10)
     3719                                              ,error-status:get-message(1)
     3720                                              ,return-value )).
     3721        end.
     3722        run begin-create-command in p-esys-cmd-proc-handle
     3723          (input 'cmd-esys-general':U
     3724          ,input p-esys-id-list
     3725          ,output p-esys-cmd-code
     3726          ) no-error.
     3727        if error-status :error
     3728        then do:
     3729          delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при создании команды &1&2&3&1&4"
     3730                                                           , 'cmd-esys-general':U
     3731                                                           , error-status:get-message(1)
     3732                                                           , return-value
     3733                                                           )).
     3734          return no .
     3735        end.
     3736        return yes.
     3737      end.
     3738   end.
