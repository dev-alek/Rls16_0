     3341                 and buf2_ext-classif.classif-subject = 'clients':U
     3342                 and buf2_ext-classif.classif-name    = 'exite-edi':U
     3343                 and buf2_ext-classif.key#_one  = buf_ext-classif.key#_one:
     3344     leave.
