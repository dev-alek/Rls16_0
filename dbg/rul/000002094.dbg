     3758            delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при отсылке во внешнюю систему &1 команды с кодом &2&3&4&3&5"
     3759                                                           , p-esys-id-list
     3760                                                           , p-cmd-code
     3761                                                           , chr(10)
     3762                                                           , error-status:get-message(1)
     3763                                                           , return-value
     3764                                                           )).
     3765            return 0.
     3766         end.
     3767         delete procedure p-esys-cmd-proc-handle no-error.
     3768         return v-dmp-ord-int64.
     3769      end.
     3770      else do:
     3771         delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при отсылке во внешнюю систему &1 команды с кодом &2&3&4&3&5"
     3772                                                       , p-esys-id-list
     3773                                                       , p-cmd-code
