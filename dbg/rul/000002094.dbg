     4270   _ordrsp:
     4271   do transaction
     4272   on error  undo _ordrsp, retry _ordrsp
     4273   on stop   undo _ordrsp, retry _ordrsp
     4274   on endkey undo _ordrsp, retry _ordrsp
     4275   :
     4276     if retry then do:
     4277           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при импорте подтверждений заказа &1 из ВС &2&3&4"                                 ,v-current-doc-code                                 , v-esys-id                                  , chr(10)                                 , v-mess)).                      assign v-view-log = yes.
     4278       assign
     4279       v-view-log = yes.
     4280       run delete-ord-list in this-procedure ( input v-cli-out-doc
     4281                                               ).
     4282       undo _ordrsp, return error substitute("Ошибка при импорте подтверждений заказа &1 из ВС &2&3&4"                                 ,v-current-doc-code                                 , v-esys-id                                  , chr(10)                                 , v-mess).
     4283     end.
     4284     else do:
     4285       find first ordrsp.
     4286       run write-log  in p-log-handle (
     4287                                       input 0
     4288                                     , "&DLine").
     4289             run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute(".............Импорт подтверждений заказа из ВС")).                      assign v-view-log = yes.
     4290       num-rec = num-rec + 1.
     4291       find first buf_ord-doc exclusive-lock where
     4292                 buf_ord-doc.doc-code = ordrsp.ordernumber no-error.
     4293       if not available buf_ord-doc then do:
     4294         v-mess =  substitute("Не найден заказ поставщику с номером &1", ordrsp.ordernumber).
     4295         undo _ordrsp, retry _ordrsp.
