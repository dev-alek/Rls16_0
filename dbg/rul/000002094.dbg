     2205   end procedure.
     2206   procedure update-edi-state-lighttt :
     2207   define input  parameter p-tbl-name   as character no-undo .
     2208   define input  parameter p-doc-code   as character no-undo .
     2209   define input  parameter p-date-status as date no-undo .
     2210   define input  parameter p-time-status as integer no-undo .
