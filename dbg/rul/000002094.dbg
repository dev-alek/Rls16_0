     3740   function context_send-esys-command return int64
     3741   (
     3742       input p-esys-id-list as character
     3743      ,input p-esys-cmd-proc-handle as handle
     3744      ,input p-esys-cmd-code as integer
     3745      ,input p-user-id as character
     3746   ):
