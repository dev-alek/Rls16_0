     3274                                     , input (buffer buf_clients:handle)
     3275                                     , output v-uniq-key-rec).
     3276   find first buf_ext-classif no-lock
     3277        where buf_ext-classif.uniq-key-rec    = v-uniq-key-rec
     3278          and buf_ext-classif.classif-subject = 'clients':U
     3279          and buf_ext-classif.classif-name    = 'clients-edoc-nn':U
     3280          no-error.
     3281   if available buf_ext-classif then do :
     3282     return yes .
     3283   end.
     3284   return no.
     3285   END FUNCTION.
     3286   FUNCTION status-is-edi RETURN logical ( input p-is-edi as logical
     3287                                            , input p-cli-type as character
     3288                                            , input p-cli-code as integer
