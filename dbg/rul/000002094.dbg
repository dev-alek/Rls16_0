     4151       if p-messID = ? then p-messID = "" .
     4152       create sax-writer sw .
     4153       sw:formatted = true.
     4154       sw:set-output-destination ("memptr", v-DATA).
     4155       sw:encoding = "UTF-8".
     4156       sw:start-document () .
     4157       sw:start-element ("statusReport") .
     4158           sw:write-data-element ("reportDateTime", substring(iso-date(NOW), 1, 23) + "Z") .
     4159           sw:write-data-element ("reportRecipient", v-cli-gln) .
     4160           sw:start-element ("reportItem") .
     4161               sw:write-data-element ("messageId", p-messID) .
     4162               sw:write-data-element ("documentId", p-messID) .
     4163               sw:write-data-element ("messageSender", v-cli-gln) .
     4164               sw:write-data-element ("messageRecepient", v-gln-net) .
