     1173   procedure get-gate-file-name :
     1174   define input parameter p-gate-rec as character no-undo .
     1175   define output  parameter p-gate-file-name as character no-undo .
     1176   define buffer buf_clob-data for ub.clob-data.
     1177   define variable v-tbl-row as rowid no-undo .
     1178   define variable v-tbl-name as character no-undo .
     1179   run gen-row-keyr in this-procedure ( input p-gate-rec
     1180                                       ,input ?
     1181                                       ,input "ub"
     1182                                       ,input ?
     1183                                       ,input no-lock
     1184                                       ,output v-tbl-row
     1185                                       ,output v-tbl-name) no-error.
     1186   if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     1187                                                           ,vss-include-info10
     1188                                                           ,p-gate-rec).
     1189   find first buf_clob-data no-lock where
     1190             rowid(buf_clob-data) = v-tbl-row no-error.
     1191   if not available buf_clob-data then do:
     1192     if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     1193                                                             ,vss-include-info10
     1194                                                             ,p-gate-rec).
     1195   end.
     1196   p-gate-file-name = buf_clob-data.file-name.
     1197   end procedure.
     1198   procedure get-gate-rec :
     1199   define input  parameter p-gate-name as character no-undo .
     1200   define output parameter p-gate-rec as character no-undo .
     1201   define buffer buf_clob-bind for ub.clob-bind.
     1202   define buffer buf_clob-data for ub.clob-data.
     1203   main-block:
     1204   do
     1205   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info10, return-value, chr(10), error-status :get-message (1))
     1206   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info10 )
     1207   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info10 )
     1208   :
     1209       find first buf_clob-bind no-lock where
     1210                 buf_clob-bind.uniq-key-rec = p-gate-name
     1211             and buf_clob-bind.field-name = '':U
     1212             and buf_clob-bind.part-num = 1
     1213             and buf_clob-bind.resource-type = 'gate':U
     1214             no-error.
     1215       if not available buf_clob-bind then do:
     1216         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     1217                                         , p-gate-name
     1218                                         ).
     1219       end.
     1220       find first buf_clob-data no-lock where
     1221                 buf_clob-data.db-num = buf_clob-bind.db-num
     1222             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     1223       if not available buf_clob-data then do:
     1224         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1225                                         , buf_clob-bind.db-num
     1226                                         , buf_clob-bind.int64-id
     1227                                         , p-gate-name
     1228                                         ).
     1229       end.
     1230       run gen-key-rec in this-procedure ( input 'clob-data':U
     1231                                 ,input buffer buf_clob-data:handle
     1232                                 ,output p-gate-rec).
     1233   end.
     1234   end procedure.
     1235   procedure get-gate-by-name :
     1236   define input  parameter p-gate-name as character no-undo .
     1237   define output parameter p-gate-rec as character no-undo .
     1238   define output parameter p-dsh as handle no-undo .
     1239   define input-output  parameter p-xmlh as handle no-undo .
     1240   define variable v-ii as integer   no-undo .
     1241   define variable glog as logical   no-undo .
     1242   define variable v-longchar as longchar no-undo .
     1243   define variable v-txmlh as handle no-undo .
     1244   define variable v-db-num as integer no-undo .
     1245   define variable v-int64-id as int64 no-undo .
     1246   define buffer buf_clob-bind for ub.clob-bind.
     1247   define buffer buf_clob-data for ub.clob-data.
     1248   main-block:
     1249   do
     1250   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info10, return-value, chr(10), error-status :get-message (1))
     1251   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info10 )
     1252   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info10 )
     1253   :
     1254       find first buf_clob-bind no-lock where
     1255                 buf_clob-bind.uniq-key-rec = p-gate-name
     1256             and buf_clob-bind.field-name = '':U
     1257             and buf_clob-bind.part-num = 1
     1258             and buf_clob-bind.resource-type = 'gate':U
     1259             no-error.
     1260       if not available buf_clob-bind then do:
     1261         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     1262                                         , p-gate-name
     1263                                         ).
     1264       end.
     1265       find first buf_clob-data no-lock where
     1266                 buf_clob-data.db-num = buf_clob-bind.db-num
     1267             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     1268       if not available buf_clob-data then do:
     1269         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1270                                         , buf_clob-bind.db-num
     1271                                         , buf_clob-bind.int64-id
     1272                                         , p-gate-name
     1273                                         ).
     1274       end.
     1275       assign
     1276       v-longchar = buf_clob-data.cdata
     1277       .
     1278       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1279       if error-status :error then do:
     1280         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1281       end.
     1282       create dataset p-dsh .
     1283       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1284                                     , v-longchar
     1285                                     , ?
     1286                                     , ?
     1287                                     , ?
     1288                                     ) no-error.
     1289       v-longchar = '':U.
     1290       if error-status :error
     1291       or not glog
     1292       then do:
     1293         undo, return error substitute("Не удалось прочитать XML-схему &1 из БД:&2&3", p-gate-name, chr(10), error-status:get-message(1) ).
     1294       end.
     1295       if not valid-handle(p-xmlh)
     1296       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1297         create temp-table v-txmlh.
     1298         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1299         v-txmlh:temp-table-prepare("temp-xml-tables").
     1300         p-xmlh = v-txmlh:default-buffer-handle.
     1301       end.
     1302       run gen-key-rec in this-procedure ( input 'clob-data':U
     1303                                 ,input buffer buf_clob-data:handle
     1304                                 ,output p-gate-rec).
     1305       do v-ii = 1 to p-dsh:num-buffers:
     1306         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1307         if not p-xmlh:available then do:
     1308           p-xmlh:buffer-create().
     1309           assign
     1310           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1311           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1312           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1313           p-xmlh::gate-handle_ = p-dsh
     1314           p-xmlh::uniq-gate-rec = p-gate-rec
     1315           p-xmlh::gate-name = p-dsh:name
     1316           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1317           .
     1318           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1319             assign
     1320             p-xmlh::order = -3.
     1321           end.
     1322         end.
     1323       end.
     1324   end.
     1325   end procedure.
     1326   procedure get-gate-by-rec :
     1327   define input  parameter p-gate-rec as character no-undo .
     1328   define output parameter p-dsh as handle no-undo .
     1329   define input-output  parameter p-xmlh as handle no-undo .
     1330   define input-output parameter p-longchar  as longchar no-undo .
     1331   define variable v-ii as integer   no-undo .
     1332   define variable glog as logical   no-undo .
     1333   define variable v-rowid as rowid no-undo .
     1334   define variable v-tbl-name as character no-undo .
     1335   define variable v-longchar as longchar no-undo .
     1336   define variable v-txmlh as handle no-undo .
     1337   define buffer buf_clob-data for ub.clob-data.
     1338   main-block:
     1339   do
     1340   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info10, return-value, chr(10), error-status :get-message (1))
     1341   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info10 )
     1342   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info10 )
     1343   :
     1344     run gen-row-keyr in this-procedure (
     1345                                           input  p-gate-rec
     1346                                           ,input  ?
     1347                                           ,input  "ub"
     1348                                           ,input  ?
     1349                                           ,input  NO-LOCK
     1350                                           ,output v-rowid
     1351                                           ,output v-tbl-name   ) no-error.
     1352       find first buf_clob-data no-lock where
     1353                 rowid(buf_clob-data) = v-rowid  no-error.
     1354       if not available buf_clob-data then do:
     1355         undo, return error substitute("Не найден CLOB  &1"
     1356                                         , p-gate-rec
     1357                                         ).
     1358       end.
     1359       assign
     1360       v-longchar = buf_clob-data.cdata
     1361       .
     1362       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1363       if error-status :error then do:
     1364         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1365       end.
     1366       create dataset p-dsh .
     1367       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1368                                     , v-longchar
     1369                                     , ?
     1370                                     , ?
     1371                                     , ?
     1372                                     ) no-error.
     1373       define variable v-esm as character no-undo .
     1374       v-esm = error-status:get-message(1) .
     1375       if p-longchar <> ? then do:
     1376         p-longchar = v-longchar.
     1377       end.
     1378       v-longchar = '':U.
     1379       if error-status :error
     1380       or not glog
     1381       then do:
     1382         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     1383                                      , p-gate-rec
     1384                                      , p-gate-rec
     1385                                      , v-esm
     1386                                      ).
     1387       end.
     1388       p-dsh:private-data = buf_clob-data.file-name_ + chr(4) + p-gate-rec.
     1389       if not valid-handle(p-xmlh)
     1390       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1391         create temp-table v-txmlh.
     1392         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1393         v-txmlh:temp-table-prepare("temp-xml-tables").
     1394         p-xmlh = v-txmlh:default-buffer-handle.
     1395       end.
     1396       do v-ii = 1 to p-dsh:num-buffers:
     1397         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1398         if not p-xmlh:available then do:
     1399           p-xmlh:buffer-create().
     1400           assign
     1401           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1402           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1403           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1404           p-xmlh::gate-handle_ = p-dsh
     1405           p-xmlh::uniq-gate-rec = p-gate-rec
     1406           p-xmlh::gate-name = p-dsh:name
     1407           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1408           .
     1409           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1410             assign
     1411             p-xmlh::order = -3.
     1412           end.
     1413           p-xmlh:buffer-release().
     1414         end.
     1415       end.
     1416   end.
     1417   end procedure.
     1418   procedure get-gate-by-file :
     1419   define input  parameter p-schema-file-name as character no-undo .
     1420   define input  parameter p-gate-rec as character no-undo .
     1421   define output parameter p-dsh as handle no-undo .
     1422   define input-output  parameter p-xmlh as handle no-undo .
     1423   define variable v-ii as integer   no-undo .
     1424   define variable glog as logical   no-undo .
     1425   define variable v-rowid as rowid no-undo .
     1426   define variable v-tbl-name as character no-undo .
     1427   define variable v-longchar as longchar no-undo .
     1428   define variable v-txmlh as handle no-undo .
     1429   main-block:
     1430   do
     1431   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info10, return-value, chr(10), error-status :get-message (1))
     1432   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info10 )
     1433   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info10 )
     1434   :
     1435       COPY-LOB
     1436       FROM  FILE p-schema-file-name
     1437       TO  OBJECT v-longchar
     1438       no-convert
     1439       NO-ERROR .
     1440       if error-status :error then do:
     1441           undo, return error substitute("Не удалось считать файл схемы &1 в память&2&3"
     1442                                     , p-schema-file-name
     1443                                 , chr(10)
     1444                                 , error-status:get-message(1) ).
     1445       end.
     1446       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1447       if error-status :error then do:
     1448         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, p-schema-file-name, chr(10), error-status:get-message(1) , return-value ).
     1449       end.
     1450       create dataset p-dsh .
     1451       glog = p-dsh:READ-XMLSCHEMA( "longchar"
     1452                                     , v-longchar
     1453                                     , ?
     1454                                     , ?
     1455                                     , ?
     1456                                     ) no-error.
     1457       v-longchar = ''.
     1458       if error-status :error
     1459       or not glog
     1460       then do:
     1461         undo, return error substitute("Не удалось прочитать XML-схему из файла &1&2&3"
     1462                                      , p-schema-file-name
     1463                                      ,chr(10)
     1464                                      , error-status:get-message(1)
     1465                                      ).
     1466       end.
     1467       if not valid-handle(p-xmlh)
     1468       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1469         create temp-table v-txmlh.
     1470         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1471         v-txmlh:temp-table-prepare("temp-xml-tables").
     1472         p-xmlh = v-txmlh:default-buffer-handle.
     1473       end.
     1474       do v-ii = 1 to p-dsh:num-buffers:
     1475         p-xmlh:find-first(substitute(' where tbl-name = "&1" and  uniq-gate-rec = "&2" '
     1476                                      ,p-dsh:get-buffer-handle(v-ii):name
     1477                                      ,p-gate-rec
     1478                                      )) no-error.
     1479         if not p-xmlh:available then do:
     1480           p-xmlh:buffer-create().
     1481           assign
     1482           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):table
     1483           p-xmlh::uniq-gate-rec = p-gate-rec
     1484           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1485           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1486           p-xmlh::gate-handle_ = p-dsh
     1487           p-xmlh::gate-name = p-dsh:name
     1488           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1489           .
     1490           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1491             assign
     1492             p-xmlh::order = -3.
     1493           end.
     1494           p-xmlh:buffer-release().
     1495         end.
     1496       end.
     1497   end.
     1498   end procedure.
     1499   procedure gate-clear :
     1500   define input  parameter p-dsh as handle no-undo .
     1501   define input  parameter p-xmlh as handle no-undo .
     1502   define variable v-dsh as handle no-undo .
     1503   define variable v-th as handle no-undo .
     1504     do
     1505     on error undo, return error return-value
     1506     :
     1507       if valid-handle(p-dsh) then do:
     1508         delete object p-dsh.
     1509         v-dsh = p-dsh.
     1510         p-dsh = ?.
     1511       end.
     1512       repeat while true:
     1513         p-xmlh:find-first( substitute( " where gate-handle_ = &1 ", v-dsh)
     1514                            , share-lock) no-error.
     1515         if p-xmlh:available then do:
     1516           assign
     1517           v-th = p-xmlh:buffer-field("table-handle_"):buffer-value.
     1518           if valid-handle(p-xmlh:buffer-field("table-handle_"))
     1519           and valid-handle(v-th)
     1520           and v-th:dynamic = yes
     1521           then do:
     1522             delete object p-xmlh:buffer-field("table-handle_"):buffer-value.
     1523             p-xmlh:buffer-field("table-handle_"):buffer-value = ?.
     1524           end.
     1525           p-xmlh:buffer-delete().
     1526         end.
     1527         else do:
     1528           leave.
     1529         end.
     1530       end.
     1531       if p-xmlh:dynamic = yes
     1532       and valid-handle(p-xmlh)
     1533       then do:
     1534         delete object p-xmlh:table-handle.
     1535         p-xmlh = ?.
     1536       end.
     1537       v-dsh = ?.
     1538     end.
     1539   end procedure.
     1540   procedure all-gates-clear :
     1541   define parameter buffer buf_temp-xml-tables for temp-xml-tables.
     1542   do
     1543   on error undo, return error
     1544   :
     1545     for each buf_temp-xml-tables
     1546     break
     1547     by buf_temp-xml-tables.uniq-gate-rec
     1548     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1549     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1550     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1551     :
     1552         if first-of(buf_temp-xml-tables.uniq-gate-rec) then do:
     1553           delete object buf_temp-xml-tables.gate-handle_.
     1554           buf_temp-xml-tables.gate-handle_ = ?.
     1555         end.
     1556         if valid-handle(buf_temp-xml-tables.table-handle_)
     1557         and buf_temp-xml-tables.table-handle_:dynamic = no
     1558         then do:
     1559           delete object buf_temp-xml-tables.table-handle_.
     1560           buf_temp-xml-tables.table-handle_ = ?.
     1561         end.
     1562         delete buf_temp-xml-tables.
     1563     end.
     1564   end.
     1565   end procedure.
     1566   procedure fix-schemalocation :
     1567   define input-output  parameter p-longchar as longchar no-undo .
     1568   DEFINE VARIABLE hdoc AS HANDLE.
     1569   DEFINE VARIABLE hroot AS HANDLE.
     1570   DEFINE VARIABLE hnode-child AS HANDLE.
     1571   DEFINE VARIABLE hnode-attr AS HANDLE.
     1572   define variable v-jj as integer   no-undo .
     1573   define variable ok as logical   no-undo .
     1574   define variable v-path1                    as character                no-undo .
     1575   DEFINE VARIABLE v-full-path1               as character                no-undo .
     1576   DEFINE VARIABLE v-file-name1               as character                no-undo .
     1577   DEFINE VARIABLE v-file-name-no-ext1        as character                no-undo .
     1578   DEFINE VARIABLE v-file-name-ext1           as character                no-undo .
     1579   define variable v-schema-location          as character                no-undo .
     1580   do
     1581   on error undo, return error return-value
     1582   :
     1583     CREATE X-DOCUMENT hdoc.
     1584     CREATE X-noderef hroot.
     1585     CREATE X-noderef hnode-child.
     1586     CREATE X-noderef hnode-attr.
     1587     hdoc:load("longchar", p-longchar, no) no-error.
     1588     iF ERROR-STATUS:GET-MESSAGE(1) <> '' THEN message ERROR-STATUS:GET-MESSAGE(1) view-as alert-box .
     1589     hdoc:get-document-element(hroot).
     1590     _repeat:
     1591     REPEAT v-jj = 1 TO hroot:NUM-CHILDREN:
     1592       ok = hroot:GET-CHILD(hNode-Child, v-jj).
     1593       if not ok then next.
     1594       if hNode-Child:local-name = "include"
     1595       then do:
     1596         ok = hNode-Child:GET-ATTRIBUTE-NODE( hnode-attr, "schemaLocation" ).
     1597           v-schema-location = hnode-attr:node-value.
     1598           run gbl/filename.p (
     1599                           input "exe/" + hnode-attr:node-value
     1600                         ,output v-full-path1
     1601                         ,output v-path1
     1602                         ,output v-file-name1
     1603                         ,output v-file-name-no-ext1
     1604                         ,output v-file-name-ext1
     1605                         ) no-error .
     1606           if error-status :error then do:
     1607             delete object hnode-attr.
     1608             delete object hnode-child.
     1609             delete object hroot.
     1610             delete object hdoc.
     1611             undo, return error substitute("Не удалось определить расположение схемы &1", v-schema-location).
     1612           end.
     1613         ok = hNode-Child:sET-ATTRIBUTE(  "schemaLocation", v-full-path1 ).
     1614         leave  _repeat.
     1615       end.
     1616     END.
     1617     hdoc:save("longchar", p-longchar).
     1618     delete object hnode-attr.
     1619     delete object hnode-child.
     1620     delete object hroot.
     1621     delete object hdoc.
     1622   end.
     1623   end procedure.
     1624   procedure gate-clb_fill-xml-tables :
     1625   define input parameter p-dsh as handle no-undo .
     1626   define input-output parameter p-xmlh as handle no-undo .
     1627   define variable v-ii as integer no-undo .
     1628     do
     1629     on error undo, return error
     1630     :
     1631       do v-ii = 1 to p-dsh:num-buffers:
     1632         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1633         if not p-xmlh:available then do:
     1634           p-xmlh:buffer-create().
     1635           assign
     1636           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1637           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1638           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1639           p-xmlh::gate-handle_ = p-dsh
     1640           p-xmlh::uniq-gate-rec = entry(2, p-dsh:private-data, chr(4))
     1641           p-xmlh::gate-name = p-dsh:name
     1642           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1643           .
     1644           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1645             assign
     1646             p-xmlh::order = -3.
     1647           end.
     1648           p-xmlh:buffer-release().
     1649         end.
     1650       end.
     1651     end.
     1652   end procedure.
     1653   procedure all-gates-empty :
     1654   define buffer buf_temp-xml-tables for temp-xml-tables.
     1655   do
     1656   on error undo, return error
     1657   :
     1658     for each buf_temp-xml-tables
     1659     break
     1660     by buf_temp-xml-tables.uniq-gate-rec
     1661     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1662     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1663     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1664     :
     1665       if valid-handle(buf_temp-xml-tables.tbl-handle_) then do:
     1666         buf_temp-xml-tables.tbl-handle_:empty-temp-table().
     1667       end.
     1668     end.
     1669   end.
     1670   end procedure.
     1671   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1672   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1673   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1674   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1675   procedure ordlineattr-value :
     1676     do
     1677     on error undo, return error return-value
     1678     :
     1679       define input  parameter p-doc-code like ub.ord-line-attr.doc-code   no-undo .
     1680       define input  parameter p-gds-code like ub.ord-line-attr.gds-code   no-undo .
     1681       define input  parameter p-code     like ub.ord-line-attr.attr-code  no-undo .
     1682       define output parameter p-value    like ub.ord-line-attr.attr-value no-undo .
     1683       define output parameter p-type     as character no-undo .
     1684       define buffer buf_ord-line-attr for ub.ord-line-attr .
     1685       define variable v-format         as character no-undo .
     1686       define variable v-fillin_width   as integer   no-undo .
     1687       define variable v-fillin_height  as integer   no-undo .
     1688       define variable v-label          as character no-undo .
     1689       define variable v-user-can-edit  as logical   no-undo .
     1690       define variable v-output-display as logical   no-undo .
     1691       define variable v-other          as character no-undo .
     1692       define variable v-proc           as character no-undo .
     1693       define variable v-func           as character no-undo .
     1694       define variable v-sort           as integer   no-undo .
     1695       run ordlineattr-code in this-procedure
     1696         (input  p-code
     1697         ,output p-type
     1698         ,output v-format
     1699         ,output v-fillin_width
     1700         ,output v-fillin_height
     1701         ,output v-label
     1702         ,output v-user-can-edit
     1703         ,output v-output-display
     1704         ,output v-proc
     1705         ,output v-func
     1706         ,output v-sort
     1707         ,output v-other
     1708         ) no-error .
     1709       if error-status :error then do:
     1710         undo, return error return-value .
     1711       end.
     1712       find first buf_ord-line-attr no-lock
     1713         where buf_ord-line-attr.doc-code  = p-doc-code
     1714           and buf_ord-line-attr.gds-code  = p-gds-code
     1715           and buf_ord-line-attr.attr-code = p-code
     1716         no-error .
     1717       if avail buf_ord-line-attr then do:
     1718         assign
     1719           p-value =  buf_ord-line-attr.attr-value
     1720         .
     1721       end.
     1722       else do:
     1723         assign
     1724           p-value = if p-type = 'L':U then "no":U else ""
     1725         .
     1726       end.
     1727     end.
     1728   end procedure.
     1729   procedure ordlineattr-write :
     1730     do
     1731     on error undo, return error return-value
     1732     :
     1733       define input parameter p-doc-code like ub.ord-line-attr.doc-code   no-undo .
     1734       define input parameter p-gds-code like ub.ord-line-attr.gds-code   no-undo .
     1735       define input parameter p-code     like ub.ord-line-attr.attr-code  no-undo .
     1736       define input parameter p-value    like ub.ord-line-attr.attr-value no-undo .
     1737       define buffer buf_ord-line-attr for ub.ord-line-attr .
     1738       define variable v-type           as character no-undo .
     1739       define variable v-format         as character no-undo .
     1740       define variable v-fillin_width   as integer   no-undo .
     1741       define variable v-fillin_height  as integer   no-undo .
     1742       define variable v-label          as character no-undo .
     1743       define variable v-user-can-edit  as logical   no-undo .
     1744       define variable v-output-display as logical   no-undo .
     1745       define variable v-other          as character no-undo .
     1746       define variable v-proc           as character no-undo .
     1747       define variable v-func           as character no-undo .
     1748       define variable v-sort           as integer   no-undo .
     1749       run ordlineattr-code in this-procedure
     1750         (input  p-code
     1751         ,output v-type
     1752         ,output v-format
     1753         ,output v-fillin_width
     1754         ,output v-fillin_height
     1755         ,output v-label
     1756         ,output v-user-can-edit
     1757         ,output v-output-display
     1758         ,output v-proc
     1759         ,output v-func
     1760         ,output v-sort
     1761         ,output v-other
     1762         ) no-error .
     1763       if error-status :error then do:
     1764         message
     1765           vss-workfile vss-revision vss-description skip
     1766           error-status :get-message(1) skip
     1767           return-value skip
     1768           ""
     1769           view-as alert-box error
     1770         .
     1771         undo, return error return-value .
     1772       end.
     1773       find first buf_ord-line-attr exclusive-lock
     1774         where buf_ord-line-attr.doc-code  = p-doc-code
     1775           and buf_ord-line-attr.gds-code  = p-gds-code
     1776           and buf_ord-line-attr.attr-code = p-code
     1777         no-error .
     1778       if not available buf_ord-line-attr then do:
     1779         create buf_ord-line-attr .
     1780         assign
     1781           buf_ord-line-attr.doc-code   = p-doc-code
     1782           buf_ord-line-attr.gds-code   = p-gds-code
     1783           buf_ord-line-attr.attr-code  = p-code
     1784         .
     1785       end.
     1786       assign
     1787         buf_ord-line-attr.attr-value = p-value
     1788       .
     1789   end.
     1790   end procedure.
     1791   procedure ordlineattr-exist :
     1792     do
     1793     on error undo, return error return-value
     1794     :
     1795       define input parameter p-doc-code like ub.ord-line-attr.doc-code   no-undo .
     1796       define input parameter p-gds-code like ub.ord-line-attr.gds-code   no-undo .
     1797       define input parameter p-code     like ub.ord-line-attr.attr-code  no-undo .
     1798       define output parameter p-exist   as logical  no-undo .
     1799       define buffer buf_ord-line-attr for ub.ord-line-attr .
     1800       define variable v-type           as character no-undo .
     1801       define variable v-format         as character no-undo .
     1802       define variable v-fillin_width   as integer   no-undo .
     1803       define variable v-fillin_height  as integer   no-undo .
     1804       define variable v-label          as character no-undo .
     1805       define variable v-user-can-edit  as logical   no-undo .
     1806       define variable v-output-display as logical   no-undo .
     1807       define variable v-other          as character no-undo .
     1808       define variable v-proc           as character no-undo .
     1809       define variable v-func           as character no-undo .
     1810       define variable v-sort           as integer   no-undo .
     1811       run ordlineattr-code in this-procedure
     1812         (input  p-code
     1813         ,output v-type
     1814         ,output v-format
     1815         ,output v-fillin_width
     1816         ,output v-fillin_height
     1817         ,output v-label
     1818         ,output v-user-can-edit
     1819         ,output v-output-display
     1820         ,output v-proc
     1821         ,output v-func
     1822         ,output v-sort
     1823         ,output v-other
     1824         ) no-error .
     1825       if error-status :error then do:
     1826         undo, return error return-value .
     1827       end.
     1828       find first buf_ord-line-attr no-lock
     1829         where buf_ord-line-attr.doc-code  = p-doc-code
     1830           and buf_ord-line-attr.gds-code = p-gds-code
     1831           and buf_ord-line-attr.attr-code = p-code
     1832         no-error .
     1833       if  available buf_ord-line-attr then do:
     1834         p-exist = yes.
     1835       end.
     1836     end.
     1837   end procedure.
     1838   procedure ordlineattr-delete :
     1839     do
     1840     on error undo, return error return-value
     1841     :
     1842       define input parameter p-doc-code like ub.ord-line-attr.doc-code   no-undo .
     1843       define input parameter p-gds-code like ub.ord-line-attr.gds-code   no-undo .
     1844       define input parameter p-code     like ub.ord-line-attr.attr-code  no-undo .
     1845       define output parameter p-deleted  as logical no-undo.
     1846       define buffer buf_ord-line-attr for ub.ord-line-attr .
     1847       define variable v-type           as character no-undo .
     1848       define variable v-format         as character no-undo .
     1849       define variable v-fillin_width   as integer   no-undo .
     1850       define variable v-fillin_height  as integer   no-undo .
     1851       define variable v-label          as character no-undo .
     1852       define variable v-user-can-edit  as logical   no-undo .
     1853       define variable v-output-display as logical   no-undo .
     1854       define variable v-proc           as character no-undo .
     1855       define variable v-func           as character no-undo .
     1856       define variable v-sort           as integer   no-undo .
     1857       define variable v-other          as character no-undo .
     1858       run ordlineattr-code in this-procedure
     1859         (input  p-code
     1860         ,output v-type
     1861         ,output v-format
     1862         ,output v-fillin_width
     1863         ,output v-fillin_height
     1864         ,output v-label
     1865         ,output v-user-can-edit
     1866         ,output v-output-display
     1867         ,output v-proc
     1868         ,output v-func
     1869         ,output v-sort
     1870         ,output v-other
     1871         ) no-error .
     1872       if error-status :error then do:
     1873         undo, return error return-value .
     1874       end.
     1875       find first buf_ord-line-attr exclusive-lock
     1876         where buf_ord-line-attr.doc-code  = p-doc-code
     1877           and buf_ord-line-attr.gds-code  = p-gds-code
     1878           and buf_ord-line-attr.attr-code = p-code
     1879         no-error NO-WAIT.
     1880       if not available buf_ord-line-attr then do:
     1881         p-deleted = no.
     1882       end.
     1883       else do:
     1884         delete buf_ord-line-attr.
     1885         p-deleted = yes.
     1886       end.
     1887     end.
     1888   end procedure.
     1889   procedure ordlineattr-code :
     1890     do on error undo, return error return-value
     1891     :
     1892       define input  parameter p-code           as character no-undo .
     1893       define output parameter p-type           as character no-undo .
     1894       define output parameter p-format         as character no-undo .
     1895       define output parameter p-fillin_width   as integer   no-undo .
     1896       define output parameter p-fillin_height  as integer   no-undo .
     1897       define output parameter p-label          as character no-undo .
     1898       define output parameter p-user-can-edit  as logical   no-undo .
     1899       define output parameter p-output-display as logical   no-undo .
     1900       define output parameter p-proc           as character no-undo .
     1901       define output parameter p-func           as character no-undo .
     1902       define output parameter p-sort           as integer   no-undo .
     1903       define output parameter p-other          as character no-undo .
     1904       case p-code :
     1905               when 'cycle-cli-qnty':U then do:     assign     p-label          = "Количество"     p-type           = 'D':U      p-format         = ">>>>>>>>>>>>>>>9.999"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "Количество"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
     1906               when 'ord-EAN13':U then do:     assign     p-label          = "EAN в EDI"     p-type           = 'C':U      p-format         = "X(13)"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "EAN в EDI"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
     1907         otherwise do:
     1908           undo, return error "неизвестный атрибут строки заказа" + " " + p-code .
     1909         end.
     1910       end.
     1911     end.
     1912   end procedure.
     1913   FUNCTION cr-edist_get-mess-mean returns character ( input p-mess as character):
     1914   define variable v-ii as integer   no-undo .
     1915   define variable v-dop as character no-undo .
     1916   define variable v-dop1 as character no-undo .
     1917   define variable v-mess as character no-undo .
     1918   do v-ii = 1 to num-entries(p-mess, chr(4) ):
     1919     v-dop = entry(v-ii, p-mess, chr(4) ).
     1920     case entry(1, v-dop, "="):
     1921       when 'pack-num':U then do:
     1922         v-dop1 =  substitute("&1 &2", 'Пакет', entry(2, v-dop, "=")).
     1923       end.
     1924       when 'route':U then do:
     1925         v-dop1 =  substitute("&1 &2", 'Рут':U, entry(2, v-dop, "=")).
     1926       end.
     1927       when 'ediiterchangeid':U then do:
     1928         v-dop1 =  substitute("&1 &2", 'ediiterchangeid':U, entry(2, v-dop, "=")).
     1929       end.
     1930       when 'price-up':U then do:
     1931         v-dop1 =  substitute("&1 &2", 'Цена':U, entry(2, v-dop, "=")).
     1932       end.
     1933       when 'price-down':U then do:
     1934         v-dop1 =  substitute("&1 &2", 'Цена':U, entry(2, v-dop, "=")).
     1935       end.
     1936       when 'vat-change':U then do:
     1937         v-dop1 =  substitute("&1 &2", 'НДС':U, entry(2, v-dop, "=")).
     1938       end.
     1939       when 'ps':U then do:
     1940         v-dop1 =  substitute("&1 &2", ' ':U, entry(2, v-dop, "=")).
     1941       end.
     1942       when 'info':U then do:
     1943         v-dop1 =  substitute("&1 &2", 'Инф:':U, entry(2, v-dop, "=")).
     1944       end.
     1945       when 'qnty-up':U then do:
     1946         v-dop1 =  substitute("&1 &2", 'Кол-во':U, entry(2, v-dop, "=")).
     1947       end.
     1948       when 'qnty-down':U then do:
     1949         v-dop1 =  substitute("&1 &2", 'Кол-во':U, entry(2, v-dop, "=")).
     1950       end.
     1951       when 'bstr-change':U then do:
     1952         v-dop1 =  substitute("&1 &2", 'Штрихкод:':U, entry(2, v-dop, "=")).
     1953       end.
     1954       when 'shipdate-change':U then do:
     1955         v-dop1 =  substitute("&1 &2", 'Дата отгрузки:':U, entry(2, v-dop, "=")).
     1956       end.
     1957       when 'clioutdoc-change':U then do:
     1958         v-dop1 =  substitute("&1 &2", '№ заказа по пост-ку:':U, entry(2, v-dop, "=")).
     1959       end.
     1960     end case.
     1961     v-mess  = v-mess + (if v-mess = '' then '' else chr(32)) + v-dop1.
     1962   end.
     1963   return v-mess.
     1964   end function.
     1965   FUNCTION cr-edist_get-error-mean returns character ( input p-mess as character):
     1966   define variable v-ii as integer   no-undo .
     1967   define variable v-dop as character no-undo .
     1968   define variable v-dop1 as character no-undo .
     1969   define variable v-mess as character no-undo .
     1970   do v-ii = 1 to num-entries(p-mess, chr(4) ):
     1971     v-dop = entry(v-ii, p-mess, chr(4) ).
     1972     case entry(1, v-dop, "="):
     1973       when 'pack-num':U then do:
     1974         v-dop1 =  substitute("&1 &2", 'Пакет', entry(2, v-dop, "=")).
     1975       end.
     1976       when 'route':U then do:
     1977         v-dop1 =  substitute("&1 &2", 'Рут':U, entry(2, v-dop, "=")).
     1978       end.
     1979       when 'ediiterchangeid':U then do:
     1980         v-dop1 =  substitute("&1 &2", 'ediiterchangeid':U, entry(2, v-dop, "=")).
     1981       end.
     1982       when 'price-up':U then do:
     1983         v-dop1 =  substitute("&1 &2", 'Цена':U, entry(2, v-dop, "=")).
     1984       end.
     1985       when 'price-down':U then do:
     1986         v-dop1 =  substitute("&1 &2", 'Цена':U, entry(2, v-dop, "=")).
     1987       end.
     1988       when 'vat-change':U then do:
     1989         v-dop1 =  substitute("&1 &2", 'НДС':U, entry(2, v-dop, "=")).
     1990       end.
     1991       when 'ps':U then do:
     1992         v-dop1 =  substitute("&1 &2", ' ':U, entry(2, v-dop, "=")).
     1993       end.
     1994       when 'info':U then do:
     1995         v-dop1 =  substitute("&1 &2", 'Инф:':U, entry(2, v-dop, "=")).
     1996       end.
     1997       when 'qnty-up':U then do:
     1998         v-dop1 =  substitute("&1 &2", 'Кол-во':U, entry(2, v-dop, "=")).
     1999       end.
     2000       when 'qnty-down':U then do:
     2001         v-dop1 =  substitute("&1 &2", 'Кол-во':U, entry(2, v-dop, "=")).
     2002       end.
     2003       when 'bstr-change':U then do:
     2004         v-dop1 =  substitute("&1 &2", 'Штрихкод:':U, entry(2, v-dop, "=")).
     2005       end.
     2006       when 'shipdate-change':U then do:
     2007         v-dop1 =  substitute("&1 &2", 'Дата отгрузки:':U, entry(2, v-dop, "=")).
     2008       end.
     2009       when 'clioutdoc-change':U then do:
     2010         v-dop1 =  substitute("&1 &2", '№ заказа по пост-ку:':U, entry(2, v-dop, "=")).
     2011       end.
     2012     end case.
     2013     v-mess  = v-mess + (if v-mess = '' then '' else chr(4)) + v-dop1.
     2014   end.
     2015   return v-mess.
     2016   end function.
     2017   FUNCTION cr-edist_get-mess-key-value returns character ( input p-mess as character, input p-key as character):
     2018   define variable v-ii as integer   no-undo .
     2019   define variable v-dop as character no-undo .
     2020   define variable v-dop1 as character no-undo .
     2021   define variable v-value as character no-undo .
     2022   do v-ii = 1 to num-entries(p-mess, chr(4) ):
     2023     v-dop = entry(v-ii, p-mess, chr(4) ).
     2024     if entry(1, v-dop, "=") = p-key then do:
     2025       return entry(2, v-dop, "=").
     2026     end.
     2027   end.
     2028   return v-value.
     2029   end function.
     2030   FUNCTION cr-edist_add-edist-mess returns character ( input p-mess as character
     2031                                                        ,input p-key as character
     2032                                                        ,input p-value as character):
     2033   define variable v-dop as character no-undo .
     2034   define variable v-modificator as character no-undo .
     2035   assign
     2036   v-modificator = entry(2, p-key, "-") no-error .
     2037   case v-modificator:
     2038     when "up" then do:
     2039       v-dop = substitute("&1=&2<&3", p-key, entry(1, p-value, chr(4)) , entry(2, p-value, chr(4))).
     2040     end.
     2041     when "down" then do:
     2042       v-dop = substitute("&1=&2>&3", p-key, entry(1, p-value, chr(4)) , entry(2, p-value, chr(4))).
     2043     end.
     2044     when "change" then do:
     2045       v-dop = substitute("&1=&2 ->&3", p-key, entry(1, p-value, chr(4)) , entry(2, p-value, chr(4))).
     2046     end.
     2047     otherwise do:
     2048       v-dop = substitute("&1=&2", p-key, p-value).
     2049     end.
     2050   end case.
     2051   if p-mess = ''
     2052   or p-mess = ? then do:
     2053     return v-dop .
     2054   end.
     2055   else do:
     2056     return substitute("&1&2&3", p-mess, chr(4), v-dop).
     2057   end.
     2058   end function.
     2059   procedure create-edi-state :
     2060   define input  parameter p-tbl-name   as character no-undo .
     2061   define input  parameter p-doc-code   as character no-undo .
     2062   define input  parameter p-cli-type   as character no-undo .
     2063   define input  parameter p-cli-code   as integer   no-undo .
     2064   define input  parameter p-act        as character no-undo .
     2065   define input  parameter p-state      as character no-undo .
     2066   define input  parameter p-err        as integer   no-undo .
     2067   define input  parameter p-des        as character no-undo .
     2068   define input  parameter p-mess       as character no-undo .
     2069   define input  parameter p-dm         as integer  no-undo .
     2070   define input-output parameter p-date       as date no-undo .
     2071   define input-output parameter p-time       as integer no-undo .
     2072   define buffer buf_EDI-status for ub.EDI-status  .
     2073   define variable v-time as integer   no-undo .
     2074   define variable v-date as date   no-undo .
     2075   do
     2076   on error undo, return error return-value
     2077   :
     2078     if p-date = ? then do:
     2079       run cur-time in this-procedure ( output v-date, output v-time).
     2080     end.
     2081     else do:
     2082       assign
     2083       v-date = p-date
     2084       v-time = p-time
     2085       .
     2086     end.
     2087     find first buf_edi-status exclusive-lock where
     2088                 buf_edi-status.date-status = v-date
     2089             and buf_edi-status.time-status = v-time
     2090             and buf_edi-status.tbl-name    = p-tbl-name
     2091             and buf_edi-status.doc-code    = p-doc-code no-error .
     2092     if not available buf_edi-status  then do:
     2093       create buf_edi-status.
     2094     end.
     2095     assign
     2096     buf_edi-status.act         = p-act        .
     2097     buf_edi-status.cli-type    = p-cli-type   .
     2098     buf_edi-status.cli-code    = p-cli-code   .
     2099     buf_edi-status.des-err     = buf_edi-status.des-err + (if buf_edi-status.des-err = '' then '' else chr(4)) + p-des        .
     2100     buf_edi-status.doc-code    = p-doc-code   .
     2101     buf_edi-status.err-code    = p-err        .
     2102     buf_edi-status.mess-id     = buf_edi-status.mess-id + (if buf_edi-status.mess-id = '' then '' else chr(4)) + p-mess       .
     2103     buf_edi-status.state       = p-state      .
     2104     buf_edi-status.tbl-name    = p-tbl-name   .
     2105     buf_edi-status.date-status = v-date       .
     2106     buf_edi-status.time-status = v-time       .
     2107     buf_edi-status.whole-send-news = p-dm     .
     2108     buf_edi-status.user-name   = (if g#news then (chr(4) +  'СПН':U)
     2109                                       else (if g#esys
     2110                                             then (chr(4) +  'ВС':U)
     2111                                             else g#userid)
     2112                                       )       .
     2113     assign
     2114     p-date = buf_edi-status.date-status
     2115     p-time = buf_edi-status.time-status
     2116     .
     2117   end.
     2118   end procedure.
     2119   procedure update-edi-state-light :
