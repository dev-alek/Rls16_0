     1121   procedure library-cls_get-handle :
     1122   define input parameter p-library-name as character no-undo .
     1123   define output parameter p-library-handle as handle no-undo .
     1124     do
     1125     on error undo, return error
     1126     :
     1127       CASE p-library-name:
     1128         when "library" then do:
     1129           if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end.
     1130           p-library-handle = g#library.
     1131         end.
     1132         when "library2" then do:
     1133           if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end.
     1134           p-library-handle = g#library2.
     1135         end.
     1136       end case.
     1137     end.
     1138   end procedure.
     1139   def var vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1140   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1141   define variable tempcxml_v-num_ as integer no-undo .
