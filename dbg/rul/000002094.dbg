     4384       end.
     4385       else do:
     4386         if v-new-st = ? then do:
     4387           define variable v-tmp-file as character no-undo .
     4388           run gbl/_tmpfile.p ( input "mes":U  , input ".txt":U, output v-tmp-file ).
     4389           COPY-LOB  FROM OBJECT cr-edist_full-mess
     4390           TO FILE v-tmp-file NO-ERROR.
     4391           cr-edist_full-mess = ''.
     4392           run send-msg-to-email in parparentproc
     4393               ( input substitute( "ТН БД &1. Ошибка EDI при импорте пакета &2 из ВС &3"
     4394                                   , g#db-num
     4395                                   , v-pack-num-chr
     4396                                   , v-esys-id )
     4397               ,input substitute("Пакет принят без сохранения данных в БД. См. EDI-информацию по заказу &1&2"
     4398                                 , buf_ord-doc.doc-code
     4399                                 , chr(10)
     4400                                 )
     4401               ,input v-tmp-file
     4402               ) no-error .
     4403           os-delete value(v-tmp-file).
     4404         end.
     4405         v-edist-mess = ''.
     4406         v-edist-mess = cr-edist_add-edist-mess( v-edist-mess, 'pack-num':U, "->" + v-pack-num-chr ).
     4407         v-edist-mess = cr-edist_add-edist-mess( v-edist-mess, 'ediiterchangeid':U, ordrsp.id ).
     4408         v-date-status = ?.
     4409         run create-edi-state in this-procedure (
     4410                                                 input 'ord-doc':U
     4411                                               , input buf_ord-doc.doc-code
     4412                                               , input buf_ord-doc.cli-type
     4413                                               , input buf_ord-doc.cli-code
     4414                                               , input 'ИЗМЕНЕНИЕ':U
     4415                                               , input (if v-new-st = ? then -1 else buf_ord-doc.ord-int1)
     4416                                               , input (if v-new-st = ?
     4417                                                       then  integer('4':U)
     4418                                                       else integer('0':U))
     4419                                               , input buf_ord-doc.PS
     4420                                               , input v-edist-mess
     4421                                               , input integer('2':U)
     4422                                               , input-output v-date-status
     4423                                               , input-output v-time-status
     4424                                               ).
     4425         _edist:
     4426         for each temp-edi-status
     4427         on error  undo _edist, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4428         on stop   undo _edist, return error substitute( "&1. stop", vss-workfile )
     4429         on endkey undo _edist, return error substitute( "&1. endkey", vss-workfile )
     4430         :
     4431           v-edist-mess = temp-edi-status.mess.
     4432           v-edist-mess = cr-edist_add-edist-mess( v-edist-mess, 'pack-num':U, "->" + v-pack-num-chr ).
     4433           run create-edi-state in this-procedure (
     4434                                                   input temp-edi-status.tbl-name
     4435                                                 , input temp-edi-status.doc-code
     4436                                                 , input temp-edi-status.cli-type
     4437                                                 , input temp-edi-status.cli-code
     4438                                                 , input temp-edi-status.act
     4439                                                 , input (if v-new-st = ? then -1 else buf_ord-doc.ord-int1)
     4440                                                 , input temp-edi-status.err-code
     4441                                                 , input temp-edi-status.des-err
     4442                                                 , input v-edist-mess
     4443                                                 , input integer('2':U)
     4444                                                 , input-output v-date-status
     4445                                                 , input-output v-time-status
     4446                                                 ).
     4447         end.
     4448         if v-new-st <> ? then do:
     4449           run cur-time in this-procedure ( output v-today, output v-time).
     4450           run get-xcnf_create-temp-esys-pck-sent in p-cont-handle (
     4451                                                                     input v-esys-id
     4452                                                                   ,input integer(v-pack-num-chr)
     4453                                                                   ,input v-crc-pack
     4454                                                                   ,input yes
     4455                                                                   ,input 1
     4456                                                                   ,input 1
     4457                                                                   ,input v-today
     4458                                                                   ,input v-time
     4459                                                                   ,input string(v-time, "HH:MM:SS")
     4460                                                                   ) .
     4461           num-rec-ok = num-rec-ok + 1.
     4462         end.
     4463       end.
     4464     end.
     4465     run write-counter in p-log-handle ( input substitute("Прочитано записей: &1, из них удачно: &2", num-rec, num-rec-ok)).
     4466   end.
     4467   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Прочитано записей: &1, из них удачно обработано: &2", num-rec, num-rec-ok)).                      assign v-view-log = yes.
     4468   end procedure.
     4469   PROCEDURE GetChildren:
     4470   DEFINE INPUT PARAMETER hParent AS HANDLE NO-UNDO.
     4471   DEFINE INPUT PARAMETER level AS INTEGER NO-UNDO.
     4472   DEFINE VARIABLE i AS INTEGER NO-UNDO.
     4473   DEFINE VARIABLE hNoderef AS HANDLE NO-UNDO.
     4474   DEFINE VARIABLE hText AS HANDLE NO-UNDO.
     4475   define variable client as character no-undo.
     4476   CREATE X-NODEREF hNoderef.
     4477   CREATE X-NODEREF hText .
     4478   if hParent:name = "eDIMessage" then
     4479   assign
     4480       ordrsp.id = hParent:get-attribute("id")
     4481       ordrsp.creationDateTime = hParent:get-attribute("creationDateTime")
     4482   .
     4483   REPEAT i = 1 TO hParent:NUM-CHILDREN:
     4484       good = hParent:GET-CHILD(hNoderef,i).
     4485       IF NOT good THEN
     4486           LEAVE.
     4487       IF hNoderef:SUBTYPE <> "element" THEN
     4488           NEXT.
     4489       hNoderef:GET-CHILD(hText, 1) no-error.
     4490       IF hNoderef:NAME = "sender" THEN
     4491           assign ordrsp.sender = hText:node-value .
     4492       IF hNoderef:NAME = "recipient" THEN
     4493           assign ordrsp.recipient = hText:node-value .
     4494       IF hNoderef:NAME = "orderResponse" THEN
     4495           assign
     4496               ordrsp.ordrspNumber = hNoderef:get-attribute("number")
     4497               ordrsp.ordrspDate = hNoderef:get-attribute("date")
     4498               ordrsp.status_ = hNoderef:get-attribute("status")
     4499           .
     4500       IF hNoderef:NAME = "originOrder" THEN
     4501           assign
     4502               ordrsp.orderNumber = hNoderef:get-attribute("number")
     4503               ordrsp.orderDate = hNoderef:get-attribute("date")
     4504           .
     4505       IF hNoderef:NAME = "documentType" THEN
     4506           assign ordrsp.documentType = hText:node-value .
     4507       IF hNoderef:NAME = "seller" THEN
     4508           assign client = "seller".
     4509       IF hNoderef:NAME = "buyer" THEN
     4510           assign client = "buyer".
     4511       IF hNoderef:NAME = "shipFrom" THEN
     4512           assign client = "shipFrom".
     4513       IF hNoderef:NAME = "shipTo" THEN
     4514           assign client = "shipTo".
     4515       IF hNoderef:NAME = "gln" THEN do :
     4516           case client :
     4517               when "seller" then assign ordrsp.seller_gln = hText:node-value .
     4518               when "buyer" then assign ordrsp.buyer_gln = hText:node-value .
     4519               when "shipFrom" then assign ordrsp.shipFrom_gln = hText:node-value .
     4520               when "shipTo" then assign ordrsp.shipTo_gln = hText:node-value .
     4521           end case.
     4522       end.
     4523       IF hNoderef:NAME = "estimatedDeliveryDateTime" THEN
     4524           assign ordrsp.estimatedDeliveryDateTime = hText:node-value .
     4525       IF hNoderef:NAME = "currencyISOCode" THEN
     4526           assign ordrsp.currencyISOCode = hText:node-value .
     4527       IF hNoderef:NAME = "lineItem" THEN do :
     4528           create lineItem .
     4529           assign
     4530               lineItem.status_ = hNoderef:get-attribute("status")
     4531               lineItem.NUMBER  = ordrsp.ordrspNumber
     4532           .
     4533       end.
     4534       IF hNoderef:NAME = "gtin" THEN
     4535           assign lineItem.gtin = hText:node-value .
     4536       IF hNoderef:NAME = "description" THEN
     4537           assign lineItem.description = hText:node-value .
     4538       IF hNoderef:NAME = "internalBuyerCode" THEN
     4539           assign lineItem.internalBuyerCode = hText:node-value .
     4540       IF hNoderef:NAME = "internalSupplierCode" THEN
     4541           assign lineItem.internalSupplierCode = hText:node-value .
     4542       IF hNoderef:NAME = "orderedQuantity" THEN
     4543           assign lineItem.orderedQuantity = decimal(hText:node-value) .
     4544       IF hNoderef:NAME = "confirmedQuantity" THEN
     4545           assign
     4546               lineItem.confirmedQuantity = decimal(hText:node-value)
     4547               lineItem.unitOfMeasure = hNoderef:get-attribute("unitOfMeasure")
     4548           .
     4549       IF hNoderef:NAME = "netPrice" THEN
     4550           assign lineItem.netPrice = decimal(hText:node-value) .
     4551       IF hNoderef:NAME = "netAmount" THEN
     4552           assign lineItem.netAmount = decimal(hText:node-value) .
     4553       IF hNoderef:NAME = "vATAmount" THEN
     4554           assign lineItem.vATAmount = decimal(hText:node-value) .
     4555       IF hNoderef:NAME = "netPriceWithVAT" THEN
     4556           assign lineItem.netPriceWithVAT = decimal(hText:node-value) .
     4557       IF hNoderef:NAME = "amount" THEN
     4558           assign lineItem.amount = decimal(hText:node-value) .
     4559       IF hNoderef:NAME = "vATRate" THEN
     4560           assign lineItem.vATRate = decimal(hText:node-value) .
     4561       RUN GetChildren(hNoderef, (level + 1)).
     4562   END.
     4563   DELETE OBJECT hNoderef.
     4564   DELETE OBJECT hText.
     4565   END PROCEDURE.
     4566   procedure load-ruleset-context :
     4567   define input parameter p-ruleset-id as integer no-undo .
     4568   define variable glog as logical no-undo .
     4569   define variable v-mess as character no-undo .
     4570   define buffer buf_rule-call-param for ub.rule-call-param.
     4571   define buffer buf_esys-pck-keys for ub.esys-pck-keys.
     4572   define buffer buf_ext-system for ub.ext-system.
     4573     do
     4574     on error undo, return error
     4575     :
     4576    find first buf_rule-call-param no-lock where
     4577   buf_rule-call-param.codex_id = p-codex-id
     4578   and buf_rule-call-param.ruleset_id = p-ruleset-id
     4579   and buf_rule-call-param.call_id = p-call-id
     4580   and buf_rule-call-param.order_id = p-order-id
     4581   and buf_rule-call-param.rule_id = p-rule-id
     4582   and buf_rule-call-param.param-name = "p-xsd-file"
     4583    no-error.
     4584   if available buf_rule-call-param then do:
     4585   assign p-xsd-file = buf_rule-call-param.param-value-character.
     4586   end.
     4587       case p-ruleset-id:
     4588         when 4 then do:
     4589           assign
     4590           v-sign = 1
     4591           v-current-host-code = p-host-code
     4592           v-current-obj-type = p-obj-type
     4593           v-current-obj-code = p-obj-code
     4594           v-current-doc-code = p-doc-code
     4595           v-current-db-num = g#db-num
     4596           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     4597           file-name  = entry(1, p-process-file-name, chr(4))
     4598           v_dataseth = handle(entry(2, p-process-file-name, chr(4)))
     4599           v-xmlh = buffer buf_temp-xml-tables:handle
     4600           v-esys-id = integer(p-doc-code)
     4601           v-pack-num-chr = entry(3, p-process-file-name, chr(4))
     4602           no-error
     4603          .
     4604           find first buf_ext-system no-lock where
     4605                     buf_ext-system.esys-id = v-esys-id
     4606                 and buf_ext-system.db-num = 0 no-error .
     4607           if not available buf_ext-system
     4608           or buf_ext-system.esys-type <> integer('9':U)
     4609           then do:
     4610                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не найдена ВС &1&2пропускаем ..."                                         , v-esys-id                                         , chr(10)                                         )).                      assign v-view-log = yes.
     4611             undo, return error substitute("Не найдена ВС &1&2пропускаем ..."                                         , v-esys-id                                         , chr(10)                                         ).
     4612           end.
     4613           empty temp-table ordrsp .
     4614           empty temp-table lineItem .
     4615           CREATE X-DOCUMENT hDoc.
     4616           CREATE X-NODEREF hRoot.
     4617           hDoc:LOAD("file",file-name,FALSE).
     4618           hDoc:GET-DOCUMENT-ELEMENT(hRoot).
     4619           create ordrsp .
     4620           RUN GetChildren(hRoot, 1).
     4621           DELETE OBJECT hDoc.
     4622           DELETE OBJECT hRoot.
     4623           find first ub.ord-doc no-lock where ub.ord-doc.doc-code = ordrsp.orderNumber no-error.
     4624           if not available ub.ord-doc then do:
     4625             v-mess =  substitute("Не найден заказ поставщику с номером &1", ordrsp.ordernumber).
     4626             run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при импорте поставок по  заказу &1 из ВС &2&3&4"                                 ,ordrsp.ordernumber                                 , v-esys-id                                  , chr(10)                                 , v-mess)).                      assign v-view-log = yes.
     4627           end.
     4628           if available ub.ord-doc then
     4629           assign
     4630           v-current-doc-code = ub.ord-doc.doc-code
     4631           v-current-obj-type = ub.ord-doc.obj-type
     4632           v-current-obj-code = ub.ord-doc.obj-code
     4633           v-cli-out-doc = ordrsp.ordrspNumber + chr(4) + ordrsp.ordrspDate
     4634           .
     4635           run send-stat_contour ( input "ORDRSP"
     4636                                  ,input "Ok"
     4637                                  ,input "Read"
     4638                                  ,input "сообщение доставлено"
     4639                                  ,input ordrsp.id) .
     4640         end.
     4641         otherwise do:
     4642           undo, return error "Неправильный вызов".
     4643         end.
     4644       end case.
     4645     end.
     4646   end procedure.
     4647   procedure delete-procedure :
     4648     do
     4649     on error undo, return error
     4650     :
     4651         run garbcoll_clear in this-procedure .
     4652     end.
     4653   end procedure.
     4654   procedure delete-ord-list :
     4655   define input parameter p-cli-out-doc as character no-undo .
     4656   define buffer buf_ord-list for ord-list.
     4657   for each lineItem where
     4658           lineItem.number = p-cli-out-doc:
     4659     delete lineItem.
     4660   end.
     4661   find first buf_ord-list where
     4662             buf_ord-list.doc-code = p-doc-code
     4663         and buf_ord-list.trn-doc = ''
     4664            no-error .
     4665   if available buf_ord-list then delete buf_ord-list.
     4666   end procedure.
