     4166               sw:write-data-element ("documentNumber", v-documentNumber) .
     4167               sw:write-data-element ("documentDate", v-documentDate) no-error .
     4168               sw:start-element ("statusItem") .
     4169                   sw:write-data-element ("dateTime", substring(iso-date(NOW), 1, 23) + "Z") .
     4170                   sw:write-data-element ("stage", p-stage) .
     4171                   sw:write-data-element ("state", p-state) .
     4172                   sw:write-data-element ("description", p-description) .
     4173                   if p-stage = "Checking" and p-state = "Ok" and p-description = "Сообщение отклонено на стороне получателя" then
     4174                   do :
     4175                       sw:write-data-element ("error", "Заказ УЖЕ в статусе Подтвержден или ПодтвержденОК") .
     4176                   end.
     4177                   else if p-stage = "Checking" and p-state = "Fail" and p-doc-type = "DESADV" and p-description = "Сообщение отклонено на стороне получателя в УБД" then
     4178                   do :
     4179                       sw:write-data-element ("error", "Поставка уже в работе в УБД") .
     4180                   end.
     4181                   else if p-state = "Fail" then
     4182                   do :
     4183                       v-error = replace(v-error, chr(4), " ") .
     4184                       v-error = replace(v-error, ";", "; ") .
     4185                       if trim(v-error) <> "" then
     4186                       do v-ii = 1 to num-entries(v-error, chr(30) ):
     4187                           if trim(entry(v-ii, v-error, chr(30) )) <> "" then
     4188                           sw:write-data-element ("error", trim(entry(v-ii, v-error, chr(30)))) .
     4189                       end.
     4190                   end.
     4191                   else do :
     4192                   end.
     4193               sw:end-element ("statusItem") .
     4194           sw:end-element ("reportItem") .
     4195       sw:end-element ("statusReport") .
     4196       sw:end-document () .
     4197       delete object sw.
