     4299       v-cli-type = buf_ord-doc.cli-type
     4300       v-cli-code = buf_ord-doc.cli-code
     4301       .
     4302       if buf_ord-doc.ord-int1 = integer('3':U)
     4303       or buf_ord-doc.ord-int1 = integer('6':U)
