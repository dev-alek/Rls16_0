     2275         and g#news
     2276         then do:
     2277           FOR EACH vchk-pay where vchk-pay.d-card = temp-d-card.d-card
     2278           On error undo _main, return error
     2279           :
     2280             if NOT vchk-pay.cre-pay then do:
     2281             if p-doc-type = 'import':U then do:
     2282               assign
     2283               p-doc-type = '':U.
     2284             end.
     2285             define variable v-payment-host-code as integer no-undo .
     2286             if p-ruleset-id = 6 then do:
     2287   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2288   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2289     (input  temp-d-card.obj-type
     2290     ,input  temp-d-card.obj-code
     2291     ,output v-payment-host-code
     2292     )  .
     2293             end.
