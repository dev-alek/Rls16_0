     1140   procedure clear-from-rec-ord :
     1141   define input parameter p-rec-ord as integer no-undo .
     1142   define buffer buf_temp-no-route for temp-no-route.
     1143   define buffer buf_temp-smart-link for temp-smart-link.
     1144   do
     1145   on error undo, return error
     1146   :
     1147   for each buf_temp-no-route where
     1148           buf_temp-no-route.rec-ord > p-rec-ord:
     1149     delete buf_temp-no-route.
     1150   end.
     1151   for each buf_temp-smart-link where
     1152           buf_temp-smart-link.rec-ord > p-rec-ord:
     1153      delete buf_temp-smart-link.
     1154   end.
     1155   end.
