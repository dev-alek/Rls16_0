     1078   procedure create-nws-outline :
     1079   define input parameter p-cmd-proc-handle as handle no-undo .
     1080   define input parameter p-cmd-code as integer no-undo .
     1081   define input parameter p-outline-type as character no-undo .
     1082   define input parameter p-charkey_one as character no-undo .
     1083   define input parameter p-charkey_two as character no-undo .
     1084   define input parameter p-charkey_three as character no-undo .
     1085   define input parameter p-key#_one as integer no-undo .
     1086   define input parameter p-key#_two as integer no-undo .
     1087   define input parameter p-key#_three as integer no-undo .
     1088   define variable v-no-id as integer no-undo .
     1089   define variable v-rec-ord as integer no-undo .
     1090     do
     1091     on error undo, return error return-value
     1092     :
     1093       find last temp-nws-outline use-index pi no-error .
     1094       v-no-id = (if available temp-nws-outline
     1095                  then (temp-nws-outline.no-id  + 1)
     1096                  else 1).
     1097       create temp-nws-outline.
     1098       assign
     1099       temp-nws-outline.charkeY_one = p-charkey_one
     1100       temp-nws-outline.charkeY_two = p-charkey_two
     1101       temp-nws-outline.charkeY_three = p-charkey_three
     1102       temp-nws-outline.key#_one = p-key#_one
     1103       temp-nws-outline.key#_two = p-key#_two
     1104       temp-nws-outline.key#_three = p-key#_three
     1105       temp-nws-outline.no-id = v-no-id
     1106       temp-nws-outline.outline-type = p-outline-type
     1107       .
     1108                                   run add-dump in p-cmd-proc-handle                                                                           (input p-cmd-code                                                                                         ,input 'nws-outline':U                                                                                          ,input '+update'                                                                                         ,input (buffer temp-nws-outline:handle)                                                                                    ,input ''                                                                                         ,output v-rec-ord                                                                                         ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                     delete procedure p-cmd-proc-handle .                                                                        undo , return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'nws-outline':U                                                                                                ,p-cmd-code                                                                                               ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
     1109       run  create-smart-route in this-procedure (
     1110                                                   input ('nws-outline':U + chr(4) + string(temp-nws-outline.no-id))
     1111                                                  ,input -1).
     1112       run create-smart-route-link in this-procedure (
     1113                                                      input 'nws-outline':U
     1114                                                     ,input (buffer temp-nws-outline:handle)
     1115                                                     ,input ('nws-outline':U + chr(4) + string(temp-nws-outline.no-id))
     1116                                                     ,input v-rec-ord
     1117                                                     ,input no
     1118                                                     ).
     1119     end.
     1120   end procedure.
     1121   procedure create-no-route :
