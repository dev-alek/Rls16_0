     1747   define temp-table temp-rule-call-param no-undo like ub.rule-call-param.
     1748   define buffer buf_temp-rule-call-param for temp-rule-call-param.
     1749   define buffer buf_temp-cmd for temp-cmd.
     1750   define buffer buf_dis-card-sale_obj for temp-d-card.
     1751   define variable vh_dis-card-sale_obj as handle no-undo .
     1752    define variable p-sum-id as character no-undo.
     1753    define variable p-caller-id as character no-undo.
     1754   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1755   procedure discardh_write-dis-card-rul  :
     1756   define parameter buffer buf_dis-card for ub.dis-card .
     1757   define input parameter p-type as character no-undo .
     1758   define input parameter p-emitent-host-code as integer no-undo .
     1759   define input parameter p-action as integer no-undo .
     1760   define variable v-date as date      no-undo.
     1761   define variable v-time  as integer   no-undo.
     1762   define variable v-rec-ord1 as integer no-undo .
     1763   define variable v-rec-ord2 as integer no-undo .
     1764   define variable v-rec-ord3 as integer no-undo .
     1765   define variable v-rec-hno as integer no-undo .
     1766   define buffer buf_c-dc-hist for ub.c-dc-hist.
     1767   define buffer buf_c-dis-card for ub.c-dis-card.
     1768   define buffer buf_temp-hist-nws-option for temp-hist-nws-option.
     1769   define buffer last_temp-hist-nws-option for temp-hist-nws-option.
     1770   do
     1771   on error undo, return error
     1772   :
     1773     if not available buf_dis-card then do:
     1774       message
     1775         vss-workfile vss-revision vss-description skip
     1776         "Ошибка задания входных параметров" skip
     1777         "Не определена ДК" skip
     1778         view-as alert-box error .
     1779       undo, return error .
     1780     end.
     1781     find first buf_temp-hist-nws-option where
     1782               buf_temp-hist-nws-option.table-name = 'dis-card':U
     1783           and buf_temp-hist-nws-option.db-num = g#db-num
     1784           and buf_temp-hist-nws-option.key#_one = 2
     1785           and buf_temp-hist-nws-option.charkey_one = p-type
     1786           and buf_temp-hist-nws-option.host-code = p-emitent-host-code no-error .
     1787     if not available buf_temp-hist-nws-option then do:
     1788       find first last_temp-hist-nws-option where
     1789                last_temp-hist-nws-option.db-num = g#db-num
     1790             and last_temp-hist-nws-option.hn-id < 0 no-error.
     1791       create buf_temp-hist-nws-option.
     1792       assign
     1793       buf_temp-hist-nws-option.db-num = g#db-num
     1794       buf_temp-hist-nws-option.hn-id = (if available last_temp-hist-nws-option
     1795                                   then - (abs(last_temp-hist-nws-option.hn-id) + 1)
     1796                                   else -1 )
     1797       buf_temp-hist-nws-option.table-name = 'dis-card':U
     1798       buf_temp-hist-nws-option.key#_one = 2
     1799       buf_temp-hist-nws-option.charkey_one = p-type
     1800       buf_temp-hist-nws-option.host-code = p-emitent-host-code
     1801       buf_temp-hist-nws-option.smart-nws = integer('-1':U)
     1802       .
     1803   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1804   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option-record in g#lib-nws
     1805     (input  g#db-num
     1806     ,input  buffer buf_temp-hist-nws-option:handle
     1807     )  .
     1808     end.
     1809     if not g#news
     1810     and buf_temp-hist-nws-option.hist-from-prim < 0 then do:
     1811       return.
     1812     end.
     1813     if g#news
     1814     and buf_temp-hist-nws-option.nws-to-hist < 0 then do:
     1815       return.
     1816     end.
     1817     run cur-time in this-procedure(output v-date, output v-time).
     1818     create buf_c-dis-card.
     1819     buffer-copy buf_dis-card to buf_c-dis-card
     1820     assign
     1821     buf_c-dis-card.d-card             = buf_dis-card.d-card
     1822     buf_c-dis-card.card-num           = buf_dis-card.card-num
     1823     buf_c-dis-card.chip-num           = next-value (s-dc-chip, ub)
     1824     buf_c-dis-card.corr-time          = v-time
     1825     buf_c-dis-card.corr-user-db-num   = g#db-num
     1826     buf_c-dis-card.corr-user-name     = (if g#news
     1827                                           then (chr(4) +  'СПН':U)
     1828                                           else (if g#esys
     1829                                                 then (chr(4) +  'ВС':U)
     1830                                                 else g#userid
     1831                                               )
     1832                                           )
     1833     buf_c-dis-card.corr-date          = v-date
     1834     .
     1835     create buf_c-dc-hist.
     1836     buffer-copy buf_c-dis-card to buf_c-dc-hist
     1837     assign
     1838     buf_c-dc-hist.action =  p-action
     1839     buf_c-dc-hist.subject = 'dis-card':U
     1840     buf_c-dc-hist.host-code =  buf_dis-card.emitent-host-code
     1841     buf_c-dc-hist.is-news = g#news
     1842     buf_c-dc-hist.source-type = p-doc-type
     1843     buf_c-dc-hist.source-ref = (if p-doc-type = '':U
     1844                                  then '':U
     1845                                  else p-doc-code)
     1846     .
     1847     if g#db-num > 0
     1848     or (g#db-num = 0
     1849         and buf_temp-hist-nws-option.hist-to-nws >= 0)
     1850     then do:
     1851       run add-dump in p-cmd-proc-handle                                                                           (input p-cmd-code                                                                                         ,input 'c-dis-card':U                                                                                          ,input '+update'                                                                                         ,input buffer buf_c-dis-card:handle                                                                                    ,input ''                                                                                         ,output v-rec-ord2                                                                                         ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                     delete procedure p-cmd-proc-handle .                                                                        undo , return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'c-dis-card':U                                                                                                ,p-cmd-code                                                                                               ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
     1852       run add-dump in p-cmd-proc-handle                                                                           (input p-cmd-code                                                                                         ,input 'c-dc-hist':U                                                                                          ,input '+update'                                                                                         ,input buffer buf_c-dc-hist:handle                                                                                    ,input ''                                                                                         ,output v-rec-ord3                                                                                         ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                     delete procedure p-cmd-proc-handle .                                                                        undo , return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'c-dc-hist':U                                                                                                ,p-cmd-code                                                                                               ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
     1853       if g#db-num = 0 then do:
     1854         run create-smart-route-link in this-procedure ( input 'c-dis-card':U
     1855                                                       ,input buffer buf_c-dis-card:handle
     1856                                                       ,input buf_dis-card.d-card
     1857                                                       ,input v-rec-ord2
     1858                                                       ,input no
     1859                                                       ).
     1860         run create-smart-route-link in this-procedure ( input 'c-dc-hist':U
     1861                                                       ,input buffer buf_c-dc-hist:handle
     1862                                                       ,input buf_dis-card.d-card
     1863                                                       ,input v-rec-ord3
     1864                                                       ,input no
     1865                                                       ).
     1866         run create-smart-route in this-procedure  ( input buf_dis-card.d-card
     1867                                                   ,input -1).
     1868       end.
     1869     end.
     1870   end.
     1871   end procedure.
     1872   procedure discardh_send-dis-card-rul  :
     1873   define parameter buffer buf_dis-card for ub.dis-card .
     1874   define input parameter p-type as character no-undo .
