     1212   def var vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1213   procedure get-gate-file-name :
     1214   define input parameter p-gate-rec as character no-undo .
     1215   define output  parameter p-gate-file-name as character no-undo .
     1216   define buffer buf_clob-data for ub.clob-data.
     1217   define variable v-tbl-row as rowid no-undo .
     1218   define variable v-tbl-name as character no-undo .
     1219   run gen-row-keyr in this-procedure ( input p-gate-rec
     1220                                       ,input ?
     1221                                       ,input "ub"
     1222                                       ,input ?
     1223                                       ,input no-lock
     1224                                       ,output v-tbl-row
     1225                                       ,output v-tbl-name) no-error.
     1226   if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     1227                                                           ,vss-include-info13
     1228                                                           ,p-gate-rec).
     1229   find first buf_clob-data no-lock where
     1230             rowid(buf_clob-data) = v-tbl-row no-error.
     1231   if not available buf_clob-data then do:
     1232     if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     1233                                                             ,vss-include-info13
     1234                                                             ,p-gate-rec).
     1235   end.
     1236   p-gate-file-name = buf_clob-data.file-name.
     1237   end procedure.
     1238   procedure get-gate-rec :
     1239   define input  parameter p-gate-name as character no-undo .
     1240   define output parameter p-gate-rec as character no-undo .
     1241   define buffer buf_clob-bind for ub.clob-bind.
     1242   define buffer buf_clob-data for ub.clob-data.
     1243   main-block:
     1244   do
     1245   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info13, return-value, chr(10), error-status :get-message (1))
     1246   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info13 )
     1247   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info13 )
     1248   :
     1249       find first buf_clob-bind no-lock where
     1250                 buf_clob-bind.uniq-key-rec = p-gate-name
     1251             and buf_clob-bind.field-name = '':U
     1252             and buf_clob-bind.part-num = 1
     1253             and buf_clob-bind.resource-type = 'gate':U
     1254             no-error.
     1255       if not available buf_clob-bind then do:
     1256         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     1257                                         , p-gate-name
     1258                                         ).
     1259       end.
     1260       find first buf_clob-data no-lock where
     1261                 buf_clob-data.db-num = buf_clob-bind.db-num
     1262             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     1263       if not available buf_clob-data then do:
     1264         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1265                                         , buf_clob-bind.db-num
     1266                                         , buf_clob-bind.int64-id
     1267                                         , p-gate-name
     1268                                         ).
     1269       end.
     1270       run gen-key-rec in this-procedure ( input 'clob-data':U
     1271                                 ,input buffer buf_clob-data:handle
     1272                                 ,output p-gate-rec).
     1273   end.
     1274   end procedure.
     1275   procedure get-gate-by-name :
     1276   define input  parameter p-gate-name as character no-undo .
     1277   define output parameter p-gate-rec as character no-undo .
     1278   define output parameter p-dsh as handle no-undo .
     1279   define input-output  parameter p-xmlh as handle no-undo .
     1280   define variable v-ii as integer   no-undo .
     1281   define variable glog as logical   no-undo .
     1282   define variable v-longchar as longchar no-undo .
     1283   define variable v-txmlh as handle no-undo .
     1284   define variable v-db-num as integer no-undo .
     1285   define variable v-int64-id as int64 no-undo .
     1286   define buffer buf_clob-bind for ub.clob-bind.
     1287   define buffer buf_clob-data for ub.clob-data.
     1288   main-block:
     1289   do
     1290   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info13, return-value, chr(10), error-status :get-message (1))
     1291   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info13 )
     1292   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info13 )
     1293   :
     1294       find first buf_clob-bind no-lock where
     1295                 buf_clob-bind.uniq-key-rec = p-gate-name
     1296             and buf_clob-bind.field-name = '':U
     1297             and buf_clob-bind.part-num = 1
     1298             and buf_clob-bind.resource-type = 'gate':U
     1299             no-error.
     1300       if not available buf_clob-bind then do:
     1301         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     1302                                         , p-gate-name
     1303                                         ).
     1304       end.
     1305       find first buf_clob-data no-lock where
     1306                 buf_clob-data.db-num = buf_clob-bind.db-num
     1307             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     1308       if not available buf_clob-data then do:
     1309         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1310                                         , buf_clob-bind.db-num
     1311                                         , buf_clob-bind.int64-id
     1312                                         , p-gate-name
     1313                                         ).
     1314       end.
     1315       assign
     1316       v-longchar = buf_clob-data.cdata
     1317       .
     1318       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1319       if error-status :error then do:
     1320         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1321       end.
     1322       create dataset p-dsh .
     1323       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1324                                     , v-longchar
     1325                                     , ?
     1326                                     , ?
     1327                                     , ?
     1328                                     ) no-error.
     1329       v-longchar = '':U.
     1330       if error-status :error
     1331       or not glog
     1332       then do:
     1333         undo, return error substitute("Не удалось прочитать XML-схему &1 из БД:&2&3", p-gate-name, chr(10), error-status:get-message(1) ).
     1334       end.
     1335       if not valid-handle(p-xmlh)
     1336       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1337         create temp-table v-txmlh.
     1338         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1339         v-txmlh:temp-table-prepare("temp-xml-tables").
     1340         p-xmlh = v-txmlh:default-buffer-handle.
     1341       end.
     1342       run gen-key-rec in this-procedure ( input 'clob-data':U
     1343                                 ,input buffer buf_clob-data:handle
     1344                                 ,output p-gate-rec).
     1345       do v-ii = 1 to p-dsh:num-buffers:
     1346         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1347         if not p-xmlh:available then do:
     1348           p-xmlh:buffer-create().
     1349           assign
     1350           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1351           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1352           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1353           p-xmlh::gate-handle_ = p-dsh
     1354           p-xmlh::uniq-gate-rec = p-gate-rec
     1355           p-xmlh::gate-name = p-dsh:name
     1356           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1357           .
     1358           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1359             assign
     1360             p-xmlh::order = -3.
     1361           end.
     1362         end.
     1363       end.
     1364   end.
     1365   end procedure.
     1366   procedure get-gate-by-rec :
     1367   define input  parameter p-gate-rec as character no-undo .
     1368   define output parameter p-dsh as handle no-undo .
     1369   define input-output  parameter p-xmlh as handle no-undo .
     1370   define input-output parameter p-longchar  as longchar no-undo .
     1371   define variable v-ii as integer   no-undo .
     1372   define variable glog as logical   no-undo .
     1373   define variable v-rowid as rowid no-undo .
     1374   define variable v-tbl-name as character no-undo .
     1375   define variable v-longchar as longchar no-undo .
     1376   define variable v-txmlh as handle no-undo .
     1377   define buffer buf_clob-data for ub.clob-data.
     1378   main-block:
     1379   do
     1380   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info13, return-value, chr(10), error-status :get-message (1))
     1381   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info13 )
     1382   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info13 )
     1383   :
     1384     run gen-row-keyr in this-procedure (
     1385                                           input  p-gate-rec
     1386                                           ,input  ?
     1387                                           ,input  "ub"
     1388                                           ,input  ?
     1389                                           ,input  NO-LOCK
     1390                                           ,output v-rowid
     1391                                           ,output v-tbl-name   ) no-error.
     1392       find first buf_clob-data no-lock where
     1393                 rowid(buf_clob-data) = v-rowid  no-error.
     1394       if not available buf_clob-data then do:
     1395         undo, return error substitute("Не найден CLOB  &1"
     1396                                         , p-gate-rec
     1397                                         ).
     1398       end.
     1399       assign
     1400       v-longchar = buf_clob-data.cdata
     1401       .
     1402       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1403       if error-status :error then do:
     1404         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1405       end.
     1406       create dataset p-dsh .
     1407       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1408                                     , v-longchar
     1409                                     , ?
     1410                                     , ?
     1411                                     , ?
     1412                                     ) no-error.
     1413       define variable v-esm as character no-undo .
     1414       v-esm = error-status:get-message(1) .
     1415       if p-longchar <> ? then do:
     1416         p-longchar = v-longchar.
     1417       end.
     1418       v-longchar = '':U.
     1419       if error-status :error
     1420       or not glog
     1421       then do:
     1422         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     1423                                      , p-gate-rec
     1424                                      , p-gate-rec
     1425                                      , v-esm
     1426                                      ).
     1427       end.
     1428       p-dsh:private-data = buf_clob-data.file-name_ + chr(4) + p-gate-rec.
     1429       if not valid-handle(p-xmlh)
     1430       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1431         create temp-table v-txmlh.
     1432         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1433         v-txmlh:temp-table-prepare("temp-xml-tables").
     1434         p-xmlh = v-txmlh:default-buffer-handle.
     1435       end.
     1436       do v-ii = 1 to p-dsh:num-buffers:
     1437         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1438         if not p-xmlh:available then do:
     1439           p-xmlh:buffer-create().
     1440           assign
     1441           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1442           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1443           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1444           p-xmlh::gate-handle_ = p-dsh
     1445           p-xmlh::uniq-gate-rec = p-gate-rec
     1446           p-xmlh::gate-name = p-dsh:name
     1447           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1448           .
     1449           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1450             assign
     1451             p-xmlh::order = -3.
     1452           end.
     1453           p-xmlh:buffer-release().
     1454         end.
     1455       end.
     1456   end.
     1457   end procedure.
     1458   procedure get-gate-by-file :
     1459   define input  parameter p-schema-file-name as character no-undo .
     1460   define input  parameter p-gate-rec as character no-undo .
     1461   define output parameter p-dsh as handle no-undo .
     1462   define input-output  parameter p-xmlh as handle no-undo .
     1463   define variable v-ii as integer   no-undo .
     1464   define variable glog as logical   no-undo .
     1465   define variable v-rowid as rowid no-undo .
     1466   define variable v-tbl-name as character no-undo .
     1467   define variable v-longchar as longchar no-undo .
     1468   define variable v-txmlh as handle no-undo .
     1469   main-block:
     1470   do
     1471   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info13, return-value, chr(10), error-status :get-message (1))
     1472   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info13 )
     1473   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info13 )
     1474   :
     1475       COPY-LOB
     1476       FROM  FILE p-schema-file-name
     1477       TO  OBJECT v-longchar
     1478       no-convert
     1479       NO-ERROR .
     1480       if error-status :error then do:
     1481           undo, return error substitute("Не удалось считать файл схемы &1 в память&2&3"
     1482                                     , p-schema-file-name
     1483                                 , chr(10)
     1484                                 , error-status:get-message(1) ).
     1485       end.
     1486       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1487       if error-status :error then do:
     1488         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, p-schema-file-name, chr(10), error-status:get-message(1) , return-value ).
     1489       end.
     1490       create dataset p-dsh .
     1491       glog = p-dsh:READ-XMLSCHEMA( "longchar"
     1492                                     , v-longchar
     1493                                     , ?
     1494                                     , ?
     1495                                     , ?
     1496                                     ) no-error.
     1497       v-longchar = ''.
     1498       if error-status :error
     1499       or not glog
     1500       then do:
     1501         undo, return error substitute("Не удалось прочитать XML-схему из файла &1&2&3"
     1502                                      , p-schema-file-name
     1503                                      ,chr(10)
     1504                                      , error-status:get-message(1)
     1505                                      ).
     1506       end.
     1507       if not valid-handle(p-xmlh)
     1508       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1509         create temp-table v-txmlh.
     1510         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1511         v-txmlh:temp-table-prepare("temp-xml-tables").
     1512         p-xmlh = v-txmlh:default-buffer-handle.
     1513       end.
     1514       do v-ii = 1 to p-dsh:num-buffers:
     1515         p-xmlh:find-first(substitute(' where tbl-name = "&1" and  uniq-gate-rec = "&2" '
     1516                                      ,p-dsh:get-buffer-handle(v-ii):name
     1517                                      ,p-gate-rec
     1518                                      )) no-error.
     1519         if not p-xmlh:available then do:
     1520           p-xmlh:buffer-create().
     1521           assign
     1522           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):table
     1523           p-xmlh::uniq-gate-rec = p-gate-rec
     1524           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1525           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1526           p-xmlh::gate-handle_ = p-dsh
     1527           p-xmlh::gate-name = p-dsh:name
     1528           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1529           .
     1530           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1531             assign
     1532             p-xmlh::order = -3.
     1533           end.
     1534           p-xmlh:buffer-release().
     1535         end.
     1536       end.
     1537   end.
     1538   end procedure.
     1539   procedure gate-clear :
     1540   define input  parameter p-dsh as handle no-undo .
     1541   define input  parameter p-xmlh as handle no-undo .
     1542   define variable v-dsh as handle no-undo .
     1543   define variable v-th as handle no-undo .
     1544     do
     1545     on error undo, return error return-value
     1546     :
     1547       if valid-handle(p-dsh) then do:
     1548         delete object p-dsh.
     1549         v-dsh = p-dsh.
     1550         p-dsh = ?.
     1551       end.
     1552       repeat while true:
     1553         p-xmlh:find-first( substitute( " where gate-handle_ = &1 ", v-dsh)
     1554                            , share-lock) no-error.
     1555         if p-xmlh:available then do:
     1556           assign
     1557           v-th = p-xmlh:buffer-field("table-handle_"):buffer-value.
     1558           if valid-handle(p-xmlh:buffer-field("table-handle_"))
     1559           and valid-handle(v-th)
     1560           and v-th:dynamic = yes
     1561           then do:
     1562             delete object p-xmlh:buffer-field("table-handle_"):buffer-value.
     1563             p-xmlh:buffer-field("table-handle_"):buffer-value = ?.
     1564           end.
     1565           p-xmlh:buffer-delete().
     1566         end.
     1567         else do:
     1568           leave.
     1569         end.
     1570       end.
     1571       if p-xmlh:dynamic = yes
     1572       and valid-handle(p-xmlh)
     1573       then do:
     1574         delete object p-xmlh:table-handle.
     1575         p-xmlh = ?.
     1576       end.
     1577       v-dsh = ?.
     1578     end.
     1579   end procedure.
     1580   procedure all-gates-clear :
     1581   define parameter buffer buf_temp-xml-tables for temp-xml-tables.
     1582   do
     1583   on error undo, return error
     1584   :
     1585     for each buf_temp-xml-tables
     1586     break
     1587     by buf_temp-xml-tables.uniq-gate-rec
     1588     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1589     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1590     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1591     :
     1592         if first-of(buf_temp-xml-tables.uniq-gate-rec) then do:
     1593           delete object buf_temp-xml-tables.gate-handle_.
     1594           buf_temp-xml-tables.gate-handle_ = ?.
     1595         end.
     1596         if valid-handle(buf_temp-xml-tables.table-handle_)
     1597         and buf_temp-xml-tables.table-handle_:dynamic = no
     1598         then do:
     1599           delete object buf_temp-xml-tables.table-handle_.
     1600           buf_temp-xml-tables.table-handle_ = ?.
     1601         end.
     1602         delete buf_temp-xml-tables.
     1603     end.
     1604   end.
     1605   end procedure.
     1606   procedure fix-schemalocation :
     1607   define input-output  parameter p-longchar as longchar no-undo .
     1608   DEFINE VARIABLE hdoc AS HANDLE.
     1609   DEFINE VARIABLE hroot AS HANDLE.
     1610   DEFINE VARIABLE hnode-child AS HANDLE.
     1611   DEFINE VARIABLE hnode-attr AS HANDLE.
     1612   define variable v-jj as integer   no-undo .
     1613   define variable ok as logical   no-undo .
     1614   define variable v-path1                    as character                no-undo .
     1615   DEFINE VARIABLE v-full-path1               as character                no-undo .
     1616   DEFINE VARIABLE v-file-name1               as character                no-undo .
     1617   DEFINE VARIABLE v-file-name-no-ext1        as character                no-undo .
     1618   DEFINE VARIABLE v-file-name-ext1           as character                no-undo .
     1619   define variable v-schema-location          as character                no-undo .
     1620   do
     1621   on error undo, return error return-value
     1622   :
     1623     CREATE X-DOCUMENT hdoc.
     1624     CREATE X-noderef hroot.
     1625     CREATE X-noderef hnode-child.
     1626     CREATE X-noderef hnode-attr.
     1627     hdoc:load("longchar", p-longchar, no) no-error.
     1628     iF ERROR-STATUS:GET-MESSAGE(1) <> '' THEN message ERROR-STATUS:GET-MESSAGE(1) view-as alert-box .
     1629     hdoc:get-document-element(hroot).
     1630     _repeat:
     1631     REPEAT v-jj = 1 TO hroot:NUM-CHILDREN:
     1632       ok = hroot:GET-CHILD(hNode-Child, v-jj).
     1633       if not ok then next.
     1634       if hNode-Child:local-name = "include"
     1635       then do:
     1636         ok = hNode-Child:GET-ATTRIBUTE-NODE( hnode-attr, "schemaLocation" ).
     1637           v-schema-location = hnode-attr:node-value.
     1638           run gbl/filename.p (
     1639                           input "exe/" + hnode-attr:node-value
     1640                         ,output v-full-path1
     1641                         ,output v-path1
     1642                         ,output v-file-name1
     1643                         ,output v-file-name-no-ext1
     1644                         ,output v-file-name-ext1
     1645                         ) no-error .
     1646           if error-status :error then do:
     1647             delete object hnode-attr.
     1648             delete object hnode-child.
     1649             delete object hroot.
     1650             delete object hdoc.
     1651             undo, return error substitute("Не удалось определить расположение схемы &1", v-schema-location).
     1652           end.
     1653         ok = hNode-Child:sET-ATTRIBUTE(  "schemaLocation", v-full-path1 ).
     1654         leave  _repeat.
     1655       end.
     1656     END.
     1657     hdoc:save("longchar", p-longchar).
     1658     delete object hnode-attr.
     1659     delete object hnode-child.
     1660     delete object hroot.
     1661     delete object hdoc.
     1662   end.
     1663   end procedure.
     1664   procedure gate-clb_fill-xml-tables :
     1665   define input parameter p-dsh as handle no-undo .
     1666   define input-output parameter p-xmlh as handle no-undo .
     1667   define variable v-ii as integer no-undo .
     1668     do
     1669     on error undo, return error
     1670     :
     1671       do v-ii = 1 to p-dsh:num-buffers:
     1672         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1673         if not p-xmlh:available then do:
     1674           p-xmlh:buffer-create().
     1675           assign
     1676           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1677           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1678           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1679           p-xmlh::gate-handle_ = p-dsh
     1680           p-xmlh::uniq-gate-rec = entry(2, p-dsh:private-data, chr(4))
     1681           p-xmlh::gate-name = p-dsh:name
     1682           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1683           .
     1684           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1685             assign
     1686             p-xmlh::order = -3.
     1687           end.
     1688           p-xmlh:buffer-release().
     1689         end.
     1690       end.
     1691     end.
     1692   end procedure.
     1693   procedure all-gates-empty :
     1694   define buffer buf_temp-xml-tables for temp-xml-tables.
     1695   do
     1696   on error undo, return error
     1697   :
     1698     for each buf_temp-xml-tables
     1699     break
     1700     by buf_temp-xml-tables.uniq-gate-rec
     1701     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1702     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1703     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1704     :
     1705       if valid-handle(buf_temp-xml-tables.tbl-handle_) then do:
     1706         buf_temp-xml-tables.tbl-handle_:empty-temp-table().
     1707       end.
     1708     end.
     1709   end.
     1710   end procedure.
     1711   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1712   define variable v-current-d-card as character no-undo .
     1713   define variable v-current-host-code as integer no-undo .
