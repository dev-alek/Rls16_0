     2297             run ref/payment1.p (
     2298                            input 'ДОБАВЛЕНИЕ':U
     2299                           ,input yes
     2300                           ,input-output vchk-pay.pmnt-code
     2301                           ,input temp-d-card.cli-type
     2302                           ,input temp-d-card.cli-code
