     2357   procedure load-ruleset-context :
     2358   define input parameter p-ruleset-id as integer no-undo .
     2359   define buffer buf_rule-call-param for ub.rule-call-param.
     2360     do
     2361     on error undo, return error
     2362     :
     2363    find first buf_rule-call-param no-lock where
     2364   buf_rule-call-param.codex_id = p-codex-id
     2365   and buf_rule-call-param.ruleset_id = p-ruleset-id
     2366   and buf_rule-call-param.call_id = p-call-id
     2367   and buf_rule-call-param.order_id = p-order-id
     2368   and buf_rule-call-param.rule_id = p-rule-id
     2369   and buf_rule-call-param.param-name = "p-sum-id"
     2370    no-error.
     2371   if available buf_rule-call-param then do:
     2372   assign p-sum-id = buf_rule-call-param.param-value-character.
     2373   end.
     2374    find first buf_rule-call-param no-lock where
     2375   buf_rule-call-param.codex_id = p-codex-id
     2376   and buf_rule-call-param.ruleset_id = p-ruleset-id
     2377   and buf_rule-call-param.call_id = p-call-id
     2378   and buf_rule-call-param.order_id = p-order-id
     2379   and buf_rule-call-param.rule_id = p-rule-id
     2380   and buf_rule-call-param.param-name = "p-caller-id"
     2381    no-error.
     2382   if available buf_rule-call-param then do:
     2383   assign p-caller-id = buf_rule-call-param.param-value-character.
     2384   end.
     2385       assign
     2386       vh_dis-card-sale_obj = buffer temp-d-card:handle
     2387       v-save = p-save
     2388       v-current-doc-type = p-doc-type
     2389       .
     2390       case p-ruleset-id:
     2391         when 1 then do:
     2392           assign
     2393           v-sign = 1
     2394           v-current-host-code = p-host-code
     2395           v-current-obj-type = p-obj-type
     2396           v-current-obj-code = p-obj-code
     2397           v-current-db-num = g#db-num
     2398           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     2399           v-current-doc-code = p-doc-code
     2400           v-current-doc-date = p-doc-date
     2401           v-current-doc-fact-date = p-fact-date
     2402           v-current-date = p-doc-date
     2403           v-current-fact-date = p-fact-date
     2404           .
     2405         end.
     2406         when 2 then do:
     2407           assign
     2408           v-sign = -1
     2409           v-current-host-code = p-host-code
     2410           v-current-obj-type = p-obj-type
     2411           v-current-obj-code = p-obj-code
     2412           v-current-db-num = g#db-num
     2413           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     2414           v-current-doc-code = p-doc-code
     2415           v-current-doc-date = p-doc-date
     2416           v-current-doc-fact-date = p-fact-date
     2417           v-current-date = p-doc-date
     2418           v-current-fact-date = p-fact-date
     2419           .
     2420         end.
     2421         when 3 or
     2422         when 6 then do:
     2423           assign
     2424           v-sign = 1
     2425           v-current-host-code = p-host-code
     2426           v-current-obj-type = p-obj-type
     2427           v-current-obj-code = p-obj-code
     2428           v-current-db-num = g#db-num
     2429           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     2430           v-current-doc-code = p-doc-code
     2431           v-current-doc-date = p-doc-date
     2432           v-current-doc-time = 0
     2433           v-current-doc-fact-date = p-fact-date
     2434           v-current-date = p-doc-date
     2435           v-current-fact-date = p-fact-date
     2436           .
     2437         end.
     2438         when 4 then do:
     2439           assign
     2440           v-sign = -1
     2441           v-current-host-code = p-host-code
     2442           v-current-obj-type = p-obj-type
     2443           v-current-obj-code = p-obj-code
     2444           v-current-db-num = g#db-num
     2445           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     2446           v-current-doc-code = p-doc-code
     2447           v-current-doc-date = p-doc-date
     2448           v-current-doc-time = 0
     2449           v-current-doc-fact-date = p-fact-date
     2450           v-current-date = p-doc-date
     2451           v-current-fact-date = p-fact-date
     2452           .
     2453         end.
     2454         when 5 then do:
     2455           assign
     2456           v-sign = 1
     2457           v-current-host-code = p-host-code
     2458           v-current-obj-type = p-obj-type
     2459           v-current-obj-code = p-obj-code
     2460           v-current-db-num = g#db-num
     2461           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     2462           v-current-doc-code = p-doc-code
     2463           v-current-doc-date = p-doc-date
     2464           v-current-doc-time = 0
     2465           v-current-doc-fact-date = p-fact-date
     2466           v-current-date = p-doc-date
     2467           v-current-fact-date = p-fact-date
     2468           .
     2469         end.
     2470         when 7
     2471         or when 9
     2472         then do:
     2473           assign
     2474           v-sign = 1
     2475           v-current-host-code = p-host-code
     2476           v-current-obj-type = p-obj-type
     2477           v-current-obj-code = p-obj-code
     2478           v-current-db-num = g#db-num
     2479           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     2480           v-current-doc-code = p-doc-code
     2481           v-current-doc-date = p-doc-date
     2482           v-current-doc-time = 0
     2483           v-current-doc-fact-date = p-fact-date
     2484           v-current-date = p-doc-date
     2485           v-current-fact-date = p-fact-date
     2486           .
     2487         end.
     2488       end case.
     2489     end.
     2490   end procedure.
     2491   procedure delete-procedure :
