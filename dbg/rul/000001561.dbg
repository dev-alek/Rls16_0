     2149   procedure get-db-list-for-d-card3 :
     2150   define input parameter p-d-card as character no-undo .
     2151   define variable v-current-db-processed as logical no-undo .
     2152   define buffer buf_clients  for ub.clients.
     2153   define buffer buf_dis-obj for ub.dis-obj.
     2154   define buffer buf_temp-smart-route for temp-smart-route.
     2155     do
     2156     on error undo, return error return-value
     2157     :
     2158       for each buf_dis-obj no-lock where
     2159               buf_dis-obj.d-card = p-d-card,
     2160          first buf_clients no-lock where
     2161               buf_clients.obj-type = buf_dis-obj.obj-type
     2162           and buf_clients.obj-code = buf_dis-obj.obj-code
     2163       break by
     2164       buf_clients.db-num:
     2165         if first-of(buf_Clients.db-num) then do:
     2166           find first buf_temp-smart-route no-lock where
     2167                 buf_temp-smart-route.key-field = p-d-card
     2168             and buf_temp-smart-route.db-num = buf_clients.db-num
     2169                 no-error.
     2170           if available buf_temp-smart-route then return.
     2171           create buf_temp-smart-route.
     2172           assign
     2173           buf_temp-smart-route.key-field = p-d-card
     2174           buf_temp-smart-route.db-num = buf_clients.db-num
     2175           .
     2176           if buf_clients.db-num = g#db-num then do:
     2177             v-current-db-processed = yes.
     2178           end.
     2179         end.
     2180       end.
     2181       if not v-current-db-processed then do:
     2182         find first buf_temp-smart-route no-lock where
     2183               buf_temp-smart-route.key-field = p-d-card
     2184           and buf_temp-smart-route.db-num = g#db-num
     2185               no-error.
     2186         if not available buf_temp-smart-route then do:
     2187           create buf_temp-smart-route.
     2188           assign
     2189           buf_temp-smart-route.key-field = p-d-card
     2190           buf_temp-smart-route.db-num = g#db-num
     2191           .
     2192         end.
     2193       end.
     2194     end.
     2195   end procedure.
     2196   on delete of this-procedure do:
     2197     run garbcoll_clear in this-procedure .
     2198   end.
     2199   run load-ruleset-context in this-procedure ( input p-ruleset-id).
     2200    define variable Card1 as class Dis-card_ no-undo .
     2201   Card1 = new Dis-card_( input parparentproc, input p-parent-handle, input p-log-handle, input this-procedure:handle, input p-cont-handle, input v-current-lock, input v-current-wait, input v-save) .
     2202    define variable Next-discount1 as class Next-discount_ no-undo .
     2203   Next-discount1 = new Next-discount_(  input parparentproc, input p-parent-handle, input p-log-handle, input this-procedure:handle, input p-cont-handle, input v-current-lock, input v-current-wait, input v-save, input 7) .
     2204   if not this-procedure:persistent then do:
     2205     run proc-main in this-procedure ( input p-type
     2206                                 ,input p-emitent-host-code ) no-error .
     2207     if error-status:error then do:
     2208         run garbcoll_clear in this-procedure .
     2209         undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     2210     end.
     2211     run garbcoll_clear in this-procedure .
     2212   end.
     2213   procedure proc-main :
     2214   define input parameter p-type like ub.dis-card.type no-undo .
     2215   define input parameter p-emitent-host-code like ub.dis-card.emitent-host-code no-undo .
     2216   _main:
     2217   do
     2218   on error undo, return error return-value
     2219   :
     2220   assign
     2221   v-emitent-host-code = p-emitent-host-code
     2222   v-type = p-type.
     2223     _d-card:
     2224     for each temp-d-card where
     2225             temp-d-card.type = p-type
     2226         and temp-d-card.emitent-host-code = p-emitent-host-code
     2227     break
     2228     by temp-d-card.d-card
     2229     On error undo _d-card, retry _d-card:
     2230       if temp-d-card.d-card = '_' then next.
     2231       if retry then do:
     2232         if p-ruleset-id = 5 then do:
     2233           num-rec-calc-err = num-rec-calc-err + 1.
     2234           undo _d-card, next _d-card .
     2235         end.
     2236         else do:
     2237           undo _main, return error return-value .
     2238         end.
     2239       end.
     2240       num-rec = num-rec + 1.
     2241       assign
     2242       v-current-d-card = temp-d-card.d-card
     2243       .
     2244       do transaction
     2245       On end-key undo _d-card, retry _d-card
     2246       On stop undo _d-card, retry _d-card
     2247       On error undo _d-card, retry _d-card:
     2248   _1561:
     2249   do:
