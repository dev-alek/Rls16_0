      976   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      977   procedure set-error :
      978   define input parameter p-mess as character no-undo .
      979     do
      980     on error undo, return error
      981     :
      982        assign
      983        v-last-error-message = p-mess.
      984     end.
      985   end procedure.
      986   define variable p-xsd-file as character no-undo.
      987   on delete of this-procedure do:
      988     run garbcoll_clear in this-procedure .
      989   end.
      990   run load-ruleset-context in this-procedure ( input p-ruleset-id) no-error.
      991   if error-status:error then do:
      992     undo, return error return-value .
      993   end.
      994   if not this-procedure:persistent then do:
      995     run proc-main in this-procedure no-error .
      996     if error-status:error then do:
      997       v-es = error-status:error .
      998       v-rv = return-value .
      999     end.
     1000     if v-es then do:
     1001         run garbcoll_clear in this-procedure .
     1002         undo, return error substitute( "&1. &2&3&4", vss-workfile, v-rv, chr(10), v-esm).
     1003     end.
     1004     run garbcoll_clear in this-procedure .
     1005   end.
     1006   procedure proc-main :
     1007   define variable p-data-datetime as datetime no-undo .
     1008   DEFINE VARIABLE v-today as date no-undo .
     1009   DEFINE VARIABLE v-time as integer no-undo .
     1010   define variable v-cli-list as character no-undo .
     1011   define variable v-report-id as character no-undo .
     1012   define variable v-start-datetime as datetime no-undo .
     1013   define variable v-dataseth as handle no-undo .
     1014   define variable v-xmlh as handle no-undo .
     1015   define variable glog as logical no-undo .
     1016   define buffer buf_temp-rule-call-param for temp-rule-call-param.
     1017   define buffer buf_clients for ub.clients.
     1018   _main:
     1019   do
     1020   on error undo, return error substitute( "&1&2&3&2&4", return-value, chr(10), error-status :get-message (1), v-last-error-message)
     1021   :
     1022     for each buf_temp-rule-call-param where
     1023             buf_temp-rule-call-param.param-name ="p-shops"
     1024         and buf_temp-rule-call-param.p-index > 0 :
     1025       find first buf_clients no-lock where
     1026                 buf_clients.obj-type = 'маг':U
     1027            and  buf_clients.obj-code = buf_temp-rule-call-param.param-value-integer no-error.
     1028       if available buf_clients then do:
     1029         v-cli-list = v-cli-list + (if v-cli-list = '' then '' else chr(44)) + string(recid(buf_clients)).
     1030        end.
     1031     end.
     1032     empty temp-table report-headert.
     1033     empty temp-table report-parameterst.
     1034     empty temp-table report-errorst.
     1035     v-report-id = substitute("&1/&2", p-profile-id, p-rule-id).
     1036     v-start-datetime = cur-time-datetime().
     1037     p-data-datetime =  cur-time-datetime().
     1038     v-today = date(p-data-datetime).
     1039     v-time = mtime(p-data-datetime) / 1000.
     1040     run cb_write-report-parameter in p-parent-handle (
     1041                                                         input (buffer report-parameterst:handle)
     1042                                                        ,input v-report-id
     1043                                                        ,input "p-data-datetime"
     1044                                                        ,input "Дата-время"
     1045                                                        ,input 'character':U
     1046                                                        ,input string(p-data-datetime)
     1047                                                        ,input ?
     1048                                                        ,input 0.0
     1049                                                        ,input 0
     1050                                                        ,input no
     1051                                                        ,input 0
     1052                                                        ,input 'Дата-время актуальность данных отчета'
     1053                                                        ).
     1054     run rep/r-dispet.p (
     1055                          input parparentproc
     1056                         ,input p-parent-handle
     1057                         ,input p-log-handle
     1058                         ,input p-cont-handle
     1059                         ,input this-procedure:handle
     1060                         ,input (buffer report-errorst:handle)
     1061                         ,input (buffer report-destinationt:handle)
     1062                         ,input substitute("&1/&2", p-profile-id, p-rule-id)
     1063                         ,input p-xsd-file
     1064                         ,input log-file-name
     1065                         ,input integer('1':U)
     1066                         ,input p-codex-id
     1067                         ,input p-ruleset-id
     1068                         ,input v-time
     1069                         ,input v-today
     1070                         ,input v-cli-list
     1071                         ,input no
     1072                         ,input yes
     1073                         ,input ''
     1074                         ,input ''
     1075                         ,output v-dataseth
     1076                         ,output v-xmlh
     1077                         ) no-error.
     1078     if error-status:error then do:
     1079       v-esm = error-status :get-message (1).
     1080       v-rv = return-value .
     1081       if p-ruleset-id = 1
     1082       then do:
     1083         run write-log  in p-log-handle (
     1084                                         input 0
     1085                                       , "&DLine").
     1086               run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute(".............Расчет отчета &1 закончился ошибкой", p-rule-id)).
     1087               run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute(".............&1", v-esm)).
     1088               run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute(".............&1", v-rv)).
     1089         v-rv = v-esm + chr(10) + v-rv.
     1090       end.
     1091       return error v-rv.
     1092     end.
     1093     else do:
     1094       run cb_fill-report-header in p-parent-handle ( input buffer buf_report-header:handle
     1095                                                     ,input v-report-id
     1096                                                     ,input "dispet"
     1097                                                     ,input "Отчет диспетчера"
     1098                                                     ,input v-start-datetime
     1099                                                     ,input cur-time-datetime()
     1100                                                     ).
     1101       run cb_fill-report-parameters in p-parent-handle ( input buffer buf_report-parameters:handle
     1102                                                         ,input v-report-id
     1103                                                         ).
     1104       glog = v-dataseth:copy-dataset (
     1105                               dataset reportheadertypet:handle
     1106                             , no
     1107                             , yes
     1108                             , yes
     1109                             ) no-error .
     1110       if error-status:error
     1111       or not glog
     1112       then do:
     1113               run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("!!Не удалось заполнить блок параметров!!! &1"                                   , error-status:get-message(1) )).
     1114       end.
     1115       run cb_rcps-run_set-value in p-cont-handle (
     1116                                                    input p-call-id
     1117                                                   ,input p-codex-id
     1118                                                   ,input p-ruleset-id
     1119                                                   ,input p-order-id
     1120                                                   ,INPUT "p-dataseth"
     1121                                                   ,INPUT 0
     1122                                                   ,input 'output':U
     1123                                                   ,INPUT string(v-dataseth)
     1124                                                   ,INPUT ?
     1125                                                   ,INPUT 0.0
     1126                                                   ,INPUT 0
     1127                                                   ,INPUT no
     1128                                                   ) no-error.
     1129       if error-status:error then do:
     1130               run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("!!Не удалось заполнить передать OUTPUT параметры правила!!! &1&2&1&3"                                  , chr(10)                                   , error-status:get-message(1) )).
     1131       end.
     1132     end.
     1133   end.
     1134   end procedure.
     1135   procedure load-ruleset-context :
     1136   define input parameter p-ruleset-id as integer no-undo .
     1137   define buffer buf_rule-call-param for ub.rule-call-param.
     1138   do
     1139   on error undo, return error
     1140   :
     1141   for each buf_temp-rule-call-param:
     1142     delete buf_temp-rule-call-param.
     1143   end.
     1144   for each buf_rule-call-param no-lock where
     1145   buf_rule-call-param.codex_id = p-codex-id
     1146   and buf_rule-call-param.ruleset_id = p-ruleset-id
     1147   and buf_rule-call-param.call_id = p-call-id
     1148   and buf_rule-call-param.order_id = p-order-id
     1149   and buf_rule-call-param.rule_id = p-rule-id
     1150   and buf_rule-call-param.param-name = "p-shops"
     1151   and buf_rule-call-param.p-index > 0:
     1152     create buf_temp-rule-call-param.
     1153     buffer-copy buf_rule-call-param to buf_temp-rule-call-param.
     1154     release buf_temp-rule-call-param.
     1155   end.
     1156     find first buf_rule-call-param no-lock where
     1157   buf_rule-call-param.codex_id = p-codex-id
     1158   and buf_rule-call-param.ruleset_id = p-ruleset-id
     1159   and buf_rule-call-param.call_id = p-call-id
     1160   and buf_rule-call-param.order_id = p-order-id
     1161   and buf_rule-call-param.rule_id = p-rule-id
     1162   and buf_rule-call-param.param-name = "p-xsd-file"
     1163    no-error.
     1164   if available buf_rule-call-param then do:
     1165   assign p-xsd-file = buf_rule-call-param.param-value-character.
     1166   end.
     1167       case p-ruleset-id:
     1168         when 1
     1169         then do:
     1170           assign
     1171           v-sign = 0
     1172           v-current-host-code = p0-host-code
     1173           v-current-obj-type = p-obj-type
     1174           v-current-obj-code = p-obj-code
     1175           v-current-db-num = g#db-num
     1176           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     1177           v-dirs  = p-process-dirs
     1178           v-current-rep-code  = p-doc-code
     1179           .
     1180         end.
     1181      end case.
     1182   end.
     1183   end procedure.
