        1   using Ibs.Th.Rul.Route-data_.
        2   block-level on error undo, throw.
        3   define input parameter parparentproc as widget-handle no-undo .
        4   define input parameter p-parent-handle as handle no-undo .
        5   define input parameter p-log-handle  as handle no-undo .
        6   define input parameter p-cont-handle  as handle no-undo .
        7   define input parameter p-codex-id as integer no-undo .
        8   define input parameter p-ruleset-id as integer no-undo .
        9   define input parameter p-call-id as character no-undo .
       10   define input parameter p-order-id as integer no-undo .
       11   define input parameter p-rule-id as integer no-undo .
       12   define input parameter p-profile-id as integer no-undo .
       13   define input parameter p-is-dynamic as logical no-undo .
       14   define input parameter p-doc-type as character no-undo .
       15   define input parameter p-host-code like ub.sysconf.host-code no-undo .
       16   define input parameter p-obj-type like ub.clients.obj-type no-undo .
       17   define input parameter p-obj-code like ub.clients.obj-code no-undo .
       18   define input parameter p-doc-code as character no-undo .
       19   define input parameter p-process-file-name as character no-undo .
       20   define input parameter p-save       as integer no-undo .
       21   define input parameter v-curr-r-b   as character no-undo .
       22   define input parameter p-cmd-proc-handle as handle no-undo .
       23   define input parameter p-cmd-code  as integer no-undo .
       24   define variable vss-revision    as character no-undo init "$Revision$":U .
       25   define variable vss-author      as character no-undo init "$Author$":U .
       26   define variable vss-date        as character no-undo init "$Date$":U .
       27   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       28   define variable vss-archive     as character no-undo init "$Archive$":U .
       29   define variable vss-description as character no-undo init "Библиотека процедур для работы с кодексом 11, набор 5".
       30   procedure vss-get-info :
       31     define output parameter p-vss-revision    like vss-revision    no-undo .
       32     define output parameter p-vss-author      like vss-author      no-undo .
       33     define output parameter p-vss-date        like vss-date        no-undo .
       34     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       35     define output parameter p-vss-archive     like vss-archive     no-undo .
       36     define output parameter p-vss-description like vss-description no-undo .
       37     assign
       38       p-vss-revision    = vss-revision
       39       p-vss-author      = vss-author
       40       p-vss-date        = vss-date
       41       p-vss-workfile    = vss-workfile
       42       p-vss-archive     = vss-archive
       43       p-vss-description = vss-description
       44     .
       45   end procedure.
       46   procedure vss-get-parameters :
       47     define output parameter p-vss-parameters as character no-undo .
       48   end procedure.
       49   define new global shared variable g#vssrevis-logger as handle    no-undo .
       50   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       51   define variable v-vssrevis-logger                   as handle    no-undo .
       52   procedure vss-logevent :
       53     define input  parameter p-extra-paramters as character no-undo .
       54     define variable v-vssrevis-parameters as character no-undo .
       55     do
       56     on error undo, return error return-value
       57     :
       58       if  valid-handle(v-vssrevis-logger)
       59       and v-vssrevis-logger :get-signature("logevent") <> ""
       60       then do:
       61         run vss-get-parameters in this-procedure
       62           (output v-vssrevis-parameters
       63           ).
       64         run logevent in v-vssrevis-logger
       65           (input vss-workfile
       66           ,input vss-revision
       67           ,input v-vssrevis-parameters
       68           ,input p-extra-paramters
       69           ).
       70       end.
       71     end.
       72   end procedure.
       73   assign
       74     v-vssrevis-logger = g#vssrevis-logger
       75   .
       76   if  valid-handle(v-vssrevis-logger)
       77   and v-vssrevis-logger :get-signature("logevent") <> ""
       78   then do:
       79     assign
       80       v-vssrevis-logevent = true
       81     .
       82     run vss-logevent in this-procedure (input vss-description) .
       83   end.
       84   define new global shared variable g#language as character no-undo .
       85   if g#language <> '' and g#language <> 'rus':U then do:
       86     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       87   end.
       88   define new global shared variable g#library  as handle no-undo .
       89   define new global shared variable g#library2 as handle no-undo .
       90   define   shared variable g#auto as logical no-undo.
       91   define   shared variable g#news as logical no-undo.
       92   define   shared variable g#oxml as logical no-undo.
       93   define   shared variable g#esys as logical no-undo.
       94   define   shared variable g#news-source-db as integer no-undo.
       95   define   shared variable g#esys-source-esys as integer no-undo.
       96   define   shared variable g#db-num as integer   no-undo .
       97   define   shared variable g#userid as character no-undo .
       98   define   shared variable g#passwd as character no-undo .
       99   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      100   define  variable garbcoll_ii as integer no-undo .
      101   define  temp-table temp-gc no-undo
      102   field ii as integer
      103   field obj-r as handle
      104   field cn as character
      105   index pi is unique primary
      106   ii
      107   index icn
      108   cn.
      109   procedure garbcoll_create-gc-entry :
      110   define input parameter p-cn as character no-undo .
      111   define input parameter p-obj-r as handle no-undo .
      112     do
      113     on error undo, return error
      114     :
      115       create temp-gc.
      116       assign
      117       temp-gc.ii = garbcoll_ii
      118       garbcoll_ii = garbcoll_ii + 1
      119       temp-gc.cn = p-cn
      120       temp-gc.obj-r = p-obj-r
      121       .
      122     end.
      123   end procedure.
      124   procedure garbcoll_clear :
      125     do
      126     on error undo, return error
      127     :
      128       for each temp-gc:
      129         delete object temp-gc.obj-r.
      130         delete temp-gc.
      131       end.
      132     end.
      133   end procedure.
      134   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      135   procedure cur-time :
      136      define output parameter p-today as date      no-undo .
      137      define output parameter p-time  as integer   no-undo .
      138     do
      139     on error undo, return error
      140     :
      141       define variable v-date1 as date      no-undo .
      142       define variable v-date2 as date      no-undo .
      143       define variable v-time  as integer   no-undo .
      144       assign
      145         v-date1 = today
      146         v-time  = time
      147         v-date2 = today
      148       .
      149       if v-date1 <> v-date2
      150       then do:
      151         assign
      152           v-date1 = today
      153           v-time  = v-time
      154         .
      155       end.
      156       assign
      157         p-today = v-date1
      158         p-time  = v-time
      159       .
      160     end.
      161   end.
      162   function cur-time-date returns character
      163   :
      164     return string(today, '99/99/9999':U) .
      165   end.
      166   function cur-time-mjd returns decimal
      167   :
      168     define variable v-date as date      no-undo .
      169     define variable v-time as integer   no-undo .
      170     run cur-time in this-procedure
      171       (output v-date
      172       ,output v-time
      173       ) .
      174     return integer(v-date) - 2400002 + (v-time / 86400) .
      175   end.
      176   function cur-time-get-ending-index returns integer
      177   (input p-number as integer
      178   )
      179   :
      180     if p-number < 0
      181     or p-number = ?
      182     then do:
      183       return 1 .
      184     end.
      185     define variable v-rest as integer   no-undo .
      186     assign
      187       p-number = p-number modulo 100
      188     .
      189     if p-number < 20
      190     then do:
      191       assign
      192         v-rest = p-number
      193       .
      194     end.
      195     else do:
      196       assign
      197         v-rest = p-number modulo 10
      198       .
      199     end.
      200     case v-rest :
      201       when 1
      202       then do:
      203         return 2 .
      204       end.
      205       when 2 or
      206       when 3 or
      207       when 4
      208       then do:
      209         return 3 .
      210       end.
      211       otherwise do:
      212         return 1 .
      213       end.
      214     end case .
      215   end.
      216   procedure cur-time-mjd-to-date :
      217      define input  parameter i-mjd-diff as decimal no-undo.
      218      define output parameter o-Date     as date    no-undo.
      219      define output parameter o-Time     as integer no-undo.
      220      define variable v-day-number as integer   no-undo .
      221      if    i-mjd-diff < 0
      222         or i-mjd-diff = ?
      223      then do:
      224         return "?" .
      225      end.
      226      assign
      227         v-day-number = truncate(i-mjd-diff,0).
      228         o-Date = date(v-day-number + 2400002).
      229         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      230     .
      231   end.
      232   function cur-time-mjd-to-string returns character
      233   (input p-mjd-diff as decimal
      234   )
      235   :
      236     define variable v-day-number as integer   no-undo .
      237     define variable v-seconds    as integer   no-undo .
      238     define variable v-hour       as integer   no-undo .
      239     define variable v-min        as integer   no-undo .
      240     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      241     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      242     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      243     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      244     if p-mjd-diff < 0
      245     or p-mjd-diff = ?
      246     then do:
      247       return "?" .
      248     end.
      249     assign
      250       v-day-number = integer(truncate(p-mjd-diff,0))
      251       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      252     .
      253     if v-seconds > 86400
      254     then do:
      255       assign
      256         v-seconds = 86400 - 1
      257       .
      258     end.
      259     if v-seconds < 0
      260     then do:
      261       assign
      262         v-seconds = 0
      263       .
      264     end.
      265     assign
      266       v-hour = truncate(v-seconds / 3600, 0)
      267     .
      268     assign
      269       v-seconds = v-seconds modulo 3600
      270     .
      271     assign
      272       v-min = truncate(v-seconds / 60, 0)
      273     .
      274     assign
      275       v-seconds = v-seconds modulo 60
      276     .
      277     return
      278         (if v-day-number <> 0
      279           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      280           else ""
      281         )
      282       + (if v-day-number <> 0 or v-hour <> 0
      283           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      284           else ""
      285         )
      286       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      287           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      288           else ""
      289         )
      290       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      291       .
      292   end.
      293   function cur-time-string returns character
      294   :
      295     define variable v-date as date      no-undo .
      296     define variable v-time as integer   no-undo .
      297     run cur-time in this-procedure
      298       (output v-date
      299       ,output v-time
      300       ) .
      301     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      302   end.
      303   function cur-time-string-sec returns character
      304   :
      305     define variable v-date as date      no-undo .
      306     define variable v-time as integer   no-undo .
      307     run cur-time in this-procedure
      308       (output v-date
      309       ,output v-time
      310       ) .
      311     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      312   end.
      313   function cur-time-custom  returns character
      314   (input p-prefix as character
      315   ,input p-date-format as character
      316   ,input p-delimiter as character
      317   ,input p-time-format as character
      318   ,input p-suffix as character
      319   )
      320   :
      321     define variable v-date as date      no-undo .
      322     define variable v-time as integer   no-undo .
      323     run cur-time in this-procedure
      324       (output v-date
      325       ,output v-time
      326       ) .
      327     return
      328       p-prefix
      329       + string(v-date, p-date-format)
      330       + p-delimiter
      331       + string(v-time, p-time-format)
      332       + p-suffix
      333       .
      334   end.
      335   function cur-time-print  returns character
      336   :
      337     define variable v-date as date      no-undo .
      338     define variable v-time as integer   no-undo .
      339     run cur-time in this-procedure
      340       (output v-date
      341       ,output v-time
      342       ) .
      343     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      344   end.
      345   function cur-time-datetime returns datetime
      346   :
      347     define variable v-char as character no-undo .
      348     define variable v-datetime as datetime no-undo .
      349     v-char = cur-time-string().
      350     v-datetime = datetime(v-char).
      351     return  v-datetime.
      352   end.
      353   function cur-time-string-msec returns character
      354   :
      355     define variable v-date as datetime  no-undo .
      356     v-date = now.
      357     return string(v-date) .
      358   end.
      359   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      360   define new global shared variable g#lib-nws as handle no-undo .
      361   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      362   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      363   define variable tempcxml_v-num_ as integer no-undo .
      364   define  temp-table temp-xml-tables no-undo
      365   field order as integer
      366   field tbl-name as character
      367   field tbl-handle_ as handle
      368   field table-handle_ as handle
      369   field uniq-gate-rec as character
      370   field gate-name as character
      371   field gate-handle_ as handle
      372   field is-parent as logical
      373   index pi is unique primary
      374   uniq-gate-rec
      375   tbl-name
      376   index iorder
      377   order
      378   index gr
      379   uniq-gate-rec
      380   index gh
      381   gate-handle_
      382   index iparent
      383   is-parent
      384   .
      385   define  temp-table temp-xml-records no-undo
      386   field tbl-name as character
      387   field uniq-key-rec as character
      388   index pi is unique primary
      389   tbl-name
      390   uniq-key-rec
      391   .
      392   def var vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      393   procedure gen-key-rec :
      394     define input  parameter p-tbl-name    as character no-undo.
      395     define input  parameter p-bh_tbl-name as handle    no-undo.
      396     define output parameter p-key-rec     as character no-undo.
      397     do
      398     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      399     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      400     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      401     :
      402       define variable fh               as handle    no-undo .
      403       define variable v-ok             as logical   no-undo .
      404       define variable v-inform         as character no-undo .
      405       define variable v-ind            as integer   no-undo .
      406       define variable v-idx-field-qnty as integer   no-undo .
      407       if p-tbl-name = ?
      408         or p-tbl-name = "":U
      409       then do:
      410         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info5 ).
      411       end.
      412       if not p-bh_tbl-name:available then do:
      413         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info5, p-tbl-name ).
      414       end.
      415       assign
      416         p-key-rec = p-tbl-name
      417         v-inform  = p-bh_tbl-name:index-information(1)
      418         v-ind     = 2
      419       .
      420       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      421       on error undo, return error
      422       :
      423         assign
      424           v-inform = p-bh_tbl-name:index-information( v-ind )
      425           v-ind    = v-ind + 1
      426         .
      427       end.
      428       if v-inform = ?
      429         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      430         or entry( 3, v-inform, ",":U ) <> "1":U
      431       then do:
      432         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, p-tbl-name ).
      433       end.
      434       else do:
      435         assign
      436           v-idx-field-qnty = num-entries( v-inform ) - 4
      437         .
      438         if v-idx-field-qnty < 2 then do:
      439           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, p-tbl-name ).
      440         end.
      441         do v-ind = 1 to v-idx-field-qnty by 2
      442         on error undo, return error
      443         :
      444           assign
      445             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      446             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      447           .
      448         end.
      449       end.
      450       if p-key-rec = ? then do:
      451         assign
      452           p-key-rec = "":U
      453         .
      454         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info5, p-tbl-name ).
      455       end.
      456     end.
      457     return.
      458   end procedure.
      459   procedure gen-where-keyr-tab :
      460     define input  parameter i-tableSerach as character no-undo.
      461     define input  parameter i-tablekey   as character  no-undo.
      462     define input  parameter p-key-rec    as character  no-undo.
      463     define input  parameter p-key-handle as handle     no-undo .
      464     define input  parameter p-db-name    as character  no-undo .
      465     define input  parameter p-tt-handle  as handle     no-undo .
      466     define output parameter o-Where      as character  no-undo.
      467     do
      468     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      469     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      470     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      471     :
      472       define variable v-full-tbl-name  as character no-undo .
      473       define variable bh_tbl-name      as handle    no-undo .
      474       define variable fh_key           as handle    no-undo .
      475       define variable fh_search        as handle    no-undo .
      476       define variable v-field-num      as integer   no-undo .
      477       define variable v-count-fld      as integer   no-undo .
      478       define variable v-inform         as character no-undo .
      479       define variable v-ind            as integer   no-undo .
      480       define variable v-idx-field-qnty as integer   no-undo .
      481       define variable v-field-name     as character no-undo .
      482       define variable v-field-val      as character no-undo .
      483       define variable v-word-link      as character no-undo .
      484       define variable vTable           as character no-undo.
      485       define variable bh_tbl-key       as handle    no-undo .
      486       assign
      487         p-key-rec = trim( p-key-rec )
      488       .
      489       if p-key-handle <> ? then do:
      490         if not valid-handle(p-key-handle)
      491            or p-key-handle:type <> "buffer"
      492         then do:
      493           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info5 ).
      494         end.
      495         if num-entries( p-key-rec, chr(3) ) > 1
      496           or p-key-rec = ?
      497           or p-key-rec = "":U
      498         then do:
      499           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info5, p-key-rec ).
      500         end.
      501       end.
      502       else do:
      503         if p-key-rec = ?
      504           or p-key-rec = "":U
      505         then do:
      506           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info5 ).
      507         end.
      508       end.
      509       assign
      510         vTable = entry( 1 , p-key-rec, chr(3) )
      511       .
      512       if p-tt-handle <> ?
      513         and ( not valid-handle(p-tt-handle)
      514               or p-tt-handle:type <> "buffer"
      515             )
      516       then do:
      517         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info5, vTable, chr(10) ).
      518       end.
      519       if p-tt-handle = ? then do:
      520         assign
      521           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      522         .
      523         create buffer bh_tbl-name for table v-full-tbl-name .
      524       end.
      525       else do:
      526         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      527       end.
      528       assign
      529         v-inform = bh_tbl-name:index-information(1)
      530         v-ind    = 2
      531       .
      532       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      533       on error undo, return error
      534       :
      535         assign
      536           v-inform = bh_tbl-name:index-information( v-ind )
      537           v-ind    = v-ind + 1
      538         .
      539       end.
      540       if v-inform = ?
      541         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      542         or entry( 3, v-inform, ",":U ) <> "1":U
      543       then do:
      544         delete object bh_tbl-name no-error.
      545         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info5, vTable ).
      546       end.
      547       assign
      548         v-idx-field-qnty = num-entries( v-inform ) - 4
      549       .
      550       if v-idx-field-qnty < 2 then do:
      551         delete object bh_tbl-name no-error.
      552         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, vTable ).
      553       end.
      554       assign
      555         o-where     = "where":U
      556         v-word-link = "":U
      557         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      558         v-count-fld = 0
      559       .
      560       if i-tablekey ne "" and i-tablekey ne ?
      561       then do:
      562         assign
      563           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      564         .
      565         create buffer bh_tbl-key for table v-full-tbl-name .
      566       end.
      567       if i-tableSerach ne "" and i-tableSerach ne ?
      568       then do:
      569         delete object bh_tbl-name no-error.
      570         assign
      571           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      572         .
      573         create buffer bh_tbl-name for table v-full-tbl-name .
      574       end.
      575       block_where:
      576       do v-ind = 1 to v-idx-field-qnty by 2
      577       on error undo, return error
      578       :
      579         assign
      580           v-count-fld = v-count-fld + 1
      581         .
      582         if p-key-handle = ?
      583           and v-count-fld > v-field-num
      584         then do:
      585           leave block_where.
      586         end.
      587         define variable VfieldKeyTable as handle no-undo.
      588         assign
      589           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      590           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      591         .
      592         if     bh_tbl-key ne ?
      593         then do:
      594            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      595            if VfieldKeyTable eq ?
      596            then next block_where.
      597         end.
      598         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      599         then
      600            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      601         else
      602            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      603         if p-key-handle = ? then do:
      604           assign
      605             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      606           .
      607         end.
      608         else do:
      609           assign
      610             fh_key = p-key-handle:buffer-field( v-field-name )
      611           .
      612           if fh_key = ?
      613             or not valid-handle( fh_key )
      614           then do:
      615             delete object bh_tbl-name.
      616             if     bh_tbl-key ne ?
      617             then
      618                delete object bh_tbl-key.
      619             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info5, p-key-handle:name, v-field-name ).
      620           end.
      621           assign
      622             v-field-val = fh_key:buffer-value
      623           .
      624         end.
      625         if fh_search:data-type ="character":U then do:
      626           assign
      627             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      628             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      629             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      630             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      631             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      632             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      633             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      634             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      635             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      636             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      637             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      638             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      639             v-field-val = substitute( '"&1"', v-field-val )
      640           .
      641         end.
      642         assign
      643           o-where = substitute( "&1 &2", o-where, v-field-val )
      644         .
      645         if v-word-link = "":U then do:
      646           assign
      647             v-word-link = "and":U
      648           .
      649         end.
      650       end.
      651       delete object bh_tbl-name.
      652       if     bh_tbl-key ne ?
      653       then
      654          delete object bh_tbl-key.
      655       if p-key-handle = ?
      656         and v-count-fld <> v-field-num
      657       then do:
      658         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info5, vTable ).
      659       end.
      660     end.
      661   end procedure.
      662   procedure gen-hn-keyr-tab :
      663     define input  parameter i-tableSerach as character no-undo.
      664     define input  parameter i-tablekey   as character no-undo.
      665     define input  parameter p-key-rec    as character no-undo.
      666     define input  parameter p-key-handle as handle    no-undo .
      667     define input  parameter p-db-name    as character no-undo .
      668     define input  parameter p-tt-handle  as handle    no-undo .
      669     define input  parameter p-stts-lock  as integer   no-undo .
      670     define output parameter o-hn         as handle    no-undo.
      671     define variable v-full-tbl-name as character no-undo.
      672     define variable v-where         as character no-undo.
      673     define variable bh_tbl-name     as handle    no-undo.
      674     define variable vTable          as character no-undo.
      675     do
      676     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      677     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      678     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      679         run gen-where-keyr-tab(i-tableSerach,
      680                                i-tablekey,
      681                                p-key-rec,
      682                                p-key-handle,
      683                                p-db-name,
      684                                p-tt-handle,
      685                                output v-where).
      686         if i-tableSerach ne "" and i-tableSerach ne ?
      687         then do:
      688            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      689            create buffer bh_tbl-name for table v-full-tbl-name .
      690         end.
      691         else do:
      692            if p-tt-handle = ? then do:
      693               assign
      694                  vTable = entry( 1 , p-key-rec, chr(3) )
      695               .
      696               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      697               create buffer bh_tbl-name for table v-full-tbl-name .
      698            end.
      699            else do:
      700               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      701            end.
      702         end.
      703         if p-tt-handle = ? then do:
      704            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      705         end.
      706         else do:
      707            bh_tbl-name:find-first( v-where ) no-error .
      708         end.
      709         o-hn = bh_tbl-name.
      710      end.
      711   end procedure.
      712   procedure gen-hn-keyr :
      713     define input  parameter p-key-rec    as character no-undo.
      714     define input  parameter p-key-handle as handle    no-undo .
      715     define input  parameter p-db-name    as character no-undo .
      716     define input  parameter p-tt-handle  as handle    no-undo .
      717     define input  parameter p-stts-lock  as integer   no-undo .
      718     define output parameter o-hn         as handle    no-undo.
      719     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      720   end.
      721   procedure gen-row-keyr :
      722     define input  parameter p-key-rec    as character no-undo.
      723     define input  parameter p-key-handle as handle    no-undo .
      724     define input  parameter p-db-name    as character no-undo .
      725     define input  parameter p-tt-handle  as handle    no-undo .
      726     define input  parameter p-stts-lock  as integer   no-undo .
      727     define output parameter p-tbl-row    as rowid     no-undo.
      728     define output parameter p-tbl-name   as character no-undo.
      729     define variable vHn as handle no-undo.
      730       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      731       p-tbl-row = if vHn:available then vHn:rowid else ?.
      732       p-tbl-name =  vHn:table.
      733       delete object vHn no-error.
      734     if p-tbl-row = ? then do:
      735       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info5, p-tbl-name, p-key-rec ).
      736     end.
      737     else do:
      738       return.
      739     end.
      740   end procedure.
      741   procedure gen-key-fv :
      742     define input  parameter p-key-rec    as character no-undo .
      743     define output parameter p-field-list as character no-undo .
      744     define output parameter p-value-list as character no-undo.
      745     do
      746     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      747     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      748     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      749     :
      750       define variable v-full-tbl-name  as character no-undo .
      751       define variable bh_tbl-name      as handle    no-undo .
      752       define variable v-tbl-name       as character no-undo .
      753       define variable v-field-num      as integer   no-undo .
      754       define variable v-count-fld      as integer   no-undo .
      755       define variable v-inform         as character no-undo .
      756       define variable v-ind            as integer   no-undo .
      757       define variable v-idx-field-qnty as integer   no-undo .
      758       define variable v-delim-key      as character no-undo .
      759       if p-key-rec = ?
      760         or p-key-rec = "":U
      761       then do:
      762         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info5 ).
      763       end.
      764       assign
      765         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      766         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      767       .
      768       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      769       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info5 ).
      770       assign
      771         v-inform = bh_tbl-name:index-information(1)
      772         v-ind    = 2
      773       .
      774       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      775       on error undo, return error
      776       :
      777         assign
      778           v-inform = bh_tbl-name:index-information( v-ind )
      779           v-ind    = v-ind + 1
      780         .
      781       end.
      782       if v-inform = ?
      783         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      784         or entry( 3, v-inform, ",":U ) <> "1":U
      785       then do:
      786         delete object bh_tbl-name no-error.
      787         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, v-tbl-name ).
      788       end.
      789       assign
      790         v-idx-field-qnty = num-entries( v-inform ) - 4
      791       .
      792       if v-idx-field-qnty < 2 then do:
      793         delete object bh_tbl-name no-error.
      794         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, v-tbl-name ).
      795       end.
      796       assign
      797         p-field-list = "":U
      798         p-value-list = "":U
      799         v-delim-key  = "":U
      800         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      801         v-count-fld  = 0
      802       .
      803       block_where:
      804       do v-ind = 1 to v-idx-field-qnty by 2
      805       on error undo, return error
      806       :
      807         assign
      808           v-count-fld = v-count-fld + 1
      809         .
      810         if v-count-fld > v-field-num then do:
      811           leave block_where.
      812         end.
      813         assign
      814           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      815           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      816         .
      817         if v-ind = 1 then do:
      818           assign
      819             v-delim-key = chr(3)
      820           .
      821         end.
      822       end.
      823       delete object bh_tbl-name.
      824       if v-count-fld <> v-field-num then do:
      825         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info5, v-tbl-name ).
      826       end.
      827     end.
      828   end procedure.
      829   procedure gen-key-field :
      830     define input  parameter p-table      as character no-undo .
      831     define output parameter p-field-list as character no-undo .
      832     do
      833     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      834     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      835     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      836     :
      837       define variable v-full-tbl-name  as character no-undo .
      838       define variable bh_tbl-name      as handle    no-undo .
      839       define variable v-tbl-name       as character no-undo .
      840       define variable v-field-num      as integer   no-undo .
      841       define variable v-count-fld      as integer   no-undo .
      842       define variable v-inform         as character no-undo .
      843       define variable v-ind            as integer   no-undo .
      844       define variable v-idx-field-qnty as integer   no-undo .
      845       define variable v-delim-key      as character no-undo .
      846       if p-table = ?
      847         or p-table = "":U
      848       then do:
      849         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info5 ).
      850       end.
      851       assign
      852         v-tbl-name      = p-table
      853         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      854       .
      855       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      856       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info5 ).
      857       assign
      858         v-inform = bh_tbl-name:index-information(1)
      859         v-ind    = 2
      860       .
      861       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      862       on error undo, return error
      863       :
      864         assign
      865           v-inform = bh_tbl-name:index-information( v-ind )
      866           v-ind    = v-ind + 1
      867         .
      868       end.
      869       if v-inform = ?
      870         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      871         or entry( 3, v-inform, ",":U ) <> "1":U
      872       then do:
      873         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, v-tbl-name ).
      874       end.
      875       assign
      876         v-idx-field-qnty = num-entries( v-inform ) - 4
      877       .
      878       if v-idx-field-qnty < 2 then do:
      879         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, v-tbl-name ).
      880       end.
      881       assign
      882         p-field-list = "":U
      883         v-delim-key  = "":U
      884         v-count-fld  = 0
      885       .
      886       block_where:
      887       do v-ind = 1 to v-idx-field-qnty by 2
      888       on error undo, return error
      889       :
      890         assign
      891           v-count-fld = v-count-fld + 1
      892         .
      893         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      894         if v-ind = 1 then do:
      895           assign
      896             v-delim-key = chr(3)
      897           .
      898         end.
      899       end.
      900       delete object bh_tbl-name.
      901     end.
      902   end procedure.
      903   procedure get-gate-file-name :
      904   define input parameter p-gate-rec as character no-undo .
      905   define output  parameter p-gate-file-name as character no-undo .
      906   define buffer buf_clob-data for ub.clob-data.
      907   define variable v-tbl-row as rowid no-undo .
      908   define variable v-tbl-name as character no-undo .
      909   run gen-row-keyr in this-procedure ( input p-gate-rec
      910                                       ,input ?
      911                                       ,input "ub"
      912                                       ,input ?
      913                                       ,input no-lock
      914                                       ,output v-tbl-row
      915                                       ,output v-tbl-name) no-error.
      916   if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
      917                                                           ,vss-include-info3
      918                                                           ,p-gate-rec).
      919   find first buf_clob-data no-lock where
      920             rowid(buf_clob-data) = v-tbl-row no-error.
      921   if not available buf_clob-data then do:
      922     if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
      923                                                             ,vss-include-info3
      924                                                             ,p-gate-rec).
      925   end.
      926   p-gate-file-name = buf_clob-data.file-name.
      927   end procedure.
      928   procedure get-gate-rec :
      929   define input  parameter p-gate-name as character no-undo .
      930   define output parameter p-gate-rec as character no-undo .
      931   define buffer buf_clob-bind for ub.clob-bind.
      932   define buffer buf_clob-data for ub.clob-data.
      933   main-block:
      934   do
      935   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info3, return-value, chr(10), error-status :get-message (1))
      936   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info3 )
      937   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info3 )
      938   :
      939       find first buf_clob-bind no-lock where
      940                 buf_clob-bind.uniq-key-rec = p-gate-name
      941             and buf_clob-bind.field-name = '':U
      942             and buf_clob-bind.part-num = 1
      943             and buf_clob-bind.resource-type = 'gate':U
      944             no-error.
      945       if not available buf_clob-bind then do:
      946         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
      947                                         , p-gate-name
      948                                         ).
      949       end.
      950       find first buf_clob-data no-lock where
      951                 buf_clob-data.db-num = buf_clob-bind.db-num
      952             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
      953       if not available buf_clob-data then do:
      954         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
      955                                         , buf_clob-bind.db-num
      956                                         , buf_clob-bind.int64-id
      957                                         , p-gate-name
      958                                         ).
      959       end.
      960       run gen-key-rec in this-procedure ( input 'clob-data':U
      961                                 ,input buffer buf_clob-data:handle
      962                                 ,output p-gate-rec).
      963   end.
      964   end procedure.
      965   procedure get-gate-by-name :
      966   define input  parameter p-gate-name as character no-undo .
      967   define output parameter p-gate-rec as character no-undo .
      968   define output parameter p-dsh as handle no-undo .
      969   define input-output  parameter p-xmlh as handle no-undo .
      970   define variable v-ii as integer   no-undo .
      971   define variable glog as logical   no-undo .
      972   define variable v-longchar as longchar no-undo .
      973   define variable v-txmlh as handle no-undo .
      974   define variable v-db-num as integer no-undo .
      975   define variable v-int64-id as int64 no-undo .
      976   define buffer buf_clob-bind for ub.clob-bind.
      977   define buffer buf_clob-data for ub.clob-data.
      978   main-block:
      979   do
      980   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info3, return-value, chr(10), error-status :get-message (1))
      981   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info3 )
      982   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info3 )
      983   :
      984       find first buf_clob-bind no-lock where
      985                 buf_clob-bind.uniq-key-rec = p-gate-name
      986             and buf_clob-bind.field-name = '':U
      987             and buf_clob-bind.part-num = 1
      988             and buf_clob-bind.resource-type = 'gate':U
      989             no-error.
      990       if not available buf_clob-bind then do:
      991         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
      992                                         , p-gate-name
      993                                         ).
      994       end.
      995       find first buf_clob-data no-lock where
      996                 buf_clob-data.db-num = buf_clob-bind.db-num
      997             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
      998       if not available buf_clob-data then do:
      999         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1000                                         , buf_clob-bind.db-num
     1001                                         , buf_clob-bind.int64-id
     1002                                         , p-gate-name
     1003                                         ).
     1004       end.
     1005       assign
     1006       v-longchar = buf_clob-data.cdata
     1007       .
     1008       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1009       if error-status :error then do:
     1010         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1011       end.
     1012       create dataset p-dsh .
     1013       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1014                                     , v-longchar
     1015                                     , ?
     1016                                     , ?
     1017                                     , ?
     1018                                     ) no-error.
     1019       v-longchar = '':U.
     1020       if error-status :error
     1021       or not glog
     1022       then do:
     1023         undo, return error substitute("Не удалось прочитать XML-схему &1 из БД:&2&3", p-gate-name, chr(10), error-status:get-message(1) ).
     1024       end.
     1025       if not valid-handle(p-xmlh)
     1026       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1027         create temp-table v-txmlh.
     1028         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1029         v-txmlh:temp-table-prepare("temp-xml-tables").
     1030         p-xmlh = v-txmlh:default-buffer-handle.
     1031       end.
     1032       run gen-key-rec in this-procedure ( input 'clob-data':U
     1033                                 ,input buffer buf_clob-data:handle
     1034                                 ,output p-gate-rec).
     1035       do v-ii = 1 to p-dsh:num-buffers:
     1036         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1037         if not p-xmlh:available then do:
     1038           p-xmlh:buffer-create().
     1039           assign
     1040           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1041           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1042           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1043           p-xmlh::gate-handle_ = p-dsh
     1044           p-xmlh::uniq-gate-rec = p-gate-rec
     1045           p-xmlh::gate-name = p-dsh:name
     1046           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1047           .
     1048           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1049             assign
     1050             p-xmlh::order = -3.
     1051           end.
     1052         end.
     1053       end.
     1054   end.
     1055   end procedure.
     1056   procedure get-gate-by-rec :
     1057   define input  parameter p-gate-rec as character no-undo .
     1058   define output parameter p-dsh as handle no-undo .
     1059   define input-output  parameter p-xmlh as handle no-undo .
     1060   define input-output parameter p-longchar  as longchar no-undo .
     1061   define variable v-ii as integer   no-undo .
     1062   define variable glog as logical   no-undo .
     1063   define variable v-rowid as rowid no-undo .
     1064   define variable v-tbl-name as character no-undo .
     1065   define variable v-longchar as longchar no-undo .
     1066   define variable v-txmlh as handle no-undo .
     1067   define buffer buf_clob-data for ub.clob-data.
     1068   main-block:
     1069   do
     1070   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info3, return-value, chr(10), error-status :get-message (1))
     1071   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info3 )
     1072   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info3 )
     1073   :
     1074     run gen-row-keyr in this-procedure (
     1075                                           input  p-gate-rec
     1076                                           ,input  ?
     1077                                           ,input  "ub"
     1078                                           ,input  ?
     1079                                           ,input  NO-LOCK
     1080                                           ,output v-rowid
     1081                                           ,output v-tbl-name   ) no-error.
     1082       find first buf_clob-data no-lock where
     1083                 rowid(buf_clob-data) = v-rowid  no-error.
     1084       if not available buf_clob-data then do:
     1085         undo, return error substitute("Не найден CLOB  &1"
     1086                                         , p-gate-rec
     1087                                         ).
     1088       end.
     1089       assign
     1090       v-longchar = buf_clob-data.cdata
     1091       .
     1092       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1093       if error-status :error then do:
     1094         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1095       end.
     1096       create dataset p-dsh .
     1097       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1098                                     , v-longchar
     1099                                     , ?
     1100                                     , ?
     1101                                     , ?
     1102                                     ) no-error.
     1103       define variable v-esm as character no-undo .
     1104       v-esm = error-status:get-message(1) .
     1105       if p-longchar <> ? then do:
     1106         p-longchar = v-longchar.
     1107       end.
     1108       v-longchar = '':U.
     1109       if error-status :error
     1110       or not glog
     1111       then do:
     1112         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     1113                                      , p-gate-rec
     1114                                      , p-gate-rec
     1115                                      , v-esm
     1116                                      ).
     1117       end.
     1118       p-dsh:private-data = buf_clob-data.file-name_ + chr(4) + p-gate-rec.
     1119       if not valid-handle(p-xmlh)
     1120       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1121         create temp-table v-txmlh.
     1122         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1123         v-txmlh:temp-table-prepare("temp-xml-tables").
     1124         p-xmlh = v-txmlh:default-buffer-handle.
     1125       end.
     1126       do v-ii = 1 to p-dsh:num-buffers:
     1127         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1128         if not p-xmlh:available then do:
     1129           p-xmlh:buffer-create().
     1130           assign
     1131           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1132           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1133           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1134           p-xmlh::gate-handle_ = p-dsh
     1135           p-xmlh::uniq-gate-rec = p-gate-rec
     1136           p-xmlh::gate-name = p-dsh:name
     1137           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1138           .
     1139           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1140             assign
     1141             p-xmlh::order = -3.
     1142           end.
     1143           p-xmlh:buffer-release().
     1144         end.
     1145       end.
     1146   end.
     1147   end procedure.
     1148   procedure get-gate-by-file :
     1149   define input  parameter p-schema-file-name as character no-undo .
     1150   define input  parameter p-gate-rec as character no-undo .
     1151   define output parameter p-dsh as handle no-undo .
     1152   define input-output  parameter p-xmlh as handle no-undo .
     1153   define variable v-ii as integer   no-undo .
     1154   define variable glog as logical   no-undo .
     1155   define variable v-rowid as rowid no-undo .
     1156   define variable v-tbl-name as character no-undo .
     1157   define variable v-longchar as longchar no-undo .
     1158   define variable v-txmlh as handle no-undo .
     1159   main-block:
     1160   do
     1161   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info3, return-value, chr(10), error-status :get-message (1))
     1162   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info3 )
     1163   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info3 )
     1164   :
     1165       COPY-LOB
     1166       FROM  FILE p-schema-file-name
     1167       TO  OBJECT v-longchar
     1168       no-convert
     1169       NO-ERROR .
     1170       if error-status :error then do:
     1171           undo, return error substitute("Не удалось считать файл схемы &1 в память&2&3"
     1172                                     , p-schema-file-name
     1173                                 , chr(10)
     1174                                 , error-status:get-message(1) ).
     1175       end.
     1176       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1177       if error-status :error then do:
     1178         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, p-schema-file-name, chr(10), error-status:get-message(1) , return-value ).
     1179       end.
     1180       create dataset p-dsh .
     1181       glog = p-dsh:READ-XMLSCHEMA( "longchar"
     1182                                     , v-longchar
     1183                                     , ?
     1184                                     , ?
     1185                                     , ?
     1186                                     ) no-error.
     1187       v-longchar = ''.
     1188       if error-status :error
     1189       or not glog
     1190       then do:
     1191         undo, return error substitute("Не удалось прочитать XML-схему из файла &1&2&3"
     1192                                      , p-schema-file-name
     1193                                      ,chr(10)
     1194                                      , error-status:get-message(1)
     1195                                      ).
     1196       end.
     1197       if not valid-handle(p-xmlh)
     1198       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1199         create temp-table v-txmlh.
     1200         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1201         v-txmlh:temp-table-prepare("temp-xml-tables").
     1202         p-xmlh = v-txmlh:default-buffer-handle.
     1203       end.
     1204       do v-ii = 1 to p-dsh:num-buffers:
     1205         p-xmlh:find-first(substitute(' where tbl-name = "&1" and  uniq-gate-rec = "&2" '
     1206                                      ,p-dsh:get-buffer-handle(v-ii):name
     1207                                      ,p-gate-rec
     1208                                      )) no-error.
     1209         if not p-xmlh:available then do:
     1210           p-xmlh:buffer-create().
     1211           assign
     1212           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):table
     1213           p-xmlh::uniq-gate-rec = p-gate-rec
     1214           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1215           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1216           p-xmlh::gate-handle_ = p-dsh
     1217           p-xmlh::gate-name = p-dsh:name
     1218           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1219           .
     1220           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1221             assign
     1222             p-xmlh::order = -3.
     1223           end.
     1224           p-xmlh:buffer-release().
     1225         end.
     1226       end.
     1227   end.
     1228   end procedure.
     1229   procedure gate-clear :
     1230   define input  parameter p-dsh as handle no-undo .
     1231   define input  parameter p-xmlh as handle no-undo .
     1232   define variable v-dsh as handle no-undo .
     1233   define variable v-th as handle no-undo .
     1234     do
     1235     on error undo, return error return-value
     1236     :
     1237       if valid-handle(p-dsh) then do:
     1238         delete object p-dsh.
     1239         v-dsh = p-dsh.
     1240         p-dsh = ?.
     1241       end.
     1242       repeat while true:
     1243         p-xmlh:find-first( substitute( " where gate-handle_ = &1 ", v-dsh)
     1244                            , share-lock) no-error.
     1245         if p-xmlh:available then do:
     1246           assign
     1247           v-th = p-xmlh:buffer-field("table-handle_"):buffer-value.
     1248           if valid-handle(p-xmlh:buffer-field("table-handle_"))
     1249           and valid-handle(v-th)
     1250           and v-th:dynamic = yes
     1251           then do:
     1252             delete object p-xmlh:buffer-field("table-handle_"):buffer-value.
     1253             p-xmlh:buffer-field("table-handle_"):buffer-value = ?.
     1254           end.
     1255           p-xmlh:buffer-delete().
     1256         end.
     1257         else do:
     1258           leave.
     1259         end.
     1260       end.
     1261       if p-xmlh:dynamic = yes
     1262       and valid-handle(p-xmlh)
     1263       then do:
     1264         delete object p-xmlh:table-handle.
     1265         p-xmlh = ?.
     1266       end.
     1267       v-dsh = ?.
     1268     end.
     1269   end procedure.
     1270   procedure all-gates-clear :
     1271   define parameter buffer buf_temp-xml-tables for temp-xml-tables.
     1272   do
     1273   on error undo, return error
     1274   :
     1275     for each buf_temp-xml-tables
     1276     break
     1277     by buf_temp-xml-tables.uniq-gate-rec
     1278     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1279     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1280     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1281     :
     1282         if first-of(buf_temp-xml-tables.uniq-gate-rec) then do:
     1283           delete object buf_temp-xml-tables.gate-handle_.
     1284           buf_temp-xml-tables.gate-handle_ = ?.
     1285         end.
     1286         if valid-handle(buf_temp-xml-tables.table-handle_)
     1287         and buf_temp-xml-tables.table-handle_:dynamic = no
     1288         then do:
     1289           delete object buf_temp-xml-tables.table-handle_.
     1290           buf_temp-xml-tables.table-handle_ = ?.
     1291         end.
     1292         delete buf_temp-xml-tables.
     1293     end.
     1294   end.
     1295   end procedure.
     1296   procedure fix-schemalocation :
     1297   define input-output  parameter p-longchar as longchar no-undo .
     1298   DEFINE VARIABLE hdoc AS HANDLE.
     1299   DEFINE VARIABLE hroot AS HANDLE.
     1300   DEFINE VARIABLE hnode-child AS HANDLE.
     1301   DEFINE VARIABLE hnode-attr AS HANDLE.
     1302   define variable v-jj as integer   no-undo .
     1303   define variable ok as logical   no-undo .
     1304   define variable v-path1                    as character                no-undo .
     1305   DEFINE VARIABLE v-full-path1               as character                no-undo .
     1306   DEFINE VARIABLE v-file-name1               as character                no-undo .
     1307   DEFINE VARIABLE v-file-name-no-ext1        as character                no-undo .
     1308   DEFINE VARIABLE v-file-name-ext1           as character                no-undo .
     1309   define variable v-schema-location          as character                no-undo .
     1310   do
     1311   on error undo, return error return-value
     1312   :
     1313     CREATE X-DOCUMENT hdoc.
     1314     CREATE X-noderef hroot.
     1315     CREATE X-noderef hnode-child.
     1316     CREATE X-noderef hnode-attr.
     1317     hdoc:load("longchar", p-longchar, no) no-error.
     1318     iF ERROR-STATUS:GET-MESSAGE(1) <> '' THEN message ERROR-STATUS:GET-MESSAGE(1) view-as alert-box .
     1319     hdoc:get-document-element(hroot).
     1320     _repeat:
     1321     REPEAT v-jj = 1 TO hroot:NUM-CHILDREN:
     1322       ok = hroot:GET-CHILD(hNode-Child, v-jj).
     1323       if not ok then next.
     1324       if hNode-Child:local-name = "include"
     1325       then do:
     1326         ok = hNode-Child:GET-ATTRIBUTE-NODE( hnode-attr, "schemaLocation" ).
     1327           v-schema-location = hnode-attr:node-value.
     1328           run gbl/filename.p (
     1329                           input "exe/" + hnode-attr:node-value
     1330                         ,output v-full-path1
     1331                         ,output v-path1
     1332                         ,output v-file-name1
     1333                         ,output v-file-name-no-ext1
     1334                         ,output v-file-name-ext1
     1335                         ) no-error .
     1336           if error-status :error then do:
     1337             delete object hnode-attr.
     1338             delete object hnode-child.
     1339             delete object hroot.
     1340             delete object hdoc.
     1341             undo, return error substitute("Не удалось определить расположение схемы &1", v-schema-location).
     1342           end.
     1343         ok = hNode-Child:sET-ATTRIBUTE(  "schemaLocation", v-full-path1 ).
     1344         leave  _repeat.
     1345       end.
     1346     END.
     1347     hdoc:save("longchar", p-longchar).
     1348     delete object hnode-attr.
     1349     delete object hnode-child.
     1350     delete object hroot.
     1351     delete object hdoc.
     1352   end.
     1353   end procedure.
     1354   procedure gate-clb_fill-xml-tables :
     1355   define input parameter p-dsh as handle no-undo .
     1356   define input-output parameter p-xmlh as handle no-undo .
     1357   define variable v-ii as integer no-undo .
     1358     do
     1359     on error undo, return error
     1360     :
     1361       do v-ii = 1 to p-dsh:num-buffers:
     1362         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1363         if not p-xmlh:available then do:
     1364           p-xmlh:buffer-create().
     1365           assign
     1366           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1367           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1368           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1369           p-xmlh::gate-handle_ = p-dsh
     1370           p-xmlh::uniq-gate-rec = entry(2, p-dsh:private-data, chr(4))
     1371           p-xmlh::gate-name = p-dsh:name
     1372           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1373           .
     1374           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1375             assign
     1376             p-xmlh::order = -3.
     1377           end.
     1378           p-xmlh:buffer-release().
     1379         end.
     1380       end.
     1381     end.
     1382   end procedure.
     1383   procedure all-gates-empty :
     1384   define buffer buf_temp-xml-tables for temp-xml-tables.
     1385   do
     1386   on error undo, return error
     1387   :
     1388     for each buf_temp-xml-tables
     1389     break
     1390     by buf_temp-xml-tables.uniq-gate-rec
     1391     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1392     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1393     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1394     :
     1395       if valid-handle(buf_temp-xml-tables.tbl-handle_) then do:
     1396         buf_temp-xml-tables.tbl-handle_:empty-temp-table().
     1397       end.
     1398     end.
     1399   end.
     1400   end procedure.
     1401   def var vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1402   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1403   define temp-table THpck-sent no-undo
     1404   field THfilename as character field THcrc-pack as character field THcredate as date field THcrenum as integer  field THcretimeint as integer field THcretime as character   field THrcvddate  as date field THpack-num  as integer  field THrcvdtimeint as integer field THrcvdtime  as character   field THrcvd  as logical      field THsendtxtdate as date field THsendtxttimeint as integer field THsendtxttime as character  field THtotal-recs  as integer  field THesys-id  as integer     index pi is unique primary THesys-id                  THpack-num                 index ircvd                THesys-id                  THrcvd
     1405   .
     1406   define temp-table THcurr-pack no-undo
     1407   field THfilename as character field THcrc-pack as character field THcredate as date field THcrenum as integer  field THcretimeint as integer field THcretime as character   field THrcvddate  as date field THpack-num  as integer  field THrcvdtimeint as integer field THrcvdtime  as character   field THrcvd  as logical      field THsendtxtdate as date field THsendtxttimeint as integer field THsendtxttime as character  field THtotal-recs  as integer  field THesys-id  as integer     index pi is unique primary THesys-id                  THpack-num                 index ircvd                THesys-id                  THrcvd
     1408   .
     1409   define temp-table THpck-rcvd no-undo
     1410   field THfilename as character
     1411   field THesys-id  as integer
     1412   field THcrc-pack as character
     1413   field THpack-num  as integer
     1414   field THrcvd-recs  as integer
     1415   field THrcvd as logical
     1416   field THtotal-recs  as integer
     1417   field THrcvddate  as date
     1418   field THrcvdtimeint as integer
     1419   field THrcvdtime  as character
     1420   index pi is unique primary
     1421   THesys-id
     1422   THpack-num
     1423   index rcvd
     1424   THesys-id
     1425   THrcvd
     1426   .
     1427   procedure get-header-by-rec :
     1428   define input  parameter p-gate-rec as character no-undo .
     1429   define output parameter p-tth as handle no-undo .
     1430   define variable v-ii as integer   no-undo .
     1431   define variable glog as logical   no-undo .
     1432   define variable v-rowid as rowid no-undo .
     1433   define variable v-tbl-name as character no-undo .
     1434   define variable v-longchar as longchar no-undo .
     1435   define variable v-txmlh as handle no-undo .
     1436   define buffer buf_clob-data for ub.clob-data.
     1437   main-block:
     1438   do
     1439   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info7, return-value, chr(10), error-status :get-message (1))
     1440   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info7 )
     1441   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info7 )
     1442   :
     1443     run gen-row-keyr in  this-procedure  (
     1444                                           input  p-gate-rec
     1445                                           ,input  ?
     1446                                           ,input  "ub"
     1447                                           ,input  ?
     1448                                           ,input  NO-LOCK
     1449                                           ,output v-rowid
     1450                                           ,output v-tbl-name   ) no-error.
     1451       find first buf_clob-data no-lock where
     1452                 rowid(buf_clob-data) = v-rowid  no-error.
     1453       if not available buf_clob-data then do:
     1454         undo, return error substitute("Не найден CLOB  &1"
     1455                                         , p-gate-rec
     1456                                         ).
     1457       end.
     1458       assign
     1459       v-longchar = buf_clob-data.cdata
     1460       .
     1461       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1462       if error-status :error then do:
     1463         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1464       end.
     1465       create temp-table p-tth .
     1466       glog = p-tth:READ-XMLSCHEMA( "LONGCHAR"
     1467                                     , v-longchar
     1468                                     , ?
     1469                                     , ?
     1470                                     , ?
     1471                                     ) no-error.
     1472       v-longchar = '':U.
     1473       define variable v-esm as character no-undo .
     1474       v-esm = error-status:get-message(1).
     1475       if error-status :error
     1476       or not glog
     1477       then do:
     1478         delete object p-tth no-error.
     1479         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     1480                                    , p-gate-rec
     1481                                    , buf_clob-data.file-name_
     1482                                    , chr(10)
     1483                                    , v-esm
     1484                                     ).
     1485       end.
     1486   end.
     1487   end procedure.
     1488   define new global shared variable g#lib-gate as handle no-undo .
