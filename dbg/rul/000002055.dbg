     1555   function context_begin-esys-command return logical
     1556   (
     1557       input p-esys-id-list as character
     1558      ,input-output p-esys-cmd-proc-handle as handle
     1559      ,output p-esys-cmd-code as integer
     1560   ):
     1561      if not valid-handle(p-esys-cmd-proc-handle )
     1562      then do:
     1563        run nws/cmd-bush.p persistent set p-esys-cmd-proc-handle no-error .
     1564        if error-status :error
     1565        then do:
     1566           delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( substitute("&1 &2 &3&4Ошибка при запуске процедуры cmd-bush.p&4" +
     1567                                              "&5&4&6"
     1568                                              ,vss-workfile
     1569                                              ,vss-revision
     1570                                              ,vss-description
     1571                                              ,chr(10)
     1572                                              ,error-status:get-message(1)
     1573                                              ,return-value )).
     1574        end.
     1575        run begin-create-command in p-esys-cmd-proc-handle
     1576          (input 'cmd-esys-general':U
     1577          ,input p-esys-id-list
     1578          ,output p-esys-cmd-code
     1579          ) no-error.
     1580        if error-status :error
     1581        then do:
     1582          delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при создании команды &1&2&3&1&4"
     1583                                                           , 'cmd-esys-general':U
     1584                                                           , error-status:get-message(1)
     1585                                                           , return-value
     1586                                                           )).
     1587          return no .
     1588        end.
     1589        return yes.
     1590      end.
     1591   end.
     1592   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1593   function context_send-esys-command return logical
     1594   (
     1595       input p-esys-id-list as character
     1596      ,input p-esys-cmd-proc-handle as handle
     1597      ,input p-esys-cmd-code as integer
     1598      ,input p-user-id as character
     1599   ):
     1600      define variable v-dmp-ord-int64 as int64 no-undo .
     1601      if valid-handle(p-esys-cmd-proc-handle )
     1602      then do:
     1603         run send-command-esys in p-esys-cmd-proc-handle
     1604             (input p-esys-cmd-code
     1605             ,input p-esys-id-list
     1606             ,input p-user-id
     1607             ,output v-dmp-ord-int64
     1608             ) no-error.
     1609         if error-status :error
     1610         then do:
     1611            delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при отсылке во внешнюю систему &1 команды с кодом &2&3&4&3&5"
     1612                                                           , p-esys-id-list
     1613                                                           , p-cmd-code
     1614                                                           , chr(10)
     1615                                                           , error-status:get-message(1)
     1616                                                           , return-value
     1617                                                           )).
     1618            return no .
     1619         end.
     1620         delete procedure p-esys-cmd-proc-handle no-error.
     1621         return yes.
     1622      end.
     1623      else do:
     1624         delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при отсылке во внешнюю систему &1 команды с кодом &2&3&4&3&5"
     1625                                                       , p-esys-id-list
     1626                                                       , p-cmd-code
     1627                                                       , chr(10)
     1628                                                       , error-status:get-message(1)
     1629                                                       , return-value
     1630                                                       )).
     1631         return no .
     1632      end.
     1633   end.
     1634   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1635   function context_delete-command return logical
     1636   (
     1637       input p-esys-cmd-proc-handle as handle
     1638      ,input p-esys-cmd-code as integer
     1639   ):
