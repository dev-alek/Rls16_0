     1643             (input p-esys-cmd-code
     1644             ) no-error.
     1645         if error-status :error
     1646         then do:
     1647            delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при удалении команды с кодом &1&2&3&2&4"
     1648                                                              , p-cmd-code
     1649                                                              , chr(10)
     1650                                                              , error-status:get-message(1)
     1651                                                              , return-value
     1652                                                              )).
     1653            return no .
     1654         end.
     1655         delete procedure p-esys-cmd-proc-handle no-error.
     1656         return yes.
     1657      end.
     1658      else do:
     1659         delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при удалении команды с кодом &1&2&3&2&4"
     1660                                                       , p-cmd-code
     1661                                                       , chr(10)
     1662                                                       , error-status:get-message(1)
     1663                                                       , return-value
     1664                                                       )).
     1665         return no .
     1666      end.
     1667   end.
     1668   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1669   function context_set-esys-command-action return logical
     1670   (
     1671       input p-esys-cmd-proc-handle as handle
     1672      ,input p-esys-cmd-code as integer
     1673      ,input p-action as character
     1674   ):
     1675      if valid-handle(p-esys-cmd-proc-handle )
     1676      then do:
     1677         run set-esys-command-action in p-esys-cmd-proc-handle
     1678            (
     1679              input p-esys-cmd-code
     1680             ,input p-action
     1681             ) no-error.
     1682         if error-status :error
     1683         then do:
     1684            delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при установке кода действия команды &1 маршрутизации во внешнюю систему &2&3&2&4"
     1685                                                        , p-cmd-code
     1686                                                        , chr(10)
     1687                                                        , error-status:get-message(1)
     1688                                                        , return-value
     1689                                                        )).
     1690            return no .
     1691         end.
     1692         return yes.
     1693      end.
     1694      else do:
     1695         delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при установке кода действия команды &1 команды маршрутизации во внешнюю систему &2Процедура маршрутизации еще не запущена"
     1696                                                       , p-cmd-code
     1697                                                       , chr(10)
     1698                                                       )).
     1699         return no .
     1700      end.
     1701   end.
     1702   on delete of this-procedure do:
     1703     run garbcoll_clear in this-procedure .
     1704   end.
     1705   run load-ruleset-context in this-procedure ( input p-ruleset-id) no-error.
     1706   if error-status:error then do:
     1707     undo, return error return-value .
     1708   end.
     1709   if return-value = "return" then return ''.
     1710   define variable ExpData1 as class Route-data_ no-undo .
     1711   if (valid-handle(g#lib-gate) <> true) then do:   run gbl/lib-gate.p persistent no-error .   if error-status :error or (valid-handle(g#lib-gate) <> true) then do:     message       "Error starting gbl/lib-gate.p" skip       g#lib-gate skip       g#lib-gate :type skip       g#lib-gate :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-gate_route-data_ in g#lib-gate
     1712   (
     1713      input parparentproc
     1714     ,input p-parent-handle
     1715     ,input p-log-handle
     1716     ,input this-procedure:handle
     1717     ,output ExpData1
     1718   )
     1719         .
     1720   if not this-procedure:persistent then do:
     1721     run proc-main in this-procedure no-error .
     1722     if error-status:error then do:
     1723       v-esm = error-status :get-message (1).
     1724       v-es = error-status:error .
     1725       v-rv = return-value .
     1726     end.
     1727     if v-es then do:
     1728         run garbcoll_clear in this-procedure .
     1729         undo, return error substitute( "&1. &2&3&4", vss-workfile, v-rv, chr(10), v-esm).
     1730     end.
     1731     run garbcoll_clear in this-procedure .
     1732   end.
     1733   procedure proc-main :
     1734   _main:
     1735   do
     1736   on error undo, return error substitute( "&1&2&3&2&4", return-value, chr(10), error-status :get-message (1), v-last-error-message)
     1737   :
     1738   define variable v-err as logical no-undo .
     1739   define variable v-gds-code as integer no-undo .
     1740   define variable v-fact-qnty as decimal no-undo .
     1741   define variable v-free-qnty as decimal no-undo .
     1742   define buffer buf_gds-obj for ub.gds-obj.
     1743     IF  ExpData1:route-data_push-xmlschema( INPUT p-xsd-file ) = false  THEN do:
     1744       undo _main, return error v-last-error-message .
     1745     end.
     1746     IF  context_begin-esys-command( input v-esys-id-list
     1747                                   , input-output v-esys-cmd-proc-handle
     1748                                   , output v-esys-cmd-code) = false  THEN do:
     1749       undo _main, return error v-last-error-message .
     1750     end.
     1751     IF  context_set-esys-command-action (
     1752                                     input v-esys-cmd-proc-handle
     1753                                   , input v-esys-cmd-code
     1754                                   , input 'command-pbush':U
     1755                                   ) = false  THEN do:
     1756       undo _main, return error v-last-error-message .
     1757     end.
     1758     v-gds-code = v-newbh:buffer-field("gds-code"):buffer-value.
     1759     v-fact-qnty = v-newbh:buffer-field("fact-qnty"):buffer-value.
     1760     v-free-qnty = v-newbh:buffer-field("free-qnty"):buffer-value.
     1761       ExpData1:route-data_create-record( INPUT "goods") .
     1762     IF ExpData1:esys-add-dump( INPUT "counts", INPUT v-esys-cmd-proc-handle, INPUT v-esys-cmd-code, '_dump-order=Rec_ID') = false  THEN do:
     1763       v-err-mess = substitute("Ошибка при маршрутизации записи остатков по товару с кодом  &1 в &2&3:&4&6"
     1764                               , v-gds-code
     1765                               , v-obj-type
     1766                               , v-obj-code
     1767                               , chr(10)
     1768                               , v-last-error-message
     1769                               ).
     1770       undo _main, return error v-last-error-message .
     1771     end.
     1772     ExpData1:route-data_copy-field-character( INPUT "counts", "REC_ID", INPUT  string(0)) .
     1773     ExpData1:route-data_copy-field-integer( INPUT "counts", "GoodsID", INPUT  v-gds-code ) .
     1774     ExpData1:route-data_copy-field-character( INPUT "counts", "Action", INPUT  'U':U) .
     1775     ExpData1:route-data_copy-field-integer( INPUT "counts", "storeid", v-obj-type-code) .
     1776     ExpData1:route-data_copy-field-decimal( INPUT "counts", "counts", INPUT  v-fact-qnty ) .
     1777     ExpData1:route-data_copy-field-decimal( INPUT "counts", "reserve", INPUT  v-fact-qnty  - v-free-qnty) .
     1778     IF ExpData1:esys-add-dump( INPUT "counts", INPUT v-esys-cmd-proc-handle, INPUT v-esys-cmd-code, '+update') = false  THEN do:
     1779       v-err-mess = substitute("Ошибка при маршрутизации остатков для товара &1:&2&3"
     1780                               , v-gds-code
     1781                               , chr(10)
     1782                               , v-last-error-message
     1783                               ).
     1784       undo _main, return error ''.
     1785     end.
     1786     IF  context_send-esys-command( input v-esys-id-list
     1787                                 , input v-esys-cmd-proc-handle
     1788                                 , input v-esys-cmd-code
     1789                                 , input g#userid) = false  THEN do:
     1790       undo _main, return error v-last-error-message .
     1791     end.
     1792       ExpData1:Route-data_clear-data ( ) .
     1793   end.
     1794   end procedure.
     1795   procedure load-ruleset-context :
     1796   define input parameter p-ruleset-id as integer no-undo .
     1797   define variable v-flag as logical no-undo .
     1798   define variable v-ii as integer no-undo .
     1799   define variable v-changes-list2 as character no-undo .
     1800   define variable v-obj-uniq-key-rec as character no-undo .
     1801   define buffer buf_rule-call-param for ub.rule-call-param.
     1802   define buffer buf_ext-system for ub.ext-system.
     1803   define buffer buf_ext-classif for ub.ext-classif.
     1804   define buffer buf_clients for ub.clients.
     1805   do
     1806   on error undo, return error
     1807   :
     1808     assign
     1809     v-oldbh = widget-handle (entry(2, p-doc-code, chr(4)))
     1810     v-newbh = widget-handle (entry(3, p-doc-code, chr(4)))
     1811     v-changes-list = entry(4, p-doc-code, chr(4))
     1812     file-name  = p-process-file-name
     1813     v-has-oldbh = valid-handle(v-oldbh) and v-oldbh:available
     1814     v-has-newbh = valid-handle(v-newbh) and v-newbh:available
     1815     .
     1816     if not v-has-newbh then do:
     1817       undo, return error substitute("Не определен новый буфер").
     1818     end.
     1819     if not v-has-newbh
     1820     and not v-has-oldbh then do:
     1821       undo, return error substitute("Не определено ни одного буфера - ни старый, ни новый").
     1822     end.
     1823     if not v-has-oldbh
     1824     and v-changes-list  = '' then do:
     1825        undo, return error substitute("Не определен старый буфер и список изменений").
     1826     end.
     1827     case p-ruleset-id:
     1828       when 8 then do:
     1829         if v-has-newbh
     1830         and v-newbh:table <> 'gds-obj':U then do:
     1831           undo, return error substitute("Передан неверный буфер вместо буфера для &1",  'gds-obj':U).
     1832         end.
     1833       end.
     1834     end case.
     1835     if v-changes-list = '' then do:
     1836       v-changes-list2 = "fact-qnty,free-qnty".
     1837       do v-ii = 1 to num-entries(v-changes-list2 ):
     1838         if v-oldbh:buffer-field(entry(v-ii, v-changes-list2)):buffer-value <> v-newbh:buffer-field(entry(v-ii, v-changes-list2)):buffer-value then do:
     1839            v-flag = yes.
     1840            leave.
     1841         end.
     1842       end.
     1843       if not v-flag then return "return".
     1844     end.
     1845     else do:
     1846       if lookup("fact-qnty", v-changes-list) = 0
     1847       and lookup("free-qnty", v-changes-list) = 0
     1848       then do:
     1849         return 'return'.
     1850       end.
     1851     end.
     1852     assign
     1853     v-obj-type = v-newbh::obj-type
     1854     v-obj-code = v-newbh::obj-code
     1855     .
     1856     v-obj-type-code = (if v-obj-type = 'скл':U then 100000 else 0) + v-obj-code.
     1857     find first buf_clients no-lock where
     1858               buf_clients.obj-type = v-obj-type
     1859           and buf_clients.obj-code = v-obj-code.
     1860     run gen-key-rec in this-procedure ( input 'clients':U
     1861                                       ,input buffer buf_clients:handle
     1862                                       ,output v-obj-uniq-key-rec).
     1863     for each buf_rule-call-param no-lock where
     1864     buf_rule-call-param.codex_id = p-codex-id
     1865     and buf_rule-call-param.ruleset_id = p-ruleset-id
     1866     and buf_rule-call-param.call_id = p-call-id
     1867     and buf_rule-call-param.order_id = p-order-id
     1868     and buf_rule-call-param.rule_id = p-rule-id
     1869     and buf_rule-call-param.param-name = "p-esys-id-list",
     1870       first buf_ext-system no-lock where
     1871             buf_Ext-system.esys-id = buf_rule-call-param.param-value-integer
     1872         and buf_Ext-system.db-num = 0
     1873         and buf_Ext-system.esys-have-export = yes
     1874         and buf_Ext-system.esys-db-num-exp = g#db-num:
     1875       find first buf_ext-classif no-lock where
     1876           buf_ext-classif.classif-name = 'clients-esys':U
     1877       and buf_ext-classif.classif-subject = 'clients':U
     1878       and buf_ext-classif.db-num = 0
     1879       and buf_Ext-classif.uniq-key-rec = v-obj-uniq-key-rec
     1880       and buf_ext-classif.key#_one = buf_ext-system.esys-id no-error.
     1881       if not available buf_ext-classif then next .
     1882       v-esys-id-list = v-esys-id-list + (if v-esys-id-list = '' then '' else chr(1)) + string(buf_ext-system.esys-id).
     1883     end.
     1884     if v-esys-id-list = '' then return "return".
     1885     find first buf_rule-call-param no-lock where
     1886   buf_rule-call-param.codex_id = p-codex-id
     1887   and buf_rule-call-param.ruleset_id = p-ruleset-id
     1888   and buf_rule-call-param.call_id = p-call-id
     1889   and buf_rule-call-param.order_id = p-order-id
     1890   and buf_rule-call-param.rule_id = p-rule-id
     1891   and buf_rule-call-param.param-name = "p-xsd-file"
     1892    no-error.
     1893   if available buf_rule-call-param then do:
     1894     assign p-xsd-file = buf_rule-call-param.param-value-character.
     1895   end.
     1896   end.
     1897   end procedure.
