        1   DEFINE BUFFER X_prop-head FOR ub.prop-head.
        2   DEFINE BUFFER X_prop-ruleset FOR ub.prop-ruleset.
        3   define input parameter parparentproc as widget-handle no-undo .
        4   define input parameter bttns as character no-undo.
        5   DEFINE INPUT PARAMETER p-list-mode AS CHARACTER NO-UNDO.
        6   DEFINE INPUT PARAMETER p-codex-id AS INTEGER NO-UNDO.
        7   DEFINE INPUT PARAMETER p-ruleset-id AS INTEGER NO-UNDO.
        8   DEFINE INPUT PARAMETER p-dtm-code AS INTEGER NO-UNDO.
        9   define input-output parameter p-rid-list as character no-undo.
       10   define variable vss-revision    as character no-undo init "$Revision$":U .
       11   define variable vss-author      as character no-undo init "$Author$":U .
       12   define variable vss-date        as character no-undo init "$Date$":U .
       13   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       14   define variable vss-archive     as character no-undo init "$Archive$":U .
       15   define variable vss-description as character no-undo init "Список prop-ruleset".
       16   procedure vss-get-info :
       17     define output parameter p-vss-revision    like vss-revision    no-undo .
       18     define output parameter p-vss-author      like vss-author      no-undo .
       19     define output parameter p-vss-date        like vss-date        no-undo .
       20     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       21     define output parameter p-vss-archive     like vss-archive     no-undo .
       22     define output parameter p-vss-description like vss-description no-undo .
       23     assign
       24       p-vss-revision    = vss-revision
       25       p-vss-author      = vss-author
       26       p-vss-date        = vss-date
       27       p-vss-workfile    = vss-workfile
       28       p-vss-archive     = vss-archive
       29       p-vss-description = vss-description
       30     .
       31   end procedure.
       32   procedure vss-get-parameters :
       33     define output parameter p-vss-parameters as character no-undo .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       71   define variable v-waitfram-action01         as character   no-undo .
       72   define variable v-waitfram-action02         as character   no-undo .
       73   define variable v-waitfram-action03         as character   no-undo .
       74   define variable mWaitFramTextBeg            as character   no-undo.
       75   define variable mWaitFramTextEnd            as character   no-undo.
       76   define variable mWaitFramView               as logical     no-undo.
       77   define variable mWaitProcEvent              as logical     no-undo init yes.
       78   define variable mWaitFramInterval           as integer     no-undo init 1 .
       79   define variable mWaitFramStop               as logical     no-undo.
       80   define variable mWaitFramStopUser           as logical     no-undo.
       81   define variable mWaitFramStopTimeOut        as logical     no-undo.
       82   define variable mWaitFramStartProc          as datetime-tz no-undo.
       83   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       84   define button B-WaitFramStop auto-end-key
       85        label "Стоп"
       86        size 10 by 1 tooltip "Остоновить процесс".
       87   define button B-viewProcInfo
       88        label "Информация"
       89        size 15 by 1 tooltip "Информация о процесс".
       90   define frame waitfram
       91     v-waitfram-action01 format "x(72)" no-label skip
       92     v-waitfram-action02 format "x(72)" no-label skip
       93     v-waitfram-action03 format "x(72)" no-label skip
       94     B-viewProcInfo
       95     B-WaitFramStop at row 4 col 30
       96     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       97     .
       98   define new global shared variable mBatchMode as logical no-undo init ?.
       99   define variable mFramBachModHandle as handle no-undo.
      100   mFramBachModHandle = frame waitfram:handle.
      101   define variable mFameOldVis as logical no-undo.
      102   define variable mVisCUrentVin as logical no-undo.
      103   if session:batch-mode
      104   then
      105      mBatchMode = yes.
      106   if mBatchMode = ? then do:
      107     mVisCUrentVin = current-window:visible.
      108     mFameOldVis = mFramBachModHandle:visible.
      109     mFramBachModHandle:visible  = yes.
      110     mBatchMode = mFramBachModHandle:visible ne yes.
      111     mFramBachModHandle:visible = mFameOldVis.
      112     current-window:visible = mVisCUrentVin.
      113   end.
      114    if  log-manager:logfile-name ne ?
      115     then DO:
      116         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      117         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      118         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      119     end.
      120   on choose of B-WaitFramStop in frame waitfram
      121   do:
      122     mWaitFramStop = yes.
      123     mWaitFramStopUser = yes.
      124   end.
      125   function waitfram-check-timeout returns logical():
      126      define variable vtime as int64 no-undo.
      127      if mWaitFramStopTimeOut
      128      then
      129         return yes.
      130      vtime = ( now - mWaitFramStartProc ) / 1000 .
      131      if     mWaitFramTimeOut ne ?
      132         and mWaitFramTimeOut ne 0
      133         and mWaitFramTimeOut lt vtime
      134      then do:
      135         mWaitFramStopTimeOut = yes.
      136      end.
      137      return mWaitFramStopTimeOut.
      138   end.
      139   procedure waitfram-hide :
      140     if not session:batch-mode
      141     then do
      142     on error undo, return error return-value
      143     :
      144       pause 0 before-hide .
      145       if not mBatchMode then
      146         hide frame waitfram .
      147     if     not mWaitFramView
      148        and mWaitProcEvent
      149     then
      150       process events .
      151     end.
      152   end procedure.
      153   procedure waitfram-show :
      154     define input  parameter p-message as character no-undo .
      155     define variable v-left-margin as integer   no-undo .
      156     if not session:batch-mode
      157     then do
      158     on error undo, return error return-value
      159     :
      160       if length(p-message) <= 70 then do:
      161         assign
      162           v-left-margin = integer((70 - length(p-message)) / 2)
      163         .
      164         assign
      165           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      166         .
      167         assign
      168           v-waitfram-action01 = " "
      169           v-waitfram-action02 = " "
      170                                    + fill(" ", v-left-margin)
      171                                    + p-message
      172           v-waitfram-action03 = " "
      173         .
      174       end.
      175       else do:
      176         define variable vRindex1 as integer no-undo.
      177         define variable vRindex2 as integer no-undo.
      178         vRindex1 = r-index(p-message," ",70).
      179         if vRindex1 = 0
      180         then
      181            vRindex1 = 70.
      182         if length(p-message)  <= vRindex1 + 70 then do:
      183           assign
      184             v-waitfram-action01 = " "
      185             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      186             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      187           .
      188         end.
      189         else do:
      190           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      191           if vRindex2 <= vRindex1
      192           then
      193              vRindex2 = vRindex1 + 70.
      194           assign
      195             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      196             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      197             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      198           .
      199         end.
      200       end.
      201       B-viewProcInfo:visible   in frame waitfram = no.
      202       B-viewProcInfo:sensitive in frame waitfram = no.
      203       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      204       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      205       if  (   mWaitFramView
      206          or  mWaitProcEvent)
      207          and not mBatchMode
      208       then
      209          display
      210             v-waitfram-action01 skip
      211             v-waitfram-action02 skip
      212             v-waitfram-action03 skip
      213          with frame waitfram .
      214       if     mWaitFramView
      215          then do:
      216             if     mWaitFramInterval ne ?
      217                and not mBatchMode
      218             then
      219                wait-for go of frame waitfram pause mWaitFramInterval.
      220          end.
      221          else
      222             if     mWaitProcEvent
      223                and not mBatchMode
      224             then
      225                process events .
      226     end.
      227   end procedure.
      228      procedure waitfram-show-this:
      229         define input  parameter iInterval as int64 no-undo.
      230         define variable vtime as int64 no-undo.
      231         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      232         mWaitFramInterval = iInterval.
      233         run waitfram-show (substitute("&1&2 &3&4" ,
      234                                       mWaitFramTextBeg ,
      235                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      236                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      237                                       mWaitFramTextEnd
      238                                      )
      239                           ).
      240      end.
      241      procedure WaitFramRunPause:
      242         define input  parameter iInterval as dec no-undo.
      243         define variable vStart  as datetime-tz no-undo.
      244         define variable vend    as datetime-tz no-undo.
      245         define variable vint as int64 no-undo.
      246         define variable vOk as logical no-undo.
      247         vStart = now.
      248         vend   = vStart.
      249         publish "WaitFramPause" (iInterval,output vOk).
      250         vend   =  now.
      251         vint = vend - vStart.
      252         vint = iInterval - vint / 1000.
      253         if     not mWaitFramStop
      254            and (   vint > 0
      255                 or (    not vOk
      256                     and iInterval eq ?
      257                     )
      258                 )
      259         then
      260            run waitfram-show-this (iInterval).
      261         vend   =  now.
      262         vint = vend - vStart.
      263         vint = iInterval - vint / 1000.
      264         if     not mWaitFramStop
      265            and vint > 0
      266         then do:
      267            run gbl/pause.p (vint * 1000).
      268         end.
      269         if iInterval ne ?
      270         then
      271            publish "WaitFramStop".
      272         waitfram-check-timeout().
      273      end.
      274      procedure WaitFramWaitFor:
      275         define input  parameter iInterval as dec no-undo.
      276         assign
      277            mWaitFramStartProc   = now
      278            mWaitFramStopUser    = no
      279            mWaitFramStopTimeOut = no
      280         .
      281         block-wait:
      282         do while not mWaitFramStop:
      283            run WaitFramRunPause (iInterval).
      284            if  waitfram-check-timeout()
      285            then do:
      286               leave block-wait.
      287            end.
      288         end.
      289         run waitfram-hide.
      290      end.
      291   procedure waitfram-join :
      292     define input  parameter p-line-1  as character no-undo .
      293     define input  parameter p-line-2  as character no-undo .
      294     define input  parameter p-line-3  as character no-undo .
      295     define output parameter p-message as character no-undo .
      296     do
      297     on error undo, return error return-value
      298     :
      299       assign
      300         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      301                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      302                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      303       .
      304     end.
      305   end procedure.
      306   function waitfram-join-function returns character
      307     (input p-line-1 as character
      308     ,input p-line-2 as character
      309     ,input p-line-3 as character
      310     ).
      311     define variable v-message as character no-undo .
      312     run waitfram-join in this-procedure
      313       (input  p-line-1
      314       ,input  p-line-2
      315       ,input  p-line-3
      316       ,output v-message
      317       ) .
      318     return v-message .
      319   end function .
      320   define new global shared variable g#language as character no-undo .
      321   if g#language <> '' and g#language <> 'rus':U then do:
      322     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      323   end.
      324   procedure proc-alt-shift-f2:
      325     if not ibs.th.gbl.gbl-var:rcode
      326   then
      327     run gbl\inidebug.p .
      328   end.
      329   procedure proc-alt-shift-f3:
      330     run gbl/prvssinf.p
      331       ( input this-procedure
      332       ) .
      333   end.
      334   define variable v-inform-launched as logical no-undo initial false .
      335   procedure proc-alt-shift-f4:
      336     define variable v-action as character no-undo .
      337     if v-inform-launched = false then do:
      338       assign
      339         v-inform-launched = true
      340       .
      341       run gbl/d-inform.w
      342         (  input self
      343         ,  input this-procedure
      344         , output v-action
      345         ) no-error .
      346       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      347       assign
      348         v-inform-launched = false
      349       .
      350     end.
      351   end.
      352   procedure proc-alt-f1:
      353     run gbl/corrhelp.p
      354       (input this-procedure
      355       ) .
      356   end .
      357   on alt-shift-f2 anywhere do:
      358     run proc-alt-shift-f2.
      359   end.
      360   on alt-shift-f3 anywhere do:
      361     run proc-alt-shift-f3 in this-procedure .
      362   end.
      363   on alt-shift-f4 anywhere do:
      364     run proc-alt-shift-f4 in this-procedure.
      365   end.
      366   on alt-f1 anywhere do:
      367     run proc-alt-f1 in this-procedure .
      368   end.
      369   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      370     define variable v-cntxt-db-num        as integer   no-undo .
      371     define variable v-cntxt-userid        as character no-undo .
      372     define variable v-cntxt-level         as character no-undo .
      373     define variable v-cntxt-host-code-obj as integer   no-undo .
      374     define variable v-cntxt-obj-type      as character no-undo .
      375     define variable v-cntxt-obj-code      as integer   no-undo .
      376     define variable v-cntxt-db-num-obj    as integer   no-undo .
      377     define variable v-cntxt-is-admin      as logical   no-undo .
      378   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      379   FUNCTION mark-string RETURNS CHARACTER
      380     ( input p-recid as recid, input mark-list as character  ) :
      381     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      382   END FUNCTION.
      383   DEFINE VARIABLE v-doc-rec AS RECID NO-UNDO.
      384   define variable v-rid-list as character no-undo .
      385   DEFINE BUTTON b-add
      386        LABEL "&Добавить"
      387        SIZE 10 BY 1.
      388   DEFINE BUTTON b-chg
      389        LABEL "&Изменить"
      390        SIZE 10 BY 1.
      391   DEFINE BUTTON b-del
      392        LABEL "&Удалить"
      393        SIZE 10 BY 1.
      394   DEFINE BUTTON B-Help
      395        LABEL "Помо&щь"
      396        SIZE 10 BY 1
      397        BGCOLOR 8 .
      398   DEFINE BUTTON b-lkp
      399        LABEL "&Просмотр"
      400        SIZE 10 BY 1.
      401   DEFINE BUTTON b-mark
      402        LABEL "&*"
      403        SIZE 4 BY 1.
      404   DEFINE BUTTON b-quit AUTO-END-KEY
      405        LABEL "&Выход"
      406        SIZE 10 BY 1
      407        BGCOLOR 8 .
      408   DEFINE BUTTON b-sel AUTO-GO
      409        LABEL "Выбор"
      410        SIZE 10 BY 1.
      411   DEFINE VARIABLE mark-num AS INTEGER FORMAT "->,>>>,>>9":U INITIAL 0
      412         VIEW-AS TEXT
      413        SIZE 9 BY .67
      414        FGCOLOR 10  NO-UNDO.
      415   DEFINE QUERY br-prop-ruleset FOR
      416         X_prop-ruleset, X_prop-head SCROLLING.
      417   DEFINE BROWSE br-prop-ruleset
      418    QUERY br-prop-ruleset  DISPLAY
      419         mark-string(recid(X_prop-ruleset), v-rid-list)
      420   X_prop-ruleset.codex_id COLUMN-LABEL "Кодекс!правил" FORMAT ">>>>>>>>9"
      421   X_prop-ruleset.ruleset_id COLUMN-LABEL "Набор!правил" FORMAT ">>>>>>>>9"
      422   X_prop-ruleset.dtm-code COLUMN-LABEL "Код!объекта" FORMAT ">>>>>>>>9"
      423   X_prop-head.prop-name COLUMN-LABEL "Имя объекта" format "X(32)"
      424   X_prop-head.prop-label COLUMN-LABEL "Лейбл объекта" format "X(255)"
      425        width 45
      426   X_prop-ruleset.is_dynamic COLUMN-LABEL "Отключаемый" FORMAT "+/"
      427       WITH NO-ROW-MARKERS SEPARATORS SIZE 97 BY 20.53 FIT-LAST-COLUMN.
      428   DEFINE FRAME Dialog-Frame
      429        b-quit AT ROW 1 COL 1
      430        b-mark AT ROW 1 COL 24 WIDGET-ID 12
      431        b-sel AT ROW 1 COL 28 WIDGET-ID 10
      432        b-add AT ROW 1 COL 38 WIDGET-ID 2
      433        b-chg AT ROW 1 COL 48 WIDGET-ID 4
      434        b-del AT ROW 1 COL 58 WIDGET-ID 8
      435        b-lkp AT ROW 1 COL 68 WIDGET-ID 6
      436        B-Help AT ROW 1 COL 88
      437        br-prop-ruleset AT ROW 2.33 COL 1.5 WIDGET-ID 100
      438        mark-num AT ROW 1 COL 13 COLON-ALIGNED NO-LABEL WIDGET-ID 14
      439        SPACE(74.50) SKIP(21.20)
      440       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      441            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      442            TITLE "Привязка объектов-операндов к кодексам/наборам правил"
      443            CANCEL-BUTTON b-quit.
      444   ASSIGN
      445          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      446          FRAME Dialog-Frame:HIDDEN           = TRUE.
      447   ON GO OF FRAME Dialog-Frame
      448   DO:
      449     p-rid-list = v-rid-list.
      450   END.
      451   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      452   DO:
      453     APPLY "END-ERROR":U TO SELF.
      454   END.
      455   ON CHOOSE OF b-add IN FRAME Dialog-Frame
      456   DO:
      457     run proc-b-add-chg in this-procedure ( input yes) no-error.
      458     if error-status:error then return no-apply.
      459   END.
      460   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
      461   DO:
      462     define variable v-rec as recid no-undo.
      463     if not available X_prop-ruleset then return no-apply.
      464     run proc-b-add-chg in this-procedure ( input no) no-error.
      465     if error-status:error then return no-apply.
      466   END.
      467   ON CHOOSE OF b-del IN FRAME Dialog-Frame
      468   DO:
      469     define variable v-rec as recid no-undo.
      470     define variable glog as logical no-undo.
      471     if not available X_prop-ruleset then return no-apply.
      472     v-rec = recid(X_prop-ruleset).
      473     message "Вы уверены, что хотите удалить привязку СКРИПТА К наборам правил?"
      474     view-as alert-box QUESTION buttons yes-no  update glog.
      475     if not glog then return no-apply.
      476     run rul/prop-ruleset3.p ( input v-rec
      477                              ,input no
      478                                 ) no-error.
      479     if error-status:error then return no-apply.
      480     Run Openbr in this-procedure .
      481   END.
      482   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
      483   DO:
      484     define variable v-rec as recid no-undo.
      485     if not available X_prop-ruleset then return no-apply.
      486     v-rec = recid(X_prop-ruleset).
      487     run rul/prop-head-i.w ( input parparentproc
      488                          ,input 'ПРОСМОТР':U
      489                          ,input X_prop-ruleset.dtm-code
      490                          ,input-output v-rec) no-error.
      491   END.
      492   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
      493   DO:
      494   define variable glog as logical no-undo .
      495     if available X_prop-ruleset then do:
      496   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      497   define variable v-str-recid4 as character no-undo .
      498   define variable v-num-entry4 as integer   no-undo .
      499   assign
      500     v-str-recid4 = trim( string( recid( X_prop-ruleset ) , "->>>>>>>>>>>9":U ) )
      501     v-num-entry4 = lookup( v-str-recid4 , v-rid-list )
      502   .
      503   if v-num-entry4 > 0 then do:
      504     assign
      505       entry( v-num-entry4, v-rid-list ) = "":U
      506       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
      507     .
      508   end.
      509   else do:
      510     assign
      511       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid4
      512     .
      513   end.
      514     glog = br-prop-ruleset:refresh() .
      515     if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
      516         glog = br-prop-ruleset:select-next-row ().
      517         apply "VALUE-CHANGED" to br-prop-ruleset in frame Dialog-Frame.
      518     end.
      519     if num-entries( v-rid-list ) = 0
      520     then
      521         hide mark-num in frame Dialog-Frame.
      522     else
      523         disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
      524   end.
      525   apply "entry" to br-prop-ruleset in frame Dialog-Frame.
      526   END.
      527   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
      528   DO:
      529     if available X_prop-ruleset then do:
      530       if  ( v-rid-list = "" ) or b-mark:sensitive = no
      531       then  v-rid-list = string( recid( X_prop-ruleset ) ) .
      532     end.
      533   END.
      534   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      535   on f5 of frame Dialog-Frame anywhere
      536   do:
      537      v-doc-rec = recid(X_prop-ruleset).    RUn OpenBR in this-procedure.  REPOSITION br-prop-ruleset to recid v-doc-rec No-ERROR.   apply 'value-changed' to br-prop-ruleset.
      538       apply "VALUE-CHANGED" to br-prop-ruleset.
      539   end.
      540   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      541   on help of frame Dialog-Frame
      542   do:
      543     run gbl/app_help.p
      544       (input this-procedure :file-name
      545       ,input ''
      546       ,input ?
      547       ) no-error.
      548     if error-status :error then do:
      549       message
      550         "Ошибка при вызове помощи"
      551         error-status :get-message(1)
      552         view-as alert-box .
      553     end.
      554   end.
      555   run minbtn-set in this-procedure .
      556   on choose of b-help in frame Dialog-Frame
      557   do:
      558     apply "help":u to frame Dialog-Frame .
      559   end.
      560   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      561   procedure minbtn-set :
      562       do
      563           on error undo, return error return-value
      564           :
      565           define variable ii              as integer       no-undo .
      566           define variable fh              as widget-handle no-undo .
      567           define variable hh              as widget-handle no-undo .
      568           define variable v-h             as handle        extent 4 no-undo .
      569           define variable v-name-button   as character     no-undo .
      570           define variable v-help-old-x    as decimal       no-undo .
      571           define variable v-help-old-y    as decimal       no-undo .
      572           define variable v-help-old-size as decimal       no-undo .
      573           define variable v-frame-width   as decimal       no-undo .
      574           define variable jj              as integer       no-undo .
      575           do
      576               on error undo, return error
      577               :
      578               assign
      579                   v-frame-width = frame Dialog-Frame:width - 0.3
      580                   fh            = frame Dialog-Frame:first-child
      581                   hh            = fh:first-child
      582                   ii            = 1
      583                   .
      584               do while valid-handle(hh):
      585                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      586                   do:
      587                       case lc(hh:name) :
      588                           when "b-help" then
      589                               do:
      590                                   hh:load-image-up("cmp/b-help.bmp":u) .
      591                                   hh:load-image-down("cmp/b-help.bmp":u) .
      592                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      593                                   hh:TOOLTIP = "Помощь" .
      594                                   v-help-old-x = hh:column .
      595                                   v-help-old-y = hh:row    .
      596                                   v-help-old-size = hh:width .
      597                                   hh:width-chars = 2.5 .
      598                               end.
      599                           when "b-print" then
      600                               do:
      601                                   hh:load-image("cmp/b-print.bmp":u) .
      602                                   hh:TOOLTIP = "Печать" .
      603                                   v-h[ii] = hh:handle .
      604                                   ii = ii + 1 .
      605                                   hh:width-chars = 3 .
      606                               end.
      607                           when "b-history" or
      608                           when "b-hist" then
      609                               do:
      610                                   hh:load-image("cmp/b-hist.bmp":u) .
      611                                   hh:TOOLTIP = "История" .
      612                                   v-h[ii] = hh:handle .
      613                                   ii = ii + 1 .
      614                                   hh:width-chars = 3 .
      615                               end.
      616                           when "b-sch" then
      617                               do:
      618                                   hh:load-image("cmp/b-sch.bmp":u) .
      619                                   hh:TOOLTIP = "Установка Фильтра" .
      620                                   v-h[ii] = hh:handle .
      621                                   ii = ii + 1 .
      622                                   hh:width-chars = 3 .
      623                               end.
      624                           when "b-hist-user" then
      625                               do:
      626                                   hh:load-image("cmp/b-hist.bmp":u) .
      627                                   hh:TOOLTIP = "История пользователя" .
      628                                   ii = ii + 1 .
      629                               end.
      630                       end case.
      631                   end.
      632                   hh = hh:next-sibling.
      633               end.
      634               b-help:column = v-frame-width - b-help:width-chars.
      635               jj = 0.
      636               repeat ii = 4 to 1 by -1 :
      637                   if valid-handle (v-h[ii] ) then
      638                   do:
      639                       jj  = jj + 1 .
      640                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      641                       v-h[ii]:row    = v-help-old-y .
      642                   end.
      643               end.
      644           end.
      645       end.
      646   end procedure.
      647   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      648   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      649   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      650   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      651   define variable v-diasize-current-frame-width  as decimal   no-undo .
      652   define variable v-diasize-current-frame-height as decimal   no-undo .
      653   define variable v-diasize-change-size          as logical   no-undo .
      654   define variable v-diasize-resize-button        as handle    no-undo .
      655   define variable v-diasize-wndmax               as logical   no-undo .
      656   define variable v-diasize-wndstore             as logical   no-undo .
      657   define variable v-diasize-proc-name            as character no-undo .
      658   define variable v-diasize-browse-handle        as handle    no-undo .
      659   define variable v-diasize-browse-number        as integer   no-undo .
      660   define variable v-diasize-need-full-display    as logical   no-undo init false .
      661   define temp-table temp-diasize-handle no-undo
      662     field handle-value  as handle
      663     field save-position as decimal
      664     index xpk is primary unique handle-value
      665     .
      666   define temp-table temp-browse-handle no-undo
      667     field browse-type   as character
      668     field browse-number as integer
      669     field browse-handle as handle
      670     field original-size as decimal
      671     index xpk is primary unique browse-type browse-number
      672     index xie browse-type browse-handle
      673   .
      674   procedure diasize_change-height :
      675     define input  parameter p-change-value  as decimal   no-undo .
      676     define input  parameter p-move-resize   as logical   no-undo .
      677     define variable v-field-group-handle    as handle    no-undo .
      678     define variable v-object-handle         as handle    no-undo .
      679     define variable v-frame-height          as decimal   no-undo .
      680     define variable v-frame-virtual-height  as decimal   no-undo .
      681     define variable v-browse-height         as decimal   no-undo .
      682     define variable v-window-height         as decimal   no-undo .
      683     define variable v-window-virtual-height as decimal   no-undo .
      684     define variable v-change-sign           as integer   no-undo .
      685     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      686     define buffer buf_temp-browse-handle  for temp-browse-handle .
      687     if p-change-value > 0
      688     then do:
      689       if frame Dialog-Frame :height + p-change-value
      690           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      691       then do:
      692         assign
      693           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      694                           - (frame Dialog-Frame :height-chars)
      695         .
      696         if p-change-value <= 0
      697         then do:
      698           run diasize_position-resize-button in this-procedure .
      699           return .
      700         end.
      701       end.
      702     end.
      703     if p-change-value < 0
      704     then do:
      705       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      706       then do:
      707         assign
      708           p-change-value = v-diasize-orig-frame-height
      709                          - (frame Dialog-Frame :height-chars)
      710         .
      711         if p-change-value >= 0
      712         then do:
      713           run diasize_position-resize-button in this-procedure .
      714           return .
      715         end.
      716       end.
      717     end.
      718     if p-change-value >= 0
      719     then do:
      720       assign
      721         v-change-sign = 1
      722       .
      723     end.
      724     else do:
      725       assign
      726         v-change-sign = -1
      727       .
      728     end.
      729     assign
      730       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      731     .
      732     if p-change-value = 0
      733     then do:
      734       run diasize_position-resize-button in this-procedure .
      735       return .
      736     end.
      737     move_block:
      738     do
      739     on error undo move_block, retry move_block
      740     :
      741       if retry
      742       then do:
      743         do
      744         on error undo move_block, leave move_block
      745         :
      746           if p-change-value > 0
      747           then do:
      748             for each buf_temp-diasize-handle
      749             on error undo, next
      750             :
      751               assign
      752                 v-object-handle = buf_temp-diasize-handle.handle-value
      753               .
      754               if v-object-handle <> v-diasize-resize-button
      755               then do:
      756                 assign
      757                   v-object-handle :row = buf_temp-diasize-handle.save-position
      758                 .
      759               end.
      760             end.
      761             assign
      762               v-diasize-browse-handle :height = v-browse-height
      763             .
      764             for each buf_temp-browse-handle
      765               where buf_temp-browse-handle.browse-type = 'height':u
      766             on error undo, next
      767             :
      768               assign
      769                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      770               .
      771             end.
      772             assign
      773               frame Dialog-Frame :height = v-frame-height
      774             .
      775             if frame Dialog-Frame :scrollable = true
      776             then do:
      777               assign
      778                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      779               .
      780             end.
      781             run diasize_position-resize-button in this-procedure .
      782           end.
      783           else do:
      784             if frame Dialog-Frame :scrollable = true
      785             then do:
      786               assign
      787                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      788               .
      789             end.
      790             assign
      791               frame Dialog-Frame :height = v-frame-height
      792             .
      793             assign
      794               v-diasize-browse-handle :height = v-browse-height
      795             .
      796             for each buf_temp-browse-handle
      797               where buf_temp-browse-handle.browse-type = 'height':u
      798             on error undo, next
      799             :
      800               assign
      801                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      802               .
      803             end.
      804             for each buf_temp-diasize-handle
      805             on error undo, next
      806             :
      807               assign
      808                 v-object-handle = buf_temp-diasize-handle.handle-value
      809               .
      810               if v-object-handle <> v-diasize-resize-button
      811               then do:
      812                 assign
      813                   v-object-handle :row = buf_temp-diasize-handle.save-position
      814                 .
      815               end.
      816             end.
      817             run diasize_position-resize-button in this-procedure .
      818           end.
      819           assign
      820             v-diasize-change-size = false
      821           .
      822           leave move_block .
      823         end.
      824       end.
      825       assign
      826         v-diasize-need-full-display = true
      827       .
      828       if v-diasize-change-size = false
      829       then do:
      830         assign
      831           v-diasize-change-size = true
      832         .
      833       end.
      834       else do:
      835         return .
      836       end.
      837       assign
      838         v-frame-height = frame Dialog-Frame :height
      839         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      840         v-browse-height = v-diasize-browse-handle :height
      841       .
      842       for each buf_temp-browse-handle
      843         where buf_temp-browse-handle.browse-type = 'height':u
      844       :
      845         assign
      846           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      847         .
      848       end.
      849       for each buf_temp-diasize-handle
      850       :
      851         delete buf_temp-diasize-handle .
      852       end.
      853       assign
      854         v-field-group-handle = frame Dialog-Frame :first-child
      855       .
      856       do while valid-handle(v-field-group-handle)
      857       :
      858         assign
      859           v-object-handle = v-field-group-handle :first-child
      860         .
      861         do while valid-handle(v-object-handle)
      862         :
      863           if  v-object-handle <> v-diasize-browse-handle :handle
      864           and can-query(v-object-handle, "row")
      865           and can-query(v-object-handle, "height")
      866           and ( v-object-handle :row > v-diasize-browse-handle :row )
      867           then do:
      868             find first buf_temp-browse-handle
      869               where buf_temp-browse-handle.browse-type   = 'height':u
      870                 and buf_temp-browse-handle.browse-handle = v-object-handle
      871               no-error .
      872             if available buf_temp-browse-handle
      873             then do:
      874             end.
      875             else do:
      876               create buf_temp-diasize-handle .
      877               assign
      878                 buf_temp-diasize-handle.handle-value  = v-object-handle
      879                 buf_temp-diasize-handle.save-position = v-object-handle :row
      880               .
      881             end.
      882           end.
      883           assign
      884             v-object-handle = v-object-handle :next-sibling
      885           .
      886         end.
      887         assign
      888           v-field-group-handle = v-field-group-handle :next-sibling
      889         .
      890       end.
      891       do with frame Dialog-Frame
      892       :
      893         hide v-diasize-resize-button .
      894         assign
      895           v-diasize-resize-button :row    = 1
      896           v-diasize-resize-button :column = 1
      897         .
      898       end.
      899       if p-change-value > 0
      900       then do:
      901         if frame Dialog-Frame :scrollable = true
      902         then do:
      903           assign
      904             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      905             no-error .
      906           if error-status :error
      907           or error-status :get-message(1) <> ""
      908           then do:
      909             undo move_block, retry move_block .
      910           end.
      911         end.
      912         assign
      913           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      914           no-error .
      915         if error-status :error
      916         or error-status :get-message(1) <> ""
      917         then do:
      918           undo move_block, retry move_block .
      919         end.
      920         assign
      921           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      922           no-error .
      923         if error-status :error
      924         or error-status :get-message(1) <> ""
      925         then do:
      926           undo move_block, retry move_block .
      927         end.
      928         for each buf_temp-browse-handle
      929           where buf_temp-browse-handle.browse-type = 'height':u
      930         on error undo move_block, retry move_block
      931         :
      932           assign
      933             buf_temp-browse-handle.browse-handle :height
      934               = buf_temp-browse-handle.browse-handle :height + p-change-value
      935             no-error .
      936           if error-status :error
      937           or error-status :get-message(1) <> ""
      938           then do:
      939             undo move_block, retry move_block .
      940           end.
      941         end.
      942         for each buf_temp-diasize-handle
      943         on error undo move_block, retry move_block
      944         :
      945           assign
      946             v-object-handle = buf_temp-diasize-handle.handle-value
      947           .
      948           if v-object-handle <> v-diasize-resize-button
      949           then do:
      950             assign
      951               v-object-handle :row = v-object-handle :row + p-change-value
      952               no-error .
      953             if error-status :error
      954             or error-status :get-message(1) <> ""
      955             then do:
      956               undo move_block, retry move_block .
      957             end.
      958           end.
      959         end.
      960       end.
      961       else do:
      962         for each buf_temp-diasize-handle
      963         on error undo move_block, retry move_block
      964         :
      965           assign
      966             v-object-handle = buf_temp-diasize-handle.handle-value
      967           .
      968           if v-object-handle <> v-diasize-resize-button
      969           then do:
      970             assign
      971               v-object-handle :row = v-object-handle :row + p-change-value
      972               no-error .
      973             if error-status :error
      974             or error-status :get-message(1) <> ""
      975             then do:
      976               undo move_block, retry move_block .
      977             end.
      978           end.
      979         end.
      980         assign
      981           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      982           no-error .
      983         if error-status :error
      984         or error-status :get-message(1) <> ""
      985         then do:
      986           undo move_block, retry move_block .
      987         end.
      988         for each buf_temp-browse-handle
      989           where buf_temp-browse-handle.browse-type = 'height':u
      990         on error undo move_block, retry move_block
      991         :
      992           assign
      993             buf_temp-browse-handle.browse-handle :height
      994               = buf_temp-browse-handle.browse-handle :height + p-change-value
      995             no-error .
      996           if error-status :error
      997           or error-status :get-message(1) <> ""
      998           then do:
      999             undo move_block, retry move_block .
     1000           end.
     1001         end.
     1002         assign
     1003           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1004           no-error .
     1005         if error-status :error
     1006         or error-status :get-message(1) <> ""
     1007         then do:
     1008           undo move_block, retry move_block .
     1009         end.
     1010         if frame Dialog-Frame :scrollable = true
     1011         then do:
     1012           assign
     1013             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1014             no-error .
     1015           if error-status :error
     1016           or error-status :get-message(1) <> ""
     1017           then do:
     1018             undo move_block, retry move_block .
     1019           end.
     1020         end.
     1021       end.
     1022       if p-move-resize = true
     1023       then do:
     1024         run diasize_position-resize-button in this-procedure .
     1025       end.
     1026       if v-diasize-wndstore = true
     1027       then do:
     1028         if connected("ub") = true
     1029         then do:
     1030           define variable v-cntxt-db-num        as integer   no-undo .
     1031           define variable v-cntxt-userid        as character no-undo .
     1032           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1033                                             , OUTPUT v-cntxt-userid
     1034                                             ) .
     1035           run gbl/wndsizew.p
     1036             (input  v-cntxt-db-num
     1037             ,input  v-cntxt-userid
     1038             ,input  v-diasize-proc-name
     1039             ,input  'height':u
     1040             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1041             ) .
     1042         end.
     1043       end.
     1044     end.
     1045     assign
     1046       v-diasize-change-size = false
     1047     .
     1048   end procedure.
     1049   procedure diasize_set-height :
     1050     define input  parameter p-new-height  as decimal   no-undo .
     1051     define input  parameter p-move-resize as logical   no-undo .
     1052     do
     1053     on error undo, return error return-value
     1054     :
     1055       run diasize_change-height in this-procedure
     1056         (input  (p-new-height - frame Dialog-Frame :height)
     1057         ,input  p-move-resize
     1058         ) .
     1059     end.
     1060   end procedure.
     1061   procedure diasize_change-width :
     1062     define input  parameter p-change-value as decimal   no-undo .
     1063     define input  parameter p-move-resize  as logical   no-undo .
     1064     define variable v-field-group-handle   as handle    no-undo .
     1065     define variable v-object-handle        as handle    no-undo .
     1066     define variable v-frame-width          as decimal   no-undo .
     1067     define variable v-frame-virtual-width  as decimal   no-undo .
     1068     define variable v-browse-width         as decimal   no-undo .
     1069     define variable v-window-width         as decimal   no-undo .
     1070     define variable v-window-virtual-width as decimal   no-undo .
     1071     define variable v-change-sign          as integer   no-undo .
     1072     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1073     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1074     if p-change-value > 0
     1075     then do:
     1076       if frame Dialog-Frame :width + p-change-value >
     1077           session :width-chars
     1078       then do:
     1079         assign
     1080           p-change-value = session :width-chars - frame Dialog-Frame :width
     1081         .
     1082         if p-change-value <= 0
     1083         then do:
     1084           run diasize_position-resize-button in this-procedure .
     1085           return .
     1086         end.
     1087       end.
     1088     end.
     1089     if p-change-value < 0
     1090     then do:
     1091       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1092       then do:
     1093         assign
     1094           p-change-value = v-diasize-orig-frame-width
     1095                          - frame Dialog-Frame :width
     1096         .
     1097         if p-change-value >= 0
     1098         then do:
     1099           run diasize_position-resize-button in this-procedure .
     1100           return .
     1101         end.
     1102       end.
     1103     end.
     1104     if p-change-value >= 0
     1105     then do:
     1106       assign
     1107         v-change-sign = 1
     1108       .
     1109     end.
     1110     else do:
     1111       assign
     1112         v-change-sign = -1
     1113       .
     1114     end.
     1115     assign
     1116       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1117     .
     1118     if p-change-value = 0
     1119     then do:
     1120       run diasize_position-resize-button in this-procedure .
     1121       return .
     1122     end.
     1123     move_block:
     1124     do
     1125     on error undo move_block, leave move_block
     1126     :
     1127       if retry
     1128       then do:
     1129         do
     1130         on error undo move_block, leave move_block
     1131         :
     1132           if p-change-value > 0
     1133           then do:
     1134             for each buf_temp-diasize-handle
     1135             on error undo, next
     1136             :
     1137               assign
     1138                 v-object-handle = buf_temp-diasize-handle.handle-value
     1139               .
     1140               if v-object-handle <> v-diasize-resize-button
     1141               then do:
     1142                 assign
     1143                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1144                 .
     1145               end.
     1146             end.
     1147             assign
     1148               v-diasize-browse-handle :width = v-browse-width
     1149             .
     1150             for each buf_temp-browse-handle
     1151               where buf_temp-browse-handle.browse-type = 'width':u
     1152             on error undo, next
     1153             :
     1154               assign
     1155                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1156               .
     1157             end.
     1158             assign
     1159               frame Dialog-Frame :width = v-frame-width
     1160             .
     1161             if frame Dialog-Frame :scrollable = true
     1162             then do:
     1163               assign
     1164                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1165               .
     1166             end.
     1167             run diasize_position-resize-button in this-procedure .
     1168           end.
     1169           else do:
     1170             if frame Dialog-Frame :scrollable = true
     1171             then do:
     1172               assign
     1173                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1174               .
     1175             end.
     1176             assign
     1177               frame Dialog-Frame :width = v-frame-width
     1178             .
     1179             for each buf_temp-browse-handle
     1180               where buf_temp-browse-handle.browse-type = 'width':u
     1181             on error undo, next
     1182             :
     1183               assign
     1184                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1185               .
     1186             end.
     1187             assign
     1188               v-diasize-browse-handle :width = v-browse-width
     1189             .
     1190             for each buf_temp-diasize-handle
     1191             on error undo, next
     1192             :
     1193               assign
     1194                 v-object-handle = buf_temp-diasize-handle.handle-value
     1195               .
     1196               if v-object-handle <> v-diasize-resize-button
     1197               then do:
     1198                 assign
     1199                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1200                 .
     1201               end.
     1202             end.
     1203             run diasize_position-resize-button in this-procedure .
     1204           end.
     1205           assign
     1206             v-diasize-change-size = false
     1207           .
     1208           leave move_block .
     1209         end.
     1210       end.
     1211       assign
     1212         v-diasize-need-full-display = true
     1213       .
     1214       if v-diasize-change-size = false
     1215       then do:
     1216         assign
     1217           v-diasize-change-size = true
     1218         .
     1219       end.
     1220       else do:
     1221         return .
     1222       end.
     1223       assign
     1224         v-frame-width = frame Dialog-Frame :width
     1225         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1226         v-browse-width = v-diasize-browse-handle :width
     1227       .
     1228       for each buf_temp-browse-handle
     1229         where buf_temp-browse-handle.browse-type = 'width':u
     1230       :
     1231         assign
     1232           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1233         .
     1234       end.
     1235       for each buf_temp-diasize-handle
     1236       :
     1237         delete buf_temp-diasize-handle .
     1238       end.
     1239       assign
     1240         v-field-group-handle = frame Dialog-Frame :first-child
     1241       .
     1242       do while valid-handle(v-field-group-handle)
     1243       :
     1244         assign
     1245           v-object-handle = v-field-group-handle :first-child
     1246         .
     1247         do while valid-handle(v-object-handle)
     1248         :
     1249           if  v-object-handle <> v-diasize-browse-handle :handle
     1250           and v-object-handle <> v-diasize-resize-button
     1251           and can-query(v-object-handle, "row")
     1252           and can-query(v-object-handle, "height")
     1253           and ( v-object-handle :col + v-object-handle :width
     1254                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1255               )
     1256           then do:
     1257             find first buf_temp-browse-handle
     1258               where buf_temp-browse-handle.browse-type   = 'width':u
     1259                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1260               no-error .
     1261             if available buf_temp-browse-handle
     1262             then do:
     1263             end.
     1264             else do:
     1265               create buf_temp-diasize-handle .
     1266               assign
     1267                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1268                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1269               .
     1270             end.
     1271           end.
     1272           assign
     1273             v-object-handle = v-object-handle :next-sibling
     1274           .
     1275         end.
     1276         assign
     1277           v-field-group-handle = v-field-group-handle :next-sibling
     1278         .
     1279       end.
     1280       do with frame Dialog-Frame
     1281       :
     1282         hide v-diasize-resize-button .
     1283         v-diasize-resize-button :row = 1.
     1284         v-diasize-resize-button :column = 1.
     1285       end.
     1286       if p-change-value > 0
     1287       then do:
     1288         if frame Dialog-Frame :scrollable = true
     1289         then do:
     1290           assign
     1291             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1292             no-error .
     1293           if error-status :error
     1294           or error-status :get-message(1) <> ""
     1295           then do:
     1296             undo move_block, retry move_block.
     1297           end.
     1298         end.
     1299         assign
     1300           frame Dialog-Frame :width = v-frame-width + p-change-value
     1301           no-error .
     1302         if error-status :error
     1303         or error-status :get-message(1) <> ""
     1304         then do:
     1305           undo move_block, retry move_block.
     1306         end.
     1307         assign
     1308           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1309         no-error .
     1310         if error-status :error
     1311         or error-status :get-message(1) <> ""
     1312         then do:
     1313           undo move_block, retry move_block.
     1314         end.
     1315         for each buf_temp-browse-handle
     1316           where buf_temp-browse-handle.browse-type = 'width':u
     1317         on error undo move_block, retry move_block
     1318         :
     1319           assign
     1320             buf_temp-browse-handle.browse-handle :width
     1321               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1322             no-error .
     1323           if error-status :error
     1324           or error-status :get-message(1) <> ""
     1325           then do:
     1326             undo move_block, retry move_block .
     1327           end.
     1328         end.
     1329         for each buf_temp-diasize-handle
     1330         on error undo move_block, retry move_block
     1331         :
     1332           assign
     1333             v-object-handle = buf_temp-diasize-handle.handle-value
     1334           .
     1335           if v-object-handle <> v-diasize-resize-button
     1336           then do:
     1337             assign
     1338               v-object-handle :col = v-object-handle :col + p-change-value
     1339               no-error .
     1340             if error-status :error
     1341             or error-status :get-message(1) <> ""
     1342             then do:
     1343               undo move_block, retry move_block .
     1344             end.
     1345           end.
     1346         end.
     1347       end.
     1348       else do:
     1349         for each buf_temp-diasize-handle
     1350         on error undo move_block, retry move_block
     1351         :
     1352           assign
     1353             v-object-handle = buf_temp-diasize-handle.handle-value
     1354           .
     1355           if v-object-handle <> v-diasize-resize-button
     1356           then do:
     1357             assign
     1358               v-object-handle :col = v-object-handle :col + p-change-value
     1359               no-error .
     1360             if error-status :error
     1361             or error-status :get-message(1) <> ""
     1362             then do:
     1363               undo move_block, retry move_block .
     1364             end.
     1365           end.
     1366         end.
     1367         for each buf_temp-browse-handle
     1368           where buf_temp-browse-handle.browse-type = 'width':u
     1369         on error undo move_block, retry move_block
     1370         :
     1371           assign
     1372             buf_temp-browse-handle.browse-handle :width
     1373               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1374             no-error .
     1375           if error-status :error
     1376           or error-status :get-message(1) <> ""
     1377           then do:
     1378             undo move_block, retry move_block .
     1379           end.
     1380         end.
     1381         assign
     1382           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1383           no-error .
     1384         if error-status :error
     1385         or error-status :get-message(1) <> ""
     1386         then do:
     1387           undo move_block, retry move_block.
     1388         end.
     1389         assign
     1390           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1391         no-error .
     1392         if error-status :error
     1393         or error-status :get-message(1) <> ""
     1394         then do:
     1395           undo move_block, retry move_block.
     1396         end.
     1397         if frame Dialog-Frame :scrollable = true
     1398         then do:
     1399           assign
     1400             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1401           no-error .
     1402           if error-status :error
     1403           or error-status :get-message(1) <> ""
     1404           then do:
     1405             undo move_block, retry move_block.
     1406           end.
     1407         end.
     1408       end.
     1409       if p-move-resize
     1410       then do:
     1411         run diasize_position-resize-button in this-procedure .
     1412       end.
     1413       if v-diasize-wndstore = true
     1414       then do:
     1415         if connected("ub") = true
     1416         then do:
     1417           define variable v-cntxt-db-num        as integer   no-undo .
     1418           define variable v-cntxt-userid        as character no-undo .
     1419           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1420                                             , OUTPUT v-cntxt-userid
     1421                                             ) .
     1422           run gbl/wndsizew.p
     1423             (input  v-cntxt-db-num
     1424             ,input  v-cntxt-userid
     1425             ,input  v-diasize-proc-name
     1426             ,input  'width':u
     1427             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1428             ) .
     1429         end.
     1430       end.
     1431     end.
     1432     assign
     1433       v-diasize-change-size = false
     1434     .
     1435   end procedure.
     1436   procedure diasize_set-width :
     1437     define input  parameter p-new-width  as decimal   no-undo .
     1438     define input  parameter p-move-resize as logical   no-undo .
     1439     do
     1440     on error undo, return error return-value
     1441     :
     1442       run diasize_change-width in this-procedure
     1443         (input  (p-new-width - frame Dialog-Frame :width)
     1444         ,input  p-move-resize
     1445         ) .
     1446     end.
     1447   end procedure.
     1448   procedure diasize_position-resize-button :
     1449     do with frame Dialog-Frame
     1450     :
     1451       hide v-diasize-resize-button .
     1452       assign
     1453         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1454                     - 1
     1455                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1456         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1457                     - 1
     1458                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1459       .
     1460       view v-diasize-resize-button .
     1461     end.
     1462   end procedure.
     1463   on alt-right anywhere
     1464   do:
     1465     run diasize_change-width in this-procedure
     1466       (input 1
     1467       ,input true
     1468       ) .
     1469     return no-apply .
     1470   end.
     1471   on alt-left anywhere
     1472   do:
     1473     run diasize_change-width in this-procedure
     1474       (input -1
     1475       ,input true
     1476       ) .
     1477     return no-apply .
     1478   end.
     1479   on alt-down anywhere
     1480   do:
     1481     run diasize_change-height in this-procedure
     1482       (input 1
     1483       ,input true
     1484       ) .
     1485     return no-apply .
     1486   end.
     1487   on alt-up anywhere
     1488   do:
     1489     run diasize_change-height in this-procedure
     1490       (input -1
     1491       ,input true
     1492       ) .
     1493     return no-apply .
     1494   end.
     1495   on alt-enter of frame Dialog-Frame
     1496   do:
     1497     run diasize_maximize in this-procedure
     1498       (input  ?
     1499       ).
     1500     return no-apply .
     1501   end.
     1502   procedure diasize_end-move :
     1503     do
     1504     on error undo, return error return-value
     1505     :
     1506       define variable v-row-delta as decimal   no-undo .
     1507       define variable v-col-delta as decimal   no-undo .
     1508       define variable v-new-row as decimal   no-undo .
     1509       define variable v-new-col as decimal   no-undo .
     1510       assign
     1511         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1512         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1513       .
     1514       assign
     1515         v-row-delta = v-new-row - frame Dialog-Frame :height
     1516         v-col-delta = v-new-col - frame Dialog-Frame :width
     1517       .
     1518       run diasize_change-height in this-procedure
     1519         (input v-row-delta
     1520         ,input true
     1521         ) .
     1522       run diasize_change-width in this-procedure
     1523         (input v-col-delta
     1524         ,input true
     1525         ) .
     1526     end.
     1527   end procedure.
     1528   procedure diasize_maximize :
     1529     define input  parameter p-action as logical   no-undo .
     1530     do
     1531     on error undo, return error return-value
     1532     :
     1533       if p-action = ?
     1534       then do:
     1535         if v-diasize-need-maximize = true
     1536         then do:
     1537           assign
     1538             p-action = true
     1539           .
     1540         end.
     1541         else do:
     1542           assign
     1543             p-action = false
     1544           .
     1545         end.
     1546       end.
     1547       if p-action = true
     1548       then do:
     1549         run diasize_change-height in this-procedure
     1550           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1551               - frame Dialog-Frame :height-chars
     1552           ,input true
     1553           ) .
     1554         run diasize_change-width in this-procedure
     1555           (input session :width-chars
     1556               - frame Dialog-Frame :width-chars
     1557           ,input true
     1558           ) .
     1559         assign
     1560           v-diasize-need-maximize = false
     1561         .
     1562       end.
     1563       else do:
     1564         run diasize_change-width in this-procedure
     1565           (input v-diasize-orig-frame-width
     1566               - frame Dialog-Frame :width-chars
     1567           ,input true
     1568           ) .
     1569         run diasize_change-height in this-procedure
     1570           (input v-diasize-orig-frame-height
     1571               - frame Dialog-Frame :height-chars
     1572           ,input true
     1573           ) .
     1574         assign
     1575           v-diasize-need-maximize = true
     1576         .
     1577       end.
     1578     end.
     1579   end procedure.
     1580   procedure diasize_restore-orig-size :
     1581     do
     1582     on error undo, return error return-value
     1583     :
     1584       assign
     1585         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1586         v-diasize-current-frame-height = frame Dialog-Frame :height
     1587       .
     1588       run diasize_set-height in this-procedure
     1589         (input  v-diasize-orig-frame-height
     1590         ,input  true
     1591         ) .
     1592       run diasize_set-width in this-procedure
     1593         (input  v-diasize-orig-frame-width
     1594         ,input  true
     1595         ) .
     1596     end.
     1597   end procedure.
     1598   procedure diasize_restore-current-size :
     1599     do
     1600     on error undo, return error return-value
     1601     :
     1602       run diasize_set-height in this-procedure
     1603         (input  v-diasize-current-frame-height
     1604         ,input  true
     1605         ) .
     1606       run diasize_set-width in this-procedure
     1607         (input  v-diasize-current-frame-width
     1608         ,input  true
     1609         ) .
     1610     end.
     1611   end procedure.
     1612   procedure diasize_set-browse-handle :
     1613     define input  parameter p-browse-handle as handle   no-undo .
     1614     define buffer buf_temp-browse-handle for temp-browse-handle .
     1615     do
     1616     on error undo, return error return-value
     1617     :
     1618       assign
     1619         v-diasize-browse-handle = p-browse-handle
     1620       .
     1621       for each buf_temp-browse-handle
     1622       on error undo, return error return-value
     1623       :
     1624         delete buf_temp-browse-handle .
     1625       end.
     1626     end.
     1627   end procedure.
     1628   procedure diasize_add_browse :
     1629     define input  parameter p-browse-type   as character no-undo .
     1630     define input  parameter p-browse-handle as handle    no-undo .
     1631     define buffer buf_temp-browse-handle for temp-browse-handle .
     1632     do
     1633     on error undo, return error return-value
     1634     :
     1635       assign
     1636         v-diasize-browse-number = v-diasize-browse-number + 1
     1637       .
     1638       create buf_temp-browse-handle .
     1639       assign
     1640         buf_temp-browse-handle.browse-type   = p-browse-type
     1641         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1642         buf_temp-browse-handle.browse-handle = p-browse-handle
     1643       .
     1644     end.
     1645   end procedure.
     1646   procedure diasize_init :
     1647     define variable v-default-value    as logical   no-undo .
     1648     define variable v-restore-saved    as logical   no-undo .
     1649     define variable v-resize-value-str as character no-undo .
     1650     do
     1651     on error undo, return error return-value
     1652     :
     1653       do with frame Dialog-Frame
     1654       :
     1655         assign
     1656           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1657           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1658           v-diasize-browse-handle     = browse br-prop-ruleset :handle
     1659         .
     1660         create button v-diasize-resize-button
     1661         assign
     1662           parent        = frame Dialog-Frame :first-child
     1663           label         = "s"
     1664           height-pixels = 16
     1665           width-pixels  = 16
     1666           visible       = true
     1667           sensitive     = true
     1668           movable       = true
     1669           triggers:
     1670             on end-move persistent run diasize_end-move in this-procedure .
     1671           end triggers.
     1672         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1673         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1674         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1675         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1676         assign
     1677           v-diasize-wndmax = false
     1678         .
     1679         if connected("ub") = true
     1680         then do:
     1681           define variable v-cntxt-db-num        as integer   no-undo .
     1682           define variable v-cntxt-userid        as character no-undo .
     1683           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1684                                             , OUTPUT v-cntxt-userid
     1685                                             ) .
     1686           run gbl/wndpar_r.p
     1687             (input  v-cntxt-db-num
     1688             ,input  v-cntxt-userid
     1689             ,input  'wndmax':U
     1690             ,output v-diasize-wndmax
     1691             ,output v-default-value
     1692             ) .
     1693         end.
     1694         assign
     1695           v-diasize-wndstore = false
     1696         .
     1697         if connected("ub") = true
     1698         then do:
     1699           run gbl/wndpar_r.p
     1700             (input  v-cntxt-db-num
     1701             ,input  v-cntxt-userid
     1702             ,input  'wndstore':U
     1703             ,output v-diasize-wndstore
     1704             ,output v-default-value
     1705             ) .
     1706         end.
     1707         assign
     1708           v-diasize-proc-name = entry(1, program-name(2), '.')
     1709         .
     1710         if v-diasize-wndstore = true
     1711         then do:
     1712           assign
     1713             v-restore-saved = false
     1714           .
     1715           if connected("ub") = true
     1716           then do:
     1717             run gbl/wndsizer.p
     1718               (input  v-cntxt-db-num
     1719               ,input  v-cntxt-userid
     1720               ,input  v-diasize-proc-name
     1721               ,input  'height':u
     1722               ,output v-resize-value-str
     1723               ) .
     1724             if v-resize-value-str <> '':U
     1725             then do:
     1726               run diasize_change-height in this-procedure
     1727                 (input  integer(v-resize-value-str)
     1728                 ,input  true
     1729                 ) .
     1730               assign
     1731                 v-restore-saved = true
     1732               .
     1733             end.
     1734           end.
     1735           if connected("ub") = true
     1736           then do:
     1737             run gbl/wndsizer.p
     1738               (input  v-cntxt-db-num
     1739               ,input  v-cntxt-userid
     1740               ,input  v-diasize-proc-name
     1741               ,input  'width':u
     1742               ,output v-resize-value-str
     1743               ) .
     1744             if v-resize-value-str <> '':U
     1745             then do:
     1746               run diasize_change-width in this-procedure
     1747                 (input  integer(v-resize-value-str)
     1748                 ,input  true
     1749                 ) .
     1750               assign
     1751                 v-restore-saved = true
     1752               .
     1753             end.
     1754           end.
     1755           if v-restore-saved <> true
     1756           then do:
     1757             if v-diasize-wndmax = true
     1758             then do:
     1759               run diasize_maximize in this-procedure
     1760                 (input  true
     1761                 ) .
     1762             end.
     1763           end.
     1764         end.
     1765         else do:
     1766           if v-diasize-wndmax = true
     1767           then do:
     1768             run diasize_maximize in this-procedure
     1769               (input  true
     1770               ) .
     1771           end.
     1772         end.
     1773       end.
     1774     end.
     1775   end procedure.
     1776   procedure diasize_need-full-display :
     1777     define output parameter p-need-full-display as logical   no-undo .
     1778     do
     1779     on error undo, return error return-value
     1780     :
     1781       assign
     1782         p-need-full-display = v-diasize-need-full-display
     1783       .
     1784       assign
     1785         v-diasize-need-full-display = false
     1786       .
     1787     end.
     1788   end procedure.
     1789   procedure get-context :
     1790      define output parameter p-db-num as integer          no-undo.
     1791      define output parameter p-user-id as character        no-undo.
     1792      define variable v-login               as character    no-undo.
     1793      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1794      define buffer buf_user-login  for ub.user-login .
     1795      do
     1796      on error undo, return error
     1797      :
     1798            FIND FIRST buf_sys-ctrl no-lock.
     1799            ASSIGN
     1800               v-login = USERID("ub")
     1801               p-db-num = buf_sys-ctrl.db-num
     1802            .
     1803            FIND FIRST buf_user-login
     1804                 WHERE buf_user-login.db-num = p-db-num
     1805                   AND buf_user-login.user-login = v-login
     1806                 no-lock
     1807                 no-error
     1808                 .
     1809            IF AVAILABLE buf_user-login
     1810            THEN DO:
     1811               assign
     1812                  p-user-id = buf_user-login.user-id
     1813               .
     1814            END.
     1815      end.
     1816   end procedure.
     1817       run diasize_init in this-procedure .
     1818   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1819   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1820   MAIN-BLOCK:
     1821   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1822      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1823     v-rid-list = p-rid-list.
     1824   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1825     run mainmenu_getcntxt in parparentproc
     1826       (output v-cntxt-db-num
     1827       ,output v-cntxt-userid
     1828       ,output v-cntxt-level
     1829       ,output v-cntxt-host-code-obj
     1830       ,output v-cntxt-obj-type
     1831       ,output v-cntxt-obj-code
     1832       ,output v-cntxt-db-num-obj
     1833       ,output v-cntxt-is-admin
     1834       ) .
     1835     run Myenable in this-procedure .
     1836     WAIT-FOR GO OF FRAME Dialog-Frame.
     1837   END.
     1838   RUN disable_UI.
     1839   PROCEDURE disable_UI :
     1840     HIDE FRAME Dialog-Frame.
     1841   END PROCEDURE.
     1842   PROCEDURE enable_UI :
     1843     DISPLAY mark-num
     1844         WITH FRAME Dialog-Frame.
     1845     ENABLE b-quit b-mark b-sel b-add b-chg b-del b-lkp B-Help br-prop-ruleset
     1846            mark-num
     1847         WITH FRAME Dialog-Frame.
     1848     VIEW FRAME Dialog-Frame.
     1849     OPEN QUERY br-prop-ruleset FOR EACH X_prop-ruleset NO-LOCK, first X_prop-head NO-LOCK indexed-reposition.
     1850   END PROCEDURE.
     1851   PROCEDURE MyEnable :
     1852   assign
     1853   X_prop-head.prop-name :resizable in browse br-prop-ruleset = yes
     1854   X_prop-head.prop-label:resizable in browse br-prop-ruleset = yes
     1855   .
     1856   ENABLE
     1857   b-quit
     1858   b-add when ((p-list-mode = "ruleset" or p-list-mode = "dtm-code" and v-cntxt-db-num = 0) and lookup("b-add", bttns) > 0)
     1859   b-chg when (v-cntxt-db-num = 0 and lookup("b-add", bttns) > 0)
     1860   b-del when (v-cntxt-db-num = 0 and lookup("b-add", bttns) > 0)
     1861   b-lkp
     1862   B-Help
     1863   b-mark when (v-cntxt-db-num = 0 and lookup("b-mark", bttns) > 0)
     1864   b-sel when (v-cntxt-db-num = 0 and lookup("b-sel", bttns) > 0)
     1865   br-prop-ruleset
     1866   WITH FRAME Dialog-Frame.
     1867   VIEW FRAME Dialog-Frame.
     1868   run Openbr in this-procedure .
     1869   END PROCEDURE.
     1870   PROCEDURE Openbr :
     1871   CASE p-list-mode:
     1872     WHEN 'все':U THEN DO:
     1873       OPEN QUERY br-prop-ruleset
     1874       FOR EACH X_prop-ruleset NO-LOCK,
     1875          FIRST X_prop-head NO-LOCK WHERE
     1876               X_prop-head.dtm-code = X_prop-ruleset.dtm-code INDEXED-REPOSITION.
     1877     END.
     1878     WHEN "ruleset" THEN DO:
     1879       OPEN QUERY br-prop-ruleset
     1880       FOR EACH X_prop-ruleset NO-LOCK WHERE
     1881                X_prop-ruleset.codex_id = p-codex-id
     1882             AND X_prop-ruleset.ruleset_id = p-codex-id,
     1883           FIRST X_prop-head NO-LOCK WHERE
     1884               X_prop-head.dtm-code = X_prop-ruleset.dtm-code INDEXED-REPOSITION.
     1885     END.
     1886     WHEN "dtm-code" THEN DO:
     1887       OPEN QUERY br-prop-ruleset
     1888       FOR EACH X_prop-ruleset NO-LOCK WHERE
     1889               X_prop-ruleset.dtm-code = p-dtm-code,
     1890           FIRST X_prop-head NO-LOCK WHERE
     1891               X_prop-head.dtm-code = X_prop-ruleset.dtm-code INDEXED-REPOSITION.
     1892    END.
     1893   END CASE.
     1894   END PROCEDURE.
     1895   PROCEDURE proc-b-add-chg :
     1896   define input parameter p-add as logical no-undo .
     1897   define variable v-rid-list as character no-undo .
     1898   define variable v-rec as recid no-undo .
     1899   define variable v-ok as logical no-undo .
     1900   define variable v-ii as integer no-undo .
     1901   define variable v-is-dynamic as logical no-undo .
     1902   define buffer buf_prop-head for dictdb.prop-head.
     1903   define buffer buf_ruleset for dictdb.ruleset.
     1904   CASE p-add:
     1905     when yes then do:
     1906       if p-list-mode = "ruleset" then do:
     1907         run rul/prop-head-s.w ( input parparentproc
     1908                               ,input "b-sel,b-mark"
     1909                               ,input 'все':U
     1910                               ,input '':U
     1911                               ,input-output v-rid-list) no-error.
     1912         if v-rid-list = '':U then do:
     1913           return.
     1914         end.
     1915         do v-ii = 1 to num-entries(v-rid-list ):
     1916           find first buf_prop-head no-lock where
     1917                     recid(buf_prop-head) = integer(entry(v-ii, v-rid-list)).
     1918           run gbl/d-logical.w ( input ?
     1919                               ,input ('title=':u +
     1920                                       substitute("Привязка объекта &1 к кодексу &2 набор правил &3"
     1921                                                  , buf_prop-head.prop-name
     1922                                                  , p-codex-id
     1923                                                  , p-ruleset-id) + '\':u
     1924                                       +  'text1=':u + "Свойство ОТКЛЮЧАЕМЫЙ" + '\':u)
     1925                               ,input-output v-is-dynamic
     1926                               ,output v-ok ) no-error.
     1927           if error-status:error
     1928           or not v-ok then do:
     1929             undo, return error .
     1930           end.
     1931           run rul/prop-ruleset1.p ( input 'ДОБАВЛЕНИЕ':U
     1932                                     ,input no
     1933                                     ,input-output v-rec
     1934                                     ,input p-codex-id
     1935                                     ,input p-ruleset-id
     1936                                     ,input buf_prop-head.dtm-code
     1937                                     ,input v-is-dynamic) no-error.
     1938           if error-status:error then do:
     1939             undo, return error .
     1940           end.
     1941         end.
     1942       end.
     1943       if p-list-mode = "dtm-code" then do:
     1944         run rul/ruleset-s.w ( input parparentproc
     1945                               ,input "b-sel,b-mark"
     1946                               ,input "only-ruleset"
     1947                               ,input 0
     1948                               ,input-output v-rid-list) no-error.
     1949         if v-rid-list = '':U then do:
     1950           return.
     1951         end.
     1952         do v-ii = 1 to num-entries(v-rid-list):
     1953           find first buf_ruleset no-lock where
     1954                   recid(buf_ruleset) = integer(entry(v-ii, v-rid-list)).
     1955           run gbl/d-logical.w ( input ?
     1956                               ,input ('title=':u +
     1957                                       substitute("Привязка объекта &1 к кодексу &2 набор правил &3"
     1958                                                  , p-dtm-code
     1959                                                  , buf_ruleset.codex_id
     1960                                                  , buf_ruleset.ruleset_id) + '\':u
     1961                                       +  'text1=':u + "Свойство ОТКЛЮЧАЕМЫЙ" + '\':u)
     1962                               ,input-output v-is-dynamic
     1963                               ,output v-ok ) no-error.
     1964           if error-status:error
     1965           or not v-ok then do:
     1966             undo, return error .
     1967           end.
     1968           run rul/prop-ruleset1.p ( input 'ДОБАВЛЕНИЕ':U
     1969                                     ,input no
     1970                                     ,input-output v-rec
     1971                                     ,input buf_ruleset.codex_id
     1972                                     ,input buf_ruleset.ruleset_id
     1973                                     ,input p-dtm-code
     1974                                     ,input v-is-dynamic) no-error.
     1975           if error-status:error then do:
     1976             undo, return error .
     1977           end.
     1978         end.
     1979       end.
     1980       run openbr in this-procedure .
     1981       reposition br-prop-ruleset to recid v-rec no-error.
     1982       APPLY "ENTRY" to browse br-prop-ruleset.
     1983     end.
     1984     when no then do:
     1985       run gbl/d-logical.w ( input ?
     1986                           ,input 'title=':u + "Задайте свойство ОТКЛЮЧАЕМЫЙ" + '\':u
     1987                           ,input-output v-is-dynamic
     1988                           ,output v-ok ) no-error.
     1989       if error-status:error
     1990       or not v-ok then do:
     1991         undo, return error .
     1992       end.
     1993       v-rec = recid(x_prop-ruleset).
     1994       run rul/prop-ruleset1.p ( input 'ИЗМЕНЕНИЕ':U
     1995                                 ,input no
     1996                                 ,input-output v-rec
     1997                                 ,input X_prop-ruleset.codex_id
     1998                                 ,input X_prop-ruleset.ruleset_id
     1999                                 ,input X_prop-ruleset.dtm-code
     2000                                 ,input v-is-dynamic) no-error.
     2001       if error-status:error then do:
     2002         undo, return error .
     2003       end.
     2004       run openbr in this-procedure .
     2005       reposition br-prop-ruleset to recid v-rec no-error.
     2006       APPLY "ENTRY" to browse br-prop-ruleset.
     2007     end.
     2008   end.
     2009   END PROCEDURE.
