        1   block-level on error undo, throw.
        2   define input parameter        p-mode as character no-undo .
        3   define input parameter        p-silent as logical no-undo .
        4   define input-output parameter p-rec  as recid     no-undo .
        5   define input parameter        p-codex-id as integer no-undo .
        6   define input parameter        p-ruleset-id as integer no-undo .
        7   define input parameter        p-rule-id as integer no-undo .
        8   define variable vss-revision    as character no-undo init "$Revision$":U .
        9   define variable vss-author      as character no-undo init "$Author$":U .
       10   define variable vss-date        as character no-undo init "$Date$":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       12   define variable vss-archive     as character no-undo init "$Archive$":U .
       13   define variable vss-description as character no-undo init "Сохранение привязки rule к ruleset".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define new global shared variable g#library  as handle no-undo .
       73   define new global shared variable g#library2 as handle no-undo .
       74   define   shared variable g#auto as logical no-undo.
       75   define   shared variable g#news as logical no-undo.
       76   define   shared variable g#oxml as logical no-undo.
       77   define   shared variable g#esys as logical no-undo.
       78   define   shared variable g#news-source-db as integer no-undo.
       79   define   shared variable g#esys-source-esys as integer no-undo.
       80   define   shared variable g#db-num as integer   no-undo .
       81   define   shared variable g#userid as character no-undo .
       82   define   shared variable g#passwd as character no-undo .
       83   define variable v-mess as character no-undo .
       84   define variable v-entry as character no-undo .
       85   define buffer buf_ruleset for dictdb.ruleset.
       86   define buffer buf_rule-by-set for dictdb.rule-by-set.
       87   define buffer buf_rule for dictdb.rule.
       88   if p-mode <> 'ДОБАВЛЕНИЕ':U
       89   then do:
       90     message vss-workfile vss-revision vss-description skip
       91             "Неверный параметр p-mode - " p-mode
       92     view-as alert-box error .
       93     return error '':u.
       94   end.
       95   _main:
       96   do for buf_ruleset
       97   on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
       98   on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
       99   on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
      100   :
      101     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      102       find first buf_ruleset no-lock where
      103                 buf_ruleset.codex_id = p-codex-id
      104             and buf_ruleset.ruleset_id = p-ruleset-id no-error.
      105       if not available buf_ruleset then do:
      106         assign
      107         v-mess = "Не найден набор правил".
      108         run err-mess in this-procedure ( input-output v-mess).
      109         return error (if p-silent = yes then v-mess else '':U).
      110       end.
      111       find first buf_rule no-lock where
      112                 buf_rule.rule_id = p-rule-id no-error.
      113       if not available buf_rule then do:
      114         assign
      115         v-mess = "Не найдено правило c таким №".
      116         run err-mess in this-procedure ( input-output v-mess).
      117         return error (if p-silent = yes then v-mess else '':U).
      118       end.
      119       find first buf_rule share-lock where
      120                 buf_rule.rule_id = p-rule-id no-error.
      121       if buf_rule.sts = integer('-10':U)
      122       or buf_rule.sts = integer('1':U)
      123       or buf_rule.sts = integer('99':U)
      124       or buf_rule.sts = integer('98':U) then do:
      125         assign
      126         v-mess = substitute("Правило находится в статусе &1", entry (lookup (string( buf_rule.sts), '-1,-10,0,1,99,98':U), 'готов,нов,исп,удал,удаление,запр.удал':U)).
      127         run err-mess in this-procedure ( input-output v-mess).
      128         return error (if p-silent = yes then v-mess else 'sts':U).
      129       end.
      130       create buf_rule-by-set.
      131       assign
      132       buf_rule-by-set.codex_id = p-codex-id
      133       buf_rule-by-set.ruleset_id = p-ruleset-id
      134       buf_rule-by-set.rule_id = p-rule-id
      135       .
      136       if buf_rule.sts <> integer('0':U) then do:
      137         buf_rule.sts = integer('0':U).
      138       end.
      139     end.
      140   end.
      141   PROCEDURE err-mess:
      142     DEFINE INPUT-OUTPUT PARAMETER p-mess as character No-UNDO.
      143     CASE p-silent:
      144       when yes then do:
      145         assign
      146         p-mess = substitute("rule-by-set кодекс: &1 набор: &2 объект &3: &4"
      147                            , p-codex-id
      148                            , p-ruleset-id
      149                            , p-rule-id
      150                            , p-mess)
      151         .
      152       end.
      153       when no then do:
      154         message
      155         p-mess
      156         view-as alert-box error .
      157       end.
      158     end.
      159   END PROCEDURE.
