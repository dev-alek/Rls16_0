        1   block-level on error undo, throw.
        2   define input parameter        p-mode as character no-undo .
        3   define input parameter        p-silent as logical no-undo .
        4   define input-output parameter p-rec  as recid     no-undo .
        5   define input parameter        p-dtm-code as integer no-undo .
        6   define input parameter        p-prop-name as character no-undo .
        7   define input parameter        p-prop-label as character no-undo .
        8   define input parameter        p-prop-des as character no-undo .
        9   define input parameter        p-ref-type as character no-undo .
       10   define input parameter        p-storage-place as character no-undo .
       11   define input parameter        p-storage-place-host as character no-undo .
       12   define input parameter        p-storage-place-obj as character no-undo .
       13   define input parameter        p-hist-from-prim as integer no-undo .
       14   define input parameter        p-hist-to-nws as integer no-undo .
       15   define input parameter        p-get-hist-from-nws as integer no-undo .
       16   define input parameter        p-nws-to-hist as integer no-undo .
       17   define input parameter        p-smart-nws as integer no-undo .
       18   define input parameter        p-nws-to-cd as integer no-undo .
       19   define input parameter        p-general as character no-undo .
       20   define input parameter        p-general-view as character no-undo .
       21   define variable vss-revision    as character no-undo init "$Revision$":U .
       22   define variable vss-author      as character no-undo init "$Author$":U .
       23   define variable vss-date        as character no-undo init "$Date$":U .
       24   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       25   define variable vss-archive     as character no-undo init "$Archive$":U .
       26   define variable vss-description as character no-undo init "Сохранение prop-head".
       27   procedure vss-get-info :
       28     define output parameter p-vss-revision    like vss-revision    no-undo .
       29     define output parameter p-vss-author      like vss-author      no-undo .
       30     define output parameter p-vss-date        like vss-date        no-undo .
       31     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       32     define output parameter p-vss-archive     like vss-archive     no-undo .
       33     define output parameter p-vss-description like vss-description no-undo .
       34     assign
       35       p-vss-revision    = vss-revision
       36       p-vss-author      = vss-author
       37       p-vss-date        = vss-date
       38       p-vss-workfile    = vss-workfile
       39       p-vss-archive     = vss-archive
       40       p-vss-description = vss-description
       41     .
       42   end procedure.
       43   procedure vss-get-parameters :
       44     define output parameter p-vss-parameters as character no-undo .
       45   end procedure.
       46   define new global shared variable g#vssrevis-logger as handle    no-undo .
       47   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       48   define variable v-vssrevis-logger                   as handle    no-undo .
       49   procedure vss-logevent :
       50     define input  parameter p-extra-paramters as character no-undo .
       51     define variable v-vssrevis-parameters as character no-undo .
       52     do
       53     on error undo, return error return-value
       54     :
       55       if  valid-handle(v-vssrevis-logger)
       56       and v-vssrevis-logger :get-signature("logevent") <> ""
       57       then do:
       58         run vss-get-parameters in this-procedure
       59           (output v-vssrevis-parameters
       60           ).
       61         run logevent in v-vssrevis-logger
       62           (input vss-workfile
       63           ,input vss-revision
       64           ,input v-vssrevis-parameters
       65           ,input p-extra-paramters
       66           ).
       67       end.
       68     end.
       69   end procedure.
       70   assign
       71     v-vssrevis-logger = g#vssrevis-logger
       72   .
       73   if  valid-handle(v-vssrevis-logger)
       74   and v-vssrevis-logger :get-signature("logevent") <> ""
       75   then do:
       76     assign
       77       v-vssrevis-logevent = true
       78     .
       79     run vss-logevent in this-procedure (input vss-description) .
       80   end.
       81   define new global shared variable g#language as character no-undo .
       82   if g#language <> '' and g#language <> 'rus':U then do:
       83     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       84   end.
       85   define new global shared variable g#library  as handle no-undo .
       86   define new global shared variable g#library2 as handle no-undo .
       87   define   shared variable g#auto as logical no-undo.
       88   define   shared variable g#news as logical no-undo.
       89   define   shared variable g#oxml as logical no-undo.
       90   define   shared variable g#esys as logical no-undo.
       91   define   shared variable g#news-source-db as integer no-undo.
       92   define   shared variable g#esys-source-esys as integer no-undo.
       93   define   shared variable g#db-num as integer   no-undo .
       94   define   shared variable g#userid as character no-undo .
       95   define   shared variable g#passwd as character no-undo .
       96   define variable v-mess as character no-undo .
       97   define variable v-entry as character no-undo .
       98   define variable v-ii as integer no-undo .
       99   define buffer buf_prop-head for ub.prop-head.
      100   define buffer buf2_prop-head for ub.prop-head.
      101   if p-mode <> 'ДОБАВЛЕНИЕ':U
      102   AND p-mode <> 'ИЗМЕНЕНИЕ':U then do:
      103     message vss-workfile vss-revision vss-description skip
      104             "Неверный параметр p-mode - " p-mode
      105     view-as alert-box error .
      106     return error '':u.
      107   end.
      108   if g#db-num <> 0 then do:
      109     message vss-workfile vss-revision vss-description skip
      110             "Запрещено вызывать процедуру в УБД"
      111     view-as alert-box error .
      112     return error '':u.
      113   end.
      114   _main:
      115   do for buf_prop-head
      116   on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      117   on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
      118   on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
      119   :
      120     if p-dtm-code = 0 then do:
      121       assign
      122       v-mess = "Код объекта-операнда не может = 0".
      123       run err-mess in this-procedure ( input-output v-mess).
      124       return error (if p-silent = yes then v-mess else 'dtm-code':U).
      125     end.
      126     if p-prop-name = '':u then do:
      127       assign
      128       v-mess = "Имя объекта-операнда не может быть пустым".
      129       run err-mess in this-procedure ( input-output v-mess).
      130       return error (if p-silent = yes then v-mess else 'prop-name':U).
      131     end.
      132     if p-prop-label = '':u then do:
      133       assign
      134       v-mess = "Лейбл объекта-операнда не может быть пустым".
      135       run err-mess in this-procedure ( input-output v-mess).
      136       return error (if p-silent = yes then v-mess else 'prop-label':U).
      137     end.
      138     if p-storage-place <> chr(63)
      139     and p-storage-place <> '':U then do:
      140       find first _file no-lock where
      141                 _file._file-name = p-storage-place
      142             and _file._hidden = no no-error.
      143       if not available _file then do:
      144         assign
      145         v-mess = "Неверно определено место хранения данных (глоб)".
      146         run err-mess in this-procedure ( input-output v-mess).
      147         return error (if p-silent = yes then v-mess else 'storage-place':U).
      148       end.
      149     end.
      150     if p-storage-place-host <> chr(63)
      151     and p-storage-place-host <> '':U then do:
      152       find first _file no-lock where
      153                 _file._file-name = p-storage-place-host
      154             and _file._hidden = no no-error.
      155       if not available _file then do:
      156         assign
      157         v-mess = "Неверно опрeделено место хранения данных (фирма)".
      158         run err-mess in this-procedure ( input-output v-mess).
      159         return error (if p-silent = yes then v-mess else 'storage-place-host':U).
      160       end.
      161     end.
      162     if p-storage-place-obj <> chr(63)
      163     and p-storage-place-obj <> '':U then do:
      164       find first _file no-lock where
      165                 _file._file-name = p-storage-place-obj
      166             and _file._hidden = no no-error.
      167       if not available _file then do:
      168         assign
      169         v-mess = "Неверно опрeделено место хранения данных (объект)".
      170         run err-mess in this-procedure ( input-output v-mess).
      171         return error (if p-silent = yes then v-mess else 'storage-place-obj':U).
      172       end.
      173     end.
      174     if p-general <> '':U then do:
      175       do v-ii = 1 to num-entries(p-general):
      176         if lookup(entry(v-ii, p-general), 'dis-card-type,Loyalty,dc-storage,dc-prop,goods':U) = 0 then do:
      177           assign
      178           v-mess = "Неверно опрeделено предназначение".
      179           run err-mess in this-procedure ( input-output v-mess).
      180           return error (if p-silent = yes then v-mess else 'general':U).
      181         end.
      182       end.
      183     end.
      184     if p-general-view <> '':U then do:
      185       do v-ii = 1 to num-entries(p-general-view):
      186         if lookup(entry(v-ii, p-general-view), 'dis-card-type,Loyalty,Loyalty2,dc-storage,dc-prop,goods':U) = 0 then do:
      187           assign
      188           v-mess = "Неверно опрeделено представление".
      189           run err-mess in this-procedure ( input-output v-mess).
      190           return error (if p-silent = yes then v-mess else 'general-view':U).
      191         end.
      192       end.
      193     end.
      194     if p-ref-type <> '':U and
      195     LOOKUP(p-ref-type, 'blank,period,sel-goods,one-ptrl':U) = 0 then do:
      196         assign
      197         v-mess = "Неверно опрeделен тип итога/среза".
      198         run err-mess in this-procedure ( input-output v-mess).
      199         return error (if p-silent = yes then v-mess else 'ref-type':U).
      200     end.
      201     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      202       find first buf_prop-head no-lock where
      203             buf_prop-head.dtm-code = p-dtm-code no-error.
      204       if available buf_prop-head then do:
      205         assign
      206         v-mess = "Уже существует Объект-операнд c таким кодом".
      207         run err-mess in this-procedure ( input-output v-mess).
      208         return error (if p-silent = yes then v-mess else 'dtm-code':U).
      209       end.
      210       find first buf_prop-head no-lock where
      211             buf_prop-head.prop-name = p-prop-name no-error.
      212       if available buf_prop-head
      213       and buf_prop-head.dtm-code <> p-dtm-code
      214       then do:
      215         assign
      216         v-mess = "Уже существует Объект-операнд c таким именем".
      217         run err-mess in this-procedure ( input-output v-mess).
      218         return error (if p-silent = yes then v-mess else 'prop-name':U).
      219       end.
      220       create buf_prop-head.
      221       assign
      222       buf_prop-head.dtm-code = p-dtm-code
      223       .
      224     end.
      225     if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      226       find first buf_prop-head exclusive-lock where
      227                 recid(buf_prop-head) = p-rec .
      228       if buf_prop-head.dtm-code <> p-dtm-code
      229       then do:
      230         assign
      231         v-mess = substitute("Для уже существующего Объекта-операнда невозможно изменение кода&1" +
      232                                 "старые значения кода: &2"
      233                                 , chr(10)
      234                                 , buf_prop-head.dtm-code)
      235         .
      236         run err-mess in this-procedure ( input-output v-mess).
      237         return error (if p-silent = yes then v-mess else 'dtm-code':U).
      238       end.
      239       find first buf2_prop-head no-lock where
      240             buf2_prop-head.prop-name = p-prop-name no-error.
      241       if available buf2_prop-head
      242       and buf2_prop-head.dtm-code <> p-dtm-code
      243       then do:
      244         assign
      245         v-mess = "Уже существует Объект-операнд c таким именем".
      246         run err-mess in this-procedure ( input-output v-mess).
      247         return error (if p-silent = yes then v-mess else 'prop-name':U).
      248       end.
      249     end.
      250     assign
      251     buf_prop-head.prop-name          = p-prop-name
      252     buf_prop-head.prop-label         = p-prop-label
      253     buf_prop-head.prop-des           = p-prop-des
      254     buf_prop-head.ref-type           = p-ref-type
      255     buf_prop-head.storage-place      = p-storage-place
      256     buf_prop-head.storage-place-host = p-storage-place-host
      257     buf_prop-head.storage-place-obj  = p-storage-place-obj
      258     buf_prop-head.hist-from-prim     = p-hist-from-prim
      259     buf_prop-head.hist-to-nws        = p-hist-to-nws
      260     buf_prop-head.get-hist-from-nws  = p-get-hist-from-nws
      261     buf_prop-head.nws-to-hist        = p-nws-to-hist
      262     buf_prop-head.smart-nws          = p-smart-nws
      263     buf_prop-head.nws-to-cd          = p-nws-to-cd
      264     buf_prop-head.general            = p-general
      265     buf_prop-head.general-view       = p-general-view
      266     p-rec = recid(buf_prop-head)
      267     .
      268     release buf_prop-head no-error.
      269     if error-status:error then do:
      270         assign
      271         v-mess = substitute("Ошибка при сохранении записи:&1&2&1&3", chr(10), error-status:get-message(1) , return-value ).
      272         run err-mess in this-procedure ( input-output v-mess).
      273         return error (if p-silent = yes then v-mess else 'prop-name':U).
      274     end.
      275   end.
      276   PROCEDURE err-mess:
      277     DEFINE INPUT-OUTPUT PARAMETER p-mess as character No-UNDO.
      278     CASE p-silent:
      279       when yes then do:
      280         assign
      281         p-mess = substitute("prop-head код: &1 &2"
      282                            , p-dtm-code
      283                            , p-mess)
      284         .
      285       end.
      286       when no then do:
      287         message
      288         p-mess
      289         view-as alert-box error .
      290       end.
      291     end.
      292   END PROCEDURE.
