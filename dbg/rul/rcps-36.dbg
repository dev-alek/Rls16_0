     3708   PROCEDURE fill-table :
     3709   FOR EACH tt-rule-call-param:
     3710       DELETE tt-rule-call-param.
     3711   END.
     3712    FOR EACH tt0-rule-call-param:
     3713      IF p-mode <> 'ДОБАВЛЕНИЕ':U THEN DO:
     3714        IF p-call-id <> '':U and p-call-id <> tt0-rule-call-param.call_id THEN NEXT.
     3715        IF p-codex-id <> 0 and p-codex-id <> tt0-rule-call-param.codex_id THEN NEXT.
     3716        IF p-ruleset-id <> 0 and p-ruleset-id <> tt0-rule-call-param.ruleset_id THEN NEXT.
     3717        IF p-rule-id <> 0 and p-rule-id <> tt0-rule-call-param.RULE_id THEN NEXT.
     3718        IF p-order-id <> ? and p-order-id <> tt0-rule-call-param.order_id THEN NEXT.
     3719      END.
     3720      IF p-list-mode = 'rp-rule-param':U
     3721      or p-list-mode = 'rp-rule-param':U  + chr(44) + 'все':U
     3722      THEN DO:
     3723         IF p-profile-id <> 0 AND p-profile-id <> tt0-rule-call-param.profile_id THEN NEXT.
     3724         IF p-once-more <> ? AND p-once-more <> tt0-rule-call-param.once-more THEN NEXT.
     3725      END.
     3726      CREATE tt-rule-call-param.
     3727      BUFFER-COPY tt0-rule-call-param TO tt-rule-call-param
     3728      .
     3729   END.
     3730   END PROCEDURE.
     3731   PROCEDURE MyEnable :
     3732   DEFINE VARIABLE v-ii AS INTEGER NO-UNDO.
     3733   DEFINE VARIABLE v-ch0 AS widget-handle NO-UNDO.
     3734   DEFINE BUFFER buf_ruledict-param FOR ub.ruledict-param.
     3735   DEFINE BUFFER buf_rp-rule-param FOR ub.rp-rule-param.
     3736   DEFINE BUFFER buf_tt-rule-call-param FOR tt-rule-call-param.
     3737   DEFINE BUFFER buf_cli-grp FOR ub.cli-grp.
     3738   DEFINE BUFFER buf_term_tt-rule-call-param FOR tt-rule-call-param.
     3739   DEFINE BUFFER buf_conf-import FOR conf-import.
     3740   DEFINE BUFFER buf2_conf-import FOR conf-import.
     3741   FOR EACH  buf_ruledict-param NO-LOCK WHERE
     3742       buf_ruledict-param.entry-id = v-rcps-entry-id
     3743     ,FIRST buf_rp-rule-param WHERE
     3744         buf_rp-rule-param.profile_id = p-profile-id
     3745     AND buf_rp-rule-param.rp-param-name = buf_ruledict-param.param-name
     3746   , first buf_tt-rule-call-param WHERE
     3747      buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3748   AND buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3749   AND buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3750   AND buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     3751    ,each buf_term_tt-rule-call-param where
     3752          buf_term_tt-rule-call-param.call_id = buf_tt-rule-call-param.call_id
     3753      and buf_term_tt-rule-call-param.codex_id = buf_tt-rule-call-param.codex_id
     3754      and buf_term_tt-rule-call-param.ruleset_id = buf_tt-rule-call-param.ruleset_id
     3755      and buf_term_tt-rule-call-param.order_id = buf_tt-rule-call-param.order_id
     3756      and buf_term_tt-rule-call-param.param-name = buf_tt-rule-call-param.param-name
     3757     :
     3758     CASE buf_term_tt-rule-call-param.param-name:
     3759         WHEN "p-delimiter" THEN DO:
     3760             delim = buf_tt-rule-call-param.param-value-character.
     3761         END.
     3762         WHEN "p-uniq-method" THEN DO:
     3763             rs-uniq-method = buf_tt-rule-call-param.param-value-character.
     3764         END.
     3765         WHEN "p-default-cli-grp" THEN DO:
     3766             cli-grp-code = buf_tt-rule-call-param.param-value-integer.
     3767         END.
     3768         WHEN "p-firm-fields" THEN DO:
     3769             IF buf_term_tt-rule-call-param.p-index = 0  THEN NEXT.
     3770             FIND FIRST buf_conf-import WHERE
     3771                       buf_conf-import.subject = 'firm':U
     3772                   AND buf_conf-import.full-field-name = buf_term_tt-rule-call-param.param-value-character NO-ERROR.
     3773             IF AVAILABLE buf_conf-import THEN DO:
     3774                buf_conf-import.to-import = yes.
     3775                buf_conf-import.position_ = buf_term_tt-rule-call-param.p-index - 1000.
     3776             END.
     3777         END.
     3778         WHEN "p-person-fields" THEN DO:
     3779             IF buf_term_tt-rule-call-param.p-index = 0  THEN NEXT.
     3780             FIND FIRST buf_conf-import WHERE
     3781                       buf_conf-import.subject = 'person':U
     3782                   AND buf_conf-import.full-field-name = buf_term_tt-rule-call-param.param-value-character NO-ERROR.
     3783             IF AVAILABLE buf_conf-import THEN DO:
     3784                buf_conf-import.to-import = yes.
     3785                buf_conf-import.position_ = buf_term_tt-rule-call-param.p-index - 1000.
     3786             END.
     3787         END.
     3788     END CASE.
     3789   END.
     3790   define variable v-index-id as integer no-undo .
     3791   v-index-id = 0.
     3792   for each buf_conf-import where buf_conf-import.subject = 'firm':U
     3793   and buf_conf-import.to-import = no
     3794   and buf_conf-import.position_ < 1000
     3795   :
     3796    v-index-id = v-index-id + 1.
     3797    buf_conf-import.position = v-index-id  + 1000.
     3798   end.
     3799   v-index-id = 0.
     3800   for each buf_conf-import where buf_conf-import.subject = 'firm':U
     3801   by buf_conf-import.to-import descending
     3802   by buf_conf-import.position
     3803   :
     3804    v-index-id = v-index-id + 1.
     3805    buf_conf-import.position = v-index-id .
     3806   end.
     3807   v-index-id = 0.
     3808   for each buf_conf-import where buf_conf-import.subject = 'person':U
     3809   and buf_conf-import.to-import = no
     3810   and buf_conf-import.position_ < 1000
     3811   :
     3812    v-index-id = v-index-id + 1.
     3813    buf_conf-import.position = v-index-id  + 1000.
     3814   end.
     3815   v-index-id = 0.
     3816   for each buf_conf-import where buf_conf-import.subject = 'person':U
     3817   by buf_conf-import.to-import descending
     3818   by buf_conf-import.position
     3819   :
     3820    v-index-id = v-index-id + 1.
     3821    buf_conf-import.position = v-index-id .
     3822   end.
     3823   ASSIGN
     3824   FRAME Dialog-Frame:TITLE = substitute("Параметры импорта клиентов по профайлу &1", p-profile-id).
     3825   assign
     3826   delim:LIST-ITEM-PAIRS IN FRAME Dialog-Frame = "Точка с запятой (;)" + chr(44) + ";" + chr(44) +
     3827                            "Тильда (~)" + chr(44) + "~~" + chr(44) +
     3828                             "Табулятор" + chr(44) + "~t"
     3829   .
     3830   ASSIGN
     3831   firm_conf-import.to-import:READ-ONLY IN BROWSE br-firm = YES
     3832   person_conf-import.to-import:READ-ONLY IN BROWSE br-person = YES
     3833   rs-uniq-method:radio-buttons = "Название" + chr(44) + "obj-name" + chr(44) +
     3834                                  "ИНН" + "+" + "КПП" + chr(44) + "inn+kpp".
     3835   .
     3836   ASSIGN
     3837   term_tt-rule-call-param.param-label:RESIZABLE IN browse br-rcp = YES
     3838   X_rp-rule-param.rp-param-name:RESIZABLE IN browse br-rcp = YES
     3839   .
     3840   ASSIGN
     3841   v-ch0 = br-rcp:FIRST-COLUMN IN FRAME Dialog-Frame.
     3842   REPEAT WHILE valid-handle(v-ch0):
     3843      IF v-ch0:LABEL = "Значение!(строковое)" THEN DO:
     3844        v-ch[1] = v-ch0.
     3845        v-ch0:VISIBLE = NO.
     3846      END.
     3847      IF v-ch0:LABEL = "Значение!(Дата)" THEN DO:
     3848        v-ch[2] = v-ch0.
     3849        v-ch0:VISIBLE = NO.
     3850      END.
     3851      IF v-ch0:LABEL = "Значение!(Десятичное)" THEN DO:
     3852        v-ch[3] = v-ch0.
     3853        v-ch0:VISIBLE = NO.
     3854      END.
     3855      IF v-ch0:LABEL = "Значение!(Целое)" THEN DO:
     3856        v-ch[4] = v-ch0.
     3857        v-ch0:VISIBLE = NO.
     3858      END.
     3859      IF v-ch0:LABEL = "Значение!(Логическое)" THEN DO:
     3860        v-ch[5] = v-ch0.
     3861        v-ch0:VISIBLE = NO.
     3862      END.
     3863      IF v-ch0:LABEL = "Точка вызова" THEN DO:
     3864        v-ch[6] = v-ch0.
     3865      END.
     3866      IF v-ch0:LABEL = "Значение" THEN
     3867      v-ch0:RESIZABLE = YES.
     3868      v-ch0 = v-ch0:NEXT-COLUMN.
     3869   END.
     3870   assign
     3871   X_rp-rule-param.rp-param-name:resizable in browse br-rcp = yes
     3872   term_tt-rule-call-param.param-name:resizable in browse br-rcp = yes
     3873   term_tt-rule-call-param.param-label:resizable in browse br-rcp = yes
     3874   .
     3875   CASE p-list-mode:
     3876     WHEN 'rule-call-param':U THEN DO:
     3877        ASSIGN
     3878        X_rp-rule-param.rp-param-name:VISIBLE IN BROWSE br-rcp = NO
     3879        .
     3880     END.
     3881     WHEN 'rp-rule-param':U
     3882     or
     3883     when 'rp-rule-param':U + chr(44) + 'все':U
     3884     THEN DO:
     3885       assign
     3886       term_tt-rule-call-param.codex_id:VISIBLE IN BROWSE br-rcp = NO
     3887       term_tt-rule-call-param.ruleset_id:VISIBLE IN BROWSE br-rcp = NO
     3888       term_tt-rule-call-param.rule_id:VISIBLE IN BROWSE br-rcp = NO
     3889       term_tt-rule-call-param.order_id:VISIBLE IN BROWSE br-rcp = NO
     3890       term_tt-rule-call-param.param-name:VISIBLE IN BROWSE br-rcp = NO
     3891       term_tt-rule-call-param.param-num:VISIBLE IN BROWSE br-rcp = NO
     3892       .
     3893     END.
     3894   END CASE.
     3895    IF p-call-id <> '':U THEN DO:
     3896      v-ch[6]:VISIBLE = NO.
     3897    END.
     3898     IF p-profile-id <> 0 THEN DO:
     3899      term_tt-rule-call-param.profile_id :VISIBLE IN BROWSE br-rcp= NO.
     3900    END.
     3901     IF p-rule-id <> 0 THEN DO:
     3902      term_tt-rule-call-param.RULE_id :VISIBLE IN BROWSE br-rcp= NO.
     3903    END.
     3904     IF p-once-more <> 0 THEN DO:
     3905      term_tt-rule-call-param.once-more :VISIBLE IN BROWSE br-rcp= NO.
     3906    END.
     3907    FIND FIRST buf_cli-grp NO-LOCK WHERE
     3908        buf_cli-grp.node-code = cli-grp-code NO-ERROR.
     3909   VIEW FRAME Dialog-Frame.
     3910   IF AVAILABLE buf_cli-grp THEN DO:
     3911        assign
     3912        cli-grp-name = buf_cli-grp.node-name
     3913        .
     3914        DISPLAY
     3915        cli-grp-name
     3916        WITH FRAME Dialog-Frame.
     3917    END.
     3918   DISPLAY
     3919   EDITOR-1
     3920   delim
     3921   cli-grp-name
     3922   rs-uniq-method
     3923   WITH FRAME Dialog-Frame.
     3924   ENABLE
     3925   b-up-firm
     3926   b-down-firm
     3927   b-up-person
     3928   b-down-person
     3929   B-exit WHEN p-mode <> 'ПРОСМОТР':U
     3930   B-quit
     3931   B-help
     3932   B-cli-grp
     3933   BR-firm
     3934   BR-person
     3935   br-rcp
     3936   EDITOR-1
     3937   delim
     3938   cli-grp-name
     3939   rs-uniq-method
     3940   WITH FRAME Dialog-Frame.
     3941   RUN rcps_OpenBr in THIS-PROCEDURE.
     3942   HIDE br-rcp IN FRAME Dialog-Frame.
     3943   IF p-mode = 'ПРОСМОТР':U THEN DO:
     3944      ASSIGN
     3945      b-quit:COLUMN = 1
     3946      b-quit:LABEL = "&Выход".
     3947      HIDE
     3948      b-exit
     3949      IN FRAME Dialog-Frame.
     3950   END.
     3951   OPEN QUERY BR-firm FOR EACH firm_conf-import WHERE firm_conf-import.subject = 'firm':U.    OPEN QUERY BR-person FOR EACH person_conf-import WHERE person_conf-import.subject = 'person':U.
     3952   apply "value-changed" to br-firm.
     3953   apply "value-changed" to br-person.
     3954   END PROCEDURE.
     3955   PROCEDURE Openbr :
     3956   CASE p-list-mode:
     3957     WHEN 'rp-rule-param':U THEN DO:
     3958         OPEN QUERY br-rcp
     3959         FOR EACH  X_ruledict-param NO-LOCK WHERE X_ruledict-param.entry-id = v-rcps-entry-id
     3960             ,FIRST X_rp-rule-param WHERE
     3961                 X_rp-rule-param.profile_id = p-profile-id
     3962             AND X_rp-rule-param.rp-param-name = X_ruledict-param.param-name
     3963           , first tt-rule-call-param WHERE
     3964              tt-rule-call-param.codex_id = X_rp-rule-param.codex_id
     3965          AND tt-rule-call-param.ruleset_id = X_rp-rule-param.ruleset_id
     3966          AND tt-rule-call-param.rule_id = X_rp-rule-param.rule_id
     3967          AND tt-rule-call-param.param-name = X_rp-rule-param.rule-param-name
     3968            ,each term_tt-rule-call-param where
     3969                  term_tt-rule-call-param.call_id = tt-rule-call-param.call_id
     3970              and term_tt-rule-call-param.codex_id = tt-rule-call-param.codex_id
     3971              and term_tt-rule-call-param.ruleset_id = tt-rule-call-param.ruleset_id
     3972              and term_tt-rule-call-param.order_id = tt-rule-call-param.order_id
     3973              and term_tt-rule-call-param.param-name = tt-rule-call-param.param-name
     3974         BY tt-rule-call-param.call_id
     3975         BY tt-rule-call-param.codex_id
     3976         BY tt-rule-call-param.ruleset_id
     3977         BY tt-rule-call-param.order_id
     3978         BY tt-rule-call-param.param-num.
     3979     END.
     3980   END CASE.
     3981   apply "ENTRY" to br-rcp in frame Dialog-Frame .
     3982   APPLy "VALUE-CHANGED" to br-rcp.
     3983   END PROCEDURE.
     3984   PROCEDURE proc-b-add :
     3985   DEFINE INPUT PARAMETER p-profile-id AS integer NO-UNDO.
     3986   DEFINE INPUT PARAMETER p-once-more AS integer NO-UNDO.
     3987   DEFINE INPUT PARAMETER p-rp-param-name AS CHARACTER NO-UNDO.
     3988   DEFINE INPUT PARAMETER p-call-id AS CHARACTER NO-UNDO.
     3989   DEFINE INPUT PARAMETER p-index AS integer NO-UNDO.
     3990   define variable v-ind as integer no-undo .
     3991   define buffer buf_tt-rule-call-param for tt-rule-call-param.
     3992   define buffer buf0_tt-rule-call-param for tt-rule-call-param.
     3993   define buffer buf2_tt-rule-call-param for tt-rule-call-param.
     3994   define buffer buf_rp-rule-param for ub.rp-rule-param.
     3995   FOR FIRST buf_rp-rule-param WHERE
     3996             buf_rp-rule-param.profile_id = p-profile-id
     3997         AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     3998       , first buf0_tt-rule-call-param WHERE
     3999          buf0_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     4000      AND buf0_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     4001      AND buf0_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     4002      AND buf0_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name:
     4003     LEAVE.
     4004   END.
     4005   IF NOT AVAILABLE buf0_tt-rule-call-param THEN do:
     4006     BELL.
     4007     RETURN.
     4008   END.
     4009   for each buf_rp-rule-param where
     4010           buf_rp-rule-param.rp-param-name = p-rp-param-name
     4011       and buf_rp-rule-param.profile_id = p-profile-id,
     4012       first buf_tt-rule-call-param where
     4013           buf_tt-rule-call-param.call_id = buf0_tt-rule-call-param.call_id
     4014       and buf_tt-rule-call-param.profile_id = buf_rp-rule-param.profile_id
     4015       and buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     4016       and buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     4017       and buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     4018       and buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     4019       and buf_tt-rule-call-param.once-more = buf0_tt-rule-call-param.once-more
     4020       and buf_tt-rule-call-param.p-index = p-index:
     4021     RETURN.
     4022   END.
     4023   IF lookup("LIST", buf0_tt-rule-call-param.param-3-data-type) = 0
     4024   and lookup("SORTED-LIST", buf0_tt-rule-call-param.param-3-data-type) = 0
     4025   THEN DO:
     4026     BELL.
     4027     RETURN.
     4028   END.
     4029   IF buf0_tt-rule-call-param.p-index <> 0 THEN DO:
     4030     BELL.
     4031     RETURN.
     4032   END.
     4033   find last buf_tt-rule-call-param where
     4034            buf_tt-rule-call-param.call_id = buf0_tt-rule-call-param.call_id
     4035        and buf_tt-rule-call-param.codex_id = buf0_tt-rule-call-param.codex_id
     4036        and buf_tt-rule-call-param.ruleset_id = buf0_tt-rule-call-param.ruleset_id
     4037        and buf_tt-rule-call-param.order_id = buf0_tt-rule-call-param.order_id
     4038        and buf_tt-rule-call-param.param-name = buf0_tt-rule-call-param.param-name no-error .
     4039   if available buf_tt-rule-call-param
     4040   and (lookup("LIST", buf_tt-rule-call-param.param-3-data-type) > 0
     4041        or
     4042        lookup("SORTED-LIST", buf_tt-rule-call-param.param-3-data-type) > 0
     4043        )
     4044   and buf_tt-rule-call-param.p-index > 0 then do:
     4045     v-ind = buf_tt-rule-call-param.p-index.
     4046   end.
     4047   for each buf_rp-rule-param where
     4048           buf_rp-rule-param.rp-param-name = p-rp-param-name
     4049       and buf_rp-rule-param.profile_id = p-profile-id,
     4050       first buf_tt-rule-call-param where
     4051           buf_tt-rule-call-param.call_id = buf0_tt-rule-call-param.call_id
     4052       and buf_tt-rule-call-param.profile_id = buf_rp-rule-param.profile_id
     4053       and buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     4054       and buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     4055       and buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     4056       and buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     4057       and buf_tt-rule-call-param.once-more = buf0_tt-rule-call-param.once-more
     4058       and buf_tt-rule-call-param.p-index = 0
     4059   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4060   on stop   undo, return error substitute( "&1. stop", vss-workfile )
     4061   on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     4062   :
     4063     create buf2_tt-rule-call-param.
     4064     buffer-copy buf_tt-rule-call-param
     4065     except p-index
     4066     to buf2_tt-rule-call-param
     4067     assign
     4068     buf2_tt-rule-call-param.p-index = v-ind + 1
     4069     .
     4070   end.
     4071   run rcps_Openbr in this-procedure .
     4072   END PROCEDURE.
     4073   PROCEDURE proc-b-chg PRIVATE :
     4074   DEFINE VARIABLE v-rec1 AS Rowid NO-UNDO.
     4075   DEFINE VARIABLE v-rec2 AS Rowid NO-UNDO.
     4076   DEFINE VARIABLE v-rec3 AS Rowid NO-UNDO.
     4077   DEFINE VARIABLE v-rec4 AS Rowid NO-UNDO.
     4078   define variable v-param-data-type as character no-undo .
     4079   define variable v-rid-list as character no-undo .
     4080   IF NOT AVAILABLE TERM_tt-rule-call-param  THEN DO:
     4081     RETURN ERROR.
     4082   END.
     4083   ASSIGN
     4084   v-rec1 = rowid(X_ruledict-param)
     4085   v-rec2 = rowid(X_rp-rule-param)
     4086   v-rec3 = Rowid(tt-rule-call-param)
     4087   v-rec4 = Rowid(term_tt-rule-call-param)
     4088   .
     4089   run rcps_openbr in this-procedure .
     4090   REPOSITION br-rcp TO Rowid v-rec1, v-rec2,v-rec3, v-rec4 NO-ERROR.
     4091   IF ERROR-STATUS:ERROR THEN DO:
     4092     REPOSITION br-rcp TO ROW 1 NO-ERROR.
     4093   END.
     4094   APPLY "ENTRY" TO br-rcp in frame Dialog-Frame .
     4095   APPLY "VALUE-CHANGED" TO br-rcp in frame Dialog-Frame .
     4096   END PROCEDURE.
     4097   PROCEDURE proc-b-del :
     4098   DEFINE INPUT PARAMETER p-profile-id AS integer NO-UNDO.
     4099   DEFINE INPUT PARAMETER p-once-more AS integer NO-UNDO.
     4100   DEFINE INPUT PARAMETER p-rp-param-name AS CHARACTER NO-UNDO.
     4101   DEFINE INPUT PARAMETER p-call-id AS CHARACTER NO-UNDO.
     4102   DEFINE INPUT PARAMETER p-index AS integer NO-UNDO.
     4103   define variable v-ind as integer no-undo .
     4104   define variable v-once-more as integer no-undo .
     4105   define variable v-call-id as character no-undo .
     4106   define buffer buf0_tt-rule-call-param for tt-rule-call-param.
     4107   define buffer buf_tt-rule-call-param for tt-rule-call-param.
     4108   define buffer buf_rp-rule-param for ub.rp-rule-param.
     4109   FOR FIRST buf_rp-rule-param WHERE
     4110             buf_rp-rule-param.profile_id = p-profile-id
     4111         AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     4112       , first buf0_tt-rule-call-param WHERE
     4113          buf0_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     4114      AND buf0_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     4115      AND buf0_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     4116      AND buf0_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name:
     4117     LEAVE.
     4118   END.
     4119   IF NOT AVAILABLE buf0_tt-rule-call-param THEN do:
     4120     BELL.
     4121     RETURN.
     4122   END.
     4123   IF lookup("LIST", buf0_tt-rule-call-param.param-3-data-type) = 0
     4124   and lookup("SORTED-LIST", buf0_tt-rule-call-param.param-3-data-type) = 0
     4125   THEN DO:
     4126     BELL.
     4127     RETURN.
     4128   END.
     4129   IF lookup("READ-ONLY", buf0_tt-rule-call-param.param-3-data-type) > 0 THEN DO:
     4130     BELL.
     4131     RETURN.
     4132   END.
     4133   IF buf0_tt-rule-call-param.p-index  = 0 THEN DO:
     4134     BELL.
     4135     RETURN.
     4136   END.
     4137   assign
     4138   v-ind = buf0_tt-rule-call-param.p-index
     4139   v-once-more = tt-rule-call-param.once-more
     4140   v-call-id = tt-rule-call-param.call_id
     4141   .
     4142   for each buf_rp-rule-param where
     4143           buf_rp-rule-param.rp-param-name = buf_rp-rule-param.rp-param-name
     4144       and buf_rp-rule-param.profile_id = buf_rp-rule-param.profile_id,
     4145       first buf_tt-rule-call-param where
     4146           buf_tt-rule-call-param.call_id = v-call-id
     4147       and buf_tt-rule-call-param.profile_id = buf_rp-rule-param.profile_id
     4148       and buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     4149       and buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     4150       and buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     4151       and buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     4152       and buf_tt-rule-call-param.once-more = v-once-more
     4153       and buf_tt-rule-call-param.p-index = v-ind
     4154   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4155   on stop   undo, return error substitute( "&1. stop", vss-workfile )
     4156   on endkey undo, return error substitute( "&1. endkey", vss-workfile ):
     4157       DELETE buf_tt-rule-call-param.
     4158   end.
     4159   run rcps_Openbr in this-procedure .
     4160   END PROCEDURE.
     4161   PROCEDURE proc-save :
     4162   define variable mydelimiter as char no-undo.
     4163   DEFINE VARIABLE v-ii AS INTEGER NO-UNDO.
     4164   define variable v-file-name as character no-undo .
     4165   define variable v-glog as logical no-undo .
     4166   DEFINE BUFFER buf_conf-import FOR conf-import.
     4167   DEFINE BUFFER buf_cli-grp FOR ub.cli-grp.
     4168   DEFINE BUFFER buf_tt-rule-call-param FOR tt-rule-call-param.
     4169   assign
     4170   FRAME Dialog-Frame
     4171   delim
     4172   rs-uniq-method
     4173   .
     4174   if delim = "" then do:
     4175     message "Не выбран символ-разделитель колонок в файле импорта!"
     4176     view-as alert-box.
     4177     return no-apply.
     4178   end.
     4179   FIND FIRST buf_cli-grp No-LOCK WHERE buf_cli-grp.node-code = cli-grp-code No-ERROR.
     4180   IF NOT avail buf_cli-grp then do:
     4181     message "Не выбрана группа клиентов или группа клиентов неверна!"
     4182     view-as alert-box error.
     4183       return no-APPLY.
     4184   end.
     4185   assign
     4186   mydelimiter = delim
     4187   mydelimiter = if mydelimiter = "~t":U
     4188                 then chr(9)
     4189                 else mydelimiter
     4190   .
     4191   RUN rcps_set-value IN THIS-PROCEDURE (
     4192                                    INPUT p-profile-id
     4193                                   ,INPUT p-once-more
     4194                                   ,INPUT p-call-id
     4195                                   ,INPUT "p-default-cli-grp"
     4196                                   ,INPUT 0
     4197                                   ,INPUT ''
     4198                                   ,INPUT ?
     4199                                   ,INPUT 0.0
     4200                                   ,INPUT cli-grp-code
     4201                                   ,INPUT NO
     4202                                   ).
     4203   RUN rcps_set-value IN THIS-PROCEDURE (
     4204                                    INPUT p-profile-id
     4205                                   ,INPUT p-once-more
     4206                                   ,INPUT p-call-id
     4207                                   ,INPUT "p-delimiter"
     4208                                   ,INPUT 0
     4209                                   ,INPUT mydelimiter
     4210                                   ,INPUT ?
     4211                                   ,INPUT 0.0
     4212                                   ,INPUT 0
     4213                                   ,INPUT NO
     4214                                   ).
     4215   RUN rcps_set-value IN THIS-PROCEDURE (
     4216                                    INPUT p-profile-id
     4217                                   ,INPUT p-once-more
     4218                                   ,INPUT p-call-id
     4219                                   ,INPUT "p-uniq-method"
     4220                                   ,INPUT 0
     4221                                   ,INPUT rs-uniq-method
     4222                                   ,INPUT ?
     4223                                   ,INPUT 0.0
     4224                                   ,INPUT 0
     4225                                   ,INPUT NO
     4226                                   ).
     4227   v-ii = 0.
     4228   FOR EACH buf_conf-import WHERE
     4229      buf_conf-import.subject = 'firm':U
     4230   AND buf_conf-import.to-import = YES
     4231   BY buf_conf-import.subject
     4232   BY buf_conf-import.POSITION_
     4233   :
     4234       v-ii = v-ii + 1.
     4235      RUN rcps_proc-b-add IN THIS-PROCEDURE (
     4236                                        INPUT p-profile-id
     4237                                       ,INPUT p-once-more
     4238                                       ,INPUT p-call-id
     4239                                       ,INPUT "p-firm-fields"
     4240                                                  ,INPUT v-ii).
     4241      RUN rcps_set-value IN THIS-PROCEDURE (
     4242                                       INPUT p-profile-id
     4243                                      ,INPUT p-once-more
     4244                                                                 ,INPUT p-call-id
     4245                                      ,INPUT "p-firm-fields"
     4246                                      ,INPUT v-ii
     4247                                      ,INPUT buf_conf-import.full-field-name
     4248                                      ,INPUT ?
     4249                                      ,INPUT 0.0
     4250                                      ,INPUT 0
     4251                                      ,INPUT NO
     4252                                      ).
     4253   END.
     4254   FOR EACH buf_tt-rule-call-param:
     4255      IF buf_tt-rule-call-param.param-name = "p-firm-fields"
     4256      AND buf_tt-rule-call-param.p-index > v-ii THEN DELETE buf_tt-rule-call-param.
     4257   END.
     4258   v-ii = 0.
     4259   FOR EACH buf_conf-import WHERE
     4260      buf_conf-import.subject = 'person':U
     4261   AND buf_conf-import.to-import = YES
     4262   BY buf_conf-import.subject
     4263   BY buf_conf-import.POSITION_
     4264   :
     4265       v-ii = v-ii + 1.
     4266       RUN rcps_proc-b-add IN THIS-PROCEDURE (
     4267                                         INPUT p-profile-id
     4268                                        ,INPUT p-once-more
     4269                                        ,INPUT p-call-id
     4270                                        ,INPUT "p-person-fields"
     4271                                        ,INPUT v-ii).
     4272       RUN rcps_set-value IN THIS-PROCEDURE (
     4273                                        INPUT p-profile-id
     4274                                       ,INPUT p-once-more
     4275                                       ,INPUT p-call-id
     4276                                       ,INPUT "p-person-fields"
     4277                                       ,INPUT v-ii
     4278                                       ,INPUT buf_conf-import.full-field-name
     4279                                       ,INPUT ?
     4280                                       ,INPUT 0.0
     4281                                       ,INPUT 0
     4282                                       ,INPUT NO
     4283                                      ).
     4284   END.
     4285   FOR EACH buf_tt-rule-call-param:
     4286      IF buf_tt-rule-call-param.param-name = "p-person-fields"
     4287      AND buf_tt-rule-call-param.p-index > v-ii THEN DELETE buf_tt-rule-call-param.
     4288   END.
     4289   RUN rcps_proc-save0 IN THIS-PROCEDURE .
     4290   END PROCEDURE.
     4291   PROCEDURE save-one-parameter :
     4292   END PROCEDURE.
     4293   PROCEDURE set-row-color-firm :
     4294   DEFINE INPUT PARAMETER p-is-mandatory AS LOGICAL NO-UNDO.
     4295   DEFINE VARIABLE iFGColor AS INTEGER NO-UNDO.
     4296   DEFINE VARIABLE iBGColor AS INTEGER NO-UNDO.
     4297     IF p-is-mandatory = YES THEN DO:
     4298         ASSIGN
     4299           iFGColor = WHITE_COLOR
     4300           iBGColor = GREY_COLOR
     4301         .
     4302       end.
     4303       ELSE do:
     4304         ASSIGN
     4305           iFGColor = Black_COLOR
     4306           iBGColor = White_COLOR
     4307         .
     4308       end.
     4309   ASSIGN
     4310   firm_conf-import.field-label:FGCOLOR IN BROWSE br-firm = iFGColor
     4311   firm_conf-import.field-label:BGCOLOR IN BROWSE br-firm = iBGColor
     4312   .
     4313   END PROCEDURE.
     4314   PROCEDURE set-row-color-person :
     4315   DEFINE INPUT PARAMETER p-is-mandatory AS LOGICAL NO-UNDO.
     4316   DEFINE VARIABLE iFGColor AS INTEGER NO-UNDO.
     4317   DEFINE VARIABLE iBGColor AS INTEGER NO-UNDO.
     4318     IF p-is-mandatory = YES THEN DO:
     4319         ASSIGN
     4320           iFGColor = WHITE_COLOR
     4321           iBGColor = GREY_COLOR
     4322         .
     4323       end.
     4324       ELSE do:
     4325         ASSIGN
     4326           iFGColor = Black_COLOR
     4327           iBGColor = White_COLOR
     4328         .
     4329       end.
     4330   ASSIGN
     4331   person_conf-import.field-label:FGCOLOR IN BROWSE br-person = iFGColor
     4332   person_conf-import.field-label:BGCOLOR IN BROWSE br-person = iBGColor
     4333   .
     4334   END PROCEDURE.
