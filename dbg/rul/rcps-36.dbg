     1176   DEFINE VARIABLE v-rcps-entry-id AS INTEGER NO-UNDO.
     1177   DEFINE VARIABLE v-uniq-key-rec AS character NO-UNDO.
     1178   DEFINE VARIABLE rule-display-option AS CHARACTER NO-UNDO.
     1179   DEFINE BUFFER buf_Rule-profile FOR ub.rule-profile.
     1180   DEFINE BUFFER buf_Ruledict FOR ub.ruledict.
     1181   DEFINE BUFFER call_tt-rule-call-param FOR tt-rule-call-param.
     1182   define buffer term_tt-rule-call-param for tt-rule-call-param.
