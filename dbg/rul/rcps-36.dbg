     2844     define variable v-change-sign          as integer   no-undo .
     2845     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2846     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2847     if p-change-value > 0
     2848     then do:
     2849       if frame Dialog-Frame :width + p-change-value >
     2850           session :width-chars
     2851       then do:
     2852         assign
     2853           p-change-value = session :width-chars - frame Dialog-Frame :width
     2854         .
     2855         if p-change-value <= 0
     2856         then do:
     2857           run diasize_position-resize-button in this-procedure .
     2858           return .
     2859         end.
     2860       end.
     2861     end.
     2862     if p-change-value < 0
     2863     then do:
     2864       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2865       then do:
     2866         assign
     2867           p-change-value = v-diasize-orig-frame-width
     2868                          - frame Dialog-Frame :width
     2869         .
     2870         if p-change-value >= 0
     2871         then do:
     2872           run diasize_position-resize-button in this-procedure .
     2873           return .
     2874         end.
     2875       end.
     2876     end.
     2877     if p-change-value >= 0
     2878     then do:
     2879       assign
     2880         v-change-sign = 1
     2881       .
     2882     end.
     2883     else do:
     2884       assign
     2885         v-change-sign = -1
     2886       .
     2887     end.
     2888     assign
     2889       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2890     .
     2891     if p-change-value = 0
     2892     then do:
     2893       run diasize_position-resize-button in this-procedure .
     2894       return .
     2895     end.
