     1243   DEFINE VARIABLE EDITOR-1 AS CHARACTER INITIAL "Необязательные поля следуют в строчке файла импорта за обязательными со строгим соблюдением задаваемой последовательности"
     1244        VIEW-AS EDITOR NO-BOX
     1245        SIZE 20 BY 5.2
     1246        FGCOLOR 4  NO-UNDO.
     1247   DEFINE VARIABLE cli-grp-name AS CHARACTER FORMAT "X(256)":U
     1248         VIEW-AS TEXT
     1249        SIZE 64.4 BY 1 NO-UNDO.
     1250   DEFINE VARIABLE Rs-uniq-method AS CHARACTER INITIAL "obj-name"
     1251        VIEW-AS RADIO-SET VERTICAL
     1252        RADIO-BUTTONS
     1253             "Название", "obj-name",
     1254   "INN+KPP", "inn+kpp"
     1255        SIZE 21 BY 2.4 NO-UNDO.
     1256   DEFINE VARIABLE delim AS CHARACTER
     1257        VIEW-AS SELECTION-LIST SINGLE SCROLLBAR-VERTICAL
     1258        LIST-ITEM-PAIRS "Точка с запятой(;)","Точка с запятой(;)",
     1259                        "Тильда()","Тильда()",
     1260                        "Табулятор(     )","Табулятор(     )"
     1261        SIZE 21.8 BY 2.8 NO-UNDO.
     1262   DEFINE QUERY BR-firm FOR
     1263         firm_conf-import SCROLLING.
     1264   DEFINE QUERY BR-person FOR
     1265         person_conf-import SCROLLING.
     1266   DEFINE QUERY BR-rcp FOR
     1267         X_ruledict-param,
     1268         X_rp-rule-param,
     1269         tt-rule-call-param,
     1270         TERM_tt-rule-call-param SCROLLING.
     1271   DEFINE BROWSE BR-firm
     1272     QUERY BR-firm DISPLAY
     1273         firm_conf-import.field-label FORMAT "X(25)" COLUMN-LABEL "Поле"
     1274   firm_conf-import.IS-MANDATORY COLUMN-LABEL "Обяз":U FORMAT "+/"
     1275   firm_conf-import.to-import COLUMN-LABEL "":U VIEW-AS TOGGLE-BOX
     1276   ENABLE
     1277   firm_conf-import.to-import
     1278       WITH NO-ROW-MARKERS SEPARATORS SIZE 39 BY 19
     1279            TITLE "Поля при импорте клиента типа ОРГАНИЗАЦИЯ" ROW-HEIGHT-CHARS .6 FIT-LAST-COLUMN.
     1280   DEFINE BROWSE BR-person
     1281     QUERY BR-person DISPLAY
     1282         person_conf-import.field-label COLUMN-LABEL "Поле" FORMAT "X(25)"
     1283   person_conf-import.IS-MANDATORY COLUMN-LABEL "Обяз":U FORMAT "+/"
     1284   person_conf-import.to-import COLUMN-LABEL "":U VIEW-AS TOGGLE-BOX
     1285   ENABLE
     1286   person_conf-import.to-import
     1287       WITH NO-ROW-MARKERS SEPARATORS SIZE 35.5 BY 19
     1288            TITLE "Поля при импорте клиента типа ФИЗ.ЛИЦО" ROW-HEIGHT-CHARS .6 FIT-LAST-COLUMN.
     1289   DEFINE BROWSE BR-rcp
     1290     QUERY BR-rcp DISPLAY
     1291         X_rp-rule-param.rp-param-name COLUMN-LABEL "Название пар-ра!профайла" FORMAT "X(20)" width 16
     1292   term_tt-rule-call-param.codex_id COLUMN-LABEL "Кодекс"
     1293   term_tt-rule-call-param.ruleset_id COLUMN-LABEL "Набор"
     1294   term_tt-rule-call-param.order_id  COLUMN-LABEL "Порядок!вызова"
     1295   term_tt-rule-call-param.rule_id  COLUMN-LABEL "Правило"
     1296   term_tt-rule-call-param.profile_id  COLUMN-LABEL "Профайл"
     1297   term_tt-rule-call-param.once-more COLUMN-LABEL "№!Привязки"
     1298   (if lookup (term_tt-rule-call-param.param-data-type, 'character,date,datetime,datetime-tz,decimal,integer,void,logical,memptr,raw,recid,rowid,widget-handle,handle,blob,clob,class,com-handle,longchar,int64':U) > 0 then entry (lookup (term_tt-rule-call-param.param-data-type, 'character,date,datetime,datetime-tz,decimal,integer,void,logical,memptr,raw,recid,rowid,widget-handle,handle,blob,clob,class,com-handle,longchar,int64':U), 'строка,дата,дата-время,дата-время-з,десятичное,целое,пусто,логическое,память,двоичные,номер записи,Номер Записи,ссылка,ссылка,Больш.бин.объект,Больш.стр.объект,Объект,COM-объект,Длинная строка,64Целое':U) else term_tt-rule-call-param.param-data-type) COLUMN-LABEL "Тип пар-ра" FORMAT "X(12)"
     1299   term_tt-rule-call-param.param-num COLUMN-LABEL "№!пар-ра" FORMAT ">9"
     1300   TERM_tt-rule-call-param.p-index COLUMN-LABEL "Инд!екс" FORMAT ">9"
     1301   term_tt-rule-call-param.param-name COLUMN-LABEL "Название пар-ра!правила" FORMAT "X(16)"
     1302   term_tt-rule-call-param.param-label COLUMN-LABEL "Название пар-ра" FORMAT "X(255)" WIDTH 30
     1303   entry (lookup (term_tt-rule-call-param.param-mode, 'input,output,input-output,buffer,input table,output table,input-output table':u), 'вх,вых,вх-вых,курсор,вх табл,вых табл,вх/вых табл':u) COLUMN-LABEL "Вид!пар-ра"
     1304   get-param-value( INPUT term_tt-rule-call-param.param-data-type
     1305                   ,INPUT term_tt-rule-call-param.param-2-data-type
     1306                   ,INPUT term_tt-rule-call-param.param-3-data-type
     1307                   ,INPUT TERM_tt-rule-call-param.p-index
     1308                   ,INPUT term_tt-rule-call-param.param-value-character
     1309                   ,INPUT term_tt-rule-call-param.param-value-date
     1310                   ,INPUT term_tt-rule-call-param.param-value-decimal
     1311                   ,INPUT term_tt-rule-call-param.param-value-integer
     1312                   ,INPUT term_tt-rule-call-param.param-value-logical) COLUMN-LABEL "Значение" FORMAT "X(255)" WIDTH 26
     1313   (IF term_tt-rule-call-param.param-data-type = 'character':U
     1314    THEN term_tt-rule-call-param.param-value-character
     1315    ELSE '':U) COLUMN-LABEL "Значение!(строковое)" FORMAT "X(26)"
     1316   (IF term_tt-rule-call-param.param-data-type = 'date':U
     1317   THEN STRING(term_tt-rule-call-param.param-value-date, "99/99/9999")
     1318   ELSE '':U)    COLUMN-LABEL "Значение!(Дата)" FORMAT "X(10)" WIDTH 12
     1319   (IF term_tt-rule-call-param.param-data-type = 'decimal':U
     1320   THEN STRING(term_tt-rule-call-param.param-value-decimal)
     1321   ELSE '':U) COLUMN-LABEL "Значение!(Десятичное)"   FORMAT "X(16)"
     1322   (IF term_tt-rule-call-param.param-data-type = 'integer':U
     1323   THEN STRING(term_tt-rule-call-param.param-value-integer)
     1324   ELSE '':U) COLUMN-LABEL "Значение!(Целое)" FORMAT "X(10)"
     1325   (IF term_tt-rule-call-param.param-data-type = 'logical':U
     1326   THEN STRING(term_tt-rule-call-param.param-value-logical, "+/-")
     1327   ELSE '':U) COLUMN-LABEL "Значение!(Логическое)" FORMAT "X(2)"
     1328   calldscr(tt-rule-call-param.call_id) COLUMN-LABEL  "Точка вызова" FORMAT "X(40)"
     1329       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 6.27
     1330            FONT 4 ROW-HEIGHT-CHARS .67 FIT-LAST-COLUMN.
     1331   DEFINE FRAME Dialog-Frame
     1332        B-exit AT ROW 1 COL 1
     1333        b-quit AT ROW 1 COL 11
     1334        B-Help AT ROW 1 COL 95
     1335        B-cli-grp AT ROW 2.07 COL 94.3 WIDGET-ID 18
     1336        b-up-firm AT ROW 2.93 COL 31.5 WIDGET-ID 24
     1337        b-down-firm AT ROW 2.93 COL 35.5 WIDGET-ID 20
     1338        b-up-person AT ROW 2.93 COL 65 WIDGET-ID 26
     1339        b-down-person AT ROW 2.93 COL 69 WIDGET-ID 22
     1340        BR-firm AT ROW 4 COL 23.5 WIDGET-ID 200
     1341        BR-person AT ROW 4 COL 63 WIDGET-ID 300
     1342        delim AT ROW 6.8 COL 1.5 NO-LABEL WIDGET-ID 30
     1343        EDITOR-1 AT ROW 9.93 COL 2.4 NO-LABEL WIDGET-ID 32
     1344        Rs-uniq-method AT ROW 16.47 COL 1.5 NO-LABEL WIDGET-ID 34
     1345        BR-rcp AT ROW 16.97 COL 1 WIDGET-ID 100
     1346        cli-grp-name AT ROW 2 COL 29.5 NO-LABEL WIDGET-ID 28
     1347        "Символ-разделитель" VIEW-AS TEXT
     1348             SIZE 20 BY .97 AT ROW 4.2 COL 2.1 WIDGET-ID 38
     1349             FGCOLOR 4
     1350        "Группа клиента по умолчанию" VIEW-AS TEXT
     1351             SIZE 28 BY .77 AT ROW 2 COL 1 WIDGET-ID 40
     1352             FGCOLOR 4
     1353        "колонок" VIEW-AS TEXT
     1354             SIZE 19 BY .97 AT ROW 5.2 COL 2.1 WIDGET-ID 42
     1355             FGCOLOR 4
     1356        SPACE(77.90) SKIP(17.08)
     1357       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1358            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1359            TITLE ""
     1360            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
     1361   ASSIGN
     1362          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1363          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1364   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1365   DO:
     1366     APPLY "END-ERROR":U TO SELF.
     1367   END.
     1368   ON CHOOSE OF B-cli-grp IN FRAME Dialog-Frame
     1369   DO:
     1370   define variable rid-list as char no-undo.
     1371   DEFINE BUFFER buf_cli-grp FOR ub.cli-grp.
     1372       run ref/cli-grps.w ( input parparentproc
     1373                           ,input ('терм':U + chr(44) + "b-sel")
     1374                           ,input-output rid-list).
     1375       if rid-list <> "" then do:
     1376           FIND FIRST buf_cli-grp NO-LOCK WHERE
     1377               recid(buf_cli-grp) = integer(rid-list) NO-ERROR.
     1378           IF NOT AVAIL buf_cli-grp then return no-apply.
     1379           assign
     1380           cli-grp-code = buf_cli-grp.node-code
     1381           cli-grp-name = buf_cli-grp.node-name
     1382           .
     1383           DISPLAY
     1384           cli-grp-name
     1385           WITH FRAME Dialog-Frame.
     1386       end.
     1387   END.
     1388   ON CHOOSE OF b-down-firm IN FRAME Dialog-Frame
     1389   DO:
     1390     DEFINE VARIABLE v-rec AS RECID NO-UNDO.
     1391   DEFINE VARIABLE v-new AS INTEGER NO-UNDO.
     1392   DEFINE VARIABLE v-old AS INTEGER NO-UNDO.
     1393   DEFINE BUFFER buf1_conf-import FOR conf-import.
     1394   DEFINE BUFFER buf2_conf-import FOR conf-import.
     1395     IF NOT AVAILABLE firm_conf-import  THEN RETURN NO-APPLY.
     1396     DO TRANSACTION:
     1397        v-rec = recid(firm_conf-import).
     1398        FIND FIRST buf1_conf-import WHERE
     1399                 buf1_conf-import.subject = 'firm':U
     1400             AND buf1_conf-import.POSITION_ = firm_conf-import.POSITION_.
     1401       FIND FIRST buf2_conf-import WHERE
     1402                buf2_conf-import.subject = 'firm':U
     1403            AND buf2_conf-import.POSITION_ > firm_conf-import.POSITION_ NO-ERROR.
     1404       IF NOT AVAILABLE buf2_conf-import THEN DO:
     1405           BELL.
     1406           RETURN NO-APPLY.
     1407       END.
     1408        ASSIGN
     1409        v-old = buf1_conf-import.POSITION_.
     1410        ASSIGN
     1411        v-new = buf2_conf-import.POSITION_.
     1412        ASSIGN
     1413        buf1_conf-import.POSITION_ = 999999999.
     1414        RELEASE buf1_conf-import.
     1415        ASSIGN
     1416        buf2_conf-import.POSITION_ = v-old.
     1417        RELEASE buf2_conf-import.
     1418        FIND FIRST buf1_conf-import WHERE
     1419                   buf1_conf-import.subject = 'firm':U
     1420               AND buf1_conf-import.POSITION_ = 999999999.
     1421        ASSIGN
     1422        buf1_conf-import.POSITION_ = v-new.
     1423     END.
     1424     OPEN QUERY BR-firm FOR EACH firm_conf-import WHERE firm_conf-import.subject = 'firm':U.
     1425     REPOSITION br-firm TO RECID v-rec NO-ERROR.
     1426     apply "entry" TO br-firm.
     1427   END.
     1428   ON CHOOSE OF b-down-person IN FRAME Dialog-Frame
     1429   DO:
     1430    DEFINE VARIABLE v-rec AS RECID NO-UNDO.
     1431   DEFINE VARIABLE v-new AS INTEGER NO-UNDO.
     1432   DEFINE VARIABLE v-old AS INTEGER NO-UNDO.
     1433   DEFINE BUFFER buf1_conf-import FOR conf-import.
     1434   DEFINE BUFFER buf2_conf-import FOR conf-import.
     1435     IF NOT AVAILABLE person_conf-import  THEN RETURN NO-APPLY.
     1436     DO TRANSACTION:
     1437        v-rec = recid(person_conf-import).
     1438        FIND FIRST buf1_conf-import WHERE
     1439                 buf1_conf-import.subject = 'person':U
     1440             AND buf1_conf-import.POSITION_ = person_conf-import.POSITION_.
     1441       FIND FIRST buf2_conf-import WHERE
     1442                buf2_conf-import.subject = 'person':U
     1443            AND buf2_conf-import.POSITION_ > person_conf-import.POSITION_ NO-ERROR.
     1444       IF NOT AVAILABLE buf2_conf-import THEN DO:
     1445           BELL.
     1446           RETURN NO-APPLY.
     1447       END.
     1448        ASSIGN
     1449        v-old = buf1_conf-import.POSITION_.
     1450        ASSIGN
     1451        v-new = buf2_conf-import.POSITION_.
     1452        ASSIGN
     1453        buf1_conf-import.POSITION_ = 999999999.
     1454        RELEASE buf1_conf-import.
     1455        ASSIGN
     1456        buf2_conf-import.POSITION_ = v-old.
     1457        RELEASE buf2_conf-import.
     1458        FIND FIRST buf1_conf-import WHERE
     1459                   buf1_conf-import.subject = 'person':U
     1460               AND buf1_conf-import.POSITION_ = 999999999.
     1461        ASSIGN
     1462        buf1_conf-import.POSITION_ = v-new.
     1463     END.
     1464     OPEN QUERY BR-person FOR EACH person_conf-import WHERE person_conf-import.subject = 'person':U.
     1465     REPOSITION br-person TO RECID v-rec NO-ERROR.
     1466     apply "entry" TO br-person.
     1467   END.
     1468   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
     1469   DO:
     1470     RUN proc-save IN THIS-PROCEDURE  NO-ERROR.
     1471     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1472   END.
     1473   ON CHOOSE OF b-up-firm IN FRAME Dialog-Frame
     1474   DO:
     1475   DEFINE VARIABLE v-rec AS RECID NO-UNDO.
     1476   DEFINE VARIABLE v-new AS INTEGER NO-UNDO.
     1477   DEFINE VARIABLE v-old AS INTEGER NO-UNDO.
     1478   DEFINE BUFFER buf1_conf-import FOR conf-import.
     1479   DEFINE BUFFER buf2_conf-import FOR conf-import.
     1480     IF NOT AVAILABLE firm_conf-import  THEN RETURN NO-APPLY.
     1481     IF firm_conf-import.POSITION_ =  1 THEN DO:
     1482         BELL.
     1483         RETURN NO-APPLY.
     1484     END.
     1485     DO TRANSACTION:
     1486        v-rec = recid(firm_conf-import).
     1487        FIND FIRST buf1_conf-import WHERE
     1488                 buf1_conf-import.subject = 'firm':U
     1489             AND buf1_conf-import.POSITION_ = firm_conf-import.POSITION.
     1490       FIND last buf2_conf-import WHERE
     1491                buf2_conf-import.subject = 'firm':U
     1492            AND buf2_conf-import.POSITION_ < firm_conf-import.POSITION .
     1493        ASSIGN
     1494        v-old = buf1_conf-import.POSITION_.
     1495        ASSIGN
     1496        v-new = buf2_conf-import.POSITION_.
     1497        ASSIGN
     1498        buf1_conf-import.POSITION_ = 999999999.
     1499        RELEASE buf1_conf-import.
     1500        ASSIGN
     1501        buf2_conf-import.POSITION_ = v-old.
     1502        RELEASE buf2_conf-import.
     1503        FIND FIRST buf1_conf-import WHERE
     1504                   buf1_conf-import.subject = 'firm':U
     1505               AND buf1_conf-import.POSITION_ = 999999999.
     1506        ASSIGN
     1507        buf1_conf-import.POSITION_ = v-new.
     1508     END.
     1509   OPEN QUERY BR-firm FOR EACH firm_conf-import WHERE firm_conf-import.subject = 'firm':U.
     1510     REPOSITION br-firm TO RECID v-rec NO-ERROR.
     1511     apply "entry" TO br-firm.
     1512   END.
     1513   ON CHOOSE OF b-up-person IN FRAME Dialog-Frame
     1514   DO:
     1515     DEFINE VARIABLE v-rec AS RECID NO-UNDO.
     1516   DEFINE VARIABLE v-new AS INTEGER NO-UNDO.
     1517   DEFINE VARIABLE v-old AS INTEGER NO-UNDO.
     1518   DEFINE BUFFER buf1_conf-import FOR conf-import.
     1519   DEFINE BUFFER buf2_conf-import FOR conf-import.
     1520     IF NOT AVAILABLE person_conf-import  THEN RETURN NO-APPLY.
     1521     IF person_conf-import.POSITION_ =  1 THEN DO:
     1522         BELL.
     1523         RETURN NO-APPLY.
     1524     END.
     1525     DO TRANSACTION:
     1526        v-rec = recid(person_conf-import).
     1527        FIND FIRST buf1_conf-import WHERE
     1528                 buf1_conf-import.subject = 'person':U
     1529             AND buf1_conf-import.POSITION_ = person_conf-import.POSITION.
     1530       FIND LAST buf2_conf-import WHERE
     1531                buf2_conf-import.subject = 'person':U
     1532            AND buf2_conf-import.POSITION_ < person_conf-import.POSITION .
     1533        ASSIGN
     1534        v-old = buf1_conf-import.POSITION_.
     1535        ASSIGN
     1536        v-new = buf2_conf-import.POSITION_.
     1537        ASSIGN
     1538        buf1_conf-import.POSITION_ = 999999999.
     1539        RELEASE buf1_conf-import.
     1540        ASSIGN
     1541        buf2_conf-import.POSITION_ = v-old.
     1542        RELEASE buf2_conf-import.
     1543        FIND FIRST buf1_conf-import WHERE
     1544                   buf1_conf-import.subject = 'person':U
     1545               AND buf1_conf-import.POSITION_ = 999999999.
     1546        ASSIGN
     1547        buf1_conf-import.POSITION_ = v-new.
     1548     END.
     1549     OPEN QUERY BR-person FOR EACH person_conf-import WHERE person_conf-import.subject = 'person':U.
     1550     REPOSITION br-person TO RECID v-rec NO-ERROR.
     1551     apply "entry" TO br-person.
     1552   END.
     1553   ON VALUE-CHANGED OF BR-firm IN FRAME Dialog-Frame
     1554   DO:
     1555     IF NOT AVAILABLE firm_conf-import
     1556     OR (AVAILABLE firm_conf-import AND firm_conf-import.is-mandatory) = YES THEN DO:
     1557         ASSIGN
     1558         firm_conf-import.to-import:READ-ONLY IN BROWSE br-firm = YES.
     1559     END.
     1560     ELSE DO:
     1561         ASSIGN
     1562         firm_conf-import.to-import:READ-ONLY IN BROWSE br-firm = NO.
     1563     END.
     1564   END.
     1565   ON VALUE-CHANGED OF BR-person IN FRAME Dialog-Frame
     1566   DO:
     1567     IF NOT AVAILABLE person_conf-import
     1568     OR (AVAILABLE person_conf-import AND person_conf-import.is-mandatory) = YES THEN DO:
     1569         ASSIGN
     1570         person_conf-import.to-import:READ-ONLY IN BROWSE br-person = YES.
     1571     END.
     1572     ELSE DO:
     1573         ASSIGN
     1574         person_conf-import.to-import:READ-ONLY IN BROWSE br-person = NO.
     1575     END.
     1576   END.
     1577   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1578   procedure rcps_get-profile-id :
     1579   define output parameter p-local-profile-id as integer no-undo .
     1580   do
     1581   on error undo, return error:
     1582   p-local-profile-id = p-profile-id.
     1583   end.
     1584   end procedure.
     1585   PROCEDURE rcps_fill-table :
     1586   define input parameter p-clear-params as logical no-undo .
     1587   if p-clear-params then do:
     1588   FOR EACH tt-rule-call-param:
     1589       DELETE tt-rule-call-param.
     1590   END.
     1591   end.
     1592    FOR EACH tt0-rule-call-param:
     1593      IF p-mode <> 'ДОБАВЛЕНИЕ':U THEN DO:
     1594        IF p-call-id <> '':U and p-call-id <> tt0-rule-call-param.call_id THEN do:
     1595           NEXT.
     1596        end.
     1597        IF p-codex-id <> 0 and p-codex-id <> tt0-rule-call-param.codex_id THEN do:
     1598          NEXT.
     1599        end.
     1600        IF p-ruleset-id <> 0 and p-ruleset-id <> tt0-rule-call-param.ruleset_id THEN do:
     1601          NEXT.
     1602        end.
     1603        IF p-rule-id <> 0 and p-rule-id <> tt0-rule-call-param.RULE_id THEN do:
     1604          NEXT.
     1605        end.
     1606        IF p-order-id <> ? and p-order-id <> tt0-rule-call-param.order_id THEN do:
     1607          NEXT.
     1608        end.
     1609      END.
     1610      if lookup("hidden", tt0-rule-call-param.param-3-data-type) > 0 then do:
     1611        next.
     1612      end.
     1613      IF p-list-mode = 'rp-rule-param':U
     1614      or p-list-mode = 'rp-rule-param':U  + chr(44) + 'все':U
     1615      THEN DO:
     1616         IF p-profile-id <> 0 AND p-profile-id <> tt0-rule-call-param.profile_id THEN do:
     1617           NEXT.
     1618         end.
     1619         IF p-once-more <> ? AND p-once-more <> tt0-rule-call-param.once-more THEN do:
     1620           NEXT.
     1621         end.
     1622      END.
     1623      CREATE tt-rule-call-param.
     1624      BUFFER-COPY tt0-rule-call-param TO tt-rule-call-param.
     1625   END.
     1626   END PROCEDURE.
     1627   procedure rcps_get-value :
     1628   DEFINE INPUT PARAMETER p-profile-id AS integer NO-UNDO.
     1629   DEFINE INPUT PARAMETER p-once-more AS integer NO-UNDO.
     1630   DEFINE INPUT PARAMETER p-call-id AS CHARACTER NO-UNDO.
     1631   DEFINE INPUT PARAMETER p-rp-param-name AS CHARACTER NO-UNDO.
     1632   DEFINE INPUT-output PARAMETER pp-index AS integer NO-UNDO.
     1633   DEFINE output parameter p-value-character AS CHARACTER NO-UNDO.
     1634   DEFINE output parameter p-value-date AS date NO-UNDO.
     1635   DEFINE output parameter p-value-decimal AS decimal NO-UNDO.
     1636   DEFINE output parameter p-value-integer AS integer NO-UNDO.
     1637   DEFINE output parameter p-value-logical AS logical NO-UNDO.
     1638   define variable v-current-index as integer no-undo init -1.
     1639   define variable v-start as logical no-undo init yes.
     1640   DEFINE BUFFER buf_ruledict-param FOR ub.ruledict-param.
     1641   DEFINE BUFFER buf_rp-rule-param FOR ub.rp-rule-param.
     1642   DEFINE BUFFER buf_tt-rule-call-param FOR tt-rule-call-param.
     1643   DEFINE BUFFER buf_term_tt-rule-call-param FOR tt-rule-call-param.
     1644   do
     1645   on error undo, return error
     1646   :
     1647   FOR FIRST buf_rp-rule-param WHERE
     1648         buf_rp-rule-param.profile_id = p-profile-id
     1649     AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     1650   , each buf_tt-rule-call-param WHERE
     1651      buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     1652   AND buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     1653   AND buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     1654   AND buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     1655   AND buf_tt-rule-call-param.p-index >= pp-index
     1656    ,each buf_term_tt-rule-call-param where
     1657          buf_term_tt-rule-call-param.call_id = buf_tt-rule-call-param.call_id
     1658      and buf_term_tt-rule-call-param.codex_id = buf_tt-rule-call-param.codex_id
     1659      and buf_term_tt-rule-call-param.ruleset_id = buf_tt-rule-call-param.ruleset_id
     1660      and buf_term_tt-rule-call-param.order_id = buf_tt-rule-call-param.order_id
     1661      and buf_term_tt-rule-call-param.param-name = buf_tt-rule-call-param.param-name
     1662      and buf_term_tt-rule-call-param.p-index = buf_tt-rule-call-param.p-index
     1663     by buf_term_tt-rule-call-param.call_id
     1664     by buf_term_tt-rule-call-param.codex_id
     1665     by buf_term_tt-rule-call-param.ruleset_id
     1666     by buf_term_tt-rule-call-param.order_id
     1667     by buf_term_tt-rule-call-param.param-name
     1668     by buf_term_tt-rule-call-param.p-index :
     1669       if v-start
     1670       then do:
     1671         assign
     1672         pp-index = buf_term_tt-rule-call-param.p-index
     1673         p-value-character = buf_term_tt-rule-call-param.param-value-character
     1674         p-value-date      = buf_term_tt-rule-call-param.param-value-date
     1675         p-value-decimal   = buf_term_tt-rule-call-param.param-value-decimal
     1676         p-value-integer   = buf_term_tt-rule-call-param.param-value-integer
     1677         p-value-logical   = buf_term_tt-rule-call-param.param-value-logical
     1678         v-start = no
     1679         .
     1680       end.
     1681       else do:
     1682         if buf_term_tt-rule-call-param.p-index > pp-index then do:
     1683           v-current-index = buf_term_tt-rule-call-param.p-index.
     1684           leave.
     1685         end.
     1686             end.
     1687     end.
     1688     pp-index = v-current-index.
     1689   end.
     1690   end procedure.
     1691   PROCEDURE rcps_proc-b-add :
     1692   DEFINE INPUT PARAMETER p-profile-id AS integer NO-UNDO.
     1693   DEFINE INPUT PARAMETER p-once-more AS integer NO-UNDO.
     1694   DEFINE INPUT PARAMETER p-call-id AS CHARACTER NO-UNDO.
     1695   DEFINE INPUT PARAMETER p-rp-param-name AS CHARACTER NO-UNDO.
     1696   DEFINE INPUT PARAMETER p-index AS integer NO-UNDO.
     1697   define variable v-ind as integer no-undo .
     1698   define buffer buf_tt-rule-call-param for tt-rule-call-param.
     1699   define buffer buf0_tt-rule-call-param for tt-rule-call-param.
     1700   define buffer buf2_tt-rule-call-param for tt-rule-call-param.
     1701   define buffer buf_rp-rule-param for ub.rp-rule-param.
     1702   FOR FIRST buf_rp-rule-param WHERE
     1703             buf_rp-rule-param.profile_id = p-profile-id
     1704         AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     1705       , first buf0_tt-rule-call-param WHERE
     1706          buf0_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     1707      AND buf0_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     1708      AND buf0_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     1709      AND buf0_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name:
     1710     LEAVE.
     1711   END.
     1712   IF NOT AVAILABLE buf0_tt-rule-call-param THEN do:
     1713     BELL.
     1714     RETURN.
     1715   END.
     1716   for each buf_rp-rule-param where
     1717           buf_rp-rule-param.rp-param-name = p-rp-param-name
     1718       and buf_rp-rule-param.profile_id = p-profile-id,
     1719       first buf_tt-rule-call-param where
     1720           buf_tt-rule-call-param.call_id = buf0_tt-rule-call-param.call_id
     1721       and buf_tt-rule-call-param.profile_id = buf_rp-rule-param.profile_id
     1722       and buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     1723       and buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     1724       and buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     1725       and buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     1726       and buf_tt-rule-call-param.once-more = buf0_tt-rule-call-param.once-more
     1727       and buf_tt-rule-call-param.p-index = p-index:
     1728     RETURN.
     1729   END.
     1730   IF lookup("LIST", buf0_tt-rule-call-param.param-3-data-type) = 0
     1731   and lookup("SORTED-LIST", buf0_tt-rule-call-param.param-3-data-type) = 0
     1732   THEN DO:
     1733     BELL.
     1734     RETURN.
     1735   END.
     1736   IF buf0_tt-rule-call-param.p-index <> 0 THEN DO:
     1737     BELL.
     1738     RETURN.
     1739   END.
     1740   find last buf_tt-rule-call-param where
     1741            buf_tt-rule-call-param.call_id = buf0_tt-rule-call-param.call_id
     1742        and buf_tt-rule-call-param.codex_id = buf0_tt-rule-call-param.codex_id
     1743        and buf_tt-rule-call-param.ruleset_id = buf0_tt-rule-call-param.ruleset_id
     1744        and buf_tt-rule-call-param.order_id = buf0_tt-rule-call-param.order_id
     1745        and buf_tt-rule-call-param.param-name = buf0_tt-rule-call-param.param-name no-error .
     1746   if available buf_tt-rule-call-param
     1747   and (lookup("LIST", buf_tt-rule-call-param.param-3-data-type) > 0
     1748        or
     1749        lookup("SORTED-LIST", buf_tt-rule-call-param.param-3-data-type) > 0
     1750        )
     1751   and buf_tt-rule-call-param.p-index > 0 then do:
     1752     v-ind = buf_tt-rule-call-param.p-index.
     1753   end.
     1754   for each buf_rp-rule-param where
     1755           buf_rp-rule-param.rp-param-name = p-rp-param-name
     1756       and buf_rp-rule-param.profile_id = p-profile-id,
     1757       first buf_tt-rule-call-param where
     1758           buf_tt-rule-call-param.call_id = buf0_tt-rule-call-param.call_id
     1759       and buf_tt-rule-call-param.profile_id = buf_rp-rule-param.profile_id
     1760       and buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     1761       and buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     1762       and buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     1763       and buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     1764       and buf_tt-rule-call-param.once-more = buf0_tt-rule-call-param.once-more
     1765       and buf_tt-rule-call-param.p-index = 0
     1766   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1767   on stop   undo, return error substitute( "&1. stop", vss-workfile )
     1768   on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     1769   :
     1770     create buf2_tt-rule-call-param.
     1771     buffer-copy buf_tt-rule-call-param
     1772     except p-index
     1773     to buf2_tt-rule-call-param
     1774     assign
     1775     buf2_tt-rule-call-param.p-index = v-ind + 1
     1776     .
     1777   end.
     1778   END PROCEDURE.
     1779   PROCEDURE rcps_proc-b-del :
     1780   DEFINE INPUT PARAMETER p-profile-id AS integer NO-UNDO.
     1781   DEFINE INPUT PARAMETER p-once-more AS integer NO-UNDO.
     1782   DEFINE INPUT PARAMETER p-call-id AS CHARACTER NO-UNDO.
     1783   DEFINE INPUT PARAMETER p-rp-param-name AS CHARACTER NO-UNDO.
     1784   DEFINE INPUT PARAMETER pp-index AS integer NO-UNDO.
     1785   define variable v-ind as integer no-undo .
     1786   define variable v-once-more as integer no-undo .
     1787   define variable v-call-id as character no-undo .
     1788   define buffer buf0_tt-rule-call-param for tt-rule-call-param.
     1789   define buffer buf_tt-rule-call-param for tt-rule-call-param.
     1790   define buffer buf_rp-rule-param for ub.rp-rule-param.
     1791   if pp-index = 0 then do:
     1792     undo, return error substitute("Нельзя удалять корневой параметр &1 (индекс = 0)", p-rp-param-name).
     1793   end.
     1794   FOR first buf_rp-rule-param WHERE
     1795             buf_rp-rule-param.profile_id = p-profile-id
     1796         AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     1797       , first buf0_tt-rule-call-param WHERE
     1798          buf0_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     1799      AND buf0_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     1800      AND buf0_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     1801      AND buf0_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     1802      AND buf0_tt-rule-call-param.p-index = pp-index
     1803      :
     1804     LEAVE.
     1805   END.
     1806   IF NOT AVAILABLE buf0_tt-rule-call-param THEN do:
     1807     FOR first buf_rp-rule-param WHERE
     1808               buf_rp-rule-param.profile_id = p-profile-id
     1809           AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     1810         , last buf0_tt-rule-call-param WHERE
     1811           buf0_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     1812       AND buf0_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     1813       AND buf0_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     1814       AND buf0_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     1815       AND buf0_tt-rule-call-param.p-index > pp-index :
     1816       leave.
     1817     end.
     1818     IF NOT AVAILABLE buf0_tt-rule-call-param THEN do:
     1819     return "not-found".
     1820     end.
     1821     else do:
     1822       return ''.
     1823     end.
     1824   END.
     1825   IF lookup("LIST", buf0_tt-rule-call-param.param-3-data-type) = 0
     1826   and lookup("SORTED-LIST", buf0_tt-rule-call-param.param-3-data-type) = 0
     1827   THEN DO:
     1828     undo, return error substitute("Можно удалять только параметры типа LIST и SORTED-LIST").
     1829   END.
     1830   IF lookup("READ-ONLY", buf0_tt-rule-call-param.param-3-data-type) > 0 THEN DO:
     1831     undo, return error substitute("Нельзя удалять  параметры типа READ-ONLY").
     1832   END.
     1833   for each buf_rp-rule-param where
     1834           buf_rp-rule-param.rp-param-name = buf_rp-rule-param.rp-param-name
     1835       and buf_rp-rule-param.profile_id = buf_rp-rule-param.profile_id,
     1836       each buf_tt-rule-call-param where
     1837           buf_tt-rule-call-param.call_id = p-call-id
     1838       and buf_tt-rule-call-param.profile_id = buf_rp-rule-param.profile_id
     1839       and buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     1840       and buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     1841       and buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     1842       and buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     1843       and buf_tt-rule-call-param.once-more = p-once-more
     1844       and buf_tt-rule-call-param.p-index = pp-index
     1845   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1846   on stop   undo, return error substitute( "&1. stop", vss-workfile )
     1847   on endkey undo, return error substitute( "&1. endkey", vss-workfile ):
     1848       DELETE buf_tt-rule-call-param.
     1849   end.
     1850   return ''.
     1851   END PROCEDURE.
     1852   PROCEDURE rcps_proc-save0 :
     1853   FOR EACH tt-rule-call-param
     1854   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1855   on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1856   on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1857   :
     1858      find  FIRST tt0-rule-call-param NO-LOCK WHERE
     1859               tt0-rule-call-param.codex_id = tt-rule-call-param.codex_id
     1860          AND  tt0-rule-call-param.ruleset_id = tt-rule-call-param.ruleset_id
     1861          AND tt0-rule-call-param.call_id = tt-rule-call-param.call_id
     1862          AND tt0-rule-call-param.order_id = tt-rule-call-param.order_id
     1863          AND tt0-rule-call-param.param-name = tt-rule-call-param.param-name
     1864          AND tt0-rule-call-param.p-index = tt-rule-call-param.p-index no-error .
     1865      if not available tt0-rule-call-param
     1866      and (lookup("LIST", tt-rule-call-param.param-3-data-type) > 0
     1867           OR
     1868           lookup("SORTED-LIST", tt-rule-call-param.param-3-data-type) > 0
     1869           )
     1870      and tt-rule-call-param.p-index > 0 then do:
     1871        create tt0-rule-call-param.
     1872      end.
     1873      BUFFER-COPY tt-rule-call-param TO tt0-rule-call-param.
     1874   END.
     1875   FOR EACH tt0-rule-call-param
     1876   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1877   on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1878   on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1879   :
     1880     if tt0-rule-call-param.p-index = 0 then next.
     1881     if lookup("hidden", tt0-rule-call-param.param-3-data-type) > 0 then next.
     1882     find  FIRST tt-rule-call-param NO-LOCK WHERE
     1883             tt-rule-call-param.codex_id = tt0-rule-call-param.codex_id
     1884         AND tt-rule-call-param.ruleset_id = tt0-rule-call-param.ruleset_id
     1885         AND tt-rule-call-param.call_id = tt0-rule-call-param.call_id
     1886         AND tt-rule-call-param.order_id = tt0-rule-call-param.order_id
     1887         AND tt-rule-call-param.param-name = tt0-rule-call-param.param-name
     1888         AND tt-rule-call-param.p-index = tt0-rule-call-param.p-index no-error .
     1889     if not available tt-rule-call-param
     1890     and (lookup("LIST", tt0-rule-call-param.param-3-data-type) > 0
     1891         OR
     1892         lookup("SORTED-LIST", tt0-rule-call-param.param-3-data-type) > 0
     1893         )
     1894     and tt0-rule-call-param.p-index > 0
     1895     then do:
     1896        IF p-call-id <> '':U and p-call-id <> tt0-rule-call-param.call_id THEN do:
     1897           NEXT.
     1898        end.
     1899        IF p-codex-id <> 0 and p-codex-id <> tt0-rule-call-param.codex_id THEN do:
     1900          NEXT.
     1901        end.
     1902        IF p-ruleset-id <> 0 and p-ruleset-id <> tt0-rule-call-param.ruleset_id THEN do:
     1903          NEXT.
     1904        end.
     1905        IF p-rule-id <> 0 and p-rule-id <> tt0-rule-call-param.RULE_id THEN do:
     1906          NEXT.
     1907        end.
     1908        IF p-order-id <> ? and p-order-id <> tt0-rule-call-param.order_id THEN do:
     1909          NEXT.
     1910        end.
     1911       IF p-list-mode = 'rp-rule-param':U
     1912       or p-list-mode = 'rp-rule-param':U  + chr(44) + 'все':U
     1913       THEN DO:
     1914         IF p-profile-id <> 0 AND p-profile-id <> tt0-rule-call-param.profile_id THEN do:
     1915           NEXT.
     1916         end.
     1917         IF p-once-more <> ? AND p-once-more <> tt0-rule-call-param.once-more THEN do:
     1918           NEXT.
     1919         end.
     1920       end.
     1921       delete tt0-rule-call-param.
     1922     end.
     1923   end.
     1924   END PROCEDURE.
     1925   PROCEDURE rcps_set-value :
     1926   DEFINE INPUT PARAMETER p-profile-id AS integer NO-UNDO.
     1927   DEFINE INPUT PARAMETER p-once-more AS integer NO-UNDO.
     1928   DEFINE INPUT PARAMETER p-call-id AS CHARACTER NO-UNDO.
     1929   DEFINE INPUT PARAMETER p-rp-param-name AS CHARACTER NO-UNDO.
     1930   DEFINE INPUT PARAMETER pp-index AS integer NO-UNDO.
     1931   DEFINE INPUT parameter p-value-character AS CHARACTER NO-UNDO.
     1932   DEFINE INPUT parameter p-value-date AS date NO-UNDO.
     1933   DEFINE INPUT parameter p-value-decimal AS decimal NO-UNDO.
     1934   DEFINE INPUT parameter p-value-integer AS integer NO-UNDO.
     1935   DEFINE INPUT parameter p-value-logical AS logical NO-UNDO.
     1936   DEFINE VARIABLE v-codex-id AS integer NO-UNDO.
     1937   DEFINE VARIABLE v-ruleset-id AS integer NO-UNDO.
     1938   DEFINE VARIABLE v-order-id AS integer NO-UNDO.
     1939   DEFINE VARIABLE V-param-name AS character NO-UNDO.
     1940   define variable v-found as logical no-undo .
     1941   DEFINE BUFFER buf_tt-rule-call-param FOR tt-rule-call-param.
     1942   DEFINE BUFFER buf_rp-rule-param FOR ub.rp-rule-param.
     1943   FOR FIRST buf_rp-rule-param WHERE
     1944             buf_rp-rule-param.profile_id = p-profile-id
     1945         AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     1946       , first buf_tt-rule-call-param WHERE
     1947          buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     1948      AND buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     1949      AND buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     1950      AND buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name:
     1951     ASSIGN
     1952     v-codex-id = buf_tt-rule-call-param.codex_id
     1953     v-ruleset-id = buf_tt-rule-call-param.ruleset_id
     1954     v-order-id = buf_tt-rule-call-param.order_id
     1955     V-PARAM-NAME = buf_tt-rule-call-param.PARAM-NAME
     1956     .
     1957     LEAVE.
     1958   END.
     1959   CASE p-list-mode:
     1960     WHEN 'rp-rule-param':U THEN DO:
     1961       if pp-index > 0
     1962       then do:
     1963         FOR EACH  buf_rp-rule-param NO-LOCK where
     1964             buf_rp-rule-param.profile_id = p-profile-id
     1965             AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     1966             ,EACH buf_tt-rule-call-param WHERE
     1967                 buf_tt-rule-call-param.profile_id = p-profile-id
     1968             AND buf_tt-rule-call-param.once-more = p-once-more
     1969             AND buf_tt-rule-call-param.call_id = p-CALL-id
     1970             AND buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     1971             AND buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     1972             AND buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     1973             AND buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     1974             AND buf_tt-rule-call-param.p-index = pp-index
     1975         ON error undo, return error :
     1976           v-found = yes.
     1977         end.
     1978       end.
     1979       if not v-found then do:
     1980         run rcps_proc-b-add in this-procedure (
     1981                                                  input p-profile-id
     1982                                                 ,input p-once-more
     1983                                                 ,input p-call-id
     1984                                                 ,
     1985                                                  input p-rp-param-name
     1986                                                 ,input pp-index).
     1987       end.
     1988       FOR EACH  buf_rp-rule-param NO-LOCK where
     1989           buf_rp-rule-param.profile_id = p-profile-id
     1990           AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     1991           ,EACH buf_tt-rule-call-param WHERE
     1992               buf_tt-rule-call-param.profile_id = p-profile-id
     1993           AND buf_tt-rule-call-param.once-more = p-once-more
     1994           AND buf_tt-rule-call-param.call_id = p-CALL-id
     1995           AND buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     1996           AND buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     1997           AND buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     1998           AND buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     1999           AND buf_tt-rule-call-param.p-index = pp-index
     2000         ON error undo, return error :
     2001         assign
     2002         buf_tt-rule-call-param.param-value-character = p-value-character
     2003         buf_tt-rule-call-param.param-value-date      = p-value-date
     2004         buf_tt-rule-call-param.param-value-decimal   = p-value-decimal
     2005         buf_tt-rule-call-param.param-value-integer   = p-value-integer
     2006         buf_tt-rule-call-param.param-value-logical   = p-value-logical
     2007         .
     2008       END.
     2009     END.
     2010     WHEN 'rule-call-param':U THEN DO:
     2011       FIND FIRST buf_tt-rule-call-param WHERE
     2012           buf_tt-rule-call-param.call_id = p-call-id
     2013       AND buf_tt-rule-call-param.codex_id = v-codex-id
     2014       AND buf_tt-rule-call-param.ruleset_id = v-ruleset-id
     2015       AND buf_tt-rule-call-param.order_id = v-order-id
     2016       AND buf_tt-rule-call-param.param-name = V-PARAM-NAME
     2017       AND buf_tt-rule-call-param.p-index = pp-index.
     2018       assign
     2019       buf_tt-rule-call-param.param-value-character = p-value-character
     2020       buf_tt-rule-call-param.param-value-date      = p-value-date
     2021       buf_tt-rule-call-param.param-value-decimal   = p-value-decimal
     2022       buf_tt-rule-call-param.param-value-integer   = p-value-integer
     2023       buf_tt-rule-call-param.param-value-logical   = p-value-logical
     2024       .
     2025     END.
     2026   END CASE.
     2027   END PROCEDURE.
