     2069   term_tt-rule-call-param.param-label:RESIZABLE IN browse br-rcp = YES
     2070   X_rp-rule-param.rp-param-name:RESIZABLE IN browse br-rcp = YES
     2071   .
     2072   ASSIGN
     2073   v-ch0 = br-rcp:FIRST-COLUMN IN FRAME Dialog-Frame.
     2074   REPEAT WHILE valid-handle(v-ch0):
     2075      IF v-ch0:LABEL = "Значение!(строковое)" THEN DO:
     2076        v-ch[1] = v-ch0.
     2077        v-ch0:VISIBLE = NO.
     2078      END.
     2079      IF v-ch0:LABEL = "Значение!(Дата)" THEN DO:
     2080        v-ch[2] = v-ch0.
     2081        v-ch0:VISIBLE = NO.
     2082      END.
     2083      IF v-ch0:LABEL = "Значение!(Десятичное)" THEN DO:
     2084        v-ch[3] = v-ch0.
     2085        v-ch0:VISIBLE = NO.
     2086      END.
     2087      IF v-ch0:LABEL = "Значение!(Целое)" THEN DO:
     2088        v-ch[4] = v-ch0.
     2089        v-ch0:VISIBLE = NO.
     2090      END.
     2091      IF v-ch0:LABEL = "Значение!(Логическое)" THEN DO:
     2092        v-ch[5] = v-ch0.
     2093        v-ch0:VISIBLE = NO.
     2094      END.
     2095      IF v-ch0:LABEL = "Точка вызова" THEN DO:
     2096        v-ch[6] = v-ch0.
     2097      END.
     2098      IF v-ch0:LABEL = "Значение" THEN
     2099      v-ch0:RESIZABLE = YES.
     2100      v-ch0 = v-ch0:NEXT-COLUMN.
     2101   END.
     2102   assign
     2103   X_rp-rule-param.rp-param-name:resizable in browse br-rcp = yes
     2104   term_tt-rule-call-param.param-name:resizable in browse br-rcp = yes
     2105   term_tt-rule-call-param.param-label:resizable in browse br-rcp = yes
     2106   .
     2107   CASE p-list-mode:
     2108     WHEN 'rule-call-param':U THEN DO:
     2109        ASSIGN
     2110        X_rp-rule-param.rp-param-name:VISIBLE IN BROWSE br-rcp = NO
     2111        .
     2112     END.
     2113     WHEN 'rp-rule-param':U
     2114     or
     2115     when 'rp-rule-param':U + chr(44) + 'все':U
     2116     THEN DO:
     2117       assign
     2118       term_tt-rule-call-param.codex_id:VISIBLE IN BROWSE br-rcp = NO
     2119       term_tt-rule-call-param.ruleset_id:VISIBLE IN BROWSE br-rcp = NO
     2120       term_tt-rule-call-param.rule_id:VISIBLE IN BROWSE br-rcp = NO
     2121       term_tt-rule-call-param.order_id:VISIBLE IN BROWSE br-rcp = NO
     2122       term_tt-rule-call-param.param-name:VISIBLE IN BROWSE br-rcp = NO
     2123       term_tt-rule-call-param.param-num:VISIBLE IN BROWSE br-rcp = NO
     2124       .
     2125     END.
     2126   END CASE.
     2127    IF p-call-id <> '':U THEN DO:
     2128      v-ch[6]:VISIBLE = NO.
     2129    END.
     2130     IF p-profile-id <> 0 THEN DO:
     2131      term_tt-rule-call-param.profile_id :VISIBLE IN BROWSE br-rcp= NO.
     2132    END.
     2133     IF p-rule-id <> 0 THEN DO:
     2134      term_tt-rule-call-param.RULE_id :VISIBLE IN BROWSE br-rcp= NO.
     2135    END.
     2136     IF p-once-more <> 0 THEN DO:
     2137      term_tt-rule-call-param.once-more :VISIBLE IN BROWSE br-rcp= NO.
     2138    END.
     2139   END PROCEDURE.
     2140   PROCEDURE rcps_Openbr :
     2141   CASE p-list-mode:
     2142     WHEN 'rp-rule-param':U THEN DO:
     2143         OPEN QUERY br-rcp
     2144         FOR EACH  X_ruledict-param NO-LOCK WHERE X_ruledict-param.entry-id = v-rcps-entry-id
     2145             ,FIRST X_rp-rule-param WHERE
     2146                 X_rp-rule-param.profile_id = p-profile-id
     2147             AND X_rp-rule-param.rp-param-name = X_ruledict-param.param-name
     2148           , first tt-rule-call-param WHERE
     2149              tt-rule-call-param.codex_id = X_rp-rule-param.codex_id
     2150          AND tt-rule-call-param.ruleset_id = X_rp-rule-param.ruleset_id
     2151          AND tt-rule-call-param.rule_id = X_rp-rule-param.rule_id
     2152          AND tt-rule-call-param.param-name = X_rp-rule-param.rule-param-name
     2153            ,each term_tt-rule-call-param where
     2154                  term_tt-rule-call-param.call_id = tt-rule-call-param.call_id
     2155              and term_tt-rule-call-param.codex_id = tt-rule-call-param.codex_id
     2156              and term_tt-rule-call-param.ruleset_id = tt-rule-call-param.ruleset_id
     2157              and term_tt-rule-call-param.order_id = tt-rule-call-param.order_id
     2158              and term_tt-rule-call-param.param-name = tt-rule-call-param.param-name
     2159         BY tt-rule-call-param.call_id
     2160         BY tt-rule-call-param.codex_id
     2161         BY tt-rule-call-param.ruleset_id
     2162         BY tt-rule-call-param.order_id
     2163         BY tt-rule-call-param.param-num.
     2164     END.
     2165   END CASE.
     2166   apply "ENTRY" to br-rcp in frame Dialog-Frame .
     2167   APPLy "VALUE-CHANGED" to br-rcp.
     2168   END PROCEDURE.
     2169   PROCEDURE rcps_proc-b-chg PRIVATE :
     2170   DEFINE VARIABLE v-rec1 AS Rowid NO-UNDO.
     2171   DEFINE VARIABLE v-rec2 AS Rowid NO-UNDO.
     2172   DEFINE VARIABLE v-rec3 AS Rowid NO-UNDO.
     2173   DEFINE VARIABLE v-rec4 AS Rowid NO-UNDO.
     2174   define variable v-param-data-type as character no-undo .
     2175   define variable v-rid-list as character no-undo .
     2176   IF NOT AVAILABLE TERM_tt-rule-call-param  THEN DO:
     2177     RETURN ERROR.
     2178   END.
     2179   ASSIGN
     2180   v-rec1 = rowid(X_ruledict-param)
     2181   v-rec2 = rowid(X_rp-rule-param)
     2182   v-rec3 = Rowid(tt-rule-call-param)
     2183   v-rec4 = Rowid(term_tt-rule-call-param)
     2184   .
     2185   run rcps_openbr in this-procedure .
     2186   REPOSITION br-rcp TO Rowid v-rec1, v-rec2,v-rec3, v-rec4 NO-ERROR.
     2187   IF ERROR-STATUS:ERROR THEN DO:
     2188     REPOSITION br-rcp TO ROW 1 NO-ERROR.
     2189   END.
     2190   APPLY "ENTRY" TO br-rcp in frame Dialog-Frame .
     2191   APPLY "VALUE-CHANGED" TO br-rcp in frame Dialog-Frame .
     2192   END PROCEDURE.
     2193   PROCEDURE rcps_set-row-color :
     2194   DEFINE INPUT PARAMETER p-data-type AS CHARACTER NO-UNDO.
     2195   ASSIGN
     2196   v-ch[1]:FGCOLOR = GREY_COLOR
     2197   v-ch[1]:BGCOLOR = GREY_Color
     2198   v-ch[1]:PFCOLOR = GREY_Color
     2199   v-ch[2]:FGCOLOR = GREY_COLOR
     2200   v-ch[2]:BGCOLOR = GREY_Color
     2201   v-ch[2]:PFCOLOR = GREY_Color
     2202   v-ch[3]:FGCOLOR = GREY_COLOR
     2203   v-ch[3]:BGCOLOR = GREY_Color
     2204   v-ch[3]:PFCOLOR = GREY_Color
     2205   v-ch[4]:FGCOLOR = GREY_COLOR
     2206   v-ch[4]:BGCOLOR = GREY_Color
     2207   v-ch[4]:PFCOLOR = GREY_Color
     2208   v-ch[5]:FGCOLOR = GREY_COLOR
     2209   v-ch[5]:BGCOLOR = GREY_Color
     2210   v-ch[5]:PFCOLOR = GREY_Color
     2211   .
     2212   CASE entry(1, p-data-type):
     2213        WHEN 'character':U THEN DO:
     2214         ASSIGN
     2215         v-ch[1]:FGCOLOR = BLACK_COLOR
     2216         v-ch[1]:BGCOLOR = WHITE_Color.
     2217       END.
     2218       WHEN 'decimal':U THEN DO:
     2219         ASSIGN
     2220         v-ch[3]:FGCOLOR = BLACK_COLOR
     2221         v-ch[3]:BGCOLOR = WHITE_Color.
     2222       END.
     2223       WHEN 'integer':U THEN DO:
     2224         ASSIGN
     2225         v-ch[4]:FGCOLOR = BLACK_COLOR
     2226         v-ch[4]:BGCOLOR = WHITE_Color.
     2227       END.
     2228       WHEN 'date':U THEN DO:
     2229         ASSIGN
     2230         v-ch[2]:FGCOLOR = BLACK_COLOR
     2231         v-ch[2]:BGCOLOR = WHITE_Color.
     2232        END.
     2233        WHEN 'logical':U THEN DO:
     2234          ASSIGN
     2235          v-ch[5]:FGCOLOR = BLACK_COLOR
     2236          v-ch[5]:BGCOLOR = WHITE_Color.
     2237        END.
     2238   END CASE.
     2239   END PROCEDURE.
     2240   ON ROW-DISPLAY OF br-rcp IN frame Dialog-Frame
     2241   DO:
     2242     IF AVAIL tt-rule-call-param THEN DO:
     2243       RUN rcps_set-row-color IN THIS-PROCEDURE ( INPUT term_tt-rule-call-param.param-data-type).
     2244     END.
     2245   END.
     2246   ON ROW-DISPLAY OF br-firm IN frame Dialog-Frame
     2247   DO:
     2248     IF AVAIL firm_conf-import THEN DO:
     2249       RUN set-row-color-firm IN THIS-PROCEDURE ( INPUT firm_conf-import.is-mandatory).
     2250     END.
     2251   END.
     2252   ON ROW-DISPLAY OF br-person IN frame Dialog-Frame
     2253   DO:
     2254     IF AVAIL person_conf-import THEN DO:
     2255       RUN set-row-color-person IN THIS-PROCEDURE (INPUT person_conf-import.is-mandatory).
     2256     END.
     2257   END.
     2258   ON "leave" OF firm_conf-import.to-import  IN BROWSE br-firm
     2259   DO:
     2260   define buffer buf1_conf-import for firm_conf-import.
     2261   if available conf-import then do:
     2262     find first buf1_conf-import where
     2263               recid(buf1_conf-import) = recid(conf-import).
     2264     IF conf-import.is-mandatory = YES
     2265     and logical(firm_conf-import.to-import:screen-value in browse br-firm) = no
     2266     THEN DO:
     2267       BELL.
     2268       assign
     2269       firm_conf-import.to-import = yes.
     2270       display
     2271       firm_conf-import.to-import
     2272       with browse br-firm.
     2273     END.
     2274     else do:
     2275       assign
     2276       buf1_conf-import.to-import = logical(firm_conf-import.to-import:screen-value in browse br-firm).
     2277       release buf1_conf-import.
     2278       browse br-firm:refresh().
     2279     end.
     2280     end.
     2281   END.
     2282   ON "leave" OF person_conf-import.to-import  IN BROWSE br-person
     2283   DO:
     2284   define buffer buf1_conf-import for person_conf-import.
     2285   if available conf-import then do:
     2286     find first buf1_conf-import where
     2287               recid(buf1_conf-import) = recid(conf-import).
     2288     IF conf-import.is-mandatory = YES
     2289     and logical(person_conf-import.to-import:screen-value in browse br-person) = no
     2290     THEN DO:
     2291       BELL.
     2292       assign
     2293       person_conf-import.to-import = yes.
     2294       display
     2295       person_conf-import.to-import
     2296       with browse br-person.
     2297     END.
     2298     else do:
     2299       assign
     2300       buf1_conf-import.to-import = logical(person_conf-import.to-import:screen-value in browse br-person).
     2301       release buf1_conf-import.
     2302       browse br-person:refresh().
     2303     end.
     2304     end.
     2305   END.
     2306   ON f6 anywhere DO:
     2307     ASSIGN
     2308     br-rcp:VISIBLE IN FRAME Dialog-Frame = (NOT br-rcp:VISIBLE IN FRAME Dialog-Frame)
     2309     .
     2310   END.
     2311   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2312   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2313   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2314   on help of frame Dialog-Frame
     2315   do:
     2316     run gbl/app_help.p
     2317       (input this-procedure :file-name
     2318       ,input ''
     2319       ,input ?
     2320       ) no-error.
     2321     if error-status :error then do:
     2322       message
     2323         "Ошибка при вызове помощи"
     2324         error-status :get-message(1)
     2325         view-as alert-box .
     2326     end.
     2327   end.
     2328   run minbtn-set in this-procedure .
     2329   on choose of b-help in frame Dialog-Frame
     2330   do:
     2331     apply "help":u to frame Dialog-Frame .
     2332   end.
     2333   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2334   procedure minbtn-set :
     2335       do
     2336           on error undo, return error return-value
     2337           :
     2338           define variable ii              as integer       no-undo .
     2339           define variable fh              as widget-handle no-undo .
     2340           define variable hh              as widget-handle no-undo .
     2341           define variable v-h             as handle        extent 4 no-undo .
     2342           define variable v-name-button   as character     no-undo .
     2343           define variable v-help-old-x    as decimal       no-undo .
     2344           define variable v-help-old-y    as decimal       no-undo .
     2345           define variable v-help-old-size as decimal       no-undo .
     2346           define variable v-frame-width   as decimal       no-undo .
     2347           define variable jj              as integer       no-undo .
     2348           do
     2349               on error undo, return error
     2350               :
     2351               assign
     2352                   v-frame-width = frame Dialog-Frame:width - 0.3
     2353                   fh            = frame Dialog-Frame:first-child
     2354                   hh            = fh:first-child
     2355                   ii            = 1
     2356                   .
     2357               do while valid-handle(hh):
     2358                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2359                   do:
     2360                       case lc(hh:name) :
     2361                           when "b-help" then
     2362                               do:
     2363                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2364                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2365                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2366                                   hh:TOOLTIP = "Помощь" .
     2367                                   v-help-old-x = hh:column .
     2368                                   v-help-old-y = hh:row    .
     2369                                   v-help-old-size = hh:width .
     2370                                   hh:width-chars = 2.5 .
     2371                               end.
     2372                           when "b-print" then
     2373                               do:
     2374                                   hh:load-image("cmp/b-print.bmp":u) .
     2375                                   hh:TOOLTIP = "Печать" .
     2376                                   v-h[ii] = hh:handle .
     2377                                   ii = ii + 1 .
     2378                                   hh:width-chars = 3 .
     2379                               end.
     2380                           when "b-history" or
     2381                           when "b-hist" then
     2382                               do:
     2383                                   hh:load-image("cmp/b-hist.bmp":u) .
     2384                                   hh:TOOLTIP = "История" .
     2385                                   v-h[ii] = hh:handle .
     2386                                   ii = ii + 1 .
     2387                                   hh:width-chars = 3 .
     2388                               end.
     2389                           when "b-sch" then
     2390                               do:
     2391                                   hh:load-image("cmp/b-sch.bmp":u) .
     2392                                   hh:TOOLTIP = "Установка Фильтра" .
     2393                                   v-h[ii] = hh:handle .
     2394                                   ii = ii + 1 .
     2395                                   hh:width-chars = 3 .
     2396                               end.
     2397                           when "b-hist-user" then
     2398                               do:
     2399                                   hh:load-image("cmp/b-hist.bmp":u) .
     2400                                   hh:TOOLTIP = "История пользователя" .
     2401                                   ii = ii + 1 .
     2402                               end.
     2403                       end case.
     2404                   end.
     2405                   hh = hh:next-sibling.
     2406               end.
     2407               b-help:column = v-frame-width - b-help:width-chars.
     2408               jj = 0.
     2409               repeat ii = 4 to 1 by -1 :
     2410                   if valid-handle (v-h[ii] ) then
     2411                   do:
     2412                       jj  = jj + 1 .
     2413                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2414                       v-h[ii]:row    = v-help-old-y .
     2415                   end.
     2416               end.
     2417           end.
     2418       end.
     2419   end procedure.
     2420   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2421   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2422   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2423   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2424   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2425   define variable v-diasize-current-frame-height as decimal   no-undo .
     2426   define variable v-diasize-change-size          as logical   no-undo .
     2427   define variable v-diasize-resize-button        as handle    no-undo .
     2428   define variable v-diasize-wndmax               as logical   no-undo .
     2429   define variable v-diasize-wndstore             as logical   no-undo .
     2430   define variable v-diasize-proc-name            as character no-undo .
     2431   define variable v-diasize-browse-handle        as handle    no-undo .
     2432   define variable v-diasize-browse-number        as integer   no-undo .
     2433   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2434   define temp-table temp-diasize-handle no-undo
     2435     field handle-value  as handle
     2436     field save-position as decimal
     2437     index xpk is primary unique handle-value
     2438     .
     2439   define temp-table temp-browse-handle no-undo
     2440     field browse-type   as character
     2441     field browse-number as integer
     2442     field browse-handle as handle
     2443     field original-size as decimal
     2444     index xpk is primary unique browse-type browse-number
     2445     index xie browse-type browse-handle
     2446   .
     2447   procedure diasize_change-height :
     2448     define input  parameter p-change-value  as decimal   no-undo .
     2449     define input  parameter p-move-resize   as logical   no-undo .
     2450     define variable v-field-group-handle    as handle    no-undo .
     2451     define variable v-object-handle         as handle    no-undo .
     2452     define variable v-frame-height          as decimal   no-undo .
     2453     define variable v-frame-virtual-height  as decimal   no-undo .
     2454     define variable v-browse-height         as decimal   no-undo .
     2455     define variable v-window-height         as decimal   no-undo .
     2456     define variable v-window-virtual-height as decimal   no-undo .
     2457     define variable v-change-sign           as integer   no-undo .
     2458     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2459     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2460     if p-change-value > 0
     2461     then do:
     2462       if frame Dialog-Frame :height + p-change-value
     2463           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2464       then do:
     2465         assign
     2466           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2467                           - (frame Dialog-Frame :height-chars)
     2468         .
     2469         if p-change-value <= 0
     2470         then do:
     2471           run diasize_position-resize-button in this-procedure .
     2472           return .
     2473         end.
     2474       end.
     2475     end.
     2476     if p-change-value < 0
     2477     then do:
     2478       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2479       then do:
     2480         assign
     2481           p-change-value = v-diasize-orig-frame-height
     2482                          - (frame Dialog-Frame :height-chars)
     2483         .
     2484         if p-change-value >= 0
     2485         then do:
     2486           run diasize_position-resize-button in this-procedure .
     2487           return .
     2488         end.
     2489       end.
     2490     end.
     2491     if p-change-value >= 0
     2492     then do:
     2493       assign
     2494         v-change-sign = 1
     2495       .
     2496     end.
     2497     else do:
     2498       assign
     2499         v-change-sign = -1
     2500       .
     2501     end.
     2502     assign
     2503       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2504     .
     2505     if p-change-value = 0
     2506     then do:
     2507       run diasize_position-resize-button in this-procedure .
     2508       return .
     2509     end.
     2510     move_block:
     2511     do
     2512     on error undo move_block, retry move_block
     2513     :
     2514       if retry
     2515       then do:
     2516         do
     2517         on error undo move_block, leave move_block
     2518         :
     2519           if p-change-value > 0
     2520           then do:
     2521             for each buf_temp-diasize-handle
     2522             on error undo, next
     2523             :
     2524               assign
     2525                 v-object-handle = buf_temp-diasize-handle.handle-value
     2526               .
     2527               if v-object-handle <> v-diasize-resize-button
     2528               then do:
     2529                 assign
     2530                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2531                 .
     2532               end.
     2533             end.
     2534             assign
     2535               v-diasize-browse-handle :height = v-browse-height
     2536             .
     2537             for each buf_temp-browse-handle
     2538               where buf_temp-browse-handle.browse-type = 'height':u
     2539             on error undo, next
     2540             :
     2541               assign
     2542                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2543               .
     2544             end.
     2545             assign
     2546               frame Dialog-Frame :height = v-frame-height
     2547             .
     2548             if frame Dialog-Frame :scrollable = true
     2549             then do:
     2550               assign
     2551                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2552               .
     2553             end.
     2554             run diasize_position-resize-button in this-procedure .
     2555           end.
     2556           else do:
     2557             if frame Dialog-Frame :scrollable = true
     2558             then do:
     2559               assign
     2560                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2561               .
     2562             end.
     2563             assign
     2564               frame Dialog-Frame :height = v-frame-height
     2565             .
     2566             assign
     2567               v-diasize-browse-handle :height = v-browse-height
     2568             .
     2569             for each buf_temp-browse-handle
     2570               where buf_temp-browse-handle.browse-type = 'height':u
     2571             on error undo, next
     2572             :
     2573               assign
