     2829         (input  (p-new-height - frame Dialog-Frame :height)
     2830         ,input  p-move-resize
     2831         ) .
     2832     end.
     2833   end procedure.
     2834   procedure diasize_change-width :
     2835     define input  parameter p-change-value as decimal   no-undo .
     2836     define input  parameter p-move-resize  as logical   no-undo .
     2837     define variable v-field-group-handle   as handle    no-undo .
