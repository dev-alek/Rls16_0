     3184         run diasize_position-resize-button in this-procedure .
     3185       end.
     3186       if v-diasize-wndstore = true
     3187       then do:
     3188         if connected("ub") = true
     3189         then do:
     3190           define variable v-cntxt-db-num        as integer   no-undo .
     3191           define variable v-cntxt-userid        as character no-undo .
     3192           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3193                                             , OUTPUT v-cntxt-userid
     3194                                             ) .
     3195           run gbl/wndsizew.p
     3196             (input  v-cntxt-db-num
     3197             ,input  v-cntxt-userid
     3198             ,input  v-diasize-proc-name
     3199             ,input  'width':u
     3200             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     3201             ) .
     3202         end.
     3203       end.
     3204     end.
     3205     assign
     3206       v-diasize-change-size = false
     3207     .
     3208   end procedure.
     3209   procedure diasize_set-width :
     3210     define input  parameter p-new-width  as decimal   no-undo .
     3211     define input  parameter p-move-resize as logical   no-undo .
     3212     do
     3213     on error undo, return error return-value
     3214     :
     3215       run diasize_change-width in this-procedure
     3216         (input  (p-new-width - frame Dialog-Frame :width)
     3217         ,input  p-move-resize
     3218         ) .
     3219     end.
     3220   end procedure.
     3221   procedure diasize_position-resize-button :
     3222     do with frame Dialog-Frame
     3223     :
     3224       hide v-diasize-resize-button .
     3225       assign
     3226         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3227                     - 1
     3228                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3229         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3230                     - 1
     3231                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3232       .
     3233       view v-diasize-resize-button .
     3234     end.
     3235   end procedure.
     3236   on alt-right anywhere
     3237   do:
     3238     run diasize_change-width in this-procedure
     3239       (input 1
     3240       ,input true
     3241       ) .
     3242     return no-apply .
     3243   end.
     3244   on alt-left anywhere
     3245   do:
     3246     run diasize_change-width in this-procedure
     3247       (input -1
     3248       ,input true
     3249       ) .
     3250     return no-apply .
     3251   end.
     3252   on alt-down anywhere
     3253   do:
     3254     run diasize_change-height in this-procedure
     3255       (input 1
     3256       ,input true
     3257       ) .
     3258     return no-apply .
     3259   end.
     3260   on alt-up anywhere
     3261   do:
     3262     run diasize_change-height in this-procedure
     3263       (input -1
     3264       ,input true
     3265       ) .
     3266     return no-apply .
     3267   end.
     3268   on alt-enter of frame Dialog-Frame
     3269   do:
     3270     run diasize_maximize in this-procedure
     3271       (input  ?
     3272       ).
     3273     return no-apply .
     3274   end.
     3275   procedure diasize_end-move :
     3276     do
     3277     on error undo, return error return-value
     3278     :
     3279       define variable v-row-delta as decimal   no-undo .
     3280       define variable v-col-delta as decimal   no-undo .
     3281       define variable v-new-row as decimal   no-undo .
     3282       define variable v-new-col as decimal   no-undo .
     3283       assign
     3284         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3285         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3286       .
     3287       assign
     3288         v-row-delta = v-new-row - frame Dialog-Frame :height
     3289         v-col-delta = v-new-col - frame Dialog-Frame :width
     3290       .
     3291       run diasize_change-height in this-procedure
     3292         (input v-row-delta
     3293         ,input true
     3294         ) .
     3295       run diasize_change-width in this-procedure
     3296         (input v-col-delta
     3297         ,input true
     3298         ) .
     3299     end.
     3300   end procedure.
     3301   procedure diasize_maximize :
     3302     define input  parameter p-action as logical   no-undo .
     3303     do
     3304     on error undo, return error return-value
     3305     :
     3306       if p-action = ?
     3307       then do:
     3308         if v-diasize-need-maximize = true
     3309         then do:
     3310           assign
     3311             p-action = true
     3312           .
     3313         end.
     3314         else do:
     3315           assign
     3316             p-action = false
     3317           .
     3318         end.
     3319       end.
     3320       if p-action = true
     3321       then do:
     3322         run diasize_change-height in this-procedure
     3323           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3324               - frame Dialog-Frame :height-chars
     3325           ,input true
     3326           ) .
     3327         run diasize_change-width in this-procedure
     3328           (input session :width-chars
     3329               - frame Dialog-Frame :width-chars
     3330           ,input true
     3331           ) .
     3332         assign
     3333           v-diasize-need-maximize = false
     3334         .
     3335       end.
     3336       else do:
     3337         run diasize_change-width in this-procedure
     3338           (input v-diasize-orig-frame-width
     3339               - frame Dialog-Frame :width-chars
     3340           ,input true
     3341           ) .
     3342         run diasize_change-height in this-procedure
     3343           (input v-diasize-orig-frame-height
     3344               - frame Dialog-Frame :height-chars
     3345           ,input true
     3346           ) .
     3347         assign
     3348           v-diasize-need-maximize = true
     3349         .
     3350       end.
     3351     end.
     3352   end procedure.
     3353   procedure diasize_restore-orig-size :
     3354     do
     3355     on error undo, return error return-value
     3356     :
     3357       assign
     3358         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3359         v-diasize-current-frame-height = frame Dialog-Frame :height
     3360       .
     3361       run diasize_set-height in this-procedure
     3362         (input  v-diasize-orig-frame-height
     3363         ,input  true
     3364         ) .
     3365       run diasize_set-width in this-procedure
     3366         (input  v-diasize-orig-frame-width
     3367         ,input  true
     3368         ) .
     3369     end.
     3370   end procedure.
     3371   procedure diasize_restore-current-size :
     3372     do
     3373     on error undo, return error return-value
     3374     :
     3375       run diasize_set-height in this-procedure
     3376         (input  v-diasize-current-frame-height
     3377         ,input  true
     3378         ) .
     3379       run diasize_set-width in this-procedure
     3380         (input  v-diasize-current-frame-width
     3381         ,input  true
     3382         ) .
     3383     end.
     3384   end procedure.
     3385   procedure diasize_set-browse-handle :
     3386     define input  parameter p-browse-handle as handle   no-undo .
     3387     define buffer buf_temp-browse-handle for temp-browse-handle .
     3388     do
     3389     on error undo, return error return-value
     3390     :
     3391       assign
     3392         v-diasize-browse-handle = p-browse-handle
     3393       .
     3394       for each buf_temp-browse-handle
     3395       on error undo, return error return-value
     3396       :
     3397         delete buf_temp-browse-handle .
     3398       end.
     3399     end.
     3400   end procedure.
     3401   procedure diasize_add_browse :
     3402     define input  parameter p-browse-type   as character no-undo .
     3403     define input  parameter p-browse-handle as handle    no-undo .
     3404     define buffer buf_temp-browse-handle for temp-browse-handle .
     3405     do
     3406     on error undo, return error return-value
     3407     :
     3408       assign
     3409         v-diasize-browse-number = v-diasize-browse-number + 1
     3410       .
     3411       create buf_temp-browse-handle .
     3412       assign
     3413         buf_temp-browse-handle.browse-type   = p-browse-type
     3414         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3415         buf_temp-browse-handle.browse-handle = p-browse-handle
     3416       .
     3417     end.
     3418   end procedure.
     3419   procedure diasize_init :
     3420     define variable v-default-value    as logical   no-undo .
     3421     define variable v-restore-saved    as logical   no-undo .
     3422     define variable v-resize-value-str as character no-undo .
     3423     do
     3424     on error undo, return error return-value
     3425     :
     3426       do with frame Dialog-Frame
     3427       :
     3428         assign
     3429           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3430           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3431           v-diasize-browse-handle     = browse BR-firm :handle
     3432         .
     3433         create button v-diasize-resize-button
     3434         assign
     3435           parent        = frame Dialog-Frame :first-child
     3436           label         = "s"
     3437           height-pixels = 16
     3438           width-pixels  = 16
     3439           visible       = true
     3440           sensitive     = true
     3441           movable       = true
     3442           triggers:
     3443             on end-move persistent run diasize_end-move in this-procedure .
     3444           end triggers.
     3445         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3446         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3447         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3448         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3449         assign
     3450           v-diasize-wndmax = false
     3451         .
     3452         if connected("ub") = true
     3453         then do:
     3454           define variable v-cntxt-db-num        as integer   no-undo .
     3455           define variable v-cntxt-userid        as character no-undo .
     3456           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3457                                             , OUTPUT v-cntxt-userid
     3458                                             ) .
     3459           run gbl/wndpar_r.p
     3460             (input  v-cntxt-db-num
     3461             ,input  v-cntxt-userid
     3462             ,input  'wndmax':U
     3463             ,output v-diasize-wndmax
     3464             ,output v-default-value
     3465             ) .
     3466         end.
     3467         assign
     3468           v-diasize-wndstore = false
     3469         .
     3470         if connected("ub") = true
     3471         then do:
     3472           run gbl/wndpar_r.p
     3473             (input  v-cntxt-db-num
     3474             ,input  v-cntxt-userid
     3475             ,input  'wndstore':U
     3476             ,output v-diasize-wndstore
     3477             ,output v-default-value
     3478             ) .
     3479         end.
     3480         assign
     3481           v-diasize-proc-name = entry(1, program-name(2), '.')
     3482         .
     3483         if v-diasize-wndstore = true
     3484         then do:
     3485           assign
     3486             v-restore-saved = false
     3487           .
     3488           if connected("ub") = true
     3489           then do:
     3490             run gbl/wndsizer.p
     3491               (input  v-cntxt-db-num
     3492               ,input  v-cntxt-userid
     3493               ,input  v-diasize-proc-name
     3494               ,input  'height':u
     3495               ,output v-resize-value-str
     3496               ) .
     3497             if v-resize-value-str <> '':U
     3498             then do:
     3499               run diasize_change-height in this-procedure
     3500                 (input  integer(v-resize-value-str)
     3501                 ,input  true
     3502                 ) .
     3503               assign
     3504                 v-restore-saved = true
     3505               .
     3506             end.
     3507           end.
     3508           if connected("ub") = true
     3509           then do:
     3510             run gbl/wndsizer.p
     3511               (input  v-cntxt-db-num
     3512               ,input  v-cntxt-userid
     3513               ,input  v-diasize-proc-name
     3514               ,input  'width':u
     3515               ,output v-resize-value-str
     3516               ) .
     3517             if v-resize-value-str <> '':U
     3518             then do:
     3519               run diasize_change-width in this-procedure
     3520                 (input  integer(v-resize-value-str)
     3521                 ,input  true
     3522                 ) .
     3523               assign
     3524                 v-restore-saved = true
     3525               .
     3526             end.
     3527           end.
     3528           if v-restore-saved <> true
     3529           then do:
     3530             if v-diasize-wndmax = true
     3531             then do:
     3532               run diasize_maximize in this-procedure
     3533                 (input  true
     3534                 ) .
     3535             end.
     3536           end.
     3537         end.
     3538         else do:
     3539           if v-diasize-wndmax = true
     3540           then do:
     3541             run diasize_maximize in this-procedure
     3542               (input  true
     3543               ) .
     3544           end.
     3545         end.
     3546       end.
     3547     end.
     3548   end procedure.
     3549   procedure diasize_need-full-display :
     3550     define output parameter p-need-full-display as logical   no-undo .
     3551     do
     3552     on error undo, return error return-value
     3553     :
     3554       assign
     3555         p-need-full-display = v-diasize-need-full-display
     3556       .
     3557       assign
     3558         v-diasize-need-full-display = false
     3559       .
     3560     end.
     3561   end procedure.
     3562   procedure get-context :
     3563      define output parameter p-db-num as integer          no-undo.
     3564      define output parameter p-user-id as character        no-undo.
     3565      define variable v-login               as character    no-undo.
     3566      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3567      define buffer buf_user-login  for ub.user-login .
     3568      do
     3569      on error undo, return error
     3570      :
     3571            FIND FIRST buf_sys-ctrl no-lock.
     3572            ASSIGN
     3573               v-login = USERID("ub")
     3574               p-db-num = buf_sys-ctrl.db-num
     3575            .
     3576            FIND FIRST buf_user-login
     3577                 WHERE buf_user-login.db-num = p-db-num
     3578                   AND buf_user-login.user-login = v-login
     3579                 no-lock
     3580                 no-error
     3581                 .
     3582            IF AVAILABLE buf_user-login
     3583            THEN DO:
     3584               assign
     3585                  p-user-id = buf_user-login.user-id
     3586               .
     3587            END.
     3588      end.
     3589   end procedure.
     3590       run diasize_init in this-procedure .
     3591   MAIN-BLOCK:
     3592   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3593      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3594      run gbl/dftempl.p ( input 'rp-rule-param':U
     3595                        , output v-dflt-rec) no-error.
     3596       if error-status:error then dO:
     3597         message
     3598         vss-workfile vss-revision vss-description skip
     3599         "Невозможно найти recid template записи в таблице rp-rule-param"
     3600         view-as alert-box error .
     3601         return error.
     3602       end.
     3603       run gbl/dftempl.p ( input 'ruledict-param':U
     3604                         , output v-rp-dflt-rec) no-error.
     3605        if error-status:error then dO:
     3606          message
     3607          vss-workfile vss-revision vss-description skip
     3608          "Невозможно найти recid template записи в таблице ruledict-param"
     3609          view-as alert-box error .
     3610          return error.
     3611        end.
     3612     IF p-list-mode = 'rp-rule-param':U
     3613     THEN DO:
     3614       FIND FIRST buf_rule-profile NO-LOCK WHERE
     3615                 buf_rule-profile.profile_id = p-profile-id.
     3616       run gen-key-rec in this-procedure ( input 'rule-profile':U
     3617                                       ,input buffer buf_rule-profile:handle
     3618                                       ,output v-uniq-key-rec).
     3619       FIND FIRST buf_ruledict NO-LOCK WHERE
     3620                 buf_ruledict.entry-type = 'rule-profile':U
     3621          AND  buf_ruledict.uniq-key-rec = v-uniq-key-rec.
     3622       v-rcps-entry-id = buf_ruledict.entry-id.
     3623     END.
     3624     ELSE DO:
     3625        MESSAGE
     3626        substitute("Неверное значение параметра p-list-mode=&1", p-list-mode)
     3627        VIEW-AS alert-box.
     3628     END.
     3629     RUN rcps_fill-table IN THIS-PROCEDURE ( input yes).
     3630     RUN fill-conf-import IN THIS-PROCEDURE.
     3631     RUN Myenable in THIS-PROCEDURE.
     3632     WAIT-FOR GO OF FRAME Dialog-Frame.
     3633   END.
     3634   RUN disable_UI.
     3635   PROCEDURE disable_UI :
     3636     HIDE FRAME Dialog-Frame.
     3637   END PROCEDURE.
     3638   PROCEDURE enable_UI :
     3639     DISPLAY delim EDITOR-1 Rs-uniq-method cli-grp-name
     3640         WITH FRAME Dialog-Frame.
     3641     ENABLE B-exit b-quit B-Help B-cli-grp b-up-firm b-down-firm b-up-person
     3642            b-down-person BR-firm BR-person delim EDITOR-1 Rs-uniq-method BR-rcp
     3643            cli-grp-name
     3644         WITH FRAME Dialog-Frame.
     3645     VIEW FRAME Dialog-Frame.
     3646     OPEN QUERY BR-firm FOR EACH firm_conf-import WHERE firm_conf-import.subject = 'firm':U.    OPEN QUERY BR-person FOR EACH person_conf-import WHERE person_conf-import.subject = 'person':U.
     3647   END PROCEDURE.
     3648   PROCEDURE fill-conf-import :
     3649   DEFINE VARIABLE v-position-firm AS INTEGER NO-UNDO.
     3650   DEFINE VARIABLE v-position-person AS INTEGER NO-UNDO.
     3651   CREATE conf-import.                                               ASSIGN                                                            conf-import.subject = 'firm':U                                conf-import.table-name = 'clients':U                          conf-import.field-name = "OBJ-TYPE"                          conf-import.full-field-name = 'clients':U + "." + "OBJ-TYPE"    conf-import.field-label = "Тип клиента"                       conf-import.is-mandatory = YES                      conf-import.to-import = (IF conf-import.is-mandatory = YES                                 THEN  YES                                                         ELSE NO)                                 conf-import.POSITION_ = (IF conf-import.subject = 'firm':U                           THEN v-position-firm + 1                                           ELSE v-position-person + 1)                   v-position-firm =  (IF conf-import.subject = 'firm':U               THEN v-position-firm + 1                                             ELSE v-position-firm)                                   v-position-person =  (IF conf-import.subject = 'person':U             THEN v-position-person + 1                                           ELSE v-position-person).
     3652   CREATE conf-import.                                               ASSIGN                                                            conf-import.subject = 'person':U                                conf-import.table-name = 'clients':U                          conf-import.field-name = "OBJ-TYPE"                          conf-import.full-field-name = 'clients':U + "." + "OBJ-TYPE"    conf-import.field-label = "Тип клиента"                       conf-import.is-mandatory = YES                      conf-import.to-import = (IF conf-import.is-mandatory = YES                                 THEN  YES                                                         ELSE NO)                                 conf-import.POSITION_ = (IF conf-import.subject = 'firm':U                           THEN v-position-firm + 1                                           ELSE v-position-person + 1)                   v-position-firm =  (IF conf-import.subject = 'firm':U               THEN v-position-firm + 1                                             ELSE v-position-firm)                                   v-position-person =  (IF conf-import.subject = 'person':U             THEN v-position-person + 1                                           ELSE v-position-person).
     3653   CREATE conf-import.                                               ASSIGN                                                            conf-import.subject = 'firm':U                                conf-import.table-name = 'clients':U                          conf-import.field-name = "OBJ-code"                          conf-import.full-field-name = 'clients':U + "." + "OBJ-code"    conf-import.field-label = "Код клиента"                       conf-import.is-mandatory = YES                      conf-import.to-import = (IF conf-import.is-mandatory = YES                                 THEN  YES                                                         ELSE NO)                                 conf-import.POSITION_ = (IF conf-import.subject = 'firm':U                           THEN v-position-firm + 1                                           ELSE v-position-person + 1)                   v-position-firm =  (IF conf-import.subject = 'firm':U               THEN v-position-firm + 1                                             ELSE v-position-firm)                                   v-position-person =  (IF conf-import.subject = 'person':U             THEN v-position-person + 1                                           ELSE v-position-person).
     3654   CREATE conf-import.                                               ASSIGN                                                            conf-import.subject = 'person':U                                conf-import.table-name = 'clients':U                          conf-import.field-name = "OBJ-code"                          conf-import.full-field-name = 'clients':U + "." + "OBJ-code"    conf-import.field-label = "Код клиента"                       conf-import.is-mandatory = YES                      conf-import.to-import = (IF conf-import.is-mandatory = YES                                 THEN  YES                                                         ELSE NO)                                 conf-import.POSITION_ = (IF conf-import.subject = 'firm':U                           THEN v-position-firm + 1                                           ELSE v-position-person + 1)                   v-position-firm =  (IF conf-import.subject = 'firm':U               THEN v-position-firm + 1                                             ELSE v-position-firm)                                   v-position-person =  (IF conf-import.subject = 'person':U             THEN v-position-person + 1                                           ELSE v-position-person).
