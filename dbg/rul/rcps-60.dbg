     1241     Col-name[250]=   'IP':U
     1242     Col-name[251]=   'IQ':U
     1243     Col-name[252]=   'IR':U
     1244     Col-name[253]=   'IS':U
     1245     Col-name[254]=   'IT':U
     1246     Col-name[255]=   'IU':U
     1247     Col-name[256]=   'IV':U
     1248     .
     1249    end.
     1250   end procedure.
     1251   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1252   DEFINE VARIABLE v-ch AS WIDGET-HANDLE NO-UNDO EXTENT 6.
     1253   DEFINE VARIABLE v-dflt-rec AS RECID NO-UNDO.
     1254   DEFINE VARIABLE v-rp-dflt-rec AS RECID NO-UNDO.
     1255   DEFINE VARIABLE v-rcps-entry-id AS INTEGER NO-UNDO.
     1256   DEFINE VARIABLE v-uniq-key-rec AS character NO-UNDO.
     1257   DEFINE VARIABLE rule-display-option AS CHARACTER NO-UNDO.
     1258   DEFINE BUFFER buf_Rule-profile FOR ub.rule-profile.
     1259   DEFINE BUFFER buf_Ruledict FOR ub.ruledict.
     1260   DEFINE BUFFER call_tt-rule-call-param FOR tt-rule-call-param.
     1261   define buffer term_tt-rule-call-param for tt-rule-call-param.
     1262   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1263   procedure rcps_get-profile-id :
     1264   define output parameter p-local-profile-id as integer no-undo .
     1265   do
     1266   on error undo, return error:
     1267   p-local-profile-id = p-profile-id.
     1268   end.
     1269   end procedure.
     1270   PROCEDURE rcps_fill-table :
     1271   define input parameter p-clear-params as logical no-undo .
     1272   if p-clear-params then do:
     1273   FOR EACH tt-rule-call-param:
     1274       DELETE tt-rule-call-param.
     1275   END.
     1276   end.
     1277    FOR EACH tt0-rule-call-param:
     1278      IF p-mode <> 'ДОБАВЛЕНИЕ':U THEN DO:
     1279        IF p-call-id <> '':U and p-call-id <> tt0-rule-call-param.call_id THEN do:
     1280           NEXT.
     1281        end.
     1282        IF p-codex-id <> 0 and p-codex-id <> tt0-rule-call-param.codex_id THEN do:
     1283          NEXT.
     1284        end.
     1285        IF p-ruleset-id <> 0 and p-ruleset-id <> tt0-rule-call-param.ruleset_id THEN do:
     1286          NEXT.
     1287        end.
     1288        IF p-rule-id <> 0 and p-rule-id <> tt0-rule-call-param.RULE_id THEN do:
     1289          NEXT.
     1290        end.
     1291        IF p-order-id <> ? and p-order-id <> tt0-rule-call-param.order_id THEN do:
     1292          NEXT.
     1293        end.
     1294      END.
     1295      if lookup("hidden", tt0-rule-call-param.param-3-data-type) > 0 then do:
     1296        next.
     1297      end.
     1298      IF p-list-mode = 'rp-rule-param':U
     1299      or p-list-mode = 'rp-rule-param':U  + chr(44) + 'все':U
     1300      THEN DO:
     1301         IF p-profile-id <> 0 AND p-profile-id <> tt0-rule-call-param.profile_id THEN do:
     1302           NEXT.
     1303         end.
     1304         IF p-once-more <> ? AND p-once-more <> tt0-rule-call-param.once-more THEN do:
     1305           NEXT.
     1306         end.
     1307      END.
     1308      CREATE tt-rule-call-param.
     1309      BUFFER-COPY tt0-rule-call-param TO tt-rule-call-param.
     1310   END.
     1311   END PROCEDURE.
     1312   procedure rcps_get-value :
     1313   DEFINE INPUT PARAMETER p-profile-id AS integer NO-UNDO.
     1314   DEFINE INPUT PARAMETER p-once-more AS integer NO-UNDO.
     1315   DEFINE INPUT PARAMETER p-call-id AS CHARACTER NO-UNDO.
     1316   DEFINE INPUT PARAMETER p-rp-param-name AS CHARACTER NO-UNDO.
     1317   DEFINE INPUT-output PARAMETER pp-index AS integer NO-UNDO.
     1318   DEFINE output parameter p-value-character AS CHARACTER NO-UNDO.
     1319   DEFINE output parameter p-value-date AS date NO-UNDO.
     1320   DEFINE output parameter p-value-decimal AS decimal NO-UNDO.
     1321   DEFINE output parameter p-value-integer AS integer NO-UNDO.
     1322   DEFINE output parameter p-value-logical AS logical NO-UNDO.
     1323   define variable v-current-index as integer no-undo init -1.
     1324   define variable v-start as logical no-undo init yes.
     1325   DEFINE BUFFER buf_ruledict-param FOR ub.ruledict-param.
     1326   DEFINE BUFFER buf_rp-rule-param FOR ub.rp-rule-param.
     1327   DEFINE BUFFER buf_tt-rule-call-param FOR tt-rule-call-param.
     1328   DEFINE BUFFER buf_term_tt-rule-call-param FOR tt-rule-call-param.
     1329   do
     1330   on error undo, return error
     1331   :
     1332   FOR FIRST buf_rp-rule-param WHERE
     1333         buf_rp-rule-param.profile_id = p-profile-id
     1334     AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     1335   , each buf_tt-rule-call-param WHERE
     1336      buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     1337   AND buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     1338   AND buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     1339   AND buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     1340   AND buf_tt-rule-call-param.p-index >= pp-index
     1341    ,each buf_term_tt-rule-call-param where
     1342          buf_term_tt-rule-call-param.call_id = buf_tt-rule-call-param.call_id
     1343      and buf_term_tt-rule-call-param.codex_id = buf_tt-rule-call-param.codex_id
     1344      and buf_term_tt-rule-call-param.ruleset_id = buf_tt-rule-call-param.ruleset_id
     1345      and buf_term_tt-rule-call-param.order_id = buf_tt-rule-call-param.order_id
     1346      and buf_term_tt-rule-call-param.param-name = buf_tt-rule-call-param.param-name
     1347      and buf_term_tt-rule-call-param.p-index = buf_tt-rule-call-param.p-index
     1348     by buf_term_tt-rule-call-param.call_id
     1349     by buf_term_tt-rule-call-param.codex_id
     1350     by buf_term_tt-rule-call-param.ruleset_id
     1351     by buf_term_tt-rule-call-param.order_id
     1352     by buf_term_tt-rule-call-param.param-name
     1353     by buf_term_tt-rule-call-param.p-index :
     1354       if v-start
     1355       then do:
     1356         assign
     1357         pp-index = buf_term_tt-rule-call-param.p-index
     1358         p-value-character = buf_term_tt-rule-call-param.param-value-character
     1359         p-value-date      = buf_term_tt-rule-call-param.param-value-date
     1360         p-value-decimal   = buf_term_tt-rule-call-param.param-value-decimal
     1361         p-value-integer   = buf_term_tt-rule-call-param.param-value-integer
     1362         p-value-logical   = buf_term_tt-rule-call-param.param-value-logical
     1363         v-start = no
     1364         .
     1365       end.
     1366       else do:
     1367         if buf_term_tt-rule-call-param.p-index > pp-index then do:
     1368           v-current-index = buf_term_tt-rule-call-param.p-index.
     1369           leave.
     1370         end.
     1371             end.
     1372     end.
     1373     pp-index = v-current-index.
     1374   end.
     1375   end procedure.
     1376   PROCEDURE rcps_proc-b-add :
     1377   DEFINE INPUT PARAMETER p-profile-id AS integer NO-UNDO.
     1378   DEFINE INPUT PARAMETER p-once-more AS integer NO-UNDO.
     1379   DEFINE INPUT PARAMETER p-call-id AS CHARACTER NO-UNDO.
     1380   DEFINE INPUT PARAMETER p-rp-param-name AS CHARACTER NO-UNDO.
     1381   DEFINE INPUT PARAMETER p-index AS integer NO-UNDO.
     1382   define variable v-ind as integer no-undo .
     1383   define buffer buf_tt-rule-call-param for tt-rule-call-param.
     1384   define buffer buf0_tt-rule-call-param for tt-rule-call-param.
     1385   define buffer buf2_tt-rule-call-param for tt-rule-call-param.
     1386   define buffer buf_rp-rule-param for ub.rp-rule-param.
     1387   FOR FIRST buf_rp-rule-param WHERE
     1388             buf_rp-rule-param.profile_id = p-profile-id
     1389         AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     1390       , first buf0_tt-rule-call-param WHERE
     1391          buf0_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     1392      AND buf0_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     1393      AND buf0_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     1394      AND buf0_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name:
     1395     LEAVE.
     1396   END.
     1397   IF NOT AVAILABLE buf0_tt-rule-call-param THEN do:
     1398     BELL.
     1399     RETURN.
     1400   END.
     1401   for each buf_rp-rule-param where
     1402           buf_rp-rule-param.rp-param-name = p-rp-param-name
     1403       and buf_rp-rule-param.profile_id = p-profile-id,
     1404       first buf_tt-rule-call-param where
     1405           buf_tt-rule-call-param.call_id = buf0_tt-rule-call-param.call_id
     1406       and buf_tt-rule-call-param.profile_id = buf_rp-rule-param.profile_id
     1407       and buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     1408       and buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     1409       and buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     1410       and buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     1411       and buf_tt-rule-call-param.once-more = buf0_tt-rule-call-param.once-more
     1412       and buf_tt-rule-call-param.p-index = p-index:
     1413     RETURN.
     1414   END.
     1415   IF lookup("LIST", buf0_tt-rule-call-param.param-3-data-type) = 0
     1416   and lookup("SORTED-LIST", buf0_tt-rule-call-param.param-3-data-type) = 0
     1417   THEN DO:
     1418     BELL.
     1419     RETURN.
     1420   END.
     1421   IF buf0_tt-rule-call-param.p-index <> 0 THEN DO:
     1422     BELL.
     1423     RETURN.
     1424   END.
     1425   find last buf_tt-rule-call-param where
     1426            buf_tt-rule-call-param.call_id = buf0_tt-rule-call-param.call_id
     1427        and buf_tt-rule-call-param.codex_id = buf0_tt-rule-call-param.codex_id
     1428        and buf_tt-rule-call-param.ruleset_id = buf0_tt-rule-call-param.ruleset_id
     1429        and buf_tt-rule-call-param.order_id = buf0_tt-rule-call-param.order_id
     1430        and buf_tt-rule-call-param.param-name = buf0_tt-rule-call-param.param-name no-error .
     1431   if available buf_tt-rule-call-param
     1432   and (lookup("LIST", buf_tt-rule-call-param.param-3-data-type) > 0
     1433        or
     1434        lookup("SORTED-LIST", buf_tt-rule-call-param.param-3-data-type) > 0
     1435        )
     1436   and buf_tt-rule-call-param.p-index > 0 then do:
     1437     v-ind = buf_tt-rule-call-param.p-index.
     1438   end.
     1439   for each buf_rp-rule-param where
     1440           buf_rp-rule-param.rp-param-name = p-rp-param-name
     1441       and buf_rp-rule-param.profile_id = p-profile-id,
     1442       first buf_tt-rule-call-param where
     1443           buf_tt-rule-call-param.call_id = buf0_tt-rule-call-param.call_id
     1444       and buf_tt-rule-call-param.profile_id = buf_rp-rule-param.profile_id
     1445       and buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     1446       and buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     1447       and buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     1448       and buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     1449       and buf_tt-rule-call-param.once-more = buf0_tt-rule-call-param.once-more
     1450       and buf_tt-rule-call-param.p-index = 0
     1451   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1452   on stop   undo, return error substitute( "&1. stop", vss-workfile )
     1453   on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     1454   :
     1455     create buf2_tt-rule-call-param.
     1456     buffer-copy buf_tt-rule-call-param
     1457     except p-index
     1458     to buf2_tt-rule-call-param
     1459     assign
     1460     buf2_tt-rule-call-param.p-index = v-ind + 1
     1461     .
     1462   end.
     1463   END PROCEDURE.
     1464   PROCEDURE rcps_proc-b-del :
     1465   DEFINE INPUT PARAMETER p-profile-id AS integer NO-UNDO.
     1466   DEFINE INPUT PARAMETER p-once-more AS integer NO-UNDO.
     1467   DEFINE INPUT PARAMETER p-call-id AS CHARACTER NO-UNDO.
     1468   DEFINE INPUT PARAMETER p-rp-param-name AS CHARACTER NO-UNDO.
     1469   DEFINE INPUT PARAMETER pp-index AS integer NO-UNDO.
     1470   define variable v-ind as integer no-undo .
     1471   define variable v-once-more as integer no-undo .
     1472   define variable v-call-id as character no-undo .
     1473   define buffer buf0_tt-rule-call-param for tt-rule-call-param.
     1474   define buffer buf_tt-rule-call-param for tt-rule-call-param.
     1475   define buffer buf_rp-rule-param for ub.rp-rule-param.
     1476   if pp-index = 0 then do:
     1477     undo, return error substitute("Нельзя удалять корневой параметр &1 (индекс = 0)", p-rp-param-name).
     1478   end.
     1479   FOR first buf_rp-rule-param WHERE
     1480             buf_rp-rule-param.profile_id = p-profile-id
     1481         AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     1482       , first buf0_tt-rule-call-param WHERE
     1483          buf0_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     1484      AND buf0_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     1485      AND buf0_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     1486      AND buf0_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     1487      AND buf0_tt-rule-call-param.p-index = pp-index
     1488      :
     1489     LEAVE.
     1490   END.
     1491   IF NOT AVAILABLE buf0_tt-rule-call-param THEN do:
     1492     FOR first buf_rp-rule-param WHERE
     1493               buf_rp-rule-param.profile_id = p-profile-id
     1494           AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     1495         , last buf0_tt-rule-call-param WHERE
     1496           buf0_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     1497       AND buf0_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     1498       AND buf0_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     1499       AND buf0_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     1500       AND buf0_tt-rule-call-param.p-index > pp-index :
     1501       leave.
     1502     end.
     1503     IF NOT AVAILABLE buf0_tt-rule-call-param THEN do:
     1504     return "not-found".
     1505     end.
     1506     else do:
     1507       return ''.
     1508     end.
     1509   END.
     1510   IF lookup("LIST", buf0_tt-rule-call-param.param-3-data-type) = 0
     1511   and lookup("SORTED-LIST", buf0_tt-rule-call-param.param-3-data-type) = 0
     1512   THEN DO:
     1513     undo, return error substitute("Можно удалять только параметры типа LIST и SORTED-LIST").
     1514   END.
     1515   IF lookup("READ-ONLY", buf0_tt-rule-call-param.param-3-data-type) > 0 THEN DO:
     1516     undo, return error substitute("Нельзя удалять  параметры типа READ-ONLY").
     1517   END.
     1518   for each buf_rp-rule-param where
     1519           buf_rp-rule-param.rp-param-name = buf_rp-rule-param.rp-param-name
     1520       and buf_rp-rule-param.profile_id = buf_rp-rule-param.profile_id,
     1521       each buf_tt-rule-call-param where
     1522           buf_tt-rule-call-param.call_id = p-call-id
     1523       and buf_tt-rule-call-param.profile_id = buf_rp-rule-param.profile_id
     1524       and buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     1525       and buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     1526       and buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     1527       and buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     1528       and buf_tt-rule-call-param.once-more = p-once-more
     1529       and buf_tt-rule-call-param.p-index = pp-index
     1530   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1531   on stop   undo, return error substitute( "&1. stop", vss-workfile )
     1532   on endkey undo, return error substitute( "&1. endkey", vss-workfile ):
     1533       DELETE buf_tt-rule-call-param.
     1534   end.
     1535   return ''.
     1536   END PROCEDURE.
     1537   PROCEDURE rcps_proc-save0 :
     1538   FOR EACH tt-rule-call-param
     1539   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1540   on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1541   on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1542   :
     1543      find  FIRST tt0-rule-call-param NO-LOCK WHERE
     1544               tt0-rule-call-param.codex_id = tt-rule-call-param.codex_id
     1545          AND  tt0-rule-call-param.ruleset_id = tt-rule-call-param.ruleset_id
     1546          AND tt0-rule-call-param.call_id = tt-rule-call-param.call_id
     1547          AND tt0-rule-call-param.order_id = tt-rule-call-param.order_id
     1548          AND tt0-rule-call-param.param-name = tt-rule-call-param.param-name
     1549          AND tt0-rule-call-param.p-index = tt-rule-call-param.p-index no-error .
     1550      if not available tt0-rule-call-param
     1551      and (lookup("LIST", tt-rule-call-param.param-3-data-type) > 0
     1552           OR
     1553           lookup("SORTED-LIST", tt-rule-call-param.param-3-data-type) > 0
     1554           )
     1555      and tt-rule-call-param.p-index > 0 then do:
     1556        create tt0-rule-call-param.
     1557      end.
     1558      BUFFER-COPY tt-rule-call-param TO tt0-rule-call-param.
     1559   END.
     1560   FOR EACH tt0-rule-call-param
     1561   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1562   on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1563   on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1564   :
     1565     if tt0-rule-call-param.p-index = 0 then next.
     1566     if lookup("hidden", tt0-rule-call-param.param-3-data-type) > 0 then next.
     1567     find  FIRST tt-rule-call-param NO-LOCK WHERE
     1568             tt-rule-call-param.codex_id = tt0-rule-call-param.codex_id
     1569         AND tt-rule-call-param.ruleset_id = tt0-rule-call-param.ruleset_id
     1570         AND tt-rule-call-param.call_id = tt0-rule-call-param.call_id
     1571         AND tt-rule-call-param.order_id = tt0-rule-call-param.order_id
     1572         AND tt-rule-call-param.param-name = tt0-rule-call-param.param-name
     1573         AND tt-rule-call-param.p-index = tt0-rule-call-param.p-index no-error .
     1574     if not available tt-rule-call-param
     1575     and (lookup("LIST", tt0-rule-call-param.param-3-data-type) > 0
     1576         OR
     1577         lookup("SORTED-LIST", tt0-rule-call-param.param-3-data-type) > 0
     1578         )
     1579     and tt0-rule-call-param.p-index > 0
     1580     then do:
     1581        IF p-call-id <> '':U and p-call-id <> tt0-rule-call-param.call_id THEN do:
     1582           NEXT.
     1583        end.
     1584        IF p-codex-id <> 0 and p-codex-id <> tt0-rule-call-param.codex_id THEN do:
     1585          NEXT.
     1586        end.
     1587        IF p-ruleset-id <> 0 and p-ruleset-id <> tt0-rule-call-param.ruleset_id THEN do:
     1588          NEXT.
     1589        end.
     1590        IF p-rule-id <> 0 and p-rule-id <> tt0-rule-call-param.RULE_id THEN do:
     1591          NEXT.
     1592        end.
     1593        IF p-order-id <> ? and p-order-id <> tt0-rule-call-param.order_id THEN do:
     1594          NEXT.
     1595        end.
     1596       IF p-list-mode = 'rp-rule-param':U
     1597       or p-list-mode = 'rp-rule-param':U  + chr(44) + 'все':U
     1598       THEN DO:
     1599         IF p-profile-id <> 0 AND p-profile-id <> tt0-rule-call-param.profile_id THEN do:
     1600           NEXT.
     1601         end.
     1602         IF p-once-more <> ? AND p-once-more <> tt0-rule-call-param.once-more THEN do:
     1603           NEXT.
     1604         end.
     1605       end.
     1606       delete tt0-rule-call-param.
     1607     end.
     1608   end.
     1609   END PROCEDURE.
     1610   PROCEDURE rcps_set-value :
     1611   DEFINE INPUT PARAMETER p-profile-id AS integer NO-UNDO.
     1612   DEFINE INPUT PARAMETER p-once-more AS integer NO-UNDO.
     1613   DEFINE INPUT PARAMETER p-call-id AS CHARACTER NO-UNDO.
     1614   DEFINE INPUT PARAMETER p-rp-param-name AS CHARACTER NO-UNDO.
     1615   DEFINE INPUT PARAMETER pp-index AS integer NO-UNDO.
     1616   DEFINE INPUT parameter p-value-character AS CHARACTER NO-UNDO.
     1617   DEFINE INPUT parameter p-value-date AS date NO-UNDO.
     1618   DEFINE INPUT parameter p-value-decimal AS decimal NO-UNDO.
     1619   DEFINE INPUT parameter p-value-integer AS integer NO-UNDO.
     1620   DEFINE INPUT parameter p-value-logical AS logical NO-UNDO.
     1621   DEFINE VARIABLE v-codex-id AS integer NO-UNDO.
     1622   DEFINE VARIABLE v-ruleset-id AS integer NO-UNDO.
     1623   DEFINE VARIABLE v-order-id AS integer NO-UNDO.
     1624   DEFINE VARIABLE V-param-name AS character NO-UNDO.
     1625   define variable v-found as logical no-undo .
     1626   DEFINE BUFFER buf_tt-rule-call-param FOR tt-rule-call-param.
     1627   DEFINE BUFFER buf_rp-rule-param FOR ub.rp-rule-param.
     1628   FOR FIRST buf_rp-rule-param WHERE
     1629             buf_rp-rule-param.profile_id = p-profile-id
     1630         AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     1631       , first buf_tt-rule-call-param WHERE
     1632          buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     1633      AND buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     1634      AND buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     1635      AND buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name:
     1636     ASSIGN
     1637     v-codex-id = buf_tt-rule-call-param.codex_id
     1638     v-ruleset-id = buf_tt-rule-call-param.ruleset_id
     1639     v-order-id = buf_tt-rule-call-param.order_id
     1640     V-PARAM-NAME = buf_tt-rule-call-param.PARAM-NAME
     1641     .
     1642     LEAVE.
     1643   END.
     1644   CASE p-list-mode:
     1645     WHEN 'rp-rule-param':U THEN DO:
     1646       if pp-index > 0
     1647       then do:
     1648         FOR EACH  buf_rp-rule-param NO-LOCK where
     1649             buf_rp-rule-param.profile_id = p-profile-id
     1650             AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     1651             ,EACH buf_tt-rule-call-param WHERE
     1652                 buf_tt-rule-call-param.profile_id = p-profile-id
     1653             AND buf_tt-rule-call-param.once-more = p-once-more
     1654             AND buf_tt-rule-call-param.call_id = p-CALL-id
     1655             AND buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     1656             AND buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     1657             AND buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     1658             AND buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     1659             AND buf_tt-rule-call-param.p-index = pp-index
     1660         ON error undo, return error :
     1661           v-found = yes.
     1662         end.
     1663       end.
     1664       if not v-found then do:
     1665         run rcps_proc-b-add in this-procedure (
     1666                                                  input p-profile-id
     1667                                                 ,input p-once-more
     1668                                                 ,input p-call-id
     1669                                                 ,
     1670                                                  input p-rp-param-name
     1671                                                 ,input pp-index).
     1672       end.
     1673       FOR EACH  buf_rp-rule-param NO-LOCK where
     1674           buf_rp-rule-param.profile_id = p-profile-id
     1675           AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     1676           ,EACH buf_tt-rule-call-param WHERE
     1677               buf_tt-rule-call-param.profile_id = p-profile-id
     1678           AND buf_tt-rule-call-param.once-more = p-once-more
     1679           AND buf_tt-rule-call-param.call_id = p-CALL-id
     1680           AND buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     1681           AND buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     1682           AND buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     1683           AND buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     1684           AND buf_tt-rule-call-param.p-index = pp-index
     1685         ON error undo, return error :
     1686         assign
     1687         buf_tt-rule-call-param.param-value-character = p-value-character
     1688         buf_tt-rule-call-param.param-value-date      = p-value-date
     1689         buf_tt-rule-call-param.param-value-decimal   = p-value-decimal
     1690         buf_tt-rule-call-param.param-value-integer   = p-value-integer
     1691         buf_tt-rule-call-param.param-value-logical   = p-value-logical
     1692         .
     1693       END.
     1694     END.
     1695     WHEN 'rule-call-param':U THEN DO:
     1696       FIND FIRST buf_tt-rule-call-param WHERE
     1697           buf_tt-rule-call-param.call_id = p-call-id
     1698       AND buf_tt-rule-call-param.codex_id = v-codex-id
     1699       AND buf_tt-rule-call-param.ruleset_id = v-ruleset-id
     1700       AND buf_tt-rule-call-param.order_id = v-order-id
     1701       AND buf_tt-rule-call-param.param-name = V-PARAM-NAME
     1702       AND buf_tt-rule-call-param.p-index = pp-index.
     1703       assign
     1704       buf_tt-rule-call-param.param-value-character = p-value-character
     1705       buf_tt-rule-call-param.param-value-date      = p-value-date
     1706       buf_tt-rule-call-param.param-value-decimal   = p-value-decimal
     1707       buf_tt-rule-call-param.param-value-integer   = p-value-integer
     1708       buf_tt-rule-call-param.param-value-logical   = p-value-logical
     1709       .
     1710     END.
     1711   END CASE.
     1712   END PROCEDURE.
     1713   procedure rcps_get-rule-on-off :
     1714   define input parameter p-codex-id as integer no-undo .
     1715   define input parameter p-ruleset-id as integer no-undo .
     1716   define input parameter p-rule-id as integer no-undo .
     1717   define input parameter p-profile-id as integer no-undo .
     1718   define input parameter p-once-more as integer no-undo .
     1719   define output parameter p-on-off as logical no-undo .
     1720   if valid-handle(p-call-handle)
     1721   and lookup("rcpscont_get-rule-on-off", p-call-handle:internal-entries) > 0 then do:
     1722     run rcpscont_get-rule-on-off in p-call-handle (
     1723                                              input p-codex-id
     1724                                             ,input p-ruleset-id
     1725                                             ,input p-rule-id
     1726                                             ,input p-profile-id
     1727                                             ,input p-once-more
     1728                                             ,output p-on-off) no-error.
     1729   end.
     1730   end procedure.
     1731   procedure rcps_set-rule-on-off :
     1732   define input parameter p-codex-id as integer no-undo .
     1733   define input parameter p-ruleset-id as integer no-undo .
     1734   define input parameter p-rule-id as integer no-undo .
     1735   define input parameter p-profile-id as integer no-undo .
     1736   define input parameter p-once-more as integer no-undo .
     1737   define input parameter p-on-off as logical no-undo .
     1738   if valid-handle(p-call-handle)
     1739   and lookup("rcpscont_get-rule-on-off", p-call-handle:internal-entries) > 0 then do:
     1740     run rcpscont_set-rule-on-off in p-call-handle (
     1741                                              input p-codex-id
     1742                                             ,input p-ruleset-id
     1743                                             ,input p-rule-id
     1744                                             ,input p-profile-id
     1745                                             ,input p-once-more
     1746                                             ,input p-on-off) no-error.
     1747   end.
     1748   end procedure.
     1749   define variable vss-include-info9 as character format "X(65)" no-undo
     1750   initial "@(#)$Workfile$ $Revision$".
     1751   define temp-table temp_onewin_items no-undo
     1752       field itm-key       as integer
     1753       field itmExtKey     as character
     1754       field itmName       as character
     1755       field itmDesc       as character
     1756       field itmSelected   as logical
     1757       index pi is primary unique
     1758           itm-key
     1759       index ie
     1760           itmExtKey
     1761   .
     1762   define temp-table temp_onewin_itemsSelected no-undo
     1763       field its-key   as integer
     1764       field itm-key   as integer
     1765       field itmExtKey as character
     1766       index pi is primary unique
     1767           its-key
     1768       index im
     1769           itm-key
     1770   .
     1771   define variable v-onewin9-itm-key    as integer      no-undo.
     1772   procedure onewin_clear :
     1773       define buffer buf_temp_onewin_items        for temp_onewin_items.
     1774   do
     1775   for buf_temp_onewin_items
     1776   on error undo, return error
     1777   :
     1778       empty temp-table buf_temp_onewin_items.
     1779   end.
     1780   end procedure.
     1781   procedure onewin_add-item :
     1782   define input parameter p-ext-key   as character        no-undo.
     1783   define input parameter p-item-name as character        no-undo.
     1784   define input parameter p-item-desc as character        no-undo.
     1785   define input parameter p-selected  as logical          no-undo.
     1786       define buffer buf_temp_onewin_items        for temp_onewin_items.
     1787   do
     1788   for buf_temp_onewin_items
     1789   on error undo, return error
     1790   :
     1791       find last buf_temp_onewin_items no-error.
     1792       if available buf_temp_onewin_items then do:
     1793         v-onewin9-itm-key = buf_temp_onewin_items.itm-key.
     1794       end.
     1795       else do:
     1796         v-onewin9-itm-key = 0.
     1797       end.
     1798       assign
     1799           v-onewin9-itm-key = v-onewin9-itm-key + 1
     1800       .
     1801       create buf_temp_onewin_items.
     1802       assign
     1803       buf_temp_onewin_items.itm-key      = v-onewin9-itm-key
     1804       buf_temp_onewin_items.itmExtKey    = p-ext-key
     1805       buf_temp_onewin_items.itmName      = p-item-name
     1806       buf_temp_onewin_items.itmDesc      = p-item-desc
     1807       buf_temp_onewin_items.itmSelected  = p-selected
     1808       .
     1809   end.
     1810   end procedure.
     1811   procedure onewin_create-selection :
     1812   define input parameter p-itm-key as integer no-undo .
     1813   define input parameter p-itmextkey as character no-undo .
     1814   define variable v-counter as integer no-undo .
     1815   define buffer buf_temp_onewin_itemsSelected for temp_onewin_itemsSelected .
     1816   do
     1817   on error undo, return error
     1818   :
     1819     find last buf_temp_onewin_itemsSelected use-index pi no-error.
     1820     if available buf_temp_onewin_itemsSelected then do:
     1821       v-counter = buf_temp_onewin_itemsSelected.its-key.
     1822     end.
     1823     find first buf_temp_onewin_itemsSelected where
     1824          buf_temp_onewin_itemsSelected.itm-key = p-itm-key no-error.
     1825     if not available buf_temp_onewin_itemsSelected then do:
     1826       create buf_temp_onewin_itemsSelected.
     1827       assign
     1828       buf_temp_onewin_itemsSelected.its-key   = v-counter + 1
     1829       v-counter = v-counter + 1
     1830       buf_temp_onewin_itemsSelected.itm-key   = p-itm-key
     1831       buf_temp_onewin_itemsSelected.itmExtKey = p-itmExtKey
     1832       .
     1833     end.
     1834   end.
     1835   end procedure.
     1836   procedure onewin_check-item :
     1837   define input parameter p-ext-key   as character        no-undo.
     1838   define output parameter p-exists as logical no-undo .
     1839   define buffer buf_temp_onewin_items for temp_onewin_items.
     1840   find first buf_temp_onewin_items where
     1841   buf_temp_onewin_items.itmExtKey    = p-ext-key no-error.
     1842   if available buf_temp_onewin_items then do:
     1843     p-exists = yes.
     1844   end.
     1845   end procedure.
     1846   define variable p-cmb-call-id as character no-undo .
     1847   define variable p-cmb-profile-id as integer no-undo .
     1848   define variable v-ii as integer no-undo .
     1849   define variable v-cur-ext-key as character no-undo .
     1850   define variable v-accepted as logical no-undo .
     1851   define variable v-index-id as integer no-undo .
     1852   define variable v-profile-id-list as character no-undo .
     1853   define variable v-call-id-list as character no-undo .
     1854   define variable v-once-more-list as character no-undo .
     1855   define buffer cmb_rule-profile for ub.rule-profile.
     1856   define buffer buf_profile-by-profile for ub.profile-by-profile.
     1857   define buffer buf2_rule-profile for ub.rule-profile.
     1858   define buffer buf_rp-by-call for ub.rp-by-call.
     1859   define buffer buf_ext-system  for ub.ext-system .
     1860   define buffer buf_temp_onewin_itemsSelected for temp_onewin_itemsSelected.
     1861   p-cmb-call-id = p-call-id.
     1862   p-cmb-profile-id = p-profile-id.
     1863   IF p-list-mode = 'rp-rule-param':U
     1864   or p-list-mode = 'rp-rule-param':U  + chr(44) + 'все':U
     1865   THEN DO:
     1866     FIND FIRST buf_rule-profile NO-LOCK WHERE
     1867               buf_rule-profile.profile_id = p-profile-id.
     1868     run gen-key-rec in this-procedure ( input 'rule-profile':U
     1869                                     ,input buffer buf_rule-profile:handle
     1870                                     ,output v-uniq-key-rec).
     1871     FIND FIRST buf_ruledict NO-LOCK WHERE
     1872               buf_ruledict.entry-type = 'rule-profile':U
     1873         AND  buf_ruledict.uniq-key-rec = v-uniq-key-rec.
     1874     v-rcps-entry-id = buf_ruledict.entry-id.
     1875   END.
     1876   RUN rcps_fill-table IN THIS-PROCEDURE ( input yes).
     1877   if p-mode = 'ДОБАВЛЕНИЕ':U then do:
     1878     for each buf_profile-by-profile no-lock where
     1879             buf_profile-by-profile.profile_id = p-cmb-profile-id,
     1880         first buf2_rule-profile no-lock where
     1881               buf2_rule-profile.profile_id = buf_profile-by-profile.child-profile_id:
     1882       assign
     1883       p-call-id = p-cmb-call-id.
     1884       entry(lookup('cmb':U, p-cmb-call-id, chr(3)), p-call-id, chr(3)) = buf2_rule-profile.profile-type.
     1885       p-profile-id = buf_profile-by-profile.child-profile_id.
     1886       assign
     1887       v-call-id-list = v-call-id-list + (if v-call-id-list = '' then '' else chr(4))  +  p-call-id
     1888       v-profile-id-list = v-profile-id-list + (if v-profile-id-list = '' then '' else chr(44)) + string(p-profile-id)
     1889       v-once-more-list = v-once-more-list + (if v-once-more-list = '' then '' else chr(44))  +  string(1)
     1890       .
     1891       RUN rcps_fill-table IN THIS-PROCEDURE ( input no).
     1892     end.
     1893   end.
     1894   else do:
     1895     do v-ii = 1 to num-entries('dis-card-type,goods,clients,gds-grp,cli-grp,chk-doc_IBS-TH,chk-doc_IBS-TH-MOB,edoc,thref,pdf,rep,ord,cmb,fdoc':U):
     1896       assign
     1897       p-call-id = p-cmb-call-id.
     1898       entry(lookup('cmb':U, p-cmb-call-id, chr(3)), p-call-id, chr(3)) = entry(v-ii, 'dis-card-type,goods,clients,gds-grp,cli-grp,chk-doc_IBS-TH,chk-doc_IBS-TH-MOB,edoc,thref,pdf,rep,ord,cmb,fdoc':U).
     1899       for each buf_rp-by-call no-lock where
     1900               buf_rp-by-call.call_id = p-call-id
     1901           and (
     1902               (buf_rp-by-call.profile_id = 60
     1903                and buf_rp-by-call.once-more = p-once-more)
     1904                or
     1905                (buf_rp-by-call.parent-profile_id = 60
     1906                 and buf_rp-by-call.parent-once-more = p-once-more)
     1907               )
     1908           :
     1909         p-profile-id = buf_rp-by-call.profile_id.
     1910         assign
     1911         v-call-id-list = v-call-id-list + (if v-call-id-list = '' then '' else chr(4))  +  p-call-id
     1912         v-profile-id-list = v-profile-id-list + (if v-profile-id-list = '' then '' else chr(44)) + string(p-profile-id)
     1913         v-once-more-list = v-once-more-list + (if v-once-more-list = '' then '' else chr(44))  +  string(buf_rp-by-call.once-more)
     1914         .
     1915         RUN rcps_fill-table IN THIS-PROCEDURE ( input no).
     1916       end.
     1917     end.
     1918   end.
     1919   for each tt-rule-call-param where
     1920           tt-rule-call-param.param-name = "p-esys-id-list"
     1921     and tt-rule-call-param.p-index > 0
     1922   break
     1923   by tt-rule-call-param.p-index:
     1924     if first-of(tt-rule-call-param.p-index) then do:
     1925       find first buf_ext-system no-lock where
     1926                 buf_ext-system.db-num = 0
     1927             and buf_ext-system.esys-id = tt-rule-call-param.param-value-integer.
     1928             run onewin_add-item in this-procedure (
     1929                   input string(buf_ext-system.esys-id)
     1930                 , input buf_ext-system.esys-name
     1931                 , ''
     1932                 , input yes
     1933             ).
     1934     END.
     1935   END.
     1936   run gbl/onewin.w (
     1937         input parparentproc
     1938       , input 1
     1939       , input "Список внешних систем типа ДКLink"
     1940       , input "":U
     1941       , input "&Тест"
     1942       , input table temp_onewin_items
     1943       , output table temp_onewin_itemsSelected
     1944       , output v-cur-ext-key
     1945       , output v-accepted
     1946   ).
     1947   IF v-accepted THEN DO:
     1948     FOR EACH buf_temp_onewin_itemsSelected:
     1949       FIND FIRST buf_ext-system NO-LOCK WHERE
     1950                 buf_ext-system.esys-id = integer(buf_temp_onewin_itemsSelected.itmextkey)
     1951           AND buf_ext-system.db-num = 0
     1952           NO-ERROR.
     1953       IF AVAILABLE buf_ext-system THEN DO:
     1954         v-index-id = v-index-id + 1.
     1955         do v-ii =1 to num-entries(v-call-id-list, chr(4) ):
     1956           RUN rcps_set-value IN this-procedure  (
     1957                                            input integer(entry(v-ii, v-profile-id-list))
     1958                                           ,input integer(entry(v-ii, v-once-more-list))
     1959                                           ,input entry(v-ii, v-call-id-list, chr(4) )
     1960                                           ,input "p-esys-id-list"
     1961                                           ,INPUT v-index-id
     1962                                           ,input ''
     1963                                           ,input ?
     1964                                           ,input 0.0
     1965                                           ,input buf_ext-system.esys-id
     1966                                           ,input no
     1967                                           ) no-error .
     1968           if error-status:error then do:
     1969             message
     1970             error-status:get-message(1) return-value
     1971             view-as alert-box .
     1972             undo, return error .
     1973           end.
     1974         end.
     1975       END.
     1976     END.
     1977     for each tt-rule-call-param where
     1978             tt-rule-call-param.param-name = "p-esys-id-list"
     1979       and tt-rule-call-param.p-index > v-index-id
     1980     break
     1981     by tt-rule-call-param.p-index:
     1982       run rcps_proc-b-del in this-procedure (
     1983                                                input tt-rule-call-param.profile_id
     1984                                               ,input tt-rule-call-param.once-more
     1985                                               ,input tt-rule-call-param.call_id
     1986                                               ,input "p-esys-id-list"
     1987                                               ,input tt-rule-call-param.p-index
     1988                                               ).
     1989     END.
     1990   end.
     1991   do v-ii = 1 to num-entries(v-call-id-list, chr(4) ):
     1992     assign
     1993     p-call-id = entry(v-ii, v-call-id-list, chr(4) )
     1994     p-profile-id = integer(entry(v-ii, v-profile-id-list, chr(44) ))
     1995     p-once-more = integer(entry(v-ii, v-once-more-list, chr(44) ))
     1996     .
     1997   run rcps_proc-save0 in this-procedure .
     1998   end.
     1999   PROCEDURE onewin_custom-add-item :
     2000   DEFINE INPUT PARAMETER p-onewin-handle AS HANDLE NO-UNDO.
     2001   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     2002   define variable v-uniq-key-rec as character no-undo .
     2003   define variable v-ok as logical no-undo .
     2004   define variable v-tbl-row as rowid no-undo .
     2005   define variable v-tbl-name as character no-undo .
     2006   define variable v-exists as logical no-undo .
     2007   define buffer buf_ext-system for ub.ext-system.
     2008   define buffer buf_temp_onewin_items for temp_onewin_items.
     2009   run bge/oxmlexts.p (
     2010         input parparentproc
     2011       , input 1
     2012       , input substitute("esys-type = &1", '7':U)
     2013       , input v-uniq-key-rec
     2014       , output v-rid-list
     2015       , output v-ok
     2016   ).
     2017   if v-ok then do:
     2018     do v-ii = 1 to num-entries(v-rid-list):
     2019       run gen-row-keyr in this-procedure
     2020         ( input entry(v-ii, v-rid-list)
     2021           ,input ?
     2022           ,input "ub"
     2023           ,input ?
     2024           ,input no-lock
     2025           ,output v-tbl-row
     2026           ,output v-tbl-name
     2027         ).
     2028       find first buf_ext-system no-lock where
     2029                 rowid(buf_ext-system) = v-tbl-row.
     2030       if not (buf_ext-system.esys-type = integer('7':U)) then do:
     2031         message
     2032         "Нужно выбрать ВНЕШНЮЮ СИСТЕМУ типа ДатаКрат DKLink"
     2033         view-as alert-box error .
     2034         undo, return error.
     2035       end.
     2036       find first buf_temp_onewin_items where
     2037               buf_temp_onewin_items.itmextkey = string(buf_ext-system.esys-id) no-error.
     2038       if not available temp_onewin_items then do:
     2039         run onewin_check-item in p-onewin-handle (
     2040                                                     input string(buf_ext-system.esys-id)
     2041                                                   ,output v-exists) no-error.
     2042         if v-exists then do:
     2043           message
     2044           substitute("Вы уже выбрали ВС &1!", buf_ext-system.esys-id)
     2045           view-as alert-box warning.
     2046           return.
     2047         end.
     2048         run onewin_add-item in p-onewin-handle (
     2049               input string(buf_ext-system.esys-id)
     2050             , input buf_ext-system.esys-name
     2051             , ''
     2052             , input yes
     2053         ).
     2054       end.
     2055       else do:
     2056         message
     2057         substitute("Вы уже выбрали ВС &1!", buf_ext-system.esys-id)
     2058         view-as alert-box warning.
     2059         return.
     2060       end.
     2061     end.
     2062   end.
     2063   END PROCEDURE.
     2064   PROCEDURE onewin_get-bttns :
     2065   DEFINE OUTPUT PARAMETER p-bttns as character no-undo .
     2066   if p-mode = 'ПРОСМОТР':U then do:
     2067     if  lookup("b-chg", bttns) = 0
     2068   and lookup("running", bttns) = 0
     2069   then do:
     2070     p-bttns = "".
     2071   end.
     2072   else do:
     2073     p-bttns = "b-del,b-exit".
     2074   end.
     2075   end.
     2076   else do:
     2077     p-bttns = "b-add,b-del,b-exit".
     2078   end.
     2079   END PROCEDURE.
