     2194                                       else (if g#esys
     2195                                             then (chr(4) +  'ВС':U)
     2196                                             else g#userid)
     2197                                       )       .
     2198     assign
     2199     cr-edist_full-mess = cr-edist_full-mess +
     2200                           (if cr-edist_full-mess = ''
     2201                           then ''
     2202                           else (chr(13) + chr(10))) +
     2203                           (if num-entries(p-doc-code, chr(4)) > 1
     2204                           then substitute("Товар с кодом &1: ", entry(2, p-doc-code, chr(4)))
     2205                           else '') +
     2206                           cr-edist_get-mess-mean (p-des)
     2207     .
     2208   end.
     2209   end procedure.
     2210   procedure update-edi-state-lighttt :
     2211   define input  parameter p-tbl-name   as character no-undo .
     2212   define input  parameter p-doc-code   as character no-undo .
     2213   define input  parameter p-date-status as date no-undo .
     2214   define input  parameter p-time-status as integer no-undo .
