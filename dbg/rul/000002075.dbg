     3394   procedure set-error :
     3395   define input parameter p-mess as character no-undo .
     3396     do
     3397     on error undo, return error
     3398     :
     3399        assign
     3400        v-last-error-message = p-mess.
     3401     end.
     3402   end procedure.
     3403   define buffer buf_temp-cmd for temp-cmd.
     3404   define temp-table temp-rule-call-param no-undo like ub.rule-call-param.
     3405   define buffer buf_temp-rule-call-param for temp-rule-call-param.
     3406   define buffer buf_temp-xml-tables for temp-xml-tables.
     3407   define variable log-file-name                as character      no-undo init "process-edoc.txt".
     3408   define variable v-view-log                   as logical        no-undo .
     3409   define variable v-stop                       as logical        no-undo .
     3410   function 00180004_get-error-message returns character :
     3411   define variable v-ii as integer no-undo .
     3412   define variable v-mess as character no-undo .
     3413   DO v-ii = 1 TO ERROR-STATUS:NUM-MESSAGES:
     3414       v-mess = substitute("&1&2ош &3"
     3415                           ,v-mess
     3416                           ,chr(10)
     3417                           ,ERROR-STATUS:GET-MESSAGE(v-ii)).
     3418   END.
     3419   end function.
     3420     define variable p-xsd-file as character no-undo.
     3421   on delete of this-procedure do:
     3422     run delete-procedure in this-procedure .
     3423   end.
     3424   run load-ruleset-context in this-procedure ( input p-ruleset-id) no-error .
     3425   if error-status:error
     3426   or return-value = "return" then return.
     3427   if not this-procedure:persistent then do:
     3428     run proc-main in this-procedure  no-error .
     3429     if error-status:error then do:
     3430         v-esm = error-status :get-message (1).
     3431         v-es = error-status:error .
     3432         v-rv = return-value .
     3433         run delete-procedure in this-procedure .
     3434               run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute( "&1. &2&3&4", vss-workfile, v-rv, chr(10), v-esm)).                      assign v-view-log = yes.
     3435         undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     3436     end.
     3437     run delete-procedure in this-procedure .
     3438   end.
     3439   procedure proc-main :
     3440   define variable v-ii as integer   no-undo .
     3441   define variable v-mess as character no-undo .
     3442   define variable v-trn-code as character no-undo .
     3443   define variable v-dump-ord-int64 as int64 no-undo .
     3444   define variable v-cli-out-doc as character no-undo .
     3445   define variable v-new-ps as character no-undo .
     3446   define variable v-ord-int1 as integer no-undo .
     3447   define variable v-ps as character no-undo .
     3448   define variable v-new-st as integer no-undo .
     3449   define variable v-ship-date as date no-undo .
     3450   define variable v-edist-mess as character no-undo .
     3451   define variable v-cli-type as character no-undo .
     3452   define variable v-cli-code as integer no-undo .
     3453   define variable v-date-status as date no-undo .
     3454   define variable v-time-status as integer no-undo .
     3455   define buffer buf_ord-doc for ub.ord-doc.
     3456   define buffer buf_edi-status for ub.edi-status.
     3457   define buffer buf_esys-route for ub.esys-route.
     3458   define variable v-crc-pack as character no-undo .
     3459   _ordrsp:
     3460   do transaction
     3461   on error  undo _ordrsp, retry _ordrsp
     3462   on stop   undo _ordrsp, retry _ordrsp
     3463   on endkey undo _ordrsp, retry _ordrsp
     3464   :
     3465     if retry then do:
     3466           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при импорте подтверждений заказа &1 из ВС &2&3&4"                                 ,v-current-doc-code                                 , v-esys-id                                  , chr(10)                                 , v-mess)).                      assign v-view-log = yes.
     3467       assign
     3468       v-view-log = yes.
     3469       run delete-ord-list in this-procedure ( input v-cli-out-doc
     3470                                               ).
     3471       undo _ordrsp, return error substitute("Ошибка при импорте подтверждений заказа &1 из ВС &2&3&4"                                 ,v-current-doc-code                                 , v-esys-id                                  , chr(10)                                 , v-mess).
     3472     end.
     3473     else do:
     3474       find first ordrsp-t.
     3475       run write-log  in p-log-handle (
     3476                                       input 0
     3477                                     , "&DLine").
     3478             run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute(".............Импорт подтверждений заказа из ВС")).                      assign v-view-log = yes.
     3479       num-rec = num-rec + 1.
     3480       find first buf_ord-doc exclusive-lock where
     3481                 buf_ord-doc.doc-code = ordrsp-t.ordernumber no-error.
     3482       if not available buf_ord-doc then do:
     3483         v-mess =  substitute("Не найден заказ поставщику с номером &1", ordrsp-t.ordernumber).
     3484         undo _ordrsp, retry _ordrsp.
     3485       end.
     3486       if buf_ord-doc.ord-int2 = integer('1':U) then do:
     3487         _edis:
     3488         for each buf_edi-status no-lock where
     3489                 buf_edi-status.tbl-name = 'ord-doc':U
     3490             and buf_edi-status.doc-code = ordrsp-t.ordernumber
     3491         by buf_edi-status.tbl-name
     3492         by buf_edi-status.doc-code
     3493         by buf_edi-status.date-status
     3494         by buf_edi-status.time-status
     3495         :
     3496           if buf_edi-status.state = '4':U
     3497           or buf_edi-status.state = '5':U
     3498           then do:
     3499             v-dump-ord-int64 = int64(cr-edist_get-mess-key-value(buf_edi-status.mess-id, 'route':U)).
     3500             find first buf_esys-route no-lock where
     3501                 buf_esys-route.esr-dump-ord   = v-dump-ord-int64
     3502             and buf_esys-route.esys-id   = v-esys-id
     3503             and buf_esys-route.db-num   = 0  no-error.
     3504             if available buf_esys-route then do:
     3505               v-edist-mess = ''.
     3506               v-edist-mess = cr-edist_add-edist-mess( v-edist-mess, 'pack-num':U, string(buf_esys-route.esr-last-pack) + "->").
     3507               run update-edi-state-light in this-procedure ( input buf_edi-status.tbl-name
     3508                                                             ,input buf_edi-status.doc-code
     3509                                                             ,input buf_edi-status.date-status
     3510                                                             ,input buf_edi-status.time-status
     3511                                                             ,input buf_edi-status.state
     3512                                                             ,input buf_edi-status.err-code
     3513                                                             ,input buf_edi-status.des-err
     3514                                                             ,input v-edist-mess
     3515                                                             )
     3516                                                             .
     3517               DEFINE VARIABLE v-today as date no-undo .
     3518               DEFINE VARIABLE v-time as integer no-undo .
     3519               run cur-time in this-procedure ( output v-today, output v-time).
     3520               run get-xcnf_create-temp-esys-pck-rcvd in p-cont-handle (
     3521                                                                         input v-esys-id
     3522                                                                       ,input buf_esys-route.esr-last-pack
     3523                                                                       ,input v-crc-pack
     3524                                                                       ,input yes
     3525                                                                       ,input 1
     3526                                                                       ,input 1
     3527                                                                       ,input v-today
     3528                                                                       ,input v-time
     3529                                                                       ,input string(v-time, "HH:MM:SS")
     3530                                                                       ) .
     3531               leave _edis.
     3532             end.
     3533           end.
     3534         end.
     3535       end.
     3536       assign
     3537       v-current-doc-code = buf_ord-doc.doc-code
     3538       v-cli-type = buf_ord-doc.cli-type
     3539       v-cli-code = buf_ord-doc.cli-code
     3540       .
     3541       assign
     3542       glog = status-is-edi ( input yes
     3543                           , input buf_ord-doc.cli-type
     3544                           , input buf_ord-doc.cli-code
     3545                           , input buf_ord-doc.obj-type
     3546                           , input buf_ord-doc.obj-code
     3547                           , output v-dm-edi
     3548                           ) no-error.
     3549       if not glog = yes then do:
     3550         v-mess = substitute("Нет обмена Документами по EXITE-EDI для поставщика &1&2 и &3&4 в БД &5)"
     3551                             , buf_ord-doc.cli-type
     3552                             , buf_ord-doc.cli-code
     3553                             , buf_ord-doc.obj-type
     3554                             , buf_ord-doc.obj-code
     3555                             , g#db-num).
     3556         undo _ordrsp, retry _ordrsp.
     3557       end.
     3558       assign
     3559       v-ps = ""
     3560       v-ord-int1 = (if ordrsp-t.action = 29
     3561                             then integer('6':U)
     3562                             else (if ordrsp-t.action = 27
     3563                                   then integer('99':U)
     3564                                   else integer('3':U)
     3565                                   )
     3566                             )
     3567       v-cli-out-doc = ordrsp-t.number + chr(4) + iso-date(ordrsp-t.date) + chr(4) + ordrsp-t.time_
     3568       v-ship-date = (if ordrsp-t.deliverydate = ?
     3569                             then ord-list.ship-date
     3570                             else ordrsp-t.deliverydate)
     3571       .
     3572           find first head-t where
     3573                 head-t.number = ordrsp-t.number no-error.
     3574       v-ediinterchangeid = (if available head-t then head-t.EDIINTERCHANGEID else '').
     3575       run edocsord_edi-import in this-procedure (
     3576                                               buffer buf_ord-doc
     3577                                             ,input v-cli-out-doc
     3578                                             ,input ''
     3579                                             ,input v-ord-int1
     3580                                             ,input v-ship-date
     3581                                             ,input v-ps
     3582                                             ,input v-pack-num-chr
     3583                                             ,input v-ediinterchangeid
     3584                                             ,output v-new-ps
     3585                                             ,output v-new-st
     3586                                             ) no-error.
     3587       if error-status:error then do:
     3588         if return-value <> '' then do:
     3589           v-mess = substitute("Ошибка при изменении статуса заказа при приеме данных:&1&2", chr(10), return-value ).
     3590           undo _ordrsp, retry _ordrsp.
     3591         end.
     3592       end.
     3593       else do:
     3594         if v-new-st = ? then do:
     3595           define variable v-tmp-file as character no-undo .
     3596           run gbl/_tmpfile.p ( input "mes":U  , input ".txt":U, output v-tmp-file ).
     3597           COPY-LOB  FROM OBJECT cr-edist_full-mess
     3598           TO FILE v-tmp-file NO-ERROR.
     3599           cr-edist_full-mess = ''.
     3600           run send-msg-to-email in parparentproc
     3601               ( input substitute( "ТН БД &1. Ошибка EDI при импорте пакета &2 из ВС &3"
     3602                                   , g#db-num
     3603                                   , v-pack-num-chr
     3604                                   , v-esys-id )
     3605               ,input substitute("Пакет принят без сохранения данных в БД. См. EDI-информацию по заказу &1&2"
     3606                                 , buf_ord-doc.doc-code
     3607                                 , chr(10)
     3608                                 )
     3609               ,input v-tmp-file
     3610               ) no-error .
     3611           os-delete value(v-tmp-file).
     3612         end.
     3613         find first head-t where
     3614                 head-t.number = ordrsp-t.number no-error.
     3615         v-edist-mess = ''.
     3616         v-edist-mess = cr-edist_add-edist-mess( v-edist-mess, 'pack-num':U, "->" + v-pack-num-chr ).
     3617         v-edist-mess = cr-edist_add-edist-mess( v-edist-mess, 'ediiterchangeid':U, head-t.ediinterchangeid ).
     3618         v-date-status = ?.
     3619         run create-edi-state in this-procedure (
     3620                                                 input 'ord-doc':U
     3621                                               , input buf_ord-doc.doc-code
     3622                                               , input buf_ord-doc.cli-type
     3623                                               , input buf_ord-doc.cli-code
     3624                                               , input 'ИЗМЕНЕНИЕ':U
     3625                                               , input (if v-new-st = ? then -1 else buf_ord-doc.ord-int1)
     3626                                               , input (if v-new-st = ?
     3627                                                       then  integer('4':U)
     3628                                                       else integer('0':U))
     3629                                               , input buf_ord-doc.PS
     3630                                               , input v-edist-mess
     3631                                               , input integer('2':U)
     3632                                               , input-output v-date-status
     3633                                               , input-output v-time-status
     3634                                               ).
     3635         _edist:
     3636         for each temp-edi-status
     3637         on error  undo _edist, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3638         on stop   undo _edist, return error substitute( "&1. stop", vss-workfile )
     3639         on endkey undo _edist, return error substitute( "&1. endkey", vss-workfile )
     3640         :
     3641           v-edist-mess = temp-edi-status.mess.
     3642           v-edist-mess = cr-edist_add-edist-mess( v-edist-mess, 'pack-num':U, "->" + v-pack-num-chr ).
     3643           run create-edi-state in this-procedure (
     3644                                                   input temp-edi-status.tbl-name
     3645                                                 , input temp-edi-status.doc-code
     3646                                                 , input temp-edi-status.cli-type
     3647                                                 , input temp-edi-status.cli-code
     3648                                                 , input temp-edi-status.act
     3649                                                 , input (if v-new-st = ? then -1 else buf_ord-doc.ord-int1)
     3650                                                 , input temp-edi-status.err-code
     3651                                                 , input temp-edi-status.des-err
     3652                                                 , input v-edist-mess
     3653                                                 , input integer('2':U)
     3654                                                 , input-output v-date-status
     3655                                                 , input-output v-time-status
     3656                                                 ).
     3657         end.
     3658         if v-new-st <> ? then do:
     3659           run cur-time in this-procedure ( output v-today, output v-time).
     3660           run get-xcnf_create-temp-esys-pck-sent in p-cont-handle (
     3661                                                                     input v-esys-id
     3662                                                                   ,input integer(v-pack-num-chr)
     3663                                                                   ,input v-crc-pack
     3664                                                                   ,input yes
     3665                                                                   ,input 1
     3666                                                                   ,input 1
     3667                                                                   ,input v-today
     3668                                                                   ,input v-time
     3669                                                                   ,input string(v-time, "HH:MM:SS")
     3670                                                                   ) .
     3671           num-rec-ok = num-rec-ok + 1.
     3672         end.
     3673       end.
     3674     end.
     3675     run write-counter in p-log-handle ( input substitute("Прочитано записей: &1, из них удачно: &2", num-rec, num-rec-ok)).
     3676   end.
     3677   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Прочитано записей: &1, из них удачно обработано: &2", num-rec, num-rec-ok)).                      assign v-view-log = yes.
     3678   end procedure.
     3679   procedure load-ruleset-context :
     3680   define input parameter p-ruleset-id as integer no-undo .
     3681   define variable glog as logical no-undo .
     3682   define buffer buf_rule-call-param for ub.rule-call-param.
     3683   define buffer buf_esys-pck-keys for ub.esys-pck-keys.
     3684   define buffer buf_ext-system for ub.ext-system.
     3685     do
     3686     on error undo, return error
     3687     :
     3688    find first buf_rule-call-param no-lock where
     3689   buf_rule-call-param.codex_id = p-codex-id
     3690   and buf_rule-call-param.ruleset_id = p-ruleset-id
     3691   and buf_rule-call-param.call_id = p-call-id
     3692   and buf_rule-call-param.order_id = p-order-id
     3693   and buf_rule-call-param.rule_id = p-rule-id
     3694   and buf_rule-call-param.param-name = "p-xsd-file"
     3695    no-error.
     3696   if available buf_rule-call-param then do:
     3697   assign p-xsd-file = buf_rule-call-param.param-value-character.
     3698   end.
     3699       case p-ruleset-id:
     3700         when 4 then do:
     3701           assign
     3702           v-sign = 1
     3703           v-current-host-code = p-host-code
     3704           v-current-obj-type = p-obj-type
     3705           v-current-obj-code = p-obj-code
     3706           v-current-doc-code = p-doc-code
     3707           v-current-db-num = g#db-num
     3708           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     3709           file-name  = entry(1, p-process-file-name, chr(4))
     3710           v_dataseth = handle(entry(2, p-process-file-name, chr(4)))
     3711           v-xmlh = buffer buf_temp-xml-tables:handle
     3712           v-esys-id = integer(p-doc-code)
     3713           v-pack-num-chr = entry(3, p-process-file-name, chr(4))
     3714           no-error
     3715          .
     3716           find first buf_ext-system no-lock where
     3717                     buf_ext-system.esys-id = v-esys-id
     3718                 and buf_ext-system.db-num = 0 no-error .
     3719           if not available buf_ext-system
     3720           or buf_ext-system.esys-type <> integer('9':U)
     3721           then do:
     3722                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не найдена ВС &1&2пропускаем ..."                                         , v-esys-id                                         , chr(10)                                         )).                      assign v-view-log = yes.
     3723             undo, return error substitute("Не найдена ВС &1&2пропускаем ..."                                         , v-esys-id                                         , chr(10)                                         ).
     3724           end.
     3725           glog = dataset ordrsp_-t:handle:copy-dataset(v_dataseth
     3726                                              , no
     3727                                              , yes
     3728                                              , no
     3729                                              , ""
     3730                                              , no
     3731                                              ) no-error.
     3732           if error-status:error
     3733           or not glog then do:
     3734                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка копирования импортируемых данных для дальнейшей обработки&1&2"                                         , chr(10)                                         , error-status:get-message(1)                                         )).                      assign v-view-log = yes.
     3735             undo, return error substitute("Ошибка копирования импортируемых данных для дальнейшей обработки&1&2"                                         , chr(10)                                         , error-status:get-message(1)                                         ).
     3736           end.
     3737         end.
     3738         otherwise do:
     3739           undo, return error "Неправильный вызов".
     3740         end.
     3741       end case.
     3742     end.
     3743   end procedure.
     3744   procedure delete-procedure :
     3745     do
     3746     on error undo, return error
     3747     :
     3748         run garbcoll_clear in this-procedure .
     3749     end.
     3750   end procedure.
     3751   procedure delete-ord-list :
     3752   define input parameter p-cli-out-doc as character no-undo .
     3753   define buffer buf_ord-list for ord-list.
     3754   for each position-t where
     3755           position-t.number = p-cli-out-doc:
     3756     delete position-t.
     3757   end.
     3758   find first buf_ord-list where
     3759             buf_ord-list.doc-code = p-doc-code
     3760         and buf_ord-list.trn-doc = ''
     3761            no-error .
     3762   if available buf_ord-list then delete buf_ord-list.
     3763   end procedure.
