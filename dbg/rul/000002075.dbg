     1132   procedure get-gate-file-name :
     1133   define input parameter p-gate-rec as character no-undo .
     1134   define output  parameter p-gate-file-name as character no-undo .
     1135   define buffer buf_clob-data for ub.clob-data.
     1136   define variable v-tbl-row as rowid no-undo .
     1137   define variable v-tbl-name as character no-undo .
     1138   run gen-row-keyr in this-procedure ( input p-gate-rec
     1139                                       ,input ?
     1140                                       ,input "ub"
     1141                                       ,input ?
     1142                                       ,input no-lock
     1143                                       ,output v-tbl-row
     1144                                       ,output v-tbl-name) no-error.
     1145   if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     1146                                                           ,vss-include-info10
     1147                                                           ,p-gate-rec).
     1148   find first buf_clob-data no-lock where
     1149             rowid(buf_clob-data) = v-tbl-row no-error.
     1150   if not available buf_clob-data then do:
     1151     if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     1152                                                             ,vss-include-info10
     1153                                                             ,p-gate-rec).
     1154   end.
     1155   p-gate-file-name = buf_clob-data.file-name.
     1156   end procedure.
     1157   procedure get-gate-rec :
     1158   define input  parameter p-gate-name as character no-undo .
     1159   define output parameter p-gate-rec as character no-undo .
     1160   define buffer buf_clob-bind for ub.clob-bind.
     1161   define buffer buf_clob-data for ub.clob-data.
     1162   main-block:
     1163   do
     1164   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info10, return-value, chr(10), error-status :get-message (1))
     1165   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info10 )
     1166   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info10 )
     1167   :
     1168       find first buf_clob-bind no-lock where
     1169                 buf_clob-bind.uniq-key-rec = p-gate-name
     1170             and buf_clob-bind.field-name = '':U
     1171             and buf_clob-bind.part-num = 1
     1172             and buf_clob-bind.resource-type = 'gate':U
     1173             no-error.
     1174       if not available buf_clob-bind then do:
     1175         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     1176                                         , p-gate-name
     1177                                         ).
     1178       end.
     1179       find first buf_clob-data no-lock where
     1180                 buf_clob-data.db-num = buf_clob-bind.db-num
     1181             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     1182       if not available buf_clob-data then do:
     1183         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1184                                         , buf_clob-bind.db-num
     1185                                         , buf_clob-bind.int64-id
     1186                                         , p-gate-name
     1187                                         ).
     1188       end.
     1189       run gen-key-rec in this-procedure ( input 'clob-data':U
     1190                                 ,input buffer buf_clob-data:handle
     1191                                 ,output p-gate-rec).
     1192   end.
     1193   end procedure.
     1194   procedure get-gate-by-name :
     1195   define input  parameter p-gate-name as character no-undo .
     1196   define output parameter p-gate-rec as character no-undo .
     1197   define output parameter p-dsh as handle no-undo .
     1198   define input-output  parameter p-xmlh as handle no-undo .
     1199   define variable v-ii as integer   no-undo .
     1200   define variable glog as logical   no-undo .
     1201   define variable v-longchar as longchar no-undo .
     1202   define variable v-txmlh as handle no-undo .
     1203   define variable v-db-num as integer no-undo .
     1204   define variable v-int64-id as int64 no-undo .
     1205   define buffer buf_clob-bind for ub.clob-bind.
     1206   define buffer buf_clob-data for ub.clob-data.
     1207   main-block:
     1208   do
     1209   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info10, return-value, chr(10), error-status :get-message (1))
     1210   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info10 )
     1211   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info10 )
     1212   :
     1213       find first buf_clob-bind no-lock where
     1214                 buf_clob-bind.uniq-key-rec = p-gate-name
     1215             and buf_clob-bind.field-name = '':U
     1216             and buf_clob-bind.part-num = 1
     1217             and buf_clob-bind.resource-type = 'gate':U
     1218             no-error.
     1219       if not available buf_clob-bind then do:
     1220         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     1221                                         , p-gate-name
     1222                                         ).
     1223       end.
     1224       find first buf_clob-data no-lock where
     1225                 buf_clob-data.db-num = buf_clob-bind.db-num
     1226             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     1227       if not available buf_clob-data then do:
     1228         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1229                                         , buf_clob-bind.db-num
     1230                                         , buf_clob-bind.int64-id
     1231                                         , p-gate-name
     1232                                         ).
     1233       end.
     1234       assign
     1235       v-longchar = buf_clob-data.cdata
     1236       .
     1237       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1238       if error-status :error then do:
     1239         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1240       end.
     1241       create dataset p-dsh .
     1242       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1243                                     , v-longchar
     1244                                     , ?
     1245                                     , ?
     1246                                     , ?
     1247                                     ) no-error.
     1248       v-longchar = '':U.
     1249       if error-status :error
     1250       or not glog
     1251       then do:
     1252         undo, return error substitute("Не удалось прочитать XML-схему &1 из БД:&2&3", p-gate-name, chr(10), error-status:get-message(1) ).
     1253       end.
     1254       if not valid-handle(p-xmlh)
     1255       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1256         create temp-table v-txmlh.
     1257         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1258         v-txmlh:temp-table-prepare("temp-xml-tables").
     1259         p-xmlh = v-txmlh:default-buffer-handle.
     1260       end.
     1261       run gen-key-rec in this-procedure ( input 'clob-data':U
     1262                                 ,input buffer buf_clob-data:handle
     1263                                 ,output p-gate-rec).
     1264       do v-ii = 1 to p-dsh:num-buffers:
     1265         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1266         if not p-xmlh:available then do:
     1267           p-xmlh:buffer-create().
     1268           assign
     1269           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1270           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1271           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1272           p-xmlh::gate-handle_ = p-dsh
     1273           p-xmlh::uniq-gate-rec = p-gate-rec
     1274           p-xmlh::gate-name = p-dsh:name
     1275           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1276           .
     1277           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1278             assign
     1279             p-xmlh::order = -3.
     1280           end.
     1281         end.
     1282       end.
     1283   end.
     1284   end procedure.
     1285   procedure get-gate-by-rec :
     1286   define input  parameter p-gate-rec as character no-undo .
     1287   define output parameter p-dsh as handle no-undo .
     1288   define input-output  parameter p-xmlh as handle no-undo .
     1289   define input-output parameter p-longchar  as longchar no-undo .
     1290   define variable v-ii as integer   no-undo .
     1291   define variable glog as logical   no-undo .
     1292   define variable v-rowid as rowid no-undo .
     1293   define variable v-tbl-name as character no-undo .
     1294   define variable v-longchar as longchar no-undo .
     1295   define variable v-txmlh as handle no-undo .
     1296   define buffer buf_clob-data for ub.clob-data.
     1297   main-block:
     1298   do
     1299   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info10, return-value, chr(10), error-status :get-message (1))
     1300   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info10 )
     1301   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info10 )
     1302   :
     1303     run gen-row-keyr in this-procedure (
     1304                                           input  p-gate-rec
     1305                                           ,input  ?
     1306                                           ,input  "ub"
     1307                                           ,input  ?
     1308                                           ,input  NO-LOCK
     1309                                           ,output v-rowid
     1310                                           ,output v-tbl-name   ) no-error.
     1311       find first buf_clob-data no-lock where
     1312                 rowid(buf_clob-data) = v-rowid  no-error.
     1313       if not available buf_clob-data then do:
     1314         undo, return error substitute("Не найден CLOB  &1"
     1315                                         , p-gate-rec
     1316                                         ).
     1317       end.
     1318       assign
     1319       v-longchar = buf_clob-data.cdata
     1320       .
     1321       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1322       if error-status :error then do:
     1323         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1324       end.
     1325       create dataset p-dsh .
     1326       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1327                                     , v-longchar
     1328                                     , ?
     1329                                     , ?
     1330                                     , ?
     1331                                     ) no-error.
     1332       define variable v-esm as character no-undo .
     1333       v-esm = error-status:get-message(1) .
     1334       if p-longchar <> ? then do:
     1335         p-longchar = v-longchar.
     1336       end.
     1337       v-longchar = '':U.
     1338       if error-status :error
     1339       or not glog
     1340       then do:
     1341         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     1342                                      , p-gate-rec
     1343                                      , p-gate-rec
     1344                                      , v-esm
     1345                                      ).
     1346       end.
     1347       p-dsh:private-data = buf_clob-data.file-name_ + chr(4) + p-gate-rec.
     1348       if not valid-handle(p-xmlh)
     1349       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1350         create temp-table v-txmlh.
     1351         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1352         v-txmlh:temp-table-prepare("temp-xml-tables").
     1353         p-xmlh = v-txmlh:default-buffer-handle.
     1354       end.
     1355       do v-ii = 1 to p-dsh:num-buffers:
     1356         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1357         if not p-xmlh:available then do:
     1358           p-xmlh:buffer-create().
     1359           assign
     1360           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1361           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1362           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1363           p-xmlh::gate-handle_ = p-dsh
     1364           p-xmlh::uniq-gate-rec = p-gate-rec
     1365           p-xmlh::gate-name = p-dsh:name
     1366           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1367           .
     1368           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1369             assign
     1370             p-xmlh::order = -3.
     1371           end.
     1372           p-xmlh:buffer-release().
     1373         end.
     1374       end.
     1375   end.
     1376   end procedure.
     1377   procedure get-gate-by-file :
     1378   define input  parameter p-schema-file-name as character no-undo .
     1379   define input  parameter p-gate-rec as character no-undo .
     1380   define output parameter p-dsh as handle no-undo .
     1381   define input-output  parameter p-xmlh as handle no-undo .
     1382   define variable v-ii as integer   no-undo .
     1383   define variable glog as logical   no-undo .
     1384   define variable v-rowid as rowid no-undo .
     1385   define variable v-tbl-name as character no-undo .
     1386   define variable v-longchar as longchar no-undo .
     1387   define variable v-txmlh as handle no-undo .
     1388   main-block:
     1389   do
     1390   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info10, return-value, chr(10), error-status :get-message (1))
     1391   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info10 )
     1392   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info10 )
     1393   :
     1394       COPY-LOB
     1395       FROM  FILE p-schema-file-name
     1396       TO  OBJECT v-longchar
     1397       no-convert
     1398       NO-ERROR .
     1399       if error-status :error then do:
     1400           undo, return error substitute("Не удалось считать файл схемы &1 в память&2&3"
     1401                                     , p-schema-file-name
     1402                                 , chr(10)
     1403                                 , error-status:get-message(1) ).
     1404       end.
     1405       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1406       if error-status :error then do:
     1407         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, p-schema-file-name, chr(10), error-status:get-message(1) , return-value ).
     1408       end.
     1409       create dataset p-dsh .
     1410       glog = p-dsh:READ-XMLSCHEMA( "longchar"
     1411                                     , v-longchar
     1412                                     , ?
     1413                                     , ?
     1414                                     , ?
     1415                                     ) no-error.
     1416       v-longchar = ''.
     1417       if error-status :error
     1418       or not glog
     1419       then do:
     1420         undo, return error substitute("Не удалось прочитать XML-схему из файла &1&2&3"
     1421                                      , p-schema-file-name
     1422                                      ,chr(10)
     1423                                      , error-status:get-message(1)
     1424                                      ).
     1425       end.
     1426       if not valid-handle(p-xmlh)
     1427       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1428         create temp-table v-txmlh.
     1429         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1430         v-txmlh:temp-table-prepare("temp-xml-tables").
     1431         p-xmlh = v-txmlh:default-buffer-handle.
     1432       end.
     1433       do v-ii = 1 to p-dsh:num-buffers:
     1434         p-xmlh:find-first(substitute(' where tbl-name = "&1" and  uniq-gate-rec = "&2" '
     1435                                      ,p-dsh:get-buffer-handle(v-ii):name
     1436                                      ,p-gate-rec
     1437                                      )) no-error.
     1438         if not p-xmlh:available then do:
     1439           p-xmlh:buffer-create().
     1440           assign
     1441           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):table
     1442           p-xmlh::uniq-gate-rec = p-gate-rec
     1443           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1444           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1445           p-xmlh::gate-handle_ = p-dsh
     1446           p-xmlh::gate-name = p-dsh:name
     1447           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1448           .
     1449           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1450             assign
     1451             p-xmlh::order = -3.
     1452           end.
     1453           p-xmlh:buffer-release().
     1454         end.
     1455       end.
     1456   end.
     1457   end procedure.
     1458   procedure gate-clear :
     1459   define input  parameter p-dsh as handle no-undo .
     1460   define input  parameter p-xmlh as handle no-undo .
     1461   define variable v-dsh as handle no-undo .
     1462   define variable v-th as handle no-undo .
     1463     do
     1464     on error undo, return error return-value
     1465     :
     1466       if valid-handle(p-dsh) then do:
     1467         delete object p-dsh.
     1468         v-dsh = p-dsh.
     1469         p-dsh = ?.
     1470       end.
     1471       repeat while true:
     1472         p-xmlh:find-first( substitute( " where gate-handle_ = &1 ", v-dsh)
     1473                            , share-lock) no-error.
     1474         if p-xmlh:available then do:
     1475           assign
     1476           v-th = p-xmlh:buffer-field("table-handle_"):buffer-value.
     1477           if valid-handle(p-xmlh:buffer-field("table-handle_"))
     1478           and valid-handle(v-th)
     1479           and v-th:dynamic = yes
     1480           then do:
     1481             delete object p-xmlh:buffer-field("table-handle_"):buffer-value.
     1482             p-xmlh:buffer-field("table-handle_"):buffer-value = ?.
     1483           end.
     1484           p-xmlh:buffer-delete().
     1485         end.
     1486         else do:
     1487           leave.
     1488         end.
     1489       end.
     1490       if p-xmlh:dynamic = yes
     1491       and valid-handle(p-xmlh)
     1492       then do:
     1493         delete object p-xmlh:table-handle.
     1494         p-xmlh = ?.
     1495       end.
     1496       v-dsh = ?.
     1497     end.
     1498   end procedure.
     1499   procedure all-gates-clear :
     1500   define parameter buffer buf_temp-xml-tables for temp-xml-tables.
     1501   do
     1502   on error undo, return error
     1503   :
     1504     for each buf_temp-xml-tables
     1505     break
     1506     by buf_temp-xml-tables.uniq-gate-rec
     1507     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1508     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1509     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1510     :
     1511         if first-of(buf_temp-xml-tables.uniq-gate-rec) then do:
     1512           delete object buf_temp-xml-tables.gate-handle_.
     1513           buf_temp-xml-tables.gate-handle_ = ?.
     1514         end.
     1515         if valid-handle(buf_temp-xml-tables.table-handle_)
     1516         and buf_temp-xml-tables.table-handle_:dynamic = no
     1517         then do:
     1518           delete object buf_temp-xml-tables.table-handle_.
     1519           buf_temp-xml-tables.table-handle_ = ?.
     1520         end.
     1521         delete buf_temp-xml-tables.
     1522     end.
     1523   end.
     1524   end procedure.
     1525   procedure fix-schemalocation :
     1526   define input-output  parameter p-longchar as longchar no-undo .
     1527   DEFINE VARIABLE hdoc AS HANDLE.
     1528   DEFINE VARIABLE hroot AS HANDLE.
     1529   DEFINE VARIABLE hnode-child AS HANDLE.
     1530   DEFINE VARIABLE hnode-attr AS HANDLE.
     1531   define variable v-jj as integer   no-undo .
     1532   define variable ok as logical   no-undo .
     1533   define variable v-path1                    as character                no-undo .
     1534   DEFINE VARIABLE v-full-path1               as character                no-undo .
     1535   DEFINE VARIABLE v-file-name1               as character                no-undo .
     1536   DEFINE VARIABLE v-file-name-no-ext1        as character                no-undo .
     1537   DEFINE VARIABLE v-file-name-ext1           as character                no-undo .
     1538   define variable v-schema-location          as character                no-undo .
     1539   do
     1540   on error undo, return error return-value
     1541   :
     1542     CREATE X-DOCUMENT hdoc.
     1543     CREATE X-noderef hroot.
     1544     CREATE X-noderef hnode-child.
     1545     CREATE X-noderef hnode-attr.
     1546     hdoc:load("longchar", p-longchar, no) no-error.
     1547     iF ERROR-STATUS:GET-MESSAGE(1) <> '' THEN message ERROR-STATUS:GET-MESSAGE(1) view-as alert-box .
     1548     hdoc:get-document-element(hroot).
     1549     _repeat:
     1550     REPEAT v-jj = 1 TO hroot:NUM-CHILDREN:
     1551       ok = hroot:GET-CHILD(hNode-Child, v-jj).
     1552       if not ok then next.
     1553       if hNode-Child:local-name = "include"
     1554       then do:
     1555         ok = hNode-Child:GET-ATTRIBUTE-NODE( hnode-attr, "schemaLocation" ).
     1556           v-schema-location = hnode-attr:node-value.
     1557           run gbl/filename.p (
     1558                           input "exe/" + hnode-attr:node-value
     1559                         ,output v-full-path1
     1560                         ,output v-path1
     1561                         ,output v-file-name1
     1562                         ,output v-file-name-no-ext1
     1563                         ,output v-file-name-ext1
     1564                         ) no-error .
     1565           if error-status :error then do:
     1566             delete object hnode-attr.
     1567             delete object hnode-child.
     1568             delete object hroot.
     1569             delete object hdoc.
     1570             undo, return error substitute("Не удалось определить расположение схемы &1", v-schema-location).
     1571           end.
     1572         ok = hNode-Child:sET-ATTRIBUTE(  "schemaLocation", v-full-path1 ).
     1573         leave  _repeat.
     1574       end.
     1575     END.
     1576     hdoc:save("longchar", p-longchar).
     1577     delete object hnode-attr.
     1578     delete object hnode-child.
     1579     delete object hroot.
     1580     delete object hdoc.
     1581   end.
     1582   end procedure.
     1583   procedure gate-clb_fill-xml-tables :
     1584   define input parameter p-dsh as handle no-undo .
     1585   define input-output parameter p-xmlh as handle no-undo .
     1586   define variable v-ii as integer no-undo .
     1587     do
     1588     on error undo, return error
     1589     :
     1590       do v-ii = 1 to p-dsh:num-buffers:
     1591         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1592         if not p-xmlh:available then do:
     1593           p-xmlh:buffer-create().
     1594           assign
     1595           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1596           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1597           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1598           p-xmlh::gate-handle_ = p-dsh
     1599           p-xmlh::uniq-gate-rec = entry(2, p-dsh:private-data, chr(4))
     1600           p-xmlh::gate-name = p-dsh:name
     1601           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1602           .
     1603           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1604             assign
     1605             p-xmlh::order = -3.
     1606           end.
     1607           p-xmlh:buffer-release().
     1608         end.
     1609       end.
     1610     end.
     1611   end procedure.
     1612   procedure all-gates-empty :
     1613   define buffer buf_temp-xml-tables for temp-xml-tables.
     1614   do
     1615   on error undo, return error
     1616   :
     1617     for each buf_temp-xml-tables
     1618     break
     1619     by buf_temp-xml-tables.uniq-gate-rec
     1620     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1621     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1622     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1623     :
     1624       if valid-handle(buf_temp-xml-tables.tbl-handle_) then do:
     1625         buf_temp-xml-tables.tbl-handle_:empty-temp-table().
     1626       end.
     1627     end.
     1628   end.
     1629   end procedure.
     1630   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1631   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1632   define temp-table ORDRSP-t no-undo
     1633   field NUMBER  as character
     1634   field DATE as date
     1635   field TIME_ as character
     1636   field ORDERNUMBER  as character
     1637   field ORDERDATE  as date
     1638   field DELIVERYDATE as date
     1639   field CURRENCY as character
     1640   field ACTION as integer
     1641   index pi is unique primary NUMBER
     1642   .
     1643   define temp-table  HEAD-t no-undo
     1644   field NUMBER  as character
     1645   field BUYER as character format "9999999999999"
     1646   field SUPPLIER as character format "9999999999999"
     1647   field DELIVERYPLACE as character format "9999999999999"
     1648   field INVOICEPARTNER as character format "9999999999999"
     1649   field SENDER as character format "9999999999999"
     1650   field RECIPIENT as character format "9999999999999"
     1651   field EDIINTERCHANGEID as character format "99999999999999"
     1652   field EDIMESSAGE as character format "99999999999999"
     1653   index pi is unique primary  number
     1654   .
     1655   define temp-table POSITION-t no-undo
     1656   field NUMBER  as character
     1657   field POSITIONNUMBER as integer
     1658   field PRODUCT as character
     1659   field PRODUCTIDBUYER as character format "X(16)"
     1660   field PRODUCTIDSUPPLIER as character format "X(16)"
     1661   field DESCRIPTION as character format "X(70)"
     1662   field PRICE as decimal
     1663   field VAT as decimal
     1664   field PRODUCTTYPE as integer
     1665   field ORDEREDQUANTITY as decimal
     1666   field ACCEPTEDQUANTITY as decimal
     1667   field INFO as character
     1668   index pi is unique primary  number positionnumber
     1669   .
     1670   define dataset ORDRSP_-t
     1671   for
     1672   ORDRSP-t, HEAD-t, POSITION-t
     1673   data-relation r1 for ORDRSP-t, HEAD-t relation-fields ( NUMBER, NUMBER) nested
     1674   data-relation r2 for HEAD-t, POSITION-t relation-fields ( NUMBER, NUMBER) nested
     1675   .
     1676   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1677   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1678   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1679   procedure ordlineattr-value :
     1680     do
     1681     on error undo, return error return-value
     1682     :
     1683       define input  parameter p-doc-code like ub.ord-line-attr.doc-code   no-undo .
     1684       define input  parameter p-gds-code like ub.ord-line-attr.gds-code   no-undo .
     1685       define input  parameter p-code     like ub.ord-line-attr.attr-code  no-undo .
     1686       define output parameter p-value    like ub.ord-line-attr.attr-value no-undo .
     1687       define output parameter p-type     as character no-undo .
     1688       define buffer buf_ord-line-attr for ub.ord-line-attr .
     1689       define variable v-format         as character no-undo .
     1690       define variable v-fillin_width   as integer   no-undo .
     1691       define variable v-fillin_height  as integer   no-undo .
     1692       define variable v-label          as character no-undo .
     1693       define variable v-user-can-edit  as logical   no-undo .
     1694       define variable v-output-display as logical   no-undo .
     1695       define variable v-other          as character no-undo .
     1696       define variable v-proc           as character no-undo .
     1697       define variable v-func           as character no-undo .
     1698       define variable v-sort           as integer   no-undo .
     1699       run ordlineattr-code in this-procedure
     1700         (input  p-code
     1701         ,output p-type
     1702         ,output v-format
     1703         ,output v-fillin_width
     1704         ,output v-fillin_height
     1705         ,output v-label
     1706         ,output v-user-can-edit
     1707         ,output v-output-display
     1708         ,output v-proc
     1709         ,output v-func
     1710         ,output v-sort
     1711         ,output v-other
     1712         ) no-error .
     1713       if error-status :error then do:
     1714         undo, return error return-value .
     1715       end.
     1716       find first buf_ord-line-attr no-lock
     1717         where buf_ord-line-attr.doc-code  = p-doc-code
     1718           and buf_ord-line-attr.gds-code  = p-gds-code
     1719           and buf_ord-line-attr.attr-code = p-code
     1720         no-error .
     1721       if avail buf_ord-line-attr then do:
     1722         assign
     1723           p-value =  buf_ord-line-attr.attr-value
     1724         .
     1725       end.
     1726       else do:
     1727         assign
     1728           p-value = if p-type = 'L':U then "no":U else ""
     1729         .
     1730       end.
     1731     end.
     1732   end procedure.
     1733   procedure ordlineattr-write :
     1734     do
     1735     on error undo, return error return-value
     1736     :
     1737       define input parameter p-doc-code like ub.ord-line-attr.doc-code   no-undo .
     1738       define input parameter p-gds-code like ub.ord-line-attr.gds-code   no-undo .
     1739       define input parameter p-code     like ub.ord-line-attr.attr-code  no-undo .
     1740       define input parameter p-value    like ub.ord-line-attr.attr-value no-undo .
     1741       define buffer buf_ord-line-attr for ub.ord-line-attr .
     1742       define variable v-type           as character no-undo .
     1743       define variable v-format         as character no-undo .
     1744       define variable v-fillin_width   as integer   no-undo .
     1745       define variable v-fillin_height  as integer   no-undo .
     1746       define variable v-label          as character no-undo .
     1747       define variable v-user-can-edit  as logical   no-undo .
     1748       define variable v-output-display as logical   no-undo .
     1749       define variable v-other          as character no-undo .
     1750       define variable v-proc           as character no-undo .
     1751       define variable v-func           as character no-undo .
     1752       define variable v-sort           as integer   no-undo .
     1753       run ordlineattr-code in this-procedure
     1754         (input  p-code
     1755         ,output v-type
     1756         ,output v-format
     1757         ,output v-fillin_width
     1758         ,output v-fillin_height
     1759         ,output v-label
     1760         ,output v-user-can-edit
     1761         ,output v-output-display
     1762         ,output v-proc
     1763         ,output v-func
     1764         ,output v-sort
     1765         ,output v-other
     1766         ) no-error .
     1767       if error-status :error then do:
     1768         message
     1769           vss-workfile vss-revision vss-description skip
     1770           error-status :get-message(1) skip
     1771           return-value skip
     1772           ""
     1773           view-as alert-box error
     1774         .
     1775         undo, return error return-value .
     1776       end.
     1777       find first buf_ord-line-attr exclusive-lock
     1778         where buf_ord-line-attr.doc-code  = p-doc-code
     1779           and buf_ord-line-attr.gds-code  = p-gds-code
     1780           and buf_ord-line-attr.attr-code = p-code
     1781         no-error .
     1782       if not available buf_ord-line-attr then do:
     1783         create buf_ord-line-attr .
     1784         assign
     1785           buf_ord-line-attr.doc-code   = p-doc-code
     1786           buf_ord-line-attr.gds-code   = p-gds-code
     1787           buf_ord-line-attr.attr-code  = p-code
     1788         .
     1789       end.
     1790       assign
     1791         buf_ord-line-attr.attr-value = p-value
     1792       .
     1793   end.
     1794   end procedure.
     1795   procedure ordlineattr-exist :
     1796     do
     1797     on error undo, return error return-value
     1798     :
     1799       define input parameter p-doc-code like ub.ord-line-attr.doc-code   no-undo .
     1800       define input parameter p-gds-code like ub.ord-line-attr.gds-code   no-undo .
     1801       define input parameter p-code     like ub.ord-line-attr.attr-code  no-undo .
     1802       define output parameter p-exist   as logical  no-undo .
     1803       define buffer buf_ord-line-attr for ub.ord-line-attr .
     1804       define variable v-type           as character no-undo .
     1805       define variable v-format         as character no-undo .
     1806       define variable v-fillin_width   as integer   no-undo .
     1807       define variable v-fillin_height  as integer   no-undo .
     1808       define variable v-label          as character no-undo .
     1809       define variable v-user-can-edit  as logical   no-undo .
     1810       define variable v-output-display as logical   no-undo .
     1811       define variable v-other          as character no-undo .
     1812       define variable v-proc           as character no-undo .
     1813       define variable v-func           as character no-undo .
     1814       define variable v-sort           as integer   no-undo .
     1815       run ordlineattr-code in this-procedure
     1816         (input  p-code
     1817         ,output v-type
     1818         ,output v-format
     1819         ,output v-fillin_width
     1820         ,output v-fillin_height
     1821         ,output v-label
     1822         ,output v-user-can-edit
     1823         ,output v-output-display
     1824         ,output v-proc
     1825         ,output v-func
     1826         ,output v-sort
     1827         ,output v-other
     1828         ) no-error .
     1829       if error-status :error then do:
     1830         undo, return error return-value .
     1831       end.
     1832       find first buf_ord-line-attr no-lock
     1833         where buf_ord-line-attr.doc-code  = p-doc-code
     1834           and buf_ord-line-attr.gds-code = p-gds-code
     1835           and buf_ord-line-attr.attr-code = p-code
     1836         no-error .
     1837       if  available buf_ord-line-attr then do:
     1838         p-exist = yes.
     1839       end.
     1840     end.
     1841   end procedure.
     1842   procedure ordlineattr-delete :
     1843     do
     1844     on error undo, return error return-value
     1845     :
     1846       define input parameter p-doc-code like ub.ord-line-attr.doc-code   no-undo .
     1847       define input parameter p-gds-code like ub.ord-line-attr.gds-code   no-undo .
     1848       define input parameter p-code     like ub.ord-line-attr.attr-code  no-undo .
     1849       define output parameter p-deleted  as logical no-undo.
     1850       define buffer buf_ord-line-attr for ub.ord-line-attr .
     1851       define variable v-type           as character no-undo .
     1852       define variable v-format         as character no-undo .
     1853       define variable v-fillin_width   as integer   no-undo .
     1854       define variable v-fillin_height  as integer   no-undo .
     1855       define variable v-label          as character no-undo .
     1856       define variable v-user-can-edit  as logical   no-undo .
     1857       define variable v-output-display as logical   no-undo .
     1858       define variable v-proc           as character no-undo .
     1859       define variable v-func           as character no-undo .
     1860       define variable v-sort           as integer   no-undo .
     1861       define variable v-other          as character no-undo .
     1862       run ordlineattr-code in this-procedure
     1863         (input  p-code
     1864         ,output v-type
     1865         ,output v-format
     1866         ,output v-fillin_width
     1867         ,output v-fillin_height
     1868         ,output v-label
     1869         ,output v-user-can-edit
     1870         ,output v-output-display
     1871         ,output v-proc
     1872         ,output v-func
     1873         ,output v-sort
     1874         ,output v-other
     1875         ) no-error .
     1876       if error-status :error then do:
     1877         undo, return error return-value .
     1878       end.
     1879       find first buf_ord-line-attr exclusive-lock
     1880         where buf_ord-line-attr.doc-code  = p-doc-code
     1881           and buf_ord-line-attr.gds-code  = p-gds-code
     1882           and buf_ord-line-attr.attr-code = p-code
     1883         no-error NO-WAIT.
     1884       if not available buf_ord-line-attr then do:
     1885         p-deleted = no.
     1886       end.
     1887       else do:
     1888         delete buf_ord-line-attr.
     1889         p-deleted = yes.
     1890       end.
     1891     end.
     1892   end procedure.
     1893   procedure ordlineattr-code :
     1894     do on error undo, return error return-value
     1895     :
     1896       define input  parameter p-code           as character no-undo .
     1897       define output parameter p-type           as character no-undo .
     1898       define output parameter p-format         as character no-undo .
     1899       define output parameter p-fillin_width   as integer   no-undo .
     1900       define output parameter p-fillin_height  as integer   no-undo .
     1901       define output parameter p-label          as character no-undo .
     1902       define output parameter p-user-can-edit  as logical   no-undo .
     1903       define output parameter p-output-display as logical   no-undo .
     1904       define output parameter p-proc           as character no-undo .
     1905       define output parameter p-func           as character no-undo .
     1906       define output parameter p-sort           as integer   no-undo .
     1907       define output parameter p-other          as character no-undo .
     1908       case p-code :
     1909               when 'cycle-cli-qnty':U then do:     assign     p-label          = "Количество"     p-type           = 'D':U      p-format         = ">>>>>>>>>>>>>>>9.999"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "Количество"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
     1910               when 'ord-EAN13':U then do:     assign     p-label          = "EAN в EDI"     p-type           = 'C':U      p-format         = "X(13)"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "EAN в EDI"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
     1911         otherwise do:
     1912           undo, return error "неизвестный атрибут строки заказа" + " " + p-code .
     1913         end.
     1914       end.
     1915     end.
     1916   end procedure.
     1917   FUNCTION cr-edist_get-mess-mean returns character ( input p-mess as character):
     1918   define variable v-ii as integer   no-undo .
     1919   define variable v-dop as character no-undo .
     1920   define variable v-dop1 as character no-undo .
     1921   define variable v-mess as character no-undo .
     1922   do v-ii = 1 to num-entries(p-mess, chr(4) ):
     1923     v-dop = entry(v-ii, p-mess, chr(4) ).
     1924     case entry(1, v-dop, "="):
     1925       when 'pack-num':U then do:
     1926         v-dop1 =  substitute("&1 &2", 'Пакет', entry(2, v-dop, "=")).
     1927       end.
     1928       when 'route':U then do:
     1929         v-dop1 =  substitute("&1 &2", 'Рут':U, entry(2, v-dop, "=")).
     1930       end.
     1931       when 'ediiterchangeid':U then do:
     1932         v-dop1 =  substitute("&1 &2", 'ediiterchangeid':U, entry(2, v-dop, "=")).
     1933       end.
     1934       when 'price-up':U then do:
     1935         v-dop1 =  substitute("&1 &2", 'Цена':U, entry(2, v-dop, "=")).
     1936       end.
     1937       when 'price-down':U then do:
     1938         v-dop1 =  substitute("&1 &2", 'Цена':U, entry(2, v-dop, "=")).
     1939       end.
     1940       when 'vat-change':U then do:
     1941         v-dop1 =  substitute("&1 &2", 'НДС':U, entry(2, v-dop, "=")).
     1942       end.
     1943       when 'ps':U then do:
     1944         v-dop1 =  substitute("&1 &2", ' ':U, entry(2, v-dop, "=")).
     1945       end.
     1946       when 'info':U then do:
     1947         v-dop1 =  substitute("&1 &2", 'Инф:':U, entry(2, v-dop, "=")).
     1948       end.
     1949       when 'qnty-up':U then do:
     1950         v-dop1 =  substitute("&1 &2", 'Кол-во':U, entry(2, v-dop, "=")).
     1951       end.
     1952       when 'qnty-down':U then do:
     1953         v-dop1 =  substitute("&1 &2", 'Кол-во':U, entry(2, v-dop, "=")).
     1954       end.
     1955       when 'bstr-change':U then do:
     1956         v-dop1 =  substitute("&1 &2", 'Штрихкод:':U, entry(2, v-dop, "=")).
     1957       end.
     1958       when 'shipdate-change':U then do:
     1959         v-dop1 =  substitute("&1 &2", 'Дата отгрузки:':U, entry(2, v-dop, "=")).
     1960       end.
     1961       when 'clioutdoc-change':U then do:
     1962         v-dop1 =  substitute("&1 &2", '№ заказа по пост-ку:':U, entry(2, v-dop, "=")).
     1963       end.
     1964     end case.
     1965     v-mess  = v-mess + (if v-mess = '' then '' else chr(32)) + v-dop1.
     1966   end.
     1967   return v-mess.
     1968   end function.
     1969   FUNCTION cr-edist_get-error-mean returns character ( input p-mess as character):
     1970   define variable v-ii as integer   no-undo .
     1971   define variable v-dop as character no-undo .
     1972   define variable v-dop1 as character no-undo .
     1973   define variable v-mess as character no-undo .
     1974   do v-ii = 1 to num-entries(p-mess, chr(4) ):
     1975     v-dop = entry(v-ii, p-mess, chr(4) ).
     1976     case entry(1, v-dop, "="):
     1977       when 'pack-num':U then do:
     1978         v-dop1 =  substitute("&1 &2", 'Пакет', entry(2, v-dop, "=")).
     1979       end.
     1980       when 'route':U then do:
     1981         v-dop1 =  substitute("&1 &2", 'Рут':U, entry(2, v-dop, "=")).
     1982       end.
     1983       when 'ediiterchangeid':U then do:
     1984         v-dop1 =  substitute("&1 &2", 'ediiterchangeid':U, entry(2, v-dop, "=")).
     1985       end.
     1986       when 'price-up':U then do:
     1987         v-dop1 =  substitute("&1 &2", 'Цена':U, entry(2, v-dop, "=")).
     1988       end.
     1989       when 'price-down':U then do:
     1990         v-dop1 =  substitute("&1 &2", 'Цена':U, entry(2, v-dop, "=")).
     1991       end.
     1992       when 'vat-change':U then do:
     1993         v-dop1 =  substitute("&1 &2", 'НДС':U, entry(2, v-dop, "=")).
     1994       end.
     1995       when 'ps':U then do:
     1996         v-dop1 =  substitute("&1 &2", ' ':U, entry(2, v-dop, "=")).
     1997       end.
     1998       when 'info':U then do:
     1999         v-dop1 =  substitute("&1 &2", 'Инф:':U, entry(2, v-dop, "=")).
     2000       end.
     2001       when 'qnty-up':U then do:
     2002         v-dop1 =  substitute("&1 &2", 'Кол-во':U, entry(2, v-dop, "=")).
     2003       end.
     2004       when 'qnty-down':U then do:
     2005         v-dop1 =  substitute("&1 &2", 'Кол-во':U, entry(2, v-dop, "=")).
     2006       end.
     2007       when 'bstr-change':U then do:
     2008         v-dop1 =  substitute("&1 &2", 'Штрихкод:':U, entry(2, v-dop, "=")).
     2009       end.
     2010       when 'shipdate-change':U then do:
     2011         v-dop1 =  substitute("&1 &2", 'Дата отгрузки:':U, entry(2, v-dop, "=")).
     2012       end.
     2013       when 'clioutdoc-change':U then do:
     2014         v-dop1 =  substitute("&1 &2", '№ заказа по пост-ку:':U, entry(2, v-dop, "=")).
     2015       end.
     2016     end case.
     2017     v-mess  = v-mess + (if v-mess = '' then '' else chr(4)) + v-dop1.
     2018   end.
     2019   return v-mess.
     2020   end function.
     2021   FUNCTION cr-edist_get-mess-key-value returns character ( input p-mess as character, input p-key as character):
     2022   define variable v-ii as integer   no-undo .
     2023   define variable v-dop as character no-undo .
     2024   define variable v-dop1 as character no-undo .
     2025   define variable v-value as character no-undo .
     2026   do v-ii = 1 to num-entries(p-mess, chr(4) ):
     2027     v-dop = entry(v-ii, p-mess, chr(4) ).
     2028     if entry(1, v-dop, "=") = p-key then do:
     2029       return entry(2, v-dop, "=").
     2030     end.
     2031   end.
     2032   return v-value.
     2033   end function.
     2034   FUNCTION cr-edist_add-edist-mess returns character ( input p-mess as character
     2035                                                        ,input p-key as character
     2036                                                        ,input p-value as character):
     2037   define variable v-dop as character no-undo .
     2038   define variable v-modificator as character no-undo .
     2039   assign
     2040   v-modificator = entry(2, p-key, "-") no-error .
     2041   case v-modificator:
     2042     when "up" then do:
     2043       v-dop = substitute("&1=&2<&3", p-key, entry(1, p-value, chr(4)) , entry(2, p-value, chr(4))).
     2044     end.
     2045     when "down" then do:
     2046       v-dop = substitute("&1=&2>&3", p-key, entry(1, p-value, chr(4)) , entry(2, p-value, chr(4))).
     2047     end.
     2048     when "change" then do:
     2049       v-dop = substitute("&1=&2 ->&3", p-key, entry(1, p-value, chr(4)) , entry(2, p-value, chr(4))).
     2050     end.
     2051     otherwise do:
     2052       v-dop = substitute("&1=&2", p-key, p-value).
     2053     end.
     2054   end case.
     2055   if p-mess = ''
     2056   or p-mess = ? then do:
     2057     return v-dop .
     2058   end.
     2059   else do:
     2060     return substitute("&1&2&3", p-mess, chr(4), v-dop).
     2061   end.
     2062   end function.
     2063   procedure create-edi-state :
     2064   define input  parameter p-tbl-name   as character no-undo .
     2065   define input  parameter p-doc-code   as character no-undo .
     2066   define input  parameter p-cli-type   as character no-undo .
     2067   define input  parameter p-cli-code   as integer   no-undo .
     2068   define input  parameter p-act        as character no-undo .
     2069   define input  parameter p-state      as character no-undo .
     2070   define input  parameter p-err        as integer   no-undo .
     2071   define input  parameter p-des        as character no-undo .
     2072   define input  parameter p-mess       as character no-undo .
     2073   define input  parameter p-dm         as integer  no-undo .
     2074   define input-output parameter p-date       as date no-undo .
     2075   define input-output parameter p-time       as integer no-undo .
     2076   define buffer buf_EDI-status for ub.EDI-status  .
     2077   define variable v-time as integer   no-undo .
     2078   define variable v-date as date   no-undo .
     2079   do
     2080   on error undo, return error return-value
     2081   :
     2082     if p-date = ? then do:
     2083       run cur-time in this-procedure ( output v-date, output v-time).
     2084     end.
     2085     else do:
     2086       assign
     2087       v-date = p-date
     2088       v-time = p-time
     2089       .
     2090     end.
     2091     find first buf_edi-status exclusive-lock where
     2092                 buf_edi-status.date-status = v-date
     2093             and buf_edi-status.time-status = v-time
     2094             and buf_edi-status.tbl-name    = p-tbl-name
     2095             and buf_edi-status.doc-code    = p-doc-code no-error .
     2096     if not available buf_edi-status  then do:
     2097       create buf_edi-status.
     2098     end.
     2099     assign
     2100     buf_edi-status.act         = p-act        .
     2101     buf_edi-status.cli-type    = p-cli-type   .
     2102     buf_edi-status.cli-code    = p-cli-code   .
     2103     buf_edi-status.des-err     = buf_edi-status.des-err + (if buf_edi-status.des-err = '' then '' else chr(4)) + p-des        .
     2104     buf_edi-status.doc-code    = p-doc-code   .
     2105     buf_edi-status.err-code    = p-err        .
     2106     buf_edi-status.mess-id     = buf_edi-status.mess-id + (if buf_edi-status.mess-id = '' then '' else chr(4)) + p-mess       .
     2107     buf_edi-status.state       = p-state      .
     2108     buf_edi-status.tbl-name    = p-tbl-name   .
     2109     buf_edi-status.date-status = v-date       .
     2110     buf_edi-status.time-status = v-time       .
     2111     buf_edi-status.whole-send-news = p-dm     .
     2112     buf_edi-status.user-name   = (if g#news then (chr(4) +  'СПН':U)
     2113                                       else (if g#esys
     2114                                             then (chr(4) +  'ВС':U)
     2115                                             else g#userid)
     2116                                       )       .
     2117     assign
     2118     p-date = buf_edi-status.date-status
     2119     p-time = buf_edi-status.time-status
     2120     .
     2121   end.
     2122   end procedure.
