     2151   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2152   define temp-table temp-edi-status no-undo
     2153   like ub.edi-status.
     2154   define variable cr-edist_full-mess as longchar  no-undo .
     2155   procedure create-edi-statett :
     2156   define input  parameter p-tbl-name   as character no-undo .
     2157   define input  parameter p-doc-code   as character no-undo .
     2158   define input  parameter p-cli-type   as character no-undo .
     2159   define input  parameter p-cli-code   as integer   no-undo .
     2160   define input  parameter p-act        as character no-undo .
     2161   define input  parameter p-state      as character no-undo .
