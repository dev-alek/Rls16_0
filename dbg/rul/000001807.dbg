     3121   procedure load-ruleset-context :
     3122   define input parameter p-ruleset-id as integer no-undo .
     3123   define buffer buf_rule-call-param for tt0-rule-call-param.
     3124     do
     3125     on error undo, return error
     3126     :
     3127    find first buf_rule-call-param no-lock where
     3128   buf_rule-call-param.codex_id = p-codex-id
     3129   and buf_rule-call-param.ruleset_id = p-ruleset-id
     3130   and buf_rule-call-param.call_id = p-call-id
     3131   and buf_rule-call-param.order_id = p-order-id
     3132   and buf_rule-call-param.rule_id = p-rule-id
     3133   and buf_rule-call-param.param-name = "p-close"
     3134    no-error.
     3135   if available buf_rule-call-param then do:
     3136   assign p-close = buf_rule-call-param.param-value-logical.
     3137   end.
     3138    find first buf_rule-call-param no-lock where
     3139   buf_rule-call-param.codex_id = p-codex-id
     3140   and buf_rule-call-param.ruleset_id = p-ruleset-id
     3141   and buf_rule-call-param.call_id = p-call-id
     3142   and buf_rule-call-param.order_id = p-order-id
     3143   and buf_rule-call-param.rule_id = p-rule-id
     3144   and buf_rule-call-param.param-name = "p-this-type-only"
     3145    no-error.
     3146   if available buf_rule-call-param then do:
     3147   assign p-this-type-only = buf_rule-call-param.param-value-logical.
     3148   end.
     3149       case p-ruleset-id:
     3150         when 1 then do:
     3151           assign
     3152           v-current-host-code = p-host-code
     3153           v-current-obj-type = p-obj-type
     3154           v-current-obj-code = p-obj-code
     3155           v-current-db-num = g#db-num
     3156           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     3157           v-current-date = p-doc-date
     3158           v-current-doc-code = p-doc-code
     3159           file-name  = p-process-file-name
     3160           .
     3161           if NOT g#db-num = 0 then do:
     3162             run write-log-and-file in p-log-handle (
     3163                   input 1
     3164                 , input log-file-name
     3165                 , input 1
     3166                 , input substitute("Импорт стоплистов возможен только в ГБД")).
     3167             assign
     3168             v-view-log = yes.
     3169             .
     3170             return "return".
     3171           end.
     3172           run gbl/filename.p (
     3173                           input  file-name
     3174                           ,output v-full-path
     3175                           ,output v-path
     3176                           ,output v-file-name
     3177                           ,output v-file-name-no-ext
     3178                           ,output v-file-name-ext
     3179                           ) no-error .
     3180           if error-status:error then do:
     3181             run write-log-and-file in p-log-handle (
     3182                   input 1
     3183                 , input log-file-name
     3184                 , input 1
     3185                 , input substitute("Не найден файл &1 для импорта стоплистов", file-name)).
     3186             assign
     3187             v-view-log = yes.
     3188             .
     3189             return "return".
     3190           end.
     3191           assign
     3192           file-name = v-full-path.
     3193         end.
     3194       end case.
     3195     end.
     3196   end procedure.
     3197   procedure delete-procedure :
     3198     do
     3199     on error undo, return error
     3200     :
     3201         run garbcoll_clear in this-procedure .
     3202     end.
     3203   end procedure.
     3204   PROCEDURE err-write:
     3205     DEFINE INPUT-OUTPUT PARAMETER mess as char No-UNDO.
     3206     seek STREAM Instream to my-seek1.
     3207     import stream InStream unformatted
     3208     s.
     3209     v-global-err = yes.
     3210     run write-log-and-file in p-log-handle (
     3211           input 1
     3212         , input log-file-name
     3213         , input 1
     3214         , input mess + chr(10) + s).
     3215     assign
     3216     v-view-log = yes.
     3217     mess = "".
     3218     seek STREAM Instream to my-seek2.
     3219   END PROCEDURE.
     3220   PROCEDURE err-write2:
     3221     DEFINE INPUT-OUTPUT PARAMETER mess as char No-UNDO.
