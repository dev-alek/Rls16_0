     2005   function 00060000_get-error-message returns character :
     2006   define variable v-ii as integer no-undo .
     2007   define variable v-mess as character no-undo .
     2008   DO v-ii = 1 TO ERROR-STATUS:NUM-MESSAGES:
     2009       v-mess = substitute("&1&2ош &3"
     2010                           ,v-mess
     2011                           ,chr(10)
     2012                           ,ERROR-STATUS:GET-MESSAGE(v-ii)).
     2013   END.
     2014   return v-mess.
     2015   end function.
