     1141   procedure library-cls_get-handle :
     1142   define input parameter p-library-name as character no-undo .
     1143   define output parameter p-library-handle as handle no-undo .
     1144     do
     1145     on error undo, return error
     1146     :
     1147       CASE p-library-name:
     1148         when "library" then do:
     1149           if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end.
     1150           p-library-handle = g#library.
     1151         end.
     1152         when "library2" then do:
     1153           if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end.
     1154           p-library-handle = g#library2.
     1155         end.
     1156       end case.
     1157     end.
     1158   end procedure.
     1159   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1160   function ean-13 returns character ( input p-code as character
     1161                                      ,input DC-PFX as character):
     1162   define variable Dc-frmt as character no-undo INIT "ean13".
     1163   define variable FULL-B-CODE as character no-undo .
     1164   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1165     define variable tmp-str12  as character no-undo.
     1166     define variable tmp-num12  as character no-undo.
     1167     define variable i12        as integer   no-undo.
     1168     define variable sum12      as integer   no-undo.
     1169     define variable len-code12 as integer   no-undo.
     1170     define variable varcont12  as logical   initial yes no-undo.
     1171     CASE Dc-frmt :
     1172       WHEN "EAN13" THEN do:
     1173         assign
     1174           tmp-str12 = string( p-code, "999999999999" )
     1175         .
     1176       end.
     1177       WHEN "EAN8" THEN do:
     1178         assign
     1179           tmp-str12 = string( p-code, "9999999" )
     1180         .
     1181       end.
     1182       OTHERWISE DO:
     1183           message "Неизвестный тип генерации бар-кода процедурой bc-gnrti.i: " Dc-frmt " ."
     1184           view-as alert-box error.
     1185           return error.
     1186       END.
     1187     END CASE.
     1188     if varcont12 = yes then do:
     1189       if integer( substring( tmp-str12, 1, length( Dc-pfx ) ) ) <> 0
     1190       then do:
     1191         message
     1192           "Невозможно сформировать бар-код" SKIP
     1193           "для товара с кодом: " p-code
     1194           view-as alert-box error title "подрезание кода".
     1195         return error.
     1196       end.
     1197       else do:
     1198         assign
     1199           full-b-code = Dc-pfx + substring( tmp-str12, length( Dc-pfx ) + 1, length( tmp-str12 ) - length( Dc-pfx ) )
     1200           len-code12    = length( full-b-code )
     1201         .
     1202         define variable v-sum-char12 as character no-undo .
     1203         assign
     1204           sum12 = 0
     1205         .
     1206         do i12 = 1 to len-code12 by 2
     1207         :
     1208           assign
     1209             v-sum-char12 = substr(full-b-code, len-code12 - i12 + 1, 1)
     1210           .
     1211           if v-sum-char12 < "0"
     1212           or v-sum-char12 > "9"
     1213           then do:
     1214             message
     1215               "Невозможно сформировать бар-код" skip
     1216               "для товара с кодом: " p-code skip
     1217               view-as alert-box error title "подсчет контрольной суммы".
     1218             return error.
     1219           end.
     1220           assign
     1221             sum12 = sum12 + integer(v-sum-char12)
     1222           .
     1223         end.
     1224         if varcont12 = yes then do:
     1225           assign
     1226             sum12 = sum12 * 3
     1227           .
     1228           do i12 = 2 to len-code12 by 2
     1229           :
     1230             assign
     1231               v-sum-char12 = substr(full-b-code, len-code12 - i12 + 1, 1)
     1232             .
     1233             if v-sum-char12 < "0"
     1234             or v-sum-char12 > "9"
     1235             then do:
     1236               message
     1237                 "Невозможно сформировать бар-код" skip
     1238                 "для товара с кодом: " p-code skip
     1239                 view-as alert-box error title "подсчет контрольной суммы".
     1240               return error.
     1241             end.
     1242             assign
     1243               sum12 = sum12 + integer(v-sum-char12)
     1244             .
     1245           end.
     1246           if varcont12 = yes then do:
     1247              if sum12 mod 10 = 0 then do:
     1248                assign
     1249                  full-b-code = full-b-code + '0'
     1250                .
     1251              end.
     1252              else do:
     1253                assign
     1254                  full-b-code = full-b-code + string(10 - sum12 mod 10)
     1255                .
     1256              end.
     1257           end.
     1258         end.
     1259       end.
     1260     end.
     1261   return full-b-code .
     1262   end function.
