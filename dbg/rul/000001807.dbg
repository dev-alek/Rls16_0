     3240     mess = substitute("&1&2Карта &3"
     3241                       ,mess
     3242                       ,chr(10)
     3243                       ,buf_dis-card.d-card
     3244                       ).
     3245     run write-log-and-file in p-log-handle (
     3246           input 1
     3247         , input log-file-name
     3248         , input 1
     3249         , input mess).
     3250     assign
     3251     v-view-log = yes.
     3252     mess = "".
     3253   END PROCEDURE.
