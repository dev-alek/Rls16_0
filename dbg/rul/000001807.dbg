     1435       .
     1436       run disproph_send-nws in this-procedure (
     1437                                                 buffer buf_c-dis-card-property
     1438                                                ,buffer buf_c-dc-hist
     1439                                                ,buffer buf_dis-card
     1440                                                 ).
     1441       end.
     1442     end.
     1443   end procedure.
     1444   procedure disproph_send-nws :
     1445   define parameter buffer buf_c-dis-card-property for ub.c-dis-card-property.
     1446   define parameter buffer buf_c-dc-hist for ub.c-dc-hist.
     1447   define parameter buffer buf_Dis-card for ub.dis-card.
     1448   define variable v-dh-hn as integer no-undo .
     1449   main-block:
     1450   do
     1451   on error undo, return error return-value
     1452   :
     1453     if g#news
     1454     and g#db-num > 0
     1455     and buf_c-dis-card-property.corr-user-db-num <> g#db-num
     1456     then return.
     1457     if g#db-num = 0
     1458     or (g#news
     1459         and g#db-num > 0
     1460         and buf_c-dis-card-property.corr-user-name = (chr(4) +  'СПН':U)
     1461         )
     1462     then do:
     1463       if not available buf_dis-card then do:
     1464         find first buf_dis-card no-lock where
     1465                   buf_Dis-card.d-card = buf_c-dis-card-property.d-card no-error.
     1466       end.
     1467       if not available buf_dis-card then do:
     1468         assign
     1469         v-dh-hn = integer('0':U).
     1470       end.
     1471       else do:
     1472   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1473   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option in g#lib-nws
     1474     (input  g#db-num
     1475     ,input  'dis-card-property':U
     1476     ,input  0
     1477     ,input  '':U
     1478     ,input  0
     1479     ,input  buf_dis-card.type
     1480     ,input  '':U
     1481     ,input  '':U
     1482     ,input  buf_dis-card.emitent-host-code
     1483     ,input  (if buf_c-dis-card-property.dt-code > 0 then 0 else -1)
     1484     ,input  0
     1485     ,input  'hist-to-nws'
     1486     ,output v-dh-hn
     1487     ) no-error .
     1488       end.
     1489       if v-dh-hn >= 0 then do:
     1490         run str/callnews.p (
     1491           input 'c-dis-card-property':U
     1492           ,input (buffer buf_c-dis-card-property:handle)
     1493           ) no-error .
     1494         if error-status:error then do:
     1495           undo main-block,  return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1) ).
     1496         end.
     1497         if available buf_c-dc-hist then do:
     1498           run str/callnews.p (
     1499             input 'c-dc-hist':U
     1500             ,input (buffer buf_c-dc-hist:handle)
     1501             ) no-error .
     1502           if error-status:error then do:
     1503             undo main-block,  return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1) ).
     1504           end.
     1505         end.
     1506       end.
     1507     end.
     1508   end.
     1509   end procedure.
     1510   procedure discprop-node-code :
     1511   define input parameter p-dtm-code as integer no-undo .
     1512   define input parameter p-node-code as integer no-undo .
     1513   define output parameter p-data-type as character no-undo .
     1514   define output parameter p-format as character no-undo .
     1515   define output parameter p-label as character no-undo .
     1516   define output parameter p-range as integer no-undo .
     1517   define output parameter p-rw-option as character no-undo .
     1518   define buffer buf_prop-map for ub.prop-map.
     1519   define buffer buf_prop-head for ub.prop-head.
     1520   do
     1521   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1522   :
     1523   find first buf_prop-head no-lock where
     1524             buf_prop-head.dtm-code = p-dtm-code no-error .
     1525   if available buf_prop-head then do:
     1526     if p-node-code > 0 then do:
     1527       find first buf_prop-map no-lock where
     1528                 buf_prop-map.dtm-code = p-dtm-code
     1529             and buf_prop-map.node-code = p-node-code no-error .
     1530       if available buf_prop-map then do:
     1531         assign
     1532         p-data-type = buf_prop-map.node-value-type
     1533         p-format = buf_prop-map.node-format
     1534         p-label = buf_prop-map.node-label
     1535         p-rw-option = buf_prop-map.rw-option
     1536         .
     1537       end.
     1538     end.
     1539     if buf_prop-head.storage-place  = "":U
     1540     and buf_prop-head.storage-place-host  > "":U
     1541     and buf_prop-head.storage-place-obj  > "":U then do:
     1542       p-range =  12.
     1543     end.
     1544     if buf_prop-head.storage-place  > "":U
     1545     and buf_prop-head.storage-place-host  > "":U
     1546     and buf_prop-head.storage-place-obj  > "":U then do:
     1547       p-range =  3.
     1548     end.
     1549     if buf_prop-head.storage-place  > "":U
     1550     and buf_prop-head.storage-place-host  > "":U
     1551     and buf_prop-head.storage-place-obj  = "":U then do:
     1552       p-range =  2.
     1553     end.
     1554     if buf_prop-head.storage-place  = "":U
     1555     and buf_prop-head.storage-place-host  > "":U
     1556     and buf_prop-head.storage-place-obj  = "":U then do:
     1557       p-range =  1.
     1558     end.
     1559     if buf_prop-head.storage-place  > "":U
     1560     and buf_prop-head.storage-place-host  = "":U
     1561     and buf_prop-head.storage-place-obj  = "":U then do:
     1562       p-range =  0.
     1563     end.
     1564   end.
     1565   end.
     1566   end procedure.
     1567   procedure discprop-initial:
     1568   define input parameter p-dtm-code as integer no-undo .
     1569   define input parameter p-node-code as integer no-undo .
     1570   define output parameter p-init-value-character as character no-undo .
     1571   define output parameter p-init-value-date as date no-undo .
     1572   define output parameter p-init-value-decimal as decimal no-undo .
     1573   define output parameter p-init-value-integer as integer no-undo .
     1574   define output parameter p-init-value-logical as logical no-undo .
     1575   define buffer buf_prop-map for ub.prop-map.
     1576   find first buf_prop-map no-lock where
     1577             buf_prop-map.dtm-code = p-dtm-code
     1578         and buf_prop-map.node-code = p-node-code no-error.
     1579   if not available buf_prop-map then return error substitute("Не найдено свойство &1 для объекта &2"
     1580                                                               , p-node-code
     1581                                                               , p-dtm-code).
     1582   assign
     1583   p-init-value-character = buf_prop-map.init-value-character
     1584   p-init-value-date = buf_prop-map.init-value-date
     1585   p-init-value-decimal = buf_prop-map.init-value-decimal
     1586   p-init-value-integer = buf_prop-map.init-value-integer
     1587   p-init-value-logical = buf_prop-map.init-value-logical
     1588   .
     1589   end procedure.
     1590   Function discprop-usercanedit returns logical (  input p-dtm-code as integer, input p-db-num as integer):
     1591   define buffer buf_attr-prop for ub.attr-prop.
     1592   find first buf_attr-prop no-lock where
     1593             buf_attr-prop.table-name = 'dis-card-property':U
     1594         and buf_attr-prop.templ-rl-root = p-dtm-code
     1595         and buf_attr-prop.upper-prop-code = "UserCanEdit"
     1596         and buf_attr-prop.prop-code = (if p-db-num = 0 then 'DB0' else 'DBR':U) no-error.
     1597   if not available buf_attr-prop
     1598   or logical(buf_attr-prop.property-value) = no then do:
     1599     return no.
     1600   end.
     1601   return yes.
     1602   end function.
     1603   procedure discprop-edit :
     1604   define input parameter p-dtm-code-node-name as character no-undo .
     1605   define output parameter p-edit-menu-section-num as integer no-undo .
     1606   define buffer buf_attr-prop for ub.attr-prop.
     1607   do
     1608   on error undo, return error return-value
     1609   :
     1610     find first buf_attr-prop no-lock where
     1611             buf_attr-prop.table-name = 'dis-card-property':U
     1612        and  buf_attr-prop.templ-rl-root = integer(entry(1, p-dtm-code-node-name, chr(4)))
     1613        and  buf_attr-prop.upper-prop-code = "ManualEdit":U
     1614        and  buf_attr-prop.prop-code = "SectionNum":U no-error .
     1615     if available buf_attr-prop then do:
     1616       assign
     1617       p-edit-menu-section-num = integer(buf_attr-prop.property-value).
     1618     end.
     1619   end.
     1620   end procedure.
     1621   procedure discprop-node-name :
     1622   define input parameter p-dtm-code-node-name as character no-undo .
     1623   define output parameter p-tool-tip as character no-undo .
     1624   define output parameter p-node-label as character no-undo .
     1625   define buffer buf_prop-map for ub.prop-map.
     1626   define buffer buf_prop-head for ub.prop-head.
     1627   do
     1628   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1629   :
     1630     find first buf_prop-head no-lock where
     1631               buf_prop-head.dtm-code = integer(entry(1, p-dtm-code-node-name, chr(4) )) no-error .
     1632     assign
     1633     p-tool-tip   = if available buf_prop-head
     1634                    then buf_prop-head.prop-des
     1635                    else entry(1, p-dtm-code-node-name, chr(4) )
     1636     p-node-label = (if available buf_prop-head
     1637                     then buf_prop-head.prop-label
     1638                     else '':U)
     1639     .
     1640     if entry(2, p-dtm-code-node-name, chr(4) ) <> "" then do:
     1641       find first buf_prop-map no-lock where
     1642                 buf_prop-map.dtm-code = integer(entry(1, p-dtm-code-node-name, chr(4) ))
     1643           and  buf_prop-map.node-code = integer(entry(2, p-dtm-code-node-name, chr(4) )) no-error.
     1644       if available buf_prop-map then do:
     1645         assign
     1646         p-tool-tip   = buf_prop-map.node-description
     1647         p-node-label = (if available buf_prop-head
     1648                         then buf_prop-head.prop-label
     1649                         else '':U) + ":" + buf_prop-map.node-label
     1650         .
     1651       end.
     1652     end.
     1653   end.
     1654   end procedure.
     1655   procedure discprop-write :
     1656   define input parameter p-d-card          like ub.dis-card-property.d-card     no-undo .
     1657   define input parameter p-host-code       like ub.dis-card-property.host-code  no-undo .
     1658   define input parameter p-obj-type        like ub.dis-card-property.obj-type   no-undo .
     1659   define input parameter p-obj-code        like ub.dis-card-property.obj-code   no-undo .
     1660   define input parameter p-dtm-code        like ub.dis-card-property.dtm-code   no-undo .
     1661   define input parameter p-node-code       like ub.dis-card-property.node-code  no-undo .
     1662   define input parameter p-dt-code         like ub.dis-card-property.dt-code    no-undo .
     1663   define input parameter p-sum-id          like ub.dis-card-property.sum-id     no-undo .
     1664   define input parameter p-value-character like ub.dis-card-property.property-value-character no-undo .
     1665   define input parameter p-value-date      like ub.dis-card-property.property-value-date no-undo .
     1666   define input parameter p-value-decimal   like ub.dis-card-property.property-value-decimal no-undo .
     1667   define input parameter p-value-integer   like ub.dis-card-property.property-value-integer no-undo .
     1668   define input parameter p-value-logical   like ub.dis-card-property.property-value-logical no-undo .
     1669   define input parameter p-source-type     as character no-undo .
     1670   define input parameter p-source-ref      as character no-undo .
     1671   define input-output parameter p-chip-num as integer no-undo .
     1672   define input-output parameter p-corr-date as date no-undo .
     1673   define input-output parameter p-corr-time as integer no-undo .
     1674   do
     1675   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1676   :
     1677     define buffer buf_dis-card-property for ub.dis-card-property .
     1678     define buffer buf_dis-card for ub.dis-card.
     1679     define buffer buf_prop-ref for ub.prop-ref.
     1680     define variable v-data-type      as character no-undo .
     1681     define variable v-data-type-1    as character no-undo .
     1682     define variable v-format         as character no-undo .
     1683     define variable v-label          as character no-undo .
     1684     define variable v-range          as integer   no-undo .
     1685     define variable v-rw-option      as character no-undo .
     1686     run discprop-node-code in this-procedure
     1687       (
     1688        input  p-dtm-code
     1689       ,input  p-node-code
     1690       ,output v-data-type
     1691       ,output v-format
     1692       ,output v-label
     1693       ,output v-range
     1694       ,output v-rw-option
     1695       ) no-error .
     1696     if error-status :error then do:
     1697       undo, return error return-value .
     1698     end.
     1699     v-data-type-1 = entry(1, v-data-type).
     1700     if p-dt-code = ? then do:
     1701       find buf_prop-ref no-lock where
     1702           buf_prop-ref.dtm-code = p-dtm-code
     1703       and buf_prop-ref.sum-id = p-sum-id no-error.
     1704       if not available buf_prop-ref then do:
     1705         undo, return error substitute("Неопределен или неоднозначен ИТОГ/СРЕЗ для объекта-операнда &1 &2"
     1706                                       ,p-dtm-code
     1707                                       ,p-sum-id).
     1708       end.
     1709       assign
     1710       p-dt-code = buf_prop-ref.dt-code.
     1711     end.
     1712     if discprop-usercanedit ( input p-dtm-code, input g#db-num)  = no then do:
     1713       undo, return error "Нельзя редактировать свойство в данной БД".
     1714     end.
     1715     run discprop-check in this-procedure (
     1716                                             input v-range
     1717                                           ,input p-d-card
     1718                                           ,input p-host-code
     1719                                           ,input p-obj-type
     1720                                           ,input p-obj-code
     1721                                           ,input p-dtm-code
     1722                                           ,input p-node-code
     1723                                           ,input p-dt-code
     1724                                         ) no-error .
     1725     if error-status:error then undo,  return error return-value .
     1726     find first buf_dis-card-property exclusive-lock
     1727       where buf_dis-card-property.d-card    = p-d-card
     1728         and buf_dis-card-property.host-code = p-host-code
     1729         and buf_dis-card-property.obj-type  = p-obj-type
     1730         and buf_dis-card-property.obj-code  = p-obj-code
     1731         and buf_dis-card-property.dt-code = p-dt-code
     1732         and buf_dis-card-property.node-code = p-node-code
     1733       no-error .
     1734       find first buf_dis-card no-lock where
     1735                   buf_dis-card.d-card = p-d-card.
     1736     if not available buf_dis-card-property then do:
     1737       create buf_dis-card-property .
     1738       assign
     1739         buf_dis-card-property.d-card    = p-d-card
     1740         buf_dis-card-property.host-code = p-host-code
     1741         buf_dis-card-property.obj-type  = p-obj-type
     1742         buf_dis-card-property.obj-code  = p-obj-code
     1743         buf_dis-card-property.dt-code = p-dt-code
     1744         buf_dis-card-property.node-code = p-node-code
     1745         buf_dis-card-property.dtm-code = p-dtm-code
     1746         buf_dis-card-property.sum-id   = p-sum-id
     1747         buf_dis-card-property.card-num  = buf_dis-card.card-num
     1748         buf_dis-card-property.main-card  = buf_dis-card.main-card
     1749         buf_dis-card-property.first-card  = buf_dis-card.first-card
     1750         buf_dis-card-property.first-main-card  = buf_dis-card.first-main-card
     1751       .
     1752     end.
     1753     else do:
     1754       if (v-data-type-1 = 'character':U
     1755       and buf_dis-card-property.property-value-character = p-value-character)
     1756       or  (v-data-type-1 = 'date':U
     1757           and buf_dis-card-property.property-value-date = p-value-date)
     1758       or  (v-data-type-1 = 'decimal':U
     1759           and buf_dis-card-property.property-value-decimal = p-value-decimal)
     1760       or  (v-data-type-1 = 'integer':U
     1761           and buf_dis-card-property.property-value-integer = p-value-integer)
     1762       or  (v-data-type-1 = 'logical':U
     1763           and buf_dis-card-property.property-value-logical = p-value-logical)
     1764       then return.
     1765     end.
     1766     run disproph_write-dis-card-property-proc  in this-procedure (
     1767             buffer buf_dis-card-property
     1768             ,buffer Buf_dis-card
     1769             ,input p-d-card
     1770             ,input p-dt-code
     1771             ,input p-host-code
     1772             ,input p-obj-type
     1773             ,input p-obj-code
     1774             ,input p-dtm-code
     1775             ,input buf_dis-card.card-num
     1776             ,input buf_dis-card.main-card
     1777             ,input buf_dis-card.first-card
     1778             ,input buf_dis-card.first-main-card
     1779             ,input p-node-code
     1780             ,input (if new(buf_dis-card-property) then integer('1':U) else integer('2':U))
     1781             ,input p-source-type
     1782             ,input p-source-ref
     1783             ,input-output p-chip-num
     1784             ,input-output p-corr-date
     1785             ,input-output p-corr-time
     1786             ).
     1787     assign
     1788     buf_dis-card-property.property-value-character = (if v-data-type-1 = 'character':U
     1789                                                       then p-value-character
     1790                                                       else buf_dis-card-property.property-value-character)
     1791     buf_dis-card-property.property-value-date      = (if v-data-type-1 = 'date':U
     1792                                                       then p-value-date
     1793                                                       else buf_dis-card-property.property-value-date)
     1794     buf_dis-card-property.property-value-decimal   = (if v-data-type-1 = 'decimal':U
     1795                                                       then p-value-decimal
     1796                                                       else buf_dis-card-property.property-value-decimal)
     1797     buf_dis-card-property.property-value-integer   = (if v-data-type-1 = 'integer':U
     1798                                                       then p-value-integer
     1799                                                       else buf_dis-card-property.property-value-integer)
     1800     buf_dis-card-property.property-value-logical   = (if v-data-type-1 = 'logical':U
     1801                                                       then p-value-logical
     1802                                                       else buf_dis-card-property.property-value-logical)
     1803     buf_dis-card-property.trg-param = (if p-source-type = '':U then '':U else 'no-hist':U)
     1804     .
     1805     release buf_dis-card-property no-error .
     1806     if error-status:error then do:
     1807       return error return-value .
     1808     end.
     1809   end.
     1810   end procedure.
     1811   procedure discprop-delete :
     1812   define input parameter p-d-card    like ub.dis-card-property.d-card     no-undo .
     1813   define input parameter p-host-code like ub.dis-card-property.host-code  no-undo .
     1814   define input parameter p-obj-type  like ub.dis-card-property.obj-type   no-undo .
     1815   define input parameter p-obj-code  like ub.dis-card-property.obj-code   no-undo .
     1816   define input parameter p-dtm-code  like ub.dis-card-property.dtm-code   no-undo .
     1817   define input parameter p-node-code like ub.dis-card-property.node-code  no-undo .
     1818   define input parameter p-dt-code   like ub.dis-card-property.dt-code    no-undo .
     1819   define input parameter p-source-type as character no-undo .
     1820   define input parameter p-source-ref as character no-undo .
     1821   define output parameter p-deleted  as logical no-undo.
     1822   define input-output parameter p-chip-num as integer no-undo .
     1823   define input-output parameter p-corr-date as date no-undo .
     1824   define input-output parameter p-corr-time as integer no-undo .
     1825   do
     1826   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1827   :
     1828   define buffer buf_dis-card-property for ub.dis-card-property .
     1829   define buffer buf_dis-card for ub.dis-card.
     1830   define variable v-data-type      as character no-undo .
     1831   define variable v-format         as character no-undo .
     1832   define variable v-label          as character no-undo .
     1833   define variable v-range          as integer   no-undo .
     1834   define variable v-rw-option      as character   no-undo .
     1835     run discprop-node-code in this-procedure
     1836       (input  p-dtm-code
     1837       ,input  p-node-code
     1838       ,output v-data-type
     1839       ,output v-format
     1840       ,output v-label
     1841       ,output v-range
     1842       ,output v-rw-option
     1843       ) no-error .
     1844     if error-status :error then do:
     1845       undo, return error return-value .
     1846     end.
     1847     find first buf_dis-card-property exclusive-lock
     1848       where buf_dis-card-property.d-card    = p-d-card
     1849         and buf_dis-card-property.host-code = p-host-code
     1850         and buf_dis-card-property.obj-type  = p-obj-type
     1851         and buf_dis-card-property.obj-code  = p-obj-code
     1852         and buf_dis-card-property.dt-code = p-dt-code
     1853         and buf_dis-card-property.node-code = p-node-code
     1854       no-error NO-WAIT.
     1855     if not available buf_dis-card-property then do:
     1856       p-deleted = no.
     1857     end.
     1858     else do:
     1859       run disproph_write-dis-card-property-proc  in this-procedure (
     1860            buffer buf_dis-card-property
     1861           ,buffer buf_dis-card
     1862           ,input buf_dis-card-property.d-card
     1863           ,input buf_dis-card-property.dt-code
     1864           ,input buf_dis-card-property.host-code
     1865           ,input buf_dis-card-property.obj-type
     1866           ,input buf_dis-card-property.obj-code
     1867           ,input buf_dis-card-property.dtm-code
     1868           ,input buf_dis-card-property.card-num
     1869           ,input buf_dis-card-property.main-card
     1870           ,input buf_dis-card-property.first-card
     1871           ,input buf_dis-card-property.first-main-card
     1872           ,input buf_dis-card-property.node-code
     1873           ,input integer('99':U)
     1874           ,input p-source-type
     1875           ,input p-source-ref
     1876           ,input-output p-chip-num
     1877           ,input-output p-corr-date
     1878           ,input-output p-corr-time
     1879            ).
     1880       buf_dis-card-property.trg-param = (if p-source-type = '':U then '':U else 'no-hist':U).
     1881       delete buf_dis-card-property no-error .
     1882       if error-status:error then do:
     1883         return error return-value.
     1884       end.
     1885       p-deleted = yes.
     1886     end.
     1887   end.
     1888   end procedure.
     1889   procedure discprop-check :
     1890   define input parameter p-range  as integer no-undo .
     1891   define input parameter p-d-card like ub.dis-card-property.d-card no-undo .
     1892   define input parameter p-host-code like ub.dis-card-property.host-code no-undo .
     1893   define input parameter p-obj-type like ub.dis-card-property.obj-type no-undo .
     1894   define input parameter p-obj-code like ub.dis-card-property.obj-code no-undo .
     1895   define input parameter p-dtm-code like ub.dis-card-property.dtm-code no-undo .
     1896   define input parameter p-node-code like ub.dis-card-property.node-code no-undo .
     1897   define input parameter p-dt-code like ub.dis-card-property.dt-code no-undo .
     1898   define variable v-message as character no-undo .
     1899   define buffer buf_sysconf for ub.sysconf.
     1900   define buffer buf_clients for ub.clients.
     1901   define buffer buf_dis-card for ub.dis-card.
     1902   define buffer buf_attr-prop for ub.attr-prop.
     1903   do
     1904   on error undo, return error return-value
     1905   :
     1906     if p-host-code > 0 then do:
     1907       FIND FIRST buf_sysconf No-LOCK WHERE
     1908                 buf_sysconf.host-code = p-host-code No-ERROR.
     1909       IF NOT AVAIL buf_sysconf THEN DO:
     1910         v-message = substitute("Не найдена фирма &1", p-host-code).
     1911         RETURN ERROR v-message.
     1912       END.
     1913     end.
     1914     if p-obj-type <> "":U or
     1915         p-obj-code <> 0 then do:
     1916       find first buf_clients No-LOCK WHERE
     1917                 buf_clients.obj-type = p-obj-type AND
     1918                 buf_clients.obj-code = p-obj-code no-error .
     1919       if not available buf_clients then do:
     1920         v-message = substitute("Не найден объект &1&2", p-obj-type, p-obj-code).
     1921         RETURN ERROR v-message.
     1922       end.
     1923     end.
     1924     else if NOT (p-obj-type = "":U and p-obj-code = 0) then do:
     1925       v-message = substitute("Неверные значения параметров p-obj-type/p-obj-code и/или p-host-code: &1&2 &3"
     1926                               , p-obj-type
     1927                               , p-obj-code
     1928                               , p-host-code).
     1929       RETURN ERROR v-message.
     1930     end.
     1931     if p-d-card <> "":U then do:
     1932       find first buf_dis-card No-LOCK WHERE
     1933                   buf_dis-card.d-card = p-d-card No-ERROR.
     1934       if not avail buf_dis-card then do:
     1935         v-message =substitute("Не найдена ДК").
     1936         return error  v-message.
     1937       end.
     1938       if buf_dis-card.emitent-host-code <> 0
     1939       and p-host-code <> buf_dis-card.emitent-host-code then do:
     1940         v-message = substitute("Для фирменной карты свойство можно ввести только с привязкой к фирме-эмитенту").
     1941         return error v-message.
     1942       end.
     1943       if buf_dis-card.emitent-host-code = 0
     1944       and p-range = 1
     1945       and p-host-code <> 0 then do:
     1946         v-message = substitute("Для свойство с ОБЛАСТЬЮ ДЕЙСТВИЯ СОГЛАСНО КОДУ ЭМИТЕНТА&1" +
     1947                               "для ГЛОБАЛЬНОЙ карты можно ввести только ГЛОБАЛЬНОЕ свойство"
     1948                                 , chr(10)
     1949                               ).
     1950         return error v-message.
     1951       end.
     1952     end.
     1953   end.
     1954   end procedure.
