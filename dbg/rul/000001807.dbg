     2164   on delete of this-procedure do:
     2165     run delete-procedure in this-procedure .
     2166   end.
     2167   run load-ruleset-context in this-procedure ( input p-ruleset-id) no-error .
     2168   if error-status:error
     2169   or return-value = "return" then return.
     2170   if not this-procedure:persistent then do:
     2171     run proc-main in this-procedure ( input p-type
     2172                                 ,input p-emitent-host-code ) no-error .
     2173     if error-status:error then do:
     2174         run delete-procedure in this-procedure .
     2175         undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     2176     end.
     2177     run delete-procedure in this-procedure .
     2178   end.
     2179   procedure proc-main :
     2180   define input parameter p-type like ub.dis-card.type no-undo .
     2181   define input parameter p-emitent-host-code like ub.dis-card.emitent-host-code no-undo .
     2182   _main:
     2183   do
     2184   on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2185   on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
     2186   on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
     2187   :
     2188   assign
     2189   v-emitent-host-code = p-emitent-host-code
     2190   v-type = p-type.
     2191   run write-log  in p-log-handle (
     2192                                    input 0
     2193                                  , "&DLine").
     2194   run write-log-and-file in p-log-handle (
     2195         input 1
     2196       , input log-file-name
     2197       , input 1
     2198       , input substitute("Импорт стоплиста из файла &1", file-name)).
     2199   run gbl/filename.p (
     2200                    input  "exe/sibneft-stop-list.bas"
     2201                   ,output v-bas-full-path
     2202                   ,output v-path
     2203                   ,output v-file-name
     2204                   ,output v-file-name-no-ext
     2205                   ,output v-file-name-ext
     2206                   ) no-error .
     2207   if error-status:error  = ? then do:
     2208     run write-log-and-file in p-log-handle (
     2209           input 1
     2210         , input log-file-name
     2211         , input 1
     2212         , input substitute("Не найден МАКРОС для импорта стоплиста по ДК -  &1", "sibneft-stop-list.bas")).
     2213     assign
     2214     v-view-log = yes.
     2215     .
     2216     return error.
     2217   end.
     2218   run gbl/_tmpfile.p ( input ""
     2219                  , ".clients"
     2220                  , output v-txt-full-path) .
     2221   run gbl/_tmpfile.p ( input ""
     2222                  , ".discounts"
     2223                  , output v-txt-full-path2) .
     2224   run gbl/xlimport.p (
     2225         input v-full-path
     2226       , input v-txt-full-path + chr(44) + v-txt-full-path2
     2227       , input v-bas-full-path
     2228   ) no-error.
     2229   if error-status:error then do:
     2230     run write-log-and-file in p-log-handle (
     2231           input 1
     2232         , input log-file-name
     2233         , input 1
     2234         , input substitute("Ошибка при чтении из .xls файла&1&2&1&3"
     2235                           , chr(10)
     2236                           , error-status:get-message(1)
     2237                           , return-value
     2238                           )).
     2239     assign
     2240     v-view-log = yes.
     2241     .
     2242     return error.
     2243   end.
     2244   if search(v-txt-full-path) = ?
     2245   or search(v-txt-full-path2) = ? then do:
     2246     run write-log-and-file in p-log-handle (
     2247           input 1
     2248         , input log-file-name
     2249         , input 1
     2250         , input substitute("Не найдены результаты преобразования стоплиста в .txt вид&1&2&1&3"
     2251                           , chr(10)
     2252                           , error-status:get-message(1)
     2253                           , return-value
     2254                           )).
     2255     assign
     2256     v-view-log = yes.
     2257     .
     2258     return error.
     2259   end.
     2260   assign
     2261   file-name = v-txt-full-path.
     2262   output stream Instream to value(file-name) append.
     2263   put stream instream unformatted skip(1).
     2264   output stream Instream close.
     2265   run write-log  in p-log-handle(
     2266                                    input 0
     2267                                  , "&DLine").
     2268   run write-log-and-file in p-log-handle (
     2269         input 1
     2270       , input log-file-name
     2271       , input 1
     2272       , input substitute("Импорт стоплиста по ДК из файла &1", file-name)).
     2273   for each ext-product-code,
     2274       each buf_shop no-lock:
     2275     for each buf_dis-gds-rule no-lock where
     2276               buf_dis-gds-rule.gds-code = ext-product-code.gds-code
     2277           and buf_dis-gds-rule.obj-type = 'маг':U
     2278           and buf_dis-gds-rule.obj-code = buf_shop.obj-code
     2279           and buf_dis-gds-rule.discnt-role = 'pcnt-kat':U:
     2280       find first buf_dis-rule no-lock where
     2281                 buf_dis-rule.rule-num = buf_Dis-gds-rule.rule-num no-error.
     2282       if available buf_dis-rule then do:
     2283          for each term_dis-rule no-lock where
     2284                 term_dis-rule.upper-rule-num = buf_Dis-rule.rule-num:
     2285             find first temp-discounts no-lock where
     2286                       temp-discounts.obj-type = 'маг':U
     2287                   and temp-discounts.obj-code = buf_shop.obj-code
     2288                   and temp-discounts.gds-code = ext-product-code.gds-code
     2289                   and temp-discounts.dis-kat = term_dis-rule.dis-kat no-error.
     2290             if not available temp-discounts then do:
     2291               create temp-discounts.
     2292               assign
     2293               temp-discounts.obj-type = 'маг':U
     2294               temp-discounts.obj-code = buf_shop.obj-code
     2295               temp-discounts.gds-code = ext-product-code.gds-code
     2296               temp-discounts.dis-kat = term_dis-rule.dis-kat
     2297               temp-discounts.ext-code = ext-product-code.ext-code
     2298               temp-discounts.pos-type = buf_dis-gds-rule.pos-type
     2299               .
     2300             end.
     2301             assign
     2302             temp-discounts.discnt-value = term_dis-rule.discnt-value
     2303             temp-discounts.value-type = buf_dis-rule.value-type
     2304             .
     2305             release temp-discounts.
     2306          end.
     2307       end.
     2308     end.
     2309   end.
     2310   find first buf0_stop-list exclusive-lock where
     2311             buf0_stop-list.classif-type = 'dis-card':U
     2312           and buf0_stop-list.stop-list-code = v-current-doc-code  no-error .
     2313   if not available buf0_stop-list then do:
     2314     run write-log-and-file in p-log-handle (
     2315           input 1
     2316         , input log-file-name
     2317         , input 1
     2318         , input substitute("Не найден стоплист &1", v-current-doc-code)).
     2319     v-view-log = yes.
     2320     .
     2321   end.
