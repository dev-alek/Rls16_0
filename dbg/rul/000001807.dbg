     2333     my-lim-kr = ?
     2334     my-cli-stop-list-flag = ?
     2335     myproductcode = ?
     2336     mycarname = '':U
     2337     mycarnumber = '':U
     2338     myquota = ?
     2339     myaccounttype = ?
     2340     .
