     2589           my-mess = substitute("В импортируемом стоплисте встретилась карта &1 ДРУГОГО типа/эмитента: &2 эмитент &3&4" +
     2590                                "согласно параметрам импорта - пропускаем"
     2591                                , buf_dis-card.d-card
