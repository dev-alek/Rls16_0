     2210   procedure get-db-list-for-d-card2 :
     2211   define input parameter p-d-card as character no-undo .
     2212   define variable v-current-db-processed as logical no-undo .
     2213   define buffer buf_clients  for ub.clients.
     2214   define buffer buf_dis-obj for ub.dis-obj.
     2215   define buffer buf_temp-smart-route for temp-smart-route.
     2216     do
     2217     on error undo, return error return-value
     2218     :
     2219       for each buf_dis-obj no-lock where
     2220               buf_dis-obj.d-card = p-d-card,
     2221          first buf_clients no-lock where
     2222               buf_clients.obj-type = buf_dis-obj.obj-type
     2223           and buf_clients.obj-code = buf_dis-obj.obj-code
     2224       break by
     2225       buf_clients.db-num:
     2226         if first-of(buf_Clients.db-num) then do:
     2227           find first buf_temp-smart-route no-lock where
     2228                 buf_temp-smart-route.key-field = p-d-card
     2229             and buf_temp-smart-route.db-num = buf_clients.db-num
     2230                 no-error.
     2231           if available buf_temp-smart-route then return.
     2232           create buf_temp-smart-route.
     2233           assign
     2234           buf_temp-smart-route.key-field = p-d-card
     2235           buf_temp-smart-route.db-num = buf_clients.db-num
     2236           .
     2237           if buf_clients.db-num = g#db-num then do:
     2238             v-current-db-processed = yes.
     2239           end.
     2240         end.
     2241       end.
     2242       if not v-current-db-processed then do:
     2243         find first buf_temp-smart-route no-lock where
     2244               buf_temp-smart-route.key-field = p-d-card
     2245           and buf_temp-smart-route.db-num = g#db-num  no-error.
     2246         if not available buf_temp-smart-route then do:
     2247           create buf_temp-smart-route.
     2248           assign
