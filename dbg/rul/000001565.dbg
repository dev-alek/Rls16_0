     2456             buf_term-dis-rule.upper-rule-num = buf_dis-rule.rule-num:
     2457       if buf_term-dis-rule.tot-sum <= p-tot-sum then do:
     2458         if v-start
     2459         or v-delta  > (p-tot-sum - buf_term-dis-rule.tot-sum)
     2460         then do:
