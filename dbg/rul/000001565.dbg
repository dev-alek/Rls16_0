     2439   FUNCTION dis-rule_00020 returns decimal ( input p-rule-num as integer
     2440                                           , input p-date as date
     2441                                           , input p-time as integer
     2442                                           , input p-tot-sum as decimal
     2443                                           ):
     2444   define variable v-delta as decimal no-undo .
     2445   define variable v-start as logical no-undo init yes.
     2446   define variable v-discnt-value as decimal no-undo .
