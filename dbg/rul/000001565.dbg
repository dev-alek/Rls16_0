     2702   buf_rule-call-param.codex_id = p-codex-id
     2703   and buf_rule-call-param.ruleset_id = p-ruleset-id
     2704   and buf_rule-call-param.call_id = p-call-id
     2705   and buf_rule-call-param.order_id = p-order-id
     2706   and buf_rule-call-param.rule_id = p-rule-id
     2707   and buf_rule-call-param.param-name = "p-r-b"
     2708    no-error.
     2709   if available buf_rule-call-param then do:
     2710   assign p-r-b = buf_rule-call-param.param-value-character.
     2711   end.
     2712    find first buf_rule-call-param no-lock where
     2713   buf_rule-call-param.codex_id = p-codex-id
     2714   and buf_rule-call-param.ruleset_id = p-ruleset-id
     2715   and buf_rule-call-param.call_id = p-call-id
     2716   and buf_rule-call-param.order_id = p-order-id
     2717   and buf_rule-call-param.rule_id = p-rule-id
     2718   and buf_rule-call-param.param-name = "p-rule-num"
     2719    no-error.
     2720   if available buf_rule-call-param then do:
     2721   assign p-rule-num = buf_rule-call-param.param-value-integer.
     2722   end.
     2723       assign
     2724       vh_dis-card-sale_obj = buffer temp-d-card:handle
     2725       v-save = p-save
     2726       v-current-doc-type = p-doc-type
     2727       .
     2728       case p-ruleset-id:
     2729         when 1 then do:
     2730           assign
     2731           v-sign = 1
     2732           v-current-host-code = p-host-code
     2733           v-current-obj-type = p-obj-type
     2734           v-current-obj-code = p-obj-code
     2735           v-current-db-num = g#db-num
     2736           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     2737           v-current-doc-code = p-doc-code
     2738           v-current-doc-date = p-doc-date
     2739           v-current-doc-fact-date = p-fact-date
     2740           v-current-date = p-doc-date
     2741           v-current-fact-date = p-fact-date
     2742           .
     2743         end.
     2744         when 2 then do:
     2745           assign
     2746           v-sign = -1
     2747           v-current-host-code = p-host-code
     2748           v-current-obj-type = p-obj-type
     2749           v-current-obj-code = p-obj-code
     2750           v-current-db-num = g#db-num
     2751           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     2752           v-current-doc-code = p-doc-code
     2753           v-current-doc-date = p-doc-date
     2754           v-current-doc-fact-date = p-fact-date
     2755           v-current-date = p-doc-date
     2756           v-current-fact-date = p-fact-date
     2757           .
     2758         end.
     2759         when 3 or
     2760         when 6 then do:
     2761           assign
     2762           v-sign = 1
     2763           v-current-host-code = p-host-code
     2764           v-current-obj-type = p-obj-type
     2765           v-current-obj-code = p-obj-code
     2766           v-current-db-num = g#db-num
     2767           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     2768           v-current-doc-code = p-doc-code
     2769           v-current-doc-date = p-doc-date
     2770           v-current-doc-time = 0
     2771           v-current-doc-fact-date = p-fact-date
     2772           v-current-date = p-doc-date
     2773           v-current-fact-date = p-fact-date
     2774           .
     2775         end.
     2776         when 4 then do:
     2777           assign
     2778           v-sign = -1
     2779           v-current-host-code = p-host-code
     2780           v-current-obj-type = p-obj-type
     2781           v-current-obj-code = p-obj-code
     2782           v-current-db-num = g#db-num
     2783           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     2784           v-current-doc-code = p-doc-code
     2785           v-current-doc-date = p-doc-date
     2786           v-current-doc-time = 0
     2787           v-current-doc-fact-date = p-fact-date
     2788           v-current-date = p-doc-date
     2789           v-current-fact-date = p-fact-date
     2790           .
     2791         end.
     2792         when 5 then do:
     2793           assign
     2794           v-sign = 1
     2795           v-current-host-code = p-host-code
     2796           v-current-obj-type = p-obj-type
     2797           v-current-obj-code = p-obj-code
     2798           v-current-db-num = g#db-num
     2799           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     2800           v-current-doc-code = p-doc-code
     2801           v-current-doc-date = p-doc-date
     2802           v-current-doc-time = 0
     2803           v-current-doc-fact-date = p-fact-date
     2804           v-current-date = p-doc-date
     2805           v-current-fact-date = p-fact-date
     2806           .
     2807         end.
     2808         when 7
     2809         or when 9
     2810         then do:
     2811           assign
     2812           v-sign = 1
     2813           v-current-host-code = p-host-code
     2814           v-current-obj-type = p-obj-type
     2815           v-current-obj-code = p-obj-code
     2816           v-current-db-num = g#db-num
     2817           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     2818           v-current-doc-code = p-doc-code
     2819           v-current-doc-date = p-doc-date
     2820           v-current-doc-time = 0
     2821           v-current-doc-fact-date = p-fact-date
     2822           v-current-date = p-doc-date
     2823           v-current-fact-date = p-fact-date
     2824           .
     2825         end.
     2826       end case.
     2827     end.
     2828   end procedure.
     2829   procedure delete-procedure :
     2830     do
     2831     on error undo, return error
     2832     :
     2833         run garbcoll_clear in this-procedure .
     2834     end.
     2835   end procedure.
