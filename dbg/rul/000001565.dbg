     1213   def var vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1214   procedure get-gate-file-name :
     1215   define input parameter p-gate-rec as character no-undo .
     1216   define output  parameter p-gate-file-name as character no-undo .
     1217   define buffer buf_clob-data for ub.clob-data.
     1218   define variable v-tbl-row as rowid no-undo .
     1219   define variable v-tbl-name as character no-undo .
     1220   run gen-row-keyr in this-procedure ( input p-gate-rec
     1221                                       ,input ?
     1222                                       ,input "ub"
     1223                                       ,input ?
     1224                                       ,input no-lock
     1225                                       ,output v-tbl-row
     1226                                       ,output v-tbl-name) no-error.
     1227   if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     1228                                                           ,vss-include-info13
     1229                                                           ,p-gate-rec).
     1230   find first buf_clob-data no-lock where
     1231             rowid(buf_clob-data) = v-tbl-row no-error.
     1232   if not available buf_clob-data then do:
     1233     if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     1234                                                             ,vss-include-info13
     1235                                                             ,p-gate-rec).
     1236   end.
     1237   p-gate-file-name = buf_clob-data.file-name.
     1238   end procedure.
     1239   procedure get-gate-rec :
     1240   define input  parameter p-gate-name as character no-undo .
     1241   define output parameter p-gate-rec as character no-undo .
     1242   define buffer buf_clob-bind for ub.clob-bind.
     1243   define buffer buf_clob-data for ub.clob-data.
     1244   main-block:
     1245   do
     1246   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info13, return-value, chr(10), error-status :get-message (1))
     1247   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info13 )
     1248   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info13 )
     1249   :
     1250       find first buf_clob-bind no-lock where
     1251                 buf_clob-bind.uniq-key-rec = p-gate-name
     1252             and buf_clob-bind.field-name = '':U
     1253             and buf_clob-bind.part-num = 1
     1254             and buf_clob-bind.resource-type = 'gate':U
     1255             no-error.
     1256       if not available buf_clob-bind then do:
     1257         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     1258                                         , p-gate-name
     1259                                         ).
     1260       end.
     1261       find first buf_clob-data no-lock where
     1262                 buf_clob-data.db-num = buf_clob-bind.db-num
     1263             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     1264       if not available buf_clob-data then do:
     1265         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1266                                         , buf_clob-bind.db-num
     1267                                         , buf_clob-bind.int64-id
     1268                                         , p-gate-name
     1269                                         ).
     1270       end.
     1271       run gen-key-rec in this-procedure ( input 'clob-data':U
     1272                                 ,input buffer buf_clob-data:handle
     1273                                 ,output p-gate-rec).
     1274   end.
     1275   end procedure.
     1276   procedure get-gate-by-name :
     1277   define input  parameter p-gate-name as character no-undo .
     1278   define output parameter p-gate-rec as character no-undo .
     1279   define output parameter p-dsh as handle no-undo .
     1280   define input-output  parameter p-xmlh as handle no-undo .
     1281   define variable v-ii as integer   no-undo .
     1282   define variable glog as logical   no-undo .
     1283   define variable v-longchar as longchar no-undo .
     1284   define variable v-txmlh as handle no-undo .
     1285   define variable v-db-num as integer no-undo .
     1286   define variable v-int64-id as int64 no-undo .
     1287   define buffer buf_clob-bind for ub.clob-bind.
     1288   define buffer buf_clob-data for ub.clob-data.
     1289   main-block:
     1290   do
     1291   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info13, return-value, chr(10), error-status :get-message (1))
     1292   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info13 )
     1293   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info13 )
     1294   :
     1295       find first buf_clob-bind no-lock where
     1296                 buf_clob-bind.uniq-key-rec = p-gate-name
     1297             and buf_clob-bind.field-name = '':U
     1298             and buf_clob-bind.part-num = 1
     1299             and buf_clob-bind.resource-type = 'gate':U
     1300             no-error.
     1301       if not available buf_clob-bind then do:
     1302         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     1303                                         , p-gate-name
     1304                                         ).
     1305       end.
     1306       find first buf_clob-data no-lock where
     1307                 buf_clob-data.db-num = buf_clob-bind.db-num
     1308             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     1309       if not available buf_clob-data then do:
     1310         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1311                                         , buf_clob-bind.db-num
     1312                                         , buf_clob-bind.int64-id
     1313                                         , p-gate-name
     1314                                         ).
     1315       end.
     1316       assign
     1317       v-longchar = buf_clob-data.cdata
     1318       .
     1319       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1320       if error-status :error then do:
     1321         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1322       end.
     1323       create dataset p-dsh .
     1324       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1325                                     , v-longchar
     1326                                     , ?
     1327                                     , ?
     1328                                     , ?
     1329                                     ) no-error.
     1330       v-longchar = '':U.
     1331       if error-status :error
     1332       or not glog
     1333       then do:
     1334         undo, return error substitute("Не удалось прочитать XML-схему &1 из БД:&2&3", p-gate-name, chr(10), error-status:get-message(1) ).
     1335       end.
     1336       if not valid-handle(p-xmlh)
     1337       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1338         create temp-table v-txmlh.
     1339         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1340         v-txmlh:temp-table-prepare("temp-xml-tables").
     1341         p-xmlh = v-txmlh:default-buffer-handle.
     1342       end.
     1343       run gen-key-rec in this-procedure ( input 'clob-data':U
     1344                                 ,input buffer buf_clob-data:handle
     1345                                 ,output p-gate-rec).
     1346       do v-ii = 1 to p-dsh:num-buffers:
     1347         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1348         if not p-xmlh:available then do:
     1349           p-xmlh:buffer-create().
     1350           assign
     1351           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1352           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1353           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1354           p-xmlh::gate-handle_ = p-dsh
     1355           p-xmlh::uniq-gate-rec = p-gate-rec
     1356           p-xmlh::gate-name = p-dsh:name
     1357           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1358           .
     1359           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1360             assign
     1361             p-xmlh::order = -3.
     1362           end.
     1363         end.
     1364       end.
     1365   end.
     1366   end procedure.
     1367   procedure get-gate-by-rec :
     1368   define input  parameter p-gate-rec as character no-undo .
     1369   define output parameter p-dsh as handle no-undo .
     1370   define input-output  parameter p-xmlh as handle no-undo .
     1371   define input-output parameter p-longchar  as longchar no-undo .
     1372   define variable v-ii as integer   no-undo .
     1373   define variable glog as logical   no-undo .
     1374   define variable v-rowid as rowid no-undo .
     1375   define variable v-tbl-name as character no-undo .
     1376   define variable v-longchar as longchar no-undo .
     1377   define variable v-txmlh as handle no-undo .
     1378   define buffer buf_clob-data for ub.clob-data.
     1379   main-block:
     1380   do
     1381   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info13, return-value, chr(10), error-status :get-message (1))
     1382   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info13 )
     1383   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info13 )
     1384   :
     1385     run gen-row-keyr in this-procedure (
     1386                                           input  p-gate-rec
     1387                                           ,input  ?
     1388                                           ,input  "ub"
     1389                                           ,input  ?
     1390                                           ,input  NO-LOCK
     1391                                           ,output v-rowid
     1392                                           ,output v-tbl-name   ) no-error.
     1393       find first buf_clob-data no-lock where
     1394                 rowid(buf_clob-data) = v-rowid  no-error.
     1395       if not available buf_clob-data then do:
     1396         undo, return error substitute("Не найден CLOB  &1"
     1397                                         , p-gate-rec
     1398                                         ).
     1399       end.
     1400       assign
     1401       v-longchar = buf_clob-data.cdata
     1402       .
     1403       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1404       if error-status :error then do:
     1405         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1406       end.
     1407       create dataset p-dsh .
     1408       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1409                                     , v-longchar
     1410                                     , ?
     1411                                     , ?
     1412                                     , ?
     1413                                     ) no-error.
     1414       define variable v-esm as character no-undo .
     1415       v-esm = error-status:get-message(1) .
     1416       if p-longchar <> ? then do:
     1417         p-longchar = v-longchar.
     1418       end.
     1419       v-longchar = '':U.
     1420       if error-status :error
     1421       or not glog
     1422       then do:
     1423         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     1424                                      , p-gate-rec
     1425                                      , p-gate-rec
     1426                                      , v-esm
     1427                                      ).
     1428       end.
     1429       p-dsh:private-data = buf_clob-data.file-name_ + chr(4) + p-gate-rec.
     1430       if not valid-handle(p-xmlh)
     1431       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1432         create temp-table v-txmlh.
     1433         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1434         v-txmlh:temp-table-prepare("temp-xml-tables").
     1435         p-xmlh = v-txmlh:default-buffer-handle.
     1436       end.
     1437       do v-ii = 1 to p-dsh:num-buffers:
     1438         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1439         if not p-xmlh:available then do:
     1440           p-xmlh:buffer-create().
     1441           assign
     1442           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1443           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1444           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1445           p-xmlh::gate-handle_ = p-dsh
     1446           p-xmlh::uniq-gate-rec = p-gate-rec
     1447           p-xmlh::gate-name = p-dsh:name
     1448           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1449           .
     1450           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1451             assign
     1452             p-xmlh::order = -3.
     1453           end.
     1454           p-xmlh:buffer-release().
     1455         end.
     1456       end.
     1457   end.
     1458   end procedure.
     1459   procedure get-gate-by-file :
     1460   define input  parameter p-schema-file-name as character no-undo .
     1461   define input  parameter p-gate-rec as character no-undo .
     1462   define output parameter p-dsh as handle no-undo .
     1463   define input-output  parameter p-xmlh as handle no-undo .
     1464   define variable v-ii as integer   no-undo .
     1465   define variable glog as logical   no-undo .
     1466   define variable v-rowid as rowid no-undo .
     1467   define variable v-tbl-name as character no-undo .
     1468   define variable v-longchar as longchar no-undo .
     1469   define variable v-txmlh as handle no-undo .
     1470   main-block:
     1471   do
     1472   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info13, return-value, chr(10), error-status :get-message (1))
     1473   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info13 )
     1474   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info13 )
     1475   :
     1476       COPY-LOB
     1477       FROM  FILE p-schema-file-name
     1478       TO  OBJECT v-longchar
     1479       no-convert
     1480       NO-ERROR .
     1481       if error-status :error then do:
     1482           undo, return error substitute("Не удалось считать файл схемы &1 в память&2&3"
     1483                                     , p-schema-file-name
     1484                                 , chr(10)
     1485                                 , error-status:get-message(1) ).
     1486       end.
     1487       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1488       if error-status :error then do:
     1489         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, p-schema-file-name, chr(10), error-status:get-message(1) , return-value ).
     1490       end.
     1491       create dataset p-dsh .
     1492       glog = p-dsh:READ-XMLSCHEMA( "longchar"
     1493                                     , v-longchar
     1494                                     , ?
     1495                                     , ?
     1496                                     , ?
     1497                                     ) no-error.
     1498       v-longchar = ''.
     1499       if error-status :error
     1500       or not glog
     1501       then do:
     1502         undo, return error substitute("Не удалось прочитать XML-схему из файла &1&2&3"
     1503                                      , p-schema-file-name
     1504                                      ,chr(10)
     1505                                      , error-status:get-message(1)
     1506                                      ).
     1507       end.
     1508       if not valid-handle(p-xmlh)
     1509       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1510         create temp-table v-txmlh.
     1511         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1512         v-txmlh:temp-table-prepare("temp-xml-tables").
     1513         p-xmlh = v-txmlh:default-buffer-handle.
     1514       end.
     1515       do v-ii = 1 to p-dsh:num-buffers:
     1516         p-xmlh:find-first(substitute(' where tbl-name = "&1" and  uniq-gate-rec = "&2" '
     1517                                      ,p-dsh:get-buffer-handle(v-ii):name
     1518                                      ,p-gate-rec
     1519                                      )) no-error.
     1520         if not p-xmlh:available then do:
     1521           p-xmlh:buffer-create().
     1522           assign
     1523           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):table
     1524           p-xmlh::uniq-gate-rec = p-gate-rec
     1525           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1526           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1527           p-xmlh::gate-handle_ = p-dsh
     1528           p-xmlh::gate-name = p-dsh:name
     1529           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1530           .
     1531           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1532             assign
     1533             p-xmlh::order = -3.
     1534           end.
     1535           p-xmlh:buffer-release().
     1536         end.
     1537       end.
     1538   end.
     1539   end procedure.
     1540   procedure gate-clear :
     1541   define input  parameter p-dsh as handle no-undo .
     1542   define input  parameter p-xmlh as handle no-undo .
     1543   define variable v-dsh as handle no-undo .
     1544   define variable v-th as handle no-undo .
     1545     do
     1546     on error undo, return error return-value
     1547     :
     1548       if valid-handle(p-dsh) then do:
     1549         delete object p-dsh.
     1550         v-dsh = p-dsh.
     1551         p-dsh = ?.
     1552       end.
     1553       repeat while true:
     1554         p-xmlh:find-first( substitute( " where gate-handle_ = &1 ", v-dsh)
     1555                            , share-lock) no-error.
     1556         if p-xmlh:available then do:
     1557           assign
     1558           v-th = p-xmlh:buffer-field("table-handle_"):buffer-value.
     1559           if valid-handle(p-xmlh:buffer-field("table-handle_"))
     1560           and valid-handle(v-th)
     1561           and v-th:dynamic = yes
     1562           then do:
     1563             delete object p-xmlh:buffer-field("table-handle_"):buffer-value.
     1564             p-xmlh:buffer-field("table-handle_"):buffer-value = ?.
     1565           end.
     1566           p-xmlh:buffer-delete().
     1567         end.
     1568         else do:
     1569           leave.
     1570         end.
     1571       end.
     1572       if p-xmlh:dynamic = yes
     1573       and valid-handle(p-xmlh)
     1574       then do:
     1575         delete object p-xmlh:table-handle.
     1576         p-xmlh = ?.
     1577       end.
     1578       v-dsh = ?.
     1579     end.
     1580   end procedure.
     1581   procedure all-gates-clear :
     1582   define parameter buffer buf_temp-xml-tables for temp-xml-tables.
     1583   do
     1584   on error undo, return error
     1585   :
     1586     for each buf_temp-xml-tables
     1587     break
     1588     by buf_temp-xml-tables.uniq-gate-rec
     1589     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1590     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1591     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1592     :
     1593         if first-of(buf_temp-xml-tables.uniq-gate-rec) then do:
     1594           delete object buf_temp-xml-tables.gate-handle_.
     1595           buf_temp-xml-tables.gate-handle_ = ?.
     1596         end.
     1597         if valid-handle(buf_temp-xml-tables.table-handle_)
     1598         and buf_temp-xml-tables.table-handle_:dynamic = no
     1599         then do:
     1600           delete object buf_temp-xml-tables.table-handle_.
     1601           buf_temp-xml-tables.table-handle_ = ?.
     1602         end.
     1603         delete buf_temp-xml-tables.
     1604     end.
     1605   end.
     1606   end procedure.
     1607   procedure fix-schemalocation :
     1608   define input-output  parameter p-longchar as longchar no-undo .
     1609   DEFINE VARIABLE hdoc AS HANDLE.
     1610   DEFINE VARIABLE hroot AS HANDLE.
     1611   DEFINE VARIABLE hnode-child AS HANDLE.
     1612   DEFINE VARIABLE hnode-attr AS HANDLE.
     1613   define variable v-jj as integer   no-undo .
     1614   define variable ok as logical   no-undo .
     1615   define variable v-path1                    as character                no-undo .
     1616   DEFINE VARIABLE v-full-path1               as character                no-undo .
     1617   DEFINE VARIABLE v-file-name1               as character                no-undo .
     1618   DEFINE VARIABLE v-file-name-no-ext1        as character                no-undo .
     1619   DEFINE VARIABLE v-file-name-ext1           as character                no-undo .
     1620   define variable v-schema-location          as character                no-undo .
     1621   do
     1622   on error undo, return error return-value
     1623   :
     1624     CREATE X-DOCUMENT hdoc.
     1625     CREATE X-noderef hroot.
     1626     CREATE X-noderef hnode-child.
     1627     CREATE X-noderef hnode-attr.
     1628     hdoc:load("longchar", p-longchar, no) no-error.
     1629     iF ERROR-STATUS:GET-MESSAGE(1) <> '' THEN message ERROR-STATUS:GET-MESSAGE(1) view-as alert-box .
     1630     hdoc:get-document-element(hroot).
     1631     _repeat:
     1632     REPEAT v-jj = 1 TO hroot:NUM-CHILDREN:
     1633       ok = hroot:GET-CHILD(hNode-Child, v-jj).
     1634       if not ok then next.
     1635       if hNode-Child:local-name = "include"
     1636       then do:
     1637         ok = hNode-Child:GET-ATTRIBUTE-NODE( hnode-attr, "schemaLocation" ).
     1638           v-schema-location = hnode-attr:node-value.
     1639           run gbl/filename.p (
     1640                           input "exe/" + hnode-attr:node-value
     1641                         ,output v-full-path1
     1642                         ,output v-path1
     1643                         ,output v-file-name1
     1644                         ,output v-file-name-no-ext1
     1645                         ,output v-file-name-ext1
     1646                         ) no-error .
     1647           if error-status :error then do:
     1648             delete object hnode-attr.
     1649             delete object hnode-child.
     1650             delete object hroot.
     1651             delete object hdoc.
     1652             undo, return error substitute("Не удалось определить расположение схемы &1", v-schema-location).
     1653           end.
     1654         ok = hNode-Child:sET-ATTRIBUTE(  "schemaLocation", v-full-path1 ).
     1655         leave  _repeat.
     1656       end.
     1657     END.
     1658     hdoc:save("longchar", p-longchar).
     1659     delete object hnode-attr.
     1660     delete object hnode-child.
     1661     delete object hroot.
     1662     delete object hdoc.
     1663   end.
     1664   end procedure.
     1665   procedure gate-clb_fill-xml-tables :
     1666   define input parameter p-dsh as handle no-undo .
     1667   define input-output parameter p-xmlh as handle no-undo .
     1668   define variable v-ii as integer no-undo .
     1669     do
     1670     on error undo, return error
     1671     :
     1672       do v-ii = 1 to p-dsh:num-buffers:
     1673         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1674         if not p-xmlh:available then do:
     1675           p-xmlh:buffer-create().
     1676           assign
     1677           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1678           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1679           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1680           p-xmlh::gate-handle_ = p-dsh
     1681           p-xmlh::uniq-gate-rec = entry(2, p-dsh:private-data, chr(4))
     1682           p-xmlh::gate-name = p-dsh:name
     1683           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1684           .
     1685           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1686             assign
     1687             p-xmlh::order = -3.
     1688           end.
     1689           p-xmlh:buffer-release().
     1690         end.
     1691       end.
     1692     end.
     1693   end procedure.
     1694   procedure all-gates-empty :
     1695   define buffer buf_temp-xml-tables for temp-xml-tables.
     1696   do
     1697   on error undo, return error
     1698   :
     1699     for each buf_temp-xml-tables
     1700     break
     1701     by buf_temp-xml-tables.uniq-gate-rec
     1702     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1703     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1704     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1705     :
     1706       if valid-handle(buf_temp-xml-tables.tbl-handle_) then do:
     1707         buf_temp-xml-tables.tbl-handle_:empty-temp-table().
     1708       end.
     1709     end.
     1710   end.
     1711   end procedure.
     1712   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1713   define variable v-current-d-card as character no-undo .
     1714   define variable v-current-host-code as integer no-undo .
     1715   define variable v-current-obj-type as character no-undo .
     1716   define variable v-current-obj-code as integer no-undo .
     1717   define variable v-current-lock as integer no-undo .
     1718   define variable v-current-wait as integer no-undo .
     1719   define variable v-save as integer no-undo .
     1720   define variable v-current-db-num as integer no-undo .
     1721   define variable v-current-doc-code as character no-undo .
     1722   define variable v-current-doc-date as date no-undo .
     1723   define variable v-current-doc-time as integer no-undo .
     1724   define variable v-current-doc-fact-date as date no-undo .
     1725   define variable v-current-date as date no-undo .
     1726   define variable v-current-fact-date as date no-undo .
     1727   define variable v-current-doc-type as character no-undo .
     1728   define variable v-last-error-message as character no-undo .
     1729   define variable v-emitent-host-code as integer no-undo .
     1730   define variable v-type as character no-undo .
     1731   define variable v-esys-cmd-proc-handle as handle no-undo .
     1732   define variable v-esys-cmd-code as integer no-undo .
     1733   define variable v-sign as integer no-undo .
     1734   define variable num-rec as integer no-undo .
     1735   define variable num-rec-calc-err as integer no-undo .
     1736   define variable num-rec-value-err as integer no-undo .
     1737   define variable num-rec-ok as integer no-undo .
     1738   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1739   procedure set-error :
     1740   define input parameter p-mess as character no-undo .
     1741     do
     1742     on error undo, return error
     1743     :
     1744        assign
     1745        v-last-error-message = p-mess.
     1746     end.
     1747   end procedure.
     1748   define temp-table temp-rule-call-param no-undo like ub.rule-call-param.
     1749   define buffer buf_temp-rule-call-param for temp-rule-call-param.
     1750   define buffer buf_temp-cmd for temp-cmd.
     1751   define buffer buf_dis-card-sale_obj for temp-d-card.
     1752   define variable vh_dis-card-sale_obj as handle no-undo .
     1753    define variable p-r-b as character no-undo.
     1754    define variable p-rule-num as integer no-undo.
     1755   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1756   procedure discardh_write-dis-card-rul  :
     1757   define parameter buffer buf_dis-card for ub.dis-card .
     1758   define input parameter p-type as character no-undo .
     1759   define input parameter p-emitent-host-code as integer no-undo .
     1760   define input parameter p-action as integer no-undo .
     1761   define variable v-date as date      no-undo.
     1762   define variable v-time  as integer   no-undo.
     1763   define variable v-rec-ord1 as integer no-undo .
     1764   define variable v-rec-ord2 as integer no-undo .
     1765   define variable v-rec-ord3 as integer no-undo .
     1766   define variable v-rec-hno as integer no-undo .
     1767   define buffer buf_c-dc-hist for ub.c-dc-hist.
     1768   define buffer buf_c-dis-card for ub.c-dis-card.
     1769   define buffer buf_temp-hist-nws-option for temp-hist-nws-option.
     1770   define buffer last_temp-hist-nws-option for temp-hist-nws-option.
     1771   do
     1772   on error undo, return error
     1773   :
     1774     if not available buf_dis-card then do:
     1775       message
     1776         vss-workfile vss-revision vss-description skip
     1777         "Ошибка задания входных параметров" skip
     1778         "Не определена ДК" skip
     1779         view-as alert-box error .
     1780       undo, return error .
     1781     end.
     1782     find first buf_temp-hist-nws-option where
     1783               buf_temp-hist-nws-option.table-name = 'dis-card':U
     1784           and buf_temp-hist-nws-option.db-num = g#db-num
     1785           and buf_temp-hist-nws-option.key#_one = 2
     1786           and buf_temp-hist-nws-option.charkey_one = p-type
     1787           and buf_temp-hist-nws-option.host-code = p-emitent-host-code no-error .
     1788     if not available buf_temp-hist-nws-option then do:
     1789       find first last_temp-hist-nws-option where
     1790                last_temp-hist-nws-option.db-num = g#db-num
     1791             and last_temp-hist-nws-option.hn-id < 0 no-error.
     1792       create buf_temp-hist-nws-option.
     1793       assign
     1794       buf_temp-hist-nws-option.db-num = g#db-num
     1795       buf_temp-hist-nws-option.hn-id = (if available last_temp-hist-nws-option
     1796                                   then - (abs(last_temp-hist-nws-option.hn-id) + 1)
     1797                                   else -1 )
     1798       buf_temp-hist-nws-option.table-name = 'dis-card':U
     1799       buf_temp-hist-nws-option.key#_one = 2
     1800       buf_temp-hist-nws-option.charkey_one = p-type
     1801       buf_temp-hist-nws-option.host-code = p-emitent-host-code
     1802       buf_temp-hist-nws-option.smart-nws = integer('-1':U)
     1803       .
     1804   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1805   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option-record in g#lib-nws
     1806     (input  g#db-num
     1807     ,input  buffer buf_temp-hist-nws-option:handle
     1808     )  .
     1809     end.
     1810     if not g#news
     1811     and buf_temp-hist-nws-option.hist-from-prim < 0 then do:
     1812       return.
     1813     end.
     1814     if g#news
     1815     and buf_temp-hist-nws-option.nws-to-hist < 0 then do:
     1816       return.
     1817     end.
     1818     run cur-time in this-procedure(output v-date, output v-time).
     1819     create buf_c-dis-card.
     1820     buffer-copy buf_dis-card to buf_c-dis-card
     1821     assign
     1822     buf_c-dis-card.d-card             = buf_dis-card.d-card
     1823     buf_c-dis-card.card-num           = buf_dis-card.card-num
     1824     buf_c-dis-card.chip-num           = next-value (s-dc-chip, ub)
     1825     buf_c-dis-card.corr-time          = v-time
     1826     buf_c-dis-card.corr-user-db-num   = g#db-num
     1827     buf_c-dis-card.corr-user-name     = (if g#news
     1828                                           then (chr(4) +  'СПН':U)
     1829                                           else (if g#esys
     1830                                                 then (chr(4) +  'ВС':U)
     1831                                                 else g#userid
     1832                                               )
     1833                                           )
     1834     buf_c-dis-card.corr-date          = v-date
     1835     .
     1836     create buf_c-dc-hist.
     1837     buffer-copy buf_c-dis-card to buf_c-dc-hist
     1838     assign
     1839     buf_c-dc-hist.action =  p-action
     1840     buf_c-dc-hist.subject = 'dis-card':U
     1841     buf_c-dc-hist.host-code =  buf_dis-card.emitent-host-code
     1842     buf_c-dc-hist.is-news = g#news
     1843     buf_c-dc-hist.source-type = p-doc-type
     1844     buf_c-dc-hist.source-ref = (if p-doc-type = '':U
     1845                                  then '':U
     1846                                  else p-doc-code)
     1847     .
     1848     if g#db-num > 0
     1849     or (g#db-num = 0
     1850         and buf_temp-hist-nws-option.hist-to-nws >= 0)
     1851     then do:
     1852       run add-dump in p-cmd-proc-handle                                                                           (input p-cmd-code                                                                                         ,input 'c-dis-card':U                                                                                          ,input '+update'                                                                                         ,input buffer buf_c-dis-card:handle                                                                                    ,input ''                                                                                         ,output v-rec-ord2                                                                                         ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                     delete procedure p-cmd-proc-handle .                                                                        undo , return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'c-dis-card':U                                                                                                ,p-cmd-code                                                                                               ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
     1853       run add-dump in p-cmd-proc-handle                                                                           (input p-cmd-code                                                                                         ,input 'c-dc-hist':U                                                                                          ,input '+update'                                                                                         ,input buffer buf_c-dc-hist:handle                                                                                    ,input ''                                                                                         ,output v-rec-ord3                                                                                         ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                     delete procedure p-cmd-proc-handle .                                                                        undo , return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'c-dc-hist':U                                                                                                ,p-cmd-code                                                                                               ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
     1854       if g#db-num = 0 then do:
     1855         run create-smart-route-link in this-procedure ( input 'c-dis-card':U
     1856                                                       ,input buffer buf_c-dis-card:handle
     1857                                                       ,input buf_dis-card.d-card
     1858                                                       ,input v-rec-ord2
     1859                                                       ,input no
     1860                                                       ).
     1861         run create-smart-route-link in this-procedure ( input 'c-dc-hist':U
     1862                                                       ,input buffer buf_c-dc-hist:handle
     1863                                                       ,input buf_dis-card.d-card
     1864                                                       ,input v-rec-ord3
     1865                                                       ,input no
     1866                                                       ).
     1867         run create-smart-route in this-procedure  ( input buf_dis-card.d-card
     1868                                                   ,input -1).
     1869       end.
     1870     end.
     1871   end.
     1872   end procedure.
     1873   procedure discardh_send-dis-card-rul  :
