     2453   and (buf_Dis-rule.time-templ-rl-root <= 50000 or dynamic-function( "dis-time-rule_" + string(buf_dis-rule.time-templ-rl-root - 50000, "99999")                                        , input buf_dis-rule.time-rule-num                                         , input p-date                                        , input p-time ))
     2454   then do:
