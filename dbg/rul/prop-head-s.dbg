        1   DEFINE BUFFER X_prop-head FOR ub.prop-head.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter bttns as character no-undo.
        4   DEFINE INPUT PARAMETER p-list-mode AS CHARACTER NO-UNDO.
        5   define input parameter p-general-view as character no-undo .
        6   define input-output parameter p-rid-list as character no-undo.
        7   define variable vss-revision    as character no-undo init "$Revision$":U .
        8   define variable vss-author      as character no-undo init "$Author$":U .
        9   define variable vss-date        as character no-undo init "$Date$":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       11   define variable vss-archive     as character no-undo init "$Archive$":U .
       12   define variable vss-description as character no-undo init "Список объектов-операндов RUM".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       68   define variable v-waitfram-action01         as character   no-undo .
       69   define variable v-waitfram-action02         as character   no-undo .
       70   define variable v-waitfram-action03         as character   no-undo .
       71   define variable mWaitFramTextBeg            as character   no-undo.
       72   define variable mWaitFramTextEnd            as character   no-undo.
       73   define variable mWaitFramView               as logical     no-undo.
       74   define variable mWaitProcEvent              as logical     no-undo init yes.
       75   define variable mWaitFramInterval           as integer     no-undo init 1 .
       76   define variable mWaitFramStop               as logical     no-undo.
       77   define variable mWaitFramStopUser           as logical     no-undo.
       78   define variable mWaitFramStopTimeOut        as logical     no-undo.
       79   define variable mWaitFramStartProc          as datetime-tz no-undo.
       80   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       81   define button B-WaitFramStop auto-end-key
       82        label "Стоп"
       83        size 10 by 1 tooltip "Остоновить процесс".
       84   define button B-viewProcInfo
       85        label "Информация"
       86        size 15 by 1 tooltip "Информация о процесс".
       87   define frame waitfram
       88     v-waitfram-action01 format "x(72)" no-label skip
       89     v-waitfram-action02 format "x(72)" no-label skip
       90     v-waitfram-action03 format "x(72)" no-label skip
       91     B-viewProcInfo
       92     B-WaitFramStop at row 4 col 30
       93     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       94     .
       95   define new global shared variable mBatchMode as logical no-undo init ?.
       96   define variable mFramBachModHandle as handle no-undo.
       97   mFramBachModHandle = frame waitfram:handle.
       98   define variable mFameOldVis as logical no-undo.
       99   define variable mVisCUrentVin as logical no-undo.
      100   if session:batch-mode
      101   then
      102      mBatchMode = yes.
      103   if mBatchMode = ? then do:
      104     mVisCUrentVin = current-window:visible.
      105     mFameOldVis = mFramBachModHandle:visible.
      106     mFramBachModHandle:visible  = yes.
      107     mBatchMode = mFramBachModHandle:visible ne yes.
      108     mFramBachModHandle:visible = mFameOldVis.
      109     current-window:visible = mVisCUrentVin.
      110   end.
      111    if  log-manager:logfile-name ne ?
      112     then DO:
      113         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      114         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      115         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      116     end.
      117   on choose of B-WaitFramStop in frame waitfram
      118   do:
      119     mWaitFramStop = yes.
      120     mWaitFramStopUser = yes.
      121   end.
      122   function waitfram-check-timeout returns logical():
      123      define variable vtime as int64 no-undo.
      124      if mWaitFramStopTimeOut
      125      then
      126         return yes.
      127      vtime = ( now - mWaitFramStartProc ) / 1000 .
      128      if     mWaitFramTimeOut ne ?
      129         and mWaitFramTimeOut ne 0
      130         and mWaitFramTimeOut lt vtime
      131      then do:
      132         mWaitFramStopTimeOut = yes.
      133      end.
      134      return mWaitFramStopTimeOut.
      135   end.
      136   procedure waitfram-hide :
      137     if not session:batch-mode
      138     then do
      139     on error undo, return error return-value
      140     :
      141       pause 0 before-hide .
      142       if not mBatchMode then
      143         hide frame waitfram .
      144     if     not mWaitFramView
      145        and mWaitProcEvent
      146     then
      147       process events .
      148     end.
      149   end procedure.
      150   procedure waitfram-show :
      151     define input  parameter p-message as character no-undo .
      152     define variable v-left-margin as integer   no-undo .
      153     if not session:batch-mode
      154     then do
      155     on error undo, return error return-value
      156     :
      157       if length(p-message) <= 70 then do:
      158         assign
      159           v-left-margin = integer((70 - length(p-message)) / 2)
      160         .
      161         assign
      162           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      163         .
      164         assign
      165           v-waitfram-action01 = " "
      166           v-waitfram-action02 = " "
      167                                    + fill(" ", v-left-margin)
      168                                    + p-message
      169           v-waitfram-action03 = " "
      170         .
      171       end.
      172       else do:
      173         define variable vRindex1 as integer no-undo.
      174         define variable vRindex2 as integer no-undo.
      175         vRindex1 = r-index(p-message," ",70).
      176         if vRindex1 = 0
      177         then
      178            vRindex1 = 70.
      179         if length(p-message)  <= vRindex1 + 70 then do:
      180           assign
      181             v-waitfram-action01 = " "
      182             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      183             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      184           .
      185         end.
      186         else do:
      187           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      188           if vRindex2 <= vRindex1
      189           then
      190              vRindex2 = vRindex1 + 70.
      191           assign
      192             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      193             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      194             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      195           .
      196         end.
      197       end.
      198       B-viewProcInfo:visible   in frame waitfram = no.
      199       B-viewProcInfo:sensitive in frame waitfram = no.
      200       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      201       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      202       if  (   mWaitFramView
      203          or  mWaitProcEvent)
      204          and not mBatchMode
      205       then
      206          display
      207             v-waitfram-action01 skip
      208             v-waitfram-action02 skip
      209             v-waitfram-action03 skip
      210          with frame waitfram .
      211       if     mWaitFramView
      212          then do:
      213             if     mWaitFramInterval ne ?
      214                and not mBatchMode
      215             then
      216                wait-for go of frame waitfram pause mWaitFramInterval.
      217          end.
      218          else
      219             if     mWaitProcEvent
      220                and not mBatchMode
      221             then
      222                process events .
      223     end.
      224   end procedure.
      225      procedure waitfram-show-this:
      226         define input  parameter iInterval as int64 no-undo.
      227         define variable vtime as int64 no-undo.
      228         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      229         mWaitFramInterval = iInterval.
      230         run waitfram-show (substitute("&1&2 &3&4" ,
      231                                       mWaitFramTextBeg ,
      232                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      233                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      234                                       mWaitFramTextEnd
      235                                      )
      236                           ).
      237      end.
      238      procedure WaitFramRunPause:
      239         define input  parameter iInterval as dec no-undo.
      240         define variable vStart  as datetime-tz no-undo.
      241         define variable vend    as datetime-tz no-undo.
      242         define variable vint as int64 no-undo.
      243         define variable vOk as logical no-undo.
      244         vStart = now.
      245         vend   = vStart.
      246         publish "WaitFramPause" (iInterval,output vOk).
      247         vend   =  now.
      248         vint = vend - vStart.
      249         vint = iInterval - vint / 1000.
      250         if     not mWaitFramStop
      251            and (   vint > 0
      252                 or (    not vOk
      253                     and iInterval eq ?
      254                     )
      255                 )
      256         then
      257            run waitfram-show-this (iInterval).
      258         vend   =  now.
      259         vint = vend - vStart.
      260         vint = iInterval - vint / 1000.
      261         if     not mWaitFramStop
      262            and vint > 0
      263         then do:
      264            run gbl/pause.p (vint * 1000).
      265         end.
      266         if iInterval ne ?
      267         then
      268            publish "WaitFramStop".
      269         waitfram-check-timeout().
      270      end.
      271      procedure WaitFramWaitFor:
      272         define input  parameter iInterval as dec no-undo.
      273         assign
      274            mWaitFramStartProc   = now
      275            mWaitFramStopUser    = no
      276            mWaitFramStopTimeOut = no
      277         .
      278         block-wait:
      279         do while not mWaitFramStop:
      280            run WaitFramRunPause (iInterval).
      281            if  waitfram-check-timeout()
      282            then do:
      283               leave block-wait.
      284            end.
      285         end.
      286         run waitfram-hide.
      287      end.
      288   procedure waitfram-join :
      289     define input  parameter p-line-1  as character no-undo .
      290     define input  parameter p-line-2  as character no-undo .
      291     define input  parameter p-line-3  as character no-undo .
      292     define output parameter p-message as character no-undo .
      293     do
      294     on error undo, return error return-value
      295     :
      296       assign
      297         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      298                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      299                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      300       .
      301     end.
      302   end procedure.
      303   function waitfram-join-function returns character
      304     (input p-line-1 as character
      305     ,input p-line-2 as character
      306     ,input p-line-3 as character
      307     ).
      308     define variable v-message as character no-undo .
      309     run waitfram-join in this-procedure
      310       (input  p-line-1
      311       ,input  p-line-2
      312       ,input  p-line-3
      313       ,output v-message
      314       ) .
      315     return v-message .
      316   end function .
      317   define new global shared variable g#language as character no-undo .
      318   if g#language <> '' and g#language <> 'rus':U then do:
      319     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      320   end.
      321   procedure proc-alt-shift-f2:
      322     if not ibs.th.gbl.gbl-var:rcode
      323   then
      324     run gbl\inidebug.p .
      325   end.
      326   procedure proc-alt-shift-f3:
      327     run gbl/prvssinf.p
      328       ( input this-procedure
      329       ) .
      330   end.
      331   define variable v-inform-launched as logical no-undo initial false .
      332   procedure proc-alt-shift-f4:
      333     define variable v-action as character no-undo .
      334     if v-inform-launched = false then do:
      335       assign
      336         v-inform-launched = true
      337       .
      338       run gbl/d-inform.w
      339         (  input self
      340         ,  input this-procedure
      341         , output v-action
      342         ) no-error .
      343       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      344       assign
      345         v-inform-launched = false
      346       .
      347     end.
      348   end.
      349   procedure proc-alt-f1:
      350     run gbl/corrhelp.p
      351       (input this-procedure
      352       ) .
      353   end .
      354   on alt-shift-f2 anywhere do:
      355     run proc-alt-shift-f2.
      356   end.
      357   on alt-shift-f3 anywhere do:
      358     run proc-alt-shift-f3 in this-procedure .
      359   end.
      360   on alt-shift-f4 anywhere do:
      361     run proc-alt-shift-f4 in this-procedure.
      362   end.
      363   on alt-f1 anywhere do:
      364     run proc-alt-f1 in this-procedure .
      365   end.
      366   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      367     define variable v-cntxt-db-num        as integer   no-undo .
      368     define variable v-cntxt-userid        as character no-undo .
      369     define variable v-cntxt-level         as character no-undo .
      370     define variable v-cntxt-host-code-obj as integer   no-undo .
      371     define variable v-cntxt-obj-type      as character no-undo .
      372     define variable v-cntxt-obj-code      as integer   no-undo .
      373     define variable v-cntxt-db-num-obj    as integer   no-undo .
      374     define variable v-cntxt-is-admin      as logical   no-undo .
      375   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      376   FUNCTION mark-string RETURNS CHARACTER
      377     ( input p-recid as recid, input mark-list as character  ) :
      378     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      379   END FUNCTION.
      380   DEFINE VARIABLE v-doc-rec AS RECID NO-UNDO.
      381   DEFINE VARIABL link-option AS CHARACTER NO-UNDO.
      382   define variable v-rid-list as character no-undo .
      383   define variable storage-option as character no-undo.
      384   DEFINE MENU MENU-b-link
      385          MENU-ITEM m_prop-map     LABEL "Хранимые свойства"
      386          MENU-ITEM m_prop-script  LABEL "Скрипты"
      387          MENU-ITEM m_prop-ruleset LABEL "Привязка к кодексам и наборам правил".
      388   DEFINE MENU MENU-b-storage
      389          MENU-ITEM m_object       LABEL "Объект"
      390          MENU-ITEM m_host         LABEL "Фирма"
      391          MENU-ITEM m_global       LABEL "Глобально"     .
      392   DEFINE BUTTON b-add
      393        LABEL "&Добавить"
      394        SIZE 10 BY 1.
      395   DEFINE BUTTON b-chg
      396        LABEL "&Изменить"
      397        SIZE 10 BY 1.
      398   DEFINE BUTTON b-del
      399        LABEL "&Удалить"
      400        SIZE 10 BY 1.
      401   DEFINE BUTTON B-Help
      402        LABEL "Помо&щь"
      403        SIZE 3 BY 1
      404        BGCOLOR 8 .
      405   DEFINE BUTTON b-links
      406        LABEL "Связи"
      407        SIZE 10 BY 1.
      408   DEFINE BUTTON b-lkp
      409        LABEL "&Просмотр"
      410        SIZE 10 BY 1.
      411   DEFINE BUTTON b-mark
      412        LABEL "&*"
      413        SIZE 4 BY 1.
      414   DEFINE BUTTON b-prop
      415        LABEL "Свойства"
      416        SIZE 10 BY 1.
      417   DEFINE BUTTON b-quit AUTO-END-KEY
      418        LABEL "&Выход"
      419        SIZE 10 BY 1
      420        BGCOLOR 8 .
      421   DEFINE BUTTON b-sel AUTO-GO
      422        LABEL "Выбор"
      423        SIZE 10 BY 1.
      424   DEFINE BUTTON b-storage
      425        LABEL "Данные"
      426        SIZE 10 BY 1.
      427   DEFINE VARIABLE mark-num AS INTEGER FORMAT "->,>>>,>>9":U INITIAL 0
      428         VIEW-AS TEXT
      429        SIZE 9 BY .67
      430        FGCOLOR 10  NO-UNDO.
      431   DEFINE QUERY br-prop-head FOR
      432         X_prop-head SCROLLING.
      433   DEFINE BROWSE br-prop-head
      434     QUERY br-prop-head NO-LOCK DISPLAY
      435         mark-string(recid(X_prop-head), v-rid-list) Format "X(1)" COLUMN-LABEL "*"
      436   X_prop-head.dtm-code COLUMN-LABEL "Код объекта" FORMAT ">>>>>>>>9"
      437   X_prop-head.prop-name COLUMN-LABEL "Имя объекта" format "X(255)" width 32
      438   X_prop-head.prop-label COLUMN-LABEL "Лейбл объекта" format "X(255)" width 45
      439       WITH NO-ROW-MARKERS SEPARATORS SIZE 97 BY 19.53 FIT-LAST-COLUMN.
      440   DEFINE FRAME Dialog-Frame
      441        b-quit AT ROW 1 COL 1
      442        b-mark AT ROW 1 COL 20 WIDGET-ID 12
      443        b-sel AT ROW 1 COL 24 WIDGET-ID 10
      444        b-add AT ROW 1 COL 34 WIDGET-ID 2
      445        b-chg AT ROW 1 COL 44 WIDGET-ID 4
      446        b-del AT ROW 1 COL 54 WIDGET-ID 8
      447        b-lkp AT ROW 1 COL 64 WIDGET-ID 6
      448        b-links AT ROW 1 COL 74 WIDGET-ID 16
      449        b-storage AT ROW 1 COL 84 WIDGET-ID 18
      450        B-Help AT ROW 1 COL 95
      451        b-prop AT ROW 2 COL 74 WIDGET-ID 20
      452        br-prop-head AT ROW 3.33 COL 1.5 WIDGET-ID 100
      453        mark-num AT ROW 1 COL 9 COLON-ALIGNED NO-LABEL WIDGET-ID 14
      454        SPACE(78.50) SKIP(21.20)
      455       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      456            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      457            TITLE "Объекты"
      458            CANCEL-BUTTON b-quit.
      459   ASSIGN
      460          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      461          FRAME Dialog-Frame:HIDDEN           = TRUE.
      462   ASSIGN
      463          b-links:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-b-link:HANDLE.
      464   ASSIGN
      465          b-storage:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-b-storage:HANDLE.
      466   ON GO OF FRAME Dialog-Frame
      467   DO:
      468     p-rid-list = v-rid-list.
      469   END.
      470   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      471   DO:
      472     APPLY "END-ERROR":U TO SELF.
      473   END.
      474   ON CHOOSE OF b-add IN FRAME Dialog-Frame
      475   DO:
      476     define variable v-rec as recid no-undo.
      477     v-rec = recid(X_prop-head).
      478     run rul/prop-head-i.w ( input parparentproc
      479                          ,input 'ДОБАВЛЕНИЕ':U
      480                          ,input 0
      481                          ,input-output v-rec) no-error.
      482     if v-rec <> ? then do:
      483       RUN openbr IN THIS-PROCEDURE.
      484     end.
      485   END.
      486   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
      487   DO:
      488     define variable v-rec as recid no-undo.
      489     if not available X_prop-head then return no-apply.
      490     v-rec = recid(X_prop-head).
      491     run rul/prop-head-i.w ( input parparentproc
      492                          ,input 'ИЗМЕНЕНИЕ':U
      493                          ,input X_prop-head.dtm-code
      494                          ,input-output v-rec) no-error.
      495     if v-rec <> ? then do:
      496        br-prop-head:refresh().
      497     end.
      498   END.
      499   ON CHOOSE OF b-del IN FRAME Dialog-Frame
      500   DO:
      501     define variable v-rec as recid no-undo.
      502     define variable glog as logical no-undo.
      503     if not available X_prop-head then return no-apply.
      504     v-rec = recid(X_prop-head).
      505     message "Вы уверены, что хотите удалить Объект?"
      506     view-as alert-box question buttons yes-no update glog.
      507     if not glog then return no-apply.
      508    run rul/prop-head3.p ( input no
      509                          ,input v-rec) no-error.
      510    if error-status:error then return no-apply.
      511    run Openbr in this-procedure .
      512   END.
      513   ON CHOOSE OF b-links IN FRAME Dialog-Frame
      514   DO:
      515     define variable v-rec as recid no-undo.
      516     if not available X_prop-head then return no-apply.
      517     IF link-option = '':U THEN DO:
      518       run gbl/pop-up.p ( INPUT SELF :handle, input no ) no-error.
      519       if error-status :error then do: return no-apply. end.
      520     end.
      521     if link-option = "":U then do:
      522         return no-apply.
      523     end.
      524     run proc-b-link IN THIS-PROCEDURE ( INPUT link-option).
      525   END.
      526   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
      527   DO:
      528     define variable v-rec as recid no-undo.
      529     if not available X_prop-head then return no-apply.
      530     run proc-b-lkp IN THIS-PROCEDURE.
      531   END.
      532   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
      533   DO:
      534       define variable glog as logical no-undo .
      535     if available X_prop-head then do:
      536   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      537   define variable v-str-recid4 as character no-undo .
      538   define variable v-num-entry4 as integer   no-undo .
      539   assign
      540     v-str-recid4 = trim( string( recid( X_prop-head ) , "->>>>>>>>>>>9":U ) )
      541     v-num-entry4 = lookup( v-str-recid4 , v-rid-list )
      542   .
      543   if v-num-entry4 > 0 then do:
      544     assign
      545       entry( v-num-entry4, v-rid-list ) = "":U
      546       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
      547     .
      548   end.
      549   else do:
      550     assign
      551       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid4
      552     .
      553   end.
      554     glog = br-prop-head:refresh() .
      555     if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
      556         glog = br-prop-head:select-next-row ().
      557         apply "VALUE-CHANGED" to br-prop-head in frame Dialog-Frame.
      558     end.
      559     if num-entries( v-rid-list ) = 0
      560     then
      561         hide mark-num in frame Dialog-Frame.
      562     else
      563         disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
      564   end.
      565   apply "entry" to br-prop-head in frame Dialog-Frame.
      566   END.
      567   ON CHOOSE OF b-prop IN FRAME Dialog-Frame
      568   DO:
      569   define variable v-rec as recid no-undo .
      570   if not available X_prop-head then return no-apply.
      571   if not (X_prop-head.storage-place = 'dis-card-property':U
      572           or
      573           X_prop-head.storage-place-host = 'dis-card-property':U
      574           or
      575           X_prop-head.storage-place-obj = 'dis-card-property':U) then do:
      576     message
      577     substitute("Свойства можно настроить только если место хранения &1", 'dis-card-property':U)
      578     view-as alert-box error .
      579     return no-apply.
      580   end.
      581   v-rec = recid(X_prop-head).
      582   run utl/attrprps.w ( input parparentproc
      583                       ,input 'ИЗМЕНЕНИЕ':U
      584                       ,input 'dis-card-property':U
      585                       ,input X_prop-head.dtm-code
      586                       ,output v-rec) no-error.
      587   END.
      588   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
      589   DO:
      590     if available X_prop-head then do:
      591       if  ( v-rid-list = "" ) or b-mark:sensitive = no
      592       then  v-rid-list = string( recid( X_prop-head ) ) .
      593     end.
      594   END.
      595   ON CHOOSE OF b-storage IN FRAME Dialog-Frame
      596   DO:
      597     IF NOT AVAILABLE X_prop-head THEN RETURN NO-APPLY.
      598     IF storage-option = '':U THEN DO:
      599       run gbl/pop-up.p ( INPUT SELF :handle, input no ) no-error.
      600       if error-status :error then do: return no-apply. end.
      601     end.
      602     if link-option = "":U then do:
      603         return no-apply.
      604     end.
      605     RUN proc-b-storage IN THIS-PROCEDURE( input storage-option) NO-ERROR.
      606     IF ERROR-STATUS:ERROR THEN do:
      607         storage-option = '':U.
      608         RETURN NO-APPLY.
      609     END.
      610   END.
      611   ON VALUE-CHANGED OF br-prop-head IN FRAME Dialog-Frame
      612   DO:
      613     RUN proc-value-change IN THIS-PROCEDURE NO-ERROR.
      614   END.
      615   ON CHOOSE OF MENU-ITEM m_global
      616   DO:
      617     ASSIGN
      618     storage-option = "global".
      619     run proc-b-storage IN THIS-PROCEDURE ( INPUT storage-option) NO-ERROR.
      620     ASSIGN
      621     link-option = '':U.
      622     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      623   END.
      624   ON CHOOSE OF MENU-ITEM m_host
      625   DO:
      626      ASSIGN
      627       storage-option = 'фирма':U.
      628       run proc-b-storage IN THIS-PROCEDURE ( INPUT storage-option) NO-ERROR.
      629       ASSIGN
      630       link-option = '':U.
      631       IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      632   END.
      633   ON CHOOSE OF MENU-ITEM m_object
      634   DO:
      635       ASSIGN
      636      storage-option = 'объект':U.
      637      run proc-b-storage IN THIS-PROCEDURE ( INPUT storage-option) NO-ERROR.
      638      ASSIGN
      639      link-option = '':U.
      640      IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      641   END.
      642   ON CHOOSE OF MENU-ITEM m_prop-map
      643   DO:
      644       ASSIGN
      645     link-option = 'prop-map':U.
      646     run proc-b-link IN THIS-PROCEDURE ( INPUT link-option) NO-ERROR.
      647     ASSIGN
      648     link-option = '':U.
      649     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      650   END.
      651   ON CHOOSE OF MENU-ITEM m_prop-ruleset
      652   DO:
      653       ASSIGN
      654     link-option = 'prop-ruleset':U.
      655     run proc-b-link IN THIS-PROCEDURE ( INPUT link-option) NO-ERROR.
      656     ASSIGN
      657     link-option = '':U.
      658     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      659   END.
      660   ON CHOOSE OF MENU-ITEM m_prop-script
      661   DO:
      662       ASSIGN
      663     link-option = 'prop-script':U.
      664     run proc-b-link IN THIS-PROCEDURE ( INPUT link-option) NO-ERROR.
      665     ASSIGN
      666     link-option = '':U.
      667     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      668   END.
      669   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      670   on f5 of frame Dialog-Frame anywhere
      671   do:
      672      v-doc-rec = recid(X_prop-head).    run OpenBR in this-procedure.  REPOSITION br-prop-head to recid v-doc-rec No-ERROR.   apply 'value-changed' to br-prop-head.
      673       apply "VALUE-CHANGED" to br-prop-head.
      674   end.
      675   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      676   on help of frame Dialog-Frame
      677   do:
      678     run gbl/app_help.p
      679       (input this-procedure :file-name
      680       ,input ''
      681       ,input ?
      682       ) no-error.
      683     if error-status :error then do:
      684       message
      685         "Ошибка при вызове помощи"
      686         error-status :get-message(1)
      687         view-as alert-box .
      688     end.
      689   end.
      690   run minbtn-set in this-procedure .
      691   on choose of b-help in frame Dialog-Frame
      692   do:
      693     apply "help":u to frame Dialog-Frame .
      694   end.
      695   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      696   procedure minbtn-set :
      697       do
      698           on error undo, return error return-value
      699           :
      700           define variable ii              as integer       no-undo .
      701           define variable fh              as widget-handle no-undo .
      702           define variable hh              as widget-handle no-undo .
      703           define variable v-h             as handle        extent 4 no-undo .
      704           define variable v-name-button   as character     no-undo .
      705           define variable v-help-old-x    as decimal       no-undo .
      706           define variable v-help-old-y    as decimal       no-undo .
      707           define variable v-help-old-size as decimal       no-undo .
      708           define variable v-frame-width   as decimal       no-undo .
      709           define variable jj              as integer       no-undo .
      710           do
      711               on error undo, return error
      712               :
      713               assign
      714                   v-frame-width = frame Dialog-Frame:width - 0.3
      715                   fh            = frame Dialog-Frame:first-child
      716                   hh            = fh:first-child
      717                   ii            = 1
      718                   .
      719               do while valid-handle(hh):
      720                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      721                   do:
      722                       case lc(hh:name) :
      723                           when "b-help" then
      724                               do:
      725                                   hh:load-image-up("cmp/b-help.bmp":u) .
      726                                   hh:load-image-down("cmp/b-help.bmp":u) .
      727                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      728                                   hh:TOOLTIP = "Помощь" .
      729                                   v-help-old-x = hh:column .
      730                                   v-help-old-y = hh:row    .
      731                                   v-help-old-size = hh:width .
      732                                   hh:width-chars = 2.5 .
      733                               end.
      734                           when "b-print" then
      735                               do:
      736                                   hh:load-image("cmp/b-print.bmp":u) .
      737                                   hh:TOOLTIP = "Печать" .
      738                                   v-h[ii] = hh:handle .
      739                                   ii = ii + 1 .
      740                                   hh:width-chars = 3 .
      741                               end.
      742                           when "b-history" or
      743                           when "b-hist" then
      744                               do:
      745                                   hh:load-image("cmp/b-hist.bmp":u) .
      746                                   hh:TOOLTIP = "История" .
      747                                   v-h[ii] = hh:handle .
      748                                   ii = ii + 1 .
      749                                   hh:width-chars = 3 .
      750                               end.
      751                           when "b-sch" then
      752                               do:
      753                                   hh:load-image("cmp/b-sch.bmp":u) .
      754                                   hh:TOOLTIP = "Установка Фильтра" .
      755                                   v-h[ii] = hh:handle .
      756                                   ii = ii + 1 .
      757                                   hh:width-chars = 3 .
      758                               end.
      759                           when "b-hist-user" then
      760                               do:
      761                                   hh:load-image("cmp/b-hist.bmp":u) .
      762                                   hh:TOOLTIP = "История пользователя" .
      763                                   ii = ii + 1 .
      764                               end.
      765                       end case.
      766                   end.
      767                   hh = hh:next-sibling.
      768               end.
      769               b-help:column = v-frame-width - b-help:width-chars.
      770               jj = 0.
      771               repeat ii = 4 to 1 by -1 :
      772                   if valid-handle (v-h[ii] ) then
      773                   do:
      774                       jj  = jj + 1 .
      775                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      776                       v-h[ii]:row    = v-help-old-y .
      777                   end.
      778               end.
      779           end.
      780       end.
      781   end procedure.
      782   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      783   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      784   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      785   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      786   define variable v-diasize-current-frame-width  as decimal   no-undo .
      787   define variable v-diasize-current-frame-height as decimal   no-undo .
      788   define variable v-diasize-change-size          as logical   no-undo .
      789   define variable v-diasize-resize-button        as handle    no-undo .
      790   define variable v-diasize-wndmax               as logical   no-undo .
      791   define variable v-diasize-wndstore             as logical   no-undo .
      792   define variable v-diasize-proc-name            as character no-undo .
      793   define variable v-diasize-browse-handle        as handle    no-undo .
      794   define variable v-diasize-browse-number        as integer   no-undo .
      795   define variable v-diasize-need-full-display    as logical   no-undo init false .
      796   define temp-table temp-diasize-handle no-undo
      797     field handle-value  as handle
      798     field save-position as decimal
      799     index xpk is primary unique handle-value
      800     .
      801   define temp-table temp-browse-handle no-undo
      802     field browse-type   as character
      803     field browse-number as integer
      804     field browse-handle as handle
      805     field original-size as decimal
      806     index xpk is primary unique browse-type browse-number
      807     index xie browse-type browse-handle
      808   .
      809   procedure diasize_change-height :
      810     define input  parameter p-change-value  as decimal   no-undo .
      811     define input  parameter p-move-resize   as logical   no-undo .
      812     define variable v-field-group-handle    as handle    no-undo .
      813     define variable v-object-handle         as handle    no-undo .
      814     define variable v-frame-height          as decimal   no-undo .
      815     define variable v-frame-virtual-height  as decimal   no-undo .
      816     define variable v-browse-height         as decimal   no-undo .
      817     define variable v-window-height         as decimal   no-undo .
      818     define variable v-window-virtual-height as decimal   no-undo .
      819     define variable v-change-sign           as integer   no-undo .
      820     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      821     define buffer buf_temp-browse-handle  for temp-browse-handle .
      822     if p-change-value > 0
      823     then do:
      824       if frame Dialog-Frame :height + p-change-value
      825           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      826       then do:
      827         assign
      828           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      829                           - (frame Dialog-Frame :height-chars)
      830         .
      831         if p-change-value <= 0
      832         then do:
      833           run diasize_position-resize-button in this-procedure .
      834           return .
      835         end.
      836       end.
      837     end.
      838     if p-change-value < 0
      839     then do:
      840       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      841       then do:
      842         assign
      843           p-change-value = v-diasize-orig-frame-height
      844                          - (frame Dialog-Frame :height-chars)
      845         .
      846         if p-change-value >= 0
      847         then do:
      848           run diasize_position-resize-button in this-procedure .
      849           return .
      850         end.
      851       end.
      852     end.
      853     if p-change-value >= 0
      854     then do:
      855       assign
      856         v-change-sign = 1
      857       .
      858     end.
      859     else do:
      860       assign
      861         v-change-sign = -1
      862       .
      863     end.
      864     assign
      865       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      866     .
      867     if p-change-value = 0
      868     then do:
      869       run diasize_position-resize-button in this-procedure .
      870       return .
      871     end.
      872     move_block:
      873     do
      874     on error undo move_block, retry move_block
      875     :
      876       if retry
      877       then do:
      878         do
      879         on error undo move_block, leave move_block
      880         :
      881           if p-change-value > 0
      882           then do:
      883             for each buf_temp-diasize-handle
      884             on error undo, next
      885             :
      886               assign
      887                 v-object-handle = buf_temp-diasize-handle.handle-value
      888               .
      889               if v-object-handle <> v-diasize-resize-button
      890               then do:
      891                 assign
      892                   v-object-handle :row = buf_temp-diasize-handle.save-position
      893                 .
      894               end.
      895             end.
      896             assign
      897               v-diasize-browse-handle :height = v-browse-height
      898             .
      899             for each buf_temp-browse-handle
      900               where buf_temp-browse-handle.browse-type = 'height':u
      901             on error undo, next
      902             :
      903               assign
      904                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      905               .
      906             end.
      907             assign
      908               frame Dialog-Frame :height = v-frame-height
      909             .
      910             if frame Dialog-Frame :scrollable = true
      911             then do:
      912               assign
      913                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      914               .
      915             end.
      916             run diasize_position-resize-button in this-procedure .
      917           end.
      918           else do:
      919             if frame Dialog-Frame :scrollable = true
      920             then do:
      921               assign
      922                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      923               .
      924             end.
      925             assign
      926               frame Dialog-Frame :height = v-frame-height
      927             .
      928             assign
      929               v-diasize-browse-handle :height = v-browse-height
      930             .
      931             for each buf_temp-browse-handle
      932               where buf_temp-browse-handle.browse-type = 'height':u
      933             on error undo, next
      934             :
      935               assign
      936                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      937               .
      938             end.
      939             for each buf_temp-diasize-handle
      940             on error undo, next
      941             :
      942               assign
      943                 v-object-handle = buf_temp-diasize-handle.handle-value
      944               .
      945               if v-object-handle <> v-diasize-resize-button
      946               then do:
      947                 assign
      948                   v-object-handle :row = buf_temp-diasize-handle.save-position
      949                 .
      950               end.
      951             end.
      952             run diasize_position-resize-button in this-procedure .
      953           end.
      954           assign
      955             v-diasize-change-size = false
      956           .
      957           leave move_block .
      958         end.
      959       end.
      960       assign
      961         v-diasize-need-full-display = true
      962       .
      963       if v-diasize-change-size = false
      964       then do:
      965         assign
      966           v-diasize-change-size = true
      967         .
      968       end.
      969       else do:
      970         return .
      971       end.
      972       assign
      973         v-frame-height = frame Dialog-Frame :height
      974         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      975         v-browse-height = v-diasize-browse-handle :height
      976       .
      977       for each buf_temp-browse-handle
      978         where buf_temp-browse-handle.browse-type = 'height':u
      979       :
      980         assign
      981           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      982         .
      983       end.
      984       for each buf_temp-diasize-handle
      985       :
      986         delete buf_temp-diasize-handle .
      987       end.
      988       assign
      989         v-field-group-handle = frame Dialog-Frame :first-child
      990       .
      991       do while valid-handle(v-field-group-handle)
      992       :
      993         assign
      994           v-object-handle = v-field-group-handle :first-child
      995         .
      996         do while valid-handle(v-object-handle)
      997         :
      998           if  v-object-handle <> v-diasize-browse-handle :handle
      999           and can-query(v-object-handle, "row")
     1000           and can-query(v-object-handle, "height")
     1001           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1002           then do:
     1003             find first buf_temp-browse-handle
     1004               where buf_temp-browse-handle.browse-type   = 'height':u
     1005                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1006               no-error .
     1007             if available buf_temp-browse-handle
     1008             then do:
     1009             end.
     1010             else do:
     1011               create buf_temp-diasize-handle .
     1012               assign
     1013                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1014                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1015               .
     1016             end.
     1017           end.
     1018           assign
     1019             v-object-handle = v-object-handle :next-sibling
     1020           .
     1021         end.
     1022         assign
     1023           v-field-group-handle = v-field-group-handle :next-sibling
     1024         .
     1025       end.
     1026       do with frame Dialog-Frame
     1027       :
     1028         hide v-diasize-resize-button .
     1029         assign
     1030           v-diasize-resize-button :row    = 1
     1031           v-diasize-resize-button :column = 1
     1032         .
     1033       end.
     1034       if p-change-value > 0
     1035       then do:
     1036         if frame Dialog-Frame :scrollable = true
     1037         then do:
     1038           assign
     1039             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1040             no-error .
     1041           if error-status :error
     1042           or error-status :get-message(1) <> ""
     1043           then do:
     1044             undo move_block, retry move_block .
     1045           end.
     1046         end.
     1047         assign
     1048           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1049           no-error .
     1050         if error-status :error
     1051         or error-status :get-message(1) <> ""
     1052         then do:
     1053           undo move_block, retry move_block .
     1054         end.
     1055         assign
     1056           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1057           no-error .
     1058         if error-status :error
     1059         or error-status :get-message(1) <> ""
     1060         then do:
     1061           undo move_block, retry move_block .
     1062         end.
     1063         for each buf_temp-browse-handle
     1064           where buf_temp-browse-handle.browse-type = 'height':u
     1065         on error undo move_block, retry move_block
     1066         :
     1067           assign
     1068             buf_temp-browse-handle.browse-handle :height
     1069               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1070             no-error .
     1071           if error-status :error
     1072           or error-status :get-message(1) <> ""
     1073           then do:
     1074             undo move_block, retry move_block .
     1075           end.
     1076         end.
     1077         for each buf_temp-diasize-handle
     1078         on error undo move_block, retry move_block
     1079         :
     1080           assign
     1081             v-object-handle = buf_temp-diasize-handle.handle-value
     1082           .
     1083           if v-object-handle <> v-diasize-resize-button
     1084           then do:
     1085             assign
     1086               v-object-handle :row = v-object-handle :row + p-change-value
     1087               no-error .
     1088             if error-status :error
     1089             or error-status :get-message(1) <> ""
     1090             then do:
     1091               undo move_block, retry move_block .
     1092             end.
     1093           end.
     1094         end.
     1095       end.
     1096       else do:
     1097         for each buf_temp-diasize-handle
     1098         on error undo move_block, retry move_block
     1099         :
     1100           assign
     1101             v-object-handle = buf_temp-diasize-handle.handle-value
     1102           .
     1103           if v-object-handle <> v-diasize-resize-button
     1104           then do:
     1105             assign
     1106               v-object-handle :row = v-object-handle :row + p-change-value
     1107               no-error .
     1108             if error-status :error
     1109             or error-status :get-message(1) <> ""
     1110             then do:
     1111               undo move_block, retry move_block .
     1112             end.
     1113           end.
     1114         end.
     1115         assign
     1116           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1117           no-error .
     1118         if error-status :error
     1119         or error-status :get-message(1) <> ""
     1120         then do:
     1121           undo move_block, retry move_block .
     1122         end.
     1123         for each buf_temp-browse-handle
     1124           where buf_temp-browse-handle.browse-type = 'height':u
     1125         on error undo move_block, retry move_block
     1126         :
     1127           assign
     1128             buf_temp-browse-handle.browse-handle :height
     1129               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1130             no-error .
     1131           if error-status :error
     1132           or error-status :get-message(1) <> ""
     1133           then do:
     1134             undo move_block, retry move_block .
     1135           end.
     1136         end.
     1137         assign
     1138           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1139           no-error .
     1140         if error-status :error
     1141         or error-status :get-message(1) <> ""
     1142         then do:
     1143           undo move_block, retry move_block .
     1144         end.
     1145         if frame Dialog-Frame :scrollable = true
     1146         then do:
     1147           assign
     1148             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1149             no-error .
     1150           if error-status :error
     1151           or error-status :get-message(1) <> ""
     1152           then do:
     1153             undo move_block, retry move_block .
     1154           end.
     1155         end.
     1156       end.
     1157       if p-move-resize = true
     1158       then do:
     1159         run diasize_position-resize-button in this-procedure .
     1160       end.
     1161       if v-diasize-wndstore = true
     1162       then do:
     1163         if connected("ub") = true
     1164         then do:
     1165           define variable v-cntxt-db-num        as integer   no-undo .
     1166           define variable v-cntxt-userid        as character no-undo .
     1167           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1168                                             , OUTPUT v-cntxt-userid
     1169                                             ) .
     1170           run gbl/wndsizew.p
     1171             (input  v-cntxt-db-num
     1172             ,input  v-cntxt-userid
     1173             ,input  v-diasize-proc-name
     1174             ,input  'height':u
     1175             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1176             ) .
     1177         end.
     1178       end.
     1179     end.
     1180     assign
     1181       v-diasize-change-size = false
     1182     .
     1183   end procedure.
     1184   procedure diasize_set-height :
     1185     define input  parameter p-new-height  as decimal   no-undo .
     1186     define input  parameter p-move-resize as logical   no-undo .
     1187     do
     1188     on error undo, return error return-value
     1189     :
     1190       run diasize_change-height in this-procedure
     1191         (input  (p-new-height - frame Dialog-Frame :height)
     1192         ,input  p-move-resize
     1193         ) .
     1194     end.
     1195   end procedure.
     1196   procedure diasize_change-width :
     1197     define input  parameter p-change-value as decimal   no-undo .
     1198     define input  parameter p-move-resize  as logical   no-undo .
     1199     define variable v-field-group-handle   as handle    no-undo .
     1200     define variable v-object-handle        as handle    no-undo .
     1201     define variable v-frame-width          as decimal   no-undo .
     1202     define variable v-frame-virtual-width  as decimal   no-undo .
     1203     define variable v-browse-width         as decimal   no-undo .
     1204     define variable v-window-width         as decimal   no-undo .
     1205     define variable v-window-virtual-width as decimal   no-undo .
     1206     define variable v-change-sign          as integer   no-undo .
     1207     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1208     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1209     if p-change-value > 0
     1210     then do:
     1211       if frame Dialog-Frame :width + p-change-value >
     1212           session :width-chars
     1213       then do:
     1214         assign
     1215           p-change-value = session :width-chars - frame Dialog-Frame :width
     1216         .
     1217         if p-change-value <= 0
     1218         then do:
     1219           run diasize_position-resize-button in this-procedure .
     1220           return .
     1221         end.
     1222       end.
     1223     end.
     1224     if p-change-value < 0
     1225     then do:
     1226       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1227       then do:
     1228         assign
     1229           p-change-value = v-diasize-orig-frame-width
     1230                          - frame Dialog-Frame :width
     1231         .
     1232         if p-change-value >= 0
     1233         then do:
     1234           run diasize_position-resize-button in this-procedure .
     1235           return .
     1236         end.
     1237       end.
     1238     end.
     1239     if p-change-value >= 0
     1240     then do:
     1241       assign
     1242         v-change-sign = 1
     1243       .
     1244     end.
     1245     else do:
     1246       assign
     1247         v-change-sign = -1
     1248       .
     1249     end.
     1250     assign
     1251       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1252     .
     1253     if p-change-value = 0
     1254     then do:
     1255       run diasize_position-resize-button in this-procedure .
     1256       return .
     1257     end.
     1258     move_block:
     1259     do
     1260     on error undo move_block, leave move_block
     1261     :
     1262       if retry
     1263       then do:
     1264         do
     1265         on error undo move_block, leave move_block
     1266         :
     1267           if p-change-value > 0
     1268           then do:
     1269             for each buf_temp-diasize-handle
     1270             on error undo, next
     1271             :
     1272               assign
     1273                 v-object-handle = buf_temp-diasize-handle.handle-value
     1274               .
     1275               if v-object-handle <> v-diasize-resize-button
     1276               then do:
     1277                 assign
     1278                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1279                 .
     1280               end.
     1281             end.
     1282             assign
     1283               v-diasize-browse-handle :width = v-browse-width
     1284             .
     1285             for each buf_temp-browse-handle
     1286               where buf_temp-browse-handle.browse-type = 'width':u
     1287             on error undo, next
     1288             :
     1289               assign
     1290                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1291               .
     1292             end.
     1293             assign
     1294               frame Dialog-Frame :width = v-frame-width
     1295             .
     1296             if frame Dialog-Frame :scrollable = true
     1297             then do:
     1298               assign
     1299                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1300               .
     1301             end.
     1302             run diasize_position-resize-button in this-procedure .
     1303           end.
     1304           else do:
     1305             if frame Dialog-Frame :scrollable = true
     1306             then do:
     1307               assign
     1308                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1309               .
     1310             end.
     1311             assign
     1312               frame Dialog-Frame :width = v-frame-width
     1313             .
     1314             for each buf_temp-browse-handle
     1315               where buf_temp-browse-handle.browse-type = 'width':u
     1316             on error undo, next
     1317             :
     1318               assign
     1319                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1320               .
     1321             end.
     1322             assign
     1323               v-diasize-browse-handle :width = v-browse-width
     1324             .
     1325             for each buf_temp-diasize-handle
     1326             on error undo, next
     1327             :
     1328               assign
     1329                 v-object-handle = buf_temp-diasize-handle.handle-value
     1330               .
     1331               if v-object-handle <> v-diasize-resize-button
     1332               then do:
     1333                 assign
     1334                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1335                 .
     1336               end.
     1337             end.
     1338             run diasize_position-resize-button in this-procedure .
     1339           end.
     1340           assign
     1341             v-diasize-change-size = false
     1342           .
     1343           leave move_block .
     1344         end.
     1345       end.
     1346       assign
     1347         v-diasize-need-full-display = true
     1348       .
     1349       if v-diasize-change-size = false
     1350       then do:
     1351         assign
     1352           v-diasize-change-size = true
     1353         .
     1354       end.
     1355       else do:
     1356         return .
     1357       end.
     1358       assign
     1359         v-frame-width = frame Dialog-Frame :width
     1360         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1361         v-browse-width = v-diasize-browse-handle :width
     1362       .
     1363       for each buf_temp-browse-handle
     1364         where buf_temp-browse-handle.browse-type = 'width':u
     1365       :
     1366         assign
     1367           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1368         .
     1369       end.
     1370       for each buf_temp-diasize-handle
     1371       :
     1372         delete buf_temp-diasize-handle .
     1373       end.
     1374       assign
     1375         v-field-group-handle = frame Dialog-Frame :first-child
     1376       .
     1377       do while valid-handle(v-field-group-handle)
     1378       :
     1379         assign
     1380           v-object-handle = v-field-group-handle :first-child
     1381         .
     1382         do while valid-handle(v-object-handle)
     1383         :
     1384           if  v-object-handle <> v-diasize-browse-handle :handle
     1385           and v-object-handle <> v-diasize-resize-button
     1386           and can-query(v-object-handle, "row")
     1387           and can-query(v-object-handle, "height")
     1388           and ( v-object-handle :col + v-object-handle :width
     1389                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1390               )
     1391           then do:
     1392             find first buf_temp-browse-handle
     1393               where buf_temp-browse-handle.browse-type   = 'width':u
     1394                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1395               no-error .
     1396             if available buf_temp-browse-handle
     1397             then do:
     1398             end.
     1399             else do:
     1400               create buf_temp-diasize-handle .
     1401               assign
     1402                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1403                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1404               .
     1405             end.
     1406           end.
     1407           assign
     1408             v-object-handle = v-object-handle :next-sibling
     1409           .
     1410         end.
     1411         assign
     1412           v-field-group-handle = v-field-group-handle :next-sibling
     1413         .
     1414       end.
     1415       do with frame Dialog-Frame
     1416       :
     1417         hide v-diasize-resize-button .
     1418         v-diasize-resize-button :row = 1.
     1419         v-diasize-resize-button :column = 1.
     1420       end.
     1421       if p-change-value > 0
     1422       then do:
     1423         if frame Dialog-Frame :scrollable = true
     1424         then do:
     1425           assign
     1426             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1427             no-error .
     1428           if error-status :error
     1429           or error-status :get-message(1) <> ""
     1430           then do:
     1431             undo move_block, retry move_block.
     1432           end.
     1433         end.
     1434         assign
     1435           frame Dialog-Frame :width = v-frame-width + p-change-value
     1436           no-error .
     1437         if error-status :error
     1438         or error-status :get-message(1) <> ""
     1439         then do:
     1440           undo move_block, retry move_block.
     1441         end.
     1442         assign
     1443           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1444         no-error .
     1445         if error-status :error
     1446         or error-status :get-message(1) <> ""
     1447         then do:
     1448           undo move_block, retry move_block.
     1449         end.
     1450         for each buf_temp-browse-handle
     1451           where buf_temp-browse-handle.browse-type = 'width':u
     1452         on error undo move_block, retry move_block
     1453         :
     1454           assign
     1455             buf_temp-browse-handle.browse-handle :width
     1456               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1457             no-error .
     1458           if error-status :error
     1459           or error-status :get-message(1) <> ""
     1460           then do:
     1461             undo move_block, retry move_block .
     1462           end.
     1463         end.
     1464         for each buf_temp-diasize-handle
     1465         on error undo move_block, retry move_block
     1466         :
     1467           assign
     1468             v-object-handle = buf_temp-diasize-handle.handle-value
     1469           .
     1470           if v-object-handle <> v-diasize-resize-button
     1471           then do:
     1472             assign
     1473               v-object-handle :col = v-object-handle :col + p-change-value
     1474               no-error .
     1475             if error-status :error
     1476             or error-status :get-message(1) <> ""
     1477             then do:
     1478               undo move_block, retry move_block .
     1479             end.
     1480           end.
     1481         end.
     1482       end.
     1483       else do:
     1484         for each buf_temp-diasize-handle
     1485         on error undo move_block, retry move_block
     1486         :
     1487           assign
     1488             v-object-handle = buf_temp-diasize-handle.handle-value
     1489           .
     1490           if v-object-handle <> v-diasize-resize-button
     1491           then do:
     1492             assign
     1493               v-object-handle :col = v-object-handle :col + p-change-value
     1494               no-error .
     1495             if error-status :error
     1496             or error-status :get-message(1) <> ""
     1497             then do:
     1498               undo move_block, retry move_block .
     1499             end.
     1500           end.
     1501         end.
     1502         for each buf_temp-browse-handle
     1503           where buf_temp-browse-handle.browse-type = 'width':u
     1504         on error undo move_block, retry move_block
     1505         :
     1506           assign
     1507             buf_temp-browse-handle.browse-handle :width
     1508               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1509             no-error .
     1510           if error-status :error
     1511           or error-status :get-message(1) <> ""
     1512           then do:
     1513             undo move_block, retry move_block .
     1514           end.
     1515         end.
     1516         assign
     1517           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1518           no-error .
     1519         if error-status :error
     1520         or error-status :get-message(1) <> ""
     1521         then do:
     1522           undo move_block, retry move_block.
     1523         end.
     1524         assign
     1525           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1526         no-error .
     1527         if error-status :error
     1528         or error-status :get-message(1) <> ""
     1529         then do:
     1530           undo move_block, retry move_block.
     1531         end.
     1532         if frame Dialog-Frame :scrollable = true
     1533         then do:
     1534           assign
     1535             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1536           no-error .
     1537           if error-status :error
     1538           or error-status :get-message(1) <> ""
     1539           then do:
     1540             undo move_block, retry move_block.
     1541           end.
     1542         end.
     1543       end.
     1544       if p-move-resize
     1545       then do:
     1546         run diasize_position-resize-button in this-procedure .
     1547       end.
     1548       if v-diasize-wndstore = true
     1549       then do:
     1550         if connected("ub") = true
     1551         then do:
     1552           define variable v-cntxt-db-num        as integer   no-undo .
     1553           define variable v-cntxt-userid        as character no-undo .
     1554           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1555                                             , OUTPUT v-cntxt-userid
     1556                                             ) .
     1557           run gbl/wndsizew.p
     1558             (input  v-cntxt-db-num
     1559             ,input  v-cntxt-userid
     1560             ,input  v-diasize-proc-name
     1561             ,input  'width':u
     1562             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1563             ) .
     1564         end.
     1565       end.
     1566     end.
     1567     assign
     1568       v-diasize-change-size = false
     1569     .
     1570   end procedure.
     1571   procedure diasize_set-width :
     1572     define input  parameter p-new-width  as decimal   no-undo .
     1573     define input  parameter p-move-resize as logical   no-undo .
     1574     do
     1575     on error undo, return error return-value
     1576     :
     1577       run diasize_change-width in this-procedure
     1578         (input  (p-new-width - frame Dialog-Frame :width)
     1579         ,input  p-move-resize
     1580         ) .
     1581     end.
     1582   end procedure.
     1583   procedure diasize_position-resize-button :
     1584     do with frame Dialog-Frame
     1585     :
     1586       hide v-diasize-resize-button .
     1587       assign
     1588         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1589                     - 1
     1590                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1591         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1592                     - 1
     1593                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1594       .
     1595       view v-diasize-resize-button .
     1596     end.
     1597   end procedure.
     1598   on alt-right anywhere
     1599   do:
     1600     run diasize_change-width in this-procedure
     1601       (input 1
     1602       ,input true
     1603       ) .
     1604     return no-apply .
     1605   end.
     1606   on alt-left anywhere
     1607   do:
     1608     run diasize_change-width in this-procedure
     1609       (input -1
     1610       ,input true
     1611       ) .
     1612     return no-apply .
     1613   end.
     1614   on alt-down anywhere
     1615   do:
     1616     run diasize_change-height in this-procedure
     1617       (input 1
     1618       ,input true
     1619       ) .
     1620     return no-apply .
     1621   end.
     1622   on alt-up anywhere
     1623   do:
     1624     run diasize_change-height in this-procedure
     1625       (input -1
     1626       ,input true
     1627       ) .
     1628     return no-apply .
     1629   end.
     1630   on alt-enter of frame Dialog-Frame
     1631   do:
     1632     run diasize_maximize in this-procedure
     1633       (input  ?
     1634       ).
     1635     return no-apply .
     1636   end.
     1637   procedure diasize_end-move :
     1638     do
     1639     on error undo, return error return-value
     1640     :
     1641       define variable v-row-delta as decimal   no-undo .
     1642       define variable v-col-delta as decimal   no-undo .
     1643       define variable v-new-row as decimal   no-undo .
     1644       define variable v-new-col as decimal   no-undo .
     1645       assign
     1646         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1647         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1648       .
     1649       assign
     1650         v-row-delta = v-new-row - frame Dialog-Frame :height
     1651         v-col-delta = v-new-col - frame Dialog-Frame :width
     1652       .
     1653       run diasize_change-height in this-procedure
     1654         (input v-row-delta
     1655         ,input true
     1656         ) .
     1657       run diasize_change-width in this-procedure
     1658         (input v-col-delta
     1659         ,input true
     1660         ) .
     1661     end.
     1662   end procedure.
     1663   procedure diasize_maximize :
     1664     define input  parameter p-action as logical   no-undo .
     1665     do
     1666     on error undo, return error return-value
     1667     :
     1668       if p-action = ?
     1669       then do:
     1670         if v-diasize-need-maximize = true
     1671         then do:
     1672           assign
     1673             p-action = true
     1674           .
     1675         end.
     1676         else do:
     1677           assign
     1678             p-action = false
     1679           .
     1680         end.
     1681       end.
     1682       if p-action = true
     1683       then do:
     1684         run diasize_change-height in this-procedure
     1685           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1686               - frame Dialog-Frame :height-chars
     1687           ,input true
     1688           ) .
     1689         run diasize_change-width in this-procedure
     1690           (input session :width-chars
     1691               - frame Dialog-Frame :width-chars
     1692           ,input true
     1693           ) .
     1694         assign
     1695           v-diasize-need-maximize = false
     1696         .
     1697       end.
     1698       else do:
     1699         run diasize_change-width in this-procedure
     1700           (input v-diasize-orig-frame-width
     1701               - frame Dialog-Frame :width-chars
     1702           ,input true
     1703           ) .
     1704         run diasize_change-height in this-procedure
     1705           (input v-diasize-orig-frame-height
     1706               - frame Dialog-Frame :height-chars
     1707           ,input true
     1708           ) .
     1709         assign
     1710           v-diasize-need-maximize = true
     1711         .
     1712       end.
     1713     end.
     1714   end procedure.
     1715   procedure diasize_restore-orig-size :
     1716     do
     1717     on error undo, return error return-value
     1718     :
     1719       assign
     1720         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1721         v-diasize-current-frame-height = frame Dialog-Frame :height
     1722       .
     1723       run diasize_set-height in this-procedure
     1724         (input  v-diasize-orig-frame-height
     1725         ,input  true
     1726         ) .
     1727       run diasize_set-width in this-procedure
     1728         (input  v-diasize-orig-frame-width
     1729         ,input  true
     1730         ) .
     1731     end.
     1732   end procedure.
     1733   procedure diasize_restore-current-size :
     1734     do
     1735     on error undo, return error return-value
     1736     :
     1737       run diasize_set-height in this-procedure
     1738         (input  v-diasize-current-frame-height
     1739         ,input  true
     1740         ) .
     1741       run diasize_set-width in this-procedure
     1742         (input  v-diasize-current-frame-width
     1743         ,input  true
     1744         ) .
     1745     end.
     1746   end procedure.
     1747   procedure diasize_set-browse-handle :
     1748     define input  parameter p-browse-handle as handle   no-undo .
     1749     define buffer buf_temp-browse-handle for temp-browse-handle .
     1750     do
     1751     on error undo, return error return-value
     1752     :
     1753       assign
     1754         v-diasize-browse-handle = p-browse-handle
     1755       .
     1756       for each buf_temp-browse-handle
     1757       on error undo, return error return-value
     1758       :
     1759         delete buf_temp-browse-handle .
     1760       end.
     1761     end.
     1762   end procedure.
     1763   procedure diasize_add_browse :
     1764     define input  parameter p-browse-type   as character no-undo .
     1765     define input  parameter p-browse-handle as handle    no-undo .
     1766     define buffer buf_temp-browse-handle for temp-browse-handle .
     1767     do
     1768     on error undo, return error return-value
     1769     :
     1770       assign
     1771         v-diasize-browse-number = v-diasize-browse-number + 1
     1772       .
     1773       create buf_temp-browse-handle .
     1774       assign
     1775         buf_temp-browse-handle.browse-type   = p-browse-type
     1776         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1777         buf_temp-browse-handle.browse-handle = p-browse-handle
     1778       .
     1779     end.
     1780   end procedure.
     1781   procedure diasize_init :
     1782     define variable v-default-value    as logical   no-undo .
     1783     define variable v-restore-saved    as logical   no-undo .
     1784     define variable v-resize-value-str as character no-undo .
     1785     do
     1786     on error undo, return error return-value
     1787     :
     1788       do with frame Dialog-Frame
     1789       :
     1790         assign
     1791           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1792           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1793           v-diasize-browse-handle     = browse br-prop-head :handle
     1794         .
     1795         create button v-diasize-resize-button
     1796         assign
     1797           parent        = frame Dialog-Frame :first-child
     1798           label         = "s"
     1799           height-pixels = 16
     1800           width-pixels  = 16
     1801           visible       = true
     1802           sensitive     = true
     1803           movable       = true
     1804           triggers:
     1805             on end-move persistent run diasize_end-move in this-procedure .
     1806           end triggers.
     1807         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1808         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1809         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1810         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1811         assign
     1812           v-diasize-wndmax = false
     1813         .
     1814         if connected("ub") = true
     1815         then do:
     1816           define variable v-cntxt-db-num        as integer   no-undo .
     1817           define variable v-cntxt-userid        as character no-undo .
     1818           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1819                                             , OUTPUT v-cntxt-userid
     1820                                             ) .
     1821           run gbl/wndpar_r.p
     1822             (input  v-cntxt-db-num
     1823             ,input  v-cntxt-userid
     1824             ,input  'wndmax':U
     1825             ,output v-diasize-wndmax
     1826             ,output v-default-value
     1827             ) .
     1828         end.
     1829         assign
     1830           v-diasize-wndstore = false
     1831         .
     1832         if connected("ub") = true
     1833         then do:
     1834           run gbl/wndpar_r.p
     1835             (input  v-cntxt-db-num
     1836             ,input  v-cntxt-userid
     1837             ,input  'wndstore':U
     1838             ,output v-diasize-wndstore
     1839             ,output v-default-value
     1840             ) .
     1841         end.
     1842         assign
     1843           v-diasize-proc-name = entry(1, program-name(2), '.')
     1844         .
     1845         if v-diasize-wndstore = true
     1846         then do:
     1847           assign
     1848             v-restore-saved = false
     1849           .
     1850           if connected("ub") = true
     1851           then do:
     1852             run gbl/wndsizer.p
     1853               (input  v-cntxt-db-num
     1854               ,input  v-cntxt-userid
     1855               ,input  v-diasize-proc-name
     1856               ,input  'height':u
     1857               ,output v-resize-value-str
     1858               ) .
     1859             if v-resize-value-str <> '':U
     1860             then do:
     1861               run diasize_change-height in this-procedure
     1862                 (input  integer(v-resize-value-str)
     1863                 ,input  true
     1864                 ) .
     1865               assign
     1866                 v-restore-saved = true
     1867               .
     1868             end.
     1869           end.
     1870           if connected("ub") = true
     1871           then do:
     1872             run gbl/wndsizer.p
     1873               (input  v-cntxt-db-num
     1874               ,input  v-cntxt-userid
     1875               ,input  v-diasize-proc-name
     1876               ,input  'width':u
     1877               ,output v-resize-value-str
     1878               ) .
     1879             if v-resize-value-str <> '':U
     1880             then do:
     1881               run diasize_change-width in this-procedure
     1882                 (input  integer(v-resize-value-str)
     1883                 ,input  true
     1884                 ) .
     1885               assign
     1886                 v-restore-saved = true
     1887               .
     1888             end.
     1889           end.
     1890           if v-restore-saved <> true
     1891           then do:
     1892             if v-diasize-wndmax = true
     1893             then do:
     1894               run diasize_maximize in this-procedure
     1895                 (input  true
     1896                 ) .
     1897             end.
     1898           end.
     1899         end.
     1900         else do:
     1901           if v-diasize-wndmax = true
     1902           then do:
     1903             run diasize_maximize in this-procedure
     1904               (input  true
     1905               ) .
     1906           end.
     1907         end.
     1908       end.
     1909     end.
     1910   end procedure.
     1911   procedure diasize_need-full-display :
     1912     define output parameter p-need-full-display as logical   no-undo .
     1913     do
     1914     on error undo, return error return-value
     1915     :
     1916       assign
     1917         p-need-full-display = v-diasize-need-full-display
     1918       .
     1919       assign
     1920         v-diasize-need-full-display = false
     1921       .
     1922     end.
     1923   end procedure.
     1924   procedure get-context :
     1925      define output parameter p-db-num as integer          no-undo.
     1926      define output parameter p-user-id as character        no-undo.
     1927      define variable v-login               as character    no-undo.
     1928      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1929      define buffer buf_user-login  for ub.user-login .
     1930      do
     1931      on error undo, return error
     1932      :
     1933            FIND FIRST buf_sys-ctrl no-lock.
     1934            ASSIGN
     1935               v-login = USERID("ub")
     1936               p-db-num = buf_sys-ctrl.db-num
     1937            .
     1938            FIND FIRST buf_user-login
     1939                 WHERE buf_user-login.db-num = p-db-num
     1940                   AND buf_user-login.user-login = v-login
     1941                 no-lock
     1942                 no-error
     1943                 .
     1944            IF AVAILABLE buf_user-login
     1945            THEN DO:
     1946               assign
     1947                  p-user-id = buf_user-login.user-id
     1948               .
     1949            END.
     1950      end.
     1951   end procedure.
     1952       run diasize_init in this-procedure .
     1953   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1954   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1955   MAIN-BLOCK:
     1956   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1957      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1958   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1959     run mainmenu_getcntxt in parparentproc
     1960       (output v-cntxt-db-num
     1961       ,output v-cntxt-userid
     1962       ,output v-cntxt-level
     1963       ,output v-cntxt-host-code-obj
     1964       ,output v-cntxt-obj-type
     1965       ,output v-cntxt-obj-code
     1966       ,output v-cntxt-db-num-obj
     1967       ,output v-cntxt-is-admin
     1968       ) .
     1969     v-rid-list = p-rid-list.
     1970     run Myenable in this-procedure .
     1971     WAIT-FOR GO OF FRAME Dialog-Frame.
     1972   END.
     1973   RUN disable_UI.
     1974   PROCEDURE disable_UI :
     1975     HIDE FRAME Dialog-Frame.
     1976   END PROCEDURE.
     1977   PROCEDURE enable_UI :
     1978     DISPLAY mark-num
     1979         WITH FRAME Dialog-Frame.
     1980     ENABLE b-quit b-mark b-sel b-add b-chg b-del b-lkp b-links b-storage B-Help
     1981            b-prop br-prop-head mark-num
     1982         WITH FRAME Dialog-Frame.
     1983     VIEW FRAME Dialog-Frame.
     1984     OPEN QUERY br-prop-head FOR EACH X_prop-head NO-LOCK BY X_prop-head.dtm-code INDEXED-REPOSITION .
     1985   END PROCEDURE.
     1986   PROCEDURE MyEnable :
     1987   assign
     1988   X_prop-head.prop-name:resizable in browse br-prop-head = yes
     1989   X_prop-head.prop-label:resizable in browse br-prop-head = yes
     1990   b-links:MENU-MOUSE in frame Dialog-Frame = 1
     1991   b-storage:MENU-MOUSE in frame Dialog-Frame = 1
     1992   .
     1993   ENABLE
     1994   b-quit
     1995   b-add when (v-cntxt-db-num = 0 and lookup("b-add", bttns) > 0)
     1996   b-chg when (v-cntxt-db-num = 0 and lookup("b-add", bttns) > 0)
     1997   b-del when (v-cntxt-db-num = 0 and lookup("b-add", bttns) > 0)
     1998   b-prop when (v-cntxt-db-num = 0 and lookup("b-add", bttns) > 0)
     1999   b-storage when lookup("b-storage", bttns) > 0
     2000   b-lkp
     2001   b-links
     2002   B-Help
     2003   b-mark when lookup("b-mark", bttns) > 0
     2004   b-sel when lookup("b-sel", bttns) > 0
     2005   br-prop-head
     2006   WITH FRAME Dialog-Frame.
     2007   VIEW FRAME Dialog-Frame.
     2008   IF NOT (v-cntxt-db-num = 0 and lookup("b-add", bttns) > 0) THEN DO:
     2009     HIDE
     2010     b-prop
     2011     IN FRAME Dialog-Frame.
     2012   END.
     2013   if lookup("b-add", bttns) = 0 then do:
     2014     X_prop-head.prop-name:visible in browse br-prop-head = no.
     2015   end.
     2016   run openbr in this-procedure .
     2017   END PROCEDURE.
     2018   PROCEDURE Openbr :
     2019   CASE p-list-mode:
     2020     WHEN 'все':U THEN DO:
     2021       OPEN QUERY br-prop-head
     2022       FOR EACH X_prop-head NO-LOCK
     2023       by X_prop-head.dtm-code INDEXED-REPOSITION.
     2024     END.
     2025     WHEN "general-view" THEN DO:
     2026       OPEN QUERY br-prop-head
     2027       FOR EACH X_prop-head NO-LOCK  where
     2028               X_prop-head.general-view contains p-general-view
     2029               by X_prop-head.dtm-code
     2030       INDEXED-REPOSITION.
     2031     END.
     2032   END CASE.
     2033   if v-rid-list <> '':U then do:
     2034     reposition br-prop-head to recid integer(entry(1, v-rid-list)) no-error .
     2035     APPLY "ENTRY" to br-prop-head in frame Dialog-Frame .
     2036   end.
     2037   END PROCEDURE.
     2038   PROCEDURE proc-b-link :
     2039   DEFINE INPUT PARAMETER p-option AS CHARACTER NO-UNDO.
     2040   DEFINE VARIABLE v-rec AS RECID NO-UNDO.
     2041   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     2042   CASE p-option:
     2043    WHEN 'prop-map':U THEN DO:
     2044       run rul/prop-map-s.w (
     2045                              input parparentproc
     2046                             ,INPUT (IF (v-cntxt-db-num = 0 and lookup("b-add", bttns) > 0)
     2047                                     THEN 'b-add':U
     2048                                     ELSE '':U)
     2049                             ,INPUT "dtm-code"
     2050                             ,INPUT X_prop-head.dtm-code
     2051                             ,INPUT-OUTPUT v-rid-list) NO-ERROR.
     2052     END.
     2053     WHEN 'prop-script':U THEN DO:
     2054       run rul/prop-script-s.w (
     2055                              input parparentproc
     2056                              ,INPUT (IF (v-cntxt-db-num = 0 and lookup("b-add", bttns) > 0)
     2057                                      THEN 'b-add':U
     2058                                      ELSE '':U)
     2059                             ,INPUT "dtm-code"
     2060                             ,INPUT '':U
     2061                             ,INPUT X_prop-head.dtm-code
     2062                             ,INPUT "":U
     2063                             ,INPUT "":U
     2064                              ,INPUT-OUTPUT v-rid-list) NO-ERROR.
     2065     END.
     2066     WHEN 'prop-ruleset':U THEN DO:
     2067         run rul/prop-ruleset-s.w (
     2068                                input parparentproc
     2069                                ,INPUT (IF (v-cntxt-db-num = 0 and lookup("b-add", bttns) > 0)
     2070                                      THEN 'b-add':U
     2071                                      ELSE '':U)
     2072                               ,INPUT "dtm-code"
     2073                               ,INPUT 0
     2074                               ,INPUT 0
     2075                               ,INPUT X_prop-head.dtm-code
     2076                               ,INPUT-OUTPUT v-rid-list) NO-ERROR.
     2077       END.
     2078   END CASE.
     2079   END PROCEDURE.
     2080   PROCEDURE proc-b-lkp :
     2081   DEFINE VARIABLE v-rec AS RECID NO-UNDO.
     2082   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     2083       v-rec = recid(X_prop-head).
     2084       run rul/prop-head-i.w ( input parparentproc
     2085                              ,input 'ПРОСМОТР':U
     2086                              ,input X_prop-head.dtm-code
     2087                              ,input-output v-rec) no-error.
     2088   END PROCEDURE.
     2089   PROCEDURE proc-b-storage :
     2090   DEFINE INPUT PARAMETER p-storage AS CHARACTER NO-UNDO.
     2091   DEFINE VARIABLE v-storage AS CHARACTER NO-UNDO.
     2092   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     2093   CASE p-storage:
     2094     WHEN 'объект':U THEN DO:
     2095        ASSIGN
     2096        v-storage = X_prop-head.storage-place-obj.
     2097     END.
     2098     WHEN 'фирма':U THEN DO:
     2099         ASSIGN
     2100         v-storage = X_prop-head.storage-place-host.
     2101     END.
     2102     WHEN "global" THEN DO:
     2103         ASSIGN
     2104         v-storage = X_prop-head.storage-place.
     2105     END.
     2106   END CASE.
     2107   CASE v-storage:
     2108     WHEN 'dis-obj':U
     2109     or
     2110     WHEN 'dis-host':U THEN DO:
     2111       run ref/dis-tots.w (
     2112                           INPUT parparentproc
     2113                          ,INPUT '':U
     2114                          ,INPUT v-cntxt-host-code-obj
     2115                          ,INPUT v-cntxt-obj-type
     2116                          ,INPUT v-cntxt-obj-code
     2117                          ,INPUT "dtm-code"
     2118                          ,INPUT p-storage
     2119                          ,INPUT X_prop-head.dtm-code
     2120                          ,INPUT 0
     2121                          ,INPUT-OUTPUT v-rid-list ) NO-ERROR.
     2122     END.
     2123     WHEN 'dis-card-property':U THEN DO:
     2124       run ref/discprps.w (
     2125                           INPUT parparentproc
     2126                          ,INPUT '':U
     2127                          ,INPUT v-cntxt-host-code-obj
     2128                          ,INPUT v-cntxt-obj-type
     2129                          ,INPUT v-cntxt-obj-code
     2130                          ,INPUT "dtm-code"
     2131                          ,INPUT p-storage
     2132                          ,INPUT X_prop-head.dtm-code
     2133                          ,INPUT 0
     2134                          ,INPUT-OUTPUT v-rid-list ) NO-ERROR.
     2135     END.
     2136     when 'chk-doc':U  then do:
     2137       define buffer buf_shop for ub.shop.
     2138       run adm/shops.w ( input parparentproc
     2139                      ,  input "b-sel"
     2140                      , input-output v-rid-list
     2141                      , no).
     2142       if v-rid-list = '':u then return no-apply.
     2143        find first buf_shop no-lock where
     2144              recid(buf_shop) = integer(v-rid-list) no-error.
     2145       if not available buf_shop  then undo, return error.
     2146       v-rid-list = '':U.
     2147       run str/chk-docs.w (
     2148                       input parparentproc
     2149                       ,input '':U
     2150                       ,input 'dis-card':U
     2151                       ,input ?
     2152                       ,input 'маг':U
     2153                       ,input buf_shop.obj-code
     2154                       ,input '':U
     2155                       ,input '':U
     2156                       ,input 0
     2157                       ,input ?
     2158                       ,input ?
     2159                       ,input 0
     2160                       ,output v-rid-list) no-error.
     2161     end.
     2162     when 'chk-discnt':U then do:
     2163       if X_prop-head.dtm-code <> 15 then do:
     2164         MESSAGE
     2165         substitute("Неизвестное хранилище данных &1", v-storage).
     2166       end.
     2167       run adm/shops.w ( input parparentproc
     2168                      ,  input "b-sel"
     2169                      , input-output v-rid-list
     2170                      , no).
     2171       if v-rid-list = '':u then return no-apply.
     2172        find first buf_shop no-lock where
     2173              recid(buf_shop) = integer(v-rid-list) no-error.
     2174       if not available buf_shop  then undo, return error.
     2175       v-rid-list = '':U.
     2176       run str/chkbonus.w (
     2177                       input parparentproc
     2178                       ,input '':U
     2179                       ,input 'объект':U
     2180                       ,input 'маг':U
     2181                       ,input buf_shop.obj-code
     2182                       ,input ?
     2183                       ,input ?
     2184                       ,output v-rid-list) no-error.
     2185     end.
     2186     OTHERWISE DO:
     2187       MESSAGE
     2188       substitute("Неизвестное хранилище данных &1", v-storage).
     2189     END.
     2190   END CASE.
     2191   END PROCEDURE.
     2192   PROCEDURE proc-value-change :
     2193   IF NOT AVAILABLE X_prop-head  THEN DO:
     2194      ASSIGN
     2195      MENU-ITEM m_global:SENSITIVE IN MENU menu-b-storage = NO
     2196      MENU-ITEM m_host:SENSITIVE IN MENU menu-b-storage = NO
     2197      MENU-ITEM m_object:SENSITIVE IN MENU menu-b-storage = NO
     2198      .
     2199   END.
     2200   ELSE DO:
     2201       ASSIGN
     2202       MENU-ITEM m_global:SENSITIVE IN MENU menu-b-storage = (IF X_prop-head.storage-place = '':U
     2203                                                              OR X_prop-head.storage-place = chr(63)
     2204                                                              THEN NO
     2205                                                              ELSE YES)
     2206       MENU-ITEM m_host:SENSITIVE IN MENU menu-b-storage = (IF X_prop-head.storage-place-host = '':U
     2207                                                         OR X_prop-head.storage-place-host = chr(63)
     2208                                                         THEN NO
     2209                                                         ELSE YES)
     2210       MENU-ITEM m_object:SENSITIVE IN MENU menu-b-storage =  (IF X_prop-head.storage-place-obj = '':U
     2211                                                              OR X_prop-head.storage-place-obj = chr(63)
     2212                                                              THEN NO
     2213                                                              ELSE YES)
     2214       .
     2215   END.
     2216   END PROCEDURE.
