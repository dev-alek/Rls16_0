      439   ASSIGN
      440          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      441          FRAME Dialog-Frame:HIDDEN           = TRUE.
      442   ON GO OF FRAME Dialog-Frame
      443   DO:
      444     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
      445     IF ERROR-STATUS:ERROR THEN DO:
      446         RETURN NO-APPLY.
      447     END.
      448   END.
      449   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      450   DO:
      451     APPLY "END-ERROR":U TO SELF.
      452   END.
      453   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      454   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      455   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      456   on help of frame Dialog-Frame
      457   do:
      458     run gbl/app_help.p
      459       (input this-procedure :file-name
      460       ,input ''
      461       ,input ?
      462       ) no-error.
      463     if error-status :error then do:
      464       message
      465         "Ошибка при вызове помощи"
      466         error-status :get-message(1)
      467         view-as alert-box .
      468     end.
      469   end.
      470   run minbtn-set in this-procedure .
      471   on choose of b-help in frame Dialog-Frame
      472   do:
      473     apply "help":u to frame Dialog-Frame .
      474   end.
      475   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      476   procedure minbtn-set :
      477       do
      478           on error undo, return error return-value
      479           :
      480           define variable ii              as integer       no-undo .
      481           define variable fh              as widget-handle no-undo .
      482           define variable hh              as widget-handle no-undo .
      483           define variable v-h             as handle        extent 4 no-undo .
      484           define variable v-name-button   as character     no-undo .
      485           define variable v-help-old-x    as decimal       no-undo .
      486           define variable v-help-old-y    as decimal       no-undo .
      487           define variable v-help-old-size as decimal       no-undo .
      488           define variable v-frame-width   as decimal       no-undo .
      489           define variable jj              as integer       no-undo .
      490           do
      491               on error undo, return error
      492               :
      493               assign
      494                   v-frame-width = frame Dialog-Frame:width - 0.3
      495                   fh            = frame Dialog-Frame:first-child
      496                   hh            = fh:first-child
      497                   ii            = 1
      498                   .
      499               do while valid-handle(hh):
      500                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      501                   do:
      502                       case lc(hh:name) :
      503                           when "b-help" then
      504                               do:
      505                                   hh:load-image-up("cmp/b-help.bmp":u) .
      506                                   hh:load-image-down("cmp/b-help.bmp":u) .
      507                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      508                                   hh:TOOLTIP = "Помощь" .
      509                                   v-help-old-x = hh:column .
      510                                   v-help-old-y = hh:row    .
      511                                   v-help-old-size = hh:width .
      512                                   hh:width-chars = 2.5 .
      513                               end.
      514                           when "b-print" then
      515                               do:
      516                                   hh:load-image("cmp/b-print.bmp":u) .
      517                                   hh:TOOLTIP = "Печать" .
      518                                   v-h[ii] = hh:handle .
      519                                   ii = ii + 1 .
      520                                   hh:width-chars = 3 .
      521                               end.
      522                           when "b-history" or
      523                           when "b-hist" then
      524                               do:
      525                                   hh:load-image("cmp/b-hist.bmp":u) .
      526                                   hh:TOOLTIP = "История" .
      527                                   v-h[ii] = hh:handle .
      528                                   ii = ii + 1 .
      529                                   hh:width-chars = 3 .
      530                               end.
      531                           when "b-sch" then
      532                               do:
      533                                   hh:load-image("cmp/b-sch.bmp":u) .
      534                                   hh:TOOLTIP = "Установка Фильтра" .
      535                                   v-h[ii] = hh:handle .
      536                                   ii = ii + 1 .
      537                                   hh:width-chars = 3 .
      538                               end.
      539                           when "b-hist-user" then
      540                               do:
      541                                   hh:load-image("cmp/b-hist.bmp":u) .
      542                                   hh:TOOLTIP = "История пользователя" .
      543                                   ii = ii + 1 .
      544                               end.
      545                       end case.
      546                   end.
      547                   hh = hh:next-sibling.
      548               end.
      549               b-help:column = v-frame-width - b-help:width-chars.
      550               jj = 0.
      551               repeat ii = 4 to 1 by -1 :
      552                   if valid-handle (v-h[ii] ) then
      553                   do:
      554                       jj  = jj + 1 .
      555                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      556                       v-h[ii]:row    = v-help-old-y .
      557                   end.
      558               end.
      559           end.
      560       end.
      561   end procedure.
      562   MAIN-BLOCK:
      563   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      564      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      565      ON stop UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      566     IF p-mode = 'ДОБАВЛЕНИЕ':U THEN DO:
      567       FIND FIRST first_rule-by-call EXCLUSIVE-LOCK.
      568       CREATE tt-rule-by-call.
      569     END.
      570     else do:
      571       IF p-mode = 'ИЗМЕНЕНИЕ':U THEN DO:
      572         FIND FIRST LOCKED_rule-by-call EXCLUSIVE-LOCK WHERE
      573                   LOCKED_rule-by-call.ruleset_id = p-ruleset-id
      574             AND LOCKED_rule-by-call.codex_id = p-codex-id .
      575       END.
      576       IF p-mode = 'ПРОСМОТР':U THEN DO:
      577           FIND FIRST LOCKED_rule-by-call no-LOCK WHERE
      578                     LOCKED_rule-by-call.ruleset_id = p-ruleset-id
      579               AND LOCKED_rule-by-call.codex_id = p-codex-id NO-ERROR.
      580       END.
      581       create tt-rule-by-call.
      582       buffer-copy locked_rule-by-call to tt-rule-by-call.
      583     end.
      584     RUN Myenable.
      585     WAIT-FOR GO OF FRAME Dialog-Frame.
      586   END.
      587   RUN disable_UI.
      588   PROCEDURE disable_UI :
      589     HIDE FRAME Dialog-Frame.
      590   END PROCEDURE.
      591   PROCEDURE enable_UI :
      592     OPEN QUERY Dialog-Frame FOR EACH tt-rule-by-call SHARE-LOCK.
      593     GET FIRST Dialog-Frame.
      594     IF AVAILABLE tt-rule-by-call THEN
      595       DISPLAY tt-rule-by-call.call#_id tt-rule-by-call.call_id
      596             tt-rule-by-call.codex_id tt-rule-by-call.ruleset_id
      597             tt-rule-by-call.order_id tt-rule-by-call.profile_id
      598             tt-rule-by-call.once-more tt-rule-by-call.rule_id
      599             tt-rule-by-call.is_dynamic tt-rule-by-call.can-calc
      600             tt-rule-by-call.algo-des
      601         WITH FRAME Dialog-Frame.
      602     ENABLE B-exit b-quit tt-rule-by-call.call#_id B-Help tt-rule-by-call.call_id
      603            tt-rule-by-call.codex_id tt-rule-by-call.order_id
      604            tt-rule-by-call.profile_id tt-rule-by-call.once-more
      605            tt-rule-by-call.rule_id tt-rule-by-call.can-calc
      606            tt-rule-by-call.algo-des
      607         WITH FRAME Dialog-Frame.
      608     VIEW FRAME Dialog-Frame.
      609   END PROCEDURE.
      610   PROCEDURE MyEnable :
      611   IF AVAILABLE tt-rule-by-call THEN
      612   DISPLAY
      613   tt-rule-by-call.call#_id
      614   tt-rule-by-call.call_id
      615   tt-rule-by-call.codex_id
      616   tt-rule-by-call.ruleset_id
      617   tt-rule-by-call.order_id
      618   tt-rule-by-call.profile_id
      619   tt-rule-by-call.RULE_id
      620   tt-rule-by-call.algo-des
      621   tt-rule-by-call.can-calc
      622   tt-rule-by-call.is_dynamic
      623   tt-rule-by-call.once-more
      624   WITH FRAME Dialog-Frame .
      625   ENABLE
      626   B-exit  when p-mode <> 'ПРОСМОТР':U
      627   b-quit
      628   B-Help
      629   tt-rule-by-call.can-calc  when p-mode = 'ИЗМЕНЕНИЕ':U AND tt-rule-by-call.IS_dynamic
      630   tt-rule-by-call.algo-des when p-mode = 'ИЗМЕНЕНИЕ':U
      631   WITH FRAME Dialog-Frame .
      632   if p-mode = 'ПРОСМОТР':U then do:
      633     assign
      634     b-quit:label = "&Выход"
      635     b-quit:column = 1.
      636     hide b-exit in frame Dialog-Frame .
      637   end.
      638   VIEW FRAME Dialog-Frame .
      639   END PROCEDURE.
      640   PROCEDURE proc-save :
      641   DEFINE VARIABLE v-rec AS recID  NO-UNDO.
      642   IF p-mode = 'ПРОСМОТР':U THEN DO:
      643       RETURN.
      644   END.
      645   ASSIGN
      646   FRAME Dialog-Frame
      647   tt-rule-by-call.can-calc
      648   tt-rule-by-call.algo-des.
      649   run rul/rule-by-call1.p ( INPUT p-mode
      650                   ,INPUT NO
      651                   ,INPUT-OUTPUT v-rec
      652                   ,input ?
      653                   ,input 0
      654                   ,INPUT tt-rule-by-call.call#_id
      655                   ,INPUT tt-rule-by-call.codex_id
      656                   ,INPUT tt-rule-by-call.ruleset_id
      657                   ,INPUT tt-rule-by-call.order_id
      658                   ,INPUT tt-rule-by-call.call_id
      659                   ,INPUT tt-rule-by-call.RULE_id
      660                   ,INPUT tt-rule-by-call.profile_id
      661                   ,INPUT tt-rule-by-call.once-more
      662                   ,INPUT tt-rule-by-call.is_dynamic
      663                   ,INPUT tt-rule-by-call.can-calc
      664                   ,INPUT tt-rule-by-call.algo-des
      665                    ) no-error.
      666   if error-status:error then do:
      667   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      668   define variable fh as widget-handle no-undo .
      669   define variable hh as widget-handle no-undo .
      670   define variable rv as character no-undo .
      671   assign
      672   rv = entry(1, return-value , chr(4)).
      673   if rv <> "":U then do:
      674     assign
      675     fh = frame Dialog-Frame:first-child
      676     hh = fh:first-child
      677     .
      678     do while valid-handle(hh):
      679       if hh:name = rv then do:
      680         APPLY "ENTRY" to hh.
      681         undo ,
      682         return error.
      683       end.
      684       hh = hh:next-sibling.
      685     end.
      686   end.
      687     undo, return error.
      688   end.
      689   p-rec = v-rec.
      690   END PROCEDURE.
