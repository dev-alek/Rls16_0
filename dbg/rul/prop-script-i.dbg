      514   DO:
      515     DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
      516     DEFINE BUFFER buf_prop-script FOR ub.prop-script.
      517     run rul/prop-script-s.w (
      518                              input parparentproc
      519                             ,INPUT 'b-sel':U
      520                             ,INPUT "dtm-code"
      521                             ,INPUT '':U
      522                             ,INPUT tt-prop-script.dtm-code
      523                             ,INPUT "":U
      524                             ,INPUT "":U
      525                             ,INPUT-OUTPUT v-rid-list) NO-ERROR.
      526    IF ERROR-STATUS:ERROR OR v-rid-list = '':U THEN RETURN NO-APPLY.
      527    FIND FIRST buf_prop-script NO-LOCK WHERE
      528              recid(buf_prop-script) = INTEGER(v-rid-list).
      529    BUFFER-COPY buf_prop-script TO tt-prop-script.
      530    RUN MyEnable IN THIS-PROCEDURE ( input ' Œœ»–Œ¬¿Õ»≈':U) NO-ERROR .
      531   END.
      532   ON CHOOSE OF b-params IN FRAME Dialog-Frame
      533   DO:
      534    DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
      535     DEFINE BUFFER buf_ruledict-param FOR ub.ruledict-param.
      536     IF NOT AVAILABLE buf_ruledict  THEN DO:
      537       MESSAGE
      538       "≈˘Â ÓÚÒÛÚÒÚ‚ÛÂÚ ‚ ÒÎÓ‚‡Â"
      539       VIEW-AS ALERT-BOX.
      540       RETURN NO-APPLY.
      541     END.
      542     find first buf_ruledict-param no-lock where
      543               buf_ruledict-param.entry-id = buf_ruledict.entry-id no-error.
      544     if not available buf_ruledict-param then do:
      545       message
      546       "ÕÂÚ Ô‡‡ÏÂÚÓ‚!"
      547       view-as alert-box error .
      548       undo, return no-apply .
      549     end.
      550     run rul/ruledict-param-s.w ( INPUT parparentproc
      551                               ,input ?
      552                               ,INPUT '':U
      553                               ,INPUT "entry-id"
      554                               ,INPUT buf_ruledict.entry-id
      555                               ,input 'prop-script':U
      556                               ,INPUT-OUTPUT v-rid-list) NO-ERROR.
      557   END.
      558   ON CHOOSE OF b-prop-map IN FRAME Dialog-Frame
      559   DO:
      560      DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
      561   DEFINE BUFFER buf_prop-map FOR ub.prop-map.
      562       run rul/prop-map-s.w (
      563                              input parparentproc
      564                             ,INPUT 'b-sel':U
      565                             ,INPUT "dtm-code"
      566                             ,INPUT tt-prop-script.dtm-code
      567                             ,INPUT-OUTPUT v-rid-list) NO-ERROR.
      568     IF v-rid-list = '':U THEN DO:
      569        RETURN NO-APPLY.
      570     END.
      571     FIND FIRST buf_prop-map NO-LOCK WHERE
      572               RECID(buf_prop-map) = INTEGER(v-rid-list) NO-ERROR.
      573     IF NOT AVAILABLE buf_prop-map THEN RETURN NO-APPLY.
      574     ASSIGN
      575     f-label = buf_prop-map.node-label.
      576     DISPLAY
      577     f-label
      578     WITH FRAME Dialog-Frame.
      579   END.
      580   ON CHOOSE OF b-prop-map-2 IN FRAME Dialog-Frame
      581   DO:
      582       DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
      583    DEFINE BUFFER buf_prop-map FOR ub.prop-map.
      584        run rul/prop-map-s.w (
      585                               input parparentproc
      586                              ,INPUT 'b-sel':U
      587                              ,INPUT "dtm-code"
      588                              ,INPUT tt-prop-script.dtm-code
      589                              ,INPUT-OUTPUT v-rid-list) NO-ERROR.
      590      IF v-rid-list = '':U THEN DO:
      591         RETURN NO-APPLY.
      592      END.
      593      FIND FIRST buf_prop-map NO-LOCK WHERE
      594                RECID(buf_prop-map) = INTEGER(v-rid-list) NO-ERROR.
      595      IF NOT AVAILABLE buf_prop-map THEN RETURN NO-APPLY.
      596      ASSIGN
      597      tt-prop-script.documentation = buf_prop-map.node-description.
      598      DISPLAY
      599      f-label
      600      WITH FRAME Dialog-Frame.
      601   END.
      602   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      603   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      604   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      605   on help of frame Dialog-Frame
      606   do:
      607     run gbl/app_help.p
      608       (input this-procedure :file-name
      609       ,input ''
      610       ,input ?
      611       ) no-error.
      612     if error-status :error then do:
      613       message
      614         "Œ¯Ë·Í‡ ÔË ‚˚ÁÓ‚Â ÔÓÏÓ˘Ë"
      615         error-status :get-message(1)
      616         view-as alert-box .
      617     end.
      618   end.
      619   run minbtn-set in this-procedure .
      620   on choose of b-help in frame Dialog-Frame
      621   do:
      622     apply "help":u to frame Dialog-Frame .
      623   end.
      624   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      625   procedure minbtn-set :
      626       do
      627           on error undo, return error return-value
      628           :
      629           define variable ii              as integer       no-undo .
      630           define variable fh              as widget-handle no-undo .
      631           define variable hh              as widget-handle no-undo .
      632           define variable v-h             as handle        extent 4 no-undo .
      633           define variable v-name-button   as character     no-undo .
      634           define variable v-help-old-x    as decimal       no-undo .
      635           define variable v-help-old-y    as decimal       no-undo .
      636           define variable v-help-old-size as decimal       no-undo .
      637           define variable v-frame-width   as decimal       no-undo .
      638           define variable jj              as integer       no-undo .
      639           do
      640               on error undo, return error
      641               :
      642               assign
      643                   v-frame-width = frame Dialog-Frame:width - 0.3
      644                   fh            = frame Dialog-Frame:first-child
      645                   hh            = fh:first-child
      646                   ii            = 1
      647                   .
      648               do while valid-handle(hh):
      649                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      650                   do:
      651                       case lc(hh:name) :
      652                           when "b-help" then
      653                               do:
      654                                   hh:load-image-up("cmp/b-help.bmp":u) .
      655                                   hh:load-image-down("cmp/b-help.bmp":u) .
      656                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      657                                   hh:TOOLTIP = "œÓÏÓ˘¸" .
      658                                   v-help-old-x = hh:column .
      659                                   v-help-old-y = hh:row    .
      660                                   v-help-old-size = hh:width .
      661                                   hh:width-chars = 2.5 .
      662                               end.
      663                           when "b-print" then
      664                               do:
      665                                   hh:load-image("cmp/b-print.bmp":u) .
      666                                   hh:TOOLTIP = "œÂ˜‡Ú¸" .
      667                                   v-h[ii] = hh:handle .
      668                                   ii = ii + 1 .
      669                                   hh:width-chars = 3 .
      670                               end.
      671                           when "b-history" or
      672                           when "b-hist" then
      673                               do:
      674                                   hh:load-image("cmp/b-hist.bmp":u) .
      675                                   hh:TOOLTIP = "»ÒÚÓËˇ" .
      676                                   v-h[ii] = hh:handle .
      677                                   ii = ii + 1 .
      678                                   hh:width-chars = 3 .
      679                               end.
      680                           when "b-sch" then
      681                               do:
      682                                   hh:load-image("cmp/b-sch.bmp":u) .
      683                                   hh:TOOLTIP = "”ÒÚ‡ÌÓ‚Í‡ ‘ËÎ¸Ú‡" .
      684                                   v-h[ii] = hh:handle .
      685                                   ii = ii + 1 .
      686                                   hh:width-chars = 3 .
      687                               end.
      688                           when "b-hist-user" then
      689                               do:
      690                                   hh:load-image("cmp/b-hist.bmp":u) .
      691                                   hh:TOOLTIP = "»ÒÚÓËˇ ÔÓÎ¸ÁÓ‚‡ÚÂÎˇ" .
      692                                   ii = ii + 1 .
      693                               end.
      694                       end case.
      695                   end.
      696                   hh = hh:next-sibling.
      697               end.
      698               b-help:column = v-frame-width - b-help:width-chars.
      699               jj = 0.
      700               repeat ii = 4 to 1 by -1 :
      701                   if valid-handle (v-h[ii] ) then
      702                   do:
      703                       jj  = jj + 1 .
      704                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      705                       v-h[ii]:row    = v-help-old-y .
      706                   end.
      707               end.
      708           end.
      709       end.
      710   end procedure.
      711   MAIN-BLOCK:
      712   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      713      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      714      ON stop UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      715     IF p-mode = 'ƒŒ¡¿¬À≈Õ»≈':U THEN DO:
      716       FIND FIRST first_prop-script EXCLUSIVE-LOCK.
      717       CREATE tt-prop-script.
      718       ASSIGN
      719       tt-prop-script.LANGUAGE = "ABL"
      720       tt-prop-script.dtm-code = p-dtm-code.
      721     END.
      722     else do:
      723       IF p-mode = ' Œœ»–Œ¬¿Õ»≈':U THEN DO:
      724         v-is-copy = yes.
      725         p-mode = 'ƒŒ¡¿¬À≈Õ»≈':U.
      726         FIND FIRST first_prop-script EXCLUSIVE-LOCK.
      727         FIND FIRST first_prop-script EXCLUSIVE-LOCK.
      728         FIND FIRST LOCKED_prop-script no-lock WHERE
      729                   LOCKED_prop-script.script-name = p-script-name
      730             AND LOCKED_prop-script.LANGUAGE = p-language
      731             AND LOCKED_prop-script.dtm-code = p-dtm-code
      732             AND LOCKED_prop-script.revis_id = p-revis-id
      733             .
      734         create tt-prop-script.
      735         buffer-copy locked_prop-script
      736         to tt-prop-script.
      737         release locked_prop-script.
      738       END.
      739       IF p-mode = '»«Ã≈Õ≈Õ»≈':U THEN DO:
      740         FIND FIRST LOCKED_prop-script EXCLUSIVE-LOCK WHERE
      741                   LOCKED_prop-script.script-name = p-script-name
      742             AND LOCKED_prop-script.LANGUAGE = p-language
      743             AND LOCKED_prop-script.dtm-code = p-dtm-code
      744             AND LOCKED_prop-script.revis_id = p-revis-id
      745             .
      746         create tt-prop-script.
      747         buffer-copy locked_prop-script to tt-prop-script.
      748       END.
      749       IF p-mode = 'œ–Œ—ÃŒ“–':U THEN DO:
      750           FIND FIRST LOCKED_prop-script no-lock WHERE
      751                     LOCKED_prop-script.script-name = p-script-name
      752               AND LOCKED_prop-script.LANGUAGE = p-language
      753               AND LOCKED_prop-script.dtm-code = p-dtm-code
      754               AND LOCKED_prop-script.revis_id = p-revis-id.
      755         create tt-prop-script.
      756         buffer-copy locked_prop-script to tt-prop-script.
      757       END.
      758     end.
      759     RUN Myenable in THIS-PROCEDURE ( input p-mode).
      760     WAIT-FOR GO OF FRAME Dialog-Frame.
      761   END.
      762   RUN disable_UI.
      763   PROCEDURE disable_UI :
      764     HIDE FRAME Dialog-Frame.
      765   END PROCEDURE.
      766   PROCEDURE enable_UI :
      767     OPEN QUERY Dialog-Frame FOR EACH tt-prop-script SHARE-LOCK.
      768     GET FIRST Dialog-Frame.
      769     DISPLAY f-label cb-object-type
      770         WITH FRAME Dialog-Frame.
      771     IF AVAILABLE tt-prop-script THEN
      772       DISPLAY tt-prop-script.dtm-code tt-prop-script.class-dtm-code
      773             tt-prop-script.language tt-prop-script.revis_id
      774             tt-prop-script.script-name tt-prop-script.hidden_
      775             tt-prop-script.documentation tt-prop-script.proc-type
      776             tt-prop-script.script-type tt-prop-script.script-value-type
      777             tt-prop-script.signature tt-prop-script.script-head
      778             tt-prop-script.script-body tt-prop-script.script-foot
      779         WITH FRAME Dialog-Frame.
      780     ENABLE B-exit b-quit tt-prop-script.dtm-code tt-prop-script.class-dtm-code
      781            tt-prop-script.language tt-prop-script.revis_id b-params B-Help
      782            tt-prop-script.script-name b-copy f-label b-prop-map b-prop-map-2
      783            tt-prop-script.hidden_ tt-prop-script.documentation
      784            tt-prop-script.proc-type tt-prop-script.script-type cb-object-type
      785            tt-prop-script.script-value-type tt-prop-script.signature
      786            tt-prop-script.script-head tt-prop-script.script-body
      787            tt-prop-script.script-foot
      788         WITH FRAME Dialog-Frame.
      789     VIEW FRAME Dialog-Frame.
      790   END PROCEDURE.
      791   PROCEDURE MyEnable :
      792   define input parameter p-mode as character no-undo .
      793   define buffer bufcL_prop-script for ub.prop-script.
      794   IF p-mode = '»«Ã≈Õ≈Õ»≈':U
      795   OR p-mode = 'œ–Œ—ÃŒ“–':U
      796   OR (p-mode = 'ƒŒ¡¿¬À≈Õ»≈':U and v-is-copy = yes)
      797   THEN DO:
      798     FIND FIRST buf_Ruledict NO-LOCK WHERE
      799               buf_ruledict.entry-type  = 'prop-script':U
      800             and buf_ruledict.uniq-key-rec  = tt-prop-script.uniq-key-rec no-error.
      801     if available buf_ruledict then do:
      802       f-label = buf_ruledict.script-nl.
      803     end.
      804   END.
      805   if not available buf_ruledict
      806   and (p-mode = '»«Ã≈Õ≈Õ»≈':U or (p-mode = 'ƒŒ¡¿¬À≈Õ»≈':U and v-is-copy = yes))
      807   and lookup(tt-prop-script.proc-type,
      808             (
      809             'data-member':U + chr(44) +
      810             'property':U + chr(44) +
      811             'method':U + chr(44) +
      812             'constructor':U + chr(44) +
      813             'destructor':U)) > 0 then do:
      814     find first bufcl_prop-script no-lock where
      815               bufcl_prop-script.dtm-code = tt-prop-script.dtm-code
      816          and  bufcl_prop-script.language = tt-prop-script.language
      817          and  bufcl_prop-script.script-name  = entry(1, tt-prop-script.script-name, ":") no-error.
      818     if available bufcl_prop-script then do:
      819       FIND FIRST buf_Ruledict NO-LOCK WHERE
      820                 buf_ruledict.entry-type  = 'prop-script':U
      821               and buf_ruledict.uniq-key-rec  = bufcl_prop-script.uniq-key-rec no-error.
      822       if available buf_ruledict then do:
      823         f-label = buf_ruledict.script-nl.
      824       end.
      825     end.
      826   end.
      827   ASSIGN
      828   tt-prop-script.proc-type:LIST-ITEMS IN FRAME Dialog-Frame = 'procedure,function,extern,dll-entry,main,class,data-member,property,method,constructor,destructor':u
      829   tt-prop-script.script-type:LIST-ITEMS IN FRAME Dialog-Frame = 'set,get,get-ifunction,get-set,find,define_b,define_tt,define_h,create,function,ifunction,variable':u
      830   tt-prop-script.script-value-type:LIST-ITEMS IN FRAME Dialog-Frame = 'character,date,decimal,integer,logical':U + chr(44) +
      831                                                                         'handle':U + chr(44) +
      832                                                                         'void':U
      833   cb-object-type:LIST-ITEMS IN FRAME Dialog-Frame = ",r-b,dis-card"
      834   .
      835   ASSIGN
      836   cb-object-type = (if num-entries(tt-prop-script.script-value-type) > 1
      837                     then ENTRY(2, tt-prop-script.script-value-type)
      838                     else '':U)
      839   tt-prop-script.script-value-type =ENTRY(1, tt-prop-script.script-value-type)
      840   .
      841   DISPLAY
      842   f-label
      843   WITH FRAME Dialog-Frame.
      844   IF AVAILABLE tt-prop-script THEN
      845   DISPLAY
      846   tt-prop-script.dtm-code
      847   tt-prop-script.class-dtm-code
      848   tt-prop-script.language
      849   tt-prop-script.script-name
      850   tt-prop-script.revis_id
      851   tt-prop-script.documentation
      852   tt-prop-script.proc-type
      853   tt-prop-script.script-type
      854   tt-prop-script.script-value-type
      855   tt-prop-script.signature
      856   tt-prop-script.script-head
      857   tt-prop-script.script-body
      858   tt-prop-script.script-foot
      859   cb-object-type
      860   tt-prop-script.hidden_
      861   WITH FRAME Dialog-Frame.
      862   assign
      863   tt-prop-script.script-head:read-only in frame Dialog-Frame = (p-mode = 'œ–Œ—ÃŒ“–':U)
      864   tt-prop-script.script-body:read-only in frame Dialog-Frame = (p-mode = 'œ–Œ—ÃŒ“–':U)
      865   tt-prop-script.script-foot:read-only in frame Dialog-Frame = (p-mode = 'œ–Œ—ÃŒ“–':U)
      866   tt-prop-script.documentation:read-only in frame Dialog-Frame = (p-mode = 'œ–Œ—ÃŒ“–':U)
      867   .
      868   ENABLE
      869   B-exit WHEN p-mode <> 'œ–Œ—ÃŒ“–':U
      870   b-quit
      871   b-params WHEN p-mode <> 'ƒŒ¡¿¬À≈Õ»≈':U
      872   B-Help
      873   b-copy WHEN p-mode = 'ƒŒ¡¿¬À≈Õ»≈':U
      874   tt-prop-script.dtm-code WHEN (p-mode = 'ƒŒ¡¿¬À≈Õ»≈':U AND p-dtm-code = ?)
      875   tt-prop-script.class-dtm-code WHEN (p-mode <> 'œ–Œ—ÃŒ“–':U)
      876   tt-prop-script.language WHEN p-mode = 'ƒŒ¡¿¬À≈Õ»≈':U
      877   tt-prop-script.script-name
      878   f-label
      879   b-prop-map WHEN (p-mode <> 'œ–Œ—ÃŒ“–':U AND tt-prop-script.dtm-code > 0)
      880   b-prop-map-2 WHEN (p-mode <> 'œ–Œ—ÃŒ“–':U AND tt-prop-script.dtm-code > 0)
      881   tt-prop-script.documentation
      882   tt-prop-script.proc-type   WHEN p-mode <> 'œ–Œ—ÃŒ“–':U
      883   tt-prop-script.script-type  WHEN p-mode <> 'œ–Œ—ÃŒ“–':U
      884   tt-prop-script.script-value-type WHEN p-mode <> 'œ–Œ—ÃŒ“–':U
      885   tt-prop-script.signature   WHEN p-mode <> 'œ–Œ—ÃŒ“–':U
      886   tt-prop-script.hidden   WHEN p-mode <> 'œ–Œ—ÃŒ“–':U
      887   tt-prop-script.script-head
      888   tt-prop-script.script-body
      889   tt-prop-script.script-foot
      890   cb-object-type WHEN (p-mode = 'ƒŒ¡¿¬À≈Õ»≈':U
      891                        OR (p-mode = '»«Ã≈Õ≈Õ»≈':U
      892                            AND
      893                            cb-object-type <> '':U))
      894   WITH FRAME Dialog-Frame.
      895   VIEW FRAME Dialog-Frame.
      896   if p-mode = 'œ–Œ—ÃŒ“–':U then do:
      897     assign
      898     b-quit:label = "&¬˚ıÓ‰"
      899     b-quit:column = 1
      900     f-label:READ-ONLY IN FRAME Dialog-Frame = YES
      901     tt-prop-script.script-name:READ-ONLY IN FRAME Dialog-Frame = YES.
      902     hide b-exit in frame Dialog-Frame .
      903   end.
      904   if p-mode <> 'ƒŒ¡¿¬À≈Õ»≈':U then do:
      905     tt-prop-script.script-name:READ-ONLY IN FRAME Dialog-Frame = YES.
      906     hide b-copy in frame Dialog-Frame .
      907   end.
      908   END PROCEDURE.
      909   PROCEDURE proc-save :
      910   DEFINE VARIABLE v-rec AS recID  NO-UNDO.
      911   IF p-mode = 'œ–Œ—ÃŒ“–':U THEN DO:
      912       RETURN.
      913   END.
      914   if p-mode = '»«Ã≈Õ≈Õ»≈':U then do:
      915     v-rec = p-rec.
      916   end.
      917   ASSIGN
      918   FRAME Dialog-Frame
      919   f-label
      920   tt-prop-script.dtm-code
      921   tt-prop-script.class-dtm-code
      922   tt-prop-script.language
      923   tt-prop-script.script-name
      924   tt-prop-script.documentation
      925   tt-prop-script.documentation
      926   cb-object-type
      927   tt-prop-script.proc-type
      928   tt-prop-script.script-type
      929   tt-prop-script.script-value-type
      930   tt-prop-script.script-value-type = tt-prop-script.script-value-type + chr(44) + cb-object-type
      931   tt-prop-script.script-head
      932   tt-prop-script.script-body
      933   tt-prop-script.script-foot
      934   tt-prop-script.signature
      935   tt-prop-script.HIDDEN_
      936   .
      937   run rul/prop-script1.p ( INPUT p-mode
      938                   ,INPUT NO
      939                   ,INPUT-OUTPUT v-rec
      940                   ,INPUT tt-prop-script.dtm-code
      941                   ,INPUT tt-prop-script.language
      942                   ,INPUT tt-prop-script.script-name
      943                   ,input tt-prop-script.revis_id
      944                   ,input f-label
      945                   ,input tt-prop-script.class-dtm-code
      946                   ,INPUT tt-prop-script.documentation
      947                   ,INPUT tt-prop-script.proc-type
      948                   ,INPUT tt-prop-script.script-type
      949                   ,INPUT tt-prop-script.script-value-type
      950                   ,INPUT tt-prop-script.script-head
      951                   ,INPUT tt-prop-script.script-body
      952                   ,INPUT tt-prop-script.script-foot
      953                   ,INPUT tt-prop-script.signature
      954                   ,INPUT tt-prop-script.HIDDEN_
      955                   ) no-error.
      956   if error-status:error then do:
      957   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      958   define variable fh as widget-handle no-undo .
      959   define variable hh as widget-handle no-undo .
      960   define variable rv as character no-undo .
      961   assign
      962   rv = entry(1, return-value , chr(4)).
      963   if rv <> "":U then do:
      964     assign
      965     fh = frame Dialog-Frame:first-child
      966     hh = fh:first-child
      967     .
      968     do while valid-handle(hh):
      969       if hh:name = rv then do:
      970         APPLY "ENTRY" to hh.
      971         undo ,
      972         return error.
      973       end.
      974       hh = hh:next-sibling.
      975     end.
      976   end.
      977     undo, return error.
      978   end.
      979   p-rec = v-rec.
      980   END PROCEDURE.
