      500   ASSIGN
      501          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      502          FRAME Dialog-Frame:HIDDEN           = TRUE.
      503   ON GO OF FRAME Dialog-Frame
      504   DO:
      505     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
      506     IF ERROR-STATUS:ERROR THEN DO:
      507         RETURN NO-APPLY.
      508     END.
      509   END.
      510   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      511   DO:
      512     APPLY "END-ERROR":U TO SELF.
      513   END.
      514   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
      515   DO:
      516   define variable v-longchar as longchar no-undo .
      517   define variable v-ok as logical no-undo .
      518   DEFINE BUFFER buf_clob-data FOR ub.clob-data.
      519   DEFINE BUFFER buf_clob-bind FOR ub.clob-bind.
      520   FOR first buf_clob-data NO-LOCK where
      521            buf_clob-data.db-num = 0
      522     AND buf_clob-data.file-name = tt-ruledict-param.init-value-character
      523    ,
      524   FIRST  buf_clob-bind NO-LOCK where
      525      buf_clob-bind.resource-type = 'gate':U
      526   AND buf_clob-bind.db-num = buf_clob-data.db-num
      527   AND buf_clob-data.int64-id = buf_clob-bind.int64-id:
      528       LEAVE .
      529   END.
      530   v-longchar = buf_clob-data.cdata.
      531   run gbl/d-longchar.w (
      532                          input ?
      533                         ,input (
      534                                   'title=':u + "XSD-схема" + '\':u
      535                                 + 'Editor_row=2\':u
      536                                 + 'Editor_col=1\':u
      537                                 + 'Editor_width=96\':u
      538                                 + 'Editor_height=15\':u
      539                                 + 'readonly=yes\':u)
      540                         ,input-output v-longchar
      541                         ,output v-ok ) no-error .
      542   assign
      543   v-longchar = '':U.
      544   END.
      545   ON VALUE-CHANGED OF tt-ruledict-param.param-data-type IN FRAME Dialog-Frame
      546   DO:
      547     ASSIGN
      548     tt-ruledict-param.param-data-type.
      549     RUN switch-data-type IN THIS-PROCEDURE .
      550   END.
      551   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      552   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      553   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      554   on help of frame Dialog-Frame
      555   do:
      556     run gbl/app_help.p
      557       (input this-procedure :file-name
      558       ,input ''
      559       ,input ?
      560       ) no-error.
      561     if error-status :error then do:
      562       message
      563         "Ошибка при вызове помощи"
      564         error-status :get-message(1)
      565         view-as alert-box .
      566     end.
      567   end.
      568   run minbtn-set in this-procedure .
      569   on choose of b-help in frame Dialog-Frame
      570   do:
      571     apply "help":u to frame Dialog-Frame .
      572   end.
      573   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      574   procedure minbtn-set :
      575       do
      576           on error undo, return error return-value
      577           :
      578           define variable ii              as integer       no-undo .
      579           define variable fh              as widget-handle no-undo .
      580           define variable hh              as widget-handle no-undo .
      581           define variable v-h             as handle        extent 4 no-undo .
      582           define variable v-name-button   as character     no-undo .
      583           define variable v-help-old-x    as decimal       no-undo .
      584           define variable v-help-old-y    as decimal       no-undo .
      585           define variable v-help-old-size as decimal       no-undo .
      586           define variable v-frame-width   as decimal       no-undo .
      587           define variable jj              as integer       no-undo .
      588           do
      589               on error undo, return error
      590               :
      591               assign
      592                   v-frame-width = frame Dialog-Frame:width - 0.3
      593                   fh            = frame Dialog-Frame:first-child
      594                   hh            = fh:first-child
      595                   ii            = 1
      596                   .
      597               do while valid-handle(hh):
      598                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      599                   do:
      600                       case lc(hh:name) :
      601                           when "b-help" then
      602                               do:
      603                                   hh:load-image-up("cmp/b-help.bmp":u) .
      604                                   hh:load-image-down("cmp/b-help.bmp":u) .
      605                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      606                                   hh:TOOLTIP = "Помощь" .
      607                                   v-help-old-x = hh:column .
      608                                   v-help-old-y = hh:row    .
      609                                   v-help-old-size = hh:width .
      610                                   hh:width-chars = 2.5 .
      611                               end.
      612                           when "b-print" then
      613                               do:
      614                                   hh:load-image("cmp/b-print.bmp":u) .
      615                                   hh:TOOLTIP = "Печать" .
      616                                   v-h[ii] = hh:handle .
      617                                   ii = ii + 1 .
      618                                   hh:width-chars = 3 .
      619                               end.
      620                           when "b-history" or
      621                           when "b-hist" then
      622                               do:
      623                                   hh:load-image("cmp/b-hist.bmp":u) .
      624                                   hh:TOOLTIP = "История" .
      625                                   v-h[ii] = hh:handle .
      626                                   ii = ii + 1 .
      627                                   hh:width-chars = 3 .
      628                               end.
      629                           when "b-sch" then
      630                               do:
      631                                   hh:load-image("cmp/b-sch.bmp":u) .
      632                                   hh:TOOLTIP = "Установка Фильтра" .
      633                                   v-h[ii] = hh:handle .
      634                                   ii = ii + 1 .
      635                                   hh:width-chars = 3 .
      636                               end.
      637                           when "b-hist-user" then
      638                               do:
      639                                   hh:load-image("cmp/b-hist.bmp":u) .
      640                                   hh:TOOLTIP = "История пользователя" .
      641                                   ii = ii + 1 .
      642                               end.
      643                       end case.
      644                   end.
      645                   hh = hh:next-sibling.
      646               end.
      647               b-help:column = v-frame-width - b-help:width-chars.
      648               jj = 0.
      649               repeat ii = 4 to 1 by -1 :
      650                   if valid-handle (v-h[ii] ) then
      651                   do:
      652                       jj  = jj + 1 .
      653                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      654                       v-h[ii]:row    = v-help-old-y .
      655                   end.
      656               end.
      657           end.
      658       end.
      659   end procedure.
      660   MAIN-BLOCK:
      661   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      662      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      663      ON stop UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      664   if valid-handle(p-update-proc-handle) then do:
      665     run fill-ruledict-param in p-update-proc-handle ( input buffer tt-ruledict-param:handle
      666                                                      ,input p-mode
      667                                                      ) no-error.
      668     if error-status:error then do:
      669       MESSAGE
      670       substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      671       VIEW-AS ALERT-BOX ERROR.
      672       undo main-block, return error.
      673     end.
      674    v-entry-type = p-entry-type.
      675   end.
      676   else do:
      677     IF p-entry-id = 0 THEN DO:
      678       MESSAGE "Не задан ID термина в словаре"
      679       VIEW-AS ALERT-BOX ERROR.
      680       UNDO, RETURN ERROR.
      681     END.
      682   end.
      683   IF p-mode = 'ДОБАВЛЕНИЕ':U THEN DO:
      684     FIND FIRST locked_ruledict EXCLUSIVE-LOCK WHERE
      685             LOCKED_ruledict.entry-id = p-entry-id .
      686     CREATE tt-ruledict-param.
      687     FIND LAST LAST_ruledict-param NO-LOCK WHERE
      688             last_ruledict-param.entry-id = p-entry-id
      689           NO-ERROR.
      690     ASSIGN
      691     tt-ruledict-param.param-num = (IF AVAILABLE LAST_ruledict-param
      692                                   THEN LAST_ruledict-param.param-num + 1
      693                                   ELSE 1)
      694     tt-ruledict-param.entry-id = p-entry-id
      695     .
      696   END.
      697   else do:
      698     IF p-mode = 'ИЗМЕНЕНИЕ':U THEN DO:
      699         FIND FIRST locked_ruledict EXCLUSIVE-LOCK WHERE
      700                 LOCKED_ruledict.entry-id = p-entry-id .
      701         FIND FIRST locked_ruledict-param EXCLUSIVE-LOCK WHERE
      702                 LOCKED_ruledict-param.entry-id = p-entry-id
      703             AND LOCKED_ruledict-param.LANGUAGE = p-language
      704             AND LOCKED_ruledict-param.param-num = p-param-num.
      705     END.
      706     IF p-mode = 'ПРОСМОТР':U THEN DO:
      707         FIND FIRST locked_ruledict no-lock WHERE
      708                 LOCKED_ruledict.entry-id = p-entry-id
      709             .
      710         FIND FIRST locked_ruledict-param no-LOCK WHERE
      711                 LOCKED_ruledict-param.entry-id = p-entry-id
      712             AND LOCKED_ruledict-param.LANGUAGE = p-language
      713             AND LOCKED_ruledict-param.param-num = p-param-num.
      714     END.
      715   end.
      716   if not valid-handle(p-update-proc-handle) then do:
      717     create tt-ruledict-param.
      718     buffer-copy locked_ruledict-param to tt-ruledict-param.
      719     v-entry-type = locked_ruledict.entry-type.
      720   end.
      721   RUN Myenable in this-procedure .
      722   WAIT-FOR GO OF FRAME Dialog-Frame.
      723   END.
      724   RUN disable_UI.
      725   PROCEDURE disable_UI :
      726     HIDE FRAME Dialog-Frame.
      727   END PROCEDURE.
      728   PROCEDURE enable_UI :
      729     OPEN QUERY Dialog-Frame FOR EACH tt-ruledict-param SHARE-LOCK.
      730     GET FIRST Dialog-Frame.
      731     DISPLAY rs-list t-read-only t-hidden cb-object-type t-printable t-temp
      732             t-container
      733         WITH FRAME Dialog-Frame.
      734     IF AVAILABLE tt-ruledict-param THEN
      735       DISPLAY tt-ruledict-param.entry-id tt-ruledict-param.param-num
      736             tt-ruledict-param.language tt-ruledict-param.param-mode
      737             tt-ruledict-param.param-data-type tt-ruledict-param.param-name
      738             tt-ruledict-param.param-label tt-ruledict-param.init-value-character
      739             tt-ruledict-param.init-value-date tt-ruledict-param.init-value-decimal
      740             tt-ruledict-param.init-value-integer
      741             tt-ruledict-param.init-value-logical tt-ruledict-param.documentation
      742         WITH FRAME Dialog-Frame.
      743     ENABLE B-exit b-quit tt-ruledict-param.entry-id tt-ruledict-param.param-num
      744            tt-ruledict-param.language b-lkp B-Help rs-list
      745            tt-ruledict-param.param-mode tt-ruledict-param.param-data-type
      746            t-read-only t-hidden cb-object-type t-printable
      747            tt-ruledict-param.param-name t-temp tt-ruledict-param.param-label
      748            tt-ruledict-param.init-value-character
      749            tt-ruledict-param.init-value-date t-container
      750            tt-ruledict-param.init-value-decimal
      751            tt-ruledict-param.init-value-integer
      752            tt-ruledict-param.init-value-logical tt-ruledict-param.documentation
      753         WITH FRAME Dialog-Frame.
      754     VIEW FRAME Dialog-Frame.
      755   END PROCEDURE.
      756   PROCEDURE MyEnable :
      757   ASSIGN
      758   frame Dialog-Frame :title = substitute("Параметр &1 термина &2 тип термина &3", tt-ruledict-param.param-num, locked_ruledict.script-al, locked_ruledict.entry-type)
      759   tt-ruledict-param.param-data-type:LIST-ITEMS IN FRAME Dialog-Frame = 'character,date,decimal,integer,logical':U + chr(44) + 'longchar':U
      760   tt-ruledict-param.param-mode:LIST-ITEMS IN FRAME Dialog-Frame = 'input,output,input-output,buffer,input table,output table,input-output table':u
      761   cb-object-type:LIST-ITEMS IN FRAME Dialog-Frame = chr(44) + 'r-b':U +
      762                                                      chr(44) + 'period-type':U +
      763                                                      chr(44) + 'output-type':U +
      764                                                      chr(44) + 'dis-rule':U +
      765                                                      chr(44) + 'prop-ref':U +
      766                                                      chr(44) + 'clients':U +
      767                                                      chr(44) + 'clients':U + "_null" +
      768                                                      chr(44) + 'sysconf':U +
      769                                                      chr(44) + 'cli-grp':U +
      770                                                      chr(44) + 'shop':U +
      771                                                      chr(44) + 'ext-system':U +
      772                                                      chr(44) + 'gds-discnt-role,subtotal-discnt-role,pay-discnt-role':U +
      773                                                      chr(44) + 'goods':U + "_null" +
      774                                                      chr(44) + 'discnt-v-type-manual':U +
      775                                                      chr(44) + 'cash-pay':U + "_null" +
      776                                                      chr(44) + 'dis-card':U + "_null" +
      777                                                      chr(44) + 'chk-doc':U + "_wth-type_null" +
      778                                                      chr(44) + 'chk-doc':U + "_wth-type" +
      779                                                      chr(44) + "xsd" +
      780                                                      chr(44) + "sub-type" +
      781                                                      chr(44) + "output-type" +
      782                                                      chr(44) + "dataset" +
      783                                                      chr(44) + "id"
      784   cb-object-type = tt-ruledict-param.param-2-data-type
      785   rs-list = (if lookup("LIST", tt-ruledict-param.param-3-data-type) > 0 then "LIST" else rs-list)
      786   rs-list = (if lookup("SORTED-LIST", tt-ruledict-param.param-3-data-type) > 0 then "SORTED-LIST" else rs-list)
      787   t-READ-ONLY = lookup("READ-ONLY", tt-ruledict-param.param-3-data-type) > 0
      788   t-hidden = lookup("hidden", tt-ruledict-param.param-3-data-type) > 0
      789   t-printable = lookup("printable", tt-ruledict-param.param-3-data-type) > 0
      790   t-temp = lookup("temp", tt-ruledict-param.param-3-data-type) > 0
      791   t-container = lookup("container", tt-ruledict-param.param-3-data-type) > 0
      792   .
      793   IF AVAILABLE tt-ruledict-param THEN
      794   DISPLAY
      795   tt-ruledict-param.entry-id
      796   tt-ruledict-param.param-mode
      797   tt-ruledict-param.param-data-type
      798   tt-ruledict-param.LANGUAGE
      799   tt-ruledict-param.param-num
      800   tt-ruledict-param.param-name
      801   tt-ruledict-param.param-label
      802   tt-ruledict-param.init-value-character WHEN tt-ruledict-param.param-data-type = 'character':U
      803   tt-ruledict-param.init-value-date WHEN tt-ruledict-param.param-data-type = 'date':U
      804   tt-ruledict-param.init-value-decimal WHEN tt-ruledict-param.param-data-type = 'decimal':U
      805   tt-ruledict-param.init-value-integer WHEN tt-ruledict-param.param-data-type = 'integer':U
      806   tt-ruledict-param.init-value-logical WHEN tt-ruledict-param.param-data-type = 'logical':U
      807   tt-ruledict-param.documentation
      808   cb-object-type
      809   rs-list
      810   t-read-only
      811   t-hidden
      812   t-printable
      813   t-temp
      814   t-container
      815   WITH FRAME Dialog-Frame .
      816   ENABLE
      817   B-exit  when p-mode <> 'ПРОСМОТР':U
      818   b-quit
      819   B-Help
      820   tt-ruledict-param.param-mode when p-mode <> 'ПРОСМОТР':U
      821   tt-ruledict-param.param-data-type when p-mode <> 'ПРОСМОТР':U
      822   tt-ruledict-param.param-name       when p-mode <> 'ПРОСМОТР':U
      823   tt-ruledict-param.param-label when p-mode <> 'ПРОСМОТР':U
      824   tt-ruledict-param.documentation
      825   cb-object-type when p-mode <> 'ПРОСМОТР':U
      826   rs-list when p-mode <> 'ПРОСМОТР':U
      827   t-read-only when p-mode <> 'ПРОСМОТР':U
      828   t-hidden when p-mode <> 'ПРОСМОТР':U
      829   t-printable when p-mode <> 'ПРОСМОТР':U
      830   t-temp when p-mode <> 'ПРОСМОТР':U
      831   t-container when p-mode <> 'ПРОСМОТР':U
      832   b-lkp WHEN p-mode = 'ПРОСМОТР':U AND tt-ruledict-param.param-2-data-type = "xsd"
      833   WITH FRAME Dialog-Frame .
      834   IF NOT (v-entry-type = 'prop-script':U
      835           or
      836           v-entry-type = 'rule':U
      837           or
      838           v-entry-type = 'rule-profile':U
      839           )
      840           THEN DO:
      841    HIDE
      842    cb-object-type
      843    IN FRAME Dialog-Frame.
      844   END.
      845   else do:
      846   end.
      847   if p-mode = 'ПРОСМОТР':U then do:
      848     assign
      849     b-quit:label = "&Выход"
      850     b-quit:column = 1
      851     tt-ruledict-param.documentation :read-only in frame Dialog-Frame = yes
      852     .
      853     hide b-exit in frame Dialog-Frame .
      854   end.
      855   VIEW FRAME Dialog-Frame .
      856   RUN switch-data-type IN THIS-PROCEDURE .
      857   END PROCEDURE.
      858   PROCEDURE proc-save :
      859   DEFINE VARIABLE v-rec AS recID  NO-UNDO.
      860   define variable v-param-3-data-type as character no-undo.
      861   IF p-mode = 'ПРОСМОТР':U THEN DO:
      862       RETURN.
      863   END.
      864   ASSIGN
      865   FRAME Dialog-Frame
      866   tt-ruledict-param.entry-id
      867   tt-ruledict-param.LANGUAGE
      868   tt-ruledict-param.param-mode
      869   tt-ruledict-param.param-num
      870   tt-ruledict-param.param-name
      871   tt-ruledict-param.param-label
      872   cb-object-type
      873   rs-list
      874   t-read-only
      875   t-hidden
      876   t-printable
      877   t-temp
      878   t-container
      879   tt-ruledict-param.param-data-type
      880   tt-ruledict-param.param-2-data-type = (if cb-object-type <> ? then cb-object-type else '')
      881   v-param-3-data-type = (if rs-list = "" then "" else  rs-list)
      882   v-param-3-data-type = v-param-3-data-type +
      883                         (if v-param-3-data-type = "" then "" else chr(44)) +
      884                         (if t-read-only then "READ-ONLY" else "")
      885   v-param-3-data-type = v-param-3-data-type +
      886                         (if v-param-3-data-type = "" then "" else chr(44)) +
      887                         (if t-hidden then "HIDDEN" else "")
      888    v-param-3-data-type = v-param-3-data-type +
      889                             (if v-param-3-data-type = "" then "" else chr(44)) +
      890                             (if t-printable then "PRINTABLE" else "")
      891    v-param-3-data-type = v-param-3-data-type +
      892                             (if v-param-3-data-type = "" then "" else chr(44)) +
      893                             (if t-temp then "TEMP" else "")
      894   v-param-3-data-type = v-param-3-data-type +
      895                             (if v-param-3-data-type = "" then "" else chr(44)) +
      896                             (if t-container then "CONTAINER" else "")
      897   v-param-3-data-type = replace(v-param-3-data-type, chr(44) + chr(44), chr(44))
      898   v-param-3-data-type = trim(v-param-3-data-type, chr(44))
      899   tt-ruledict-param.param-3-data-type = v-param-3-data-type
      900   tt-ruledict-param.documentation
      901   .
      902   if tt-ruledict-param.init-value-character:visible in frame Dialog-Frame then do:
      903     assign
      904     tt-ruledict-param.init-value-character
      905     tt-ruledict-param.init-value-date       = ?
      906     tt-ruledict-param.init-value-decimal    = 0.0
      907     tt-ruledict-param.init-value-integer    = 0
      908     tt-ruledict-param.init-value-logical    = no
      909     .
      910   end.
      911   if tt-ruledict-param.init-value-date:visible in frame Dialog-Frame then do:
      912     assign
      913     tt-ruledict-param.init-value-character  = '':U
      914     tt-ruledict-param.init-value-date
      915     tt-ruledict-param.init-value-decimal    = 0.0
      916     tt-ruledict-param.init-value-integer    = 0
      917     tt-ruledict-param.init-value-logical    = no
      918     .
      919   end.
      920   if tt-ruledict-param.init-value-decimal:visible in frame Dialog-Frame then do:
      921     assign
      922     tt-ruledict-param.init-value-character  = '':U
      923     tt-ruledict-param.init-value-date       = ?
      924     tt-ruledict-param.init-value-decimal
      925     tt-ruledict-param.init-value-integer    = 0
      926     tt-ruledict-param.init-value-logical    = no
      927     .
      928   end.
      929   if tt-ruledict-param.init-value-integer:visible in frame Dialog-Frame then do:
      930     assign
      931     tt-ruledict-param.init-value-character  = '':U
      932     tt-ruledict-param.init-value-date       = ?
      933     tt-ruledict-param.init-value-decimal    = 0.0
      934     tt-ruledict-param.init-value-integer
      935     tt-ruledict-param.init-value-logical    = no
      936     .
      937   end.
      938   if tt-ruledict-param.init-value-logical:visible in frame Dialog-Frame then do:
      939     assign
      940     tt-ruledict-param.init-value-character  = '':U
      941     tt-ruledict-param.init-value-date       = ?
      942     tt-ruledict-param.init-value-decimal    = 0.0
      943     tt-ruledict-param.init-value-integer    = 0
      944     tt-ruledict-param.init-value-logical
      945     .
      946   end.
      947   v-rec = p-rec.
      948   if valid-handle(p-update-proc-handle) then do:
      949     run save-ruledict-param in p-update-proc-handle ( input buffer tt-ruledict-param:handle
      950                                                      ,input p-mode
      951                                                      ,output v-rec
      952                                                     ) no-error.
      953   end.
      954   else do:
      955     run rul/ruledict-param1.p ( INPUT p-mode
      956                     ,INPUT NO
      957                     ,INPUT-OUTPUT v-rec
      958                     ,INPUT tt-ruledict-param.entry-id
      959                     ,INPUT tt-ruledict-param.LANGUAGE
      960                     ,INPUT tt-ruledict-param.param-num
      961                     ,INPUT tt-ruledict-param.param-name
      962                     ,INPUT tt-ruledict-param.param-label
      963                     ,INPUT tt-ruledict-param.param-data-type
      964                     ,INPUT tt-ruledict-param.param-2-data-type
      965                     ,INPUT tt-ruledict-param.param-3-data-type
      966                     ,INPUT tt-ruledict-param.param-mode
      967                     ,INPUT tt-ruledict-param.documentation
      968                     ,INPUT tt-ruledict-param.init-value-character
      969                     ,INPUT tt-ruledict-param.init-value-date
      970                     ,INPUT tt-ruledict-param.init-value-decimal
      971                     ,INPUT tt-ruledict-param.init-value-integer
      972                     ,INPUT tt-ruledict-param.init-value-logical
      973                   ) no-error.
      974   end.
      975   if error-status:error then do:
      976   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      977   define variable fh as widget-handle no-undo .
      978   define variable hh as widget-handle no-undo .
      979   define variable rv as character no-undo .
      980   assign
      981   rv = entry(1, return-value , chr(4)).
      982   if rv <> "":U then do:
      983     assign
      984     fh = frame Dialog-Frame:first-child
      985     hh = fh:first-child
      986     .
      987     do while valid-handle(hh):
      988       if hh:name = rv then do:
      989         APPLY "ENTRY" to hh.
      990         undo ,
      991         return error.
      992       end.
      993       hh = hh:next-sibling.
      994     end.
      995   end.
      996     undo, return error.
      997   end.
      998   p-rec = v-rec.
      999   END PROCEDURE.
     1000   PROCEDURE switch-data-type :
     1001   HIDE
     1002   tt-ruledict-param.init-value-character  IN FRAME Dialog-Frame
     1003   tt-ruledict-param.init-value-date
     1004   tt-ruledict-param.init-value-decimal
     1005   tt-ruledict-param.init-value-integer
     1006   tt-ruledict-param.init-value-logical
     1007   .
     1008   DISABLE
     1009   tt-ruledict-param.init-value-character
     1010   tt-ruledict-param.init-value-date
     1011   tt-ruledict-param.init-value-decimal
     1012   tt-ruledict-param.init-value-integer
     1013   tt-ruledict-param.init-value-logical
     1014   with FRAME Dialog-Frame.
     1015   CASE tt-ruledict-param.param-data-type:
     1016     WHEN 'character':U
     1017     THEN DO:
     1018        DISPLAY
     1019        tt-ruledict-param.init-value-character
     1020        WITH FRAME Dialog-Frame.
     1021        ENABLE
     1022        tt-ruledict-param.init-value-character WHEN p-mode <> 'ПРОСМОТР':U
     1023        WITH FRAME Dialog-Frame.
     1024     END.
     1025     WHEN 'longchar':U then do:
     1026        DISPLAY
     1027        tt-ruledict-param.init-value-character
     1028        WITH FRAME Dialog-Frame.
     1029        ENABLE
     1030        tt-ruledict-param.init-value-character  WHEN p-mode <> 'ПРОСМОТР':U
     1031        WITH FRAME Dialog-Frame.
     1032     end.
     1033     WHEN 'date':U THEN DO:
     1034        DISPLAY
     1035        tt-ruledict-param.init-value-date
     1036        WITH FRAME Dialog-Frame.
     1037        ENABLE
     1038        tt-ruledict-param.init-value-date WHEN p-mode <> 'ПРОСМОТР':U
     1039        WITH FRAME Dialog-Frame.
     1040     END.
     1041     WHEN 'decimal':U THEN DO:
     1042        DISPLAY
     1043        tt-ruledict-param.init-value-decimal
     1044        WITH FRAME Dialog-Frame.
     1045        ENABLE
     1046        tt-ruledict-param.init-value-decimal WHEN p-mode <> 'ПРОСМОТР':U
     1047        WITH FRAME Dialog-Frame.
     1048     END.
     1049     WHEN 'integer':U THEN DO:
     1050        DISPLAY
     1051        tt-ruledict-param.init-value-integer
     1052        WITH FRAME Dialog-Frame.
     1053        ENABLE
     1054        tt-ruledict-param.init-value-integer WHEN p-mode <> 'ПРОСМОТР':U
     1055        WITH FRAME Dialog-Frame.
     1056     END.
     1057     WHEN 'logical':U THEN DO:
     1058        DISPLAY
     1059        tt-ruledict-param.init-value-logical
     1060        WITH FRAME Dialog-Frame.
     1061        ENABLE
     1062        tt-ruledict-param.init-value-logical WHEN p-mode <> 'ПРОСМОТР':U
     1063        WITH FRAME Dialog-Frame.
     1064     END.
     1065   END CASE.
     1066   END PROCEDURE.
