     1497   .
     1498   procedure get-header-by-rec :
     1499   define input  parameter p-gate-rec as character no-undo .
     1500   define output parameter p-tth as handle no-undo .
     1501   define variable v-ii as integer   no-undo .
     1502   define variable glog as logical   no-undo .
     1503   define variable v-rowid as rowid no-undo .
     1504   define variable v-tbl-name as character no-undo .
     1505   define variable v-longchar as longchar no-undo .
     1506   define variable v-txmlh as handle no-undo .
     1507   define buffer buf_clob-data for ub.clob-data.
     1508   main-block:
     1509   do
     1510   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info10, return-value, chr(10), error-status :get-message (1))
     1511   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info10 )
     1512   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info10 )
     1513   :
     1514     run gen-row-keyr in  this-procedure  (
     1515                                           input  p-gate-rec
     1516                                           ,input  ?
     1517                                           ,input  "ub"
     1518                                           ,input  ?
     1519                                           ,input  NO-LOCK
     1520                                           ,output v-rowid
     1521                                           ,output v-tbl-name   ) no-error.
     1522       find first buf_clob-data no-lock where
     1523                 rowid(buf_clob-data) = v-rowid  no-error.
     1524       if not available buf_clob-data then do:
     1525         undo, return error substitute("Не найден CLOB  &1"
     1526                                         , p-gate-rec
     1527                                         ).
     1528       end.
     1529       assign
     1530       v-longchar = buf_clob-data.cdata
     1531       .
     1532       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1533       if error-status :error then do:
     1534         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1535       end.
     1536       create temp-table p-tth .
     1537       glog = p-tth:READ-XMLSCHEMA( "LONGCHAR"
     1538                                     , v-longchar
     1539                                     , ?
     1540                                     , ?
     1541                                     , ?
     1542                                     ) no-error.
     1543       v-longchar = '':U.
     1544       define variable v-esm as character no-undo .
     1545       v-esm = error-status:get-message(1).
     1546       if error-status :error
     1547       or not glog
     1548       then do:
     1549         delete object p-tth no-error.
     1550         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     1551                                    , p-gate-rec
     1552                                    , buf_clob-data.file-name_
     1553                                    , chr(10)
     1554                                    , v-esm
     1555                                     ).
     1556       end.
     1557   end.
     1558   end procedure.
     1559   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1560   define new global shared variable g#trdcalib as handle no-undo.
     1561   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1562   procedure statq_has-waiting-stat :
     1563   define input parameter p-oldbh              as handle no-undo .
     1564   define input parameter p-newbh              as handle no-undo .
     1565   define input parameter p-changed-fields     as character no-undo .
     1566   define input parameter p-waiting-status     as character no-undo .
     1567   define input parameter p-waiting-flag       as logical no-undo .
     1568   define input parameter p-waiting-stati      as integer no-undo .
     1569   define output parameter p-is-waiting-status as logical no-undo .
     1570   define output parameter p-direction         as character no-undo .
     1571   define variable v-has-newbh as logical no-undo .
     1572   define variable v-has-oldbh as logical no-undo .
     1573   define variable v-changed-fields as character no-undo .
     1574   define variable v-ii as integer no-undo .
     1575   define variable v-flag as logical   no-undo .
     1576   define variable v-some-bh as handle no-undo .
     1577   assign
     1578   v-has-oldbh = valid-handle(p-oldbh) and p-oldbh:available
     1579   v-has-newbh = valid-handle(p-newbh) and p-newbh:available
     1580   v-flag = false
     1581   .
     1582   if v-has-newbh then do:
     1583     if p-changed-fields = '' then do:
     1584       v-changed-fields = "status_,flag_".
     1585       do v-ii = 1 to num-entries(v-changed-fields):
     1586         if p-oldbh:buffer-field(entry(v-ii, v-changed-fields)):buffer-value <> p-newbh:buffer-field(entry(v-ii, v-changed-fields)):buffer-value then do:
     1587           v-flag = yes.
     1588           leave.
     1589         end.
     1590       end.
     1591       if not v-flag then do:
     1592          assign
     1593            p-direction          = ""
     1594            p-is-waiting-status   = false
     1595          .
     1596          return .
     1597       end.
     1598     end.
     1599     else do:
     1600       if lookup("status_", p-changed-fields) = 0
     1601       and lookup("flag_", p-changed-fields) = 0
     1602       and not(p-newbh:new) then do:
     1603          assign
     1604            p-direction          = ""
     1605            p-is-waiting-status   = false
     1606          .
     1607          return .
     1608       end.
     1609       else do:
     1610         if lookup("status_", p-changed-fields) > 0  and lookup("flag_", p-changed-fields) > 0 and
     1611           p-newbh::status_ = p-waiting-status and
     1612           (p-newbh:table = 'price-doc':U or p-newbh::flag_   = p-waiting-flag)   then do:
     1613             assign
     1614                 p-direction          = '<закрытие документа>':U
     1615                 p-is-waiting-status   = true
     1616             .
     1617             return .
     1618          end.
     1619         if lookup("status_", p-changed-fields) > 0  and lookup("flag_", p-changed-fields) = 0 and
     1620           p-newbh::status_ = p-waiting-status  then do:
     1621             assign
     1622                 p-direction          = '<закрытие документа>':U
     1623                 p-is-waiting-status   = true
     1624             .
     1625             return .
     1626          end.
     1627         if lookup("status_", p-changed-fields) = 0  and lookup("flag_", p-changed-fields) > 0 and
     1628         (p-newbh:table = 'price-doc':U or p-newbh::flag_   = p-waiting-flag )  then do:
     1629             assign
     1630                 p-direction          = '<закрытие документа>':U
     1631                 p-is-waiting-status   = true
     1632             .
     1633             return .
     1634          end.
     1635           if lookup("status_", p-changed-fields) > 0  and lookup("flag_", p-changed-fields) > 0 and
     1636           p-newbh::status_ = p-waiting-status and
     1637           (p-newbh:table = 'price-doc':U or p-waiting-flag = ? )  then do:
     1638             assign
     1639                 p-direction          = '<закрытие документа>':U
     1640                 p-is-waiting-status   = true
     1641             .
     1642             return .
     1643          end.
     1644       end.
     1645     end.
     1646   end.
     1647   else do:
     1648     if p-changed-fields = '' then do:
     1649       if p-oldbh::status_ = p-waiting-status
     1650       and (p-oldbh:table = 'price-doc':U
     1651           or
     1652         (p-waiting-flag = ?
     1653         or p-oldbh::flag_ = p-waiting-flag)) then do:
     1654         assign
     1655         p-direction = 'удаление':U
     1656         p-is-waiting-status = yes.
     1657         return.
     1658       end.
     1659       else do:
     1660         assign
     1661         p-direction          = ""
     1662         p-is-waiting-status = no.
     1663         return.
     1664       end.
     1665     end.
     1666     else do:
     1667       if lookup("status_", p-changed-fields) = 0
     1668       and lookup("flag_", p-changed-fields) = 0
     1669       then do:
     1670          assign
     1671             p-is-waiting-status  = false
     1672             p-direction          = ""
     1673          .
     1674          return .
     1675       end.
     1676     end.
     1677   end.
     1678   if v-has-newbh then do:
     1679     v-some-bh = p-newbh.
     1680   end.
     1681   else do:
     1682     v-some-bh = p-oldbh.
     1683   end.
     1684   case v-some-bh:table :
     1685     when 'ord-doc':U  then do:
     1686        if v-some-bh::doc-type = 'ОР':U or v-some-bh::doc-type = 'ОП':U then do:
     1687        if v-some-bh::doc-type = 'ОР':U then do:
     1688           run ord-orc in this-procedure
     1689           ( input  p-oldbh
     1690            ,input  p-newbh
     1691            ,input  p-changed-fields
     1692            ,input  p-waiting-status
     1693            ,input  p-waiting-flag
     1694            ,output p-is-waiting-status
     1695            ,output p-direction  )  .
     1696        end.
     1697        if v-some-bh::doc-type = 'ОП':U then do:
     1698           run ord-op in this-procedure
     1699           ( input  p-oldbh
     1700            ,input  p-newbh
     1701            ,input  p-changed-fields
     1702            ,input  p-waiting-status
     1703            ,input  p-waiting-flag
     1704            ,output p-is-waiting-status
     1705            ,output p-direction  )  .
     1706        end.
     1707        end.
     1708        else do:
     1709          assign
     1710             p-is-waiting-status  = false
     1711             p-direction          = ""
     1712          .
     1713        end.
     1714     end.
     1715     when 'ord-doc-rcv':U  then do:
     1716           run ord-rcv in this-procedure
     1717           ( input  p-oldbh
     1718            ,input  p-newbh
     1719            ,input  p-changed-fields
     1720            ,input  p-waiting-status
     1721            ,input  p-waiting-flag
     1722            ,output p-is-waiting-status
     1723            ,output p-direction  )  .
     1724     end.
     1725     when 'trn-doc':U  then do:
     1726           run stat-graf-trn in this-procedure
     1727           ( input  p-oldbh
     1728            ,input  p-newbh
     1729            ,input  p-changed-fields
     1730            ,input  p-waiting-status
     1731            ,input  p-waiting-flag
     1732            ,output p-is-waiting-status
     1733            ,output p-direction  )  .
     1734     end.
     1735     when 'price-doc':U then do:
     1736       run stat-graf-price in this-procedure
     1737           ( input  p-oldbh
     1738            ,input  p-newbh
     1739            ,input  p-changed-fields
     1740            ,input  p-waiting-status
     1741            ,input  p-waiting-flag
     1742            ,output p-is-waiting-status
     1743            ,output p-direction  )  .
     1744     end.
     1745     when 'inkas':U then do:
     1746           run stat-graf-inkas in this-procedure
     1747           ( input  p-oldbh
     1748            ,input  p-newbh
     1749            ,input  p-changed-fields
     1750            ,input  p-waiting-status
     1751            ,input  p-waiting-flag
     1752            ,output p-is-waiting-status
     1753            ,output p-direction  )  .
     1754     end.
     1755     otherwise do:
     1756          assign
     1757             p-is-waiting-status  = false
     1758             p-direction          = ""
     1759          .
     1760     end.
     1761   end case.
     1762   return .
     1763   end procedure.
     1764   procedure ord-op :
     1765   define input parameter p-oldbh              as handle no-undo .
     1766   define input parameter p-newbh              as handle no-undo .
     1767   define input parameter p-changed-fields     as character no-undo .
     1768   define input parameter p-waiting-status     as character no-undo .
     1769   define input parameter p-waiting-flag       as logical no-undo .
     1770   define output parameter p-is-waiting-status as logical no-undo .
     1771   define output parameter p-direction         as character no-undo .
     1772   define variable v-stat-list as character no-undo extent 5.
     1773   define variable v-waiting-stfl as character no-undo .
     1774   define variable v-old-stfl as character no-undo .
     1775   define variable v-new-stfl as character no-undo .
     1776   define variable v-waiting-stfl-i as integer no-undo .
     1777   define variable v-old-stfl-i as integer no-undo .
     1778   define variable v-new-stfl-i as integer no-undo .
     1779   define variable v-ii as integer no-undo .
     1780     do
     1781     on error undo, return error return-value
     1782     :
     1783   assign
     1784   v-stat-list[1] =
     1785                    ''            +  chr(3) +
     1786                    'новый':U    +  chr(3) +
     1787                    'согласование':U +  chr(3) +
     1788                    'поставка':U    +  chr(3) +
     1789                    'закрыто':U  +  chr(3) +
     1790                    'факт':U
     1791   v-stat-list[2] =
     1792                    ''            +  chr(3) +
     1793                    'новый':U    +  chr(3) +
     1794                    'отказ':U
     1795   v-stat-list[3] =
     1796                    ''            +  chr(3) +
     1797                    'новый':U    +  chr(3) +
     1798                    'согласование':U +  chr(3) +
     1799                    'отказ':U
     1800   v-stat-list[4] =
     1801                    ''            +  chr(3) +
     1802                    'новый':U    +  chr(3) +
     1803                    'согласование':U +  chr(3) +
     1804                    'поставка':U    +  chr(3) +
     1805                    'отказ':U
     1806   v-stat-list[5] =
     1807                    ''            +  chr(3) +
     1808                    'новый':U    +  chr(3) +
     1809                    'согласование':U +  chr(3) +
     1810                    'поставка':U    +  chr(3) +
     1811                    'закрыто':U  +  chr(3) +
     1812                    'отказ':U
     1813   .
     1814     assign
     1815     v-waiting-stfl = p-waiting-status
     1816     .
     1817     assign
     1818     v-old-stfl = p-oldbh::status_
     1819     .
     1820     assign
     1821     v-new-stfl = p-newbh::status_
     1822     .
     1823     _ii:
     1824     do v-ii = 1 to 5:
     1825       if v-stat-list[v-ii] = '' then next.
     1826       assign
     1827       v-waiting-stfl-i = lookup(v-waiting-stfl, v-stat-list[v-ii], chr(3))
     1828       v-old-stfl-i = lookup(v-old-stfl, v-stat-list[v-ii], chr(3))
     1829       v-new-stfl-i = lookup(v-new-stfl, v-stat-list[v-ii], chr(3))
     1830       .
     1831       if v-waiting-stfl-i = 0
     1832       or v-old-stfl-i = 0
     1833       or v-new-stfl-i = 0
     1834       then do:
     1835         next _ii.
     1836         end.
     1837       if v-old-stfl-i < v-waiting-stfl-i
     1838       and v-new-stfl-i = v-waiting-stfl-i then do:
     1839         assign
     1840         p-is-waiting-status = yes
     1841         p-direction = '<закрытие документа>':U + chr(4) + "to".
     1842         return.
     1843         end.
     1844       if v-old-stfl-i < v-waiting-stfl-i
     1845       and v-new-stfl-i > v-waiting-stfl-i then do:
     1846         assign
     1847         p-is-waiting-status = yes
     1848         p-direction = '<закрытие документа>':U + chr(4) + "to-up".
     1849         return.
     1850         end.
     1851       if v-new-stfl-i = v-waiting-stfl-i
     1852       and v-old-stfl-i > v-waiting-stfl-i then do:
     1853         assign
     1854         p-is-waiting-status = yes
     1855         p-direction = '<открытие документа>':U + chr(4) + "to".
     1856         return.
     1857         end.
     1858       if v-new-stfl-i < v-waiting-stfl-i
     1859       and v-old-stfl-i > v-waiting-stfl-i then do:
     1860         assign
     1861         p-is-waiting-status = yes
     1862         p-direction = '<открытие документа>':U + chr(4) + "to-down".
     1863         return.
     1864         end.
     1865       if v-old-stfl-i = v-waiting-stfl-i
     1866       and v-new-stfl-i > v-waiting-stfl-i then do:
     1867         assign
     1868         p-is-waiting-status = yes
     1869         p-direction = '<закрытие документа>':U + chr(4) + "from".
     1870         return.
     1871       end.
     1872       if v-old-stfl-i = v-waiting-stfl-i
     1873       and v-new-stfl-i < v-waiting-stfl-i then do:
     1874         assign
     1875         p-is-waiting-status = yes
     1876         p-direction = '<открытие документа>':U + chr(4) + "from".
     1877         return.
     1878       end.
     1879     end.
     1880     end.
     1881   end procedure.
     1882   procedure ord-orc :
     1883   define input parameter p-oldbh              as handle no-undo .
     1884   define input parameter p-newbh              as handle no-undo .
     1885   define input parameter p-changed-fields     as character no-undo .
     1886   define input parameter p-waiting-status     as character no-undo .
     1887   define input parameter p-waiting-flag       as logical no-undo .
     1888   define output parameter p-is-waiting-status as logical no-undo .
     1889   define output parameter p-direction         as character no-undo .
     1890   define variable v-stat-list as character no-undo extent 5.
     1891   define variable v-waiting-stfl as character no-undo .
     1892   define variable v-old-stfl as character no-undo .
     1893   define variable v-new-stfl as character no-undo .
     1894   define variable v-waiting-stfl-i as integer no-undo .
     1895   define variable v-old-stfl-i as integer no-undo .
     1896   define variable v-new-stfl-i as integer no-undo .
     1897   define variable v-ii as integer no-undo .
     1898     do
     1899     on error undo, return error return-value
     1900     :
     1901   assign
     1902   v-stat-list[1] =
     1903                    ''            +  chr(3) +
     1904                    'новый':U    +  chr(3) +
     1905                    'запрос':U +  chr(3) +
     1906                    'разрешено':U    +  chr(3) +
     1907                    'отгружено':U  +  chr(3) +
     1908                    'факт':U
     1909   v-stat-list[2] =
     1910                    ''            +  chr(3) +
     1911                    'новый':U    +  chr(3) +
     1912                    'отказ':U
     1913   v-stat-list[3] =
     1914                    ''            +  chr(3) +
     1915                    'новый':U    +  chr(3) +
     1916                    'запрос':U +  chr(3) +
     1917                    'отказ':U
     1918   v-stat-list[4] =
     1919                    ''            +  chr(3) +
     1920                    'новый':U    +  chr(3) +
     1921                    'запрос':U +  chr(3) +
     1922                    'разрешено':U    +  chr(3) +
     1923                    'отказ':U
     1924   v-stat-list[5] =
     1925                    ''            +  chr(3) +
     1926                    'новый':U    +  chr(3) +
     1927                    'запрос':U +  chr(3) +
     1928                    'разрешено':U    +  chr(3) +
     1929                    'отгружено':U  +  chr(3) +
     1930                    'отказ':U
     1931   .
     1932     assign
     1933     v-waiting-stfl = p-waiting-status
     1934     .
     1935     assign
     1936     v-old-stfl = p-oldbh::status_
     1937     .
     1938     assign
     1939     v-new-stfl = p-newbh::status_
     1940     .
     1941     _ii:
     1942     do v-ii = 1 to 5:
     1943       if v-stat-list[v-ii] = '' then next.
     1944       assign
     1945       v-waiting-stfl-i = lookup(v-waiting-stfl, v-stat-list[v-ii], chr(3))
     1946       v-old-stfl-i = lookup(v-old-stfl, v-stat-list[v-ii], chr(3))
     1947       v-new-stfl-i = lookup(v-new-stfl, v-stat-list[v-ii], chr(3))
     1948       .
     1949       if v-waiting-stfl-i = 0
     1950       or v-old-stfl-i = 0
     1951       or v-new-stfl-i = 0
     1952       then do:
     1953         next _ii.
     1954         end.
     1955       if v-old-stfl-i < v-waiting-stfl-i
     1956       and v-new-stfl-i = v-waiting-stfl-i then do:
     1957         assign
     1958         p-is-waiting-status = yes
     1959         p-direction = '<закрытие документа>':U + chr(4) + "to".
     1960         return.
     1961       end.
     1962       if v-old-stfl-i < v-waiting-stfl-i
     1963       and v-new-stfl-i > v-waiting-stfl-i then do:
     1964         assign
     1965         p-is-waiting-status = yes
     1966         p-direction = '<закрытие документа>':U + chr(4) + "to-up".
     1967         return.
     1968       end.
     1969       if v-new-stfl-i = v-waiting-stfl-i
     1970       and v-old-stfl-i > v-waiting-stfl-i then do:
     1971         assign
     1972         p-is-waiting-status = yes
     1973         p-direction = '<открытие документа>':U + chr(4) + "to".
     1974         return.
     1975         end.
     1976       if v-new-stfl-i < v-waiting-stfl-i
     1977       and v-old-stfl-i > v-waiting-stfl-i then do:
     1978         assign
     1979         p-is-waiting-status = yes
     1980         p-direction = '<открытие документа>':U + chr(4) + "to-down".
     1981         return.
     1982         end.
     1983       if v-old-stfl-i = v-waiting-stfl-i
     1984       and v-new-stfl-i > v-waiting-stfl-i then do:
     1985         assign
     1986         p-is-waiting-status = yes
     1987         p-direction = '<закрытие документа>':U + chr(4) + "from".
     1988         return.
     1989       end.
     1990       if v-old-stfl-i = v-waiting-stfl-i
     1991       and v-new-stfl-i < v-waiting-stfl-i then do:
     1992         assign
     1993         p-is-waiting-status = yes
     1994         p-direction = '<открытие документа>':U + chr(4) + "from".
     1995         return.
     1996         end.
     1997         end.
     1998     end.
     1999   end procedure.
     2000   procedure ord-rcv :
     2001   define input parameter p-oldbh              as handle no-undo .
     2002   define input parameter p-newbh              as handle no-undo .
     2003   define input parameter p-changed-fields     as character no-undo .
     2004   define input parameter p-waiting-status     as character no-undo .
     2005   define input parameter p-waiting-flag       as logical no-undo .
     2006   define output parameter p-is-waiting-status as logical no-undo .
     2007   define output parameter p-direction         as character no-undo .
     2008   define variable v-stat-list as character no-undo extent 5.
     2009   define variable v-waiting-stfl as character no-undo .
     2010   define variable v-old-stfl as character no-undo .
     2011   define variable v-new-stfl as character no-undo .
     2012   define variable v-waiting-stfl-i as integer no-undo .
     2013   define variable v-old-stfl-i as integer no-undo .
     2014   define variable v-new-stfl-i as integer no-undo .
     2015   define variable v-ii as integer no-undo .
     2016      do
     2017      on error undo, return error return-value
     2018      :
     2019     assign
     2020     v-stat-list[1] =
     2021                     ''            +  chr(3) +
     2022                     'новый':U    +  chr(3) +
     2023                     'поставка':U +  chr(3) +
     2024                     'факт':U
     2025     v-stat-list[2] =
     2026                     ''            +  chr(3) +
     2027                     'новый':U    +  chr(3) +
     2028                     'отказ':U
     2029     v-stat-list[3] =
     2030                     ''            +  chr(3) +
     2031                     'новый':U    +  chr(3) +
     2032                     'поставка':U +  chr(3) +
     2033                     'отказ':U
     2034     .
     2035     assign
     2036     v-waiting-stfl = p-waiting-status
     2037     .
     2038     assign
     2039     v-old-stfl = p-oldbh::status_
     2040     .
     2041     assign
     2042     v-new-stfl = p-newbh::status_
     2043     .
     2044     _ii:
     2045     do v-ii = 1 to 5:
     2046       if v-stat-list[v-ii] = '' then next.
     2047       assign
     2048       v-waiting-stfl-i = lookup(v-waiting-stfl, v-stat-list[v-ii], chr(3))
     2049       v-old-stfl-i = lookup(v-old-stfl, v-stat-list[v-ii], chr(3))
     2050       v-new-stfl-i = lookup(v-new-stfl, v-stat-list[v-ii], chr(3))
     2051       .
     2052       if v-waiting-stfl-i = 0
     2053       or v-old-stfl-i = 0
     2054       or v-new-stfl-i = 0
     2055       then do:
     2056         next _ii.
     2057         end.
     2058       if v-old-stfl-i < v-waiting-stfl-i
     2059       and v-new-stfl-i = v-waiting-stfl-i then do:
     2060         assign
     2061         p-is-waiting-status = yes
     2062         p-direction = '<закрытие документа>':U + chr(4) + "to".
     2063         return.
     2064       end.
     2065       if v-old-stfl-i < v-waiting-stfl-i
     2066       and v-new-stfl-i > v-waiting-stfl-i then do:
     2067         assign
     2068         p-is-waiting-status = yes
     2069         p-direction = '<закрытие документа>':U + chr(4) + "to-up".
     2070         return.
     2071       end.
     2072       if v-new-stfl-i = v-waiting-stfl-i
     2073       and v-old-stfl-i > v-waiting-stfl-i then do:
     2074         assign
     2075         p-is-waiting-status = yes
     2076         p-direction = '<открытие документа>':U + chr(4) + "to".
     2077         return.
     2078       end.
     2079       if v-new-stfl-i < v-waiting-stfl-i
     2080       and v-old-stfl-i > v-waiting-stfl-i then do:
     2081         assign
     2082         p-is-waiting-status = yes
     2083         p-direction = '<открытие документа>':U + chr(4) + "to-down".
     2084         return.
     2085       end.
     2086       if v-old-stfl-i = v-waiting-stfl-i
     2087       and v-new-stfl-i > v-waiting-stfl-i then do:
     2088         assign
     2089         p-is-waiting-status = yes
     2090         p-direction = '<закрытие документа>':U + chr(4) + "from".
     2091         return.
     2092       end.
     2093       if v-old-stfl-i = v-waiting-stfl-i
     2094       and v-new-stfl-i < v-waiting-stfl-i then do:
     2095         assign
     2096         p-is-waiting-status = yes
     2097         p-direction = '<открытие документа>':U + chr(4) + "from".
     2098         return.
     2099         end.
     2100         end.
     2101      end.
     2102   end procedure.
     2103   procedure stat-graf-trn :
