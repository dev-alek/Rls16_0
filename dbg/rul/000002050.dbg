     2171   v-stat-list[lookup('im':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] =
     2172                                                                   ''              + chr(4) + string(no) + chr(3) +
     2173                                                                   'факт':U         + chr(4) + string(yes)
     2174   v-stat-list[lookup('ap':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] =
     2175                                                                         ''              + chr(4) + string(no) + chr(3) +
     2176                                                                         'накл':U         + chr(4) + string(no) + chr(3) +
     2177                                                                         'факт':U         + chr(4) + string(yes)
     2178   v-stat-list[lookup('mp':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] =
     2179                                                                         ''              + chr(4) + string(no) + chr(3) +
     2180                                                                         'факт':U         + chr(4) + string(yes)
     2181   v-stat-list[lookup('pc':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] =
     2182                                                                         ''              + chr(4) + string(no) + chr(3) +
     2183                                                                         'факт':U         + chr(4) + string(yes)
     2184   .
