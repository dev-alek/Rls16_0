     2793     define variable v-printed21       as logical   no-undo .
     2794     run gbl/prnfilen.w
     2795       (input  ('!!!При маршрутизации произошли ошибки!!!')
     2796       ,input  0
     2797       ,input  (string("./":U) + log-file-name)
     2798       ,input  7
     2799       ,output v-user-action21
     2800       ,output v-printed21
     2801       ) .
     2802   end.
     2803   if v-view-log = true
     2804   and (g#news
     2805   or g#auto)
     2806   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
     2807   then do:
     2808      run cb_set-view-log in p-parent-handle ( input yes).
     2809   end.
     2810     if v-es then do:
     2811         run garbcoll_clear in this-procedure .
     2812         undo, return error substitute( "&1. &2&3&4", vss-workfile, v-rv, chr(10), v-esm).
     2813     end.
     2814     run garbcoll_clear in this-procedure .
     2815   end.
     2816   procedure proc-main :
     2817   _main:
     2818   do
     2819   on error undo, return error substitute( "&1&2&3&2&4", return-value, chr(10), error-status :get-message (1), v-last-error-message)
     2820   on stop undo, return error substitute( "&1&2&3&2&4", return-value, chr(10), error-status :get-message (1), v-last-error-message)
     2821   :
     2822     define variable v-ext-obj-code as integer no-undo .
     2823     define variable v-err as logical no-undo .
     2824     DEFINE VARIABLE v-today as date no-undo .
     2825     DEFINE VARIABLE v-time as integer no-undo .
     2826   define variable v-doc-code as character no-undo .
     2827     define variable v-obj-uniq-key-rec as character no-undo .
     2828     define variable v-esys-id-list as character no-undo .
     2829   define variable v-price-doc-obj-type as character no-undo .
     2830   define variable v-price-doc-obj-code as integer no-undo .
     2831     define buffer buf_price-doc for ub.price-doc.
     2832     define buffer buf_ext-classif for ub.ext-classif.
     2833     define buffer buf_clients for ub.clients.
     2834     _stroka:
     2835   do while true
     2836   on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2837   on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
     2838   on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
     2839     :
     2840   v-esys-id-list = ''.
     2841   v-price-doc-obj-type = ''.
     2842   v-price-doc-obj-code = 0.
     2843   case p-ruleset-id:
     2844     when 110 then do:
     2845       if v-has-newbh then do:
     2846         v-price-doc-obj-type = v-newbh::obj-type.
     2847         v-price-doc-obj-code = v-newbh::obj-code.
     2848         v-doc-code = v-newbh:buffer-field("doc-num"):buffer-value.
     2849       end.
     2850       else do:
     2851         v-price-doc-obj-type = v-oldbh::obj-type.
     2852         v-price-doc-obj-code = v-oldbh::obj-code.
     2853         v-doc-code = v-oldbh:buffer-field("doc-num"):buffer-value.
     2854       end.
     2855     end.
     2856   end case.
     2857       find first buf_clients no-lock where
     2858               buf_clients.obj-type = v-price-doc-obj-type
     2859         and  buf_clients.obj-code = v-price-doc-obj-code.
     2860       run gen-key-rec in this-procedure ( input 'clients':U
     2861                                         ,input buffer buf_clients:handle
     2862                                         ,output v-obj-uniq-key-rec).
     2863       v-esys-id-list = ''.
     2864       for each buf_ext-classif no-lock where
     2865           buf_ext-classif.classif-name = 'clients-esys':U
     2866       and buf_ext-classif.classif-subject = 'clients':U
     2867       and buf_ext-classif.db-num = 0
     2868       and buf_Ext-classif.uniq-key-rec = v-obj-uniq-key-rec :
     2869         if lookup(string(buf_ext-classif.key#_one), v-esys-id-list-start, chr(1)) = 0 then next.
     2870         v-esys-id-list = v-esys-id-list + (if v-esys-id-list = '' then '' else chr(1)) + string(buf_ext-classif.key#_one).
     2871       end.
     2872     case p-ruleset-id:
     2873       when 110 then do:
     2874         if v-esys-id-list = '' then leave _stroka.
     2875       end.
     2876     end case.
     2877       IF  ExpData1:route-data_read-xmlschema( INPUT p-xsd-file) = false  THEN do:
     2878         undo _main, return error v-last-error-message .
     2879       end.
     2880       IF  context_begin-esys-command( input v-esys-id-list, input-output v-esys-cmd-proc-handle, output v-esys-cmd-code) = false  THEN do:
     2881         undo _main, return error v-last-error-message .
     2882       end.
     2883       if p-save >= 0 then do:
     2884         find first buf_price-doc exclusive-lock where
     2885                   buf_price-doc.doc-num = v-doc-code
     2886                no-error.
     2887       end.
     2888       else do:
     2889         find first buf_price-doc no-lock where
     2890                   buf_price-doc.doc-num = v-doc-code
     2891                no-error.
     2892       end.
     2893       if not available buf_price-doc then do:
     2894               run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не найдена переоценка &1", v-doc-code)).
     2895         undo _main, return error ''.
     2896       end.
     2897       run edocsprc_export in this-procedure ( buffer buf_price-doc
     2898                                             ) no-error.
     2899       if error-status:error then do:
     2900          undo _main, return error ''.
     2901       end.
     2902     IF  context_send-esys-command( input v-esys-id-list
     2903                                 , input v-esys-cmd-proc-handle
     2904                                 , input v-esys-cmd-code
     2905                                 , input g#userid) = false  THEN do:
     2906       undo _main, return error v-last-error-message .
     2907       end.
     2908       ExpData1:Route-data_clear-data ( ) .
     2909     if p-ruleset-id = 110 then leave _stroka.
     2910   end.
     2911   end.
     2912   end procedure.
     2913   procedure load-ruleset-context :
     2914   define input parameter p-ruleset-id as integer no-undo .
     2915   define variable v-flag as logical no-undo .
     2916   define variable v-is-waiting-status as logical no-undo .
     2917   define variable v-direction as character no-undo .
     2918   define variable v-direction-2 as character no-undo .
     2919   define variable v-changes-list as character no-undo .
     2920   define buffer buf_rule-call-param for ub.rule-call-param.
     2921   define buffer buf_ext-system for ub.ext-system.
     2922   do
     2923   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2924   on stop   undo, return error substitute( "&1. stop", vss-workfile )
     2925   on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     2926   :
     2927     case p-ruleset-id:
     2928       when 110 then do:
     2929         assign
     2930         v-oldbh = widget-handle (entry(2, p-doc-code, chr(4)))
     2931         v-newbh = widget-handle (entry(3, p-doc-code, chr(4)))
     2932         v-changes-list = entry(4, p-doc-code, chr(4))
     2933         file-name  = p-process-file-name
     2934         v-has-oldbh = valid-handle(v-oldbh) and v-oldbh:available
     2935         v-has-newbh = valid-handle(v-newbh) and v-newbh:available
     2936         .
     2937         if not v-has-newbh
     2938         and not v-has-oldbh then do:
     2939           undo, return error substitute("Не определено ни одного буфера - ни старый, ни новый").
     2940         end.
     2941         if not v-has-oldbh
     2942         and v-changes-list  = '' then do:
     2943           undo, return error substitute("Не определен старый буфер и список изменений").
     2944         end.
     2945         if v-has-newbh
     2946         and v-newbh:table <> 'price-doc':U then do:
     2947           undo, return error substitute("Передан неверный буфер вместо буфера для &1",  'price-doc':U).
     2948         end.
     2949         run statq_has-waiting-stat in this-procedure (
     2950                                                         input v-oldbh
     2951                                                       ,input v-newbh
     2952                                                       ,input v-changes-list
     2953                                                       ,input 'акт':U
     2954                                                       ,input ?
     2955                                                       ,input 0
     2956                                                       ,output v-is-waiting-status
     2957                                                       ,output v-direction
     2958                                                       ) no-error.
     2959         if v-is-waiting-status = no then return "return".
     2960         if num-entries(v-direction, chr(4)) > 1 then do:
     2961           v-direction-2 = entry(2, v-direction, chr(4)).
     2962           v-direction = entry(1, v-direction, chr(4)).
     2963           if v-direction-2 <> "to"
     2964           and v-direction-2 <> "from" then return "return".
     2965           if v-direction = '<открытие документа>':U
     2966           and v-direction-2 = "to" then return "return".
     2967           if v-direction = '<закрытие документа>':U
     2968           and v-direction-2 = "from" then return "return".
     2969         end.
     2970     find first buf_rule-call-param no-lock where
     2971   buf_rule-call-param.codex_id = p-codex-id
     2972   and buf_rule-call-param.ruleset_id = p-ruleset-id
     2973   and buf_rule-call-param.call_id = p-call-id
     2974   and buf_rule-call-param.order_id = p-order-id
     2975   and buf_rule-call-param.rule_id = p-rule-id
     2976   and buf_rule-call-param.param-name = "p-xsd-file"
     2977    no-error.
     2978   if available buf_rule-call-param then do:
     2979   assign p-xsd-file = buf_rule-call-param.param-value-character.
     2980   end.
     2981     for each buf_rule-call-param no-lock where
     2982     buf_rule-call-param.codex_id = p-codex-id
     2983     and buf_rule-call-param.ruleset_id = p-ruleset-id
     2984     and buf_rule-call-param.call_id = p-call-id
     2985     and buf_rule-call-param.order_id = p-order-id
     2986     and buf_rule-call-param.rule_id = p-rule-id
     2987     and buf_rule-call-param.param-name = "p-esys-id-list",
     2988       first buf_ext-system no-lock where
     2989             buf_Ext-system.esys-id = buf_rule-call-param.param-value-integer
     2990         and buf_Ext-system.db-num = 0
     2991         and buf_Ext-system.esys-have-export = yes
     2992         and buf_Ext-system.esys-db-num-exp = g#db-num:
     2993       v-esys-id-list-start = v-esys-id-list-start + (if v-esys-id-list-start = '' then '' else chr(1)) + string(buf_ext-system.esys-id).
     2994     end.
     2995     if v-esys-id-list-start = '' then return "return".
     2996         end.
     2997         otherwise do:
     2998           undo, return error substitute("Неверный вызов &1 для набора правил &2", vss-workfile , p-ruleset-id).
     2999         end.
     3000       end case.
     3001     end.
     3002   end procedure.
     3003   procedure edocsprc_export :
     3004   define parameter buffer buf_price-doc for ub.price-doc.
     3005   define variable v-obj-type-code as integer no-undo .
     3006   define variable v-bh as handle no-undo .
     3007   define variable v-bh-line as handle no-undo .
     3008   define variable v-err-mess as character no-undo .
     3009   define variable glog as logical no-undo .
     3010   define variable v-b-str-list as character no-undo .
     3011   define variable v-ii as integer no-undo .
     3012   define variable varscales-pref as character no-undo .
     3013   define variable varpgscales-pref as character no-undo .
     3014   define variable v-get-varscales-pref as logical no-undo .
     3015   define buffer buf_price-list for ub.price-list.
     3016   define buffer buf_bar-code for ub.bar-code.
     3017   define buffer buf_prod-bc for ub.prod-bc.
     3018   main-block:
     3019   do
     3020   on error undo main-block, retry main-block
     3021   :
     3022     if retry then do:
     3023           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input v-err-mess).
     3024       return error ''.
     3025     end.
     3026     else do:
     3027       v-bh = buffer buf_price-doc:handle.
     3028       v-bh-line = buffer buf_price-list:handle.
     3029       v-obj-type-code = (if buf_price-doc.obj-type = 'скл':U then 100000 else 0) + buf_price-doc.obj-code.
     3030       for each buf_price-list no-lock where
     3031               buf_price-list.doc-num = buf_price-doc.doc-num
     3032       on error  undo main-block, retry  main-block
     3033       on stop   undo main-block, retry  main-block
     3034       on endkey undo main-block, retry  main-block
     3035       :
     3036         find first buf_bar-code no-lock where
     3037                   buf_bar-code.b-code = buf_price-list.b-code no-error.
     3038         if not available buf_bar-code then next.
     3039         ExpData1:route-data_create-record( INPUT "smprices") .
     3040         IF ExpData1:esys-add-dump( INPUT "smprices", INPUT v-esys-cmd-proc-handle, INPUT v-esys-cmd-code, '_dump-order=Rec_ID') = false  THEN do:
     3041           v-err-mess = substitute("Ошибка при маршрутизации цен для кода &1 документ &2:&3&4"
     3042                                   , buf_price-list.b-code
     3043                                   , buf_price-list.doc-num
     3044                                   , chr(10)
     3045                                   , v-last-error-message
     3046                                   ).
     3047           undo main-block, return error v-last-error-message .
     3048         end.
     3049         ExpData1:route-data_copy-field( INPUT "smprices", "GoodsID", INPUT  buffer buf_bar-code:handle:buffer-field("gds-code") ) .
     3050         ExpData1:route-data_copy-field-character( INPUT "smprices", "BC", INPUT  string(buf_bar-code.b-code) ) .
     3051         ExpData1:route-data_copy-field-integer( INPUT "smprices", "PriceID", INPUT  v-obj-type-code ) .
     3052         ExpData1:route-data_copy-field-character( INPUT "smprices", "Action", INPUT  'U':U) .
     3053         ExpData1:route-data_copy-field( INPUT "smprices", "Price", INPUT  v-bh-line:buffer-field("price-sale") ) .
     3054         IF ExpData1:esys-add-dump( INPUT "smprices", INPUT v-esys-cmd-proc-handle, INPUT v-esys-cmd-code, '+update') = false  THEN do:
     3055           v-err-mess = substitute("Ошибка при маршрутизации записи &1:&2&3"
     3056                                   , buf_price-doc.doc-num
     3057                                   , chr(10)
     3058                                   , v-last-error-message
     3059                                   ).
     3060           undo main-block, retry main-block.
     3061         end.
     3062         _prod-bc:
     3063         for each buf_prod-bc no-lock where buf_prod-bc.b-code = buf_bar-code.b-code
     3064         on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3065         on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     3066         on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     3067         :
     3068           v-b-str-list = ''.
     3069           case buf_prod-bc.bc-on-type:
     3070             when 'sclc':U
     3071             or
     3072             when 'scgb':U then do:
     3073               if not v-get-varscales-pref then do:
     3074   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3075   define variable varscales-pref-type22 as character no-undo.
     3076   varscales-pref  = ?.
     3077   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     3078     (input  'sclspref':u
     3079     ,input  '':u
     3080     ,input  '':u
     3081     ,input  0
     3082     ,input  '':u
     3083     ,input  '':u
     3084     ,input  '':u
     3085     ,input  no
     3086     ,output varscales-pref
     3087     ,output varscales-pref-type22
     3088     ) no-error .
     3089   if varscales-pref = ? then do:
     3090     assign
     3091     varscales-pref = '21,23,25':U.
     3092   end.
     3093   define variable varpgscales-pref-type22 as character no-undo.
     3094   varpgscales-pref  = ?.
     3095   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     3096     (input  'scpgpref':u
     3097     ,input  '':u
     3098     ,input  '':u
     3099     ,input  0
     3100     ,input  '':u
     3101     ,input  '':u
     3102     ,input  '':u
     3103     ,input  no
     3104     ,output varpgscales-pref
     3105     ,output varpgscales-pref-type22
     3106     ) no-error .
     3107   if varpgscales-pref = ? then do:
     3108     assign
     3109     varpgscales-pref = '24IIIIIQQ000C,28IIIIIQQQ00C':U.
     3110   end.
     3111                 v-get-varscales-pref  = yes.
     3112               end.
     3113               do v-ii = 1 to num-entries(varscales-pref):
     3114                 assign
     3115                 v-b-str-list = v-b-str-list +
     3116                               (if v-b-str-list = '' then '' else chr(44)) +
     3117                               entry(v-ii, varscales-pref) + buf_prod-bc.b-str.
     3118               end.
     3119             end.
     3120             when 'pglc':U then do:
     3121               next _prod-bc.
     3122             end.
     3123             otherwise do:
     3124               v-b-str-list = buf_prod-bc.b-str.
     3125             end.
     3126           end case.
     3127           do v-ii = 1 to num-entries (v-b-str-list):
     3128             ExpData1:route-data_create-record( INPUT "smprices") .
     3129             IF ExpData1:esys-add-dump( INPUT "smprices", INPUT v-esys-cmd-proc-handle, INPUT v-esys-cmd-code, '_dump-order=Rec_ID') = false  THEN do:
     3130               v-err-mess = substitute("Ошибка при маршрутизации цен для кода &1 документ &2:&3&4"
     3131                                       , buf_price-list.b-code
     3132                                       , buf_price-list.doc-num
     3133                                       , chr(10)
     3134                                       , v-last-error-message
     3135                                       ).
     3136               undo main-block, return error v-last-error-message .
     3137             end.
     3138             ExpData1:route-data_copy-field( INPUT "smprices", "GoodsID", INPUT  buffer buf_bar-code:handle:buffer-field("gds-code") ) .
     3139             ExpData1:route-data_copy-field-character( INPUT "smprices", "BC", INPUT  entry(v-ii, v-b-str-list)) .
     3140             ExpData1:route-data_copy-field-integer( INPUT "smprices", "PriceID", INPUT  v-obj-type-code ) .
     3141             ExpData1:route-data_copy-field-character( INPUT "smprices", "Action", INPUT  'U':U) .
     3142             ExpData1:route-data_copy-field( INPUT "smprices", "Price", INPUT  v-bh-line:buffer-field("price-sale") ) .
     3143             IF ExpData1:esys-add-dump( INPUT "smprices", INPUT v-esys-cmd-proc-handle, INPUT v-esys-cmd-code, '+update') = false  THEN do:
     3144               v-err-mess = substitute("Ошибка при маршрутизации записи &1:&2&3"
     3145                                       , buf_price-doc.doc-num
     3146                                       , chr(10)
     3147                                       , v-last-error-message
     3148                                       ).
     3149               undo main-block, retry main-block.
     3150             end.
     3151           end.
     3152         end.
     3153       end.
     3154     end.
     3155   end.
     3156   end procedure.
