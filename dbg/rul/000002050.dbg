     2262       v-old-stfl-i = lookup(v-old-stfl, v-stat-list[v-ii], chr(3))
     2263       v-new-stfl-i = lookup(v-new-stfl, v-stat-list[v-ii], chr(3))
     2264       .
     2265       if v-waiting-stfl-i = 0
     2266       or v-old-stfl-i = 0
     2267       or v-new-stfl-i = 0
     2268       then do:
     2269         next _ii.
     2270       end.
     2271       if v-old-stfl-i < v-waiting-stfl-i
     2272       and v-new-stfl-i = v-waiting-stfl-i then do:
     2273         assign
     2274         p-is-waiting-status = yes
     2275         p-direction = '<закрытие документа>':U + chr(4) + "to".
     2276         return.
     2277       end.
     2278       if v-old-stfl-i < v-waiting-stfl-i
     2279       and v-new-stfl-i > v-waiting-stfl-i then do:
     2280         assign
     2281         p-is-waiting-status = yes
     2282         p-direction = '<закрытие документа>':U + chr(4) + "to-up".
     2283         return.
     2284       end.
     2285       if v-new-stfl-i = v-waiting-stfl-i
     2286       and v-old-stfl-i > v-waiting-stfl-i then do:
     2287         assign
     2288         p-is-waiting-status = yes
     2289         p-direction = '<открытие документа>':U + chr(4) + "to".
     2290         return.
     2291       end.
     2292       if v-new-stfl-i < v-waiting-stfl-i
     2293       and v-old-stfl-i > v-waiting-stfl-i then do:
     2294         assign
     2295         p-is-waiting-status = yes
     2296         p-direction = '<открытие документа>':U + chr(4) + "to-down".
     2297         return.
     2298       end.
     2299       if v-old-stfl-i = v-waiting-stfl-i
     2300       and v-new-stfl-i > v-waiting-stfl-i then do:
     2301         assign
     2302         p-is-waiting-status = yes
     2303         p-direction = '<закрытие документа>':U + chr(4) + "from".
     2304         return.
     2305       end.
