     2307       and v-new-stfl-i < v-waiting-stfl-i then do:
     2308         assign
     2309         p-is-waiting-status = yes
     2310         p-direction = '<открытие документа>':U + chr(4) + "from".
     2311         return.
     2312       end.
     2313     end.
     2314   end.
     2315   end.
     2316   end procedure .
     2317   procedure stat-graf-price :
     2318   define input parameter p-oldbh              as handle no-undo .
     2319   define input parameter p-newbh              as handle no-undo .
     2320   define input parameter p-changed-fields     as character no-undo .
     2321   define input parameter p-waiting-status     as character no-undo .
     2322   define input parameter p-waiting-flag       as logical no-undo .
     2323   define output parameter p-is-waiting-status as logical no-undo .
     2324   define output parameter p-direction         as character no-undo .
     2325   define variable v-stat-list as character no-undo extent 5.
     2326   define variable v-waiting-stfl as character no-undo .
     2327   define variable v-old-stfl as character no-undo .
     2328   define variable v-new-stfl as character no-undo .
     2329   define variable v-waiting-stfl-i as integer no-undo .
     2330   define variable v-old-stfl-i as integer no-undo .
     2331   define variable v-new-stfl-i as integer no-undo .
     2332   define variable v-ii as integer no-undo .
     2333   do
     2334   on error undo, return error return-value
     2335   :
     2336   assign
     2337   v-stat-list[1] =
     2338                    ''            +  chr(3) +
     2339                    'новый':U    +  chr(3) +
     2340                    'приказ':U      +  chr(3) +
     2341                    'разрешен':U  +  chr(3) +
     2342                    'акт':U
     2343   .
     2344     assign
     2345     v-waiting-stfl = p-waiting-status
     2346     .
     2347     assign
     2348     v-old-stfl = p-oldbh::status_
     2349     .
     2350     assign
     2351     v-new-stfl = p-newbh::status_
     2352     .
     2353     _ii:
     2354     do v-ii = 1 to 5:
     2355       if v-stat-list[v-ii] = '' then next.
     2356       assign
     2357       v-waiting-stfl-i = lookup(v-waiting-stfl, v-stat-list[v-ii], chr(3))
     2358       v-old-stfl-i = lookup(v-old-stfl, v-stat-list[v-ii], chr(3))
     2359       v-new-stfl-i = lookup(v-new-stfl, v-stat-list[v-ii], chr(3))
     2360       .
     2361       if v-waiting-stfl-i = 0
     2362       or v-old-stfl-i = 0
     2363       or v-new-stfl-i = 0
     2364       then do:
     2365         next _ii.
     2366       end.
     2367       if v-old-stfl-i < v-waiting-stfl-i
     2368       and v-new-stfl-i = v-waiting-stfl-i then do:
     2369         assign
     2370         p-is-waiting-status = yes
     2371         p-direction = '<закрытие документа>':U + chr(4) + "to".
     2372         return.
     2373       end.
     2374       if v-old-stfl-i < v-waiting-stfl-i
     2375       and v-new-stfl-i > v-waiting-stfl-i then do:
     2376         assign
     2377         p-is-waiting-status = yes
     2378         p-direction = '<закрытие документа>':U + chr(4) + "to-up".
     2379         return.
     2380       end.
     2381       if v-new-stfl-i = v-waiting-stfl-i
     2382       and v-old-stfl-i > v-waiting-stfl-i then do:
     2383         assign
     2384         p-is-waiting-status = yes
     2385         p-direction = '<открытие документа>':U + chr(4) + "to".
     2386         return.
     2387       end.
     2388       if v-new-stfl-i < v-waiting-stfl-i
     2389       and v-old-stfl-i > v-waiting-stfl-i then do:
     2390         assign
     2391         p-is-waiting-status = yes
     2392         p-direction = '<открытие документа>':U + chr(4) + "to-down".
     2393         return.
     2394       end.
     2395       if v-old-stfl-i = v-waiting-stfl-i
     2396       and v-new-stfl-i > v-waiting-stfl-i then do:
     2397         assign
     2398         p-is-waiting-status = yes
     2399         p-direction = '<закрытие документа>':U + chr(4) + "from".
     2400         return.
     2401       end.
     2402       if v-old-stfl-i = v-waiting-stfl-i
     2403       and v-new-stfl-i < v-waiting-stfl-i then do:
     2404         assign
     2405         p-is-waiting-status = yes
     2406         p-direction = '<открытие документа>':U + chr(4) + "from".
     2407         return.
     2408       end.
     2409     end.
     2410   end.
     2411   end procedure.
     2412   procedure stat-graf-inkas :
     2413   define input parameter  p-oldbh              as handle no-undo .
     2414   define input parameter  p-newbh              as handle no-undo .
     2415   define input parameter  p-changed-fields     as character no-undo .
     2416   define input parameter  p-waiting-status     as character no-undo .
     2417   define input parameter  p-waiting-flag       as logical no-undo .
     2418   define output parameter p-is-waiting-status  as logical no-undo .
     2419   define output parameter p-direction          as character no-undo .
     2420   define variable v-doc-code as character no-undo .
     2421   define variable v-ext-doc-type as character no-undo .
     2422   define variable v-stat-list as character no-undo extent 3.
     2423   define variable v-jj as integer no-undo .
     2424   define variable v-ii as integer no-undo .
     2425   define variable v-old-stfl as character no-undo .
     2426   define variable v-new-stfl as character no-undo .
     2427   define variable v-waiting-stfl as character no-undo .
     2428   define variable v-old-stfl-i as integer no-undo .
     2429   define variable v-new-stfl-i as integer no-undo .
     2430   define variable v-waiting-stfl-i as integer no-undo .
     2431   do
     2432   on error  undo, return error substitute( "&1. &2&3&4", vss-include-info12, return-value, chr(10), error-status :get-message (1))
     2433   :
     2434   if p-newbh = ?  then do:
     2435     v-doc-code = p-oldbh::inkas-code .
     2436   end.
     2437   else do:
     2438     v-doc-code     = p-newbh::inkas-code .
     2439   end.
     2440   assign
     2441   v-stat-list[1] =
     2442                    '' +           chr(4) + string(no) + chr(3) +
     2443                    'новый':U + chr(4) + string(no) + chr(3) +
     2444                    'факт':U +      chr(4) + string(no)
     2445   v-stat-list[2] =
     2446                    '' +           chr(4) + string(no) + chr(3) +
     2447                    'новый':U + chr(4) + string(no) + chr(3) +
     2448                    'новый':U + chr(4) + string(yes) + chr(3) +
     2449                    'нередакт':U + chr(4) + string(yes) + chr(3) +
     2450                    'факт':U +      chr(4) + string(no)
     2451   v-stat-list[3] =
     2452                    '' +         chr(4) + string(no) + chr(3) +
     2453                    'запрос':U + chr(4) + string(no)
     2454   .
     2455   _jj:
     2456   do v-jj = 1 to 2:
     2457     if v-jj = 1 then do:
     2458       assign
     2459       v-waiting-stfl = p-waiting-status + chr(4) + string(if p-waiting-flag = ? then no else p-waiting-flag)
     2460       .
     2461     end.
     2462     if v-jj = 2 then do:
     2463       if p-waiting-flag <> ? then leave  _jj.
     2464       assign
     2465       v-waiting-stfl = p-waiting-status + chr(4) + string(yes)
     2466       .
     2467     end.
     2468     assign
     2469     v-old-stfl = p-oldbh::status_ + chr(4) + string(p-oldbh::flag_)
     2470     .
     2471     assign
     2472     v-new-stfl = p-newbh::status_ + chr(4) + string(p-newbh::flag_)
     2473     .
     2474     _ii:
     2475     do v-ii = 1 to 3:
     2476       if v-stat-list[v-ii] = '' then next.
     2477       assign
     2478       v-waiting-stfl-i = lookup(v-waiting-stfl, v-stat-list[v-ii], chr(3))
     2479       v-old-stfl-i = lookup(v-old-stfl, v-stat-list[v-ii], chr(3))
     2480       v-new-stfl-i = lookup(v-new-stfl, v-stat-list[v-ii], chr(3))
     2481       .
     2482       if v-waiting-stfl-i = 0
     2483       or v-old-stfl-i = 0
     2484       or v-new-stfl-i = 0
     2485       then do:
     2486         next _ii.
     2487       end.
     2488       if v-old-stfl-i < v-waiting-stfl-i
     2489       and v-new-stfl-i = v-waiting-stfl-i then do:
     2490         assign
     2491         p-is-waiting-status = yes
     2492         p-direction = '<закрытие документа>':U + chr(4) + "to".
     2493         return.
     2494       end.
     2495       if v-old-stfl-i < v-waiting-stfl-i
     2496       and v-new-stfl-i > v-waiting-stfl-i then do:
     2497         assign
     2498         p-is-waiting-status = yes
     2499         p-direction = '<закрытие документа>':U + chr(4) + "to-up".
     2500         return.
     2501       end.
     2502       if v-new-stfl-i = v-waiting-stfl-i
     2503       and v-old-stfl-i > v-waiting-stfl-i then do:
     2504         assign
     2505         p-is-waiting-status = yes
     2506         p-direction = '<открытие документа>':U + chr(4) + "to".
     2507         return.
     2508       end.
     2509       if v-new-stfl-i < v-waiting-stfl-i
     2510       and v-old-stfl-i > v-waiting-stfl-i then do:
     2511         assign
     2512         p-is-waiting-status = yes
     2513         p-direction = '<открытие документа>':U + chr(4) + "to-down".
     2514         return.
     2515       end.
     2516       if v-old-stfl-i = v-waiting-stfl-i
     2517       and v-new-stfl-i > v-waiting-stfl-i then do:
     2518         assign
     2519         p-is-waiting-status = yes
     2520         p-direction = '<закрытие документа>':U + chr(4) + "from".
     2521         return.
     2522       end.
     2523       if v-old-stfl-i = v-waiting-stfl-i
     2524       and v-new-stfl-i < v-waiting-stfl-i then do:
     2525         assign
     2526         p-is-waiting-status = yes
     2527         p-direction = '<открытие документа>':U + chr(4) + "from".
     2528         return.
     2529       end.
     2530     end.
     2531   end.
     2532   end.
     2533   end procedure .
