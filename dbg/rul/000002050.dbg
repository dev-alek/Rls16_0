     2186   v-stat-list[lookup('ie':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 2] =
     2187                    '' +           chr(4) + string(no) + chr(3) +
     2188                    'запрос':U +   chr(4) + string(no) + chr(3) +
     2189                    'запрос':U +   chr(4) + string(yes) + chr(3) +
     2190                    'накл':U +      chr(4) + string(no) + chr(3) +
     2191                    'накл':U +      chr(4) + string(yes) + chr(3) +
     2192                    'разрешен':U + chr(4) + string(no) + chr(3) +
     2193                    'разрешен':U + chr(4) + string(yes) + chr(3) +
     2194                    'факт':U +      chr(4) + string(no)
     2195   .
     2196   assign
     2197   v-stat-list[lookup('vt':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] =
     2198                    '' +           chr(4) + string(no) + chr(3) +
     2199                    'запрос':U +   chr(4) + string(no) + chr(3) +
     2200                    'запрос':U +   chr(4) + string(yes) + chr(3) +
     2201                    'накл':U +      chr(4) + string(no) + chr(3) +
     2202                    'накл':U +      chr(4) + string(yes) + chr(3) +
     2203                    'разрешен':U + chr(4) + string(yes) + chr(3) +
     2204                    'разрешен':U + chr(4) + string(no) + chr(3) +
     2205                    'факт':U +      chr(4) + string(yes)
     2206   .
     2207   assign
     2208   v-stat-list[lookup('vt':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 2] =
     2209                    '' +           chr(4) + string(no) + chr(3) +
     2210                    'запрос':U +   chr(4) + string(no) + chr(3) +
     2211                    'запрос':U +   chr(4) + string(yes) + chr(3) +
     2212                    'накл':U +      chr(4) + string(no) + chr(3) +
     2213                    'накл':U +      chr(4) + string(yes) + chr(3) +
     2214                    'разрешен':U + chr(4) + string(yes) + chr(3) +
     2215                    'разрешен':U + chr(4) + string(no) + chr(3) +
     2216                    'факт':U +      chr(4) + string(no)
     2217   .
     2218   assign
     2219   v-stat-list[lookup('es':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] =
     2220                    '' +           chr(4) + string(no) + chr(3) +
     2221                    'касс':U + chr(4) + string(no) + chr(3) +
     2222                    'касс':U + chr(4) + string(yes) + chr(3) +
     2223                    'нередакт':U + chr(4) + string(yes) + chr(3) +
     2224                    'факт':U +      chr(4) + string(yes)
     2225   v-stat-list[lookup('rs':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] =
     2226                    '' +           chr(4) + string(no) + chr(3) +
     2227                    'касс':U + chr(4) + string(no) + chr(3) +
     2228                    'касс':U + chr(4) + string(yes) + chr(3) +
     2229                    'нередакт':U + chr(4) + string(yes) + chr(3) +
     2230                    'факт':U +      chr(4) + string(yes)
     2231   v-stat-list[lookup('es':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 2] =
     2232                    '' +         chr(4) + string(no) + chr(3) +
     2233                    'запрос':U + chr(4) + string(no)
     2234   v-stat-list[lookup('rs':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 2] =
     2235                    '' +         chr(4) + string(no) + chr(3) +
     2236                    'запрос':U + chr(4) + string(no)
     2237   .
     2238   _jj:
     2239   do v-jj = 1 to 2:
     2240     if v-jj = 1 then do:
     2241       assign
     2242       v-waiting-stfl = p-waiting-status + chr(4) + string(if p-waiting-flag = ? then yes else p-waiting-flag)
     2243       .
     2244     end.
     2245     if v-jj = 2 then do:
     2246       if p-waiting-flag <> ? then leave  _jj.
     2247       assign
     2248       v-waiting-stfl = p-waiting-status + chr(4) + string(no)
     2249       .
     2250     end.
     2251     assign
     2252     v-old-stfl = p-oldbh::status_ + chr(4) + string(p-oldbh::flag_)
     2253     .
     2254     assign
     2255     v-new-stfl = p-newbh::status_ + chr(4) + string(p-newbh::flag_)
     2256     .
     2257     _ii:
     2258     do v-ii = (lookup(v-ext-doc-type, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3) to (lookup(v-ext-doc-type, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4):
     2259       if v-stat-list[v-ii] = '' then next.
     2260       assign
