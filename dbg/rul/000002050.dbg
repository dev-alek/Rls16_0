     2681                                                           , 'cmd-esys-general':U
     2682                                                           , error-status:get-message(1)
     2683                                                           , return-value
     2684                                                           )).
     2685          return no .
     2686        end.
     2687        return yes.
     2688      end.
     2689   end.
