      427        FGCOLOR 10  NO-UNDO.
      428   DEFINE QUERY br-rule-i-script FOR
      429         X_rule-i-script,
      430         X_rule SCROLLING.
      431   DEFINE BROWSE br-rule-i-script
      432     QUERY br-rule-i-script NO-LOCK DISPLAY
      433         mark-string(recid(X_rule-i-script), v-rid-list) Format "X(1)" COLUMN-LABEL "*"
      434   X_rule-i-script.script_id COLUMN-LABEL "Код" FORMAT ">>>>>>>>9"
      435   X_rule-i-script.i-script-type COLUMN-LABEL "Тип!скрипта!в правиле" FORMAT "X(255)" WIDTH 20
      436   X_rule-i-script.i-script-name COLUMN-LABEL "Скрипт!в правиле" FORMAT "X(255)"  WIDTH 45
      437   X_rule-i-script.script-type COLUMN-LABEL "Тип!скрипта" FORMAT "X(255)" WIDTH 20
      438   X_rule-i-script.script-name COLUMN-LABEL "Скрипт" FORMAT "X(255)"  WIDTH 45
      439   X_rule-i-script.root_rule_id COLUMN-LABEL "№ правила" FORMAT ">>>>>>>>9"
      440   X_rule-i-script.dtm-code COLUMN-LABEL "Код объекта!операнда" FORMAT ">>9"
      441   X_rule-i-script.class-dtm-code COLUMN-LABEL "Код объекта!операнда!обслуж.класса" FORMAT ">>9"
      442   X_rule.name COLUMN-LABEL "Правило" FORMAT "X(255)"  WIDTH 45
      443       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 16 FIT-LAST-COLUMN.
      444   DEFINE FRAME Dialog-Frame
      445        b-quit AT ROW 1 COL 1
      446        b-mark AT ROW 1 COL 20 WIDGET-ID 12
      447        b-sel AT ROW 1 COL 24 WIDGET-ID 10
      448        b-del AT ROW 1 COL 34 WIDGET-ID 18
      449        b-text-2 AT ROW 1 COL 44 WIDGET-ID 24
      450        b-text AT ROW 1 COL 56 WIDGET-ID 22
      451        b-rule-script AT ROW 1 COL 68 WIDGET-ID 26
      452        B-Help AT ROW 1 COL 95
      453        br-rule-i-script AT ROW 2 COL 1 WIDGET-ID 100
      454        EDITOR-2 AT ROW 18 COL 1 NO-LABEL WIDGET-ID 20
      455        EDITOR-1 AT ROW 20.46 COL 1 NO-LABEL WIDGET-ID 16
      456        mark-num AT ROW 1 COL 10 COLON-ALIGNED NO-LABEL WIDGET-ID 14
      457        SPACE(79.50) SKIP(21.24)
      458       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      459            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      460            TITLE "Привязка правил к наборам"
      461            CANCEL-BUTTON b-quit.
      462   ASSIGN
      463          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      464          FRAME Dialog-Frame:HIDDEN           = TRUE.
      465   ASSIGN
      466          b-rule-script:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-b-rule-scirpt:HANDLE.
      467   ASSIGN
      468          EDITOR-1:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      469   ASSIGN
      470          EDITOR-2:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      471   ON GO OF FRAME Dialog-Frame
      472   DO:
      473     p-rid-list = v-rid-list.
      474   END.
      475   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      476   DO:
      477     APPLY "END-ERROR":U TO SELF.
      478   END.
      479   ON CHOOSE OF b-del IN FRAME Dialog-Frame
      480   DO:
      481   DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
      482   define buffer buf_rule-i-script for ub.rule-i-script.
      483   IF NOT AVAILABLE X_rule-i-script THEN RETURN NO-APPLY.
      484   MESSAGE
      485   "Вы уверены, что хотите удалить привязку?"
      486   VIEW-AS ALERT-BOX QUESTION
      487   BUTTONS YES-NO UPDATE glog.
      488   IF NOT glog THEN DO:
      489     RETURN NO-APPLY.
      490   END.
      491   find first buf_rule-i-script exclusive-lock where
      492             recid(buf_rule-i-script) = recid(X_rule-i-script).
      493   DELETE buf_rule-i-script.
      494   RUN openbr IN THIS-PROCEDURE .
      495   REPOSITION br-rule-i-script TO ROW 1 NO-ERROR.
      496   APPLY "ENTRY" TO br-rule-i-script.
      497   APPLY "VALUE-CHANGE" TO br-rule-i-script.
      498   END.
      499   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
      500   DO:
      501       define variable glog as logical no-undo .
      502     if available X_rule-i-script then do:
      503   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      504   define variable v-str-recid4 as character no-undo .
      505   define variable v-num-entry4 as integer   no-undo .
      506   assign
      507     v-str-recid4 = trim( string( recid( X_rule-i-script ) , "->>>>>>>>>>>9":U ) )
      508     v-num-entry4 = lookup( v-str-recid4 , v-rid-list )
      509   .
      510   if v-num-entry4 > 0 then do:
      511     assign
      512       entry( v-num-entry4, v-rid-list ) = "":U
      513       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
      514     .
      515   end.
      516   else do:
      517     assign
      518       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid4
      519     .
      520   end.
      521     glog = br-rule-i-script:refresh() .
      522     if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
      523         glog = br-rule-i-script:select-next-row ().
      524         apply "VALUE-CHANGED" to br-rule-i-script in frame Dialog-Frame.
      525     end.
      526     if num-entries( v-rid-list ) = 0
      527     then
      528         hide mark-num in frame Dialog-Frame.
      529     else
      530         disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
      531   end.
      532   apply "entry" to br-rule-i-script in frame Dialog-Frame.
      533   END.
      534   ON CHOOSE OF b-rule-script IN FRAME Dialog-Frame
      535   DO:
      536     if not available X_rule-i-script then return no-apply.
      537     IF rule-script-language = '':U THEN DO:
      538       run gbl/pop-up.p ( INPUT SELF :handle, input no ) no-error.
      539       if error-status :error then do: return no-apply. end.
      540     end.
      541     if rule-script-language = '':U then do:
      542         return no-apply.
      543     end.
      544     run proc-b-rule-script IN THIS-PROCEDURE ( INPUT rule-script-language) NO-ERROR.
      545     IF ERROR-STATUS:ERROR THEN DO:
      546         rule-script-language = ?.
      547         RETURN NO-APPLY.
      548     END.
      549     rule-script-language = '':U.
      550   END.
      551   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
      552   DO:
      553     if available X_rule-i-script then do:
      554       if  ( v-rid-list = "" ) or b-mark:sensitive = no
      555       then  v-rid-list = string( recid( X_rule-i-script ) ) .
      556     end.
      557   END.
      558   ON CHOOSE OF b-text IN FRAME Dialog-Frame
      559   DO:
      560     DEFINE VARIABLE v-longchar AS LONGCHAR NO-UNDO.
      561     DEFINE VARIABLE v-ok AS LOGical NO-UNDO.
      562     DEFINE BUFFER buf_rule-i-script FOR ub.rule-i-script.
      563     if not available X_rule-i-script then return no-apply.
      564     v-longchar = X_rule-i-script.script-name.
      565        run gbl/d-longchar.w (
      566                              INPUT ?
      567                             ,INPUT '':U
      568                             ,input-output v-longchar
      569                             ,output v-ok
      570                              ) NO-ERROR.
      571      IF ERROR-STATUS:ERROR
      572      OR NOT v-ok THEN undo, RETURN NO-apply.
      573      FIND FIRST buf_rule-i-script WHERE
      574               recid(buf_rule-i-script) = RECID(X_rule-i-script).
      575      ASSIGN
      576      buf_rule-i-script.script-name = v-longchar.
      577      v-longchar = '':U.
      578      br-rule-i-script:REFRESH()
      579      .
      580   END.
      581   ON CHOOSE OF b-text-2 IN FRAME Dialog-Frame
      582   DO:
      583     DEFINE VARIABLE v-longchar AS LONGCHAR NO-UNDO.
      584     DEFINE VARIABLE v-ok AS LOGical NO-UNDO.
      585     DEFINE BUFFER buf_rule-i-script FOR ub.rule-i-script.
      586     if not available X_rule-i-script then return no-apply.
      587     v-longchar = X_rule-i-script.i-script-name.
      588        run gbl/d-longchar.w (
      589                              INPUT ?
      590                             ,INPUT '':U
      591                             ,input-output v-longchar
      592                             ,output v-ok
      593                              ) NO-ERROR.
      594      IF ERROR-STATUS:ERROR
      595      OR NOT v-ok THEN undo, RETURN NO-apply.
      596      FIND FIRST buf_rule-i-script WHERE
      597               recid(buf_rule-i-script) = RECID(X_rule-i-script).
      598      ASSIGN
      599      buf_rule-i-script.i-script-name = v-longchar.
      600      v-longchar = '':U.
      601      br-rule-i-script:REFRESH().
      602   END.
      603   ON VALUE-CHANGED OF br-rule-i-script IN FRAME Dialog-Frame
      604   DO:
      605     IF AVAILABLE X_rule THEN DO:
      606       editor-1:SCREEN-VALUE = X_rule.documentation.
      607     END.
      608     ELSE DO:
      609       editor-1:SCREEN-VALUE = '':U.
      610     END.
      611   IF AVAILABLE X_rule-i-script THEN DO:
      612       editor-2:SCREEN-VALUE = X_rule-i-script.script-name.
      613     END.
      614     ELSE DO:
      615       editor-2:SCREEN-VALUE = '':U.
      616     END.
      617   END.
      618   ON CHOOSE OF MENU-ITEM m_abl
      619   DO:
      620       ASSIGN
      621     rule-script-language = "ABL".
      622     RUN proc-b-rule-script IN THIS-PROCEDURE ( INPUT rule-script-language) NO-ERROR.
      623     IF ERROR-STATUS:ERROR THEN DO:
      624         rule-script-language = '':U.
      625         RETURN NO-APPLY.
      626     END.
      627     rule-script-language = '':U.
