      385   DEFINE VARIABLE rule-script-language AS CHARACTER NO-UNDO.
      386   DEFINE MENU MENU-b-rule-scirpt
      387          MENU-ITEM m_abl          LABEL "ABL"
      388          MENU-ITEM m_rus          LABEL "RUS"           .
