      634     IF ERROR-STATUS:ERROR THEN DO:
      635         rule-script-language = '':U.
      636         RETURN NO-APPLY.
      637     END.
      638     rule-script-language = '':U.
      639   END.
      640   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      641   on f5 of frame Dialog-Frame anywhere
      642   do:
      643      v-doc-rec = recid(X_rule-i-script).    RUn OpenBR in this-procedure.  REPOSITION br-rule-i-script to recid v-doc-rec No-ERROR.   apply 'value-changed' to br-rule-i-script.
      644       apply "VALUE-CHANGED" to br-rule-i-script.
      645   end.
      646   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      647   on help of frame Dialog-Frame
      648   do:
      649     run gbl/app_help.p
      650       (input this-procedure :file-name
      651       ,input ''
      652       ,input ?
      653       ) no-error.
      654     if error-status :error then do:
      655       message
      656         "Ошибка при вызове помощи"
      657         error-status :get-message(1)
      658         view-as alert-box .
      659     end.
      660   end.
      661   run minbtn-set in this-procedure .
      662   on choose of b-help in frame Dialog-Frame
      663   do:
      664     apply "help":u to frame Dialog-Frame .
      665   end.
      666   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      667   procedure minbtn-set :
      668       do
      669           on error undo, return error return-value
      670           :
      671           define variable ii              as integer       no-undo .
      672           define variable fh              as widget-handle no-undo .
      673           define variable hh              as widget-handle no-undo .
      674           define variable v-h             as handle        extent 4 no-undo .
      675           define variable v-name-button   as character     no-undo .
      676           define variable v-help-old-x    as decimal       no-undo .
      677           define variable v-help-old-y    as decimal       no-undo .
      678           define variable v-help-old-size as decimal       no-undo .
      679           define variable v-frame-width   as decimal       no-undo .
      680           define variable jj              as integer       no-undo .
      681           do
      682               on error undo, return error
      683               :
      684               assign
      685                   v-frame-width = frame Dialog-Frame:width - 0.3
      686                   fh            = frame Dialog-Frame:first-child
      687                   hh            = fh:first-child
      688                   ii            = 1
      689                   .
      690               do while valid-handle(hh):
      691                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      692                   do:
      693                       case lc(hh:name) :
      694                           when "b-help" then
      695                               do:
      696                                   hh:load-image-up("cmp/b-help.bmp":u) .
      697                                   hh:load-image-down("cmp/b-help.bmp":u) .
      698                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      699                                   hh:TOOLTIP = "Помощь" .
      700                                   v-help-old-x = hh:column .
      701                                   v-help-old-y = hh:row    .
      702                                   v-help-old-size = hh:width .
      703                                   hh:width-chars = 2.5 .
      704                               end.
      705                           when "b-print" then
      706                               do:
      707                                   hh:load-image("cmp/b-print.bmp":u) .
      708                                   hh:TOOLTIP = "Печать" .
      709                                   v-h[ii] = hh:handle .
      710                                   ii = ii + 1 .
      711                                   hh:width-chars = 3 .
      712                               end.
      713                           when "b-history" or
      714                           when "b-hist" then
      715                               do:
      716                                   hh:load-image("cmp/b-hist.bmp":u) .
      717                                   hh:TOOLTIP = "История" .
      718                                   v-h[ii] = hh:handle .
      719                                   ii = ii + 1 .
      720                                   hh:width-chars = 3 .
      721                               end.
      722                           when "b-sch" then
      723                               do:
      724                                   hh:load-image("cmp/b-sch.bmp":u) .
      725                                   hh:TOOLTIP = "Установка Фильтра" .
      726                                   v-h[ii] = hh:handle .
      727                                   ii = ii + 1 .
      728                                   hh:width-chars = 3 .
      729                               end.
      730                           when "b-hist-user" then
      731                               do:
      732                                   hh:load-image("cmp/b-hist.bmp":u) .
      733                                   hh:TOOLTIP = "История пользователя" .
      734                                   ii = ii + 1 .
      735                               end.
      736                       end case.
      737                   end.
      738                   hh = hh:next-sibling.
      739               end.
      740               b-help:column = v-frame-width - b-help:width-chars.
      741               jj = 0.
      742               repeat ii = 4 to 1 by -1 :
      743                   if valid-handle (v-h[ii] ) then
      744                   do:
      745                       jj  = jj + 1 .
      746                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      747                       v-h[ii]:row    = v-help-old-y .
      748                   end.
      749               end.
      750           end.
      751       end.
      752   end procedure.
      753   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      754   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      755   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      756   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      757   define variable v-diasize-current-frame-width  as decimal   no-undo .
      758   define variable v-diasize-current-frame-height as decimal   no-undo .
      759   define variable v-diasize-change-size          as logical   no-undo .
      760   define variable v-diasize-resize-button        as handle    no-undo .
      761   define variable v-diasize-wndmax               as logical   no-undo .
      762   define variable v-diasize-wndstore             as logical   no-undo .
      763   define variable v-diasize-proc-name            as character no-undo .
      764   define variable v-diasize-browse-handle        as handle    no-undo .
      765   define variable v-diasize-browse-number        as integer   no-undo .
      766   define variable v-diasize-need-full-display    as logical   no-undo init false .
      767   define temp-table temp-diasize-handle no-undo
      768     field handle-value  as handle
      769     field save-position as decimal
      770     index xpk is primary unique handle-value
      771     .
      772   define temp-table temp-browse-handle no-undo
      773     field browse-type   as character
      774     field browse-number as integer
      775     field browse-handle as handle
      776     field original-size as decimal
      777     index xpk is primary unique browse-type browse-number
      778     index xie browse-type browse-handle
      779   .
      780   procedure diasize_change-height :
      781     define input  parameter p-change-value  as decimal   no-undo .
      782     define input  parameter p-move-resize   as logical   no-undo .
      783     define variable v-field-group-handle    as handle    no-undo .
      784     define variable v-object-handle         as handle    no-undo .
      785     define variable v-frame-height          as decimal   no-undo .
      786     define variable v-frame-virtual-height  as decimal   no-undo .
      787     define variable v-browse-height         as decimal   no-undo .
      788     define variable v-window-height         as decimal   no-undo .
      789     define variable v-window-virtual-height as decimal   no-undo .
      790     define variable v-change-sign           as integer   no-undo .
      791     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      792     define buffer buf_temp-browse-handle  for temp-browse-handle .
      793     if p-change-value > 0
      794     then do:
      795       if frame Dialog-Frame :height + p-change-value
      796           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      797       then do:
      798         assign
      799           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      800                           - (frame Dialog-Frame :height-chars)
      801         .
      802         if p-change-value <= 0
      803         then do:
      804           run diasize_position-resize-button in this-procedure .
      805           return .
      806         end.
      807       end.
      808     end.
      809     if p-change-value < 0
      810     then do:
      811       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      812       then do:
      813         assign
      814           p-change-value = v-diasize-orig-frame-height
      815                          - (frame Dialog-Frame :height-chars)
      816         .
      817         if p-change-value >= 0
      818         then do:
      819           run diasize_position-resize-button in this-procedure .
      820           return .
      821         end.
      822       end.
      823     end.
      824     if p-change-value >= 0
      825     then do:
      826       assign
      827         v-change-sign = 1
      828       .
      829     end.
      830     else do:
      831       assign
      832         v-change-sign = -1
      833       .
      834     end.
      835     assign
      836       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      837     .
      838     if p-change-value = 0
      839     then do:
      840       run diasize_position-resize-button in this-procedure .
      841       return .
      842     end.
      843     move_block:
      844     do
      845     on error undo move_block, retry move_block
      846     :
      847       if retry
      848       then do:
      849         do
      850         on error undo move_block, leave move_block
      851         :
      852           if p-change-value > 0
      853           then do:
      854             for each buf_temp-diasize-handle
      855             on error undo, next
      856             :
      857               assign
      858                 v-object-handle = buf_temp-diasize-handle.handle-value
      859               .
      860               if v-object-handle <> v-diasize-resize-button
      861               then do:
      862                 assign
      863                   v-object-handle :row = buf_temp-diasize-handle.save-position
      864                 .
      865               end.
      866             end.
      867             assign
      868               v-diasize-browse-handle :height = v-browse-height
      869             .
      870             for each buf_temp-browse-handle
      871               where buf_temp-browse-handle.browse-type = 'height':u
      872             on error undo, next
      873             :
      874               assign
      875                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      876               .
      877             end.
      878             assign
      879               frame Dialog-Frame :height = v-frame-height
      880             .
      881             if frame Dialog-Frame :scrollable = true
      882             then do:
      883               assign
      884                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      885               .
      886             end.
      887             run diasize_position-resize-button in this-procedure .
      888           end.
      889           else do:
      890             if frame Dialog-Frame :scrollable = true
      891             then do:
      892               assign
      893                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      894               .
      895             end.
      896             assign
      897               frame Dialog-Frame :height = v-frame-height
      898             .
      899             assign
      900               v-diasize-browse-handle :height = v-browse-height
      901             .
      902             for each buf_temp-browse-handle
      903               where buf_temp-browse-handle.browse-type = 'height':u
      904             on error undo, next
      905             :
      906               assign
      907                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      908               .
      909             end.
      910             for each buf_temp-diasize-handle
      911             on error undo, next
      912             :
      913               assign
      914                 v-object-handle = buf_temp-diasize-handle.handle-value
      915               .
      916               if v-object-handle <> v-diasize-resize-button
      917               then do:
      918                 assign
      919                   v-object-handle :row = buf_temp-diasize-handle.save-position
      920                 .
      921               end.
      922             end.
      923             run diasize_position-resize-button in this-procedure .
      924           end.
      925           assign
      926             v-diasize-change-size = false
      927           .
      928           leave move_block .
      929         end.
      930       end.
      931       assign
      932         v-diasize-need-full-display = true
      933       .
      934       if v-diasize-change-size = false
      935       then do:
      936         assign
      937           v-diasize-change-size = true
      938         .
      939       end.
      940       else do:
      941         return .
      942       end.
      943       assign
      944         v-frame-height = frame Dialog-Frame :height
      945         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      946         v-browse-height = v-diasize-browse-handle :height
      947       .
      948       for each buf_temp-browse-handle
      949         where buf_temp-browse-handle.browse-type = 'height':u
      950       :
      951         assign
      952           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      953         .
      954       end.
      955       for each buf_temp-diasize-handle
      956       :
      957         delete buf_temp-diasize-handle .
      958       end.
      959       assign
      960         v-field-group-handle = frame Dialog-Frame :first-child
      961       .
      962       do while valid-handle(v-field-group-handle)
      963       :
      964         assign
      965           v-object-handle = v-field-group-handle :first-child
      966         .
      967         do while valid-handle(v-object-handle)
      968         :
      969           if  v-object-handle <> v-diasize-browse-handle :handle
      970           and can-query(v-object-handle, "row")
      971           and can-query(v-object-handle, "height")
      972           and ( v-object-handle :row > v-diasize-browse-handle :row )
      973           then do:
      974             find first buf_temp-browse-handle
      975               where buf_temp-browse-handle.browse-type   = 'height':u
      976                 and buf_temp-browse-handle.browse-handle = v-object-handle
      977               no-error .
      978             if available buf_temp-browse-handle
      979             then do:
      980             end.
      981             else do:
      982               create buf_temp-diasize-handle .
      983               assign
      984                 buf_temp-diasize-handle.handle-value  = v-object-handle
      985                 buf_temp-diasize-handle.save-position = v-object-handle :row
      986               .
      987             end.
      988           end.
      989           assign
      990             v-object-handle = v-object-handle :next-sibling
      991           .
      992         end.
      993         assign
      994           v-field-group-handle = v-field-group-handle :next-sibling
      995         .
      996       end.
      997       do with frame Dialog-Frame
      998       :
      999         hide v-diasize-resize-button .
     1000         assign
     1001           v-diasize-resize-button :row    = 1
     1002           v-diasize-resize-button :column = 1
     1003         .
     1004       end.
     1005       if p-change-value > 0
     1006       then do:
     1007         if frame Dialog-Frame :scrollable = true
     1008         then do:
     1009           assign
     1010             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1011             no-error .
     1012           if error-status :error
     1013           or error-status :get-message(1) <> ""
     1014           then do:
     1015             undo move_block, retry move_block .
     1016           end.
     1017         end.
     1018         assign
     1019           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1020           no-error .
     1021         if error-status :error
     1022         or error-status :get-message(1) <> ""
     1023         then do:
     1024           undo move_block, retry move_block .
     1025         end.
     1026         assign
     1027           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1028           no-error .
     1029         if error-status :error
     1030         or error-status :get-message(1) <> ""
     1031         then do:
     1032           undo move_block, retry move_block .
     1033         end.
     1034         for each buf_temp-browse-handle
     1035           where buf_temp-browse-handle.browse-type = 'height':u
     1036         on error undo move_block, retry move_block
     1037         :
     1038           assign
     1039             buf_temp-browse-handle.browse-handle :height
     1040               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1041             no-error .
     1042           if error-status :error
     1043           or error-status :get-message(1) <> ""
     1044           then do:
     1045             undo move_block, retry move_block .
     1046           end.
     1047         end.
     1048         for each buf_temp-diasize-handle
     1049         on error undo move_block, retry move_block
     1050         :
     1051           assign
     1052             v-object-handle = buf_temp-diasize-handle.handle-value
     1053           .
     1054           if v-object-handle <> v-diasize-resize-button
     1055           then do:
     1056             assign
     1057               v-object-handle :row = v-object-handle :row + p-change-value
     1058               no-error .
     1059             if error-status :error
     1060             or error-status :get-message(1) <> ""
     1061             then do:
     1062               undo move_block, retry move_block .
     1063             end.
     1064           end.
     1065         end.
     1066       end.
     1067       else do:
     1068         for each buf_temp-diasize-handle
     1069         on error undo move_block, retry move_block
     1070         :
     1071           assign
     1072             v-object-handle = buf_temp-diasize-handle.handle-value
     1073           .
     1074           if v-object-handle <> v-diasize-resize-button
     1075           then do:
     1076             assign
     1077               v-object-handle :row = v-object-handle :row + p-change-value
     1078               no-error .
     1079             if error-status :error
     1080             or error-status :get-message(1) <> ""
     1081             then do:
     1082               undo move_block, retry move_block .
     1083             end.
     1084           end.
     1085         end.
     1086         assign
     1087           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1088           no-error .
     1089         if error-status :error
     1090         or error-status :get-message(1) <> ""
     1091         then do:
     1092           undo move_block, retry move_block .
     1093         end.
     1094         for each buf_temp-browse-handle
     1095           where buf_temp-browse-handle.browse-type = 'height':u
     1096         on error undo move_block, retry move_block
     1097         :
     1098           assign
     1099             buf_temp-browse-handle.browse-handle :height
     1100               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1101             no-error .
     1102           if error-status :error
     1103           or error-status :get-message(1) <> ""
     1104           then do:
     1105             undo move_block, retry move_block .
     1106           end.
     1107         end.
     1108         assign
     1109           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1110           no-error .
     1111         if error-status :error
     1112         or error-status :get-message(1) <> ""
     1113         then do:
     1114           undo move_block, retry move_block .
     1115         end.
     1116         if frame Dialog-Frame :scrollable = true
     1117         then do:
     1118           assign
     1119             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1120             no-error .
     1121           if error-status :error
     1122           or error-status :get-message(1) <> ""
     1123           then do:
     1124             undo move_block, retry move_block .
     1125           end.
     1126         end.
     1127       end.
     1128       if p-move-resize = true
     1129       then do:
     1130         run diasize_position-resize-button in this-procedure .
     1131       end.
     1132       if v-diasize-wndstore = true
     1133       then do:
     1134         if connected("ub") = true
     1135         then do:
     1136           define variable v-cntxt-db-num        as integer   no-undo .
     1137           define variable v-cntxt-userid        as character no-undo .
     1138           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1139                                             , OUTPUT v-cntxt-userid
     1140                                             ) .
     1141           run gbl/wndsizew.p
     1142             (input  v-cntxt-db-num
     1143             ,input  v-cntxt-userid
     1144             ,input  v-diasize-proc-name
     1145             ,input  'height':u
     1146             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1147             ) .
     1148         end.
     1149       end.
     1150     end.
     1151     assign
     1152       v-diasize-change-size = false
     1153     .
     1154   end procedure.
     1155   procedure diasize_set-height :
     1156     define input  parameter p-new-height  as decimal   no-undo .
     1157     define input  parameter p-move-resize as logical   no-undo .
     1158     do
     1159     on error undo, return error return-value
     1160     :
     1161       run diasize_change-height in this-procedure
     1162         (input  (p-new-height - frame Dialog-Frame :height)
     1163         ,input  p-move-resize
     1164         ) .
     1165     end.
     1166   end procedure.
     1167   procedure diasize_change-width :
     1168     define input  parameter p-change-value as decimal   no-undo .
     1169     define input  parameter p-move-resize  as logical   no-undo .
     1170     define variable v-field-group-handle   as handle    no-undo .
     1171     define variable v-object-handle        as handle    no-undo .
     1172     define variable v-frame-width          as decimal   no-undo .
     1173     define variable v-frame-virtual-width  as decimal   no-undo .
     1174     define variable v-browse-width         as decimal   no-undo .
     1175     define variable v-window-width         as decimal   no-undo .
     1176     define variable v-window-virtual-width as decimal   no-undo .
     1177     define variable v-change-sign          as integer   no-undo .
     1178     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1179     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1180     if p-change-value > 0
     1181     then do:
     1182       if frame Dialog-Frame :width + p-change-value >
     1183           session :width-chars
     1184       then do:
     1185         assign
     1186           p-change-value = session :width-chars - frame Dialog-Frame :width
     1187         .
     1188         if p-change-value <= 0
     1189         then do:
     1190           run diasize_position-resize-button in this-procedure .
     1191           return .
     1192         end.
     1193       end.
     1194     end.
     1195     if p-change-value < 0
     1196     then do:
     1197       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1198       then do:
     1199         assign
     1200           p-change-value = v-diasize-orig-frame-width
     1201                          - frame Dialog-Frame :width
     1202         .
     1203         if p-change-value >= 0
     1204         then do:
     1205           run diasize_position-resize-button in this-procedure .
     1206           return .
     1207         end.
     1208       end.
     1209     end.
     1210     if p-change-value >= 0
     1211     then do:
     1212       assign
     1213         v-change-sign = 1
     1214       .
     1215     end.
     1216     else do:
     1217       assign
     1218         v-change-sign = -1
     1219       .
     1220     end.
     1221     assign
     1222       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1223     .
     1224     if p-change-value = 0
     1225     then do:
     1226       run diasize_position-resize-button in this-procedure .
     1227       return .
     1228     end.
     1229     move_block:
     1230     do
     1231     on error undo move_block, leave move_block
     1232     :
     1233       if retry
     1234       then do:
     1235         do
     1236         on error undo move_block, leave move_block
     1237         :
     1238           if p-change-value > 0
     1239           then do:
     1240             for each buf_temp-diasize-handle
     1241             on error undo, next
     1242             :
     1243               assign
     1244                 v-object-handle = buf_temp-diasize-handle.handle-value
     1245               .
     1246               if v-object-handle <> v-diasize-resize-button
     1247               then do:
     1248                 assign
     1249                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1250                 .
     1251               end.
     1252             end.
     1253             assign
     1254               v-diasize-browse-handle :width = v-browse-width
     1255             .
     1256             for each buf_temp-browse-handle
     1257               where buf_temp-browse-handle.browse-type = 'width':u
     1258             on error undo, next
     1259             :
     1260               assign
     1261                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1262               .
     1263             end.
     1264             assign
     1265               frame Dialog-Frame :width = v-frame-width
     1266             .
     1267             if frame Dialog-Frame :scrollable = true
     1268             then do:
     1269               assign
     1270                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1271               .
     1272             end.
     1273             run diasize_position-resize-button in this-procedure .
     1274           end.
     1275           else do:
     1276             if frame Dialog-Frame :scrollable = true
     1277             then do:
     1278               assign
     1279                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1280               .
     1281             end.
     1282             assign
     1283               frame Dialog-Frame :width = v-frame-width
     1284             .
     1285             for each buf_temp-browse-handle
     1286               where buf_temp-browse-handle.browse-type = 'width':u
     1287             on error undo, next
     1288             :
     1289               assign
     1290                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1291               .
     1292             end.
     1293             assign
     1294               v-diasize-browse-handle :width = v-browse-width
     1295             .
     1296             for each buf_temp-diasize-handle
     1297             on error undo, next
     1298             :
     1299               assign
     1300                 v-object-handle = buf_temp-diasize-handle.handle-value
     1301               .
     1302               if v-object-handle <> v-diasize-resize-button
     1303               then do:
     1304                 assign
     1305                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1306                 .
     1307               end.
     1308             end.
     1309             run diasize_position-resize-button in this-procedure .
     1310           end.
     1311           assign
     1312             v-diasize-change-size = false
     1313           .
     1314           leave move_block .
     1315         end.
     1316       end.
     1317       assign
     1318         v-diasize-need-full-display = true
     1319       .
     1320       if v-diasize-change-size = false
     1321       then do:
     1322         assign
     1323           v-diasize-change-size = true
     1324         .
     1325       end.
     1326       else do:
     1327         return .
     1328       end.
     1329       assign
     1330         v-frame-width = frame Dialog-Frame :width
     1331         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1332         v-browse-width = v-diasize-browse-handle :width
     1333       .
     1334       for each buf_temp-browse-handle
     1335         where buf_temp-browse-handle.browse-type = 'width':u
     1336       :
     1337         assign
     1338           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1339         .
     1340       end.
     1341       for each buf_temp-diasize-handle
     1342       :
     1343         delete buf_temp-diasize-handle .
     1344       end.
     1345       assign
     1346         v-field-group-handle = frame Dialog-Frame :first-child
     1347       .
     1348       do while valid-handle(v-field-group-handle)
     1349       :
     1350         assign
     1351           v-object-handle = v-field-group-handle :first-child
     1352         .
     1353         do while valid-handle(v-object-handle)
     1354         :
     1355           if  v-object-handle <> v-diasize-browse-handle :handle
     1356           and v-object-handle <> v-diasize-resize-button
     1357           and can-query(v-object-handle, "row")
     1358           and can-query(v-object-handle, "height")
     1359           and ( v-object-handle :col + v-object-handle :width
     1360                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1361               )
     1362           then do:
     1363             find first buf_temp-browse-handle
     1364               where buf_temp-browse-handle.browse-type   = 'width':u
     1365                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1366               no-error .
     1367             if available buf_temp-browse-handle
     1368             then do:
     1369             end.
     1370             else do:
     1371               create buf_temp-diasize-handle .
     1372               assign
     1373                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1374                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1375               .
     1376             end.
     1377           end.
     1378           assign
     1379             v-object-handle = v-object-handle :next-sibling
     1380           .
     1381         end.
     1382         assign
     1383           v-field-group-handle = v-field-group-handle :next-sibling
     1384         .
     1385       end.
     1386       do with frame Dialog-Frame
     1387       :
     1388         hide v-diasize-resize-button .
     1389         v-diasize-resize-button :row = 1.
     1390         v-diasize-resize-button :column = 1.
     1391       end.
     1392       if p-change-value > 0
     1393       then do:
     1394         if frame Dialog-Frame :scrollable = true
     1395         then do:
     1396           assign
     1397             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1398             no-error .
     1399           if error-status :error
     1400           or error-status :get-message(1) <> ""
     1401           then do:
     1402             undo move_block, retry move_block.
     1403           end.
     1404         end.
     1405         assign
     1406           frame Dialog-Frame :width = v-frame-width + p-change-value
     1407           no-error .
     1408         if error-status :error
     1409         or error-status :get-message(1) <> ""
     1410         then do:
     1411           undo move_block, retry move_block.
     1412         end.
     1413         assign
     1414           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1415         no-error .
     1416         if error-status :error
     1417         or error-status :get-message(1) <> ""
     1418         then do:
     1419           undo move_block, retry move_block.
     1420         end.
     1421         for each buf_temp-browse-handle
     1422           where buf_temp-browse-handle.browse-type = 'width':u
     1423         on error undo move_block, retry move_block
     1424         :
     1425           assign
     1426             buf_temp-browse-handle.browse-handle :width
     1427               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1428             no-error .
     1429           if error-status :error
     1430           or error-status :get-message(1) <> ""
     1431           then do:
     1432             undo move_block, retry move_block .
     1433           end.
     1434         end.
     1435         for each buf_temp-diasize-handle
     1436         on error undo move_block, retry move_block
     1437         :
     1438           assign
     1439             v-object-handle = buf_temp-diasize-handle.handle-value
     1440           .
     1441           if v-object-handle <> v-diasize-resize-button
     1442           then do:
     1443             assign
     1444               v-object-handle :col = v-object-handle :col + p-change-value
     1445               no-error .
     1446             if error-status :error
     1447             or error-status :get-message(1) <> ""
     1448             then do:
     1449               undo move_block, retry move_block .
     1450             end.
     1451           end.
     1452         end.
     1453       end.
     1454       else do:
     1455         for each buf_temp-diasize-handle
     1456         on error undo move_block, retry move_block
     1457         :
     1458           assign
     1459             v-object-handle = buf_temp-diasize-handle.handle-value
     1460           .
     1461           if v-object-handle <> v-diasize-resize-button
     1462           then do:
     1463             assign
     1464               v-object-handle :col = v-object-handle :col + p-change-value
     1465               no-error .
     1466             if error-status :error
     1467             or error-status :get-message(1) <> ""
     1468             then do:
     1469               undo move_block, retry move_block .
     1470             end.
     1471           end.
     1472         end.
     1473         for each buf_temp-browse-handle
     1474           where buf_temp-browse-handle.browse-type = 'width':u
     1475         on error undo move_block, retry move_block
     1476         :
     1477           assign
     1478             buf_temp-browse-handle.browse-handle :width
     1479               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1480             no-error .
     1481           if error-status :error
     1482           or error-status :get-message(1) <> ""
     1483           then do:
     1484             undo move_block, retry move_block .
     1485           end.
     1486         end.
     1487         assign
     1488           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1489           no-error .
     1490         if error-status :error
     1491         or error-status :get-message(1) <> ""
     1492         then do:
     1493           undo move_block, retry move_block.
     1494         end.
     1495         assign
     1496           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1497         no-error .
     1498         if error-status :error
     1499         or error-status :get-message(1) <> ""
     1500         then do:
     1501           undo move_block, retry move_block.
     1502         end.
     1503         if frame Dialog-Frame :scrollable = true
     1504         then do:
     1505           assign
     1506             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1507           no-error .
     1508           if error-status :error
     1509           or error-status :get-message(1) <> ""
     1510           then do:
     1511             undo move_block, retry move_block.
     1512           end.
     1513         end.
     1514       end.
     1515       if p-move-resize
     1516       then do:
     1517         run diasize_position-resize-button in this-procedure .
     1518       end.
     1519       if v-diasize-wndstore = true
     1520       then do:
     1521         if connected("ub") = true
     1522         then do:
     1523           define variable v-cntxt-db-num        as integer   no-undo .
     1524           define variable v-cntxt-userid        as character no-undo .
     1525           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1526                                             , OUTPUT v-cntxt-userid
     1527                                             ) .
     1528           run gbl/wndsizew.p
     1529             (input  v-cntxt-db-num
     1530             ,input  v-cntxt-userid
     1531             ,input  v-diasize-proc-name
     1532             ,input  'width':u
     1533             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1534             ) .
     1535         end.
     1536       end.
     1537     end.
     1538     assign
     1539       v-diasize-change-size = false
     1540     .
     1541   end procedure.
     1542   procedure diasize_set-width :
     1543     define input  parameter p-new-width  as decimal   no-undo .
     1544     define input  parameter p-move-resize as logical   no-undo .
     1545     do
     1546     on error undo, return error return-value
     1547     :
     1548       run diasize_change-width in this-procedure
     1549         (input  (p-new-width - frame Dialog-Frame :width)
     1550         ,input  p-move-resize
     1551         ) .
     1552     end.
     1553   end procedure.
     1554   procedure diasize_position-resize-button :
     1555     do with frame Dialog-Frame
     1556     :
     1557       hide v-diasize-resize-button .
     1558       assign
     1559         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1560                     - 1
     1561                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1562         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1563                     - 1
     1564                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1565       .
     1566       view v-diasize-resize-button .
     1567     end.
     1568   end procedure.
     1569   on alt-right anywhere
     1570   do:
     1571     run diasize_change-width in this-procedure
     1572       (input 1
     1573       ,input true
     1574       ) .
     1575     return no-apply .
     1576   end.
     1577   on alt-left anywhere
     1578   do:
     1579     run diasize_change-width in this-procedure
     1580       (input -1
     1581       ,input true
     1582       ) .
     1583     return no-apply .
     1584   end.
     1585   on alt-down anywhere
     1586   do:
     1587     run diasize_change-height in this-procedure
     1588       (input 1
     1589       ,input true
     1590       ) .
     1591     return no-apply .
     1592   end.
     1593   on alt-up anywhere
     1594   do:
     1595     run diasize_change-height in this-procedure
     1596       (input -1
     1597       ,input true
     1598       ) .
     1599     return no-apply .
     1600   end.
     1601   on alt-enter of frame Dialog-Frame
     1602   do:
     1603     run diasize_maximize in this-procedure
     1604       (input  ?
     1605       ).
     1606     return no-apply .
     1607   end.
     1608   procedure diasize_end-move :
     1609     do
     1610     on error undo, return error return-value
     1611     :
     1612       define variable v-row-delta as decimal   no-undo .
     1613       define variable v-col-delta as decimal   no-undo .
     1614       define variable v-new-row as decimal   no-undo .
     1615       define variable v-new-col as decimal   no-undo .
     1616       assign
     1617         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1618         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1619       .
     1620       assign
     1621         v-row-delta = v-new-row - frame Dialog-Frame :height
     1622         v-col-delta = v-new-col - frame Dialog-Frame :width
     1623       .
     1624       run diasize_change-height in this-procedure
     1625         (input v-row-delta
     1626         ,input true
     1627         ) .
     1628       run diasize_change-width in this-procedure
     1629         (input v-col-delta
     1630         ,input true
     1631         ) .
     1632     end.
     1633   end procedure.
     1634   procedure diasize_maximize :
     1635     define input  parameter p-action as logical   no-undo .
     1636     do
     1637     on error undo, return error return-value
     1638     :
     1639       if p-action = ?
     1640       then do:
     1641         if v-diasize-need-maximize = true
     1642         then do:
     1643           assign
     1644             p-action = true
     1645           .
     1646         end.
     1647         else do:
     1648           assign
     1649             p-action = false
     1650           .
     1651         end.
     1652       end.
     1653       if p-action = true
     1654       then do:
     1655         run diasize_change-height in this-procedure
     1656           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1657               - frame Dialog-Frame :height-chars
     1658           ,input true
     1659           ) .
     1660         run diasize_change-width in this-procedure
     1661           (input session :width-chars
     1662               - frame Dialog-Frame :width-chars
     1663           ,input true
     1664           ) .
     1665         assign
     1666           v-diasize-need-maximize = false
     1667         .
     1668       end.
     1669       else do:
     1670         run diasize_change-width in this-procedure
     1671           (input v-diasize-orig-frame-width
     1672               - frame Dialog-Frame :width-chars
     1673           ,input true
     1674           ) .
     1675         run diasize_change-height in this-procedure
     1676           (input v-diasize-orig-frame-height
     1677               - frame Dialog-Frame :height-chars
     1678           ,input true
     1679           ) .
     1680         assign
     1681           v-diasize-need-maximize = true
     1682         .
     1683       end.
     1684     end.
     1685   end procedure.
     1686   procedure diasize_restore-orig-size :
     1687     do
     1688     on error undo, return error return-value
     1689     :
     1690       assign
     1691         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1692         v-diasize-current-frame-height = frame Dialog-Frame :height
     1693       .
     1694       run diasize_set-height in this-procedure
     1695         (input  v-diasize-orig-frame-height
     1696         ,input  true
     1697         ) .
     1698       run diasize_set-width in this-procedure
     1699         (input  v-diasize-orig-frame-width
     1700         ,input  true
     1701         ) .
     1702     end.
     1703   end procedure.
     1704   procedure diasize_restore-current-size :
     1705     do
     1706     on error undo, return error return-value
     1707     :
     1708       run diasize_set-height in this-procedure
     1709         (input  v-diasize-current-frame-height
     1710         ,input  true
     1711         ) .
     1712       run diasize_set-width in this-procedure
     1713         (input  v-diasize-current-frame-width
     1714         ,input  true
     1715         ) .
     1716     end.
     1717   end procedure.
     1718   procedure diasize_set-browse-handle :
     1719     define input  parameter p-browse-handle as handle   no-undo .
     1720     define buffer buf_temp-browse-handle for temp-browse-handle .
     1721     do
     1722     on error undo, return error return-value
     1723     :
     1724       assign
     1725         v-diasize-browse-handle = p-browse-handle
     1726       .
     1727       for each buf_temp-browse-handle
     1728       on error undo, return error return-value
     1729       :
     1730         delete buf_temp-browse-handle .
     1731       end.
     1732     end.
     1733   end procedure.
     1734   procedure diasize_add_browse :
     1735     define input  parameter p-browse-type   as character no-undo .
     1736     define input  parameter p-browse-handle as handle    no-undo .
     1737     define buffer buf_temp-browse-handle for temp-browse-handle .
     1738     do
     1739     on error undo, return error return-value
     1740     :
     1741       assign
     1742         v-diasize-browse-number = v-diasize-browse-number + 1
     1743       .
     1744       create buf_temp-browse-handle .
     1745       assign
     1746         buf_temp-browse-handle.browse-type   = p-browse-type
     1747         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1748         buf_temp-browse-handle.browse-handle = p-browse-handle
     1749       .
     1750     end.
     1751   end procedure.
     1752   procedure diasize_init :
     1753     define variable v-default-value    as logical   no-undo .
     1754     define variable v-restore-saved    as logical   no-undo .
     1755     define variable v-resize-value-str as character no-undo .
     1756     do
     1757     on error undo, return error return-value
     1758     :
     1759       do with frame Dialog-Frame
     1760       :
     1761         assign
     1762           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1763           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1764           v-diasize-browse-handle     = browse br-rule-i-script :handle
     1765         .
     1766         create button v-diasize-resize-button
     1767         assign
     1768           parent        = frame Dialog-Frame :first-child
     1769           label         = "s"
     1770           height-pixels = 16
     1771           width-pixels  = 16
     1772           visible       = true
     1773           sensitive     = true
     1774           movable       = true
     1775           triggers:
     1776             on end-move persistent run diasize_end-move in this-procedure .
     1777           end triggers.
     1778         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1779         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1780         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1781         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1782         assign
     1783           v-diasize-wndmax = false
     1784         .
     1785         if connected("ub") = true
     1786         then do:
     1787           define variable v-cntxt-db-num        as integer   no-undo .
     1788           define variable v-cntxt-userid        as character no-undo .
     1789           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1790                                             , OUTPUT v-cntxt-userid
     1791                                             ) .
     1792           run gbl/wndpar_r.p
     1793             (input  v-cntxt-db-num
     1794             ,input  v-cntxt-userid
     1795             ,input  'wndmax':U
     1796             ,output v-diasize-wndmax
     1797             ,output v-default-value
     1798             ) .
     1799         end.
     1800         assign
     1801           v-diasize-wndstore = false
     1802         .
     1803         if connected("ub") = true
     1804         then do:
     1805           run gbl/wndpar_r.p
     1806             (input  v-cntxt-db-num
     1807             ,input  v-cntxt-userid
     1808             ,input  'wndstore':U
     1809             ,output v-diasize-wndstore
     1810             ,output v-default-value
     1811             ) .
     1812         end.
     1813         assign
     1814           v-diasize-proc-name = entry(1, program-name(2), '.')
     1815         .
     1816         if v-diasize-wndstore = true
     1817         then do:
     1818           assign
     1819             v-restore-saved = false
     1820           .
     1821           if connected("ub") = true
     1822           then do:
     1823             run gbl/wndsizer.p
     1824               (input  v-cntxt-db-num
     1825               ,input  v-cntxt-userid
     1826               ,input  v-diasize-proc-name
     1827               ,input  'height':u
     1828               ,output v-resize-value-str
     1829               ) .
     1830             if v-resize-value-str <> '':U
     1831             then do:
     1832               run diasize_change-height in this-procedure
     1833                 (input  integer(v-resize-value-str)
     1834                 ,input  true
     1835                 ) .
     1836               assign
     1837                 v-restore-saved = true
     1838               .
     1839             end.
     1840           end.
     1841           if connected("ub") = true
     1842           then do:
     1843             run gbl/wndsizer.p
     1844               (input  v-cntxt-db-num
     1845               ,input  v-cntxt-userid
     1846               ,input  v-diasize-proc-name
     1847               ,input  'width':u
     1848               ,output v-resize-value-str
     1849               ) .
     1850             if v-resize-value-str <> '':U
     1851             then do:
     1852               run diasize_change-width in this-procedure
     1853                 (input  integer(v-resize-value-str)
     1854                 ,input  true
     1855                 ) .
     1856               assign
     1857                 v-restore-saved = true
     1858               .
     1859             end.
     1860           end.
     1861           if v-restore-saved <> true
     1862           then do:
     1863             if v-diasize-wndmax = true
     1864             then do:
     1865               run diasize_maximize in this-procedure
     1866                 (input  true
     1867                 ) .
     1868             end.
     1869           end.
     1870         end.
     1871         else do:
     1872           if v-diasize-wndmax = true
     1873           then do:
     1874             run diasize_maximize in this-procedure
     1875               (input  true
     1876               ) .
     1877           end.
     1878         end.
     1879       end.
     1880     end.
     1881   end procedure.
     1882   procedure diasize_need-full-display :
     1883     define output parameter p-need-full-display as logical   no-undo .
     1884     do
     1885     on error undo, return error return-value
     1886     :
     1887       assign
     1888         p-need-full-display = v-diasize-need-full-display
     1889       .
     1890       assign
     1891         v-diasize-need-full-display = false
     1892       .
     1893     end.
     1894   end procedure.
     1895   procedure get-context :
     1896      define output parameter p-db-num as integer          no-undo.
     1897      define output parameter p-user-id as character        no-undo.
     1898      define variable v-login               as character    no-undo.
     1899      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1900      define buffer buf_user-login  for ub.user-login .
     1901      do
     1902      on error undo, return error
     1903      :
     1904            FIND FIRST buf_sys-ctrl no-lock.
     1905            ASSIGN
     1906               v-login = USERID("ub")
     1907               p-db-num = buf_sys-ctrl.db-num
     1908            .
     1909            FIND FIRST buf_user-login
     1910                 WHERE buf_user-login.db-num = p-db-num
     1911                   AND buf_user-login.user-login = v-login
     1912                 no-lock
     1913                 no-error
     1914                 .
     1915            IF AVAILABLE buf_user-login
     1916            THEN DO:
     1917               assign
     1918                  p-user-id = buf_user-login.user-id
     1919               .
     1920            END.
     1921      end.
     1922   end procedure.
     1923       run diasize_init in this-procedure .
     1924   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1925   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1926   MAIN-BLOCK:
     1927   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1928      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1929   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1930     run mainmenu_getcntxt in parparentproc
     1931       (output v-cntxt-db-num
     1932       ,output v-cntxt-userid
     1933       ,output v-cntxt-level
     1934       ,output v-cntxt-host-code-obj
     1935       ,output v-cntxt-obj-type
     1936       ,output v-cntxt-obj-code
     1937       ,output v-cntxt-db-num-obj
     1938       ,output v-cntxt-is-admin
     1939       ) .
     1940     v-rid-list = p-rid-list.
     1941     run Myenable in this-procedure .
     1942     WAIT-FOR GO OF FRAME Dialog-Frame.
     1943   END.
     1944   RUN disable_UI.
     1945   PROCEDURE disable_UI :
     1946     HIDE FRAME Dialog-Frame.
     1947   END PROCEDURE.
     1948   PROCEDURE enable_UI :
     1949     DISPLAY EDITOR-2 EDITOR-1 mark-num
     1950         WITH FRAME Dialog-Frame.
     1951     ENABLE b-quit b-mark b-sel b-del b-text-2 b-text b-rule-script B-Help
     1952            br-rule-i-script EDITOR-2 EDITOR-1 mark-num
     1953         WITH FRAME Dialog-Frame.
     1954     VIEW FRAME Dialog-Frame.
     1955     OPEN QUERY br-rule-i-script FOR EACH X_rule-i-script,        FIRST X_rule.
     1956   END PROCEDURE.
     1957   PROCEDURE Myenable :
     1958   assign
     1959   X_rule.name:resizable in browse br-rule-i-script = yes
     1960   X_rule.name:visible in browse br-rule-i-script = (p-list-mode <> "rule")
     1961   X_rule-i-script.script-name:resizable in browse br-rule-i-script = yes
     1962   X_rule-i-script.i-script-name:resizable in browse br-rule-i-script = yes
     1963   X_rule-i-script.script-type:resizable in browse br-rule-i-script = yes
     1964   X_rule-i-script.i-script-type:resizable in browse br-rule-i-script = yes
     1965   b-rule-script:menu-mouse in frame Dialog-Frame = 1
     1966   .
     1967   ENABLE
     1968   b-quit
     1969   B-Help
     1970   b-mark when lookup("b-mark", bttns) > 0
     1971   b-sel when lookup("b-sel", bttns) > 0
     1972   b-del when lookup("b-del", bttns) > 0
     1973   b-text when lookup("b-del", bttns) > 0
     1974   b-text-2 when lookup("b-del", bttns) > 0
     1975   b-rule-script when lookup("b-del", bttns) > 0
     1976   editor-1
     1977   editor-2
     1978   br-rule-i-script
     1979   WITH FRAME Dialog-Frame.
     1980   VIEW FRAME Dialog-Frame.
     1981   run Openbr in this-procedure .
     1982   APPLY "VALUE-CHANGED" to br-rule-i-script.
     1983   END PROCEDURE.
     1984   PROCEDURE Openbr :
     1985   CASE p-list-mode:
     1986     WHEN 'все':U THEN DO:
     1987       frame Dialog-Frame :title = "Все привязки скриптов по всем правилам".
     1988       OPEN QUERY br-rule-i-script
     1989       FOR EACH X_rule-i-script NO-LOCK
     1990         , FIRST X_rule NO-LOCK  where
     1991                 X_rule.RULE_id = X_rule-i-script.root_rule_id
     1992       INDEXED-REPOSITION.
     1993     END.
     1994     WHEN "script-name" THEN DO:
     1995       frame Dialog-Frame :title = substitute("Привязка к правилам скрипта &1 &2", p-script-type, p-script-name).
     1996       OPEN QUERY br-rule-i-script
     1997       FOR EACH X_rule-i-script NO-LOCK WHERE
     1998                X_rule-i-script.i-script-type = p-script-type
     1999           and  X_rule-i-script.script-name = p-script-name
     2000           , FIRST X_rule NO-LOCK  where
     2001                   X_rule.RULE_id = X_rule-i-script.root_rule_id
     2002           INDEXED-REPOSITION.
     2003     END.
     2004     WHEN "rule" THEN DO:
     2005       frame Dialog-Frame :title = substitute("Привязка скриптов к правилу &1", p-rule-id).
     2006       OPEN QUERY br-rule-i-script
     2007       FOR EACH X_rule-i-script NO-LOCK WHERE
     2008               X_rule-i-script.root_rule_id = p-rule-id
     2009           , FIRST X_rule NO-LOCK  where
     2010                   X_rule.RULE_id = X_rule-i-script.root_rule_id
     2011           INDEXED-REPOSITION.
     2012    END.
     2013   END CASE.
     2014   END PROCEDURE.
     2015   PROCEDURE proc-b-rule-script :
     2016   DEFINE INPUT PARAMETER p-language AS CHARACTER NO-UNDO.
     2017   DEFINE VARIABLE v-longchar AS LONGCHAR NO-UNDO.
     2018   DEFINE VARIABLE v-ok AS LOGical NO-UNDO.
     2019   DEFINE BUFFER buf_rule-script FOR ub.rule-script.
     2020   FIND FIRST buf_rule-script WHERE
     2021             buf_rule-script.root_rule_id = X_rule-i-script.root_rule_id
     2022        AND  buf_rule-script.script_id = X_rule-i-script.script_id
     2023        AND  buf_rule-script.language = p-language.
     2024   v-longchar = buf_rule-script.script.
     2025        run gbl/d-longchar.w (
     2026                              INPUT ?
     2027                             ,INPUT '':U
     2028                             ,input-output v-longchar
     2029                             ,output v-ok
     2030                              ) NO-ERROR.
     2031      IF ERROR-STATUS:ERROR
     2032      OR NOT v-ok THEN undo, RETURN NO-apply.
     2033      ASSIGN
     2034      buf_rule-script.script = v-longchar.
     2035      .
     2036      v-longchar = '':U.
     2037   END PROCEDURE.
