      331       ( input this-procedure
      332       ) .
      333   end.
      334   define variable v-inform-launched as logical no-undo initial false .
      335   procedure proc-alt-shift-f4:
      336     define variable v-action as character no-undo .
      337     if v-inform-launched = false then do:
      338       assign
      339         v-inform-launched = true
      340       .
      341       run gbl/d-inform.w
      342         (  input self
      343         ,  input this-procedure
      344         , output v-action
      345         ) no-error .
      346       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      347       assign
      348         v-inform-launched = false
      349       .
      350     end.
      351   end.
      352   procedure proc-alt-f1:
      353     run gbl/corrhelp.p
      354       (input this-procedure
      355       ) .
      356   end .
      357   on alt-shift-f2 anywhere do:
      358     run proc-alt-shift-f2.
      359   end.
      360   on alt-shift-f3 anywhere do:
      361     run proc-alt-shift-f3 in this-procedure .
      362   end.
      363   on alt-shift-f4 anywhere do:
      364     run proc-alt-shift-f4 in this-procedure.
      365   end.
      366   on alt-f1 anywhere do:
      367     run proc-alt-f1 in this-procedure .
      368   end.
      369   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      370     define variable v-cntxt-db-num        as integer   no-undo .
      371     define variable v-cntxt-userid        as character no-undo .
      372     define variable v-cntxt-level         as character no-undo .
      373     define variable v-cntxt-host-code-obj as integer   no-undo .
      374     define variable v-cntxt-obj-type      as character no-undo .
      375     define variable v-cntxt-obj-code      as integer   no-undo .
      376     define variable v-cntxt-db-num-obj    as integer   no-undo .
      377     define variable v-cntxt-is-admin      as logical   no-undo .
      378   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      379   FUNCTION mark-string RETURNS CHARACTER
      380     ( input p-recid as recid, input mark-list as character  ) :
      381     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      382   END FUNCTION.
      383   DEFINE VARIABLE v-doc-rec AS RECID NO-UNDO.
