        1   block-level on error undo, throw.
        2   define input parameter p-rule-id as integer no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Сборка одного правила".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       68   define temp-table temp-string no-undo
       69   field v-string as character
       70   field string-num as integer
       71   index pi is unique primary string-num.
       72   procedure temp-string_clear :
       73     define buffer buf_temp-string for temp-string .
       74     do
       75     on error undo, return error return-value
       76     :
       77       for each buf_temp-string
       78       on error undo, return error
       79       :
       80         delete buf_temp-string.
       81       end.
       82     end.
       83   end procedure.
       84   procedure temp-string_write :
       85     define input  parameter p-v-string    as character no-undo .
       86     define variable v-string-num as integer no-undo .
       87     define buffer buf_temp-string for temp-string .
       88     do
       89     on error undo, return error return-value
       90     :
       91       find last buf_temp-string no-error .
       92       if not available buf_temp-string then do:
       93         create buf_temp-string .
       94         assign
       95         buf_temp-string.string-num     = 1
       96         buf_temp-string.v-string       = p-v-string
       97         .
       98       end.
       99       else do:
      100         v-string-num = buf_temp-string.string-num.
      101         create buf_temp-string .
      102         assign
      103         buf_temp-string.string-num = v-string-num + 1
      104         buf_temp-string.v-string = p-v-string
      105         .
      106       end.
      107     end.
      108   end procedure.
      109   procedure temp-string_read :
      110     define input  parameter p-string-num    as integer   no-undo .
      111     define output parameter p-v-string      as character no-undo .
      112     define buffer buf_temp-string for temp-string .
      113     do
      114     on error undo, return error return-value
      115     :
      116       find first buf_temp-string
      117         where buf_temp-string.string-num     = p-string-num
      118         no-error .
      119       if available buf_temp-string then do:
      120         assign
      121           p-v-string = buf_temp-string.v-string
      122         .
      123       end.
      124       else do:
      125         assign
      126           p-v-string = '':U
      127         .
      128       end.
      129     end.
      130   end procedure.
      131   procedure temp-string_append :
      132     define input  parameter p-string-num  as integer   no-undo .
      133     define input  parameter p-v-string    as character no-undo .
      134     define input  parameter p-append-char as character no-undo .
      135     define buffer buf_temp-string for temp-string .
      136     do
      137     on error undo, return error return-value
      138     :
      139       find first buf_temp-string
      140            where buf_temp-string.string-num = p-string-num
      141         no-error .
      142       if not available buf_temp-string then do:
      143         create buf_temp-string .
      144         assign
      145           buf_temp-string.string-num  = p-string-num
      146           buf_temp-string.v-string    = p-v-string
      147         .
      148       end.
      149       else do:
      150           assign
      151           buf_temp-string.v-string = buf_temp-string.v-string + p-append-char + p-v-string
      152           .
      153       end.
      154     end.
      155   end procedure.
      156   procedure temp-string_get-last-num:
      157   define output parameter p-string-num  as integer   no-undo .
      158   define buffer buf_temp-string for temp-string .
      159   find last buf_temp-string no-error.
      160   if available buf_temp-string then do:
      161     p-string-num = buf_temp-string.string-num.
      162   end.
      163   end procedure.
      164   procedure temp-string_delete-range:
      165   define input parameter p-first-string-num  as integer   no-undo .
      166   define input parameter p-last-string-num  as integer   no-undo .
      167   define buffer buf_temp-string for temp-string .
      168   for each buf_temp-string where
      169           buf_temp-string.string-num >= p-first-string-num
      170       and buf_temp-string.string-num <= p-last-string-num:
      171     delete buf_temp-string.
      172   end.
      173   end procedure.
      174   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      175   DEFINE TEMP-TABLE tt-rule NO-UNDO LIKE ub.rule
      176          field level as integer.
      177   DEFINE TEMP-TABLE tt-rule-script NO-UNDO LIKE ub.rule-script
      178          field level as integer
      179          field gen-order as character
      180          field upper_rule_id as integer
      181          field start-script_id as integer
      182          field end-script_id as integer
      183          field edge-type as character
      184          .
      185   define temp-table temp-rule-i-script no-undo
      186   like ub.rule-i-script.
      187   PROCEDURE fill-tables :
      188   DEFINE INPUT PARAMETER p-rule-id AS INTEGER NO-UNDO.
      189   DEFINE INPUT PARAMETER p-root-rule-id AS INTEGER NO-UNDO.
      190   DEFINE INPUT-OUTPUT PARAMETER p-level AS INTEGER NO-UNDO.
      191   DEFINE INPUT PARAMETER p-gen-order AS character NO-UNDO.
      192   DEFINE BUFFER buf_rule FOR ub.RULE.
      193   DEFINE BUFFER buf_rule-script FOR ub.RULE-script.
      194   DEFINE BUFFER buf_tt-rule FOR tt-RULE.
      195   DEFINE BUFFER buf_tt-rule-script FOR tt-RULE-script.
      196   if p-level = 0 then do:
      197     find first buf_rule where
      198               buf_rule.rule_id = p-root-rule-id.
      199     create buf_tt-rule.
      200     buffer-copy buf_rule to buf_tt-rule.
      201     release buf_tt-rule.
      202   end.
      203   p-level = p-level + 1.
      204   FOR EACH buf_rule NO-LOCK WHERE
      205           buf_rule.UPPER_rule_id = p-rule-id:
      206      find first buf_tt-rule where
      207               buf_tt-rule.rule_id = buf_rule.rule_id no-error.
      208      if not available buf_tt-rule then do:
      209       CREATE buf_tt-rule.
      210       buffer-copy buf_rule to buf_tt-rule.
      211       ASSIGN
      212       buf_tt-rule.root_rule_id = p-root-rule-id
      213       .
      214      end.
      215      buf_tt-rule.level = p-level.
      216      RUN fill-tables IN THIS-PROCEDURE (  INPUT buf_tt-rule.RULE_id
      217                                          ,INPUT p-root-rule-id
      218                                          ,INPUT-OUTPUT p-level
      219                                          ,INPUT (p-gen-order +
      220                                           STRING(p-level, "99") +
      221                                           STRING(buf_tt-rule.salience, "999"))).
      222   END.
      223   FOR EACH buf_rule-script NO-LOCK WHERE
      224           buf_rule-script.rule_id = p-rule-id:
      225      find first buf_tt-rule-script where
      226               buf_tt-rule-script.script_id = buf_rule-script.script_id
      227          AND  buf_tt-rule-script.LANGUAGE = buf_rule-script.LANGUAGE
      228          no-error.
      229      if not available buf_tt-rule-script
      230      then do:
      231       find first buf_tt-rule no-lock where
      232                 buf_tt-rule.rule_id = buf_rule-script.rule_id.
      233       CREATE buf_tt-rule-script.
      234       buffer-copy buf_rule-script to buf_tt-rule-script.
      235       ASSIGN
      236       buf_tt-rule-script.root_rule_id = p-root-rule-id
      237       buf_tt-rule-script.upper_rule_id = buf_tt-rule.upper_rule_id
      238       .
      239      end.
      240      assign
      241      buf_tt-rule-script.level = p-level
      242      buf_tt-rule-script.gen-order = p-gen-order +
      243                                     STRING(buf_tt-rule-script.level, "99") +
      244                                     STRING(buf_tt-rule-script.salience, "999").
      245      .
      246   END.
      247   p-level = p-level - 1.
      248   END PROCEDURE.
      249   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      250   define temp-table temp-edge no-undo
      251   field from-script_id as integer
      252   field to-script_id as integer
      253   field edge-type as character
      254   index pi is unique primary
      255   from-script_id
      256   to-script_id
      257   .
      258   function break-string-for-dot returns character (input p-string as character, input p-line-length AS INTEGER):
      259   define variable v-string as character no-undo .
      260   define variable v-output-string as character no-undo .
      261   define variable v-entry as character no-undo .
      262   define variable v-index as integer no-undo .
      263   v-string = p-string.
      264   v-output-string = p-string.
      265   do while length(v-string) > p-line-length :
      266     ASSIGN
      267     v-entry = substring(v-string, 1, p-line-length)
      268     v-index = r-index(v-entry, chr(32)).
      269     if v-index > 0
      270     and v-index <= p-line-length then do:
      271        assign
      272        v-output-string = v-output-string + substring(v-entry, 1, v-index - 1)  + '\N'.
      273        v-string = substring(v-string, v-index + 1)
      274        no-error.
      275        if error-status:error then leave.
      276     end.
      277     ELSE DO:
      278         assign
      279         v-output-string = v-output-string + v-entry.
      280         v-string = substring(v-string, 71)
      281         no-error.
      282     END.
      283   end.
      284   return v-output-string.
      285   end.
      286   PROCEDURE DISPLAY-RULE :
      287   define INPUT parameter p-rule-id AS integer no-undo.
      288   define input parameter p-upper-rule-id as integer no-undo .
      289   define input parameter p-language as character no-undo.
      290   define input-output parameter p-level as integer no-undo .
      291   define variable v-exist-condition-script as logical no-undo .
      292   define variable v-exist-rule-script as logical no-undo .
      293   define variable v-main-seq as character no-undo .
      294   define variable v-prev-node as character no-undo .
      295   define variable v-current-node as character no-undo .
      296   define variable v-next-node as character no-undo .
      297   define variable v-bottom-node as character no-undo .
      298   define variable v-top-node as character no-undo .
      299   define variable v-edge-label as logical no-undo .
      300   define variable v-language as character no-undo .
      301   define variable v-upper-rule-id as integer no-undo .
      302   define variable v-rule-id as integer no-undo .
      303   define variable v-salience as integer no-undo .
      304   define variable v-gen-order as character no-undo .
      305   define variable v-goto-text as character no-undo .
      306   define variable v-goto-rule as character no-undo .
      307   define buffer buf_rule for ub.rule.
      308   define buffer buf_upper-rule for ub.rule.
      309   define buffer buf_upper-rule-script for ub.rule-script.
      310   define buffer buf_down-rule for ub.rule.
      311   define buffer buf2_rule-script for ub.rule-script.
      312   define buffer buf3_rule-script for ub.rule-script.
      313   define buffer buf2_rule for ub.rule.
      314   define buffer buf_rule-script for ub.rule-script.
      315   define buffer buf_prop-script for ub.prop-script.
      316   define buffer buf_rule-i-script for ub.rule-i-script.
      317   define buffer buf_tt-rule-script for tt-rule-script.
      318   define buffer buf_temp-edge for temp-edge.
      319   define buffer buf_tt-rule for tt-rule.
      320   CASE p-language:
      321     WHEN "ABL" THEN DO:
      322       find first buf_rule no-lock where
      323                 buf_rule.rule_id = p-rule-id.
      324       if buf_rule.hidden-content > 0 then do:
      325         run temp-string_write in this-procedure ( input substitute("/* содержимое скрыто*/")).
      326         return.
      327       end.
      328       if p-upper-rule-id = 0 then do:
      329         run temp-string_write in this-procedure ( input substitute("/* &1", buf_Rule.name)).
      330         run temp-string_write in this-procedure ( input substitute("&1 */", buf_Rule.documentation)).
      331         run temp-string_write in this-procedure ( input '':U).
      332       end.
      333       else do:
      334         run temp-string_write in this-procedure ( input substitute("/* salience &1 in upper-rule-id &2*/"
      335                                                                   , buf_rule.salience
      336                                                                   , buf_rule.upper_rule_id
      337                                                                   )).
      338       end.
      339       run temp-string_write in this-procedure ( input  substitute("&1_&2:&3&1do:"
      340                                                                   ,fill( chr(32), p-level * 2)
      341                                                                   ,p-rule-id
      342                                                                   ,chr(10))).
      343       FOR EACH buf_rule-script NO-LOCK WHERE
      344         buf_rule-script.RULE_id = p-RULE-id
      345         AND buf_rule-script.LANGUAGE = p-language
      346       by buf_rule-script.salience :
      347         if buf_rule-script.script-type = 'COND':U then do:
      348           run temp-string_write in this-procedure (input  substitute("&1/* salience &2 rule_id &3*/"
      349                                                                      ,fill(chr(32), 70)
      350                                                                      ,buf_rule-script.salience
      351                                                                      ,buf_rule-script.rule_ID
      352                                                                      ) ).
      353           run temp-string_write in this-procedure (input  substitute("&1IF &2  THEN do:   "
      354                                                                       ,fill( chr(32), p-level * 2)
      355                                                                       ,replace(buf_rule-script.script, (chr(38) + chr(38)), chr(38))
      356                                                                       )).
      357           .
      358           assign
      359           v-exist-rule-script = yes
      360           .
      361         end.
      362         if buf_rule-script.script-type = 'CYCLE-COND':U then do:
      363           run temp-string_write in this-procedure (input  substitute("&1/* salience &2 rule_id &3*/"
      364                                                                      ,fill(chr(32), 70)
      365                                                                      ,buf_rule-script.salience
      366                                                                      ,buf_rule-script.rule_ID
      367                                                                      ) ).
      368           run temp-string_write in this-procedure (input  substitute("&1DO WHILE &2 :   "
      369                                                                       ,fill( chr(32), p-level * 2)
      370                                                                       ,replace(buf_rule-script.script, (chr(38) + chr(38)), chr(38))
      371                                                                       )).
      372           .
      373           assign
      374           v-exist-rule-script = yes
      375           .
      376         end.
      377         if buf_rule-script.script-type = 'CONS':U
      378         or buf_rule-script.script-type = 'GOTO':U
      379         then do:
      380           run temp-string_write in this-procedure ( input  substitute("&1/* Salience &2 rule_id &3*/"
      381                                                                        ,fill(chr(32), 70)
      382                                                                        ,buf_rule-script.salience
      383                                                                        ,buf_rule-script.rule_id
      384                                                                        )).
      385           find first buf_rule-i-script no-lock where
      386                     buf_rule-i-script.root_rule_id = buf_rule.root_rule_id
      387                and  buf_rule-i-script.script_id = buf_rule-script.script_id
      388                and  buf_rule-i-script.i-script-type = 'variable':U no-error.
      389           if available buf_rule-i-script then do:
      390             run temp-string_write in this-procedure ( input  substitute("/*&1&2 .*/"
      391                                                                         ,fill( chr(32), p-level * 2)
      392                                                                         ,replace(buf_rule-script.script, (chr(38) + chr(38)), chr(38))
      393                                                                         )).
      394           end.
      395           else do:
      396             run temp-string_write in this-procedure ( input  substitute("&1&2 ."
      397                                                                   ,fill( chr(32), p-level * 2)
      398                                                                   ,replace(buf_rule-script.script, (chr(38) + chr(38)), chr(38))
      399                                                                   )).
      400           end.
      401         end.
      402         if buf_rule-script.script-type = 'RULE':U
      403         or buf_rule-script.script-type = 'ELSE-RULE':U
      404         then do:
      405           find first buf_rule no-lock where
      406                   buf_rule.upper_rule_id = p-rule-id
      407               and buf_rule.salience = buf_rule-script.salience no-error .
      408           if not available buf_rule then do:
      409             message
      410             substitute("Не найдено правило &1 вышестояшего уровня к скрипту типа &2:&3№ скрипта &4, порядок &5"
      411                        , p-rule-id
      412                        , buf_rule-script.script-type
      413                        , chr(10)
      414                        , buf_rule-script.script_id
      415                        , buf_rule-script.salience )
      416             view-as alert-box error .
      417             return.
      418           end.
      419           if buf_rule-script.script-type = 'ELSE-RULE':U then do:
      420             run temp-string_write in this-procedure ( input substitute("&1else do: /*rule &2*/"
      421                                                                         ,fill( chr(32), p-level * 2)
      422                                                                         ,buf_rule.rule_id)).
      423             assign
      424             v-exist-rule-script = yes
      425             .
      426           end.
      427           p-level = p-level + 1.
      428           run display-rule ( input buf_rule.rule_id, input buf_rule.upper_rule_id, input p-language, input-output p-level).
      429           p-level = p-level - 1.
      430           if v-exist-rule-script then do:
      431             run temp-string_write in this-procedure ( input substitute("&1end. /*of rule &2*/"
      432                                                                         ,fill( chr(32), p-level * 2)
      433                                                                         ,buf_rule.rule_id)).
      434             v-exist-rule-script = no.
      435           end.
      436         end.
      437       END.
      438       if v-exist-rule-script then do:
      439         run temp-string_write in this-procedure ( input substitute("&1end.&2end. /*of rule &3*/"
      440                                                                     ,fill( chr(32), p-level * 2)
      441                                                                     ,chr(10)
      442                                                                     ,p-rule-id)).
      443       end.
      444       else do:
      445         run temp-string_write in this-procedure ( input substitute("&1&2end. /*of rule &3*/"
      446                                                                     ,chr(10)
      447                                                                     ,fill( chr(32), p-level * 2)
      448                                                                     ,p-rule-id)).
      449       end.
      450     END.
      451     WHEN "rus"
      452     or
      453     when "rus-ext"
      454     THEN DO:
      455       find first buf_rule no-lock where
      456                 buf_rule.rule_id = p-rule-id.
      457       if p-upper-rule-id = 0 then do:
      458         run temp-string_write in this-procedure ( input buf_rule.name ).
      459         run temp-string_write in this-procedure ( input buf_rule.documentation ).
      460         run temp-string_write in this-procedure ( input '':U).
      461         if buf_rule.hidden-content > 0 then do:
      462           run temp-string_write in this-procedure ( input "НЕЛЬЗЯ ПРОСМОТРЕТЬ СОДЕРЖИМОЕ ПРАВИЛА").
      463           return.
      464         end.
      465       end.
      466       else do:
      467         if p-language = "rus-ext" then do:
      468           run temp-string_write in this-procedure ( input substitute("&1/* порядок &2 правила &3 */"
      469                                                                     ,fill(chr(32), 70)
      470                                                                     ,buf_rule.salience
      471                                                                     ,buf_rule.upper_rule_id
      472                                                                     )).
      473         end.
      474       end.
      475       run temp-string_write in this-procedure ( input substitute("_Правило &1:",  p-RULE-id)).
      476       FOR EACH buf_rule-script NO-LOCK WHERE
      477               buf_rule-script.RULE_id = p-rULE-id
      478           AND buf_rule-script.LANGUAGE = "rus":
      479        if buf_rule-script.script-type = 'COND':U then do:
      480           if p-language = "rus-ext" then do:
      481             run temp-string_write in this-procedure ( input  substitute("&1/* порядок &2 правила &3*/"
      482                                                                         ,fill(chr(32), 70)
      483                                                                         ,buf_rule-script.salience
      484                                                                         ,buf_rule-script.rule_id
      485                                                                         )).
      486           end.
      487           run temp-string_write in this-procedure ( input  substitute("&1Если &2 тогда: "
      488                                                                         ,fill( chr(32), p-level * 2)
      489                                                                         ,buf_rule-script.script )).
      490           assign
      491           v-exist-rule-script = yes
      492           .
      493         end.
      494        if buf_rule-script.script-type = 'CYCLE-COND':U then do:
      495           if p-language = "rus-ext" then do:
      496             run temp-string_write in this-procedure ( input  substitute("&1/* порядок &2 правила &3*/"
      497                                                                         ,fill(chr(32), 70)
      498                                                                         ,buf_rule-script.salience
      499                                                                         ,buf_rule-script.rule_id
      500                                                                         )).
      501           end.
      502           run temp-string_write in this-procedure ( input  substitute("&1ПОКА &2: "
      503                                                                         ,fill( chr(32), p-level * 2)
      504                                                                         ,buf_rule-script.script )).
      505           assign
      506           v-exist-rule-script = yes
      507           .
      508         end.
      509         if buf_rule-script.script-type = 'RULE':U
      510         or buf_rule-script.script-type = 'ELSE-RULE':U
      511         then do:
      512           find first buf_rule no-lock where
      513                   buf_rule.upper_rule_id = p-rule-id
      514               and buf_rule.salience = buf_rule-script.salience no-error .
      515           if not available buf_rule then do:
      516             message
      517             substitute("Не найдено правило &1 вышестояшего уровня к скрипту типа &2:&3№ скрипта &4, порядок &5"
      518                        , p-rule-id
      519                        , buf_rule-script.script-type
      520                        , chr(10)
      521                        , buf_rule-script.script_id
      522                        , buf_rule-script.salience )
      523             view-as alert-box error .
      524             return.
      525           end.
      526           if buf_rule-script.script-type = 'ELSE-RULE':U then do:
      527             run temp-string_write in this-procedure ( input substitute("&1ИНАЧЕ: /*правило &2*/"
      528                                                                         ,fill( chr(32), p-level * 2)
      529                                                                         ,buf_rule.rule_id)).
      530             assign
      531             v-exist-rule-script = yes
      532             .
      533           end.
      534           p-level = p-level + 1.
      535           run display-rule ( input buf_rule.rule_id, input buf_rule.upper_rule_id, input p-language, input-output p-level).
      536           p-level = p-level - 1.
      537         end.
      538         if buf_rule-script.script-type = 'CONS':U
      539         or buf_rule-script.script-type = 'GOTO':U
      540         then do:
      541           if p-language = "rus-ext" then do:
      542             run temp-string_write in this-procedure ( input substitute("&1/* порядок &2 правила &3*/"
      543                                                                         ,fill(chr(32), 70)
      544                                                                         ,buf_rule-script.salience
      545                                                                         ,buf_rule-script.rule_id
      546                                                                         )).
      547           end.
      548           run temp-string_write in this-procedure ( input substitute("&1&2 ;"
      549                                                                       ,fill( chr(32), p-level * 2)
      550                                                                       ,buf_rule-script.script )).
      551         end.
      552       END.
      553       if v-exist-rule-script then do:
      554         run temp-string_write in this-procedure ( input substitute("&1. /* конец правила &2 */"
      555                                                                       ,fill( chr(32), p-level * 2)
      556                                                                       ,p-rule-id) ).
      557       end.
      558       else do:
      559         run temp-string_write in this-procedure ( input substitute("&1. /* конец правила &2 */"
      560                                                                       ,fill( chr(32), p-level * 2)
      561                                                                       ,p-rule-id) ).
      562       end.
      563     END.
      564     when "DOT2-rus":U
      565     or
      566     when "DOT2-ABL":U then do:
      567       v-language = entry(2, p-language, "-").
      568       find first buf_rule no-lock where
      569                 buf_rule.rule_id = p-rule-id.
      570       if p-upper-rule-id = 0 then do:
      571         run temp-string_write in this-procedure ( input  substitute('Rule&1_&2_&3 [shape=ellipse , fillcolor=pink, style="rounded,filled",  label="Правило&4\n&1_&2_&3"];'
      572                                                                   , buf_rule.rule_id
      573                                                                   , buf_rule.upper_rule_id
      574                                                                   , buf_rule.salience
      575                                                                   , (if buf_rule.hidden-content > 0 then " (содержимое скрыто) " else "")
      576                                                                   )
      577                                                                   ).
      578         if buf_rule.hidden-content > 0 then do:
      579           return.
      580         end.
      581       end.
      582       else do:
      583       end.
      584       FOR EACH buf_rule-script NO-LOCK WHERE
      585               buf_rule-script.RULE_id = p-rULE-id
      586           AND buf_rule-script.LANGUAGE = v-language:
      587         if buf_rule-script.script-type = 'COND':U then do:
      588           run temp-string_write in this-procedure ( input   substitute('Condition&1_&2 [shape=diamond, fillcolor=yellow, style="rounded,filled", label="&3?"];'
      589                                                                       , buf_rule-script.rule_id
      590                                                                       , buf_rule-script.salience
      591                                                                       , replace(replace(replace(buf_rule-script.script, chr(34), "&#34;":U), "~~n", "\n"), chr(10), "\n")
      592                                                                       )).
      593         end.
      594         if buf_rule-script.script-type = 'CYCLE-COND':U then do:
      595           run temp-string_write in this-procedure ( input   substitute('Cyclecondition&1_&2 [shape=trapezium, fillcolor=yellowgreen, style="rounded,filled", label="&3?"];'
      596                                                                       , buf_rule-script.rule_id
      597                                                                       , buf_rule-script.salience
      598                                                                       , replace(replace(replace(buf_rule-script.script, chr(34), "&#34;":U), "~~n", "\n"), chr(10), "\n")
      599                                                                       )).
      600         end.
      601         if buf_rule-script.script-type = 'CONS':U then do:
      602           run temp-string_write in this-procedure ( input   substitute('Consequence&1_&2 [shape=box, fillcolor=lightgrey, style="rounded,filled", label="&3"];'
      603                                                                       , buf_rule-script.rule_id
      604                                                                       , buf_rule-script.salience
      605                                                                       , replace(replace(replace(buf_rule-script.script, chr(34), "&#34;":U), "~~n", "\n"), chr(10), "\n")
      606                                                                       )).
      607         end.
      608         if buf_rule-script.script-type = 'GOTO':U then do:
      609           run temp-string_write in this-procedure ( input   substitute('Goto&1_&2 [shape=invtriangle, fillcolor=pink, style="rounded,filled", label="&3"];'
      610                                                                       , buf_rule-script.rule_id
      611                                                                       , buf_rule-script.salience
      612                                                                       , replace(replace(replace(buf_rule-script.script, chr(34), "&#34;":U), "~~n", "\n"), chr(10), "\n")
      613                                                                       )).
      614         end.
      615         if buf_rule-script.script-type = 'RULE':U
      616         or buf_rule-script.script-type = 'ELSE-RULE':U
      617         then do:
      618           find first buf_down-rule no-lock where
      619                     buf_down-rule.upper_rule_id = p-rule-id
      620                 and buf_down-rule.salience = buf_rule-script.salience.
      621           p-level = p-level + 1.
      622           run display-rule ( input buf_down-rule.rule_id
      623                            , input buf_down-rule.upper_rule_id
      624                            , input p-language
      625                            , input-output p-level).
      626           p-level = p-level - 1.
      627         end.
      628       end.
      629       if p-upper-rule-id = 0 then do:
      630         run temp-string_write in this-procedure ( input substitute('End_Rule&1 [shape=ellipse , fillcolor=pink, style="rounded,filled", label="Конец\nправила &1"];'
      631                                                                     , p-rule-id)).
      632       end.
      633       if p-upper-rule-id = 0 then do:
      634         run temp-string_write in this-procedure ( input substitute("~}")).
      635       end.
      636      end.
      637       when "DOT1-rus"
      638       or
      639       when "DOT1-ABL"
      640       then do:
      641           DEFINE VARIABLE v-level AS INTEGER NO-UNDO.
      642           define variable v-start-script-id as integer no-undo .
      643           define variable v-end-script-id as integer no-undo .
      644           define variable v-script-type as character no-undo .
      645           define buffer buf2_tt-rule for tt-rule.
      646           v-language = entry(2, p-language, "-").
      647           find first buf_rule no-lock where
      648                     buf_rule.rule_id = p-rule-id.
      649           if p-upper-rule-id = 0 then do:
      650             RUN fill-tables IN THIS-PROCEDURE (  INPUT buf_rule.RULE_id
      651                                             ,INPUT buf_rule.root_RULE_id
      652                                             ,INPUT-OUTPUT v-level
      653                                             ,INPUT "") no-error.
      654             run temp-string_write in this-procedure ( input substitute("digraph rule&1 ~{", p-rule-id)).
      655             run temp-string_write in this-procedure ( input substitute('node [fontsize=12];')).
      656             run temp-string_write in this-procedure ( input substitute('nodesep=0.30;')).
      657             run temp-string_write in this-procedure ( input substitute('ranksep=0.30;')).
      658             if buf_rule.hidden-content > 0 then do:
      659               return.
      660             end.
      661             _tt-rule:
      662             for each buf_tt-rule no-lock where
      663                     buf_tt-rule.root_rule_id = buf_rule.root_rule_id:
      664               if buf_tt-rule.rule_id = buf_tt-rule.root_rule_id then do:
      665                 find first buf_tt-rule-script where
      666                           buf_tt-rule.rule_id = buf_tt-rule.rule_id.
      667                 assign
      668                 v-start-script-id = buf_tt-rule-script.script_id
      669                 v-end-script-id = -1
      670                 .
      671               end.
      672               else do:
      673                 find first buf_tt-rule-script no-lock where
      674                         buf_tt-rule-script.rule_id = buf_tt-rule.upper_rule_id
      675                     and buf_tt-rule-script.salience = buf_tt-rule.salience.
      676                 assign
      677                 v-salience = buf_tt-rule-script.salience
      678                 v-script-type = buf_tt-rule-script.script-type
      679                 .
      680                 find last buf_tt-rule-script no-lock where
      681                         buf_tt-rule-script.rule_id = buf_tt-rule.upper_rule_id
      682                     and buf_tt-rule-script.salience < buf_tt-rule.salience
      683                     and buf_tt-rule-script.script-type <> 'RULE':U
      684                     and buf_tt-rule-script.script-type <> 'ELSE-RULE':U
      685                     .
      686                 assign
      687                 v-start-script-id = buf_tt-rule-script.script_id.
      688                 find first buf2_tt-rule where
      689                           buf2_tt-rule.rule_id = buf_tt-rule.rule_id.
      690                 assign
      691                 v-salience = buf_tt-rule.salience
      692                 v-rule-id = buf_tt-rule.upper_rule_id
      693                 .
      694                 _TTT:
      695                 do while true:
      696                   find first buf_tt-rule-script no-lock where
      697                           buf_tt-rule-script.rule_id = v-rule-id
      698                       and buf_tt-rule-script.salience > v-salience
      699                       and buf_tt-rule-script.script-type <>  'RULE':U
      700                       and buf_tt-rule-script.script-type <>  'ELSE-RULE':U
      701                       no-error
      702                       .
      703                   if not available buf_tt-rule-script then do:
      704                     if buf2_tt-rule.upper_rule_id = 0 then do:
      705                       v-end-script-id = -1.
      706                       leave _ttt.
      707                     end.
      708                     else do:
      709                       find first buf2_tt-rule where
      710                                 buf2_tt-rule.rule_id = v-rule-id.
      711                       assign
      712                       v-salience = buf2_tt-rule.salience
      713                       v-rule-id = buf2_tt-rule.upper_rule_id
      714                       .
      715                     end.
      716                   end.
      717                   else do:
      718                     assign
      719                     v-end-script-id = buf_tt-rule-script.script_id.
      720                     leave _ttt.
      721                   end.
      722                 end.
      723                 for each buf_tt-rule-script where
      724                         buf_tt-rule-script.rule_id = buf_tt-rule.rule_id:
      725                   assign
      726                   buf_tt-rule-script.start-script_id = v-start-script-id
      727                   buf_tt-rule-script.end-script_id = v-end-script-id
      728                   buf_tt-rule-script.edge-type = (if v-script-type = 'RULE':U
      729                                                   then "yes"
      730                                                   else "no")
      731                   .
      732                 end.
      733               end.
      734             end.
      735           end.
      736           if p-upper-rule-id = 0 then do:
      737             assign
      738             v-prev-node =  substitute("Rule&1_&2_&3"
      739                                     , buf_rule.rule_id
      740                                     , buf_rule.upper_rule_id
      741                                     , buf_rule.salience
      742                                     ).
      743             for each buf_tt-rule-script by
      744                   buf_tt-rule-script.gen-order:
      745               create buf_temp-edge.
      746               assign
      747               buf_temp-edge.from-script_id = 0
      748               buf_temp-edge.to-script_id = buf_tt-rule-script.script_id
      749               buf_temp-edge.edge-type = "":U
      750               .
      751               release buf_temp-edge.
      752               leave.
      753             end.
      754           end.
      755           FOR EACH buf_rule-script NO-LOCK WHERE
      756                   buf_rule-script.RULE_id = p-rULE-id
      757               AND buf_rule-script.LANGUAGE = v-language:
      758             if buf_rule-script.script-type = 'RULE':U
      759             or buf_rule-script.script-type = 'ELSE-RULE':U
      760             then do:
      761               find first buf_down-rule no-lock where
      762                         buf_down-rule.upper_rule_id = p-rule-id
      763                     and buf_down-rule.salience = buf_rule-script.salience no-error .
      764               if error-status :error then do:
      765               end.
      766               p-level = p-level + 1.
      767               run display-rule ( input buf_down-rule.rule_id, input buf_down-rule.upper_rule_id, input p-language, input-output p-level).
      768               p-level = p-level - 1.
      769             end.
      770             run create-temp-edge in this-procedure ( buffer buf_rule-script
      771                                                     ,input v-language
      772                                                     ,output v-current-node
      773                                                     ).
      774             _temp-edge:
      775             for each buf_temp-edge where
      776                     buf_temp-edge.from-script_id = buf_rule-script.script_id:
      777               if buf_temp-edge.to-script_id = -1 then do:
      778                 assign
      779                 v-next-node =  substitute("End_Rule&1"
      780                                   , buf_rule-script.root_rule_id
      781                                   ).
      782               end.
      783               else do:
      784                 find first buf_tt-rule-script where buf_tt-rule-script.script_id = buf_temp-edge.to-script_id no-error .
      785                 if not available buf_tt-rule-script then do:
      786                   next _temp-edge.
      787                 end.
      788                 case buf_tt-rule-script.script-type:
      789                   when 'CONS':U then do:
      790                     assign
      791                     v-next-node  = substitute("Consequence&1_&2"
      792                                         , buf_tt-rule-script.rule_id
      793                                         , buf_tt-rule-script.salience).
      794                   end.
      795                   when 'GOTO':U then do:
      796                     assign
      797                     v-next-node  = substitute("Goto&1_&2"
      798                                         , buf_tt-rule-script.rule_id
      799                                         , buf_tt-rule-script.salience).
      800                   end.
      801                   when 'COND':U then do:
      802                     assign
      803                     v-next-node  = substitute("Condition&1_&2"
      804                                         , buf_tt-rule-script.rule_id
      805                                         , buf_tt-rule-script.salience).
      806                   end.
      807                   when 'CYCLE-COND':U then do:
      808                     assign
      809                     v-next-node  = substitute("Cyclecondition&1_&2"
      810                                         , buf_tt-rule-script.rule_id
      811                                         , buf_tt-rule-script.salience).
      812                   end.
      813                   when 'ELSE-RULE':U then do:
      814                     next _temp-edge.
      815                   end.
      816                 end case.
      817               end.
      818               if can-find(first temp-edge where
      819                               temp-edge.from-script_id = 0
      820                           and temp-edge.to-script_id = buf_rule-script.script_id) then do:
      821                 run temp-string_write in this-procedure ( input substitute("&1 -> &2"
      822                                                                             ,v-prev-node
      823                                                                             ,v-current-node
      824                                                                             )).
      825               end.
      826               run temp-string_write in this-procedure ( input substitute("&1 -> &2&3"
      827                                                                           ,v-current-node
      828                                                                           ,v-next-node
      829                                                       ,(if buf_temp-edge.edge-type = ""
      830                                                         then "":U
      831                                                         else substitute('[taillabel="&1"]'
      832                                                                         , buf_temp-edge.edge-type)
      833                                                         )
      834                                                                           )).
      835             end.
      836           end.
      837         end.
      838   END CASE.
      839   END procedure.
      840   procedure create-temp-edge :
      841   define parameter buffer buf_rule-script for ub.rule-script.
      842   define input parameter p-language as character no-undo .
      843   define output parameter p-current-node as character no-undo .
      844   define variable v-salience as integer no-undo .
      845   define variable v-rule-id as integer no-undo .
      846   define variable v-gen-order as character no-undo .
      847   define variable v-goto-text as character no-undo .
      848   define variable v-goto-rule as character no-undo .
      849   define variable v-ii as integer no-undo .
      850   define variable v-script-id as integer no-undo .
      851   define variable v-script-type as character no-undo .
      852   define variable v-int as integer no-undo .
      853   define buffer buf_tt-rule-script for tt-rule-script.
      854   define buffer buf_tt-rule for tt-rule.
      855   define buffer buf_temp-edge for temp-edge.
      856   define buffer buf2_rule for ub.rule.
      857   do
      858   on error undo, return error
      859   :
      860     case buf_rule-script.script-type:
      861       when 'COND':U then do:
      862         assign
      863         p-current-node  = substitute("Condition&1_&2"
      864                           , buf_rule-script.rule_id
      865                           , buf_rule-script.salience).
      866        for each buf_tt-rule-script where
      867                 buf_tt-rule-script.start-script_id = buf_rule-script.script_id
      868             and buf_tt-rule-script.edge-type = "yes"
      869         by buf_tt-rule-script.gen-order:
      870           create buf_temp-edge.
      871           assign
      872           buf_temp-edge.from-script_id = buf_rule-script.script_id
      873           buf_temp-edge.to-script_id = buf_tt-rule-script.script_id
      874           buf_temp-edge.edge-type = buf_tt-rule-script.edge-type
      875           .
      876           leave.
      877        end.
      878        for each buf_tt-rule-script where
      879                 buf_tt-rule-script.start-script_id = buf_rule-script.script_id
      880             and buf_tt-rule-script.edge-type = "no"
      881         by buf_tt-rule-script.gen-order:
      882           create buf_temp-edge.
      883           assign
      884           buf_temp-edge.from-script_id = buf_rule-script.script_id
      885           buf_temp-edge.to-script_id = buf_tt-rule-script.script_id
      886           buf_temp-edge.edge-type = buf_tt-rule-script.edge-type
      887           .
      888           leave.
      889        end.
      890        if not available buf_tt-rule-script then do:
      891         assign
      892         v-rule-id = buf_rule-script.rule_id
      893         v-salience = buf_rule-script.salience
      894         .
      895         find first buf_tt-rule-script where
      896                   buf_tt-rule-script.rule_id = v-rule-id
      897               and buf_tt-rule-script.salience > v-salience
      898               and buf_tt-rule-script.script-type <> 'RULE':U
      899               and buf_tt-rule-script.script-type <> 'ELSE-RULE':U
      900               no-error.
      901         if not available buf_tt-rule-script then do:
      902           if buf_rule-script.rule_id = buf_rule-script.root_rule_id then do:
      903             create buf_temp-edge.
      904             assign
      905             buf_temp-edge.from-script_id = buf_rule-script.script_id
      906             buf_temp-edge.to-script_id = -1
      907             buf_temp-edge.edge-type = "no"
      908             .
      909           end.
      910           else do:
      911             find first buf_tt-rule-script where
      912                       buf_tt-rule-script.script_id = buf_rule-script.script_id.
      913             create buf_temp-edge.
      914             assign
      915             buf_temp-edge.from-script_id = buf_rule-script.script_id
      916             buf_temp-edge.to-script_id = buf_tt-rule-script.end-script_id
      917             buf_temp-edge.edge-type = "no"
      918             .
      919           end.
      920         end.
      921         else do:
      922           create buf_temp-edge.
      923           assign
      924           buf_temp-edge.from-script_id = buf_rule-script.script_id
      925           buf_temp-edge.to-script_id = buf_tt-rule-script.script_id
      926           buf_temp-edge.edge-type = "no"
      927           .
      928         end.
      929        end.
      930       end.
      931       when 'CYCLE-COND':U then do:
      932         assign
      933         p-current-node  = substitute("Cyclecondition&1_&2"
      934                           , buf_rule-script.rule_id
      935                           , buf_rule-script.salience).
      936        for each buf_tt-rule-script where
      937                 buf_tt-rule-script.start-script_id = buf_rule-script.script_id
      938             and buf_tt-rule-script.edge-type = "yes"
      939         by buf_tt-rule-script.gen-order:
      940           v-ii = v-ii + 1.
      941           if v-ii = 1 then do:
      942             create buf_temp-edge.
      943             assign
      944             buf_temp-edge.from-script_id = buf_rule-script.script_id
      945             buf_temp-edge.to-script_id = buf_tt-rule-script.script_id
      946             buf_temp-edge.edge-type = buf_tt-rule-script.edge-type
      947             .
      948           end.
      949           assign
      950           v-script-id = buf_tt-rule-script.script_id
      951           v-script-type = buf_tt-rule-script.script-type
      952           v-rule-id = buf_tt-rule-script.rule_id
      953           v-salience = buf_tt-rule-script.salience
      954           .
      955         end.
      956         _cont:
      957         do while true:
      958           if v-script-type <> 'RULE':U
      959           and v-script-type <> 'ELSE-RULE':U then do:
      960             create buf_temp-edge.
      961             assign
      962             buf_temp-edge.to-script_id = buf_rule-script.script_id
      963             buf_temp-edge.from-script_id = v-script-id
      964             buf_temp-edge.edge-type = "continue"
      965             .
      966             leave _cont.
      967           end.
      968           find first buf_tt-rule where
      969                     buf_tt-rule.upper_rule_id = v-rule-id
      970                 and buf_tt-rule.salience = v-salience.
      971           for each buf_tt-rule-script where
      972                   buf_tt-rule-script.rule_id = buf_tt-rule.rule_id
      973           by buf_tt-rule-script.gen-order:
      974             assign
      975             v-script-id = buf_tt-rule-script.script_id
      976             v-script-type = buf_tt-rule-script.script-type
      977             v-rule-id = buf_tt-rule-script.rule_id
      978             v-salience = buf_tt-rule-script.salience
      979             .
      980           end.
      981         end.
      982       end.
      983       when 'CONS':U
      984       then do:
      985         assign
      986         p-current-node  = substitute("Consequence&1_&2"
      987                             , buf_rule-script.rule_id
      988                             , buf_rule-script.salience).
      989         assign
      990         v-rule-id = buf_rule-script.rule_id
      991         v-salience = buf_rule-script.salience
      992         .
      993         find first buf_tt-rule-script where
      994                   buf_tt-rule-script.rule_id = v-rule-id
      995               and buf_tt-rule-script.salience > v-salience no-error.
      996         if not available buf_tt-rule-script then do:
      997           if buf_rule-script.rule_id = buf_rule-script.root_rule_id then do:
      998             create buf_temp-edge.
      999             assign
     1000             buf_temp-edge.from-script_id = buf_rule-script.script_id
     1001             buf_temp-edge.to-script_id = -1
     1002             buf_temp-edge.edge-type = ""
     1003             .
     1004           end.
     1005           else do:
     1006             find first buf_tt-rule-script where
     1007                       buf_tt-rule-script.script_id = buf_rule-script.script_id.
     1008             create buf_temp-edge.
     1009             assign
     1010             buf_temp-edge.from-script_id = buf_rule-script.script_id
     1011             buf_temp-edge.to-script_id = buf_tt-rule-script.end-script_id
     1012             buf_temp-edge.edge-type = ""
     1013             .
     1014           end.
     1015         end.
     1016         else do:
     1017           create buf_temp-edge.
     1018           assign
     1019           buf_temp-edge.from-script_id = buf_rule-script.script_id
     1020           buf_temp-edge.to-script_id = buf_tt-rule-script.script_id
     1021           buf_temp-edge.edge-type = ""
     1022           .
     1023         end.
     1024       end.
     1025       when 'GOTO':U then do:
     1026         assign
     1027         p-current-node  = substitute("Goto&1_&2"
     1028                             , buf_rule-script.rule_id
     1029                             , buf_rule-script.salience).
     1030         find first buf_tt-rule-script where
     1031                 buf_tt-rule-script.rule_id = buf_rule-script.rule_id
     1032             and buf_tt-rule-script.language = "ABL"
     1033             and buf_tt-rule-script.salience = buf_rule-script.salience.
     1034         v-goto-text = trim(buf_tt-rule-script.script, chr(32)).
     1035         if v-goto-text begins "leave":U then do:
     1036           v-goto-rule = trim(trim(replace(v-goto-text, "leave":U, "":U), chr(32)), "_":U).
     1037           if v-goto-rule = string(buf_rule-script.root_rule_id) then do:
     1038             create buf_temp-edge.
     1039             assign
     1040             buf_temp-edge.from-script_id = buf_rule-script.script_id
     1041             buf_temp-edge.to-script_id =  -1
     1042             buf_temp-edge.edge-type = ""
     1043             .
     1044           end.
     1045           else do:
     1046             assign
     1047             v-int = integer(v-goto-rule) no-error.
     1048             if not error-status:error then do:
     1049               find first buf_tt-rule-script where
     1050                           buf_tt-rule-script.upper_rule_id = v-int .
     1051               create buf_temp-edge.
     1052               assign
     1053               buf_temp-edge.from-script_id = buf_rule-script.script_id
     1054               buf_temp-edge.to-script_id = buf_tt-rule-script.end-script_id
     1055               buf_temp-edge.edge-type = "leave"
     1056               .
     1057             end.
     1058           end.
     1059         end.
     1060         if v-goto-text begins "next":U then do:
     1061           v-goto-rule = trim(replace(v-goto-text, "next":U, "":U), chr(32)).
     1062           if v-goto-rule = substitute("_&1", buf_rule-script.root_rule_id) then do:
     1063             find first buf_tt-rule-script where
     1064                       buf_tt-rule-script.rule_id = buf_rule-script.root_rule_id.
     1065             create buf_temp-edge.
     1066             assign
     1067             buf_temp-edge.from-script_id = buf_rule-script.script_id
     1068             buf_temp-edge.to-script_id = buf_tt-rule-script.script_id
     1069             buf_temp-edge.edge-type = ""
     1070             .
     1071           end.
     1072           else do:
     1073             assign
     1074             v-int = integer(trim(v-goto-rule, "_")) no-error.
     1075             if not error-status:error then do:
     1076               find first buf_tt-rule-script where
     1077                           buf_tt-rule-script.upper_rule_id = v-int .
     1078               create buf_temp-edge.
     1079               assign
     1080               buf_temp-edge.from-script_id = buf_rule-script.script_id
     1081               buf_temp-edge.to-script_id = buf_tt-rule-script.end-script_id
     1082               buf_temp-edge.edge-type = "next"
     1083               .
     1084             end.
     1085             else do:
     1086               create buf_temp-edge.
     1087               assign
     1088               buf_temp-edge.from-script_id = buf_rule-script.script_id
     1089               buf_temp-edge.to-script_id = -1
     1090               buf_temp-edge.edge-type = "next"
     1091               .
     1092             end.
     1093           end.
     1094         end.
     1095       end.
     1096     end case.
     1097   end.
     1098   end procedure.
     1099   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1100   procedure display-prop-script :
     1101   define parameter buffer buf_prop-script for ub.prop-script.
     1102     do
     1103     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1104     :
     1105       if buf_prop-script.script-type = 'ifunction':U then do:
     1106         run temp-string_write in this-procedure ( input buf_prop-script.script-body ).
     1107       end.
     1108       else do:
     1109         if lookup(buf_prop-script.proc-type, 'class,data-member,property,method,constructor,destructor':u) > 0 then do:
     1110         end.
     1111         else do:
     1112           run temp-string_write in this-procedure ( input buf_prop-script.script-head ).
     1113           run temp-string_write in this-procedure ( input buf_prop-script.script-body ).
     1114           run temp-string_write in this-procedure ( input buf_prop-script.script-foot ).
     1115         end.
     1116       end.
     1117     end.
     1118   end procedure.
     1119   def var vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1120   procedure gen-key-rec :
     1121     define input  parameter p-tbl-name    as character no-undo.
     1122     define input  parameter p-bh_tbl-name as handle    no-undo.
     1123     define output parameter p-key-rec     as character no-undo.
     1124     do
     1125     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1126     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     1127     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     1128     :
     1129       define variable fh               as handle    no-undo .
     1130       define variable v-ok             as logical   no-undo .
     1131       define variable v-inform         as character no-undo .
     1132       define variable v-ind            as integer   no-undo .
     1133       define variable v-idx-field-qnty as integer   no-undo .
     1134       if p-tbl-name = ?
     1135         or p-tbl-name = "":U
     1136       then do:
     1137         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info4 ).
     1138       end.
     1139       if not p-bh_tbl-name:available then do:
     1140         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info4, p-tbl-name ).
     1141       end.
     1142       assign
     1143         p-key-rec = p-tbl-name
     1144         v-inform  = p-bh_tbl-name:index-information(1)
     1145         v-ind     = 2
     1146       .
     1147       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1148       on error undo, return error
     1149       :
     1150         assign
     1151           v-inform = p-bh_tbl-name:index-information( v-ind )
     1152           v-ind    = v-ind + 1
     1153         .
     1154       end.
     1155       if v-inform = ?
     1156         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1157         or entry( 3, v-inform, ",":U ) <> "1":U
     1158       then do:
     1159         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, p-tbl-name ).
     1160       end.
     1161       else do:
     1162         assign
     1163           v-idx-field-qnty = num-entries( v-inform ) - 4
     1164         .
     1165         if v-idx-field-qnty < 2 then do:
     1166           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, p-tbl-name ).
     1167         end.
     1168         do v-ind = 1 to v-idx-field-qnty by 2
     1169         on error undo, return error
     1170         :
     1171           assign
     1172             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     1173             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     1174           .
     1175         end.
     1176       end.
     1177       if p-key-rec = ? then do:
     1178         assign
     1179           p-key-rec = "":U
     1180         .
     1181         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info4, p-tbl-name ).
     1182       end.
     1183     end.
     1184     return.
     1185   end procedure.
     1186   procedure gen-where-keyr-tab :
     1187     define input  parameter i-tableSerach as character no-undo.
     1188     define input  parameter i-tablekey   as character  no-undo.
     1189     define input  parameter p-key-rec    as character  no-undo.
     1190     define input  parameter p-key-handle as handle     no-undo .
     1191     define input  parameter p-db-name    as character  no-undo .
     1192     define input  parameter p-tt-handle  as handle     no-undo .
     1193     define output parameter o-Where      as character  no-undo.
     1194     do
     1195     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1196     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1197     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     1198     :
     1199       define variable v-full-tbl-name  as character no-undo .
     1200       define variable bh_tbl-name      as handle    no-undo .
     1201       define variable fh_key           as handle    no-undo .
     1202       define variable fh_search        as handle    no-undo .
     1203       define variable v-field-num      as integer   no-undo .
     1204       define variable v-count-fld      as integer   no-undo .
     1205       define variable v-inform         as character no-undo .
     1206       define variable v-ind            as integer   no-undo .
     1207       define variable v-idx-field-qnty as integer   no-undo .
     1208       define variable v-field-name     as character no-undo .
     1209       define variable v-field-val      as character no-undo .
     1210       define variable v-word-link      as character no-undo .
     1211       define variable vTable           as character no-undo.
     1212       define variable bh_tbl-key       as handle    no-undo .
     1213       assign
     1214         p-key-rec = trim( p-key-rec )
     1215       .
     1216       if p-key-handle <> ? then do:
     1217         if not valid-handle(p-key-handle)
     1218            or p-key-handle:type <> "buffer"
     1219         then do:
     1220           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info4 ).
     1221         end.
     1222         if num-entries( p-key-rec, chr(3) ) > 1
     1223           or p-key-rec = ?
     1224           or p-key-rec = "":U
     1225         then do:
     1226           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info4, p-key-rec ).
     1227         end.
     1228       end.
     1229       else do:
     1230         if p-key-rec = ?
     1231           or p-key-rec = "":U
     1232         then do:
     1233           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info4 ).
     1234         end.
     1235       end.
     1236       assign
     1237         vTable = entry( 1 , p-key-rec, chr(3) )
     1238       .
     1239       if p-tt-handle <> ?
     1240         and ( not valid-handle(p-tt-handle)
     1241               or p-tt-handle:type <> "buffer"
     1242             )
     1243       then do:
     1244         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info4, vTable, chr(10) ).
     1245       end.
     1246       if p-tt-handle = ? then do:
     1247         assign
     1248           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     1249         .
     1250         create buffer bh_tbl-name for table v-full-tbl-name .
     1251       end.
     1252       else do:
     1253         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1254       end.
     1255       assign
     1256         v-inform = bh_tbl-name:index-information(1)
     1257         v-ind    = 2
     1258       .
     1259       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1260       on error undo, return error
     1261       :
     1262         assign
     1263           v-inform = bh_tbl-name:index-information( v-ind )
     1264           v-ind    = v-ind + 1
     1265         .
     1266       end.
     1267       if v-inform = ?
     1268         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1269         or entry( 3, v-inform, ",":U ) <> "1":U
     1270       then do:
     1271         delete object bh_tbl-name no-error.
     1272         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info4, vTable ).
     1273       end.
     1274       assign
     1275         v-idx-field-qnty = num-entries( v-inform ) - 4
     1276       .
     1277       if v-idx-field-qnty < 2 then do:
     1278         delete object bh_tbl-name no-error.
     1279         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, vTable ).
     1280       end.
     1281       assign
     1282         o-where     = "where":U
     1283         v-word-link = "":U
     1284         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     1285         v-count-fld = 0
     1286       .
     1287       if i-tablekey ne "" and i-tablekey ne ?
     1288       then do:
     1289         assign
     1290           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     1291         .
     1292         create buffer bh_tbl-key for table v-full-tbl-name .
     1293       end.
     1294       if i-tableSerach ne "" and i-tableSerach ne ?
     1295       then do:
     1296         delete object bh_tbl-name no-error.
     1297         assign
     1298           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     1299         .
     1300         create buffer bh_tbl-name for table v-full-tbl-name .
     1301       end.
     1302       block_where:
     1303       do v-ind = 1 to v-idx-field-qnty by 2
     1304       on error undo, return error
     1305       :
     1306         assign
     1307           v-count-fld = v-count-fld + 1
     1308         .
     1309         if p-key-handle = ?
     1310           and v-count-fld > v-field-num
     1311         then do:
     1312           leave block_where.
     1313         end.
     1314         define variable VfieldKeyTable as handle no-undo.
     1315         assign
     1316           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1317           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     1318         .
     1319         if     bh_tbl-key ne ?
     1320         then do:
     1321            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     1322            if VfieldKeyTable eq ?
     1323            then next block_where.
     1324         end.
     1325         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     1326         then
     1327            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     1328         else
     1329            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     1330         if p-key-handle = ? then do:
     1331           assign
     1332             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     1333           .
     1334         end.
     1335         else do:
     1336           assign
     1337             fh_key = p-key-handle:buffer-field( v-field-name )
     1338           .
     1339           if fh_key = ?
     1340             or not valid-handle( fh_key )
     1341           then do:
     1342             delete object bh_tbl-name.
     1343             if     bh_tbl-key ne ?
     1344             then
     1345                delete object bh_tbl-key.
     1346             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info4, p-key-handle:name, v-field-name ).
     1347           end.
     1348           assign
     1349             v-field-val = fh_key:buffer-value
     1350           .
     1351         end.
     1352         if fh_search:data-type ="character":U then do:
     1353           assign
     1354             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1355             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1356             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1357             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1358             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1359             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1360             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1361             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1362             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1363             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1364             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1365             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1366             v-field-val = substitute( '"&1"', v-field-val )
     1367           .
     1368         end.
     1369         assign
     1370           o-where = substitute( "&1 &2", o-where, v-field-val )
     1371         .
     1372         if v-word-link = "":U then do:
     1373           assign
     1374             v-word-link = "and":U
     1375           .
     1376         end.
     1377       end.
     1378       delete object bh_tbl-name.
     1379       if     bh_tbl-key ne ?
     1380       then
     1381          delete object bh_tbl-key.
     1382       if p-key-handle = ?
     1383         and v-count-fld <> v-field-num
     1384       then do:
     1385         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info4, vTable ).
     1386       end.
     1387     end.
     1388   end procedure.
     1389   procedure gen-hn-keyr-tab :
     1390     define input  parameter i-tableSerach as character no-undo.
     1391     define input  parameter i-tablekey   as character no-undo.
     1392     define input  parameter p-key-rec    as character no-undo.
     1393     define input  parameter p-key-handle as handle    no-undo .
     1394     define input  parameter p-db-name    as character no-undo .
     1395     define input  parameter p-tt-handle  as handle    no-undo .
     1396     define input  parameter p-stts-lock  as integer   no-undo .
     1397     define output parameter o-hn         as handle    no-undo.
     1398     define variable v-full-tbl-name as character no-undo.
     1399     define variable v-where         as character no-undo.
     1400     define variable bh_tbl-name     as handle    no-undo.
     1401     define variable vTable          as character no-undo.
     1402     do
     1403     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1404     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1405     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1406         run gen-where-keyr-tab(i-tableSerach,
     1407                                i-tablekey,
     1408                                p-key-rec,
     1409                                p-key-handle,
     1410                                p-db-name,
     1411                                p-tt-handle,
     1412                                output v-where).
     1413         if i-tableSerach ne "" and i-tableSerach ne ?
     1414         then do:
     1415            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1416            create buffer bh_tbl-name for table v-full-tbl-name .
     1417         end.
     1418         else do:
     1419            if p-tt-handle = ? then do:
     1420               assign
     1421                  vTable = entry( 1 , p-key-rec, chr(3) )
     1422               .
     1423               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1424               create buffer bh_tbl-name for table v-full-tbl-name .
     1425            end.
     1426            else do:
     1427               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1428            end.
     1429         end.
     1430         if p-tt-handle = ? then do:
     1431            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1432         end.
     1433         else do:
     1434            bh_tbl-name:find-first( v-where ) no-error .
     1435         end.
     1436         o-hn = bh_tbl-name.
     1437      end.
     1438   end procedure.
     1439   procedure gen-hn-keyr :
     1440     define input  parameter p-key-rec    as character no-undo.
     1441     define input  parameter p-key-handle as handle    no-undo .
     1442     define input  parameter p-db-name    as character no-undo .
     1443     define input  parameter p-tt-handle  as handle    no-undo .
     1444     define input  parameter p-stts-lock  as integer   no-undo .
     1445     define output parameter o-hn         as handle    no-undo.
     1446     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1447   end.
     1448   procedure gen-row-keyr :
     1449     define input  parameter p-key-rec    as character no-undo.
     1450     define input  parameter p-key-handle as handle    no-undo .
     1451     define input  parameter p-db-name    as character no-undo .
     1452     define input  parameter p-tt-handle  as handle    no-undo .
     1453     define input  parameter p-stts-lock  as integer   no-undo .
     1454     define output parameter p-tbl-row    as rowid     no-undo.
     1455     define output parameter p-tbl-name   as character no-undo.
     1456     define variable vHn as handle no-undo.
     1457       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1458       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1459       p-tbl-name =  vHn:table.
     1460       delete object vHn no-error.
     1461     if p-tbl-row = ? then do:
     1462       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info4, p-tbl-name, p-key-rec ).
     1463     end.
     1464     else do:
     1465       return.
     1466     end.
     1467   end procedure.
     1468   procedure gen-key-fv :
     1469     define input  parameter p-key-rec    as character no-undo .
     1470     define output parameter p-field-list as character no-undo .
     1471     define output parameter p-value-list as character no-undo.
     1472     do
     1473     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1474     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1475     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1476     :
     1477       define variable v-full-tbl-name  as character no-undo .
     1478       define variable bh_tbl-name      as handle    no-undo .
     1479       define variable v-tbl-name       as character no-undo .
     1480       define variable v-field-num      as integer   no-undo .
     1481       define variable v-count-fld      as integer   no-undo .
     1482       define variable v-inform         as character no-undo .
     1483       define variable v-ind            as integer   no-undo .
     1484       define variable v-idx-field-qnty as integer   no-undo .
     1485       define variable v-delim-key      as character no-undo .
     1486       if p-key-rec = ?
     1487         or p-key-rec = "":U
     1488       then do:
     1489         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info4 ).
     1490       end.
     1491       assign
     1492         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1493         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1494       .
     1495       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1496       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info4 ).
     1497       assign
     1498         v-inform = bh_tbl-name:index-information(1)
     1499         v-ind    = 2
     1500       .
     1501       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1502       on error undo, return error
     1503       :
     1504         assign
     1505           v-inform = bh_tbl-name:index-information( v-ind )
     1506           v-ind    = v-ind + 1
     1507         .
     1508       end.
     1509       if v-inform = ?
     1510         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1511         or entry( 3, v-inform, ",":U ) <> "1":U
     1512       then do:
     1513         delete object bh_tbl-name no-error.
     1514         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, v-tbl-name ).
     1515       end.
     1516       assign
     1517         v-idx-field-qnty = num-entries( v-inform ) - 4
     1518       .
     1519       if v-idx-field-qnty < 2 then do:
     1520         delete object bh_tbl-name no-error.
     1521         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, v-tbl-name ).
     1522       end.
     1523       assign
     1524         p-field-list = "":U
     1525         p-value-list = "":U
     1526         v-delim-key  = "":U
     1527         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1528         v-count-fld  = 0
     1529       .
     1530       block_where:
     1531       do v-ind = 1 to v-idx-field-qnty by 2
     1532       on error undo, return error
     1533       :
     1534         assign
     1535           v-count-fld = v-count-fld + 1
     1536         .
     1537         if v-count-fld > v-field-num then do:
     1538           leave block_where.
     1539         end.
     1540         assign
     1541           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1542           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1543         .
     1544         if v-ind = 1 then do:
     1545           assign
     1546             v-delim-key = chr(3)
     1547           .
     1548         end.
     1549       end.
     1550       delete object bh_tbl-name.
     1551       if v-count-fld <> v-field-num then do:
     1552         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info4, v-tbl-name ).
     1553       end.
     1554     end.
     1555   end procedure.
     1556   procedure gen-key-field :
     1557     define input  parameter p-table      as character no-undo .
     1558     define output parameter p-field-list as character no-undo .
     1559     do
     1560     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1561     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1562     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1563     :
     1564       define variable v-full-tbl-name  as character no-undo .
     1565       define variable bh_tbl-name      as handle    no-undo .
     1566       define variable v-tbl-name       as character no-undo .
     1567       define variable v-field-num      as integer   no-undo .
     1568       define variable v-count-fld      as integer   no-undo .
     1569       define variable v-inform         as character no-undo .
     1570       define variable v-ind            as integer   no-undo .
     1571       define variable v-idx-field-qnty as integer   no-undo .
     1572       define variable v-delim-key      as character no-undo .
     1573       if p-table = ?
     1574         or p-table = "":U
     1575       then do:
     1576         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info4 ).
     1577       end.
     1578       assign
     1579         v-tbl-name      = p-table
     1580         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1581       .
     1582       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1583       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info4 ).
     1584       assign
     1585         v-inform = bh_tbl-name:index-information(1)
     1586         v-ind    = 2
     1587       .
     1588       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1589       on error undo, return error
     1590       :
     1591         assign
     1592           v-inform = bh_tbl-name:index-information( v-ind )
     1593           v-ind    = v-ind + 1
     1594         .
     1595       end.
     1596       if v-inform = ?
     1597         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1598         or entry( 3, v-inform, ",":U ) <> "1":U
     1599       then do:
     1600         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, v-tbl-name ).
     1601       end.
     1602       assign
     1603         v-idx-field-qnty = num-entries( v-inform ) - 4
     1604       .
     1605       if v-idx-field-qnty < 2 then do:
     1606         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, v-tbl-name ).
     1607       end.
     1608       assign
     1609         p-field-list = "":U
     1610         v-delim-key  = "":U
     1611         v-count-fld  = 0
     1612       .
     1613       block_where:
     1614       do v-ind = 1 to v-idx-field-qnty by 2
     1615       on error undo, return error
     1616       :
     1617         assign
     1618           v-count-fld = v-count-fld + 1
     1619         .
     1620         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1621         if v-ind = 1 then do:
     1622           assign
     1623             v-delim-key = chr(3)
     1624           .
     1625         end.
     1626       end.
     1627       delete object bh_tbl-name.
     1628     end.
     1629   end procedure.
     1630   define variable v-tbl-row as rowid no-undo .
     1631   define variable v-tbl-name as character no-undo .
     1632   define variable v-level as integer no-undo .
     1633   define variable ss as character no-undo .
     1634   define variable v-path                    as character                no-undo .
     1635   DEFINE VARIABLE v-full-path               as character                no-undo .
     1636   DEFINE VARIABLE v-file-name               as character                no-undo .
     1637   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
     1638   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
     1639   define variable v-ii as integer no-undo .
     1640   define variable v-script-type-list as character no-undo .
     1641   define variable v-include-flag            as logical no-undo .
     1642   define variable v-key-ruleset             as character no-undo .
     1643   define variable v-key-ruleset-2           as character no-undo .
     1644   define variable v-count-retry-action as logical no-undo .
     1645   define variable v-found as logical no-undo .
     1646   define stream Outstream.
     1647   define stream instream.
     1648   define stream errstream .
     1649   define buffer buf_rule-i-script for ub.rule-i-script.
     1650   define buffer buf_prop-script for ub.prop-script.
     1651   define buffer buf_prop-ruleset for ub.prop-ruleset.
     1652   define buffer buf_temp-string for temp-string.
     1653   define buffer buf_rule-by-set  for ub.rule-by-set.
     1654   define buffer buf_rule for ub.rule.
     1655   main-block:
     1656   do
     1657   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1658   :
     1659     find first buf_rule no-lock where buf_rule.rule_id = p-rule-id no-error.
     1660     if not available buf_rule then do:
     1661       undo main-block, return error substitute("Не найдено правило &1", p-rule-id).
     1662     end.
     1663     if buf_rule.upper_rule_id <> 0 then do:
     1664       undo main-block, return error substitute("Правило &1 не является корневым", p-rule-id).
     1665     end.
     1666     run temp-string_clear in this-procedure .
     1667     for each buf_rule-by-set no-lock where
     1668             buf_rule-by-set.rule_id = buf_rule.rule_id :
     1669       run gbl/filename.p (
     1670                       input substitute( "rul/&1&2.i", string(buf_rule.codex_id, "9999"), string(buf_rule-by-set.ruleset_id, "9999"))
     1671                     ,output v-full-path
     1672                     ,output v-path
     1673                     ,output v-file-name
     1674                     ,output v-file-name-no-ext
     1675                     ,output v-file-name-ext
     1676                     ) no-error .
     1677       if error-status:error then do:
     1678         next.
     1679       end.
     1680       else do:
     1681         v-found = yes.
     1682         leave .
     1683       end.
     1684     end.
     1685     if v-found then do:
     1686     end.
     1687     else do:
     1688       run gbl/filename.p (
     1689                       input substitute( "rul/&10000.i", string(buf_rule.codex_id, "9999"))
     1690                     ,output v-full-path
     1691                     ,output v-path
     1692                     ,output v-file-name
     1693                     ,output v-file-name-no-ext
     1694                     ,output v-file-name-ext
     1695                     ) no-error .
     1696       if error-status:error then do:
     1697         undo main-block, return error return-value.
     1698       end.
     1699     end.
     1700     RUN fill-tables IN THIS-PROCEDURE (  INPUT buf_rule.RULE_id
     1701                                     ,INPUT buf_rule.root_RULE_id
     1702                                     ,INPUT-OUTPUT v-level
     1703                                     ,INPUT "") no-error.
     1704     input stream instream from value (v-full-path).
     1705     v-include-flag = yes.
     1706     _repeat:
     1707     repeat :
     1708       import stream instream unformatted ss.
     1709       if index(ss, "&start-codex_id") > 0 then do:
     1710         assign
     1711         v-key-ruleset = entry(2, ss, "&").
     1712         for each buf_rule-by-set no-lock where
     1713                 buf_rule-by-set.rule_id = buf_rule.root_rule_id:
     1714           assign
     1715           v-key-ruleset-2 = substitute("start-codex_id=&1;ruleset_id=&2"
     1716                                         , buf_rule-by-set.codex_id
     1717                                         , buf_rule-by-set.ruleset_id).
     1718           if v-key-ruleset-2 = v-key-ruleset then do:
     1719              v-include-flag = no.
     1720           end.
     1721         end.
     1722       end.
     1723       if index(ss, "&end-codex_id") > 0 then do:
     1724         v-include-flag = yes.
     1725       end.
     1726       if v-include-flag = no then next _repeat.
     1727       run temp-string_write in this-procedure ( input  ss).
     1728       if index(ss, "&start-using-class&") > 0 then do:
     1729         run using-class in this-procedure (  buffer buf_rule ).
     1730       end.
     1731       if index(ss, "&start-rule-call-param&") > 0 then do:
     1732         run rule-call-param in this-procedure (  buffer buf_rule ).
     1733       end.
     1734       if index(ss, "&start-def-vars&") > 0 then do:
     1735         run process-def-vars in this-procedure (  input buf_rule.rule_id ) no-error.
     1736         if error-status:error then do:
     1737            undo, return error .
     1738         end.
     1739       end.
     1740       if index(ss, "&count-retry-action-start&") > 0 then do:
     1741         v-count-retry-action = yes.
     1742       end.
     1743       if index(ss, "&count-retry-action-end&") > 0 then do:
     1744         v-count-retry-action = no.
     1745       end.
     1746       if index(ss, "&start-release-obj&") > 0 then do:
     1747         run process-release-obj in this-procedure (  input buf_rule.rule_id ) no-error.
     1748         if error-status:error then do:
     1749            undo, return error .
     1750         end.
     1751       end.
     1752       if index(ss, "&start-process-rule-call-param&") > 0 then do:
     1753         run process-rule-call-param in this-procedure ( buffer buf_rule ).
     1754       end.
     1755       if index(ss, "&start-i-script&") > 0 then do:
     1756         run hist-news-class in this-procedure (  buffer buf_rule ).
     1757         v-script-type-list = 'define_b':U + chr(44) +
     1758                               'define_tt':U + chr(44) +
     1759                               'define_h':U + chr(44) +
     1760                               'variable':U
     1761                               .
     1762         do v-ii = 1 to num-entries(v-script-type-list):
     1763           run cycle-script-type in this-procedure ( input p-rule-id, input entry(v-ii, v-script-type-list)) no-error .
     1764           if error-status:error then do:
     1765             undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     1766           end.
     1767         end.
     1768         _rule-i-script:
     1769         for each buf_rule-i-script no-lock where
     1770                 buf_rule-i-script.root_rule_id = p-rule-id,
     1771             each  buf_prop-script no-lock where
     1772                       buf_prop-script.dtm-code = buf_rule-i-script.dtm-code
     1773                   and  buf_prop-script.language = "ABL"
     1774                   and  buf_prop-script.script-name = buf_rule-i-script.script-name
     1775                   and  buf_prop-script.revis_id = buf_rule-i-script.revis_id
     1776         break
     1777         by buf_rule-i-script.i-script-name
     1778         on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1779         :
     1780           if first-of(buf_rule-i-script.i-script-name) then do:
     1781             if not (buf_prop-script.language = "ABL") then next _rule-i-script.
     1782             if lookup(buf_rule-i-script.i-script-type, v-script-type-list) > 0 then next _rule-i-script.
     1783             if lookup(buf_prop-script.script-type, "hist-nws") > 0 then next _rule-i-script.
     1784             run display-prop-script in this-procedure ( buffer buf_prop-script).
     1785           end.
     1786         end.
     1787         _rule-i-script:
     1788         for each buf_rule-i-script no-lock where
     1789                 buf_rule-i-script.root_rule_id = p-rule-id
     1790             and buf_rule-i-script.script-type = '':U
     1791         break
     1792         by buf_rule-i-script.i-script-name
     1793         on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1794         :
     1795           if first-of(buf_rule-i-script.i-script-name) then do:
     1796             if not (buf_prop-script.language = "ABL") then next _rule-i-script.
     1797             if lookup(buf_rule-i-script.i-script-type, v-script-type-list) > 0 then next _rule-i-script.
     1798             if lookup(buf_prop-script.script-type, "hist-nws") > 0 then next _rule-i-script.
     1799             run display-subsid-rule-i-script in this-procedure ( buffer buf_rule-i-script).
     1800           end.
     1801         end.
     1802       end.
     1803       if index(ss, "&start-hn-option&") > 0 then do:
     1804         run cycle-script-type in this-procedure ( input p-rule-id, "hist-nws") no-error .
     1805         if error-status:error then do:
     1806           undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     1807         end.
     1808       end.
     1809       if index(ss, "&start-rule&") > 0 then do:
     1810         run display-rule in this-procedure ( input p-rule-id
     1811                                           , input 0
     1812                                           , input "ABL":U
     1813                                           , input-output v-level).
     1814       end.
     1815     end.
     1816     input stream instream close.
     1817     output stream outstream to value( substitute( "rul/&1.p" ,string(p-rule-id, "999999999"))).
     1818     for each buf_temp-string
     1819     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1820     :
     1821       put stream outstream unformatted buf_temp-string.v-string chr(10).
     1822     end.
     1823     output stream outstream close.
     1824     define variable v-old-sys-alert-box as logical no-undo .
     1825     define variable v-err-num as integer no-undo .
     1826     define variable v-err-size as integer no-undo .
     1827     define variable v-tmp-str as character no-undo .
     1828     define variable v-err-cmp as character no-undo .
     1829     v-old-sys-alert-box    = session :system-alert-boxes.
     1830     session :system-alert-boxes = false.
     1831     output to value( "cmp-err.txt":U) .
     1832     COMPILE value( substitute( "rul/&1.p" ,string(p-rule-id, "999999999"))).
     1833     assign
     1834       v-err-num  = error-status :GET-NUMBER(1)
     1835       v-err-size = seek(output)
     1836     .
     1837     output close .
     1838     assign
     1839       session :system-alert-boxes = v-old-sys-alert-box
     1840     .
     1841     if error-status :error
     1842       or compiler :error
     1843     then do:
     1844       input stream errstream from value( "cmp-err.txt":U).
     1845       repeat :
     1846         import stream errstream unformatted v-tmp-str .
     1847         assign
     1848           v-err-cmp = v-err-cmp + chr(10) + v-tmp-str
     1849         .
     1850       end.
     1851       input stream errstream close.
     1852         message
     1853           vss-workfile vss-revision vss-description skip
     1854           substitute( "Ошибка компиляции файла &1 строка &2", COMPILER:FILENAME, COMPILER:ERROR-ROW ) skip
     1855           v-err-cmp skip
     1856           error-status :get-message(1) skip
     1857           view-as alert-box error .
     1858         return error.
     1859      end.
     1860   end.
     1861   procedure cycle-script-type:
     1862   define input parameter p-rule-id as integer no-undo .
     1863   define input parameter p-i-script-type as character no-undo .
     1864   define buffer buf_rule-i-script for ub.rule-i-script.
     1865   define buffer buf_dis-porp-script for ub.prop-script.
     1866     main-block:
     1867     do
     1868     on error undo, return error
     1869     :
     1870       _rule-i-script:
     1871       for each buf_rule-i-script no-lock where
     1872               buf_rule-i-script.root_rule_id = p-rule-id
     1873           and buf_rule-i-script.i-script-type = p-i-script-type
     1874               ,
     1875           each  buf_prop-script no-lock where
     1876                     buf_prop-script.dtm-code = buf_rule-i-script.dtm-code
     1877                 and  buf_prop-script.script-name = buf_rule-i-script.script-name
     1878                 and  buf_prop-script.script-type = buf_rule-i-script.script-type
     1879                 and  buf_prop-script.revis_id = buf_rule-i-script.revis_id
     1880       on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1881       :
     1882         if not (buf_prop-script.language = "ABL") then next _rule-i-script.
     1883         if buf_rule-i-script.i-script-type = 'variable':U then do:
     1884           run temp-string_write in this-procedure ( input substitute("define variable &1 as &2 no-undo."
     1885                                                                      ,buf_rule-i-script.i-script-name
     1886                                                                      ,buf_prop-script.script-value-type)
     1887                                                   ).
     1888         end.
     1889         else do:
     1890           run display-prop-script in this-procedure ( buffer buf_prop-script).
     1891         end.
     1892       end.
     1893     end.
     1894   end procedure.
     1895   procedure rule-call-param :
     1896   define parameter buffer buf_rule for ub.rule.
     1897   define variable v-uniq-key-rec as character no-undo .
     1898   define buffer buf_ruledict-param  for ub.ruledict-param.
     1899   define buffer buf_ruledict for ub.ruledict.
     1900   define variable v-string as character no-undo .
     1901   _main:
     1902   do
     1903   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1904   :
     1905     run gen-key-rec in this-procedure (
     1906                                        input  'rule':U
     1907                                       ,input buffer buf_rule:handle
     1908                                       ,output v-uniq-key-rec ).
     1909     find first buf_ruledict no-lock where
     1910              buf_ruledict.entry-type = 'rule':U
     1911          AND buf_ruledict.uniq-key-rec = v-uniq-key-rec
     1912          AND buf_ruledict.language = "ABL"       .
     1913     for each buf_ruledict-param no-lock where
     1914             buf_ruledict-param.entry-id = buf_ruledict.entry-id
     1915         and buf_ruledict-param.language = "ABL":U
     1916     by buf_ruledict-param.param-num
     1917     on error undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)):
     1918       CASE buf_ruledict-param.param-mode:
     1919         when 'input':U then do:
     1920           assign
     1921           v-string = substitute(" define variable &1 as &2 no-undo."
     1922                                   ,buf_ruledict-param.param-name
     1923                                   ,buf_ruledict-param.param-data-type
     1924                                   ).
     1925         end.
     1926         when 'output':U then do:
     1927         end.
     1928         when 'input-output':U then do:
     1929         end.
     1930         when 'buffer':U then do:
     1931         end.
     1932         when 'input table':U then do:
     1933         end.
     1934         when 'output table':U then do:
     1935         end.
     1936         when 'input-output table':U then do:
     1937         end.
     1938       end case.
     1939       run temp-string_write in this-procedure ( input v-string ).
     1940     end.
     1941   end.
     1942   end procedure.
     1943   procedure using-class :
     1944   define parameter buffer buf_rule for ub.rule.
     1945   main-block:
     1946   do
     1947   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1948   :
     1949   define buffer buf_temp-rule-i-script for temp-rule-i-script.
     1950   define buffer buf_rule-i-script for ub.rule-i-script.
     1951   define buffer buf_prop-script for ub.prop-script.
     1952   define buffer buf0_prop-script for ub.prop-script.
     1953     _rule-i-script:
     1954     for each buf_rule-i-script no-lock where
     1955               buf_rule-i-script.root_rule_id = p-rule-id
     1956     break
     1957     by buf_rule-i-script.script-name
     1958     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1959     :
     1960       if first-of(buf_rule-i-script.script-name) then do:
     1961         if buf_rule-i-script.script-type = '':U then next _rule-i-script.
     1962         if buf_rule-i-script.i-script-type = 'variable':U then do:
     1963           if lookup(buf_rule-i-script.script-type, 'character,date,datetime,datetime-tz,decimal,integer,void,logical,memptr,raw,recid,rowid,widget-handle,handle,blob,clob,class,com-handle,longchar,int64':U) > 0 then next.
     1964           find last  buf_prop-script no-lock where
     1965                      buf_prop-script.dtm-code = buf_rule-i-script.dtm-code
     1966                 and  buf_prop-script.script-name = buf_rule-i-script.script-type
     1967                 and  buf_prop-script.language = "ABL"  no-error.
     1968           if not available buf_prop-script then do:
     1969             message
     1970             substitute( "Секция &&start-using-class&&&2" +
     1971                         "Не найден класс &1&2" +
     1972                         "Переменная &3&2" +
     1973                         "Код объекта-операнда &4&2" +
     1974                         "Код класса &5&2"
     1975                        , buf_rule-i-script.script-type
     1976                        , chr(10)
     1977                        , buf_rule-i-script.script-name
     1978                        , buf_rule-i-script.dtm-code
     1979                        , buf_rule-i-script.class-dtm-code
     1980                        )
     1981             view-as alert-box .
     1982             return error.
     1983           end.
     1984         end.
     1985         else do:
     1986           find first buf0_prop-script no-lock where
     1987                     buf0_prop-script.dtm-code = buf_rule-i-script.dtm-code
     1988                 and buf0_prop-script.script-name = buf_rule-i-script.script-name
     1989                 and buf0_prop-script.language = "ABL" no-error .
     1990           if not available buf0_prop-script then do:
     1991             message
     1992             substitute("Секция &&start-using-class&&&1" +
     1993                        "Не найдено определение скрипта &1" +
     1994                         "Тип Скрипта &2&1" +
     1995                         "Скрипт &3&1" +
     1996                         "Ссылка на определение &4&1" +
     1997                         "Код объекта-операнда &5&1" +
     1998                         "Код класса &6&1"
     1999                       , chr(10)
     2000                        , buf_rule-i-script.script-type
     2001                        , buf_rule-i-script.i-script-name
     2002                        , buf_rule-i-script.script-name
     2003                        , buf_rule-i-script.dtm-code
     2004                        , buf_rule-i-script.class-dtm-code
     2005                        )
     2006             view-as alert-box .
     2007             return error.
     2008           END.
     2009           if lookup(buf0_prop-script.proc-type, 'class,data-member,property,method,constructor,destructor':u) = 0  then next _rule-i-script.
     2010           find last  buf_prop-script no-lock where
     2011                     buf_prop-script.dtm-code = buf_rule-i-script.class-dtm-code
     2012                 and buf_prop-script.script-name = buf_rule-i-script.script-type
     2013                 and  buf_prop-script.proc-type = 'class':U
     2014                 and  buf_prop-script.language = "ABL"  no-error.
     2015           if not available buf_prop-script then do:
     2016             message
     2017             substitute("Секция &&start-using-class&&&1" +
     2018                         "Не найден класс &2&1" +
     2019                         "Тип Скрипта &2&1" +
     2020                         "Скрипт &3&1" +
     2021                         "Ссылка на определение &4&1" +
     2022                         "Код объекта-операнда &5&1" +
     2023                         "Код класса &6"
     2024                        , chr(10)
     2025                        , buf_rule-i-script.script-type
     2026                        , buf_rule-i-script.i-script-name
     2027                        , buf_rule-i-script.script-name
     2028                        , buf_rule-i-script.dtm-code
     2029                        , buf_rule-i-script.class-dtm-code
     2030                        )
     2031             view-as alert-box .
     2032             return error.
     2033           end.
     2034         end.
     2035         find first buf_temp-rule-i-script no-lock where
     2036                   buf_temp-rule-i-script.root_rule_id = p-rule-id
     2037               and buf_temp-rule-i-script.i-script-name = buf_prop-script.script-body no-error.
     2038         if available buf_temp-rule-i-script then next.
     2039         create buf_temp-rule-i-script.
     2040         assign
     2041         buf_temp-rule-i-script.root_rule_id  = p-rule-id
     2042         buf_temp-rule-i-script.i-script-type = 'class':U
     2043         buf_temp-rule-i-script.i-script-name = buf_prop-script.script-body
     2044         .
     2045         run temp-string_write in this-procedure ( input buf_prop-script.script-body ).
     2046       end.
     2047     end.
     2048   end.
     2049   end procedure.
     2050   procedure hist-news-class :
     2051   define parameter buffer buf_rule for ub.rule.
     2052   main-block:
     2053   do
     2054   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2055   :
     2056   define variable v-revis-id as integer no-undo .
     2057   define variable v-script-name as character no-undo .
     2058   define buffer buf_temp-rule-i-script for temp-rule-i-script.
     2059   define buffer buf_rule-i-script for ub.rule-i-script.
     2060   define buffer buf_prop-script for ub.prop-script.
     2061   define buffer buf0_prop-script for ub.prop-script.
     2062     _rule-i-script:
     2063     for each buf_rule-i-script no-lock where
     2064               buf_rule-i-script.root_rule_id = p-rule-id
     2065     break
     2066     by buf_rule-i-script.script-name
     2067     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2068     :
     2069       if buf_rule-i-script.i-script-type = 'variable':U
     2070       or buf_rule-i-script.i-script-type = 'get':U
     2071       or buf_rule-i-script.i-script-type = 'find':U
     2072       or buf_rule-i-script.i-script-type = 'define_b':U
     2073       or buf_rule-i-script.i-script-type = 'define_tt':U
     2074       or buf_rule-i-script.i-script-type = 'define_h':U
     2075       or buf_rule-i-script.script-type = '':U
     2076       then next _rule-i-script.
     2077       find first buf0_prop-script no-lock where
     2078                 buf0_prop-script.dtm-code = buf_rule-i-script.dtm-code
     2079             and buf0_prop-script.script-name = buf_rule-i-script.script-name
     2080             and buf0_prop-script.language = "ABL"
     2081             and buf0_prop-script.revis_id = buf_rule-i-script.revis_id no-error .
     2082       if not available buf0_prop-script then do:
     2083         message
     2084         substitute("Секция &&start-hn-option&&&1" +
     2085                     "Не найдено определение скрипта &1" +
     2086                     "Тип Скрипта &2&1" +
     2087                     "Скрипт &3&1" +
     2088                     "Ссылка на определение &4&1" +
     2089                     "Код объекта-операнда &5&1" +
     2090                     "Код класса &6&1" +
     2091                     "Версия &7"
     2092                   , chr(10)
     2093                     , buf_rule-i-script.script-type
     2094                     , buf_rule-i-script.i-script-name
     2095                     , buf_rule-i-script.script-name
     2096                     , buf_rule-i-script.dtm-code
     2097                     , buf_rule-i-script.class-dtm-code
     2098                     , buf_rule-i-script.revis_id
     2099                     )
     2100         view-as alert-box .
     2101         return error.
     2102       END.
     2103       v-revis-id = -1.
     2104       v-script-name = '':U.
     2105       if lookup(buf0_prop-script.proc-type, 'class,data-member,property,method,constructor,destructor':u) = 0  then next _rule-i-script.
     2106       for each buf_prop-script no-lock where
     2107                 buf_prop-script.class-dtm-code = buf_rule-i-script.class-dtm-code
     2108             and buf_prop-script.dtm-code = buf_rule-i-script.dtm-code
     2109             and  buf_prop-script.script-type = 'ifunction':U
     2110             and  buf_prop-script.language = "ABL"
     2111       by buf_prop-script.script-name
     2112       by buf_prop-script.revis_id:
     2113         if not (index(buf_prop-script.script-name, "~{&hist-nws_") > 0
     2114                 and  buf_prop-script.script-head = buf_rule-i-script.script-type )
     2115         and not buf_prop-script.script-name begins(buf_rule-i-script.script-type + "~{&hist-nws_")
     2116                 then next.
     2117         if buf_prop-script.revis_id > v-revis-id then do:
     2118           v-revis-id = buf_prop-script.revis_id.
     2119           v-script-name = buf_prop-script.script-name.
     2120         end.
     2121       end.
     2122       find first buf_prop-script no-lock where
     2123                 buf_prop-script.dtm-code = buf_rule-i-script.dtm-code
     2124             and buf_prop-script.class-dtm-code = buf_rule-i-script.class-dtm-code
     2125             and buf_prop-script.language = "ABL"
     2126             and buf_prop-script.script-type = 'ifunction':U
     2127             and buf_prop-script.script-name = v-script-name
     2128             and buf_prop-script.revis_id = v-revis-id no-error .
     2129       if not available buf_prop-script then do:
     2130         message
     2131         substitute("Секция &&start-hn-option&&&2" +
     2132                     "Не найдена процедура обработки истории и маршрутизации для класса &1&2(&6)&2" +
     2133                     "Скрипт &3&2" +
     2134                     "Код объекта-операнда &4&2" +
     2135                     "Код класса &5"
     2136                     , buf_rule-i-script.script-type
     2137                     , chr(10)
     2138                     , buf_rule-i-script.i-script-name
     2139                     , buf_rule-i-script.dtm-code
     2140                     , buf_rule-i-script.class-dtm-code
     2141                     , v-script-name
     2142                     )
     2143         view-as alert-box .
     2144         return error.
     2145       end.
     2146       find first buf_temp-rule-i-script no-lock where
     2147                 buf_temp-rule-i-script.root_rule_id = p-rule-id
     2148             and buf_temp-rule-i-script.i-script-name = buf_prop-script.script-name
     2149             and buf_temp-rule-i-script.i-script-type = "hist-news"
     2150             no-error.
     2151       if available buf_temp-rule-i-script then next.
     2152       create buf_temp-rule-i-script.
     2153       assign
     2154       buf_temp-rule-i-script.root_rule_id  = p-rule-id
     2155       buf_temp-rule-i-script.i-script-type = "hist-news"
     2156       buf_temp-rule-i-script.i-script-name = buf_prop-script.script-name
     2157       .
     2158       run temp-string_write in this-procedure ( input buf_prop-script.script-body ).
     2159     end.
     2160   end.
     2161   end procedure.
     2162   procedure process-rule-call-param :
     2163   define parameter buffer buf_rule for ub.rule.
     2164   define variable v-uniq-key-rec as character no-undo .
     2165   define variable v-string as character no-undo .
     2166   define buffer buf_ruledict-param  for ub.ruledict-param.
     2167   define buffer buf_ruledict for ub.ruledict.
     2168   _main:
     2169   do
     2170   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2171   :
     2172     run gen-key-rec in this-procedure (
     2173                                        input  'rule':U
     2174                                       ,input buffer buf_rule:handle
     2175                                       ,output v-uniq-key-rec ).
     2176     find first buf_ruledict no-lock where
     2177              buf_ruledict.entry-type = 'rule':U
     2178          AND buf_ruledict.uniq-key-rec = v-uniq-key-rec
     2179          AND buf_ruledict.language = "ABL"
     2180          .
     2181     for each buf_ruledict-param no-lock where
     2182             buf_ruledict-param.entry-id = buf_ruledict.entry-id
     2183         and buf_ruledict-param.language = "ABL":U
     2184     by buf_ruledict-param.param-num
     2185     on error undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)):
     2186       CASE buf_ruledict-param.param-mode:
     2187         when 'input':U then do:
     2188           if
     2189           lookup("LIST", buf_ruledict-param.param-3-data-type) > 0
     2190           or
     2191           lookup("SORTED-LIST", buf_ruledict-param.param-3-data-type) > 0
     2192           then do:
     2193             assign
     2194             v-string = substitute(
     2195            "for each buf_rule-call-param no-lock where&1" +
     2196                   "buf_rule-call-param.codex_id = p-codex-id&1" +
     2197               "and buf_rule-call-param.ruleset_id = p-ruleset-id&1" +
     2198               "and buf_rule-call-param.call_id = p-call-id&1" +
     2199               "and buf_rule-call-param.order_id = p-order-id&1" +
     2200               "and buf_rule-call-param.rule_id = p-rule-id&1" +
     2201               'and buf_rule-call-param.param-name = "&2"&1' +
     2202               'and buf_rule-call-param.p-index > 0:&1' +
     2203               'create buf_temp-rule-call-param.&1' +
     2204               'buffer-copy buf_rule-call-param to buf_temp-rule-call-param.&1' +
     2205               'release buf_temp-rule-call-param.&1' +
     2206            'end.&1'
     2207            , chr(10)
     2208            , buf_ruledict-param.param-name
     2209            ).
     2210           end.
     2211           else do:
     2212             assign
     2213             v-string = substitute(" find first buf_rule-call-param no-lock where&1" +
     2214                                               "buf_rule-call-param.codex_id = p-codex-id&1" +
     2215                                           "and buf_rule-call-param.ruleset_id = p-ruleset-id&1" +
     2216                                           "and buf_rule-call-param.call_id = p-call-id&1" +
     2217                                           "and buf_rule-call-param.order_id = p-order-id&1" +
     2218                                           "and buf_rule-call-param.rule_id = p-rule-id&1" +
     2219                                           'and buf_rule-call-param.param-name = "&2"&1 no-error.&1' +
     2220                                           "if available buf_rule-call-param then do:&1" +
     2221                                           "assign &2 = buf_rule-call-param.param-value-&3.&1" +
     2222                                           "end.&1"
     2223                                     , chr(10)
     2224                                     , buf_ruledict-param.param-name
     2225                                     , buf_ruledict-param.param-data-type).
     2226           end.
     2227         end.
     2228         when 'output':U then do:
     2229         end.
     2230         when 'input-output':U then do:
     2231         end.
     2232         when 'buffer':U then do:
     2233         end.
     2234         when 'input table':U then do:
     2235         end.
     2236         when 'output table':U then do:
     2237         end.
     2238         when 'input-output table':U then do:
     2239         end.
     2240       end case.
     2241       run temp-string_write in this-procedure ( input v-string ).
     2242     end.
     2243   end.
     2244   end procedure.
     2245   procedure process-release-obj :
     2246   define input parameter p-rule-id as integer no-undo .
     2247   define variable v-revis-id as integer no-undo .
     2248   define variable v-script-name as character no-undo .
     2249   define variable v-release-name as character no-undo .
     2250   define variable v-retry-action as integer no-undo .
     2251   define buffer buf_rule-i-script for ub.rule-i-script.
     2252   define buffer buf_prop-script for ub.prop-script.
     2253   define buffer buf2_prop-script for ub.prop-script.
     2254   define buffer buf_pscript-ruleset for ub.pscript-ruleset.
     2255   define buffer buf_temp-rule-i-script for temp-rule-i-script.
     2256   define buffer buf_rule-script for ub.rule-script.
     2257   define buffer buf_tt-rule-script for tt-rule-script.
     2258   main-block:
     2259   do
     2260   on error undo, return error
     2261   :
     2262     _rule-script:
     2263     for each buf_tt-rule-script,
     2264         each  buf_rule-i-script no-lock where
     2265               buf_rule-i-script.root_rule_id = p-rule-id
     2266          and  buf_rule-i-script.i-script-type = 'variable':U
     2267          and buf_rule-i-script.script_id = buf_tt-rule-script.script_id
     2268     by buf_tt-rule-script.gen-order
     2269     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2270     :
     2271       find first buf_rule-script where
     2272                 buf_rule-script.root_rule_id = p-rule-id
     2273             and  buf_rule-script.script_id = buf_rule-i-script.script_id.
     2274       if lookup(buf_rule-i-script.script-type, 'character,date,datetime,datetime-tz,decimal,integer,void,logical,memptr,raw,recid,rowid,widget-handle,handle,blob,clob,class,com-handle,longchar,int64':U) = 0 then do:
     2275         assign
     2276         v-revis-id = -1
     2277         v-script-name = '':U
     2278         .
     2279         for each buf_pscript-ruleset no-lock where
     2280                 buf_pscript-ruleset.codex_id = buf_rule.codex_id
     2281             and buf_pscript-ruleset.dtm-code = buf_rule-i-script.dtm-code
     2282             and buf_pscript-ruleset.script-name begins (buf_rule-i-script.script-type + "~{&release_")
     2283             and buf_pscript-ruleset.language = "ABL",
     2284             first  buf_prop-script no-lock where
     2285                   buf_prop-script.dtm-code = buf_rule-i-script.dtm-code
     2286               and buf_prop-script.class-dtm-code = buf_rule-i-script.class-dtm-code
     2287               and buf_prop-script.language = "ABL"
     2288               and buf_prop-script.proc-type = 'method':U
     2289               and buf_prop-script.script-name = buf_pscript-ruleset.script-name
     2290               and buf_prop-script.revis_id = buf_pscript-ruleset.revis_id
     2291         by buf_pscript-ruleset.script-name
     2292         by buf_pscript-ruleset.revis_id :
     2293           if buf_prop-script.revis_id > v-revis-id then do:
     2294             v-revis-id = buf_prop-script.revis_id.
     2295             v-script-name = buf_prop-script.script-name.
     2296           end.
     2297         end.
     2298         find first buf_prop-script no-lock where
     2299                   buf_prop-script.dtm-code = buf_rule-i-script.dtm-code
     2300               and buf_prop-script.class-dtm-code = buf_rule-i-script.class-dtm-code
     2301               and buf_prop-script.language = "ABL"
     2302               and buf_prop-script.proc-type = 'method':U
     2303               and buf_prop-script.script-name = v-script-name
     2304               and buf_prop-script.revis_id = v-revis-id no-error .
     2305         if not available buf_prop-script then do:
     2306           message
     2307           substitute("Секция &&start-release-obj&&&3" +
     2308                       "Не найден метод освобождения переменной &1 для класса &2&3" +
     2309                       "Код объекта-операнда &4&3" +
     2310                       "Код класса &5"
     2311                     , v-script-name
     2312                       , buf_rule-i-script.script-type
     2313                       , chr(10)
     2314                       , buf_rule-i-script.dtm-code
     2315                       , buf_rule-i-script.class-dtm-code
     2316                       )
     2317           view-as alert-box error .
     2318           undo, return error .
     2319         end.
     2320         if buf_rule-i-script.dtm-code <> buf_rule-i-script.class-dtm-code then do:
     2321           find first buf2_prop-script no-lock where
     2322                     buf2_prop-script.dtm-code = buf_rule-i-script.dtm-code
     2323                 and buf2_prop-script.class-dtm-code = buf_rule-i-script.class-dtm-code
     2324                 and buf2_prop-script.language = "ABL"
     2325                 and buf2_prop-script.proc-type = 'class':U
     2326                 and buf2_prop-script.script-name = buf_rule-i-script.script-type
     2327                 and buf2_prop-script.revis_id = v-revis-id no-error .
     2328           if not available buf2_prop-script then do:
     2329             message
     2330             substitute("Секция &&start-release-obj&&&2" +
     2331                         "Не найден класс &1&2" +
     2332                         "Код объекта-операнда &3&2" +
     2333                         "Код класса &4"
     2334                       ,buf_rule-i-script.script-type
     2335                       ,chr(10)
     2336                       ,buf_rule-i-script.dtm-code
     2337                       ,buf_rule-i-script.class-dtm-code
     2338                       )
     2339             view-as alert-box error .
     2340             undo, return error .
     2341           end.
     2342           v-release-name =  replace(buf_prop-script.script-name
     2343                                         ,buf2_prop-script.script-name
     2344                                         ,buf2_prop-script.script-head).
     2345         end.
     2346         else do:
     2347           v-release-name =  buf_prop-script.script-name.
     2348         end.
     2349         find first buf_temp-rule-i-script no-lock where
     2350                   buf_temp-rule-i-script.root_rule_id = p-rule-id
     2351               and buf_temp-rule-i-script.script_id = buf_tt-rule-script.script_id
     2352               and buf_temp-rule-i-script.i-script-name = v-release-name no-error.
     2353         if available buf_temp-rule-i-script then next _rule-script.
     2354         create buf_temp-rule-i-script.
     2355         assign
     2356         buf_temp-rule-i-script.root_rule_id  = p-rule-id
     2357         buf_temp-rule-i-script.script_id     = buf_tt-rule-script.script_id
     2358         buf_temp-rule-i-script.i-script-type = 'method':U
     2359         buf_temp-rule-i-script.i-script-name = v-release-name
     2360         buf_temp-rule-i-script.script-name = "release"
     2361         .
     2362         if v-count-retry-action = yes then do:
     2363           v-retry-action = v-retry-action + 1.
     2364           run temp-string_write in this-procedure ( input  substitute("if v-retry-action < &1 then do:"
     2365                                                                       ,v-retry-action
     2366                                                                       )).
     2367         end.
     2368         run temp-string_write in this-procedure ( input  substitute("&1"
     2369                                                                     ,buf_prop-script.script-foot
     2370                                                                     )).
     2371         run temp-string_write in this-procedure ( input  substitute("&1:&2 ."
     2372                                                                     ,buf_rule-i-script.script-name
     2373                                                                     ,v-release-name
     2374                                                                     )).
     2375         if v-count-retry-action = yes then do:
     2376           run temp-string_write in this-procedure ( input  substitute("end."
     2377                                                                       )).
     2378         end.
     2379       end.
     2380     end.
     2381     for each buf_temp-rule-i-script where
     2382             buf_temp-rule-i-script.script-name = "release":
     2383       delete buf_temp-rule-i-script.
     2384     end.
     2385   end.
     2386   end procedure.
     2387   procedure process-def-vars :
     2388   define input parameter p-rule-id as integer no-undo .
     2389   define variable v-revis-id as integer no-undo .
     2390   define variable v-script-name as character no-undo .
     2391   define variable v-constructor-name as character no-undo .
     2392   define buffer buf_rule-i-script for ub.rule-i-script.
     2393   define buffer buf_prop-script for ub.prop-script.
     2394   define buffer buf2_prop-script for ub.prop-script.
     2395   define buffer buf_pscript-ruleset for ub.pscript-ruleset.
     2396   define buffer buf_temp-rule-i-script for temp-rule-i-script.
     2397   define buffer buf_rule-script for ub.rule-script.
     2398   main-block:
     2399   do
     2400   on error undo, return error
     2401   :
     2402     for each buf_rule-i-script no-lock where
     2403               buf_rule-i-script.root_rule_id = p-rule-id
     2404          and  buf_rule-i-script.i-script-type = 'variable':U
     2405     break
     2406     by buf_rule-i-script.i-script-name
     2407     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2408     :
     2409       if first-of(buf_rule-i-script.i-script-name) then do:
     2410         find first buf_temp-rule-i-script no-lock where
     2411                   buf_temp-rule-i-script.root_rule_id = p-rule-id
     2412               and buf_temp-rule-i-script.i-script-name = buf_rule-i-script.script-name no-error.
     2413         if available buf_temp-rule-i-script then next.
     2414         create buf_temp-rule-i-script.
     2415         assign
     2416         buf_temp-rule-i-script.root_rule_id  = p-rule-id
     2417         buf_temp-rule-i-script.i-script-type = 'variable':U
     2418         buf_temp-rule-i-script.i-script-name = buf_rule-i-script.script-name
     2419         .
     2420         find first buf_rule-script where
     2421                   buf_rule-script.root_rule_id = p-rule-id
     2422              and  buf_rule-script.script_id = buf_rule-i-script.script_id.
     2423         run temp-string_write in this-procedure ( input  substitute("&1 ."
     2424                                                                     ,buf_rule-script.script)).
     2425         if lookup(buf_rule-i-script.script-type, 'character,date,datetime,datetime-tz,decimal,integer,void,logical,memptr,raw,recid,rowid,widget-handle,handle,blob,clob,class,com-handle,longchar,int64':U) = 0 then do:
     2426           assign
     2427           v-revis-id = -1
     2428           v-script-name = '':U
     2429           .
     2430           for each buf_pscript-ruleset no-lock where
     2431                   buf_pscript-ruleset.codex_id = buf_rule.codex_id
     2432               and buf_pscript-ruleset.dtm-code = buf_rule-i-script.dtm-code
     2433               and buf_pscript-ruleset.script-name begins (buf_rule-i-script.script-type + "~{&constructor_")
     2434               and buf_pscript-ruleset.language = "ABL",
     2435              first  buf_prop-script no-lock where
     2436                     buf_prop-script.dtm-code = buf_rule-i-script.dtm-code
     2437                 and buf_prop-script.class-dtm-code = buf_rule-i-script.class-dtm-code
     2438                 and buf_prop-script.language = "ABL"
     2439                 and buf_prop-script.proc-type = 'constructor':U
     2440                 and buf_prop-script.script-name = buf_pscript-ruleset.script-name
     2441                 and buf_prop-script.revis_id = buf_pscript-ruleset.revis_id
     2442          by buf_prop-script.script-name
     2443          by buf_prop-script.revis_id :
     2444             if buf_prop-script.revis_id > v-revis-id then do:
     2445               v-revis-id = buf_prop-script.revis_id.
     2446               v-script-name = buf_prop-script.script-name.
     2447             end.
     2448           end.
     2449           find first buf_prop-script no-lock where
     2450                     buf_prop-script.dtm-code = buf_rule-i-script.dtm-code
     2451                 and buf_prop-script.class-dtm-code = buf_rule-i-script.class-dtm-code
     2452                 and buf_prop-script.language = "ABL"
     2453                 and buf_prop-script.proc-type = 'constructor':U
     2454                 and buf_prop-script.script-name = v-script-name
     2455                 and buf_prop-script.revis_id = v-revis-id no-error .
     2456           if not available buf_prop-script then do:
     2457             message
     2458             substitute("Секция &&start-def-vars&&&3" +
     2459                         "Не найден конструктор &1 для класса &2&3" +
     2460                         "Код объекта-операнда &4&3" +
     2461                         "Код класса &5"
     2462                        ,v-script-name
     2463                        ,buf_rule-i-script.script-type
     2464                        ,chr(10)
     2465                        ,buf_rule-i-script.dtm-code
     2466                        ,buf_rule-i-script.class-dtm-code
     2467                        )
     2468             view-as alert-box error .
     2469             undo, return error .
     2470           end.
     2471           if buf_rule-i-script.dtm-code <> buf_rule-i-script.class-dtm-code then do:
     2472             find first buf2_prop-script no-lock where
     2473                       buf2_prop-script.dtm-code = buf_rule-i-script.dtm-code
     2474                   and buf2_prop-script.class-dtm-code = buf_rule-i-script.class-dtm-code
     2475                   and buf2_prop-script.language = "ABL"
     2476                   and buf2_prop-script.proc-type = 'class':U
     2477                   and buf2_prop-script.script-name = buf_rule-i-script.script-type
     2478                   and buf2_prop-script.revis_id = v-revis-id no-error .
     2479             if not available buf2_prop-script then do:
     2480               message
     2481               substitute("Секция &&start-def-vars&&&2" +
     2482                           "Не найден класс &1&2" +
     2483                           "Код объекта-операнда &3&2" +
     2484                           "Код класса &4"
     2485                         ,buf_rule-i-script.script-type
     2486                         ,chr(10)
     2487                         ,buf_rule-i-script.dtm-code
     2488                         ,buf_rule-i-script.class-dtm-code
     2489                         )
     2490               view-as alert-box error .
     2491               undo, return error .
     2492             end.
     2493             v-constructor-name =  replace(buf_prop-script.script-name
     2494                                           ,buf2_prop-script.script-name
     2495                                           ,buf2_prop-script.script-head).
     2496           end.
     2497           else do:
     2498             v-constructor-name =  buf_prop-script.script-name.
     2499           end.
     2500           run temp-string_write in this-procedure ( input  substitute("&1"
     2501                                                                       ,buf_prop-script.script-foot
     2502                                                                       )).
     2503           run temp-string_write in this-procedure ( input  substitute("&1 = new &2 ."
     2504                                                                       ,buf_rule-i-script.script-name
     2505                                                                       ,v-constructor-name
     2506                                                                       )).
     2507         end.
     2508       end.
     2509     end.
     2510   end.
     2511   end procedure.
     2512   procedure display-subsid-rule-i-script :
     2513   define parameter buffer buf_rule-i-script for ub.rule-i-script.
     2514     do
     2515     on error undo, return error
     2516     :
     2517       run temp-string_write in this-procedure ( input buf_rule-i-script.script-name ).
     2518     end.
     2519   end procedure.
