     2754         .
     2755       end.
     2756       if l-filter-open-18 = false then do:
     2757         message
     2758           "Ошибка при фильтрации / сортировке" skip
     2759           "Будут показаны записи без учета фильтра" skip
     2760           view-as alert-box .
     2761       end.
     2762       else do:
     2763           assign
     2764             l-query-was-opened = true
