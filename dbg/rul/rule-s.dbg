     2682       (input "ЖДИТЕ ..."
     2683       ).
     2684   run gbl/flt-get.p
     2685     (input filter-point
     2686     ,output flt-rec-18
     2687     ,output filter-name-18
     2688     ,output where-phrase-18
     2689     ,output sort-phrase-18
     2690     ,output where-phrase-rus-18
     2691     ,output sort-phrase-rus-18
     2692     ).
     2693   if p-open-query then do:
     2694       run set-filter-name in this-procedure
     2695         (INPUT filter-name-18
     2696         ) no-error .
     2697     assign
     2698       l-filter-open-18 = false
     2699     .
     2700     if flt-rec-18 <> ?
     2701       or sort-column-phrase > ""
     2702     then do:
     2703       define variable  parameter-2-18 as character no-undo .
     2704       define variable  parameter-3-18 as character no-undo .
     2705       define variable  parameter-4-18 as character no-undo .
     2706       define variable  parameter-5-18 as character no-undo .
     2707       define variable  parameter-6-18 as character no-undo .
     2708       define variable  parameter-7-18 as character no-undo .
     2709         assign
     2710         parameter-3-18 =
     2711                                 "FOR EACH X_rule"
     2712         parameter-4-18 =
     2713           (
     2714             if (" X_rule.upper_rule_id = 0                             and X_rule.codex_id = p-codex-id                            and (p-sts = -999999999 or X_rule.sts = p-sts)" + " " + where-phrase-18) <> ""
     2715             then  substitute('X_rule.upper_rule_id = 0                             and X_rule.codex_id = &1                            and (&2 = -999999999 or X_rule.sts = &2)', p-codex-id, p-sts) + " " + where-phrase-18
     2716             else "true"
     2717           )
     2718         parameter-5-18 = (" " + "" + " " + "")
     2719         parameter-6-18 = if sort-phrase-18 = ''
     2720                              then
     2721           (
     2722           " " + "  " +
     2723             " " + sort-column-phrase +
     2724           " " + " by X_rule.rule_id "
     2725           )
     2726                              else
     2727           (
     2728           " " + "  " +
     2729             " " + sort-column-phrase +
     2730           " " + sort-phrase-18
     2731           )
     2732         parameter-7-18 =
     2733           " indexed-reposition  "
     2734       .
     2735       do
     2736       on stop undo, leave
     2737       on error undo, leave
     2738       :
     2739         assign
     2740           l-disable-where-18 =
     2741             (" X_rule.upper_rule_id = 0                             and X_rule.codex_id = p-codex-id                            and (p-sts = -999999999 or X_rule.sts = p-sts)" + " " + where-phrase-18 = "")
     2742         .
     2743         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     2744                             ,input QUERY br-rule:handle
     2745                             ,input parameter-3-18
     2746                             ,input parameter-4-18
     2747                             ,input parameter-5-18
     2748                             ,input parameter-6-18
     2749                             ,input parameter-7-18
     2750                             )
     2751         .
