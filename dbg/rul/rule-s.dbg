     2766       end.
     2767     end.
     2768     if l-filter-open-18 = false then do:
     2769       OPEN QUERY br-rule FOR EACH X_rule
     2770         where  X_rule.upper_rule_id = 0                             and X_rule.codex_id = p-codex-id                            and (p-sts = -999999999 or X_rule.sts = p-sts)
     2771          by X_rule.rule_id
     2772         indexed-reposition
     2773     .
     2774         assign
     2775           l-query-was-opened = true
     2776         .
     2777     end.
     2778   end.
     2779   else do:
     2780     assign
     2781       v-doc-rec = recid( X_rule )
     2782     .
     2783     do
     2784     on stop undo, leave
     2785     on error undo, leave
     2786     :
     2787       if QUERY br-rule:handle:get-buffer-handle(1) = (buffer X_rule:handle) then do:
     2788         assign
     2789         parameter-2-18 = (if p-find-next then "true":u else "false":u )
     2790         parameter-4-18 =
     2791           "where ":u +  substitute('X_rule.upper_rule_id = 0                             and X_rule.codex_id = &1                            and (&2 = -999999999 or X_rule.sts = &2)', p-codex-id, p-sts) + " ":u + where-phrase-18 + " ":u + p-find-condition + " " + ""
     2792         parameter-5-18 = "  "
     2793       .
     2794         run fltopend_fltfindd in this-procedure  (
     2795                             input this-procedure:handle
     2796                             ,input QUERY br-rule:handle
     2797                             ,input rowid(X_rule)
     2798                             ,input logical(parameter-2-18)
     2799                             ,input no-lock
     2800                             ,input (buffer X_rule:handle)
     2801                             ,input parameter-4-18
     2802                             ,input parameter-5-18
     2803                             ) no-error.
     2804         .
     2805         assign
     2806           v-doc-rec = integer(return-value)
     2807           v-fltopend-rowid[1] = ?
     2808         .
     2809       end.
     2810       else do:
     2811         assign
     2812         parameter-2-18 = (if p-find-next then "true":u else "false":u )
     2813         parameter-3-18 =  "FOR EACH X_rule"
     2814         parameter-4-18 =
     2815           (
     2816             if (" X_rule.upper_rule_id = 0                             and X_rule.codex_id = p-codex-id                            and (p-sts = -999999999 or X_rule.sts = p-sts)" + " " + where-phrase-18) <> ""
     2817             then  substitute('X_rule.upper_rule_id = 0                             and X_rule.codex_id = &1                            and (&2 = -999999999 or X_rule.sts = &2)', p-codex-id, p-sts) + " " + where-phrase-18
     2818             else "true"
     2819           )
     2820         parameter-5-18 = (" " + "" + " " + "" + " " + p-find-condition)
     2821         parameter-6-18 = if sort-phrase-18 = ''
     2822                              then
     2823           (
     2824           " " + "  " +
     2825             " " + sort-column-phrase +
     2826           " " + " by X_rule.rule_id "
     2827           )
     2828                              else
     2829           (
     2830           " " + "  " +
     2831             " " + sort-column-phrase +
     2832           " " + sort-phrase-18
     2833           )
     2834         parameter-7-18 =
     2835           " indexed-reposition  "
     2836       .
     2837         run fltopend_fltfindq in this-procedure  (
     2838                             input this-procedure:handle
     2839                             ,input QUERY br-rule:handle
     2840                             ,input logical(parameter-2-18)
     2841                             ,input no-lock
     2842                             ,input parameter-3-18
     2843                             ,input parameter-4-18
     2844                             ,input parameter-5-18
     2845                             ,input parameter-6-18
     2846                             ,input parameter-7-18
     2847                             ,output v-fltopend-rowid
     2848                             ) no-error.
     2849         .
     2850         v-doc-rec = ?.
     2851       end.
     2852       assign
     2853         l-query-was-opened = true
     2854       .
     2855     end.
     2856   end.
     2857     run waitfram-hide in this-procedure .
     2858     END.
     2859   END CASE.
     2860   if not p-open-query then
     2861   REPOSITION br-rule to recid v-doc-rec No-ERROR.
     2862   if not p-open-query and v-fltopend-rowid[1] <> ? then
     2863   query br-rule:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
     2864   run waitfram-hide in this-procedure.
     2865   APPLY "ENTRY" TO br-rule.
     2866   APPLY "VALUE-CHANGED" TO br-rule in frame Dialog-Frame.
     2867   END PROCEDURE.
     2868   PROCEDURE proc-b-cmp :
     2869   DEFINe INPUT PARAMETER p-option AS CHARACTER NO-UNDO.
     2870   DEFINE VARIABLE v-ii AS INTEGER NO-UNDO.
     2871   DEFINE VARIABLE v-ii-ok AS INTEGER NO-UNDO.
     2872   define variable v-rid-list as character no-undo .
     2873   DEFINE BUFFER buf_rule FOR ub.RULE.
     2874   define buffer buf_ruleset for ub.ruleset.
     2875   define buffer buf_rule-profile for ub.rule-profile.
     2876   CASE p-option:
     2877     WHEN "one":U  THEN DO:
     2878        IF NOT AVAILABLE X_rule THEN RETURN error.
     2879        v-rid-list = string(RECID(X_rule)).
     2880     END.
     2881     WHEN "codex":U  THEN DO:
     2882         run rul/ruleset-s.w ( input parparentproc
     2883                               ,input "b-sel"
     2884                               ,input "only-codex"
     2885                               ,input 0
     2886                               ,input-output v-rid-list) no-error.
     2887        if v-rid-list = '':u then return error.
     2888        find first buf_ruleset no-lock where
     2889                 recid(buf_ruleset) = integer(v-rid-list) no-error.
     2890        IF NOT AVAILABLE buf_ruleset THEN RETURN error.
     2891        v-rid-list = '':U.
     2892        for each buf_rule no-lock where
     2893                buf_rule.codex_id = buf_ruleset.codex_id
     2894            and buf_rule.upper_rule_id = 0 :
     2895          v-rid-list = v-rid-list +
     2896                       (if v-rid-list = '':U
     2897                       then '':U
     2898                       else chr(44)) + string(recid(buf_rule)).
     2899        end.
     2900     END.
     2901     WHEN "list" THEN DO:
     2902       run rul/rule-s.w ( INPUT parparentproc
     2903                     ,INPUT "b-sel,b-mark"
     2904                     ,INPUT 'все':U
     2905                     ,INPUT 0
     2906                     ,INPUT 0
     2907                     ,input-output v-rid-list ) NO-ERROR.
     2908       IF v-rid-list = '':U THEN RETURN error.
     2909     END.
     2910     WHEN "rule-profile" THEN DO:
     2911       run rul/rule-profile-s.w ( INPUT parparentproc
     2912                     ,INPUT "b-sel"
     2913                     ,INPUT 'все':U
     2914                     ,INPUT '':U
     2915                     ,input-output v-rid-list ) NO-ERROR.
     2916       IF v-rid-list = '':U THEN RETURN error.
     2917       find first buf_rule-profile no-lock where
     2918                 recid(buf_rule-profile) = integer(v-rid-list) no-error.
     2919       if buf_rule-profile.profile-type <> 'trn-doc':U
     2920       and entry(1, buf_rule-profile.profile-type, "_") <> 'chk-doc':U
     2921       then do:
     2922         message
     2923         substitute("Компиляция по профайлам предназначена для профайлов типа &1, &2"
     2924                    ,'trn-doc':U
     2925                    ,'chk-doc':U)
     2926         view-as alert-box error .
     2927         return error.
     2928       end.
     2929     END.
     2930   END CASE.
     2931   run waitfram-show in this-procedure ( input "Ждите..." ).
     2932   case p-option:
     2933     when "rule-profile" then do:
     2934       run waitfram-show in this-procedure ( substitute("Компиляция профайла &1", buf_rule-profile.profile_id) ).
     2935       run rul/rp-prep.p ( input buf_rule-profile.profile_id ) no-error.
     2936       if error-status:error then do:
     2937           run waitfram-hide in this-procedure .
     2938           message
     2939           substitute("Ошибка при компиляции профайла&1&2" +
     2940                     "&3&2&4&2"
     2941                     , buf_rule-profile.profile_id
     2942                     , chr(10)
     2943                     , error-status:error
     2944                     , return-value
     2945                     )
     2946           view-as alert-box error .
     2947       end.
     2948       run waitfram-hide in this-procedure .
     2949     end.
     2950     otherwise do:
     2951       _rule:
     2952       DO v-ii = 1 TO NUM-ENTRIES(v-rid-list):
     2953         FIND FIRST buf_rule NO-LOCK WHERE
     2954                   recid(buf_rule) = INTEGER(ENTRY(v-ii, v-rid-list)) NO-ERROR.
     2955         IF NOT AVAILABLE buf_rule THEN DO:
     2956           MESSAGE
     2957           substitute("Не найдено правило с recid &1", INTEGER(ENTRY(v-ii, v-rid-list)))
     2958           VIEW-AS ALERT-BOX ERROR.
     2959         END.
     2960         run waitfram-show in this-procedure ( substitute("Компиляция правила &1", buf_rule.rule_id) ).
     2961         run rul/ruleprep.p ( INPUT buf_rule.RULE_id) no-error.
     2962         if error-status:error then do:
     2963             run waitfram-hide in this-procedure .
     2964             message
     2965             substitute("Ошибка при компиляции правила &1&2" +
     2966                       "&3&2&4&2"
     2967                       , X_rule.rule_id
     2968                       , chr(10)
     2969                       , error-status:error
     2970                       , return-value
     2971                       )
     2972             view-as alert-box error .
     2973             NEXT _rule.
     2974           end.
     2975           ELSE DO:
     2976             v-ii-ok = v-ii-ok + 1.
     2977           END.
     2978       END.
     2979     end.
     2980   end case.
     2981   run waitfram-hide in this-procedure .
     2982   MESSAGE
     2983   SUBSTITUTE("Из выбранных Вами &1 правил удалось откомпилить &2"
     2984              ,v-ii - 1
     2985              ,v-ii-ok)
     2986   VIEW-AS ALERT-BOX WARNING.
     2987   END PROCEDURE.
     2988   PROCEDURE proc-b-link :
     2989   DEFINE INPUT PARAMETER p-option AS CHARACTER NO-UNDO.
     2990   DEFINE VARIABLE v-rec AS RECID NO-UNDO.
     2991   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     2992   DEFINE BUFFER buf_ruledict FOR ub.ruledict.
     2993   DEFINE BUFFER buf_rule-call-param FOR ub.rule-call-param.
     2994   IF NOT AVAILABLE X_rule THEN DO:
     2995     undo, RETURN ERROR.
     2996   END.
     2997   v-rec = recid(X_rule).
     2998   CASE p-option:
     2999     WHEN 'ruleset':U THEN DO:
     3000       run rul/rule-by-set-s.w ( INPUT parparentproc
     3001                               ,INPUT (if (v-cntxt-db-num = 0 and lookup("b-add", bttns) > 0)
     3002                                       then "b-add"
     3003                                       else '':U)
     3004                               ,INPUT "rule"
     3005                               ,INPUT X_rule.codex_id
     3006                               ,input 0
     3007                               ,INPUT X_rule.rule_id
     3008                               ,INPUT-OUTPUT v-rid-list) NO-ERROR.
     3009     END.
     3010     WHEN 'rule-by-call':U THEN DO:
     3011         run rul/rule-by-call-s.w ( input parparentproc
     3012                                ,INPUT "":U
     3013                                ,input "rule"
     3014                                ,input '':U
     3015                                ,input X_rule.codex_id
     3016                                ,input 0
     3017                                ,input X_rule.rule_id
     3018                                ,input-output v-rec) no-error.
     3019     END.
     3020     WHEN 'rule-i-script':U THEN DO:
     3021         run rul/rule-i-script-s.w ( input parparentproc
     3022                                ,INPUT (if (v-cntxt-db-num = 0 and lookup("b-add", bttns) > 0)
     3023                                       then "b-del":U
     3024                                       else '':U)
     3025                                ,input "rule"
     3026                                ,input X_rule.rule_id
     3027                                ,INPUT '':U
     3028                                ,INPUT '':U
     3029                                ,input-output v-rec) no-error.
     3030     END.
     3031     WHEN 'rule-by-profile':U THEN DO:
     3032         run rul/rule-by-profile-s.w ( INPUT parparentproc
     3033                                   ,INPUT "":U
     3034                                   ,INPUT "rule"
     3035                                   ,INPUT 0
     3036                                   ,INPUT 0
     3037                                   ,INPUT 0
     3038                                   ,INPUT X_rule.rule_id
     3039                                   ,INPUT-OUTPUT v-rid-list) NO-ERROR.
     3040     END.
     3041     WHEN 'rule-call-param':U THEN DO:
     3042       for each tt0-rule-call-param:
     3043         delete tt0-rule-call-param.
     3044       end.
     3045       FOR each buf_rule-call-param no-lock where
     3046                 buf_Rule-call-param.rule_id = X_rule.rule_id:
     3047           create tt0-rule-call-param.
     3048           buffer-copy buf_rule-call-param to tt0-rule-call-param.
     3049       end.
     3050       run ref/rulercps.w ( INPUT parparentproc
     3051                           ,input this-procedure:handle
     3052                           ,INPUT "":U
     3053                           ,input 'ПРОСМОТР':U
     3054                           ,input 'rule-call-param':U
     3055                           ,input 0
     3056                           ,input ?
     3057                           ,input '':U
     3058                           ,input X_rule.codex_id
     3059                           ,input 0
     3060                           ,input ?
     3061                           ,input X_rule.RULE_id
     3062                           ,input substitute("Параметры вызова правила: кодекс &1 правило &2"
     3063                                             , X_rule.codex_id
     3064                                             , X_rule.rule_id)
     3065                           ,input-output table tt0-rule-call-param ) no-error.
     3066     END.
     3067     WHEN 'ruledict-param':U THEN DO:
     3068       FIND FIRST buf_ruledict NO-LOCK WHERE
     3069                 buf_ruledict.entry-type = 'rule':U
     3070             AND buf_ruledict.uniq-key-rec = X_rule.uniq-key-rec.
     3071       run rul/ruledict-param-s.w ( INPUT parparentproc
     3072                                 ,input ?
     3073                                 ,INPUT "":U
     3074                                 ,INPUT "entry-id"
     3075                                 ,INPUT buf_ruledict.entry-id
     3076                                 ,input 'rule':U
     3077                                 ,INPUT-OUTPUT v-rid-list) NO-ERROR.
     3078     END.
     3079   END CASE.
     3080   END PROCEDURE.
     3081   PROCEDURE proc-b-lkp :
     3082   DEFINE INPUT PARAMETER p-option AS CHARACTER NO-UNDO.
     3083   define variable v-rec as recid no-undo.
     3084   IF NOT AVAILABLE X_rule THEN DO:
     3085     undo, RETURN ERROR.
     3086   END.
     3087   IF p-option = "simple" THEN DO:
     3088     v-rec = recid(X_rule).
     3089     run rul/rule-i.w ( input parparentproc
     3090                          ,input 'ПРОСМОТР':U
     3091                          ,input X_rule.rule_id
     3092                          ,input-output v-rec) no-error.
     3093   END.
     3094   ELSE DO:
     3095       run rul/disprule.p (
     3096                              input p-option
     3097                             ,input X_rule.rule_id
     3098                             ,input 0
     3099                             ,input 0
     3100                             ,input 0
     3101                             ,input 0
     3102                              ) no-error .
     3103   END.
     3104   END PROCEDURE.
     3105   PROCEDURE proc-b-replace :
     3106   DEFINE VARIABLE v-rec AS RECID NO-UNDO.
     3107   DEFINE VARIABLE v-rid-list AS character NO-UNDO.
     3108   DEFINE BUFFER buf_rule FOR ub.RULE.
     3109   MESSAGE
     3110   substitute("Выберите из списка правило, на которое Вы хотите заменить правило &1"
     3111              , X_rule.RULE_id)
     3112   VIEW-AS ALERT-BOX.
     3113   run rul/rule-s.w ( INPUT parparentproc
     3114                     ,INPUT "b-sel"
     3115                     ,INPUT p-list-mode
     3116                     ,INPUT p-codex-id
     3117                     ,INPUT p-sts
     3118                     ,INPUT-OUTPUT v-rid-list) NO-ERROR.
     3119   IF ERROR-STATUS:ERROR
     3120   OR v-rid-list = '':U THEN RETURN NO-APPLY.
     3121   FIND FIRST buf_rule NO-LOCK WHERE
     3122           recid(buf_rule) = INTEGER(v-rid-list) no-error.
     3123   if NOT AVAILABLE buf_rule THEN RETURN NO-APPLY.
     3124   run waitfram-show in this-procedure ( input "Ждите..." ).
     3125   run rul/rule4.p (
     3126                   INPUT X_rule.rule_id
     3127                  ,INPUT buf_rule.rule_id
     3128                  ) NO-ERROR.
     3129   IF error-status:ERROR THEN DO:
     3130     run waitfram-hide in this-procedure .
     3131     message
     3132     error-status:get-message(1)  skip
     3133     return-value
     3134     view-as alert-box error .
     3135     undo, RETURN error.
     3136   END.
     3137   run waitfram-hide in this-procedure .
     3138   v-rec = recid(X_rule).
     3139   RUN openbr IN THIS-PROCEDURE ( INPUT YES
     3140                               ,INPUT NO
     3141                               ,INPUT '':U).
     3142   REPOSITION br-rule to RECID v-rec NO-ERROR.
     3143   APPLY "entry" TO br-rule IN FRAME Dialog-Frame.
     3144   APPLY "VALUE-CHANGED" TO br-rule.
     3145   END PROCEDURE.
     3146   PROCEDURE proc-b-sch :
     3147   assign
     3148     tbl = 'rule'
     3149     join-tbl = 'X_rule'
     3150     fld = ""
     3151     lab = ""
     3152     spr = ""
     3153     dim = '0'
     3154     .
     3155   run fltfield-add in this-procedure('rule_id', 'Код правила', '',
     3156   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3157   run fltfield-add in this-procedure('name', 'Название', '',
     3158   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3159   run fltfield-add in this-procedure('documentation', 'Описание', '',
     3160   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3161   run fltfield-add in this-procedure('reusable-params', 'Выполнимо многократно', '',
     3162   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3163   run fltfield-add in this-procedure('codex_id', 'Кодекс правил', '',
     3164   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3165   Filter-Block:
     3166   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     3167       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     3168       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     3169     run gbl/filter.w ( INPUT parparentproc
     3170                      , INPUT filter-point + chr(4) + filter-point-label
     3171                      , INPUT tbl
     3172                      , INPUT join-tbl
     3173                      , INPUT fld
     3174                      , INPUT lab
     3175                      , INPUT spr
     3176                      , INPUT dim ).
     3177     RUN OpenBr IN THIS-PROCEDURE (INPUT yes
     3178                                  ,INPUT no
     3179                                  ,INPUT '':U).
     3180   end.
     3181   END PROCEDURE.
     3182   PROCEDURE proc-b-status :
     3183   DEFINE INPUT PARAMETER p-status AS INTEGER NO-UNDO.
     3184   DEFINE VARIABLE v-rec AS RECID NO-UNDO.
     3185   run rul/rule2.p ( INPUT NO
     3186                  ,INPUT RECID(X_rule)
     3187                  ,INPUT p-status) NO-ERROR.
     3188   IF error-status:ERROR THEN DO:
     3189    undo, RETURN error.
     3190   END.
     3191   v-rec = recid(X_rule).
     3192   RUN openbr IN THIS-PROCEDURE ( INPUT YES
     3193                               ,INPUT NO
     3194                               ,INPUT '':U).
     3195   REPOSITION br-rule to RECID v-rec NO-ERROR.
     3196   APPLY "entry" TO br-rule IN FRAME Dialog-Frame.
     3197   APPLY "VALUE-CHANGED" TO br-rule.
     3198   END PROCEDURE.
