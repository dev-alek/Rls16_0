      367   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      368     define variable v-cntxt-db-num        as integer   no-undo .
      369     define variable v-cntxt-userid        as character no-undo .
      370     define variable v-cntxt-level         as character no-undo .
      371     define variable v-cntxt-host-code-obj as integer   no-undo .
      372     define variable v-cntxt-obj-type      as character no-undo .
      373     define variable v-cntxt-obj-code      as integer   no-undo .
      374     define variable v-cntxt-db-num-obj    as integer   no-undo .
      375     define variable v-cntxt-is-admin      as logical   no-undo .
      376   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      377   FUNCTION mark-string RETURNS CHARACTER
      378     ( input p-recid as recid, input mark-list as character  ) :
      379     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      380   END FUNCTION.
      381   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      382   define variable c-point  as character no-undo .
      383   define variable tbl      as character no-undo .
      384   define variable join-tbl as character no-undo .
      385   define variable fld      as character no-undo .
      386   define variable lab      as character no-undo .
      387   define variable spr      as character no-undo .
      388   define variable dim      as character no-undo .
      389   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      390   procedure fltfield-clear :
      391     define output parameter loc-fld as character no-undo.
      392     define output parameter loc-lab as character no-undo .
      393     define output parameter loc-spr as character no-undo .
      394     define output parameter loc-dim as character no-undo .
      395     assign
      396       loc-fld = ""
      397       loc-lab = ""
      398       loc-spr = ""
      399       loc-dim = "0"
      400     .
      401   end procedure .
      402   procedure fltfield-add :
      403     define input        parameter par-fld as character no-undo.
      404     define input        parameter par-lab as character no-undo .
      405     define input        parameter par-spr as character no-undo .
      406     define input-output parameter loc-fld as character no-undo.
      407     define input-output parameter loc-lab as character no-undo .
      408     define input-output parameter loc-spr as character no-undo .
      409     define input-output parameter loc-dim as character no-undo .
      410     do
      411     on error undo, return error
      412     :
      413       assign
      414       loc-fld = if loc-dim = '0'
      415                 then par-fld
      416                 else (loc-fld + chr(44) + par-fld)
      417       loc-lab = if loc-dim = '0'
      418                 then par-lab
      419                 else (loc-lab + chr(44) + par-lab)
      420       loc-spr = if loc-dim = '0'
      421                 then par-spr
      422                 else (loc-spr + chr(44) + par-spr)
      423       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      424                 string(integer(if num-entries(loc-dim) > 1
      425                               then entry(2, loc-dim)
      426                               else entry(1, loc-dim)
      427                               ) + 1)
      428       no-error
      429       .
      430     end.
      431   end procedure.
      432   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      433   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      434   procedure fltopend_fltopend :
      435   define input parameter p-parent-handle as handle no-undo .
      436   define input parameter p-qh as handle no-undo .
      437   define input parameter p-flt-open-open-query  as character no-undo .
      438   define input parameter p-where-cond as character no-undo .
      439   define input parameter p-use-indFIRST-query-tail as character no-undo .
      440   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      441   define input parameter p-indexed-reposition as character no-undo .
      442     do
      443     on error undo, return error
      444     :
      445   define variable v-prepare-string as character no-undo .
      446   define variable glog as logical no-undo .
      447   assign
      448   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      449                      p-where-cond + chr(32)  +
      450                      p-use-indFIRST-query-tail + chr(32) +
      451                      p-use-ind-sort-clmn-by + chr(32) +
      452                      p-indexed-reposition
      453   .
      454   assign
      455   glog = p-qh:query-prepare(v-prepare-string) no-error .
      456   if not glog
      457   or error-status:error then do:
      458     message error-status:get-message(1) view-as alert-box .
      459     undo, return error .
      460   end.
      461   assign
      462   glog = p-qh:query-open no-error .
      463   if not glog
      464   or error-status:error then do:
      465     message error-status:get-message(1) view-as alert-box .
      466     undo, return error .
      467   end.
      468     end.
      469   end procedure.
      470   procedure fltopend_fltfindd :
      471   define input parameter p-parent-handle as handle no-undo .
      472   define input parameter p-qh as handle no-undo .
      473   define input parameter p-rowid as rowid no-undo .
      474   define input parameter p-next as logical no-undo .
      475   define input parameter p-lock as integer no-undo .
      476   define input parameter p-bh as handle no-undo .
      477   define input parameter p-where-cond as character no-undo .
      478   define input parameter p-use-index-phrase as character no-undo .
      479   define variable glog as logical no-undo .
      480   define variable v-qh as handle no-undo .
      481   define variable v-bh as handle no-undo .
      482   define variable v-recid as recid no-undo .
      483   define variable v-prepare-string as character no-undo .
      484   do
      485   on error undo, return error
      486   on stop undo, return error
      487   :
      488     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      489     create buffer v-bh for table p-bh buffer-name p-bh:name.
      490     create query v-qh.
      491     v-qh:set-buffers(v-bh).
      492     v-prepare-string = substitute("for each &1 &2 &3"
      493                                     ,v-bh:name
      494                                     ,p-where-cond
      495                                     ,p-use-index-phrase).
      496     glog = v-qh:query-prepare(v-prepare-string) no-error.
      497     if not glog then do:
      498       delete object v-qh.
      499       delete object v-bh.
      500       undo, return error .
      501     end.
      502     glog = v-qh:query-open no-error .
      503     if not glog then do:
      504       delete object v-qh.
      505       delete object v-bh.
      506       undo, return error .
      507     end.
      508     if p-next then do:
      509       v-qh:reposition-to-rowid(p-rowid) no-error .
      510       glog = v-qh:get-next( p-lock) no-error .
      511       glog = v-qh:get-next( p-lock) no-error .
      512       if not glog or v-qh:query-off-end = yes then do:
      513         glog = v-qh:get-first( p-lock) no-error .
      514       end.
      515     end.
      516     else do:
      517       glog = v-qh:get-first( p-lock) no-error .
      518     end.
      519     v-recid = v-bh:recid no-error .
      520     delete object v-qh.
      521     delete object v-bh.
      522     return string(v-recid) .
      523   end.
      524   end procedure.
      525   procedure fltopend_fltfindq :
      526   define input parameter p-parent-handle as handle no-undo .
      527   define input parameter p-qh as handle no-undo .
      528   define input parameter p-next as logical no-undo .
      529   define input parameter p-lock as integer no-undo .
      530   define input parameter p-flt-open-open-query  as character no-undo .
      531   define input parameter p-where-cond as character no-undo .
      532   define input parameter p-use-indFIRST-query-tail as character no-undo .
      533   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      534   define input parameter p-indexed-reposition as character no-undo .
      535   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      536   define variable glog as logical no-undo .
      537   define variable v-qh as handle no-undo .
      538   define variable v-bh as handle no-undo extent 18.
      539   define variable v-rowid as rowid no-undo extent 18.
      540   define variable v-ii as integer no-undo .
      541   define variable v-prepare-string as character no-undo .
      542   do
      543   on error undo, return error
      544   on stop undo, return error
      545   :
      546     create query v-qh.
      547     do v-ii = 1 to p-qh:num-buffers:
      548       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      549       assign
      550       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      551       no-error.
      552       v-qh:add-buffer(v-bh[v-ii]).
      553     end.
      554     assign
      555     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      556                       p-where-cond + chr(32)  +
      557                       p-use-indFIRST-query-tail + chr(32) +
      558                       p-use-ind-sort-clmn-by + chr(32) +
      559                       p-indexed-reposition
      560     .
      561     glog = v-qh:query-prepare( v-prepare-string) no-error .
      562     if not glog then do:
      563       delete object v-qh.
      564       do v-ii = 1 to p-qh:num-buffers:
      565         delete object v-bh[v-ii].
      566       end.
      567       undo, return error .
      568     end.
      569     glog = v-qh:query-open no-error .
      570     if not glog then do:
      571       delete object v-qh.
      572       do v-ii = 1 to p-qh:num-buffers:
      573         delete object v-bh[v-ii].
      574       end.
      575       undo, return error .
      576     end.
      577     if p-next then do:
      578       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      579       glog = v-qh:get-next( p-lock) no-error .
      580       glog = v-qh:get-next( p-lock) no-error .
      581       if not glog or v-qh:query-off-end = yes then do:
      582         glog = v-qh:get-first( p-lock) no-error .
      583       end.
      584     end.
      585     else do:
      586       glog = v-qh:get-first( p-lock) no-error .
      587     end.
      588     do v-ii = 1 to p-qh:num-buffers:
      589       assign
      590       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
      591       no-error.
      592     end.
      593     delete object v-qh.
      594     do v-ii = 1 to p-qh:num-buffers:
      595       delete object v-bh[v-ii].
      596     end.
      597   end.
      598   end procedure.
      599   DEFINE VARIABLE v-doc-rec AS RECID NO-UNDO.
      600   DEFINE VARIABL link-option AS CHARACTER NO-UNDO.
      601   DEFINE VARIABL lkp-option AS CHARACTER NO-UNDO.
      602   DEFINE TEMP-TABLE tt0-rule-call-param NO-UNDO LIKE ub.rule-call-param.
      603   define variable sort-column-name as character no-undo .
      604   define variable filter-point-label as character no-undo init "Правила RULE-машины" .
      605   define variable filter-point0 as character no-undo init "rule-s" .
      606   define variable filter-point as character no-undo init "rule-s" .
      607   define variable v-rid-list as character no-undo .
      608   DEFINE VARIABLE status-option AS integer NO-UNDO.
      609   DEFINE variable cmp-OPTION AS CHARACTER NO-UNDO.
      610   DEFINE MENU MENU-b-cmp
      611          MENU-ITEM m_one          LABEL "Одно правило"
      612          MENU-ITEM m_codex        LABEL "По кодексу"
      613          MENU-ITEM m_list         LABEL "По списку"
      614          MENU-ITEM m_rule-profile LABEL "Профайл"       .
      615   DEFINE MENU MENU-b-link
      616          MENU-ITEM m_ruleset      LABEL "Наборы правил"
      617          MENU-ITEM m_rule-i-script LABEL "Используемые скрипты"
      618          MENU-ITEM m_rule-profile LABEL "Профайлы"
      619          MENU-ITEM m_rule-by-call LABEL "Точки вызова"
      620          MENU-ITEM m_ruledict-param LABEL "Параметры"
      621          MENU-ITEM m_rule-call-param LABEL "Значения параметров".
      622   DEFINE MENU MENU-b-lkp
      623          MENU-ITEM m_simple       LABEL "Форма"
      624          MENU-ITEM m_text         LABEL "Текст"
      625          MENU-ITEM m_graph        LABEL "Схема"         .
      626   DEFINE MENU MENU-b-status
      627          MENU-ITEM m_-10          LABEL "Новое"
      628          MENU-ITEM m_-1           LABEL "Готово"
      629          MENU-ITEM m_98           LABEL "Удалить"       .
      630   DEFINE BUTTON b-add
      631        LABEL "&Добавить"
      632        SIZE 10 BY 1.
      633   DEFINE BUTTON b-chg
      634        LABEL "&Изменить"
      635        SIZE 10 BY 1.
      636   DEFINE BUTTON b-cmp
      637        LABEL "Скомпилить"
      638        SIZE 10 BY 1.
      639   DEFINE BUTTON B-copy
      640        LABEL "Копировать"
      641        SIZE 10 BY 1.
      642   DEFINE BUTTON b-del
      643        LABEL "&Удалить"
      644        SIZE 10 BY 1.
      645   DEFINE BUTTON B-Help
      646        LABEL "Помо&щь"
      647        SIZE 3 BY 1
      648        BGCOLOR 8 .
      649   DEFINE BUTTON b-links
      650        LABEL "Связи"
      651        SIZE 10 BY 1.
      652   DEFINE BUTTON b-lkp
      653        LABEL "&Просмотр"
      654        SIZE 10 BY 1.
      655   DEFINE BUTTON b-mark
      656        LABEL "&*"
      657        SIZE 4 BY 1.
      658   DEFINE BUTTON b-quit AUTO-END-KEY
      659        LABEL "&Выход"
      660        SIZE 10 BY 1
      661        BGCOLOR 8 .
      662   DEFINE BUTTON b-replace
      663        LABEL "&Заменить"
      664        SIZE 10 BY 1.
      665   DEFINE BUTTON b-sch
      666        LABEL "&Фильтр"
      667        SIZE 3 BY 1.
      668   DEFINE BUTTON b-sel AUTO-GO
      669        LABEL "Выбор"
      670        SIZE 10 BY 1.
      671   DEFINE BUTTON b-status
      672        LABEL "Статус"
      673        SIZE 10 BY 1.
      674   DEFINE VARIABLE EDITOR-1 AS CHARACTER
      675        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      676        SIZE 98 BY 2.87 NO-UNDO.
      677   DEFINE VARIABLE mark-num AS INTEGER FORMAT "->,>>>,>>9":U INITIAL 0
      678         VIEW-AS TEXT
      679        SIZE 9 BY .67
      680        FGCOLOR 10  NO-UNDO.
      681   DEFINE QUERY br-rule FOR
      682         X_rule SCROLLING.
      683   DEFINE BROWSE br-rule
      684     QUERY br-rule NO-LOCK DISPLAY
      685         mark-string(recid(X_rule), v-rid-list) Format "X(1)" COLUMN-LABEL "*"
      686   X_rule.rule_id COLUMN-LABEL "Код правила" FORMAT ">>>>>>>>9"
      687   entry (lookup (STRING(X_rule.sts), '-1,-10,0,1,99,98':U), 'готов,нов,исп,удал,удаление,запр.удал':U) COLUMN-LABEL "Статус" FORMAT "X(8)"
      688   X_rule.name COLUMN-LABEL "Имя объекта" format "X(255)" width 60
      689   X_rule.reusable-params COLUMN-LABEL "Выполнимо!многократно?" format "X(20)"
      690   (X_rule.hidden-content > 0) COLUMN-LABEL "Скрыто" FORMAT "Скрыто/"
      691       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 16.53 FIT-LAST-COLUMN.
      692   DEFINE FRAME Dialog-Frame
      693        b-quit AT ROW 1 COL 1
      694        b-mark AT ROW 1 COL 24 WIDGET-ID 12
      695        b-sel AT ROW 1 COL 28 WIDGET-ID 10
      696        b-add AT ROW 1 COL 38 WIDGET-ID 2
      697        b-chg AT ROW 1 COL 48 WIDGET-ID 4
      698        b-del AT ROW 1 COL 58 WIDGET-ID 8
      699        b-lkp AT ROW 1 COL 68 WIDGET-ID 6
      700        b-links AT ROW 1 COL 78 WIDGET-ID 16
      701        b-sch AT ROW 1 COL 92 WIDGET-ID 22
      702        B-Help AT ROW 1 COL 95
      703        B-copy AT ROW 2 COL 38 WIDGET-ID 28
      704        b-status AT ROW 2 COL 48 WIDGET-ID 26
      705        b-cmp AT ROW 2 COL 58 WIDGET-ID 18
      706        b-replace AT ROW 2 COL 68 WIDGET-ID 24
      707        br-rule AT ROW 3.33 COL 1 WIDGET-ID 100
      708        EDITOR-1 AT ROW 20 COL 1 NO-LABEL WIDGET-ID 20
      709        mark-num AT ROW 1 COL 13 COLON-ALIGNED NO-LABEL WIDGET-ID 14
      710        SPACE(75.24) SKIP(21.21)
      711       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      712            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      713            TITLE "Объекты"
      714            CANCEL-BUTTON b-quit.
      715   ASSIGN
      716          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      717          FRAME Dialog-Frame:HIDDEN           = TRUE.
      718   ASSIGN
      719          b-cmp:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-b-cmp:HANDLE.
      720   ASSIGN
      721          b-links:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-b-link:HANDLE.
      722   ASSIGN
      723          b-lkp:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-b-lkp:HANDLE.
      724   ASSIGN
      725          b-status:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-b-status:HANDLE.
      726   ASSIGN
      727          EDITOR-1:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      728   ON GO OF FRAME Dialog-Frame
      729   DO:
      730     p-rid-list = v-rid-list.
      731   END.
      732   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      733   DO:
      734     APPLY "END-ERROR":U TO SELF.
      735   END.
      736   ON CHOOSE OF b-add IN FRAME Dialog-Frame
      737   DO:
      738    define variable v-rec as recid no-undo.
      739      run rul/rule-i.w ( input parparentproc
      740                          ,input 'ДОБАВЛЕНИЕ':U
      741                          ,input 0
      742                          ,input-output v-rec) no-error.
      743     if v-rec <> ? then do:
      744       RUN openbr IN THIS-PROCEDURE ( input yes, input no, input '':U).
      745       REPOSITION br-rule TO RECID v-rec NO-ERROR.
      746       APPLY "value-changed" to br-rule.
      747     end.
      748   END.
      749   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
      750   DO:
      751     define variable v-rec as recid no-undo.
      752     if not available X_rule then return no-apply.
      753     v-rec = recid(X_rule).
      754     run rul/rule-i.w ( input parparentproc
      755                          ,input ('ИЗМЕНЕНИЕ':U + chr(44) + (if lookup("b-add", bttns) > 0 then "yes" else "no"))
      756                          ,input X_rule.rule_id
      757                          ,input-output v-rec) no-error.
      758     if v-rec <> ? then do:
      759        br-rule:refresh().
      760     end.
      761     APPLY "entry" to br-rule.
      762     APPLY "VALUE-CHANGED" to br-rule.
      763   END.
      764   ON CHOOSE OF b-cmp IN FRAME Dialog-Frame
      765   DO:
      766     DEFINE variable v-rec as recid no-undo.
      767     if cmp-option = '':U then do:
      768       run gbl/pop-up.p ( input self :handle, input no ) no-error.
      769       if error-status:error then do: return no-apply. end.
      770       if cmp-option = '':U then return no-apply.
      771       run proc-b-cmp in this-procedure ( input cmp-option) no-error.
      772       if error-status:error then do:
      773         cmp-option = '':U.
      774         return no-apply.
      775       end.
      776       cmp-option = '':U.
      777     end.
      778   END.
      779   ON CHOOSE OF B-copy IN FRAME Dialog-Frame
      780   DO:
      781   DEFINE VARIABLE v-new-rule-id AS INTEGER NO-UNDO.
      782   DEFINE VARIABLE v-rec AS recid NO-UNDO.
      783   DEFINE BUFFER buf_rule FOR ub.RULE.
      784   if not available X_rule then return no-apply.
      785   run rul/rule5.p ( input X_rule.rule_id
      786                    ,OUTPUT v-new-rule-id) NO-ERROR.
      787   if v-new-rule-id <> 0 then do:
      788      MESSAGE
      789      substitute("В результате копирования появилось новое правило &1", v-new-rule-id)
      790      VIEW-AS ALERT-BOX.
      791      FIND FIRST buf_rule NO-LOCK WHERE
      792               buf_rule.RULE_id = v-new-rule-id .
      793      v-rec = recid(buf_rule).
      794      RUN openbr IN THIS-PROCEDURE ( input yes, input no, input '':U).
      795      REPOSITION br-rule TO RECID v-rec NO-ERROR.
      796      APPLY "value-changed" to br-rule.
      797   end.
      798   END.
      799   ON CHOOSE OF b-del IN FRAME Dialog-Frame
      800   DO:
      801     define variable v-rec as recid no-undo.
      802     define variable glog as logical no-undo.
      803     if not available X_rule then return no-apply.
      804     v-rec = recid(X_rule).
      805     message "Вы уверены, что хотите удалить Правило?"
      806     view-as alert-box question buttons yes-no update glog.
      807     if not glog then return no-apply.
      808    run rul/rule3.p ( input no
      809                          ,input v-rec) no-error.
      810    if error-status:error then return no-apply.
      811    run Openbr in this-procedure ( input yes, input no, input '':U).
      812   END.
      813   ON CHOOSE OF b-links IN FRAME Dialog-Frame
      814   DO:
      815     define variable v-rec as recid no-undo.
      816     if not available X_rule then return no-apply.
      817     IF link-option = '':U THEN DO:
      818       run gbl/pop-up.p ( INPUT SELF :handle, input no ) no-error.
      819       if error-status :error then do: return no-apply. end.
      820     end.
      821     if link-option = "":U then do:
      822         return no-apply.
      823     end.
      824     run proc-b-link IN THIS-PROCEDURE ( INPUT link-option) NO-ERROR.
      825     IF ERROR-STATUS:ERROR  THEN DO:
      826        link-option = ''.
      827        RETURN NO-APPLY.
      828     END.
      829   END.
      830   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
      831   DO:
      832     define variable v-rec as recid no-undo.
      833     if not available X_rule then return no-apply.
      834     if lkp-option = '':U then do:
      835       run gbl/pop-up.p ( input self :handle, input no ) no-error.
      836       if error-status:error then do: return no-apply. end.
      837       if lkp-option = '':U then return no-apply.
      838       run proc-b-lkp in this-procedure ( input lkp-option) no-error.
      839       if error-status:error then do:
      840         lkp-option = '':U.
      841         return no-apply.
      842       end.
      843       lkp-option = '':U.
      844     end.
      845   END.
      846   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
      847   DO:
      848     define variable glog as logical no-undo .
      849     if available X_rule then do:
      850   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      851   define variable v-str-recid8 as character no-undo .
      852   define variable v-num-entry8 as integer   no-undo .
      853   assign
      854     v-str-recid8 = trim( string( recid( X_rule ) , "->>>>>>>>>>>9":U ) )
      855     v-num-entry8 = lookup( v-str-recid8 , v-rid-list )
      856   .
      857   if v-num-entry8 > 0 then do:
      858     assign
      859       entry( v-num-entry8, v-rid-list ) = "":U
      860       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
      861     .
      862   end.
      863   else do:
      864     assign
      865       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid8
      866     .
      867   end.
      868     glog = br-rule:refresh() .
      869     if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
      870         glog = br-rule:select-next-row ().
      871         apply "VALUE-CHANGED" to br-rule in frame Dialog-Frame.
      872     end.
      873     if num-entries( v-rid-list ) = 0
      874     then
      875         hide mark-num in frame Dialog-Frame.
      876     else
      877         disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
      878   end.
      879   apply "entry" to br-rule in frame Dialog-Frame.
      880   END.
      881   ON CHOOSE OF b-replace IN FRAME Dialog-Frame
      882   DO:
      883     IF NOT AVAILABLE X_rule THEN RETURN NO-APPLY.
      884     RUN proc-b-replace IN THIS-PROCEDURE NO-ERROR.
      885     IF ERROR-STATUS:ERROR THEN DO:
      886         RETURN NO-APPLY.
      887     END.
      888   END.
      889   ON CHOOSE OF b-sch IN FRAME Dialog-Frame
      890   DO:
      891     RUN proc-b-sch IN THIS-PROCEDURE NO-ERROR.
      892     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      893   END.
      894   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
      895   DO:
      896     if available X_rule then do:
      897       if  ( v-rid-list = "" ) or b-mark:sensitive = no
      898       then  v-rid-list = string( recid( X_rule ) ) .
      899     end.
      900   END.
      901   ON CHOOSE OF b-status IN FRAME Dialog-Frame
      902   DO:
      903   DEFINE VARIABLE v-rec AS RECID NO-UNDO.
      904   IF NOT AVAILABLE X_rule THEN RETURN NO-APPLY.
      905   IF status-option = ? THEN DO:
      906       run gbl/pop-up.p ( INPUT SELF :handle, input no ) no-error.
      907       if error-status :error then do: return no-apply. end.
      908     end.
      909     if status-option = ? then do:
      910         return no-apply.
      911     end.
      912     run proc-b-link IN THIS-PROCEDURE ( INPUT link-option) NO-ERROR.
      913     IF ERROR-STATUS:ERROR THEN DO:
      914         status-option = ?.
      915         RETURN NO-APPLY.
      916     END.
      917   END.
      918   ON VALUE-CHANGED OF br-rule IN FRAME Dialog-Frame
      919   DO:
      920     IF AVAILABLE X_rule THEN DO:
      921       editor-1:SCREEN-VALUE = X_rule.documentation.
      922     END.
      923     ELSE DO:
      924       editor-1:SCREEN-VALUE = '':U.
      925     END.
      926   END.
      927   ON CHOOSE OF MENU-ITEM m_-1
      928   DO:
      929     ASSIGN
      930     status-option = -1.
      931     RUN proc-b-status IN THIS-PROCEDURE ( INPUT status-option) NO-ERROR.
      932     IF ERROR-STATUS:ERROR THEN DO:
      933         status-option = ?.
      934         RETURN NO-APPLY.
      935     END.
      936   END.
      937   ON CHOOSE OF MENU-ITEM m_-10
      938   DO:
      939       ASSIGN
      940     status-option = -10.
      941     RUN proc-b-status IN THIS-PROCEDURE ( INPUT status-option) NO-ERROR.
      942     IF ERROR-STATUS:ERROR THEN DO:
      943         status-option = ?.
      944         RETURN NO-APPLY.
      945     END.
      946   END.
      947   ON CHOOSE OF MENU-ITEM m_98
      948   DO:
      949       ASSIGN
      950     status-option = 98.
      951     RUN proc-b-status IN THIS-PROCEDURE ( INPUT status-option) NO-ERROR.
      952     IF ERROR-STATUS:ERROR THEN DO:
      953         status-option = ?.
      954         RETURN NO-APPLY.
      955     END.
      956   END.
      957   ON CHOOSE OF MENU-ITEM m_codex
      958   DO:
      959       ASSIGN
      960     cmp-option = "codex".
      961     run proc-b-cmp IN THIS-PROCEDURE ( INPUT cmp-option) NO-ERROR.
      962     ASSIGN
      963     cmp-option = '':U.
      964     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      965   END.
      966   ON CHOOSE OF MENU-ITEM m_graph
      967   DO:
      968     ASSIGN
      969     lkp-option = "graph".
      970     run proc-b-lkp IN THIS-PROCEDURE ( INPUT lkp-option) NO-ERROR.
      971     ASSIGN
      972     lkp-option = '':U.
      973     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      974   END.
      975   ON CHOOSE OF MENU-ITEM m_list
      976   DO:
      977       ASSIGN
      978      cmp-option = "list".
      979      run proc-b-cmp IN THIS-PROCEDURE ( INPUT cmp-option) NO-ERROR.
      980      ASSIGN
      981      cmp-option = '':U.
      982      IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      983   END.
      984   ON CHOOSE OF MENU-ITEM m_one
      985   DO:
      986       ASSIGN
      987     cmp-option = "one".
      988     run proc-b-cmp IN THIS-PROCEDURE ( INPUT cmp-option) NO-ERROR.
      989     ASSIGN
      990     cmp-option = '':U.
      991     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      992   END.
      993   ON CHOOSE OF MENU-ITEM m_rule-by-call
      994   DO:
      995      ASSIGN
      996     link-option = 'rule-by-call':U.
      997     run proc-b-link IN THIS-PROCEDURE ( INPUT link-option) NO-ERROR.
      998     ASSIGN
      999     link-option = '':U.
     1000     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1001   END.
     1002   ON CHOOSE OF MENU-ITEM m_rule-call-param
     1003   DO:
     1004       ASSIGN
     1005     link-option = 'rule-call-param':U.
     1006     run proc-b-link IN THIS-PROCEDURE ( INPUT link-option) NO-ERROR.
     1007     ASSIGN
     1008     link-option = '':U.
     1009     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1010   END.
     1011   ON CHOOSE OF MENU-ITEM m_rule-i-script
     1012   DO:
     1013       ASSIGN
     1014     link-option = 'rule-i-script':U.
     1015     run proc-b-link IN THIS-PROCEDURE ( INPUT link-option) NO-ERROR.
     1016     ASSIGN
     1017     link-option = '':U.
     1018     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1019   END.
     1020   ON CHOOSE OF MENU-ITEM m_rule-profile
     1021   in menu menu-b-link
     1022   DO:
     1023       ASSIGN
     1024     link-option = 'rule-by-profile':U.
     1025     run proc-b-link IN THIS-PROCEDURE ( INPUT link-option) NO-ERROR.
     1026     ASSIGN
     1027     link-option = '':U.
     1028     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1029   END.
     1030   ON CHOOSE OF MENU-ITEM m_rule-profile
     1031   in menu menu-b-cmp
     1032   DO:
     1033       ASSIGN
     1034      cmp-option = "rule-profile".
     1035      run proc-b-cmp IN THIS-PROCEDURE ( INPUT cmp-option) NO-ERROR.
     1036      ASSIGN
     1037      cmp-option = '':U.
     1038      IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1039   END.
     1040   ON CHOOSE OF MENU-ITEM m_ruledict-param
     1041   DO:
     1042       ASSIGN
     1043     link-option = 'ruledict-param':U.
     1044     run proc-b-link IN THIS-PROCEDURE ( INPUT link-option) NO-ERROR.
     1045     ASSIGN
     1046     link-option = '':U.
     1047     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1048   END.
     1049   ON CHOOSE OF MENU-ITEM m_ruleset
     1050   DO:
     1051       ASSIGN
     1052     link-option = 'ruleset':U.
     1053     run proc-b-link IN THIS-PROCEDURE ( INPUT link-option) NO-ERROR.
     1054     ASSIGN
     1055     link-option = '':U.
     1056     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1057   END.
     1058   ON CHOOSE OF MENU-ITEM m_simple
     1059   DO:
     1060       ASSIGN
     1061      lkp-option = "simple".
     1062      run proc-b-lkp IN THIS-PROCEDURE ( INPUT lkp-option) NO-ERROR.
     1063      ASSIGN
     1064      lkp-option = '':U.
     1065      IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1066   END.
     1067   ON CHOOSE OF MENU-ITEM m_text
     1068   DO:
     1069     ASSIGN
     1070     lkp-option = "text".
     1071     run proc-b-lkp IN THIS-PROCEDURE ( INPUT lkp-option) NO-ERROR.
     1072     ASSIGN
     1073     lkp-option = '':U.
     1074     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1075   END.
     1076   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1077   on f5 of frame Dialog-Frame anywhere
     1078   do:
     1079      v-doc-rec = recid(X_rule).    run OpenBR in this-procedure ( input yes, input no, input '':U).  REPOSITION br-rule to recid v-doc-rec No-ERROR.   apply 'value-changed' to br-rule.
     1080       apply "VALUE-CHANGED" to br-rule.
     1081   end.
     1082   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1083   procedure set-filter-name :
     1084   define input parameter p-filter-name as character no-undo .
     1085     do with frame Dialog-Frame:
     1086       if p-filter-name > "" then do:
     1087         assign
     1088           frame Dialog-Frame:title
     1089             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     1090         .
     1091         assign
     1092           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     1093         .
     1094       end.
     1095       else do:
     1096         assign
     1097           b-sch :tooltip = ""
     1098         .
     1099       end.
     1100     end.
     1101   end procedure.
     1102   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1103   on help of frame Dialog-Frame
     1104   do:
     1105     run gbl/app_help.p
     1106       (input this-procedure :file-name
     1107       ,input ''
     1108       ,input ?
     1109       ) no-error.
     1110     if error-status :error then do:
     1111       message
     1112         "Ошибка при вызове помощи"
     1113         error-status :get-message(1)
     1114         view-as alert-box .
     1115     end.
     1116   end.
     1117   run minbtn-set in this-procedure .
     1118   on choose of b-help in frame Dialog-Frame
     1119   do:
     1120     apply "help":u to frame Dialog-Frame .
     1121   end.
     1122   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1123   procedure minbtn-set :
     1124       do
     1125           on error undo, return error return-value
     1126           :
     1127           define variable ii              as integer       no-undo .
     1128           define variable fh              as widget-handle no-undo .
     1129           define variable hh              as widget-handle no-undo .
     1130           define variable v-h             as handle        extent 4 no-undo .
     1131           define variable v-name-button   as character     no-undo .
     1132           define variable v-help-old-x    as decimal       no-undo .
     1133           define variable v-help-old-y    as decimal       no-undo .
     1134           define variable v-help-old-size as decimal       no-undo .
     1135           define variable v-frame-width   as decimal       no-undo .
     1136           define variable jj              as integer       no-undo .
     1137           do
     1138               on error undo, return error
     1139               :
     1140               assign
     1141                   v-frame-width = frame Dialog-Frame:width - 0.3
     1142                   fh            = frame Dialog-Frame:first-child
     1143                   hh            = fh:first-child
     1144                   ii            = 1
     1145                   .
     1146               do while valid-handle(hh):
     1147                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1148                   do:
     1149                       case lc(hh:name) :
     1150                           when "b-help" then
     1151                               do:
     1152                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1153                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1154                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1155                                   hh:TOOLTIP = "Помощь" .
     1156                                   v-help-old-x = hh:column .
     1157                                   v-help-old-y = hh:row    .
     1158                                   v-help-old-size = hh:width .
     1159                                   hh:width-chars = 2.5 .
     1160                               end.
     1161                           when "b-print" then
     1162                               do:
     1163                                   hh:load-image("cmp/b-print.bmp":u) .
     1164                                   hh:TOOLTIP = "Печать" .
     1165                                   v-h[ii] = hh:handle .
     1166                                   ii = ii + 1 .
     1167                                   hh:width-chars = 3 .
     1168                               end.
     1169                           when "b-history" or
     1170                           when "b-hist" then
     1171                               do:
     1172                                   hh:load-image("cmp/b-hist.bmp":u) .
     1173                                   hh:TOOLTIP = "История" .
     1174                                   v-h[ii] = hh:handle .
     1175                                   ii = ii + 1 .
     1176                                   hh:width-chars = 3 .
     1177                               end.
     1178                           when "b-sch" then
     1179                               do:
     1180                                   hh:load-image("cmp/b-sch.bmp":u) .
     1181                                   hh:TOOLTIP = "Установка Фильтра" .
     1182                                   v-h[ii] = hh:handle .
     1183                                   ii = ii + 1 .
     1184                                   hh:width-chars = 3 .
     1185                               end.
     1186                           when "b-hist-user" then
     1187                               do:
     1188                                   hh:load-image("cmp/b-hist.bmp":u) .
     1189                                   hh:TOOLTIP = "История пользователя" .
     1190                                   ii = ii + 1 .
     1191                               end.
     1192                       end case.
     1193                   end.
     1194                   hh = hh:next-sibling.
     1195               end.
     1196               b-help:column = v-frame-width - b-help:width-chars.
     1197               jj = 0.
     1198               repeat ii = 4 to 1 by -1 :
     1199                   if valid-handle (v-h[ii] ) then
     1200                   do:
     1201                       jj  = jj + 1 .
     1202                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1203                       v-h[ii]:row    = v-help-old-y .
     1204                   end.
     1205               end.
     1206           end.
     1207       end.
     1208   end procedure.
     1209   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1210   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1211   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1212   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1213   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1214   define variable v-diasize-current-frame-height as decimal   no-undo .
     1215   define variable v-diasize-change-size          as logical   no-undo .
     1216   define variable v-diasize-resize-button        as handle    no-undo .
     1217   define variable v-diasize-wndmax               as logical   no-undo .
     1218   define variable v-diasize-wndstore             as logical   no-undo .
     1219   define variable v-diasize-proc-name            as character no-undo .
     1220   define variable v-diasize-browse-handle        as handle    no-undo .
     1221   define variable v-diasize-browse-number        as integer   no-undo .
     1222   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1223   define temp-table temp-diasize-handle no-undo
     1224     field handle-value  as handle
     1225     field save-position as decimal
     1226     index xpk is primary unique handle-value
     1227     .
     1228   define temp-table temp-browse-handle no-undo
     1229     field browse-type   as character
     1230     field browse-number as integer
     1231     field browse-handle as handle
     1232     field original-size as decimal
     1233     index xpk is primary unique browse-type browse-number
     1234     index xie browse-type browse-handle
     1235   .
     1236   procedure diasize_change-height :
     1237     define input  parameter p-change-value  as decimal   no-undo .
     1238     define input  parameter p-move-resize   as logical   no-undo .
     1239     define variable v-field-group-handle    as handle    no-undo .
     1240     define variable v-object-handle         as handle    no-undo .
     1241     define variable v-frame-height          as decimal   no-undo .
     1242     define variable v-frame-virtual-height  as decimal   no-undo .
     1243     define variable v-browse-height         as decimal   no-undo .
     1244     define variable v-window-height         as decimal   no-undo .
     1245     define variable v-window-virtual-height as decimal   no-undo .
     1246     define variable v-change-sign           as integer   no-undo .
     1247     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1248     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1249     if p-change-value > 0
     1250     then do:
     1251       if frame Dialog-Frame :height + p-change-value
     1252           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1253       then do:
     1254         assign
     1255           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1256                           - (frame Dialog-Frame :height-chars)
     1257         .
     1258         if p-change-value <= 0
     1259         then do:
     1260           run diasize_position-resize-button in this-procedure .
     1261           return .
     1262         end.
     1263       end.
     1264     end.
     1265     if p-change-value < 0
     1266     then do:
     1267       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1268       then do:
     1269         assign
     1270           p-change-value = v-diasize-orig-frame-height
     1271                          - (frame Dialog-Frame :height-chars)
     1272         .
     1273         if p-change-value >= 0
     1274         then do:
     1275           run diasize_position-resize-button in this-procedure .
     1276           return .
     1277         end.
     1278       end.
     1279     end.
     1280     if p-change-value >= 0
     1281     then do:
     1282       assign
     1283         v-change-sign = 1
     1284       .
     1285     end.
     1286     else do:
     1287       assign
     1288         v-change-sign = -1
     1289       .
     1290     end.
     1291     assign
     1292       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1293     .
     1294     if p-change-value = 0
     1295     then do:
     1296       run diasize_position-resize-button in this-procedure .
     1297       return .
     1298     end.
     1299     move_block:
     1300     do
     1301     on error undo move_block, retry move_block
     1302     :
     1303       if retry
     1304       then do:
     1305         do
     1306         on error undo move_block, leave move_block
     1307         :
     1308           if p-change-value > 0
     1309           then do:
     1310             for each buf_temp-diasize-handle
     1311             on error undo, next
     1312             :
     1313               assign
     1314                 v-object-handle = buf_temp-diasize-handle.handle-value
     1315               .
     1316               if v-object-handle <> v-diasize-resize-button
     1317               then do:
     1318                 assign
     1319                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1320                 .
     1321               end.
     1322             end.
     1323             assign
     1324               v-diasize-browse-handle :height = v-browse-height
     1325             .
     1326             for each buf_temp-browse-handle
     1327               where buf_temp-browse-handle.browse-type = 'height':u
     1328             on error undo, next
     1329             :
     1330               assign
     1331                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1332               .
     1333             end.
     1334             assign
     1335               frame Dialog-Frame :height = v-frame-height
     1336             .
     1337             if frame Dialog-Frame :scrollable = true
     1338             then do:
     1339               assign
     1340                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1341               .
     1342             end.
     1343             run diasize_position-resize-button in this-procedure .
     1344           end.
     1345           else do:
     1346             if frame Dialog-Frame :scrollable = true
     1347             then do:
     1348               assign
     1349                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1350               .
     1351             end.
     1352             assign
     1353               frame Dialog-Frame :height = v-frame-height
     1354             .
     1355             assign
     1356               v-diasize-browse-handle :height = v-browse-height
     1357             .
     1358             for each buf_temp-browse-handle
     1359               where buf_temp-browse-handle.browse-type = 'height':u
     1360             on error undo, next
     1361             :
     1362               assign
     1363                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1364               .
     1365             end.
     1366             for each buf_temp-diasize-handle
     1367             on error undo, next
     1368             :
     1369               assign
     1370                 v-object-handle = buf_temp-diasize-handle.handle-value
     1371               .
     1372               if v-object-handle <> v-diasize-resize-button
     1373               then do:
     1374                 assign
     1375                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1376                 .
     1377               end.
     1378             end.
     1379             run diasize_position-resize-button in this-procedure .
     1380           end.
     1381           assign
     1382             v-diasize-change-size = false
     1383           .
     1384           leave move_block .
     1385         end.
     1386       end.
     1387       assign
     1388         v-diasize-need-full-display = true
     1389       .
     1390       if v-diasize-change-size = false
     1391       then do:
     1392         assign
     1393           v-diasize-change-size = true
     1394         .
     1395       end.
     1396       else do:
     1397         return .
     1398       end.
     1399       assign
     1400         v-frame-height = frame Dialog-Frame :height
     1401         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1402         v-browse-height = v-diasize-browse-handle :height
     1403       .
     1404       for each buf_temp-browse-handle
     1405         where buf_temp-browse-handle.browse-type = 'height':u
     1406       :
     1407         assign
     1408           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1409         .
     1410       end.
     1411       for each buf_temp-diasize-handle
     1412       :
     1413         delete buf_temp-diasize-handle .
     1414       end.
     1415       assign
     1416         v-field-group-handle = frame Dialog-Frame :first-child
     1417       .
     1418       do while valid-handle(v-field-group-handle)
     1419       :
     1420         assign
     1421           v-object-handle = v-field-group-handle :first-child
     1422         .
     1423         do while valid-handle(v-object-handle)
     1424         :
     1425           if  v-object-handle <> v-diasize-browse-handle :handle
     1426           and can-query(v-object-handle, "row")
     1427           and can-query(v-object-handle, "height")
     1428           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1429           then do:
     1430             find first buf_temp-browse-handle
     1431               where buf_temp-browse-handle.browse-type   = 'height':u
     1432                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1433               no-error .
     1434             if available buf_temp-browse-handle
     1435             then do:
     1436             end.
     1437             else do:
     1438               create buf_temp-diasize-handle .
     1439               assign
     1440                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1441                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1442               .
     1443             end.
     1444           end.
     1445           assign
     1446             v-object-handle = v-object-handle :next-sibling
     1447           .
     1448         end.
     1449         assign
     1450           v-field-group-handle = v-field-group-handle :next-sibling
     1451         .
     1452       end.
     1453       do with frame Dialog-Frame
     1454       :
     1455         hide v-diasize-resize-button .
     1456         assign
     1457           v-diasize-resize-button :row    = 1
     1458           v-diasize-resize-button :column = 1
     1459         .
     1460       end.
     1461       if p-change-value > 0
     1462       then do:
     1463         if frame Dialog-Frame :scrollable = true
     1464         then do:
     1465           assign
     1466             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1467             no-error .
     1468           if error-status :error
     1469           or error-status :get-message(1) <> ""
     1470           then do:
     1471             undo move_block, retry move_block .
     1472           end.
     1473         end.
     1474         assign
     1475           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1476           no-error .
     1477         if error-status :error
     1478         or error-status :get-message(1) <> ""
     1479         then do:
     1480           undo move_block, retry move_block .
     1481         end.
     1482         assign
     1483           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1484           no-error .
     1485         if error-status :error
     1486         or error-status :get-message(1) <> ""
     1487         then do:
     1488           undo move_block, retry move_block .
     1489         end.
     1490         for each buf_temp-browse-handle
     1491           where buf_temp-browse-handle.browse-type = 'height':u
     1492         on error undo move_block, retry move_block
     1493         :
     1494           assign
     1495             buf_temp-browse-handle.browse-handle :height
     1496               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1497             no-error .
     1498           if error-status :error
     1499           or error-status :get-message(1) <> ""
     1500           then do:
     1501             undo move_block, retry move_block .
     1502           end.
     1503         end.
     1504         for each buf_temp-diasize-handle
     1505         on error undo move_block, retry move_block
     1506         :
     1507           assign
     1508             v-object-handle = buf_temp-diasize-handle.handle-value
     1509           .
     1510           if v-object-handle <> v-diasize-resize-button
     1511           then do:
     1512             assign
     1513               v-object-handle :row = v-object-handle :row + p-change-value
     1514               no-error .
     1515             if error-status :error
     1516             or error-status :get-message(1) <> ""
     1517             then do:
     1518               undo move_block, retry move_block .
     1519             end.
     1520           end.
     1521         end.
     1522       end.
     1523       else do:
     1524         for each buf_temp-diasize-handle
     1525         on error undo move_block, retry move_block
     1526         :
     1527           assign
     1528             v-object-handle = buf_temp-diasize-handle.handle-value
     1529           .
     1530           if v-object-handle <> v-diasize-resize-button
     1531           then do:
     1532             assign
     1533               v-object-handle :row = v-object-handle :row + p-change-value
     1534               no-error .
     1535             if error-status :error
     1536             or error-status :get-message(1) <> ""
     1537             then do:
     1538               undo move_block, retry move_block .
     1539             end.
     1540           end.
     1541         end.
     1542         assign
     1543           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1544           no-error .
     1545         if error-status :error
     1546         or error-status :get-message(1) <> ""
     1547         then do:
     1548           undo move_block, retry move_block .
     1549         end.
     1550         for each buf_temp-browse-handle
     1551           where buf_temp-browse-handle.browse-type = 'height':u
     1552         on error undo move_block, retry move_block
     1553         :
     1554           assign
     1555             buf_temp-browse-handle.browse-handle :height
     1556               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1557             no-error .
     1558           if error-status :error
     1559           or error-status :get-message(1) <> ""
     1560           then do:
     1561             undo move_block, retry move_block .
     1562           end.
     1563         end.
     1564         assign
     1565           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1566           no-error .
     1567         if error-status :error
     1568         or error-status :get-message(1) <> ""
     1569         then do:
     1570           undo move_block, retry move_block .
     1571         end.
     1572         if frame Dialog-Frame :scrollable = true
     1573         then do:
     1574           assign
     1575             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1576             no-error .
     1577           if error-status :error
     1578           or error-status :get-message(1) <> ""
     1579           then do:
     1580             undo move_block, retry move_block .
     1581           end.
     1582         end.
     1583       end.
     1584       if p-move-resize = true
     1585       then do:
     1586         run diasize_position-resize-button in this-procedure .
     1587       end.
     1588       if v-diasize-wndstore = true
     1589       then do:
     1590         if connected("ub") = true
     1591         then do:
     1592           define variable v-cntxt-db-num        as integer   no-undo .
     1593           define variable v-cntxt-userid        as character no-undo .
     1594           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1595                                             , OUTPUT v-cntxt-userid
     1596                                             ) .
     1597           run gbl/wndsizew.p
     1598             (input  v-cntxt-db-num
     1599             ,input  v-cntxt-userid
     1600             ,input  v-diasize-proc-name
     1601             ,input  'height':u
     1602             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1603             ) .
     1604         end.
     1605       end.
     1606     end.
     1607     assign
     1608       v-diasize-change-size = false
     1609     .
     1610   end procedure.
     1611   procedure diasize_set-height :
     1612     define input  parameter p-new-height  as decimal   no-undo .
     1613     define input  parameter p-move-resize as logical   no-undo .
     1614     do
     1615     on error undo, return error return-value
     1616     :
     1617       run diasize_change-height in this-procedure
     1618         (input  (p-new-height - frame Dialog-Frame :height)
     1619         ,input  p-move-resize
     1620         ) .
     1621     end.
     1622   end procedure.
     1623   procedure diasize_change-width :
     1624     define input  parameter p-change-value as decimal   no-undo .
     1625     define input  parameter p-move-resize  as logical   no-undo .
     1626     define variable v-field-group-handle   as handle    no-undo .
     1627     define variable v-object-handle        as handle    no-undo .
     1628     define variable v-frame-width          as decimal   no-undo .
     1629     define variable v-frame-virtual-width  as decimal   no-undo .
     1630     define variable v-browse-width         as decimal   no-undo .
     1631     define variable v-window-width         as decimal   no-undo .
     1632     define variable v-window-virtual-width as decimal   no-undo .
     1633     define variable v-change-sign          as integer   no-undo .
     1634     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1635     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1636     if p-change-value > 0
     1637     then do:
     1638       if frame Dialog-Frame :width + p-change-value >
     1639           session :width-chars
     1640       then do:
     1641         assign
     1642           p-change-value = session :width-chars - frame Dialog-Frame :width
     1643         .
     1644         if p-change-value <= 0
     1645         then do:
     1646           run diasize_position-resize-button in this-procedure .
     1647           return .
     1648         end.
     1649       end.
     1650     end.
     1651     if p-change-value < 0
     1652     then do:
     1653       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1654       then do:
     1655         assign
     1656           p-change-value = v-diasize-orig-frame-width
     1657                          - frame Dialog-Frame :width
     1658         .
     1659         if p-change-value >= 0
     1660         then do:
     1661           run diasize_position-resize-button in this-procedure .
     1662           return .
     1663         end.
     1664       end.
     1665     end.
     1666     if p-change-value >= 0
     1667     then do:
     1668       assign
     1669         v-change-sign = 1
     1670       .
     1671     end.
     1672     else do:
     1673       assign
     1674         v-change-sign = -1
     1675       .
     1676     end.
     1677     assign
     1678       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1679     .
     1680     if p-change-value = 0
     1681     then do:
     1682       run diasize_position-resize-button in this-procedure .
     1683       return .
     1684     end.
     1685     move_block:
     1686     do
     1687     on error undo move_block, leave move_block
     1688     :
     1689       if retry
     1690       then do:
     1691         do
     1692         on error undo move_block, leave move_block
     1693         :
     1694           if p-change-value > 0
     1695           then do:
     1696             for each buf_temp-diasize-handle
     1697             on error undo, next
     1698             :
     1699               assign
     1700                 v-object-handle = buf_temp-diasize-handle.handle-value
     1701               .
     1702               if v-object-handle <> v-diasize-resize-button
     1703               then do:
     1704                 assign
     1705                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1706                 .
     1707               end.
     1708             end.
     1709             assign
     1710               v-diasize-browse-handle :width = v-browse-width
     1711             .
     1712             for each buf_temp-browse-handle
     1713               where buf_temp-browse-handle.browse-type = 'width':u
     1714             on error undo, next
     1715             :
     1716               assign
     1717                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1718               .
     1719             end.
     1720             assign
     1721               frame Dialog-Frame :width = v-frame-width
     1722             .
     1723             if frame Dialog-Frame :scrollable = true
     1724             then do:
     1725               assign
     1726                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1727               .
     1728             end.
     1729             run diasize_position-resize-button in this-procedure .
     1730           end.
     1731           else do:
     1732             if frame Dialog-Frame :scrollable = true
     1733             then do:
     1734               assign
     1735                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1736               .
     1737             end.
     1738             assign
     1739               frame Dialog-Frame :width = v-frame-width
     1740             .
     1741             for each buf_temp-browse-handle
     1742               where buf_temp-browse-handle.browse-type = 'width':u
     1743             on error undo, next
     1744             :
     1745               assign
     1746                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1747               .
     1748             end.
     1749             assign
     1750               v-diasize-browse-handle :width = v-browse-width
     1751             .
     1752             for each buf_temp-diasize-handle
     1753             on error undo, next
     1754             :
     1755               assign
     1756                 v-object-handle = buf_temp-diasize-handle.handle-value
     1757               .
     1758               if v-object-handle <> v-diasize-resize-button
     1759               then do:
     1760                 assign
     1761                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1762                 .
     1763               end.
     1764             end.
     1765             run diasize_position-resize-button in this-procedure .
     1766           end.
     1767           assign
     1768             v-diasize-change-size = false
     1769           .
     1770           leave move_block .
     1771         end.
     1772       end.
     1773       assign
     1774         v-diasize-need-full-display = true
     1775       .
     1776       if v-diasize-change-size = false
     1777       then do:
     1778         assign
     1779           v-diasize-change-size = true
     1780         .
     1781       end.
     1782       else do:
     1783         return .
     1784       end.
     1785       assign
     1786         v-frame-width = frame Dialog-Frame :width
     1787         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1788         v-browse-width = v-diasize-browse-handle :width
     1789       .
     1790       for each buf_temp-browse-handle
     1791         where buf_temp-browse-handle.browse-type = 'width':u
     1792       :
     1793         assign
     1794           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1795         .
     1796       end.
     1797       for each buf_temp-diasize-handle
     1798       :
     1799         delete buf_temp-diasize-handle .
     1800       end.
     1801       assign
     1802         v-field-group-handle = frame Dialog-Frame :first-child
     1803       .
     1804       do while valid-handle(v-field-group-handle)
     1805       :
     1806         assign
     1807           v-object-handle = v-field-group-handle :first-child
     1808         .
     1809         do while valid-handle(v-object-handle)
     1810         :
     1811           if  v-object-handle <> v-diasize-browse-handle :handle
     1812           and v-object-handle <> v-diasize-resize-button
     1813           and can-query(v-object-handle, "row")
     1814           and can-query(v-object-handle, "height")
     1815           and ( v-object-handle :col + v-object-handle :width
     1816                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1817               )
     1818           then do:
     1819             find first buf_temp-browse-handle
     1820               where buf_temp-browse-handle.browse-type   = 'width':u
     1821                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1822               no-error .
     1823             if available buf_temp-browse-handle
     1824             then do:
     1825             end.
     1826             else do:
     1827               create buf_temp-diasize-handle .
     1828               assign
     1829                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1830                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1831               .
     1832             end.
     1833           end.
     1834           assign
     1835             v-object-handle = v-object-handle :next-sibling
     1836           .
     1837         end.
     1838         assign
     1839           v-field-group-handle = v-field-group-handle :next-sibling
     1840         .
     1841       end.
     1842       do with frame Dialog-Frame
     1843       :
     1844         hide v-diasize-resize-button .
     1845         v-diasize-resize-button :row = 1.
     1846         v-diasize-resize-button :column = 1.
     1847       end.
     1848       if p-change-value > 0
     1849       then do:
     1850         if frame Dialog-Frame :scrollable = true
     1851         then do:
     1852           assign
     1853             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1854             no-error .
     1855           if error-status :error
     1856           or error-status :get-message(1) <> ""
     1857           then do:
     1858             undo move_block, retry move_block.
     1859           end.
     1860         end.
     1861         assign
     1862           frame Dialog-Frame :width = v-frame-width + p-change-value
     1863           no-error .
     1864         if error-status :error
     1865         or error-status :get-message(1) <> ""
     1866         then do:
     1867           undo move_block, retry move_block.
     1868         end.
     1869         assign
     1870           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1871         no-error .
     1872         if error-status :error
     1873         or error-status :get-message(1) <> ""
     1874         then do:
     1875           undo move_block, retry move_block.
     1876         end.
     1877         for each buf_temp-browse-handle
     1878           where buf_temp-browse-handle.browse-type = 'width':u
     1879         on error undo move_block, retry move_block
     1880         :
     1881           assign
     1882             buf_temp-browse-handle.browse-handle :width
     1883               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1884             no-error .
     1885           if error-status :error
     1886           or error-status :get-message(1) <> ""
     1887           then do:
     1888             undo move_block, retry move_block .
     1889           end.
     1890         end.
     1891         for each buf_temp-diasize-handle
     1892         on error undo move_block, retry move_block
     1893         :
     1894           assign
     1895             v-object-handle = buf_temp-diasize-handle.handle-value
     1896           .
     1897           if v-object-handle <> v-diasize-resize-button
     1898           then do:
     1899             assign
     1900               v-object-handle :col = v-object-handle :col + p-change-value
     1901               no-error .
     1902             if error-status :error
     1903             or error-status :get-message(1) <> ""
     1904             then do:
     1905               undo move_block, retry move_block .
     1906             end.
     1907           end.
     1908         end.
     1909       end.
     1910       else do:
     1911         for each buf_temp-diasize-handle
     1912         on error undo move_block, retry move_block
     1913         :
     1914           assign
     1915             v-object-handle = buf_temp-diasize-handle.handle-value
     1916           .
     1917           if v-object-handle <> v-diasize-resize-button
     1918           then do:
     1919             assign
     1920               v-object-handle :col = v-object-handle :col + p-change-value
     1921               no-error .
     1922             if error-status :error
     1923             or error-status :get-message(1) <> ""
     1924             then do:
     1925               undo move_block, retry move_block .
     1926             end.
     1927           end.
     1928         end.
     1929         for each buf_temp-browse-handle
     1930           where buf_temp-browse-handle.browse-type = 'width':u
     1931         on error undo move_block, retry move_block
     1932         :
     1933           assign
     1934             buf_temp-browse-handle.browse-handle :width
     1935               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1936             no-error .
     1937           if error-status :error
     1938           or error-status :get-message(1) <> ""
     1939           then do:
     1940             undo move_block, retry move_block .
     1941           end.
     1942         end.
     1943         assign
     1944           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1945           no-error .
     1946         if error-status :error
     1947         or error-status :get-message(1) <> ""
     1948         then do:
     1949           undo move_block, retry move_block.
     1950         end.
     1951         assign
     1952           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1953         no-error .
     1954         if error-status :error
     1955         or error-status :get-message(1) <> ""
     1956         then do:
     1957           undo move_block, retry move_block.
     1958         end.
     1959         if frame Dialog-Frame :scrollable = true
     1960         then do:
     1961           assign
     1962             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1963           no-error .
     1964           if error-status :error
     1965           or error-status :get-message(1) <> ""
     1966           then do:
     1967             undo move_block, retry move_block.
     1968           end.
     1969         end.
     1970       end.
     1971       if p-move-resize
     1972       then do:
     1973         run diasize_position-resize-button in this-procedure .
     1974       end.
     1975       if v-diasize-wndstore = true
     1976       then do:
     1977         if connected("ub") = true
     1978         then do:
     1979           define variable v-cntxt-db-num        as integer   no-undo .
     1980           define variable v-cntxt-userid        as character no-undo .
     1981           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1982                                             , OUTPUT v-cntxt-userid
     1983                                             ) .
     1984           run gbl/wndsizew.p
     1985             (input  v-cntxt-db-num
     1986             ,input  v-cntxt-userid
     1987             ,input  v-diasize-proc-name
     1988             ,input  'width':u
     1989             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1990             ) .
     1991         end.
     1992       end.
     1993     end.
     1994     assign
     1995       v-diasize-change-size = false
     1996     .
     1997   end procedure.
     1998   procedure diasize_set-width :
     1999     define input  parameter p-new-width  as decimal   no-undo .
     2000     define input  parameter p-move-resize as logical   no-undo .
     2001     do
     2002     on error undo, return error return-value
     2003     :
     2004       run diasize_change-width in this-procedure
     2005         (input  (p-new-width - frame Dialog-Frame :width)
     2006         ,input  p-move-resize
     2007         ) .
     2008     end.
     2009   end procedure.
     2010   procedure diasize_position-resize-button :
     2011     do with frame Dialog-Frame
     2012     :
     2013       hide v-diasize-resize-button .
     2014       assign
     2015         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2016                     - 1
     2017                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2018         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2019                     - 1
     2020                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2021       .
     2022       view v-diasize-resize-button .
     2023     end.
     2024   end procedure.
     2025   on alt-right anywhere
     2026   do:
     2027     run diasize_change-width in this-procedure
     2028       (input 1
     2029       ,input true
     2030       ) .
     2031     return no-apply .
     2032   end.
     2033   on alt-left anywhere
     2034   do:
     2035     run diasize_change-width in this-procedure
     2036       (input -1
     2037       ,input true
     2038       ) .
     2039     return no-apply .
     2040   end.
     2041   on alt-down anywhere
     2042   do:
     2043     run diasize_change-height in this-procedure
     2044       (input 1
     2045       ,input true
     2046       ) .
     2047     return no-apply .
     2048   end.
     2049   on alt-up anywhere
     2050   do:
     2051     run diasize_change-height in this-procedure
     2052       (input -1
     2053       ,input true
     2054       ) .
     2055     return no-apply .
     2056   end.
     2057   on alt-enter of frame Dialog-Frame
     2058   do:
     2059     run diasize_maximize in this-procedure
     2060       (input  ?
     2061       ).
     2062     return no-apply .
     2063   end.
     2064   procedure diasize_end-move :
     2065     do
     2066     on error undo, return error return-value
     2067     :
     2068       define variable v-row-delta as decimal   no-undo .
     2069       define variable v-col-delta as decimal   no-undo .
     2070       define variable v-new-row as decimal   no-undo .
     2071       define variable v-new-col as decimal   no-undo .
     2072       assign
     2073         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2074         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2075       .
     2076       assign
     2077         v-row-delta = v-new-row - frame Dialog-Frame :height
     2078         v-col-delta = v-new-col - frame Dialog-Frame :width
     2079       .
     2080       run diasize_change-height in this-procedure
     2081         (input v-row-delta
     2082         ,input true
     2083         ) .
     2084       run diasize_change-width in this-procedure
     2085         (input v-col-delta
     2086         ,input true
     2087         ) .
     2088     end.
     2089   end procedure.
     2090   procedure diasize_maximize :
     2091     define input  parameter p-action as logical   no-undo .
     2092     do
     2093     on error undo, return error return-value
     2094     :
     2095       if p-action = ?
     2096       then do:
     2097         if v-diasize-need-maximize = true
     2098         then do:
     2099           assign
     2100             p-action = true
     2101           .
     2102         end.
     2103         else do:
     2104           assign
     2105             p-action = false
     2106           .
     2107         end.
     2108       end.
     2109       if p-action = true
     2110       then do:
     2111         run diasize_change-height in this-procedure
     2112           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2113               - frame Dialog-Frame :height-chars
     2114           ,input true
     2115           ) .
     2116         run diasize_change-width in this-procedure
     2117           (input session :width-chars
     2118               - frame Dialog-Frame :width-chars
     2119           ,input true
     2120           ) .
     2121         assign
     2122           v-diasize-need-maximize = false
     2123         .
     2124       end.
     2125       else do:
     2126         run diasize_change-width in this-procedure
     2127           (input v-diasize-orig-frame-width
     2128               - frame Dialog-Frame :width-chars
     2129           ,input true
     2130           ) .
     2131         run diasize_change-height in this-procedure
     2132           (input v-diasize-orig-frame-height
     2133               - frame Dialog-Frame :height-chars
     2134           ,input true
     2135           ) .
     2136         assign
     2137           v-diasize-need-maximize = true
     2138         .
     2139       end.
     2140     end.
     2141   end procedure.
     2142   procedure diasize_restore-orig-size :
     2143     do
     2144     on error undo, return error return-value
     2145     :
     2146       assign
     2147         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2148         v-diasize-current-frame-height = frame Dialog-Frame :height
     2149       .
     2150       run diasize_set-height in this-procedure
     2151         (input  v-diasize-orig-frame-height
     2152         ,input  true
     2153         ) .
     2154       run diasize_set-width in this-procedure
     2155         (input  v-diasize-orig-frame-width
     2156         ,input  true
     2157         ) .
     2158     end.
     2159   end procedure.
     2160   procedure diasize_restore-current-size :
     2161     do
     2162     on error undo, return error return-value
     2163     :
     2164       run diasize_set-height in this-procedure
     2165         (input  v-diasize-current-frame-height
     2166         ,input  true
     2167         ) .
     2168       run diasize_set-width in this-procedure
     2169         (input  v-diasize-current-frame-width
     2170         ,input  true
     2171         ) .
     2172     end.
     2173   end procedure.
     2174   procedure diasize_set-browse-handle :
     2175     define input  parameter p-browse-handle as handle   no-undo .
     2176     define buffer buf_temp-browse-handle for temp-browse-handle .
     2177     do
     2178     on error undo, return error return-value
     2179     :
     2180       assign
     2181         v-diasize-browse-handle = p-browse-handle
     2182       .
     2183       for each buf_temp-browse-handle
     2184       on error undo, return error return-value
     2185       :
     2186         delete buf_temp-browse-handle .
     2187       end.
     2188     end.
     2189   end procedure.
     2190   procedure diasize_add_browse :
     2191     define input  parameter p-browse-type   as character no-undo .
     2192     define input  parameter p-browse-handle as handle    no-undo .
     2193     define buffer buf_temp-browse-handle for temp-browse-handle .
     2194     do
     2195     on error undo, return error return-value
     2196     :
     2197       assign
     2198         v-diasize-browse-number = v-diasize-browse-number + 1
     2199       .
     2200       create buf_temp-browse-handle .
     2201       assign
     2202         buf_temp-browse-handle.browse-type   = p-browse-type
     2203         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2204         buf_temp-browse-handle.browse-handle = p-browse-handle
     2205       .
     2206     end.
     2207   end procedure.
     2208   procedure diasize_init :
     2209     define variable v-default-value    as logical   no-undo .
     2210     define variable v-restore-saved    as logical   no-undo .
     2211     define variable v-resize-value-str as character no-undo .
     2212     do
     2213     on error undo, return error return-value
     2214     :
     2215       do with frame Dialog-Frame
     2216       :
     2217         assign
     2218           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2219           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2220           v-diasize-browse-handle     = browse br-rule :handle
     2221         .
     2222         create button v-diasize-resize-button
     2223         assign
     2224           parent        = frame Dialog-Frame :first-child
     2225           label         = "s"
     2226           height-pixels = 16
     2227           width-pixels  = 16
     2228           visible       = true
     2229           sensitive     = true
     2230           movable       = true
     2231           triggers:
     2232             on end-move persistent run diasize_end-move in this-procedure .
     2233           end triggers.
     2234         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2235         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2236         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2237         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2238         assign
     2239           v-diasize-wndmax = false
     2240         .
     2241         if connected("ub") = true
     2242         then do:
     2243           define variable v-cntxt-db-num        as integer   no-undo .
     2244           define variable v-cntxt-userid        as character no-undo .
     2245           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2246                                             , OUTPUT v-cntxt-userid
     2247                                             ) .
     2248           run gbl/wndpar_r.p
     2249             (input  v-cntxt-db-num
     2250             ,input  v-cntxt-userid
     2251             ,input  'wndmax':U
     2252             ,output v-diasize-wndmax
     2253             ,output v-default-value
     2254             ) .
     2255         end.
     2256         assign
     2257           v-diasize-wndstore = false
     2258         .
     2259         if connected("ub") = true
     2260         then do:
     2261           run gbl/wndpar_r.p
     2262             (input  v-cntxt-db-num
     2263             ,input  v-cntxt-userid
     2264             ,input  'wndstore':U
     2265             ,output v-diasize-wndstore
     2266             ,output v-default-value
     2267             ) .
     2268         end.
     2269         assign
     2270           v-diasize-proc-name = entry(1, program-name(2), '.')
     2271         .
     2272         if v-diasize-wndstore = true
     2273         then do:
     2274           assign
     2275             v-restore-saved = false
     2276           .
     2277           if connected("ub") = true
     2278           then do:
     2279             run gbl/wndsizer.p
     2280               (input  v-cntxt-db-num
     2281               ,input  v-cntxt-userid
     2282               ,input  v-diasize-proc-name
     2283               ,input  'height':u
     2284               ,output v-resize-value-str
     2285               ) .
     2286             if v-resize-value-str <> '':U
     2287             then do:
     2288               run diasize_change-height in this-procedure
     2289                 (input  integer(v-resize-value-str)
     2290                 ,input  true
     2291                 ) .
     2292               assign
     2293                 v-restore-saved = true
     2294               .
     2295             end.
     2296           end.
     2297           if connected("ub") = true
     2298           then do:
     2299             run gbl/wndsizer.p
     2300               (input  v-cntxt-db-num
     2301               ,input  v-cntxt-userid
     2302               ,input  v-diasize-proc-name
     2303               ,input  'width':u
     2304               ,output v-resize-value-str
     2305               ) .
     2306             if v-resize-value-str <> '':U
     2307             then do:
     2308               run diasize_change-width in this-procedure
     2309                 (input  integer(v-resize-value-str)
     2310                 ,input  true
     2311                 ) .
     2312               assign
     2313                 v-restore-saved = true
     2314               .
     2315             end.
     2316           end.
     2317           if v-restore-saved <> true
     2318           then do:
     2319             if v-diasize-wndmax = true
     2320             then do:
     2321               run diasize_maximize in this-procedure
     2322                 (input  true
     2323                 ) .
     2324             end.
     2325           end.
     2326         end.
     2327         else do:
     2328           if v-diasize-wndmax = true
     2329           then do:
     2330             run diasize_maximize in this-procedure
     2331               (input  true
     2332               ) .
     2333           end.
     2334         end.
     2335       end.
     2336     end.
     2337   end procedure.
     2338   procedure diasize_need-full-display :
     2339     define output parameter p-need-full-display as logical   no-undo .
     2340     do
     2341     on error undo, return error return-value
     2342     :
     2343       assign
     2344         p-need-full-display = v-diasize-need-full-display
     2345       .
     2346       assign
     2347         v-diasize-need-full-display = false
     2348       .
     2349     end.
     2350   end procedure.
     2351   procedure get-context :
     2352      define output parameter p-db-num as integer          no-undo.
     2353      define output parameter p-user-id as character        no-undo.
     2354      define variable v-login               as character    no-undo.
     2355      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2356      define buffer buf_user-login  for ub.user-login .
     2357      do
     2358      on error undo, return error
     2359      :
     2360            FIND FIRST buf_sys-ctrl no-lock.
     2361            ASSIGN
     2362               v-login = USERID("ub")
     2363               p-db-num = buf_sys-ctrl.db-num
     2364            .
     2365            FIND FIRST buf_user-login
     2366                 WHERE buf_user-login.db-num = p-db-num
     2367                   AND buf_user-login.user-login = v-login
     2368                 no-lock
     2369                 no-error
     2370                 .
     2371            IF AVAILABLE buf_user-login
     2372            THEN DO:
     2373               assign
     2374                  p-user-id = buf_user-login.user-id
     2375               .
     2376            END.
     2377      end.
     2378   end procedure.
     2379       run diasize_init in this-procedure .
     2380   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2381   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2382   MAIN-BLOCK:
     2383   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2384      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2385   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2386     run mainmenu_getcntxt in parparentproc
     2387       (output v-cntxt-db-num
     2388       ,output v-cntxt-userid
     2389       ,output v-cntxt-level
     2390       ,output v-cntxt-host-code-obj
     2391       ,output v-cntxt-obj-type
     2392       ,output v-cntxt-obj-code
     2393       ,output v-cntxt-db-num-obj
     2394       ,output v-cntxt-is-admin
     2395       ) .
     2396     if lookup(p-list-mode, 'все':U + chr(44) + "codex") = 0 then do:
     2397       message
     2398       substitute("Неверное значение p-list-mode=&1", p-list-mode)
     2399       view-as alert-box error .
     2400       undo main-block, return error .
     2401     end.
     2402     v-rid-list = p-rid-list.
     2403     run Myenable in this-procedure .
     2404     WAIT-FOR GO OF FRAME Dialog-Frame.
     2405   END.
     2406   RUN disable_UI.
     2407   PROCEDURE disable_UI :
     2408     HIDE FRAME Dialog-Frame.
     2409   END PROCEDURE.
     2410   PROCEDURE enable_UI :
     2411     DISPLAY EDITOR-1 mark-num
     2412         WITH FRAME Dialog-Frame.
     2413     ENABLE b-quit b-mark b-sel b-add b-chg b-del b-lkp b-links b-sch B-Help
     2414            B-copy b-status b-cmp b-replace br-rule EDITOR-1 mark-num
     2415         WITH FRAME Dialog-Frame.
     2416     VIEW FRAME Dialog-Frame.
     2417     OPEN QUERY br-rule FOR EACH X_rule NO-LOCK indexed-reposition.
     2418   END PROCEDURE.
     2419   PROCEDURE Myenable :
     2420   assign
     2421   X_rule.name:resizable in browse br-rule = yes
     2422   b-links:MENU-MOUSE in frame Dialog-Frame = 1
     2423   b-lkp:MENU-MOUSE in frame Dialog-Frame = 1
     2424   b-status:MENU-MOUSE in frame Dialog-Frame = 1
     2425   b-cmp:MENU-MOUSE in frame Dialog-Frame = 1
     2426   .
     2427   ENABLE
     2428   b-quit
     2429   b-add when (v-cntxt-db-num = 0 and lookup("b-add", bttns) > 0)
     2430   b-chg when (v-cntxt-db-num = 0 and lookup("b-add", bttns) > 0)
     2431   b-del when (v-cntxt-db-num = 0 and lookup("b-add", bttns) > 0)
     2432   b-copy when (v-cntxt-db-num = 0 and lookup("b-add", bttns) > 0)
     2433   b-lkp
     2434   b-links
     2435   B-Help
     2436   b-mark when lookup("b-mark", bttns) > 0
     2437   b-sel when lookup("b-sel", bttns) > 0
     2438   b-cmp when (v-cntxt-db-num = 0 and lookup("b-add", bttns) > 0)
     2439   b-sch
     2440   b-replace when (v-cntxt-db-num = 0 and lookup("b-add", bttns) > 0)
     2441   b-status when (v-cntxt-db-num = 0 and lookup("b-add", bttns) > 0)
     2442   br-rule
     2443   WITH FRAME Dialog-Frame.
     2444   VIEW FRAME Dialog-Frame.
     2445   run openbr in this-procedure ( input yes, input no, input '':U).
     2446   APPLY "VALUE-CHANGED" to br-rule.
     2447   END PROCEDURE.
     2448   PROCEDURE Openbr :
     2449   define input  parameter p-open-query     as logical   no-undo .
     2450   define input  parameter p-find-next      as logical   no-undo .
     2451   define input  parameter p-find-condition as character no-undo .
     2452   define variable l-query-was-opened as logical no-undo .
     2453   run waitfram-show in this-procedure ("Ждите...").
     2454   define variable sort-column-phrase as character no-undo .
     2455   case sort-column-name :
     2456     when "" then do:
     2457       assign
     2458         sort-column-phrase = ""
     2459       .
     2460     end.
     2461     otherwise do:
     2462       assign
     2463         sort-column-phrase = "by " + sort-column-name
     2464       .
     2465     end.
     2466   end case.
     2467   define variable l-open-query as logical   no-undo .
     2468   filter-point = filter-point0 + p-list-mode.
     2469   CASE p-list-mode :
     2470     WHEN 'все':U        THEN DO:
     2471       assign
     2472       filter-point-label = substitute("Все правила RULE-машины &1"
     2473                                      , (IF p-sts = -999999999 THEN '':U ELSE entry (lookup (string(p-sts), '-1,-10,0,1,99,98':U), 'готов,нов,исп,удал,удаление,запр.удал':U))
     2474                                       )
     2475       frame Dialog-Frame:title = filter-point-label
     2476       .
     2477   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2478   define variable  l-disable-where-16  as logical   no-undo .
     2479   define variable  l-filter-open-16    as logical   .
     2480   define variable  flt-rec-16       as recid     no-undo .
     2481   define variable  filter-name-16      as character no-undo .
     2482   define variable  where-phrase-16     as character no-undo .
     2483   define variable  sort-phrase-16      as character no-undo .
     2484   define variable  where-phrase-rus-16 as character no-undo .
     2485   define variable  sort-phrase-rus-16  as character no-undo .
     2486     run waitfram-show in this-procedure
     2487       (input "ЖДИТЕ ..."
     2488       ).
     2489   run gbl/flt-get.p
     2490     (input filter-point
     2491     ,output flt-rec-16
     2492     ,output filter-name-16
     2493     ,output where-phrase-16
     2494     ,output sort-phrase-16
     2495     ,output where-phrase-rus-16
     2496     ,output sort-phrase-rus-16
     2497     ).
     2498   if p-open-query then do:
     2499       run set-filter-name in this-procedure
     2500         (INPUT filter-name-16
     2501         ) no-error .
     2502     assign
     2503       l-filter-open-16 = false
     2504     .
     2505     if flt-rec-16 <> ?
     2506       or sort-column-phrase > ""
     2507     then do:
     2508       define variable  parameter-2-16 as character no-undo .
     2509       define variable  parameter-3-16 as character no-undo .
     2510       define variable  parameter-4-16 as character no-undo .
     2511       define variable  parameter-5-16 as character no-undo .
     2512       define variable  parameter-6-16 as character no-undo .
     2513       define variable  parameter-7-16 as character no-undo .
     2514         assign
     2515         parameter-3-16 =
     2516                                 "FOR EACH X_rule"
     2517         parameter-4-16 =
     2518           (
     2519             if (" X_rule.upper_rule_id = 0                         and (p-sts = -999999999 or X_rule.sts = p-sts)" + " " + where-phrase-16) <> ""
     2520             then  substitute('X_rule.upper_rule_id = 0                         and (&1 = -999999999 or X_rule.sts = &1)', p-sts) + " " + where-phrase-16
     2521             else "true"
     2522           )
     2523         parameter-5-16 = (" " + "" + " " + "")
     2524         parameter-6-16 = if sort-phrase-16 = ''
     2525                              then
     2526           (
     2527           " " + "  " +
     2528             " " + sort-column-phrase +
     2529           " " + " by X_rule.rule_id "
     2530           )
     2531                              else
     2532           (
     2533           " " + "  " +
     2534             " " + sort-column-phrase +
     2535           " " + sort-phrase-16
     2536           )
     2537         parameter-7-16 =
     2538           " indexed-reposition  "
     2539       .
     2540       do
     2541       on stop undo, leave
     2542       on error undo, leave
     2543       :
     2544         assign
     2545           l-disable-where-16 =
     2546             (" X_rule.upper_rule_id = 0                         and (p-sts = -999999999 or X_rule.sts = p-sts)" + " " + where-phrase-16 = "")
     2547         .
     2548         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     2549                             ,input QUERY br-rule:handle
     2550                             ,input parameter-3-16
     2551                             ,input parameter-4-16
     2552                             ,input parameter-5-16
     2553                             ,input parameter-6-16
     2554                             ,input parameter-7-16
     2555                             )
     2556         .
     2557         assign
     2558           l-filter-open-16 = true
     2559         .
     2560       end.
     2561       if l-filter-open-16 = false then do:
     2562         message
     2563           "Ошибка при фильтрации / сортировке" skip
     2564           "Будут показаны записи без учета фильтра" skip
     2565           view-as alert-box .
     2566       end.
     2567       else do:
     2568           assign
     2569             l-query-was-opened = true
     2570           .
     2571       end.
     2572     end.
     2573     if l-filter-open-16 = false then do:
     2574       OPEN QUERY br-rule FOR EACH X_rule
     2575         where  X_rule.upper_rule_id = 0                         and (p-sts = -999999999 or X_rule.sts = p-sts)
     2576          by X_rule.rule_id
     2577         indexed-reposition
     2578     .
     2579         assign
     2580           l-query-was-opened = true
     2581         .
     2582     end.
     2583   end.
     2584   else do:
     2585     assign
     2586       v-doc-rec = recid( X_rule )
     2587     .
     2588     do
     2589     on stop undo, leave
     2590     on error undo, leave
     2591     :
     2592       if QUERY br-rule:handle:get-buffer-handle(1) = (buffer X_rule:handle) then do:
     2593         assign
     2594         parameter-2-16 = (if p-find-next then "true":u else "false":u )
     2595         parameter-4-16 =
     2596           "where ":u +  substitute('X_rule.upper_rule_id = 0                         and (&1 = -999999999 or X_rule.sts = &1)', p-sts) + " ":u + where-phrase-16 + " ":u + p-find-condition + " " + ""
     2597         parameter-5-16 = "  "
     2598       .
     2599         run fltopend_fltfindd in this-procedure  (
     2600                             input this-procedure:handle
     2601                             ,input QUERY br-rule:handle
     2602                             ,input rowid(X_rule)
     2603                             ,input logical(parameter-2-16)
     2604                             ,input no-lock
     2605                             ,input (buffer X_rule:handle)
     2606                             ,input parameter-4-16
     2607                             ,input parameter-5-16
     2608                             ) no-error.
     2609         .
     2610         assign
     2611           v-doc-rec = integer(return-value)
     2612           v-fltopend-rowid[1] = ?
     2613         .
     2614       end.
     2615       else do:
     2616         assign
     2617         parameter-2-16 = (if p-find-next then "true":u else "false":u )
     2618         parameter-3-16 =  "FOR EACH X_rule"
     2619         parameter-4-16 =
     2620           (
     2621             if (" X_rule.upper_rule_id = 0                         and (p-sts = -999999999 or X_rule.sts = p-sts)" + " " + where-phrase-16) <> ""
     2622             then  substitute('X_rule.upper_rule_id = 0                         and (&1 = -999999999 or X_rule.sts = &1)', p-sts) + " " + where-phrase-16
     2623             else "true"
     2624           )
     2625         parameter-5-16 = (" " + "" + " " + "" + " " + p-find-condition)
     2626         parameter-6-16 = if sort-phrase-16 = ''
     2627                              then
     2628           (
     2629           " " + "  " +
     2630             " " + sort-column-phrase +
     2631           " " + " by X_rule.rule_id "
     2632           )
     2633                              else
     2634           (
     2635           " " + "  " +
     2636             " " + sort-column-phrase +
     2637           " " + sort-phrase-16
     2638           )
     2639         parameter-7-16 =
     2640           " indexed-reposition  "
     2641       .
     2642         run fltopend_fltfindq in this-procedure  (
     2643                             input this-procedure:handle
     2644                             ,input QUERY br-rule:handle
     2645                             ,input logical(parameter-2-16)
     2646                             ,input no-lock
     2647                             ,input parameter-3-16
     2648                             ,input parameter-4-16
     2649                             ,input parameter-5-16
     2650                             ,input parameter-6-16
     2651                             ,input parameter-7-16
     2652                             ,output v-fltopend-rowid
     2653                             ) no-error.
     2654         .
     2655         v-doc-rec = ?.
     2656       end.
     2657       assign
     2658         l-query-was-opened = true
     2659       .
     2660     end.
     2661   end.
     2662     run waitfram-hide in this-procedure .
     2663       END.
     2664       when "codex" then do:
     2665         assign
     2666         filter-point-label = substitute("Правила для кодекса &1 &2"
     2667                                         , p-codex-id
     2668                                         , (IF p-sts = -999999999 THEN '':U ELSE entry (lookup (string(p-sts), '-1,-10,0,1,99,98':U), 'готов,нов,исп,удал,удаление,запр.удал':U))
     2669                                         )
     2670         frame Dialog-Frame:title = filter-point-label
     2671         .
     2672   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2673   define variable  l-disable-where-18  as logical   no-undo .
