     2193   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2194   FUNCTION rum-fn_get-next-file-name returns character (
     2195                                       input p-base-file-name as character
     2196                                     , input p-index as integer):
     2197   define variable v-loc-file-name as character no-undo .
     2198   v-loc-file-name = substitute("&1_&2.&3"
     2199                               ,substring(p-base-file-name, 1, (if r-index(p-base-file-name, ".") > 1
     2200                                                         then (r-index(p-base-file-name, ".") - 1)
     2201                                                         else length(p-base-file-name)
     2202                                                         )
     2203                                           )
     2204                               ,p-index
     2205                               ,(if r-index(p-base-file-name, ".") > 1
     2206                                 then substring(p-base-file-name, r-index(p-base-file-name, ".") + 1)
     2207                                 else '')
     2208                                 )
     2209                                 .
     2210   return v-loc-file-name.
     2211   end function.
     2212   define variable vss-include-info13 as character format "X(65)" no-undo
     2213   initial "@(#)$Workfile$ $Revision$".
     2214   define temp-table temp_fbrglib_grp no-undo
     2215       field sel           as character
     2216       field full-name     as character
     2217       field out-code      as integer
     2218       field sort-name     as character
     2219       field node-code     as integer
     2220       field upper-code    as integer
     2221       field name          as character
     2222       field level         as integer
     2223       field mark          as character
     2224       field obj-type      as character
     2225       field obj-code      as integer
     2226       field global-code   as integer
     2227       index pi is primary unique obj-type obj-code sort-name
     2228       index fn obj-type obj-code full-name
     2229       index nc is unique obj-type obj-code node-code
     2230       index sl obj-type obj-code sel
     2231       index uc obj-type obj-code upper-code
     2232   .
     2233   define temp-table temp_fbrglib_found-grp no-undo
     2234       field full-name   as character
     2235       field sort-name   as character
     2236       field node-code   as integer
     2237       field level       as integer
     2238       field is-terminal as logical
     2239       field obj-type      as character
     2240       field obj-code      as integer
     2241       index pi is primary unique obj-type obj-code sort-name
     2242       index fn obj-type obj-code full-name
     2243       index lv obj-type obj-code level
     2244       index it obj-type obj-code is-terminal
     2245   .
     2246   define temp-table temp_found-result-nodelist no-undo
     2247       field node-code     as integer
     2248       field processed     as logical
     2249       field sort-name     as character
     2250       field full-name     as character
     2251       index pi is primary unique node-code
     2252       index ps processed
     2253   .
     2254   procedure fbrglib-get-sort-name :
     2255   do
     2256   on error undo, return error
     2257   :
     2258   define input parameter p-obj-type   as character    no-undo.
     2259   define input parameter p-obj-code   as integer      no-undo.
     2260   define input parameter p-node-code  as integer      no-undo.
     2261   define output parameter p-sort-name as character    no-undo.
     2262       define variable v-upper-code    as integer           no-undo.
     2263       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     2264       define buffer buf_upper_fbr-gds-grp for ub.fbr-gds-grp.
     2265       find first buf_fbr-gds-grp no-lock
     2266            where buf_fbr-gds-grp.obj-type  = p-obj-type
     2267              and buf_fbr-gds-grp.obj-code  = p-obj-code
     2268              and buf_fbr-gds-grp.node-code = p-node-code
     2269       no-error.
     2270       if not available buf_fbr-gds-grp
     2271       then do:
     2272           undo, return error "fbrglib-get-sort-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     2273       end.
     2274       assign
     2275           p-sort-name  = ""
     2276           v-upper-code = 1
     2277       .
     2278       do while true
     2279       on error undo, return error "fbrglib-get-sort-name: Ошибка составления полного имени группы"
     2280       :
     2281           assign
     2282               p-sort-name  = buf_fbr-gds-grp.node-name
     2283                            + (if p-sort-name <> "" then chr(2) else "")
     2284                            + p-sort-name
     2285               v-upper-code = buf_fbr-gds-grp.upper-code
     2286           .
     2287           if buf_fbr-gds-grp.upper-code = 1
     2288           then do:
     2289               leave.
     2290           end.
     2291           find first buf_fbr-gds-grp no-lock
     2292                where buf_fbr-gds-grp.obj-type  = p-obj-type
     2293                  and buf_fbr-gds-grp.obj-code  = p-obj-code
     2294                  and buf_fbr-gds-grp.node-code = v-upper-code
     2295           no-error.
     2296           if not available buf_fbr-gds-grp
     2297           then do:
     2298               undo, return error "fbrglib-get-sort-name: Не найдена группа товаров с кодом "
     2299                                   + string( v-upper-code )
     2300                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     2301           end.
     2302       end.
     2303   end.
     2304   end procedure.
     2305   procedure fbrglib-get-full-name :
     2306   do
     2307   on error undo, return error
     2308   :
     2309   define input parameter p-obj-type   as character    no-undo.
     2310   define input parameter p-obj-code   as integer      no-undo.
     2311   define input parameter p-node-code  as integer      no-undo.
     2312   define output parameter p-full-name as character    no-undo.
     2313       define variable v-upper-code    as integer           no-undo.
     2314       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     2315       define buffer buf_upper_fbr-gds-grp for ub.fbr-gds-grp.
     2316       if p-node-code = 1
     2317       then do:
     2318           assign
     2319               p-full-name = ""
     2320           .
     2321       end.
     2322       else do:
     2323           find first buf_fbr-gds-grp no-lock
     2324                where buf_fbr-gds-grp.obj-type  = p-obj-type
     2325                  and buf_fbr-gds-grp.obj-code  = p-obj-code
     2326                  and buf_fbr-gds-grp.node-code = p-node-code
     2327           no-error.
     2328           if not available buf_fbr-gds-grp
     2329           then do:
     2330               undo, return error "fbrglib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     2331           end.
     2332           assign
     2333               p-full-name  = ""
     2334               v-upper-code = 1
     2335           .
     2336           do while true
     2337           on error undo, return error "fbrglib-get-full-name: Ошибка составления полного имени группы"
     2338           :
     2339               assign
     2340                   p-full-name  = buf_fbr-gds-grp.node-name
     2341                               + (if p-full-name <> "" then chr(47) else "")
     2342                               + p-full-name
     2343                   v-upper-code = buf_fbr-gds-grp.upper-code
     2344               .
     2345               if buf_fbr-gds-grp.upper-code = 1
     2346               then do:
     2347                   leave.
     2348               end.
     2349               find first buf_fbr-gds-grp no-lock
     2350                    where buf_fbr-gds-grp.obj-type  = p-obj-type
     2351                      and buf_fbr-gds-grp.obj-code  = p-obj-code
     2352                      and buf_fbr-gds-grp.node-code = v-upper-code
     2353               no-error.
     2354               if not available buf_fbr-gds-grp
     2355               then do:
     2356                   undo, return error "fbrglib-get-full-name: Не найдена группа товаров с кодом "
     2357                                       + string( v-upper-code )
     2358                                       + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     2359               end.
     2360           end.
     2361           assign
     2362               p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     2363           .
     2364       end.
     2365   end.
     2366   end procedure.
     2367   procedure fbrglib-get-root-code :
     2368   do
     2369   on error undo, return error
     2370   :
     2371   define output parameter p-root-code as integer      no-undo.
     2372       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     2373       find first buf_fbr-gds-grp no-lock
     2374            where buf_fbr-gds-grp.upper-code = 0
     2375       no-error .
     2376       if not available buf_fbr-gds-grp
     2377       then do:
     2378           undo, return error .
     2379       end.
     2380       else do:
     2381           assign
     2382               p-root-code = buf_fbr-gds-grp.node-code
     2383           .
     2384       end.
     2385   end.
     2386   end procedure.
     2387   procedure fbrglib-find-grp-by-full-name :
     2388   do
     2389   on error undo, return error
     2390   :
     2391   define input parameter p-obj-type     as character    no-undo.
     2392   define input parameter p-obj-code     as integer      no-undo.
     2393   define input parameter p-search-name  as character    no-undo.
     2394   define input parameter p-fill-path    as logical      no-undo.
     2395       define variable v-upper-code    as integer          no-undo.
     2396       define variable v-not-found     as logical init yes no-undo.
     2397       define variable v-counter       as integer           no-undo.
     2398       define variable v-level         as integer           no-undo.
     2399       define variable v-full-name     as character         no-undo.
     2400       define variable v-sort-name     as character         no-undo.
     2401       define variable v-node-name     as character      no-undo.
     2402       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     2403       assign
     2404           p-search-name = replace( p-search-name, chr(47), chr(2) )
     2405       .
     2406       run fbrglib-get-root-code ( output v-upper-code ) no-error .
     2407       if error-status :error
     2408       then do:
     2409           undo, return error "fbrglib-find-grp-by-full-name: Ошибка при поиске корневого узла".
     2410       end.
     2411       assign
     2412           v-full-name  = ""
     2413           v-level      = num-entries( p-search-name, chr(2) )
     2414       .
     2415       for each temp_fbrglib_found-grp
     2416       :
     2417           delete temp_fbrglib_found-grp.
     2418       end.
     2419       start-name-analyze:
     2420       do v-counter = 1 to v-level
     2421       :
     2422           if v-counter < v-level
     2423           then do:
     2424               assign
     2425                   v-node-name = entry( v-counter, p-search-name, chr(2) )
     2426               .
     2427               find first buf_fbr-gds-grp no-lock
     2428                    where buf_fbr-gds-grp.obj-type   = p-obj-type
     2429                      and buf_fbr-gds-grp.obj-code   = p-obj-code
     2430                      and buf_fbr-gds-grp.upper-code = v-upper-code
     2431                      and buf_fbr-gds-grp.node-name  = v-node-name
     2432               no-error .
     2433               if not available buf_fbr-gds-grp
     2434               then do:
     2435                   assign
     2436                       v-full-name  = p-search-name
     2437                       v-sort-name  = p-search-name
     2438                   .
     2439                   return error "fbrglib-find-grp-by-full-name: не найдена группа " + entry( v-level, p-search-name, chr(47) ).
     2440               end.
     2441               else do:
     2442                   assign
     2443                       v-full-name = v-full-name + ( if v-full-name = "" then "" else chr(47) )        + buf_fbr-gds-grp.node-name
     2444                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_fbr-gds-grp.node-name
     2445                       v-upper-code = buf_fbr-gds-grp.node-code
     2446                   .
     2447                   if p-fill-path = yes
     2448                   then do:
     2449                       create temp_fbrglib_found-grp.
     2450                       assign
     2451                           temp_fbrglib_found-grp.full-name = v-full-name + chr(47)
     2452                           temp_fbrglib_found-grp.sort-name = v-sort-name
     2453                           temp_fbrglib_found-grp.node-code = v-upper-code
     2454                           temp_fbrglib_found-grp.level     = v-counter
     2455                           temp_fbrglib_found-grp.obj-type  = p-obj-type
     2456                           temp_fbrglib_found-grp.obj-code  = p-obj-code
     2457                       .
     2458                   end.
     2459               end.
     2460           end.
     2461           else do:
     2462               for each buf_fbr-gds-grp no-lock
     2463                  where buf_fbr-gds-grp.obj-type   = p-obj-type
     2464                    and buf_fbr-gds-grp.obj-code   = p-obj-code
     2465                    and buf_fbr-gds-grp.upper-code = v-upper-code
     2466                    and buf_fbr-gds-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
     2467               :
     2468                   assign
     2469                       v-not-found = no
     2470                   .
     2471                   create temp_fbrglib_found-grp.
     2472                   assign
     2473                       temp_fbrglib_found-grp.full-name = v-full-name
     2474                                                           + (if v-full-name = "" then "" else chr(47) )
     2475                                                           + buf_fbr-gds-grp.node-name + chr(47)
     2476                       temp_fbrglib_found-grp.sort-name = v-sort-name
     2477                                                           + ( if v-sort-name = "" then "" else chr(2) )
     2478                                                           + buf_fbr-gds-grp.node-name
     2479                       temp_fbrglib_found-grp.node-code = buf_fbr-gds-grp.node-code
     2480                       temp_fbrglib_found-grp.level     = v-level
     2481                       temp_fbrglib_found-grp.obj-type  = p-obj-type
     2482                       temp_fbrglib_found-grp.obj-code  = p-obj-code
     2483                   .
     2484               end.
     2485               if v-not-found = yes
     2486               then do:
     2487                   assign
     2488                       v-full-name  = p-search-name
     2489                       v-sort-name  = p-search-name
     2490                   .
     2491                   for each temp_fbrglib_found-grp
     2492                   :
     2493                       delete temp_fbrglib_found-grp.
     2494                   end.
     2495                   return error "fbrglib-find-grp-by-full-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
     2496               end.
     2497           end.
     2498       end.
     2499   end.
     2500   end procedure.
     2501   procedure fbrglib-find-all-subgroup :
     2502   do
     2503   on error undo, return error
     2504   :
     2505   define input parameter p-start-obj-type     as character    no-undo.
     2506   define input parameter p-start-obj-code     as integer      no-undo.
     2507   define input parameter p-start-node-code    as integer      no-undo.
     2508   define input parameter p-terminal-only      as logical      no-undo.
     2509       define variable v-start-full-name   as character     no-undo.
     2510       define variable v-start-sort-name   as character     no-undo.
     2511       define variable v-not-found         as logical       no-undo.
     2512       define variable v-is-terminal       as logical       no-undo.
     2513       define buffer buf_fbr-gds-grp           for ub.fbr-gds-grp.
     2514       create temp_found-result-nodelist.
     2515       assign
     2516           temp_found-result-nodelist.node-code = p-start-node-code
     2517           temp_found-result-nodelist.processed = no
     2518       .
     2519       run fbrglib-get-full-name in this-procedure (
     2520             input p-start-obj-type
     2521           , input p-start-obj-code
     2522           , input p-start-node-code
     2523           , output v-start-full-name
     2524       ).
     2525       run fbrglib-get-full-name in this-procedure (
     2526             input p-start-obj-type
     2527           , input p-start-obj-code
     2528           , input p-start-node-code
     2529           , output v-start-sort-name
     2530       ).
     2531       process-nodes:
     2532       do while yes
     2533       :
     2534           find first temp_found-result-nodelist
     2535                where temp_found-result-nodelist.node-code = p-start-node-code
     2536           .
     2537           assign
     2538               temp_found-result-nodelist.processed = yes
     2539           .
     2540           for each buf_fbr-gds-grp no-lock
     2541              where buf_fbr-gds-grp.obj-type   = p-start-obj-type
     2542                and buf_fbr-gds-grp.obj-code   = p-start-obj-code
     2543                and buf_fbr-gds-grp.upper-code = p-start-node-code
     2544           on error undo, return error
     2545           :
     2546               run fbrglib-is-terminal in this-procedure (
     2547                     input buf_fbr-gds-grp.obj-type
     2548                   , input buf_fbr-gds-grp.obj-code
     2549                   , input buf_fbr-gds-grp.node-code
     2550                   , output v-is-terminal
     2551               ).
     2552               if v-is-terminal = yes
     2553               then do:
     2554                   create temp_fbrglib_found-grp.
     2555                   assign
     2556                       temp_fbrglib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     2557                                                           chr(47) + buf_fbr-gds-grp.node-name + chr(47)
     2558                       temp_fbrglib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     2559                                                           chr(2) + buf_fbr-gds-grp.node-name + chr(2)
     2560                       temp_fbrglib_found-grp.node-code   = buf_fbr-gds-grp.node-code
     2561                       temp_fbrglib_found-grp.is-terminal = yes
     2562                       temp_fbrglib_found-grp.obj-type  = p-start-obj-type
     2563                       temp_fbrglib_found-grp.obj-code  = p-start-obj-code
     2564                   .
     2565               end.
     2566               else do:
     2567                   create temp_found-result-nodelist.
     2568                   assign
     2569                       temp_found-result-nodelist.node-code = buf_fbr-gds-grp.node-code
     2570                       temp_found-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
     2571                                                              chr(47) + buf_fbr-gds-grp.node-name + chr(47)
     2572                       temp_found-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
     2573                                                              chr(2) + buf_fbr-gds-grp.node-name + chr(2)
     2574                       temp_found-result-nodelist.processed = no
     2575                   .
     2576                   if p-terminal-only = no
     2577                   then do:
     2578                       create temp_fbrglib_found-grp.
     2579                       assign
     2580                           temp_fbrglib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     2581                                                               chr(47) + buf_fbr-gds-grp.node-name + chr(47)
     2582                           temp_fbrglib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     2583                                                               chr(2) + buf_fbr-gds-grp.node-name + chr(2)
     2584                           temp_fbrglib_found-grp.node-code   = buf_fbr-gds-grp.node-code
     2585                           temp_fbrglib_found-grp.is-terminal = no
     2586                           temp_fbrglib_found-grp.obj-type  = p-start-obj-type
     2587                           temp_fbrglib_found-grp.obj-code  = p-start-obj-code
     2588                       .
     2589                   end.
     2590               end.
     2591           end.
     2592           find first temp_found-result-nodelist
     2593                where temp_found-result-nodelist.processed = no
     2594           no-error.
     2595           if not available temp_found-result-nodelist
     2596           then do:
     2597               leave process-nodes.
     2598           end.
     2599           else do:
     2600               assign
     2601                   p-start-node-code = temp_found-result-nodelist.node-code
     2602                   v-start-full-name = temp_found-result-nodelist.full-name
     2603                   v-start-sort-name = temp_found-result-nodelist.sort-name
     2604               .
     2605           end.
     2606       end.
     2607   end.
     2608   end procedure.
     2609   procedure fbrglib-expand-name :
     2610   do
     2611   on error undo, return error
     2612   :
     2613   define input parameter p-obj-type   as character    no-undo.
     2614   define input parameter p-obj-code   as integer      no-undo.
     2615   define input parameter p-start-name as character    no-undo.
     2616   define output parameter p-end-name  as character    no-undo.
     2617       define variable v-is-terminal     as logical           no-undo.
     2618       define buffer buf_temp_fbrglib_found-grp     for temp_fbrglib_found-grp.
     2619       run fbrglib-find-grp-by-full-name in this-procedure (
     2620             input p-obj-type
     2621           , input p-obj-code
     2622           , input p-start-name
     2623           , input no
     2624       ) no-error.
     2625       run fbrglib-get-max-substring in this-procedure (
     2626              input p-obj-type
     2627           ,  input p-obj-code
     2628           ,  input length( p-start-name )
     2629           , output p-end-name
     2630       ) no-error .
     2631       if error-status :error
     2632       then do:
     2633           assign
     2634               p-end-name = ""
     2635           .
     2636       end.
     2637       else do:
     2638           find first temp_fbrglib_found-grp
     2639                where temp_fbrglib_found-grp.full-name = p-end-name
     2640                   AND temp_fbrglib_found-grp.obj-type  = p-obj-type
     2641                   AND temp_fbrglib_found-grp.obj-code  = p-obj-code
     2642                        no-error.
     2643           if available temp_fbrglib_found-grp
     2644           then do:
     2645               find first buf_temp_fbrglib_found-grp
     2646                    where buf_temp_fbrglib_found-grp.full-name begins p-end-name
     2647                      and recid( buf_temp_fbrglib_found-grp ) <> recid( temp_fbrglib_found-grp )
     2648                   AND temp_fbrglib_found-grp.obj-type  = p-obj-type
     2649                   AND temp_fbrglib_found-grp.obj-code  = p-obj-code
     2650               no-error.
     2651               if not available buf_temp_fbrglib_found-grp
     2652               then do:
     2653                   run fbrglib-is-terminal in this-procedure (
     2654                         input p-obj-type
     2655                       , input p-obj-code
     2656                       , input temp_fbrglib_found-grp.node-code
     2657                       , output v-is-terminal
     2658                   ).
     2659               end.
     2660           end.
     2661       end.
     2662   end.
     2663   end procedure.
     2664   procedure fbrglib-get-max-substring :
     2665   do
     2666   on error undo, return error
     2667   :
     2668   define input parameter p-obj-type as character no-undo .
     2669   define input parameter p-obj-code as integer no-undo .
     2670   define input parameter p-min-substring-length   as integer      no-undo.
     2671   define output parameter p-substring             as character    no-undo.
     2672           define variable v-char-counter  as integer           no-undo.
     2673           define variable v-current-char  as character         no-undo.
     2674           define variable v-names-counter  as integer           no-undo.
     2675           define variable v-base-string   as character         no-undo.
     2676           assign
     2677               v-char-counter  = p-min-substring-length
     2678           .
     2679           find first temp_fbrglib_found-grp  where
     2680                      temp_fbrglib_found-grp.obj-type  = p-obj-type
     2681                   AND temp_fbrglib_found-grp.obj-code  = p-obj-code
     2682           no-error.
     2683           if not available temp_fbrglib_found-grp
     2684           then do:
     2685               undo, return error "fbrglib-get-max-substring: Нет строк для вычисления общей подстроки".
     2686           end.
     2687           else do:
     2688               assign
     2689                   v-base-string = temp_fbrglib_found-grp.full-name
     2690               .
     2691               counter-block:
     2692               do while yes
     2693               on error undo, return error "fbrglib-get-max-substring: Ошибка вычисления продолжения имени группы."
     2694               :
     2695                   assign
     2696                       v-char-counter  = v-char-counter + 1
     2697                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
     2698                       v-names-counter = 0
     2699                   .
     2700                   compare-block:
     2701                   for each temp_fbrglib_found-grp
     2702                   where temp_fbrglib_found-grp.obj-type  = p-obj-type
     2703                   AND temp_fbrglib_found-grp.obj-code  = p-obj-code
     2704                   :
     2705                       assign
     2706                           v-names-counter = v-names-counter + 1
     2707                       .
     2708                       if v-names-counter = 1
     2709                       then do:
     2710                           next compare-block.
     2711                       end.
     2712                       if substring( temp_fbrglib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
     2713                       then do:
     2714                           leave counter-block.
     2715                       end.
     2716                   end.
     2717                   if v-names-counter = 1
     2718                   then do:
     2719                       assign
     2720                           p-substring = v-base-string
     2721                       .
     2722                       return.
     2723                   end.
     2724               end.
     2725               assign
     2726                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
     2727               .
     2728           end.
     2729   end.
     2730   end procedure.
     2731   procedure fbrglib-is-terminal :
     2732   do
     2733   on error undo, return error "Ошибка процедуры fbrglib-is-terminal"
     2734   :
     2735   define input parameter p-obj-type       as character    no-undo.
     2736   define input parameter p-obj-code       as integer      no-undo.
     2737   define input parameter p-node-code      as integer      no-undo.
     2738   define output parameter p-is-terminal   as logical      no-undo.
     2739       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     2740       find first buf_fbr-gds-grp no-lock
     2741            where buf_fbr-gds-grp.obj-type   = p-obj-type
     2742              and buf_fbr-gds-grp.obj-code   = p-obj-code
     2743              and buf_fbr-gds-grp.upper-code = p-node-code
     2744       no-error .
     2745       if not available buf_fbr-gds-grp
     2746       then do:
     2747           assign
     2748               p-is-terminal = yes
     2749           .
     2750       end.
     2751       else do:
     2752           assign
     2753               p-is-terminal = no
     2754           .
     2755       end.
     2756   end.
     2757   end procedure.
     2758   procedure fbrglib-have-goods :
     2759   do
     2760   on error undo, return error
     2761   :
     2762   define input parameter p-obj-type           as character    no-undo.
     2763   define input parameter p-obj-code           as integer      no-undo.
     2764   define input parameter p-node-code          as integer      no-undo.
     2765   define output parameter p-have-fbr-gds-obj  as logical      no-undo.
     2766       define buffer buf_fbr-gds-obj         for ub.fbr-gds-obj.
     2767       find first buf_fbr-gds-obj no-lock
     2768            where buf_fbr-gds-obj.obj-type     = p-obj-type
     2769              and buf_fbr-gds-obj.obj-code     = p-obj-code
     2770              and buf_fbr-gds-obj.fbr-grp-code = p-node-code
     2771       no-error .
     2772       if available buf_fbr-gds-obj
     2773       then do:
     2774           assign
     2775               p-have-fbr-gds-obj = yes
     2776           .
     2777       end.
     2778       else do:
     2779           assign
     2780               p-have-fbr-gds-obj = no
     2781           .
     2782       end.
     2783   end.
     2784   end procedure.
     2785   procedure fbrglib-find-by-substring :
     2786   do
     2787   on error undo, return error
     2788   :
     2789   define input parameter p-start-obj-type     as character    no-undo.
     2790   define input parameter p-start-obj-code     as integer      no-undo.
     2791   define input parameter p-start-code         as integer      no-undo.
     2792   define input parameter p-full-search-string as character    no-undo.
     2793   define output parameter p-found-code        as integer      no-undo.
     2794   define output parameter p-full-name         as character    no-undo.
     2795       define variable v-start-code     as integer           no-undo.
     2796       define variable v-found          as logical  init no  no-undo.
     2797       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     2798       search-grp:
     2799       for each buf_fbr-gds-grp no-lock
     2800           where buf_fbr-gds-grp.obj-type  = p-start-obj-type
     2801             and buf_fbr-gds-grp.obj-code  = p-start-obj-code
     2802             and buf_fbr-gds-grp.node-code > p-start-code
     2803       :
     2804           if index( buf_fbr-gds-grp.node-name, p-full-search-string ) <> 0
     2805           then do:
     2806               assign
     2807                   p-found-code = buf_fbr-gds-grp.node-code
     2808                   v-found      = yes
     2809               .
     2810               run fbrglib-get-full-name in this-procedure (
     2811                     input p-start-obj-type
     2812                   , input p-start-obj-code
     2813                   , input p-found-code
     2814                   , output p-full-name
     2815               ) no-error .
     2816               if error-status :error
     2817               then do:
     2818                   undo, return error "fbrglib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
     2819               end.
     2820               leave search-grp.
     2821           end.
     2822       end.
     2823       if v-found = yes
     2824       then do:
     2825       end.
     2826       else do:
     2827           assign
     2828               p-full-name  = ""
     2829               p-found-code = 0
     2830           .
     2831       end.
     2832   end.
     2833   end procedure.
     2834   procedure fbrglib-analyze-grp-name :
     2835   do
     2836   on error undo, return error
     2837   :
     2838   define input parameter p-grp-name       as character            no-undo.
     2839   define input parameter p-obj-type       as character            no-undo.
     2840   define input parameter p-obj-code       as integer              no-undo.
     2841   define input parameter p-upper-code     as integer              no-undo.
     2842   define output parameter p-error-message as character init ""    no-undo.
     2843       define variable v-char-list     as character    no-undo.
     2844       define variable v-char-counter  as integer      no-undo.
     2845       define variable v-full-name     as character    no-undo.
     2846       if p-grp-name = "" then do:
     2847           assign
     2848               p-error-message = "Название группы не может быть пустым.".
     2849           .
     2850       end.
     2851       else do:
     2852           assign
     2853               v-char-list = "47,92,58,63,34,60,62,171,187,183"
     2854           .
     2855           do v-char-counter = 1 to num-entries( v-char-list )
     2856           :
     2857               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
     2858               then do:
     2859                   assign
     2860                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
     2861                   .
     2862                   return.
     2863               end.
     2864           end.
     2865           run fbrglib-get-full-name in this-procedure (
     2866                 input p-obj-type
     2867               , input p-obj-code
     2868               , input p-upper-code
     2869               , output v-full-name
     2870           ) no-error .
     2871           if error-status :error
     2872           then do:
     2873               undo, return error "fbrglib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
     2874           end.
     2875           if length( v-full-name ) + 1 + length( p-grp-name ) > 120
     2876           then do:
     2877               assign
     2878                   p-error-message = 'Полное название группы не может содержать более 120 символов.'
     2879               .
     2880           end.
     2881       end.
     2882   end.
     2883   end procedure.
     2884   procedure fbrglib-delete-grp :
     2885   do
     2886   on error undo, return error
     2887   :
     2888   define input parameter p-obj-type   as character    no-undo.
     2889   define input parameter p-obj-code   as integer      no-undo.
     2890   define input parameter p-node-code  as integer      no-undo.
     2891   define output parameter p-deleted   as logical      no-undo.
     2892       define variable v-have-goods    as logical        no-undo.
     2893       define variable v-yesno         as logical        no-undo.
     2894       define variable v-upper-code    as integer        no-undo.
     2895       define variable v-root-code     as integer        no-undo.
     2896       define buffer buf_fbr-gds-grp           for ub.fbr-gds-grp.
     2897       define buffer buf_fbr-gds-obj           for ub.fbr-gds-obj.
     2898       define buffer buf_second_fbr-gds-grp    for ub.fbr-gds-grp.
     2899       run fbrglib-get-root-code in this-procedure (
     2900           output v-root-code
     2901       ) no-error.
     2902       if error-status :error
     2903       then do:
     2904           undo, return error "Не найден корневой узел." + chr(10) + return-value.
     2905       end.
     2906       if p-node-code = v-root-code
     2907       then do:
     2908           message
     2909               "Корневую группу удалить невозможно."
     2910           view-as alert-box error.
     2911           assign
     2912               p-deleted = no
     2913           .
     2914           undo, return.
     2915       end.
     2916       find first buf_fbr-gds-grp no-lock
     2917            where buf_fbr-gds-grp.obj-type     = p-obj-type
     2918              and buf_fbr-gds-grp.obj-code     = p-obj-code
     2919              and buf_fbr-gds-grp.upper-code   = p-node-code
     2920       no-error.
     2921       if available buf_fbr-gds-grp
     2922       then do:
     2923           message
     2924               "Не терминальную группу удалить невозможно."
     2925           view-as alert-box error.
     2926           assign
     2927               p-deleted = no
     2928           .
     2929           undo, return.
     2930       end.
     2931       find first buf_fbr-gds-grp no-lock
     2932            where buf_fbr-gds-grp.obj-type     = p-obj-type
     2933              and buf_fbr-gds-grp.obj-code     = p-obj-code
     2934              and buf_fbr-gds-grp.node-code    = p-node-code
     2935       .
     2936       assign
     2937           v-upper-code = buf_fbr-gds-grp.upper-code
     2938       .
     2939       run fbrglib-have-goods in this-procedure (
     2940             input p-obj-type
     2941           , input p-obj-code
     2942           , input p-node-code
     2943           , output v-have-goods
     2944       ).
     2945       if v-have-goods = yes
     2946       then do:
     2947           find first buf_second_fbr-gds-grp no-lock
     2948                where buf_second_fbr-gds-grp.obj-type      = buf_fbr-gds-grp.obj-type
     2949                  and buf_second_fbr-gds-grp.obj-code      = buf_fbr-gds-grp.obj-code
     2950                  and buf_second_fbr-gds-grp.upper-code    = buf_fbr-gds-grp.upper-code
     2951                  and recid( buf_second_fbr-gds-grp )      <> recid( buf_fbr-gds-grp )
     2952           no-error.
     2953           if available buf_second_fbr-gds-grp
     2954           then do:
     2955               message
     2956                   "В группе есть товары,"
     2957                   skip "которые нельзя перенести в родительскую группу,"
     2958                   skip "потому что у родительской группы есть еще одна подгруппа."
     2959                   skip(1)
     2960                   skip "Перенесите товары в другую группу"
     2961                   skip "или удалите все остальные подгруппы родительской группы."
     2962               view-as alert-box error.
     2963               assign
     2964                   p-deleted = no
     2965               .
     2966               undo, return.
     2967           end.
     2968           message
     2969               "В группе есть товары."
     2970               skip "После удаления группы"
     2971               skip "все ее товары будут привязаны"
     2972               skip "к ее родительской группе."
     2973               skip(1)
     2974               skip "Удалить группу?"
     2975           view-as alert-box warning
     2976           buttons yes-no
     2977           title "Удаление группы"
     2978           update v-yesno
     2979           .
     2980           if v-yesno = yes
     2981           then do:
     2982               do transaction
     2983               on error undo, return error
     2984               :
     2985                   for each buf_fbr-gds-obj exclusive-lock
     2986                      where buf_fbr-gds-obj.obj-type     = p-obj-type
     2987                        and buf_fbr-gds-obj.obj-code     = p-obj-code
     2988                        and buf_fbr-gds-obj.fbr-grp-code = p-node-code
     2989                   on error undo, return error
     2990                   :
     2991                       assign
     2992                           buf_fbr-gds-obj.fbr-grp-code = v-upper-code
     2993                       .
     2994                   end.
     2995               end.
     2996               do transaction
     2997               on error undo, return error
     2998               :
     2999                   find current buf_fbr-gds-grp exclusive-lock .
     3000                   delete buf_fbr-gds-grp no-error .
     3001                   if error-status:error then do:
     3002                     undo, return error return-value .
     3003                   end.
     3004               end.
     3005           end.
     3006       end.
     3007       else do:
     3008           message
     3009               "Имя группы: " buf_fbr-gds-grp.node-name
     3010               "Код группы: " buf_fbr-gds-grp.node-code
     3011               skip(1)
     3012               skip "Удалить группу?"
     3013           view-as alert-box warning
     3014           buttons yes-no
     3015           title "Удаление группы"
     3016           update v-yesno
     3017           .
     3018           if v-yesno = yes
     3019           then do:
     3020               do transaction
     3021               on error undo, return error
     3022               :
     3023                   find current buf_fbr-gds-grp exclusive-lock .
     3024                   delete buf_fbr-gds-grp no-error.
     3025                   if error-status:error then do:
     3026                     undo, return error return-value .
     3027                   end.
     3028               end.
     3029           end.
     3030       end.
     3031   end.
     3032   end procedure.
     3033   procedure fbrglib-add-grp :
     3034   do
     3035   on error undo, return error
     3036   :
     3037   define input parameter p-obj-type       as character    no-undo.
     3038   define input parameter p-obj-code       as integer      no-undo.
     3039   define input parameter p-node-code      as integer      no-undo.
     3040   define input parameter p-interface      as logical      no-undo.
     3041   define input parameter p-node-name      as character    no-undo.
     3042   define input parameter p-out-code       as integer      no-undo.
     3043   define input parameter p-global-code    as integer      no-undo.
     3044   define output parameter p-new-node-code as integer      no-undo.
     3045   define output parameter p-cancel        as logical      no-undo.
     3046       define variable v-have-goods    as logical  no-undo.
     3047       define variable v-host-code     as integer        no-undo.
     3048       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     3049       define buffer bf_fbr-gds-grp        for ub.fbr-gds-grp.
     3050       define buffer buf_fbr-gds-obj       for ub.fbr-gds-obj.
     3051       run fbrglib-have-goods in this-procedure (
     3052             input p-obj-type
     3053           , input p-obj-code
     3054           , input p-node-code
     3055           , output v-have-goods
     3056       ) no-error .
     3057       if error-status :error
     3058       then do:
     3059           message
     3060                    vss-workfile vss-revision vss-description
     3061               skip "Ошибка определения наличия товаров в группе."
     3062               skip return-value
     3063               skip trim(error-status :get-message(1))
     3064                    trim(error-status :get-message(2))
     3065                    trim(error-status :get-message(3))
     3066           view-as alert-box error.
     3067           undo, return error .
     3068       end.
     3069   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3070   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3071     (input  p-obj-type
     3072     ,input  p-obj-code
     3073     ,output v-host-code
     3074     )  .
     3075       find first buf_fbr-gds-grp no-lock where
     3076                 buf_fbr-gds-grp.upper-code = p-node-code
     3077             AND buf_fbr-gds-grp.obj-type   = p-obj-type
     3078             AND buf_fbr-gds-grp.obj-code   = p-obj-code
     3079             AND buf_fbr-gds-grp.node-name  = p-node-name no-error .
     3080       if available buf_fbr-gds-grp then do:
     3081           if p-node-code <> 1 then do:
     3082             find first buf_fbr-gds-grp no-lock where
     3083                       buf_fbr-gds-grp.node-code = p-node-code
     3084                   AND buf_fbr-gds-grp.obj-type   = p-obj-type
     3085                   AND buf_fbr-gds-grp.obj-code   = p-obj-code  .
     3086           end.
     3087                   message
     3088           "Для объекта" p-obj-type p-obj-code
     3089           "уже есть группа блюд" p-node-name "в подгруппе" (if p-node-code = 1 then "БЛЮДА" else buf_Fbr-gds-grp.node-name)
     3090           view-as alert-box error .
     3091           undo, return error .
     3092       end.
     3093       do transaction
     3094       on error undo, return error
     3095       :
     3096           create buf_fbr-gds-grp.
     3097           assign
     3098               buf_fbr-gds-grp.node-code   = next-value( s-gds-grp, ub )
     3099               p-new-node-code             = buf_fbr-gds-grp.node-code
     3100               buf_fbr-gds-grp.upper-code  = p-node-code
     3101               buf_fbr-gds-grp.host-code   = v-host-code
     3102               buf_fbr-gds-grp.obj-type    = p-obj-type
     3103               buf_fbr-gds-grp.obj-code    = p-obj-code
     3104               buf_fbr-gds-grp.node-name    = ""
     3105               buf_fbr-gds-grp.out-code    = 0
     3106           .
     3107           if p-interface then do:
     3108             run ref/fbrggrpd.w (
     3109                   input parparentproc
     3110                 , input 'ИЗМЕНЕНИЕ':U
     3111                 , input p-obj-type
     3112                 , input p-obj-code
     3113                 , input buf_fbr-gds-grp.node-code
     3114                 , input buf_fbr-gds-grp.upper-code
     3115                 , input buf_fbr-gds-grp.node-name
     3116                 , input buf_fbr-gds-grp.out-code
     3117                 , output buf_fbr-gds-grp.node-name
     3118                 , output buf_fbr-gds-grp.out-code
     3119                 , output p-cancel
     3120             ).
     3121             if p-cancel = yes
     3122             then do:
     3123                 delete buf_fbr-gds-grp.
     3124                 undo, return.
     3125             end.
     3126           end.
     3127           else do:
     3128             find first bf_fbr-gds-grp no-lock
     3129                 where bf_fbr-gds-grp.obj-type   = p-obj-type
     3130                   and bf_fbr-gds-grp.obj-code   = p-obj-code
     3131                   and bf_fbr-gds-grp.out-code   = p-out-code
     3132             no-error.
     3133             assign
     3134             buf_fbr-gds-grp.node-name    = p-node-name
     3135             buf_fbr-gds-grp.global-code  = p-global-code
     3136             buf_fbr-gds-grp.out-code     = (if available bf_fbr-gds-grp then 0 else p-out-code)
     3137             .
     3138           end.
     3139           if v-have-goods = yes
     3140           then do:
     3141               for each buf_fbr-gds-obj exclusive-lock
     3142                  where buf_fbr-gds-obj.obj-type      = p-obj-type
     3143                    and buf_fbr-gds-obj.obj-code      = p-obj-code
     3144                    and buf_fbr-gds-obj.fbr-grp-code  = p-node-code
     3145               on error undo, return error
     3146               :
     3147                   assign
     3148                       buf_fbr-gds-obj.fbr-grp-code = p-new-node-code
     3149                   .
     3150               end.
     3151           end.
     3152       end.
     3153   end.
     3154   end procedure.
     3155     define new shared temp-table  tt-tax no-undo
     3156   field tax-code    like ub.tax.tax-code
     3157   FIELD individual  like ub.tax.individual
     3158   FIELD tax-name    like ub.tax.tax-name format "X(12)" column-label "Налог"
     3159   field rate-code   like ub.tax-rate.rate-code
     3160   FIELD rate-name   like ub.tax-rate.rate-name FORMAT "X(12)"
     3161   FIELD tax-type    like ub.tax.tax-type
     3162   field rate-value  like ub.tax-rate-value.rate-value
     3163   FIELD tax-rate-gds-rc  as recid
     3164   FIELD to-cashdesk like ub.tax.to-cashdesk
     3165   FIELD fact-date like ub.tax-rate-value.fact-date
     3166   FIELD fact-order like ub.tax-rate-value.fact-order
     3167   FIELD next-order like ub.tax-rate-value.fact-order
     3168   FIELD corr-user-name like ub.tax-rate-gds.corr-user-name
     3169   FIELD corr-user-db-num   like ub.tax-rate-gds.corr-user-db-num
     3170   FIELD corr-date like ub.tax-rate-gds.corr-date
     3171   FIELD corr-time like ub.tax-rate-gds.corr-time
     3172   index tax-code is unique primary tax-code fact-order descending rate-code.
     3173   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3174   define temp-table THpck-sent no-undo
     3175   field THfilename as character field THcrc-pack as character field THcredate as date field THcrenum as integer  field THcretimeint as integer field THcretime as character   field THrcvddate  as date field THpack-num  as integer  field THrcvdtimeint as integer field THrcvdtime  as character   field THrcvd  as logical      field THsendtxtdate as date field THsendtxttimeint as integer field THsendtxttime as character  field THtotal-recs  as integer  field THesys-id  as integer     index pi is unique primary THesys-id                  THpack-num                 index ircvd                THesys-id                  THrcvd
     3176   .
     3177   define temp-table THcurr-pack no-undo
     3178   field THfilename as character field THcrc-pack as character field THcredate as date field THcrenum as integer  field THcretimeint as integer field THcretime as character   field THrcvddate  as date field THpack-num  as integer  field THrcvdtimeint as integer field THrcvdtime  as character   field THrcvd  as logical      field THsendtxtdate as date field THsendtxttimeint as integer field THsendtxttime as character  field THtotal-recs  as integer  field THesys-id  as integer     index pi is unique primary THesys-id                  THpack-num                 index ircvd                THesys-id                  THrcvd
     3179   .
     3180   define temp-table THpck-rcvd no-undo
     3181   field THfilename as character
     3182   field THesys-id  as integer
     3183   field THcrc-pack as character
     3184   field THpack-num  as integer
     3185   field THrcvd-recs  as integer
     3186   field THrcvd as logical
     3187   field THtotal-recs  as integer
     3188   field THrcvddate  as date
     3189   field THrcvdtimeint as integer
     3190   field THrcvdtime  as character
     3191   index pi is unique primary
     3192   THesys-id
     3193   THpack-num
     3194   index rcvd
     3195   THesys-id
     3196   THrcvd
     3197   .
     3198   procedure get-header-by-rec :
     3199   define input  parameter p-gate-rec as character no-undo .
     3200   define output parameter p-tth as handle no-undo .
     3201   define variable v-ii as integer   no-undo .
     3202   define variable glog as logical   no-undo .
     3203   define variable v-rowid as rowid no-undo .
     3204   define variable v-tbl-name as character no-undo .
     3205   define variable v-longchar as longchar no-undo .
     3206   define variable v-txmlh as handle no-undo .
     3207   define buffer buf_clob-data for ub.clob-data.
     3208   main-block:
     3209   do
     3210   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info15, return-value, chr(10), error-status :get-message (1))
     3211   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info15 )
     3212   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info15 )
     3213   :
     3214     run gen-row-keyr in  this-procedure  (
     3215                                           input  p-gate-rec
     3216                                           ,input  ?
     3217                                           ,input  "ub"
     3218                                           ,input  ?
     3219                                           ,input  NO-LOCK
     3220                                           ,output v-rowid
     3221                                           ,output v-tbl-name   ) no-error.
     3222       find first buf_clob-data no-lock where
     3223                 rowid(buf_clob-data) = v-rowid  no-error.
     3224       if not available buf_clob-data then do:
     3225         undo, return error substitute("Не найден CLOB  &1"
     3226                                         , p-gate-rec
     3227                                         ).
     3228       end.
     3229       assign
     3230       v-longchar = buf_clob-data.cdata
     3231       .
     3232       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     3233       if error-status :error then do:
     3234         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     3235       end.
     3236       create temp-table p-tth .
     3237       glog = p-tth:READ-XMLSCHEMA( "LONGCHAR"
     3238                                     , v-longchar
     3239                                     , ?
     3240                                     , ?
     3241                                     , ?
     3242                                     ) no-error.
     3243       v-longchar = '':U.
     3244       define variable v-esm as character no-undo .
     3245       v-esm = error-status:get-message(1).
     3246       if error-status :error
     3247       or not glog
     3248       then do:
     3249         delete object p-tth no-error.
     3250         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     3251                                    , p-gate-rec
     3252                                    , buf_clob-data.file-name_
     3253                                    , chr(10)
     3254                                    , v-esm
     3255                                     ).
     3256       end.
     3257   end.
     3258   end procedure.
     3259   define temp-table temp-goods-attr no-undo like ub.goods-attr.
     3260   define temp-table temp-fbr-gds-grp no-undo like ub.fbr-gds-grp
     3261   field f-name as character .
     3262   define variable v-current-gds-code as integer no-undo .
     3263   define variable v-current-artic as character no-undo .
     3264   define variable v-current-prod-type as character no-undo .
     3265   define variable v-current-prod-code as integer no-undo .
     3266   define variable v-current-host-code as integer no-undo .
     3267   define variable v-current-obj-type as character no-undo .
     3268   define variable v-current-obj-code as integer no-undo .
     3269   define variable v-current-lock as integer no-undo .
     3270   define variable v-current-wait as integer no-undo .
     3271   define variable v-save as integer no-undo .
     3272   define variable v-esys-cmd-proc-handle as handle no-undo .
     3273   define variable v-esys-cmd-code as integer no-undo .
     3274   define variable log-file-name                as character      no-undo init "process-gds-list.txt".
     3275   define variable v-view-log                   as logical        no-undo .
     3276   define variable v-stop                       as logical        no-undo .
     3277   define variable v-current-db-num as integer no-undo .
     3278   define variable v-last-error-message as character no-undo .
     3279   define variable file-name as char.
     3280   define variable v-sign as integer no-undo .
     3281   define variable v-gate-rec as character no-undo .
     3282   define variable num-rec as integer no-undo .
     3283   define variable num-rec-ok as integer no-undo .
     3284   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3285   procedure set-error :
     3286   define input parameter p-mess as character no-undo .
     3287     do
     3288     on error undo, return error
     3289     :
     3290        assign
     3291        v-last-error-message = p-mess.
     3292     end.
     3293   end procedure.
     3294   define buffer buf_temp-cmd for temp-cmd.
     3295   define shared temp-table tt0-rule-call-param no-undo like ub.rule-call-param.
     3296    define variable p-xsd-file as character no-undo.
     3297    define variable p-pck-num-rec as integer no-undo .
     3298   on delete of this-procedure do:
     3299     run garbcoll_clear in this-procedure .
     3300   end.
     3301   run load-ruleset-context in this-procedure ( input p-ruleset-id) no-error.
     3302   if error-status:error then do:
     3303     undo, return error return-value .
     3304   end.
     3305   define variable ExpData1 as class Route-data_ no-undo .
     3306   ExpData1 = new Route-data_( input parparentproc, input p-parent-handle, input p-log-handle, input this-procedure:handle) .
     3307   if not this-procedure:persistent then do:
     3308     run proc-main in this-procedure no-error .
     3309     if error-status:error then do:
     3310         for each temp-goods-attr:
     3311           delete temp-goods-attr.
     3312         end.
     3313         run garbcoll_clear in this-procedure .
     3314         undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     3315     end.
     3316     run garbcoll_clear in this-procedure .
     3317   end.
     3318   procedure proc-main :
     3319   _main:
     3320   do
     3321   on error undo, return error substitute( "&1&2&3&2&4", return-value, chr(10), error-status :get-message (1), v-last-error-message)
     3322   :
     3323     define variable v-attr-list as character no-undo .
     3324     define variable v-ii as integer no-undo .
     3325     define variable v-loc-file-name as character no-undo .
     3326     define variable v-is-global as logical no-undo .
     3327     define variable v-is-scaleable as logical no-undo .
     3328     define variable v-is-weight as logical no-undo .
     3329     define variable v-is-petrolium as logical no-undo .
     3330     define buffer buf_goods for ub.goods.
     3331     define buffer buf_bar-code for ub.bar-code.
     3332     define buffer buf_prod-bc for ub.prod-bc.
     3333     define buffer locked_goods-attr for ub.goods-attr.
     3334     define buffer buf_clients for ub.clients.
     3335     define buffer buf_gds-prt for ub.gds-prt.
     3336     define buffer buf_fbr-gds-grp for ub.fbr-gds-grp.
     3337     define buffer buf_temp-fbr-gds-grp for temp-fbr-gds-grp.
     3338     define buffer buf_gds-obj-prop for ub.gds-obj-prop.
     3339     define buffer buf_alc-type-gds for ub.alc-type-gds.
     3340     v-loc-file-name = file-name.
     3341     _stroka:
     3342     for each gds-list
     3343     break
     3344     by gds-list.gds-code
     3345     On error undo _stroka, next _stroka
     3346     :
     3347       assign
     3348       v-current-gds-code = gds-list.gds-code
     3349       v-current-artic = gds-list.artic
     3350       v-current-prod-type = gds-list.prod-type
     3351       v-current-prod-code = gds-list.prod-code
     3352       num-rec = num-rec + 1
     3353       v-is-global = no
     3354       .
     3355       for each temp-goods-attr :
     3356         delete temp-goods-attr.
     3357       end.
     3358       IF num-rec = 1
     3359       or num-rec modulo p-pck-num-rec = 1
     3360       THEN do:
     3361         IF  ExpData1:route-data_read-xmlschema( INPUT p-xsd-file) = false  THEN do:
     3362           undo _main, return error v-last-error-message .
     3363         end.
     3364       end.
     3365       if p-save >= 0 then do:
     3366         find first buf_goods exclusive-lock where
     3367                   buf_goods.gds-code = gds-list.gds-code no-error.
     3368       end.
     3369       else do:
     3370         find first buf_goods no-lock where
     3371                   buf_goods.gds-code = gds-list.gds-code no-error.
     3372       end.
     3373       if not available buf_goods then do:
     3374               run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не найден содержащийся в списке товар с кодом &1", gds-list.gds-code)).                      assign v-view-log = yes.
     3375         next _stroka.
     3376       end.
     3377       find first buf_clients no-lock where
     3378                 buf_clients.obj-type = buf_goods.prod-type
     3379             and buf_clients.obj-code = buf_goods.prod-code no-error.
     3380       if not available buf_clients then do:
     3381               run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Для товара с кодом &1 не найден производитель &2&3"                                   , gds-list.gds-code                                   , buf_goods.prod-type                                   , buf_goods.prod-code)).                      assign v-view-log = yes.
     3382         next _stroka.
     3383       end.
     3384       find first buf_gds-prt no-lock WHERE
     3385                 buf_gds-prt.upper-code = buf_goods.prt-root NO-error.
     3386       if not available buf_gds-prt then do:
     3387               run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Для товара с кодом &1 не найден корень ШКАЛЫ ПРИЗНАКОВ с кодом &2"                                   , gds-list.gds-code                                   , buf_goods.prt-root                                   )).                      assign v-view-log = yes.
     3388         next _stroka.
     3389       end.
     3390       if buf_goods.fbr-grp-code <> ?
     3391       and buf_goods.fbr-grp-code <> 0 then do:
     3392         find first buf_fbr-gds-grp no-lock where
     3393                 buf_fbr-gds-grp.obj-type = "":U
     3394             AND buf_fbr-gds-grp.obj-code = 0
     3395             AND buf_fbr-gds-grp.node-code = buf_goods.fbr-grp-code no-error .
     3396         if not available buf_fbr-gds-grp then do:
     3397                   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Для товара с кодом &1 не найдена группа блюд &2"                                     , gds-list.gds-code                                     , buf_goods.fbr-grp-code)).                      assign v-view-log = yes.
     3398           next _stroka.
     3399         end.
     3400         create buf_temp-fbr-gds-grp.
     3401         buffer-copy buf_fbr-gds-grp to buf_temp-fbr-gds-grp.
     3402         run fbrglib-get-full-name in this-procedure (
     3403                                                        input ''
     3404                                                       ,input 0
     3405                                                       ,input buf_goods.fbr-grp-code
     3406                                                       ,output buf_temp-fbr-gds-grp.f-name).
     3407       end.
     3408       if p-save >= 0 then do:
     3409         Find first locked_goods-attr exclusive-lock  where
     3410                 locked_goods-attr.gds-code = v-current-gds-code
     3411             and locked_goods-attr.attr-code = 'lock':U
     3412             no-error no-wait.
     3413         if not available locked_goods-attr
     3414         and not locked locked_goods-attr then do:
     3415           create locked_goods-attr.
     3416           assign
     3417           locked_goods-attr.gds-code =  v-current-gds-code
     3418           locked_goods-attr.attr-code = 'lock':U
     3419           .
     3420         end.
     3421         if locked locked_goods-attr then do:
     3422           Find first locked_goods-attr exclusive-lock  where
     3423                 locked_goods-attr.gds-code = v-current-gds-code
     3424             and locked_goods-attr.attr-code = 'lock':U
     3425             no-error .
     3426         end.
     3427       end.
     3428       v-attr-list = 'alcohol-prod':U + chr(4) +
     3429                     'fasovka':U + chr(4) +
     3430                     '15x80':U + chr(4)  +
     3431                     '8x50':U + chr(4) +
     3432                     '6x50':U .
     3433       do v-ii = 1 to num-entries(v-attr-list, chr(4)):
     3434         create temp-goods-attr.
     3435         assign
     3436         temp-goods-attr.gds-code = v-current-gds-code
     3437         temp-goods-attr.attr-code  = entry(v-ii, v-attr-list, chr(4))
     3438         .
     3439         run gds-attr-copy-to  in this-procedure (
     3440                                                 input  v-current-gds-code
     3441                                                 ,input  entry(v-ii, v-attr-list, chr(4))
     3442                                                 ,input (buffer temp-goods-attr:handle)
     3443                                                 ) no-error.
     3444       end.
     3445       empty temp-table tt-tax.
     3446       run ref/dtaxgdss.p (
     3447                     input yes
     3448                    ,input buf_goods.unit-base
     3449                    ,input buf_goods.grp-code
     3450                    ,input recid(buf_goods)
     3451                    ,input recid(buf_goods)
     3452                    ,input 0
     3453                    ,input ''
     3454                    ,input 0
     3455                     ) no-error.
     3456       if error-status:error then do:
     3457                   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input return-value).                      assign v-view-log = yes.
     3458           next _stroka.
     3459       end.
     3460       ExpData1:route-data_create-record( INPUT "goods-01") .
     3461       ExpData1:route-data_copy-record( INPUT "goods-01", INPUT  (buffer buf_goods:handle) ) .
     3462       for each temp-goods-attr:
     3463         ExpData1:route-data_copy-field( INPUT "goods-01"
     3464                                        , INPUT ("attr-" + temp-goods-attr.attr-code)
     3465                                        , INPUT (buffer temp-goods-attr:handle:buffer-field("attr-value")) ) .
     3466       end.
     3467       ExpData1:route-data_copy-field( INPUT "goods-01"
     3468                                       , INPUT "prod-name"
     3469                                       , INPUT (buffer buf_clients:handle:buffer-field("obj-name")) ) .
     3470       ExpData1:route-data_copy-field( INPUT "goods-01"
     3471                                       , INPUT "fbr-grp-name"
     3472                                       , INPUT (buffer buf_temp-fbr-gds-grp:handle:buffer-field("f-name")) ) .
     3473       if available buf_temp-fbr-gds-grp then
     3474       delete buf_temp-fbr-gds-grp.
     3475       ExpData1:route-data_copy-field( INPUT "goods-01"
     3476                                       , INPUT "prt-root-name"
     3477                                       , INPUT (buffer buf_gds-prt:handle:buffer-field("node-name")) ) .
     3478       find first tt-tax no-lock where
     3479                 tt-tax.tax-code = integer('1':U).
     3480       ExpData1:route-data_copy-field( INPUT "goods-01"
     3481                                       , INPUT "vat-pc"
     3482                                       , INPUT (buffer tt-tax:buffer-field("rate-value")) ) .
     3483       find first buf_alc-type-gds where buf_alc-type-gds.gds-code = buf_goods.gds-code and
     3484                                         buf_alc-type-gds.create-user-db-num = v-current-db-num no-lock no-error.
     3485       if available buf_alc-type-gds then
     3486       ExpData1:route-data_copy-field( INPUT "goods-01"
     3487                                       , INPUT "alc-type-code"
     3488                                       , INPUT (buffer buf_alc-type-gds:buffer-field("alc-type-inner-code")) ) .
     3489       _bar-code:
     3490       for each buf_bar-code share-lock where
     3491               buf_bar-code.gds-code = v-current-gds-code
     3492       on error  undo _stroka, next _stroka
     3493       on stop   undo _stroka, next _stroka
     3494       on endkey undo _stroka, next _stroka
     3495       :
     3496         if buf_bar-code.in-code <> '':U
     3497         or buf_bar-code.part-code <> '':U then next _bar-code.
     3498         find first buf_gds-prt no-lock where
     3499                   buf_gds-prt.node-code = buf_bar-code.node-code no-error.
     3500         if not available buf_gds-prt then do:
     3501                   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Для товара с кодом &1 не найден узел ШКАЛЫ ПРИЗНАКОВ с кодом &2"                                     , gds-list.gds-code                                     , buf_bar-code.node-code                                     )).                      assign v-view-log = yes.
     3502           next _stroka.
     3503         end.
     3504         ExpData1:route-data_create-record( INPUT "bar-code-01") .
     3505         ExpData1:route-data_copy-record( INPUT "bar-code-01", INPUT  (buffer buf_bar-code:handle) ) .
     3506         ExpData1:route-data_copy-field( INPUT "bar-code-01"
     3507                                         , INPUT "node-name"
     3508                                         , INPUT (buffer buf_gds-prt:handle:buffer-field("f-name")) ) .
     3509         _prod-bc:
     3510         for each buf_prod-bc share-lock where
     3511                 buf_prod-bc.b-code = buf_bar-code.b-code
     3512         on error  undo _stroka, next _stroka
     3513         on stop   undo _stroka, next _stroka
     3514         on endkey undo _stroka, next _stroka
     3515         :
     3516   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3517   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbcat in g#library
     3518     (buffer buf_prod-bc
     3519     ,input  'global=request':U
     3520     ,output v-is-global
     3521     ) no-error .
     3522   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3523   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbcat in g#library
     3524     (buffer buf_prod-bc
     3525     ,input  'weight=request':U
     3526     ,output v-is-weight
     3527     ) no-error .
     3528   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3529   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbcat in g#library
     3530     (buffer buf_prod-bc
     3531     ,input  'petrolium=request':U
     3532     ,output v-is-petrolium
     3533     ) no-error .
     3534   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3535   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbcat in g#library
     3536     (buffer buf_prod-bc
     3537     ,input  'scaleable=request':U
     3538     ,output v-is-scaleable
     3539     ) no-error .
     3540           if not v-is-global
     3541           or v-is-scaleable
     3542           or v-is-petrolium
     3543           or v-is-weight
     3544           then next _prod-bc.
     3545           ExpData1:route-data_create-record( INPUT "prod-bc-01") .
     3546           ExpData1:route-data_copy-record( INPUT "prod-bc-01", INPUT  (buffer buf_prod-bc:handle) ) .
     3547         end.
     3548       end.
     3549       _gds-obj-prop:
     3550       for each buf_gds-obj-prop share-lock where
     3551                buf_gds-obj-prop.gds-code = v-current-gds-code
     3552       on error  undo _stroka, next _stroka
     3553       on stop   undo _stroka, next _stroka
     3554       on endkey undo _stroka, next _stroka
     3555       :
     3556           ExpData1:route-data_create-record( INPUT "gds-obj-prop") .
     3557           ExpData1:route-data_copy-record( INPUT "gds-obj-prop", INPUT  (buffer buf_gds-obj-prop:handle) ) .
     3558       end.
     3559       num-rec-ok = num-rec-ok + 1.
     3560       run write-counter in p-log-handle ( input substitute("Обработано товаров списка: &1, из них удачно: &2", num-rec, num-rec-ok)).
     3561       run get-stop-state in p-log-handle ( output v-stop) no-error .
     3562       if v-stop then do:
     3563           run write-log-and-file in p-log-handle (
     3564                                                   input 1
     3565                                                 , input log-file-name
     3566                                                 , input 1
     3567                                                 , input substitute("Процесс прерван пользователем")).
     3568           leave _stroka.
     3569       end.
     3570       if last( gds-list.gds-code)
     3571       or num-rec modulo p-pck-num-rec = 0
     3572       then do:
     3573         if not ExpData1:write-xml(v-loc-file-name, integer(trunc(num-rec / p-pck-num-rec, 0))) then do:
     3574           undo _main, return error .
     3575         end.
     3576         v-loc-file-name = rum-fn_get-next-file-name ( file-name , integer(trunc(num-rec / p-pck-num-rec, 0))).
     3577               ExpData1:Route-data_clear-data ( ) .
     3578       end.
     3579     end.
     3580     run write-log-and-file in p-log-handle (
     3581           input 1
     3582         , input log-file-name
     3583         , input 1
     3584         , input substitute("Обработано товаров списка: &1, из них удачно: &2", num-rec, num-rec-ok)).
     3585     ExpData1:route-data_clear-xmlschema ( ).
     3586   end.
     3587   end procedure.
     3588   procedure load-ruleset-context :
     3589   define input parameter p-ruleset-id as integer no-undo .
     3590   define buffer buf_rule-call-param for ub.rule-call-param.
     3591     do
     3592     on error undo, return error
     3593     :
     3594     find first buf_rule-call-param no-lock where
     3595   buf_rule-call-param.codex_id = p-codex-id
     3596   and buf_rule-call-param.ruleset_id = p-ruleset-id
     3597   and buf_rule-call-param.call_id = p-call-id
     3598   and buf_rule-call-param.order_id = p-order-id
     3599   and buf_rule-call-param.rule_id = p-rule-id
     3600   and buf_rule-call-param.param-name = "p-xsd-file"
     3601    no-error.
     3602   if available buf_rule-call-param then do:
     3603   assign p-xsd-file = buf_rule-call-param.param-value-character.
     3604   end.
     3605    find first buf_rule-call-param no-lock where
     3606   buf_rule-call-param.codex_id = p-codex-id
     3607   and buf_rule-call-param.ruleset_id = p-ruleset-id
     3608   and buf_rule-call-param.call_id = p-call-id
     3609   and buf_rule-call-param.order_id = p-order-id
     3610   and buf_rule-call-param.rule_id = p-rule-id
     3611   and buf_rule-call-param.param-name = "p-pck-num-rec"
     3612    no-error.
     3613   if available buf_rule-call-param then do:
     3614   assign p-pck-num-rec = buf_rule-call-param.param-value-integer.
     3615   end.
     3616       case p-ruleset-id:
     3617         when 1 then do:
     3618           assign
     3619           v-sign = 1
     3620           v-current-host-code = p-host-code
     3621           v-current-obj-type = p-obj-type
     3622           v-current-obj-code = p-obj-code
     3623           v-current-db-num = g#db-num
     3624           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     3625           file-name  = p-process-file-name
     3626           .
     3627         end.
     3628       end case.
     3629     end.
     3630   end procedure.
