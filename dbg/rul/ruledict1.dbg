        1   block-level on error undo, throw.
        2   define input parameter        p-mode as character no-undo .
        3   define input parameter        p-silent as logical no-undo .
        4   define input-output parameter p-rec  as recid     no-undo .
        5   define input parameter        p-entry-id as integer no-undo .
        6   define input parameter        p-entry-type as character no-undo .
        7   define input parameter        p-script-al       as character no-undo .
        8   define input parameter        p-script-nl       as character no-undo .
        9   define input parameter        p-documentation as character no-undo .
       10   define variable vss-revision    as character no-undo init "$Revision$":U .
       11   define variable vss-author      as character no-undo init "$Author$":U .
       12   define variable vss-date        as character no-undo init "$Date$":U .
       13   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       14   define variable vss-archive     as character no-undo init "$Archive$":U .
       15   define variable vss-description as character no-undo init "Сохранение ruledict".
       16   procedure vss-get-info :
       17     define output parameter p-vss-revision    like vss-revision    no-undo .
       18     define output parameter p-vss-author      like vss-author      no-undo .
       19     define output parameter p-vss-date        like vss-date        no-undo .
       20     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       21     define output parameter p-vss-archive     like vss-archive     no-undo .
       22     define output parameter p-vss-description like vss-description no-undo .
       23     assign
       24       p-vss-revision    = vss-revision
       25       p-vss-author      = vss-author
       26       p-vss-date        = vss-date
       27       p-vss-workfile    = vss-workfile
       28       p-vss-archive     = vss-archive
       29       p-vss-description = vss-description
       30     .
       31   end procedure.
       32   procedure vss-get-parameters :
       33     define output parameter p-vss-parameters as character no-undo .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   define new global shared variable g#library  as handle no-undo .
       75   define new global shared variable g#library2 as handle no-undo .
       76   define   shared variable g#auto as logical no-undo.
       77   define   shared variable g#news as logical no-undo.
       78   define   shared variable g#oxml as logical no-undo.
       79   define   shared variable g#esys as logical no-undo.
       80   define   shared variable g#news-source-db as integer no-undo.
       81   define   shared variable g#esys-source-esys as integer no-undo.
       82   define   shared variable g#db-num as integer   no-undo .
       83   define   shared variable g#userid as character no-undo .
       84   define   shared variable g#passwd as character no-undo .
       85   define variable v-mess as character no-undo .
       86   define variable v-entry as character no-undo .
       87   define buffer buf_ruledict for ub.ruledict.
       88   define buffer buf_ruledict-param for ub.ruledict-param.
       89   if p-mode <> 'ДОБАВЛЕНИЕ':U
       90   AND p-mode <> 'ИЗМЕНЕНИЕ':U then do:
       91     message vss-workfile vss-revision vss-description skip
       92             "Неверный параметр p-mode - " p-mode
       93     view-as alert-box error .
       94     return error '':u.
       95   end.
       96   if g#db-num <> 0 then do:
       97     message vss-workfile vss-revision vss-description skip
       98             "Запрещено вызывать процедуру в УБД"
       99     view-as alert-box error .
      100     return error '':u.
      101   end.
      102   _main:
      103   do for buf_ruledict
      104   on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      105   on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
      106   on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
      107   :
      108     if lookup(p-entry-type, 'constant,operator,control,prop-name_,prop-name_host,prop-name_obj,node-name_,node-name_host,node-name_obj,prop-script,sum-id,rule,rule-profile,datatype,parameter':u) = 0
      109     and not (p-mode = 'ИЗМЕНЕНИЕ':U  and p-entry-id = 0)
      110     then do:
      111         assign
      112         v-mess = "Неверное значение типа термина".
      113         run err-mess in this-procedure ( input-output v-mess).
      114         return error (if p-silent = yes then v-mess else '':U).
      115     end.
      116     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      117       if p-entry-id = 0 then do:
      118         find last buf_ruledict no-lock  no-error.
      119         assign
      120         p-entry-id = buf_ruledict.entry-id + 1.
      121       end.
      122       find first buf_ruledict no-lock where
      123                buf_ruledict.entry-id = p-entry-id no-error.
      124       if available buf_ruledict then do:
      125         assign
      126         v-mess = "Уже существует СТАТЬЯ c таким id".
      127         run err-mess in this-procedure ( input-output v-mess).
      128         return error (if p-silent = yes then v-mess else '':U).
      129       end.
      130       create buf_ruledict.
      131       assign
      132       buf_ruledict.entry-type = p-entry-type
      133       buf_ruledict.entry-id = p-entry-id
      134       .
      135     end.
      136     if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      137       find first buf_ruledict exclusive-lock where
      138                 recid(buf_ruledict) = p-rec .
      139       if buf_ruledict.entry-id <> p-entry-id
      140       then do:
      141         assign
      142         v-mess = substitute("Для уже существующего термина невозможно изменение id&1" +
      143                                 "старое значения id: &2"
      144                                 , chr(10)
      145                                 , buf_ruledict.entry-id
      146                                 )
      147         .
      148         run err-mess in this-procedure ( input-output v-mess).
      149         return error (if p-silent = yes then v-mess else '':U).
      150       end.
      151       if buf_ruledict.entry-type <> p-entry-type then do:
      152         find first buf_ruledict-param no-lock where
      153                   buf_ruledict-param.entry-id = buf_ruledict.entry-id no-error.
      154         if available buf_ruledict-param then do:
      155         assign
      156         v-mess = substitute("Для уже существующего термина невозможно изменение типа,&1" +
      157                                 "если имеется привязанный параметр:&1" +
      158                                 "старое значение типа &2"
      159                                 , chr(10)
      160                                 , buf_ruledict.entry-type
      161                                 )
      162         .
      163         run err-mess in this-procedure ( input-output v-mess).
      164         return error (if p-silent = yes then v-mess else '':U).
      165         end.
      166       end.
      167     end.
      168     assign
      169     buf_ruledict.entry-type = p-entry-type
      170     buf_ruledict.script-nl = p-script-nl
      171     buf_ruledict.script-al = p-script-al
      172     buf_ruledict.documentation = p-documentation
      173     p-rec = recid(buf_ruledict)
      174     .
      175   end.
      176   PROCEDURE err-mess:
      177     DEFINE INPUT-OUTPUT PARAMETER p-mess as character No-UNDO.
      178     CASE p-silent:
      179       when yes then do:
      180         assign
      181         p-mess = substitute("Термин: id &1&2: &3"
      182                            , p-entry-id
      183                            , chr(10)
      184                            , p-mess)
      185         .
      186       end.
      187       when no then do:
      188         message
      189         p-mess
      190         view-as alert-box error .
      191       end.
      192     end.
      193   END PROCEDURE.
