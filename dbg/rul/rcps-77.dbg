     1211   DEFINE QUERY BR-rcp FOR
     1212         X_ruledict-param,
     1213         X_rp-rule-param,
     1214         tt-rule-call-param,
     1215         TERM_tt-rule-call-param SCROLLING.
     1216   DEFINE BROWSE BR-rcp
     1217     QUERY BR-rcp DISPLAY
     1218         X_rp-rule-param.rp-param-name COLUMN-LABEL "Название пар-ра!профайла" FORMAT "X(20)" width 16
     1219   term_tt-rule-call-param.codex_id COLUMN-LABEL "Кодекс"
     1220   term_tt-rule-call-param.ruleset_id COLUMN-LABEL "Набор"
     1221   term_tt-rule-call-param.order_id  COLUMN-LABEL "Порядок!вызова"
     1222   term_tt-rule-call-param.rule_id  COLUMN-LABEL "Правило"
     1223   term_tt-rule-call-param.profile_id  COLUMN-LABEL "Профайл"
     1224   term_tt-rule-call-param.once-more COLUMN-LABEL "№!Привязки"
     1225   (if lookup (term_tt-rule-call-param.param-data-type, 'character,date,datetime,datetime-tz,decimal,integer,void,logical,memptr,raw,recid,rowid,widget-handle,handle,blob,clob,class,com-handle,longchar,int64':U) > 0 then entry (lookup (term_tt-rule-call-param.param-data-type, 'character,date,datetime,datetime-tz,decimal,integer,void,logical,memptr,raw,recid,rowid,widget-handle,handle,blob,clob,class,com-handle,longchar,int64':U), 'строка,дата,дата-время,дата-время-з,десятичное,целое,пусто,логическое,память,двоичные,номер записи,Номер Записи,ссылка,ссылка,Больш.бин.объект,Больш.стр.объект,Объект,COM-объект,Длинная строка,64Целое':U) else term_tt-rule-call-param.param-data-type) COLUMN-LABEL "Тип пар-ра" FORMAT "X(12)"
     1226   term_tt-rule-call-param.param-num COLUMN-LABEL "№!пар-ра" FORMAT ">9"
     1227   TERM_tt-rule-call-param.p-index COLUMN-LABEL "Инд!екс" FORMAT ">9"
     1228   term_tt-rule-call-param.param-name COLUMN-LABEL "Название пар-ра!правила" FORMAT "X(16)"
     1229   term_tt-rule-call-param.param-label COLUMN-LABEL "Название пар-ра" FORMAT "X(255)" WIDTH 30
     1230   entry (lookup (term_tt-rule-call-param.param-mode, 'input,output,input-output,buffer,input table,output table,input-output table':u), 'вх,вых,вх-вых,курсор,вх табл,вых табл,вх/вых табл':u) COLUMN-LABEL "Вид!пар-ра"
     1231   get-param-value( INPUT term_tt-rule-call-param.param-data-type
     1232                   ,INPUT term_tt-rule-call-param.param-2-data-type
     1233                   ,INPUT term_tt-rule-call-param.param-3-data-type
     1234                   ,INPUT TERM_tt-rule-call-param.p-index
     1235                   ,INPUT term_tt-rule-call-param.param-value-character
     1236                   ,INPUT term_tt-rule-call-param.param-value-date
     1237                   ,INPUT term_tt-rule-call-param.param-value-decimal
     1238                   ,INPUT term_tt-rule-call-param.param-value-integer
     1239                   ,INPUT term_tt-rule-call-param.param-value-logical) COLUMN-LABEL "Значение" FORMAT "X(255)" WIDTH 26
     1240   (IF term_tt-rule-call-param.param-data-type = 'character':U
     1241    THEN term_tt-rule-call-param.param-value-character
     1242    ELSE '':U) COLUMN-LABEL "Значение!(строковое)" FORMAT "X(26)"
     1243   (IF term_tt-rule-call-param.param-data-type = 'date':U
     1244   THEN STRING(term_tt-rule-call-param.param-value-date, "99/99/9999")
     1245   ELSE '':U)    COLUMN-LABEL "Значение!(Дата)" FORMAT "X(10)" WIDTH 12
     1246   (IF term_tt-rule-call-param.param-data-type = 'decimal':U
     1247   THEN STRING(term_tt-rule-call-param.param-value-decimal)
     1248   ELSE '':U) COLUMN-LABEL "Значение!(Десятичное)"   FORMAT "X(16)"
     1249   (IF term_tt-rule-call-param.param-data-type = 'integer':U
     1250   THEN STRING(term_tt-rule-call-param.param-value-integer)
     1251   ELSE '':U) COLUMN-LABEL "Значение!(Целое)" FORMAT "X(10)"
     1252   (IF term_tt-rule-call-param.param-data-type = 'logical':U
     1253   THEN STRING(term_tt-rule-call-param.param-value-logical, "+/-")
     1254   ELSE '':U) COLUMN-LABEL "Значение!(Логическое)" FORMAT "X(2)"
     1255   calldscr(tt-rule-call-param.call_id) COLUMN-LABEL  "Точка вызова" FORMAT "X(40)"
     1256       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 6
     1257            FONT 4 ROW-HEIGHT-CHARS .67 FIT-LAST-COLUMN.
     1258   DEFINE FRAME Dialog-Frame
     1259        B-exit AT ROW 1 COL 1
     1260        b-quit AT ROW 1 COL 11
     1261        B-Help AT ROW 1 COL 95
     1262        BR-rcp AT ROW 2 COL 1 WIDGET-ID 100
     1263        t-rule-desadv-sts AT ROW 9 COL 16 WIDGET-ID 88
     1264        SPACE(25.00) SKIP(13.25)
     1265       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1266            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1267            TITLE ""
     1268            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
     1269   ASSIGN
     1270          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1271          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1272   ASSIGN
     1273          BR-rcp:HIDDEN  IN FRAME Dialog-Frame                = TRUE.
     1274   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1275   DO:
     1276     APPLY "END-ERROR":U TO SELF.
     1277   END.
     1278   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
     1279   DO:
     1280     RUN proc-save IN THIS-PROCEDURE  NO-ERROR.
     1281     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1282   END.
     1283   ON ROW-DISPLAY OF br-rcp IN frame Dialog-Frame
     1284   DO:
     1285     IF AVAIL tt-rule-call-param THEN DO:
     1286       RUN rcps_set-row-color IN THIS-PROCEDURE ( INPUT term_tt-rule-call-param.param-data-type).
     1287     END.
     1288   END.
     1289   ON f6 anywhere DO:
     1290     ASSIGN
     1291     br-rcp:VISIBLE IN FRAME Dialog-Frame = (NOT br-rcp:VISIBLE IN FRAME Dialog-Frame)
     1292     .
     1293   END.
     1294   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1295   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1296   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1297   on help of frame Dialog-Frame
     1298   do:
     1299     run gbl/app_help.p
     1300       (input this-procedure :file-name
     1301       ,input ''
     1302       ,input ?
     1303       ) no-error.
     1304     if error-status :error then do:
     1305       message
     1306         "Ошибка при вызове помощи"
     1307         error-status :get-message(1)
     1308         view-as alert-box .
     1309     end.
     1310   end.
     1311   run minbtn-set in this-procedure .
     1312   on choose of b-help in frame Dialog-Frame
     1313   do:
     1314     apply "help":u to frame Dialog-Frame .
     1315   end.
     1316   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1317   procedure minbtn-set :
     1318       do
     1319           on error undo, return error return-value
     1320           :
     1321           define variable ii              as integer       no-undo .
     1322           define variable fh              as widget-handle no-undo .
     1323           define variable hh              as widget-handle no-undo .
     1324           define variable v-h             as handle        extent 4 no-undo .
     1325           define variable v-name-button   as character     no-undo .
     1326           define variable v-help-old-x    as decimal       no-undo .
     1327           define variable v-help-old-y    as decimal       no-undo .
     1328           define variable v-help-old-size as decimal       no-undo .
     1329           define variable v-frame-width   as decimal       no-undo .
     1330           define variable jj              as integer       no-undo .
     1331           do
     1332               on error undo, return error
     1333               :
     1334               assign
     1335                   v-frame-width = frame Dialog-Frame:width - 0.3
     1336                   fh            = frame Dialog-Frame:first-child
     1337                   hh            = fh:first-child
     1338                   ii            = 1
     1339                   .
     1340               do while valid-handle(hh):
     1341                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1342                   do:
     1343                       case lc(hh:name) :
     1344                           when "b-help" then
     1345                               do:
     1346                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1347                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1348                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1349                                   hh:TOOLTIP = "Помощь" .
     1350                                   v-help-old-x = hh:column .
     1351                                   v-help-old-y = hh:row    .
     1352                                   v-help-old-size = hh:width .
     1353                                   hh:width-chars = 2.5 .
     1354                               end.
     1355                           when "b-print" then
     1356                               do:
     1357                                   hh:load-image("cmp/b-print.bmp":u) .
     1358                                   hh:TOOLTIP = "Печать" .
     1359                                   v-h[ii] = hh:handle .
     1360                                   ii = ii + 1 .
     1361                                   hh:width-chars = 3 .
     1362                               end.
     1363                           when "b-history" or
     1364                           when "b-hist" then
     1365                               do:
     1366                                   hh:load-image("cmp/b-hist.bmp":u) .
     1367                                   hh:TOOLTIP = "История" .
     1368                                   v-h[ii] = hh:handle .
     1369                                   ii = ii + 1 .
     1370                                   hh:width-chars = 3 .
     1371                               end.
     1372                           when "b-sch" then
     1373                               do:
     1374                                   hh:load-image("cmp/b-sch.bmp":u) .
     1375                                   hh:TOOLTIP = "Установка Фильтра" .
     1376                                   v-h[ii] = hh:handle .
     1377                                   ii = ii + 1 .
     1378                                   hh:width-chars = 3 .
     1379                               end.
     1380                           when "b-hist-user" then
     1381                               do:
     1382                                   hh:load-image("cmp/b-hist.bmp":u) .
     1383                                   hh:TOOLTIP = "История пользователя" .
     1384                                   ii = ii + 1 .
     1385                               end.
     1386                       end case.
     1387                   end.
     1388                   hh = hh:next-sibling.
     1389               end.
     1390               b-help:column = v-frame-width - b-help:width-chars.
     1391               jj = 0.
     1392               repeat ii = 4 to 1 by -1 :
     1393                   if valid-handle (v-h[ii] ) then
     1394                   do:
     1395                       jj  = jj + 1 .
     1396                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1397                       v-h[ii]:row    = v-help-old-y .
     1398                   end.
     1399               end.
     1400           end.
     1401       end.
     1402   end procedure.
     1403   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1404   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1405   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1406   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1407   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1408   define variable v-diasize-current-frame-height as decimal   no-undo .
     1409   define variable v-diasize-change-size          as logical   no-undo .
     1410   define variable v-diasize-resize-button        as handle    no-undo .
     1411   define variable v-diasize-wndmax               as logical   no-undo .
     1412   define variable v-diasize-wndstore             as logical   no-undo .
     1413   define variable v-diasize-proc-name            as character no-undo .
     1414   define variable v-diasize-browse-handle        as handle    no-undo .
     1415   define variable v-diasize-browse-number        as integer   no-undo .
     1416   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1417   define temp-table temp-diasize-handle no-undo
     1418     field handle-value  as handle
     1419     field save-position as decimal
     1420     index xpk is primary unique handle-value
     1421     .
     1422   define temp-table temp-browse-handle no-undo
     1423     field browse-type   as character
     1424     field browse-number as integer
     1425     field browse-handle as handle
     1426     field original-size as decimal
     1427     index xpk is primary unique browse-type browse-number
     1428     index xie browse-type browse-handle
     1429   .
     1430   procedure diasize_change-height :
     1431     define input  parameter p-change-value  as decimal   no-undo .
     1432     define input  parameter p-move-resize   as logical   no-undo .
     1433     define variable v-field-group-handle    as handle    no-undo .
     1434     define variable v-object-handle         as handle    no-undo .
     1435     define variable v-frame-height          as decimal   no-undo .
     1436     define variable v-frame-virtual-height  as decimal   no-undo .
     1437     define variable v-browse-height         as decimal   no-undo .
     1438     define variable v-window-height         as decimal   no-undo .
     1439     define variable v-window-virtual-height as decimal   no-undo .
     1440     define variable v-change-sign           as integer   no-undo .
     1441     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1442     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1443     if p-change-value > 0
     1444     then do:
     1445       if frame Dialog-Frame :height + p-change-value
     1446           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1447       then do:
     1448         assign
     1449           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1450                           - (frame Dialog-Frame :height-chars)
     1451         .
     1452         if p-change-value <= 0
     1453         then do:
     1454           run diasize_position-resize-button in this-procedure .
     1455           return .
     1456         end.
     1457       end.
     1458     end.
     1459     if p-change-value < 0
     1460     then do:
     1461       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1462       then do:
     1463         assign
     1464           p-change-value = v-diasize-orig-frame-height
     1465                          - (frame Dialog-Frame :height-chars)
     1466         .
     1467         if p-change-value >= 0
     1468         then do:
     1469           run diasize_position-resize-button in this-procedure .
     1470           return .
     1471         end.
     1472       end.
     1473     end.
     1474     if p-change-value >= 0
     1475     then do:
     1476       assign
     1477         v-change-sign = 1
     1478       .
     1479     end.
     1480     else do:
     1481       assign
     1482         v-change-sign = -1
     1483       .
     1484     end.
     1485     assign
     1486       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1487     .
     1488     if p-change-value = 0
     1489     then do:
     1490       run diasize_position-resize-button in this-procedure .
     1491       return .
     1492     end.
     1493     move_block:
     1494     do
     1495     on error undo move_block, retry move_block
     1496     :
     1497       if retry
     1498       then do:
     1499         do
     1500         on error undo move_block, leave move_block
     1501         :
     1502           if p-change-value > 0
     1503           then do:
     1504             for each buf_temp-diasize-handle
     1505             on error undo, next
     1506             :
     1507               assign
     1508                 v-object-handle = buf_temp-diasize-handle.handle-value
     1509               .
     1510               if v-object-handle <> v-diasize-resize-button
     1511               then do:
     1512                 assign
     1513                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1514                 .
     1515               end.
     1516             end.
     1517             assign
     1518               v-diasize-browse-handle :height = v-browse-height
     1519             .
     1520             for each buf_temp-browse-handle
     1521               where buf_temp-browse-handle.browse-type = 'height':u
     1522             on error undo, next
     1523             :
     1524               assign
     1525                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1526               .
     1527             end.
     1528             assign
     1529               frame Dialog-Frame :height = v-frame-height
     1530             .
     1531             if frame Dialog-Frame :scrollable = true
     1532             then do:
     1533               assign
     1534                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1535               .
     1536             end.
     1537             run diasize_position-resize-button in this-procedure .
     1538           end.
     1539           else do:
     1540             if frame Dialog-Frame :scrollable = true
     1541             then do:
     1542               assign
     1543                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1544               .
     1545             end.
     1546             assign
     1547               frame Dialog-Frame :height = v-frame-height
     1548             .
     1549             assign
     1550               v-diasize-browse-handle :height = v-browse-height
     1551             .
     1552             for each buf_temp-browse-handle
     1553               where buf_temp-browse-handle.browse-type = 'height':u
     1554             on error undo, next
     1555             :
     1556               assign
     1557                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1558               .
     1559             end.
     1560             for each buf_temp-diasize-handle
     1561             on error undo, next
     1562             :
     1563               assign
     1564                 v-object-handle = buf_temp-diasize-handle.handle-value
     1565               .
     1566               if v-object-handle <> v-diasize-resize-button
     1567               then do:
     1568                 assign
     1569                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1570                 .
     1571               end.
     1572             end.
     1573             run diasize_position-resize-button in this-procedure .
     1574           end.
     1575           assign
     1576             v-diasize-change-size = false
     1577           .
     1578           leave move_block .
     1579         end.
     1580       end.
     1581       assign
     1582         v-diasize-need-full-display = true
     1583       .
     1584       if v-diasize-change-size = false
     1585       then do:
     1586         assign
     1587           v-diasize-change-size = true
     1588         .
     1589       end.
     1590       else do:
     1591         return .
     1592       end.
     1593       assign
     1594         v-frame-height = frame Dialog-Frame :height
     1595         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1596         v-browse-height = v-diasize-browse-handle :height
     1597       .
     1598       for each buf_temp-browse-handle
     1599         where buf_temp-browse-handle.browse-type = 'height':u
     1600       :
     1601         assign
     1602           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1603         .
     1604       end.
     1605       for each buf_temp-diasize-handle
     1606       :
     1607         delete buf_temp-diasize-handle .
     1608       end.
     1609       assign
     1610         v-field-group-handle = frame Dialog-Frame :first-child
     1611       .
     1612       do while valid-handle(v-field-group-handle)
     1613       :
     1614         assign
     1615           v-object-handle = v-field-group-handle :first-child
     1616         .
     1617         do while valid-handle(v-object-handle)
     1618         :
     1619           if  v-object-handle <> v-diasize-browse-handle :handle
     1620           and can-query(v-object-handle, "row")
     1621           and can-query(v-object-handle, "height")
     1622           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1623           then do:
     1624             find first buf_temp-browse-handle
     1625               where buf_temp-browse-handle.browse-type   = 'height':u
     1626                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1627               no-error .
     1628             if available buf_temp-browse-handle
     1629             then do:
     1630             end.
     1631             else do:
     1632               create buf_temp-diasize-handle .
     1633               assign
     1634                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1635                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1636               .
     1637             end.
     1638           end.
     1639           assign
     1640             v-object-handle = v-object-handle :next-sibling
     1641           .
     1642         end.
     1643         assign
     1644           v-field-group-handle = v-field-group-handle :next-sibling
     1645         .
     1646       end.
     1647       do with frame Dialog-Frame
     1648       :
     1649         hide v-diasize-resize-button .
     1650         assign
     1651           v-diasize-resize-button :row    = 1
     1652           v-diasize-resize-button :column = 1
     1653         .
     1654       end.
     1655       if p-change-value > 0
     1656       then do:
     1657         if frame Dialog-Frame :scrollable = true
     1658         then do:
     1659           assign
     1660             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1661             no-error .
     1662           if error-status :error
     1663           or error-status :get-message(1) <> ""
     1664           then do:
     1665             undo move_block, retry move_block .
     1666           end.
     1667         end.
     1668         assign
     1669           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1670           no-error .
     1671         if error-status :error
     1672         or error-status :get-message(1) <> ""
     1673         then do:
     1674           undo move_block, retry move_block .
     1675         end.
     1676         assign
     1677           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1678           no-error .
     1679         if error-status :error
     1680         or error-status :get-message(1) <> ""
     1681         then do:
     1682           undo move_block, retry move_block .
     1683         end.
     1684         for each buf_temp-browse-handle
     1685           where buf_temp-browse-handle.browse-type = 'height':u
     1686         on error undo move_block, retry move_block
     1687         :
     1688           assign
     1689             buf_temp-browse-handle.browse-handle :height
     1690               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1691             no-error .
     1692           if error-status :error
     1693           or error-status :get-message(1) <> ""
     1694           then do:
     1695             undo move_block, retry move_block .
     1696           end.
     1697         end.
     1698         for each buf_temp-diasize-handle
     1699         on error undo move_block, retry move_block
     1700         :
     1701           assign
     1702             v-object-handle = buf_temp-diasize-handle.handle-value
     1703           .
     1704           if v-object-handle <> v-diasize-resize-button
     1705           then do:
     1706             assign
     1707               v-object-handle :row = v-object-handle :row + p-change-value
     1708               no-error .
     1709             if error-status :error
     1710             or error-status :get-message(1) <> ""
     1711             then do:
     1712               undo move_block, retry move_block .
     1713             end.
     1714           end.
     1715         end.
     1716       end.
     1717       else do:
     1718         for each buf_temp-diasize-handle
     1719         on error undo move_block, retry move_block
     1720         :
     1721           assign
     1722             v-object-handle = buf_temp-diasize-handle.handle-value
     1723           .
     1724           if v-object-handle <> v-diasize-resize-button
     1725           then do:
     1726             assign
     1727               v-object-handle :row = v-object-handle :row + p-change-value
     1728               no-error .
     1729             if error-status :error
     1730             or error-status :get-message(1) <> ""
     1731             then do:
     1732               undo move_block, retry move_block .
     1733             end.
     1734           end.
     1735         end.
     1736         assign
     1737           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1738           no-error .
     1739         if error-status :error
     1740         or error-status :get-message(1) <> ""
     1741         then do:
     1742           undo move_block, retry move_block .
     1743         end.
     1744         for each buf_temp-browse-handle
     1745           where buf_temp-browse-handle.browse-type = 'height':u
     1746         on error undo move_block, retry move_block
     1747         :
     1748           assign
     1749             buf_temp-browse-handle.browse-handle :height
     1750               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1751             no-error .
     1752           if error-status :error
     1753           or error-status :get-message(1) <> ""
     1754           then do:
     1755             undo move_block, retry move_block .
     1756           end.
     1757         end.
     1758         assign
     1759           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1760           no-error .
     1761         if error-status :error
     1762         or error-status :get-message(1) <> ""
     1763         then do:
     1764           undo move_block, retry move_block .
     1765         end.
     1766         if frame Dialog-Frame :scrollable = true
     1767         then do:
     1768           assign
     1769             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1770             no-error .
     1771           if error-status :error
     1772           or error-status :get-message(1) <> ""
     1773           then do:
     1774             undo move_block, retry move_block .
     1775           end.
     1776         end.
     1777       end.
     1778       if p-move-resize = true
     1779       then do:
     1780         run diasize_position-resize-button in this-procedure .
     1781       end.
     1782       if v-diasize-wndstore = true
     1783       then do:
     1784         if connected("ub") = true
     1785         then do:
     1786           define variable v-cntxt-db-num        as integer   no-undo .
     1787           define variable v-cntxt-userid        as character no-undo .
     1788           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1789                                             , OUTPUT v-cntxt-userid
     1790                                             ) .
     1791           run gbl/wndsizew.p
     1792             (input  v-cntxt-db-num
     1793             ,input  v-cntxt-userid
     1794             ,input  v-diasize-proc-name
     1795             ,input  'height':u
     1796             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1797             ) .
     1798         end.
     1799       end.
     1800     end.
     1801     assign
     1802       v-diasize-change-size = false
     1803     .
     1804   end procedure.
     1805   procedure diasize_set-height :
     1806     define input  parameter p-new-height  as decimal   no-undo .
     1807     define input  parameter p-move-resize as logical   no-undo .
     1808     do
     1809     on error undo, return error return-value
     1810     :
     1811       run diasize_change-height in this-procedure
     1812         (input  (p-new-height - frame Dialog-Frame :height)
     1813         ,input  p-move-resize
     1814         ) .
     1815     end.
     1816   end procedure.
     1817   procedure diasize_change-width :
     1818     define input  parameter p-change-value as decimal   no-undo .
     1819     define input  parameter p-move-resize  as logical   no-undo .
     1820     define variable v-field-group-handle   as handle    no-undo .
     1821     define variable v-object-handle        as handle    no-undo .
     1822     define variable v-frame-width          as decimal   no-undo .
     1823     define variable v-frame-virtual-width  as decimal   no-undo .
     1824     define variable v-browse-width         as decimal   no-undo .
     1825     define variable v-window-width         as decimal   no-undo .
     1826     define variable v-window-virtual-width as decimal   no-undo .
     1827     define variable v-change-sign          as integer   no-undo .
     1828     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1829     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1830     if p-change-value > 0
     1831     then do:
     1832       if frame Dialog-Frame :width + p-change-value >
     1833           session :width-chars
     1834       then do:
     1835         assign
     1836           p-change-value = session :width-chars - frame Dialog-Frame :width
     1837         .
     1838         if p-change-value <= 0
     1839         then do:
     1840           run diasize_position-resize-button in this-procedure .
     1841           return .
     1842         end.
     1843       end.
     1844     end.
     1845     if p-change-value < 0
     1846     then do:
     1847       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1848       then do:
     1849         assign
     1850           p-change-value = v-diasize-orig-frame-width
     1851                          - frame Dialog-Frame :width
     1852         .
     1853         if p-change-value >= 0
     1854         then do:
     1855           run diasize_position-resize-button in this-procedure .
     1856           return .
     1857         end.
     1858       end.
     1859     end.
     1860     if p-change-value >= 0
     1861     then do:
     1862       assign
     1863         v-change-sign = 1
     1864       .
     1865     end.
     1866     else do:
     1867       assign
     1868         v-change-sign = -1
     1869       .
     1870     end.
     1871     assign
     1872       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1873     .
     1874     if p-change-value = 0
     1875     then do:
     1876       run diasize_position-resize-button in this-procedure .
     1877       return .
     1878     end.
     1879     move_block:
     1880     do
     1881     on error undo move_block, leave move_block
     1882     :
     1883       if retry
     1884       then do:
     1885         do
     1886         on error undo move_block, leave move_block
     1887         :
     1888           if p-change-value > 0
     1889           then do:
     1890             for each buf_temp-diasize-handle
     1891             on error undo, next
     1892             :
     1893               assign
     1894                 v-object-handle = buf_temp-diasize-handle.handle-value
     1895               .
     1896               if v-object-handle <> v-diasize-resize-button
     1897               then do:
     1898                 assign
     1899                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1900                 .
     1901               end.
     1902             end.
     1903             assign
     1904               v-diasize-browse-handle :width = v-browse-width
     1905             .
     1906             for each buf_temp-browse-handle
     1907               where buf_temp-browse-handle.browse-type = 'width':u
     1908             on error undo, next
     1909             :
     1910               assign
     1911                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1912               .
     1913             end.
     1914             assign
     1915               frame Dialog-Frame :width = v-frame-width
     1916             .
     1917             if frame Dialog-Frame :scrollable = true
     1918             then do:
     1919               assign
     1920                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1921               .
     1922             end.
     1923             run diasize_position-resize-button in this-procedure .
     1924           end.
     1925           else do:
     1926             if frame Dialog-Frame :scrollable = true
     1927             then do:
     1928               assign
     1929                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1930               .
     1931             end.
     1932             assign
     1933               frame Dialog-Frame :width = v-frame-width
     1934             .
     1935             for each buf_temp-browse-handle
     1936               where buf_temp-browse-handle.browse-type = 'width':u
     1937             on error undo, next
     1938             :
     1939               assign
     1940                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1941               .
     1942             end.
     1943             assign
     1944               v-diasize-browse-handle :width = v-browse-width
     1945             .
     1946             for each buf_temp-diasize-handle
     1947             on error undo, next
     1948             :
     1949               assign
     1950                 v-object-handle = buf_temp-diasize-handle.handle-value
     1951               .
     1952               if v-object-handle <> v-diasize-resize-button
     1953               then do:
     1954                 assign
     1955                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1956                 .
     1957               end.
     1958             end.
     1959             run diasize_position-resize-button in this-procedure .
     1960           end.
     1961           assign
     1962             v-diasize-change-size = false
     1963           .
     1964           leave move_block .
     1965         end.
     1966       end.
     1967       assign
     1968         v-diasize-need-full-display = true
     1969       .
     1970       if v-diasize-change-size = false
     1971       then do:
     1972         assign
     1973           v-diasize-change-size = true
     1974         .
     1975       end.
     1976       else do:
     1977         return .
     1978       end.
     1979       assign
     1980         v-frame-width = frame Dialog-Frame :width
     1981         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1982         v-browse-width = v-diasize-browse-handle :width
     1983       .
     1984       for each buf_temp-browse-handle
     1985         where buf_temp-browse-handle.browse-type = 'width':u
     1986       :
     1987         assign
     1988           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1989         .
     1990       end.
     1991       for each buf_temp-diasize-handle
     1992       :
     1993         delete buf_temp-diasize-handle .
     1994       end.
     1995       assign
     1996         v-field-group-handle = frame Dialog-Frame :first-child
     1997       .
     1998       do while valid-handle(v-field-group-handle)
     1999       :
     2000         assign
     2001           v-object-handle = v-field-group-handle :first-child
     2002         .
     2003         do while valid-handle(v-object-handle)
     2004         :
     2005           if  v-object-handle <> v-diasize-browse-handle :handle
     2006           and v-object-handle <> v-diasize-resize-button
     2007           and can-query(v-object-handle, "row")
     2008           and can-query(v-object-handle, "height")
     2009           and ( v-object-handle :col + v-object-handle :width
     2010                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2011               )
     2012           then do:
     2013             find first buf_temp-browse-handle
     2014               where buf_temp-browse-handle.browse-type   = 'width':u
     2015                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2016               no-error .
     2017             if available buf_temp-browse-handle
     2018             then do:
     2019             end.
     2020             else do:
     2021               create buf_temp-diasize-handle .
     2022               assign
     2023                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2024                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2025               .
     2026             end.
     2027           end.
     2028           assign
     2029             v-object-handle = v-object-handle :next-sibling
     2030           .
     2031         end.
     2032         assign
     2033           v-field-group-handle = v-field-group-handle :next-sibling
     2034         .
     2035       end.
     2036       do with frame Dialog-Frame
     2037       :
     2038         hide v-diasize-resize-button .
     2039         v-diasize-resize-button :row = 1.
     2040         v-diasize-resize-button :column = 1.
     2041       end.
     2042       if p-change-value > 0
     2043       then do:
     2044         if frame Dialog-Frame :scrollable = true
     2045         then do:
     2046           assign
     2047             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2048             no-error .
     2049           if error-status :error
     2050           or error-status :get-message(1) <> ""
     2051           then do:
     2052             undo move_block, retry move_block.
     2053           end.
     2054         end.
     2055         assign
     2056           frame Dialog-Frame :width = v-frame-width + p-change-value
     2057           no-error .
     2058         if error-status :error
     2059         or error-status :get-message(1) <> ""
     2060         then do:
     2061           undo move_block, retry move_block.
     2062         end.
     2063         assign
     2064           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2065         no-error .
     2066         if error-status :error
     2067         or error-status :get-message(1) <> ""
     2068         then do:
     2069           undo move_block, retry move_block.
     2070         end.
     2071         for each buf_temp-browse-handle
     2072           where buf_temp-browse-handle.browse-type = 'width':u
     2073         on error undo move_block, retry move_block
     2074         :
     2075           assign
     2076             buf_temp-browse-handle.browse-handle :width
     2077               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2078             no-error .
     2079           if error-status :error
     2080           or error-status :get-message(1) <> ""
     2081           then do:
     2082             undo move_block, retry move_block .
     2083           end.
     2084         end.
     2085         for each buf_temp-diasize-handle
     2086         on error undo move_block, retry move_block
     2087         :
     2088           assign
     2089             v-object-handle = buf_temp-diasize-handle.handle-value
     2090           .
     2091           if v-object-handle <> v-diasize-resize-button
     2092           then do:
     2093             assign
     2094               v-object-handle :col = v-object-handle :col + p-change-value
     2095               no-error .
     2096             if error-status :error
     2097             or error-status :get-message(1) <> ""
     2098             then do:
     2099               undo move_block, retry move_block .
     2100             end.
     2101           end.
     2102         end.
     2103       end.
     2104       else do:
     2105         for each buf_temp-diasize-handle
     2106         on error undo move_block, retry move_block
     2107         :
     2108           assign
     2109             v-object-handle = buf_temp-diasize-handle.handle-value
     2110           .
     2111           if v-object-handle <> v-diasize-resize-button
     2112           then do:
     2113             assign
     2114               v-object-handle :col = v-object-handle :col + p-change-value
     2115               no-error .
     2116             if error-status :error
     2117             or error-status :get-message(1) <> ""
     2118             then do:
     2119               undo move_block, retry move_block .
     2120             end.
     2121           end.
     2122         end.
     2123         for each buf_temp-browse-handle
     2124           where buf_temp-browse-handle.browse-type = 'width':u
     2125         on error undo move_block, retry move_block
     2126         :
     2127           assign
     2128             buf_temp-browse-handle.browse-handle :width
     2129               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2130             no-error .
     2131           if error-status :error
     2132           or error-status :get-message(1) <> ""
     2133           then do:
     2134             undo move_block, retry move_block .
     2135           end.
     2136         end.
     2137         assign
     2138           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2139           no-error .
     2140         if error-status :error
     2141         or error-status :get-message(1) <> ""
     2142         then do:
     2143           undo move_block, retry move_block.
     2144         end.
     2145         assign
     2146           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2147         no-error .
     2148         if error-status :error
     2149         or error-status :get-message(1) <> ""
     2150         then do:
     2151           undo move_block, retry move_block.
     2152         end.
     2153         if frame Dialog-Frame :scrollable = true
     2154         then do:
     2155           assign
     2156             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2157           no-error .
     2158           if error-status :error
     2159           or error-status :get-message(1) <> ""
     2160           then do:
     2161             undo move_block, retry move_block.
     2162           end.
     2163         end.
     2164       end.
     2165       if p-move-resize
     2166       then do:
     2167         run diasize_position-resize-button in this-procedure .
     2168       end.
     2169       if v-diasize-wndstore = true
     2170       then do:
     2171         if connected("ub") = true
     2172         then do:
     2173           define variable v-cntxt-db-num        as integer   no-undo .
     2174           define variable v-cntxt-userid        as character no-undo .
     2175           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2176                                             , OUTPUT v-cntxt-userid
     2177                                             ) .
     2178           run gbl/wndsizew.p
     2179             (input  v-cntxt-db-num
     2180             ,input  v-cntxt-userid
     2181             ,input  v-diasize-proc-name
     2182             ,input  'width':u
     2183             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2184             ) .
     2185         end.
     2186       end.
     2187     end.
     2188     assign
     2189       v-diasize-change-size = false
     2190     .
     2191   end procedure.
     2192   procedure diasize_set-width :
     2193     define input  parameter p-new-width  as decimal   no-undo .
     2194     define input  parameter p-move-resize as logical   no-undo .
     2195     do
     2196     on error undo, return error return-value
     2197     :
     2198       run diasize_change-width in this-procedure
     2199         (input  (p-new-width - frame Dialog-Frame :width)
     2200         ,input  p-move-resize
     2201         ) .
     2202     end.
     2203   end procedure.
     2204   procedure diasize_position-resize-button :
     2205     do with frame Dialog-Frame
     2206     :
     2207       hide v-diasize-resize-button .
     2208       assign
     2209         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2210                     - 1
     2211                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2212         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2213                     - 1
     2214                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2215       .
     2216       view v-diasize-resize-button .
     2217     end.
     2218   end procedure.
     2219   on alt-right anywhere
     2220   do:
     2221     run diasize_change-width in this-procedure
     2222       (input 1
     2223       ,input true
     2224       ) .
     2225     return no-apply .
     2226   end.
     2227   on alt-left anywhere
     2228   do:
     2229     run diasize_change-width in this-procedure
     2230       (input -1
     2231       ,input true
     2232       ) .
     2233     return no-apply .
     2234   end.
     2235   on alt-down anywhere
     2236   do:
     2237     run diasize_change-height in this-procedure
     2238       (input 1
     2239       ,input true
     2240       ) .
     2241     return no-apply .
     2242   end.
     2243   on alt-up anywhere
     2244   do:
     2245     run diasize_change-height in this-procedure
     2246       (input -1
     2247       ,input true
     2248       ) .
     2249     return no-apply .
     2250   end.
     2251   on alt-enter of frame Dialog-Frame
     2252   do:
     2253     run diasize_maximize in this-procedure
     2254       (input  ?
     2255       ).
     2256     return no-apply .
     2257   end.
     2258   procedure diasize_end-move :
     2259     do
     2260     on error undo, return error return-value
     2261     :
     2262       define variable v-row-delta as decimal   no-undo .
     2263       define variable v-col-delta as decimal   no-undo .
     2264       define variable v-new-row as decimal   no-undo .
     2265       define variable v-new-col as decimal   no-undo .
     2266       assign
     2267         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2268         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2269       .
     2270       assign
     2271         v-row-delta = v-new-row - frame Dialog-Frame :height
     2272         v-col-delta = v-new-col - frame Dialog-Frame :width
     2273       .
     2274       run diasize_change-height in this-procedure
     2275         (input v-row-delta
     2276         ,input true
     2277         ) .
     2278       run diasize_change-width in this-procedure
     2279         (input v-col-delta
     2280         ,input true
     2281         ) .
     2282     end.
     2283   end procedure.
     2284   procedure diasize_maximize :
     2285     define input  parameter p-action as logical   no-undo .
     2286     do
     2287     on error undo, return error return-value
     2288     :
     2289       if p-action = ?
     2290       then do:
     2291         if v-diasize-need-maximize = true
     2292         then do:
     2293           assign
     2294             p-action = true
     2295           .
     2296         end.
     2297         else do:
     2298           assign
     2299             p-action = false
     2300           .
     2301         end.
     2302       end.
     2303       if p-action = true
     2304       then do:
     2305         run diasize_change-height in this-procedure
     2306           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2307               - frame Dialog-Frame :height-chars
     2308           ,input true
     2309           ) .
     2310         run diasize_change-width in this-procedure
     2311           (input session :width-chars
     2312               - frame Dialog-Frame :width-chars
     2313           ,input true
     2314           ) .
     2315         assign
     2316           v-diasize-need-maximize = false
     2317         .
     2318       end.
     2319       else do:
     2320         run diasize_change-width in this-procedure
     2321           (input v-diasize-orig-frame-width
     2322               - frame Dialog-Frame :width-chars
     2323           ,input true
     2324           ) .
     2325         run diasize_change-height in this-procedure
     2326           (input v-diasize-orig-frame-height
     2327               - frame Dialog-Frame :height-chars
     2328           ,input true
     2329           ) .
     2330         assign
     2331           v-diasize-need-maximize = true
     2332         .
     2333       end.
     2334     end.
     2335   end procedure.
     2336   procedure diasize_restore-orig-size :
     2337     do
     2338     on error undo, return error return-value
     2339     :
     2340       assign
     2341         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2342         v-diasize-current-frame-height = frame Dialog-Frame :height
     2343       .
     2344       run diasize_set-height in this-procedure
     2345         (input  v-diasize-orig-frame-height
     2346         ,input  true
     2347         ) .
     2348       run diasize_set-width in this-procedure
     2349         (input  v-diasize-orig-frame-width
     2350         ,input  true
     2351         ) .
     2352     end.
     2353   end procedure.
     2354   procedure diasize_restore-current-size :
     2355     do
     2356     on error undo, return error return-value
     2357     :
     2358       run diasize_set-height in this-procedure
     2359         (input  v-diasize-current-frame-height
     2360         ,input  true
     2361         ) .
     2362       run diasize_set-width in this-procedure
     2363         (input  v-diasize-current-frame-width
     2364         ,input  true
     2365         ) .
     2366     end.
     2367   end procedure.
     2368   procedure diasize_set-browse-handle :
     2369     define input  parameter p-browse-handle as handle   no-undo .
     2370     define buffer buf_temp-browse-handle for temp-browse-handle .
     2371     do
     2372     on error undo, return error return-value
     2373     :
     2374       assign
     2375         v-diasize-browse-handle = p-browse-handle
     2376       .
     2377       for each buf_temp-browse-handle
     2378       on error undo, return error return-value
     2379       :
     2380         delete buf_temp-browse-handle .
     2381       end.
     2382     end.
     2383   end procedure.
     2384   procedure diasize_add_browse :
     2385     define input  parameter p-browse-type   as character no-undo .
     2386     define input  parameter p-browse-handle as handle    no-undo .
     2387     define buffer buf_temp-browse-handle for temp-browse-handle .
     2388     do
     2389     on error undo, return error return-value
     2390     :
     2391       assign
     2392         v-diasize-browse-number = v-diasize-browse-number + 1
     2393       .
     2394       create buf_temp-browse-handle .
     2395       assign
     2396         buf_temp-browse-handle.browse-type   = p-browse-type
     2397         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2398         buf_temp-browse-handle.browse-handle = p-browse-handle
     2399       .
     2400     end.
     2401   end procedure.
     2402   procedure diasize_init :
     2403     define variable v-default-value    as logical   no-undo .
     2404     define variable v-restore-saved    as logical   no-undo .
     2405     define variable v-resize-value-str as character no-undo .
     2406     do
     2407     on error undo, return error return-value
     2408     :
     2409       do with frame Dialog-Frame
     2410       :
     2411         assign
     2412           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2413           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2414           v-diasize-browse-handle     = browse BR-rcp :handle
     2415         .
     2416         create button v-diasize-resize-button
     2417         assign
     2418           parent        = frame Dialog-Frame :first-child
     2419           label         = "s"
     2420           height-pixels = 16
     2421           width-pixels  = 16
     2422           visible       = true
     2423           sensitive     = true
     2424           movable       = true
     2425           triggers:
     2426             on end-move persistent run diasize_end-move in this-procedure .
     2427           end triggers.
     2428         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2429         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2430         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2431         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2432         assign
     2433           v-diasize-wndmax = false
     2434         .
     2435         if connected("ub") = true
     2436         then do:
     2437           define variable v-cntxt-db-num        as integer   no-undo .
     2438           define variable v-cntxt-userid        as character no-undo .
     2439           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2440                                             , OUTPUT v-cntxt-userid
     2441                                             ) .
     2442           run gbl/wndpar_r.p
     2443             (input  v-cntxt-db-num
     2444             ,input  v-cntxt-userid
     2445             ,input  'wndmax':U
     2446             ,output v-diasize-wndmax
     2447             ,output v-default-value
     2448             ) .
     2449         end.
     2450         assign
     2451           v-diasize-wndstore = false
     2452         .
     2453         if connected("ub") = true
     2454         then do:
     2455           run gbl/wndpar_r.p
     2456             (input  v-cntxt-db-num
     2457             ,input  v-cntxt-userid
     2458             ,input  'wndstore':U
     2459             ,output v-diasize-wndstore
     2460             ,output v-default-value
     2461             ) .
     2462         end.
     2463         assign
     2464           v-diasize-proc-name = entry(1, program-name(2), '.')
     2465         .
     2466         if v-diasize-wndstore = true
     2467         then do:
     2468           assign
     2469             v-restore-saved = false
     2470           .
     2471           if connected("ub") = true
     2472           then do:
     2473             run gbl/wndsizer.p
     2474               (input  v-cntxt-db-num
     2475               ,input  v-cntxt-userid
     2476               ,input  v-diasize-proc-name
     2477               ,input  'height':u
     2478               ,output v-resize-value-str
     2479               ) .
     2480             if v-resize-value-str <> '':U
     2481             then do:
     2482               run diasize_change-height in this-procedure
     2483                 (input  integer(v-resize-value-str)
     2484                 ,input  true
     2485                 ) .
     2486               assign
     2487                 v-restore-saved = true
     2488               .
     2489             end.
     2490           end.
     2491           if connected("ub") = true
     2492           then do:
     2493             run gbl/wndsizer.p
     2494               (input  v-cntxt-db-num
     2495               ,input  v-cntxt-userid
     2496               ,input  v-diasize-proc-name
     2497               ,input  'width':u
     2498               ,output v-resize-value-str
     2499               ) .
     2500             if v-resize-value-str <> '':U
     2501             then do:
     2502               run diasize_change-width in this-procedure
     2503                 (input  integer(v-resize-value-str)
     2504                 ,input  true
     2505                 ) .
     2506               assign
     2507                 v-restore-saved = true
     2508               .
     2509             end.
     2510           end.
     2511           if v-restore-saved <> true
     2512           then do:
     2513             if v-diasize-wndmax = true
     2514             then do:
     2515               run diasize_maximize in this-procedure
     2516                 (input  true
     2517                 ) .
     2518             end.
     2519           end.
     2520         end.
     2521         else do:
     2522           if v-diasize-wndmax = true
     2523           then do:
     2524             run diasize_maximize in this-procedure
     2525               (input  true
     2526               ) .
     2527           end.
     2528         end.
     2529       end.
     2530     end.
     2531   end procedure.
     2532   procedure diasize_need-full-display :
     2533     define output parameter p-need-full-display as logical   no-undo .
     2534     do
     2535     on error undo, return error return-value
     2536     :
     2537       assign
     2538         p-need-full-display = v-diasize-need-full-display
     2539       .
     2540       assign
     2541         v-diasize-need-full-display = false
     2542       .
     2543     end.
     2544   end procedure.
     2545   procedure get-context :
     2546      define output parameter p-db-num as integer          no-undo.
     2547      define output parameter p-user-id as character        no-undo.
     2548      define variable v-login               as character    no-undo.
     2549      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2550      define buffer buf_user-login  for ub.user-login .
     2551      do
     2552      on error undo, return error
     2553      :
     2554            FIND FIRST buf_sys-ctrl no-lock.
     2555            ASSIGN
     2556               v-login = USERID("ub")
     2557               p-db-num = buf_sys-ctrl.db-num
     2558            .
     2559            FIND FIRST buf_user-login
     2560                 WHERE buf_user-login.db-num = p-db-num
     2561                   AND buf_user-login.user-login = v-login
     2562                 no-lock
     2563                 no-error
     2564                 .
     2565            IF AVAILABLE buf_user-login
     2566            THEN DO:
     2567               assign
     2568                  p-user-id = buf_user-login.user-id
     2569               .
     2570            END.
     2571      end.
     2572   end procedure.
     2573       run diasize_init in this-procedure .
     2574   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2575   procedure rcps_get-profile-id :
     2576   define output parameter p-local-profile-id as integer no-undo .
     2577   do
     2578   on error undo, return error:
     2579   p-local-profile-id = p-profile-id.
     2580   end.
     2581   end procedure.
     2582   PROCEDURE rcps_fill-table :
     2583   define input parameter p-clear-params as logical no-undo .
     2584   if p-clear-params then do:
     2585   FOR EACH tt-rule-call-param:
     2586       DELETE tt-rule-call-param.
     2587   END.
     2588   end.
     2589    FOR EACH tt0-rule-call-param:
     2590      IF p-mode <> 'ДОБАВЛЕНИЕ':U THEN DO:
     2591        IF p-call-id <> '':U and p-call-id <> tt0-rule-call-param.call_id THEN do:
     2592           NEXT.
     2593        end.
     2594        IF p-codex-id <> 0 and p-codex-id <> tt0-rule-call-param.codex_id THEN do:
     2595          NEXT.
     2596        end.
     2597        IF p-ruleset-id <> 0 and p-ruleset-id <> tt0-rule-call-param.ruleset_id THEN do:
     2598          NEXT.
     2599        end.
     2600        IF p-rule-id <> 0 and p-rule-id <> tt0-rule-call-param.RULE_id THEN do:
     2601          NEXT.
     2602        end.
     2603        IF p-order-id <> ? and p-order-id <> tt0-rule-call-param.order_id THEN do:
     2604          NEXT.
     2605        end.
     2606      END.
     2607      if lookup("hidden", tt0-rule-call-param.param-3-data-type) > 0 then do:
     2608        next.
     2609      end.
     2610      IF p-list-mode = 'rp-rule-param':U
     2611      or p-list-mode = 'rp-rule-param':U  + chr(44) + 'все':U
     2612      THEN DO:
     2613         IF p-profile-id <> 0 AND p-profile-id <> tt0-rule-call-param.profile_id THEN do:
     2614           NEXT.
     2615         end.
     2616         IF p-once-more <> ? AND p-once-more <> tt0-rule-call-param.once-more THEN do:
     2617           NEXT.
     2618         end.
     2619      END.
     2620      CREATE tt-rule-call-param.
     2621      BUFFER-COPY tt0-rule-call-param TO tt-rule-call-param.
     2622   END.
     2623   END PROCEDURE.
     2624   procedure rcps_get-value :
     2625   DEFINE INPUT PARAMETER p-profile-id AS integer NO-UNDO.
     2626   DEFINE INPUT PARAMETER p-once-more AS integer NO-UNDO.
     2627   DEFINE INPUT PARAMETER p-call-id AS CHARACTER NO-UNDO.
     2628   DEFINE INPUT PARAMETER p-rp-param-name AS CHARACTER NO-UNDO.
     2629   DEFINE INPUT-output PARAMETER pp-index AS integer NO-UNDO.
     2630   DEFINE output parameter p-value-character AS CHARACTER NO-UNDO.
     2631   DEFINE output parameter p-value-date AS date NO-UNDO.
     2632   DEFINE output parameter p-value-decimal AS decimal NO-UNDO.
     2633   DEFINE output parameter p-value-integer AS integer NO-UNDO.
     2634   DEFINE output parameter p-value-logical AS logical NO-UNDO.
     2635   define variable v-current-index as integer no-undo init -1.
     2636   define variable v-start as logical no-undo init yes.
     2637   DEFINE BUFFER buf_ruledict-param FOR ub.ruledict-param.
     2638   DEFINE BUFFER buf_rp-rule-param FOR ub.rp-rule-param.
     2639   DEFINE BUFFER buf_tt-rule-call-param FOR tt-rule-call-param.
     2640   DEFINE BUFFER buf_term_tt-rule-call-param FOR tt-rule-call-param.
     2641   do
     2642   on error undo, return error
     2643   :
     2644   FOR FIRST buf_rp-rule-param WHERE
     2645         buf_rp-rule-param.profile_id = p-profile-id
     2646     AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     2647   , each buf_tt-rule-call-param WHERE
     2648      buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     2649   AND buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     2650   AND buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     2651   AND buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     2652   AND buf_tt-rule-call-param.p-index >= pp-index
     2653    ,each buf_term_tt-rule-call-param where
     2654          buf_term_tt-rule-call-param.call_id = buf_tt-rule-call-param.call_id
     2655      and buf_term_tt-rule-call-param.codex_id = buf_tt-rule-call-param.codex_id
     2656      and buf_term_tt-rule-call-param.ruleset_id = buf_tt-rule-call-param.ruleset_id
     2657      and buf_term_tt-rule-call-param.order_id = buf_tt-rule-call-param.order_id
     2658      and buf_term_tt-rule-call-param.param-name = buf_tt-rule-call-param.param-name
     2659      and buf_term_tt-rule-call-param.p-index = buf_tt-rule-call-param.p-index
     2660     by buf_term_tt-rule-call-param.call_id
     2661     by buf_term_tt-rule-call-param.codex_id
     2662     by buf_term_tt-rule-call-param.ruleset_id
     2663     by buf_term_tt-rule-call-param.order_id
     2664     by buf_term_tt-rule-call-param.param-name
     2665     by buf_term_tt-rule-call-param.p-index :
     2666       if v-start
     2667       then do:
     2668         assign
     2669         pp-index = buf_term_tt-rule-call-param.p-index
     2670         p-value-character = buf_term_tt-rule-call-param.param-value-character
     2671         p-value-date      = buf_term_tt-rule-call-param.param-value-date
     2672         p-value-decimal   = buf_term_tt-rule-call-param.param-value-decimal
     2673         p-value-integer   = buf_term_tt-rule-call-param.param-value-integer
     2674         p-value-logical   = buf_term_tt-rule-call-param.param-value-logical
     2675         v-start = no
     2676         .
     2677       end.
     2678       else do:
     2679         if buf_term_tt-rule-call-param.p-index > pp-index then do:
     2680           v-current-index = buf_term_tt-rule-call-param.p-index.
     2681           leave.
     2682         end.
     2683             end.
     2684     end.
     2685     pp-index = v-current-index.
     2686   end.
     2687   end procedure.
     2688   PROCEDURE rcps_proc-b-add :
     2689   DEFINE INPUT PARAMETER p-profile-id AS integer NO-UNDO.
     2690   DEFINE INPUT PARAMETER p-once-more AS integer NO-UNDO.
     2691   DEFINE INPUT PARAMETER p-call-id AS CHARACTER NO-UNDO.
     2692   DEFINE INPUT PARAMETER p-rp-param-name AS CHARACTER NO-UNDO.
     2693   DEFINE INPUT PARAMETER p-index AS integer NO-UNDO.
     2694   define variable v-ind as integer no-undo .
     2695   define buffer buf_tt-rule-call-param for tt-rule-call-param.
     2696   define buffer buf0_tt-rule-call-param for tt-rule-call-param.
     2697   define buffer buf2_tt-rule-call-param for tt-rule-call-param.
     2698   define buffer buf_rp-rule-param for ub.rp-rule-param.
     2699   FOR FIRST buf_rp-rule-param WHERE
     2700             buf_rp-rule-param.profile_id = p-profile-id
     2701         AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     2702       , first buf0_tt-rule-call-param WHERE
     2703          buf0_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     2704      AND buf0_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     2705      AND buf0_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     2706      AND buf0_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name:
     2707     LEAVE.
     2708   END.
     2709   IF NOT AVAILABLE buf0_tt-rule-call-param THEN do:
     2710     BELL.
     2711     RETURN.
     2712   END.
     2713   for each buf_rp-rule-param where
     2714           buf_rp-rule-param.rp-param-name = p-rp-param-name
     2715       and buf_rp-rule-param.profile_id = p-profile-id,
     2716       first buf_tt-rule-call-param where
     2717           buf_tt-rule-call-param.call_id = buf0_tt-rule-call-param.call_id
     2718       and buf_tt-rule-call-param.profile_id = buf_rp-rule-param.profile_id
     2719       and buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     2720       and buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     2721       and buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     2722       and buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     2723       and buf_tt-rule-call-param.once-more = buf0_tt-rule-call-param.once-more
     2724       and buf_tt-rule-call-param.p-index = p-index:
     2725     RETURN.
     2726   END.
     2727   IF lookup("LIST", buf0_tt-rule-call-param.param-3-data-type) = 0
     2728   and lookup("SORTED-LIST", buf0_tt-rule-call-param.param-3-data-type) = 0
     2729   THEN DO:
     2730     BELL.
     2731     RETURN.
     2732   END.
     2733   IF buf0_tt-rule-call-param.p-index <> 0 THEN DO:
     2734     BELL.
     2735     RETURN.
     2736   END.
     2737   find last buf_tt-rule-call-param where
     2738            buf_tt-rule-call-param.call_id = buf0_tt-rule-call-param.call_id
     2739        and buf_tt-rule-call-param.codex_id = buf0_tt-rule-call-param.codex_id
     2740        and buf_tt-rule-call-param.ruleset_id = buf0_tt-rule-call-param.ruleset_id
     2741        and buf_tt-rule-call-param.order_id = buf0_tt-rule-call-param.order_id
     2742        and buf_tt-rule-call-param.param-name = buf0_tt-rule-call-param.param-name no-error .
     2743   if available buf_tt-rule-call-param
     2744   and (lookup("LIST", buf_tt-rule-call-param.param-3-data-type) > 0
     2745        or
     2746        lookup("SORTED-LIST", buf_tt-rule-call-param.param-3-data-type) > 0
     2747        )
     2748   and buf_tt-rule-call-param.p-index > 0 then do:
     2749     v-ind = buf_tt-rule-call-param.p-index.
     2750   end.
     2751   for each buf_rp-rule-param where
     2752           buf_rp-rule-param.rp-param-name = p-rp-param-name
     2753       and buf_rp-rule-param.profile_id = p-profile-id,
     2754       first buf_tt-rule-call-param where
     2755           buf_tt-rule-call-param.call_id = buf0_tt-rule-call-param.call_id
     2756       and buf_tt-rule-call-param.profile_id = buf_rp-rule-param.profile_id
     2757       and buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     2758       and buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     2759       and buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     2760       and buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     2761       and buf_tt-rule-call-param.once-more = buf0_tt-rule-call-param.once-more
     2762       and buf_tt-rule-call-param.p-index = 0
     2763   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2764   on stop   undo, return error substitute( "&1. stop", vss-workfile )
     2765   on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     2766   :
     2767     create buf2_tt-rule-call-param.
     2768     buffer-copy buf_tt-rule-call-param
     2769     except p-index
     2770     to buf2_tt-rule-call-param
     2771     assign
     2772     buf2_tt-rule-call-param.p-index = v-ind + 1
     2773     .
     2774   end.
     2775   END PROCEDURE.
     2776   PROCEDURE rcps_proc-b-del :
     2777   DEFINE INPUT PARAMETER p-profile-id AS integer NO-UNDO.
     2778   DEFINE INPUT PARAMETER p-once-more AS integer NO-UNDO.
     2779   DEFINE INPUT PARAMETER p-call-id AS CHARACTER NO-UNDO.
     2780   DEFINE INPUT PARAMETER p-rp-param-name AS CHARACTER NO-UNDO.
     2781   DEFINE INPUT PARAMETER pp-index AS integer NO-UNDO.
     2782   define variable v-ind as integer no-undo .
     2783   define variable v-once-more as integer no-undo .
     2784   define variable v-call-id as character no-undo .
     2785   define buffer buf0_tt-rule-call-param for tt-rule-call-param.
     2786   define buffer buf_tt-rule-call-param for tt-rule-call-param.
     2787   define buffer buf_rp-rule-param for ub.rp-rule-param.
     2788   if pp-index = 0 then do:
     2789     undo, return error substitute("Нельзя удалять корневой параметр &1 (индекс = 0)", p-rp-param-name).
     2790   end.
     2791   FOR first buf_rp-rule-param WHERE
     2792             buf_rp-rule-param.profile_id = p-profile-id
     2793         AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     2794       , first buf0_tt-rule-call-param WHERE
     2795          buf0_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     2796      AND buf0_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     2797      AND buf0_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     2798      AND buf0_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     2799      AND buf0_tt-rule-call-param.p-index = pp-index
     2800      :
     2801     LEAVE.
     2802   END.
     2803   IF NOT AVAILABLE buf0_tt-rule-call-param THEN do:
     2804     FOR first buf_rp-rule-param WHERE
     2805               buf_rp-rule-param.profile_id = p-profile-id
     2806           AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     2807         , last buf0_tt-rule-call-param WHERE
     2808           buf0_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     2809       AND buf0_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     2810       AND buf0_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     2811       AND buf0_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     2812       AND buf0_tt-rule-call-param.p-index > pp-index :
     2813       leave.
     2814     end.
     2815     IF NOT AVAILABLE buf0_tt-rule-call-param THEN do:
     2816     return "not-found".
     2817     end.
     2818     else do:
     2819       return ''.
     2820     end.
     2821   END.
     2822   IF lookup("LIST", buf0_tt-rule-call-param.param-3-data-type) = 0
     2823   and lookup("SORTED-LIST", buf0_tt-rule-call-param.param-3-data-type) = 0
     2824   THEN DO:
     2825     undo, return error substitute("Можно удалять только параметры типа LIST и SORTED-LIST").
     2826   END.
     2827   IF lookup("READ-ONLY", buf0_tt-rule-call-param.param-3-data-type) > 0 THEN DO:
     2828     undo, return error substitute("Нельзя удалять  параметры типа READ-ONLY").
     2829   END.
     2830   for each buf_rp-rule-param where
     2831           buf_rp-rule-param.rp-param-name = buf_rp-rule-param.rp-param-name
     2832       and buf_rp-rule-param.profile_id = buf_rp-rule-param.profile_id,
     2833       each buf_tt-rule-call-param where
     2834           buf_tt-rule-call-param.call_id = p-call-id
     2835       and buf_tt-rule-call-param.profile_id = buf_rp-rule-param.profile_id
     2836       and buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     2837       and buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     2838       and buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     2839       and buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     2840       and buf_tt-rule-call-param.once-more = p-once-more
     2841       and buf_tt-rule-call-param.p-index = pp-index
     2842   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2843   on stop   undo, return error substitute( "&1. stop", vss-workfile )
     2844   on endkey undo, return error substitute( "&1. endkey", vss-workfile ):
     2845       DELETE buf_tt-rule-call-param.
     2846   end.
     2847   return ''.
     2848   END PROCEDURE.
     2849   PROCEDURE rcps_proc-save0 :
     2850   FOR EACH tt-rule-call-param
     2851   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2852   on stop   undo , return error substitute( "&1. stop", vss-workfile )
     2853   on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     2854   :
     2855      find  FIRST tt0-rule-call-param NO-LOCK WHERE
     2856               tt0-rule-call-param.codex_id = tt-rule-call-param.codex_id
     2857          AND  tt0-rule-call-param.ruleset_id = tt-rule-call-param.ruleset_id
     2858          AND tt0-rule-call-param.call_id = tt-rule-call-param.call_id
     2859          AND tt0-rule-call-param.order_id = tt-rule-call-param.order_id
     2860          AND tt0-rule-call-param.param-name = tt-rule-call-param.param-name
     2861          AND tt0-rule-call-param.p-index = tt-rule-call-param.p-index no-error .
     2862      if not available tt0-rule-call-param
     2863      and (lookup("LIST", tt-rule-call-param.param-3-data-type) > 0
     2864           OR
     2865           lookup("SORTED-LIST", tt-rule-call-param.param-3-data-type) > 0
     2866           )
     2867      and tt-rule-call-param.p-index > 0 then do:
     2868        create tt0-rule-call-param.
     2869      end.
     2870      BUFFER-COPY tt-rule-call-param TO tt0-rule-call-param.
     2871   END.
     2872   FOR EACH tt0-rule-call-param
     2873   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2874   on stop   undo , return error substitute( "&1. stop", vss-workfile )
     2875   on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     2876   :
     2877     if tt0-rule-call-param.p-index = 0 then next.
     2878     if lookup("hidden", tt0-rule-call-param.param-3-data-type) > 0 then next.
     2879     find  FIRST tt-rule-call-param NO-LOCK WHERE
     2880             tt-rule-call-param.codex_id = tt0-rule-call-param.codex_id
     2881         AND tt-rule-call-param.ruleset_id = tt0-rule-call-param.ruleset_id
     2882         AND tt-rule-call-param.call_id = tt0-rule-call-param.call_id
     2883         AND tt-rule-call-param.order_id = tt0-rule-call-param.order_id
     2884         AND tt-rule-call-param.param-name = tt0-rule-call-param.param-name
     2885         AND tt-rule-call-param.p-index = tt0-rule-call-param.p-index no-error .
     2886     if not available tt-rule-call-param
     2887     and (lookup("LIST", tt0-rule-call-param.param-3-data-type) > 0
     2888         OR
     2889         lookup("SORTED-LIST", tt0-rule-call-param.param-3-data-type) > 0
     2890         )
     2891     and tt0-rule-call-param.p-index > 0
     2892     then do:
     2893        IF p-call-id <> '':U and p-call-id <> tt0-rule-call-param.call_id THEN do:
     2894           NEXT.
     2895        end.
     2896        IF p-codex-id <> 0 and p-codex-id <> tt0-rule-call-param.codex_id THEN do:
     2897          NEXT.
     2898        end.
     2899        IF p-ruleset-id <> 0 and p-ruleset-id <> tt0-rule-call-param.ruleset_id THEN do:
     2900          NEXT.
     2901        end.
     2902        IF p-rule-id <> 0 and p-rule-id <> tt0-rule-call-param.RULE_id THEN do:
     2903          NEXT.
     2904        end.
     2905        IF p-order-id <> ? and p-order-id <> tt0-rule-call-param.order_id THEN do:
     2906          NEXT.
     2907        end.
     2908       IF p-list-mode = 'rp-rule-param':U
     2909       or p-list-mode = 'rp-rule-param':U  + chr(44) + 'все':U
     2910       THEN DO:
     2911         IF p-profile-id <> 0 AND p-profile-id <> tt0-rule-call-param.profile_id THEN do:
     2912           NEXT.
     2913         end.
     2914         IF p-once-more <> ? AND p-once-more <> tt0-rule-call-param.once-more THEN do:
     2915           NEXT.
     2916         end.
     2917       end.
     2918       delete tt0-rule-call-param.
     2919     end.
     2920   end.
     2921   END PROCEDURE.
     2922   PROCEDURE rcps_set-value :
     2923   DEFINE INPUT PARAMETER p-profile-id AS integer NO-UNDO.
     2924   DEFINE INPUT PARAMETER p-once-more AS integer NO-UNDO.
     2925   DEFINE INPUT PARAMETER p-call-id AS CHARACTER NO-UNDO.
     2926   DEFINE INPUT PARAMETER p-rp-param-name AS CHARACTER NO-UNDO.
     2927   DEFINE INPUT PARAMETER pp-index AS integer NO-UNDO.
     2928   DEFINE INPUT parameter p-value-character AS CHARACTER NO-UNDO.
     2929   DEFINE INPUT parameter p-value-date AS date NO-UNDO.
     2930   DEFINE INPUT parameter p-value-decimal AS decimal NO-UNDO.
     2931   DEFINE INPUT parameter p-value-integer AS integer NO-UNDO.
     2932   DEFINE INPUT parameter p-value-logical AS logical NO-UNDO.
     2933   DEFINE VARIABLE v-codex-id AS integer NO-UNDO.
     2934   DEFINE VARIABLE v-ruleset-id AS integer NO-UNDO.
     2935   DEFINE VARIABLE v-order-id AS integer NO-UNDO.
     2936   DEFINE VARIABLE V-param-name AS character NO-UNDO.
     2937   define variable v-found as logical no-undo .
     2938   DEFINE BUFFER buf_tt-rule-call-param FOR tt-rule-call-param.
     2939   DEFINE BUFFER buf_rp-rule-param FOR ub.rp-rule-param.
     2940   FOR FIRST buf_rp-rule-param WHERE
     2941             buf_rp-rule-param.profile_id = p-profile-id
     2942         AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     2943       , first buf_tt-rule-call-param WHERE
     2944          buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     2945      AND buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     2946      AND buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     2947      AND buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name:
     2948     ASSIGN
     2949     v-codex-id = buf_tt-rule-call-param.codex_id
     2950     v-ruleset-id = buf_tt-rule-call-param.ruleset_id
     2951     v-order-id = buf_tt-rule-call-param.order_id
     2952     V-PARAM-NAME = buf_tt-rule-call-param.PARAM-NAME
     2953     .
     2954     LEAVE.
     2955   END.
     2956   CASE p-list-mode:
     2957     WHEN 'rp-rule-param':U THEN DO:
     2958       if pp-index > 0
     2959       then do:
     2960         FOR EACH  buf_rp-rule-param NO-LOCK where
     2961             buf_rp-rule-param.profile_id = p-profile-id
     2962             AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     2963             ,EACH buf_tt-rule-call-param WHERE
     2964                 buf_tt-rule-call-param.profile_id = p-profile-id
     2965             AND buf_tt-rule-call-param.once-more = p-once-more
     2966             AND buf_tt-rule-call-param.call_id = p-CALL-id
     2967             AND buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     2968             AND buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     2969             AND buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     2970             AND buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     2971             AND buf_tt-rule-call-param.p-index = pp-index
     2972         ON error undo, return error :
     2973           v-found = yes.
     2974         end.
     2975       end.
     2976       if not v-found then do:
     2977         run rcps_proc-b-add in this-procedure (
     2978                                                  input p-profile-id
     2979                                                 ,input p-once-more
     2980                                                 ,input p-call-id
     2981                                                 ,
     2982                                                  input p-rp-param-name
     2983                                                 ,input pp-index).
     2984       end.
     2985       FOR EACH  buf_rp-rule-param NO-LOCK where
     2986           buf_rp-rule-param.profile_id = p-profile-id
     2987           AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     2988           ,EACH buf_tt-rule-call-param WHERE
     2989               buf_tt-rule-call-param.profile_id = p-profile-id
     2990           AND buf_tt-rule-call-param.once-more = p-once-more
     2991           AND buf_tt-rule-call-param.call_id = p-CALL-id
     2992           AND buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     2993           AND buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     2994           AND buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     2995           AND buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     2996           AND buf_tt-rule-call-param.p-index = pp-index
     2997         ON error undo, return error :
     2998         assign
     2999         buf_tt-rule-call-param.param-value-character = p-value-character
     3000         buf_tt-rule-call-param.param-value-date      = p-value-date
     3001         buf_tt-rule-call-param.param-value-decimal   = p-value-decimal
     3002         buf_tt-rule-call-param.param-value-integer   = p-value-integer
     3003         buf_tt-rule-call-param.param-value-logical   = p-value-logical
     3004         .
     3005       END.
     3006     END.
     3007     WHEN 'rule-call-param':U THEN DO:
     3008       FIND FIRST buf_tt-rule-call-param WHERE
     3009           buf_tt-rule-call-param.call_id = p-call-id
     3010       AND buf_tt-rule-call-param.codex_id = v-codex-id
     3011       AND buf_tt-rule-call-param.ruleset_id = v-ruleset-id
     3012       AND buf_tt-rule-call-param.order_id = v-order-id
     3013       AND buf_tt-rule-call-param.param-name = V-PARAM-NAME
     3014       AND buf_tt-rule-call-param.p-index = pp-index.
     3015       assign
     3016       buf_tt-rule-call-param.param-value-character = p-value-character
     3017       buf_tt-rule-call-param.param-value-date      = p-value-date
     3018       buf_tt-rule-call-param.param-value-decimal   = p-value-decimal
     3019       buf_tt-rule-call-param.param-value-integer   = p-value-integer
     3020       buf_tt-rule-call-param.param-value-logical   = p-value-logical
     3021       .
     3022     END.
     3023   END CASE.
     3024   END PROCEDURE.
     3025   procedure rcps_get-rule-on-off :
     3026   define input parameter p-codex-id as integer no-undo .
     3027   define input parameter p-ruleset-id as integer no-undo .
     3028   define input parameter p-rule-id as integer no-undo .
     3029   define input parameter p-profile-id as integer no-undo .
     3030   define input parameter p-once-more as integer no-undo .
     3031   define output parameter p-on-off as logical no-undo .
     3032   if valid-handle(p-call-handle)
     3033   and lookup("rcpscont_get-rule-on-off", p-call-handle:internal-entries) > 0 then do:
     3034     run rcpscont_get-rule-on-off in p-call-handle (
     3035                                              input p-codex-id
     3036                                             ,input p-ruleset-id
     3037                                             ,input p-rule-id
     3038                                             ,input p-profile-id
     3039                                             ,input p-once-more
     3040                                             ,output p-on-off) no-error.
     3041   end.
     3042   end procedure.
     3043   procedure rcps_set-rule-on-off :
     3044   define input parameter p-codex-id as integer no-undo .
     3045   define input parameter p-ruleset-id as integer no-undo .
     3046   define input parameter p-rule-id as integer no-undo .
     3047   define input parameter p-profile-id as integer no-undo .
     3048   define input parameter p-once-more as integer no-undo .
     3049   define input parameter p-on-off as logical no-undo .
     3050   if valid-handle(p-call-handle)
     3051   and lookup("rcpscont_get-rule-on-off", p-call-handle:internal-entries) > 0 then do:
     3052     run rcpscont_set-rule-on-off in p-call-handle (
     3053                                              input p-codex-id
     3054                                             ,input p-ruleset-id
     3055                                             ,input p-rule-id
     3056                                             ,input p-profile-id
     3057                                             ,input p-once-more
     3058                                             ,input p-on-off) no-error.
     3059   end.
     3060   end procedure.
     3061   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3062   PROCEDURE rcps_MyEnable0 :
     3063   DEFINE VARIABLE v-ii AS INTEGER NO-UNDO.
     3064   DEFINE VARIABLE v-ch0 AS widget-handle NO-UNDO.
     3065   ASSIGN
     3066   term_tt-rule-call-param.param-label:RESIZABLE IN browse br-rcp = YES
     3067   X_rp-rule-param.rp-param-name:RESIZABLE IN browse br-rcp = YES
     3068   .
     3069   ASSIGN
     3070   v-ch0 = br-rcp:FIRST-COLUMN IN FRAME Dialog-Frame.
     3071   REPEAT WHILE valid-handle(v-ch0):
     3072      IF v-ch0:LABEL = "Значение!(строковое)" THEN DO:
     3073        v-ch[1] = v-ch0.
     3074        v-ch0:VISIBLE = NO.
     3075      END.
     3076      IF v-ch0:LABEL = "Значение!(Дата)" THEN DO:
     3077        v-ch[2] = v-ch0.
     3078        v-ch0:VISIBLE = NO.
     3079      END.
     3080      IF v-ch0:LABEL = "Значение!(Десятичное)" THEN DO:
     3081        v-ch[3] = v-ch0.
     3082        v-ch0:VISIBLE = NO.
     3083      END.
     3084      IF v-ch0:LABEL = "Значение!(Целое)" THEN DO:
     3085        v-ch[4] = v-ch0.
     3086        v-ch0:VISIBLE = NO.
     3087      END.
     3088      IF v-ch0:LABEL = "Значение!(Логическое)" THEN DO:
     3089        v-ch[5] = v-ch0.
     3090        v-ch0:VISIBLE = NO.
     3091      END.
     3092      IF v-ch0:LABEL = "Точка вызова" THEN DO:
     3093        v-ch[6] = v-ch0.
     3094      END.
     3095      IF v-ch0:LABEL = "Значение" THEN
     3096      v-ch0:RESIZABLE = YES.
     3097      v-ch0 = v-ch0:NEXT-COLUMN.
     3098   END.
     3099   assign
     3100   X_rp-rule-param.rp-param-name:resizable in browse br-rcp = yes
     3101   term_tt-rule-call-param.param-name:resizable in browse br-rcp = yes
     3102   term_tt-rule-call-param.param-label:resizable in browse br-rcp = yes
     3103   .
     3104   CASE p-list-mode:
     3105     WHEN 'rule-call-param':U THEN DO:
     3106        ASSIGN
     3107        X_rp-rule-param.rp-param-name:VISIBLE IN BROWSE br-rcp = NO
     3108        .
     3109     END.
     3110     WHEN 'rp-rule-param':U
     3111     or
     3112     when 'rp-rule-param':U + chr(44) + 'все':U
     3113     THEN DO:
     3114       assign
     3115       term_tt-rule-call-param.codex_id:VISIBLE IN BROWSE br-rcp = NO
     3116       term_tt-rule-call-param.ruleset_id:VISIBLE IN BROWSE br-rcp = NO
     3117       term_tt-rule-call-param.rule_id:VISIBLE IN BROWSE br-rcp = NO
     3118       term_tt-rule-call-param.order_id:VISIBLE IN BROWSE br-rcp = NO
     3119       term_tt-rule-call-param.param-name:VISIBLE IN BROWSE br-rcp = NO
     3120       term_tt-rule-call-param.param-num:VISIBLE IN BROWSE br-rcp = NO
     3121       .
     3122     END.
     3123   END CASE.
     3124    IF p-call-id <> '':U THEN DO:
     3125      v-ch[6]:VISIBLE = NO.
     3126    END.
     3127     IF p-profile-id <> 0 THEN DO:
     3128      term_tt-rule-call-param.profile_id :VISIBLE IN BROWSE br-rcp= NO.
     3129    END.
     3130     IF p-rule-id <> 0 THEN DO:
     3131      term_tt-rule-call-param.RULE_id :VISIBLE IN BROWSE br-rcp= NO.
     3132    END.
     3133     IF p-once-more <> 0 THEN DO:
     3134      term_tt-rule-call-param.once-more :VISIBLE IN BROWSE br-rcp= NO.
     3135    END.
     3136   END PROCEDURE.
     3137   PROCEDURE rcps_Openbr :
     3138   CASE p-list-mode:
     3139     WHEN 'rp-rule-param':U THEN DO:
     3140         OPEN QUERY br-rcp
     3141         FOR EACH  X_ruledict-param NO-LOCK WHERE X_ruledict-param.entry-id = v-rcps-entry-id
     3142             ,FIRST X_rp-rule-param WHERE
     3143                 X_rp-rule-param.profile_id = p-profile-id
     3144             AND X_rp-rule-param.rp-param-name = X_ruledict-param.param-name
     3145           , first tt-rule-call-param WHERE
     3146              tt-rule-call-param.codex_id = X_rp-rule-param.codex_id
     3147          AND tt-rule-call-param.ruleset_id = X_rp-rule-param.ruleset_id
     3148          AND tt-rule-call-param.rule_id = X_rp-rule-param.rule_id
     3149          AND tt-rule-call-param.param-name = X_rp-rule-param.rule-param-name
     3150            ,each term_tt-rule-call-param where
     3151                  term_tt-rule-call-param.call_id = tt-rule-call-param.call_id
     3152              and term_tt-rule-call-param.codex_id = tt-rule-call-param.codex_id
     3153              and term_tt-rule-call-param.ruleset_id = tt-rule-call-param.ruleset_id
     3154              and term_tt-rule-call-param.order_id = tt-rule-call-param.order_id
     3155              and term_tt-rule-call-param.param-name = tt-rule-call-param.param-name
     3156         BY tt-rule-call-param.call_id
     3157         BY tt-rule-call-param.codex_id
     3158         BY tt-rule-call-param.ruleset_id
     3159         BY tt-rule-call-param.order_id
     3160         BY tt-rule-call-param.param-num.
     3161     END.
     3162   END CASE.
     3163   apply "ENTRY" to br-rcp in frame Dialog-Frame .
     3164   APPLy "VALUE-CHANGED" to br-rcp.
     3165   END PROCEDURE.
     3166   PROCEDURE rcps_proc-b-chg PRIVATE :
     3167   DEFINE VARIABLE v-rec1 AS Rowid NO-UNDO.
     3168   DEFINE VARIABLE v-rec2 AS Rowid NO-UNDO.
     3169   DEFINE VARIABLE v-rec3 AS Rowid NO-UNDO.
     3170   DEFINE VARIABLE v-rec4 AS Rowid NO-UNDO.
     3171   define variable v-param-data-type as character no-undo .
     3172   define variable v-rid-list as character no-undo .
     3173   IF NOT AVAILABLE TERM_tt-rule-call-param  THEN DO:
     3174     RETURN ERROR.
     3175   END.
     3176   ASSIGN
     3177   v-rec1 = rowid(X_ruledict-param)
     3178   v-rec2 = rowid(X_rp-rule-param)
     3179   v-rec3 = Rowid(tt-rule-call-param)
     3180   v-rec4 = Rowid(term_tt-rule-call-param)
     3181   .
     3182   run rcps_openbr in this-procedure .
     3183   REPOSITION br-rcp TO Rowid v-rec1, v-rec2,v-rec3, v-rec4 NO-ERROR.
     3184   IF ERROR-STATUS:ERROR THEN DO:
     3185     REPOSITION br-rcp TO ROW 1 NO-ERROR.
     3186   END.
     3187   APPLY "ENTRY" TO br-rcp in frame Dialog-Frame .
     3188   APPLY "VALUE-CHANGED" TO br-rcp in frame Dialog-Frame .
     3189   END PROCEDURE.
     3190   PROCEDURE rcps_set-row-color :
     3191   DEFINE INPUT PARAMETER p-data-type AS CHARACTER NO-UNDO.
     3192   ASSIGN
     3193   v-ch[1]:FGCOLOR = GREY_COLOR
     3194   v-ch[1]:BGCOLOR = GREY_Color
     3195   v-ch[1]:PFCOLOR = GREY_Color
     3196   v-ch[2]:FGCOLOR = GREY_COLOR
     3197   v-ch[2]:BGCOLOR = GREY_Color
     3198   v-ch[2]:PFCOLOR = GREY_Color
     3199   v-ch[3]:FGCOLOR = GREY_COLOR
     3200   v-ch[3]:BGCOLOR = GREY_Color
     3201   v-ch[3]:PFCOLOR = GREY_Color
     3202   v-ch[4]:FGCOLOR = GREY_COLOR
     3203   v-ch[4]:BGCOLOR = GREY_Color
     3204   v-ch[4]:PFCOLOR = GREY_Color
     3205   v-ch[5]:FGCOLOR = GREY_COLOR
     3206   v-ch[5]:BGCOLOR = GREY_Color
     3207   v-ch[5]:PFCOLOR = GREY_Color
     3208   .
     3209   CASE entry(1, p-data-type):
     3210        WHEN 'character':U THEN DO:
     3211         ASSIGN
     3212         v-ch[1]:FGCOLOR = BLACK_COLOR
     3213         v-ch[1]:BGCOLOR = WHITE_Color.
     3214       END.
     3215       WHEN 'decimal':U THEN DO:
     3216         ASSIGN
     3217         v-ch[3]:FGCOLOR = BLACK_COLOR
     3218         v-ch[3]:BGCOLOR = WHITE_Color.
     3219       END.
     3220       WHEN 'integer':U THEN DO:
     3221         ASSIGN
     3222         v-ch[4]:FGCOLOR = BLACK_COLOR
     3223         v-ch[4]:BGCOLOR = WHITE_Color.
     3224       END.
     3225       WHEN 'date':U THEN DO:
     3226         ASSIGN
     3227         v-ch[2]:FGCOLOR = BLACK_COLOR
     3228         v-ch[2]:BGCOLOR = WHITE_Color.
     3229        END.
     3230        WHEN 'logical':U THEN DO:
     3231          ASSIGN
     3232          v-ch[5]:FGCOLOR = BLACK_COLOR
     3233          v-ch[5]:BGCOLOR = WHITE_Color.
     3234        END.
     3235   END CASE.
     3236   END PROCEDURE.
     3237   MAIN-BLOCK:
     3238   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3239      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3240   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3241     run mainmenu_getcntxt in parparentproc
     3242       (output v-cntxt-db-num
     3243       ,output v-cntxt-userid
     3244       ,output v-cntxt-level
     3245       ,output v-cntxt-host-code-obj
     3246       ,output v-cntxt-obj-type
     3247       ,output v-cntxt-obj-code
     3248       ,output v-cntxt-db-num-obj
     3249       ,output v-cntxt-is-admin
     3250       ) .
     3251      run gbl/dftempl.p ( input 'rp-rule-param':U
     3252                        , output v-dflt-rec) no-error.
     3253       if error-status:error then dO:
     3254         message
     3255         vss-workfile vss-revision vss-description skip
     3256         "Невозможно найти recid template записи в таблице rp-rule-param"
     3257         view-as alert-box error .
     3258         return error.
     3259       end.
     3260       run gbl/dftempl.p ( input 'ruledict-param':U
     3261                         , output v-rp-dflt-rec) no-error.
     3262        if error-status:error then dO:
     3263          message
     3264          vss-workfile vss-revision vss-description skip
     3265          "Невозможно найти recid template записи в таблице ruledict-param"
     3266          view-as alert-box error .
     3267          return error.
     3268        end.
     3269     IF p-list-mode = 'rp-rule-param':U
     3270     THEN DO:
     3271       FIND FIRST buf_rule-profile NO-LOCK WHERE
     3272                 buf_rule-profile.profile_id = p-profile-id.
     3273       run gen-key-rec in this-procedure ( input 'rule-profile':U
     3274                                       ,input buffer buf_rule-profile:handle
     3275                                       ,output v-uniq-key-rec).
     3276       FIND FIRST buf_ruledict NO-LOCK WHERE
     3277                 buf_ruledict.entry-type = 'rule-profile':U
     3278          AND  buf_ruledict.uniq-key-rec = v-uniq-key-rec.
     3279       v-rcps-entry-id = buf_ruledict.entry-id.
     3280     END.
     3281     ELSE DO:
     3282        MESSAGE
     3283        substitute("Неверное значение параметра p-list-mode=&1", p-list-mode)
     3284        VIEW-AS alert-box.
     3285     END.
     3286     if p-call-id begins 'schedule':U then do:
     3287       v-running-mode = yes.
     3288     end.
     3289     RUN rcps_fill-table IN THIS-PROCEDURE ( input yes).
     3290     RUN Myenable in THIS-PROCEDURE.
     3291     WAIT-FOR GO OF FRAME Dialog-Frame.
     3292   END.
     3293   RUN disable_UI.
     3294   PROCEDURE disable_UI :
     3295     HIDE FRAME Dialog-Frame.
     3296   END PROCEDURE.
     3297   PROCEDURE enable_UI :
     3298     DISPLAY t-rule-desadv-sts
     3299         WITH FRAME Dialog-Frame.
     3300     ENABLE B-exit b-quit B-Help BR-rcp t-rule-desadv-sts
     3301         WITH FRAME Dialog-Frame.
     3302     VIEW FRAME Dialog-Frame.
     3303   END PROCEDURE.
     3304   PROCEDURE MyEnable :
     3305   define variable v-list as character no-undo .
     3306   define variable glog as logical no-undo .
     3307   define variable v-index-id as integer no-undo .
     3308   define variable v-value-character as character no-undo .
     3309   define variable v-value-date as date no-undo .
     3310   define variable v-value-decimal as decimal no-undo .
     3311   define variable v-value-integer as integer no-undo .
     3312   define variable v-value-logical as logical no-undo .
     3313   define variable v-shop-code as integer no-undo .
     3314   define buffer buf_clob-bind for ub.clob-bind.
     3315   run rcps_Myenable0 in this-procedure .
     3316   run rcps_get-rule-on-off in this-procedure ( input 18
     3317                                               ,input 105
     3318                                               ,input 2078
     3319                                               ,input p-profile-id
     3320                                               ,input p-once-more
     3321                                               ,output t-rule-desadv-sts ).
     3322   ASSIGN
     3323   term_tt-rule-call-param.param-label:RESIZABLE IN browse br-rcp = YES
     3324   X_rp-rule-param.rp-param-name:RESIZABLE IN browse br-rcp = YES
     3325   .
     3326   DEFINE VARIABLE v-ch0 AS widget-handle NO-UNDO.
     3327   ASSIGN
     3328   v-ch0 = br-rcp:FIRST-COLUMN IN FRAME Dialog-Frame.
     3329   REPEAT WHILE valid-handle(v-ch0):
     3330      IF v-ch0:LABEL = "Значение!(строковое)" THEN DO:
     3331        v-ch[1] = v-ch0.
     3332        v-ch0:VISIBLE = NO.
     3333      END.
     3334      IF v-ch0:LABEL = "Значение!(Дата)" THEN DO:
     3335        v-ch[2] = v-ch0.
     3336        v-ch0:VISIBLE = NO.
     3337      END.
     3338      IF v-ch0:LABEL = "Значение!(Десятичное)" THEN DO:
     3339        v-ch[3] = v-ch0.
     3340        v-ch0:VISIBLE = NO.
     3341      END.
     3342      IF v-ch0:LABEL = "Значение!(Целое)" THEN DO:
     3343        v-ch[4] = v-ch0.
     3344        v-ch0:VISIBLE = NO.
     3345      END.
     3346      IF v-ch0:LABEL = "Значение!(Логическое)" THEN DO:
     3347        v-ch[5] = v-ch0.
     3348        v-ch0:VISIBLE = NO.
     3349      END.
     3350      IF v-ch0:LABEL = "Точка вызова" THEN DO:
     3351        v-ch[6] = v-ch0.
     3352      END.
     3353      IF v-ch0:LABEL = "Значение" THEN
     3354      v-ch0:RESIZABLE = YES.
     3355      v-ch0 = v-ch0:NEXT-COLUMN.
     3356   END.
     3357   assign
     3358   X_rp-rule-param.rp-param-name:resizable in browse br-rcp = yes
     3359   term_tt-rule-call-param.param-name:resizable in browse br-rcp = yes
     3360   term_tt-rule-call-param.param-label:resizable in browse br-rcp = yes
     3361   .
     3362   CASE p-list-mode:
     3363     WHEN 'rule-call-param':U THEN DO:
     3364        ASSIGN
     3365        X_rp-rule-param.rp-param-name:VISIBLE IN BROWSE br-rcp = NO
     3366        .
     3367     END.
     3368     WHEN 'rp-rule-param':U
     3369     or
     3370     when 'rp-rule-param':U + chr(44) + 'все':U
     3371     THEN DO:
     3372       assign
     3373       term_tt-rule-call-param.codex_id:VISIBLE IN BROWSE br-rcp = NO
     3374       term_tt-rule-call-param.ruleset_id:VISIBLE IN BROWSE br-rcp = NO
     3375       term_tt-rule-call-param.rule_id:VISIBLE IN BROWSE br-rcp = NO
     3376       term_tt-rule-call-param.order_id:VISIBLE IN BROWSE br-rcp = NO
     3377       term_tt-rule-call-param.param-name:VISIBLE IN BROWSE br-rcp = NO
     3378       term_tt-rule-call-param.param-num:VISIBLE IN BROWSE br-rcp = NO
     3379       .
     3380     END.
     3381   END CASE.
     3382    IF p-call-id <> '':U THEN DO:
     3383      v-ch[6]:VISIBLE = NO.
     3384    END.
     3385     IF p-profile-id <> 0 THEN DO:
     3386      term_tt-rule-call-param.profile_id :VISIBLE IN BROWSE br-rcp= NO.
     3387    END.
     3388     IF p-rule-id <> 0 THEN DO:
     3389      term_tt-rule-call-param.RULE_id :VISIBLE IN BROWSE br-rcp= NO.
     3390    END.
     3391     IF p-once-more <> 0 THEN DO:
     3392      term_tt-rule-call-param.once-more :VISIBLE IN BROWSE br-rcp= NO.
     3393    END.
     3394   display
     3395   t-rule-desadv-sts
     3396   with frame Dialog-Frame .
     3397   VIEW FRAME Dialog-Frame.
     3398   ENABLE
     3399   t-rule-desadv-sts WHEN p-mode <> 'ПРОСМОТР':U
     3400   B-exit WHEN p-mode <> 'ПРОСМОТР':U
     3401   b-quit
     3402   WITH FRAME Dialog-Frame.
     3403   VIEW FRAME Dialog-Frame.
     3404   IF p-mode = 'ПРОСМОТР':U THEN DO:
     3405      ASSIGN
     3406      b-quit:COLUMN = 1
     3407      b-quit:LABEL = "&Выход".
     3408      HIDE
     3409      b-exit
     3410      IN FRAME Dialog-Frame.
     3411   END.
     3412   ASSIGN
     3413   FRAME Dialog-Frame:TITLE = substitute("Параметры обмена данными по заказам поставщику через систему  Exite-EDI (профайл &1)", p-profile-id).
     3414   END PROCEDURE.
     3415   PROCEDURE proc-save :
     3416   define variable v-ii as integer   no-undo .
     3417   v-ii = 0.
     3418   assign
     3419   frame Dialog-Frame
     3420   t-rule-desadv-sts
     3421   .
     3422   run rcps_set-rule-on-off in this-procedure ( input 18
     3423                                              ,input 105
     3424                                              ,input 2078
     3425                                              ,input p-profile-id
     3426                                              ,input p-once-more
     3427                                              ,input t-rule-desadv-sts).
     3428   run rcps_proc-save0 in this-procedure .
     3429   END PROCEDURE.
