     1180   DEFINE BUFFER call_tt-rule-call-param FOR tt-rule-call-param.
     1181   define buffer term_tt-rule-call-param for tt-rule-call-param.
     1182   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1183     define variable v-cntxt-db-num        as integer   no-undo .
