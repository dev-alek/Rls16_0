     1187     define variable v-cntxt-obj-type      as character no-undo .
     1188     define variable v-cntxt-obj-code      as integer   no-undo .
     1189     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1190     define variable v-cntxt-is-admin      as logical   no-undo .
     1191   define new global shared variable g#library  as handle no-undo .
     1192   define new global shared variable g#library2 as handle no-undo .
     1193   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
