     5387   procedure edocsord_export :
     5388   define parameter buffer buf_ord-doc for ub.ord-doc.
     5389   define buffer buf_ord-line for ub.ord-line.
     5390   define variable v-bh as handle no-undo .
     5391   define variable v-bh-line as handle no-undo .
     5392   define variable v-err-mess as character no-undo .
     5393   define variable glog as logical no-undo .
     5394   define variable v-attr-type as character no-undo .
     5395   define variable v-is-out as integer no-undo .
     5396   define variable v-scale-is-empty as logical no-undo .
     5397   define variable v-is-petrol                 as logical      no-undo.
     5398   define variable v-is-pieces                 as logical      no-undo.
     5399   define variable v-petrol-weight             as decimal      no-undo.
