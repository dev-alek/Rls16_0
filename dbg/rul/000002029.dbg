        1   using Ibs.Th.Rul.Route-data_.
        2   block-level on error undo, throw.
        3   define input parameter parparentproc as widget-handle no-undo .
        4   define input parameter p-parent-handle as handle no-undo .
        5   define input parameter p-log-handle  as handle no-undo .
        6   define input parameter p-cont-handle  as handle no-undo .
        7   define input parameter p-codex-id as integer no-undo .
        8   define input parameter p-ruleset-id as integer no-undo .
        9   define input parameter p-call-id as character no-undo .
       10   define input parameter p-order-id as integer no-undo .
       11   define input parameter p-rule-id as integer no-undo .
       12   define input parameter p-profile-id as integer no-undo .
       13   define input parameter p-is-dynamic as logical no-undo .
       14   define input parameter p-doc-type as character no-undo .
       15   define input parameter p-host-code like ub.sysconf.host-code no-undo .
       16   define input parameter p-obj-type like ub.clients.obj-type no-undo .
       17   define input parameter p-obj-code like ub.clients.obj-code no-undo .
       18   define input parameter p-doc-code as character no-undo .
       19   define input parameter p-process-file-name as character no-undo .
       20   define input parameter p-save       as integer no-undo .
       21   define input parameter v-curr-r-b   as character no-undo .
       22   define input parameter p-cmd-proc-handle as handle no-undo .
       23   define input parameter p-cmd-code  as integer no-undo .
       24   define variable vss-revision    as character no-undo init "$Revision$":U .
       25   define variable vss-author      as character no-undo init "$Author$":U .
       26   define variable vss-date        as character no-undo init "$Date$":U .
       27   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       28   define variable vss-archive     as character no-undo init "$Archive$":U .
       29   define variable vss-description as character no-undo init "Библиотека процедур для работы с кодексом 18, набор 1,14,100,115".
       30   procedure vss-get-info :
       31     define output parameter p-vss-revision    like vss-revision    no-undo .
       32     define output parameter p-vss-author      like vss-author      no-undo .
       33     define output parameter p-vss-date        like vss-date        no-undo .
       34     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       35     define output parameter p-vss-archive     like vss-archive     no-undo .
       36     define output parameter p-vss-description like vss-description no-undo .
       37     assign
       38       p-vss-revision    = vss-revision
       39       p-vss-author      = vss-author
       40       p-vss-date        = vss-date
       41       p-vss-workfile    = vss-workfile
       42       p-vss-archive     = vss-archive
       43       p-vss-description = vss-description
       44     .
       45   end procedure.
       46   procedure vss-get-parameters :
       47     define output parameter p-vss-parameters as character no-undo .
       48   end procedure.
       49   define new global shared variable g#vssrevis-logger as handle    no-undo .
       50   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       51   define variable v-vssrevis-logger                   as handle    no-undo .
       52   procedure vss-logevent :
       53     define input  parameter p-extra-paramters as character no-undo .
       54     define variable v-vssrevis-parameters as character no-undo .
       55     do
       56     on error undo, return error return-value
       57     :
       58       if  valid-handle(v-vssrevis-logger)
       59       and v-vssrevis-logger :get-signature("logevent") <> ""
       60       then do:
       61         run vss-get-parameters in this-procedure
       62           (output v-vssrevis-parameters
       63           ).
       64         run logevent in v-vssrevis-logger
       65           (input vss-workfile
       66           ,input vss-revision
       67           ,input v-vssrevis-parameters
       68           ,input p-extra-paramters
       69           ).
       70       end.
       71     end.
       72   end procedure.
       73   assign
       74     v-vssrevis-logger = g#vssrevis-logger
       75   .
       76   if  valid-handle(v-vssrevis-logger)
       77   and v-vssrevis-logger :get-signature("logevent") <> ""
       78   then do:
       79     assign
       80       v-vssrevis-logevent = true
       81     .
       82     run vss-logevent in this-procedure (input vss-description) .
       83   end.
       84   define new global shared variable g#language as character no-undo .
       85   if g#language <> '' and g#language <> 'rus':U then do:
       86     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       87   end.
       88   define new global shared variable g#library  as handle no-undo .
       89   define new global shared variable g#library2 as handle no-undo .
       90   define   shared variable g#auto as logical no-undo.
       91   define   shared variable g#news as logical no-undo.
       92   define   shared variable g#oxml as logical no-undo.
       93   define   shared variable g#esys as logical no-undo.
       94   define   shared variable g#news-source-db as integer no-undo.
       95   define   shared variable g#esys-source-esys as integer no-undo.
       96   define   shared variable g#db-num as integer   no-undo .
       97   define   shared variable g#userid as character no-undo .
       98   define   shared variable g#passwd as character no-undo .
       99   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      100   define  variable garbcoll_ii as integer no-undo .
      101   define  temp-table temp-gc no-undo
      102   field ii as integer
      103   field obj-r as handle
      104   field cn as character
      105   index pi is unique primary
      106   ii
      107   index icn
      108   cn.
      109   procedure garbcoll_create-gc-entry :
      110   define input parameter p-cn as character no-undo .
      111   define input parameter p-obj-r as handle no-undo .
      112     do
      113     on error undo, return error
      114     :
      115       create temp-gc.
      116       assign
      117       temp-gc.ii = garbcoll_ii
      118       garbcoll_ii = garbcoll_ii + 1
      119       temp-gc.cn = p-cn
      120       temp-gc.obj-r = p-obj-r
      121       .
      122     end.
      123   end procedure.
      124   procedure garbcoll_clear :
      125     do
      126     on error undo, return error
      127     :
      128       for each temp-gc:
      129         delete object temp-gc.obj-r.
      130         delete temp-gc.
      131       end.
      132     end.
      133   end procedure.
      134   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      135   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      136   procedure cur-time :
      137      define output parameter p-today as date      no-undo .
      138      define output parameter p-time  as integer   no-undo .
      139     do
      140     on error undo, return error
      141     :
      142       define variable v-date1 as date      no-undo .
      143       define variable v-date2 as date      no-undo .
      144       define variable v-time  as integer   no-undo .
      145       assign
      146         v-date1 = today
      147         v-time  = time
      148         v-date2 = today
      149       .
      150       if v-date1 <> v-date2
      151       then do:
      152         assign
      153           v-date1 = today
      154           v-time  = v-time
      155         .
      156       end.
      157       assign
      158         p-today = v-date1
      159         p-time  = v-time
      160       .
      161     end.
      162   end.
      163   function cur-time-date returns character
      164   :
      165     return string(today, '99/99/9999':U) .
      166   end.
      167   function cur-time-mjd returns decimal
      168   :
      169     define variable v-date as date      no-undo .
      170     define variable v-time as integer   no-undo .
      171     run cur-time in this-procedure
      172       (output v-date
      173       ,output v-time
      174       ) .
      175     return integer(v-date) - 2400002 + (v-time / 86400) .
      176   end.
      177   function cur-time-get-ending-index returns integer
      178   (input p-number as integer
      179   )
      180   :
      181     if p-number < 0
      182     or p-number = ?
      183     then do:
      184       return 1 .
      185     end.
      186     define variable v-rest as integer   no-undo .
      187     assign
      188       p-number = p-number modulo 100
      189     .
      190     if p-number < 20
      191     then do:
      192       assign
      193         v-rest = p-number
      194       .
      195     end.
      196     else do:
      197       assign
      198         v-rest = p-number modulo 10
      199       .
      200     end.
      201     case v-rest :
      202       when 1
      203       then do:
      204         return 2 .
      205       end.
      206       when 2 or
      207       when 3 or
      208       when 4
      209       then do:
      210         return 3 .
      211       end.
      212       otherwise do:
      213         return 1 .
      214       end.
      215     end case .
      216   end.
      217   procedure cur-time-mjd-to-date :
      218      define input  parameter i-mjd-diff as decimal no-undo.
      219      define output parameter o-Date     as date    no-undo.
      220      define output parameter o-Time     as integer no-undo.
      221      define variable v-day-number as integer   no-undo .
      222      if    i-mjd-diff < 0
      223         or i-mjd-diff = ?
      224      then do:
      225         return "?" .
      226      end.
      227      assign
      228         v-day-number = truncate(i-mjd-diff,0).
      229         o-Date = date(v-day-number + 2400002).
      230         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      231     .
      232   end.
      233   function cur-time-mjd-to-string returns character
      234   (input p-mjd-diff as decimal
      235   )
      236   :
      237     define variable v-day-number as integer   no-undo .
      238     define variable v-seconds    as integer   no-undo .
      239     define variable v-hour       as integer   no-undo .
      240     define variable v-min        as integer   no-undo .
      241     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      242     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      243     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      244     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      245     if p-mjd-diff < 0
      246     or p-mjd-diff = ?
      247     then do:
      248       return "?" .
      249     end.
      250     assign
      251       v-day-number = integer(truncate(p-mjd-diff,0))
      252       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      253     .
      254     if v-seconds > 86400
      255     then do:
      256       assign
      257         v-seconds = 86400 - 1
      258       .
      259     end.
      260     if v-seconds < 0
      261     then do:
      262       assign
      263         v-seconds = 0
      264       .
      265     end.
      266     assign
      267       v-hour = truncate(v-seconds / 3600, 0)
      268     .
      269     assign
      270       v-seconds = v-seconds modulo 3600
      271     .
      272     assign
      273       v-min = truncate(v-seconds / 60, 0)
      274     .
      275     assign
      276       v-seconds = v-seconds modulo 60
      277     .
      278     return
      279         (if v-day-number <> 0
      280           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      281           else ""
      282         )
      283       + (if v-day-number <> 0 or v-hour <> 0
      284           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      285           else ""
      286         )
      287       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      288           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      289           else ""
      290         )
      291       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      292       .
      293   end.
      294   function cur-time-string returns character
      295   :
      296     define variable v-date as date      no-undo .
      297     define variable v-time as integer   no-undo .
      298     run cur-time in this-procedure
      299       (output v-date
      300       ,output v-time
      301       ) .
      302     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      303   end.
      304   function cur-time-string-sec returns character
      305   :
      306     define variable v-date as date      no-undo .
      307     define variable v-time as integer   no-undo .
      308     run cur-time in this-procedure
      309       (output v-date
      310       ,output v-time
      311       ) .
      312     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      313   end.
      314   function cur-time-custom  returns character
      315   (input p-prefix as character
      316   ,input p-date-format as character
      317   ,input p-delimiter as character
      318   ,input p-time-format as character
      319   ,input p-suffix as character
      320   )
      321   :
      322     define variable v-date as date      no-undo .
      323     define variable v-time as integer   no-undo .
      324     run cur-time in this-procedure
      325       (output v-date
      326       ,output v-time
      327       ) .
      328     return
      329       p-prefix
      330       + string(v-date, p-date-format)
      331       + p-delimiter
      332       + string(v-time, p-time-format)
      333       + p-suffix
      334       .
      335   end.
      336   function cur-time-print  returns character
      337   :
      338     define variable v-date as date      no-undo .
      339     define variable v-time as integer   no-undo .
      340     run cur-time in this-procedure
      341       (output v-date
      342       ,output v-time
      343       ) .
      344     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      345   end.
      346   function cur-time-datetime returns datetime
      347   :
      348     define variable v-char as character no-undo .
      349     define variable v-datetime as datetime no-undo .
      350     v-char = cur-time-string().
      351     v-datetime = datetime(v-char).
      352     return  v-datetime.
      353   end.
      354   function cur-time-string-msec returns character
      355   :
      356     define variable v-date as datetime  no-undo .
      357     v-date = now.
      358     return string(v-date) .
      359   end.
      360   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      361   define new global shared variable g#lib-nws as handle no-undo .
      362   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      363   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      364   define variable tempcxml_v-num_ as integer no-undo .
      365   define  temp-table temp-xml-tables no-undo
      366   field order as integer
      367   field tbl-name as character
      368   field tbl-handle_ as handle
      369   field table-handle_ as handle
      370   field uniq-gate-rec as character
      371   field gate-name as character
      372   field gate-handle_ as handle
      373   field is-parent as logical
      374   index pi is unique primary
      375   uniq-gate-rec
      376   tbl-name
      377   index iorder
      378   order
      379   index gr
      380   uniq-gate-rec
      381   index gh
      382   gate-handle_
      383   index iparent
      384   is-parent
      385   .
      386   define  temp-table temp-xml-records no-undo
      387   field tbl-name as character
      388   field uniq-key-rec as character
      389   index pi is unique primary
      390   tbl-name
      391   uniq-key-rec
      392   .
      393   def var vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      394   procedure gen-key-rec :
      395     define input  parameter p-tbl-name    as character no-undo.
      396     define input  parameter p-bh_tbl-name as handle    no-undo.
      397     define output parameter p-key-rec     as character no-undo.
      398     do
      399     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      400     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      401     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      402     :
      403       define variable fh               as handle    no-undo .
      404       define variable v-ok             as logical   no-undo .
      405       define variable v-inform         as character no-undo .
      406       define variable v-ind            as integer   no-undo .
      407       define variable v-idx-field-qnty as integer   no-undo .
      408       if p-tbl-name = ?
      409         or p-tbl-name = "":U
      410       then do:
      411         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info6 ).
      412       end.
      413       if not p-bh_tbl-name:available then do:
      414         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info6, p-tbl-name ).
      415       end.
      416       assign
      417         p-key-rec = p-tbl-name
      418         v-inform  = p-bh_tbl-name:index-information(1)
      419         v-ind     = 2
      420       .
      421       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      422       on error undo, return error
      423       :
      424         assign
      425           v-inform = p-bh_tbl-name:index-information( v-ind )
      426           v-ind    = v-ind + 1
      427         .
      428       end.
      429       if v-inform = ?
      430         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      431         or entry( 3, v-inform, ",":U ) <> "1":U
      432       then do:
      433         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info6, p-tbl-name ).
      434       end.
      435       else do:
      436         assign
      437           v-idx-field-qnty = num-entries( v-inform ) - 4
      438         .
      439         if v-idx-field-qnty < 2 then do:
      440           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info6, v-inform, p-tbl-name ).
      441         end.
      442         do v-ind = 1 to v-idx-field-qnty by 2
      443         on error undo, return error
      444         :
      445           assign
      446             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      447             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      448           .
      449         end.
      450       end.
      451       if p-key-rec = ? then do:
      452         assign
      453           p-key-rec = "":U
      454         .
      455         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info6, p-tbl-name ).
      456       end.
      457     end.
      458     return.
      459   end procedure.
      460   procedure gen-where-keyr-tab :
      461     define input  parameter i-tableSerach as character no-undo.
      462     define input  parameter i-tablekey   as character  no-undo.
      463     define input  parameter p-key-rec    as character  no-undo.
      464     define input  parameter p-key-handle as handle     no-undo .
      465     define input  parameter p-db-name    as character  no-undo .
      466     define input  parameter p-tt-handle  as handle     no-undo .
      467     define output parameter o-Where      as character  no-undo.
      468     do
      469     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      470     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      471     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      472     :
      473       define variable v-full-tbl-name  as character no-undo .
      474       define variable bh_tbl-name      as handle    no-undo .
      475       define variable fh_key           as handle    no-undo .
      476       define variable fh_search        as handle    no-undo .
      477       define variable v-field-num      as integer   no-undo .
      478       define variable v-count-fld      as integer   no-undo .
      479       define variable v-inform         as character no-undo .
      480       define variable v-ind            as integer   no-undo .
      481       define variable v-idx-field-qnty as integer   no-undo .
      482       define variable v-field-name     as character no-undo .
      483       define variable v-field-val      as character no-undo .
      484       define variable v-word-link      as character no-undo .
      485       define variable vTable           as character no-undo.
      486       define variable bh_tbl-key       as handle    no-undo .
      487       assign
      488         p-key-rec = trim( p-key-rec )
      489       .
      490       if p-key-handle <> ? then do:
      491         if not valid-handle(p-key-handle)
      492            or p-key-handle:type <> "buffer"
      493         then do:
      494           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info6 ).
      495         end.
      496         if num-entries( p-key-rec, chr(3) ) > 1
      497           or p-key-rec = ?
      498           or p-key-rec = "":U
      499         then do:
      500           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info6, p-key-rec ).
      501         end.
      502       end.
      503       else do:
      504         if p-key-rec = ?
      505           or p-key-rec = "":U
      506         then do:
      507           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info6 ).
      508         end.
      509       end.
      510       assign
      511         vTable = entry( 1 , p-key-rec, chr(3) )
      512       .
      513       if p-tt-handle <> ?
      514         and ( not valid-handle(p-tt-handle)
      515               or p-tt-handle:type <> "buffer"
      516             )
      517       then do:
      518         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info6, vTable, chr(10) ).
      519       end.
      520       if p-tt-handle = ? then do:
      521         assign
      522           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      523         .
      524         create buffer bh_tbl-name for table v-full-tbl-name .
      525       end.
      526       else do:
      527         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      528       end.
      529       assign
      530         v-inform = bh_tbl-name:index-information(1)
      531         v-ind    = 2
      532       .
      533       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      534       on error undo, return error
      535       :
      536         assign
      537           v-inform = bh_tbl-name:index-information( v-ind )
      538           v-ind    = v-ind + 1
      539         .
      540       end.
      541       if v-inform = ?
      542         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      543         or entry( 3, v-inform, ",":U ) <> "1":U
      544       then do:
      545         delete object bh_tbl-name no-error.
      546         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info6, vTable ).
      547       end.
      548       assign
      549         v-idx-field-qnty = num-entries( v-inform ) - 4
      550       .
      551       if v-idx-field-qnty < 2 then do:
      552         delete object bh_tbl-name no-error.
      553         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info6, v-inform, vTable ).
      554       end.
      555       assign
      556         o-where     = "where":U
      557         v-word-link = "":U
      558         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      559         v-count-fld = 0
      560       .
      561       if i-tablekey ne "" and i-tablekey ne ?
      562       then do:
      563         assign
      564           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      565         .
      566         create buffer bh_tbl-key for table v-full-tbl-name .
      567       end.
      568       if i-tableSerach ne "" and i-tableSerach ne ?
      569       then do:
      570         delete object bh_tbl-name no-error.
      571         assign
      572           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      573         .
      574         create buffer bh_tbl-name for table v-full-tbl-name .
      575       end.
      576       block_where:
      577       do v-ind = 1 to v-idx-field-qnty by 2
      578       on error undo, return error
      579       :
      580         assign
      581           v-count-fld = v-count-fld + 1
      582         .
      583         if p-key-handle = ?
      584           and v-count-fld > v-field-num
      585         then do:
      586           leave block_where.
      587         end.
      588         define variable VfieldKeyTable as handle no-undo.
      589         assign
      590           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      591           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      592         .
      593         if     bh_tbl-key ne ?
      594         then do:
      595            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      596            if VfieldKeyTable eq ?
      597            then next block_where.
      598         end.
      599         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      600         then
      601            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      602         else
      603            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      604         if p-key-handle = ? then do:
      605           assign
      606             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      607           .
      608         end.
      609         else do:
      610           assign
      611             fh_key = p-key-handle:buffer-field( v-field-name )
      612           .
      613           if fh_key = ?
      614             or not valid-handle( fh_key )
      615           then do:
      616             delete object bh_tbl-name.
      617             if     bh_tbl-key ne ?
      618             then
      619                delete object bh_tbl-key.
      620             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info6, p-key-handle:name, v-field-name ).
      621           end.
      622           assign
      623             v-field-val = fh_key:buffer-value
      624           .
      625         end.
      626         if fh_search:data-type ="character":U then do:
      627           assign
      628             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      629             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      630             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      631             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      632             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      633             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      634             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      635             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      636             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      637             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      638             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      639             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      640             v-field-val = substitute( '"&1"', v-field-val )
      641           .
      642         end.
      643         assign
      644           o-where = substitute( "&1 &2", o-where, v-field-val )
      645         .
      646         if v-word-link = "":U then do:
      647           assign
      648             v-word-link = "and":U
      649           .
      650         end.
      651       end.
      652       delete object bh_tbl-name.
      653       if     bh_tbl-key ne ?
      654       then
      655          delete object bh_tbl-key.
      656       if p-key-handle = ?
      657         and v-count-fld <> v-field-num
      658       then do:
      659         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info6, vTable ).
      660       end.
      661     end.
      662   end procedure.
      663   procedure gen-hn-keyr-tab :
      664     define input  parameter i-tableSerach as character no-undo.
      665     define input  parameter i-tablekey   as character no-undo.
      666     define input  parameter p-key-rec    as character no-undo.
      667     define input  parameter p-key-handle as handle    no-undo .
      668     define input  parameter p-db-name    as character no-undo .
      669     define input  parameter p-tt-handle  as handle    no-undo .
      670     define input  parameter p-stts-lock  as integer   no-undo .
      671     define output parameter o-hn         as handle    no-undo.
      672     define variable v-full-tbl-name as character no-undo.
      673     define variable v-where         as character no-undo.
      674     define variable bh_tbl-name     as handle    no-undo.
      675     define variable vTable          as character no-undo.
      676     do
      677     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      678     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      679     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      680         run gen-where-keyr-tab(i-tableSerach,
      681                                i-tablekey,
      682                                p-key-rec,
      683                                p-key-handle,
      684                                p-db-name,
      685                                p-tt-handle,
      686                                output v-where).
      687         if i-tableSerach ne "" and i-tableSerach ne ?
      688         then do:
      689            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      690            create buffer bh_tbl-name for table v-full-tbl-name .
      691         end.
      692         else do:
      693            if p-tt-handle = ? then do:
      694               assign
      695                  vTable = entry( 1 , p-key-rec, chr(3) )
      696               .
      697               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      698               create buffer bh_tbl-name for table v-full-tbl-name .
      699            end.
      700            else do:
      701               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      702            end.
      703         end.
      704         if p-tt-handle = ? then do:
      705            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      706         end.
      707         else do:
      708            bh_tbl-name:find-first( v-where ) no-error .
      709         end.
      710         o-hn = bh_tbl-name.
      711      end.
      712   end procedure.
      713   procedure gen-hn-keyr :
      714     define input  parameter p-key-rec    as character no-undo.
      715     define input  parameter p-key-handle as handle    no-undo .
      716     define input  parameter p-db-name    as character no-undo .
      717     define input  parameter p-tt-handle  as handle    no-undo .
      718     define input  parameter p-stts-lock  as integer   no-undo .
      719     define output parameter o-hn         as handle    no-undo.
      720     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      721   end.
      722   procedure gen-row-keyr :
      723     define input  parameter p-key-rec    as character no-undo.
      724     define input  parameter p-key-handle as handle    no-undo .
      725     define input  parameter p-db-name    as character no-undo .
      726     define input  parameter p-tt-handle  as handle    no-undo .
      727     define input  parameter p-stts-lock  as integer   no-undo .
      728     define output parameter p-tbl-row    as rowid     no-undo.
      729     define output parameter p-tbl-name   as character no-undo.
      730     define variable vHn as handle no-undo.
      731       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      732       p-tbl-row = if vHn:available then vHn:rowid else ?.
      733       p-tbl-name =  vHn:table.
      734       delete object vHn no-error.
      735     if p-tbl-row = ? then do:
      736       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info6, p-tbl-name, p-key-rec ).
      737     end.
      738     else do:
      739       return.
      740     end.
      741   end procedure.
      742   procedure gen-key-fv :
      743     define input  parameter p-key-rec    as character no-undo .
      744     define output parameter p-field-list as character no-undo .
      745     define output parameter p-value-list as character no-undo.
      746     do
      747     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      748     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      749     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      750     :
      751       define variable v-full-tbl-name  as character no-undo .
      752       define variable bh_tbl-name      as handle    no-undo .
      753       define variable v-tbl-name       as character no-undo .
      754       define variable v-field-num      as integer   no-undo .
      755       define variable v-count-fld      as integer   no-undo .
      756       define variable v-inform         as character no-undo .
      757       define variable v-ind            as integer   no-undo .
      758       define variable v-idx-field-qnty as integer   no-undo .
      759       define variable v-delim-key      as character no-undo .
      760       if p-key-rec = ?
      761         or p-key-rec = "":U
      762       then do:
      763         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info6 ).
      764       end.
      765       assign
      766         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      767         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      768       .
      769       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      770       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info6 ).
      771       assign
      772         v-inform = bh_tbl-name:index-information(1)
      773         v-ind    = 2
      774       .
      775       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      776       on error undo, return error
      777       :
      778         assign
      779           v-inform = bh_tbl-name:index-information( v-ind )
      780           v-ind    = v-ind + 1
      781         .
      782       end.
      783       if v-inform = ?
      784         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      785         or entry( 3, v-inform, ",":U ) <> "1":U
      786       then do:
      787         delete object bh_tbl-name no-error.
      788         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info6, v-tbl-name ).
      789       end.
      790       assign
      791         v-idx-field-qnty = num-entries( v-inform ) - 4
      792       .
      793       if v-idx-field-qnty < 2 then do:
      794         delete object bh_tbl-name no-error.
      795         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info6, v-inform, v-tbl-name ).
      796       end.
      797       assign
      798         p-field-list = "":U
      799         p-value-list = "":U
      800         v-delim-key  = "":U
      801         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      802         v-count-fld  = 0
      803       .
      804       block_where:
      805       do v-ind = 1 to v-idx-field-qnty by 2
      806       on error undo, return error
      807       :
      808         assign
      809           v-count-fld = v-count-fld + 1
      810         .
      811         if v-count-fld > v-field-num then do:
      812           leave block_where.
      813         end.
      814         assign
      815           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      816           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      817         .
      818         if v-ind = 1 then do:
      819           assign
      820             v-delim-key = chr(3)
      821           .
      822         end.
      823       end.
      824       delete object bh_tbl-name.
      825       if v-count-fld <> v-field-num then do:
      826         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info6, v-tbl-name ).
      827       end.
      828     end.
      829   end procedure.
      830   procedure gen-key-field :
      831     define input  parameter p-table      as character no-undo .
      832     define output parameter p-field-list as character no-undo .
      833     do
      834     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      835     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      836     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      837     :
      838       define variable v-full-tbl-name  as character no-undo .
      839       define variable bh_tbl-name      as handle    no-undo .
      840       define variable v-tbl-name       as character no-undo .
      841       define variable v-field-num      as integer   no-undo .
      842       define variable v-count-fld      as integer   no-undo .
      843       define variable v-inform         as character no-undo .
      844       define variable v-ind            as integer   no-undo .
      845       define variable v-idx-field-qnty as integer   no-undo .
      846       define variable v-delim-key      as character no-undo .
      847       if p-table = ?
      848         or p-table = "":U
      849       then do:
      850         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info6 ).
      851       end.
      852       assign
      853         v-tbl-name      = p-table
      854         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      855       .
      856       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      857       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info6 ).
      858       assign
      859         v-inform = bh_tbl-name:index-information(1)
      860         v-ind    = 2
      861       .
      862       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      863       on error undo, return error
      864       :
      865         assign
      866           v-inform = bh_tbl-name:index-information( v-ind )
      867           v-ind    = v-ind + 1
      868         .
      869       end.
      870       if v-inform = ?
      871         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      872         or entry( 3, v-inform, ",":U ) <> "1":U
      873       then do:
      874         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info6, v-tbl-name ).
      875       end.
      876       assign
      877         v-idx-field-qnty = num-entries( v-inform ) - 4
      878       .
      879       if v-idx-field-qnty < 2 then do:
      880         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info6, v-inform, v-tbl-name ).
      881       end.
      882       assign
      883         p-field-list = "":U
      884         v-delim-key  = "":U
      885         v-count-fld  = 0
      886       .
      887       block_where:
      888       do v-ind = 1 to v-idx-field-qnty by 2
      889       on error undo, return error
      890       :
      891         assign
      892           v-count-fld = v-count-fld + 1
      893         .
      894         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      895         if v-ind = 1 then do:
      896           assign
      897             v-delim-key = chr(3)
      898           .
      899         end.
      900       end.
      901       delete object bh_tbl-name.
      902     end.
      903   end procedure.
      904   procedure get-gate-file-name :
      905   define input parameter p-gate-rec as character no-undo .
      906   define output  parameter p-gate-file-name as character no-undo .
      907   define buffer buf_clob-data for ub.clob-data.
      908   define variable v-tbl-row as rowid no-undo .
      909   define variable v-tbl-name as character no-undo .
      910   run gen-row-keyr in this-procedure ( input p-gate-rec
      911                                       ,input ?
      912                                       ,input "ub"
      913                                       ,input ?
      914                                       ,input no-lock
      915                                       ,output v-tbl-row
      916                                       ,output v-tbl-name) no-error.
      917   if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
      918                                                           ,vss-include-info4
      919                                                           ,p-gate-rec).
      920   find first buf_clob-data no-lock where
      921             rowid(buf_clob-data) = v-tbl-row no-error.
      922   if not available buf_clob-data then do:
      923     if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
      924                                                             ,vss-include-info4
      925                                                             ,p-gate-rec).
      926   end.
      927   p-gate-file-name = buf_clob-data.file-name.
      928   end procedure.
      929   procedure get-gate-rec :
      930   define input  parameter p-gate-name as character no-undo .
      931   define output parameter p-gate-rec as character no-undo .
      932   define buffer buf_clob-bind for ub.clob-bind.
      933   define buffer buf_clob-data for ub.clob-data.
      934   main-block:
      935   do
      936   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message (1))
      937   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info4 )
      938   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info4 )
      939   :
      940       find first buf_clob-bind no-lock where
      941                 buf_clob-bind.uniq-key-rec = p-gate-name
      942             and buf_clob-bind.field-name = '':U
      943             and buf_clob-bind.part-num = 1
      944             and buf_clob-bind.resource-type = 'gate':U
      945             no-error.
      946       if not available buf_clob-bind then do:
      947         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
      948                                         , p-gate-name
      949                                         ).
      950       end.
      951       find first buf_clob-data no-lock where
      952                 buf_clob-data.db-num = buf_clob-bind.db-num
      953             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
      954       if not available buf_clob-data then do:
      955         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
      956                                         , buf_clob-bind.db-num
      957                                         , buf_clob-bind.int64-id
      958                                         , p-gate-name
      959                                         ).
      960       end.
      961       run gen-key-rec in this-procedure ( input 'clob-data':U
      962                                 ,input buffer buf_clob-data:handle
      963                                 ,output p-gate-rec).
      964   end.
      965   end procedure.
      966   procedure get-gate-by-name :
      967   define input  parameter p-gate-name as character no-undo .
      968   define output parameter p-gate-rec as character no-undo .
      969   define output parameter p-dsh as handle no-undo .
      970   define input-output  parameter p-xmlh as handle no-undo .
      971   define variable v-ii as integer   no-undo .
      972   define variable glog as logical   no-undo .
      973   define variable v-longchar as longchar no-undo .
      974   define variable v-txmlh as handle no-undo .
      975   define variable v-db-num as integer no-undo .
      976   define variable v-int64-id as int64 no-undo .
      977   define buffer buf_clob-bind for ub.clob-bind.
      978   define buffer buf_clob-data for ub.clob-data.
      979   main-block:
      980   do
      981   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message (1))
      982   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info4 )
      983   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info4 )
      984   :
      985       find first buf_clob-bind no-lock where
      986                 buf_clob-bind.uniq-key-rec = p-gate-name
      987             and buf_clob-bind.field-name = '':U
      988             and buf_clob-bind.part-num = 1
      989             and buf_clob-bind.resource-type = 'gate':U
      990             no-error.
      991       if not available buf_clob-bind then do:
      992         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
      993                                         , p-gate-name
      994                                         ).
      995       end.
      996       find first buf_clob-data no-lock where
      997                 buf_clob-data.db-num = buf_clob-bind.db-num
      998             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
      999       if not available buf_clob-data then do:
     1000         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1001                                         , buf_clob-bind.db-num
     1002                                         , buf_clob-bind.int64-id
     1003                                         , p-gate-name
     1004                                         ).
     1005       end.
     1006       assign
     1007       v-longchar = buf_clob-data.cdata
     1008       .
     1009       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1010       if error-status :error then do:
     1011         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1012       end.
     1013       create dataset p-dsh .
     1014       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1015                                     , v-longchar
     1016                                     , ?
     1017                                     , ?
     1018                                     , ?
     1019                                     ) no-error.
     1020       v-longchar = '':U.
     1021       if error-status :error
     1022       or not glog
     1023       then do:
     1024         undo, return error substitute("Не удалось прочитать XML-схему &1 из БД:&2&3", p-gate-name, chr(10), error-status:get-message(1) ).
     1025       end.
     1026       if not valid-handle(p-xmlh)
     1027       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1028         create temp-table v-txmlh.
     1029         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1030         v-txmlh:temp-table-prepare("temp-xml-tables").
     1031         p-xmlh = v-txmlh:default-buffer-handle.
     1032       end.
     1033       run gen-key-rec in this-procedure ( input 'clob-data':U
     1034                                 ,input buffer buf_clob-data:handle
     1035                                 ,output p-gate-rec).
     1036       do v-ii = 1 to p-dsh:num-buffers:
     1037         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1038         if not p-xmlh:available then do:
     1039           p-xmlh:buffer-create().
     1040           assign
     1041           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1042           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1043           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1044           p-xmlh::gate-handle_ = p-dsh
     1045           p-xmlh::uniq-gate-rec = p-gate-rec
     1046           p-xmlh::gate-name = p-dsh:name
     1047           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1048           .
     1049           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1050             assign
     1051             p-xmlh::order = -3.
     1052           end.
     1053         end.
     1054       end.
     1055   end.
     1056   end procedure.
     1057   procedure get-gate-by-rec :
     1058   define input  parameter p-gate-rec as character no-undo .
     1059   define output parameter p-dsh as handle no-undo .
     1060   define input-output  parameter p-xmlh as handle no-undo .
     1061   define input-output parameter p-longchar  as longchar no-undo .
     1062   define variable v-ii as integer   no-undo .
     1063   define variable glog as logical   no-undo .
     1064   define variable v-rowid as rowid no-undo .
     1065   define variable v-tbl-name as character no-undo .
     1066   define variable v-longchar as longchar no-undo .
     1067   define variable v-txmlh as handle no-undo .
     1068   define buffer buf_clob-data for ub.clob-data.
     1069   main-block:
     1070   do
     1071   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message (1))
     1072   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info4 )
     1073   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info4 )
     1074   :
     1075     run gen-row-keyr in this-procedure (
     1076                                           input  p-gate-rec
     1077                                           ,input  ?
     1078                                           ,input  "ub"
     1079                                           ,input  ?
     1080                                           ,input  NO-LOCK
     1081                                           ,output v-rowid
     1082                                           ,output v-tbl-name   ) no-error.
     1083       find first buf_clob-data no-lock where
     1084                 rowid(buf_clob-data) = v-rowid  no-error.
     1085       if not available buf_clob-data then do:
     1086         undo, return error substitute("Не найден CLOB  &1"
     1087                                         , p-gate-rec
     1088                                         ).
     1089       end.
     1090       assign
     1091       v-longchar = buf_clob-data.cdata
     1092       .
     1093       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1094       if error-status :error then do:
     1095         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1096       end.
     1097       create dataset p-dsh .
     1098       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1099                                     , v-longchar
     1100                                     , ?
     1101                                     , ?
     1102                                     , ?
     1103                                     ) no-error.
     1104       define variable v-esm as character no-undo .
     1105       v-esm = error-status:get-message(1) .
     1106       if p-longchar <> ? then do:
     1107         p-longchar = v-longchar.
     1108       end.
     1109       v-longchar = '':U.
     1110       if error-status :error
     1111       or not glog
     1112       then do:
     1113         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     1114                                      , p-gate-rec
     1115                                      , p-gate-rec
     1116                                      , v-esm
     1117                                      ).
     1118       end.
     1119       p-dsh:private-data = buf_clob-data.file-name_ + chr(4) + p-gate-rec.
     1120       if not valid-handle(p-xmlh)
     1121       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1122         create temp-table v-txmlh.
     1123         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1124         v-txmlh:temp-table-prepare("temp-xml-tables").
     1125         p-xmlh = v-txmlh:default-buffer-handle.
     1126       end.
     1127       do v-ii = 1 to p-dsh:num-buffers:
     1128         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1129         if not p-xmlh:available then do:
     1130           p-xmlh:buffer-create().
     1131           assign
     1132           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1133           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1134           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1135           p-xmlh::gate-handle_ = p-dsh
     1136           p-xmlh::uniq-gate-rec = p-gate-rec
     1137           p-xmlh::gate-name = p-dsh:name
     1138           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1139           .
     1140           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1141             assign
     1142             p-xmlh::order = -3.
     1143           end.
     1144           p-xmlh:buffer-release().
     1145         end.
     1146       end.
     1147   end.
     1148   end procedure.
     1149   procedure get-gate-by-file :
     1150   define input  parameter p-schema-file-name as character no-undo .
     1151   define input  parameter p-gate-rec as character no-undo .
     1152   define output parameter p-dsh as handle no-undo .
     1153   define input-output  parameter p-xmlh as handle no-undo .
     1154   define variable v-ii as integer   no-undo .
     1155   define variable glog as logical   no-undo .
     1156   define variable v-rowid as rowid no-undo .
     1157   define variable v-tbl-name as character no-undo .
     1158   define variable v-longchar as longchar no-undo .
     1159   define variable v-txmlh as handle no-undo .
     1160   main-block:
     1161   do
     1162   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message (1))
     1163   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info4 )
     1164   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info4 )
     1165   :
     1166       COPY-LOB
     1167       FROM  FILE p-schema-file-name
     1168       TO  OBJECT v-longchar
     1169       no-convert
     1170       NO-ERROR .
     1171       if error-status :error then do:
     1172           undo, return error substitute("Не удалось считать файл схемы &1 в память&2&3"
     1173                                     , p-schema-file-name
     1174                                 , chr(10)
     1175                                 , error-status:get-message(1) ).
     1176       end.
     1177       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1178       if error-status :error then do:
     1179         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, p-schema-file-name, chr(10), error-status:get-message(1) , return-value ).
     1180       end.
     1181       create dataset p-dsh .
     1182       glog = p-dsh:READ-XMLSCHEMA( "longchar"
     1183                                     , v-longchar
     1184                                     , ?
     1185                                     , ?
     1186                                     , ?
     1187                                     ) no-error.
     1188       v-longchar = ''.
     1189       if error-status :error
     1190       or not glog
     1191       then do:
     1192         undo, return error substitute("Не удалось прочитать XML-схему из файла &1&2&3"
     1193                                      , p-schema-file-name
     1194                                      ,chr(10)
     1195                                      , error-status:get-message(1)
     1196                                      ).
     1197       end.
     1198       if not valid-handle(p-xmlh)
     1199       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1200         create temp-table v-txmlh.
     1201         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1202         v-txmlh:temp-table-prepare("temp-xml-tables").
     1203         p-xmlh = v-txmlh:default-buffer-handle.
     1204       end.
     1205       do v-ii = 1 to p-dsh:num-buffers:
     1206         p-xmlh:find-first(substitute(' where tbl-name = "&1" and  uniq-gate-rec = "&2" '
     1207                                      ,p-dsh:get-buffer-handle(v-ii):name
     1208                                      ,p-gate-rec
     1209                                      )) no-error.
     1210         if not p-xmlh:available then do:
     1211           p-xmlh:buffer-create().
     1212           assign
     1213           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):table
     1214           p-xmlh::uniq-gate-rec = p-gate-rec
     1215           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1216           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1217           p-xmlh::gate-handle_ = p-dsh
     1218           p-xmlh::gate-name = p-dsh:name
     1219           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1220           .
     1221           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1222             assign
     1223             p-xmlh::order = -3.
     1224           end.
     1225           p-xmlh:buffer-release().
     1226         end.
     1227       end.
     1228   end.
     1229   end procedure.
     1230   procedure gate-clear :
     1231   define input  parameter p-dsh as handle no-undo .
     1232   define input  parameter p-xmlh as handle no-undo .
     1233   define variable v-dsh as handle no-undo .
     1234   define variable v-th as handle no-undo .
     1235     do
     1236     on error undo, return error return-value
     1237     :
     1238       if valid-handle(p-dsh) then do:
     1239         delete object p-dsh.
     1240         v-dsh = p-dsh.
     1241         p-dsh = ?.
     1242       end.
     1243       repeat while true:
     1244         p-xmlh:find-first( substitute( " where gate-handle_ = &1 ", v-dsh)
     1245                            , share-lock) no-error.
     1246         if p-xmlh:available then do:
     1247           assign
     1248           v-th = p-xmlh:buffer-field("table-handle_"):buffer-value.
     1249           if valid-handle(p-xmlh:buffer-field("table-handle_"))
     1250           and valid-handle(v-th)
     1251           and v-th:dynamic = yes
     1252           then do:
     1253             delete object p-xmlh:buffer-field("table-handle_"):buffer-value.
     1254             p-xmlh:buffer-field("table-handle_"):buffer-value = ?.
     1255           end.
     1256           p-xmlh:buffer-delete().
     1257         end.
     1258         else do:
     1259           leave.
     1260         end.
     1261       end.
     1262       if p-xmlh:dynamic = yes
     1263       and valid-handle(p-xmlh)
     1264       then do:
     1265         delete object p-xmlh:table-handle.
     1266         p-xmlh = ?.
     1267       end.
     1268       v-dsh = ?.
     1269     end.
     1270   end procedure.
     1271   procedure all-gates-clear :
     1272   define parameter buffer buf_temp-xml-tables for temp-xml-tables.
     1273   do
     1274   on error undo, return error
     1275   :
     1276     for each buf_temp-xml-tables
     1277     break
     1278     by buf_temp-xml-tables.uniq-gate-rec
     1279     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1280     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1281     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1282     :
     1283         if first-of(buf_temp-xml-tables.uniq-gate-rec) then do:
     1284           delete object buf_temp-xml-tables.gate-handle_.
     1285           buf_temp-xml-tables.gate-handle_ = ?.
     1286         end.
     1287         if valid-handle(buf_temp-xml-tables.table-handle_)
     1288         and buf_temp-xml-tables.table-handle_:dynamic = no
     1289         then do:
     1290           delete object buf_temp-xml-tables.table-handle_.
     1291           buf_temp-xml-tables.table-handle_ = ?.
     1292         end.
     1293         delete buf_temp-xml-tables.
     1294     end.
     1295   end.
     1296   end procedure.
     1297   procedure fix-schemalocation :
     1298   define input-output  parameter p-longchar as longchar no-undo .
     1299   DEFINE VARIABLE hdoc AS HANDLE.
     1300   DEFINE VARIABLE hroot AS HANDLE.
     1301   DEFINE VARIABLE hnode-child AS HANDLE.
     1302   DEFINE VARIABLE hnode-attr AS HANDLE.
     1303   define variable v-jj as integer   no-undo .
     1304   define variable ok as logical   no-undo .
     1305   define variable v-path1                    as character                no-undo .
     1306   DEFINE VARIABLE v-full-path1               as character                no-undo .
     1307   DEFINE VARIABLE v-file-name1               as character                no-undo .
     1308   DEFINE VARIABLE v-file-name-no-ext1        as character                no-undo .
     1309   DEFINE VARIABLE v-file-name-ext1           as character                no-undo .
     1310   define variable v-schema-location          as character                no-undo .
     1311   do
     1312   on error undo, return error return-value
     1313   :
     1314     CREATE X-DOCUMENT hdoc.
     1315     CREATE X-noderef hroot.
     1316     CREATE X-noderef hnode-child.
     1317     CREATE X-noderef hnode-attr.
     1318     hdoc:load("longchar", p-longchar, no) no-error.
     1319     iF ERROR-STATUS:GET-MESSAGE(1) <> '' THEN message ERROR-STATUS:GET-MESSAGE(1) view-as alert-box .
     1320     hdoc:get-document-element(hroot).
     1321     _repeat:
     1322     REPEAT v-jj = 1 TO hroot:NUM-CHILDREN:
     1323       ok = hroot:GET-CHILD(hNode-Child, v-jj).
     1324       if not ok then next.
     1325       if hNode-Child:local-name = "include"
     1326       then do:
     1327         ok = hNode-Child:GET-ATTRIBUTE-NODE( hnode-attr, "schemaLocation" ).
     1328           v-schema-location = hnode-attr:node-value.
     1329           run gbl/filename.p (
     1330                           input "exe/" + hnode-attr:node-value
     1331                         ,output v-full-path1
     1332                         ,output v-path1
     1333                         ,output v-file-name1
     1334                         ,output v-file-name-no-ext1
     1335                         ,output v-file-name-ext1
     1336                         ) no-error .
     1337           if error-status :error then do:
     1338             delete object hnode-attr.
     1339             delete object hnode-child.
     1340             delete object hroot.
     1341             delete object hdoc.
     1342             undo, return error substitute("Не удалось определить расположение схемы &1", v-schema-location).
     1343           end.
     1344         ok = hNode-Child:sET-ATTRIBUTE(  "schemaLocation", v-full-path1 ).
     1345         leave  _repeat.
     1346       end.
     1347     END.
     1348     hdoc:save("longchar", p-longchar).
     1349     delete object hnode-attr.
     1350     delete object hnode-child.
     1351     delete object hroot.
     1352     delete object hdoc.
     1353   end.
     1354   end procedure.
     1355   procedure gate-clb_fill-xml-tables :
     1356   define input parameter p-dsh as handle no-undo .
     1357   define input-output parameter p-xmlh as handle no-undo .
     1358   define variable v-ii as integer no-undo .
     1359     do
     1360     on error undo, return error
     1361     :
     1362       do v-ii = 1 to p-dsh:num-buffers:
     1363         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1364         if not p-xmlh:available then do:
     1365           p-xmlh:buffer-create().
     1366           assign
     1367           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1368           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1369           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1370           p-xmlh::gate-handle_ = p-dsh
     1371           p-xmlh::uniq-gate-rec = entry(2, p-dsh:private-data, chr(4))
     1372           p-xmlh::gate-name = p-dsh:name
     1373           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1374           .
     1375           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1376             assign
     1377             p-xmlh::order = -3.
     1378           end.
     1379           p-xmlh:buffer-release().
     1380         end.
     1381       end.
     1382     end.
     1383   end procedure.
     1384   procedure all-gates-empty :
     1385   define buffer buf_temp-xml-tables for temp-xml-tables.
     1386   do
     1387   on error undo, return error
     1388   :
     1389     for each buf_temp-xml-tables
     1390     break
     1391     by buf_temp-xml-tables.uniq-gate-rec
     1392     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1393     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1394     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1395     :
     1396       if valid-handle(buf_temp-xml-tables.tbl-handle_) then do:
     1397         buf_temp-xml-tables.tbl-handle_:empty-temp-table().
     1398       end.
     1399     end.
     1400   end.
     1401   end procedure.
     1402   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1403   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
     1404   run gbl/getobjsrvhndl.p (input-output ObjSrv).
     1405   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1406   function context_get-thobj-es return logical
     1407   (
     1408      input p-esys-id as integer
     1409     ,input p-eobj-type as character
     1410     ,input p-eobj-code as integer
     1411     ,output p-obj-type as character
     1412     ,output p-obj-code as integer
     1413   ):
     1414      define variable v-value-list as character no-undo .
     1415      define variable v-field-list as character no-undo .
     1416      define buffer buf_clients for ub.clients.
     1417      define buffer buf_ext-classif for ub.ext-classif.
     1418      find first buf_ext-classif no-lock where
     1419                buf_ext-classif.classif-name = 'clients-esys':U
     1420            and buf_ext-classif.classif-subject = 'clients':U
     1421            and buf_ext-classif.db-num = 0
     1422            and buf_Ext-classif.key#_one = p-esys-id
     1423            and buf_Ext-classif.charkey_one = p-eobj-type
     1424            and buf_Ext-classif.key#_two = p-eobj-code no-error .
     1425      if available buf_Ext-classif
     1426      then do:
     1427         ObjSrv:Lib:KeyRec:GenKeyFv (
     1428                                         input buf_Ext-classif.uniq-key-rec
     1429                                         ,output v-field-list
     1430                                         ,output v-value-list).
     1431         assign
     1432            p-obj-type = entry(lookup("obj-type":U
     1433                                     , v-field-list
     1434                                     , chr(3))
     1435                                     , v-value-list, chr(3))
     1436            p-obj-code = integer(entry(lookup("obj-code":U
     1437                                            , v-field-list
     1438                                            , chr(3))
     1439                                      , v-value-list
     1440                                      , chr(3)))
     1441         no-error .
     1442      end.
     1443      if     available buf_ext-classif
     1444         and (p-obj-type = 'маг':U
     1445              or
     1446              p-obj-type = 'скл':U
     1447              )
     1448         and (p-obj-code > 0 and p-obj-code <= 99999)
     1449      then do:
     1450         find first buf_clients no-lock where
     1451                    buf_clients.obj-type = p-obj-type
     1452                and buf_clients.obj-code = p-obj-code no-error.
     1453         if available buf_clients then do:
     1454            return yes.
     1455         end.
     1456         else do:
     1457            assign
     1458               p-obj-type = '':U
     1459               p-obj-code = 0
     1460            .
     1461            return no.
     1462         end.
     1463      end.
     1464      else do:
     1465         assign
     1466            p-obj-type = '':U
     1467            p-obj-code = 0
     1468         .
     1469         return no.
     1470      end.
     1471   end.
