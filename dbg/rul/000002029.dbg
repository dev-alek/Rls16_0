     5414   define buffer buf_contract for ub.contract.
     5415   define buffer buf_gds-prt for ub.gds-prt.
     5416   main-block:
     5417   do
     5418   on error undo main-block, retry main-block
     5419   on stop undo main-block, retry main-block
     5420   :
     5421     EMPTY TEMP-TABLE operation.
     5422     if retry then do:
     5423       EMPTY TEMP-TABLE operation.
     5424           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input v-err-mess).
     5425       return error ''.
     5426     end.
     5427     else do:
     5428       v-bh = buffer buf_ord-doc:handle.
     5429       v-bh-line = buffer buf_ord-line:handle.
     5430       if v-action = 'D':U then do:
     5431       end.
     5432       create buf_operation.
     5433       assign
     5434       buf_operation.referenceNo = buf_ord-doc.doc-code
     5435       buf_operation.codeOperation = buf_ord-doc.doc-type
     5436       buf_operation.host = buf_ord-doc.host-code
     5437       buf_operation.factOrder = buf_ord-doc.fact-order
     5438       buf_operation.sysDateXML = buf_ord-doc.sys-date
     5439       buf_operation.dateDocXML = buf_ord-doc.doc-date
     5440       buf_operation.dateFactXML = buf_ord-doc.fact-date
     5441       buf_operation.timeFact = string(buf_ord-doc.fact-time, "HH:MM:SS")
     5442       buf_operation.outDateXML = buf_ord-doc.ship-date
     5443       buf_operation.paymentCode = buf_ord-doc.pay-code
     5444       buf_operation.outCode = buf_ord-doc.out-code
     5445       buf_operation.comment = buf_ord-doc.PS
     5446       buf_operation.store = buf_ord-doc.obj-type + string(buf_ord-doc.obj-code)
     5447       buf_operation.systime = string(buf_ord-doc.sys-time-int, "HH:MM:SS")
     5448       buf_operation.firm = buf_ord-doc.cli-type + string(buf_ord-doc.cli-code)
     5449       buf_operation.outDateXML = buf_ord-doc.ship-date
     5450       buf_operation.exchCode =  buf_ord-doc.exch-code
     5451       buf_operation.exchRate =  buf_ord-doc.exch-rate
     5452       buf_operation.exchscale  = buf_ord-doc.exch-scale
     5453       buf_operation.ordOutDocCode = buf_ord-doc.cons-code
     5454       buf_operation.vatType = buf_ord-doc.vat-Type
     5455       buf_operation.shiftDateXML = buf_ord-doc.shift-date
     5456       buf_operation.shiftNum = buf_ord-doc.shift-num
     5457       buf_operation.shiftName = buf_ord-doc.shift-name
     5458       buf_operation.cliQnty = buf_ord-doc.cli-qnty
     5459       buf_operation.docQnty = buf_ord-doc.qnty
     5460       buf_operation.factQnty = buf_ord-doc.qnty
     5461       .
     5462   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     5463   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run r-b-curr in g#library
     5464     (input  buf_ord-doc.host-code
     5465     ,output buf_operation.valutCode
     5466     )  .
     5467       find first buf_currency no-lock where
     5468                 buf_currency.curr-code = buf_operation.valutCode.
     5469       assign
     5470       buf_operation.valutCodeOKV = buf_currency.okv-code
     5471       buf_operation.totalSum = ( if buf_operation.valutCode = 0
     5472                                  then buf_ord-doc.sum-rubl
     5473                                  else buf_ord-doc.sum-base )
     5474       buf_operation.totalDsc = buf_operation.totalSum
     5475       buf_operation.totalFact = buf_operation.totalSum
     5476       buf_operation.totalDscFact = buf_operation.totalDsc
     5477       .
     5478       ExpData1:route-data_create-record( INPUT "operation") .
     5479       ExpData1:route-data_copy-record ( input "operation", buffer buf_operation:handle).
     5480       IF ExpData1:esys-add-dump( INPUT "operation", INPUT v-esys-cmd-proc-handle, INPUT v-esys-cmd-code, '+update') = false  THEN do:
     5481         v-err-mess = substitute("Ошибка при маршрутизации записи operation &1:&2&3"
     5482                                 , buf_ord-doc.doc-code
     5483                                 , chr(10)
     5484                                 , v-last-error-message
     5485                                 ).
     5486         undo main-block, retry main-block.
     5487       end.
     5488       if v-action = 'D':U then do:
     5489         return.
     5490       end.
     5491       for each buf_ord-line no-lock
     5492         where buf_ord-line.doc-code = buf_ord-doc.doc-code
     5493       on error undo, return error return-value
     5494       on stop undo, return error return-value
     5495       :
     5496         if not available linedoc then do:
     5497           create linedoc.
     5498         end.
     5499         assign
     5500         linedoc.referenceNo = buf_ord-line.doc-code
     5501         .
     5502         find first buf_goods no-lock where
     5503                 buf_goods.artic = buf_ord-line.artic
     5504             and buf_goods.prod-type = buf_ord-line.prod-type
     5505             and buf_goods.prod-code = buf_ord-line.prod-code no-error.
     5506         if available buf_goods then do:
     5507           find first buf_units no-lock where
     5508                   buf_units.unit-name = buf_goods.unit-base no-error.
     5509         end.
     5510         else do:
     5511           release buf_units no-error.
     5512         end.
     5513         assign
     5514         linedoc.good  = (if available buf_goods then buf_goods.gds-code else 0)
     5515         linedoc.artic = buf_ord-line.artic
     5516         linedoc.prodType = buf_ord-line.prod-type
     5517         linedoc.prodCode = buf_ord-line.prod-code
     5518         linedoc.type = (if available buf_goods then buf_goods.gds-type else '')
     5519         linedoc.unitType = (if available buf_units then buf_units.type else '')
     5520         linedoc.priceCli = buf_ord-line.price-cli
     5521         linedoc.cliBaseRate = buf_ord-line.cli-base-rate
     5522         linedoc.quantity = buf_ord-line.qnty
     5523         linedoc.vatpc = buf_ord-line.vat-pc
     5524         .
     5525         ExpData1:route-data_create-record( INPUT "linedoc") .
     5526         if v-linedoc-hidden = no then do:
     5527           IF ExpData1:esys-add-dump( INPUT "linedoc", INPUT v-esys-cmd-proc-handle, INPUT v-esys-cmd-code, '_hidden=referenceNo') = false  THEN do:
     5528             v-err-mess = substitute("Ошибка при маршрутизации записи по заказу &1:&2&3"
     5529                                     , buf_ord-doc.doc-code
     5530                                     , chr(10)
     5531                                     , v-last-error-message
     5532                                     ).
     5533             undo main-block, retry main-block.
     5534           end.
     5535           v-linedoc-hidden = yes.
     5536         end.
     5537         ExpData1:route-data_copy-record ( input "linedoc", buffer linedoc:handle).
     5538         IF ExpData1:esys-add-dump( INPUT "linedoc", INPUT v-esys-cmd-proc-handle, INPUT v-esys-cmd-code, '+update') = false  THEN do:
     5539           v-err-mess = substitute("Ошибка при маршрутизации записи по заказу &1 (товар &2 &3&4):&5&6"
     5540                                   , buf_ord-doc.doc-code
     5541                                   , buf_ord-line.artic
     5542                                   , buf_ord-line.prod-type
     5543                                   , buf_ord-line.prod-code
     5544                                   , chr(10)
     5545                                   , v-last-error-message
     5546                                   ).
     5547           undo main-block, retry main-block.
     5548         end.
     5549       end.
     5550       if available linedoc then do:
     5551         delete linedoc.
     5552       end.
     5553       if available buf_operation then delete buf_operation.
     5554     end.
     5555   end.
     5556   end procedure.
