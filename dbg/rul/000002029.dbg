     2231         return.
     2232       end.
     2233       if v-old-stfl-i < v-waiting-stfl-i
     2234       and v-new-stfl-i > v-waiting-stfl-i then do:
     2235         assign
     2236         p-is-waiting-status = yes
     2237         p-direction = '<закрытие документа>':U + chr(4) + "to-up".
     2238         return.
     2239       end.
     2240       if v-new-stfl-i = v-waiting-stfl-i
