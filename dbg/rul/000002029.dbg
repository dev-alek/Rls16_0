     1695   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1696   procedure strtdate :
     1697     define input  parameter p-str         as character no-undo .
     1698     define output parameter p-value       as date      no-undo .
     1699     define output parameter p-data-valid  as logical   no-undo .
     1700     define output parameter p-message     as character no-undo .
     1701   do
     1702   on error undo, return error return-value
     1703   :
     1704     define variable v-value       as date      no-undo .
     1705     define variable v-i           as integer   no-undo .
     1706     define variable v-num         as integer   no-undo .
     1707     define variable v-delim       as character no-undo .
     1708     define variable v-delim-list  as character no-undo .
     1709     define variable v-day         as integer   no-undo .
     1710     define variable v-month       as integer   no-undo .
     1711     define variable v-year        as integer   no-undo .
     1712     define variable v-day-str     as character no-undo .
     1713     define variable v-month-str   as character no-undo .
     1714     define variable v-year-str    as character no-undo .
     1715     assign
     1716       p-value       = ?
     1717       p-data-valid  = false
     1718     .
     1719     if p-str = ?
     1720     then do:
     1721       assign
     1722         p-message = substitute("Ошибка задания входных параметров. Не задана строка для преобразования. " )
     1723       .
     1724       return .
     1725     end.
     1726     if p-str = ""
     1727     then do:
     1728       assign
     1729         p-message = substitute("Ошибка задания входных параметров. Задана пустая строка для преобразования. " )
     1730       .
     1731       return .
     1732     end.
     1733     if length(p-str)  > 10
     1734     then do:
     1735       assign
     1736         p-message = substitute("Ошибка при преобразовании к дате. Неверная длина строки. " )
     1737       .
     1738       return .
     1739     end.
     1740     assign
     1741       v-delim-list = '/,-,.':U
     1742     .
     1743     _delim:
     1744     do v-i = 1 to num-entries( v-delim-list )
     1745     :
     1746       assign
     1747         v-delim = entry( v-i , v-delim-list )
     1748         v-num   = num-entries( p-str , v-delim )
     1749       .
     1750       if v-num <> 3
     1751       then do:
     1752         assign
     1753           v-delim = ''
     1754         .
     1755       end.
     1756       else do:
     1757         leave _delim.
     1758       end.
     1759     end.
     1760     if v-delim = ''
     1761     then do:
     1762       assign
     1763         p-message = substitute( "Ошибка при преобразовании к дате. Неправильный разделитель, либо ошибочное количество разделителей. " )
     1764       .
     1765       return .
     1766     end.
     1767     assign
     1768       v-day-str   = entry( 1, p-str , v-delim)
     1769       v-month-str = entry( 2, p-str , v-delim)
     1770       v-year-str  = entry( 3, p-str , v-delim)
     1771     .
     1772     if  length(v-day-str) > 2   or
     1773         length(v-day-str) < 1   or
     1774         length(v-month-str) > 2 or
     1775         length(v-month-str) < 1 or
     1776         (
     1777           length(v-year-str) <> 2 and
     1778           length(v-year-str) <> 4
     1779         )
     1780     then do:
     1781       assign
     1782         p-message = substitute("Ошибка при преобразовании к дате. Неправильное количество символов числа, месяца, либо года. " )
     1783       .
     1784       return .
     1785     end.
     1786     if length( v-year-str ) = 2
     1787     then do:
     1788       assign
     1789         v-year-str = substring( string( year(today) ), 1 , 2 ) + v-year-str
     1790       .
     1791     end.
     1792     assign
     1793       v-day   = integer( v-day-str )
     1794       v-month = integer( v-month-str)
     1795       v-year  = integer( v-year-str)
     1796     no-error .
     1797     if error-status :error
     1798     then do:
     1799       assign
     1800         p-message = substitute("Ошибка при преобразовании к дате. Неверный формат символов числа, месяца, либо года. " )
     1801       .
     1802       return .
     1803     end.
     1804     if v-day < 1  or
     1805        v-day > 31 or
     1806        v-month < 1 or
     1807        v-month > 12 or
     1808        v-year < 0   or
     1809        v-year > 5000
     1810     then do:
     1811       assign
     1812         p-message = substitute("Ошибка при преобразовании к дате. Неверный диапозон числа, месяца, года. " )
     1813       .
     1814       return .
     1815     end.
     1816     assign
     1817       v-value = date( v-month, v-day, v-year )
     1818     no-error .
     1819     if error-status :error
     1820     then do:
     1821       assign
     1822         p-message = substitute("Ошибка при преобразовании к дате. &1. " , error-status :get-message(1))
     1823       .
     1824       return .
     1825     end.
     1826     assign
     1827       p-value       = v-value
     1828       p-data-valid  = true
     1829     .
     1830   end.
     1831   end procedure.
     1832   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1833   procedure statq_has-waiting-stat :
     1834   define input parameter p-oldbh              as handle no-undo .
     1835   define input parameter p-newbh              as handle no-undo .
     1836   define input parameter p-changed-fields     as character no-undo .
     1837   define input parameter p-waiting-status     as character no-undo .
     1838   define input parameter p-waiting-flag       as logical no-undo .
     1839   define input parameter p-waiting-stati      as integer no-undo .
     1840   define output parameter p-is-waiting-status as logical no-undo .
     1841   define output parameter p-direction         as character no-undo .
     1842   define variable v-has-newbh as logical no-undo .
     1843   define variable v-has-oldbh as logical no-undo .
     1844   define variable v-changed-fields as character no-undo .
     1845   define variable v-ii as integer no-undo .
     1846   define variable v-flag as logical   no-undo .
     1847   define variable v-some-bh as handle no-undo .
     1848   assign
     1849   v-has-oldbh = valid-handle(p-oldbh) and p-oldbh:available
     1850   v-has-newbh = valid-handle(p-newbh) and p-newbh:available
     1851   v-flag = false
     1852   .
     1853   if v-has-newbh then do:
     1854     if p-changed-fields = '' then do:
     1855       v-changed-fields = "status_,flag_".
     1856       do v-ii = 1 to num-entries(v-changed-fields):
     1857         if p-oldbh:buffer-field(entry(v-ii, v-changed-fields)):buffer-value <> p-newbh:buffer-field(entry(v-ii, v-changed-fields)):buffer-value then do:
     1858           v-flag = yes.
     1859           leave.
     1860         end.
     1861       end.
     1862       if not v-flag then do:
     1863          assign
     1864            p-direction          = ""
     1865            p-is-waiting-status   = false
     1866          .
     1867          return .
     1868       end.
     1869     end.
     1870     else do:
     1871       if lookup("status_", p-changed-fields) = 0
     1872       and lookup("flag_", p-changed-fields) = 0
     1873       and not(p-newbh:new) then do:
     1874          assign
     1875            p-direction          = ""
     1876            p-is-waiting-status   = false
     1877          .
     1878          return .
     1879       end.
     1880       else do:
     1881         if lookup("status_", p-changed-fields) > 0  and lookup("flag_", p-changed-fields) > 0 and
     1882           p-newbh::status_ = p-waiting-status and
     1883           (p-newbh:table = 'price-doc':U or p-newbh::flag_   = p-waiting-flag)   then do:
     1884             assign
     1885                 p-direction          = '<закрытие документа>':U
     1886                 p-is-waiting-status   = true
     1887             .
     1888             return .
     1889          end.
     1890         if lookup("status_", p-changed-fields) > 0  and lookup("flag_", p-changed-fields) = 0 and
     1891           p-newbh::status_ = p-waiting-status  then do:
     1892             assign
     1893                 p-direction          = '<закрытие документа>':U
     1894                 p-is-waiting-status   = true
     1895             .
     1896             return .
     1897          end.
     1898         if lookup("status_", p-changed-fields) = 0  and lookup("flag_", p-changed-fields) > 0 and
     1899         (p-newbh:table = 'price-doc':U or p-newbh::flag_   = p-waiting-flag )  then do:
     1900             assign
     1901                 p-direction          = '<закрытие документа>':U
     1902                 p-is-waiting-status   = true
     1903             .
     1904             return .
     1905          end.
     1906           if lookup("status_", p-changed-fields) > 0  and lookup("flag_", p-changed-fields) > 0 and
     1907           p-newbh::status_ = p-waiting-status and
     1908           (p-newbh:table = 'price-doc':U or p-waiting-flag = ? )  then do:
     1909             assign
     1910                 p-direction          = '<закрытие документа>':U
     1911                 p-is-waiting-status   = true
     1912             .
     1913             return .
     1914          end.
     1915       end.
     1916     end.
     1917   end.
     1918   else do:
     1919     if p-changed-fields = '' then do:
     1920       if p-oldbh::status_ = p-waiting-status
     1921       and (p-oldbh:table = 'price-doc':U
     1922           or
     1923         (p-waiting-flag = ?
     1924         or p-oldbh::flag_ = p-waiting-flag)) then do:
     1925         assign
     1926         p-direction = 'удаление':U
     1927         p-is-waiting-status = yes.
     1928         return.
     1929       end.
     1930       else do:
     1931         assign
     1932         p-direction          = ""
     1933         p-is-waiting-status = no.
     1934         return.
     1935       end.
     1936     end.
     1937     else do:
     1938       if lookup("status_", p-changed-fields) = 0
     1939       and lookup("flag_", p-changed-fields) = 0
     1940       then do:
     1941          assign
     1942             p-is-waiting-status  = false
     1943             p-direction          = ""
     1944          .
     1945          return .
     1946       end.
     1947     end.
     1948   end.
     1949   if v-has-newbh then do:
     1950     v-some-bh = p-newbh.
     1951   end.
     1952   else do:
     1953     v-some-bh = p-oldbh.
     1954   end.
     1955   case v-some-bh:table :
     1956     when 'ord-doc':U  then do:
     1957        if v-some-bh::doc-type = 'ОР':U or v-some-bh::doc-type = 'ОП':U then do:
     1958        if v-some-bh::doc-type = 'ОР':U then do:
     1959           run ord-orc in this-procedure
     1960           ( input  p-oldbh
     1961            ,input  p-newbh
     1962            ,input  p-changed-fields
     1963            ,input  p-waiting-status
     1964            ,input  p-waiting-flag
     1965            ,output p-is-waiting-status
     1966            ,output p-direction  )  .
     1967        end.
     1968        if v-some-bh::doc-type = 'ОП':U then do:
     1969           run ord-op in this-procedure
     1970           ( input  p-oldbh
     1971            ,input  p-newbh
     1972            ,input  p-changed-fields
     1973            ,input  p-waiting-status
     1974            ,input  p-waiting-flag
     1975            ,output p-is-waiting-status
     1976            ,output p-direction  )  .
     1977        end.
     1978        end.
     1979        else do:
     1980          assign
     1981             p-is-waiting-status  = false
     1982             p-direction          = ""
     1983          .
     1984        end.
     1985     end.
     1986     when 'ord-doc-rcv':U  then do:
     1987           run ord-rcv in this-procedure
     1988           ( input  p-oldbh
     1989            ,input  p-newbh
     1990            ,input  p-changed-fields
     1991            ,input  p-waiting-status
     1992            ,input  p-waiting-flag
     1993            ,output p-is-waiting-status
     1994            ,output p-direction  )  .
     1995     end.
     1996     when 'trn-doc':U  then do:
     1997           run stat-graf-trn in this-procedure
     1998           ( input  p-oldbh
     1999            ,input  p-newbh
     2000            ,input  p-changed-fields
     2001            ,input  p-waiting-status
     2002            ,input  p-waiting-flag
     2003            ,output p-is-waiting-status
     2004            ,output p-direction  )  .
     2005     end.
     2006     when 'price-doc':U then do:
     2007       run stat-graf-price in this-procedure
     2008           ( input  p-oldbh
     2009            ,input  p-newbh
     2010            ,input  p-changed-fields
     2011            ,input  p-waiting-status
     2012            ,input  p-waiting-flag
     2013            ,output p-is-waiting-status
     2014            ,output p-direction  )  .
     2015     end.
     2016     when 'inkas':U then do:
     2017           run stat-graf-inkas in this-procedure
     2018           ( input  p-oldbh
     2019            ,input  p-newbh
     2020            ,input  p-changed-fields
     2021            ,input  p-waiting-status
     2022            ,input  p-waiting-flag
     2023            ,output p-is-waiting-status
     2024            ,output p-direction  )  .
     2025     end.
     2026     otherwise do:
     2027          assign
     2028             p-is-waiting-status  = false
     2029             p-direction          = ""
     2030          .
     2031     end.
     2032   end case.
     2033   return .
     2034   end procedure.
     2035   procedure ord-op :
     2036   define input parameter p-oldbh              as handle no-undo .
     2037   define input parameter p-newbh              as handle no-undo .
     2038   define input parameter p-changed-fields     as character no-undo .
     2039   define input parameter p-waiting-status     as character no-undo .
     2040   define input parameter p-waiting-flag       as logical no-undo .
     2041   define output parameter p-is-waiting-status as logical no-undo .
     2042   define output parameter p-direction         as character no-undo .
     2043   define variable v-stat-list as character no-undo extent 5.
     2044   define variable v-waiting-stfl as character no-undo .
     2045   define variable v-old-stfl as character no-undo .
     2046   define variable v-new-stfl as character no-undo .
     2047   define variable v-waiting-stfl-i as integer no-undo .
     2048   define variable v-old-stfl-i as integer no-undo .
     2049   define variable v-new-stfl-i as integer no-undo .
     2050   define variable v-ii as integer no-undo .
     2051     do
     2052     on error undo, return error return-value
     2053     :
     2054   assign
     2055   v-stat-list[1] =
     2056                    ''            +  chr(3) +
     2057                    'новый':U    +  chr(3) +
     2058                    'согласование':U +  chr(3) +
     2059                    'поставка':U    +  chr(3) +
     2060                    'закрыто':U  +  chr(3) +
     2061                    'факт':U
     2062   v-stat-list[2] =
     2063                    ''            +  chr(3) +
     2064                    'новый':U    +  chr(3) +
     2065                    'отказ':U
     2066   v-stat-list[3] =
     2067                    ''            +  chr(3) +
     2068                    'новый':U    +  chr(3) +
     2069                    'согласование':U +  chr(3) +
     2070                    'отказ':U
     2071   v-stat-list[4] =
     2072                    ''            +  chr(3) +
     2073                    'новый':U    +  chr(3) +
     2074                    'согласование':U +  chr(3) +
     2075                    'поставка':U    +  chr(3) +
     2076                    'отказ':U
     2077   v-stat-list[5] =
     2078                    ''            +  chr(3) +
     2079                    'новый':U    +  chr(3) +
     2080                    'согласование':U +  chr(3) +
     2081                    'поставка':U    +  chr(3) +
     2082                    'закрыто':U  +  chr(3) +
     2083                    'отказ':U
     2084   .
     2085     assign
     2086     v-waiting-stfl = p-waiting-status
     2087     .
     2088     assign
     2089     v-old-stfl = p-oldbh::status_
     2090     .
     2091     assign
     2092     v-new-stfl = p-newbh::status_
     2093     .
     2094     _ii:
     2095     do v-ii = 1 to 5:
     2096       if v-stat-list[v-ii] = '' then next.
     2097       assign
     2098       v-waiting-stfl-i = lookup(v-waiting-stfl, v-stat-list[v-ii], chr(3))
     2099       v-old-stfl-i = lookup(v-old-stfl, v-stat-list[v-ii], chr(3))
     2100       v-new-stfl-i = lookup(v-new-stfl, v-stat-list[v-ii], chr(3))
     2101       .
     2102       if v-waiting-stfl-i = 0
     2103       or v-old-stfl-i = 0
     2104       or v-new-stfl-i = 0
     2105       then do:
     2106         next _ii.
     2107         end.
     2108       if v-old-stfl-i < v-waiting-stfl-i
     2109       and v-new-stfl-i = v-waiting-stfl-i then do:
     2110         assign
     2111         p-is-waiting-status = yes
     2112         p-direction = '<закрытие документа>':U + chr(4) + "to".
     2113         return.
     2114         end.
     2115       if v-old-stfl-i < v-waiting-stfl-i
     2116       and v-new-stfl-i > v-waiting-stfl-i then do:
     2117         assign
     2118         p-is-waiting-status = yes
     2119         p-direction = '<закрытие документа>':U + chr(4) + "to-up".
     2120         return.
     2121         end.
     2122       if v-new-stfl-i = v-waiting-stfl-i
     2123       and v-old-stfl-i > v-waiting-stfl-i then do:
     2124         assign
     2125         p-is-waiting-status = yes
     2126         p-direction = '<открытие документа>':U + chr(4) + "to".
     2127         return.
     2128         end.
     2129       if v-new-stfl-i < v-waiting-stfl-i
     2130       and v-old-stfl-i > v-waiting-stfl-i then do:
     2131         assign
     2132         p-is-waiting-status = yes
     2133         p-direction = '<открытие документа>':U + chr(4) + "to-down".
     2134         return.
     2135         end.
     2136       if v-old-stfl-i = v-waiting-stfl-i
     2137       and v-new-stfl-i > v-waiting-stfl-i then do:
     2138         assign
     2139         p-is-waiting-status = yes
     2140         p-direction = '<закрытие документа>':U + chr(4) + "from".
     2141         return.
     2142       end.
     2143       if v-old-stfl-i = v-waiting-stfl-i
     2144       and v-new-stfl-i < v-waiting-stfl-i then do:
     2145         assign
     2146         p-is-waiting-status = yes
     2147         p-direction = '<открытие документа>':U + chr(4) + "from".
     2148         return.
     2149       end.
     2150     end.
     2151     end.
     2152   end procedure.
