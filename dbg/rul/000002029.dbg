     5205   define variable v-err-mess as character no-undo .
     5206   main-block:
     5207   do
     5208   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     5209   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
