     4752     .
     4753   ASSIGN
     4754             price-base-without-tax-loco = price-base-with-tax-loco - vat-base-loco - slt-base-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco))
     4755       price-rubl-without-tax-loco = price-rubl-with-tax-loco - vat-rubl-loco - slt-rubl-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco))
     4756   .
     4757         assign
     4758           varprice-base-cons = varprice-base-cons + (price-base-with-tax-loco - (if road-tax-base-loco = ? then 0 else road-tax-base-loco))* out-vatp_parts.fact-qnty
     4759           varprice-rubl-cons = varprice-rubl-cons + (price-rubl-with-tax-loco - (if road-tax-rubl-loco = ? then 0 else road-tax-rubl-loco))* out-vatp_parts.fact-qnty.
     4760         assign
     4761           varis-cons-parts-have = yes
     4762           varcons-qnty          = varcons-qnty + out-vatp_parts.fact-qnty.
     4763       end.
     4764       assign
     4765         varfact-qnty = varfact-qnty + out-vatp_parts.fact-qnty.
     4766     end.
     4767   end.
     4768   assign
     4769     varprice-base-cons = varprice-base-cons / varcons-qnty
     4770     varprice-rubl-cons = varprice-rubl-cons / varcons-qnty.
     4771   if varprice-base-cons = ? then do:
     4772     assign
     4773       varprice-base-cons = 0.
     4774   end.
     4775   if varprice-rubl-cons = ? then do:
     4776     assign
     4777       varprice-rubl-cons = 0.
     4778   end.
     4779   assign
     4780       slt-base-sale               = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc)
     4781     vat-base-buyer              = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc)
     4782     discnt-base-sale            = buf_gds-dtl.discnt-base
     4783     price-base-with-tax-sale    = (buf_gds-dtl.price-base - buf_gds-dtl.discnt-base)
     4784       slt-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc)
     4785     vat-rubl-buyer              = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc)
     4786     discnt-rubl-sale            = buf_gds-dtl.discnt-rubl
     4787     price-rubl-with-tax-sale    = (buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl)
     4788     .
     4789   if buf_trn-doc.doc-type = 'инв':U then do:
     4790     assign
     4791       varfact-qnty = buf_gds-dtl.doc-qnty.
     4792   end.
     4793   else do:
     4794     assign
     4795       varfact-qnty = buf_gds-dtl.fact-qnty.
     4796   end.
     4797   if varis-cons-parts-have = no then do:
     4798     assign
     4799           vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc)
     4800           vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc).
     4801   end.
     4802   else do:
     4803     if buf_trn-doc.doc-type = 'инв':U then do:
     4804       assign
     4805               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     4806               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     4807        .
     4808     end.
     4809     else do:
     4810       assign
     4811               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - varprice-base-cons) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     4812               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - varprice-rubl-cons) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     4813        .
     4814     end.
     4815   end.
     4816   assign
     4817   price-base-without-tax-sale = price-base-with-tax-sale - vat-base-sale - slt-base-sale - road-tax-base-sale
     4818   price-rubl-without-tax-sale = price-rubl-with-tax-sale - vat-rubl-sale - slt-rubl-sale - road-tax-rubl-sale.
     4819             if not available dtl then do:
     4820               create dtl.
     4821             end.
     4822             assign
     4823             dtl.referenceNo = buf_trn-doc.doc-code
     4824             dtl.good = (if available buf_goods then buf_goods.gds-code else 0)
     4825             dtl.prtCode = (if available buf_gds-prt then buf_gds-prt.node-code else 0)
     4826             dtl.dtlName = (if available buf_gds-prt then buf_gds-prt.f-name else '')
     4827             dtl.qnty = buf_gds-dtl.fact-qnty
     4828             dtl.sumr = price-rubl-with-tax-sale * buf_gds-dtl.fact-qnty
     4829             dtl.VATr = vat-rubl-buyer * buf_gds-dtl.fact-qnty
     4830             dtl.roadTaxr = road-tax-rubl-sale  * buf_gds-dtl.fact-qnty
     4831             dtl.sumb = price-base-with-tax-sale * buf_gds-dtl.fact-qnty
     4832             dtl.VATb = vat-base-buyer * buf_gds-dtl.fact-qnty
     4833             dtl.roadTaxb = road-tax-base-sale  * buf_gds-dtl.fact-qnty
     4834             .
     4835             ExpData1:route-data_create-record( INPUT "dtl") .
     4836             if v-dtl-hidden = no then do:
     4837               IF ExpData1:esys-add-dump( INPUT "dtl", INPUT v-esys-cmd-proc-handle, INPUT v-esys-cmd-code, '_hidden=referenceNo') = false  THEN do:
     4838                 v-err-mess = substitute("Ошибка при маршрутизации записи по накладной &1:&2&3"
     4839                                         , buf_trn-doc.doc-code
     4840                                         , chr(10)
     4841                                         , v-last-error-message
     4842                                         ).
     4843                 undo main-block, retry main-block.
     4844               end.
     4845               v-dtl-hidden = yes.
     4846             end.
     4847             ExpData1:route-data_copy-record ( input "dtl", buffer dtl:handle).
     4848             IF ExpData1:esys-add-dump( INPUT "dtl", INPUT v-esys-cmd-proc-handle, INPUT v-esys-cmd-code, '+update') = false  THEN do:
     4849               v-err-mess = substitute("Ошибка при маршрутизации записи dtl &1:&2&3"
     4850                                       , buf_trn-doc.doc-code
     4851                                       , chr(10)
     4852                                       , v-last-error-message
     4853                                       ).
     4854               undo main-block, retry main-block.
     4855             end.
     4856           end.
     4857         end.
     4858         for each buf_part:
     4859           ExpData1:route-data_create-record( INPUT "part") .
     4860           ExpData1:route-data_copy-record ( input "part", buffer buf_part:handle).
     4861           IF ExpData1:esys-add-dump( INPUT "part", INPUT v-esys-cmd-proc-handle, INPUT v-esys-cmd-code, '+update') = false  THEN do:
     4862             v-err-mess = substitute("Ошибка при маршрутизации записи part &1:&2&3"
     4863                                     , buf_trn-doc.doc-code
     4864                                     , chr(10)
     4865                                     , v-last-error-message
     4866                                     ).
     4867             undo main-block, retry main-block.
     4868           end.
     4869           delete buf_part.
     4870         end.
     4871       end.
     4872       if buf_trn-doc.ext-doc-type = 'vt':U
     4873       or buf_trn-doc.ext-doc-type = 'vp':U
     4874       or buf_trn-doc.ext-doc-type = 'ap':U
     4875       or buf_trn-doc.ext-doc-type = 'mp':U
     4876       then do:
     4877           run export-before-and-after-inv-line in this-procedure (
     4878                   input buf_trn-doc.doc-code
     4879               , input (if available buf_goods then buf_goods.gds-code else 0)
     4880               , input v-exists-before
     4881               , input v-exists-after
     4882               , input ( v-is-petrol = yes and v-is-pieces = no and v-weight-not-specified  = no )
     4883               , input v-petrol-density
     4884           ).
     4885       end.
     4886       if available buf_operation then delete buf_operation.
     4887     end.
     4888   end.
     4889   end procedure.
     4890   procedure get-petrol-weight :
     4891   do
     4892   on error undo, return error
     4893   :
     4894   define input parameter p-ext-doc-type           as character    no-undo.
     4895   define input parameter p-doc-line-recid         as recid        no-undo.
     4896   define input parameter p-trn-doc-out-code       as character    no-undo.
     4897   define output parameter p-petrol-weight         as decimal      no-undo.
     4898   define output parameter p-weight-not-specified  as logical      no-undo.
     4899       define variable v-rvs-code              as character     no-undo.
     4900       define variable v-found-last-rvs-doc    as logical       no-undo.
     4901       define buffer buf_doc-line      for doc-line.
     4902       define buffer buf_rvs-doc       for rvs-doc.
     4903       define buffer buf_rvs-line      for rvs-line.
     4904       define buffer buf_goods         for goods.
     4905       define buffer buf_doc-pl        for doc-pl.
     4906       find first buf_doc-line no-lock
     4907           where recid( buf_doc-line ) = p-doc-line-recid
     4908       .
     4909       find first buf_goods no-lock
     4910            where buf_goods.artic      = buf_doc-line.artic
     4911              and buf_goods.prod-type  = buf_doc-line.prod-type
     4912              and buf_goods.prod-code  = buf_doc-line.prod-code
     4913       .
     4914       assign
     4915           p-weight-not-specified = yes
     4916       .
     4917       case p-ext-doc-type:
     4918           when 'ie':U
     4919           then do:
     4920               assign
     4921                   p-petrol-weight        = buf_doc-line.fact-qnty * buf_doc-line.fact-density
     4922                   p-weight-not-specified = no
     4923               .
     4924           end.
     4925           when 'vt':U
     4926           or when 'vp':U
     4927           or when 'ap':U
     4928           or when 'mp':U
     4929           then do:
     4930               find first buf_rvs-doc no-lock
     4931                    where buf_rvs-doc.rvs-code = p-trn-doc-out-code
     4932                      and buf_rvs-doc.status_  = 'факт':U
     4933               no-error.
     4934               if available buf_rvs-doc
     4935               then do:
     4936                   assign
     4937                       v-rvs-code           = buf_rvs-doc.rvs-code
     4938                   .
     4939                   for each buf_doc-pl no-lock
     4940                      where buf_doc-pl.out-code = buf_doc-line.doc-code
     4941                        and buf_doc-pl.gds-code = buf_goods.gds-code
     4942                        and buf_doc-pl.obj-type = buf_doc-line.obj-type
     4943                        and buf_doc-pl.obj-code = buf_doc-line.obj-code
     4944                   on error undo, return error
     4945                   :
     4946                       for each buf_rvs-line no-lock
     4947                          where buf_rvs-line.gds-code  = buf_doc-pl.gds-code
     4948                            and buf_rvs-line.rvs-code  = v-rvs-code
     4949                            and buf_rvs-line.obj-type  = buf_doc-pl.obj-type
     4950                            and buf_rvs-line.obj-code  = buf_doc-pl.obj-code
     4951                            and buf_rvs-line.pl-code   = buf_doc-pl.pl-code
     4952                       on error undo, return error
     4953                       :
     4954                           assign
     4955                               p-petrol-weight         = p-petrol-weight + buf_doc-pl.fact-qnty * buf_rvs-line.state-density
     4956                               p-weight-not-specified  = no
     4957                           .
     4958                       end.
     4959                   end.
     4960               end.
     4961               else do:
     4962                   assign
     4963                       v-found-last-rvs-doc = no
     4964                   .
     4965                   find-last-rvs:
     4966                   for each buf_rvs-doc no-lock
     4967                      where buf_rvs-doc.obj-type = buf_doc-line.obj-type
     4968                        and buf_rvs-doc.obj-code = buf_doc-line.obj-code
     4969                        and buf_rvs-doc.status_  = 'факт':U
     4970                   use-index shift
     4971                   on error undo, return error
     4972                   :
     4973                       assign
     4974                           v-rvs-code           = buf_rvs-doc.rvs-code
     4975                       .
     4976                       for each buf_doc-pl no-lock
     4977                          where buf_doc-pl.out-code = buf_doc-line.doc-code
     4978                            and buf_doc-pl.gds-code = buf_goods.gds-code
     4979                            and buf_doc-pl.obj-type = buf_doc-line.obj-type
     4980                            and buf_doc-pl.obj-code = buf_doc-line.obj-code
     4981                       on error undo, return error
     4982                       :
     4983                           for each buf_rvs-line no-lock
     4984                              where buf_rvs-line.gds-code  = buf_doc-pl.gds-code
     4985                                and buf_rvs-line.rvs-code  = v-rvs-code
     4986                                and buf_rvs-line.obj-type  = buf_doc-pl.obj-type
     4987                                and buf_rvs-line.obj-code  = buf_doc-pl.obj-code
     4988                                and buf_rvs-line.pl-code   = buf_doc-pl.pl-code
     4989                           on error undo, return error
     4990                           :
     4991                               assign
     4992                                   v-found-last-rvs-doc    = yes
     4993                                   p-petrol-weight         = p-petrol-weight + buf_doc-pl.fact-qnty * buf_rvs-line.state-density
     4994                                   p-weight-not-specified  = no
     4995                               .
     4996                               leave find-last-rvs.
     4997                           end.
     4998                       end.
     4999                   end.
     5000               end.
     5001           end.
     5002           otherwise do:
     5003               assign
     5004                   p-weight-not-specified = yes
     5005               .
     5006           end.
     5007       end case.
     5008   end.
     5009   end procedure.
     5010   procedure export-before-and-after-inv-trn :
     5011   define input parameter p-doc-code as character no-undo .
     5012   define output parameter p-exists-before as logical no-undo .
     5013   define output parameter p-exists-after as logical no-undo .
     5014   define variable v-attr-value    as character     no-undo.
     5015   define variable v-attr-type     as character     no-undo.
     5016   define variable v-bh as handle no-undo .
     5017   define variable v-err-mess as character no-undo .
     5018   define buffer buf_trn-doc-sum       for ub.trn-doc-sum.
     5019   main-block:
     5020   do
     5021   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     5022   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     5023   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     5024   :
     5025   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input p-doc-code ,
     5026                           input 'addsum':U ,
     5027                          output v-attr-value ,
     5028                          output v-attr-type )  .
     5029       if lookup( 'bd':U, v-attr-value ) <> 0
     5030       then do:
     5031           assign
     5032               p-exists-before = yes
     5033           .
     5034           find first buf_trn-doc-sum no-lock
     5035                where buf_trn-doc-sum.doc-code = p-doc-code
     5036                  and buf_trn-doc-sum.sum-type = 'bd':U
     5037           no-error.
     5038           if available buf_trn-doc-sum
     5039           then do:
     5040             create beforesum.
     5041             assign
     5042             beforesum.referenceNo = buf_trn-doc-sum.doc-code
     5043             beforesum.qnty = buf_trn-doc-sum.fact-qnty
     5044             .
     5045             ExpData1:route-data_create-record( INPUT "beforeSum") .
     5046             ExpData1:route-data_copy-record ( input "beforeSum", buffer beforesum:handle).
     5047             IF ExpData1:esys-add-dump( INPUT "beforeSum", INPUT v-esys-cmd-proc-handle, INPUT v-esys-cmd-code, '+update') = false  THEN do:
     5048               v-err-mess = substitute("Ошибка при маршрутизации записи beforeSum &1:&2&3"
     5049                                       , p-doc-code
     5050                                       , chr(10)
     5051                                       , v-last-error-message
     5052                                       ).
     5053               undo main-block, return error v-err-mess.
     5054             end.
     5055             create salesumbeforesum.
     5056             buffer-copy beforesum to salesumbeforesum
     5057             assign
     5058             saleSumBeforeSum.sumR = buf_trn-doc-sum.crsa-sum-rubl
     5059             saleSumBeforeSum.vatR = buf_trn-doc-sum.crsa-vat-rubl
