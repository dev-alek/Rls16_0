     2358       and v-new-stfl-i > v-waiting-stfl-i then do:
     2359         assign
     2360         p-is-waiting-status = yes
     2361         p-direction = '<закрытие документа>':U + chr(4) + "from".
     2362         return.
     2363       end.
     2364       if v-old-stfl-i = v-waiting-stfl-i
     2365       and v-new-stfl-i < v-waiting-stfl-i then do:
     2366         assign
     2367         p-is-waiting-status = yes
     2368         p-direction = '<открытие документа>':U + chr(4) + "from".
     2369         return.
     2370         end.
     2371         end.
     2372      end.
     2373   end procedure.
     2374   procedure stat-graf-trn :
     2375   define input parameter  p-oldbh              as handle no-undo .
     2376   define input parameter  p-newbh              as handle no-undo .
