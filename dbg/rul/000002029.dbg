     5198   procedure export-before-and-after-inv-line :
     5199   define input parameter p-doc-code           as character    no-undo.
     5200   define input parameter p-gds-code           as integer      no-undo.
     5201   define input parameter p-exists-before      as logical      no-undo.
     5202   define input parameter p-exists-after       as logical      no-undo.
     5203   define input parameter p-need-petrol-weight as logical      no-undo.
