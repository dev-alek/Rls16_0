     3833   define dataset waybill-01
     3834   xml-node-name "waybill-01"
     3835   for operation, beforeSum, salesumbeforesum, costsumbeforesum,
     3836   afterSum, salesumaftersum, costsumaftersum,
     3837   linedoc,
     3838   beforeSumLine, salesumbeforesumLine, costsumbeforesumLine,
     3839   afterSumLine, salesumaftersumLine, costsumaftersumLine,
     3840   dtl, part
     3841   data-relation operation-beforesum for operation, beforesum relation-fields (referenceNo, referenceNo) nested
     3842   data-relation beforesum-salesumbeforesum for beforesum, salesumbeforesum relation-fields (referenceNo, referenceNo) nested
     3843   data-relation beforesum-costsumbeforesum for beforesum, costsumbeforesum relation-fields (referenceNo, referenceNo) nested
     3844   data-relation operation-aftersum for operation, aftersum relation-fields (referenceNo, referenceNo) nested
     3845   data-relation aftersum-salesumaftersum for aftersum, salesumaftersum relation-fields (referenceNo, referenceNo) nested
     3846   data-relation aftersum-costsumaftersum for aftersum, costsumaftersum relation-fields (referenceNo, referenceNo) nested
     3847   data-relation operation-linedoc for operation, linedoc relation-fields (referenceNo, referenceNo) nested
     3848   data-relation linedoc-dtl for linedoc, dtl relation-fields (referenceNo, referenceNo, good, good) nested
     3849   data-relation linedoc-part for linedoc, part relation-fields (referenceNo, referenceNo, good, good) nested
     3850   data-relation linedoc-beforesumLine for linedoc, beforesumLine relation-fields (referenceNo, referenceNo, good, good) nested
     3851   data-relation beforesum-salesumbeforesumLine for beforesumLine, salesumbeforesumLine relation-fields (referenceNo, referenceNo, good, good ) nested
     3852   data-relation beforesum-costsumbeforesumLine for beforesumLine, costsumbeforesumLine relation-fields (referenceNo, referenceNo, good, good) nested
     3853   data-relation linedoc-aftersumLine for linedoc, aftersumLine relation-fields (referenceNo, referenceNo, good, good) nested
     3854   data-relation aftersum-salesumaftersumLine for aftersumLine, salesumaftersumLine relation-fields (referenceNo, referenceNo, good, good) nested
     3855   data-relation aftersum-costsumaftersumLine for aftersumLine, costsumaftersumLine relation-fields (referenceNo, referenceNo, good, good) nested
     3856   .
     3857   procedure edocstrn_export :
     3858   define parameter buffer buf_trn-doc for ub.trn-doc.
     3859   define parameter buffer buf_c-trn-doc for ub.c-trn-doc.
     3860   define buffer buf_doc-line for ub.doc-line.
     3861   define variable v-bh as handle no-undo .
     3862   define variable v-bh-line as handle no-undo .
     3863   define variable v-err-mess as character no-undo .
     3864   define variable glog as logical no-undo .
     3865   define variable v-attr-type as character no-undo .
     3866   define variable v-is-out as integer no-undo .
     3867   define variable v-inkas-pay-desk-type  as character no-undo .
     3868   define variable v-scale-is-empty as logical no-undo .
     3869   define variable v-is-petrol                 as logical      no-undo.
     3870   define variable v-is-pieces                 as logical      no-undo.
     3871   define variable v-petrol-weight             as decimal      no-undo.
     3872   define variable v-petrol-density            as decimal      no-undo.
     3873   define variable v-weight-not-specified      as logical      no-undo.
     3874   define variable v-date-valid as logical no-undo .
     3875   define variable v-error-message as character no-undo .
     3876   define variable v-linedoc-hidden as logical no-undo .
     3877   define variable v-dtl-hidden as logical no-undo .
     3878   define variable v-part-hidden as logical no-undo .
     3879   define variable v-date-char as character no-undo .
     3880   define variable v-prodPricewithvat as character no-undo .
     3881   define variable v-prodvat as decimal   no-undo .
     3882   define buffer buf_operation for operation.
     3883   define buffer buf_part for part.
     3884   define buffer buf_currency for ub.currency.
     3885   define buffer buf_goods for ub.goods.
     3886   define buffer buf_units for ub.units.
     3887   define buffer buf_ord-chain   for ub.ord-chain.
     3888   define buffer buf_ord-doc-rcv for ub.ord-doc-rcv.
     3889   define buffer buf_contract for ub.contract.
     3890   define buffer buf_inkas for ub.inkas.
     3891   define buffer buf_gds-dtl for ub.gds-dtl.
     3892   define buffer buf_gds-prt for ub.gds-prt.
     3893   define buffer buf_parts         for ub.parts.
     3894   define buffer buf_parts-attr    for ub.parts-attr.
     3895   main-block:
     3896   do
     3897   on error undo main-block, retry main-block
     3898   on stop undo main-block, retry main-block
     3899   :
     3900     EMPTY TEMP-TABLE operation.
     3901     empty TEMP-TABLE linedoc.
     3902     empty temp-table part.
     3903     if retry then do:
     3904       EMPTY TEMP-TABLE operation.
     3905       empty TEMP-TABLE linedoc.
     3906       empty temp-table part.
     3907           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input v-err-mess).
     3908       return error ''.
     3909     end.
     3910     else do:
     3911       v-bh = buffer buf_trn-doc:handle.
     3912       v-bh-line = buffer buf_doc-line:handle.
     3913       if v-action = 'D':U
     3914       and not available buf_c-trn-doc
     3915       then do:
     3916         find first buf_c-trn-doc no-lock where
     3917                   buf_c-trn-doc.doc-code = buf_trn-doc.doc-code
     3918               and buf_c-trn-doc.is-del = yes no-error.
     3919       end.
     3920       if available buf_trn-doc then do:
     3921         create buf_operation.
     3922         assign
     3923         buf_operation.referenceNo = buf_trn-doc.doc-code
     3924         buf_operation.isDel = (v-action = 'D':U)
     3925         buf_operation.dateDelXml = (if v-action = 'D':U
     3926                                     then (if available buf_c-trn-doc
     3927                                           then buf_c-trn-doc.corr-date
     3928                                           else ?)
     3929                                     else ?)
     3930         buf_operation.codeOperation = buf_trn-doc.ext-doc-type
     3931         buf_operation.host = buf_trn-doc.host-code
     3932         buf_operation.factOrder = buf_trn-doc.fact-order
     3933         buf_operation.sysDateXML = buf_trn-doc.sys-date
     3934         buf_operation.dateDocXML = buf_trn-doc.doc-date
     3935         buf_operation.dateFactXML = buf_trn-doc.fact-date
     3936         buf_operation.shiftDateXML = buf_trn-doc.shift-date
     3937         buf_operation.shiftNum = buf_trn-doc.shift-num
     3938         buf_operation.shiftName = buf_trn-doc.shift-name
     3939         buf_operation.extNumber = buf_trn-doc.ord-num
     3940         buf_operation.outNumber = buf_trn-doc.ship-num
     3941         buf_operation.outDateXML = buf_trn-doc.ship-date
     3942         buf_operation.paymentCode = buf_trn-doc.pay-code
     3943         buf_operation.InterFirmDocChild = buf_trn-doc.hold-doc-code-child
     3944         buf_operation.InterFirmDocParent = buf_trn-doc.hold-doc-code-parent
     3945         buf_operation.InterFirmObjType = buf_trn-doc.hold-obj-type
     3946         buf_operation.InterFirmObjCode = buf_trn-doc.hold-obj-code
     3947         buf_operation.reasonCode = buf_trn-doc.reason-code
     3948         buf_operation.outCode = buf_trn-doc.out-code
     3949         buf_operation.comment = buf_trn-doc.PS
     3950         buf_operation.store = buf_trn-doc.obj-type + string(buf_trn-doc.obj-code)
     3951         buf_operation.systime = string(buf_trn-doc.sys-time-int, "HH:MM:SS")
     3952         buf_operation.firm = buf_trn-doc.cli-type + string(buf_trn-doc.cli-code)
     3953         buf_operation.outDateXML = buf_trn-doc.ship-date
     3954         buf_operation.exchCode =  buf_trn-doc.exch-code
     3955         buf_operation.exchRate =  buf_trn-doc.exch-rate
     3956         buf_operation.exchscale  = buf_trn-doc.exch-scale
     3957         buf_operation.dCard = buf_trn-doc.d-card
     3958         buf_operation.office = buf_trn-doc.office
     3959         buf_operation.docQnty = buf_trn-doc.doc-qnty
     3960         buf_operation.factQnty = buf_trn-doc.fact-qnty
     3961         buf_operation.totalSum = ( if buf_trn-doc.print-rubl = yes
     3962                                   then buf_trn-doc.tot-rubl
     3963                                   else buf_trn-doc.tot-doc )
     3964         buf_operation.totalDsc = ( if buf_trn-doc.print-rubl = yes
     3965                                   then buf_trn-doc.discnt-rubl
     3966                                   else buf_trn-doc.tot-doc - buf_trn-doc.tot-cli )
     3967         buf_operation.totalFact = (if buf_trn-doc.print-rubl
     3968                                   then buf_trn-doc.tot-sale
     3969                                   else buf_trn-doc.tot-fact)
     3970         buf_operation.totalDscFact = ( if buf_trn-doc.print-rubl = yes
     3971                                         then buf_trn-doc.discnt-rubl
     3972                                         else buf_trn-doc.tot-calc )
     3973         buf_operation.vatType = buf_trn-doc.vat-Type
     3974         .
     3975       end.
     3976       else do:
     3977         create buf_operation.
     3978         assign
     3979         buf_operation.referenceNo = buf_c-trn-doc.doc-code
     3980         buf_operation.isDel = (v-action = 'D':U)
     3981         buf_operation.dateDelXml = (if v-action = 'D':U
     3982                                     then (if available buf_c-trn-doc
     3983                                           then buf_c-trn-doc.corr-date
     3984                                           else ?)
     3985                                     else ?)
     3986         buf_operation.codeOperation = buf_c-trn-doc.ext-doc-type
     3987         buf_operation.host = buf_c-trn-doc.host-code
     3988         buf_operation.factOrder = buf_c-trn-doc.fact-order
     3989         buf_operation.sysDateXML = buf_c-trn-doc.sys-date
     3990         buf_operation.dateDocXML = buf_c-trn-doc.doc-date
     3991         buf_operation.dateFactXML = buf_c-trn-doc.fact-date
     3992         buf_operation.shiftDateXML = buf_c-trn-doc.shift-date
     3993         buf_operation.shiftNum = buf_c-trn-doc.shift-num
     3994         buf_operation.shiftName = buf_c-trn-doc.shift-name
     3995         buf_operation.extNumber = buf_c-trn-doc.ord-num
     3996         buf_operation.outNumber = buf_c-trn-doc.ship-num
     3997         buf_operation.outDateXML = buf_c-trn-doc.ship-date
     3998         buf_operation.paymentCode = buf_c-trn-doc.pay-code
     3999         buf_operation.InterFirmDocChild = buf_c-trn-doc.hold-doc-code-child
     4000         buf_operation.InterFirmDocParent = buf_c-trn-doc.hold-doc-code-parent
     4001         buf_operation.InterFirmObjType = buf_c-trn-doc.hold-obj-type
     4002         buf_operation.InterFirmObjCode = buf_c-trn-doc.hold-obj-code
     4003         buf_operation.reasonCode = buf_c-trn-doc.reason-code
     4004         buf_operation.outCode = buf_c-trn-doc.out-code
     4005         buf_operation.comment = buf_c-trn-doc.PS
     4006         buf_operation.store = buf_c-trn-doc.obj-type + string(buf_c-trn-doc.obj-code)
     4007         buf_operation.systime = string(buf_c-trn-doc.sys-time-int, "HH:MM:SS")
     4008         buf_operation.firm = buf_c-trn-doc.cli-type + string(buf_c-trn-doc.cli-code)
     4009         buf_operation.outDateXML = buf_c-trn-doc.ship-date
     4010         buf_operation.exchCode =  buf_c-trn-doc.exch-code
     4011         buf_operation.exchRate =  buf_c-trn-doc.exch-rate
     4012         buf_operation.exchscale  = buf_c-trn-doc.exch-scale
     4013         buf_operation.dCard = buf_c-trn-doc.d-card
     4014         buf_operation.office = buf_c-trn-doc.office
     4015         buf_operation.docQnty = buf_c-trn-doc.doc-qnty
     4016         buf_operation.factQnty = buf_c-trn-doc.fact-qnty
     4017         buf_operation.totalSum = ( if buf_c-trn-doc.print-rubl = yes
     4018                                   then buf_c-trn-doc.tot-rubl
     4019                                   else buf_c-trn-doc.tot-doc )
     4020         buf_operation.totalDsc = ( if buf_c-trn-doc.print-rubl = yes
     4021                                   then buf_c-trn-doc.discnt-rubl
     4022                                   else buf_c-trn-doc.tot-doc - buf_c-trn-doc.tot-cli )
     4023         buf_operation.totalFact = (if buf_c-trn-doc.print-rubl
     4024                                   then buf_c-trn-doc.tot-sale
     4025                                   else buf_c-trn-doc.tot-fact)
     4026         buf_operation.totalDscFact = ( if buf_c-trn-doc.print-rubl = yes
     4027                                         then buf_c-trn-doc.discnt-rubl
     4028                                         else buf_c-trn-doc.tot-calc )
     4029         buf_operation.vatType = buf_c-trn-doc.vat-Type
     4030         .
     4031       end.
     4032       if v-action = 'D':U then do:
     4033         ExpData1:route-data_create-record( INPUT "operation") .
     4034         ExpData1:route-data_copy-record ( input "operation", buffer buf_operation:handle).
     4035         IF ExpData1:esys-add-dump( INPUT "operation", INPUT v-esys-cmd-proc-handle, INPUT v-esys-cmd-code, '+update') = false  THEN do:
     4036           v-err-mess = substitute("Ошибка при маршрутизации записи operation &1:&2&3"
     4037                                   , buf_trn-doc.doc-code
     4038                                   , chr(10)
     4039                                   , v-last-error-message
     4040                                   ).
     4041           undo main-block, retry main-block.
     4042         end.
     4043         return.
     4044       end.
     4045       if buf_trn-doc.doc-type = 'инв':U then do:
     4046          buf_operation.totalPayFact = ?.
     4047       end.
     4048       if (buf_trn-doc.ext-doc-type = 'es':U
     4049       or buf_trn-doc.ext-doc-type = 'rs':U)
     4050       then do:
     4051         buf_operation.totalPayFact = ?.
     4052       end.
     4053       if buf_trn-doc.doc-type = 'при':U and
     4054         buf_trn-doc.internal = no        then do:
     4055         buf_operation.totalPayFact = buf_trn-doc.tot-calc.
     4056       end.
     4057       else do:
     4058         buf_operation.totalPayFact = (if buf_trn-doc.print-rubl
     4059                                       then (buf_trn-doc.tot-sale - buf_trn-doc.discnt-rubl)
     4060                                       else (buf_trn-doc.tot-fact - buf_trn-doc.tot-calc)
     4061                                       ).
     4062       end.
     4063   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     4064   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run r-b-curr in g#library
     4065     (input  buf_trn-doc.host-code
     4066     ,output buf_operation.valutCode
     4067     )  .
     4068       find first buf_currency no-lock where
     4069                 buf_currency.curr-code = buf_operation.valutCode.
     4070       buf_operation.valutCodeOKV = buf_currency.okv-code.
     4071   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input buf_trn-doc.doc-code ,
     4072                           input 'dov':U ,
     4073                          output buf_operation.authority ,
     4074                          output v-attr-type )  .
     4075       v-date-char = ''.
     4076   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input buf_trn-doc.doc-code ,
     4077                           input 'dids':U ,
     4078                          output v-date-char ,
     4079                          output v-attr-type )  .
     4080       v-date-valid = no.
     4081       run strtdate in this-procedure ( input  v-date-char
     4082                                    , output buf_operation.suppInDocDateXml
     4083                                    , output v-date-valid
     4084                                    , output v-error-message
     4085                                    ) no-error.
     4086   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input buf_trn-doc.doc-code ,
     4087                           input 'nids':U ,
     4088                          output buf_operation.suppInDocNo ,
     4089                          output v-attr-type )  .
     4090       if buf_trn-doc.ext-doc-type = 'ie':U
     4091       or buf_trn-doc.ext-doc-type = 'ap':U
     4092       then  do:
     4093         if buf_trn-doc.contract-code <> 0
     4094         then do:
     4095           assign
     4096           buf_operation.contractSuppCode = string( buf_trn-doc.contract-code )
     4097           .
     4098           find first buf_contract no-lock
     4099                 where buf_contract.host-code       = buf_trn-doc.host-code
     4100                   and buf_contract.contract-code   = buf_trn-doc.contract-code
     4101           no-error.
     4102           if available buf_contract
     4103           then do:
     4104             assign
     4105             buf_operation.contractSuppNo          =  buf_contract.contract-prn-code
     4106             buf_operation.contractSuppDateXml          = buf_contract.contract-date
     4107             .
     4108           end.
