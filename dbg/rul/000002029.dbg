     3054   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3055   if v-view-log
     3056   and not g#news
     3057   and not g#auto
     3058   then do:
     3059     message
     3060     '!!!При маршрутизации произошли ошибки!!!'  skip
     3061     "!!!Внимательно прочитайте Log-file!!"
     3062     view-as alert-box error .
     3063        define variable v-user-action22   as character no-undo .
     3064     define variable v-printed22       as logical   no-undo .
     3065     run gbl/prnfilen.w
     3066       (input  ('!!!При маршрутизации произошли ошибки!!!')
     3067       ,input  0
     3068       ,input  (string("./":U) + log-file-name)
     3069       ,input  7
     3070       ,output v-user-action22
     3071       ,output v-printed22
     3072       ) .
