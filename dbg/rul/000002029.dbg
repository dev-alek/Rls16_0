     3077   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
     3078   then do:
     3079      run cb_set-view-log in p-parent-handle ( input yes).
     3080   end.
     3081     if v-es then do:
     3082         run garbcoll_clear in this-procedure .
     3083         undo, return error substitute( "&1. &2&3&4", vss-workfile, v-rv, chr(10), v-esm).
     3084     end.
     3085     run garbcoll_clear in this-procedure .
     3086   end.
     3087   procedure proc-main :
     3088   _main:
     3089   do
     3090   on error undo, return error substitute( "&1&2&3&2&4", return-value, chr(10), error-status :get-message (1), v-last-error-message)
     3091   on stop undo, return error substitute( "&1&2&3&2&4", return-value, chr(10), error-status :get-message (1), v-last-error-message)
     3092   :
     3093   define variable v-doc-code as character no-undo .
     3094   define variable v-trn-doc-obj-type as character no-undo .
     3095   define variable v-trn-doc-obj-code as integer no-undo .
     3096   define variable v-obj-db-num as integer no-undo .
     3097   define variable v-obj-uniq-key-rec as character no-undo .
     3098   define variable v-doc-list-doc-type as character no-undo .
     3099   define buffer buf_trn-doc for ub.trn-doc.
     3100   define buffer buf_c-trn-doc for ub.c-trn-doc.
     3101   define buffer buf_ord-doc for ub.ord-doc.
     3102   define buffer buf_clients for ub.clients.
     3103   define buffer buf_ext-classif for ub.ext-classif.
     3104   _stroka:
     3105   do while true
     3106   on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3107   on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
     3108   on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
     3109   :
     3110     v-esys-id-list = ''.
     3111     v-trn-doc-obj-type = ''.
     3112     v-trn-doc-obj-code = 0.
     3113     if available buf_trn-doc then release buf_trn-doc.
     3114     if available buf_c-trn-doc then release buf_c-trn-doc.
     3115     if available buf_ord-doc then release buf_ord-doc.
     3116     case p-ruleset-id:
     3117       when 2
     3118       or when 14
     3119       then do:
     3120         if v-doc-list-bh:available then do:
     3121           v-doc-list-bh:buffer-delete().
     3122         end.
     3123         run cb_get-next-doc-by-doc-code in v-doc-list-handle ( input v-doc-code
     3124                                                               ,input v-doc-list-doc-type
     3125                                                               ,input v-doc-list-bh
     3126                                                               ).
     3127         if v-doc-list-bh:available then do:
     3128           if num-rec-pre > 0 then do:
     3129             run write-counter in p-log-handle ( input substitute("Просмотрено документов списка &1, обработано  &2, из них удачно: &3", num-rec-pre, num-rec, num-rec-ok)).
     3130           end.
     3131           num-rec-pre = num-rec-pre + 1.
     3132           v-trn-doc-obj-type = v-doc-list-bh:buffer-field("obj-type"):buffer-value.
     3133           v-trn-doc-obj-code = v-doc-list-bh:buffer-field("obj-code"):buffer-value.
     3134           v-doc-code = v-doc-list-bh:buffer-field("doc-code"):buffer-value.
     3135           v-doc-list-doc-type = v-doc-list-bh:buffer-field("doc-type"):buffer-value.
     3136           if p-ruleset-id = 2
     3137           and v-doc-list-doc-type <> 'ОП':U then do:
     3138             next _stroka.
     3139           end.
     3140           if p-ruleset-id = 14
     3141           and not
     3142            (lookup(v-doc-list-doc-type,  'при,рас,спи,возврат,инв':U) > 0
     3143             or
     3144                (v-doc-list-doc-type begins "-"
     3145                and
     3146                lookup(entry(2, "-", v-doc-list-doc-type),  'при,рас,спи,возврат,инв':U) > 0
     3147                )
     3148           )
     3149           then do:
     3150             next _stroka.
     3151           end.
     3152         END.
     3153         else do:
     3154           v-trn-doc-obj-type = ''.
     3155           v-trn-doc-obj-code = 0.
     3156           v-doc-code = ''.
     3157           leave _stroka.
     3158         end.
     3159       end.
     3160       when 100
     3161       or
     3162       when 115
     3163       then do:
     3164         if v-has-newbh then do:
     3165           v-trn-doc-obj-type = v-newbh::obj-type.
     3166           v-trn-doc-obj-code = v-newbh::obj-code.
     3167           v-doc-code = v-newbh:buffer-field("doc-code"):buffer-value.
     3168         end.
     3169         else do:
     3170           v-trn-doc-obj-type = v-oldbh::obj-type.
     3171           v-trn-doc-obj-code = v-oldbh::obj-code.
     3172           v-doc-code = v-oldbh:buffer-field("doc-code"):buffer-value.
     3173         end.
     3174       end.
     3175     end case.
     3176     find first buf_clients no-lock where
     3177               buf_clients.obj-type = v-trn-doc-obj-type
     3178          and  buf_clients.obj-code = v-trn-doc-obj-code.
     3179     run gen-key-rec in this-procedure ( input 'clients':U
     3180                                        ,input buffer buf_clients:handle
     3181                                        ,output v-obj-uniq-key-rec).
     3182     v-esys-id-list = ''.
     3183     for each buf_ext-classif no-lock where
     3184         buf_ext-classif.classif-name = 'clients-esys':U
     3185     and buf_ext-classif.classif-subject = 'clients':U
     3186     and buf_ext-classif.db-num = 0
     3187     and buf_Ext-classif.uniq-key-rec = v-obj-uniq-key-rec :
     3188       if lookup(string(buf_ext-classif.key#_one), v-esys-id-list-start, chr(1)) = 0 then next.
     3189       v-esys-id-list = v-esys-id-list + (if v-esys-id-list = '' then '' else chr(1)) + string(buf_ext-classif.key#_one).
     3190     end.
     3191     case p-ruleset-id:
     3192       when 100
     3193       or when 115 then do:
     3194         if v-esys-id-list = '' then leave _stroka.
     3195       end.
     3196       when 2
     3197       or when 14 then do:
     3198         if v-esys-id-list = '' then next _stroka.
     3199       end.
     3200     end case.
     3201     if p-save >= 0 then do:
     3202       case p-ruleset-id:
     3203         when 115 then do:
     3204           find first buf_trn-doc exclusive-lock where
     3205                     buf_trn-doc.doc-code = v-doc-code
     3206                   no-error.
     3207         end.
     3208         when 14 then do:
     3209           if v-doc-list-doc-type begins "-" then do:
     3210             find first buf_c-trn-doc exclusive-lock where
     3211                       buf_c-trn-doc.doc-code = v-doc-code
     3212                   and buf_c-trn-doc.is-del = yes
     3213                     no-error.
     3214             v-action = 'D':U.
     3215           end.
     3216           else do:
     3217             find first buf_trn-doc exclusive-lock where
     3218                       buf_trn-doc.doc-code = v-doc-code
     3219                     no-error.
     3220              v-action = 'U':U.
     3221           end.
     3222         end.
     3223         when 100
     3224         or
     3225         when 2
     3226         then do:
     3227           find first buf_ord-doc exclusive-lock where
     3228                     buf_ord-doc.doc-code = v-doc-code
     3229                   no-error.
     3230         end.
     3231       end case.
     3232     end.
     3233     else do:
     3234       case p-ruleset-id:
     3235         when 115 then do:
     3236           find first buf_trn-doc no-lock where
     3237                     buf_trn-doc.doc-code = v-doc-code
     3238                   no-error.
     3239         end.
     3240         when 14 then do:
     3241           if v-doc-list-doc-type begins "-" then do:
     3242             find first buf_c-trn-doc no-lock where
     3243                       buf_c-trn-doc.doc-code = v-doc-code
     3244                   and buf_c-trn-doc.is-del = yes
     3245                     no-error.
     3246             v-action = 'D':U.
     3247           end.
     3248           else do:
     3249             find first buf_trn-doc no-lock where
     3250                       buf_trn-doc.doc-code = v-doc-code
     3251                     no-error.
     3252              v-action = 'U':U.
     3253           end.
     3254         end.
     3255         when 100
     3256         or when 2
     3257         then do:
     3258           find first buf_ord-doc no-lock where
     3259                     buf_ord-doc.doc-code = v-doc-code
     3260                   no-error.
     3261         end.
     3262       end case.
     3263     end.
     3264     case p-ruleset-id:
     3265       when 2 then do:
     3266         if not (buf_ord-doc.status_ = 'факт':U) then next _stroka.
     3267       end.
     3268       when 14 then do:
     3269         if v-doc-list-doc-type begins "-" then do:
     3270           if not (buf_c-trn-doc.status_ = 'факт':U
     3271           and buf_c-trn-doc.flag_ = yes) then next _stroka.
     3272         end.
     3273         else do:
     3274           if not (buf_trn-doc.status_ = 'факт':U
     3275           and buf_trn-doc.flag_ = yes) then next _stroka.
     3276         end.
     3277       end.
     3278     end case.
     3279     num-rec = num-rec + 1.
     3280     IF  ExpData1:route-data_read-xmlschema( INPUT p-xsd-file) = false  THEN do:
     3281       undo _main, return error v-last-error-message .
     3282     end.
     3283     IF  context_begin-esys-command( input v-esys-id-list
     3284                                   , input-output v-esys-cmd-proc-handle
     3285                                   , output v-esys-cmd-code) = false  THEN do:
     3286       undo _main, return error v-last-error-message .
     3287     end.
     3288     case p-ruleset-id:
     3289       when 115
     3290       or when 14
     3291       then do:
     3292         run edocstrn_export in this-procedure ( buffer buf_trn-doc
     3293                                                ,buffer buf_c-trn-doc
     3294                                               ) no-error.
     3295       end.
     3296       when 100
     3297       or
     3298       when 2
     3299       then do:
     3300         run edocsord_export in this-procedure ( buffer buf_ord-doc
     3301                                               ) no-error.
     3302       end.
     3303     end case.
     3304     if error-status:error then do:
     3305       undo _main, return error ''.
     3306     end.
     3307     IF  context_send-esys-command( input v-esys-id-list
     3308                                 , input v-esys-cmd-proc-handle
     3309                                 , input v-esys-cmd-code
     3310                                 , input g#userid) = false  THEN do:
     3311       undo _main, return error v-last-error-message .
     3312     end.
     3313     num-rec-ok = num-rec-ok + 1.
     3314       ExpData1:Route-data_clear-data ( ) .
     3315     if p-ruleset-id = 100
     3316     or p-ruleset-id = 115 then do:
     3317       leave _stroka.
     3318     end.
     3319     else do:
     3320       run get-stop-state in p-log-handle ( output v-stop) no-error .
     3321       if v-stop then do:
     3322               run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Процесс прерван пользователем")).
     3323         leave _stroka.
     3324       end.
     3325     end.
     3326   end.
     3327   if p-ruleset-id = 10
     3328   or p-ruleset-id = 14 then do:
     3329       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Просмотрено документов списка &1, обработано  &2, из них удачно: &3", num-rec-pre, num-rec, num-rec-ok)).
     3330   end.
     3331   end.
     3332   end procedure.
     3333   procedure load-ruleset-context :
     3334   define input parameter p-ruleset-id as integer no-undo .
     3335   define variable v-flag as logical no-undo .
     3336   define variable v-ii as integer no-undo .
     3337   define variable v-is-waiting-status as logical no-undo .
     3338   define variable v-direction as character no-undo .
     3339   define variable v-direction-2 as character no-undo .
     3340   define variable v-changes-list as character no-undo .
     3341   define variable v-h as handle no-undo .
     3342   define buffer buf_rule-call-param for ub.rule-call-param.
     3343   define buffer buf_temp-rule-call-param for temp-rule-call-param.
     3344   define buffer buf_ext-system for ub.ext-system.
     3345   do
     3346   on error undo, return error
     3347   on stop undo, return error
     3348   :
     3349     case p-ruleset-id:
     3350       when 2
     3351       or when 14
     3352       then do:
     3353   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3354   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run calltree in g#library
     3355     (input  'cb_get-next-doc-by-doc-code'
     3356     ,input  this-procedure:handle
     3357     ,input  p-cont-handle
     3358     ,output v-doc-list-handle
     3359     )  .
     3360   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3361   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run calltree in g#library
     3362     (input  'cb_rcps-run_fill-rcp-from-tt0'
     3363     ,input  this-procedure:handle
     3364     ,input  p-cont-handle
     3365     ,output v-h
     3366     )  .
     3367         run  cb_rcps-run_fill-rcp-from-tt0 in v-h ( input p-call-id
     3368                                                   ,input buffer buf_temp-rule-call-param:handle
     3369                                                                 ).
     3370         for each buf_temp-rule-call-param no-lock where
     3371         buf_temp-rule-call-param.codex_id = p-codex-id
     3372         and buf_temp-rule-call-param.ruleset_id = p-ruleset-id
     3373         and buf_temp-rule-call-param.call_id = p-call-id
     3374         and buf_temp-rule-call-param.order_id = p-order-id
     3375         and buf_temp-rule-call-param.rule_id = p-rule-id
     3376         and buf_temp-rule-call-param.param-name = "p-esys-id-list",
     3377           first buf_ext-system no-lock where
     3378                 buf_Ext-system.esys-id = buf_temp-rule-call-param.param-value-integer
     3379             and buf_Ext-system.db-num = 0
     3380             and buf_Ext-system.esys-have-export = yes
     3381             and buf_Ext-system.esys-db-num-exp = g#db-num:
     3382           v-esys-id-list-start = v-esys-id-list-start + (if v-esys-id-list-start = '' then '' else chr(1)) + string(buf_ext-system.esys-id).
     3383         end.
     3384         if v-esys-id-list-start = '' then return "return".
     3385         find first buf_temp-rule-call-param no-lock where
     3386         buf_temp-rule-call-param.codex_id = p-codex-id
     3387         and buf_temp-rule-call-param.ruleset_id = p-ruleset-id
     3388         and buf_temp-rule-call-param.call_id = p-call-id
     3389         and buf_temp-rule-call-param.order_id = p-order-id
     3390         and buf_temp-rule-call-param.rule_id = p-rule-id
     3391         and buf_temp-rule-call-param.param-name = "p-xsd-file"
     3392         no-error.
     3393         if available buf_temp-rule-call-param then do:
     3394           assign p-xsd-file = buf_temp-rule-call-param.param-value-character.
     3395         end.
     3396         v-doc-list-bh = buffer doc-list:handle.
     3397         v-action = 'U':U.
     3398       end.
     3399       when 100
     3400       or when 115 then do:
     3401         assign
     3402         v-oldbh = widget-handle (entry(2, p-doc-code, chr(4)))
     3403         v-newbh = widget-handle (entry(3, p-doc-code, chr(4)))
     3404         v-changes-list = entry(4, p-doc-code, chr(4))
     3405         file-name  = p-process-file-name
     3406         v-has-oldbh = valid-handle(v-oldbh) and v-oldbh:available
     3407         v-has-newbh = valid-handle(v-newbh) and v-newbh:available
     3408         .
     3409         if not v-has-newbh
     3410         and not v-has-oldbh then do:
     3411           undo, return error substitute("Не определено ни одного буфера - ни старый, ни новый").
     3412         end.
     3413         if not v-has-oldbh
     3414         and v-changes-list  = '' then do:
     3415           undo, return error substitute("Не определен старый буфер и список изменений").
     3416         end.
     3417         case p-ruleset-id:
     3418           when 115 then do:
     3419             if v-has-newbh
     3420             and v-newbh:table <> 'trn-doc':U then do:
     3421               undo, return error substitute("Передан неверный буфер вместо буфера для &1",  'trn-doc':U).
     3422             end.
     3423             run statq_has-waiting-stat in this-procedure (
     3424                                                             input v-oldbh
     3425                                                           ,input v-newbh
     3426                                                           ,input v-changes-list
     3427                                                           ,input 'факт':U
     3428                                                           ,input yes
     3429                                                           ,input 0
     3430                                                           ,output v-is-waiting-status
     3431                                                           ,output v-direction
     3432                                                           ) no-error.
     3433           end.
     3434           when 100 then do:
     3435             if v-has-newbh
     3436             and v-newbh:table <> 'ord-doc':U then do:
     3437               undo, return error substitute("Передан неверный буфер вместо буфера для &1",  'ord-doc':U).
     3438             end.
     3439             if v-has-newbh
     3440             and v-newbh::doc-type <> 'ОП':U then return "return".
     3441             if not v-has-newbh
     3442             and v-has-oldbh
     3443             and v-oldbh::doc-type <> 'ОП':U then return "return".
     3444             run statq_has-waiting-stat in this-procedure (
     3445                                                             input v-oldbh
     3446                                                           ,input v-newbh
     3447                                                           ,input v-changes-list
     3448                                                           ,input 'поставка':U
     3449                                                           ,input yes
     3450                                                           ,input 0
     3451                                                           ,output v-is-waiting-status
     3452                                                           ,output v-direction
     3453                                                           ) no-error.
     3454           end.
     3455         end case.
     3456         if v-is-waiting-status = no then return "return".
     3457         if num-entries(v-direction, chr(4)) > 1 then do:
     3458           v-direction-2 = entry(2, v-direction, chr(4)).
     3459           v-direction = entry(1, v-direction, chr(4)).
     3460           if v-direction-2 <> "to"
     3461           and v-direction-2 <> "from" then return "return".
     3462           if v-direction = '<открытие документа>':U
     3463           and v-direction-2 = "to" then return "return".
     3464           if v-direction = '<закрытие документа>':U
     3465           and v-direction-2 = "from" then return "return".
     3466         end.
     3467         if v-direction = '<открытие документа>':U
     3468         or v-direction = 'удаление':U
     3469         then do:
     3470           v-action = 'D':U.
     3471         end.
     3472         else do:
     3473           v-action = 'U':U.
     3474         end.
     3475         for each buf_rule-call-param no-lock where
     3476         buf_rule-call-param.codex_id = p-codex-id
     3477         and buf_rule-call-param.ruleset_id = p-ruleset-id
     3478         and buf_rule-call-param.call_id = p-call-id
     3479         and buf_rule-call-param.order_id = p-order-id
     3480         and buf_rule-call-param.rule_id = p-rule-id
     3481         and buf_rule-call-param.param-name = "p-esys-id-list",
     3482           first buf_ext-system no-lock where
     3483                 buf_Ext-system.esys-id = buf_rule-call-param.param-value-integer
     3484             and buf_Ext-system.db-num = 0
     3485             and buf_Ext-system.esys-have-export = yes
     3486             and buf_Ext-system.esys-db-num-exp = g#db-num:
     3487           v-esys-id-list-start = v-esys-id-list-start + (if v-esys-id-list-start = '' then '' else chr(1)) + string(buf_ext-system.esys-id).
     3488         end.
     3489         if v-esys-id-list-start = '' then return "return".
     3490           find first buf_rule-call-param no-lock where
     3491         buf_rule-call-param.codex_id = p-codex-id
     3492         and buf_rule-call-param.ruleset_id = p-ruleset-id
     3493         and buf_rule-call-param.call_id = p-call-id
     3494         and buf_rule-call-param.order_id = p-order-id
     3495         and buf_rule-call-param.rule_id = p-rule-id
     3496         and buf_rule-call-param.param-name = "p-xsd-file"
     3497         no-error.
     3498         if available buf_rule-call-param then do:
     3499         assign p-xsd-file = buf_rule-call-param.param-value-character.
     3500         end.
     3501       end.
     3502       otherwise do:
     3503         undo, return error substitute("Неверный вызов &1 для набора правил &2", vss-workfile , p-ruleset-id).
     3504       end.
     3505     end case.
     3506   end.
     3507   end procedure.
