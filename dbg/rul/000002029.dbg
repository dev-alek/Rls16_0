     2433   v-stat-list[lookup('ev':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] = v-stat-list-all
     2434   v-stat-list[lookup('io':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] = v-stat-list-all
     2435   v-stat-list[lookup('eo':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] = v-stat-list-all
     2436   v-stat-list[lookup('rv':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] = v-stat-list-all
     2437   v-stat-list[lookup('em':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] = v-stat-list-all
     2438   v-stat-list[lookup('wm':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] =
     2439                                                                   ''              + chr(4) + string(no) + chr(3) +
     2440                                                                   'прво':U + chr(4) + string(yes) + chr(3) +
     2441                                                                   'факт':U         + chr(4) + string(yes)
     2442   v-stat-list[lookup('im':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] =
     2443                                                                   ''              + chr(4) + string(no) + chr(3) +
     2444                                                                   'факт':U         + chr(4) + string(yes)
     2445   v-stat-list[lookup('ap':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] =
     2446                                                                         ''              + chr(4) + string(no) + chr(3) +
     2447                                                                         'накл':U         + chr(4) + string(no) + chr(3) +
     2448                                                                         'факт':U         + chr(4) + string(yes)
     2449   v-stat-list[lookup('mp':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] =
     2450                                                                         ''              + chr(4) + string(no) + chr(3) +
     2451                                                                         'факт':U         + chr(4) + string(yes)
     2452   v-stat-list[lookup('pc':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] =
     2453                                                                         ''              + chr(4) + string(no) + chr(3) +
     2454                                                                         'факт':U         + chr(4) + string(yes)
     2455   .
     2456   assign
     2457   v-stat-list[lookup('ie':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 2] =
     2458                    '' +           chr(4) + string(no) + chr(3) +
     2459                    'запрос':U +   chr(4) + string(no) + chr(3) +
     2460                    'запрос':U +   chr(4) + string(yes) + chr(3) +
     2461                    'накл':U +      chr(4) + string(no) + chr(3) +
     2462                    'накл':U +      chr(4) + string(yes) + chr(3) +
     2463                    'разрешен':U + chr(4) + string(no) + chr(3) +
     2464                    'разрешен':U + chr(4) + string(yes) + chr(3) +
     2465                    'факт':U +      chr(4) + string(no)
     2466   .
     2467   assign
     2468   v-stat-list[lookup('vt':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] =
     2469                    '' +           chr(4) + string(no) + chr(3) +
     2470                    'запрос':U +   chr(4) + string(no) + chr(3) +
     2471                    'запрос':U +   chr(4) + string(yes) + chr(3) +
     2472                    'накл':U +      chr(4) + string(no) + chr(3) +
     2473                    'накл':U +      chr(4) + string(yes) + chr(3) +
     2474                    'разрешен':U + chr(4) + string(yes) + chr(3) +
     2475                    'разрешен':U + chr(4) + string(no) + chr(3) +
     2476                    'факт':U +      chr(4) + string(yes)
     2477   .
     2478   assign
     2479   v-stat-list[lookup('vt':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 2] =
     2480                    '' +           chr(4) + string(no) + chr(3) +
     2481                    'запрос':U +   chr(4) + string(no) + chr(3) +
     2482                    'запрос':U +   chr(4) + string(yes) + chr(3) +
     2483                    'накл':U +      chr(4) + string(no) + chr(3) +
     2484                    'накл':U +      chr(4) + string(yes) + chr(3) +
     2485                    'разрешен':U + chr(4) + string(yes) + chr(3) +
     2486                    'разрешен':U + chr(4) + string(no) + chr(3) +
     2487                    'факт':U +      chr(4) + string(no)
     2488   .
     2489   assign
     2490   v-stat-list[lookup('es':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] =
     2491                    '' +           chr(4) + string(no) + chr(3) +
     2492                    'касс':U + chr(4) + string(no) + chr(3) +
     2493                    'касс':U + chr(4) + string(yes) + chr(3) +
     2494                    'нередакт':U + chr(4) + string(yes) + chr(3) +
     2495                    'факт':U +      chr(4) + string(yes)
     2496   v-stat-list[lookup('rs':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] =
     2497                    '' +           chr(4) + string(no) + chr(3) +
     2498                    'касс':U + chr(4) + string(no) + chr(3) +
     2499                    'касс':U + chr(4) + string(yes) + chr(3) +
     2500                    'нередакт':U + chr(4) + string(yes) + chr(3) +
     2501                    'факт':U +      chr(4) + string(yes)
     2502   v-stat-list[lookup('es':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 2] =
     2503                    '' +         chr(4) + string(no) + chr(3) +
     2504                    'запрос':U + chr(4) + string(no)
     2505   v-stat-list[lookup('rs':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 2] =
     2506                    '' +         chr(4) + string(no) + chr(3) +
     2507                    'запрос':U + chr(4) + string(no)
     2508   .
     2509   _jj:
     2510   do v-jj = 1 to 2:
     2511     if v-jj = 1 then do:
     2512       assign
     2513       v-waiting-stfl = p-waiting-status + chr(4) + string(if p-waiting-flag = ? then yes else p-waiting-flag)
     2514       .
     2515     end.
     2516     if v-jj = 2 then do:
     2517       if p-waiting-flag <> ? then leave  _jj.
     2518       assign
     2519       v-waiting-stfl = p-waiting-status + chr(4) + string(no)
     2520       .
     2521     end.
     2522     assign
     2523     v-old-stfl = p-oldbh::status_ + chr(4) + string(p-oldbh::flag_)
     2524     .
     2525     assign
     2526     v-new-stfl = p-newbh::status_ + chr(4) + string(p-newbh::flag_)
     2527     .
     2528     _ii:
     2529     do v-ii = (lookup(v-ext-doc-type, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3) to (lookup(v-ext-doc-type, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4):
     2530       if v-stat-list[v-ii] = '' then next.
     2531       assign
     2532       v-waiting-stfl-i = lookup(v-waiting-stfl, v-stat-list[v-ii], chr(3))
     2533       v-old-stfl-i = lookup(v-old-stfl, v-stat-list[v-ii], chr(3))
     2534       v-new-stfl-i = lookup(v-new-stfl, v-stat-list[v-ii], chr(3))
     2535       .
     2536       if v-waiting-stfl-i = 0
     2537       or v-old-stfl-i = 0
     2538       or v-new-stfl-i = 0
     2539       then do:
     2540         next _ii.
     2541       end.
     2542       if v-old-stfl-i < v-waiting-stfl-i
     2543       and v-new-stfl-i = v-waiting-stfl-i then do:
     2544         assign
     2545         p-is-waiting-status = yes
     2546         p-direction = '<закрытие документа>':U + chr(4) + "to".
     2547         return.
     2548       end.
     2549       if v-old-stfl-i < v-waiting-stfl-i
     2550       and v-new-stfl-i > v-waiting-stfl-i then do:
     2551         assign
     2552         p-is-waiting-status = yes
     2553         p-direction = '<закрытие документа>':U + chr(4) + "to-up".
     2554         return.
     2555       end.
     2556       if v-new-stfl-i = v-waiting-stfl-i
     2557       and v-old-stfl-i > v-waiting-stfl-i then do:
     2558         assign
     2559         p-is-waiting-status = yes
     2560         p-direction = '<открытие документа>':U + chr(4) + "to".
     2561         return.
     2562       end.
     2563       if v-new-stfl-i < v-waiting-stfl-i
     2564       and v-old-stfl-i > v-waiting-stfl-i then do:
     2565         assign
     2566         p-is-waiting-status = yes
     2567         p-direction = '<открытие документа>':U + chr(4) + "to-down".
     2568         return.
     2569       end.
     2570       if v-old-stfl-i = v-waiting-stfl-i
     2571       and v-new-stfl-i > v-waiting-stfl-i then do:
     2572         assign
     2573         p-is-waiting-status = yes
     2574         p-direction = '<закрытие документа>':U + chr(4) + "from".
     2575         return.
     2576       end.
     2577       if v-old-stfl-i = v-waiting-stfl-i
     2578       and v-new-stfl-i < v-waiting-stfl-i then do:
     2579         assign
     2580         p-is-waiting-status = yes
     2581         p-direction = '<открытие документа>':U + chr(4) + "from".
     2582         return.
     2583       end.
     2584     end.
     2585   end.
     2586   end.
     2587   end procedure .
     2588   procedure stat-graf-price :
     2589   define input parameter p-oldbh              as handle no-undo .
     2590   define input parameter p-newbh              as handle no-undo .
     2591   define input parameter p-changed-fields     as character no-undo .
     2592   define input parameter p-waiting-status     as character no-undo .
     2593   define input parameter p-waiting-flag       as logical no-undo .
     2594   define output parameter p-is-waiting-status as logical no-undo .
     2595   define output parameter p-direction         as character no-undo .
     2596   define variable v-stat-list as character no-undo extent 5.
     2597   define variable v-waiting-stfl as character no-undo .
     2598   define variable v-old-stfl as character no-undo .
     2599   define variable v-new-stfl as character no-undo .
     2600   define variable v-waiting-stfl-i as integer no-undo .
     2601   define variable v-old-stfl-i as integer no-undo .
     2602   define variable v-new-stfl-i as integer no-undo .
     2603   define variable v-ii as integer no-undo .
     2604   do
     2605   on error undo, return error return-value
     2606   :
     2607   assign
     2608   v-stat-list[1] =
     2609                    ''            +  chr(3) +
     2610                    'новый':U    +  chr(3) +
     2611                    'приказ':U      +  chr(3) +
     2612                    'разрешен':U  +  chr(3) +
     2613                    'акт':U
     2614   .
     2615     assign
     2616     v-waiting-stfl = p-waiting-status
     2617     .
     2618     assign
     2619     v-old-stfl = p-oldbh::status_
     2620     .
     2621     assign
     2622     v-new-stfl = p-newbh::status_
     2623     .
     2624     _ii:
     2625     do v-ii = 1 to 5:
     2626       if v-stat-list[v-ii] = '' then next.
     2627       assign
     2628       v-waiting-stfl-i = lookup(v-waiting-stfl, v-stat-list[v-ii], chr(3))
     2629       v-old-stfl-i = lookup(v-old-stfl, v-stat-list[v-ii], chr(3))
     2630       v-new-stfl-i = lookup(v-new-stfl, v-stat-list[v-ii], chr(3))
     2631       .
     2632       if v-waiting-stfl-i = 0
     2633       or v-old-stfl-i = 0
     2634       or v-new-stfl-i = 0
     2635       then do:
     2636         next _ii.
     2637       end.
     2638       if v-old-stfl-i < v-waiting-stfl-i
     2639       and v-new-stfl-i = v-waiting-stfl-i then do:
     2640         assign
     2641         p-is-waiting-status = yes
     2642         p-direction = '<закрытие документа>':U + chr(4) + "to".
     2643         return.
     2644       end.
     2645       if v-old-stfl-i < v-waiting-stfl-i
     2646       and v-new-stfl-i > v-waiting-stfl-i then do:
     2647         assign
     2648         p-is-waiting-status = yes
     2649         p-direction = '<закрытие документа>':U + chr(4) + "to-up".
     2650         return.
     2651       end.
     2652       if v-new-stfl-i = v-waiting-stfl-i
     2653       and v-old-stfl-i > v-waiting-stfl-i then do:
     2654         assign
     2655         p-is-waiting-status = yes
     2656         p-direction = '<открытие документа>':U + chr(4) + "to".
     2657         return.
     2658       end.
     2659       if v-new-stfl-i < v-waiting-stfl-i
     2660       and v-old-stfl-i > v-waiting-stfl-i then do:
     2661         assign
     2662         p-is-waiting-status = yes
     2663         p-direction = '<открытие документа>':U + chr(4) + "to-down".
     2664         return.
     2665       end.
     2666       if v-old-stfl-i = v-waiting-stfl-i
     2667       and v-new-stfl-i > v-waiting-stfl-i then do:
     2668         assign
     2669         p-is-waiting-status = yes
     2670         p-direction = '<закрытие документа>':U + chr(4) + "from".
     2671         return.
     2672       end.
     2673       if v-old-stfl-i = v-waiting-stfl-i
     2674       and v-new-stfl-i < v-waiting-stfl-i then do:
     2675         assign
     2676         p-is-waiting-status = yes
     2677         p-direction = '<открытие документа>':U + chr(4) + "from".
     2678         return.
     2679       end.
     2680     end.
     2681   end.
     2682   end procedure.
     2683   procedure stat-graf-inkas :
     2684   define input parameter  p-oldbh              as handle no-undo .
     2685   define input parameter  p-newbh              as handle no-undo .
     2686   define input parameter  p-changed-fields     as character no-undo .
     2687   define input parameter  p-waiting-status     as character no-undo .
     2688   define input parameter  p-waiting-flag       as logical no-undo .
     2689   define output parameter p-is-waiting-status  as logical no-undo .
     2690   define output parameter p-direction          as character no-undo .
     2691   define variable v-doc-code as character no-undo .
     2692   define variable v-ext-doc-type as character no-undo .
     2693   define variable v-stat-list as character no-undo extent 3.
     2694   define variable v-jj as integer no-undo .
     2695   define variable v-ii as integer no-undo .
     2696   define variable v-old-stfl as character no-undo .
     2697   define variable v-new-stfl as character no-undo .
     2698   define variable v-waiting-stfl as character no-undo .
     2699   define variable v-old-stfl-i as integer no-undo .
     2700   define variable v-new-stfl-i as integer no-undo .
     2701   define variable v-waiting-stfl-i as integer no-undo .
     2702   do
     2703   on error  undo, return error substitute( "&1. &2&3&4", vss-include-info13, return-value, chr(10), error-status :get-message (1))
     2704   :
     2705   if p-newbh = ?  then do:
     2706     v-doc-code = p-oldbh::inkas-code .
     2707   end.
     2708   else do:
     2709     v-doc-code     = p-newbh::inkas-code .
     2710   end.
     2711   assign
     2712   v-stat-list[1] =
     2713                    '' +           chr(4) + string(no) + chr(3) +
     2714                    'новый':U + chr(4) + string(no) + chr(3) +
     2715                    'факт':U +      chr(4) + string(no)
     2716   v-stat-list[2] =
     2717                    '' +           chr(4) + string(no) + chr(3) +
     2718                    'новый':U + chr(4) + string(no) + chr(3) +
     2719                    'новый':U + chr(4) + string(yes) + chr(3) +
     2720                    'нередакт':U + chr(4) + string(yes) + chr(3) +
     2721                    'факт':U +      chr(4) + string(no)
     2722   v-stat-list[3] =
     2723                    '' +         chr(4) + string(no) + chr(3) +
     2724                    'запрос':U + chr(4) + string(no)
     2725   .
     2726   _jj:
     2727   do v-jj = 1 to 2:
     2728     if v-jj = 1 then do:
     2729       assign
     2730       v-waiting-stfl = p-waiting-status + chr(4) + string(if p-waiting-flag = ? then no else p-waiting-flag)
     2731       .
     2732     end.
     2733     if v-jj = 2 then do:
     2734       if p-waiting-flag <> ? then leave  _jj.
     2735       assign
     2736       v-waiting-stfl = p-waiting-status + chr(4) + string(yes)
     2737       .
     2738     end.
     2739     assign
     2740     v-old-stfl = p-oldbh::status_ + chr(4) + string(p-oldbh::flag_)
     2741     .
     2742     assign
     2743     v-new-stfl = p-newbh::status_ + chr(4) + string(p-newbh::flag_)
     2744     .
     2745     _ii:
     2746     do v-ii = 1 to 3:
     2747       if v-stat-list[v-ii] = '' then next.
     2748       assign
     2749       v-waiting-stfl-i = lookup(v-waiting-stfl, v-stat-list[v-ii], chr(3))
     2750       v-old-stfl-i = lookup(v-old-stfl, v-stat-list[v-ii], chr(3))
     2751       v-new-stfl-i = lookup(v-new-stfl, v-stat-list[v-ii], chr(3))
     2752       .
     2753       if v-waiting-stfl-i = 0
     2754       or v-old-stfl-i = 0
     2755       or v-new-stfl-i = 0
     2756       then do:
     2757         next _ii.
     2758       end.
     2759       if v-old-stfl-i < v-waiting-stfl-i
     2760       and v-new-stfl-i = v-waiting-stfl-i then do:
     2761         assign
     2762         p-is-waiting-status = yes
     2763         p-direction = '<закрытие документа>':U + chr(4) + "to".
     2764         return.
     2765       end.
     2766       if v-old-stfl-i < v-waiting-stfl-i
     2767       and v-new-stfl-i > v-waiting-stfl-i then do:
     2768         assign
     2769         p-is-waiting-status = yes
     2770         p-direction = '<закрытие документа>':U + chr(4) + "to-up".
     2771         return.
     2772       end.
     2773       if v-new-stfl-i = v-waiting-stfl-i
     2774       and v-old-stfl-i > v-waiting-stfl-i then do:
     2775         assign
     2776         p-is-waiting-status = yes
     2777         p-direction = '<открытие документа>':U + chr(4) + "to".
     2778         return.
     2779       end.
     2780       if v-new-stfl-i < v-waiting-stfl-i
     2781       and v-old-stfl-i > v-waiting-stfl-i then do:
     2782         assign
     2783         p-is-waiting-status = yes
     2784         p-direction = '<открытие документа>':U + chr(4) + "to-down".
     2785         return.
     2786       end.
     2787       if v-old-stfl-i = v-waiting-stfl-i
     2788       and v-new-stfl-i > v-waiting-stfl-i then do:
     2789         assign
     2790         p-is-waiting-status = yes
     2791         p-direction = '<закрытие документа>':U + chr(4) + "from".
     2792         return.
     2793       end.
     2794       if v-old-stfl-i = v-waiting-stfl-i
     2795       and v-new-stfl-i < v-waiting-stfl-i then do:
     2796         assign
     2797         p-is-waiting-status = yes
     2798         p-direction = '<открытие документа>':U + chr(4) + "from".
     2799         return.
     2800       end.
     2801     end.
     2802   end.
     2803   end.
     2804   end procedure .
