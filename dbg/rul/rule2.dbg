        1   block-level on error undo, throw.
        2   define input parameter p-silent                       as logical no-undo .
        3   define input parameter par-recid as recid no-undo.
        4   define input parameter p-sts as integer no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision$":U .
        6   define variable vss-author      as character no-undo init "$Author$":U .
        7   define variable vss-date        as character no-undo init "$Date$":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        9   define variable vss-archive     as character no-undo init "$Archive$":U .
       10   define variable vss-description as character no-undo init "Изменение статуса правила".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   define   shared variable g#auto as logical no-undo.
       72   define   shared variable g#news as logical no-undo.
       73   define   shared variable g#oxml as logical no-undo.
       74   define   shared variable g#esys as logical no-undo.
       75   define   shared variable g#news-source-db as integer no-undo.
       76   define   shared variable g#esys-source-esys as integer no-undo.
       77   define   shared variable g#db-num as integer   no-undo .
       78   define   shared variable g#userid as character no-undo .
       79   define   shared variable g#passwd as character no-undo .
       80   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       81   procedure cur-time :
       82      define output parameter p-today as date      no-undo .
       83      define output parameter p-time  as integer   no-undo .
       84     do
       85     on error undo, return error
       86     :
       87       define variable v-date1 as date      no-undo .
       88       define variable v-date2 as date      no-undo .
       89       define variable v-time  as integer   no-undo .
       90       assign
       91         v-date1 = today
       92         v-time  = time
       93         v-date2 = today
       94       .
       95       if v-date1 <> v-date2
       96       then do:
       97         assign
       98           v-date1 = today
       99           v-time  = v-time
      100         .
      101       end.
      102       assign
      103         p-today = v-date1
      104         p-time  = v-time
      105       .
      106     end.
      107   end.
      108   function cur-time-date returns character
      109   :
      110     return string(today, '99/99/9999':U) .
      111   end.
      112   function cur-time-mjd returns decimal
      113   :
      114     define variable v-date as date      no-undo .
      115     define variable v-time as integer   no-undo .
      116     run cur-time in this-procedure
      117       (output v-date
      118       ,output v-time
      119       ) .
      120     return integer(v-date) - 2400002 + (v-time / 86400) .
      121   end.
      122   function cur-time-get-ending-index returns integer
      123   (input p-number as integer
      124   )
      125   :
      126     if p-number < 0
      127     or p-number = ?
      128     then do:
      129       return 1 .
      130     end.
      131     define variable v-rest as integer   no-undo .
      132     assign
      133       p-number = p-number modulo 100
      134     .
      135     if p-number < 20
      136     then do:
      137       assign
      138         v-rest = p-number
      139       .
      140     end.
      141     else do:
      142       assign
      143         v-rest = p-number modulo 10
      144       .
      145     end.
      146     case v-rest :
      147       when 1
      148       then do:
      149         return 2 .
      150       end.
      151       when 2 or
      152       when 3 or
      153       when 4
      154       then do:
      155         return 3 .
      156       end.
      157       otherwise do:
      158         return 1 .
      159       end.
      160     end case .
      161   end.
      162   procedure cur-time-mjd-to-date :
      163      define input  parameter i-mjd-diff as decimal no-undo.
      164      define output parameter o-Date     as date    no-undo.
      165      define output parameter o-Time     as integer no-undo.
      166      define variable v-day-number as integer   no-undo .
      167      if    i-mjd-diff < 0
      168         or i-mjd-diff = ?
      169      then do:
      170         return "?" .
      171      end.
      172      assign
      173         v-day-number = truncate(i-mjd-diff,0).
      174         o-Date = date(v-day-number + 2400002).
      175         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      176     .
      177   end.
      178   function cur-time-mjd-to-string returns character
      179   (input p-mjd-diff as decimal
      180   )
      181   :
      182     define variable v-day-number as integer   no-undo .
      183     define variable v-seconds    as integer   no-undo .
      184     define variable v-hour       as integer   no-undo .
      185     define variable v-min        as integer   no-undo .
      186     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      187     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      188     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      189     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      190     if p-mjd-diff < 0
      191     or p-mjd-diff = ?
      192     then do:
      193       return "?" .
      194     end.
      195     assign
      196       v-day-number = integer(truncate(p-mjd-diff,0))
      197       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      198     .
      199     if v-seconds > 86400
      200     then do:
      201       assign
      202         v-seconds = 86400 - 1
      203       .
      204     end.
      205     if v-seconds < 0
      206     then do:
      207       assign
      208         v-seconds = 0
      209       .
      210     end.
      211     assign
      212       v-hour = truncate(v-seconds / 3600, 0)
      213     .
      214     assign
      215       v-seconds = v-seconds modulo 3600
      216     .
      217     assign
      218       v-min = truncate(v-seconds / 60, 0)
      219     .
      220     assign
      221       v-seconds = v-seconds modulo 60
      222     .
      223     return
      224         (if v-day-number <> 0
      225           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      226           else ""
      227         )
      228       + (if v-day-number <> 0 or v-hour <> 0
      229           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      230           else ""
      231         )
      232       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      233           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      234           else ""
      235         )
      236       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      237       .
      238   end.
      239   function cur-time-string returns character
      240   :
      241     define variable v-date as date      no-undo .
      242     define variable v-time as integer   no-undo .
      243     run cur-time in this-procedure
      244       (output v-date
      245       ,output v-time
      246       ) .
      247     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      248   end.
      249   function cur-time-string-sec returns character
      250   :
      251     define variable v-date as date      no-undo .
      252     define variable v-time as integer   no-undo .
      253     run cur-time in this-procedure
      254       (output v-date
      255       ,output v-time
      256       ) .
      257     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      258   end.
      259   function cur-time-custom  returns character
      260   (input p-prefix as character
      261   ,input p-date-format as character
      262   ,input p-delimiter as character
      263   ,input p-time-format as character
      264   ,input p-suffix as character
      265   )
      266   :
      267     define variable v-date as date      no-undo .
      268     define variable v-time as integer   no-undo .
      269     run cur-time in this-procedure
      270       (output v-date
      271       ,output v-time
      272       ) .
      273     return
      274       p-prefix
      275       + string(v-date, p-date-format)
      276       + p-delimiter
      277       + string(v-time, p-time-format)
      278       + p-suffix
      279       .
      280   end.
      281   function cur-time-print  returns character
      282   :
      283     define variable v-date as date      no-undo .
      284     define variable v-time as integer   no-undo .
      285     run cur-time in this-procedure
      286       (output v-date
      287       ,output v-time
      288       ) .
      289     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      290   end.
      291   function cur-time-datetime returns datetime
      292   :
      293     define variable v-char as character no-undo .
      294     define variable v-datetime as datetime no-undo .
      295     v-char = cur-time-string().
      296     v-datetime = datetime(v-char).
      297     return  v-datetime.
      298   end.
      299   function cur-time-string-msec returns character
      300   :
      301     define variable v-date as datetime  no-undo .
      302     v-date = now.
      303     return string(v-date) .
      304   end.
      305   DEFINE VARIABLE glog as logical no-undo .
      306   DEFINE BUFFER buf_rule for ub.rule.
      307   DEFINE VARIABLE choice as logical no-undo .
      308   DEFINE VARIABLE varold-sts like ub.rule.sts no-undo .
      309   define variable v-mess as character no-undo .
      310   define variable v-check-used as logical no-undo .
      311   if lookup(string(p-sts), '-1':U + chr(44) +
      312                            '-10':U + chr(44) +
      313                            '98':U) = 0 then do:
      314      message
      315      vss-workfile vss-revision vss-description skip
      316      "Неверное значение параметра p-sts="
      317      view-as alert-box error .
      318      undo, return error .
      319   end.
      320   main-block:
      321   do
      322   on error undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      323   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      324   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      325   :
      326     FIND FIRST buf_rule exclusive-lock WHERE
      327               recid(buf_rule) = par-recid No-ERROR.
      328     if not avail buf_rule then return error.
      329     if buf_rule.sts = integer('99':U)
      330     or buf_rule.sts = integer('98':U)
      331     or buf_rule.sts = integer('0':U)
      332     then do:
      333       v-mess = substitute("Нельзя изменять статус правила в статусе &1", entry (lookup (string(buf_rule.sts), '-1,-10,0,1,99,98':U), 'готов,нов,исп,удал,удаление,запр.удал':U)).
      334       run err-mess in this-procedure ( input-output v-mess).
      335       undo main-block, return error (if p-silent then v-mess else '':U).
      336     end.
      337     varold-sts = buf_rule.sts.
      338     CASE p-sts:
      339       WHEN integer('-1':U) then do:
      340         case buf_rule.sts:
      341           when integer('-1':U) then do:
      342             v-mess = substitute("Правило уже имеет статус &1!", entry (lookup (string(p-sts), '-1,-10,0,1,99,98':U), 'готов,нов,исп,удал,удаление,запр.удал':U)).
      343             run err-mess in this-procedure ( input-output v-mess).
      344             undo main-block, return error (if p-silent then v-mess else '':U).
      345           end.
      346           when integer('1':U) then do:
      347             if p-silent = no then do:
      348                message
      349                substitute("Правило имеет статус &1&2" +
      350                           "Вы хотите вновь начать использовать его?"
      351                           , entry (lookup (string(buf_rule.sts), '-1,-10,0,1,99,98':U), 'готов,нов,исп,удал,удаление,запр.удал':U)
      352                           , chr(10)
      353                           )
      354                view-as alert-box question buttons yes-no update glog.
      355                if not glog then return.
      356             end.
      357           end.
      358           when integer('-10':U) then do:
      359             if p-silent = no then do:
      360                message
      361                substitute("Правило имеет статус &1&2" +
      362                           "Вы хотите закончить его редактирование и начать использовать его?"
      363                           , entry (lookup (string(buf_rule.sts), '-1,-10,0,1,99,98':U), 'готов,нов,исп,удал,удаление,запр.удал':U)
      364                           , chr(10)
      365                           )
      366                view-as alert-box question buttons yes-no update glog.
      367                if not glog then return.
      368             end.
      369           end.
      370         end case.
      371       end.
      372       WHEN integer('-10':U) then do:
      373         case buf_rule.sts:
      374           when integer('-10':U) then do:
      375             v-mess = substitute("Правило уже имеет статус &1!", entry (lookup (string(p-sts), '-1,-10,0,1,99,98':U), 'готов,нов,исп,удал,удаление,запр.удал':U)).
      376             run err-mess in this-procedure ( input-output v-mess).
      377             undo main-block, return error (if p-silent then v-mess else '':U).
      378           end.
      379           when integer('1':U) then do:
      380             if p-silent = no then do:
      381                message
      382                substitute("Правило имеет статус &1&2" +
      383                           "Вы хотите начать его редактирование?"
      384                           , entry (lookup (string(buf_rule.sts), '-1,-10,0,1,99,98':U), 'готов,нов,исп,удал,удаление,запр.удал':U)
      385                           , chr(10)
      386                           )
      387                view-as alert-box question buttons yes-no update glog.
      388                if not glog then return.
      389             end.
      390           end.
      391           when integer('-1':U) then do:
      392             if p-silent = no then do:
      393                message
      394                substitute("Правило имеет статус &1&2" +
      395                           "Вы хотите снова начать его редактирование?"
      396                           , entry (lookup (string(buf_rule.sts), '-1,-10,0,1,99,98':U), 'готов,нов,исп,удал,удаление,запр.удал':U)
      397                           , chr(10)
      398                           )
      399                view-as alert-box question buttons yes-no update glog.
      400                if not glog then return.
      401             end.
      402             v-check-used = yes.
      403           end.
      404         end case.
      405       end.
      406       WHEN integer('1':U) then do:
      407         case buf_rule.sts:
      408           when integer('1':U) then do:
      409             v-mess = substitute("Правило уже имеет статус &1!", entry (lookup (string(p-sts), '-1,-10,0,1,99,98':U), 'готов,нов,исп,удал,удаление,запр.удал':U)).
      410             run err-mess in this-procedure ( input-output v-mess).
      411             undo main-block, return error (if p-silent then v-mess else '':U).
      412           end.
      413           when integer('-10':U) then do:
      414             if p-silent = no then do:
      415                message
      416                substitute("Правило имеет статус &1,не используется и может быть ОКОНЧАТЕЛЬНО удалено из системы" +
      417                           "Вы все равно хотите пометить его как удаленное?"
      418                           , entry (lookup (string(buf_rule.sts), '-1,-10,0,1,99,98':U), 'готов,нов,исп,удал,удаление,запр.удал':U)
      419                           , chr(10)
      420                           )
      421                view-as alert-box question buttons yes-no update glog.
      422                if not glog then return.
      423             end.
      424           end.
      425           when integer('-1':U) then do:
      426             if p-silent = no then do:
      427                message
      428                substitute("Правило имеет статус &1 и может использоваться &2" +
      429                           "Вы хотите пометить его как удаленное&2" +
      430                           "(Предварительно будет проведено проверка того, что правило НЕ ИСПОЛЬЗУЕТСЯ)&2?"
      431                           , entry (lookup (string(buf_rule.sts), '-1,-10,0,1,99,98':U), 'готов,нов,исп,удал,удаление,запр.удал':U)
      432                           , chr(10)
      433                           )
      434                view-as alert-box question buttons yes-no update glog.
      435                if not glog then return.
      436             end.
      437             v-check-used = yes.
      438           end.
      439         end case.
      440       end.
      441     END CASE.
      442     if v-check-used then do:
      443       define variable v-ok as logical no-undo .
      444       run trg/rule-chk.p ( input 'удаление':U
      445                           ,input buf_rule.rule_id
      446                           ,output v-ok
      447                           ,output v-mess
      448                           ) no-error.
      449       if error-status:error
      450       or not v-ok then do:
      451         v-mess = substitute("Правило используется").
      452         run err-mess in this-procedure ( input-output v-mess).
      453         undo main-block, return error (if p-silent then v-mess else '':U).
      454       end.
      455     end.
      456     assign
      457     buf_rule.sts = p-sts.
      458   end.
      459   PROCEDURE err-mess:
      460     DEFINE INPUT-output PARAMETER p-mess as character No-UNDO.
      461     CASE p-silent:
      462       when yes then do:
      463         p-mess =  substitute("Правило №&1&2&3"
      464                              , p-mess).
      465       end.
      466       otherwise do:
      467         message
      468         p-mess
      469         view-as alert-box error .
      470       end.
      471     end.
      472   END PROCEDURE.
