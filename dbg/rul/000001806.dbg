      454   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      455   define new global shared variable g#lib-nws as handle no-undo .
      456   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      457   def var vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      458   procedure gen-key-rec :
      459     define input  parameter p-tbl-name    as character no-undo.
      460     define input  parameter p-bh_tbl-name as handle    no-undo.
      461     define output parameter p-key-rec     as character no-undo.
      462     do
      463     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      464     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      465     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      466     :
      467       define variable fh               as handle    no-undo .
      468       define variable v-ok             as logical   no-undo .
      469       define variable v-inform         as character no-undo .
      470       define variable v-ind            as integer   no-undo .
      471       define variable v-idx-field-qnty as integer   no-undo .
      472       if p-tbl-name = ?
      473         or p-tbl-name = "":U
      474       then do:
      475         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info8 ).
      476       end.
      477       if not p-bh_tbl-name:available then do:
      478         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info8, p-tbl-name ).
      479       end.
      480       assign
      481         p-key-rec = p-tbl-name
      482         v-inform  = p-bh_tbl-name:index-information(1)
      483         v-ind     = 2
      484       .
      485       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      486       on error undo, return error
      487       :
      488         assign
      489           v-inform = p-bh_tbl-name:index-information( v-ind )
      490           v-ind    = v-ind + 1
      491         .
      492       end.
      493       if v-inform = ?
      494         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      495         or entry( 3, v-inform, ",":U ) <> "1":U
      496       then do:
      497         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info8, p-tbl-name ).
      498       end.
      499       else do:
      500         assign
      501           v-idx-field-qnty = num-entries( v-inform ) - 4
      502         .
      503         if v-idx-field-qnty < 2 then do:
      504           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info8, v-inform, p-tbl-name ).
      505         end.
      506         do v-ind = 1 to v-idx-field-qnty by 2
      507         on error undo, return error
      508         :
      509           assign
      510             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      511             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      512           .
      513         end.
      514       end.
      515       if p-key-rec = ? then do:
      516         assign
      517           p-key-rec = "":U
      518         .
      519         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info8, p-tbl-name ).
      520       end.
      521     end.
      522     return.
      523   end procedure.
      524   procedure gen-where-keyr-tab :
      525     define input  parameter i-tableSerach as character no-undo.
      526     define input  parameter i-tablekey   as character  no-undo.
      527     define input  parameter p-key-rec    as character  no-undo.
      528     define input  parameter p-key-handle as handle     no-undo .
      529     define input  parameter p-db-name    as character  no-undo .
      530     define input  parameter p-tt-handle  as handle     no-undo .
      531     define output parameter o-Where      as character  no-undo.
      532     do
      533     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      534     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      535     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      536     :
      537       define variable v-full-tbl-name  as character no-undo .
      538       define variable bh_tbl-name      as handle    no-undo .
      539       define variable fh_key           as handle    no-undo .
      540       define variable fh_search        as handle    no-undo .
      541       define variable v-field-num      as integer   no-undo .
      542       define variable v-count-fld      as integer   no-undo .
      543       define variable v-inform         as character no-undo .
      544       define variable v-ind            as integer   no-undo .
      545       define variable v-idx-field-qnty as integer   no-undo .
      546       define variable v-field-name     as character no-undo .
      547       define variable v-field-val      as character no-undo .
      548       define variable v-word-link      as character no-undo .
      549       define variable vTable           as character no-undo.
      550       define variable bh_tbl-key       as handle    no-undo .
      551       assign
      552         p-key-rec = trim( p-key-rec )
      553       .
      554       if p-key-handle <> ? then do:
      555         if not valid-handle(p-key-handle)
      556            or p-key-handle:type <> "buffer"
      557         then do:
      558           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info8 ).
      559         end.
      560         if num-entries( p-key-rec, chr(3) ) > 1
      561           or p-key-rec = ?
      562           or p-key-rec = "":U
      563         then do:
      564           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info8, p-key-rec ).
      565         end.
      566       end.
      567       else do:
      568         if p-key-rec = ?
      569           or p-key-rec = "":U
      570         then do:
      571           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info8 ).
      572         end.
      573       end.
      574       assign
      575         vTable = entry( 1 , p-key-rec, chr(3) )
      576       .
      577       if p-tt-handle <> ?
      578         and ( not valid-handle(p-tt-handle)
      579               or p-tt-handle:type <> "buffer"
      580             )
      581       then do:
      582         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info8, vTable, chr(10) ).
      583       end.
      584       if p-tt-handle = ? then do:
      585         assign
      586           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      587         .
      588         create buffer bh_tbl-name for table v-full-tbl-name .
      589       end.
      590       else do:
      591         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      592       end.
      593       assign
      594         v-inform = bh_tbl-name:index-information(1)
      595         v-ind    = 2
      596       .
      597       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      598       on error undo, return error
      599       :
      600         assign
      601           v-inform = bh_tbl-name:index-information( v-ind )
      602           v-ind    = v-ind + 1
      603         .
      604       end.
      605       if v-inform = ?
      606         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      607         or entry( 3, v-inform, ",":U ) <> "1":U
      608       then do:
      609         delete object bh_tbl-name no-error.
      610         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info8, vTable ).
      611       end.
      612       assign
      613         v-idx-field-qnty = num-entries( v-inform ) - 4
      614       .
      615       if v-idx-field-qnty < 2 then do:
      616         delete object bh_tbl-name no-error.
      617         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info8, v-inform, vTable ).
      618       end.
      619       assign
      620         o-where     = "where":U
      621         v-word-link = "":U
      622         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      623         v-count-fld = 0
      624       .
      625       if i-tablekey ne "" and i-tablekey ne ?
      626       then do:
      627         assign
      628           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      629         .
      630         create buffer bh_tbl-key for table v-full-tbl-name .
      631       end.
      632       if i-tableSerach ne "" and i-tableSerach ne ?
      633       then do:
      634         delete object bh_tbl-name no-error.
      635         assign
      636           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      637         .
      638         create buffer bh_tbl-name for table v-full-tbl-name .
      639       end.
      640       block_where:
      641       do v-ind = 1 to v-idx-field-qnty by 2
      642       on error undo, return error
      643       :
      644         assign
      645           v-count-fld = v-count-fld + 1
      646         .
      647         if p-key-handle = ?
      648           and v-count-fld > v-field-num
      649         then do:
      650           leave block_where.
      651         end.
      652         define variable VfieldKeyTable as handle no-undo.
      653         assign
      654           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      655           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      656         .
      657         if     bh_tbl-key ne ?
      658         then do:
      659            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      660            if VfieldKeyTable eq ?
      661            then next block_where.
      662         end.
      663         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      664         then
      665            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      666         else
      667            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      668         if p-key-handle = ? then do:
      669           assign
      670             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      671           .
      672         end.
      673         else do:
      674           assign
      675             fh_key = p-key-handle:buffer-field( v-field-name )
      676           .
      677           if fh_key = ?
      678             or not valid-handle( fh_key )
      679           then do:
      680             delete object bh_tbl-name.
      681             if     bh_tbl-key ne ?
      682             then
      683                delete object bh_tbl-key.
      684             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info8, p-key-handle:name, v-field-name ).
      685           end.
      686           assign
      687             v-field-val = fh_key:buffer-value
      688           .
      689         end.
      690         if fh_search:data-type ="character":U then do:
      691           assign
      692             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      693             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      694             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      695             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      696             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      697             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      698             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      699             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      700             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      701             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      702             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      703             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      704             v-field-val = substitute( '"&1"', v-field-val )
      705           .
      706         end.
      707         assign
      708           o-where = substitute( "&1 &2", o-where, v-field-val )
      709         .
      710         if v-word-link = "":U then do:
      711           assign
      712             v-word-link = "and":U
      713           .
      714         end.
      715       end.
      716       delete object bh_tbl-name.
      717       if     bh_tbl-key ne ?
      718       then
      719          delete object bh_tbl-key.
      720       if p-key-handle = ?
      721         and v-count-fld <> v-field-num
      722       then do:
      723         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info8, vTable ).
      724       end.
      725     end.
      726   end procedure.
      727   procedure gen-hn-keyr-tab :
      728     define input  parameter i-tableSerach as character no-undo.
      729     define input  parameter i-tablekey   as character no-undo.
      730     define input  parameter p-key-rec    as character no-undo.
      731     define input  parameter p-key-handle as handle    no-undo .
      732     define input  parameter p-db-name    as character no-undo .
      733     define input  parameter p-tt-handle  as handle    no-undo .
      734     define input  parameter p-stts-lock  as integer   no-undo .
      735     define output parameter o-hn         as handle    no-undo.
      736     define variable v-full-tbl-name as character no-undo.
      737     define variable v-where         as character no-undo.
      738     define variable bh_tbl-name     as handle    no-undo.
      739     define variable vTable          as character no-undo.
      740     do
      741     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      742     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      743     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      744         run gen-where-keyr-tab(i-tableSerach,
      745                                i-tablekey,
      746                                p-key-rec,
      747                                p-key-handle,
      748                                p-db-name,
      749                                p-tt-handle,
      750                                output v-where).
      751         if i-tableSerach ne "" and i-tableSerach ne ?
      752         then do:
      753            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      754            create buffer bh_tbl-name for table v-full-tbl-name .
      755         end.
      756         else do:
      757            if p-tt-handle = ? then do:
      758               assign
      759                  vTable = entry( 1 , p-key-rec, chr(3) )
      760               .
      761               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      762               create buffer bh_tbl-name for table v-full-tbl-name .
      763            end.
      764            else do:
      765               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      766            end.
      767         end.
      768         if p-tt-handle = ? then do:
      769            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      770         end.
      771         else do:
      772            bh_tbl-name:find-first( v-where ) no-error .
      773         end.
      774         o-hn = bh_tbl-name.
      775      end.
      776   end procedure.
      777   procedure gen-hn-keyr :
      778     define input  parameter p-key-rec    as character no-undo.
      779     define input  parameter p-key-handle as handle    no-undo .
      780     define input  parameter p-db-name    as character no-undo .
      781     define input  parameter p-tt-handle  as handle    no-undo .
      782     define input  parameter p-stts-lock  as integer   no-undo .
      783     define output parameter o-hn         as handle    no-undo.
      784     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      785   end.
      786   procedure gen-row-keyr :
      787     define input  parameter p-key-rec    as character no-undo.
      788     define input  parameter p-key-handle as handle    no-undo .
      789     define input  parameter p-db-name    as character no-undo .
      790     define input  parameter p-tt-handle  as handle    no-undo .
      791     define input  parameter p-stts-lock  as integer   no-undo .
      792     define output parameter p-tbl-row    as rowid     no-undo.
      793     define output parameter p-tbl-name   as character no-undo.
      794     define variable vHn as handle no-undo.
      795       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      796       p-tbl-row = if vHn:available then vHn:rowid else ?.
      797       p-tbl-name =  vHn:table.
      798       delete object vHn no-error.
      799     if p-tbl-row = ? then do:
      800       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info8, p-tbl-name, p-key-rec ).
      801     end.
      802     else do:
      803       return.
      804     end.
      805   end procedure.
      806   procedure gen-key-fv :
      807     define input  parameter p-key-rec    as character no-undo .
      808     define output parameter p-field-list as character no-undo .
      809     define output parameter p-value-list as character no-undo.
      810     do
      811     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      812     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      813     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      814     :
      815       define variable v-full-tbl-name  as character no-undo .
      816       define variable bh_tbl-name      as handle    no-undo .
      817       define variable v-tbl-name       as character no-undo .
      818       define variable v-field-num      as integer   no-undo .
      819       define variable v-count-fld      as integer   no-undo .
      820       define variable v-inform         as character no-undo .
      821       define variable v-ind            as integer   no-undo .
      822       define variable v-idx-field-qnty as integer   no-undo .
      823       define variable v-delim-key      as character no-undo .
      824       if p-key-rec = ?
      825         or p-key-rec = "":U
      826       then do:
      827         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info8 ).
      828       end.
      829       assign
      830         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      831         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      832       .
      833       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      834       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info8 ).
      835       assign
      836         v-inform = bh_tbl-name:index-information(1)
      837         v-ind    = 2
      838       .
      839       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      840       on error undo, return error
      841       :
      842         assign
      843           v-inform = bh_tbl-name:index-information( v-ind )
      844           v-ind    = v-ind + 1
      845         .
      846       end.
      847       if v-inform = ?
      848         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      849         or entry( 3, v-inform, ",":U ) <> "1":U
      850       then do:
      851         delete object bh_tbl-name no-error.
      852         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info8, v-tbl-name ).
      853       end.
      854       assign
      855         v-idx-field-qnty = num-entries( v-inform ) - 4
      856       .
      857       if v-idx-field-qnty < 2 then do:
      858         delete object bh_tbl-name no-error.
      859         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info8, v-inform, v-tbl-name ).
      860       end.
      861       assign
      862         p-field-list = "":U
      863         p-value-list = "":U
      864         v-delim-key  = "":U
      865         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      866         v-count-fld  = 0
      867       .
      868       block_where:
      869       do v-ind = 1 to v-idx-field-qnty by 2
      870       on error undo, return error
      871       :
      872         assign
      873           v-count-fld = v-count-fld + 1
      874         .
      875         if v-count-fld > v-field-num then do:
      876           leave block_where.
      877         end.
      878         assign
      879           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      880           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      881         .
      882         if v-ind = 1 then do:
      883           assign
      884             v-delim-key = chr(3)
      885           .
      886         end.
      887       end.
      888       delete object bh_tbl-name.
      889       if v-count-fld <> v-field-num then do:
      890         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info8, v-tbl-name ).
      891       end.
      892     end.
      893   end procedure.
      894   procedure gen-key-field :
      895     define input  parameter p-table      as character no-undo .
      896     define output parameter p-field-list as character no-undo .
      897     do
      898     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      899     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      900     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      901     :
      902       define variable v-full-tbl-name  as character no-undo .
      903       define variable bh_tbl-name      as handle    no-undo .
      904       define variable v-tbl-name       as character no-undo .
      905       define variable v-field-num      as integer   no-undo .
      906       define variable v-count-fld      as integer   no-undo .
      907       define variable v-inform         as character no-undo .
      908       define variable v-ind            as integer   no-undo .
      909       define variable v-idx-field-qnty as integer   no-undo .
      910       define variable v-delim-key      as character no-undo .
      911       if p-table = ?
      912         or p-table = "":U
      913       then do:
      914         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info8 ).
      915       end.
      916       assign
      917         v-tbl-name      = p-table
      918         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      919       .
      920       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      921       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info8 ).
      922       assign
      923         v-inform = bh_tbl-name:index-information(1)
      924         v-ind    = 2
      925       .
      926       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      927       on error undo, return error
      928       :
      929         assign
      930           v-inform = bh_tbl-name:index-information( v-ind )
      931           v-ind    = v-ind + 1
      932         .
      933       end.
      934       if v-inform = ?
      935         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      936         or entry( 3, v-inform, ",":U ) <> "1":U
      937       then do:
      938         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info8, v-tbl-name ).
      939       end.
      940       assign
      941         v-idx-field-qnty = num-entries( v-inform ) - 4
      942       .
      943       if v-idx-field-qnty < 2 then do:
      944         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info8, v-inform, v-tbl-name ).
      945       end.
      946       assign
      947         p-field-list = "":U
      948         v-delim-key  = "":U
      949         v-count-fld  = 0
      950       .
      951       block_where:
      952       do v-ind = 1 to v-idx-field-qnty by 2
      953       on error undo, return error
      954       :
      955         assign
      956           v-count-fld = v-count-fld + 1
      957         .
      958         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      959         if v-ind = 1 then do:
      960           assign
      961             v-delim-key = chr(3)
      962           .
      963         end.
      964       end.
      965       delete object bh_tbl-name.
      966     end.
      967   end procedure.
      968   define SHARED temp-table temp-cmd no-undo
      969   field cmd-code as integer
      970   field db-list as character
      971   index pi is unique primary
      972   db-list
      973   index icmd
      974   cmd-code
      975   .
      976   define SHARED temp-table temp-smart-route no-undo
      977   field key-field as character
      978   field db-num as integer
      979   index pi is unique primary
      980   key-field
      981   db-num
      982   .
      983   define SHARED temp-table temp-no-route no-undo
      984   field rec-ord as integer
      985   field db-num as integer
      986   index pi is unique primary
      987   db-num
      988   rec-ord
      989   index iro
      990   rec-ord
      991   .
      992   define SHARED temp-table temp-smart-link no-undo
      993   field uniq-key-rec as character
      994   field key-field as character
      995   field rec-ord as integer
      996   field is-smart as logical
      997   index pi is unique primary
      998   key-field
      999   uniq-key-rec
     1000   rec-ord
     1001   index iu
     1002   uniq-key-rec
     1003   index iro
     1004   rec-ord
     1005   .
     1006   define SHARED temp-table temp-nws-outline no-undo
     1007   like ub.nws-outline.
     1008   procedure create-smart-route :
     1009   define input parameter p-key-field as character no-undo .
     1010   define input parameter p-db-num as integer no-undo .
     1011   define buffer buf_temp-smart-route for temp-smart-route.
     1012     do
     1013     on error undo, return error
     1014     :
     1015       find first buf_temp-smart-route where
     1016                 buf_temp-smart-route.key-field = p-key-field
     1017             and buf_temp-smart-route.db-num = p-db-num no-error.
     1018       if not available buf_temp-smart-route then do:
     1019         create buf_temp-smart-route.
     1020         assign
     1021         buf_temp-smart-route.key-field = p-key-field
     1022         buf_temp-smart-route.db-num = p-db-num
     1023         .
     1024       end.
     1025     end.
     1026   end procedure.
     1027   procedure create-smart-route-link :
