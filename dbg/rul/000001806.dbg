     1057   procedure create-nws-outline :
     1058   define input parameter p-cmd-proc-handle as handle no-undo .
     1059   define input parameter p-cmd-code as integer no-undo .
     1060   define input parameter p-outline-type as character no-undo .
     1061   define input parameter p-charkey_one as character no-undo .
     1062   define input parameter p-charkey_two as character no-undo .
     1063   define input parameter p-charkey_three as character no-undo .
     1064   define input parameter p-key#_one as integer no-undo .
     1065   define input parameter p-key#_two as integer no-undo .
     1066   define input parameter p-key#_three as integer no-undo .
     1067   define variable v-no-id as integer no-undo .
     1068   define variable v-rec-ord as integer no-undo .
     1069     do
     1070     on error undo, return error return-value
     1071     :
     1072       find last temp-nws-outline use-index pi no-error .
     1073       v-no-id = (if available temp-nws-outline
     1074                  then (temp-nws-outline.no-id  + 1)
     1075                  else 1).
     1076       create temp-nws-outline.
     1077       assign
     1078       temp-nws-outline.charkeY_one = p-charkey_one
     1079       temp-nws-outline.charkeY_two = p-charkey_two
     1080       temp-nws-outline.charkeY_three = p-charkey_three
     1081       temp-nws-outline.key#_one = p-key#_one
     1082       temp-nws-outline.key#_two = p-key#_two
     1083       temp-nws-outline.key#_three = p-key#_three
     1084       temp-nws-outline.no-id = v-no-id
     1085       temp-nws-outline.outline-type = p-outline-type
     1086       .
     1087                                   run add-dump in p-cmd-proc-handle                                                                           (input p-cmd-code                                                                                         ,input 'nws-outline':U                                                                                          ,input '+update'                                                                                         ,input (buffer temp-nws-outline:handle)                                                                                    ,input ''                                                                                         ,output v-rec-ord                                                                                         ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                     delete procedure p-cmd-proc-handle .                                                                        undo , return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'nws-outline':U                                                                                                ,p-cmd-code                                                                                               ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
     1088       run  create-smart-route in this-procedure (
     1089                                                   input ('nws-outline':U + chr(4) + string(temp-nws-outline.no-id))
     1090                                                  ,input -1).
     1091       run create-smart-route-link in this-procedure (
     1092                                                      input 'nws-outline':U
     1093                                                     ,input (buffer temp-nws-outline:handle)
     1094                                                     ,input ('nws-outline':U + chr(4) + string(temp-nws-outline.no-id))
     1095                                                     ,input v-rec-ord
     1096                                                     ,input no
     1097                                                     ).
     1098     end.
     1099   end procedure.
     1100   procedure create-no-route :
     1101   define input parameter p-rec-ord as integer no-undo .
     1102   define input parameter p-db-num as integer no-undo .
     1103   define buffer buf_temp-no-route for temp-no-route.
