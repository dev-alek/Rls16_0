     1192   procedure get-gate-file-name :
     1193   define input parameter p-gate-rec as character no-undo .
     1194   define output  parameter p-gate-file-name as character no-undo .
     1195   define buffer buf_clob-data for ub.clob-data.
     1196   define variable v-tbl-row as rowid no-undo .
     1197   define variable v-tbl-name as character no-undo .
     1198   run gen-row-keyr in this-procedure ( input p-gate-rec
     1199                                       ,input ?
     1200                                       ,input "ub"
     1201                                       ,input ?
     1202                                       ,input no-lock
     1203                                       ,output v-tbl-row
     1204                                       ,output v-tbl-name) no-error.
     1205   if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     1206                                                           ,vss-include-info12
     1207                                                           ,p-gate-rec).
     1208   find first buf_clob-data no-lock where
     1209             rowid(buf_clob-data) = v-tbl-row no-error.
     1210   if not available buf_clob-data then do:
     1211     if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     1212                                                             ,vss-include-info12
     1213                                                             ,p-gate-rec).
     1214   end.
     1215   p-gate-file-name = buf_clob-data.file-name.
     1216   end procedure.
     1217   procedure get-gate-rec :
     1218   define input  parameter p-gate-name as character no-undo .
     1219   define output parameter p-gate-rec as character no-undo .
     1220   define buffer buf_clob-bind for ub.clob-bind.
     1221   define buffer buf_clob-data for ub.clob-data.
     1222   main-block:
     1223   do
     1224   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info12, return-value, chr(10), error-status :get-message (1))
     1225   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info12 )
     1226   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info12 )
     1227   :
     1228       find first buf_clob-bind no-lock where
     1229                 buf_clob-bind.uniq-key-rec = p-gate-name
     1230             and buf_clob-bind.field-name = '':U
     1231             and buf_clob-bind.part-num = 1
     1232             and buf_clob-bind.resource-type = 'gate':U
     1233             no-error.
     1234       if not available buf_clob-bind then do:
     1235         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     1236                                         , p-gate-name
     1237                                         ).
     1238       end.
     1239       find first buf_clob-data no-lock where
     1240                 buf_clob-data.db-num = buf_clob-bind.db-num
     1241             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     1242       if not available buf_clob-data then do:
     1243         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1244                                         , buf_clob-bind.db-num
     1245                                         , buf_clob-bind.int64-id
     1246                                         , p-gate-name
     1247                                         ).
     1248       end.
     1249       run gen-key-rec in this-procedure ( input 'clob-data':U
     1250                                 ,input buffer buf_clob-data:handle
     1251                                 ,output p-gate-rec).
     1252   end.
     1253   end procedure.
     1254   procedure get-gate-by-name :
     1255   define input  parameter p-gate-name as character no-undo .
     1256   define output parameter p-gate-rec as character no-undo .
     1257   define output parameter p-dsh as handle no-undo .
     1258   define input-output  parameter p-xmlh as handle no-undo .
     1259   define variable v-ii as integer   no-undo .
     1260   define variable glog as logical   no-undo .
     1261   define variable v-longchar as longchar no-undo .
     1262   define variable v-txmlh as handle no-undo .
     1263   define variable v-db-num as integer no-undo .
     1264   define variable v-int64-id as int64 no-undo .
     1265   define buffer buf_clob-bind for ub.clob-bind.
     1266   define buffer buf_clob-data for ub.clob-data.
     1267   main-block:
     1268   do
     1269   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info12, return-value, chr(10), error-status :get-message (1))
     1270   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info12 )
     1271   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info12 )
     1272   :
     1273       find first buf_clob-bind no-lock where
     1274                 buf_clob-bind.uniq-key-rec = p-gate-name
     1275             and buf_clob-bind.field-name = '':U
     1276             and buf_clob-bind.part-num = 1
     1277             and buf_clob-bind.resource-type = 'gate':U
     1278             no-error.
     1279       if not available buf_clob-bind then do:
     1280         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     1281                                         , p-gate-name
     1282                                         ).
     1283       end.
     1284       find first buf_clob-data no-lock where
     1285                 buf_clob-data.db-num = buf_clob-bind.db-num
     1286             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     1287       if not available buf_clob-data then do:
     1288         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1289                                         , buf_clob-bind.db-num
     1290                                         , buf_clob-bind.int64-id
     1291                                         , p-gate-name
     1292                                         ).
     1293       end.
     1294       assign
     1295       v-longchar = buf_clob-data.cdata
     1296       .
     1297       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1298       if error-status :error then do:
     1299         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1300       end.
     1301       create dataset p-dsh .
     1302       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1303                                     , v-longchar
     1304                                     , ?
     1305                                     , ?
     1306                                     , ?
     1307                                     ) no-error.
     1308       v-longchar = '':U.
     1309       if error-status :error
     1310       or not glog
     1311       then do:
     1312         undo, return error substitute("Не удалось прочитать XML-схему &1 из БД:&2&3", p-gate-name, chr(10), error-status:get-message(1) ).
     1313       end.
     1314       if not valid-handle(p-xmlh)
     1315       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1316         create temp-table v-txmlh.
     1317         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1318         v-txmlh:temp-table-prepare("temp-xml-tables").
     1319         p-xmlh = v-txmlh:default-buffer-handle.
     1320       end.
     1321       run gen-key-rec in this-procedure ( input 'clob-data':U
     1322                                 ,input buffer buf_clob-data:handle
     1323                                 ,output p-gate-rec).
     1324       do v-ii = 1 to p-dsh:num-buffers:
     1325         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1326         if not p-xmlh:available then do:
     1327           p-xmlh:buffer-create().
     1328           assign
     1329           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1330           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1331           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1332           p-xmlh::gate-handle_ = p-dsh
     1333           p-xmlh::uniq-gate-rec = p-gate-rec
     1334           p-xmlh::gate-name = p-dsh:name
     1335           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1336           .
     1337           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1338             assign
     1339             p-xmlh::order = -3.
     1340           end.
     1341         end.
     1342       end.
     1343   end.
     1344   end procedure.
     1345   procedure get-gate-by-rec :
     1346   define input  parameter p-gate-rec as character no-undo .
     1347   define output parameter p-dsh as handle no-undo .
     1348   define input-output  parameter p-xmlh as handle no-undo .
     1349   define input-output parameter p-longchar  as longchar no-undo .
     1350   define variable v-ii as integer   no-undo .
     1351   define variable glog as logical   no-undo .
     1352   define variable v-rowid as rowid no-undo .
     1353   define variable v-tbl-name as character no-undo .
     1354   define variable v-longchar as longchar no-undo .
     1355   define variable v-txmlh as handle no-undo .
     1356   define buffer buf_clob-data for ub.clob-data.
     1357   main-block:
     1358   do
     1359   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info12, return-value, chr(10), error-status :get-message (1))
     1360   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info12 )
     1361   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info12 )
     1362   :
     1363     run gen-row-keyr in this-procedure (
     1364                                           input  p-gate-rec
     1365                                           ,input  ?
     1366                                           ,input  "ub"
     1367                                           ,input  ?
     1368                                           ,input  NO-LOCK
     1369                                           ,output v-rowid
     1370                                           ,output v-tbl-name   ) no-error.
     1371       find first buf_clob-data no-lock where
     1372                 rowid(buf_clob-data) = v-rowid  no-error.
     1373       if not available buf_clob-data then do:
     1374         undo, return error substitute("Не найден CLOB  &1"
     1375                                         , p-gate-rec
     1376                                         ).
     1377       end.
     1378       assign
     1379       v-longchar = buf_clob-data.cdata
     1380       .
     1381       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1382       if error-status :error then do:
     1383         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1384       end.
     1385       create dataset p-dsh .
     1386       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1387                                     , v-longchar
     1388                                     , ?
     1389                                     , ?
     1390                                     , ?
     1391                                     ) no-error.
     1392       define variable v-esm as character no-undo .
     1393       v-esm = error-status:get-message(1) .
     1394       if p-longchar <> ? then do:
     1395         p-longchar = v-longchar.
     1396       end.
     1397       v-longchar = '':U.
     1398       if error-status :error
     1399       or not glog
     1400       then do:
     1401         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     1402                                      , p-gate-rec
     1403                                      , p-gate-rec
     1404                                      , v-esm
     1405                                      ).
     1406       end.
     1407       p-dsh:private-data = buf_clob-data.file-name_ + chr(4) + p-gate-rec.
     1408       if not valid-handle(p-xmlh)
     1409       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1410         create temp-table v-txmlh.
     1411         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1412         v-txmlh:temp-table-prepare("temp-xml-tables").
     1413         p-xmlh = v-txmlh:default-buffer-handle.
     1414       end.
     1415       do v-ii = 1 to p-dsh:num-buffers:
     1416         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1417         if not p-xmlh:available then do:
     1418           p-xmlh:buffer-create().
     1419           assign
     1420           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1421           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1422           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1423           p-xmlh::gate-handle_ = p-dsh
     1424           p-xmlh::uniq-gate-rec = p-gate-rec
     1425           p-xmlh::gate-name = p-dsh:name
     1426           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1427           .
     1428           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1429             assign
     1430             p-xmlh::order = -3.
     1431           end.
     1432           p-xmlh:buffer-release().
     1433         end.
     1434       end.
     1435   end.
     1436   end procedure.
     1437   procedure get-gate-by-file :
     1438   define input  parameter p-schema-file-name as character no-undo .
     1439   define input  parameter p-gate-rec as character no-undo .
     1440   define output parameter p-dsh as handle no-undo .
     1441   define input-output  parameter p-xmlh as handle no-undo .
     1442   define variable v-ii as integer   no-undo .
     1443   define variable glog as logical   no-undo .
     1444   define variable v-rowid as rowid no-undo .
     1445   define variable v-tbl-name as character no-undo .
     1446   define variable v-longchar as longchar no-undo .
     1447   define variable v-txmlh as handle no-undo .
     1448   main-block:
     1449   do
     1450   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info12, return-value, chr(10), error-status :get-message (1))
     1451   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info12 )
     1452   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info12 )
     1453   :
     1454       COPY-LOB
     1455       FROM  FILE p-schema-file-name
     1456       TO  OBJECT v-longchar
     1457       no-convert
     1458       NO-ERROR .
     1459       if error-status :error then do:
     1460           undo, return error substitute("Не удалось считать файл схемы &1 в память&2&3"
     1461                                     , p-schema-file-name
     1462                                 , chr(10)
     1463                                 , error-status:get-message(1) ).
     1464       end.
     1465       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1466       if error-status :error then do:
     1467         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, p-schema-file-name, chr(10), error-status:get-message(1) , return-value ).
     1468       end.
     1469       create dataset p-dsh .
     1470       glog = p-dsh:READ-XMLSCHEMA( "longchar"
     1471                                     , v-longchar
     1472                                     , ?
     1473                                     , ?
     1474                                     , ?
     1475                                     ) no-error.
     1476       v-longchar = ''.
     1477       if error-status :error
     1478       or not glog
     1479       then do:
     1480         undo, return error substitute("Не удалось прочитать XML-схему из файла &1&2&3"
     1481                                      , p-schema-file-name
     1482                                      ,chr(10)
     1483                                      , error-status:get-message(1)
     1484                                      ).
     1485       end.
     1486       if not valid-handle(p-xmlh)
     1487       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1488         create temp-table v-txmlh.
     1489         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1490         v-txmlh:temp-table-prepare("temp-xml-tables").
     1491         p-xmlh = v-txmlh:default-buffer-handle.
     1492       end.
     1493       do v-ii = 1 to p-dsh:num-buffers:
     1494         p-xmlh:find-first(substitute(' where tbl-name = "&1" and  uniq-gate-rec = "&2" '
     1495                                      ,p-dsh:get-buffer-handle(v-ii):name
     1496                                      ,p-gate-rec
     1497                                      )) no-error.
     1498         if not p-xmlh:available then do:
     1499           p-xmlh:buffer-create().
     1500           assign
     1501           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):table
     1502           p-xmlh::uniq-gate-rec = p-gate-rec
     1503           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1504           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1505           p-xmlh::gate-handle_ = p-dsh
     1506           p-xmlh::gate-name = p-dsh:name
     1507           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1508           .
     1509           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1510             assign
     1511             p-xmlh::order = -3.
     1512           end.
     1513           p-xmlh:buffer-release().
     1514         end.
     1515       end.
     1516   end.
     1517   end procedure.
     1518   procedure gate-clear :
     1519   define input  parameter p-dsh as handle no-undo .
     1520   define input  parameter p-xmlh as handle no-undo .
     1521   define variable v-dsh as handle no-undo .
     1522   define variable v-th as handle no-undo .
     1523     do
     1524     on error undo, return error return-value
     1525     :
     1526       if valid-handle(p-dsh) then do:
     1527         delete object p-dsh.
     1528         v-dsh = p-dsh.
     1529         p-dsh = ?.
     1530       end.
     1531       repeat while true:
     1532         p-xmlh:find-first( substitute( " where gate-handle_ = &1 ", v-dsh)
     1533                            , share-lock) no-error.
     1534         if p-xmlh:available then do:
     1535           assign
     1536           v-th = p-xmlh:buffer-field("table-handle_"):buffer-value.
     1537           if valid-handle(p-xmlh:buffer-field("table-handle_"))
     1538           and valid-handle(v-th)
     1539           and v-th:dynamic = yes
     1540           then do:
     1541             delete object p-xmlh:buffer-field("table-handle_"):buffer-value.
     1542             p-xmlh:buffer-field("table-handle_"):buffer-value = ?.
     1543           end.
     1544           p-xmlh:buffer-delete().
     1545         end.
     1546         else do:
     1547           leave.
     1548         end.
     1549       end.
     1550       if p-xmlh:dynamic = yes
     1551       and valid-handle(p-xmlh)
     1552       then do:
     1553         delete object p-xmlh:table-handle.
     1554         p-xmlh = ?.
     1555       end.
     1556       v-dsh = ?.
     1557     end.
     1558   end procedure.
     1559   procedure all-gates-clear :
     1560   define parameter buffer buf_temp-xml-tables for temp-xml-tables.
     1561   do
     1562   on error undo, return error
     1563   :
     1564     for each buf_temp-xml-tables
     1565     break
     1566     by buf_temp-xml-tables.uniq-gate-rec
     1567     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1568     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1569     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1570     :
     1571         if first-of(buf_temp-xml-tables.uniq-gate-rec) then do:
     1572           delete object buf_temp-xml-tables.gate-handle_.
     1573           buf_temp-xml-tables.gate-handle_ = ?.
     1574         end.
     1575         if valid-handle(buf_temp-xml-tables.table-handle_)
     1576         and buf_temp-xml-tables.table-handle_:dynamic = no
     1577         then do:
     1578           delete object buf_temp-xml-tables.table-handle_.
     1579           buf_temp-xml-tables.table-handle_ = ?.
     1580         end.
     1581         delete buf_temp-xml-tables.
     1582     end.
     1583   end.
     1584   end procedure.
     1585   procedure fix-schemalocation :
     1586   define input-output  parameter p-longchar as longchar no-undo .
     1587   DEFINE VARIABLE hdoc AS HANDLE.
     1588   DEFINE VARIABLE hroot AS HANDLE.
     1589   DEFINE VARIABLE hnode-child AS HANDLE.
     1590   DEFINE VARIABLE hnode-attr AS HANDLE.
     1591   define variable v-jj as integer   no-undo .
     1592   define variable ok as logical   no-undo .
     1593   define variable v-path1                    as character                no-undo .
     1594   DEFINE VARIABLE v-full-path1               as character                no-undo .
     1595   DEFINE VARIABLE v-file-name1               as character                no-undo .
     1596   DEFINE VARIABLE v-file-name-no-ext1        as character                no-undo .
     1597   DEFINE VARIABLE v-file-name-ext1           as character                no-undo .
     1598   define variable v-schema-location          as character                no-undo .
     1599   do
     1600   on error undo, return error return-value
     1601   :
     1602     CREATE X-DOCUMENT hdoc.
     1603     CREATE X-noderef hroot.
     1604     CREATE X-noderef hnode-child.
     1605     CREATE X-noderef hnode-attr.
     1606     hdoc:load("longchar", p-longchar, no) no-error.
     1607     iF ERROR-STATUS:GET-MESSAGE(1) <> '' THEN message ERROR-STATUS:GET-MESSAGE(1) view-as alert-box .
     1608     hdoc:get-document-element(hroot).
     1609     _repeat:
     1610     REPEAT v-jj = 1 TO hroot:NUM-CHILDREN:
     1611       ok = hroot:GET-CHILD(hNode-Child, v-jj).
     1612       if not ok then next.
     1613       if hNode-Child:local-name = "include"
     1614       then do:
     1615         ok = hNode-Child:GET-ATTRIBUTE-NODE( hnode-attr, "schemaLocation" ).
     1616           v-schema-location = hnode-attr:node-value.
     1617           run gbl/filename.p (
     1618                           input "exe/" + hnode-attr:node-value
     1619                         ,output v-full-path1
     1620                         ,output v-path1
     1621                         ,output v-file-name1
     1622                         ,output v-file-name-no-ext1
     1623                         ,output v-file-name-ext1
     1624                         ) no-error .
     1625           if error-status :error then do:
     1626             delete object hnode-attr.
     1627             delete object hnode-child.
     1628             delete object hroot.
     1629             delete object hdoc.
     1630             undo, return error substitute("Не удалось определить расположение схемы &1", v-schema-location).
     1631           end.
     1632         ok = hNode-Child:sET-ATTRIBUTE(  "schemaLocation", v-full-path1 ).
     1633         leave  _repeat.
     1634       end.
     1635     END.
     1636     hdoc:save("longchar", p-longchar).
     1637     delete object hnode-attr.
     1638     delete object hnode-child.
     1639     delete object hroot.
     1640     delete object hdoc.
     1641   end.
     1642   end procedure.
     1643   procedure gate-clb_fill-xml-tables :
     1644   define input parameter p-dsh as handle no-undo .
     1645   define input-output parameter p-xmlh as handle no-undo .
     1646   define variable v-ii as integer no-undo .
     1647     do
     1648     on error undo, return error
     1649     :
     1650       do v-ii = 1 to p-dsh:num-buffers:
     1651         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1652         if not p-xmlh:available then do:
     1653           p-xmlh:buffer-create().
     1654           assign
     1655           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1656           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1657           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1658           p-xmlh::gate-handle_ = p-dsh
     1659           p-xmlh::uniq-gate-rec = entry(2, p-dsh:private-data, chr(4))
     1660           p-xmlh::gate-name = p-dsh:name
     1661           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1662           .
     1663           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1664             assign
     1665             p-xmlh::order = -3.
     1666           end.
     1667           p-xmlh:buffer-release().
     1668         end.
     1669       end.
     1670     end.
     1671   end procedure.
     1672   procedure all-gates-empty :
     1673   define buffer buf_temp-xml-tables for temp-xml-tables.
     1674   do
     1675   on error undo, return error
     1676   :
     1677     for each buf_temp-xml-tables
     1678     break
     1679     by buf_temp-xml-tables.uniq-gate-rec
     1680     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1681     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1682     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1683     :
     1684       if valid-handle(buf_temp-xml-tables.tbl-handle_) then do:
     1685         buf_temp-xml-tables.tbl-handle_:empty-temp-table().
     1686       end.
     1687     end.
     1688   end.
     1689   end procedure.
     1690   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1691   procedure fillxpck :
     1692   define parameter buffer buf_esys-route for ub.esys-route.
     1693   define output parameter p-dataseth as handle no-undo .
     1694   define input-output parameter p-xmlh as handle no-undo .
     1695   define output parameter p-num-rec as integer no-undo .
     1696   define variable bh_route-dump as handle no-undo .
     1697   define variable tt-name as character no-undo .
     1698   define variable v-ok as logical no-undo .
     1699   define variable v-route-order-field as character no-undo .
     1700   define variable v-dump-order-field as character no-undo .
     1701   define variable v-esys-id as integer no-undo .
     1702   define variable v-db-num as integer no-undo .
     1703   define variable v-cr-db-num as integer no-undo .
     1704   define variable v-esr-dump-ord as int64 no-undo .
     1705   define variable v-esr-tbl-ord as int64 no-undo .
     1706   define variable v-pack-num as integer no-undo .
     1707   define buffer buf_esys-route-dump for ub.esys-route-dump.
     1708   define buffer buf_temp-xml-tables for temp-xml-tables.
     1709     main-block:
     1710     do
     1711     on error undo, return error
     1712     :
     1713       define variable v-longchar as longchar no-undo .
     1714       v-longchar = ?.
     1715       run get-gate-by-rec in this-procedure ( input buf_esys-route.uniq-gate-rec
     1716                                               ,output p-dataseth
     1717                                               ,input-output p-xmlh
     1718                                               ,input-output v-longchar
     1719                                               ) no-error.
     1720       if error-status:error then do:
     1721           undo main-block, return error substitute("Ошибка при создании структуры маршрутизируемых данных согласно гейту:&1&2"
     1722                               , buf_esys-route.uniq-gate-rec
     1723                               , chr(10)
     1724                               , error-status:get-message(1) ).
     1725       end.
     1726       run all-gates-empty in this-procedure no-error.
     1727       assign
     1728       v-esys-id = buf_esys-route.esys-id
     1729       v-db-num = buf_esys-route.db-num
     1730       v-cr-db-num = buf_esys-route.esr-cr-db-num
     1731       v-esr-dump-ord = buf_esys-route.esr-dump-ord
     1732       v-esr-tbl-ord = buf_esys-route.esr-tbl-ord
     1733       v-pack-num = buf_esys-route.esr-last-pack
     1734       .
     1735       _fill:
     1736       do while true:
     1737         assign
     1738         v-route-order-field = ''
     1739         v-dump-order-field = ''
     1740         .
     1741       for each buf_esys-route-dump where
     1742             buf_esys-route-dump.esrd-dump-ord   = v-esr-dump-ord
     1743       by buf_esys-route-dump.esrd-rec-ord
     1744       by buf_esys-route-dump.esrd-cr-db-num
     1745       on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1746       on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1747       on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1748       :
     1749         bh_route-dump = (buffer buf_esys-route-dump:handle).
     1750         if buf_esys-route-dump.uniq-gate-rec <> '':u then do:
     1751           find first buf_temp-xml-tables where
     1752                     buf_temp-xml-tables.tbl-name = buf_esys-route-dump.esrd-dump-name
     1753                 and buf_temp-xml-tables.uniq-gate-rec = buf_esys-route-dump.uniq-gate-rec no-error.
     1754           if not available buf_temp-xml-tables then do:
     1755             run gate-clear in this-procedure ( input p-dataseth, input p-xmlh).
     1756             undo main-block, return error substitute( "&1. Не найдена таблица &2 в гейте &3 (1).&4&5"
     1757                                       , vss-workfile
     1758                                       , buf_esys-route-dump.esrd-dump-name
     1759                                       , buf_esys-route-dump.uniq-gate-rec
     1760                                       , chr(10)
     1761                                       , error-status:get-message(1) ).
     1762           end.
     1763           if buf_temp-xml-tables.is-parent
     1764           and not (buf_esys-route-dump.esrd-action begins "_hidden="
     1765                     or buf_esys-route-dump.esrd-action begins "_route-order="
     1766                     or buf_esys-route-dump.esrd-action begins "_dump-order="
     1767                     )
     1768           then do:
     1769             p-num-rec = p-num-rec + 1.
     1770           end.
     1771         end.
     1772         else do:
     1773           find first buf_temp-xml-tables where
     1774                     buf_temp-xml-tables.tbl-name = buf_esys-route-dump.esrd-dump-name
     1775                 and buf_temp-xml-tables.uniq-gate-rec = '':U no-error.
     1776           if not available buf_temp-xml-tables then do:
     1777             create buf_temp-xml-tables.
     1778             assign
     1779             buf_temp-xml-tables.tbl-name = buf_esys-route-dump.esrd-dump-name
     1780             buf_temp-xml-tables.tbl-handle_ = ?
     1781             buf_temp-xml-tables.table-handle_ = ?
     1782             buf_temp-xml-tables.gate-handle_ = ?
     1783             buf_temp-xml-tables.uniq-gate-rec = ''
     1784             buf_temp-xml-tables.gate-name = ''
     1785             .
     1786             create temp-table buf_temp-xml-tables.table-handle_.
     1787             assign
     1788             buf_temp-xml-tables.table-handle_:undo      = false
     1789             tt-name       = "tt_":U + buf_esys-route-dump.esrd-dump-name
     1790             .
     1791             assign
     1792             v-ok = buf_temp-xml-tables.table-handle_:create-like( "ub.":U + buf_esys-route-dump.esrd-dump-name ) no-error
     1793             .
     1794             if v-ok <> true
     1795               or error-status :error
     1796             then do:
     1797               run gate-clear in this-procedure ( input p-dataseth, input p-xmlh).
     1798               undo main-block, return error substitute( "&1. Ошибка при создании временной таблицы &2 (1).&3&4", vss-workfile, tt-name, chr(10), error-status:get-message(1) ).
     1799             end.
     1800             assign
     1801               v-ok = buf_temp-xml-tables.table-handle_:temp-table-prepare( tt-name ) no-error
     1802             .
     1803             if v-ok <> true
     1804               or error-status :error
     1805             then do:
     1806               run gate-clear in this-procedure ( input p-dataseth, input p-xmlh).
     1807               undo main-block, return error substitute( "&1. Ошибка при создании временной таблицы &2 (2).&3&4", vss-workfile, tt-name, chr(10), error-status:get-message(1) ).
     1808             end.
     1809           end.
     1810           assign
     1811           buf_temp-xml-tables.tbl-handle_ = buf_temp-xml-tables.table-handle_:default-buffer-handle
     1812           p-num-rec = p-num-rec + 1
     1813           .
     1814         end.
     1815         if buf_esys-route-dump.esrd-action begins "_hidden="
     1816         or buf_esys-route-dump.esrd-action begins "_route-order="
     1817         or buf_esys-route-dump.esrd-action begins "_dump-order="
     1818         then do:
     1819         if buf_esys-route-dump.esrd-action begins "_hidden=" then do:
     1820           assign
     1821           buf_temp-xml-tables.tbl-handle_:buffer-field(entry(2, buf_esys-route-dump.esrd-action, "=")):xml-node-type = "hidden" no-error.
     1822           if error-status:error then do:
     1823             run gate-clear in this-procedure ( input p-dataseth, input p-xmlh).
     1824             undo main-block, return error substitute( "&1. Измение типа узла на HIdden не прошел для таблицы &2.&3&4"
     1825                                                     ,vss-workfile
     1826                                                     ,buf_esys-route-dump.esrd-dump-name
     1827                                                     ,chr(10)
     1828                                                     ,error-status:get-message(1) ).
     1829           end.
     1830         end.
     1831           if buf_esys-route-dump.esrd-action begins "_route-order="  then do:
     1832             v-route-order-field = entry(2, buf_esys-route-dump.esrd-action, "=").
     1833           end.
     1834           if buf_esys-route-dump.esrd-action begins "_dump-order="  then do:
     1835             v-dump-order-field = entry(2, buf_esys-route-dump.esrd-action, "=").
     1836           end.
     1837         end.
     1838         else do:
     1839         assign
     1840           v-ok = buf_temp-xml-tables.tbl-handle_:buffer-create no-error
     1841         .
     1842         if v-ok <> true
     1843           or error-status :error
     1844         then do:
     1845           run gate-clear in this-procedure ( input p-dataseth, input p-xmlh).
     1846           undo main-block, return error substitute( "&1. Ошибка при создании записи в буфере временной таблицы &2 .&3&4", vss-workfile, tt-name, chr(10), error-status:get-message(1) ).
     1847         end.
     1848         assign
     1849           v-ok = buf_temp-xml-tables.tbl-handle_:raw-transfer ( false, bh_route-dump:buffer-field("esrd-value-rec") ) no-error
     1850         .
     1851         if v-ok <> true
     1852           or error-status :error
     1853         then do:
     1854           run gate-clear in this-procedure ( input p-dataseth, input p-xmlh).
     1855             undo main-block, return error substitute( "&1. RAW-TRANSFER не прошел для таблицы &2.&3&4", vss-workfile, buf_temp-xml-tables.tbl-name, chr(10), error-status:get-message(1) ).
     1856         end.
     1857           if v-route-order-field <> '' then do:
     1858             assign
     1859             buf_temp-xml-tables.tbl-handle_:buffer-field(v-route-order-field):buffer-value = string(buf_esys-route.esr-tbl-ord, "9999999999999999999") + "-" +
     1860                                                                                              string(buf_esys-route-dump.esrd-rec-ord, "9999999999")
     1861             .
     1862           end.
     1863           if v-dump-order-field <> '' then do:
     1864             assign
     1865             buf_temp-xml-tables.tbl-handle_:buffer-field(v-dump-order-field):buffer-value = string(buf_esys-route-dump.esrd-dump-ord, "9999999999999999999") + "-" +
     1866                                                                                             string(buf_esys-route-dump.esrd-rec-ord, "9999999999")
     1867             .
     1868           end.
     1869         end.
     1870       end.
     1871         if buf_esys-route.esr-action = 'command-pbush':U then do:
     1872           find first  buf_esys-route exclusive-lock where
     1873                     buf_esys-route.esys-id = v-esys-id
     1874                 and buf_esys-route.db-num = v-db-num
     1875                 and buf_esys-route.esr-cr-db-num = v-cr-db-num
     1876                 and buf_esys-route.esr-last-pack = v-pack-num
     1877                 and buf_esys-route.esr-tbl-ord > v-esr-tbl-ord no-error.
     1878           if not available buf_esys-route then leave _fill.
     1879           v-esr-tbl-ord = buf_esys-route.esr-tbl-ord.
     1880           v-esr-dump-ord = buf_esys-route.esr-dump-ord.
     1881         end.
     1882         else do:
     1883           leave _fill.
     1884         end.
     1885       end.
     1886     end.
     1887   end procedure.
     1888   procedure fillxpck_empty :
     1889   define output parameter p-dataseth as handle no-undo .
     1890   define input-output parameter p-xmlh as handle no-undo .
     1891   define output parameter p-num-rec as integer no-undo .
     1892   do
     1893   on error undo, return error
     1894   :
     1895     create dataset p-dataseth .
     1896     assign
     1897     p-dataseth:name = "empty"
     1898     .
     1899   end.
     1900   end procedure.
     1901   define variable v-current-d-card as character no-undo .
     1902   define variable v-current-host-code as integer no-undo .
     1903   define variable v-current-obj-type as character no-undo .
     1904   define variable v-current-obj-code as integer no-undo .
     1905   define variable v-current-doc-code as character no-undo .
     1906   define variable v-current-lock as integer no-undo .
     1907   define variable v-current-wait as integer no-undo .
     1908   define variable v-save as integer no-undo .
     1909   define variable v-current-db-num as integer no-undo .
     1910   define variable v-current-date as date no-undo .
     1911   define variable v-emitent-host-code as integer no-undo .
     1912   define variable v-type as character no-undo .
     1913   define variable v-sign as integer no-undo .
     1914   define variable file-name as char.
     1915   define variable num-rec as integer no-undo .
     1916   define variable num-rec-ok as integer no-undo .
     1917   define variable v-full-path        as character no-undo .
     1918   define variable v-path             as character no-undo .
     1919   define variable v-file-name        as character no-undo .
     1920   define variable v-file-name-no-ext as character no-undo .
     1921   define variable v-file-name-ext    as character no-undo .
     1922   define variable v-end-new-line     as logical no-undo .
     1923   define variable v-last-error-message as character no-undo .
     1924   define variable v-retry-action as integer no-undo .
     1925   define variable hSAXWriter as handle no-undo .
     1926   define variable v-context-gate as character no-undo .
     1927   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1928   procedure set-error :
     1929   define input parameter p-mess as character no-undo .
     1930     do
     1931     on error undo, return error
     1932     :
     1933        assign
     1934        v-last-error-message = p-mess.
     1935     end.
     1936   end procedure.
     1937   define shared temp-table tt0-rule-call-param no-undo like ub.rule-call-param.
     1938   define buffer buf_temp-cmd for temp-cmd.
     1939   define temp-table temp-rule-call-param no-undo like ub.rule-call-param.
     1940   define buffer buf_temp-rule-call-param for temp-rule-call-param.
     1941   define stream Outstream.
     1942   define variable log-file-name                as character      no-undo init "shd-free.log".
     1943   define variable v-view-log                   as logical        no-undo .
     1944   define variable v-stop                       as logical        no-undo .
     1945   define variable v-seek                       as int64          no-undo .
     1946   function 00050000_get-error-message returns character :
     1947   define variable v-ii as integer no-undo .
     1948   define variable v-mess as character no-undo .
     1949   DO v-ii = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1950       v-mess = substitute("&1&2ош &3"
     1951                           ,v-mess
     1952                           ,chr(10)
     1953                           ,ERROR-STATUS:GET-MESSAGE(v-ii)).
     1954   return v-mess.
     1955   END.
     1956   end function.
     1957     define variable p-esys-id as integer no-undo.
     1958     define variable p-xsd-file as character no-undo.
     1959   on delete of this-procedure do:
     1960     run delete-procedure in this-procedure .
     1961   end.
     1962   run load-ruleset-context in this-procedure ( input p-ruleset-id) no-error .
     1963   if error-status:error
     1964   or return-value = "return" then return.
     1965   if not this-procedure:persistent then do:
     1966     run proc-main in this-procedure ( input p-type
     1967                                 ,input p-emitent-host-code ) no-error .
     1968     if error-status:error then do:
     1969         run delete-procedure in this-procedure .
     1970         undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     1971     end.
     1972     run delete-procedure in this-procedure .
     1973   end.
     1974   procedure proc-main :
     1975   define input parameter p-type like ub.dis-card.type no-undo .
     1976   define input parameter p-emitent-host-code like ub.dis-card.emitent-host-code no-undo .
     1977   define buffer buf_rule-call-param for tt0-rule-call-param.
     1978   _main:
     1979   do
     1980   on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1981   on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
     1982   on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
     1983   :
     1984   assign
     1985   v-emitent-host-code = p-emitent-host-code
     1986   v-type = p-type.
     1987   run write-log  in p-log-handle (
     1988                                    input 0
     1989                                  , "&DLine").
     1990   run write-log-and-file in p-log-handle (
     1991         input 1
     1992       , input log-file-name
     1993       , input 1
     1994       , input substitute("Экспорт данных в файл &1", file-name)).
     1995     if p-ruleset-id = 1 then do:
     1996       output stream Outstream to value(file-name).
     1997     end.
     1998   _1806:
     1999   do:
     2000         run export-data-dc in this-procedure  no-error .
     2001      if p-ruleset-id = 1 then do:
     2002        output stream Outstream close.
     2003      end.
     2004      run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Данные экспортированы в файл &1",  file-name)).                      assign v-view-log = yes.
     2005   end.
     2006   end.
     2007   end procedure.
     2008   procedure load-ruleset-context :
     2009   define input parameter p-ruleset-id as integer no-undo .
     2010   define buffer buf_rule-call-param for tt0-rule-call-param.
     2011     do
     2012     on error undo, return error
     2013     :
     2014    find first buf_rule-call-param no-lock where
     2015   buf_rule-call-param.codex_id = p-codex-id
     2016   and buf_rule-call-param.ruleset_id = p-ruleset-id
     2017   and buf_rule-call-param.call_id = p-call-id
     2018   and buf_rule-call-param.order_id = p-order-id
     2019   and buf_rule-call-param.rule_id = p-rule-id
     2020   and buf_rule-call-param.param-name = "p-esys-id"
     2021    no-error.
     2022   if available buf_rule-call-param then do:
     2023   assign p-esys-id = buf_rule-call-param.param-value-integer.
     2024   end.
     2025    find first buf_rule-call-param no-lock where
     2026   buf_rule-call-param.codex_id = p-codex-id
     2027   and buf_rule-call-param.ruleset_id = p-ruleset-id
     2028   and buf_rule-call-param.call_id = p-call-id
     2029   and buf_rule-call-param.order_id = p-order-id
     2030   and buf_rule-call-param.rule_id = p-rule-id
     2031   and buf_rule-call-param.param-name = "p-xsd-file"
     2032    no-error.
     2033   if available buf_rule-call-param then do:
     2034   assign p-xsd-file = buf_rule-call-param.param-value-character.
     2035   end.
     2036       case p-ruleset-id:
     2037         when 1 then do:
     2038           assign
     2039           v-sign = 1
     2040           v-current-host-code = p-host-code
     2041           v-current-obj-type = p-obj-type
     2042           v-current-obj-code = p-obj-code
     2043           v-current-doc-code = p-doc-code
     2044           v-current-db-num = g#db-num
     2045           v-current-lock = no-lock
     2046           v-current-date = p-doc-date
     2047           file-name  = p-process-file-name
     2048           .
     2049           if NOT g#db-num = 0 then do:
     2050             run write-log-and-file in p-log-handle (
     2051                   input 1
     2052                 , input log-file-name
     2053                 , input 1
     2054                 , input substitute("Экспорт данных по ДК только в ГБД")).
     2055             assign
     2056             v-view-log = yes.
     2057             .
     2058             return "return".
     2059           end.
     2060         end.
     2061       end case.
     2062     end.
     2063   end procedure.
     2064   procedure delete-procedure :
     2065     do
     2066     on error undo, return error
     2067     :
     2068         run garbcoll_clear in this-procedure .
     2069     end.
     2070   end procedure.
     2071   procedure xmldata:
     2072   define input parameter xmlnode as character.
     2073   define input parameter chardata as character.
     2074   hsaxwriter:start-element(xmlnode).
     2075   hsaxwriter:write-characters(chardata).
     2076   hsaxwriter:end-element(xmlnode).
     2077   end procedure.
     2078   procedure export-data-dc :
     2079   define variable v-last-esr-tbl-ord as int64 no-undo .
     2080   define variable v-int64-id as int64 no-undo .
     2081   define variable v-longchar as longchar no-undo .
     2082   define variable v_dataseth as handle no-undo .
     2083   define variable v-ii as integer   no-undo .
     2084   define variable glog as logical   no-undo .
     2085   define variable v_qh as handle no-undo .
     2086   define variable v-tbl-row as rowid no-undo .
     2087   define variable v-tbl-name as character no-undo .
     2088   define variable v-xmlh as handle no-undo .
     2089   define variable v-gate-file-name as character no-undo .
     2090   define variable v-num-rec as integer no-undo .
     2091   define buffer buf_esys-route for ub.esys-route.
     2092   define buffer buf_clob-data for ub.clob-data.
     2093   define buffer buf_esys-route-dump for ub.esys-route-dump.
     2094   define buffer buf_temp-xml-tables for temp-xml-tables.
     2095     do
     2096     on error undo, return error return-value
     2097     :
     2098       v-xmlh = buffer buf_temp-xml-tables:handle.
     2099       find last buf_esys-route where
     2100               buf_esys-route.esys-id = p-esys-id
     2101           and buf_esys-route.db-num = 0
     2102           and buf_esys-route.esr-cr-db-num = 0
     2103           and buf_esys-route.esr-last-pack = - 1 no-error.
     2104      if available buf_esys-route then do:
     2105         assign
     2106         v-last-esr-tbl-ord = buf_esys-route.esr-tbl-ord.
     2107       end.
     2108       else do:
     2109       end.
     2110       _dc-trn-doc:
     2111       for each buf_esys-route share-lock
     2112           where buf_esys-route.esys-id     = p-esys-id
     2113             and buf_esys-route.db-num      = 0
     2114             and buf_esys-route.esr-status  = 0
     2115             and buf_esys-route.esr-cr-db-num = 0
     2116             and buf_esys-route.esr-tbl-ord <= v-last-esr-tbl-ord
     2117       on error undo _dc-trn-doc, return:
     2118         if buf_esys-route.esr-action = 'command-bush':U then do:
     2119           run get-gate-file-name in this-procedure ( input buf_esys-route.uniq-gate-rec
     2120                                                  ,output v-gate-file-name
     2121                                                  ) no-error.
     2122           if v-gate-file-name <> p-xsd-file then do:
     2123             run gate-clear in this-procedure ( input v_dataseth, input v-xmlh).
     2124             next _dc-trn-doc.
     2125           end.
     2126           run  fillxpck in this-procedure (
     2127                                             buffer buf_esys-route
     2128                                            ,output v_dataseth
     2129                                            ,input-output v-xmlh
     2130                                            ,output v-num-rec
     2131                                            ) no-error.
     2132           if error-status:error then do:
     2133             undo, return error substitute("&1 Ошибка при заполнении пакета &6 через gate &2&3&4&3&5"
     2134                                                     , vss-workfile
     2135                                                     ,buf_esys-route.uniq-gate-rec
     2136                                                     ,chr(10)
     2137                                                     ,error-status:get-message(1)
     2138                                                     ,return-value
     2139                                                     ,buf_esys-route.esr-name-rec
     2140                                                     ).
     2141           end.
     2142           for each buf_temp-xml-tables:
     2143             create query v_qh.
     2144             v_qh:set-buffers(buf_temp-xml-tables.tbl-handle_).
     2145             v_qh:query-prepare( substitute("for each &1", buf_temp-xml-tables.tbl-name)).
     2146             v_qh:query-open().
     2147             repeat:
     2148               glog = v_qh:get-next.
     2149               if v_qh:query-off-end then leave.
     2150               case buf_temp-xml-tables.tbl-name:
     2151                 when "lantab-export-chk":U then do:
     2152                   put stream OutStream unformatted
     2153                   buf_temp-xml-tables.tbl-handle_::obj-code ";":U
     2154                   (if buf_temp-xml-tables.tbl-handle_::action = -1
     2155                   then "-1"
     2156                   else "")
     2157                   buf_temp-xml-tables.tbl-handle_::doc-code ";":U
     2158                   buf_temp-xml-tables.tbl-handle_::chk-date ";":U
     2159                   buf_temp-xml-tables.tbl-handle_::d-card ";":U
     2160                   buf_temp-xml-tables.tbl-handle_::netto  ";":U
     2161                   buf_temp-xml-tables.tbl-handle_::discnt ";":U
     2162                   buf_temp-xml-tables.tbl-handle_::out-code
     2163                   skip.
     2164                 end.
     2165                 when "lantab-export-trn":U then do:
     2166                   put stream OutStream unformatted
     2167                   buf_temp-xml-tables.tbl-handle_::obj-code ";":U
     2168                   (if buf_temp-xml-tables.tbl-handle_::action = -1
     2169                   then "-1"
     2170                   else "")
     2171                   buf_temp-xml-tables.tbl-handle_::sale-doc ";":U
     2172                   buf_temp-xml-tables.tbl-handle_::doc-date ";":U
     2173                   buf_temp-xml-tables.tbl-handle_::d-card ";":U
     2174                   buf_temp-xml-tables.tbl-handle_::gds-tot-r-b ";":U
     2175                   buf_temp-xml-tables.tbl-handle_::gds-dis-r-b ";":U
     2176                   buf_temp-xml-tables.tbl-handle_::sale-doc
     2177                   skip.
     2178                 end.
     2179               end case.
     2180             end.
     2181             if valid-handle(v_qh) then delete object v_qh.
     2182           end.
     2183           run gate-clear in this-procedure ( input v_dataseth, input v-xmlh).
     2184         end.
     2185         DEFINE VARIABLE v-today as date no-undo .
     2186         DEFINE VARIABLE v-time as integer no-undo .
     2187         run cur-time in this-procedure (
     2188               output v-today
     2189             , output v-time
     2190         ).
     2191         assign
     2192             buf_esys-route.esr-status            = 1
     2193             buf_esys-route.esr-sys-date          = v-today
     2194             buf_esys-route.esr-sys-time-int      = v-time
     2195             buf_esys-route.esr-sys-time          = string( v-time, "hh:mm:ss" )
     2196         .
     2197       end.
     2198       run gate-clear in this-procedure ( input v_dataseth, input v-xmlh).
     2199     end.
     2200   end procedure.
