     1119   procedure clear-from-rec-ord :
     1120   define input parameter p-rec-ord as integer no-undo .
     1121   define buffer buf_temp-no-route for temp-no-route.
     1122   define buffer buf_temp-smart-link for temp-smart-link.
     1123   do
     1124   on error undo, return error
     1125   :
     1126   for each buf_temp-no-route where
     1127           buf_temp-no-route.rec-ord > p-rec-ord:
     1128     delete buf_temp-no-route.
     1129   end.
     1130   for each buf_temp-smart-link where
     1131           buf_temp-smart-link.rec-ord > p-rec-ord:
     1132      delete buf_temp-smart-link.
     1133   end.
     1134   end.
     1135   end procedure.
