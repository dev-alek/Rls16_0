     1038       run gen-key-rec in this-procedure ( input p-tbl-name
     1039                                          ,input p-bh_tbl-name
     1040                                          ,output v-key-rec     ).
     1041      find first buf_temp-smart-link where
     1042                 buf_temp-smart-link.uniq-key-rec = v-key-rec
     1043              and buf_temp-smart-link.key-field = p-key-field
     1044              and buf_temp-smart-link.rec-ord = p-rec-ord
     1045              no-error .
