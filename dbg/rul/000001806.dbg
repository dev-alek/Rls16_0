     1105   on error undo, return error
     1106   :
     1107      find first buf_temp-no-route where
     1108                 buf_temp-no-route.rec-ord = p-rec-ord
     1109              and buf_temp-no-route.db-num = p-db-num no-error .
     1110      if not available buf_temp-no-route then do:
     1111        create buf_temp-no-route.
     1112        assign
     1113        buf_temp-no-route.rec-ord = p-rec-ord
     1114        buf_temp-no-route.db-num = p-db-num
