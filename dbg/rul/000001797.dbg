     2052   procedure get-db-list-for-d-card2 :
     2053   define input parameter p-d-card as character no-undo .
     2054   define variable v-current-db-processed as logical no-undo .
     2055   define buffer buf_clients  for ub.clients.
     2056   define buffer buf_dis-obj for ub.dis-obj.
     2057   define buffer buf_temp-smart-route for temp-smart-route.
     2058     do
     2059     on error undo, return error return-value
     2060     :
     2061       for each buf_dis-obj no-lock where
     2062               buf_dis-obj.d-card = p-d-card,
     2063          first buf_clients no-lock where
     2064               buf_clients.obj-type = buf_dis-obj.obj-type
     2065           and buf_clients.obj-code = buf_dis-obj.obj-code
     2066       break by
     2067       buf_clients.db-num:
     2068         if first-of(buf_Clients.db-num) then do:
     2069           find first buf_temp-smart-route no-lock where
     2070                 buf_temp-smart-route.key-field = p-d-card
     2071             and buf_temp-smart-route.db-num = buf_clients.db-num
     2072                 no-error.
     2073           if available buf_temp-smart-route then return.
     2074           create buf_temp-smart-route.
     2075           assign
     2076           buf_temp-smart-route.key-field = p-d-card
     2077           buf_temp-smart-route.db-num = buf_clients.db-num
     2078           .
     2079           if buf_clients.db-num = g#db-num then do:
     2080             v-current-db-processed = yes.
     2081           end.
     2082         end.
     2083       end.
     2084       if not v-current-db-processed then do:
     2085         find first buf_temp-smart-route no-lock where
     2086               buf_temp-smart-route.key-field = p-d-card
     2087           and buf_temp-smart-route.db-num = g#db-num  no-error.
     2088         if not available buf_temp-smart-route then do:
     2089           create buf_temp-smart-route.
     2090           assign
     2091           buf_temp-smart-route.key-field = p-d-card
     2092           buf_temp-smart-route.db-num = g#db-num
     2093           .
     2094         end.
     2095       end.
     2096     end.
     2097   end procedure.
