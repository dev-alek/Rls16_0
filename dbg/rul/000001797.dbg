     1127   do
     1128   on error undo, return error
     1129   :
     1130      find first buf_temp-no-route where
     1131                 buf_temp-no-route.rec-ord = p-rec-ord
     1132              and buf_temp-no-route.db-num = p-db-num no-error .
     1133      if not available buf_temp-no-route then do:
