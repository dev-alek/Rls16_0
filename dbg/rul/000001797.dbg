     2311           v-current-date = p-doc-date
     2312           v-current-fact-date = p-fact-date
     2313           .
     2314         end.
     2315         when 2 then do:
     2316           assign
     2317           v-sign = -1
     2318           v-current-host-code = p-host-code
     2319           v-current-obj-type = p-obj-type
     2320           v-current-obj-code = p-obj-code
     2321           v-current-db-num = g#db-num
     2322           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     2323           v-current-doc-code = p-doc-code
     2324           v-current-doc-date = p-doc-date
     2325           v-current-doc-fact-date = p-fact-date
     2326           v-current-date = p-doc-date
     2327           v-current-fact-date = p-fact-date
     2328           .
     2329         end.
     2330         when 3 or
     2331         when 6 then do:
     2332           assign
     2333           v-sign = 1
     2334           v-current-host-code = p-host-code
     2335           v-current-obj-type = p-obj-type
     2336           v-current-obj-code = p-obj-code
     2337           v-current-db-num = g#db-num
     2338           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     2339           v-current-doc-code = p-doc-code
     2340           v-current-doc-date = p-doc-date
     2341           v-current-doc-time = 0
     2342           v-current-doc-fact-date = p-fact-date
     2343           v-current-date = p-doc-date
     2344           v-current-fact-date = p-fact-date
     2345           .
     2346         end.
     2347         when 4 then do:
     2348           assign
     2349           v-sign = -1
     2350           v-current-host-code = p-host-code
     2351           v-current-obj-type = p-obj-type
     2352           v-current-obj-code = p-obj-code
     2353           v-current-db-num = g#db-num
     2354           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     2355           v-current-doc-code = p-doc-code
     2356           v-current-doc-date = p-doc-date
     2357           v-current-doc-time = 0
     2358           v-current-doc-fact-date = p-fact-date
     2359           v-current-date = p-doc-date
     2360           v-current-fact-date = p-fact-date
     2361           .
     2362         end.
     2363         when 5 then do:
     2364           assign
     2365           v-sign = 1
     2366           v-current-host-code = p-host-code
     2367           v-current-obj-type = p-obj-type
     2368           v-current-obj-code = p-obj-code
     2369           v-current-db-num = g#db-num
     2370           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     2371           v-current-doc-code = p-doc-code
     2372           v-current-doc-date = p-doc-date
     2373           v-current-doc-time = 0
     2374           v-current-doc-fact-date = p-fact-date
     2375           v-current-date = p-doc-date
     2376           v-current-fact-date = p-fact-date
     2377           .
     2378         end.
     2379         when 7
     2380         or when 9
     2381         then do:
     2382           assign
     2383           v-sign = 1
     2384           v-current-host-code = p-host-code
     2385           v-current-obj-type = p-obj-type
     2386           v-current-obj-code = p-obj-code
     2387           v-current-db-num = g#db-num
     2388           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     2389           v-current-doc-code = p-doc-code
     2390           v-current-doc-date = p-doc-date
     2391           v-current-doc-time = 0
     2392           v-current-doc-fact-date = p-fact-date
     2393           v-current-date = p-doc-date
     2394           v-current-fact-date = p-fact-date
     2395           .
     2396         end.
     2397       end case.
     2398     end.
     2399   end procedure.
     2400   procedure delete-procedure :
     2401     do
     2402     on error undo, return error
     2403     :
     2404         run garbcoll_clear in this-procedure .
     2405     end.
     2406   end procedure.
