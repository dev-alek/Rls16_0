     1493   DEFINE VARIABLE t-is-over AS LOGICAL INITIAL no
     1494        LABEL "Учет перевыпуска карт"
     1495        VIEW-AS TOGGLE-BOX
     1496        SIZE 29 BY 1 NO-UNDO.
     1497   DEFINE QUERY BR-rcp FOR
     1498         X_ruledict-param,
     1499         X_rp-rule-param,
     1500         tt-rule-call-param,
     1501         TERM_tt-rule-call-param SCROLLING.
     1502   DEFINE BROWSE BR-rcp
     1503     QUERY BR-rcp DISPLAY
     1504         X_rp-rule-param.rp-param-name COLUMN-LABEL "Название пар-ра!профайла" FORMAT "X(20)" width 16
     1505   term_tt-rule-call-param.codex_id COLUMN-LABEL "Кодекс"
     1506   term_tt-rule-call-param.ruleset_id COLUMN-LABEL "Набор"
     1507   term_tt-rule-call-param.order_id  COLUMN-LABEL "Порядок!вызова"
     1508   term_tt-rule-call-param.rule_id  COLUMN-LABEL "Правило"
     1509   term_tt-rule-call-param.profile_id  COLUMN-LABEL "Профайл"
     1510   term_tt-rule-call-param.once-more COLUMN-LABEL "№!Привязки"
     1511   (if lookup (term_tt-rule-call-param.param-data-type, 'character,date,datetime,datetime-tz,decimal,integer,void,logical,memptr,raw,recid,rowid,widget-handle,handle,blob,clob,class,com-handle,longchar,int64':U) > 0 then entry (lookup (term_tt-rule-call-param.param-data-type, 'character,date,datetime,datetime-tz,decimal,integer,void,logical,memptr,raw,recid,rowid,widget-handle,handle,blob,clob,class,com-handle,longchar,int64':U), 'строка,дата,дата-время,дата-время-з,десятичное,целое,пусто,логическое,память,двоичные,номер записи,Номер Записи,ссылка,ссылка,Больш.бин.объект,Больш.стр.объект,Объект,COM-объект,Длинная строка,64Целое':U) else term_tt-rule-call-param.param-data-type) COLUMN-LABEL "Тип пар-ра" FORMAT "X(12)"
     1512   term_tt-rule-call-param.param-num COLUMN-LABEL "№!пар-ра" FORMAT ">9"
     1513   TERM_tt-rule-call-param.p-index COLUMN-LABEL "Инд!екс" FORMAT ">9"
     1514   term_tt-rule-call-param.param-name COLUMN-LABEL "Название пар-ра!правила" FORMAT "X(16)"
     1515   term_tt-rule-call-param.param-label COLUMN-LABEL "Название пар-ра" FORMAT "X(255)" WIDTH 30
     1516   entry (lookup (term_tt-rule-call-param.param-mode, 'input,output,input-output,buffer,input table,output table,input-output table':u), 'вх,вых,вх-вых,курсор,вх табл,вых табл,вх/вых табл':u) COLUMN-LABEL "Вид!пар-ра"
     1517   get-param-value( INPUT term_tt-rule-call-param.param-data-type
     1518                   ,INPUT term_tt-rule-call-param.param-2-data-type
     1519                   ,INPUT term_tt-rule-call-param.param-3-data-type
     1520                   ,INPUT TERM_tt-rule-call-param.p-index
     1521                   ,INPUT term_tt-rule-call-param.param-value-character
     1522                   ,INPUT term_tt-rule-call-param.param-value-date
     1523                   ,INPUT term_tt-rule-call-param.param-value-decimal
     1524                   ,INPUT term_tt-rule-call-param.param-value-integer
     1525                   ,INPUT term_tt-rule-call-param.param-value-logical) COLUMN-LABEL "Значение" FORMAT "X(255)" WIDTH 26
     1526   (IF term_tt-rule-call-param.param-data-type = 'character':U
     1527    THEN term_tt-rule-call-param.param-value-character
     1528    ELSE '':U) COLUMN-LABEL "Значение!(строковое)" FORMAT "X(26)"
     1529   (IF term_tt-rule-call-param.param-data-type = 'date':U
     1530   THEN STRING(term_tt-rule-call-param.param-value-date, "99/99/9999")
     1531   ELSE '':U)    COLUMN-LABEL "Значение!(Дата)" FORMAT "X(10)" WIDTH 12
     1532   (IF term_tt-rule-call-param.param-data-type = 'decimal':U
     1533   THEN STRING(term_tt-rule-call-param.param-value-decimal)
     1534   ELSE '':U) COLUMN-LABEL "Значение!(Десятичное)"   FORMAT "X(16)"
     1535   (IF term_tt-rule-call-param.param-data-type = 'integer':U
     1536   THEN STRING(term_tt-rule-call-param.param-value-integer)
     1537   ELSE '':U) COLUMN-LABEL "Значение!(Целое)" FORMAT "X(10)"
     1538   (IF term_tt-rule-call-param.param-data-type = 'logical':U
     1539   THEN STRING(term_tt-rule-call-param.param-value-logical, "+/-")
     1540   ELSE '':U) COLUMN-LABEL "Значение!(Логическое)" FORMAT "X(2)"
     1541   calldscr(tt-rule-call-param.call_id) COLUMN-LABEL  "Точка вызова" FORMAT "X(40)"
     1542       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 6
     1543            FONT 4 ROW-HEIGHT-CHARS .67 FIT-LAST-COLUMN.
     1544   DEFINE FRAME Dialog-Frame
     1545        B-exit AT ROW 1 COL 1
     1546        b-quit AT ROW 1 COL 11
     1547        B-Help AT ROW 1 COL 95
     1548        rs-r-b AT ROW 2.07 COL 25.5 NO-LABEL WIDGET-ID 106
     1549        t-is-over AT ROW 2.07 COL 41 WIDGET-ID 88
     1550        f-rule-num AT ROW 3.13 COL 75.5 COLON-ALIGNED WIDGET-ID 110
     1551        b-dis-rule AT ROW 3.13 COL 93.5 WIDGET-ID 112
     1552        b-lkp-dis-rule AT ROW 3.13 COL 97 WIDGET-ID 148
     1553        BR-rcp AT ROW 17 COL 1 WIDGET-ID 100
     1554        l-r-b AT ROW 2.07 COL 1.5 NO-LABEL WIDGET-ID 122
     1555        f-dis-rule-name AT ROW 4.2 COL 1 NO-LABEL WIDGET-ID 124
     1556        SPACE(1.09) SKIP(18.39)
     1557       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1558            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1559            TITLE ""
     1560            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
     1561   ASSIGN
     1562          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1563          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1564   ASSIGN
     1565          BR-rcp:HIDDEN  IN FRAME Dialog-Frame                = TRUE.
     1566   ASSIGN
     1567          l-r-b:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     1568   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1569   DO:
     1570     APPLY "END-ERROR":U TO SELF.
     1571   END.
     1572   ON CHOOSE OF b-dis-rule IN FRAME Dialog-Frame
     1573   DO:
     1574   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     1575   DEFINE VARIABLE v-sts AS INTEGER NO-UNDO.
     1576   DEFINE BUFFER buf_dis-rule FOR ub.dis-rule.
     1577     run ref/dis-ruls.w (   input  parparentproc
     1578                           ,input v-cntxt-host-code-obj
     1579                           ,input v-cntxt-obj-type
     1580                           ,input v-cntxt-obj-code
     1581                           ,input "b-sel,b-add"
     1582                           ,input "upper-rule-num"
     1583                           ,input 57
     1584                           ,input ?
     1585                           ,input 0
     1586                           ,input-output v-sts
     1587                           ,input-OUTPUT v-rid-list) NO-ERROR.
     1588     if v-rid-list <> '':U then do:
     1589       find first buf_dis-rule no-lock where
     1590                 recid(buf_dis-rule) = integer(v-rid-list) no-error.
     1591       if not available buf_dis-rule then do:
     1592           MESSAGE substitute("Не найдено правило скидки c recid &1", v-rid-list)
     1593           VIEW-AS ALERT-BOX ERROR.
     1594           UNDO, RETURN NO-APPLY.
     1595       end.
     1596       if not (buf_dis-rule.host-code = 0
     1597       and buf_dis-rule.obj-type = ''
     1598       and buf_dis-rule.obj-code = 0) then do:
     1599         MESSAGE
     1600         substitute("Правило скидки должно иметь область действия ГЛОБАЛЬНО!")
     1601         VIEW-AS ALERT-BOX ERROR.
     1602         UNDO, RETURN NO-APPLY.
     1603       end.
     1604       assign
     1605       f-rule-num = buf_dis-rule.rule-num
     1606       .
     1607       DISPLAY
     1608       f-rule-num
     1609       buf_dis-rule.des @ f-dis-rule-name
     1610       WITH FRAME Dialog-Frame.
     1611     end.
     1612   END.
     1613   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
     1614   DO:
     1615     RUN proc-save IN THIS-PROCEDURE  NO-ERROR.
     1616     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1617   END.
     1618   ON CHOOSE OF b-lkp-dis-rule IN FRAME Dialog-Frame
     1619   DO:
     1620   define variable vss-include-info12 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1621   if lookup(self :type
     1622            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     1623            ) = 0
     1624   then do:
     1625     message
     1626       "$Workfile$"
     1627       "Указанному интерфейсному элементу фокус не может быть передан" skip
     1628       "Интерфейсный элемент" self :name  skip
     1629       "Тип" self :type  skip
     1630       "Процедура" this-procedure :file-name skip
     1631       view-as alert-box .
     1632   end.
     1633   else do:
     1634     apply "entry":u to self  .
     1635     if focus :handle <> self :handle  then do:
     1636       return no-apply .
     1637     end.
     1638   end.
     1639     IF f-rule-num > 0  THEN
     1640     run ref/show-dr.p ( INPUT parparentproc
     1641                        ,INPUT f-rule-num) NO-ERROR.
     1642   END.
     1643   ON VALUE-CHANGED OF t-is-over IN FRAME Dialog-Frame
     1644   DO:
     1645      assign
     1646      t-is-over.
     1647   END.
     1648   ON ROW-DISPLAY OF br-rcp IN frame Dialog-Frame
     1649   DO:
     1650     IF AVAIL tt-rule-call-param THEN DO:
     1651       RUN rcps_set-row-color IN THIS-PROCEDURE ( INPUT term_tt-rule-call-param.param-data-type).
     1652     END.
     1653   END.
     1654   ON f6 anywhere DO:
     1655     ASSIGN
     1656     br-rcp:VISIBLE IN FRAME Dialog-Frame = (NOT br-rcp:VISIBLE IN FRAME Dialog-Frame)
     1657     .
     1658   END.
     1659   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1660   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1661   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1662   on help of frame Dialog-Frame
     1663   do:
     1664     run gbl/app_help.p
     1665       (input this-procedure :file-name
     1666       ,input ''
     1667       ,input ?
     1668       ) no-error.
     1669     if error-status :error then do:
     1670       message
     1671         "Ошибка при вызове помощи"
     1672         error-status :get-message(1)
     1673         view-as alert-box .
     1674     end.
     1675   end.
     1676   run minbtn-set in this-procedure .
     1677   on choose of b-help in frame Dialog-Frame
     1678   do:
     1679     apply "help":u to frame Dialog-Frame .
     1680   end.
     1681   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1682   procedure minbtn-set :
     1683       do
     1684           on error undo, return error return-value
     1685           :
     1686           define variable ii              as integer       no-undo .
     1687           define variable fh              as widget-handle no-undo .
     1688           define variable hh              as widget-handle no-undo .
     1689           define variable v-h             as handle        extent 4 no-undo .
     1690           define variable v-name-button   as character     no-undo .
     1691           define variable v-help-old-x    as decimal       no-undo .
     1692           define variable v-help-old-y    as decimal       no-undo .
     1693           define variable v-help-old-size as decimal       no-undo .
     1694           define variable v-frame-width   as decimal       no-undo .
     1695           define variable jj              as integer       no-undo .
     1696           do
     1697               on error undo, return error
     1698               :
     1699               assign
     1700                   v-frame-width = frame Dialog-Frame:width - 0.3
     1701                   fh            = frame Dialog-Frame:first-child
     1702                   hh            = fh:first-child
     1703                   ii            = 1
     1704                   .
     1705               do while valid-handle(hh):
     1706                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1707                   do:
     1708                       case lc(hh:name) :
     1709                           when "b-help" then
     1710                               do:
     1711                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1712                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1713                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1714                                   hh:TOOLTIP = "Помощь" .
     1715                                   v-help-old-x = hh:column .
     1716                                   v-help-old-y = hh:row    .
     1717                                   v-help-old-size = hh:width .
     1718                                   hh:width-chars = 2.5 .
     1719                               end.
     1720                           when "b-print" then
     1721                               do:
     1722                                   hh:load-image("cmp/b-print.bmp":u) .
     1723                                   hh:TOOLTIP = "Печать" .
     1724                                   v-h[ii] = hh:handle .
     1725                                   ii = ii + 1 .
     1726                                   hh:width-chars = 3 .
     1727                               end.
     1728                           when "b-history" or
     1729                           when "b-hist" then
     1730                               do:
     1731                                   hh:load-image("cmp/b-hist.bmp":u) .
     1732                                   hh:TOOLTIP = "История" .
     1733                                   v-h[ii] = hh:handle .
     1734                                   ii = ii + 1 .
     1735                                   hh:width-chars = 3 .
     1736                               end.
     1737                           when "b-sch" then
     1738                               do:
     1739                                   hh:load-image("cmp/b-sch.bmp":u) .
     1740                                   hh:TOOLTIP = "Установка Фильтра" .
     1741                                   v-h[ii] = hh:handle .
     1742                                   ii = ii + 1 .
     1743                                   hh:width-chars = 3 .
     1744                               end.
     1745                           when "b-hist-user" then
     1746                               do:
     1747                                   hh:load-image("cmp/b-hist.bmp":u) .
     1748                                   hh:TOOLTIP = "История пользователя" .
     1749                                   ii = ii + 1 .
     1750                               end.
     1751                       end case.
     1752                   end.
     1753                   hh = hh:next-sibling.
     1754               end.
     1755               b-help:column = v-frame-width - b-help:width-chars.
     1756               jj = 0.
     1757               repeat ii = 4 to 1 by -1 :
     1758                   if valid-handle (v-h[ii] ) then
     1759                   do:
     1760                       jj  = jj + 1 .
     1761                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1762                       v-h[ii]:row    = v-help-old-y .
     1763                   end.
     1764               end.
     1765           end.
     1766       end.
     1767   end procedure.
     1768   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1769   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1770   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1771   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1772   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1773   define variable v-diasize-current-frame-height as decimal   no-undo .
     1774   define variable v-diasize-change-size          as logical   no-undo .
     1775   define variable v-diasize-resize-button        as handle    no-undo .
     1776   define variable v-diasize-wndmax               as logical   no-undo .
     1777   define variable v-diasize-wndstore             as logical   no-undo .
     1778   define variable v-diasize-proc-name            as character no-undo .
     1779   define variable v-diasize-browse-handle        as handle    no-undo .
     1780   define variable v-diasize-browse-number        as integer   no-undo .
     1781   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1782   define temp-table temp-diasize-handle no-undo
     1783     field handle-value  as handle
     1784     field save-position as decimal
     1785     index xpk is primary unique handle-value
     1786     .
     1787   define temp-table temp-browse-handle no-undo
     1788     field browse-type   as character
     1789     field browse-number as integer
     1790     field browse-handle as handle
     1791     field original-size as decimal
     1792     index xpk is primary unique browse-type browse-number
     1793     index xie browse-type browse-handle
     1794   .
     1795   procedure diasize_change-height :
     1796     define input  parameter p-change-value  as decimal   no-undo .
     1797     define input  parameter p-move-resize   as logical   no-undo .
     1798     define variable v-field-group-handle    as handle    no-undo .
     1799     define variable v-object-handle         as handle    no-undo .
     1800     define variable v-frame-height          as decimal   no-undo .
     1801     define variable v-frame-virtual-height  as decimal   no-undo .
     1802     define variable v-browse-height         as decimal   no-undo .
     1803     define variable v-window-height         as decimal   no-undo .
     1804     define variable v-window-virtual-height as decimal   no-undo .
     1805     define variable v-change-sign           as integer   no-undo .
     1806     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1807     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1808     if p-change-value > 0
     1809     then do:
     1810       if frame Dialog-Frame :height + p-change-value
     1811           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1812       then do:
     1813         assign
     1814           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1815                           - (frame Dialog-Frame :height-chars)
     1816         .
     1817         if p-change-value <= 0
     1818         then do:
     1819           run diasize_position-resize-button in this-procedure .
     1820           return .
     1821         end.
     1822       end.
     1823     end.
     1824     if p-change-value < 0
     1825     then do:
     1826       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1827       then do:
     1828         assign
     1829           p-change-value = v-diasize-orig-frame-height
     1830                          - (frame Dialog-Frame :height-chars)
     1831         .
     1832         if p-change-value >= 0
     1833         then do:
     1834           run diasize_position-resize-button in this-procedure .
     1835           return .
     1836         end.
     1837       end.
     1838     end.
     1839     if p-change-value >= 0
     1840     then do:
     1841       assign
     1842         v-change-sign = 1
     1843       .
     1844     end.
     1845     else do:
     1846       assign
     1847         v-change-sign = -1
     1848       .
     1849     end.
     1850     assign
     1851       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1852     .
     1853     if p-change-value = 0
     1854     then do:
     1855       run diasize_position-resize-button in this-procedure .
     1856       return .
     1857     end.
     1858     move_block:
     1859     do
     1860     on error undo move_block, retry move_block
     1861     :
     1862       if retry
     1863       then do:
     1864         do
     1865         on error undo move_block, leave move_block
     1866         :
     1867           if p-change-value > 0
     1868           then do:
     1869             for each buf_temp-diasize-handle
     1870             on error undo, next
     1871             :
     1872               assign
     1873                 v-object-handle = buf_temp-diasize-handle.handle-value
     1874               .
     1875               if v-object-handle <> v-diasize-resize-button
     1876               then do:
     1877                 assign
     1878                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1879                 .
     1880               end.
     1881             end.
     1882             assign
     1883               v-diasize-browse-handle :height = v-browse-height
     1884             .
     1885             for each buf_temp-browse-handle
     1886               where buf_temp-browse-handle.browse-type = 'height':u
     1887             on error undo, next
     1888             :
     1889               assign
     1890                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1891               .
     1892             end.
     1893             assign
     1894               frame Dialog-Frame :height = v-frame-height
     1895             .
     1896             if frame Dialog-Frame :scrollable = true
     1897             then do:
     1898               assign
     1899                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1900               .
     1901             end.
     1902             run diasize_position-resize-button in this-procedure .
     1903           end.
     1904           else do:
     1905             if frame Dialog-Frame :scrollable = true
     1906             then do:
     1907               assign
     1908                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1909               .
     1910             end.
     1911             assign
     1912               frame Dialog-Frame :height = v-frame-height
     1913             .
     1914             assign
     1915               v-diasize-browse-handle :height = v-browse-height
     1916             .
     1917             for each buf_temp-browse-handle
     1918               where buf_temp-browse-handle.browse-type = 'height':u
     1919             on error undo, next
     1920             :
     1921               assign
     1922                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1923               .
     1924             end.
     1925             for each buf_temp-diasize-handle
     1926             on error undo, next
     1927             :
     1928               assign
     1929                 v-object-handle = buf_temp-diasize-handle.handle-value
     1930               .
     1931               if v-object-handle <> v-diasize-resize-button
     1932               then do:
     1933                 assign
     1934                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1935                 .
     1936               end.
     1937             end.
     1938             run diasize_position-resize-button in this-procedure .
     1939           end.
     1940           assign
     1941             v-diasize-change-size = false
     1942           .
     1943           leave move_block .
     1944         end.
     1945       end.
     1946       assign
     1947         v-diasize-need-full-display = true
     1948       .
     1949       if v-diasize-change-size = false
     1950       then do:
     1951         assign
     1952           v-diasize-change-size = true
     1953         .
     1954       end.
     1955       else do:
     1956         return .
     1957       end.
     1958       assign
     1959         v-frame-height = frame Dialog-Frame :height
     1960         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1961         v-browse-height = v-diasize-browse-handle :height
     1962       .
     1963       for each buf_temp-browse-handle
     1964         where buf_temp-browse-handle.browse-type = 'height':u
     1965       :
     1966         assign
     1967           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1968         .
     1969       end.
     1970       for each buf_temp-diasize-handle
     1971       :
     1972         delete buf_temp-diasize-handle .
     1973       end.
     1974       assign
     1975         v-field-group-handle = frame Dialog-Frame :first-child
     1976       .
     1977       do while valid-handle(v-field-group-handle)
     1978       :
     1979         assign
     1980           v-object-handle = v-field-group-handle :first-child
     1981         .
     1982         do while valid-handle(v-object-handle)
     1983         :
     1984           if  v-object-handle <> v-diasize-browse-handle :handle
     1985           and can-query(v-object-handle, "row")
     1986           and can-query(v-object-handle, "height")
     1987           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1988           then do:
     1989             find first buf_temp-browse-handle
     1990               where buf_temp-browse-handle.browse-type   = 'height':u
     1991                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1992               no-error .
     1993             if available buf_temp-browse-handle
     1994             then do:
     1995             end.
     1996             else do:
     1997               create buf_temp-diasize-handle .
     1998               assign
     1999                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2000                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2001               .
     2002             end.
     2003           end.
     2004           assign
     2005             v-object-handle = v-object-handle :next-sibling
     2006           .
     2007         end.
     2008         assign
     2009           v-field-group-handle = v-field-group-handle :next-sibling
     2010         .
     2011       end.
     2012       do with frame Dialog-Frame
     2013       :
     2014         hide v-diasize-resize-button .
     2015         assign
     2016           v-diasize-resize-button :row    = 1
     2017           v-diasize-resize-button :column = 1
     2018         .
     2019       end.
     2020       if p-change-value > 0
     2021       then do:
     2022         if frame Dialog-Frame :scrollable = true
     2023         then do:
     2024           assign
     2025             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2026             no-error .
     2027           if error-status :error
     2028           or error-status :get-message(1) <> ""
     2029           then do:
     2030             undo move_block, retry move_block .
     2031           end.
     2032         end.
     2033         assign
     2034           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2035           no-error .
     2036         if error-status :error
     2037         or error-status :get-message(1) <> ""
     2038         then do:
     2039           undo move_block, retry move_block .
     2040         end.
     2041         assign
     2042           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2043           no-error .
     2044         if error-status :error
     2045         or error-status :get-message(1) <> ""
     2046         then do:
     2047           undo move_block, retry move_block .
     2048         end.
     2049         for each buf_temp-browse-handle
     2050           where buf_temp-browse-handle.browse-type = 'height':u
     2051         on error undo move_block, retry move_block
     2052         :
     2053           assign
     2054             buf_temp-browse-handle.browse-handle :height
     2055               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2056             no-error .
     2057           if error-status :error
     2058           or error-status :get-message(1) <> ""
     2059           then do:
     2060             undo move_block, retry move_block .
     2061           end.
     2062         end.
     2063         for each buf_temp-diasize-handle
     2064         on error undo move_block, retry move_block
     2065         :
     2066           assign
     2067             v-object-handle = buf_temp-diasize-handle.handle-value
     2068           .
     2069           if v-object-handle <> v-diasize-resize-button
     2070           then do:
     2071             assign
     2072               v-object-handle :row = v-object-handle :row + p-change-value
     2073               no-error .
     2074             if error-status :error
     2075             or error-status :get-message(1) <> ""
     2076             then do:
     2077               undo move_block, retry move_block .
     2078             end.
     2079           end.
     2080         end.
     2081       end.
     2082       else do:
     2083         for each buf_temp-diasize-handle
     2084         on error undo move_block, retry move_block
     2085         :
     2086           assign
     2087             v-object-handle = buf_temp-diasize-handle.handle-value
     2088           .
     2089           if v-object-handle <> v-diasize-resize-button
     2090           then do:
     2091             assign
     2092               v-object-handle :row = v-object-handle :row + p-change-value
     2093               no-error .
     2094             if error-status :error
     2095             or error-status :get-message(1) <> ""
     2096             then do:
     2097               undo move_block, retry move_block .
     2098             end.
     2099           end.
     2100         end.
     2101         assign
     2102           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2103           no-error .
     2104         if error-status :error
     2105         or error-status :get-message(1) <> ""
     2106         then do:
     2107           undo move_block, retry move_block .
     2108         end.
     2109         for each buf_temp-browse-handle
     2110           where buf_temp-browse-handle.browse-type = 'height':u
     2111         on error undo move_block, retry move_block
     2112         :
     2113           assign
     2114             buf_temp-browse-handle.browse-handle :height
     2115               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2116             no-error .
     2117           if error-status :error
     2118           or error-status :get-message(1) <> ""
     2119           then do:
     2120             undo move_block, retry move_block .
     2121           end.
     2122         end.
     2123         assign
     2124           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2125           no-error .
     2126         if error-status :error
     2127         or error-status :get-message(1) <> ""
     2128         then do:
     2129           undo move_block, retry move_block .
     2130         end.
     2131         if frame Dialog-Frame :scrollable = true
     2132         then do:
     2133           assign
     2134             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2135             no-error .
     2136           if error-status :error
     2137           or error-status :get-message(1) <> ""
     2138           then do:
     2139             undo move_block, retry move_block .
     2140           end.
     2141         end.
     2142       end.
     2143       if p-move-resize = true
     2144       then do:
     2145         run diasize_position-resize-button in this-procedure .
     2146       end.
     2147       if v-diasize-wndstore = true
     2148       then do:
     2149         if connected("ub") = true
     2150         then do:
     2151           define variable v-cntxt-db-num        as integer   no-undo .
     2152           define variable v-cntxt-userid        as character no-undo .
     2153           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2154                                             , OUTPUT v-cntxt-userid
     2155                                             ) .
     2156           run gbl/wndsizew.p
     2157             (input  v-cntxt-db-num
     2158             ,input  v-cntxt-userid
     2159             ,input  v-diasize-proc-name
     2160             ,input  'height':u
     2161             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2162             ) .
     2163         end.
     2164       end.
     2165     end.
     2166     assign
     2167       v-diasize-change-size = false
     2168     .
     2169   end procedure.
     2170   procedure diasize_set-height :
     2171     define input  parameter p-new-height  as decimal   no-undo .
     2172     define input  parameter p-move-resize as logical   no-undo .
     2173     do
     2174     on error undo, return error return-value
     2175     :
     2176       run diasize_change-height in this-procedure
     2177         (input  (p-new-height - frame Dialog-Frame :height)
     2178         ,input  p-move-resize
     2179         ) .
     2180     end.
     2181   end procedure.
     2182   procedure diasize_change-width :
     2183     define input  parameter p-change-value as decimal   no-undo .
     2184     define input  parameter p-move-resize  as logical   no-undo .
     2185     define variable v-field-group-handle   as handle    no-undo .
     2186     define variable v-object-handle        as handle    no-undo .
     2187     define variable v-frame-width          as decimal   no-undo .
     2188     define variable v-frame-virtual-width  as decimal   no-undo .
     2189     define variable v-browse-width         as decimal   no-undo .
     2190     define variable v-window-width         as decimal   no-undo .
     2191     define variable v-window-virtual-width as decimal   no-undo .
     2192     define variable v-change-sign          as integer   no-undo .
     2193     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2194     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2195     if p-change-value > 0
     2196     then do:
     2197       if frame Dialog-Frame :width + p-change-value >
     2198           session :width-chars
     2199       then do:
     2200         assign
     2201           p-change-value = session :width-chars - frame Dialog-Frame :width
     2202         .
     2203         if p-change-value <= 0
     2204         then do:
     2205           run diasize_position-resize-button in this-procedure .
     2206           return .
     2207         end.
     2208       end.
     2209     end.
     2210     if p-change-value < 0
     2211     then do:
     2212       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2213       then do:
     2214         assign
     2215           p-change-value = v-diasize-orig-frame-width
     2216                          - frame Dialog-Frame :width
     2217         .
     2218         if p-change-value >= 0
     2219         then do:
     2220           run diasize_position-resize-button in this-procedure .
     2221           return .
     2222         end.
     2223       end.
     2224     end.
     2225     if p-change-value >= 0
     2226     then do:
     2227       assign
     2228         v-change-sign = 1
     2229       .
     2230     end.
     2231     else do:
     2232       assign
     2233         v-change-sign = -1
     2234       .
     2235     end.
     2236     assign
     2237       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2238     .
     2239     if p-change-value = 0
     2240     then do:
     2241       run diasize_position-resize-button in this-procedure .
     2242       return .
     2243     end.
     2244     move_block:
     2245     do
     2246     on error undo move_block, leave move_block
     2247     :
     2248       if retry
     2249       then do:
     2250         do
     2251         on error undo move_block, leave move_block
     2252         :
     2253           if p-change-value > 0
     2254           then do:
     2255             for each buf_temp-diasize-handle
     2256             on error undo, next
     2257             :
     2258               assign
     2259                 v-object-handle = buf_temp-diasize-handle.handle-value
     2260               .
     2261               if v-object-handle <> v-diasize-resize-button
     2262               then do:
     2263                 assign
     2264                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2265                 .
     2266               end.
     2267             end.
     2268             assign
     2269               v-diasize-browse-handle :width = v-browse-width
     2270             .
     2271             for each buf_temp-browse-handle
     2272               where buf_temp-browse-handle.browse-type = 'width':u
     2273             on error undo, next
     2274             :
     2275               assign
     2276                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2277               .
     2278             end.
     2279             assign
     2280               frame Dialog-Frame :width = v-frame-width
     2281             .
     2282             if frame Dialog-Frame :scrollable = true
     2283             then do:
     2284               assign
     2285                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2286               .
     2287             end.
     2288             run diasize_position-resize-button in this-procedure .
     2289           end.
     2290           else do:
     2291             if frame Dialog-Frame :scrollable = true
     2292             then do:
     2293               assign
     2294                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2295               .
     2296             end.
     2297             assign
     2298               frame Dialog-Frame :width = v-frame-width
     2299             .
     2300             for each buf_temp-browse-handle
     2301               where buf_temp-browse-handle.browse-type = 'width':u
     2302             on error undo, next
     2303             :
     2304               assign
     2305                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2306               .
     2307             end.
     2308             assign
     2309               v-diasize-browse-handle :width = v-browse-width
     2310             .
     2311             for each buf_temp-diasize-handle
     2312             on error undo, next
     2313             :
     2314               assign
     2315                 v-object-handle = buf_temp-diasize-handle.handle-value
     2316               .
     2317               if v-object-handle <> v-diasize-resize-button
     2318               then do:
     2319                 assign
     2320                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2321                 .
     2322               end.
     2323             end.
     2324             run diasize_position-resize-button in this-procedure .
     2325           end.
     2326           assign
     2327             v-diasize-change-size = false
     2328           .
     2329           leave move_block .
     2330         end.
     2331       end.
     2332       assign
     2333         v-diasize-need-full-display = true
     2334       .
     2335       if v-diasize-change-size = false
     2336       then do:
     2337         assign
     2338           v-diasize-change-size = true
     2339         .
     2340       end.
     2341       else do:
     2342         return .
     2343       end.
     2344       assign
     2345         v-frame-width = frame Dialog-Frame :width
     2346         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2347         v-browse-width = v-diasize-browse-handle :width
     2348       .
     2349       for each buf_temp-browse-handle
     2350         where buf_temp-browse-handle.browse-type = 'width':u
     2351       :
     2352         assign
     2353           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2354         .
     2355       end.
     2356       for each buf_temp-diasize-handle
     2357       :
     2358         delete buf_temp-diasize-handle .
     2359       end.
     2360       assign
     2361         v-field-group-handle = frame Dialog-Frame :first-child
     2362       .
     2363       do while valid-handle(v-field-group-handle)
     2364       :
     2365         assign
     2366           v-object-handle = v-field-group-handle :first-child
     2367         .
     2368         do while valid-handle(v-object-handle)
     2369         :
     2370           if  v-object-handle <> v-diasize-browse-handle :handle
     2371           and v-object-handle <> v-diasize-resize-button
     2372           and can-query(v-object-handle, "row")
     2373           and can-query(v-object-handle, "height")
     2374           and ( v-object-handle :col + v-object-handle :width
     2375                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2376               )
     2377           then do:
     2378             find first buf_temp-browse-handle
     2379               where buf_temp-browse-handle.browse-type   = 'width':u
     2380                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2381               no-error .
     2382             if available buf_temp-browse-handle
     2383             then do:
     2384             end.
     2385             else do:
     2386               create buf_temp-diasize-handle .
     2387               assign
     2388                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2389                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2390               .
     2391             end.
     2392           end.
     2393           assign
     2394             v-object-handle = v-object-handle :next-sibling
     2395           .
     2396         end.
     2397         assign
     2398           v-field-group-handle = v-field-group-handle :next-sibling
     2399         .
     2400       end.
     2401       do with frame Dialog-Frame
     2402       :
     2403         hide v-diasize-resize-button .
     2404         v-diasize-resize-button :row = 1.
     2405         v-diasize-resize-button :column = 1.
     2406       end.
     2407       if p-change-value > 0
     2408       then do:
     2409         if frame Dialog-Frame :scrollable = true
     2410         then do:
     2411           assign
     2412             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2413             no-error .
     2414           if error-status :error
     2415           or error-status :get-message(1) <> ""
     2416           then do:
     2417             undo move_block, retry move_block.
     2418           end.
     2419         end.
     2420         assign
     2421           frame Dialog-Frame :width = v-frame-width + p-change-value
     2422           no-error .
     2423         if error-status :error
     2424         or error-status :get-message(1) <> ""
     2425         then do:
     2426           undo move_block, retry move_block.
     2427         end.
     2428         assign
     2429           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2430         no-error .
     2431         if error-status :error
     2432         or error-status :get-message(1) <> ""
     2433         then do:
     2434           undo move_block, retry move_block.
     2435         end.
     2436         for each buf_temp-browse-handle
     2437           where buf_temp-browse-handle.browse-type = 'width':u
     2438         on error undo move_block, retry move_block
     2439         :
     2440           assign
     2441             buf_temp-browse-handle.browse-handle :width
     2442               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2443             no-error .
     2444           if error-status :error
     2445           or error-status :get-message(1) <> ""
     2446           then do:
     2447             undo move_block, retry move_block .
     2448           end.
     2449         end.
     2450         for each buf_temp-diasize-handle
     2451         on error undo move_block, retry move_block
     2452         :
     2453           assign
     2454             v-object-handle = buf_temp-diasize-handle.handle-value
     2455           .
     2456           if v-object-handle <> v-diasize-resize-button
     2457           then do:
     2458             assign
     2459               v-object-handle :col = v-object-handle :col + p-change-value
     2460               no-error .
     2461             if error-status :error
     2462             or error-status :get-message(1) <> ""
     2463             then do:
     2464               undo move_block, retry move_block .
     2465             end.
     2466           end.
     2467         end.
     2468       end.
     2469       else do:
     2470         for each buf_temp-diasize-handle
     2471         on error undo move_block, retry move_block
     2472         :
     2473           assign
     2474             v-object-handle = buf_temp-diasize-handle.handle-value
     2475           .
     2476           if v-object-handle <> v-diasize-resize-button
     2477           then do:
     2478             assign
     2479               v-object-handle :col = v-object-handle :col + p-change-value
     2480               no-error .
     2481             if error-status :error
     2482             or error-status :get-message(1) <> ""
     2483             then do:
     2484               undo move_block, retry move_block .
     2485             end.
     2486           end.
     2487         end.
     2488         for each buf_temp-browse-handle
     2489           where buf_temp-browse-handle.browse-type = 'width':u
     2490         on error undo move_block, retry move_block
     2491         :
     2492           assign
     2493             buf_temp-browse-handle.browse-handle :width
     2494               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2495             no-error .
     2496           if error-status :error
     2497           or error-status :get-message(1) <> ""
     2498           then do:
     2499             undo move_block, retry move_block .
     2500           end.
     2501         end.
     2502         assign
     2503           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2504           no-error .
     2505         if error-status :error
     2506         or error-status :get-message(1) <> ""
     2507         then do:
     2508           undo move_block, retry move_block.
     2509         end.
     2510         assign
     2511           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2512         no-error .
     2513         if error-status :error
     2514         or error-status :get-message(1) <> ""
     2515         then do:
     2516           undo move_block, retry move_block.
     2517         end.
     2518         if frame Dialog-Frame :scrollable = true
     2519         then do:
     2520           assign
     2521             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2522           no-error .
     2523           if error-status :error
     2524           or error-status :get-message(1) <> ""
     2525           then do:
     2526             undo move_block, retry move_block.
     2527           end.
     2528         end.
     2529       end.
     2530       if p-move-resize
     2531       then do:
     2532         run diasize_position-resize-button in this-procedure .
     2533       end.
     2534       if v-diasize-wndstore = true
     2535       then do:
     2536         if connected("ub") = true
     2537         then do:
     2538           define variable v-cntxt-db-num        as integer   no-undo .
     2539           define variable v-cntxt-userid        as character no-undo .
     2540           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2541                                             , OUTPUT v-cntxt-userid
     2542                                             ) .
     2543           run gbl/wndsizew.p
     2544             (input  v-cntxt-db-num
     2545             ,input  v-cntxt-userid
     2546             ,input  v-diasize-proc-name
     2547             ,input  'width':u
     2548             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2549             ) .
     2550         end.
     2551       end.
     2552     end.
     2553     assign
     2554       v-diasize-change-size = false
     2555     .
     2556   end procedure.
     2557   procedure diasize_set-width :
     2558     define input  parameter p-new-width  as decimal   no-undo .
     2559     define input  parameter p-move-resize as logical   no-undo .
     2560     do
     2561     on error undo, return error return-value
     2562     :
     2563       run diasize_change-width in this-procedure
     2564         (input  (p-new-width - frame Dialog-Frame :width)
     2565         ,input  p-move-resize
     2566         ) .
     2567     end.
     2568   end procedure.
     2569   procedure diasize_position-resize-button :
     2570     do with frame Dialog-Frame
     2571     :
     2572       hide v-diasize-resize-button .
     2573       assign
     2574         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2575                     - 1
     2576                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2577         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2578                     - 1
     2579                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2580       .
     2581       view v-diasize-resize-button .
     2582     end.
     2583   end procedure.
     2584   on alt-right anywhere
     2585   do:
     2586     run diasize_change-width in this-procedure
     2587       (input 1
     2588       ,input true
     2589       ) .
     2590     return no-apply .
     2591   end.
     2592   on alt-left anywhere
     2593   do:
     2594     run diasize_change-width in this-procedure
     2595       (input -1
     2596       ,input true
     2597       ) .
     2598     return no-apply .
     2599   end.
     2600   on alt-down anywhere
     2601   do:
     2602     run diasize_change-height in this-procedure
     2603       (input 1
     2604       ,input true
     2605       ) .
     2606     return no-apply .
     2607   end.
     2608   on alt-up anywhere
     2609   do:
     2610     run diasize_change-height in this-procedure
     2611       (input -1
     2612       ,input true
     2613       ) .
     2614     return no-apply .
     2615   end.
     2616   on alt-enter of frame Dialog-Frame
     2617   do:
     2618     run diasize_maximize in this-procedure
     2619       (input  ?
     2620       ).
     2621     return no-apply .
     2622   end.
     2623   procedure diasize_end-move :
     2624     do
     2625     on error undo, return error return-value
     2626     :
     2627       define variable v-row-delta as decimal   no-undo .
     2628       define variable v-col-delta as decimal   no-undo .
     2629       define variable v-new-row as decimal   no-undo .
     2630       define variable v-new-col as decimal   no-undo .
     2631       assign
     2632         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2633         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2634       .
     2635       assign
     2636         v-row-delta = v-new-row - frame Dialog-Frame :height
     2637         v-col-delta = v-new-col - frame Dialog-Frame :width
     2638       .
     2639       run diasize_change-height in this-procedure
     2640         (input v-row-delta
     2641         ,input true
     2642         ) .
     2643       run diasize_change-width in this-procedure
     2644         (input v-col-delta
     2645         ,input true
     2646         ) .
     2647     end.
     2648   end procedure.
     2649   procedure diasize_maximize :
     2650     define input  parameter p-action as logical   no-undo .
     2651     do
     2652     on error undo, return error return-value
     2653     :
     2654       if p-action = ?
     2655       then do:
     2656         if v-diasize-need-maximize = true
     2657         then do:
     2658           assign
     2659             p-action = true
     2660           .
     2661         end.
     2662         else do:
     2663           assign
     2664             p-action = false
     2665           .
     2666         end.
     2667       end.
     2668       if p-action = true
     2669       then do:
     2670         run diasize_change-height in this-procedure
     2671           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2672               - frame Dialog-Frame :height-chars
     2673           ,input true
     2674           ) .
     2675         run diasize_change-width in this-procedure
     2676           (input session :width-chars
     2677               - frame Dialog-Frame :width-chars
     2678           ,input true
     2679           ) .
     2680         assign
     2681           v-diasize-need-maximize = false
     2682         .
     2683       end.
     2684       else do:
     2685         run diasize_change-width in this-procedure
     2686           (input v-diasize-orig-frame-width
     2687               - frame Dialog-Frame :width-chars
     2688           ,input true
     2689           ) .
     2690         run diasize_change-height in this-procedure
     2691           (input v-diasize-orig-frame-height
     2692               - frame Dialog-Frame :height-chars
     2693           ,input true
     2694           ) .
     2695         assign
     2696           v-diasize-need-maximize = true
     2697         .
     2698       end.
     2699     end.
     2700   end procedure.
     2701   procedure diasize_restore-orig-size :
     2702     do
     2703     on error undo, return error return-value
     2704     :
     2705       assign
     2706         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2707         v-diasize-current-frame-height = frame Dialog-Frame :height
     2708       .
     2709       run diasize_set-height in this-procedure
     2710         (input  v-diasize-orig-frame-height
     2711         ,input  true
     2712         ) .
     2713       run diasize_set-width in this-procedure
     2714         (input  v-diasize-orig-frame-width
     2715         ,input  true
     2716         ) .
     2717     end.
     2718   end procedure.
     2719   procedure diasize_restore-current-size :
     2720     do
     2721     on error undo, return error return-value
     2722     :
     2723       run diasize_set-height in this-procedure
     2724         (input  v-diasize-current-frame-height
     2725         ,input  true
     2726         ) .
     2727       run diasize_set-width in this-procedure
     2728         (input  v-diasize-current-frame-width
     2729         ,input  true
     2730         ) .
     2731     end.
     2732   end procedure.
     2733   procedure diasize_set-browse-handle :
     2734     define input  parameter p-browse-handle as handle   no-undo .
     2735     define buffer buf_temp-browse-handle for temp-browse-handle .
     2736     do
     2737     on error undo, return error return-value
     2738     :
     2739       assign
     2740         v-diasize-browse-handle = p-browse-handle
     2741       .
     2742       for each buf_temp-browse-handle
     2743       on error undo, return error return-value
     2744       :
     2745         delete buf_temp-browse-handle .
     2746       end.
     2747     end.
     2748   end procedure.
     2749   procedure diasize_add_browse :
     2750     define input  parameter p-browse-type   as character no-undo .
     2751     define input  parameter p-browse-handle as handle    no-undo .
     2752     define buffer buf_temp-browse-handle for temp-browse-handle .
     2753     do
     2754     on error undo, return error return-value
     2755     :
     2756       assign
     2757         v-diasize-browse-number = v-diasize-browse-number + 1
     2758       .
     2759       create buf_temp-browse-handle .
     2760       assign
     2761         buf_temp-browse-handle.browse-type   = p-browse-type
     2762         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2763         buf_temp-browse-handle.browse-handle = p-browse-handle
     2764       .
     2765     end.
     2766   end procedure.
     2767   procedure diasize_init :
     2768     define variable v-default-value    as logical   no-undo .
     2769     define variable v-restore-saved    as logical   no-undo .
     2770     define variable v-resize-value-str as character no-undo .
     2771     do
     2772     on error undo, return error return-value
     2773     :
     2774       do with frame Dialog-Frame
     2775       :
     2776         assign
     2777           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2778           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2779           v-diasize-browse-handle     = browse BR-rcp :handle
     2780         .
     2781         create button v-diasize-resize-button
     2782         assign
     2783           parent        = frame Dialog-Frame :first-child
     2784           label         = "s"
     2785           height-pixels = 16
     2786           width-pixels  = 16
     2787           visible       = true
     2788           sensitive     = true
     2789           movable       = true
     2790           triggers:
     2791             on end-move persistent run diasize_end-move in this-procedure .
     2792           end triggers.
     2793         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2794         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2795         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2796         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2797         assign
     2798           v-diasize-wndmax = false
     2799         .
     2800         if connected("ub") = true
     2801         then do:
     2802           define variable v-cntxt-db-num        as integer   no-undo .
     2803           define variable v-cntxt-userid        as character no-undo .
     2804           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2805                                             , OUTPUT v-cntxt-userid
     2806                                             ) .
     2807           run gbl/wndpar_r.p
     2808             (input  v-cntxt-db-num
     2809             ,input  v-cntxt-userid
     2810             ,input  'wndmax':U
     2811             ,output v-diasize-wndmax
     2812             ,output v-default-value
     2813             ) .
     2814         end.
     2815         assign
     2816           v-diasize-wndstore = false
     2817         .
     2818         if connected("ub") = true
     2819         then do:
     2820           run gbl/wndpar_r.p
     2821             (input  v-cntxt-db-num
     2822             ,input  v-cntxt-userid
     2823             ,input  'wndstore':U
     2824             ,output v-diasize-wndstore
     2825             ,output v-default-value
     2826             ) .
     2827         end.
     2828         assign
     2829           v-diasize-proc-name = entry(1, program-name(2), '.')
     2830         .
     2831         if v-diasize-wndstore = true
     2832         then do:
     2833           assign
     2834             v-restore-saved = false
     2835           .
     2836           if connected("ub") = true
     2837           then do:
     2838             run gbl/wndsizer.p
     2839               (input  v-cntxt-db-num
     2840               ,input  v-cntxt-userid
     2841               ,input  v-diasize-proc-name
     2842               ,input  'height':u
     2843               ,output v-resize-value-str
     2844               ) .
     2845             if v-resize-value-str <> '':U
     2846             then do:
     2847               run diasize_change-height in this-procedure
     2848                 (input  integer(v-resize-value-str)
     2849                 ,input  true
     2850                 ) .
     2851               assign
     2852                 v-restore-saved = true
     2853               .
     2854             end.
     2855           end.
     2856           if connected("ub") = true
     2857           then do:
     2858             run gbl/wndsizer.p
     2859               (input  v-cntxt-db-num
     2860               ,input  v-cntxt-userid
     2861               ,input  v-diasize-proc-name
     2862               ,input  'width':u
     2863               ,output v-resize-value-str
     2864               ) .
     2865             if v-resize-value-str <> '':U
     2866             then do:
     2867               run diasize_change-width in this-procedure
     2868                 (input  integer(v-resize-value-str)
     2869                 ,input  true
     2870                 ) .
     2871               assign
     2872                 v-restore-saved = true
     2873               .
     2874             end.
     2875           end.
     2876           if v-restore-saved <> true
     2877           then do:
     2878             if v-diasize-wndmax = true
     2879             then do:
     2880               run diasize_maximize in this-procedure
     2881                 (input  true
     2882                 ) .
     2883             end.
     2884           end.
     2885         end.
     2886         else do:
     2887           if v-diasize-wndmax = true
     2888           then do:
     2889             run diasize_maximize in this-procedure
     2890               (input  true
     2891               ) .
     2892           end.
     2893         end.
     2894       end.
     2895     end.
     2896   end procedure.
     2897   procedure diasize_need-full-display :
     2898     define output parameter p-need-full-display as logical   no-undo .
     2899     do
     2900     on error undo, return error return-value
     2901     :
     2902       assign
     2903         p-need-full-display = v-diasize-need-full-display
     2904       .
     2905       assign
     2906         v-diasize-need-full-display = false
     2907       .
     2908     end.
     2909   end procedure.
     2910   procedure get-context :
     2911      define output parameter p-db-num as integer          no-undo.
     2912      define output parameter p-user-id as character        no-undo.
     2913      define variable v-login               as character    no-undo.
     2914      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2915      define buffer buf_user-login  for ub.user-login .
     2916      do
     2917      on error undo, return error
     2918      :
     2919            FIND FIRST buf_sys-ctrl no-lock.
     2920            ASSIGN
     2921               v-login = USERID("ub")
     2922               p-db-num = buf_sys-ctrl.db-num
     2923            .
     2924            FIND FIRST buf_user-login
     2925                 WHERE buf_user-login.db-num = p-db-num
     2926                   AND buf_user-login.user-login = v-login
     2927                 no-lock
     2928                 no-error
     2929                 .
     2930            IF AVAILABLE buf_user-login
     2931            THEN DO:
     2932               assign
     2933                  p-user-id = buf_user-login.user-id
     2934               .
     2935            END.
     2936      end.
     2937   end procedure.
     2938       run diasize_init in this-procedure .
     2939   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2940   procedure rcps_get-profile-id :
     2941   define output parameter p-local-profile-id as integer no-undo .
     2942   do
     2943   on error undo, return error:
     2944   p-local-profile-id = p-profile-id.
     2945   end.
     2946   end procedure.
     2947   PROCEDURE rcps_fill-table :
     2948   define input parameter p-clear-params as logical no-undo .
     2949   if p-clear-params then do:
     2950   FOR EACH tt-rule-call-param:
     2951       DELETE tt-rule-call-param.
     2952   END.
     2953   end.
     2954    FOR EACH tt0-rule-call-param:
     2955      IF p-mode <> 'ДОБАВЛЕНИЕ':U THEN DO:
     2956        IF p-call-id <> '':U and p-call-id <> tt0-rule-call-param.call_id THEN do:
     2957           NEXT.
     2958        end.
     2959        IF p-codex-id <> 0 and p-codex-id <> tt0-rule-call-param.codex_id THEN do:
     2960          NEXT.
     2961        end.
     2962        IF p-ruleset-id <> 0 and p-ruleset-id <> tt0-rule-call-param.ruleset_id THEN do:
     2963          NEXT.
     2964        end.
     2965        IF p-rule-id <> 0 and p-rule-id <> tt0-rule-call-param.RULE_id THEN do:
     2966          NEXT.
     2967        end.
     2968        IF p-order-id <> ? and p-order-id <> tt0-rule-call-param.order_id THEN do:
     2969          NEXT.
     2970        end.
     2971      END.
     2972      if lookup("hidden", tt0-rule-call-param.param-3-data-type) > 0 then do:
     2973        next.
     2974      end.
     2975      IF p-list-mode = 'rp-rule-param':U
     2976      or p-list-mode = 'rp-rule-param':U  + chr(44) + 'все':U
     2977      THEN DO:
     2978         IF p-profile-id <> 0 AND p-profile-id <> tt0-rule-call-param.profile_id THEN do:
     2979           NEXT.
     2980         end.
     2981         IF p-once-more <> ? AND p-once-more <> tt0-rule-call-param.once-more THEN do:
     2982           NEXT.
     2983         end.
     2984      END.
     2985      CREATE tt-rule-call-param.
     2986      BUFFER-COPY tt0-rule-call-param TO tt-rule-call-param.
     2987   END.
     2988   END PROCEDURE.
     2989   procedure rcps_get-value :
     2990   DEFINE INPUT PARAMETER p-profile-id AS integer NO-UNDO.
     2991   DEFINE INPUT PARAMETER p-once-more AS integer NO-UNDO.
     2992   DEFINE INPUT PARAMETER p-call-id AS CHARACTER NO-UNDO.
     2993   DEFINE INPUT PARAMETER p-rp-param-name AS CHARACTER NO-UNDO.
     2994   DEFINE INPUT-output PARAMETER pp-index AS integer NO-UNDO.
     2995   DEFINE output parameter p-value-character AS CHARACTER NO-UNDO.
     2996   DEFINE output parameter p-value-date AS date NO-UNDO.
     2997   DEFINE output parameter p-value-decimal AS decimal NO-UNDO.
     2998   DEFINE output parameter p-value-integer AS integer NO-UNDO.
     2999   DEFINE output parameter p-value-logical AS logical NO-UNDO.
     3000   define variable v-current-index as integer no-undo init -1.
     3001   define variable v-start as logical no-undo init yes.
     3002   DEFINE BUFFER buf_ruledict-param FOR ub.ruledict-param.
     3003   DEFINE BUFFER buf_rp-rule-param FOR ub.rp-rule-param.
     3004   DEFINE BUFFER buf_tt-rule-call-param FOR tt-rule-call-param.
     3005   DEFINE BUFFER buf_term_tt-rule-call-param FOR tt-rule-call-param.
     3006   do
     3007   on error undo, return error
     3008   :
     3009   FOR FIRST buf_rp-rule-param WHERE
     3010         buf_rp-rule-param.profile_id = p-profile-id
     3011     AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     3012   , each buf_tt-rule-call-param WHERE
     3013      buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3014   AND buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3015   AND buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3016   AND buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     3017   AND buf_tt-rule-call-param.p-index >= pp-index
     3018    ,each buf_term_tt-rule-call-param where
     3019          buf_term_tt-rule-call-param.call_id = buf_tt-rule-call-param.call_id
     3020      and buf_term_tt-rule-call-param.codex_id = buf_tt-rule-call-param.codex_id
     3021      and buf_term_tt-rule-call-param.ruleset_id = buf_tt-rule-call-param.ruleset_id
     3022      and buf_term_tt-rule-call-param.order_id = buf_tt-rule-call-param.order_id
     3023      and buf_term_tt-rule-call-param.param-name = buf_tt-rule-call-param.param-name
     3024      and buf_term_tt-rule-call-param.p-index = buf_tt-rule-call-param.p-index
     3025     by buf_term_tt-rule-call-param.call_id
     3026     by buf_term_tt-rule-call-param.codex_id
     3027     by buf_term_tt-rule-call-param.ruleset_id
     3028     by buf_term_tt-rule-call-param.order_id
     3029     by buf_term_tt-rule-call-param.param-name
     3030     by buf_term_tt-rule-call-param.p-index :
     3031       if v-start
     3032       then do:
     3033         assign
     3034         pp-index = buf_term_tt-rule-call-param.p-index
     3035         p-value-character = buf_term_tt-rule-call-param.param-value-character
     3036         p-value-date      = buf_term_tt-rule-call-param.param-value-date
     3037         p-value-decimal   = buf_term_tt-rule-call-param.param-value-decimal
     3038         p-value-integer   = buf_term_tt-rule-call-param.param-value-integer
     3039         p-value-logical   = buf_term_tt-rule-call-param.param-value-logical
     3040         v-start = no
     3041         .
     3042       end.
     3043       else do:
     3044         if buf_term_tt-rule-call-param.p-index > pp-index then do:
     3045           v-current-index = buf_term_tt-rule-call-param.p-index.
     3046           leave.
     3047         end.
     3048             end.
     3049     end.
     3050     pp-index = v-current-index.
     3051   end.
     3052   end procedure.
     3053   PROCEDURE rcps_proc-b-add :
     3054   DEFINE INPUT PARAMETER p-profile-id AS integer NO-UNDO.
     3055   DEFINE INPUT PARAMETER p-once-more AS integer NO-UNDO.
     3056   DEFINE INPUT PARAMETER p-call-id AS CHARACTER NO-UNDO.
     3057   DEFINE INPUT PARAMETER p-rp-param-name AS CHARACTER NO-UNDO.
     3058   DEFINE INPUT PARAMETER p-index AS integer NO-UNDO.
     3059   define variable v-ind as integer no-undo .
     3060   define buffer buf_tt-rule-call-param for tt-rule-call-param.
     3061   define buffer buf0_tt-rule-call-param for tt-rule-call-param.
     3062   define buffer buf2_tt-rule-call-param for tt-rule-call-param.
     3063   define buffer buf_rp-rule-param for ub.rp-rule-param.
     3064   FOR FIRST buf_rp-rule-param WHERE
     3065             buf_rp-rule-param.profile_id = p-profile-id
     3066         AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     3067       , first buf0_tt-rule-call-param WHERE
     3068          buf0_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3069      AND buf0_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3070      AND buf0_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3071      AND buf0_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name:
     3072     LEAVE.
     3073   END.
     3074   IF NOT AVAILABLE buf0_tt-rule-call-param THEN do:
     3075     BELL.
     3076     RETURN.
     3077   END.
     3078   for each buf_rp-rule-param where
     3079           buf_rp-rule-param.rp-param-name = p-rp-param-name
     3080       and buf_rp-rule-param.profile_id = p-profile-id,
     3081       first buf_tt-rule-call-param where
     3082           buf_tt-rule-call-param.call_id = buf0_tt-rule-call-param.call_id
     3083       and buf_tt-rule-call-param.profile_id = buf_rp-rule-param.profile_id
     3084       and buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3085       and buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3086       and buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3087       and buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     3088       and buf_tt-rule-call-param.once-more = buf0_tt-rule-call-param.once-more
     3089       and buf_tt-rule-call-param.p-index = p-index:
     3090     RETURN.
     3091   END.
     3092   IF lookup("LIST", buf0_tt-rule-call-param.param-3-data-type) = 0
     3093   and lookup("SORTED-LIST", buf0_tt-rule-call-param.param-3-data-type) = 0
     3094   THEN DO:
     3095     BELL.
     3096     RETURN.
     3097   END.
     3098   IF buf0_tt-rule-call-param.p-index <> 0 THEN DO:
     3099     BELL.
     3100     RETURN.
     3101   END.
     3102   find last buf_tt-rule-call-param where
     3103            buf_tt-rule-call-param.call_id = buf0_tt-rule-call-param.call_id
     3104        and buf_tt-rule-call-param.codex_id = buf0_tt-rule-call-param.codex_id
     3105        and buf_tt-rule-call-param.ruleset_id = buf0_tt-rule-call-param.ruleset_id
     3106        and buf_tt-rule-call-param.order_id = buf0_tt-rule-call-param.order_id
     3107        and buf_tt-rule-call-param.param-name = buf0_tt-rule-call-param.param-name no-error .
     3108   if available buf_tt-rule-call-param
     3109   and (lookup("LIST", buf_tt-rule-call-param.param-3-data-type) > 0
     3110        or
     3111        lookup("SORTED-LIST", buf_tt-rule-call-param.param-3-data-type) > 0
     3112        )
     3113   and buf_tt-rule-call-param.p-index > 0 then do:
     3114     v-ind = buf_tt-rule-call-param.p-index.
     3115   end.
     3116   for each buf_rp-rule-param where
     3117           buf_rp-rule-param.rp-param-name = p-rp-param-name
     3118       and buf_rp-rule-param.profile_id = p-profile-id,
     3119       first buf_tt-rule-call-param where
     3120           buf_tt-rule-call-param.call_id = buf0_tt-rule-call-param.call_id
     3121       and buf_tt-rule-call-param.profile_id = buf_rp-rule-param.profile_id
     3122       and buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3123       and buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3124       and buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3125       and buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     3126       and buf_tt-rule-call-param.once-more = buf0_tt-rule-call-param.once-more
     3127       and buf_tt-rule-call-param.p-index = 0
     3128   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3129   on stop   undo, return error substitute( "&1. stop", vss-workfile )
     3130   on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     3131   :
     3132     create buf2_tt-rule-call-param.
     3133     buffer-copy buf_tt-rule-call-param
     3134     except p-index
     3135     to buf2_tt-rule-call-param
     3136     assign
     3137     buf2_tt-rule-call-param.p-index = v-ind + 1
     3138     .
     3139   end.
     3140   END PROCEDURE.
     3141   PROCEDURE rcps_proc-b-del :
     3142   DEFINE INPUT PARAMETER p-profile-id AS integer NO-UNDO.
     3143   DEFINE INPUT PARAMETER p-once-more AS integer NO-UNDO.
     3144   DEFINE INPUT PARAMETER p-call-id AS CHARACTER NO-UNDO.
     3145   DEFINE INPUT PARAMETER p-rp-param-name AS CHARACTER NO-UNDO.
     3146   DEFINE INPUT PARAMETER pp-index AS integer NO-UNDO.
     3147   define variable v-ind as integer no-undo .
     3148   define variable v-once-more as integer no-undo .
     3149   define variable v-call-id as character no-undo .
     3150   define buffer buf0_tt-rule-call-param for tt-rule-call-param.
     3151   define buffer buf_tt-rule-call-param for tt-rule-call-param.
     3152   define buffer buf_rp-rule-param for ub.rp-rule-param.
     3153   if pp-index = 0 then do:
     3154     undo, return error substitute("Нельзя удалять корневой параметр &1 (индекс = 0)", p-rp-param-name).
     3155   end.
     3156   FOR first buf_rp-rule-param WHERE
     3157             buf_rp-rule-param.profile_id = p-profile-id
     3158         AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     3159       , first buf0_tt-rule-call-param WHERE
     3160          buf0_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3161      AND buf0_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3162      AND buf0_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3163      AND buf0_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     3164      AND buf0_tt-rule-call-param.p-index = pp-index
     3165      :
     3166     LEAVE.
     3167   END.
     3168   IF NOT AVAILABLE buf0_tt-rule-call-param THEN do:
     3169     FOR first buf_rp-rule-param WHERE
     3170               buf_rp-rule-param.profile_id = p-profile-id
     3171           AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     3172         , last buf0_tt-rule-call-param WHERE
     3173           buf0_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3174       AND buf0_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3175       AND buf0_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3176       AND buf0_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     3177       AND buf0_tt-rule-call-param.p-index > pp-index :
     3178       leave.
     3179     end.
     3180     IF NOT AVAILABLE buf0_tt-rule-call-param THEN do:
     3181     return "not-found".
     3182     end.
     3183     else do:
     3184       return ''.
     3185     end.
     3186   END.
     3187   IF lookup("LIST", buf0_tt-rule-call-param.param-3-data-type) = 0
     3188   and lookup("SORTED-LIST", buf0_tt-rule-call-param.param-3-data-type) = 0
     3189   THEN DO:
     3190     undo, return error substitute("Можно удалять только параметры типа LIST и SORTED-LIST").
     3191   END.
     3192   IF lookup("READ-ONLY", buf0_tt-rule-call-param.param-3-data-type) > 0 THEN DO:
     3193     undo, return error substitute("Нельзя удалять  параметры типа READ-ONLY").
     3194   END.
     3195   for each buf_rp-rule-param where
     3196           buf_rp-rule-param.rp-param-name = buf_rp-rule-param.rp-param-name
     3197       and buf_rp-rule-param.profile_id = buf_rp-rule-param.profile_id,
     3198       each buf_tt-rule-call-param where
     3199           buf_tt-rule-call-param.call_id = p-call-id
     3200       and buf_tt-rule-call-param.profile_id = buf_rp-rule-param.profile_id
     3201       and buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3202       and buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3203       and buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3204       and buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     3205       and buf_tt-rule-call-param.once-more = p-once-more
     3206       and buf_tt-rule-call-param.p-index = pp-index
     3207   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3208   on stop   undo, return error substitute( "&1. stop", vss-workfile )
     3209   on endkey undo, return error substitute( "&1. endkey", vss-workfile ):
     3210       DELETE buf_tt-rule-call-param.
     3211   end.
     3212   return ''.
     3213   END PROCEDURE.
     3214   PROCEDURE rcps_proc-save0 :
     3215   FOR EACH tt-rule-call-param
     3216   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3217   on stop   undo , return error substitute( "&1. stop", vss-workfile )
     3218   on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     3219   :
     3220      find  FIRST tt0-rule-call-param NO-LOCK WHERE
     3221               tt0-rule-call-param.codex_id = tt-rule-call-param.codex_id
     3222          AND  tt0-rule-call-param.ruleset_id = tt-rule-call-param.ruleset_id
     3223          AND tt0-rule-call-param.call_id = tt-rule-call-param.call_id
     3224          AND tt0-rule-call-param.order_id = tt-rule-call-param.order_id
     3225          AND tt0-rule-call-param.param-name = tt-rule-call-param.param-name
     3226          AND tt0-rule-call-param.p-index = tt-rule-call-param.p-index no-error .
     3227      if not available tt0-rule-call-param
     3228      and (lookup("LIST", tt-rule-call-param.param-3-data-type) > 0
     3229           OR
     3230           lookup("SORTED-LIST", tt-rule-call-param.param-3-data-type) > 0
     3231           )
     3232      and tt-rule-call-param.p-index > 0 then do:
     3233        create tt0-rule-call-param.
     3234      end.
     3235      BUFFER-COPY tt-rule-call-param TO tt0-rule-call-param.
     3236   END.
     3237   FOR EACH tt0-rule-call-param
     3238   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3239   on stop   undo , return error substitute( "&1. stop", vss-workfile )
     3240   on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     3241   :
     3242     if tt0-rule-call-param.p-index = 0 then next.
     3243     if lookup("hidden", tt0-rule-call-param.param-3-data-type) > 0 then next.
     3244     find  FIRST tt-rule-call-param NO-LOCK WHERE
     3245             tt-rule-call-param.codex_id = tt0-rule-call-param.codex_id
     3246         AND tt-rule-call-param.ruleset_id = tt0-rule-call-param.ruleset_id
     3247         AND tt-rule-call-param.call_id = tt0-rule-call-param.call_id
     3248         AND tt-rule-call-param.order_id = tt0-rule-call-param.order_id
     3249         AND tt-rule-call-param.param-name = tt0-rule-call-param.param-name
     3250         AND tt-rule-call-param.p-index = tt0-rule-call-param.p-index no-error .
     3251     if not available tt-rule-call-param
     3252     and (lookup("LIST", tt0-rule-call-param.param-3-data-type) > 0
     3253         OR
     3254         lookup("SORTED-LIST", tt0-rule-call-param.param-3-data-type) > 0
     3255         )
     3256     and tt0-rule-call-param.p-index > 0
     3257     then do:
     3258        IF p-call-id <> '':U and p-call-id <> tt0-rule-call-param.call_id THEN do:
     3259           NEXT.
     3260        end.
     3261        IF p-codex-id <> 0 and p-codex-id <> tt0-rule-call-param.codex_id THEN do:
     3262          NEXT.
     3263        end.
     3264        IF p-ruleset-id <> 0 and p-ruleset-id <> tt0-rule-call-param.ruleset_id THEN do:
     3265          NEXT.
     3266        end.
     3267        IF p-rule-id <> 0 and p-rule-id <> tt0-rule-call-param.RULE_id THEN do:
     3268          NEXT.
     3269        end.
     3270        IF p-order-id <> ? and p-order-id <> tt0-rule-call-param.order_id THEN do:
     3271          NEXT.
     3272        end.
     3273       IF p-list-mode = 'rp-rule-param':U
     3274       or p-list-mode = 'rp-rule-param':U  + chr(44) + 'все':U
     3275       THEN DO:
     3276         IF p-profile-id <> 0 AND p-profile-id <> tt0-rule-call-param.profile_id THEN do:
     3277           NEXT.
     3278         end.
     3279         IF p-once-more <> ? AND p-once-more <> tt0-rule-call-param.once-more THEN do:
     3280           NEXT.
     3281         end.
     3282       end.
     3283       delete tt0-rule-call-param.
     3284     end.
     3285   end.
     3286   END PROCEDURE.
     3287   PROCEDURE rcps_set-value :
     3288   DEFINE INPUT PARAMETER p-profile-id AS integer NO-UNDO.
     3289   DEFINE INPUT PARAMETER p-once-more AS integer NO-UNDO.
     3290   DEFINE INPUT PARAMETER p-call-id AS CHARACTER NO-UNDO.
     3291   DEFINE INPUT PARAMETER p-rp-param-name AS CHARACTER NO-UNDO.
     3292   DEFINE INPUT PARAMETER pp-index AS integer NO-UNDO.
     3293   DEFINE INPUT parameter p-value-character AS CHARACTER NO-UNDO.
     3294   DEFINE INPUT parameter p-value-date AS date NO-UNDO.
     3295   DEFINE INPUT parameter p-value-decimal AS decimal NO-UNDO.
     3296   DEFINE INPUT parameter p-value-integer AS integer NO-UNDO.
     3297   DEFINE INPUT parameter p-value-logical AS logical NO-UNDO.
     3298   DEFINE VARIABLE v-codex-id AS integer NO-UNDO.
     3299   DEFINE VARIABLE v-ruleset-id AS integer NO-UNDO.
     3300   DEFINE VARIABLE v-order-id AS integer NO-UNDO.
     3301   DEFINE VARIABLE V-param-name AS character NO-UNDO.
     3302   define variable v-found as logical no-undo .
     3303   DEFINE BUFFER buf_tt-rule-call-param FOR tt-rule-call-param.
     3304   DEFINE BUFFER buf_rp-rule-param FOR ub.rp-rule-param.
     3305   FOR FIRST buf_rp-rule-param WHERE
     3306             buf_rp-rule-param.profile_id = p-profile-id
     3307         AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     3308       , first buf_tt-rule-call-param WHERE
     3309          buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3310      AND buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3311      AND buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3312      AND buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name:
     3313     ASSIGN
     3314     v-codex-id = buf_tt-rule-call-param.codex_id
     3315     v-ruleset-id = buf_tt-rule-call-param.ruleset_id
     3316     v-order-id = buf_tt-rule-call-param.order_id
     3317     V-PARAM-NAME = buf_tt-rule-call-param.PARAM-NAME
     3318     .
     3319     LEAVE.
     3320   END.
     3321   CASE p-list-mode:
     3322     WHEN 'rp-rule-param':U THEN DO:
     3323       if pp-index > 0
     3324       then do:
     3325         FOR EACH  buf_rp-rule-param NO-LOCK where
     3326             buf_rp-rule-param.profile_id = p-profile-id
     3327             AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     3328             ,EACH buf_tt-rule-call-param WHERE
     3329                 buf_tt-rule-call-param.profile_id = p-profile-id
     3330             AND buf_tt-rule-call-param.once-more = p-once-more
     3331             AND buf_tt-rule-call-param.call_id = p-CALL-id
     3332             AND buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3333             AND buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3334             AND buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3335             AND buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     3336             AND buf_tt-rule-call-param.p-index = pp-index
     3337         ON error undo, return error :
     3338           v-found = yes.
     3339         end.
     3340       end.
     3341       if not v-found then do:
     3342         run rcps_proc-b-add in this-procedure (
     3343                                                  input p-profile-id
     3344                                                 ,input p-once-more
     3345                                                 ,input p-call-id
     3346                                                 ,
     3347                                                  input p-rp-param-name
     3348                                                 ,input pp-index).
     3349       end.
     3350       FOR EACH  buf_rp-rule-param NO-LOCK where
     3351           buf_rp-rule-param.profile_id = p-profile-id
     3352           AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     3353           ,EACH buf_tt-rule-call-param WHERE
     3354               buf_tt-rule-call-param.profile_id = p-profile-id
     3355           AND buf_tt-rule-call-param.once-more = p-once-more
     3356           AND buf_tt-rule-call-param.call_id = p-CALL-id
     3357           AND buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3358           AND buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3359           AND buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3360           AND buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     3361           AND buf_tt-rule-call-param.p-index = pp-index
     3362         ON error undo, return error :
     3363         assign
     3364         buf_tt-rule-call-param.param-value-character = p-value-character
     3365         buf_tt-rule-call-param.param-value-date      = p-value-date
     3366         buf_tt-rule-call-param.param-value-decimal   = p-value-decimal
     3367         buf_tt-rule-call-param.param-value-integer   = p-value-integer
     3368         buf_tt-rule-call-param.param-value-logical   = p-value-logical
     3369         .
     3370       END.
     3371     END.
     3372     WHEN 'rule-call-param':U THEN DO:
     3373       FIND FIRST buf_tt-rule-call-param WHERE
     3374           buf_tt-rule-call-param.call_id = p-call-id
     3375       AND buf_tt-rule-call-param.codex_id = v-codex-id
     3376       AND buf_tt-rule-call-param.ruleset_id = v-ruleset-id
     3377       AND buf_tt-rule-call-param.order_id = v-order-id
     3378       AND buf_tt-rule-call-param.param-name = V-PARAM-NAME
     3379       AND buf_tt-rule-call-param.p-index = pp-index.
     3380       assign
     3381       buf_tt-rule-call-param.param-value-character = p-value-character
     3382       buf_tt-rule-call-param.param-value-date      = p-value-date
     3383       buf_tt-rule-call-param.param-value-decimal   = p-value-decimal
     3384       buf_tt-rule-call-param.param-value-integer   = p-value-integer
     3385       buf_tt-rule-call-param.param-value-logical   = p-value-logical
     3386       .
     3387     END.
     3388   END CASE.
     3389   END PROCEDURE.
     3390   procedure rcps_get-rule-on-off :
     3391   define input parameter p-codex-id as integer no-undo .
     3392   define input parameter p-ruleset-id as integer no-undo .
     3393   define input parameter p-rule-id as integer no-undo .
     3394   define input parameter p-profile-id as integer no-undo .
     3395   define input parameter p-once-more as integer no-undo .
     3396   define output parameter p-on-off as logical no-undo .
     3397   if valid-handle(p-call-handle)
     3398   and lookup("rcpscont_get-rule-on-off", p-call-handle:internal-entries) > 0 then do:
     3399     run rcpscont_get-rule-on-off in p-call-handle (
     3400                                              input p-codex-id
     3401                                             ,input p-ruleset-id
     3402                                             ,input p-rule-id
     3403                                             ,input p-profile-id
     3404                                             ,input p-once-more
     3405                                             ,output p-on-off) no-error.
     3406   end.
     3407   end procedure.
     3408   procedure rcps_set-rule-on-off :
     3409   define input parameter p-codex-id as integer no-undo .
     3410   define input parameter p-ruleset-id as integer no-undo .
     3411   define input parameter p-rule-id as integer no-undo .
     3412   define input parameter p-profile-id as integer no-undo .
     3413   define input parameter p-once-more as integer no-undo .
     3414   define input parameter p-on-off as logical no-undo .
     3415   if valid-handle(p-call-handle)
     3416   and lookup("rcpscont_get-rule-on-off", p-call-handle:internal-entries) > 0 then do:
     3417     run rcpscont_set-rule-on-off in p-call-handle (
     3418                                              input p-codex-id
     3419                                             ,input p-ruleset-id
     3420                                             ,input p-rule-id
     3421                                             ,input p-profile-id
     3422                                             ,input p-once-more
     3423                                             ,input p-on-off) no-error.
     3424   end.
     3425   end procedure.
     3426   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3427   PROCEDURE rcps_MyEnable0 :
     3428   DEFINE VARIABLE v-ii AS INTEGER NO-UNDO.
     3429   DEFINE VARIABLE v-ch0 AS widget-handle NO-UNDO.
     3430   ASSIGN
     3431   term_tt-rule-call-param.param-label:RESIZABLE IN browse br-rcp = YES
     3432   X_rp-rule-param.rp-param-name:RESIZABLE IN browse br-rcp = YES
     3433   .
     3434   ASSIGN
     3435   v-ch0 = br-rcp:FIRST-COLUMN IN FRAME Dialog-Frame.
     3436   REPEAT WHILE valid-handle(v-ch0):
     3437      IF v-ch0:LABEL = "Значение!(строковое)" THEN DO:
     3438        v-ch[1] = v-ch0.
     3439        v-ch0:VISIBLE = NO.
     3440      END.
     3441      IF v-ch0:LABEL = "Значение!(Дата)" THEN DO:
     3442        v-ch[2] = v-ch0.
     3443        v-ch0:VISIBLE = NO.
     3444      END.
     3445      IF v-ch0:LABEL = "Значение!(Десятичное)" THEN DO:
     3446        v-ch[3] = v-ch0.
     3447        v-ch0:VISIBLE = NO.
     3448      END.
     3449      IF v-ch0:LABEL = "Значение!(Целое)" THEN DO:
     3450        v-ch[4] = v-ch0.
     3451        v-ch0:VISIBLE = NO.
     3452      END.
     3453      IF v-ch0:LABEL = "Значение!(Логическое)" THEN DO:
     3454        v-ch[5] = v-ch0.
     3455        v-ch0:VISIBLE = NO.
     3456      END.
     3457      IF v-ch0:LABEL = "Точка вызова" THEN DO:
     3458        v-ch[6] = v-ch0.
     3459      END.
     3460      IF v-ch0:LABEL = "Значение" THEN
     3461      v-ch0:RESIZABLE = YES.
     3462      v-ch0 = v-ch0:NEXT-COLUMN.
     3463   END.
     3464   assign
     3465   X_rp-rule-param.rp-param-name:resizable in browse br-rcp = yes
     3466   term_tt-rule-call-param.param-name:resizable in browse br-rcp = yes
     3467   term_tt-rule-call-param.param-label:resizable in browse br-rcp = yes
     3468   .
     3469   CASE p-list-mode:
     3470     WHEN 'rule-call-param':U THEN DO:
     3471        ASSIGN
     3472        X_rp-rule-param.rp-param-name:VISIBLE IN BROWSE br-rcp = NO
     3473        .
     3474     END.
     3475     WHEN 'rp-rule-param':U
     3476     or
     3477     when 'rp-rule-param':U + chr(44) + 'все':U
     3478     THEN DO:
     3479       assign
     3480       term_tt-rule-call-param.codex_id:VISIBLE IN BROWSE br-rcp = NO
     3481       term_tt-rule-call-param.ruleset_id:VISIBLE IN BROWSE br-rcp = NO
     3482       term_tt-rule-call-param.rule_id:VISIBLE IN BROWSE br-rcp = NO
     3483       term_tt-rule-call-param.order_id:VISIBLE IN BROWSE br-rcp = NO
     3484       term_tt-rule-call-param.param-name:VISIBLE IN BROWSE br-rcp = NO
     3485       term_tt-rule-call-param.param-num:VISIBLE IN BROWSE br-rcp = NO
     3486       .
     3487     END.
     3488   END CASE.
     3489    IF p-call-id <> '':U THEN DO:
     3490      v-ch[6]:VISIBLE = NO.
     3491    END.
     3492     IF p-profile-id <> 0 THEN DO:
     3493      term_tt-rule-call-param.profile_id :VISIBLE IN BROWSE br-rcp= NO.
     3494    END.
     3495     IF p-rule-id <> 0 THEN DO:
     3496      term_tt-rule-call-param.RULE_id :VISIBLE IN BROWSE br-rcp= NO.
     3497    END.
     3498     IF p-once-more <> 0 THEN DO:
     3499      term_tt-rule-call-param.once-more :VISIBLE IN BROWSE br-rcp= NO.
     3500    END.
     3501   END PROCEDURE.
     3502   PROCEDURE rcps_Openbr :
     3503   CASE p-list-mode:
     3504     WHEN 'rp-rule-param':U THEN DO:
     3505         OPEN QUERY br-rcp
     3506         FOR EACH  X_ruledict-param NO-LOCK WHERE X_ruledict-param.entry-id = v-rcps-entry-id
     3507             ,FIRST X_rp-rule-param WHERE
     3508                 X_rp-rule-param.profile_id = p-profile-id
     3509             AND X_rp-rule-param.rp-param-name = X_ruledict-param.param-name
     3510           , first tt-rule-call-param WHERE
     3511              tt-rule-call-param.codex_id = X_rp-rule-param.codex_id
     3512          AND tt-rule-call-param.ruleset_id = X_rp-rule-param.ruleset_id
     3513          AND tt-rule-call-param.rule_id = X_rp-rule-param.rule_id
     3514          AND tt-rule-call-param.param-name = X_rp-rule-param.rule-param-name
     3515            ,each term_tt-rule-call-param where
     3516                  term_tt-rule-call-param.call_id = tt-rule-call-param.call_id
     3517              and term_tt-rule-call-param.codex_id = tt-rule-call-param.codex_id
     3518              and term_tt-rule-call-param.ruleset_id = tt-rule-call-param.ruleset_id
     3519              and term_tt-rule-call-param.order_id = tt-rule-call-param.order_id
     3520              and term_tt-rule-call-param.param-name = tt-rule-call-param.param-name
     3521         BY tt-rule-call-param.call_id
     3522         BY tt-rule-call-param.codex_id
     3523         BY tt-rule-call-param.ruleset_id
     3524         BY tt-rule-call-param.order_id
     3525         BY tt-rule-call-param.param-num.
     3526     END.
     3527   END CASE.
     3528   apply "ENTRY" to br-rcp in frame Dialog-Frame .
     3529   APPLy "VALUE-CHANGED" to br-rcp.
     3530   END PROCEDURE.
     3531   PROCEDURE rcps_proc-b-chg PRIVATE :
     3532   DEFINE VARIABLE v-rec1 AS Rowid NO-UNDO.
     3533   DEFINE VARIABLE v-rec2 AS Rowid NO-UNDO.
     3534   DEFINE VARIABLE v-rec3 AS Rowid NO-UNDO.
     3535   DEFINE VARIABLE v-rec4 AS Rowid NO-UNDO.
     3536   define variable v-param-data-type as character no-undo .
     3537   define variable v-rid-list as character no-undo .
     3538   IF NOT AVAILABLE TERM_tt-rule-call-param  THEN DO:
     3539     RETURN ERROR.
     3540   END.
     3541   ASSIGN
     3542   v-rec1 = rowid(X_ruledict-param)
     3543   v-rec2 = rowid(X_rp-rule-param)
     3544   v-rec3 = Rowid(tt-rule-call-param)
     3545   v-rec4 = Rowid(term_tt-rule-call-param)
     3546   .
     3547   run rcps_openbr in this-procedure .
     3548   REPOSITION br-rcp TO Rowid v-rec1, v-rec2,v-rec3, v-rec4 NO-ERROR.
     3549   IF ERROR-STATUS:ERROR THEN DO:
     3550     REPOSITION br-rcp TO ROW 1 NO-ERROR.
     3551   END.
     3552   APPLY "ENTRY" TO br-rcp in frame Dialog-Frame .
     3553   APPLY "VALUE-CHANGED" TO br-rcp in frame Dialog-Frame .
     3554   END PROCEDURE.
     3555   PROCEDURE rcps_set-row-color :
     3556   DEFINE INPUT PARAMETER p-data-type AS CHARACTER NO-UNDO.
     3557   ASSIGN
     3558   v-ch[1]:FGCOLOR = GREY_COLOR
     3559   v-ch[1]:BGCOLOR = GREY_Color
     3560   v-ch[1]:PFCOLOR = GREY_Color
     3561   v-ch[2]:FGCOLOR = GREY_COLOR
     3562   v-ch[2]:BGCOLOR = GREY_Color
     3563   v-ch[2]:PFCOLOR = GREY_Color
     3564   v-ch[3]:FGCOLOR = GREY_COLOR
     3565   v-ch[3]:BGCOLOR = GREY_Color
     3566   v-ch[3]:PFCOLOR = GREY_Color
     3567   v-ch[4]:FGCOLOR = GREY_COLOR
     3568   v-ch[4]:BGCOLOR = GREY_Color
     3569   v-ch[4]:PFCOLOR = GREY_Color
     3570   v-ch[5]:FGCOLOR = GREY_COLOR
     3571   v-ch[5]:BGCOLOR = GREY_Color
     3572   v-ch[5]:PFCOLOR = GREY_Color
     3573   .
     3574   CASE entry(1, p-data-type):
     3575        WHEN 'character':U THEN DO:
     3576         ASSIGN
     3577         v-ch[1]:FGCOLOR = BLACK_COLOR
     3578         v-ch[1]:BGCOLOR = WHITE_Color.
     3579       END.
     3580       WHEN 'decimal':U THEN DO:
     3581         ASSIGN
     3582         v-ch[3]:FGCOLOR = BLACK_COLOR
     3583         v-ch[3]:BGCOLOR = WHITE_Color.
     3584       END.
     3585       WHEN 'integer':U THEN DO:
     3586         ASSIGN
     3587         v-ch[4]:FGCOLOR = BLACK_COLOR
     3588         v-ch[4]:BGCOLOR = WHITE_Color.
     3589       END.
     3590       WHEN 'date':U THEN DO:
     3591         ASSIGN
     3592         v-ch[2]:FGCOLOR = BLACK_COLOR
     3593         v-ch[2]:BGCOLOR = WHITE_Color.
     3594        END.
     3595        WHEN 'logical':U THEN DO:
     3596          ASSIGN
     3597          v-ch[5]:FGCOLOR = BLACK_COLOR
     3598          v-ch[5]:BGCOLOR = WHITE_Color.
     3599        END.
     3600   END CASE.
     3601   END PROCEDURE.
     3602   MAIN-BLOCK:
     3603   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3604      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3605   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3606     run mainmenu_getcntxt in parparentproc
     3607       (output v-cntxt-db-num
     3608       ,output v-cntxt-userid
     3609       ,output v-cntxt-level
     3610       ,output v-cntxt-host-code-obj
     3611       ,output v-cntxt-obj-type
     3612       ,output v-cntxt-obj-code
     3613       ,output v-cntxt-db-num-obj
     3614       ,output v-cntxt-is-admin
     3615       ) .
     3616      run gbl/dftempl.p ( input 'rp-rule-param':U
     3617                        , output v-dflt-rec) no-error.
     3618       if error-status:error then dO:
     3619         message
     3620         vss-workfile vss-revision vss-description skip
     3621         "Невозможно найти recid template записи в таблице rp-rule-param"
     3622         view-as alert-box error .
     3623         return error.
     3624       end.
     3625       run gbl/dftempl.p ( input 'ruledict-param':U
     3626                         , output v-rp-dflt-rec) no-error.
     3627        if error-status:error then dO:
     3628          message
     3629          vss-workfile vss-revision vss-description skip
     3630          "Невозможно найти recid template записи в таблице ruledict-param"
     3631          view-as alert-box error .
     3632          return error.
     3633        end.
     3634     IF p-list-mode = 'rp-rule-param':U
     3635     THEN DO:
     3636       FIND FIRST buf_rule-profile NO-LOCK WHERE
     3637                 buf_rule-profile.profile_id = p-profile-id.
     3638       run gen-key-rec in this-procedure ( input 'rule-profile':U
     3639                                       ,input buffer buf_rule-profile:handle
     3640                                       ,output v-uniq-key-rec).
     3641       FIND FIRST buf_ruledict NO-LOCK WHERE
     3642                 buf_ruledict.entry-type = 'rule-profile':U
     3643          AND  buf_ruledict.uniq-key-rec = v-uniq-key-rec.
     3644       v-rcps-entry-id = buf_ruledict.entry-id.
     3645     END.
     3646     ELSE DO:
     3647        MESSAGE
     3648        substitute("Неверное значение параметра p-list-mode=&1", p-list-mode)
     3649        VIEW-AS alert-box.
     3650     END.
     3651     if p-call-id begins 'schedule':U then do:
     3652       v-running-mode = yes.
     3653     end.
     3654     RUN rcps_fill-table IN THIS-PROCEDURE ( input yes).
     3655     RUN Myenable in THIS-PROCEDURE.
     3656     WAIT-FOR GO OF FRAME Dialog-Frame.
     3657   END.
     3658   RUN disable_UI.
     3659   PROCEDURE disable_UI :
     3660     HIDE FRAME Dialog-Frame.
     3661   END PROCEDURE.
     3662   PROCEDURE enable_UI :
     3663     DISPLAY rs-r-b t-is-over f-rule-num l-r-b f-dis-rule-name
     3664         WITH FRAME Dialog-Frame.
     3665     ENABLE B-exit b-quit B-Help rs-r-b t-is-over f-rule-num b-dis-rule
     3666            b-lkp-dis-rule BR-rcp
     3667         WITH FRAME Dialog-Frame.
     3668     VIEW FRAME Dialog-Frame.
     3669   END PROCEDURE.
     3670   PROCEDURE MyEnable :
     3671   define variable v-list as character no-undo .
     3672   define variable glog as logical no-undo .
     3673   define variable v-index-id as integer no-undo .
     3674   define variable v-value-character as character no-undo .
     3675   define variable v-value-date as date no-undo .
     3676   define variable v-value-decimal as decimal no-undo .
     3677   define variable v-value-integer as integer no-undo .
     3678   define variable v-value-logical as logical no-undo .
     3679   define variable v-shop-code as integer no-undo .
     3680   define buffer buf_dis-rule for ub.dis-rule.
     3681   run rcps_Myenable0 in this-procedure .
     3682   ASSIGN
     3683   rs-r-b:RADIO-BUTTONS IN FRAME Dialog-Frame =
     3684   'руб.':U + chr(44) + 'rubl':U + chr(44) +
     3685   'вал.':U + chr(44) + 'base':U
     3686   .
     3687   v-index-id = 0.
     3688   RUN rcps_get-value IN THIS-PROCEDURE (
     3689                                    INPUT p-profile-id
     3690                                   ,INPUT p-once-more
     3691                                   ,INPUT p-call-id
     3692                                   ,INPUT "p-is-over"
     3693                                   ,INPUT-output v-index-id
     3694                                   ,output v-value-character
     3695                                   ,output v-value-date
     3696                                   ,output v-value-decimal
     3697                                   ,output v-value-integer
     3698                                   ,output t-is-over
     3699                                   ).
     3700   v-index-id = 0.
     3701   RUN rcps_get-value IN THIS-PROCEDURE (
     3702                                    INPUT p-profile-id
     3703                                   ,INPUT p-once-more
     3704                                   ,INPUT p-call-id
     3705                                   ,INPUT "p-r-b"
     3706                                   ,INPUT-output v-index-id
     3707                                   ,output rs-r-b
     3708                                   ,output v-value-date
     3709                                   ,output v-value-decimal
     3710                                   ,output v-value-integer
     3711                                   ,output v-value-logical
     3712                                   ).
     3713   v-index-id = 0.
     3714   RUN rcps_get-value IN THIS-PROCEDURE (
     3715                                    INPUT p-profile-id
     3716                                   ,INPUT p-once-more
     3717                                   ,INPUT p-call-id
     3718                                   ,INPUT "p-rule-num"
     3719                                   ,INPUT-output v-index-id
     3720                                   ,output v-value-character
     3721                                   ,output v-value-date
     3722                                   ,output v-value-decimal
     3723                                   ,output f-rule-num
     3724                                   ,output v-value-logical
     3725                                   ).
     3726   if f-rule-num > 0 then do:
     3727     find first buf_dis-rule no-lock where
     3728             buf_dis-rule.rule-num = f-rule-num no-error.
     3729   end.
     3730   ASSIGN
     3731   term_tt-rule-call-param.param-label:RESIZABLE IN browse br-rcp = YES
     3732   X_rp-rule-param.rp-param-name:RESIZABLE IN browse br-rcp = YES
     3733   .
     3734   DEFINE VARIABLE v-ch0 AS widget-handle NO-UNDO.
     3735   ASSIGN
     3736   v-ch0 = br-rcp:FIRST-COLUMN IN FRAME Dialog-Frame.
     3737   REPEAT WHILE valid-handle(v-ch0):
     3738      IF v-ch0:LABEL = "Значение!(строковое)" THEN DO:
     3739        v-ch[1] = v-ch0.
     3740        v-ch0:VISIBLE = NO.
     3741      END.
     3742      IF v-ch0:LABEL = "Значение!(Дата)" THEN DO:
     3743        v-ch[2] = v-ch0.
     3744        v-ch0:VISIBLE = NO.
     3745      END.
     3746      IF v-ch0:LABEL = "Значение!(Десятичное)" THEN DO:
     3747        v-ch[3] = v-ch0.
     3748        v-ch0:VISIBLE = NO.
     3749      END.
     3750      IF v-ch0:LABEL = "Значение!(Целое)" THEN DO:
     3751        v-ch[4] = v-ch0.
     3752        v-ch0:VISIBLE = NO.
     3753      END.
     3754      IF v-ch0:LABEL = "Значение!(Логическое)" THEN DO:
     3755        v-ch[5] = v-ch0.
     3756        v-ch0:VISIBLE = NO.
     3757      END.
     3758      IF v-ch0:LABEL = "Точка вызова" THEN DO:
     3759        v-ch[6] = v-ch0.
     3760      END.
     3761      IF v-ch0:LABEL = "Значение" THEN
     3762      v-ch0:RESIZABLE = YES.
     3763      v-ch0 = v-ch0:NEXT-COLUMN.
     3764   END.
     3765   assign
     3766   X_rp-rule-param.rp-param-name:resizable in browse br-rcp = yes
     3767   term_tt-rule-call-param.param-name:resizable in browse br-rcp = yes
     3768   term_tt-rule-call-param.param-label:resizable in browse br-rcp = yes
     3769   .
     3770   CASE p-list-mode:
     3771     WHEN 'rule-call-param':U THEN DO:
     3772        ASSIGN
     3773        X_rp-rule-param.rp-param-name:VISIBLE IN BROWSE br-rcp = NO
     3774        .
     3775     END.
     3776     WHEN 'rp-rule-param':U
     3777     or
     3778     when 'rp-rule-param':U + chr(44) + 'все':U
     3779     THEN DO:
     3780       assign
     3781       term_tt-rule-call-param.codex_id:VISIBLE IN BROWSE br-rcp = NO
     3782       term_tt-rule-call-param.ruleset_id:VISIBLE IN BROWSE br-rcp = NO
     3783       term_tt-rule-call-param.rule_id:VISIBLE IN BROWSE br-rcp = NO
     3784       term_tt-rule-call-param.order_id:VISIBLE IN BROWSE br-rcp = NO
     3785       term_tt-rule-call-param.param-name:VISIBLE IN BROWSE br-rcp = NO
     3786       term_tt-rule-call-param.param-num:VISIBLE IN BROWSE br-rcp = NO
     3787       .
     3788     END.
     3789   END CASE.
     3790    IF p-call-id <> '':U THEN DO:
     3791      v-ch[6]:VISIBLE = NO.
     3792    END.
     3793     IF p-profile-id <> 0 THEN DO:
     3794      term_tt-rule-call-param.profile_id :VISIBLE IN BROWSE br-rcp= NO.
     3795    END.
     3796     IF p-rule-id <> 0 THEN DO:
     3797      term_tt-rule-call-param.RULE_id :VISIBLE IN BROWSE br-rcp= NO.
     3798    END.
     3799     IF p-once-more <> 0 THEN DO:
     3800      term_tt-rule-call-param.once-more :VISIBLE IN BROWSE br-rcp= NO.
     3801   END.
     3802   display
     3803   t-is-over
     3804   rs-r-b
     3805   f-rule-num
     3806   l-r-b
     3807   (if available buf_dis-rule then buf_dis-rule.des else "Не найдено правило скидки!!!") @ f-dis-rule-name
     3808   with frame Dialog-Frame .
     3809   VIEW FRAME Dialog-Frame.
     3810   ENABLE
     3811   rs-r-b WHEN p-mode <> 'ПРОСМОТР':U
     3812   b-dis-rule WHEN p-mode <> 'ПРОСМОТР':U
     3813   t-is-over WHEN p-mode <> 'ПРОСМОТР':U
     3814   B-exit WHEN p-mode <> 'ПРОСМОТР':U
     3815   b-lkp-dis-rule
     3816   b-quit
     3817   WITH FRAME Dialog-Frame.
     3818   VIEW FRAME Dialog-Frame.
     3819   IF p-mode = 'ПРОСМОТР':U THEN DO:
     3820      ASSIGN
     3821      b-quit:COLUMN = 1
     3822      b-quit:LABEL = "&Выход".
     3823      HIDE
     3824      b-exit
     3825      IN FRAME Dialog-Frame.
     3826   END.
     3827   ASSIGN
     3828   FRAME Dialog-Frame:TITLE =
     3829   substitute("Параметры Простого прогрессивного Алгоритма зависимости Сумма накоплений -> % скидки на товар (профайл &1)", p-profile-id).
     3830   END PROCEDURE.
     3831   PROCEDURE proc-save :
     3832   define buffer buf_prop-ref for ub.prop-ref.
     3833   define variable v-ii as integer   no-undo .
     3834   DEFINE VARIABLE v-today as date no-undo .
     3835   DEFINE VARIABLE v-time as integer no-undo .
     3836   v-ii = 0.
     3837   assign
     3838   frame Dialog-Frame
     3839   t-is-over
     3840   f-rule-num
     3841   rs-r-b
     3842   .
     3843   RUN rcps_set-value IN THIS-PROCEDURE (
     3844                                   INPUT p-profile-id
     3845                                   ,INPUT p-once-more
     3846                                   ,INPUT p-call-id
     3847                                   ,INPUT "p-is-over"
     3848                                   ,INPUT 0
     3849                                   ,INPUT ''
     3850                                   ,INPUT ?
     3851                                   ,INPUT 0.0
     3852                                   ,INPUT 0
     3853                                   ,INPUT t-is-over
     3854                                   ).
     3855   RUN rcps_set-value IN THIS-PROCEDURE (
     3856                                   INPUT p-profile-id
     3857                                   ,INPUT p-once-more
     3858                                   ,INPUT p-call-id
     3859                                   ,INPUT "p-r-b"
     3860                                   ,INPUT 0
     3861                                   ,INPUT rs-r-b
     3862                                   ,INPUT ?
     3863                                   ,INPUT 0.0
     3864                                   ,INPUT 0
     3865                                   ,INPUT no
     3866                                   ).
     3867   RUN rcps_set-value IN THIS-PROCEDURE (
     3868                                   INPUT p-profile-id
     3869                                   ,INPUT p-once-more
     3870                                   ,INPUT p-call-id
     3871                                   ,INPUT "p-rule-num"
     3872                                   ,INPUT 0
     3873                                   ,INPUT ''
     3874                                   ,INPUT ?
     3875                                   ,INPUT 0.0
     3876                                   ,INPUT f-rule-num
     3877                                   ,INPUT no
     3878                                   ).
     3879   run rcps_proc-save0 in this-procedure .
     3880   END PROCEDURE.
