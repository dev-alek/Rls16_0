     1468        IMAGE-DOWN FILE "cmp/btn-fnd.bmp":U
     1469        IMAGE-INSENSITIVE FILE "cmp/btn-fnd.bmp":U NO-CONVERT-3D-COLORS
     1470        LABEL ""
     1471        SIZE 3 BY 1 TOOLTIP "Просмотр правила скидки".
     1472   DEFINE BUTTON b-quit AUTO-END-KEY
     1473        LABEL "&Отмена"
     1474        SIZE 10 BY 1
     1475        BGCOLOR 8 .
     1476   DEFINE VARIABLE f-dis-rule-name AS CHARACTER FORMAT "X(256)":U
     1477         VIEW-AS TEXT
     1478        SIZE 98 BY .67
     1479        FGCOLOR 4  NO-UNDO.
     1480   DEFINE VARIABLE f-rule-num AS INTEGER FORMAT ">>>>>>9":U INITIAL 0
     1481        LABEL "Правило зависимости СУММА НАКОПЛЕНИЙ  -> % СКИДКИ по ДК"
     1482        VIEW-AS FILL-IN
     1483        SIZE 16 BY 1 NO-UNDO.
     1484   DEFINE VARIABLE l-r-b AS CHARACTER FORMAT "X(256)":U INITIAL "Расчет вести от:"
     1485         VIEW-AS TEXT
     1486        SIZE 22.5 BY .67 NO-UNDO.
     1487   DEFINE VARIABLE rs-r-b AS CHARACTER
     1488        VIEW-AS RADIO-SET HORIZONTAL
     1489        RADIO-BUTTONS
     1490             "Item 1", "rubl",
     1491   "Item 1", "base"
