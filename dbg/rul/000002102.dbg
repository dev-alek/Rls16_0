     2303     define variable v-agentid           as integer    no-undo .
     2304     define variable v-doc-status        as character  no-undo .
     2305     define variable v-doc-status-old    as character  no-undo .
     2306     define variable v-ext-doc-type          as character  no-undo .
     2307     define variable v-trn-doc-obj-type  as character  no-undo .
     2308     define variable v-trn-doc-obj-code  as integer    no-undo .
     2309     define variable v-obj-db-num        as integer    no-undo .
     2310     define variable v-obj-uniq-key-rec  as character  no-undo .
     2311     define variable v-b-code            as integer    no-undo .
     2312     define variable v-main-b-code       as integer    no-undo .
     2313     define variable v-gds-name-full     as character  no-undo .
     2314     define variable v-node-name         as character  no-undo .
     2315     define variable v-agnt-id           as integer    no-undo .
     2316     define variable v-obj-type          as character  no-undo .
     2317     define variable v-obj-code          as integer    no-undo .
     2318     define variable v-tot-rubl          as decimal    no-undo .
     2319     define variable v-ext-num           as character  no-undo .
     2320     define variable v-table-name        as character  no-undo .
     2321     define variable v-cli-type          as character  no-undo .
     2322     define variable v-cli-code          as integer    no-undo .
     2323     define variable v-cli-id            as integer    no-undo .
     2324     define variable v-obj-id            as integer    no-undo .
     2325     define variable v-from-store-id     as integer    no-undo .
     2326     define variable v-to-store-id       as integer    no-undo .
     2327     define variable v-p-date            as datetime-tz  no-undo .
     2328     define variable v-ext-artic         as character  no-undo .
     2329     define buffer buf_clients for ub.clients.
     2330     define buffer buf_ext-classif for ub.ext-classif.
     2331     define buffer buf_trn-doc for ub.trn-doc .
     2332     define buffer buf_gds-dtl for ub.gds-dtl.
     2333     define buffer buf_doc-line for ub.doc-line.
     2334     define buffer buf_gds-prt for ub.gds-prt.
     2335     define buffer buf_goods for ub.goods.
     2336     define buffer buf_ext-artic for ub.ext-artic.
     2337     define buffer buf_ext-system for ub.ext-system.
     2338     define variable expObj as class expsubject no-undo .
     2339     define variable subDocObj as class iexpsubject no-undo .
     2340     if v-has-newbh then do:
     2341       v-trn-doc-obj-type = v-newbh::obj-type.
     2342       v-trn-doc-obj-code = v-newbh::obj-code.
     2343       v-doc-code = v-newbh:buffer-field("doc-code"):buffer-value.
     2344       v-obj-type = v-newbh:buffer-field("obj-type"):buffer-value.
     2345       v-obj-code = v-newbh:buffer-field("obj-code"):buffer-value.
     2346       v-cli-type = v-newbh:buffer-field("cli-type"):buffer-value.
     2347       v-cli-code = v-newbh:buffer-field("cli-code"):buffer-value.
     2348       v-tot-rubl = v-newbh:buffer-field("tot-rubl"):buffer-value.
     2349       v-ext-doc-type = v-newbh:buffer-field("ext-doc-type"):buffer-value.
     2350       v-p-date = v-newbh:buffer-field("doc-date"):buffer-value.
     2351     end.
     2352     else do:
     2353       v-trn-doc-obj-type = v-oldbh::obj-type.
     2354       v-trn-doc-obj-code = v-oldbh::obj-code.
     2355       v-doc-code = v-oldbh:buffer-field("doc-code"):buffer-value.
     2356       v-obj-type = v-oldbh:buffer-field("obj-type"):buffer-value.
     2357       v-obj-code = v-oldbh:buffer-field("obj-code"):buffer-value.
     2358       v-tot-rubl = v-oldbh:buffer-field("tot-rubl"):buffer-value.
     2359       v-ext-doc-type = v-oldbh:buffer-field("ext-doc-type"):buffer-value.
     2360       v-p-date = v-oldbh:buffer-field("doc-date"):buffer-value.
     2361     end.
     2362     if v-has-newbh
     2363     then do:
     2364       v-doc-status = v-newbh:buffer-field("status_"):buffer-value.
     2365     end.
     2366     v-doc-status-old = v-oldbh:buffer-field("status_"):buffer-value.
     2367     if not (v-doc-status-old = 'факт':U and not v-has-newbh) and (v-doc-status = v-doc-status-old or not v-doc-status = 'факт':U)
     2368       then return.
     2369     IF  context_begin-esys-command( input string(v-esys-id-list), input-output v-esys-cmd-proc-handle, output v-esys-cmd-code) = false  THEN do:
     2370       undo _main, return error v-last-error-message .
     2371     end.
     2372     case v-ext-doc-type:
     2373       when 'ie':U or
     2374       when 'ee':U or
     2375       when 'ep':U or
     2376       when 'we':U or
     2377       when 'ev':U or
     2378       when 'iv':U or
     2379       when 'rv':U or
     2380       when 're':U
     2381       then do:
     2382         subDocObj = new trn-gd-doc ().
     2383         cast (subDocObj, trn-gd-doc):BufTableHndlNew = v-newbh.
     2384         cast (subDocObj, trn-gd-doc):BufTableHndlOld = v-oldbh.
     2385       end.
     2386       when 'vt':U
     2387       then do:
     2388         subDocObj = new inv-gd-doc ().
     2389         cast (subDocObj, inv-gd-doc):BufTableHndlNew = v-newbh.
     2390         cast (subDocObj, inv-gd-doc):BufTableHndlOld = v-oldbh.
     2391       end.
     2392       when 'vp':U
     2393       then do:
     2394         subDocObj = new peres-gd-doc ().
     2395         cast (subDocObj, peres-gd-doc):BufTableHndlNew = v-newbh.
     2396         cast (subDocObj, peres-gd-doc):BufTableHndlOld = v-oldbh.
     2397       end.
     2398       otherwise do:
     2399         return.
     2400       end.
     2401     end case.
     2402     expObj = new expsubject ().
     2403     expObj:GetContent(subDocObj) no-error.
     2404     if error-status:error then
     2405     do:
     2406       undo _main, return error expObj:Msg .
     2407     end.
     2408     IF ExpData1:esys-add-dump-data ( INPUT expObj:Data,
     2409                                      INPUT v-esys-cmd-proc-handle,
     2410                                      INPUT v-esys-cmd-code,
     2411                                      '+update' + chr(4) + expObj:InitSecTag +
     2412                                      (if expObj:sendTableName <> ""
     2413                                             then substitute("&1&2&3&4",chr(4),
     2414                                                             expObj:sendTableName,
     2415                                                             if expObj:sendOldRowid <> ? then substitute("&1&2",chr(3),expObj:sendOldRowid) else "",
     2416                                                             if expObj:sendNewRowid <> ? then substitute("&1&2",chr(3),expObj:sendNewRowid) else "")
     2417                                       else "")) = false  THEN do:
     2418       undo _main, return error v-last-error-message .
     2419     end.
     2420     IF  context_set-custom-esys-pck-name(  input v-esys-cmd-proc-handle, input v-esys-cmd-code, input v-custom-pack-name) = false  THEN do:
     2421       undo _main, return error v-last-error-message .
     2422     end.
     2423     v-dump-ord-int64 = context_send-esys-command( input v-esys-id-list
     2424                                 , input v-esys-cmd-proc-handle
     2425                                 , input v-esys-cmd-code
     2426                                 , input g#userid).
     2427     if v-dump-ord-int64 = 0 THEN do:
     2428       undo _main, return error v-last-error-message .
     2429     end.
     2430       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute( "Успешно. " + subDocObj:Msg)).
     2431     num-rec-ok = num-rec-ok + 1.
     2432       ExpData1:Route-data_clear-data ( ) .
     2433     delete object subDocObj no-error .
     2434   end.
     2435   end procedure.
     2436   procedure load-ruleset-context :
     2437   define input parameter p-ruleset-id as integer    no-undo .
     2438   define variable v-flag              as logical    no-undo .
     2439   define variable v-ii                as integer    no-undo .
     2440   define variable v-changes-list2     as character  no-undo .
     2441   define variable v-obj-db-num        as integer    no-undo .
     2442   define variable v-is-waiting-status as logical    no-undo .
     2443   define variable v-direction         as character  no-undo .
     2444   define variable v-direction-2       as character  no-undo .
     2445   define variable v-waiting-status    as character  no-undo .
     2446   define variable v-ext-doc-type      as character  no-undo .
     2447   define buffer buf_rule-call-param for ub.rule-call-param.
     2448   define buffer buf_ext-system for ub.ext-system.
     2449   define buffer buf_clients for ub.clients.
     2450   do
     2451   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2452   on stop   undo, return error substitute( "&1. stop", vss-workfile )
     2453   on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     2454   :
     2455     assign
     2456       v-oldbh = widget-handle (entry(2, p-doc-code, chr(4)))
     2457       v-newbh = widget-handle (entry(3, p-doc-code, chr(4)))
     2458       v-changes-list = entry(4, p-doc-code, chr(4))
     2459       file-name  = p-process-file-name
     2460       v-has-oldbh = valid-handle(v-oldbh) and v-oldbh:available
     2461       v-has-newbh = valid-handle(v-newbh) and v-newbh:available
     2462     .
     2463     if not v-has-newbh
     2464     and not v-has-oldbh then do:
     2465       undo, return error substitute("Не определено ни одного буфера - ни старый, ни новый").
     2466     end.
     2467     if not v-has-oldbh
     2468     and v-changes-list  = '' then do:
     2469        undo, return error substitute("Не определен старый буфер и список изменений").
     2470     end.
     2471     case p-ruleset-id:
     2472       when 115 then do:
     2473         if v-has-newbh
     2474         and v-newbh:table <> 'trn-doc':U then do:
     2475           undo, return error substitute("Передан неверный буфер вместо буфера для &1",  'trn-doc':U).
     2476         end.
     2477       end.
     2478       otherwise do:
     2479         undo, return error substitute("Неверный вызов &1 для набора правил &2", vss-workfile , p-ruleset-id).
     2480       end.
     2481     end case.
     2482     assign
     2483       v-ext-doc-type = v-oldbh:buffer-field("ext-doc-type"):buffer-value.
     2484     .
     2485       if num-entries(v-direction, chr(4)) > 1 then do:
     2486       v-direction-2 = entry(2, v-direction, chr(4)).
     2487       v-direction = entry(1, v-direction, chr(4)).
     2488       if v-direction-2 <> "to"
     2489       and v-direction-2 <> "from" then return "return".
     2490       if v-direction = '<открытие документа>':U
     2491       and v-direction-2 = "to" then return "return".
     2492     end.
     2493     if v-direction = '<открытие документа>':U
     2494     or v-direction = 'удаление':U
     2495     or (v-direction = '<закрытие документа>':U and v-newbh::status_ = 'факт':U )
     2496     then do:
     2497       v-action = 'D':U.
     2498     end.
     2499     else do:
     2500       v-action = 'U':U.
     2501     end.
     2502     for each buf_rule-call-param no-lock where
     2503     buf_rule-call-param.codex_id = p-codex-id
     2504     and buf_rule-call-param.ruleset_id = p-ruleset-id
     2505     and buf_rule-call-param.call_id = p-call-id
     2506     and buf_rule-call-param.order_id = p-order-id
     2507     and buf_rule-call-param.rule_id = p-rule-id
     2508     and buf_rule-call-param.param-name = "p-esys-id",
     2509       first buf_ext-system no-lock where
     2510             buf_Ext-system.esys-id = buf_rule-call-param.param-value-integer
     2511         and buf_Ext-system.db-num = 0
     2512         and buf_Ext-system.esys-have-export = yes
     2513         and buf_Ext-system.esys-db-num-exp = g#db-num:
     2514       v-esys-id-list = v-esys-id-list + (if v-esys-id-list = '' then '' else chr(1)) + string(buf_ext-system.esys-id).
     2515     end.
     2516     if v-esys-id-list = '' then return "return".
     2517     find first buf_rule-call-param no-lock where
     2518   buf_rule-call-param.codex_id = p-codex-id
     2519   and buf_rule-call-param.ruleset_id = p-ruleset-id
     2520   and buf_rule-call-param.call_id = p-call-id
     2521   and buf_rule-call-param.order_id = p-order-id
     2522   and buf_rule-call-param.rule_id = p-rule-id
     2523   and buf_rule-call-param.param-name = "p-xsd-file"
     2524    no-error.
     2525   if available buf_rule-call-param then do:
     2526     assign p-xsd-file = buf_rule-call-param.param-value-character.
     2527   end.
     2528   end.
     2529   end procedure.
