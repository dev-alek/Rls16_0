       95   define   shared variable g#auto as logical no-undo.
       96   define   shared variable g#news as logical no-undo.
       97   define   shared variable g#oxml as logical no-undo.
       98   define   shared variable g#esys as logical no-undo.
       99   define   shared variable g#news-source-db as integer no-undo.
      100   define   shared variable g#esys-source-esys as integer no-undo.
      101   define   shared variable g#db-num as integer   no-undo .
      102   define   shared variable g#userid as character no-undo .
      103   define   shared variable g#passwd as character no-undo .
      104   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      105   define  variable garbcoll_ii as integer no-undo .
      106   define  temp-table temp-gc no-undo
      107   field ii as integer
      108   field obj-r as handle
      109   field cn as character
      110   index pi is unique primary
      111   ii
      112   index icn
      113   cn.
      114   procedure garbcoll_create-gc-entry :
      115   define input parameter p-cn as character no-undo .
      116   define input parameter p-obj-r as handle no-undo .
      117     do
      118     on error undo, return error
      119     :
      120       create temp-gc.
      121       assign
      122       temp-gc.ii = garbcoll_ii
      123       garbcoll_ii = garbcoll_ii + 1
      124       temp-gc.cn = p-cn
      125       temp-gc.obj-r = p-obj-r
      126       .
      127     end.
      128   end procedure.
      129   procedure garbcoll_clear :
      130     do
      131     on error undo, return error
      132     :
      133       for each temp-gc:
      134         delete object temp-gc.obj-r.
      135         delete temp-gc.
      136       end.
      137     end.
      138   end procedure.
      139   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      140   procedure cur-time :
      141      define output parameter p-today as date      no-undo .
      142      define output parameter p-time  as integer   no-undo .
      143     do
      144     on error undo, return error
      145     :
      146       define variable v-date1 as date      no-undo .
      147       define variable v-date2 as date      no-undo .
      148       define variable v-time  as integer   no-undo .
      149       assign
      150         v-date1 = today
      151         v-time  = time
      152         v-date2 = today
      153       .
      154       if v-date1 <> v-date2
      155       then do:
      156         assign
      157           v-date1 = today
      158           v-time  = v-time
      159         .
      160       end.
      161       assign
      162         p-today = v-date1
      163         p-time  = v-time
      164       .
      165     end.
      166   end.
      167   function cur-time-date returns character
      168   :
      169     return string(today, '99/99/9999':U) .
      170   end.
      171   function cur-time-mjd returns decimal
      172   :
      173     define variable v-date as date      no-undo .
      174     define variable v-time as integer   no-undo .
      175     run cur-time in this-procedure
      176       (output v-date
      177       ,output v-time
      178       ) .
      179     return integer(v-date) - 2400002 + (v-time / 86400) .
      180   end.
      181   function cur-time-get-ending-index returns integer
      182   (input p-number as integer
      183   )
      184   :
      185     if p-number < 0
      186     or p-number = ?
      187     then do:
      188       return 1 .
      189     end.
      190     define variable v-rest as integer   no-undo .
      191     assign
      192       p-number = p-number modulo 100
      193     .
      194     if p-number < 20
      195     then do:
      196       assign
      197         v-rest = p-number
      198       .
      199     end.
      200     else do:
      201       assign
      202         v-rest = p-number modulo 10
      203       .
      204     end.
      205     case v-rest :
      206       when 1
      207       then do:
      208         return 2 .
      209       end.
      210       when 2 or
      211       when 3 or
      212       when 4
      213       then do:
      214         return 3 .
      215       end.
      216       otherwise do:
      217         return 1 .
      218       end.
      219     end case .
      220   end.
      221   procedure cur-time-mjd-to-date :
      222      define input  parameter i-mjd-diff as decimal no-undo.
      223      define output parameter o-Date     as date    no-undo.
      224      define output parameter o-Time     as integer no-undo.
      225      define variable v-day-number as integer   no-undo .
      226      if    i-mjd-diff < 0
      227         or i-mjd-diff = ?
      228      then do:
      229         return "?" .
      230      end.
      231      assign
      232         v-day-number = truncate(i-mjd-diff,0).
      233         o-Date = date(v-day-number + 2400002).
      234         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      235     .
      236   end.
      237   function cur-time-mjd-to-string returns character
      238   (input p-mjd-diff as decimal
      239   )
      240   :
      241     define variable v-day-number as integer   no-undo .
      242     define variable v-seconds    as integer   no-undo .
      243     define variable v-hour       as integer   no-undo .
      244     define variable v-min        as integer   no-undo .
      245     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      246     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      247     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      248     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      249     if p-mjd-diff < 0
      250     or p-mjd-diff = ?
      251     then do:
      252       return "?" .
      253     end.
      254     assign
      255       v-day-number = integer(truncate(p-mjd-diff,0))
      256       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      257     .
      258     if v-seconds > 86400
      259     then do:
      260       assign
      261         v-seconds = 86400 - 1
      262       .
      263     end.
      264     if v-seconds < 0
      265     then do:
      266       assign
      267         v-seconds = 0
      268       .
      269     end.
      270     assign
      271       v-hour = truncate(v-seconds / 3600, 0)
      272     .
      273     assign
      274       v-seconds = v-seconds modulo 3600
      275     .
      276     assign
      277       v-min = truncate(v-seconds / 60, 0)
      278     .
      279     assign
      280       v-seconds = v-seconds modulo 60
      281     .
      282     return
      283         (if v-day-number <> 0
      284           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      285           else ""
      286         )
      287       + (if v-day-number <> 0 or v-hour <> 0
      288           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      289           else ""
      290         )
      291       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      292           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      293           else ""
      294         )
      295       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      296       .
      297   end.
      298   function cur-time-string returns character
      299   :
      300     define variable v-date as date      no-undo .
      301     define variable v-time as integer   no-undo .
      302     run cur-time in this-procedure
      303       (output v-date
      304       ,output v-time
      305       ) .
      306     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      307   end.
      308   function cur-time-string-sec returns character
      309   :
      310     define variable v-date as date      no-undo .
      311     define variable v-time as integer   no-undo .
      312     run cur-time in this-procedure
      313       (output v-date
      314       ,output v-time
      315       ) .
      316     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      317   end.
      318   function cur-time-custom  returns character
      319   (input p-prefix as character
      320   ,input p-date-format as character
      321   ,input p-delimiter as character
      322   ,input p-time-format as character
      323   ,input p-suffix as character
      324   )
      325   :
      326     define variable v-date as date      no-undo .
      327     define variable v-time as integer   no-undo .
      328     run cur-time in this-procedure
      329       (output v-date
      330       ,output v-time
      331       ) .
      332     return
      333       p-prefix
      334       + string(v-date, p-date-format)
      335       + p-delimiter
      336       + string(v-time, p-time-format)
      337       + p-suffix
      338       .
      339   end.
      340   function cur-time-print  returns character
      341   :
      342     define variable v-date as date      no-undo .
      343     define variable v-time as integer   no-undo .
      344     run cur-time in this-procedure
      345       (output v-date
      346       ,output v-time
      347       ) .
      348     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      349   end.
      350   function cur-time-datetime returns datetime
      351   :
      352     define variable v-char as character no-undo .
      353     define variable v-datetime as datetime no-undo .
      354     v-char = cur-time-string().
      355     v-datetime = datetime(v-char).
      356     return  v-datetime.
      357   end.
      358   function cur-time-string-msec returns character
      359   :
      360     define variable v-date as datetime  no-undo .
      361     v-date = now.
      362     return string(v-date) .
      363   end.
      364   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      365   define new global shared variable g#lib-nws as handle no-undo .
      366   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      367   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      368   define variable tempcxml_v-num_ as integer no-undo .
      369   define  temp-table temp-xml-tables no-undo
      370   field order as integer
      371   field tbl-name as character
      372   field tbl-handle_ as handle
      373   field table-handle_ as handle
      374   field uniq-gate-rec as character
      375   field gate-name as character
      376   field gate-handle_ as handle
      377   field is-parent as logical
      378   index pi is unique primary
      379   uniq-gate-rec
      380   tbl-name
      381   index iorder
      382   order
      383   index gr
      384   uniq-gate-rec
      385   index gh
      386   gate-handle_
      387   index iparent
      388   is-parent
      389   .
      390   define  temp-table temp-xml-records no-undo
      391   field tbl-name as character
      392   field uniq-key-rec as character
      393   index pi is unique primary
      394   tbl-name
      395   uniq-key-rec
      396   .
      397   def var vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      398   procedure gen-key-rec :
      399     define input  parameter p-tbl-name    as character no-undo.
      400     define input  parameter p-bh_tbl-name as handle    no-undo.
      401     define output parameter p-key-rec     as character no-undo.
      402     do
      403     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      404     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      405     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      406     :
      407       define variable fh               as handle    no-undo .
      408       define variable v-ok             as logical   no-undo .
      409       define variable v-inform         as character no-undo .
      410       define variable v-ind            as integer   no-undo .
      411       define variable v-idx-field-qnty as integer   no-undo .
      412       if p-tbl-name = ?
      413         or p-tbl-name = "":U
      414       then do:
      415         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info5 ).
      416       end.
      417       if not p-bh_tbl-name:available then do:
      418         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info5, p-tbl-name ).
      419       end.
      420       assign
      421         p-key-rec = p-tbl-name
      422         v-inform  = p-bh_tbl-name:index-information(1)
      423         v-ind     = 2
      424       .
      425       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      426       on error undo, return error
      427       :
      428         assign
      429           v-inform = p-bh_tbl-name:index-information( v-ind )
      430           v-ind    = v-ind + 1
      431         .
      432       end.
      433       if v-inform = ?
      434         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      435         or entry( 3, v-inform, ",":U ) <> "1":U
      436       then do:
      437         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, p-tbl-name ).
      438       end.
      439       else do:
      440         assign
      441           v-idx-field-qnty = num-entries( v-inform ) - 4
      442         .
      443         if v-idx-field-qnty < 2 then do:
      444           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, p-tbl-name ).
      445         end.
      446         do v-ind = 1 to v-idx-field-qnty by 2
      447         on error undo, return error
      448         :
      449           assign
      450             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      451             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      452           .
      453         end.
      454       end.
      455       if p-key-rec = ? then do:
      456         assign
      457           p-key-rec = "":U
      458         .
      459         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info5, p-tbl-name ).
      460       end.
      461     end.
      462     return.
      463   end procedure.
      464   procedure gen-where-keyr-tab :
      465     define input  parameter i-tableSerach as character no-undo.
      466     define input  parameter i-tablekey   as character  no-undo.
      467     define input  parameter p-key-rec    as character  no-undo.
      468     define input  parameter p-key-handle as handle     no-undo .
      469     define input  parameter p-db-name    as character  no-undo .
      470     define input  parameter p-tt-handle  as handle     no-undo .
      471     define output parameter o-Where      as character  no-undo.
      472     do
      473     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      474     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      475     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      476     :
      477       define variable v-full-tbl-name  as character no-undo .
      478       define variable bh_tbl-name      as handle    no-undo .
      479       define variable fh_key           as handle    no-undo .
      480       define variable fh_search        as handle    no-undo .
      481       define variable v-field-num      as integer   no-undo .
      482       define variable v-count-fld      as integer   no-undo .
      483       define variable v-inform         as character no-undo .
      484       define variable v-ind            as integer   no-undo .
      485       define variable v-idx-field-qnty as integer   no-undo .
      486       define variable v-field-name     as character no-undo .
      487       define variable v-field-val      as character no-undo .
      488       define variable v-word-link      as character no-undo .
      489       define variable vTable           as character no-undo.
      490       define variable bh_tbl-key       as handle    no-undo .
      491       assign
      492         p-key-rec = trim( p-key-rec )
      493       .
      494       if p-key-handle <> ? then do:
      495         if not valid-handle(p-key-handle)
      496            or p-key-handle:type <> "buffer"
      497         then do:
      498           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info5 ).
      499         end.
      500         if num-entries( p-key-rec, chr(3) ) > 1
      501           or p-key-rec = ?
      502           or p-key-rec = "":U
      503         then do:
      504           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info5, p-key-rec ).
      505         end.
      506       end.
      507       else do:
      508         if p-key-rec = ?
      509           or p-key-rec = "":U
      510         then do:
      511           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info5 ).
      512         end.
      513       end.
      514       assign
      515         vTable = entry( 1 , p-key-rec, chr(3) )
      516       .
      517       if p-tt-handle <> ?
      518         and ( not valid-handle(p-tt-handle)
      519               or p-tt-handle:type <> "buffer"
      520             )
      521       then do:
      522         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info5, vTable, chr(10) ).
      523       end.
      524       if p-tt-handle = ? then do:
      525         assign
      526           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      527         .
      528         create buffer bh_tbl-name for table v-full-tbl-name .
      529       end.
      530       else do:
      531         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      532       end.
      533       assign
      534         v-inform = bh_tbl-name:index-information(1)
      535         v-ind    = 2
      536       .
      537       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      538       on error undo, return error
      539       :
      540         assign
      541           v-inform = bh_tbl-name:index-information( v-ind )
      542           v-ind    = v-ind + 1
      543         .
      544       end.
      545       if v-inform = ?
      546         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      547         or entry( 3, v-inform, ",":U ) <> "1":U
      548       then do:
      549         delete object bh_tbl-name no-error.
      550         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info5, vTable ).
      551       end.
      552       assign
      553         v-idx-field-qnty = num-entries( v-inform ) - 4
      554       .
      555       if v-idx-field-qnty < 2 then do:
      556         delete object bh_tbl-name no-error.
      557         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, vTable ).
      558       end.
      559       assign
      560         o-where     = "where":U
      561         v-word-link = "":U
      562         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      563         v-count-fld = 0
      564       .
      565       if i-tablekey ne "" and i-tablekey ne ?
      566       then do:
      567         assign
      568           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      569         .
      570         create buffer bh_tbl-key for table v-full-tbl-name .
      571       end.
      572       if i-tableSerach ne "" and i-tableSerach ne ?
      573       then do:
      574         delete object bh_tbl-name no-error.
      575         assign
      576           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      577         .
      578         create buffer bh_tbl-name for table v-full-tbl-name .
      579       end.
      580       block_where:
      581       do v-ind = 1 to v-idx-field-qnty by 2
      582       on error undo, return error
      583       :
      584         assign
      585           v-count-fld = v-count-fld + 1
      586         .
      587         if p-key-handle = ?
      588           and v-count-fld > v-field-num
      589         then do:
      590           leave block_where.
      591         end.
      592         define variable VfieldKeyTable as handle no-undo.
      593         assign
      594           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      595           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      596         .
      597         if     bh_tbl-key ne ?
      598         then do:
      599            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      600            if VfieldKeyTable eq ?
      601            then next block_where.
      602         end.
      603         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      604         then
      605            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      606         else
      607            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      608         if p-key-handle = ? then do:
      609           assign
      610             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      611           .
      612         end.
      613         else do:
      614           assign
      615             fh_key = p-key-handle:buffer-field( v-field-name )
      616           .
      617           if fh_key = ?
      618             or not valid-handle( fh_key )
      619           then do:
      620             delete object bh_tbl-name.
      621             if     bh_tbl-key ne ?
      622             then
      623                delete object bh_tbl-key.
      624             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info5, p-key-handle:name, v-field-name ).
      625           end.
      626           assign
      627             v-field-val = fh_key:buffer-value
      628           .
      629         end.
      630         if fh_search:data-type ="character":U then do:
      631           assign
      632             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      633             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      634             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      635             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      636             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      637             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      638             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      639             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      640             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      641             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      642             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      643             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      644             v-field-val = substitute( '"&1"', v-field-val )
      645           .
      646         end.
      647         assign
      648           o-where = substitute( "&1 &2", o-where, v-field-val )
      649         .
      650         if v-word-link = "":U then do:
      651           assign
      652             v-word-link = "and":U
      653           .
      654         end.
      655       end.
      656       delete object bh_tbl-name.
      657       if     bh_tbl-key ne ?
      658       then
      659          delete object bh_tbl-key.
      660       if p-key-handle = ?
      661         and v-count-fld <> v-field-num
      662       then do:
      663         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info5, vTable ).
      664       end.
      665     end.
      666   end procedure.
      667   procedure gen-hn-keyr-tab :
      668     define input  parameter i-tableSerach as character no-undo.
      669     define input  parameter i-tablekey   as character no-undo.
      670     define input  parameter p-key-rec    as character no-undo.
      671     define input  parameter p-key-handle as handle    no-undo .
      672     define input  parameter p-db-name    as character no-undo .
      673     define input  parameter p-tt-handle  as handle    no-undo .
      674     define input  parameter p-stts-lock  as integer   no-undo .
      675     define output parameter o-hn         as handle    no-undo.
      676     define variable v-full-tbl-name as character no-undo.
      677     define variable v-where         as character no-undo.
      678     define variable bh_tbl-name     as handle    no-undo.
      679     define variable vTable          as character no-undo.
      680     do
      681     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      682     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      683     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      684         run gen-where-keyr-tab(i-tableSerach,
      685                                i-tablekey,
      686                                p-key-rec,
      687                                p-key-handle,
      688                                p-db-name,
      689                                p-tt-handle,
      690                                output v-where).
      691         if i-tableSerach ne "" and i-tableSerach ne ?
      692         then do:
      693            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      694            create buffer bh_tbl-name for table v-full-tbl-name .
      695         end.
      696         else do:
      697            if p-tt-handle = ? then do:
      698               assign
      699                  vTable = entry( 1 , p-key-rec, chr(3) )
      700               .
      701               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      702               create buffer bh_tbl-name for table v-full-tbl-name .
      703            end.
      704            else do:
      705               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      706            end.
      707         end.
      708         if p-tt-handle = ? then do:
      709            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      710         end.
      711         else do:
      712            bh_tbl-name:find-first( v-where ) no-error .
      713         end.
      714         o-hn = bh_tbl-name.
      715      end.
      716   end procedure.
      717   procedure gen-hn-keyr :
      718     define input  parameter p-key-rec    as character no-undo.
      719     define input  parameter p-key-handle as handle    no-undo .
      720     define input  parameter p-db-name    as character no-undo .
      721     define input  parameter p-tt-handle  as handle    no-undo .
      722     define input  parameter p-stts-lock  as integer   no-undo .
      723     define output parameter o-hn         as handle    no-undo.
      724     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      725   end.
      726   procedure gen-row-keyr :
      727     define input  parameter p-key-rec    as character no-undo.
      728     define input  parameter p-key-handle as handle    no-undo .
      729     define input  parameter p-db-name    as character no-undo .
      730     define input  parameter p-tt-handle  as handle    no-undo .
      731     define input  parameter p-stts-lock  as integer   no-undo .
      732     define output parameter p-tbl-row    as rowid     no-undo.
      733     define output parameter p-tbl-name   as character no-undo.
      734     define variable vHn as handle no-undo.
      735       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      736       p-tbl-row = if vHn:available then vHn:rowid else ?.
      737       p-tbl-name =  vHn:table.
      738       delete object vHn no-error.
      739     if p-tbl-row = ? then do:
      740       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info5, p-tbl-name, p-key-rec ).
      741     end.
      742     else do:
      743       return.
      744     end.
      745   end procedure.
      746   procedure gen-key-fv :
      747     define input  parameter p-key-rec    as character no-undo .
      748     define output parameter p-field-list as character no-undo .
      749     define output parameter p-value-list as character no-undo.
      750     do
      751     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      752     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      753     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      754     :
      755       define variable v-full-tbl-name  as character no-undo .
      756       define variable bh_tbl-name      as handle    no-undo .
      757       define variable v-tbl-name       as character no-undo .
      758       define variable v-field-num      as integer   no-undo .
      759       define variable v-count-fld      as integer   no-undo .
      760       define variable v-inform         as character no-undo .
      761       define variable v-ind            as integer   no-undo .
      762       define variable v-idx-field-qnty as integer   no-undo .
      763       define variable v-delim-key      as character no-undo .
      764       if p-key-rec = ?
      765         or p-key-rec = "":U
      766       then do:
      767         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info5 ).
      768       end.
      769       assign
      770         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      771         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      772       .
      773       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      774       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info5 ).
      775       assign
      776         v-inform = bh_tbl-name:index-information(1)
      777         v-ind    = 2
      778       .
      779       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      780       on error undo, return error
      781       :
      782         assign
      783           v-inform = bh_tbl-name:index-information( v-ind )
      784           v-ind    = v-ind + 1
      785         .
      786       end.
      787       if v-inform = ?
      788         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      789         or entry( 3, v-inform, ",":U ) <> "1":U
      790       then do:
      791         delete object bh_tbl-name no-error.
      792         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, v-tbl-name ).
      793       end.
      794       assign
      795         v-idx-field-qnty = num-entries( v-inform ) - 4
      796       .
      797       if v-idx-field-qnty < 2 then do:
      798         delete object bh_tbl-name no-error.
      799         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, v-tbl-name ).
      800       end.
      801       assign
      802         p-field-list = "":U
      803         p-value-list = "":U
      804         v-delim-key  = "":U
      805         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      806         v-count-fld  = 0
      807       .
      808       block_where:
      809       do v-ind = 1 to v-idx-field-qnty by 2
      810       on error undo, return error
      811       :
      812         assign
      813           v-count-fld = v-count-fld + 1
      814         .
      815         if v-count-fld > v-field-num then do:
      816           leave block_where.
      817         end.
      818         assign
      819           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      820           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      821         .
      822         if v-ind = 1 then do:
      823           assign
      824             v-delim-key = chr(3)
      825           .
      826         end.
      827       end.
      828       delete object bh_tbl-name.
      829       if v-count-fld <> v-field-num then do:
      830         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info5, v-tbl-name ).
      831       end.
      832     end.
      833   end procedure.
      834   procedure gen-key-field :
      835     define input  parameter p-table      as character no-undo .
      836     define output parameter p-field-list as character no-undo .
      837     do
      838     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      839     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      840     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      841     :
      842       define variable v-full-tbl-name  as character no-undo .
      843       define variable bh_tbl-name      as handle    no-undo .
      844       define variable v-tbl-name       as character no-undo .
      845       define variable v-field-num      as integer   no-undo .
      846       define variable v-count-fld      as integer   no-undo .
      847       define variable v-inform         as character no-undo .
      848       define variable v-ind            as integer   no-undo .
      849       define variable v-idx-field-qnty as integer   no-undo .
      850       define variable v-delim-key      as character no-undo .
      851       if p-table = ?
      852         or p-table = "":U
      853       then do:
      854         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info5 ).
      855       end.
      856       assign
      857         v-tbl-name      = p-table
      858         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      859       .
      860       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      861       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info5 ).
      862       assign
      863         v-inform = bh_tbl-name:index-information(1)
      864         v-ind    = 2
      865       .
      866       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      867       on error undo, return error
      868       :
      869         assign
      870           v-inform = bh_tbl-name:index-information( v-ind )
      871           v-ind    = v-ind + 1
      872         .
      873       end.
      874       if v-inform = ?
      875         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      876         or entry( 3, v-inform, ",":U ) <> "1":U
      877       then do:
      878         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, v-tbl-name ).
      879       end.
      880       assign
      881         v-idx-field-qnty = num-entries( v-inform ) - 4
      882       .
      883       if v-idx-field-qnty < 2 then do:
      884         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, v-tbl-name ).
      885       end.
      886       assign
      887         p-field-list = "":U
      888         v-delim-key  = "":U
      889         v-count-fld  = 0
      890       .
      891       block_where:
      892       do v-ind = 1 to v-idx-field-qnty by 2
      893       on error undo, return error
      894       :
      895         assign
      896           v-count-fld = v-count-fld + 1
      897         .
      898         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      899         if v-ind = 1 then do:
      900           assign
      901             v-delim-key = chr(3)
      902           .
      903         end.
      904       end.
      905       delete object bh_tbl-name.
      906     end.
      907   end procedure.
      908   procedure get-gate-file-name :
      909   define input parameter p-gate-rec as character no-undo .
      910   define output  parameter p-gate-file-name as character no-undo .
      911   define buffer buf_clob-data for ub.clob-data.
      912   define variable v-tbl-row as rowid no-undo .
      913   define variable v-tbl-name as character no-undo .
      914   run gen-row-keyr in this-procedure ( input p-gate-rec
      915                                       ,input ?
      916                                       ,input "ub"
      917                                       ,input ?
      918                                       ,input no-lock
      919                                       ,output v-tbl-row
      920                                       ,output v-tbl-name) no-error.
      921   if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
      922                                                           ,vss-include-info3
      923                                                           ,p-gate-rec).
      924   find first buf_clob-data no-lock where
      925             rowid(buf_clob-data) = v-tbl-row no-error.
      926   if not available buf_clob-data then do:
      927     if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
      928                                                             ,vss-include-info3
      929                                                             ,p-gate-rec).
      930   end.
      931   p-gate-file-name = buf_clob-data.file-name.
      932   end procedure.
      933   procedure get-gate-rec :
      934   define input  parameter p-gate-name as character no-undo .
      935   define output parameter p-gate-rec as character no-undo .
      936   define buffer buf_clob-bind for ub.clob-bind.
      937   define buffer buf_clob-data for ub.clob-data.
      938   main-block:
      939   do
      940   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info3, return-value, chr(10), error-status :get-message (1))
      941   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info3 )
      942   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info3 )
      943   :
      944       find first buf_clob-bind no-lock where
      945                 buf_clob-bind.uniq-key-rec = p-gate-name
      946             and buf_clob-bind.field-name = '':U
      947             and buf_clob-bind.part-num = 1
      948             and buf_clob-bind.resource-type = 'gate':U
      949             no-error.
      950       if not available buf_clob-bind then do:
      951         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
      952                                         , p-gate-name
      953                                         ).
      954       end.
      955       find first buf_clob-data no-lock where
      956                 buf_clob-data.db-num = buf_clob-bind.db-num
      957             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
      958       if not available buf_clob-data then do:
      959         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
      960                                         , buf_clob-bind.db-num
      961                                         , buf_clob-bind.int64-id
      962                                         , p-gate-name
      963                                         ).
      964       end.
      965       run gen-key-rec in this-procedure ( input 'clob-data':U
      966                                 ,input buffer buf_clob-data:handle
      967                                 ,output p-gate-rec).
      968   end.
      969   end procedure.
      970   procedure get-gate-by-name :
      971   define input  parameter p-gate-name as character no-undo .
      972   define output parameter p-gate-rec as character no-undo .
      973   define output parameter p-dsh as handle no-undo .
      974   define input-output  parameter p-xmlh as handle no-undo .
      975   define variable v-ii as integer   no-undo .
      976   define variable glog as logical   no-undo .
      977   define variable v-longchar as longchar no-undo .
      978   define variable v-txmlh as handle no-undo .
      979   define variable v-db-num as integer no-undo .
      980   define variable v-int64-id as int64 no-undo .
      981   define buffer buf_clob-bind for ub.clob-bind.
      982   define buffer buf_clob-data for ub.clob-data.
      983   main-block:
      984   do
      985   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info3, return-value, chr(10), error-status :get-message (1))
      986   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info3 )
      987   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info3 )
      988   :
      989       find first buf_clob-bind no-lock where
      990                 buf_clob-bind.uniq-key-rec = p-gate-name
      991             and buf_clob-bind.field-name = '':U
      992             and buf_clob-bind.part-num = 1
      993             and buf_clob-bind.resource-type = 'gate':U
      994             no-error.
      995       if not available buf_clob-bind then do:
      996         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
      997                                         , p-gate-name
      998                                         ).
      999       end.
     1000       find first buf_clob-data no-lock where
     1001                 buf_clob-data.db-num = buf_clob-bind.db-num
     1002             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     1003       if not available buf_clob-data then do:
     1004         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1005                                         , buf_clob-bind.db-num
     1006                                         , buf_clob-bind.int64-id
     1007                                         , p-gate-name
     1008                                         ).
     1009       end.
     1010       assign
     1011       v-longchar = buf_clob-data.cdata
     1012       .
     1013       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1014       if error-status :error then do:
     1015         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1016       end.
     1017       create dataset p-dsh .
     1018       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1019                                     , v-longchar
     1020                                     , ?
     1021                                     , ?
     1022                                     , ?
     1023                                     ) no-error.
     1024       v-longchar = '':U.
     1025       if error-status :error
     1026       or not glog
     1027       then do:
     1028         undo, return error substitute("Не удалось прочитать XML-схему &1 из БД:&2&3", p-gate-name, chr(10), error-status:get-message(1) ).
     1029       end.
     1030       if not valid-handle(p-xmlh)
     1031       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1032         create temp-table v-txmlh.
     1033         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1034         v-txmlh:temp-table-prepare("temp-xml-tables").
     1035         p-xmlh = v-txmlh:default-buffer-handle.
     1036       end.
     1037       run gen-key-rec in this-procedure ( input 'clob-data':U
     1038                                 ,input buffer buf_clob-data:handle
     1039                                 ,output p-gate-rec).
     1040       do v-ii = 1 to p-dsh:num-buffers:
     1041         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1042         if not p-xmlh:available then do:
     1043           p-xmlh:buffer-create().
     1044           assign
     1045           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1046           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1047           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1048           p-xmlh::gate-handle_ = p-dsh
     1049           p-xmlh::uniq-gate-rec = p-gate-rec
     1050           p-xmlh::gate-name = p-dsh:name
     1051           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1052           .
     1053           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1054             assign
     1055             p-xmlh::order = -3.
     1056           end.
     1057         end.
     1058       end.
     1059   end.
     1060   end procedure.
     1061   procedure get-gate-by-rec :
     1062   define input  parameter p-gate-rec as character no-undo .
     1063   define output parameter p-dsh as handle no-undo .
     1064   define input-output  parameter p-xmlh as handle no-undo .
     1065   define input-output parameter p-longchar  as longchar no-undo .
     1066   define variable v-ii as integer   no-undo .
     1067   define variable glog as logical   no-undo .
     1068   define variable v-rowid as rowid no-undo .
     1069   define variable v-tbl-name as character no-undo .
     1070   define variable v-longchar as longchar no-undo .
     1071   define variable v-txmlh as handle no-undo .
     1072   define buffer buf_clob-data for ub.clob-data.
     1073   main-block:
     1074   do
     1075   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info3, return-value, chr(10), error-status :get-message (1))
     1076   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info3 )
     1077   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info3 )
     1078   :
     1079     run gen-row-keyr in this-procedure (
     1080                                           input  p-gate-rec
     1081                                           ,input  ?
     1082                                           ,input  "ub"
     1083                                           ,input  ?
     1084                                           ,input  NO-LOCK
     1085                                           ,output v-rowid
     1086                                           ,output v-tbl-name   ) no-error.
     1087       find first buf_clob-data no-lock where
     1088                 rowid(buf_clob-data) = v-rowid  no-error.
     1089       if not available buf_clob-data then do:
     1090         undo, return error substitute("Не найден CLOB  &1"
     1091                                         , p-gate-rec
     1092                                         ).
     1093       end.
     1094       assign
     1095       v-longchar = buf_clob-data.cdata
     1096       .
     1097       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1098       if error-status :error then do:
     1099         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1100       end.
     1101       create dataset p-dsh .
     1102       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1103                                     , v-longchar
     1104                                     , ?
     1105                                     , ?
     1106                                     , ?
     1107                                     ) no-error.
     1108       define variable v-esm as character no-undo .
     1109       v-esm = error-status:get-message(1) .
     1110       if p-longchar <> ? then do:
     1111         p-longchar = v-longchar.
     1112       end.
     1113       v-longchar = '':U.
     1114       if error-status :error
     1115       or not glog
     1116       then do:
     1117         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     1118                                      , p-gate-rec
     1119                                      , p-gate-rec
     1120                                      , v-esm
     1121                                      ).
     1122       end.
     1123       p-dsh:private-data = buf_clob-data.file-name_ + chr(4) + p-gate-rec.
     1124       if not valid-handle(p-xmlh)
     1125       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1126         create temp-table v-txmlh.
     1127         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1128         v-txmlh:temp-table-prepare("temp-xml-tables").
     1129         p-xmlh = v-txmlh:default-buffer-handle.
     1130       end.
     1131       do v-ii = 1 to p-dsh:num-buffers:
     1132         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1133         if not p-xmlh:available then do:
     1134           p-xmlh:buffer-create().
     1135           assign
     1136           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1137           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1138           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1139           p-xmlh::gate-handle_ = p-dsh
     1140           p-xmlh::uniq-gate-rec = p-gate-rec
     1141           p-xmlh::gate-name = p-dsh:name
     1142           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1143           .
     1144           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1145             assign
     1146             p-xmlh::order = -3.
     1147           end.
     1148           p-xmlh:buffer-release().
     1149         end.
     1150       end.
     1151   end.
     1152   end procedure.
     1153   procedure get-gate-by-file :
     1154   define input  parameter p-schema-file-name as character no-undo .
     1155   define input  parameter p-gate-rec as character no-undo .
     1156   define output parameter p-dsh as handle no-undo .
     1157   define input-output  parameter p-xmlh as handle no-undo .
     1158   define variable v-ii as integer   no-undo .
     1159   define variable glog as logical   no-undo .
     1160   define variable v-rowid as rowid no-undo .
     1161   define variable v-tbl-name as character no-undo .
     1162   define variable v-longchar as longchar no-undo .
     1163   define variable v-txmlh as handle no-undo .
     1164   main-block:
     1165   do
     1166   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info3, return-value, chr(10), error-status :get-message (1))
     1167   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info3 )
     1168   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info3 )
     1169   :
     1170       COPY-LOB
     1171       FROM  FILE p-schema-file-name
     1172       TO  OBJECT v-longchar
     1173       no-convert
     1174       NO-ERROR .
     1175       if error-status :error then do:
     1176           undo, return error substitute("Не удалось считать файл схемы &1 в память&2&3"
     1177                                     , p-schema-file-name
     1178                                 , chr(10)
     1179                                 , error-status:get-message(1) ).
     1180       end.
     1181       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1182       if error-status :error then do:
     1183         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, p-schema-file-name, chr(10), error-status:get-message(1) , return-value ).
     1184       end.
     1185       create dataset p-dsh .
     1186       glog = p-dsh:READ-XMLSCHEMA( "longchar"
     1187                                     , v-longchar
     1188                                     , ?
     1189                                     , ?
     1190                                     , ?
     1191                                     ) no-error.
     1192       v-longchar = ''.
     1193       if error-status :error
     1194       or not glog
     1195       then do:
     1196         undo, return error substitute("Не удалось прочитать XML-схему из файла &1&2&3"
     1197                                      , p-schema-file-name
     1198                                      ,chr(10)
     1199                                      , error-status:get-message(1)
     1200                                      ).
     1201       end.
     1202       if not valid-handle(p-xmlh)
     1203       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1204         create temp-table v-txmlh.
     1205         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1206         v-txmlh:temp-table-prepare("temp-xml-tables").
     1207         p-xmlh = v-txmlh:default-buffer-handle.
     1208       end.
     1209       do v-ii = 1 to p-dsh:num-buffers:
     1210         p-xmlh:find-first(substitute(' where tbl-name = "&1" and  uniq-gate-rec = "&2" '
     1211                                      ,p-dsh:get-buffer-handle(v-ii):name
     1212                                      ,p-gate-rec
     1213                                      )) no-error.
     1214         if not p-xmlh:available then do:
     1215           p-xmlh:buffer-create().
     1216           assign
     1217           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):table
     1218           p-xmlh::uniq-gate-rec = p-gate-rec
     1219           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1220           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1221           p-xmlh::gate-handle_ = p-dsh
     1222           p-xmlh::gate-name = p-dsh:name
     1223           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1224           .
     1225           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1226             assign
     1227             p-xmlh::order = -3.
     1228           end.
     1229           p-xmlh:buffer-release().
     1230         end.
     1231       end.
     1232   end.
     1233   end procedure.
     1234   procedure gate-clear :
     1235   define input  parameter p-dsh as handle no-undo .
     1236   define input  parameter p-xmlh as handle no-undo .
     1237   define variable v-dsh as handle no-undo .
     1238   define variable v-th as handle no-undo .
     1239     do
     1240     on error undo, return error return-value
     1241     :
     1242       if valid-handle(p-dsh) then do:
     1243         delete object p-dsh.
     1244         v-dsh = p-dsh.
     1245         p-dsh = ?.
     1246       end.
     1247       repeat while true:
     1248         p-xmlh:find-first( substitute( " where gate-handle_ = &1 ", v-dsh)
     1249                            , share-lock) no-error.
     1250         if p-xmlh:available then do:
     1251           assign
     1252           v-th = p-xmlh:buffer-field("table-handle_"):buffer-value.
     1253           if valid-handle(p-xmlh:buffer-field("table-handle_"))
     1254           and valid-handle(v-th)
     1255           and v-th:dynamic = yes
     1256           then do:
     1257             delete object p-xmlh:buffer-field("table-handle_"):buffer-value.
     1258             p-xmlh:buffer-field("table-handle_"):buffer-value = ?.
     1259           end.
     1260           p-xmlh:buffer-delete().
     1261         end.
     1262         else do:
     1263           leave.
     1264         end.
     1265       end.
     1266       if p-xmlh:dynamic = yes
     1267       and valid-handle(p-xmlh)
     1268       then do:
     1269         delete object p-xmlh:table-handle.
     1270         p-xmlh = ?.
     1271       end.
     1272       v-dsh = ?.
     1273     end.
     1274   end procedure.
     1275   procedure all-gates-clear :
     1276   define parameter buffer buf_temp-xml-tables for temp-xml-tables.
     1277   do
     1278   on error undo, return error
     1279   :
     1280     for each buf_temp-xml-tables
     1281     break
     1282     by buf_temp-xml-tables.uniq-gate-rec
     1283     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1284     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1285     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1286     :
     1287         if first-of(buf_temp-xml-tables.uniq-gate-rec) then do:
     1288           delete object buf_temp-xml-tables.gate-handle_.
     1289           buf_temp-xml-tables.gate-handle_ = ?.
     1290         end.
     1291         if valid-handle(buf_temp-xml-tables.table-handle_)
     1292         and buf_temp-xml-tables.table-handle_:dynamic = no
     1293         then do:
     1294           delete object buf_temp-xml-tables.table-handle_.
     1295           buf_temp-xml-tables.table-handle_ = ?.
     1296         end.
     1297         delete buf_temp-xml-tables.
     1298     end.
     1299   end.
     1300   end procedure.
     1301   procedure fix-schemalocation :
     1302   define input-output  parameter p-longchar as longchar no-undo .
     1303   DEFINE VARIABLE hdoc AS HANDLE.
     1304   DEFINE VARIABLE hroot AS HANDLE.
     1305   DEFINE VARIABLE hnode-child AS HANDLE.
     1306   DEFINE VARIABLE hnode-attr AS HANDLE.
     1307   define variable v-jj as integer   no-undo .
     1308   define variable ok as logical   no-undo .
     1309   define variable v-path1                    as character                no-undo .
     1310   DEFINE VARIABLE v-full-path1               as character                no-undo .
     1311   DEFINE VARIABLE v-file-name1               as character                no-undo .
     1312   DEFINE VARIABLE v-file-name-no-ext1        as character                no-undo .
     1313   DEFINE VARIABLE v-file-name-ext1           as character                no-undo .
     1314   define variable v-schema-location          as character                no-undo .
     1315   do
     1316   on error undo, return error return-value
     1317   :
     1318     CREATE X-DOCUMENT hdoc.
     1319     CREATE X-noderef hroot.
     1320     CREATE X-noderef hnode-child.
     1321     CREATE X-noderef hnode-attr.
     1322     hdoc:load("longchar", p-longchar, no) no-error.
     1323     iF ERROR-STATUS:GET-MESSAGE(1) <> '' THEN message ERROR-STATUS:GET-MESSAGE(1) view-as alert-box .
     1324     hdoc:get-document-element(hroot).
     1325     _repeat:
     1326     REPEAT v-jj = 1 TO hroot:NUM-CHILDREN:
     1327       ok = hroot:GET-CHILD(hNode-Child, v-jj).
     1328       if not ok then next.
     1329       if hNode-Child:local-name = "include"
     1330       then do:
     1331         ok = hNode-Child:GET-ATTRIBUTE-NODE( hnode-attr, "schemaLocation" ).
     1332           v-schema-location = hnode-attr:node-value.
     1333           run gbl/filename.p (
     1334                           input "exe/" + hnode-attr:node-value
     1335                         ,output v-full-path1
     1336                         ,output v-path1
     1337                         ,output v-file-name1
     1338                         ,output v-file-name-no-ext1
     1339                         ,output v-file-name-ext1
     1340                         ) no-error .
     1341           if error-status :error then do:
     1342             delete object hnode-attr.
     1343             delete object hnode-child.
     1344             delete object hroot.
     1345             delete object hdoc.
     1346             undo, return error substitute("Не удалось определить расположение схемы &1", v-schema-location).
     1347           end.
     1348         ok = hNode-Child:sET-ATTRIBUTE(  "schemaLocation", v-full-path1 ).
     1349         leave  _repeat.
     1350       end.
     1351     END.
     1352     hdoc:save("longchar", p-longchar).
     1353     delete object hnode-attr.
     1354     delete object hnode-child.
     1355     delete object hroot.
     1356     delete object hdoc.
     1357   end.
     1358   end procedure.
     1359   procedure gate-clb_fill-xml-tables :
     1360   define input parameter p-dsh as handle no-undo .
     1361   define input-output parameter p-xmlh as handle no-undo .
     1362   define variable v-ii as integer no-undo .
     1363     do
     1364     on error undo, return error
     1365     :
     1366       do v-ii = 1 to p-dsh:num-buffers:
     1367         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1368         if not p-xmlh:available then do:
     1369           p-xmlh:buffer-create().
     1370           assign
     1371           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1372           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1373           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1374           p-xmlh::gate-handle_ = p-dsh
     1375           p-xmlh::uniq-gate-rec = entry(2, p-dsh:private-data, chr(4))
     1376           p-xmlh::gate-name = p-dsh:name
     1377           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1378           .
     1379           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1380             assign
     1381             p-xmlh::order = -3.
     1382           end.
     1383           p-xmlh:buffer-release().
     1384         end.
     1385       end.
     1386     end.
     1387   end procedure.
     1388   procedure all-gates-empty :
     1389   define buffer buf_temp-xml-tables for temp-xml-tables.
     1390   do
     1391   on error undo, return error
     1392   :
     1393     for each buf_temp-xml-tables
     1394     break
     1395     by buf_temp-xml-tables.uniq-gate-rec
     1396     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1397     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1398     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1399     :
     1400       if valid-handle(buf_temp-xml-tables.tbl-handle_) then do:
     1401         buf_temp-xml-tables.tbl-handle_:empty-temp-table().
     1402       end.
     1403     end.
     1404   end.
     1405   end procedure.
     1406   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1407   FUNCTION rum-fn_get-next-file-name returns character (
     1408                                       input p-base-file-name as character
     1409                                     , input p-index as integer):
     1410   define variable v-loc-file-name as character no-undo .
     1411   v-loc-file-name = substitute("&1_&2.&3"
     1412                               ,substring(p-base-file-name, 1, (if r-index(p-base-file-name, ".") > 1
     1413                                                         then (r-index(p-base-file-name, ".") - 1)
     1414                                                         else length(p-base-file-name)
     1415                                                         )
     1416                                           )
     1417                               ,p-index
     1418                               ,(if r-index(p-base-file-name, ".") > 1
     1419                                 then substring(p-base-file-name, r-index(p-base-file-name, ".") + 1)
     1420                                 else '')
     1421                                 )
     1422                                 .
     1423   return v-loc-file-name.
     1424   end function.
     1425   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1426   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
     1427   run gbl/getobjsrvhndl.p (input-output ObjSrv).
     1428   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1429   function context_get-thobj-es return logical
     1430   (
     1431      input p-esys-id as integer
     1432     ,input p-eobj-type as character
     1433     ,input p-eobj-code as integer
     1434     ,output p-obj-type as character
     1435     ,output p-obj-code as integer
     1436   ):
     1437      define variable v-value-list as character no-undo .
     1438      define variable v-field-list as character no-undo .
     1439      define buffer buf_clients for ub.clients.
     1440      define buffer buf_ext-classif for ub.ext-classif.
     1441      find first buf_ext-classif no-lock where
     1442                buf_ext-classif.classif-name = 'clients-esys':U
     1443            and buf_ext-classif.classif-subject = 'clients':U
     1444            and buf_ext-classif.db-num = 0
     1445            and buf_Ext-classif.key#_one = p-esys-id
     1446            and buf_Ext-classif.charkey_one = p-eobj-type
     1447            and buf_Ext-classif.key#_two = p-eobj-code no-error .
     1448      if available buf_Ext-classif
     1449      then do:
     1450         ObjSrv:Lib:KeyRec:GenKeyFv (
     1451                                         input buf_Ext-classif.uniq-key-rec
     1452                                         ,output v-field-list
     1453                                         ,output v-value-list).
     1454         assign
     1455            p-obj-type = entry(lookup("obj-type":U
     1456                                     , v-field-list
     1457                                     , chr(3))
     1458                                     , v-value-list, chr(3))
     1459            p-obj-code = integer(entry(lookup("obj-code":U
     1460                                            , v-field-list
     1461                                            , chr(3))
     1462                                      , v-value-list
     1463                                      , chr(3)))
     1464         no-error .
     1465      end.
     1466      if     available buf_ext-classif
     1467         and (p-obj-type = 'маг':U
     1468              or
     1469              p-obj-type = 'скл':U
     1470              )
     1471         and (p-obj-code > 0 and p-obj-code <= 99999)
     1472      then do:
     1473         find first buf_clients no-lock where
     1474                    buf_clients.obj-type = p-obj-type
     1475                and buf_clients.obj-code = p-obj-code no-error.
     1476         if available buf_clients then do:
     1477            return yes.
     1478         end.
     1479         else do:
     1480            assign
     1481               p-obj-type = '':U
     1482               p-obj-code = 0
     1483            .
     1484            return no.
     1485         end.
     1486      end.
     1487      else do:
     1488         assign
     1489            p-obj-type = '':U
     1490            p-obj-code = 0
     1491         .
     1492         return no.
     1493      end.
     1494   end.
