        4   using ibs.th.bge.1crn.subjects.inv-gd-doc from propath.
        5   using ibs.th.bge.1crn.subjects.iexpsubject from propath.
        6   using ibs.th.bge.1crn.subjects.peres-gd-doc from propath.
        7   block-level on error undo, throw.
        8   define input parameter parparentproc as widget-handle no-undo .
        9   define input parameter p-parent-handle as handle no-undo .
       10   define input parameter p-log-handle  as handle no-undo .
       11   define input parameter p-cont-handle  as handle no-undo .
