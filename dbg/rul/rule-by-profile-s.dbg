      628   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      629   on f5 of frame Dialog-Frame anywhere
      630   do:
      631      v-doc-rec = recid(X_rule-by-profile).    RUn OpenBR in this-procedure.  REPOSITION br-rule-by-profile to recid v-doc-rec No-ERROR.   apply 'value-changed' to br-rule-by-profile.
      632       apply "VALUE-CHANGED" to br-rule-by-profile.
      633   end.
      634   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      635   on help of frame Dialog-Frame
      636   do:
      637     run gbl/app_help.p
      638       (input this-procedure :file-name
      639       ,input ''
      640       ,input ?
      641       ) no-error.
      642     if error-status :error then do:
      643       message
      644         "Ошибка при вызове помощи"
      645         error-status :get-message(1)
      646         view-as alert-box .
      647     end.
      648   end.
      649   run minbtn-set in this-procedure .
      650   on choose of b-help in frame Dialog-Frame
      651   do:
      652     apply "help":u to frame Dialog-Frame .
      653   end.
      654   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      655   procedure minbtn-set :
      656       do
      657           on error undo, return error return-value
      658           :
      659           define variable ii              as integer       no-undo .
      660           define variable fh              as widget-handle no-undo .
      661           define variable hh              as widget-handle no-undo .
      662           define variable v-h             as handle        extent 4 no-undo .
      663           define variable v-name-button   as character     no-undo .
      664           define variable v-help-old-x    as decimal       no-undo .
      665           define variable v-help-old-y    as decimal       no-undo .
      666           define variable v-help-old-size as decimal       no-undo .
      667           define variable v-frame-width   as decimal       no-undo .
      668           define variable jj              as integer       no-undo .
      669           do
      670               on error undo, return error
      671               :
      672               assign
      673                   v-frame-width = frame Dialog-Frame:width - 0.3
      674                   fh            = frame Dialog-Frame:first-child
      675                   hh            = fh:first-child
      676                   ii            = 1
      677                   .
      678               do while valid-handle(hh):
      679                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      680                   do:
      681                       case lc(hh:name) :
      682                           when "b-help" then
      683                               do:
      684                                   hh:load-image-up("cmp/b-help.bmp":u) .
      685                                   hh:load-image-down("cmp/b-help.bmp":u) .
      686                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      687                                   hh:TOOLTIP = "Помощь" .
      688                                   v-help-old-x = hh:column .
      689                                   v-help-old-y = hh:row    .
      690                                   v-help-old-size = hh:width .
      691                                   hh:width-chars = 2.5 .
      692                               end.
      693                           when "b-print" then
      694                               do:
      695                                   hh:load-image("cmp/b-print.bmp":u) .
      696                                   hh:TOOLTIP = "Печать" .
      697                                   v-h[ii] = hh:handle .
      698                                   ii = ii + 1 .
      699                                   hh:width-chars = 3 .
      700                               end.
      701                           when "b-history" or
      702                           when "b-hist" then
      703                               do:
      704                                   hh:load-image("cmp/b-hist.bmp":u) .
      705                                   hh:TOOLTIP = "История" .
      706                                   v-h[ii] = hh:handle .
      707                                   ii = ii + 1 .
      708                                   hh:width-chars = 3 .
      709                               end.
      710                           when "b-sch" then
      711                               do:
      712                                   hh:load-image("cmp/b-sch.bmp":u) .
      713                                   hh:TOOLTIP = "Установка Фильтра" .
      714                                   v-h[ii] = hh:handle .
      715                                   ii = ii + 1 .
      716                                   hh:width-chars = 3 .
      717                               end.
      718                           when "b-hist-user" then
      719                               do:
      720                                   hh:load-image("cmp/b-hist.bmp":u) .
      721                                   hh:TOOLTIP = "История пользователя" .
      722                                   ii = ii + 1 .
      723                               end.
      724                       end case.
      725                   end.
      726                   hh = hh:next-sibling.
      727               end.
      728               b-help:column = v-frame-width - b-help:width-chars.
      729               jj = 0.
      730               repeat ii = 4 to 1 by -1 :
      731                   if valid-handle (v-h[ii] ) then
      732                   do:
      733                       jj  = jj + 1 .
      734                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      735                       v-h[ii]:row    = v-help-old-y .
      736                   end.
      737               end.
      738           end.
      739       end.
      740   end procedure.
      741   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      742   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      743   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      744   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      745   define variable v-diasize-current-frame-width  as decimal   no-undo .
      746   define variable v-diasize-current-frame-height as decimal   no-undo .
      747   define variable v-diasize-change-size          as logical   no-undo .
      748   define variable v-diasize-resize-button        as handle    no-undo .
      749   define variable v-diasize-wndmax               as logical   no-undo .
      750   define variable v-diasize-wndstore             as logical   no-undo .
      751   define variable v-diasize-proc-name            as character no-undo .
      752   define variable v-diasize-browse-handle        as handle    no-undo .
      753   define variable v-diasize-browse-number        as integer   no-undo .
      754   define variable v-diasize-need-full-display    as logical   no-undo init false .
      755   define temp-table temp-diasize-handle no-undo
      756     field handle-value  as handle
      757     field save-position as decimal
      758     index xpk is primary unique handle-value
      759     .
      760   define temp-table temp-browse-handle no-undo
      761     field browse-type   as character
      762     field browse-number as integer
      763     field browse-handle as handle
      764     field original-size as decimal
      765     index xpk is primary unique browse-type browse-number
      766     index xie browse-type browse-handle
      767   .
      768   procedure diasize_change-height :
      769     define input  parameter p-change-value  as decimal   no-undo .
      770     define input  parameter p-move-resize   as logical   no-undo .
      771     define variable v-field-group-handle    as handle    no-undo .
      772     define variable v-object-handle         as handle    no-undo .
      773     define variable v-frame-height          as decimal   no-undo .
      774     define variable v-frame-virtual-height  as decimal   no-undo .
      775     define variable v-browse-height         as decimal   no-undo .
      776     define variable v-window-height         as decimal   no-undo .
      777     define variable v-window-virtual-height as decimal   no-undo .
      778     define variable v-change-sign           as integer   no-undo .
      779     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      780     define buffer buf_temp-browse-handle  for temp-browse-handle .
      781     if p-change-value > 0
      782     then do:
      783       if frame Dialog-Frame :height + p-change-value
      784           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      785       then do:
      786         assign
      787           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      788                           - (frame Dialog-Frame :height-chars)
      789         .
      790         if p-change-value <= 0
      791         then do:
      792           run diasize_position-resize-button in this-procedure .
      793           return .
      794         end.
      795       end.
      796     end.
      797     if p-change-value < 0
      798     then do:
      799       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      800       then do:
      801         assign
      802           p-change-value = v-diasize-orig-frame-height
      803                          - (frame Dialog-Frame :height-chars)
      804         .
      805         if p-change-value >= 0
      806         then do:
      807           run diasize_position-resize-button in this-procedure .
      808           return .
      809         end.
      810       end.
      811     end.
      812     if p-change-value >= 0
      813     then do:
      814       assign
      815         v-change-sign = 1
      816       .
      817     end.
      818     else do:
      819       assign
      820         v-change-sign = -1
      821       .
      822     end.
      823     assign
      824       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      825     .
      826     if p-change-value = 0
      827     then do:
      828       run diasize_position-resize-button in this-procedure .
      829       return .
      830     end.
      831     move_block:
      832     do
      833     on error undo move_block, retry move_block
      834     :
      835       if retry
      836       then do:
      837         do
      838         on error undo move_block, leave move_block
      839         :
      840           if p-change-value > 0
      841           then do:
      842             for each buf_temp-diasize-handle
      843             on error undo, next
      844             :
      845               assign
      846                 v-object-handle = buf_temp-diasize-handle.handle-value
      847               .
      848               if v-object-handle <> v-diasize-resize-button
      849               then do:
      850                 assign
      851                   v-object-handle :row = buf_temp-diasize-handle.save-position
      852                 .
      853               end.
      854             end.
      855             assign
      856               v-diasize-browse-handle :height = v-browse-height
      857             .
      858             for each buf_temp-browse-handle
      859               where buf_temp-browse-handle.browse-type = 'height':u
      860             on error undo, next
      861             :
      862               assign
      863                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      864               .
      865             end.
      866             assign
      867               frame Dialog-Frame :height = v-frame-height
      868             .
      869             if frame Dialog-Frame :scrollable = true
      870             then do:
      871               assign
      872                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      873               .
      874             end.
      875             run diasize_position-resize-button in this-procedure .
      876           end.
      877           else do:
      878             if frame Dialog-Frame :scrollable = true
      879             then do:
      880               assign
      881                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      882               .
      883             end.
      884             assign
      885               frame Dialog-Frame :height = v-frame-height
      886             .
      887             assign
      888               v-diasize-browse-handle :height = v-browse-height
      889             .
      890             for each buf_temp-browse-handle
      891               where buf_temp-browse-handle.browse-type = 'height':u
      892             on error undo, next
      893             :
      894               assign
      895                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      896               .
      897             end.
      898             for each buf_temp-diasize-handle
      899             on error undo, next
      900             :
      901               assign
      902                 v-object-handle = buf_temp-diasize-handle.handle-value
      903               .
      904               if v-object-handle <> v-diasize-resize-button
      905               then do:
      906                 assign
      907                   v-object-handle :row = buf_temp-diasize-handle.save-position
      908                 .
      909               end.
      910             end.
      911             run diasize_position-resize-button in this-procedure .
      912           end.
      913           assign
      914             v-diasize-change-size = false
      915           .
      916           leave move_block .
      917         end.
      918       end.
      919       assign
      920         v-diasize-need-full-display = true
      921       .
      922       if v-diasize-change-size = false
      923       then do:
      924         assign
      925           v-diasize-change-size = true
      926         .
      927       end.
      928       else do:
      929         return .
      930       end.
      931       assign
      932         v-frame-height = frame Dialog-Frame :height
      933         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      934         v-browse-height = v-diasize-browse-handle :height
      935       .
      936       for each buf_temp-browse-handle
      937         where buf_temp-browse-handle.browse-type = 'height':u
      938       :
      939         assign
      940           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      941         .
      942       end.
      943       for each buf_temp-diasize-handle
      944       :
      945         delete buf_temp-diasize-handle .
      946       end.
      947       assign
      948         v-field-group-handle = frame Dialog-Frame :first-child
      949       .
      950       do while valid-handle(v-field-group-handle)
      951       :
      952         assign
      953           v-object-handle = v-field-group-handle :first-child
      954         .
      955         do while valid-handle(v-object-handle)
      956         :
      957           if  v-object-handle <> v-diasize-browse-handle :handle
      958           and can-query(v-object-handle, "row")
      959           and can-query(v-object-handle, "height")
      960           and ( v-object-handle :row > v-diasize-browse-handle :row )
      961           then do:
      962             find first buf_temp-browse-handle
      963               where buf_temp-browse-handle.browse-type   = 'height':u
      964                 and buf_temp-browse-handle.browse-handle = v-object-handle
      965               no-error .
      966             if available buf_temp-browse-handle
      967             then do:
      968             end.
      969             else do:
      970               create buf_temp-diasize-handle .
      971               assign
      972                 buf_temp-diasize-handle.handle-value  = v-object-handle
      973                 buf_temp-diasize-handle.save-position = v-object-handle :row
      974               .
      975             end.
      976           end.
      977           assign
      978             v-object-handle = v-object-handle :next-sibling
      979           .
      980         end.
      981         assign
      982           v-field-group-handle = v-field-group-handle :next-sibling
      983         .
      984       end.
      985       do with frame Dialog-Frame
      986       :
      987         hide v-diasize-resize-button .
      988         assign
      989           v-diasize-resize-button :row    = 1
      990           v-diasize-resize-button :column = 1
      991         .
      992       end.
      993       if p-change-value > 0
      994       then do:
      995         if frame Dialog-Frame :scrollable = true
      996         then do:
      997           assign
      998             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      999             no-error .
     1000           if error-status :error
     1001           or error-status :get-message(1) <> ""
     1002           then do:
     1003             undo move_block, retry move_block .
     1004           end.
     1005         end.
     1006         assign
     1007           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1008           no-error .
     1009         if error-status :error
     1010         or error-status :get-message(1) <> ""
     1011         then do:
     1012           undo move_block, retry move_block .
     1013         end.
     1014         assign
     1015           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1016           no-error .
     1017         if error-status :error
     1018         or error-status :get-message(1) <> ""
     1019         then do:
     1020           undo move_block, retry move_block .
     1021         end.
     1022         for each buf_temp-browse-handle
     1023           where buf_temp-browse-handle.browse-type = 'height':u
     1024         on error undo move_block, retry move_block
     1025         :
     1026           assign
     1027             buf_temp-browse-handle.browse-handle :height
     1028               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1029             no-error .
     1030           if error-status :error
     1031           or error-status :get-message(1) <> ""
     1032           then do:
     1033             undo move_block, retry move_block .
     1034           end.
     1035         end.
     1036         for each buf_temp-diasize-handle
     1037         on error undo move_block, retry move_block
     1038         :
     1039           assign
     1040             v-object-handle = buf_temp-diasize-handle.handle-value
     1041           .
     1042           if v-object-handle <> v-diasize-resize-button
     1043           then do:
     1044             assign
     1045               v-object-handle :row = v-object-handle :row + p-change-value
     1046               no-error .
     1047             if error-status :error
     1048             or error-status :get-message(1) <> ""
     1049             then do:
     1050               undo move_block, retry move_block .
     1051             end.
     1052           end.
     1053         end.
     1054       end.
     1055       else do:
     1056         for each buf_temp-diasize-handle
     1057         on error undo move_block, retry move_block
     1058         :
     1059           assign
     1060             v-object-handle = buf_temp-diasize-handle.handle-value
     1061           .
     1062           if v-object-handle <> v-diasize-resize-button
     1063           then do:
     1064             assign
     1065               v-object-handle :row = v-object-handle :row + p-change-value
     1066               no-error .
     1067             if error-status :error
     1068             or error-status :get-message(1) <> ""
     1069             then do:
     1070               undo move_block, retry move_block .
     1071             end.
     1072           end.
     1073         end.
     1074         assign
     1075           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1076           no-error .
     1077         if error-status :error
     1078         or error-status :get-message(1) <> ""
     1079         then do:
     1080           undo move_block, retry move_block .
     1081         end.
     1082         for each buf_temp-browse-handle
     1083           where buf_temp-browse-handle.browse-type = 'height':u
     1084         on error undo move_block, retry move_block
     1085         :
     1086           assign
     1087             buf_temp-browse-handle.browse-handle :height
     1088               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1089             no-error .
     1090           if error-status :error
     1091           or error-status :get-message(1) <> ""
     1092           then do:
     1093             undo move_block, retry move_block .
     1094           end.
     1095         end.
     1096         assign
     1097           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1098           no-error .
     1099         if error-status :error
     1100         or error-status :get-message(1) <> ""
     1101         then do:
     1102           undo move_block, retry move_block .
     1103         end.
     1104         if frame Dialog-Frame :scrollable = true
     1105         then do:
     1106           assign
     1107             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1108             no-error .
     1109           if error-status :error
     1110           or error-status :get-message(1) <> ""
     1111           then do:
     1112             undo move_block, retry move_block .
     1113           end.
     1114         end.
     1115       end.
     1116       if p-move-resize = true
     1117       then do:
     1118         run diasize_position-resize-button in this-procedure .
     1119       end.
     1120       if v-diasize-wndstore = true
     1121       then do:
     1122         if connected("ub") = true
     1123         then do:
     1124           define variable v-cntxt-db-num        as integer   no-undo .
     1125           define variable v-cntxt-userid        as character no-undo .
     1126           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1127                                             , OUTPUT v-cntxt-userid
     1128                                             ) .
     1129           run gbl/wndsizew.p
     1130             (input  v-cntxt-db-num
     1131             ,input  v-cntxt-userid
     1132             ,input  v-diasize-proc-name
     1133             ,input  'height':u
     1134             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1135             ) .
     1136         end.
     1137       end.
     1138     end.
     1139     assign
     1140       v-diasize-change-size = false
     1141     .
     1142   end procedure.
     1143   procedure diasize_set-height :
     1144     define input  parameter p-new-height  as decimal   no-undo .
     1145     define input  parameter p-move-resize as logical   no-undo .
     1146     do
     1147     on error undo, return error return-value
     1148     :
     1149       run diasize_change-height in this-procedure
     1150         (input  (p-new-height - frame Dialog-Frame :height)
     1151         ,input  p-move-resize
     1152         ) .
     1153     end.
     1154   end procedure.
     1155   procedure diasize_change-width :
     1156     define input  parameter p-change-value as decimal   no-undo .
     1157     define input  parameter p-move-resize  as logical   no-undo .
     1158     define variable v-field-group-handle   as handle    no-undo .
     1159     define variable v-object-handle        as handle    no-undo .
     1160     define variable v-frame-width          as decimal   no-undo .
     1161     define variable v-frame-virtual-width  as decimal   no-undo .
     1162     define variable v-browse-width         as decimal   no-undo .
     1163     define variable v-window-width         as decimal   no-undo .
     1164     define variable v-window-virtual-width as decimal   no-undo .
     1165     define variable v-change-sign          as integer   no-undo .
     1166     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1167     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1168     if p-change-value > 0
     1169     then do:
     1170       if frame Dialog-Frame :width + p-change-value >
     1171           session :width-chars
     1172       then do:
     1173         assign
     1174           p-change-value = session :width-chars - frame Dialog-Frame :width
     1175         .
     1176         if p-change-value <= 0
     1177         then do:
     1178           run diasize_position-resize-button in this-procedure .
     1179           return .
     1180         end.
     1181       end.
     1182     end.
     1183     if p-change-value < 0
     1184     then do:
     1185       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1186       then do:
     1187         assign
     1188           p-change-value = v-diasize-orig-frame-width
     1189                          - frame Dialog-Frame :width
     1190         .
     1191         if p-change-value >= 0
     1192         then do:
     1193           run diasize_position-resize-button in this-procedure .
     1194           return .
     1195         end.
     1196       end.
     1197     end.
     1198     if p-change-value >= 0
     1199     then do:
     1200       assign
     1201         v-change-sign = 1
     1202       .
     1203     end.
     1204     else do:
     1205       assign
     1206         v-change-sign = -1
     1207       .
     1208     end.
     1209     assign
     1210       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1211     .
     1212     if p-change-value = 0
     1213     then do:
     1214       run diasize_position-resize-button in this-procedure .
     1215       return .
     1216     end.
     1217     move_block:
     1218     do
     1219     on error undo move_block, leave move_block
     1220     :
     1221       if retry
     1222       then do:
     1223         do
     1224         on error undo move_block, leave move_block
     1225         :
     1226           if p-change-value > 0
     1227           then do:
     1228             for each buf_temp-diasize-handle
     1229             on error undo, next
     1230             :
     1231               assign
     1232                 v-object-handle = buf_temp-diasize-handle.handle-value
     1233               .
     1234               if v-object-handle <> v-diasize-resize-button
     1235               then do:
     1236                 assign
     1237                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1238                 .
     1239               end.
     1240             end.
     1241             assign
     1242               v-diasize-browse-handle :width = v-browse-width
     1243             .
     1244             for each buf_temp-browse-handle
     1245               where buf_temp-browse-handle.browse-type = 'width':u
     1246             on error undo, next
     1247             :
     1248               assign
     1249                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1250               .
     1251             end.
     1252             assign
     1253               frame Dialog-Frame :width = v-frame-width
     1254             .
     1255             if frame Dialog-Frame :scrollable = true
     1256             then do:
     1257               assign
     1258                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1259               .
     1260             end.
     1261             run diasize_position-resize-button in this-procedure .
     1262           end.
     1263           else do:
     1264             if frame Dialog-Frame :scrollable = true
     1265             then do:
     1266               assign
     1267                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1268               .
     1269             end.
     1270             assign
     1271               frame Dialog-Frame :width = v-frame-width
     1272             .
     1273             for each buf_temp-browse-handle
     1274               where buf_temp-browse-handle.browse-type = 'width':u
     1275             on error undo, next
     1276             :
     1277               assign
     1278                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1279               .
     1280             end.
     1281             assign
     1282               v-diasize-browse-handle :width = v-browse-width
     1283             .
     1284             for each buf_temp-diasize-handle
     1285             on error undo, next
     1286             :
     1287               assign
     1288                 v-object-handle = buf_temp-diasize-handle.handle-value
     1289               .
     1290               if v-object-handle <> v-diasize-resize-button
     1291               then do:
     1292                 assign
     1293                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1294                 .
     1295               end.
     1296             end.
     1297             run diasize_position-resize-button in this-procedure .
     1298           end.
     1299           assign
     1300             v-diasize-change-size = false
     1301           .
     1302           leave move_block .
     1303         end.
     1304       end.
     1305       assign
     1306         v-diasize-need-full-display = true
     1307       .
     1308       if v-diasize-change-size = false
     1309       then do:
     1310         assign
     1311           v-diasize-change-size = true
     1312         .
     1313       end.
     1314       else do:
     1315         return .
     1316       end.
     1317       assign
     1318         v-frame-width = frame Dialog-Frame :width
     1319         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1320         v-browse-width = v-diasize-browse-handle :width
     1321       .
     1322       for each buf_temp-browse-handle
     1323         where buf_temp-browse-handle.browse-type = 'width':u
     1324       :
     1325         assign
     1326           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1327         .
     1328       end.
     1329       for each buf_temp-diasize-handle
     1330       :
     1331         delete buf_temp-diasize-handle .
     1332       end.
     1333       assign
     1334         v-field-group-handle = frame Dialog-Frame :first-child
     1335       .
     1336       do while valid-handle(v-field-group-handle)
     1337       :
     1338         assign
     1339           v-object-handle = v-field-group-handle :first-child
     1340         .
     1341         do while valid-handle(v-object-handle)
     1342         :
     1343           if  v-object-handle <> v-diasize-browse-handle :handle
     1344           and v-object-handle <> v-diasize-resize-button
     1345           and can-query(v-object-handle, "row")
     1346           and can-query(v-object-handle, "height")
     1347           and ( v-object-handle :col + v-object-handle :width
     1348                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1349               )
     1350           then do:
     1351             find first buf_temp-browse-handle
     1352               where buf_temp-browse-handle.browse-type   = 'width':u
     1353                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1354               no-error .
     1355             if available buf_temp-browse-handle
     1356             then do:
     1357             end.
     1358             else do:
     1359               create buf_temp-diasize-handle .
     1360               assign
     1361                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1362                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1363               .
     1364             end.
     1365           end.
     1366           assign
     1367             v-object-handle = v-object-handle :next-sibling
     1368           .
     1369         end.
     1370         assign
     1371           v-field-group-handle = v-field-group-handle :next-sibling
     1372         .
     1373       end.
     1374       do with frame Dialog-Frame
     1375       :
     1376         hide v-diasize-resize-button .
     1377         v-diasize-resize-button :row = 1.
     1378         v-diasize-resize-button :column = 1.
     1379       end.
     1380       if p-change-value > 0
     1381       then do:
     1382         if frame Dialog-Frame :scrollable = true
     1383         then do:
     1384           assign
     1385             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1386             no-error .
     1387           if error-status :error
     1388           or error-status :get-message(1) <> ""
     1389           then do:
     1390             undo move_block, retry move_block.
     1391           end.
     1392         end.
     1393         assign
     1394           frame Dialog-Frame :width = v-frame-width + p-change-value
     1395           no-error .
     1396         if error-status :error
     1397         or error-status :get-message(1) <> ""
     1398         then do:
     1399           undo move_block, retry move_block.
     1400         end.
     1401         assign
     1402           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1403         no-error .
     1404         if error-status :error
     1405         or error-status :get-message(1) <> ""
     1406         then do:
     1407           undo move_block, retry move_block.
     1408         end.
     1409         for each buf_temp-browse-handle
     1410           where buf_temp-browse-handle.browse-type = 'width':u
     1411         on error undo move_block, retry move_block
     1412         :
     1413           assign
     1414             buf_temp-browse-handle.browse-handle :width
     1415               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1416             no-error .
     1417           if error-status :error
     1418           or error-status :get-message(1) <> ""
     1419           then do:
     1420             undo move_block, retry move_block .
     1421           end.
     1422         end.
     1423         for each buf_temp-diasize-handle
     1424         on error undo move_block, retry move_block
     1425         :
     1426           assign
     1427             v-object-handle = buf_temp-diasize-handle.handle-value
     1428           .
     1429           if v-object-handle <> v-diasize-resize-button
     1430           then do:
     1431             assign
     1432               v-object-handle :col = v-object-handle :col + p-change-value
     1433               no-error .
     1434             if error-status :error
     1435             or error-status :get-message(1) <> ""
     1436             then do:
     1437               undo move_block, retry move_block .
     1438             end.
     1439           end.
     1440         end.
     1441       end.
     1442       else do:
     1443         for each buf_temp-diasize-handle
     1444         on error undo move_block, retry move_block
     1445         :
     1446           assign
     1447             v-object-handle = buf_temp-diasize-handle.handle-value
     1448           .
     1449           if v-object-handle <> v-diasize-resize-button
     1450           then do:
     1451             assign
     1452               v-object-handle :col = v-object-handle :col + p-change-value
     1453               no-error .
     1454             if error-status :error
     1455             or error-status :get-message(1) <> ""
     1456             then do:
     1457               undo move_block, retry move_block .
     1458             end.
     1459           end.
     1460         end.
     1461         for each buf_temp-browse-handle
     1462           where buf_temp-browse-handle.browse-type = 'width':u
     1463         on error undo move_block, retry move_block
     1464         :
     1465           assign
     1466             buf_temp-browse-handle.browse-handle :width
     1467               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1468             no-error .
     1469           if error-status :error
     1470           or error-status :get-message(1) <> ""
     1471           then do:
     1472             undo move_block, retry move_block .
     1473           end.
     1474         end.
     1475         assign
     1476           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1477           no-error .
     1478         if error-status :error
     1479         or error-status :get-message(1) <> ""
     1480         then do:
     1481           undo move_block, retry move_block.
     1482         end.
     1483         assign
     1484           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1485         no-error .
     1486         if error-status :error
     1487         or error-status :get-message(1) <> ""
     1488         then do:
     1489           undo move_block, retry move_block.
     1490         end.
     1491         if frame Dialog-Frame :scrollable = true
     1492         then do:
     1493           assign
     1494             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1495           no-error .
     1496           if error-status :error
     1497           or error-status :get-message(1) <> ""
     1498           then do:
     1499             undo move_block, retry move_block.
     1500           end.
     1501         end.
     1502       end.
     1503       if p-move-resize
     1504       then do:
     1505         run diasize_position-resize-button in this-procedure .
     1506       end.
     1507       if v-diasize-wndstore = true
     1508       then do:
     1509         if connected("ub") = true
     1510         then do:
     1511           define variable v-cntxt-db-num        as integer   no-undo .
     1512           define variable v-cntxt-userid        as character no-undo .
     1513           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1514                                             , OUTPUT v-cntxt-userid
     1515                                             ) .
     1516           run gbl/wndsizew.p
     1517             (input  v-cntxt-db-num
     1518             ,input  v-cntxt-userid
     1519             ,input  v-diasize-proc-name
     1520             ,input  'width':u
     1521             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1522             ) .
     1523         end.
     1524       end.
     1525     end.
     1526     assign
     1527       v-diasize-change-size = false
     1528     .
     1529   end procedure.
     1530   procedure diasize_set-width :
     1531     define input  parameter p-new-width  as decimal   no-undo .
     1532     define input  parameter p-move-resize as logical   no-undo .
     1533     do
     1534     on error undo, return error return-value
     1535     :
     1536       run diasize_change-width in this-procedure
     1537         (input  (p-new-width - frame Dialog-Frame :width)
     1538         ,input  p-move-resize
     1539         ) .
     1540     end.
     1541   end procedure.
     1542   procedure diasize_position-resize-button :
     1543     do with frame Dialog-Frame
     1544     :
     1545       hide v-diasize-resize-button .
     1546       assign
     1547         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1548                     - 1
     1549                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1550         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1551                     - 1
     1552                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1553       .
     1554       view v-diasize-resize-button .
     1555     end.
     1556   end procedure.
     1557   on alt-right anywhere
     1558   do:
     1559     run diasize_change-width in this-procedure
     1560       (input 1
     1561       ,input true
     1562       ) .
     1563     return no-apply .
     1564   end.
     1565   on alt-left anywhere
     1566   do:
     1567     run diasize_change-width in this-procedure
     1568       (input -1
     1569       ,input true
     1570       ) .
     1571     return no-apply .
     1572   end.
     1573   on alt-down anywhere
     1574   do:
     1575     run diasize_change-height in this-procedure
     1576       (input 1
     1577       ,input true
     1578       ) .
     1579     return no-apply .
     1580   end.
     1581   on alt-up anywhere
     1582   do:
     1583     run diasize_change-height in this-procedure
     1584       (input -1
     1585       ,input true
     1586       ) .
     1587     return no-apply .
     1588   end.
     1589   on alt-enter of frame Dialog-Frame
     1590   do:
     1591     run diasize_maximize in this-procedure
     1592       (input  ?
     1593       ).
     1594     return no-apply .
     1595   end.
     1596   procedure diasize_end-move :
     1597     do
     1598     on error undo, return error return-value
     1599     :
     1600       define variable v-row-delta as decimal   no-undo .
     1601       define variable v-col-delta as decimal   no-undo .
     1602       define variable v-new-row as decimal   no-undo .
     1603       define variable v-new-col as decimal   no-undo .
     1604       assign
     1605         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1606         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1607       .
     1608       assign
     1609         v-row-delta = v-new-row - frame Dialog-Frame :height
     1610         v-col-delta = v-new-col - frame Dialog-Frame :width
     1611       .
     1612       run diasize_change-height in this-procedure
     1613         (input v-row-delta
     1614         ,input true
     1615         ) .
     1616       run diasize_change-width in this-procedure
     1617         (input v-col-delta
     1618         ,input true
     1619         ) .
     1620     end.
     1621   end procedure.
     1622   procedure diasize_maximize :
     1623     define input  parameter p-action as logical   no-undo .
     1624     do
     1625     on error undo, return error return-value
     1626     :
     1627       if p-action = ?
     1628       then do:
     1629         if v-diasize-need-maximize = true
     1630         then do:
     1631           assign
     1632             p-action = true
     1633           .
     1634         end.
     1635         else do:
     1636           assign
     1637             p-action = false
     1638           .
     1639         end.
     1640       end.
     1641       if p-action = true
     1642       then do:
     1643         run diasize_change-height in this-procedure
     1644           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1645               - frame Dialog-Frame :height-chars
     1646           ,input true
     1647           ) .
     1648         run diasize_change-width in this-procedure
     1649           (input session :width-chars
     1650               - frame Dialog-Frame :width-chars
     1651           ,input true
     1652           ) .
     1653         assign
     1654           v-diasize-need-maximize = false
     1655         .
     1656       end.
     1657       else do:
     1658         run diasize_change-width in this-procedure
     1659           (input v-diasize-orig-frame-width
     1660               - frame Dialog-Frame :width-chars
     1661           ,input true
     1662           ) .
     1663         run diasize_change-height in this-procedure
     1664           (input v-diasize-orig-frame-height
     1665               - frame Dialog-Frame :height-chars
     1666           ,input true
     1667           ) .
     1668         assign
     1669           v-diasize-need-maximize = true
     1670         .
     1671       end.
     1672     end.
     1673   end procedure.
     1674   procedure diasize_restore-orig-size :
     1675     do
     1676     on error undo, return error return-value
     1677     :
     1678       assign
     1679         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1680         v-diasize-current-frame-height = frame Dialog-Frame :height
     1681       .
     1682       run diasize_set-height in this-procedure
     1683         (input  v-diasize-orig-frame-height
     1684         ,input  true
     1685         ) .
     1686       run diasize_set-width in this-procedure
     1687         (input  v-diasize-orig-frame-width
     1688         ,input  true
     1689         ) .
     1690     end.
     1691   end procedure.
     1692   procedure diasize_restore-current-size :
     1693     do
     1694     on error undo, return error return-value
     1695     :
     1696       run diasize_set-height in this-procedure
     1697         (input  v-diasize-current-frame-height
     1698         ,input  true
     1699         ) .
     1700       run diasize_set-width in this-procedure
     1701         (input  v-diasize-current-frame-width
     1702         ,input  true
     1703         ) .
     1704     end.
     1705   end procedure.
     1706   procedure diasize_set-browse-handle :
     1707     define input  parameter p-browse-handle as handle   no-undo .
     1708     define buffer buf_temp-browse-handle for temp-browse-handle .
     1709     do
     1710     on error undo, return error return-value
     1711     :
     1712       assign
     1713         v-diasize-browse-handle = p-browse-handle
     1714       .
     1715       for each buf_temp-browse-handle
     1716       on error undo, return error return-value
     1717       :
     1718         delete buf_temp-browse-handle .
     1719       end.
     1720     end.
     1721   end procedure.
     1722   procedure diasize_add_browse :
     1723     define input  parameter p-browse-type   as character no-undo .
     1724     define input  parameter p-browse-handle as handle    no-undo .
     1725     define buffer buf_temp-browse-handle for temp-browse-handle .
     1726     do
     1727     on error undo, return error return-value
     1728     :
     1729       assign
     1730         v-diasize-browse-number = v-diasize-browse-number + 1
     1731       .
     1732       create buf_temp-browse-handle .
     1733       assign
     1734         buf_temp-browse-handle.browse-type   = p-browse-type
     1735         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1736         buf_temp-browse-handle.browse-handle = p-browse-handle
     1737       .
     1738     end.
     1739   end procedure.
     1740   procedure diasize_init :
     1741     define variable v-default-value    as logical   no-undo .
     1742     define variable v-restore-saved    as logical   no-undo .
     1743     define variable v-resize-value-str as character no-undo .
     1744     do
     1745     on error undo, return error return-value
     1746     :
     1747       do with frame Dialog-Frame
     1748       :
     1749         assign
     1750           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1751           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1752           v-diasize-browse-handle     = browse br-rule-by-profile :handle
     1753         .
     1754         create button v-diasize-resize-button
     1755         assign
     1756           parent        = frame Dialog-Frame :first-child
     1757           label         = "s"
     1758           height-pixels = 16
     1759           width-pixels  = 16
     1760           visible       = true
     1761           sensitive     = true
     1762           movable       = true
     1763           triggers:
     1764             on end-move persistent run diasize_end-move in this-procedure .
     1765           end triggers.
     1766         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1767         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1768         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1769         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1770         assign
     1771           v-diasize-wndmax = false
     1772         .
     1773         if connected("ub") = true
     1774         then do:
     1775           define variable v-cntxt-db-num        as integer   no-undo .
     1776           define variable v-cntxt-userid        as character no-undo .
     1777           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1778                                             , OUTPUT v-cntxt-userid
     1779                                             ) .
     1780           run gbl/wndpar_r.p
     1781             (input  v-cntxt-db-num
     1782             ,input  v-cntxt-userid
     1783             ,input  'wndmax':U
     1784             ,output v-diasize-wndmax
     1785             ,output v-default-value
     1786             ) .
     1787         end.
     1788         assign
     1789           v-diasize-wndstore = false
     1790         .
     1791         if connected("ub") = true
     1792         then do:
     1793           run gbl/wndpar_r.p
     1794             (input  v-cntxt-db-num
     1795             ,input  v-cntxt-userid
     1796             ,input  'wndstore':U
     1797             ,output v-diasize-wndstore
     1798             ,output v-default-value
     1799             ) .
     1800         end.
     1801         assign
     1802           v-diasize-proc-name = entry(1, program-name(2), '.')
     1803         .
     1804         if v-diasize-wndstore = true
     1805         then do:
     1806           assign
     1807             v-restore-saved = false
     1808           .
     1809           if connected("ub") = true
     1810           then do:
     1811             run gbl/wndsizer.p
     1812               (input  v-cntxt-db-num
     1813               ,input  v-cntxt-userid
     1814               ,input  v-diasize-proc-name
     1815               ,input  'height':u
     1816               ,output v-resize-value-str
     1817               ) .
     1818             if v-resize-value-str <> '':U
     1819             then do:
     1820               run diasize_change-height in this-procedure
     1821                 (input  integer(v-resize-value-str)
     1822                 ,input  true
     1823                 ) .
     1824               assign
     1825                 v-restore-saved = true
     1826               .
     1827             end.
     1828           end.
     1829           if connected("ub") = true
     1830           then do:
     1831             run gbl/wndsizer.p
     1832               (input  v-cntxt-db-num
     1833               ,input  v-cntxt-userid
     1834               ,input  v-diasize-proc-name
     1835               ,input  'width':u
     1836               ,output v-resize-value-str
     1837               ) .
     1838             if v-resize-value-str <> '':U
     1839             then do:
     1840               run diasize_change-width in this-procedure
     1841                 (input  integer(v-resize-value-str)
     1842                 ,input  true
     1843                 ) .
     1844               assign
     1845                 v-restore-saved = true
     1846               .
     1847             end.
     1848           end.
     1849           if v-restore-saved <> true
     1850           then do:
     1851             if v-diasize-wndmax = true
     1852             then do:
     1853               run diasize_maximize in this-procedure
     1854                 (input  true
     1855                 ) .
     1856             end.
     1857           end.
     1858         end.
     1859         else do:
     1860           if v-diasize-wndmax = true
     1861           then do:
     1862             run diasize_maximize in this-procedure
     1863               (input  true
     1864               ) .
     1865           end.
     1866         end.
     1867       end.
     1868     end.
     1869   end procedure.
     1870   procedure diasize_need-full-display :
     1871     define output parameter p-need-full-display as logical   no-undo .
     1872     do
     1873     on error undo, return error return-value
     1874     :
     1875       assign
     1876         p-need-full-display = v-diasize-need-full-display
     1877       .
     1878       assign
     1879         v-diasize-need-full-display = false
     1880       .
     1881     end.
     1882   end procedure.
     1883   procedure get-context :
     1884      define output parameter p-db-num as integer          no-undo.
     1885      define output parameter p-user-id as character        no-undo.
     1886      define variable v-login               as character    no-undo.
     1887      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1888      define buffer buf_user-login  for ub.user-login .
     1889      do
     1890      on error undo, return error
     1891      :
     1892            FIND FIRST buf_sys-ctrl no-lock.
     1893            ASSIGN
     1894               v-login = USERID("ub")
     1895               p-db-num = buf_sys-ctrl.db-num
     1896            .
     1897            FIND FIRST buf_user-login
     1898                 WHERE buf_user-login.db-num = p-db-num
     1899                   AND buf_user-login.user-login = v-login
     1900                 no-lock
     1901                 no-error
     1902                 .
     1903            IF AVAILABLE buf_user-login
     1904            THEN DO:
     1905               assign
     1906                  p-user-id = buf_user-login.user-id
     1907               .
     1908            END.
     1909      end.
     1910   end procedure.
     1911       run diasize_init in this-procedure .
     1912   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1913   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1914   MAIN-BLOCK:
     1915   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1916      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1917   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1918     run mainmenu_getcntxt in parparentproc
     1919       (output v-cntxt-db-num
     1920       ,output v-cntxt-userid
     1921       ,output v-cntxt-level
     1922       ,output v-cntxt-host-code-obj
     1923       ,output v-cntxt-obj-type
     1924       ,output v-cntxt-obj-code
     1925       ,output v-cntxt-db-num-obj
     1926       ,output v-cntxt-is-admin
     1927       ) .
     1928     v-rid-list = p-rid-list.
     1929     run Myenable in this-procedure .
     1930     WAIT-FOR GO OF FRAME Dialog-Frame.
     1931   END.
     1932   RUN disable_UI.
     1933   PROCEDURE disable_UI :
     1934     HIDE FRAME Dialog-Frame.
     1935   END PROCEDURE.
     1936   PROCEDURE enable_UI :
     1937     DISPLAY e-profile mark-num
     1938         WITH FRAME Dialog-Frame.
     1939     ENABLE b-quit b-mark b-sel b-add b-chg b-del b-lkp B-params B-Help
     1940            br-rule-by-profile e-profile mark-num
     1941         WITH FRAME Dialog-Frame.
     1942     VIEW FRAME Dialog-Frame.
     1943     OPEN QUERY br-rule-by-profile FOR EACH X_rule-by-profile NO-LOCK,        first X_rule NO-LOCK indexed-reposition.
     1944   END PROCEDURE.
     1945   PROCEDURE MyEnable :
     1946   ASSIGN
     1947   X_rule.NAME:RESIZABLE IN BROWSE br-rule-by-profile = YES
     1948   b-lkp:MENU-MOUSE in frame Dialog-Frame = 1.
     1949   case p-list-mode:
     1950     when "ruleset" then do:
     1951       assign
     1952       X_rule-by-profile.codex_id:visible in browse br-rule-by-profile = no
     1953       X_rule-by-profile.ruleset_id:visible in browse br-rule-by-profile = no
     1954       .
     1955     end.
     1956     when "codex" then do:
     1957       assign
     1958       X_rule-by-profile.codex_id:visible in browse br-rule-by-profile = no
     1959       .
     1960     end.
     1961     when "profile" then do:
     1962       assign
     1963       X_rule-by-profile.profile_id:visible in browse br-rule-by-profile = no
     1964       .
     1965       HIDE
     1966       e-profile
     1967       IN FRAME Dialog-Frame.
     1968       ASSIGN
     1969       br-rule-by-profile:HEIGHT = br-rule-by-profile:HEIGHT  + 2.47
     1970       .
     1971     end.
     1972     when "rule" then do:
     1973       assign
     1974       X_rule-by-profile.rule_id:visible in browse br-rule-by-profile = no
     1975       .
     1976     end.
     1977   end.
     1978   ENABLE
     1979   b-quit
     1980   b-add when ( p-list-mode = "profile" and v-cntxt-db-num = 0 and lookup("b-add", bttns) > 0)
     1981   b-del when (v-cntxt-db-num = 0  and lookup("b-add", bttns) > 0)
     1982   b-chg when (v-cntxt-db-num = 0  and lookup("b-add", bttns) > 0)
     1983   b-lkp
     1984   B-Help
     1985   b-mark when lookup("b-mark", bttns) > 0
     1986   b-sel when lookup("b-sel", bttns) > 0
     1987   b-params
     1988   br-rule-by-profile
     1989   WITH FRAME Dialog-Frame.
     1990   VIEW FRAME Dialog-Frame.
     1991   run Openbr in this-procedure .
     1992   APPLY "VALUE-CHANGED" TO br-rule-by-profile.
     1993   END PROCEDURE.
     1994   PROCEDURE Openbr :
     1995   CASE p-list-mode:
     1996     WHEN 'все':U THEN DO:
     1997       frame Dialog-Frame:title = "Все правила всех профайлов".
     1998       OPEN QUERY br-rule-by-profile
     1999       FOR EACH X_rule-by-profile NO-LOCK,
     2000           FIRST X_rule NO-LOCK WHERE X_rule.rule_id = X_rule-by-profile.rule_id INDEXED-REPOSITION.
     2001     END.
     2002     WHEN "ruleset" THEN DO:
     2003       frame Dialog-Frame:title = substitute("Все правила профайлов для кодекса правил &1 набора правил &2"
     2004                                              , p-codex-id
     2005                                              , p-ruleset-id).
     2006       OPEN QUERY br-rule-by-profile
     2007       FOR EACH X_rule-by-profile NO-LOCK WHERE
     2008                X_rule-by-profile.codex_id = p-codex-id
     2009             AND X_rule-by-profile.ruleset_id = p-ruleset-id,
     2010           FIRST X_rule NO-LOCK WHERE X_rule.rule_id = X_rule-by-profile.rule_id INDEXED-REPOSITION.
     2011     END.
     2012     WHEN "codex" THEN DO:
     2013       frame Dialog-Frame:title = substitute("Все правила профайлов для кодекса правил &1"
     2014                                             , p-codex-id).
     2015       OPEN QUERY br-rule-by-profile
     2016       FOR EACH X_rule-by-profile NO-LOCK WHERE
     2017                X_rule-by-profile.codex_id = p-codex-id,
     2018           FIRST X_rule NO-LOCK WHERE X_rule.rule_id = X_rule-by-profile.rule_id INDEXED-REPOSITION.
     2019     END.
     2020     WHEN "profile" THEN DO:
     2021       frame Dialog-Frame:title = substitute("Все правила для профайла &1"
     2022                                             , p-profile-id).
     2023       OPEN QUERY br-rule-by-profile
     2024       FOR EACH X_rule-by-profile NO-LOCK WHERE
     2025                X_rule-by-profile.profile_id = p-profile-id,
     2026           FIRST X_rule NO-LOCK WHERE X_rule.rule_id = X_rule-by-profile.rule_id INDEXED-REPOSITION.
     2027     END.
     2028     WHEN "rule" THEN DO:
     2029       frame Dialog-Frame:title = substitute("Все профайлы для правила &1"
     2030                                             , p-rule-id).
     2031       OPEN QUERY br-rule-by-profile
     2032       FOR EACH X_rule-by-profile NO-LOCK WHERE
     2033               X_rule-by-profile.rule_id = p-rule-id,
     2034           FIRST X_rule NO-LOCK WHERE X_rule.rule_id = X_rule-by-profile.rule_id INDEXED-REPOSITION.
     2035    END.
     2036   END CASE.
     2037   END PROCEDURE.
     2038   PROCEDURE proc-b-add-chg :
     2039   define input parameter p-add as logical no-undo .
     2040   define variable v-rid-list as character no-undo .
     2041   define variable v-rec as recid no-undo .
     2042   define variable v-is-dynamic as logical no-undo .
     2043   define variable v-dflt-can-calc as logical   no-undo .
     2044   define variable v-ok as logical no-undo .
     2045   define buffer buf_rule-by-set for ub.rule-by-set.
     2046   define buffer buf_rule-by-profile for ub.rule-by-profile.
     2047   define buffer buf_ruleset for ub.ruleset.
     2048   IF p-list-mode <> "profile" THEN DO:
     2049      MESSAGE
     2050      "Нельзя добавлять в моде " p-list-mode
     2051      VIEW-AS ALERT-BOX ERROR.
     2052      RETURN.
     2053   END.
     2054   CASE p-add:
     2055     when yes then do:
     2056       MESSAGE
     2057       "Выберите набор правил"
     2058       VIEW-AS ALERT-BOX .
     2059       run rul/ruleset-s.w ( input parparentproc
     2060                           ,input "b-sel"
     2061                           ,input 'все':U
     2062                           ,input 0
     2063                           ,input-output v-rid-list) no-error.
     2064         if v-rid-list = '':U then do:
     2065           return.
     2066         end.
     2067       find first buf_ruleset no-lock where
     2068                   recid(buf_ruleset) = integer(v-rid-list).
     2069       .
     2070       v-rid-list  = '':U.
     2071       run rul/rule-by-set-s.w ( input parparentproc
     2072                           ,input "b-sel"
     2073                           ,input "ruleset"
     2074                           ,input buf_ruleset.codex_id
     2075                           ,input buf_ruleset.ruleset_id
     2076                           ,input 0
     2077                           ,input-output v-rid-list) no-error.
     2078         if v-rid-list = '':U then do:
     2079           return.
     2080         end.
     2081       find first buf_rule-by-set no-lock where
     2082                   recid(buf_rule-by-set) = integer(v-rid-list).
     2083       .
     2084       run rul/rule-by-profile1.p ( input 'ДОБАВЛЕНИЕ':U
     2085                                 ,input no
     2086                                 ,input-output v-rec
     2087                                 ,input p-profile-id
     2088                                 ,input buf_ruleset.codex_id
     2089                                 ,input buf_ruleset.ruleset_id
     2090                                 ,input buf_rule-by-set.rule_id
     2091                                 ,input yes
     2092                                 ,input yes
     2093                                 ) no-error.
     2094       if error-status:error then do:
     2095         undo, return error .
     2096       end.
     2097       run openbr in this-procedure .
     2098       reposition br-rule-by-profile to recid v-rec no-error.
     2099       APPLY "ENTRY" to browse br-rule-by-profile.
     2100     end.
     2101     when no then do:
     2102       find first buf_rule-by-profile exclusive-lock where
     2103                 recid(buf_rule-by-profile) = recid(X_rule-by-profile).
     2104       v-is-dynamic = X_rule-by-profile.is_dynamic.
     2105       run gbl/d-logical.w ( input ?
     2106                           ,input 'title=':u + "Задайте свойство ОТКЛЮЧАЕМОЕ" + '\':u
     2107                           ,input-output v-is-dynamic
     2108                           ,output v-ok ) no-error.
     2109       if error-status:error
     2110       or not v-ok then do:
     2111         undo, return error .
     2112       end.
     2113       if v-is-dynamic then do:
     2114         v-ok = no.
     2115         v-dflt-can-calc = X_rule-by-profile.dflt-can-calc.
     2116         run gbl/d-logical.w ( input ?
     2117                             ,input 'title=':u + "Задайте свойство ПО УМОЛЧАНИЮ ВКЛЮЧЕНО" + '\':u
     2118                             ,input-output v-dflt-can-calc
     2119                             ,output v-ok ) no-error.
     2120         if error-status:error
     2121         or not v-ok then do:
     2122           undo, return error .
     2123         end.
     2124       end.
     2125       else do:
     2126          v-dflt-can-calc = yes.
     2127       end.
     2128       v-rec = recid(x_rule-by-profile).
     2129       run rul/rule-by-profile1.p ( input 'ИЗМЕНЕНИЕ':U
     2130                                 ,input no
     2131                                 ,input-output v-rec
     2132                                 ,input X_rule-by-profile.profile_id
     2133                                 ,input X_rule-by-profile.codex_id
     2134                                 ,input X_rule-by-profile.ruleset_id
     2135                                 ,input X_rule-by-profile.rule_id
     2136                                 ,input v-is-dynamic
     2137                                 ,input v-dflt-can-calc
     2138                                 ) no-error.
     2139       if error-status:error then do:
     2140         message error-status:get-message(1) view-as alert-box .
     2141         undo, return error .
     2142       end.
     2143       run openbr in this-procedure .
     2144       reposition br-rule-by-profile to recid v-rec no-error.
     2145       APPLY "ENTRY" to browse br-rule-by-profile.
     2146     end.
     2147   end.
     2148   END PROCEDURE.
     2149   PROCEDURE proc-b-lkp :
     2150   DEFINE INPUT PARAMETER p-option AS CHARACTER NO-UNDO.
     2151   define variable v-rec as recid no-undo .
     2152   CASE p-option:
     2153       WHEN "text"
     2154       OR WHEN "graph" THEN DO:
     2155           run rul/disprule.p (
     2156                          input p-option
     2157                         ,input X_rule-by-profile.rule_id
     2158                         ,input 0
     2159                         ,input 0
     2160                         ,input 0
     2161                         ,input 0
     2162                          ).
     2163       END.
     2164       WHEN "profile" THEN DO:
     2165           run rul/rule-profile-i.w ( INPUT parparentproc
     2166                                ,INPUT 'ПРОСМОТР':U
     2167                                ,INPUT X_rule-by-profile.profile_id
     2168                                ,INPUT-OUTPUT v-rec ) NO-ERROR.
     2169       END.
     2170       WHEN "ruleset" THEN DO:
     2171           run rul/ruleset-i.w ( INPUT parparentproc
     2172                                ,INPUT 'ПРОСМОТР':U
     2173                                ,INPUT X_rule-by-profile.codex_id
     2174                                ,INPUT X_rule-by-profile.ruleset_id
     2175                                ,INPUT-OUTPUT v-rec ) NO-ERROR.
     2176       END.
     2177   END CASE.
     2178   END PROCEDURE.
