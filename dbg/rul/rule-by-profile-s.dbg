        1   DEFINE BUFFER X_rule FOR ub.rule.
        2   DEFINE BUFFER X_rule-by-profile FOR ub.rule-by-profile.
        3   define input parameter parparentproc as widget-handle no-undo .
        4   define input parameter bttns as character no-undo.
        5   DEFINE INPUT PARAMETER p-list-mode AS CHARACTER NO-UNDO.
        6   DEFINE INPUT PARAMETER p-profile-id AS INTEGER NO-UNDO.
        7   DEFINE INPUT PARAMETER p-codex-id AS INTEGER NO-UNDO.
        8   DEFINE INPUT PARAMETER p-ruleset-id AS INTEGER NO-UNDO.
        9   DEFINE INPUT PARAMETER p-rule-id AS INTEGER NO-UNDO.
       10   define input-output parameter p-rid-list as character no-undo.
       11   define variable vss-revision    as character no-undo init "$Revision$":U .
       12   define variable vss-author      as character no-undo init "$Author$":U .
       13   define variable vss-date        as character no-undo init "$Date$":U .
       14   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       15   define variable vss-archive     as character no-undo init "$Archive$":U .
       16   define variable vss-description as character no-undo init "Список rule-by-profile".
       17   procedure vss-get-info :
       18     define output parameter p-vss-revision    like vss-revision    no-undo .
       19     define output parameter p-vss-author      like vss-author      no-undo .
       20     define output parameter p-vss-date        like vss-date        no-undo .
       21     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       22     define output parameter p-vss-archive     like vss-archive     no-undo .
       23     define output parameter p-vss-description like vss-description no-undo .
       24     assign
       25       p-vss-revision    = vss-revision
       26       p-vss-author      = vss-author
       27       p-vss-date        = vss-date
       28       p-vss-workfile    = vss-workfile
       29       p-vss-archive     = vss-archive
       30       p-vss-description = vss-description
       31     .
       32   end procedure.
       33   procedure vss-get-parameters :
       34     define output parameter p-vss-parameters as character no-undo .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       72   define variable v-waitfram-action01         as character   no-undo .
       73   define variable v-waitfram-action02         as character   no-undo .
       74   define variable v-waitfram-action03         as character   no-undo .
       75   define variable mWaitFramTextBeg            as character   no-undo.
       76   define variable mWaitFramTextEnd            as character   no-undo.
       77   define variable mWaitFramView               as logical     no-undo.
       78   define variable mWaitProcEvent              as logical     no-undo init yes.
       79   define variable mWaitFramInterval           as integer     no-undo init 1 .
       80   define variable mWaitFramStop               as logical     no-undo.
       81   define variable mWaitFramStopUser           as logical     no-undo.
       82   define variable mWaitFramStopTimeOut        as logical     no-undo.
       83   define variable mWaitFramStartProc          as datetime-tz no-undo.
       84   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       85   define button B-WaitFramStop auto-end-key
       86        label "Стоп"
       87        size 10 by 1 tooltip "Остоновить процесс".
       88   define button B-viewProcInfo
       89        label "Информация"
       90        size 15 by 1 tooltip "Информация о процесс".
       91   define frame waitfram
       92     v-waitfram-action01 format "x(72)" no-label skip
       93     v-waitfram-action02 format "x(72)" no-label skip
       94     v-waitfram-action03 format "x(72)" no-label skip
       95     B-viewProcInfo
       96     B-WaitFramStop at row 4 col 30
       97     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       98     .
       99   define new global shared variable mBatchMode as logical no-undo init ?.
      100   define variable mFramBachModHandle as handle no-undo.
      101   mFramBachModHandle = frame waitfram:handle.
      102   define variable mFameOldVis as logical no-undo.
      103   define variable mVisCUrentVin as logical no-undo.
      104   if session:batch-mode
      105   then
      106      mBatchMode = yes.
      107   if mBatchMode = ? then do:
      108     mVisCUrentVin = current-window:visible.
      109     mFameOldVis = mFramBachModHandle:visible.
      110     mFramBachModHandle:visible  = yes.
      111     mBatchMode = mFramBachModHandle:visible ne yes.
      112     mFramBachModHandle:visible = mFameOldVis.
      113     current-window:visible = mVisCUrentVin.
      114   end.
      115    if  log-manager:logfile-name ne ?
      116     then DO:
      117         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      118         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      119         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      120     end.
      121   on choose of B-WaitFramStop in frame waitfram
      122   do:
      123     mWaitFramStop = yes.
      124     mWaitFramStopUser = yes.
      125   end.
      126   function waitfram-check-timeout returns logical():
      127      define variable vtime as int64 no-undo.
      128      if mWaitFramStopTimeOut
      129      then
      130         return yes.
      131      vtime = ( now - mWaitFramStartProc ) / 1000 .
      132      if     mWaitFramTimeOut ne ?
      133         and mWaitFramTimeOut ne 0
      134         and mWaitFramTimeOut lt vtime
      135      then do:
      136         mWaitFramStopTimeOut = yes.
      137      end.
      138      return mWaitFramStopTimeOut.
      139   end.
      140   procedure waitfram-hide :
      141     if not session:batch-mode
      142     then do
      143     on error undo, return error return-value
      144     :
      145       pause 0 before-hide .
      146       if not mBatchMode then
      147         hide frame waitfram .
      148     if     not mWaitFramView
      149        and mWaitProcEvent
      150     then
      151       process events .
      152     end.
      153   end procedure.
      154   procedure waitfram-show :
      155     define input  parameter p-message as character no-undo .
      156     define variable v-left-margin as integer   no-undo .
      157     if not session:batch-mode
      158     then do
      159     on error undo, return error return-value
      160     :
      161       if length(p-message) <= 70 then do:
      162         assign
      163           v-left-margin = integer((70 - length(p-message)) / 2)
      164         .
      165         assign
      166           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      167         .
      168         assign
      169           v-waitfram-action01 = " "
      170           v-waitfram-action02 = " "
      171                                    + fill(" ", v-left-margin)
      172                                    + p-message
      173           v-waitfram-action03 = " "
      174         .
      175       end.
      176       else do:
      177         define variable vRindex1 as integer no-undo.
      178         define variable vRindex2 as integer no-undo.
      179         vRindex1 = r-index(p-message," ",70).
      180         if vRindex1 = 0
      181         then
      182            vRindex1 = 70.
      183         if length(p-message)  <= vRindex1 + 70 then do:
      184           assign
      185             v-waitfram-action01 = " "
      186             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      187             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      188           .
      189         end.
      190         else do:
      191           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      192           if vRindex2 <= vRindex1
      193           then
      194              vRindex2 = vRindex1 + 70.
      195           assign
      196             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      197             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      198             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      199           .
      200         end.
      201       end.
      202       B-viewProcInfo:visible   in frame waitfram = no.
      203       B-viewProcInfo:sensitive in frame waitfram = no.
      204       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      205       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      206       if  (   mWaitFramView
      207          or  mWaitProcEvent)
      208          and not mBatchMode
      209       then
      210          display
      211             v-waitfram-action01 skip
      212             v-waitfram-action02 skip
      213             v-waitfram-action03 skip
      214          with frame waitfram .
      215       if     mWaitFramView
      216          then do:
      217             if     mWaitFramInterval ne ?
      218                and not mBatchMode
      219             then
      220                wait-for go of frame waitfram pause mWaitFramInterval.
      221          end.
      222          else
      223             if     mWaitProcEvent
      224                and not mBatchMode
      225             then
      226                process events .
      227     end.
      228   end procedure.
      229      procedure waitfram-show-this:
      230         define input  parameter iInterval as int64 no-undo.
      231         define variable vtime as int64 no-undo.
      232         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      233         mWaitFramInterval = iInterval.
      234         run waitfram-show (substitute("&1&2 &3&4" ,
      235                                       mWaitFramTextBeg ,
      236                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      237                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      238                                       mWaitFramTextEnd
      239                                      )
      240                           ).
      241      end.
      242      procedure WaitFramRunPause:
      243         define input  parameter iInterval as dec no-undo.
      244         define variable vStart  as datetime-tz no-undo.
      245         define variable vend    as datetime-tz no-undo.
      246         define variable vint as int64 no-undo.
      247         define variable vOk as logical no-undo.
      248         vStart = now.
      249         vend   = vStart.
      250         publish "WaitFramPause" (iInterval,output vOk).
      251         vend   =  now.
      252         vint = vend - vStart.
      253         vint = iInterval - vint / 1000.
      254         if     not mWaitFramStop
      255            and (   vint > 0
      256                 or (    not vOk
      257                     and iInterval eq ?
      258                     )
      259                 )
      260         then
      261            run waitfram-show-this (iInterval).
      262         vend   =  now.
      263         vint = vend - vStart.
      264         vint = iInterval - vint / 1000.
      265         if     not mWaitFramStop
      266            and vint > 0
      267         then do:
      268            run gbl/pause.p (vint * 1000).
      269         end.
      270         if iInterval ne ?
      271         then
      272            publish "WaitFramStop".
      273         waitfram-check-timeout().
      274      end.
      275      procedure WaitFramWaitFor:
      276         define input  parameter iInterval as dec no-undo.
      277         assign
      278            mWaitFramStartProc   = now
      279            mWaitFramStopUser    = no
      280            mWaitFramStopTimeOut = no
      281         .
      282         block-wait:
      283         do while not mWaitFramStop:
      284            run WaitFramRunPause (iInterval).
      285            if  waitfram-check-timeout()
      286            then do:
      287               leave block-wait.
      288            end.
      289         end.
      290         run waitfram-hide.
      291      end.
      292   procedure waitfram-join :
      293     define input  parameter p-line-1  as character no-undo .
      294     define input  parameter p-line-2  as character no-undo .
      295     define input  parameter p-line-3  as character no-undo .
      296     define output parameter p-message as character no-undo .
      297     do
      298     on error undo, return error return-value
      299     :
      300       assign
      301         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      302                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      303                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      304       .
      305     end.
      306   end procedure.
      307   function waitfram-join-function returns character
      308     (input p-line-1 as character
      309     ,input p-line-2 as character
      310     ,input p-line-3 as character
      311     ).
      312     define variable v-message as character no-undo .
      313     run waitfram-join in this-procedure
      314       (input  p-line-1
      315       ,input  p-line-2
      316       ,input  p-line-3
      317       ,output v-message
      318       ) .
      319     return v-message .
      320   end function .
      321   define new global shared variable g#language as character no-undo .
      322   if g#language <> '' and g#language <> 'rus':U then do:
      323     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      324   end.
      325   procedure proc-alt-shift-f2:
      326     if not ibs.th.gbl.gbl-var:rcode
      327   then
      328     run gbl\inidebug.p .
      329   end.
      330   procedure proc-alt-shift-f3:
      331     run gbl/prvssinf.p
      332       ( input this-procedure
      333       ) .
      334   end.
      335   define variable v-inform-launched as logical no-undo initial false .
      336   procedure proc-alt-shift-f4:
      337     define variable v-action as character no-undo .
      338     if v-inform-launched = false then do:
      339       assign
      340         v-inform-launched = true
      341       .
      342       run gbl/d-inform.w
      343         (  input self
      344         ,  input this-procedure
      345         , output v-action
      346         ) no-error .
      347       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      348       assign
      349         v-inform-launched = false
      350       .
      351     end.
      352   end.
      353   procedure proc-alt-f1:
      354     run gbl/corrhelp.p
      355       (input this-procedure
      356       ) .
      357   end .
      358   on alt-shift-f2 anywhere do:
      359     run proc-alt-shift-f2.
      360   end.
      361   on alt-shift-f3 anywhere do:
      362     run proc-alt-shift-f3 in this-procedure .
      363   end.
      364   on alt-shift-f4 anywhere do:
      365     run proc-alt-shift-f4 in this-procedure.
      366   end.
      367   on alt-f1 anywhere do:
      368     run proc-alt-f1 in this-procedure .
      369   end.
      370   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      371     define variable v-cntxt-db-num        as integer   no-undo .
      372     define variable v-cntxt-userid        as character no-undo .
      373     define variable v-cntxt-level         as character no-undo .
      374     define variable v-cntxt-host-code-obj as integer   no-undo .
      375     define variable v-cntxt-obj-type      as character no-undo .
      376     define variable v-cntxt-obj-code      as integer   no-undo .
      377     define variable v-cntxt-db-num-obj    as integer   no-undo .
      378     define variable v-cntxt-is-admin      as logical   no-undo .
      379   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      380   FUNCTION mark-string RETURNS CHARACTER
      381     ( input p-recid as recid, input mark-list as character  ) :
      382     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      383   END FUNCTION.
      384   DEFINE VARIABLE v-doc-rec AS RECID NO-UNDO.
      385   DEFINE VARIABLE lkp-option AS CHARACTER NO-UNDO.
      386   define variable v-rid-list as character no-undo .
      387   DEFINE MENU MENU-b-lkp
      388          MENU-ITEM m_ruleset      LABEL "Кодекс/Набор правил"
      389          MENU-ITEM m_profile      LABEL "Профайл"
      390          MENU-ITEM m_text         LABEL "Правило-Текст"
      391          MENU-ITEM m_graph        LABEL "Правило-Граф"  .
      392   DEFINE BUTTON b-add
      393        LABEL "&Добавить"
      394        SIZE 10 BY 1.
      395   DEFINE BUTTON b-chg
      396        LABEL "&Изменить"
      397        SIZE 10 BY 1.
      398   DEFINE BUTTON b-del
      399        LABEL "&Удалить"
      400        SIZE 10 BY 1.
      401   DEFINE BUTTON B-Help
      402        LABEL "Помо&щь"
      403        SIZE 3 BY 1
      404        BGCOLOR 8 .
      405   DEFINE BUTTON b-lkp
      406        LABEL "&Просмотр"
      407        SIZE 10 BY 1.
      408   DEFINE BUTTON b-mark
      409        LABEL "&*"
      410        SIZE 4 BY 1.
      411   DEFINE BUTTON B-params
      412        LABEL "Пар-ры"
      413        SIZE 10 BY 1.
      414   DEFINE BUTTON b-quit AUTO-END-KEY
      415        LABEL "&Выход"
      416        SIZE 10 BY 1
      417        BGCOLOR 8 .
      418   DEFINE BUTTON b-sel AUTO-GO
      419        LABEL "Выбор"
      420        SIZE 10 BY 1.
      421   DEFINE VARIABLE e-profile AS CHARACTER
      422        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      423        SIZE 97.5 BY 2.46 NO-UNDO.
      424   DEFINE VARIABLE mark-num AS INTEGER FORMAT "->,>>>,>>9":U INITIAL 0
      425         VIEW-AS TEXT
      426        SIZE 9 BY .67
      427        FGCOLOR 10  NO-UNDO.
      428   DEFINE QUERY br-rule-by-profile FOR
      429         X_rule-by-profile,
      430         X_rule SCROLLING.
      431   DEFINE BROWSE br-rule-by-profile
      432     QUERY br-rule-by-profile NO-LOCK DISPLAY
      433         mark-string(recid(X_rule-by-profile), v-rid-list) Format "X(1)" COLUMN-LABEL "*"
      434   X_rule-by-profile.PROFILE_id COLUMN-LABEL "Профайл" FORMAT ">>>>>>>>9"
      435   X_rule-by-profile.codex_id COLUMN-LABEL "Кодекс!правил" FORMAT ">>>>>>>>9"
      436   X_rule-by-profile.ruleset_id COLUMN-LABEL "Набор!правил" FORMAT ">>>>>>>>9"
      437   X_rule-by-profile.rp_order_id COLUMN-LABEL "Порядок!вызова" FORMAT ">>9"
      438   X_rule-by-profile.rule_id COLUMN-LABEL "№ правила" FORMAT ">>>>>>>>9"
      439   X_rule-by-profile.is_dynamic COLUMN-LABEL "Отклю!чаемое" FORMAT "+/"
      440   X_rule-by-profile.dflt-can-calc COLUMN-LABEL "По умолч!включ" FORMAT "+/"
      441   X_rule.name COLUMN-LABEL "Название правила" FORMAT "X(255)" WIDTH 45
      442       WITH NO-ROW-MARKERS SEPARATORS SIZE 97.5 BY 18 FIT-LAST-COLUMN.
      443   DEFINE FRAME Dialog-Frame
      444        b-quit AT ROW 1 COL 1
      445        b-mark AT ROW 1 COL 24 WIDGET-ID 12
      446        b-sel AT ROW 1 COL 28 WIDGET-ID 10
      447        b-add AT ROW 1 COL 38 WIDGET-ID 2
      448        b-chg AT ROW 1 COL 48 WIDGET-ID 4
      449        b-del AT ROW 1 COL 58 WIDGET-ID 8
      450        b-lkp AT ROW 1 COL 68 WIDGET-ID 6
      451        B-params AT ROW 1 COL 78 WIDGET-ID 16
      452        B-Help AT ROW 1 COL 95
      453        br-rule-by-profile AT ROW 2.33 COL 1 WIDGET-ID 100
      454        e-profile AT ROW 20.42 COL 1 NO-LABEL WIDGET-ID 18
      455        mark-num AT ROW 1 COL 13 COLON-ALIGNED NO-LABEL WIDGET-ID 14
      456        SPACE(74.51) SKIP(21.20)
      457       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      458            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      459            TITLE "Привязка правил к профайлам"
      460            CANCEL-BUTTON b-quit.
      461   ASSIGN
      462          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      463          FRAME Dialog-Frame:HIDDEN           = TRUE.
      464   ASSIGN
      465          b-lkp:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-b-lkp:HANDLE.
      466   ON GO OF FRAME Dialog-Frame
      467   DO:
      468     p-rid-list = v-rid-list.
      469   END.
      470   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      471   DO:
      472     APPLY "END-ERROR":U TO SELF.
      473   END.
      474   ON CHOOSE OF b-add IN FRAME Dialog-Frame
      475   DO:
      476     run proc-b-add-chg in this-procedure ( input yes) no-error.
      477     if error-status:error then return no-apply.
      478   END.
      479   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
      480   DO:
      481     define variable v-rec as recid no-undo.
      482     if not available X_rule-by-profile then return no-apply.
      483     run proc-b-add-chg in this-procedure ( input no) no-error.
      484     if error-status:error then return no-apply.
      485   END.
      486   ON CHOOSE OF b-del IN FRAME Dialog-Frame
      487   DO:
      488     define variable v-rec as recid no-undo.
      489     define variable glog as logical no-undo.
      490     if not available X_rule-by-profile then return no-apply.
      491     v-rec = recid(X_rule-by-profile).
      492     message "Вы уверены, что хотите удалить привязку ПРАВИЛА К наборам профайлам?"
      493     view-as alert-box question buttons yes-no update glog.
      494     if not glog then return no-apply.
      495     run rul/rule-by-profile3.p (
      496                               input no
      497                              ,input v-rec
      498                                 ) no-error.
      499     if error-status:error then return no-apply.
      500     run openbr in this-procedure .
      501   END.
      502   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
      503   DO:
      504     define variable v-rec as recid no-undo.
      505     if not available X_rule-by-profile then return no-apply.
      506     v-rec = recid(X_rule-by-profile).
      507       if lkp-option = '':U then do:
      508       run gbl/pop-up.p ( input self :handle, input no ) no-error.
      509       if error-status:error then do: return no-apply. end.
      510       if lkp-option = '':U then return no-apply.
      511       run proc-b-lkp in this-procedure ( input lkp-option) no-error.
      512       if error-status:error then do:
      513         lkp-option = '':U.
      514         return no-apply.
      515       end.
      516       lkp-option = '':U.
      517     end.
      518   END.
      519   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
      520   DO:
      521       define variable glog as logical no-undo .
      522     if available X_rule-by-profile then do:
      523   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      524   define variable v-str-recid4 as character no-undo .
      525   define variable v-num-entry4 as integer   no-undo .
      526   assign
      527     v-str-recid4 = trim( string( recid( X_rule-by-profile ) , "->>>>>>>>>>>9":U ) )
      528     v-num-entry4 = lookup( v-str-recid4 , v-rid-list )
      529   .
      530   if v-num-entry4 > 0 then do:
      531     assign
      532       entry( v-num-entry4, v-rid-list ) = "":U
      533       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
      534     .
      535   end.
      536   else do:
      537     assign
      538       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid4
      539     .
      540   end.
      541     glog = br-rule-by-profile:refresh() .
      542     if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
      543         glog = br-rule-by-profile:select-next-row ().
      544         apply "VALUE-CHANGED" to br-rule-by-profile in frame Dialog-Frame.
      545     end.
      546     if num-entries( v-rid-list ) = 0
      547     then
      548         hide mark-num in frame Dialog-Frame.
      549     else
      550         disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
      551   end.
      552   apply "entry" to br-rule-by-profile in frame Dialog-Frame.
      553   END.
      554   ON CHOOSE OF B-params IN FRAME Dialog-Frame
      555   DO:
      556    DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
      557     IF NOT AVAILABLE X_rule-by-profile THEN RETURN NO-APPLY.
      558     run rul/rp-rule-param-s.w ( INPUT parparentproc
      559                                ,INPUT (IF (v-cntxt-db-num = 0  and lookup("b-add", bttns) > 0) THEN "b-chg" ELSE '')
      560                                ,INPUT "rule-id"
      561                                ,INPUT X_rule-by-profile.profile_id
      562                                ,INPUT X_rule-by-profile.codex_id
      563                                ,INPUT X_rule-by-profile.ruleset_id
      564                                ,INPUT X_rule-by-profile.rp_order_id
      565                                ,INPUT X_rule-by-profile.rule_id
      566                                ,INPUT-OUTPUT v-rid-list) NO-ERROR.
      567   END.
      568   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
      569   DO:
      570     if available X_rule-by-profile then do:
      571       if  ( v-rid-list = "" ) or b-mark:sensitive = no
      572       then  v-rid-list = string( recid( X_rule-by-profile ) ) .
      573     end.
      574   END.
      575   ON VALUE-CHANGED OF br-rule-by-profile IN FRAME Dialog-Frame
      576   DO:
      577   DEFINE BUFFER buf_rule-profile FOR ub.rule-profile.
      578     IF AVAILABLE X_rule-by-profile THEN DO:
      579        FIND FIRST buf_rule-profile NO-LOCK WHERE
      580               buf_rule-profile.profile_id = X_rule-by-profile.profile_id NO-ERROR.
      581        IF AVAILABLE buf_rule-profile  THEN DO:
      582            e-profile:screen-value = buf_rule-profile.NAME.
      583        END.
      584        ELSE DO:
      585            e-profile:screen-value = "".
      586        END.
      587     END.
      588     ELSE DO:
      589        e-profile:screen-value = "".
      590     END.
      591   END.
      592   ON CHOOSE OF MENU-ITEM m_graph
      593   DO:
      594     ASSIGN
