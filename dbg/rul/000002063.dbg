     1931   and buf_rule-call-param.order_id = p-order-id
     1932   and buf_rule-call-param.rule_id = p-rule-id
     1933   and buf_rule-call-param.param-name = "p-level"
     1934    no-error.
     1935   if available buf_rule-call-param then do:
     1936   assign p-level = buf_rule-call-param.param-value-integer.
     1937   end.
     1938     find first buf_rule-call-param no-lock where
