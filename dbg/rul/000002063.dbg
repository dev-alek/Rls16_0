     1984   and buf_rule-call-param.ruleset_id = p-ruleset-id
     1985   and buf_rule-call-param.call_id = p-call-id
     1986   and buf_rule-call-param.order_id = p-order-id
     1987   and buf_rule-call-param.rule_id = p-rule-id
     1988   and buf_rule-call-param.param-name = "p-cp-grp"
     1989    no-error.
     1990   if available buf_rule-call-param then do:
