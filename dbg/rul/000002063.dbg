     1625   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1626   procedure set-error :
     1627   define input parameter p-mess as character no-undo .
     1628     do
     1629     on error undo, return error
     1630     :
     1631        assign
     1632        v-last-error-message = p-mess.
     1633     end.
