     1943   and buf_rule-call-param.rule_id = p-rule-id
     1944   and buf_rule-call-param.param-name = "p-weight"
     1945    no-error.
     1946   if available buf_rule-call-param then do:
     1947   assign p-weight = buf_rule-call-param.param-value-logical.
     1948   end.
     1949     find first buf_rule-call-param no-lock where
     1950   buf_rule-call-param.codex_id = p-codex-id
     1951   and buf_rule-call-param.ruleset_id = p-ruleset-id
     1952   and buf_rule-call-param.call_id = p-call-id
     1953   and buf_rule-call-param.order_id = p-order-id
     1954   and buf_rule-call-param.rule_id = p-rule-id
     1955   and buf_rule-call-param.param-name = "p-pump-one"
     1956    no-error.
     1957   if available buf_rule-call-param then do:
     1958   assign p-pump-one = buf_rule-call-param.param-value-logical.
     1959   end.
     1960     find first buf_rule-call-param no-lock where
     1961   buf_rule-call-param.codex_id = p-codex-id
     1962   and buf_rule-call-param.ruleset_id = p-ruleset-id
     1963   and buf_rule-call-param.call_id = p-call-id
     1964   and buf_rule-call-param.order_id = p-order-id
     1965   and buf_rule-call-param.rule_id = p-rule-id
     1966   and buf_rule-call-param.param-name = "p-whole-gds"
     1967    no-error.
     1968   if available buf_rule-call-param then do:
     1969   assign p-whole-gds = buf_rule-call-param.param-value-logical.
     1970   end.
     1971     find first buf_rule-call-param no-lock where
     1972   buf_rule-call-param.codex_id = p-codex-id
     1973   and buf_rule-call-param.ruleset_id = p-ruleset-id
     1974   and buf_rule-call-param.call_id = p-call-id
     1975   and buf_rule-call-param.order_id = p-order-id
