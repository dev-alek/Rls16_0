     1479                                 "rpt" + string( g#report-num ) + ".frm":U ) .
     1480      os-delete value( string( session:temp-directory ) +
     1481                                 "rpt" + string( g#report-num ) + ".txl":U ) .
     1482      if Make-Excel
     1483      then do:
     1484         output stream ForExcel to value( string( session:temp-directory +
     1485                                        "rpt" + string( g#report-num ) + ".txt":U ) ) .
     1486         assign
     1487            v-excel-file = string( session:temp-directory + "rpt" + string( g#report-num ) )
     1488            number-list = 1
     1489         .
     1490         if make-excel-com
     1491         then do:
     1492   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1493   if valid-handle(ch#WorkSheet) then
     1494   RELEASE OBJECT ch#WorkSheet no-error.
     1495   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1496   if valid-handle(ch#Workbook) then
     1497   RELEASE OBJECT ch#Workbook no-error.
     1498   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1499   if valid-handle(ch#ExcelApplication) then
     1500   RELEASE OBJECT ch#ExcelApplication no-error.
     1501            create "Excel.Application" ch#excelApplication connect no-error.
     1502            if error-status:error
     1503            then do :
     1504           create "Excel.Application" ch#excelApplication no-error.
     1505       if error-status :error then do:
     1506           message
     1507           "Ошибка при запуске Excel" skip
     1508           error-status :get-message(1) skip
     1509           view-as alert-box error .
     1510           undo, return error .
     1511       end.
     1512            end.
     1513            assign
     1514               num#str#  = 0.
     1515               v-ch#excelApplication  = ch#excelApplication.
     1516               v-ch#excelApplication:Interactive = false.
     1517               v-ch#excelApplication:ScreenUpdating = false.
     1518               v-ch#excelApplication:Visible = false.
     1519               ch#Workbook  = v-ch#excelApplication:Workbooks:add ().
     1520               ch#WorkSheet = v-ch#excelApplication:Sheets:Item (1).
     1521               v-ch#Worksheet = ch#WorkSheet.
     1522               v-ch#Worksheet:Range ("A1"):Font:Bold = true.
     1523               v-ch#Worksheet:Range ("A1"):Font:Size = 14.
     1524               v-ch#Worksheet:Range ("A1"):HorizontalAlignment = -4131.
     1525               v-ch#Worksheet:Range ("A1"):VerticalAlignment   = -4160
     1526            no-error .
     1527            if error-status:error
     1528            then do:
     1529               Make-Excel-com = false .
     1530               Make-Excel = false .
     1531               output Stream  ForExcel close.
     1532               os-delete value( string( session:temp-directory ) +
     1533                              "rpt" + string( g#report-num ) + ".txt":U ) .
     1534               os-delete value( string( session:temp-directory ) +
     1535                              "rpt" + string( g#report-num ) + ".frm":U ) .
     1536               return.
     1537            end.
     1538         end.
     1539      end.
     1540   end.
     1541   procedure CloseForExcel :
     1542      define variable ii as integer no-undo .
     1543      define variable vsheet-num as integer no-undo.
     1544      if Make-Excel
     1545      then  do:
     1546         output Stream  ForExcel close.
     1547         os-delete value( string( session:temp-directory ) +
     1548                                "rpt" + string( g#report-num ) + ".txt":U ) .
     1549         os-delete value( string( session:temp-directory ) +
     1550                                "rpt" + string( g#report-num ) + ".frm":U ) .
     1551         define buffer buf_sheetf for sheetf.
     1552         find last buf_sheetf no-error .
     1553         if available buf_sheetf
     1554         then
     1555            vsheet-num = buf_sheetf.sheet-num.
     1556         if vsheet-num > 1
     1557         then do:
     1558            do ii = 2 to vsheet-num:
     1559               os-delete value( string( session:temp-directory ) +
     1560                                     "rpt" + string( g#report-num ) + ".":U  + string(ii)) .
     1561            end.
     1562         end.
     1563   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1564   if valid-handle(ch#WorkSheet) then
     1565   RELEASE OBJECT ch#WorkSheet no-error.
     1566   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1567   if valid-handle(ch#Workbook) then
     1568   RELEASE OBJECT ch#Workbook no-error.
     1569   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1570   if valid-handle(ch#ExcelApplication) then
     1571   RELEASE OBJECT ch#ExcelApplication no-error.
     1572      end.
     1573   end.
