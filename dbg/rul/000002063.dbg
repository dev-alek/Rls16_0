     1635   define variable p-tog as logical no-undo extent 10.
     1636   define variable p-weight as logical no-undo .
     1637   define variable p-classify as character no-undo .
     1638   define variable p-sorttype as character no-undo .
     1639   define variable p-level as integer no-undo .
     1640   define variable p-pump-one as logical no-undo .
     1641   define variable p-whole-gds as logical no-undo .
     1642   define variable p-el-icnt as logical no-undo .
     1643   define variable p-cp-grp as logical no-undo .
     1644   define variable p-output-type as character no-undo .
     1645   define variable p-line-of-page as integer no-undo .
     1646   define variable p-reporth as handle no-undo .
     1647   on delete of this-procedure do:
     1648     run garbcoll_clear in this-procedure .
     1649   end.
     1650   run load-ruleset-context in this-procedure ( input p-ruleset-id) no-error.
     1651   if error-status:error then do:
     1652     undo, return error return-value .
     1653   end.
     1654   if not this-procedure:persistent then do:
     1655     run proc-main in this-procedure no-error .
     1656     if error-status:error then do:
     1657       v-es = error-status:error .
     1658       v-rv = return-value .
     1659     end.
     1660     if v-es then do:
     1661         run garbcoll_clear in this-procedure .
     1662         undo, return error substitute( "&1. &2&3&4", vss-workfile, v-rv, chr(10), v-esm).
     1663     end.
     1664     run garbcoll_clear in this-procedure .
     1665   end.
     1666   procedure proc-main :
     1667   define variable p-data-datetime as datetime no-undo .
     1668   DEFINE VARIABLE v-today as date no-undo .
     1669   DEFINE VARIABLE v-time as integer no-undo .
     1670   define variable v-report-id as character no-undo .
     1671   define variable v-start-datetime as datetime no-undo .
     1672   define variable v-base-code as integer no-undo .
     1673   define variable glog as logical no-undo .
     1674   define variable v-host-code as integer no-undo .
     1675   define variable v-value-character as character no-undo .
     1676   define variable v-value-date as date no-undo .
     1677   define variable v-value-decimal as decimal no-undo .
     1678   define variable v-value-integer as integer no-undo .
     1679   define variable v-value-logical as logical no-undo .
     1680   define variable v-p-index as integer no-undo .
     1681   define buffer buf_currency for ub.currency.
     1682   define buffer buf_clients for ub.clients.
     1683   define buffer buf_temp-rule-call-param for temp-rule-call-param.
     1684   define buffer buf2_temp-rule-call-param for temp-rule-call-param.
     1685   _main:
     1686   do
     1687   on error undo, return error substitute( "&1&2&3&2&4", return-value, chr(10), error-status :get-message (1), v-last-error-message)
     1688   :
     1689     empty temp-table report-headert.
     1690     empty temp-table report-parameterst.
     1691     empty temp-table report-errorst.
     1692     empty temp-table report-destinationt.
     1693     v-report-id = substitute("&1/&2", p-profile-id, p-rule-id).
     1694   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1695   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1696     (input  buf_shift-obj.obj-type
     1697     ,input  buf_shift-obj.obj-code
     1698     ,output v-host-code
     1699     )  .
     1700   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1701   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     1702     (input  v-host-code
     1703     ,output v-base-code
     1704     )  .
     1705     find first buf_currency no-lock
     1706       where buf_currency.curr-code = v-base-code
     1707     .
     1708     find first buf_clients no-lock where
     1709               buf_clients.obj-type = buf_shift-obj.obj-type
     1710          and  buf_clients.obj-code = buf_shift-obj.obj-code.
     1711     v-start-datetime = cur-time-datetime().
     1712     assign
     1713     X-date-start = buf_shift-obj.shift-date
     1714     X-shift-start = buf_shift-obj.shift-num
     1715     X-date-end = buf_shift-obj.shift-date
     1716     X-shift-end = buf_shift-obj.shift-num
     1717     .
     1718     define variable classify as character no-undo .
     1719     define variable sorttype as character no-undo .
     1720     classify = p-classify.
     1721     sorttype  = p-sorttype.
     1722   def var t-class as char no-undo.
     1723   def var t-sort as char no-undo.
     1724     case classify:
     1725       when "no-classify":u    then t-class =   "Без классификации" .
     1726       when "prod":u           then t-class =   "Производители"   .
     1727       when "post":u           then t-class =   "Поставщики"   .
     1728       when "grp-goods":u      then t-class =   "Группы товаров"  .
     1729       when "post/grp-goods":u then t-class =   "Поставщики/Группы товаров" .
     1730       when "prod/grp-goods":u then t-class =   "Производители/Группы товаров" .
     1731       when "grp-goods/prod":u then t-class =   "Группы товаров/Производители" .
     1732       when "grp-goods/post":u then t-class =   "Группы товаров/Поставщики" .
     1733       when  "vat-ps":u        then t-class =   "Ставка НДС" .
     1734       when  "sort":u          then t-class =   "Проба(Сорт)" .
     1735       when  "n-level":u       then t-class =   "Группы с уровнем вложенности " .
     1736       when  "t-level":u       then t-class =   "Терминальные группы" .
     1737    end case.
     1738     case sorttype:
     1739       when "sort-pp":u               then t-sort =   "по порядку" .
     1740       when "sort-code":u             then t-sort =   "по коду" .
     1741       when "sort-artic":u            then t-sort =   "по артикулу"  .
     1742       when "sort-qunty":u            then t-sort =   "по реализации".
     1743       when "sort-name":u             then t-sort =   "по наименованию".
     1744       when "sort-type":u             then t-sort =   "по типу ткани".
     1745       when "sort-doc-code":u         then t-sort =   "по номеру документа".
     1746       when "sort-recipe-code":u      then t-sort =   "по номеру рецепта".
     1747    end case.
     1748     assign
     1749     reportname = "СМЕННЫЙ ОТЧЕТ"
     1750     str1 = "Выбор товара: по всем товарам"
     1751     str2 = "Выбор объекта: " + chr(10) + buf_clients.obj-name
     1752     ReportHeader = "Классификация : " + t-class +
     1753                   ( IF p-tog[3] = YES AND Classify = "n-level":U THEN STRING( p-level ) ELSE " " ) + chr(10) +
     1754                   "Сортировка " + t-Sort + chr(10)
     1755     .
     1756     if lookup('excel':U, p-output-type) > 0 then do:
     1757       make-excel = yes.
     1758       my-handle = parparentproc.
     1759       run get-report-num in parparentproc ( output g#report-num).
     1760       run OpenForExcel in this-procedure  .
     1761     end.
     1762     run rep/r-shift.p
     1763     ( input parparentproc
     1764     ,input p-parent-handle
     1765     ,input p-log-handle
     1766     ,input p-cont-handle
     1767     ,input this-procedure:handle
     1768     ,input (buffer report-errorst:handle)
     1769     ,input (buffer report-destinationt:handle)
     1770     ,input substitute("&1/&2", p-profile-id, p-rule-id)
     1771     ,input ''
     1772     ,input log-file-name
     1773     ,input integer('2':U)
     1774     ,input p-codex-id
     1775     ,input p-ruleset-id
     1776     ,INPUT buf_shift-obj.obj-code
     1777     ,INPUT buf_shift-obj.obj-type
     1778     ,INPUT buf_currency.curr-abbr
     1779     ,INPUT v-base-code
     1780     ,input p-line-of-page
     1781     ,input p-weight
     1782     ,INPUT p-Classify
     1783     ,INPUT p-SortType
     1784     ,input (p-level > 0)
     1785     ,input p-level
     1786     ,INPUT p-tog[1]
     1787     ,INPUT p-tog[2]
     1788     ,input p-tog[3]
     1789     ,input p-tog[4]
     1790     ,input p-tog[5]
     1791     ,input p-tog[6]
     1792     ,input p-tog[7]
     1793     ,input p-tog[8]
     1794     ,input p-tog[9]
     1795     ,input p-tog[10]
     1796     ,input p-pump-one
     1797     ,input p-whole-gds
     1798     ,input p-el-icnt
     1799     ,input p-cp-grp
     1800     ,input lookup('text':U, p-output-type) > 0
     1801     ,input lookup('excel':U, p-output-type) > 0
     1802     ,input entry(1, v-dirs, chr(124))
     1803     ,input-output p-reporth
     1804     ,input table temp-xml-tables
     1805     ) no-error.
     1806     if error-status:error then do:
     1807           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("!!Ошибка при выполнении отчета!!! &1&2&1&3"                                 , chr(10)                                 , error-status:get-message(1)                                 , return-value )).
     1808       if lookup('excel':U, p-output-type) > 0 then do:
     1809         run CloseForExcel in this-procedure  .
     1810       end.
     1811       return error ''.
     1812     end.
     1813     if lookup('excel':U, p-output-type) > 0 then do:
     1814       run CloseForExcel in this-procedure  .
     1815     end.
     1816     run cb_fill-report-header in p-parent-handle ( input buffer buf_report-header:handle
     1817                                                   ,input v-report-id
     1818                                                   ,input "shift"
     1819                                                   ,input "Сменный отчет"
     1820                                                   ,input v-start-datetime
     1821                                                   ,input cur-time-datetime()
     1822                                                   ).
     1823     run cb_fill-report-parameters in p-parent-handle ( input buffer buf_report-parameters:handle
     1824                                                       ,input v-report-id
     1825                                                       ).
     1826     v-p-index = 0.
     1827     run cb_rcps-run_get-value in p-cont-handle (
     1828                                                  input p-call-id
     1829                                                 ,input 0
     1830                                                 ,input 0
     1831                                                 ,input 0
     1832                                                 ,INPUT "p-reporth"
     1833                                                 ,INPUT-OUTPUT v-p-index
     1834                                                 ,output v-value-character
     1835                                                 ,output v-value-date
     1836                                                 ,output v-value-decimal
     1837                                                 ,output v-value-integer
     1838                                                 ,output v-value-logical
     1839                                                 ) no-error.
     1840     if error-status:error then do:
     1841           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("!!Не удалось передать OUTPUT параметры правила!!! &1&2&1&3"                                 , chr(10)                                 , error-status:get-message(1) )).
     1842       delete object p-reporth no-error.
     1843       return error ''.
     1844     end.
     1845     assign
     1846     p-reporth = widget-handle(v-value-character)
     1847     no-error.
     1848     if not valid-handle(p-reporth) then do:
     1849       create dataset p-reporth.
     1850     end.
     1851     glog = p-reporth:copy-dataset (
     1852                             dataset reportheadertypet:handle
     1853                           , no
     1854                           , yes
     1855                           , yes
     1856                           ) no-error .
     1857     if error-status:error
     1858     or not glog
     1859     then do:
     1860           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("!!Не удалось заполнить блок параметров!!! &1"                                 , error-status:get-message(1) )).
     1861       delete object p-reporth no-error.
     1862       return error ''.
     1863     end.
     1864     run cb_rcps-run_set-value in p-cont-handle (
     1865                                                   input p-call-id
     1866                                                 ,input 0
     1867                                                 ,input 0
     1868                                                 ,input 0
     1869                                                 ,INPUT "p-reporth"
     1870                                                 ,INPUT 0
     1871                                                 ,input 'output':U
     1872                                                 ,INPUT string(p-reporth)
     1873                                                 ,INPUT ?
     1874                                                 ,INPUT 0.0
     1875                                                 ,INPUT 0
     1876                                                 ,INPUT no
     1877                                                 ) no-error.
     1878     if error-status:error then do:
     1879           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("!!Не удалось передать OUTPUT параметры правила!!! &1&2&1&3"                                 , chr(10)                                 , error-status:get-message(1) )).
     1880       delete object p-reporth no-error.
     1881       return error ''.
     1882     end.
     1883   end.
     1884   end procedure.
     1885   procedure load-ruleset-context :
     1886   define input parameter p-ruleset-id as integer no-undo .
     1887   define variable v-rowid as rowid no-undo .
     1888   define variable v-tbl-name as character no-undo .
     1889   define buffer buf_rule-call-param for ub.rule-call-param.
     1890   do
     1891   on error undo, return error
     1892   :
     1893   for each buf_rule-call-param no-lock where
     1894   buf_rule-call-param.codex_id = p-codex-id
     1895   and buf_rule-call-param.ruleset_id = p-ruleset-id
     1896   and buf_rule-call-param.call_id = p-call-id
     1897   and buf_rule-call-param.order_id = p-order-id
     1898   and buf_rule-call-param.rule_id = p-rule-id
     1899   and buf_rule-call-param.param-name = "p-tog"
     1900   and buf_rule-call-param.p-index > 0:
     1901     if buf_rule-call-param.p-index <= 10 then do:
     1902       p-tog[buf_rule-call-param.p-index]  = buf_rule-call-param.param-value-logical.
     1903     end.
     1904   end.
     1905     find first buf_rule-call-param no-lock where
     1906   buf_rule-call-param.codex_id = p-codex-id
     1907   and buf_rule-call-param.ruleset_id = p-ruleset-id
     1908   and buf_rule-call-param.call_id = p-call-id
     1909   and buf_rule-call-param.order_id = p-order-id
     1910   and buf_rule-call-param.rule_id = p-rule-id
     1911   and buf_rule-call-param.param-name = "p-classify"
     1912    no-error.
     1913   if available buf_rule-call-param then do:
     1914   assign p-classify = buf_rule-call-param.param-value-character.
     1915   end.
     1916     find first buf_rule-call-param no-lock where
     1917   buf_rule-call-param.codex_id = p-codex-id
     1918   and buf_rule-call-param.ruleset_id = p-ruleset-id
     1919   and buf_rule-call-param.call_id = p-call-id
     1920   and buf_rule-call-param.order_id = p-order-id
     1921   and buf_rule-call-param.rule_id = p-rule-id
     1922   and buf_rule-call-param.param-name = "p-sorttype"
     1923    no-error.
     1924   if available buf_rule-call-param then do:
     1925   assign p-sorttype = buf_rule-call-param.param-value-character.
     1926   end.
     1927     find first buf_rule-call-param no-lock where
