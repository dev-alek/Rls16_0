     2018           if g#news = yes then do:
     2019             return "return".
     2020           end.
     2021           run gen-row-keyr in this-procedure (
     2022                                                 input  p-doc-code
     2023                                                 ,input ?
     2024                                                 ,input  "ub"
     2025                                                 ,input  ?
     2026                                                 ,input  no-lock
