     2309       define variable v-custom-pack-name   as character   no-undo .
     2310       define variable v-dump-ord-int64     as int64       no-undo .
     2311       define buffer buf_ext-system  for ub.ext-system.
     2312       define variable expObj as class ibs.th.bge.1crn.export.expsubject no-undo .
     2313       run local-proc-main in this-procedure no-error.
     2314       if error-status:error
     2315       then
     2316          undo _main, return error substitute("&1 &2", return-value , error-status:get-message(1) ).
     2317       if  context_begin-esys-command( input string(m-esys-id-list), input-output m-esys-cmd-proc-handle, output m-esys-cmd-code) = false
     2318       then
     2319         undo _main, return error v-last-error-message .
     2320       expObj = new ibs.th.bge.1crn.export.expsubject ().
     2321       expObj:GetContent(subObj) no-error.
     2322       if error-status:error
     2323       then
     2324          undo _main, return error substitute("&1 &2 &3",subObj:msg, return-value , error-status:get-message(1)) .
     2325       if ExpData1:esys-add-dump-data ( input expObj:Data,
     2326                                        input m-esys-cmd-proc-handle,
     2327                                        input m-esys-cmd-code,
     2328                                        ('+update' + chr(4) + expObj:InitSecTag)) = false
     2329       then
     2330         undo _main, return error v-last-error-message .
     2331       if  context_set-custom-esys-pck-name(  input m-esys-cmd-proc-handle, input m-esys-cmd-code, input v-custom-pack-name) = false
     2332       then
     2333         undo _main, return error v-last-error-message .
     2334       v-dump-ord-int64 = context_send-esys-command( input m-esys-id-list
     2335         , input m-esys-cmd-proc-handle
     2336         , input m-esys-cmd-code
     2337         , input g#userid).
     2338       if v-dump-ord-int64 = 0
     2339       then
     2340         undo _main, return error v-last-error-message .
     2341           ExpData1:Route-data_clear-data ( ) .
     2342     end.
     2343   end procedure.
     2344   procedure load-ruleset-context :
     2345     define input parameter p-ruleset-id as integer    no-undo .
     2346    define buffer buf_rule-call-param for ub.rule-call-param.
     2347    define buffer buf_ext-system      for ub.ext-system.
     2348     do
     2349       on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2350       on stop   undo, return error substitute( "&1. stop", vss-workfile )
     2351       on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     2352       :
     2353       assign
     2354         m-oldbh        = widget-handle (entry(2, p-doc-code, chr(4))).
     2355         m-newbh        = widget-handle (entry(3, p-doc-code, chr(4))).
     2356         m-changes-list = entry(4, p-doc-code, chr(4)).
     2357         m-has-oldbh    = valid-handle(m-oldbh) and m-oldbh:available.
     2358         m-has-newbh    = valid-handle(m-newbh) and m-newbh:available.
     2359         .
     2360       if not m-has-newbh
     2361         and not m-has-oldbh then
     2362       do:
     2363         undo, return error substitute("Не определено ни одного буфера - ни старый, ни новый").
     2364       end.
     2365       if not m-has-oldbh
     2366         and m-changes-list  = '' then
     2367       do:
     2368         undo, return error substitute("Не определен старый буфер и список изменений").
     2369       end.
     2370       run local-load-ruleset-context in this-procedure no-error.
     2371       if error-status:error
     2372       then
     2373          undo, return error substitute("&1 &2",return-value,error-status:get-message(1) ).
     2374       for each buf_rule-call-param no-lock where
     2375         buf_rule-call-param.codex_id = p-codex-id
     2376         and buf_rule-call-param.ruleset_id = p-ruleset-id
     2377         and buf_rule-call-param.call_id = p-call-id
     2378         and buf_rule-call-param.order_id = p-order-id
     2379         and buf_rule-call-param.rule_id = p-rule-id
     2380         and buf_rule-call-param.param-name = "p-esys-id",
     2381         first buf_ext-system no-lock where
     2382         buf_Ext-system.esys-id = buf_rule-call-param.param-value-integer
     2383         and buf_Ext-system.db-num = 0
     2384         and buf_Ext-system.esys-have-export = yes
     2385         and buf_Ext-system.esys-db-num-exp = g#db-num:
     2386         m-esys-id-list = m-esys-id-list + (if m-esys-id-list = '' then '' else chr(1)) + string(buf_ext-system.esys-id).
     2387       end.
     2388       if m-esys-id-list = '' then return "return".
     2389       find first buf_rule-call-param no-lock where
     2390         buf_rule-call-param.codex_id = p-codex-id
     2391         and buf_rule-call-param.ruleset_id = p-ruleset-id
     2392         and buf_rule-call-param.call_id = p-call-id
     2393         and buf_rule-call-param.order_id = p-order-id
     2394         and buf_rule-call-param.rule_id = p-rule-id
     2395         and buf_rule-call-param.param-name = "p-xsd-file"
     2396         no-error.
     2397       if available buf_rule-call-param then
     2398       do:
     2399         assign
     2400           p-xsd-file = buf_rule-call-param.param-value-character.
     2401       end.
     2402     end.
     2403   end procedure.
     2404   procedure local-proc-main:
     2405      define variable Vobj as class ibs.th.bge.1crn.subjects.exp-user-action no-undo .
     2406      Vobj = new ibs.th.bge.1crn.subjects.exp-user-action().
     2407      Vobj:BufHandle = m-oldbh.
     2408      SubObj = cast (vobj ,ibs.th.bge.1crn.subjects.iexpsubject).
     2409   end.
     2410   procedure local-load-ruleset-context:
     2411       case p-ruleset-id:
     2412         when 170
     2413         then do:
     2414             if    m-has-newbh
     2415               and m-newbh:table <> 'c-user-log':U
     2416             then
     2417               undo, return error substitute("Передан неверный буфер вместо буфера для &1",  'c-user-log':U).
     2418             if    m-has-oldbh
     2419               and m-oldbh:table <> 'c-user-log':U
     2420             then
     2421               undo, return error substitute("Передан неверный буфер вместо буфера для &1",  'c-user-log':U).
     2422           end.
     2423         otherwise
     2424         do:
     2425           undo, return error substitute("Неверный вызов &1 для набора правил &2", vss-workfile , p-ruleset-id).
     2426         end.
     2427       end case.
     2428   end.
