        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision:$":U .
        3   define variable vss-author      as character no-undo init "$Author:$":U .
        4   define variable vss-date        as character no-undo init "$Date:$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile:$":U .
        6   define variable vss-archive     as character no-undo init "$Archive:$":U .
        7   define variable vss-description as character no-undo init "".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define input parameter parparentproc as widget-handle no-undo .
       63   define input parameter p-parent-handle as handle no-undo .
       64   define input parameter p-log-handle  as handle no-undo .
       65   define input parameter p-cont-handle  as handle no-undo .
       66   define input parameter p-codex-id as integer no-undo .
       67   define input parameter p-ruleset-id as integer no-undo .
       68   define input parameter p-call-id as character no-undo .
       69   define input parameter p-order-id as integer no-undo .
       70   define input parameter p-rule-id as integer no-undo .
       71   define input parameter p-profile-id as integer no-undo .
       72   define input parameter p-is-dynamic as logical no-undo .
       73   define input parameter p-doc-type as character no-undo .
       74   define input parameter p-host-code like ub.sysconf.host-code no-undo .
       75   define input parameter p-obj-type like ub.clients.obj-type no-undo .
       76   define input parameter p-obj-code like ub.clients.obj-code no-undo .
       77   define input parameter p-doc-code as character no-undo .
       78   define input parameter p-process-file-name as character no-undo .
       79   define input parameter p-save       as integer no-undo .
       80   define input parameter v-curr-r-b   as character no-undo .
       81   define input parameter p-cmd-proc-handle as handle no-undo .
       82   define input parameter p-cmd-code  as integer no-undo .
       83   define new global shared variable g#language as character no-undo .
       84   if g#language <> '' and g#language <> 'rus':U then do:
       85     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       86   end.
       87   define new global shared variable g#library  as handle no-undo .
       88   define new global shared variable g#library2 as handle no-undo .
       89   define   shared variable g#auto as logical no-undo.
       90   define   shared variable g#news as logical no-undo.
       91   define   shared variable g#oxml as logical no-undo.
       92   define   shared variable g#esys as logical no-undo.
       93   define   shared variable g#news-source-db as integer no-undo.
       94   define   shared variable g#esys-source-esys as integer no-undo.
       95   define   shared variable g#db-num as integer   no-undo .
       96   define   shared variable g#userid as character no-undo .
       97   define   shared variable g#passwd as character no-undo .
       98   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       99   define  variable garbcoll_ii as integer no-undo .
      100   define  temp-table temp-gc no-undo
      101   field ii as integer
      102   field obj-r as handle
      103   field cn as character
      104   index pi is unique primary
      105   ii
      106   index icn
      107   cn.
      108   procedure garbcoll_create-gc-entry :
      109   define input parameter p-cn as character no-undo .
      110   define input parameter p-obj-r as handle no-undo .
      111     do
      112     on error undo, return error
      113     :
      114       create temp-gc.
      115       assign
      116       temp-gc.ii = garbcoll_ii
      117       garbcoll_ii = garbcoll_ii + 1
      118       temp-gc.cn = p-cn
      119       temp-gc.obj-r = p-obj-r
      120       .
      121     end.
      122   end procedure.
      123   procedure garbcoll_clear :
      124     do
      125     on error undo, return error
      126     :
      127       for each temp-gc:
      128         delete object temp-gc.obj-r.
      129         delete temp-gc.
      130       end.
      131     end.
      132   end procedure.
      133   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      134   procedure cur-time :
      135      define output parameter p-today as date      no-undo .
      136      define output parameter p-time  as integer   no-undo .
      137     do
      138     on error undo, return error
      139     :
      140       define variable v-date1 as date      no-undo .
      141       define variable v-date2 as date      no-undo .
      142       define variable v-time  as integer   no-undo .
      143       assign
      144         v-date1 = today
      145         v-time  = time
      146         v-date2 = today
      147       .
      148       if v-date1 <> v-date2
      149       then do:
      150         assign
      151           v-date1 = today
      152           v-time  = v-time
      153         .
      154       end.
      155       assign
      156         p-today = v-date1
      157         p-time  = v-time
      158       .
      159     end.
      160   end.
      161   function cur-time-date returns character
      162   :
      163     return string(today, '99/99/9999':U) .
      164   end.
      165   function cur-time-mjd returns decimal
      166   :
      167     define variable v-date as date      no-undo .
      168     define variable v-time as integer   no-undo .
      169     run cur-time in this-procedure
      170       (output v-date
      171       ,output v-time
      172       ) .
      173     return integer(v-date) - 2400002 + (v-time / 86400) .
      174   end.
      175   function cur-time-get-ending-index returns integer
      176   (input p-number as integer
      177   )
      178   :
      179     if p-number < 0
      180     or p-number = ?
      181     then do:
      182       return 1 .
      183     end.
      184     define variable v-rest as integer   no-undo .
      185     assign
      186       p-number = p-number modulo 100
      187     .
      188     if p-number < 20
      189     then do:
      190       assign
      191         v-rest = p-number
      192       .
      193     end.
      194     else do:
      195       assign
      196         v-rest = p-number modulo 10
      197       .
      198     end.
      199     case v-rest :
      200       when 1
      201       then do:
      202         return 2 .
      203       end.
      204       when 2 or
      205       when 3 or
      206       when 4
      207       then do:
      208         return 3 .
      209       end.
      210       otherwise do:
      211         return 1 .
      212       end.
      213     end case .
      214   end.
      215   procedure cur-time-mjd-to-date :
      216      define input  parameter i-mjd-diff as decimal no-undo.
      217      define output parameter o-Date     as date    no-undo.
      218      define output parameter o-Time     as integer no-undo.
      219      define variable v-day-number as integer   no-undo .
      220      if    i-mjd-diff < 0
      221         or i-mjd-diff = ?
      222      then do:
      223         return "?" .
      224      end.
      225      assign
      226         v-day-number = truncate(i-mjd-diff,0).
      227         o-Date = date(v-day-number + 2400002).
      228         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      229     .
      230   end.
      231   function cur-time-mjd-to-string returns character
      232   (input p-mjd-diff as decimal
      233   )
      234   :
      235     define variable v-day-number as integer   no-undo .
      236     define variable v-seconds    as integer   no-undo .
      237     define variable v-hour       as integer   no-undo .
      238     define variable v-min        as integer   no-undo .
      239     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      240     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      241     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      242     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      243     if p-mjd-diff < 0
      244     or p-mjd-diff = ?
      245     then do:
      246       return "?" .
      247     end.
      248     assign
      249       v-day-number = integer(truncate(p-mjd-diff,0))
      250       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      251     .
      252     if v-seconds > 86400
      253     then do:
      254       assign
      255         v-seconds = 86400 - 1
      256       .
      257     end.
      258     if v-seconds < 0
      259     then do:
      260       assign
      261         v-seconds = 0
      262       .
      263     end.
      264     assign
      265       v-hour = truncate(v-seconds / 3600, 0)
      266     .
      267     assign
      268       v-seconds = v-seconds modulo 3600
      269     .
      270     assign
      271       v-min = truncate(v-seconds / 60, 0)
      272     .
      273     assign
      274       v-seconds = v-seconds modulo 60
      275     .
      276     return
      277         (if v-day-number <> 0
      278           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      279           else ""
      280         )
      281       + (if v-day-number <> 0 or v-hour <> 0
      282           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      283           else ""
      284         )
      285       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      286           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      287           else ""
      288         )
      289       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      290       .
      291   end.
      292   function cur-time-string returns character
      293   :
      294     define variable v-date as date      no-undo .
      295     define variable v-time as integer   no-undo .
      296     run cur-time in this-procedure
      297       (output v-date
      298       ,output v-time
      299       ) .
      300     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      301   end.
      302   function cur-time-string-sec returns character
      303   :
      304     define variable v-date as date      no-undo .
      305     define variable v-time as integer   no-undo .
      306     run cur-time in this-procedure
      307       (output v-date
      308       ,output v-time
      309       ) .
      310     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      311   end.
      312   function cur-time-custom  returns character
      313   (input p-prefix as character
      314   ,input p-date-format as character
      315   ,input p-delimiter as character
      316   ,input p-time-format as character
      317   ,input p-suffix as character
      318   )
      319   :
      320     define variable v-date as date      no-undo .
      321     define variable v-time as integer   no-undo .
      322     run cur-time in this-procedure
      323       (output v-date
      324       ,output v-time
      325       ) .
      326     return
      327       p-prefix
      328       + string(v-date, p-date-format)
      329       + p-delimiter
      330       + string(v-time, p-time-format)
      331       + p-suffix
      332       .
      333   end.
      334   function cur-time-print  returns character
      335   :
      336     define variable v-date as date      no-undo .
      337     define variable v-time as integer   no-undo .
      338     run cur-time in this-procedure
      339       (output v-date
      340       ,output v-time
      341       ) .
      342     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      343   end.
      344   function cur-time-datetime returns datetime
      345   :
      346     define variable v-char as character no-undo .
      347     define variable v-datetime as datetime no-undo .
      348     v-char = cur-time-string().
      349     v-datetime = datetime(v-char).
      350     return  v-datetime.
      351   end.
      352   function cur-time-string-msec returns character
      353   :
      354     define variable v-date as datetime  no-undo .
      355     v-date = now.
      356     return string(v-date) .
      357   end.
      358   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      359   define new global shared variable g#lib-nws as handle no-undo .
      360   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      361   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      362   define variable tempcxml_v-num_ as integer no-undo .
      363   define  temp-table temp-xml-tables no-undo
      364   field order as integer
      365   field tbl-name as character
      366   field tbl-handle_ as handle
      367   field table-handle_ as handle
      368   field uniq-gate-rec as character
      369   field gate-name as character
      370   field gate-handle_ as handle
      371   field is-parent as logical
      372   index pi is unique primary
      373   uniq-gate-rec
      374   tbl-name
      375   index iorder
      376   order
      377   index gr
      378   uniq-gate-rec
      379   index gh
      380   gate-handle_
      381   index iparent
      382   is-parent
      383   .
      384   define  temp-table temp-xml-records no-undo
      385   field tbl-name as character
      386   field uniq-key-rec as character
      387   index pi is unique primary
      388   tbl-name
      389   uniq-key-rec
      390   .
      391   def var vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      392   procedure gen-key-rec :
      393     define input  parameter p-tbl-name    as character no-undo.
      394     define input  parameter p-bh_tbl-name as handle    no-undo.
      395     define output parameter p-key-rec     as character no-undo.
      396     do
      397     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      398     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      399     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      400     :
      401       define variable fh               as handle    no-undo .
      402       define variable v-ok             as logical   no-undo .
      403       define variable v-inform         as character no-undo .
      404       define variable v-ind            as integer   no-undo .
      405       define variable v-idx-field-qnty as integer   no-undo .
      406       if p-tbl-name = ?
      407         or p-tbl-name = "":U
      408       then do:
      409         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info5 ).
      410       end.
      411       if not p-bh_tbl-name:available then do:
      412         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info5, p-tbl-name ).
      413       end.
      414       assign
      415         p-key-rec = p-tbl-name
      416         v-inform  = p-bh_tbl-name:index-information(1)
      417         v-ind     = 2
      418       .
      419       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      420       on error undo, return error
      421       :
      422         assign
      423           v-inform = p-bh_tbl-name:index-information( v-ind )
      424           v-ind    = v-ind + 1
      425         .
      426       end.
      427       if v-inform = ?
      428         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      429         or entry( 3, v-inform, ",":U ) <> "1":U
      430       then do:
      431         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, p-tbl-name ).
      432       end.
      433       else do:
      434         assign
      435           v-idx-field-qnty = num-entries( v-inform ) - 4
      436         .
      437         if v-idx-field-qnty < 2 then do:
      438           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, p-tbl-name ).
      439         end.
      440         do v-ind = 1 to v-idx-field-qnty by 2
      441         on error undo, return error
      442         :
      443           assign
      444             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      445             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      446           .
      447         end.
      448       end.
      449       if p-key-rec = ? then do:
      450         assign
      451           p-key-rec = "":U
      452         .
      453         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info5, p-tbl-name ).
      454       end.
      455     end.
      456     return.
      457   end procedure.
      458   procedure gen-where-keyr-tab :
      459     define input  parameter i-tableSerach as character no-undo.
      460     define input  parameter i-tablekey   as character  no-undo.
      461     define input  parameter p-key-rec    as character  no-undo.
      462     define input  parameter p-key-handle as handle     no-undo .
      463     define input  parameter p-db-name    as character  no-undo .
      464     define input  parameter p-tt-handle  as handle     no-undo .
      465     define output parameter o-Where      as character  no-undo.
      466     do
      467     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      468     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      469     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      470     :
      471       define variable v-full-tbl-name  as character no-undo .
      472       define variable bh_tbl-name      as handle    no-undo .
      473       define variable fh_key           as handle    no-undo .
      474       define variable fh_search        as handle    no-undo .
      475       define variable v-field-num      as integer   no-undo .
      476       define variable v-count-fld      as integer   no-undo .
      477       define variable v-inform         as character no-undo .
      478       define variable v-ind            as integer   no-undo .
      479       define variable v-idx-field-qnty as integer   no-undo .
      480       define variable v-field-name     as character no-undo .
      481       define variable v-field-val      as character no-undo .
      482       define variable v-word-link      as character no-undo .
      483       define variable vTable           as character no-undo.
      484       define variable bh_tbl-key       as handle    no-undo .
      485       assign
      486         p-key-rec = trim( p-key-rec )
      487       .
      488       if p-key-handle <> ? then do:
      489         if not valid-handle(p-key-handle)
      490            or p-key-handle:type <> "buffer"
      491         then do:
      492           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info5 ).
      493         end.
      494         if num-entries( p-key-rec, chr(3) ) > 1
      495           or p-key-rec = ?
      496           or p-key-rec = "":U
      497         then do:
      498           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info5, p-key-rec ).
      499         end.
      500       end.
      501       else do:
      502         if p-key-rec = ?
      503           or p-key-rec = "":U
      504         then do:
      505           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info5 ).
      506         end.
      507       end.
      508       assign
      509         vTable = entry( 1 , p-key-rec, chr(3) )
      510       .
      511       if p-tt-handle <> ?
      512         and ( not valid-handle(p-tt-handle)
      513               or p-tt-handle:type <> "buffer"
      514             )
      515       then do:
      516         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info5, vTable, chr(10) ).
      517       end.
      518       if p-tt-handle = ? then do:
      519         assign
      520           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      521         .
      522         create buffer bh_tbl-name for table v-full-tbl-name .
      523       end.
      524       else do:
      525         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      526       end.
      527       assign
      528         v-inform = bh_tbl-name:index-information(1)
      529         v-ind    = 2
      530       .
      531       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      532       on error undo, return error
      533       :
      534         assign
      535           v-inform = bh_tbl-name:index-information( v-ind )
      536           v-ind    = v-ind + 1
      537         .
      538       end.
      539       if v-inform = ?
      540         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      541         or entry( 3, v-inform, ",":U ) <> "1":U
      542       then do:
      543         delete object bh_tbl-name no-error.
      544         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info5, vTable ).
      545       end.
      546       assign
      547         v-idx-field-qnty = num-entries( v-inform ) - 4
      548       .
      549       if v-idx-field-qnty < 2 then do:
      550         delete object bh_tbl-name no-error.
      551         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, vTable ).
      552       end.
      553       assign
      554         o-where     = "where":U
      555         v-word-link = "":U
      556         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      557         v-count-fld = 0
      558       .
      559       if i-tablekey ne "" and i-tablekey ne ?
      560       then do:
      561         assign
      562           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      563         .
      564         create buffer bh_tbl-key for table v-full-tbl-name .
      565       end.
      566       if i-tableSerach ne "" and i-tableSerach ne ?
      567       then do:
      568         delete object bh_tbl-name no-error.
      569         assign
      570           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      571         .
      572         create buffer bh_tbl-name for table v-full-tbl-name .
      573       end.
      574       block_where:
      575       do v-ind = 1 to v-idx-field-qnty by 2
      576       on error undo, return error
      577       :
      578         assign
      579           v-count-fld = v-count-fld + 1
      580         .
      581         if p-key-handle = ?
      582           and v-count-fld > v-field-num
      583         then do:
      584           leave block_where.
      585         end.
      586         define variable VfieldKeyTable as handle no-undo.
      587         assign
      588           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      589           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      590         .
      591         if     bh_tbl-key ne ?
      592         then do:
      593            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      594            if VfieldKeyTable eq ?
      595            then next block_where.
      596         end.
      597         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      598         then
      599            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      600         else
      601            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      602         if p-key-handle = ? then do:
      603           assign
      604             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      605           .
      606         end.
      607         else do:
      608           assign
      609             fh_key = p-key-handle:buffer-field( v-field-name )
      610           .
      611           if fh_key = ?
      612             or not valid-handle( fh_key )
      613           then do:
      614             delete object bh_tbl-name.
      615             if     bh_tbl-key ne ?
      616             then
      617                delete object bh_tbl-key.
      618             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info5, p-key-handle:name, v-field-name ).
      619           end.
      620           assign
      621             v-field-val = fh_key:buffer-value
      622           .
      623         end.
      624         if fh_search:data-type ="character":U then do:
      625           assign
      626             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      627             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      628             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      629             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      630             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      631             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      632             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      633             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      634             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      635             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      636             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      637             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      638             v-field-val = substitute( '"&1"', v-field-val )
      639           .
      640         end.
      641         assign
      642           o-where = substitute( "&1 &2", o-where, v-field-val )
      643         .
      644         if v-word-link = "":U then do:
      645           assign
      646             v-word-link = "and":U
      647           .
      648         end.
      649       end.
      650       delete object bh_tbl-name.
      651       if     bh_tbl-key ne ?
      652       then
      653          delete object bh_tbl-key.
      654       if p-key-handle = ?
      655         and v-count-fld <> v-field-num
      656       then do:
      657         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info5, vTable ).
      658       end.
      659     end.
      660   end procedure.
      661   procedure gen-hn-keyr-tab :
      662     define input  parameter i-tableSerach as character no-undo.
      663     define input  parameter i-tablekey   as character no-undo.
      664     define input  parameter p-key-rec    as character no-undo.
      665     define input  parameter p-key-handle as handle    no-undo .
      666     define input  parameter p-db-name    as character no-undo .
      667     define input  parameter p-tt-handle  as handle    no-undo .
      668     define input  parameter p-stts-lock  as integer   no-undo .
      669     define output parameter o-hn         as handle    no-undo.
      670     define variable v-full-tbl-name as character no-undo.
      671     define variable v-where         as character no-undo.
      672     define variable bh_tbl-name     as handle    no-undo.
      673     define variable vTable          as character no-undo.
      674     do
      675     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      676     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      677     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      678         run gen-where-keyr-tab(i-tableSerach,
      679                                i-tablekey,
      680                                p-key-rec,
      681                                p-key-handle,
      682                                p-db-name,
      683                                p-tt-handle,
      684                                output v-where).
      685         if i-tableSerach ne "" and i-tableSerach ne ?
      686         then do:
      687            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      688            create buffer bh_tbl-name for table v-full-tbl-name .
      689         end.
      690         else do:
      691            if p-tt-handle = ? then do:
      692               assign
      693                  vTable = entry( 1 , p-key-rec, chr(3) )
      694               .
      695               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      696               create buffer bh_tbl-name for table v-full-tbl-name .
      697            end.
      698            else do:
      699               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      700            end.
      701         end.
      702         if p-tt-handle = ? then do:
      703            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      704         end.
      705         else do:
      706            bh_tbl-name:find-first( v-where ) no-error .
      707         end.
      708         o-hn = bh_tbl-name.
      709      end.
      710   end procedure.
      711   procedure gen-hn-keyr :
      712     define input  parameter p-key-rec    as character no-undo.
      713     define input  parameter p-key-handle as handle    no-undo .
      714     define input  parameter p-db-name    as character no-undo .
      715     define input  parameter p-tt-handle  as handle    no-undo .
      716     define input  parameter p-stts-lock  as integer   no-undo .
      717     define output parameter o-hn         as handle    no-undo.
      718     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      719   end.
      720   procedure gen-row-keyr :
      721     define input  parameter p-key-rec    as character no-undo.
      722     define input  parameter p-key-handle as handle    no-undo .
      723     define input  parameter p-db-name    as character no-undo .
      724     define input  parameter p-tt-handle  as handle    no-undo .
      725     define input  parameter p-stts-lock  as integer   no-undo .
      726     define output parameter p-tbl-row    as rowid     no-undo.
      727     define output parameter p-tbl-name   as character no-undo.
      728     define variable vHn as handle no-undo.
      729       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      730       p-tbl-row = if vHn:available then vHn:rowid else ?.
      731       p-tbl-name =  vHn:table.
      732       delete object vHn no-error.
      733     if p-tbl-row = ? then do:
      734       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info5, p-tbl-name, p-key-rec ).
      735     end.
      736     else do:
      737       return.
      738     end.
      739   end procedure.
      740   procedure gen-key-fv :
      741     define input  parameter p-key-rec    as character no-undo .
      742     define output parameter p-field-list as character no-undo .
      743     define output parameter p-value-list as character no-undo.
      744     do
      745     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      746     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      747     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      748     :
      749       define variable v-full-tbl-name  as character no-undo .
      750       define variable bh_tbl-name      as handle    no-undo .
      751       define variable v-tbl-name       as character no-undo .
      752       define variable v-field-num      as integer   no-undo .
      753       define variable v-count-fld      as integer   no-undo .
      754       define variable v-inform         as character no-undo .
      755       define variable v-ind            as integer   no-undo .
      756       define variable v-idx-field-qnty as integer   no-undo .
      757       define variable v-delim-key      as character no-undo .
      758       if p-key-rec = ?
      759         or p-key-rec = "":U
      760       then do:
      761         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info5 ).
      762       end.
      763       assign
      764         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      765         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      766       .
      767       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      768       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info5 ).
      769       assign
      770         v-inform = bh_tbl-name:index-information(1)
      771         v-ind    = 2
      772       .
      773       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      774       on error undo, return error
      775       :
      776         assign
      777           v-inform = bh_tbl-name:index-information( v-ind )
      778           v-ind    = v-ind + 1
      779         .
      780       end.
      781       if v-inform = ?
      782         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      783         or entry( 3, v-inform, ",":U ) <> "1":U
      784       then do:
      785         delete object bh_tbl-name no-error.
      786         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, v-tbl-name ).
      787       end.
      788       assign
      789         v-idx-field-qnty = num-entries( v-inform ) - 4
      790       .
      791       if v-idx-field-qnty < 2 then do:
      792         delete object bh_tbl-name no-error.
      793         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, v-tbl-name ).
      794       end.
      795       assign
      796         p-field-list = "":U
      797         p-value-list = "":U
      798         v-delim-key  = "":U
      799         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      800         v-count-fld  = 0
      801       .
      802       block_where:
      803       do v-ind = 1 to v-idx-field-qnty by 2
      804       on error undo, return error
      805       :
      806         assign
      807           v-count-fld = v-count-fld + 1
      808         .
      809         if v-count-fld > v-field-num then do:
      810           leave block_where.
      811         end.
      812         assign
      813           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      814           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      815         .
      816         if v-ind = 1 then do:
      817           assign
      818             v-delim-key = chr(3)
      819           .
      820         end.
      821       end.
      822       delete object bh_tbl-name.
      823       if v-count-fld <> v-field-num then do:
      824         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info5, v-tbl-name ).
      825       end.
      826     end.
      827   end procedure.
      828   procedure gen-key-field :
      829     define input  parameter p-table      as character no-undo .
      830     define output parameter p-field-list as character no-undo .
      831     do
      832     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      833     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      834     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      835     :
      836       define variable v-full-tbl-name  as character no-undo .
      837       define variable bh_tbl-name      as handle    no-undo .
      838       define variable v-tbl-name       as character no-undo .
      839       define variable v-field-num      as integer   no-undo .
      840       define variable v-count-fld      as integer   no-undo .
      841       define variable v-inform         as character no-undo .
      842       define variable v-ind            as integer   no-undo .
      843       define variable v-idx-field-qnty as integer   no-undo .
      844       define variable v-delim-key      as character no-undo .
      845       if p-table = ?
      846         or p-table = "":U
      847       then do:
      848         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info5 ).
      849       end.
      850       assign
      851         v-tbl-name      = p-table
      852         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      853       .
      854       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      855       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info5 ).
      856       assign
      857         v-inform = bh_tbl-name:index-information(1)
      858         v-ind    = 2
      859       .
      860       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      861       on error undo, return error
      862       :
      863         assign
      864           v-inform = bh_tbl-name:index-information( v-ind )
      865           v-ind    = v-ind + 1
      866         .
      867       end.
      868       if v-inform = ?
      869         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      870         or entry( 3, v-inform, ",":U ) <> "1":U
      871       then do:
      872         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, v-tbl-name ).
      873       end.
      874       assign
      875         v-idx-field-qnty = num-entries( v-inform ) - 4
      876       .
      877       if v-idx-field-qnty < 2 then do:
      878         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, v-tbl-name ).
      879       end.
      880       assign
      881         p-field-list = "":U
      882         v-delim-key  = "":U
      883         v-count-fld  = 0
      884       .
      885       block_where:
      886       do v-ind = 1 to v-idx-field-qnty by 2
      887       on error undo, return error
      888       :
      889         assign
      890           v-count-fld = v-count-fld + 1
      891         .
      892         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      893         if v-ind = 1 then do:
      894           assign
      895             v-delim-key = chr(3)
      896           .
      897         end.
      898       end.
      899       delete object bh_tbl-name.
      900     end.
      901   end procedure.
      902   procedure get-gate-file-name :
      903   define input parameter p-gate-rec as character no-undo .
      904   define output  parameter p-gate-file-name as character no-undo .
      905   define buffer buf_clob-data for ub.clob-data.
      906   define variable v-tbl-row as rowid no-undo .
      907   define variable v-tbl-name as character no-undo .
      908   run gen-row-keyr in this-procedure ( input p-gate-rec
      909                                       ,input ?
      910                                       ,input "ub"
      911                                       ,input ?
      912                                       ,input no-lock
      913                                       ,output v-tbl-row
      914                                       ,output v-tbl-name) no-error.
      915   if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
      916                                                           ,vss-include-info3
      917                                                           ,p-gate-rec).
      918   find first buf_clob-data no-lock where
      919             rowid(buf_clob-data) = v-tbl-row no-error.
      920   if not available buf_clob-data then do:
      921     if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
      922                                                             ,vss-include-info3
      923                                                             ,p-gate-rec).
      924   end.
      925   p-gate-file-name = buf_clob-data.file-name.
      926   end procedure.
      927   procedure get-gate-rec :
      928   define input  parameter p-gate-name as character no-undo .
      929   define output parameter p-gate-rec as character no-undo .
      930   define buffer buf_clob-bind for ub.clob-bind.
      931   define buffer buf_clob-data for ub.clob-data.
      932   main-block:
      933   do
      934   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info3, return-value, chr(10), error-status :get-message (1))
      935   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info3 )
      936   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info3 )
      937   :
      938       find first buf_clob-bind no-lock where
      939                 buf_clob-bind.uniq-key-rec = p-gate-name
      940             and buf_clob-bind.field-name = '':U
      941             and buf_clob-bind.part-num = 1
      942             and buf_clob-bind.resource-type = 'gate':U
      943             no-error.
      944       if not available buf_clob-bind then do:
      945         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
      946                                         , p-gate-name
      947                                         ).
      948       end.
      949       find first buf_clob-data no-lock where
      950                 buf_clob-data.db-num = buf_clob-bind.db-num
      951             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
      952       if not available buf_clob-data then do:
      953         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
      954                                         , buf_clob-bind.db-num
      955                                         , buf_clob-bind.int64-id
      956                                         , p-gate-name
      957                                         ).
      958       end.
      959       run gen-key-rec in this-procedure ( input 'clob-data':U
      960                                 ,input buffer buf_clob-data:handle
      961                                 ,output p-gate-rec).
      962   end.
      963   end procedure.
      964   procedure get-gate-by-name :
      965   define input  parameter p-gate-name as character no-undo .
      966   define output parameter p-gate-rec as character no-undo .
      967   define output parameter p-dsh as handle no-undo .
      968   define input-output  parameter p-xmlh as handle no-undo .
      969   define variable v-ii as integer   no-undo .
      970   define variable glog as logical   no-undo .
      971   define variable v-longchar as longchar no-undo .
      972   define variable v-txmlh as handle no-undo .
      973   define variable v-db-num as integer no-undo .
      974   define variable v-int64-id as int64 no-undo .
      975   define buffer buf_clob-bind for ub.clob-bind.
      976   define buffer buf_clob-data for ub.clob-data.
      977   main-block:
      978   do
      979   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info3, return-value, chr(10), error-status :get-message (1))
      980   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info3 )
      981   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info3 )
      982   :
      983       find first buf_clob-bind no-lock where
      984                 buf_clob-bind.uniq-key-rec = p-gate-name
      985             and buf_clob-bind.field-name = '':U
      986             and buf_clob-bind.part-num = 1
      987             and buf_clob-bind.resource-type = 'gate':U
      988             no-error.
      989       if not available buf_clob-bind then do:
      990         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
      991                                         , p-gate-name
      992                                         ).
      993       end.
      994       find first buf_clob-data no-lock where
      995                 buf_clob-data.db-num = buf_clob-bind.db-num
      996             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
      997       if not available buf_clob-data then do:
      998         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
      999                                         , buf_clob-bind.db-num
     1000                                         , buf_clob-bind.int64-id
     1001                                         , p-gate-name
     1002                                         ).
     1003       end.
     1004       assign
     1005       v-longchar = buf_clob-data.cdata
     1006       .
     1007       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1008       if error-status :error then do:
     1009         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1010       end.
     1011       create dataset p-dsh .
     1012       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1013                                     , v-longchar
     1014                                     , ?
     1015                                     , ?
     1016                                     , ?
     1017                                     ) no-error.
     1018       v-longchar = '':U.
     1019       if error-status :error
     1020       or not glog
     1021       then do:
     1022         undo, return error substitute("Не удалось прочитать XML-схему &1 из БД:&2&3", p-gate-name, chr(10), error-status:get-message(1) ).
     1023       end.
     1024       if not valid-handle(p-xmlh)
     1025       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1026         create temp-table v-txmlh.
     1027         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1028         v-txmlh:temp-table-prepare("temp-xml-tables").
     1029         p-xmlh = v-txmlh:default-buffer-handle.
     1030       end.
     1031       run gen-key-rec in this-procedure ( input 'clob-data':U
     1032                                 ,input buffer buf_clob-data:handle
     1033                                 ,output p-gate-rec).
     1034       do v-ii = 1 to p-dsh:num-buffers:
     1035         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1036         if not p-xmlh:available then do:
     1037           p-xmlh:buffer-create().
     1038           assign
     1039           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1040           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1041           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1042           p-xmlh::gate-handle_ = p-dsh
     1043           p-xmlh::uniq-gate-rec = p-gate-rec
     1044           p-xmlh::gate-name = p-dsh:name
     1045           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1046           .
     1047           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1048             assign
     1049             p-xmlh::order = -3.
     1050           end.
     1051         end.
     1052       end.
     1053   end.
     1054   end procedure.
     1055   procedure get-gate-by-rec :
     1056   define input  parameter p-gate-rec as character no-undo .
     1057   define output parameter p-dsh as handle no-undo .
     1058   define input-output  parameter p-xmlh as handle no-undo .
     1059   define input-output parameter p-longchar  as longchar no-undo .
     1060   define variable v-ii as integer   no-undo .
     1061   define variable glog as logical   no-undo .
     1062   define variable v-rowid as rowid no-undo .
     1063   define variable v-tbl-name as character no-undo .
     1064   define variable v-longchar as longchar no-undo .
     1065   define variable v-txmlh as handle no-undo .
     1066   define buffer buf_clob-data for ub.clob-data.
     1067   main-block:
     1068   do
     1069   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info3, return-value, chr(10), error-status :get-message (1))
     1070   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info3 )
     1071   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info3 )
     1072   :
     1073     run gen-row-keyr in this-procedure (
     1074                                           input  p-gate-rec
     1075                                           ,input  ?
     1076                                           ,input  "ub"
     1077                                           ,input  ?
     1078                                           ,input  NO-LOCK
     1079                                           ,output v-rowid
     1080                                           ,output v-tbl-name   ) no-error.
     1081       find first buf_clob-data no-lock where
     1082                 rowid(buf_clob-data) = v-rowid  no-error.
     1083       if not available buf_clob-data then do:
     1084         undo, return error substitute("Не найден CLOB  &1"
     1085                                         , p-gate-rec
     1086                                         ).
     1087       end.
     1088       assign
     1089       v-longchar = buf_clob-data.cdata
     1090       .
     1091       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1092       if error-status :error then do:
     1093         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1094       end.
     1095       create dataset p-dsh .
     1096       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1097                                     , v-longchar
     1098                                     , ?
     1099                                     , ?
     1100                                     , ?
     1101                                     ) no-error.
     1102       define variable v-esm as character no-undo .
     1103       v-esm = error-status:get-message(1) .
     1104       if p-longchar <> ? then do:
     1105         p-longchar = v-longchar.
     1106       end.
     1107       v-longchar = '':U.
     1108       if error-status :error
     1109       or not glog
     1110       then do:
     1111         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     1112                                      , p-gate-rec
     1113                                      , p-gate-rec
     1114                                      , v-esm
     1115                                      ).
     1116       end.
     1117       p-dsh:private-data = buf_clob-data.file-name_ + chr(4) + p-gate-rec.
     1118       if not valid-handle(p-xmlh)
     1119       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1120         create temp-table v-txmlh.
     1121         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1122         v-txmlh:temp-table-prepare("temp-xml-tables").
     1123         p-xmlh = v-txmlh:default-buffer-handle.
     1124       end.
     1125       do v-ii = 1 to p-dsh:num-buffers:
     1126         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1127         if not p-xmlh:available then do:
     1128           p-xmlh:buffer-create().
     1129           assign
     1130           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1131           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1132           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1133           p-xmlh::gate-handle_ = p-dsh
     1134           p-xmlh::uniq-gate-rec = p-gate-rec
     1135           p-xmlh::gate-name = p-dsh:name
     1136           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1137           .
     1138           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1139             assign
     1140             p-xmlh::order = -3.
     1141           end.
     1142           p-xmlh:buffer-release().
     1143         end.
     1144       end.
     1145   end.
     1146   end procedure.
     1147   procedure get-gate-by-file :
     1148   define input  parameter p-schema-file-name as character no-undo .
     1149   define input  parameter p-gate-rec as character no-undo .
     1150   define output parameter p-dsh as handle no-undo .
     1151   define input-output  parameter p-xmlh as handle no-undo .
     1152   define variable v-ii as integer   no-undo .
     1153   define variable glog as logical   no-undo .
     1154   define variable v-rowid as rowid no-undo .
     1155   define variable v-tbl-name as character no-undo .
     1156   define variable v-longchar as longchar no-undo .
     1157   define variable v-txmlh as handle no-undo .
     1158   main-block:
     1159   do
     1160   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info3, return-value, chr(10), error-status :get-message (1))
     1161   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info3 )
     1162   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info3 )
     1163   :
     1164       COPY-LOB
     1165       FROM  FILE p-schema-file-name
     1166       TO  OBJECT v-longchar
     1167       no-convert
     1168       NO-ERROR .
     1169       if error-status :error then do:
     1170           undo, return error substitute("Не удалось считать файл схемы &1 в память&2&3"
     1171                                     , p-schema-file-name
     1172                                 , chr(10)
     1173                                 , error-status:get-message(1) ).
     1174       end.
     1175       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1176       if error-status :error then do:
     1177         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, p-schema-file-name, chr(10), error-status:get-message(1) , return-value ).
     1178       end.
     1179       create dataset p-dsh .
     1180       glog = p-dsh:READ-XMLSCHEMA( "longchar"
     1181                                     , v-longchar
     1182                                     , ?
     1183                                     , ?
     1184                                     , ?
     1185                                     ) no-error.
     1186       v-longchar = ''.
     1187       if error-status :error
     1188       or not glog
     1189       then do:
     1190         undo, return error substitute("Не удалось прочитать XML-схему из файла &1&2&3"
     1191                                      , p-schema-file-name
     1192                                      ,chr(10)
     1193                                      , error-status:get-message(1)
     1194                                      ).
     1195       end.
     1196       if not valid-handle(p-xmlh)
     1197       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1198         create temp-table v-txmlh.
     1199         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1200         v-txmlh:temp-table-prepare("temp-xml-tables").
     1201         p-xmlh = v-txmlh:default-buffer-handle.
     1202       end.
     1203       do v-ii = 1 to p-dsh:num-buffers:
     1204         p-xmlh:find-first(substitute(' where tbl-name = "&1" and  uniq-gate-rec = "&2" '
     1205                                      ,p-dsh:get-buffer-handle(v-ii):name
     1206                                      ,p-gate-rec
     1207                                      )) no-error.
     1208         if not p-xmlh:available then do:
     1209           p-xmlh:buffer-create().
     1210           assign
     1211           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):table
     1212           p-xmlh::uniq-gate-rec = p-gate-rec
     1213           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1214           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1215           p-xmlh::gate-handle_ = p-dsh
     1216           p-xmlh::gate-name = p-dsh:name
     1217           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1218           .
     1219           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1220             assign
     1221             p-xmlh::order = -3.
     1222           end.
     1223           p-xmlh:buffer-release().
     1224         end.
     1225       end.
     1226   end.
     1227   end procedure.
     1228   procedure gate-clear :
     1229   define input  parameter p-dsh as handle no-undo .
     1230   define input  parameter p-xmlh as handle no-undo .
     1231   define variable v-dsh as handle no-undo .
     1232   define variable v-th as handle no-undo .
     1233     do
     1234     on error undo, return error return-value
     1235     :
     1236       if valid-handle(p-dsh) then do:
     1237         delete object p-dsh.
     1238         v-dsh = p-dsh.
     1239         p-dsh = ?.
     1240       end.
     1241       repeat while true:
     1242         p-xmlh:find-first( substitute( " where gate-handle_ = &1 ", v-dsh)
     1243                            , share-lock) no-error.
     1244         if p-xmlh:available then do:
     1245           assign
     1246           v-th = p-xmlh:buffer-field("table-handle_"):buffer-value.
     1247           if valid-handle(p-xmlh:buffer-field("table-handle_"))
     1248           and valid-handle(v-th)
     1249           and v-th:dynamic = yes
     1250           then do:
     1251             delete object p-xmlh:buffer-field("table-handle_"):buffer-value.
     1252             p-xmlh:buffer-field("table-handle_"):buffer-value = ?.
     1253           end.
     1254           p-xmlh:buffer-delete().
     1255         end.
     1256         else do:
     1257           leave.
     1258         end.
     1259       end.
     1260       if p-xmlh:dynamic = yes
     1261       and valid-handle(p-xmlh)
     1262       then do:
     1263         delete object p-xmlh:table-handle.
     1264         p-xmlh = ?.
     1265       end.
     1266       v-dsh = ?.
     1267     end.
     1268   end procedure.
     1269   procedure all-gates-clear :
     1270   define parameter buffer buf_temp-xml-tables for temp-xml-tables.
     1271   do
     1272   on error undo, return error
     1273   :
     1274     for each buf_temp-xml-tables
     1275     break
     1276     by buf_temp-xml-tables.uniq-gate-rec
     1277     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1278     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1279     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1280     :
     1281         if first-of(buf_temp-xml-tables.uniq-gate-rec) then do:
     1282           delete object buf_temp-xml-tables.gate-handle_.
     1283           buf_temp-xml-tables.gate-handle_ = ?.
     1284         end.
     1285         if valid-handle(buf_temp-xml-tables.table-handle_)
     1286         and buf_temp-xml-tables.table-handle_:dynamic = no
     1287         then do:
     1288           delete object buf_temp-xml-tables.table-handle_.
     1289           buf_temp-xml-tables.table-handle_ = ?.
     1290         end.
     1291         delete buf_temp-xml-tables.
     1292     end.
     1293   end.
     1294   end procedure.
     1295   procedure fix-schemalocation :
     1296   define input-output  parameter p-longchar as longchar no-undo .
     1297   DEFINE VARIABLE hdoc AS HANDLE.
     1298   DEFINE VARIABLE hroot AS HANDLE.
     1299   DEFINE VARIABLE hnode-child AS HANDLE.
     1300   DEFINE VARIABLE hnode-attr AS HANDLE.
     1301   define variable v-jj as integer   no-undo .
     1302   define variable ok as logical   no-undo .
     1303   define variable v-path1                    as character                no-undo .
     1304   DEFINE VARIABLE v-full-path1               as character                no-undo .
     1305   DEFINE VARIABLE v-file-name1               as character                no-undo .
     1306   DEFINE VARIABLE v-file-name-no-ext1        as character                no-undo .
     1307   DEFINE VARIABLE v-file-name-ext1           as character                no-undo .
     1308   define variable v-schema-location          as character                no-undo .
     1309   do
     1310   on error undo, return error return-value
     1311   :
     1312     CREATE X-DOCUMENT hdoc.
     1313     CREATE X-noderef hroot.
     1314     CREATE X-noderef hnode-child.
     1315     CREATE X-noderef hnode-attr.
     1316     hdoc:load("longchar", p-longchar, no) no-error.
     1317     iF ERROR-STATUS:GET-MESSAGE(1) <> '' THEN message ERROR-STATUS:GET-MESSAGE(1) view-as alert-box .
     1318     hdoc:get-document-element(hroot).
     1319     _repeat:
     1320     REPEAT v-jj = 1 TO hroot:NUM-CHILDREN:
     1321       ok = hroot:GET-CHILD(hNode-Child, v-jj).
     1322       if not ok then next.
     1323       if hNode-Child:local-name = "include"
     1324       then do:
     1325         ok = hNode-Child:GET-ATTRIBUTE-NODE( hnode-attr, "schemaLocation" ).
     1326           v-schema-location = hnode-attr:node-value.
     1327           run gbl/filename.p (
     1328                           input "exe/" + hnode-attr:node-value
     1329                         ,output v-full-path1
     1330                         ,output v-path1
     1331                         ,output v-file-name1
     1332                         ,output v-file-name-no-ext1
     1333                         ,output v-file-name-ext1
     1334                         ) no-error .
     1335           if error-status :error then do:
     1336             delete object hnode-attr.
     1337             delete object hnode-child.
     1338             delete object hroot.
     1339             delete object hdoc.
     1340             undo, return error substitute("Не удалось определить расположение схемы &1", v-schema-location).
     1341           end.
     1342         ok = hNode-Child:sET-ATTRIBUTE(  "schemaLocation", v-full-path1 ).
     1343         leave  _repeat.
     1344       end.
     1345     END.
     1346     hdoc:save("longchar", p-longchar).
     1347     delete object hnode-attr.
     1348     delete object hnode-child.
     1349     delete object hroot.
     1350     delete object hdoc.
     1351   end.
     1352   end procedure.
     1353   procedure gate-clb_fill-xml-tables :
     1354   define input parameter p-dsh as handle no-undo .
     1355   define input-output parameter p-xmlh as handle no-undo .
     1356   define variable v-ii as integer no-undo .
     1357     do
     1358     on error undo, return error
     1359     :
     1360       do v-ii = 1 to p-dsh:num-buffers:
     1361         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1362         if not p-xmlh:available then do:
     1363           p-xmlh:buffer-create().
     1364           assign
     1365           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1366           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1367           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1368           p-xmlh::gate-handle_ = p-dsh
     1369           p-xmlh::uniq-gate-rec = entry(2, p-dsh:private-data, chr(4))
     1370           p-xmlh::gate-name = p-dsh:name
     1371           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1372           .
     1373           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1374             assign
     1375             p-xmlh::order = -3.
     1376           end.
     1377           p-xmlh:buffer-release().
     1378         end.
     1379       end.
     1380     end.
     1381   end procedure.
     1382   procedure all-gates-empty :
     1383   define buffer buf_temp-xml-tables for temp-xml-tables.
     1384   do
     1385   on error undo, return error
     1386   :
     1387     for each buf_temp-xml-tables
     1388     break
     1389     by buf_temp-xml-tables.uniq-gate-rec
     1390     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1391     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1392     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1393     :
     1394       if valid-handle(buf_temp-xml-tables.tbl-handle_) then do:
     1395         buf_temp-xml-tables.tbl-handle_:empty-temp-table().
     1396       end.
     1397     end.
     1398   end.
     1399   end procedure.
     1400   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1401   FUNCTION rum-fn_get-next-file-name returns character (
     1402                                       input p-base-file-name as character
     1403                                     , input p-index as integer):
     1404   define variable v-loc-file-name as character no-undo .
     1405   v-loc-file-name = substitute("&1_&2.&3"
     1406                               ,substring(p-base-file-name, 1, (if r-index(p-base-file-name, ".") > 1
     1407                                                         then (r-index(p-base-file-name, ".") - 1)
     1408                                                         else length(p-base-file-name)
     1409                                                         )
     1410                                           )
     1411                               ,p-index
     1412                               ,(if r-index(p-base-file-name, ".") > 1
     1413                                 then substring(p-base-file-name, r-index(p-base-file-name, ".") + 1)
     1414                                 else '')
     1415                                 )
     1416                                 .
     1417   return v-loc-file-name.
     1418   end function.
     1419   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1420   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
     1421   run gbl/getobjsrvhndl.p (input-output ObjSrv).
     1422   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1423   function context_get-thobj-es return logical
     1424   (
     1425      input p-esys-id as integer
     1426     ,input p-eobj-type as character
     1427     ,input p-eobj-code as integer
     1428     ,output p-obj-type as character
     1429     ,output p-obj-code as integer
     1430   ):
     1431      define variable v-value-list as character no-undo .
     1432      define variable v-field-list as character no-undo .
     1433      define buffer buf_clients for ub.clients.
     1434      define buffer buf_ext-classif for ub.ext-classif.
     1435      find first buf_ext-classif no-lock where
     1436                buf_ext-classif.classif-name = 'clients-esys':U
     1437            and buf_ext-classif.classif-subject = 'clients':U
     1438            and buf_ext-classif.db-num = 0
     1439            and buf_Ext-classif.key#_one = p-esys-id
     1440            and buf_Ext-classif.charkey_one = p-eobj-type
     1441            and buf_Ext-classif.key#_two = p-eobj-code no-error .
     1442      if available buf_Ext-classif
     1443      then do:
     1444         ObjSrv:Lib:KeyRec:GenKeyFv (
     1445                                         input buf_Ext-classif.uniq-key-rec
     1446                                         ,output v-field-list
     1447                                         ,output v-value-list).
     1448         assign
     1449            p-obj-type = entry(lookup("obj-type":U
     1450                                     , v-field-list
     1451                                     , chr(3))
     1452                                     , v-value-list, chr(3))
     1453            p-obj-code = integer(entry(lookup("obj-code":U
     1454                                            , v-field-list
     1455                                            , chr(3))
     1456                                      , v-value-list
     1457                                      , chr(3)))
     1458         no-error .
     1459      end.
     1460      if     available buf_ext-classif
     1461         and (p-obj-type = 'маг':U
     1462              or
     1463              p-obj-type = 'скл':U
     1464              )
     1465         and (p-obj-code > 0 and p-obj-code <= 99999)
     1466      then do:
     1467         find first buf_clients no-lock where
     1468                    buf_clients.obj-type = p-obj-type
     1469                and buf_clients.obj-code = p-obj-code no-error.
     1470         if available buf_clients then do:
     1471            return yes.
     1472         end.
     1473         else do:
     1474            assign
     1475               p-obj-type = '':U
     1476               p-obj-code = 0
     1477            .
     1478            return no.
     1479         end.
     1480      end.
     1481      else do:
     1482         assign
     1483            p-obj-type = '':U
     1484            p-obj-code = 0
     1485         .
     1486         return no.
     1487      end.
     1488   end.
