     3834                       then do:
     3835                           assign
     3836                               p-out-string = p-out-string + " ":U
     3837                           .
     3838                       end.
     3839                       when chr(5)
     3840                       then do:
     3841                           assign
     3842                               p-out-string = p-out-string + " ":U
     3843                           .
     3844                       end.
     3845                       when chr(6)
     3846                       then do:
     3847                           assign
     3848                               p-out-string = p-out-string + " ":U
     3849                           .
     3850                       end.
     3851                       when chr(7)
     3852                       then do:
     3853                           assign
     3854                               p-out-string = p-out-string + " ":U
     3855                           .
     3856                       end.
     3857                       when chr(8)
     3858                       then do:
     3859                           assign
     3860                               p-out-string = p-out-string + " ":U
     3861                           .
     3862                       end.
     3863                       when chr(9)
     3864                       then do:
     3865                           assign
     3866                               p-out-string = p-out-string + " ":U
     3867                           .
     3868                       end.
     3869                       when chr(29)
     3870                       then do:
     3871                           assign
     3872                               p-out-string = p-out-string + " ":U
     3873                           .
     3874                       end.
     3875                       when chr(10)
     3876                       then do:
     3877                           assign
     3878                               p-out-string = p-out-string + " ":U
     3879                           .
     3880                       end.
     3881                       when chr(13)
     3882                       then do:
     3883                           assign
     3884                               p-out-string = p-out-string + " ":U
     3885                           .
     3886                       end.
     3887                       otherwise do:
     3888                           assign
     3889                               p-out-string = p-out-string + v-current-char
     3890                           .
     3891                       end.
     3892                   end case.
     3893               end.
     3894           end.
     3895       end case.
     3896   end.
     3897   end .
     3898   procedure xmlchar-decode :
     3899   define input parameter p-in-string      as character        no-undo.
     3900   define output parameter p-out-string    as character        no-undo.
     3901       define variable v-position      as integer      no-undo.
     3902       define variable v-last-position as integer      no-undo.
     3903       define variable v-temp-integer  as integer      no-undo.
     3904       define variable v-current-char  as character    no-undo.
     3905       define variable v-next-char     as character    no-undo.
     3906       define variable v-success       as logical      no-undo.
     3907   do
     3908   on error undo, return error
     3909   :
     3910       assign
     3911           p-out-string = "":U
     3912           v-position   = 0
     3913       .
     3914       replace-cycle:
     3915       do while yes
     3916       on error undo, return error
     3917       :
     3918           assign
     3919               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     3920           .
     3921           if v-last-position <= v-position
     3922           then do:
     3923               if v-position = 0
     3924               then do:
     3925                   assign
     3926                       p-out-string = p-in-string
     3927                   .
     3928               end.
     3929               else do:
     3930                   assign
     3931                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     3932                   .
     3933               end.
     3934               leave replace-cycle.
     3935           end.
     3936           else do:
     3937               assign
     3938                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     3939                   v-position      = v-last-position
     3940                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     3941               .
     3942               if v-current-char = "#":U
     3943               then do:
     3944                   assign
     3945                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     3946                   .
     3947                   if v-last-position > 0
     3948                   then do:
     3949                       run xmlchar-read-integer in this-procedure
     3950                        (
     3951                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     3952                           , output v-temp-integer
     3953                           , output v-success
     3954                       ).
     3955                       if v-success = yes
     3956                       and v-temp-integer >= 1
     3957                       and v-temp-integer <= 255
     3958                       then do:
     3959                           assign
     3960                               p-out-string = p-out-string + chr( v-temp-integer )
     3961                               v-position   = v-last-position + 1
     3962                           .
     3963                       end.
     3964                       else do:
     3965                           assign
     3966                               p-out-string = p-out-string + "&":U
     3967                               v-position   = v-position   + 1
     3968                           .
     3969                       end.
     3970                   end.
     3971                   else do:
     3972                       assign
     3973                           p-out-string = p-out-string + "&":U
     3974                           v-position   = v-position   + 1
     3975                       .
     3976                   end.
     3977               end.
     3978               else do:
     3979                   case substring( p-in-string, v-position + 1, 3 )
     3980                   :
     3981                       when "lt;":U
     3982                       then do:
     3983                           assign
     3984                               p-out-string = p-out-string + "<":U
     3985                               v-position   = v-position   + 3
     3986                           .
     3987                       end.
     3988                       when "gt;":U
     3989                       then do:
     3990                           assign
     3991                               p-out-string = p-out-string + ">":U
     3992                               v-position   = v-position   + 3
     3993                           .
     3994                       end.
     3995                       otherwise do:
     3996                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     3997                           then do:
     3998                               assign
     3999                                   p-out-string = p-out-string + "&":U
     4000                                   v-position   = v-position   + 4
     4001                               .
     4002                           end.
     4003                           else do:
     4004                               case substring( p-in-string, v-position + 1, 5 )
     4005                               :
     4006                                   when "quot;":U
     4007                                   then do:
     4008                                       assign
     4009                                           p-out-string = p-out-string + '"':U
     4010                                           v-position   = v-position   + 5
     4011                                       .
     4012                                   end.
     4013                                   when "apos;":U
     4014                                   then do:
     4015                                       assign
     4016                                           p-out-string = p-out-string + "'":U
     4017                                           v-position   = v-position   + 5
     4018                                       .
     4019                                   end.
     4020                                   otherwise do:
     4021                                       assign
     4022                                           p-out-string = p-out-string + "&":U
     4023                                       .
     4024                                   end.
     4025                               end case.
     4026                           end.
     4027                       end.
     4028                   end case.
     4029               end.
     4030           end.
     4031       end.
     4032   end.
     4033   end .
     4034   procedure xmlchar-read-integer :
     4035   define input parameter p-input-string      as character        no-undo.
     4036   define output parameter p-output-integer   as integer          no-undo.
     4037   define output parameter p-success       as logical          no-undo.
     4038   do
     4039   on error undo, return error
     4040   :
     4041       assign
     4042           p-output-integer = integer( p-input-string )
     4043       no-error.
     4044       if error-status :error
     4045       then do:
     4046           assign
     4047               p-success           = no
     4048               p-output-integer    = 0
     4049           .
     4050       end.
     4051       else do:
     4052           assign
     4053               p-success           = yes
     4054           .
     4055       end.
     4056   end.
     4057   end.
     4058   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4059   define temp-table temp-rel-handle no-undo
     4060   field dh as handle
     4061   field ii as integer
     4062   field active_ as logical
     4063   field child-buffer_ as character
     4064   field parent-buffer_ as character
     4065   field child-buffer-handle as handle
     4066   field parent-buffer-handle as handle
     4067   field name_ as character
     4068   field nested_ as logical
     4069   field relation-fields_ as character
     4070   field reposition_ as logical
     4071   field type_ as character
     4072   field query_ as handle
     4073   field where-string_ as character
     4074   field tbl-handle_ as handle
     4075   index pi is unique primary
     4076   ii
     4077   index iparentname parent-buffer_ child-buffer_
     4078   index iparenthandle parent-buffer-handle child-buffer-handle
     4079   .
     4080   procedure tmpreldf_get-relations :
     4081   define input parameter p-dataseth as handle no-undo .
     4082   define variable v-ii as integer no-undo .
     4083   define buffer buf_temp-rel-handle for temp-rel-handle.
     4084   do
     4085   on error undo, return error
     4086   :
     4087     if not valid-handle(p-dataseth)
     4088     or p-dataseth:type <> "DATASET"
     4089     then do:
     4090       return error substitute("Не определен dataset с handle &1", p-dataseth).
     4091     end.
     4092     for each buf_temp-rel-handle where
     4093             buf_temp-rel-handle.dh = p-dataseth:
     4094       delete buf_temp-rel-handle.
     4095     end.
     4096     do v-ii = 1 to p-dataseth:num-relations:
     4097       create buf_temp-rel-handle.
     4098       assign
     4099       buf_temp-rel-handle.ii = v-ii
     4100       buf_temp-rel-handle.dh = p-dataseth
     4101       buf_temp-rel-handle.active_ = p-dataseth:get-relation(v-ii):active
     4102       buf_temp-rel-handle.child-buffer_ = p-dataseth:get-relation(v-ii):child-buffer:name
     4103       buf_temp-rel-handle.parent-buffer_ = p-dataseth:get-relation(v-ii):parent-buffer:name
     4104       buf_temp-rel-handle.child-buffer-handle = p-dataseth:get-relation(v-ii):child-buffer
     4105       buf_temp-rel-handle.tbl-handle_ = buf_temp-rel-handle.child-buffer-handle
     4106       buf_temp-rel-handle.parent-buffer-handle = p-dataseth:get-relation(v-ii):parent-buffer
     4107       buf_temp-rel-handle.name_ = p-dataseth:get-relation(v-ii):name
     4108       buf_temp-rel-handle.nested_ = p-dataseth:get-relation(v-ii):nested
     4109       buf_temp-rel-handle.relation-fields_ = p-dataseth:get-relation(v-ii):relation-fields
     4110       buf_temp-rel-handle.reposition_ = p-dataseth:get-relation(v-ii):reposition
     4111       buf_temp-rel-handle.type_ = p-dataseth:get-relation(v-ii):type
     4112       buf_temp-rel-handle.query_ = p-dataseth:get-relation(v-ii):query
     4113       buf_temp-rel-handle.where-string_ = p-dataseth:get-relation(v-ii):where-string
     4114       .
     4115     end.
     4116   end.
     4117   end procedure.
     4118   procedure tmpreldf_set-relations :
     4119   define input parameter p-srcdataseth as handle no-undo .
     4120   define input parameter p-trgdataseth as handle no-undo .
     4121   define variable gh as handle no-undo .
     4122   define buffer buf_temp-rel-handle for temp-rel-handle.
     4123   do
     4124   on error undo, return error
     4125   :
     4126     if not valid-handle(p-srcdataseth)
     4127     or p-srcdataseth:type <> "DATASET"
     4128     then do:
     4129       return error substitute("Не определен dataset-источник с handle &1", p-srcdataseth).
     4130     end.
     4131     if not valid-handle(p-trgdataseth)
     4132     or p-trgdataseth:type <> "DATASET"
     4133     then do:
     4134       return error substitute("Не определен dataset-приемник с handle &1", p-trgdataseth).
     4135     end.
     4136     for each buf_temp-rel-handle no-lock where
     4137             buf_temp-rel-handle.dh = p-srcdataseth
     4138     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4139     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     4140     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     4141     :
     4142       gh = p-trgdataseth:ADD-RELATION ( buf_temp-rel-handle.parent-buffer-handle
     4143                                         , buf_temp-rel-handle.child-buffer-handle
     4144                                         , buf_temp-rel-handle.relation-fields_
     4145                                         , buf_temp-rel-handle.reposition_
     4146                                         , buf_temp-rel-handle.nested_).
     4147      if error-status:error
     4148      or not valid-handle(gh) then do:
     4149        undo, return error substitute("Ошибка при добавлении relation &1 в dataset &2", buf_temp-rel-handle.name, p-trgdataseth:name).
     4150      end.
     4151     end.
     4152   end.
     4153   end procedure.
     4154   procedure tmpreld2_query :
     4155   define  parameter buffer buf_temp-rel-handle for temp-rel-handle.
     4156   define input-output parameter p-child-qh as handle no-undo .
     4157   define variable glog as logical no-undo .
     4158   define variable v-mess as character no-undo .
     4159   _main:
     4160   do
     4161   on error undo, return error
     4162   :
     4163     create query p-child-qh .
     4164     glog = p-child-qh:set-buffers( buf_temp-rel-handle.child-buffer-handle) no-error.
     4165     if error-status:error
     4166     or
     4167     not glog then do:
     4168       v-mess = substitute("Ошибка при попытке получить записи &1&2&3"
     4169                           , buf_temp-rel-handle.child-buffer_
     4170                           , chr(10)
     4171                           , error-status:get-message(1)
     4172                           ).
     4173       delete object p-child-qh no-error.
     4174       undo _main, return error v-mess.
     4175     end.
     4176     glog = p-child-qh:query-prepare( substitute( "for each &1 &2 "
     4177                                               , buf_temp-rel-handle.child-buffer_
     4178                                               , buf_temp-rel-handle.where-string_
     4179                                               )) no-error .
     4180     if error-status:error
     4181     or
     4182     not glog then do:
     4183       v-mess =  substitute("Ошибка при попытке получить записи &1&2&3"
     4184                           , buf_temp-rel-handle.child-buffer_
     4185                           , chr(10)
     4186                           , error-status:get-message(1)
     4187                           ).
     4188       delete object p-child-qh no-error.
     4189       undo _main, return error v-mess.
     4190     end.
     4191     glog = p-child-qh:query-open no-error .
     4192     if error-status:error
     4193     or
     4194     not glog then do:
     4195       v-mess = substitute("Ошибка при попытке получить записи &1&2&3"
     4196                           , buf_temp-rel-handle.child-buffer_
     4197                           , chr(10)
     4198                           , error-status:get-message(1)
     4199                           ).
     4200       delete object p-child-qh no-error.
     4201       undo _main, return error v-mess.
     4202     end.
     4203   end.
     4204   end procedure.
     4205   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4206     define new SHARED temp-table  tt-tax no-undo
     4207   field tax-code    like ub.tax.tax-code
     4208   FIELD individual  like ub.tax.individual
