     2293   procedure get-header-by-rec :
     2294   define input  parameter p-gate-rec as character no-undo .
     2295   define output parameter p-tth as handle no-undo .
     2296   define variable v-ii as integer   no-undo .
     2297   define variable glog as logical   no-undo .
     2298   define variable v-rowid as rowid no-undo .
     2299   define variable v-tbl-name as character no-undo .
     2300   define variable v-longchar as longchar no-undo .
     2301   define variable v-txmlh as handle no-undo .
     2302   define buffer buf_clob-data for ub.clob-data.
     2303   main-block:
     2304   do
     2305   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info14, return-value, chr(10), error-status :get-message (1))
     2306   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info14 )
     2307   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info14 )
     2308   :
     2309     run gen-row-keyr in  this-procedure  (
     2310                                           input  p-gate-rec
     2311                                           ,input  ?
     2312                                           ,input  "ub"
     2313                                           ,input  ?
     2314                                           ,input  NO-LOCK
     2315                                           ,output v-rowid
     2316                                           ,output v-tbl-name   ) no-error.
     2317       find first buf_clob-data no-lock where
     2318                 rowid(buf_clob-data) = v-rowid  no-error.
     2319       if not available buf_clob-data then do:
     2320         undo, return error substitute("Не найден CLOB  &1"
     2321                                         , p-gate-rec
     2322                                         ).
     2323       end.
     2324       assign
     2325       v-longchar = buf_clob-data.cdata
     2326       .
     2327       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     2328       if error-status :error then do:
     2329         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     2330       end.
     2331       create temp-table p-tth .
     2332       glog = p-tth:READ-XMLSCHEMA( "LONGCHAR"
     2333                                     , v-longchar
     2334                                     , ?
     2335                                     , ?
     2336                                     , ?
     2337                                     ) no-error.
     2338       v-longchar = '':U.
     2339       define variable v-esm as character no-undo .
     2340       v-esm = error-status:get-message(1).
     2341       if error-status :error
     2342       or not glog
     2343       then do:
     2344         delete object p-tth no-error.
     2345         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     2346                                    , p-gate-rec
     2347                                    , buf_clob-data.file-name_
     2348                                    , chr(10)
     2349                                    , v-esm
     2350                                     ).
     2351       end.
     2352   end.
     2353   end procedure.
     2354   // { bge/getoxmlh.i } 23/VIII-2018 xmllib.i и tmpcxmlh.i вставлены напрямую
     2355   define variable vss-include-info15 as character format "X(65)" no-undo
     2356   initial "@(#)$Workfile$ $Revision$".
     2357   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2358   define stream stmXMLOut.
     2359   define stream stmXMLLog.
     2360   define stream strXMLIn.
     2361   define temp-table temp_xmllib_rec-list no-undo
     2362       field recName       as character
