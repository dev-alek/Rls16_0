     3792       define variable v-current-char  as character    no-undo.
     3793   do
     3794   on error undo, return error
     3795   :
     3796       assign
     3797           p-out-string = "":U
     3798       .
     3799       case p-in-string
     3800       :
     3801           when ?
     3802           then do:
     3803               assign
     3804                   p-out-string = "?":U
     3805               .
     3806           end.
