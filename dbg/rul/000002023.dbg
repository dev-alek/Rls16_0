     4210   field rate-code   like ub.tax-rate.rate-code
     4211   FIELD rate-name   like ub.tax-rate.rate-name FORMAT "X(12)"
     4212   FIELD tax-type    like ub.tax.tax-type
     4213   field rate-value  like ub.tax-rate-value.rate-value
     4214   FIELD tax-rate-gds-rc  as recid
     4215   FIELD to-cashdesk like ub.tax.to-cashdesk
     4216   FIELD fact-date like ub.tax-rate-value.fact-date
     4217   FIELD fact-order like ub.tax-rate-value.fact-order
     4218   FIELD next-order like ub.tax-rate-value.fact-order
     4219   FIELD corr-user-name like ub.tax-rate-gds.corr-user-name
     4220   FIELD corr-user-db-num   like ub.tax-rate-gds.corr-user-db-num
     4221   FIELD corr-date like ub.tax-rate-gds.corr-date
     4222   FIELD corr-time like ub.tax-rate-gds.corr-time
     4223   index tax-code is unique primary tax-code fact-order descending rate-code.
     4224   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4225   DEFINE new SHARED TEMP-TABLE TT-tnved NO-UNDO
     4226   FIELD tnved  AS CHAR FORMAT "X(10)"  LABEL 'Код ТНВЭД':U
     4227   FIELD f-name AS CHAR FORMAT "X(255)" LABEL 'Полное наименование':U
