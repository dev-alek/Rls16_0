     4229   def var vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4230   procedure progs-name :
     4231     define input  parameter p-action-code         as character no-undo .
     4232     define output parameter p-main-prog-name      as character no-undo .
     4233     define output parameter p-list-db-proc-name   as character no-undo .
     4234     define output parameter p-commit-proc-name    as character no-undo .
     4235     define output parameter p-execution-proc-name as character no-undo .
     4236     define output parameter p-recover-proc-name   as character no-undo .
     4237     define output parameter p-after-proc-name     as character no-undo .
     4238     do
     4239     on error undo, return error
     4240     :
     4241       case p-action-code :
     4242               when 'crush_code-range':U then do:     assign       p-main-prog-name      = 'trg/code-rgt.p':U       p-list-db-proc-name   = 'utl/cdrg-dbl.p':U       p-commit-proc-name    = 'comm-crush-cdrg':U       p-execution-proc-name = 'exec-crush-cdrg':U       p-recover-proc-name   = 'rcvr-crush-cdrg':U       p-after-proc-name     = '':U     .   end.
     4243               when 'delete_code-range':U then do:     assign       p-main-prog-name      = 'trg/code-rgt.p':U       p-list-db-proc-name   = 'utl/cdrg-dbl.p':U       p-commit-proc-name    = 'comm-del-cdrg':U       p-execution-proc-name = 'exec-del-cdrg':U       p-recover-proc-name   = 'rcvr-del-cdrg':U       p-after-proc-name     = '':U     .   end.
     4244               when 'delete_nu-prt-bar-code':U then do:     assign       p-main-prog-name      = 'trg/bar-codt.p':U       p-list-db-proc-name   = 'str/barcddb.p':U       p-commit-proc-name    = 'block-del-prt-bar-code':U       p-execution-proc-name = 'delete-prt-bar-code':U       p-recover-proc-name   = 'undo-delete-prt-bar-code':U       p-after-proc-name     = '':U     .   end.
     4245               when 'delete_nu-part-bar-code':U then do:     assign       p-main-prog-name      = 'trg/bar-codt.p':U       p-list-db-proc-name   = 'str/barcddb.p':U       p-commit-proc-name    = 'block-del-part-bar-code':U       p-execution-proc-name = 'delete-part-bar-code':U       p-recover-proc-name   = 'undo-delete-part-bar-code':U       p-after-proc-name     = '':U     .   end.
     4246               when 'delete_nu-ucli-bar-code':U then do:     assign       p-main-prog-name      = 'trg/bar-codt.p':U       p-list-db-proc-name   = 'str/barcddb.p':U       p-commit-proc-name    = 'block-del-ucli-bar-code':U       p-execution-proc-name = 'delete-ucli-bar-code':U       p-recover-proc-name   = 'undo-delete-ucli-bar-code':U       p-after-proc-name     = '':U     .   end.
     4247               when 'delete_nu-dis-card':U then do:     assign       p-main-prog-name      = 'trg/discardt.p':U       p-list-db-proc-name   = 'trg/discardb.p':U       p-commit-proc-name    = 'block-del-dis-card':U       p-execution-proc-name = 'delete-dis-card':U       p-recover-proc-name   = 'undo-delete-dis-card':U       p-after-proc-name     = '':U     .   end.
     4248               when 'chown-dis-card':U then do:     assign       p-main-prog-name      = 'trg/discardt.p':U       p-list-db-proc-name   = 'trg/discardb.p':U       p-commit-proc-name    = 'block-chown-dis-card':U       p-execution-proc-name = 'chown-dis-card':U       p-recover-proc-name   = 'undo-chown-dis-card':U       p-after-proc-name     = 'after-chown-dis-card':U     .   end.
     4249               when 'delete_nu-dis-rule':U then do:     assign       p-main-prog-name      = 'trg/dis-rult.p':U       p-list-db-proc-name   = 'trg/disruldb.p':U       p-commit-proc-name    = 'block-del-dis-rule':U       p-execution-proc-name = 'delete-dis-rule':U       p-recover-proc-name   = 'undo-delete-dis-rule':U       p-after-proc-name     = '':U     .   end.
     4250               when 'ren-art':U then do:     assign       p-main-prog-name      = 'trg/goodst.p':U       p-list-db-proc-name   = 'utl/renartcd.p':U       p-commit-proc-name    = 'comm-ren-art':U       p-execution-proc-name = 'exec-ren-art':U       p-recover-proc-name   = 'rcvr-ren-art':U       p-after-proc-name     = 'after-ren-art':U     .   end.
     4251               when 'delete_nu-clob-data':U then do:     assign       p-main-prog-name      = 'trg/clobdatt.p':U       p-list-db-proc-name   = 'trg/clbdatdb.p':U       p-commit-proc-name    = 'block-del-clob-data':U       p-execution-proc-name = 'delete-clob-data':U       p-recover-proc-name   = 'undo-delete-clob-data':U       p-after-proc-name     = '':U     .   end.
     4252               when 'delete_nu-layout':U then do:     assign       p-main-prog-name      = 'trg/layoutt.p':U       p-list-db-proc-name   = 'trg/layoutdb.p':U       p-commit-proc-name    = 'block-del-layout':U       p-execution-proc-name = 'delete-layout':U       p-recover-proc-name   = 'undo-delete-layout':U       p-after-proc-name     = '':U     .   end.
     4253               otherwise do:
     4254           return error substitute( "&1. Неизвестный тип операции: &2", vss-include-info21, p-action-code ).
     4255         end.
     4256       end case.
     4257     end.
     4258     return.
     4259   end procedure.
     4260   procedure progs-title :
     4261     define input  parameter p-action-code         as character no-undo .
     4262     define output parameter p-action-title      as character no-undo .
     4263     do
     4264     on error undo, return error
     4265     :
     4266       case p-action-code :
     4267               when 'crush_code-range':U then do:     assign       p-action-title        = "Разбиение диапазона кодов (code-range)"     .   end.
     4268               when 'delete_code-range':U then do:     assign       p-action-title        = "Удаление диапазона кодов (code-range)"     .   end.
     4269               when 'delete_nu-prt-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода признака"     .   end.
     4270               when 'delete_nu-part-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода партиии"     .   end.
     4271               when 'delete_nu-ucli-bar-code':U then do:     assign       p-action-title        = "Удаление неисп.бар-кода на доп ед.изм."     .   end.
     4272               when 'delete_nu-dis-card':U then do:     assign       p-action-title        = "Удаление неиспользуемой ДК"     .   end.
     4273               when 'chown-dis-card':U then do:     assign       p-action-title        = "Смена владельца ДК"     .   end.
     4274               when 'delete_nu-dis-rule':U then do:     assign       p-action-title        = "Удаление правила скидки по фирме и глобального правила скидки"     .   end.
     4275               when 'ren-art':U then do:     assign       p-action-title        = "Изм. артикула и(или) произв. товара"     .   end.
     4276               when 'delete_nu-clob-data':U then do:     assign       p-action-title        = "Удаление неиспользуемой clob-data"     .   end.
     4277               when 'delete_nu-layout':U then do:     assign       p-action-title        = "Удаление РАСКЛАДКИ"     .   end.
     4278               otherwise do:
     4279           return error substitute( "&1. Неизвестный тип операции: &2", vss-include-info21, p-action-code ).
     4280         end.
     4281       end case.
     4282     end.
     4283     return.
     4284   end procedure.
     4285   FUNCTION progs-title-function returns character(
     4286      input  p-action-code         as character):
     4287   define variable p-action-title      as character no-undo .
     4288     do
     4289     on error undo, return error
     4290     :
     4291       case p-action-code :
     4292               when 'crush_code-range':U then do:     assign       p-action-title        = "Разбиение диапазона кодов (code-range)"     .   end.
     4293               when 'delete_code-range':U then do:     assign       p-action-title        = "Удаление диапазона кодов (code-range)"     .   end.
     4294               when 'delete_nu-prt-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода признака"     .   end.
     4295               when 'delete_nu-part-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода партиии"     .   end.
     4296               when 'delete_nu-ucli-bar-code':U then do:     assign       p-action-title        = "Удаление неисп.бар-кода на доп ед.изм."     .   end.
     4297               when 'delete_nu-dis-card':U then do:     assign       p-action-title        = "Удаление неиспользуемой ДК"     .   end.
     4298               when 'chown-dis-card':U then do:     assign       p-action-title        = "Смена владельца ДК"     .   end.
     4299               when 'delete_nu-dis-rule':U then do:     assign       p-action-title        = "Удаление правила скидки по фирме и глобального правила скидки"     .   end.
     4300               when 'ren-art':U then do:     assign       p-action-title        = "Изм. артикула и(или) произв. товара"     .   end.
     4301               when 'delete_nu-clob-data':U then do:     assign       p-action-title        = "Удаление неиспользуемой clob-data"     .   end.
     4302               when 'delete_nu-layout':U then do:     assign       p-action-title        = "Удаление РАСКЛАДКИ"     .   end.
     4303               otherwise do:
     4304           return error substitute( "&1. Неизвестный тип операции: &2", vss-include-info21, p-action-code ).
     4305         end.
     4306       end case.
     4307     end.
     4308     return p-action-title.
     4309   end FUNCTION.
     4310   procedure get-row-keyr-string :
     4311    define input  parameter p-key-rec  as character no-undo.
     4312    define output parameter p-tbl-title as character no-undo.
     4313    define output parameter p-rec-string  as character no-undo.
     4314     do
     4315     on error undo, return error
     4316     :
     4317       define variable v-full-tbl-name as character no-undo .
     4318       define variable bh_tbl-name     as handle    no-undo .
     4319       define variable fh              as handle    no-undo .
     4320       define variable v-ok            as logical   no-undo .
     4321       define variable v-field-num     as integer   no-undo .
     4322       define variable v-count-fld     as integer   no-undo .
     4323       define variable v-tbl-name as character no-undo.
     4324       if p-key-rec = ?
     4325         or p-key-rec = "":U
     4326       then do:
     4327         return error substitute( "&1 (get-row-keyr-string). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info21 ).
     4328       end.
     4329       assign
     4330         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     4331         v-full-tbl-name = "ub.":U + v-tbl-name
     4332         v-field-num     = num-entries( p-key-rec, chr(3) ) - 1
     4333         p-rec-string         = "":U
     4334         v-count-fld     = 0
     4335       .
     4336       find ub._file
     4337         where ub._file._file-name = v-tbl-name
     4338         no-error.
     4339       if not available ub._file then do:
     4340         return error substitute( "&1. Таблица &2 отсутствует в БД", vss-include-info21, v-tbl-name ).
     4341       end.
     4342       assign
     4343       p-tbl-title = ub._file._file-label
     4344       .
     4345       find ub._index
     4346         where recid( ub._index  ) = ub._file._prime-index
     4347         no-error.
     4348       if not available ub._index
     4349         or LC( ub._index._index-name ) = "default":U
     4350       then do:
     4351         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info21, v-tbl-name ).
     4352       end.
     4353       block_where :
     4354       for each ub._index-field of ub._index  ,
     4355           each ub._field of _index-field
     4356           break by _index-seq
     4357       on error undo, return error
     4358       :
     4359         assign
     4360           v-count-fld = v-count-fld + 1
     4361         .
     4362         if v-count-fld > v-field-num then do:
     4363           leave block_where.
     4364         end.
     4365         if p-rec-string = "":U then do:
     4366           assign
     4367             p-rec-string = "":U
     4368           .
     4369         end.
     4370         else do:
     4371           assign
     4372             p-rec-string = p-rec-string + chr(32) + chr(44)
     4373           .
     4374         end.
     4375         assign
     4376           p-rec-string = p-rec-string + (if p-rec-string = "":u then "":U else chr(32)) + substitute( "&1 = &2":U, ub._field._label, entry( v-count-fld + 1 , p-key-rec, chr(3) ) )
     4377         .
     4378       end.
     4379       if v-count-fld <> v-field-num then do:
     4380         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info21, v-tbl-name ).
     4381       end.
     4382     end.
     4383     return.
     4384   end procedure.
     4385   FUNCTION uniq-key-rec-string-f returns character(
     4386      input  p-uniq-key-rec         as character):
     4387   define variable v-tbl-title as character no-undo .
     4388   define variable v-rec-string as character no-undo .
     4389     do
     4390     on error undo, return error
     4391     :
     4392       run get-row-keyr-string in this-procedure (
     4393                                                 input p-uniq-key-rec
     4394                                                 ,output v-tbl-title
     4395                                                 ,output v-rec-string).
     4396       assign
     4397       v-rec-string = (if v-tbl-title <> ? and
     4398                       v-tbl-title <> "":U
     4399                       then (v-tbl-title + ":")
     4400                      else "":U) + chr(32) + v-rec-string
     4401       .
     4402     end.
     4403     return v-rec-string.
     4404   end FUNCTION.
     4405   procedure create_db-rec_route :
     4406     define input parameter p1-uniq-key-rec as character no-undo .
     4407     define input parameter p1-action       as character no-undo .
     4408     define input parameter p1-operation    as character no-undo .
     4409     define input parameter p1-send-db-list as character no-undo .
     4410     define input parameter p1-db-init      as integer   no-undo .
     4411     define input parameter p1-parameters   as character no-undo .
     4412     define input parameter p1-answer-code  as integer   no-undo .
     4413     define input parameter p1-answer-msg   as character no-undo .
     4414     do
     4415     on error undo, return error
     4416     :
     4417       define variable v-command     as character no-undo .
     4418       define variable v-ind         as integer   no-undo .
     4419       define variable v-num-entries as integer   no-undo .
     4420       define variable v-curr-db     as integer   no-undo .
     4421       define variable v-db-for-send as character no-undo .
     4422       define variable v-db-num      as integer   no-undo .
     4423       define variable v-db-num-char as character no-undo .
     4424       define buffer buf_sys-ctrl    for ub.sys-ctrl .
     4425       find first buf_sys-ctrl no-lock .
     4426       assign
     4427         v-curr-db     = buf_sys-ctrl.db-num
     4428         v-db-for-send = "":U
     4429       .
     4430       if v-curr-db = 0 then do:
     4431         if p1-answer-code >= 0 then do:
     4432           if v-curr-db <> p1-db-init then do:
     4433             assign
     4434               v-db-for-send = string( p1-db-init )
     4435             .
     4436           end.
     4437         end.
     4438         else do:
     4439           assign
     4440             v-num-entries = num-entries( p1-send-db-list, chr(44) )
     4441           .
     4442           do v-ind = 1 to v-num-entries:
     4443             assign
     4444               v-db-num-char = entry( v-ind, p1-send-db-list, chr(44) )
     4445               v-db-num      = integer( v-db-num-char )
     4446             .
     4447             if v-db-num <> v-curr-db
     4448               and v-db-num <> p1-db-init
     4449             then do:
     4450               if v-db-for-send = "":U then do:
     4451                 assign
     4452                   v-db-for-send = v-db-num-char
     4453                 .
     4454               end.
     4455               else do:
     4456                 assign
     4457                   v-db-for-send =  v-db-for-send + chr(1) + v-db-num-char
     4458                 .
     4459               end.
     4460             end.
     4461           end.
     4462         end.
     4463       end.
     4464       else do:
     4465         assign
     4466           v-db-for-send = "0":U
     4467         .
     4468       end.
     4469       if v-db-for-send <> "":U then do:
     4470         assign
     4471           v-command = "command":U + chr(1)
     4472                       + "two-commit":U + chr(1)
     4473                       + p1-action + chr(1)
     4474                       + p1-operation + chr(1)
     4475                       + p1-uniq-key-rec + chr(1)
     4476                       + string( p1-db-init ) + chr(1)
     4477                       + p1-parameters + chr(1)
     4478                       + string( p1-answer-code ) + chr(1)
     4479                       + p1-answer-msg
     4480         .
     4481         run nws/cr-route.p ( input 'send-cmd':U
     4482                       ,input v-command
     4483                       ,input ?
     4484                       ,input v-db-for-send
     4485                       ) no-error .
     4486         if error-status :error then do:
     4487           return error return-value.
     4488         end.
     4489       end.
     4490     end.
     4491     return.
     4492   end procedure.
     4493   procedure create_msg_route :
     4494     define input parameter p2-send-db-list as character no-undo .
     4495     define input parameter p2-msg          as character no-undo .
     4496     do
     4497     on error undo, return error
     4498     :
     4499       define variable v-msg-command as character no-undo .
     4500       define variable v-ind         as integer   no-undo .
     4501       define variable v-num-entries as integer   no-undo .
     4502       define variable v-curr-db     as integer   no-undo .
     4503       define variable v-db-for-send as character no-undo .
     4504       define variable v-db-num      as integer   no-undo .
     4505       define variable v-db-num-char as character no-undo .
     4506       define buffer buf_sys-ctrl    for ub.sys-ctrl .
     4507       find first buf_sys-ctrl no-lock .
     4508       assign
     4509         v-curr-db     = buf_sys-ctrl.db-num
     4510         v-db-for-send = "":U
     4511       .
     4512       if v-curr-db = 0 then do:
     4513         assign
     4514           v-num-entries = num-entries( p2-send-db-list, chr(44) )
     4515         .
     4516         do v-ind = 1 to v-num-entries:
     4517           assign
     4518             v-db-num-char = entry( v-ind, p2-send-db-list, chr(44) )
     4519             v-db-num      = integer( v-db-num-char )
     4520           .
     4521           if v-db-num <> v-curr-db then do:
     4522             if v-db-for-send = "":U then do:
     4523               assign
     4524                 v-db-for-send = v-db-num-char
     4525               .
     4526             end.
     4527             else do:
     4528               assign
     4529                 v-db-for-send =  v-db-for-send + chr(1) + v-db-num-char
     4530               .
     4531             end.
     4532           end.
     4533         end.
     4534       end.
     4535       else do:
     4536         assign
     4537           v-db-for-send = "0":U
     4538         .
     4539       end.
     4540       if v-db-for-send <> "":U then do:
     4541         assign
     4542           v-msg-command = "command":U + chr(1)
     4543                           + "message-to-log":U + chr(1)
     4544                           + p2-msg
     4545         .
     4546         run nws/cr-route.p ( input 'send-cmd':U
     4547                       ,input v-msg-command
     4548                       ,input ?
     4549                       ,input v-db-for-send
     4550                       ) no-error .
     4551         if error-status :error then do:
     4552           return error substitute( "&1&2&3"
     4553                                     , return-value
     4554                                     , chr(10)
     4555                                     , error-status :get-message(1)
     4556                                   ).
     4557         end.
     4558       end.
     4559     end.
     4560     return.
     4561   end procedure.
     4562   function get-send-db-list returns character
     4563     ( input p-curr-db     as integer
     4564      ,input p-all-db-list as character
     4565     )
     4566   :
     4567     define variable v-send-db-list as character no-undo .
     4568     if p-curr-db = 0 then do:
     4569       assign
     4570         v-send-db-list = p-all-db-list
     4571       .
     4572     end.
     4573     else do:
     4574       assign
     4575         v-send-db-list = string(p-curr-db)
     4576       .
     4577     end.
     4578     return v-send-db-list .
     4579   end function .
