     4633   function 00110004_get-error-message returns character :
     4634   define variable v-ii as integer no-undo .
     4635   define variable v-mess as character no-undo .
     4636   DO v-ii = 1 TO ERROR-STATUS:NUM-MESSAGES:
     4637       v-mess = substitute("&1&2ош &3"
     4638                           ,v-mess
     4639                           ,chr(10)
     4640                           ,ERROR-STATUS:GET-MESSAGE(v-ii)).
     4641   END.
     4642   return v-mess.
     4643   end function.
     4644   function 00110004_after-import_f returns logical ( input p-d-card as character):
     4645     run 00110004_after-import in this-procedure ( input p-d-card) no-error.
     4646     run set-error in this-procedure ( input return-value ).
     4647     return not (error-status:error).
     4648   end function.
     4649   define variable p-esys-id as integer no-undo .
     4650   define variable p-xsd-file as character no-undo.
     4651   on delete of this-procedure do:
     4652     run delete-procedure in this-procedure .
     4653     run gate-clear in this-procedure ( input v_dataseth, input v-xmlh) no-error.
     4654   end.
     4655   run load-ruleset-context in this-procedure ( input p-ruleset-id) no-error .
     4656   if error-status:error
     4657   or return-value = "return" then return error.
     4658   define variable ImpData1 as class Route-data_ no-undo .
     4659   ImpData1 = new Route-data_( input parparentproc, input p-parent-handle, input p-log-handle, input this-procedure:handle, input v_dataseth, input v-xmlh) .
     4660   if not this-procedure:persistent then do:
     4661     run proc-main in this-procedure no-error .
     4662     if error-status:error then do:
     4663         run delete-procedure in this-procedure .
     4664         undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     4665     end.
     4666     run delete-procedure in this-procedure .
     4667   end.
     4668   procedure proc-main :
     4669   define variable v-mode as character no-undo .
     4670   define variable v-line-num as integer no-undo .
     4671   define variable v-present as logical no-undo .
     4672   define variable v-current-tbl-name as character no-undo .
     4673   define variable v-current-gds-code as integer no-undo .
     4674   define variable v-line-status_ as character no-undo .
     4675   define variable v-group-code as integer no-undo .
     4676   define variable v-depart-code as integer no-undo .
     4677   define variable v-class-code as integer no-undo .
     4678   define variable v-subclass-code as integer no-undo .
     4679   define variable v-rowid as rowid no-undo .
     4680   define variable v-table-name as character no-undo .
     4681   define variable v-vat-rate-code as integer   no-undo .
     4682   define variable v-field-list as character no-undo .
     4683   define variable v-current-b-code as integer   no-undo .
     4684   define variable v-current-b-gds-code as integer no-undo .
     4685   define variable v-current-prod-bc-b-str as character no-undo .
     4686   define variable v-current-prod-bc-b-code as integer   no-undo .
     4687   define variable v-current-prod-bc-bc-on as logical   no-undo .
     4688   define variable v-current-prod-bc-status_ as character no-undo .
     4689   define variable v-node-code as integer   no-undo .
     4690   define variable v_child-qh as handle no-undo .
     4691   define variable v_child2-qh as handle no-undo .
     4692   define buffer buf_temp-goods_ for temp-goods_.
     4693   define buffer buf_temp-bar-code_ for temp-bar-code_.
     4694   define buffer buf_temp-prod-bc_ for temp-prod-bc_.
     4695   define buffer buf_temp-rel-handle for temp-rel-handle.
     4696   define buffer buf2_temp-rel-handle for temp-rel-handle.
     4697   define buffer buf_ext-classif for ub.ext-classif.
     4698   define buffer buf_gds-grp for ub.gds-grp.
     4699   define buffer buf_tax-rate for ub.tax-rate.
     4700   define variable v-rid as recid no-undo .
     4701   _main:
     4702   do transaction
     4703   on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4704   on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
     4705   on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
     4706   :
     4707   run write-log  in p-log-handle (
     4708                                    input 0
     4709                                  , "&DLine").
     4710     run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute(".............Импорт данных по товарам из ВС")).
     4711   run write-log-and-file in p-log-handle (
     4712         input 1
     4713       , input log-file-name
     4714       , input 1
     4715       , input substitute("Импорт данных по товарам из файла &1", file-name)).
     4716   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4717   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run emptyscl in g#library
     4718     (output v-node-code
     4719     )  .
     4720   for each buf_temp-xml-tables where
     4721          buf_temp-xml-tables.order >= 0
     4722      and buf_temp-xml-tables.is-parent = yes
     4723   :
     4724     if buf_temp-xml-tables.tbl-name = "Header_" then next.
     4725     create query v_qh.
     4726     glog = v_qh:set-buffers( buf_temp-xml-tables.tbl-handle_) no-error.
     4727     if error-status:error
     4728     or
     4729     not glog then do:
     4730           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при попытке получить записи &1&2&3&2&4"                                                             , buf_temp-xml-tables.tbl-name                                                             , chr(10)                                                             , error-status:get-message(1)                                                             , return-value)).
     4731       undo _main, return error ''.
     4732     end.
     4733     glog = v_qh:query-prepare( substitute( "for each &1 by &1.line-num", buf_temp-xml-tables.tbl-name)) no-error .
     4734     if error-status:error
     4735     or
     4736     not glog then do:
     4737           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при попытке получить записи &1&2&3&2&4"                                                             , buf_temp-xml-tables.tbl-name                                                             , chr(10)                                                             , error-status:get-message(1)                                                             , return-value)).
     4738       if valid-handle(v_qh) then do:
     4739         delete object v_qh no-error.
     4740       end.
     4741       undo _main, return error ''.
     4742     end.
     4743     glog = v_qh:query-open no-error .
     4744     if error-status:error
     4745     or not glog then do:
     4746           .
     4747       if valid-handle(v_qh) then do:
     4748         delete object v_qh no-error.
     4749       end.
     4750       undo _main, return error ''.
     4751     end.
     4752       _stroka:
     4753       REPEAT:
     4754         v-retry-action = 0 .
     4755        _release:
     4756         do on error undo, retry:
     4757           if  retry then do:
     4758             v-retry-action = v-retry-action + 1.
     4759                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при импорте записи &5 &1&2&3&2&4"                                                                   , buf_temp-xml-tables.tbl-name                                                                   , num-rec                                                                   , chr(10)                                                                   , error-status:get-message(1)                                                                   , return-value)).
     4760             if valid-handle(v_qh) then do:
     4761               delete object v_qh no-error.
     4762             end.
     4763             undo _main, return error ''.
     4764           end.
     4765           if v-retry-action < 1 then do:
     4766                       ImpData1:Route-data_dump ( ) .
     4767           end.
     4768         end.
     4769         _rule:
     4770          do on error undo _rule, retry _rule:
     4771            if retry then do:
     4772              empty temp-table buf_temp-goods_.
     4773              empty temp-table buf_temp-bar-code_.
     4774              empty temp-table buf_temp-prod-bc_.
     4775              if valid-handle(v_qh) then do:
     4776                delete object v_qh no-error.
     4777              end.
     4778              if valid-handle(v_child-qh) then do:
     4779                delete object v_child-qh no-error.
     4780              end.
     4781              if valid-handle(v_child2-qh) then do:
     4782                delete object v_child2-qh no-error.
     4783              end.
     4784                         run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("&1&2&3"                                       , error-status:get-message(1)                                       , chr(10)                                       , return-value)).
     4785              undo _main, return error ''.
     4786            end.
     4787            else do:
     4788             v_qh:get-next().
     4789             IF v_qh:query-off-end then leave _stroka.
     4790             assign
     4791             v-current-tbl-name = ''
     4792             v-current-tbl-name = ImpData1:current-tbl-name() no-error.
     4793             case v-current-tbl-name:
     4794               when 'goods':U  THEN do:
     4795                 empty temp-table buf_temp-goods_.
     4796                 empty temp-table buf_temp-bar-code_.
     4797                 empty temp-table buf_temp-prod-bc_.
     4798                 _tr:
     4799                 do
     4800                 on error undo _rule, retry _rule
     4801                 :
     4802                   v-line-num = ImpData1:route-data_get-field-integer( input 'goods':U, input "line-num") .
     4803                   v-present = no.
     4804                   num-rec = num-rec + 1.
     4805                   v-current-gds-code  = ImpData1:route-data_get-field-integer( input 'goods':U, input "gds-code") .
     4806                   find first buf_temp-goods_ where
     4807                             buf_temp-goods_.gds-code = v-current-gds-code no-error.
     4808                   if not available buf_temp-goods_ then do:
     4809                     create  buf_temp-goods_.
     4810                     assign
     4811                     buf_temp-goods_.gds-code = v-current-gds-code
     4812                     .
     4813                   end.
     4814                   v-line-status_ = ImpData1:route-data_get-field-character( input 'goods':U, input "status_") .
     4815                   v-depart-code = ImpData1:route-data_get-field-integer( input 'goods':U, input "depart-code") .
     4816                   v-class-code = ImpData1:route-data_get-field-integer( input 'goods':U, input "class-code") .
     4817                   v-subclass-code = ImpData1:route-data_get-field-integer( input 'goods':U, input "subclass-code") .
     4818                   find first buf_ext-classif no-lock where
     4819                             buf_ext-classif.classif-subject = 'gds-grp':U
     4820                         and buf_ext-classif.classif-name = 'rpm_gds-grp':U
     4821                         AND buf_ext-classif.db-num = - 1
     4822                         and buf_ext-classif.key#_one = v-depart-code
     4823                         and buf_ext-classif.key#_two = v-class-code
     4824                         and buf_ext-classif.key#_three = v-subclass-code no-error.
     4825                   if not available buf_ext-classif then do:
     4826                                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Запись &1: Не найден узел товарного классификатора .../&2/&3/&4"                                               , v-line-num                                               , v-depart-code                                               , v-class-code                                                ,v-subclass-code )).
     4827                     undo _rule, retry _rule.
     4828                   end.
     4829                   RUN gen-row-keyr IN THIS-PROCEDURE ( INPUT buf_ext-classif.uniq-key-rec
     4830                                                       ,INPUT ?
     4831                                                       ,INPUT "ub"
     4832                                                       ,INPUT ?
     4833                                                       ,INPUT NO-LOCK
     4834                                                       ,OUTPUT v-rowid
     4835                                                       ,OUTPUT v-table-name) .
     4836                   find first buf_gds-grp no-lock where
     4837                             rowid(buf_gds-grp) = v-rowid .
     4838                   buf_temp-goods_.grp-code = buf_gds-grp.node-code.
     4839                   v-vat-rate-code = ImpData1:route-data_get-field-integer( input 'goods':U, input "rate-code") .
     4840                   v-field-list = "artic,prod-type,prod-code,gds-name,engl-name,label-name,chk-name,unit-base" +
     4841                                  ",wt-base,ms-base,unit-cli,cli-base-rate,qnty-cart,wt-cart,ms-cart,gds-type,PS,okdp" +
     4842                                  ",negative-rest,min-stock,alpha1,grp-code".
     4843                   assign
     4844                   glog = buffer buf_temp-goods_:handle:buffer-copy(ImpData1:route-data_get-record('goods':U), "gds-code") no-error.
     4845                   if not glog
     4846                   or error-status:error then do:
     4847                                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не удалось получить данные записи goods: &1&2&3"                                               , error-status:get-message(1)                                               , chr(10)                                               , return-value)).
     4848                     undo _rule, retry _rule.
     4849                   end.
     4850                   assign
     4851                   buf_temp-goods_.nationality = "российский"
     4852                   .
     4853                   _rel:
     4854                   for each buf_temp-rel-handle where
     4855                           buf_temp-rel-handle.parent-buffer_ = v-current-tbl-name:
     4856                     run tmpreld2_query in this-procedure ( buffer buf_temp-rel-handle, input-output v_child-qh) no-error .
     4857                     if error-status:error then do:
     4858                                           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input return-value).
     4859                       undo _rule, retry _rule.
     4860                     end.
     4861                     _child:
     4862                     repeat:
     4863                       v_child-qh:get-next().
     4864                       IF v_child-qh:query-off-end then do:
     4865                         delete object v_child-qh no-error.
     4866                         next _rel.
     4867                       end.
     4868                       case buf_temp-rel-handle.child-buffer_:
     4869                         when 'bar-code':U then do:
     4870                           v-current-b-code = ImpData1:route-data_get-field-integer( buffer buf_temp-rel-handle:handle, input buf_temp-rel-handle.child-buffer_, input "b-code") .
     4871                           v-current-b-gds-code = ImpData1:route-data_get-field-integer( buffer buf_temp-rel-handle:handle, input buf_temp-rel-handle.child-buffer_, input "gds-code") .
     4872                           if v-current-b-gds-code <> v-current-gds-code then do:
     4873                                                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Запись &1: нарушение схемы")).
     4874                             delete object v_child-qh no-error.
     4875                             undo _rule, retry _rule.
     4876                           end.
     4877                           find first buf_temp-bar-code_ where
     4878                                     buf_temp-bar-code_.gds-code = v-current-b-gds-code
     4879                                 and buf_temp-bar-code_.b-code = v-current-b-code  no-error.
     4880                           if not available buf_temp-bar-code_ then do:
     4881                             create  buf_temp-bar-code_.
     4882                             assign
     4883                             buf_temp-bar-code_.gds-code = v-current-gds-code
     4884                             buf_temp-bar-code_.b-code = v-current-b-code
     4885                             .
     4886                           end.
     4887                           assign
     4888                           glog = buffer buf_temp-bar-code_:handle:buffer-copy(buf_temp-rel-handle.child-buffer-handle
     4889                                                                               ,"gds-code,b-code") no-error .
     4890                           if not glog
     4891                           or error-status:error then do:
     4892                                                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не удалось получить данные записи <&4>: &1&2&3"                                                       , error-status:get-message(1)                                                       , chr(10)                                                       , return-value                                                       , 'bar-code':U )).
     4893                             undo _rule, retry _rule.
     4894                           end.
     4895                           _rel2:
     4896                           for each buf2_temp-rel-handle where
     4897                                   buf2_temp-rel-handle.parent-buffer_ = 'bar-code':U:
     4898                             run tmpreld2_query in this-procedure ( buffer buf2_temp-rel-handle, input-output v_child2-qh) no-error .
     4899                             if error-status:error then do:
     4900                                                           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input return-value).
     4901                               undo _rule, retry _rule.
     4902                             end.
     4903                             _child2:
     4904                             repeat:
     4905                               v_child2-qh:get-next().
     4906                               IF v_child2-qh:query-off-end then do:
     4907                                 delete object v_child2-qh no-error.
     4908                                 next _rel2.
     4909                               end.
     4910                               case buf2_temp-rel-handle.child-buffer_:
     4911                         when 'prod-bc':U
     4912                         THEN do:
     4913                                   v-current-prod-bc-b-str = ImpData1:route-data_get-field-character( buffer buf2_temp-rel-handle:handle, input buf2_temp-rel-handle.child-buffer_, input "b-str") .
     4914                                   v-current-prod-bc-b-code = ImpData1:route-data_get-field-integer( buffer buf2_temp-rel-handle:handle, input buf2_temp-rel-handle.child-buffer_, input "b-code") .
     4915                                   v-current-prod-bc-bc-on = ImpData1:route-data_get-field-logical( buffer buf2_temp-rel-handle:handle, input buf2_temp-rel-handle.child-buffer_, input "bc-on") .
     4916                                   v-current-prod-bc-status_ = ImpData1:route-data_get-field-character( buffer buf2_temp-rel-handle:handle, input buf2_temp-rel-handle.child-buffer_, input "status_") .
     4917                                   if v-current-prod-bc-b-code <> v-current-b-code then do:
     4918                                                                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Запись &1: нарушение схемы")).
     4919                                     delete object v_child2-qh no-error.
     4920                                     delete object v_child-qh no-error.
     4921                                     undo _rule, retry _rule.
     4922                                   end.
     4923                           find first buf_temp-prod-bc_ where
     4924                                     buf_temp-prod-bc_.b-str = v-current-prod-bc-b-str
     4925                                 and buf_temp-prod-bc_.b-code = v-current-prod-bc-b-code
     4926                                       no-error.
     4927                           if not available buf_temp-prod-bc_ then do:
     4928                             create  buf_temp-prod-bc_.
     4929                             assign
     4930                             buf_temp-prod-bc_.b-code = v-current-prod-bc-b-code
     4931                             buf_temp-prod-bc_.b-str = v-current-prod-bc-b-str
     4932                             .
     4933                           end.
     4934                           buf_temp-prod-bc_.bc-on = v-current-prod-bc-bc-on.
     4935                                   buf_temp-prod-bc_.status_ = v-current-prod-bc-status_.
     4936                           release buf_temp-prod-bc_ .
     4937                         end.
     4938                               end case.
     4939                             end.
     4940                             delete object v_child2-qh no-error.
     4941                           end.
     4942                           release buf_temp-bar-code_ .
     4943                         end.
     4944                       end case.
     4945                     end.
     4946                     delete object v_child-qh no-error.
     4947                   end.
     4948               run proc-save in this-procedure ( input v-line-num
     4949                                                ,input v-line-status_
     4950                                                ,input v-vat-rate-code
     4951                                                ,input v-node-code
     4952                                                ,input v-field-list
     4953                                                ,input no
     4954                                                ,input no
     4955                                                ,buffer buf_temp-goods_) no-error.
     4956               if error-status:error then do:
     4957                 run set-err-type in p-cont-handle
     4958                   ( input 'PROCESSING'
     4959                   ) no-error.
     4960                 if valid-handle(v_qh) then do:
     4961                   delete object v_qh no-error.
     4962                 end.
     4963                               run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("&1&2&3"                                            , error-status:get-message(1)                                           , chr(10)                                           , return-value)).
     4964                 undo _rule, retry _rule .
     4965               end.
     4966                 end.
     4967               end.
     4968             end case.
     4969           end.
     4970         end.
     4971         v-retry-action = 0 .
     4972        _release:
     4973         do on error undo, retry:
     4974           if  retry then do:
     4975             v-retry-action = v-retry-action + 1.
     4976                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("&1&2&3"                                       , error-status:get-message(1)                                       , chr(10)                                       , v-last-error-message )).
     4977             undo _main, return error ''.
     4978           end.
     4979         if v-retry-action < 1 then do:
     4980                   ImpData1:Route-data_dump ( ) .
     4981         end.
     4982         end.
     4983         if v-retry-action = 0 then do:
     4984           num-rec-ok = num-rec-ok + 1.
     4985         end.
     4986         run write-counter in p-log-handle ( input substitute("Обработано записей: &1, из них удачно: &2", num-rec, num-rec-ok)).
     4987       end.
     4988       v_qh:query-close().
     4989       if valid-handle(v_qh) then do:
     4990         delete object v_qh.
     4991       end.
     4992     end.
     4993     run write-log-and-file in p-log-handle (
     4994           input 1
     4995         , input log-file-name
     4996         , input 1
     4997         , input substitute("Обработано записей: &1, из них удачно: &2", num-rec, num-rec-ok)).
     4998   end.
     4999   end procedure.
     5000   procedure load-ruleset-context :
     5001   define input parameter p-ruleset-id as integer no-undo .
     5002   define buffer buf_rule-call-param for ub.rule-call-param.
     5003   define buffer buf_ext-system for ub.ext-system.
     5004   do
     5005   on error undo, return error
     5006   :
     5007    find first buf_rule-call-param no-lock where
     5008   buf_rule-call-param.codex_id = p-codex-id
     5009   and buf_rule-call-param.ruleset_id = p-ruleset-id
     5010   and buf_rule-call-param.call_id = p-call-id
     5011   and buf_rule-call-param.order_id = p-order-id
     5012   and buf_rule-call-param.rule_id = p-rule-id
     5013   and buf_rule-call-param.param-name = "p-esys-id"
     5014    no-error.
     5015   if available buf_rule-call-param then do:
     5016   assign p-esys-id = buf_rule-call-param.param-value-integer.
     5017   end.
     5018       find first buf_rule-call-param no-lock where
     5019   buf_rule-call-param.codex_id = p-codex-id
     5020   and buf_rule-call-param.ruleset_id = p-ruleset-id
     5021   and buf_rule-call-param.call_id = p-call-id
     5022   and buf_rule-call-param.order_id = p-order-id
     5023   and buf_rule-call-param.rule_id = p-rule-id
     5024   and buf_rule-call-param.param-name = "p-xsd-file"
     5025    no-error.
     5026   if available buf_rule-call-param then do:
     5027   assign p-xsd-file = buf_rule-call-param.param-value-character.
     5028   end.
     5029       case p-ruleset-id:
     5030         when 4 then do:
     5031           assign
     5032           v-sign = 1
     5033           v-current-host-code = p-host-code
     5034           v-current-obj-type = p-obj-type
     5035           v-current-obj-code = p-obj-code
     5036           v-current-db-num = g#db-num
     5037           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     5038           file-name  = entry(1, p-process-file-name, chr(4))
     5039           v_dataseth = handle(entry(2, p-process-file-name, chr(4)))
     5040           v-xmlh = buffer buf_temp-xml-tables:handle
     5041           v-esys-id = integer(p-doc-code)
     5042           v-extension = entry(num-entries(file-name, "."), file-name, ".")
     5043           v-pck-num = integer(entry(3, p-process-file-name, chr(4)))
     5044           log-file-name = entry(4, p-process-file-name, chr(4))
     5045           no-error
     5046           .
     5047           if error-status:error then do:
     5048                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибки параметров&1&2 ..."                                         , chr(10)                                         , error-status:get-message(1) )).
     5049             undo, return error substitute("Ошибки параметров&1&2 ..."                                         , chr(10)                                         , error-status:get-message(1) ).
     5050           end.
     5051           find first buf_ext-system no-lock where
     5052                     buf_ext-system.esys-id = v-esys-id
     5053                 and buf_ext-system.db-num = 0 no-error .
     5054           if not available buf_ext-system then do:
     5055                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не найдена ВС &1&2 ..."                                         , v-esys-id                                         , chr(10)                                         )).
     5056             undo, return error substitute("Не найдена ВС &1&2 ..."                                         , v-esys-id                                         , chr(10)                                         ).
     5057           end.
     5058           if v-extension = ''
     5059           or lookup(v-extension, "dat") = 0 then do:
     5060                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Файл &1 имеет недопустимое расширение &3&2 ..."                                         ,file-name                                         , chr(10)                                         , v-extension                                         )).
     5061             undo, return error substitute("Файл &1 имеет недопустимое расширение &3&2 ..."                                         ,file-name                                         , chr(10)                                         , v-extension                                         ).
     5062           end.
     5063           run tmpreldf_get-relations in this-procedure ( input  v_dataseth).
     5064         end.
     5065         otherwise do:
     5066           undo, return error "Неправильный вызов".
     5067         end.
     5068       end case.
     5069     end.
     5070   end procedure.
     5071   procedure delete-procedure :
     5072     do
     5073     on error undo, return error
     5074     :
     5075         for each temp-goods_:
     5076           delete temp-goods_.
     5077         end.
     5078         for each temp-bar-code_:
     5079           delete temp-bar-code_.
     5080         end.
     5081         for each temp-prod-bc_:
     5082           delete temp-prod-bc_.
     5083         end.
     5084         run garbcoll_clear in this-procedure .
     5085     end.
     5086   end procedure.
     5087   procedure proc-save :
     5088   define input  parameter p-line-num as integer   no-undo .
     5089   define input  parameter p-line-status_ as character no-undo .
     5090   define input  parameter p-vat-rate-code as integer   no-undo .
     5091   define input  parameter p-node-code as integer   no-undo .
     5092   define input  parameter p-field-list as character no-undo .
     5093   define input  parameter p-dif-nam1 as logical   no-undo .
     5094   define input  parameter p-dif-nam2 as logical   no-undo .
     5095   define parameter buffer buf_temp-goods_ for temp-goods_.
     5096   define buffer buf_temp-bar-code_ for temp-bar-code_.
     5097   define buffer buf_temp-prod-bc_ for temp-prod-bc_.
     5098   define buffer buf_goods for ub.goods.
     5099   define buffer buf_bar-code for ub.bar-code.
     5100   define buffer buf_prod-bc for ub.prod-bc.
     5101   define buffer buf_sysconf for ub.sysconf.
     5102   define variable v-rid as recid no-undo .
     5103   define variable v-gds-mode as character no-undo .
     5104   define variable v-bc-mode as character no-undo .
     5105   define variable v-pbc-mode as character no-undo .
     5106   define variable v-b-str as character no-undo .
     5107   define variable v-err-mess as character no-undo .
     5108   define variable v-nbc as integer   no-undo .
     5109   define variable v-stts as integer no-undo .
     5110   define variable v-field-list as character no-undo .
     5111   define variable v-ii as integer   no-undo .
     5112   define variable v-cmp as logical   no-undo .
     5113   define variable v-cmp-tax as logical no-undo init yes.
     5114   define variable v-key-rec as character no-undo .
     5115   define variable v-param as character no-undo .
     5116   DEFINE VARIABLE v-today as date no-undo .
     5117   DEFINE VARIABLE v-time as integer no-undo .
     5118   define variable v-taxvalue as decimal no-undo .
     5119   main-block:
     5120   do transaction
     5121   on error  undo main-block, retry main-block
     5122   on stop   undo main-block, retry main-block
     5123   on endkey undo main-block, retry main-block
     5124   :
     5125     if retry then do:
     5126       empty temp-table buf_temp-goods_.
     5127       empty temp-table buf_temp-bar-code_.
     5128       empty temp-table buf_temp-prod-bc_.
     5129             run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input v-err-mess).
     5130        return error ''.
     5131     end.
     5132     else do:
     5133       find first buf_goods share-lock where
     5134               buf_goods.gds-code = buf_temp-goods_.gds-code no-error.
     5135       if not available buf_goods then do:
     5136         v-gds-mode = 'ДОБАВЛЕНИЕ':U.
     5137         v-rid = ?.
     5138       end.
     5139       else do:
     5140         if not (buf_temp-goods_.prod-type = buf_goods.prod-type
     5141                 and
     5142                 buf_temp-goods_.prod-code = buf_goods.prod-code) then do:
     5143           v-err-mess =  substitute("Запись &1: Изменение производителя товара &2 недопустимо!!!"
     5144                                         ,p-line-num
     5145                                         ,buf_temp-goods_.gds-code
     5146                                         ,p-line-status_ ).
     5147           run set-err-type in p-cont-handle
     5148             ( input 'SYNCHRONIZATION'
     5149             ) no-error.
     5150           undo main-block, retry main-block .
     5151         end.
     5152         v-gds-mode = 'ИЗМЕНЕНИЕ':U.
     5153         v-rid = recid( buf_goods).
     5154         buffer buf_temp-goods_:handle:buffer-copy(buffer buf_goods:handle, p-field-list).
     5155       end.
     5156       if ((v-gds-mode = 'ДОБАВЛЕНИЕ':U and not p-line-status_ = 'N')
     5157       or (v-gds-mode = 'ИЗМЕНЕНИЕ':U and not (p-line-status_ = 'U' or p-line-status_ = 'D'))
     5158           )
     5159       and not (available buf_goods and  buf_goods.stts = integer('1':U) and p-line-status_ = 'N')
     5160       then do:
     5161         v-err-mess =  substitute("Запись &1: Неверное действие над товаром &2 (&3)"
     5162                                       ,p-line-num
     5163                                       ,buf_temp-goods_.gds-code
     5164                                       ,p-line-status_ ).
     5165         run set-err-type in p-cont-handle
     5166           ( input 'SYNCHRONIZATION'
     5167           ) no-error.
     5168         undo main-block, retry main-block .
     5169       end.
     5170       for each tt-tax:
     5171         delete tt-tax.
     5172       end.
     5173       run ref/dtaxgdss.p (
     5174             input yes
     5175           , input   buf_temp-goods_.unit-base
     5176           , input   p-node-code
     5177           , input (if v-gds-mode = 'ДОБАВЛЕНИЕ':U THEN ? ELSE v-rid)
     5178           , input (if v-gds-mode = 'ДОБАВЛЕНИЕ':U THEN ? ELSE v-rid)
     5179           , input   0
     5180           , input    ''
     5181           , input   0
     5182             ) no-error.
     5183       if error-status:error then do:
     5184         v-err-mess = substitute("Запись &1: Ошибки при определении налогов на товар:&2&3&2&4"
     5185                                  , p-line-num
     5186                                  , chr(10)
     5187                                  , error-status:get-message(1)
     5188                                  , return-value ).
     5189         undo main-block, retry main-block.
     5190       end.
     5191       find first tt-tax where
     5192                 tt-tax.tax-code = integer('1':U).
     5193       if tt-tax.rate-code <> p-vat-rate-code then do:
     5194         v-cmp-tax = no.
     5195       end.
     5196       run cur-time in this-procedure(output v-today, output v-time).
     5197   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5198   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftaxval in g#library
     5199     (input  ?
     5200     ,input  tt-tax.tax-code
     5201     ,input  tt-tax.rate-code
     5202     ,input  v-today
     5203     ,input  0
     5204     ,input  ''
     5205     ,input  0
     5206     ,output v-taxvalue
     5207     ) no-error .
     5208       if error-status:error or v-taxvalue = ? then do:
     5209         v-err-mess = substitute("Запись &1: Ошибка при поиске НДС (код ставкм &6) на текущую дату для товара &2&3&4&3&5"
     5210                                   , p-line-num
     5211                                   , buf_temp-goods_.gds-code
     5212                                   , chr(10)
     5213                                   , error-status:get-message(1)
     5214                                   , return-value
     5215                                   , tt-tax.rate-code
     5216                                   ).
     5217         undo main-block, retry main-block.
     5218       end.
     5219       if not v-gds-mode = 'ДОБАВЛЕНИЕ':U then do:
     5220         tt-tax.fact-date = v-today.
     5221       end.
     5222       assign
     5223       tt-tax.rate-code = p-vat-rate-code
     5224       .
     5225       if buf_temp-goods_.unit-cli = ''
     5226       or buf_temp-goods_.unit-cli = ? then do:
     5227         assign
     5228         buf_temp-goods_.unit-cli = buf_temp-goods_.unit-base
     5229         buf_temp-goods_.cli-base-rate = 1
     5230         .
     5231       end.
     5232       if buf_temp-goods_.cli-base-rate = 0
     5233       or buf_temp-goods_.cli-base-rate = ?
     5234       then do:
     5235         buf_temp-goods_.cli-base-rate = 1.
     5236       end.
     5237       if v-gds-mode = 'ИЗМЕНЕНИЕ':U then do:
     5238         buffer buf_temp-goods_:handle:buffer-copy(buffer buf_goods:handle, p-field-list).
     5239         do v-ii = 1 to num-entries(p-field-list):
     5240           v-field-list = v-field-list + (if v-ii = 1 then "" else chr(44)) + entry(v-ii, p-field-list) + chr(44) + entry(v-ii, p-field-list).
     5241       end.
     5242         v-cmp = buffer buf_temp-goods_ :handle:buffer-compare(buffer buf_goods:handle, "CASE-SENSITIVE", "", v-field-list).
     5243       end.
     5244       if v-gds-mode = 'ДОБАВЛЕНИЕ':U
     5245       or not v-cmp
     5246       or not v-cmp-tax
     5247       then do:
     5248       run ref/goods01.p (
     5249                           input parparentproc
     5250                           , input v-gds-mode
     5251                         , input no
     5252                         , input 0
     5253                         , input no
     5254                         , input yes
     5255                         , input no
     5256                         , input no
     5257                         , input no
     5258                         , input 0
     5259                         , input ''
     5260                         , input 0
     5261                         , input (if buf_temp-goods_.gds-type = 'т':U then  yes else no)
     5262                         , input ?
     5263                         , input buf_temp-goods_.gds-code
     5264                         , input buf_temp-goods_.artic
     5265                         , input buf_temp-goods_.prod-type
     5266                         , input buf_temp-goods_.prod-code
     5267                         , input p-node-code
     5268                         , input buf_temp-goods_.grp-code
     5269                         , input buf_temp-goods_.gds-name
     5270                         , input "":U
     5271                         , input buf_temp-goods_.engl-name
     5272                         , input buf_temp-goods_.label-name
     5273                         , input buf_temp-goods_.chk-name
     5274                         , input buf_temp-goods_.alpha1
     5275                         , input buf_temp-goods_.unit-base
     5276                         , input buf_temp-goods_.unit-cli
     5277                         , input 0
     5278                         , input 0
     5279                         , input buf_temp-goods_.cli-base-rate
     5280                         , input buf_temp-goods_.qnty-cart
     5281                         , input buf_temp-goods_.ms-base
     5282                         , input buf_temp-goods_.wt-base
     5283                         , input buf_temp-goods_.ms-cart
     5284                         , input buf_temp-goods_.wt-cart
     5285                         , input 'Группа':U
     5286                         , input 0
     5287                         , input buf_temp-goods_.negative-rest
     5288                         , input 0
     5289                         , input 0
     5290                         , input buf_temp-goods_.okdp
     5291                         , input buf_temp-goods_.destin
     5292                         , input buf_temp-goods_.attrib
     5293                         , input buf_temp-goods_.user-rule
     5294                         , input buf_temp-goods_.sert
     5295                         , input buf_temp-goods_.struct
     5296                         , input buf_temp-goods_.deadline
     5297                         , input 0
     5298                         , input buf_temp-goods_.sort
     5299                         , input 0
     5300                         , input 0
     5301                         , input 0
     5302                         , input ''
     5303                         , input buf_temp-goods_.nationality
     5304                         , input buf_temp-goods_.unit-cli
     5305                         , input buf_temp-goods_.cli-base-rate
     5306                         , input ?
     5307                         , input buf_temp-goods_.PS
     5308                         , input no
     5309                         , input no
     5310                         , input no
     5311                         , input no
     5312                         , input "no"
     5313                         , input p-dif-nam1
     5314                         , input p-dif-nam2
     5315                         , input no
     5316                         , input 2
     5317                         , input-output v-rid
     5318                         , output v-nbc
     5319                       ) no-error .
     5320       if error-status :error then do:
     5321         v-err-mess = substitute("Запись &1: Ошибка при сохранении goods &2&3&4&3&5"
     5322                                   , p-line-num
     5323                                   , buf_temp-goods_.gds-code
     5324                                   , chr(10)
     5325                                   , error-status:get-message(1)
     5326                                   , return-value ).
     5327         undo main-block, retry main-block.
     5328       end.
     5329       end.
     5330       find first buf_goods share-lock where
     5331                 recid(buf_goods) = v-rid .
     5332       if (p-line-status_ = 'D'
     5333       and buf_goods.stts = integer('0':U))
     5334       or (p-line-status_ <> 'D'
     5335       and buf_goods.stts <> integer('0':U)) then do:
     5336         v-stts = (if p-line-status_ = 'D'
     5337                   then integer('1':U)
     5338                   else integer('0':U)).
     5339         run ref/goods02.p (
     5340                       input recid(buf_goods)
     5341                       ,input yes
     5342                       ,input-output v-stts) no-error.
     5343       end.
     5344       if v-gds-mode = 'ДОБАВЛЕНИЕ':U then do:
     5345         find first buf_goods where
     5346                   recid(buf_goods) = v-rid.
     5347       end.
     5348       for each buf_temp-bar-code_ no-lock where
     5349               buf_temp-bar-code_.gds-code = buf_temp-goods_.gds-code
     5350       on error  undo main-block, retry main-block
     5351       on stop   undo main-block, retry main-block
     5352       on endkey undo main-block, retry main-block
     5353       :
     5354         find first buf_bar-code share-lock where
     5355                   buf_bar-code.b-code = buf_temp-bar-code_.b-code no-error.
     5356         if available buf_bar-code then do:
     5357           if buf_bar-code.stts_ = integer('79':U)
     5358           and buf_temp-bar-code_.b-code <> buf_temp-goods_.gds-code
     5359           then do:
     5360             v-bc-mode = 'ДОБАВЛЕНИЕ':U.
     5361           end.
     5362           else do:
     5363           v-bc-mode = 'ИЗМЕНЕНИЕ':U.
     5364           end.
     5365           v-rid = recid(buf_bar-code).
     5366         end.
     5367         else do:
     5368           v-bc-mode = 'ДОБАВЛЕНИЕ':U.
     5369           v-rid = ?.
     5370         end.
     5371         if  buf_temp-bar-code_.b-code = buf_temp-goods_.gds-code
     5372         and v-gds-mode = 'ДОБАВЛЕНИЕ':U then do:
     5373         end.
     5374         else do:
     5375           if (v-bc-mode = 'ДОБАВЛЕНИЕ':U and not buf_temp-bar-code_.status_ = 'N')
     5376           or (v-bc-mode = 'ИЗМЕНЕНИЕ':U
     5377               and not (buf_temp-bar-code_.status_ = 'U' or buf_temp-bar-code_.status_ = 'D')
     5378               and buf_temp-bar-code_.b-code <> buf_temp-goods_.gds-code
     5379               )
     5380         then do:
     5381             v-err-mess =  substitute("Запись &1: Неверное действие над бар-кодом &2 (&3) товара &4"
     5382                                         ,p-line-num
     5383                                           ,buf_temp-bar-code_.b-code
     5384                                           ,buf_temp-bar-code_.status_
     5385                                         ,buf_temp-goods_.gds-code
     5386                                           ).
     5387           run set-err-type in p-cont-handle
     5388             ( input 'SYNCHRONIZATION'
     5389             ) no-error.
     5390           undo main-block, retry main-block .
     5391         end.
     5392           if v-bc-mode = 'ДОБАВЛЕНИЕ':U
     5393           and available buf_bar-code
     5394           and buf_bar-code.stts_ = integer('79':U) then do:
     5395             v-bc-mode = 'ИЗМЕНЕНИЕ':U.
     5396           end.
     5397         end.
     5398         if buf_temp-bar-code_.status_ = 'D' then do:
     5399         end.
     5400         else do:
     5401         if buf_temp-bar-code_.b-code <> buf_temp-goods_.gds-code then do:
     5402         run ref/barcode1.p (
     5403             input (v-bc-mode + chr(44) + 'ДОБАВЛЕНИЕ-ИМПОРТ':U)
     5404         ,input yes
     5405         ,input buf_temp-bar-code_.b-code
     5406         ,input buf_temp-bar-code_.gds-code
     5407         ,input p-node-code
     5408         ,input '':U
     5409         ,input '':U
     5410         ,input buf_temp-bar-code_.unit-cli
     5411         ,input buf_temp-bar-code_.cli-base-rate
     5412         ,output v-rid
     5413         )
     5414         no-error.
     5415         if error-status :error then do:
     5416           v-err-mess = substitute("Запись &1: Ошибка при сохранении bar-code  &2&3&4&5&4&6"
     5417                                     , p-line-num
     5418                                     , buf_temp-bar-code_.b-code
     5419                                     , chr(10)
     5420                                     , error-status:get-message(1)
     5421                                     , return-value
     5422                                     ).
     5423           undo main-block, retry main-block.
     5424         end.
     5425         end.
     5426         end.
     5427         for each buf_temp-prod-bc_ no-lock where
     5428                 buf_temp-prod-bc_.b-code = buf_temp-bar-code_.b-code
     5429         on error  undo main-block, retry main-block
     5430         on stop   undo main-block, retry main-block
     5431         on endkey undo main-block, retry main-block
     5432         :
     5433           find first buf_prod-bc share-lock where
     5434                     buf_prod-bc.b-code = buf_temp-prod-bc_.b-code
     5435                 and buf_prod-bc.b-str = buf_temp-prod-bc_.b-str no-error.
     5436           if available buf_prod-bc then do:
     5437             v-pbc-mode = 'ИЗМЕНЕНИЕ':U.
     5438             v-rid = recid(buf_prod-bc).
     5439             buf_temp-prod-bc_.rc = recid(buf_prod-bc).
     5440           end.
     5441           else do:
     5442             v-pbc-mode = 'ДОБАВЛЕНИЕ':U.
     5443             v-rid = ?.
     5444           end.
     5445           if (v-pbc-mode = 'ДОБАВЛЕНИЕ':U and not buf_temp-prod-bc_.status_ = 'N')
     5446           or (v-pbc-mode = 'ИЗМЕНЕНИЕ':U and not (buf_temp-prod-bc_.status_ = 'U' or buf_temp-prod-bc_.status_ = 'D'))
     5447           then do:
     5448             v-err-mess =  substitute("Запись &1: Неверное действие над ДопБк &2 (&3)"
     5449                                           ,p-line-num
     5450                                           ,buf_temp-prod-bc_.b-str
     5451                                           ,buf_temp-prod-bc_.status_ ).
     5452             run set-err-type in p-cont-handle
     5453               ( input 'SYNCHRONIZATION'
     5454               ) no-error.
     5455             undo main-block, retry main-block .
     5456           end.
     5457           if buf_temp-prod-bc_.status_ = 'D'
     5458           and not available buf_prod-bc then do:
     5459             v-err-mess =  substitute("Запись &1: Неверное действие над ДопБк &2 (&3)"
     5460                                           ,p-line-num
     5461                                           ,buf_temp-prod-bc_.b-str
     5462                                           ,buf_temp-prod-bc_.status_ ).
     5463             run set-err-type in p-cont-handle
     5464               ( input 'SYNCHRONIZATION'
     5465               ) no-error.
     5466             undo main-block, retry main-block .
     5467           end.
     5468           if buf_temp-prod-bc_.status_ = 'N' then do:
     5469           v-b-str = buf_temp-prod-bc_.b-str.
     5470           run trg/prod-bc1.p (
     5471                               input parparentproc
     5472                              ,input yes
     5473                              ,input no
     5474                              ,input yes
     5475                              ,input no
     5476                              ,input ''
     5477                              ,input ''
     5478                              ,buffer buf_goods
     5479                              ,input buf_temp-bar-code_.b-code
     5480                              ,input-output v-b-str
     5481                              ,output v-rid
     5482                         ) no-error .
     5483             if error-status :error
     5484             or v-rid = ?
     5485             then do:
     5486               v-err-mess = substitute("Запись &1: Ошибка при сохранении ДопБк &2 (бар-код &3) &4&5&4&6"
     5487                                       , p-line-num
     5488                                       , buf_temp-prod-bc_.b-str
     5489                                       , buf_temp-prod-bc_.b-code
     5490                                       , chr(10)
     5491                                       , error-status:get-message(1)
     5492                                       , return-value
     5493                                       ).
     5494             undo main-block, retry main-block.
     5495           end.
     5496             buf_temp-prod-bc_.rc = v-rid.
     5497         end.
     5498           if buf_temp-prod-bc_.status_ = 'U' then do:
     5499             if buf_temp-prod-bc_.bc-on <> buf_prod-bc.bc-on then do:
     5500               buf_temp-prod-bc_.on-off = yes.
     5501               run trg/bc-upd.p (
     5502                             input parparentproc
     5503                           ,input buf_temp-prod-bc_.b-code
     5504                           ,input buf_temp-prod-bc_.b-str
     5505                           ,input buf_temp-prod-bc_.bc-on
     5506                           ,input yes
     5507                           ,input no
     5508                           ,input ?
     5509                           ,input this-procedure:handle
     5510                           ) no-error  .
     5511               if error-status:error then do:
     5512                 v-err-mess = substitute("Запись &1: Ошибки при вкл/выкл ДопБК &2:&3&4&3&5"
     5513                                         , p-line-num
     5514                                         , buf_temp-prod-bc_.b-str
     5515                                         ,chr(10)
     5516                                         , error-status:get-message(1)
     5517                                         , return-value ).
     5518                 undo main-block, retry main-block.
     5519               end.
     5520             end.
     5521           end.
     5522           if buf_temp-prod-bc_.status_ = 'D' then do:
     5523             if buf_prod-bc.bc-on-type <> '' then do:
     5524               v-err-mess = substitute("Запись &1: Нельзя удалить ДопБК типа &2", buf_prod-bc.bc-on-type).
     5525               undo main-block, retry main-block.
     5526             end.
     5527             assign
     5528             buf_prod-bc.bc-on = no
     5529             buf_temp-prod-bc_.bc-on = no
     5530             .
     5531             delete buf_prod-bc.
     5532           end.
     5533         end.
     5534         if buf_temp-bar-code_.status_ = 'D'
     5535         and buf_temp-bar-code_.unit-cli <> buf_goods.unit-base
     5536         then do:
     5537           find first buf_prod-bc no-lock where
     5538                     buf_prod-bc.b-code = buf_temp-bar-code_.b-code no-error.
     5539            if available buf_prod-bc then do:
     5540              v-err-mess = substitute("Невозможно удалить(выключить) бар-код &1 - существуют привязанные к нему ДопБК", buf_temp-prod-bc_.b-code).
     5541               run set-err-type in p-cont-handle
     5542                 ( input 'SYNCHRONIZATION'
     5543                 ) no-error.
     5544               undo main-block, retry main-block .
     5545            end.
     5546             assign
     5547           buf_temp-bar-code_.stts = integer('79':U)
     5548           buf_bar-code.stts = integer('79':U).
     5549           release buf_bar-code no-error.
     5550           if error-status:error then do:
     5551             v-err-mess = substitute("Запись &1: Невозможно удалить бар-код &2:&3&4"
     5552                                     , p-line-num
     5553                                     , buf_temp-bar-code_.b-code
     5554                                     , chr(10)
     5555                                     , return-value
     5556                                     ).
     5557             run set-err-type in p-cont-handle
     5558               ( input 'SYNCHRONIZATION'
     5559               ) no-error.
     5560             undo main-block, retry main-block .
     5561           end.
     5562         end.
     5563       end.
     5564       run fill-g-list in  p-cont-handle  ( input buf_temp-goods_.gds-code, input '':U, input 0).
     5565       for each buf_temp-bar-code_ :
     5566         if buf_temp-bar-code_.status_ = 'D' then do:
     5567           run fill-bar-code in p-cont-handle (
     5568                                                   input  buf_temp-bar-code_.b-code
     5569                                                  ,input  buf_temp-bar-code_.gds-code
     5570                                                  ,input  (if buf_temp-bar-code_.status_ = 'D'
     5571                                                           then yes
     5572                                                           else no)
     5573                                                  ,input  p-node-code
     5574                                                  ,input  buf_temp-bar-code_.in-code
     5575                                                  ,input  buf_temp-bar-code_.part-code
     5576                                                  ,input  buf_temp-bar-code_.cli-base-rate
     5577                                                  ,input  buf_temp-bar-code_.unit-cli
     5578                                                   ) no-error.
     5579         end.
     5580       end.
     5581       for each buf_temp-prod-bc_,
     5582            first buf_temp-bar-code_ where
     5583                buf_temp-bar-code_.b-code = buf_temp-prod-bc_.b-code
     5584            :
     5585          if buf_temp-prod-bc_.status_ = 'D'
     5586          or buf_temp-prod-bc_.on-off then do:
     5587            run fill-pbc-list in p-cont-handle (
     5588                                                    input buf_temp-prod-bc_.rc
     5589                                                  , input buf_temp-goods_.gds-code
     5590                                                  , input buf_temp-prod-bc_.b-code
     5591                                                  , input buf_temp-prod-bc_.b-str
     5592                                                  , input buf_temp-prod-bc_.bc-on
     5593                                                  , input (if buf_temp-prod-bc_.status_ = 'D'
     5594                                                           or buf_temp-prod-bc_.bc-on = no
     5595                                                           or buf_temp-bar-code_.status_ = 'D'
     5596                                                           then yes
     5597                                                           else no)
     5598                                                  ).
     5599          end.
     5600       end.
     5601     end.
     5602   end.
     5603   end procedure.
     5604   procedure write-file :
     5605   define input parameter p-mess as character no-undo .
     5606   do
     5607   on error undo, return error
     5608   :
     5609         run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input p-mess).
     5610   end.
     5611   end procedure.
