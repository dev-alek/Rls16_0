     2427   .
     2428   define variable v-xmllib-rec-key            as integer      no-undo .
     2429   define variable v-xmllib-rec-fld-key        as integer      no-undo .
     2430   define variable v-xmllib-dirname            as character    no-undo .
     2431   define variable v-xmllib-filename           as character    no-undo .
     2432   define variable v-xmllib-log-filename       as character    no-undo .
     2433   define variable v-xmllib-log-handle         as handle       no-undo .
     2434   define variable v-xmllib-log-proc-name      as character    no-undo .
     2435   define variable v-xmllib-error-status       as logical      no-undo .
     2436   define variable v-xmllib-sax-reader-handle  as handle       no-undo .
     2437   define variable v-xmllib-prg-bar-handle     as handle       no-undo .
     2438   define variable v-xmllib-codepage-convert   as logical      no-undo .
     2439   define variable v-xmllib-codepage-source    as character    no-undo .
     2440   define variable v-xmllib-codepage-target    as character    no-undo .
     2441   procedure xmllib-clear-parse-data :
     2442   do
     2443   on error undo, return error
     2444   :
     2445       empty temp-table temp_xmllib_rec-list.
     2446       empty temp-table temp_xmllib_rec-fld-list.
     2447       empty temp-table temp_xmllib_rec.
     2448       empty temp-table temp_xmllib_rec-fld.
     2449   end.
     2450   end procedure.
     2451   procedure xmllib-add-rec-fld :
     2452   define input parameter p-rec-name       as character        no-undo.
     2453   define input parameter p-rec-fld-name   as character        no-undo.
     2454       define buffer buf_rec-list        for temp_xmllib_rec-list.
     2455       define buffer buf_rec-fld-list    for temp_xmllib_rec-fld-list.
     2456   do
     2457   for buf_rec-list
     2458     , buf_rec-fld-list
     2459   on error undo, return error
     2460   :
     2461       find first buf_rec-list
     2462            where buf_rec-list.recName = p-rec-name
     2463       no-error.
     2464       if not available buf_rec-list
     2465       then do:
     2466           create buf_rec-list.
     2467           assign
     2468               buf_rec-list.recName        = p-rec-name
     2469               buf_rec-list.recOpenLine    = 0
     2470               buf_rec-list.recCloseLine   = 0
     2471               buf_rec-list.closed         = yes
     2472           .
     2473       end.
     2474       find first buf_rec-fld-list
     2475            where buf_rec-fld-list.recName = p-rec-name
     2476              and buf_rec-fld-list.fldName = p-rec-fld-name
     2477       no-error.
     2478       if not available buf_rec-fld-list
     2479       then do:
     2480           create buf_rec-fld-list.
     2481           assign
     2482               buf_rec-fld-list.recName        = p-rec-name
     2483               buf_rec-fld-list.fldName        = p-rec-fld-name
     2484               buf_rec-fld-list.fldOpenLine    = 0
     2485               buf_rec-fld-list.fldCloseLine   = 0
     2486               buf_rec-fld-list.closed         = yes
     2487           .
     2488       end.
     2489   end.
     2490   end procedure.
     2491   procedure xmllib-tag-open:
     2492   define input parameter v-tag-level  as integer      no-undo.
     2493   define input parameter v-tag-name   as character    no-undo.
     2494   define input parameter v-tag-value  as character    no-undo.
     2495   do
     2496   on error undo, return error
     2497   :
     2498       assign
     2499           v-tag-name = trim( v-tag-name )
     2500       .
     2501       put stream stmXMLOut unformatted
     2502           substitute( "&1&2<&3&4&5>"
     2503               , chr(10)
     2504               , fill(" ", 4 * v-tag-level)
     2505               , v-tag-name
     2506               , ( if v-tag-value = "":U or v-tag-value = ? then "":U else " ":U )
     2507               , v-tag-value
     2508           )
     2509       .
     2510   end.
     2511   end procedure.
     2512   procedure xmllib-tag-put:
     2513   define input parameter v-tag-level      as integer      no-undo.
     2514   define input parameter v-tag-name       as character    no-undo.
     2515   define input parameter v-tag-value      as character    no-undo.
     2516   define input parameter v-empty-mode     as integer      no-undo.
     2517   do
     2518   on error undo, return error
     2519   :
     2520       assign
     2521           v-tag-name = trim( v-tag-name )
     2522       .
     2523       if  v-empty-mode = 1
     2524       or (v-empty-mode = 0 and (v-tag-value <> "":U and v-tag-value <> ?) )
     2525       or (v-empty-mode = 2 and (v-tag-value <> "":U and v-tag-value <> ? and v-tag-value <> "0":U))
     2526       or (v-empty-mode = 3 and (v-tag-value <> "":U and v-tag-value <> ? and caps(v-tag-value) <> "no":U))
     2527       then do:
     2528           run xmlchar-encode in this-procedure (
     2529                 input v-tag-value
     2530               , output v-tag-value
     2531           ).
     2532           put stream stmXMLOut unformatted
     2533               substitute( "&1&2<&3>&4</&3>"
     2534                   , chr(10)
     2535                   , fill(" ":U, 4 * v-tag-level)
     2536                   , v-tag-name
     2537                   , v-tag-value
     2538               )
     2539           .
     2540       end.
     2541   end.
     2542   end procedure.
     2543   procedure xmllib-tag-put-null :
     2544   define input parameter p-tag-level  as integer      no-undo.
     2545   define input parameter p-tag-name   as character    no-undo.
     2546   do
     2547   on error undo, return error
     2548   :
     2549       assign
     2550           p-tag-name = trim( p-tag-name )
     2551       .
     2552       put stream stmXMLOut unformatted
     2553           substitute( '&1&2<&3 nil="true" /&3>'
     2554               , chr(10)
     2555               , fill(" ":U, 4 * p-tag-level)
     2556               , p-tag-name
     2557           )
     2558       .
     2559   end.
     2560   end procedure.
     2561   procedure xmllib-tag-close:
     2562   define input parameter v-tag-level as integer      no-undo.
     2563   define input parameter v-tag-name  as character    no-undo.
     2564   do
     2565   on error undo, return error
     2566   :
     2567       assign
     2568           v-tag-name = trim( v-tag-name )
     2569       .
     2570       put stream stmXMLOut unformatted
     2571           substitute( "&1&2</&3>"
     2572               , chr(10)
     2573               , fill( " ":U, 4 * v-tag-level)
     2574               , v-tag-name
     2575           )
     2576       .
     2577   end.
     2578   end procedure.
     2579   procedure xmllib-write-log:
     2580   define input parameter v-filename   as character    no-undo.
     2581   define input parameter v-log-level  as integer      no-undo.
     2582   define input parameter v-out-string as character    no-undo.
     2583   do
     2584   on error undo, return error
     2585   :
     2586       output stream stmXMLLog to value( v-filename ) append.
     2587       put stream stmXMLLog unformatted
     2588           chr(10)
     2589       .
     2590       put stream stmXMLLog unformatted
     2591           ( if v-log-level = 0
     2592             or v-out-string = "&DLine":U
     2593             or v-out-string = "&Line":U
     2594             then "":U
     2595             else cur-time-string-sec() + " ":U )
     2596       .
     2597       put stream stmXMLLog unformatted
     2598           ( if v-out-string = "&Line":U
     2599             then fill( "-":U, 80 )
     2600             else if v-out-string = "&DLine":U
     2601                  then fill( "=":U, 80 )
     2602                  else v-out-string )
     2603       .
     2604       output stream stmXMLLog close.
     2605   end.
     2606   end procedure.
     2607   procedure xmllib-write-edt:
     2608   define input parameter v-editor-handle    as handle       no-undo.
     2609   define input parameter v-log-level        as integer      no-undo.
     2610   define input parameter v-out-string       as character    no-undo.
     2611   do
     2612   on error undo, return error
     2613   :
     2614       if valid-handle ( v-editor-handle )
     2615       then do:
     2616           v-editor-handle :move-to-eof().
     2617           v-editor-handle :insert-string( ( if v-log-level = 0
     2618                                             or v-out-string = "&DLine":U
     2619                                             or v-out-string = "&Line":U
     2620                                             then "":U
     2621                                             else cur-time-string-sec() + " ":U
     2622                                         ) ).
     2623           v-editor-handle :insert-string( ( if v-out-string = "&Line":U
     2624                                             then fill( "-":U, 80 )
     2625                                             else if v-out-string = "&DLine":U then fill("=":U, 80)
     2626                                             else fill( " ":U, v-log-level) + v-out-string
     2627                                         ) ).
     2628           v-editor-handle :insert-string( chr(10) ).
     2629       end.
     2630   end.
     2631   end procedure.
     2632   procedure xmllib-show-cnt:
     2633   define input parameter v-fillin-handle     as handle   no-undo.
     2634   do
     2635   on error undo, return error
     2636   :
     2637       if valid-handle( v-fillin-handle )
     2638       then do:
     2639           assign
     2640               v-fillin-handle :visible = true
     2641           .
     2642       end.
     2643   end.
     2644   end procedure.
     2645   procedure xmllib-hide-cnt:
     2646   define input parameter v-fillin-handle     as handle   no-undo.
     2647   do
     2648   on error undo, return error
     2649   :
     2650       if valid-handle( v-fillin-handle )
     2651       then do:
     2652           assign v-fillin-handle :visible = false.
     2653       end.
     2654   end.
     2655   end procedure.
     2656   procedure xmllib-write-cnt:
     2657   define input parameter v-fillin-handle    as handle       no-undo.
     2658   define input parameter v-fillin-string    as character    no-undo.
     2659   do
     2660   on error undo, return error
     2661   :
     2662       if valid-handle( v-fillin-handle )
     2663       then do:
     2664           assign
     2665               v-fillin-handle :SCREEN-value = v-fillin-string
     2666           .
     2667       end.
     2668   end.
     2669   end procedure.
     2670   procedure xmllib-write-header:
     2671   define input parameter p-first-file     as logical      no-undo.
     2672   define input parameter p-xml-file-name  as character    no-undo.
     2673   define input parameter p-list-file-name as character    no-undo.
     2674   define input parameter p-file-number    as integer      no-undo.
     2675   define input parameter p-have-prev      as logical      no-undo.
     2676   define input parameter p-prev-filename  as character    no-undo.
     2677   define input parameter p-parameter-list as character    no-undo.
     2678       define variable v-counter    as integer        no-undo.
     2679   do
     2680   on error undo, return error
     2681   :
     2682       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     2683       put stream stmXMLOut unformatted
     2684           "<?xml version='1.0' encoding='windows-1251'?>"
     2685       .
     2686       run xmllib-tag-open( input 0, input "root"          , input "":U ).
     2687       run xmllib-tag-open( input 0, input "THheader"        , input "":U ).
     2688       run xmllib-tag-put( input 1 , input "THfileName"      , input p-xml-file-name + "xml":U  , input 0 ).
     2689       run xmllib-tag-put( input 1 , input "THfileNumber"    , input string( p-file-number     ), input 0 ).
     2690       run xmllib-tag-put( input 1 , input "THhavePrev"      , input string( p-have-prev       ), input 3 ).
     2691       run xmllib-tag-put( input 1 , input "THprevFileName"  , input p-prev-filename            , input 0 ).
     2692       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     2693       :
     2694           run xmllib-tag-put(
     2695                 input 1
     2696               , input entry( 2 * v-counter, p-parameter-list )
     2697               , input entry( 2 * v-counter + 1, p-parameter-list )
     2698               , input 0
     2699           ).
     2700       end.
     2701       run xmllib-tag-close( input 0, input "THheader" ).
     2702       output stream stmXMLOut close.
     2703       if p-list-file-name <> "":U
     2704       then do:
     2705           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     2706           if p-first-file = yes
     2707           then do:
     2708               put stream stmXMLOut unformatted
     2709                   "<?xml version='1.0' encoding='windows-1251'?>"
     2710               .
     2711               run xmllib-tag-open( input 0, input "OpenXML", input "" ).
     2712           end.
     2713           run xmllib-tag-open( input 1, input "THfile", input "" ).
     2714           run xmllib-tag-put( input 2, input "THfileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     2715           run xmllib-tag-put( input 2, input "THfileNumber"     , input string( p-file-number     ), input 0 ).
     2716           run xmllib-tag-put( input 2, input "THhavePrev"       , input string( p-have-prev       ), input 3 ).
     2717           run xmllib-tag-put( input 2, input "THprevFileName"   , input p-prev-filename            , input 0 ).
     2718           do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     2719           :
     2720               run xmllib-tag-put(
     2721                   input 2
     2722                   , input entry( 2 * v-counter, p-parameter-list )
     2723                   , input entry( 2 * v-counter + 1, p-parameter-list )
     2724                   , input 0
     2725               ).
     2726           end.
     2727           run xmllib-tag-close( input 1, input "THfile" ).
     2728           output stream stmXMLOut close.
     2729       end.
     2730   end.
     2731   end procedure.
     2732   procedure xmllib-write-footer:
     2733   define input parameter p-last-file      as logical      no-undo.
     2734   define input parameter p-xml-file-name  as character    no-undo.
     2735   define input parameter p-list-file-name as character    no-undo.
     2736   define input parameter p-have-next      as logical      no-undo.
     2737   define input parameter p-next-file-name as character    no-undo.
     2738       define variable v-error-num     as integer           no-undo.
     2739   do
     2740   on error undo, return error
     2741   :
     2742       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     2743       if p-have-next = yes
     2744       then do:
     2745           run xmllib-tag-open( input 0, input "footer", "" ).
     2746           run xmllib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     2747           run xmllib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     2748           run xmllib-tag-close( input 0, input "footer" ).
     2749       end.
     2750       run xmllib-tag-close( input 0, input "root" ).
     2751       output stream stmXMLOut close.
     2752       run bge/os_copy.p (
     2753             input "M"
     2754           , input p-xml-file-name + "tmp"
     2755           , input p-xml-file-name + "xml"
     2756           , output v-error-num
     2757       ).
     2758       if p-last-file = yes
     2759       and p-list-file-name <> "":U
     2760       then do:
     2761           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     2762               run xmllib-tag-close( input 0, input "OpenXML" ).
     2763           output stream stmXMLOut close.
     2764           run bge/os_copy.p (
     2765                 input "M"
     2766               , input p-list-file-name + "tmp"
     2767               , input p-list-file-name + "xml":U
     2768               , output v-error-num
     2769           ).
     2770       end.
     2771   end.
     2772   end procedure.
     2773   procedure xmllib-filename :
     2774   define input parameter p-subdir             as character        no-undo.
     2775   define input parameter p-prefix             as character    no-undo.
     2776   define output parameter p-xml-file-name     as character    no-undo.
     2777   define output parameter p-log-file-name     as character    no-undo.
     2778   define output parameter p-list-file-name    as character    no-undo.
     2779       define variable v-home-dir  as character    no-undo.
     2780       define variable v-error-num as integer      no-undo.
     2781   do
     2782   on error undo, return error
     2783   :
     2784       get-key-value section "OXML" key "oxml-dir" value v-home-dir.
     2785       if v-home-dir = ?
     2786       then do:
     2787           message
     2788             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     2789             skip "Нет параметра oxml-dir в секции [OXML]."
     2790             skip(1)
     2791             skip "Обратитесь к администратору."
     2792           view-as alert-box error.
     2793           undo, return error .
     2794       end.
     2795       if p-subdir <> "":U
     2796       then do:
     2797           assign
     2798               v-home-dir = substitute( "&1/out/&2", v-home-dir, p-subdir )
     2799           .
     2800       end.
     2801       run gbl/dir-cre.p (
     2802           input v-home-dir
     2803       ) no-error.
     2804       if error-status :error
     2805       then do:
     2806           message
     2807             skip "Неверно задан каталог экспорта в ini-файле."
     2808             skip "Не удаётся создать каталог, указанный параметром"
     2809             skip "oxml-dir в секции [OXML]."
     2810             skip(1)
     2811             skip "Обратитесь к администратору."
     2812           view-as alert-box error.
     2813           undo, return error .
     2814       end.
     2815       run bge/genfname.p (
     2816             input v-home-dir
     2817           , input p-prefix
     2818           , input ""
     2819           , input "xml"
     2820           , input "tmp"
     2821           , output p-xml-file-name
     2822       ).
     2823       assign
     2824           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     2825           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     2826           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     2827       .
     2828   end.
     2829   end procedure.
     2830   procedure xmllib-check-file-size :
     2831   define input parameter p-out-filename   as character    no-undo.
     2832   define output parameter p-is-big        as logical      no-undo.
     2833       define variable v-current-position    as integer        no-undo.
     2834   do
     2835   on error undo, return error
     2836   :
     2837       assign
     2838           v-current-position = seek( stmXMLOut )
     2839       .
     2840       if v-current-position / 1024 / 1024  >= 100
     2841       then do:
     2842           assign
     2843               p-is-big = yes
     2844           .
     2845       end.
     2846   end.
     2847   end procedure.
     2848   procedure xmllib-parse-file :
     2849   define input parameter p-full-filename      as character        no-undo.
     2850       define variable v-num-dirs              as integer      no-undo .
     2851       define variable v-str                   as character    no-undo .
     2852       define variable v-str-count             as int64        no-undo .
     2853   do
     2854   on error undo, return error
     2855   :
     2856       assign
     2857           v-num-dirs              = num-entries( p-full-filename,"\/":U )
     2858           v-xmllib-error-status   = no
     2859       .
     2860       if v-num-dirs > 1
     2861       then do:
     2862           assign
     2863               v-xmllib-filename = entry( v-num-dirs, p-full-filename, "\/":U )
     2864               v-xmllib-dirname  = substring( p-full-filename, 1, length( p-full-filename ) - length( v-xmllib-filename ) - 1 )
     2865           .
     2866       end.
     2867       else do:
     2868           assign
     2869               v-xmllib-filename = p-full-filename
     2870               v-xmllib-dirname  = "":U
     2871           .
     2872       end.
     2873       if valid-handle(v-xmllib-prg-bar-handle)
     2874       then do:
     2875   if session :set-wait-state( "compiler" ) then.
     2876         input stream strXMLIn from value(p-full-filename) .
     2877         repeat
     2878         :
     2879           import stream strXMLIn unformatted v-str no-error .
     2880           assign
     2881             v-str-count = v-str-count + 1
     2882           .
     2883         end.
     2884         input stream strXMLIn close .
     2885   if session :set-wait-state( "" ) then.
     2886         run prg-bar_init-cb-handle in this-procedure ( input v-xmllib-prg-bar-handle ) .
     2887         run prg-bar_new in this-procedure ( input 1 , input v-str-count) .
     2888         run prg-bar_show in this-procedure .
     2889       end.
     2890       create sax-reader v-xmllib-sax-reader-handle.
     2891       v-xmllib-sax-reader-handle :set-input-source( "FILE":U, p-full-filename ).
     2892       v-xmllib-sax-reader-handle :sax-parse( ) no-error.
     2893       if error-status :error
     2894       then do:
     2895           run xmllib-parse-error in this-procedure ( input substitute("&1 &2 &3&4Ошибка обработки XML файла.&4&5&4&5&4&7&4&8"
     2896                                                                       ,vss-workfile
     2897                                                                       ,vss-revision
     2898                                                                       ,vss-description
     2899                                                                       ,chr(10)
     2900                                                                       ,return-value
     2901                                                                       ,trim(error-status :get-message(1))
     2902                                                                       ,trim(error-status :get-message(2))
     2903                                                                       ,trim(error-status :get-message(3)))
     2904                                                     ).
     2905           undo, return error .
     2906       end.
     2907       if v-xmllib-error-status <> no
     2908       then do:
     2909           run xmllib-parse-error in this-procedure (
     2910               input "*** При обработке XML файла были ошибки."
     2911           ).
     2912           delete object v-xmllib-sax-reader-handle.
     2913       end.
     2914       delete object v-xmllib-sax-reader-handle.
     2915       if valid-handle(v-xmllib-prg-bar-handle)
     2916       then do:
     2917         run prg-bar_delete in this-procedure .
     2918       end.
     2919   end.
     2920   end procedure.
     2921   procedure xmllib-parse-progressive :
     2922   define input parameter p-full-filename      as character no-undo .
     2923   define input parameter p-pack-data          as memptr no-undo .
     2924   define input parameter p-parse-first        as logical no-undo .
     2925   define input parameter p-first-err          as logical no-undo .
     2926   define output parameter p-parse-status as integer no-undo .
     2927   define variable v-num-dirs              as integer no-undo .
     2928   define variable glog                    as logical no-undo .
     2929   define variable v-pack-size             as int64 no-undo .
     2930   do
     2931   on error undo, return error
     2932   :
     2933     if p-parse-first then do:
     2934       if valid-handle(v-xmllib-sax-reader-handle)
     2935       then do:
     2936       end.
     2937       assign
     2938           v-num-dirs              = num-entries( p-full-filename,"\/":U )
     2939           v-xmllib-error-status   = no
     2940       .
     2941       if v-num-dirs > 1
     2942       then do:
     2943           assign
     2944               v-xmllib-filename = entry( v-num-dirs, p-full-filename, "\/":U )
     2945               v-xmllib-dirname  = substring( p-full-filename, 1, length( p-full-filename ) - length( v-xmllib-filename ) - 1 )
     2946           .
     2947       end.
     2948       else do:
     2949           assign
     2950               v-xmllib-filename = p-full-filename
     2951               v-xmllib-dirname  = "":U
     2952           .
     2953       end.
     2954       create sax-reader v-xmllib-sax-reader-handle.
     2955       v-pack-size = get-size (p-pack-data) .
     2956       if v-pack-size > 0 then
     2957         glog = v-xmllib-sax-reader-handle :set-input-source( "MEMPTR":U, p-pack-data ) no-error.
     2958       else
     2959         glog = v-xmllib-sax-reader-handle :set-input-source( "FILE":U, p-full-filename ) no-error.
     2960       if error-status :error
     2961       or not glog
     2962       then do:
     2963         delete object v-xmllib-sax-reader-handle.
     2964         run xmllib-parse-error in this-procedure ( input substitute("&1 &2 &3&4Ошибка обработки XML файла.&4&5&4&5&4&7&4&8"
     2965                                                                     ,vss-workfile
     2966                                                                     ,vss-revision
     2967                                                                     ,vss-description
     2968                                                                     ,chr(10)
     2969                                                                     ,return-value
     2970                                                                     ,trim(error-status :get-message(1))
     2971                                                                     ,trim(error-status :get-message(2))
     2972                                                                     ,trim(error-status :get-message(3)) )
     2973                                                   ).
     2974         undo, return error .
     2975       end.
     2976       v-xmllib-sax-reader-handle :sax-parse-first( ) no-error.
     2977     end.
     2978     else do:
     2979       v-xmllib-sax-reader-handle :sax-parse-next( ) no-error.
     2980     end.
     2981     if error-status :error
     2982     then do:
     2983       delete object v-xmllib-sax-reader-handle.
     2984       run xmllib-parse-error in this-procedure ( input substitute("&1 &2 &3&4Ошибка обработки XML файла.&4&5&4&5&4&7&4&8"
     2985                                                                   ,vss-workfile
     2986                                                                   ,vss-revision
     2987                                                                   ,vss-description
     2988                                                                   ,chr(10)
     2989                                                                   ,return-value
     2990                                                                   ,trim(error-status :get-message(1))
     2991                                                                   ,trim(error-status :get-message(2))
     2992                                                                   ,trim(error-status :get-message(3)) )
     2993                                                 ).
     2994       undo, return error .
     2995     end.
     2996     if v-xmllib-error-status <> no
     2997     then do:
     2998       run xmllib-parse-error in this-procedure (
     2999           input "*** При обработке XML файла были ошибки."
     3000       ).
     3001       if p-first-err then do:
     3002         delete object v-xmllib-sax-reader-handle.
     3003       end.
     3004       else do:
     3005         v-xmllib-error-status = no.
     3006       end.
     3007     end.
     3008     if v-xmllib-sax-reader-handle:parse-status = SAX-COMPLETE  then do:
     3009       p-parse-status = SAX-COMPLETE.
     3010       delete object v-xmllib-sax-reader-handle.
     3011       return '':U.
     3012     end.
     3013     else do:
     3014       p-parse-status = v-xmllib-sax-reader-handle:parse-status.
     3015       return '':U.
     3016     end.
     3017   end.
     3018   end procedure.
     3019   procedure StartElement :
     3020   define input parameter p-name-space     as character        no-undo.
     3021   define input parameter p-local-name     as character        no-undo.
     3022   define input parameter p-q-name         as character        no-undo.
     3023   define input parameter p-attributes     as handle           no-undo.
     3024       define buffer buf_rec             for temp_xmllib_rec.
     3025       define buffer buf_rec-fld         for temp_xmllib_rec-fld.
     3026       define buffer buf_rec-list        for temp_xmllib_rec-list.
     3027       define buffer buf_rec-fld-list    for temp_xmllib_rec-fld-list.
     3028   do
     3029   for buf_rec
     3030     , buf_rec-fld
     3031     , buf_rec-list
     3032     , buf_rec-fld-list
     3033   on error undo, return error
     3034   :
     3035       if valid-handle(v-xmllib-prg-bar-handle)
     3036       then do:
     3037         run prg-bar_stepto in this-procedure ( input SELF:LOCATOR-LINE-NUMBER ) .
     3038       end.
     3039       find first buf_rec-list
     3040            where buf_rec-list.recName = p-q-name
     3041       no-error.
     3042       if available buf_rec-list
     3043       then do:
     3044           if buf_rec-list.closed = no
     3045           then do:
     3046               find first buf_rec-fld-list
     3047                    where buf_rec-fld-list.recName = buf_rec-list.recName
     3048                      and buf_rec-fld-list.fldName = p-q-name
     3049               no-error.
     3050               if available buf_rec-fld-list
     3051               and buf_rec-list.recName = buf_rec-fld-list.recName
     3052               then do:
     3053                   if buf_rec-fld-list.closed = no
     3054                   then do:
     3055                       run xmllib-parse-error in this-procedure (
     3056                           input substitute( "Ошибка 1 открытия поля <&1> записи <&2>: Поле с этим именем уже открыто на строке &3."
     3057                                           , p-q-name
     3058                                           , p-q-name
     3059                                           , buf_rec-fld-list.fldOpenLine
     3060                                           )
     3061                       ).
     3062                   end.
     3063                   else do:
     3064                       run xmllib-parse-rec-fld-open in this-procedure (
     3065                             input buf_rec-list.recName
     3066                           , input buf_rec-list.recLevel
     3067                           , input buf_rec-fld-list.fldName
     3068                       ).
     3069                       assign
     3070                           buf_rec-fld-list.closed         = no
     3071                           buf_rec-fld-list.fldOpenLine    = v-xmllib-sax-reader-handle :locator-line-number
     3072                           buf_rec-fld-list.fldCloseLine   = 0
     3073                       .
     3074                   end.
     3075               end.
     3076               else do:
     3077                   assign
     3078                       buf_rec-list.recLevel = buf_rec-list.recLevel + 1
     3079                   .
     3080                   run xmllib-parse-rec-open in this-procedure (
     3081                         input buf_rec-list.recName
     3082                       , input buf_rec-list.recLevel
     3083                   ).
     3084                   assign
     3085                       buf_rec-list.closed         = no
     3086                       buf_rec-list.recOpenLine    = v-xmllib-sax-reader-handle :locator-line-number
     3087                       buf_rec-list.recCloseLine   = 0
     3088                   .
     3089               end.
     3090           end.
     3091           else do:
     3092               run xmllib-parse-rec-open in this-procedure (
     3093                     input buf_rec-list.recName
     3094                   , input buf_rec-list.recLevel
     3095               ).
     3096               assign
     3097                   buf_rec-list.closed         = no
     3098                   buf_rec-list.recOpenLine    = v-xmllib-sax-reader-handle :locator-line-number
     3099                   buf_rec-list.recCloseLine   = 0
     3100               .
     3101           end.
     3102       end.
     3103       else do:
     3104           open-record:
     3105           for each buf_rec-fld-list
     3106              where buf_rec-fld-list.fldName = p-q-name
     3107           :
     3108               find first buf_rec-list
     3109                    where buf_rec-list.recName = buf_rec-fld-list.recName
     3110                      and buf_rec-list.closed  = no
     3111               no-error.
     3112               if available buf_rec-list
     3113               then do:
     3114                   run xmllib-parse-rec-fld-open in this-procedure (
     3115                         input buf_rec-list.recName
     3116                       , input buf_rec-list.recLevel
     3117                       , input buf_rec-fld-list.fldName
     3118                   ).
     3119                   assign
     3120                       buf_rec-fld-list.recLevel       = buf_rec-list.recLevel
     3121                       buf_rec-fld-list.closed         = no
     3122                       buf_rec-fld-list.fldOpenLine    = v-xmllib-sax-reader-handle :locator-line-number
     3123                       buf_rec-fld-list.fldCloseLine   = 0
     3124                   .
     3125                   leave open-record.
     3126               end.
     3127           end.
     3128       end.
     3129   end.
     3130   end procedure.
     3131   procedure Characters :
     3132   define input parameter p-char-data  as memptr.
     3133   define input parameter p-numchars   as integer.
     3134       define variable v-data-string    as character    no-undo.
     3135       define variable v-cp-utf8           as integer no-undo init 65001 .
     3136       define variable v-cp-windows1251    as integer no-undo init 1251 .
     3137       define buffer buf_xmllib_rec             for temp_xmllib_rec.
     3138       define buffer buf_xmllib_rec-fld         for temp_xmllib_rec-fld.
     3139       define buffer buf_xmllib_rec-list        for temp_xmllib_rec-list.
     3140       define buffer buf_xmllib_rec-fld-list    for temp_xmllib_rec-fld-list.
     3141   do
     3142   for buf_xmllib_rec
     3143     , buf_xmllib_rec-fld
     3144     , buf_xmllib_rec-list
     3145     , buf_xmllib_rec-fld-list
     3146   on error undo, return error
     3147   :
     3148       find first buf_xmllib_rec-list
     3149            where buf_xmllib_rec-list.closed = no
     3150       no-error.
     3151       if available buf_xmllib_rec-list
     3152       then do:
     3153           find first buf_xmllib_rec-fld-list
     3154                where buf_xmllib_rec-fld-list.closed = no
     3155           no-error.
     3156           if available buf_xmllib_rec-fld-list
     3157           and buf_xmllib_rec-fld-list.recName  = buf_xmllib_rec-list.recName
     3158           and buf_xmllib_rec-fld-list.recLevel = buf_xmllib_rec-list.recLevel
     3159           then do:
     3160               find last buf_xmllib_rec
     3161                   where buf_xmllib_rec.recName  = buf_xmllib_rec-list.recName
     3162                     and buf_xmllib_rec.recLevel = buf_xmllib_rec-list.recLevel
     3163                     and buf_xmllib_rec.closed   = no
     3164               use-index nm
     3165               no-error.
     3166               if available buf_xmllib_rec
     3167               then do:
     3168                   find last buf_xmllib_rec-fld
     3169                       where buf_xmllib_rec-fld.rec-key = buf_xmllib_rec.rec-key
     3170                         and buf_xmllib_rec-fld.fldName = buf_xmllib_rec-fld-list.fldName
     3171                         and buf_xmllib_rec-fld.closed = no
     3172                   use-index nm
     3173                   no-error.
     3174                   if available buf_xmllib_rec-fld
     3175                   then do:
     3176                       assign
     3177                           v-data-string = get-string( p-char-data, 1, get-size( p-char-data ) )
     3178                       .
     3179                       if v-xmllib-codepage-convert = yes
     3180                       then do:
     3181                         assign
     3182                             v-data-string = codepage-convert( v-data-string , v-xmllib-codepage-target , v-xmllib-codepage-source )
     3183                         .
     3184                       end.
     3185                       run xmlchar-decode in this-procedure (
     3186                           input v-data-string
     3187                           , output v-data-string
     3188                       ).
     3189                       assign
     3190                           buf_xmllib_rec-fld.fldValue = trim( substitute( "&1&2", buf_xmllib_rec-fld.fldValue, v-data-string ) )
     3191                       .
     3192                   end.
     3193               end.
     3194           end.
     3195       end.
     3196   end.
     3197   end procedure.
     3198   procedure EndElement :
     3199   define input parameter p-name-space     as character        no-undo.
     3200   define input parameter p-local-name     as character        no-undo.
     3201   define input parameter p-q-name         as character        no-undo.
     3202       define buffer buf_rec             for temp_xmllib_rec.
     3203       define buffer buf_rec-fld         for temp_xmllib_rec-fld.
     3204       define buffer buf_rec-list        for temp_xmllib_rec-list.
     3205       define buffer buf_rec-fld-list    for temp_xmllib_rec-fld-list.
     3206   do
     3207   for buf_rec
     3208     , buf_rec-fld
     3209     , buf_rec-list
     3210     , buf_rec-fld-list
     3211   on error undo, return error
     3212   :
     3213       find last buf_rec-list
     3214           where buf_rec-list.recName = p-q-name
     3215       use-index pi
     3216       no-error.
     3217       if available buf_rec-list
     3218       then do:
     3219           if buf_rec-list.closed = yes
     3220           then do:
     3221               run xmllib-parse-error in this-procedure (
     3222                   input substitute( "Ошибка закрытия записи или поля <&1>: Нет метки открытой записи."
     3223                                   , p-q-name
     3224                                   )
     3225               ).
     3226           end.
     3227           else do:
     3228               find last buf_rec
     3229                   where buf_rec.recName  = buf_rec-list.recName
     3230                     and buf_rec.recLevel = buf_rec-list.recLevel
     3231                     and buf_rec.closed   = no
     3232               use-index nm
     3233               no-error.
     3234               if not available buf_rec
     3235               then do:
     3236                   run xmllib-parse-error in this-procedure (
     3237                       input substitute( "Ошибка закрытия записи или поля <&1> уровня &2: Нет открытой записи."
     3238                                       , p-q-name
     3239                                       , buf_rec-list.recLevel
     3240                                       )
     3241                   ).
     3242               end.
     3243               else do:
     3244                   find first buf_rec-fld-list
     3245                        where buf_rec-fld-list.recName  = buf_rec.recName
     3246                          and buf_rec-fld-list.recLevel = buf_rec.recLevel
     3247                          and buf_rec-fld-list.fldName  = p-q-name
     3248                          and buf_rec-fld-list.closed   = no
     3249                   no-error.
     3250                   if not available buf_rec-fld-list
     3251                   then do:
     3252                       if buf_rec.recName <> p-q-name
     3253                       then do:
     3254                           run xmllib-parse-error in this-procedure (
     3255                               input substitute( "Ошибка закрытия записи <&1>: Имя открытой записи не совпадает с именем метки."
     3256                                               , buf_rec.recName
     3257                                               )
     3258                           ).
     3259                       end.
     3260                       else do:
     3261                           assign
     3262                               buf_rec.closed              = yes
     3263                               buf_rec.recCloseLine        = v-xmllib-sax-reader-handle :locator-line-number
     3264                               buf_rec-list.recCloseLine   = v-xmllib-sax-reader-handle :locator-line-number
     3265                           .
     3266                           if buf_rec-list.recLevel > 0
     3267                           then do:
     3268                               assign
     3269                                   buf_rec-list.recLevel = buf_rec-list.recLevel - 1
     3270                               .
     3271                               for each buf_rec-fld-list
     3272                                  where buf_rec-fld-list.recName = buf_rec-list.recName
     3273                               :
     3274                                   assign
     3275                                       buf_rec-fld-list.recLevel = buf_rec-fld-list.recLevel - 1
     3276                                   .
     3277                               end.
     3278                           end.
     3279                           else do:
     3280                               assign
     3281                                   buf_rec-list.closed         = yes
     3282                               .
     3283                           end.
     3284                       end.
     3285                   end.
     3286                   else do:
     3287                       find last buf_rec-fld
     3288                           where buf_rec-fld.rec-key = buf_rec.rec-key
     3289                             and buf_rec-fld.fldName = buf_rec-fld-list.fldName
     3290                             and buf_rec-fld.closed  = no
     3291                       use-index nm
     3292                       no-error.
     3293                       if not available buf_rec-fld
     3294                       then do:
     3295                           run xmllib-parse-error in this-procedure (
     3296                               input substitute( "Ошибка 2 закрытия поля <&1>: Не найдено открытое поле с этим именем в записи <&2> уровня &3."
     3297                                               , buf_rec-fld-list.fldName
     3298                                               , buf_rec.recName
     3299                                               , buf_rec.recLevel
     3300                                               )
     3301                           ).
     3302                       end.
     3303                       else do:
     3304                           assign
     3305                               buf_rec-fld.closed              = yes
     3306                               buf_rec-fld-list.closed         = yes
     3307                               buf_rec-fld.fldCloseLine        = v-xmllib-sax-reader-handle :locator-line-number
     3308                               buf_rec-fld-list.fldCloseLine   = v-xmllib-sax-reader-handle :locator-line-number
     3309                           .
     3310                       end.
     3311                   end.
     3312               end.
     3313           end.
     3314       end.
     3315       else do:
     3316           close-field-rec:
     3317           for each buf_rec-fld-list
     3318              where buf_rec-fld-list.fldName = p-q-name
     3319           :
     3320               find first buf_rec-list
     3321                    where buf_rec-list.recName  = buf_rec-fld-list.recName
     3322                      and buf_rec-list.recLevel = buf_rec-fld-list.recLevel
     3323                      and buf_rec-list.closed   = no
     3324               no-error.
     3325               if available buf_rec-list
     3326               then do:
     3327                   find last buf_rec
     3328                       where buf_rec.recName  = buf_rec-list.recName
     3329                         and buf_rec.recLevel = buf_rec-list.recLevel
     3330                         and buf_rec.closed   = no
     3331                   use-index nm
     3332                   no-error.
     3333                   if not available buf_rec
     3334                   then do:
     3335                       run xmllib-parse-error in this-procedure (
     3336                           input substitute( "Ошибка закрытия поля <&1>: Нет открытой записи."
     3337                                           , p-q-name
     3338                                           )
     3339                       ).
     3340                   end.
     3341                   else do:
     3342                       find last buf_rec-fld
     3343                           where buf_rec-fld.rec-key = buf_rec.rec-key
     3344                             and buf_rec-fld.fldName = buf_rec-fld-list.fldName
     3345                             and buf_rec-fld.closed  = no
     3346                       use-index nm
     3347                       no-error.
     3348                       if not available buf_rec-fld
     3349                       then do:
     3350                           run xmllib-parse-error in this-procedure (
     3351                               input substitute( "Ошибка 1 закрытия поля <&1>: Не найдено открытое поле с этим именем в записи <&2> уровня &3."
     3352                                               , buf_rec-fld-list.fldName
     3353                                               , buf_rec.recName
     3354                                               , buf_rec.recLevel
     3355                                               )
     3356                           ).
     3357                       end.
     3358                       else do:
     3359                           assign
     3360                               buf_rec-fld.closed              = yes
     3361                               buf_rec-fld-list.closed         = yes
     3362                               buf_rec-fld.fldCloseLine        = v-xmllib-sax-reader-handle :locator-line-number
     3363                               buf_rec-fld-list.fldCloseLine   = v-xmllib-sax-reader-handle :locator-line-number
     3364                           .
     3365                       end.
     3366                   end.
     3367                   leave close-field-rec.
     3368               end.
     3369           end.
     3370       end.
     3371   end.
     3372   end procedure.
     3373   procedure Error :
     3374   define input parameter p-error-message     as character        no-undo.
     3375   do
     3376   on error undo, return error
     3377   :
     3378       run xmllib-parse-error in this-procedure (
     3379           input p-error-message
     3380       ).
     3381       assign
     3382           v-xmllib-error-status = yes
     3383       .
     3384   end.
     3385   end procedure.
     3386   procedure xmllib-parse-error :
     3387   define input parameter p-err-message    as character        no-undo.
     3388   do
     3389   on error undo, return error
     3390   :
     3391       if valid-handle(v-xmllib-log-handle) then do:
     3392         run value(v-xmllib-log-proc-name) in  v-xmllib-log-handle
     3393                  (input substitute("&1Файл:    &2 &3&1Строка &4&1&5"
     3394                                    ,chr(10)
     3395                                    ,v-xmllib-dirname
     3396                                    ,v-xmllib-filename
     3397                                    ,(if valid-handle(v-xmllib-sax-reader-handle)
     3398                                      then v-xmllib-sax-reader-handle :locator-line-number
     3399                                      else ?)
     3400                                    ,p-err-message)).
     3401       end.
     3402       else do:
     3403         if v-xmllib-log-filename = "":U
     3404         then do:
     3405             message
     3406                     vss-workfile vss-revision vss-description
     3407                 skip "Файл:   " v-xmllib-dirname v-xmllib-filename
     3408                 skip "Строка: " (if valid-handle(v-xmllib-sax-reader-handle)
     3409                                  then v-xmllib-sax-reader-handle :locator-line-number
     3410                                  else ?)
     3411                 skip(1)
     3412                 skip p-err-message
     3413                 skip return-value
     3414                 skip trim( error-status :get-message( 1 ) )
     3415                     trim( error-status :get-message( 2 ) )
     3416                     trim( error-status :get-message( 3 ) )
     3417             view-as alert-box error.
     3418             undo, return error.
     3419         end.
     3420         else do:
     3421           output to value( v-xmllib-log-filename ).
     3422           put unformatted
     3423               substitute( "&1&2", chr(10), p-err-message )
     3424           .
     3425           output close.
     3426         end.
     3427       end.
     3428   end.
     3429   end procedure.
     3430   procedure xmllib-set-log-filename :
     3431   define input parameter p-log-filename   as character        no-undo.
     3432   do
     3433   on error undo, return error
     3434   :
     3435       run gbl/fileapnd.p (
     3436             input p-log-filename
     3437           , input "":U
     3438           , input 10
     3439       ) no-error.
     3440       if error-status :error
     3441       then do:
     3442           assign
     3443               v-xmllib-log-filename = "":U
     3444           .
     3445       end.
     3446       else do:
     3447           assign
     3448               v-xmllib-log-filename = p-log-filename
     3449           .
     3450       end.
     3451   end.
     3452   end procedure.
     3453   procedure xmllib-set-log-handle :
     3454   define input parameter p-log-handle    as handle        no-undo.
     3455   define input parameter p-log-proc-name as character no-undo .
     3456   do
     3457   on error undo, return error
     3458   :
     3459       if valid-handle(p-log-handle)
     3460       and lookup(p-log-proc-name, p-log-handle:internal-entries) > 0
     3461       then do:
     3462         assign
     3463         v-xmllib-log-handle    = p-log-handle
     3464         v-xmllib-log-proc-name = p-log-proc-name
     3465         .
     3466       end.
     3467       else do:
     3468         assign
     3469         v-xmllib-log-handle    = ?
     3470         v-xmllib-log-proc-name = '':U
     3471         .
     3472       end.
     3473   end.
     3474   end procedure.
     3475   procedure xmllib-set-prg-bar-handle :
     3476   define input parameter p-handle    as handle        no-undo.
     3477   do
     3478   on error undo, return error
     3479   :
     3480       if valid-handle(p-handle)
     3481       then do:
     3482         assign
     3483           v-xmllib-prg-bar-handle = p-handle
     3484         .
     3485       end.
     3486       else do:
     3487         assign
     3488           v-xmllib-prg-bar-handle = ?
     3489         .
     3490       end.
     3491   end.
     3492   end procedure.
     3493   procedure xmllib-set-codepage-convert :
     3494     define input  parameter p-codepage-source as character no-undo .
     3495     define input  parameter p-codepage-target as character no-undo .
     3496   do
     3497   on error undo, return error return-value
     3498   :
     3499     if ( p-codepage-source <> "" and p-codepage-target <> "" )
     3500     then do:
     3501       assign
     3502         v-xmllib-codepage-convert = yes
     3503         v-xmllib-codepage-source  = p-codepage-source
     3504         v-xmllib-codepage-target  = p-codepage-target
     3505       .
     3506     end.
     3507     else do:
     3508       assign
     3509         v-xmllib-codepage-convert = no
     3510         v-xmllib-codepage-source  = ""
     3511         v-xmllib-codepage-target  = ""
     3512       .
     3513     end.
     3514   end.
     3515   end procedure.
     3516   procedure xmllib-parse-rec-open :
     3517   define input parameter p-rec-name   as character        no-undo.
     3518   define input parameter p-rec-level  as integer          no-undo.
     3519       define buffer buf_temp_xmllib_rec       for temp_xmllib_rec.
     3520   do
     3521   for buf_temp_xmllib_rec
     3522   on error undo, return error
     3523   :
     3524        find first buf_temp_xmllib_rec
     3525            where buf_temp_xmllib_rec.recName = p-rec-name
     3526              and buf_temp_xmllib_rec.recLevel = p-rec-level
     3527              and buf_temp_xmllib_rec.closed  = no
     3528       use-index nm
     3529       no-error.
     3530       if available buf_temp_xmllib_rec
     3531       then do:
     3532           run xmllib-parse-error in this-procedure (
     3533               input substitute( "Ошибка 2 открытия записи <&1>: Запись с этим именем и уровнем &2 уже открыта на строке &3."
     3534                               , p-rec-name
     3535                               , p-rec-level
     3536                               , buf_temp_xmllib_rec.recOpenLine
     3537                               )
     3538           ).
     3539       end.
     3540       else do:
     3541           assign
     3542               v-xmllib-rec-key    = v-xmllib-rec-key + 1
     3543           .
     3544           create buf_temp_xmllib_rec.
     3545           assign
     3546               buf_temp_xmllib_rec.rec-key         = v-xmllib-rec-key
     3547               buf_temp_xmllib_rec.recOpenLine     = v-xmllib-sax-reader-handle :locator-line-number
     3548               buf_temp_xmllib_rec.recCloseLine    = 0
     3549               buf_temp_xmllib_rec.recName         = p-rec-name
     3550               buf_temp_xmllib_rec.recLevel        = p-rec-level
     3551               buf_temp_xmllib_rec.closed          = no
     3552           .
     3553       end.
     3554   end.
     3555   end procedure.
     3556   procedure xmllib-parse-rec-fld-open :
     3557   define input parameter p-rec-name   as character        no-undo.
     3558   define input parameter p-rec-level  as integer          no-undo.
     3559   define input parameter p-fld-name   as character        no-undo.
     3560       define buffer buf_temp_xmllib_rec       for temp_xmllib_rec.
     3561       define buffer buf_temp_xmllib_rec-fld   for temp_xmllib_rec-fld.
     3562   do
     3563   for buf_temp_xmllib_rec
     3564     , buf_temp_xmllib_rec-fld
     3565   on error undo, return error substitute( "Ошибка в xmllib-parse-rec-fld-open. &1. &2. &3"
     3566                                           , return-value
     3567                                           , trim( error-status :get-message( 1 ) )
     3568                                           , trim( error-status :get-message( 2 ) ) )
     3569   :
     3570       find last buf_temp_xmllib_rec
     3571           where buf_temp_xmllib_rec.recName   = p-rec-name
     3572             and buf_temp_xmllib_rec.recLevel  = p-rec-level
     3573             and buf_temp_xmllib_rec.closed    = no
     3574       use-index nm
     3575       no-error.
     3576       if not available buf_temp_xmllib_rec
     3577       then do:
     3578           run xmllib-parse-error in this-procedure (
     3579               input substitute( "Ошибка 2 открытия поля <&2> в записи <&1> уровня &3: Нет открытой записи."
     3580                               , p-rec-name
     3581                               , p-fld-name
     3582                               , p-rec-level
     3583                               )
     3584           ).
     3585       end.
     3586       else do:
     3587           find last buf_temp_xmllib_rec-fld
     3588               where buf_temp_xmllib_rec-fld.rec-key  = buf_temp_xmllib_rec.rec-key
     3589                 and buf_temp_xmllib_rec-fld.fldName  = p-fld-name
     3590                 and buf_temp_xmllib_rec-fld.closed   = no
     3591           use-index nm
     3592           no-error.
     3593           if available buf_temp_xmllib_rec-fld
     3594           then do:
     3595               run xmllib-parse-error in this-procedure (
     3596                   input substitute( "Ошибка 3 открытия поля <&2> в записи <&1>: Поле с этим именем уже открыто на строке &3."
     3597                                   , p-rec-name
     3598                                   , p-fld-name
     3599                                   , buf_temp_xmllib_rec-fld.fldOpenLine
     3600                                   )
     3601               ).
     3602           end.
     3603           else do:
     3604               assign
     3605                   v-xmllib-rec-fld-key    = v-xmllib-rec-fld-key + 1
     3606               .
     3607               create buf_temp_xmllib_rec-fld.
     3608               assign
     3609                   buf_temp_xmllib_rec-fld.fld-key         = v-xmllib-rec-fld-key
     3610                   buf_temp_xmllib_rec-fld.rec-key         = buf_temp_xmllib_rec.rec-key
     3611                   buf_temp_xmllib_rec-fld.fldOpenLine     = v-xmllib-sax-reader-handle :locator-line-number
     3612                   buf_temp_xmllib_rec-fld.fldCloseLine    = 0
     3613                   buf_temp_xmllib_rec-fld.fldName         = p-fld-name
     3614                   buf_temp_xmllib_rec-fld.closed          = no
     3615               .
     3616           end.
     3617       end.
     3618   end.
     3619   end procedure.
