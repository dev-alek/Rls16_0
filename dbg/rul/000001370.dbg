     2040                 string(month(p-date), "99") + "/" +
     2041               string(day(p-date), "99")
     2042   v-date-char = v-date-char + "-" + v-date-char
     2043   .
     2044   find last buf_prop-ref no-lock where
     2045             buf_prop-ref.dtm-code = 5
     2046         and buf_prop-ref.sum-id <= v-date-char
     2047         and buf_prop-ref.caller_id = p-caller-id use-index idtsum
     2048         no-error .
     2049   if not available buf_prop-ref then do:
     2050     return chr(63).
     2051   end.
     2052   return buf_prop-ref.sum-id.
