     1741   define temp-table temp-rule-call-param no-undo like ub.rule-call-param.
     1742   define buffer buf_temp-rule-call-param for temp-rule-call-param.
     1743   define buffer buf_temp-cmd for temp-cmd.
     1744   define buffer buf_dis-card-sale_obj for temp-d-card.
     1745   define variable vh_dis-card-sale_obj as handle no-undo .
     1746    define variable p-caller-id as character no-undo.
     1747   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1748   def var vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1749   procedure dis-objh_write-dis-obj-rul :
     1750   define parameter buffer buf_dis-obj for ub.dis-obj .
     1751   define input parameter p-type as character no-undo .
     1752   define input parameter p-emitent-host-code as integer no-undo .
     1753   define input parameter p-dtm-code as integer no-undo .
     1754   define input parameter p-action as integer no-undo .
     1755   define variable v-date as date      no-undo.
     1756   define variable v-time  as integer   no-undo.
     1757   define variable v-rec-ord1 as integer no-undo .
     1758   define variable v-rec-ord2 as integer no-undo .
     1759   define variable v-rec-ord3 as integer no-undo .
     1760   define variable v-rec-hno as integer no-undo .
     1761   define buffer buf_c-dc-hist for ub.c-dc-hist.
     1762   define buffer buf_c-dis-obj for ub.c-dis-obj.
     1763   define buffer buf_temp-hist-nws-option for temp-hist-nws-option.
     1764   define buffer last_temp-hist-nws-option for temp-hist-nws-option.
     1765   do
     1766   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1767   :
     1768     if not available buf_dis-obj then do:
     1769       message
     1770         vss-workfile vss-revision vss-description skip
     1771         "Ошибка задания входных параметров" skip
     1772         "Не определена ДК" skip
     1773         view-as alert-box error .
     1774       undo, return error .
     1775     end.
     1776     find first buf_temp-hist-nws-option where
     1777               buf_temp-hist-nws-option.table-name = 'dis-obj':U
     1778           and buf_temp-hist-nws-option.db-num = g#db-num
     1779           and buf_temp-hist-nws-option.key#_one = p-dtm-code
     1780           and buf_temp-hist-nws-option.charkey_one = p-type
     1781           and buf_temp-hist-nws-option.host-code = p-emitent-host-code no-error .
     1782     if not available buf_temp-hist-nws-option then do:
     1783       find first last_temp-hist-nws-option where
     1784                last_temp-hist-nws-option.db-num = g#db-num
     1785            and last_temp-hist-nws-option.hn-id < 0 no-error.
     1786       create buf_temp-hist-nws-option.
     1787       assign
     1788       buf_temp-hist-nws-option.db-num = g#db-num
     1789       buf_temp-hist-nws-option.hn-id = (if available last_temp-hist-nws-option
     1790                                   then - (abs(last_temp-hist-nws-option.hn-id) + 1)
     1791                                   else -1 )
     1792       buf_temp-hist-nws-option.table-name = 'dis-obj':U
     1793       buf_temp-hist-nws-option.key#_one = p-dtm-code
     1794       buf_temp-hist-nws-option.charkey_one = p-type
     1795       buf_temp-hist-nws-option.host-code = p-emitent-host-code
     1796       buf_temp-hist-nws-option.smart-nws = integer('-1':U)
     1797       .
     1798   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1799   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option-record in g#lib-nws
     1800     (input  g#db-num
     1801     ,input  buffer buf_temp-hist-nws-option:handle
     1802     )  .
     1803     end.
     1804     if not g#news
     1805     and buf_temp-hist-nws-option.hist-from-prim < 0 then do:
     1806       return.
     1807     end.
     1808     if g#news
     1809     and buf_temp-hist-nws-option.nws-to-hist < 0 then do:
     1810       return.
     1811     end.
     1812     run cur-time in this-procedure(output v-date, output v-time).
     1813     create buf_c-dis-obj.
     1814     buffer-copy buf_dis-obj to buf_c-dis-obj
     1815     assign
     1816     buf_c-dis-obj.d-card             = buf_dis-obj.d-card
     1817     buf_c-dis-obj.obj-type           = buf_dis-obj.obj-type
     1818     buf_c-dis-obj.obj-code           = buf_dis-obj.obj-code
     1819     buf_c-dis-obj.card-num           = buf_dis-obj.card-num
     1820     buf_c-dis-obj.dt-code            = buf_dis-obj.dt-code
     1821     buf_c-dis-obj.main-card          = buf_dis-obj.main-card
     1822     buf_c-dis-obj.first-main-card    = buf_dis-obj.first-main-card
     1823     buf_c-dis-obj.first-card         = buf_dis-obj.first-card
     1824     buf_c-dis-obj.chip-num           = next-value (s-dc-chip, ub)
     1825     buf_c-dis-obj.corr-time          = v-time
     1826     buf_c-dis-obj.corr-user-db-num   = g#db-num
     1827     buf_c-dis-obj.corr-user-name     = (if g#news
     1828                                         then (chr(4) +  'СПН':U)
     1829                                         else (if g#esys
     1830                                               then (chr(4) +  'ВС':U)
     1831                                               else g#userid)
     1832                                         )
     1833     buf_c-dis-obj.corr-date          = v-date
     1834     .
     1835     create buf_c-dc-hist.
     1836     buffer-copy buf_c-dis-obj to buf_c-dc-hist
     1837     assign
     1838     buf_c-dc-hist.action = p-action
     1839     buf_c-dc-hist.subject = 'dis-obj':U
     1840     buf_c-dc-hist.host-code =  buf_dis-obj.host-code
     1841     buf_c-dc-hist.is-news = g#news
     1842     buf_c-dc-hist.source-type = p-doc-type
     1843     buf_c-dc-hist.source-ref = (if p-doc-type = '':U
     1844                                  then '':U
     1845                                  else p-doc-code)
     1846     .
     1847     if g#db-num > 0
     1848     or (g#db-num = 0
     1849         and buf_temp-hist-nws-option.hist-to-nws >= 0)
     1850     then do:
     1851       run add-dump in p-cmd-proc-handle                                                                           (input p-cmd-code                                                                                         ,input 'c-dis-obj':U                                                                                          ,input '+update'                                                                                         ,input buffer buf_c-dis-obj:handle                                                                                    ,input ''                                                                                         ,output v-rec-ord2                                                                                         ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                     delete procedure p-cmd-proc-handle .                                                                        undo , return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'c-dis-obj':U                                                                                                ,p-cmd-code                                                                                               ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
     1852       run add-dump in p-cmd-proc-handle                                                                           (input p-cmd-code                                                                                         ,input 'c-dc-hist':U                                                                                          ,input '+update'                                                                                         ,input buffer buf_c-dc-hist:handle                                                                                    ,input ''                                                                                         ,output v-rec-ord3                                                                                         ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                     delete procedure p-cmd-proc-handle .                                                                        undo , return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'c-dc-hist':U                                                                                                ,p-cmd-code                                                                                               ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
     1853       if g#db-num = 0 then do:
     1854        case  buf_temp-hist-nws-option.smart-nws :
     1855           when integer('0':U)
     1856           or
     1857           when integer('10':U)
     1858           then do:
     1859             run get-db-list-for-d-card  in this-procedure ( input buf_dis-obj.d-card).
     1860             run create-smart-route-link in this-procedure ( input 'c-dis-obj':U
     1861                                                         ,input buffer buf_c-dis-obj:handle
     1862                                                         ,input buf_dis-obj.d-card
     1863                                                         ,input v-rec-ord2
     1864                                                         ,input yes
