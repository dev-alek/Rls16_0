     2208   procedure load-ruleset-context :
     2209   define input parameter p-ruleset-id as integer no-undo .
     2210   define buffer buf_rule-call-param for ub.rule-call-param.
     2211     do
     2212     on error undo, return error
     2213     :
     2214    find first buf_rule-call-param no-lock where
     2215   buf_rule-call-param.codex_id = p-codex-id
     2216   and buf_rule-call-param.ruleset_id = p-ruleset-id
     2217   and buf_rule-call-param.call_id = p-call-id
     2218   and buf_rule-call-param.order_id = p-order-id
     2219   and buf_rule-call-param.rule_id = p-rule-id
     2220   and buf_rule-call-param.param-name = "p-caller-id"
     2221    no-error.
     2222   if available buf_rule-call-param then do:
     2223   assign p-caller-id = buf_rule-call-param.param-value-character.
