     2225       assign
     2226       vh_dis-card-sale_obj = buffer temp-d-card:handle
     2227       .
     2228       run get-gate-rec in this-procedure ( input "exe/temp-d-card-ds.xsd", output v-gate-rec) no-error.
     2229       if error-status :error then do:
     2230         undo, return error return-value .
     2231       end.
     2232       case p-ruleset-id:
     2233         when 1 then do:
     2234           assign
     2235           v-sign = 1
     2236           v-current-host-code = p-host-code
     2237           v-current-obj-type = p-obj-type
     2238           v-current-obj-code = p-obj-code
     2239           v-current-db-num = g#db-num
     2240           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     2241           v-current-doc-code = p-doc-code
     2242           v-current-doc-date = p-doc-date
     2243           v-current-doc-fact-date = p-fact-date
     2244           v-current-date = p-doc-date
     2245           v-current-fact-date = p-fact-date
     2246           .
     2247         end.
     2248         when 2 then do:
     2249           assign
     2250           v-sign = -1
     2251           v-current-host-code = p-host-code
     2252           v-current-obj-type = p-obj-type
     2253           v-current-obj-code = p-obj-code
     2254           v-current-db-num = g#db-num
     2255           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     2256           v-current-doc-code = p-doc-code
     2257           v-current-doc-date = p-doc-date
     2258           v-current-doc-fact-date = p-fact-date
     2259           v-current-date = p-doc-date
