     1985   procedure get-db-list-for-d-card:
     1986   define input parameter p-d-card as character no-undo .
     1987   define variable v-current-db-processed as logical no-undo .
     1988   define buffer buf_clients  for ub.clients.
     1989   define buffer buf_dis-obj for ub.dis-obj.
     1990   define buffer buf_temp-smart-route for temp-smart-route.
     1991     do
     1992     on error undo, return error return-value
     1993     :
     1994       for each buf_dis-obj no-lock where
     1995               buf_dis-obj.d-card = p-d-card,
     1996          first buf_clients no-lock where
     1997               buf_clients.obj-type = buf_dis-obj.obj-type
     1998           and buf_clients.obj-code = buf_dis-obj.obj-code
     1999       break by
     2000       buf_clients.db-num:
     2001         if first-of(buf_Clients.db-num) then do:
     2002           find first buf_temp-smart-route no-lock where
     2003                 buf_temp-smart-route.key-field = p-d-card
     2004             and buf_temp-smart-route.db-num = buf_clients.db-num
     2005                 no-error.
     2006           if available buf_temp-smart-route then return.
     2007           create buf_temp-smart-route.
     2008           assign
     2009           buf_temp-smart-route.key-field = p-d-card
     2010           buf_temp-smart-route.db-num = buf_clients.db-num
     2011           .
     2012           if buf_clients.db-num = g#db-num then do:
     2013             v-current-db-processed = yes.
     2014           end.
     2015         end.
     2016       end.
     2017       if not v-current-db-processed then do:
     2018         find first buf_temp-smart-route no-lock where
     2019               buf_temp-smart-route.key-field = p-d-card
     2020           and buf_temp-smart-route.db-num = g#db-num  no-error.
     2021         if not available buf_temp-smart-route then do:
     2022           create buf_temp-smart-route.
     2023           assign
     2024           buf_temp-smart-route.key-field = p-d-card
     2025           buf_temp-smart-route.db-num = g#db-num
     2026           .
     2027         end.
     2028       end.
     2029     end.
     2030   end procedure.
