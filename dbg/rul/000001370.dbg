     2264         or when 5
     2265         then do:
     2266           assign
     2267           v-sign = 1
     2268           v-current-host-code = p-host-code
     2269           v-current-obj-type = p-obj-type
     2270           v-current-obj-code = p-obj-code
     2271           v-current-db-num = g#db-num
     2272           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     2273           v-current-doc-code = p-doc-code
     2274           v-current-doc-date = p-doc-date
     2275           v-current-doc-time = 0
     2276           v-current-doc-fact-date = p-fact-date
     2277           v-current-date = p-doc-date
     2278           v-current-fact-date = p-fact-date
     2279           .
     2280         end.
     2281         when 4 then do:
     2282           assign
     2283           v-sign = -1
     2284           v-current-host-code = p-host-code
     2285           v-current-obj-type = p-obj-type
     2286           v-current-obj-code = p-obj-code
     2287           v-current-db-num = g#db-num
     2288           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     2289           v-current-doc-code = p-doc-code
     2290           v-current-doc-date = p-doc-date
     2291           v-current-doc-time = 0
     2292           v-current-doc-fact-date = p-fact-date
     2293           v-current-date = p-doc-date
     2294           v-current-fact-date = p-fact-date
     2295           .
     2296         end.
     2297       end case.
     2298     end.
     2299   end procedure.
