     1194   def var vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1195   procedure get-gate-file-name :
     1196   define input parameter p-gate-rec as character no-undo .
     1197   define output  parameter p-gate-file-name as character no-undo .
     1198   define buffer buf_clob-data for ub.clob-data.
     1199   define variable v-tbl-row as rowid no-undo .
     1200   define variable v-tbl-name as character no-undo .
     1201   run gen-row-keyr in this-procedure ( input p-gate-rec
     1202                                       ,input ?
     1203                                       ,input "ub"
     1204                                       ,input ?
     1205                                       ,input no-lock
     1206                                       ,output v-tbl-row
     1207                                       ,output v-tbl-name) no-error.
     1208   if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     1209                                                           ,vss-include-info11
     1210                                                           ,p-gate-rec).
     1211   find first buf_clob-data no-lock where
     1212             rowid(buf_clob-data) = v-tbl-row no-error.
     1213   if not available buf_clob-data then do:
     1214     if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     1215                                                             ,vss-include-info11
     1216                                                             ,p-gate-rec).
     1217   end.
     1218   p-gate-file-name = buf_clob-data.file-name.
     1219   end procedure.
     1220   procedure get-gate-rec :
     1221   define input  parameter p-gate-name as character no-undo .
     1222   define output parameter p-gate-rec as character no-undo .
     1223   define buffer buf_clob-bind for ub.clob-bind.
     1224   define buffer buf_clob-data for ub.clob-data.
     1225   main-block:
     1226   do
     1227   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info11, return-value, chr(10), error-status :get-message (1))
     1228   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info11 )
     1229   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info11 )
     1230   :
     1231       find first buf_clob-bind no-lock where
     1232                 buf_clob-bind.uniq-key-rec = p-gate-name
     1233             and buf_clob-bind.field-name = '':U
     1234             and buf_clob-bind.part-num = 1
     1235             and buf_clob-bind.resource-type = 'gate':U
     1236             no-error.
     1237       if not available buf_clob-bind then do:
     1238         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     1239                                         , p-gate-name
     1240                                         ).
     1241       end.
     1242       find first buf_clob-data no-lock where
     1243                 buf_clob-data.db-num = buf_clob-bind.db-num
     1244             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     1245       if not available buf_clob-data then do:
     1246         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1247                                         , buf_clob-bind.db-num
     1248                                         , buf_clob-bind.int64-id
     1249                                         , p-gate-name
     1250                                         ).
     1251       end.
     1252       run gen-key-rec in this-procedure ( input 'clob-data':U
     1253                                 ,input buffer buf_clob-data:handle
     1254                                 ,output p-gate-rec).
     1255   end.
     1256   end procedure.
     1257   procedure get-gate-by-name :
     1258   define input  parameter p-gate-name as character no-undo .
     1259   define output parameter p-gate-rec as character no-undo .
     1260   define output parameter p-dsh as handle no-undo .
     1261   define input-output  parameter p-xmlh as handle no-undo .
     1262   define variable v-ii as integer   no-undo .
     1263   define variable glog as logical   no-undo .
     1264   define variable v-longchar as longchar no-undo .
     1265   define variable v-txmlh as handle no-undo .
     1266   define variable v-db-num as integer no-undo .
     1267   define variable v-int64-id as int64 no-undo .
     1268   define buffer buf_clob-bind for ub.clob-bind.
     1269   define buffer buf_clob-data for ub.clob-data.
     1270   main-block:
     1271   do
     1272   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info11, return-value, chr(10), error-status :get-message (1))
     1273   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info11 )
     1274   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info11 )
     1275   :
     1276       find first buf_clob-bind no-lock where
     1277                 buf_clob-bind.uniq-key-rec = p-gate-name
     1278             and buf_clob-bind.field-name = '':U
     1279             and buf_clob-bind.part-num = 1
     1280             and buf_clob-bind.resource-type = 'gate':U
     1281             no-error.
     1282       if not available buf_clob-bind then do:
     1283         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     1284                                         , p-gate-name
     1285                                         ).
     1286       end.
     1287       find first buf_clob-data no-lock where
     1288                 buf_clob-data.db-num = buf_clob-bind.db-num
     1289             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     1290       if not available buf_clob-data then do:
     1291         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1292                                         , buf_clob-bind.db-num
     1293                                         , buf_clob-bind.int64-id
     1294                                         , p-gate-name
     1295                                         ).
     1296       end.
     1297       assign
     1298       v-longchar = buf_clob-data.cdata
     1299       .
     1300       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1301       if error-status :error then do:
     1302         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1303       end.
     1304       create dataset p-dsh .
     1305       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1306                                     , v-longchar
     1307                                     , ?
     1308                                     , ?
     1309                                     , ?
     1310                                     ) no-error.
     1311       v-longchar = '':U.
     1312       if error-status :error
     1313       or not glog
     1314       then do:
     1315         undo, return error substitute("Не удалось прочитать XML-схему &1 из БД:&2&3", p-gate-name, chr(10), error-status:get-message(1) ).
     1316       end.
     1317       if not valid-handle(p-xmlh)
     1318       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1319         create temp-table v-txmlh.
     1320         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1321         v-txmlh:temp-table-prepare("temp-xml-tables").
     1322         p-xmlh = v-txmlh:default-buffer-handle.
     1323       end.
     1324       run gen-key-rec in this-procedure ( input 'clob-data':U
     1325                                 ,input buffer buf_clob-data:handle
     1326                                 ,output p-gate-rec).
     1327       do v-ii = 1 to p-dsh:num-buffers:
     1328         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1329         if not p-xmlh:available then do:
     1330           p-xmlh:buffer-create().
     1331           assign
     1332           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1333           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1334           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1335           p-xmlh::gate-handle_ = p-dsh
     1336           p-xmlh::uniq-gate-rec = p-gate-rec
     1337           p-xmlh::gate-name = p-dsh:name
     1338           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1339           .
     1340           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1341             assign
     1342             p-xmlh::order = -3.
     1343           end.
     1344         end.
     1345       end.
     1346   end.
     1347   end procedure.
     1348   procedure get-gate-by-rec :
     1349   define input  parameter p-gate-rec as character no-undo .
     1350   define output parameter p-dsh as handle no-undo .
     1351   define input-output  parameter p-xmlh as handle no-undo .
     1352   define input-output parameter p-longchar  as longchar no-undo .
     1353   define variable v-ii as integer   no-undo .
     1354   define variable glog as logical   no-undo .
     1355   define variable v-rowid as rowid no-undo .
     1356   define variable v-tbl-name as character no-undo .
     1357   define variable v-longchar as longchar no-undo .
     1358   define variable v-txmlh as handle no-undo .
     1359   define buffer buf_clob-data for ub.clob-data.
     1360   main-block:
     1361   do
     1362   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info11, return-value, chr(10), error-status :get-message (1))
     1363   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info11 )
     1364   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info11 )
     1365   :
     1366     run gen-row-keyr in this-procedure (
     1367                                           input  p-gate-rec
     1368                                           ,input  ?
     1369                                           ,input  "ub"
     1370                                           ,input  ?
     1371                                           ,input  NO-LOCK
     1372                                           ,output v-rowid
     1373                                           ,output v-tbl-name   ) no-error.
     1374       find first buf_clob-data no-lock where
     1375                 rowid(buf_clob-data) = v-rowid  no-error.
     1376       if not available buf_clob-data then do:
     1377         undo, return error substitute("Не найден CLOB  &1"
     1378                                         , p-gate-rec
     1379                                         ).
     1380       end.
     1381       assign
     1382       v-longchar = buf_clob-data.cdata
     1383       .
     1384       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1385       if error-status :error then do:
     1386         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1387       end.
     1388       create dataset p-dsh .
     1389       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1390                                     , v-longchar
     1391                                     , ?
     1392                                     , ?
     1393                                     , ?
     1394                                     ) no-error.
     1395       define variable v-esm as character no-undo .
     1396       v-esm = error-status:get-message(1) .
     1397       if p-longchar <> ? then do:
     1398         p-longchar = v-longchar.
     1399       end.
     1400       v-longchar = '':U.
     1401       if error-status :error
     1402       or not glog
     1403       then do:
     1404         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     1405                                      , p-gate-rec
     1406                                      , p-gate-rec
     1407                                      , v-esm
     1408                                      ).
     1409       end.
     1410       p-dsh:private-data = buf_clob-data.file-name_ + chr(4) + p-gate-rec.
     1411       if not valid-handle(p-xmlh)
     1412       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1413         create temp-table v-txmlh.
     1414         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1415         v-txmlh:temp-table-prepare("temp-xml-tables").
     1416         p-xmlh = v-txmlh:default-buffer-handle.
     1417       end.
     1418       do v-ii = 1 to p-dsh:num-buffers:
     1419         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1420         if not p-xmlh:available then do:
     1421           p-xmlh:buffer-create().
     1422           assign
     1423           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1424           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1425           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1426           p-xmlh::gate-handle_ = p-dsh
     1427           p-xmlh::uniq-gate-rec = p-gate-rec
     1428           p-xmlh::gate-name = p-dsh:name
     1429           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1430           .
     1431           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1432             assign
     1433             p-xmlh::order = -3.
     1434           end.
     1435           p-xmlh:buffer-release().
     1436         end.
     1437       end.
     1438   end.
     1439   end procedure.
     1440   procedure get-gate-by-file :
     1441   define input  parameter p-schema-file-name as character no-undo .
     1442   define input  parameter p-gate-rec as character no-undo .
     1443   define output parameter p-dsh as handle no-undo .
     1444   define input-output  parameter p-xmlh as handle no-undo .
     1445   define variable v-ii as integer   no-undo .
     1446   define variable glog as logical   no-undo .
     1447   define variable v-rowid as rowid no-undo .
     1448   define variable v-tbl-name as character no-undo .
     1449   define variable v-longchar as longchar no-undo .
     1450   define variable v-txmlh as handle no-undo .
     1451   main-block:
     1452   do
     1453   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info11, return-value, chr(10), error-status :get-message (1))
     1454   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info11 )
     1455   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info11 )
     1456   :
     1457       COPY-LOB
     1458       FROM  FILE p-schema-file-name
     1459       TO  OBJECT v-longchar
     1460       no-convert
     1461       NO-ERROR .
     1462       if error-status :error then do:
     1463           undo, return error substitute("Не удалось считать файл схемы &1 в память&2&3"
     1464                                     , p-schema-file-name
     1465                                 , chr(10)
     1466                                 , error-status:get-message(1) ).
     1467       end.
     1468       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1469       if error-status :error then do:
     1470         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, p-schema-file-name, chr(10), error-status:get-message(1) , return-value ).
     1471       end.
     1472       create dataset p-dsh .
     1473       glog = p-dsh:READ-XMLSCHEMA( "longchar"
     1474                                     , v-longchar
     1475                                     , ?
     1476                                     , ?
     1477                                     , ?
     1478                                     ) no-error.
     1479       v-longchar = ''.
     1480       if error-status :error
     1481       or not glog
     1482       then do:
     1483         undo, return error substitute("Не удалось прочитать XML-схему из файла &1&2&3"
     1484                                      , p-schema-file-name
     1485                                      ,chr(10)
     1486                                      , error-status:get-message(1)
     1487                                      ).
     1488       end.
     1489       if not valid-handle(p-xmlh)
     1490       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1491         create temp-table v-txmlh.
     1492         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1493         v-txmlh:temp-table-prepare("temp-xml-tables").
     1494         p-xmlh = v-txmlh:default-buffer-handle.
     1495       end.
     1496       do v-ii = 1 to p-dsh:num-buffers:
     1497         p-xmlh:find-first(substitute(' where tbl-name = "&1" and  uniq-gate-rec = "&2" '
     1498                                      ,p-dsh:get-buffer-handle(v-ii):name
     1499                                      ,p-gate-rec
     1500                                      )) no-error.
     1501         if not p-xmlh:available then do:
     1502           p-xmlh:buffer-create().
     1503           assign
     1504           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):table
     1505           p-xmlh::uniq-gate-rec = p-gate-rec
     1506           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1507           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1508           p-xmlh::gate-handle_ = p-dsh
     1509           p-xmlh::gate-name = p-dsh:name
     1510           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1511           .
     1512           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1513             assign
     1514             p-xmlh::order = -3.
     1515           end.
     1516           p-xmlh:buffer-release().
     1517         end.
     1518       end.
     1519   end.
     1520   end procedure.
     1521   procedure gate-clear :
     1522   define input  parameter p-dsh as handle no-undo .
     1523   define input  parameter p-xmlh as handle no-undo .
     1524   define variable v-dsh as handle no-undo .
     1525   define variable v-th as handle no-undo .
     1526     do
     1527     on error undo, return error return-value
     1528     :
     1529       if valid-handle(p-dsh) then do:
     1530         delete object p-dsh.
     1531         v-dsh = p-dsh.
     1532         p-dsh = ?.
     1533       end.
     1534       repeat while true:
     1535         p-xmlh:find-first( substitute( " where gate-handle_ = &1 ", v-dsh)
     1536                            , share-lock) no-error.
     1537         if p-xmlh:available then do:
     1538           assign
     1539           v-th = p-xmlh:buffer-field("table-handle_"):buffer-value.
     1540           if valid-handle(p-xmlh:buffer-field("table-handle_"))
     1541           and valid-handle(v-th)
     1542           and v-th:dynamic = yes
     1543           then do:
     1544             delete object p-xmlh:buffer-field("table-handle_"):buffer-value.
     1545             p-xmlh:buffer-field("table-handle_"):buffer-value = ?.
     1546           end.
     1547           p-xmlh:buffer-delete().
     1548         end.
     1549         else do:
     1550           leave.
     1551         end.
     1552       end.
     1553       if p-xmlh:dynamic = yes
     1554       and valid-handle(p-xmlh)
     1555       then do:
     1556         delete object p-xmlh:table-handle.
     1557         p-xmlh = ?.
     1558       end.
     1559       v-dsh = ?.
     1560     end.
     1561   end procedure.
     1562   procedure all-gates-clear :
     1563   define parameter buffer buf_temp-xml-tables for temp-xml-tables.
     1564   do
     1565   on error undo, return error
     1566   :
     1567     for each buf_temp-xml-tables
     1568     break
     1569     by buf_temp-xml-tables.uniq-gate-rec
     1570     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1571     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1572     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1573     :
     1574         if first-of(buf_temp-xml-tables.uniq-gate-rec) then do:
     1575           delete object buf_temp-xml-tables.gate-handle_.
     1576           buf_temp-xml-tables.gate-handle_ = ?.
     1577         end.
     1578         if valid-handle(buf_temp-xml-tables.table-handle_)
     1579         and buf_temp-xml-tables.table-handle_:dynamic = no
     1580         then do:
     1581           delete object buf_temp-xml-tables.table-handle_.
     1582           buf_temp-xml-tables.table-handle_ = ?.
     1583         end.
     1584         delete buf_temp-xml-tables.
     1585     end.
     1586   end.
     1587   end procedure.
     1588   procedure fix-schemalocation :
     1589   define input-output  parameter p-longchar as longchar no-undo .
     1590   DEFINE VARIABLE hdoc AS HANDLE.
     1591   DEFINE VARIABLE hroot AS HANDLE.
     1592   DEFINE VARIABLE hnode-child AS HANDLE.
     1593   DEFINE VARIABLE hnode-attr AS HANDLE.
     1594   define variable v-jj as integer   no-undo .
     1595   define variable ok as logical   no-undo .
     1596   define variable v-path1                    as character                no-undo .
     1597   DEFINE VARIABLE v-full-path1               as character                no-undo .
     1598   DEFINE VARIABLE v-file-name1               as character                no-undo .
     1599   DEFINE VARIABLE v-file-name-no-ext1        as character                no-undo .
     1600   DEFINE VARIABLE v-file-name-ext1           as character                no-undo .
     1601   define variable v-schema-location          as character                no-undo .
     1602   do
     1603   on error undo, return error return-value
     1604   :
     1605     CREATE X-DOCUMENT hdoc.
     1606     CREATE X-noderef hroot.
     1607     CREATE X-noderef hnode-child.
     1608     CREATE X-noderef hnode-attr.
     1609     hdoc:load("longchar", p-longchar, no) no-error.
     1610     iF ERROR-STATUS:GET-MESSAGE(1) <> '' THEN message ERROR-STATUS:GET-MESSAGE(1) view-as alert-box .
     1611     hdoc:get-document-element(hroot).
     1612     _repeat:
     1613     REPEAT v-jj = 1 TO hroot:NUM-CHILDREN:
     1614       ok = hroot:GET-CHILD(hNode-Child, v-jj).
     1615       if not ok then next.
     1616       if hNode-Child:local-name = "include"
     1617       then do:
     1618         ok = hNode-Child:GET-ATTRIBUTE-NODE( hnode-attr, "schemaLocation" ).
     1619           v-schema-location = hnode-attr:node-value.
     1620           run gbl/filename.p (
     1621                           input "exe/" + hnode-attr:node-value
     1622                         ,output v-full-path1
     1623                         ,output v-path1
     1624                         ,output v-file-name1
     1625                         ,output v-file-name-no-ext1
     1626                         ,output v-file-name-ext1
     1627                         ) no-error .
     1628           if error-status :error then do:
     1629             delete object hnode-attr.
     1630             delete object hnode-child.
     1631             delete object hroot.
     1632             delete object hdoc.
     1633             undo, return error substitute("Не удалось определить расположение схемы &1", v-schema-location).
     1634           end.
     1635         ok = hNode-Child:sET-ATTRIBUTE(  "schemaLocation", v-full-path1 ).
     1636         leave  _repeat.
     1637       end.
     1638     END.
     1639     hdoc:save("longchar", p-longchar).
     1640     delete object hnode-attr.
     1641     delete object hnode-child.
     1642     delete object hroot.
     1643     delete object hdoc.
     1644   end.
     1645   end procedure.
     1646   procedure gate-clb_fill-xml-tables :
     1647   define input parameter p-dsh as handle no-undo .
     1648   define input-output parameter p-xmlh as handle no-undo .
     1649   define variable v-ii as integer no-undo .
     1650     do
     1651     on error undo, return error
     1652     :
     1653       do v-ii = 1 to p-dsh:num-buffers:
     1654         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1655         if not p-xmlh:available then do:
     1656           p-xmlh:buffer-create().
     1657           assign
     1658           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1659           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1660           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1661           p-xmlh::gate-handle_ = p-dsh
     1662           p-xmlh::uniq-gate-rec = entry(2, p-dsh:private-data, chr(4))
     1663           p-xmlh::gate-name = p-dsh:name
     1664           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1665           .
     1666           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1667             assign
     1668             p-xmlh::order = -3.
     1669           end.
     1670           p-xmlh:buffer-release().
     1671         end.
     1672       end.
     1673     end.
     1674   end procedure.
     1675   procedure all-gates-empty :
     1676   define buffer buf_temp-xml-tables for temp-xml-tables.
     1677   do
     1678   on error undo, return error
     1679   :
     1680     for each buf_temp-xml-tables
     1681     break
     1682     by buf_temp-xml-tables.uniq-gate-rec
     1683     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1684     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1685     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1686     :
     1687       if valid-handle(buf_temp-xml-tables.tbl-handle_) then do:
     1688         buf_temp-xml-tables.tbl-handle_:empty-temp-table().
     1689       end.
     1690     end.
     1691   end.
     1692   end procedure.
     1693   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1694   procedure library-cls_get-handle :
     1695   define input parameter p-library-name as character no-undo .
     1696   define output parameter p-library-handle as handle no-undo .
     1697     do
     1698     on error undo, return error
     1699     :
     1700       CASE p-library-name:
     1701         when "library" then do:
     1702           if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end.
     1703           p-library-handle = g#library.
     1704         end.
     1705         when "library2" then do:
     1706           if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end.
     1707           p-library-handle = g#library2.
     1708         end.
     1709       end case.
     1710     end.
     1711   end procedure.
     1712   define variable v-current-d-card as character no-undo .
     1713   define variable v-current-host-code as integer no-undo .
     1714   define variable v-current-obj-type as character no-undo .
     1715   define variable v-current-obj-code as integer no-undo .
     1716   define variable v-current-lock as integer no-undo .
     1717   define variable v-current-wait as integer no-undo .
     1718   define variable v-save as integer no-undo .
     1719   define variable v-current-db-num as integer no-undo .
     1720   define variable v-current-doc-code as character no-undo .
     1721   define variable v-current-doc-date as date no-undo .
     1722   define variable v-current-doc-time as integer no-undo .
     1723   define variable v-current-doc-fact-date as date no-undo .
     1724   define variable v-current-date as date no-undo .
     1725   define variable v-current-fact-date as date no-undo .
     1726   define variable v-last-error-message as character no-undo .
     1727   define variable v-sign as integer no-undo .
     1728   define variable v-temp-d-card-rec-ord as integer   no-undo .
     1729   define variable v-vchk-pay-rec-ord as integer   no-undo .
     1730   define variable v-gate-rec as character no-undo .
     1731   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1732   procedure set-error :
     1733   define input parameter p-mess as character no-undo .
