     1236     QUERY BR-rcp DISPLAY
     1237         X_rp-rule-param.rp-param-name COLUMN-LABEL "Название пар-ра!профайла" FORMAT "X(20)" width 16
     1238   term_tt-rule-call-param.codex_id COLUMN-LABEL "Кодекс"
     1239   term_tt-rule-call-param.ruleset_id COLUMN-LABEL "Набор"
     1240   term_tt-rule-call-param.order_id  COLUMN-LABEL "Порядок!вызова"
