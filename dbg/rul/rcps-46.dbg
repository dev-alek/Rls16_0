     1242   term_tt-rule-call-param.profile_id  COLUMN-LABEL "Профайл"
     1243   term_tt-rule-call-param.once-more COLUMN-LABEL "№!Привязки"
     1244   (if lookup (term_tt-rule-call-param.param-data-type, 'character,date,datetime,datetime-tz,decimal,integer,void,logical,memptr,raw,recid,rowid,widget-handle,handle,blob,clob,class,com-handle,longchar,int64':U) > 0 then entry (lookup (term_tt-rule-call-param.param-data-type, 'character,date,datetime,datetime-tz,decimal,integer,void,logical,memptr,raw,recid,rowid,widget-handle,handle,blob,clob,class,com-handle,longchar,int64':U), 'строка,дата,дата-время,дата-время-з,десятичное,целое,пусто,логическое,память,двоичные,номер записи,Номер Записи,ссылка,ссылка,Больш.бин.объект,Больш.стр.объект,Объект,COM-объект,Длинная строка,64Целое':U) else term_tt-rule-call-param.param-data-type) COLUMN-LABEL "Тип пар-ра" FORMAT "X(12)"
     1245   term_tt-rule-call-param.param-num COLUMN-LABEL "№!пар-ра" FORMAT ">9"
     1246   TERM_tt-rule-call-param.p-index COLUMN-LABEL "Инд!екс" FORMAT ">9"
     1247   term_tt-rule-call-param.param-name COLUMN-LABEL "Название пар-ра!правила" FORMAT "X(16)"
     1248   term_tt-rule-call-param.param-label COLUMN-LABEL "Название пар-ра" FORMAT "X(255)" WIDTH 30
     1249   entry (lookup (term_tt-rule-call-param.param-mode, 'input,output,input-output,buffer,input table,output table,input-output table':u), 'вх,вых,вх-вых,курсор,вх табл,вых табл,вх/вых табл':u) COLUMN-LABEL "Вид!пар-ра"
     1250   get-param-value( INPUT term_tt-rule-call-param.param-data-type
     1251                   ,INPUT term_tt-rule-call-param.param-2-data-type
     1252                   ,INPUT term_tt-rule-call-param.param-3-data-type
     1253                   ,INPUT TERM_tt-rule-call-param.p-index
     1254                   ,INPUT term_tt-rule-call-param.param-value-character
     1255                   ,INPUT term_tt-rule-call-param.param-value-date
     1256                   ,INPUT term_tt-rule-call-param.param-value-decimal
     1257                   ,INPUT term_tt-rule-call-param.param-value-integer
     1258                   ,INPUT term_tt-rule-call-param.param-value-logical) COLUMN-LABEL "Значение" FORMAT "X(255)" WIDTH 26
     1259   (IF term_tt-rule-call-param.param-data-type = 'character':U
     1260    THEN term_tt-rule-call-param.param-value-character
     1261    ELSE '':U) COLUMN-LABEL "Значение!(строковое)" FORMAT "X(26)"
     1262   (IF term_tt-rule-call-param.param-data-type = 'date':U
     1263   THEN STRING(term_tt-rule-call-param.param-value-date, "99/99/9999")
     1264   ELSE '':U)    COLUMN-LABEL "Значение!(Дата)" FORMAT "X(10)" WIDTH 12
     1265   (IF term_tt-rule-call-param.param-data-type = 'decimal':U
     1266   THEN STRING(term_tt-rule-call-param.param-value-decimal)
     1267   ELSE '':U) COLUMN-LABEL "Значение!(Десятичное)"   FORMAT "X(16)"
     1268   (IF term_tt-rule-call-param.param-data-type = 'integer':U
     1269   THEN STRING(term_tt-rule-call-param.param-value-integer)
     1270   ELSE '':U) COLUMN-LABEL "Значение!(Целое)" FORMAT "X(10)"
     1271   (IF term_tt-rule-call-param.param-data-type = 'logical':U
     1272   THEN STRING(term_tt-rule-call-param.param-value-logical, "+/-")
     1273   ELSE '':U) COLUMN-LABEL "Значение!(Логическое)" FORMAT "X(2)"
     1274   calldscr(tt-rule-call-param.call_id) COLUMN-LABEL  "Точка вызова" FORMAT "X(40)"
     1275       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 6
     1276            FONT 4 ROW-HEIGHT-CHARS .67 FIT-LAST-COLUMN.
     1277   DEFINE FRAME Dialog-Frame
     1278        B-exit AT ROW 1 COL 1
     1279        b-quit AT ROW 1 COL 11
     1280        B-Help AT ROW 1 COL 95
     1281        F-tpl AT ROW 3.13 COL 11 COLON-ALIGNED WIDGET-ID 76
     1282        button-tpl AT ROW 3.13 COL 34.5 WIDGET-ID 52
     1283        tpl-name AT ROW 4.2 COL 1 NO-LABEL WIDGET-ID 78
     1284        f-coeff AT ROW 5.27 COL 13.5 COLON-ALIGNED WIDGET-ID 74
     1285        EDITOR-1 AT ROW 5.27 COL 27.5 NO-LABEL WIDGET-ID 80
     1286        BR-rcp AT ROW 10 COL 1 WIDGET-ID 100
     1287        SPACE(0.00) SKIP(1.99)
     1288       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1289            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1290            TITLE ""
     1291            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
     1292   ASSIGN
     1293          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1294          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1295   ASSIGN
     1296          BR-rcp:HIDDEN  IN FRAME Dialog-Frame                = TRUE.
     1297   ASSIGN
     1298          EDITOR-1:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     1299   ASSIGN
     1300          tpl-name:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     1301   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1302   DO:
     1303     APPLY "END-ERROR":U TO SELF.
     1304   END.
     1305   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
     1306   DO:
     1307     RUN proc-save IN THIS-PROCEDURE  NO-ERROR.
     1308     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1309   END.
     1310   ON CHOOSE OF button-tpl IN FRAME Dialog-Frame
     1311   DO:
     1312    DEFINE VARIABLE v-charkey_one AS CHARACTER NO-UNDO.
     1313    DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     1314    DEFINE BUFFER local_price-list-type FOR ub.price-list-type.
     1315    DEFINE BUFFER local2_price-list-type FOR ub.price-list-type.
     1316    IF v-tpl <> '' then do:
     1317       find first local_price-list-type no-lock where
     1318                 local_price-list-type.plt-id = integer(entry(1, v-tpl, "-") )
     1319             and local_price-list-type.plt-db-num = integer(entry(2, v-tpl, "-") ) no-error.
     1320       if available local_price-list-type then do:
     1321         v-rid-list = STRING(RECID(local_price-list-type)).
     1322         tpl-name =     local_price-list-type.NAME .
     1323         v-templ-rl-root = local_price-list-type.ban-discnt.
     1324         display
     1325         v-tpl @ f-tpl
     1326         tpl-name
     1327         with frame Dialog-Frame .
     1328       end.
     1329    END.
     1330    else do:
     1331      v-rid-list = string(v-templ-rl-root).
     1332    end.
     1333    run ref/typepric.w (
     1334                         input  parParentProc
     1335                        ,INPUT "b-sel,mode=ban-discnt"
     1336                        ,INPUT-OUTPUT v-rid-list ) NO-ERROR.
     1337   IF error-status:error
     1338   or v-rid-list = ""
     1339   THEN RETURN NO-APPLY.
     1340    IF (available local_price-list-type and v-rid-list <> string(v-templ-rl-root))
     1341    or not available local_price-list-type
     1342    THEN DO:
     1343        FIND FIRST local2_price-list-type NO-LOCK WHERE
     1344                   recid(local2_price-list-type) = INTEGER(v-rid-list) NO-ERROR.
     1345       IF AVAILABLE local2_price-list-type THEN DO:
     1346           ASSIGN
     1347           f-tpl = SUBSTITUTE("&1-&2"
     1348                       , local2_price-list-type.plt-id
     1349                       , local2_price-list-type.plt-db-num)
     1350           tpl-name =     local2_price-list-type.NAME
     1351           .
     1352           DISPLAY
     1353           f-tpl
     1354           tpl-name
     1355           WITH FRAME Dialog-Frame.
     1356       END.
     1357       ELSE DO:
     1358         MESSAGE
     1359         substitute("Не удалось найти ТПЛ с recid=&1", v-rid-list)
     1360         VIEW-AS ALERT-BOX ERROR.
     1361       END.
     1362    END.
     1363    apply "entry" to f-tpl in FRAME Dialog-Frame.
     1364    return no-apply.
     1365   END.
     1366   ON ROW-DISPLAY OF br-rcp IN frame Dialog-Frame
     1367   DO:
     1368     IF AVAIL tt-rule-call-param THEN DO:
     1369       RUN rcps_set-row-color IN THIS-PROCEDURE ( INPUT term_tt-rule-call-param.param-data-type).
     1370     END.
     1371   END.
     1372   ON f6 anywhere DO:
     1373     ASSIGN
     1374     br-rcp:VISIBLE IN FRAME Dialog-Frame = (NOT br-rcp:VISIBLE IN FRAME Dialog-Frame)
     1375     .
     1376   END.
     1377   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1378   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1379   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1380   on help of frame Dialog-Frame
     1381   do:
     1382     run gbl/app_help.p
     1383       (input this-procedure :file-name
     1384       ,input ''
     1385       ,input ?
     1386       ) no-error.
     1387     if error-status :error then do:
     1388       message
     1389         "Ошибка при вызове помощи"
     1390         error-status :get-message(1)
     1391         view-as alert-box .
     1392     end.
     1393   end.
     1394   run minbtn-set in this-procedure .
     1395   on choose of b-help in frame Dialog-Frame
     1396   do:
     1397     apply "help":u to frame Dialog-Frame .
     1398   end.
     1399   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1400   procedure minbtn-set :
     1401       do
     1402           on error undo, return error return-value
     1403           :
     1404           define variable ii              as integer       no-undo .
     1405           define variable fh              as widget-handle no-undo .
     1406           define variable hh              as widget-handle no-undo .
     1407           define variable v-h             as handle        extent 4 no-undo .
     1408           define variable v-name-button   as character     no-undo .
     1409           define variable v-help-old-x    as decimal       no-undo .
     1410           define variable v-help-old-y    as decimal       no-undo .
     1411           define variable v-help-old-size as decimal       no-undo .
     1412           define variable v-frame-width   as decimal       no-undo .
     1413           define variable jj              as integer       no-undo .
     1414           do
     1415               on error undo, return error
     1416               :
     1417               assign
     1418                   v-frame-width = frame Dialog-Frame:width - 0.3
     1419                   fh            = frame Dialog-Frame:first-child
     1420                   hh            = fh:first-child
     1421                   ii            = 1
     1422                   .
     1423               do while valid-handle(hh):
     1424                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1425                   do:
     1426                       case lc(hh:name) :
     1427                           when "b-help" then
     1428                               do:
     1429                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1430                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1431                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1432                                   hh:TOOLTIP = "Помощь" .
     1433                                   v-help-old-x = hh:column .
     1434                                   v-help-old-y = hh:row    .
     1435                                   v-help-old-size = hh:width .
     1436                                   hh:width-chars = 2.5 .
     1437                               end.
     1438                           when "b-print" then
     1439                               do:
     1440                                   hh:load-image("cmp/b-print.bmp":u) .
     1441                                   hh:TOOLTIP = "Печать" .
     1442                                   v-h[ii] = hh:handle .
     1443                                   ii = ii + 1 .
     1444                                   hh:width-chars = 3 .
     1445                               end.
     1446                           when "b-history" or
     1447                           when "b-hist" then
     1448                               do:
     1449                                   hh:load-image("cmp/b-hist.bmp":u) .
     1450                                   hh:TOOLTIP = "История" .
     1451                                   v-h[ii] = hh:handle .
     1452                                   ii = ii + 1 .
     1453                                   hh:width-chars = 3 .
     1454                               end.
     1455                           when "b-sch" then
     1456                               do:
     1457                                   hh:load-image("cmp/b-sch.bmp":u) .
     1458                                   hh:TOOLTIP = "Установка Фильтра" .
     1459                                   v-h[ii] = hh:handle .
     1460                                   ii = ii + 1 .
     1461                                   hh:width-chars = 3 .
     1462                               end.
     1463                           when "b-hist-user" then
     1464                               do:
     1465                                   hh:load-image("cmp/b-hist.bmp":u) .
     1466                                   hh:TOOLTIP = "История пользователя" .
     1467                                   ii = ii + 1 .
     1468                               end.
     1469                       end case.
     1470                   end.
     1471                   hh = hh:next-sibling.
     1472               end.
     1473               b-help:column = v-frame-width - b-help:width-chars.
     1474               jj = 0.
     1475               repeat ii = 4 to 1 by -1 :
     1476                   if valid-handle (v-h[ii] ) then
     1477                   do:
     1478                       jj  = jj + 1 .
     1479                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1480                       v-h[ii]:row    = v-help-old-y .
     1481                   end.
     1482               end.
     1483           end.
     1484       end.
     1485   end procedure.
     1486   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1487   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1488   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1489   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1490   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1491   define variable v-diasize-current-frame-height as decimal   no-undo .
     1492   define variable v-diasize-change-size          as logical   no-undo .
     1493   define variable v-diasize-resize-button        as handle    no-undo .
     1494   define variable v-diasize-wndmax               as logical   no-undo .
     1495   define variable v-diasize-wndstore             as logical   no-undo .
     1496   define variable v-diasize-proc-name            as character no-undo .
     1497   define variable v-diasize-browse-handle        as handle    no-undo .
     1498   define variable v-diasize-browse-number        as integer   no-undo .
     1499   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1500   define temp-table temp-diasize-handle no-undo
     1501     field handle-value  as handle
     1502     field save-position as decimal
     1503     index xpk is primary unique handle-value
     1504     .
     1505   define temp-table temp-browse-handle no-undo
     1506     field browse-type   as character
     1507     field browse-number as integer
     1508     field browse-handle as handle
     1509     field original-size as decimal
     1510     index xpk is primary unique browse-type browse-number
     1511     index xie browse-type browse-handle
     1512   .
     1513   procedure diasize_change-height :
     1514     define input  parameter p-change-value  as decimal   no-undo .
     1515     define input  parameter p-move-resize   as logical   no-undo .
     1516     define variable v-field-group-handle    as handle    no-undo .
     1517     define variable v-object-handle         as handle    no-undo .
     1518     define variable v-frame-height          as decimal   no-undo .
     1519     define variable v-frame-virtual-height  as decimal   no-undo .
     1520     define variable v-browse-height         as decimal   no-undo .
     1521     define variable v-window-height         as decimal   no-undo .
     1522     define variable v-window-virtual-height as decimal   no-undo .
     1523     define variable v-change-sign           as integer   no-undo .
     1524     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1525     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1526     if p-change-value > 0
     1527     then do:
     1528       if frame Dialog-Frame :height + p-change-value
     1529           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1530       then do:
     1531         assign
     1532           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1533                           - (frame Dialog-Frame :height-chars)
     1534         .
     1535         if p-change-value <= 0
     1536         then do:
     1537           run diasize_position-resize-button in this-procedure .
     1538           return .
     1539         end.
     1540       end.
     1541     end.
     1542     if p-change-value < 0
     1543     then do:
     1544       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1545       then do:
     1546         assign
     1547           p-change-value = v-diasize-orig-frame-height
     1548                          - (frame Dialog-Frame :height-chars)
     1549         .
     1550         if p-change-value >= 0
     1551         then do:
     1552           run diasize_position-resize-button in this-procedure .
     1553           return .
     1554         end.
     1555       end.
     1556     end.
     1557     if p-change-value >= 0
     1558     then do:
     1559       assign
     1560         v-change-sign = 1
     1561       .
     1562     end.
     1563     else do:
     1564       assign
     1565         v-change-sign = -1
     1566       .
     1567     end.
     1568     assign
     1569       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1570     .
     1571     if p-change-value = 0
     1572     then do:
     1573       run diasize_position-resize-button in this-procedure .
     1574       return .
     1575     end.
     1576     move_block:
     1577     do
     1578     on error undo move_block, retry move_block
     1579     :
     1580       if retry
     1581       then do:
     1582         do
     1583         on error undo move_block, leave move_block
     1584         :
     1585           if p-change-value > 0
     1586           then do:
     1587             for each buf_temp-diasize-handle
     1588             on error undo, next
     1589             :
     1590               assign
     1591                 v-object-handle = buf_temp-diasize-handle.handle-value
     1592               .
     1593               if v-object-handle <> v-diasize-resize-button
     1594               then do:
     1595                 assign
     1596                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1597                 .
     1598               end.
     1599             end.
     1600             assign
     1601               v-diasize-browse-handle :height = v-browse-height
     1602             .
     1603             for each buf_temp-browse-handle
     1604               where buf_temp-browse-handle.browse-type = 'height':u
     1605             on error undo, next
     1606             :
     1607               assign
     1608                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1609               .
     1610             end.
     1611             assign
     1612               frame Dialog-Frame :height = v-frame-height
     1613             .
     1614             if frame Dialog-Frame :scrollable = true
     1615             then do:
     1616               assign
     1617                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1618               .
     1619             end.
     1620             run diasize_position-resize-button in this-procedure .
     1621           end.
     1622           else do:
     1623             if frame Dialog-Frame :scrollable = true
     1624             then do:
     1625               assign
     1626                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1627               .
     1628             end.
     1629             assign
     1630               frame Dialog-Frame :height = v-frame-height
     1631             .
     1632             assign
     1633               v-diasize-browse-handle :height = v-browse-height
     1634             .
     1635             for each buf_temp-browse-handle
     1636               where buf_temp-browse-handle.browse-type = 'height':u
     1637             on error undo, next
     1638             :
     1639               assign
     1640                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1641               .
     1642             end.
     1643             for each buf_temp-diasize-handle
     1644             on error undo, next
     1645             :
     1646               assign
     1647                 v-object-handle = buf_temp-diasize-handle.handle-value
     1648               .
     1649               if v-object-handle <> v-diasize-resize-button
     1650               then do:
     1651                 assign
     1652                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1653                 .
     1654               end.
     1655             end.
     1656             run diasize_position-resize-button in this-procedure .
     1657           end.
     1658           assign
     1659             v-diasize-change-size = false
     1660           .
     1661           leave move_block .
     1662         end.
     1663       end.
     1664       assign
     1665         v-diasize-need-full-display = true
     1666       .
     1667       if v-diasize-change-size = false
     1668       then do:
     1669         assign
     1670           v-diasize-change-size = true
     1671         .
     1672       end.
     1673       else do:
     1674         return .
     1675       end.
     1676       assign
     1677         v-frame-height = frame Dialog-Frame :height
     1678         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1679         v-browse-height = v-diasize-browse-handle :height
     1680       .
     1681       for each buf_temp-browse-handle
     1682         where buf_temp-browse-handle.browse-type = 'height':u
     1683       :
     1684         assign
     1685           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1686         .
     1687       end.
     1688       for each buf_temp-diasize-handle
     1689       :
     1690         delete buf_temp-diasize-handle .
     1691       end.
     1692       assign
     1693         v-field-group-handle = frame Dialog-Frame :first-child
     1694       .
     1695       do while valid-handle(v-field-group-handle)
     1696       :
     1697         assign
     1698           v-object-handle = v-field-group-handle :first-child
     1699         .
     1700         do while valid-handle(v-object-handle)
     1701         :
     1702           if  v-object-handle <> v-diasize-browse-handle :handle
     1703           and can-query(v-object-handle, "row")
     1704           and can-query(v-object-handle, "height")
     1705           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1706           then do:
     1707             find first buf_temp-browse-handle
     1708               where buf_temp-browse-handle.browse-type   = 'height':u
     1709                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1710               no-error .
     1711             if available buf_temp-browse-handle
     1712             then do:
     1713             end.
     1714             else do:
     1715               create buf_temp-diasize-handle .
     1716               assign
     1717                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1718                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1719               .
     1720             end.
     1721           end.
     1722           assign
     1723             v-object-handle = v-object-handle :next-sibling
     1724           .
     1725         end.
     1726         assign
     1727           v-field-group-handle = v-field-group-handle :next-sibling
     1728         .
     1729       end.
     1730       do with frame Dialog-Frame
     1731       :
     1732         hide v-diasize-resize-button .
     1733         assign
     1734           v-diasize-resize-button :row    = 1
     1735           v-diasize-resize-button :column = 1
     1736         .
     1737       end.
     1738       if p-change-value > 0
     1739       then do:
     1740         if frame Dialog-Frame :scrollable = true
     1741         then do:
     1742           assign
     1743             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1744             no-error .
     1745           if error-status :error
     1746           or error-status :get-message(1) <> ""
     1747           then do:
     1748             undo move_block, retry move_block .
     1749           end.
     1750         end.
     1751         assign
     1752           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1753           no-error .
     1754         if error-status :error
     1755         or error-status :get-message(1) <> ""
     1756         then do:
     1757           undo move_block, retry move_block .
     1758         end.
     1759         assign
     1760           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1761           no-error .
     1762         if error-status :error
     1763         or error-status :get-message(1) <> ""
     1764         then do:
     1765           undo move_block, retry move_block .
     1766         end.
     1767         for each buf_temp-browse-handle
     1768           where buf_temp-browse-handle.browse-type = 'height':u
     1769         on error undo move_block, retry move_block
     1770         :
     1771           assign
     1772             buf_temp-browse-handle.browse-handle :height
     1773               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1774             no-error .
     1775           if error-status :error
     1776           or error-status :get-message(1) <> ""
     1777           then do:
     1778             undo move_block, retry move_block .
     1779           end.
     1780         end.
     1781         for each buf_temp-diasize-handle
     1782         on error undo move_block, retry move_block
     1783         :
     1784           assign
     1785             v-object-handle = buf_temp-diasize-handle.handle-value
     1786           .
     1787           if v-object-handle <> v-diasize-resize-button
     1788           then do:
     1789             assign
     1790               v-object-handle :row = v-object-handle :row + p-change-value
     1791               no-error .
     1792             if error-status :error
     1793             or error-status :get-message(1) <> ""
     1794             then do:
     1795               undo move_block, retry move_block .
     1796             end.
     1797           end.
     1798         end.
     1799       end.
     1800       else do:
     1801         for each buf_temp-diasize-handle
     1802         on error undo move_block, retry move_block
     1803         :
     1804           assign
     1805             v-object-handle = buf_temp-diasize-handle.handle-value
     1806           .
     1807           if v-object-handle <> v-diasize-resize-button
     1808           then do:
     1809             assign
     1810               v-object-handle :row = v-object-handle :row + p-change-value
     1811               no-error .
     1812             if error-status :error
     1813             or error-status :get-message(1) <> ""
     1814             then do:
     1815               undo move_block, retry move_block .
     1816             end.
     1817           end.
     1818         end.
     1819         assign
     1820           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1821           no-error .
     1822         if error-status :error
     1823         or error-status :get-message(1) <> ""
     1824         then do:
     1825           undo move_block, retry move_block .
     1826         end.
     1827         for each buf_temp-browse-handle
     1828           where buf_temp-browse-handle.browse-type = 'height':u
     1829         on error undo move_block, retry move_block
     1830         :
     1831           assign
     1832             buf_temp-browse-handle.browse-handle :height
     1833               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1834             no-error .
     1835           if error-status :error
     1836           or error-status :get-message(1) <> ""
     1837           then do:
     1838             undo move_block, retry move_block .
     1839           end.
     1840         end.
     1841         assign
     1842           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1843           no-error .
     1844         if error-status :error
     1845         or error-status :get-message(1) <> ""
     1846         then do:
     1847           undo move_block, retry move_block .
     1848         end.
     1849         if frame Dialog-Frame :scrollable = true
     1850         then do:
     1851           assign
     1852             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1853             no-error .
     1854           if error-status :error
     1855           or error-status :get-message(1) <> ""
     1856           then do:
     1857             undo move_block, retry move_block .
     1858           end.
     1859         end.
     1860       end.
     1861       if p-move-resize = true
     1862       then do:
     1863         run diasize_position-resize-button in this-procedure .
     1864       end.
     1865       if v-diasize-wndstore = true
     1866       then do:
     1867         if connected("ub") = true
     1868         then do:
     1869           define variable v-cntxt-db-num        as integer   no-undo .
     1870           define variable v-cntxt-userid        as character no-undo .
     1871           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1872                                             , OUTPUT v-cntxt-userid
     1873                                             ) .
     1874           run gbl/wndsizew.p
     1875             (input  v-cntxt-db-num
     1876             ,input  v-cntxt-userid
     1877             ,input  v-diasize-proc-name
     1878             ,input  'height':u
     1879             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1880             ) .
     1881         end.
     1882       end.
     1883     end.
     1884     assign
     1885       v-diasize-change-size = false
     1886     .
     1887   end procedure.
     1888   procedure diasize_set-height :
     1889     define input  parameter p-new-height  as decimal   no-undo .
     1890     define input  parameter p-move-resize as logical   no-undo .
     1891     do
     1892     on error undo, return error return-value
     1893     :
     1894       run diasize_change-height in this-procedure
     1895         (input  (p-new-height - frame Dialog-Frame :height)
     1896         ,input  p-move-resize
     1897         ) .
     1898     end.
     1899   end procedure.
     1900   procedure diasize_change-width :
     1901     define input  parameter p-change-value as decimal   no-undo .
     1902     define input  parameter p-move-resize  as logical   no-undo .
     1903     define variable v-field-group-handle   as handle    no-undo .
     1904     define variable v-object-handle        as handle    no-undo .
     1905     define variable v-frame-width          as decimal   no-undo .
     1906     define variable v-frame-virtual-width  as decimal   no-undo .
     1907     define variable v-browse-width         as decimal   no-undo .
     1908     define variable v-window-width         as decimal   no-undo .
     1909     define variable v-window-virtual-width as decimal   no-undo .
     1910     define variable v-change-sign          as integer   no-undo .
     1911     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1912     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1913     if p-change-value > 0
     1914     then do:
     1915       if frame Dialog-Frame :width + p-change-value >
     1916           session :width-chars
     1917       then do:
     1918         assign
     1919           p-change-value = session :width-chars - frame Dialog-Frame :width
     1920         .
     1921         if p-change-value <= 0
     1922         then do:
     1923           run diasize_position-resize-button in this-procedure .
     1924           return .
     1925         end.
     1926       end.
     1927     end.
     1928     if p-change-value < 0
     1929     then do:
     1930       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1931       then do:
     1932         assign
     1933           p-change-value = v-diasize-orig-frame-width
     1934                          - frame Dialog-Frame :width
     1935         .
     1936         if p-change-value >= 0
     1937         then do:
     1938           run diasize_position-resize-button in this-procedure .
     1939           return .
     1940         end.
     1941       end.
     1942     end.
     1943     if p-change-value >= 0
     1944     then do:
     1945       assign
     1946         v-change-sign = 1
     1947       .
     1948     end.
     1949     else do:
     1950       assign
     1951         v-change-sign = -1
     1952       .
     1953     end.
     1954     assign
     1955       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1956     .
     1957     if p-change-value = 0
     1958     then do:
     1959       run diasize_position-resize-button in this-procedure .
     1960       return .
     1961     end.
     1962     move_block:
     1963     do
     1964     on error undo move_block, leave move_block
     1965     :
     1966       if retry
     1967       then do:
     1968         do
     1969         on error undo move_block, leave move_block
     1970         :
     1971           if p-change-value > 0
     1972           then do:
     1973             for each buf_temp-diasize-handle
     1974             on error undo, next
     1975             :
     1976               assign
     1977                 v-object-handle = buf_temp-diasize-handle.handle-value
     1978               .
     1979               if v-object-handle <> v-diasize-resize-button
     1980               then do:
     1981                 assign
     1982                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1983                 .
     1984               end.
     1985             end.
     1986             assign
     1987               v-diasize-browse-handle :width = v-browse-width
     1988             .
     1989             for each buf_temp-browse-handle
     1990               where buf_temp-browse-handle.browse-type = 'width':u
     1991             on error undo, next
     1992             :
     1993               assign
     1994                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1995               .
     1996             end.
     1997             assign
     1998               frame Dialog-Frame :width = v-frame-width
     1999             .
     2000             if frame Dialog-Frame :scrollable = true
     2001             then do:
     2002               assign
     2003                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2004               .
     2005             end.
     2006             run diasize_position-resize-button in this-procedure .
     2007           end.
     2008           else do:
     2009             if frame Dialog-Frame :scrollable = true
     2010             then do:
     2011               assign
     2012                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2013               .
     2014             end.
     2015             assign
     2016               frame Dialog-Frame :width = v-frame-width
     2017             .
     2018             for each buf_temp-browse-handle
     2019               where buf_temp-browse-handle.browse-type = 'width':u
     2020             on error undo, next
     2021             :
     2022               assign
     2023                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2024               .
     2025             end.
     2026             assign
     2027               v-diasize-browse-handle :width = v-browse-width
     2028             .
     2029             for each buf_temp-diasize-handle
     2030             on error undo, next
     2031             :
     2032               assign
     2033                 v-object-handle = buf_temp-diasize-handle.handle-value
     2034               .
     2035               if v-object-handle <> v-diasize-resize-button
     2036               then do:
     2037                 assign
     2038                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2039                 .
     2040               end.
     2041             end.
     2042             run diasize_position-resize-button in this-procedure .
     2043           end.
     2044           assign
     2045             v-diasize-change-size = false
     2046           .
     2047           leave move_block .
     2048         end.
     2049       end.
     2050       assign
     2051         v-diasize-need-full-display = true
     2052       .
     2053       if v-diasize-change-size = false
     2054       then do:
     2055         assign
     2056           v-diasize-change-size = true
     2057         .
     2058       end.
     2059       else do:
     2060         return .
     2061       end.
     2062       assign
     2063         v-frame-width = frame Dialog-Frame :width
     2064         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2065         v-browse-width = v-diasize-browse-handle :width
     2066       .
     2067       for each buf_temp-browse-handle
     2068         where buf_temp-browse-handle.browse-type = 'width':u
     2069       :
     2070         assign
     2071           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2072         .
     2073       end.
     2074       for each buf_temp-diasize-handle
     2075       :
     2076         delete buf_temp-diasize-handle .
     2077       end.
     2078       assign
     2079         v-field-group-handle = frame Dialog-Frame :first-child
     2080       .
     2081       do while valid-handle(v-field-group-handle)
     2082       :
     2083         assign
     2084           v-object-handle = v-field-group-handle :first-child
     2085         .
     2086         do while valid-handle(v-object-handle)
     2087         :
     2088           if  v-object-handle <> v-diasize-browse-handle :handle
     2089           and v-object-handle <> v-diasize-resize-button
     2090           and can-query(v-object-handle, "row")
     2091           and can-query(v-object-handle, "height")
     2092           and ( v-object-handle :col + v-object-handle :width
     2093                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2094               )
     2095           then do:
     2096             find first buf_temp-browse-handle
     2097               where buf_temp-browse-handle.browse-type   = 'width':u
     2098                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2099               no-error .
     2100             if available buf_temp-browse-handle
     2101             then do:
     2102             end.
     2103             else do:
     2104               create buf_temp-diasize-handle .
     2105               assign
     2106                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2107                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2108               .
     2109             end.
     2110           end.
     2111           assign
     2112             v-object-handle = v-object-handle :next-sibling
     2113           .
     2114         end.
     2115         assign
     2116           v-field-group-handle = v-field-group-handle :next-sibling
     2117         .
     2118       end.
     2119       do with frame Dialog-Frame
     2120       :
     2121         hide v-diasize-resize-button .
     2122         v-diasize-resize-button :row = 1.
     2123         v-diasize-resize-button :column = 1.
     2124       end.
     2125       if p-change-value > 0
     2126       then do:
     2127         if frame Dialog-Frame :scrollable = true
     2128         then do:
     2129           assign
     2130             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2131             no-error .
     2132           if error-status :error
     2133           or error-status :get-message(1) <> ""
     2134           then do:
     2135             undo move_block, retry move_block.
     2136           end.
     2137         end.
     2138         assign
     2139           frame Dialog-Frame :width = v-frame-width + p-change-value
     2140           no-error .
     2141         if error-status :error
     2142         or error-status :get-message(1) <> ""
     2143         then do:
     2144           undo move_block, retry move_block.
     2145         end.
     2146         assign
     2147           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2148         no-error .
     2149         if error-status :error
     2150         or error-status :get-message(1) <> ""
     2151         then do:
     2152           undo move_block, retry move_block.
     2153         end.
     2154         for each buf_temp-browse-handle
     2155           where buf_temp-browse-handle.browse-type = 'width':u
     2156         on error undo move_block, retry move_block
     2157         :
     2158           assign
     2159             buf_temp-browse-handle.browse-handle :width
     2160               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2161             no-error .
     2162           if error-status :error
     2163           or error-status :get-message(1) <> ""
     2164           then do:
     2165             undo move_block, retry move_block .
     2166           end.
     2167         end.
     2168         for each buf_temp-diasize-handle
     2169         on error undo move_block, retry move_block
     2170         :
     2171           assign
     2172             v-object-handle = buf_temp-diasize-handle.handle-value
     2173           .
     2174           if v-object-handle <> v-diasize-resize-button
     2175           then do:
     2176             assign
     2177               v-object-handle :col = v-object-handle :col + p-change-value
     2178               no-error .
     2179             if error-status :error
     2180             or error-status :get-message(1) <> ""
     2181             then do:
     2182               undo move_block, retry move_block .
     2183             end.
     2184           end.
     2185         end.
     2186       end.
     2187       else do:
     2188         for each buf_temp-diasize-handle
     2189         on error undo move_block, retry move_block
     2190         :
     2191           assign
     2192             v-object-handle = buf_temp-diasize-handle.handle-value
     2193           .
     2194           if v-object-handle <> v-diasize-resize-button
     2195           then do:
     2196             assign
     2197               v-object-handle :col = v-object-handle :col + p-change-value
     2198               no-error .
     2199             if error-status :error
     2200             or error-status :get-message(1) <> ""
     2201             then do:
     2202               undo move_block, retry move_block .
     2203             end.
     2204           end.
     2205         end.
     2206         for each buf_temp-browse-handle
     2207           where buf_temp-browse-handle.browse-type = 'width':u
     2208         on error undo move_block, retry move_block
     2209         :
     2210           assign
     2211             buf_temp-browse-handle.browse-handle :width
     2212               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2213             no-error .
     2214           if error-status :error
     2215           or error-status :get-message(1) <> ""
     2216           then do:
     2217             undo move_block, retry move_block .
     2218           end.
     2219         end.
     2220         assign
     2221           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2222           no-error .
     2223         if error-status :error
     2224         or error-status :get-message(1) <> ""
     2225         then do:
     2226           undo move_block, retry move_block.
     2227         end.
     2228         assign
     2229           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2230         no-error .
     2231         if error-status :error
     2232         or error-status :get-message(1) <> ""
     2233         then do:
     2234           undo move_block, retry move_block.
     2235         end.
     2236         if frame Dialog-Frame :scrollable = true
     2237         then do:
     2238           assign
     2239             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2240           no-error .
     2241           if error-status :error
     2242           or error-status :get-message(1) <> ""
     2243           then do:
     2244             undo move_block, retry move_block.
     2245           end.
     2246         end.
     2247       end.
     2248       if p-move-resize
     2249       then do:
     2250         run diasize_position-resize-button in this-procedure .
     2251       end.
     2252       if v-diasize-wndstore = true
     2253       then do:
     2254         if connected("ub") = true
     2255         then do:
     2256           define variable v-cntxt-db-num        as integer   no-undo .
     2257           define variable v-cntxt-userid        as character no-undo .
     2258           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2259                                             , OUTPUT v-cntxt-userid
     2260                                             ) .
     2261           run gbl/wndsizew.p
     2262             (input  v-cntxt-db-num
     2263             ,input  v-cntxt-userid
     2264             ,input  v-diasize-proc-name
     2265             ,input  'width':u
     2266             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2267             ) .
     2268         end.
     2269       end.
     2270     end.
     2271     assign
     2272       v-diasize-change-size = false
     2273     .
     2274   end procedure.
     2275   procedure diasize_set-width :
     2276     define input  parameter p-new-width  as decimal   no-undo .
     2277     define input  parameter p-move-resize as logical   no-undo .
     2278     do
     2279     on error undo, return error return-value
     2280     :
     2281       run diasize_change-width in this-procedure
     2282         (input  (p-new-width - frame Dialog-Frame :width)
     2283         ,input  p-move-resize
     2284         ) .
     2285     end.
     2286   end procedure.
     2287   procedure diasize_position-resize-button :
     2288     do with frame Dialog-Frame
     2289     :
     2290       hide v-diasize-resize-button .
     2291       assign
     2292         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2293                     - 1
     2294                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2295         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2296                     - 1
     2297                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2298       .
     2299       view v-diasize-resize-button .
     2300     end.
     2301   end procedure.
     2302   on alt-right anywhere
     2303   do:
     2304     run diasize_change-width in this-procedure
     2305       (input 1
     2306       ,input true
     2307       ) .
     2308     return no-apply .
     2309   end.
     2310   on alt-left anywhere
     2311   do:
     2312     run diasize_change-width in this-procedure
     2313       (input -1
     2314       ,input true
     2315       ) .
     2316     return no-apply .
     2317   end.
     2318   on alt-down anywhere
     2319   do:
     2320     run diasize_change-height in this-procedure
     2321       (input 1
     2322       ,input true
     2323       ) .
     2324     return no-apply .
     2325   end.
     2326   on alt-up anywhere
     2327   do:
     2328     run diasize_change-height in this-procedure
     2329       (input -1
     2330       ,input true
     2331       ) .
     2332     return no-apply .
     2333   end.
     2334   on alt-enter of frame Dialog-Frame
     2335   do:
     2336     run diasize_maximize in this-procedure
     2337       (input  ?
     2338       ).
     2339     return no-apply .
     2340   end.
     2341   procedure diasize_end-move :
     2342     do
     2343     on error undo, return error return-value
     2344     :
     2345       define variable v-row-delta as decimal   no-undo .
     2346       define variable v-col-delta as decimal   no-undo .
     2347       define variable v-new-row as decimal   no-undo .
     2348       define variable v-new-col as decimal   no-undo .
     2349       assign
     2350         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2351         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2352       .
     2353       assign
     2354         v-row-delta = v-new-row - frame Dialog-Frame :height
     2355         v-col-delta = v-new-col - frame Dialog-Frame :width
     2356       .
     2357       run diasize_change-height in this-procedure
     2358         (input v-row-delta
     2359         ,input true
     2360         ) .
     2361       run diasize_change-width in this-procedure
     2362         (input v-col-delta
     2363         ,input true
     2364         ) .
     2365     end.
     2366   end procedure.
     2367   procedure diasize_maximize :
     2368     define input  parameter p-action as logical   no-undo .
     2369     do
     2370     on error undo, return error return-value
     2371     :
     2372       if p-action = ?
     2373       then do:
     2374         if v-diasize-need-maximize = true
     2375         then do:
     2376           assign
     2377             p-action = true
     2378           .
     2379         end.
     2380         else do:
     2381           assign
     2382             p-action = false
     2383           .
     2384         end.
     2385       end.
     2386       if p-action = true
     2387       then do:
     2388         run diasize_change-height in this-procedure
     2389           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2390               - frame Dialog-Frame :height-chars
     2391           ,input true
     2392           ) .
     2393         run diasize_change-width in this-procedure
     2394           (input session :width-chars
     2395               - frame Dialog-Frame :width-chars
     2396           ,input true
     2397           ) .
     2398         assign
     2399           v-diasize-need-maximize = false
     2400         .
     2401       end.
     2402       else do:
     2403         run diasize_change-width in this-procedure
     2404           (input v-diasize-orig-frame-width
     2405               - frame Dialog-Frame :width-chars
     2406           ,input true
     2407           ) .
     2408         run diasize_change-height in this-procedure
     2409           (input v-diasize-orig-frame-height
     2410               - frame Dialog-Frame :height-chars
     2411           ,input true
     2412           ) .
     2413         assign
     2414           v-diasize-need-maximize = true
     2415         .
     2416       end.
     2417     end.
     2418   end procedure.
     2419   procedure diasize_restore-orig-size :
     2420     do
     2421     on error undo, return error return-value
     2422     :
     2423       assign
     2424         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2425         v-diasize-current-frame-height = frame Dialog-Frame :height
     2426       .
     2427       run diasize_set-height in this-procedure
     2428         (input  v-diasize-orig-frame-height
     2429         ,input  true
     2430         ) .
     2431       run diasize_set-width in this-procedure
     2432         (input  v-diasize-orig-frame-width
     2433         ,input  true
     2434         ) .
     2435     end.
     2436   end procedure.
     2437   procedure diasize_restore-current-size :
     2438     do
     2439     on error undo, return error return-value
     2440     :
     2441       run diasize_set-height in this-procedure
     2442         (input  v-diasize-current-frame-height
     2443         ,input  true
     2444         ) .
     2445       run diasize_set-width in this-procedure
     2446         (input  v-diasize-current-frame-width
     2447         ,input  true
     2448         ) .
     2449     end.
     2450   end procedure.
     2451   procedure diasize_set-browse-handle :
     2452     define input  parameter p-browse-handle as handle   no-undo .
     2453     define buffer buf_temp-browse-handle for temp-browse-handle .
     2454     do
     2455     on error undo, return error return-value
     2456     :
     2457       assign
     2458         v-diasize-browse-handle = p-browse-handle
     2459       .
     2460       for each buf_temp-browse-handle
     2461       on error undo, return error return-value
     2462       :
     2463         delete buf_temp-browse-handle .
     2464       end.
     2465     end.
     2466   end procedure.
     2467   procedure diasize_add_browse :
     2468     define input  parameter p-browse-type   as character no-undo .
     2469     define input  parameter p-browse-handle as handle    no-undo .
     2470     define buffer buf_temp-browse-handle for temp-browse-handle .
     2471     do
     2472     on error undo, return error return-value
     2473     :
     2474       assign
     2475         v-diasize-browse-number = v-diasize-browse-number + 1
     2476       .
     2477       create buf_temp-browse-handle .
     2478       assign
     2479         buf_temp-browse-handle.browse-type   = p-browse-type
     2480         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2481         buf_temp-browse-handle.browse-handle = p-browse-handle
     2482       .
     2483     end.
     2484   end procedure.
     2485   procedure diasize_init :
     2486     define variable v-default-value    as logical   no-undo .
     2487     define variable v-restore-saved    as logical   no-undo .
     2488     define variable v-resize-value-str as character no-undo .
     2489     do
     2490     on error undo, return error return-value
     2491     :
     2492       do with frame Dialog-Frame
     2493       :
     2494         assign
     2495           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2496           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2497           v-diasize-browse-handle     = browse BR-rcp :handle
     2498         .
     2499         create button v-diasize-resize-button
     2500         assign
     2501           parent        = frame Dialog-Frame :first-child
     2502           label         = "s"
     2503           height-pixels = 16
     2504           width-pixels  = 16
     2505           visible       = true
     2506           sensitive     = true
     2507           movable       = true
     2508           triggers:
     2509             on end-move persistent run diasize_end-move in this-procedure .
     2510           end triggers.
     2511         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2512         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2513         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2514         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2515         assign
     2516           v-diasize-wndmax = false
     2517         .
     2518         if connected("ub") = true
     2519         then do:
     2520           define variable v-cntxt-db-num        as integer   no-undo .
     2521           define variable v-cntxt-userid        as character no-undo .
     2522           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2523                                             , OUTPUT v-cntxt-userid
     2524                                             ) .
     2525           run gbl/wndpar_r.p
     2526             (input  v-cntxt-db-num
     2527             ,input  v-cntxt-userid
     2528             ,input  'wndmax':U
     2529             ,output v-diasize-wndmax
     2530             ,output v-default-value
     2531             ) .
     2532         end.
     2533         assign
     2534           v-diasize-wndstore = false
     2535         .
     2536         if connected("ub") = true
     2537         then do:
     2538           run gbl/wndpar_r.p
     2539             (input  v-cntxt-db-num
     2540             ,input  v-cntxt-userid
     2541             ,input  'wndstore':U
     2542             ,output v-diasize-wndstore
     2543             ,output v-default-value
     2544             ) .
     2545         end.
     2546         assign
     2547           v-diasize-proc-name = entry(1, program-name(2), '.')
     2548         .
     2549         if v-diasize-wndstore = true
     2550         then do:
     2551           assign
     2552             v-restore-saved = false
     2553           .
     2554           if connected("ub") = true
     2555           then do:
     2556             run gbl/wndsizer.p
     2557               (input  v-cntxt-db-num
     2558               ,input  v-cntxt-userid
     2559               ,input  v-diasize-proc-name
     2560               ,input  'height':u
     2561               ,output v-resize-value-str
     2562               ) .
     2563             if v-resize-value-str <> '':U
     2564             then do:
     2565               run diasize_change-height in this-procedure
     2566                 (input  integer(v-resize-value-str)
     2567                 ,input  true
     2568                 ) .
     2569               assign
     2570                 v-restore-saved = true
     2571               .
     2572             end.
     2573           end.
     2574           if connected("ub") = true
     2575           then do:
     2576             run gbl/wndsizer.p
     2577               (input  v-cntxt-db-num
     2578               ,input  v-cntxt-userid
     2579               ,input  v-diasize-proc-name
     2580               ,input  'width':u
     2581               ,output v-resize-value-str
     2582               ) .
     2583             if v-resize-value-str <> '':U
     2584             then do:
     2585               run diasize_change-width in this-procedure
     2586                 (input  integer(v-resize-value-str)
     2587                 ,input  true
     2588                 ) .
     2589               assign
     2590                 v-restore-saved = true
     2591               .
     2592             end.
     2593           end.
     2594           if v-restore-saved <> true
     2595           then do:
     2596             if v-diasize-wndmax = true
     2597             then do:
     2598               run diasize_maximize in this-procedure
     2599                 (input  true
     2600                 ) .
     2601             end.
     2602           end.
     2603         end.
     2604         else do:
     2605           if v-diasize-wndmax = true
     2606           then do:
     2607             run diasize_maximize in this-procedure
     2608               (input  true
     2609               ) .
     2610           end.
     2611         end.
     2612       end.
     2613     end.
     2614   end procedure.
     2615   procedure diasize_need-full-display :
     2616     define output parameter p-need-full-display as logical   no-undo .
     2617     do
     2618     on error undo, return error return-value
     2619     :
     2620       assign
     2621         p-need-full-display = v-diasize-need-full-display
     2622       .
     2623       assign
     2624         v-diasize-need-full-display = false
     2625       .
     2626     end.
     2627   end procedure.
     2628   procedure get-context :
     2629      define output parameter p-db-num as integer          no-undo.
     2630      define output parameter p-user-id as character        no-undo.
     2631      define variable v-login               as character    no-undo.
     2632      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2633      define buffer buf_user-login  for ub.user-login .
     2634      do
     2635      on error undo, return error
     2636      :
     2637            FIND FIRST buf_sys-ctrl no-lock.
     2638            ASSIGN
     2639               v-login = USERID("ub")
     2640               p-db-num = buf_sys-ctrl.db-num
     2641            .
     2642            FIND FIRST buf_user-login
     2643                 WHERE buf_user-login.db-num = p-db-num
     2644                   AND buf_user-login.user-login = v-login
     2645                 no-lock
     2646                 no-error
     2647                 .
     2648            IF AVAILABLE buf_user-login
     2649            THEN DO:
     2650               assign
     2651                  p-user-id = buf_user-login.user-id
     2652               .
     2653            END.
     2654      end.
     2655   end procedure.
     2656       run diasize_init in this-procedure .
     2657   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2658   procedure rcps_get-profile-id :
     2659   define output parameter p-local-profile-id as integer no-undo .
     2660   do
     2661   on error undo, return error:
     2662   p-local-profile-id = p-profile-id.
     2663   end.
     2664   end procedure.
     2665   PROCEDURE rcps_fill-table :
     2666   define input parameter p-clear-params as logical no-undo .
     2667   if p-clear-params then do:
     2668   FOR EACH tt-rule-call-param:
     2669       DELETE tt-rule-call-param.
     2670   END.
     2671   end.
     2672    FOR EACH tt0-rule-call-param:
     2673      IF p-mode <> 'ДОБАВЛЕНИЕ':U THEN DO:
     2674        IF p-call-id <> '':U and p-call-id <> tt0-rule-call-param.call_id THEN do:
     2675           NEXT.
     2676        end.
     2677        IF p-codex-id <> 0 and p-codex-id <> tt0-rule-call-param.codex_id THEN do:
     2678          NEXT.
     2679        end.
     2680        IF p-ruleset-id <> 0 and p-ruleset-id <> tt0-rule-call-param.ruleset_id THEN do:
     2681          NEXT.
     2682        end.
     2683        IF p-rule-id <> 0 and p-rule-id <> tt0-rule-call-param.RULE_id THEN do:
     2684          NEXT.
     2685        end.
     2686        IF p-order-id <> ? and p-order-id <> tt0-rule-call-param.order_id THEN do:
     2687          NEXT.
     2688        end.
     2689      END.
     2690      if lookup("hidden", tt0-rule-call-param.param-3-data-type) > 0 then do:
     2691        next.
     2692      end.
     2693      IF p-list-mode = 'rp-rule-param':U
     2694      or p-list-mode = 'rp-rule-param':U  + chr(44) + 'все':U
     2695      THEN DO:
     2696         IF p-profile-id <> 0 AND p-profile-id <> tt0-rule-call-param.profile_id THEN do:
     2697           NEXT.
     2698         end.
     2699         IF p-once-more <> ? AND p-once-more <> tt0-rule-call-param.once-more THEN do:
     2700           NEXT.
     2701         end.
     2702      END.
     2703      CREATE tt-rule-call-param.
     2704      BUFFER-COPY tt0-rule-call-param TO tt-rule-call-param.
     2705   END.
     2706   END PROCEDURE.
     2707   procedure rcps_get-value :
     2708   DEFINE INPUT PARAMETER p-profile-id AS integer NO-UNDO.
     2709   DEFINE INPUT PARAMETER p-once-more AS integer NO-UNDO.
     2710   DEFINE INPUT PARAMETER p-call-id AS CHARACTER NO-UNDO.
     2711   DEFINE INPUT PARAMETER p-rp-param-name AS CHARACTER NO-UNDO.
     2712   DEFINE INPUT-output PARAMETER pp-index AS integer NO-UNDO.
     2713   DEFINE output parameter p-value-character AS CHARACTER NO-UNDO.
     2714   DEFINE output parameter p-value-date AS date NO-UNDO.
     2715   DEFINE output parameter p-value-decimal AS decimal NO-UNDO.
     2716   DEFINE output parameter p-value-integer AS integer NO-UNDO.
     2717   DEFINE output parameter p-value-logical AS logical NO-UNDO.
     2718   define variable v-current-index as integer no-undo init -1.
     2719   define variable v-start as logical no-undo init yes.
     2720   DEFINE BUFFER buf_ruledict-param FOR ub.ruledict-param.
     2721   DEFINE BUFFER buf_rp-rule-param FOR ub.rp-rule-param.
     2722   DEFINE BUFFER buf_tt-rule-call-param FOR tt-rule-call-param.
     2723   DEFINE BUFFER buf_term_tt-rule-call-param FOR tt-rule-call-param.
     2724   do
     2725   on error undo, return error
     2726   :
     2727   FOR FIRST buf_rp-rule-param WHERE
     2728         buf_rp-rule-param.profile_id = p-profile-id
     2729     AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     2730   , each buf_tt-rule-call-param WHERE
     2731      buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     2732   AND buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     2733   AND buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     2734   AND buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     2735   AND buf_tt-rule-call-param.p-index >= pp-index
     2736    ,each buf_term_tt-rule-call-param where
     2737          buf_term_tt-rule-call-param.call_id = buf_tt-rule-call-param.call_id
     2738      and buf_term_tt-rule-call-param.codex_id = buf_tt-rule-call-param.codex_id
     2739      and buf_term_tt-rule-call-param.ruleset_id = buf_tt-rule-call-param.ruleset_id
     2740      and buf_term_tt-rule-call-param.order_id = buf_tt-rule-call-param.order_id
     2741      and buf_term_tt-rule-call-param.param-name = buf_tt-rule-call-param.param-name
     2742      and buf_term_tt-rule-call-param.p-index = buf_tt-rule-call-param.p-index
     2743     by buf_term_tt-rule-call-param.call_id
     2744     by buf_term_tt-rule-call-param.codex_id
     2745     by buf_term_tt-rule-call-param.ruleset_id
     2746     by buf_term_tt-rule-call-param.order_id
     2747     by buf_term_tt-rule-call-param.param-name
     2748     by buf_term_tt-rule-call-param.p-index :
     2749       if v-start
     2750       then do:
     2751         assign
     2752         pp-index = buf_term_tt-rule-call-param.p-index
     2753         p-value-character = buf_term_tt-rule-call-param.param-value-character
     2754         p-value-date      = buf_term_tt-rule-call-param.param-value-date
     2755         p-value-decimal   = buf_term_tt-rule-call-param.param-value-decimal
     2756         p-value-integer   = buf_term_tt-rule-call-param.param-value-integer
     2757         p-value-logical   = buf_term_tt-rule-call-param.param-value-logical
     2758         v-start = no
     2759         .
     2760       end.
     2761       else do:
     2762         if buf_term_tt-rule-call-param.p-index > pp-index then do:
     2763           v-current-index = buf_term_tt-rule-call-param.p-index.
     2764           leave.
     2765         end.
     2766             end.
     2767     end.
     2768     pp-index = v-current-index.
     2769   end.
     2770   end procedure.
     2771   PROCEDURE rcps_proc-b-add :
     2772   DEFINE INPUT PARAMETER p-profile-id AS integer NO-UNDO.
     2773   DEFINE INPUT PARAMETER p-once-more AS integer NO-UNDO.
     2774   DEFINE INPUT PARAMETER p-call-id AS CHARACTER NO-UNDO.
     2775   DEFINE INPUT PARAMETER p-rp-param-name AS CHARACTER NO-UNDO.
     2776   DEFINE INPUT PARAMETER p-index AS integer NO-UNDO.
     2777   define variable v-ind as integer no-undo .
     2778   define buffer buf_tt-rule-call-param for tt-rule-call-param.
     2779   define buffer buf0_tt-rule-call-param for tt-rule-call-param.
     2780   define buffer buf2_tt-rule-call-param for tt-rule-call-param.
     2781   define buffer buf_rp-rule-param for ub.rp-rule-param.
     2782   FOR FIRST buf_rp-rule-param WHERE
     2783             buf_rp-rule-param.profile_id = p-profile-id
     2784         AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     2785       , first buf0_tt-rule-call-param WHERE
     2786          buf0_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     2787      AND buf0_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     2788      AND buf0_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     2789      AND buf0_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name:
     2790     LEAVE.
     2791   END.
     2792   IF NOT AVAILABLE buf0_tt-rule-call-param THEN do:
     2793     BELL.
     2794     RETURN.
     2795   END.
     2796   for each buf_rp-rule-param where
     2797           buf_rp-rule-param.rp-param-name = p-rp-param-name
     2798       and buf_rp-rule-param.profile_id = p-profile-id,
     2799       first buf_tt-rule-call-param where
     2800           buf_tt-rule-call-param.call_id = buf0_tt-rule-call-param.call_id
     2801       and buf_tt-rule-call-param.profile_id = buf_rp-rule-param.profile_id
     2802       and buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     2803       and buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     2804       and buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     2805       and buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     2806       and buf_tt-rule-call-param.once-more = buf0_tt-rule-call-param.once-more
     2807       and buf_tt-rule-call-param.p-index = p-index:
     2808     RETURN.
     2809   END.
     2810   IF lookup("LIST", buf0_tt-rule-call-param.param-3-data-type) = 0
     2811   and lookup("SORTED-LIST", buf0_tt-rule-call-param.param-3-data-type) = 0
     2812   THEN DO:
     2813     BELL.
     2814     RETURN.
     2815   END.
     2816   IF buf0_tt-rule-call-param.p-index <> 0 THEN DO:
     2817     BELL.
     2818     RETURN.
     2819   END.
     2820   find last buf_tt-rule-call-param where
     2821            buf_tt-rule-call-param.call_id = buf0_tt-rule-call-param.call_id
     2822        and buf_tt-rule-call-param.codex_id = buf0_tt-rule-call-param.codex_id
     2823        and buf_tt-rule-call-param.ruleset_id = buf0_tt-rule-call-param.ruleset_id
     2824        and buf_tt-rule-call-param.order_id = buf0_tt-rule-call-param.order_id
     2825        and buf_tt-rule-call-param.param-name = buf0_tt-rule-call-param.param-name no-error .
     2826   if available buf_tt-rule-call-param
     2827   and (lookup("LIST", buf_tt-rule-call-param.param-3-data-type) > 0
     2828        or
     2829        lookup("SORTED-LIST", buf_tt-rule-call-param.param-3-data-type) > 0
     2830        )
     2831   and buf_tt-rule-call-param.p-index > 0 then do:
     2832     v-ind = buf_tt-rule-call-param.p-index.
     2833   end.
     2834   for each buf_rp-rule-param where
     2835           buf_rp-rule-param.rp-param-name = p-rp-param-name
     2836       and buf_rp-rule-param.profile_id = p-profile-id,
     2837       first buf_tt-rule-call-param where
     2838           buf_tt-rule-call-param.call_id = buf0_tt-rule-call-param.call_id
     2839       and buf_tt-rule-call-param.profile_id = buf_rp-rule-param.profile_id
     2840       and buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     2841       and buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     2842       and buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     2843       and buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     2844       and buf_tt-rule-call-param.once-more = buf0_tt-rule-call-param.once-more
     2845       and buf_tt-rule-call-param.p-index = 0
     2846   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2847   on stop   undo, return error substitute( "&1. stop", vss-workfile )
     2848   on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     2849   :
     2850     create buf2_tt-rule-call-param.
     2851     buffer-copy buf_tt-rule-call-param
     2852     except p-index
     2853     to buf2_tt-rule-call-param
     2854     assign
     2855     buf2_tt-rule-call-param.p-index = v-ind + 1
     2856     .
     2857   end.
     2858   END PROCEDURE.
     2859   PROCEDURE rcps_proc-b-del :
     2860   DEFINE INPUT PARAMETER p-profile-id AS integer NO-UNDO.
     2861   DEFINE INPUT PARAMETER p-once-more AS integer NO-UNDO.
     2862   DEFINE INPUT PARAMETER p-call-id AS CHARACTER NO-UNDO.
     2863   DEFINE INPUT PARAMETER p-rp-param-name AS CHARACTER NO-UNDO.
     2864   DEFINE INPUT PARAMETER pp-index AS integer NO-UNDO.
     2865   define variable v-ind as integer no-undo .
     2866   define variable v-once-more as integer no-undo .
     2867   define variable v-call-id as character no-undo .
     2868   define buffer buf0_tt-rule-call-param for tt-rule-call-param.
     2869   define buffer buf_tt-rule-call-param for tt-rule-call-param.
     2870   define buffer buf_rp-rule-param for ub.rp-rule-param.
     2871   if pp-index = 0 then do:
     2872     undo, return error substitute("Нельзя удалять корневой параметр &1 (индекс = 0)", p-rp-param-name).
     2873   end.
     2874   FOR first buf_rp-rule-param WHERE
     2875             buf_rp-rule-param.profile_id = p-profile-id
     2876         AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     2877       , first buf0_tt-rule-call-param WHERE
     2878          buf0_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     2879      AND buf0_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     2880      AND buf0_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     2881      AND buf0_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     2882      AND buf0_tt-rule-call-param.p-index = pp-index
     2883      :
     2884     LEAVE.
     2885   END.
     2886   IF NOT AVAILABLE buf0_tt-rule-call-param THEN do:
     2887     FOR first buf_rp-rule-param WHERE
     2888               buf_rp-rule-param.profile_id = p-profile-id
     2889           AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     2890         , last buf0_tt-rule-call-param WHERE
     2891           buf0_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     2892       AND buf0_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     2893       AND buf0_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     2894       AND buf0_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     2895       AND buf0_tt-rule-call-param.p-index > pp-index :
     2896       leave.
     2897     end.
     2898     IF NOT AVAILABLE buf0_tt-rule-call-param THEN do:
     2899     return "not-found".
     2900     end.
     2901     else do:
     2902       return ''.
     2903     end.
     2904   END.
     2905   IF lookup("LIST", buf0_tt-rule-call-param.param-3-data-type) = 0
     2906   and lookup("SORTED-LIST", buf0_tt-rule-call-param.param-3-data-type) = 0
     2907   THEN DO:
     2908     undo, return error substitute("Можно удалять только параметры типа LIST и SORTED-LIST").
     2909   END.
     2910   IF lookup("READ-ONLY", buf0_tt-rule-call-param.param-3-data-type) > 0 THEN DO:
     2911     undo, return error substitute("Нельзя удалять  параметры типа READ-ONLY").
     2912   END.
     2913   for each buf_rp-rule-param where
     2914           buf_rp-rule-param.rp-param-name = buf_rp-rule-param.rp-param-name
     2915       and buf_rp-rule-param.profile_id = buf_rp-rule-param.profile_id,
     2916       each buf_tt-rule-call-param where
     2917           buf_tt-rule-call-param.call_id = p-call-id
     2918       and buf_tt-rule-call-param.profile_id = buf_rp-rule-param.profile_id
     2919       and buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     2920       and buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     2921       and buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     2922       and buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     2923       and buf_tt-rule-call-param.once-more = p-once-more
     2924       and buf_tt-rule-call-param.p-index = pp-index
     2925   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2926   on stop   undo, return error substitute( "&1. stop", vss-workfile )
     2927   on endkey undo, return error substitute( "&1. endkey", vss-workfile ):
     2928       DELETE buf_tt-rule-call-param.
     2929   end.
     2930   return ''.
     2931   END PROCEDURE.
     2932   PROCEDURE rcps_proc-save0 :
     2933   FOR EACH tt-rule-call-param
     2934   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2935   on stop   undo , return error substitute( "&1. stop", vss-workfile )
     2936   on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     2937   :
     2938      find  FIRST tt0-rule-call-param NO-LOCK WHERE
     2939               tt0-rule-call-param.codex_id = tt-rule-call-param.codex_id
     2940          AND  tt0-rule-call-param.ruleset_id = tt-rule-call-param.ruleset_id
     2941          AND tt0-rule-call-param.call_id = tt-rule-call-param.call_id
     2942          AND tt0-rule-call-param.order_id = tt-rule-call-param.order_id
     2943          AND tt0-rule-call-param.param-name = tt-rule-call-param.param-name
     2944          AND tt0-rule-call-param.p-index = tt-rule-call-param.p-index no-error .
     2945      if not available tt0-rule-call-param
     2946      and (lookup("LIST", tt-rule-call-param.param-3-data-type) > 0
     2947           OR
     2948           lookup("SORTED-LIST", tt-rule-call-param.param-3-data-type) > 0
     2949           )
     2950      and tt-rule-call-param.p-index > 0 then do:
     2951        create tt0-rule-call-param.
     2952      end.
     2953      BUFFER-COPY tt-rule-call-param TO tt0-rule-call-param.
     2954   END.
     2955   FOR EACH tt0-rule-call-param
     2956   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2957   on stop   undo , return error substitute( "&1. stop", vss-workfile )
     2958   on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     2959   :
     2960     if tt0-rule-call-param.p-index = 0 then next.
     2961     if lookup("hidden", tt0-rule-call-param.param-3-data-type) > 0 then next.
     2962     find  FIRST tt-rule-call-param NO-LOCK WHERE
     2963             tt-rule-call-param.codex_id = tt0-rule-call-param.codex_id
     2964         AND tt-rule-call-param.ruleset_id = tt0-rule-call-param.ruleset_id
     2965         AND tt-rule-call-param.call_id = tt0-rule-call-param.call_id
     2966         AND tt-rule-call-param.order_id = tt0-rule-call-param.order_id
     2967         AND tt-rule-call-param.param-name = tt0-rule-call-param.param-name
     2968         AND tt-rule-call-param.p-index = tt0-rule-call-param.p-index no-error .
     2969     if not available tt-rule-call-param
     2970     and (lookup("LIST", tt0-rule-call-param.param-3-data-type) > 0
     2971         OR
     2972         lookup("SORTED-LIST", tt0-rule-call-param.param-3-data-type) > 0
     2973         )
     2974     and tt0-rule-call-param.p-index > 0
     2975     then do:
     2976        IF p-call-id <> '':U and p-call-id <> tt0-rule-call-param.call_id THEN do:
     2977           NEXT.
     2978        end.
     2979        IF p-codex-id <> 0 and p-codex-id <> tt0-rule-call-param.codex_id THEN do:
     2980          NEXT.
     2981        end.
     2982        IF p-ruleset-id <> 0 and p-ruleset-id <> tt0-rule-call-param.ruleset_id THEN do:
     2983          NEXT.
     2984        end.
     2985        IF p-rule-id <> 0 and p-rule-id <> tt0-rule-call-param.RULE_id THEN do:
     2986          NEXT.
     2987        end.
     2988        IF p-order-id <> ? and p-order-id <> tt0-rule-call-param.order_id THEN do:
     2989          NEXT.
     2990        end.
     2991       IF p-list-mode = 'rp-rule-param':U
     2992       or p-list-mode = 'rp-rule-param':U  + chr(44) + 'все':U
     2993       THEN DO:
     2994         IF p-profile-id <> 0 AND p-profile-id <> tt0-rule-call-param.profile_id THEN do:
     2995           NEXT.
     2996         end.
     2997         IF p-once-more <> ? AND p-once-more <> tt0-rule-call-param.once-more THEN do:
     2998           NEXT.
     2999         end.
     3000       end.
     3001       delete tt0-rule-call-param.
     3002     end.
     3003   end.
     3004   END PROCEDURE.
     3005   PROCEDURE rcps_set-value :
     3006   DEFINE INPUT PARAMETER p-profile-id AS integer NO-UNDO.
     3007   DEFINE INPUT PARAMETER p-once-more AS integer NO-UNDO.
     3008   DEFINE INPUT PARAMETER p-call-id AS CHARACTER NO-UNDO.
     3009   DEFINE INPUT PARAMETER p-rp-param-name AS CHARACTER NO-UNDO.
     3010   DEFINE INPUT PARAMETER pp-index AS integer NO-UNDO.
     3011   DEFINE INPUT parameter p-value-character AS CHARACTER NO-UNDO.
     3012   DEFINE INPUT parameter p-value-date AS date NO-UNDO.
     3013   DEFINE INPUT parameter p-value-decimal AS decimal NO-UNDO.
     3014   DEFINE INPUT parameter p-value-integer AS integer NO-UNDO.
     3015   DEFINE INPUT parameter p-value-logical AS logical NO-UNDO.
     3016   DEFINE VARIABLE v-codex-id AS integer NO-UNDO.
     3017   DEFINE VARIABLE v-ruleset-id AS integer NO-UNDO.
     3018   DEFINE VARIABLE v-order-id AS integer NO-UNDO.
     3019   DEFINE VARIABLE V-param-name AS character NO-UNDO.
     3020   define variable v-found as logical no-undo .
     3021   DEFINE BUFFER buf_tt-rule-call-param FOR tt-rule-call-param.
     3022   DEFINE BUFFER buf_rp-rule-param FOR ub.rp-rule-param.
     3023   FOR FIRST buf_rp-rule-param WHERE
     3024             buf_rp-rule-param.profile_id = p-profile-id
     3025         AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     3026       , first buf_tt-rule-call-param WHERE
     3027          buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3028      AND buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3029      AND buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3030      AND buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name:
     3031     ASSIGN
     3032     v-codex-id = buf_tt-rule-call-param.codex_id
     3033     v-ruleset-id = buf_tt-rule-call-param.ruleset_id
     3034     v-order-id = buf_tt-rule-call-param.order_id
     3035     V-PARAM-NAME = buf_tt-rule-call-param.PARAM-NAME
     3036     .
     3037     LEAVE.
     3038   END.
     3039   CASE p-list-mode:
     3040     WHEN 'rp-rule-param':U THEN DO:
     3041       if pp-index > 0
     3042       then do:
     3043         FOR EACH  buf_rp-rule-param NO-LOCK where
     3044             buf_rp-rule-param.profile_id = p-profile-id
     3045             AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     3046             ,EACH buf_tt-rule-call-param WHERE
     3047                 buf_tt-rule-call-param.profile_id = p-profile-id
     3048             AND buf_tt-rule-call-param.once-more = p-once-more
     3049             AND buf_tt-rule-call-param.call_id = p-CALL-id
     3050             AND buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3051             AND buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3052             AND buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3053             AND buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     3054             AND buf_tt-rule-call-param.p-index = pp-index
     3055         ON error undo, return error :
     3056           v-found = yes.
     3057         end.
     3058       end.
     3059       if not v-found then do:
     3060         run rcps_proc-b-add in this-procedure (
     3061                                                  input p-profile-id
     3062                                                 ,input p-once-more
     3063                                                 ,input p-call-id
     3064                                                 ,
     3065                                                  input p-rp-param-name
     3066                                                 ,input pp-index).
     3067       end.
     3068       FOR EACH  buf_rp-rule-param NO-LOCK where
     3069           buf_rp-rule-param.profile_id = p-profile-id
     3070           AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     3071           ,EACH buf_tt-rule-call-param WHERE
     3072               buf_tt-rule-call-param.profile_id = p-profile-id
     3073           AND buf_tt-rule-call-param.once-more = p-once-more
     3074           AND buf_tt-rule-call-param.call_id = p-CALL-id
     3075           AND buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3076           AND buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3077           AND buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3078           AND buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     3079           AND buf_tt-rule-call-param.p-index = pp-index
     3080         ON error undo, return error :
     3081         assign
     3082         buf_tt-rule-call-param.param-value-character = p-value-character
     3083         buf_tt-rule-call-param.param-value-date      = p-value-date
     3084         buf_tt-rule-call-param.param-value-decimal   = p-value-decimal
     3085         buf_tt-rule-call-param.param-value-integer   = p-value-integer
     3086         buf_tt-rule-call-param.param-value-logical   = p-value-logical
     3087         .
     3088       END.
     3089     END.
     3090     WHEN 'rule-call-param':U THEN DO:
     3091       FIND FIRST buf_tt-rule-call-param WHERE
     3092           buf_tt-rule-call-param.call_id = p-call-id
     3093       AND buf_tt-rule-call-param.codex_id = v-codex-id
     3094       AND buf_tt-rule-call-param.ruleset_id = v-ruleset-id
     3095       AND buf_tt-rule-call-param.order_id = v-order-id
     3096       AND buf_tt-rule-call-param.param-name = V-PARAM-NAME
     3097       AND buf_tt-rule-call-param.p-index = pp-index.
     3098       assign
     3099       buf_tt-rule-call-param.param-value-character = p-value-character
     3100       buf_tt-rule-call-param.param-value-date      = p-value-date
     3101       buf_tt-rule-call-param.param-value-decimal   = p-value-decimal
     3102       buf_tt-rule-call-param.param-value-integer   = p-value-integer
     3103       buf_tt-rule-call-param.param-value-logical   = p-value-logical
     3104       .
     3105     END.
     3106   END CASE.
     3107   END PROCEDURE.
     3108   procedure rcps_get-rule-on-off :
     3109   define input parameter p-codex-id as integer no-undo .
     3110   define input parameter p-ruleset-id as integer no-undo .
     3111   define input parameter p-rule-id as integer no-undo .
     3112   define input parameter p-profile-id as integer no-undo .
     3113   define input parameter p-once-more as integer no-undo .
     3114   define output parameter p-on-off as logical no-undo .
     3115   if valid-handle(p-call-handle)
     3116   and lookup("rcpscont_get-rule-on-off", p-call-handle:internal-entries) > 0 then do:
     3117     run rcpscont_get-rule-on-off in p-call-handle (
     3118                                              input p-codex-id
     3119                                             ,input p-ruleset-id
     3120                                             ,input p-rule-id
     3121                                             ,input p-profile-id
     3122                                             ,input p-once-more
     3123                                             ,output p-on-off) no-error.
     3124   end.
     3125   end procedure.
     3126   procedure rcps_set-rule-on-off :
     3127   define input parameter p-codex-id as integer no-undo .
     3128   define input parameter p-ruleset-id as integer no-undo .
     3129   define input parameter p-rule-id as integer no-undo .
     3130   define input parameter p-profile-id as integer no-undo .
     3131   define input parameter p-once-more as integer no-undo .
     3132   define input parameter p-on-off as logical no-undo .
     3133   if valid-handle(p-call-handle)
     3134   and lookup("rcpscont_get-rule-on-off", p-call-handle:internal-entries) > 0 then do:
     3135     run rcpscont_set-rule-on-off in p-call-handle (
     3136                                              input p-codex-id
     3137                                             ,input p-ruleset-id
     3138                                             ,input p-rule-id
     3139                                             ,input p-profile-id
     3140                                             ,input p-once-more
     3141                                             ,input p-on-off) no-error.
     3142   end.
     3143   end procedure.
     3144   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3145   PROCEDURE rcps_MyEnable0 :
     3146   DEFINE VARIABLE v-ii AS INTEGER NO-UNDO.
     3147   DEFINE VARIABLE v-ch0 AS widget-handle NO-UNDO.
     3148   ASSIGN
     3149   term_tt-rule-call-param.param-label:RESIZABLE IN browse br-rcp = YES
     3150   X_rp-rule-param.rp-param-name:RESIZABLE IN browse br-rcp = YES
     3151   .
     3152   ASSIGN
     3153   v-ch0 = br-rcp:FIRST-COLUMN IN FRAME Dialog-Frame.
     3154   REPEAT WHILE valid-handle(v-ch0):
     3155      IF v-ch0:LABEL = "Значение!(строковое)" THEN DO:
     3156        v-ch[1] = v-ch0.
     3157        v-ch0:VISIBLE = NO.
     3158      END.
     3159      IF v-ch0:LABEL = "Значение!(Дата)" THEN DO:
     3160        v-ch[2] = v-ch0.
     3161        v-ch0:VISIBLE = NO.
     3162      END.
     3163      IF v-ch0:LABEL = "Значение!(Десятичное)" THEN DO:
     3164        v-ch[3] = v-ch0.
     3165        v-ch0:VISIBLE = NO.
     3166      END.
     3167      IF v-ch0:LABEL = "Значение!(Целое)" THEN DO:
     3168        v-ch[4] = v-ch0.
     3169        v-ch0:VISIBLE = NO.
     3170      END.
     3171      IF v-ch0:LABEL = "Значение!(Логическое)" THEN DO:
     3172        v-ch[5] = v-ch0.
     3173        v-ch0:VISIBLE = NO.
     3174      END.
     3175      IF v-ch0:LABEL = "Точка вызова" THEN DO:
     3176        v-ch[6] = v-ch0.
     3177      END.
     3178      IF v-ch0:LABEL = "Значение" THEN
     3179      v-ch0:RESIZABLE = YES.
     3180      v-ch0 = v-ch0:NEXT-COLUMN.
     3181   END.
     3182   assign
     3183   X_rp-rule-param.rp-param-name:resizable in browse br-rcp = yes
     3184   term_tt-rule-call-param.param-name:resizable in browse br-rcp = yes
     3185   term_tt-rule-call-param.param-label:resizable in browse br-rcp = yes
     3186   .
     3187   CASE p-list-mode:
     3188     WHEN 'rule-call-param':U THEN DO:
     3189        ASSIGN
     3190        X_rp-rule-param.rp-param-name:VISIBLE IN BROWSE br-rcp = NO
     3191        .
     3192     END.
     3193     WHEN 'rp-rule-param':U
     3194     or
     3195     when 'rp-rule-param':U + chr(44) + 'все':U
     3196     THEN DO:
     3197       assign
     3198       term_tt-rule-call-param.codex_id:VISIBLE IN BROWSE br-rcp = NO
     3199       term_tt-rule-call-param.ruleset_id:VISIBLE IN BROWSE br-rcp = NO
     3200       term_tt-rule-call-param.rule_id:VISIBLE IN BROWSE br-rcp = NO
     3201       term_tt-rule-call-param.order_id:VISIBLE IN BROWSE br-rcp = NO
     3202       term_tt-rule-call-param.param-name:VISIBLE IN BROWSE br-rcp = NO
     3203       term_tt-rule-call-param.param-num:VISIBLE IN BROWSE br-rcp = NO
     3204       .
     3205     END.
     3206   END CASE.
     3207    IF p-call-id <> '':U THEN DO:
     3208      v-ch[6]:VISIBLE = NO.
     3209    END.
     3210     IF p-profile-id <> 0 THEN DO:
     3211      term_tt-rule-call-param.profile_id :VISIBLE IN BROWSE br-rcp= NO.
     3212    END.
     3213     IF p-rule-id <> 0 THEN DO:
     3214      term_tt-rule-call-param.RULE_id :VISIBLE IN BROWSE br-rcp= NO.
     3215    END.
     3216     IF p-once-more <> 0 THEN DO:
     3217      term_tt-rule-call-param.once-more :VISIBLE IN BROWSE br-rcp= NO.
     3218    END.
     3219   END PROCEDURE.
     3220   PROCEDURE rcps_Openbr :
     3221   CASE p-list-mode:
     3222     WHEN 'rp-rule-param':U THEN DO:
     3223         OPEN QUERY br-rcp
     3224         FOR EACH  X_ruledict-param NO-LOCK WHERE X_ruledict-param.entry-id = v-rcps-entry-id
     3225             ,FIRST X_rp-rule-param WHERE
     3226                 X_rp-rule-param.profile_id = p-profile-id
     3227             AND X_rp-rule-param.rp-param-name = X_ruledict-param.param-name
     3228           , first tt-rule-call-param WHERE
     3229              tt-rule-call-param.codex_id = X_rp-rule-param.codex_id
     3230          AND tt-rule-call-param.ruleset_id = X_rp-rule-param.ruleset_id
     3231          AND tt-rule-call-param.rule_id = X_rp-rule-param.rule_id
     3232          AND tt-rule-call-param.param-name = X_rp-rule-param.rule-param-name
     3233            ,each term_tt-rule-call-param where
     3234                  term_tt-rule-call-param.call_id = tt-rule-call-param.call_id
     3235              and term_tt-rule-call-param.codex_id = tt-rule-call-param.codex_id
     3236              and term_tt-rule-call-param.ruleset_id = tt-rule-call-param.ruleset_id
     3237              and term_tt-rule-call-param.order_id = tt-rule-call-param.order_id
     3238              and term_tt-rule-call-param.param-name = tt-rule-call-param.param-name
     3239         BY tt-rule-call-param.call_id
     3240         BY tt-rule-call-param.codex_id
     3241         BY tt-rule-call-param.ruleset_id
     3242         BY tt-rule-call-param.order_id
     3243         BY tt-rule-call-param.param-num.
     3244     END.
     3245   END CASE.
     3246   apply "ENTRY" to br-rcp in frame Dialog-Frame .
     3247   APPLy "VALUE-CHANGED" to br-rcp.
     3248   END PROCEDURE.
     3249   PROCEDURE rcps_proc-b-chg PRIVATE :
     3250   DEFINE VARIABLE v-rec1 AS Rowid NO-UNDO.
     3251   DEFINE VARIABLE v-rec2 AS Rowid NO-UNDO.
     3252   DEFINE VARIABLE v-rec3 AS Rowid NO-UNDO.
     3253   DEFINE VARIABLE v-rec4 AS Rowid NO-UNDO.
     3254   define variable v-param-data-type as character no-undo .
     3255   define variable v-rid-list as character no-undo .
     3256   IF NOT AVAILABLE TERM_tt-rule-call-param  THEN DO:
     3257     RETURN ERROR.
     3258   END.
     3259   ASSIGN
     3260   v-rec1 = rowid(X_ruledict-param)
     3261   v-rec2 = rowid(X_rp-rule-param)
     3262   v-rec3 = Rowid(tt-rule-call-param)
     3263   v-rec4 = Rowid(term_tt-rule-call-param)
     3264   .
     3265   run rcps_openbr in this-procedure .
     3266   REPOSITION br-rcp TO Rowid v-rec1, v-rec2,v-rec3, v-rec4 NO-ERROR.
     3267   IF ERROR-STATUS:ERROR THEN DO:
     3268     REPOSITION br-rcp TO ROW 1 NO-ERROR.
     3269   END.
     3270   APPLY "ENTRY" TO br-rcp in frame Dialog-Frame .
     3271   APPLY "VALUE-CHANGED" TO br-rcp in frame Dialog-Frame .
     3272   END PROCEDURE.
     3273   PROCEDURE rcps_set-row-color :
     3274   DEFINE INPUT PARAMETER p-data-type AS CHARACTER NO-UNDO.
     3275   ASSIGN
     3276   v-ch[1]:FGCOLOR = GREY_COLOR
     3277   v-ch[1]:BGCOLOR = GREY_Color
     3278   v-ch[1]:PFCOLOR = GREY_Color
     3279   v-ch[2]:FGCOLOR = GREY_COLOR
     3280   v-ch[2]:BGCOLOR = GREY_Color
     3281   v-ch[2]:PFCOLOR = GREY_Color
     3282   v-ch[3]:FGCOLOR = GREY_COLOR
     3283   v-ch[3]:BGCOLOR = GREY_Color
     3284   v-ch[3]:PFCOLOR = GREY_Color
     3285   v-ch[4]:FGCOLOR = GREY_COLOR
     3286   v-ch[4]:BGCOLOR = GREY_Color
     3287   v-ch[4]:PFCOLOR = GREY_Color
     3288   v-ch[5]:FGCOLOR = GREY_COLOR
     3289   v-ch[5]:BGCOLOR = GREY_Color
     3290   v-ch[5]:PFCOLOR = GREY_Color
     3291   .
     3292   CASE entry(1, p-data-type):
     3293        WHEN 'character':U THEN DO:
     3294         ASSIGN
     3295         v-ch[1]:FGCOLOR = BLACK_COLOR
     3296         v-ch[1]:BGCOLOR = WHITE_Color.
     3297       END.
     3298       WHEN 'decimal':U THEN DO:
     3299         ASSIGN
     3300         v-ch[3]:FGCOLOR = BLACK_COLOR
     3301         v-ch[3]:BGCOLOR = WHITE_Color.
     3302       END.
     3303       WHEN 'integer':U THEN DO:
     3304         ASSIGN
     3305         v-ch[4]:FGCOLOR = BLACK_COLOR
     3306         v-ch[4]:BGCOLOR = WHITE_Color.
     3307       END.
     3308       WHEN 'date':U THEN DO:
     3309         ASSIGN
     3310         v-ch[2]:FGCOLOR = BLACK_COLOR
     3311         v-ch[2]:BGCOLOR = WHITE_Color.
     3312        END.
     3313        WHEN 'logical':U THEN DO:
     3314          ASSIGN
     3315          v-ch[5]:FGCOLOR = BLACK_COLOR
     3316          v-ch[5]:BGCOLOR = WHITE_Color.
     3317        END.
     3318   END CASE.
     3319   END PROCEDURE.
     3320   MAIN-BLOCK:
     3321   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3322      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3323   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3324     run mainmenu_getcntxt in parparentproc
     3325       (output v-cntxt-db-num
     3326       ,output v-cntxt-userid
     3327       ,output v-cntxt-level
     3328       ,output v-cntxt-host-code-obj
     3329       ,output v-cntxt-obj-type
     3330       ,output v-cntxt-obj-code
     3331       ,output v-cntxt-db-num-obj
     3332       ,output v-cntxt-is-admin
     3333       ) .
     3334      run gbl/dftempl.p ( input 'rp-rule-param':U
     3335                        , output v-dflt-rec) no-error.
     3336       if error-status:error then dO:
     3337         message
     3338         vss-workfile vss-revision vss-description skip
     3339         "Невозможно найти recid template записи в таблице rp-rule-param"
     3340         view-as alert-box error .
     3341         return error.
     3342       end.
     3343       run gbl/dftempl.p ( input 'ruledict-param':U
     3344                         , output v-rp-dflt-rec) no-error.
     3345        if error-status:error then dO:
     3346          message
     3347          vss-workfile vss-revision vss-description skip
     3348          "Невозможно найти recid template записи в таблице ruledict-param"
     3349          view-as alert-box error .
     3350          return error.
     3351        end.
     3352     IF p-list-mode = 'rp-rule-param':U
     3353     THEN DO:
     3354       FIND FIRST buf_rule-profile NO-LOCK WHERE
     3355                 buf_rule-profile.profile_id = p-profile-id.
     3356       run gen-key-rec in this-procedure ( input 'rule-profile':U
     3357                                       ,input buffer buf_rule-profile:handle
     3358                                       ,output v-uniq-key-rec).
     3359       FIND FIRST buf_ruledict NO-LOCK WHERE
     3360                 buf_ruledict.entry-type = 'rule-profile':U
     3361          AND  buf_ruledict.uniq-key-rec = v-uniq-key-rec.
     3362       v-rcps-entry-id = buf_ruledict.entry-id.
     3363     END.
     3364     ELSE DO:
     3365        MESSAGE
     3366        substitute("Неверное значение параметра p-list-mode=&1", p-list-mode)
     3367        VIEW-AS alert-box.
     3368     END.
     3369     if p-call-id begins 'schedule':U then do:
     3370       v-running-mode = yes.
     3371     end.
     3372     RUN rcps_fill-table IN THIS-PROCEDURE ( input yes).
     3373     RUN Myenable in THIS-PROCEDURE.
     3374     WAIT-FOR GO OF FRAME Dialog-Frame.
     3375   END.
     3376   RUN disable_UI.
     3377   PROCEDURE disable_UI :
     3378     HIDE FRAME Dialog-Frame.
     3379   END PROCEDURE.
     3380   PROCEDURE enable_UI :
     3381     DISPLAY F-tpl tpl-name f-coeff EDITOR-1
     3382         WITH FRAME Dialog-Frame.
     3383     ENABLE B-exit b-quit B-Help F-tpl button-tpl tpl-name f-coeff EDITOR-1 BR-rcp
     3384         WITH FRAME Dialog-Frame.
     3385     VIEW FRAME Dialog-Frame.
     3386   END PROCEDURE.
     3387   PROCEDURE MyEnable :
     3388   define variable v-list as character no-undo .
     3389   define variable glog as logical no-undo .
     3390   define variable v-index-id as integer no-undo .
     3391   define variable v-value-character as character no-undo .
     3392   define variable v-value-date as date no-undo .
     3393   define variable v-value-decimal as decimal no-undo .
     3394   define variable v-value-integer as integer no-undo .
     3395   define variable v-value-logical as logical no-undo .
     3396   define variable v-shop-code as integer no-undo .
     3397   run rcps_Myenable0 in this-procedure .
     3398   v-index-id = -1.
     3399   RUN rcps_get-value IN THIS-PROCEDURE (
     3400                                    INPUT p-profile-id
     3401                                   ,INPUT p-once-more
     3402                                   ,INPUT p-call-id
     3403                                   ,INPUT "p-tpl"
     3404                                   ,INPUT-output v-index-id
     3405                                   ,output v-tpl
     3406                                   ,output v-value-date
     3407                                   ,output v-value-decimal
     3408                                   ,output v-value-integer
     3409                                   ,output v-value-logical
     3410                                   ).
     3411   v-index-id = 0.
     3412   RUN rcps_get-value IN THIS-PROCEDURE (
     3413                                    INPUT p-profile-id
     3414                                   ,INPUT p-once-more
     3415                                   ,INPUT p-call-id
     3416                                   ,INPUT "p-coeff"
     3417                                   ,INPUT-output v-index-id
     3418                                   ,output v-value-character
     3419                                   ,output v-value-date
     3420                                   ,output f-coeff
     3421                                   ,output v-value-integer
     3422                                   ,output v-value-logical
     3423                                   ).
     3424   if v-tpl <> '' then do:
     3425     DEFINE BUFFER local_price-list-type FOR ub.price-list-type.
     3426     find first local_price-list-type no-lock where
     3427               local_price-list-type.plt-id = integer(entry(1, v-tpl, "-") )
     3428           and local_price-list-type.plt-db-num = integer(entry(2, v-tpl, "-") ) no-error.
     3429     if available local_price-list-type then do:
     3430       tpl-name =     local_price-list-type.NAME .
     3431       v-templ-rl-root = local_price-list-type.ban-discnt.
     3432       display
     3433       v-tpl @ f-tpl
     3434       tpl-name
     3435       with frame Dialog-Frame .
     3436     end.
     3437   end.
     3438   else do:
     3439     define variable dflt-cd as character no-undo .
     3440     define buffer buf_shop for ub.shop.
     3441     dflt-cd = ''.
     3442     find first buf_shop no-lock.
     3443   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3444   define variable v-param-type15 as character no-undo .
     3445   define variable v-value-date15 as date no-undo .
     3446   define variable v-value-decimal15 as decimal no-undo .
     3447   define variable v-value-integer15 as INTEGER no-undo .
     3448   define variable v-value-logical15 AS LOGICAL no-undo .
     3449   define variable v-tth15 as handle no-undo .
     3450   run adm/shattri.p (
     3451       input "get":U
     3452       ,input  'маг':U
     3453       ,input  buf_shop.obj-code
     3454       ,input  'cd-sending':U
     3455       ,input  'dflt-cd':U
     3456       ,output dflt-cd
     3457       ,output v-value-date15
     3458       ,output v-value-decimal15
     3459       ,output v-value-integer15
     3460       ,output v-value-logical15
     3461       ,output v-param-type15
     3462       ,INPUT-OUTPUT table-handle v-tth15
     3463       )  .
     3464   delete object v-tth15 no-error.
     3465     case dflt-cd:
     3466       when 'IBM':U then do:
     3467         v-templ-rl-root = 87.
     3468       end.
     3469       when 'IBS-TH':U then do:
     3470         v-templ-rl-root = 88.
     3471       end.
     3472       otherwise do:
     3473         message
     3474         substitute("Не определен ШАБЛОН правил скидки по СТПЛ для POS=&1", dflt-cd)
     3475         view-as alert-box error .
     3476         return error .
     3477       end.
     3478     end.
     3479   end.
     3480   v-templ-rl-root = 88.
     3481   ASSIGN
     3482   term_tt-rule-call-param.param-label:RESIZABLE IN browse br-rcp = YES
     3483   X_rp-rule-param.rp-param-name:RESIZABLE IN browse br-rcp = YES
     3484   .
     3485   DEFINE VARIABLE v-ch0 AS widget-handle NO-UNDO.
     3486   ASSIGN
     3487   v-ch0 = br-rcp:FIRST-COLUMN IN FRAME Dialog-Frame.
     3488   REPEAT WHILE valid-handle(v-ch0):
     3489      IF v-ch0:LABEL = "Значение!(строковое)" THEN DO:
     3490        v-ch[1] = v-ch0.
     3491        v-ch0:VISIBLE = NO.
     3492      END.
     3493      IF v-ch0:LABEL = "Значение!(Дата)" THEN DO:
     3494        v-ch[2] = v-ch0.
     3495        v-ch0:VISIBLE = NO.
     3496      END.
     3497      IF v-ch0:LABEL = "Значение!(Десятичное)" THEN DO:
     3498        v-ch[3] = v-ch0.
     3499        v-ch0:VISIBLE = NO.
     3500      END.
     3501      IF v-ch0:LABEL = "Значение!(Целое)" THEN DO:
     3502        v-ch[4] = v-ch0.
     3503        v-ch0:VISIBLE = NO.
     3504      END.
     3505      IF v-ch0:LABEL = "Значение!(Логическое)" THEN DO:
     3506        v-ch[5] = v-ch0.
     3507        v-ch0:VISIBLE = NO.
     3508      END.
     3509      IF v-ch0:LABEL = "Точка вызова" THEN DO:
     3510        v-ch[6] = v-ch0.
     3511      END.
     3512      IF v-ch0:LABEL = "Значение" THEN
     3513      v-ch0:RESIZABLE = YES.
     3514      v-ch0 = v-ch0:NEXT-COLUMN.
     3515   END.
     3516   assign
     3517   X_rp-rule-param.rp-param-name:resizable in browse br-rcp = yes
     3518   term_tt-rule-call-param.param-name:resizable in browse br-rcp = yes
     3519   term_tt-rule-call-param.param-label:resizable in browse br-rcp = yes
     3520   .
     3521   CASE p-list-mode:
     3522     WHEN 'rule-call-param':U THEN DO:
     3523        ASSIGN
     3524        X_rp-rule-param.rp-param-name:VISIBLE IN BROWSE br-rcp = NO
     3525        .
     3526     END.
     3527     WHEN 'rp-rule-param':U
     3528     or
     3529     when 'rp-rule-param':U + chr(44) + 'все':U
     3530     THEN DO:
     3531       assign
     3532       term_tt-rule-call-param.codex_id:VISIBLE IN BROWSE br-rcp = NO
     3533       term_tt-rule-call-param.ruleset_id:VISIBLE IN BROWSE br-rcp = NO
     3534       term_tt-rule-call-param.rule_id:VISIBLE IN BROWSE br-rcp = NO
     3535       term_tt-rule-call-param.order_id:VISIBLE IN BROWSE br-rcp = NO
     3536       term_tt-rule-call-param.param-name:VISIBLE IN BROWSE br-rcp = NO
     3537       term_tt-rule-call-param.param-num:VISIBLE IN BROWSE br-rcp = NO
     3538       .
     3539     END.
     3540   END CASE.
     3541    IF p-call-id <> '':U THEN DO:
     3542      v-ch[6]:VISIBLE = NO.
     3543    END.
     3544     IF p-profile-id <> 0 THEN DO:
     3545      term_tt-rule-call-param.profile_id :VISIBLE IN BROWSE br-rcp= NO.
     3546    END.
     3547     IF p-rule-id <> 0 THEN DO:
     3548      term_tt-rule-call-param.RULE_id :VISIBLE IN BROWSE br-rcp= NO.
     3549    END.
     3550     IF p-once-more <> 0 THEN DO:
     3551      term_tt-rule-call-param.once-more :VISIBLE IN BROWSE br-rcp= NO.
     3552    END.
     3553   editor-1:screen-value = "Коэффициент на который на до умножить частное" +
     3554                            " ЦЕНА НА ДОП.ЕД.ИЗМ. ПО ГТПЛ / КОЛ-ВО В УПАКОВКЕ," +
     3555                            " чтобы получить цену на осн. ед.изм. в создаваемом ДНЦ".
     3556   display
     3557   f-coeff
     3558   with frame Dialog-Frame .
     3559   VIEW FRAME Dialog-Frame.
     3560   ENABLE
     3561   f-coeff WHEN p-mode <> 'ПРОСМОТР':U
     3562   B-exit WHEN p-mode <> 'ПРОСМОТР':U
     3563   b-quit
     3564   button-tpl  WHEN p-mode <> 'ПРОСМОТР':U
     3565   editor-1
     3566   WITH FRAME Dialog-Frame.
     3567   VIEW FRAME Dialog-Frame.
     3568   IF p-mode = 'ПРОСМОТР':U THEN DO:
     3569      ASSIGN
     3570      b-quit:COLUMN = 1
     3571      b-quit:LABEL = "&Выход".
     3572      HIDE
     3573      b-exit
     3574      IN FRAME Dialog-Frame.
     3575   END.
     3576   ASSIGN
     3577   FRAME Dialog-Frame:TITLE = substitute("Параметры создания ДНЦ определенного типа и определенного содержания по алгоритму raimbek (профайл &1)", p-profile-id).
     3578   END PROCEDURE.
     3579   PROCEDURE proc-save :
     3580   assign
     3581   frame Dialog-Frame
     3582   f-tpl
     3583   f-coeff
     3584   .
     3585   RUN rcps_set-value IN THIS-PROCEDURE (
     3586                                   INPUT p-profile-id
     3587                                   ,INPUT p-once-more
     3588                                   ,INPUT p-call-id
     3589                                   ,INPUT "p-tpl"
     3590                                   ,INPUT 0
     3591                                   ,INPUT f-tpl
     3592                                   ,INPUT ?
     3593                                   ,INPUT 0.0
     3594                                   ,INPUT 0
     3595                                   ,INPUT NO
     3596                                   ).
     3597   RUN rcps_set-value IN THIS-PROCEDURE (
     3598                                   INPUT p-profile-id
     3599                                   ,INPUT p-once-more
     3600                                   ,INPUT p-call-id
     3601                                   ,INPUT "p-coeff"
     3602                                   ,INPUT 0
     3603                                   ,INPUT ''
     3604                                   ,INPUT ?
     3605                                   ,INPUT f-coeff
     3606                                   ,INPUT 0
     3607                                   ,INPUT NO
     3608                                   ).
     3609   run rcps_proc-save0 in this-procedure .
     3610   END PROCEDURE.
