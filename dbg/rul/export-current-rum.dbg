        1   block-level on error undo, throw.
        2   define input parameter p-file-name as character no-undo .
        3   define input parameter p-old-file-name as character no-undo .
        4   define input parameter p-mode as character no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision$":U .
        6   define variable vss-author      as character no-undo init "$Author$":U .
        7   define variable vss-date        as character no-undo init "$Date$":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        9   define variable vss-archive     as character no-undo init "$Archive$":U .
       10   define variable vss-description as character no-undo init "Экспорт конфигурации rule-машины в формате СПН".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define variable v-rum-exp-tables as character no-undo .
       70   define variable v-rum-exp-table-names as character no-undo .
       71   define variable err-count as integer no-undo .
       72   define variable rec-count as integer no-undo .
       73   define variable v-ii as integer no-undo .
       74   define variable v-prepare-phrase as character no-undo .
       75   define variable num-rec as integer no-undo .
       76   define variable num-err as integer no-undo .
       77   define variable v-fix-file-name as character no-undo .
       78   if num-entries(p-file-name, ".") > 1 then do:
       79     v-fix-file-name = entry(num-entries(p-file-name, ".") - 1 , p-file-name, ".") + ".fix".
       80   end.
       81   else do:
       82     v-fix-file-name = entry(num-entries(p-file-name, ".") , p-file-name, ".") + ".fix".
       83   end.
       84   if search(v-fix-file-name) = ? then do:
       85     message
       86     substitute("Не найден ПОПРАВОЧНЫЙ файл &1", v-fix-file-name)
       87     view-as alert-box error .
       88     return error .
       89   end.
       90   assign
       91   v-rum-exp-tables =  'rule-process':U +
       92                       ";" + 'ruleset':U +
       93                       ";" + 'prop-head':U +
       94                       ";" + 'prop-ruleset':U +
       95                       ";" + 'prop-map':U +
       96                       ";" + 'prop-script':U +
       97                       ";" + 'pscript-ruleset':U +
       98                       ";" + 'ruledict':U +
       99                       ";" + 'ruledict-param':U +
      100                       ";" + 'rule-script':U  +
      101                       ";" + 'rule-i-script':U  +
      102                       ";" + 'rule':U  +
      103                       ";" + 'rule-by-set':U +
      104                       ";" + 'prop-ref':U  +
      105                       ";" + 'rule-profile':U +
      106                       ";" + 'profile-by-profile':U +
      107                       ";" + 'rule-by-profile':U +
      108                       ";" + 'rp-rule-param':U +
      109                       ";" + "fixing" +
      110                       ";" + ('ruledict':U + chr(44) + 'ruledict':U)
      111                       .
      112   assign
      113   v-rum-exp-table-names = 'Звено процесса':U +
      114                           ";" + 'Кодексы и наборы правил':U +
      115                           ";" + 'Объекты-операнды машины правил':U +
      116                           ";" + 'Объекты - наборы правил':U +
      117                           ";" + 'Структура свойств данных':U +
      118                           ";" + 'Скрипты RULE-машины':U +
      119                           ";" + 'Свойства объ.<->набор правил':U +
      120                           ";" + 'Словарь RULE-машины':U +
      121                           ";" + 'Параметры статей словаря правил':U +
      122                           ";" + 'Текст правил':U  +
      123                           ";" + 'Скрипт объекта-правило':U  +
      124                           ";" + 'Правила RULE-машины':U      +
      125                           ";" + 'Привязка правил к наборам':U +
      126                           ";" + 'Типы срезов хранилища':U  +
      127                           ";" + 'Профайлы правил':U +
      128                           ";" + 'Привязка профайлов к профайлу':U +
      129                           ";" + 'rule-by-profile':U +
      130                           ";" + 'Параметры профайла-правила':U +
      131                           ";" + "fixing" +
      132                           ";" + 'Словарь RULE-машины':U
      133                           .
      134   do v-ii = 1 to num-entries( v-rum-exp-tables, ";"):
      135     CASE entry(v-ii, v-rum-exp-tables, ";"):
      136       when 'prop-ref':U then do:
      137         v-prepare-phrase = substitute(" for each &1 where &1.dt-code = 0 ", entry(v-ii, v-rum-exp-tables, ";")).
      138       end.
      139       when 'ruledict':U then do:
      140         v-prepare-phrase = substitute(' for each &1 where &1.entry-id > 0 and ((&1.entry-type > "&2") or (&1.entry-type < "&2")) use-index imain'
      141                                      , entry(v-ii, v-rum-exp-tables, ";")
      142                                      , 'sum-id':U
      143                                      ).
      144       end.
      145       when ('ruledict':U + chr(44) + 'ruledict':U) then do:
      146         v-prepare-phrase = substitute(' for each &1 where &1.entry-id = 0'
      147                                      , entry(1, entry(v-ii, v-rum-exp-tables, ";"))
      148                                      ).
      149         entry(v-ii, v-rum-exp-tables, ";") = entry(1, entry(v-ii, v-rum-exp-tables, ";")).
      150       end.
      151       when "fixing" then do:
      152         v-prepare-phrase = v-fix-file-name.
      153       end.
      154       otherwise do:
      155         v-prepare-phrase = substitute(" for each &1 ", entry(v-ii, v-rum-exp-tables, ";")).
      156       end.
      157    END CASE.
      158     rec-count = num-rec.
      159     err-count = num-err.
      160     run utl/upg-exp.p ( input p-file-name
      161                        ,input p-old-file-name
      162                        ,input p-mode
      163                        ,input (if v-ii = 1 then no else yes)
      164                        ,input (if v-ii = 1 then yes else no)
      165                        ,input ( if v-ii = num-entries(v-rum-exp-tables, ";") then yes else no)
      166                        ,input entry(v-ii, v-rum-exp-tables, ";")
      167                        ,input (if num-entries(entry(v-ii, v-rum-exp-tables, ";")) > 1
      168                                then num-entries(entry(v-ii, v-rum-exp-tables, ";"))
      169                                else 1)
      170                        ,input v-prepare-phrase
      171                        ,input-output rec-count
      172                        ,input-output err-count
      173                        ) no-error.
      174     if not error-status:error then do:
      175       num-rec = rec-count.
      176       num-err = err-count.
      177     end.
      178     else do:
      179       message
      180       substitute("Ошибка при экспорте &1", entry(v-ii, v-rum-exp-tables, ";"))
      181       view-as alert-box error .
      182       return.
      183     end.
      184   end.
      185   message
      186   "Экспорт конфигурации завершен"
      187   view-as alert-box .
