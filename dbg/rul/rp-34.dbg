     2120   procedure mpl-autoprice :
     2121   define input  parameter p-only-b-code as logical   no-undo .
     2122   define input  parameter p-cli-type    as character no-undo .
     2123   define input  parameter p-cli-code    as integer   no-undo .
     2124   define input  parameter p-main-b-code as integer   no-undo .
