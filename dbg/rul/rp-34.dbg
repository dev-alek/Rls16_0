     2140   define output parameter p-road-tax-rubl as decimal   no-undo .
     2141   define output parameter p-excise-base   as decimal   no-undo .
     2142   define output parameter p-excise-rubl   as decimal   no-undo .
     2143   define variable v-cli-oborot-ALL as decimal   no-undo .
     2144   define buffer buf_buyer-in-buyer-group   for ub.buyer-in-buyer-group  .
     2145   define buffer buf_turnover-buyer-main    for ub.turnover-buyer-main  .
     2146   define buffer buf1_tnv-in-turnover-group for ub.tnv-in-turnover-group  .
