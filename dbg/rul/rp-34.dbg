     5567           undo, return error substitute("Не определен регистр &1 параметра &2 для расчета скидок/бонусов по правилу с шаблоном &3"
     5568                                         ,buf2_temp-call-param.fld-df
     5569                                         ,buf2_temp-call-param.param-name_
     5570                                         ,v-templ-rl-root).
     5571         end.
     5572         assign
     5573         buf2_temp-call-param.field-name_ = p-dr-flddf::field-name_
     5574         buf2_temp-call-param.table-no = p-dr-flddf::table-no
     5575         .
     5576       end.
     5577     end.
     5578     assign
     5579     buf_temp-call-param.num-params = v-ii
     5580     .
     5581   end.
     5582   define variable vss-include-info60 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5583     find first buf_temp-call-param where
     5584               buf_temp-call-param.call-name_ = substitute("dis-rule_rf_&1&2", string(v-templ-rl-root, "99999"), v-inversed-chr)
     5585           and buf_temp-call-param.param-number = 0.
     5586     if not valid-handle(buf_temp-call-param.call-handle_) then do:
     5587       create call buf_temp-call-param.call-handle_.
     5588       assign
     5589       buf_temp-call-param.call-handle_:call-name = buf_temp-call-param.call-name_
     5590       buf_temp-call-param.call-handle_:call-type = FUNCTION-CALL-TYPE
     5591       buf_temp-call-param.call-handle_:in-handle = this-procedure:handle
     5592       buf_temp-call-param.call-handle_:num-parameters = buf_temp-call-param.num-params
     5593       .
     5594     end.
     5595   define variable vss-include-info61 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5596     define variable glog61 as logical   no-undo .
     5597     define variable v-dt-tp61  as character no-undo .
     5598     for each buf2_temp-call-param where
     5599             buf2_temp-call-param.param-num > 0
     5600         and buf2_temp-call-param.call-name_ = substitute("dis-rule_rf_&1&2", string(v-templ-rl-root, "99999"), v-inversed-chr)
     5601     on error  undo , return error substitute( "&1. &2&3&4", vss-include-info61,  return-value, chr(10), error-status :get-message (1))
     5602     on stop   undo , return error substitute( "&1. stop", vss-include-info61 )
     5603     on endkey undo , return error substitute( "&1. endkey", vss-include-info61 ):
     5604         if v-bh[buf2_temp-call-param.table-no]:buffer-field(buf2_temp-call-param.field-name_):buffer-value = ? then
     5605         do:
     5606            case buf2_temp-call-param.param-datatype_:
     5607               when "decimal"  or when "integer" then
     5608               do:
     5609       glog61 = buf_temp-call-param.call-handle_:set-parameter( buf2_temp-call-param.param-num
     5610                                                       ,buf2_temp-call-param.param-datatype_
     5611                                                       ,buf2_temp-call-param.io-mode
     5612                                                       ,0
     5613                                                       ).
     5614               end.
     5615               when "character" then
     5616               do:
     5617       glog61 = buf_temp-call-param.call-handle_:set-parameter( buf2_temp-call-param.param-num
     5618                                                       ,buf2_temp-call-param.param-datatype_
     5619                                                       ,buf2_temp-call-param.io-mode
     5620                                                       ,""
     5621                                                       ).
     5622               end.
     5623            end case .
     5624         end.
     5625         else
     5626       glog61 = buf_temp-call-param.call-handle_:set-parameter( buf2_temp-call-param.param-num
     5627                                                       ,buf2_temp-call-param.param-datatype_
     5628                                                       ,buf2_temp-call-param.io-mode
     5629                                                       ,v-bh[buf2_temp-call-param.table-no]:buffer-field(buf2_temp-call-param.field-name_):buffer-value
     5630                                                       ).
     5631     end.
     5632     assign
     5633     buf_temp-call-param.call-number = buf_temp-call-param.call-number + 1
     5634     v-last-call-number = buf_temp-call-param.call-number
     5635     v-last-call-name = buf_temp-call-param.call-name_
     5636     .
     5637     buf_temp-call-param.call-handle_:invoke.
     5638       if buf_temp-call-param.call-handle_:return-value = ? then
     5639       do:
     5640          v-dt-tp61 = v-bh[buf_temp-call-param.table-no]:buffer-field(buf_temp-call-param.field-name_):data-type .
     5641          if v-dt-tp61 = "decimal" or v-dt-tp61 = "integer" then
     5642          do:
     5643   v-bh[buf_temp-call-param.table-no]:buffer-field(buf_temp-call-param.field-name_):buffer-value = 0 .
     5644          end.
     5645       end.
     5646       else
     5647       do:
     5648     v-bh[buf_temp-call-param.table-no]:buffer-field(buf_temp-call-param.field-name_):buffer-value = buf_temp-call-param.call-handle_:return-value.
     5649       end.
     5650     if v-inversed then do:
     5651       v-bh[6]:buffer-field("object-sum"):buffer-value =
     5652       v-bh[6]:buffer-field("object-sum"):buffer-value   .
     5653     end.
     5654     if v-bh[6]:buffer-field("value-type"):buffer-value =  integer('1':U) then do:
     5655     end.
     5656     else do:
     5657       v-bh[6]:buffer-field("discnt-value-pcnt"):buffer-value =
     5658                 v-bh[6]:buffer-field("discnt-value-abs"):buffer-value /
     5659                 v-bh[6]:buffer-field("object-sum"):buffer-value * 100
     5660                 .
     5661     end.
     5662     assign
     5663     v-delta-discnt-r-b = v-bh[6]:buffer-field("discnt-value-abs"):buffer-value
     5664     .
     5665     if v-bh[1]:buffer-field("r-b"):buffer-value = 'rubl':U then do:
     5666       assign
     5667       v-delta-discnt-rubl = v-delta-discnt-r-b
     5668       v-new-rubl-sum = v-rubl-sum - v-delta-discnt-rubl * integer(not v-inversed)
     5669       v-new-discnt-rubl = v-discnt-rubl + v-delta-discnt-rubl
     5670       .
     5671       if v-bh[1]:buffer-field("base-code"):buffer-value = 0 then do:
     5672         assign
     5673         v-delta-discnt-base = v-delta-discnt-r-b
     5674         v-new-base-sum = v-base-sum - v-delta-discnt-base * integer(not v-inversed)
     5675         v-new-discnt-base = v-discnt-base + v-delta-discnt-base
     5676         .
     5677       end.
     5678       else do:
     5679         assign
     5680         v-delta-discnt-base = v-delta-discnt-r-b * v-bh[2]:buffer-field("base-rate"):buffer-value
     5681         v-new-base-sum = v-base-sum - v-delta-discnt-base * integer(not v-inversed)
     5682         v-new-discnt-base = v-discnt-base + v-delta-discnt-base
     5683         .
     5684       end.
     5685     end.
     5686     else do:
     5687       assign
     5688       v-delta-discnt-base = v-delta-discnt-r-b
     5689       v-new-base-sum = v-base-sum - v-delta-discnt-base  * integer(not v-inversed)
     5690       v-new-discnt-base = v-discnt-base + v-delta-discnt-base
     5691       .
     5692       if  v-bh[1]:buffer-field("base-code"):buffer-value = 0 then do:
     5693         assign
     5694         v-delta-discnt-rubl = v-delta-discnt-r-b
     5695         v-new-rubl-sum = v-rubl-sum - v-delta-discnt-base * integer(not v-inversed)
     5696         v-new-discnt-rubl = v-discnt-rubl + v-delta-discnt-base
     5697         .
     5698       end.
     5699       else do:
     5700         assign
     5701         v-delta-discnt-base = v-delta-discnt-r-b / v-bh[2]:buffer-field("base-rate"):buffer-value
     5702         v-new-base-sum = v-base-sum - v-delta-discnt-base * integer(not v-inversed)
     5703         v-new-discnt-base = v-discnt-base + v-delta-discnt-base
     5704         .
     5705       end.
     5706     end.
     5707     if v-curr-code = 0 then do:
     5708       assign
     5709       v-delta-discnt-curr = v-delta-discnt-rubl
     5710       v-new-curr-sum = v-curr-sum - v-delta-discnt-curr * integer(not v-inversed)
     5711       v-new-discnt-curr = v-discnt-curr + v-delta-discnt-curr
     5712       .
     5713     end.
     5714     else do:
     5715       if v-curr-code = v-bh[1]:buffer-field("base-code"):buffer-value then do:
     5716         assign
     5717         v-delta-discnt-curr = v-delta-discnt-base
     5718         v-new-curr-sum = v-curr-sum - v-delta-discnt-curr  * integer(not v-inversed)
     5719         v-new-discnt-curr = v-discnt-curr + v-delta-discnt-curr
     5720         .
     5721       end.
     5722       else do:
     5723         assign
     5724         v-delta-discnt-curr = v-delta-discnt-rubl / v-bh[5]:buffer-field("exch-rate"):buffer-value * v-bh[5]:buffer-field("exch-scale"):buffer-value
     5725         v-new-curr-sum = v-curr-sum - v-delta-discnt-curr * integer(not v-inversed)
     5726         v-new-discnt-curr = v-discnt-curr + v-delta-discnt-curr
     5727         .
     5728       end.
     5729     end.
     5730     if v-bh[6]:buffer-field("intended"):buffer-value = no
     5731     and v-bh[6]:buffer-field("not-found"):buffer-value = no
     5732     then do:
     5733       if v-inversed then do:
     5734         create buf_chk-discnt.
     5735         buffer buf_chk-discnt:handle:buffer-copy(v-bh[6]).
     5736         if buf_temp-discnt-role.table-name = 'dis-cp-rule':U then do:
     5737           assign
     5738           buffer buf_chk-discnt:handle:buffer-field("object-sum"):buffer-value = v-bh[2]:buffer-field("netto"):buffer-value
     5739           .
     5740         end.
     5741         run printbuffer in this-procedure ( input v-bh[6]).
     5742         release buf_chk-discnt.
     5743       end.
     5744       v-bh[6]:buffer-release().
     5745       v-found = yes.
     5746     end.
     5747     else do:
     5748       v-bh[6]:buffer-delete().
     5749       v-found = no.
     5750     end.
     5751   end.
     5752               if v-found then leave _cycle.
     5753             end.
     5754           end.
     5755         end case.
     5756       end.
     5757       if v-found and not p-add-discnts then do:
     5758         leave _roles.
     5759       end.
     5760     end.
     5761   end.
     5762   end.
     5763   end procedure.
     5764   procedure load-ruleset-context :
     5765   define variable v-subject-type as integer no-undo .
     5766   define variable v-found as logical no-undo .
     5767   define variable v-vh as handle no-undo .
     5768   define buffer buf_rule-call-param for ub.rule-call-param.
     5769   define buffer buf_rule-by-call for ub.rule-by-call.
     5770   define buffer buf_temp-rule-call-param for temp-rule-call-param.
     5771   define buffer buf_temp-rule-by-call for temp-rule-by-call.
     5772   define buffer buf_temp-discnt-role for temp-discnt-role.
     5773   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
     5774   define buffer buf2_dis-cfg-rule for ub.dis-cfg-rule.
     5775   main-block:
     5776   do
     5777   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     5778   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     5779   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     5780   :
     5781     for each buf_temp-rule-call-param:
     5782       delete buf_temp-rule-call-param.
     5783     end.
     5784     for each buf_temp-rule-by-call:
     5785       delete buf_temp-rule-by-call.
     5786     end.
     5787     for each buf_rule-call-param no-lock where
     5788             buf_rule-call-param.profile_id = p-profile-id
     5789         and buf_rule-call-param.once-more = p-once-more
     5790         and buf_rule-call-param.call_id = p-call-id
     5791     break
     5792     by buf_rule-call-param.call_id
     5793     by buf_rule-call-param.codex_id
     5794     by buf_rule-call-param.ruleset_id
     5795     by buf_rule-call-param.order_id
     5796     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     5797     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     5798     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     5799     :
     5800       if first-of(buf_rule-call-param.order_id)  then do:
     5801         v-found = no.
     5802       end.
     5803       create buf_temp-rule-call-param.
     5804       buffer-copy buf_rule-call-param to buf_temp-rule-call-param.
     5805       if (lookup(buf_temp-rule-call-param.param-3-data-type, "LIST") = 0
     5806       and lookup(buf_temp-rule-call-param.param-3-data-type, "SORTED-LIST") = 0
     5807       )
     5808       or buf_temp-rule-call-param.p-index > 0 then do:
     5809         if lookup(buf_temp-rule-call-param.param-2-data-type, 'gds-discnt-role,subtotal-discnt-role,pay-discnt-role':U) > 0
     5810         then do:
     5811           case buf_temp-rule-call-param.param-2-data-type:
     5812             when 'gds-discnt-role':U then do:
     5813               assign
     5814               v-subject-type = integer('1':U).
     5815             end.
     5816             when 'subtotal-discnt-role':U then do:
     5817               assign
     5818               v-subject-type = integer('2':U).
     5819             end.
     5820             when 'pay-discnt-role':U then do:
     5821               assign
     5822               v-subject-type = integer('5':U).
     5823             end.
     5824           end case.
     5825           for each buf_dis-cfg-rule no-lock where
     5826                       buf_dis-cfg-rule.discnt-role = buf_temp-rule-call-param.param-value-character
     5827                   and buf_dis-cfg-rule.pos-type = p-pos-type-for-discnt
     5828                and buf_dis-cfg-rule.subject-type = v-subject-type :
     5829             if buf_dis-cfg-rule.link-prop <> integer('0':U)
     5830             and buf_dis-cfg-rule.link-prop <> integer('-1':U) then next.
     5831             assign
     5832             v-vh = p-bh[1]:buffer-field("how-" + buf_temp-rule-call-param.param-value-character) no-error.
     5833             if valid-handle(v-vh)
     5834             and buf_dis-cfg-rule.discnt-role <> p-bh[1]:buffer-field("how-" + buf_temp-rule-call-param.param-value-character):buffer-value
     5835             then next.
     5836             find first buf_temp-discnt-role where
     5837                     buf_temp-discnt-role.codex_id = buf_temp-rule-call-param.codex_id
     5838                 and buf_temp-discnt-role.ruleset_id = buf_temp-rule-call-param.ruleset_id
     5839                 and buf_temp-discnt-role.order_id = buf_temp-rule-call-param.order_id
     5840                 and buf_temp-discnt-role.rule_id = buf_temp-rule-call-param.rule_id
     5841                 and buf_temp-discnt-role.pos-type = p-pos-type-for-discnt
     5842                 and buf_temp-discnt-role.discnt-role = buf_temp-rule-call-param.param-value-character
     5843                 and buf_temp-discnt-role.table-name = buf_dis-cfg-rule.table-name
     5844                 no-error.
     5845             if not available buf_temp-discnt-role then do:
     5846               create buf_temp-discnt-role.
     5847               assign
     5848               buf_temp-discnt-role.codex_id = buf_temp-rule-call-param.codex_id
     5849               buf_temp-discnt-role.ruleset_id = buf_temp-rule-call-param.ruleset_id
     5850               buf_temp-discnt-role.order_id = buf_temp-rule-call-param.order_id
     5851               buf_temp-discnt-role.rule_id = buf_temp-rule-call-param.rule_id
     5852               buf_temp-discnt-role.once-more = buf_temp-rule-call-param.once-more
     5853               buf_temp-discnt-role.pos-type = p-pos-type-for-discnt
     5854               buf_temp-discnt-role.subject-type = v-subject-type
     5855               buf_temp-discnt-role.discnt-role = buf_temp-rule-call-param.param-value-character
     5856               buf_temp-discnt-role.discnt-type = buf_Dis-cfg-rule.discnt-type
     5857               buf_temp-discnt-role.table-name = buf_Dis-cfg-rule.table-name
     5858               buf_temp-discnt-role.has-glob = buf_Dis-cfg-rule.has-glob
     5859               buf_temp-discnt-role.has-host = buf_Dis-cfg-rule.has-host
     5860               buf_temp-discnt-role.has-obj = buf_Dis-cfg-rule.has-obj
     5861               buf_temp-discnt-role.link-prop = buf_Dis-cfg-rule.link-prop
     5862               buf_temp-discnt-role.templ-rl-root = (if buf_Dis-cfg-rule.link-prop = integer('-1':U)
     5863                                                     then buf_dis-cfg-rule.templ-rl-root
     5864                                                     else buf_temp-discnt-role.templ-rl-root)
     5865               buf_temp-discnt-role.time-templ-rl-root = (if buf_Dis-cfg-rule.link-prop = integer('-1':U)
     5866                                                     then buf_dis-cfg-rule.time-templ-rl-root
     5867                                                     else buf_temp-discnt-role.time-templ-rl-root)
     5868               .
     5869               v-found = yes.
     5870               if buf_temp-discnt-role.table-name = 'dis-grp-rule':U then do:
     5871                 assign
     5872                 p-bh[1]:buffer-field("is-grp-totals"):buffer-value = yes.
     5873               end.
     5874             end.
     5875           end.
     5876         end.
     5877       end.
     5878       if last-of(buf_rule-call-param.order_id) then do:
     5879         if v-found = no then do:
     5880           create buf_temp-discnt-role.
     5881           assign
     5882           buf_temp-discnt-role.codex_id = buf_temp-rule-call-param.codex_id
     5883           buf_temp-discnt-role.ruleset_id = buf_temp-rule-call-param.ruleset_id
     5884           buf_temp-discnt-role.order_id = buf_temp-rule-call-param.order_id
     5885           buf_temp-discnt-role.rule_id = buf_temp-rule-call-param.rule_id
     5886           buf_temp-discnt-role.once-more = buf_temp-rule-call-param.once-more
     5887           buf_temp-discnt-role.discnt-type = 0
     5888           buf_temp-discnt-role.subject-type = 0
     5889           buf_temp-discnt-role.discnt-role = ''
     5890           .
     5891         end.
     5892       end.
     5893     end.
     5894     for each buf_rule-by-call no-lock where
     5895             buf_rule-by-call.profile_id = p-profile-id
     5896         and buf_rule-by-call.once-more = p-once-more
     5897         and buf_rule-by-call.call_id = p-call-id
     5898     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     5899     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     5900     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     5901     :
     5902       create buf_temp-rule-by-call.
     5903       buffer-copy buf_rule-by-call to buf_temp-rule-by-call.
     5904     end.
     5905     assign
     5906     v-current-host-code = p-host-code
     5907     v-current-obj-type = p-obj-type
     5908     v-current-obj-code = p-obj-code
     5909     v-current-db-num = g#db-num
     5910     v-current-pos-type = p-pos-type
     5911     v-current-pos-type-for-discnt = p-pos-type-for-discnt
     5912     .
     5913   end.
     5914   end procedure.
     5915   procedure rp-chk-doc_set-log :
     5916   define input parameter p-lock-log-handle as handle no-undo .
     5917   main-block:
     5918   do
     5919   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     5920   :
     5921     p-log-handle = p-lock-log-handle.
     5922   end.
     5923   end.
