     1412         run mpl-tpl-auto in this-procedure ( input p-b-code
     1413                                             ,input 'маг':U
     1414                                             ,input p-obj-code
     1415                                             ,input integer(entry(1, buf_term-dis-rule.charkey_one,"-"))
     1416                                             ,input integer(entry(2, buf_term-dis-rule.charkey_one,"-"))
     1417                                             ,input ?
     1418                                             ,output v-price
     1419                                             ,output v-pdf-id
     1420                                             ,output v-pdf-db-num
     1421                                             ) no-error.
     1422         if error-status :error then do:
     1423            v-price = p-price-netto.
     1424            p-not-found = yes.
     1425            return 0.
     1426         end.
     1427         if v-pdf-id = 0
     1428         or v-pdf-id = ? then do:
     1429           p-not-found = yes.
     1430         end.
     1431         p-value-type = integer('12':U).
     1432         p-discnt-sum = (p-price-netto - v-price) * p-qnty.
     1433         return (p-price-netto - v-price).
     1434       end.
     1435     end.
     1436   end.
     1437   p-not-found = yes.
     1438   return 0.
     1439   end function.
     1440   FUNCTION dis-rule_rf_00085 returns decimal ( input p-rule-num as integer
     1441                                           , input p-date as date
     1442                                           , input p-time as integer
     1443                                           , input p-price-netto as decimal
     1444                                           , input p-nonunique as character
     1445                                           , input p-b-code as integer
     1446                                           , output p-not-found as logical
     1447                                           , output p-discnt-pcnt as decimal
     1448                                           , output p-value-type as integer
     1449                                           ):
     1450   define buffer buf_dis-rule for ub.dis-rule.
     1451   define buffer buf_term-dis-rule for ub.dis-rule.
     1452   p-value-type = integer('1':U).
     1453   if p-nonunique <> string(p-b-code) then do:
     1454     p-not-found = yes.
     1455     return 0.
     1456   end.
     1457   find first buf_dis-rule no-lock where
     1458           buf_dis-rule.rule-num = p-rule-num no-error.
     1459   if available buf_dis-rule
     1460   and buf_dis-rule.sts = integer('0':U)
     1461   then do:
     1462     for each buf_term-dis-rule no-lock where
     1463             buf_term-dis-rule.upper-rule-num = buf_dis-rule.rule-num:
     1464       if (buf_term-Dis-rule.time-templ-rl-root <= 50000 or dynamic-function( "dis-time-rule_" + string(buf_term-dis-rule.time-templ-rl-root - 50000, "99999" )                                        , input buf_term-dis-rule.time-rule-num                                         , input p-date                                        , input p-time )) then do:
     1465         p-discnt-pcnt = buf_term-dis-rule.discnt-value.
     1466         return p-price-netto * buf_term-dis-rule.discnt-value / 100.
     1467       end.
     1468     end.
     1469   end.
     1470   p-not-found = yes.
     1471   return 0.
     1472   end function.
     1473   FUNCTION dis-rule_rf_00088 returns decimal ( input p-rule-num as integer
     1474                                             , input p-date as date
     1475                                             , input p-time as integer
     1476                                             , input p-obj-code as integer
     1477                                             , input p-price-netto as decimal
     1478                                             , input p-dis-kat as integer
     1479                                             , input p-qnty as decimal
     1480                                             , input p-b-code as integer
     1481                                             , input-output p-price as decimal
     1482                                             , output p-discnt-sum as decimal
     1483                                             , output p-value-type as integer
     1484                                             , output p-not-found as logical
     1485                                             ):
     1486   define variable v-price as decimal no-undo .
     1487   define variable v-pdf-id as integer no-undo .
     1488   define variable v-pdf-db-num as integer   no-undo .
     1489   define buffer buf_dis-rule for ub.dis-rule.
     1490   define buffer buf_term-dis-rule for ub.dis-rule.
     1491   v-price = p-price.
     1492   p-value-type = integer('2':U).
     1493   find first buf_dis-rule no-lock where
     1494           buf_dis-rule.rule-num = p-rule-num no-error.
     1495   if available buf_dis-rule
     1496   and buf_dis-rule.sts = integer('0':U)
     1497   and (buf_Dis-rule.time-templ-rl-root <= 50000 or dynamic-function( "dis-time-rule_" + string(buf_dis-rule.time-templ-rl-root - 50000, "99999")                                        , input buf_dis-rule.time-rule-num                                         , input p-date                                        , input p-time ))
     1498   then do:
     1499     for each buf_term-dis-rule no-lock where
     1500             buf_term-dis-rule.upper-rule-num = buf_dis-rule.rule-num
     1501     and buf_term-dis-rule.dis-kat = p-dis-kat :
     1502       run mpl-tpl-auto in this-procedure ( input p-b-code
     1503                                           ,input 'маг':U
     1504                                           ,input p-obj-code
     1505                                           ,input integer(entry(1, buf_term-dis-rule.charkey_one,"-"))
     1506                                           ,input integer(entry(2, buf_term-dis-rule.charkey_one,"-"))
     1507                                           ,input ?
     1508                                           ,output v-price
     1509                                           ,output v-pdf-id
     1510                                           ,output v-pdf-db-num
     1511                                           ) no-error.
     1512       if error-status :error then do:
     1513           v-price = p-price-netto.
     1514           p-not-found = yes.
     1515           return 0.
     1516       end.
     1517       if v-pdf-id = 0
     1518       or v-pdf-id = ? then do:
     1519         p-not-found = yes.
     1520       end.
     1521       p-value-type = integer('12':U).
     1522       p-discnt-sum = (p-price-netto - v-price) * p-qnty.
     1523       return (p-price-netto - v-price).
     1524     end.
     1525   end.
     1526   p-not-found = yes.
     1527   return 0.0.
     1528   end function.
     1529   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1530   define temp-table temp-call-param no-undo
     1531   field call-number as integer
     1532   field call-name_ as character
     1533   field param-name_ as character
     1534   field param-label_ as character
     1535   field num-params_ as integer
     1536   field call-handle_ as handle
     1537   field param-number_ as integer
     1538   field param-datatype_ as character
     1539   field io-mode_ as character
     1540   field character_ as character
     1541   field date_ as date
     1542   field decimal_ as decimal
     1543   field integer_ as integer
     1544   field logical_ as logical
     1545   field fld-df as character
     1546   field field-name_ as CHARACTER
     1547   field table-no as integer
     1548   field field-handle as handle
     1549   index pi is unique primary call-name_ param-number_.
     1550   define variable v-last-call-name as character no-undo .
     1551   define variable v-last-call-number as int64 no-undo .
     1552   define variable v-inversed-chr as character no-undo init ''.
     1553   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1554   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1555   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1556   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1557   procedure factord :
     1558     define input  parameter p-fact-date            as date    no-undo .
     1559     define input  parameter p-fact-time            as integer no-undo .
     1560     define input  parameter p-fact-num             as integer no-undo .
     1561     define input  parameter p-shift-date           as date    no-undo .
     1562     define input  parameter p-shift-num            as integer no-undo .
     1563     define input  parameter p-shift-on             as logical no-undo .
     1564     define output parameter p-fact-order           as decimal no-undo .
     1565     define output parameter p-shift-end-fact-order as decimal no-undo .
     1566     define output parameter p-day-end-fact-order   as decimal no-undo .
     1567     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     1568     if p-fact-date = ?
     1569     then do:
     1570       return error "Не указана фактическая дата" .
     1571     end.
     1572     define variable v-fact-date-num as integer no-undo .
     1573     assign
     1574       v-fact-date-num = integer(p-fact-date)
     1575     .
     1576     if p-fact-num = ?
     1577     or p-fact-num = 0
     1578     then do:
     1579       return error "Не задан p-fact-num " + string(p-fact-num) .
     1580     end.
     1581     if p-fact-num < 0
     1582     then do:
     1583       return error "Отрицательный fact-num " + string(p-fact-num) .
     1584     end.
     1585     if p-fact-num >= 100000000
     1586     then do:
     1587       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     1588     end.
     1589     if p-shift-on = true
     1590     then do:
     1591       if p-shift-date = ?
     1592       then do:
     1593         return error "Не задана дата смены" .
     1594       end.
     1595       if p-shift-num = ?
     1596       or p-shift-num = 0
     1597       then do:
     1598         return error "Не задан номер смены" .
     1599       end.
     1600     end.
     1601     else do:
     1602       assign
     1603         p-shift-date = p-fact-date
     1604         p-shift-num  = 24
     1605       .
     1606     end.
     1607     define variable v-shift-offset as integer no-undo .
     1608     if p-shift-date = p-fact-date
     1609     then do:
     1610       assign
     1611         v-shift-offset = 1
     1612       .
     1613     end.
     1614     if p-shift-date < p-fact-date
     1615     then do:
     1616       assign
     1617         v-shift-offset = 0
     1618       .
     1619     end.
     1620     if p-shift-date > p-fact-date
     1621     then do:
     1622       message
     1623         vss-workfile vss-revision vss-description skip
     1624         "Неправильная дата закрытия смены" skip
     1625         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1626         view-as alert-box error .
     1627       undo, return error
     1628         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1629           ,string(p-fact-date, '99/99/9999':U)
     1630           ,string(p-shift-date, '99/99/9999':U)
     1631           )
     1632       .
     1633     end.
     1634     if p-shift-num < 1
     1635     or p-shift-num > 24
     1636     then do:
     1637       message
     1638         vss-workfile vss-revision vss-description skip
     1639         "Неправильный номер смены" skip
     1640         "p-shift-num" p-shift-num skip
     1641         view-as alert-box error .
     1642       undo, return error return-value .
     1643     end.
     1644     assign
     1645       p-fact-order           = v-fact-date-num
     1646                              + v-shift-offset * 0.5
     1647                              + p-shift-num    * 0.02 - 0.01
     1648                              + p-fact-num     * 0.0000000001
     1649       p-shift-end-fact-order = v-fact-date-num
     1650                              + v-shift-offset * 0.5
     1651                              + p-shift-num    * 0.02
     1652       p-day-end-fact-order   = v-fact-date-num
     1653                              + 0.99
     1654     .
     1655     if p-fact-order           <= v-fact-date-num
     1656     or p-shift-end-fact-order <= v-fact-date-num
     1657     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1658     or p-shift-end-fact-order >= p-day-end-fact-order
     1659     then do:
     1660       message
     1661         vss-workfile vss-revision vss-description skip
     1662         "Внутренняя ошибка при генерации фактического номера" skip
     1663         "p-fact-date"            p-fact-date            skip
     1664         "p-fact-time"            p-fact-time            skip
     1665         "p-fact-num"             p-fact-num             skip
     1666         "p-shift-date"           p-shift-date           skip
     1667         "p-shift-num"            p-shift-num            skip
     1668         "p-shift-on"             p-shift-on             skip
     1669         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1670         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1671         "v-fact-date-num"        v-fact-date-num        skip
     1672         view-as alert-box error .
     1673       undo, return error return-value .
     1674     end.
     1675   end procedure.
     1676   procedure day-begin-fact-order :
     1677     define input  parameter p-fact-date            as date    no-undo .
     1678     define output parameter p-day-begin-fact-order as decimal no-undo .
     1679     do
     1680     on error undo, return error return-value
     1681     :
     1682       if p-fact-date = ?
     1683       then do:
     1684         assign
     1685           p-day-begin-fact-order = 0
     1686         .
     1687       end.
     1688       else do:
     1689         assign
     1690           p-day-begin-fact-order = integer(p-fact-date)
     1691         .
     1692       end.
     1693     end.
     1694   end procedure.
     1695   procedure factord-max-fact-order :
     1696     define output parameter p-max-fact-order as decimal   no-undo .
     1697     do
     1698     on error undo, return error return-value
     1699     :
     1700       run day-begin-fact-order in this-procedure
     1701         (input  date(1, 1, 5000)
     1702         ,output p-max-fact-order
     1703         ) .
     1704     end.
     1705   end procedure.
     1706   procedure factord-cut-archive :
     1707     define input  parameter p-obj-type             as character no-undo .
     1708     define input  parameter p-obj-code             as integer   no-undo .
     1709     define input  parameter p-fact-date            as date      no-undo .
     1710     define output parameter p-shift-on             as logical   no-undo .
     1711     define output parameter p-shift-date           as date      no-undo .
     1712     define output parameter p-shift-num            as integer   no-undo .
     1713     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1714     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1715     define variable v-fact-order as decimal   no-undo .
     1716     define buffer buf_shift-obj for ub.shift-obj .
     1717     do
     1718     on error undo, return error return-value
     1719     :
     1720   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1721   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1722     (input  p-obj-type
     1723     ,input  p-obj-code
     1724     ,input  'shift-on=request'
     1725     ,output p-shift-on
     1726     ) no-error .
     1727       if error-status :error
     1728       then do:
     1729         message
     1730           vss-workfile vss-revision vss-description skip
     1731           "Ошибка при определении атрибута объекта" skip
     1732           "Объект" p-obj-type p-obj-code skip
     1733           error-status :get-message(1) skip
     1734           return-value skip
     1735           view-as alert-box error .
     1736         undo, return error return-value .
     1737       end.
     1738       if p-shift-on = false
     1739       then do:
     1740         assign
     1741           p-shift-date               = ?
     1742           p-shift-num                = 0
     1743         .
     1744       end.
     1745       else do:
     1746         find first buf_shift-obj share-lock
     1747           where buf_shift-obj.obj-type   = p-obj-type
     1748             and buf_shift-obj.obj-code   = p-obj-code
     1749             and buf_shift-obj.shift-date > p-fact-date
     1750           use-index pi
     1751           no-error .
     1752         if not available buf_shift-obj
     1753         or buf_shift-obj.status_ <> 'зкр':U
     1754         then do:
     1755           message
     1756             vss-workfile vss-revision vss-description skip
     1757             "Невозможно вычислить последнюю смену" skip
     1758             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1759             "Объект" p-obj-type p-obj-code skip
     1760             "Дата" p-fact-date skip
     1761             view-as alert-box error .
     1762           undo, return error return-value .
     1763         end.
     1764         find last buf_shift-obj share-lock
     1765           where buf_shift-obj.obj-type = p-obj-type
     1766             and buf_shift-obj.obj-code = p-obj-code
     1767             and buf_shift-obj.shift-date <= p-fact-date
     1768           use-index pi
     1769           no-error .
     1770         if available buf_shift-obj
     1771         then do:
     1772           if  buf_shift-obj.status_ = 'зкр':U
     1773           then do:
     1774             assign
     1775               p-shift-date = buf_shift-obj.shift-date
     1776               p-shift-num  = buf_shift-obj.shift-num
     1777             .
     1778           end.
     1779           else do:
     1780             message
     1781               vss-workfile vss-revision vss-description skip
     1782               "Невозможно вычислить последнюю смену" skip
     1783               "Статус смены отличен от статуса" 'зкр':U skip
     1784               "Объект" p-obj-type p-obj-code skip
     1785               "Дата" p-fact-date skip
     1786               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1787               view-as alert-box error .
     1788             undo, return error return-value .
     1789           end.
     1790         end.
     1791         else do:
     1792           assign
     1793             p-shift-date = p-fact-date - 1
     1794             p-shift-num  = 1
     1795           .
     1796         end.
     1797       end.
     1798       run factord in this-procedure
     1799         (input  p-fact-date
     1800         ,input  1
     1801         ,input  1
     1802         ,input  p-shift-date
     1803         ,input  p-shift-num
     1804         ,input  p-shift-on
     1805         ,output v-fact-order
     1806         ,output p-shift-end-fact-order
     1807         ,output p-day-end-fact-order
     1808         ) no-error .
     1809       if error-status :error
     1810       then do:
     1811         message
     1812           vss-workfile vss-revision vss-description skip
     1813           "Ошибка при вызове процедуры factord"
     1814           error-status :get-message(1) skip
     1815           return-value skip
     1816           view-as alert-box error .
     1817         undo, return error return-value .
     1818       end.
     1819     end.
     1820   end procedure.
     1821   procedure factord-lock-shift :
     1822     define input  parameter p-obj-type  as character no-undo .
     1823     define input  parameter p-obj-code  as integer   no-undo .
     1824     define input  parameter p-fact-date as date      no-undo .
     1825     define parameter buffer buf_shift-obj for ub.shift-obj .
     1826     define variable v-shift-on      as logical   no-undo .
     1827     define variable v-extra-message as character no-undo .
     1828     define variable v-error as character no-undo .
     1829     do
     1830     on error undo, return error return-value
     1831     :
     1832   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1833   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1834     (input  p-obj-type
     1835     ,input  p-obj-code
     1836     ,input  'shift-on=request'
     1837     ,output v-shift-on
     1838     ) no-error .
     1839       if error-status :error
     1840       then do:
     1841         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1842         undo, return error v-error .
     1843       end.
     1844       if v-shift-on = true
     1845       then do:
     1846         find first buf_shift-obj share-lock
     1847           where buf_shift-obj.obj-type   = p-obj-type
     1848             and buf_shift-obj.obj-code   = p-obj-code
     1849             and buf_shift-obj.shift-date > p-fact-date
     1850           use-index pi
     1851           no-error .
     1852         if not available buf_shift-obj
     1853         or buf_shift-obj.status_ <> 'зкр':U
     1854         then do:
     1855           find last buf_shift-obj
     1856             where buf_shift-obj.obj-type = p-obj-type
     1857               and buf_shift-obj.obj-code = p-obj-code
     1858               and buf_shift-obj.status_  = 'зкр':U
     1859             use-index stts
     1860             no-error .
     1861           if available buf_shift-obj
     1862           then do:
     1863             assign
     1864               v-extra-message =
     1865                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1866                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1867                               )
     1868             .
     1869           end.
     1870           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1871           undo, return error v-error .
     1872         end.
     1873       end.
     1874     end.
     1875   end procedure.
     1876   procedure factord-end-day :
     1877     define input  parameter p-fact-date            as date    no-undo .
     1878     define output parameter p-day-end-fact-order   as decimal no-undo .
     1879     do
     1880     on error undo, return error return-value
     1881     :
     1882       if p-fact-date = ?
     1883       then do:
     1884         return error "Не указана фактическая дата" .
     1885       end.
     1886       assign
     1887         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1888       .
     1889     end.
     1890   end procedure.
     1891   procedure factord-to-date :
     1892     define input  parameter p-fact-order as decimal no-undo .
     1893     define output parameter p-fact-date  as date    no-undo .
     1894     define variable v-ref-date  as date      no-undo .
     1895     define variable v-ref-delta as integer   no-undo .
     1896     do
     1897     on error undo, return error return-value
     1898     :
     1899       if p-fact-order = ?
     1900       or p-fact-order = 0
     1901       then do:
     1902         return error "Не указан fact-order" .
     1903       end.
     1904       assign
     1905         v-ref-date  = date(1, 1, 2000)
     1906       .
     1907       assign
     1908         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1909       .
     1910       assign
     1911         p-fact-date = v-ref-date + v-ref-delta
     1912       .
     1913     end.
     1914   end procedure.
     1915   procedure factord-to-fact-num :
     1916     define input  parameter p-fact-order as decimal no-undo .
     1917     define output parameter p-fact-num   as integer no-undo .
     1918     define variable v-fact-order-trunc as decimal no-undo .
     1919     do
     1920     on error undo, return error return-value
     1921     :
     1922       if p-fact-order = ?
     1923       or p-fact-order = 0
     1924       then do:
     1925         return error "Не указан fact-order" .
     1926       end.
     1927       assign
     1928        v-fact-order-trunc = truncate(p-fact-order, 2)
     1929       .
     1930       assign
     1931         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1932       .
     1933     end.
     1934   end procedure.
     1935   procedure factord-to-shift-num :
     1936     define input  parameter p-fact-order as decimal no-undo .
     1937     define output parameter p-shift-num   as integer no-undo .
     1938     define variable  p-shift-numd  as decimal   no-undo .
     1939     define variable v-fact-order-trunc as decimal no-undo .
     1940     do
     1941     on error undo, return error return-value
     1942     :
     1943       if p-fact-order = ?
     1944       or p-fact-order = 0
     1945       then do:
     1946         return error "Не указан fact-order" .
     1947       end.
     1948       assign
     1949        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1950       .
     1951       if v-fact-order-trunc < 0.5 then do:
     1952         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1953       end.
     1954       assign
     1955         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1956         .
     1957        assign
     1958         p-shift-num = truncate (p-shift-numd , 0)
     1959       .
     1960     end.
     1961   end procedure.
     1962   procedure fact-order-mpl :
     1963     do
     1964     on error undo, return error return-value
     1965     :
     1966   define input  parameter p-doc-date as date     no-undo .
     1967   define input  parameter p-obj-type as character no-undo .
     1968   define input  parameter p-obj-code as integer   no-undo .
     1969   define output parameter p-fact-order as decimal   no-undo .
     1970   define variable v-fact-date            as date    no-undo .
     1971   define variable v-fact-time            as integer no-undo .
     1972   define variable v-fact-order           as decimal no-undo .
     1973   define variable v-shift-end-fact-order as decimal no-undo .
     1974   define variable v-day-end-fact-order   as decimal no-undo .
     1975   define variable l-shift-on as logical no-undo .
     1976   define variable l-date as date      no-undo .
     1977   define variable l-time as integer   no-undo .
     1978   define variable shift-date as date      no-undo .
     1979   define variable shift-num  as integer   no-undo .
     1980   define variable shift-name as character no-undo .
     1981   define variable max-fact-order as decimal   no-undo .
     1982   define buffer buf_global-state for ub.global-state  .
     1983   find first buf_global-state no-lock no-error .
     1984   if not available buf_global-state then do:
     1985      message
     1986        "Не заданы параметры ценообразования!"
     1987        view-as alert-box error
     1988      .
     1989      return error return-value .
     1990   end.
     1991     run cur-time in this-procedure
     1992     ( output v-fact-date ,
     1993       output v-fact-time  ).
     1994   if p-doc-date = ? then do:
     1995   if buf_global-state.pl-use-sys-date-time  = true then do:
     1996         run factord in this-procedure
     1997           (input  v-fact-date
     1998           ,input  v-fact-time
     1999           ,input  v-fact-time
     2000           ,input  ?
     2001           ,input  ?
     2002           ,input  false
     2003           ,output v-fact-order
     2004           ,output v-shift-end-fact-order
     2005           ,output v-day-end-fact-order
     2006           ) no-error .
     2007         if error-status :error
     2008         or v-fact-order = ?
     2009         or v-fact-order = 0 then do:
     2010           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     2011         end.
     2012         p-fact-order = v-fact-order .
     2013   end.
     2014   else do:
     2015   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2016   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     2017     (input  p-obj-type
     2018     ,input  p-obj-code
     2019     ,input  'shift-on=request'
     2020     ,output l-shift-on
     2021     ) no-error .
     2022         if error-status :error then return error "Неопределена дата на объекте " + return-value .
     2023         if p-doc-date <> ? then do:
     2024         end.
     2025          run gbl/factdate.p
     2026          ( input        p-obj-type  ,
     2027            input        p-obj-code  ,
     2028            input-output v-fact-date ,
     2029            input-output v-fact-time ,
     2030            input-output shift-date      ,
     2031            input-output shift-num       ,
     2032            input-output shift-name      ,
     2033            input        yes
     2034            ) no-error .
     2035         if error-status :error then return error substitute(" Ошибка из factdate.p: &1 &2"  , return-value , error-status :get-message(1)   ) .
     2036         run factord in this-procedure
     2037           (input  v-fact-date
     2038           ,input  v-fact-time
     2039           ,input  v-fact-time
     2040           ,input  shift-date
     2041           ,input  shift-num
     2042           ,input  l-shift-on
     2043           ,output v-fact-order
     2044           ,output v-shift-end-fact-order
     2045           ,output v-day-end-fact-order
     2046           ) no-error .
     2047         if error-status :error
     2048         or v-fact-order = ?
     2049         or v-fact-order = 0 then do:
     2050           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     2051         end.
     2052         p-fact-order = v-fact-order .
     2053   end.
     2054   end.
     2055   else do:
     2056          run gbl/factdate.p
     2057          ( input        p-obj-type  ,
     2058            input        p-obj-code  ,
     2059            input-output v-fact-date ,
     2060            input-output v-fact-time ,
     2061            input-output shift-date      ,
     2062            input-output shift-num       ,
     2063            input-output shift-name      ,
     2064            input        yes
     2065            ) no-error .
     2066         if error-status :error then return error "Ошибка factdate.p " + return-value .
     2067         v-fact-date = p-doc-date .
     2068         run factord in this-procedure
     2069           (input  v-fact-date
     2070           ,input  v-fact-time
     2071           ,input  v-fact-time
     2072           ,input  shift-date
     2073           ,input  shift-num
     2074           ,input  l-shift-on
     2075           ,output v-fact-order
     2076           ,output v-shift-end-fact-order
     2077           ,output v-day-end-fact-order
     2078           ) no-error .
     2079         if error-status :error
     2080         or v-fact-order = ?
     2081         or v-fact-order = 0 then do:
     2082           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     2083         end.
     2084         p-fact-order = v-fact-order .
     2085   end.
     2086     end.
     2087   end procedure.
     2088   DEFINE TEMP-TABLE tt_price-all NO-UNDO LIKE ub.price-all
