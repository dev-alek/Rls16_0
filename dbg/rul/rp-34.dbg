     1317   p-value-type = integer('2':U).
     1318   v-price = p-price.
     1319   find first buf_dis-rule no-lock where
     1320           buf_dis-rule.rule-num = p-rule-num no-error.
     1321   if available buf_dis-rule
     1322   and buf_dis-rule.sts = integer('0':U)
     1323   and (buf_Dis-rule.time-templ-rl-root <= 50000 or dynamic-function( "dis-time-rule_" + string(buf_dis-rule.time-templ-rl-root - 50000, "99999")                                        , input buf_dis-rule.time-rule-num                                         , input p-date                                        , input p-time ))
     1324   then do:
     1325     for each buf_term-dis-rule no-lock where
     1326             buf_term-dis-rule.upper-rule-num = buf_dis-rule.rule-num
     1327     and buf_term-dis-rule.dis-kat = p-dis-kat :
     1328       case buf_term-dis-rule.value-type:
