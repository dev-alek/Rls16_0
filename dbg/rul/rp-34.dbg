        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-parent-handle as handle no-undo .
        4   define input parameter p-log-handle  as handle no-undo .
        5   define input parameter p-cont-handle  as handle no-undo .
        6   define input parameter p-call-id as character no-undo .
        7   define input parameter p-profile-id as integer no-undo .
        8   define input parameter p-once-more as integer   no-undo .
        9   define input parameter p-host-code like ub.sysconf.host-code no-undo .
       10   define input parameter p-obj-type like ub.clients.obj-type no-undo .
       11   define input parameter p-obj-code like ub.clients.obj-code no-undo .
       12   define input parameter p-pos-type as character no-undo .
       13   define input parameter p-pos-type-for-discnt as character no-undo .
       14   define input parameter log-file-name as character no-undo .
       15   define input parameter p-dr-flddf as handle no-undo .
       16   define input parameter p-bh as handle no-undo extent 6.
       17   define variable vss-revision    as character no-undo init "$Revision$":U .
       18   define variable vss-author      as character no-undo init "$Author$":U .
       19   define variable vss-date        as character no-undo init "$Date$":U .
       20   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       21   define variable vss-archive     as character no-undo init "$Archive$":U .
       22   define variable vss-description as character no-undo init "Вспомогательный файл к кодексам правил 15-16-17".
       23   procedure vss-get-info :
       24     define output parameter p-vss-revision    like vss-revision    no-undo .
       25     define output parameter p-vss-author      like vss-author      no-undo .
       26     define output parameter p-vss-date        like vss-date        no-undo .
       27     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       28     define output parameter p-vss-archive     like vss-archive     no-undo .
       29     define output parameter p-vss-description like vss-description no-undo .
       30     assign
       31       p-vss-revision    = vss-revision
       32       p-vss-author      = vss-author
       33       p-vss-date        = vss-date
       34       p-vss-workfile    = vss-workfile
       35       p-vss-archive     = vss-archive
       36       p-vss-description = vss-description
       37     .
       38   end procedure.
       39   procedure vss-get-parameters :
       40     define output parameter p-vss-parameters as character no-undo .
       41   end procedure.
       42   define new global shared variable g#vssrevis-logger as handle    no-undo .
       43   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       44   define variable v-vssrevis-logger                   as handle    no-undo .
       45   procedure vss-logevent :
       46     define input  parameter p-extra-paramters as character no-undo .
       47     define variable v-vssrevis-parameters as character no-undo .
       48     do
       49     on error undo, return error return-value
       50     :
       51       if  valid-handle(v-vssrevis-logger)
       52       and v-vssrevis-logger :get-signature("logevent") <> ""
       53       then do:
       54         run vss-get-parameters in this-procedure
       55           (output v-vssrevis-parameters
       56           ).
       57         run logevent in v-vssrevis-logger
       58           (input vss-workfile
       59           ,input vss-revision
       60           ,input v-vssrevis-parameters
       61           ,input p-extra-paramters
       62           ).
       63       end.
       64     end.
       65   end procedure.
       66   assign
       67     v-vssrevis-logger = g#vssrevis-logger
       68   .
       69   if  valid-handle(v-vssrevis-logger)
       70   and v-vssrevis-logger :get-signature("logevent") <> ""
       71   then do:
       72     assign
       73       v-vssrevis-logevent = true
       74     .
       75     run vss-logevent in this-procedure (input vss-description) .
       76   end.
       77   define new global shared variable g#language as character no-undo .
       78   if g#language <> '' and g#language <> 'rus':U then do:
       79     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       80   end.
       81   define new global shared variable g#library  as handle no-undo .
       82   define new global shared variable g#library2 as handle no-undo .
       83   define   shared variable g#auto as logical no-undo.
       84   define   shared variable g#news as logical no-undo.
       85   define   shared variable g#oxml as logical no-undo.
       86   define   shared variable g#esys as logical no-undo.
       87   define   shared variable g#news-source-db as integer no-undo.
       88   define   shared variable g#esys-source-esys as integer no-undo.
       89   define   shared variable g#db-num as integer   no-undo .
       90   define   shared variable g#userid as character no-undo .
       91   define   shared variable g#passwd as character no-undo .
       92   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       93   define  variable garbcoll_ii as integer no-undo .
       94   define  temp-table temp-gc no-undo
       95   field ii as integer
       96   field obj-r as handle
       97   field cn as character
       98   index pi is unique primary
       99   ii
      100   index icn
      101   cn.
      102   procedure garbcoll_create-gc-entry :
      103   define input parameter p-cn as character no-undo .
      104   define input parameter p-obj-r as handle no-undo .
      105     do
      106     on error undo, return error
      107     :
      108       create temp-gc.
      109       assign
      110       temp-gc.ii = garbcoll_ii
      111       garbcoll_ii = garbcoll_ii + 1
      112       temp-gc.cn = p-cn
      113       temp-gc.obj-r = p-obj-r
      114       .
      115     end.
      116   end procedure.
      117   procedure garbcoll_clear :
      118     do
      119     on error undo, return error
      120     :
      121       for each temp-gc:
      122         delete object temp-gc.obj-r.
      123         delete temp-gc.
      124       end.
      125     end.
      126   end procedure.
      127   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      128   procedure cur-time :
      129      define output parameter p-today as date      no-undo .
      130      define output parameter p-time  as integer   no-undo .
      131     do
      132     on error undo, return error
      133     :
      134       define variable v-date1 as date      no-undo .
      135       define variable v-date2 as date      no-undo .
      136       define variable v-time  as integer   no-undo .
      137       assign
      138         v-date1 = today
      139         v-time  = time
      140         v-date2 = today
      141       .
      142       if v-date1 <> v-date2
      143       then do:
      144         assign
      145           v-date1 = today
      146           v-time  = v-time
      147         .
      148       end.
      149       assign
      150         p-today = v-date1
      151         p-time  = v-time
      152       .
      153     end.
      154   end.
      155   function cur-time-date returns character
      156   :
      157     return string(today, '99/99/9999':U) .
      158   end.
      159   function cur-time-mjd returns decimal
      160   :
      161     define variable v-date as date      no-undo .
      162     define variable v-time as integer   no-undo .
      163     run cur-time in this-procedure
      164       (output v-date
      165       ,output v-time
      166       ) .
      167     return integer(v-date) - 2400002 + (v-time / 86400) .
      168   end.
      169   function cur-time-get-ending-index returns integer
      170   (input p-number as integer
      171   )
      172   :
      173     if p-number < 0
      174     or p-number = ?
      175     then do:
      176       return 1 .
      177     end.
      178     define variable v-rest as integer   no-undo .
      179     assign
      180       p-number = p-number modulo 100
      181     .
      182     if p-number < 20
      183     then do:
      184       assign
      185         v-rest = p-number
      186       .
      187     end.
      188     else do:
      189       assign
      190         v-rest = p-number modulo 10
      191       .
      192     end.
      193     case v-rest :
      194       when 1
      195       then do:
      196         return 2 .
      197       end.
      198       when 2 or
      199       when 3 or
      200       when 4
      201       then do:
      202         return 3 .
      203       end.
      204       otherwise do:
      205         return 1 .
      206       end.
      207     end case .
      208   end.
      209   procedure cur-time-mjd-to-date :
      210      define input  parameter i-mjd-diff as decimal no-undo.
      211      define output parameter o-Date     as date    no-undo.
      212      define output parameter o-Time     as integer no-undo.
      213      define variable v-day-number as integer   no-undo .
      214      if    i-mjd-diff < 0
      215         or i-mjd-diff = ?
      216      then do:
      217         return "?" .
      218      end.
      219      assign
      220         v-day-number = truncate(i-mjd-diff,0).
      221         o-Date = date(v-day-number + 2400002).
      222         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      223     .
      224   end.
      225   function cur-time-mjd-to-string returns character
      226   (input p-mjd-diff as decimal
      227   )
      228   :
      229     define variable v-day-number as integer   no-undo .
      230     define variable v-seconds    as integer   no-undo .
      231     define variable v-hour       as integer   no-undo .
      232     define variable v-min        as integer   no-undo .
      233     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      234     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      235     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      236     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      237     if p-mjd-diff < 0
      238     or p-mjd-diff = ?
      239     then do:
      240       return "?" .
      241     end.
      242     assign
      243       v-day-number = integer(truncate(p-mjd-diff,0))
      244       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      245     .
      246     if v-seconds > 86400
      247     then do:
      248       assign
      249         v-seconds = 86400 - 1
      250       .
      251     end.
      252     if v-seconds < 0
      253     then do:
      254       assign
      255         v-seconds = 0
      256       .
      257     end.
      258     assign
      259       v-hour = truncate(v-seconds / 3600, 0)
      260     .
      261     assign
      262       v-seconds = v-seconds modulo 3600
      263     .
      264     assign
      265       v-min = truncate(v-seconds / 60, 0)
      266     .
      267     assign
      268       v-seconds = v-seconds modulo 60
      269     .
      270     return
      271         (if v-day-number <> 0
      272           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      273           else ""
      274         )
      275       + (if v-day-number <> 0 or v-hour <> 0
      276           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      277           else ""
      278         )
      279       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      280           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      281           else ""
      282         )
      283       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      284       .
      285   end.
      286   function cur-time-string returns character
      287   :
      288     define variable v-date as date      no-undo .
      289     define variable v-time as integer   no-undo .
      290     run cur-time in this-procedure
      291       (output v-date
      292       ,output v-time
      293       ) .
      294     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      295   end.
      296   function cur-time-string-sec returns character
      297   :
      298     define variable v-date as date      no-undo .
      299     define variable v-time as integer   no-undo .
      300     run cur-time in this-procedure
      301       (output v-date
      302       ,output v-time
      303       ) .
      304     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      305   end.
      306   function cur-time-custom  returns character
      307   (input p-prefix as character
      308   ,input p-date-format as character
      309   ,input p-delimiter as character
      310   ,input p-time-format as character
      311   ,input p-suffix as character
      312   )
      313   :
      314     define variable v-date as date      no-undo .
      315     define variable v-time as integer   no-undo .
      316     run cur-time in this-procedure
      317       (output v-date
      318       ,output v-time
      319       ) .
      320     return
      321       p-prefix
      322       + string(v-date, p-date-format)
      323       + p-delimiter
      324       + string(v-time, p-time-format)
      325       + p-suffix
      326       .
      327   end.
      328   function cur-time-print  returns character
      329   :
      330     define variable v-date as date      no-undo .
      331     define variable v-time as integer   no-undo .
      332     run cur-time in this-procedure
      333       (output v-date
      334       ,output v-time
      335       ) .
      336     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      337   end.
      338   function cur-time-datetime returns datetime
      339   :
      340     define variable v-char as character no-undo .
      341     define variable v-datetime as datetime no-undo .
      342     v-char = cur-time-string().
      343     v-datetime = datetime(v-char).
      344     return  v-datetime.
      345   end.
      346   function cur-time-string-msec returns character
      347   :
      348     define variable v-date as datetime  no-undo .
      349     v-date = now.
      350     return string(v-date) .
      351   end.
      352   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      353   procedure library-cls_get-handle :
      354   define input parameter p-library-name as character no-undo .
      355   define output parameter p-library-handle as handle no-undo .
      356     do
      357     on error undo, return error
      358     :
      359       CASE p-library-name:
      360         when "library" then do:
      361           if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end.
      362           p-library-handle = g#library.
      363         end.
      364         when "library2" then do:
      365           if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end.
      366           p-library-handle = g#library2.
      367         end.
      368       end case.
      369     end.
      370   end procedure.
      371   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      372   def var vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      373   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      374   function loc-weekday returns integer ( input p-date as date):
      375   Case weekday(p-date):
      376     when 1 then return 7.
      377     otherwise return  weekday(p-date) - 1.
      378   end case.
      379   end function.
      380   FUNCTION DIS-TIME-RULE_-1 returns logical ( input p-time-rule-num as integer, input p-date as date, input p-time as integer):
      381   return yes.
      382   end function.
      383   FUNCTION DIS-TIME-RULE_-50001 returns logical ( input p-time-rule-num as integer, input p-date as date, input p-time as integer):
      384   return yes.
      385   end function.
      386   FUNCTION DIS-TIME-RULE_00000 returns logical ( input p-time-rule-num as integer, input p-date as date, input p-time as integer):
      387   return yes.
      388   end function.
      389   FUNCTION DIS-TIME-RULE_00001 returns logical ( input p-time-rule-num as integer, input p-date as date, input p-time as integer):
      390   return yes.
      391   end function.
      392   FUNCTION DIS-TIME-RULE_00002 returns logical ( input p-time-rule-num as integer, input p-date as date, input p-time as integer):
      393   define buffer buf_dis-time-rule for ub.dis-time-rule.
      394   find first buf_dis-time-rule no-lock where
      395             buf_dis-time-rule.time-rule-num = p-time-rule-num no-error.
      396   if available buf_dis-time-rule
      397   and buf_dis-time-rule.sts = integer ('0':U) then do:
      398     if buf_dis-time-rule.time-from <= p-time
      399     and buf_dis-time-rule.time-to >= p-time then do:
      400       return yes.
      401     end.
      402   end.
      403   return no.
      404   end function.
      405   FUNCTION DIS-TIME-RULE_00003 returns logical ( input p-time-rule-num as integer, input p-date as date, input p-time as integer):
      406   define buffer buf_dis-time-rule for ub.dis-time-rule.
      407   find first buf_dis-time-rule no-lock where
      408             buf_dis-time-rule.time-rule-num = p-time-rule-num no-error.
      409   if available buf_dis-time-rule
      410   and buf_dis-time-rule.sts = integer ('0':U) then do:
      411     if buf_dis-time-rule.date-from <= p-date
      412     and buf_dis-time-rule.date-to >= p-date then do:
      413       return yes.
      414     end.
      415   end.
      416   return no.
      417   end function.
      418   FUNCTION DIS-TIME-RULE_00004 returns logical ( input p-time-rule-num as integer, input p-date as date, input p-time as integer):
      419   define buffer buf_dis-time-rule for ub.dis-time-rule.
      420   find first buf_dis-time-rule no-lock where
      421             buf_dis-time-rule.time-rule-num = p-time-rule-num no-error.
      422   if available buf_dis-time-rule
      423   and buf_dis-time-rule.sts = integer ('0':U) then do:
      424     if buffer buf_dis-time-rule:buffer-field("week-day-" + string(loc-weekday(p-date) )):buffer-value = yes
      425     then do:
      426       return yes.
      427     end.
      428   end.
      429   return no.
      430   end function.
      431   FUNCTION DIS-TIME-RULE_00005 returns logical ( input p-time-rule-num as integer, input p-date as date, input p-time as integer):
      432   define buffer buf_dis-time-rule for ub.dis-time-rule.
      433   find first buf_dis-time-rule no-lock where
      434             buf_dis-time-rule.time-rule-num = p-time-rule-num no-error.
      435   if available buf_dis-time-rule
      436   and buf_dis-time-rule.sts = integer ('0':U) then do:
      437     if buffer buf_dis-time-rule:buffer-field("week-day-" + string(loc-weekday(p-date) )):buffer-value = yes
      438     then do:
      439       return yes.
      440     end.
      441   end.
      442   return no.
      443   end function.
      444   FUNCTION DIS-TIME-RULE_00006 returns logical ( input p-time-rule-num as integer, input p-date as date, input p-time as integer):
      445   define buffer buf_dis-time-rule for ub.dis-time-rule.
      446   find first buf_dis-time-rule no-lock where
      447             buf_dis-time-rule.time-rule-num = p-time-rule-num no-error.
      448   if available buf_dis-time-rule
      449   and buf_dis-time-rule.sts = integer ('0':U) then do:
      450     if buf_dis-time-rule.month-day = day(p-date) then do:
      451       return yes.
      452     end.
      453     return no.
      454   end.
      455   else do:
      456     return no.
      457   end.
      458   end function.
      459   FUNCTION DIS-TIME-RULE_00007 returns logical ( input p-time-rule-num as integer, input p-date as date, input p-time as integer):
      460   define buffer buf_dis-time-rule for ub.dis-time-rule.
      461   find first buf_dis-time-rule no-lock where
      462             buf_dis-time-rule.time-rule-num = p-time-rule-num no-error.
      463   if available buf_dis-time-rule
      464   and buf_dis-time-rule.sts = integer ('0':U) then do:
      465     if buf_dis-time-rule.date-from <= p-date
      466     and buf_dis-time-rule.date-to >= p-date
      467     and buf_dis-time-rule.time-from <= p-time
      468     and buf_dis-time-rule.time-to >= p-time then do:
      469       return yes.
      470     end.
      471   end.
      472   return no.
      473   end function.
      474   FUNCTION DIS-TIME-RULE_00008 returns logical ( input p-time-rule-num as integer, input p-date as date, input p-time as integer):
      475   define buffer buf_dis-time-rule for ub.dis-time-rule.
      476   find first buf_dis-time-rule no-lock where
      477             buf_dis-time-rule.time-rule-num = p-time-rule-num no-error.
      478   if available buf_dis-time-rule
      479   and buf_dis-time-rule.sts = integer ('0':U) then do:
      480     if buf_dis-time-rule.date-from <= p-date
      481     and buf_dis-time-rule.date-to >= p-date
      482     and (buffer buf_dis-time-rule:buffer-field("week-day-" + string(loc-weekday(p-date) )):buffer-value = yes
      483          or buf_dis-time-rule.week-day-0 = yes)
      484     and buf_dis-time-rule.time-from <= p-time
      485     and buf_dis-time-rule.time-to >= p-time
      486     then do:
      487       return yes.
      488     end.
      489   end.
      490   return no.
      491   end function.
      492   FUNCTION DIS-TIME-RULE_00009 returns logical ( input p-time-rule-num as integer, input p-date as date, input p-time as integer):
      493   define buffer buf_dis-time-rule for ub.dis-time-rule.
      494   define buffer buf_term-dis-time-rule for ub.dis-time-rule.
      495   find first buf_dis-time-rule no-lock where
      496             buf_dis-time-rule.time-rule-num = p-time-rule-num no-error.
      497   if available buf_dis-time-rule
      498   and buf_dis-time-rule.sts = integer ('0':U) then do:
      499     for each buf_term-dis-time-rule no-lock where
      500             buf_term-dis-time-rule.upper-time-rule-num = buf_dis-time-rule.time-rule-num:
      501       if buf_term-dis-time-rule.time-from <= p-time
      502       and buf_term-dis-time-rule.time-to >= p-time
      503       and buffer buf_term-dis-time-rule:buffer-field("week-day-" + string(loc-weekday(p-date) )):buffer-value = yes
      504       then do:
      505         return yes.
      506       end.
      507     end.
      508   end.
      509   return no.
      510   end function.
      511   FUNCTION DIS-TIME-RULE_00010 returns logical ( input p-time-rule-num as integer, input p-date as date, input p-time as integer):
      512   define buffer buf_dis-time-rule for ub.dis-time-rule.
      513   find first buf_dis-time-rule no-lock where
      514             buf_dis-time-rule.time-rule-num = p-time-rule-num no-error.
      515   if available buf_dis-time-rule
      516   and buf_dis-time-rule.sts = integer ('0':U) then do:
      517     if buffer buf_dis-time-rule:buffer-field("week-day-" + string(loc-weekday(p-date) )):buffer-value = yes
      518     then do:
      519       return yes.
      520     end.
