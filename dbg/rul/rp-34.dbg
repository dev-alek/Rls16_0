     2151   define buffer buf_buyer-group            for ub.buyer-group  .
     2152   define buffer buf_turnover-group         for ub.turnover-group  .
     2153   define buffer buf_main-code              for ub.bar-code  .
     2154   define buffer buf_bar-code               for ub.bar-code  .
     2155   define buffer buf_pay-type               for ub.pay-type  .
     2156   define buffer buf_cash-pay               for ub.cash-pay  .
     2157   define variable to-day          as date      no-undo .
     2158   define variable v-base-rate0    as decimal   no-undo .
     2159   define variable v-base-scale0   as decimal   no-undo .
     2160   define variable v-exch-rate0    as decimal   no-undo .
     2161   define variable v-exch-scale0   as decimal   no-undo .
     2162   define variable v-base-rate     as decimal   no-undo .
     2163   define variable v-base-scale    as decimal   no-undo .
     2164   define variable v-exch-rate     as decimal   no-undo .
     2165   define variable v-exch-scale    as decimal   no-undo .
     2166   define variable v-host-code     as integer   no-undo .
     2167   define variable v-curr-abbr     as character no-undo .
     2168   define variable v-grp-name      as character no-undo .
     2169   define variable v-date-1        as date      no-undo .
     2170   define variable v-date-2        as date      no-undo .
     2171   define variable v-interv        as character no-undo .
     2172   define variable v-pay-name      as character no-undo .
     2173   define variable v-cli-oborot    as decimal   no-undo .
     2174   define variable v-trn-pay-code  as integer   no-undo .
     2175   define variable v-cash-pay-curr as integer   no-undo .
     2176   define variable v-cash-pay-code as integer   no-undo .
     2177   do
     2178   on error undo, return error return-value
     2179   :
     2180   find first buf_main-code no-lock where buf_main-code.b-code = p-main-b-code .
     2181   find first buf_goods no-lock where buf_goods.gds-code = buf_main-code.gds-code.
     2182   if p-fact-order = ? then do:
     2183     run fact-order-mpl (
     2184         input   today       ,
     2185         input   p-obj-type  ,
     2186         input   p-obj-code  ,
     2187         output  p-fact-order ).
     2188   end.
     2189   if p-vid-pay <> "" then do:
     2190      find first buf_pay-type no-lock where  buf_pay-type.obj-code = integer(p-vid-pay) no-error .
     2191      if available buf_pay-type
     2192         then v-trn-pay-code = buf_pay-type.obj-code.
     2193         else v-trn-pay-code =  0.
     2194   end.
     2195   else v-trn-pay-code = 0 .
     2196   if p-cash-pay-type <> "" then do:
     2197      find first buf_cash-pay no-lock where  recid(buf_cash-pay) = integer(p-cash-pay-type) no-error .
     2198      if available buf_pay-type
     2199         then
     2200           assign
     2201             v-cash-pay-curr = buf_cash-pay.curr-code
     2202             v-cash-pay-code = buf_cash-pay.cdpay-code
     2203           .
     2204         else
     2205           assign
     2206             v-cash-pay-curr = 0
     2207             v-cash-pay-code = 0
     2208             .
     2209   end.
     2210   else
     2211     assign
     2212       v-cash-pay-curr = 0
     2213       v-cash-pay-code = 0
     2214       .
     2215   for each tt_price-all  : delete tt_price-all . end.
     2216   assign
     2217     p-plt-id             = ?
     2218     p-plt-db-num         = ?
     2219     p-pdf-id             = ?
     2220     p-pdf-db-num         = ?
     2221     p-sale-price-base    = ?
     2222     p-sale-price-rubl    = ?
     2223     v-cli-oborot         = 0
     2224   .
     2225   find first buf_global-state no-lock no-error .
     2226   if not available buf_global-state then do:
     2227      message
     2228        "Не заданы параметры ценообразования!"
     2229        view-as alert-box error
     2230      .
     2231      return error return-value .
     2232   end.
     2233   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2234   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     2235     (input  p-obj-type
     2236     ,input  p-obj-code
     2237     ,output to-day
     2238     )  .
     2239   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2240   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2241     (input  p-obj-type
     2242     ,input  p-obj-code
     2243     ,output v-host-code
     2244     )  .
     2245   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2246   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     2247     (input  v-host-code
     2248     ,input  to-day
     2249     ,output v-base-rate0
     2250     ,output v-base-scale0
     2251     )  .
     2252     v-cli-oborot-ALL  = 0 .
     2253     for each buf_turnover-buyer-main no-lock  where
     2254              buf_turnover-buyer-main.cli-type = p-cli-type  and
     2255              buf_turnover-buyer-main.cli-code = p-cli-code
     2256              :
     2257              v-cli-oborot-ALL = v-cli-oborot-ALL + buf_turnover-buyer-main.sum-doc-rubl-itog .
     2258     end.
     2259   for each buf_price-all no-lock where
     2260            buf_price-all.obj-type = p-obj-type and
     2261            buf_price-all.obj-code = p-obj-code and
     2262            buf_price-all.gds-code = buf_goods.gds-code and
     2263            buf_price-all.status_  = 'акт':U  and
     2264          ( p-only-b-code = false   or
     2265          ( buf_price-all.b-code = p-main-b-code or
     2266            buf_price-all.b-code = p-b-code))    and
     2267           ( p-only-b-code = true  or
     2268             buf_price-all.b-code = p-b-code)
     2269             and
     2270             buf_price-all.fact-order-sys-from  <= p-fact-order  and
     2271           ( buf_price-all.fact-order-sys-to = ? or
     2272             buf_price-all.fact-order-sys-to    >= p-fact-order)
     2273           :
     2274            v-interv   = "" .
     2275            v-grp-name = "" .
     2276            v-pay-name = "" .
     2277            if buf_price-all.fact-order = 0  and buf_price-all.plt-priority = 0  then next.
     2278            if buf_price-all.bgr-id > 0 then do:
     2279               find first buf_buyer-group no-lock where
     2280                          buf_buyer-group.bgr-id     = buf_price-all.bgr-id  and
     2281                          buf_buyer-group.bgr-db-num = buf_price-all.bgr-db-num  no-error .
     2282               if available buf_buyer-group then do:
     2283                  if p-cli-type <> "" and p-cli-type <> ? then do:
     2284                  find first buf_buyer-in-buyer-group no-lock where
     2285                             buf_buyer-in-buyer-group.stts         = 0 and
     2286                             buf_buyer-in-buyer-group.bgr-id       = buf_buyer-group.bgr-id     and
     2287                             buf_buyer-in-buyer-group.bgr-db-num   = buf_buyer-group.bgr-db-num  and
     2288                             buf_buyer-in-buyer-group.bbg-obj-type = p-cli-type and
     2289                             buf_buyer-in-buyer-group.bbg-obj-code = p-cli-code
     2290                             no-error .
     2291                             if not available buf_buyer-in-buyer-group then do:
     2292                                v-grp-name = "".
     2293                                next.
     2294                             end.
     2295                             v-grp-name = buf_buyer-group.name .
     2296                  end.
     2297               end.
     2298               else do:
     2299                    v-grp-name = "".
     2300                    next.
     2301               end.
     2302            end.
     2303            if buf_price-all.tog-id > 0 then do:
     2304               find first buf_turnover-group no-lock where
     2305                          buf_turnover-group.tog-id     = buf_price-all.tog-id      and
     2306                          buf_turnover-group.tog-db-num = buf_price-all.tog-db-num  no-error .
     2307               if available buf_turnover-group then do:
     2308                  if p-cli-type <> "" and p-cli-type <> ? then do:
     2309                     v-cli-oborot = v-cli-oborot-all  .
     2310                     find first buf1_tnv-in-turnover-group no-lock where
     2311                                buf1_tnv-in-turnover-group.stts       =  0     and
     2312                                buf1_tnv-in-turnover-group.tog-id     =  buf_turnover-group.tog-id     and
     2313                                buf1_tnv-in-turnover-group.tog-db-num =  buf_turnover-group.tog-db-num and
     2314                                buf1_tnv-in-turnover-group.ttg-summa  <=  v-cli-oborot no-error .
     2315                     find first buf2_tnv-in-turnover-group no-lock where
     2316                                buf2_tnv-in-turnover-group.stts       =  0     and
     2317                                buf2_tnv-in-turnover-group.tog-id     =  buf_turnover-group.tog-id     and
     2318                                buf2_tnv-in-turnover-group.tog-db-num =  buf_turnover-group.tog-db-num and
     2319                                buf2_tnv-in-turnover-group.ttg-summa  >=  v-cli-oborot no-error .
     2320                     if not (available buf1_tnv-in-turnover-group and
     2321                             available buf2_tnv-in-turnover-group ) then do:
     2322                             v-grp-name = "".
     2323                             next .
     2324                     end.
     2325                     v-grp-name = buf_turnover-group.name.
     2326                  end.
     2327               end.
     2328               else do:
     2329                    v-grp-name = "".
     2330                    next.
     2331               end.
     2332            end.
     2333            if buf_price-all.plt-fix-cource-crc-base = true then
     2334               assign
     2335                 v-base-rate  = buf_price-all.pdf-base-rate
     2336                 v-base-scale = buf_price-all.pdf-base-scale
     2337               .
     2338               else
     2339               assign
     2340                 v-base-rate  = v-base-rate0
     2341                 v-base-scale = v-base-scale0
     2342               .
     2343            if buf_price-all.plt-fix-cource-crc-doc = true then
     2344               assign
     2345                 v-exch-rate  = buf_price-all.pdf-exch-rate
     2346                 v-exch-scale = buf_price-all.pdf-exch-scale
     2347               .
     2348               else do:
     2349   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2350   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     2351     (input  buf_price-all.curr-code
     2352     ,input  to-day
     2353     ,output v-exch-rate0
     2354     ,output v-exch-scale0
     2355     ,output v-curr-abbr
     2356     )  .
     2357               assign
     2358                 v-exch-rate  = v-exch-rate0
     2359                 v-exch-scale = v-exch-scale0
     2360                 .
     2361              end.
     2362              v-date-1 = date ( "" )  .
     2363              if buf_price-all.fact-order-sys-from > 0 then do:
     2364                 if buf_price-all.start-sys-date <> ?   then  v-date-1 = buf_price-all.start-sys-date.
     2365                 if buf_price-all.start-shift-date <> ? then  v-date-1 = buf_price-all.start-shift-date.
     2366                 if buf_price-all.start-date <> ?       then  v-date-1 = buf_price-all.start-date.
     2367              end.
     2368              v-date-2 =  date ( "" )  .
     2369              if buf_price-all.fact-order-sys-to > 0 then do:
     2370                 if buf_price-all.end-sys-date <> ?     then  v-date-2 = buf_price-all.end-sys-date.
     2371                 if buf_price-all.end-shift-date <> ?   then  v-date-2 = buf_price-all.end-shift-date.
     2372                 if buf_price-all.end-date <> ?         then  v-date-2 = buf_price-all.end-date.
     2373              end.
     2374              if buf_price-all.qnty-from <> ? then do :
     2375                 if not (
     2376                 ( p-qnty-doc  >= buf_price-all.qnty-from and buf_price-all.qnty-to = ? ) or
     2377                 ( p-qnty-doc  >= buf_price-all.qnty-from and p-qnty-doc <= buf_price-all.qnty-to and buf_price-all.qnty-to <> ?)
     2378                 ) then do:
     2379                        v-interv = "".
     2380                        next.
     2381                 end.
     2382                 v-interv = "К: " + string(buf_price-all.qnty-from) + " - " + ( if buf_price-all.qnty-to = ? then "и более" else string(buf_price-all.qnty-to)) .
     2383              end.
     2384              if buf_price-all.sum-from <> ? then do :
     2385                 if not (
     2386                 ( p-sum-doc  >= buf_price-all.sum-from and buf_price-all.sum-to = ? ) or
     2387                 ( p-sum-doc  >= buf_price-all.sum-from and p-sum-doc <= buf_price-all.sum-to and buf_price-all.sum-to <> ?)
     2388                 ) then do:
     2389                    v-interv = "".
     2390                    next.
     2391                 end.
     2392                 v-interv = "C: " +  string(buf_price-all.sum-from) + " - " + ( if buf_price-all.sum-to = ? then "и более" else string(buf_price-all.sum-to)) .
     2393              end.
     2394              if buf_price-all.turnover-from <> ? then do :
     2395                 if not (
     2396                 ( v-cli-oborot-ALL  >= buf_price-all.turnover-from and buf_price-all.turnover-to = ? ) or
     2397                 ( v-cli-oborot-ALL  >= buf_price-all.turnover-from and v-cli-oborot-ALL <= buf_price-all.turnover-to and buf_price-all.turnover-to <> ?)
     2398                 ) then do:
     2399                    v-interv = "".
     2400                    next.
     2401                 end.
     2402                 v-interv = "O: " +  string(buf_price-all.turnover-from) + " - " + ( if buf_price-all.turnover-to = ? then "и более" else string(buf_price-all.turnover-to)) .
     2403              end.
     2404              if buf_price-all.use-pay-type = 1 then do :
     2405                 if buf_price-all.pay-code <> v-trn-pay-code then do:
     2406                    v-pay-name = "" .
     2407                    next.
     2408                  end.
     2409                  v-pay-name = 'Оплата':U +  ":" + string(buf_price-all.pay-code) .
     2410              end.
     2411              if buf_price-all.use-cash-pay = 1 then do :
     2412                 if v-cash-pay-code <> 0 and  not ( buf_price-all.curr-pay-code = v-cash-pay-curr and
     2413                                                    buf_price-all.cdpay-code    = v-cash-pay-code ) then do:
     2414                   v-pay-name = "" .
     2415                   next.
     2416                 end.
     2417                 v-pay-name = 'Касс.платеж':U + ":" + string(buf_price-all.cdpay-code) + "_" + string(buf_price-all.curr-pay-code).
     2418              end.
     2419             find first buf_bar-code no-lock where buf_bar-code.b-code = buf_price-all.b-code no-error .
     2420             create tt_price-all .
     2421             buffer-copy buf_price-all to tt_price-all
     2422             assign
     2423               tt_price-all.price-sale-rubl = buf_price-all.price-sale  * v-exch-rate / v-exch-scale
     2424               tt_price-all.road-tax-rubl   = buf_price-all.road-tax    * v-exch-rate / v-exch-scale
     2425               tt_price-all.excise-rubl     = buf_price-all.excise      * v-exch-rate / v-exch-scale
     2426               tt_price-all.price-sale-base = tt_price-all.price-sale-rubl  / v-base-rate * v-base-scale
     2427               tt_price-all.road-tax-base   = tt_price-all.road-tax-rubl    / v-base-rate * v-base-scale
     2428               tt_price-all.excise-base     = tt_price-all.excise-rubl      / v-base-rate * v-base-scale
     2429               tt_price-all.price-sale     = buf_price-all.price-sale
     2430               tt_price-all.road-tax       = buf_price-all.road-tax
     2431               tt_price-all.excise         = buf_price-all.excise
     2432               tt_price-all.pdf-exch-rate   = v-exch-rate
     2433               tt_price-all.pdf-exch-scale  = v-exch-scale
     2434               tt_price-all.pdf-base-rate   = v-base-rate
     2435               tt_price-all.pdf-base-scale  = v-base-scale
     2436               tt_price-all.grp-name        = v-grp-name
     2437               tt_price-all.date-1          = v-date-1
     2438               tt_price-all.shift-1         = buf_price-all.start-shift-num
     2439               tt_price-all.time-1          = buf_price-all.start-sys-time
     2440               tt_price-all.date-2          = v-date-2
     2441               tt_price-all.shift-2         = buf_price-all.end-shift-num
     2442               tt_price-all.time-2          = buf_price-all.end-sys-time
     2443               tt_price-all.interv-name     = v-interv
     2444               tt_price-all.pay-name        = v-pay-name
     2445               tt_price-all.unit-cli        = buf_bar-code.unit-cli
     2446             .
     2447   end.
     2448   define variable vt-plt-id as integer   no-undo .
     2449   define variable vt-plt-db as integer   no-undo .
     2450   define variable vt-pdf-id as integer   no-undo .
     2451   define variable vt-pdf-db as integer   no-undo .
     2452   define buffer neos_price-all for tt_price-all  .
     2453   find first tt_price-all where tt_price-all.b-code = p-main-b-code use-index pi no-error .
     2454       if available tt_price-all then do:
     2455        assign
     2456          vt-plt-id = tt_price-all.plt-id
     2457          vt-plt-db = tt_price-all.plt-db-num
     2458          vt-pdf-id = tt_price-all.pdf-id
     2459          vt-pdf-db = tt_price-all.pdf-db
     2460        .
     2461        if tt_price-all.b-code = p-b-code then do:
     2462             assign
     2463               p-plt-id           = tt_price-all.plt-id
     2464               p-plt-db-num       = tt_price-all.plt-db-num
     2465               p-pdf-id           = tt_price-all.pdf-id
     2466               p-pdf-db-num       = tt_price-all.pdf-db
     2467               p-sale-price-base  = tt_price-all.price-sale-base
     2468               p-sale-price-rubl  = tt_price-all.price-sale-rubl
     2469               p-road-tax-base    = tt_price-all.road-tax-base
     2470               p-road-tax-rubl    = tt_price-all.road-tax-rubl
     2471               p-excise-base      = tt_price-all.excise-base
     2472               p-excise-rubl      = tt_price-all.excise-rubl
     2473               .
     2474        end.
     2475        else do:
     2476          find first neos_price-all where
     2477                     neos_price-all.b-code     = p-b-code  and
     2478                     neos_price-all.plt-id     = vt-plt-id and
     2479                     neos_price-all.plt-db-num = vt-plt-db and
     2480                     neos_price-all.pdf-id     = vt-pdf-id and
     2481                     neos_price-all.pdf-db     = vt-pdf-db
     2482                     use-index pi no-error .
     2483            if available neos_price-all then do:
     2484             assign
     2485               p-plt-id           = tt_price-all.plt-id
     2486               p-plt-db-num       = tt_price-all.plt-db-num
     2487               p-pdf-id           = tt_price-all.pdf-id
     2488               p-pdf-db-num       = tt_price-all.pdf-db
     2489               p-sale-price-base  = neos_price-all.price-sale-base
     2490               p-sale-price-rubl  = neos_price-all.price-sale-rubl
     2491               p-road-tax-base    = neos_price-all.road-tax-base
     2492               p-road-tax-rubl    = neos_price-all.road-tax-rubl
     2493               p-excise-base      = neos_price-all.excise-base
     2494               p-excise-rubl      = neos_price-all.excise-rubl
     2495               .
     2496            end.
     2497            else do:
     2498                 find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     2499                 if error-status :error    then do:
     2500                   message "Не найден бар-код" p-b-code view-as alert-box error .
     2501                   return error return-value .
     2502                 end.
     2503             assign
     2504               p-plt-id           = tt_price-all.plt-id
     2505               p-plt-db-num       = tt_price-all.plt-db-num
     2506               p-pdf-id           = tt_price-all.pdf-id
     2507               p-pdf-db-num       = tt_price-all.pdf-db
     2508               p-sale-price-base  = tt_price-all.price-sale-base
     2509               p-sale-price-rubl  = tt_price-all.price-sale-rubl
     2510               p-road-tax-base    = tt_price-all.road-tax-base
     2511               p-road-tax-rubl    = tt_price-all.road-tax-rubl
     2512               p-excise-base      = tt_price-all.excise-base
     2513               p-excise-rubl      = tt_price-all.excise-rubl * buf_bar-code.cli-base-rate
     2514               .
     2515            end.
     2516        end.
     2517     end.
     2518   end.
     2519   end procedure.
     2520   procedure mpl-tpl-auto :
     2521   define input  parameter p-b-code     as integer   no-undo .
     2522   define input  parameter p-obj-type   as character no-undo .
     2523   define input  parameter p-obj-code   as integer   no-undo .
     2524   define input  parameter p-plt-id     as integer   no-undo .
     2525   define input  parameter p-plt-db-num as integer   no-undo .
     2526   define input  parameter p-fact-order as decimal   no-undo .
     2527   define output parameter p-sale-price as decimal   no-undo .
     2528   define output parameter p-pdf-id     as integer   no-undo .
     2529   define output parameter p-pdf-db-num as integer   no-undo .
     2530     do
     2531     on error undo, return error return-value
     2532     :
     2533   if p-fact-order = ? then do:
     2534     run fact-order-mpl (
     2535         input   today       ,
     2536         input   p-obj-type  ,
     2537         input   p-obj-code  ,
     2538         output  p-fact-order ) .
     2539   end.
     2540   assign
     2541     p-pdf-id      = ?
     2542     p-pdf-db-num  = ?
     2543     p-sale-price  = ?
     2544   .
     2545   define buffer buf_bar-code for ub.bar-code  .
     2546   define buffer buf_goods for ub.goods  .
     2547   find first buf_bar-code no-lock where
     2548              buf_bar-code.b-code = p-b-code
     2549              no-error .
     2550   if error-status :error then return error return-value .
     2551   find first buf_goods no-lock where
     2552              buf_goods.gds-code = buf_bar-code.gds-code
     2553              no-error .
     2554   if error-status :error then return error return-value .
     2555   define variable v-main-b-code as integer   no-undo .
     2556   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2557     (input  buf_goods.gds-code
     2558     ,input  ?
     2559     ,output v-main-b-code
     2560     )  .
     2561   define buffer buf_price-all for ub.price-all  .
     2562   for each tt_price-all : delete tt_price-all. end.
     2563       for each buf_price-all no-lock where
     2564               buf_price-all.plt-id     = p-plt-id                 and
     2565               buf_price-all.plt-db-num = p-plt-db-num             and
     2566               buf_price-all.obj-type   = p-obj-type               and
     2567               buf_price-all.obj-code   = p-obj-code               and
     2568               buf_price-all.gds-code   = buf_goods.gds-code       and
     2569             ( buf_price-all.b-code = v-main-b-code or
     2570               buf_price-all.b-code = p-b-code)    and
     2571               buf_price-all.status_    = 'акт':U         and
     2572               buf_price-all.fact-order-sys-from  <= p-fact-order  and
     2573             ( buf_price-all.fact-order-sys-to = ? or
     2574               buf_price-all.fact-order-sys-to >=  p-fact-order)
     2575               :
     2576                 create tt_price-all .
     2577                 buffer-copy buf_price-all to tt_price-all
     2578                 assign
     2579                   tt_price-all.price-sale  = buf_price-all.price-sale
     2580                 .
     2581       end.
     2582   define variable vt-plt-id as integer   no-undo .
     2583   define variable vt-plt-db as integer   no-undo .
     2584   define variable vt-pdf-id as integer   no-undo .
     2585   define variable vt-pdf-db as integer   no-undo .
     2586   define buffer neos_price-all for tt_price-all  .
     2587   find first tt_price-all where tt_price-all.b-code = v-main-b-code use-index pi no-error .
     2588       if available tt_price-all then do:
     2589        assign
     2590          vt-plt-id = tt_price-all.plt-id
     2591          vt-plt-db = tt_price-all.plt-db-num
     2592          vt-pdf-id = tt_price-all.pdf-id
     2593          vt-pdf-db = tt_price-all.pdf-db
     2594        .
     2595        if tt_price-all.b-code = p-b-code then do:
     2596             assign
     2597               p-plt-id           = tt_price-all.plt-id
     2598               p-plt-db-num       = tt_price-all.plt-db-num
     2599               p-pdf-id           = tt_price-all.pdf-id
     2600               p-pdf-db-num       = tt_price-all.pdf-db
     2601               p-sale-price       = tt_price-all.price-sale
     2602               .
     2603        end.
     2604        else do:
     2605          find first neos_price-all where
     2606                     neos_price-all.b-code     = p-b-code  and
     2607                     neos_price-all.plt-id     = vt-plt-id and
     2608                     neos_price-all.plt-db-num = vt-plt-db and
     2609                     neos_price-all.pdf-id     = vt-pdf-id and
     2610                     neos_price-all.pdf-db     = vt-pdf-db
     2611                     use-index pi no-error .
     2612            if available neos_price-all then do:
     2613             assign
     2614               p-plt-id           = tt_price-all.plt-id
     2615               p-plt-db-num       = tt_price-all.plt-db-num
     2616               p-pdf-id           = tt_price-all.pdf-id
     2617               p-pdf-db-num       = tt_price-all.pdf-db
     2618               p-sale-price       = neos_price-all.price-sale
     2619               .
     2620            end.
     2621            else do:
     2622           find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     2623           if error-status :error    then do:
     2624              message "Не найден бар-код" p-b-code view-as alert-box error .
     2625              return error return-value .
     2626           end.
     2627             assign
     2628               p-plt-id           = tt_price-all.plt-id
     2629               p-plt-db-num       = tt_price-all.plt-db-num
     2630               p-pdf-id           = tt_price-all.pdf-id
     2631               p-pdf-db-num       = tt_price-all.pdf-db
     2632               p-sale-price       = tt_price-all.price-sale * buf_bar-code.cli-base-rate
     2633               .
     2634            end.
     2635        end.
     2636     end.
     2637     end.
     2638   end procedure.
     2639   define variable v-current-host-code as integer no-undo .
     2640   define variable v-current-obj-type as character no-undo .
     2641   define variable v-current-obj-code as integer no-undo .
     2642   define variable v-current-pos-type as character no-undo .
     2643   define variable v-current-pos-type-for-discnt as character no-undo .
     2644   define variable v-current-lock as integer no-undo .
     2645   define variable v-current-wait as integer no-undo .
     2646   define variable v-save as integer no-undo .
     2647   define variable v-view-log                   as logical        no-undo .
     2648   define variable v-stop                       as logical        no-undo .
     2649   define variable v-current-db-num as integer no-undo .
     2650   define variable v-last-error-message as character no-undo .
     2651   define variable v-codex-id as integer   no-undo .
     2652   define variable v-ruleset-id as integer   no-undo .
     2653   define variable v-caller as character no-undo .
     2654   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2655   procedure set-error :
     2656   define input parameter p-mess as character no-undo .
     2657     do
     2658     on error undo, return error
     2659     :
     2660        assign
     2661        v-last-error-message = p-mess.
     2662     end.
     2663   end procedure.
     2664   define temp-table temp-rule-call-param no-undo like ub.rule-call-param.
     2665   define temp-table temp-rule-by-call no-undo like ub.rule-by-call.
     2666   define temp-table temp-discnt-role no-undo like ub.dis-cfg-rule
     2667   field codex_id as integer
     2668   field ruleset_id as integer
     2669   field order_id as integer
     2670   field rule_id as integer
     2671   field once-more as integer
     2672   index pi is unique
     2673   primary
     2674   codex_id
     2675   ruleset_id
     2676   order_id
     2677   rule_id
     2678   pos-type
     2679   discnt-role
     2680   subject-type
     2681   .
     2682   on delete of this-procedure do:
     2683   define buffer buf_temp-rule-call-param for temp-rule-call-param.
     2684   define buffer buf_temp-rule-by-call for temp-rule-by-call.
     2685   define buffer buf_temp-discnt-role for temp-discnt-role.
     2686     for each buf_temp-rule-call-param:
     2687       delete buf_temp-rule-call-param.
     2688     end.
     2689     for each buf_temp-rule-by-call:
     2690       delete buf_temp-rule-by-call.
     2691     end.
     2692     for each buf_temp-discnt-role:
     2693       delete buf_temp-discnt-role.
     2694     end.
     2695   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2696   define buffer buf_temp-call-param for temp-call-param.
     2697   for each buf_temp-call-param where
     2698           buf_temp-call-param.param-num = 0:
     2699     delete object buf_temp-call-param.call-handle_.
     2700     delete buf_temp-call-param.
     2701   end.
     2702     run garbcoll_clear in this-procedure .
     2703   end.
     2704   run load-ruleset-context in this-procedure no-error.
     2705   if error-status:error then do:
     2706     undo, return error return-value .
     2707   end.
     2708   procedure rs_15_1 :
     2709   define input parameter p-caller as character no-undo .
     2710   define input parameter v-gline-num as integer   no-undo .
     2711   define input parameter v-b-code as integer   no-undo .
     2712   define input parameter v-gds-code as integer   no-undo .
     2713   define input parameter v-sum-grp-code as integer no-undo .
     2714   define input parameter v-node-code as integer no-undo .
     2715   define input parameter v-src-qnty as decimal no-undo .
     2716   define input parameter v-doc-qnty as decimal no-undo .
     2717   define input parameter v-start-src-price as decimal no-undo .
     2718   define input parameter v-src-price as decimal no-undo .
     2719   define input parameter v-start-src-discnt as decimal no-undo .
     2720   define input parameter v-src-discnt as decimal no-undo .
     2721   define input parameter v-unit-base as character no-undo .
     2722   define input parameter v-unit-base-type as character no-undo .
     2723   define input parameter v-unit-cli as character no-undo .
     2724   define input parameter v-unit-cli-type as character no-undo .
     2725   define input parameter v-bh as handle no-undo extent 6.
     2726   define output parameter v-new-src-price as decimal no-undo .
     2727   define output parameter v-new-src-discnt as decimal no-undo .
     2728   define buffer buf_temp-rule-by-call for temp-rule-by-call.
     2729   define buffer buf_temp-discnt-role for temp-discnt-role.
     2730   main-block:
     2731   do
     2732   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2733   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     2734   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     2735   :
     2736     assign
     2737     v-codex-id = 15
     2738     v-ruleset-id = 1
     2739     v-caller = p-caller
     2740     v-new-src-price = v-src-price
     2741     v-new-src-discnt = v-src-discnt
     2742     .
     2743     for each buf_temp-rule-by-call where
     2744               buf_temp-rule-by-call.call_id = p-call-id
