      983   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      984   def
      985   new shared
      986   temp-table  obj-list no-undo
      987     field obj-type like ub.clients.obj-type
      988     field obj-code like ub.clients.obj-code
      989     field obj-name like ub.clients.obj-name
      990     field obj-id   as integer
      991     field db-num   as integer
      992     index pi is primary unique obj-id
      993     index ie1 obj-type obj-code
      994     index ie2 obj-name
      995   .
      996   procedure create_obj-list :
      997      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      998      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      999      do
     1000      on error undo, return error return-value
     1001      :
     1002         define buffer cli-obj for ub.clients .
     1003         define variable p-var as integer no-undo .
     1004         define buffer buf_obj-list for obj-list .
     1005         find last buf_obj-list  use-index pi no-error .
     1006         if available buf_obj-list
     1007         then
     1008            p-var = buf_obj-list.obj-id + 1.
     1009         else
     1010            p-var = 1.
     1011         find first cli-obj where
     1012                   cli-obj.obj-type = p-obj-type
     1013               and cli-obj.obj-code = p-obj-code
     1014         no-lock no-error.
     1015         if available cli-obj
     1016         then do:
     1017            create buf_obj-list.
     1018            assign
     1019               buf_obj-list.obj-id   = p-var
     1020               buf_obj-list.obj-code = cli-obj.obj-code
     1021               buf_obj-list.obj-type = cli-obj.obj-type
