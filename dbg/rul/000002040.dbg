     1441   procedure factord :
     1442     define input  parameter p-fact-date            as date    no-undo .
     1443     define input  parameter p-fact-time            as integer no-undo .
     1444     define input  parameter p-fact-num             as integer no-undo .
     1445     define input  parameter p-shift-date           as date    no-undo .
     1446     define input  parameter p-shift-num            as integer no-undo .
     1447     define input  parameter p-shift-on             as logical no-undo .
     1448     define output parameter p-fact-order           as decimal no-undo .
     1449     define output parameter p-shift-end-fact-order as decimal no-undo .
     1450     define output parameter p-day-end-fact-order   as decimal no-undo .
     1451     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     1452     if p-fact-date = ?
     1453     then do:
     1454       return error "Не указана фактическая дата" .
     1455     end.
     1456     define variable v-fact-date-num as integer no-undo .
     1457     assign
     1458       v-fact-date-num = integer(p-fact-date)
     1459     .
     1460     if p-fact-num = ?
     1461     or p-fact-num = 0
     1462     then do:
     1463       return error "Не задан p-fact-num " + string(p-fact-num) .
     1464     end.
     1465     if p-fact-num < 0
     1466     then do:
     1467       return error "Отрицательный fact-num " + string(p-fact-num) .
     1468     end.
     1469     if p-fact-num >= 100000000
     1470     then do:
     1471       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     1472     end.
     1473     if p-shift-on = true
     1474     then do:
     1475       if p-shift-date = ?
     1476       then do:
     1477         return error "Не задана дата смены" .
     1478       end.
     1479       if p-shift-num = ?
     1480       or p-shift-num = 0
     1481       then do:
     1482         return error "Не задан номер смены" .
     1483       end.
     1484     end.
     1485     else do:
     1486       assign
     1487         p-shift-date = p-fact-date
     1488         p-shift-num  = 24
     1489       .
     1490     end.
     1491     define variable v-shift-offset as integer no-undo .
     1492     if p-shift-date = p-fact-date
     1493     then do:
     1494       assign
     1495         v-shift-offset = 1
     1496       .
     1497     end.
     1498     if p-shift-date < p-fact-date
     1499     then do:
     1500       assign
     1501         v-shift-offset = 0
     1502       .
     1503     end.
     1504     if p-shift-date > p-fact-date
     1505     then do:
     1506       message
     1507         vss-workfile vss-revision vss-description skip
     1508         "Неправильная дата закрытия смены" skip
     1509         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1510         view-as alert-box error .
     1511       undo, return error
     1512         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1513           ,string(p-fact-date, '99/99/9999':U)
     1514           ,string(p-shift-date, '99/99/9999':U)
     1515           )
     1516       .
     1517     end.
     1518     if p-shift-num < 1
     1519     or p-shift-num > 24
     1520     then do:
     1521       message
     1522         vss-workfile vss-revision vss-description skip
     1523         "Неправильный номер смены" skip
     1524         "p-shift-num" p-shift-num skip
     1525         view-as alert-box error .
     1526       undo, return error return-value .
     1527     end.
     1528     assign
     1529       p-fact-order           = v-fact-date-num
     1530                              + v-shift-offset * 0.5
     1531                              + p-shift-num    * 0.02 - 0.01
     1532                              + p-fact-num     * 0.0000000001
     1533       p-shift-end-fact-order = v-fact-date-num
     1534                              + v-shift-offset * 0.5
     1535                              + p-shift-num    * 0.02
     1536       p-day-end-fact-order   = v-fact-date-num
     1537                              + 0.99
     1538     .
     1539     if p-fact-order           <= v-fact-date-num
     1540     or p-shift-end-fact-order <= v-fact-date-num
     1541     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1542     or p-shift-end-fact-order >= p-day-end-fact-order
     1543     then do:
     1544       message
     1545         vss-workfile vss-revision vss-description skip
     1546         "Внутренняя ошибка при генерации фактического номера" skip
     1547         "p-fact-date"            p-fact-date            skip
     1548         "p-fact-time"            p-fact-time            skip
     1549         "p-fact-num"             p-fact-num             skip
     1550         "p-shift-date"           p-shift-date           skip
     1551         "p-shift-num"            p-shift-num            skip
     1552         "p-shift-on"             p-shift-on             skip
     1553         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1554         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1555         "v-fact-date-num"        v-fact-date-num        skip
     1556         view-as alert-box error .
     1557       undo, return error return-value .
     1558     end.
     1559   end procedure.
     1560   procedure day-begin-fact-order :
     1561     define input  parameter p-fact-date            as date    no-undo .
     1562     define output parameter p-day-begin-fact-order as decimal no-undo .
     1563     do
     1564     on error undo, return error return-value
     1565     :
     1566       if p-fact-date = ?
     1567       then do:
     1568         assign
     1569           p-day-begin-fact-order = 0
     1570         .
     1571       end.
     1572       else do:
     1573         assign
     1574           p-day-begin-fact-order = integer(p-fact-date)
     1575         .
     1576       end.
     1577     end.
     1578   end procedure.
     1579   procedure factord-max-fact-order :
     1580     define output parameter p-max-fact-order as decimal   no-undo .
     1581     do
     1582     on error undo, return error return-value
     1583     :
     1584       run day-begin-fact-order in this-procedure
     1585         (input  date(1, 1, 5000)
     1586         ,output p-max-fact-order
     1587         ) .
     1588     end.
     1589   end procedure.
     1590   procedure factord-cut-archive :
     1591     define input  parameter p-obj-type             as character no-undo .
     1592     define input  parameter p-obj-code             as integer   no-undo .
     1593     define input  parameter p-fact-date            as date      no-undo .
     1594     define output parameter p-shift-on             as logical   no-undo .
     1595     define output parameter p-shift-date           as date      no-undo .
     1596     define output parameter p-shift-num            as integer   no-undo .
     1597     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1598     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1599     define variable v-fact-order as decimal   no-undo .
     1600     define buffer buf_shift-obj for ub.shift-obj .
     1601     do
     1602     on error undo, return error return-value
     1603     :
     1604   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1605   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1606     (input  p-obj-type
     1607     ,input  p-obj-code
     1608     ,input  'shift-on=request'
     1609     ,output p-shift-on
     1610     ) no-error .
     1611       if error-status :error
     1612       then do:
     1613         message
     1614           vss-workfile vss-revision vss-description skip
     1615           "Ошибка при определении атрибута объекта" skip
     1616           "Объект" p-obj-type p-obj-code skip
     1617           error-status :get-message(1) skip
     1618           return-value skip
     1619           view-as alert-box error .
     1620         undo, return error return-value .
     1621       end.
     1622       if p-shift-on = false
     1623       then do:
     1624         assign
     1625           p-shift-date               = ?
     1626           p-shift-num                = 0
     1627         .
     1628       end.
     1629       else do:
     1630         find first buf_shift-obj share-lock
     1631           where buf_shift-obj.obj-type   = p-obj-type
     1632             and buf_shift-obj.obj-code   = p-obj-code
     1633             and buf_shift-obj.shift-date > p-fact-date
     1634           use-index pi
     1635           no-error .
     1636         if not available buf_shift-obj
     1637         or buf_shift-obj.status_ <> 'зкр':U
     1638         then do:
     1639           message
     1640             vss-workfile vss-revision vss-description skip
     1641             "Невозможно вычислить последнюю смену" skip
     1642             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1643             "Объект" p-obj-type p-obj-code skip
     1644             "Дата" p-fact-date skip
     1645             view-as alert-box error .
     1646           undo, return error return-value .
     1647         end.
     1648         find last buf_shift-obj share-lock
     1649           where buf_shift-obj.obj-type = p-obj-type
     1650             and buf_shift-obj.obj-code = p-obj-code
     1651             and buf_shift-obj.shift-date <= p-fact-date
     1652           use-index pi
     1653           no-error .
     1654         if available buf_shift-obj
     1655         then do:
     1656           if  buf_shift-obj.status_ = 'зкр':U
     1657           then do:
     1658             assign
     1659               p-shift-date = buf_shift-obj.shift-date
     1660               p-shift-num  = buf_shift-obj.shift-num
     1661             .
     1662           end.
     1663           else do:
     1664             message
     1665               vss-workfile vss-revision vss-description skip
     1666               "Невозможно вычислить последнюю смену" skip
     1667               "Статус смены отличен от статуса" 'зкр':U skip
     1668               "Объект" p-obj-type p-obj-code skip
     1669               "Дата" p-fact-date skip
     1670               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1671               view-as alert-box error .
     1672             undo, return error return-value .
     1673           end.
     1674         end.
     1675         else do:
     1676           assign
     1677             p-shift-date = p-fact-date - 1
     1678             p-shift-num  = 1
     1679           .
     1680         end.
     1681       end.
     1682       run factord in this-procedure
     1683         (input  p-fact-date
     1684         ,input  1
     1685         ,input  1
     1686         ,input  p-shift-date
     1687         ,input  p-shift-num
     1688         ,input  p-shift-on
     1689         ,output v-fact-order
     1690         ,output p-shift-end-fact-order
     1691         ,output p-day-end-fact-order
     1692         ) no-error .
     1693       if error-status :error
     1694       then do:
     1695         message
     1696           vss-workfile vss-revision vss-description skip
     1697           "Ошибка при вызове процедуры factord"
     1698           error-status :get-message(1) skip
     1699           return-value skip
     1700           view-as alert-box error .
     1701         undo, return error return-value .
     1702       end.
     1703     end.
     1704   end procedure.
     1705   procedure factord-lock-shift :
     1706     define input  parameter p-obj-type  as character no-undo .
     1707     define input  parameter p-obj-code  as integer   no-undo .
     1708     define input  parameter p-fact-date as date      no-undo .
     1709     define parameter buffer buf_shift-obj for ub.shift-obj .
     1710     define variable v-shift-on      as logical   no-undo .
     1711     define variable v-extra-message as character no-undo .
     1712     define variable v-error as character no-undo .
     1713     do
     1714     on error undo, return error return-value
     1715     :
     1716   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1717   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1718     (input  p-obj-type
     1719     ,input  p-obj-code
     1720     ,input  'shift-on=request'
     1721     ,output v-shift-on
     1722     ) no-error .
     1723       if error-status :error
     1724       then do:
     1725         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1726         undo, return error v-error .
     1727       end.
     1728       if v-shift-on = true
     1729       then do:
     1730         find first buf_shift-obj share-lock
     1731           where buf_shift-obj.obj-type   = p-obj-type
     1732             and buf_shift-obj.obj-code   = p-obj-code
     1733             and buf_shift-obj.shift-date > p-fact-date
     1734           use-index pi
     1735           no-error .
     1736         if not available buf_shift-obj
     1737         or buf_shift-obj.status_ <> 'зкр':U
     1738         then do:
     1739           find last buf_shift-obj
     1740             where buf_shift-obj.obj-type = p-obj-type
     1741               and buf_shift-obj.obj-code = p-obj-code
     1742               and buf_shift-obj.status_  = 'зкр':U
     1743             use-index stts
     1744             no-error .
     1745           if available buf_shift-obj
     1746           then do:
     1747             assign
     1748               v-extra-message =
     1749                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1750                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1751                               )
     1752             .
     1753           end.
     1754           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1755           undo, return error v-error .
     1756         end.
     1757       end.
     1758     end.
     1759   end procedure.
     1760   procedure factord-end-day :
     1761     define input  parameter p-fact-date            as date    no-undo .
     1762     define output parameter p-day-end-fact-order   as decimal no-undo .
     1763     do
     1764     on error undo, return error return-value
     1765     :
     1766       if p-fact-date = ?
     1767       then do:
     1768         return error "Не указана фактическая дата" .
     1769       end.
     1770       assign
     1771         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1772       .
     1773     end.
     1774   end procedure.
     1775   procedure factord-to-date :
     1776     define input  parameter p-fact-order as decimal no-undo .
     1777     define output parameter p-fact-date  as date    no-undo .
     1778     define variable v-ref-date  as date      no-undo .
     1779     define variable v-ref-delta as integer   no-undo .
     1780     do
     1781     on error undo, return error return-value
     1782     :
     1783       if p-fact-order = ?
     1784       or p-fact-order = 0
     1785       then do:
     1786         return error "Не указан fact-order" .
     1787       end.
     1788       assign
     1789         v-ref-date  = date(1, 1, 2000)
     1790       .
     1791       assign
     1792         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1793       .
     1794       assign
     1795         p-fact-date = v-ref-date + v-ref-delta
     1796       .
     1797     end.
     1798   end procedure.
     1799   procedure factord-to-fact-num :
     1800     define input  parameter p-fact-order as decimal no-undo .
     1801     define output parameter p-fact-num   as integer no-undo .
     1802     define variable v-fact-order-trunc as decimal no-undo .
     1803     do
     1804     on error undo, return error return-value
     1805     :
     1806       if p-fact-order = ?
     1807       or p-fact-order = 0
     1808       then do:
     1809         return error "Не указан fact-order" .
     1810       end.
     1811       assign
     1812        v-fact-order-trunc = truncate(p-fact-order, 2)
     1813       .
     1814       assign
     1815         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1816       .
     1817     end.
     1818   end procedure.
     1819   procedure factord-to-shift-num :
     1820     define input  parameter p-fact-order as decimal no-undo .
     1821     define output parameter p-shift-num   as integer no-undo .
     1822     define variable  p-shift-numd  as decimal   no-undo .
     1823     define variable v-fact-order-trunc as decimal no-undo .
     1824     do
     1825     on error undo, return error return-value
     1826     :
     1827       if p-fact-order = ?
     1828       or p-fact-order = 0
     1829       then do:
     1830         return error "Не указан fact-order" .
     1831       end.
     1832       assign
     1833        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1834       .
     1835       if v-fact-order-trunc < 0.5 then do:
     1836         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1837       end.
     1838       assign
     1839         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1840         .
     1841        assign
     1842         p-shift-num = truncate (p-shift-numd , 0)
     1843       .
     1844     end.
     1845   end procedure.
     1846   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1847   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1848   define variable tempcxml_v-num_ as integer no-undo .
     1849   define  temp-table temp-xml-tables no-undo
     1850   field order as integer
     1851   field tbl-name as character
     1852   field tbl-handle_ as handle
     1853   field table-handle_ as handle
     1854   field uniq-gate-rec as character
     1855   field gate-name as character
     1856   field gate-handle_ as handle
     1857   field is-parent as logical
     1858   index pi is unique primary
     1859   uniq-gate-rec
     1860   tbl-name
     1861   index iorder
     1862   order
     1863   index gr
     1864   uniq-gate-rec
     1865   index gh
     1866   gate-handle_
     1867   index iparent
     1868   is-parent
     1869   .
     1870   define  temp-table temp-xml-records no-undo
     1871   field tbl-name as character
     1872   field uniq-key-rec as character
     1873   index pi is unique primary
     1874   tbl-name
     1875   uniq-key-rec
     1876   .
     1877   def var vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1878   procedure get-gate-file-name :
     1879   define input parameter p-gate-rec as character no-undo .
     1880   define output  parameter p-gate-file-name as character no-undo .
     1881   define buffer buf_clob-data for ub.clob-data.
     1882   define variable v-tbl-row as rowid no-undo .
     1883   define variable v-tbl-name as character no-undo .
     1884   run gen-row-keyr in this-procedure ( input p-gate-rec
     1885                                       ,input ?
     1886                                       ,input "ub"
     1887                                       ,input ?
     1888                                       ,input no-lock
     1889                                       ,output v-tbl-row
     1890                                       ,output v-tbl-name) no-error.
     1891   if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     1892                                                           ,vss-include-info16
     1893                                                           ,p-gate-rec).
     1894   find first buf_clob-data no-lock where
     1895             rowid(buf_clob-data) = v-tbl-row no-error.
     1896   if not available buf_clob-data then do:
     1897     if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     1898                                                             ,vss-include-info16
     1899                                                             ,p-gate-rec).
     1900   end.
     1901   p-gate-file-name = buf_clob-data.file-name.
     1902   end procedure.
     1903   procedure get-gate-rec :
     1904   define input  parameter p-gate-name as character no-undo .
     1905   define output parameter p-gate-rec as character no-undo .
     1906   define buffer buf_clob-bind for ub.clob-bind.
     1907   define buffer buf_clob-data for ub.clob-data.
     1908   main-block:
     1909   do
     1910   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info16, return-value, chr(10), error-status :get-message (1))
     1911   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info16 )
     1912   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info16 )
     1913   :
     1914       find first buf_clob-bind no-lock where
     1915                 buf_clob-bind.uniq-key-rec = p-gate-name
     1916             and buf_clob-bind.field-name = '':U
     1917             and buf_clob-bind.part-num = 1
     1918             and buf_clob-bind.resource-type = 'gate':U
     1919             no-error.
     1920       if not available buf_clob-bind then do:
     1921         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     1922                                         , p-gate-name
     1923                                         ).
     1924       end.
     1925       find first buf_clob-data no-lock where
     1926                 buf_clob-data.db-num = buf_clob-bind.db-num
     1927             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     1928       if not available buf_clob-data then do:
     1929         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1930                                         , buf_clob-bind.db-num
     1931                                         , buf_clob-bind.int64-id
     1932                                         , p-gate-name
     1933                                         ).
     1934       end.
     1935       run gen-key-rec in this-procedure ( input 'clob-data':U
     1936                                 ,input buffer buf_clob-data:handle
     1937                                 ,output p-gate-rec).
     1938   end.
     1939   end procedure.
     1940   procedure get-gate-by-name :
     1941   define input  parameter p-gate-name as character no-undo .
     1942   define output parameter p-gate-rec as character no-undo .
     1943   define output parameter p-dsh as handle no-undo .
     1944   define input-output  parameter p-xmlh as handle no-undo .
     1945   define variable v-ii as integer   no-undo .
     1946   define variable glog as logical   no-undo .
     1947   define variable v-longchar as longchar no-undo .
     1948   define variable v-txmlh as handle no-undo .
     1949   define variable v-db-num as integer no-undo .
     1950   define variable v-int64-id as int64 no-undo .
     1951   define buffer buf_clob-bind for ub.clob-bind.
     1952   define buffer buf_clob-data for ub.clob-data.
     1953   main-block:
     1954   do
     1955   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info16, return-value, chr(10), error-status :get-message (1))
     1956   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info16 )
     1957   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info16 )
     1958   :
     1959       find first buf_clob-bind no-lock where
     1960                 buf_clob-bind.uniq-key-rec = p-gate-name
     1961             and buf_clob-bind.field-name = '':U
     1962             and buf_clob-bind.part-num = 1
     1963             and buf_clob-bind.resource-type = 'gate':U
     1964             no-error.
     1965       if not available buf_clob-bind then do:
     1966         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     1967                                         , p-gate-name
     1968                                         ).
     1969       end.
     1970       find first buf_clob-data no-lock where
     1971                 buf_clob-data.db-num = buf_clob-bind.db-num
     1972             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     1973       if not available buf_clob-data then do:
     1974         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1975                                         , buf_clob-bind.db-num
     1976                                         , buf_clob-bind.int64-id
     1977                                         , p-gate-name
     1978                                         ).
     1979       end.
     1980       assign
     1981       v-longchar = buf_clob-data.cdata
     1982       .
     1983       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1984       if error-status :error then do:
     1985         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1986       end.
     1987       create dataset p-dsh .
     1988       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1989                                     , v-longchar
     1990                                     , ?
     1991                                     , ?
     1992                                     , ?
     1993                                     ) no-error.
     1994       v-longchar = '':U.
     1995       if error-status :error
     1996       or not glog
     1997       then do:
     1998         undo, return error substitute("Не удалось прочитать XML-схему &1 из БД:&2&3", p-gate-name, chr(10), error-status:get-message(1) ).
     1999       end.
     2000       if not valid-handle(p-xmlh)
     2001       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     2002         create temp-table v-txmlh.
     2003         v-txmlh:create-like(buffer temp-xml-tables:handle).
     2004         v-txmlh:temp-table-prepare("temp-xml-tables").
     2005         p-xmlh = v-txmlh:default-buffer-handle.
     2006       end.
     2007       run gen-key-rec in this-procedure ( input 'clob-data':U
     2008                                 ,input buffer buf_clob-data:handle
     2009                                 ,output p-gate-rec).
     2010       do v-ii = 1 to p-dsh:num-buffers:
     2011         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     2012         if not p-xmlh:available then do:
     2013           p-xmlh:buffer-create().
     2014           assign
     2015           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     2016           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     2017           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     2018           p-xmlh::gate-handle_ = p-dsh
     2019           p-xmlh::uniq-gate-rec = p-gate-rec
     2020           p-xmlh::gate-name = p-dsh:name
     2021           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     2022           .
     2023           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     2024             assign
     2025             p-xmlh::order = -3.
     2026           end.
     2027         end.
     2028       end.
     2029   end.
     2030   end procedure.
     2031   procedure get-gate-by-rec :
     2032   define input  parameter p-gate-rec as character no-undo .
     2033   define output parameter p-dsh as handle no-undo .
     2034   define input-output  parameter p-xmlh as handle no-undo .
     2035   define input-output parameter p-longchar  as longchar no-undo .
     2036   define variable v-ii as integer   no-undo .
     2037   define variable glog as logical   no-undo .
     2038   define variable v-rowid as rowid no-undo .
     2039   define variable v-tbl-name as character no-undo .
     2040   define variable v-longchar as longchar no-undo .
     2041   define variable v-txmlh as handle no-undo .
     2042   define buffer buf_clob-data for ub.clob-data.
     2043   main-block:
     2044   do
     2045   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info16, return-value, chr(10), error-status :get-message (1))
     2046   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info16 )
     2047   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info16 )
     2048   :
     2049     run gen-row-keyr in this-procedure (
     2050                                           input  p-gate-rec
     2051                                           ,input  ?
     2052                                           ,input  "ub"
     2053                                           ,input  ?
     2054                                           ,input  NO-LOCK
     2055                                           ,output v-rowid
     2056                                           ,output v-tbl-name   ) no-error.
     2057       find first buf_clob-data no-lock where
     2058                 rowid(buf_clob-data) = v-rowid  no-error.
     2059       if not available buf_clob-data then do:
     2060         undo, return error substitute("Не найден CLOB  &1"
     2061                                         , p-gate-rec
     2062                                         ).
     2063       end.
     2064       assign
     2065       v-longchar = buf_clob-data.cdata
     2066       .
     2067       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     2068       if error-status :error then do:
     2069         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     2070       end.
     2071       create dataset p-dsh .
     2072       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     2073                                     , v-longchar
     2074                                     , ?
     2075                                     , ?
     2076                                     , ?
     2077                                     ) no-error.
     2078       define variable v-esm as character no-undo .
     2079       v-esm = error-status:get-message(1) .
     2080       if p-longchar <> ? then do:
     2081         p-longchar = v-longchar.
     2082       end.
     2083       v-longchar = '':U.
     2084       if error-status :error
     2085       or not glog
     2086       then do:
     2087         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     2088                                      , p-gate-rec
     2089                                      , p-gate-rec
     2090                                      , v-esm
     2091                                      ).
     2092       end.
     2093       p-dsh:private-data = buf_clob-data.file-name_ + chr(4) + p-gate-rec.
     2094       if not valid-handle(p-xmlh)
     2095       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     2096         create temp-table v-txmlh.
     2097         v-txmlh:create-like(buffer temp-xml-tables:handle).
     2098         v-txmlh:temp-table-prepare("temp-xml-tables").
     2099         p-xmlh = v-txmlh:default-buffer-handle.
     2100       end.
     2101       do v-ii = 1 to p-dsh:num-buffers:
     2102         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     2103         if not p-xmlh:available then do:
     2104           p-xmlh:buffer-create().
     2105           assign
     2106           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     2107           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     2108           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     2109           p-xmlh::gate-handle_ = p-dsh
     2110           p-xmlh::uniq-gate-rec = p-gate-rec
     2111           p-xmlh::gate-name = p-dsh:name
     2112           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     2113           .
     2114           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     2115             assign
     2116             p-xmlh::order = -3.
     2117           end.
     2118           p-xmlh:buffer-release().
     2119         end.
     2120       end.
     2121   end.
     2122   end procedure.
     2123   procedure get-gate-by-file :
     2124   define input  parameter p-schema-file-name as character no-undo .
     2125   define input  parameter p-gate-rec as character no-undo .
     2126   define output parameter p-dsh as handle no-undo .
     2127   define input-output  parameter p-xmlh as handle no-undo .
     2128   define variable v-ii as integer   no-undo .
     2129   define variable glog as logical   no-undo .
     2130   define variable v-rowid as rowid no-undo .
     2131   define variable v-tbl-name as character no-undo .
     2132   define variable v-longchar as longchar no-undo .
     2133   define variable v-txmlh as handle no-undo .
     2134   main-block:
     2135   do
     2136   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info16, return-value, chr(10), error-status :get-message (1))
     2137   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info16 )
     2138   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info16 )
     2139   :
     2140       COPY-LOB
     2141       FROM  FILE p-schema-file-name
     2142       TO  OBJECT v-longchar
     2143       no-convert
     2144       NO-ERROR .
     2145       if error-status :error then do:
     2146           undo, return error substitute("Не удалось считать файл схемы &1 в память&2&3"
     2147                                     , p-schema-file-name
     2148                                 , chr(10)
     2149                                 , error-status:get-message(1) ).
     2150       end.
     2151       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     2152       if error-status :error then do:
     2153         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, p-schema-file-name, chr(10), error-status:get-message(1) , return-value ).
     2154       end.
     2155       create dataset p-dsh .
     2156       glog = p-dsh:READ-XMLSCHEMA( "longchar"
     2157                                     , v-longchar
     2158                                     , ?
     2159                                     , ?
     2160                                     , ?
     2161                                     ) no-error.
     2162       v-longchar = ''.
     2163       if error-status :error
     2164       or not glog
     2165       then do:
     2166         undo, return error substitute("Не удалось прочитать XML-схему из файла &1&2&3"
     2167                                      , p-schema-file-name
     2168                                      ,chr(10)
     2169                                      , error-status:get-message(1)
     2170                                      ).
     2171       end.
     2172       if not valid-handle(p-xmlh)
     2173       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     2174         create temp-table v-txmlh.
     2175         v-txmlh:create-like(buffer temp-xml-tables:handle).
     2176         v-txmlh:temp-table-prepare("temp-xml-tables").
     2177         p-xmlh = v-txmlh:default-buffer-handle.
     2178       end.
     2179       do v-ii = 1 to p-dsh:num-buffers:
     2180         p-xmlh:find-first(substitute(' where tbl-name = "&1" and  uniq-gate-rec = "&2" '
     2181                                      ,p-dsh:get-buffer-handle(v-ii):name
     2182                                      ,p-gate-rec
     2183                                      )) no-error.
     2184         if not p-xmlh:available then do:
     2185           p-xmlh:buffer-create().
     2186           assign
     2187           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):table
     2188           p-xmlh::uniq-gate-rec = p-gate-rec
     2189           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     2190           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     2191           p-xmlh::gate-handle_ = p-dsh
     2192           p-xmlh::gate-name = p-dsh:name
     2193           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     2194           .
     2195           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     2196             assign
     2197             p-xmlh::order = -3.
     2198           end.
     2199           p-xmlh:buffer-release().
     2200         end.
     2201       end.
     2202   end.
     2203   end procedure.
     2204   procedure gate-clear :
     2205   define input  parameter p-dsh as handle no-undo .
     2206   define input  parameter p-xmlh as handle no-undo .
     2207   define variable v-dsh as handle no-undo .
     2208   define variable v-th as handle no-undo .
     2209     do
     2210     on error undo, return error return-value
     2211     :
     2212       if valid-handle(p-dsh) then do:
     2213         delete object p-dsh.
     2214         v-dsh = p-dsh.
     2215         p-dsh = ?.
     2216       end.
     2217       repeat while true:
     2218         p-xmlh:find-first( substitute( " where gate-handle_ = &1 ", v-dsh)
     2219                            , share-lock) no-error.
     2220         if p-xmlh:available then do:
     2221           assign
     2222           v-th = p-xmlh:buffer-field("table-handle_"):buffer-value.
     2223           if valid-handle(p-xmlh:buffer-field("table-handle_"))
     2224           and valid-handle(v-th)
     2225           and v-th:dynamic = yes
     2226           then do:
     2227             delete object p-xmlh:buffer-field("table-handle_"):buffer-value.
     2228             p-xmlh:buffer-field("table-handle_"):buffer-value = ?.
     2229           end.
     2230           p-xmlh:buffer-delete().
     2231         end.
     2232         else do:
     2233           leave.
     2234         end.
     2235       end.
     2236       if p-xmlh:dynamic = yes
     2237       and valid-handle(p-xmlh)
     2238       then do:
     2239         delete object p-xmlh:table-handle.
     2240         p-xmlh = ?.
     2241       end.
     2242       v-dsh = ?.
     2243     end.
     2244   end procedure.
     2245   procedure all-gates-clear :
     2246   define parameter buffer buf_temp-xml-tables for temp-xml-tables.
     2247   do
     2248   on error undo, return error
     2249   :
     2250     for each buf_temp-xml-tables
     2251     break
     2252     by buf_temp-xml-tables.uniq-gate-rec
     2253     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2254     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     2255     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     2256     :
     2257         if first-of(buf_temp-xml-tables.uniq-gate-rec) then do:
     2258           delete object buf_temp-xml-tables.gate-handle_.
     2259           buf_temp-xml-tables.gate-handle_ = ?.
     2260         end.
     2261         if valid-handle(buf_temp-xml-tables.table-handle_)
     2262         and buf_temp-xml-tables.table-handle_:dynamic = no
     2263         then do:
     2264           delete object buf_temp-xml-tables.table-handle_.
     2265           buf_temp-xml-tables.table-handle_ = ?.
     2266         end.
     2267         delete buf_temp-xml-tables.
     2268     end.
     2269   end.
     2270   end procedure.
     2271   procedure fix-schemalocation :
     2272   define input-output  parameter p-longchar as longchar no-undo .
     2273   DEFINE VARIABLE hdoc AS HANDLE.
     2274   DEFINE VARIABLE hroot AS HANDLE.
     2275   DEFINE VARIABLE hnode-child AS HANDLE.
     2276   DEFINE VARIABLE hnode-attr AS HANDLE.
     2277   define variable v-jj as integer   no-undo .
     2278   define variable ok as logical   no-undo .
     2279   define variable v-path1                    as character                no-undo .
     2280   DEFINE VARIABLE v-full-path1               as character                no-undo .
     2281   DEFINE VARIABLE v-file-name1               as character                no-undo .
     2282   DEFINE VARIABLE v-file-name-no-ext1        as character                no-undo .
     2283   DEFINE VARIABLE v-file-name-ext1           as character                no-undo .
     2284   define variable v-schema-location          as character                no-undo .
     2285   do
     2286   on error undo, return error return-value
     2287   :
     2288     CREATE X-DOCUMENT hdoc.
     2289     CREATE X-noderef hroot.
     2290     CREATE X-noderef hnode-child.
     2291     CREATE X-noderef hnode-attr.
     2292     hdoc:load("longchar", p-longchar, no) no-error.
     2293     iF ERROR-STATUS:GET-MESSAGE(1) <> '' THEN message ERROR-STATUS:GET-MESSAGE(1) view-as alert-box .
     2294     hdoc:get-document-element(hroot).
     2295     _repeat:
     2296     REPEAT v-jj = 1 TO hroot:NUM-CHILDREN:
     2297       ok = hroot:GET-CHILD(hNode-Child, v-jj).
     2298       if not ok then next.
     2299       if hNode-Child:local-name = "include"
     2300       then do:
     2301         ok = hNode-Child:GET-ATTRIBUTE-NODE( hnode-attr, "schemaLocation" ).
     2302           v-schema-location = hnode-attr:node-value.
     2303           run gbl/filename.p (
     2304                           input "exe/" + hnode-attr:node-value
     2305                         ,output v-full-path1
     2306                         ,output v-path1
     2307                         ,output v-file-name1
     2308                         ,output v-file-name-no-ext1
     2309                         ,output v-file-name-ext1
     2310                         ) no-error .
     2311           if error-status :error then do:
     2312             delete object hnode-attr.
     2313             delete object hnode-child.
     2314             delete object hroot.
     2315             delete object hdoc.
     2316             undo, return error substitute("Не удалось определить расположение схемы &1", v-schema-location).
     2317           end.
     2318         ok = hNode-Child:sET-ATTRIBUTE(  "schemaLocation", v-full-path1 ).
     2319         leave  _repeat.
     2320       end.
     2321     END.
     2322     hdoc:save("longchar", p-longchar).
     2323     delete object hnode-attr.
     2324     delete object hnode-child.
     2325     delete object hroot.
     2326     delete object hdoc.
     2327   end.
     2328   end procedure.
     2329   procedure gate-clb_fill-xml-tables :
     2330   define input parameter p-dsh as handle no-undo .
     2331   define input-output parameter p-xmlh as handle no-undo .
     2332   define variable v-ii as integer no-undo .
     2333     do
     2334     on error undo, return error
     2335     :
     2336       do v-ii = 1 to p-dsh:num-buffers:
     2337         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     2338         if not p-xmlh:available then do:
     2339           p-xmlh:buffer-create().
     2340           assign
     2341           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     2342           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     2343           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     2344           p-xmlh::gate-handle_ = p-dsh
     2345           p-xmlh::uniq-gate-rec = entry(2, p-dsh:private-data, chr(4))
     2346           p-xmlh::gate-name = p-dsh:name
     2347           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     2348           .
     2349           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     2350             assign
     2351             p-xmlh::order = -3.
     2352           end.
     2353           p-xmlh:buffer-release().
     2354         end.
     2355       end.
     2356     end.
     2357   end procedure.
     2358   procedure all-gates-empty :
     2359   define buffer buf_temp-xml-tables for temp-xml-tables.
     2360   do
     2361   on error undo, return error
     2362   :
     2363     for each buf_temp-xml-tables
     2364     break
     2365     by buf_temp-xml-tables.uniq-gate-rec
     2366     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2367     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     2368     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     2369     :
     2370       if valid-handle(buf_temp-xml-tables.tbl-handle_) then do:
     2371         buf_temp-xml-tables.tbl-handle_:empty-temp-table().
     2372       end.
     2373     end.
     2374   end.
     2375   end procedure.
