     2429   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2430   procedure set-error :
     2431   define input parameter p-mess as character no-undo .
     2432     do
     2433     on error undo, return error
     2434     :
     2435        assign
     2436        v-last-error-message = p-mess.
     2437     end.
     2438   end procedure.
     2439   define variable p-xsd-file as character no-undo.
     2440   define variable p-shift-days-to-report as integer no-undo .
     2441   on delete of this-procedure do:
     2442     run garbcoll_clear in this-procedure .
     2443   end.
     2444   run load-ruleset-context in this-procedure ( input p-ruleset-id) no-error.
     2445   if error-status:error then do:
     2446     undo, return error return-value .
     2447   end.
     2448   if not this-procedure:persistent then do:
     2449     run proc-main in this-procedure no-error .
     2450     if error-status:error then do:
     2451       v-es = error-status:error .
     2452       v-rv = return-value .
     2453     end.
     2454     if v-es then do:
     2455         run garbcoll_clear in this-procedure .
     2456         undo, return error substitute( "&1. &2&3&4", vss-workfile, v-rv, chr(10), v-esm).
     2457     end.
     2458     run garbcoll_clear in this-procedure .
     2459   end.
     2460   procedure proc-main :
     2461   define variable p-data-datetime as datetime no-undo .
     2462   DEFINE VARIABLE v-today as date no-undo .
     2463   DEFINE VARIABLE v-time as integer no-undo .
     2464   define variable v-report-id as character no-undo .
     2465   define variable v-start-datetime as datetime no-undo .
     2466   define variable v-base-code as integer no-undo .
     2467   define variable v-dataseth as handle no-undo .
     2468   define variable v-xmlh as handle no-undo .
     2469   define variable glog as logical no-undo .
     2470   define variable v-found as logical no-undo .
     2471   define variable v-last-shift-fact-order as decimal no-undo .
     2472   define variable v-fact-order  as decimal no-undo .
     2473   define variable v-shift-end-fact-order as decimal no-undo .
     2474   define variable v-day-end-fact-order as decimal no-undo .
     2475   define variable l-shift-on as logical no-undo .
     2476   define variable v-gate-rec as character no-undo .
     2477   define variable v-longchar as longchar no-undo .
     2478   v-xmlh = buffer temp-xml-tables:handle.
     2479   define buffer buf_temp-rule-call-param for temp-rule-call-param.
     2480   define buffer buf2_temp-rule-call-param for temp-rule-call-param.
     2481   define buffer buf_clients for ub.clients.
     2482   define buffer buf_shift-obj for ub.shift-obj.
     2483   define buffer buf_currency for ub.currency.
     2484   _main:
     2485   do
     2486   on error undo, return error substitute( "&1&2&3&2&4", return-value, chr(10), error-status :get-message (1), v-last-error-message)
     2487   :
     2488     empty temp-table report-headert.
     2489     empty temp-table report-parameterst.
     2490     empty temp-table report-errorst.
     2491     v-report-id = substitute("&1/&2", p-profile-id, p-rule-id).
     2492     v-start-datetime = cur-time-datetime().
     2493     run get-gate-rec in this-procedure ( input p-xsd-file
     2494                                         ,output v-gate-rec) no-error.
     2495     if error-status:error then do:
     2496       undo, return error substitute("Не найдено описание xsd-схемы &1 в БД", p-xsd-file).
     2497     end.
     2498     v-longchar = ?.
     2499     run get-gate-by-rec in this-procedure ( input v-gate-rec
     2500                                           ,output v-dataseth
     2501                                           ,input-output v-xmlh
     2502                                           ,input-output v-longchar
     2503                                           ) no-error.
     2504     if error-status:error then do:
     2505           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при создании структуры маршрутизируемых данных согласно гейту:&1&2&3&2&4"                               , v-gate-rec                               , chr(10)                               , error-status:get-message(1)                               , return-value )).
     2506       delete object v-dataseth no-error.
     2507       undo _main, retry _main.
     2508     end.
     2509     _clients:
     2510     for each buf_temp-rule-call-param where
     2511             buf_temp-rule-call-param.param-name = "p-objects"
     2512         and buf_temp-rule-call-param.p-index > 0 :
     2513       find first buf_clients no-lock where
     2514                 buf_clients.obj-type = substring(buf_temp-rule-call-param.param-value-character, 1, 3)
     2515            and  buf_clients.obj-code = integer(substring(buf_temp-rule-call-param.param-value-character, 4)) no-error.
     2516      if available buf_clients then do:
     2517         l-shift-on = no.
     2518   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2519   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     2520     (input  buf_clients.obj-type
     2521     ,input  buf_clients.obj-code
     2522     ,input  'shift-on=request'
     2523     ,output l-shift-on
     2524     ) no-error .
     2525         if not l-shift-on then do:
     2526           next _clients.
     2527         end.
     2528   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2529   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     2530     (input  buf_clients.host-code
     2531     ,output v-base-code
     2532     )  .
     2533         find first buf_currency no-lock
     2534           where buf_currency.curr-code = v-base-code
     2535         .
     2536         v-last-shift-fact-order = 0.0.
     2537         find first buf2_temp-rule-call-param where
     2538                  buf2_temp-rule-call-param.call_id = buf_temp-rule-call-param.call_id
     2539             and  buf2_temp-rule-call-param.codex_id = buf_temp-rule-call-param.codex_id
     2540             and  buf2_temp-rule-call-param.ruleset_id = buf_temp-rule-call-param.ruleset_id
     2541             and  buf2_temp-rule-call-param.order_id = buf_temp-rule-call-param.order_id
     2542             and  buf2_temp-rule-call-param.param-name = "p-last-shift"
     2543             and  buf2_temp-rule-call-param.p-index = buf_temp-rule-call-param.p-index no-error.
     2544         if not available buf2_temp-rule-call-param then do:
     2545           run cur-time in this-procedure ( output v-today, output v-time).
     2546           run factord in this-procedure
     2547             (input  (v-today - p-shift-days-to-report)
     2548             ,input  v-time
     2549             ,input  1
     2550             ,input  (v-today - p-shift-days-to-report)
     2551             ,input  1
     2552             ,input  yes
     2553             ,output v-fact-order
     2554             ,output v-shift-end-fact-order
     2555             ,output v-day-end-fact-order
     2556             ) no-error .
     2557           if not error-status:error then do:
     2558             v-last-shift-fact-order = v-shift-end-fact-order.
     2559           end.
     2560           run cb_rcps-run_set-value in p-parent-handle (
     2561                                                     input p-call-id
     2562                                                     ,input p-codex-id
     2563                                                     ,input p-ruleset-id
     2564                                                     ,input p-order-id
     2565                                                     ,input "p-last-shift"
     2566                                                     ,input buf_temp-rule-call-param.p-index
     2567                                                     ,input 'input-output':U
     2568                                                     ,input ''
     2569                                                     ,input ?
     2570                                                     ,input v-last-shift-fact-order
     2571                                                     ,input 0
     2572                                                     ,input no
     2573                                                     ).
     2574         end.
     2575         else do:
     2576           v-last-shift-fact-order = buf2_temp-rule-call-param.param-value-decimal.
     2577         end.
     2578         v-found = no.
     2579         for each  buf_shift-obj no-lock where
     2580                 buf_shift-obj.obj-type = buf_clients.obj-type
     2581             and buf_shift-obj.obj-code = buf_clients.obj-code
     2582             and buf_shift-obj.fact-order >  v-last-shift-fact-order
     2583             and buf_shift-obj.status_ = 'зкр':U:
     2584           assign
     2585           X-date-start = buf_shift-obj.shift-date
     2586           X-shift-start = buf_shift-obj.shift-num
     2587           X-date-end = buf_shift-obj.shift-date
     2588           X-shift-end = buf_shift-obj.shift-num
     2589           .
     2590           v-found = yes.
     2591           run rep/r-shift.p
     2592             ( input parparentproc
     2593             ,input p-parent-handle
     2594             ,input p-log-handle
     2595             ,input p-cont-handle
     2596             ,input this-procedure:handle
     2597             ,input (buffer report-errorst:handle)
     2598             ,input (buffer report-destinationt:handle)
     2599             ,input substitute("&1/&2", p-profile-id, p-rule-id)
     2600             ,input p-xsd-file
     2601             ,input log-file-name
     2602             ,input integer('1':U)
     2603             ,input p-codex-id
     2604             ,input p-ruleset-id
     2605             ,INPUT buf_clients.obj-code
     2606             ,INPUT buf_clients.obj-type
     2607             ,INPUT buf_currency.curr-abbr
     2608             ,INPUT v-base-code
     2609             ,input 43
     2610             ,input no
     2611             ,INPUT "no-classify"
     2612             ,INPUT "sort-code"
     2613             ,input no
     2614             ,input 1
     2615             ,INPUT yes
     2616             ,INPUT yes
     2617             ,input yes
     2618             ,input no
     2619             ,input no
     2620             ,input no
     2621             ,input no
     2622             ,input no
     2623             ,input no
     2624             ,input no
     2625             ,input no
     2626             ,input no
     2627             ,input no
     2628             ,input no
     2629             ,input no
     2630             ,input no
     2631             ,input ""
     2632             ,input-output v-dataseth
     2633             ,input table temp-xml-tables
     2634             ) no-error.
     2635            if error-status:error then do:
     2636              next _clients.
     2637            end.
     2638            else do:
     2639              run cb_rcps-run_set-value in p-parent-handle (
     2640                                                         input p-call-id
     2641                                                        ,input p-codex-id
     2642                                                        ,input p-ruleset-id
     2643                                                        ,input p-order-id
     2644                                                        ,input "p-last-shift"
     2645                                                        ,input buf_temp-rule-call-param.p-index
     2646                                                        ,input 'input-output':U
     2647                                                        ,input ''
     2648                                                        ,input ?
     2649                                                        ,input buf_shift-obj.fact-order
     2650                                                        ,input 0
     2651                                                        ,input no
     2652                                                       ).
     2653            end.
     2654          end.
     2655          if not v-found then do:
     2656                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Нет смен для расчета для &1&2", buf_clients.obj-type, buf_clients.obj-code)).
     2657             run cb_write-report-error in p-parent-handle ( input buffer report-errorst:handle
     2658                                                           ,input v-report-id
     2659                                                           ,input ?
     2660                                                           ,input '1':U
     2661                                                           ,input substitute("Нет смен для расчета для &1&2"
     2662                                                                              , buf_clients.obj-type
     2663                                                                              , buf_clients.obj-code)
     2664                                                           ) no-error.
     2665          end.
     2666       end.
     2667     end.
     2668     run cb_fill-report-header in p-parent-handle ( input buffer buf_report-header:handle
     2669                                                   ,input v-report-id
     2670                                                   ,input "shift"
     2671                                                   ,input "Сменный отчет"
     2672                                                   ,input v-start-datetime
     2673                                                   ,input cur-time-datetime()
     2674                                                   ).
     2675     run cb_fill-report-parameters in p-parent-handle ( input buffer buf_report-parameters:handle
     2676                                                       ,input v-report-id
     2677                                                       ).
     2678     glog = v-dataseth:copy-dataset (
     2679                             dataset reportheadertypet:handle
     2680                           , no
     2681                           , yes
     2682                           , yes
     2683                           ) no-error .
     2684     if error-status:error
     2685     or not glog
     2686     then do:
     2687           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("!!Не удалось заполнить блок параметров!!! &1"                                 , error-status:get-message(1) )).
     2688     end.
     2689     run cb_rcps-run_set-value in p-cont-handle (
     2690                                                   input p-call-id
     2691                                                 ,input p-codex-id
     2692                                                 ,input p-ruleset-id
     2693                                                 ,input p-order-id
     2694                                                 ,INPUT "p-dataseth"
     2695                                                 ,INPUT 0
     2696                                                 ,input 'output':U
     2697                                                 ,INPUT string(v-dataseth)
     2698                                                 ,INPUT ?
     2699                                                 ,INPUT 0.0
     2700                                                 ,INPUT 0
     2701                                                 ,INPUT no
     2702                                                 ) no-error.
     2703     if error-status:error then do:
     2704           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("!!Не удалось передать OUTPUT параметры правила!!! &1&2&1&3"                                 , chr(10)                                 , error-status:get-message(1) )).
     2705     end.
     2706   end.
     2707   end procedure.
     2708   procedure load-ruleset-context :
     2709   define input parameter p-ruleset-id as integer no-undo .
     2710   define buffer buf_rule-call-param for ub.rule-call-param.
     2711   do
     2712   on error undo, return error
     2713   :
     2714   for each buf_temp-rule-call-param:
     2715     delete buf_temp-rule-call-param.
     2716   end.
     2717   for each buf_rule-call-param no-lock where
     2718   buf_rule-call-param.codex_id = p-codex-id
     2719   and buf_rule-call-param.ruleset_id = p-ruleset-id
     2720   and buf_rule-call-param.call_id = p-call-id
     2721   and buf_rule-call-param.order_id = p-order-id
     2722   and buf_rule-call-param.rule_id = p-rule-id
     2723   and buf_rule-call-param.param-name = "p-objects"
     2724   and buf_rule-call-param.p-index > 0:
     2725     create buf_temp-rule-call-param.
     2726     buffer-copy buf_rule-call-param to buf_temp-rule-call-param.
     2727     release buf_temp-rule-call-param.
     2728   end.
     2729   for each buf_rule-call-param no-lock where
     2730   buf_rule-call-param.codex_id = p-codex-id
     2731   and buf_rule-call-param.ruleset_id = p-ruleset-id
     2732   and buf_rule-call-param.call_id = p-call-id
     2733   and buf_rule-call-param.order_id = p-order-id
     2734   and buf_rule-call-param.rule_id = p-rule-id
     2735   and buf_rule-call-param.param-name = "p-last-shift"
     2736   and buf_rule-call-param.p-index > 0:
     2737     create buf_temp-rule-call-param.
     2738     buffer-copy buf_rule-call-param to buf_temp-rule-call-param.
     2739     release buf_temp-rule-call-param.
     2740   end.
     2741     find first buf_rule-call-param no-lock where
     2742   buf_rule-call-param.codex_id = p-codex-id
     2743   and buf_rule-call-param.ruleset_id = p-ruleset-id
     2744   and buf_rule-call-param.call_id = p-call-id
     2745   and buf_rule-call-param.order_id = p-order-id
     2746   and buf_rule-call-param.rule_id = p-rule-id
     2747   and buf_rule-call-param.param-name = "p-xsd-file"
     2748    no-error.
     2749   if available buf_rule-call-param then do:
     2750   assign p-xsd-file = buf_rule-call-param.param-value-character.
     2751   end.
     2752     find first buf_rule-call-param no-lock where
     2753   buf_rule-call-param.codex_id = p-codex-id
     2754   and buf_rule-call-param.ruleset_id = p-ruleset-id
     2755   and buf_rule-call-param.call_id = p-call-id
     2756   and buf_rule-call-param.order_id = p-order-id
     2757   and buf_rule-call-param.rule_id = p-rule-id
     2758   and buf_rule-call-param.param-name = "p-shift-days-to-report"
     2759    no-error.
     2760   if available buf_rule-call-param then do:
     2761   assign p-shift-days-to-report = buf_rule-call-param.param-value-integer.
     2762   end.
     2763       case p-ruleset-id:
     2764         when 1
     2765         then do:
     2766           assign
     2767           v-sign = 0
     2768           v-current-host-code = p0-host-code
     2769           v-current-obj-type = p-obj-type
     2770           v-current-obj-code = p-obj-code
     2771           v-current-db-num = g#db-num
     2772           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     2773           v-dirs  = p-process-dirs
     2774           v-current-rep-code  = p-doc-code
     2775           .
     2776         end.
     2777      end case.
     2778   end.
     2779   end procedure.
