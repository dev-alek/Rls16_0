      997         input 1
      998       , input log-file-name
      999       , input 1
     1000       , input p-str).
     1001   end procedure.
     1002   procedure write-to-log :
     1003   define input param p-str as character no-undo .
     1004   run write-log-and-file in p-log-handle (
