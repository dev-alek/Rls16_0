     1008       , input p-str).
     1009   end procedure.
     1010   procedure write-to-log-notime :
     1011   define input param p-str as character no-undo .
     1012   run write-log-and-file in p-log-handle (
     1013         input 1
     1014       , input log-file-name
     1015       , input 1
     1016       , input p-str).
     1017   end procedure.
     1018   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1019   procedure set-error :
     1020   define input parameter p-mess as character no-undo .
     1021     do
     1022     on error undo, return error
     1023     :
     1024        assign
     1025        v-last-error-message = p-mess.
     1026     end.
     1027   end procedure.
     1028     define variable p-keep-days as integer no-undo.
     1029     define variable p-luft-days as integer no-undo.
     1030   on delete of this-procedure do:
     1031     run garbcoll_clear in this-procedure .
     1032   end.
     1033   run load-ruleset-context in this-procedure ( input p-ruleset-id) no-error.
     1034   if error-status:error then do:
     1035     undo, return error return-value .
     1036   end.
     1037   if return-value = "return" then return ''.
     1038   if not this-procedure:persistent then do:
     1039     run proc-main in this-procedure no-error .
     1040     if error-status:error then do:
     1041       v-esm = error-status :get-message (1).
     1042       v-es = error-status:error .
     1043       v-rv = return-value .
     1044     end.
     1045     if v-es then do:
     1046         run garbcoll_clear in this-procedure .
     1047         undo, return error substitute( "&1. &2&3&4", vss-workfile, v-rv, chr(10), v-esm).
     1048     end.
     1049     run garbcoll_clear in this-procedure .
     1050   end.
     1051   procedure proc-main :
     1052   _main:
     1053   do
     1054   on error undo, return error substitute( "&1&2&3&2&4", return-value, chr(10), error-status :get-message (1), v-last-error-message)
     1055   :
     1056   define variable v-err as logical no-undo .
     1057   define variable v-action as character no-undo .
     1058   define variable v-full-path        as character no-undo .
     1059   define variable v-path             as character no-undo .
     1060   define variable v-file-name        as character no-undo .
     1061   define variable v-file-name-no-ext as character no-undo .
     1062   define variable v-file-name-ext    as character no-undo .
     1063   define variable lns-cnt as integer no-undo .
     1064   define variable line-rec as recid no-undo .
     1065   define variable v-ii as integer no-undo .
     1066   define variable v-host-code as integer no-undo .
     1067   define buffer buf_goods for ub.goods.
     1068   DEFINE VARIABLE v-today as date no-undo .
     1069   DEFINE VARIABLE v-time as integer no-undo .
     1070   define variable v-start-date as date no-undo .
     1071   define variable v-end-date as date no-undo .
     1072   define variable v-start-date-str as character no-undo .
     1073   define variable v-end-date-str as character no-undo .
     1074   define buffer buf_parts-obj-attr for ub.parts-obj-attr.
     1075   v-action = "D".
     1076   for each obj-list where obj-list.obj-type = 'маг':U
     1077   break
     1078   by obj-list.obj-type
     1079   by obj-list.obj-code
     1080   :
     1081     for each bc-list:
     1082       delete bc-list.
     1083     end.
     1084     for each pbc-list:
     1085       delete pbc-list.
     1086     end.
     1087     run cur-time in this-procedure ( output v-today, output v-time).
     1088     v-end-date = v-today - p-keep-days.
     1089     v-start-date = v-end-date - p-luft-days.
     1090     v-start-date-str = substitute("&1-&2-&3", string(year(v-start-date), "9999")
     1091                                              , string(month(v-start-date), "99")
     1092                                              , string(day(v-start-date), "99")).
     1093     v-end-date-str = substitute("&1-&2-&3", string(year(v-end-date), "9999")
     1094                                            ,string(month(v-end-date), "99")
     1095                                            ,string(day(v-end-date), "99")).
     1096     for each buf_parts-obj-attr no-lock where
     1097                  buf_parts-obj-attr.obj-type  = obj-list.obj-type
     1098              and buf_parts-obj-attr.obj-code  = obj-list.obj-code
     1099              and buf_parts-obj-attr.attr-code = 'parts-end':U
     1100              and buf_parts-obj-attr.attr-value >= v-start-date-str
     1101              and buf_parts-obj-attr.attr-value < v-start-date-str:
     1102       run create-bc-list in this-procedure ( input buf_parts-obj-attr.gds-code
     1103                                             ,buffer buf_parts-obj-attr) no-error.
     1104     end.
     1105     if can-find(first bc-list no-lock) then do:
     1106         run str/diallog.w ( input parparentproc
     1107                       , input this-procedure
     1108                       , input 'str/send-bcn.p':U
     1109                       , input (string(obj-list.obj-code) + chr(4) + v-action)
     1110                       , input yes
     1111                       , input ''
     1112                       , input (if v-action = "U"
     1113                               then 'Отсылка баркодов на кассу'
     1114                               else 'Удаление баркодов с кассы'
     1115                               )) no-error .
     1116         if error-status:error
     1117         or v-view-log
     1118         then do:
     1119                   v-full-path = ''.
     1120           run gbl/filename.p (
     1121                         input "send-cd.txt"
     1122                         ,output v-full-path
     1123                         ,output v-path
     1124                         ,output v-file-name
     1125                         ,output v-file-name-no-ext
     1126                         ,output v-file-name-ext
     1127                         ) no-error .
     1128                   if valid-handle(p-log-handle) then           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute( " Ошибка отсылки/удаления на кассу/с кассы кодов закончившихся партий по расписанию: Ошибка в процессе отсылки на кассы маг&1"                                          , obj-list.obj-code )).
     1129           if valid-handle(p-log-handle) then           run send-msg-to-email in p-log-handle (                 input substitute( "ТН БД &1. Операции с товарами в автоматическом режиме - пересылка/удаление на кассу/с укассы"                                         , g#db-num)               , input substitute( " Ошибка отсылки/удаления на кассу/с кассы кодов закончившихся партий по расписанию: Ошибка в процессе отсылки на кассы маг&1"                                          , obj-list.obj-code )               , input v-full-path).
     1130           OS-DELETE value(v-full-path).
     1131         end.
     1132         if can-find(first pbc-list no-lock) then do:
     1133           run str/diallog.w ( input parparentproc
     1134                         , input this-procedure
     1135                         , input 'str/s-prdbcn.p':U
     1136                         , input (string(obj-list.obj-code) + chr(4) + v-action)
     1137                         , input yes
     1138                         , input ''
     1139                         , input (if v-action = "U"
     1140                                 then 'Отсылка ДопБК на кассу'
     1141                                 else 'Удаление ДопБК с кассы'
     1142                                 )) no-error .
     1143           if error-status:error
     1144           or v-view-log
     1145           then do:
     1146                       v-full-path = ''.
     1147             run gbl/filename.p (
     1148                           input "send-cd.txt"
     1149                           ,output v-full-path
     1150                           ,output v-path
     1151                           ,output v-file-name
     1152                           ,output v-file-name-no-ext
     1153                           ,output v-file-name-ext
     1154                           ) no-error .
     1155                       if valid-handle(p-log-handle) then           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute( " Ошибка отсылки/удаления на кассу/с кассы ДопБК кодов закончившихся партий по расписанию: Ошибка в процессе отсылки на кассы маг&1"                                            , obj-list.obj-code )).
     1156             if valid-handle(p-log-handle) then           run send-msg-to-email in p-log-handle (                 input substitute( "ТН БД &1. Операции с товарами в автоматическом режиме - пересылка/удаление на кассу/с укассы"                                         , g#db-num)               , input substitute( " Ошибка отсылки/удаления на кассу/с кассы ДопБК кодов закончившихся партий по расписанию: Ошибка в процессе отсылки на кассы маг&1"                                            , obj-list.obj-code )               , input v-full-path).
     1157             OS-DELETE value(v-full-path).
     1158           end.
     1159         end.
     1160     end.
     1161     else do:
     1162           if valid-handle(p-log-handle) then           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute(" При отсылке/удалении на кассу/с кассы кодов закончившихся партий по расписанию не было обнаружено кодов партий для удаления для маг&1", obj-list.obj-code)).
     1163     end.
     1164   end.
     1165   end.
     1166   end procedure.
     1167   procedure load-ruleset-context :
     1168   define input parameter p-ruleset-id as integer no-undo .
     1169   define buffer buf_rule-call-param for ub.rule-call-param.
     1170   define buffer buf_temp-rule-call-param for temp-rule-call-param.
     1171   define buffer buf_clients for ub.clients.
     1172   do
     1173   on error undo, return error
     1174   :
     1175     find first buf_rule-call-param no-lock where
     1176   buf_rule-call-param.codex_id = p-codex-id
     1177   and buf_rule-call-param.ruleset_id = p-ruleset-id
     1178   and buf_rule-call-param.call_id = p-call-id
     1179   and buf_rule-call-param.order_id = p-order-id
     1180   and buf_rule-call-param.rule_id = p-rule-id
     1181   and buf_rule-call-param.param-name = "p-keep-days"
     1182    no-error.
     1183   if available buf_rule-call-param then do:
     1184     assign p-keep-days = buf_rule-call-param.param-value-integer.
     1185   end.
     1186     find first buf_rule-call-param no-lock where
     1187   buf_rule-call-param.codex_id = p-codex-id
     1188   and buf_rule-call-param.ruleset_id = p-ruleset-id
     1189   and buf_rule-call-param.call_id = p-call-id
     1190   and buf_rule-call-param.order_id = p-order-id
     1191   and buf_rule-call-param.rule_id = p-rule-id
     1192   and buf_rule-call-param.param-name = "p-luft-days"
     1193    no-error.
     1194   if available buf_rule-call-param then do:
     1195     assign p-luft-days = buf_rule-call-param.param-value-integer.
     1196   end.
     1197   for each buf_rule-call-param no-lock where
     1198   buf_rule-call-param.codex_id = p-codex-id
     1199   and buf_rule-call-param.ruleset_id = p-ruleset-id
     1200   and buf_rule-call-param.call_id = p-call-id
     1201   and buf_rule-call-param.order_id = p-order-id
     1202   and buf_rule-call-param.rule_id = p-rule-id
     1203   and buf_rule-call-param.param-name = "p-shops"
     1204   and buf_rule-call-param.p-index > 0:
     1205     create buf_temp-rule-call-param.
     1206     buffer-copy buf_rule-call-param to buf_temp-rule-call-param.
     1207     release buf_temp-rule-call-param.
     1208   end.
     1209     for each buf_temp-rule-call-param where
     1210           buf_temp-rule-call-param.param-name = "p-shops":
     1211       find first buf_clients no-lock
     1212         where buf_clients.obj-type  = 'маг':U
     1213           and buf_clients.obj-code = buf_temp-rule-call-param.param-value-integer
     1214       no-error.
     1215       if not available buf_clients
     1216       then do:
     1217                           if valid-handle(p-log-handle) then           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute( " Ошибка отсылки/удаления на кассу/с кассы списка товаров по расписанию&3: Не найден заданный объект &1&2"                                          , 'маг':U                                         , buf_temp-rule-call-param.param-value-integer                                         , chr(10))).
     1218           if valid-handle(p-log-handle) then           run send-msg-to-email in p-log-handle (                 input substitute( "ТН БД &1. Операции с товарами в автоматическом режиме - пересылка/удаление на кассу/с укассы"                                         , g#db-num)               , input substitute( " Ошибка отсылки/удаления на кассу/с кассы списка товаров по расписанию&3: Не найден заданный объект &1&2"                                          , 'маг':U                                         , buf_temp-rule-call-param.param-value-integer                                         , chr(10))               , input '').
     1219           undo, return error .
     1220       end.
     1221       else do:
     1222         if buf_clients.db-num = g#db-num
     1223         and buf_clients.obj-type = 'маг':U
     1224         then do:
     1225           run create_obj-list in this-procedure ( input buf_clients.obj-type
     1226                                                   ,input buf_clients.obj-code).
     1227         end.
     1228       end.
     1229     end.
     1230       case p-ruleset-id:
     1231         when 10 then do:
     1232         end.
     1233         otherwise do:
     1234           undo, return error substitute("Вызов процедуры &1 в неверном контексте", p-rule-id).
     1235         end.
     1236       end case.
     1237   end.
     1238   end procedure.
     1239   procedure cb_set-view-log :
     1240   define input parameter p-view-log as logical no-undo .
     1241   v-view-log = yes.
     1242   end procedure.
     1243   procedure create-bc-list :
     1244   define input parameter p-gds-code as integer no-undo .
     1245   define parameter buffer buf_parts-obj-attr for ub.parts-obj-attr.
     1246   define variable lns-cnt as integer no-undo .
     1247   define variable line-rec as recid no-undo .
     1248   define buffer buf_bar-code for ub.bar-code.
     1249   define buffer buf_prod-bc for ub.prod-bc.
     1250   define buffer buf_goods for ub.goods.
     1251   find first buf_goods no-lock where
     1252             buf_goods.gds-code = p-gds-code no-error.
     1253   if not available buf_goods then do:
     1254   end.
     1255   find first buf_bar-code no-lock where
     1256             buf_bar-code.gds-code = p-gds-code
     1257         and buf_bar-code.in-code = buf_parts-obj-attr.in-code
     1258         and buf_bar-code.part-code = buf_parts-obj-attr.part-code
     1259         and buf_bar-code.unit-cli = buf_goods.unit-base
     1260               no-error.
     1261   if not available buf_bar-code then do:
     1262   end.
     1263   create bc-list.
     1264   buffer-copy buf_bar-code to bc-list
     1265   assign
     1266   bc-list.del = yes
     1267   .
     1268   for each buf_prod-bc no-lock where
     1269           buf_prod-bc.b-code = buf_bar-code.b-code
     1270       and buf_prod-bc.bc-on = yes:
     1271     create pbc-list.
     1272     buffer-copy buf_prod-bc to pbc-list
     1273     assign
     1274     pbc-list.del = yes
     1275     .
     1276     release pbc-list.
     1277   end.
     1278   release bc-list.
     1279   end procedure.
