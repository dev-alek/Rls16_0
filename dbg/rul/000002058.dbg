      962                           .
      963   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      964   def new shared temp-table bc-list no-undo like ub.bar-code
      965                           field del as  logical
      966                           index bc is unique b-code del
      967                           index gds-code-i gds-code del.
      968   define variable v-current-gds-code as integer no-undo .
      969   define variable v-current-artic as character no-undo .
      970   define variable v-current-prod-type as character no-undo .
      971   define variable v-current-prod-code as integer no-undo .
      972   define variable v-current-host-code as integer no-undo .
      973   define variable v-current-obj-type as character no-undo .
      974   define variable v-current-obj-code as integer no-undo .
      975   define variable v-current-doc-code as character no-undo .
      976   define variable v-esys-cmd-proc-handle as handle no-undo .
      977   define variable v-esys-cmd-code as integer no-undo .
      978   define variable log-file-name                as character      no-undo init "shd-free.log".
      979   define variable v-view-log                   as logical        no-undo .
      980   define variable v-stop                       as logical        no-undo .
      981   define variable v-last-error-message as character no-undo .
      982   define variable file-name as char.
      983   define variable v-sign as integer no-undo .
      984   define variable num-rec as integer no-undo .
      985   define variable num-rec-ok as integer no-undo .
      986   define variable l-res as integer no-undo .
      987   define variable v-es as logical no-undo .
      988   define variable v-esm as character no-undo .
      989   define variable v-rv as character no-undo .
      990   define variable v-err-mess as character no-undo .
      991   define temp-table temp-rule-call-param no-undo like ub.rule-call-param.
      992   define stream ext-file.
      993   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      994   procedure write-to-screen :
      995   define input param p-str as character no-undo .
