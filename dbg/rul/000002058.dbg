        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-parent-handle as handle no-undo .
        4   define input parameter p-log-handle  as handle no-undo .
        5   define input parameter p-cont-handle  as handle no-undo .
        6   define input parameter p-codex-id as integer no-undo .
        7   define input parameter p-ruleset-id as integer no-undo .
        8   define input parameter p-call-id as character no-undo .
        9   define input parameter p-order-id as integer no-undo .
       10   define input parameter p-rule-id as integer no-undo .
       11   define input parameter p-profile-id as integer no-undo .
       12   define input parameter p-is-dynamic as logical no-undo .
       13   define input parameter p-doc-type as character no-undo .
       14   define input parameter p-host-code like ub.sysconf.host-code no-undo .
       15   define input parameter p-obj-type like ub.clients.obj-type no-undo .
       16   define input parameter p-obj-code like ub.clients.obj-code no-undo .
       17   define input parameter p-doc-code as character no-undo .
       18   define input parameter p-process-file-name as character no-undo .
       19   define input parameter p-save       as integer no-undo .
       20   define input parameter v-curr-r-b   as character no-undo .
       21   define input parameter p-cmd-proc-handle as handle no-undo .
       22   define input parameter p-cmd-code  as integer no-undo .
       23   define variable vss-revision    as character no-undo init "$Revision$":U .
       24   define variable vss-author      as character no-undo init "$Author$":U .
       25   define variable vss-date        as character no-undo init "$Date$":U .
       26   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       27   define variable vss-archive     as character no-undo init "$Archive$":U .
       28   define variable vss-description as character no-undo init "Библиотека процедур для работы с кодексом 11, набор 10".
       29   procedure vss-get-info :
       30     define output parameter p-vss-revision    like vss-revision    no-undo .
       31     define output parameter p-vss-author      like vss-author      no-undo .
       32     define output parameter p-vss-date        like vss-date        no-undo .
       33     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       34     define output parameter p-vss-archive     like vss-archive     no-undo .
       35     define output parameter p-vss-description like vss-description no-undo .
       36     assign
       37       p-vss-revision    = vss-revision
       38       p-vss-author      = vss-author
       39       p-vss-date        = vss-date
       40       p-vss-workfile    = vss-workfile
       41       p-vss-archive     = vss-archive
       42       p-vss-description = vss-description
       43     .
       44   end procedure.
       45   procedure vss-get-parameters :
       46     define output parameter p-vss-parameters as character no-undo .
       47   end procedure.
       48   define new global shared variable g#vssrevis-logger as handle    no-undo .
       49   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       50   define variable v-vssrevis-logger                   as handle    no-undo .
       51   procedure vss-logevent :
       52     define input  parameter p-extra-paramters as character no-undo .
       53     define variable v-vssrevis-parameters as character no-undo .
       54     do
       55     on error undo, return error return-value
       56     :
       57       if  valid-handle(v-vssrevis-logger)
       58       and v-vssrevis-logger :get-signature("logevent") <> ""
       59       then do:
       60         run vss-get-parameters in this-procedure
       61           (output v-vssrevis-parameters
       62           ).
       63         run logevent in v-vssrevis-logger
       64           (input vss-workfile
       65           ,input vss-revision
       66           ,input v-vssrevis-parameters
       67           ,input p-extra-paramters
       68           ).
       69       end.
       70     end.
       71   end procedure.
       72   assign
       73     v-vssrevis-logger = g#vssrevis-logger
       74   .
       75   if  valid-handle(v-vssrevis-logger)
       76   and v-vssrevis-logger :get-signature("logevent") <> ""
       77   then do:
       78     assign
       79       v-vssrevis-logevent = true
       80     .
       81     run vss-logevent in this-procedure (input vss-description) .
       82   end.
       83   define new global shared variable g#language as character no-undo .
       84   if g#language <> '' and g#language <> 'rus':U then do:
       85     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       86   end.
       87   define new global shared variable g#library  as handle no-undo .
       88   define new global shared variable g#library2 as handle no-undo .
       89   define   shared variable g#auto as logical no-undo.
       90   define   shared variable g#news as logical no-undo.
       91   define   shared variable g#oxml as logical no-undo.
       92   define   shared variable g#esys as logical no-undo.
       93   define   shared variable g#news-source-db as integer no-undo.
       94   define   shared variable g#esys-source-esys as integer no-undo.
       95   define   shared variable g#db-num as integer   no-undo .
       96   define   shared variable g#userid as character no-undo .
       97   define   shared variable g#passwd as character no-undo .
       98   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       99   define  variable garbcoll_ii as integer no-undo .
      100   define  temp-table temp-gc no-undo
      101   field ii as integer
      102   field obj-r as handle
      103   field cn as character
      104   index pi is unique primary
      105   ii
      106   index icn
      107   cn.
      108   procedure garbcoll_create-gc-entry :
      109   define input parameter p-cn as character no-undo .
      110   define input parameter p-obj-r as handle no-undo .
      111     do
      112     on error undo, return error
      113     :
      114       create temp-gc.
      115       assign
      116       temp-gc.ii = garbcoll_ii
      117       garbcoll_ii = garbcoll_ii + 1
      118       temp-gc.cn = p-cn
      119       temp-gc.obj-r = p-obj-r
      120       .
      121     end.
      122   end procedure.
      123   procedure garbcoll_clear :
      124     do
      125     on error undo, return error
      126     :
      127       for each temp-gc:
      128         delete object temp-gc.obj-r.
      129         delete temp-gc.
      130       end.
      131     end.
      132   end procedure.
      133   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      134   procedure cur-time :
      135      define output parameter p-today as date      no-undo .
      136      define output parameter p-time  as integer   no-undo .
      137     do
      138     on error undo, return error
      139     :
      140       define variable v-date1 as date      no-undo .
      141       define variable v-date2 as date      no-undo .
      142       define variable v-time  as integer   no-undo .
      143       assign
      144         v-date1 = today
      145         v-time  = time
      146         v-date2 = today
      147       .
      148       if v-date1 <> v-date2
      149       then do:
      150         assign
      151           v-date1 = today
      152           v-time  = v-time
      153         .
      154       end.
      155       assign
      156         p-today = v-date1
      157         p-time  = v-time
      158       .
      159     end.
      160   end.
      161   function cur-time-date returns character
      162   :
      163     return string(today, '99/99/9999':U) .
      164   end.
      165   function cur-time-mjd returns decimal
      166   :
      167     define variable v-date as date      no-undo .
      168     define variable v-time as integer   no-undo .
      169     run cur-time in this-procedure
      170       (output v-date
      171       ,output v-time
      172       ) .
      173     return integer(v-date) - 2400002 + (v-time / 86400) .
      174   end.
      175   function cur-time-get-ending-index returns integer
      176   (input p-number as integer
      177   )
      178   :
      179     if p-number < 0
      180     or p-number = ?
      181     then do:
      182       return 1 .
      183     end.
      184     define variable v-rest as integer   no-undo .
      185     assign
      186       p-number = p-number modulo 100
      187     .
      188     if p-number < 20
      189     then do:
      190       assign
      191         v-rest = p-number
      192       .
      193     end.
      194     else do:
      195       assign
      196         v-rest = p-number modulo 10
      197       .
      198     end.
      199     case v-rest :
      200       when 1
      201       then do:
      202         return 2 .
      203       end.
      204       when 2 or
      205       when 3 or
      206       when 4
      207       then do:
      208         return 3 .
      209       end.
      210       otherwise do:
      211         return 1 .
      212       end.
      213     end case .
      214   end.
      215   procedure cur-time-mjd-to-date :
      216      define input  parameter i-mjd-diff as decimal no-undo.
      217      define output parameter o-Date     as date    no-undo.
      218      define output parameter o-Time     as integer no-undo.
      219      define variable v-day-number as integer   no-undo .
      220      if    i-mjd-diff < 0
      221         or i-mjd-diff = ?
      222      then do:
      223         return "?" .
      224      end.
      225      assign
      226         v-day-number = truncate(i-mjd-diff,0).
      227         o-Date = date(v-day-number + 2400002).
      228         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      229     .
      230   end.
      231   function cur-time-mjd-to-string returns character
      232   (input p-mjd-diff as decimal
      233   )
      234   :
      235     define variable v-day-number as integer   no-undo .
      236     define variable v-seconds    as integer   no-undo .
      237     define variable v-hour       as integer   no-undo .
      238     define variable v-min        as integer   no-undo .
      239     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      240     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      241     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      242     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      243     if p-mjd-diff < 0
      244     or p-mjd-diff = ?
      245     then do:
      246       return "?" .
      247     end.
      248     assign
      249       v-day-number = integer(truncate(p-mjd-diff,0))
      250       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      251     .
      252     if v-seconds > 86400
      253     then do:
      254       assign
      255         v-seconds = 86400 - 1
      256       .
      257     end.
      258     if v-seconds < 0
      259     then do:
      260       assign
      261         v-seconds = 0
      262       .
      263     end.
      264     assign
      265       v-hour = truncate(v-seconds / 3600, 0)
      266     .
      267     assign
      268       v-seconds = v-seconds modulo 3600
      269     .
      270     assign
      271       v-min = truncate(v-seconds / 60, 0)
      272     .
      273     assign
      274       v-seconds = v-seconds modulo 60
      275     .
      276     return
      277         (if v-day-number <> 0
      278           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      279           else ""
      280         )
      281       + (if v-day-number <> 0 or v-hour <> 0
      282           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      283           else ""
      284         )
      285       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      286           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      287           else ""
      288         )
      289       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      290       .
      291   end.
      292   function cur-time-string returns character
      293   :
      294     define variable v-date as date      no-undo .
      295     define variable v-time as integer   no-undo .
      296     run cur-time in this-procedure
      297       (output v-date
      298       ,output v-time
      299       ) .
      300     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      301   end.
      302   function cur-time-string-sec returns character
      303   :
      304     define variable v-date as date      no-undo .
      305     define variable v-time as integer   no-undo .
      306     run cur-time in this-procedure
      307       (output v-date
      308       ,output v-time
      309       ) .
      310     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      311   end.
      312   function cur-time-custom  returns character
      313   (input p-prefix as character
      314   ,input p-date-format as character
      315   ,input p-delimiter as character
      316   ,input p-time-format as character
      317   ,input p-suffix as character
      318   )
      319   :
      320     define variable v-date as date      no-undo .
      321     define variable v-time as integer   no-undo .
      322     run cur-time in this-procedure
      323       (output v-date
      324       ,output v-time
      325       ) .
      326     return
      327       p-prefix
      328       + string(v-date, p-date-format)
      329       + p-delimiter
      330       + string(v-time, p-time-format)
      331       + p-suffix
      332       .
      333   end.
      334   function cur-time-print  returns character
      335   :
      336     define variable v-date as date      no-undo .
      337     define variable v-time as integer   no-undo .
      338     run cur-time in this-procedure
      339       (output v-date
      340       ,output v-time
      341       ) .
      342     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      343   end.
      344   function cur-time-datetime returns datetime
      345   :
      346     define variable v-char as character no-undo .
      347     define variable v-datetime as datetime no-undo .
      348     v-char = cur-time-string().
      349     v-datetime = datetime(v-char).
      350     return  v-datetime.
      351   end.
      352   function cur-time-string-msec returns character
      353   :
      354     define variable v-date as datetime  no-undo .
      355     v-date = now.
      356     return string(v-date) .
      357   end.
      358   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      359   define new global shared variable g#lib-nws as handle no-undo .
      360   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      361   procedure gen-key-rec :
      362     define input  parameter p-tbl-name    as character no-undo.
      363     define input  parameter p-bh_tbl-name as handle    no-undo.
      364     define output parameter p-key-rec     as character no-undo.
      365     do
      366     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      367     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      368     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      369     :
      370       define variable fh               as handle    no-undo .
      371       define variable v-ok             as logical   no-undo .
      372       define variable v-inform         as character no-undo .
      373       define variable v-ind            as integer   no-undo .
      374       define variable v-idx-field-qnty as integer   no-undo .
      375       if p-tbl-name = ?
      376         or p-tbl-name = "":U
      377       then do:
      378         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info3 ).
      379       end.
      380       if not p-bh_tbl-name:available then do:
      381         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info3, p-tbl-name ).
      382       end.
      383       assign
      384         p-key-rec = p-tbl-name
      385         v-inform  = p-bh_tbl-name:index-information(1)
      386         v-ind     = 2
      387       .
      388       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      389       on error undo, return error
      390       :
      391         assign
      392           v-inform = p-bh_tbl-name:index-information( v-ind )
      393           v-ind    = v-ind + 1
      394         .
      395       end.
      396       if v-inform = ?
      397         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      398         or entry( 3, v-inform, ",":U ) <> "1":U
      399       then do:
      400         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, p-tbl-name ).
      401       end.
      402       else do:
      403         assign
      404           v-idx-field-qnty = num-entries( v-inform ) - 4
      405         .
      406         if v-idx-field-qnty < 2 then do:
      407           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, p-tbl-name ).
      408         end.
      409         do v-ind = 1 to v-idx-field-qnty by 2
      410         on error undo, return error
      411         :
      412           assign
      413             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      414             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      415           .
      416         end.
      417       end.
      418       if p-key-rec = ? then do:
      419         assign
      420           p-key-rec = "":U
      421         .
      422         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info3, p-tbl-name ).
      423       end.
      424     end.
      425     return.
      426   end procedure.
      427   procedure gen-where-keyr-tab :
      428     define input  parameter i-tableSerach as character no-undo.
      429     define input  parameter i-tablekey   as character  no-undo.
      430     define input  parameter p-key-rec    as character  no-undo.
      431     define input  parameter p-key-handle as handle     no-undo .
      432     define input  parameter p-db-name    as character  no-undo .
      433     define input  parameter p-tt-handle  as handle     no-undo .
      434     define output parameter o-Where      as character  no-undo.
      435     do
      436     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      437     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      438     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      439     :
      440       define variable v-full-tbl-name  as character no-undo .
      441       define variable bh_tbl-name      as handle    no-undo .
      442       define variable fh_key           as handle    no-undo .
      443       define variable fh_search        as handle    no-undo .
      444       define variable v-field-num      as integer   no-undo .
      445       define variable v-count-fld      as integer   no-undo .
      446       define variable v-inform         as character no-undo .
      447       define variable v-ind            as integer   no-undo .
      448       define variable v-idx-field-qnty as integer   no-undo .
      449       define variable v-field-name     as character no-undo .
      450       define variable v-field-val      as character no-undo .
      451       define variable v-word-link      as character no-undo .
      452       define variable vTable           as character no-undo.
      453       define variable bh_tbl-key       as handle    no-undo .
      454       assign
      455         p-key-rec = trim( p-key-rec )
      456       .
      457       if p-key-handle <> ? then do:
      458         if not valid-handle(p-key-handle)
      459            or p-key-handle:type <> "buffer"
      460         then do:
      461           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info3 ).
      462         end.
      463         if num-entries( p-key-rec, chr(3) ) > 1
      464           or p-key-rec = ?
      465           or p-key-rec = "":U
      466         then do:
      467           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info3, p-key-rec ).
      468         end.
      469       end.
      470       else do:
      471         if p-key-rec = ?
      472           or p-key-rec = "":U
      473         then do:
      474           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      475         end.
      476       end.
      477       assign
      478         vTable = entry( 1 , p-key-rec, chr(3) )
      479       .
      480       if p-tt-handle <> ?
      481         and ( not valid-handle(p-tt-handle)
      482               or p-tt-handle:type <> "buffer"
      483             )
      484       then do:
      485         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info3, vTable, chr(10) ).
      486       end.
      487       if p-tt-handle = ? then do:
      488         assign
      489           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      490         .
      491         create buffer bh_tbl-name for table v-full-tbl-name .
      492       end.
      493       else do:
      494         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      495       end.
      496       assign
      497         v-inform = bh_tbl-name:index-information(1)
      498         v-ind    = 2
      499       .
      500       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      501       on error undo, return error
      502       :
      503         assign
      504           v-inform = bh_tbl-name:index-information( v-ind )
      505           v-ind    = v-ind + 1
      506         .
      507       end.
      508       if v-inform = ?
      509         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      510         or entry( 3, v-inform, ",":U ) <> "1":U
      511       then do:
      512         delete object bh_tbl-name no-error.
      513         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info3, vTable ).
      514       end.
      515       assign
      516         v-idx-field-qnty = num-entries( v-inform ) - 4
      517       .
      518       if v-idx-field-qnty < 2 then do:
      519         delete object bh_tbl-name no-error.
      520         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, vTable ).
      521       end.
      522       assign
      523         o-where     = "where":U
      524         v-word-link = "":U
      525         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      526         v-count-fld = 0
      527       .
      528       if i-tablekey ne "" and i-tablekey ne ?
      529       then do:
      530         assign
      531           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      532         .
      533         create buffer bh_tbl-key for table v-full-tbl-name .
      534       end.
      535       if i-tableSerach ne "" and i-tableSerach ne ?
      536       then do:
      537         delete object bh_tbl-name no-error.
      538         assign
      539           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      540         .
      541         create buffer bh_tbl-name for table v-full-tbl-name .
      542       end.
      543       block_where:
      544       do v-ind = 1 to v-idx-field-qnty by 2
      545       on error undo, return error
      546       :
      547         assign
      548           v-count-fld = v-count-fld + 1
      549         .
      550         if p-key-handle = ?
      551           and v-count-fld > v-field-num
      552         then do:
      553           leave block_where.
      554         end.
      555         define variable VfieldKeyTable as handle no-undo.
      556         assign
      557           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      558           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      559         .
      560         if     bh_tbl-key ne ?
      561         then do:
      562            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      563            if VfieldKeyTable eq ?
      564            then next block_where.
      565         end.
      566         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      567         then
      568            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      569         else
      570            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      571         if p-key-handle = ? then do:
      572           assign
      573             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      574           .
      575         end.
      576         else do:
      577           assign
      578             fh_key = p-key-handle:buffer-field( v-field-name )
      579           .
      580           if fh_key = ?
      581             or not valid-handle( fh_key )
      582           then do:
      583             delete object bh_tbl-name.
      584             if     bh_tbl-key ne ?
      585             then
      586                delete object bh_tbl-key.
      587             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info3, p-key-handle:name, v-field-name ).
      588           end.
      589           assign
      590             v-field-val = fh_key:buffer-value
      591           .
      592         end.
      593         if fh_search:data-type ="character":U then do:
      594           assign
      595             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      596             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      597             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      598             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      599             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      600             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      601             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      602             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      603             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      604             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      605             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      606             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      607             v-field-val = substitute( '"&1"', v-field-val )
      608           .
      609         end.
      610         assign
      611           o-where = substitute( "&1 &2", o-where, v-field-val )
      612         .
      613         if v-word-link = "":U then do:
      614           assign
      615             v-word-link = "and":U
      616           .
      617         end.
      618       end.
      619       delete object bh_tbl-name.
      620       if     bh_tbl-key ne ?
      621       then
      622          delete object bh_tbl-key.
      623       if p-key-handle = ?
      624         and v-count-fld <> v-field-num
      625       then do:
      626         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info3, vTable ).
      627       end.
      628     end.
      629   end procedure.
      630   procedure gen-hn-keyr-tab :
      631     define input  parameter i-tableSerach as character no-undo.
      632     define input  parameter i-tablekey   as character no-undo.
      633     define input  parameter p-key-rec    as character no-undo.
      634     define input  parameter p-key-handle as handle    no-undo .
      635     define input  parameter p-db-name    as character no-undo .
      636     define input  parameter p-tt-handle  as handle    no-undo .
      637     define input  parameter p-stts-lock  as integer   no-undo .
      638     define output parameter o-hn         as handle    no-undo.
      639     define variable v-full-tbl-name as character no-undo.
      640     define variable v-where         as character no-undo.
      641     define variable bh_tbl-name     as handle    no-undo.
      642     define variable vTable          as character no-undo.
      643     do
      644     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      645     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      646     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      647         run gen-where-keyr-tab(i-tableSerach,
      648                                i-tablekey,
      649                                p-key-rec,
      650                                p-key-handle,
      651                                p-db-name,
      652                                p-tt-handle,
      653                                output v-where).
      654         if i-tableSerach ne "" and i-tableSerach ne ?
      655         then do:
      656            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      657            create buffer bh_tbl-name for table v-full-tbl-name .
      658         end.
      659         else do:
      660            if p-tt-handle = ? then do:
      661               assign
      662                  vTable = entry( 1 , p-key-rec, chr(3) )
      663               .
      664               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      665               create buffer bh_tbl-name for table v-full-tbl-name .
      666            end.
      667            else do:
      668               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      669            end.
      670         end.
      671         if p-tt-handle = ? then do:
      672            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      673         end.
      674         else do:
      675            bh_tbl-name:find-first( v-where ) no-error .
      676         end.
      677         o-hn = bh_tbl-name.
      678      end.
      679   end procedure.
      680   procedure gen-hn-keyr :
      681     define input  parameter p-key-rec    as character no-undo.
      682     define input  parameter p-key-handle as handle    no-undo .
      683     define input  parameter p-db-name    as character no-undo .
      684     define input  parameter p-tt-handle  as handle    no-undo .
      685     define input  parameter p-stts-lock  as integer   no-undo .
      686     define output parameter o-hn         as handle    no-undo.
      687     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      688   end.
      689   procedure gen-row-keyr :
      690     define input  parameter p-key-rec    as character no-undo.
      691     define input  parameter p-key-handle as handle    no-undo .
      692     define input  parameter p-db-name    as character no-undo .
      693     define input  parameter p-tt-handle  as handle    no-undo .
      694     define input  parameter p-stts-lock  as integer   no-undo .
      695     define output parameter p-tbl-row    as rowid     no-undo.
      696     define output parameter p-tbl-name   as character no-undo.
      697     define variable vHn as handle no-undo.
      698       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      699       p-tbl-row = if vHn:available then vHn:rowid else ?.
      700       p-tbl-name =  vHn:table.
      701       delete object vHn no-error.
      702     if p-tbl-row = ? then do:
      703       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info3, p-tbl-name, p-key-rec ).
      704     end.
      705     else do:
      706       return.
      707     end.
      708   end procedure.
      709   procedure gen-key-fv :
      710     define input  parameter p-key-rec    as character no-undo .
      711     define output parameter p-field-list as character no-undo .
      712     define output parameter p-value-list as character no-undo.
      713     do
      714     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      715     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      716     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      717     :
      718       define variable v-full-tbl-name  as character no-undo .
      719       define variable bh_tbl-name      as handle    no-undo .
      720       define variable v-tbl-name       as character no-undo .
      721       define variable v-field-num      as integer   no-undo .
      722       define variable v-count-fld      as integer   no-undo .
      723       define variable v-inform         as character no-undo .
      724       define variable v-ind            as integer   no-undo .
      725       define variable v-idx-field-qnty as integer   no-undo .
      726       define variable v-delim-key      as character no-undo .
      727       if p-key-rec = ?
      728         or p-key-rec = "":U
      729       then do:
      730         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      731       end.
      732       assign
      733         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      734         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      735       .
      736       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      737       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info3 ).
      738       assign
      739         v-inform = bh_tbl-name:index-information(1)
      740         v-ind    = 2
      741       .
      742       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      743       on error undo, return error
      744       :
      745         assign
      746           v-inform = bh_tbl-name:index-information( v-ind )
      747           v-ind    = v-ind + 1
      748         .
      749       end.
      750       if v-inform = ?
      751         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      752         or entry( 3, v-inform, ",":U ) <> "1":U
      753       then do:
      754         delete object bh_tbl-name no-error.
      755         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
      756       end.
      757       assign
      758         v-idx-field-qnty = num-entries( v-inform ) - 4
      759       .
      760       if v-idx-field-qnty < 2 then do:
      761         delete object bh_tbl-name no-error.
      762         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
      763       end.
      764       assign
      765         p-field-list = "":U
      766         p-value-list = "":U
      767         v-delim-key  = "":U
      768         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      769         v-count-fld  = 0
      770       .
      771       block_where:
      772       do v-ind = 1 to v-idx-field-qnty by 2
      773       on error undo, return error
      774       :
      775         assign
      776           v-count-fld = v-count-fld + 1
      777         .
      778         if v-count-fld > v-field-num then do:
      779           leave block_where.
      780         end.
      781         assign
      782           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      783           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      784         .
      785         if v-ind = 1 then do:
      786           assign
      787             v-delim-key = chr(3)
      788           .
      789         end.
      790       end.
      791       delete object bh_tbl-name.
      792       if v-count-fld <> v-field-num then do:
      793         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info3, v-tbl-name ).
      794       end.
      795     end.
      796   end procedure.
      797   procedure gen-key-field :
      798     define input  parameter p-table      as character no-undo .
      799     define output parameter p-field-list as character no-undo .
      800     do
      801     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      802     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      803     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      804     :
      805       define variable v-full-tbl-name  as character no-undo .
      806       define variable bh_tbl-name      as handle    no-undo .
      807       define variable v-tbl-name       as character no-undo .
      808       define variable v-field-num      as integer   no-undo .
      809       define variable v-count-fld      as integer   no-undo .
      810       define variable v-inform         as character no-undo .
      811       define variable v-ind            as integer   no-undo .
      812       define variable v-idx-field-qnty as integer   no-undo .
      813       define variable v-delim-key      as character no-undo .
      814       if p-table = ?
      815         or p-table = "":U
      816       then do:
      817         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info3 ).
      818       end.
      819       assign
      820         v-tbl-name      = p-table
      821         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      822       .
      823       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      824       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info3 ).
      825       assign
      826         v-inform = bh_tbl-name:index-information(1)
      827         v-ind    = 2
      828       .
      829       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      830       on error undo, return error
      831       :
      832         assign
      833           v-inform = bh_tbl-name:index-information( v-ind )
      834           v-ind    = v-ind + 1
      835         .
      836       end.
      837       if v-inform = ?
      838         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      839         or entry( 3, v-inform, ",":U ) <> "1":U
      840       then do:
      841         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
      842       end.
      843       assign
      844         v-idx-field-qnty = num-entries( v-inform ) - 4
      845       .
      846       if v-idx-field-qnty < 2 then do:
      847         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
      848       end.
      849       assign
      850         p-field-list = "":U
      851         v-delim-key  = "":U
      852         v-count-fld  = 0
      853       .
      854       block_where:
      855       do v-ind = 1 to v-idx-field-qnty by 2
      856       on error undo, return error
      857       :
      858         assign
      859           v-count-fld = v-count-fld + 1
      860         .
      861         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      862         if v-ind = 1 then do:
      863           assign
      864             v-delim-key = chr(3)
      865           .
      866         end.
      867       end.
      868       delete object bh_tbl-name.
      869     end.
      870   end procedure.
      871   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      872   def
      873   new shared
      874   temp-table  obj-list no-undo
      875     field obj-type like ub.clients.obj-type
      876     field obj-code like ub.clients.obj-code
      877     field obj-name like ub.clients.obj-name
      878     field obj-id   as integer
      879     field db-num   as integer
      880     index pi is primary unique obj-id
      881     index ie1 obj-type obj-code
      882     index ie2 obj-name
      883   .
      884   procedure create_obj-list :
      885      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      886      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      887      do
      888      on error undo, return error return-value
      889      :
      890         define buffer cli-obj for ub.clients .
      891         define variable p-var as integer no-undo .
      892         define buffer buf_obj-list for obj-list .
      893         find last buf_obj-list  use-index pi no-error .
      894         if available buf_obj-list
      895         then
      896            p-var = buf_obj-list.obj-id + 1.
      897         else
      898            p-var = 1.
      899         find first cli-obj where
      900                   cli-obj.obj-type = p-obj-type
      901               and cli-obj.obj-code = p-obj-code
      902         no-lock no-error.
      903         if available cli-obj
      904         then do:
      905            create buf_obj-list.
      906            assign
      907               buf_obj-list.obj-id   = p-var
      908               buf_obj-list.obj-code = cli-obj.obj-code
      909               buf_obj-list.obj-type = cli-obj.obj-type
      910               buf_obj-list.obj-name = cli-obj.obj-name
      911               buf_obj-list.db-num   = cli-obj.db-num
      912            .
      913         end.
      914      end.
      915   end.
      916   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      917   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      918   define     temp-table macro-list-hist no-undo
      919   field list-table as character
      920   field id as integer
      921   field line as integer
      922   field hist-mode as character
      923   field des as character
      924   field num-recs as integer
      925   field option_ as character
      926   field item_ as character
      927   field status_ as character
      928   field num-add as integer
      929   field num-ignored as integer
      930   field done as logical
      931   field err_ as logical
      932   field err-mes as character
      933   index pi is primary
      934   id
      935   line
      936   index isdone
      937   done
      938   .
      939   PROCEDURE request-create-macro-list-hist :
      940   DEFINE INPUT PARAMETER p-child-handle AS HANDLE NO-UNDO.
      941   define buffer buf_macro-list-hist for macro-list-hist.
      942   for each buf_macro-list-hist :
      943      RUN proc-create-macro-list-hist IN p-child-handle (
      944                                                          input buf_macro-list-hist.list-table
      945                                                         ,input buf_macro-list-hist.id
      946                                                         ,input buf_macro-list-hist.line
      947                                                         ,input buf_macro-list-hist.hist-mode
      948                                                         ,input buf_macro-list-hist.des
      949                                                         ,input buf_macro-list-hist.option_
      950                                                         ,input buf_macro-list-hist.item_
      951                                                         ,input buf_macro-list-hist.status_
      952                                                          ) no-error .
      953   end.
      954   end procedure.
      955   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
