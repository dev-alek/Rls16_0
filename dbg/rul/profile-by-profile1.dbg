        1   block-level on error undo, throw.
        2   define input parameter        p-mode as character no-undo .
        3   define input parameter        p-silent as logical no-undo .
        4   define input-output parameter p-rec  as recid     no-undo .
        5   define input parameter        p-profile-id as integer no-undo .
        6   define input parameter        p-child-profile-id as integer no-undo .
        7   define variable vss-revision    as character no-undo init "$Revision$":U .
        8   define variable vss-author      as character no-undo init "$Author$":U .
        9   define variable vss-date        as character no-undo init "$Date$":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       11   define variable vss-archive     as character no-undo init "$Archive$":U .
       12   define variable vss-description as character no-undo init "Сохранение привязки profile к profile".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#library  as handle no-undo .
       72   define new global shared variable g#library2 as handle no-undo .
       73   define   shared variable g#auto as logical no-undo.
       74   define   shared variable g#news as logical no-undo.
       75   define   shared variable g#oxml as logical no-undo.
       76   define   shared variable g#esys as logical no-undo.
       77   define   shared variable g#news-source-db as integer no-undo.
       78   define   shared variable g#esys-source-esys as integer no-undo.
       79   define   shared variable g#db-num as integer   no-undo .
       80   define   shared variable g#userid as character no-undo .
       81   define   shared variable g#passwd as character no-undo .
       82   define variable v-mess as character no-undo .
       83   define variable v-entry as character no-undo .
       84   define buffer buf_ruleset for ub.ruleset.
       85   define buffer buf_profile-by-profile for ub.profile-by-profile.
       86   define buffer buf_rule-profile for ub.rule-profile.
       87   if p-mode <> 'ДОБАВЛЕНИЕ':U
       88   and p-mode <> 'ИЗМЕНЕНИЕ':U
       89   then do:
       90     message vss-workfile vss-revision vss-description skip
       91             "Неверный параметр p-mode - " p-mode
       92     view-as alert-box error .
       93     return error '':u.
       94   end.
       95   _main:
       96   do for buf_ruleset
       97   on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
       98   on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
       99   on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
      100   :
      101     find first buf_rule-profile no-lock where
      102               buf_rule-profile.profile_id = p-profile-id no-error.
      103     if not available buf_rule-profile then do:
      104       assign
      105       v-mess = substitute("Не найден профайл &1", p-profile-id).
      106       run err-mess in this-procedure ( input-output v-mess).
      107       return error (if p-silent = yes then v-mess else '':U).
      108     end.
      109     if buf_rule-profile.profile-type <> 'cmb':U then do:
      110       assign
      111       v-mess = substitute("Алгоритм &1 должен быть комбинированным", p-profile-id).
      112       run err-mess in this-procedure ( input-output v-mess).
      113       return error (if p-silent = yes then v-mess else '':U).
      114     end.
      115     find first buf_rule-profile no-lock where
      116               buf_rule-profile.profile_id = p-child-profile-id no-error.
      117     if not available buf_rule-profile then do:
      118       assign
      119       v-mess = substitute("Не найден профайл &1", p-child-profile-id).
      120       run err-mess in this-procedure ( input-output v-mess).
      121       return error (if p-silent = yes then v-mess else '':U).
      122     end.
      123     if buf_rule-profile.profile-type = 'cmb':U then do:
      124       assign
      125       v-mess = substitute("Алгоритм &1 не должен быть комбинированным", p-child-profile-id).
      126       run err-mess in this-procedure ( input-output v-mess).
      127       return error (if p-silent = yes then v-mess else '':U).
      128     end.
      129     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      130       create buf_profile-by-profile.
      131       assign
      132       buf_profile-by-profile.child-profile_id = p-child-profile-id
      133       buf_profile-by-profile.profile_id = p-profile-id
      134       p-rec = recid(buf_profile-by-profile)
      135       .
      136     end.
      137     else do:
      138       find first buf_profile-by-profile exclusive-lock where
      139                 recid(buf_profile-by-profile) = p-rec .
      140     end.
      141   end.
      142   PROCEDURE err-mess:
      143     DEFINE INPUT-OUTPUT PARAMETER p-mess as character No-UNDO.
      144     CASE p-silent:
      145       when yes then do:
      146         assign
      147         p-mess = substitute("Привязка профайла к профайлу:&1профайл &2 подчиненный профайл &3"
      148                            , chr(10)
      149                            , p-profile-id
      150                            , p-child-profile-id
      151                            , p-mess)
      152         .
      153       end.
      154       when no then do:
      155         message
      156         p-mess
      157         view-as alert-box error .
      158       end.
      159     end.
      160   END PROCEDURE.
