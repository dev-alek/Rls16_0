      391     ( INPUT p-codex-id AS INTEGER
      392       ,INPUT p-ruleset-id AS INTEGER
      393       ,INPUT p-rule-id AS INTEGER )  FORWARD.
      394   DEFINE BUTTON b-add
      395        LABEL "&Добавить"
      396        SIZE 10 BY 1.
      397   DEFINE BUTTON b-chg
      398        LABEL "&Изменить"
      399        SIZE 10 BY 1.
      400   DEFINE BUTTON b-del
      401        LABEL "&Удалить"
      402        SIZE 10 BY 1.
      403   DEFINE BUTTON B-Help
      404        LABEL "Помо&щь"
      405        SIZE 3 BY 1
      406        BGCOLOR 8 .
      407   DEFINE BUTTON b-lkp
      408        LABEL "&Просмотр"
      409        SIZE 10 BY 1.
      410   DEFINE BUTTON b-mark
      411        LABEL "&*"
      412        SIZE 4 BY 1.
      413   DEFINE BUTTON b-quit AUTO-END-KEY
      414        LABEL "&Выход"
      415        SIZE 10 BY 1
      416        BGCOLOR 8 .
      417   DEFINE BUTTON b-sel AUTO-GO
      418        LABEL "Выбор"
      419        SIZE 10 BY 1.
      420   DEFINE VARIABLE EDITOR-1 AS CHARACTER
      421        VIEW-AS EDITOR NO-WORD-WRAP SCROLLBAR-HORIZONTAL SCROLLBAR-VERTICAL
      422        SIZE 98 BY 3.37 NO-UNDO.
      423   DEFINE VARIABLE mark-num AS INTEGER FORMAT "->,>>>,>>9":U INITIAL 0
      424         VIEW-AS TEXT
      425        SIZE 9 BY .67
      426        FGCOLOR 10  NO-UNDO.
      427   DEFINE QUERY br-rule-by-set FOR
      428         X_rule-by-set,
      429         X_ruleset,
      430         X_rule SCROLLING.
      431   DEFINE BROWSE br-rule-by-set
      432     QUERY br-rule-by-set NO-LOCK DISPLAY
      433         mark-string(recid(X_rule-by-set), v-rid-list) Format "X(1)" COLUMN-LABEL "*"
      434   is-used(X_rule-by-set.codex_id, X_rule-by-set.ruleset_id, X_rule-by-set.RULE_id) FORMAT "X(1)"
      435             COLUMN-LABEL "Уже!использ"
      436   has-params(X_rule.uniq-key-rec) FORMAT "X(1)" COLUMN-LABEL "Пар-ры"
      437   X_rule-by-set.codex_id COLUMN-LABEL "Кодекс!правил" FORMAT ">>>>>>>>9"
      438   X_rule-by-set.ruleset_id COLUMN-LABEL "Набор!правил" FORMAT ">>>>>>>>9"
      439   X_ruleset.name COLUMN-LABEL "Кодекс/набор правил" FORMAT "X(255)" WIDTH 45
      440   X_rule-by-set.rule_id COLUMN-LABEL "№ правила" FORMAT ">>>>>>>>9"
      441   X_rule.name COLUMN-LABEL "Правило" FORMAT "X(255)"  WIDTH 45
      442       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 17 FIT-LAST-COLUMN.
      443   DEFINE FRAME Dialog-Frame
      444        b-quit AT ROW 1 COL 1
      445        b-mark AT ROW 1 COL 24 WIDGET-ID 12
      446        b-sel AT ROW 1 COL 28 WIDGET-ID 10
      447        b-add AT ROW 1 COL 38 WIDGET-ID 2
      448        b-chg AT ROW 1 COL 48 WIDGET-ID 4
      449        b-del AT ROW 1 COL 58 WIDGET-ID 8
      450        b-lkp AT ROW 1 COL 68 WIDGET-ID 18
      451        B-Help AT ROW 1 COL 89.3
      452        br-rule-by-set AT ROW 2.33 COL 1 WIDGET-ID 100
      453        EDITOR-1 AT ROW 19.5 COL 1 NO-LABEL WIDGET-ID 16
      454        mark-num AT ROW 1 COL 13 COLON-ALIGNED NO-LABEL WIDGET-ID 14
      455        SPACE(75.24) SKIP(21.21)
      456       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      457            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      458            TITLE "Привязка правил к наборам"
      459            CANCEL-BUTTON b-quit.
      460   ASSIGN
      461          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      462          FRAME Dialog-Frame:HIDDEN           = TRUE.
      463   ASSIGN
      464          b-lkp:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      465   ASSIGN
      466          br-rule-by-set:HIDDEN  IN FRAME Dialog-Frame                = TRUE.
      467   ON GO OF FRAME Dialog-Frame
      468   DO:
      469     p-rid-list = v-rid-list.
      470   END.
      471   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      472   DO:
      473     APPLY "END-ERROR":U TO SELF.
      474   END.
      475   ON CHOOSE OF b-add IN FRAME Dialog-Frame
      476   DO:
      477     run proc-b-add-chg in this-procedure ( input yes) no-error.
      478     if error-status:error then return no-apply.
      479   END.
      480   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
      481   DO:
      482     define variable v-rec as recid no-undo.
      483     if not available X_rule-by-set then return no-apply.
      484     run proc-b-add-chg in this-procedure ( input no) no-error.
      485     if error-status:error then return no-apply.
      486   END.
      487   ON CHOOSE OF b-del IN FRAME Dialog-Frame
      488   DO:
      489     define variable v-rec as recid no-undo.
      490     define variable glog as logical no-undo.
      491     if not available X_rule-by-set then return no-apply.
      492     v-rec = recid(X_rule-by-set).
      493     message "Вы уверены, что хотите удалить привязку ПРАВИЛА К наборам правил?"
      494     view-as alert-box question buttons yes-no update glog.
      495     if not glog then return no-apply.
      496     run rul/rule-by-set3.p (
      497                               input no
      498                              ,input v-rec
      499                                 ) no-error.
      500     if error-status:error then return no-apply.
      501     RUn Openbr in this-procedure .
      502   END.
      503   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
      504   DO:
      505     run proc-b-add-chg in this-procedure ( input yes) no-error.
      506     if error-status:error then return no-apply.
      507   END.
      508   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
      509   DO:
      510       define variable glog as logical no-undo .
      511     if available X_rule-by-set then do:
      512   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      513   define variable v-str-recid4 as character no-undo .
      514   define variable v-num-entry4 as integer   no-undo .
      515   assign
      516     v-str-recid4 = trim( string( recid( X_rule-by-set ) , "->>>>>>>>>>>9":U ) )
      517     v-num-entry4 = lookup( v-str-recid4 , v-rid-list )
      518   .
      519   if v-num-entry4 > 0 then do:
      520     assign
      521       entry( v-num-entry4, v-rid-list ) = "":U
      522       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
      523     .
      524   end.
      525   else do:
      526     assign
      527       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid4
      528     .
      529   end.
      530     glog = br-rule-by-set:refresh() .
      531     if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
      532         glog = br-rule-by-set:select-next-row ().
      533         apply "VALUE-CHANGED" to br-rule-by-set in frame Dialog-Frame.
      534     end.
      535     if num-entries( v-rid-list ) = 0
      536     then
      537         hide mark-num in frame Dialog-Frame.
      538     else
      539         disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
      540   end.
      541   apply "entry" to br-rule-by-set in frame Dialog-Frame.
      542   END.
      543   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
      544   DO:
      545     if available X_rule-by-set then do:
      546       if  ( v-rid-list = "" ) or b-mark:sensitive = no
      547       then  v-rid-list = string( recid( X_rule-by-set ) ) .
      548     end.
      549   END.
      550   ON MOUSE-SELECT-DBLCLICK, return OF br-rule-by-set IN FRAME Dialog-Frame
      551   DO:
      552       RUN br-rule-by-set-mouse-select NO-ERROR.
      553       IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      554   END.
      555   ON VALUE-CHANGED OF br-rule-by-set IN FRAME Dialog-Frame
      556   DO:
      557       IF AVAILABLE X_rule THEN DO:
      558       editor-1:SCREEN-VALUE = X_rule.documentation.
      559     END.
      560     ELSE DO:
      561       editor-1:SCREEN-VALUE = '':U.
      562     END.
      563   END.
      564   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      565   on f5 of frame Dialog-Frame anywhere
      566   do:
      567      v-doc-rec = recid(X_rule-by-set).    RUn OpenBR in this-procedure.  REPOSITION br-rule-by-set to recid v-doc-rec No-ERROR.   apply 'value-changed' to br-rule-by-set.
      568       apply "VALUE-CHANGED" to br-rule-by-set.
      569   end.
      570   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      571   on help of frame Dialog-Frame
      572   do:
      573     run gbl/app_help.p
      574       (input this-procedure :file-name
      575       ,input ''
      576       ,input ?
      577       ) no-error.
      578     if error-status :error then do:
      579       message
      580         "Ошибка при вызове помощи"
      581         error-status :get-message(1)
      582         view-as alert-box .
      583     end.
      584   end.
      585   run minbtn-set in this-procedure .
      586   on choose of b-help in frame Dialog-Frame
      587   do:
      588     apply "help":u to frame Dialog-Frame .
      589   end.
      590   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      591   procedure minbtn-set :
      592       do
      593           on error undo, return error return-value
      594           :
      595           define variable ii              as integer       no-undo .
      596           define variable fh              as widget-handle no-undo .
      597           define variable hh              as widget-handle no-undo .
      598           define variable v-h             as handle        extent 4 no-undo .
      599           define variable v-name-button   as character     no-undo .
      600           define variable v-help-old-x    as decimal       no-undo .
      601           define variable v-help-old-y    as decimal       no-undo .
      602           define variable v-help-old-size as decimal       no-undo .
      603           define variable v-frame-width   as decimal       no-undo .
      604           define variable jj              as integer       no-undo .
      605           do
      606               on error undo, return error
      607               :
      608               assign
      609                   v-frame-width = frame Dialog-Frame:width - 0.3
      610                   fh            = frame Dialog-Frame:first-child
      611                   hh            = fh:first-child
      612                   ii            = 1
      613                   .
      614               do while valid-handle(hh):
      615                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      616                   do:
      617                       case lc(hh:name) :
      618                           when "b-help" then
      619                               do:
      620                                   hh:load-image-up("cmp/b-help.bmp":u) .
      621                                   hh:load-image-down("cmp/b-help.bmp":u) .
      622                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      623                                   hh:TOOLTIP = "Помощь" .
      624                                   v-help-old-x = hh:column .
      625                                   v-help-old-y = hh:row    .
      626                                   v-help-old-size = hh:width .
      627                                   hh:width-chars = 2.5 .
      628                               end.
      629                           when "b-print" then
      630                               do:
      631                                   hh:load-image("cmp/b-print.bmp":u) .
      632                                   hh:TOOLTIP = "Печать" .
      633                                   v-h[ii] = hh:handle .
      634                                   ii = ii + 1 .
      635                                   hh:width-chars = 3 .
      636                               end.
      637                           when "b-history" or
      638                           when "b-hist" then
      639                               do:
      640                                   hh:load-image("cmp/b-hist.bmp":u) .
      641                                   hh:TOOLTIP = "История" .
      642                                   v-h[ii] = hh:handle .
      643                                   ii = ii + 1 .
      644                                   hh:width-chars = 3 .
      645                               end.
      646                           when "b-sch" then
      647                               do:
      648                                   hh:load-image("cmp/b-sch.bmp":u) .
      649                                   hh:TOOLTIP = "Установка Фильтра" .
      650                                   v-h[ii] = hh:handle .
      651                                   ii = ii + 1 .
      652                                   hh:width-chars = 3 .
      653                               end.
      654                           when "b-hist-user" then
      655                               do:
      656                                   hh:load-image("cmp/b-hist.bmp":u) .
      657                                   hh:TOOLTIP = "История пользователя" .
      658                                   ii = ii + 1 .
      659                               end.
      660                       end case.
      661                   end.
      662                   hh = hh:next-sibling.
      663               end.
      664               b-help:column = v-frame-width - b-help:width-chars.
      665               jj = 0.
      666               repeat ii = 4 to 1 by -1 :
      667                   if valid-handle (v-h[ii] ) then
      668                   do:
      669                       jj  = jj + 1 .
      670                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      671                       v-h[ii]:row    = v-help-old-y .
      672                   end.
      673               end.
      674           end.
      675       end.
      676   end procedure.
      677   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      678   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      679   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      680   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      681   define variable v-diasize-current-frame-width  as decimal   no-undo .
      682   define variable v-diasize-current-frame-height as decimal   no-undo .
      683   define variable v-diasize-change-size          as logical   no-undo .
      684   define variable v-diasize-resize-button        as handle    no-undo .
      685   define variable v-diasize-wndmax               as logical   no-undo .
      686   define variable v-diasize-wndstore             as logical   no-undo .
      687   define variable v-diasize-proc-name            as character no-undo .
      688   define variable v-diasize-browse-handle        as handle    no-undo .
      689   define variable v-diasize-browse-number        as integer   no-undo .
      690   define variable v-diasize-need-full-display    as logical   no-undo init false .
      691   define temp-table temp-diasize-handle no-undo
      692     field handle-value  as handle
      693     field save-position as decimal
      694     index xpk is primary unique handle-value
      695     .
      696   define temp-table temp-browse-handle no-undo
      697     field browse-type   as character
      698     field browse-number as integer
      699     field browse-handle as handle
      700     field original-size as decimal
      701     index xpk is primary unique browse-type browse-number
      702     index xie browse-type browse-handle
      703   .
      704   procedure diasize_change-height :
      705     define input  parameter p-change-value  as decimal   no-undo .
      706     define input  parameter p-move-resize   as logical   no-undo .
      707     define variable v-field-group-handle    as handle    no-undo .
      708     define variable v-object-handle         as handle    no-undo .
      709     define variable v-frame-height          as decimal   no-undo .
      710     define variable v-frame-virtual-height  as decimal   no-undo .
      711     define variable v-browse-height         as decimal   no-undo .
      712     define variable v-window-height         as decimal   no-undo .
      713     define variable v-window-virtual-height as decimal   no-undo .
      714     define variable v-change-sign           as integer   no-undo .
      715     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      716     define buffer buf_temp-browse-handle  for temp-browse-handle .
      717     if p-change-value > 0
      718     then do:
      719       if frame Dialog-Frame :height + p-change-value
      720           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      721       then do:
      722         assign
      723           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      724                           - (frame Dialog-Frame :height-chars)
      725         .
      726         if p-change-value <= 0
      727         then do:
      728           run diasize_position-resize-button in this-procedure .
      729           return .
      730         end.
      731       end.
      732     end.
      733     if p-change-value < 0
      734     then do:
      735       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      736       then do:
      737         assign
      738           p-change-value = v-diasize-orig-frame-height
      739                          - (frame Dialog-Frame :height-chars)
      740         .
      741         if p-change-value >= 0
      742         then do:
      743           run diasize_position-resize-button in this-procedure .
      744           return .
      745         end.
      746       end.
      747     end.
      748     if p-change-value >= 0
      749     then do:
      750       assign
      751         v-change-sign = 1
      752       .
      753     end.
      754     else do:
      755       assign
      756         v-change-sign = -1
      757       .
      758     end.
      759     assign
      760       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      761     .
      762     if p-change-value = 0
      763     then do:
      764       run diasize_position-resize-button in this-procedure .
      765       return .
      766     end.
      767     move_block:
      768     do
      769     on error undo move_block, retry move_block
      770     :
      771       if retry
      772       then do:
      773         do
      774         on error undo move_block, leave move_block
      775         :
      776           if p-change-value > 0
      777           then do:
      778             for each buf_temp-diasize-handle
      779             on error undo, next
      780             :
      781               assign
      782                 v-object-handle = buf_temp-diasize-handle.handle-value
      783               .
      784               if v-object-handle <> v-diasize-resize-button
      785               then do:
      786                 assign
      787                   v-object-handle :row = buf_temp-diasize-handle.save-position
      788                 .
      789               end.
      790             end.
      791             assign
      792               v-diasize-browse-handle :height = v-browse-height
      793             .
      794             for each buf_temp-browse-handle
      795               where buf_temp-browse-handle.browse-type = 'height':u
      796             on error undo, next
      797             :
      798               assign
      799                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      800               .
      801             end.
      802             assign
      803               frame Dialog-Frame :height = v-frame-height
      804             .
      805             if frame Dialog-Frame :scrollable = true
      806             then do:
      807               assign
      808                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      809               .
      810             end.
      811             run diasize_position-resize-button in this-procedure .
      812           end.
      813           else do:
      814             if frame Dialog-Frame :scrollable = true
      815             then do:
      816               assign
      817                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      818               .
      819             end.
      820             assign
      821               frame Dialog-Frame :height = v-frame-height
      822             .
      823             assign
      824               v-diasize-browse-handle :height = v-browse-height
      825             .
      826             for each buf_temp-browse-handle
      827               where buf_temp-browse-handle.browse-type = 'height':u
      828             on error undo, next
      829             :
      830               assign
      831                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      832               .
      833             end.
      834             for each buf_temp-diasize-handle
      835             on error undo, next
      836             :
      837               assign
      838                 v-object-handle = buf_temp-diasize-handle.handle-value
      839               .
      840               if v-object-handle <> v-diasize-resize-button
      841               then do:
      842                 assign
      843                   v-object-handle :row = buf_temp-diasize-handle.save-position
      844                 .
      845               end.
      846             end.
      847             run diasize_position-resize-button in this-procedure .
      848           end.
      849           assign
      850             v-diasize-change-size = false
      851           .
      852           leave move_block .
      853         end.
      854       end.
      855       assign
      856         v-diasize-need-full-display = true
      857       .
      858       if v-diasize-change-size = false
      859       then do:
      860         assign
      861           v-diasize-change-size = true
      862         .
      863       end.
      864       else do:
      865         return .
      866       end.
      867       assign
      868         v-frame-height = frame Dialog-Frame :height
      869         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      870         v-browse-height = v-diasize-browse-handle :height
      871       .
      872       for each buf_temp-browse-handle
      873         where buf_temp-browse-handle.browse-type = 'height':u
      874       :
      875         assign
      876           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      877         .
      878       end.
      879       for each buf_temp-diasize-handle
      880       :
      881         delete buf_temp-diasize-handle .
      882       end.
      883       assign
      884         v-field-group-handle = frame Dialog-Frame :first-child
      885       .
      886       do while valid-handle(v-field-group-handle)
      887       :
      888         assign
      889           v-object-handle = v-field-group-handle :first-child
      890         .
      891         do while valid-handle(v-object-handle)
      892         :
      893           if  v-object-handle <> v-diasize-browse-handle :handle
      894           and can-query(v-object-handle, "row")
      895           and can-query(v-object-handle, "height")
      896           and ( v-object-handle :row > v-diasize-browse-handle :row )
      897           then do:
      898             find first buf_temp-browse-handle
      899               where buf_temp-browse-handle.browse-type   = 'height':u
      900                 and buf_temp-browse-handle.browse-handle = v-object-handle
      901               no-error .
      902             if available buf_temp-browse-handle
      903             then do:
      904             end.
      905             else do:
      906               create buf_temp-diasize-handle .
      907               assign
      908                 buf_temp-diasize-handle.handle-value  = v-object-handle
      909                 buf_temp-diasize-handle.save-position = v-object-handle :row
      910               .
      911             end.
      912           end.
      913           assign
      914             v-object-handle = v-object-handle :next-sibling
      915           .
      916         end.
      917         assign
      918           v-field-group-handle = v-field-group-handle :next-sibling
      919         .
      920       end.
      921       do with frame Dialog-Frame
      922       :
      923         hide v-diasize-resize-button .
      924         assign
      925           v-diasize-resize-button :row    = 1
      926           v-diasize-resize-button :column = 1
      927         .
      928       end.
      929       if p-change-value > 0
      930       then do:
      931         if frame Dialog-Frame :scrollable = true
      932         then do:
      933           assign
      934             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      935             no-error .
      936           if error-status :error
      937           or error-status :get-message(1) <> ""
      938           then do:
      939             undo move_block, retry move_block .
      940           end.
      941         end.
      942         assign
      943           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      944           no-error .
      945         if error-status :error
      946         or error-status :get-message(1) <> ""
      947         then do:
      948           undo move_block, retry move_block .
      949         end.
      950         assign
      951           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      952           no-error .
      953         if error-status :error
      954         or error-status :get-message(1) <> ""
      955         then do:
      956           undo move_block, retry move_block .
      957         end.
      958         for each buf_temp-browse-handle
      959           where buf_temp-browse-handle.browse-type = 'height':u
      960         on error undo move_block, retry move_block
      961         :
      962           assign
      963             buf_temp-browse-handle.browse-handle :height
      964               = buf_temp-browse-handle.browse-handle :height + p-change-value
      965             no-error .
      966           if error-status :error
      967           or error-status :get-message(1) <> ""
      968           then do:
      969             undo move_block, retry move_block .
      970           end.
      971         end.
      972         for each buf_temp-diasize-handle
      973         on error undo move_block, retry move_block
      974         :
      975           assign
      976             v-object-handle = buf_temp-diasize-handle.handle-value
      977           .
      978           if v-object-handle <> v-diasize-resize-button
      979           then do:
      980             assign
      981               v-object-handle :row = v-object-handle :row + p-change-value
      982               no-error .
      983             if error-status :error
      984             or error-status :get-message(1) <> ""
      985             then do:
      986               undo move_block, retry move_block .
      987             end.
      988           end.
      989         end.
      990       end.
      991       else do:
      992         for each buf_temp-diasize-handle
      993         on error undo move_block, retry move_block
      994         :
      995           assign
      996             v-object-handle = buf_temp-diasize-handle.handle-value
      997           .
      998           if v-object-handle <> v-diasize-resize-button
      999           then do:
     1000             assign
     1001               v-object-handle :row = v-object-handle :row + p-change-value
     1002               no-error .
     1003             if error-status :error
     1004             or error-status :get-message(1) <> ""
     1005             then do:
     1006               undo move_block, retry move_block .
     1007             end.
     1008           end.
     1009         end.
     1010         assign
     1011           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1012           no-error .
     1013         if error-status :error
     1014         or error-status :get-message(1) <> ""
     1015         then do:
     1016           undo move_block, retry move_block .
     1017         end.
     1018         for each buf_temp-browse-handle
     1019           where buf_temp-browse-handle.browse-type = 'height':u
     1020         on error undo move_block, retry move_block
     1021         :
     1022           assign
     1023             buf_temp-browse-handle.browse-handle :height
     1024               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1025             no-error .
     1026           if error-status :error
     1027           or error-status :get-message(1) <> ""
     1028           then do:
     1029             undo move_block, retry move_block .
     1030           end.
     1031         end.
     1032         assign
     1033           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1034           no-error .
     1035         if error-status :error
     1036         or error-status :get-message(1) <> ""
     1037         then do:
     1038           undo move_block, retry move_block .
     1039         end.
     1040         if frame Dialog-Frame :scrollable = true
     1041         then do:
     1042           assign
     1043             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1044             no-error .
     1045           if error-status :error
     1046           or error-status :get-message(1) <> ""
     1047           then do:
     1048             undo move_block, retry move_block .
     1049           end.
     1050         end.
     1051       end.
     1052       if p-move-resize = true
     1053       then do:
     1054         run diasize_position-resize-button in this-procedure .
     1055       end.
     1056       if v-diasize-wndstore = true
     1057       then do:
     1058         if connected("ub") = true
     1059         then do:
     1060           define variable v-cntxt-db-num        as integer   no-undo .
     1061           define variable v-cntxt-userid        as character no-undo .
     1062           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1063                                             , OUTPUT v-cntxt-userid
     1064                                             ) .
     1065           run gbl/wndsizew.p
     1066             (input  v-cntxt-db-num
     1067             ,input  v-cntxt-userid
     1068             ,input  v-diasize-proc-name
     1069             ,input  'height':u
     1070             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1071             ) .
     1072         end.
     1073       end.
     1074     end.
     1075     assign
     1076       v-diasize-change-size = false
     1077     .
     1078   end procedure.
     1079   procedure diasize_set-height :
     1080     define input  parameter p-new-height  as decimal   no-undo .
     1081     define input  parameter p-move-resize as logical   no-undo .
     1082     do
     1083     on error undo, return error return-value
     1084     :
     1085       run diasize_change-height in this-procedure
     1086         (input  (p-new-height - frame Dialog-Frame :height)
     1087         ,input  p-move-resize
     1088         ) .
     1089     end.
     1090   end procedure.
     1091   procedure diasize_change-width :
     1092     define input  parameter p-change-value as decimal   no-undo .
     1093     define input  parameter p-move-resize  as logical   no-undo .
     1094     define variable v-field-group-handle   as handle    no-undo .
     1095     define variable v-object-handle        as handle    no-undo .
     1096     define variable v-frame-width          as decimal   no-undo .
     1097     define variable v-frame-virtual-width  as decimal   no-undo .
     1098     define variable v-browse-width         as decimal   no-undo .
     1099     define variable v-window-width         as decimal   no-undo .
     1100     define variable v-window-virtual-width as decimal   no-undo .
     1101     define variable v-change-sign          as integer   no-undo .
     1102     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1103     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1104     if p-change-value > 0
     1105     then do:
     1106       if frame Dialog-Frame :width + p-change-value >
     1107           session :width-chars
     1108       then do:
     1109         assign
     1110           p-change-value = session :width-chars - frame Dialog-Frame :width
     1111         .
     1112         if p-change-value <= 0
     1113         then do:
     1114           run diasize_position-resize-button in this-procedure .
     1115           return .
     1116         end.
     1117       end.
     1118     end.
     1119     if p-change-value < 0
     1120     then do:
     1121       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1122       then do:
     1123         assign
     1124           p-change-value = v-diasize-orig-frame-width
     1125                          - frame Dialog-Frame :width
     1126         .
     1127         if p-change-value >= 0
     1128         then do:
     1129           run diasize_position-resize-button in this-procedure .
     1130           return .
     1131         end.
     1132       end.
     1133     end.
     1134     if p-change-value >= 0
     1135     then do:
     1136       assign
     1137         v-change-sign = 1
     1138       .
     1139     end.
     1140     else do:
     1141       assign
     1142         v-change-sign = -1
     1143       .
     1144     end.
     1145     assign
     1146       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1147     .
     1148     if p-change-value = 0
     1149     then do:
     1150       run diasize_position-resize-button in this-procedure .
     1151       return .
     1152     end.
     1153     move_block:
     1154     do
     1155     on error undo move_block, leave move_block
     1156     :
     1157       if retry
     1158       then do:
     1159         do
     1160         on error undo move_block, leave move_block
     1161         :
     1162           if p-change-value > 0
     1163           then do:
     1164             for each buf_temp-diasize-handle
     1165             on error undo, next
     1166             :
     1167               assign
     1168                 v-object-handle = buf_temp-diasize-handle.handle-value
     1169               .
     1170               if v-object-handle <> v-diasize-resize-button
     1171               then do:
     1172                 assign
     1173                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1174                 .
     1175               end.
     1176             end.
     1177             assign
     1178               v-diasize-browse-handle :width = v-browse-width
     1179             .
     1180             for each buf_temp-browse-handle
     1181               where buf_temp-browse-handle.browse-type = 'width':u
     1182             on error undo, next
     1183             :
     1184               assign
     1185                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1186               .
     1187             end.
     1188             assign
     1189               frame Dialog-Frame :width = v-frame-width
     1190             .
     1191             if frame Dialog-Frame :scrollable = true
     1192             then do:
     1193               assign
     1194                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1195               .
     1196             end.
     1197             run diasize_position-resize-button in this-procedure .
     1198           end.
     1199           else do:
     1200             if frame Dialog-Frame :scrollable = true
     1201             then do:
     1202               assign
     1203                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1204               .
     1205             end.
     1206             assign
     1207               frame Dialog-Frame :width = v-frame-width
     1208             .
     1209             for each buf_temp-browse-handle
     1210               where buf_temp-browse-handle.browse-type = 'width':u
     1211             on error undo, next
     1212             :
     1213               assign
     1214                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1215               .
     1216             end.
     1217             assign
     1218               v-diasize-browse-handle :width = v-browse-width
     1219             .
     1220             for each buf_temp-diasize-handle
     1221             on error undo, next
     1222             :
     1223               assign
     1224                 v-object-handle = buf_temp-diasize-handle.handle-value
     1225               .
     1226               if v-object-handle <> v-diasize-resize-button
     1227               then do:
     1228                 assign
     1229                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1230                 .
     1231               end.
     1232             end.
     1233             run diasize_position-resize-button in this-procedure .
     1234           end.
     1235           assign
     1236             v-diasize-change-size = false
     1237           .
     1238           leave move_block .
     1239         end.
     1240       end.
     1241       assign
     1242         v-diasize-need-full-display = true
     1243       .
     1244       if v-diasize-change-size = false
     1245       then do:
     1246         assign
     1247           v-diasize-change-size = true
     1248         .
     1249       end.
     1250       else do:
     1251         return .
     1252       end.
     1253       assign
     1254         v-frame-width = frame Dialog-Frame :width
     1255         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1256         v-browse-width = v-diasize-browse-handle :width
     1257       .
     1258       for each buf_temp-browse-handle
     1259         where buf_temp-browse-handle.browse-type = 'width':u
     1260       :
     1261         assign
     1262           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1263         .
     1264       end.
     1265       for each buf_temp-diasize-handle
     1266       :
     1267         delete buf_temp-diasize-handle .
     1268       end.
     1269       assign
     1270         v-field-group-handle = frame Dialog-Frame :first-child
     1271       .
     1272       do while valid-handle(v-field-group-handle)
     1273       :
     1274         assign
     1275           v-object-handle = v-field-group-handle :first-child
     1276         .
     1277         do while valid-handle(v-object-handle)
     1278         :
     1279           if  v-object-handle <> v-diasize-browse-handle :handle
     1280           and v-object-handle <> v-diasize-resize-button
     1281           and can-query(v-object-handle, "row")
     1282           and can-query(v-object-handle, "height")
     1283           and ( v-object-handle :col + v-object-handle :width
     1284                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1285               )
     1286           then do:
     1287             find first buf_temp-browse-handle
     1288               where buf_temp-browse-handle.browse-type   = 'width':u
     1289                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1290               no-error .
     1291             if available buf_temp-browse-handle
     1292             then do:
     1293             end.
     1294             else do:
     1295               create buf_temp-diasize-handle .
     1296               assign
     1297                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1298                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1299               .
     1300             end.
     1301           end.
     1302           assign
     1303             v-object-handle = v-object-handle :next-sibling
     1304           .
     1305         end.
     1306         assign
     1307           v-field-group-handle = v-field-group-handle :next-sibling
     1308         .
     1309       end.
     1310       do with frame Dialog-Frame
     1311       :
     1312         hide v-diasize-resize-button .
     1313         v-diasize-resize-button :row = 1.
     1314         v-diasize-resize-button :column = 1.
     1315       end.
     1316       if p-change-value > 0
     1317       then do:
     1318         if frame Dialog-Frame :scrollable = true
     1319         then do:
     1320           assign
     1321             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1322             no-error .
     1323           if error-status :error
     1324           or error-status :get-message(1) <> ""
     1325           then do:
     1326             undo move_block, retry move_block.
     1327           end.
     1328         end.
     1329         assign
     1330           frame Dialog-Frame :width = v-frame-width + p-change-value
     1331           no-error .
     1332         if error-status :error
     1333         or error-status :get-message(1) <> ""
     1334         then do:
     1335           undo move_block, retry move_block.
     1336         end.
     1337         assign
     1338           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1339         no-error .
     1340         if error-status :error
     1341         or error-status :get-message(1) <> ""
     1342         then do:
     1343           undo move_block, retry move_block.
     1344         end.
     1345         for each buf_temp-browse-handle
     1346           where buf_temp-browse-handle.browse-type = 'width':u
     1347         on error undo move_block, retry move_block
     1348         :
     1349           assign
     1350             buf_temp-browse-handle.browse-handle :width
     1351               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1352             no-error .
     1353           if error-status :error
     1354           or error-status :get-message(1) <> ""
     1355           then do:
     1356             undo move_block, retry move_block .
     1357           end.
     1358         end.
     1359         for each buf_temp-diasize-handle
     1360         on error undo move_block, retry move_block
     1361         :
     1362           assign
     1363             v-object-handle = buf_temp-diasize-handle.handle-value
     1364           .
     1365           if v-object-handle <> v-diasize-resize-button
     1366           then do:
     1367             assign
     1368               v-object-handle :col = v-object-handle :col + p-change-value
     1369               no-error .
     1370             if error-status :error
     1371             or error-status :get-message(1) <> ""
     1372             then do:
     1373               undo move_block, retry move_block .
     1374             end.
     1375           end.
     1376         end.
     1377       end.
     1378       else do:
     1379         for each buf_temp-diasize-handle
     1380         on error undo move_block, retry move_block
     1381         :
     1382           assign
     1383             v-object-handle = buf_temp-diasize-handle.handle-value
     1384           .
     1385           if v-object-handle <> v-diasize-resize-button
     1386           then do:
     1387             assign
     1388               v-object-handle :col = v-object-handle :col + p-change-value
     1389               no-error .
     1390             if error-status :error
     1391             or error-status :get-message(1) <> ""
     1392             then do:
     1393               undo move_block, retry move_block .
     1394             end.
     1395           end.
     1396         end.
     1397         for each buf_temp-browse-handle
     1398           where buf_temp-browse-handle.browse-type = 'width':u
     1399         on error undo move_block, retry move_block
     1400         :
     1401           assign
     1402             buf_temp-browse-handle.browse-handle :width
     1403               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1404             no-error .
     1405           if error-status :error
     1406           or error-status :get-message(1) <> ""
     1407           then do:
     1408             undo move_block, retry move_block .
     1409           end.
     1410         end.
     1411         assign
     1412           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1413           no-error .
     1414         if error-status :error
     1415         or error-status :get-message(1) <> ""
     1416         then do:
     1417           undo move_block, retry move_block.
     1418         end.
     1419         assign
     1420           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1421         no-error .
     1422         if error-status :error
     1423         or error-status :get-message(1) <> ""
     1424         then do:
     1425           undo move_block, retry move_block.
     1426         end.
     1427         if frame Dialog-Frame :scrollable = true
     1428         then do:
     1429           assign
     1430             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1431           no-error .
     1432           if error-status :error
     1433           or error-status :get-message(1) <> ""
     1434           then do:
     1435             undo move_block, retry move_block.
     1436           end.
     1437         end.
     1438       end.
     1439       if p-move-resize
     1440       then do:
     1441         run diasize_position-resize-button in this-procedure .
     1442       end.
     1443       if v-diasize-wndstore = true
     1444       then do:
     1445         if connected("ub") = true
     1446         then do:
     1447           define variable v-cntxt-db-num        as integer   no-undo .
     1448           define variable v-cntxt-userid        as character no-undo .
     1449           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1450                                             , OUTPUT v-cntxt-userid
     1451                                             ) .
     1452           run gbl/wndsizew.p
     1453             (input  v-cntxt-db-num
     1454             ,input  v-cntxt-userid
     1455             ,input  v-diasize-proc-name
     1456             ,input  'width':u
     1457             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1458             ) .
     1459         end.
     1460       end.
     1461     end.
     1462     assign
     1463       v-diasize-change-size = false
     1464     .
     1465   end procedure.
     1466   procedure diasize_set-width :
     1467     define input  parameter p-new-width  as decimal   no-undo .
     1468     define input  parameter p-move-resize as logical   no-undo .
     1469     do
     1470     on error undo, return error return-value
     1471     :
     1472       run diasize_change-width in this-procedure
     1473         (input  (p-new-width - frame Dialog-Frame :width)
     1474         ,input  p-move-resize
     1475         ) .
     1476     end.
     1477   end procedure.
     1478   procedure diasize_position-resize-button :
     1479     do with frame Dialog-Frame
     1480     :
     1481       hide v-diasize-resize-button .
     1482       assign
     1483         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1484                     - 1
     1485                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1486         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1487                     - 1
     1488                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1489       .
     1490       view v-diasize-resize-button .
     1491     end.
     1492   end procedure.
     1493   on alt-right anywhere
     1494   do:
     1495     run diasize_change-width in this-procedure
     1496       (input 1
     1497       ,input true
     1498       ) .
     1499     return no-apply .
     1500   end.
     1501   on alt-left anywhere
     1502   do:
     1503     run diasize_change-width in this-procedure
     1504       (input -1
     1505       ,input true
     1506       ) .
     1507     return no-apply .
     1508   end.
     1509   on alt-down anywhere
     1510   do:
     1511     run diasize_change-height in this-procedure
     1512       (input 1
     1513       ,input true
     1514       ) .
     1515     return no-apply .
     1516   end.
     1517   on alt-up anywhere
     1518   do:
     1519     run diasize_change-height in this-procedure
     1520       (input -1
     1521       ,input true
     1522       ) .
     1523     return no-apply .
     1524   end.
     1525   on alt-enter of frame Dialog-Frame
     1526   do:
     1527     run diasize_maximize in this-procedure
     1528       (input  ?
     1529       ).
     1530     return no-apply .
     1531   end.
     1532   procedure diasize_end-move :
     1533     do
     1534     on error undo, return error return-value
     1535     :
     1536       define variable v-row-delta as decimal   no-undo .
     1537       define variable v-col-delta as decimal   no-undo .
     1538       define variable v-new-row as decimal   no-undo .
     1539       define variable v-new-col as decimal   no-undo .
     1540       assign
     1541         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1542         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1543       .
     1544       assign
     1545         v-row-delta = v-new-row - frame Dialog-Frame :height
     1546         v-col-delta = v-new-col - frame Dialog-Frame :width
     1547       .
     1548       run diasize_change-height in this-procedure
     1549         (input v-row-delta
     1550         ,input true
     1551         ) .
     1552       run diasize_change-width in this-procedure
     1553         (input v-col-delta
     1554         ,input true
     1555         ) .
     1556     end.
     1557   end procedure.
     1558   procedure diasize_maximize :
     1559     define input  parameter p-action as logical   no-undo .
     1560     do
     1561     on error undo, return error return-value
     1562     :
     1563       if p-action = ?
     1564       then do:
     1565         if v-diasize-need-maximize = true
     1566         then do:
     1567           assign
     1568             p-action = true
     1569           .
     1570         end.
     1571         else do:
     1572           assign
     1573             p-action = false
     1574           .
     1575         end.
     1576       end.
     1577       if p-action = true
     1578       then do:
     1579         run diasize_change-height in this-procedure
     1580           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1581               - frame Dialog-Frame :height-chars
     1582           ,input true
     1583           ) .
     1584         run diasize_change-width in this-procedure
     1585           (input session :width-chars
     1586               - frame Dialog-Frame :width-chars
     1587           ,input true
     1588           ) .
     1589         assign
     1590           v-diasize-need-maximize = false
     1591         .
     1592       end.
     1593       else do:
     1594         run diasize_change-width in this-procedure
     1595           (input v-diasize-orig-frame-width
     1596               - frame Dialog-Frame :width-chars
     1597           ,input true
     1598           ) .
     1599         run diasize_change-height in this-procedure
     1600           (input v-diasize-orig-frame-height
     1601               - frame Dialog-Frame :height-chars
     1602           ,input true
     1603           ) .
     1604         assign
     1605           v-diasize-need-maximize = true
     1606         .
     1607       end.
     1608     end.
     1609   end procedure.
     1610   procedure diasize_restore-orig-size :
     1611     do
     1612     on error undo, return error return-value
     1613     :
     1614       assign
     1615         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1616         v-diasize-current-frame-height = frame Dialog-Frame :height
     1617       .
     1618       run diasize_set-height in this-procedure
     1619         (input  v-diasize-orig-frame-height
     1620         ,input  true
     1621         ) .
     1622       run diasize_set-width in this-procedure
     1623         (input  v-diasize-orig-frame-width
     1624         ,input  true
     1625         ) .
     1626     end.
     1627   end procedure.
     1628   procedure diasize_restore-current-size :
     1629     do
     1630     on error undo, return error return-value
     1631     :
     1632       run diasize_set-height in this-procedure
     1633         (input  v-diasize-current-frame-height
     1634         ,input  true
     1635         ) .
     1636       run diasize_set-width in this-procedure
     1637         (input  v-diasize-current-frame-width
     1638         ,input  true
     1639         ) .
     1640     end.
     1641   end procedure.
     1642   procedure diasize_set-browse-handle :
     1643     define input  parameter p-browse-handle as handle   no-undo .
     1644     define buffer buf_temp-browse-handle for temp-browse-handle .
     1645     do
     1646     on error undo, return error return-value
     1647     :
     1648       assign
     1649         v-diasize-browse-handle = p-browse-handle
     1650       .
     1651       for each buf_temp-browse-handle
     1652       on error undo, return error return-value
     1653       :
     1654         delete buf_temp-browse-handle .
     1655       end.
     1656     end.
     1657   end procedure.
     1658   procedure diasize_add_browse :
     1659     define input  parameter p-browse-type   as character no-undo .
     1660     define input  parameter p-browse-handle as handle    no-undo .
     1661     define buffer buf_temp-browse-handle for temp-browse-handle .
     1662     do
     1663     on error undo, return error return-value
     1664     :
     1665       assign
     1666         v-diasize-browse-number = v-diasize-browse-number + 1
     1667       .
     1668       create buf_temp-browse-handle .
     1669       assign
     1670         buf_temp-browse-handle.browse-type   = p-browse-type
     1671         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1672         buf_temp-browse-handle.browse-handle = p-browse-handle
     1673       .
     1674     end.
     1675   end procedure.
     1676   procedure diasize_init :
     1677     define variable v-default-value    as logical   no-undo .
     1678     define variable v-restore-saved    as logical   no-undo .
     1679     define variable v-resize-value-str as character no-undo .
     1680     do
     1681     on error undo, return error return-value
     1682     :
     1683       do with frame Dialog-Frame
     1684       :
     1685         assign
     1686           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1687           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1688           v-diasize-browse-handle     = browse br-rule-by-set :handle
     1689         .
     1690         create button v-diasize-resize-button
     1691         assign
     1692           parent        = frame Dialog-Frame :first-child
     1693           label         = "s"
     1694           height-pixels = 16
     1695           width-pixels  = 16
     1696           visible       = true
     1697           sensitive     = true
     1698           movable       = true
     1699           triggers:
     1700             on end-move persistent run diasize_end-move in this-procedure .
     1701           end triggers.
     1702         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1703         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1704         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1705         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1706         assign
     1707           v-diasize-wndmax = false
     1708         .
     1709         if connected("ub") = true
     1710         then do:
     1711           define variable v-cntxt-db-num        as integer   no-undo .
     1712           define variable v-cntxt-userid        as character no-undo .
     1713           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1714                                             , OUTPUT v-cntxt-userid
     1715                                             ) .
     1716           run gbl/wndpar_r.p
     1717             (input  v-cntxt-db-num
     1718             ,input  v-cntxt-userid
     1719             ,input  'wndmax':U
     1720             ,output v-diasize-wndmax
     1721             ,output v-default-value
     1722             ) .
     1723         end.
     1724         assign
     1725           v-diasize-wndstore = false
     1726         .
     1727         if connected("ub") = true
     1728         then do:
     1729           run gbl/wndpar_r.p
     1730             (input  v-cntxt-db-num
     1731             ,input  v-cntxt-userid
     1732             ,input  'wndstore':U
     1733             ,output v-diasize-wndstore
     1734             ,output v-default-value
     1735             ) .
     1736         end.
     1737         assign
     1738           v-diasize-proc-name = entry(1, program-name(2), '.')
     1739         .
     1740         if v-diasize-wndstore = true
     1741         then do:
     1742           assign
     1743             v-restore-saved = false
     1744           .
     1745           if connected("ub") = true
     1746           then do:
     1747             run gbl/wndsizer.p
     1748               (input  v-cntxt-db-num
     1749               ,input  v-cntxt-userid
     1750               ,input  v-diasize-proc-name
     1751               ,input  'height':u
     1752               ,output v-resize-value-str
     1753               ) .
     1754             if v-resize-value-str <> '':U
     1755             then do:
     1756               run diasize_change-height in this-procedure
     1757                 (input  integer(v-resize-value-str)
     1758                 ,input  true
     1759                 ) .
     1760               assign
     1761                 v-restore-saved = true
     1762               .
     1763             end.
     1764           end.
     1765           if connected("ub") = true
     1766           then do:
     1767             run gbl/wndsizer.p
     1768               (input  v-cntxt-db-num
     1769               ,input  v-cntxt-userid
     1770               ,input  v-diasize-proc-name
     1771               ,input  'width':u
     1772               ,output v-resize-value-str
     1773               ) .
     1774             if v-resize-value-str <> '':U
     1775             then do:
     1776               run diasize_change-width in this-procedure
     1777                 (input  integer(v-resize-value-str)
     1778                 ,input  true
     1779                 ) .
     1780               assign
     1781                 v-restore-saved = true
     1782               .
     1783             end.
     1784           end.
     1785           if v-restore-saved <> true
     1786           then do:
     1787             if v-diasize-wndmax = true
     1788             then do:
     1789               run diasize_maximize in this-procedure
     1790                 (input  true
     1791                 ) .
     1792             end.
     1793           end.
     1794         end.
     1795         else do:
     1796           if v-diasize-wndmax = true
     1797           then do:
     1798             run diasize_maximize in this-procedure
     1799               (input  true
     1800               ) .
     1801           end.
     1802         end.
     1803       end.
     1804     end.
     1805   end procedure.
     1806   procedure diasize_need-full-display :
     1807     define output parameter p-need-full-display as logical   no-undo .
     1808     do
     1809     on error undo, return error return-value
     1810     :
     1811       assign
     1812         p-need-full-display = v-diasize-need-full-display
     1813       .
     1814       assign
     1815         v-diasize-need-full-display = false
     1816       .
     1817     end.
     1818   end procedure.
     1819   procedure get-context :
     1820      define output parameter p-db-num as integer          no-undo.
     1821      define output parameter p-user-id as character        no-undo.
     1822      define variable v-login               as character    no-undo.
     1823      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1824      define buffer buf_user-login  for ub.user-login .
     1825      do
     1826      on error undo, return error
     1827      :
     1828            FIND FIRST buf_sys-ctrl no-lock.
     1829            ASSIGN
     1830               v-login = USERID("ub")
     1831               p-db-num = buf_sys-ctrl.db-num
     1832            .
     1833            FIND FIRST buf_user-login
     1834                 WHERE buf_user-login.db-num = p-db-num
     1835                   AND buf_user-login.user-login = v-login
     1836                 no-lock
     1837                 no-error
     1838                 .
     1839            IF AVAILABLE buf_user-login
     1840            THEN DO:
     1841               assign
     1842                  p-user-id = buf_user-login.user-id
     1843               .
     1844            END.
     1845      end.
     1846   end procedure.
     1847       run diasize_init in this-procedure .
     1848   define variable vss-include-info9 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1849   on INS of frame Dialog-Frame anywhere do:
     1850     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame Dialog-Frame. END.
     1851     return no-apply.
     1852   end.
     1853   define variable vss-include-info10 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1854   on F3 of frame Dialog-Frame anywhere do:
     1855     if b-lkp :sensitive then DO: apply "CHOOSE":U to b-lkp in frame Dialog-Frame. END.
     1856     return no-apply.
     1857   end.
     1858   define variable vss-include-info11 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1859   on CTRL-N, CTRL-Т of frame Dialog-Frame anywhere do:
     1860     if b-add :sensitive then DO: apply "CHOOSE":U to b-add in frame Dialog-Frame. END.
     1861     return no-apply.
     1862   end.
     1863   define variable vss-include-info12 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1864   on F4 of frame Dialog-Frame anywhere do:
     1865     if b-chg :sensitive then DO: apply "CHOOSE":U to b-chg in frame Dialog-Frame. END.
     1866     return no-apply.
     1867   end.
     1868   define variable vss-include-info13 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1869   on F8 of frame Dialog-Frame anywhere do:
     1870     if b-del :sensitive then DO: apply "CHOOSE":U to b-del in frame Dialog-Frame. END.
     1871     return no-apply.
     1872   end.
     1873   define variable vss-include-info14 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1874   on F2 of frame Dialog-Frame anywhere do:
     1875     if b-sel :sensitive then DO: apply "CHOOSE":U to b-sel in frame Dialog-Frame. END.
     1876     return no-apply.
     1877   end.
     1878   define variable vss-include-info15 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1879   on F2 of frame Dialog-Frame anywhere do:
     1880     if b-quit :sensitive then DO: apply "CHOOSE":U to b-quit in frame Dialog-Frame. END.
     1881     return no-apply.
     1882   end.
     1883   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1884   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1885   MAIN-BLOCK:
     1886   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1887      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1888   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1889     run mainmenu_getcntxt in parparentproc
     1890       (output v-cntxt-db-num
     1891       ,output v-cntxt-userid
     1892       ,output v-cntxt-level
     1893       ,output v-cntxt-host-code-obj
     1894       ,output v-cntxt-obj-type
     1895       ,output v-cntxt-obj-code
     1896       ,output v-cntxt-db-num-obj
     1897       ,output v-cntxt-is-admin
     1898       ) .
     1899     if lookup('admin', p-list-mode) > 0 then do:
     1900       v-admin = yes.
     1901       p-list-mode = trim(replace(p-list-mode, 'admin', ''), chr(44)).
     1902     end.
     1903     IF lookup(p-list-mode, 'все':U + chr(44) +
     1904                             "ruleset" + chr(44) +
     1905                              "codex" + chr(44) +
     1906                              "rule" + chr(44) +
     1907                              "wi-mode-available" + chr(44) +
     1908                              "wi-mode"
     1909                              ) = 0  THEN DO:
     1910        MESSAGE
     1911        substitute("Неверное значение параметра p-list-mode=&1", p-list-mode)
     1912        VIEW-AS ALERT-BOX ERROR.
     1913        UNDO main-block,  RETURN ERROR.
     1914     END.
     1915     if p-list-mode = "wi-mode-available" then do:
     1916       if lookup("cb_rule-by-set-s_is-used", this-procedure:instantiating-procedure:internal-entries) = 0 then do:
     1917         message
     1918         substitute("&1 &2 &3. Не найдено определение процедуры cb_rule-by-set-s_is-used в &3"
     1919                   ,vss-workfile
     1920                   ,vss-revision
     1921                   ,vss-description
     1922                   ,this-procedure:instantiating-procedure:file-name)
     1923         view-as alert-box error .
     1924         undo main-block, return error .
     1925       end.
     1926       ELSE DO:
     1927         v-cb-handle = this-procedure:instantiating-procedure.
     1928       END.
     1929     end.
     1930     v-rid-list = p-rid-list.
     1931     run Myenable in this-procedure .
     1932     WAIT-FOR GO OF FRAME Dialog-Frame.
     1933   END.
     1934   RUN disable_UI.
     1935   PROCEDURE br-rule-by-set-mouse-select :
     1936   if b-sel:sensitive in frame Dialog-Frame then
     1937     if b-mark:sensitive then
     1938         apply "choose" to b-mark in frame Dialog-Frame.
     1939     else
     1940         apply "choose" to b-sel in frame Dialog-Frame.
     1941     else
     1942     if b-lkp:sensitive then
     1943         apply "choose" to b-lkp in frame Dialog-Frame.
     1944   END PROCEDURE.
     1945   PROCEDURE disable_UI :
     1946     HIDE FRAME Dialog-Frame.
     1947   END PROCEDURE.
     1948   PROCEDURE enable_UI :
     1949     DISPLAY EDITOR-1 mark-num
     1950         WITH FRAME Dialog-Frame.
     1951     ENABLE b-quit b-mark b-sel b-add b-chg b-del b-lkp B-Help br-rule-by-set
     1952            EDITOR-1 mark-num
     1953         WITH FRAME Dialog-Frame.
     1954     VIEW FRAME Dialog-Frame.
     1955     OPEN QUERY br-rule-by-set FOR EACH X_rule-by-set,        FIRST X_ruleset,        FIRST X_rule.
     1956   END PROCEDURE.
     1957   PROCEDURE MyEnable :
     1958   DEFINE VARIABLE v-h AS handle NO-UNDO.
     1959   ASSIGN
     1960   v-h = br-rule-by-set:FIRST-COLUMN IN FRAME Dialog-Frame
     1961   .
     1962   DO while valid-handle(v-h) :
     1963     if (v-h:LABEL = "Уже!использ"
     1964     OR v-h:LABEL = "Пар-ры" )
     1965     AND p-list-mode <> "wi-mode-available"
     1966        then do:
     1967       v-h:visible = no.
     1968     end.
     1969     v-h = v-h:NEXT-COLUMN.
     1970   END.
     1971   assign
     1972   editor-1:READ-ONLY IN FRAME Dialog-Frame = YES
     1973   X_rule.name:resizable in browse br-rule-by-set = yes
     1974   X_rule-by-set.RULE_id:VISIBLE IN BROWSE br-rule-by-set = (v-admin = YES)
     1975   X_ruleset.name:resizable in browse br-rule-by-set = yes
     1976   X_ruleset.name:visible in browse br-rule-by-set = (p-list-mode <> "codex" and p-list-mode <> "ruleset" AND p-list-mode <> "wi-mode-available" and p-list-mode <> "wi-mode")
     1977   X_rule.name:visible in browse br-rule-by-set = (p-list-mode <> "rule")
     1978   X_rule-by-set.codex_id:visible in browse br-rule-by-set = (p-list-mode <> "wi-mode-available" and p-list-mode <> "wi-mode" )
     1979   X_rule-by-set.ruleset_id:visible in browse br-rule-by-set = (p-list-mode <> "wi-mode-available" and p-list-mode <> "wi-mode" )
     1980   X_rule.NAME:LABEL IN BROWSE br-rule-by-set = (IF p-list-mode = "wi-mode-available"
     1981                                                 or p-list-mode = "wi-mode"
     1982                                                 THEN "Функция"
     1983                                                 ELSE X_rule.NAME:LABEL IN BROWSE br-rule-by-set)
     1984   .
     1985   ENABLE
     1986   b-quit
     1987   b-add when ((p-list-mode = "ruleset" or p-list-mode = "rule") and v-cntxt-db-num = 0 and lookup("b-add", bttns) > 0)
     1988   b-del when (v-cntxt-db-num = 0 and lookup("b-add", bttns) > 0)
     1989   B-Help
     1990   b-mark when lookup("b-mark", bttns) > 0
     1991   b-sel when lookup("b-sel", bttns) > 0
     1992   br-rule-by-set
     1993   EDITOR-1
     1994   WITH FRAME Dialog-Frame.
     1995   VIEW FRAME Dialog-Frame.
     1996   HIDE
     1997   b-lkp IN FRAME Dialog-Frame.
     1998   run Openbr in this-procedure .
     1999   APPLY "entry":U  to br-rule-by-set.
     2000   APPLY "VALUE-CHANGED" to br-rule-by-set.
     2001   END PROCEDURE.
     2002   PROCEDURE Openbr :
     2003   define buffer buf_wi-mode for ub.wi-mode .
     2004   CASE p-list-mode:
     2005     WHEN 'все':U THEN DO:
     2006       frame Dialog-Frame :title = "Все правила по всем наборам правил".
     2007       OPEN QUERY br-rule-by-set
     2008       FOR EACH X_rule-by-set NO-LOCK
     2009         , FIRST X_ruleset NO-LOCK WHERE
     2010                 X_ruleset.codex_id = X_rule-by-set.codex_id
     2011             AND X_ruleset.ruleset_id = X_rule-by-set.ruleset_id
     2012         , FIRST X_rule NO-LOCK  where
     2013                 X_rule.RULE_id = X_rule.RULE_id
     2014       INDEXED-REPOSITION.
     2015     END.
     2016     WHEN "ruleset"
     2017     OR
     2018     WHEN "wi-mode-available"
     2019     OR
     2020     WHEN "wi-mode"    THEN DO:
     2021       find first buf_wi-mode no-lock where
     2022                 buf_wi-mode.codex_id = p-codex-id
     2023             and buf_wi-mode.ruleset_id = p-ruleset-id no-error.
     2024       if available buf_wi-mode then  do:
     2025         frame Dialog-Frame :title = substitute("Функции (Правила) для режима &1", buf_wi-mode.mode-name).
     2026       end.
     2027       else do:
     2028         frame Dialog-Frame :title = substitute("Правила кодекса правил &1 набора правил &2", p-codex-id, p-ruleset-id).
     2029       end.
     2030       OPEN QUERY br-rule-by-set
     2031       FOR EACH X_rule-by-set NO-LOCK WHERE
     2032                X_rule-by-set.codex_id = p-codex-id
     2033            AND X_rule-by-set.ruleset_id = p-ruleset-id
     2034           , FIRST X_ruleset NO-LOCK WHERE
     2035                   X_ruleset.codex_id = X_rule-by-set.codex_id
     2036               AND X_ruleset.ruleset_id = X_rule-by-set.ruleset_id
     2037           , FIRST X_rule NO-LOCK  where
     2038                   X_rule.RULE_id = X_rule-by-set.RULE_id
     2039           INDEXED-REPOSITION.
     2040     END.
     2041     WHEN "codex" THEN DO:
     2042       frame Dialog-Frame :title = substitute("Правила кодекса правил &1", p-codex-id).
     2043       OPEN QUERY br-rule-by-set
     2044       FOR EACH X_rule-by-set NO-LOCK WHERE
     2045                X_rule-by-set.codex_id = p-codex-id
     2046           , FIRST X_ruleset NO-LOCK WHERE
     2047                   X_ruleset.codex_id = X_rule-by-set.codex_id
     2048               AND X_ruleset.ruleset_id = X_rule-by-set.ruleset_id
     2049           , FIRST X_rule NO-LOCK  where
     2050                   X_rule.RULE_id = X_rule-by-set.RULE_id
     2051           INDEXED-REPOSITION.
     2052     END.
     2053     WHEN "rule" THEN DO:
     2054       frame Dialog-Frame :title = substitute("Наборы правил для правила &1", p-rule-id).
     2055       OPEN QUERY br-rule-by-set
     2056       FOR EACH X_rule-by-set NO-LOCK WHERE
     2057               X_rule-by-set.rule_id = p-rule-id
     2058           , FIRST X_ruleset NO-LOCK WHERE
     2059                   X_ruleset.codex_id = X_rule-by-set.codex_id
     2060               AND X_ruleset.ruleset_id = X_rule-by-set.ruleset_id
     2061           , FIRST X_rule NO-LOCK  where
     2062                   X_rule.RULE_id = X_rule-by-set.RULE_id
     2063           INDEXED-REPOSITION.
     2064    END.
     2065   END CASE.
     2066   END PROCEDURE.
     2067   PROCEDURE proc-b-add-chg :
     2068   define input parameter p-add as logical no-undo .
     2069   define variable v-rid-list as character no-undo .
     2070   define variable v-rec as recid no-undo .
     2071   define variable v-ok as logical no-undo .
     2072   define variable v-ii as integer no-undo .
     2073   define variable v-is-dynamic as logical no-undo .
     2074   define buffer buf_rule for dictdb.rule.
     2075   define buffer buf_ruleset for dictdb.ruleset.
     2076   CASE p-add:
     2077     when yes then do:
     2078       if p-list-mode = "ruleset" then do:
     2079         run rul/rule-s.w ( input parparentproc
     2080                           ,input "b-sel,b-mark"
     2081                           ,input "codex"
     2082                           ,input p-codex-id
     2083                           ,input -999999999
     2084                           ,input-output v-rid-list) no-error.
     2085         if v-rid-list = '':U then do:
     2086           return.
     2087         end.
     2088         find first buf_rule no-lock where
     2089                   recid(buf_rule) = integer(v-rid-list).
     2090       end.
     2091       if p-list-mode = "rule" then do:
     2092         run rul/ruleset-s.w ( input parparentproc
     2093                               ,input "b-sel,b-mark"
     2094                               ,input "codex"
     2095                               ,input p-codex-id
     2096                               ,input-output v-rid-list) no-error.
     2097         if v-rid-list = '':U then do:
     2098           return.
     2099         end.
     2100       end.
     2101       do v-ii = 1 to num-entries(v-rid-list):
     2102         if p-list-mode = "rule" then do:
     2103           find first buf_ruleset no-lock where
     2104                       recid(buf_ruleset) = integer(entry(v-ii, v-rid-list)).
     2105         end.
     2106         if p-list-mode = "ruleset" then do:
     2107           find first buf_rule no-lock where
     2108                     recid(buf_rule) = integer(entry(v-ii,v-rid-list)).
     2109         end.
     2110         run rul/rule-by-set1.p ( input 'ДОБАВЛЕНИЕ':U
     2111                                   ,input no
     2112                                   ,input-output v-rec
     2113                                   ,input (if p-list-mode = "ruleset"
     2114                                           then p-codex-id
     2115                                           else buf_ruleset.codex_id)
     2116                                   ,input (if p-list-mode = "ruleset"
     2117                                           then p-ruleset-id
     2118                                           else buf_ruleset.ruleset_id)
     2119                                   ,input (if p-list-mode = "rule"
     2120                                           then p-rule-id
     2121                                           else buf_rule.rule_id)
     2122                                   ) no-error.
     2123         if error-status:error then do:
     2124           undo, return error .
     2125         end.
     2126       end.
     2127       run openbr in this-procedure .
     2128       reposition br-rule-by-set to recid v-rec no-error.
     2129       APPLY "ENTRY" to browse br-rule-by-set.
     2130     end.
     2131   end.
     2132   END PROCEDURE.
     2133   FUNCTION has-params RETURNS CHARACTER
     2134     ( INPUT p-rule-uniq-key-rec AS CHARACTER ) :
     2135   DEFINE BUFFER buf_ruledict FOR ub.ruledict.
     2136   DEFINE BUFFER buf_ruledict-param FOR ub.ruledict-param.
     2137   FIND first buf_ruledict no-lock WHERE
     2138           buf_ruledict.entry-type = 'rule':U
     2139       AND buf_ruledict.uniq-key-rec = p-rule-uniq-key-rec NO-ERROR.
     2140   IF AVAILABLE buf_ruledict THEN DO:
     2141     FIND FIRST buf_ruledict-param NO-LOCK WHERE
     2142               buf_ruledict-param.entry-id = buf_ruledict.entry-id NO-ERROR.
     2143     IF AVAILABLE buf_ruledict-param THEN RETURN "+".
     2144   END.
     2145   RETURN "".
     2146   END FUNCTION.
     2147   FUNCTION is-used RETURNS CHARACTER
     2148     ( INPUT p-codex-id AS INTEGER
     2149       ,INPUT p-ruleset-id AS INTEGER
     2150       ,INPUT p-rule-id AS INTEGER ) :
     2151   DEFINE VARIABLE v-is-used AS LOGICAL NO-UNDO.
     2152   RUN cb_rule-by-set-s_is-used IN v-cb-handle ( INPUT p-codex-id
     2153                                                ,INPUT p-ruleset-id
     2154                                                ,INPUT p-rule-id
     2155                                                ,OUTPUT v-is-used
     2156                                                 ) NO-ERROR.
     2157   IF v-is-used THEN RETURN "+".
     2158   RETURN "".
     2159   END FUNCTION.
