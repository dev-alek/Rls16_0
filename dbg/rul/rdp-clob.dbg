        1   block-level on error undo, throw.
        2   define parameter buffer buf_ruledict-param for ub.ruledict-param.
        3   define input parameter p-mode as character no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision$":U .
        5   define variable vss-author      as character no-undo init "$Author$":U .
        6   define variable vss-date        as character no-undo init "$Date$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        8   define variable vss-archive     as character no-undo init "$Archive$":U .
        9   define variable vss-description as character no-undo init "Ïğèâÿçêà è îòâÿçêà clob îò ruledict-param".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define variable v-clob-uniq-key-rec as character no-undo .
       69   define variable v-clob-db-num as integer   no-undo init ?.
       70   define variable v-int64-id as integer   no-undo init 0.
       71   define variable v-part-num as integer   no-undo init 1.
       72   define variable v-path                    as character                no-undo .
       73   DEFINE VARIABLE v-full-path               as character                no-undo .
       74   DEFINE VARIABLE v-file-name               as character                no-undo .
       75   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
       76   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
       77   define variable v-md5-signature           as character no-undo .
       78   define variable v-mode as character no-undo .
       79   define buffer buf_clob-data for ub.clob-data.
       80   define buffer buf_clob-bind for ub.clob-bind.
       81   main-block:
       82   do
       83   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
       84   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
       85   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
       86   :
       87     assign
       88     v-clob-uniq-key-rec = buf_ruledict-param.init-value-character
       89     .
       90     case p-mode:
       91       when 'ÄÎÁÀÂËÅÍÈÅ':U
       92       or
       93       when 'ÈÇÌÅÍÅÍÈÅ':U then do:
       94         if new(buf_ruledict-param) then v-mode = 'ÄÎÁÀÂËÅÍÈÅ':U.
       95         else v-mode = 'ÈÇÌÅÍÅÍÈÅ':U.
       96         if v-mode = 'ÄÎÁÀÂËÅÍÈÅ':U then do:
       97           find first buf_clob-bind no-lock where
       98                     buf_clob-bind.resource-type = 'gate':U
       99                and  buf_clob-bind.uniq-key-rec = v-clob-uniq-key-rec
      100                and buf_clob-bind.field-name = '':U
      101                and buf_clob-bind.part-num = 1 no-error.
      102           if available buf_clob-bind then do:
      103             v-mode = 'ÈÇÌÅÍÅÍÈÅ':U.
      104           end.
      105         end.
      106         run gbl/file2clb.p ( input v-mode
      107                             ,input "override"
      108                             ,input ?
      109                             ,input v-clob-uniq-key-rec
      110                             ,input '':U
      111                             ,input (buf_ruledict-param.param-label + chr(32) + buf_ruledict-param.documentation)
      112                             ,input-output v-part-num
      113                             ,input 'gate':U
      114                             ,input-output v-clob-db-num
      115                             ,input-output v-int64-id
      116                             ,input buf_ruledict-param.init-value-character
      117                             ,input ?
      118                             ) no-error .
      119         if error-status :error then do:
      120           if not new(buf_ruledict-param)
      121           and p-mode = 'ÈÇÌÅÍÅÍÈÅ':U
      122           then do:
      123             run gbl/filename.p (
      124                             input buf_ruledict-param.init-value-character
      125                           ,output v-full-path
      126                           ,output v-path
      127                           ,output v-file-name
      128                           ,output v-file-name-no-ext
      129                           ,output v-file-name-ext
      130                           ) no-error .
      131             if error-status:error then do:
      132               undo main-block, return error substitute("Íå óäàåòñÿ íàéòè ôàéë &1",buf_ruledict-param.init-value-character).
      133             end.
      134             run gbl/md5.p (
      135                                     input  v-full-path
      136                                     ,output v-md5-signature
      137                                     ) no-error .
      138             if error-status:error then do:
      139               undo, return error substitute("&1 &2 &3&4&5&4&6"
      140                                             ,vss-workfile
      141                                             ,vss-revision
      142                                             ,vss-description
      143                                             ,chr(10)
      144                                             , error-status:get-message(1)
      145                                             , return-value ).
      146             end.
      147             find first buf_clob-data no-lock where
      148                        buf_clob-data.file-name_ = buf_ruledict-param.init-value-character
      149                    and buf_clob-data.crc-field > '':U
      150                        no-error.
      151             if not available buf_clob-data
      152             or buf_clob-data.crc-field <> v-md5-signature
      153             then do:
      154               run gbl/file2clb.p ( input 'ÄÎÁÀÂËÅÍÈÅ':U
      155                                   ,input "add-new"
      156                                   ,input ?
      157                                   ,input v-clob-uniq-key-rec
      158                                   ,input '':U
      159                                   ,input (buf_ruledict-param.param-label + chr(32) + buf_ruledict-param.documentation)
      160                                   ,input-output v-part-num
      161                                   ,input 'gate':U
      162                                   ,input-output v-clob-db-num
      163                                   ,input-output v-int64-id
      164                                   ,input buf_ruledict-param.init-value-character
      165                                   ,input ?
      166                                   ) no-error .
      167               if error-status:error then do:
      168                 undo main-block, return error return-value .
      169               end.
      170             end.
      171           end.
      172           else do:
      173             undo main-block, return error return-value .
      174           end.
      175         end.
      176       end.
      177       when 'óäàëåíèå':U then do:
      178         run gbl/file2clb.p ( input 'óäàëåíèå':U
      179                             ,input "leave"
      180                             ,input ?
      181                             ,input v-clob-uniq-key-rec
      182                             ,input '':U
      183                             ,input '':U
      184                             ,input-output v-part-num
      185                             ,input 'gate':U
      186                             ,input-output v-clob-db-num
      187                             ,input-output v-int64-id
      188                             ,input buf_ruledict-param.init-value-character
      189                             ,input ?
      190                             ) no-error .
      191         if error-status :error then do:
      192           return error return-value .
      193         end.
      194       end.
      195     end case.
      196   end.
