     3671                       buffer temp-clients:handle:buffer-field(entry(2, buf_rule-call-param.param-value-character, ".")):buffer-value =
     3672                       n-entry[buf_rule-call-param.p-index].
     3673                     end.
     3674                     when 'integer':U then do:
     3675                       assign
     3676                       buffer temp-clients:handle:buffer-field(entry(2, buf_rule-call-param.param-value-character, ".")):buffer-value =
     3677                       integer(n-entry[buf_rule-call-param.p-index]).
