        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-parent-handle as handle no-undo .
        4   define input parameter p-log-handle  as handle no-undo .
        5   define input parameter p-cont-handle  as handle no-undo .
        6   define input parameter p-codex-id as integer no-undo .
        7   define input parameter p-ruleset-id as integer no-undo .
        8   define input parameter p-call-id as character no-undo .
        9   define input parameter p-order-id as integer no-undo .
       10   define input parameter p-rule-id as integer no-undo .
       11   define input parameter p-profile-id as integer no-undo .
       12   define input parameter p-is-dynamic as logical no-undo .
       13   define input parameter p-doc-type as character no-undo .
       14   define input parameter p-host-code like ub.sysconf.host-code no-undo .
       15   define input parameter p-obj-type like ub.clients.obj-type no-undo .
       16   define input parameter p-obj-code like ub.clients.obj-code no-undo .
       17   define input parameter p-doc-code as character no-undo .
       18   define input parameter p-process-file-name as character no-undo .
       19   define input parameter p-save       as integer no-undo .
       20   define input parameter v-curr-r-b   as character no-undo .
       21   define input parameter p-cmd-proc-handle as handle no-undo .
       22   define input parameter p-cmd-code  as integer no-undo .
       23   define variable vss-revision    as character no-undo init "$Revision$":U .
       24   define variable vss-author      as character no-undo init "$Author$":U .
       25   define variable vss-date        as character no-undo init "$Date$":U .
       26   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       27   define variable vss-archive     as character no-undo init "$Archive$":U .
       28   define variable vss-description as character no-undo init "Импорт/изменение клиентов по списку".
       29   procedure vss-get-info :
       30     define output parameter p-vss-revision    like vss-revision    no-undo .
       31     define output parameter p-vss-author      like vss-author      no-undo .
       32     define output parameter p-vss-date        like vss-date        no-undo .
       33     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       34     define output parameter p-vss-archive     like vss-archive     no-undo .
       35     define output parameter p-vss-description like vss-description no-undo .
       36     assign
       37       p-vss-revision    = vss-revision
       38       p-vss-author      = vss-author
       39       p-vss-date        = vss-date
       40       p-vss-workfile    = vss-workfile
       41       p-vss-archive     = vss-archive
       42       p-vss-description = vss-description
       43     .
       44   end procedure.
       45   procedure vss-get-parameters :
       46     define output parameter p-vss-parameters as character no-undo .
       47   end procedure.
       48   define new global shared variable g#vssrevis-logger as handle    no-undo .
       49   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       50   define variable v-vssrevis-logger                   as handle    no-undo .
       51   procedure vss-logevent :
       52     define input  parameter p-extra-paramters as character no-undo .
       53     define variable v-vssrevis-parameters as character no-undo .
       54     do
       55     on error undo, return error return-value
       56     :
       57       if  valid-handle(v-vssrevis-logger)
       58       and v-vssrevis-logger :get-signature("logevent") <> ""
       59       then do:
       60         run vss-get-parameters in this-procedure
       61           (output v-vssrevis-parameters
       62           ).
       63         run logevent in v-vssrevis-logger
       64           (input vss-workfile
       65           ,input vss-revision
       66           ,input v-vssrevis-parameters
       67           ,input p-extra-paramters
       68           ).
       69       end.
       70     end.
       71   end procedure.
       72   assign
       73     v-vssrevis-logger = g#vssrevis-logger
       74   .
       75   if  valid-handle(v-vssrevis-logger)
       76   and v-vssrevis-logger :get-signature("logevent") <> ""
       77   then do:
       78     assign
       79       v-vssrevis-logevent = true
       80     .
       81     run vss-logevent in this-procedure (input vss-description) .
       82   end.
       83   define new global shared variable g#language as character no-undo .
       84   if g#language <> '' and g#language <> 'rus':U then do:
       85     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       86   end.
       87   define new global shared variable g#library  as handle no-undo .
       88   define new global shared variable g#library2 as handle no-undo .
       89   define   shared variable g#auto as logical no-undo.
       90   define   shared variable g#news as logical no-undo.
       91   define   shared variable g#oxml as logical no-undo.
       92   define   shared variable g#esys as logical no-undo.
       93   define   shared variable g#news-source-db as integer no-undo.
       94   define   shared variable g#esys-source-esys as integer no-undo.
       95   define   shared variable g#db-num as integer   no-undo .
       96   define   shared variable g#userid as character no-undo .
       97   define   shared variable g#passwd as character no-undo .
       98   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       99   FUNCTION gbclcode-is-this-db-code returns logical ( input p-db-num as integer
      100                                                       ,input p-range-type as character
      101                                                       ,input p-code as integer):
      102   define variable v-seq-val as integer no-undo .
      103   define buffer buf_code-range for ub.code-range.
      104   find first buf_code-range no-lock where
      105             buf_code-range.db-num = p-db-num
      106       and  buf_code-range.range-type = p-range-type
      107       and  buf_code-range.stts = 'u'
      108       and buf_code-range.first-code <= p-code
      109       and buf_code-range.last-code >= p-code no-error .
      110   if available buf_code-range then return yes.
      111   CASE p-range-type:
      112     when 'pngb':U then do:
      113       v-seq-val = current-value(s-pngb-code, ub).
      114     end.
      115     when 'fmgb':U then do:
      116       v-seq-val = current-value(s-fmgb-code, ub).
      117     end.
      118   END CASE.
      119   if p-code <= v-seq-val then do:
      120     find first buf_code-range no-lock where
      121               buf_code-range.db-num = p-db-num
      122         and  buf_code-range.range-type = p-range-type
      123         and  buf_code-range.stts = 'a'
      124         and buf_code-range.first-code <= p-code
      125         no-error .
      126    if available buf_code-range then return yes.
      127   end.
      128   find first buf_code-range no-lock where
      129             buf_code-range.db-num = p-db-num
      130       and  buf_code-range.range-type = p-range-type
      131       and  buf_code-range.stts = 'f'
      132       and buf_code-range.first-code <= p-code
      133       and buf_code-range.last-code >= p-code
      134       no-error .
      135   if available buf_code-range then return yes.
      136   return no.
      137   END FUNCTION.
      138   FUNCTION gbclcode-is-this-db-code-short returns logical ( input p-db-num as integer
      139                                                       ,input p-range-type as character
      140                                                       ,input p-code as integer):
      141   define variable v-seq-val as integer no-undo .
      142   define buffer buf_code-range for ub.code-range.
      143   CASE p-range-type:
      144     when 'pngb':U then do:
      145       v-seq-val = current-value(s-pngb-code, ub).
      146     end.
      147     when 'fmgb':U then do:
      148       v-seq-val = current-value(s-fmgb-code, ub).
      149     end.
      150   END CASE.
      151   if p-code <= v-seq-val then do:
      152     find first buf_code-range no-lock where
      153               buf_code-range.db-num = p-db-num
      154         and  buf_code-range.range-type = p-range-type
      155         and buf_code-range.first-code <= p-code
      156         and buf_code-range.last-code >= p-code no-error .
      157     if available buf_code-range then return yes.
      158   end.
      159   return no.
      160   END FUNCTION.
      161   FUNCTION gbclcode-is-this-db-role returns integer ( input p-role as character
      162                                                       ,input p-db-num as integer
      163                                                       ,input p-staff-code as integer
      164                                                       ,input p-date as date
      165                                                        ):
      166   define buffer buf_staff for ub.staff.
      167   if p-date = ? then do:
      168     p-date = today .
      169   end.
      170   find first buf_staff no-lock where
      171             buf_staff.role = p-role
      172         and buf_staff.role-level = 'db':U
      173         and buf_staff.db-num = p-db-num
      174         and buf_staff.staff-code = p-staff-code
      175         and buf_staff.date-end >= p-date use-index pi  no-error .
      176   if available buf_staff then do:
      177     return buf_staff.psn-code.
      178   end.
      179   return 0.
      180   end FUNCTION.
      181   FUNCTION gbclcode-get-this-db-first-role returns integer ( input p-role as character
      182                                                             ,input p-db-num as integer
      183                                                             ,input p-date as date
      184                                                                 ):
      185   define buffer buf_staff for ub.staff.
      186   define buffer buf2_staff for ub.staff.
      187   if p-date = ? then do:
      188     p-date = today .
      189   end.
      190   for each  buf_staff no-lock where
      191             buf_staff.role = p-role
      192         and buf_staff.db-num = p-db-num,
      193   first buf2_staff no-lock where
      194         buf2_staff.role = p-role
      195     and buf2_staff.role-level = 'db':U
      196     and buf2_staff.staff-code = buf_staff.staff-code
      197     and buf2_staff.date-start <= p-date
      198     and buf2_staff.date-end >= p-date
      199   by buf_staff.staff-code
      200   by date-start descending:
      201     return buf_staff.staff-code.
      202   end.
      203   end FUNCTION.
      204   FUNCTION gbclcode-get-db-role returns integer ( input p-role as character
      205                                                  ,input p-db-num as integer
      206                                                  ,input p-psn-code as integer
      207                                                  ,input p-date as date
      208                                                  ,output p-c-password as character
      209                                                        ):
      210   define buffer buf_staff for ub.staff.
      211   if p-date = ? then do:
      212     p-date = today .
      213   end.
      214   find first buf_staff no-lock where
      215             buf_staff.role = p-role
      216         and buf_staff.role-level = 'db':U
      217         and buf_staff.db-num = p-db-num
      218        and buf_staff.date-end >= p-date
      219        and buf_staff.psn-code = p-psn-code use-index irole-psn no-error .
      220   if available buf_staff
      221   then do:
      222     assign
      223     p-c-password = buf_staff.password.
      224     return buf_staff.staff-code.
      225   end.
      226   p-c-password = ''.
      227   return 0.
      228   end FUNCTION.
      229   FUNCTION gbclcode-is-psn-role returns integer (
      230                                                 input p-role as character
      231                                                 ,input p-psn-code as integer
      232                                                 ,input p-date as date
      233                                                     ):
      234   define buffer buf_staff for ub.staff.
      235   if p-date = ? then do:
      236     p-date = today .
      237   end.
      238   for each buf_staff no-lock where
      239             buf_staff.psn-code = p-psn-code
      240        and  buf_staff.role = p-role
      241   by buf_staff.role-level
      242   by buf_staff.date-start
      243        :
      244     if  buf_staff.date-start <= p-date and
      245     buf_staff.date-end >= p-date  then do:
      246       return buf_staff.staff-code.
      247     end.
      248   end.
      249   return 0.
      250   end FUNCTION.
      251   FUNCTION gbclcode-get-role-name returns character ( input p-role as character):
      252   define variable v-role-name as character no-undo .
      253   assign
      254   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
      255   no-error .
      256   return v-role-name.
      257   END.
      258   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      259   FUNCTION gbclcode-get-position returns character ( input p-role as character
      260                                                     ,input p-role-level as character
      261                                                     ,input p-work-place as character
      262                                                     ,input p-staff-code as integer
      263                                                                ):
      264   define variable v-role-name as character no-undo .
      265   define variable v-role-level as character no-undo .
      266   define variable v-staff-code as integer no-undo .
      267   assign
      268   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
      269   v-role-level = substitute("&1 &2", entry (lookup (p-role-level, 'global,db,firm,object':U) + 1, ',':U + 'Глобально,БД,Фирма,Объект':U) , p-work-place)
      270   v-staff-code = p-staff-code
      271   no-error .
      272   return substitute("&1, &2, Код &3"
      273                   ,v-role-name
      274                   ,v-role-level
      275                   ,(if p-staff-code = 0 then chr(63) else string(p-staff-code))).
      276   END.
      277   FUNCTION gbclcode-get-work-place returns character (
      278                                                   input p-role as character
      279                                                  ,input p-role-level as character
      280                                                  ,input p-db-num as integer
      281                                                  ,input p-host-code as integer
      282                                                  ,input p-obj-type as character
      283                                                  ,input p-obj-code as integer
      284                                                  ) :
      285   define variable v-work-place as character no-undo .
      286   define variable v-obj-type as character no-undo .
      287     case p-role-level:
      288       when 'db':U then do:
      289         v-work-place = string(p-db-num, "99999").
      290       end.
      291       when 'firm':U then do:
      292         v-work-place = string(p-host-code, "99999").
      293       end.
      294       when 'object':U then do:
      295         assign
      296         v-work-place = p-obj-type + string(p-obj-code, "999999999")
      297         .
      298       end.
      299     END CASE.
      300     return v-work-place.
      301   END FUNCTION.
      302   FUNCTION gbclcode-get-level-last-code returns integer (
      303                                                           input p-role as character
      304                                                         , input p-role-level as character
      305                                                         , input p-work-place as character
      306                                                         , input p-date-start as date
      307                                                         ):
      308   DEFINE VARIABLE v-today as date no-undo .
      309   define buffer buf_staff for ub.staff.
      310   if p-work-place = chr(63) then return ?.
      311   if p-date-start = ? then do:
      312     v-today = today .
      313   end.
      314   else do:
      315     v-today = p-date-start.
      316   end.
      317   find last buf_staff no-lock where
      318             buf_staff.role = p-role
      319        and  buf_staff.role-level = p-role-level
      320        and  buf_staff.work-place = p-work-place
      321        and  buf_staff.date-start <= v-today + 1
      322        and  buf_staff.date-end >= v-today + 1
      323        use-index pi  no-error .
      324   if available buf_staff
      325   then return buf_staff.staff-code.
      326   return 0.
      327   end FUNCTION.
      328   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      329   procedure cur-time :
      330      define output parameter p-today as date      no-undo .
      331      define output parameter p-time  as integer   no-undo .
      332     do
      333     on error undo, return error
      334     :
      335       define variable v-date1 as date      no-undo .
      336       define variable v-date2 as date      no-undo .
      337       define variable v-time  as integer   no-undo .
      338       assign
      339         v-date1 = today
      340         v-time  = time
      341         v-date2 = today
      342       .
      343       if v-date1 <> v-date2
      344       then do:
      345         assign
      346           v-date1 = today
      347           v-time  = v-time
      348         .
      349       end.
      350       assign
      351         p-today = v-date1
      352         p-time  = v-time
      353       .
      354     end.
      355   end.
      356   function cur-time-date returns character
      357   :
      358     return string(today, '99/99/9999':U) .
      359   end.
      360   function cur-time-mjd returns decimal
      361   :
      362     define variable v-date as date      no-undo .
      363     define variable v-time as integer   no-undo .
      364     run cur-time in this-procedure
      365       (output v-date
      366       ,output v-time
      367       ) .
      368     return integer(v-date) - 2400002 + (v-time / 86400) .
      369   end.
      370   function cur-time-get-ending-index returns integer
      371   (input p-number as integer
      372   )
      373   :
      374     if p-number < 0
      375     or p-number = ?
      376     then do:
      377       return 1 .
      378     end.
      379     define variable v-rest as integer   no-undo .
      380     assign
      381       p-number = p-number modulo 100
      382     .
      383     if p-number < 20
      384     then do:
      385       assign
      386         v-rest = p-number
      387       .
      388     end.
      389     else do:
      390       assign
      391         v-rest = p-number modulo 10
      392       .
      393     end.
      394     case v-rest :
      395       when 1
      396       then do:
      397         return 2 .
      398       end.
      399       when 2 or
      400       when 3 or
      401       when 4
      402       then do:
      403         return 3 .
      404       end.
      405       otherwise do:
      406         return 1 .
      407       end.
      408     end case .
      409   end.
      410   procedure cur-time-mjd-to-date :
      411      define input  parameter i-mjd-diff as decimal no-undo.
      412      define output parameter o-Date     as date    no-undo.
      413      define output parameter o-Time     as integer no-undo.
      414      define variable v-day-number as integer   no-undo .
      415      if    i-mjd-diff < 0
      416         or i-mjd-diff = ?
      417      then do:
      418         return "?" .
      419      end.
      420      assign
      421         v-day-number = truncate(i-mjd-diff,0).
      422         o-Date = date(v-day-number + 2400002).
      423         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      424     .
      425   end.
      426   function cur-time-mjd-to-string returns character
      427   (input p-mjd-diff as decimal
      428   )
      429   :
      430     define variable v-day-number as integer   no-undo .
      431     define variable v-seconds    as integer   no-undo .
      432     define variable v-hour       as integer   no-undo .
      433     define variable v-min        as integer   no-undo .
      434     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      435     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      436     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      437     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      438     if p-mjd-diff < 0
      439     or p-mjd-diff = ?
      440     then do:
      441       return "?" .
      442     end.
      443     assign
      444       v-day-number = integer(truncate(p-mjd-diff,0))
      445       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      446     .
      447     if v-seconds > 86400
      448     then do:
      449       assign
      450         v-seconds = 86400 - 1
      451       .
      452     end.
      453     if v-seconds < 0
      454     then do:
      455       assign
      456         v-seconds = 0
      457       .
      458     end.
      459     assign
      460       v-hour = truncate(v-seconds / 3600, 0)
      461     .
      462     assign
      463       v-seconds = v-seconds modulo 3600
      464     .
      465     assign
      466       v-min = truncate(v-seconds / 60, 0)
      467     .
      468     assign
      469       v-seconds = v-seconds modulo 60
      470     .
      471     return
      472         (if v-day-number <> 0
      473           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      474           else ""
      475         )
      476       + (if v-day-number <> 0 or v-hour <> 0
      477           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      478           else ""
      479         )
      480       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      481           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      482           else ""
      483         )
      484       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      485       .
      486   end.
      487   function cur-time-string returns character
      488   :
      489     define variable v-date as date      no-undo .
      490     define variable v-time as integer   no-undo .
      491     run cur-time in this-procedure
      492       (output v-date
      493       ,output v-time
      494       ) .
      495     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      496   end.
      497   function cur-time-string-sec returns character
      498   :
      499     define variable v-date as date      no-undo .
      500     define variable v-time as integer   no-undo .
      501     run cur-time in this-procedure
      502       (output v-date
      503       ,output v-time
      504       ) .
      505     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      506   end.
      507   function cur-time-custom  returns character
      508   (input p-prefix as character
      509   ,input p-date-format as character
      510   ,input p-delimiter as character
      511   ,input p-time-format as character
      512   ,input p-suffix as character
      513   )
      514   :
      515     define variable v-date as date      no-undo .
      516     define variable v-time as integer   no-undo .
      517     run cur-time in this-procedure
      518       (output v-date
      519       ,output v-time
      520       ) .
      521     return
      522       p-prefix
      523       + string(v-date, p-date-format)
      524       + p-delimiter
      525       + string(v-time, p-time-format)
      526       + p-suffix
      527       .
      528   end.
      529   function cur-time-print  returns character
      530   :
      531     define variable v-date as date      no-undo .
      532     define variable v-time as integer   no-undo .
      533     run cur-time in this-procedure
      534       (output v-date
      535       ,output v-time
      536       ) .
      537     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      538   end.
      539   function cur-time-datetime returns datetime
      540   :
      541     define variable v-char as character no-undo .
      542     define variable v-datetime as datetime no-undo .
      543     v-char = cur-time-string().
      544     v-datetime = datetime(v-char).
      545     return  v-datetime.
      546   end.
      547   function cur-time-string-msec returns character
      548   :
      549     define variable v-date as datetime  no-undo .
      550     v-date = now.
      551     return string(v-date) .
      552   end.
      553   function diff-list returns character (
      554     input parfirst-list  as character,
      555     input parsecond-list as character,
      556     input pardelim       as character).
      557     if pardelim = ""
      558     or pardelim = ?
      559     then do:
      560       assign
      561         pardelim = ","
      562       .
      563     end.
      564     def var ind as integer no-undo .
      565     def var v-elem as character no-undo .
      566     def var v-result-list as character no-undo init "".
      567     def var v-num-parfirst-list as integer no-undo .
      568     assign
      569       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      570     .
      571     do ind = 1 to v-num-parfirst-list
      572     :
      573       assign
      574         v-elem = entry(ind, parfirst-list, pardelim)
      575       .
      576       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      577         assign
      578           v-result-list = v-result-list
      579                         + (if v-result-list > "" then pardelim else "")
      580                         + v-elem
      581         .
      582       end.
      583     end.
      584     return v-result-list .
      585   end function.
      586   function add-list returns character (
      587    input parfirst-list  as character,
      588    input parsecond-list as character,
      589    input pardelim       as character).
      590     if pardelim = ""
      591     or pardelim = ?
      592     then do:
      593       assign
      594         pardelim = ","
      595       .
      596     end.
      597     def var ind as integer no-undo .
      598     def var v-elem as character no-undo .
      599     def var v-result-list as character no-undo init "".
      600     def var v-num-parfirst-list as integer no-undo .
      601     assign
      602       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      603     .
      604     do ind = 1 to v-num-parfirst-list
      605     :
      606       assign
      607         v-elem = entry(ind, parfirst-list, pardelim)
      608       .
      609       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      610         assign
      611           v-result-list = v-result-list
      612                         + (if v-result-list > "" then pardelim else "")
      613                         + v-elem
      614         .
      615       end.
      616     end.
      617     def var v-num-parsecond-list as integer no-undo .
      618     assign
      619       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      620     .
      621     do ind = 1 to v-num-parsecond-list
      622     :
      623       assign
      624         v-elem = entry(ind, parsecond-list, pardelim)
      625       .
      626       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      627         assign
      628           v-result-list = v-result-list
      629                         + (if v-result-list > "" then pardelim else "")
      630                         + v-elem
      631         .
      632       end.
      633     end.
      634     return v-result-list .
      635   end function.
      636   function cross-list returns character (
      637    input parfirst-list  as character,
      638    input parsecond-list as character,
      639    input pardelim       as character).
      640     if pardelim = ""
      641     or pardelim = ?
      642     then do:
      643       assign
      644         pardelim = ","
      645       .
      646     end.
      647     def var ind as integer no-undo .
      648     def var v-elem as character no-undo .
      649     def var v-result-list as character no-undo init "".
      650     def var v-num-parfirst-list as integer no-undo .
      651     assign
      652       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      653     .
      654     do ind = 1 to v-num-parfirst-list
      655     :
      656       assign
      657         v-elem = entry(ind, parfirst-list, pardelim)
      658       .
      659       if lookup(v-elem, v-result-list, pardelim) = 0
      660       and lookup(v-elem, parsecond-list, pardelim) > 0
      661       then do:
      662         assign
      663           v-result-list = v-result-list
      664                         + (if v-result-list > "" then pardelim else "")
      665                         + v-elem
      666         .
      667       end.
      668     end.
      669     return v-result-list .
      670   end function.
      671   function radio-label returns character (
      672    input par-rs-value  as character,
      673    input par-rs-radio-buttons as character)
      674    .
      675    DEFINE variable v-result-label as character no-undo.
      676    assign
      677    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      678                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      679                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      680                             ), par-rs-radio-buttons
      681                           )
      682    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      683    .
      684   return v-result-label.
      685   end function.
      686   function m-radio-label returns character (
      687    input par-rs-value  as character,
      688    input par-rs-radio-buttons as character,
      689    input par-delim as character
      690    )
      691    .
      692    DEFINE variable v-result-label as character no-undo.
      693    assign
      694    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      695                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      696                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      697                             ), par-rs-radio-buttons, par-delim
      698                           )
      699    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      700    .
      701   return v-result-label.
      702   end function.
      703   FUNCTION mixlist returns character
      704   (
      705    input parfirst-list  as character
      706    ,input parsecond-list as character
      707    ,input pardelim       as character
      708    ,input pardelim-result as character ) :
      709     if pardelim = ""
      710     or pardelim = ?
      711     then do:
      712       assign
      713         pardelim = ","
      714       .
      715     end.
      716     def var ind as integer no-undo .
      717     def var v-elem1 as character no-undo .
      718     def var v-elem2 as character no-undo .
      719     def var v-result-list as character no-undo init "".
      720     do ind = 1 to num-entries(parfirst-list, pardelim)
      721     :
      722       assign
      723         v-elem1 = entry(ind, parfirst-list, pardelim)
      724         v-elem2 = entry(ind, parsecond-list, pardelim)
      725       .
      726         assign
      727           v-result-list = v-result-list
      728                         + (if v-result-list > "" then pardelim-result else "")
      729                         + v-elem1 + pardelim-result + v-elem2
      730         .
      731     end.
      732     return v-result-list .
      733   END FUNCTION.
      734   define stream getmc-stream .
      735   procedure get-max-code :
      736     define input  parameter p-action         as   character                 no-undo .
      737     define input  parameter p-db-num         like ub.db.db-num             no-undo .
      738     define input  parameter p-curr-type-cdrg like ub.code-range.range-type no-undo .
      739     define input  parameter p-first-code     like ub.code-range.first-code no-undo .
      740     define input  parameter p-last-code      like ub.code-range.last-code  no-undo .
      741     define input  parameter p-view-mess      as   logical                   no-undo .
      742     define output parameter v-b-code         as   integer                   no-undo .
      743     do
      744     on error undo, return error return-value
      745     :
      746       define variable v-main-bcode     like ub.bar-code.b-code no-undo .
      747       define variable l-prod-bc-global as   logical             no-undo .
      748       define variable l-prod-bc-weight as   logical             no-undo .
      749       define variable l-prod-bc-pgweight as   logical             no-undo .
      750       define variable rec-cnt          as   integer             no-undo .
      751       define variable str-u-f          as   character           no-undo .
      752       define variable str-u-f-rng      as   character           no-undo .
      753       define variable ind              as   integer             no-undo .
      754       define variable v-msg              as   character           no-undo initial "":U.
      755       define variable v-ret-msg          as   character           no-undo initial "":U.
      756       define frame get-max-code-inf
      757         rec-cnt label "Просмотрено"
      758         with view-as dialog-box side-labels row 11 centered
      759         title "..........................................." three-d
      760       .
      761       define buffer buf_code-range   for ub.code-range .
      762       define buffer buf-c_code-range for ub.code-range .
      763       define buffer buf_bar-code     for ub.bar-code .
      764       define buffer buf_place        for ub.place .
      765       define buffer buf_goods        for ub.goods .
      766       define buffer buf_units        for ub.units .
      767       define buffer buf_prod-bc      for ub.prod-bc .
      768       define buffer buf_dis-card     for ub.dis-card .
      769       define buffer buf_dis-rule     for ub.dis-rule .
      770       define buffer buf_dis-time-rule     for ub.dis-time-rule .
      771       define buffer buf_firm         for ub.firm .
      772       define buffer buf_person       for ub.person .
      773       define buffer buf_contract     for ub.contract .
      774       if p-curr-type-cdrg = 'sslc':U
      775       or p-curr-type-cdrg = 'ssgb':U
      776       then do:
      777         assign
      778           v-b-code = ?
      779         .
      780         return.
      781       end.
      782       if p-curr-type-cdrg = 'sclc':U
      783       or p-curr-type-cdrg = 'pglc':U
      784         or p-curr-type-cdrg = 'sslc':U
      785       then do:
      786         assign
      787           p-db-num = 0
      788         .
      789       end.
      790       case p-action :
      791         when "get-m-code":U then do:
      792           assign
      793             v-b-code = p-first-code
      794           .
      795         end.
      796         when "f-u":U then do:
      797           assign
      798             v-b-code = 0
      799           .
      800         end.
      801       end case.
      802       case p-curr-type-cdrg :
      803         when 'dcgb':U then do:
      804   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      805   define variable v-ii3 as integer   no-undo .
      806   define variable v-table-name3 as character no-undo .
      807   define variable v-field-name3 as character no-undo .
      808   define variable buf_h3 as handle no-undo .
      809   define variable q_h3 as handle no-undo .
      810   define variable v-avail3 as integer   no-undo .
      811   define variable v-code-mess3 as character no-undo .
      812   define variable glog3 as logical   no-undo .
      813   define variable v-code_3 as integer   no-undo .
      814   case p-action :
      815     when "get-m-code":U then do:
      816       do v-ii3 = 1 to num-entries('ub.dis-card'):
      817         assign
      818         v-table-name3 = entry(v-ii3, 'ub.dis-card')
      819         v-field-name3 = entry(v-ii3, 'card-num')
      820         .
      821         create buffer buf_h3 for table v-table-name3.
      822         create query q_h3.
      823         q_h3:SET-BUFFERS(buf_h3).
      824         q_h3:QUERY-PREPARE(substitute(" for each &1 WHERE &1.&2 >= &3 and &1.&2 <= &4 by &1.&2 descending"
      825                           ,v-table-name3
      826                           ,v-field-name3
      827                           ,p-first-code
      828                           ,p-last-code)
      829                           ).
      830         q_h3:QUERY-OPEN.
      831         REPEAT while  q_h3:get-next().
      832           assign
      833             v-code_3 = buf_h3:buffer-field(v-field-name3):buffer-value
      834           .
      835           leave .
      836         END.
      837         q_h3:QUERY-CLOSE().
      838         delete object q_h3.
      839         delete object buf_h3.
      840         v-b-code = max(v-code_3, v-b-code).
      841       end.
      842     end.
      843     when "f-u":U then do:
      844       for each buf_code-range share-lock
      845           where ( buf_code-range.range-type = p-curr-type-cdrg
      846                   and buf_code-range.db-num = p-db-num
      847                   and buf_code-range.stts = "f":U
      848                 ) or
      849                 ( buf_code-range.range-type = p-curr-type-cdrg
      850                   and buf_code-range.db-num = p-db-num
      851                   and buf_code-range.stts = "u":U
      852                 )
      853       on error undo, return error
      854       :
      855         v-avail3 = 0.
      856         do v-ii3 = 1 to num-entries('ub.dis-card'):
      857           assign
      858           v-table-name3 = entry(v-ii3, 'ub.dis-card')
      859           v-field-name3 = entry(v-ii3, 'card-num')
      860           .
      861           create buffer buf_h3 for table v-table-name3.
      862           glog3 = buf_h3:find-first ( substitute(" where &1.&2 >= &3 and &1.&2 <= &4 "
      863                                   , v-table-name3
      864                                   , v-field-name3
      865                                   , buf_code-range.first-code
      866                                   , buf_code-range.last-code)
      867                                   ) no-error .
      868           if buf_h3:available then do:
      869             assign
      870             v-avail3 = v-avail3 + 1
      871             .
      872             if v-avail3 = 1 then do:
      873               v-code-mess3 = string(buf_h3:buffer-field(v-field-name3):buffer-value)
      874               .
      875             end.
      876           end.
      877           delete object buf_h3.
      878        end.
      879        if v-avail3 > 0
      880           and buf_code-range.stts = "f":U
      881         then do:
      882           assign
      883             buf_code-range.stts = "u":U
      884             v-b-code            = v-b-code + 1
      885             v-msg               = substitute( "Диапазон кодов с &2 по &3&1"
      886                                               + "Помечен как 'u' т.к. существующий код &4 попадает в данный диапазон.&1"
      887                                               , chr(10)
      888                                               , buf_code-range.first-code
      889                                               , buf_code-range.last-code
      890                                               , v-code-mess3
      891                                             )
      892           .
      893           if p-view-mess = true then do:
      894             message
      895               v-msg
      896               view-as alert-box information.
      897           end.
      898           else do:
      899             output stream getmc-stream to "getmc.log" append.
      900             put stream getmc-stream unformatted
      901               string( today, "99/99/9999" ) space(1)
      902               string( time, "HH:MM:SS" ) space(1)
      903               v-msg skip
      904             .
      905             output stream getmc-stream close.
      906           end.
      907         end.
      908         if v-avail3 = 0
      909           and buf_code-range.stts = "u":U
      910         then do:
      911           find first buf-c_code-range exclusive-lock
      912             where rowid( buf-c_code-range ) = rowid( buf_code-range )
      913           .
      914           assign
      915             buf-c_code-range.stts = "c":U
      916           .
      917           release buf-c_code-range .
      918           assign
      919             buf_code-range.stts = "f":U
      920             v-b-code            = v-b-code + 1
      921             v-msg               = substitute( "Диапазон кодов с &2 по &3&1"
      922                                               + "Помечен как 'f' т.к. нет ни одного кода который попадает в данный диапазон.&1"
      923                                               , chr(10)
      924                                               , buf_code-range.first-code
      925                                               , buf_code-range.last-code
      926                                             )
      927           .
      928           if p-view-mess = true then do:
      929             message
      930               v-msg
      931               view-as alert-box information.
      932           end.
      933           else do:
      934             output stream getmc-stream to "getmc.log" append.
      935             put stream getmc-stream unformatted
      936               string( today, "99/99/9999" ) space(1)
      937               string( time, "HH:MM:SS" ) space(1)
      938               v-msg skip
      939             .
      940             output stream getmc-stream close.
      941           end.
      942         end.
      943       end.
      944     end.
      945   end case.
      946         end.
      947         when 'ctgb':U then do:
      948   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      949   define variable v-ii4 as integer   no-undo .
      950   define variable v-table-name4 as character no-undo .
      951   define variable v-field-name4 as character no-undo .
      952   define variable buf_h4 as handle no-undo .
      953   define variable q_h4 as handle no-undo .
      954   define variable v-avail4 as integer   no-undo .
      955   define variable v-code-mess4 as character no-undo .
      956   define variable glog4 as logical   no-undo .
      957   define variable v-code_4 as integer   no-undo .
      958   case p-action :
      959     when "get-m-code":U then do:
      960       do v-ii4 = 1 to num-entries('ub.contract'):
      961         assign
      962         v-table-name4 = entry(v-ii4, 'ub.contract')
      963         v-field-name4 = entry(v-ii4, 'contract-code')
      964         .
      965         create buffer buf_h4 for table v-table-name4.
      966         create query q_h4.
      967         q_h4:SET-BUFFERS(buf_h4).
      968         q_h4:QUERY-PREPARE(substitute(" for each &1 WHERE &1.&2 >= &3 and &1.&2 <= &4 by &1.&2 descending"
      969                           ,v-table-name4
      970                           ,v-field-name4
      971                           ,p-first-code
      972                           ,p-last-code)
      973                           ).
      974         q_h4:QUERY-OPEN.
      975         REPEAT while  q_h4:get-next().
      976           assign
      977             v-code_4 = buf_h4:buffer-field(v-field-name4):buffer-value
      978           .
      979           leave .
      980         END.
      981         q_h4:QUERY-CLOSE().
      982         delete object q_h4.
      983         delete object buf_h4.
      984         v-b-code = max(v-code_4, v-b-code).
      985       end.
      986     end.
      987     when "f-u":U then do:
      988       for each buf_code-range share-lock
      989           where ( buf_code-range.range-type = p-curr-type-cdrg
      990                   and buf_code-range.db-num = p-db-num
      991                   and buf_code-range.stts = "f":U
      992                 ) or
      993                 ( buf_code-range.range-type = p-curr-type-cdrg
      994                   and buf_code-range.db-num = p-db-num
      995                   and buf_code-range.stts = "u":U
      996                 )
      997       on error undo, return error
      998       :
      999         v-avail4 = 0.
     1000         do v-ii4 = 1 to num-entries('ub.contract'):
     1001           assign
     1002           v-table-name4 = entry(v-ii4, 'ub.contract')
     1003           v-field-name4 = entry(v-ii4, 'contract-code')
     1004           .
     1005           create buffer buf_h4 for table v-table-name4.
     1006           glog4 = buf_h4:find-first ( substitute(" where &1.&2 >= &3 and &1.&2 <= &4 "
     1007                                   , v-table-name4
     1008                                   , v-field-name4
     1009                                   , buf_code-range.first-code
     1010                                   , buf_code-range.last-code)
     1011                                   ) no-error .
     1012           if buf_h4:available then do:
     1013             assign
     1014             v-avail4 = v-avail4 + 1
     1015             .
     1016             if v-avail4 = 1 then do:
     1017               v-code-mess4 = string(buf_h4:buffer-field(v-field-name4):buffer-value)
     1018               .
     1019             end.
     1020           end.
     1021           delete object buf_h4.
     1022        end.
     1023        if v-avail4 > 0
     1024           and buf_code-range.stts = "f":U
     1025         then do:
     1026           assign
     1027             buf_code-range.stts = "u":U
     1028             v-b-code            = v-b-code + 1
     1029             v-msg               = substitute( "Диапазон кодов с &2 по &3&1"
     1030                                               + "Помечен как 'u' т.к. существующий код &4 попадает в данный диапазон.&1"
     1031                                               , chr(10)
     1032                                               , buf_code-range.first-code
     1033                                               , buf_code-range.last-code
     1034                                               , v-code-mess4
     1035                                             )
     1036           .
     1037           if p-view-mess = true then do:
     1038             message
     1039               v-msg
     1040               view-as alert-box information.
     1041           end.
     1042           else do:
     1043             output stream getmc-stream to "getmc.log" append.
     1044             put stream getmc-stream unformatted
     1045               string( today, "99/99/9999" ) space(1)
     1046               string( time, "HH:MM:SS" ) space(1)
     1047               v-msg skip
     1048             .
     1049             output stream getmc-stream close.
     1050           end.
     1051         end.
     1052         if v-avail4 = 0
     1053           and buf_code-range.stts = "u":U
     1054         then do:
     1055           find first buf-c_code-range exclusive-lock
     1056             where rowid( buf-c_code-range ) = rowid( buf_code-range )
     1057           .
     1058           assign
     1059             buf-c_code-range.stts = "c":U
     1060           .
     1061           release buf-c_code-range .
     1062           assign
     1063             buf_code-range.stts = "f":U
     1064             v-b-code            = v-b-code + 1
     1065             v-msg               = substitute( "Диапазон кодов с &2 по &3&1"
     1066                                               + "Помечен как 'f' т.к. нет ни одного кода который попадает в данный диапазон.&1"
     1067                                               , chr(10)
     1068                                               , buf_code-range.first-code
     1069                                               , buf_code-range.last-code
     1070                                             )
     1071           .
     1072           if p-view-mess = true then do:
     1073             message
     1074               v-msg
     1075               view-as alert-box information.
     1076           end.
     1077           else do:
     1078             output stream getmc-stream to "getmc.log" append.
     1079             put stream getmc-stream unformatted
     1080               string( today, "99/99/9999" ) space(1)
     1081               string( time, "HH:MM:SS" ) space(1)
     1082               v-msg skip
     1083             .
     1084             output stream getmc-stream close.
     1085           end.
     1086         end.
     1087       end.
     1088     end.
     1089   end case.
     1090         end.
     1091         when 'cagb':U then do:
     1092   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1093   define variable v-ii5 as integer   no-undo .
     1094   define variable v-table-name5 as character no-undo .
     1095   define variable v-field-name5 as character no-undo .
     1096   define variable buf_h5 as handle no-undo .
     1097   define variable q_h5 as handle no-undo .
     1098   define variable v-avail5 as integer   no-undo .
     1099   define variable v-code-mess5 as character no-undo .
     1100   define variable glog5 as logical   no-undo .
     1101   define variable v-code_5 as integer   no-undo .
     1102   case p-action :
     1103     when "get-m-code":U then do:
