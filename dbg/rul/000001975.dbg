     3692                   case entry(2, buf_rule-call-param.param-value-character, "."):
     3693                     when "parus-2-code" then do:
     3694                       my-parus-2-code =  n-entry[buf_rule-call-param.p-index].
     3695                     end.
     3696                   end.
     3697                 end.
     3698               end case.
     3699           end.
     3700           if v-check-dupl then do:
     3701             for each buf_clients no-lock where
     3702                     buf_clients.obj-type = 'чел':U
     3703                 and buf_clients.obj-name = my-obj-name,
     3704                 first buf_person no-lock where
     3705                       buf_person.psn-code = buf_clients.obj-code :
     3706               if (buf_person.name1 = temp-person.name1
     3707               and buf_person.name2 = temp-person.name2)
     3708               or
     3709                 (temp-person.name1 = ''
     3710               and temp-person.name2 = '')
     3711               or
     3712                 (buf_person.name1 = ''
     3713               and buf_person.name2 = '')
     3714               or (buf_person.name1 = temp-person.name1
     3715                   and
     3716                   (temp-person.name2 = ''
     3717                   or buf_person.name2 = ''))
     3718               or (buf_person.name2 = temp-person.name2
     3719                   and
     3720                   (temp-person.name1 = ''
     3721                   or buf_person.name1 = '')) then do:
     3722                 my-mess = substitute("Уже есть такой &1  или не везде заданы ИМЕНА И ОТЧЕСТВА", temp-clients.obj-name).
     3723                 run display-intelli-log in this-procedure ( input substitute("&1&2,&3,false,&4", my-obj-type, my-obj-code, my-parus-2-code, my-mess)).
     3724                 run err-write in this-procedure ( input-output my-mess).
     3725                 next _stroka.
     3726               end.
     3727             end.
     3728           end.
     3729           if v-check-inn-kpp then do:
     3730             if temp-firm.inn + temp-firm.kpp <> '' then do:
     3731               for each another_firm no-lock where
     3732                       another_firm.inn = temp-firm.inn
     3733                   and another_firm.kpp = temp-firm.kpp :
     3734                   leave.
     3735               end.
     3736               for each another_person no-lock where
     3737                       another_person.inn = temp-firm.inn
     3738                   and another_person.kpp = temp-firm.kpp :
     3739                   leave.
     3740               end.
     3741               if available another_firm
     3742               or available another_person then do:
     3743                 my-mess = substitute("Уже есть клиент с сочетанием ИНН+КПП=&1+&2"
     3744                                     , temp-firm.inn
     3745                                     , temp-firm.kpp).
     3746                 if available another_firm then do:
     3747                   run display-intelli-log in this-procedure ( input substitute("&1&2,&3,false,&4", "орг", another_firm.firm-code, my-parus-2-code, my-mess)).
     3748                 end.
     3749                 else do:
     3750                   run display-intelli-log in this-procedure ( input substitute("&1&2,&3,false,&4", "чел", another_person.psn-code, my-parus-2-code, my-mess)).
     3751                 end.
     3752                 run err-write in this-procedure ( input-output my-mess).
     3753                 next _stroka.
     3754               end.
     3755             end.
     3756           end.
     3757           IF LENGTH(temp-clients.obj-name) > 130 OR
     3758              LENGTH(temp-firm.city) > 23 OR
     3759              temp-firm.ind > 999999 OR
     3760              length(temp-firm.inn) > 21 OR
     3761              length(temp-firm.okonh) > 120 OR
     3762              length(temp-firm.okpo) > 10 OR
     3763              length(temp-firm.kpp) > 9 OR
     3764              length(temp-firm.addres1) > 30 OR
     3765              length(temp-firm.addres2) > 30 OR
     3766              length(temp-firm.post-addr1) > 50 OR
     3767              length(temp-firm.post-addr2) > 50 OR
     3768              length(temp-firm.phone) > 20 OR
     3769              length(temp-firm.phone1-note) > 10 OR
     3770              length(temp-firm.fax) >  20 OR
     3771              length(temp-firm.telex) > 20 OR
     3772              length(temp-firm.e-mail) > 100 OR
     3773              length(temp-firm.director) >  25 OR
     3774              length(temp-firm.contact-psn) > 50 OR
     3775              length(temp-firm.engl-name) > 130 then do:
     3776              assign
