     3923           end.
     3924           if v-check-dupl then do:
     3925             for each buf_clients no-lock where
     3926                     buf_clients.obj-type = 'чел':U
     3927                 and buf_clients.obj-name = my-obj-name,
     3928                 first buf_person no-lock where
     3929                       buf_person.psn-code = buf_clients.obj-code :
     3930               if (buf_person.name1 = temp-person.name1
     3931               and buf_person.name2 = temp-person.name2)
     3932               or
     3933                 (temp-person.name1 = ''
     3934               and temp-person.name2 = '')
     3935               or
     3936                 (buf_person.name1 = ''
     3937               and buf_person.name2 = '')
     3938               or (buf_person.name1 = temp-person.name1
     3939                   and
     3940                   (temp-person.name2 = ''
     3941                   or buf_person.name2 = ''))
     3942               or (buf_person.name2 = temp-person.name2
     3943                   and
     3944                   (temp-person.name1 = ''
     3945                   or buf_person.name1 = '')) then do:
     3946                 my-mess = substitute("Уже есть такой &1  или не везде заданы ИМЕНА И ОТЧЕСТВА", my-obj-name).
     3947                 run display-intelli-log in this-procedure ( input substitute("&1&2,&3,false,&4", my-obj-type, my-obj-code, my-parus-2-code, my-mess)).
     3948                 run err-write in this-procedure ( input-output my-mess).
     3949                 next _stroka.
     3950               end.
     3951             end.
     3952           end.
     3953           if v-check-inn-kpp then do:
     3954             if temp-person.inn + temp-person.kpp <> '' then do:
     3955               for each another_firm no-lock where
     3956                       another_firm.inn = temp-person.inn
     3957                   and another_firm.kpp = temp-person.kpp :
     3958                   leave.
     3959               end.
     3960               for each another_person no-lock where
     3961                       another_person.inn = temp-person.inn
     3962                   and another_person.kpp = temp-person.kpp :
     3963                   leave.
     3964               end.
     3965               if available another_firm
     3966               or available another_person then do:
     3967                 my-mess = substitute("Уже есть клиент с сочетанием ИНН+КПП=&1&2"
     3968                                     , temp-person.inn
     3969                                     , temp-person.kpp).
     3970                 run display-intelli-log in this-procedure ( input substitute("&1&2,&3,false,&4", my-obj-type, my-obj-code, my-parus-2-code, my-mess)).
     3971                 run err-write in this-procedure ( input-output my-mess).
     3972                 next _stroka.
     3973               end.
     3974             end.
     3975           end.
     3976           IF LENGTH(my-obj-name) > 40 OR
     3977              LENGTH(temp-person.city) > 23 OR
     3978              temp-person.ind > 999999 OR
     3979              length(temp-person.inn) > 15 OR
     3980              length(temp-person.okonh) > 120 OR
     3981              length(temp-person.okpo) > 10 OR
     3982              length(temp-person.kpp) > 9 OR
     3983              length(temp-person.address) > 30 OR
     3984              length(temp-person.name1) > 20 OR
     3985              length(temp-person.name2) > 20 OR
     3986              length(temp-person.firm-name) > 40 OR
     3987              length(temp-person.phone1) > 20 OR
     3988              length(temp-person.phone1-note) > 10 OR
     3989              length(temp-person.fax) >  20 OR
     3990              length(temp-person.position) > 20 OR
     3991              length(temp-person.e-mail) > 100 OR
     3992              length(temp-person.passp-ser) >  8 OR
     3993              length(temp-person.passp-num) > 18 OR
     3994              length(temp-person.given-by) > 40 then do:
     3995              assign
     3996              my-mess =
     3997                         (IF LENGTH(temp-clients.obj-name) > 40 then " поле <<ФАМИЛИЯ>> " else "") +
     3998                         (IF LENGTH(temp-person.city) > 23 then " поле <<Город>> " else "") +
     3999                         (IF temp-person.ind > 999999 then " поле <<ПОЧТОВЫЙ ИНДЕКС>> " else "") +
     4000                         (IF length(temp-person.inn) > 15 then " поле <<ИНН>> " else "") +
     4001                         (IF length(temp-person.okonh) > 120 then " поле <<ОКОНХ>> " else "") +
     4002                         (IF length(temp-person.okpo) > 10 then  " поле <<ОКПО>> " else "") +
     4003                         (IF length(temp-person.kpp) > 9 then  " поле <<КПП>> " else "") +
     4004                         (IF length(temp-person.address) > 30 then "поле <<ЮРИДИЧЕСКИЙ АДРЕС 1>> " else "") +
     4005                         (IF length(temp-person.name1) > 20 then "поле <<ИМЯ>> " else "") +
     4006                         (IF length(temp-person.name2) > 20 then " <<ФАМИЛИЯ>> " else "") +
     4007                         (IF length(temp-person.firm-name) > 40 then " <<ОРГАНИЗАЦИЯ>> " else "") +
     4008                         (IF length(temp-person.phone1) > 20 then " <<N ТЕЛЕФОНА>> " else "") +
     4009                         (IF length(temp-person.phone1-note) > 10 then  " <<Примечания к N ТЕЛЕФОНА>> " else "") +
     4010                         (IF length(temp-person.fax) > 20 then " <<N ФАКСА> " else "") +
     4011                         (IF length(temp-person.position) > 20 then " <<Должность>> " else "") +
     4012                         (IF length(temp-person.e-mail) > 100 then " <<E-mail>> " else "") +
     4013                         (IF length(temp-person.passp-ser) >  8 then  " <<СЕРИЯ ПАСПОРТА>> " else "") +
     4014                         (IF length(temp-person.passp-num) > 18 then " <<N ПАСПОРТА>> " else "") +
     4015                         (IF length(temp-person.given-by) > 40 then  " <<ПАСПОРТ ВЫДАН>> " else "")
     4016             my-mess = "Длина поля " + my-mess + " больше разрешенной"
     4017             .
     4018             run display-intelli-log in this-procedure ( input substitute("&1&2,&3,false,&4", my-obj-type, my-obj-code, my-parus-2-code, my-mess)).
     4019             run err-write in this-procedure ( input-output my-mess).
     4020             next _stroka.
     4021           END.
     4022          if temp-person.inn <> "":U then do:
     4023            run gbl/keyinn.p ( input temp-person.inn, input 'чел':U, input 0, input temp-person.is-pboul, output v-correct-inn).
     4024             if not v-correct-INN then do:
     4025               assign
     4026               v-return-value = return-value.
