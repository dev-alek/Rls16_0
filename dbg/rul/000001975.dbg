     3420       UNFORMATTED
     3421       ss
     3422       .
     3423       num-rec = num-rec + 1.
     3424       my-seek2 = seek(Instream).
     3425       if NUM-entries(ss, mydelimiter)  <> firm-fields AND
     3426          NUM-entries(ss, mydelimiter)  <> person-fields then do:
     3427           my-mess = substitute("Строчка не разобрана!&1" +
     3428                                "количество полей &2 не соответствует выбранному Вами формату c кол-вом полей!"
     3429                                ,chr(10)
     3430                                ,num-entries(ss, mydelimiter) ).
     3431           if num-rec = 1 then do:
     3432             run write-log-and-file in p-log-handle (
     3433                   input 1
     3434                 , input log-file-name
     3435                 , input 1
     3436                 , input my-mess).
     3437             v-view-log = yes.
     3438   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3439   if v-view-log
     3440   and not g#news
