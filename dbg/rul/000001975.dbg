     3450       (input  ('!!!При импорте информации произошли ошибки!!!')
     3451       ,input  0
     3452       ,input  (string("./":U) + 'process-clients.txt')
     3453       ,input  7
     3454       ,output v-user-action23
     3455       ,output v-printed23
     3456       ) .
     3457   end.
     3458   if v-view-log = true
     3459   and (g#news
     3460   or g#auto)
     3461   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
     3462   then do:
     3463      run cb_set-view-log in p-parent-handle ( input yes).
     3464   end.
     3465   if not v-view-log and search("cdviewlg_do-not-delete-log-file.txt") = ? then do:
     3466     OS-DELETE value(string("./":U) + 'process-clients.txt').
     3467   end.
     3468                           return.
     3469           end.
     3470           else do:
     3471             run display-intelli-log in this-procedure ( input substitute("&1&2,&3,false,&4", my-obj-type, my-obj-code, my-parus-2-code, my-mess)).
     3472             run err-write in this-procedure ( input-output my-mess).
     3473           end.
     3474           next _stroka.
     3475       end.
     3476       do nen = 1 to 40:
     3477         assign
     3478         n-entry[nen] = "":U
     3479         .
     3480       end.
     3481       do nen = 1 to num-entries(ss, mydelimiter):
     3482         assign
     3483         n-entry[nen] = entry(nen, ss, Mydelimiter)
     3484         n-entry[nen] = if index(n-entry[nen], chr(34), 1) = 1
     3485                        AND r-index(n-entry[nen], chr(34), 1) = 1
     3486                        then trim(n-entry[nen], chr(34))
     3487                        else n-entry[nen]
     3488         n-entry[nen] = if index(n-entry[nen], chr(39), 1) = 1
     3489                        AND r-index(n-entry[nen], chr(39), 1) = 1
     3490                        then trim(n-entry[nen], chr(39))
     3491                        else n-entry[nen]
     3492         .
     3493       end.
     3494       assign
     3495       my-obj-type = n-entry[1]
     3496       .
     3497       if my-obj-type  <> 'орг':U AND my-obj-type <> 'чел':U then do:
     3498           my-mess = substitute("Разрешенные значения поля <<ТИП-ОБЪЕКТА>> - &1 или &2"
     3499                                ,'орг':U
     3500                                ,'чел':U).
     3501           run display-intelli-log in this-procedure ( input substitute("&1&2,&3,false,&4", my-obj-type, my-obj-code, my-parus-2-code, my-mess)).
     3502           run err-write in this-procedure ( input-output my-mess).
     3503           next _stroka.
     3504       end.
