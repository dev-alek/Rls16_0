     3910                       buffer temp-clients:handle:buffer-field(entry(2, buf_rule-call-param.param-value-character, ".")):buffer-value =
     3911                       logical(n-entry[buf_rule-call-param.p-index]).
     3912                     end.
     3913                   end case.
     3914                 end.
     3915                 otherwise if num-entries(buf_rule-call-param.param-value-character, ".") > 1 then  do:
     3916                   case entry(2, buf_rule-call-param.param-value-character, "."):
     3917                     when "parus-2-code" then do:
