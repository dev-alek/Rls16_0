     4388               end.
     4389           end.
     4390         END CASE.
     4391       end.
     4392     END.
     4393     num-rec-ok = num-rec-ok + 1.
     4394     find first clients no-lock where
     4395               recid(clients) = v-rid.
     4396     run display-intelli-log in this-procedure ( input substitute("&1&2,&3,true,&4", clients.obj-type, clients.obj-code, my-parus-2-code, "OK")).
     4397     run show-counter in p-log-handle .
     4398     run write-counter in p-log-handle (substitute("Обработано &1 из них успешно &2"
     4399                                                 , num-rec
     4400                                                 , num-rec-ok
     4401                                                 )) no-error.
     4402     run get-stop-state in p-log-handle (
     4403         output v-stop
     4404     ).
     4405     if v-stop then do:
     4406       leave _stroka.
     4407     end.
     4408   END.
     4409   run write-log-and-file in p-log-handle (
     4410         input 1
     4411       , input log-file-name
     4412       , input 1
     4413       , input substitute("Импорт клиентов из файла &1 завершен: из &2 записей успешно закачано &3&4&5"
     4414                         , file-name
     4415                         , num-rec
     4416                         , num-rec-ok
     4417                         , chr(10)
     4418                         ,(if lookup("parus-2-code", firm-pars, chr(47)) > 0
     4419                           or lookup("parus-2-code", person-pars, chr(47)) > 0 then
     4420                           substitute("Дополнительный лог находится в файле &1", intelli-log-file-name)
     4421                           else "")
     4422                         )).
     4423   input stream InStream close.
     4424   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4425   if v-view-log
     4426   and not g#news
     4427   and not g#auto
     4428   then do:
     4429     message
     4430     '!!!При импорте информации произошли ошибки!!!'  skip
     4431     "!!!Внимательно прочитайте Log-file!!"
     4432     view-as alert-box error .
     4433        define variable v-user-action25   as character no-undo .
     4434     define variable v-printed25       as logical   no-undo .
     4435     run gbl/prnfilen.w
     4436       (input  ('!!!При импорте информации произошли ошибки!!!')
     4437       ,input  0
     4438       ,input  (string("./":U) + 'process-clients.txt')
     4439       ,input  7
     4440       ,output v-user-action25
     4441       ,output v-printed25
     4442       ) .
     4443   end.
     4444   if v-view-log = true
     4445   and (g#news
     4446   or g#auto)
     4447   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
     4448   then do:
     4449      run cb_set-view-log in p-parent-handle ( input yes).
     4450   end.
     4451   if not v-view-log and search("cdviewlg_do-not-delete-log-file.txt") = ? then do:
     4452     OS-DELETE value(string("./":U) + 'process-clients.txt').
     4453   end.
     4454                           return.
     4455   PROCEDURE err-write:
     4456     DEFINE INPUT-OUTPUT PARAMETER mess as char No-UNDO.
     4457     seek STREAM Instream to my-seek1.
     4458     import stream InStream unformatted
     4459     ss.
     4460     run write-log-and-file in p-log-handle (
     4461           input 1
     4462         , input log-file-name
     4463         , input 1
     4464         , input mess + chr(10) + ss).
     4465     assign
     4466     v-view-log = yes.
     4467     mess = "".
     4468     seek STREAM Instream to my-seek2.
     4469   END PROCEDURE.
     4470   procedure display-intelli-log :
     4471   define input parameter p-mess as character no-undo .
     4472   do
     4473   on error undo, return error
     4474   :
     4475     if lookup("parus-2-code", firm-pars, chr(47)) > 0
     4476     or lookup("parus-2-code", person-pars, chr(47)) > 0 then do:
     4477       output stream logstream to value(intelli-log-file-name) append.
     4478       put stream logstream unformatted replace(p-mess, chr(10), chr(32))  skip.
     4479       output stream logstream close.
     4480     end.
     4481   end.
     4482   end procedure.
