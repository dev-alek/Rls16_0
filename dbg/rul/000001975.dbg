     1954         end.
     1955         when 'scgb':U
     1956         or when 'sclc':U
     1957         then do:
     1958           case p-action :
     1959             when "get-m-code":U then do:
     1960               assign
     1961                 frame get-max-code-inf :title = "Поиск максимального значения кода"
     1962               .
     1963             end.
     1964             when "f-u":U then do:
     1965               assign
     1966                 frame get-max-code-inf :title = "Корректировка статуса code-range"
     1967               .
     1968               run mark-all-used-as-free in this-procedure (
     1969                                          input  p-db-num
     1970                                         ,input  p-curr-type-cdrg
     1971                                         ,output str-u-f
     1972                                         ,output str-u-f-rng
     1973                                       ).
     1974             end.
     1975           end case.
     1976           view frame get-max-code-inf.
     1977           assign
     1978             rec-cnt = 0
     1979           .
     1980           display
     1981             rec-cnt
     1982             with frame get-max-code-inf
     1983           .
     1984           for each buf_units no-lock
     1985               where lookup('вес':U, buf_units.type) > 0
     1986           on error undo, return error
     1987           :
     1988             for each buf_goods no-lock
     1989               where buf_goods.unit-base = buf_units.unit-name
     1990             on error undo, return error
     1991             :
     1992               assign
     1993                 rec-cnt = rec-cnt + 1
     1994               .
     1995               if ( rec-cnt modulo 10 ) = 0 then do:
     1996                 display
     1997                   rec-cnt
     1998                   with frame get-max-code-inf
     1999                 .
     2000               end.
     2001               run mc_gdsbcode in this-procedure (
     2002                                input  buf_goods.gds-code
     2003                               ,input  ?
     2004                               ,output v-main-bcode
     2005                             ) no-error .
     2006               if error-status :error then do:
     2007                 message
     2008                   vss-workfile vss-revision vss-description skip
     2009                   "Ошибка при поиске корневого бар-кода" skip
     2010                   "Артикул" buf_goods.artic buf_goods.prod-type buf_goods.prod-code skip
     2011                   error-status :get-message(1) skip
     2012                   return-value skip
     2013                   view-as alert-box error .
     2014                 undo, return error .
     2015               end.
     2016               for each buf_prod-bc no-lock
     2017                   where buf_prod-bc.b-code = v-main-bcode
     2018               on error undo, return error
     2019               :
     2020                 if p-curr-type-cdrg = 'sclc':U
     2021                   and buf_prod-bc.bc-on = FALSE
     2022                 then do:
     2023                   next.
     2024                 end.
     2025                 run mc_prodbcat in this-procedure (
     2026                                  buffer buf_prod-bc
     2027                                 ,input  'global=request':u
     2028                                 ,output l-prod-bc-global
     2029                               ) no-error .
     2030                 if error-status :error then do:
     2031                   message
     2032                     vss-workfile vss-revision vss-description skip
     2033                     "Ошибка при определении типа дополнительного бар-кода prodbcat" skip
     2034                     "Основной бар-код" buf_prod-bc.b-code skip
     2035                     "Дополнительный бар-код" buf_prod-bc.b-str skip
     2036                     "Действие global=request" skip
     2037                     error-status :get-message(1) skip
     2038                     return-value skip
     2039                     view-as alert-box error .
     2040                   undo, return error .
     2041                 end.
     2042                 run mc_prodbcat in this-procedure (
     2043                                  buffer buf_prod-bc
     2044                                 ,input  'weight=request':u
     2045                                 ,output l-prod-bc-weight
     2046                               ) no-error .
     2047                 if error-status :error then do:
     2048                   message
     2049                     vss-workfile vss-revision vss-description skip
     2050                     "Ошибка при определении типа дополнительного бар-кода prodbcat" skip
     2051                     "Основной бар-код" buf_prod-bc.b-code skip
     2052                     "Дополнительный бар-код" buf_prod-bc.b-str skip
     2053                     "Действие weight=request" skip
     2054                     error-status :get-message(1) skip
     2055                     return-value skip
     2056                     view-as alert-box error .
     2057                   undo, return error .
     2058                 end.
     2059                 if l-prod-bc-weight
     2060                   and ( ( l-prod-bc-global
     2061                           and p-curr-type-cdrg = 'scgb':U
     2062                         )
     2063                         or
     2064                         ( not l-prod-bc-global
     2065                           and p-curr-type-cdrg = 'sclc':U
     2066                         )
     2067                       )
     2068                 then do:
     2069                   case p-action :
     2070                     when "get-m-code":U then do:
     2071                       if integer( buf_prod-bc.b-str ) >= p-first-code
     2072                         and integer( buf_prod-bc.b-str ) <= p-last-code
     2073                         and integer( buf_prod-bc.b-str ) > v-b-code
     2074                       then do:
     2075                         assign
     2076                           v-b-code = integer( buf_prod-bc.b-str )
     2077                         .
     2078                       end.
     2079                     end.
     2080                     when "f-u":U then do:
     2081                       for each buf_code-range
     2082                         where buf_code-range.db-num     = p-db-num
     2083                           and buf_code-range.range-type = p-curr-type-cdrg
     2084                           and buf_code-range.stts       = "f":U
     2085                           and buf_code-range.first-code <= integer( buf_prod-bc.b-str )
     2086                           and buf_code-range.last-code  >= integer( buf_prod-bc.b-str )
     2087                       on error undo, return error
     2088                       :
     2089                         assign
     2090                           buf_code-range.stts = "u":U
     2091                         .
     2092                         if lookup( string( buf_code-range.first-code ) + "-":U + string( buf_code-range.last-code ), str-u-f-rng ) <> 0 then do:
     2093                           assign
     2094                             str-u-f-rng = diff-list( str-u-f-rng
     2095                                                     ,string( buf_code-range.first-code ) + "-":U + string( buf_code-range.last-code )
     2096                                                     ,",":U
     2097                                                     )
     2098                           .
     2099                         end.
     2100                         if lookup( buf_code-range.range-type + chr(3) + string( buf_code-range.first-code ), str-u-f ) = 0 then do:
     2101                           assign
     2102                             v-b-code = v-b-code + 1
     2103                             v-msg     = substitute( "Диапазон кодов с &2 по &3&1"
     2104                                                     + "Помечен как 'u' т.к. существующий код &4 попадает в данный диапазон.&1"
     2105                                                     , chr(10)
     2106                                                     , buf_code-range.first-code
     2107                                                     , buf_code-range.last-code
     2108                                                     , buf_prod-bc.b-str
     2109                                                   )
     2110                             v-ret-msg = v-ret-msg + v-msg
     2111                           .
     2112                           if p-view-mess = true then do:
     2113                             message
     2114                               v-msg
     2115                               view-as alert-box information.
     2116                           end.
     2117                         end.
     2118                       end.
     2119                     end.
     2120                   end case.
     2121                 end.
     2122               end.
     2123             end.
     2124           end.
     2125           if p-action = "f-u":U then do:
     2126             do ind = 1 to num-entries( str-u-f-rng ):
     2127               assign
     2128                 v-b-code  = v-b-code + 1
     2129                 v-msg     = substitute( "Диапазон кодов &2&1"
     2130                                         + "Помечен как 'f' т.к. нет ни одного кода который попадает в данный диапазон.&1"
     2131                                         , chr(10)
     2132                                         , entry( ind, str-u-f-rng )
     2133                                       )
     2134                 v-ret-msg = v-ret-msg + chr(10) + v-msg
     2135               .
     2136               if p-view-mess = true then do:
     2137                 message
     2138                   v-msg
     2139                   view-as alert-box information.
     2140               end.
     2141             end.
     2142           end.
     2143           hide frame get-max-code-inf no-pause .
     2144         end.
     2145         when 'pglc':U
     2146         then do:
     2147           case p-action :
     2148             when "get-m-code":U then do:
     2149               assign
     2150                 frame get-max-code-inf :title = "Поиск максимального значения кода"
     2151               .
     2152             end.
     2153             when "f-u":U then do:
     2154               assign
     2155                 frame get-max-code-inf :title = "Корректировка статуса code-range"
     2156               .
     2157               run mark-all-used-as-free in this-procedure (
     2158                                          input  p-db-num
     2159                                         ,input  p-curr-type-cdrg
     2160                                         ,output str-u-f
     2161                                         ,output str-u-f-rng
     2162                                       ).
     2163             end.
     2164           end case.
     2165           view frame get-max-code-inf.
     2166           assign
     2167             rec-cnt = 0
     2168           .
     2169           display
     2170             rec-cnt
     2171             with frame get-max-code-inf
     2172           .
     2173           for each buf_prod-bc no-lock where
     2174                   buf_prod-bc.b-str >= "00100"
     2175               and buf_prod-bc.b-str <= "99999"
     2176               and buf_prod-bc.bc-on-type = 'pglc':U
     2177               and length(buf_prod-bc.b-str) = 5
     2178           on error undo, return error
     2179           :
     2180               assign
     2181                 rec-cnt = rec-cnt + 1
     2182               .
     2183               if ( rec-cnt modulo 10 ) = 0 then do:
     2184                 display
     2185                   rec-cnt
     2186                   with frame get-max-code-inf
     2187                 .
     2188               end.
     2189               if p-curr-type-cdrg = 'pglc':U
     2190                 and buf_prod-bc.bc-on = FALSE
     2191               then do:
     2192                 next.
     2193               end.
     2194               run mc_prodbcat in this-procedure (
     2195                                 buffer buf_prod-bc
     2196                               ,input  'pgweight=request':u
     2197                               ,output l-prod-bc-pgweight
     2198                             ) no-error .
     2199               if error-status :error then do:
     2200                 message
     2201                   vss-workfile vss-revision vss-description skip
     2202                   "Ошибка при определении типа дополнительного бар-кода prodbcat" skip
     2203                   "Основной бар-код" buf_prod-bc.b-code skip
     2204                   "Дополнительный бар-код" buf_prod-bc.b-str skip
     2205                   "Действие weight=request" skip
     2206                   error-status :get-message(1) skip
     2207                   return-value skip
     2208                   view-as alert-box error .
     2209                 undo, return error .
     2210               end.
     2211               if l-prod-bc-pgweight
     2212               and p-curr-type-cdrg = 'pglc':U
     2213               then do:
     2214                 case p-action :
     2215                   when "get-m-code":U then do:
     2216                     if integer( buf_prod-bc.b-str ) >= p-first-code
     2217                       and integer( buf_prod-bc.b-str ) <= p-last-code
     2218                       and integer( buf_prod-bc.b-str ) > v-b-code
     2219                     then do:
     2220                       assign
     2221                         v-b-code = integer( buf_prod-bc.b-str )
     2222                       .
     2223                     end.
     2224                   end.
     2225                   when "f-u":U then do:
     2226                     for each buf_code-range
     2227                       where buf_code-range.db-num     = p-db-num
     2228                         and buf_code-range.range-type = p-curr-type-cdrg
     2229                         and buf_code-range.stts       = "f":U
     2230                         and buf_code-range.first-code <= integer( buf_prod-bc.b-str )
     2231                         and buf_code-range.last-code  >= integer( buf_prod-bc.b-str )
     2232                     on error undo, return error
     2233                     :
     2234                     assign
     2235                     buf_code-range.stts = "u":U
     2236                       .
     2237                     if lookup( string( buf_code-range.first-code ) + "-":U + string( buf_code-range.last-code ), str-u-f-rng ) <> 0 then do:
     2238                         assign
     2239                           str-u-f-rng = diff-list( str-u-f-rng
     2240                                                   ,string( buf_code-range.first-code ) + "-":U + string( buf_code-range.last-code )
     2241                                                   ,",":U
     2242                                                   )
     2243                         .
     2244                     end.
     2245                     if lookup( buf_code-range.range-type + chr(3) + string( buf_code-range.first-code ), str-u-f ) = 0 then do:
     2246                         assign
     2247                           v-b-code = v-b-code + 1
     2248                           v-msg     = substitute( "Диапазон кодов с &2 по &3&1"
     2249                                                   + "Помечен как 'u' т.к. существующий код &4 попадает в данный диапазон.&1"
     2250                                                   , chr(10)
     2251                                                   , buf_code-range.first-code
     2252                                                   , buf_code-range.last-code
     2253                                                   , buf_prod-bc.b-str
     2254                                                 )
     2255                           v-ret-msg = v-ret-msg + v-msg
     2256                         .
     2257                       if p-view-mess = true then do:
     2258                         message
     2259                           v-msg
     2260                           view-as alert-box information.
     2261                       end.
     2262                     end.
     2263                   end.
     2264                 end.
     2265               end case.
     2266             end.
     2267           end.
     2268           if p-action = "f-u":U then do:
     2269             do ind = 1 to num-entries( str-u-f-rng ):
     2270               assign
     2271                 v-b-code = v-b-code + 1
     2272                 v-msg     = substitute( "Диапазон кодов &2&1"
     2273                                         + "Помечен как 'f' т.к. нет ни одного кода который попадает в данный диапазон.&1"
     2274                                         , chr(10)
     2275                                         , entry( ind, str-u-f-rng )
     2276                                       )
     2277                 v-ret-msg = v-ret-msg + chr(10) + v-msg
     2278               .
     2279               if p-view-mess = true then do:
     2280                 message
     2281                   v-msg
     2282                   view-as alert-box information.
     2283               end.
     2284             end.
     2285           end.
     2286           hide frame get-max-code-inf no-pause .
     2287         end.
     2288         otherwise do:
     2289           message
     2290             vss-workfile vss-revision vss-description skip
     2291             "get-max-code" skip
     2292             "Непредусмотрена обработка диапазона кодов " p-curr-type-cdrg
     2293             view-as alert-box error.
     2294           return error.
     2295         end.
     2296       end case.
     2297     end.
     2298     return v-ret-msg.
     2299   end procedure.
     2300   procedure mark-all-used-as-free :
     2301     define input  parameter p-db-num         like ub.db.db-num             no-undo .
     2302     define input  parameter p-curr-type-cdrg like ub.code-range.range-type no-undo .
     2303     define output parameter p-str-u-f        as   character                 no-undo .
     2304     define output parameter p-str-u-f-rng    as   character                 no-undo .
     2305     do
     2306     on error undo, return error
     2307     :
     2308       define buffer buf_code-range   for ub.code-range.
     2309       define buffer buf-c_code-range for ub.code-range .
     2310       assign
     2311         p-str-u-f     = "":U
     2312         p-str-u-f-rng = "":U
     2313       .
     2314       for each buf_code-range share-lock
     2315           where buf_code-range.db-num     = p-db-num
     2316             and buf_code-range.range-type = p-curr-type-cdrg
     2317             and buf_code-range.stts       = "u":U
     2318       on error undo, return error
     2319       :
     2320         find first buf-c_code-range exclusive-lock
     2321           where rowid( buf-c_code-range ) = rowid( buf_code-range )
     2322         .
     2323         assign
     2324           buf-c_code-range.stts = "c":U
     2325         .
     2326         release buf-c_code-range .
     2327         assign
     2328           buf_code-range.stts = "f":U
     2329           p-str-u-f     = p-str-u-f + ",":U + buf_code-range.range-type + chr(3) + string( buf_code-range.first-code )
     2330           p-str-u-f-rng = p-str-u-f-rng + ",":U + string( buf_code-range.first-code ) + "-":U + string( buf_code-range.last-code )
     2331         .
     2332       end.
     2333       assign
     2334         p-str-u-f     = substring( p-str-u-f, 2, length( p-str-u-f ) - 1 )
     2335         p-str-u-f-rng = substring( p-str-u-f-rng, 2, length( p-str-u-f-rng ) - 1 )
     2336       .
     2337     end.
     2338   end procedure.
     2339   procedure mc_prodbcat :
     2340     do
     2341     on error undo, return error
     2342     :
     2343       define parameter buffer buf_prod-bc  for ub.prod-bc .
     2344       define input  parameter p-action           as character no-undo .
     2345       define output parameter p-return-attribute as logical no-undo .
     2346       def var vss-description as character no-undo init "prodbcat-01: определение параметров дополнительного бар-кода".
     2347       define buffer buf_bar-code   for ub.bar-code   .
     2348       define buffer buf_units      for ub.units      .
     2349       define buffer buf_code-range for ub.code-range .
     2350       define variable p-code-int as integer no-undo .
     2351       define variable v-cdrg-type as character no-undo .
     2352       if not available buf_prod-bc then do:
     2353         message
     2354           vss-workfile vss-revision vss-description skip
     2355           "Ошибка задания входных параметров" skip
     2356           "Не задан дополнительный бар-код" skip
     2357           view-as alert-box error .
     2358         undo, return error .
     2359       end.
     2360       find first buf_bar-code no-lock
     2361         where buf_bar-code.b-code = buf_prod-bc.b-code
     2362         no-error .
     2363       if not available buf_bar-code then do:
     2364         message
     2365           vss-workfile vss-revision vss-description skip
     2366           "Неправильная ссылка на основной бар-код" skip
     2367           "Основной бар-код" buf_prod-bc.b-code skip
     2368           "Дополнительный бар-код" buf_prod-bc.b-str skip
     2369           view-as alert-box error .
     2370         undo, return error .
     2371       end.
     2372       find first buf_units no-lock
     2373         where buf_units.unit-name = buf_bar-code.unit-cli
     2374         no-error .
     2375       if not available buf_units then do:
     2376         message
     2377           vss-workfile vss-revision vss-description skip
     2378           "Не найдена единица измерения основного бар-кода" skip
     2379           "Основной бар-код" buf_bar-code.b-code skip
     2380           "Единица измерения" buf_bar-code.unit-cli skip
     2381           view-as alert-box error .
     2382         undo, return error .
     2383       end.
     2384       def var ind                    as integer   no-undo .
     2385       def var v-num-entries-p-action as integer   no-undo .
     2386       def var v-action               as character no-undo .
     2387       assign
     2388         v-num-entries-p-action = num-entries(p-action)
     2389       .
     2390       assign
     2391         p-return-attribute = true
     2392       .
     2393       _ind:
     2394       do ind = 1 to v-num-entries-p-action
     2395       :
     2396        if ind > 1 and p-return-attribute = false then return.
     2397         assign
     2398           v-action = entry(ind, p-action)
     2399         .
     2400         case v-action :
     2401           when "global=request":u
     2402           then do:
     2403             if not (buf_prod-bc.bc-on-type = ''
     2404             or buf_prod-bc.bc-on-type = 'scgb':U
     2405             or buf_prod-bc.bc-on-type = 'ssgb':U) then do:
     2406               assign
     2407                 p-return-attribute = false
     2408               .
     2409             end.
     2410           end.
     2411           when "weight=request":u
     2412           then do:
     2413             if not (buf_prod-bc.bc-on-type = 'sclc':U
     2414             or buf_prod-bc.bc-on-type = 'scgb':U) then do:
     2415               assign
     2416                 p-return-attribute = false.
     2417             end.
     2418           end.
     2419           when "pgweight=request":u
     2420           then do:
     2421             if not (buf_prod-bc.bc-on-type = 'pglc':U) then do:
     2422               assign
     2423                 p-return-attribute = false.
     2424             end.
     2425           end.
     2426           when "petrolium=request":u
     2427           then do:
     2428             if not (buf_prod-bc.bc-on-type = 'ptlc':U) then do:
     2429               assign
     2430                 p-return-attribute = false.
     2431             end.
     2432           end.
     2433           when "scaleable=request":u
     2434           then do:
     2435             if not (buf_prod-bc.bc-on-type = 'sslc':U
     2436             or buf_prod-bc.bc-on-type = 'ssgb':U) then do:
     2437               assign
     2438                 p-return-attribute = false.
     2439             end.
     2440           end.
     2441           otherwise do:
     2442             message
     2443               vss-workfile vss-revision vss-description skip
     2444               "Неизвестное значение параметра v-action " skip
     2445               "v-action" v-action skip
     2446               "p-action" p-action skip
     2447               view-as alert-box error .
     2448             undo, return error .
     2449           end.
     2450         end case.
     2451       end.
     2452     end.
     2453   end procedure.
     2454   procedure mc_gdsbcode :
     2455     define input  parameter p-gds-code  like ub.bar-code.gds-code  no-undo .
     2456     define input  parameter p-node-code like ub.bar-code.node-code no-undo .
     2457     define output parameter p-b-code    like ub.bar-code.b-code    no-undo .
     2458     def var vss-description as character no-undo init "gdsbcode-01: определение первичного бар-кода признака".
     2459     def var vss-proc-revision as character no-undo init "library.p gdsbcode-01" .
     2460     define buffer buf_bar-code for ub.bar-code .
     2461     def var v-unit-base like ub.goods.unit-base no-undo .
     2462     do
     2463     on error undo, return error
     2464     :
     2465       if p-node-code = ? then do:
     2466         run mc_gdsrootnode in this-procedure (
     2467            input  p-gds-code
     2468           ,output p-node-code
     2469           ) no-error .
     2470         if error-status :error then do:
     2471           message
     2472             vss-workfile vss-revision vss-description skip
     2473             "Ошибка при определении корневого признака товара" skip
     2474             "Код товара" p-gds-code skip
     2475             error-status :get-message(1) skip
     2476             return-value skip
     2477             view-as alert-box error .
     2478           undo, return error .
     2479         end.
     2480       end.
     2481       run mc_unitbase in this-procedure (
     2482          input  p-gds-code
     2483         ,output v-unit-base
     2484         ) no-error .
     2485       if error-status :error then do:
     2486         message
     2487           vss-workfile vss-revision vss-description skip
     2488           "Ошибка определения базовой единицы измерения товара" skip
     2489           "Код товара" p-gds-code skip
     2490           view-as alert-box error .
     2491         undo, return error .
     2492       end.
     2493       find first buf_bar-code no-lock
     2494         where buf_bar-code.gds-code  = p-gds-code
     2495           and buf_bar-code.node-code = p-node-code
     2496           and buf_bar-code.part-code = ""
     2497           and buf_bar-code.in-code   = ""
     2498           and buf_bar-code.unit-cli  = v-unit-base
     2499         no-error .
     2500       if not available buf_bar-code then do:
     2501         undo, return error vss-proc-revision + ":" + chr(10)
     2502           + "Не найден первичный бар-кода признака " + chr(10)
     2503           + "Код товара " + string(p-gds-code) + chr(10)
     2504           + "Код признака " + string(p-node-code) + chr(10)
     2505           + "Базовая единица измерения " + string(v-unit-base) + chr(10)
     2506           .
     2507       end.
     2508       assign
     2509         p-b-code = buf_bar-code.b-code
     2510       .
     2511     end.
     2512   end procedure.
     2513   procedure mc_gdsrootnode :
     2514     define input  parameter p-gds-code  like ub.goods.gds-code no-undo .
     2515     define output parameter p-root-node like ub.goods.prt-root no-undo .
     2516     def var vss-description as character no-undo init "gdsrootnode-01: определение корневого признака товара по коду товара".
     2517     define buffer buf_goods   for ub.goods .
     2518     do
     2519     on error undo, return error
     2520     :
     2521       find first buf_goods no-lock
     2522         where buf_goods.gds-code  = p-gds-code
     2523         no-error .
     2524       if not available buf_goods then do:
     2525         message
     2526           vss-workfile vss-revision vss-description skip
     2527           "Не найден товар" skip
     2528           "Код товара" p-gds-code skip
     2529           view-as alert-box error .
     2530         undo, return error .
     2531       end.
     2532       run mc_prt-root-to-node-code in this-procedure (
     2533          input  buf_goods.prt-root
     2534         ,output p-root-node
     2535         ) no-error .
     2536       if error-status :error then do:
     2537         message
     2538           vss-workfile vss-revision vss-description skip
     2539           "Ошибка при вызове процедуры prt-root-to-node-code" skip
     2540           "Товар" buf_goods.artic buf_goods.prod-type buf_goods.prod-code skip
     2541           "Указатель на корень шкалы" buf_goods.prt-root skip
     2542           error-status :get-message(1) skip
     2543           return-value skip
     2544           view-as alert-box error .
     2545         undo, return error .
     2546       end.
     2547     end.
     2548   end procedure.
     2549   procedure mc_prt-root-to-node-code :
     2550     define input  parameter p-prt-root  like ub.goods.prt-root no-undo .
     2551     define output parameter p-root-node like ub.goods.prt-root no-undo .
     2552     def var vss-description as character no-undo init "prt-root-to-node-code-01: определение корневого признака шкалы по коду шкалы".
     2553     define buffer buf_gds-prt for ub.gds-prt .
     2554     do
     2555     on error undo, return error
     2556     :
     2557       find buf_gds-prt no-lock
     2558         where buf_gds-prt.upper-code = p-prt-root
     2559         no-error .
     2560       if not available buf_gds-prt then do:
     2561         message
     2562           vss-workfile vss-revision vss-description skip
     2563           "Не найден корень шкалы" skip
     2564           "Указатель на корень шкалы" p-prt-root skip
     2565           view-as alert-box error .
     2566         undo, return error .
     2567       end.
     2568       assign
     2569         p-root-node = buf_gds-prt.node-code
     2570       .
     2571     end.
     2572   end procedure.
     2573   procedure mc_unitbase :
     2574     define input  parameter p-gds-code  like ub.goods.gds-code  no-undo .
     2575     define output parameter p-unit-base like ub.goods.unit-base no-undo .
     2576     def var vss-description as character no-undo init "unitbase-01: определение базовой единицы измерения товара".
     2577     define buffer buf_goods for ub.goods .
     2578     do
     2579     on error undo, return error
     2580     :
     2581       find first buf_goods no-lock
     2582         where buf_goods.gds-code = p-gds-code
     2583         no-error .
     2584       if not available buf_goods then do:
     2585         message
     2586           vss-workfile vss-revision vss-description skip
     2587           "Не найден товар" skip
     2588           "Код товара" p-gds-code skip
     2589           view-as alert-box error .
     2590         undo, return error .
     2591       end.
     2592       assign
     2593         p-unit-base = buf_goods.unit-base
     2594       .
     2595     end.
     2596   end procedure.
     2597   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2598   def var vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2599   procedure gen-key-rec :
     2600     define input  parameter p-tbl-name    as character no-undo.
     2601     define input  parameter p-bh_tbl-name as handle    no-undo.
     2602     define output parameter p-key-rec     as character no-undo.
     2603     do
     2604     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2605     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     2606     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     2607     :
     2608       define variable fh               as handle    no-undo .
     2609       define variable v-ok             as logical   no-undo .
     2610       define variable v-inform         as character no-undo .
     2611       define variable v-ind            as integer   no-undo .
     2612       define variable v-idx-field-qnty as integer   no-undo .
     2613       if p-tbl-name = ?
     2614         or p-tbl-name = "":U
     2615       then do:
     2616         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info12 ).
     2617       end.
     2618       if not p-bh_tbl-name:available then do:
     2619         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info12, p-tbl-name ).
     2620       end.
     2621       assign
     2622         p-key-rec = p-tbl-name
     2623         v-inform  = p-bh_tbl-name:index-information(1)
     2624         v-ind     = 2
     2625       .
     2626       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2627       on error undo, return error
     2628       :
     2629         assign
     2630           v-inform = p-bh_tbl-name:index-information( v-ind )
     2631           v-ind    = v-ind + 1
     2632         .
     2633       end.
     2634       if v-inform = ?
     2635         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2636         or entry( 3, v-inform, ",":U ) <> "1":U
     2637       then do:
     2638         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info12, p-tbl-name ).
     2639       end.
     2640       else do:
     2641         assign
     2642           v-idx-field-qnty = num-entries( v-inform ) - 4
     2643         .
     2644         if v-idx-field-qnty < 2 then do:
     2645           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info12, v-inform, p-tbl-name ).
     2646         end.
     2647         do v-ind = 1 to v-idx-field-qnty by 2
     2648         on error undo, return error
     2649         :
     2650           assign
     2651             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     2652             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     2653           .
     2654         end.
     2655       end.
     2656       if p-key-rec = ? then do:
     2657         assign
     2658           p-key-rec = "":U
     2659         .
     2660         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info12, p-tbl-name ).
     2661       end.
     2662     end.
     2663     return.
     2664   end procedure.
     2665   procedure gen-where-keyr-tab :
     2666     define input  parameter i-tableSerach as character no-undo.
     2667     define input  parameter i-tablekey   as character  no-undo.
     2668     define input  parameter p-key-rec    as character  no-undo.
     2669     define input  parameter p-key-handle as handle     no-undo .
     2670     define input  parameter p-db-name    as character  no-undo .
     2671     define input  parameter p-tt-handle  as handle     no-undo .
     2672     define output parameter o-Where      as character  no-undo.
     2673     do
     2674     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2675     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     2676     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     2677     :
     2678       define variable v-full-tbl-name  as character no-undo .
     2679       define variable bh_tbl-name      as handle    no-undo .
     2680       define variable fh_key           as handle    no-undo .
     2681       define variable fh_search        as handle    no-undo .
     2682       define variable v-field-num      as integer   no-undo .
     2683       define variable v-count-fld      as integer   no-undo .
     2684       define variable v-inform         as character no-undo .
     2685       define variable v-ind            as integer   no-undo .
     2686       define variable v-idx-field-qnty as integer   no-undo .
     2687       define variable v-field-name     as character no-undo .
     2688       define variable v-field-val      as character no-undo .
     2689       define variable v-word-link      as character no-undo .
     2690       define variable vTable           as character no-undo.
     2691       define variable bh_tbl-key       as handle    no-undo .
     2692       assign
     2693         p-key-rec = trim( p-key-rec )
     2694       .
     2695       if p-key-handle <> ? then do:
     2696         if not valid-handle(p-key-handle)
     2697            or p-key-handle:type <> "buffer"
     2698         then do:
     2699           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info12 ).
     2700         end.
     2701         if num-entries( p-key-rec, chr(3) ) > 1
     2702           or p-key-rec = ?
     2703           or p-key-rec = "":U
     2704         then do:
     2705           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info12, p-key-rec ).
     2706         end.
     2707       end.
     2708       else do:
     2709         if p-key-rec = ?
     2710           or p-key-rec = "":U
     2711         then do:
     2712           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info12 ).
     2713         end.
     2714       end.
     2715       assign
     2716         vTable = entry( 1 , p-key-rec, chr(3) )
     2717       .
     2718       if p-tt-handle <> ?
     2719         and ( not valid-handle(p-tt-handle)
     2720               or p-tt-handle:type <> "buffer"
     2721             )
     2722       then do:
     2723         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info12, vTable, chr(10) ).
     2724       end.
     2725       if p-tt-handle = ? then do:
     2726         assign
     2727           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     2728         .
     2729         create buffer bh_tbl-name for table v-full-tbl-name .
     2730       end.
     2731       else do:
     2732         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     2733       end.
     2734       assign
     2735         v-inform = bh_tbl-name:index-information(1)
     2736         v-ind    = 2
     2737       .
     2738       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2739       on error undo, return error
     2740       :
     2741         assign
     2742           v-inform = bh_tbl-name:index-information( v-ind )
     2743           v-ind    = v-ind + 1
     2744         .
     2745       end.
     2746       if v-inform = ?
     2747         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2748         or entry( 3, v-inform, ",":U ) <> "1":U
     2749       then do:
     2750         delete object bh_tbl-name no-error.
     2751         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info12, vTable ).
     2752       end.
     2753       assign
     2754         v-idx-field-qnty = num-entries( v-inform ) - 4
     2755       .
     2756       if v-idx-field-qnty < 2 then do:
     2757         delete object bh_tbl-name no-error.
     2758         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info12, v-inform, vTable ).
     2759       end.
     2760       assign
     2761         o-where     = "where":U
     2762         v-word-link = "":U
     2763         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     2764         v-count-fld = 0
     2765       .
     2766       if i-tablekey ne "" and i-tablekey ne ?
     2767       then do:
     2768         assign
     2769           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     2770         .
     2771         create buffer bh_tbl-key for table v-full-tbl-name .
     2772       end.
     2773       if i-tableSerach ne "" and i-tableSerach ne ?
     2774       then do:
     2775         delete object bh_tbl-name no-error.
     2776         assign
     2777           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     2778         .
     2779         create buffer bh_tbl-name for table v-full-tbl-name .
     2780       end.
     2781       block_where:
     2782       do v-ind = 1 to v-idx-field-qnty by 2
     2783       on error undo, return error
     2784       :
     2785         assign
     2786           v-count-fld = v-count-fld + 1
     2787         .
     2788         if p-key-handle = ?
     2789           and v-count-fld > v-field-num
     2790         then do:
     2791           leave block_where.
     2792         end.
     2793         define variable VfieldKeyTable as handle no-undo.
     2794         assign
     2795           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     2796           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     2797         .
     2798         if     bh_tbl-key ne ?
     2799         then do:
     2800            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     2801            if VfieldKeyTable eq ?
     2802            then next block_where.
     2803         end.
     2804         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     2805         then
     2806            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     2807         else
     2808            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     2809         if p-key-handle = ? then do:
     2810           assign
     2811             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     2812           .
     2813         end.
     2814         else do:
     2815           assign
     2816             fh_key = p-key-handle:buffer-field( v-field-name )
     2817           .
     2818           if fh_key = ?
     2819             or not valid-handle( fh_key )
     2820           then do:
     2821             delete object bh_tbl-name.
     2822             if     bh_tbl-key ne ?
     2823             then
     2824                delete object bh_tbl-key.
     2825             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info12, p-key-handle:name, v-field-name ).
     2826           end.
     2827           assign
     2828             v-field-val = fh_key:buffer-value
     2829           .
     2830         end.
     2831         if fh_search:data-type ="character":U then do:
     2832           assign
     2833             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     2834             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     2835             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     2836             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     2837             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     2838             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     2839             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     2840             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     2841             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     2842             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     2843             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     2844             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     2845             v-field-val = substitute( '"&1"', v-field-val )
     2846           .
     2847         end.
     2848         assign
     2849           o-where = substitute( "&1 &2", o-where, v-field-val )
     2850         .
     2851         if v-word-link = "":U then do:
     2852           assign
     2853             v-word-link = "and":U
     2854           .
     2855         end.
     2856       end.
     2857       delete object bh_tbl-name.
     2858       if     bh_tbl-key ne ?
     2859       then
     2860          delete object bh_tbl-key.
     2861       if p-key-handle = ?
     2862         and v-count-fld <> v-field-num
     2863       then do:
     2864         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info12, vTable ).
     2865       end.
     2866     end.
     2867   end procedure.
     2868   procedure gen-hn-keyr-tab :
     2869     define input  parameter i-tableSerach as character no-undo.
     2870     define input  parameter i-tablekey   as character no-undo.
     2871     define input  parameter p-key-rec    as character no-undo.
     2872     define input  parameter p-key-handle as handle    no-undo .
     2873     define input  parameter p-db-name    as character no-undo .
     2874     define input  parameter p-tt-handle  as handle    no-undo .
     2875     define input  parameter p-stts-lock  as integer   no-undo .
     2876     define output parameter o-hn         as handle    no-undo.
     2877     define variable v-full-tbl-name as character no-undo.
     2878     define variable v-where         as character no-undo.
     2879     define variable bh_tbl-name     as handle    no-undo.
     2880     define variable vTable          as character no-undo.
     2881     do
     2882     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2883     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     2884     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     2885         run gen-where-keyr-tab(i-tableSerach,
     2886                                i-tablekey,
     2887                                p-key-rec,
     2888                                p-key-handle,
     2889                                p-db-name,
     2890                                p-tt-handle,
     2891                                output v-where).
     2892         if i-tableSerach ne "" and i-tableSerach ne ?
     2893         then do:
     2894            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     2895            create buffer bh_tbl-name for table v-full-tbl-name .
     2896         end.
     2897         else do:
     2898            if p-tt-handle = ? then do:
     2899               assign
     2900                  vTable = entry( 1 , p-key-rec, chr(3) )
     2901               .
     2902               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     2903               create buffer bh_tbl-name for table v-full-tbl-name .
     2904            end.
     2905            else do:
     2906               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     2907            end.
     2908         end.
     2909         if p-tt-handle = ? then do:
     2910            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     2911         end.
     2912         else do:
     2913            bh_tbl-name:find-first( v-where ) no-error .
     2914         end.
     2915         o-hn = bh_tbl-name.
     2916      end.
     2917   end procedure.
     2918   procedure gen-hn-keyr :
     2919     define input  parameter p-key-rec    as character no-undo.
     2920     define input  parameter p-key-handle as handle    no-undo .
     2921     define input  parameter p-db-name    as character no-undo .
     2922     define input  parameter p-tt-handle  as handle    no-undo .
     2923     define input  parameter p-stts-lock  as integer   no-undo .
     2924     define output parameter o-hn         as handle    no-undo.
     2925     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     2926   end.
     2927   procedure gen-row-keyr :
     2928     define input  parameter p-key-rec    as character no-undo.
     2929     define input  parameter p-key-handle as handle    no-undo .
     2930     define input  parameter p-db-name    as character no-undo .
     2931     define input  parameter p-tt-handle  as handle    no-undo .
     2932     define input  parameter p-stts-lock  as integer   no-undo .
     2933     define output parameter p-tbl-row    as rowid     no-undo.
     2934     define output parameter p-tbl-name   as character no-undo.
     2935     define variable vHn as handle no-undo.
     2936       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     2937       p-tbl-row = if vHn:available then vHn:rowid else ?.
     2938       p-tbl-name =  vHn:table.
     2939       delete object vHn no-error.
     2940     if p-tbl-row = ? then do:
     2941       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info12, p-tbl-name, p-key-rec ).
     2942     end.
     2943     else do:
     2944       return.
     2945     end.
     2946   end procedure.
     2947   procedure gen-key-fv :
     2948     define input  parameter p-key-rec    as character no-undo .
     2949     define output parameter p-field-list as character no-undo .
     2950     define output parameter p-value-list as character no-undo.
     2951     do
     2952     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2953     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     2954     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     2955     :
     2956       define variable v-full-tbl-name  as character no-undo .
     2957       define variable bh_tbl-name      as handle    no-undo .
     2958       define variable v-tbl-name       as character no-undo .
     2959       define variable v-field-num      as integer   no-undo .
     2960       define variable v-count-fld      as integer   no-undo .
     2961       define variable v-inform         as character no-undo .
     2962       define variable v-ind            as integer   no-undo .
     2963       define variable v-idx-field-qnty as integer   no-undo .
     2964       define variable v-delim-key      as character no-undo .
     2965       if p-key-rec = ?
     2966         or p-key-rec = "":U
     2967       then do:
     2968         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info12 ).
     2969       end.
     2970       assign
     2971         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     2972         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     2973       .
     2974       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     2975       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info12 ).
     2976       assign
     2977         v-inform = bh_tbl-name:index-information(1)
     2978         v-ind    = 2
     2979       .
     2980       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2981       on error undo, return error
     2982       :
     2983         assign
     2984           v-inform = bh_tbl-name:index-information( v-ind )
     2985           v-ind    = v-ind + 1
     2986         .
     2987       end.
     2988       if v-inform = ?
     2989         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2990         or entry( 3, v-inform, ",":U ) <> "1":U
     2991       then do:
     2992         delete object bh_tbl-name no-error.
     2993         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info12, v-tbl-name ).
     2994       end.
     2995       assign
     2996         v-idx-field-qnty = num-entries( v-inform ) - 4
     2997       .
     2998       if v-idx-field-qnty < 2 then do:
     2999         delete object bh_tbl-name no-error.
     3000         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info12, v-inform, v-tbl-name ).
     3001       end.
     3002       assign
     3003         p-field-list = "":U
     3004         p-value-list = "":U
     3005         v-delim-key  = "":U
     3006         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     3007         v-count-fld  = 0
     3008       .
     3009       block_where:
     3010       do v-ind = 1 to v-idx-field-qnty by 2
     3011       on error undo, return error
     3012       :
     3013         assign
     3014           v-count-fld = v-count-fld + 1
     3015         .
     3016         if v-count-fld > v-field-num then do:
     3017           leave block_where.
     3018         end.
     3019         assign
     3020           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     3021           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     3022         .
     3023         if v-ind = 1 then do:
     3024           assign
     3025             v-delim-key = chr(3)
     3026           .
     3027         end.
     3028       end.
     3029       delete object bh_tbl-name.
     3030       if v-count-fld <> v-field-num then do:
     3031         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info12, v-tbl-name ).
     3032       end.
     3033     end.
     3034   end procedure.
     3035   procedure gen-key-field :
     3036     define input  parameter p-table      as character no-undo .
     3037     define output parameter p-field-list as character no-undo .
     3038     do
     3039     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3040     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     3041     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     3042     :
     3043       define variable v-full-tbl-name  as character no-undo .
     3044       define variable bh_tbl-name      as handle    no-undo .
     3045       define variable v-tbl-name       as character no-undo .
     3046       define variable v-field-num      as integer   no-undo .
     3047       define variable v-count-fld      as integer   no-undo .
     3048       define variable v-inform         as character no-undo .
     3049       define variable v-ind            as integer   no-undo .
     3050       define variable v-idx-field-qnty as integer   no-undo .
     3051       define variable v-delim-key      as character no-undo .
     3052       if p-table = ?
     3053         or p-table = "":U
     3054       then do:
     3055         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info12 ).
     3056       end.
     3057       assign
     3058         v-tbl-name      = p-table
     3059         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     3060       .
     3061       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     3062       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info12 ).
     3063       assign
     3064         v-inform = bh_tbl-name:index-information(1)
     3065         v-ind    = 2
     3066       .
     3067       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     3068       on error undo, return error
     3069       :
     3070         assign
     3071           v-inform = bh_tbl-name:index-information( v-ind )
     3072           v-ind    = v-ind + 1
     3073         .
     3074       end.
     3075       if v-inform = ?
     3076         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     3077         or entry( 3, v-inform, ",":U ) <> "1":U
     3078       then do:
     3079         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info12, v-tbl-name ).
     3080       end.
     3081       assign
     3082         v-idx-field-qnty = num-entries( v-inform ) - 4
     3083       .
     3084       if v-idx-field-qnty < 2 then do:
     3085         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info12, v-inform, v-tbl-name ).
     3086       end.
     3087       assign
     3088         p-field-list = "":U
     3089         v-delim-key  = "":U
     3090         v-count-fld  = 0
     3091       .
     3092       block_where:
     3093       do v-ind = 1 to v-idx-field-qnty by 2
     3094       on error undo, return error
     3095       :
     3096         assign
     3097           v-count-fld = v-count-fld + 1
     3098         .
     3099         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     3100         if v-ind = 1 then do:
     3101           assign
     3102             v-delim-key = chr(3)
     3103           .
     3104         end.
     3105       end.
     3106       delete object bh_tbl-name.
     3107     end.
     3108   end procedure.
