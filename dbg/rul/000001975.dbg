     3778                         (IF LENGTH(temp-firm.city) > 23 then " поле <<Город>> " else "") +
     3779                         (IF temp-firm.ind > 999999 then " поле <<ПОЧТОВЫЙ ИНДЕКС>> " else "") +
     3780                         (IF length(temp-firm.inn) > 21 then " поле <<ИНН>> " else "") +
     3781                         (IF length(temp-firm.okonh) > 120 then " поле <<ОКОНХ>> " else "") +
     3782                         (IF length(temp-firm.okpo) > 10 then  " поле <<ОКПО>> " else "") +
     3783                         (IF length(temp-firm.kpp) > 9 then  " поле <<КПП>> " else "") +
     3784                         (IF length(temp-firm.addres1) > 30 then "поле <<ЮРИДИЧЕСКИЙ АДРЕС 1>> " else "") +
     3785                         (IF length(temp-firm.addres2) > 30 then "поле <<ЮРИДИЧЕСКИЙ АДРЕС 2>> " else "") +
     3786                         (IF length(temp-firm.post-addr1) > 50 then " <<ПОЧТОВЫЙ АДРЕС 1>> " else "") +
     3787                         (IF length(temp-firm.post-addr2) > 50 then " <<ПОЧТОВЫЙ АДРЕС 2>> " else "") +
     3788                         (IF length(temp-firm.phone) > 20 then " <<N ТЕЛЕФОНА>> " else "") +
     3789                         (IF length(temp-firm.phone1-note) > 10 then  " <<Примечания к N ТЕЛЕФОНА>> " else "") +
     3790                         (IF length(temp-firm.fax) > 20 then " <<N ФАКСА> " else "") +
     3791                         (IF length(temp-firm.telex) > 20 then " <<N ТЕЛЕКСА>> " else "") +
     3792                         (IF length(temp-firm.e-mail) > 100 then " <<E-mail>> " else "") +
     3793                         (IF length(temp-firm.director) >  25 then  " <<Руководитель>> " else "") +
     3794                         (IF length(temp-firm.contact-psn) > 50 then " <<Контактное лицо>> " else "") +
     3795                         (IF length(temp-firm.engl-name) > 140 then  " <<Английское название>> " else "")
     3796             my-mess = "Длина поля " + my-mess + " больше разрешенной"
     3797             .
     3798             run display-intelli-log in this-procedure ( input substitute("&1&2,&3,false,&4", my-obj-type, my-obj-code, my-parus-2-code, my-mess)).
     3799             run err-write in this-procedure ( input-output my-mess).
     3800             next _stroka.
     3801           END.
     3802          if temp-firm.inn <> "":U then do:
     3803            run gbl/keyinn.p ( input temp-firm.inn, input 'орг':U, input 0, input temp-firm.is-pboul, output v-correct-inn).
     3804             if not v-correct-INN then do:
     3805               assign
     3806               v-return-value = return-value.
     3807               run display-intelli-log in this-procedure ( input substitute("&1&2,&3,false,&4", my-obj-type, my-obj-code, my-parus-2-code, my-mess)).
     3808               run err-write in this-procedure  ( input-output v-return-value).
     3809               next _stroka.
     3810             end.
     3811          end.
     3812         END.
     3813         WHEN 'чел':U then do:
     3814           find first buf_rule-call-param where
     3815                   buf_rule-call-param.codex_id = p-codex-id
     3816                   and buf_rule-call-param.ruleset_id = p-ruleset-id
     3817                   and buf_rule-call-param.call_id = p-call-id
     3818                   and buf_rule-call-param.order_id = p-order-id
     3819                   and buf_rule-call-param.rule_id = p-rule-id
     3820                   and buf_rule-call-param.param-name = "p-person-fields"
     3821                   and buf_rule-call-param.param-value-character = "person.firm-code" no-error.
     3822            if available buf_rule-call-param then do:
     3823             assign
     3824             temp-person.firm-code = integer(n-entry[buf_rule-call-param.p-index])
     3825             no-error
     3826             .
     3827             if error-status:error then do:
     3828               my-mess = "Поле <<КОД ФИРМЫ>> должно быть неотрицательным целым числом".
     3829               run display-intelli-log in this-procedure ( input substitute("&1&2,&3,false,&4", my-obj-type, my-obj-code, my-parus-2-code, my-mess)).
     3830               run err-write in this-procedure ( input-output my-mess).
     3831               next _stroka.
     3832             end.
     3833           end.
     3834           find first buf_rule-call-param where
     3835                   buf_rule-call-param.codex_id = p-codex-id
     3836                   and buf_rule-call-param.ruleset_id = p-ruleset-id
     3837                   and buf_rule-call-param.call_id = p-call-id
     3838                   and buf_rule-call-param.order_id = p-order-id
     3839                   and buf_rule-call-param.rule_id = p-rule-id
     3840                   and buf_rule-call-param.param-name = "p-person-fields"
     3841                   and buf_rule-call-param.param-value-character = "person.ind" no-error.
     3842            if available buf_rule-call-param then do:
     3843             assign
     3844             temp-person.ind = integer(n-entry[buf_rule-call-param.p-index])
     3845             no-error
     3846             .
     3847             if error-status:error then do:
     3848               my-mess = "Поле <<ПОЧТОВЫЙ ИНДЕКС>> должно быть неотрицательным целым числом".
     3849               run display-intelli-log in this-procedure ( input substitute("&1&2,&3,false,&4", my-obj-type, my-obj-code, my-parus-2-code, my-mess)).
     3850               run err-write in this-procedure ( input-output my-mess).
     3851               next _stroka.
