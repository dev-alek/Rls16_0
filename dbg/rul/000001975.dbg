     4028               run err-write in this-procedure ( input-output v-return-value).
     4029               next _stroka.
     4030             end.
     4031          end.
     4032         END.
     4033       END CASE.
     4034       if my-parus-2-code <> ''
     4035       and create-client
     4036       then do:
     4037         find first buf_ext-classif no-lock where
     4038                   buf_Ext-classif.classif-subject = 'clients':U
     4039             and buf_ext-classif.classif-name = 'exp-parus-2-code':U
     4040             and buf_ext-classif.db-num = -1
