     3879                       buffer temp-person:handle:buffer-field(entry(2, buf_rule-call-param.param-value-character, ".")):buffer-value =
     3880                       decimal(n-entry[buf_rule-call-param.p-index]).
     3881                     end.
     3882                     when 'logical':U then do:
     3883                       assign
     3884                       buffer temp-person:handle:buffer-field(entry(2, buf_rule-call-param.param-value-character, ".")):buffer-value =
     3885                       logical(n-entry[buf_rule-call-param.p-index]).
     3886                     end.
     3887                   end case.
     3888                 end.
     3889                 when 'clients':U then do:
     3890                   assign
     3891                   my-data-type = buffer temp-clients:handle:buffer-field(entry(2, buf_rule-call-param.param-value-character, ".")):data-type.
     3892                   case my-data-type:
     3893                     when 'character':U then do:
     3894                       assign
     3895                       buffer temp-clients:handle:buffer-field(entry(2, buf_rule-call-param.param-value-character, ".")):buffer-value =
     3896                       n-entry[buf_rule-call-param.p-index].
     3897                     end.
     3898                     when 'integer':U then do:
     3899                       assign
     3900                       buffer temp-clients:handle:buffer-field(entry(2, buf_rule-call-param.param-value-character, ".")):buffer-value =
     3901                       integer(n-entry[buf_rule-call-param.p-index]).
     3902                     end.
