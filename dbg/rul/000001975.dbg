     3905                       buffer temp-clients:handle:buffer-field(entry(2, buf_rule-call-param.param-value-character, ".")):buffer-value =
     3906                       decimal(n-entry[buf_rule-call-param.p-index]).
     3907                     end.
     3908                     when 'logical':U then do:
