     3679                     when 'decimal':U then do:
     3680                       assign
     3681                       buffer temp-clients:handle:buffer-field(entry(2, buf_rule-call-param.param-value-character, ".")):buffer-value =
     3682                       decimal(n-entry[buf_rule-call-param.p-index]).
