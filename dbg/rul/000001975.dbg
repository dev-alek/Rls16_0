     3856                   and buf_rule-call-param.ruleset_id = p-ruleset-id
     3857                   and buf_rule-call-param.call_id = p-call-id
     3858                   and buf_rule-call-param.order_id = p-order-id
     3859                   and buf_rule-call-param.rule_id = p-rule-id
     3860                   and buf_rule-call-param.param-name = "p-person-fields"
     3861                   and buf_rule-call-param.param-value-character > '':
     3862               case entry(1, buf_rule-call-param.param-value-character, "."):
     3863                 when 'person':U then do:
     3864                   assign
     3865                   my-data-type = buffer temp-person:handle:buffer-field(entry(2, buf_rule-call-param.param-value-character, ".")):data-type.
     3866                   case my-data-type:
