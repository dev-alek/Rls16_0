     3512         run display-intelli-log in this-procedure ( input substitute("&1&2,&3,false,&4", my-obj-type, my-obj-code, my-parus-2-code, my-mess)).
     3513         run err-write in this-procedure ( input-output my-mess).
     3514         next _stroka.
     3515       end.
     3516       CASE my-obj-type:
     3517         when 'орг':U then do:
     3518           create temp-clients.
     3519           assign
     3520           temp-clients.obj-type = 'орг':U
     3521           temp-clients.obj-name = my-obj-name
     3522           temp-clients.obj-code = my-obj-code
     3523           .
     3524           create temp-firm.
     3525           temp-firm.firm-code = my-obj-code.
     3526             if NUM-entries(ss, mydelimiter) <> firm-fields then do:
     3527               my-mess = substitute("Количество полей в строке импорта клиентов типа <<&1>>&2" +
     3528                                    "согласно определенному Вами формату должно быть равно &3"
     3529                                     ,'орг':U
     3530                                     ,chr(10)
     3531                                     ,firm-fields).
     3532               run display-intelli-log in this-procedure ( input substitute("&1&2,&3,false,&4", my-obj-type, my-obj-code, my-parus-2-code, my-mess)).
     3533               run err-write in this-procedure ( input-output my-mess).
     3534               next _stroka.
     3535             end.
     3536         end.
     3537         when 'чел':U then do:
     3538           create temp-clients.
     3539           assign
     3540           temp-clients.obj-type = 'чел':U
     3541           temp-clients.obj-name = my-obj-name
     3542           temp-clients.obj-code = my-obj-code
     3543           .
     3544           create temp-person.
     3545           temp-person.psn-code = my-obj-code
     3546           .
     3547           if NUM-entries(ss, mydelimiter)  <> person-fields then do:
     3548             my-mess = substitute("Количество полей в строке импорта клиентов типа <<&1>>&2" +
     3549                                   "согласно определенному Вами формату должно быть равно "
     3550                                 ,'чел':U
     3551                                 ,chr(10)
     3552                                 ,person-fields
     3553                                 ).
     3554             run display-intelli-log in this-procedure ( input substitute("&1&2,&3,false,&4", my-obj-type, my-obj-code, my-parus-2-code, my-mess)).
     3555             run err-write in this-procedure ( input-output my-mess).
     3556             next _stroka.
     3557           end.
     3558         end.
     3559       END cASE.
     3560       if my-obj-code = 0 then
     3561       create-client = yes.
     3562       else create-client = no.
     3563       v-check-dupl = no.
     3564       v-check-inn-kpp = no.
     3565       if create-client then do:
     3566         case uniq-method:
     3567           when "obj-name" then do:
     3568             FIND FIRST ub.clients no-lock where
     3569                       ub.clients.obj-name = my-obj-name
     3570                   and ub.clients.obj-type = my-obj-type NO-ERROR.
     3571             if avail ub.clients then do:
     3572               if ub.clients.obj-type = 'орг':U then do:
     3573                 my-mess = substitute("Уже есть клиент с названием <<&1>>", my-obj-name).
     3574                 run display-intelli-log in this-procedure ( input substitute("&1&2,&3,false,&4", my-obj-type, my-obj-code, my-parus-2-code, my-mess)).
     3575                 run err-write in this-procedure ( input-output my-mess).
     3576                 next _stroka.
     3577               end.
     3578               else do:
     3579                 v-check-dupl = yes.
     3580               end.
     3581             end.
     3582           end.
     3583           when "inn+kpp" then do:
     3584             v-check-inn-kpp = yes.
     3585           end.
     3586         end case.
     3587       end.
     3588       CASE my-obj-type:
     3589         WHEN 'орг':U then do:
     3590           find first buf_rule-call-param where
     3591                   buf_rule-call-param.codex_id = p-codex-id
     3592                   and buf_rule-call-param.ruleset_id = p-ruleset-id
     3593                   and buf_rule-call-param.call_id = p-call-id
     3594                   and buf_rule-call-param.order_id = p-order-id
     3595                   and buf_rule-call-param.rule_id = p-rule-id
     3596                   and buf_rule-call-param.param-name = "p-firm-fields"
     3597                   and buf_rule-call-param.param-value-character = "firm.tobj-code" no-error.
     3598            if available buf_rule-call-param then do:
     3599             assign
     3600             temp-firm.tobj-code = integer(n-entry[buf_rule-call-param.p-index])
     3601             no-error
     3602             .
     3603             if error-status:error then do:
     3604               my-mess = "Поле <<КОД ТОРГОВОГО ПРЕДСТАВИТЕЛЯ>> должно быть неотрицательным целым числом".
     3605               run display-intelli-log in this-procedure ( input substitute("&1&2,&3,false,&4", my-obj-type, my-obj-code, my-parus-2-code, my-mess)).
     3606               run err-write in this-procedure ( input-output my-mess).
     3607               next _stroka.
     3608             end.
     3609           end.
     3610           find first buf_rule-call-param where
     3611                   buf_rule-call-param.codex_id = p-codex-id
     3612                   and buf_rule-call-param.ruleset_id = p-ruleset-id
     3613                   and buf_rule-call-param.call_id = p-call-id
     3614                   and buf_rule-call-param.order_id = p-order-id
     3615                   and buf_rule-call-param.rule_id = p-rule-id
     3616                   and buf_rule-call-param.param-name = "p-firm-fields"
     3617                   and buf_rule-call-param.param-value-character = "firm.ind" no-error.
     3618           IF available buf_rule-call-param then do:
     3619             assign
     3620             temp-firm.ind = integer(n-entry[buf_rule-call-param.p-index])
     3621             no-error
     3622             .
     3623             if error-status:error then do:
     3624               my-mess = "Поле <<ПОЧТОВЫЙ ИНДЕКС>> должно быть неотрицательным целым числом".
     3625               run display-intelli-log in this-procedure ( input substitute("&1&2,&3,false,&4", my-obj-type, my-obj-code, my-parus-2-code, my-mess)).
     3626               run err-write in this-procedure ( input-output my-mess).
     3627               next _stroka.
     3628             end.
     3629           end.
     3630           for each  buf_rule-call-param where
     3631                   buf_rule-call-param.codex_id = p-codex-id
     3632                   and buf_rule-call-param.ruleset_id = p-ruleset-id
     3633                   and buf_rule-call-param.call_id = p-call-id
     3634                   and buf_rule-call-param.order_id = p-order-id
     3635                   and buf_rule-call-param.rule_id = p-rule-id
     3636                   and buf_rule-call-param.param-name = "p-firm-fields"
     3637                   and buf_rule-call-param.param-value-character > '':
     3638               case entry(1, buf_rule-call-param.param-value-character, "."):
     3639                 when 'firm':U then do:
     3640                   assign
     3641                   my-data-type = buffer temp-firm:handle:buffer-field(entry(2, buf_rule-call-param.param-value-character, ".")):data-type.
     3642                   case my-data-type:
     3643                     when 'character':U then do:
     3644                       assign
     3645                       buffer temp-firm:handle:buffer-field(entry(2, buf_rule-call-param.param-value-character, ".")):buffer-value =
     3646                       n-entry[buf_rule-call-param.p-index].
     3647                     end.
     3648                     when 'integer':U then do:
     3649                       assign
     3650                       buffer temp-firm:handle:buffer-field(entry(2, buf_rule-call-param.param-value-character, ".")):buffer-value =
     3651                       integer(n-entry[buf_rule-call-param.p-index]).
     3652                     end.
     3653                     when 'decimal':U then do:
     3654                       assign
     3655                       buffer temp-firm:handle:buffer-field(entry(2, buf_rule-call-param.param-value-character, ".")):buffer-value =
     3656                       decimal(n-entry[buf_rule-call-param.p-index]).
     3657                     end.
     3658                     when 'logical':U then do:
     3659                       assign
