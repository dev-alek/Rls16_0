     3706                                               ,input p-profile-id
     3707                                               ,input p-once-more
     3708                                               ,output t-rule-trn-in ).
     3709   run rcps_get-rule-on-off in this-procedure ( input 2
     3710                                               ,input 5
     3711                                               ,input 1663
     3712                                               ,input p-profile-id
     3713                                               ,input p-once-more
     3714                                               ,output t-rule-recalc ).
     3715   if f-rule-num > 0 then do:
     3716   find first buf_dis-rule no-lock where
     3717           buf_dis-rule.rule-num = f-rule-num no-error.
     3718   end.
     3719   ASSIGN
     3720   term_tt-rule-call-param.param-label:RESIZABLE IN browse br-rcp = YES
     3721   X_rp-rule-param.rp-param-name:RESIZABLE IN browse br-rcp = YES
     3722   .
     3723   DEFINE VARIABLE v-ch0 AS widget-handle NO-UNDO.
     3724   ASSIGN
     3725   v-ch0 = br-rcp:FIRST-COLUMN IN FRAME Dialog-Frame.
     3726   REPEAT WHILE valid-handle(v-ch0):
     3727      IF v-ch0:LABEL = "Значение!(строковое)" THEN DO:
     3728        v-ch[1] = v-ch0.
     3729        v-ch0:VISIBLE = NO.
     3730      END.
     3731      IF v-ch0:LABEL = "Значение!(Дата)" THEN DO:
     3732        v-ch[2] = v-ch0.
     3733        v-ch0:VISIBLE = NO.
     3734      END.
     3735      IF v-ch0:LABEL = "Значение!(Десятичное)" THEN DO:
     3736        v-ch[3] = v-ch0.
     3737        v-ch0:VISIBLE = NO.
     3738      END.
     3739      IF v-ch0:LABEL = "Значение!(Целое)" THEN DO:
     3740        v-ch[4] = v-ch0.
     3741        v-ch0:VISIBLE = NO.
     3742      END.
     3743      IF v-ch0:LABEL = "Значение!(Логическое)" THEN DO:
     3744        v-ch[5] = v-ch0.
     3745        v-ch0:VISIBLE = NO.
     3746      END.
     3747      IF v-ch0:LABEL = "Точка вызова" THEN DO:
     3748        v-ch[6] = v-ch0.
     3749      END.
     3750      IF v-ch0:LABEL = "Значение" THEN
     3751      v-ch0:RESIZABLE = YES.
     3752      v-ch0 = v-ch0:NEXT-COLUMN.
     3753   END.
     3754   assign
     3755   X_rp-rule-param.rp-param-name:resizable in browse br-rcp = yes
     3756   term_tt-rule-call-param.param-name:resizable in browse br-rcp = yes
     3757   term_tt-rule-call-param.param-label:resizable in browse br-rcp = yes
     3758   .
     3759   CASE p-list-mode:
     3760     WHEN 'rule-call-param':U THEN DO:
     3761        ASSIGN
     3762        X_rp-rule-param.rp-param-name:VISIBLE IN BROWSE br-rcp = NO
     3763        .
     3764     END.
     3765     WHEN 'rp-rule-param':U
     3766     or
     3767     when 'rp-rule-param':U + chr(44) + 'все':U
     3768     THEN DO:
     3769       assign
     3770       term_tt-rule-call-param.codex_id:VISIBLE IN BROWSE br-rcp = NO
     3771       term_tt-rule-call-param.ruleset_id:VISIBLE IN BROWSE br-rcp = NO
     3772       term_tt-rule-call-param.rule_id:VISIBLE IN BROWSE br-rcp = NO
     3773       term_tt-rule-call-param.order_id:VISIBLE IN BROWSE br-rcp = NO
     3774       term_tt-rule-call-param.param-name:VISIBLE IN BROWSE br-rcp = NO
     3775       term_tt-rule-call-param.param-num:VISIBLE IN BROWSE br-rcp = NO
     3776       .
     3777     END.
     3778   END CASE.
     3779    IF p-call-id <> '':U THEN DO:
     3780      v-ch[6]:VISIBLE = NO.
     3781    END.
     3782     IF p-profile-id <> 0 THEN DO:
     3783      term_tt-rule-call-param.profile_id :VISIBLE IN BROWSE br-rcp= NO.
     3784    END.
     3785     IF p-rule-id <> 0 THEN DO:
     3786      term_tt-rule-call-param.RULE_id :VISIBLE IN BROWSE br-rcp= NO.
     3787    END.
     3788     IF p-once-more <> 0 THEN DO:
     3789      term_tt-rule-call-param.once-more :VISIBLE IN BROWSE br-rcp= NO.
     3790   END.
     3791   display
     3792   t-is-over
     3793   rs-r-b
     3794   f-rule-num
     3795   f-sum-id
     3796   f-tot-sum-id-sgd
     3797   l-r-b
     3798   (if available buf_dis-rule then buf_dis-rule.des else "Не найдено правило скидки!!!") @ f-dis-rule-name
     3799   e-rules
     3800   T-rule-recalc
     3801   T-rule-sale-in
     3802   T-rule-sale-out
     3803   T-rule-trn-in
     3804   T-rule-trn-out
     3805   with frame Dialog-Frame .
     3806   VIEW FRAME Dialog-Frame.
     3807   e-rules:read-only in frame Dialog-Frame .
     3808   ENABLE
     3809   br-dis-gds-rule
     3810   rs-r-b WHEN p-mode <> 'ПРОСМОТР':U
     3811   b-dis-rule WHEN p-mode <> 'ПРОСМОТР':U
     3812   b-sum-id WHEN p-mode <> 'ПРОСМОТР':U
     3813   b-tot-sum-id-sgd WHEN p-mode <> 'ПРОСМОТР':U
     3814   t-is-over WHEN p-mode <> 'ПРОСМОТР':U
     3815   b-dis-gds-add WHEN p-mode <> 'ПРОСМОТР':U
     3816   b-dis-gds-delete WHEN p-mode <> 'ПРОСМОТР':U
     3817   B-exit WHEN p-mode <> 'ПРОСМОТР':U
     3818   T-rule-recalc  WHEN p-mode <> 'ПРОСМОТР':U
     3819   T-rule-sale-in  WHEN p-mode <> 'ПРОСМОТР':U
     3820   T-rule-sale-out  WHEN p-mode <> 'ПРОСМОТР':U
     3821   T-rule-trn-in  WHEN p-mode <> 'ПРОСМОТР':U
     3822   T-rule-trn-out WHEN p-mode <> 'ПРОСМОТР':U
     3823   b-quit
     3824   e-rules
     3825   WITH FRAME Dialog-Frame.
     3826   VIEW FRAME Dialog-Frame.
     3827   IF p-mode = 'ПРОСМОТР':U THEN DO:
     3828      ASSIGN
     3829      b-quit:COLUMN = 1
     3830      b-quit:LABEL = "&Выход".
     3831      HIDE
     3832      b-exit
     3833      IN FRAME Dialog-Frame.
     3834   END.
     3835   ASSIGN
     3836   FRAME Dialog-Frame:TITLE = substitute("Параметры Алгоритма СУММА НАКОПЛЕНИЙ по выборке товаров -> КАТЕГОРИЯ СКИДКИ (профайл &1)", p-profile-id).
     3837   OPEN QUERY br-dis-gds-rule FOR EACH gds_tt-rule-call-param where              gds_tt-rule-call-param.param-name = "p-rule-nums"          and gds_tt-rule-call-param.rule_id = 1735          and gds_tt-rule-call-param.codex_id = 1          and gds_tt-rule-call-param.ruleset_id = 1          and gds_tt-rule-call-param.p-index > 0,            FIRST X_dis-rule NO-LOCK WHERE X_dis-rule.rule-num = gds_tt-rule-call-param.param-value-integer .
     3838   END PROCEDURE.
     3839   PROCEDURE proc-b-add :
     3840   define input parameter p-rule-param-name as character no-undo.
     3841   define input parameter p-rp-param-name as character no-undo.
     3842   define input parameter p-codex-id as integer no-undo.
     3843   define input parameter p-ruleset-id as integer no-undo.
     3844   define input parameter p-rule-id as integer no-undo.
     3845   define buffer buf_tt-rule-call-param for tt-rule-call-param.
     3846   define variable v-ii as integer no-undo .
     3847   do v-ii = 1 to 99999:
     3848     find first buf_tt-rule-call-param where
     3849             buf_tt-rule-call-param.param-name = p-rule-param-name
     3850         and buf_tt-rule-call-param.rule_id = p-rule-id
     3851         and buf_tt-rule-call-param.codex_id = p-codex-id
     3852         and buf_tt-rule-call-param.ruleset_id = p-ruleset-id
     3853         and buf_tt-rule-call-param.p-index = v-ii no-error.
     3854     if not available buf_tt-rule-call-param then do:
     3855       v-gds-index = v-ii.
     3856       leave.
     3857     end.
     3858   end.
     3859   run rcps_proc-b-add in this-procedure (
     3860                                           input p-profile-id
     3861                                           ,INPUT p-once-more
     3862                                           ,input p-call-id
     3863                                           ,input p-rp-param-name
     3864                                           ,input v-gds-index ) no-error.
     3865   if error-status:error then return error.
     3866   find first TERM_tt-rule-call-param where
     3867             TERM_tt-rule-call-param.param-name = p-rule-param-name
     3868       and term_tt-rule-call-param.rule_id = p-rule-id
     3869       and term_tt-rule-call-param.codex_id = p-codex-id
     3870       and term_tt-rule-call-param.ruleset_id = p-ruleset-id
     3871       and term_tt-rule-call-param.p-index = v-ii .
     3872   run proc-b-chg in this-procedure ( input p-rp-param-name ) no-error.
     3873   if error-status:error then do:
     3874     delete term_tt-rule-call-param.
     3875     return error.
     3876   end.
     3877   END PROCEDURE.
     3878   PROCEDURE proc-b-chg :
     3879   define input parameter p-rp-param-name as character no-undo.
     3880   DEFINE VARIABLE v-format AS CHARACTER NO-UNDO.
     3881   DEFINE VARIABLE v-value-character AS CHARACTER NO-UNDO.
     3882   DEFINE VARIABLE v-value-integer AS integer NO-UNDO.
     3883   DEFINE VARIABLE v-value-decimal AS decimal NO-UNDO.
     3884   DEFINE VARIABLE v-value-logical AS logical NO-UNDO.
     3885   DEFINE VARIABLE v-value-date AS date NO-UNDO.
     3886   define variable v-ok as logical no-undo .
     3887   define buffer dbl_tt-rule-call-param for tt-rule-call-param.
     3888   assign
     3889   v-value-character = term_tt-rule-call-param.param-value-character
     3890   v-value-date = term_tt-rule-call-param.param-value-date
     3891   v-value-decimal = term_tt-rule-call-param.param-value-decimal
     3892   v-value-integer = term_tt-rule-call-param.param-value-integer
     3893   v-value-logical = term_tt-rule-call-param.param-value-logical
     3894   .
     3895   run ref/rule-dtt.p (
     3896                        input parparentproc
     3897                       ,input 'ИЗМЕНЕНИЕ':U
     3898                       ,input p-call-id
     3899                       ,input term_tt-rule-call-param.param-data-type
     3900                       ,input term_tt-rule-call-param.param-2-data-type
     3901                       ,input term_tt-rule-call-param.param-3-data-type
     3902                       ,input term_tt-rule-call-param.p-index
     3903                       ,input-output v-value-character
     3904                       ,input-output v-value-date
     3905                       ,input-output v-value-decimal
     3906                       ,input-output v-value-integer
     3907                       ,input-output v-value-logical
     3908                       ,output v-ok
     3909                       ) no-error.
     3910   if not error-status:error
     3911   and v-ok then do:
     3912     find first dbl_tt-rule-call-param where
     3913               dbl_tt-rule-call-param.rule_id = term_tt-rule-call-param.rule_id
     3914           and dbl_tt-rule-call-param.param-value-integer = v-value-integer
     3915           and dbl_tt-rule-call-param.p-index <> term_tt-rule-call-param.p-index no-error.
     3916     if available dbl_tt-rule-call-param then do:
     3917       message
     3918       substitute("Вы уже выбирали это правило скидки")
     3919       view-as alert-box error .
     3920       return error.
     3921     end.
     3922     define variable v-mess as character no-undo .
     3923     RUN set-value IN THIS-PROCEDURE (
     3924                                      INPUT term_tt-rule-call-param.profile_id
     3925                                     ,INPUT term_tt-rule-call-param.once-more
     3926                                     ,INPUT (if p-list-mode = 'rp-rule-param':U
     3927                                            then p-rp-param-name
     3928                                            else '':U)
     3929                                     ,INPUT term_tt-rule-call-param.call_id
     3930                                     ,INPUT term_tt-rule-call-param.codex_id
     3931                                     ,INPUT term_tt-rule-call-param.ruleset_id
     3932                                     ,INPUT term_tt-rule-call-param.order_id
     3933                                     ,INPUT term_tt-rule-call-param.param-name
     3934                                     ,INPUT term_tt-rule-call-param.p-index
     3935                                      ,INPUT v-value-character
     3936                                      ,INPUT v-value-date
     3937                                      ,INPUT v-value-decimal
     3938                                      ,INPUT v-value-integer
     3939                                      ,INPUT v-value-logical).
     3940   end.
     3941   else do:
     3942     return error.
     3943   end.
     3944   END PROCEDURE.
     3945   PROCEDURE proc-save :
     3946   define variable v-ii as integer   no-undo .
     3947   v-ii = 0.
     3948   assign
     3949   frame Dialog-Frame
     3950   t-is-over
     3951   T-rule-recalc
     3952   T-rule-sale-in
     3953   T-rule-sale-out
     3954   T-rule-trn-in
     3955   T-rule-trn-out
     3956   f-rule-num
     3957   f-sum-id
     3958   f-tot-sum-id-sgd
     3959   rs-r-b
     3960   .
     3961   run rcps_set-rule-on-off in this-procedure ( input 2
     3962                                              ,input 1
     3963                                              ,input 1663
     3964                                              ,input p-profile-id
     3965                                              ,input p-once-more
     3966                                              ,input t-rule-sale-out).
     3967   run rcps_set-rule-on-off in this-procedure ( input 2
     3968                                               ,input 2
     3969                                               ,input 1663
     3970                                               ,input p-profile-id
     3971                                               ,input p-once-more
     3972                                               ,input t-rule-sale-in ).
     3973   run rcps_set-rule-on-off in this-procedure ( input 2
     3974                                               ,input 3
     3975                                               ,input 1663
     3976                                               ,input p-profile-id
     3977                                               ,input p-once-more
     3978                                               ,input t-rule-trn-out ).
     3979   run rcps_set-rule-on-off in this-procedure ( input 2
     3980                                               ,input 4
     3981                                               ,input 1663
     3982                                               ,input p-profile-id
     3983                                               ,input p-once-more
     3984                                               ,input t-rule-trn-in ).
     3985   run rcps_set-rule-on-off in this-procedure ( input 2
     3986                                               ,input 5
     3987                                               ,input 1663
     3988                                               ,input p-profile-id
     3989                                               ,input p-once-more
     3990                                               ,input t-rule-recalc ).
     3991   RUN rcps_set-value IN THIS-PROCEDURE (
     3992                                   INPUT p-profile-id
     3993                                   ,INPUT p-once-more
     3994                                   ,INPUT p-call-id
     3995                                   ,INPUT "p-is-over"
     3996                                   ,INPUT 0
     3997                                   ,INPUT ''
     3998                                   ,INPUT ?
     3999                                   ,INPUT 0.0
     4000                                   ,INPUT 0
     4001                                   ,INPUT t-is-over
     4002                                   ).
     4003   RUN rcps_set-value IN THIS-PROCEDURE (
     4004                                   INPUT p-profile-id
     4005                                   ,INPUT p-once-more
     4006                                   ,INPUT p-call-id
     4007                                   ,INPUT "p-r-b"
     4008                                   ,INPUT 0
     4009                                   ,INPUT rs-r-b
     4010                                   ,INPUT ?
     4011                                   ,INPUT 0.0
     4012                                   ,INPUT 0
     4013                                   ,INPUT no
     4014                                   ).
     4015   RUN rcps_set-value IN THIS-PROCEDURE (
     4016                                   INPUT p-profile-id
     4017                                   ,INPUT p-once-more
     4018                                   ,INPUT p-call-id
     4019                                   ,INPUT "p-rule-num"
     4020                                   ,INPUT 0
     4021                                   ,INPUT ''
     4022                                   ,INPUT ?
     4023                                   ,INPUT 0.0
     4024                                   ,INPUT f-rule-num
     4025                                   ,INPUT no
     4026                                   ).
     4027   RUN rcps_set-value IN THIS-PROCEDURE (
     4028                                   INPUT p-profile-id
     4029                                   ,INPUT p-once-more
     4030                                   ,INPUT p-call-id
     4031                                   ,INPUT "p-sum-id"
     4032                                   ,INPUT 0
     4033                                   ,INPUT f-sum-id
     4034                                   ,INPUT ?
     4035                                   ,INPUT 0.0
     4036                                   ,INPUT 0
     4037                                   ,INPUT no
     4038                                   ).
     4039   RUN rcps_set-value IN THIS-PROCEDURE (
     4040                                   INPUT p-profile-id
     4041                                   ,INPUT p-once-more
     4042                                   ,INPUT p-call-id
     4043                                   ,INPUT "p-tot-sum-id-sgd"
     4044                                   ,INPUT 0
     4045                                   ,INPUT f-tot-sum-id-sgd
     4046                                   ,INPUT ?
     4047                                   ,INPUT 0.0
     4048                                   ,INPUT 0
     4049                                   ,INPUT no
     4050                                   ).
     4051   run resort-rule-call-param in this-procedure ( input "p-rule-nums"
     4052                                                  ,input 1735).
     4053   run rcps_proc-save0 in this-procedure .
     4054   END PROCEDURE.
     4055   PROCEDURE resort-rule-call-param :
     4056   define input parameter p-rule-param-name as character no-undo.
     4057   define input parameter p-rule-id as integer no-undo.
     4058   define variable v-ii as integer no-undo.
     4059   define variable v-index as integer no-undo.
     4060   define buffer buf_tt-rule-call-param for tt-rule-call-param.
     4061   define buffer buf2_tt-rule-call-param for tt-rule-call-param.
     4062   do v-ii = 1 to 99999:
     4063     for each buf_tt-rule-call-param where
     4064               buf_tt-rule-call-param.rule_id = p-rule-id
     4065           and buf_tt-rule-call-param.param-name = p-rule-param-name
     4066           and buf_tt-rule-call-param.p-index >= v-ii
     4067      by buf_tt-rule-call-param.p-index:
     4068       v-index = buf_tt-rule-call-param.p-index .
     4069       leave.
     4070     end.      .
     4071     if not available buf_tt-rule-call-param then leave.
     4072     if buf_tt-rule-call-param.p-index <> v-ii then do:
     4073       for each buf2_tt-rule-call-param where
     4074               buf2_tt-rule-call-param.param-name = p-rule-param-name
     4075           and buf2_tt-rule-call-param.p-index = v-index:
     4076         assign
     4077         buf2_tt-rule-call-param.p-index = v-ii.
     4078         release buf2_tt-rule-call-param.
     4079       end.
     4080     end.
     4081   end.
     4082   END PROCEDURE.
     4083   PROCEDURE set-value :
     4084   DEFINE INPUT PARAMETER p-profile-id AS integer NO-UNDO.
     4085   DEFINE INPUT PARAMETER p-once-more AS integer NO-UNDO.
     4086   DEFINE INPUT PARAMETER p-rp-param-name AS CHARACTER NO-UNDO.
     4087   DEFINE INPUT PARAMETER p-call-id AS CHARACTER NO-UNDO.
     4088   DEFINE INPUT PARAMETER p-codex-id AS integer NO-UNDO.
     4089   DEFINE INPUT PARAMETER p-ruleset-id AS integer NO-UNDO.
     4090   DEFINE INPUT PARAMETER p-order-id AS integer NO-UNDO.
     4091   DEFINE INPUT PARAMETER p-param-name AS character NO-UNDO.
     4092   DEFINE INPUT PARAMETER p-index AS integer NO-UNDO.
     4093   DEFINE INPUT parameter p-value-character AS CHARACTER NO-UNDO.
     4094   DEFINE INPUT parameter p-value-date AS date NO-UNDO.
     4095   DEFINE INPUT parameter p-value-decimal AS decimal NO-UNDO.
     4096   DEFINE INPUT parameter p-value-integer AS integer NO-UNDO.
     4097   DEFINE INPUT parameter p-value-logical AS logical NO-UNDO.
     4098   DEFINE BUFFER buf_tt-rule-call-param FOR tt-rule-call-param.
     4099   DEFINE BUFFER buf_rp-rule-param FOR ub.rp-rule-param.
     4100   CASE p-list-mode:
     4101     WHEN 'rp-rule-param':U THEN DO:
     4102         FOR EACH  buf_rp-rule-param NO-LOCK where
     4103             buf_rp-rule-param.profile_id = p-profile-id
     4104             AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     4105             ,EACH buf_tt-rule-call-param WHERE
     4106                buf_tt-rule-call-param.profile_id = p-profile-id
     4107             AND buf_tt-rule-call-param.once-more = p-once-more
     4108             AND buf_tt-rule-call-param.call_id = p-CALL-id
     4109             AND buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     4110             AND buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     4111             AND buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     4112             AND buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     4113             AND buf_tt-rule-call-param.p-index = p-index
     4114           ON error undo, return error :
     4115             assign
     4116             buf_tt-rule-call-param.param-value-character = p-value-character
     4117             buf_tt-rule-call-param.param-value-date      = p-value-date
     4118             buf_tt-rule-call-param.param-value-decimal   = p-value-decimal
     4119             buf_tt-rule-call-param.param-value-integer   = p-value-integer
     4120             buf_tt-rule-call-param.param-value-logical   = p-value-logical
     4121             .
     4122         END.
     4123     END.
     4124     WHEN 'rule-call-param':U THEN DO:
     4125       FIND FIRST buf_tt-rule-call-param WHERE
     4126           buf_tt-rule-call-param.call_id = p-call-id
     4127       AND buf_tt-rule-call-param.codex_id = p-codex-id
     4128       AND buf_tt-rule-call-param.ruleset_id = p-ruleset-id
     4129       AND buf_tt-rule-call-param.order_id = p-order-id
     4130       AND buf_tt-rule-call-param.param-name = p-param-name
     4131       AND buf_tt-rule-call-param.p-index = p-index.
     4132       assign
     4133       buf_tt-rule-call-param.param-value-character = p-value-character
     4134       buf_tt-rule-call-param.param-value-date      = p-value-date
     4135       buf_tt-rule-call-param.param-value-decimal   = p-value-decimal
     4136       buf_tt-rule-call-param.param-value-integer   = p-value-integer
     4137       buf_tt-rule-call-param.param-value-logical   = p-value-logical
     4138       .
     4139     END.
     4140   END CASE.
     4141   END PROCEDURE.
