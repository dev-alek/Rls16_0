     2301           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2302         no-error .
     2303         if error-status :error
     2304         or error-status :get-message(1) <> ""
     2305         then do:
     2306           undo move_block, retry move_block.
     2307         end.
     2308         for each buf_temp-browse-handle
     2309           where buf_temp-browse-handle.browse-type = 'width':u
     2310         on error undo move_block, retry move_block
     2311         :
     2312           assign
     2313             buf_temp-browse-handle.browse-handle :width
     2314               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2315             no-error .
     2316           if error-status :error
     2317           or error-status :get-message(1) <> ""
     2318           then do:
     2319             undo move_block, retry move_block .
     2320           end.
     2321         end.
     2322         for each buf_temp-diasize-handle
     2323         on error undo move_block, retry move_block
     2324         :
     2325           assign
     2326             v-object-handle = buf_temp-diasize-handle.handle-value
     2327           .
     2328           if v-object-handle <> v-diasize-resize-button
     2329           then do:
     2330             assign
     2331               v-object-handle :col = v-object-handle :col + p-change-value
     2332               no-error .
     2333             if error-status :error
     2334             or error-status :get-message(1) <> ""
     2335             then do:
     2336               undo move_block, retry move_block .
     2337             end.
     2338           end.
     2339         end.
     2340       end.
     2341       else do:
     2342         for each buf_temp-diasize-handle
     2343         on error undo move_block, retry move_block
     2344         :
     2345           assign
     2346             v-object-handle = buf_temp-diasize-handle.handle-value
     2347           .
     2348           if v-object-handle <> v-diasize-resize-button
     2349           then do:
     2350             assign
     2351               v-object-handle :col = v-object-handle :col + p-change-value
     2352               no-error .
     2353             if error-status :error
     2354             or error-status :get-message(1) <> ""
     2355             then do:
     2356               undo move_block, retry move_block .
     2357             end.
     2358           end.
     2359         end.
     2360         for each buf_temp-browse-handle
     2361           where buf_temp-browse-handle.browse-type = 'width':u
     2362         on error undo move_block, retry move_block
     2363         :
     2364           assign
     2365             buf_temp-browse-handle.browse-handle :width
     2366               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2367             no-error .
     2368           if error-status :error
     2369           or error-status :get-message(1) <> ""
     2370           then do:
     2371             undo move_block, retry move_block .
     2372           end.
     2373         end.
     2374         assign
     2375           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2376           no-error .
     2377         if error-status :error
     2378         or error-status :get-message(1) <> ""
     2379         then do:
     2380           undo move_block, retry move_block.
     2381         end.
     2382         assign
     2383           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2384         no-error .
     2385         if error-status :error
     2386         or error-status :get-message(1) <> ""
     2387         then do:
     2388           undo move_block, retry move_block.
     2389         end.
     2390         if frame Dialog-Frame :scrollable = true
     2391         then do:
     2392           assign
     2393             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2394           no-error .
     2395           if error-status :error
     2396           or error-status :get-message(1) <> ""
     2397           then do:
     2398             undo move_block, retry move_block.
     2399           end.
     2400         end.
     2401       end.
     2402       if p-move-resize
     2403       then do:
     2404         run diasize_position-resize-button in this-procedure .
     2405       end.
     2406       if v-diasize-wndstore = true
     2407       then do:
     2408         if connected("ub") = true
     2409         then do:
     2410           define variable v-cntxt-db-num        as integer   no-undo .
     2411           define variable v-cntxt-userid        as character no-undo .
     2412           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2413                                             , OUTPUT v-cntxt-userid
     2414                                             ) .
     2415           run gbl/wndsizew.p
     2416             (input  v-cntxt-db-num
     2417             ,input  v-cntxt-userid
     2418             ,input  v-diasize-proc-name
     2419             ,input  'width':u
     2420             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2421             ) .
     2422         end.
     2423       end.
     2424     end.
     2425     assign
     2426       v-diasize-change-size = false
     2427     .
     2428   end procedure.
     2429   procedure diasize_set-width :
     2430     define input  parameter p-new-width  as decimal   no-undo .
     2431     define input  parameter p-move-resize as logical   no-undo .
     2432     do
     2433     on error undo, return error return-value
     2434     :
     2435       run diasize_change-width in this-procedure
     2436         (input  (p-new-width - frame Dialog-Frame :width)
     2437         ,input  p-move-resize
     2438         ) .
     2439     end.
     2440   end procedure.
     2441   procedure diasize_position-resize-button :
     2442     do with frame Dialog-Frame
     2443     :
     2444       hide v-diasize-resize-button .
     2445       assign
     2446         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2447                     - 1
     2448                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2449         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2450                     - 1
     2451                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2452       .
     2453       view v-diasize-resize-button .
     2454     end.
     2455   end procedure.
     2456   on alt-right anywhere
     2457   do:
     2458     run diasize_change-width in this-procedure
     2459       (input 1
     2460       ,input true
     2461       ) .
     2462     return no-apply .
     2463   end.
     2464   on alt-left anywhere
     2465   do:
     2466     run diasize_change-width in this-procedure
     2467       (input -1
     2468       ,input true
     2469       ) .
     2470     return no-apply .
     2471   end.
     2472   on alt-down anywhere
     2473   do:
     2474     run diasize_change-height in this-procedure
     2475       (input 1
     2476       ,input true
     2477       ) .
     2478     return no-apply .
     2479   end.
     2480   on alt-up anywhere
     2481   do:
     2482     run diasize_change-height in this-procedure
     2483       (input -1
     2484       ,input true
     2485       ) .
     2486     return no-apply .
     2487   end.
     2488   on alt-enter of frame Dialog-Frame
     2489   do:
     2490     run diasize_maximize in this-procedure
     2491       (input  ?
     2492       ).
     2493     return no-apply .
     2494   end.
     2495   procedure diasize_end-move :
     2496     do
     2497     on error undo, return error return-value
     2498     :
     2499       define variable v-row-delta as decimal   no-undo .
     2500       define variable v-col-delta as decimal   no-undo .
     2501       define variable v-new-row as decimal   no-undo .
     2502       define variable v-new-col as decimal   no-undo .
     2503       assign
     2504         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2505         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2506       .
     2507       assign
     2508         v-row-delta = v-new-row - frame Dialog-Frame :height
     2509         v-col-delta = v-new-col - frame Dialog-Frame :width
     2510       .
     2511       run diasize_change-height in this-procedure
     2512         (input v-row-delta
     2513         ,input true
     2514         ) .
     2515       run diasize_change-width in this-procedure
     2516         (input v-col-delta
     2517         ,input true
     2518         ) .
     2519     end.
     2520   end procedure.
     2521   procedure diasize_maximize :
     2522     define input  parameter p-action as logical   no-undo .
     2523     do
     2524     on error undo, return error return-value
     2525     :
     2526       if p-action = ?
     2527       then do:
     2528         if v-diasize-need-maximize = true
     2529         then do:
     2530           assign
     2531             p-action = true
     2532           .
     2533         end.
     2534         else do:
     2535           assign
     2536             p-action = false
     2537           .
     2538         end.
     2539       end.
     2540       if p-action = true
     2541       then do:
     2542         run diasize_change-height in this-procedure
     2543           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2544               - frame Dialog-Frame :height-chars
     2545           ,input true
     2546           ) .
     2547         run diasize_change-width in this-procedure
     2548           (input session :width-chars
     2549               - frame Dialog-Frame :width-chars
     2550           ,input true
     2551           ) .
     2552         assign
     2553           v-diasize-need-maximize = false
     2554         .
     2555       end.
     2556       else do:
     2557         run diasize_change-width in this-procedure
     2558           (input v-diasize-orig-frame-width
     2559               - frame Dialog-Frame :width-chars
     2560           ,input true
     2561           ) .
     2562         run diasize_change-height in this-procedure
     2563           (input v-diasize-orig-frame-height
     2564               - frame Dialog-Frame :height-chars
     2565           ,input true
     2566           ) .
     2567         assign
     2568           v-diasize-need-maximize = true
     2569         .
     2570       end.
     2571     end.
     2572   end procedure.
     2573   procedure diasize_restore-orig-size :
     2574     do
     2575     on error undo, return error return-value
     2576     :
     2577       assign
     2578         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2579         v-diasize-current-frame-height = frame Dialog-Frame :height
     2580       .
     2581       run diasize_set-height in this-procedure
     2582         (input  v-diasize-orig-frame-height
     2583         ,input  true
     2584         ) .
     2585       run diasize_set-width in this-procedure
     2586         (input  v-diasize-orig-frame-width
     2587         ,input  true
     2588         ) .
     2589     end.
     2590   end procedure.
     2591   procedure diasize_restore-current-size :
     2592     do
     2593     on error undo, return error return-value
     2594     :
     2595       run diasize_set-height in this-procedure
     2596         (input  v-diasize-current-frame-height
     2597         ,input  true
     2598         ) .
     2599       run diasize_set-width in this-procedure
     2600         (input  v-diasize-current-frame-width
     2601         ,input  true
     2602         ) .
     2603     end.
     2604   end procedure.
     2605   procedure diasize_set-browse-handle :
     2606     define input  parameter p-browse-handle as handle   no-undo .
     2607     define buffer buf_temp-browse-handle for temp-browse-handle .
     2608     do
     2609     on error undo, return error return-value
     2610     :
     2611       assign
     2612         v-diasize-browse-handle = p-browse-handle
     2613       .
     2614       for each buf_temp-browse-handle
     2615       on error undo, return error return-value
     2616       :
     2617         delete buf_temp-browse-handle .
     2618       end.
     2619     end.
     2620   end procedure.
     2621   procedure diasize_add_browse :
     2622     define input  parameter p-browse-type   as character no-undo .
     2623     define input  parameter p-browse-handle as handle    no-undo .
     2624     define buffer buf_temp-browse-handle for temp-browse-handle .
     2625     do
     2626     on error undo, return error return-value
     2627     :
     2628       assign
     2629         v-diasize-browse-number = v-diasize-browse-number + 1
     2630       .
     2631       create buf_temp-browse-handle .
     2632       assign
     2633         buf_temp-browse-handle.browse-type   = p-browse-type
     2634         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2635         buf_temp-browse-handle.browse-handle = p-browse-handle
     2636       .
     2637     end.
     2638   end procedure.
     2639   procedure diasize_init :
     2640     define variable v-default-value    as logical   no-undo .
     2641     define variable v-restore-saved    as logical   no-undo .
     2642     define variable v-resize-value-str as character no-undo .
     2643     do
     2644     on error undo, return error return-value
     2645     :
     2646       do with frame Dialog-Frame
     2647       :
     2648         assign
     2649           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2650           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2651           v-diasize-browse-handle     = browse br-dis-gds-rule :handle
     2652         .
     2653         create button v-diasize-resize-button
     2654         assign
     2655           parent        = frame Dialog-Frame :first-child
     2656           label         = "s"
     2657           height-pixels = 16
     2658           width-pixels  = 16
     2659           visible       = true
     2660           sensitive     = true
     2661           movable       = true
     2662           triggers:
     2663             on end-move persistent run diasize_end-move in this-procedure .
     2664           end triggers.
     2665         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2666         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2667         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2668         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2669         assign
     2670           v-diasize-wndmax = false
     2671         .
     2672         if connected("ub") = true
     2673         then do:
     2674           define variable v-cntxt-db-num        as integer   no-undo .
     2675           define variable v-cntxt-userid        as character no-undo .
     2676           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2677                                             , OUTPUT v-cntxt-userid
     2678                                             ) .
     2679           run gbl/wndpar_r.p
     2680             (input  v-cntxt-db-num
     2681             ,input  v-cntxt-userid
     2682             ,input  'wndmax':U
     2683             ,output v-diasize-wndmax
     2684             ,output v-default-value
     2685             ) .
     2686         end.
     2687         assign
     2688           v-diasize-wndstore = false
     2689         .
     2690         if connected("ub") = true
     2691         then do:
     2692           run gbl/wndpar_r.p
     2693             (input  v-cntxt-db-num
     2694             ,input  v-cntxt-userid
     2695             ,input  'wndstore':U
     2696             ,output v-diasize-wndstore
     2697             ,output v-default-value
     2698             ) .
     2699         end.
     2700         assign
     2701           v-diasize-proc-name = entry(1, program-name(2), '.')
     2702         .
     2703         if v-diasize-wndstore = true
     2704         then do:
     2705           assign
     2706             v-restore-saved = false
     2707           .
     2708           if connected("ub") = true
     2709           then do:
     2710             run gbl/wndsizer.p
     2711               (input  v-cntxt-db-num
     2712               ,input  v-cntxt-userid
     2713               ,input  v-diasize-proc-name
     2714               ,input  'height':u
     2715               ,output v-resize-value-str
     2716               ) .
     2717             if v-resize-value-str <> '':U
     2718             then do:
     2719               run diasize_change-height in this-procedure
     2720                 (input  integer(v-resize-value-str)
     2721                 ,input  true
     2722                 ) .
     2723               assign
     2724                 v-restore-saved = true
     2725               .
     2726             end.
     2727           end.
     2728           if connected("ub") = true
     2729           then do:
     2730             run gbl/wndsizer.p
     2731               (input  v-cntxt-db-num
     2732               ,input  v-cntxt-userid
     2733               ,input  v-diasize-proc-name
     2734               ,input  'width':u
     2735               ,output v-resize-value-str
     2736               ) .
     2737             if v-resize-value-str <> '':U
     2738             then do:
     2739               run diasize_change-width in this-procedure
     2740                 (input  integer(v-resize-value-str)
     2741                 ,input  true
     2742                 ) .
     2743               assign
     2744                 v-restore-saved = true
     2745               .
     2746             end.
     2747           end.
     2748           if v-restore-saved <> true
     2749           then do:
     2750             if v-diasize-wndmax = true
     2751             then do:
     2752               run diasize_maximize in this-procedure
     2753                 (input  true
     2754                 ) .
     2755             end.
     2756           end.
     2757         end.
     2758         else do:
     2759           if v-diasize-wndmax = true
     2760           then do:
     2761             run diasize_maximize in this-procedure
     2762               (input  true
     2763               ) .
     2764           end.
     2765         end.
     2766       end.
     2767     end.
     2768   end procedure.
     2769   procedure diasize_need-full-display :
     2770     define output parameter p-need-full-display as logical   no-undo .
     2771     do
     2772     on error undo, return error return-value
     2773     :
     2774       assign
     2775         p-need-full-display = v-diasize-need-full-display
     2776       .
     2777       assign
     2778         v-diasize-need-full-display = false
     2779       .
     2780     end.
     2781   end procedure.
     2782   procedure get-context :
     2783      define output parameter p-db-num as integer          no-undo.
     2784      define output parameter p-user-id as character        no-undo.
     2785      define variable v-login               as character    no-undo.
     2786      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2787      define buffer buf_user-login  for ub.user-login .
     2788      do
     2789      on error undo, return error
     2790      :
     2791            FIND FIRST buf_sys-ctrl no-lock.
     2792            ASSIGN
     2793               v-login = USERID("ub")
     2794               p-db-num = buf_sys-ctrl.db-num
     2795            .
     2796            FIND FIRST buf_user-login
     2797                 WHERE buf_user-login.db-num = p-db-num
     2798                   AND buf_user-login.user-login = v-login
     2799                 no-lock
     2800                 no-error
     2801                 .
     2802            IF AVAILABLE buf_user-login
     2803            THEN DO:
     2804               assign
     2805                  p-user-id = buf_user-login.user-id
     2806               .
     2807            END.
     2808      end.
     2809   end procedure.
     2810       run diasize_init in this-procedure .
     2811   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2812   procedure rcps_get-profile-id :
     2813   define output parameter p-local-profile-id as integer no-undo .
     2814   do
     2815   on error undo, return error:
     2816   p-local-profile-id = p-profile-id.
     2817   end.
     2818   end procedure.
     2819   PROCEDURE rcps_fill-table :
     2820   define input parameter p-clear-params as logical no-undo .
     2821   if p-clear-params then do:
     2822   FOR EACH tt-rule-call-param:
     2823       DELETE tt-rule-call-param.
     2824   END.
     2825   end.
     2826    FOR EACH tt0-rule-call-param:
     2827      IF p-mode <> 'ДОБАВЛЕНИЕ':U THEN DO:
     2828        IF p-call-id <> '':U and p-call-id <> tt0-rule-call-param.call_id THEN do:
     2829           NEXT.
     2830        end.
     2831        IF p-codex-id <> 0 and p-codex-id <> tt0-rule-call-param.codex_id THEN do:
     2832          NEXT.
     2833        end.
     2834        IF p-ruleset-id <> 0 and p-ruleset-id <> tt0-rule-call-param.ruleset_id THEN do:
     2835          NEXT.
     2836        end.
     2837        IF p-rule-id <> 0 and p-rule-id <> tt0-rule-call-param.RULE_id THEN do:
     2838          NEXT.
     2839        end.
     2840        IF p-order-id <> ? and p-order-id <> tt0-rule-call-param.order_id THEN do:
     2841          NEXT.
     2842        end.
     2843      END.
     2844      if lookup("hidden", tt0-rule-call-param.param-3-data-type) > 0 then do:
     2845        next.
     2846      end.
     2847      IF p-list-mode = 'rp-rule-param':U
     2848      or p-list-mode = 'rp-rule-param':U  + chr(44) + 'все':U
     2849      THEN DO:
     2850         IF p-profile-id <> 0 AND p-profile-id <> tt0-rule-call-param.profile_id THEN do:
     2851           NEXT.
     2852         end.
     2853         IF p-once-more <> ? AND p-once-more <> tt0-rule-call-param.once-more THEN do:
     2854           NEXT.
     2855         end.
     2856      END.
     2857      CREATE tt-rule-call-param.
     2858      BUFFER-COPY tt0-rule-call-param TO tt-rule-call-param.
     2859   END.
     2860   END PROCEDURE.
     2861   procedure rcps_get-value :
     2862   DEFINE INPUT PARAMETER p-profile-id AS integer NO-UNDO.
     2863   DEFINE INPUT PARAMETER p-once-more AS integer NO-UNDO.
     2864   DEFINE INPUT PARAMETER p-call-id AS CHARACTER NO-UNDO.
     2865   DEFINE INPUT PARAMETER p-rp-param-name AS CHARACTER NO-UNDO.
     2866   DEFINE INPUT-output PARAMETER pp-index AS integer NO-UNDO.
     2867   DEFINE output parameter p-value-character AS CHARACTER NO-UNDO.
     2868   DEFINE output parameter p-value-date AS date NO-UNDO.
     2869   DEFINE output parameter p-value-decimal AS decimal NO-UNDO.
     2870   DEFINE output parameter p-value-integer AS integer NO-UNDO.
     2871   DEFINE output parameter p-value-logical AS logical NO-UNDO.
     2872   define variable v-current-index as integer no-undo init -1.
     2873   define variable v-start as logical no-undo init yes.
     2874   DEFINE BUFFER buf_ruledict-param FOR ub.ruledict-param.
     2875   DEFINE BUFFER buf_rp-rule-param FOR ub.rp-rule-param.
     2876   DEFINE BUFFER buf_tt-rule-call-param FOR tt-rule-call-param.
     2877   DEFINE BUFFER buf_term_tt-rule-call-param FOR tt-rule-call-param.
     2878   do
     2879   on error undo, return error
     2880   :
     2881   FOR FIRST buf_rp-rule-param WHERE
     2882         buf_rp-rule-param.profile_id = p-profile-id
     2883     AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     2884   , each buf_tt-rule-call-param WHERE
     2885      buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     2886   AND buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     2887   AND buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     2888   AND buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     2889   AND buf_tt-rule-call-param.p-index >= pp-index
     2890    ,each buf_term_tt-rule-call-param where
     2891          buf_term_tt-rule-call-param.call_id = buf_tt-rule-call-param.call_id
     2892      and buf_term_tt-rule-call-param.codex_id = buf_tt-rule-call-param.codex_id
     2893      and buf_term_tt-rule-call-param.ruleset_id = buf_tt-rule-call-param.ruleset_id
     2894      and buf_term_tt-rule-call-param.order_id = buf_tt-rule-call-param.order_id
     2895      and buf_term_tt-rule-call-param.param-name = buf_tt-rule-call-param.param-name
     2896      and buf_term_tt-rule-call-param.p-index = buf_tt-rule-call-param.p-index
     2897     by buf_term_tt-rule-call-param.call_id
     2898     by buf_term_tt-rule-call-param.codex_id
     2899     by buf_term_tt-rule-call-param.ruleset_id
     2900     by buf_term_tt-rule-call-param.order_id
     2901     by buf_term_tt-rule-call-param.param-name
     2902     by buf_term_tt-rule-call-param.p-index :
     2903       if v-start
     2904       then do:
     2905         assign
     2906         pp-index = buf_term_tt-rule-call-param.p-index
     2907         p-value-character = buf_term_tt-rule-call-param.param-value-character
     2908         p-value-date      = buf_term_tt-rule-call-param.param-value-date
     2909         p-value-decimal   = buf_term_tt-rule-call-param.param-value-decimal
     2910         p-value-integer   = buf_term_tt-rule-call-param.param-value-integer
     2911         p-value-logical   = buf_term_tt-rule-call-param.param-value-logical
     2912         v-start = no
     2913         .
     2914       end.
     2915       else do:
     2916         if buf_term_tt-rule-call-param.p-index > pp-index then do:
     2917           v-current-index = buf_term_tt-rule-call-param.p-index.
     2918           leave.
     2919         end.
     2920             end.
     2921     end.
     2922     pp-index = v-current-index.
     2923   end.
     2924   end procedure.
     2925   PROCEDURE rcps_proc-b-add :
     2926   DEFINE INPUT PARAMETER p-profile-id AS integer NO-UNDO.
     2927   DEFINE INPUT PARAMETER p-once-more AS integer NO-UNDO.
     2928   DEFINE INPUT PARAMETER p-call-id AS CHARACTER NO-UNDO.
     2929   DEFINE INPUT PARAMETER p-rp-param-name AS CHARACTER NO-UNDO.
     2930   DEFINE INPUT PARAMETER p-index AS integer NO-UNDO.
     2931   define variable v-ind as integer no-undo .
     2932   define buffer buf_tt-rule-call-param for tt-rule-call-param.
     2933   define buffer buf0_tt-rule-call-param for tt-rule-call-param.
     2934   define buffer buf2_tt-rule-call-param for tt-rule-call-param.
     2935   define buffer buf_rp-rule-param for ub.rp-rule-param.
     2936   FOR FIRST buf_rp-rule-param WHERE
     2937             buf_rp-rule-param.profile_id = p-profile-id
     2938         AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     2939       , first buf0_tt-rule-call-param WHERE
     2940          buf0_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     2941      AND buf0_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     2942      AND buf0_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     2943      AND buf0_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name:
     2944     LEAVE.
     2945   END.
     2946   IF NOT AVAILABLE buf0_tt-rule-call-param THEN do:
     2947     BELL.
     2948     RETURN.
     2949   END.
     2950   for each buf_rp-rule-param where
     2951           buf_rp-rule-param.rp-param-name = p-rp-param-name
     2952       and buf_rp-rule-param.profile_id = p-profile-id,
     2953       first buf_tt-rule-call-param where
     2954           buf_tt-rule-call-param.call_id = buf0_tt-rule-call-param.call_id
     2955       and buf_tt-rule-call-param.profile_id = buf_rp-rule-param.profile_id
     2956       and buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     2957       and buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     2958       and buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     2959       and buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     2960       and buf_tt-rule-call-param.once-more = buf0_tt-rule-call-param.once-more
     2961       and buf_tt-rule-call-param.p-index = p-index:
     2962     RETURN.
     2963   END.
     2964   IF lookup("LIST", buf0_tt-rule-call-param.param-3-data-type) = 0
     2965   and lookup("SORTED-LIST", buf0_tt-rule-call-param.param-3-data-type) = 0
     2966   THEN DO:
     2967     BELL.
     2968     RETURN.
     2969   END.
     2970   IF buf0_tt-rule-call-param.p-index <> 0 THEN DO:
     2971     BELL.
     2972     RETURN.
     2973   END.
     2974   find last buf_tt-rule-call-param where
     2975            buf_tt-rule-call-param.call_id = buf0_tt-rule-call-param.call_id
     2976        and buf_tt-rule-call-param.codex_id = buf0_tt-rule-call-param.codex_id
     2977        and buf_tt-rule-call-param.ruleset_id = buf0_tt-rule-call-param.ruleset_id
     2978        and buf_tt-rule-call-param.order_id = buf0_tt-rule-call-param.order_id
     2979        and buf_tt-rule-call-param.param-name = buf0_tt-rule-call-param.param-name no-error .
     2980   if available buf_tt-rule-call-param
     2981   and (lookup("LIST", buf_tt-rule-call-param.param-3-data-type) > 0
     2982        or
     2983        lookup("SORTED-LIST", buf_tt-rule-call-param.param-3-data-type) > 0
     2984        )
     2985   and buf_tt-rule-call-param.p-index > 0 then do:
     2986     v-ind = buf_tt-rule-call-param.p-index.
     2987   end.
     2988   for each buf_rp-rule-param where
     2989           buf_rp-rule-param.rp-param-name = p-rp-param-name
     2990       and buf_rp-rule-param.profile_id = p-profile-id,
     2991       first buf_tt-rule-call-param where
     2992           buf_tt-rule-call-param.call_id = buf0_tt-rule-call-param.call_id
     2993       and buf_tt-rule-call-param.profile_id = buf_rp-rule-param.profile_id
     2994       and buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     2995       and buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     2996       and buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     2997       and buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     2998       and buf_tt-rule-call-param.once-more = buf0_tt-rule-call-param.once-more
     2999       and buf_tt-rule-call-param.p-index = 0
     3000   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3001   on stop   undo, return error substitute( "&1. stop", vss-workfile )
     3002   on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     3003   :
     3004     create buf2_tt-rule-call-param.
     3005     buffer-copy buf_tt-rule-call-param
     3006     except p-index
     3007     to buf2_tt-rule-call-param
     3008     assign
     3009     buf2_tt-rule-call-param.p-index = v-ind + 1
     3010     .
     3011   end.
     3012   END PROCEDURE.
     3013   PROCEDURE rcps_proc-b-del :
     3014   DEFINE INPUT PARAMETER p-profile-id AS integer NO-UNDO.
     3015   DEFINE INPUT PARAMETER p-once-more AS integer NO-UNDO.
     3016   DEFINE INPUT PARAMETER p-call-id AS CHARACTER NO-UNDO.
     3017   DEFINE INPUT PARAMETER p-rp-param-name AS CHARACTER NO-UNDO.
     3018   DEFINE INPUT PARAMETER pp-index AS integer NO-UNDO.
     3019   define variable v-ind as integer no-undo .
     3020   define variable v-once-more as integer no-undo .
     3021   define variable v-call-id as character no-undo .
     3022   define buffer buf0_tt-rule-call-param for tt-rule-call-param.
     3023   define buffer buf_tt-rule-call-param for tt-rule-call-param.
     3024   define buffer buf_rp-rule-param for ub.rp-rule-param.
     3025   if pp-index = 0 then do:
     3026     undo, return error substitute("Нельзя удалять корневой параметр &1 (индекс = 0)", p-rp-param-name).
     3027   end.
     3028   FOR first buf_rp-rule-param WHERE
     3029             buf_rp-rule-param.profile_id = p-profile-id
     3030         AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     3031       , first buf0_tt-rule-call-param WHERE
     3032          buf0_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3033      AND buf0_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3034      AND buf0_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3035      AND buf0_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     3036      AND buf0_tt-rule-call-param.p-index = pp-index
     3037      :
     3038     LEAVE.
     3039   END.
     3040   IF NOT AVAILABLE buf0_tt-rule-call-param THEN do:
     3041     FOR first buf_rp-rule-param WHERE
     3042               buf_rp-rule-param.profile_id = p-profile-id
     3043           AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     3044         , last buf0_tt-rule-call-param WHERE
     3045           buf0_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3046       AND buf0_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3047       AND buf0_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3048       AND buf0_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     3049       AND buf0_tt-rule-call-param.p-index > pp-index :
     3050       leave.
     3051     end.
     3052     IF NOT AVAILABLE buf0_tt-rule-call-param THEN do:
     3053     return "not-found".
     3054     end.
     3055     else do:
     3056       return ''.
     3057     end.
     3058   END.
     3059   IF lookup("LIST", buf0_tt-rule-call-param.param-3-data-type) = 0
     3060   and lookup("SORTED-LIST", buf0_tt-rule-call-param.param-3-data-type) = 0
     3061   THEN DO:
     3062     undo, return error substitute("Можно удалять только параметры типа LIST и SORTED-LIST").
     3063   END.
     3064   IF lookup("READ-ONLY", buf0_tt-rule-call-param.param-3-data-type) > 0 THEN DO:
     3065     undo, return error substitute("Нельзя удалять  параметры типа READ-ONLY").
     3066   END.
     3067   for each buf_rp-rule-param where
     3068           buf_rp-rule-param.rp-param-name = buf_rp-rule-param.rp-param-name
     3069       and buf_rp-rule-param.profile_id = buf_rp-rule-param.profile_id,
     3070       each buf_tt-rule-call-param where
     3071           buf_tt-rule-call-param.call_id = p-call-id
     3072       and buf_tt-rule-call-param.profile_id = buf_rp-rule-param.profile_id
     3073       and buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3074       and buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3075       and buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3076       and buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     3077       and buf_tt-rule-call-param.once-more = p-once-more
     3078       and buf_tt-rule-call-param.p-index = pp-index
     3079   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3080   on stop   undo, return error substitute( "&1. stop", vss-workfile )
     3081   on endkey undo, return error substitute( "&1. endkey", vss-workfile ):
     3082       DELETE buf_tt-rule-call-param.
     3083   end.
     3084   return ''.
     3085   END PROCEDURE.
     3086   PROCEDURE rcps_proc-save0 :
     3087   FOR EACH tt-rule-call-param
     3088   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3089   on stop   undo , return error substitute( "&1. stop", vss-workfile )
     3090   on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     3091   :
     3092      find  FIRST tt0-rule-call-param NO-LOCK WHERE
     3093               tt0-rule-call-param.codex_id = tt-rule-call-param.codex_id
     3094          AND  tt0-rule-call-param.ruleset_id = tt-rule-call-param.ruleset_id
     3095          AND tt0-rule-call-param.call_id = tt-rule-call-param.call_id
     3096          AND tt0-rule-call-param.order_id = tt-rule-call-param.order_id
     3097          AND tt0-rule-call-param.param-name = tt-rule-call-param.param-name
     3098          AND tt0-rule-call-param.p-index = tt-rule-call-param.p-index no-error .
     3099      if not available tt0-rule-call-param
     3100      and (lookup("LIST", tt-rule-call-param.param-3-data-type) > 0
     3101           OR
     3102           lookup("SORTED-LIST", tt-rule-call-param.param-3-data-type) > 0
     3103           )
     3104      and tt-rule-call-param.p-index > 0 then do:
     3105        create tt0-rule-call-param.
     3106      end.
     3107      BUFFER-COPY tt-rule-call-param TO tt0-rule-call-param.
     3108   END.
     3109   FOR EACH tt0-rule-call-param
     3110   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3111   on stop   undo , return error substitute( "&1. stop", vss-workfile )
     3112   on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     3113   :
     3114     if tt0-rule-call-param.p-index = 0 then next.
     3115     if lookup("hidden", tt0-rule-call-param.param-3-data-type) > 0 then next.
     3116     find  FIRST tt-rule-call-param NO-LOCK WHERE
     3117             tt-rule-call-param.codex_id = tt0-rule-call-param.codex_id
     3118         AND tt-rule-call-param.ruleset_id = tt0-rule-call-param.ruleset_id
     3119         AND tt-rule-call-param.call_id = tt0-rule-call-param.call_id
     3120         AND tt-rule-call-param.order_id = tt0-rule-call-param.order_id
     3121         AND tt-rule-call-param.param-name = tt0-rule-call-param.param-name
     3122         AND tt-rule-call-param.p-index = tt0-rule-call-param.p-index no-error .
     3123     if not available tt-rule-call-param
     3124     and (lookup("LIST", tt0-rule-call-param.param-3-data-type) > 0
     3125         OR
     3126         lookup("SORTED-LIST", tt0-rule-call-param.param-3-data-type) > 0
     3127         )
     3128     and tt0-rule-call-param.p-index > 0
     3129     then do:
     3130        IF p-call-id <> '':U and p-call-id <> tt0-rule-call-param.call_id THEN do:
     3131           NEXT.
     3132        end.
     3133        IF p-codex-id <> 0 and p-codex-id <> tt0-rule-call-param.codex_id THEN do:
     3134          NEXT.
     3135        end.
     3136        IF p-ruleset-id <> 0 and p-ruleset-id <> tt0-rule-call-param.ruleset_id THEN do:
     3137          NEXT.
     3138        end.
     3139        IF p-rule-id <> 0 and p-rule-id <> tt0-rule-call-param.RULE_id THEN do:
     3140          NEXT.
     3141        end.
     3142        IF p-order-id <> ? and p-order-id <> tt0-rule-call-param.order_id THEN do:
     3143          NEXT.
     3144        end.
     3145       IF p-list-mode = 'rp-rule-param':U
     3146       or p-list-mode = 'rp-rule-param':U  + chr(44) + 'все':U
     3147       THEN DO:
     3148         IF p-profile-id <> 0 AND p-profile-id <> tt0-rule-call-param.profile_id THEN do:
     3149           NEXT.
     3150         end.
     3151         IF p-once-more <> ? AND p-once-more <> tt0-rule-call-param.once-more THEN do:
     3152           NEXT.
     3153         end.
     3154       end.
     3155       delete tt0-rule-call-param.
     3156     end.
     3157   end.
     3158   END PROCEDURE.
     3159   PROCEDURE rcps_set-value :
     3160   DEFINE INPUT PARAMETER p-profile-id AS integer NO-UNDO.
     3161   DEFINE INPUT PARAMETER p-once-more AS integer NO-UNDO.
     3162   DEFINE INPUT PARAMETER p-call-id AS CHARACTER NO-UNDO.
     3163   DEFINE INPUT PARAMETER p-rp-param-name AS CHARACTER NO-UNDO.
     3164   DEFINE INPUT PARAMETER pp-index AS integer NO-UNDO.
     3165   DEFINE INPUT parameter p-value-character AS CHARACTER NO-UNDO.
     3166   DEFINE INPUT parameter p-value-date AS date NO-UNDO.
     3167   DEFINE INPUT parameter p-value-decimal AS decimal NO-UNDO.
     3168   DEFINE INPUT parameter p-value-integer AS integer NO-UNDO.
     3169   DEFINE INPUT parameter p-value-logical AS logical NO-UNDO.
     3170   DEFINE VARIABLE v-codex-id AS integer NO-UNDO.
     3171   DEFINE VARIABLE v-ruleset-id AS integer NO-UNDO.
     3172   DEFINE VARIABLE v-order-id AS integer NO-UNDO.
     3173   DEFINE VARIABLE V-param-name AS character NO-UNDO.
     3174   define variable v-found as logical no-undo .
     3175   DEFINE BUFFER buf_tt-rule-call-param FOR tt-rule-call-param.
     3176   DEFINE BUFFER buf_rp-rule-param FOR ub.rp-rule-param.
     3177   FOR FIRST buf_rp-rule-param WHERE
     3178             buf_rp-rule-param.profile_id = p-profile-id
     3179         AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     3180       , first buf_tt-rule-call-param WHERE
     3181          buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3182      AND buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3183      AND buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3184      AND buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name:
     3185     ASSIGN
     3186     v-codex-id = buf_tt-rule-call-param.codex_id
     3187     v-ruleset-id = buf_tt-rule-call-param.ruleset_id
     3188     v-order-id = buf_tt-rule-call-param.order_id
     3189     V-PARAM-NAME = buf_tt-rule-call-param.PARAM-NAME
     3190     .
     3191     LEAVE.
     3192   END.
     3193   CASE p-list-mode:
     3194     WHEN 'rp-rule-param':U THEN DO:
     3195       if pp-index > 0
     3196       then do:
     3197         FOR EACH  buf_rp-rule-param NO-LOCK where
     3198             buf_rp-rule-param.profile_id = p-profile-id
     3199             AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     3200             ,EACH buf_tt-rule-call-param WHERE
     3201                 buf_tt-rule-call-param.profile_id = p-profile-id
     3202             AND buf_tt-rule-call-param.once-more = p-once-more
     3203             AND buf_tt-rule-call-param.call_id = p-CALL-id
     3204             AND buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3205             AND buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3206             AND buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3207             AND buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     3208             AND buf_tt-rule-call-param.p-index = pp-index
     3209         ON error undo, return error :
     3210           v-found = yes.
     3211         end.
     3212       end.
     3213       if not v-found then do:
     3214         run rcps_proc-b-add in this-procedure (
     3215                                                  input p-profile-id
     3216                                                 ,input p-once-more
     3217                                                 ,input p-call-id
     3218                                                 ,
     3219                                                  input p-rp-param-name
     3220                                                 ,input pp-index).
     3221       end.
     3222       FOR EACH  buf_rp-rule-param NO-LOCK where
     3223           buf_rp-rule-param.profile_id = p-profile-id
     3224           AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     3225           ,EACH buf_tt-rule-call-param WHERE
     3226               buf_tt-rule-call-param.profile_id = p-profile-id
     3227           AND buf_tt-rule-call-param.once-more = p-once-more
     3228           AND buf_tt-rule-call-param.call_id = p-CALL-id
     3229           AND buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3230           AND buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3231           AND buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3232           AND buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     3233           AND buf_tt-rule-call-param.p-index = pp-index
     3234         ON error undo, return error :
     3235         assign
     3236         buf_tt-rule-call-param.param-value-character = p-value-character
     3237         buf_tt-rule-call-param.param-value-date      = p-value-date
     3238         buf_tt-rule-call-param.param-value-decimal   = p-value-decimal
     3239         buf_tt-rule-call-param.param-value-integer   = p-value-integer
     3240         buf_tt-rule-call-param.param-value-logical   = p-value-logical
     3241         .
     3242       END.
     3243     END.
     3244     WHEN 'rule-call-param':U THEN DO:
     3245       FIND FIRST buf_tt-rule-call-param WHERE
     3246           buf_tt-rule-call-param.call_id = p-call-id
     3247       AND buf_tt-rule-call-param.codex_id = v-codex-id
     3248       AND buf_tt-rule-call-param.ruleset_id = v-ruleset-id
     3249       AND buf_tt-rule-call-param.order_id = v-order-id
     3250       AND buf_tt-rule-call-param.param-name = V-PARAM-NAME
     3251       AND buf_tt-rule-call-param.p-index = pp-index.
     3252       assign
     3253       buf_tt-rule-call-param.param-value-character = p-value-character
     3254       buf_tt-rule-call-param.param-value-date      = p-value-date
     3255       buf_tt-rule-call-param.param-value-decimal   = p-value-decimal
     3256       buf_tt-rule-call-param.param-value-integer   = p-value-integer
     3257       buf_tt-rule-call-param.param-value-logical   = p-value-logical
     3258       .
     3259     END.
     3260   END CASE.
     3261   END PROCEDURE.
     3262   procedure rcps_get-rule-on-off :
     3263   define input parameter p-codex-id as integer no-undo .
     3264   define input parameter p-ruleset-id as integer no-undo .
     3265   define input parameter p-rule-id as integer no-undo .
     3266   define input parameter p-profile-id as integer no-undo .
     3267   define input parameter p-once-more as integer no-undo .
     3268   define output parameter p-on-off as logical no-undo .
