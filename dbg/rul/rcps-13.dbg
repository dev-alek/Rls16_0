     3298   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3299   PROCEDURE rcps_MyEnable0 :
     3300   DEFINE VARIABLE v-ii AS INTEGER NO-UNDO.
     3301   DEFINE VARIABLE v-ch0 AS widget-handle NO-UNDO.
     3302   ASSIGN
     3303   term_tt-rule-call-param.param-label:RESIZABLE IN browse br-rcp = YES
     3304   X_rp-rule-param.rp-param-name:RESIZABLE IN browse br-rcp = YES
     3305   .
     3306   ASSIGN
     3307   v-ch0 = br-rcp:FIRST-COLUMN IN FRAME Dialog-Frame.
     3308   REPEAT WHILE valid-handle(v-ch0):
     3309      IF v-ch0:LABEL = "Значение!(строковое)" THEN DO:
     3310        v-ch[1] = v-ch0.
     3311        v-ch0:VISIBLE = NO.
     3312      END.
     3313      IF v-ch0:LABEL = "Значение!(Дата)" THEN DO:
     3314        v-ch[2] = v-ch0.
     3315        v-ch0:VISIBLE = NO.
     3316      END.
     3317      IF v-ch0:LABEL = "Значение!(Десятичное)" THEN DO:
     3318        v-ch[3] = v-ch0.
     3319        v-ch0:VISIBLE = NO.
     3320      END.
     3321      IF v-ch0:LABEL = "Значение!(Целое)" THEN DO:
     3322        v-ch[4] = v-ch0.
     3323        v-ch0:VISIBLE = NO.
     3324      END.
     3325      IF v-ch0:LABEL = "Значение!(Логическое)" THEN DO:
     3326        v-ch[5] = v-ch0.
     3327        v-ch0:VISIBLE = NO.
     3328      END.
     3329      IF v-ch0:LABEL = "Точка вызова" THEN DO:
     3330        v-ch[6] = v-ch0.
     3331      END.
     3332      IF v-ch0:LABEL = "Значение" THEN
     3333      v-ch0:RESIZABLE = YES.
     3334      v-ch0 = v-ch0:NEXT-COLUMN.
     3335   END.
     3336   assign
     3337   X_rp-rule-param.rp-param-name:resizable in browse br-rcp = yes
     3338   term_tt-rule-call-param.param-name:resizable in browse br-rcp = yes
     3339   term_tt-rule-call-param.param-label:resizable in browse br-rcp = yes
     3340   .
     3341   CASE p-list-mode:
     3342     WHEN 'rule-call-param':U THEN DO:
     3343        ASSIGN
     3344        X_rp-rule-param.rp-param-name:VISIBLE IN BROWSE br-rcp = NO
     3345        .
     3346     END.
     3347     WHEN 'rp-rule-param':U
     3348     or
     3349     when 'rp-rule-param':U + chr(44) + 'все':U
     3350     THEN DO:
     3351       assign
     3352       term_tt-rule-call-param.codex_id:VISIBLE IN BROWSE br-rcp = NO
     3353       term_tt-rule-call-param.ruleset_id:VISIBLE IN BROWSE br-rcp = NO
     3354       term_tt-rule-call-param.rule_id:VISIBLE IN BROWSE br-rcp = NO
     3355       term_tt-rule-call-param.order_id:VISIBLE IN BROWSE br-rcp = NO
     3356       term_tt-rule-call-param.param-name:VISIBLE IN BROWSE br-rcp = NO
     3357       term_tt-rule-call-param.param-num:VISIBLE IN BROWSE br-rcp = NO
     3358       .
     3359     END.
     3360   END CASE.
     3361    IF p-call-id <> '':U THEN DO:
     3362      v-ch[6]:VISIBLE = NO.
     3363    END.
     3364     IF p-profile-id <> 0 THEN DO:
     3365      term_tt-rule-call-param.profile_id :VISIBLE IN BROWSE br-rcp= NO.
     3366    END.
     3367     IF p-rule-id <> 0 THEN DO:
     3368      term_tt-rule-call-param.RULE_id :VISIBLE IN BROWSE br-rcp= NO.
     3369    END.
     3370     IF p-once-more <> 0 THEN DO:
     3371      term_tt-rule-call-param.once-more :VISIBLE IN BROWSE br-rcp= NO.
     3372    END.
     3373   END PROCEDURE.
     3374   PROCEDURE rcps_Openbr :
     3375   CASE p-list-mode:
     3376     WHEN 'rp-rule-param':U THEN DO:
     3377         OPEN QUERY br-rcp
     3378         FOR EACH  X_ruledict-param NO-LOCK WHERE X_ruledict-param.entry-id = v-rcps-entry-id
     3379             ,FIRST X_rp-rule-param WHERE
     3380                 X_rp-rule-param.profile_id = p-profile-id
     3381             AND X_rp-rule-param.rp-param-name = X_ruledict-param.param-name
     3382           , first tt-rule-call-param WHERE
     3383              tt-rule-call-param.codex_id = X_rp-rule-param.codex_id
     3384          AND tt-rule-call-param.ruleset_id = X_rp-rule-param.ruleset_id
     3385          AND tt-rule-call-param.rule_id = X_rp-rule-param.rule_id
     3386          AND tt-rule-call-param.param-name = X_rp-rule-param.rule-param-name
     3387            ,each term_tt-rule-call-param where
     3388                  term_tt-rule-call-param.call_id = tt-rule-call-param.call_id
     3389              and term_tt-rule-call-param.codex_id = tt-rule-call-param.codex_id
     3390              and term_tt-rule-call-param.ruleset_id = tt-rule-call-param.ruleset_id
     3391              and term_tt-rule-call-param.order_id = tt-rule-call-param.order_id
     3392              and term_tt-rule-call-param.param-name = tt-rule-call-param.param-name
     3393         BY tt-rule-call-param.call_id
     3394         BY tt-rule-call-param.codex_id
     3395         BY tt-rule-call-param.ruleset_id
     3396         BY tt-rule-call-param.order_id
     3397         BY tt-rule-call-param.param-num.
     3398     END.
     3399   END CASE.
     3400   apply "ENTRY" to br-rcp in frame Dialog-Frame .
     3401   APPLy "VALUE-CHANGED" to br-rcp.
     3402   END PROCEDURE.
     3403   PROCEDURE rcps_proc-b-chg PRIVATE :
     3404   DEFINE VARIABLE v-rec1 AS Rowid NO-UNDO.
     3405   DEFINE VARIABLE v-rec2 AS Rowid NO-UNDO.
     3406   DEFINE VARIABLE v-rec3 AS Rowid NO-UNDO.
     3407   DEFINE VARIABLE v-rec4 AS Rowid NO-UNDO.
     3408   define variable v-param-data-type as character no-undo .
     3409   define variable v-rid-list as character no-undo .
     3410   IF NOT AVAILABLE TERM_tt-rule-call-param  THEN DO:
     3411     RETURN ERROR.
     3412   END.
     3413   ASSIGN
     3414   v-rec1 = rowid(X_ruledict-param)
     3415   v-rec2 = rowid(X_rp-rule-param)
     3416   v-rec3 = Rowid(tt-rule-call-param)
     3417   v-rec4 = Rowid(term_tt-rule-call-param)
     3418   .
     3419   run rcps_openbr in this-procedure .
     3420   REPOSITION br-rcp TO Rowid v-rec1, v-rec2,v-rec3, v-rec4 NO-ERROR.
     3421   IF ERROR-STATUS:ERROR THEN DO:
     3422     REPOSITION br-rcp TO ROW 1 NO-ERROR.
     3423   END.
     3424   APPLY "ENTRY" TO br-rcp in frame Dialog-Frame .
     3425   APPLY "VALUE-CHANGED" TO br-rcp in frame Dialog-Frame .
     3426   END PROCEDURE.
     3427   PROCEDURE rcps_set-row-color :
     3428   DEFINE INPUT PARAMETER p-data-type AS CHARACTER NO-UNDO.
     3429   ASSIGN
     3430   v-ch[1]:FGCOLOR = GREY_COLOR
     3431   v-ch[1]:BGCOLOR = GREY_Color
     3432   v-ch[1]:PFCOLOR = GREY_Color
     3433   v-ch[2]:FGCOLOR = GREY_COLOR
     3434   v-ch[2]:BGCOLOR = GREY_Color
     3435   v-ch[2]:PFCOLOR = GREY_Color
     3436   v-ch[3]:FGCOLOR = GREY_COLOR
     3437   v-ch[3]:BGCOLOR = GREY_Color
     3438   v-ch[3]:PFCOLOR = GREY_Color
     3439   v-ch[4]:FGCOLOR = GREY_COLOR
     3440   v-ch[4]:BGCOLOR = GREY_Color
     3441   v-ch[4]:PFCOLOR = GREY_Color
     3442   v-ch[5]:FGCOLOR = GREY_COLOR
     3443   v-ch[5]:BGCOLOR = GREY_Color
     3444   v-ch[5]:PFCOLOR = GREY_Color
     3445   .
     3446   CASE entry(1, p-data-type):
     3447        WHEN 'character':U THEN DO:
     3448         ASSIGN
     3449         v-ch[1]:FGCOLOR = BLACK_COLOR
     3450         v-ch[1]:BGCOLOR = WHITE_Color.
     3451       END.
     3452       WHEN 'decimal':U THEN DO:
     3453         ASSIGN
     3454         v-ch[3]:FGCOLOR = BLACK_COLOR
     3455         v-ch[3]:BGCOLOR = WHITE_Color.
     3456       END.
     3457       WHEN 'integer':U THEN DO:
     3458         ASSIGN
     3459         v-ch[4]:FGCOLOR = BLACK_COLOR
     3460         v-ch[4]:BGCOLOR = WHITE_Color.
     3461       END.
     3462       WHEN 'date':U THEN DO:
     3463         ASSIGN
     3464         v-ch[2]:FGCOLOR = BLACK_COLOR
     3465         v-ch[2]:BGCOLOR = WHITE_Color.
     3466        END.
     3467        WHEN 'logical':U THEN DO:
     3468          ASSIGN
     3469          v-ch[5]:FGCOLOR = BLACK_COLOR
     3470          v-ch[5]:BGCOLOR = WHITE_Color.
     3471        END.
     3472   END CASE.
     3473   END PROCEDURE.
     3474   MAIN-BLOCK:
     3475   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3476      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3477   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3478     run mainmenu_getcntxt in parparentproc
     3479       (output v-cntxt-db-num
     3480       ,output v-cntxt-userid
     3481       ,output v-cntxt-level
     3482       ,output v-cntxt-host-code-obj
     3483       ,output v-cntxt-obj-type
     3484       ,output v-cntxt-obj-code
     3485       ,output v-cntxt-db-num-obj
     3486       ,output v-cntxt-is-admin
     3487       ) .
     3488      run gbl/dftempl.p ( input 'rp-rule-param':U
     3489                        , output v-dflt-rec) no-error.
     3490       if error-status:error then dO:
     3491         message
     3492         vss-workfile vss-revision vss-description skip
     3493         "Невозможно найти recid template записи в таблице rp-rule-param"
     3494         view-as alert-box error .
     3495         return error.
     3496       end.
     3497       run gbl/dftempl.p ( input 'ruledict-param':U
     3498                         , output v-rp-dflt-rec) no-error.
     3499        if error-status:error then dO:
     3500          message
     3501          vss-workfile vss-revision vss-description skip
     3502          "Невозможно найти recid template записи в таблице ruledict-param"
     3503          view-as alert-box error .
     3504          return error.
     3505        end.
     3506     IF p-list-mode = 'rp-rule-param':U
     3507     THEN DO:
     3508       FIND FIRST buf_rule-profile NO-LOCK WHERE
     3509                 buf_rule-profile.profile_id = p-profile-id.
     3510       run gen-key-rec in this-procedure ( input 'rule-profile':U
     3511                                       ,input buffer buf_rule-profile:handle
     3512                                       ,output v-uniq-key-rec).
     3513       FIND FIRST buf_ruledict NO-LOCK WHERE
     3514                 buf_ruledict.entry-type = 'rule-profile':U
     3515          AND  buf_ruledict.uniq-key-rec = v-uniq-key-rec.
     3516       v-rcps-entry-id = buf_ruledict.entry-id.
     3517     END.
     3518     ELSE DO:
     3519        MESSAGE
     3520        substitute("Неверное значение параметра p-list-mode=&1", p-list-mode)
     3521        VIEW-AS alert-box.
     3522     END.
     3523     if p-call-id begins 'schedule':U then do:
     3524       v-running-mode = yes.
     3525     end.
     3526     RUN rcps_fill-table IN THIS-PROCEDURE ( input yes).
     3527     RUN Myenable in THIS-PROCEDURE.
     3528     WAIT-FOR GO OF FRAME Dialog-Frame.
     3529   END.
     3530   RUN disable_UI.
     3531   PROCEDURE disable_UI :
     3532     HIDE FRAME Dialog-Frame.
     3533   END PROCEDURE.
     3534   PROCEDURE enable_UI :
     3535     DISPLAY rs-r-b t-is-over f-rule-num f-sum-id f-tot-sum-id-sgd E-rules
     3536             T-rule-sale-out T-rule-trn-out T-rule-recalc T-rule-sale-in
     3537             T-rule-trn-in l-r-b f-dis-rule-name
     3538         WITH FRAME Dialog-Frame.
     3539     ENABLE B-exit b-quit B-Help rs-r-b t-is-over b-dis-gds-add b-dis-gds-delete
     3540            br-dis-gds-rule f-rule-num b-dis-rule f-sum-id b-sum-id
     3541            f-tot-sum-id-sgd b-tot-sum-id-sgd E-rules T-rule-sale-out
     3542            T-rule-trn-out T-rule-recalc T-rule-sale-in T-rule-trn-in BR-rcp
     3543         WITH FRAME Dialog-Frame.
     3544     VIEW FRAME Dialog-Frame.
     3545   END PROCEDURE.
     3546   PROCEDURE move-up-down :
     3547   define parameter buffer source_tt-rule-call-param for tt-rule-call-param.
     3548   define input parameter p-direction as character no-undo.
     3549   define input parameter p-rule-id as integer no-undo.
     3550   define output parameter p-recid as recid no-undo.
     3551   define variable v-source as integer no-undo .
     3552   define variable v-target as integer no-undo .
     3553   define buffer buf_tt-rule-call-param for tt-rule-call-param.
     3554     if not available source_tt-rule-call-param then do:
     3555       bell.
     3556       return no-apply.
     3557     end.
     3558     assign
     3559     v-source = source_tt-rule-call-param.p-index
     3560     p-recid = recid(source_tt-rule-call-param)
     3561     .
     3562     case p-direction:
     3563       when "down" then do:
     3564         find first buf_tt-rule-call-param where
     3565              buf_tt-rule-call-param.param-name = "p-rule-nums"
     3566          and buf_tt-rule-call-param.rule_id = p-rule-id
     3567          and buf_tt-rule-call-param.p-index > v-source no-error.
     3568       end.
     3569       when "up" then do:
     3570         find last buf_tt-rule-call-param where
     3571              buf_tt-rule-call-param.param-name = "p-rule-nums"
     3572          and buf_tt-rule-call-param.rule_id = p-rule-id
     3573          and buf_tt-rule-call-param.p-index < v-source
     3574          and buf_tt-rule-call-param.p-index > 0
     3575          no-error.
     3576       end.
     3577     end case.
     3578     if not available buf_tt-rule-call-param then do:
     3579       bell.
     3580       return no-apply.
     3581     end.
     3582     assign
     3583     v-target = buf_tt-rule-call-param.p-index.
     3584     do transaction
     3585     on error   undo, return no-apply
     3586     on stop    undo, return no-apply
     3587     on end-key undo, return no-apply:
     3588       assign
     3589       buf_tt-rule-call-param.p-index = -99999.
     3590       release buf_tt-rule-call-param.
     3591       assign
     3592       source_tt-rule-call-param.p-index = v-target.
     3593       find first buf_tt-rule-call-param where
     3594              buf_tt-rule-call-param.param-name = "p-rule-nums"
     3595          and buf_tt-rule-call-param.rule_id = p-rule-id
     3596          and buf_tt-rule-call-param.p-index = -99999.
     3597       assign
     3598       buf_tt-rule-call-param.p-index = v-source.
     3599       release buf_tt-rule-call-param.
     3600       release source_tt-rule-call-param.
     3601     end.
     3602   END PROCEDURE.
     3603   PROCEDURE MyEnable :
     3604   define variable v-list as character no-undo .
     3605   define variable glog as logical no-undo .
     3606   define variable v-index-id as integer no-undo .
     3607   define variable v-value-character as character no-undo .
     3608   define variable v-value-date as date no-undo .
     3609   define variable v-value-decimal as decimal no-undo .
     3610   define variable v-value-integer as integer no-undo .
     3611   define variable v-value-logical as logical no-undo .
     3612   define variable v-shop-code as integer no-undo .
     3613   define buffer buf_dis-rule for ub.dis-rule.
     3614   run rcps_Myenable0 in this-procedure .
     3615   ASSIGN
     3616   rs-r-b:RADIO-BUTTONS IN FRAME Dialog-Frame =
     3617   'руб.':U + chr(44) + 'rubl':U + chr(44) +
     3618   'вал.':U + chr(44) + 'base':U
     3619   .
     3620   v-index-id = 0.
     3621   RUN rcps_get-value IN THIS-PROCEDURE (
     3622                                    INPUT p-profile-id
     3623                                   ,INPUT p-once-more
     3624                                   ,INPUT p-call-id
     3625                                   ,INPUT "p-is-over"
     3626                                   ,INPUT-output v-index-id
     3627                                   ,output v-value-character
     3628                                   ,output v-value-date
     3629                                   ,output v-value-decimal
     3630                                   ,output v-value-integer
     3631                                   ,output t-is-over
     3632                                   ).
     3633   v-index-id = 0.
     3634   RUN rcps_get-value IN THIS-PROCEDURE (
     3635                                    INPUT p-profile-id
     3636                                   ,INPUT p-once-more
     3637                                   ,INPUT p-call-id
     3638                                   ,INPUT "p-r-b"
     3639                                   ,INPUT-output v-index-id
     3640                                   ,output rs-r-b
     3641                                   ,output v-value-date
     3642                                   ,output v-value-decimal
     3643                                   ,output v-value-integer
     3644                                   ,output v-value-logical
     3645                                   ).
     3646   v-index-id = 0.
     3647   RUN rcps_get-value IN THIS-PROCEDURE (
     3648                                    INPUT p-profile-id
     3649                                   ,INPUT p-once-more
     3650                                   ,INPUT p-call-id
     3651                                   ,INPUT "p-sum-id"
     3652                                   ,INPUT-output v-index-id
     3653                                   ,output f-sum-id
     3654                                   ,output v-value-date
     3655                                   ,output v-value-decimal
     3656                                   ,output v-value-integer
     3657                                   ,output v-value-logical
     3658                                   ).
     3659   v-index-id = 0.
     3660   RUN rcps_get-value IN THIS-PROCEDURE (
     3661                                    INPUT p-profile-id
     3662                                   ,INPUT p-once-more
     3663                                   ,INPUT p-call-id
     3664                                   ,INPUT "p-tot-sum-id-sgd"
     3665                                   ,INPUT-output v-index-id
     3666                                   ,output f-tot-sum-id-sgd
     3667                                   ,output v-value-date
     3668                                   ,output v-value-decimal
     3669                                   ,output v-value-integer
     3670                                   ,output v-value-logical
     3671                                   ).
     3672   v-index-id = 0.
     3673   RUN rcps_get-value IN THIS-PROCEDURE (
     3674                                    INPUT p-profile-id
     3675                                   ,INPUT p-once-more
     3676                                   ,INPUT p-call-id
     3677                                   ,INPUT "p-rule-num"
     3678                                   ,INPUT-output v-index-id
     3679                                   ,output v-value-character
     3680                                   ,output v-value-date
     3681                                   ,output v-value-decimal
     3682                                   ,output f-rule-num
     3683                                   ,output v-value-logical
     3684                                   ).
     3685   run rcps_get-rule-on-off in this-procedure ( input 2
     3686                                               ,input 1
     3687                                               ,input 1663
     3688                                               ,input p-profile-id
     3689                                               ,input p-once-more
     3690                                               ,output t-rule-sale-out ).
     3691   run rcps_get-rule-on-off in this-procedure ( input 2
     3692                                               ,input 2
     3693                                               ,input 1663
     3694                                               ,input p-profile-id
     3695                                               ,input p-once-more
     3696                                               ,output t-rule-sale-in ).
     3697   run rcps_get-rule-on-off in this-procedure ( input 2
