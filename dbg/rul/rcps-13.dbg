     3270   and lookup("rcpscont_get-rule-on-off", p-call-handle:internal-entries) > 0 then do:
     3271     run rcpscont_get-rule-on-off in p-call-handle (
     3272                                              input p-codex-id
     3273                                             ,input p-ruleset-id
     3274                                             ,input p-rule-id
     3275                                             ,input p-profile-id
     3276                                             ,input p-once-more
