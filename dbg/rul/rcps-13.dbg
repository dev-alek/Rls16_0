     1287        VIEW-AS TOGGLE-BOX
     1288        SIZE 20.5 BY 1 NO-UNDO.
     1289   DEFINE QUERY br-dis-gds-rule FOR
     1290         gds_tt-rule-call-param,
     1291         X_dis-rule SCROLLING.
     1292   DEFINE QUERY BR-rcp FOR
     1293         X_ruledict-param,
     1294         X_rp-rule-param,
     1295         tt-rule-call-param,
     1296         TERM_tt-rule-call-param SCROLLING.
     1297   DEFINE BROWSE br-dis-gds-rule
     1298     QUERY br-dis-gds-rule DISPLAY
     1299         get-param-value( INPUT gds_tt-rule-call-param.param-data-type
     1300                   ,INPUT gds_tt-rule-call-param.param-2-data-type
     1301                   ,INPUT gds_tt-rule-call-param.param-3-data-type
     1302                   ,INPUT gds_tt-rule-call-param.p-index
     1303                   ,INPUT gds_tt-rule-call-param.param-value-character
     1304                   ,INPUT gds_tt-rule-call-param.param-value-date
     1305                   ,INPUT gds_tt-rule-call-param.param-value-decimal
     1306                   ,INPUT gds_tt-rule-call-param.param-value-integer
     1307                   ,INPUT gds_tt-rule-call-param.param-value-logical)
     1308   column-label "Правило скидки" format "X(15)"
     1309   X_dis-rule.des FORMAT "X(255)" WIDTH 80
     1310       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 6.67
     1311            TITLE "Правила скидок типа ФЛАГ УЧАСТИЯ ТОВАРА В ВЫБОРКЕ" ROW-HEIGHT-CHARS .67 FIT-LAST-COLUMN TOOLTIP "Сумма по проданному товару попадает в накопления, если у него есть это правило".
     1312   DEFINE BROWSE BR-rcp
     1313     QUERY BR-rcp DISPLAY
     1314         X_rp-rule-param.rp-param-name COLUMN-LABEL "Название пар-ра!профайла" FORMAT "X(20)" width 16
     1315   term_tt-rule-call-param.codex_id COLUMN-LABEL "Кодекс"
     1316   term_tt-rule-call-param.ruleset_id COLUMN-LABEL "Набор"
     1317   term_tt-rule-call-param.order_id  COLUMN-LABEL "Порядок!вызова"
     1318   term_tt-rule-call-param.rule_id  COLUMN-LABEL "Правило"
     1319   term_tt-rule-call-param.profile_id  COLUMN-LABEL "Профайл"
     1320   term_tt-rule-call-param.once-more COLUMN-LABEL "№!Привязки"
     1321   (if lookup (term_tt-rule-call-param.param-data-type, 'character,date,datetime,datetime-tz,decimal,integer,void,logical,memptr,raw,recid,rowid,widget-handle,handle,blob,clob,class,com-handle,longchar,int64':U) > 0 then entry (lookup (term_tt-rule-call-param.param-data-type, 'character,date,datetime,datetime-tz,decimal,integer,void,logical,memptr,raw,recid,rowid,widget-handle,handle,blob,clob,class,com-handle,longchar,int64':U), 'строка,дата,дата-время,дата-время-з,десятичное,целое,пусто,логическое,память,двоичные,номер записи,Номер Записи,ссылка,ссылка,Больш.бин.объект,Больш.стр.объект,Объект,COM-объект,Длинная строка,64Целое':U) else term_tt-rule-call-param.param-data-type) COLUMN-LABEL "Тип пар-ра" FORMAT "X(12)"
     1322   term_tt-rule-call-param.param-num COLUMN-LABEL "№!пар-ра" FORMAT ">9"
     1323   TERM_tt-rule-call-param.p-index COLUMN-LABEL "Инд!екс" FORMAT ">9"
     1324   term_tt-rule-call-param.param-name COLUMN-LABEL "Название пар-ра!правила" FORMAT "X(16)"
     1325   term_tt-rule-call-param.param-label COLUMN-LABEL "Название пар-ра" FORMAT "X(255)" WIDTH 30
     1326   entry (lookup (term_tt-rule-call-param.param-mode, 'input,output,input-output,buffer,input table,output table,input-output table':u), 'вх,вых,вх-вых,курсор,вх табл,вых табл,вх/вых табл':u) COLUMN-LABEL "Вид!пар-ра"
     1327   get-param-value( INPUT term_tt-rule-call-param.param-data-type
     1328                   ,INPUT term_tt-rule-call-param.param-2-data-type
     1329                   ,INPUT term_tt-rule-call-param.param-3-data-type
     1330                   ,INPUT TERM_tt-rule-call-param.p-index
     1331                   ,INPUT term_tt-rule-call-param.param-value-character
     1332                   ,INPUT term_tt-rule-call-param.param-value-date
     1333                   ,INPUT term_tt-rule-call-param.param-value-decimal
     1334                   ,INPUT term_tt-rule-call-param.param-value-integer
     1335                   ,INPUT term_tt-rule-call-param.param-value-logical) COLUMN-LABEL "Значение" FORMAT "X(255)" WIDTH 26
     1336   (IF term_tt-rule-call-param.param-data-type = 'character':U
     1337    THEN term_tt-rule-call-param.param-value-character
     1338    ELSE '':U) COLUMN-LABEL "Значение!(строковое)" FORMAT "X(26)"
     1339   (IF term_tt-rule-call-param.param-data-type = 'date':U
     1340   THEN STRING(term_tt-rule-call-param.param-value-date, "99/99/9999")
     1341   ELSE '':U)    COLUMN-LABEL "Значение!(Дата)" FORMAT "X(10)" WIDTH 12
     1342   (IF term_tt-rule-call-param.param-data-type = 'decimal':U
     1343   THEN STRING(term_tt-rule-call-param.param-value-decimal)
     1344   ELSE '':U) COLUMN-LABEL "Значение!(Десятичное)"   FORMAT "X(16)"
     1345   (IF term_tt-rule-call-param.param-data-type = 'integer':U
     1346   THEN STRING(term_tt-rule-call-param.param-value-integer)
     1347   ELSE '':U) COLUMN-LABEL "Значение!(Целое)" FORMAT "X(10)"
     1348   (IF term_tt-rule-call-param.param-data-type = 'logical':U
     1349   THEN STRING(term_tt-rule-call-param.param-value-logical, "+/-")
     1350   ELSE '':U) COLUMN-LABEL "Значение!(Логическое)" FORMAT "X(2)"
     1351   calldscr(tt-rule-call-param.call_id) COLUMN-LABEL  "Точка вызова" FORMAT "X(40)"
     1352       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 6
     1353            FONT 4 ROW-HEIGHT-CHARS .67 FIT-LAST-COLUMN.
     1354   DEFINE FRAME Dialog-Frame
     1355        B-exit AT ROW 1 COL 1
     1356        b-quit AT ROW 1 COL 11
     1357        B-Help AT ROW 1 COL 95
     1358        rs-r-b AT ROW 2.07 COL 25.5 NO-LABEL WIDGET-ID 106
     1359        t-is-over AT ROW 2.07 COL 41 WIDGET-ID 88
     1360        b-dis-gds-add AT ROW 2.07 COL 88.5 WIDGET-ID 102
     1361        b-dis-gds-delete AT ROW 2.07 COL 91.5 WIDGET-ID 104
     1362        br-dis-gds-rule AT ROW 3.13 COL 1 WIDGET-ID 200
     1363        f-rule-num AT ROW 10.33 COL 72.5 COLON-ALIGNED WIDGET-ID 110
     1364        b-dis-rule AT ROW 10.33 COL 92 WIDGET-ID 112
     1365        f-sum-id AT ROW 12.47 COL 73 COLON-ALIGNED WIDGET-ID 114
     1366        b-sum-id AT ROW 12.47 COL 92.5 WIDGET-ID 116
     1367        f-tot-sum-id-sgd AT ROW 13.53 COL 73 COLON-ALIGNED WIDGET-ID 118
     1368        b-tot-sum-id-sgd AT ROW 13.53 COL 92.5 WIDGET-ID 120
     1369        E-rules AT ROW 14.6 COL 1 NO-LABEL WIDGET-ID 136
     1370        T-rule-sale-out AT ROW 14.87 COL 33 WIDGET-ID 126
     1371        T-rule-trn-out AT ROW 14.87 COL 51 WIDGET-ID 130
     1372        T-rule-recalc AT ROW 14.87 COL 73 WIDGET-ID 134
     1373        T-rule-sale-in AT ROW 15.87 COL 33 WIDGET-ID 128
     1374        T-rule-trn-in AT ROW 15.87 COL 51 WIDGET-ID 132
     1375        BR-rcp AT ROW 17 COL 1 WIDGET-ID 100
     1376        l-r-b AT ROW 2.07 COL 1.5 NO-LABEL WIDGET-ID 122
     1377        f-dis-rule-name AT ROW 11.4 COL 1.5 NO-LABEL WIDGET-ID 124
     1378        SPACE(0.59) SKIP(11.19)
     1379       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1380            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1381            TITLE ""
     1382            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
     1383   ASSIGN
     1384          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1385          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1386   ASSIGN
     1387          BR-rcp:HIDDEN  IN FRAME Dialog-Frame                = TRUE.
     1388   ASSIGN
     1389          l-r-b:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     1390   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1391   DO:
     1392     APPLY "END-ERROR":U TO SELF.
     1393   END.
     1394   ON CHOOSE OF b-dis-gds-add IN FRAME Dialog-Frame
     1395   DO:
     1396   run proc-b-add in this-procedure ( input "p-rule-nums"
     1397                                     ,input "p-rule-nums"
     1398                                     ,input 1
     1399                                     ,INPUT 1
     1400                                     ,INPUT 1735
     1401                                     ) no-error.
     1402   if not error-status:error then do:
     1403     OPEN QUERY br-dis-gds-rule FOR EACH gds_tt-rule-call-param where              gds_tt-rule-call-param.param-name = "p-rule-nums"          and gds_tt-rule-call-param.rule_id = 1735          and gds_tt-rule-call-param.codex_id = 1          and gds_tt-rule-call-param.ruleset_id = 1          and gds_tt-rule-call-param.p-index > 0,            FIRST X_dis-rule NO-LOCK WHERE X_dis-rule.rule-num = gds_tt-rule-call-param.param-value-integer .
     1404     reposition br-dis-gds-rule to recid recid(term_tt-rule-call-param).
     1405     apply "entry" to br-dis-gds-rule.
     1406   end.
     1407   END.
     1408   ON CHOOSE OF b-dis-gds-delete IN FRAME Dialog-Frame
     1409   DO:
     1410   define variable v-index as integer no-undo .
     1411   define buffer buf_tt-rule-call-param for tt-rule-call-param.
     1412     if not available gds_tt-rule-call-param then do:
     1413       bell.
     1414       return no-apply.
     1415     end.
     1416     v-index = gds_tt-rule-call-param.p-index.
     1417     for each buf_tt-rule-call-param where
     1418             buf_tt-rule-call-param.param-name = "p-rule-nums"
     1419        and buf_tt-rule-call-param.p-index = v-index :
     1420       delete buf_tt-rule-call-param.
     1421     end.
     1422     run resort-rule-call-param in this-procedure( input "p-rule-nums"
     1423                                                   ,input 1735).
     1424     OPEN QUERY br-dis-gds-rule FOR EACH gds_tt-rule-call-param where              gds_tt-rule-call-param.param-name = "p-rule-nums"          and gds_tt-rule-call-param.rule_id = 1735          and gds_tt-rule-call-param.codex_id = 1          and gds_tt-rule-call-param.ruleset_id = 1          and gds_tt-rule-call-param.p-index > 0,            FIRST X_dis-rule NO-LOCK WHERE X_dis-rule.rule-num = gds_tt-rule-call-param.param-value-integer .
     1425     reposition br-dis-gds-rule to row 1.
     1426     apply "entry" to br-dis-gds-rule.
     1427   END.
     1428   ON CHOOSE OF b-dis-rule IN FRAME Dialog-Frame
     1429   DO:
     1430   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     1431   DEFINE VARIABLE v-sts AS INTEGER NO-UNDO.
     1432   DEFINE BUFFER buf_dis-rule FOR ub.dis-rule.
     1433     run ref/dis-ruls.w (   input  parparentproc
     1434                           ,input 0
     1435                           ,input '':U
     1436                           ,input 0
     1437                           ,input "b-sel,b-add"
     1438                           ,input "upper-rule-num"
     1439                           ,input 59
     1440                           ,input ?
     1441                           ,input 0
     1442                           ,input-output v-sts
     1443                           ,input-OUTPUT v-rid-list) NO-ERROR.
     1444     if v-rid-list <> '':U then do:
     1445       find first buf_dis-rule no-lock where
     1446                 recid(buf_dis-rule) = integer(v-rid-list) no-error.
     1447       if not available buf_dis-rule then do:
     1448           MESSAGE substitute("Не найдено правило скидки c recid &1", v-rid-list)
     1449           VIEW-AS ALERT-BOX ERROR.
     1450           UNDO, RETURN NO-APPLY.
     1451       end.
     1452       assign
     1453       f-rule-num = buf_dis-rule.rule-num
     1454       .
     1455       DISPLAY
     1456       f-rule-num
     1457       buf_dis-rule.des @ f-dis-rule-name
     1458       WITH FRAME Dialog-Frame.
     1459     end.
     1460   END.
     1461   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
     1462   DO:
     1463     RUN proc-save IN THIS-PROCEDURE  NO-ERROR.
     1464     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1465   END.
     1466   ON CHOOSE OF b-sum-id IN FRAME Dialog-Frame
     1467   DO:
     1468   define variable v-rid-list as character no-undo .
     1469   define buffer buf_prop-ref for ub.prop-ref.
     1470   run ref/proprefs.w (   input  parparentproc
     1471                         ,input "b-sel,b-add"
     1472                         ,input "dtm-code"
     1473                         ,input  9
     1474                         ,input '':U
     1475                         ,input '':U
     1476                         ,input-OUTPUT v-rid-list) NO-ERROR.
     1477   if v-rid-list = '' then return no-apply.
     1478   find first buf_prop-ref no-lock where
     1479             recid(buf_prop-ref) = integer(v-rid-list) no-error.
     1480   if not available buf_prop-ref then do:
     1481     MESSAGE
     1482     substitute("Нет среза с recid &1", v-rid-list)
     1483     VIEW-AS ALERT-BOX ERROR.
     1484     UNDO, RETURN NO-APPLY.
     1485   end.
     1486   f-sum-id = buf_prop-ref.sum-id.
     1487   display
     1488   f-sum-id
     1489   with frame Dialog-Frame .
     1490   END.
     1491   ON CHOOSE OF b-tot-sum-id-sgd IN FRAME Dialog-Frame
     1492   DO:
     1493   define variable v-rid-list as character no-undo .
     1494   define buffer buf_prop-ref for ub.prop-ref.
     1495   run ref/proprefs.w (   input  parparentproc
     1496                         ,input "b-sel,b-add"
     1497                         ,input "dtm-code"
     1498                         ,input  17
     1499                         ,input '':U
     1500                         ,input '':U
     1501                         ,input-OUTPUT v-rid-list) NO-ERROR.
     1502   find first buf_prop-ref no-lock where
     1503             recid(buf_prop-ref) = integer(v-rid-list) no-error.
     1504   if not available buf_prop-ref then do:
     1505     MESSAGE
     1506     substitute("Нет среза с recid &1", v-rid-list)
     1507     VIEW-AS ALERT-BOX ERROR.
     1508     UNDO, RETURN NO-APPLY.
     1509   end.
     1510   f-tot-sum-id-sgd = buf_prop-ref.sum-id.
     1511   display
     1512   f-tot-sum-id-sgd
     1513   with frame Dialog-Frame .
     1514   END.
     1515   ON VALUE-CHANGED OF t-is-over IN FRAME Dialog-Frame
     1516   DO:
     1517      assign
     1518      t-is-over.
     1519   END.
     1520   ON ROW-DISPLAY OF br-rcp IN frame Dialog-Frame
     1521   DO:
     1522     IF AVAIL tt-rule-call-param THEN DO:
     1523       RUN rcps_set-row-color IN THIS-PROCEDURE ( INPUT term_tt-rule-call-param.param-data-type).
     1524     END.
     1525   END.
     1526   ON f6 anywhere DO:
     1527     ASSIGN
     1528     br-rcp:VISIBLE IN FRAME Dialog-Frame = (NOT br-rcp:VISIBLE IN FRAME Dialog-Frame)
     1529     .
     1530   END.
     1531   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1532   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1533   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1534   on help of frame Dialog-Frame
     1535   do:
     1536     run gbl/app_help.p
     1537       (input this-procedure :file-name
     1538       ,input ''
     1539       ,input ?
     1540       ) no-error.
     1541     if error-status :error then do:
     1542       message
     1543         "Ошибка при вызове помощи"
     1544         error-status :get-message(1)
     1545         view-as alert-box .
     1546     end.
     1547   end.
     1548   run minbtn-set in this-procedure .
     1549   on choose of b-help in frame Dialog-Frame
     1550   do:
     1551     apply "help":u to frame Dialog-Frame .
     1552   end.
     1553   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1554   procedure minbtn-set :
     1555       do
     1556           on error undo, return error return-value
     1557           :
     1558           define variable ii              as integer       no-undo .
     1559           define variable fh              as widget-handle no-undo .
     1560           define variable hh              as widget-handle no-undo .
     1561           define variable v-h             as handle        extent 4 no-undo .
     1562           define variable v-name-button   as character     no-undo .
     1563           define variable v-help-old-x    as decimal       no-undo .
     1564           define variable v-help-old-y    as decimal       no-undo .
     1565           define variable v-help-old-size as decimal       no-undo .
     1566           define variable v-frame-width   as decimal       no-undo .
     1567           define variable jj              as integer       no-undo .
     1568           do
     1569               on error undo, return error
     1570               :
     1571               assign
     1572                   v-frame-width = frame Dialog-Frame:width - 0.3
     1573                   fh            = frame Dialog-Frame:first-child
     1574                   hh            = fh:first-child
     1575                   ii            = 1
     1576                   .
     1577               do while valid-handle(hh):
     1578                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1579                   do:
     1580                       case lc(hh:name) :
     1581                           when "b-help" then
     1582                               do:
     1583                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1584                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1585                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1586                                   hh:TOOLTIP = "Помощь" .
     1587                                   v-help-old-x = hh:column .
     1588                                   v-help-old-y = hh:row    .
     1589                                   v-help-old-size = hh:width .
     1590                                   hh:width-chars = 2.5 .
     1591                               end.
     1592                           when "b-print" then
     1593                               do:
     1594                                   hh:load-image("cmp/b-print.bmp":u) .
     1595                                   hh:TOOLTIP = "Печать" .
     1596                                   v-h[ii] = hh:handle .
     1597                                   ii = ii + 1 .
     1598                                   hh:width-chars = 3 .
     1599                               end.
     1600                           when "b-history" or
     1601                           when "b-hist" then
     1602                               do:
     1603                                   hh:load-image("cmp/b-hist.bmp":u) .
     1604                                   hh:TOOLTIP = "История" .
     1605                                   v-h[ii] = hh:handle .
     1606                                   ii = ii + 1 .
     1607                                   hh:width-chars = 3 .
     1608                               end.
     1609                           when "b-sch" then
     1610                               do:
     1611                                   hh:load-image("cmp/b-sch.bmp":u) .
     1612                                   hh:TOOLTIP = "Установка Фильтра" .
     1613                                   v-h[ii] = hh:handle .
     1614                                   ii = ii + 1 .
     1615                                   hh:width-chars = 3 .
     1616                               end.
     1617                           when "b-hist-user" then
     1618                               do:
     1619                                   hh:load-image("cmp/b-hist.bmp":u) .
     1620                                   hh:TOOLTIP = "История пользователя" .
     1621                                   ii = ii + 1 .
     1622                               end.
     1623                       end case.
     1624                   end.
     1625                   hh = hh:next-sibling.
     1626               end.
     1627               b-help:column = v-frame-width - b-help:width-chars.
     1628               jj = 0.
     1629               repeat ii = 4 to 1 by -1 :
     1630                   if valid-handle (v-h[ii] ) then
     1631                   do:
     1632                       jj  = jj + 1 .
     1633                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1634                       v-h[ii]:row    = v-help-old-y .
     1635                   end.
     1636               end.
     1637           end.
     1638       end.
     1639   end procedure.
     1640   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1641   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1642   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1643   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1644   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1645   define variable v-diasize-current-frame-height as decimal   no-undo .
     1646   define variable v-diasize-change-size          as logical   no-undo .
     1647   define variable v-diasize-resize-button        as handle    no-undo .
     1648   define variable v-diasize-wndmax               as logical   no-undo .
     1649   define variable v-diasize-wndstore             as logical   no-undo .
     1650   define variable v-diasize-proc-name            as character no-undo .
     1651   define variable v-diasize-browse-handle        as handle    no-undo .
     1652   define variable v-diasize-browse-number        as integer   no-undo .
     1653   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1654   define temp-table temp-diasize-handle no-undo
     1655     field handle-value  as handle
     1656     field save-position as decimal
     1657     index xpk is primary unique handle-value
     1658     .
     1659   define temp-table temp-browse-handle no-undo
     1660     field browse-type   as character
     1661     field browse-number as integer
     1662     field browse-handle as handle
     1663     field original-size as decimal
     1664     index xpk is primary unique browse-type browse-number
     1665     index xie browse-type browse-handle
     1666   .
     1667   procedure diasize_change-height :
     1668     define input  parameter p-change-value  as decimal   no-undo .
     1669     define input  parameter p-move-resize   as logical   no-undo .
     1670     define variable v-field-group-handle    as handle    no-undo .
     1671     define variable v-object-handle         as handle    no-undo .
     1672     define variable v-frame-height          as decimal   no-undo .
     1673     define variable v-frame-virtual-height  as decimal   no-undo .
     1674     define variable v-browse-height         as decimal   no-undo .
     1675     define variable v-window-height         as decimal   no-undo .
     1676     define variable v-window-virtual-height as decimal   no-undo .
     1677     define variable v-change-sign           as integer   no-undo .
     1678     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1679     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1680     if p-change-value > 0
     1681     then do:
     1682       if frame Dialog-Frame :height + p-change-value
     1683           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1684       then do:
     1685         assign
     1686           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1687                           - (frame Dialog-Frame :height-chars)
     1688         .
     1689         if p-change-value <= 0
     1690         then do:
     1691           run diasize_position-resize-button in this-procedure .
     1692           return .
     1693         end.
     1694       end.
     1695     end.
     1696     if p-change-value < 0
     1697     then do:
     1698       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1699       then do:
     1700         assign
     1701           p-change-value = v-diasize-orig-frame-height
     1702                          - (frame Dialog-Frame :height-chars)
     1703         .
     1704         if p-change-value >= 0
     1705         then do:
     1706           run diasize_position-resize-button in this-procedure .
     1707           return .
     1708         end.
     1709       end.
     1710     end.
     1711     if p-change-value >= 0
     1712     then do:
     1713       assign
     1714         v-change-sign = 1
     1715       .
     1716     end.
     1717     else do:
     1718       assign
     1719         v-change-sign = -1
     1720       .
     1721     end.
     1722     assign
     1723       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1724     .
     1725     if p-change-value = 0
     1726     then do:
     1727       run diasize_position-resize-button in this-procedure .
     1728       return .
     1729     end.
     1730     move_block:
     1731     do
     1732     on error undo move_block, retry move_block
     1733     :
     1734       if retry
     1735       then do:
     1736         do
     1737         on error undo move_block, leave move_block
     1738         :
     1739           if p-change-value > 0
     1740           then do:
     1741             for each buf_temp-diasize-handle
     1742             on error undo, next
     1743             :
     1744               assign
     1745                 v-object-handle = buf_temp-diasize-handle.handle-value
     1746               .
     1747               if v-object-handle <> v-diasize-resize-button
     1748               then do:
     1749                 assign
     1750                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1751                 .
