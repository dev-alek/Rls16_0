        1   DEFINE BUFFER X_rule-process FOR ub.rule-process.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter bttns as character no-undo.
        4   define input parameter p-list-mode as character no-undo .
        5   define input parameter p-pchain-type as character no-undo .
        6   define input-output parameter p-rid-list as character no-undo.
        7   define variable vss-revision    as character no-undo init "$Revision$":U .
        8   define variable vss-author      as character no-undo init "$Author$":U .
        9   define variable vss-date        as character no-undo init "$Date$":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       11   define variable vss-archive     as character no-undo init "$Archive$":U .
       12   define variable vss-description as character no-undo init "Список rule-process".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       68   define variable v-waitfram-action01         as character   no-undo .
       69   define variable v-waitfram-action02         as character   no-undo .
       70   define variable v-waitfram-action03         as character   no-undo .
       71   define variable mWaitFramTextBeg            as character   no-undo.
       72   define variable mWaitFramTextEnd            as character   no-undo.
       73   define variable mWaitFramView               as logical     no-undo.
       74   define variable mWaitProcEvent              as logical     no-undo init yes.
       75   define variable mWaitFramInterval           as integer     no-undo init 1 .
       76   define variable mWaitFramStop               as logical     no-undo.
       77   define variable mWaitFramStopUser           as logical     no-undo.
       78   define variable mWaitFramStopTimeOut        as logical     no-undo.
       79   define variable mWaitFramStartProc          as datetime-tz no-undo.
       80   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       81   define button B-WaitFramStop auto-end-key
       82        label "Стоп"
       83        size 10 by 1 tooltip "Остоновить процесс".
       84   define button B-viewProcInfo
       85        label "Информация"
       86        size 15 by 1 tooltip "Информация о процесс".
       87   define frame waitfram
       88     v-waitfram-action01 format "x(72)" no-label skip
       89     v-waitfram-action02 format "x(72)" no-label skip
       90     v-waitfram-action03 format "x(72)" no-label skip
       91     B-viewProcInfo
       92     B-WaitFramStop at row 4 col 30
       93     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       94     .
       95   define new global shared variable mBatchMode as logical no-undo init ?.
       96   define variable mFramBachModHandle as handle no-undo.
       97   mFramBachModHandle = frame waitfram:handle.
       98   define variable mFameOldVis as logical no-undo.
       99   define variable mVisCUrentVin as logical no-undo.
      100   if session:batch-mode
      101   then
      102      mBatchMode = yes.
      103   if mBatchMode = ? then do:
      104     mVisCUrentVin = current-window:visible.
      105     mFameOldVis = mFramBachModHandle:visible.
      106     mFramBachModHandle:visible  = yes.
      107     mBatchMode = mFramBachModHandle:visible ne yes.
      108     mFramBachModHandle:visible = mFameOldVis.
      109     current-window:visible = mVisCUrentVin.
      110   end.
      111    if  log-manager:logfile-name ne ?
      112     then DO:
      113         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      114         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      115         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      116     end.
      117   on choose of B-WaitFramStop in frame waitfram
      118   do:
      119     mWaitFramStop = yes.
      120     mWaitFramStopUser = yes.
      121   end.
      122   function waitfram-check-timeout returns logical():
      123      define variable vtime as int64 no-undo.
      124      if mWaitFramStopTimeOut
      125      then
      126         return yes.
      127      vtime = ( now - mWaitFramStartProc ) / 1000 .
      128      if     mWaitFramTimeOut ne ?
      129         and mWaitFramTimeOut ne 0
      130         and mWaitFramTimeOut lt vtime
      131      then do:
      132         mWaitFramStopTimeOut = yes.
      133      end.
      134      return mWaitFramStopTimeOut.
      135   end.
      136   procedure waitfram-hide :
      137     if not session:batch-mode
      138     then do
      139     on error undo, return error return-value
      140     :
      141       pause 0 before-hide .
      142       if not mBatchMode then
      143         hide frame waitfram .
      144     if     not mWaitFramView
      145        and mWaitProcEvent
      146     then
      147       process events .
      148     end.
      149   end procedure.
      150   procedure waitfram-show :
      151     define input  parameter p-message as character no-undo .
      152     define variable v-left-margin as integer   no-undo .
      153     if not session:batch-mode
      154     then do
      155     on error undo, return error return-value
      156     :
      157       if length(p-message) <= 70 then do:
      158         assign
      159           v-left-margin = integer((70 - length(p-message)) / 2)
      160         .
      161         assign
      162           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      163         .
      164         assign
      165           v-waitfram-action01 = " "
      166           v-waitfram-action02 = " "
      167                                    + fill(" ", v-left-margin)
      168                                    + p-message
      169           v-waitfram-action03 = " "
      170         .
      171       end.
      172       else do:
      173         define variable vRindex1 as integer no-undo.
      174         define variable vRindex2 as integer no-undo.
      175         vRindex1 = r-index(p-message," ",70).
      176         if vRindex1 = 0
      177         then
      178            vRindex1 = 70.
      179         if length(p-message)  <= vRindex1 + 70 then do:
      180           assign
      181             v-waitfram-action01 = " "
      182             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      183             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      184           .
      185         end.
      186         else do:
      187           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      188           if vRindex2 <= vRindex1
      189           then
      190              vRindex2 = vRindex1 + 70.
      191           assign
      192             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      193             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      194             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      195           .
      196         end.
      197       end.
      198       B-viewProcInfo:visible   in frame waitfram = no.
      199       B-viewProcInfo:sensitive in frame waitfram = no.
      200       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      201       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      202       if  (   mWaitFramView
      203          or  mWaitProcEvent)
      204          and not mBatchMode
      205       then
      206          display
      207             v-waitfram-action01 skip
      208             v-waitfram-action02 skip
      209             v-waitfram-action03 skip
      210          with frame waitfram .
      211       if     mWaitFramView
      212          then do:
      213             if     mWaitFramInterval ne ?
      214                and not mBatchMode
      215             then
      216                wait-for go of frame waitfram pause mWaitFramInterval.
      217          end.
      218          else
      219             if     mWaitProcEvent
      220                and not mBatchMode
      221             then
      222                process events .
      223     end.
      224   end procedure.
      225      procedure waitfram-show-this:
      226         define input  parameter iInterval as int64 no-undo.
      227         define variable vtime as int64 no-undo.
      228         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      229         mWaitFramInterval = iInterval.
      230         run waitfram-show (substitute("&1&2 &3&4" ,
      231                                       mWaitFramTextBeg ,
      232                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      233                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      234                                       mWaitFramTextEnd
      235                                      )
      236                           ).
      237      end.
      238      procedure WaitFramRunPause:
      239         define input  parameter iInterval as dec no-undo.
      240         define variable vStart  as datetime-tz no-undo.
      241         define variable vend    as datetime-tz no-undo.
      242         define variable vint as int64 no-undo.
      243         define variable vOk as logical no-undo.
      244         vStart = now.
      245         vend   = vStart.
      246         publish "WaitFramPause" (iInterval,output vOk).
      247         vend   =  now.
      248         vint = vend - vStart.
      249         vint = iInterval - vint / 1000.
      250         if     not mWaitFramStop
      251            and (   vint > 0
      252                 or (    not vOk
      253                     and iInterval eq ?
      254                     )
      255                 )
      256         then
      257            run waitfram-show-this (iInterval).
      258         vend   =  now.
      259         vint = vend - vStart.
      260         vint = iInterval - vint / 1000.
      261         if     not mWaitFramStop
      262            and vint > 0
      263         then do:
      264            run gbl/pause.p (vint * 1000).
      265         end.
      266         if iInterval ne ?
      267         then
      268            publish "WaitFramStop".
      269         waitfram-check-timeout().
      270      end.
      271      procedure WaitFramWaitFor:
      272         define input  parameter iInterval as dec no-undo.
      273         assign
      274            mWaitFramStartProc   = now
      275            mWaitFramStopUser    = no
      276            mWaitFramStopTimeOut = no
      277         .
      278         block-wait:
      279         do while not mWaitFramStop:
      280            run WaitFramRunPause (iInterval).
      281            if  waitfram-check-timeout()
      282            then do:
      283               leave block-wait.
      284            end.
      285         end.
      286         run waitfram-hide.
      287      end.
      288   procedure waitfram-join :
      289     define input  parameter p-line-1  as character no-undo .
      290     define input  parameter p-line-2  as character no-undo .
      291     define input  parameter p-line-3  as character no-undo .
      292     define output parameter p-message as character no-undo .
      293     do
      294     on error undo, return error return-value
      295     :
      296       assign
      297         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      298                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      299                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      300       .
      301     end.
      302   end procedure.
      303   function waitfram-join-function returns character
      304     (input p-line-1 as character
      305     ,input p-line-2 as character
      306     ,input p-line-3 as character
      307     ).
      308     define variable v-message as character no-undo .
      309     run waitfram-join in this-procedure
      310       (input  p-line-1
      311       ,input  p-line-2
      312       ,input  p-line-3
      313       ,output v-message
      314       ) .
      315     return v-message .
      316   end function .
      317   define new global shared variable g#language as character no-undo .
      318   if g#language <> '' and g#language <> 'rus':U then do:
      319     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      320   end.
      321   procedure proc-alt-shift-f2:
      322     if not ibs.th.gbl.gbl-var:rcode
      323   then
      324     run gbl\inidebug.p .
      325   end.
      326   procedure proc-alt-shift-f3:
      327     run gbl/prvssinf.p
      328       ( input this-procedure
      329       ) .
      330   end.
      331   define variable v-inform-launched as logical no-undo initial false .
      332   procedure proc-alt-shift-f4:
      333     define variable v-action as character no-undo .
      334     if v-inform-launched = false then do:
      335       assign
      336         v-inform-launched = true
      337       .
      338       run gbl/d-inform.w
      339         (  input self
      340         ,  input this-procedure
      341         , output v-action
      342         ) no-error .
      343       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      344       assign
      345         v-inform-launched = false
      346       .
      347     end.
      348   end.
      349   procedure proc-alt-f1:
      350     run gbl/corrhelp.p
      351       (input this-procedure
      352       ) .
      353   end .
      354   on alt-shift-f2 anywhere do:
      355     run proc-alt-shift-f2.
      356   end.
      357   on alt-shift-f3 anywhere do:
      358     run proc-alt-shift-f3 in this-procedure .
      359   end.
      360   on alt-shift-f4 anywhere do:
      361     run proc-alt-shift-f4 in this-procedure.
      362   end.
      363   on alt-f1 anywhere do:
      364     run proc-alt-f1 in this-procedure .
      365   end.
      366   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      367   FUNCTION mark-string RETURNS CHARACTER
      368     ( input p-recid as recid, input mark-list as character  ) :
      369     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      370   END FUNCTION.
      371   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      372     define variable v-cntxt-db-num        as integer   no-undo .
      373     define variable v-cntxt-userid        as character no-undo .
      374     define variable v-cntxt-level         as character no-undo .
      375     define variable v-cntxt-host-code-obj as integer   no-undo .
      376     define variable v-cntxt-obj-type      as character no-undo .
      377     define variable v-cntxt-obj-code      as integer   no-undo .
      378     define variable v-cntxt-db-num-obj    as integer   no-undo .
      379     define variable v-cntxt-is-admin      as logical   no-undo .
      380   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      381   procedure gen-key-rec :
      382     define input  parameter p-tbl-name    as character no-undo.
      383     define input  parameter p-bh_tbl-name as handle    no-undo.
      384     define output parameter p-key-rec     as character no-undo.
      385     do
      386     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      387     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      388     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      389     :
      390       define variable fh               as handle    no-undo .
      391       define variable v-ok             as logical   no-undo .
      392       define variable v-inform         as character no-undo .
      393       define variable v-ind            as integer   no-undo .
      394       define variable v-idx-field-qnty as integer   no-undo .
      395       if p-tbl-name = ?
      396         or p-tbl-name = "":U
      397       then do:
      398         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info3 ).
      399       end.
      400       if not p-bh_tbl-name:available then do:
      401         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info3, p-tbl-name ).
      402       end.
      403       assign
      404         p-key-rec = p-tbl-name
      405         v-inform  = p-bh_tbl-name:index-information(1)
      406         v-ind     = 2
      407       .
      408       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      409       on error undo, return error
      410       :
      411         assign
      412           v-inform = p-bh_tbl-name:index-information( v-ind )
      413           v-ind    = v-ind + 1
      414         .
      415       end.
      416       if v-inform = ?
      417         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      418         or entry( 3, v-inform, ",":U ) <> "1":U
      419       then do:
      420         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, p-tbl-name ).
      421       end.
      422       else do:
      423         assign
      424           v-idx-field-qnty = num-entries( v-inform ) - 4
      425         .
      426         if v-idx-field-qnty < 2 then do:
      427           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, p-tbl-name ).
      428         end.
      429         do v-ind = 1 to v-idx-field-qnty by 2
      430         on error undo, return error
      431         :
      432           assign
      433             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      434             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      435           .
      436         end.
      437       end.
      438       if p-key-rec = ? then do:
      439         assign
      440           p-key-rec = "":U
      441         .
      442         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info3, p-tbl-name ).
      443       end.
      444     end.
      445     return.
      446   end procedure.
      447   procedure gen-where-keyr-tab :
      448     define input  parameter i-tableSerach as character no-undo.
      449     define input  parameter i-tablekey   as character  no-undo.
      450     define input  parameter p-key-rec    as character  no-undo.
      451     define input  parameter p-key-handle as handle     no-undo .
      452     define input  parameter p-db-name    as character  no-undo .
      453     define input  parameter p-tt-handle  as handle     no-undo .
      454     define output parameter o-Where      as character  no-undo.
      455     do
      456     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      457     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      458     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      459     :
      460       define variable v-full-tbl-name  as character no-undo .
      461       define variable bh_tbl-name      as handle    no-undo .
      462       define variable fh_key           as handle    no-undo .
      463       define variable fh_search        as handle    no-undo .
      464       define variable v-field-num      as integer   no-undo .
      465       define variable v-count-fld      as integer   no-undo .
      466       define variable v-inform         as character no-undo .
      467       define variable v-ind            as integer   no-undo .
      468       define variable v-idx-field-qnty as integer   no-undo .
      469       define variable v-field-name     as character no-undo .
      470       define variable v-field-val      as character no-undo .
      471       define variable v-word-link      as character no-undo .
      472       define variable vTable           as character no-undo.
      473       define variable bh_tbl-key       as handle    no-undo .
      474       assign
      475         p-key-rec = trim( p-key-rec )
      476       .
      477       if p-key-handle <> ? then do:
      478         if not valid-handle(p-key-handle)
      479            or p-key-handle:type <> "buffer"
      480         then do:
      481           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info3 ).
      482         end.
      483         if num-entries( p-key-rec, chr(3) ) > 1
      484           or p-key-rec = ?
      485           or p-key-rec = "":U
      486         then do:
      487           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info3, p-key-rec ).
      488         end.
      489       end.
      490       else do:
      491         if p-key-rec = ?
      492           or p-key-rec = "":U
      493         then do:
      494           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      495         end.
      496       end.
      497       assign
      498         vTable = entry( 1 , p-key-rec, chr(3) )
      499       .
      500       if p-tt-handle <> ?
      501         and ( not valid-handle(p-tt-handle)
      502               or p-tt-handle:type <> "buffer"
      503             )
      504       then do:
      505         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info3, vTable, chr(10) ).
      506       end.
      507       if p-tt-handle = ? then do:
      508         assign
      509           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      510         .
      511         create buffer bh_tbl-name for table v-full-tbl-name .
      512       end.
      513       else do:
      514         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      515       end.
      516       assign
      517         v-inform = bh_tbl-name:index-information(1)
      518         v-ind    = 2
      519       .
      520       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      521       on error undo, return error
      522       :
      523         assign
      524           v-inform = bh_tbl-name:index-information( v-ind )
      525           v-ind    = v-ind + 1
      526         .
      527       end.
      528       if v-inform = ?
      529         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      530         or entry( 3, v-inform, ",":U ) <> "1":U
      531       then do:
      532         delete object bh_tbl-name no-error.
      533         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info3, vTable ).
      534       end.
      535       assign
      536         v-idx-field-qnty = num-entries( v-inform ) - 4
      537       .
      538       if v-idx-field-qnty < 2 then do:
      539         delete object bh_tbl-name no-error.
      540         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, vTable ).
      541       end.
      542       assign
      543         o-where     = "where":U
      544         v-word-link = "":U
      545         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      546         v-count-fld = 0
      547       .
      548       if i-tablekey ne "" and i-tablekey ne ?
      549       then do:
      550         assign
      551           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      552         .
      553         create buffer bh_tbl-key for table v-full-tbl-name .
      554       end.
      555       if i-tableSerach ne "" and i-tableSerach ne ?
      556       then do:
      557         delete object bh_tbl-name no-error.
      558         assign
      559           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      560         .
      561         create buffer bh_tbl-name for table v-full-tbl-name .
      562       end.
      563       block_where:
      564       do v-ind = 1 to v-idx-field-qnty by 2
      565       on error undo, return error
      566       :
      567         assign
      568           v-count-fld = v-count-fld + 1
      569         .
      570         if p-key-handle = ?
      571           and v-count-fld > v-field-num
      572         then do:
      573           leave block_where.
      574         end.
      575         define variable VfieldKeyTable as handle no-undo.
      576         assign
      577           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      578           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      579         .
      580         if     bh_tbl-key ne ?
      581         then do:
      582            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      583            if VfieldKeyTable eq ?
      584            then next block_where.
      585         end.
      586         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      587         then
      588            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      589         else
      590            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      591         if p-key-handle = ? then do:
      592           assign
      593             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      594           .
      595         end.
      596         else do:
      597           assign
      598             fh_key = p-key-handle:buffer-field( v-field-name )
      599           .
      600           if fh_key = ?
      601             or not valid-handle( fh_key )
      602           then do:
      603             delete object bh_tbl-name.
      604             if     bh_tbl-key ne ?
      605             then
      606                delete object bh_tbl-key.
      607             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info3, p-key-handle:name, v-field-name ).
      608           end.
      609           assign
      610             v-field-val = fh_key:buffer-value
      611           .
      612         end.
      613         if fh_search:data-type ="character":U then do:
      614           assign
      615             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      616             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      617             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      618             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      619             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      620             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      621             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      622             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      623             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      624             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      625             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      626             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      627             v-field-val = substitute( '"&1"', v-field-val )
      628           .
      629         end.
      630         assign
      631           o-where = substitute( "&1 &2", o-where, v-field-val )
      632         .
      633         if v-word-link = "":U then do:
      634           assign
      635             v-word-link = "and":U
      636           .
      637         end.
      638       end.
      639       delete object bh_tbl-name.
      640       if     bh_tbl-key ne ?
      641       then
      642          delete object bh_tbl-key.
      643       if p-key-handle = ?
      644         and v-count-fld <> v-field-num
      645       then do:
      646         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info3, vTable ).
      647       end.
      648     end.
      649   end procedure.
      650   procedure gen-hn-keyr-tab :
      651     define input  parameter i-tableSerach as character no-undo.
      652     define input  parameter i-tablekey   as character no-undo.
      653     define input  parameter p-key-rec    as character no-undo.
      654     define input  parameter p-key-handle as handle    no-undo .
      655     define input  parameter p-db-name    as character no-undo .
      656     define input  parameter p-tt-handle  as handle    no-undo .
      657     define input  parameter p-stts-lock  as integer   no-undo .
      658     define output parameter o-hn         as handle    no-undo.
      659     define variable v-full-tbl-name as character no-undo.
      660     define variable v-where         as character no-undo.
      661     define variable bh_tbl-name     as handle    no-undo.
      662     define variable vTable          as character no-undo.
      663     do
      664     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      665     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      666     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      667         run gen-where-keyr-tab(i-tableSerach,
      668                                i-tablekey,
      669                                p-key-rec,
      670                                p-key-handle,
      671                                p-db-name,
      672                                p-tt-handle,
      673                                output v-where).
      674         if i-tableSerach ne "" and i-tableSerach ne ?
      675         then do:
      676            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      677            create buffer bh_tbl-name for table v-full-tbl-name .
      678         end.
      679         else do:
      680            if p-tt-handle = ? then do:
      681               assign
      682                  vTable = entry( 1 , p-key-rec, chr(3) )
      683               .
      684               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      685               create buffer bh_tbl-name for table v-full-tbl-name .
      686            end.
      687            else do:
      688               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      689            end.
      690         end.
      691         if p-tt-handle = ? then do:
      692            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      693         end.
      694         else do:
      695            bh_tbl-name:find-first( v-where ) no-error .
      696         end.
      697         o-hn = bh_tbl-name.
      698      end.
      699   end procedure.
      700   procedure gen-hn-keyr :
      701     define input  parameter p-key-rec    as character no-undo.
      702     define input  parameter p-key-handle as handle    no-undo .
      703     define input  parameter p-db-name    as character no-undo .
      704     define input  parameter p-tt-handle  as handle    no-undo .
      705     define input  parameter p-stts-lock  as integer   no-undo .
      706     define output parameter o-hn         as handle    no-undo.
      707     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      708   end.
      709   procedure gen-row-keyr :
      710     define input  parameter p-key-rec    as character no-undo.
      711     define input  parameter p-key-handle as handle    no-undo .
      712     define input  parameter p-db-name    as character no-undo .
      713     define input  parameter p-tt-handle  as handle    no-undo .
      714     define input  parameter p-stts-lock  as integer   no-undo .
      715     define output parameter p-tbl-row    as rowid     no-undo.
      716     define output parameter p-tbl-name   as character no-undo.
      717     define variable vHn as handle no-undo.
      718       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      719       p-tbl-row = if vHn:available then vHn:rowid else ?.
      720       p-tbl-name =  vHn:table.
      721       delete object vHn no-error.
      722     if p-tbl-row = ? then do:
      723       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info3, p-tbl-name, p-key-rec ).
      724     end.
      725     else do:
      726       return.
      727     end.
      728   end procedure.
      729   procedure gen-key-fv :
      730     define input  parameter p-key-rec    as character no-undo .
      731     define output parameter p-field-list as character no-undo .
      732     define output parameter p-value-list as character no-undo.
      733     do
      734     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      735     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      736     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      737     :
      738       define variable v-full-tbl-name  as character no-undo .
      739       define variable bh_tbl-name      as handle    no-undo .
      740       define variable v-tbl-name       as character no-undo .
      741       define variable v-field-num      as integer   no-undo .
      742       define variable v-count-fld      as integer   no-undo .
      743       define variable v-inform         as character no-undo .
      744       define variable v-ind            as integer   no-undo .
      745       define variable v-idx-field-qnty as integer   no-undo .
      746       define variable v-delim-key      as character no-undo .
      747       if p-key-rec = ?
      748         or p-key-rec = "":U
      749       then do:
      750         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      751       end.
      752       assign
      753         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      754         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      755       .
      756       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      757       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info3 ).
      758       assign
      759         v-inform = bh_tbl-name:index-information(1)
      760         v-ind    = 2
      761       .
      762       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      763       on error undo, return error
      764       :
      765         assign
      766           v-inform = bh_tbl-name:index-information( v-ind )
      767           v-ind    = v-ind + 1
      768         .
      769       end.
      770       if v-inform = ?
      771         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      772         or entry( 3, v-inform, ",":U ) <> "1":U
      773       then do:
      774         delete object bh_tbl-name no-error.
      775         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
      776       end.
      777       assign
      778         v-idx-field-qnty = num-entries( v-inform ) - 4
      779       .
      780       if v-idx-field-qnty < 2 then do:
      781         delete object bh_tbl-name no-error.
      782         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
      783       end.
      784       assign
      785         p-field-list = "":U
      786         p-value-list = "":U
      787         v-delim-key  = "":U
      788         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      789         v-count-fld  = 0
      790       .
      791       block_where:
      792       do v-ind = 1 to v-idx-field-qnty by 2
      793       on error undo, return error
      794       :
      795         assign
      796           v-count-fld = v-count-fld + 1
      797         .
      798         if v-count-fld > v-field-num then do:
      799           leave block_where.
      800         end.
      801         assign
      802           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      803           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      804         .
      805         if v-ind = 1 then do:
      806           assign
      807             v-delim-key = chr(3)
      808           .
      809         end.
      810       end.
      811       delete object bh_tbl-name.
      812       if v-count-fld <> v-field-num then do:
      813         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info3, v-tbl-name ).
      814       end.
      815     end.
      816   end procedure.
      817   procedure gen-key-field :
      818     define input  parameter p-table      as character no-undo .
      819     define output parameter p-field-list as character no-undo .
      820     do
      821     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      822     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      823     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      824     :
      825       define variable v-full-tbl-name  as character no-undo .
      826       define variable bh_tbl-name      as handle    no-undo .
      827       define variable v-tbl-name       as character no-undo .
      828       define variable v-field-num      as integer   no-undo .
      829       define variable v-count-fld      as integer   no-undo .
      830       define variable v-inform         as character no-undo .
      831       define variable v-ind            as integer   no-undo .
      832       define variable v-idx-field-qnty as integer   no-undo .
      833       define variable v-delim-key      as character no-undo .
      834       if p-table = ?
      835         or p-table = "":U
      836       then do:
      837         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info3 ).
      838       end.
      839       assign
      840         v-tbl-name      = p-table
      841         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      842       .
      843       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      844       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info3 ).
      845       assign
      846         v-inform = bh_tbl-name:index-information(1)
      847         v-ind    = 2
      848       .
      849       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      850       on error undo, return error
      851       :
      852         assign
      853           v-inform = bh_tbl-name:index-information( v-ind )
      854           v-ind    = v-ind + 1
      855         .
      856       end.
      857       if v-inform = ?
      858         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      859         or entry( 3, v-inform, ",":U ) <> "1":U
      860       then do:
      861         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
      862       end.
      863       assign
      864         v-idx-field-qnty = num-entries( v-inform ) - 4
      865       .
      866       if v-idx-field-qnty < 2 then do:
      867         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
      868       end.
      869       assign
      870         p-field-list = "":U
      871         v-delim-key  = "":U
      872         v-count-fld  = 0
      873       .
      874       block_where:
      875       do v-ind = 1 to v-idx-field-qnty by 2
      876       on error undo, return error
      877       :
      878         assign
      879           v-count-fld = v-count-fld + 1
      880         .
      881         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      882         if v-ind = 1 then do:
      883           assign
      884             v-delim-key = chr(3)
      885           .
      886         end.
      887       end.
      888       delete object bh_tbl-name.
      889     end.
      890   end procedure.
      891   DEFINE VARIABLE v-doc-rec AS RECID NO-UNDO.
      892   DEFINE VARIABLE link-option AS CHARACTER NO-UNDO.
      893   define variable v-rid-list as character no-undo .
      894   DEFINE TEMP-TABLE tt0-rule-call-param NO-UNDO LIKE ub.rule-call-param.
      895   DEFINE VARIABLE lkp-option AS CHARACTER NO-UNDO.
      896   DEFINE BUTTON b-add
      897        LABEL "&Добавить"
      898        SIZE 10 BY 1.
      899   DEFINE BUTTON b-chg
      900        LABEL "&Изменить"
      901        SIZE 10 BY 1.
      902   DEFINE BUTTON b-copy
      903        LABEL "&Копия"
      904        SIZE 10 BY 1.
      905   DEFINE BUTTON b-del
      906        LABEL "&Удалить"
      907        SIZE 10 BY 1.
      908   DEFINE BUTTON B-Help
      909        LABEL "Помо&щь"
      910        SIZE 3 BY 1
      911        BGCOLOR 8 .
      912   DEFINE BUTTON b-lkp
      913        LABEL "&Просмотр"
      914        SIZE 10 BY 1.
      915   DEFINE BUTTON b-mark
      916        LABEL "&*"
      917        SIZE 4 BY 1.
      918   DEFINE BUTTON b-quit AUTO-END-KEY
      919        LABEL "&Выход"
      920        SIZE 10 BY 1
      921        BGCOLOR 8 .
      922   DEFINE BUTTON b-sel AUTO-GO
      923        LABEL "Выбор"
      924        SIZE 10 BY 1.
      925   DEFINE VARIABLE mark-num AS INTEGER FORMAT "->,>>>,>>9":U INITIAL 0
      926         VIEW-AS TEXT
      927        SIZE 9 BY .67
      928        FGCOLOR 10  NO-UNDO.
      929   DEFINE QUERY br-rule-process FOR
      930         X_rule-process SCROLLING.
      931   DEFINE BROWSE br-rule-process
      932    QUERY br-rule-process NO-LOCK  DISPLAY
      933         mark-string(recid(X_rule-process), v-rid-list) Format "X(1)" COLUMN-LABEL "*"
      934   X_rule-process.pchain-type COLUMN-LABEL "Тип процесса" FORMAT "X(20)"
      935   X_rule-process.pchain-id COLUMN-LABEL "ID" FORMAT "X(30)"
      936   X_rule-process.start-from COLUMN-LABEL "Стар из" FORMAT "99"
      937   X_rule-process.link-id COLUMN-LABEL "LinkID" FORMAT "99"
      938   X_rule-process.codex_id COLUMN-LABEL "Кодекс" FORMAT ">>>>9"
      939   X_rule-process.ruleset_id COLUMN-LABEL "Набор правил" FORMAT ">>>>9"
      940   X_rule-process.run-db0 COLUMN-LABEL "в ГБД" FORMAT "9"
      941   X_rule-process.run-rdb COLUMN-LABEL "в УБД" FORMAT "9"
      942   X_rule-process.link-btwn-profiles COLUMN-LABEL "связь!между!профайлами" FORMAT "9"
      943   X_rule-process.is-export COLUMN-LABEL "Экспорт" FORMAT "9"
      944   X_rule-process.is-import COLUMN-LABEL "Импорт" FORMAT "9"
      945   X_rule-process.needs-efile COLUMN-LABEL "Нужен вых.файл" FORMAT "9"
      946   X_rule-process.needs-ifile COLUMN-LABEL "Нужен вх.файл" FORMAT "9"
      947       WITH NO-ROW-MARKERS SEPARATORS SIZE 97 BY 20.53 FIT-LAST-COLUMN.
      948   DEFINE FRAME Dialog-Frame
      949        b-quit AT ROW 1 COL 1
      950        b-mark AT ROW 1 COL 20 WIDGET-ID 12
      951        b-sel AT ROW 1 COL 24 WIDGET-ID 10
      952        b-add AT ROW 1 COL 34 WIDGET-ID 2
      953        b-copy AT ROW 1 COL 44 WIDGET-ID 16
      954        b-chg AT ROW 1 COL 54 WIDGET-ID 4
      955        b-del AT ROW 1 COL 64 WIDGET-ID 8
      956        b-lkp AT ROW 1 COL 74 WIDGET-ID 6
      957        B-Help AT ROW 1 COL 95
      958        br-rule-process AT ROW 2.33 COL 1.5 WIDGET-ID 100
      959        mark-num AT ROW 1 COL 11 NO-LABEL WIDGET-ID 14
      960        SPACE(78.59) SKIP(21.19)
      961       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      962            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      963            TITLE ""
      964            CANCEL-BUTTON b-quit.
      965   ASSIGN
      966          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      967          FRAME Dialog-Frame:HIDDEN           = TRUE.
      968   ON GO OF FRAME Dialog-Frame
      969   DO:
      970     p-rid-list = v-rid-list.
      971   END.
      972   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      973   DO:
      974     APPLY "END-ERROR":U TO SELF.
      975   END.
      976   ON CHOOSE OF b-add IN FRAME Dialog-Frame
      977   DO:
      978    define variable v-rec as recid no-undo.
      979     run rul/rule-process-i.w ( input parparentproc
      980                          ,input 'ДОБАВЛЕНИЕ':U
      981                          ,input ''
      982                          ,INPUT ''
      983                          ,INPUT 0
      984                          ,INPUT 0
      985                          ,input-output v-rec) no-error.
      986     if v-rec <> ? then do:
      987       RUN openbr IN THIS-PROCEDURE.
      988       reposition br-rule-process to recid v-rec no-error.
      989       apply "entry" to br-rule-process.
      990     end.
      991   END.
      992   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
      993   DO:
      994     define variable v-rec as recid no-undo.
      995     if not available X_rule-process then return no-apply.
      996     v-rec = recid(X_rule-process).
      997     run rul/rule-process-i.w ( input parparentproc
      998                          ,input 'ИЗМЕНЕНИЕ':U
      999                          ,input X_rule-process.pchain-type
     1000                          ,INPUT X_rule-process.pchain-id
     1001                          ,INPUT X_rule-process.start-from
     1002                          ,INPUT X_rule-process.link-id
     1003                          ,input-output v-rec) no-error.
     1004     if v-rec <> ? then do:
     1005        br-rule-process:refresh().
     1006     end.
     1007   END.
     1008   ON CHOOSE OF b-copy IN FRAME Dialog-Frame
     1009   DO:
     1010    define variable v-rec as recid no-undo.
     1011     if not available X_rule-process then return no-apply.
     1012     v-rec = recid(X_rule-process).
     1013     run rul/rule-process-i.w ( input parparentproc
     1014                          ,input 'КОПИРОВАНИЕ':U
     1015                          ,input X_rule-process.pchain-type
     1016                          ,INPUT X_rule-process.pchain-i
     1017                          ,INPUT X_rule-process.start-from
     1018                          ,INPUT X_rule-process.link-id
     1019                          ,input-output v-rec) no-error.
     1020     if v-rec <> ? then do:
     1021       RUN openbr IN THIS-PROCEDURE.
     1022       reposition br-rule-process to recid v-rec no-error.
     1023       apply "entry" to br-rule-process.
     1024     end.
     1025   END.
     1026   ON CHOOSE OF b-del IN FRAME Dialog-Frame
     1027   DO:
     1028     define variable v-rec as recid no-undo.
     1029     define variable glog as logical no-undo.
     1030     if not available X_rule-process then return no-apply.
     1031     v-rec = recid(X_rule-process).
     1032     message
     1033     "Вы уверены, что хотите удалить профайл?"
     1034     view-as alert-box question buttons yes-no update glog.
     1035     if not glog then return no-apply.
     1036    run rul/rule-process3.p (
     1037                              input no
     1038                             ,input v-rec
     1039                             ) no-error.
     1040    if error-status:error then return no-apply.
     1041    run Openbr in this-procedure .
     1042   END.
     1043   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
     1044   DO:
     1045   if not available X_rule-process then return no-apply.
     1046   run proc-b-lkp IN THIS-PROCEDURE ( INPUT 'rule-process':U) NO-ERROR.
     1047   IF ERROR-STATUS:ERROR THEN DO:
     1048       lkp-option = '':U.
     1049       RETURN NO-APPLY.
     1050   END.
     1051   lkp-option = '':U.
     1052   END.
     1053   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
     1054   DO:
     1055     define variable glog as logical no-undo .
     1056     if available X_rule-process then do:
     1057   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1058   define variable v-str-recid5 as character no-undo .
     1059   define variable v-num-entry5 as integer   no-undo .
     1060   assign
     1061     v-str-recid5 = trim( string( recid( X_rule-process ) , "->>>>>>>>>>>9":U ) )
     1062     v-num-entry5 = lookup( v-str-recid5 , v-rid-list )
     1063   .
     1064   if v-num-entry5 > 0 then do:
     1065     assign
     1066       entry( v-num-entry5, v-rid-list ) = "":U
     1067       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1068     .
     1069   end.
     1070   else do:
     1071     assign
     1072       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid5
     1073     .
     1074   end.
     1075     glog = br-rule-process:refresh() .
     1076     if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1077         glog = br-rule-process:select-next-row ().
     1078         apply "VALUE-CHANGED" to br-rule-process in frame Dialog-Frame.
     1079     end.
     1080     if num-entries( v-rid-list ) = 0
     1081     then
     1082         hide mark-num in frame Dialog-Frame.
     1083     else
     1084         disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1085   end.
     1086   apply "entry" to br-rule-process in frame Dialog-Frame.
     1087   END.
     1088   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     1089   DO:
     1090     if available X_rule-process then do:
     1091       if  ( v-rid-list = "" ) or b-mark:sensitive = no
     1092       then  v-rid-list = string( recid( X_rule-process ) ) .
     1093     end.
     1094   END.
     1095   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1096   on f5 of frame Dialog-Frame anywhere
     1097   do:
     1098      v-doc-rec = recid(X_rule-process).    RUn OpenBR in this-procedure.  REPOSITION br-rule-process to recid v-doc-rec No-ERROR.   apply 'value-changed' to br-rule-process.
     1099       apply "VALUE-CHANGED" to br-rule-process.
     1100   end.
     1101   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1102   on help of frame Dialog-Frame
     1103   do:
     1104     run gbl/app_help.p
     1105       (input this-procedure :file-name
     1106       ,input ''
     1107       ,input ?
     1108       ) no-error.
     1109     if error-status :error then do:
     1110       message
     1111         "Ошибка при вызове помощи"
     1112         error-status :get-message(1)
     1113         view-as alert-box .
     1114     end.
     1115   end.
     1116   run minbtn-set in this-procedure .
     1117   on choose of b-help in frame Dialog-Frame
     1118   do:
     1119     apply "help":u to frame Dialog-Frame .
     1120   end.
     1121   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1122   procedure minbtn-set :
     1123       do
     1124           on error undo, return error return-value
     1125           :
     1126           define variable ii              as integer       no-undo .
     1127           define variable fh              as widget-handle no-undo .
     1128           define variable hh              as widget-handle no-undo .
     1129           define variable v-h             as handle        extent 4 no-undo .
     1130           define variable v-name-button   as character     no-undo .
     1131           define variable v-help-old-x    as decimal       no-undo .
     1132           define variable v-help-old-y    as decimal       no-undo .
     1133           define variable v-help-old-size as decimal       no-undo .
     1134           define variable v-frame-width   as decimal       no-undo .
     1135           define variable jj              as integer       no-undo .
     1136           do
     1137               on error undo, return error
     1138               :
     1139               assign
     1140                   v-frame-width = frame Dialog-Frame:width - 0.3
     1141                   fh            = frame Dialog-Frame:first-child
     1142                   hh            = fh:first-child
     1143                   ii            = 1
     1144                   .
     1145               do while valid-handle(hh):
     1146                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1147                   do:
     1148                       case lc(hh:name) :
     1149                           when "b-help" then
     1150                               do:
     1151                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1152                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1153                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1154                                   hh:TOOLTIP = "Помощь" .
     1155                                   v-help-old-x = hh:column .
     1156                                   v-help-old-y = hh:row    .
     1157                                   v-help-old-size = hh:width .
     1158                                   hh:width-chars = 2.5 .
     1159                               end.
     1160                           when "b-print" then
     1161                               do:
     1162                                   hh:load-image("cmp/b-print.bmp":u) .
     1163                                   hh:TOOLTIP = "Печать" .
     1164                                   v-h[ii] = hh:handle .
     1165                                   ii = ii + 1 .
     1166                                   hh:width-chars = 3 .
     1167                               end.
     1168                           when "b-history" or
     1169                           when "b-hist" then
     1170                               do:
     1171                                   hh:load-image("cmp/b-hist.bmp":u) .
     1172                                   hh:TOOLTIP = "История" .
     1173                                   v-h[ii] = hh:handle .
     1174                                   ii = ii + 1 .
     1175                                   hh:width-chars = 3 .
     1176                               end.
     1177                           when "b-sch" then
     1178                               do:
     1179                                   hh:load-image("cmp/b-sch.bmp":u) .
     1180                                   hh:TOOLTIP = "Установка Фильтра" .
     1181                                   v-h[ii] = hh:handle .
     1182                                   ii = ii + 1 .
     1183                                   hh:width-chars = 3 .
     1184                               end.
     1185                           when "b-hist-user" then
     1186                               do:
     1187                                   hh:load-image("cmp/b-hist.bmp":u) .
     1188                                   hh:TOOLTIP = "История пользователя" .
     1189                                   ii = ii + 1 .
     1190                               end.
     1191                       end case.
     1192                   end.
     1193                   hh = hh:next-sibling.
     1194               end.
     1195               b-help:column = v-frame-width - b-help:width-chars.
     1196               jj = 0.
     1197               repeat ii = 4 to 1 by -1 :
     1198                   if valid-handle (v-h[ii] ) then
     1199                   do:
     1200                       jj  = jj + 1 .
     1201                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1202                       v-h[ii]:row    = v-help-old-y .
     1203                   end.
     1204               end.
     1205           end.
     1206       end.
     1207   end procedure.
     1208   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1209   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1210   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1211   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1212   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1213   define variable v-diasize-current-frame-height as decimal   no-undo .
     1214   define variable v-diasize-change-size          as logical   no-undo .
     1215   define variable v-diasize-resize-button        as handle    no-undo .
     1216   define variable v-diasize-wndmax               as logical   no-undo .
     1217   define variable v-diasize-wndstore             as logical   no-undo .
     1218   define variable v-diasize-proc-name            as character no-undo .
     1219   define variable v-diasize-browse-handle        as handle    no-undo .
     1220   define variable v-diasize-browse-number        as integer   no-undo .
     1221   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1222   define temp-table temp-diasize-handle no-undo
     1223     field handle-value  as handle
     1224     field save-position as decimal
     1225     index xpk is primary unique handle-value
     1226     .
     1227   define temp-table temp-browse-handle no-undo
     1228     field browse-type   as character
     1229     field browse-number as integer
     1230     field browse-handle as handle
     1231     field original-size as decimal
     1232     index xpk is primary unique browse-type browse-number
     1233     index xie browse-type browse-handle
     1234   .
     1235   procedure diasize_change-height :
     1236     define input  parameter p-change-value  as decimal   no-undo .
     1237     define input  parameter p-move-resize   as logical   no-undo .
     1238     define variable v-field-group-handle    as handle    no-undo .
     1239     define variable v-object-handle         as handle    no-undo .
     1240     define variable v-frame-height          as decimal   no-undo .
     1241     define variable v-frame-virtual-height  as decimal   no-undo .
     1242     define variable v-browse-height         as decimal   no-undo .
     1243     define variable v-window-height         as decimal   no-undo .
     1244     define variable v-window-virtual-height as decimal   no-undo .
     1245     define variable v-change-sign           as integer   no-undo .
     1246     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1247     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1248     if p-change-value > 0
     1249     then do:
     1250       if frame Dialog-Frame :height + p-change-value
     1251           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1252       then do:
     1253         assign
     1254           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1255                           - (frame Dialog-Frame :height-chars)
     1256         .
     1257         if p-change-value <= 0
     1258         then do:
     1259           run diasize_position-resize-button in this-procedure .
     1260           return .
     1261         end.
     1262       end.
     1263     end.
     1264     if p-change-value < 0
     1265     then do:
     1266       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1267       then do:
     1268         assign
     1269           p-change-value = v-diasize-orig-frame-height
     1270                          - (frame Dialog-Frame :height-chars)
     1271         .
     1272         if p-change-value >= 0
     1273         then do:
     1274           run diasize_position-resize-button in this-procedure .
     1275           return .
     1276         end.
     1277       end.
     1278     end.
     1279     if p-change-value >= 0
     1280     then do:
     1281       assign
     1282         v-change-sign = 1
     1283       .
     1284     end.
     1285     else do:
     1286       assign
     1287         v-change-sign = -1
     1288       .
     1289     end.
     1290     assign
     1291       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1292     .
     1293     if p-change-value = 0
     1294     then do:
     1295       run diasize_position-resize-button in this-procedure .
     1296       return .
     1297     end.
     1298     move_block:
     1299     do
     1300     on error undo move_block, retry move_block
     1301     :
     1302       if retry
     1303       then do:
     1304         do
     1305         on error undo move_block, leave move_block
     1306         :
     1307           if p-change-value > 0
     1308           then do:
     1309             for each buf_temp-diasize-handle
     1310             on error undo, next
     1311             :
     1312               assign
     1313                 v-object-handle = buf_temp-diasize-handle.handle-value
     1314               .
     1315               if v-object-handle <> v-diasize-resize-button
     1316               then do:
     1317                 assign
     1318                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1319                 .
     1320               end.
     1321             end.
     1322             assign
     1323               v-diasize-browse-handle :height = v-browse-height
     1324             .
     1325             for each buf_temp-browse-handle
     1326               where buf_temp-browse-handle.browse-type = 'height':u
     1327             on error undo, next
     1328             :
     1329               assign
     1330                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1331               .
     1332             end.
     1333             assign
     1334               frame Dialog-Frame :height = v-frame-height
     1335             .
     1336             if frame Dialog-Frame :scrollable = true
     1337             then do:
     1338               assign
     1339                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1340               .
     1341             end.
     1342             run diasize_position-resize-button in this-procedure .
     1343           end.
     1344           else do:
     1345             if frame Dialog-Frame :scrollable = true
     1346             then do:
     1347               assign
     1348                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1349               .
     1350             end.
     1351             assign
     1352               frame Dialog-Frame :height = v-frame-height
     1353             .
     1354             assign
     1355               v-diasize-browse-handle :height = v-browse-height
     1356             .
     1357             for each buf_temp-browse-handle
     1358               where buf_temp-browse-handle.browse-type = 'height':u
     1359             on error undo, next
     1360             :
     1361               assign
     1362                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1363               .
     1364             end.
     1365             for each buf_temp-diasize-handle
     1366             on error undo, next
     1367             :
     1368               assign
     1369                 v-object-handle = buf_temp-diasize-handle.handle-value
     1370               .
     1371               if v-object-handle <> v-diasize-resize-button
     1372               then do:
     1373                 assign
     1374                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1375                 .
     1376               end.
     1377             end.
     1378             run diasize_position-resize-button in this-procedure .
     1379           end.
     1380           assign
     1381             v-diasize-change-size = false
     1382           .
     1383           leave move_block .
     1384         end.
     1385       end.
     1386       assign
     1387         v-diasize-need-full-display = true
     1388       .
     1389       if v-diasize-change-size = false
     1390       then do:
     1391         assign
     1392           v-diasize-change-size = true
     1393         .
     1394       end.
     1395       else do:
     1396         return .
     1397       end.
     1398       assign
     1399         v-frame-height = frame Dialog-Frame :height
     1400         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1401         v-browse-height = v-diasize-browse-handle :height
     1402       .
     1403       for each buf_temp-browse-handle
     1404         where buf_temp-browse-handle.browse-type = 'height':u
     1405       :
     1406         assign
     1407           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1408         .
     1409       end.
     1410       for each buf_temp-diasize-handle
     1411       :
     1412         delete buf_temp-diasize-handle .
     1413       end.
     1414       assign
     1415         v-field-group-handle = frame Dialog-Frame :first-child
     1416       .
     1417       do while valid-handle(v-field-group-handle)
     1418       :
     1419         assign
     1420           v-object-handle = v-field-group-handle :first-child
     1421         .
     1422         do while valid-handle(v-object-handle)
     1423         :
     1424           if  v-object-handle <> v-diasize-browse-handle :handle
     1425           and can-query(v-object-handle, "row")
     1426           and can-query(v-object-handle, "height")
     1427           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1428           then do:
     1429             find first buf_temp-browse-handle
     1430               where buf_temp-browse-handle.browse-type   = 'height':u
     1431                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1432               no-error .
     1433             if available buf_temp-browse-handle
     1434             then do:
     1435             end.
     1436             else do:
     1437               create buf_temp-diasize-handle .
     1438               assign
     1439                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1440                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1441               .
     1442             end.
     1443           end.
     1444           assign
     1445             v-object-handle = v-object-handle :next-sibling
     1446           .
     1447         end.
     1448         assign
     1449           v-field-group-handle = v-field-group-handle :next-sibling
     1450         .
     1451       end.
     1452       do with frame Dialog-Frame
     1453       :
     1454         hide v-diasize-resize-button .
     1455         assign
     1456           v-diasize-resize-button :row    = 1
     1457           v-diasize-resize-button :column = 1
     1458         .
     1459       end.
     1460       if p-change-value > 0
     1461       then do:
     1462         if frame Dialog-Frame :scrollable = true
     1463         then do:
     1464           assign
     1465             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1466             no-error .
     1467           if error-status :error
     1468           or error-status :get-message(1) <> ""
     1469           then do:
     1470             undo move_block, retry move_block .
     1471           end.
     1472         end.
     1473         assign
     1474           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1475           no-error .
     1476         if error-status :error
     1477         or error-status :get-message(1) <> ""
     1478         then do:
     1479           undo move_block, retry move_block .
     1480         end.
     1481         assign
     1482           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1483           no-error .
     1484         if error-status :error
     1485         or error-status :get-message(1) <> ""
     1486         then do:
     1487           undo move_block, retry move_block .
     1488         end.
     1489         for each buf_temp-browse-handle
     1490           where buf_temp-browse-handle.browse-type = 'height':u
     1491         on error undo move_block, retry move_block
     1492         :
     1493           assign
     1494             buf_temp-browse-handle.browse-handle :height
     1495               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1496             no-error .
     1497           if error-status :error
     1498           or error-status :get-message(1) <> ""
     1499           then do:
     1500             undo move_block, retry move_block .
     1501           end.
     1502         end.
     1503         for each buf_temp-diasize-handle
     1504         on error undo move_block, retry move_block
     1505         :
     1506           assign
     1507             v-object-handle = buf_temp-diasize-handle.handle-value
     1508           .
     1509           if v-object-handle <> v-diasize-resize-button
     1510           then do:
     1511             assign
     1512               v-object-handle :row = v-object-handle :row + p-change-value
     1513               no-error .
     1514             if error-status :error
     1515             or error-status :get-message(1) <> ""
     1516             then do:
     1517               undo move_block, retry move_block .
     1518             end.
     1519           end.
     1520         end.
     1521       end.
     1522       else do:
     1523         for each buf_temp-diasize-handle
     1524         on error undo move_block, retry move_block
     1525         :
     1526           assign
     1527             v-object-handle = buf_temp-diasize-handle.handle-value
     1528           .
     1529           if v-object-handle <> v-diasize-resize-button
     1530           then do:
     1531             assign
     1532               v-object-handle :row = v-object-handle :row + p-change-value
     1533               no-error .
     1534             if error-status :error
     1535             or error-status :get-message(1) <> ""
     1536             then do:
     1537               undo move_block, retry move_block .
     1538             end.
     1539           end.
     1540         end.
     1541         assign
     1542           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1543           no-error .
     1544         if error-status :error
     1545         or error-status :get-message(1) <> ""
     1546         then do:
     1547           undo move_block, retry move_block .
     1548         end.
     1549         for each buf_temp-browse-handle
     1550           where buf_temp-browse-handle.browse-type = 'height':u
     1551         on error undo move_block, retry move_block
     1552         :
     1553           assign
     1554             buf_temp-browse-handle.browse-handle :height
     1555               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1556             no-error .
     1557           if error-status :error
     1558           or error-status :get-message(1) <> ""
     1559           then do:
     1560             undo move_block, retry move_block .
     1561           end.
     1562         end.
     1563         assign
     1564           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1565           no-error .
     1566         if error-status :error
     1567         or error-status :get-message(1) <> ""
     1568         then do:
     1569           undo move_block, retry move_block .
     1570         end.
     1571         if frame Dialog-Frame :scrollable = true
     1572         then do:
     1573           assign
     1574             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1575             no-error .
     1576           if error-status :error
     1577           or error-status :get-message(1) <> ""
     1578           then do:
     1579             undo move_block, retry move_block .
     1580           end.
     1581         end.
     1582       end.
     1583       if p-move-resize = true
     1584       then do:
     1585         run diasize_position-resize-button in this-procedure .
     1586       end.
     1587       if v-diasize-wndstore = true
     1588       then do:
     1589         if connected("ub") = true
     1590         then do:
     1591           define variable v-cntxt-db-num        as integer   no-undo .
     1592           define variable v-cntxt-userid        as character no-undo .
     1593           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1594                                             , OUTPUT v-cntxt-userid
     1595                                             ) .
     1596           run gbl/wndsizew.p
     1597             (input  v-cntxt-db-num
     1598             ,input  v-cntxt-userid
     1599             ,input  v-diasize-proc-name
     1600             ,input  'height':u
     1601             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1602             ) .
     1603         end.
     1604       end.
     1605     end.
     1606     assign
     1607       v-diasize-change-size = false
     1608     .
     1609   end procedure.
     1610   procedure diasize_set-height :
     1611     define input  parameter p-new-height  as decimal   no-undo .
     1612     define input  parameter p-move-resize as logical   no-undo .
     1613     do
     1614     on error undo, return error return-value
     1615     :
     1616       run diasize_change-height in this-procedure
     1617         (input  (p-new-height - frame Dialog-Frame :height)
     1618         ,input  p-move-resize
     1619         ) .
     1620     end.
     1621   end procedure.
     1622   procedure diasize_change-width :
     1623     define input  parameter p-change-value as decimal   no-undo .
     1624     define input  parameter p-move-resize  as logical   no-undo .
     1625     define variable v-field-group-handle   as handle    no-undo .
     1626     define variable v-object-handle        as handle    no-undo .
     1627     define variable v-frame-width          as decimal   no-undo .
     1628     define variable v-frame-virtual-width  as decimal   no-undo .
     1629     define variable v-browse-width         as decimal   no-undo .
     1630     define variable v-window-width         as decimal   no-undo .
     1631     define variable v-window-virtual-width as decimal   no-undo .
     1632     define variable v-change-sign          as integer   no-undo .
     1633     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1634     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1635     if p-change-value > 0
     1636     then do:
     1637       if frame Dialog-Frame :width + p-change-value >
     1638           session :width-chars
     1639       then do:
     1640         assign
     1641           p-change-value = session :width-chars - frame Dialog-Frame :width
     1642         .
     1643         if p-change-value <= 0
     1644         then do:
     1645           run diasize_position-resize-button in this-procedure .
     1646           return .
     1647         end.
     1648       end.
     1649     end.
     1650     if p-change-value < 0
     1651     then do:
     1652       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1653       then do:
     1654         assign
     1655           p-change-value = v-diasize-orig-frame-width
     1656                          - frame Dialog-Frame :width
     1657         .
     1658         if p-change-value >= 0
     1659         then do:
     1660           run diasize_position-resize-button in this-procedure .
     1661           return .
     1662         end.
     1663       end.
     1664     end.
     1665     if p-change-value >= 0
     1666     then do:
     1667       assign
     1668         v-change-sign = 1
     1669       .
     1670     end.
     1671     else do:
     1672       assign
     1673         v-change-sign = -1
     1674       .
     1675     end.
     1676     assign
     1677       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1678     .
     1679     if p-change-value = 0
     1680     then do:
     1681       run diasize_position-resize-button in this-procedure .
     1682       return .
     1683     end.
     1684     move_block:
     1685     do
     1686     on error undo move_block, leave move_block
     1687     :
     1688       if retry
     1689       then do:
     1690         do
     1691         on error undo move_block, leave move_block
     1692         :
     1693           if p-change-value > 0
     1694           then do:
     1695             for each buf_temp-diasize-handle
     1696             on error undo, next
     1697             :
     1698               assign
     1699                 v-object-handle = buf_temp-diasize-handle.handle-value
     1700               .
     1701               if v-object-handle <> v-diasize-resize-button
     1702               then do:
     1703                 assign
     1704                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1705                 .
     1706               end.
     1707             end.
     1708             assign
     1709               v-diasize-browse-handle :width = v-browse-width
     1710             .
     1711             for each buf_temp-browse-handle
     1712               where buf_temp-browse-handle.browse-type = 'width':u
     1713             on error undo, next
     1714             :
     1715               assign
     1716                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1717               .
     1718             end.
     1719             assign
     1720               frame Dialog-Frame :width = v-frame-width
     1721             .
     1722             if frame Dialog-Frame :scrollable = true
     1723             then do:
     1724               assign
     1725                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1726               .
     1727             end.
     1728             run diasize_position-resize-button in this-procedure .
     1729           end.
     1730           else do:
     1731             if frame Dialog-Frame :scrollable = true
     1732             then do:
     1733               assign
     1734                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1735               .
     1736             end.
     1737             assign
     1738               frame Dialog-Frame :width = v-frame-width
     1739             .
     1740             for each buf_temp-browse-handle
     1741               where buf_temp-browse-handle.browse-type = 'width':u
     1742             on error undo, next
     1743             :
     1744               assign
     1745                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1746               .
     1747             end.
     1748             assign
     1749               v-diasize-browse-handle :width = v-browse-width
     1750             .
     1751             for each buf_temp-diasize-handle
     1752             on error undo, next
     1753             :
     1754               assign
     1755                 v-object-handle = buf_temp-diasize-handle.handle-value
     1756               .
     1757               if v-object-handle <> v-diasize-resize-button
     1758               then do:
     1759                 assign
     1760                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1761                 .
     1762               end.
     1763             end.
     1764             run diasize_position-resize-button in this-procedure .
     1765           end.
     1766           assign
     1767             v-diasize-change-size = false
     1768           .
     1769           leave move_block .
     1770         end.
     1771       end.
     1772       assign
     1773         v-diasize-need-full-display = true
     1774       .
     1775       if v-diasize-change-size = false
     1776       then do:
     1777         assign
     1778           v-diasize-change-size = true
     1779         .
     1780       end.
     1781       else do:
     1782         return .
     1783       end.
     1784       assign
     1785         v-frame-width = frame Dialog-Frame :width
     1786         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1787         v-browse-width = v-diasize-browse-handle :width
     1788       .
     1789       for each buf_temp-browse-handle
     1790         where buf_temp-browse-handle.browse-type = 'width':u
     1791       :
     1792         assign
     1793           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1794         .
     1795       end.
     1796       for each buf_temp-diasize-handle
     1797       :
     1798         delete buf_temp-diasize-handle .
     1799       end.
     1800       assign
     1801         v-field-group-handle = frame Dialog-Frame :first-child
     1802       .
     1803       do while valid-handle(v-field-group-handle)
     1804       :
     1805         assign
     1806           v-object-handle = v-field-group-handle :first-child
     1807         .
     1808         do while valid-handle(v-object-handle)
     1809         :
     1810           if  v-object-handle <> v-diasize-browse-handle :handle
     1811           and v-object-handle <> v-diasize-resize-button
     1812           and can-query(v-object-handle, "row")
     1813           and can-query(v-object-handle, "height")
     1814           and ( v-object-handle :col + v-object-handle :width
     1815                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1816               )
     1817           then do:
     1818             find first buf_temp-browse-handle
     1819               where buf_temp-browse-handle.browse-type   = 'width':u
     1820                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1821               no-error .
     1822             if available buf_temp-browse-handle
     1823             then do:
     1824             end.
     1825             else do:
     1826               create buf_temp-diasize-handle .
     1827               assign
     1828                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1829                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1830               .
     1831             end.
     1832           end.
     1833           assign
     1834             v-object-handle = v-object-handle :next-sibling
     1835           .
     1836         end.
     1837         assign
     1838           v-field-group-handle = v-field-group-handle :next-sibling
     1839         .
     1840       end.
     1841       do with frame Dialog-Frame
     1842       :
     1843         hide v-diasize-resize-button .
     1844         v-diasize-resize-button :row = 1.
     1845         v-diasize-resize-button :column = 1.
     1846       end.
     1847       if p-change-value > 0
     1848       then do:
     1849         if frame Dialog-Frame :scrollable = true
     1850         then do:
     1851           assign
     1852             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1853             no-error .
     1854           if error-status :error
     1855           or error-status :get-message(1) <> ""
     1856           then do:
     1857             undo move_block, retry move_block.
     1858           end.
     1859         end.
     1860         assign
     1861           frame Dialog-Frame :width = v-frame-width + p-change-value
     1862           no-error .
     1863         if error-status :error
     1864         or error-status :get-message(1) <> ""
     1865         then do:
     1866           undo move_block, retry move_block.
     1867         end.
     1868         assign
     1869           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1870         no-error .
     1871         if error-status :error
     1872         or error-status :get-message(1) <> ""
     1873         then do:
     1874           undo move_block, retry move_block.
     1875         end.
     1876         for each buf_temp-browse-handle
     1877           where buf_temp-browse-handle.browse-type = 'width':u
     1878         on error undo move_block, retry move_block
     1879         :
     1880           assign
     1881             buf_temp-browse-handle.browse-handle :width
     1882               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1883             no-error .
     1884           if error-status :error
     1885           or error-status :get-message(1) <> ""
     1886           then do:
     1887             undo move_block, retry move_block .
     1888           end.
     1889         end.
     1890         for each buf_temp-diasize-handle
     1891         on error undo move_block, retry move_block
     1892         :
     1893           assign
     1894             v-object-handle = buf_temp-diasize-handle.handle-value
     1895           .
     1896           if v-object-handle <> v-diasize-resize-button
     1897           then do:
     1898             assign
     1899               v-object-handle :col = v-object-handle :col + p-change-value
     1900               no-error .
     1901             if error-status :error
     1902             or error-status :get-message(1) <> ""
     1903             then do:
     1904               undo move_block, retry move_block .
     1905             end.
     1906           end.
     1907         end.
     1908       end.
     1909       else do:
     1910         for each buf_temp-diasize-handle
     1911         on error undo move_block, retry move_block
     1912         :
     1913           assign
     1914             v-object-handle = buf_temp-diasize-handle.handle-value
     1915           .
     1916           if v-object-handle <> v-diasize-resize-button
     1917           then do:
     1918             assign
     1919               v-object-handle :col = v-object-handle :col + p-change-value
     1920               no-error .
     1921             if error-status :error
     1922             or error-status :get-message(1) <> ""
     1923             then do:
     1924               undo move_block, retry move_block .
     1925             end.
     1926           end.
     1927         end.
     1928         for each buf_temp-browse-handle
     1929           where buf_temp-browse-handle.browse-type = 'width':u
     1930         on error undo move_block, retry move_block
     1931         :
     1932           assign
     1933             buf_temp-browse-handle.browse-handle :width
     1934               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1935             no-error .
     1936           if error-status :error
     1937           or error-status :get-message(1) <> ""
     1938           then do:
     1939             undo move_block, retry move_block .
     1940           end.
     1941         end.
     1942         assign
     1943           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1944           no-error .
     1945         if error-status :error
     1946         or error-status :get-message(1) <> ""
     1947         then do:
     1948           undo move_block, retry move_block.
     1949         end.
     1950         assign
     1951           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1952         no-error .
     1953         if error-status :error
     1954         or error-status :get-message(1) <> ""
     1955         then do:
     1956           undo move_block, retry move_block.
     1957         end.
     1958         if frame Dialog-Frame :scrollable = true
     1959         then do:
     1960           assign
     1961             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1962           no-error .
     1963           if error-status :error
     1964           or error-status :get-message(1) <> ""
     1965           then do:
     1966             undo move_block, retry move_block.
     1967           end.
     1968         end.
     1969       end.
     1970       if p-move-resize
     1971       then do:
     1972         run diasize_position-resize-button in this-procedure .
     1973       end.
     1974       if v-diasize-wndstore = true
     1975       then do:
     1976         if connected("ub") = true
     1977         then do:
     1978           define variable v-cntxt-db-num        as integer   no-undo .
     1979           define variable v-cntxt-userid        as character no-undo .
     1980           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1981                                             , OUTPUT v-cntxt-userid
     1982                                             ) .
     1983           run gbl/wndsizew.p
     1984             (input  v-cntxt-db-num
     1985             ,input  v-cntxt-userid
     1986             ,input  v-diasize-proc-name
     1987             ,input  'width':u
     1988             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1989             ) .
     1990         end.
     1991       end.
     1992     end.
     1993     assign
     1994       v-diasize-change-size = false
     1995     .
     1996   end procedure.
     1997   procedure diasize_set-width :
     1998     define input  parameter p-new-width  as decimal   no-undo .
     1999     define input  parameter p-move-resize as logical   no-undo .
     2000     do
     2001     on error undo, return error return-value
     2002     :
     2003       run diasize_change-width in this-procedure
     2004         (input  (p-new-width - frame Dialog-Frame :width)
     2005         ,input  p-move-resize
     2006         ) .
     2007     end.
     2008   end procedure.
     2009   procedure diasize_position-resize-button :
     2010     do with frame Dialog-Frame
     2011     :
     2012       hide v-diasize-resize-button .
     2013       assign
     2014         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2015                     - 1
     2016                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2017         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2018                     - 1
     2019                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2020       .
     2021       view v-diasize-resize-button .
     2022     end.
     2023   end procedure.
     2024   on alt-right anywhere
     2025   do:
     2026     run diasize_change-width in this-procedure
     2027       (input 1
     2028       ,input true
     2029       ) .
     2030     return no-apply .
     2031   end.
     2032   on alt-left anywhere
     2033   do:
     2034     run diasize_change-width in this-procedure
     2035       (input -1
     2036       ,input true
     2037       ) .
     2038     return no-apply .
     2039   end.
     2040   on alt-down anywhere
     2041   do:
     2042     run diasize_change-height in this-procedure
     2043       (input 1
     2044       ,input true
     2045       ) .
     2046     return no-apply .
     2047   end.
     2048   on alt-up anywhere
     2049   do:
     2050     run diasize_change-height in this-procedure
     2051       (input -1
     2052       ,input true
     2053       ) .
     2054     return no-apply .
     2055   end.
     2056   on alt-enter of frame Dialog-Frame
     2057   do:
     2058     run diasize_maximize in this-procedure
     2059       (input  ?
     2060       ).
     2061     return no-apply .
     2062   end.
     2063   procedure diasize_end-move :
     2064     do
     2065     on error undo, return error return-value
     2066     :
     2067       define variable v-row-delta as decimal   no-undo .
     2068       define variable v-col-delta as decimal   no-undo .
     2069       define variable v-new-row as decimal   no-undo .
     2070       define variable v-new-col as decimal   no-undo .
     2071       assign
     2072         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2073         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2074       .
     2075       assign
     2076         v-row-delta = v-new-row - frame Dialog-Frame :height
     2077         v-col-delta = v-new-col - frame Dialog-Frame :width
     2078       .
     2079       run diasize_change-height in this-procedure
     2080         (input v-row-delta
     2081         ,input true
     2082         ) .
     2083       run diasize_change-width in this-procedure
     2084         (input v-col-delta
     2085         ,input true
     2086         ) .
     2087     end.
     2088   end procedure.
     2089   procedure diasize_maximize :
     2090     define input  parameter p-action as logical   no-undo .
     2091     do
     2092     on error undo, return error return-value
     2093     :
     2094       if p-action = ?
     2095       then do:
     2096         if v-diasize-need-maximize = true
     2097         then do:
     2098           assign
     2099             p-action = true
     2100           .
     2101         end.
     2102         else do:
     2103           assign
     2104             p-action = false
     2105           .
     2106         end.
     2107       end.
     2108       if p-action = true
     2109       then do:
     2110         run diasize_change-height in this-procedure
     2111           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2112               - frame Dialog-Frame :height-chars
     2113           ,input true
     2114           ) .
     2115         run diasize_change-width in this-procedure
     2116           (input session :width-chars
     2117               - frame Dialog-Frame :width-chars
     2118           ,input true
     2119           ) .
     2120         assign
     2121           v-diasize-need-maximize = false
     2122         .
     2123       end.
     2124       else do:
     2125         run diasize_change-width in this-procedure
     2126           (input v-diasize-orig-frame-width
     2127               - frame Dialog-Frame :width-chars
     2128           ,input true
     2129           ) .
     2130         run diasize_change-height in this-procedure
     2131           (input v-diasize-orig-frame-height
     2132               - frame Dialog-Frame :height-chars
     2133           ,input true
     2134           ) .
     2135         assign
     2136           v-diasize-need-maximize = true
     2137         .
     2138       end.
     2139     end.
     2140   end procedure.
     2141   procedure diasize_restore-orig-size :
     2142     do
     2143     on error undo, return error return-value
     2144     :
     2145       assign
     2146         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2147         v-diasize-current-frame-height = frame Dialog-Frame :height
     2148       .
     2149       run diasize_set-height in this-procedure
     2150         (input  v-diasize-orig-frame-height
     2151         ,input  true
     2152         ) .
     2153       run diasize_set-width in this-procedure
     2154         (input  v-diasize-orig-frame-width
     2155         ,input  true
     2156         ) .
     2157     end.
     2158   end procedure.
     2159   procedure diasize_restore-current-size :
     2160     do
     2161     on error undo, return error return-value
     2162     :
     2163       run diasize_set-height in this-procedure
     2164         (input  v-diasize-current-frame-height
     2165         ,input  true
     2166         ) .
     2167       run diasize_set-width in this-procedure
     2168         (input  v-diasize-current-frame-width
     2169         ,input  true
     2170         ) .
     2171     end.
     2172   end procedure.
     2173   procedure diasize_set-browse-handle :
     2174     define input  parameter p-browse-handle as handle   no-undo .
     2175     define buffer buf_temp-browse-handle for temp-browse-handle .
     2176     do
     2177     on error undo, return error return-value
     2178     :
     2179       assign
     2180         v-diasize-browse-handle = p-browse-handle
     2181       .
     2182       for each buf_temp-browse-handle
     2183       on error undo, return error return-value
     2184       :
     2185         delete buf_temp-browse-handle .
     2186       end.
     2187     end.
     2188   end procedure.
     2189   procedure diasize_add_browse :
     2190     define input  parameter p-browse-type   as character no-undo .
     2191     define input  parameter p-browse-handle as handle    no-undo .
     2192     define buffer buf_temp-browse-handle for temp-browse-handle .
     2193     do
     2194     on error undo, return error return-value
     2195     :
     2196       assign
     2197         v-diasize-browse-number = v-diasize-browse-number + 1
     2198       .
     2199       create buf_temp-browse-handle .
     2200       assign
     2201         buf_temp-browse-handle.browse-type   = p-browse-type
     2202         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2203         buf_temp-browse-handle.browse-handle = p-browse-handle
     2204       .
     2205     end.
     2206   end procedure.
     2207   procedure diasize_init :
     2208     define variable v-default-value    as logical   no-undo .
     2209     define variable v-restore-saved    as logical   no-undo .
     2210     define variable v-resize-value-str as character no-undo .
     2211     do
     2212     on error undo, return error return-value
     2213     :
     2214       do with frame Dialog-Frame
     2215       :
     2216         assign
     2217           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2218           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2219           v-diasize-browse-handle     = browse br-rule-process :handle
     2220         .
     2221         create button v-diasize-resize-button
     2222         assign
     2223           parent        = frame Dialog-Frame :first-child
     2224           label         = "s"
     2225           height-pixels = 16
     2226           width-pixels  = 16
     2227           visible       = true
     2228           sensitive     = true
     2229           movable       = true
     2230           triggers:
     2231             on end-move persistent run diasize_end-move in this-procedure .
     2232           end triggers.
     2233         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2234         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2235         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2236         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2237         assign
     2238           v-diasize-wndmax = false
     2239         .
     2240         if connected("ub") = true
     2241         then do:
     2242           define variable v-cntxt-db-num        as integer   no-undo .
     2243           define variable v-cntxt-userid        as character no-undo .
     2244           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2245                                             , OUTPUT v-cntxt-userid
     2246                                             ) .
     2247           run gbl/wndpar_r.p
     2248             (input  v-cntxt-db-num
     2249             ,input  v-cntxt-userid
     2250             ,input  'wndmax':U
     2251             ,output v-diasize-wndmax
     2252             ,output v-default-value
     2253             ) .
     2254         end.
     2255         assign
     2256           v-diasize-wndstore = false
     2257         .
     2258         if connected("ub") = true
     2259         then do:
     2260           run gbl/wndpar_r.p
     2261             (input  v-cntxt-db-num
     2262             ,input  v-cntxt-userid
     2263             ,input  'wndstore':U
     2264             ,output v-diasize-wndstore
     2265             ,output v-default-value
     2266             ) .
     2267         end.
     2268         assign
     2269           v-diasize-proc-name = entry(1, program-name(2), '.')
     2270         .
     2271         if v-diasize-wndstore = true
     2272         then do:
     2273           assign
     2274             v-restore-saved = false
     2275           .
     2276           if connected("ub") = true
     2277           then do:
     2278             run gbl/wndsizer.p
     2279               (input  v-cntxt-db-num
     2280               ,input  v-cntxt-userid
     2281               ,input  v-diasize-proc-name
     2282               ,input  'height':u
     2283               ,output v-resize-value-str
     2284               ) .
     2285             if v-resize-value-str <> '':U
     2286             then do:
     2287               run diasize_change-height in this-procedure
     2288                 (input  integer(v-resize-value-str)
     2289                 ,input  true
     2290                 ) .
     2291               assign
     2292                 v-restore-saved = true
     2293               .
     2294             end.
     2295           end.
     2296           if connected("ub") = true
     2297           then do:
     2298             run gbl/wndsizer.p
     2299               (input  v-cntxt-db-num
     2300               ,input  v-cntxt-userid
     2301               ,input  v-diasize-proc-name
     2302               ,input  'width':u
     2303               ,output v-resize-value-str
     2304               ) .
     2305             if v-resize-value-str <> '':U
     2306             then do:
     2307               run diasize_change-width in this-procedure
     2308                 (input  integer(v-resize-value-str)
     2309                 ,input  true
     2310                 ) .
     2311               assign
     2312                 v-restore-saved = true
     2313               .
     2314             end.
     2315           end.
     2316           if v-restore-saved <> true
     2317           then do:
     2318             if v-diasize-wndmax = true
     2319             then do:
     2320               run diasize_maximize in this-procedure
     2321                 (input  true
     2322                 ) .
     2323             end.
     2324           end.
     2325         end.
     2326         else do:
     2327           if v-diasize-wndmax = true
     2328           then do:
     2329             run diasize_maximize in this-procedure
     2330               (input  true
     2331               ) .
     2332           end.
     2333         end.
     2334       end.
     2335     end.
     2336   end procedure.
     2337   procedure diasize_need-full-display :
     2338     define output parameter p-need-full-display as logical   no-undo .
     2339     do
     2340     on error undo, return error return-value
     2341     :
     2342       assign
     2343         p-need-full-display = v-diasize-need-full-display
     2344       .
     2345       assign
     2346         v-diasize-need-full-display = false
     2347       .
     2348     end.
     2349   end procedure.
     2350   procedure get-context :
     2351      define output parameter p-db-num as integer          no-undo.
     2352      define output parameter p-user-id as character        no-undo.
     2353      define variable v-login               as character    no-undo.
     2354      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2355      define buffer buf_user-login  for ub.user-login .
     2356      do
     2357      on error undo, return error
     2358      :
     2359            FIND FIRST buf_sys-ctrl no-lock.
     2360            ASSIGN
     2361               v-login = USERID("ub")
     2362               p-db-num = buf_sys-ctrl.db-num
     2363            .
     2364            FIND FIRST buf_user-login
     2365                 WHERE buf_user-login.db-num = p-db-num
     2366                   AND buf_user-login.user-login = v-login
     2367                 no-lock
     2368                 no-error
     2369                 .
     2370            IF AVAILABLE buf_user-login
     2371            THEN DO:
     2372               assign
     2373                  p-user-id = buf_user-login.user-id
     2374               .
     2375            END.
     2376      end.
     2377   end procedure.
     2378       run diasize_init in this-procedure .
     2379   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2380   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2381   MAIN-BLOCK:
     2382   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2383      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2384   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2385     run mainmenu_getcntxt in parparentproc
     2386       (output v-cntxt-db-num
     2387       ,output v-cntxt-userid
     2388       ,output v-cntxt-level
     2389       ,output v-cntxt-host-code-obj
     2390       ,output v-cntxt-obj-type
     2391       ,output v-cntxt-obj-code
     2392       ,output v-cntxt-db-num-obj
     2393       ,output v-cntxt-is-admin
     2394       ) .
     2395     run Myenable in this-procedure .
     2396     v-rid-list = p-rid-list.
     2397     WAIT-FOR GO OF FRAME Dialog-Frame.
     2398   END.
     2399   RUN disable_UI.
     2400   PROCEDURE disable_UI :
     2401     HIDE FRAME Dialog-Frame.
     2402   END PROCEDURE.
     2403   PROCEDURE enable_UI :
     2404     DISPLAY mark-num
     2405         WITH FRAME Dialog-Frame.
     2406     ENABLE b-quit b-mark b-sel b-add b-copy b-chg b-del b-lkp B-Help
     2407            br-rule-process mark-num
     2408         WITH FRAME Dialog-Frame.
     2409     VIEW FRAME Dialog-Frame.
     2410     RUN openbr IN THIS-PROCEDURE.
     2411   END PROCEDURE.
     2412   PROCEDURE MyEnable :
     2413   ASSIGN
     2414   X_rule-process.pchain-type:RESIZABLE IN BROWSE br-rule-process = YES
     2415   X_rule-process.pchain-id:RESIZABLE IN BROWSE br-rule-process = YES
     2416   .
     2417   ENABLE
     2418   b-quit
     2419   b-add when (lookup("b-add", bttns) > 0 and v-cntxt-db-num = 0)
     2420   b-copy when (lookup("b-add", bttns) > 0 and v-cntxt-db-num = 0)
     2421   b-chg when (lookup("b-add", bttns) > 0 and v-cntxt-db-num = 0)
     2422   b-del when (lookup("b-add", bttns) > 0 and v-cntxt-db-num = 0)
     2423   b-lkp
     2424   B-Help
     2425   b-mark when lookup("b-mark", bttns) > 0
     2426   b-sel when lookup("b-sel", bttns) > 0
     2427   br-rule-process
     2428   WITH FRAME Dialog-Frame.
     2429   VIEW FRAME Dialog-Frame.
     2430   if p-list-mode = "pchain-type" then do:
     2431     assign
     2432     X_rule-process.pchain-type:visible in browse br-rule-process = no.
     2433   end.
     2434   run Openbr in this-procedure .
     2435   END PROCEDURE.
     2436   PROCEDURE Openbr :
     2437   CASE p-list-mode:
     2438      when 'все':U then do:
     2439         frame Dialog-Frame :title = "Все звенья процессов".
     2440         OPEN QUERY br-rule-process
     2441         FOR EACH X_rule-process NO-LOCK INDEXED-REPOSITION.
     2442      end.
     2443      when "pchain-type" then do:
     2444         frame Dialog-Frame :title = substitute("Звенья процессов типа &1", p-pchain-type).
     2445         OPEN QUERY br-rule-process
     2446         FOR EACH X_rule-process NO-LOCK where
     2447                  X_rule-process.pchain-type = p-pchain-type
     2448        INDEXED-REPOSITION
     2449         .
     2450      end.
     2451   end case.
     2452   END PROCEDURE.
     2453   PROCEDURE proc-b-lkp :
     2454   DEFINE INPUT PARAMETER p-option AS CHARACTER NO-UNDO.
     2455   define variable v-rec as recid no-undo.
     2456   CASE p-option:
     2457     WHEN 'rule-process':U THEN DO:
     2458         run rul/rule-process-i.w ( input parparentproc
     2459                              ,input 'ПРОСМОТР':U
     2460                              ,input X_rule-process.pchain-type
     2461                              ,INPUT X_rule-process.pchain-id
     2462                              ,INPUT X_rule-process.start-from
     2463                              ,INPUT X_rule-process.link-id
     2464                              ,input-output v-rec) no-error.
     2465     END.
     2466   END CASE.
     2467   IF ERROR-STATUS:ERROR THEN UNDO, RETURN ERROR.
     2468   END PROCEDURE.
