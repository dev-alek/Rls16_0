        1   block-level on error undo, throw.
        2   define input parameter p-call-type as character no-undo .
        3   define input parameter p-call-id as character no-undo .
        4   define output parameter p-call#-id as integer no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision$":U .
        6   define variable vss-author      as character no-undo init "$Author$":U .
        7   define variable vss-date        as character no-undo init "$Date$":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        9   define variable vss-archive     as character no-undo init "$Archive$":U .
       10   define variable vss-description as character no-undo init "Получение значения уникального ключа привязки правила , профайла".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   define   shared variable g#auto as logical no-undo.
       72   define   shared variable g#news as logical no-undo.
       73   define   shared variable g#oxml as logical no-undo.
       74   define   shared variable g#esys as logical no-undo.
       75   define   shared variable g#news-source-db as integer no-undo.
       76   define   shared variable g#esys-source-esys as integer no-undo.
       77   define   shared variable g#db-num as integer   no-undo .
       78   define   shared variable g#userid as character no-undo .
       79   define   shared variable g#passwd as character no-undo .
       80   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       81   procedure gen-b-code :
       82     define input  parameter type-code like ub.code-range.range-type no-undo .
       83     define output parameter p-b-code  like ub.bar-code.b-code       no-undo .
       84     do
       85     on error  undo, return error substitute( "&1 (gen-b-code). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
       86     on stop   undo, return error substitute( "&1 (gen-b-code). stop", vss-workfile )
       87     on endkey undo, return error substitute( "&1 (gen-b-code). endkey", vss-workfile )
       88     :
       89       define buffer buf_thbj-attr     for ub.thbj-attr .
       90       define buffer buf_sys-ctrl   for ub.sys-ctrl .
       91       define buffer buf_code-range for ub.code-range .
       92       define variable l-code         as   integer              no-undo .
       93       define variable v-db-num       like ub.db.db-num         no-undo .
       94       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
       95       if type-code = 'sslc':U
       96       or type-code = 'ssgb':U
       97       then do:
       98         message
       99           "Нельзя генерировать локальный или глобальный взвешиваемый код." skip
      100           "Обратитесь к администратору системы."
      101           view-as alert-box error .
      102         undo, return error (if type-code = 'sslc':U then "loc-ss-code":U else "gbl-ss-code" ) .
      103       end.
      104       run trg/getpcode.p ( input  type-code
      105                      ,output cfg-param-code
      106                     ).
      107       run get-next-seq( input  type-code,
      108                         output l-code
      109                       ).
      110       find first buf_sys-ctrl no-lock.
      111       if type-code = 'sclc':U
      112       or type-code = 'pglc':U
      113       then do:
      114         assign
      115           v-db-num = 0
      116         .
      117       end.
      118       else do:
      119         assign
      120           v-db-num = buf_sys-ctrl.db-num
      121         .
      122       end.
      123       find first buf_code-range no-lock
      124         where buf_code-range.db-num     = v-db-num
      125           and buf_code-range.range-type = type-code
      126           and buf_code-range.stts       = "a"
      127         use-index stts
      128         no-error .
      129       if available buf_code-range
      130          and l-code <= buf_code-range.last-code
      131          and l-code >= buf_code-range.first-code then do:
      132         assign
      133           p-b-code = l-code
      134         .
      135       end.
      136       else do:
      137         if available buf_code-range
      138            and l-code < buf_code-range.last-code then do:
      139           message
      140             substitute( "Последовательность для создания кодов с типом &1 имеет неверное значение.", type-code ) skip
      141             "Обратитесь к администратору системы."
      142             view-as alert-box error .
      143           undo, return error "sequence":U .
      144         end.
      145         do transaction
      146         on error undo, return error
      147         :
      148           find first buf_thbj-attr exclusive-lock
      149             where buf_thbj-attr.upper-prop-code = 'code-range':U
      150               and buf_thbj-attr.prop-code = cfg-param-code
      151               and buf_thbj-attr.obj-type   = 'БД':U
      152               and buf_thbj-attr.obj-code   = v-db-num
      153             no-error .
      154           if not available buf_thbj-attr then do:
      155             find first buf_thbj-attr exclusive-lock
      156               where buf_thbj-attr.upper-prop-code = 'code-range':U
      157                 and buf_thbj-attr.prop-code = cfg-param-code
      158                 and buf_thbj-attr.obj-type   = ''
      159                 and buf_thbj-attr.obj-code   = 0
      160               no-error .
      161             if not available buf_thbj-attr then do:
      162               if not locked buf_thbj-attr then do:
      163                 message
      164                   substitute( "Отсутствует параметр 'длина диапазона кодов' (&1) для БД &2.", cfg-param-code, buf_sys-ctrl.db-num ) skip
      165                   "Обратитесь к администратору системы."
      166                   view-as alert-box error .
      167               end.
      168               undo, return error "config":U .
      169             end.
      170           end.
      171           run get-next-seq( input type-code,
      172                             output l-code
      173                           ).
      174           find first buf_code-range
      175             where buf_code-range.db-num     = v-db-num
      176               and buf_code-range.range-type = type-code
      177               and buf_code-range.stts       = "a"
      178             use-index stts
      179             no-error .
      180           if available buf_code-range
      181           and l-code <= buf_code-range.last-code
      182           and l-code >= buf_code-range.first-code
      183           then do:
      184             assign
      185               p-b-code = l-code
      186             .
      187           end.
      188           else do:
      189             if available buf_code-range then do:
      190               assign
      191                 buf_code-range.stts = "u"
      192               .
      193             end.
      194             find first buf_code-range
      195               where buf_code-range.db-num     = v-db-num
      196                 and buf_code-range.range-type = type-code
      197                 and buf_code-range.stts       = "f"
      198               use-index stts
      199               no-error .
      200             if not available buf_code-range then do:
      201               message
      202                 substitute( "Отсутствует свободный диапазон для кодов с типом &1.", type-code ) skip
      203                 "Обратитесь к администратору системы"
      204                 view-as alert-box error .
      205               undo, return error "code-range":U .
      206             end.
      207             assign
      208               buf_code-range.stts           = "a"
      209             .
      210             if buf_code-range.first-code = 1 then do:
      211               run set-seq-cr( input type-code,
      212                               input buf_code-range.first-code
      213                             ).
      214               assign
      215                 p-b-code = 1
      216               .
      217             end.
      218             else do:
      219               run set-seq-cr( input type-code,
      220                               input ( buf_code-range.first-code - 1 )
      221                             ).
      222               run get-next-seq( input type-code,
      223                                 output p-b-code
      224                               ).
      225             end.
      226           end.
      227         end.
      228       end.
      229     end.
      230   end procedure.
      231   procedure get-next-seq :
      232     define input  parameter type-code like ub.code-range.range-type no-undo .
      233     define output parameter next-seq  as   integer                  no-undo .
      234     do
      235     on error  undo, return error substitute( "&1 (get-next-seq). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      236     on stop   undo, return error substitute( "&1 (get-next-seq). stop", vss-workfile )
      237     on endkey undo, return error substitute( "&1 (get-next-seq). endkey", vss-workfile )
      238     :
      239       case type-code:
      240         when 'bcgb':U then do:
      241           assign
      242             next-seq = next-value(s-bcgb-code, ub)
      243           .
      244         end.
      245         when 'scgb':U then do:
      246           assign
      247             next-seq = next-value(s-scgb-code, ub)
      248           .
      249         end.
      250         when 'sclc':U then do:
      251           assign
      252             next-seq = next-value(s-sclc-code, ub)
      253           .
      254         end.
      255         when 'pglc':U then do:
      256           assign
      257             next-seq = next-value(s-pglc-code, ub)
      258           .
      259         end.
      260         when 'dcgb':U then do:
      261           assign
      262             next-seq = next-value(s-dcgb-code, ub)
      263           .
      264         end.
      265         when 'ctgb':U then do:
      266           assign
      267             next-seq = next-value(s-ctgb-code, ub)
      268           .
      269         end.
      270         when 'drgb':U then do:
      271           assign
      272             next-seq = next-value(s-drgb-code, ub)
      273           .
      274         end.
      275         when 'fmgb':U then do:
      276           assign
      277             next-seq = next-value(s-fmgb-code, ub)
      278           .
      279         end.
      280         when 'pngb':U then do:
      281           assign
      282             next-seq = next-value(s-pngb-code, ub)
      283           .
      284         end.
      285         when 'cagb':U then do:
      286           assign
      287             next-seq = next-value(s-cagb-code, ub)
      288           .
      289         end.
      290         when 'fdgb':U then do:
      291           assign
      292             next-seq = next-value(s-fin-doc, ub)
      293           .
      294         end.
      295       end case.
      296     end.
      297   end procedure.
      298   procedure set-seq-cr :
      299     define input parameter type-code like ub.code-range.range-type no-undo .
      300     define input parameter set-val   like ub.code-range.first-code no-undo .
      301     do
      302     on error  undo, return error substitute( "&1 (set-seq-cr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      303     on stop   undo, return error substitute( "&1 (set-seq-cr). stop", vss-workfile )
      304     on endkey undo, return error substitute( "&1 (set-seq-cr). endkey", vss-workfile )
      305     :
      306       case type-code:
      307         when 'bcgb':U then do:
      308           assign
      309             current-value(s-bcgb-code, ub) = set-val
      310           .
      311         end.
      312         when 'scgb':U then do:
      313           assign
      314             current-value(s-scgb-code, ub) = set-val
      315           .
      316         end.
      317         when 'sclc':U then do:
      318           assign
      319             current-value(s-sclc-code, ub) = set-val
      320           .
      321         end.
      322         when 'pglc':U then do:
      323           assign
      324             current-value(s-pglc-code, ub) = set-val
      325           .
      326         end.
      327         when 'dcgb':U then do:
      328           assign
      329             current-value(s-dcgb-code, ub) = set-val
      330           .
      331         end.
      332         when 'ctgb':U then do:
      333           assign
      334             current-value(s-ctgb-code, ub) = set-val
      335           .
      336         end.
      337         when 'drgb':U then do:
      338           assign
      339             current-value(s-drgb-code, ub) = set-val
      340           .
      341         end.
      342         when 'fmgb':U then do:
      343           assign
      344             current-value(s-fmgb-code, ub) = set-val
      345           .
      346         end.
      347         when 'pngb':U then do:
      348           assign
      349             current-value(s-pngb-code, ub) = set-val
      350           .
      351         end.
      352         when 'cagb':U then do:
      353           assign
      354             current-value(s-cagb-code, ub) = set-val
      355           .
      356         end.
      357         when 'fdgb':U then do:
      358           assign
      359             current-value(s-fin-doc, ub) = set-val
      360           .
      361         end.
      362       end case.
      363     end.
      364   end procedure.
      365   procedure new-bcod-gen-code-range :
      366     do
      367     on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      368     on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
      369     on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
      370     :
      371       define input parameter p-db-num  like ub.db.db-num             no-undo .
      372       define input parameter type-code like ub.code-range.range-type no-undo .
      373       define buffer buf_code-range      for ub.code-range .
      374       define buffer last_code-range     for ub.code-range .
      375       define buffer last-1_code-range   for ub.code-range .
      376       define buffer last-2_code-range   for ub.code-range .
      377       define buffer last-3_code-range   for ub.code-range .
      378       define buffer buf_sys-ctrl        for ub.sys-ctrl .
      379       define variable conf-par       as character no-undo .
      380       define variable par-type       as character no-undo .
      381       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
      382       define variable v-cre-cdrg as logical   no-undo .
      383       define variable v-cre-str  as character no-undo .
      384       define variable v-cr1      as integer no-undo .
      385       define variable v-cr2      as integer no-undo .
      386       define variable v-cr3      as integer no-undo .
      387       define variable v-cmax     as integer no-undo .
      388       find first buf_sys-ctrl no-lock .
      389       if buf_sys-ctrl.db-num <> 0 and type-code <> 'cagb':U then do:
      390         undo, return error substitute("&1 &2 &3&4Диапазоны кодов можно создавать только в ГБД&4База данных &5"
      391                                       ,vss-workfile
      392                                       ,vss-revision
      393                                       ,vss-description
      394                                       ,chr(10)
      395                                       , p-db-num
      396                                      ).
      397       end.
      398       run trg/getpcode.p ( input  type-code
      399                      ,output cfg-param-code
      400                     ).
      401       for each buf_code-range
      402         where buf_code-range.db-num     = -1
      403           and buf_code-range.range-type = type-code
      404           and buf_code-range.stts       = "f"
      405       by buf_code-range.first-code
      406       on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      407       on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
      408       on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
      409       :
      410         assign
      411           buf_code-range.db-num = p-db-num
      412         .
      413         return .
      414       end.
      415       assign
      416         v-cre-cdrg = TRUE
      417       .
      418       case type-code:
      419         when 'sclc':U
      420         or when 'scgb':U
      421         or when 'pglc':U
      422         then do:
      423           find last last-1_code-range no-lock
      424             where last-1_code-range.range-type = 'sclc':U
      425             no-error .
      426           if available last-1_code-range then do:
      427             v-cr1 = last-1_code-range.last-code.
      428           end.
      429           find last last-2_code-range no-lock
      430             where last-2_code-range.range-type = 'scgb':U
      431             no-error .
      432           if available last-2_code-range then do:
      433             v-cr2 = last-2_code-range.last-code.
      434             end.
      435           find last last-3_code-range no-lock
      436             where last-3_code-range.range-type = 'pglc':U
      437             no-error .
      438           if available last-3_code-range then do:
      439             v-cr3 = last-3_code-range.last-code.
      440           end.
      441           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
      442           .
      443           if v-cmax = v-cr1  then do:
      444               find last last_code-range no-lock
      445                 where recid( last_code-range ) = recid( last-1_code-range )
      446                 .
      447             end.
      448           if v-cmax = v-cr2  then do:
      449               find last last_code-range no-lock
      450                 where recid( last_code-range ) = recid( last-2_code-range )
      451                 .
      452             end.
      453           if v-cmax = v-cr3  then do:
      454             find last last_code-range no-lock
      455               where recid( last_code-range ) = recid( last-3_code-range )
      456               .
      457           end.
      458           if last_code-range.last-code + 1 > 99999 then do:
      459             assign
      460               v-cre-cdrg = FALSE
      461             .
      462           end.
      463         end.
      464         when 'bcgb':U
      465         or when 'sslc':U
      466         or when 'ssgb':U
      467         then do:
      468           find last last-1_code-range no-lock
      469             where last-1_code-range.range-type = 'sslc':U
      470             no-error .
      471           if available last-1_code-range then do:
      472             v-cr1 = last-1_code-range.last-code.
      473           end.
      474           find last last-2_code-range no-lock
      475             where last-2_code-range.range-type = 'bcgb':U
      476             no-error .
      477           if available last-2_code-range then do:
      478             v-cr2 = last-2_code-range.last-code.
      479             end.
      480           find last last-3_code-range no-lock
      481             where last-3_code-range.range-type = 'ssgb':U
      482             no-error .
      483           if available last-3_code-range then do:
      484             v-cr3 = last-3_code-range.last-code.
      485           end.
      486           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
      487           .
      488           if v-cmax = v-cr1  then do:
      489               find last last_code-range no-lock
      490                 where recid( last_code-range ) = recid( last-1_code-range )
      491                 .
      492             end.
      493           if v-cmax = v-cr2  then do:
      494               find last last_code-range no-lock
      495                 where recid( last_code-range ) = recid( last-2_code-range )
      496                 .
      497             end.
      498           if v-cmax = v-cr3  then do:
      499             find last last_code-range no-lock
      500               where recid( last_code-range ) = recid( last-3_code-range )
      501               .
      502           end.
      503         end.
      504         otherwise do:
      505           find last last_code-range no-lock
      506             where last_code-range.range-type = type-code
      507             no-error .
      508         end.
      509       end case.
      510       if not available last_code-range then do:
      511         undo, return error substitute("&1 &2 &3&4В БД нет ни одного диапазона с типом &5&4Не была проведена инициализация диапазонов!"
      512                                       ,vss-workfile
      513                                       ,vss-revision
      514                                       ,vss-description
      515                                       , chr(10)
      516                                       , type-code
      517                                      ) .
      518       end.
      519       define variable v-mes0 as character no-undo .
      520       define variable v-param-type0 as character no-undo .
      521       define variable v-value-character0 as INTEGER no-undo .
      522       define variable v-value-date0 as date no-undo .
      523       define variable v-value-decimal0 as decimal no-undo .
      524       define variable v-value-integer0 AS integer no-undo .
      525       define variable v-value-logical0 AS LOGICAL no-undo .
      526       define variable v-tth0 as handle no-undo .
      527       run adm/shattri.p (
      528           input "get":U
      529           ,input  'БД':U
      530           ,input  p-db-num
      531           ,input  'code-range':U
      532           ,input  cfg-param-code
      533           ,output v-value-character0
      534           ,output v-value-date0
      535           ,output v-value-decimal0
      536           ,output v-value-integer0
      537           ,output v-value-logical0
      538           ,output v-param-type0
      539           ,INPUT-OUTPUT table-handle v-tth0
      540           ) no-error .
      541       if error-status :error then do:
      542         delete object v-tth0.
      543         v-mes0 = substitute("Ошибка при получении размера диапазона собственных глобальных кодов&2&1&2&3"
      544                            , error-status:get-message(1)
      545                            , chr(10)
      546                            , return-value ).
      547         undo, return error v-mes0.
      548       end.
      549       delete object v-tth0.
      550       if v-cre-cdrg = TRUE then do:
      551         create buf_code-range .
      552         assign
      553           buf_code-range.db-num     = p-db-num
      554           buf_code-range.range-type = type-code
      555           buf_code-range.stts       = "f"
      556           buf_code-range.first-code = last_code-range.last-code + 1
      557           buf_code-range.last-code  = last_code-range.last-code + integer(v-value-integer0)
      558           v-cre-str = "Свободный диапазон успешно создан"
      559         .
      560       end.
      561       else do:
      562         assign
      563           v-cre-str = "Нет возможности создать свободный диапазон." + chr(10)
      564                       + substitute( "Превышен предел диапазонов c типом &1", type-code )
      565         .
      566       end.
      567     end.
      568     return v-cre-str .
      569   end procedure.
      570   procedure gen-new-code-range-if-neces :
      571     define input parameter v-db-num           like ub.db.db-num             no-undo .
      572     define input parameter v-range-type       like ub.code-range.range-type no-undo .
      573     define input parameter v-cur-code         as   integer                  no-undo .
      574     define input parameter v-g#news           as   logical                  no-undo .
      575     define input parameter v-g#db-num         like ub.db.db-num             no-undo .
      576     define input parameter v-g#news-source-db like ub.db.db-num             no-undo .
      577     do
      578     on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      579     on stop   undo, return error substitute( "&1 (gen-new-code-range-if-neces). stop", vss-workfile )
      580     on endkey undo, return error substitute( "&1 (gen-new-code-range-if-neces). endkey", vss-workfile )
      581     :
      582       define variable l-code-range-exist as logical   no-undo init false .
      583       define variable v-db-for-send      as character no-undo .
      584       define buffer buf_code-range  for ub.code-range .
      585       define buffer buf1_code-range for ub.code-range .
      586       define buffer buf_db          for ub.db .
      587       find first buf_code-range
      588         where buf_code-range.range-type = v-range-type
      589           and buf_code-range.last-code >= v-cur-code
      590         use-index last-codei
      591         no-error .
      592       if
      593       (
      594          available buf_code-range
      595          and
      596         (buf_code-range.db-num = v-db-num
      597           and
      598         buf_code-range.first-code <= v-cur-code
      599         )
      600       or
      601         (
      602           v-range-type = 'drgb':U
      603           AND
      604           v-cur-code = 0
      605         )
      606      )
      607      then do:
      608         assign
      609           l-code-range-exist = true
      610         .
      611         if v-g#news
      612         and buf_code-range.stts = "f" then do:
      613           assign
      614             buf_code-range.stts = "u"
      615           .
      616         end.
      617       end.
      618       if not l-code-range-exist
      619          and v-g#news-source-db <> 0
      620       then do:
      621         undo, return error substitute("&1 &2 &3&4Отсутствует диапазон кодов для БД &5 Тип диапазона кодов &6 Код &7"
      622                                       ,vss-workfile
      623                                       ,vss-revision
      624                                       ,vss-description
      625                                       ,chr(10)
      626                                       ,v-db-num
      627                                       ,v-range-type
      628                                       ,v-cur-code
      629                                      ).
      630       end.
      631       if (not l-code-range-exist
      632           or ( v-cur-code >= int( (buf_code-range.first-code + buf_code-range.last-code) / 2 ) )
      633          )
      634       and ( not can-find (first buf1_code-range no-lock
      635                           where buf1_code-range.db-num = v-db-num
      636                             and buf1_code-range.range-type = v-range-type
      637                             and buf1_code-range.stts = "f"
      638                          )
      639           )
      640       then do:
      641         if v-g#db-num = 0 then do:
      642           run new-bcod-gen-code-range in this-procedure
      643             (input v-db-num,
      644              input v-range-type
      645             ) no-error .
      646           if error-status :error then do:
      647             undo, return error substitute("Ошибка при создании нового свободного диапазона &1 Тип диапазона кодов &2 Код &3:&4&5 &6"
      648                                           , substitute("&1 &2 &3", vss-workfile, vss-revision, vss-description)
      649                                           ,v-db-num
      650                                           ,v-range-type
      651                                           ,v-cur-code
      652                                           ,chr(10)
      653                                           ,error-status:get-message(1)
      654                                           ,return-value
      655                                          ).
      656           end.
      657         end.
      658         else do:
      659           if v-range-type = 'sclc':U
      660           or v-range-type = 'pglc':U
      661           then do:
      662             assign
      663               v-db-for-send = "":U
      664             .
      665             if v-g#db-num = 0 then do:
      666               for each buf_db no-lock
      667                 where buf_db.db-num > 0
      668                   and buf_db.db-num <> v-g#news-source-db
      669               on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      670               :
      671                 assign
      672                   v-db-for-send = v-db-for-send + chr(1) + string( buf_db.db-num )
      673                 .
      674               end.
      675               assign
      676                 v-db-for-send = right-trim( v-db-for-send, chr(1) )
      677               .
      678             end.
      679             else do:
      680               if not v-g#news then do:
      681                 assign
      682                   v-db-for-send = "0":U
      683                 .
      684               end.
      685             end.
      686             run nws/cr-route.p ( input 'send-cmd':U
      687                           ,input ("command":U + chr(1) + "create":U + chr(1) +
      688                                  "code-range":U + chr(1) +
      689                                  (if v-range-type = 'sclc':U
      690                                   then string( current-value(s-sclc-code, ub))
      691                                   else string( current-value(s-pglc-code, ub))
      692                                   ) + chr(1) +
      693                                   v-range-type)
      694                           ,input ?
      695                           ,input v-db-for-send
      696                           ) no-error .
      697             if error-status :error then do:
      698               undo, return error return-value.
      699             end.
      700           end.
      701         end.
      702       end.
      703     end.
      704   end procedure.
      705   procedure cre-loc-sc-code-range :
      706     define input parameter v-cur-code as integer no-undo .
      707   define input parameter p-cdrg-type as character no-undo .
      708     do
      709     on error  undo, return error substitute( "&1 (cre-loc-sc-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      710     on stop   undo, return error substitute( "&1 (cre-loc-sc-code-range). stop", vss-workfile )
      711     on endkey undo, return error substitute( "&1 (cre-loc-sc-code-range). endkey", vss-workfile )
      712     :
      713       define buffer buf_code-range for ub.code-range .
      714       find first buf_code-range
      715            where buf_code-range.range-type = p-cdrg-type
      716              and buf_code-range.first-code >= v-cur-code
      717            no-error .
      718       if not available buf_code-range then do:
      719         run new-bcod-gen-code-range in this-procedure
      720           ( input 0,
      721             input p-cdrg-type
      722           ) no-error .
      723         if error-status :error then do:
      724           undo, return error substitute( "Ошибка при создании нового свободного диапазона локальных весовых или штучных кодов&1"
      725                                          + "Код &2&1&3 &4"
      726                                         , chr(10)
      727                                         , v-cur-code
      728                                         , error-status:get-message(1)
      729                                         , return-value
      730                                        ) .
      731         end.
      732       end.
      733     end.
      734   end procedure.
      735   procedure mark-used-if-need :
      736   define input parameter p-cur-code as integer no-undo .
      737   define input parameter p-range-type like ub.code-range.range-type no-undo .
      738   define input parameter p-db-num like ub.code-range.db-num no-undo .
      739     do
      740     on error  undo, return error substitute( "&1 (mark-used-if-need). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      741     on stop   undo, return error substitute( "&1 (mark-used-if-need). stop", vss-workfile )
      742     on endkey undo, return error substitute( "&1 (mark-used-if-need). endkey", vss-workfile )
      743     :
      744       DEFINE VARIABLE v-db-num like ub.code-range.db-num no-undo .
      745       define buffer buf_code-range for ub.code-range .
      746       assign
      747       v-db-num = if p-range-type = 'sclc':U
      748                  then 0
      749                  else p-db-num
      750       .
      751   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      752   define buffer locK-batchprocess1 for ub.batchprocess.
      753   run gbl/lock-prc.p
      754       (input 'lscc':U
      755       ,input 0
      756       ,input 0
      757       ,input 0
      758       ,input ""
      759       ,input ""
      760       ,input ""
      761       ,input (
      762               ",,,Вкл/выкл лок. вес. кодов"
      763              )
      764       ,input true
      765       ,buffer lock-batchprocess1
      766       ) no-error .
      767     if error-status :error then do:
      768       message
      769         vss-workfile vss-revision vss-description skip
      770         "В данный момент идет процесс вкл/выкл лок. вес. кодов" skip
      771         view-as alert-box error .
      772       undo, return error .
      773     end.
      774       find first buf_code-range
      775            where buf_code-range.range-type = p-range-type
      776              and buf_code-range.first-code >= p-cur-code
      777              and buf_code-range.last-code <= p-cur-code
      778              and buf_code-range.db-num = v-db-num
      779            no-error .
      780       if not available buf_code-range then do:
      781         message
      782           vss-workfile vss-revision vss-description skip
      783           "Ошибка при создании поиске диапазона" skip
      784           "База данных" p-db-num skip
      785           "Код" p-cur-code skip
      786           "Тип" p-range-type
      787           error-status :get-message(1) skip
      788           return-value skip
      789           view-as alert-box error .
      790         undo, return error .
      791       end.
      792       if buf_code-range.stts = "f":U then do:
      793         assign
      794         buf_code-range.stts = "u":U
      795         .
      796       end.
      797     end.
      798   end procedure.
      799   define variable v-1 as integer no-undo .
      800   define variable v-2 as integer no-undo .
      801   define buffer buf_rp-by-call for ub.rp-by-call.
      802   define buffer buf_c-rp-by-call for ub.c-rp-by-call.
      803   define buffer buf_rule-by-call for ub.rule-by-call.
      804   define buffer buf_c-rule-by-call for ub.c-rule-by-call.
      805   define buffer buf_prop-ref-call for ub.prop-ref-call.
      806   define buffer buf_some-lk for ub.some-lk.
      807   main-block:
      808   do
      809   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      810   :
      811     case p-call-type:
      812       when 'dis-card-type':U
      813       or
      814       when 'edoc':U
      815       or
      816       when 'goods':U
      817       or
      818       when 'clients':U
      819       or
      820       when 'gds-grp':U
      821       or
      822       when 'cli-grp':U
      823       or
      824       when 'chk-doc':U + "_" + 'IBS-TH':U
      825       or
      826       when 'chk-doc':U + "_" + 'IBS-TH-MOB':U
      827       or
      828       when 'edoc':U
      829       or
      830       when 'thref':U
      831       or
      832       when 'pdf':U
      833       or
      834       when 'rep':U
      835       or
      836       when 'ord':U
      837       or
      838       when 'cmb':U
      839       or
      840       when 'fdoc':U
      841       then do:
      842         find first buf_rp-by-call no-lock where
      843                   buf_rp-by-call.call_id = p-call-id no-error .
      844         if available buf_rp-by-call then do:
      845           p-call#-id = buf_rp-by-call.call#_id.
      846           return.
      847         end.
      848         find first buf_c-rp-by-call no-lock where
      849                   buf_c-rp-by-call.call_id = p-call-id no-error.
      850         if available buf_c-rp-by-call then do:
      851           p-call#-id = buf_c-rp-by-call.call#_id.
      852           return.
      853         end.
      854         find first buf_rule-by-call no-lock where
      855                   buf_rule-by-call.call_id = p-call-id no-error .
      856         if available buf_rule-by-call then do:
      857           p-call#-id = buf_rule-by-call.call#_id.
      858           return.
      859         end.
      860         find first buf_c-rule-by-call no-lock where
      861                   buf_c-rule-by-call.call_id = p-call-id no-error .
      862         if available buf_c-rule-by-call then do:
      863           p-call#-id = buf_c-rule-by-call.call#_id.
      864           return.
      865         end.
      866         find first buf_prop-ref-call no-lock where
      867                   buf_prop-ref-call.call_id = p-call-id no-error .
      868         if available buf_prop-ref-call then do:
      869           p-call#-id = buf_prop-ref-call.call#_id.
      870           return.
      871         end.
      872         run gen-b-code in this-procedure ( input 'cagb':U, output p-call#-id) no-error .
      873         if error-status:error then do:
      874           message
      875           vss-workfile vss-revision vss-description skip
      876           "Невозможно определить уникальный идентификатор точки вызова" p-call-id
      877           view-as alert-box error .
      878           undo main-block, return error .
      879         end.
      880       end.
      881       when 'layout-elem-rule':U
      882       then do:
      883         find first buf_rule-by-call no-lock where
      884                   buf_rule-by-call.call_id = p-call-id no-error .
      885         if available buf_rule-by-call then do:
      886           p-call#-id = buf_rule-by-call.call#_id.
      887           return.
      888         end.
      889         find first buf_c-rule-by-call no-lock where
      890                   buf_c-rule-by-call.call_id = p-call-id no-error .
      891         if available buf_c-rule-by-call then do:
      892           p-call#-id = buf_c-rule-by-call.call#_id.
      893           return.
      894         end.
      895         run gen-b-code in this-procedure ( input 'cagb':U, output p-call#-id) no-error .
      896         if error-status:error then do:
      897           message
      898           vss-workfile vss-revision vss-description skip
      899           "Невозможно определить уникальный идентификатор точки вызова" p-call-id
      900           view-as alert-box error .
      901           undo main-block, return error .
      902         end.
      903        end.
      904        when ('layout-elem-rule':U + chr(44) + "minus") then do:
      905         find first buf_rule-by-call no-lock where
      906                   buf_rule-by-call.call_id = p-call-id
      907               and buf_rule-by-call.call#_id < 0
      908                   no-error .
      909         if available buf_rule-by-call then do:
      910           p-call#-id = buf_rule-by-call.call#_id.
      911           return.
      912         end.
      913         find first buf_c-rule-by-call no-lock where
      914                   buf_c-rule-by-call.call_id = p-call-id
      915                and buf_c-rule-by-call.call#_id < 0
      916                   no-error .
      917         if available buf_c-rule-by-call then do:
      918           p-call#-id = buf_c-rule-by-call.call#_id.
      919           return.
      920         end.
      921         find first buf_rule-by-call no-lock where
      922                   buf_rule-by-call.call#_id  < 0 no-error .
      923         if available buf_rule-by-call then do:
      924           v-1 = buf_rule-by-call.call#_id.
      925         end.
      926         find first buf_c-rule-by-call no-lock where
      927                   buf_c-rule-by-call.call#_id < 0 no-error .
      928         if available buf_c-rule-by-call then do:
      929           v-2 = buf_c-rule-by-call.call#_id.
      930         end.
      931         assign
      932         p-call#-id = minimum(-1, v-1, v-2) - 1
      933         .
      934       end.
      935       when 'some-lk':U then do:
      936         find first buf_some-lk no-lock where
      937                   buf_some-lk.resource_id = p-call-id no-error .
      938         if available buf_some-lk then do:
      939           p-call#-id = buf_some-lk.resource#_id.
      940           return.
      941         end.
      942         if g#db-num = 0 then do:
      943           p-call#-id = next-value(s-lk-chip, ub).
      944         end.
      945         else do:
      946           message
      947           vss-workfile vss-revision vss-description skip
      948           "Невозможно определить уникальный идентификатор точки блокировки" p-call-id
      949           view-as alert-box error .
      950           undo main-block, return error .
      951         end.
      952       end.
      953       otherwise do:
      954         message
      955         vss-workfile vss-revision vss-description skip
      956         "Неверное значение параметра вызова p-call-type=" p-call-type
      957         view-as alert-box error .
      958         undo main-block, return error .
      959       end.
      960     end case.
      961   end.
