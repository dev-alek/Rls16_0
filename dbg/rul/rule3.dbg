        1   block-level on error undo, throw.
        2   define input parameter p-silent as logical no-undo .
        3   define input parameter p-rec as recid no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision$":U .
        5   define variable vss-author      as character no-undo init "$Author$":U .
        6   define variable vss-date        as character no-undo init "$Date$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        8   define variable vss-archive     as character no-undo init "$Archive$":U .
        9   define variable vss-description as character no-undo init "Удаление rule".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define variable v-mess as character no-undo .
       69   define buffer buf_rule  for ub.rule.
       70   define buffer buf2_rule  for ub.rule.
       71   define buffer buf_rule-by-profile  for ub.rule-by-profile.
       72   define buffer buf_ruledict for ub.ruledict.
       73   define buffer buf_ruledict-param for ub.ruledict-param.
       74   define buffer buf_rule-script for ub.rule-script.
       75   define buffer buf_rule-i-script for ub.rule-i-script.
       76   define buffer buf_rule-by-call  for ub.rule-by-call.
       77   main-block:
       78   do
       79   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
       80   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
       81   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
       82   :
       83     find first buf_rule exclusive-lock where
       84             recid(buf_rule) = p-rec .
       85     if buf_rule.sts = integer('99':U)
       86     or buf_rule.sts = integer('98':U)
       87     or buf_rule.sts = integer('0':U)
       88     then do:
       89       assign
       90       v-mess = substitute("Правило находится в статусе &1, удаление невозможно", entry (lookup (string(buf_rule.sts), '-1,-10,0,1,99,98':U), 'готов,нов,исп,удал,удаление,запр.удал':U)).
       91       run err-mess in this-procedure ( input-output v-mess).
       92       return error (if p-silent = yes then v-mess else '':U).
       93     end.
       94     find first buf_rule-by-call no-lock where
       95               buf_rule-by-call.rule_id = buf_rule.rule_id no-error.
       96     if available buf_rule-by-call then do:
       97       v-mess = substitute("Нельзя удалить правило - правило вызывается:&1" +
       98                           "Точка вызова &2(&3), кодекс &4, набор правил &5"
       99                          , chr(10)
      100                          , buf_rule-by-call.call#_id
      101                          , buf_rule-by-call.call_id
      102                          , buf_rule-by-call.codex_id
      103                          , buf_rule-by-call.ruleset_id
      104                          ).
      105      run err-mess in this-procedure ( input-output v-mess) .
      106      undo main-block, return error (if p-silent = yes then v-mess else '':U).
      107     end.
      108     find first buf_rule-by-profile no-lock where
      109               buf_rule-by-profile.rule_id = buf_rule.rule_id no-error.
      110     if available buf_rule-by-profile then do:
      111       v-mess = substitute("Нельзя удалить правило - есть привязанный профайл &1"
      112                          , buf_rule-by-profile.profile_id ).
      113      run err-mess in this-procedure ( input-output v-mess) .
      114      undo main-block, return error (if p-silent = yes then v-mess else '':U).
      115     end.
      116     for each buf_ruledict where
      117           buf_ruledict.entry-type = 'rule':U
      118       and buf_ruledict.uniq-key-rec = buf_rule.uniq-key-rec
      119     on error undo main-block, return error:
      120       for each buf_ruledict-param where
      121             buf_ruledict-param.entry-id = buf_ruledict.entry-id
      122       on error undo main-block, return error:
      123         delete buf_ruledict-param.
      124       end.
      125       delete buf_ruledict.
      126     end.
      127     for each buf2_rule where
      128           buf2_rule.upper_rule_id = buf_rule.rule_id
      129     on error undo main-block, return error :
      130        delete buf2_rule.
      131     end.
      132     for each buf_rule-script where
      133           buf_rule-script.rule_id = buf_rule.rule_id
      134     on error undo main-block, return error :
      135        delete buf_rule-script.
      136     end.
      137     for each buf_rule-i-script where
      138           buf_rule-i-script.root_rule_id = buf_rule.rule_id
      139     on error undo main-block, return error :
      140        delete buf_rule-i-script.
      141     end.
      142     delete buf_rule no-error.
      143     if error-status:error then do:
      144       v-mess = substitute("Ошибка при удалении: &1&2&3"
      145                            , error-status:get-message(1)
      146                            , chr(10)
      147                            , return-value ).
      148      run err-mess in this-procedure ( input-output v-mess) .
      149      undo main-block, return error (if p-silent = yes then v-mess else '':U).
      150     end.
      151   end.
      152   PROCEDURE err-mess:
      153     DEFINE INPUT-OUTPUT PARAMETER p-mess as character No-UNDO.
      154     CASE p-silent:
      155       when yes then do:
      156         assign
      157         p-mess = substitute("Правило &1: &2"
      158                            , buf_rule.rule_id
      159                            , p-mess)
      160         .
      161       end.
      162       when no then do:
      163         message
      164         p-mess
      165         view-as alert-box error .
      166       end.
      167     end.
      168   END PROCEDURE.
