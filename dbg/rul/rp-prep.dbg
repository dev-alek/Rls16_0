        1   block-level on error undo, throw.
        2   define input parameter p-profile-id as integer no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Сборка одного профайла".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       68   define temp-table temp-string no-undo
       69   field v-string as character
       70   field string-num as integer
       71   index pi is unique primary string-num.
       72   procedure temp-string_clear :
       73     define buffer buf_temp-string for temp-string .
       74     do
       75     on error undo, return error return-value
       76     :
       77       for each buf_temp-string
       78       on error undo, return error
       79       :
       80         delete buf_temp-string.
       81       end.
       82     end.
       83   end procedure.
       84   procedure temp-string_write :
       85     define input  parameter p-v-string    as character no-undo .
       86     define variable v-string-num as integer no-undo .
       87     define buffer buf_temp-string for temp-string .
       88     do
       89     on error undo, return error return-value
       90     :
       91       find last buf_temp-string no-error .
       92       if not available buf_temp-string then do:
       93         create buf_temp-string .
       94         assign
       95         buf_temp-string.string-num     = 1
       96         buf_temp-string.v-string       = p-v-string
       97         .
       98       end.
       99       else do:
      100         v-string-num = buf_temp-string.string-num.
      101         create buf_temp-string .
      102         assign
      103         buf_temp-string.string-num = v-string-num + 1
      104         buf_temp-string.v-string = p-v-string
      105         .
      106       end.
      107     end.
      108   end procedure.
      109   procedure temp-string_read :
      110     define input  parameter p-string-num    as integer   no-undo .
      111     define output parameter p-v-string      as character no-undo .
      112     define buffer buf_temp-string for temp-string .
      113     do
      114     on error undo, return error return-value
      115     :
      116       find first buf_temp-string
      117         where buf_temp-string.string-num     = p-string-num
      118         no-error .
      119       if available buf_temp-string then do:
      120         assign
      121           p-v-string = buf_temp-string.v-string
      122         .
      123       end.
      124       else do:
      125         assign
      126           p-v-string = '':U
      127         .
      128       end.
      129     end.
      130   end procedure.
      131   procedure temp-string_append :
      132     define input  parameter p-string-num  as integer   no-undo .
      133     define input  parameter p-v-string    as character no-undo .
      134     define input  parameter p-append-char as character no-undo .
      135     define buffer buf_temp-string for temp-string .
      136     do
      137     on error undo, return error return-value
      138     :
      139       find first buf_temp-string
      140            where buf_temp-string.string-num = p-string-num
      141         no-error .
      142       if not available buf_temp-string then do:
      143         create buf_temp-string .
      144         assign
      145           buf_temp-string.string-num  = p-string-num
      146           buf_temp-string.v-string    = p-v-string
      147         .
      148       end.
      149       else do:
      150           assign
      151           buf_temp-string.v-string = buf_temp-string.v-string + p-append-char + p-v-string
      152           .
      153       end.
      154     end.
      155   end procedure.
      156   procedure temp-string_get-last-num:
      157   define output parameter p-string-num  as integer   no-undo .
      158   define buffer buf_temp-string for temp-string .
      159   find last buf_temp-string no-error.
      160   if available buf_temp-string then do:
      161     p-string-num = buf_temp-string.string-num.
      162   end.
      163   end procedure.
      164   procedure temp-string_delete-range:
      165   define input parameter p-first-string-num  as integer   no-undo .
      166   define input parameter p-last-string-num  as integer   no-undo .
      167   define buffer buf_temp-string for temp-string .
      168   for each buf_temp-string where
      169           buf_temp-string.string-num >= p-first-string-num
      170       and buf_temp-string.string-num <= p-last-string-num:
      171     delete buf_temp-string.
      172   end.
      173   end procedure.
      174   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      175   DEFINE TEMP-TABLE tt-rule NO-UNDO LIKE ub.rule
      176          field level as integer.
      177   DEFINE TEMP-TABLE tt-rule-script NO-UNDO LIKE ub.rule-script
      178          field level as integer
      179          field gen-order as character
      180          field upper_rule_id as integer
      181          field start-script_id as integer
      182          field end-script_id as integer
      183          field edge-type as character
      184          .
      185   define temp-table temp-rule-i-script no-undo
      186   like ub.rule-i-script.
      187   PROCEDURE fill-tables :
      188   DEFINE INPUT PARAMETER p-rule-id AS INTEGER NO-UNDO.
      189   DEFINE INPUT PARAMETER p-root-rule-id AS INTEGER NO-UNDO.
      190   DEFINE INPUT-OUTPUT PARAMETER p-level AS INTEGER NO-UNDO.
      191   DEFINE INPUT PARAMETER p-gen-order AS character NO-UNDO.
      192   DEFINE BUFFER buf_rule FOR ub.RULE.
      193   DEFINE BUFFER buf_rule-script FOR ub.RULE-script.
      194   DEFINE BUFFER buf_tt-rule FOR tt-RULE.
      195   DEFINE BUFFER buf_tt-rule-script FOR tt-RULE-script.
      196   if p-level = 0 then do:
      197     find first buf_rule where
      198               buf_rule.rule_id = p-root-rule-id.
      199     create buf_tt-rule.
      200     buffer-copy buf_rule to buf_tt-rule.
      201     release buf_tt-rule.
      202   end.
      203   p-level = p-level + 1.
      204   FOR EACH buf_rule NO-LOCK WHERE
      205           buf_rule.UPPER_rule_id = p-rule-id:
      206      find first buf_tt-rule where
      207               buf_tt-rule.rule_id = buf_rule.rule_id no-error.
      208      if not available buf_tt-rule then do:
      209       CREATE buf_tt-rule.
      210       buffer-copy buf_rule to buf_tt-rule.
      211       ASSIGN
      212       buf_tt-rule.root_rule_id = p-root-rule-id
      213       .
      214      end.
      215      buf_tt-rule.level = p-level.
      216      RUN fill-tables IN THIS-PROCEDURE (  INPUT buf_tt-rule.RULE_id
      217                                          ,INPUT p-root-rule-id
      218                                          ,INPUT-OUTPUT p-level
      219                                          ,INPUT (p-gen-order +
      220                                           STRING(p-level, "99") +
      221                                           STRING(buf_tt-rule.salience, "999"))).
      222   END.
      223   FOR EACH buf_rule-script NO-LOCK WHERE
      224           buf_rule-script.rule_id = p-rule-id:
      225      find first buf_tt-rule-script where
      226               buf_tt-rule-script.script_id = buf_rule-script.script_id
      227          AND  buf_tt-rule-script.LANGUAGE = buf_rule-script.LANGUAGE
      228          no-error.
      229      if not available buf_tt-rule-script
      230      then do:
      231       find first buf_tt-rule no-lock where
      232                 buf_tt-rule.rule_id = buf_rule-script.rule_id.
      233       CREATE buf_tt-rule-script.
      234       buffer-copy buf_rule-script to buf_tt-rule-script.
      235       ASSIGN
      236       buf_tt-rule-script.root_rule_id = p-root-rule-id
      237       buf_tt-rule-script.upper_rule_id = buf_tt-rule.upper_rule_id
      238       .
      239      end.
      240      assign
      241      buf_tt-rule-script.level = p-level
      242      buf_tt-rule-script.gen-order = p-gen-order +
      243                                     STRING(buf_tt-rule-script.level, "99") +
      244                                     STRING(buf_tt-rule-script.salience, "999").
      245      .
      246   END.
      247   p-level = p-level - 1.
      248   END PROCEDURE.
      249   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      250   define temp-table temp-edge no-undo
      251   field from-script_id as integer
      252   field to-script_id as integer
      253   field edge-type as character
      254   index pi is unique primary
      255   from-script_id
      256   to-script_id
      257   .
      258   function break-string-for-dot returns character (input p-string as character, input p-line-length AS INTEGER):
      259   define variable v-string as character no-undo .
      260   define variable v-output-string as character no-undo .
      261   define variable v-entry as character no-undo .
      262   define variable v-index as integer no-undo .
      263   v-string = p-string.
      264   v-output-string = p-string.
      265   do while length(v-string) > p-line-length :
      266     ASSIGN
      267     v-entry = substring(v-string, 1, p-line-length)
      268     v-index = r-index(v-entry, chr(32)).
      269     if v-index > 0
      270     and v-index <= p-line-length then do:
      271        assign
      272        v-output-string = v-output-string + substring(v-entry, 1, v-index - 1)  + '\N'.
      273        v-string = substring(v-string, v-index + 1)
      274        no-error.
      275        if error-status:error then leave.
      276     end.
      277     ELSE DO:
      278         assign
      279         v-output-string = v-output-string + v-entry.
      280         v-string = substring(v-string, 71)
      281         no-error.
      282     END.
      283   end.
      284   return v-output-string.
      285   end.
      286   PROCEDURE DISPLAY-RULE :
      287   define INPUT parameter p-rule-id AS integer no-undo.
      288   define input parameter p-upper-rule-id as integer no-undo .
      289   define input parameter p-language as character no-undo.
      290   define input-output parameter p-level as integer no-undo .
      291   define variable v-exist-condition-script as logical no-undo .
      292   define variable v-exist-rule-script as logical no-undo .
      293   define variable v-main-seq as character no-undo .
      294   define variable v-prev-node as character no-undo .
      295   define variable v-current-node as character no-undo .
      296   define variable v-next-node as character no-undo .
      297   define variable v-bottom-node as character no-undo .
      298   define variable v-top-node as character no-undo .
      299   define variable v-edge-label as logical no-undo .
      300   define variable v-language as character no-undo .
      301   define variable v-upper-rule-id as integer no-undo .
      302   define variable v-rule-id as integer no-undo .
      303   define variable v-salience as integer no-undo .
      304   define variable v-gen-order as character no-undo .
      305   define variable v-goto-text as character no-undo .
      306   define variable v-goto-rule as character no-undo .
      307   define buffer buf_rule for ub.rule.
      308   define buffer buf_upper-rule for ub.rule.
      309   define buffer buf_upper-rule-script for ub.rule-script.
      310   define buffer buf_down-rule for ub.rule.
      311   define buffer buf2_rule-script for ub.rule-script.
      312   define buffer buf3_rule-script for ub.rule-script.
      313   define buffer buf2_rule for ub.rule.
      314   define buffer buf_rule-script for ub.rule-script.
      315   define buffer buf_prop-script for ub.prop-script.
      316   define buffer buf_rule-i-script for ub.rule-i-script.
      317   define buffer buf_tt-rule-script for tt-rule-script.
      318   define buffer buf_temp-edge for temp-edge.
      319   define buffer buf_tt-rule for tt-rule.
      320   CASE p-language:
      321     WHEN "ABL" THEN DO:
      322       find first buf_rule no-lock where
      323                 buf_rule.rule_id = p-rule-id.
      324       if buf_rule.hidden-content > 0 then do:
      325         run temp-string_write in this-procedure ( input substitute("/* содержимое скрыто*/")).
      326         return.
      327       end.
      328       if p-upper-rule-id = 0 then do:
      329         run temp-string_write in this-procedure ( input substitute("/* &1", buf_Rule.name)).
      330         run temp-string_write in this-procedure ( input substitute("&1 */", buf_Rule.documentation)).
      331         run temp-string_write in this-procedure ( input '':U).
      332       end.
      333       else do:
      334         run temp-string_write in this-procedure ( input substitute("/* salience &1 in upper-rule-id &2*/"
      335                                                                   , buf_rule.salience
      336                                                                   , buf_rule.upper_rule_id
      337                                                                   )).
      338       end.
      339       run temp-string_write in this-procedure ( input  substitute("&1_&2:&3&1do:"
      340                                                                   ,fill( chr(32), p-level * 2)
      341                                                                   ,p-rule-id
      342                                                                   ,chr(10))).
      343       FOR EACH buf_rule-script NO-LOCK WHERE
      344         buf_rule-script.RULE_id = p-RULE-id
      345         AND buf_rule-script.LANGUAGE = p-language
      346       by buf_rule-script.salience :
      347         if buf_rule-script.script-type = 'COND':U then do:
      348           run temp-string_write in this-procedure (input  substitute("&1/* salience &2 rule_id &3*/"
      349                                                                      ,fill(chr(32), 70)
      350                                                                      ,buf_rule-script.salience
      351                                                                      ,buf_rule-script.rule_ID
      352                                                                      ) ).
      353           run temp-string_write in this-procedure (input  substitute("&1IF &2  THEN do:   "
      354                                                                       ,fill( chr(32), p-level * 2)
      355                                                                       ,replace(buf_rule-script.script, (chr(38) + chr(38)), chr(38))
      356                                                                       )).
      357           .
      358           assign
      359           v-exist-rule-script = yes
      360           .
      361         end.
      362         if buf_rule-script.script-type = 'CYCLE-COND':U then do:
      363           run temp-string_write in this-procedure (input  substitute("&1/* salience &2 rule_id &3*/"
      364                                                                      ,fill(chr(32), 70)
      365                                                                      ,buf_rule-script.salience
      366                                                                      ,buf_rule-script.rule_ID
      367                                                                      ) ).
      368           run temp-string_write in this-procedure (input  substitute("&1DO WHILE &2 :   "
      369                                                                       ,fill( chr(32), p-level * 2)
      370                                                                       ,replace(buf_rule-script.script, (chr(38) + chr(38)), chr(38))
      371                                                                       )).
      372           .
      373           assign
      374           v-exist-rule-script = yes
      375           .
      376         end.
      377         if buf_rule-script.script-type = 'CONS':U
      378         or buf_rule-script.script-type = 'GOTO':U
      379         then do:
      380           run temp-string_write in this-procedure ( input  substitute("&1/* Salience &2 rule_id &3*/"
      381                                                                        ,fill(chr(32), 70)
      382                                                                        ,buf_rule-script.salience
      383                                                                        ,buf_rule-script.rule_id
      384                                                                        )).
      385           find first buf_rule-i-script no-lock where
      386                     buf_rule-i-script.root_rule_id = buf_rule.root_rule_id
      387                and  buf_rule-i-script.script_id = buf_rule-script.script_id
      388                and  buf_rule-i-script.i-script-type = 'variable':U no-error.
      389           if available buf_rule-i-script then do:
      390             run temp-string_write in this-procedure ( input  substitute("/*&1&2 .*/"
      391                                                                         ,fill( chr(32), p-level * 2)
      392                                                                         ,replace(buf_rule-script.script, (chr(38) + chr(38)), chr(38))
      393                                                                         )).
      394           end.
      395           else do:
      396             run temp-string_write in this-procedure ( input  substitute("&1&2 ."
      397                                                                   ,fill( chr(32), p-level * 2)
      398                                                                   ,replace(buf_rule-script.script, (chr(38) + chr(38)), chr(38))
      399                                                                   )).
      400           end.
      401         end.
      402         if buf_rule-script.script-type = 'RULE':U
      403         or buf_rule-script.script-type = 'ELSE-RULE':U
      404         then do:
      405           find first buf_rule no-lock where
      406                   buf_rule.upper_rule_id = p-rule-id
      407               and buf_rule.salience = buf_rule-script.salience no-error .
      408           if not available buf_rule then do:
      409             message
      410             substitute("Не найдено правило &1 вышестояшего уровня к скрипту типа &2:&3№ скрипта &4, порядок &5"
      411                        , p-rule-id
      412                        , buf_rule-script.script-type
      413                        , chr(10)
      414                        , buf_rule-script.script_id
      415                        , buf_rule-script.salience )
      416             view-as alert-box error .
      417             return.
      418           end.
      419           if buf_rule-script.script-type = 'ELSE-RULE':U then do:
      420             run temp-string_write in this-procedure ( input substitute("&1else do: /*rule &2*/"
      421                                                                         ,fill( chr(32), p-level * 2)
      422                                                                         ,buf_rule.rule_id)).
      423             assign
      424             v-exist-rule-script = yes
      425             .
      426           end.
      427           p-level = p-level + 1.
      428           run display-rule ( input buf_rule.rule_id, input buf_rule.upper_rule_id, input p-language, input-output p-level).
      429           p-level = p-level - 1.
      430           if v-exist-rule-script then do:
      431             run temp-string_write in this-procedure ( input substitute("&1end. /*of rule &2*/"
      432                                                                         ,fill( chr(32), p-level * 2)
      433                                                                         ,buf_rule.rule_id)).
      434             v-exist-rule-script = no.
      435           end.
      436         end.
      437       END.
      438       if v-exist-rule-script then do:
      439         run temp-string_write in this-procedure ( input substitute("&1end.&2end. /*of rule &3*/"
      440                                                                     ,fill( chr(32), p-level * 2)
      441                                                                     ,chr(10)
      442                                                                     ,p-rule-id)).
      443       end.
      444       else do:
      445         run temp-string_write in this-procedure ( input substitute("&1&2end. /*of rule &3*/"
      446                                                                     ,chr(10)
      447                                                                     ,fill( chr(32), p-level * 2)
      448                                                                     ,p-rule-id)).
      449       end.
      450     END.
      451     WHEN "rus"
      452     or
      453     when "rus-ext"
      454     THEN DO:
      455       find first buf_rule no-lock where
      456                 buf_rule.rule_id = p-rule-id.
      457       if p-upper-rule-id = 0 then do:
      458         run temp-string_write in this-procedure ( input buf_rule.name ).
      459         run temp-string_write in this-procedure ( input buf_rule.documentation ).
      460         run temp-string_write in this-procedure ( input '':U).
      461         if buf_rule.hidden-content > 0 then do:
      462           run temp-string_write in this-procedure ( input "НЕЛЬЗЯ ПРОСМОТРЕТЬ СОДЕРЖИМОЕ ПРАВИЛА").
      463           return.
      464         end.
      465       end.
      466       else do:
      467         if p-language = "rus-ext" then do:
      468           run temp-string_write in this-procedure ( input substitute("&1/* порядок &2 правила &3 */"
      469                                                                     ,fill(chr(32), 70)
      470                                                                     ,buf_rule.salience
      471                                                                     ,buf_rule.upper_rule_id
      472                                                                     )).
      473         end.
      474       end.
      475       run temp-string_write in this-procedure ( input substitute("_Правило &1:",  p-RULE-id)).
      476       FOR EACH buf_rule-script NO-LOCK WHERE
      477               buf_rule-script.RULE_id = p-rULE-id
      478           AND buf_rule-script.LANGUAGE = "rus":
      479        if buf_rule-script.script-type = 'COND':U then do:
      480           if p-language = "rus-ext" then do:
      481             run temp-string_write in this-procedure ( input  substitute("&1/* порядок &2 правила &3*/"
      482                                                                         ,fill(chr(32), 70)
      483                                                                         ,buf_rule-script.salience
      484                                                                         ,buf_rule-script.rule_id
      485                                                                         )).
      486           end.
      487           run temp-string_write in this-procedure ( input  substitute("&1Если &2 тогда: "
      488                                                                         ,fill( chr(32), p-level * 2)
      489                                                                         ,buf_rule-script.script )).
      490           assign
      491           v-exist-rule-script = yes
      492           .
      493         end.
      494        if buf_rule-script.script-type = 'CYCLE-COND':U then do:
      495           if p-language = "rus-ext" then do:
      496             run temp-string_write in this-procedure ( input  substitute("&1/* порядок &2 правила &3*/"
      497                                                                         ,fill(chr(32), 70)
      498                                                                         ,buf_rule-script.salience
      499                                                                         ,buf_rule-script.rule_id
      500                                                                         )).
      501           end.
      502           run temp-string_write in this-procedure ( input  substitute("&1ПОКА &2: "
      503                                                                         ,fill( chr(32), p-level * 2)
      504                                                                         ,buf_rule-script.script )).
      505           assign
      506           v-exist-rule-script = yes
      507           .
      508         end.
      509         if buf_rule-script.script-type = 'RULE':U
      510         or buf_rule-script.script-type = 'ELSE-RULE':U
      511         then do:
      512           find first buf_rule no-lock where
      513                   buf_rule.upper_rule_id = p-rule-id
      514               and buf_rule.salience = buf_rule-script.salience no-error .
      515           if not available buf_rule then do:
      516             message
      517             substitute("Не найдено правило &1 вышестояшего уровня к скрипту типа &2:&3№ скрипта &4, порядок &5"
      518                        , p-rule-id
      519                        , buf_rule-script.script-type
      520                        , chr(10)
      521                        , buf_rule-script.script_id
      522                        , buf_rule-script.salience )
      523             view-as alert-box error .
      524             return.
      525           end.
      526           if buf_rule-script.script-type = 'ELSE-RULE':U then do:
      527             run temp-string_write in this-procedure ( input substitute("&1ИНАЧЕ: /*правило &2*/"
      528                                                                         ,fill( chr(32), p-level * 2)
      529                                                                         ,buf_rule.rule_id)).
      530             assign
      531             v-exist-rule-script = yes
      532             .
      533           end.
      534           p-level = p-level + 1.
      535           run display-rule ( input buf_rule.rule_id, input buf_rule.upper_rule_id, input p-language, input-output p-level).
      536           p-level = p-level - 1.
      537         end.
      538         if buf_rule-script.script-type = 'CONS':U
      539         or buf_rule-script.script-type = 'GOTO':U
      540         then do:
      541           if p-language = "rus-ext" then do:
      542             run temp-string_write in this-procedure ( input substitute("&1/* порядок &2 правила &3*/"
      543                                                                         ,fill(chr(32), 70)
      544                                                                         ,buf_rule-script.salience
      545                                                                         ,buf_rule-script.rule_id
      546                                                                         )).
      547           end.
      548           run temp-string_write in this-procedure ( input substitute("&1&2 ;"
      549                                                                       ,fill( chr(32), p-level * 2)
      550                                                                       ,buf_rule-script.script )).
      551         end.
      552       END.
      553       if v-exist-rule-script then do:
      554         run temp-string_write in this-procedure ( input substitute("&1. /* конец правила &2 */"
      555                                                                       ,fill( chr(32), p-level * 2)
      556                                                                       ,p-rule-id) ).
      557       end.
      558       else do:
      559         run temp-string_write in this-procedure ( input substitute("&1. /* конец правила &2 */"
      560                                                                       ,fill( chr(32), p-level * 2)
      561                                                                       ,p-rule-id) ).
      562       end.
      563     END.
      564     when "DOT2-rus":U
      565     or
      566     when "DOT2-ABL":U then do:
      567       v-language = entry(2, p-language, "-").
      568       find first buf_rule no-lock where
      569                 buf_rule.rule_id = p-rule-id.
      570       if p-upper-rule-id = 0 then do:
      571         run temp-string_write in this-procedure ( input  substitute('Rule&1_&2_&3 [shape=ellipse , fillcolor=pink, style="rounded,filled",  label="Правило&4\n&1_&2_&3"];'
      572                                                                   , buf_rule.rule_id
      573                                                                   , buf_rule.upper_rule_id
      574                                                                   , buf_rule.salience
      575                                                                   , (if buf_rule.hidden-content > 0 then " (содержимое скрыто) " else "")
      576                                                                   )
      577                                                                   ).
      578         if buf_rule.hidden-content > 0 then do:
      579           return.
      580         end.
      581       end.
      582       else do:
      583       end.
      584       FOR EACH buf_rule-script NO-LOCK WHERE
      585               buf_rule-script.RULE_id = p-rULE-id
      586           AND buf_rule-script.LANGUAGE = v-language:
      587         if buf_rule-script.script-type = 'COND':U then do:
      588           run temp-string_write in this-procedure ( input   substitute('Condition&1_&2 [shape=diamond, fillcolor=yellow, style="rounded,filled", label="&3?"];'
      589                                                                       , buf_rule-script.rule_id
      590                                                                       , buf_rule-script.salience
      591                                                                       , replace(replace(replace(buf_rule-script.script, chr(34), "&#34;":U), "~~n", "\n"), chr(10), "\n")
      592                                                                       )).
      593         end.
      594         if buf_rule-script.script-type = 'CYCLE-COND':U then do:
      595           run temp-string_write in this-procedure ( input   substitute('Cyclecondition&1_&2 [shape=trapezium, fillcolor=yellowgreen, style="rounded,filled", label="&3?"];'
      596                                                                       , buf_rule-script.rule_id
      597                                                                       , buf_rule-script.salience
      598                                                                       , replace(replace(replace(buf_rule-script.script, chr(34), "&#34;":U), "~~n", "\n"), chr(10), "\n")
      599                                                                       )).
      600         end.
      601         if buf_rule-script.script-type = 'CONS':U then do:
      602           run temp-string_write in this-procedure ( input   substitute('Consequence&1_&2 [shape=box, fillcolor=lightgrey, style="rounded,filled", label="&3"];'
      603                                                                       , buf_rule-script.rule_id
      604                                                                       , buf_rule-script.salience
      605                                                                       , replace(replace(replace(buf_rule-script.script, chr(34), "&#34;":U), "~~n", "\n"), chr(10), "\n")
      606                                                                       )).
      607         end.
      608         if buf_rule-script.script-type = 'GOTO':U then do:
      609           run temp-string_write in this-procedure ( input   substitute('Goto&1_&2 [shape=invtriangle, fillcolor=pink, style="rounded,filled", label="&3"];'
      610                                                                       , buf_rule-script.rule_id
      611                                                                       , buf_rule-script.salience
      612                                                                       , replace(replace(replace(buf_rule-script.script, chr(34), "&#34;":U), "~~n", "\n"), chr(10), "\n")
      613                                                                       )).
      614         end.
      615         if buf_rule-script.script-type = 'RULE':U
      616         or buf_rule-script.script-type = 'ELSE-RULE':U
      617         then do:
      618           find first buf_down-rule no-lock where
      619                     buf_down-rule.upper_rule_id = p-rule-id
      620                 and buf_down-rule.salience = buf_rule-script.salience.
      621           p-level = p-level + 1.
      622           run display-rule ( input buf_down-rule.rule_id
      623                            , input buf_down-rule.upper_rule_id
      624                            , input p-language
      625                            , input-output p-level).
      626           p-level = p-level - 1.
      627         end.
      628       end.
      629       if p-upper-rule-id = 0 then do:
      630         run temp-string_write in this-procedure ( input substitute('End_Rule&1 [shape=ellipse , fillcolor=pink, style="rounded,filled", label="Конец\nправила &1"];'
      631                                                                     , p-rule-id)).
      632       end.
      633       if p-upper-rule-id = 0 then do:
      634         run temp-string_write in this-procedure ( input substitute("~}")).
      635       end.
      636      end.
      637       when "DOT1-rus"
      638       or
      639       when "DOT1-ABL"
      640       then do:
      641           DEFINE VARIABLE v-level AS INTEGER NO-UNDO.
      642           define variable v-start-script-id as integer no-undo .
      643           define variable v-end-script-id as integer no-undo .
      644           define variable v-script-type as character no-undo .
      645           define buffer buf2_tt-rule for tt-rule.
      646           v-language = entry(2, p-language, "-").
      647           find first buf_rule no-lock where
      648                     buf_rule.rule_id = p-rule-id.
      649           if p-upper-rule-id = 0 then do:
      650             RUN fill-tables IN THIS-PROCEDURE (  INPUT buf_rule.RULE_id
      651                                             ,INPUT buf_rule.root_RULE_id
      652                                             ,INPUT-OUTPUT v-level
      653                                             ,INPUT "") no-error.
      654             run temp-string_write in this-procedure ( input substitute("digraph rule&1 ~{", p-rule-id)).
      655             run temp-string_write in this-procedure ( input substitute('node [fontsize=12];')).
      656             run temp-string_write in this-procedure ( input substitute('nodesep=0.30;')).
      657             run temp-string_write in this-procedure ( input substitute('ranksep=0.30;')).
      658             if buf_rule.hidden-content > 0 then do:
      659               return.
      660             end.
      661             _tt-rule:
      662             for each buf_tt-rule no-lock where
      663                     buf_tt-rule.root_rule_id = buf_rule.root_rule_id:
      664               if buf_tt-rule.rule_id = buf_tt-rule.root_rule_id then do:
      665                 find first buf_tt-rule-script where
      666                           buf_tt-rule.rule_id = buf_tt-rule.rule_id.
      667                 assign
      668                 v-start-script-id = buf_tt-rule-script.script_id
      669                 v-end-script-id = -1
      670                 .
      671               end.
      672               else do:
      673                 find first buf_tt-rule-script no-lock where
      674                         buf_tt-rule-script.rule_id = buf_tt-rule.upper_rule_id
      675                     and buf_tt-rule-script.salience = buf_tt-rule.salience.
      676                 assign
      677                 v-salience = buf_tt-rule-script.salience
      678                 v-script-type = buf_tt-rule-script.script-type
      679                 .
      680                 find last buf_tt-rule-script no-lock where
      681                         buf_tt-rule-script.rule_id = buf_tt-rule.upper_rule_id
      682                     and buf_tt-rule-script.salience < buf_tt-rule.salience
      683                     and buf_tt-rule-script.script-type <> 'RULE':U
      684                     and buf_tt-rule-script.script-type <> 'ELSE-RULE':U
      685                     .
      686                 assign
      687                 v-start-script-id = buf_tt-rule-script.script_id.
      688                 find first buf2_tt-rule where
      689                           buf2_tt-rule.rule_id = buf_tt-rule.rule_id.
      690                 assign
      691                 v-salience = buf_tt-rule.salience
      692                 v-rule-id = buf_tt-rule.upper_rule_id
      693                 .
      694                 _TTT:
      695                 do while true:
      696                   find first buf_tt-rule-script no-lock where
      697                           buf_tt-rule-script.rule_id = v-rule-id
      698                       and buf_tt-rule-script.salience > v-salience
      699                       and buf_tt-rule-script.script-type <>  'RULE':U
      700                       and buf_tt-rule-script.script-type <>  'ELSE-RULE':U
      701                       no-error
      702                       .
      703                   if not available buf_tt-rule-script then do:
      704                     if buf2_tt-rule.upper_rule_id = 0 then do:
      705                       v-end-script-id = -1.
      706                       leave _ttt.
      707                     end.
      708                     else do:
      709                       find first buf2_tt-rule where
      710                                 buf2_tt-rule.rule_id = v-rule-id.
      711                       assign
      712                       v-salience = buf2_tt-rule.salience
      713                       v-rule-id = buf2_tt-rule.upper_rule_id
      714                       .
      715                     end.
      716                   end.
      717                   else do:
      718                     assign
      719                     v-end-script-id = buf_tt-rule-script.script_id.
      720                     leave _ttt.
      721                   end.
      722                 end.
      723                 for each buf_tt-rule-script where
      724                         buf_tt-rule-script.rule_id = buf_tt-rule.rule_id:
      725                   assign
      726                   buf_tt-rule-script.start-script_id = v-start-script-id
      727                   buf_tt-rule-script.end-script_id = v-end-script-id
      728                   buf_tt-rule-script.edge-type = (if v-script-type = 'RULE':U
      729                                                   then "yes"
      730                                                   else "no")
      731                   .
      732                 end.
      733               end.
      734             end.
      735           end.
      736           if p-upper-rule-id = 0 then do:
      737             assign
      738             v-prev-node =  substitute("Rule&1_&2_&3"
      739                                     , buf_rule.rule_id
      740                                     , buf_rule.upper_rule_id
      741                                     , buf_rule.salience
      742                                     ).
      743             for each buf_tt-rule-script by
      744                   buf_tt-rule-script.gen-order:
      745               create buf_temp-edge.
      746               assign
      747               buf_temp-edge.from-script_id = 0
      748               buf_temp-edge.to-script_id = buf_tt-rule-script.script_id
      749               buf_temp-edge.edge-type = "":U
      750               .
      751               release buf_temp-edge.
      752               leave.
      753             end.
      754           end.
      755           FOR EACH buf_rule-script NO-LOCK WHERE
      756                   buf_rule-script.RULE_id = p-rULE-id
      757               AND buf_rule-script.LANGUAGE = v-language:
      758             if buf_rule-script.script-type = 'RULE':U
      759             or buf_rule-script.script-type = 'ELSE-RULE':U
      760             then do:
      761               find first buf_down-rule no-lock where
      762                         buf_down-rule.upper_rule_id = p-rule-id
      763                     and buf_down-rule.salience = buf_rule-script.salience no-error .
      764               if error-status :error then do:
      765               end.
      766               p-level = p-level + 1.
      767               run display-rule ( input buf_down-rule.rule_id, input buf_down-rule.upper_rule_id, input p-language, input-output p-level).
      768               p-level = p-level - 1.
      769             end.
      770             run create-temp-edge in this-procedure ( buffer buf_rule-script
      771                                                     ,input v-language
      772                                                     ,output v-current-node
      773                                                     ).
      774             _temp-edge:
      775             for each buf_temp-edge where
      776                     buf_temp-edge.from-script_id = buf_rule-script.script_id:
      777               if buf_temp-edge.to-script_id = -1 then do:
      778                 assign
      779                 v-next-node =  substitute("End_Rule&1"
      780                                   , buf_rule-script.root_rule_id
      781                                   ).
      782               end.
      783               else do:
      784                 find first buf_tt-rule-script where buf_tt-rule-script.script_id = buf_temp-edge.to-script_id no-error .
      785                 if not available buf_tt-rule-script then do:
      786                   next _temp-edge.
      787                 end.
      788                 case buf_tt-rule-script.script-type:
      789                   when 'CONS':U then do:
      790                     assign
      791                     v-next-node  = substitute("Consequence&1_&2"
      792                                         , buf_tt-rule-script.rule_id
      793                                         , buf_tt-rule-script.salience).
      794                   end.
      795                   when 'GOTO':U then do:
      796                     assign
      797                     v-next-node  = substitute("Goto&1_&2"
      798                                         , buf_tt-rule-script.rule_id
      799                                         , buf_tt-rule-script.salience).
      800                   end.
      801                   when 'COND':U then do:
      802                     assign
      803                     v-next-node  = substitute("Condition&1_&2"
      804                                         , buf_tt-rule-script.rule_id
      805                                         , buf_tt-rule-script.salience).
      806                   end.
      807                   when 'CYCLE-COND':U then do:
      808                     assign
      809                     v-next-node  = substitute("Cyclecondition&1_&2"
      810                                         , buf_tt-rule-script.rule_id
      811                                         , buf_tt-rule-script.salience).
      812                   end.
      813                   when 'ELSE-RULE':U then do:
      814                     next _temp-edge.
      815                   end.
      816                 end case.
      817               end.
      818               if can-find(first temp-edge where
      819                               temp-edge.from-script_id = 0
      820                           and temp-edge.to-script_id = buf_rule-script.script_id) then do:
      821                 run temp-string_write in this-procedure ( input substitute("&1 -> &2"
      822                                                                             ,v-prev-node
      823                                                                             ,v-current-node
      824                                                                             )).
      825               end.
      826               run temp-string_write in this-procedure ( input substitute("&1 -> &2&3"
      827                                                                           ,v-current-node
      828                                                                           ,v-next-node
      829                                                       ,(if buf_temp-edge.edge-type = ""
      830                                                         then "":U
      831                                                         else substitute('[taillabel="&1"]'
      832                                                                         , buf_temp-edge.edge-type)
      833                                                         )
      834                                                                           )).
      835             end.
      836           end.
      837         end.
      838   END CASE.
      839   END procedure.
      840   procedure create-temp-edge :
      841   define parameter buffer buf_rule-script for ub.rule-script.
      842   define input parameter p-language as character no-undo .
      843   define output parameter p-current-node as character no-undo .
      844   define variable v-salience as integer no-undo .
      845   define variable v-rule-id as integer no-undo .
      846   define variable v-gen-order as character no-undo .
      847   define variable v-goto-text as character no-undo .
      848   define variable v-goto-rule as character no-undo .
      849   define variable v-ii as integer no-undo .
      850   define variable v-script-id as integer no-undo .
      851   define variable v-script-type as character no-undo .
      852   define variable v-int as integer no-undo .
      853   define buffer buf_tt-rule-script for tt-rule-script.
      854   define buffer buf_tt-rule for tt-rule.
      855   define buffer buf_temp-edge for temp-edge.
      856   define buffer buf2_rule for ub.rule.
      857   do
      858   on error undo, return error
      859   :
      860     case buf_rule-script.script-type:
      861       when 'COND':U then do:
      862         assign
      863         p-current-node  = substitute("Condition&1_&2"
      864                           , buf_rule-script.rule_id
      865                           , buf_rule-script.salience).
      866        for each buf_tt-rule-script where
      867                 buf_tt-rule-script.start-script_id = buf_rule-script.script_id
      868             and buf_tt-rule-script.edge-type = "yes"
      869         by buf_tt-rule-script.gen-order:
      870           create buf_temp-edge.
      871           assign
      872           buf_temp-edge.from-script_id = buf_rule-script.script_id
      873           buf_temp-edge.to-script_id = buf_tt-rule-script.script_id
      874           buf_temp-edge.edge-type = buf_tt-rule-script.edge-type
      875           .
      876           leave.
      877        end.
      878        for each buf_tt-rule-script where
      879                 buf_tt-rule-script.start-script_id = buf_rule-script.script_id
      880             and buf_tt-rule-script.edge-type = "no"
      881         by buf_tt-rule-script.gen-order:
      882           create buf_temp-edge.
      883           assign
      884           buf_temp-edge.from-script_id = buf_rule-script.script_id
      885           buf_temp-edge.to-script_id = buf_tt-rule-script.script_id
      886           buf_temp-edge.edge-type = buf_tt-rule-script.edge-type
      887           .
      888           leave.
      889        end.
      890        if not available buf_tt-rule-script then do:
      891         assign
      892         v-rule-id = buf_rule-script.rule_id
      893         v-salience = buf_rule-script.salience
      894         .
      895         find first buf_tt-rule-script where
      896                   buf_tt-rule-script.rule_id = v-rule-id
      897               and buf_tt-rule-script.salience > v-salience
      898               and buf_tt-rule-script.script-type <> 'RULE':U
      899               and buf_tt-rule-script.script-type <> 'ELSE-RULE':U
      900               no-error.
      901         if not available buf_tt-rule-script then do:
      902           if buf_rule-script.rule_id = buf_rule-script.root_rule_id then do:
      903             create buf_temp-edge.
      904             assign
      905             buf_temp-edge.from-script_id = buf_rule-script.script_id
      906             buf_temp-edge.to-script_id = -1
      907             buf_temp-edge.edge-type = "no"
      908             .
      909           end.
      910           else do:
      911             find first buf_tt-rule-script where
      912                       buf_tt-rule-script.script_id = buf_rule-script.script_id.
      913             create buf_temp-edge.
      914             assign
      915             buf_temp-edge.from-script_id = buf_rule-script.script_id
      916             buf_temp-edge.to-script_id = buf_tt-rule-script.end-script_id
      917             buf_temp-edge.edge-type = "no"
      918             .
      919           end.
      920         end.
      921         else do:
      922           create buf_temp-edge.
      923           assign
      924           buf_temp-edge.from-script_id = buf_rule-script.script_id
      925           buf_temp-edge.to-script_id = buf_tt-rule-script.script_id
      926           buf_temp-edge.edge-type = "no"
      927           .
      928         end.
      929        end.
      930       end.
      931       when 'CYCLE-COND':U then do:
      932         assign
      933         p-current-node  = substitute("Cyclecondition&1_&2"
      934                           , buf_rule-script.rule_id
      935                           , buf_rule-script.salience).
      936        for each buf_tt-rule-script where
      937                 buf_tt-rule-script.start-script_id = buf_rule-script.script_id
      938             and buf_tt-rule-script.edge-type = "yes"
      939         by buf_tt-rule-script.gen-order:
      940           v-ii = v-ii + 1.
      941           if v-ii = 1 then do:
      942             create buf_temp-edge.
      943             assign
      944             buf_temp-edge.from-script_id = buf_rule-script.script_id
      945             buf_temp-edge.to-script_id = buf_tt-rule-script.script_id
      946             buf_temp-edge.edge-type = buf_tt-rule-script.edge-type
      947             .
      948           end.
      949           assign
      950           v-script-id = buf_tt-rule-script.script_id
      951           v-script-type = buf_tt-rule-script.script-type
      952           v-rule-id = buf_tt-rule-script.rule_id
      953           v-salience = buf_tt-rule-script.salience
      954           .
      955         end.
      956         _cont:
      957         do while true:
      958           if v-script-type <> 'RULE':U
      959           and v-script-type <> 'ELSE-RULE':U then do:
      960             create buf_temp-edge.
      961             assign
      962             buf_temp-edge.to-script_id = buf_rule-script.script_id
      963             buf_temp-edge.from-script_id = v-script-id
      964             buf_temp-edge.edge-type = "continue"
      965             .
      966             leave _cont.
      967           end.
      968           find first buf_tt-rule where
      969                     buf_tt-rule.upper_rule_id = v-rule-id
      970                 and buf_tt-rule.salience = v-salience.
      971           for each buf_tt-rule-script where
      972                   buf_tt-rule-script.rule_id = buf_tt-rule.rule_id
      973           by buf_tt-rule-script.gen-order:
      974             assign
      975             v-script-id = buf_tt-rule-script.script_id
      976             v-script-type = buf_tt-rule-script.script-type
      977             v-rule-id = buf_tt-rule-script.rule_id
      978             v-salience = buf_tt-rule-script.salience
      979             .
      980           end.
      981         end.
      982       end.
      983       when 'CONS':U
      984       then do:
      985         assign
      986         p-current-node  = substitute("Consequence&1_&2"
      987                             , buf_rule-script.rule_id
      988                             , buf_rule-script.salience).
      989         assign
      990         v-rule-id = buf_rule-script.rule_id
      991         v-salience = buf_rule-script.salience
      992         .
      993         find first buf_tt-rule-script where
      994                   buf_tt-rule-script.rule_id = v-rule-id
      995               and buf_tt-rule-script.salience > v-salience no-error.
      996         if not available buf_tt-rule-script then do:
      997           if buf_rule-script.rule_id = buf_rule-script.root_rule_id then do:
      998             create buf_temp-edge.
      999             assign
     1000             buf_temp-edge.from-script_id = buf_rule-script.script_id
     1001             buf_temp-edge.to-script_id = -1
     1002             buf_temp-edge.edge-type = ""
     1003             .
     1004           end.
     1005           else do:
     1006             find first buf_tt-rule-script where
     1007                       buf_tt-rule-script.script_id = buf_rule-script.script_id.
     1008             create buf_temp-edge.
     1009             assign
     1010             buf_temp-edge.from-script_id = buf_rule-script.script_id
     1011             buf_temp-edge.to-script_id = buf_tt-rule-script.end-script_id
     1012             buf_temp-edge.edge-type = ""
     1013             .
     1014           end.
     1015         end.
     1016         else do:
     1017           create buf_temp-edge.
     1018           assign
     1019           buf_temp-edge.from-script_id = buf_rule-script.script_id
     1020           buf_temp-edge.to-script_id = buf_tt-rule-script.script_id
     1021           buf_temp-edge.edge-type = ""
     1022           .
     1023         end.
     1024       end.
     1025       when 'GOTO':U then do:
     1026         assign
     1027         p-current-node  = substitute("Goto&1_&2"
     1028                             , buf_rule-script.rule_id
     1029                             , buf_rule-script.salience).
     1030         find first buf_tt-rule-script where
     1031                 buf_tt-rule-script.rule_id = buf_rule-script.rule_id
     1032             and buf_tt-rule-script.language = "ABL"
     1033             and buf_tt-rule-script.salience = buf_rule-script.salience.
     1034         v-goto-text = trim(buf_tt-rule-script.script, chr(32)).
     1035         if v-goto-text begins "leave":U then do:
     1036           v-goto-rule = trim(trim(replace(v-goto-text, "leave":U, "":U), chr(32)), "_":U).
     1037           if v-goto-rule = string(buf_rule-script.root_rule_id) then do:
     1038             create buf_temp-edge.
     1039             assign
     1040             buf_temp-edge.from-script_id = buf_rule-script.script_id
     1041             buf_temp-edge.to-script_id =  -1
     1042             buf_temp-edge.edge-type = ""
     1043             .
     1044           end.
     1045           else do:
     1046             assign
     1047             v-int = integer(v-goto-rule) no-error.
     1048             if not error-status:error then do:
     1049               find first buf_tt-rule-script where
     1050                           buf_tt-rule-script.upper_rule_id = v-int .
     1051               create buf_temp-edge.
     1052               assign
     1053               buf_temp-edge.from-script_id = buf_rule-script.script_id
     1054               buf_temp-edge.to-script_id = buf_tt-rule-script.end-script_id
     1055               buf_temp-edge.edge-type = "leave"
     1056               .
     1057             end.
     1058           end.
     1059         end.
     1060         if v-goto-text begins "next":U then do:
     1061           v-goto-rule = trim(replace(v-goto-text, "next":U, "":U), chr(32)).
     1062           if v-goto-rule = substitute("_&1", buf_rule-script.root_rule_id) then do:
     1063             find first buf_tt-rule-script where
     1064                       buf_tt-rule-script.rule_id = buf_rule-script.root_rule_id.
     1065             create buf_temp-edge.
     1066             assign
     1067             buf_temp-edge.from-script_id = buf_rule-script.script_id
     1068             buf_temp-edge.to-script_id = buf_tt-rule-script.script_id
     1069             buf_temp-edge.edge-type = ""
     1070             .
     1071           end.
     1072           else do:
     1073             assign
     1074             v-int = integer(trim(v-goto-rule, "_")) no-error.
     1075             if not error-status:error then do:
     1076               find first buf_tt-rule-script where
     1077                           buf_tt-rule-script.upper_rule_id = v-int .
     1078               create buf_temp-edge.
     1079               assign
     1080               buf_temp-edge.from-script_id = buf_rule-script.script_id
     1081               buf_temp-edge.to-script_id = buf_tt-rule-script.end-script_id
     1082               buf_temp-edge.edge-type = "next"
     1083               .
     1084             end.
     1085             else do:
     1086               create buf_temp-edge.
     1087               assign
     1088               buf_temp-edge.from-script_id = buf_rule-script.script_id
     1089               buf_temp-edge.to-script_id = -1
     1090               buf_temp-edge.edge-type = "next"
     1091               .
     1092             end.
     1093           end.
     1094         end.
     1095       end.
     1096     end case.
     1097   end.
     1098   end procedure.
     1099   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1100   define stream instream3.
     1101   procedure copy-file-to-temp-string :
     1102   define input parameter p-file-name as character no-undo .
     1103   define variable ss as character no-undo .
     1104     do
     1105     on error undo, return error
     1106     :
     1107       input stream instream3 from value(p-file-name).
     1108       repeat:
     1109         import stream instream3
     1110         unformatted ss.
     1111         run temp-string_write in this-procedure ( input ss).
     1112       end.
     1113       input stream instream3  close.
     1114     end.
     1115   end procedure.
     1116   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1117   procedure display-prop-script :
     1118   define parameter buffer buf_prop-script for ub.prop-script.
     1119     do
     1120     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1121     :
     1122       if buf_prop-script.script-type = 'ifunction':U then do:
     1123         run temp-string_write in this-procedure ( input buf_prop-script.script-body ).
     1124       end.
     1125       else do:
     1126         if lookup(buf_prop-script.proc-type, 'class,data-member,property,method,constructor,destructor':u) > 0 then do:
     1127         end.
     1128         else do:
     1129           run temp-string_write in this-procedure ( input buf_prop-script.script-head ).
     1130           run temp-string_write in this-procedure ( input buf_prop-script.script-body ).
     1131           run temp-string_write in this-procedure ( input buf_prop-script.script-foot ).
     1132         end.
     1133       end.
     1134     end.
     1135   end procedure.
     1136   def var vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1137   procedure gen-key-rec :
     1138     define input  parameter p-tbl-name    as character no-undo.
     1139     define input  parameter p-bh_tbl-name as handle    no-undo.
     1140     define output parameter p-key-rec     as character no-undo.
     1141     do
     1142     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1143     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     1144     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     1145     :
     1146       define variable fh               as handle    no-undo .
     1147       define variable v-ok             as logical   no-undo .
     1148       define variable v-inform         as character no-undo .
     1149       define variable v-ind            as integer   no-undo .
     1150       define variable v-idx-field-qnty as integer   no-undo .
     1151       if p-tbl-name = ?
     1152         or p-tbl-name = "":U
     1153       then do:
     1154         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info5 ).
     1155       end.
     1156       if not p-bh_tbl-name:available then do:
     1157         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info5, p-tbl-name ).
     1158       end.
     1159       assign
     1160         p-key-rec = p-tbl-name
     1161         v-inform  = p-bh_tbl-name:index-information(1)
     1162         v-ind     = 2
     1163       .
     1164       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1165       on error undo, return error
     1166       :
     1167         assign
     1168           v-inform = p-bh_tbl-name:index-information( v-ind )
     1169           v-ind    = v-ind + 1
     1170         .
     1171       end.
     1172       if v-inform = ?
     1173         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1174         or entry( 3, v-inform, ",":U ) <> "1":U
     1175       then do:
     1176         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, p-tbl-name ).
     1177       end.
     1178       else do:
     1179         assign
     1180           v-idx-field-qnty = num-entries( v-inform ) - 4
     1181         .
     1182         if v-idx-field-qnty < 2 then do:
     1183           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, p-tbl-name ).
     1184         end.
     1185         do v-ind = 1 to v-idx-field-qnty by 2
     1186         on error undo, return error
     1187         :
     1188           assign
     1189             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     1190             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     1191           .
     1192         end.
     1193       end.
     1194       if p-key-rec = ? then do:
     1195         assign
     1196           p-key-rec = "":U
     1197         .
     1198         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info5, p-tbl-name ).
     1199       end.
     1200     end.
     1201     return.
     1202   end procedure.
     1203   procedure gen-where-keyr-tab :
     1204     define input  parameter i-tableSerach as character no-undo.
     1205     define input  parameter i-tablekey   as character  no-undo.
     1206     define input  parameter p-key-rec    as character  no-undo.
     1207     define input  parameter p-key-handle as handle     no-undo .
     1208     define input  parameter p-db-name    as character  no-undo .
     1209     define input  parameter p-tt-handle  as handle     no-undo .
     1210     define output parameter o-Where      as character  no-undo.
     1211     do
     1212     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1213     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1214     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     1215     :
     1216       define variable v-full-tbl-name  as character no-undo .
     1217       define variable bh_tbl-name      as handle    no-undo .
     1218       define variable fh_key           as handle    no-undo .
     1219       define variable fh_search        as handle    no-undo .
     1220       define variable v-field-num      as integer   no-undo .
     1221       define variable v-count-fld      as integer   no-undo .
     1222       define variable v-inform         as character no-undo .
     1223       define variable v-ind            as integer   no-undo .
     1224       define variable v-idx-field-qnty as integer   no-undo .
     1225       define variable v-field-name     as character no-undo .
     1226       define variable v-field-val      as character no-undo .
     1227       define variable v-word-link      as character no-undo .
     1228       define variable vTable           as character no-undo.
     1229       define variable bh_tbl-key       as handle    no-undo .
     1230       assign
     1231         p-key-rec = trim( p-key-rec )
     1232       .
     1233       if p-key-handle <> ? then do:
     1234         if not valid-handle(p-key-handle)
     1235            or p-key-handle:type <> "buffer"
     1236         then do:
     1237           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info5 ).
     1238         end.
     1239         if num-entries( p-key-rec, chr(3) ) > 1
     1240           or p-key-rec = ?
     1241           or p-key-rec = "":U
     1242         then do:
     1243           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info5, p-key-rec ).
     1244         end.
     1245       end.
     1246       else do:
     1247         if p-key-rec = ?
     1248           or p-key-rec = "":U
     1249         then do:
     1250           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info5 ).
     1251         end.
     1252       end.
     1253       assign
     1254         vTable = entry( 1 , p-key-rec, chr(3) )
     1255       .
     1256       if p-tt-handle <> ?
     1257         and ( not valid-handle(p-tt-handle)
     1258               or p-tt-handle:type <> "buffer"
     1259             )
     1260       then do:
     1261         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info5, vTable, chr(10) ).
     1262       end.
     1263       if p-tt-handle = ? then do:
     1264         assign
     1265           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     1266         .
     1267         create buffer bh_tbl-name for table v-full-tbl-name .
     1268       end.
     1269       else do:
     1270         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1271       end.
     1272       assign
     1273         v-inform = bh_tbl-name:index-information(1)
     1274         v-ind    = 2
     1275       .
     1276       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1277       on error undo, return error
     1278       :
     1279         assign
     1280           v-inform = bh_tbl-name:index-information( v-ind )
     1281           v-ind    = v-ind + 1
     1282         .
     1283       end.
     1284       if v-inform = ?
     1285         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1286         or entry( 3, v-inform, ",":U ) <> "1":U
     1287       then do:
     1288         delete object bh_tbl-name no-error.
     1289         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info5, vTable ).
     1290       end.
     1291       assign
     1292         v-idx-field-qnty = num-entries( v-inform ) - 4
     1293       .
     1294       if v-idx-field-qnty < 2 then do:
     1295         delete object bh_tbl-name no-error.
     1296         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, vTable ).
     1297       end.
     1298       assign
     1299         o-where     = "where":U
     1300         v-word-link = "":U
     1301         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     1302         v-count-fld = 0
     1303       .
     1304       if i-tablekey ne "" and i-tablekey ne ?
     1305       then do:
     1306         assign
     1307           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     1308         .
     1309         create buffer bh_tbl-key for table v-full-tbl-name .
     1310       end.
     1311       if i-tableSerach ne "" and i-tableSerach ne ?
     1312       then do:
     1313         delete object bh_tbl-name no-error.
     1314         assign
     1315           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     1316         .
     1317         create buffer bh_tbl-name for table v-full-tbl-name .
     1318       end.
     1319       block_where:
     1320       do v-ind = 1 to v-idx-field-qnty by 2
     1321       on error undo, return error
     1322       :
     1323         assign
     1324           v-count-fld = v-count-fld + 1
     1325         .
     1326         if p-key-handle = ?
     1327           and v-count-fld > v-field-num
     1328         then do:
     1329           leave block_where.
     1330         end.
     1331         define variable VfieldKeyTable as handle no-undo.
     1332         assign
     1333           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1334           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     1335         .
     1336         if     bh_tbl-key ne ?
     1337         then do:
     1338            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     1339            if VfieldKeyTable eq ?
     1340            then next block_where.
     1341         end.
     1342         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     1343         then
     1344            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     1345         else
     1346            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     1347         if p-key-handle = ? then do:
     1348           assign
     1349             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     1350           .
     1351         end.
     1352         else do:
     1353           assign
     1354             fh_key = p-key-handle:buffer-field( v-field-name )
     1355           .
     1356           if fh_key = ?
     1357             or not valid-handle( fh_key )
     1358           then do:
     1359             delete object bh_tbl-name.
     1360             if     bh_tbl-key ne ?
     1361             then
     1362                delete object bh_tbl-key.
     1363             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info5, p-key-handle:name, v-field-name ).
     1364           end.
     1365           assign
     1366             v-field-val = fh_key:buffer-value
     1367           .
     1368         end.
     1369         if fh_search:data-type ="character":U then do:
     1370           assign
     1371             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1372             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1373             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1374             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1375             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1376             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1377             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1378             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1379             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1380             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1381             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1382             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1383             v-field-val = substitute( '"&1"', v-field-val )
     1384           .
     1385         end.
     1386         assign
     1387           o-where = substitute( "&1 &2", o-where, v-field-val )
     1388         .
     1389         if v-word-link = "":U then do:
     1390           assign
     1391             v-word-link = "and":U
     1392           .
     1393         end.
     1394       end.
     1395       delete object bh_tbl-name.
     1396       if     bh_tbl-key ne ?
     1397       then
     1398          delete object bh_tbl-key.
     1399       if p-key-handle = ?
     1400         and v-count-fld <> v-field-num
     1401       then do:
     1402         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info5, vTable ).
     1403       end.
     1404     end.
     1405   end procedure.
     1406   procedure gen-hn-keyr-tab :
     1407     define input  parameter i-tableSerach as character no-undo.
     1408     define input  parameter i-tablekey   as character no-undo.
     1409     define input  parameter p-key-rec    as character no-undo.
     1410     define input  parameter p-key-handle as handle    no-undo .
     1411     define input  parameter p-db-name    as character no-undo .
     1412     define input  parameter p-tt-handle  as handle    no-undo .
     1413     define input  parameter p-stts-lock  as integer   no-undo .
     1414     define output parameter o-hn         as handle    no-undo.
     1415     define variable v-full-tbl-name as character no-undo.
     1416     define variable v-where         as character no-undo.
     1417     define variable bh_tbl-name     as handle    no-undo.
     1418     define variable vTable          as character no-undo.
     1419     do
     1420     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1421     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1422     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1423         run gen-where-keyr-tab(i-tableSerach,
     1424                                i-tablekey,
     1425                                p-key-rec,
     1426                                p-key-handle,
     1427                                p-db-name,
     1428                                p-tt-handle,
     1429                                output v-where).
     1430         if i-tableSerach ne "" and i-tableSerach ne ?
     1431         then do:
     1432            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1433            create buffer bh_tbl-name for table v-full-tbl-name .
     1434         end.
     1435         else do:
     1436            if p-tt-handle = ? then do:
     1437               assign
     1438                  vTable = entry( 1 , p-key-rec, chr(3) )
     1439               .
     1440               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1441               create buffer bh_tbl-name for table v-full-tbl-name .
     1442            end.
     1443            else do:
     1444               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1445            end.
     1446         end.
     1447         if p-tt-handle = ? then do:
     1448            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1449         end.
     1450         else do:
     1451            bh_tbl-name:find-first( v-where ) no-error .
     1452         end.
     1453         o-hn = bh_tbl-name.
     1454      end.
     1455   end procedure.
     1456   procedure gen-hn-keyr :
     1457     define input  parameter p-key-rec    as character no-undo.
     1458     define input  parameter p-key-handle as handle    no-undo .
     1459     define input  parameter p-db-name    as character no-undo .
     1460     define input  parameter p-tt-handle  as handle    no-undo .
     1461     define input  parameter p-stts-lock  as integer   no-undo .
     1462     define output parameter o-hn         as handle    no-undo.
     1463     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1464   end.
     1465   procedure gen-row-keyr :
     1466     define input  parameter p-key-rec    as character no-undo.
     1467     define input  parameter p-key-handle as handle    no-undo .
     1468     define input  parameter p-db-name    as character no-undo .
     1469     define input  parameter p-tt-handle  as handle    no-undo .
     1470     define input  parameter p-stts-lock  as integer   no-undo .
     1471     define output parameter p-tbl-row    as rowid     no-undo.
     1472     define output parameter p-tbl-name   as character no-undo.
     1473     define variable vHn as handle no-undo.
     1474       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1475       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1476       p-tbl-name =  vHn:table.
     1477       delete object vHn no-error.
     1478     if p-tbl-row = ? then do:
     1479       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info5, p-tbl-name, p-key-rec ).
     1480     end.
     1481     else do:
     1482       return.
     1483     end.
     1484   end procedure.
     1485   procedure gen-key-fv :
     1486     define input  parameter p-key-rec    as character no-undo .
     1487     define output parameter p-field-list as character no-undo .
     1488     define output parameter p-value-list as character no-undo.
     1489     do
     1490     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1491     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1492     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1493     :
     1494       define variable v-full-tbl-name  as character no-undo .
     1495       define variable bh_tbl-name      as handle    no-undo .
     1496       define variable v-tbl-name       as character no-undo .
     1497       define variable v-field-num      as integer   no-undo .
     1498       define variable v-count-fld      as integer   no-undo .
     1499       define variable v-inform         as character no-undo .
     1500       define variable v-ind            as integer   no-undo .
     1501       define variable v-idx-field-qnty as integer   no-undo .
     1502       define variable v-delim-key      as character no-undo .
     1503       if p-key-rec = ?
     1504         or p-key-rec = "":U
     1505       then do:
     1506         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info5 ).
     1507       end.
     1508       assign
     1509         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1510         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1511       .
     1512       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1513       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info5 ).
     1514       assign
     1515         v-inform = bh_tbl-name:index-information(1)
     1516         v-ind    = 2
     1517       .
     1518       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1519       on error undo, return error
     1520       :
     1521         assign
     1522           v-inform = bh_tbl-name:index-information( v-ind )
     1523           v-ind    = v-ind + 1
     1524         .
     1525       end.
     1526       if v-inform = ?
     1527         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1528         or entry( 3, v-inform, ",":U ) <> "1":U
     1529       then do:
     1530         delete object bh_tbl-name no-error.
     1531         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, v-tbl-name ).
     1532       end.
     1533       assign
     1534         v-idx-field-qnty = num-entries( v-inform ) - 4
     1535       .
     1536       if v-idx-field-qnty < 2 then do:
     1537         delete object bh_tbl-name no-error.
     1538         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, v-tbl-name ).
     1539       end.
     1540       assign
     1541         p-field-list = "":U
     1542         p-value-list = "":U
     1543         v-delim-key  = "":U
     1544         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1545         v-count-fld  = 0
     1546       .
     1547       block_where:
     1548       do v-ind = 1 to v-idx-field-qnty by 2
     1549       on error undo, return error
     1550       :
     1551         assign
     1552           v-count-fld = v-count-fld + 1
     1553         .
     1554         if v-count-fld > v-field-num then do:
     1555           leave block_where.
     1556         end.
     1557         assign
     1558           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1559           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1560         .
     1561         if v-ind = 1 then do:
     1562           assign
     1563             v-delim-key = chr(3)
     1564           .
     1565         end.
     1566       end.
     1567       delete object bh_tbl-name.
     1568       if v-count-fld <> v-field-num then do:
     1569         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info5, v-tbl-name ).
     1570       end.
     1571     end.
     1572   end procedure.
     1573   procedure gen-key-field :
     1574     define input  parameter p-table      as character no-undo .
     1575     define output parameter p-field-list as character no-undo .
     1576     do
     1577     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1578     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1579     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1580     :
     1581       define variable v-full-tbl-name  as character no-undo .
     1582       define variable bh_tbl-name      as handle    no-undo .
     1583       define variable v-tbl-name       as character no-undo .
     1584       define variable v-field-num      as integer   no-undo .
     1585       define variable v-count-fld      as integer   no-undo .
     1586       define variable v-inform         as character no-undo .
     1587       define variable v-ind            as integer   no-undo .
     1588       define variable v-idx-field-qnty as integer   no-undo .
     1589       define variable v-delim-key      as character no-undo .
     1590       if p-table = ?
     1591         or p-table = "":U
     1592       then do:
     1593         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info5 ).
     1594       end.
     1595       assign
     1596         v-tbl-name      = p-table
     1597         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1598       .
     1599       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1600       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info5 ).
     1601       assign
     1602         v-inform = bh_tbl-name:index-information(1)
     1603         v-ind    = 2
     1604       .
     1605       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1606       on error undo, return error
     1607       :
     1608         assign
     1609           v-inform = bh_tbl-name:index-information( v-ind )
     1610           v-ind    = v-ind + 1
     1611         .
     1612       end.
     1613       if v-inform = ?
     1614         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1615         or entry( 3, v-inform, ",":U ) <> "1":U
     1616       then do:
     1617         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, v-tbl-name ).
     1618       end.
     1619       assign
     1620         v-idx-field-qnty = num-entries( v-inform ) - 4
     1621       .
     1622       if v-idx-field-qnty < 2 then do:
     1623         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, v-tbl-name ).
     1624       end.
     1625       assign
     1626         p-field-list = "":U
     1627         v-delim-key  = "":U
     1628         v-count-fld  = 0
     1629       .
     1630       block_where:
     1631       do v-ind = 1 to v-idx-field-qnty by 2
     1632       on error undo, return error
     1633       :
     1634         assign
     1635           v-count-fld = v-count-fld + 1
     1636         .
     1637         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1638         if v-ind = 1 then do:
     1639           assign
     1640             v-delim-key = chr(3)
     1641           .
     1642         end.
     1643       end.
     1644       delete object bh_tbl-name.
     1645     end.
     1646   end procedure.
     1647   define variable v-tbl-row as rowid no-undo .
     1648   define variable v-tbl-name as character no-undo .
     1649   define variable v-level as integer no-undo .
     1650   define variable ss as character no-undo .
     1651   define variable v-path                    as character                no-undo .
     1652   DEFINE VARIABLE v-full-path               as character                no-undo .
     1653   DEFINE VARIABLE v-file-name               as character                no-undo .
     1654   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
     1655   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
     1656   define variable v-ii as integer no-undo .
     1657   define variable v-script-type-list as character no-undo .
     1658   define variable v-include-flag            as logical no-undo .
     1659   define variable v-key-ruleset             as character no-undo .
     1660   define variable v-key-ruleset-2           as character no-undo .
     1661   define variable v-codex-id                as integer no-undo .
     1662   define variable v-ruleset-id              as integer no-undo .
     1663   define variable v-rp-file-name            as character no-undo .
     1664   define variable v-count-retry-action as logical no-undo .
     1665   define stream Outstream.
     1666   define stream Outstream2.
     1667   define stream instream.
     1668   define stream instream2.
     1669   define stream errstream .
     1670   define buffer buf_rule-profile for ub.rule-profile.
     1671   define buffer buf_rule-i-script for ub.rule-i-script.
     1672   define buffer buf_prop-script for ub.prop-script.
     1673   define buffer buf_prop-ruleset for ub.prop-ruleset.
     1674   define buffer buf_temp-string for temp-string.
     1675   define buffer buf_rule-by-set  for ub.rule-by-set.
     1676   define buffer buf_rule for ub.rule.
     1677   define buffer buf_rule-by-profile for ub.rule-by-profile.
     1678   define buffer buf_ruleset for ub.ruleset.
     1679   main-block:
     1680   do
     1681   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1682   :
     1683      find first buf_rule-profile no-lock where
     1684                 buf_rule-profile.profile_id = p-profile-id no-error.
     1685      if not available buf_Rule-profile then do:
     1686        undo main-block, return error substitute("Не найден профайл правил &1", p-profile-id).
     1687      end.
     1688     run temp-string_clear in this-procedure .
     1689     run gbl/filename.p (
     1690                     input substitute( "rul/rp-&1.i", entry(1, buf_rule-profile.profile-type, "_"))
     1691                   ,output v-full-path
     1692                   ,output v-path
     1693                   ,output v-file-name
     1694                   ,output v-file-name-no-ext
     1695                   ,output v-file-name-ext
     1696                   ) no-error .
     1697     if error-status:error then do:
     1698       undo main-block, return error return-value.
     1699     end.
     1700     for each buf_rule-by-profile where
     1701             buf_rule-by-profile.profile_id = p-profile-id,
     1702        first buf_rule no-lock where
     1703             buf_rule.rule_id = buf_rule-by-profile.rule_id
     1704     break
     1705     by buf_rule-by-profile.rule_id:
     1706       if first-of( buf_rule-by-profile.rule_id) then do:
     1707         if buf_rule.upper_rule_id <> 0 then do:
     1708           undo main-block, return error substitute("Правило &1 не является корневым", buf_rule-by-profile.rule_id).
     1709         end.
     1710         v-level = 0.
     1711         RUN fill-tables IN THIS-PROCEDURE (  INPUT buf_rule.RULE_id
     1712                                         ,INPUT buf_rule.root_RULE_id
     1713                                         ,INPUT-OUTPUT v-level
     1714                                         ,INPUT "") no-error.
     1715       end.
     1716     end.
     1717     input stream instream from value (v-full-path).
     1718     _repeat:
     1719     repeat :
     1720       import stream instream unformatted ss.
     1721       if not v-include-flag then do:
     1722         run temp-string_write in this-procedure ( input  ss).
     1723       end.
     1724       if index(ss, "&profile_id&") > 0 then do:
     1725         run temp-string_write in this-procedure ( input  substitute("v-profile-id = &1.", p-profile-id)).
     1726       end.
     1727       if index(ss, "&rp-short-name&") > 0 then do:
     1728         run temp-string_write in this-procedure ( input  substitute('v-rp-short-name = "&1".', buf_rule-profile.short-name)).
     1729       end.
     1730       if index(ss, "&start-using-class&") > 0 then do:
     1731         run using-class in this-procedure (  buffer buf_rule-profile ).
     1732       end.
     1733       if index(ss, "&start-hn-option&") > 0 then do:
     1734         run cycle-script-type in this-procedure ( input p-profile-id, "hist-nws") no-error .
     1735         if error-status:error then do:
     1736           undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     1737         end.
     1738       end.
     1739       if index(ss, "&start-i-script&") > 0 then do:
     1740         run hist-news-class in this-procedure (  buffer buf_rule-profile ).
     1741         v-script-type-list = 'define_b':U + chr(44) +
     1742                               'define_tt':U + chr(44) +
     1743                               'define_h':U + chr(44) +
     1744                               'variable':U
     1745                               .
     1746         do v-ii = 1 to num-entries(v-script-type-list):
     1747           run cycle-script-type in this-procedure ( input p-profile-id, input entry(v-ii, v-script-type-list)) no-error .
     1748           if error-status:error then do:
     1749             undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     1750           end.
     1751         end.
     1752         _rule-i-script:
     1753         for each buf_rule-by-profile where
     1754                 buf_rule-by-profile.profile_id = p-profile-id,
     1755            first buf_rule no-lock where
     1756                 buf_rule.rule_id = buf_rule-by-profile.rule_id,
     1757            each buf_rule-i-script no-lock where
     1758                 buf_rule-i-script.root_rule_id = buf_rule.rule_id,
     1759             each  buf_prop-script no-lock where
     1760                       buf_prop-script.dtm-code = buf_rule-i-script.dtm-code
     1761                   and  buf_prop-script.language = "ABL"
     1762                   and  buf_prop-script.script-name = buf_rule-i-script.script-name
     1763                   and  buf_prop-script.revis_id = buf_rule-i-script.revis_id
     1764         break
     1765               by buf_rule-i-script.i-script-name
     1766         on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1767         :
     1768           if first-of(buf_rule-i-script.i-script-name) then do:
     1769             if not (buf_prop-script.language = "ABL") then next _rule-i-script.
     1770             if lookup(buf_rule-i-script.i-script-type, v-script-type-list) > 0 then next _rule-i-script.
     1771             if lookup(buf_prop-script.script-type, "hist-nws") > 0 then next _rule-i-script.
     1772             run display-prop-script in this-procedure ( buffer buf_prop-script).
     1773           end.
     1774         end.
     1775         _rule-i-script:
     1776         for each buf_rule-by-profile where
     1777                 buf_rule-by-profile.profile_id = p-profile-id,
     1778            first buf_rule no-lock where
     1779                 buf_rule.rule_id = buf_rule-by-profile.rule_id,
     1780            each buf_rule-i-script no-lock where
     1781                 buf_rule-i-script.root_rule_id = buf_rule.rule_id
     1782             and buf_rule-i-script.script-type = '':U
     1783         break
     1784         by buf_rule-i-script.i-script-name
     1785         on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1786         :
     1787           if first-of(buf_rule-i-script.i-script-name) then do:
     1788             if not (buf_prop-script.language = "ABL") then next _rule-i-script.
     1789             if lookup(buf_rule-i-script.i-script-type, v-script-type-list) > 0 then next _rule-i-script.
     1790             if lookup(buf_prop-script.script-type, "hist-nws") > 0 then next _rule-i-script.
     1791             run display-subsid-rule-i-script in this-procedure ( buffer buf_rule-i-script).
     1792           end.
     1793         end.
     1794       end.
     1795       if index(ss, "&start-rule-block&") > 0 then do:
     1796       end.
     1797       if index(ss, "&start-codex_id") > 0 then do:
     1798         assign
     1799         v-key-ruleset = entry(2, ss, "&")
     1800         v-codex-id = 0
     1801         v-ruleset-id = 0
     1802         .
     1803         _ruleset:
     1804         for each buf_ruleset no-lock:
     1805           assign
     1806           v-key-ruleset-2 = substitute("start-codex_id=&1;ruleset_id=&2"
     1807                                         , buf_ruleset.codex_id
     1808                                         , buf_ruleset.ruleset_id).
     1809           if v-key-ruleset-2 = v-key-ruleset then do:
     1810             assign
     1811             v-codex-id = buf_ruleset.codex_id
     1812             v-ruleset-id = buf_ruleset.ruleset_id
     1813             .
     1814             leave _ruleset.
     1815           end.
     1816         end.
     1817         run gbl/_tmpfile.p (
     1818                             input ""
     1819                           , input "rp"
     1820                           , output v-rp-file-name) .
     1821         output stream outstream2 to value(v-rp-file-name).
     1822         v-include-flag = yes.
     1823       end.
     1824       if index(ss, "&end-codex_id") > 0 then do:
     1825         if v-include-flag =  yes then do:
     1826           output stream outstream2 close.
     1827           for each buf_rule-by-profile no-lock where
     1828                   buf_rule-by-profile.profile_id = p-profile-id
     1829              and buf_rule-by-profile.codex_id = v-codex-id
     1830              and buf_rule-by-profile.ruleset_id = v-ruleset-id,
     1831              first buf_rule no-lock where buf_rule.rule_id = buf_rule-by-profile.rule_id
     1832           break
     1833           by buf_rule-by-profile.codex_id
     1834           by buf_rule-by-profile.ruleset_id
     1835           by buf_rule-by-profile.rule_id:
     1836             if first-of(buf_rule-by-profile.rule_id) then do:
     1837               input stream instream2 from value(v-rp-file-name).
     1838               _v-rp-file-name:
     1839               repeat :
     1840                 import stream instream2 unformatted ss.
     1841                 if ss begins substitute("procedure r_&1_&2_"
     1842                                        , v-codex-id
     1843                                        , v-ruleset-id)
     1844                 then do:
     1845                   assign
     1846                   ss = substitute("procedure r_&1_&2_&3:"
     1847                                   , v-codex-id
     1848                                   , v-ruleset-id
     1849                                   , buf_rule-by-profile.rule_id
     1850                                   )
     1851                   .
     1852                 end.
     1853                 run temp-string_write in this-procedure ( input  ss).
     1854                 if index(ss, "&start-rule-call-param&") > 0 then do:
     1855                   run rule-call-param in this-procedure (  buffer buf_rule ).
     1856                 end.
     1857                 if index(ss, "&start-def-vars&") > 0 then do:
     1858                   run process-def-vars in this-procedure (  input buf_rule.rule_id ) no-error.
     1859                   if error-status:error then do:
     1860                     undo, return error .
     1861                   end.
     1862                 end.
     1863                 if index(ss, "&end-def-vars&") > 0 then do:
     1864                   run clear-def-vars in this-procedure (  input buf_rule.rule_id ) no-error.
     1865                   if error-status:error then do:
     1866                     undo, return error .
     1867                   end.
     1868                 end.
     1869                 if index(ss, "&start-release-obj&") > 0 then do:
     1870                   run process-release-obj in this-procedure (  input buf_rule.rule_id ) no-error.
     1871                   if error-status:error then do:
     1872                     undo, return error .
     1873                   end.
     1874                 end.
     1875                 if index(ss, "&start-process-rule-call-param&") > 0 then do:
     1876                   run process-rule-call-param in this-procedure ( buffer buf_rule ).
     1877                 end.
     1878                 if index(ss, "&start-rule&") > 0 then do:
     1879                   if buf_rule.hidden-content > 0 then do:
     1880                     run temp-string_write in this-procedure ( input  substitute("  &1 rul/&2.i &3 "
     1881                                                             , "~{"
     1882                                                             , string(buf_rule.rule_id, "999999999")
     1883                                                             , "~}"
     1884                                                             )).
     1885                   end.
     1886                   else do:
     1887                     run display-rule in this-procedure ( input buf_rule-by-profile.rule_id
     1888                                                       , input 0
     1889                                                       , input "ABL":U
     1890                                                       , input-output v-level).
     1891                   end.
     1892                 end.
     1893               end.
     1894               input stream instream2 close.
     1895             end.
     1896           end.
     1897           v-include-flag = no.
     1898           os-delete value(v-rp-file-name).
     1899         end.
     1900       end.
     1901       if index(ss, "&end-rule-block&") > 0 then do:
     1902       end.
     1903       if v-include-flag = yes then do:
     1904         put stream outstream2 unformatted
     1905         ss skip.
     1906       end.
     1907       if index(ss, "&order-list_") > 0 then do:
     1908         assign
     1909         v-key-ruleset = entry(2, ss, "&")
     1910         v-codex-id = 0
     1911         v-ruleset-id = 0
     1912         .
     1913         _ruleset:
     1914         for each buf_ruleset no-lock:
     1915           assign
     1916           v-key-ruleset-2 = substitute("order-list_codex_id=&1;ruleset_id=&2"
     1917                                         , buf_ruleset.codex_id
     1918                                         , buf_ruleset.ruleset_id).
     1919           if v-key-ruleset-2 = v-key-ruleset then do:
     1920             assign
     1921             v-codex-id = buf_ruleset.codex_id
     1922             v-ruleset-id = buf_ruleset.ruleset_id
     1923             .
     1924             leave _ruleset.
     1925           end.
     1926         end.
     1927         define variable v-order-list as character no-undo .
     1928         v-order-list = '':U.
     1929         for each buf_rule-by-profile no-lock where
     1930                 buf_rule-by-profile.profile_id = p-profile-id
     1931             and buf_rule-by-profile.codex_id = v-codex-id
     1932             and buf_rule-by-profile.ruleset_id = v-ruleset-id
     1933         break
     1934         by buf_rule-by-profile.profile_id
     1935         by buf_rule-by-profile.codex_id
     1936         by buf_rule-by-profile.ruleset_id
     1937         by buf_rule-by-profile.rp_order_id:
     1938           assign
     1939           v-order-list = v-order-list +
     1940                         (if v-order-list = '':U
     1941                          then "":u
     1942                          else chr(44)) +
     1943                          substitute("r_&1_&2_&3"
     1944                                   , v-codex-id
     1945                                   , v-ruleset-id
     1946                                   , buf_rule-by-profile.rule_id
     1947                                   ).
     1948         end.
     1949         run temp-string_write in this-procedure ( input substitute('v_&1_&2_order = "&3".'
     1950                                                                     , v-codex-id
     1951                                                                     , v-ruleset-id
     1952                                                                     , v-order-list
     1953                                                                     )).
     1954       end.
     1955     end.
     1956     input stream instream close.
     1957     output stream outstream to value( substitute( "rul/rp-&1.p" , buf_rule-profile.profile_id)).
     1958     for each buf_temp-string
     1959     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1960     :
     1961       put stream outstream unformatted buf_temp-string.v-string chr(10).
     1962     end.
     1963     output stream outstream close.
     1964     define variable v-old-sys-alert-box as logical no-undo .
     1965     define variable v-err-num as integer no-undo .
     1966     define variable v-err-size as integer no-undo .
     1967     define variable v-tmp-str as character no-undo .
     1968     define variable v-err-cmp as character no-undo .
     1969     v-old-sys-alert-box    = session :system-alert-boxes.
     1970     session :system-alert-boxes = false.
     1971     output to value( "cmp-err.txt":U) .
     1972     COMPILE value( substitute( "rul/rp-&1.p", buf_rule-profile.profile_id)).
     1973     assign
     1974       v-err-num  = error-status :GET-NUMBER(1)
     1975       v-err-size = seek(output)
     1976     .
     1977     output close .
     1978     assign
     1979       session :system-alert-boxes = v-old-sys-alert-box
     1980     .
     1981     if error-status :error
     1982       or compiler :error
     1983     then do:
     1984       input stream errstream from value( "cmp-err.txt":U).
     1985       repeat :
     1986         import stream errstream unformatted v-tmp-str .
     1987         assign
     1988           v-err-cmp = v-err-cmp + chr(10) + v-tmp-str
     1989         .
     1990       end.
     1991       input stream errstream close.
     1992         message
     1993           vss-workfile vss-revision vss-description skip
     1994           substitute( "Ошибка компиляции файла &1 строка &2", COMPILER:FILENAME, COMPILER:ERROR-ROW ) skip
     1995           v-err-cmp skip
     1996           error-status :get-message(1) skip
     1997           view-as alert-box error .
     1998         return error.
     1999      end.
     2000   end.
     2001   procedure cycle-script-type:
     2002   define input parameter p-profile-id as integer no-undo .
     2003   define input parameter p-i-script-type as character no-undo .
     2004   define buffer buf_rule-by-profile for ub.rule-by-profile.
     2005   define buffer buf_rule-i-script for ub.rule-i-script.
     2006   define buffer buf_dis-porp-script for ub.prop-script.
     2007     main-block:
     2008     do
     2009     on error undo, return error
     2010     :
     2011       _rule-i-script:
     2012       for each buf_rule-by-profile where
     2013               buf_rule-by-profile.profile_id = p-profile-id,
     2014           first buf_rule no-lock where
     2015                 buf_rule.rule_id = buf_rule-by-profile.rule_id,
     2016           each buf_rule-i-script no-lock where
     2017               buf_rule-i-script.root_rule_id = buf_rule.rule_id
     2018           and buf_rule-i-script.i-script-type = p-i-script-type
     2019               ,
     2020           each  buf_prop-script no-lock where
     2021                     buf_prop-script.dtm-code = buf_rule-i-script.dtm-code
     2022                 and  buf_prop-script.script-name = buf_rule-i-script.script-name
     2023                 and  buf_prop-script.script-type = buf_rule-i-script.script-type
     2024                 and  buf_prop-script.revis_id = buf_rule-i-script.revis_id
     2025       break
     2026       by buf_prop-script.script-name
     2027       on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2028       :
     2029         if first-of(buf_prop-script.script-name) then do:
     2030           if not (buf_prop-script.language = "ABL") then next _rule-i-script.
     2031           if buf_rule-i-script.i-script-type = 'variable':U then do:
     2032             run temp-string_write in this-procedure ( input substitute("define variable &1 as &2 no-undo."
     2033                                                                       ,buf_rule-i-script.i-script-name
     2034                                                                       ,buf_prop-script.script-value-type)
     2035                                                     ).
     2036           end.
     2037           else do:
     2038             run display-prop-script in this-procedure ( buffer buf_prop-script).
     2039           end.
     2040         end.
     2041       end.
     2042     end.
     2043   end procedure.
     2044   procedure rule-call-param :
     2045   define parameter buffer buf_rule for ub.rule.
     2046   define variable v-uniq-key-rec as character no-undo .
     2047   define buffer buf_ruledict-param  for ub.ruledict-param.
     2048   define buffer buf_ruledict for ub.ruledict.
     2049   define variable v-string as character no-undo .
     2050   _main:
     2051   do
     2052   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2053   :
     2054     run gen-key-rec in this-procedure (
     2055                                        input  'rule':U
     2056                                       ,input buffer buf_rule:handle
     2057                                       ,output v-uniq-key-rec ).
     2058     find first buf_ruledict no-lock where
     2059              buf_ruledict.entry-type = 'rule':U
     2060          AND buf_ruledict.uniq-key-rec = v-uniq-key-rec
     2061          AND buf_ruledict.language = "ABL"       .
     2062     for each buf_ruledict-param no-lock where
     2063             buf_ruledict-param.entry-id = buf_ruledict.entry-id
     2064         and buf_ruledict-param.language = "ABL":U
     2065     by buf_ruledict-param.param-num
     2066     on error undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)):
     2067       CASE buf_ruledict-param.param-mode:
     2068         when 'input':U then do:
     2069           assign
     2070           v-string = substitute(" define variable &1 as &2 no-undo."
     2071                                   ,buf_ruledict-param.param-name
     2072                                   ,buf_ruledict-param.param-data-type
     2073                                   ).
     2074         end.
     2075         when 'output':U then do:
     2076         end.
     2077         when 'input-output':U then do:
     2078         end.
     2079         when 'buffer':U then do:
     2080         end.
     2081         when 'input table':U then do:
     2082         end.
     2083         when 'output table':U then do:
     2084         end.
     2085         when 'input-output table':U then do:
     2086         end.
     2087       end case.
     2088       run temp-string_write in this-procedure ( input v-string ).
     2089     end.
     2090   end.
     2091   end procedure.
     2092   procedure using-class :
     2093   define parameter buffer buf_rule-profile for ub.rule-profile.
     2094   main-block:
     2095   do
     2096   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2097   :
     2098   define buffer buf_rule for ub.rule.
     2099   define buffer buf_rule-by-profile for ub.rule-by-profile.
     2100   define buffer buf_temp-rule-i-script for temp-rule-i-script.
     2101   define buffer buf_rule-i-script for ub.rule-i-script.
     2102   define buffer buf_prop-script for ub.prop-script.
     2103   define buffer buf0_prop-script for ub.prop-script.
     2104     _rule-i-script:
     2105     for each buf_rule-by-profile where
     2106             buf_rule-by-profile.profile_id = buf_rule-profile.profile_id,
     2107        each buf_rule no-lock where
     2108             buf_rule.rule_id = buf_rule-by-profile.rule_id,
     2109        each buf_rule-i-script no-lock where
     2110               buf_rule-i-script.root_rule_id = buf_rule.rule_id
     2111     break
     2112     by buf_rule-by-profile.rule_id
     2113     by buf_rule-i-script.script-name
     2114     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2115     :
     2116       if first-of(buf_rule-i-script.script-name) then do:
     2117         if buf_rule-i-script.script-type = '':U then next _rule-i-script.
     2118         if buf_rule-i-script.i-script-type = 'variable':U then do:
     2119           if lookup(buf_rule-i-script.script-type, 'character,date,datetime,datetime-tz,decimal,integer,void,logical,memptr,raw,recid,rowid,widget-handle,handle,blob,clob,class,com-handle,longchar,int64':U) > 0 then next.
     2120           find last  buf_prop-script no-lock where
     2121                     buf_prop-script.dtm-code = buf_rule-i-script.dtm-code
     2122                 and  buf_prop-script.script-name = buf_rule-i-script.script-type
     2123                 and  buf_prop-script.language = "ABL"  no-error.
     2124           if not available buf_prop-script then do:
     2125             message
     2126             substitute( "Секция &&start-using-class&&&2" +
     2127                         "Не найден класс &1&2" +
     2128                         "Переменная &3&2" +
     2129                         "Код объекта-операнда &4&2" +
     2130                         "Код класса &5&2"
     2131                       , buf_rule-i-script.script-type
     2132                       , chr(10)
     2133                       , buf_rule-i-script.script-name
     2134                       , buf_rule-i-script.dtm-code
     2135                       , buf_rule-i-script.class-dtm-code
     2136                       )
     2137             view-as alert-box .
     2138             return error.
     2139           end.
     2140         end.
     2141         else do:
     2142           find first buf0_prop-script no-lock where
     2143                     buf0_prop-script.dtm-code = buf_rule-i-script.dtm-code
     2144                 and buf0_prop-script.script-name = buf_rule-i-script.script-name
     2145                 and buf0_prop-script.language = "ABL" no-error .
     2146           if not available buf0_prop-script then do:
     2147             message
     2148             substitute("Секция &&start-using-class&&&1" +
     2149                       "Не найдено определение скрипта &1" +
     2150                         "Тип Скрипта &2&1" +
     2151                         "Скрипт &3&1" +
     2152                         "Ссылка на определение &4&1" +
     2153                         "Код объекта-операнда &5&1" +
     2154                         "Код класса &6&1"
     2155                       , chr(10)
     2156                       , buf_rule-i-script.script-type
     2157                       , buf_rule-i-script.i-script-name
     2158                       , buf_rule-i-script.script-name
     2159                       , buf_rule-i-script.dtm-code
     2160                       , buf_rule-i-script.class-dtm-code
     2161                       )
     2162             view-as alert-box .
     2163             return error.
     2164           END.
     2165           if lookup(buf0_prop-script.proc-type, 'class,data-member,property,method,constructor,destructor':u) = 0  then next _rule-i-script.
     2166           find last  buf_prop-script no-lock where
     2167                     buf_prop-script.dtm-code = buf_rule-i-script.class-dtm-code
     2168                 and buf_prop-script.script-name = buf_rule-i-script.script-type
     2169                 and  buf_prop-script.proc-type = 'class':U
     2170                 and  buf_prop-script.language = "ABL"  no-error.
     2171           if not available buf_prop-script then do:
     2172             message
     2173             substitute("Секция &&start-using-class&&&1" +
     2174                         "Не найден класс &2&1" +
     2175                         "Тип Скрипта &2&1" +
     2176                         "Скрипт &3&1" +
     2177                         "Ссылка на определение &4&1" +
     2178                         "Код объекта-операнда &5&1" +
     2179                         "Код класса &6"
     2180                       , chr(10)
     2181                       , buf_rule-i-script.script-type
     2182                       , buf_rule-i-script.i-script-name
     2183                       , buf_rule-i-script.script-name
     2184                       , buf_rule-i-script.dtm-code
     2185                       , buf_rule-i-script.class-dtm-code
     2186                       )
     2187             view-as alert-box .
     2188             return error.
     2189           end.
     2190         end.
     2191         find first buf_temp-rule-i-script no-lock where
     2192                   buf_temp-rule-i-script.root_rule_id = buf_rule.rule_id
     2193               and buf_temp-rule-i-script.i-script-name = buf_prop-script.script-body no-error.
     2194         if available buf_temp-rule-i-script then next.
     2195         create buf_temp-rule-i-script.
     2196         assign
     2197         buf_temp-rule-i-script.root_rule_id  = buf_rule.rule_id
     2198         buf_temp-rule-i-script.i-script-type = 'class':U
     2199         buf_temp-rule-i-script.i-script-name = buf_prop-script.script-body
     2200         .
     2201         run temp-string_write in this-procedure ( input buf_prop-script.script-body ).
     2202       end.
     2203     end.
     2204   end.
     2205   end procedure.
     2206   procedure hist-news-class :
     2207   define parameter buffer buf_rule-profile for ub.rule-profile.
     2208   main-block:
     2209   do
     2210   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2211   :
     2212   define variable v-revis-id as integer no-undo .
     2213   define variable v-script-name as character no-undo .
     2214   define buffer buf_rule-by-profile for ub.rule-profile.
     2215   define buffer buf_temp-rule-i-script for temp-rule-i-script.
     2216   define buffer buf_rule-i-script for ub.rule-i-script.
     2217   define buffer buf_prop-script for ub.prop-script.
     2218   define buffer buf0_prop-script for ub.prop-script.
     2219     _rule-i-script:
     2220     for each buf_rule-by-profile where
     2221             buf_rule-profile.profile_id = p-profile-id,
     2222         first buf_rule no-lock where
     2223               buf_rule.rule_id = buf_rule-by-profile.profile_id,
     2224         each buf_rule-i-script no-lock where
     2225               buf_rule-i-script.root_rule_id = buf_rule.rule_id
     2226     break
     2227     by buf_rule-i-script.script-name
     2228     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2229     :
     2230       if buf_rule-i-script.i-script-type = 'variable':U
     2231       or buf_rule-i-script.i-script-type = 'get':U
     2232       or buf_rule-i-script.i-script-type = 'find':U
     2233       or buf_rule-i-script.i-script-type = 'define_b':U
     2234       or buf_rule-i-script.i-script-type = 'define_tt':U
     2235       or buf_rule-i-script.i-script-type = 'define_h':U
     2236       or buf_rule-i-script.script-type = '':U
     2237       then next _rule-i-script.
     2238       find first buf0_prop-script no-lock where
     2239                 buf0_prop-script.dtm-code = buf_rule-i-script.dtm-code
     2240             and buf0_prop-script.script-name = buf_rule-i-script.script-name
     2241             and buf0_prop-script.language = "ABL"
     2242             and buf0_prop-script.revis_id = buf_rule-i-script.revis_id no-error .
     2243       if not available buf0_prop-script then do:
     2244         message
     2245         substitute("Секция &&start-hn-option&&&1" +
     2246                     "Не найдено определение скрипта &1" +
     2247                     "Тип Скрипта &2&1" +
     2248                     "Скрипт &3&1" +
     2249                     "Ссылка на определение &4&1" +
     2250                     "Код объекта-операнда &5&1" +
     2251                     "Код класса &6&1" +
     2252                     "Версия &7"
     2253                   , chr(10)
     2254                     , buf_rule-i-script.script-type
     2255                     , buf_rule-i-script.i-script-name
     2256                     , buf_rule-i-script.script-name
     2257                     , buf_rule-i-script.dtm-code
     2258                     , buf_rule-i-script.class-dtm-code
     2259                     , buf_rule-i-script.revis_id
     2260                     )
     2261         view-as alert-box .
     2262         return error.
     2263       END.
     2264       v-revis-id = -1.
     2265       v-script-name = '':U.
     2266       if lookup(buf0_prop-script.proc-type, 'class,data-member,property,method,constructor,destructor':u) = 0  then next _rule-i-script.
     2267       for each buf_prop-script no-lock where
     2268                 buf_prop-script.class-dtm-code = buf_rule-i-script.class-dtm-code
     2269             and buf_prop-script.dtm-code = buf_rule-i-script.dtm-code
     2270             and  buf_prop-script.script-type = 'ifunction':U
     2271             and  buf_prop-script.language = "ABL"
     2272       by buf_prop-script.script-name
     2273       by buf_prop-script.revis_id:
     2274         if not (index(buf_prop-script.script-name, "~{&hist-nws_") > 0
     2275                 and  buf_prop-script.script-head = buf_rule-i-script.script-type )
     2276         and not buf_prop-script.script-name begins(buf_rule-i-script.script-type + "~{&hist-nws_")
     2277                 then next.
     2278         if buf_prop-script.revis_id > v-revis-id then do:
     2279           v-revis-id = buf_prop-script.revis_id.
     2280           v-script-name = buf_prop-script.script-name.
     2281         end.
     2282       end.
     2283       find first buf_prop-script no-lock where
     2284                 buf_prop-script.dtm-code = buf_rule-i-script.dtm-code
     2285             and buf_prop-script.class-dtm-code = buf_rule-i-script.class-dtm-code
     2286             and buf_prop-script.language = "ABL"
     2287             and buf_prop-script.script-type = 'ifunction':U
     2288             and buf_prop-script.script-name = v-script-name
     2289             and buf_prop-script.revis_id = v-revis-id no-error .
     2290       if not available buf_prop-script then do:
     2291         message
     2292         substitute("Секция &&start-hn-option&&&2" +
     2293                     "Не найдена процедура обработки истории и маршрутизации для класса &1&2(&6)&2" +
     2294                     "Скрипт &3&2" +
     2295                     "Код объекта-операнда &4&2" +
     2296                     "Код класса &5"
     2297                     , buf_rule-i-script.script-type
     2298                     , chr(10)
     2299                     , buf_rule-i-script.i-script-name
     2300                     , buf_rule-i-script.dtm-code
     2301                     , buf_rule-i-script.class-dtm-code
     2302                     , v-script-name
     2303                     )
     2304         view-as alert-box .
     2305         return error.
     2306       end.
     2307       find first buf_temp-rule-i-script no-lock where
     2308                 buf_temp-rule-i-script.root_rule_id = buf_rule.rule_id
     2309             and buf_temp-rule-i-script.i-script-name = buf_prop-script.script-name
     2310             and buf_temp-rule-i-script.i-script-type = "hist-news"
     2311             no-error.
     2312       if available buf_temp-rule-i-script then next.
     2313       create buf_temp-rule-i-script.
     2314       assign
     2315       buf_temp-rule-i-script.root_rule_id  = buf_rule.rule_id
     2316       buf_temp-rule-i-script.i-script-type = "hist-news"
     2317       buf_temp-rule-i-script.i-script-name = buf_prop-script.script-name
     2318       .
     2319       run temp-string_write in this-procedure ( input buf_prop-script.script-body ).
     2320     end.
     2321   end.
     2322   end procedure.
     2323   procedure process-rule-call-param :
     2324   define parameter buffer buf_rule for ub.rule.
     2325   define variable v-uniq-key-rec as character no-undo .
     2326   define variable v-string as character no-undo .
     2327   define buffer buf_ruledict-param  for ub.ruledict-param.
     2328   define buffer buf_ruledict for ub.ruledict.
     2329   _main:
     2330   do
     2331   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2332   :
     2333     run gen-key-rec in this-procedure (
     2334                                        input  'rule':U
     2335                                       ,input buffer buf_rule:handle
     2336                                       ,output v-uniq-key-rec ).
     2337     find first buf_ruledict no-lock where
     2338              buf_ruledict.entry-type = 'rule':U
     2339          AND buf_ruledict.uniq-key-rec = v-uniq-key-rec
     2340          AND buf_ruledict.language = "ABL"
     2341          .
     2342     for each buf_ruledict-param no-lock where
     2343             buf_ruledict-param.entry-id = buf_ruledict.entry-id
     2344         and buf_ruledict-param.language = "ABL":U
     2345     by buf_ruledict-param.param-num
     2346     on error undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)):
     2347       CASE buf_ruledict-param.param-mode:
     2348         when 'input':U then do:
     2349           if
     2350           lookup("LIST", buf_ruledict-param.param-3-data-type) > 0
     2351           or
     2352           lookup("SORTED-LIST", buf_ruledict-param.param-3-data-type) > 0
     2353           then do:
     2354           end.
     2355           else do:
     2356             assign
     2357             v-string = substitute(" find first buf_temp-rule-call-param no-lock where&1" +
     2358                                               "buf_temp-rule-call-param.codex_id = v-codex-id&1" +
     2359                                           "and buf_temp-rule-call-param.ruleset_id = v-ruleset-id&1" +
     2360                                           "and buf_temp-rule-call-param.call_id = p-call-id&1" +
     2361                                           "and buf_temp-rule-call-param.order_id = p-order-id&1" +
     2362                                           "and buf_temp-rule-call-param.rule_id = p-rule-id&1" +
     2363                                           'and buf_temp-rule-call-param.param-name = "&2"&1 no-error.&1' +
     2364                                           "if available buf_temp-rule-call-param then do:&1" +
     2365                                           "assign &2 = buf_temp-rule-call-param.param-value-&3.&1" +
     2366                                           "end.&1"
     2367                                     , chr(10)
     2368                                     , buf_ruledict-param.param-name
     2369                                     , buf_ruledict-param.param-data-type).
     2370           end.
     2371         end.
     2372         when 'output':U then do:
     2373         end.
     2374         when 'input-output':U then do:
     2375         end.
     2376         when 'buffer':U then do:
     2377         end.
     2378         when 'input table':U then do:
     2379         end.
     2380         when 'output table':U then do:
     2381         end.
     2382         when 'input-output table':U then do:
     2383         end.
     2384       end case.
     2385       run temp-string_write in this-procedure ( input v-string ).
     2386     end.
     2387   end.
     2388   end procedure.
     2389   procedure process-release-obj :
     2390   define input parameter p-rule-id as integer no-undo .
     2391   define variable v-revis-id as integer no-undo .
     2392   define variable v-script-name as character no-undo .
     2393   define variable v-release-name as character no-undo .
     2394   define variable v-retry-action as integer no-undo .
     2395   define buffer buf_rule-i-script for ub.rule-i-script.
     2396   define buffer buf_prop-script for ub.prop-script.
     2397   define buffer buf2_prop-script for ub.prop-script.
     2398   define buffer buf_pscript-ruleset for ub.pscript-ruleset.
     2399   define buffer buf_temp-rule-i-script for temp-rule-i-script.
     2400   define buffer buf_rule-script for ub.rule-script.
     2401   define buffer buf_tt-rule-script for tt-rule-script.
     2402   main-block:
     2403   do
     2404   on error undo, return error
     2405   :
     2406     _rule-script:
     2407     for each buf_tt-rule-script,
     2408         each  buf_rule-i-script no-lock where
     2409               buf_rule-i-script.root_rule_id = p-rule-id
     2410          and  buf_rule-i-script.i-script-type = 'variable':U
     2411          and buf_rule-i-script.script_id = buf_tt-rule-script.script_id
     2412     by buf_tt-rule-script.gen-order
     2413     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2414     :
     2415       find first buf_rule-script where
     2416                 buf_rule-script.root_rule_id = p-rule-id
     2417             and  buf_rule-script.script_id = buf_rule-i-script.script_id.
     2418       if lookup(buf_rule-i-script.script-type, 'character,date,datetime,datetime-tz,decimal,integer,void,logical,memptr,raw,recid,rowid,widget-handle,handle,blob,clob,class,com-handle,longchar,int64':U) = 0 then do:
     2419         assign
     2420         v-revis-id = -1
     2421         v-script-name = '':U
     2422         .
     2423         for each buf_pscript-ruleset no-lock where
     2424                 buf_pscript-ruleset.codex_id = buf_rule.codex_id
     2425             and buf_pscript-ruleset.dtm-code = buf_rule-i-script.dtm-code
     2426             and buf_pscript-ruleset.script-name begins (buf_rule-i-script.script-type + "~{&release_")
     2427             and buf_pscript-ruleset.language = "ABL",
     2428             first  buf_prop-script no-lock where
     2429                   buf_prop-script.dtm-code = buf_rule-i-script.dtm-code
     2430               and buf_prop-script.class-dtm-code = buf_rule-i-script.class-dtm-code
     2431               and buf_prop-script.language = "ABL"
     2432               and buf_prop-script.proc-type = 'method':U
     2433               and buf_prop-script.script-name = buf_pscript-ruleset.script-name
     2434               and buf_prop-script.revis_id = buf_pscript-ruleset.revis_id
     2435         by buf_pscript-ruleset.script-name
     2436         by buf_pscript-ruleset.revis_id :
     2437           if buf_prop-script.revis_id > v-revis-id then do:
     2438             v-revis-id = buf_prop-script.revis_id.
     2439             v-script-name = buf_prop-script.script-name.
     2440           end.
     2441         end.
     2442         find first buf_prop-script no-lock where
     2443                   buf_prop-script.dtm-code = buf_rule-i-script.dtm-code
     2444               and buf_prop-script.class-dtm-code = buf_rule-i-script.class-dtm-code
     2445               and buf_prop-script.language = "ABL"
     2446               and buf_prop-script.proc-type = 'method':U
     2447               and buf_prop-script.script-name = v-script-name
     2448               and buf_prop-script.revis_id = v-revis-id no-error .
     2449         if not available buf_prop-script then do:
     2450           message
     2451           substitute("Секция &&start-release-obj&&&3" +
     2452                       "Не найден метод освобождения переменной &1 для класса &2&3" +
     2453                       "Код объекта-операнда &4&3" +
     2454                       "Код класса &5"
     2455                     , v-script-name
     2456                       , buf_rule-i-script.script-type
     2457                       , chr(10)
     2458                       , buf_rule-i-script.dtm-code
     2459                       , buf_rule-i-script.class-dtm-code
     2460                       )
     2461           view-as alert-box error .
     2462           undo, return error .
     2463         end.
     2464         if buf_rule-i-script.dtm-code <> buf_rule-i-script.class-dtm-code then do:
     2465           find first buf2_prop-script no-lock where
     2466                     buf2_prop-script.dtm-code = buf_rule-i-script.dtm-code
     2467                 and buf2_prop-script.class-dtm-code = buf_rule-i-script.class-dtm-code
     2468                 and buf2_prop-script.language = "ABL"
     2469                 and buf2_prop-script.proc-type = 'class':U
     2470                 and buf2_prop-script.script-name = buf_rule-i-script.script-type
     2471                 and buf2_prop-script.revis_id = v-revis-id no-error .
     2472           if not available buf2_prop-script then do:
     2473             message
     2474             substitute("Секция &&start-release-obj&&&2" +
     2475                         "Не найден класс &1&2" +
     2476                         "Код объекта-операнда &3&2" +
     2477                         "Код класса &4"
     2478                       ,buf_rule-i-script.script-type
     2479                       ,chr(10)
     2480                       ,buf_rule-i-script.dtm-code
     2481                       ,buf_rule-i-script.class-dtm-code
     2482                       )
     2483             view-as alert-box error .
     2484             undo, return error .
     2485           end.
     2486           v-release-name =  replace(buf_prop-script.script-name
     2487                                         ,buf2_prop-script.script-name
     2488                                         ,buf2_prop-script.script-head).
     2489         end.
     2490         else do:
     2491           v-release-name =  buf_prop-script.script-name.
     2492         end.
     2493         find first buf_temp-rule-i-script no-lock where
     2494                   buf_temp-rule-i-script.root_rule_id = p-rule-id
     2495               and buf_temp-rule-i-script.script_id = buf_tt-rule-script.script_id
     2496               and buf_temp-rule-i-script.i-script-name = v-release-name no-error.
     2497         if available buf_temp-rule-i-script then next _rule-script.
     2498         create buf_temp-rule-i-script.
     2499         assign
     2500         buf_temp-rule-i-script.root_rule_id  = p-rule-id
     2501         buf_temp-rule-i-script.script_id     = buf_tt-rule-script.script_id
     2502         buf_temp-rule-i-script.i-script-type = 'method':U
     2503         buf_temp-rule-i-script.i-script-name = v-release-name
     2504         buf_temp-rule-i-script.script-name = "release"
     2505         .
     2506         if v-count-retry-action = yes then do:
     2507           v-retry-action = v-retry-action + 1.
     2508           run temp-string_write in this-procedure ( input  substitute("if v-retry-action < &1 then do:"
     2509                                                                       ,v-retry-action
     2510                                                                       )).
     2511         end.
     2512         run temp-string_write in this-procedure ( input  substitute("&1"
     2513                                                                     ,buf_prop-script.script-foot
     2514                                                                     )).
     2515         run temp-string_write in this-procedure ( input  substitute("&1:&2 ."
     2516                                                                     ,buf_rule-i-script.script-name
     2517                                                                     ,v-release-name
     2518                                                                     )).
     2519         if v-count-retry-action = yes then do:
     2520           run temp-string_write in this-procedure ( input  substitute("end."
     2521                                                                       )).
     2522         end.
     2523       end.
     2524     end.
     2525     for each buf_temp-rule-i-script where
     2526             buf_temp-rule-i-script.script-name = "release":
     2527       delete buf_temp-rule-i-script.
     2528     end.
     2529   end.
     2530   end procedure.
     2531   procedure process-def-vars :
     2532   define input parameter p-rule-id as integer no-undo .
     2533   define variable v-revis-id as integer no-undo .
     2534   define variable v-script-name as character no-undo .
     2535   define variable v-constructor-name as character no-undo .
     2536   define buffer buf_rule-i-script for ub.rule-i-script.
     2537   define buffer buf_prop-script for ub.prop-script.
     2538   define buffer buf2_prop-script for ub.prop-script.
     2539   define buffer buf_pscript-ruleset for ub.pscript-ruleset.
     2540   define buffer buf_temp-rule-i-script for temp-rule-i-script.
     2541   define buffer buf_rule-script for ub.rule-script.
     2542   main-block:
     2543   do
     2544   on error undo, return error
     2545   :
     2546     for each buf_rule-i-script no-lock where
     2547               buf_rule-i-script.root_rule_id = p-rule-id
     2548          and  buf_rule-i-script.i-script-type = 'variable':U
     2549     break
     2550     by buf_rule-i-script.i-script-name
     2551     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2552     :
     2553       if first-of(buf_rule-i-script.i-script-name) then do:
     2554         find first buf_temp-rule-i-script no-lock where
     2555                   buf_temp-rule-i-script.root_rule_id = p-rule-id
     2556               and buf_temp-rule-i-script.i-script-name = buf_rule-i-script.script-name no-error.
     2557         if available buf_temp-rule-i-script then next.
     2558         create buf_temp-rule-i-script.
     2559         assign
     2560         buf_temp-rule-i-script.root_rule_id  = p-rule-id
     2561         buf_temp-rule-i-script.i-script-type = 'variable':U
     2562         buf_temp-rule-i-script.i-script-name = buf_rule-i-script.script-name
     2563         .
     2564         find first buf_rule-script where
     2565                   buf_rule-script.root_rule_id = p-rule-id
     2566              and  buf_rule-script.script_id = buf_rule-i-script.script_id.
     2567         run temp-string_write in this-procedure ( input  substitute("&1 ."
     2568                                                                     ,buf_rule-script.script)).
     2569         if lookup(buf_rule-i-script.script-type, 'character,date,datetime,datetime-tz,decimal,integer,void,logical,memptr,raw,recid,rowid,widget-handle,handle,blob,clob,class,com-handle,longchar,int64':U) = 0 then do:
     2570           assign
     2571           v-revis-id = -1
     2572           v-script-name = '':U
     2573           .
     2574           for each buf_pscript-ruleset no-lock where
     2575                   buf_pscript-ruleset.codex_id = buf_rule.codex_id
     2576               and buf_pscript-ruleset.dtm-code = buf_rule-i-script.dtm-code
     2577               and buf_pscript-ruleset.script-name begins (buf_rule-i-script.script-type + "~{&constructor_")
     2578               and buf_pscript-ruleset.language = "ABL",
     2579              first  buf_prop-script no-lock where
     2580                     buf_prop-script.dtm-code = buf_rule-i-script.dtm-code
     2581                 and buf_prop-script.class-dtm-code = buf_rule-i-script.class-dtm-code
     2582                 and buf_prop-script.language = "ABL"
     2583                 and buf_prop-script.proc-type = 'constructor':U
     2584                 and buf_prop-script.script-name = buf_pscript-ruleset.script-name
     2585                 and buf_prop-script.revis_id = buf_pscript-ruleset.revis_id
     2586          by buf_prop-script.script-name
     2587          by buf_prop-script.revis_id :
     2588             if buf_prop-script.revis_id > v-revis-id then do:
     2589               v-revis-id = buf_prop-script.revis_id.
     2590               v-script-name = buf_prop-script.script-name.
     2591             end.
     2592           end.
     2593           find first buf_prop-script no-lock where
     2594                     buf_prop-script.dtm-code = buf_rule-i-script.dtm-code
     2595                 and buf_prop-script.class-dtm-code = buf_rule-i-script.class-dtm-code
     2596                 and buf_prop-script.language = "ABL"
     2597                 and buf_prop-script.proc-type = 'constructor':U
     2598                 and buf_prop-script.script-name = v-script-name
     2599                 and buf_prop-script.revis_id = v-revis-id no-error .
     2600           if not available buf_prop-script then do:
     2601             message
     2602             substitute("Секция &&start-def-vars&&&3" +
     2603                         "Не найден конструктор &1 для класса &2&3" +
     2604                         "Код объекта-операнда &4&3" +
     2605                         "Код класса &5"
     2606                        ,v-script-name
     2607                        ,buf_rule-i-script.script-type
     2608                        ,chr(10)
     2609                        ,buf_rule-i-script.dtm-code
     2610                        ,buf_rule-i-script.class-dtm-code
     2611                        )
     2612             view-as alert-box error .
     2613             undo, return error .
     2614           end.
     2615           if buf_rule-i-script.dtm-code <> buf_rule-i-script.class-dtm-code then do:
     2616             find first buf2_prop-script no-lock where
     2617                       buf2_prop-script.dtm-code = buf_rule-i-script.dtm-code
     2618                   and buf2_prop-script.class-dtm-code = buf_rule-i-script.class-dtm-code
     2619                   and buf2_prop-script.language = "ABL"
     2620                   and buf2_prop-script.proc-type = 'class':U
     2621                   and buf2_prop-script.script-name = buf_rule-i-script.script-type
     2622                   and buf2_prop-script.revis_id = v-revis-id no-error .
     2623             if not available buf2_prop-script then do:
     2624               message
     2625               substitute("Секция &&start-def-vars&&&2" +
     2626                           "Не найден класс &1&2" +
     2627                           "Код объекта-операнда &3&2" +
     2628                           "Код класса &4"
     2629                         ,buf_rule-i-script.script-type
     2630                         ,chr(10)
     2631                         ,buf_rule-i-script.dtm-code
     2632                         ,buf_rule-i-script.class-dtm-code
     2633                         )
     2634               view-as alert-box error .
     2635               undo, return error .
     2636             end.
     2637             v-constructor-name =  replace(buf_prop-script.script-name
     2638                                           ,buf2_prop-script.script-name
     2639                                           ,buf2_prop-script.script-head).
     2640           end.
     2641           else do:
     2642             v-constructor-name =  buf_prop-script.script-name.
     2643           end.
     2644           run temp-string_write in this-procedure ( input  substitute("&1"
     2645                                                                       ,buf_prop-script.script-foot
     2646                                                                       )).
     2647           run temp-string_write in this-procedure ( input  substitute("&1 = new &2 ."
     2648                                                                       ,buf_rule-i-script.script-name
     2649                                                                       ,v-constructor-name
     2650                                                                       )).
     2651         end.
     2652       end.
     2653     end.
     2654   end.
     2655   end procedure.
     2656   procedure clear-def-vars :
     2657   define input parameter p-rule-id as integer no-undo .
     2658   define variable v-revis-id as integer no-undo .
     2659   define variable v-script-name as character no-undo .
     2660   define variable v-constructor-name as character no-undo .
     2661   define buffer buf_rule-i-script for ub.rule-i-script.
     2662   define buffer buf_prop-script for ub.prop-script.
     2663   define buffer buf2_prop-script for ub.prop-script.
     2664   define buffer buf_pscript-ruleset for ub.pscript-ruleset.
     2665   define buffer buf_temp-rule-i-script for temp-rule-i-script.
     2666   define buffer buf_rule-script for ub.rule-script.
     2667   main-block:
     2668   do
     2669   on error undo, return error
     2670   :
     2671     for each buf_rule-i-script no-lock where
     2672               buf_rule-i-script.root_rule_id = p-rule-id
     2673          and  buf_rule-i-script.i-script-type = 'variable':U
     2674     break
     2675     by buf_rule-i-script.i-script-name
     2676     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2677     :
     2678       if first-of(buf_rule-i-script.i-script-name) then do:
     2679         find first buf_temp-rule-i-script  where
     2680                   buf_temp-rule-i-script.root_rule_id = p-rule-id
     2681               and buf_temp-rule-i-script.i-script-name = buf_rule-i-script.script-name
     2682               and buf_temp-rule-i-script.i-script-type = 'variable':U
     2683               no-error.
     2684         if available buf_temp-rule-i-script then delete buf_temp-rule-i-script.
     2685       end.
     2686     end.
     2687   end.
     2688   end procedure.
     2689   procedure display-subsid-rule-i-script :
     2690   define parameter buffer buf_rule-i-script for ub.rule-i-script.
     2691     do
     2692     on error undo, return error
     2693     :
     2694       run temp-string_write in this-procedure ( input buf_rule-i-script.script-name ).
     2695     end.
     2696   end procedure.
