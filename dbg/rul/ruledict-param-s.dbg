     2020         .
     2021       end.
     2022       do with frame Dialog-Frame
     2023       :
     2024         hide v-diasize-resize-button .
     2025         v-diasize-resize-button :row = 1.
     2026         v-diasize-resize-button :column = 1.
     2027       end.
     2028       if p-change-value > 0
     2029       then do:
     2030         if frame Dialog-Frame :scrollable = true
     2031         then do:
     2032           assign
     2033             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2034             no-error .
     2035           if error-status :error
     2036           or error-status :get-message(1) <> ""
     2037           then do:
     2038             undo move_block, retry move_block.
     2039           end.
     2040         end.
     2041         assign
     2042           frame Dialog-Frame :width = v-frame-width + p-change-value
     2043           no-error .
     2044         if error-status :error
     2045         or error-status :get-message(1) <> ""
     2046         then do:
     2047           undo move_block, retry move_block.
     2048         end.
     2049         assign
     2050           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2051         no-error .
     2052         if error-status :error
     2053         or error-status :get-message(1) <> ""
     2054         then do:
     2055           undo move_block, retry move_block.
     2056         end.
     2057         for each buf_temp-browse-handle
     2058           where buf_temp-browse-handle.browse-type = 'width':u
     2059         on error undo move_block, retry move_block
     2060         :
     2061           assign
     2062             buf_temp-browse-handle.browse-handle :width
     2063               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2064             no-error .
     2065           if error-status :error
     2066           or error-status :get-message(1) <> ""
     2067           then do:
     2068             undo move_block, retry move_block .
     2069           end.
     2070         end.
     2071         for each buf_temp-diasize-handle
     2072         on error undo move_block, retry move_block
     2073         :
     2074           assign
     2075             v-object-handle = buf_temp-diasize-handle.handle-value
     2076           .
     2077           if v-object-handle <> v-diasize-resize-button
     2078           then do:
     2079             assign
     2080               v-object-handle :col = v-object-handle :col + p-change-value
     2081               no-error .
     2082             if error-status :error
     2083             or error-status :get-message(1) <> ""
     2084             then do:
     2085               undo move_block, retry move_block .
     2086             end.
     2087           end.
     2088         end.
     2089       end.
     2090       else do:
     2091         for each buf_temp-diasize-handle
     2092         on error undo move_block, retry move_block
     2093         :
     2094           assign
     2095             v-object-handle = buf_temp-diasize-handle.handle-value
     2096           .
     2097           if v-object-handle <> v-diasize-resize-button
     2098           then do:
     2099             assign
     2100               v-object-handle :col = v-object-handle :col + p-change-value
     2101               no-error .
     2102             if error-status :error
     2103             or error-status :get-message(1) <> ""
     2104             then do:
     2105               undo move_block, retry move_block .
     2106             end.
     2107           end.
     2108         end.
     2109         for each buf_temp-browse-handle
     2110           where buf_temp-browse-handle.browse-type = 'width':u
     2111         on error undo move_block, retry move_block
     2112         :
     2113           assign
     2114             buf_temp-browse-handle.browse-handle :width
     2115               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2116             no-error .
     2117           if error-status :error
     2118           or error-status :get-message(1) <> ""
     2119           then do:
     2120             undo move_block, retry move_block .
     2121           end.
     2122         end.
     2123         assign
     2124           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2125           no-error .
     2126         if error-status :error
     2127         or error-status :get-message(1) <> ""
     2128         then do:
     2129           undo move_block, retry move_block.
     2130         end.
     2131         assign
     2132           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2133         no-error .
     2134         if error-status :error
     2135         or error-status :get-message(1) <> ""
     2136         then do:
     2137           undo move_block, retry move_block.
     2138         end.
     2139         if frame Dialog-Frame :scrollable = true
     2140         then do:
     2141           assign
     2142             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2143           no-error .
     2144           if error-status :error
     2145           or error-status :get-message(1) <> ""
     2146           then do:
     2147             undo move_block, retry move_block.
     2148           end.
     2149         end.
     2150       end.
     2151       if p-move-resize
     2152       then do:
     2153         run diasize_position-resize-button in this-procedure .
     2154       end.
     2155       if v-diasize-wndstore = true
     2156       then do:
     2157         if connected("ub") = true
     2158         then do:
     2159           define variable v-cntxt-db-num        as integer   no-undo .
     2160           define variable v-cntxt-userid        as character no-undo .
     2161           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2162                                             , OUTPUT v-cntxt-userid
     2163                                             ) .
     2164           run gbl/wndsizew.p
     2165             (input  v-cntxt-db-num
     2166             ,input  v-cntxt-userid
     2167             ,input  v-diasize-proc-name
     2168             ,input  'width':u
     2169             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2170             ) .
     2171         end.
     2172       end.
     2173     end.
     2174     assign
     2175       v-diasize-change-size = false
     2176     .
     2177   end procedure.
     2178   procedure diasize_set-width :
     2179     define input  parameter p-new-width  as decimal   no-undo .
     2180     define input  parameter p-move-resize as logical   no-undo .
     2181     do
     2182     on error undo, return error return-value
     2183     :
     2184       run diasize_change-width in this-procedure
     2185         (input  (p-new-width - frame Dialog-Frame :width)
     2186         ,input  p-move-resize
     2187         ) .
     2188     end.
     2189   end procedure.
     2190   procedure diasize_position-resize-button :
     2191     do with frame Dialog-Frame
     2192     :
     2193       hide v-diasize-resize-button .
     2194       assign
     2195         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2196                     - 1
     2197                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2198         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2199                     - 1
     2200                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2201       .
     2202       view v-diasize-resize-button .
     2203     end.
     2204   end procedure.
     2205   on alt-right anywhere
     2206   do:
     2207     run diasize_change-width in this-procedure
     2208       (input 1
     2209       ,input true
     2210       ) .
     2211     return no-apply .
     2212   end.
     2213   on alt-left anywhere
     2214   do:
     2215     run diasize_change-width in this-procedure
     2216       (input -1
     2217       ,input true
     2218       ) .
     2219     return no-apply .
     2220   end.
     2221   on alt-down anywhere
     2222   do:
     2223     run diasize_change-height in this-procedure
     2224       (input 1
     2225       ,input true
     2226       ) .
     2227     return no-apply .
     2228   end.
     2229   on alt-up anywhere
     2230   do:
     2231     run diasize_change-height in this-procedure
     2232       (input -1
     2233       ,input true
     2234       ) .
     2235     return no-apply .
     2236   end.
     2237   on alt-enter of frame Dialog-Frame
     2238   do:
     2239     run diasize_maximize in this-procedure
     2240       (input  ?
     2241       ).
     2242     return no-apply .
     2243   end.
     2244   procedure diasize_end-move :
     2245     do
     2246     on error undo, return error return-value
     2247     :
     2248       define variable v-row-delta as decimal   no-undo .
     2249       define variable v-col-delta as decimal   no-undo .
     2250       define variable v-new-row as decimal   no-undo .
     2251       define variable v-new-col as decimal   no-undo .
     2252       assign
     2253         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2254         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2255       .
     2256       assign
     2257         v-row-delta = v-new-row - frame Dialog-Frame :height
     2258         v-col-delta = v-new-col - frame Dialog-Frame :width
     2259       .
     2260       run diasize_change-height in this-procedure
     2261         (input v-row-delta
     2262         ,input true
     2263         ) .
     2264       run diasize_change-width in this-procedure
     2265         (input v-col-delta
     2266         ,input true
     2267         ) .
     2268     end.
     2269   end procedure.
     2270   procedure diasize_maximize :
     2271     define input  parameter p-action as logical   no-undo .
     2272     do
     2273     on error undo, return error return-value
     2274     :
     2275       if p-action = ?
     2276       then do:
     2277         if v-diasize-need-maximize = true
     2278         then do:
     2279           assign
     2280             p-action = true
     2281           .
     2282         end.
     2283         else do:
     2284           assign
     2285             p-action = false
     2286           .
     2287         end.
     2288       end.
     2289       if p-action = true
     2290       then do:
     2291         run diasize_change-height in this-procedure
     2292           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2293               - frame Dialog-Frame :height-chars
     2294           ,input true
     2295           ) .
     2296         run diasize_change-width in this-procedure
     2297           (input session :width-chars
     2298               - frame Dialog-Frame :width-chars
     2299           ,input true
     2300           ) .
     2301         assign
     2302           v-diasize-need-maximize = false
     2303         .
     2304       end.
     2305       else do:
     2306         run diasize_change-width in this-procedure
     2307           (input v-diasize-orig-frame-width
     2308               - frame Dialog-Frame :width-chars
     2309           ,input true
     2310           ) .
     2311         run diasize_change-height in this-procedure
     2312           (input v-diasize-orig-frame-height
     2313               - frame Dialog-Frame :height-chars
     2314           ,input true
     2315           ) .
     2316         assign
     2317           v-diasize-need-maximize = true
     2318         .
     2319       end.
     2320     end.
     2321   end procedure.
     2322   procedure diasize_restore-orig-size :
     2323     do
     2324     on error undo, return error return-value
     2325     :
     2326       assign
     2327         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2328         v-diasize-current-frame-height = frame Dialog-Frame :height
     2329       .
     2330       run diasize_set-height in this-procedure
     2331         (input  v-diasize-orig-frame-height
     2332         ,input  true
     2333         ) .
     2334       run diasize_set-width in this-procedure
     2335         (input  v-diasize-orig-frame-width
     2336         ,input  true
     2337         ) .
     2338     end.
     2339   end procedure.
     2340   procedure diasize_restore-current-size :
     2341     do
     2342     on error undo, return error return-value
     2343     :
     2344       run diasize_set-height in this-procedure
     2345         (input  v-diasize-current-frame-height
     2346         ,input  true
     2347         ) .
     2348       run diasize_set-width in this-procedure
     2349         (input  v-diasize-current-frame-width
     2350         ,input  true
     2351         ) .
     2352     end.
     2353   end procedure.
     2354   procedure diasize_set-browse-handle :
     2355     define input  parameter p-browse-handle as handle   no-undo .
     2356     define buffer buf_temp-browse-handle for temp-browse-handle .
     2357     do
     2358     on error undo, return error return-value
     2359     :
     2360       assign
     2361         v-diasize-browse-handle = p-browse-handle
     2362       .
     2363       for each buf_temp-browse-handle
     2364       on error undo, return error return-value
     2365       :
     2366         delete buf_temp-browse-handle .
     2367       end.
     2368     end.
     2369   end procedure.
     2370   procedure diasize_add_browse :
     2371     define input  parameter p-browse-type   as character no-undo .
     2372     define input  parameter p-browse-handle as handle    no-undo .
     2373     define buffer buf_temp-browse-handle for temp-browse-handle .
     2374     do
     2375     on error undo, return error return-value
     2376     :
     2377       assign
     2378         v-diasize-browse-number = v-diasize-browse-number + 1
     2379       .
     2380       create buf_temp-browse-handle .
     2381       assign
     2382         buf_temp-browse-handle.browse-type   = p-browse-type
     2383         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2384         buf_temp-browse-handle.browse-handle = p-browse-handle
     2385       .
     2386     end.
     2387   end procedure.
     2388   procedure diasize_init :
     2389     define variable v-default-value    as logical   no-undo .
     2390     define variable v-restore-saved    as logical   no-undo .
     2391     define variable v-resize-value-str as character no-undo .
     2392     do
     2393     on error undo, return error return-value
     2394     :
     2395       do with frame Dialog-Frame
     2396       :
     2397         assign
     2398           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2399           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2400           v-diasize-browse-handle     = browse br-ruledict-param :handle
     2401         .
     2402         create button v-diasize-resize-button
     2403         assign
     2404           parent        = frame Dialog-Frame :first-child
     2405           label         = "s"
     2406           height-pixels = 16
     2407           width-pixels  = 16
     2408           visible       = true
     2409           sensitive     = true
     2410           movable       = true
     2411           triggers:
     2412             on end-move persistent run diasize_end-move in this-procedure .
     2413           end triggers.
     2414         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2415         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2416         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2417         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2418         assign
     2419           v-diasize-wndmax = false
     2420         .
     2421         if connected("ub") = true
     2422         then do:
     2423           define variable v-cntxt-db-num        as integer   no-undo .
     2424           define variable v-cntxt-userid        as character no-undo .
     2425           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2426                                             , OUTPUT v-cntxt-userid
     2427                                             ) .
     2428           run gbl/wndpar_r.p
     2429             (input  v-cntxt-db-num
     2430             ,input  v-cntxt-userid
     2431             ,input  'wndmax':U
     2432             ,output v-diasize-wndmax
     2433             ,output v-default-value
     2434             ) .
     2435         end.
     2436         assign
     2437           v-diasize-wndstore = false
     2438         .
     2439         if connected("ub") = true
     2440         then do:
     2441           run gbl/wndpar_r.p
     2442             (input  v-cntxt-db-num
     2443             ,input  v-cntxt-userid
     2444             ,input  'wndstore':U
     2445             ,output v-diasize-wndstore
     2446             ,output v-default-value
     2447             ) .
     2448         end.
     2449         assign
     2450           v-diasize-proc-name = entry(1, program-name(2), '.')
     2451         .
     2452         if v-diasize-wndstore = true
     2453         then do:
     2454           assign
     2455             v-restore-saved = false
     2456           .
     2457           if connected("ub") = true
     2458           then do:
     2459             run gbl/wndsizer.p
     2460               (input  v-cntxt-db-num
     2461               ,input  v-cntxt-userid
     2462               ,input  v-diasize-proc-name
     2463               ,input  'height':u
     2464               ,output v-resize-value-str
     2465               ) .
     2466             if v-resize-value-str <> '':U
     2467             then do:
     2468               run diasize_change-height in this-procedure
     2469                 (input  integer(v-resize-value-str)
     2470                 ,input  true
     2471                 ) .
     2472               assign
     2473                 v-restore-saved = true
     2474               .
     2475             end.
     2476           end.
     2477           if connected("ub") = true
     2478           then do:
     2479             run gbl/wndsizer.p
     2480               (input  v-cntxt-db-num
     2481               ,input  v-cntxt-userid
     2482               ,input  v-diasize-proc-name
     2483               ,input  'width':u
     2484               ,output v-resize-value-str
     2485               ) .
     2486             if v-resize-value-str <> '':U
     2487             then do:
     2488               run diasize_change-width in this-procedure
     2489                 (input  integer(v-resize-value-str)
     2490                 ,input  true
     2491                 ) .
     2492               assign
     2493                 v-restore-saved = true
     2494               .
     2495             end.
     2496           end.
     2497           if v-restore-saved <> true
     2498           then do:
     2499             if v-diasize-wndmax = true
     2500             then do:
     2501               run diasize_maximize in this-procedure
     2502                 (input  true
     2503                 ) .
     2504             end.
     2505           end.
     2506         end.
     2507         else do:
     2508           if v-diasize-wndmax = true
     2509           then do:
     2510             run diasize_maximize in this-procedure
     2511               (input  true
     2512               ) .
     2513           end.
     2514         end.
     2515       end.
     2516     end.
     2517   end procedure.
     2518   procedure diasize_need-full-display :
     2519     define output parameter p-need-full-display as logical   no-undo .
     2520     do
     2521     on error undo, return error return-value
     2522     :
     2523       assign
     2524         p-need-full-display = v-diasize-need-full-display
     2525       .
     2526       assign
     2527         v-diasize-need-full-display = false
     2528       .
     2529     end.
     2530   end procedure.
     2531   procedure get-context :
     2532      define output parameter p-db-num as integer          no-undo.
     2533      define output parameter p-user-id as character        no-undo.
     2534      define variable v-login               as character    no-undo.
     2535      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2536      define buffer buf_user-login  for ub.user-login .
     2537      do
     2538      on error undo, return error
     2539      :
     2540            FIND FIRST buf_sys-ctrl no-lock.
     2541            ASSIGN
     2542               v-login = USERID("ub")
     2543               p-db-num = buf_sys-ctrl.db-num
     2544            .
     2545            FIND FIRST buf_user-login
     2546                 WHERE buf_user-login.db-num = p-db-num
     2547                   AND buf_user-login.user-login = v-login
     2548                 no-lock
     2549                 no-error
     2550                 .
     2551            IF AVAILABLE buf_user-login
     2552            THEN DO:
     2553               assign
     2554                  p-user-id = buf_user-login.user-id
     2555               .
     2556            END.
     2557      end.
     2558   end procedure.
     2559       run diasize_init in this-procedure .
     2560   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2561   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2562   MAIN-BLOCK:
     2563   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2564      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2565   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2566     run mainmenu_getcntxt in parparentproc
     2567       (output v-cntxt-db-num
     2568       ,output v-cntxt-userid
     2569       ,output v-cntxt-level
     2570       ,output v-cntxt-host-code-obj
     2571       ,output v-cntxt-obj-type
     2572       ,output v-cntxt-obj-code
     2573       ,output v-cntxt-db-num-obj
     2574       ,output v-cntxt-is-admin
     2575       ) .
     2576     if p-list-mode = 'ИЗМЕНЕНИЕ':U then do:
     2577        run fill-tt-ruledict-param in p-update-proc-handle ( input buffer tt-ruledict-param:handle) no-error .
     2578        if error-status:error then do:
     2579          MESSAGE
     2580          substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2581          VIEW-AS ALERT-BOX ERROR.
     2582          undo main-block, return error.
     2583        end.
     2584     end.
     2585     v-rid-list = p-rid-list.
     2586     run Myenable in this-procedure .
     2587     WAIT-FOR GO OF FRAME Dialog-Frame.
     2588   END.
     2589   RUN disable_UI.
     2590   if v-return-value = "quit" then return "quit".
     2591   PROCEDURE brwrefre :
     2592   CASE p-list-mode:
     2593     WHEN 'ИЗМЕНЕНИЕ':U THEN DO:
     2594         v-doc-rec = recid(tt-ruledict-param).
     2595         RUn OpenBR in this-procedure.
     2596         REPOSITION br-tt-ruledict-param to recid v-doc-rec No-ERROR.
     2597         apply 'value-changed' to br-tt-ruledict-param IN FRAME Dialog-Frame.
     2598     END.
     2599     OTHERWISE DO:
     2600       v-doc-rec = recid(X_ruledict-param).
     2601       RUn OpenBR in this-procedure.
     2602       REPOSITION br-ruledict-param to recid v-doc-rec No-ERROR.
     2603       apply 'value-changed' to br-ruledict-param  IN FRAME Dialog-Frame.
     2604     END.
     2605   END CASE.
     2606   END PROCEDURE.
     2607   PROCEDURE disable_UI :
     2608     HIDE FRAME Dialog-Frame.
     2609   END PROCEDURE.
     2610   PROCEDURE enable_UI :
     2611     DISPLAY mark-num
     2612         WITH FRAME Dialog-Frame.
     2613     ENABLE b-exit b-quit b-mark b-sel b-add b-chg b-del b-lkp b-links B-Help
     2614            br-tt-ruledict-param br-ruledict-param mark-num
     2615         WITH FRAME Dialog-Frame.
     2616     VIEW FRAME Dialog-Frame.
     2617     OPEN QUERY br-ruledict-param FOR EACH X_ruledict-param.    OPEN QUERY br-tt-ruledict-param FOR EACH tt-ruledict-param.
     2618   END PROCEDURE.
     2619   PROCEDURE fill-ruledict-param :
     2620   define input parameter p-bh as handle no-undo .
     2621   define input parameter p-mode as character no-undo .
     2622   define variable glog as logical no-undo .
     2623   if p-mode = 'ДОБАВЛЕНИЕ':U then do:
     2624     assign
     2625     glog = p-bh:buffer-create no-error.
     2626     if error-status:error then do:
     2627       UNDO, RETURN ERROR substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     2628     end.
     2629   end.
     2630   if p-mode <> 'ДОБАВЛЕНИЕ':U then do:
     2631     assign
     2632     glog = p-bh:buffer-copy(buffer tt-ruledict-param:handle) no-error.
     2633     if error-status:error then do:
     2634       UNDO, RETURN ERROR substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     2635     end.
     2636   end.
     2637   END PROCEDURE.
     2638   PROCEDURE MyEnable :
     2639   ASSIGN
     2640   X_ruledict-param.param-label:RESIZABLE IN BROWSE br-ruledict-param = YES
     2641   X_ruledict-param.param-name:RESIZABLE IN BROWSE br-ruledict-param = YES
     2642   tt-ruledict-param.param-label:RESIZABLE IN BROWSE br-tt-ruledict-param = YES
     2643   tt-ruledict-param.param-name:RESIZABLE IN BROWSE br-tt-ruledict-param = YES
     2644   b-links:MENU-MOUSE IN FRAME Dialog-Frame = 1.
     2645   ENABLE
     2646   b-quit
     2647   b-exit when (p-list-mode = 'ИЗМЕНЕНИЕ':U)
     2648   b-add when (lookup("b-add", bttns) > 0 and v-cntxt-db-num = 0)
     2649   b-chg when (lookup("b-add", bttns) > 0 and  v-cntxt-db-num = 0)
     2650   b-del when (lookup("b-add", bttns) > 0 and  v-cntxt-db-num = 0)
     2651   b-lkp
     2652   B-Help
     2653   b-mark when lookup("b-mark", bttns) > 0
     2654   b-sel when lookup("b-sel", bttns) > 0
     2655   b-links WHEN (p-entry-id <> 0)
     2656   br-ruledict-param when p-list-mode <> 'ИЗМЕНЕНИЕ':U
     2657   br-tt-ruledict-param when p-list-mode = 'ИЗМЕНЕНИЕ':U
     2658   WITH FRAME Dialog-Frame.
     2659   VIEW FRAME Dialog-Frame.
     2660   if p-list-mode = 'ИЗМЕНЕНИЕ':U then do:
     2661     hide
     2662     br-ruledict-param
     2663     in frame Dialog-Frame .
     2664   end.
     2665   else do:
     2666     hide
     2667     br-tt-ruledict-param
     2668     b-exit
     2669     in frame Dialog-Frame .
     2670     ASSIGN
     2671     b-quit:LABEL = "&Выход"
     2672     b-quit:COLUMN = 1
     2673     .
     2674   end.
     2675   run OpenBr in this-procedure .
     2676   END PROCEDURE.
     2677   PROCEDURE Openbr :
     2678   CASE p-list-mode:
     2679     WHEN 'все':U THEN DO:
     2680       frame Dialog-Frame :title = "Все параметры терминов словаря RULE-машины".
     2681       OPEN QUERY br-ruledict-param
     2682       FOR EACH X_ruledict-param NO-LOCK INDEXED-REPOSITION.
     2683     END.
     2684     WHEN "entry-id" THEN DO:
     2685       frame Dialog-Frame :title = substitute("Все параметры для термина RULE-машины &1", p-entry-id).
     2686       OPEN QUERY br-ruledict-param
     2687       FOR EACH X_ruledict-param NO-LOCK WHERE X_ruledict-param.entry-id = p-entry-id INDEXED-REPOSITION.
     2688     END.
     2689     WHEN 'ИЗМЕНЕНИЕ':U THEN DO:
     2690       frame Dialog-Frame :title = substitute("Все параметры для термина RULE-машины &1", p-entry-id).
     2691       OPEN QUERY br-tt-ruledict-param
     2692       FOR EACH tt-ruledict-param NO-LOCK WHERE
     2693               tt-ruledict-param.entry-id = p-entry-id INDEXED-REPOSITION.
     2694     END.
     2695   END CASE.
     2696   END PROCEDURE.
     2697   PROCEDURE proc-b-link :
     2698   define variable v-rid-list as character no-undo .
     2699   DEFINE INPUT PARAMETER p-option AS CHARACTER NO-UNDO.
     2700   define variable v-rec as recid no-undo .
     2701   define variable v-rule-id as integer no-undo .
     2702   define variable v-profile-id as integer no-undo .
     2703   define variable v-field-list as character no-undo .
     2704   define variable v-value-list as character no-undo .
     2705   define buffer buf_rule-call-param for ub.rule-call-param.
     2706   define buffer buf_ruledict for ub.ruledict.
     2707   define buffer buf_rp-rule-param for ub.rp-rule-param.
     2708   IF p-list-mode = 'ИЗМЕНЕНИЕ':U
     2709   AND p-entry-id = 0 THEN DO:
     2710     MESSAGE
     2711     substitute("Просмотр невозможен&1Термина словаря еще не существует"
     2712                , chr(10))
     2713     VIEW-AS ALERT-BOX ERROR.
     2714     UNDO, RETURN ERROR.
     2715   END.
     2716   CASE p-option:
     2717     WHEN 'rule-call-param':U THEN DO:
     2718       find first buf_ruledict no-lock where
     2719                 buf_Ruledict.entry-id = (IF p-list-mode = 'ИЗМЕНЕНИЕ':U
     2720                                          THEN tt-ruledict-param.entry-id
     2721                                          ELSE X_ruledict-param.entry-id ) no-error.
     2722       if not available buf_Ruledict
     2723       or not (buf_ruledict.entry-type = 'rule':U
     2724               or
     2725               buf_ruledict.entry-type = 'rule-profile':U
     2726               )
     2727       then do:
     2728         message
     2729         substitute("Термин словаря не найден или не является термином типа &1&2Просмотр невозможен"
     2730                   , 'rule':U
     2731                   , chr(10))
     2732         view-as alert-box error .
     2733         undo, return error .
     2734       end.
     2735       for each tt0-rule-call-param:
     2736         delete tt0-rule-call-param.
     2737       end.
     2738       case buf_ruledict.entry-type :
     2739         when 'rule':U then do:
     2740           run gen-key-fv in this-procedure ( input buf_ruledict.uniq-key-rec
     2741                                             ,output v-field-list
     2742                                             ,output v-value-list).
     2743           assign
     2744           v-rule-id = integer(entry(lookup("rule_id":U
     2745                                               , v-field-list
     2746                                               , chr(3))
     2747                                         , v-value-list, chr(3))).
     2748           for each buf_rule-call-param no-lock where
     2749                   buf_Rule-call-param.rule_id = v-rule-id:
     2750             create tt0-rule-call-param.
     2751             buffer-copy buf_rule-call-param to tt0-rule-call-param.
     2752           end.
     2753           run ref/rulercps.w ( INPUT parparentproc
     2754                               ,input this-procedure:handle
     2755                               ,INPUT "":U
     2756                               ,input 'ПРОСМОТР':U
     2757                               ,input 'rule-call-param':U
     2758                               ,input 0
     2759                               ,input ?
     2760                               ,input '':U
     2761                               ,input 0
     2762                               ,input 0
     2763                               ,input ?
     2764                               ,input v-rule-id
     2765                               ,input substitute("Параметры вызова правила &1", v-rule-id)
     2766                               ,input-output table tt0-rule-call-param ) no-error.
     2767         end.
     2768         when 'rule-profile':U then do:
     2769           run gen-key-fv in this-procedure ( input buf_ruledict.uniq-key-rec
     2770                                             ,output v-field-list
     2771                                             ,output v-value-list).
     2772           assign
     2773           v-profile-id = integer(entry(lookup("profile_id":U
     2774                                               , v-field-list
     2775                                               , chr(3))
     2776                                         , v-value-list, chr(3))).
     2777            for each buf_rp-rule-param no-lock where
     2778                     buf_rp-rule-param.profile_id = v-profile-id
     2779                and  buf_rp-rule-param.rp-param-name = X_ruledict-param.param-name,
     2780               each buf_rule-call-param no-lock where
     2781                   buf_Rule-call-param.profile_id = v-profile-id
     2782               and buf_Rule-call-param.codex_id = buf_rp-rule-param.codex_id
     2783               and buf_Rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     2784               and  buf_rule-call-param.rule_id = buf_rp-rule-param.rule_id
     2785               and  buf_rule-call-param.param-name = buf_rp-rule-param.rule-param-name:
     2786             create tt0-rule-call-param.
     2787             buffer-copy buf_rule-call-param to tt0-rule-call-param.
     2788           end.
     2789           run ref/rulercps.w ( INPUT parparentproc
     2790                               ,input this-procedure:handle
     2791                               ,INPUT "":U
     2792                               ,input 'ПРОСМОТР':U
     2793                               ,input 'rp-rule-param':U + chr(44) + 'все':U
     2794                               ,input v-profile-id
     2795                               ,input ?
     2796                               ,input '':U
     2797                               ,input 0
     2798                               ,input 0
     2799                               ,input ?
     2800                               ,input 0
     2801                               ,input substitute("Параметры вызова профайла &1 для параметра &2", v-profile-id, IF p-list-mode = 'ИЗМЕНЕНИЕ':U
     2802                                          THEN tt-ruledict-param.param-name else X_ruledict-param.param-name)
     2803                               ,input-output table tt0-rule-call-param ) no-error.
     2804   if error-status:error
     2805   then
     2806      message return-value error-status:get-message(1)  view-as alert-box.
     2807         end.
     2808       end case.
     2809     END.
     2810   END CASE.
     2811   END PROCEDURE.
     2812   PROCEDURE save-ruledict-param :
     2813   define input parameter p-bh as handle no-undo .
     2814   define input parameter p-mode as character no-undo .
     2815   define output parameter p-rec as recid no-undo .
     2816   define variable glog as logical no-undo .
     2817   define variable v-ii as integer no-undo .
     2818   define buffer buf_tt-ruledict-param for tt-ruledict-param.
     2819   if p-mode = 'ДОБАВЛЕНИЕ':U then do:
     2820     do v-ii = 1 to 999999999:
     2821       assign
     2822       glog = buffer buf_tt-ruledict-param:find-first( substitute( "where param-num = &1", v-ii)) no-error.
     2823       if not glog then do:
     2824          leave.
     2825       end.
     2826     end.
     2827     assign
     2828     glog = buffer buf_tt-ruledict-param:buffer-create no-error.
     2829     if error-status:error then do:
     2830       UNDO, RETURN ERROR substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     2831     end.
     2832     assign
     2833     glog = buffer buf_tt-ruledict-param:buffer-copy(p-bh) no-error.
     2834     p-rec = recid(buf_tt-ruledict-param).
     2835     buf_tt-ruledict-param.entry-id = p-entry-id.
     2836     buf_tt-ruledict-param.param-num = v-ii.
     2837   end.
     2838   else do:
     2839     assign
     2840     glog = buffer tt-ruledict-param:buffer-copy(p-bh) no-error.
     2841     p-rec = recid(tt-ruledict-param).
     2842     tt-ruledict-param.entry-id = p-entry-id.
     2843   end.
     2844   if error-status:error then do:
     2845     UNDO, RETURN ERROR substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     2846   end.
     2847   END PROCEDURE.
     2848   PROCEDURE set-row-color :
     2849   DEFINE INPUT PARAMETER p-ruledict-param-type AS character.
     2850   DEFINE VARIABLE iFGColor AS INTEGER NO-UNDO.
     2851   DEFINE VARIABLE iBGColor AS INTEGER NO-UNDO.
     2852   CASE p-ruledict-param-type:
     2853     WHEN 'integer':U THEN DO:
     2854       ASSIGN
     2855       iFGColor = BLUE_COLOR
     2856       iBGColor = WHITE_COLOR
     2857       .
     2858     end.
     2859     when 'character':U then do:
     2860       ASSIGN
     2861       iFGColor = BLACK_COLOR
     2862       iBGColor = WHITE_COLOR
     2863       .
     2864     end.
     2865     when 'decimal':U then do:
     2866       ASSIGN
     2867       iFGColor = GREEN_COLOR
     2868       iBGColor = WHITE_COLOR
     2869       .
     2870     end.
     2871     when 'date':U then do:
     2872       ASSIGN
     2873       iFGColor = GRAY_COLOR
     2874       iBGColor = WHITE_COLOR
     2875       .
     2876     end.
     2877     when 'logical':U then do:
     2878       ASSIGN
     2879       iFGColor = RED_COLOR
     2880       iBGColor = WHITE_COLOR
     2881       .
     2882     end.
     2883     otherwise do:
     2884       ASSIGN
     2885         iFGColor = Black_COLOR
     2886         iBGColor = White_COLOR
     2887       .
     2888     end.
     2889   END CASE.
     2890   if p-list-mode = 'ИЗМЕНЕНИЕ':U then do:
     2891     ASSIGN
     2892     tt-ruledict-param.param-data-type:FGCOLOR IN BROWSE br-tt-ruledict-param = iFGColor
     2893     tt-ruledict-param.param-data-type:BGCOLOR IN BROWSE br-tt-ruledict-param = iBGColor
     2894     .
     2895   end.
     2896   else do:
     2897     ASSIGN
     2898     X_ruledict-param.param-data-type:FGCOLOR IN BROWSE br-ruledict-param = iFGColor
     2899     X_ruledict-param.param-data-type:BGCOLOR IN BROWSE br-ruledict-param = iBGColor
     2900     .
     2901   end.
     2902   END PROCEDURE.
