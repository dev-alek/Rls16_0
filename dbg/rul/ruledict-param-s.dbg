     1993           and can-query(v-object-handle, "row")
     1994           and can-query(v-object-handle, "height")
     1995           and ( v-object-handle :col + v-object-handle :width
     1996                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1997               )
     1998           then do:
     1999             find first buf_temp-browse-handle
     2000               where buf_temp-browse-handle.browse-type   = 'width':u
     2001                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2002               no-error .
     2003             if available buf_temp-browse-handle
     2004             then do:
     2005             end.
