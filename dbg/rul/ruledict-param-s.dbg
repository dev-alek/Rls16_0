        1   DEFINE TEMP-TABLE tt-ruledict-param NO-UNDO LIKE ub.ruledict-param.
        2   DEFINE BUFFER X_ruledict-param FOR ub.ruledict-param.
        3   define input parameter parparentproc as widget-handle no-undo .
        4   define input parameter p-update-proc-handle as handle no-undo .
        5   define input parameter bttns as character no-undo.
        6   define input parameter p-list-mode as character no-undo .
        7   define input parameter p-entry-id as integer no-undo .
        8   define input parameter p-entry-type as character no-undo .
        9   define input-output parameter p-rid-list as character no-undo.
       10   define variable vss-revision    as character no-undo init "$Revision$":U .
       11   define variable vss-author      as character no-undo init "$Author$":U .
       12   define variable vss-date        as character no-undo init "$Date$":U .
       13   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       14   define variable vss-archive     as character no-undo init "$Archive$":U .
       15   define variable vss-description as character no-undo init "Список ruledict-param".
       16   procedure vss-get-info :
       17     define output parameter p-vss-revision    like vss-revision    no-undo .
       18     define output parameter p-vss-author      like vss-author      no-undo .
       19     define output parameter p-vss-date        like vss-date        no-undo .
       20     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       21     define output parameter p-vss-archive     like vss-archive     no-undo .
       22     define output parameter p-vss-description like vss-description no-undo .
       23     assign
       24       p-vss-revision    = vss-revision
       25       p-vss-author      = vss-author
       26       p-vss-date        = vss-date
       27       p-vss-workfile    = vss-workfile
       28       p-vss-archive     = vss-archive
       29       p-vss-description = vss-description
       30     .
       31   end procedure.
       32   procedure vss-get-parameters :
       33     define output parameter p-vss-parameters as character no-undo .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       71   define variable v-waitfram-action01         as character   no-undo .
       72   define variable v-waitfram-action02         as character   no-undo .
       73   define variable v-waitfram-action03         as character   no-undo .
       74   define variable mWaitFramTextBeg            as character   no-undo.
       75   define variable mWaitFramTextEnd            as character   no-undo.
       76   define variable mWaitFramView               as logical     no-undo.
       77   define variable mWaitProcEvent              as logical     no-undo init yes.
       78   define variable mWaitFramInterval           as integer     no-undo init 1 .
       79   define variable mWaitFramStop               as logical     no-undo.
       80   define variable mWaitFramStopUser           as logical     no-undo.
       81   define variable mWaitFramStopTimeOut        as logical     no-undo.
       82   define variable mWaitFramStartProc          as datetime-tz no-undo.
       83   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       84   define button B-WaitFramStop auto-end-key
       85        label "Стоп"
       86        size 10 by 1 tooltip "Остоновить процесс".
       87   define button B-viewProcInfo
       88        label "Информация"
       89        size 15 by 1 tooltip "Информация о процесс".
       90   define frame waitfram
       91     v-waitfram-action01 format "x(72)" no-label skip
       92     v-waitfram-action02 format "x(72)" no-label skip
       93     v-waitfram-action03 format "x(72)" no-label skip
       94     B-viewProcInfo
       95     B-WaitFramStop at row 4 col 30
       96     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       97     .
       98   define new global shared variable mBatchMode as logical no-undo init ?.
       99   define variable mFramBachModHandle as handle no-undo.
      100   mFramBachModHandle = frame waitfram:handle.
      101   define variable mFameOldVis as logical no-undo.
      102   define variable mVisCUrentVin as logical no-undo.
      103   if session:batch-mode
      104   then
      105      mBatchMode = yes.
      106   if mBatchMode = ? then do:
      107     mVisCUrentVin = current-window:visible.
      108     mFameOldVis = mFramBachModHandle:visible.
      109     mFramBachModHandle:visible  = yes.
      110     mBatchMode = mFramBachModHandle:visible ne yes.
      111     mFramBachModHandle:visible = mFameOldVis.
      112     current-window:visible = mVisCUrentVin.
      113   end.
      114    if  log-manager:logfile-name ne ?
      115     then DO:
      116         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      117         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      118         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      119     end.
      120   on choose of B-WaitFramStop in frame waitfram
      121   do:
      122     mWaitFramStop = yes.
      123     mWaitFramStopUser = yes.
      124   end.
      125   function waitfram-check-timeout returns logical():
      126      define variable vtime as int64 no-undo.
      127      if mWaitFramStopTimeOut
      128      then
      129         return yes.
      130      vtime = ( now - mWaitFramStartProc ) / 1000 .
      131      if     mWaitFramTimeOut ne ?
      132         and mWaitFramTimeOut ne 0
      133         and mWaitFramTimeOut lt vtime
      134      then do:
      135         mWaitFramStopTimeOut = yes.
      136      end.
      137      return mWaitFramStopTimeOut.
      138   end.
      139   procedure waitfram-hide :
      140     if not session:batch-mode
      141     then do
      142     on error undo, return error return-value
      143     :
      144       pause 0 before-hide .
      145       if not mBatchMode then
      146         hide frame waitfram .
      147     if     not mWaitFramView
      148        and mWaitProcEvent
      149     then
      150       process events .
      151     end.
      152   end procedure.
      153   procedure waitfram-show :
      154     define input  parameter p-message as character no-undo .
      155     define variable v-left-margin as integer   no-undo .
      156     if not session:batch-mode
      157     then do
      158     on error undo, return error return-value
      159     :
      160       if length(p-message) <= 70 then do:
      161         assign
      162           v-left-margin = integer((70 - length(p-message)) / 2)
      163         .
      164         assign
      165           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      166         .
      167         assign
      168           v-waitfram-action01 = " "
      169           v-waitfram-action02 = " "
      170                                    + fill(" ", v-left-margin)
      171                                    + p-message
      172           v-waitfram-action03 = " "
      173         .
      174       end.
      175       else do:
      176         define variable vRindex1 as integer no-undo.
      177         define variable vRindex2 as integer no-undo.
      178         vRindex1 = r-index(p-message," ",70).
      179         if vRindex1 = 0
      180         then
      181            vRindex1 = 70.
      182         if length(p-message)  <= vRindex1 + 70 then do:
      183           assign
      184             v-waitfram-action01 = " "
      185             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      186             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      187           .
      188         end.
      189         else do:
      190           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      191           if vRindex2 <= vRindex1
      192           then
      193              vRindex2 = vRindex1 + 70.
      194           assign
      195             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      196             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      197             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      198           .
      199         end.
      200       end.
      201       B-viewProcInfo:visible   in frame waitfram = no.
      202       B-viewProcInfo:sensitive in frame waitfram = no.
      203       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      204       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      205       if  (   mWaitFramView
      206          or  mWaitProcEvent)
      207          and not mBatchMode
      208       then
      209          display
      210             v-waitfram-action01 skip
      211             v-waitfram-action02 skip
      212             v-waitfram-action03 skip
      213          with frame waitfram .
      214       if     mWaitFramView
      215          then do:
      216             if     mWaitFramInterval ne ?
      217                and not mBatchMode
      218             then
      219                wait-for go of frame waitfram pause mWaitFramInterval.
      220          end.
      221          else
      222             if     mWaitProcEvent
      223                and not mBatchMode
      224             then
      225                process events .
      226     end.
      227   end procedure.
      228      procedure waitfram-show-this:
      229         define input  parameter iInterval as int64 no-undo.
      230         define variable vtime as int64 no-undo.
      231         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      232         mWaitFramInterval = iInterval.
      233         run waitfram-show (substitute("&1&2 &3&4" ,
      234                                       mWaitFramTextBeg ,
      235                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      236                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      237                                       mWaitFramTextEnd
      238                                      )
      239                           ).
      240      end.
      241      procedure WaitFramRunPause:
      242         define input  parameter iInterval as dec no-undo.
      243         define variable vStart  as datetime-tz no-undo.
      244         define variable vend    as datetime-tz no-undo.
      245         define variable vint as int64 no-undo.
      246         define variable vOk as logical no-undo.
      247         vStart = now.
      248         vend   = vStart.
      249         publish "WaitFramPause" (iInterval,output vOk).
      250         vend   =  now.
      251         vint = vend - vStart.
      252         vint = iInterval - vint / 1000.
      253         if     not mWaitFramStop
      254            and (   vint > 0
      255                 or (    not vOk
      256                     and iInterval eq ?
      257                     )
      258                 )
      259         then
      260            run waitfram-show-this (iInterval).
      261         vend   =  now.
      262         vint = vend - vStart.
      263         vint = iInterval - vint / 1000.
      264         if     not mWaitFramStop
      265            and vint > 0
      266         then do:
      267            run gbl/pause.p (vint * 1000).
      268         end.
      269         if iInterval ne ?
      270         then
      271            publish "WaitFramStop".
      272         waitfram-check-timeout().
      273      end.
      274      procedure WaitFramWaitFor:
      275         define input  parameter iInterval as dec no-undo.
      276         assign
      277            mWaitFramStartProc   = now
      278            mWaitFramStopUser    = no
      279            mWaitFramStopTimeOut = no
      280         .
      281         block-wait:
      282         do while not mWaitFramStop:
      283            run WaitFramRunPause (iInterval).
      284            if  waitfram-check-timeout()
      285            then do:
      286               leave block-wait.
      287            end.
      288         end.
      289         run waitfram-hide.
      290      end.
      291   procedure waitfram-join :
      292     define input  parameter p-line-1  as character no-undo .
      293     define input  parameter p-line-2  as character no-undo .
      294     define input  parameter p-line-3  as character no-undo .
      295     define output parameter p-message as character no-undo .
      296     do
      297     on error undo, return error return-value
      298     :
      299       assign
      300         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      301                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      302                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      303       .
      304     end.
      305   end procedure.
      306   function waitfram-join-function returns character
      307     (input p-line-1 as character
      308     ,input p-line-2 as character
      309     ,input p-line-3 as character
      310     ).
      311     define variable v-message as character no-undo .
      312     run waitfram-join in this-procedure
      313       (input  p-line-1
      314       ,input  p-line-2
      315       ,input  p-line-3
      316       ,output v-message
      317       ) .
      318     return v-message .
      319   end function .
      320   define new global shared variable g#language as character no-undo .
      321   if g#language <> '' and g#language <> 'rus':U then do:
      322     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      323   end.
      324   procedure proc-alt-shift-f2:
      325     if not ibs.th.gbl.gbl-var:rcode
      326   then
      327     run gbl\inidebug.p .
      328   end.
      329   procedure proc-alt-shift-f3:
      330     run gbl/prvssinf.p
      331       ( input this-procedure
      332       ) .
      333   end.
      334   define variable v-inform-launched as logical no-undo initial false .
      335   procedure proc-alt-shift-f4:
      336     define variable v-action as character no-undo .
      337     if v-inform-launched = false then do:
      338       assign
      339         v-inform-launched = true
      340       .
      341       run gbl/d-inform.w
      342         (  input self
      343         ,  input this-procedure
      344         , output v-action
      345         ) no-error .
      346       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      347       assign
      348         v-inform-launched = false
      349       .
      350     end.
      351   end.
      352   procedure proc-alt-f1:
      353     run gbl/corrhelp.p
      354       (input this-procedure
      355       ) .
      356   end .
      357   on alt-shift-f2 anywhere do:
      358     run proc-alt-shift-f2.
      359   end.
      360   on alt-shift-f3 anywhere do:
      361     run proc-alt-shift-f3 in this-procedure .
      362   end.
      363   on alt-shift-f4 anywhere do:
      364     run proc-alt-shift-f4 in this-procedure.
      365   end.
      366   on alt-f1 anywhere do:
      367     run proc-alt-f1 in this-procedure .
      368   end.
      369   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      370   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
      371   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
      372   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
      373   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
      374   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
      375   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      376   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      377   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      378   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      379   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
      380   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
      381   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
      382   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
      383   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
      384   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
      385   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
      386   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
      387   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      388     define variable v-cntxt-db-num        as integer   no-undo .
      389     define variable v-cntxt-userid        as character no-undo .
      390     define variable v-cntxt-level         as character no-undo .
      391     define variable v-cntxt-host-code-obj as integer   no-undo .
      392     define variable v-cntxt-obj-type      as character no-undo .
      393     define variable v-cntxt-obj-code      as integer   no-undo .
      394     define variable v-cntxt-db-num-obj    as integer   no-undo .
      395     define variable v-cntxt-is-admin      as logical   no-undo .
      396   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      397   procedure gen-key-rec :
      398     define input  parameter p-tbl-name    as character no-undo.
      399     define input  parameter p-bh_tbl-name as handle    no-undo.
      400     define output parameter p-key-rec     as character no-undo.
      401     do
      402     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      403     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      404     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      405     :
      406       define variable fh               as handle    no-undo .
      407       define variable v-ok             as logical   no-undo .
      408       define variable v-inform         as character no-undo .
      409       define variable v-ind            as integer   no-undo .
      410       define variable v-idx-field-qnty as integer   no-undo .
      411       if p-tbl-name = ?
      412         or p-tbl-name = "":U
      413       then do:
      414         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info3 ).
      415       end.
      416       if not p-bh_tbl-name:available then do:
      417         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info3, p-tbl-name ).
      418       end.
      419       assign
      420         p-key-rec = p-tbl-name
      421         v-inform  = p-bh_tbl-name:index-information(1)
      422         v-ind     = 2
      423       .
      424       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      425       on error undo, return error
      426       :
      427         assign
      428           v-inform = p-bh_tbl-name:index-information( v-ind )
      429           v-ind    = v-ind + 1
      430         .
      431       end.
      432       if v-inform = ?
      433         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      434         or entry( 3, v-inform, ",":U ) <> "1":U
      435       then do:
      436         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, p-tbl-name ).
      437       end.
      438       else do:
      439         assign
      440           v-idx-field-qnty = num-entries( v-inform ) - 4
      441         .
      442         if v-idx-field-qnty < 2 then do:
      443           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, p-tbl-name ).
      444         end.
      445         do v-ind = 1 to v-idx-field-qnty by 2
      446         on error undo, return error
      447         :
      448           assign
      449             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      450             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      451           .
      452         end.
      453       end.
      454       if p-key-rec = ? then do:
      455         assign
      456           p-key-rec = "":U
      457         .
      458         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info3, p-tbl-name ).
      459       end.
      460     end.
      461     return.
      462   end procedure.
      463   procedure gen-where-keyr-tab :
      464     define input  parameter i-tableSerach as character no-undo.
      465     define input  parameter i-tablekey   as character  no-undo.
      466     define input  parameter p-key-rec    as character  no-undo.
      467     define input  parameter p-key-handle as handle     no-undo .
      468     define input  parameter p-db-name    as character  no-undo .
      469     define input  parameter p-tt-handle  as handle     no-undo .
      470     define output parameter o-Where      as character  no-undo.
      471     do
      472     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      473     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      474     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      475     :
      476       define variable v-full-tbl-name  as character no-undo .
      477       define variable bh_tbl-name      as handle    no-undo .
      478       define variable fh_key           as handle    no-undo .
      479       define variable fh_search        as handle    no-undo .
      480       define variable v-field-num      as integer   no-undo .
      481       define variable v-count-fld      as integer   no-undo .
      482       define variable v-inform         as character no-undo .
      483       define variable v-ind            as integer   no-undo .
      484       define variable v-idx-field-qnty as integer   no-undo .
      485       define variable v-field-name     as character no-undo .
      486       define variable v-field-val      as character no-undo .
      487       define variable v-word-link      as character no-undo .
      488       define variable vTable           as character no-undo.
      489       define variable bh_tbl-key       as handle    no-undo .
      490       assign
      491         p-key-rec = trim( p-key-rec )
      492       .
      493       if p-key-handle <> ? then do:
      494         if not valid-handle(p-key-handle)
      495            or p-key-handle:type <> "buffer"
      496         then do:
      497           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info3 ).
      498         end.
      499         if num-entries( p-key-rec, chr(3) ) > 1
      500           or p-key-rec = ?
      501           or p-key-rec = "":U
      502         then do:
      503           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info3, p-key-rec ).
      504         end.
      505       end.
      506       else do:
      507         if p-key-rec = ?
      508           or p-key-rec = "":U
      509         then do:
      510           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      511         end.
      512       end.
      513       assign
      514         vTable = entry( 1 , p-key-rec, chr(3) )
      515       .
      516       if p-tt-handle <> ?
      517         and ( not valid-handle(p-tt-handle)
      518               or p-tt-handle:type <> "buffer"
      519             )
      520       then do:
      521         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info3, vTable, chr(10) ).
      522       end.
      523       if p-tt-handle = ? then do:
      524         assign
      525           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      526         .
      527         create buffer bh_tbl-name for table v-full-tbl-name .
      528       end.
      529       else do:
      530         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      531       end.
      532       assign
      533         v-inform = bh_tbl-name:index-information(1)
      534         v-ind    = 2
      535       .
      536       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      537       on error undo, return error
      538       :
      539         assign
      540           v-inform = bh_tbl-name:index-information( v-ind )
      541           v-ind    = v-ind + 1
      542         .
      543       end.
      544       if v-inform = ?
      545         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      546         or entry( 3, v-inform, ",":U ) <> "1":U
      547       then do:
      548         delete object bh_tbl-name no-error.
      549         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info3, vTable ).
      550       end.
      551       assign
      552         v-idx-field-qnty = num-entries( v-inform ) - 4
      553       .
      554       if v-idx-field-qnty < 2 then do:
      555         delete object bh_tbl-name no-error.
      556         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, vTable ).
      557       end.
      558       assign
      559         o-where     = "where":U
      560         v-word-link = "":U
      561         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      562         v-count-fld = 0
      563       .
      564       if i-tablekey ne "" and i-tablekey ne ?
      565       then do:
      566         assign
      567           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      568         .
      569         create buffer bh_tbl-key for table v-full-tbl-name .
      570       end.
      571       if i-tableSerach ne "" and i-tableSerach ne ?
      572       then do:
      573         delete object bh_tbl-name no-error.
      574         assign
      575           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      576         .
      577         create buffer bh_tbl-name for table v-full-tbl-name .
      578       end.
      579       block_where:
      580       do v-ind = 1 to v-idx-field-qnty by 2
      581       on error undo, return error
      582       :
      583         assign
      584           v-count-fld = v-count-fld + 1
      585         .
      586         if p-key-handle = ?
      587           and v-count-fld > v-field-num
      588         then do:
      589           leave block_where.
      590         end.
      591         define variable VfieldKeyTable as handle no-undo.
      592         assign
      593           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      594           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      595         .
      596         if     bh_tbl-key ne ?
      597         then do:
      598            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      599            if VfieldKeyTable eq ?
      600            then next block_where.
      601         end.
      602         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      603         then
      604            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      605         else
      606            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      607         if p-key-handle = ? then do:
      608           assign
      609             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      610           .
      611         end.
      612         else do:
      613           assign
      614             fh_key = p-key-handle:buffer-field( v-field-name )
      615           .
      616           if fh_key = ?
      617             or not valid-handle( fh_key )
      618           then do:
      619             delete object bh_tbl-name.
      620             if     bh_tbl-key ne ?
      621             then
      622                delete object bh_tbl-key.
      623             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info3, p-key-handle:name, v-field-name ).
      624           end.
      625           assign
      626             v-field-val = fh_key:buffer-value
      627           .
      628         end.
      629         if fh_search:data-type ="character":U then do:
      630           assign
      631             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      632             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      633             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      634             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      635             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      636             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      637             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      638             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      639             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      640             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      641             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      642             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      643             v-field-val = substitute( '"&1"', v-field-val )
      644           .
      645         end.
      646         assign
      647           o-where = substitute( "&1 &2", o-where, v-field-val )
      648         .
      649         if v-word-link = "":U then do:
      650           assign
      651             v-word-link = "and":U
      652           .
      653         end.
      654       end.
      655       delete object bh_tbl-name.
      656       if     bh_tbl-key ne ?
      657       then
      658          delete object bh_tbl-key.
      659       if p-key-handle = ?
      660         and v-count-fld <> v-field-num
      661       then do:
      662         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info3, vTable ).
      663       end.
      664     end.
      665   end procedure.
      666   procedure gen-hn-keyr-tab :
      667     define input  parameter i-tableSerach as character no-undo.
      668     define input  parameter i-tablekey   as character no-undo.
      669     define input  parameter p-key-rec    as character no-undo.
      670     define input  parameter p-key-handle as handle    no-undo .
      671     define input  parameter p-db-name    as character no-undo .
      672     define input  parameter p-tt-handle  as handle    no-undo .
      673     define input  parameter p-stts-lock  as integer   no-undo .
      674     define output parameter o-hn         as handle    no-undo.
      675     define variable v-full-tbl-name as character no-undo.
      676     define variable v-where         as character no-undo.
      677     define variable bh_tbl-name     as handle    no-undo.
      678     define variable vTable          as character no-undo.
      679     do
      680     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      681     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      682     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      683         run gen-where-keyr-tab(i-tableSerach,
      684                                i-tablekey,
      685                                p-key-rec,
      686                                p-key-handle,
      687                                p-db-name,
      688                                p-tt-handle,
      689                                output v-where).
      690         if i-tableSerach ne "" and i-tableSerach ne ?
      691         then do:
      692            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      693            create buffer bh_tbl-name for table v-full-tbl-name .
      694         end.
      695         else do:
      696            if p-tt-handle = ? then do:
      697               assign
      698                  vTable = entry( 1 , p-key-rec, chr(3) )
      699               .
      700               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      701               create buffer bh_tbl-name for table v-full-tbl-name .
      702            end.
      703            else do:
      704               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      705            end.
      706         end.
      707         if p-tt-handle = ? then do:
      708            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      709         end.
      710         else do:
      711            bh_tbl-name:find-first( v-where ) no-error .
      712         end.
      713         o-hn = bh_tbl-name.
      714      end.
      715   end procedure.
      716   procedure gen-hn-keyr :
      717     define input  parameter p-key-rec    as character no-undo.
      718     define input  parameter p-key-handle as handle    no-undo .
      719     define input  parameter p-db-name    as character no-undo .
      720     define input  parameter p-tt-handle  as handle    no-undo .
      721     define input  parameter p-stts-lock  as integer   no-undo .
      722     define output parameter o-hn         as handle    no-undo.
      723     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      724   end.
      725   procedure gen-row-keyr :
      726     define input  parameter p-key-rec    as character no-undo.
      727     define input  parameter p-key-handle as handle    no-undo .
      728     define input  parameter p-db-name    as character no-undo .
      729     define input  parameter p-tt-handle  as handle    no-undo .
      730     define input  parameter p-stts-lock  as integer   no-undo .
      731     define output parameter p-tbl-row    as rowid     no-undo.
      732     define output parameter p-tbl-name   as character no-undo.
      733     define variable vHn as handle no-undo.
      734       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      735       p-tbl-row = if vHn:available then vHn:rowid else ?.
      736       p-tbl-name =  vHn:table.
      737       delete object vHn no-error.
      738     if p-tbl-row = ? then do:
      739       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info3, p-tbl-name, p-key-rec ).
      740     end.
      741     else do:
      742       return.
      743     end.
      744   end procedure.
      745   procedure gen-key-fv :
      746     define input  parameter p-key-rec    as character no-undo .
      747     define output parameter p-field-list as character no-undo .
      748     define output parameter p-value-list as character no-undo.
      749     do
      750     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      751     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      752     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      753     :
      754       define variable v-full-tbl-name  as character no-undo .
      755       define variable bh_tbl-name      as handle    no-undo .
      756       define variable v-tbl-name       as character no-undo .
      757       define variable v-field-num      as integer   no-undo .
      758       define variable v-count-fld      as integer   no-undo .
      759       define variable v-inform         as character no-undo .
      760       define variable v-ind            as integer   no-undo .
      761       define variable v-idx-field-qnty as integer   no-undo .
      762       define variable v-delim-key      as character no-undo .
      763       if p-key-rec = ?
      764         or p-key-rec = "":U
      765       then do:
      766         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      767       end.
      768       assign
      769         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      770         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      771       .
      772       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      773       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info3 ).
      774       assign
      775         v-inform = bh_tbl-name:index-information(1)
      776         v-ind    = 2
      777       .
      778       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      779       on error undo, return error
      780       :
      781         assign
      782           v-inform = bh_tbl-name:index-information( v-ind )
      783           v-ind    = v-ind + 1
      784         .
      785       end.
      786       if v-inform = ?
      787         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      788         or entry( 3, v-inform, ",":U ) <> "1":U
      789       then do:
      790         delete object bh_tbl-name no-error.
      791         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
      792       end.
      793       assign
      794         v-idx-field-qnty = num-entries( v-inform ) - 4
      795       .
      796       if v-idx-field-qnty < 2 then do:
      797         delete object bh_tbl-name no-error.
      798         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
      799       end.
      800       assign
      801         p-field-list = "":U
      802         p-value-list = "":U
      803         v-delim-key  = "":U
      804         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      805         v-count-fld  = 0
      806       .
      807       block_where:
      808       do v-ind = 1 to v-idx-field-qnty by 2
      809       on error undo, return error
      810       :
      811         assign
      812           v-count-fld = v-count-fld + 1
      813         .
      814         if v-count-fld > v-field-num then do:
      815           leave block_where.
      816         end.
      817         assign
      818           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      819           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      820         .
      821         if v-ind = 1 then do:
      822           assign
      823             v-delim-key = chr(3)
      824           .
      825         end.
      826       end.
      827       delete object bh_tbl-name.
      828       if v-count-fld <> v-field-num then do:
      829         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info3, v-tbl-name ).
      830       end.
      831     end.
      832   end procedure.
      833   procedure gen-key-field :
      834     define input  parameter p-table      as character no-undo .
      835     define output parameter p-field-list as character no-undo .
      836     do
      837     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      838     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      839     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      840     :
      841       define variable v-full-tbl-name  as character no-undo .
      842       define variable bh_tbl-name      as handle    no-undo .
      843       define variable v-tbl-name       as character no-undo .
      844       define variable v-field-num      as integer   no-undo .
      845       define variable v-count-fld      as integer   no-undo .
      846       define variable v-inform         as character no-undo .
      847       define variable v-ind            as integer   no-undo .
      848       define variable v-idx-field-qnty as integer   no-undo .
      849       define variable v-delim-key      as character no-undo .
      850       if p-table = ?
      851         or p-table = "":U
      852       then do:
      853         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info3 ).
      854       end.
      855       assign
      856         v-tbl-name      = p-table
      857         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      858       .
      859       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      860       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info3 ).
      861       assign
      862         v-inform = bh_tbl-name:index-information(1)
      863         v-ind    = 2
      864       .
      865       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      866       on error undo, return error
      867       :
      868         assign
      869           v-inform = bh_tbl-name:index-information( v-ind )
      870           v-ind    = v-ind + 1
      871         .
      872       end.
      873       if v-inform = ?
      874         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      875         or entry( 3, v-inform, ",":U ) <> "1":U
      876       then do:
      877         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
      878       end.
      879       assign
      880         v-idx-field-qnty = num-entries( v-inform ) - 4
      881       .
      882       if v-idx-field-qnty < 2 then do:
      883         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
      884       end.
      885       assign
      886         p-field-list = "":U
      887         v-delim-key  = "":U
      888         v-count-fld  = 0
      889       .
      890       block_where:
      891       do v-ind = 1 to v-idx-field-qnty by 2
      892       on error undo, return error
      893       :
      894         assign
      895           v-count-fld = v-count-fld + 1
      896         .
      897         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      898         if v-ind = 1 then do:
      899           assign
      900             v-delim-key = chr(3)
      901           .
      902         end.
      903       end.
      904       delete object bh_tbl-name.
      905     end.
      906   end procedure.
      907   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      908   FUNCTION mark-string RETURNS CHARACTER
      909     ( input p-recid as recid, input mark-list as character  ) :
      910     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      911   END FUNCTION.
      912   DEFINE VARIABLE v-doc-rec AS RECID NO-UNDO.
      913   DEFINE VARIABLE link-option AS CHARACTER NO-UNDO.
      914   define temp-table tt0-rule-call-param no-undo like ub.rule-call-param.
      915   define variable v-rid-list as character no-undo .
      916   define variable v-return-value as character no-undo .
      917   DEFINE MENU MENU-b-links
      918          MENU-ITEM m_rule-call-param LABEL "ЗАДАННЫЕ Параметры".
      919   DEFINE BUTTON b-add
      920        LABEL "&Добавить"
      921        SIZE 10 BY 1.
      922   DEFINE BUTTON b-chg
      923        LABEL "&Изменить"
      924        SIZE 10 BY 1.
      925   DEFINE BUTTON b-del
      926        LABEL "&Удалить"
      927        SIZE 10 BY 1.
      928   DEFINE BUTTON b-exit AUTO-GO
      929        LABEL "&Ввод"
      930        SIZE 10 BY 1.
      931   DEFINE BUTTON B-Help
      932        LABEL "Помо&щь"
      933        SIZE 2 BY 1
      934        BGCOLOR 8 .
      935   DEFINE BUTTON b-links
      936        LABEL "Связи"
      937        SIZE 10 BY 1.
      938   DEFINE BUTTON b-lkp
      939        LABEL "&Просмотр"
      940        SIZE 10 BY 1.
      941   DEFINE BUTTON b-mark
      942        LABEL "&*"
      943        SIZE 4 BY 1.
      944   DEFINE BUTTON b-quit AUTO-END-KEY
      945        LABEL "&Отмена"
      946        SIZE 10 BY 1
      947        BGCOLOR 8 .
      948   DEFINE BUTTON b-sel AUTO-GO
      949        LABEL "Выбор"
      950        SIZE 10 BY 1.
      951   DEFINE VARIABLE mark-num AS INTEGER FORMAT "->,>>>,>>9":U INITIAL 0
      952         VIEW-AS TEXT
      953        SIZE 8 BY .67
      954        FGCOLOR 10  NO-UNDO.
      955   DEFINE QUERY br-ruledict-param FOR
      956         X_ruledict-param SCROLLING.
      957   DEFINE QUERY br-tt-ruledict-param FOR
      958         tt-ruledict-param SCROLLING.
      959   DEFINE BROWSE br-ruledict-param
      960     QUERY br-ruledict-param NO-LOCK DISPLAY
      961         mark-string(recid(X_ruledict-param), v-rid-list) Format "X(1)" COLUMN-LABEL "*"
      962   X_ruledict-param.entry-id COLUMN-LABEL "ID" FORMAT ">>>>>>>>9"
      963   X_ruledict-param.param-num COLUMN-LABEL "№ пар-ра" FORMAT ">>>>>>>>9"
      964   X_ruledict-param.param-data-type COLUMN-LABEL "Тип" FORMAT "X(16)"
      965   X_ruledict-param.param-2-data-type COLUMN-LABEL "Тип2" FORMAT "X(16)"
      966   X_ruledict-param.param-3-data-type COLUMN-LABEL "Тип3" FORMAT "X(16)"
      967   X_ruledict-param.param-mode COLUMN-LABEL "Мода" FORMAT "X(16)"
      968   X_ruledict-param.param-name COLUMN-LABEL "Название" FORMAT "X(255)" WIDTH 60
      969   X_ruledict-param.param-label COLUMN-LABEL "Название" FORMAT "X(255)" WIDTH 60
      970       WITH NO-ROW-MARKERS SEPARATORS SIZE 97 BY 20.54 ROW-HEIGHT-CHARS .6 FIT-LAST-COLUMN.
      971   DEFINE BROWSE br-tt-ruledict-param
      972     QUERY br-tt-ruledict-param NO-LOCK DISPLAY
      973         mark-string(recid(tt-ruledict-param), v-rid-list) Format "X(1)" COLUMN-LABEL "*"
      974   tt-ruledict-param.entry-id COLUMN-LABEL "ID" FORMAT ">>>>>>>>9"
      975   tt-ruledict-param.param-num COLUMN-LABEL "№ пар-ра" FORMAT ">>>>>>>>9"
      976   tt-ruledict-param.param-data-type COLUMN-LABEL "Тип" FORMAT "X(16)"
      977   tt-ruledict-param.param-2-data-type COLUMN-LABEL "Тип2" FORMAT "X(16)"
      978   tt-ruledict-param.param-3-data-type COLUMN-LABEL "Тип3" FORMAT "X(16)"
      979   tt-ruledict-param.param-mode COLUMN-LABEL "Мода" FORMAT "X(16)"
      980   tt-ruledict-param.param-name COLUMN-LABEL "Название" FORMAT "X(255)" WIDTH 60
      981   tt-ruledict-param.param-label COLUMN-LABEL "Название" FORMAT "X(255)" WIDTH 60
      982       WITH NO-ROW-MARKERS SEPARATORS SIZE 97 BY 20.54 ROW-HEIGHT-CHARS .6 FIT-LAST-COLUMN.
      983   DEFINE FRAME Dialog-Frame
      984        b-exit AT ROW 1 COL 1 WIDGET-ID 18
      985        b-quit AT ROW 1 COL 11
      986        b-mark AT ROW 1 COL 30 WIDGET-ID 12
      987        b-sel AT ROW 1 COL 34 WIDGET-ID 10
      988        b-add AT ROW 1 COL 44 WIDGET-ID 2
      989        b-chg AT ROW 1 COL 54 WIDGET-ID 4
      990        b-del AT ROW 1 COL 64 WIDGET-ID 8
      991        b-lkp AT ROW 1 COL 74 WIDGET-ID 6
      992        b-links AT ROW 1 COL 84 WIDGET-ID 16
      993        B-Help AT ROW 1 COL 96
      994        br-tt-ruledict-param AT ROW 2.33 COL 1.5 WIDGET-ID 200
      995        br-ruledict-param AT ROW 2.33 COL 1.5 WIDGET-ID 100
      996        mark-num AT ROW 1 COL 20 COLON-ALIGNED NO-LABEL WIDGET-ID 14
      997        SPACE(68.50) SKIP(21.20)
      998       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      999            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1000            TITLE ""
     1001            CANCEL-BUTTON b-quit.
     1002   ASSIGN
     1003          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1004          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1005   ASSIGN
     1006          b-links:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-b-links:HANDLE.
     1007   ON GO OF FRAME Dialog-Frame
     1008   DO:
     1009   define buffer buf_tt-ruledict-param for tt-ruledict-param.
     1010    p-rid-list = v-rid-list.
     1011    if p-list-mode = 'ИЗМЕНЕНИЕ':U then do:
     1012      for each buf_tt-ruledict-param
     1013        BY buf_tt-ruledict-param.param-num
     1014        :
     1015        run save-tt-ruledict-param in p-update-proc-handle ( input buffer buf_tt-ruledict-param:handle) no-error .
     1016        if error-status:error then do:
     1017          MESSAGE
     1018          substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1019          VIEW-AS ALERT-BOX ERROR.
     1020          RETURN no-apply.
     1021        end.
     1022       end.
     1023     end.
     1024   END.
     1025   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1026   DO:
     1027     assign
     1028     v-return-value = "quit".
     1029     APPLY "END-ERROR":U TO SELF.
     1030   END.
     1031   ON CHOOSE OF b-add IN FRAME Dialog-Frame
     1032   DO:
     1033    define variable v-rec as recid no-undo.
     1034    if p-list-mode = 'ИЗМЕНЕНИЕ':U then do:
     1035      v-rec = recid(tt-ruledict-param).
     1036    end.
     1037    else do:
     1038      v-rec = recid(X_ruledict-param).
     1039    end.
     1040     run rul/ruledict-param-i.w ( input parparentproc
     1041                          ,input this-procedure:handle
     1042                          ,input 'ДОБАВЛЕНИЕ':U
     1043                          ,input p-entry-id
     1044                          ,input (if p-list-mode = 'ИЗМЕНЕНИЕ':U
     1045                                  then p-entry-type
     1046                                  else '':U)
     1047                          ,input '':U
     1048                          ,input 0
     1049                          ,input-output v-rec) no-error.
     1050     if v-rec <> ? then do:
     1051       RUN openbr IN THIS-PROCEDURE.
     1052     end.
     1053   END.
     1054   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
     1055   DO:
     1056     define variable v-rec as recid no-undo.
     1057     if p-list-mode = 'ИЗМЕНЕНИЕ':U then do:
     1058       if not available tt-ruledict-param then return no-apply.
     1059       v-rec = recid(tt-ruledict-param).
     1060       run rul/ruledict-param-i.w ( input parparentproc
     1061                           ,input this-procedure:handle
     1062                           ,input 'ИЗМЕНЕНИЕ':U
     1063                           ,input tt-ruledict-param.entry-id
     1064                           ,input p-entry-type
     1065                           ,input tt-ruledict-param.language
     1066                           ,input tt-ruledict-param.param-num
     1067                           ,input-output v-rec) no-error.
     1068       if v-rec <> ? then do:
     1069         br-tt-ruledict-param:refresh().
     1070       end.
     1071     end.
     1072     else do:
     1073       if not available X_ruledict-param then return no-apply.
     1074       v-rec = recid(X_ruledict-param).
     1075       run rul/ruledict-param-i.w ( input parparentproc
     1076                           ,input ?
     1077                           ,input 'ИЗМЕНЕНИЕ':U
     1078                           ,input X_ruledict-param.entry-id
     1079                           ,input '':U
     1080                           ,input X_ruledict-param.language
     1081                           ,input X_ruledict-param.param-num
     1082                           ,input-output v-rec) no-error.
     1083       if v-rec <> ? then do:
     1084         br-ruledict-param:refresh().
     1085       end.
     1086     end.
     1087   END.
     1088   ON CHOOSE OF b-del IN FRAME Dialog-Frame
     1089   DO:
     1090     define variable v-rec as recid no-undo.
     1091     define variable glog as logical no-undo.
     1092     if p-list-mode = 'ИЗМЕНЕНИЕ':U then do:
     1093       if not available tt-ruledict-param then return no-apply.
     1094       v-rec = recid(tt-ruledict-param).
     1095       message "Вы уверены, что хотите удалить параметр?"
     1096       view-as alert-box question buttons yes-no update glog.
     1097       if not glog then return no-apply.
     1098       delete tt-ruledict-param.
     1099     end.
     1100     else do:
     1101       if not available X_ruledict-param then return no-apply.
     1102       v-rec = recid(X_ruledict-param).
     1103       message "Вы уверены, что хотите удалить параметр?"
     1104       view-as alert-box question buttons yes-no update glog.
     1105       if not glog then return no-apply.
     1106       run rul/ruledict-param3.p ( input no
     1107                           ,input v-rec
     1108                           ) no-error.
     1109    end.
     1110    if error-status:error then return no-apply.
     1111    run OpenBr in this-procedure .
     1112   END.
     1113   ON CHOOSE OF b-links IN FRAME Dialog-Frame
     1114   DO:
     1115   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     1116   if p-list-mode = 'ИЗМЕНЕНИЕ':U then do:
     1117     IF NOT AVAILABLE tt-ruledict-param THEN RETURN NO-APPLY.
     1118   end.
     1119   else do:
     1120     IF NOT AVAILABLE X_ruledict-param THEN RETURN NO-APPLY.
     1121   end.
     1122   IF link-option = '':U THEN DO:
     1123     run gbl/pop-up.p ( input self :handle, input no ) no-error.
     1124     if error-status :error then do: return no-apply. end.
     1125   END.
     1126   if link-option = "":U then do:
     1127      return no-apply.
     1128   end.
     1129   RUN proc-b-link IN THIS-PROCEDURE ( INPUT link-option) NO-ERROR.
     1130   IF ERROR-STATUS:ERROR THEN DO:
     1131     link-option = '':U.
     1132     RETURN NO-APPLY.
     1133    END.
     1134   link-option = '':U.
     1135   END.
     1136   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
     1137   DO:
     1138     define variable v-rec as recid no-undo.
     1139     if p-list-mode = 'ИЗМЕНЕНИЕ':U then do:
     1140       if not available tt-ruledict-param then return no-apply.
     1141       v-rec = recid(tt-ruledict-param).
     1142       run rul/ruledict-param-i.w ( input parparentproc
     1143                           ,input this-procedure:handle
     1144                           ,input 'ПРОСМОТР':U
     1145                           ,input tt-ruledict-param.entry-id
     1146                           ,input p-entry-type
     1147                           ,input tt-ruledict-param.language
     1148                           ,input tt-ruledict-param.param-num
     1149                           ,input-output v-rec) no-error.
     1150     end.
     1151     else do:
     1152       if not available X_ruledict-param then return no-apply.
     1153       v-rec = recid(X_ruledict-param).
     1154       run rul/ruledict-param-i.w ( input parparentproc
     1155                           ,input ?
     1156                           ,input 'ПРОСМОТР':U
     1157                           ,input X_ruledict-param.entry-id
     1158                           ,input '':U
     1159                           ,input X_ruledict-param.language
     1160                           ,input X_ruledict-param.param-num
     1161                           ,input-output v-rec) no-error.
     1162     end.
     1163   END.
     1164   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
     1165   DO:
     1166   define variable glog as logical no-undo .
     1167   if p-list-mode = 'ИЗМЕНЕНИЕ':U then do:
     1168     if available tt-ruledict-param then do:
     1169   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1170   define variable v-str-recid6 as character no-undo .
     1171   define variable v-num-entry6 as integer   no-undo .
     1172   assign
     1173     v-str-recid6 = trim( string( recid( tt-ruledict-param ) , "->>>>>>>>>>>9":U ) )
     1174     v-num-entry6 = lookup( v-str-recid6 , v-rid-list )
     1175   .
     1176   if v-num-entry6 > 0 then do:
     1177     assign
     1178       entry( v-num-entry6, v-rid-list ) = "":U
     1179       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1180     .
     1181   end.
     1182   else do:
     1183     assign
     1184       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid6
     1185     .
     1186   end.
     1187       glog = br-tt-ruledict-param:refresh() .
     1188       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1189           glog = br-tt-ruledict-param:select-next-row ().
     1190           apply "VALUE-CHANGED" to br-tt-ruledict-param in frame Dialog-Frame.
     1191       end.
     1192       if num-entries( v-rid-list ) = 0
     1193       then
     1194           hide mark-num in frame Dialog-Frame.
     1195       else
     1196           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1197     end.
     1198   end.
     1199   else do:
     1200     if available X_ruledict-param then do:
     1201   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1202   define variable v-str-recid8 as character no-undo .
     1203   define variable v-num-entry8 as integer   no-undo .
     1204   assign
     1205     v-str-recid8 = trim( string( recid( X_ruledict-param ) , "->>>>>>>>>>>9":U ) )
     1206     v-num-entry8 = lookup( v-str-recid8 , v-rid-list )
     1207   .
     1208   if v-num-entry8 > 0 then do:
     1209     assign
     1210       entry( v-num-entry8, v-rid-list ) = "":U
     1211       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1212     .
     1213   end.
     1214   else do:
     1215     assign
     1216       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid8
     1217     .
     1218   end.
     1219       glog = br-ruledict-param:refresh() .
     1220       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1221           glog = br-ruledict-param:select-next-row ().
     1222           apply "VALUE-CHANGED" to br-ruledict-param in frame Dialog-Frame.
     1223       end.
     1224       if num-entries( v-rid-list ) = 0
     1225       then
     1226           hide mark-num in frame Dialog-Frame.
     1227       else
     1228           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1229     end.
     1230   end.
     1231   apply "entry" to br-ruledict-param in frame Dialog-Frame.
     1232   END.
     1233   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
     1234   DO:
     1235     v-return-value = "quit".
     1236   END.
     1237   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     1238   DO:
     1239   if p-list-mode = 'ИЗМЕНЕНИЕ':U then do:
     1240     if available tt-ruledict-param then do:
     1241       if  ( v-rid-list = "" ) or b-mark:sensitive = no
     1242       then  v-rid-list = string( recid( tt-ruledict-param ) ) .
     1243     end.
     1244   end.
     1245   else do:
     1246     if available X_ruledict-param then do:
     1247       if  ( v-rid-list = "" ) or b-mark:sensitive = no
     1248       then  v-rid-list = string( recid( X_ruledict-param ) ) .
     1249     end.
     1250   end.
     1251   END.
     1252   ON CHOOSE OF MENU-ITEM m_rule-call-param
     1253   DO:
     1254   if p-list-mode = 'ИЗМЕНЕНИЕ':U then do:
     1255     IF NOT AVAILABLE tt-ruledict-param THEN RETURN NO-APPLY.
     1256   end.
     1257   else do:
     1258     IF NOT AVAILABLE X_ruledict-param THEN RETURN NO-APPLY.
     1259   end.
     1260   RUN proc-b-link IN THIS-PROCEDURE ( INPUT 'rule-call-param':U) NO-ERROR.
     1261   IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1262   END.
     1263   ON ROW-DISPLAY OF br-ruledict-param IN frame Dialog-Frame
     1264   DO:
     1265   if p-list-mode = 'ИЗМЕНЕНИЕ':U then do:
     1266     IF AVAIL tt-ruledict-param THEN DO:
     1267       RUN set-row-color IN this-procedure  ( INPUT tt-ruledict-param.param-data-type).
     1268     END.
     1269   end.
     1270   else do:
     1271     IF AVAIL X_ruledict-param THEN DO:
     1272       RUN set-row-color IN this-procedure  ( INPUT X_ruledict-param.param-data-type).
     1273     END.
     1274   end.
     1275   END.
     1276   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1277   on f5 of frame Dialog-Frame anywhere
     1278   do:
     1279     RUN brwrefre IN THIS-PROCEDURE NO-ERROR.
     1280       apply "VALUE-CHANGED" to br-ruledict-param.
     1281   end.
     1282   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1283   on help of frame Dialog-Frame
     1284   do:
     1285     run gbl/app_help.p
     1286       (input this-procedure :file-name
     1287       ,input ''
     1288       ,input ?
     1289       ) no-error.
     1290     if error-status :error then do:
     1291       message
     1292         "Ошибка при вызове помощи"
     1293         error-status :get-message(1)
     1294         view-as alert-box .
     1295     end.
     1296   end.
     1297   run minbtn-set in this-procedure .
     1298   on choose of b-help in frame Dialog-Frame
     1299   do:
     1300     apply "help":u to frame Dialog-Frame .
     1301   end.
     1302   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1303   procedure minbtn-set :
     1304       do
     1305           on error undo, return error return-value
     1306           :
     1307           define variable ii              as integer       no-undo .
     1308           define variable fh              as widget-handle no-undo .
     1309           define variable hh              as widget-handle no-undo .
     1310           define variable v-h             as handle        extent 4 no-undo .
     1311           define variable v-name-button   as character     no-undo .
     1312           define variable v-help-old-x    as decimal       no-undo .
     1313           define variable v-help-old-y    as decimal       no-undo .
     1314           define variable v-help-old-size as decimal       no-undo .
     1315           define variable v-frame-width   as decimal       no-undo .
     1316           define variable jj              as integer       no-undo .
     1317           do
     1318               on error undo, return error
     1319               :
     1320               assign
     1321                   v-frame-width = frame Dialog-Frame:width - 0.3
     1322                   fh            = frame Dialog-Frame:first-child
     1323                   hh            = fh:first-child
     1324                   ii            = 1
     1325                   .
     1326               do while valid-handle(hh):
     1327                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1328                   do:
     1329                       case lc(hh:name) :
     1330                           when "b-help" then
     1331                               do:
     1332                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1333                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1334                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1335                                   hh:TOOLTIP = "Помощь" .
     1336                                   v-help-old-x = hh:column .
     1337                                   v-help-old-y = hh:row    .
     1338                                   v-help-old-size = hh:width .
     1339                                   hh:width-chars = 2.5 .
     1340                               end.
     1341                           when "b-print" then
     1342                               do:
     1343                                   hh:load-image("cmp/b-print.bmp":u) .
     1344                                   hh:TOOLTIP = "Печать" .
     1345                                   v-h[ii] = hh:handle .
     1346                                   ii = ii + 1 .
     1347                                   hh:width-chars = 3 .
     1348                               end.
     1349                           when "b-history" or
     1350                           when "b-hist" then
     1351                               do:
     1352                                   hh:load-image("cmp/b-hist.bmp":u) .
     1353                                   hh:TOOLTIP = "История" .
     1354                                   v-h[ii] = hh:handle .
     1355                                   ii = ii + 1 .
     1356                                   hh:width-chars = 3 .
     1357                               end.
     1358                           when "b-sch" then
     1359                               do:
     1360                                   hh:load-image("cmp/b-sch.bmp":u) .
     1361                                   hh:TOOLTIP = "Установка Фильтра" .
     1362                                   v-h[ii] = hh:handle .
     1363                                   ii = ii + 1 .
     1364                                   hh:width-chars = 3 .
     1365                               end.
     1366                           when "b-hist-user" then
     1367                               do:
     1368                                   hh:load-image("cmp/b-hist.bmp":u) .
     1369                                   hh:TOOLTIP = "История пользователя" .
     1370                                   ii = ii + 1 .
     1371                               end.
     1372                       end case.
     1373                   end.
     1374                   hh = hh:next-sibling.
     1375               end.
     1376               b-help:column = v-frame-width - b-help:width-chars.
     1377               jj = 0.
     1378               repeat ii = 4 to 1 by -1 :
     1379                   if valid-handle (v-h[ii] ) then
     1380                   do:
     1381                       jj  = jj + 1 .
     1382                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1383                       v-h[ii]:row    = v-help-old-y .
     1384                   end.
     1385               end.
     1386           end.
     1387       end.
     1388   end procedure.
     1389   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1390   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1391   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1392   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1393   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1394   define variable v-diasize-current-frame-height as decimal   no-undo .
     1395   define variable v-diasize-change-size          as logical   no-undo .
     1396   define variable v-diasize-resize-button        as handle    no-undo .
     1397   define variable v-diasize-wndmax               as logical   no-undo .
     1398   define variable v-diasize-wndstore             as logical   no-undo .
     1399   define variable v-diasize-proc-name            as character no-undo .
     1400   define variable v-diasize-browse-handle        as handle    no-undo .
     1401   define variable v-diasize-browse-number        as integer   no-undo .
     1402   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1403   define temp-table temp-diasize-handle no-undo
     1404     field handle-value  as handle
     1405     field save-position as decimal
     1406     index xpk is primary unique handle-value
     1407     .
     1408   define temp-table temp-browse-handle no-undo
     1409     field browse-type   as character
     1410     field browse-number as integer
     1411     field browse-handle as handle
     1412     field original-size as decimal
     1413     index xpk is primary unique browse-type browse-number
     1414     index xie browse-type browse-handle
     1415   .
     1416   procedure diasize_change-height :
     1417     define input  parameter p-change-value  as decimal   no-undo .
     1418     define input  parameter p-move-resize   as logical   no-undo .
     1419     define variable v-field-group-handle    as handle    no-undo .
     1420     define variable v-object-handle         as handle    no-undo .
     1421     define variable v-frame-height          as decimal   no-undo .
     1422     define variable v-frame-virtual-height  as decimal   no-undo .
     1423     define variable v-browse-height         as decimal   no-undo .
     1424     define variable v-window-height         as decimal   no-undo .
     1425     define variable v-window-virtual-height as decimal   no-undo .
     1426     define variable v-change-sign           as integer   no-undo .
     1427     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1428     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1429     if p-change-value > 0
     1430     then do:
     1431       if frame Dialog-Frame :height + p-change-value
     1432           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1433       then do:
     1434         assign
     1435           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1436                           - (frame Dialog-Frame :height-chars)
     1437         .
     1438         if p-change-value <= 0
     1439         then do:
     1440           run diasize_position-resize-button in this-procedure .
     1441           return .
     1442         end.
     1443       end.
     1444     end.
     1445     if p-change-value < 0
     1446     then do:
     1447       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1448       then do:
     1449         assign
     1450           p-change-value = v-diasize-orig-frame-height
     1451                          - (frame Dialog-Frame :height-chars)
     1452         .
     1453         if p-change-value >= 0
     1454         then do:
     1455           run diasize_position-resize-button in this-procedure .
     1456           return .
     1457         end.
     1458       end.
     1459     end.
     1460     if p-change-value >= 0
     1461     then do:
     1462       assign
     1463         v-change-sign = 1
     1464       .
     1465     end.
     1466     else do:
     1467       assign
     1468         v-change-sign = -1
     1469       .
     1470     end.
     1471     assign
     1472       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1473     .
     1474     if p-change-value = 0
     1475     then do:
     1476       run diasize_position-resize-button in this-procedure .
     1477       return .
     1478     end.
     1479     move_block:
     1480     do
     1481     on error undo move_block, retry move_block
     1482     :
     1483       if retry
     1484       then do:
     1485         do
     1486         on error undo move_block, leave move_block
     1487         :
     1488           if p-change-value > 0
     1489           then do:
     1490             for each buf_temp-diasize-handle
     1491             on error undo, next
     1492             :
     1493               assign
     1494                 v-object-handle = buf_temp-diasize-handle.handle-value
     1495               .
     1496               if v-object-handle <> v-diasize-resize-button
     1497               then do:
     1498                 assign
     1499                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1500                 .
     1501               end.
     1502             end.
     1503             assign
     1504               v-diasize-browse-handle :height = v-browse-height
     1505             .
     1506             for each buf_temp-browse-handle
     1507               where buf_temp-browse-handle.browse-type = 'height':u
     1508             on error undo, next
     1509             :
     1510               assign
     1511                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1512               .
     1513             end.
     1514             assign
     1515               frame Dialog-Frame :height = v-frame-height
     1516             .
     1517             if frame Dialog-Frame :scrollable = true
     1518             then do:
     1519               assign
     1520                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1521               .
     1522             end.
     1523             run diasize_position-resize-button in this-procedure .
     1524           end.
     1525           else do:
     1526             if frame Dialog-Frame :scrollable = true
     1527             then do:
     1528               assign
     1529                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1530               .
     1531             end.
     1532             assign
     1533               frame Dialog-Frame :height = v-frame-height
     1534             .
     1535             assign
     1536               v-diasize-browse-handle :height = v-browse-height
     1537             .
     1538             for each buf_temp-browse-handle
     1539               where buf_temp-browse-handle.browse-type = 'height':u
     1540             on error undo, next
     1541             :
     1542               assign
     1543                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1544               .
     1545             end.
     1546             for each buf_temp-diasize-handle
     1547             on error undo, next
     1548             :
     1549               assign
     1550                 v-object-handle = buf_temp-diasize-handle.handle-value
     1551               .
     1552               if v-object-handle <> v-diasize-resize-button
     1553               then do:
     1554                 assign
     1555                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1556                 .
     1557               end.
     1558             end.
     1559             run diasize_position-resize-button in this-procedure .
     1560           end.
     1561           assign
     1562             v-diasize-change-size = false
     1563           .
     1564           leave move_block .
     1565         end.
     1566       end.
     1567       assign
     1568         v-diasize-need-full-display = true
     1569       .
     1570       if v-diasize-change-size = false
     1571       then do:
     1572         assign
     1573           v-diasize-change-size = true
     1574         .
     1575       end.
     1576       else do:
     1577         return .
     1578       end.
     1579       assign
     1580         v-frame-height = frame Dialog-Frame :height
     1581         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1582         v-browse-height = v-diasize-browse-handle :height
     1583       .
     1584       for each buf_temp-browse-handle
     1585         where buf_temp-browse-handle.browse-type = 'height':u
     1586       :
     1587         assign
     1588           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1589         .
     1590       end.
     1591       for each buf_temp-diasize-handle
     1592       :
     1593         delete buf_temp-diasize-handle .
     1594       end.
     1595       assign
     1596         v-field-group-handle = frame Dialog-Frame :first-child
     1597       .
     1598       do while valid-handle(v-field-group-handle)
     1599       :
     1600         assign
     1601           v-object-handle = v-field-group-handle :first-child
     1602         .
     1603         do while valid-handle(v-object-handle)
     1604         :
     1605           if  v-object-handle <> v-diasize-browse-handle :handle
     1606           and can-query(v-object-handle, "row")
     1607           and can-query(v-object-handle, "height")
     1608           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1609           then do:
     1610             find first buf_temp-browse-handle
     1611               where buf_temp-browse-handle.browse-type   = 'height':u
     1612                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1613               no-error .
     1614             if available buf_temp-browse-handle
     1615             then do:
     1616             end.
     1617             else do:
     1618               create buf_temp-diasize-handle .
     1619               assign
     1620                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1621                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1622               .
     1623             end.
     1624           end.
     1625           assign
     1626             v-object-handle = v-object-handle :next-sibling
     1627           .
     1628         end.
     1629         assign
     1630           v-field-group-handle = v-field-group-handle :next-sibling
     1631         .
     1632       end.
     1633       do with frame Dialog-Frame
     1634       :
     1635         hide v-diasize-resize-button .
     1636         assign
     1637           v-diasize-resize-button :row    = 1
     1638           v-diasize-resize-button :column = 1
     1639         .
     1640       end.
     1641       if p-change-value > 0
     1642       then do:
     1643         if frame Dialog-Frame :scrollable = true
     1644         then do:
     1645           assign
     1646             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1647             no-error .
     1648           if error-status :error
     1649           or error-status :get-message(1) <> ""
     1650           then do:
     1651             undo move_block, retry move_block .
     1652           end.
     1653         end.
     1654         assign
     1655           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1656           no-error .
     1657         if error-status :error
     1658         or error-status :get-message(1) <> ""
     1659         then do:
     1660           undo move_block, retry move_block .
     1661         end.
     1662         assign
     1663           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1664           no-error .
     1665         if error-status :error
     1666         or error-status :get-message(1) <> ""
     1667         then do:
     1668           undo move_block, retry move_block .
     1669         end.
     1670         for each buf_temp-browse-handle
     1671           where buf_temp-browse-handle.browse-type = 'height':u
     1672         on error undo move_block, retry move_block
     1673         :
     1674           assign
     1675             buf_temp-browse-handle.browse-handle :height
     1676               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1677             no-error .
     1678           if error-status :error
     1679           or error-status :get-message(1) <> ""
     1680           then do:
     1681             undo move_block, retry move_block .
     1682           end.
     1683         end.
     1684         for each buf_temp-diasize-handle
     1685         on error undo move_block, retry move_block
     1686         :
     1687           assign
     1688             v-object-handle = buf_temp-diasize-handle.handle-value
     1689           .
     1690           if v-object-handle <> v-diasize-resize-button
     1691           then do:
     1692             assign
     1693               v-object-handle :row = v-object-handle :row + p-change-value
     1694               no-error .
     1695             if error-status :error
     1696             or error-status :get-message(1) <> ""
     1697             then do:
     1698               undo move_block, retry move_block .
     1699             end.
     1700           end.
     1701         end.
     1702       end.
     1703       else do:
     1704         for each buf_temp-diasize-handle
     1705         on error undo move_block, retry move_block
     1706         :
     1707           assign
     1708             v-object-handle = buf_temp-diasize-handle.handle-value
     1709           .
     1710           if v-object-handle <> v-diasize-resize-button
     1711           then do:
     1712             assign
     1713               v-object-handle :row = v-object-handle :row + p-change-value
     1714               no-error .
     1715             if error-status :error
     1716             or error-status :get-message(1) <> ""
     1717             then do:
     1718               undo move_block, retry move_block .
     1719             end.
     1720           end.
     1721         end.
     1722         assign
     1723           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1724           no-error .
     1725         if error-status :error
     1726         or error-status :get-message(1) <> ""
     1727         then do:
     1728           undo move_block, retry move_block .
     1729         end.
     1730         for each buf_temp-browse-handle
     1731           where buf_temp-browse-handle.browse-type = 'height':u
     1732         on error undo move_block, retry move_block
     1733         :
     1734           assign
     1735             buf_temp-browse-handle.browse-handle :height
     1736               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1737             no-error .
     1738           if error-status :error
     1739           or error-status :get-message(1) <> ""
     1740           then do:
     1741             undo move_block, retry move_block .
     1742           end.
     1743         end.
     1744         assign
     1745           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1746           no-error .
     1747         if error-status :error
     1748         or error-status :get-message(1) <> ""
     1749         then do:
     1750           undo move_block, retry move_block .
     1751         end.
     1752         if frame Dialog-Frame :scrollable = true
     1753         then do:
     1754           assign
     1755             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1756             no-error .
     1757           if error-status :error
     1758           or error-status :get-message(1) <> ""
     1759           then do:
     1760             undo move_block, retry move_block .
     1761           end.
     1762         end.
     1763       end.
     1764       if p-move-resize = true
     1765       then do:
     1766         run diasize_position-resize-button in this-procedure .
     1767       end.
     1768       if v-diasize-wndstore = true
     1769       then do:
     1770         if connected("ub") = true
     1771         then do:
     1772           define variable v-cntxt-db-num        as integer   no-undo .
     1773           define variable v-cntxt-userid        as character no-undo .
     1774           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1775                                             , OUTPUT v-cntxt-userid
     1776                                             ) .
     1777           run gbl/wndsizew.p
     1778             (input  v-cntxt-db-num
     1779             ,input  v-cntxt-userid
     1780             ,input  v-diasize-proc-name
     1781             ,input  'height':u
     1782             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1783             ) .
     1784         end.
     1785       end.
     1786     end.
     1787     assign
     1788       v-diasize-change-size = false
     1789     .
     1790   end procedure.
     1791   procedure diasize_set-height :
     1792     define input  parameter p-new-height  as decimal   no-undo .
     1793     define input  parameter p-move-resize as logical   no-undo .
     1794     do
     1795     on error undo, return error return-value
     1796     :
     1797       run diasize_change-height in this-procedure
     1798         (input  (p-new-height - frame Dialog-Frame :height)
     1799         ,input  p-move-resize
     1800         ) .
     1801     end.
     1802   end procedure.
     1803   procedure diasize_change-width :
     1804     define input  parameter p-change-value as decimal   no-undo .
     1805     define input  parameter p-move-resize  as logical   no-undo .
     1806     define variable v-field-group-handle   as handle    no-undo .
     1807     define variable v-object-handle        as handle    no-undo .
     1808     define variable v-frame-width          as decimal   no-undo .
     1809     define variable v-frame-virtual-width  as decimal   no-undo .
     1810     define variable v-browse-width         as decimal   no-undo .
     1811     define variable v-window-width         as decimal   no-undo .
     1812     define variable v-window-virtual-width as decimal   no-undo .
     1813     define variable v-change-sign          as integer   no-undo .
     1814     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1815     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1816     if p-change-value > 0
     1817     then do:
     1818       if frame Dialog-Frame :width + p-change-value >
     1819           session :width-chars
     1820       then do:
     1821         assign
     1822           p-change-value = session :width-chars - frame Dialog-Frame :width
     1823         .
     1824         if p-change-value <= 0
     1825         then do:
     1826           run diasize_position-resize-button in this-procedure .
     1827           return .
     1828         end.
     1829       end.
     1830     end.
     1831     if p-change-value < 0
     1832     then do:
     1833       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1834       then do:
     1835         assign
     1836           p-change-value = v-diasize-orig-frame-width
     1837                          - frame Dialog-Frame :width
     1838         .
     1839         if p-change-value >= 0
     1840         then do:
     1841           run diasize_position-resize-button in this-procedure .
     1842           return .
     1843         end.
     1844       end.
     1845     end.
     1846     if p-change-value >= 0
     1847     then do:
     1848       assign
     1849         v-change-sign = 1
     1850       .
     1851     end.
     1852     else do:
     1853       assign
     1854         v-change-sign = -1
     1855       .
     1856     end.
     1857     assign
     1858       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1859     .
     1860     if p-change-value = 0
     1861     then do:
     1862       run diasize_position-resize-button in this-procedure .
     1863       return .
     1864     end.
     1865     move_block:
     1866     do
     1867     on error undo move_block, leave move_block
     1868     :
     1869       if retry
     1870       then do:
     1871         do
     1872         on error undo move_block, leave move_block
     1873         :
     1874           if p-change-value > 0
     1875           then do:
     1876             for each buf_temp-diasize-handle
     1877             on error undo, next
     1878             :
     1879               assign
     1880                 v-object-handle = buf_temp-diasize-handle.handle-value
     1881               .
