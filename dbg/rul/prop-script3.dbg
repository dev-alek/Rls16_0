        1   block-level on error undo, throw.
        2   define input parameter p-silent as logical no-undo .
        3   define input parameter p-rec as recid no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision$":U .
        5   define variable vss-author      as character no-undo init "$Author$":U .
        6   define variable vss-date        as character no-undo init "$Date$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        8   define variable vss-archive     as character no-undo init "$Archive$":U .
        9   define variable vss-description as character no-undo init "Удаление prop-script".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define variable v-mess as character no-undo .
       69   define buffer buf_prop-script  for dictdb.prop-script.
       70   define buffer buf_rule-i-script for ub.rule-i-script.
       71   define buffer buf_pscript-ruleset for ub.pscript-ruleset.
       72   define buffer buf_ruledict for ub.ruledict.
       73   define buffer buf_ruledict-param for ub.ruledict-param.
       74   main-block:
       75   do
       76   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
       77   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
       78   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
       79   :
       80     find first buf_prop-script exclusive-lock where
       81             recid(buf_prop-script) = p-rec .
       82     find first buf_rule-i-script no-lock where
       83               buf_rule-i-script.script-name = buf_prop-script.script-name
       84           and buf_rule-i-script.dtm-code = buf_prop-script.dtm-code
       85           and buf_rule-i-script.revis_id = buf_prop-script.revis_id
       86               no-error.
       87     if available buf_rule-i-script  then do:
       88       v-mess = substitute("Невозможно удалить СКРИПТ &1&2" +
       89                  "СКРИПТ привязан к правилу &3"
       90                  , buf_prop-script.script-name
       91                  , chr(10)
       92                  , buf_rule-i-script.root_rule_id
       93                  ).
       94      run err-mess in this-procedure ( input-output v-mess) .
       95      undo, return error (if p-silent = yes then v-mess else '':U).
       96     end.
       97     find first buf_pscript-ruleset no-lock where
       98               buf_pscript-ruleset.dtm-code = buf_prop-script.dtm-code
       99           and buf_pscript-ruleset.language = buf_prop-script.language
      100           and buf_pscript-ruleset.script-name = buf_prop-script.script-name
      101           and buf_pscript-ruleset.revis_id = buf_prop-script.revis_id  no-error.
      102     if available buf_pscript-ruleset  then do:
      103       v-mess = substitute("Невозможно удалить СКРИПТ &1&2" +
      104                  "СКРИПТ привязан к своду правил &3 кодекс &4"
      105                  , buf_prop-script.script-name
      106                  , chr(10)
      107                  , buf_pscript-ruleset.ruleset_id
      108                  , buf_pscript-ruleset.codex_id).
      109      run err-mess in this-procedure ( input-output v-mess) .
      110      undo, return error (if p-silent = yes then v-mess else '':U).
      111     end.
      112     for each buf_ruledict where
      113             buf_ruledict.uniq-key-rec = buf_prop-script.uniq-key-rec
      114     on error undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)):
      115      for each buf_ruledict-param where
      116              buf_ruledict-param.entry-id = buf_ruledict.entry-id
      117      on error undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)):
      118         delete buf_ruledict-param.
      119      end.
      120      delete buf_Ruledict.
      121     end.
      122     delete buf_prop-script no-error.
      123     if error-status:error then do:
      124       v-mess = substitute("Ошибка при удалении: &1&2&3"
      125                            , error-status:get-message(1)
      126                            , chr(10)
      127                            , return-value ).
      128      run err-mess in this-procedure ( input-output v-mess) .
      129      undo main-block, return error (if p-silent = yes then v-mess else '':U).
      130     end.
      131   end.
      132   PROCEDURE err-mess:
      133     DEFINE INPUT-OUTPUT PARAMETER p-mess as character No-UNDO.
      134     CASE p-silent:
      135       when yes then do:
      136         assign
      137         p-mess = substitute("Скрипт: код объекта &1 язык &2 скрипт &3 версия &4:&5&6"
      138                            , buf_prop-script.dtm-code
      139                            , buf_prop-script.language
      140                            , buf_prop-script.script-name
      141                            , buf_prop-script.revis_id
      142                            , chr(10)
      143                            , p-mess)
      144         .
      145       end.
      146       when no then do:
      147         message
      148         p-mess
      149         view-as alert-box error .
      150       end.
      151     end.
      152   END PROCEDURE.
