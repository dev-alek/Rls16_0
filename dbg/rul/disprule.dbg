        1   block-level on error undo, throw.
        2   define input parameter p-display-mode as character no-undo .
        3   define input parameter p-rule-id as integer no-undo .
        4   DEFINE INPUT PARAMETER p-codex-id AS INTEGER NO-UNDO.
        5   DEFINE INPUT PARAMETER p-ruleset-id AS INTEGER NO-UNDO.
        6   DEFINE INPUT PARAMETER p-call-id AS CHARACTER NO-UNDO.
        7   DEFINE INPUT PARAMETER p-order-id AS INTEGER NO-UNDO.
        8   define variable vss-revision    as character no-undo init "$Revision$":U .
        9   define variable vss-author      as character no-undo init "$Author$":U .
       10   define variable vss-date        as character no-undo init "$Date$":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       12   define variable vss-archive     as character no-undo init "$Archive$":U .
       13   define variable vss-description as character no-undo init "Просмотр одного правила".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       73   define temp-table temp-string no-undo
       74   field v-string as character
       75   field string-num as integer
       76   index pi is unique primary string-num.
       77   procedure temp-string_clear :
       78     define buffer buf_temp-string for temp-string .
       79     do
       80     on error undo, return error return-value
       81     :
       82       for each buf_temp-string
       83       on error undo, return error
       84       :
       85         delete buf_temp-string.
       86       end.
       87     end.
       88   end procedure.
       89   procedure temp-string_write :
       90     define input  parameter p-v-string    as character no-undo .
       91     define variable v-string-num as integer no-undo .
       92     define buffer buf_temp-string for temp-string .
       93     do
       94     on error undo, return error return-value
       95     :
       96       find last buf_temp-string no-error .
       97       if not available buf_temp-string then do:
       98         create buf_temp-string .
       99         assign
      100         buf_temp-string.string-num     = 1
      101         buf_temp-string.v-string       = p-v-string
      102         .
      103       end.
      104       else do:
      105         v-string-num = buf_temp-string.string-num.
      106         create buf_temp-string .
      107         assign
      108         buf_temp-string.string-num = v-string-num + 1
      109         buf_temp-string.v-string = p-v-string
      110         .
      111       end.
      112     end.
      113   end procedure.
      114   procedure temp-string_read :
      115     define input  parameter p-string-num    as integer   no-undo .
      116     define output parameter p-v-string      as character no-undo .
      117     define buffer buf_temp-string for temp-string .
      118     do
      119     on error undo, return error return-value
      120     :
      121       find first buf_temp-string
      122         where buf_temp-string.string-num     = p-string-num
      123         no-error .
      124       if available buf_temp-string then do:
      125         assign
      126           p-v-string = buf_temp-string.v-string
      127         .
      128       end.
      129       else do:
      130         assign
      131           p-v-string = '':U
      132         .
      133       end.
      134     end.
      135   end procedure.
      136   procedure temp-string_append :
      137     define input  parameter p-string-num  as integer   no-undo .
      138     define input  parameter p-v-string    as character no-undo .
      139     define input  parameter p-append-char as character no-undo .
      140     define buffer buf_temp-string for temp-string .
      141     do
      142     on error undo, return error return-value
      143     :
      144       find first buf_temp-string
      145            where buf_temp-string.string-num = p-string-num
      146         no-error .
      147       if not available buf_temp-string then do:
      148         create buf_temp-string .
      149         assign
      150           buf_temp-string.string-num  = p-string-num
      151           buf_temp-string.v-string    = p-v-string
      152         .
      153       end.
      154       else do:
      155           assign
      156           buf_temp-string.v-string = buf_temp-string.v-string + p-append-char + p-v-string
      157           .
      158       end.
      159     end.
      160   end procedure.
      161   procedure temp-string_get-last-num:
      162   define output parameter p-string-num  as integer   no-undo .
      163   define buffer buf_temp-string for temp-string .
      164   find last buf_temp-string no-error.
      165   if available buf_temp-string then do:
      166     p-string-num = buf_temp-string.string-num.
      167   end.
      168   end procedure.
      169   procedure temp-string_delete-range:
      170   define input parameter p-first-string-num  as integer   no-undo .
      171   define input parameter p-last-string-num  as integer   no-undo .
      172   define buffer buf_temp-string for temp-string .
      173   for each buf_temp-string where
      174           buf_temp-string.string-num >= p-first-string-num
      175       and buf_temp-string.string-num <= p-last-string-num:
      176     delete buf_temp-string.
      177   end.
      178   end procedure.
      179   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      180   DEFINE TEMP-TABLE tt-rule NO-UNDO LIKE ub.rule
      181          field level as integer.
      182   DEFINE TEMP-TABLE tt-rule-script NO-UNDO LIKE ub.rule-script
      183          field level as integer
      184          field gen-order as character
      185          field upper_rule_id as integer
      186          field start-script_id as integer
      187          field end-script_id as integer
      188          field edge-type as character
      189          .
      190   define temp-table temp-rule-i-script no-undo
      191   like ub.rule-i-script.
      192   PROCEDURE fill-tables :
      193   DEFINE INPUT PARAMETER p-rule-id AS INTEGER NO-UNDO.
      194   DEFINE INPUT PARAMETER p-root-rule-id AS INTEGER NO-UNDO.
      195   DEFINE INPUT-OUTPUT PARAMETER p-level AS INTEGER NO-UNDO.
      196   DEFINE INPUT PARAMETER p-gen-order AS character NO-UNDO.
      197   DEFINE BUFFER buf_rule FOR ub.RULE.
      198   DEFINE BUFFER buf_rule-script FOR ub.RULE-script.
      199   DEFINE BUFFER buf_tt-rule FOR tt-RULE.
      200   DEFINE BUFFER buf_tt-rule-script FOR tt-RULE-script.
      201   if p-level = 0 then do:
      202     find first buf_rule where
      203               buf_rule.rule_id = p-root-rule-id.
      204     create buf_tt-rule.
      205     buffer-copy buf_rule to buf_tt-rule.
      206     release buf_tt-rule.
      207   end.
      208   p-level = p-level + 1.
      209   FOR EACH buf_rule NO-LOCK WHERE
      210           buf_rule.UPPER_rule_id = p-rule-id:
      211      find first buf_tt-rule where
      212               buf_tt-rule.rule_id = buf_rule.rule_id no-error.
      213      if not available buf_tt-rule then do:
      214       CREATE buf_tt-rule.
      215       buffer-copy buf_rule to buf_tt-rule.
      216       ASSIGN
      217       buf_tt-rule.root_rule_id = p-root-rule-id
      218       .
      219      end.
      220      buf_tt-rule.level = p-level.
      221      RUN fill-tables IN THIS-PROCEDURE (  INPUT buf_tt-rule.RULE_id
      222                                          ,INPUT p-root-rule-id
      223                                          ,INPUT-OUTPUT p-level
      224                                          ,INPUT (p-gen-order +
      225                                           STRING(p-level, "99") +
      226                                           STRING(buf_tt-rule.salience, "999"))).
      227   END.
      228   FOR EACH buf_rule-script NO-LOCK WHERE
      229           buf_rule-script.rule_id = p-rule-id:
      230      find first buf_tt-rule-script where
      231               buf_tt-rule-script.script_id = buf_rule-script.script_id
      232          AND  buf_tt-rule-script.LANGUAGE = buf_rule-script.LANGUAGE
      233          no-error.
      234      if not available buf_tt-rule-script
      235      then do:
      236       find first buf_tt-rule no-lock where
      237                 buf_tt-rule.rule_id = buf_rule-script.rule_id.
      238       CREATE buf_tt-rule-script.
      239       buffer-copy buf_rule-script to buf_tt-rule-script.
      240       ASSIGN
      241       buf_tt-rule-script.root_rule_id = p-root-rule-id
      242       buf_tt-rule-script.upper_rule_id = buf_tt-rule.upper_rule_id
      243       .
      244      end.
      245      assign
      246      buf_tt-rule-script.level = p-level
      247      buf_tt-rule-script.gen-order = p-gen-order +
      248                                     STRING(buf_tt-rule-script.level, "99") +
      249                                     STRING(buf_tt-rule-script.salience, "999").
      250      .
      251   END.
      252   p-level = p-level - 1.
      253   END PROCEDURE.
      254   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      255   define temp-table temp-edge no-undo
      256   field from-script_id as integer
      257   field to-script_id as integer
      258   field edge-type as character
      259   index pi is unique primary
      260   from-script_id
      261   to-script_id
      262   .
      263   function break-string-for-dot returns character (input p-string as character, input p-line-length AS INTEGER):
      264   define variable v-string as character no-undo .
      265   define variable v-output-string as character no-undo .
      266   define variable v-entry as character no-undo .
      267   define variable v-index as integer no-undo .
      268   v-string = p-string.
      269   v-output-string = p-string.
      270   do while length(v-string) > p-line-length :
      271     ASSIGN
      272     v-entry = substring(v-string, 1, p-line-length)
      273     v-index = r-index(v-entry, chr(32)).
      274     if v-index > 0
      275     and v-index <= p-line-length then do:
      276        assign
      277        v-output-string = v-output-string + substring(v-entry, 1, v-index - 1)  + '\N'.
      278        v-string = substring(v-string, v-index + 1)
      279        no-error.
      280        if error-status:error then leave.
      281     end.
      282     ELSE DO:
      283         assign
      284         v-output-string = v-output-string + v-entry.
      285         v-string = substring(v-string, 71)
      286         no-error.
      287     END.
      288   end.
      289   return v-output-string.
      290   end.
      291   PROCEDURE DISPLAY-RULE :
      292   define INPUT parameter p-rule-id AS integer no-undo.
      293   define input parameter p-upper-rule-id as integer no-undo .
      294   define input parameter p-language as character no-undo.
      295   define input-output parameter p-level as integer no-undo .
      296   define variable v-exist-condition-script as logical no-undo .
      297   define variable v-exist-rule-script as logical no-undo .
      298   define variable v-main-seq as character no-undo .
      299   define variable v-prev-node as character no-undo .
      300   define variable v-current-node as character no-undo .
      301   define variable v-next-node as character no-undo .
      302   define variable v-bottom-node as character no-undo .
      303   define variable v-top-node as character no-undo .
      304   define variable v-edge-label as logical no-undo .
      305   define variable v-language as character no-undo .
      306   define variable v-upper-rule-id as integer no-undo .
      307   define variable v-rule-id as integer no-undo .
      308   define variable v-salience as integer no-undo .
      309   define variable v-gen-order as character no-undo .
      310   define variable v-goto-text as character no-undo .
      311   define variable v-goto-rule as character no-undo .
      312   define buffer buf_rule for ub.rule.
      313   define buffer buf_upper-rule for ub.rule.
      314   define buffer buf_upper-rule-script for ub.rule-script.
      315   define buffer buf_down-rule for ub.rule.
      316   define buffer buf2_rule-script for ub.rule-script.
      317   define buffer buf3_rule-script for ub.rule-script.
      318   define buffer buf2_rule for ub.rule.
      319   define buffer buf_rule-script for ub.rule-script.
      320   define buffer buf_prop-script for ub.prop-script.
      321   define buffer buf_rule-i-script for ub.rule-i-script.
      322   define buffer buf_tt-rule-script for tt-rule-script.
      323   define buffer buf_temp-edge for temp-edge.
      324   define buffer buf_tt-rule for tt-rule.
      325   CASE p-language:
      326     WHEN "ABL" THEN DO:
      327       find first buf_rule no-lock where
      328                 buf_rule.rule_id = p-rule-id.
      329       if buf_rule.hidden-content > 0 then do:
      330         run temp-string_write in this-procedure ( input substitute("/* содержимое скрыто*/")).
      331         return.
      332       end.
      333       if p-upper-rule-id = 0 then do:
      334         run temp-string_write in this-procedure ( input substitute("/* &1", buf_Rule.name)).
      335         run temp-string_write in this-procedure ( input substitute("&1 */", buf_Rule.documentation)).
      336         run temp-string_write in this-procedure ( input '':U).
      337       end.
      338       else do:
      339         run temp-string_write in this-procedure ( input substitute("/* salience &1 in upper-rule-id &2*/"
      340                                                                   , buf_rule.salience
      341                                                                   , buf_rule.upper_rule_id
      342                                                                   )).
      343       end.
      344       run temp-string_write in this-procedure ( input  substitute("&1_&2:&3&1do:"
      345                                                                   ,fill( chr(32), p-level * 2)
      346                                                                   ,p-rule-id
      347                                                                   ,chr(10))).
      348       FOR EACH buf_rule-script NO-LOCK WHERE
      349         buf_rule-script.RULE_id = p-RULE-id
      350         AND buf_rule-script.LANGUAGE = p-language
      351       by buf_rule-script.salience :
      352         if buf_rule-script.script-type = 'COND':U then do:
      353           run temp-string_write in this-procedure (input  substitute("&1/* salience &2 rule_id &3*/"
      354                                                                      ,fill(chr(32), 70)
      355                                                                      ,buf_rule-script.salience
      356                                                                      ,buf_rule-script.rule_ID
      357                                                                      ) ).
      358           run temp-string_write in this-procedure (input  substitute("&1IF &2  THEN do:   "
      359                                                                       ,fill( chr(32), p-level * 2)
      360                                                                       ,replace(buf_rule-script.script, (chr(38) + chr(38)), chr(38))
      361                                                                       )).
      362           .
      363           assign
      364           v-exist-rule-script = yes
      365           .
      366         end.
      367         if buf_rule-script.script-type = 'CYCLE-COND':U then do:
      368           run temp-string_write in this-procedure (input  substitute("&1/* salience &2 rule_id &3*/"
      369                                                                      ,fill(chr(32), 70)
      370                                                                      ,buf_rule-script.salience
      371                                                                      ,buf_rule-script.rule_ID
      372                                                                      ) ).
      373           run temp-string_write in this-procedure (input  substitute("&1DO WHILE &2 :   "
      374                                                                       ,fill( chr(32), p-level * 2)
      375                                                                       ,replace(buf_rule-script.script, (chr(38) + chr(38)), chr(38))
      376                                                                       )).
      377           .
      378           assign
      379           v-exist-rule-script = yes
      380           .
      381         end.
      382         if buf_rule-script.script-type = 'CONS':U
      383         or buf_rule-script.script-type = 'GOTO':U
      384         then do:
      385           run temp-string_write in this-procedure ( input  substitute("&1/* Salience &2 rule_id &3*/"
      386                                                                        ,fill(chr(32), 70)
      387                                                                        ,buf_rule-script.salience
      388                                                                        ,buf_rule-script.rule_id
      389                                                                        )).
      390           find first buf_rule-i-script no-lock where
      391                     buf_rule-i-script.root_rule_id = buf_rule.root_rule_id
      392                and  buf_rule-i-script.script_id = buf_rule-script.script_id
      393                and  buf_rule-i-script.i-script-type = 'variable':U no-error.
      394           if available buf_rule-i-script then do:
      395             run temp-string_write in this-procedure ( input  substitute("/*&1&2 .*/"
      396                                                                         ,fill( chr(32), p-level * 2)
      397                                                                         ,replace(buf_rule-script.script, (chr(38) + chr(38)), chr(38))
      398                                                                         )).
      399           end.
      400           else do:
      401             run temp-string_write in this-procedure ( input  substitute("&1&2 ."
      402                                                                   ,fill( chr(32), p-level * 2)
      403                                                                   ,replace(buf_rule-script.script, (chr(38) + chr(38)), chr(38))
      404                                                                   )).
      405           end.
      406         end.
      407         if buf_rule-script.script-type = 'RULE':U
      408         or buf_rule-script.script-type = 'ELSE-RULE':U
      409         then do:
      410           find first buf_rule no-lock where
      411                   buf_rule.upper_rule_id = p-rule-id
      412               and buf_rule.salience = buf_rule-script.salience no-error .
      413           if not available buf_rule then do:
      414             message
      415             substitute("Не найдено правило &1 вышестояшего уровня к скрипту типа &2:&3№ скрипта &4, порядок &5"
      416                        , p-rule-id
      417                        , buf_rule-script.script-type
      418                        , chr(10)
      419                        , buf_rule-script.script_id
      420                        , buf_rule-script.salience )
      421             view-as alert-box error .
      422             return.
      423           end.
      424           if buf_rule-script.script-type = 'ELSE-RULE':U then do:
      425             run temp-string_write in this-procedure ( input substitute("&1else do: /*rule &2*/"
      426                                                                         ,fill( chr(32), p-level * 2)
      427                                                                         ,buf_rule.rule_id)).
      428             assign
      429             v-exist-rule-script = yes
      430             .
      431           end.
      432           p-level = p-level + 1.
      433           run display-rule ( input buf_rule.rule_id, input buf_rule.upper_rule_id, input p-language, input-output p-level).
      434           p-level = p-level - 1.
      435           if v-exist-rule-script then do:
      436             run temp-string_write in this-procedure ( input substitute("&1end. /*of rule &2*/"
      437                                                                         ,fill( chr(32), p-level * 2)
      438                                                                         ,buf_rule.rule_id)).
      439             v-exist-rule-script = no.
      440           end.
      441         end.
      442       END.
      443       if v-exist-rule-script then do:
      444         run temp-string_write in this-procedure ( input substitute("&1end.&2end. /*of rule &3*/"
      445                                                                     ,fill( chr(32), p-level * 2)
      446                                                                     ,chr(10)
      447                                                                     ,p-rule-id)).
      448       end.
      449       else do:
      450         run temp-string_write in this-procedure ( input substitute("&1&2end. /*of rule &3*/"
      451                                                                     ,chr(10)
      452                                                                     ,fill( chr(32), p-level * 2)
      453                                                                     ,p-rule-id)).
      454       end.
      455     END.
      456     WHEN "rus"
      457     or
      458     when "rus-ext"
      459     THEN DO:
      460       find first buf_rule no-lock where
      461                 buf_rule.rule_id = p-rule-id.
      462       if p-upper-rule-id = 0 then do:
      463         run temp-string_write in this-procedure ( input buf_rule.name ).
      464         run temp-string_write in this-procedure ( input buf_rule.documentation ).
      465         run temp-string_write in this-procedure ( input '':U).
      466         if buf_rule.hidden-content > 0 then do:
      467           run temp-string_write in this-procedure ( input "НЕЛЬЗЯ ПРОСМОТРЕТЬ СОДЕРЖИМОЕ ПРАВИЛА").
      468           return.
      469         end.
      470       end.
      471       else do:
      472         if p-language = "rus-ext" then do:
      473           run temp-string_write in this-procedure ( input substitute("&1/* порядок &2 правила &3 */"
      474                                                                     ,fill(chr(32), 70)
      475                                                                     ,buf_rule.salience
      476                                                                     ,buf_rule.upper_rule_id
      477                                                                     )).
      478         end.
      479       end.
      480       run temp-string_write in this-procedure ( input substitute("_Правило &1:",  p-RULE-id)).
      481       FOR EACH buf_rule-script NO-LOCK WHERE
      482               buf_rule-script.RULE_id = p-rULE-id
      483           AND buf_rule-script.LANGUAGE = "rus":
      484        if buf_rule-script.script-type = 'COND':U then do:
      485           if p-language = "rus-ext" then do:
      486             run temp-string_write in this-procedure ( input  substitute("&1/* порядок &2 правила &3*/"
      487                                                                         ,fill(chr(32), 70)
      488                                                                         ,buf_rule-script.salience
      489                                                                         ,buf_rule-script.rule_id
      490                                                                         )).
      491           end.
      492           run temp-string_write in this-procedure ( input  substitute("&1Если &2 тогда: "
      493                                                                         ,fill( chr(32), p-level * 2)
      494                                                                         ,buf_rule-script.script )).
      495           assign
      496           v-exist-rule-script = yes
      497           .
      498         end.
      499        if buf_rule-script.script-type = 'CYCLE-COND':U then do:
      500           if p-language = "rus-ext" then do:
      501             run temp-string_write in this-procedure ( input  substitute("&1/* порядок &2 правила &3*/"
      502                                                                         ,fill(chr(32), 70)
      503                                                                         ,buf_rule-script.salience
      504                                                                         ,buf_rule-script.rule_id
      505                                                                         )).
      506           end.
      507           run temp-string_write in this-procedure ( input  substitute("&1ПОКА &2: "
      508                                                                         ,fill( chr(32), p-level * 2)
      509                                                                         ,buf_rule-script.script )).
      510           assign
      511           v-exist-rule-script = yes
      512           .
      513         end.
      514         if buf_rule-script.script-type = 'RULE':U
      515         or buf_rule-script.script-type = 'ELSE-RULE':U
      516         then do:
      517           find first buf_rule no-lock where
      518                   buf_rule.upper_rule_id = p-rule-id
      519               and buf_rule.salience = buf_rule-script.salience no-error .
      520           if not available buf_rule then do:
      521             message
      522             substitute("Не найдено правило &1 вышестояшего уровня к скрипту типа &2:&3№ скрипта &4, порядок &5"
      523                        , p-rule-id
      524                        , buf_rule-script.script-type
      525                        , chr(10)
      526                        , buf_rule-script.script_id
      527                        , buf_rule-script.salience )
      528             view-as alert-box error .
      529             return.
      530           end.
      531           if buf_rule-script.script-type = 'ELSE-RULE':U then do:
      532             run temp-string_write in this-procedure ( input substitute("&1ИНАЧЕ: /*правило &2*/"
      533                                                                         ,fill( chr(32), p-level * 2)
      534                                                                         ,buf_rule.rule_id)).
      535             assign
      536             v-exist-rule-script = yes
      537             .
      538           end.
      539           p-level = p-level + 1.
      540           run display-rule ( input buf_rule.rule_id, input buf_rule.upper_rule_id, input p-language, input-output p-level).
      541           p-level = p-level - 1.
      542         end.
      543         if buf_rule-script.script-type = 'CONS':U
      544         or buf_rule-script.script-type = 'GOTO':U
      545         then do:
      546           if p-language = "rus-ext" then do:
      547             run temp-string_write in this-procedure ( input substitute("&1/* порядок &2 правила &3*/"
      548                                                                         ,fill(chr(32), 70)
      549                                                                         ,buf_rule-script.salience
      550                                                                         ,buf_rule-script.rule_id
      551                                                                         )).
      552           end.
      553           run temp-string_write in this-procedure ( input substitute("&1&2 ;"
      554                                                                       ,fill( chr(32), p-level * 2)
      555                                                                       ,buf_rule-script.script )).
      556         end.
      557       END.
      558       if v-exist-rule-script then do:
      559         run temp-string_write in this-procedure ( input substitute("&1. /* конец правила &2 */"
      560                                                                       ,fill( chr(32), p-level * 2)
      561                                                                       ,p-rule-id) ).
      562       end.
      563       else do:
      564         run temp-string_write in this-procedure ( input substitute("&1. /* конец правила &2 */"
      565                                                                       ,fill( chr(32), p-level * 2)
      566                                                                       ,p-rule-id) ).
      567       end.
      568     END.
      569     when "DOT2-rus":U
      570     or
      571     when "DOT2-ABL":U then do:
      572       v-language = entry(2, p-language, "-").
      573       find first buf_rule no-lock where
      574                 buf_rule.rule_id = p-rule-id.
      575       if p-upper-rule-id = 0 then do:
      576         run temp-string_write in this-procedure ( input  substitute('Rule&1_&2_&3 [shape=ellipse , fillcolor=pink, style="rounded,filled",  label="Правило&4\n&1_&2_&3"];'
      577                                                                   , buf_rule.rule_id
      578                                                                   , buf_rule.upper_rule_id
      579                                                                   , buf_rule.salience
      580                                                                   , (if buf_rule.hidden-content > 0 then " (содержимое скрыто) " else "")
      581                                                                   )
      582                                                                   ).
      583         if buf_rule.hidden-content > 0 then do:
      584           return.
      585         end.
      586       end.
      587       else do:
      588       end.
      589       FOR EACH buf_rule-script NO-LOCK WHERE
      590               buf_rule-script.RULE_id = p-rULE-id
      591           AND buf_rule-script.LANGUAGE = v-language:
      592         if buf_rule-script.script-type = 'COND':U then do:
      593           run temp-string_write in this-procedure ( input   substitute('Condition&1_&2 [shape=diamond, fillcolor=yellow, style="rounded,filled", label="&3?"];'
      594                                                                       , buf_rule-script.rule_id
      595                                                                       , buf_rule-script.salience
      596                                                                       , replace(replace(replace(buf_rule-script.script, chr(34), "&#34;":U), "~~n", "\n"), chr(10), "\n")
      597                                                                       )).
      598         end.
      599         if buf_rule-script.script-type = 'CYCLE-COND':U then do:
      600           run temp-string_write in this-procedure ( input   substitute('Cyclecondition&1_&2 [shape=trapezium, fillcolor=yellowgreen, style="rounded,filled", label="&3?"];'
      601                                                                       , buf_rule-script.rule_id
      602                                                                       , buf_rule-script.salience
      603                                                                       , replace(replace(replace(buf_rule-script.script, chr(34), "&#34;":U), "~~n", "\n"), chr(10), "\n")
      604                                                                       )).
      605         end.
      606         if buf_rule-script.script-type = 'CONS':U then do:
      607           run temp-string_write in this-procedure ( input   substitute('Consequence&1_&2 [shape=box, fillcolor=lightgrey, style="rounded,filled", label="&3"];'
      608                                                                       , buf_rule-script.rule_id
      609                                                                       , buf_rule-script.salience
      610                                                                       , replace(replace(replace(buf_rule-script.script, chr(34), "&#34;":U), "~~n", "\n"), chr(10), "\n")
      611                                                                       )).
      612         end.
      613         if buf_rule-script.script-type = 'GOTO':U then do:
      614           run temp-string_write in this-procedure ( input   substitute('Goto&1_&2 [shape=invtriangle, fillcolor=pink, style="rounded,filled", label="&3"];'
      615                                                                       , buf_rule-script.rule_id
      616                                                                       , buf_rule-script.salience
      617                                                                       , replace(replace(replace(buf_rule-script.script, chr(34), "&#34;":U), "~~n", "\n"), chr(10), "\n")
      618                                                                       )).
      619         end.
      620         if buf_rule-script.script-type = 'RULE':U
      621         or buf_rule-script.script-type = 'ELSE-RULE':U
      622         then do:
      623           find first buf_down-rule no-lock where
      624                     buf_down-rule.upper_rule_id = p-rule-id
      625                 and buf_down-rule.salience = buf_rule-script.salience.
      626           p-level = p-level + 1.
      627           run display-rule ( input buf_down-rule.rule_id
      628                            , input buf_down-rule.upper_rule_id
      629                            , input p-language
      630                            , input-output p-level).
      631           p-level = p-level - 1.
      632         end.
      633       end.
      634       if p-upper-rule-id = 0 then do:
      635         run temp-string_write in this-procedure ( input substitute('End_Rule&1 [shape=ellipse , fillcolor=pink, style="rounded,filled", label="Конец\nправила &1"];'
      636                                                                     , p-rule-id)).
      637       end.
      638       if p-upper-rule-id = 0 then do:
      639         run temp-string_write in this-procedure ( input substitute("~}")).
      640       end.
      641      end.
      642       when "DOT1-rus"
      643       or
      644       when "DOT1-ABL"
      645       then do:
      646           DEFINE VARIABLE v-level AS INTEGER NO-UNDO.
      647           define variable v-start-script-id as integer no-undo .
      648           define variable v-end-script-id as integer no-undo .
      649           define variable v-script-type as character no-undo .
      650           define buffer buf2_tt-rule for tt-rule.
      651           v-language = entry(2, p-language, "-").
      652           find first buf_rule no-lock where
      653                     buf_rule.rule_id = p-rule-id.
      654           if p-upper-rule-id = 0 then do:
      655             RUN fill-tables IN THIS-PROCEDURE (  INPUT buf_rule.RULE_id
      656                                             ,INPUT buf_rule.root_RULE_id
      657                                             ,INPUT-OUTPUT v-level
      658                                             ,INPUT "") no-error.
      659             run temp-string_write in this-procedure ( input substitute("digraph rule&1 ~{", p-rule-id)).
      660             run temp-string_write in this-procedure ( input substitute('node [fontsize=12];')).
      661             run temp-string_write in this-procedure ( input substitute('nodesep=0.30;')).
      662             run temp-string_write in this-procedure ( input substitute('ranksep=0.30;')).
      663             if buf_rule.hidden-content > 0 then do:
      664               return.
      665             end.
      666             _tt-rule:
      667             for each buf_tt-rule no-lock where
      668                     buf_tt-rule.root_rule_id = buf_rule.root_rule_id:
      669               if buf_tt-rule.rule_id = buf_tt-rule.root_rule_id then do:
      670                 find first buf_tt-rule-script where
      671                           buf_tt-rule.rule_id = buf_tt-rule.rule_id.
      672                 assign
      673                 v-start-script-id = buf_tt-rule-script.script_id
      674                 v-end-script-id = -1
      675                 .
      676               end.
      677               else do:
      678                 find first buf_tt-rule-script no-lock where
      679                         buf_tt-rule-script.rule_id = buf_tt-rule.upper_rule_id
      680                     and buf_tt-rule-script.salience = buf_tt-rule.salience.
      681                 assign
      682                 v-salience = buf_tt-rule-script.salience
      683                 v-script-type = buf_tt-rule-script.script-type
      684                 .
      685                 find last buf_tt-rule-script no-lock where
      686                         buf_tt-rule-script.rule_id = buf_tt-rule.upper_rule_id
      687                     and buf_tt-rule-script.salience < buf_tt-rule.salience
      688                     and buf_tt-rule-script.script-type <> 'RULE':U
      689                     and buf_tt-rule-script.script-type <> 'ELSE-RULE':U
      690                     .
      691                 assign
      692                 v-start-script-id = buf_tt-rule-script.script_id.
      693                 find first buf2_tt-rule where
      694                           buf2_tt-rule.rule_id = buf_tt-rule.rule_id.
      695                 assign
      696                 v-salience = buf_tt-rule.salience
      697                 v-rule-id = buf_tt-rule.upper_rule_id
      698                 .
      699                 _TTT:
      700                 do while true:
      701                   find first buf_tt-rule-script no-lock where
      702                           buf_tt-rule-script.rule_id = v-rule-id
      703                       and buf_tt-rule-script.salience > v-salience
      704                       and buf_tt-rule-script.script-type <>  'RULE':U
      705                       and buf_tt-rule-script.script-type <>  'ELSE-RULE':U
      706                       no-error
      707                       .
      708                   if not available buf_tt-rule-script then do:
      709                     if buf2_tt-rule.upper_rule_id = 0 then do:
      710                       v-end-script-id = -1.
      711                       leave _ttt.
      712                     end.
      713                     else do:
      714                       find first buf2_tt-rule where
      715                                 buf2_tt-rule.rule_id = v-rule-id.
      716                       assign
      717                       v-salience = buf2_tt-rule.salience
      718                       v-rule-id = buf2_tt-rule.upper_rule_id
      719                       .
      720                     end.
      721                   end.
      722                   else do:
      723                     assign
      724                     v-end-script-id = buf_tt-rule-script.script_id.
      725                     leave _ttt.
      726                   end.
      727                 end.
      728                 for each buf_tt-rule-script where
      729                         buf_tt-rule-script.rule_id = buf_tt-rule.rule_id:
      730                   assign
      731                   buf_tt-rule-script.start-script_id = v-start-script-id
      732                   buf_tt-rule-script.end-script_id = v-end-script-id
      733                   buf_tt-rule-script.edge-type = (if v-script-type = 'RULE':U
      734                                                   then "yes"
      735                                                   else "no")
      736                   .
      737                 end.
      738               end.
      739             end.
      740           end.
      741           if p-upper-rule-id = 0 then do:
      742             assign
      743             v-prev-node =  substitute("Rule&1_&2_&3"
      744                                     , buf_rule.rule_id
      745                                     , buf_rule.upper_rule_id
      746                                     , buf_rule.salience
      747                                     ).
      748             for each buf_tt-rule-script by
      749                   buf_tt-rule-script.gen-order:
      750               create buf_temp-edge.
      751               assign
      752               buf_temp-edge.from-script_id = 0
      753               buf_temp-edge.to-script_id = buf_tt-rule-script.script_id
      754               buf_temp-edge.edge-type = "":U
      755               .
      756               release buf_temp-edge.
      757               leave.
      758             end.
      759           end.
      760           FOR EACH buf_rule-script NO-LOCK WHERE
      761                   buf_rule-script.RULE_id = p-rULE-id
      762               AND buf_rule-script.LANGUAGE = v-language:
      763             if buf_rule-script.script-type = 'RULE':U
      764             or buf_rule-script.script-type = 'ELSE-RULE':U
      765             then do:
      766               find first buf_down-rule no-lock where
      767                         buf_down-rule.upper_rule_id = p-rule-id
      768                     and buf_down-rule.salience = buf_rule-script.salience no-error .
      769               if error-status :error then do:
      770               end.
      771               p-level = p-level + 1.
      772               run display-rule ( input buf_down-rule.rule_id, input buf_down-rule.upper_rule_id, input p-language, input-output p-level).
      773               p-level = p-level - 1.
      774             end.
      775             run create-temp-edge in this-procedure ( buffer buf_rule-script
      776                                                     ,input v-language
      777                                                     ,output v-current-node
      778                                                     ).
      779             _temp-edge:
      780             for each buf_temp-edge where
      781                     buf_temp-edge.from-script_id = buf_rule-script.script_id:
      782               if buf_temp-edge.to-script_id = -1 then do:
      783                 assign
      784                 v-next-node =  substitute("End_Rule&1"
      785                                   , buf_rule-script.root_rule_id
      786                                   ).
      787               end.
      788               else do:
      789                 find first buf_tt-rule-script where buf_tt-rule-script.script_id = buf_temp-edge.to-script_id no-error .
      790                 if not available buf_tt-rule-script then do:
      791                   next _temp-edge.
      792                 end.
      793                 case buf_tt-rule-script.script-type:
      794                   when 'CONS':U then do:
      795                     assign
      796                     v-next-node  = substitute("Consequence&1_&2"
      797                                         , buf_tt-rule-script.rule_id
      798                                         , buf_tt-rule-script.salience).
      799                   end.
      800                   when 'GOTO':U then do:
      801                     assign
      802                     v-next-node  = substitute("Goto&1_&2"
      803                                         , buf_tt-rule-script.rule_id
      804                                         , buf_tt-rule-script.salience).
      805                   end.
      806                   when 'COND':U then do:
      807                     assign
      808                     v-next-node  = substitute("Condition&1_&2"
      809                                         , buf_tt-rule-script.rule_id
      810                                         , buf_tt-rule-script.salience).
      811                   end.
      812                   when 'CYCLE-COND':U then do:
      813                     assign
      814                     v-next-node  = substitute("Cyclecondition&1_&2"
      815                                         , buf_tt-rule-script.rule_id
      816                                         , buf_tt-rule-script.salience).
      817                   end.
      818                   when 'ELSE-RULE':U then do:
      819                     next _temp-edge.
      820                   end.
      821                 end case.
      822               end.
      823               if can-find(first temp-edge where
      824                               temp-edge.from-script_id = 0
      825                           and temp-edge.to-script_id = buf_rule-script.script_id) then do:
      826                 run temp-string_write in this-procedure ( input substitute("&1 -> &2"
      827                                                                             ,v-prev-node
      828                                                                             ,v-current-node
      829                                                                             )).
      830               end.
      831               run temp-string_write in this-procedure ( input substitute("&1 -> &2&3"
      832                                                                           ,v-current-node
      833                                                                           ,v-next-node
      834                                                       ,(if buf_temp-edge.edge-type = ""
      835                                                         then "":U
      836                                                         else substitute('[taillabel="&1"]'
      837                                                                         , buf_temp-edge.edge-type)
      838                                                         )
      839                                                                           )).
      840             end.
      841           end.
      842         end.
      843   END CASE.
      844   END procedure.
      845   procedure create-temp-edge :
      846   define parameter buffer buf_rule-script for ub.rule-script.
      847   define input parameter p-language as character no-undo .
      848   define output parameter p-current-node as character no-undo .
      849   define variable v-salience as integer no-undo .
      850   define variable v-rule-id as integer no-undo .
      851   define variable v-gen-order as character no-undo .
      852   define variable v-goto-text as character no-undo .
      853   define variable v-goto-rule as character no-undo .
      854   define variable v-ii as integer no-undo .
      855   define variable v-script-id as integer no-undo .
      856   define variable v-script-type as character no-undo .
      857   define variable v-int as integer no-undo .
      858   define buffer buf_tt-rule-script for tt-rule-script.
      859   define buffer buf_tt-rule for tt-rule.
      860   define buffer buf_temp-edge for temp-edge.
      861   define buffer buf2_rule for ub.rule.
      862   do
      863   on error undo, return error
      864   :
      865     case buf_rule-script.script-type:
      866       when 'COND':U then do:
      867         assign
      868         p-current-node  = substitute("Condition&1_&2"
      869                           , buf_rule-script.rule_id
      870                           , buf_rule-script.salience).
      871        for each buf_tt-rule-script where
      872                 buf_tt-rule-script.start-script_id = buf_rule-script.script_id
      873             and buf_tt-rule-script.edge-type = "yes"
      874         by buf_tt-rule-script.gen-order:
      875           create buf_temp-edge.
      876           assign
      877           buf_temp-edge.from-script_id = buf_rule-script.script_id
      878           buf_temp-edge.to-script_id = buf_tt-rule-script.script_id
      879           buf_temp-edge.edge-type = buf_tt-rule-script.edge-type
      880           .
      881           leave.
      882        end.
      883        for each buf_tt-rule-script where
      884                 buf_tt-rule-script.start-script_id = buf_rule-script.script_id
      885             and buf_tt-rule-script.edge-type = "no"
      886         by buf_tt-rule-script.gen-order:
      887           create buf_temp-edge.
      888           assign
      889           buf_temp-edge.from-script_id = buf_rule-script.script_id
      890           buf_temp-edge.to-script_id = buf_tt-rule-script.script_id
      891           buf_temp-edge.edge-type = buf_tt-rule-script.edge-type
      892           .
      893           leave.
      894        end.
      895        if not available buf_tt-rule-script then do:
      896         assign
      897         v-rule-id = buf_rule-script.rule_id
      898         v-salience = buf_rule-script.salience
      899         .
      900         find first buf_tt-rule-script where
      901                   buf_tt-rule-script.rule_id = v-rule-id
      902               and buf_tt-rule-script.salience > v-salience
      903               and buf_tt-rule-script.script-type <> 'RULE':U
      904               and buf_tt-rule-script.script-type <> 'ELSE-RULE':U
      905               no-error.
      906         if not available buf_tt-rule-script then do:
      907           if buf_rule-script.rule_id = buf_rule-script.root_rule_id then do:
      908             create buf_temp-edge.
      909             assign
      910             buf_temp-edge.from-script_id = buf_rule-script.script_id
      911             buf_temp-edge.to-script_id = -1
      912             buf_temp-edge.edge-type = "no"
      913             .
      914           end.
      915           else do:
      916             find first buf_tt-rule-script where
      917                       buf_tt-rule-script.script_id = buf_rule-script.script_id.
      918             create buf_temp-edge.
      919             assign
      920             buf_temp-edge.from-script_id = buf_rule-script.script_id
      921             buf_temp-edge.to-script_id = buf_tt-rule-script.end-script_id
      922             buf_temp-edge.edge-type = "no"
      923             .
      924           end.
      925         end.
      926         else do:
      927           create buf_temp-edge.
      928           assign
      929           buf_temp-edge.from-script_id = buf_rule-script.script_id
      930           buf_temp-edge.to-script_id = buf_tt-rule-script.script_id
      931           buf_temp-edge.edge-type = "no"
      932           .
      933         end.
      934        end.
      935       end.
      936       when 'CYCLE-COND':U then do:
      937         assign
      938         p-current-node  = substitute("Cyclecondition&1_&2"
      939                           , buf_rule-script.rule_id
      940                           , buf_rule-script.salience).
      941        for each buf_tt-rule-script where
      942                 buf_tt-rule-script.start-script_id = buf_rule-script.script_id
      943             and buf_tt-rule-script.edge-type = "yes"
      944         by buf_tt-rule-script.gen-order:
      945           v-ii = v-ii + 1.
      946           if v-ii = 1 then do:
      947             create buf_temp-edge.
      948             assign
      949             buf_temp-edge.from-script_id = buf_rule-script.script_id
      950             buf_temp-edge.to-script_id = buf_tt-rule-script.script_id
      951             buf_temp-edge.edge-type = buf_tt-rule-script.edge-type
      952             .
      953           end.
      954           assign
      955           v-script-id = buf_tt-rule-script.script_id
      956           v-script-type = buf_tt-rule-script.script-type
      957           v-rule-id = buf_tt-rule-script.rule_id
      958           v-salience = buf_tt-rule-script.salience
      959           .
      960         end.
      961         _cont:
      962         do while true:
      963           if v-script-type <> 'RULE':U
      964           and v-script-type <> 'ELSE-RULE':U then do:
      965             create buf_temp-edge.
      966             assign
      967             buf_temp-edge.to-script_id = buf_rule-script.script_id
      968             buf_temp-edge.from-script_id = v-script-id
      969             buf_temp-edge.edge-type = "continue"
      970             .
      971             leave _cont.
      972           end.
      973           find first buf_tt-rule where
      974                     buf_tt-rule.upper_rule_id = v-rule-id
      975                 and buf_tt-rule.salience = v-salience.
      976           for each buf_tt-rule-script where
      977                   buf_tt-rule-script.rule_id = buf_tt-rule.rule_id
      978           by buf_tt-rule-script.gen-order:
      979             assign
      980             v-script-id = buf_tt-rule-script.script_id
      981             v-script-type = buf_tt-rule-script.script-type
      982             v-rule-id = buf_tt-rule-script.rule_id
      983             v-salience = buf_tt-rule-script.salience
      984             .
      985           end.
      986         end.
      987       end.
      988       when 'CONS':U
      989       then do:
      990         assign
      991         p-current-node  = substitute("Consequence&1_&2"
      992                             , buf_rule-script.rule_id
      993                             , buf_rule-script.salience).
      994         assign
      995         v-rule-id = buf_rule-script.rule_id
      996         v-salience = buf_rule-script.salience
      997         .
      998         find first buf_tt-rule-script where
      999                   buf_tt-rule-script.rule_id = v-rule-id
     1000               and buf_tt-rule-script.salience > v-salience no-error.
     1001         if not available buf_tt-rule-script then do:
     1002           if buf_rule-script.rule_id = buf_rule-script.root_rule_id then do:
     1003             create buf_temp-edge.
     1004             assign
     1005             buf_temp-edge.from-script_id = buf_rule-script.script_id
     1006             buf_temp-edge.to-script_id = -1
     1007             buf_temp-edge.edge-type = ""
     1008             .
     1009           end.
     1010           else do:
     1011             find first buf_tt-rule-script where
     1012                       buf_tt-rule-script.script_id = buf_rule-script.script_id.
     1013             create buf_temp-edge.
     1014             assign
     1015             buf_temp-edge.from-script_id = buf_rule-script.script_id
     1016             buf_temp-edge.to-script_id = buf_tt-rule-script.end-script_id
     1017             buf_temp-edge.edge-type = ""
     1018             .
     1019           end.
     1020         end.
     1021         else do:
     1022           create buf_temp-edge.
     1023           assign
     1024           buf_temp-edge.from-script_id = buf_rule-script.script_id
     1025           buf_temp-edge.to-script_id = buf_tt-rule-script.script_id
     1026           buf_temp-edge.edge-type = ""
     1027           .
     1028         end.
     1029       end.
     1030       when 'GOTO':U then do:
     1031         assign
     1032         p-current-node  = substitute("Goto&1_&2"
     1033                             , buf_rule-script.rule_id
     1034                             , buf_rule-script.salience).
     1035         find first buf_tt-rule-script where
     1036                 buf_tt-rule-script.rule_id = buf_rule-script.rule_id
     1037             and buf_tt-rule-script.language = "ABL"
     1038             and buf_tt-rule-script.salience = buf_rule-script.salience.
     1039         v-goto-text = trim(buf_tt-rule-script.script, chr(32)).
     1040         if v-goto-text begins "leave":U then do:
     1041           v-goto-rule = trim(trim(replace(v-goto-text, "leave":U, "":U), chr(32)), "_":U).
     1042           if v-goto-rule = string(buf_rule-script.root_rule_id) then do:
     1043             create buf_temp-edge.
     1044             assign
     1045             buf_temp-edge.from-script_id = buf_rule-script.script_id
     1046             buf_temp-edge.to-script_id =  -1
     1047             buf_temp-edge.edge-type = ""
     1048             .
     1049           end.
     1050           else do:
     1051             assign
     1052             v-int = integer(v-goto-rule) no-error.
     1053             if not error-status:error then do:
     1054               find first buf_tt-rule-script where
     1055                           buf_tt-rule-script.upper_rule_id = v-int .
     1056               create buf_temp-edge.
     1057               assign
     1058               buf_temp-edge.from-script_id = buf_rule-script.script_id
     1059               buf_temp-edge.to-script_id = buf_tt-rule-script.end-script_id
     1060               buf_temp-edge.edge-type = "leave"
     1061               .
     1062             end.
     1063           end.
     1064         end.
     1065         if v-goto-text begins "next":U then do:
     1066           v-goto-rule = trim(replace(v-goto-text, "next":U, "":U), chr(32)).
     1067           if v-goto-rule = substitute("_&1", buf_rule-script.root_rule_id) then do:
     1068             find first buf_tt-rule-script where
     1069                       buf_tt-rule-script.rule_id = buf_rule-script.root_rule_id.
     1070             create buf_temp-edge.
     1071             assign
     1072             buf_temp-edge.from-script_id = buf_rule-script.script_id
     1073             buf_temp-edge.to-script_id = buf_tt-rule-script.script_id
     1074             buf_temp-edge.edge-type = ""
     1075             .
     1076           end.
     1077           else do:
     1078             assign
     1079             v-int = integer(trim(v-goto-rule, "_")) no-error.
     1080             if not error-status:error then do:
     1081               find first buf_tt-rule-script where
     1082                           buf_tt-rule-script.upper_rule_id = v-int .
     1083               create buf_temp-edge.
     1084               assign
     1085               buf_temp-edge.from-script_id = buf_rule-script.script_id
     1086               buf_temp-edge.to-script_id = buf_tt-rule-script.end-script_id
     1087               buf_temp-edge.edge-type = "next"
     1088               .
     1089             end.
     1090             else do:
     1091               create buf_temp-edge.
     1092               assign
     1093               buf_temp-edge.from-script_id = buf_rule-script.script_id
     1094               buf_temp-edge.to-script_id = -1
     1095               buf_temp-edge.edge-type = "next"
     1096               .
     1097             end.
     1098           end.
     1099         end.
     1100       end.
     1101     end case.
     1102   end.
     1103   end procedure.
     1104   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1105   procedure display-prop-script :
     1106   define parameter buffer buf_prop-script for ub.prop-script.
     1107     do
     1108     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1109     :
     1110       if buf_prop-script.script-type = 'ifunction':U then do:
     1111         run temp-string_write in this-procedure ( input buf_prop-script.script-body ).
     1112       end.
     1113       else do:
     1114         if lookup(buf_prop-script.proc-type, 'class,data-member,property,method,constructor,destructor':u) > 0 then do:
     1115         end.
     1116         else do:
     1117           run temp-string_write in this-procedure ( input buf_prop-script.script-head ).
     1118           run temp-string_write in this-procedure ( input buf_prop-script.script-body ).
     1119           run temp-string_write in this-procedure ( input buf_prop-script.script-foot ).
     1120         end.
     1121       end.
     1122     end.
     1123   end procedure.
     1124   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1125   procedure display-rule-call-params :
     1126   define input parameter p-mode as character no-undo .
     1127   define input parameter p-codex-id as integer no-undo .
     1128   define input parameter p-ruleset-id as integer no-undo .
     1129   define input parameter p-call-id as character no-undo .
     1130   define input parameter p-once-more as integer no-undo .
     1131   define input parameter p-order-id as integer no-undo .
     1132   define input parameter p-handle as handle no-undo .
     1133   define buffer buf_rule-call-param for ub.rule-call-param.
     1134   define variable v-string as character no-undo .
     1135   do
     1136   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1137   :
     1138     run temp-string_write in p-handle ( input "ПАРАМЕТРЫ").
     1139     if p-mode = "text"
     1140     or p-mode = "text-temp"
     1141     then do:
     1142       run temp-string_write in p-handle ( input "").
     1143     end.
     1144     _rr:
     1145     for each buf_rule-call-param no-lock where
     1146             buf_rule-call-param.codex_id = p-codex-id
     1147         and buf_rule-call-param.ruleset_id = p-ruleset-id
     1148         and buf_rule-call-param.call_id = p-call-id
     1149         and buf_rule-call-param.order_id = p-order-id:
     1150       if p-once-more >= 0 and
     1151       buf_rule-call-param.once-more <> p-once-more then next.
     1152       v-string = '':U.
     1153       if lookup("LIST", buf_rule-call-param.param-3-data-type) > 0 then do:
     1154         if buf_rule-call-param.p-index = 0 then do:
     1155           assign
     1156           v-string = buf_rule-call-param.param-label +  chr(32)  + "=".
     1157           run temp-string_write in p-handle ( input v-string).
     1158           next _rr.
     1159         end.
     1160         else do:
     1161           assign
     1162           v-string = fill( chr(32), length(buf_rule-call-param.param-label) + 2).
     1163         end.
     1164       end.
     1165       else do:
     1166         assign
     1167         v-string = buf_rule-call-param.param-label +  chr(32)  + "=".
     1168       end.
     1169       CASE buf_rule-call-param.param-data-type:
     1170         when 'character':U then do:
     1171           v-string = v-string + buf_rule-call-param.param-value-character.
     1172         end.
     1173         when 'date':U then do:
     1174           v-string = v-string + string(buf_rule-call-param.param-value-date, "99/99/9999").
     1175         end.
     1176         when 'logical':U then do:
     1177           v-string = v-string + string(buf_rule-call-param.param-value-logical, "ДА/НЕТ").
     1178         end.
     1179         when 'decimal':U then do:
     1180           v-string = v-string + string(buf_rule-call-param.param-value-decimal).
     1181         end.
     1182         when 'integer':U then do:
     1183           v-string = v-string + string(buf_rule-call-param.param-value-integer).
     1184         end.
     1185       END CASE.
     1186       run temp-string_write in p-handle ( input v-string).
     1187     end.
     1188     if p-mode = "text"
     1189     or p-mode = "text-temp"
     1190     then do:
     1191       run temp-string_write in p-handle ( input "").
     1192     end.
     1193   end.
     1194   end procedure.
     1195   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1196   procedure display-ruledict-params :
     1197   define input parameter p-mode as character no-undo .
     1198   define input parameter p-rule-id as integer no-undo .
     1199   define buffer buf_ruledict-param for ub.ruledict-param.
     1200   define buffer buf_ruledict for ub.ruledict.
     1201   define buffer buf_rule for ub.rule.
     1202   define variable v-string as character no-undo .
     1203   do
     1204   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1205   :
     1206     find first buf_rule no-lock where
     1207               buf_rule.rule_id = p-rule-id.
     1208     find first buf_ruledict no-lock where
     1209               buf_ruledict.entry-type = 'rule':U
     1210           and buf_ruledict.uniq-key-rec = buf_rule.uniq-key-rec.
     1211     run temp-string_write in this-procedure ( input "ПАРАМЕТРЫ").
     1212     if p-mode = "text" then do:
     1213       run temp-string_write in this-procedure ( input "").
     1214     end.
     1215     for each buf_ruledict-param no-lock where
     1216             buf_ruledict-param.entry-id = buf_ruledict.entry-id:
     1217       assign
     1218       v-string = substitute("&1 (&2) (&3)"
     1219                             , buf_ruledict-param.param-label
     1220                             , buf_ruledict-param.param-data-type
     1221                             , buf_ruledict-param.param-name).
     1222       run temp-string_write in this-procedure ( input v-string).
     1223     end.
     1224   end.
     1225   end procedure.
     1226   DEFINE VARIABLE v-level AS INTEGER NO-UNDO.
     1227   run temp-string_clear in this-procedure .
     1228   CASE P-DISPLAY-MODE:
     1229     WHEN "TEXT" THEN DO:
     1230       if p-call-id = '':U
     1231       or p-ruleset-id = 0 then do:
     1232         RUN display-ruledict-params IN THIS-PROCEDURE (
     1233                                                          input p-display-mode
     1234                                                         ,input p-rule-id).
     1235       end.
     1236       else do:
     1237         RUN display-rule-call-params IN THIS-PROCEDURE (
     1238                                                            input p-display-mode
     1239                                                           ,INPUT p-codex-id
     1240                                                           ,INPUT p-ruleset-id
     1241                                                           ,INPUT p-call-id
     1242                                                           ,input -1
     1243                                                           ,INPUT p-order-id
     1244                                                           ,input this-procedure:handle
     1245                                                           ).
     1246      end.
     1247        run display-rule in this-procedure ( input p-rule-id
     1248                                         , input 0
     1249                                         , input "rus":U
     1250                                         , input-output v-level).
     1251        run gbl/notese.w ( INPUT THIS-PROCEDURE:HANDLE
     1252                             ,input substitute("Содержание правила &1", p-rule-id)).
     1253     END.
     1254     WHEN "GRAPH" THEN DO:
     1255         run rul/grafdisp.p ( input p-rule-id
     1256                             ,input "RUS"
     1257                              ).
     1258     END.
     1259   END CASE.
     1260   PROCEDURE request-add-line :
     1261   DEFINE INPUT PARAMETER p-notes-handle AS HANDLE NO-UNDO.
     1262   DEFINE BUFFER buf_temp-string FOR temp-string.
     1263   for each buf_temp-string:
     1264       RUN add-line IN p-notes-handle ( INPUT buf_temp-string.v-string).
     1265       RUN add-line IN p-notes-handle ( INPUT chr(10)).
     1266     end.
     1267   END PROCEDURE.
