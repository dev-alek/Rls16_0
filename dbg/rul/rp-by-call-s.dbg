        1   DEFINE BUFFER X_rp-by-call FOR ub.rp-by-call.
        2   DEFINE BUFFER X_rule FOR ub.rule.
        3   DEFINE BUFFER X_rule-by-profile FOR ub.rule-by-profile.
        4   DEFINE BUFFER X_rule-profile FOR ub.rule-profile.
        5   define input parameter parparentproc as widget-handle no-undo .
        6   define input parameter bttns as character no-undo.
        7   DEFINE INPUT PARAMETER p-list-mode AS CHARACTER NO-UNDO.
        8   DEFINE INPUT PARAMETER p-profile-id AS INTEGER NO-UNDO.
        9   DEFINE INPUT PARAMETER p-profile-type as character NO-UNDO.
       10   define input parameter p-call-id as character no-undo .
       11   define input parameter p-codex-id as integer no-undo .
       12   define input parameter p-ruleset-id as integer no-undo .
       13   define input-output parameter p-rid-list as character no-undo.
       14   define variable vss-revision    as character no-undo init "$Revision$":U .
       15   define variable vss-author      as character no-undo init "$Author$":U .
       16   define variable vss-date        as character no-undo init "$Date$":U .
       17   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       18   define variable vss-archive     as character no-undo init "$Archive$":U .
       19   define variable vss-description as character no-undo init "Список rp-by-call".
       20   procedure vss-get-info :
       21     define output parameter p-vss-revision    like vss-revision    no-undo .
       22     define output parameter p-vss-author      like vss-author      no-undo .
       23     define output parameter p-vss-date        like vss-date        no-undo .
       24     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       25     define output parameter p-vss-archive     like vss-archive     no-undo .
       26     define output parameter p-vss-description like vss-description no-undo .
       27     assign
       28       p-vss-revision    = vss-revision
       29       p-vss-author      = vss-author
       30       p-vss-date        = vss-date
       31       p-vss-workfile    = vss-workfile
       32       p-vss-archive     = vss-archive
       33       p-vss-description = vss-description
       34     .
       35   end procedure.
       36   procedure vss-get-parameters :
       37     define output parameter p-vss-parameters as character no-undo .
       38   end procedure.
       39   define new global shared variable g#vssrevis-logger as handle    no-undo .
       40   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       41   define variable v-vssrevis-logger                   as handle    no-undo .
       42   procedure vss-logevent :
       43     define input  parameter p-extra-paramters as character no-undo .
       44     define variable v-vssrevis-parameters as character no-undo .
       45     do
       46     on error undo, return error return-value
       47     :
       48       if  valid-handle(v-vssrevis-logger)
       49       and v-vssrevis-logger :get-signature("logevent") <> ""
       50       then do:
       51         run vss-get-parameters in this-procedure
       52           (output v-vssrevis-parameters
       53           ).
       54         run logevent in v-vssrevis-logger
       55           (input vss-workfile
       56           ,input vss-revision
       57           ,input v-vssrevis-parameters
       58           ,input p-extra-paramters
       59           ).
       60       end.
       61     end.
       62   end procedure.
       63   assign
       64     v-vssrevis-logger = g#vssrevis-logger
       65   .
       66   if  valid-handle(v-vssrevis-logger)
       67   and v-vssrevis-logger :get-signature("logevent") <> ""
       68   then do:
       69     assign
       70       v-vssrevis-logevent = true
       71     .
       72     run vss-logevent in this-procedure (input vss-description) .
       73   end.
       74   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       75   define variable v-waitfram-action01         as character   no-undo .
       76   define variable v-waitfram-action02         as character   no-undo .
       77   define variable v-waitfram-action03         as character   no-undo .
       78   define variable mWaitFramTextBeg            as character   no-undo.
       79   define variable mWaitFramTextEnd            as character   no-undo.
       80   define variable mWaitFramView               as logical     no-undo.
       81   define variable mWaitProcEvent              as logical     no-undo init yes.
       82   define variable mWaitFramInterval           as integer     no-undo init 1 .
       83   define variable mWaitFramStop               as logical     no-undo.
       84   define variable mWaitFramStopUser           as logical     no-undo.
       85   define variable mWaitFramStopTimeOut        as logical     no-undo.
       86   define variable mWaitFramStartProc          as datetime-tz no-undo.
       87   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       88   define button B-WaitFramStop auto-end-key
       89        label "Стоп"
       90        size 10 by 1 tooltip "Остоновить процесс".
       91   define button B-viewProcInfo
       92        label "Информация"
       93        size 15 by 1 tooltip "Информация о процесс".
       94   define frame waitfram
       95     v-waitfram-action01 format "x(72)" no-label skip
       96     v-waitfram-action02 format "x(72)" no-label skip
       97     v-waitfram-action03 format "x(72)" no-label skip
       98     B-viewProcInfo
       99     B-WaitFramStop at row 4 col 30
      100     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      101     .
      102   define new global shared variable mBatchMode as logical no-undo init ?.
      103   define variable mFramBachModHandle as handle no-undo.
      104   mFramBachModHandle = frame waitfram:handle.
      105   define variable mFameOldVis as logical no-undo.
      106   define variable mVisCUrentVin as logical no-undo.
      107   if session:batch-mode
      108   then
      109      mBatchMode = yes.
      110   if mBatchMode = ? then do:
      111     mVisCUrentVin = current-window:visible.
      112     mFameOldVis = mFramBachModHandle:visible.
      113     mFramBachModHandle:visible  = yes.
      114     mBatchMode = mFramBachModHandle:visible ne yes.
      115     mFramBachModHandle:visible = mFameOldVis.
      116     current-window:visible = mVisCUrentVin.
      117   end.
      118    if  log-manager:logfile-name ne ?
      119     then DO:
      120         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      121         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      122         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      123     end.
      124   on choose of B-WaitFramStop in frame waitfram
      125   do:
      126     mWaitFramStop = yes.
      127     mWaitFramStopUser = yes.
      128   end.
      129   function waitfram-check-timeout returns logical():
      130      define variable vtime as int64 no-undo.
      131      if mWaitFramStopTimeOut
      132      then
      133         return yes.
      134      vtime = ( now - mWaitFramStartProc ) / 1000 .
      135      if     mWaitFramTimeOut ne ?
      136         and mWaitFramTimeOut ne 0
      137         and mWaitFramTimeOut lt vtime
      138      then do:
      139         mWaitFramStopTimeOut = yes.
      140      end.
      141      return mWaitFramStopTimeOut.
      142   end.
      143   procedure waitfram-hide :
      144     if not session:batch-mode
      145     then do
      146     on error undo, return error return-value
      147     :
      148       pause 0 before-hide .
      149       if not mBatchMode then
      150         hide frame waitfram .
      151     if     not mWaitFramView
      152        and mWaitProcEvent
      153     then
      154       process events .
      155     end.
      156   end procedure.
      157   procedure waitfram-show :
      158     define input  parameter p-message as character no-undo .
      159     define variable v-left-margin as integer   no-undo .
      160     if not session:batch-mode
      161     then do
      162     on error undo, return error return-value
      163     :
      164       if length(p-message) <= 70 then do:
      165         assign
      166           v-left-margin = integer((70 - length(p-message)) / 2)
      167         .
      168         assign
      169           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      170         .
      171         assign
      172           v-waitfram-action01 = " "
      173           v-waitfram-action02 = " "
      174                                    + fill(" ", v-left-margin)
      175                                    + p-message
      176           v-waitfram-action03 = " "
      177         .
      178       end.
      179       else do:
      180         define variable vRindex1 as integer no-undo.
      181         define variable vRindex2 as integer no-undo.
      182         vRindex1 = r-index(p-message," ",70).
      183         if vRindex1 = 0
      184         then
      185            vRindex1 = 70.
      186         if length(p-message)  <= vRindex1 + 70 then do:
      187           assign
      188             v-waitfram-action01 = " "
      189             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      190             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      191           .
      192         end.
      193         else do:
      194           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      195           if vRindex2 <= vRindex1
      196           then
      197              vRindex2 = vRindex1 + 70.
      198           assign
      199             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      200             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      201             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      202           .
      203         end.
      204       end.
      205       B-viewProcInfo:visible   in frame waitfram = no.
      206       B-viewProcInfo:sensitive in frame waitfram = no.
      207       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      208       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      209       if  (   mWaitFramView
      210          or  mWaitProcEvent)
      211          and not mBatchMode
      212       then
      213          display
      214             v-waitfram-action01 skip
      215             v-waitfram-action02 skip
      216             v-waitfram-action03 skip
      217          with frame waitfram .
      218       if     mWaitFramView
      219          then do:
      220             if     mWaitFramInterval ne ?
      221                and not mBatchMode
      222             then
      223                wait-for go of frame waitfram pause mWaitFramInterval.
      224          end.
      225          else
      226             if     mWaitProcEvent
      227                and not mBatchMode
      228             then
      229                process events .
      230     end.
      231   end procedure.
      232      procedure waitfram-show-this:
      233         define input  parameter iInterval as int64 no-undo.
      234         define variable vtime as int64 no-undo.
      235         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      236         mWaitFramInterval = iInterval.
      237         run waitfram-show (substitute("&1&2 &3&4" ,
      238                                       mWaitFramTextBeg ,
      239                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      240                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      241                                       mWaitFramTextEnd
      242                                      )
      243                           ).
      244      end.
      245      procedure WaitFramRunPause:
      246         define input  parameter iInterval as dec no-undo.
      247         define variable vStart  as datetime-tz no-undo.
      248         define variable vend    as datetime-tz no-undo.
      249         define variable vint as int64 no-undo.
      250         define variable vOk as logical no-undo.
      251         vStart = now.
      252         vend   = vStart.
      253         publish "WaitFramPause" (iInterval,output vOk).
      254         vend   =  now.
      255         vint = vend - vStart.
      256         vint = iInterval - vint / 1000.
      257         if     not mWaitFramStop
      258            and (   vint > 0
      259                 or (    not vOk
      260                     and iInterval eq ?
      261                     )
      262                 )
      263         then
      264            run waitfram-show-this (iInterval).
      265         vend   =  now.
      266         vint = vend - vStart.
      267         vint = iInterval - vint / 1000.
      268         if     not mWaitFramStop
      269            and vint > 0
      270         then do:
      271            run gbl/pause.p (vint * 1000).
      272         end.
      273         if iInterval ne ?
      274         then
      275            publish "WaitFramStop".
      276         waitfram-check-timeout().
      277      end.
      278      procedure WaitFramWaitFor:
      279         define input  parameter iInterval as dec no-undo.
      280         assign
      281            mWaitFramStartProc   = now
      282            mWaitFramStopUser    = no
      283            mWaitFramStopTimeOut = no
      284         .
      285         block-wait:
      286         do while not mWaitFramStop:
      287            run WaitFramRunPause (iInterval).
      288            if  waitfram-check-timeout()
      289            then do:
      290               leave block-wait.
      291            end.
      292         end.
      293         run waitfram-hide.
      294      end.
      295   procedure waitfram-join :
      296     define input  parameter p-line-1  as character no-undo .
      297     define input  parameter p-line-2  as character no-undo .
      298     define input  parameter p-line-3  as character no-undo .
      299     define output parameter p-message as character no-undo .
      300     do
      301     on error undo, return error return-value
      302     :
      303       assign
      304         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      305                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      306                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      307       .
      308     end.
      309   end procedure.
      310   function waitfram-join-function returns character
      311     (input p-line-1 as character
      312     ,input p-line-2 as character
      313     ,input p-line-3 as character
      314     ).
      315     define variable v-message as character no-undo .
      316     run waitfram-join in this-procedure
      317       (input  p-line-1
      318       ,input  p-line-2
      319       ,input  p-line-3
      320       ,output v-message
      321       ) .
      322     return v-message .
      323   end function .
      324   define new global shared variable g#language as character no-undo .
      325   if g#language <> '' and g#language <> 'rus':U then do:
      326     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      327   end.
      328   procedure proc-alt-shift-f2:
      329     if not ibs.th.gbl.gbl-var:rcode
      330   then
      331     run gbl\inidebug.p .
      332   end.
      333   procedure proc-alt-shift-f3:
      334     run gbl/prvssinf.p
      335       ( input this-procedure
      336       ) .
      337   end.
      338   define variable v-inform-launched as logical no-undo initial false .
      339   procedure proc-alt-shift-f4:
      340     define variable v-action as character no-undo .
      341     if v-inform-launched = false then do:
      342       assign
      343         v-inform-launched = true
      344       .
      345       run gbl/d-inform.w
      346         (  input self
      347         ,  input this-procedure
      348         , output v-action
      349         ) no-error .
      350       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      351       assign
      352         v-inform-launched = false
      353       .
      354     end.
      355   end.
      356   procedure proc-alt-f1:
      357     run gbl/corrhelp.p
      358       (input this-procedure
      359       ) .
      360   end .
      361   on alt-shift-f2 anywhere do:
      362     run proc-alt-shift-f2.
      363   end.
      364   on alt-shift-f3 anywhere do:
      365     run proc-alt-shift-f3 in this-procedure .
      366   end.
      367   on alt-shift-f4 anywhere do:
      368     run proc-alt-shift-f4 in this-procedure.
      369   end.
      370   on alt-f1 anywhere do:
      371     run proc-alt-f1 in this-procedure .
      372   end.
      373   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      374     define variable v-cntxt-db-num        as integer   no-undo .
      375     define variable v-cntxt-userid        as character no-undo .
      376     define variable v-cntxt-level         as character no-undo .
      377     define variable v-cntxt-host-code-obj as integer   no-undo .
      378     define variable v-cntxt-obj-type      as character no-undo .
      379     define variable v-cntxt-obj-code      as integer   no-undo .
      380     define variable v-cntxt-db-num-obj    as integer   no-undo .
      381     define variable v-cntxt-is-admin      as logical   no-undo .
      382   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      383   FUNCTION mark-string RETURNS CHARACTER
      384     ( input p-recid as recid, input mark-list as character  ) :
      385     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      386   END FUNCTION.
      387   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      388   procedure gen-key-rec :
      389     define input  parameter p-tbl-name    as character no-undo.
      390     define input  parameter p-bh_tbl-name as handle    no-undo.
      391     define output parameter p-key-rec     as character no-undo.
      392     do
      393     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      394     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      395     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      396     :
      397       define variable fh               as handle    no-undo .
      398       define variable v-ok             as logical   no-undo .
      399       define variable v-inform         as character no-undo .
      400       define variable v-ind            as integer   no-undo .
      401       define variable v-idx-field-qnty as integer   no-undo .
      402       if p-tbl-name = ?
      403         or p-tbl-name = "":U
      404       then do:
      405         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info3 ).
      406       end.
      407       if not p-bh_tbl-name:available then do:
      408         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info3, p-tbl-name ).
      409       end.
      410       assign
      411         p-key-rec = p-tbl-name
      412         v-inform  = p-bh_tbl-name:index-information(1)
      413         v-ind     = 2
      414       .
      415       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      416       on error undo, return error
      417       :
      418         assign
      419           v-inform = p-bh_tbl-name:index-information( v-ind )
      420           v-ind    = v-ind + 1
      421         .
      422       end.
      423       if v-inform = ?
      424         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      425         or entry( 3, v-inform, ",":U ) <> "1":U
      426       then do:
      427         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, p-tbl-name ).
      428       end.
      429       else do:
      430         assign
      431           v-idx-field-qnty = num-entries( v-inform ) - 4
      432         .
      433         if v-idx-field-qnty < 2 then do:
      434           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, p-tbl-name ).
      435         end.
      436         do v-ind = 1 to v-idx-field-qnty by 2
      437         on error undo, return error
      438         :
      439           assign
      440             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      441             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      442           .
      443         end.
      444       end.
      445       if p-key-rec = ? then do:
      446         assign
      447           p-key-rec = "":U
      448         .
      449         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info3, p-tbl-name ).
      450       end.
      451     end.
      452     return.
      453   end procedure.
      454   procedure gen-where-keyr-tab :
      455     define input  parameter i-tableSerach as character no-undo.
      456     define input  parameter i-tablekey   as character  no-undo.
      457     define input  parameter p-key-rec    as character  no-undo.
      458     define input  parameter p-key-handle as handle     no-undo .
      459     define input  parameter p-db-name    as character  no-undo .
      460     define input  parameter p-tt-handle  as handle     no-undo .
      461     define output parameter o-Where      as character  no-undo.
      462     do
      463     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      464     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      465     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      466     :
      467       define variable v-full-tbl-name  as character no-undo .
      468       define variable bh_tbl-name      as handle    no-undo .
      469       define variable fh_key           as handle    no-undo .
      470       define variable fh_search        as handle    no-undo .
      471       define variable v-field-num      as integer   no-undo .
      472       define variable v-count-fld      as integer   no-undo .
      473       define variable v-inform         as character no-undo .
      474       define variable v-ind            as integer   no-undo .
      475       define variable v-idx-field-qnty as integer   no-undo .
      476       define variable v-field-name     as character no-undo .
      477       define variable v-field-val      as character no-undo .
      478       define variable v-word-link      as character no-undo .
      479       define variable vTable           as character no-undo.
      480       define variable bh_tbl-key       as handle    no-undo .
      481       assign
      482         p-key-rec = trim( p-key-rec )
      483       .
      484       if p-key-handle <> ? then do:
      485         if not valid-handle(p-key-handle)
      486            or p-key-handle:type <> "buffer"
      487         then do:
      488           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info3 ).
      489         end.
      490         if num-entries( p-key-rec, chr(3) ) > 1
      491           or p-key-rec = ?
      492           or p-key-rec = "":U
      493         then do:
      494           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info3, p-key-rec ).
      495         end.
      496       end.
      497       else do:
      498         if p-key-rec = ?
      499           or p-key-rec = "":U
      500         then do:
      501           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      502         end.
      503       end.
      504       assign
      505         vTable = entry( 1 , p-key-rec, chr(3) )
      506       .
      507       if p-tt-handle <> ?
      508         and ( not valid-handle(p-tt-handle)
      509               or p-tt-handle:type <> "buffer"
      510             )
      511       then do:
      512         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info3, vTable, chr(10) ).
      513       end.
      514       if p-tt-handle = ? then do:
      515         assign
      516           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      517         .
      518         create buffer bh_tbl-name for table v-full-tbl-name .
      519       end.
      520       else do:
      521         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      522       end.
      523       assign
      524         v-inform = bh_tbl-name:index-information(1)
      525         v-ind    = 2
      526       .
      527       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      528       on error undo, return error
      529       :
      530         assign
      531           v-inform = bh_tbl-name:index-information( v-ind )
      532           v-ind    = v-ind + 1
      533         .
      534       end.
      535       if v-inform = ?
      536         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      537         or entry( 3, v-inform, ",":U ) <> "1":U
      538       then do:
      539         delete object bh_tbl-name no-error.
      540         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info3, vTable ).
      541       end.
      542       assign
      543         v-idx-field-qnty = num-entries( v-inform ) - 4
      544       .
      545       if v-idx-field-qnty < 2 then do:
      546         delete object bh_tbl-name no-error.
      547         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, vTable ).
      548       end.
      549       assign
      550         o-where     = "where":U
      551         v-word-link = "":U
      552         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      553         v-count-fld = 0
      554       .
      555       if i-tablekey ne "" and i-tablekey ne ?
      556       then do:
      557         assign
      558           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      559         .
      560         create buffer bh_tbl-key for table v-full-tbl-name .
      561       end.
      562       if i-tableSerach ne "" and i-tableSerach ne ?
      563       then do:
      564         delete object bh_tbl-name no-error.
      565         assign
      566           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      567         .
      568         create buffer bh_tbl-name for table v-full-tbl-name .
      569       end.
      570       block_where:
      571       do v-ind = 1 to v-idx-field-qnty by 2
      572       on error undo, return error
      573       :
      574         assign
      575           v-count-fld = v-count-fld + 1
      576         .
      577         if p-key-handle = ?
      578           and v-count-fld > v-field-num
      579         then do:
      580           leave block_where.
      581         end.
      582         define variable VfieldKeyTable as handle no-undo.
      583         assign
      584           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      585           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      586         .
      587         if     bh_tbl-key ne ?
      588         then do:
      589            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      590            if VfieldKeyTable eq ?
      591            then next block_where.
      592         end.
      593         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      594         then
      595            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      596         else
      597            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      598         if p-key-handle = ? then do:
      599           assign
      600             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      601           .
      602         end.
      603         else do:
      604           assign
      605             fh_key = p-key-handle:buffer-field( v-field-name )
      606           .
      607           if fh_key = ?
      608             or not valid-handle( fh_key )
      609           then do:
      610             delete object bh_tbl-name.
      611             if     bh_tbl-key ne ?
      612             then
      613                delete object bh_tbl-key.
      614             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info3, p-key-handle:name, v-field-name ).
      615           end.
      616           assign
      617             v-field-val = fh_key:buffer-value
      618           .
      619         end.
      620         if fh_search:data-type ="character":U then do:
      621           assign
      622             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      623             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      624             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      625             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      626             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      627             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      628             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      629             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      630             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      631             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      632             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      633             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      634             v-field-val = substitute( '"&1"', v-field-val )
      635           .
      636         end.
      637         assign
      638           o-where = substitute( "&1 &2", o-where, v-field-val )
      639         .
      640         if v-word-link = "":U then do:
      641           assign
      642             v-word-link = "and":U
      643           .
      644         end.
      645       end.
      646       delete object bh_tbl-name.
      647       if     bh_tbl-key ne ?
      648       then
      649          delete object bh_tbl-key.
      650       if p-key-handle = ?
      651         and v-count-fld <> v-field-num
      652       then do:
      653         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info3, vTable ).
      654       end.
      655     end.
      656   end procedure.
      657   procedure gen-hn-keyr-tab :
      658     define input  parameter i-tableSerach as character no-undo.
      659     define input  parameter i-tablekey   as character no-undo.
      660     define input  parameter p-key-rec    as character no-undo.
      661     define input  parameter p-key-handle as handle    no-undo .
      662     define input  parameter p-db-name    as character no-undo .
      663     define input  parameter p-tt-handle  as handle    no-undo .
      664     define input  parameter p-stts-lock  as integer   no-undo .
      665     define output parameter o-hn         as handle    no-undo.
      666     define variable v-full-tbl-name as character no-undo.
      667     define variable v-where         as character no-undo.
      668     define variable bh_tbl-name     as handle    no-undo.
      669     define variable vTable          as character no-undo.
      670     do
      671     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      672     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      673     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      674         run gen-where-keyr-tab(i-tableSerach,
      675                                i-tablekey,
      676                                p-key-rec,
      677                                p-key-handle,
      678                                p-db-name,
      679                                p-tt-handle,
      680                                output v-where).
      681         if i-tableSerach ne "" and i-tableSerach ne ?
      682         then do:
      683            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      684            create buffer bh_tbl-name for table v-full-tbl-name .
      685         end.
      686         else do:
      687            if p-tt-handle = ? then do:
      688               assign
      689                  vTable = entry( 1 , p-key-rec, chr(3) )
      690               .
      691               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      692               create buffer bh_tbl-name for table v-full-tbl-name .
      693            end.
      694            else do:
      695               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      696            end.
      697         end.
      698         if p-tt-handle = ? then do:
      699            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      700         end.
      701         else do:
      702            bh_tbl-name:find-first( v-where ) no-error .
      703         end.
      704         o-hn = bh_tbl-name.
      705      end.
      706   end procedure.
      707   procedure gen-hn-keyr :
      708     define input  parameter p-key-rec    as character no-undo.
      709     define input  parameter p-key-handle as handle    no-undo .
      710     define input  parameter p-db-name    as character no-undo .
      711     define input  parameter p-tt-handle  as handle    no-undo .
      712     define input  parameter p-stts-lock  as integer   no-undo .
      713     define output parameter o-hn         as handle    no-undo.
      714     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      715   end.
      716   procedure gen-row-keyr :
      717     define input  parameter p-key-rec    as character no-undo.
      718     define input  parameter p-key-handle as handle    no-undo .
      719     define input  parameter p-db-name    as character no-undo .
      720     define input  parameter p-tt-handle  as handle    no-undo .
      721     define input  parameter p-stts-lock  as integer   no-undo .
      722     define output parameter p-tbl-row    as rowid     no-undo.
      723     define output parameter p-tbl-name   as character no-undo.
      724     define variable vHn as handle no-undo.
      725       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      726       p-tbl-row = if vHn:available then vHn:rowid else ?.
      727       p-tbl-name =  vHn:table.
      728       delete object vHn no-error.
      729     if p-tbl-row = ? then do:
      730       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info3, p-tbl-name, p-key-rec ).
      731     end.
      732     else do:
      733       return.
      734     end.
      735   end procedure.
      736   procedure gen-key-fv :
      737     define input  parameter p-key-rec    as character no-undo .
      738     define output parameter p-field-list as character no-undo .
      739     define output parameter p-value-list as character no-undo.
      740     do
      741     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      742     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      743     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      744     :
      745       define variable v-full-tbl-name  as character no-undo .
      746       define variable bh_tbl-name      as handle    no-undo .
      747       define variable v-tbl-name       as character no-undo .
      748       define variable v-field-num      as integer   no-undo .
      749       define variable v-count-fld      as integer   no-undo .
      750       define variable v-inform         as character no-undo .
      751       define variable v-ind            as integer   no-undo .
      752       define variable v-idx-field-qnty as integer   no-undo .
      753       define variable v-delim-key      as character no-undo .
      754       if p-key-rec = ?
      755         or p-key-rec = "":U
      756       then do:
      757         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      758       end.
      759       assign
      760         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      761         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      762       .
      763       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      764       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info3 ).
      765       assign
      766         v-inform = bh_tbl-name:index-information(1)
      767         v-ind    = 2
      768       .
      769       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      770       on error undo, return error
      771       :
      772         assign
      773           v-inform = bh_tbl-name:index-information( v-ind )
      774           v-ind    = v-ind + 1
      775         .
      776       end.
      777       if v-inform = ?
      778         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      779         or entry( 3, v-inform, ",":U ) <> "1":U
      780       then do:
      781         delete object bh_tbl-name no-error.
      782         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
      783       end.
      784       assign
      785         v-idx-field-qnty = num-entries( v-inform ) - 4
      786       .
      787       if v-idx-field-qnty < 2 then do:
      788         delete object bh_tbl-name no-error.
      789         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
      790       end.
      791       assign
      792         p-field-list = "":U
      793         p-value-list = "":U
      794         v-delim-key  = "":U
      795         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      796         v-count-fld  = 0
      797       .
      798       block_where:
      799       do v-ind = 1 to v-idx-field-qnty by 2
      800       on error undo, return error
      801       :
      802         assign
      803           v-count-fld = v-count-fld + 1
      804         .
      805         if v-count-fld > v-field-num then do:
      806           leave block_where.
      807         end.
      808         assign
      809           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      810           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      811         .
      812         if v-ind = 1 then do:
      813           assign
      814             v-delim-key = chr(3)
      815           .
      816         end.
      817       end.
      818       delete object bh_tbl-name.
      819       if v-count-fld <> v-field-num then do:
      820         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info3, v-tbl-name ).
      821       end.
      822     end.
      823   end procedure.
      824   procedure gen-key-field :
      825     define input  parameter p-table      as character no-undo .
      826     define output parameter p-field-list as character no-undo .
      827     do
      828     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      829     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      830     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      831     :
      832       define variable v-full-tbl-name  as character no-undo .
      833       define variable bh_tbl-name      as handle    no-undo .
      834       define variable v-tbl-name       as character no-undo .
      835       define variable v-field-num      as integer   no-undo .
      836       define variable v-count-fld      as integer   no-undo .
      837       define variable v-inform         as character no-undo .
      838       define variable v-ind            as integer   no-undo .
      839       define variable v-idx-field-qnty as integer   no-undo .
      840       define variable v-delim-key      as character no-undo .
      841       if p-table = ?
      842         or p-table = "":U
      843       then do:
      844         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info3 ).
      845       end.
      846       assign
      847         v-tbl-name      = p-table
      848         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      849       .
      850       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      851       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info3 ).
      852       assign
      853         v-inform = bh_tbl-name:index-information(1)
      854         v-ind    = 2
      855       .
      856       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      857       on error undo, return error
      858       :
      859         assign
      860           v-inform = bh_tbl-name:index-information( v-ind )
      861           v-ind    = v-ind + 1
      862         .
      863       end.
      864       if v-inform = ?
      865         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      866         or entry( 3, v-inform, ",":U ) <> "1":U
      867       then do:
      868         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
      869       end.
      870       assign
      871         v-idx-field-qnty = num-entries( v-inform ) - 4
      872       .
      873       if v-idx-field-qnty < 2 then do:
      874         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
      875       end.
      876       assign
      877         p-field-list = "":U
      878         v-delim-key  = "":U
      879         v-count-fld  = 0
      880       .
      881       block_where:
      882       do v-ind = 1 to v-idx-field-qnty by 2
      883       on error undo, return error
      884       :
      885         assign
      886           v-count-fld = v-count-fld + 1
      887         .
      888         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      889         if v-ind = 1 then do:
      890           assign
      891             v-delim-key = chr(3)
      892           .
      893         end.
      894       end.
      895       delete object bh_tbl-name.
      896     end.
      897   end procedure.
      898   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      899   def var vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      900   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      901   FUNCTION get-region RETURNS CHARACTER
      902     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
      903     define variable par-region as character no-undo.
      904     if parhost-code = 0 and
      905          parobj-type = "":U and
      906          parobj-code = 0 then do:
      907          par-region = "Глобально".
      908          return par-region.
      909       end.
      910       if parobj-type = 'орг':U then do:
      911          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
      912          return par-region.
      913       end.
      914       if parobj-type = 'регион':U
      915       then do:
      916          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      917          return par-region.
      918       end.
      919       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      920       return par-region.
      921   END FUNCTION.
      922   FUNCTION get-objregion RETURNS CHARACTER
      923     (  input parobj-type as character, input parobj-code as integer ) :
      924     define variable par-region as character no-undo.
      925     if  parobj-type = "":U and
      926         parobj-code = 0
      927     then do:
      928        par-region = "Глобально".
      929     end.
      930     else if parobj-type = 'орг':U
      931     then do:
      932        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
      933     end.
      934     else if parobj-type = 'регион':U
      935     then do:
      936        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      937     end.
      938     else
      939        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      940     return par-region.
      941   END FUNCTION.
      942   FUNCTION calldscr returns character ( input p-call-id as character):
      943   define variable v-descr as character no-undo .
      944   define variable v-field-list as character no-undo .
      945   define variable v-value-list as character no-undo.
      946   define variable v-prop-label as character no-undo .
      947   define variable v-node-label as character no-undo .
      948   define variable v-dt-code as integer no-undo .
      949   define variable v-host-code as integer no-undo .
      950   define variable v-obj-type as character no-undo .
      951   define variable v-obj-code as integer no-undo .
      952   define variable v-label as character no-undo .
      953   define variable v-node-code as integer no-undo .
      954   define buffer buf_prop-head for ub.prop-head.
      955   define buffer buf_prop-ref for ub.prop-ref.
      956   define buffer buf_prop-map for ub.prop-map.
      957   run gen-key-fv in this-procedure ( input p-call-id
      958                                     ,output v-field-list
      959                                     ,output v-value-list) no-error .
      960   if error-status:error then return p-call-id.
      961   CASE entry(1, p-call-id, chr(3)):
      962     when 'dis-card-type':U then do:
      963       v-descr = substitute("Тип ДК: эмитент &1 тип: &2"
      964                            ,integer(entry(lookup("emitent-host-code", v-field-list, chr(3)), v-value-list, chr(3)) )
      965                            ,entry(lookup("type", v-field-list, chr(3)), v-value-list, chr(3))
      966                            ).
      967     end.
      968     when 'dis-card':U then do:
      969       v-descr = substitute("ДК: № &1"
      970                            ,entry(lookup("d-card", v-field-list, chr(3)), v-value-list, chr(3))
      971                            ).
      972     end.
      973     when 'dis-card-property':U then do:
      974       v-dt-code = integer(entry(lookup("dt-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
      975       v-node-code = integer(entry(lookup("node-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
      976       v-host-code = integer(entry(lookup("host-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
      977       v-obj-type = entry(lookup("obj-type", v-field-list, chr(3)), v-value-list, chr(3)) .
      978       v-obj-code = integer(entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
      979       find first buf_prop-ref no-lock where
      980                 buf_prop-ref.dt-code = v-dt-code no-error .
      981       if available buf_prop-ref then do:
      982         find first buf_prop-head no-lock where
      983                   buf_prop-head.dtm-code = buf_prop-ref.dtm-code no-error .
      984         v-prop-label = buf_prop-head.prop-label.
      985         find first buf_prop-map no-lock where
      986                   buf_prop-map.dtm-code = buf_prop-ref.dtm-code
      987               and buf_prop-map.node-code = v-node-code no-error .
      988         if available buf_prop-map then do:
      989           v-label = buf_prop-map.node-label.
      990         end.
      991       end.
      992       v-descr = substitute("ДК: № &1 &2:&3 &4"
      993                            ,entry(lookup("d-card", v-field-list, chr(3)), v-value-list, chr(3))
      994                            ,v-prop-label
      995                            ,v-label
      996                            ,get-region(v-host-code, v-obj-type, v-obj-code)
      997                            ).
      998     end.
      999     when 'clients':U then do:
     1000       v-descr = substitute("&1&2"
     1001                            ,entry(lookup("obj-type", v-field-list, chr(3)), v-value-list, chr(3))
     1002                            ,integer(entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3)) )
     1003                            ).
     1004     end.
     1005     when 'ext-system':U then do:
     1006       v-descr = substitute("Внешняя система &1"
     1007                            ,integer(entry(lookup("esys-id", v-field-list, chr(3)), v-value-list, chr(3)))
     1008                            ).
     1009     end.
     1010     WHEN 'thbj-attr':U then do:
     1011       if entry(lookup("upper-prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rum':U
     1012       or entry(lookup("upper-prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rum_obj':U
     1013       then do:
     1014         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'goods':U then do:
     1015           v-descr = "Операции с товарами".
     1016         end.
     1017         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'clients':U then do:
     1018           v-descr = "Операции с клиентами".
     1019         end.
     1020         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'gds-grp':U then do:
     1021           v-descr = "Операции с группами товаров".
     1022         end.
     1023         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'cli-grp':U then do:
     1024           v-descr = "Операции с группами клиентов".
     1025         end.
     1026         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'chk-doc_ibs-th':U then do:
     1027           v-descr = "Операции с чеками на POS IBS-TH".
     1028         end.
     1029         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'chk-doc_ibs-th-mob':U then do:
     1030           v-descr = "Операции с чеками на POS IBS-TH-MOB".
     1031         end.
     1032         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'edoc':U then do:
     1033           v-descr = "Операции в системе электронного документооборота".
     1034         end.
     1035         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'thref':U then do:
     1036           v-descr = "Операции со справочниками".
     1037         end.
     1038         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'pdf':U then do:
     1039           v-descr = "Операции с ДНЦ и переоценками".
     1040         end.
     1041         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rep':U then do:
     1042           v-descr = "Отчеты".
     1043         end.
     1044         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'ord':U then do:
     1045           v-descr = "Операции с заказами".
     1046         end.
     1047       end.
     1048     end.
     1049     when 'cash-desk':U then do:
     1050       v-descr = substitute("БД &1 Маг &2 Касса № &4 &3"
     1051                            ,entry(lookup("db-num", v-field-list, chr(3)), v-value-list, chr(3))
     1052                            ,entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3))
     1053                            ,entry(lookup("cash-num", v-field-list, chr(3)), v-value-list, chr(3))
     1054                            ,entry(lookup("pos-type", v-field-list, chr(3)), v-value-list, chr(3))
     1055                            ).
     1056     end.
     1057     when 'ext-file':U then do:
     1058       v-descr = substitute("БД &1 Файл № &3 (из БД &2)"
     1059                            ,entry(lookup("db-num", v-field-list, chr(3)), v-value-list, chr(3))
     1060                            ,entry(lookup("from-db-num", v-field-list, chr(3)), v-value-list, chr(3))
     1061                            ,entry(lookup("file-num", v-field-list, chr(3)), v-value-list, chr(3))
     1062                            ).
     1063     end.
     1064   end case.
     1065   return v-descr.
     1066   end function.
     1067   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1068   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
     1069   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
     1070   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
     1071   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
     1072   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
     1073   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
     1074   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
     1075   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
     1076   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
     1077   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
     1078   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
     1079   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
     1080   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
     1081   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
     1082   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
     1083   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
     1084   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
     1085   DEFINE VARIABLE v-doc-rec AS RECID NO-UNDO.
     1086   define variable v-rid-list as character no-undo .
     1087   DEFINE VARIABLE template-recid as recid no-undo.
     1088   DEFINE BUTTON b-add
     1089        LABEL "&Добавить"
     1090        SIZE 10 BY 1.
     1091   DEFINE BUTTON b-del
     1092        LABEL "&Удалить"
     1093        SIZE 10 BY 1.
     1094   DEFINE BUTTON B-Help
     1095        LABEL "Помо&щь"
     1096        SIZE 3 BY 1
     1097        BGCOLOR 8 .
     1098   DEFINE BUTTON b-mark
     1099        LABEL "&*"
     1100        SIZE 4 BY 1.
     1101   DEFINE BUTTON b-quit AUTO-END-KEY
     1102        LABEL "&Выход"
     1103        SIZE 10 BY 1
     1104        BGCOLOR 8 .
     1105   DEFINE BUTTON b-sel AUTO-GO
     1106        LABEL "Выбор"
     1107        SIZE 10 BY 1.
     1108   DEFINE VARIABLE EDITOR-1 AS CHARACTER
     1109        VIEW-AS EDITOR NO-WORD-WRAP SCROLLBAR-HORIZONTAL SCROLLBAR-VERTICAL
     1110        SIZE 98 BY 3.37 NO-UNDO.
     1111   DEFINE VARIABLE mark-num AS INTEGER FORMAT "->,>>>,>>9":U INITIAL 0
     1112         VIEW-AS TEXT
     1113        SIZE 9 BY .67
     1114        FGCOLOR 10  NO-UNDO.
     1115   DEFINE QUERY br-rp-by-call FOR
     1116         X_rp-by-call,
     1117         X_rule-profile,
     1118         X_rule-by-profile SCROLLING.
     1119   DEFINE BROWSE br-rp-by-call
     1120     QUERY br-rp-by-call NO-LOCK DISPLAY
     1121         mark-string(recid(X_rp-by-call), v-rid-list) Format "X(1)" COLUMN-LABEL "*"
     1122   X_rp-by-call.profile_id COLUMN-LABEL "Профайл" FORMAT ">>>>>>>>9"
     1123   calldscr(X_rp-by-call.call_id) COLUMN-LABEL "Вызов" FORMAT "X(255)" WIDTH 45
     1124   X_rule-profile.name COLUMN-LABEL "Название" FORMAT "X(255)" WIDTH 45
     1125   X_rule-profile.profile-type COLUMN-LABEL "Тип профайла" FORMAT "X(50)"
     1126   X_rp-by-call.once-more COLUMN-LABEL "№ привязки" FORMAT ">9"
     1127       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 17 FIT-LAST-COLUMN.
     1128   DEFINE FRAME Dialog-Frame
     1129        b-quit AT ROW 1 COL 1
     1130        b-mark AT ROW 1 COL 24 WIDGET-ID 12
     1131        b-sel AT ROW 1 COL 28 WIDGET-ID 10
     1132        b-add AT ROW 1 COL 38 WIDGET-ID 2
     1133        b-del AT ROW 1 COL 58 WIDGET-ID 8
     1134        B-Help AT ROW 1 COL 95
     1135        br-rp-by-call AT ROW 2.33 COL 1 WIDGET-ID 100
     1136        EDITOR-1 AT ROW 19.5 COL 1 NO-LABEL WIDGET-ID 16
     1137        mark-num AT ROW 1 COL 13 COLON-ALIGNED NO-LABEL WIDGET-ID 14
     1138        SPACE(75.24) SKIP(21.21)
     1139       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1140            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1141            TITLE "Привязка профайлов"
     1142            CANCEL-BUTTON b-quit.
     1143   ASSIGN
     1144          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1145          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1146   ON GO OF FRAME Dialog-Frame
     1147   DO:
     1148     p-rid-list = v-rid-list.
     1149   END.
     1150   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1151   DO:
     1152     APPLY "END-ERROR":U TO SELF.
     1153   END.
     1154   ON CHOOSE OF b-add IN FRAME Dialog-Frame
     1155   DO:
     1156     run proc-b-add in this-procedure no-error.
     1157     if error-status:error then return no-apply.
     1158   END.
     1159   ON CHOOSE OF b-del IN FRAME Dialog-Frame
     1160   DO:
     1161     define variable v-rec as recid no-undo.
     1162     define variable glog as logical no-undo.
     1163     if not available X_rp-by-call then return no-apply.
     1164     v-rec = recid(X_rp-by-call).
     1165     message "Вы уверены, что хотите удалить привязку ПРОФАЙЛА?"
     1166     view-as alert-box question buttons yes-no update glog.
     1167     if not glog then return no-apply.
     1168     run rul/rp-by-call3.p (
     1169                               input no
     1170                              ,input v-rec
     1171                                 ) no-error.
     1172     if error-status:error then return no-apply.
     1173     RUn Openbr in this-procedure .
     1174   END.
     1175   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
     1176   DO:
     1177       define variable glog as logical no-undo .
     1178     if available X_rp-by-call then do:
     1179   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1180   define variable v-str-recid9 as character no-undo .
     1181   define variable v-num-entry9 as integer   no-undo .
     1182   assign
     1183     v-str-recid9 = trim( string( recid( X_rp-by-call ) , "->>>>>>>>>>>9":U ) )
     1184     v-num-entry9 = lookup( v-str-recid9 , v-rid-list )
     1185   .
     1186   if v-num-entry9 > 0 then do:
     1187     assign
     1188       entry( v-num-entry9, v-rid-list ) = "":U
     1189       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1190     .
     1191   end.
     1192   else do:
     1193     assign
     1194       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid9
     1195     .
     1196   end.
     1197     glog = br-rp-by-call:refresh() .
     1198     if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1199         glog = br-rp-by-call:select-next-row ().
     1200         apply "VALUE-CHANGED" to br-rp-by-call in frame Dialog-Frame.
     1201     end.
     1202     if num-entries( v-rid-list ) = 0
     1203     then
     1204         hide mark-num in frame Dialog-Frame.
     1205     else
     1206         disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1207   end.
     1208   apply "entry" to br-rp-by-call in frame Dialog-Frame.
     1209   END.
     1210   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     1211   DO:
     1212     if available X_rp-by-call then do:
     1213       if  ( v-rid-list = "" ) or b-mark:sensitive = no
     1214       then  v-rid-list = string( recid( X_rp-by-call ) ) .
     1215     end.
     1216   END.
     1217   ON VALUE-CHANGED OF br-rp-by-call IN FRAME Dialog-Frame
     1218   DO:
     1219     IF AVAILABLE X_rule-profile THEN DO:
     1220       editor-1:SCREEN-VALUE = X_rule-profile.name.
     1221     END.
     1222     ELSE DO:
     1223       editor-1:SCREEN-VALUE = '':U.
     1224     END.
     1225   END.
     1226   ON ROW-DISPLAY OF br-rp-by-call IN frame Dialog-Frame
     1227   DO:
     1228     IF AVAIL X_rp-by-call THEN DO:
     1229       RUN set-row-color IN THIS-PROCEDURE ( INPUT X_rp-by-call.parent-profile_id).
     1230     END.
     1231   END.
     1232   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1233   on f5 of frame Dialog-Frame anywhere
     1234   do:
     1235      v-doc-rec = recid(X_rp-by-call).    RUn OpenBR in this-procedure.  REPOSITION br-rp-by-call to recid v-doc-rec No-ERROR.   apply 'value-changed' to br-rp-by-call.
     1236       apply "VALUE-CHANGED" to br-rp-by-call.
     1237   end.
     1238   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1239   on help of frame Dialog-Frame
     1240   do:
     1241     run gbl/app_help.p
     1242       (input this-procedure :file-name
     1243       ,input ''
     1244       ,input ?
     1245       ) no-error.
     1246     if error-status :error then do:
     1247       message
     1248         "Ошибка при вызове помощи"
     1249         error-status :get-message(1)
     1250         view-as alert-box .
     1251     end.
     1252   end.
     1253   run minbtn-set in this-procedure .
     1254   on choose of b-help in frame Dialog-Frame
     1255   do:
     1256     apply "help":u to frame Dialog-Frame .
     1257   end.
     1258   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1259   procedure minbtn-set :
     1260       do
     1261           on error undo, return error return-value
     1262           :
     1263           define variable ii              as integer       no-undo .
     1264           define variable fh              as widget-handle no-undo .
     1265           define variable hh              as widget-handle no-undo .
     1266           define variable v-h             as handle        extent 4 no-undo .
     1267           define variable v-name-button   as character     no-undo .
     1268           define variable v-help-old-x    as decimal       no-undo .
     1269           define variable v-help-old-y    as decimal       no-undo .
     1270           define variable v-help-old-size as decimal       no-undo .
     1271           define variable v-frame-width   as decimal       no-undo .
     1272           define variable jj              as integer       no-undo .
     1273           do
     1274               on error undo, return error
     1275               :
     1276               assign
     1277                   v-frame-width = frame Dialog-Frame:width - 0.3
     1278                   fh            = frame Dialog-Frame:first-child
     1279                   hh            = fh:first-child
     1280                   ii            = 1
     1281                   .
     1282               do while valid-handle(hh):
     1283                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1284                   do:
     1285                       case lc(hh:name) :
     1286                           when "b-help" then
     1287                               do:
     1288                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1289                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1290                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1291                                   hh:TOOLTIP = "Помощь" .
     1292                                   v-help-old-x = hh:column .
     1293                                   v-help-old-y = hh:row    .
     1294                                   v-help-old-size = hh:width .
     1295                                   hh:width-chars = 2.5 .
     1296                               end.
     1297                           when "b-print" then
     1298                               do:
     1299                                   hh:load-image("cmp/b-print.bmp":u) .
     1300                                   hh:TOOLTIP = "Печать" .
     1301                                   v-h[ii] = hh:handle .
     1302                                   ii = ii + 1 .
     1303                                   hh:width-chars = 3 .
     1304                               end.
     1305                           when "b-history" or
     1306                           when "b-hist" then
     1307                               do:
     1308                                   hh:load-image("cmp/b-hist.bmp":u) .
     1309                                   hh:TOOLTIP = "История" .
     1310                                   v-h[ii] = hh:handle .
     1311                                   ii = ii + 1 .
     1312                                   hh:width-chars = 3 .
     1313                               end.
     1314                           when "b-sch" then
     1315                               do:
     1316                                   hh:load-image("cmp/b-sch.bmp":u) .
     1317                                   hh:TOOLTIP = "Установка Фильтра" .
     1318                                   v-h[ii] = hh:handle .
     1319                                   ii = ii + 1 .
     1320                                   hh:width-chars = 3 .
     1321                               end.
     1322                           when "b-hist-user" then
     1323                               do:
     1324                                   hh:load-image("cmp/b-hist.bmp":u) .
     1325                                   hh:TOOLTIP = "История пользователя" .
     1326                                   ii = ii + 1 .
     1327                               end.
     1328                       end case.
     1329                   end.
     1330                   hh = hh:next-sibling.
     1331               end.
     1332               b-help:column = v-frame-width - b-help:width-chars.
     1333               jj = 0.
     1334               repeat ii = 4 to 1 by -1 :
     1335                   if valid-handle (v-h[ii] ) then
     1336                   do:
     1337                       jj  = jj + 1 .
     1338                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1339                       v-h[ii]:row    = v-help-old-y .
     1340                   end.
     1341               end.
     1342           end.
     1343       end.
     1344   end procedure.
     1345   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1346   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1347   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1348   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1349   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1350   define variable v-diasize-current-frame-height as decimal   no-undo .
     1351   define variable v-diasize-change-size          as logical   no-undo .
     1352   define variable v-diasize-resize-button        as handle    no-undo .
     1353   define variable v-diasize-wndmax               as logical   no-undo .
     1354   define variable v-diasize-wndstore             as logical   no-undo .
     1355   define variable v-diasize-proc-name            as character no-undo .
     1356   define variable v-diasize-browse-handle        as handle    no-undo .
     1357   define variable v-diasize-browse-number        as integer   no-undo .
     1358   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1359   define temp-table temp-diasize-handle no-undo
     1360     field handle-value  as handle
     1361     field save-position as decimal
     1362     index xpk is primary unique handle-value
     1363     .
     1364   define temp-table temp-browse-handle no-undo
     1365     field browse-type   as character
     1366     field browse-number as integer
     1367     field browse-handle as handle
     1368     field original-size as decimal
     1369     index xpk is primary unique browse-type browse-number
     1370     index xie browse-type browse-handle
     1371   .
     1372   procedure diasize_change-height :
     1373     define input  parameter p-change-value  as decimal   no-undo .
     1374     define input  parameter p-move-resize   as logical   no-undo .
     1375     define variable v-field-group-handle    as handle    no-undo .
     1376     define variable v-object-handle         as handle    no-undo .
     1377     define variable v-frame-height          as decimal   no-undo .
     1378     define variable v-frame-virtual-height  as decimal   no-undo .
     1379     define variable v-browse-height         as decimal   no-undo .
     1380     define variable v-window-height         as decimal   no-undo .
     1381     define variable v-window-virtual-height as decimal   no-undo .
     1382     define variable v-change-sign           as integer   no-undo .
     1383     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1384     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1385     if p-change-value > 0
     1386     then do:
     1387       if frame Dialog-Frame :height + p-change-value
     1388           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1389       then do:
     1390         assign
     1391           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1392                           - (frame Dialog-Frame :height-chars)
     1393         .
     1394         if p-change-value <= 0
     1395         then do:
     1396           run diasize_position-resize-button in this-procedure .
     1397           return .
     1398         end.
     1399       end.
     1400     end.
     1401     if p-change-value < 0
     1402     then do:
     1403       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1404       then do:
     1405         assign
     1406           p-change-value = v-diasize-orig-frame-height
     1407                          - (frame Dialog-Frame :height-chars)
     1408         .
     1409         if p-change-value >= 0
     1410         then do:
     1411           run diasize_position-resize-button in this-procedure .
     1412           return .
     1413         end.
     1414       end.
     1415     end.
     1416     if p-change-value >= 0
     1417     then do:
     1418       assign
     1419         v-change-sign = 1
     1420       .
     1421     end.
     1422     else do:
     1423       assign
     1424         v-change-sign = -1
     1425       .
     1426     end.
     1427     assign
     1428       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1429     .
     1430     if p-change-value = 0
     1431     then do:
     1432       run diasize_position-resize-button in this-procedure .
     1433       return .
     1434     end.
     1435     move_block:
     1436     do
     1437     on error undo move_block, retry move_block
     1438     :
     1439       if retry
     1440       then do:
     1441         do
     1442         on error undo move_block, leave move_block
     1443         :
     1444           if p-change-value > 0
     1445           then do:
     1446             for each buf_temp-diasize-handle
     1447             on error undo, next
     1448             :
     1449               assign
     1450                 v-object-handle = buf_temp-diasize-handle.handle-value
     1451               .
     1452               if v-object-handle <> v-diasize-resize-button
     1453               then do:
     1454                 assign
     1455                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1456                 .
     1457               end.
     1458             end.
     1459             assign
     1460               v-diasize-browse-handle :height = v-browse-height
     1461             .
     1462             for each buf_temp-browse-handle
     1463               where buf_temp-browse-handle.browse-type = 'height':u
     1464             on error undo, next
     1465             :
     1466               assign
     1467                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1468               .
     1469             end.
     1470             assign
     1471               frame Dialog-Frame :height = v-frame-height
     1472             .
     1473             if frame Dialog-Frame :scrollable = true
     1474             then do:
     1475               assign
     1476                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1477               .
     1478             end.
     1479             run diasize_position-resize-button in this-procedure .
     1480           end.
     1481           else do:
     1482             if frame Dialog-Frame :scrollable = true
     1483             then do:
     1484               assign
     1485                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1486               .
     1487             end.
     1488             assign
     1489               frame Dialog-Frame :height = v-frame-height
     1490             .
     1491             assign
     1492               v-diasize-browse-handle :height = v-browse-height
     1493             .
     1494             for each buf_temp-browse-handle
     1495               where buf_temp-browse-handle.browse-type = 'height':u
     1496             on error undo, next
     1497             :
     1498               assign
     1499                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1500               .
     1501             end.
     1502             for each buf_temp-diasize-handle
     1503             on error undo, next
     1504             :
     1505               assign
     1506                 v-object-handle = buf_temp-diasize-handle.handle-value
     1507               .
     1508               if v-object-handle <> v-diasize-resize-button
     1509               then do:
     1510                 assign
     1511                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1512                 .
     1513               end.
     1514             end.
     1515             run diasize_position-resize-button in this-procedure .
     1516           end.
     1517           assign
     1518             v-diasize-change-size = false
     1519           .
     1520           leave move_block .
     1521         end.
     1522       end.
     1523       assign
     1524         v-diasize-need-full-display = true
     1525       .
     1526       if v-diasize-change-size = false
     1527       then do:
     1528         assign
     1529           v-diasize-change-size = true
     1530         .
     1531       end.
     1532       else do:
     1533         return .
     1534       end.
     1535       assign
     1536         v-frame-height = frame Dialog-Frame :height
     1537         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1538         v-browse-height = v-diasize-browse-handle :height
     1539       .
     1540       for each buf_temp-browse-handle
     1541         where buf_temp-browse-handle.browse-type = 'height':u
     1542       :
     1543         assign
     1544           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1545         .
     1546       end.
     1547       for each buf_temp-diasize-handle
     1548       :
     1549         delete buf_temp-diasize-handle .
     1550       end.
     1551       assign
     1552         v-field-group-handle = frame Dialog-Frame :first-child
     1553       .
     1554       do while valid-handle(v-field-group-handle)
     1555       :
     1556         assign
     1557           v-object-handle = v-field-group-handle :first-child
     1558         .
     1559         do while valid-handle(v-object-handle)
     1560         :
     1561           if  v-object-handle <> v-diasize-browse-handle :handle
     1562           and can-query(v-object-handle, "row")
     1563           and can-query(v-object-handle, "height")
     1564           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1565           then do:
     1566             find first buf_temp-browse-handle
     1567               where buf_temp-browse-handle.browse-type   = 'height':u
     1568                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1569               no-error .
     1570             if available buf_temp-browse-handle
     1571             then do:
     1572             end.
     1573             else do:
     1574               create buf_temp-diasize-handle .
     1575               assign
     1576                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1577                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1578               .
     1579             end.
     1580           end.
     1581           assign
     1582             v-object-handle = v-object-handle :next-sibling
     1583           .
     1584         end.
     1585         assign
     1586           v-field-group-handle = v-field-group-handle :next-sibling
     1587         .
     1588       end.
     1589       do with frame Dialog-Frame
     1590       :
     1591         hide v-diasize-resize-button .
     1592         assign
     1593           v-diasize-resize-button :row    = 1
     1594           v-diasize-resize-button :column = 1
     1595         .
     1596       end.
     1597       if p-change-value > 0
     1598       then do:
     1599         if frame Dialog-Frame :scrollable = true
     1600         then do:
     1601           assign
     1602             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1603             no-error .
     1604           if error-status :error
     1605           or error-status :get-message(1) <> ""
     1606           then do:
     1607             undo move_block, retry move_block .
     1608           end.
     1609         end.
     1610         assign
     1611           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1612           no-error .
     1613         if error-status :error
     1614         or error-status :get-message(1) <> ""
     1615         then do:
     1616           undo move_block, retry move_block .
     1617         end.
     1618         assign
     1619           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1620           no-error .
     1621         if error-status :error
     1622         or error-status :get-message(1) <> ""
     1623         then do:
     1624           undo move_block, retry move_block .
     1625         end.
     1626         for each buf_temp-browse-handle
     1627           where buf_temp-browse-handle.browse-type = 'height':u
     1628         on error undo move_block, retry move_block
     1629         :
     1630           assign
     1631             buf_temp-browse-handle.browse-handle :height
     1632               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1633             no-error .
     1634           if error-status :error
     1635           or error-status :get-message(1) <> ""
     1636           then do:
     1637             undo move_block, retry move_block .
     1638           end.
     1639         end.
     1640         for each buf_temp-diasize-handle
     1641         on error undo move_block, retry move_block
     1642         :
     1643           assign
     1644             v-object-handle = buf_temp-diasize-handle.handle-value
     1645           .
     1646           if v-object-handle <> v-diasize-resize-button
     1647           then do:
     1648             assign
     1649               v-object-handle :row = v-object-handle :row + p-change-value
     1650               no-error .
     1651             if error-status :error
     1652             or error-status :get-message(1) <> ""
     1653             then do:
     1654               undo move_block, retry move_block .
     1655             end.
     1656           end.
     1657         end.
     1658       end.
     1659       else do:
     1660         for each buf_temp-diasize-handle
     1661         on error undo move_block, retry move_block
     1662         :
     1663           assign
     1664             v-object-handle = buf_temp-diasize-handle.handle-value
     1665           .
     1666           if v-object-handle <> v-diasize-resize-button
     1667           then do:
     1668             assign
     1669               v-object-handle :row = v-object-handle :row + p-change-value
     1670               no-error .
     1671             if error-status :error
     1672             or error-status :get-message(1) <> ""
     1673             then do:
     1674               undo move_block, retry move_block .
     1675             end.
     1676           end.
     1677         end.
     1678         assign
     1679           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1680           no-error .
     1681         if error-status :error
     1682         or error-status :get-message(1) <> ""
     1683         then do:
     1684           undo move_block, retry move_block .
     1685         end.
     1686         for each buf_temp-browse-handle
     1687           where buf_temp-browse-handle.browse-type = 'height':u
     1688         on error undo move_block, retry move_block
     1689         :
     1690           assign
     1691             buf_temp-browse-handle.browse-handle :height
     1692               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1693             no-error .
     1694           if error-status :error
     1695           or error-status :get-message(1) <> ""
     1696           then do:
     1697             undo move_block, retry move_block .
     1698           end.
     1699         end.
     1700         assign
     1701           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1702           no-error .
     1703         if error-status :error
     1704         or error-status :get-message(1) <> ""
     1705         then do:
     1706           undo move_block, retry move_block .
     1707         end.
     1708         if frame Dialog-Frame :scrollable = true
     1709         then do:
     1710           assign
     1711             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1712             no-error .
     1713           if error-status :error
     1714           or error-status :get-message(1) <> ""
     1715           then do:
     1716             undo move_block, retry move_block .
     1717           end.
     1718         end.
     1719       end.
     1720       if p-move-resize = true
     1721       then do:
     1722         run diasize_position-resize-button in this-procedure .
     1723       end.
     1724       if v-diasize-wndstore = true
     1725       then do:
     1726         if connected("ub") = true
     1727         then do:
     1728           define variable v-cntxt-db-num        as integer   no-undo .
     1729           define variable v-cntxt-userid        as character no-undo .
     1730           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1731                                             , OUTPUT v-cntxt-userid
     1732                                             ) .
     1733           run gbl/wndsizew.p
     1734             (input  v-cntxt-db-num
     1735             ,input  v-cntxt-userid
     1736             ,input  v-diasize-proc-name
     1737             ,input  'height':u
     1738             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1739             ) .
     1740         end.
     1741       end.
     1742     end.
     1743     assign
     1744       v-diasize-change-size = false
     1745     .
     1746   end procedure.
     1747   procedure diasize_set-height :
     1748     define input  parameter p-new-height  as decimal   no-undo .
     1749     define input  parameter p-move-resize as logical   no-undo .
     1750     do
     1751     on error undo, return error return-value
     1752     :
     1753       run diasize_change-height in this-procedure
     1754         (input  (p-new-height - frame Dialog-Frame :height)
     1755         ,input  p-move-resize
     1756         ) .
     1757     end.
     1758   end procedure.
     1759   procedure diasize_change-width :
     1760     define input  parameter p-change-value as decimal   no-undo .
     1761     define input  parameter p-move-resize  as logical   no-undo .
     1762     define variable v-field-group-handle   as handle    no-undo .
     1763     define variable v-object-handle        as handle    no-undo .
     1764     define variable v-frame-width          as decimal   no-undo .
     1765     define variable v-frame-virtual-width  as decimal   no-undo .
     1766     define variable v-browse-width         as decimal   no-undo .
     1767     define variable v-window-width         as decimal   no-undo .
     1768     define variable v-window-virtual-width as decimal   no-undo .
     1769     define variable v-change-sign          as integer   no-undo .
     1770     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1771     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1772     if p-change-value > 0
     1773     then do:
     1774       if frame Dialog-Frame :width + p-change-value >
     1775           session :width-chars
     1776       then do:
     1777         assign
     1778           p-change-value = session :width-chars - frame Dialog-Frame :width
     1779         .
     1780         if p-change-value <= 0
     1781         then do:
     1782           run diasize_position-resize-button in this-procedure .
     1783           return .
     1784         end.
     1785       end.
     1786     end.
     1787     if p-change-value < 0
     1788     then do:
     1789       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1790       then do:
     1791         assign
     1792           p-change-value = v-diasize-orig-frame-width
     1793                          - frame Dialog-Frame :width
     1794         .
     1795         if p-change-value >= 0
     1796         then do:
     1797           run diasize_position-resize-button in this-procedure .
     1798           return .
     1799         end.
     1800       end.
     1801     end.
     1802     if p-change-value >= 0
     1803     then do:
     1804       assign
     1805         v-change-sign = 1
     1806       .
     1807     end.
     1808     else do:
     1809       assign
     1810         v-change-sign = -1
     1811       .
     1812     end.
     1813     assign
     1814       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1815     .
     1816     if p-change-value = 0
     1817     then do:
     1818       run diasize_position-resize-button in this-procedure .
     1819       return .
     1820     end.
     1821     move_block:
     1822     do
     1823     on error undo move_block, leave move_block
     1824     :
     1825       if retry
     1826       then do:
     1827         do
     1828         on error undo move_block, leave move_block
     1829         :
     1830           if p-change-value > 0
     1831           then do:
     1832             for each buf_temp-diasize-handle
     1833             on error undo, next
     1834             :
     1835               assign
     1836                 v-object-handle = buf_temp-diasize-handle.handle-value
     1837               .
     1838               if v-object-handle <> v-diasize-resize-button
     1839               then do:
     1840                 assign
     1841                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1842                 .
     1843               end.
     1844             end.
     1845             assign
     1846               v-diasize-browse-handle :width = v-browse-width
     1847             .
     1848             for each buf_temp-browse-handle
     1849               where buf_temp-browse-handle.browse-type = 'width':u
     1850             on error undo, next
     1851             :
     1852               assign
     1853                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1854               .
     1855             end.
     1856             assign
     1857               frame Dialog-Frame :width = v-frame-width
     1858             .
     1859             if frame Dialog-Frame :scrollable = true
     1860             then do:
     1861               assign
     1862                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1863               .
     1864             end.
     1865             run diasize_position-resize-button in this-procedure .
     1866           end.
     1867           else do:
     1868             if frame Dialog-Frame :scrollable = true
     1869             then do:
     1870               assign
     1871                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1872               .
     1873             end.
     1874             assign
     1875               frame Dialog-Frame :width = v-frame-width
     1876             .
     1877             for each buf_temp-browse-handle
     1878               where buf_temp-browse-handle.browse-type = 'width':u
     1879             on error undo, next
     1880             :
     1881               assign
     1882                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1883               .
     1884             end.
     1885             assign
     1886               v-diasize-browse-handle :width = v-browse-width
     1887             .
     1888             for each buf_temp-diasize-handle
     1889             on error undo, next
     1890             :
     1891               assign
     1892                 v-object-handle = buf_temp-diasize-handle.handle-value
     1893               .
     1894               if v-object-handle <> v-diasize-resize-button
     1895               then do:
     1896                 assign
     1897                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1898                 .
     1899               end.
     1900             end.
     1901             run diasize_position-resize-button in this-procedure .
     1902           end.
     1903           assign
     1904             v-diasize-change-size = false
     1905           .
     1906           leave move_block .
     1907         end.
     1908       end.
     1909       assign
     1910         v-diasize-need-full-display = true
     1911       .
     1912       if v-diasize-change-size = false
     1913       then do:
     1914         assign
     1915           v-diasize-change-size = true
     1916         .
     1917       end.
     1918       else do:
     1919         return .
     1920       end.
     1921       assign
     1922         v-frame-width = frame Dialog-Frame :width
     1923         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1924         v-browse-width = v-diasize-browse-handle :width
     1925       .
     1926       for each buf_temp-browse-handle
     1927         where buf_temp-browse-handle.browse-type = 'width':u
     1928       :
     1929         assign
     1930           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1931         .
     1932       end.
     1933       for each buf_temp-diasize-handle
     1934       :
     1935         delete buf_temp-diasize-handle .
     1936       end.
     1937       assign
     1938         v-field-group-handle = frame Dialog-Frame :first-child
     1939       .
     1940       do while valid-handle(v-field-group-handle)
     1941       :
     1942         assign
     1943           v-object-handle = v-field-group-handle :first-child
     1944         .
     1945         do while valid-handle(v-object-handle)
     1946         :
     1947           if  v-object-handle <> v-diasize-browse-handle :handle
     1948           and v-object-handle <> v-diasize-resize-button
     1949           and can-query(v-object-handle, "row")
     1950           and can-query(v-object-handle, "height")
     1951           and ( v-object-handle :col + v-object-handle :width
     1952                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1953               )
     1954           then do:
     1955             find first buf_temp-browse-handle
     1956               where buf_temp-browse-handle.browse-type   = 'width':u
     1957                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1958               no-error .
     1959             if available buf_temp-browse-handle
     1960             then do:
     1961             end.
     1962             else do:
     1963               create buf_temp-diasize-handle .
     1964               assign
     1965                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1966                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1967               .
     1968             end.
     1969           end.
     1970           assign
     1971             v-object-handle = v-object-handle :next-sibling
     1972           .
     1973         end.
     1974         assign
     1975           v-field-group-handle = v-field-group-handle :next-sibling
     1976         .
     1977       end.
     1978       do with frame Dialog-Frame
     1979       :
     1980         hide v-diasize-resize-button .
     1981         v-diasize-resize-button :row = 1.
     1982         v-diasize-resize-button :column = 1.
     1983       end.
     1984       if p-change-value > 0
     1985       then do:
     1986         if frame Dialog-Frame :scrollable = true
     1987         then do:
     1988           assign
     1989             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1990             no-error .
     1991           if error-status :error
     1992           or error-status :get-message(1) <> ""
     1993           then do:
     1994             undo move_block, retry move_block.
     1995           end.
     1996         end.
     1997         assign
     1998           frame Dialog-Frame :width = v-frame-width + p-change-value
     1999           no-error .
     2000         if error-status :error
     2001         or error-status :get-message(1) <> ""
     2002         then do:
     2003           undo move_block, retry move_block.
     2004         end.
     2005         assign
     2006           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2007         no-error .
     2008         if error-status :error
     2009         or error-status :get-message(1) <> ""
     2010         then do:
     2011           undo move_block, retry move_block.
     2012         end.
     2013         for each buf_temp-browse-handle
     2014           where buf_temp-browse-handle.browse-type = 'width':u
     2015         on error undo move_block, retry move_block
     2016         :
     2017           assign
     2018             buf_temp-browse-handle.browse-handle :width
     2019               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2020             no-error .
     2021           if error-status :error
     2022           or error-status :get-message(1) <> ""
     2023           then do:
     2024             undo move_block, retry move_block .
     2025           end.
     2026         end.
     2027         for each buf_temp-diasize-handle
     2028         on error undo move_block, retry move_block
     2029         :
     2030           assign
     2031             v-object-handle = buf_temp-diasize-handle.handle-value
     2032           .
     2033           if v-object-handle <> v-diasize-resize-button
     2034           then do:
     2035             assign
     2036               v-object-handle :col = v-object-handle :col + p-change-value
     2037               no-error .
     2038             if error-status :error
     2039             or error-status :get-message(1) <> ""
     2040             then do:
     2041               undo move_block, retry move_block .
     2042             end.
     2043           end.
     2044         end.
     2045       end.
     2046       else do:
     2047         for each buf_temp-diasize-handle
     2048         on error undo move_block, retry move_block
     2049         :
     2050           assign
     2051             v-object-handle = buf_temp-diasize-handle.handle-value
     2052           .
     2053           if v-object-handle <> v-diasize-resize-button
     2054           then do:
     2055             assign
     2056               v-object-handle :col = v-object-handle :col + p-change-value
     2057               no-error .
     2058             if error-status :error
     2059             or error-status :get-message(1) <> ""
     2060             then do:
     2061               undo move_block, retry move_block .
     2062             end.
     2063           end.
     2064         end.
     2065         for each buf_temp-browse-handle
     2066           where buf_temp-browse-handle.browse-type = 'width':u
     2067         on error undo move_block, retry move_block
     2068         :
     2069           assign
     2070             buf_temp-browse-handle.browse-handle :width
     2071               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2072             no-error .
     2073           if error-status :error
     2074           or error-status :get-message(1) <> ""
     2075           then do:
     2076             undo move_block, retry move_block .
     2077           end.
     2078         end.
     2079         assign
     2080           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2081           no-error .
     2082         if error-status :error
     2083         or error-status :get-message(1) <> ""
     2084         then do:
     2085           undo move_block, retry move_block.
     2086         end.
     2087         assign
     2088           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2089         no-error .
     2090         if error-status :error
     2091         or error-status :get-message(1) <> ""
     2092         then do:
     2093           undo move_block, retry move_block.
     2094         end.
     2095         if frame Dialog-Frame :scrollable = true
     2096         then do:
     2097           assign
     2098             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2099           no-error .
     2100           if error-status :error
     2101           or error-status :get-message(1) <> ""
     2102           then do:
     2103             undo move_block, retry move_block.
     2104           end.
     2105         end.
     2106       end.
     2107       if p-move-resize
     2108       then do:
     2109         run diasize_position-resize-button in this-procedure .
     2110       end.
     2111       if v-diasize-wndstore = true
     2112       then do:
     2113         if connected("ub") = true
     2114         then do:
     2115           define variable v-cntxt-db-num        as integer   no-undo .
     2116           define variable v-cntxt-userid        as character no-undo .
     2117           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2118                                             , OUTPUT v-cntxt-userid
     2119                                             ) .
     2120           run gbl/wndsizew.p
     2121             (input  v-cntxt-db-num
     2122             ,input  v-cntxt-userid
     2123             ,input  v-diasize-proc-name
     2124             ,input  'width':u
     2125             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2126             ) .
     2127         end.
     2128       end.
     2129     end.
     2130     assign
     2131       v-diasize-change-size = false
     2132     .
     2133   end procedure.
     2134   procedure diasize_set-width :
     2135     define input  parameter p-new-width  as decimal   no-undo .
     2136     define input  parameter p-move-resize as logical   no-undo .
     2137     do
     2138     on error undo, return error return-value
     2139     :
     2140       run diasize_change-width in this-procedure
     2141         (input  (p-new-width - frame Dialog-Frame :width)
     2142         ,input  p-move-resize
     2143         ) .
     2144     end.
     2145   end procedure.
     2146   procedure diasize_position-resize-button :
     2147     do with frame Dialog-Frame
     2148     :
     2149       hide v-diasize-resize-button .
     2150       assign
     2151         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2152                     - 1
     2153                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2154         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2155                     - 1
     2156                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2157       .
     2158       view v-diasize-resize-button .
     2159     end.
     2160   end procedure.
     2161   on alt-right anywhere
     2162   do:
     2163     run diasize_change-width in this-procedure
     2164       (input 1
     2165       ,input true
     2166       ) .
     2167     return no-apply .
     2168   end.
     2169   on alt-left anywhere
     2170   do:
     2171     run diasize_change-width in this-procedure
     2172       (input -1
     2173       ,input true
     2174       ) .
     2175     return no-apply .
     2176   end.
     2177   on alt-down anywhere
     2178   do:
     2179     run diasize_change-height in this-procedure
     2180       (input 1
     2181       ,input true
     2182       ) .
     2183     return no-apply .
     2184   end.
     2185   on alt-up anywhere
     2186   do:
     2187     run diasize_change-height in this-procedure
     2188       (input -1
     2189       ,input true
     2190       ) .
     2191     return no-apply .
     2192   end.
     2193   on alt-enter of frame Dialog-Frame
     2194   do:
     2195     run diasize_maximize in this-procedure
     2196       (input  ?
     2197       ).
     2198     return no-apply .
     2199   end.
     2200   procedure diasize_end-move :
     2201     do
     2202     on error undo, return error return-value
     2203     :
     2204       define variable v-row-delta as decimal   no-undo .
     2205       define variable v-col-delta as decimal   no-undo .
     2206       define variable v-new-row as decimal   no-undo .
     2207       define variable v-new-col as decimal   no-undo .
     2208       assign
     2209         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2210         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2211       .
     2212       assign
     2213         v-row-delta = v-new-row - frame Dialog-Frame :height
     2214         v-col-delta = v-new-col - frame Dialog-Frame :width
     2215       .
     2216       run diasize_change-height in this-procedure
     2217         (input v-row-delta
     2218         ,input true
     2219         ) .
     2220       run diasize_change-width in this-procedure
     2221         (input v-col-delta
     2222         ,input true
     2223         ) .
     2224     end.
     2225   end procedure.
     2226   procedure diasize_maximize :
     2227     define input  parameter p-action as logical   no-undo .
     2228     do
     2229     on error undo, return error return-value
     2230     :
     2231       if p-action = ?
     2232       then do:
     2233         if v-diasize-need-maximize = true
     2234         then do:
     2235           assign
     2236             p-action = true
     2237           .
     2238         end.
     2239         else do:
     2240           assign
     2241             p-action = false
     2242           .
     2243         end.
     2244       end.
     2245       if p-action = true
     2246       then do:
     2247         run diasize_change-height in this-procedure
     2248           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2249               - frame Dialog-Frame :height-chars
     2250           ,input true
     2251           ) .
     2252         run diasize_change-width in this-procedure
     2253           (input session :width-chars
     2254               - frame Dialog-Frame :width-chars
     2255           ,input true
     2256           ) .
     2257         assign
     2258           v-diasize-need-maximize = false
     2259         .
     2260       end.
     2261       else do:
     2262         run diasize_change-width in this-procedure
     2263           (input v-diasize-orig-frame-width
     2264               - frame Dialog-Frame :width-chars
     2265           ,input true
     2266           ) .
     2267         run diasize_change-height in this-procedure
     2268           (input v-diasize-orig-frame-height
     2269               - frame Dialog-Frame :height-chars
     2270           ,input true
     2271           ) .
     2272         assign
     2273           v-diasize-need-maximize = true
     2274         .
     2275       end.
     2276     end.
     2277   end procedure.
     2278   procedure diasize_restore-orig-size :
     2279     do
     2280     on error undo, return error return-value
     2281     :
     2282       assign
     2283         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2284         v-diasize-current-frame-height = frame Dialog-Frame :height
     2285       .
     2286       run diasize_set-height in this-procedure
     2287         (input  v-diasize-orig-frame-height
     2288         ,input  true
     2289         ) .
     2290       run diasize_set-width in this-procedure
     2291         (input  v-diasize-orig-frame-width
     2292         ,input  true
     2293         ) .
     2294     end.
     2295   end procedure.
     2296   procedure diasize_restore-current-size :
     2297     do
     2298     on error undo, return error return-value
     2299     :
     2300       run diasize_set-height in this-procedure
     2301         (input  v-diasize-current-frame-height
     2302         ,input  true
     2303         ) .
     2304       run diasize_set-width in this-procedure
     2305         (input  v-diasize-current-frame-width
     2306         ,input  true
     2307         ) .
     2308     end.
     2309   end procedure.
     2310   procedure diasize_set-browse-handle :
     2311     define input  parameter p-browse-handle as handle   no-undo .
     2312     define buffer buf_temp-browse-handle for temp-browse-handle .
     2313     do
     2314     on error undo, return error return-value
     2315     :
     2316       assign
     2317         v-diasize-browse-handle = p-browse-handle
     2318       .
     2319       for each buf_temp-browse-handle
     2320       on error undo, return error return-value
     2321       :
     2322         delete buf_temp-browse-handle .
     2323       end.
     2324     end.
     2325   end procedure.
     2326   procedure diasize_add_browse :
     2327     define input  parameter p-browse-type   as character no-undo .
     2328     define input  parameter p-browse-handle as handle    no-undo .
     2329     define buffer buf_temp-browse-handle for temp-browse-handle .
     2330     do
     2331     on error undo, return error return-value
     2332     :
     2333       assign
     2334         v-diasize-browse-number = v-diasize-browse-number + 1
     2335       .
     2336       create buf_temp-browse-handle .
     2337       assign
     2338         buf_temp-browse-handle.browse-type   = p-browse-type
     2339         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2340         buf_temp-browse-handle.browse-handle = p-browse-handle
     2341       .
     2342     end.
     2343   end procedure.
     2344   procedure diasize_init :
     2345     define variable v-default-value    as logical   no-undo .
     2346     define variable v-restore-saved    as logical   no-undo .
     2347     define variable v-resize-value-str as character no-undo .
     2348     do
     2349     on error undo, return error return-value
     2350     :
     2351       do with frame Dialog-Frame
     2352       :
     2353         assign
     2354           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2355           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2356           v-diasize-browse-handle     = browse br-rp-by-call :handle
     2357         .
     2358         create button v-diasize-resize-button
     2359         assign
     2360           parent        = frame Dialog-Frame :first-child
     2361           label         = "s"
     2362           height-pixels = 16
     2363           width-pixels  = 16
     2364           visible       = true
     2365           sensitive     = true
     2366           movable       = true
     2367           triggers:
     2368             on end-move persistent run diasize_end-move in this-procedure .
     2369           end triggers.
     2370         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2371         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2372         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2373         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2374         assign
     2375           v-diasize-wndmax = false
     2376         .
     2377         if connected("ub") = true
     2378         then do:
     2379           define variable v-cntxt-db-num        as integer   no-undo .
     2380           define variable v-cntxt-userid        as character no-undo .
     2381           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2382                                             , OUTPUT v-cntxt-userid
     2383                                             ) .
     2384           run gbl/wndpar_r.p
     2385             (input  v-cntxt-db-num
     2386             ,input  v-cntxt-userid
     2387             ,input  'wndmax':U
     2388             ,output v-diasize-wndmax
     2389             ,output v-default-value
     2390             ) .
     2391         end.
     2392         assign
     2393           v-diasize-wndstore = false
     2394         .
     2395         if connected("ub") = true
     2396         then do:
     2397           run gbl/wndpar_r.p
     2398             (input  v-cntxt-db-num
     2399             ,input  v-cntxt-userid
     2400             ,input  'wndstore':U
     2401             ,output v-diasize-wndstore
     2402             ,output v-default-value
     2403             ) .
     2404         end.
     2405         assign
     2406           v-diasize-proc-name = entry(1, program-name(2), '.')
     2407         .
     2408         if v-diasize-wndstore = true
     2409         then do:
     2410           assign
     2411             v-restore-saved = false
     2412           .
     2413           if connected("ub") = true
     2414           then do:
     2415             run gbl/wndsizer.p
     2416               (input  v-cntxt-db-num
     2417               ,input  v-cntxt-userid
     2418               ,input  v-diasize-proc-name
     2419               ,input  'height':u
     2420               ,output v-resize-value-str
     2421               ) .
     2422             if v-resize-value-str <> '':U
     2423             then do:
     2424               run diasize_change-height in this-procedure
     2425                 (input  integer(v-resize-value-str)
     2426                 ,input  true
     2427                 ) .
     2428               assign
     2429                 v-restore-saved = true
     2430               .
     2431             end.
     2432           end.
     2433           if connected("ub") = true
     2434           then do:
     2435             run gbl/wndsizer.p
     2436               (input  v-cntxt-db-num
     2437               ,input  v-cntxt-userid
     2438               ,input  v-diasize-proc-name
     2439               ,input  'width':u
     2440               ,output v-resize-value-str
     2441               ) .
     2442             if v-resize-value-str <> '':U
     2443             then do:
     2444               run diasize_change-width in this-procedure
     2445                 (input  integer(v-resize-value-str)
     2446                 ,input  true
     2447                 ) .
     2448               assign
     2449                 v-restore-saved = true
     2450               .
     2451             end.
     2452           end.
     2453           if v-restore-saved <> true
     2454           then do:
     2455             if v-diasize-wndmax = true
     2456             then do:
     2457               run diasize_maximize in this-procedure
     2458                 (input  true
     2459                 ) .
     2460             end.
     2461           end.
     2462         end.
     2463         else do:
     2464           if v-diasize-wndmax = true
     2465           then do:
     2466             run diasize_maximize in this-procedure
     2467               (input  true
     2468               ) .
     2469           end.
     2470         end.
     2471       end.
     2472     end.
     2473   end procedure.
     2474   procedure diasize_need-full-display :
     2475     define output parameter p-need-full-display as logical   no-undo .
     2476     do
     2477     on error undo, return error return-value
     2478     :
     2479       assign
     2480         p-need-full-display = v-diasize-need-full-display
     2481       .
     2482       assign
     2483         v-diasize-need-full-display = false
     2484       .
     2485     end.
     2486   end procedure.
     2487   procedure get-context :
     2488      define output parameter p-db-num as integer          no-undo.
     2489      define output parameter p-user-id as character        no-undo.
     2490      define variable v-login               as character    no-undo.
     2491      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2492      define buffer buf_user-login  for ub.user-login .
     2493      do
     2494      on error undo, return error
     2495      :
     2496            FIND FIRST buf_sys-ctrl no-lock.
     2497            ASSIGN
     2498               v-login = USERID("ub")
     2499               p-db-num = buf_sys-ctrl.db-num
     2500            .
     2501            FIND FIRST buf_user-login
     2502                 WHERE buf_user-login.db-num = p-db-num
     2503                   AND buf_user-login.user-login = v-login
     2504                 no-lock
     2505                 no-error
     2506                 .
     2507            IF AVAILABLE buf_user-login
     2508            THEN DO:
     2509               assign
     2510                  p-user-id = buf_user-login.user-id
     2511               .
     2512            END.
     2513      end.
     2514   end procedure.
     2515       run diasize_init in this-procedure .
     2516   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2517   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2518   MAIN-BLOCK:
     2519   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2520      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2521   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2522     run mainmenu_getcntxt in parparentproc
     2523       (output v-cntxt-db-num
     2524       ,output v-cntxt-userid
     2525       ,output v-cntxt-level
     2526       ,output v-cntxt-host-code-obj
     2527       ,output v-cntxt-obj-type
     2528       ,output v-cntxt-obj-code
     2529       ,output v-cntxt-db-num-obj
     2530       ,output v-cntxt-is-admin
     2531       ) .
     2532     v-rid-list = p-rid-list.
     2533     run gbl/dftempl.p ( input 'rule-by-profile':U, output template-recid) no-error.
     2534     run Myenable in this-procedure .
     2535     if return-value = "return" then return.
     2536     WAIT-FOR GO OF FRAME Dialog-Frame.
     2537   END.
     2538   RUN disable_UI.
     2539   PROCEDURE disable_UI :
     2540     HIDE FRAME Dialog-Frame.
     2541   END PROCEDURE.
     2542   PROCEDURE enable_UI :
     2543     DISPLAY EDITOR-1 mark-num
     2544         WITH FRAME Dialog-Frame.
     2545     ENABLE b-quit b-mark b-sel b-add b-del B-Help br-rp-by-call EDITOR-1 mark-num
     2546         WITH FRAME Dialog-Frame.
     2547     VIEW FRAME Dialog-Frame.
     2548     OPEN QUERY br-rp-by-call FOR EACH X_rp-by-call,        FIRST X_rule-profile,        FIRST X_rule-by-profile.
     2549   END PROCEDURE.
     2550   PROCEDURE MyEnable :
     2551   DEFINE VARIAble v-ch AS HANDLE NO-UNDO.
     2552   ASSIGN
     2553   v-ch = br-rp-by-call:FIRST-COLUMN IN FRAME Dialog-Frame.
     2554   REPEAT WHILE valid-handle(v-ch):
     2555      IF v-ch:LABEL = "Вызов" THEN do:
     2556        v-ch:resizable  = yes.
     2557        if lookup("call-id", p-list-mode) > 0 then
     2558        v-ch:visible = no.
     2559      end.
     2560      v-ch = v-ch:NEXT-COLUMN.
     2561   END.
     2562   case p-list-mode:
     2563     when "profile-id" then do:
     2564       X_rule-profile.profile-type:visible in browse br-rp-by-call = no.
     2565     end.
     2566     when "profile-type" then do:
     2567       X_rule-profile.profile-type:visible in browse br-rp-by-call = no.
     2568     end.
     2569     when "call-id" then do:
     2570       X_rule-profile.profile-type:visible in browse br-rp-by-call = no.
     2571     end.
     2572     when "call-id,codex-id" then do:
     2573       X_rule-profile.profile-type:visible in browse br-rp-by-call = no.
     2574     end.
     2575     when "call-id,ruleset-id" then do:
     2576       X_rule-profile.profile-type:visible in browse br-rp-by-call = no.
     2577       X_rule-profile.name:width = 70.
     2578     end.
     2579   end case.
     2580   assign
     2581   X_rule-profile.name:resizable in browse br-rp-by-call = yes
     2582   .
     2583   ENABLE
     2584   b-quit
     2585   b-add when (p-list-mode = "profile-id" and v-cntxt-db-num = 0 and lookup("b-add", bttns) > 0 and not transaction)
     2586   b-del when (v-cntxt-db-num = 0 and lookup("b-add", bttns) > 0 and not transaction)
     2587   B-Help
     2588   b-mark when lookup("b-mark", bttns) > 0
     2589   b-sel when lookup("b-sel", bttns) > 0
     2590   br-rp-by-call
     2591   WITH FRAME Dialog-Frame.
     2592   VIEW FRAME Dialog-Frame.
     2593   run Openbr in this-procedure .
     2594   if return-value = "return" then do:
     2595     return "return".
     2596   end.
     2597   APPLY "VALUE-CHANGED" to br-rp-by-call.
     2598   END PROCEDURE.
     2599   PROCEDURE Openbr :
     2600   define variable v-recid as recid no-undo .
     2601   define variable v-ii as integer no-undo .
     2602   CASE p-list-mode:
     2603     WHEN 'все':U THEN DO:
     2604       frame Dialog-Frame :title = "Все профайлы по всем типам вызовов".
     2605       OPEN QUERY br-rp-by-call
     2606       FOR EACH X_rp-by-call NO-LOCK
     2607         , FIRST X_rule-profile NO-LOCK WHERE
     2608                 X_rule-profile.profile_id = X_rp-by-call.profile_id
     2609         , first X_rule-by-profile no-lock where
     2610                recid(X_rule-by-profile) = template-recid
     2611       INDEXED-REPOSITION.
     2612     END.
     2613     WHEN "profile-id" THEN DO:
     2614       frame Dialog-Frame :title = substitute("Вызовы для профайла правил &1", p-profile-id).
     2615       OPEN QUERY br-rp-by-call
     2616       FOR EACH X_rp-by-call NO-LOCK WHERE
     2617               X_rp-by-call.profile_id = p-profile-id
     2618           , FIRST X_rule-profile NO-LOCK WHERE
     2619                X_rule-profile.profile_id = X_rp-by-call.profile_id
     2620         , first X_rule-by-profile no-lock where
     2621                recid(X_rule-by-profile) = template-recid
     2622           INDEXED-REPOSITION.
     2623     END.
     2624     WHEN "profile-type" THEN DO:
     2625       frame Dialog-Frame :title = substitute("Вызовы для профайла правил типа &1", p-profile-type).
     2626       OPEN QUERY br-rp-by-call
     2627       FOR EACH X_rp-by-call NO-LOCK WHERE
     2628           , FIRST X_rule-profile NO-LOCK WHERE
     2629                X_rule-profile.profile-type = p-profile-type
     2630         , first X_rule-by-profile no-lock where
     2631                recid(X_rule-by-profile) = template-recid
     2632           INDEXED-REPOSITION.
     2633     END.
     2634     WHEN "call-id" THEN DO:
     2635       frame Dialog-Frame :title = substitute("Профайлы для &1", calldscr  ( input p-call-id)).
     2636       OPEN QUERY br-rp-by-call
     2637       FOR EACH X_rp-by-call NO-LOCK WHERE X_rp-by-call.call_id = p-call-id
     2638           , FIRST X_rule-profile NO-LOCK WHERE
     2639                X_rule-profile.profile_id = X_rp-by-call.profile_id
     2640         , first X_rule-by-profile no-lock where
     2641                recid(X_rule-by-profile) = template-recid
     2642           INDEXED-REPOSITION.
     2643     END.
     2644     WHEN "call-id,codex-id" THEN DO:
     2645       frame Dialog-Frame :title = substitute("Профайлы для &1", calldscr  ( input p-call-id)).
     2646       OPEN QUERY br-rp-by-call
     2647       FOR EACH X_rp-by-call NO-LOCK WHERE X_rp-by-call.call_id = p-call-id
     2648           , FIRST X_rule-profile NO-LOCK WHERE
     2649                X_rule-profile.profile_id = X_rp-by-call.profile_id
     2650         , first X_rule-by-profile no-lock where
     2651                X_rule-by-profile.profile_id = X_rp-by-call.profile_id
     2652            and X_rule-by-profile.codex_id = p-codex-id
     2653           INDEXED-REPOSITION.
     2654     END.
     2655     WHEN "call-id,ruleset-id" THEN DO:
     2656       frame Dialog-Frame :title = substitute("Профайлы для &1", calldscr  ( input p-call-id)).
     2657       if lookup("instant", bttns) > 0
     2658       and lookup("b-sel", bttns) > 0
     2659       then do:
     2660         FOR EACH X_rp-by-call NO-LOCK WHERE X_rp-by-call.call_id = p-call-id
     2661           , FIRST X_rule-profile NO-LOCK WHERE
     2662                X_rule-profile.profile_id = X_rp-by-call.profile_id
     2663         , first X_rule-by-profile no-lock where
     2664                X_rule-by-profile.profile_id = X_rp-by-call.profile_id
     2665            and X_rule-by-profile.codex_id = p-codex-id
     2666            and X_rule-by-profile.ruleset_id = p-ruleset-id:
     2667           v-recid = recid(X_rp-by-call).
     2668           v-ii = v-ii + 1.
     2669         end.
     2670         if v-ii = 0 then do:
     2671           message
     2672           "Нет ни одного настроенного профайла!" skip(0)
     2673           "Профайлы настраиваются в Группе меню Администратор - глобальные или объектный параметр <Машина правил (встраиваемые процедуры)>"
     2674           view-as alert-box.
     2675           return "return".
     2676         end.
     2677         if v-ii = 1 then do:
     2678           find first X_rp-by-call where
     2679                     recid(X_rp-by-call) = v-recid.
     2680           apply "choose" to b-sel.
     2681           return "return".
     2682         end.
     2683       end.
     2684       OPEN QUERY br-rp-by-call
     2685       FOR EACH X_rp-by-call NO-LOCK WHERE X_rp-by-call.call_id = p-call-id
     2686           , FIRST X_rule-profile NO-LOCK WHERE
     2687                X_rule-profile.profile_id = X_rp-by-call.profile_id
     2688         , first X_rule-by-profile no-lock where
     2689                X_rule-by-profile.profile_id = X_rp-by-call.profile_id
     2690            and X_rule-by-profile.codex_id = p-codex-id
     2691            and X_rule-by-profile.ruleset_id = p-ruleset-id
     2692           INDEXED-REPOSITION.
     2693     END.
     2694   END CASE.
     2695   END PROCEDURE.
     2696   PROCEDURE proc-b-add :
     2697   define variable v-rid-list as character no-undo .
     2698   define variable v-rec as recid no-undo .
     2699   define variable v-ok as logical no-undo .
     2700   define buffer buf_rule-profile for dictdb.rule-profile.
     2701   if p-list-mode = "profile-id" then do:
     2702     message "Еще не реализовано"
     2703     view-as alert-box error .
     2704     return error.
     2705   end.
     2706   END PROCEDURE.
     2707   PROCEDURE set-row-color :
     2708   DEFINE INPUT PARAMETER p-parent-profile-id AS integer NO-UNDO.
     2709   if p-parent-profile-id > 0 then do:
     2710     assign
     2711     X_rule-profile.name:BGCOLOR IN BROWSE br-rp-by-call = GRAY_COLOR
     2712       .
     2713   end.
     2714   else do:
     2715     assign
     2716     X_rule-profile.name:BGCOLOR IN BROWSE br-rp-by-call = ?
     2717       .
     2718   end.
     2719   END PROCEDURE.
