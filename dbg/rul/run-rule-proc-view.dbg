        1   block-level on error undo, throw.
        2   define input parameter p-pchain-type as character no-undo .
        3   define input parameter p-call-id as character no-undo .
        4   define input parameter p-profile-id as integer no-undo .
        5   define input parameter p-mode as character no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision$":U .
        7   define variable vss-author      as character no-undo init "$Author$":U .
        8   define variable vss-date        as character no-undo init "$Date$":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       10   define variable vss-archive     as character no-undo init "$Archive$":U .
       11   define variable vss-description as character no-undo init "Запуск просмотра процессов в RUM".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       71   define temp-table temp-pchain-link-rule no-undo
       72   field pchain-type as character
       73   field pchain-id as character
       74   field start-from as integer
       75   field link-id as integer
       76   field codex_id as integer
       77   field ruleset_id as integer
       78   field run-DB0 as integer
       79   field run-RDB as integer
       80   field order_id as integer
       81   field rule_id as integer
       82   field profile_id as integer
       83   field once-more as integer
       84   field can-calc as logical
       85   field can-run as logical
       86   field link-btwn-profiles as integer
       87   index pi is unique primary
       88   pchain-type
       89   pchain-id
       90   start-from
       91   link-id
       92   order_id
       93   .
       94   define variable v-ii as integer no-undo .
       95   define variable v-codes as character no-undo .
       96   define variable v-labels as character no-undo .
       97   define variable v-sel-code as character no-undo .
       98   define variable v-pchain-id-list as character no-undo .
       99   define variable v-pchain-id-name as character no-undo .
      100   define variable v-found as logical no-undo .
      101   define buffer buf_rule-by-profile for ub.rule-by-profile.
      102   define buffer buf_rule-process for ub.rule-process.
      103   case p-pchain-type:
      104     when 'dis-card-type':U then do:
      105       v-pchain-id-list = 'sale-close,sale-delete,trn-doc-close,trn-doc-delete,sale-xml-import,text-import,text-export,one-card-recalc,one-card-check,one-card-add,batch-card-recalc,stop-list-import,payment-on-card,fin-doc-on-card,delete-fin-doc-from-card':U.
      106     end.
      107     when 'goods':U then do:
      108       v-pchain-id-list = 'gdsadd,gdsupdate,rengdscode,addlcode,dellcode,updatelcode,addprcode,delprcode,updateprcode,xml-file-import,xml-esys-import,batchwork-export,batchwork-routing,rest-update,goods-cd-send,goods-batchwork,add-good-to-asm,del-good-from-asm':U.
      109     end.
      110     when 'clients':U then do:
      111       v-pchain-id-list = 'batchwork-export,batchwork-routing,xml-file-import,xml-esys-import,text-import,text-export,cliadd,cliupdate':U.
      112     end.
      113     when 'gds-grp':U then do:
      114       v-pchain-id-list = 'batchwork-export,batchwork-routing,xml-file-import,xml-esys-import':U.
      115     end.
      116     when 'cli-grp':U then do:
      117       v-pchain-id-list = 'batchwork-export,batchwork-routing,xml-file-import,xml-esys-import':U.
      118     end.
      119     when 'chk-doc':U + "_" + 'IBS-TH':U then do:
      120       v-pchain-id-list = 'gline-discnt-calc,pline-discnt-calc,subtotal-discnt-calc':U.
      121     end.
      122     when 'chk-doc':U + "_" + 'IBS-TH-MOB':U then do:
      123       v-pchain-id-list = 'gline-discnt-calc,pline-discnt-calc,subtotal-discnt-calc':U.
      124     end.
      125     when 'edoc':U then do:
      126       v-pchain-id-list = 'batchwork-export_order,batchwork-routing_order,xml-esys-import_order,xml-file-import_order,batchwork-export_rcv,batchwork-routing_rcv,xml-esys-import_rcv,xml-file-import_rcv,batchwork-routing_price-doc,xml-esys-import_price-doc,xml-esys-import_trn-doc,batchwork-routing_trn-doc,xml-esys-import_inv-doc,xml-esys-import_contract,batchwork-routing_intorder,xml-esys-import_intorder,batchwork-routing_inkas,event_order,event_rcv,event_trn-doc,event_inv-doc,event_intorder,event_price-doc,event_inkas,text-export_specif,excel-export_specif,text-import_specif,excel-import_specif':U.
      127     end.
      128     when 'thref':U then do:
      129       v-pchain-id-list = 'batchwork-export,batchwork-routing,xml-file-import,xml-esys-import,recadd,recupdate,ref-event':U.
      130     end.
      131     when 'pdf':U then do:
      132       v-pchain-id-list = 'pdf-main-doc-close,overvalue-act-close':U.
      133     end.
      134     when 'rep':U then do:
      135       v-pchain-id-list = 'batchwork,close-shift':U.
      136     end.
      137     otherwise do:
      138     end.
      139   END case.
      140   DO v-ii = 1 TO NUM-ENTRIES(v-pchain-id-list):
      141     for each buf_rule-process
      142     where buf_rule-process.pchain-type = p-pchain-type
      143     and buf_rule-process.pchain-id = entry(v-ii, v-pchain-id-list)
      144     break
      145     by buf_rule-process.pchain-type
      146     by buf_rule-process.pchain-id
      147     by buf_rule-process.start-from
      148     :
      149       if first-of(buf_rule-process.pchain-id) then do:
      150         case p-pchain-type:
      151           when 'dis-card-type':U then do:
      152             v-pchain-id-name = entry (lookup (buf_rule-process.pchain-id, 'sale-close,sale-delete,trn-doc-close,trn-doc-delete,sale-xml-import,text-import,text-export,one-card-recalc,one-card-check,one-card-add,batch-card-recalc,stop-list-import,payment-on-card,fin-doc-on-card,delete-fin-doc-from-card':U) + 1, ',' + 'Закрытие продажи на факт,Удаление закрытой продажи,Закрытие накл. с ДК на факт,Удаление накл. с ДК,Импорт продаж в XML виде,Импорт данных в текст.виде,Экспорт данных в текст.виде,Пересчет по одной карте,Проверка одной карты,Добавление одной карты,Пересчет карт,Импорт стоплиста,Внесение средств на карту,Внес.пл-жа на карту через сист.взаиморасчетов,Удал.пл-жа с карты через сист.взаиморасчетов':U).
      153           end.
      154           when 'goods':U then do:
      155             v-pchain-id-name = entry (lookup (buf_rule-process.pchain-id, 'gdsadd,gdsupdate,rengdscode,addlcode,dellcode,updatelcode,addprcode,delprcode,updateprcode,xml-file-import,xml-esys-import,batchwork-export,batchwork-routing,rest-update,goods-cd-send,goods-batchwork,add-good-to-asm,del-good-from-asm':U) + 1, ',' + 'Добавление товара,Изменение товара,Смена кода товара,Добавление лок.кода,Удаление лок.кода,Изменение лок.кода,Добавление Доп.БК,Удаление Доп.БК,Изменение Доп.БК,Импорт из xml-файла,Импорт из ВС,Операции по списку-экспорт,Операции по списку-маршрутизация,Изменение остатка,Передача товаров на кассу,Работа в атоматическом режиме,add-good-to-asm,del-good-from-asm':U).
      156           end.
      157           when 'clients':U then do:
      158             v-pchain-id-name = entry (lookup (buf_rule-process.pchain-id, 'batchwork-export,batchwork-routing,xml-file-import,xml-esys-import,text-import,text-export,cliadd,cliupdate':U) + 1, ',' + 'Операции по списку-экспорт,Операции по списку-маршрутизация,Импорт из xml-файла,Импорт из ВС,Импорт данных в текст.виде,Экспорт данных в текст.виде,Добавление клиента,Изменение клиента':U).
      159           end.
      160           when 'gds-grp':U then do:
      161             v-pchain-id-name = entry (lookup (buf_rule-process.pchain-id, 'batchwork-export,batchwork-routing,xml-file-import,xml-esys-import':U) + 1, ',' + 'Операции по списку-экспорт,Операции по списку-маршрутизация,Импорт из xml-файла,Импорт из ВС':U).
      162           end.
      163           when 'cli-grp':U then do:
      164             v-pchain-id-name = entry (lookup (buf_rule-process.pchain-id, 'batchwork-export,batchwork-routing,xml-file-import,xml-esys-import':U) + 1, ',' + 'Операции по списку-экспорт,Операции по списку-маршрутизация,Импорт из xml-файла,Импорт из ВС':U).
      165           end.
      166           when 'chk-doc':U + "_" + 'IBS-TH':U
      167           or
      168           when 'chk-doc':U + "_" + 'IBS-TH-MOB':U
      169           then do:
      170             v-pchain-id-name = entry (lookup (buf_rule-process.pchain-id, 'gline-discnt-calc,pline-discnt-calc,subtotal-discnt-calc':U) + 1, ',' + 'Расчет скидки по строке товара,Расчет скидки по строке оплат,Расчет скидки на подитог':U).
      171           end.
      172           when 'edoc':U then do:
      173             v-pchain-id-name = entry (lookup (buf_rule-process.pchain-id, 'batchwork-export_order,batchwork-routing_order,xml-esys-import_order,xml-file-import_order,batchwork-export_rcv,batchwork-routing_rcv,xml-esys-import_rcv,xml-file-import_rcv,batchwork-routing_price-doc,xml-esys-import_price-doc,xml-esys-import_trn-doc,batchwork-routing_trn-doc,xml-esys-import_inv-doc,xml-esys-import_contract,batchwork-routing_intorder,xml-esys-import_intorder,batchwork-routing_inkas,event_order,event_rcv,event_trn-doc,event_inv-doc,event_intorder,event_price-doc,event_inkas,text-export_specif,excel-export_specif,text-import_specif,excel-import_specif':U) + 1, ',' + 'Заказы поставщику-экспорт,Заказы поставщику-маршрутизация,Заказы поставщику-импорт из ВС,Заказы поставщику-импорт из xml-файла,Поставки поставщика-экспорт,Поставки поставщика-маршрутизация,Поставка поставщика-импорт из ВС,Поставка поставщика-импорт из xml-файла,ДНЦ/переоценка-маршрутизация,ДНЦ-импорт из ВС,Накладные-импорт из ВС,Накладные-маршрутизация,Инвентаризации-импорт из ВС,Дог-ра и специф-ции-импорт из ВС,Заявки РЦ-маршрутизация,Заявки РЦ-импорт из ВС,Док-ты продажи-маршрутизация,Заказы поставщику-событие,Поставки поставщика-событие,Накладные-событие,Инвентаризация-событие,Заявки РЦ-событие,ДНЦ/переоценка-событие,Документ продажи-событие,Экспорт спецификации в текст.файл,Экспорт спецификации в Excel,Импорт спецификации из текст.файла,Импорт спецификации из Excel':U).
      174           end.
      175           when 'thref':U then do:
      176             v-pchain-id-name = entry (lookup (buf_rule-process.pchain-id, 'batchwork-export,batchwork-routing,xml-file-import,xml-esys-import,recadd,recupdate,ref-event':U) + 1, ',' + 'Операции по списку-экспорт,Операции по списку-маршрутизация,Импорт из xml-файла,Импорт из ВС,Добавление записи,Изменение записи,События справочников':U).
      177           end.
      178           when 'pdf':U then do:
      179             v-pchain-id-name = entry (lookup (buf_rule-process.pchain-id, 'pdf-main-doc-close,overvalue-act-close':U) + 1, ',' + 'Закрытие ДНЦ по ГТПЛ,Закрытие переоценки на факт':U).
      180           end.
      181           when 'rep':U then do:
      182             v-pchain-id-name = entry (lookup (buf_rule-process.pchain-id, 'batchwork,close-shift':U) + 1, ',' + 'Выполнение отчета по расписанию,Выполнение отчета при закрытии смены':U).
      183           end.
      184         end case.
      185       end.
      186       if first-of(buf_rule-process.start-from) then do:
      187         v-found = no.
      188       end.
      189       if p-profile-id > 0 then do:
      190         find first buf_rule-by-profile no-lock where
      191                   buf_rule-by-profile.codex_id = buf_rule-process.codex_id
      192               and buf_rule-by-profile.ruleset_id = buf_rule-process.ruleset_id
      193               and buf_rule-by-profile.profile_id = p-profile-id no-error.
      194         if available buf_rule-by-profile then v-found = yes.
      195       end.
      196       if last-of(buf_rule-process.start-from) then do:
      197         if p-profile-id = 0
      198         or v-found = yes then do:
      199           assign
      200           v-codes = v-codes +
      201                   (if v-codes = '':U then "" else "|") +
      202                   substitute("&1=&2"
      203                               ,entry(v-ii, v-pchain-id-list)
      204                               ,(if buf_rule-process.start-from = 0 then "0" else "1")
      205                 )
      206           v-labels = v-labels +
      207                   (if v-labels = '':U then "" else "|") +
      208                   substitute("&1 Активная сторона - &2"
      209                             ,string(v-pchain-id-name, "X(50)")
      210                             ,(if buf_rule-process.start-from > 0 then "УБД" else "ГБД")
      211                 ).
      212         end.
      213       end.
      214     end.
      215   end.
      216   run gbl/d-list.w (
      217                  INPUT "b-sel":U
      218                 ,INPUT "Выберите процесс"
      219                 ,INPUT v-codes
      220                 ,INPUT v-labels
      221                 ,INPUT "|"
      222                 ,INPUT "":U
      223                 ,output v-sel-code).
      224   IF v-sel-code = "":u THEN do:
      225     RETURN ''.
      226   end.
      227   run rul/rule-proc-view.p ( input p-pchain-type
      228                             ,input entry(1, v-sel-code, "=")
      229                             ,input integer(entry(2, v-sel-code, "="))
      230                             ,input p-call-id
      231                             ,input p-profile-id
      232                             ,input -1
      233                             ,input p-mode
      234                             ,input ?
      235                             ) no-error.
      236   if error-status:error then do:
      237     return error return-value .
      238   end.
