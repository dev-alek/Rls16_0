        1   block-level on error undo, throw.
        2   define input parameter p-pack-data  as memptr no-undo . // с 26/IX-2018 xml-файл читаетс€ из memptr, а не из файла
        3   define input parameter p-esys-id    as integer no-undo .
        4   define output parameter p-status_   as integer no-undo .
        5   define output parameter p-error     as character no-undo .
        6   define new global shared variable g#language as character no-undo .
        7   if g#language <> '' and g#language <> 'rus':U then do:
        8     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        9   end.
       10   define new global shared variable g#library  as handle no-undo .
       11   define new global shared variable g#library2 as handle no-undo .
       12   define   shared variable g#auto as logical no-undo.
       13   define   shared variable g#news as logical no-undo.
       14   define   shared variable g#oxml as logical no-undo.
       15   define   shared variable g#esys as logical no-undo.
       16   define   shared variable g#news-source-db as integer no-undo.
       17   define   shared variable g#esys-source-esys as integer no-undo.
       18   define   shared variable g#db-num as integer   no-undo .
       19   define   shared variable g#userid as character no-undo .
       20   define   shared variable g#passwd as character no-undo .
       21   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       22   procedure cur-time :
       23      define output parameter p-today as date      no-undo .
       24      define output parameter p-time  as integer   no-undo .
       25     do
       26     on error undo, return error
       27     :
       28       define variable v-date1 as date      no-undo .
       29       define variable v-date2 as date      no-undo .
       30       define variable v-time  as integer   no-undo .
       31       assign
       32         v-date1 = today
       33         v-time  = time
       34         v-date2 = today
       35       .
       36       if v-date1 <> v-date2
       37       then do:
       38         assign
       39           v-date1 = today
       40           v-time  = v-time
       41         .
       42       end.
       43       assign
       44         p-today = v-date1
       45         p-time  = v-time
       46       .
       47     end.
       48   end.
       49   function cur-time-date returns character
       50   :
       51     return string(today, '99/99/9999':U) .
       52   end.
       53   function cur-time-mjd returns decimal
       54   :
       55     define variable v-date as date      no-undo .
       56     define variable v-time as integer   no-undo .
       57     run cur-time in this-procedure
       58       (output v-date
       59       ,output v-time
       60       ) .
       61     return integer(v-date) - 2400002 + (v-time / 86400) .
       62   end.
       63   function cur-time-get-ending-index returns integer
       64   (input p-number as integer
       65   )
       66   :
       67     if p-number < 0
       68     or p-number = ?
       69     then do:
       70       return 1 .
       71     end.
       72     define variable v-rest as integer   no-undo .
       73     assign
       74       p-number = p-number modulo 100
       75     .
       76     if p-number < 20
       77     then do:
       78       assign
       79         v-rest = p-number
       80       .
       81     end.
       82     else do:
       83       assign
       84         v-rest = p-number modulo 10
       85       .
       86     end.
       87     case v-rest :
       88       when 1
       89       then do:
       90         return 2 .
       91       end.
       92       when 2 or
       93       when 3 or
       94       when 4
       95       then do:
       96         return 3 .
       97       end.
       98       otherwise do:
       99         return 1 .
      100       end.
      101     end case .
      102   end.
      103   procedure cur-time-mjd-to-date :
      104      define input  parameter i-mjd-diff as decimal no-undo.
      105      define output parameter o-Date     as date    no-undo.
      106      define output parameter o-Time     as integer no-undo.
      107      define variable v-day-number as integer   no-undo .
      108      if    i-mjd-diff < 0
      109         or i-mjd-diff = ?
      110      then do:
      111         return "?" .
      112      end.
      113      assign
      114         v-day-number = truncate(i-mjd-diff,0).
      115         o-Date = date(v-day-number + 2400002).
      116         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      117     .
      118   end.
      119   function cur-time-mjd-to-string returns character
      120   (input p-mjd-diff as decimal
      121   )
      122   :
      123     define variable v-day-number as integer   no-undo .
      124     define variable v-seconds    as integer   no-undo .
      125     define variable v-hour       as integer   no-undo .
      126     define variable v-min        as integer   no-undo .
      127     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дн€" ] .
      128     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      129     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      130     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      131     if p-mjd-diff < 0
      132     or p-mjd-diff = ?
      133     then do:
      134       return "?" .
      135     end.
      136     assign
      137       v-day-number = integer(truncate(p-mjd-diff,0))
      138       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      139     .
      140     if v-seconds > 86400
      141     then do:
      142       assign
      143         v-seconds = 86400 - 1
      144       .
      145     end.
      146     if v-seconds < 0
      147     then do:
      148       assign
      149         v-seconds = 0
      150       .
      151     end.
      152     assign
      153       v-hour = truncate(v-seconds / 3600, 0)
      154     .
      155     assign
      156       v-seconds = v-seconds modulo 3600
      157     .
      158     assign
      159       v-min = truncate(v-seconds / 60, 0)
      160     .
      161     assign
      162       v-seconds = v-seconds modulo 60
      163     .
      164     return
      165         (if v-day-number <> 0
      166           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      167           else ""
      168         )
      169       + (if v-day-number <> 0 or v-hour <> 0
      170           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      171           else ""
      172         )
      173       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      174           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      175           else ""
      176         )
      177       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      178       .
      179   end.
      180   function cur-time-string returns character
      181   :
      182     define variable v-date as date      no-undo .
      183     define variable v-time as integer   no-undo .
      184     run cur-time in this-procedure
      185       (output v-date
      186       ,output v-time
      187       ) .
      188     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      189   end.
      190   function cur-time-string-sec returns character
      191   :
      192     define variable v-date as date      no-undo .
      193     define variable v-time as integer   no-undo .
      194     run cur-time in this-procedure
      195       (output v-date
      196       ,output v-time
      197       ) .
      198     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      199   end.
      200   function cur-time-custom  returns character
      201   (input p-prefix as character
      202   ,input p-date-format as character
      203   ,input p-delimiter as character
      204   ,input p-time-format as character
      205   ,input p-suffix as character
      206   )
      207   :
      208     define variable v-date as date      no-undo .
      209     define variable v-time as integer   no-undo .
      210     run cur-time in this-procedure
      211       (output v-date
      212       ,output v-time
      213       ) .
      214     return
      215       p-prefix
      216       + string(v-date, p-date-format)
      217       + p-delimiter
      218       + string(v-time, p-time-format)
      219       + p-suffix
      220       .
      221   end.
      222   function cur-time-print  returns character
      223   :
      224     define variable v-date as date      no-undo .
      225     define variable v-time as integer   no-undo .
      226     run cur-time in this-procedure
      227       (output v-date
      228       ,output v-time
      229       ) .
      230     return "ƒата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      231   end.
      232   function cur-time-datetime returns datetime
      233   :
      234     define variable v-char as character no-undo .
      235     define variable v-datetime as datetime no-undo .
      236     v-char = cur-time-string().
      237     v-datetime = datetime(v-char).
      238     return  v-datetime.
      239   end.
      240   function cur-time-string-msec returns character
      241   :
      242     define variable v-date as datetime  no-undo .
      243     v-date = now.
      244     return string(v-date) .
      245   end.
      246   define variable v-num   as integer no-undo .
      247   define variable v-sender-id as character no-undo .
      248   define variable v-receiver-id as character no-undo .
      249   define variable hDoc as handle no-undo.
      250   define variable hRoot as handle no-undo.
      251   define variable log_         as logical   no-undo.
      252   define variable v-today            as date      no-undo .
      253   define variable v-time             as integer   no-undo .
      254   define buffer buf_sent for ub.esys-pck-sent .
      255   define buffer buf_route for ub.esys-route .
      256   define buffer buf_dump for ub.esys-route-dump .
      257   v-num = ? .
      258   p-status_ = ? .
      259   create x-document hDoc.
      260   create x-noderef hRoot.
      261   hDoc:load("MEMPTR", p-pack-data, false).
      262   hDoc:get-document-element(hRoot).
      263   run GetChildren(hRoot, 1).
      264   delete object hDoc.
      265   delete object hRoot.
      266   if v-num <> ? and p-status_ = 0
      267   then do :
      268       find first buf_sent exclusive-lock where buf_sent.db-num = 0
      269                                            and buf_sent.esys-id = p-esys-id
      270                                            and buf_sent.esps-cr-db-num = g#db-num
      271                                            and buf_sent.esps-pack-num = v-num
      272                                            no-error.
      273       if not available buf_sent
      274       then do :
      275       end.
      276       else do :
      277         run cur-time in this-procedure
      278             ( output v-today
      279              ,output v-time
      280             ) no-error .
      281         assign
      282           buf_sent.esps-rcvd = yes
      283           buf_sent.esps-rcvdDate = v-today
      284           buf_sent.esps-rcvdtime = string(v-time, "HH:MM:SS")
      285           buf_sent.esps-rcvdtimeint = v-time
      286         .
      287         for each buf_route exclusive-lock where buf_route.esys-id = buf_sent.esys-id
      288                                             and buf_route.db-num = buf_sent.db-num
      289                                             and buf_route.esr-last-pack = buf_sent.esps-pack-num :
      290           for each buf_dump where buf_dump.esrd-dump-ord = buf_route.esr-dump-ord:
      291             delete buf_dump no-error .
      292           end.
      293           delete buf_route .
      294         end.
      295       end.
      296   end.
      297   procedure GetChildren :
      298     define input parameter hParent as handle .
      299     define input parameter level as integer .
      300     define variable i            as integer   no-undo.
      301     define variable hNoderef     as handle    no-undo.
      302     define variable hText        as handle    no-undo.
      303     create x-noderef hNoderef.
      304     create x-noderef hText .
      305     repeat i = 1 to hParent:num-children:
      306         log_ = hparent:get-child(hnoderef,i).
      307         if not log_ then
      308             leave.
      309         if hnoderef:subtype <> "element" then
      310             next.
      311         hnoderef:get-child(htext, 1) no-error .
      312         if hNoderef:name = "num" then v-num = integer(hText:node-value) no-error .
      313         if hNoderef:name = "sender-id" then v-sender-id = hText:node-value no-error .
      314         if hNoderef:name = "receiver-id" then v-receiver-id = hText:node-value no-error .
      315         if hNoderef:name = "status" then p-status_ = integer(hText:node-value) no-error .
      316         if hNoderef:name = "error" then p-error = hText:node-value no-error .
      317         run GetChildren (hNoderef, (level + 1)).
      318     end.
      319     DELETE OBJECT hNoderef.
      320     DELETE OBJECT hText.
      321   end procedure .
