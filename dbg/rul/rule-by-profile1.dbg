        1   block-level on error undo, throw.
        2   define input parameter        p-mode as character no-undo .
        3   define input parameter        p-silent as logical no-undo .
        4   define input-output parameter p-rec  as recid     no-undo .
        5   define input parameter        p-profile-id as integer no-undo .
        6   define input parameter        p-codex-id as integer no-undo .
        7   define input parameter        p-ruleset-id as integer no-undo .
        8   define input parameter        p-rule-id as integer no-undo .
        9   define input parameter        p-is-dynamic as logical no-undo .
       10   define input parameter        p-dflt-can-calc as logical   no-undo .
       11   define variable vss-revision    as character no-undo init "$Revision$":U .
       12   define variable vss-author      as character no-undo init "$Author$":U .
       13   define variable vss-date        as character no-undo init "$Date$":U .
       14   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       15   define variable vss-archive     as character no-undo init "$Archive$":U .
       16   define variable vss-description as character no-undo init "Сохранение привязки rule к profile".
       17   procedure vss-get-info :
       18     define output parameter p-vss-revision    like vss-revision    no-undo .
       19     define output parameter p-vss-author      like vss-author      no-undo .
       20     define output parameter p-vss-date        like vss-date        no-undo .
       21     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       22     define output parameter p-vss-archive     like vss-archive     no-undo .
       23     define output parameter p-vss-description like vss-description no-undo .
       24     assign
       25       p-vss-revision    = vss-revision
       26       p-vss-author      = vss-author
       27       p-vss-date        = vss-date
       28       p-vss-workfile    = vss-workfile
       29       p-vss-archive     = vss-archive
       30       p-vss-description = vss-description
       31     .
       32   end procedure.
       33   procedure vss-get-parameters :
       34     define output parameter p-vss-parameters as character no-undo .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75   define new global shared variable g#library  as handle no-undo .
       76   define new global shared variable g#library2 as handle no-undo .
       77   define   shared variable g#auto as logical no-undo.
       78   define   shared variable g#news as logical no-undo.
       79   define   shared variable g#oxml as logical no-undo.
       80   define   shared variable g#esys as logical no-undo.
       81   define   shared variable g#news-source-db as integer no-undo.
       82   define   shared variable g#esys-source-esys as integer no-undo.
       83   define   shared variable g#db-num as integer   no-undo .
       84   define   shared variable g#userid as character no-undo .
       85   define   shared variable g#passwd as character no-undo .
       86   define variable v-mess as character no-undo .
       87   define variable v-entry as character no-undo .
       88   define buffer buf_ruleset for ub.ruleset.
       89   define buffer buf_rule-by-profile for ub.rule-by-profile.
       90   define buffer buf_rule for ub.rule.
       91   define buffer buf_rule-profile for ub.rule-profile.
       92   define buffer buf_rule-by-set for ub.rule-by-set.
       93   define buffer last_rule-by-profile for ub.rule-by-profile.
       94   define buffer buf_ruledict for ub.ruledict.
       95   define buffer buf_ruledict-param for ub.ruledict-param.
       96   define buffer buf_rp-rule-param for ub.rp-rule-param.
       97   if p-mode <> 'ДОБАВЛЕНИЕ':U
       98   and p-mode <> 'ИЗМЕНЕНИЕ':U
       99   then do:
      100     message vss-workfile vss-revision vss-description skip
      101             "Неверный параметр p-mode - " p-mode
      102     view-as alert-box error .
      103     return error '':u.
      104   end.
      105   _main:
      106   do for buf_ruleset
      107   on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      108   on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
      109   on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
      110   :
      111     find first buf_ruleset no-lock where
      112               buf_ruleset.codex_id = p-codex-id
      113           and buf_ruleset.ruleset_id = p-ruleset-id no-error.
      114     if not available buf_ruleset then do:
      115       assign
      116       v-mess = "Не найден набор правил".
      117       run err-mess in this-procedure ( input-output v-mess).
      118       return error (if p-silent = yes then v-mess else '':U).
      119     end.
      120     find first buf_rule no-lock where
      121               buf_rule.rule_id = p-rule-id no-error.
      122     if not available buf_rule then do:
      123       assign
      124       v-mess = "Не найдено правило c таким №".
      125       run err-mess in this-procedure ( input-output v-mess).
      126       return error (if p-silent = yes then v-mess else '':U).
      127     end.
      128     find first buf_rule share-lock where
      129               buf_rule.rule_id = p-rule-id no-error.
      130     if buf_rule.sts = integer('-10':U)
      131     or buf_rule.sts = integer('1':U)
      132     or buf_rule.sts = integer('99':U)
      133     or buf_rule.sts = integer('98':U) then do:
      134       assign
      135       v-mess = substitute("Правило находится в статусе &1", entry (lookup (string( buf_rule.sts), '-1,-10,0,1,99,98':U), 'готов,нов,исп,удал,удаление,запр.удал':U)).
      136       run err-mess in this-procedure ( input-output v-mess).
      137       return error (if p-silent = yes then v-mess else 'sts':U).
      138     end.
      139     find first buf_rule-profile no-lock where
      140               buf_rule-profile.profile_id = p-profile-id no-error.
      141     if not available buf_rule then do:
      142       assign
      143       v-mess = "Не найден профайл c таким №".
      144       run err-mess in this-procedure ( input-output v-mess).
      145       return error (if p-silent = yes then v-mess else '':U).
      146     end.
      147     find first buf_rule-by-set no-lock where
      148               buf_rule-by-set.codex_id = p-codex-id
      149           and  buf_rule-by-set.ruleset_id = p-ruleset-id
      150           and  buf_rule-by-set.rule_id = p-rule-id no-error.
      151     if not available buf_rule-by-set then do:
      152       assign
      153       v-mess = substitute("Правило с № &1 не привязано к набору правил &2 кодекс &3"
      154                           , p-rule-id
      155                           , p-ruleset-id
      156                           , p-codex-id).
      157       run err-mess in this-procedure ( input-output v-mess).
      158       return error (if p-silent = yes then v-mess else '':U).
      159     end.
      160     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      161       find last last_rule-by-profile no-lock where
      162               last_rule-by-profile.profile_id = p-profile-id
      163           and last_rule-by-profile.codex_id = p-codex-id
      164           and last_rule-by-profile.ruleset_id = p-ruleset-id  no-error.
      165       create buf_rule-by-profile.
      166       assign
      167       buf_rule-by-profile.codex_id = p-codex-id
      168       buf_rule-by-profile.ruleset_id = p-ruleset-id
      169       buf_rule-by-profile.rule_id = p-rule-id
      170       buf_rule-by-profile.profile_id = p-profile-id
      171       buf_rule-by-profile.rp_order_id = ( if available last_rule-by-profile
      172                                        then last_rule-by-profile.rp_order_id + 1
      173                                        else 0)
      174       buf_rule-by-profile.is_dynamic = p-is-dynamic
      175       buf_rule-by-profile.dflt-can-calc = p-dflt-can-calc
      176       p-rec = recid(buf_rule-by-profile)
      177       .
      178       if buf_rule.sts <> integer('0':U) then do:
      179         buf_rule.sts = integer('0':U).
      180       end.
      181     end.
      182     else do:
      183       find first buf_rule-by-profile exclusive-lock where
      184                 recid(buf_rule-by-profile) = p-rec .
      185       assign
      186       buf_rule-by-profile.is_dynamic = p-is-dynamic
      187       buf_rule-by-profile.dflt-can-calc = p-dflt-can-calc
      188       .
      189     end.
      190     find first buf_ruledict where
      191               buf_ruledict.entry-type = 'rule':U
      192           and buf_ruledict.uniq-key-rec = buf_rule.uniq-key-rec.
      193     for each buf_ruledict-param where
      194             buf_ruledict-param.entry-id = buf_ruledict.entry-id
      195     on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      196     on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
      197     on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
      198     :
      199       find first buf_rp-rule-param where
      200                 buf_rp-rule-param.profile_id = buf_rule-profile.profile_id
      201             and buf_rp-rule-param.codex_id = buf_rule-by-profile.codex_id
      202             and buf_rp-rule-param.ruleset_id = buf_rule-by-profile.ruleset_id
      203             and buf_rp-rule-param.rp_order_id = buf_rule-by-profile.rp_order_id
      204             and buf_rp-rule-param.rule_id = buf_rule-by-profile.rule_id
      205             and buf_rp-rule-param.rule-param-name = buf_ruledict-param.param-name no-error .
      206       if not available buf_rp-rule-param then do:
      207         create buf_rp-rule-param.
      208         assign
      209         buf_rp-rule-param.profile_id = buf_rule-profile.profile_id
      210         buf_rp-rule-param.codex_id = buf_rule-by-profile.codex_id
      211         buf_rp-rule-param.ruleset_id = buf_rule-by-profile.ruleset_id
      212         buf_rp-rule-param.rp_order_id = buf_rule-by-profile.rp_order_id
      213         buf_rp-rule-param.rule_id = buf_rule-by-profile.rule_id
      214         buf_rp-rule-param.rule-param-name = buf_ruledict-param.param-name
      215         .
      216       end.
      217     end.
      218   end.
      219   PROCEDURE err-mess:
      220     DEFINE INPUT-OUTPUT PARAMETER p-mess as character No-UNDO.
      221     CASE p-silent:
      222       when yes then do:
      223         assign
      224         p-mess = substitute("Привязка правила к профайлу:&1профайл &2 кодекс &3 набор &4 правило &5"
      225                            , chr(10)
      226                            , p-profile-id
      227                            , p-codex-id
      228                            , p-ruleset-id
      229                            , p-rule-id
      230                            , p-mess)
      231         .
      232       end.
      233       when no then do:
      234         message
      235         p-mess
      236         view-as alert-box error .
      237       end.
      238     end.
      239   END PROCEDURE.
