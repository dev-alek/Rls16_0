     1931   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1932   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1933   def var vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1934   procedure get-gate-file-name :
     1935   define input parameter p-gate-rec as character no-undo .
     1936   define output  parameter p-gate-file-name as character no-undo .
     1937   define buffer buf_clob-data for ub.clob-data.
     1938   define variable v-tbl-row as rowid no-undo .
     1939   define variable v-tbl-name as character no-undo .
     1940   run gen-row-keyr in this-procedure ( input p-gate-rec
     1941                                       ,input ?
     1942                                       ,input "ub"
     1943                                       ,input ?
     1944                                       ,input no-lock
     1945                                       ,output v-tbl-row
     1946                                       ,output v-tbl-name) no-error.
     1947   if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     1948                                                           ,vss-include-info16
     1949                                                           ,p-gate-rec).
     1950   find first buf_clob-data no-lock where
     1951             rowid(buf_clob-data) = v-tbl-row no-error.
     1952   if not available buf_clob-data then do:
     1953     if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     1954                                                             ,vss-include-info16
     1955                                                             ,p-gate-rec).
     1956   end.
     1957   p-gate-file-name = buf_clob-data.file-name.
     1958   end procedure.
     1959   procedure get-gate-rec :
     1960   define input  parameter p-gate-name as character no-undo .
     1961   define output parameter p-gate-rec as character no-undo .
     1962   define buffer buf_clob-bind for ub.clob-bind.
     1963   define buffer buf_clob-data for ub.clob-data.
     1964   main-block:
     1965   do
     1966   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info16, return-value, chr(10), error-status :get-message (1))
     1967   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info16 )
     1968   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info16 )
     1969   :
     1970       find first buf_clob-bind no-lock where
     1971                 buf_clob-bind.uniq-key-rec = p-gate-name
     1972             and buf_clob-bind.field-name = '':U
     1973             and buf_clob-bind.part-num = 1
     1974             and buf_clob-bind.resource-type = 'gate':U
     1975             no-error.
     1976       if not available buf_clob-bind then do:
     1977         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     1978                                         , p-gate-name
     1979                                         ).
     1980       end.
     1981       find first buf_clob-data no-lock where
     1982                 buf_clob-data.db-num = buf_clob-bind.db-num
     1983             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     1984       if not available buf_clob-data then do:
     1985         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1986                                         , buf_clob-bind.db-num
     1987                                         , buf_clob-bind.int64-id
     1988                                         , p-gate-name
     1989                                         ).
     1990       end.
     1991       run gen-key-rec in this-procedure ( input 'clob-data':U
     1992                                 ,input buffer buf_clob-data:handle
     1993                                 ,output p-gate-rec).
     1994   end.
     1995   end procedure.
     1996   procedure get-gate-by-name :
     1997   define input  parameter p-gate-name as character no-undo .
     1998   define output parameter p-gate-rec as character no-undo .
     1999   define output parameter p-dsh as handle no-undo .
     2000   define input-output  parameter p-xmlh as handle no-undo .
     2001   define variable v-ii as integer   no-undo .
     2002   define variable glog as logical   no-undo .
     2003   define variable v-longchar as longchar no-undo .
     2004   define variable v-txmlh as handle no-undo .
     2005   define variable v-db-num as integer no-undo .
     2006   define variable v-int64-id as int64 no-undo .
     2007   define buffer buf_clob-bind for ub.clob-bind.
     2008   define buffer buf_clob-data for ub.clob-data.
     2009   main-block:
     2010   do
     2011   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info16, return-value, chr(10), error-status :get-message (1))
     2012   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info16 )
     2013   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info16 )
     2014   :
     2015       find first buf_clob-bind no-lock where
     2016                 buf_clob-bind.uniq-key-rec = p-gate-name
     2017             and buf_clob-bind.field-name = '':U
     2018             and buf_clob-bind.part-num = 1
     2019             and buf_clob-bind.resource-type = 'gate':U
     2020             no-error.
     2021       if not available buf_clob-bind then do:
     2022         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     2023                                         , p-gate-name
     2024                                         ).
     2025       end.
     2026       find first buf_clob-data no-lock where
     2027                 buf_clob-data.db-num = buf_clob-bind.db-num
     2028             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     2029       if not available buf_clob-data then do:
     2030         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     2031                                         , buf_clob-bind.db-num
     2032                                         , buf_clob-bind.int64-id
     2033                                         , p-gate-name
     2034                                         ).
     2035       end.
     2036       assign
     2037       v-longchar = buf_clob-data.cdata
     2038       .
     2039       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     2040       if error-status :error then do:
     2041         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     2042       end.
     2043       create dataset p-dsh .
     2044       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     2045                                     , v-longchar
     2046                                     , ?
     2047                                     , ?
     2048                                     , ?
     2049                                     ) no-error.
     2050       v-longchar = '':U.
     2051       if error-status :error
     2052       or not glog
     2053       then do:
     2054         undo, return error substitute("Не удалось прочитать XML-схему &1 из БД:&2&3", p-gate-name, chr(10), error-status:get-message(1) ).
     2055       end.
     2056       if not valid-handle(p-xmlh)
     2057       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     2058         create temp-table v-txmlh.
     2059         v-txmlh:create-like(buffer temp-xml-tables:handle).
     2060         v-txmlh:temp-table-prepare("temp-xml-tables").
     2061         p-xmlh = v-txmlh:default-buffer-handle.
     2062       end.
     2063       run gen-key-rec in this-procedure ( input 'clob-data':U
     2064                                 ,input buffer buf_clob-data:handle
     2065                                 ,output p-gate-rec).
     2066       do v-ii = 1 to p-dsh:num-buffers:
     2067         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     2068         if not p-xmlh:available then do:
     2069           p-xmlh:buffer-create().
     2070           assign
     2071           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     2072           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     2073           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     2074           p-xmlh::gate-handle_ = p-dsh
     2075           p-xmlh::uniq-gate-rec = p-gate-rec
     2076           p-xmlh::gate-name = p-dsh:name
     2077           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     2078           .
     2079           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     2080             assign
     2081             p-xmlh::order = -3.
     2082           end.
     2083         end.
     2084       end.
     2085   end.
     2086   end procedure.
     2087   procedure get-gate-by-rec :
     2088   define input  parameter p-gate-rec as character no-undo .
     2089   define output parameter p-dsh as handle no-undo .
     2090   define input-output  parameter p-xmlh as handle no-undo .
     2091   define input-output parameter p-longchar  as longchar no-undo .
     2092   define variable v-ii as integer   no-undo .
     2093   define variable glog as logical   no-undo .
     2094   define variable v-rowid as rowid no-undo .
     2095   define variable v-tbl-name as character no-undo .
     2096   define variable v-longchar as longchar no-undo .
     2097   define variable v-txmlh as handle no-undo .
     2098   define buffer buf_clob-data for ub.clob-data.
     2099   main-block:
     2100   do
     2101   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info16, return-value, chr(10), error-status :get-message (1))
     2102   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info16 )
     2103   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info16 )
     2104   :
     2105     run gen-row-keyr in this-procedure (
     2106                                           input  p-gate-rec
     2107                                           ,input  ?
     2108                                           ,input  "ub"
     2109                                           ,input  ?
     2110                                           ,input  NO-LOCK
     2111                                           ,output v-rowid
     2112                                           ,output v-tbl-name   ) no-error.
     2113       find first buf_clob-data no-lock where
     2114                 rowid(buf_clob-data) = v-rowid  no-error.
     2115       if not available buf_clob-data then do:
     2116         undo, return error substitute("Не найден CLOB  &1"
     2117                                         , p-gate-rec
     2118                                         ).
     2119       end.
     2120       assign
     2121       v-longchar = buf_clob-data.cdata
     2122       .
     2123       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     2124       if error-status :error then do:
     2125         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     2126       end.
     2127       create dataset p-dsh .
     2128       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     2129                                     , v-longchar
     2130                                     , ?
     2131                                     , ?
     2132                                     , ?
     2133                                     ) no-error.
     2134       define variable v-esm as character no-undo .
     2135       v-esm = error-status:get-message(1) .
     2136       if p-longchar <> ? then do:
     2137         p-longchar = v-longchar.
     2138       end.
     2139       v-longchar = '':U.
     2140       if error-status :error
     2141       or not glog
     2142       then do:
     2143         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     2144                                      , p-gate-rec
     2145                                      , p-gate-rec
     2146                                      , v-esm
     2147                                      ).
     2148       end.
     2149       p-dsh:private-data = buf_clob-data.file-name_ + chr(4) + p-gate-rec.
     2150       if not valid-handle(p-xmlh)
     2151       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     2152         create temp-table v-txmlh.
     2153         v-txmlh:create-like(buffer temp-xml-tables:handle).
     2154         v-txmlh:temp-table-prepare("temp-xml-tables").
     2155         p-xmlh = v-txmlh:default-buffer-handle.
     2156       end.
     2157       do v-ii = 1 to p-dsh:num-buffers:
     2158         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     2159         if not p-xmlh:available then do:
     2160           p-xmlh:buffer-create().
     2161           assign
     2162           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     2163           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     2164           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     2165           p-xmlh::gate-handle_ = p-dsh
     2166           p-xmlh::uniq-gate-rec = p-gate-rec
     2167           p-xmlh::gate-name = p-dsh:name
     2168           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     2169           .
     2170           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     2171             assign
     2172             p-xmlh::order = -3.
     2173           end.
     2174           p-xmlh:buffer-release().
     2175         end.
     2176       end.
     2177   end.
     2178   end procedure.
     2179   procedure get-gate-by-file :
     2180   define input  parameter p-schema-file-name as character no-undo .
     2181   define input  parameter p-gate-rec as character no-undo .
     2182   define output parameter p-dsh as handle no-undo .
     2183   define input-output  parameter p-xmlh as handle no-undo .
     2184   define variable v-ii as integer   no-undo .
     2185   define variable glog as logical   no-undo .
     2186   define variable v-rowid as rowid no-undo .
     2187   define variable v-tbl-name as character no-undo .
     2188   define variable v-longchar as longchar no-undo .
     2189   define variable v-txmlh as handle no-undo .
     2190   main-block:
     2191   do
     2192   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info16, return-value, chr(10), error-status :get-message (1))
     2193   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info16 )
     2194   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info16 )
     2195   :
     2196       COPY-LOB
     2197       FROM  FILE p-schema-file-name
     2198       TO  OBJECT v-longchar
     2199       no-convert
     2200       NO-ERROR .
     2201       if error-status :error then do:
     2202           undo, return error substitute("Не удалось считать файл схемы &1 в память&2&3"
     2203                                     , p-schema-file-name
     2204                                 , chr(10)
     2205                                 , error-status:get-message(1) ).
     2206       end.
     2207       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     2208       if error-status :error then do:
     2209         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, p-schema-file-name, chr(10), error-status:get-message(1) , return-value ).
     2210       end.
     2211       create dataset p-dsh .
     2212       glog = p-dsh:READ-XMLSCHEMA( "longchar"
     2213                                     , v-longchar
     2214                                     , ?
     2215                                     , ?
     2216                                     , ?
     2217                                     ) no-error.
     2218       v-longchar = ''.
     2219       if error-status :error
     2220       or not glog
     2221       then do:
     2222         undo, return error substitute("Не удалось прочитать XML-схему из файла &1&2&3"
     2223                                      , p-schema-file-name
     2224                                      ,chr(10)
     2225                                      , error-status:get-message(1)
     2226                                      ).
     2227       end.
     2228       if not valid-handle(p-xmlh)
     2229       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     2230         create temp-table v-txmlh.
     2231         v-txmlh:create-like(buffer temp-xml-tables:handle).
     2232         v-txmlh:temp-table-prepare("temp-xml-tables").
     2233         p-xmlh = v-txmlh:default-buffer-handle.
     2234       end.
     2235       do v-ii = 1 to p-dsh:num-buffers:
     2236         p-xmlh:find-first(substitute(' where tbl-name = "&1" and  uniq-gate-rec = "&2" '
     2237                                      ,p-dsh:get-buffer-handle(v-ii):name
     2238                                      ,p-gate-rec
     2239                                      )) no-error.
     2240         if not p-xmlh:available then do:
     2241           p-xmlh:buffer-create().
     2242           assign
     2243           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):table
     2244           p-xmlh::uniq-gate-rec = p-gate-rec
     2245           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     2246           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     2247           p-xmlh::gate-handle_ = p-dsh
     2248           p-xmlh::gate-name = p-dsh:name
     2249           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     2250           .
     2251           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     2252             assign
     2253             p-xmlh::order = -3.
     2254           end.
     2255           p-xmlh:buffer-release().
     2256         end.
     2257       end.
     2258   end.
     2259   end procedure.
     2260   procedure gate-clear :
     2261   define input  parameter p-dsh as handle no-undo .
     2262   define input  parameter p-xmlh as handle no-undo .
     2263   define variable v-dsh as handle no-undo .
     2264   define variable v-th as handle no-undo .
     2265     do
     2266     on error undo, return error return-value
     2267     :
     2268       if valid-handle(p-dsh) then do:
     2269         delete object p-dsh.
     2270         v-dsh = p-dsh.
     2271         p-dsh = ?.
     2272       end.
     2273       repeat while true:
     2274         p-xmlh:find-first( substitute( " where gate-handle_ = &1 ", v-dsh)
     2275                            , share-lock) no-error.
     2276         if p-xmlh:available then do:
     2277           assign
     2278           v-th = p-xmlh:buffer-field("table-handle_"):buffer-value.
     2279           if valid-handle(p-xmlh:buffer-field("table-handle_"))
     2280           and valid-handle(v-th)
     2281           and v-th:dynamic = yes
     2282           then do:
     2283             delete object p-xmlh:buffer-field("table-handle_"):buffer-value.
     2284             p-xmlh:buffer-field("table-handle_"):buffer-value = ?.
     2285           end.
     2286           p-xmlh:buffer-delete().
     2287         end.
     2288         else do:
     2289           leave.
     2290         end.
     2291       end.
     2292       if p-xmlh:dynamic = yes
     2293       and valid-handle(p-xmlh)
     2294       then do:
     2295         delete object p-xmlh:table-handle.
     2296         p-xmlh = ?.
     2297       end.
     2298       v-dsh = ?.
     2299     end.
     2300   end procedure.
     2301   procedure all-gates-clear :
     2302   define parameter buffer buf_temp-xml-tables for temp-xml-tables.
     2303   do
     2304   on error undo, return error
     2305   :
     2306     for each buf_temp-xml-tables
     2307     break
     2308     by buf_temp-xml-tables.uniq-gate-rec
     2309     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2310     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     2311     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     2312     :
     2313         if first-of(buf_temp-xml-tables.uniq-gate-rec) then do:
     2314           delete object buf_temp-xml-tables.gate-handle_.
     2315           buf_temp-xml-tables.gate-handle_ = ?.
     2316         end.
     2317         if valid-handle(buf_temp-xml-tables.table-handle_)
     2318         and buf_temp-xml-tables.table-handle_:dynamic = no
     2319         then do:
     2320           delete object buf_temp-xml-tables.table-handle_.
     2321           buf_temp-xml-tables.table-handle_ = ?.
     2322         end.
     2323         delete buf_temp-xml-tables.
     2324     end.
     2325   end.
     2326   end procedure.
     2327   procedure fix-schemalocation :
     2328   define input-output  parameter p-longchar as longchar no-undo .
     2329   DEFINE VARIABLE hdoc AS HANDLE.
     2330   DEFINE VARIABLE hroot AS HANDLE.
     2331   DEFINE VARIABLE hnode-child AS HANDLE.
     2332   DEFINE VARIABLE hnode-attr AS HANDLE.
     2333   define variable v-jj as integer   no-undo .
     2334   define variable ok as logical   no-undo .
     2335   define variable v-path1                    as character                no-undo .
     2336   DEFINE VARIABLE v-full-path1               as character                no-undo .
     2337   DEFINE VARIABLE v-file-name1               as character                no-undo .
     2338   DEFINE VARIABLE v-file-name-no-ext1        as character                no-undo .
     2339   DEFINE VARIABLE v-file-name-ext1           as character                no-undo .
     2340   define variable v-schema-location          as character                no-undo .
     2341   do
     2342   on error undo, return error return-value
     2343   :
     2344     CREATE X-DOCUMENT hdoc.
     2345     CREATE X-noderef hroot.
     2346     CREATE X-noderef hnode-child.
     2347     CREATE X-noderef hnode-attr.
     2348     hdoc:load("longchar", p-longchar, no) no-error.
     2349     iF ERROR-STATUS:GET-MESSAGE(1) <> '' THEN message ERROR-STATUS:GET-MESSAGE(1) view-as alert-box .
     2350     hdoc:get-document-element(hroot).
     2351     _repeat:
     2352     REPEAT v-jj = 1 TO hroot:NUM-CHILDREN:
     2353       ok = hroot:GET-CHILD(hNode-Child, v-jj).
     2354       if not ok then next.
     2355       if hNode-Child:local-name = "include"
     2356       then do:
     2357         ok = hNode-Child:GET-ATTRIBUTE-NODE( hnode-attr, "schemaLocation" ).
     2358           v-schema-location = hnode-attr:node-value.
     2359           run gbl/filename.p (
     2360                           input "exe/" + hnode-attr:node-value
     2361                         ,output v-full-path1
     2362                         ,output v-path1
     2363                         ,output v-file-name1
     2364                         ,output v-file-name-no-ext1
     2365                         ,output v-file-name-ext1
     2366                         ) no-error .
     2367           if error-status :error then do:
     2368             delete object hnode-attr.
     2369             delete object hnode-child.
     2370             delete object hroot.
     2371             delete object hdoc.
     2372             undo, return error substitute("Не удалось определить расположение схемы &1", v-schema-location).
     2373           end.
     2374         ok = hNode-Child:sET-ATTRIBUTE(  "schemaLocation", v-full-path1 ).
     2375         leave  _repeat.
     2376       end.
     2377     END.
     2378     hdoc:save("longchar", p-longchar).
     2379     delete object hnode-attr.
     2380     delete object hnode-child.
     2381     delete object hroot.
     2382     delete object hdoc.
     2383   end.
     2384   end procedure.
     2385   procedure gate-clb_fill-xml-tables :
     2386   define input parameter p-dsh as handle no-undo .
     2387   define input-output parameter p-xmlh as handle no-undo .
     2388   define variable v-ii as integer no-undo .
     2389     do
     2390     on error undo, return error
     2391     :
     2392       do v-ii = 1 to p-dsh:num-buffers:
     2393         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     2394         if not p-xmlh:available then do:
     2395           p-xmlh:buffer-create().
     2396           assign
     2397           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     2398           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     2399           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     2400           p-xmlh::gate-handle_ = p-dsh
     2401           p-xmlh::uniq-gate-rec = entry(2, p-dsh:private-data, chr(4))
     2402           p-xmlh::gate-name = p-dsh:name
     2403           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     2404           .
     2405           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     2406             assign
     2407             p-xmlh::order = -3.
     2408           end.
     2409           p-xmlh:buffer-release().
     2410         end.
     2411       end.
     2412     end.
     2413   end procedure.
     2414   procedure all-gates-empty :
     2415   define buffer buf_temp-xml-tables for temp-xml-tables.
     2416   do
     2417   on error undo, return error
     2418   :
     2419     for each buf_temp-xml-tables
     2420     break
     2421     by buf_temp-xml-tables.uniq-gate-rec
     2422     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2423     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     2424     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     2425     :
     2426       if valid-handle(buf_temp-xml-tables.tbl-handle_) then do:
     2427         buf_temp-xml-tables.tbl-handle_:empty-temp-table().
     2428       end.
     2429     end.
     2430   end.
     2431   end procedure.
     2432   define variable v-current-d-card as character no-undo .
     2433   define variable v-current-host-code as integer no-undo .
     2434   define variable v-current-obj-type as character no-undo .
     2435   define variable v-current-obj-code as integer no-undo .
     2436   define variable v-current-doc-code as character no-undo .
     2437   define variable v-current-doc-date as date no-undo .
     2438   define variable v-current-doc-type as character no-undo .
     2439   define variable v-current-doc-time as integer no-undo .
     2440   define variable v-current-lock as integer no-undo .
     2441   define variable v-current-wait as integer no-undo .
     2442   define variable v-save as integer no-undo .
     2443   define variable v-current-db-num as integer no-undo .
     2444   define variable v-current-date as date no-undo .
     2445   define variable v-emitent-host-code as integer no-undo .
     2446   define variable v-type as character no-undo .
     2447   define variable v-sign as integer no-undo .
     2448   define variable file-name as char.
     2449   define variable num-rec as integer no-undo .
     2450   define variable num-rec-ok as integer no-undo .
