     2487   function 00040003_get-error-message returns character :
     2488   define variable v-ii as integer no-undo .
     2489   define variable v-mess as character no-undo .
     2490   DO v-ii = 1 TO ERROR-STATUS:NUM-MESSAGES:
     2491       v-mess = substitute("&1&2ош &3"
     2492                           ,v-mess
     2493                           ,chr(10)
     2494                           ,ERROR-STATUS:GET-MESSAGE(v-ii)).
     2495   END.
     2496   return v-mess.
     2497   end function.
