     2661   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2662   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
     2663   run gbl/getobjsrvhndl.p (input-output ObjSrv).
     2664   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2665   function context_get-thobj-es return logical
     2666   (
     2667      input p-esys-id as integer
     2668     ,input p-eobj-type as character
     2669     ,input p-eobj-code as integer
     2670     ,output p-obj-type as character
     2671     ,output p-obj-code as integer
     2672   ):
     2673      define variable v-value-list as character no-undo .
     2674      define variable v-field-list as character no-undo .
     2675      define buffer buf_clients for ub.clients.
     2676      define buffer buf_ext-classif for ub.ext-classif.
     2677      find first buf_ext-classif no-lock where
     2678                buf_ext-classif.classif-name = 'clients-esys':U
     2679            and buf_ext-classif.classif-subject = 'clients':U
     2680            and buf_ext-classif.db-num = 0
     2681            and buf_Ext-classif.key#_one = p-esys-id
     2682            and buf_Ext-classif.charkey_one = p-eobj-type
     2683            and buf_Ext-classif.key#_two = p-eobj-code no-error .
     2684      if available buf_Ext-classif
     2685      then do:
     2686         ObjSrv:Lib:KeyRec:GenKeyFv (
     2687                                         input buf_Ext-classif.uniq-key-rec
     2688                                         ,output v-field-list
     2689                                         ,output v-value-list).
     2690         assign
     2691            p-obj-type = entry(lookup("obj-type":U
     2692                                     , v-field-list
     2693                                     , chr(3))
     2694                                     , v-value-list, chr(3))
     2695            p-obj-code = integer(entry(lookup("obj-code":U
     2696                                            , v-field-list
     2697                                            , chr(3))
     2698                                      , v-value-list
     2699                                      , chr(3)))
     2700         no-error .
     2701      end.
     2702      if     available buf_ext-classif
     2703         and (p-obj-type = 'маг':U
     2704              or
     2705              p-obj-type = 'скл':U
     2706              )
     2707         and (p-obj-code > 0 and p-obj-code <= 99999)
     2708      then do:
     2709         find first buf_clients no-lock where
     2710                    buf_clients.obj-type = p-obj-type
     2711                and buf_clients.obj-code = p-obj-code no-error.
     2712         if available buf_clients then do:
     2713            return yes.
     2714         end.
     2715         else do:
     2716            assign
     2717               p-obj-type = '':U
     2718               p-obj-code = 0
     2719            .
     2720            return no.
     2721         end.
     2722      end.
     2723      else do:
     2724         assign
     2725            p-obj-type = '':U
     2726            p-obj-code = 0
     2727         .
     2728         return no.
     2729      end.
     2730   end.
     2731   on delete of this-procedure do:
     2732     run delete-procedure in this-procedure .
     2733   end.
     2734   run load-ruleset-context in this-procedure ( input p-ruleset-id) no-error .
     2735   if error-status:error
     2736   or return-value = "return" then return.
     2737    define variable Card-num1 as  character no-undo .
     2738    define variable Card1 as class Dis-card_ no-undo .
     2739   Card1 = new Dis-card_( input parparentproc, input p-parent-handle, input p-log-handle, input this-procedure:handle, input p-cont-handle, input v-current-lock, input v-current-wait, input v-save) .
     2740    define variable ImpData1 as class Route-data_ no-undo .
     2741   ImpData1 = new Route-data_( input parparentproc, input p-parent-handle, input p-log-handle, input this-procedure:handle, input v_dataseth, input v-xmlh) .
     2742    define variable Sale-doc-action1 as  integer no-undo .
     2743    define variable Sale-sums as class Dis-card-sale_obj no-undo .
     2744   Sale-sums = new Dis-card-sale_obj( input parparentproc, input p-parent-handle, input p-log-handle, input this-procedure:handle, input vh_dis-card-sale_obj, input p-codex-id, input p-ruleset-id) .
     2745   if not this-procedure:persistent then do:
     2746     run proc-main in this-procedure ( input p-type
     2747                                 ,input p-emitent-host-code ) no-error .
     2748     if error-status:error then do:
     2749         run delete-procedure in this-procedure .
     2750         undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     2751     end.
     2752     run delete-procedure in this-procedure .
     2753   end.
     2754   procedure proc-main :
     2755   define input parameter p-type like ub.dis-card.type no-undo .
     2756   define input parameter p-emitent-host-code like ub.dis-card.emitent-host-code no-undo .
     2757   define variable v-ii as integer   no-undo .
     2758   _main:
     2759   do
     2760   on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2761   on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
     2762   on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
     2763   :
     2764   assign
     2765   v-emitent-host-code = p-emitent-host-code
     2766   v-type = p-type.
     2767   run write-log  in p-log-handle (
     2768                                    input 0
     2769                                  , "&DLine").
     2770   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Импорт данных по ДК из файла &1", file-name)).
     2771   do v-ii = 1 to num-entries(v-ds-read-order):
     2772     find first buf_temp-xml-tables where
     2773               buf_temp-xml-tables.tbl-name = entry(v-ii, v-ds-read-order)
     2774          and  buf_temp-xml-tables.gate-handle_ = v_dataseth.
     2775     create query v_qh.
     2776     glog = v_qh:set-buffers( buf_temp-xml-tables.tbl-handle_) no-error.
     2777     if error-status:error
     2778     or
     2779     not glog then do:
     2780           .
     2781      undo _main, return error ''.
     2782     end.
     2783     glog = v_qh:query-prepare( substitute( "for each &1 ", buf_temp-xml-tables.tbl-name)) no-error .
     2784     if error-status:error
     2785     or
     2786     not glog then do:
     2787           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при попытке получить записи &1&2&3&2&4"                                                             , buf_temp-xml-tables.tbl-name                                                             , chr(10)                                                             , error-status:get-message(1)                                                             , return-value)).
     2788      undo _main, return error ''.
     2789     end.
     2790     glog = v_qh:query-open no-error .
     2791     if error-status:error
     2792     or
     2793     not glog then do:
     2794           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при попытке получить записи &1&2&3&2&4"                                                             , buf_temp-xml-tables.tbl-name                                                             , chr(10)                                                             , error-status:get-message(1)                                                             , return-value)).
     2795       undo _main, return error ''.
     2796     end.
     2797     _stroka:
     2798     REPEAT:
     2799       num-rec = num-rec + 1.
     2800       v-retry-action = 0 .
     2801       _release:
     2802       do on error undo, retry:
     2803         if  retry then do:
     2804           v-retry-action = v-retry-action + 1.
     2805                   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при импорте записи &5 &1&2&3&2&4"                                                                  , buf_temp-xml-tables.tbl-name                                                                 , num-rec                                                                 , chr(10)                                                                 , error-status:get-message(1)                                                                 , return-value)).
     2806           undo _main, return error ''.
     2807         end.
     2808   if v-retry-action < 1 then do:
     2809   ImpData1:Route-data_dump ( ) .
     2810   end.
     2811   if v-retry-action < 2 then do:
     2812   Card1:Dis-card_release_ ( ) .
     2813   end.
     2814   if v-retry-action < 3 then do:
     2815   Sale-sums:Dis-card-sale_objrelease_ ( ) .
     2816   end.
     2817         end.
     2818       _rule:
     2819         do on error undo _rule, retry _rule:
     2820           if retry then do:
     2821                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("&1&2&3"                                       , error-status:get-message(1)                                       , chr(10)                                       , return-value)).
     2822             undo _main, return error ''.
     2823           end.
     2824           else do:
     2825           v_qh:get-next().
     2826           IF v_qh:query-off-end then leave _stroka.
     2827   _1938:
     2828   do:
     2829   IF  ImpData1:current-tbl-name( ) = "sale-card-doc"  THEN do:
     2830     _1950:
     2831     do:
     2832      v-current-doc-code = ImpData1:route-data_get-field-character( input "sale-card-doc", input "sale-doc") .
     2833      v-current-doc-date = ImpData1:route-data_get-field-date( input "sale-card-doc", input "sale-date") .
     2834      v-current-doc-type = ImpData1:route-data_get-field-character( input "sale-card-doc", input "sale-type") .
     2835      Sale-doc-action1 = ImpData1:route-data_get-field-integer( input "sale-card-doc", input "action") .
     2836     IF  Sale-doc-action1 = -1  THEN do:
     2837       _1958:
     2838       do:
     2839        v-current-doc-code = "-" + v-current-doc-code .
     2840       end.
     2841     end.
     2842     IF  context_get-thobj-es( input p-esys-id, input  ImpData1:route-data_get-field-character( input "sale-card-doc", input "obj-type") , input  ImpData1:route-data_get-field-integer( input "sale-card-doc", input "obj-code") , output v-current-obj-type, output v-current-obj-code) = false  THEN do:
     2843       _1951:
     2844       do:
     2845        run write-log-and-file in p-log-handle (
     2846                   input 1
     2847                 , input log-file-name
     2848                 , input 1
     2849                 , input "Не найдено соответствие объекта внешней системы и объекта TH").
     2850   assign v-view-log = yes
     2851    .
     2852        undo _main, return error v-last-error-message .
     2853       end.
     2854     end.
     2855     end.
     2856   end.
     2857   IF  ImpData1:current-tbl-name( ) = "sale-card-line"  THEN do:
     2858     _1952:
     2859     do:
     2860      Card-num1 = ImpData1:route-data_get-field-character( input "sale-card-line", input "d-card") .
     2861     IF  Card1:find_dis-card_no-error( INPUT Card-num1) = false  THEN do:
     2862       _1953:
     2863       do:
     2864        run write-log-and-file in p-log-handle (
     2865                   input 1
     2866                 , input log-file-name
     2867                 , input 1
     2868                 , input "Отсутствует карта в БД: импорт невозможен").
     2869   assign v-view-log = yes
     2870    .
     2871        undo _main, return error v-last-error-message .
     2872       end.
     2873     end.
     2874     IF  Card1:emitent-host-code <> v-emitent-host-code OR Card1:type <> v-type  THEN do:
     2875       _1959:
     2876       do:
     2877        next _stroka .
     2878       end.
     2879     end.
     2880     IF  Sale-sums:create_dis-card-sale_obj( INPUT Card-num1, INPUT v-current-obj-type, INPUT v-current-obj-code, INPUT v-current-doc-code, INPUT v-current-doc-date) = false  THEN do:
     2881       _1954:
     2882       do:
     2883        undo _main, return error v-last-error-message .
     2884       end.
     2885     end.
     2886     IF  Sale-sums:set_dis-card-sale_obj( input  Card1:get_dis-card_() ) = false  THEN do:
     2887       _1960:
     2888       do:
     2889        undo _main, return error v-last-error-message .
     2890       end.
     2891     end.
     2892     IF  Sale-sums:set_dis-card-sale_obj( input  ImpData1:route-data_get-record( input "sale-card-line") ) = false  THEN do:
     2893       _1955:
     2894       do:
     2895        undo _main, return error v-last-error-message .
     2896       end.
     2897     end.
     2898      Sale-sums:sale-type = v-current-doc-type .
     2899      Sale-sums:sale-doc = v-current-doc-code .
     2900     IF  Sale-sums:dis-card-sale_objsave( ) = false  THEN do:
     2901       _1956:
     2902       do:
     2903        undo _main, return error v-last-error-message .
     2904       end.
     2905     end.
     2906     end.
     2907   end.
     2908   end.
     2909         end.
     2910       end.
     2911       v-retry-action = 0 .
     2912       _release:
     2913       do on error undo, retry:
     2914         if  retry then do:
     2915           v-retry-action = v-retry-action + 1.
     2916                   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("&1&2&3"                                     , error-status:get-message(1)                                     , chr(10)                                     , v-last-error-message )).
     2917           undo _main, return error ''.
     2918         end.
     2919   if v-retry-action < 1 then do:
     2920   ImpData1:Route-data_dump ( ) .
     2921   end.
     2922   if v-retry-action < 2 then do:
     2923   Card1:Dis-card_release_ ( ) .
     2924   end.
     2925   if v-retry-action < 3 then do:
     2926   Sale-sums:Dis-card-sale_objrelease_ ( ) .
     2927   end.
     2928         end.
     2929         if v-retry-action = 0 then do:
     2930           num-rec-ok = num-rec-ok + 1.
     2931         end.
     2932         run write-counter in p-log-handle ( input substitute("Прочитано записей: &1, из них удачно: &2", num-rec, num-rec-ok)).
     2933         process events.
     2934         run get-stop-state in p-log-handle ( output v-stop) no-error .
     2935         if v-stop then do:
     2936                     run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Процесс импорта прерван пользователем")).
     2937            undo _main, return error .
     2938         end.
     2939       end.
     2940       if not v-stop then do:
     2941         num-rec = num-rec - 1.
     2942       end.
     2943       v_qh:query-close().
     2944       if valid-handle(v_qh) then do:
     2945         delete object v_qh.
     2946       end.
     2947     end.
     2948     for each temp-d-card
     2949     where temp-d-card.emitent-host-code = v-emitent-host-code
     2950       and temp-d-card.type = v-type
     2951     on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2952     on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
     2953     on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
     2954     :
     2955       assign
     2956       temp-d-card.sale-type = (v-current-doc-type + chr(44) +  'import':U)
     2957       .
     2958       run create-temp-d-card in p-parent-handle ( input (buffer temp-d-card:handle)).
     2959     END.
     2960     run reset-context in p-parent-handle ( input v-current-obj-type
     2961                                           ,input v-current-obj-code
     2962                                           ,input v-current-doc-code
     2963                                           ,input v-current-doc-date
     2964                                           ,input (v-current-doc-type + chr(44) +  'import':U)
     2965     ).
     2966       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Прочитано записей: &1, из них удачно: &2", num-rec, num-rec-ok)).
     2967   end.
     2968   end procedure.
     2969   procedure load-ruleset-context :
     2970   define input parameter p-ruleset-id as integer no-undo .
     2971   define buffer buf_rule-call-param for ub.rule-call-param.
     2972   define variable v-itop as integer   no-undo .
     2973   define variable v-ichild as integer   no-undo .
     2974   define variable v-esys-id as integer no-undo .
     2975   define variable v-pck-num as integer no-undo .
     2976   define buffer buf_esys-pck-keys for ub.esys-pck-keys.
     2977     do
     2978     on error undo, return error
     2979     :
     2980    find first buf_rule-call-param no-lock where
     2981   buf_rule-call-param.codex_id = p-codex-id
     2982   and buf_rule-call-param.ruleset_id = p-ruleset-id
     2983   and buf_rule-call-param.call_id = p-call-id
     2984   and buf_rule-call-param.order_id = p-order-id
     2985   and buf_rule-call-param.rule_id = p-rule-id
     2986   and buf_rule-call-param.param-name = "p-esys-id"
     2987    no-error.
     2988   if available buf_rule-call-param then do:
     2989   assign p-esys-id = buf_rule-call-param.param-value-integer.
     2990   end.
     2991    find first buf_rule-call-param no-lock where
     2992   buf_rule-call-param.codex_id = p-codex-id
     2993   and buf_rule-call-param.ruleset_id = p-ruleset-id
     2994   and buf_rule-call-param.call_id = p-call-id
     2995   and buf_rule-call-param.order_id = p-order-id
     2996   and buf_rule-call-param.rule_id = p-rule-id
     2997   and buf_rule-call-param.param-name = "p-xsd-file"
     2998    no-error.
     2999   if available buf_rule-call-param then do:
     3000   assign p-xsd-file = buf_rule-call-param.param-value-character.
     3001   end.
     3002       case p-ruleset-id:
     3003         when 3 then do:
     3004           for each buf_cash-pay no-lock where
     3005                  buf_cash-pay.curr-code = 0
     3006           by buf_cash-pay.cdpay-code:
     3007              if buf_cash-pay.is-cash then do:
     3008                leave.
     3009              end.
     3010           end.
     3011           if not available buf_cash-pay then do:
     3012                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не найдено ни одного типа кассового платежа с валютой &1 и свойством <НАЛИЧНЫЕ>,&2" +                                  "к которому можно привязать импортируемые суммы покупок по ДК"                                  , 0                                  , chr(10)                                  )).
     3013             assign
     3014             v-view-log = yes.
     3015             .
     3016             return error.
     3017           end.
     3018           assign
     3019           v-sign = 1
     3020           v-current-host-code = p-host-code
     3021           v-current-obj-type = p-obj-type
     3022           v-current-obj-code = p-obj-code
     3023           v-current-doc-code = p-doc-code
     3024           v-current-db-num = g#db-num
     3025           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     3026           v-current-date = p-doc-date
     3027           file-name  = entry(1, p-process-file-name, chr(4))
     3028           v_dataseth = handle(entry(2, p-process-file-name, chr(4)))
     3029           v-xmlh = buffer buf_temp-xml-tables:handle
     3030           v-esys-id = integer(p-doc-code)
     3031           v-pck-num = integer(entry(3, p-process-file-name, chr(4)))
     3032           log-file-name = entry(4, p-process-file-name, chr(4))
     3033           .
     3034               find first buf_esys-pck-keys no-lock where
     3035                         buf_esys-pck-keys.esys-id = v-esys-id
     3036                     and buf_esys-pck-keys.db-num = 0
     3037                     and buf_esys-pck-keys.espr-cr-db-num = g#db-num
     3038                     and buf_esys-pck-keys.espr-pack-num = v-pck-num
     3039                     and buf_esys-pck-keys.espr-uniq-key = substitute("&2&1&3&1&4&1&5"
     3040                                                                        , chr(4)
     3041                                                                        , p-call-id
     3042                                                                        , p-codex-id
     3043                                                                        , p-ruleset-id
     3044                                                                        , p-order-id)
     3045                     no-error.
     3046               if available buf_esys-pck-keys then do:
     3047                       .
     3048                 run set-stop-leave-status in p-parent-handle ( input "LEAVE").
     3049                 return "return".
     3050               end.
     3051           _top-buffers:
     3052           do v-itop = 1 to v_dataseth:num-top-buffers:
     3053             if v_dataseth:get-top-buffer(v-itop):table = "THheader"
     3054             or v_dataseth:get-top-buffer(v-itop):table = "header_"
     3055             then do:
     3056               next _top-buffers.
     3057             end.
     3058             assign
     3059             v-ds-read-order = v-ds-read-order +
     3060                               (if v-ds-read-order = '':U then '':U else chr(44)) +
     3061                               v_dataseth:get-top-buffer(v-itop):table
     3062                               .
     3063             do v-ichild = 1 to v_dataseth:get-top-buffer(v-itop):num-child-relations:
     3064               assign
     3065               v-ds-read-order = v-ds-read-order + chr(44) + v_dataseth:get-top-buffer(v-itop):get-child-relation(v-ichild):child-buffer:name.
     3066             end.
     3067           end.
     3068         end.
     3069         otherwise do:
     3070           undo, return error "Неправильный вызов".
     3071         end.
     3072       end case.
     3073     end.
     3074   end procedure.
     3075   procedure 00040000_set-vpay-chk  :
     3076   define input parameter p-bh as handle no-undo .
     3077   define buffer buf_vchk-pay for vchk-pay.
     3078   find first buf_vchk-pay no-lock where
     3079             buf_vchk-pay.d-card = p-bh:buffer-field("d-card"):buffer-value
     3080         and buf_vchk-pay.pay-code = buf_cash-pay.cdpay-code
     3081         and buf_vchk-pay.curr-code = 0
     3082         and buf_vchk-pay.doc-date = v-current-date
     3083         and buf_vchk-pay.cre-pay = no
     3084         and buf_vchk-pay.exch-rate = p-bh:buffer-field("pay-tot-rubl"):buffer-value / p-bh:buffer-field("pay-tot-base"):buffer-value
     3085         and buf_vchk-pay.base-rate = p-bh:buffer-field("pay-tot-rubl"):buffer-value / p-bh:buffer-field("pay-tot-base"):buffer-value
     3086         no-error .
     3087    if not available buf_vchk-pay then do:
     3088      create buf_vchk-pay.
     3089      assign
     3090      buf_vchk-pay.d-card = p-bh:buffer-field("d-card"):buffer-value
     3091      buf_vchk-pay.pay-code = (if v-current-doc-type = 'inkas':U
     3092                               then buf_cash-pay.cdpay-code
     3093                               else buf_cash-pay.pay-code
     3094                               )
     3095      buf_vchk-pay.curr-code = 0
     3096      buf_vchk-pay.doc-date = v-current-date
     3097      buf_vchk-pay.cre-pay = no
     3098      buf_vchk-pay.exch-rate = p-bh:buffer-field("pay-tot-rubl"):buffer-value / p-bh:buffer-field("pay-tot-base"):buffer-value
     3099      buf_vchk-pay.base-rate = p-bh:buffer-field("pay-tot-rubl"):buffer-value / p-bh:buffer-field("pay-tot-base"):buffer-value
     3100      buf_vchk-pay.obj-type = p-bh:buffer-field("obj-type"):buffer-value
     3101      buf_vchk-pay.obj-code = p-bh:buffer-field("obj-code"):buffer-value
     3102      .
     3103    end.
     3104    assign
     3105    buf_vchk-pay.tot-sum = buf_vchk-pay.tot-sum + p-bh:buffer-field("pay-tot-rubl"):buffer-value
     3106    buf_vchk-pay.tot-base = buf_vchk-pay.tot-base + p-bh:buffer-field("pay-tot-base"):buffer-value
     3107    buf_vchk-pay.tot-rubl = buf_vchk-pay.tot-rubl + p-bh:buffer-field("pay-tot-rubl"):buffer-value
     3108    .
     3109   end procedure.
     3110   procedure create_clients_:
     3111   define input parameter p-obj-type as character no-undo .
     3112   define input parameter p-obj-code as integer no-undo .
     3113   define buffer buf_temp-clients_ for temp-clients_.
     3114   find first buf_temp-clients_ where
     3115             buf_temp-clients_.obj-type = p-obj-type
     3116        and  buf_temp-clients_.obj-code = p-obj-code no-error .
     3117   if not available buf_temp-clients_ then do:
     3118     create buf_temp-clients_.
     3119     assign
     3120     buf_temp-clients_.obj-type = p-obj-type
     3121     buf_temp-clients_.obj-code = p-obj-code
     3122     .
     3123   end.
     3124   end procedure.
     3125   procedure create_dis-card_:
     3126   define input parameter p-d-card as character no-undo .
     3127   define buffer buf_temp-dis-card_ for temp-dis-card_.
     3128   find first buf_temp-dis-card_ where
     3129             buf_temp-dis-card_.d-card = p-d-card no-error .
     3130   if not available buf_temp-dis-card_ then do:
     3131     create buf_temp-dis-card_.
     3132     assign
     3133     buf_temp-dis-card_.d-card = p-d-card
     3134     .
     3135   end.
     3136   end procedure.
     3137   procedure can-find_clients_  :
     3138   define input parameter p-obj-type as character no-undo .
     3139   define input parameter p-obj-code as integer no-undo .
     3140   define output parameter p-find as logical no-undo .
     3141   find first temp-clients_ where
     3142                        temp-clients_.obj-type = p-obj-type
     3143                    and temp-clients_.obj-code = p-obj-code no-error.
     3144   p-find = available temp-clients_.
     3145   end procedure.
     3146   procedure can-find_dis-card_  :
     3147   define input parameter p-d-card as character no-undo .
     3148   define output parameter p-find as logical no-undo .
     3149   find first temp-dis-card_ where
     3150                        temp-dis-card_.d-card = p-d-card no-error.
     3151   p-find = available temp-dis-card_.
     3152   end procedure.
     3153   procedure delete-procedure :
     3154     do
     3155     on error undo, return error
     3156     :
     3157         for each temp-clients_:
     3158           delete temp-clients_.
     3159         end.
     3160         for each temp-dis-card_:
     3161           delete temp-dis-card_.
     3162         end.
     3163         run garbcoll_clear in this-procedure .
     3164     end.
     3165   end procedure.
