     1882   procedure library-cls_get-handle :
     1883   define input parameter p-library-name as character no-undo .
     1884   define output parameter p-library-handle as handle no-undo .
     1885     do
     1886     on error undo, return error
     1887     :
     1888       CASE p-library-name:
     1889         when "library" then do:
     1890           if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end.
     1891           p-library-handle = g#library.
     1892         end.
     1893         when "library2" then do:
     1894           if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end.
     1895           p-library-handle = g#library2.
     1896         end.
     1897       end case.
     1898     end.
     1899   end procedure.
     1900   def var vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1901   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1902   define variable tempcxml_v-num_ as integer no-undo .
     1903   define shared temp-table temp-xml-tables no-undo
     1904   field order as integer
     1905   field tbl-name as character
     1906   field tbl-handle_ as handle
     1907   field table-handle_ as handle
