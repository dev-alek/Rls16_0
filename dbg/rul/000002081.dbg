     2619   find first buf_dis-time-rule no-lock where
     2620             buf_dis-time-rule.time-rule-num = p-time-rule-num no-error.
     2621   if available buf_dis-time-rule
     2622   and buf_dis-time-rule.sts = integer ('0':U) then do:
     2623     if buf_dis-time-rule.month-day = day(p-date) then do:
     2624       return yes.
     2625     end.
     2626     return no.
     2627   end.
     2628   else do:
     2629     return no.
     2630   end.
     2631   end function.
     2632   FUNCTION DIS-TIME-RULE_00007 returns logical ( input p-time-rule-num as integer, input p-date as date, input p-time as integer):
     2633   define buffer buf_dis-time-rule for ub.dis-time-rule.
     2634   find first buf_dis-time-rule no-lock where
     2635             buf_dis-time-rule.time-rule-num = p-time-rule-num no-error.
     2636   if available buf_dis-time-rule
     2637   and buf_dis-time-rule.sts = integer ('0':U) then do:
     2638     if buf_dis-time-rule.date-from <= p-date
     2639     and buf_dis-time-rule.date-to >= p-date
     2640     and buf_dis-time-rule.time-from <= p-time
     2641     and buf_dis-time-rule.time-to >= p-time then do:
     2642       return yes.
     2643     end.
     2644   end.
     2645   return no.
     2646   end function.
     2647   FUNCTION DIS-TIME-RULE_00008 returns logical ( input p-time-rule-num as integer, input p-date as date, input p-time as integer):
     2648   define buffer buf_dis-time-rule for ub.dis-time-rule.
     2649   find first buf_dis-time-rule no-lock where
     2650             buf_dis-time-rule.time-rule-num = p-time-rule-num no-error.
     2651   if available buf_dis-time-rule
     2652   and buf_dis-time-rule.sts = integer ('0':U) then do:
     2653     if buf_dis-time-rule.date-from <= p-date
     2654     and buf_dis-time-rule.date-to >= p-date
     2655     and (buffer buf_dis-time-rule:buffer-field("week-day-" + string(loc-weekday(p-date) )):buffer-value = yes
     2656          or buf_dis-time-rule.week-day-0 = yes)
     2657     and buf_dis-time-rule.time-from <= p-time
     2658     and buf_dis-time-rule.time-to >= p-time
     2659     then do:
     2660       return yes.
     2661     end.
     2662   end.
     2663   return no.
     2664   end function.
     2665   FUNCTION DIS-TIME-RULE_00009 returns logical ( input p-time-rule-num as integer, input p-date as date, input p-time as integer):
     2666   define buffer buf_dis-time-rule for ub.dis-time-rule.
     2667   define buffer buf_term-dis-time-rule for ub.dis-time-rule.
     2668   find first buf_dis-time-rule no-lock where
     2669             buf_dis-time-rule.time-rule-num = p-time-rule-num no-error.
     2670   if available buf_dis-time-rule
     2671   and buf_dis-time-rule.sts = integer ('0':U) then do:
     2672     for each buf_term-dis-time-rule no-lock where
     2673             buf_term-dis-time-rule.upper-time-rule-num = buf_dis-time-rule.time-rule-num:
     2674       if buf_term-dis-time-rule.time-from <= p-time
     2675       and buf_term-dis-time-rule.time-to >= p-time
     2676       and buffer buf_term-dis-time-rule:buffer-field("week-day-" + string(loc-weekday(p-date) )):buffer-value = yes
     2677       then do:
     2678         return yes.
     2679       end.
     2680     end.
     2681   end.
     2682   return no.
     2683   end function.
     2684   FUNCTION DIS-TIME-RULE_00010 returns logical ( input p-time-rule-num as integer, input p-date as date, input p-time as integer):
     2685   define buffer buf_dis-time-rule for ub.dis-time-rule.
     2686   find first buf_dis-time-rule no-lock where
     2687             buf_dis-time-rule.time-rule-num = p-time-rule-num no-error.
     2688   if available buf_dis-time-rule
     2689   and buf_dis-time-rule.sts = integer ('0':U) then do:
     2690     if buffer buf_dis-time-rule:buffer-field("week-day-" + string(loc-weekday(p-date) )):buffer-value = yes
     2691     then do:
     2692       return yes.
     2693     end.
     2694   end.
     2695   return no.
     2696   end function.
     2697   FUNCTION DIS-TIME-RULE_00011 returns logical ( input p-time-rule-num as integer, input p-date as date, input p-time as integer):
     2698   define buffer buf_dis-time-rule for ub.dis-time-rule.
     2699   find first buf_dis-time-rule no-lock where
     2700             buf_dis-time-rule.time-rule-num = p-time-rule-num no-error.
     2701   if available buf_dis-time-rule
     2702   and buf_dis-time-rule.sts = integer ('0':U) then do:
     2703     if (buf_dis-time-rule.week-day-0 = yes
     2704     or (buffer buf_dis-time-rule:buffer-field("week-day-" + string(loc-weekday(p-date) )):buffer-value = yes))
     2705     and (buf_dis-time-rule.time-from <= p-time
     2706     and buf_dis-time-rule.time-to >= p-time)
     2707     then do:
     2708       return yes.
     2709     end.
     2710   end.
     2711   return no.
     2712   end function.
     2713   FUNCTION DIS-TIME-RULE_00012 returns logical ( input p-time-rule-num as integer, input p-date as date, input p-time as integer):
     2714   define buffer buf_dis-time-rule for ub.dis-time-rule.
     2715   find first buf_dis-time-rule no-lock where
     2716             buf_dis-time-rule.time-rule-num = p-time-rule-num no-error.
     2717   if available buf_dis-time-rule
     2718   and buf_dis-time-rule.sts = integer ('0':U) then do:
     2719     if buf_dis-time-rule.time-from <= p-time
     2720     then do:
     2721       return yes.
     2722     end.
     2723   end.
     2724   return no.
     2725   end function.
     2726   FUNCTION dis-rule_00020 returns decimal ( input p-rule-num as integer
     2727                                           , input p-date as date
     2728                                           , input p-time as integer
     2729                                           , input p-tot-sum as decimal
     2730                                           ):
     2731   define variable v-delta as decimal no-undo .
     2732   define variable v-start as logical no-undo init yes.
     2733   define variable v-discnt-value as decimal no-undo .
     2734   define buffer buf_dis-rule for ub.dis-rule.
     2735   define buffer buf_term-dis-rule for ub.dis-rule.
     2736   find first buf_dis-rule no-lock where
     2737           buf_dis-rule.rule-num = p-rule-num no-error.
     2738   if available buf_dis-rule
     2739   and buf_dis-rule.sts = integer('0':U)
     2740   and (buf_Dis-rule.time-templ-rl-root <= 50000 or dynamic-function( "dis-time-rule_" + string(buf_dis-rule.time-templ-rl-root - 50000, "99999")                                        , input buf_dis-rule.time-rule-num                                         , input p-date                                        , input p-time ))
     2741   then do:
     2742     for each buf_term-dis-rule no-lock where
     2743             buf_term-dis-rule.upper-rule-num = buf_dis-rule.rule-num:
     2744       if buf_term-dis-rule.tot-sum <= p-tot-sum then do:
     2745         if v-start
     2746         or v-delta  > (p-tot-sum - buf_term-dis-rule.tot-sum)
     2747         then do:
     2748           assign
     2749           v-discnt-value = buf_term-dis-rule.discnt-value
     2750           v-start = no
     2751           v-delta = p-tot-sum - buf_term-dis-rule.tot-sum
     2752           .
     2753         end.
     2754       end.
     2755     end.
     2756     return v-discnt-value.
     2757   end.
     2758   return 0.0.
     2759   end function.
     2760   FUNCTION dis-rule_00057 returns decimal ( input p-rule-num as integer
     2761                                           , input p-date as date
     2762                                           , input p-time as integer
     2763                                           , input p-tot-sum as decimal ) map to dis-rule_00020 in this-procedure .
     2764   on delete of this-procedure do:
     2765     run garbcoll_clear in this-procedure .
     2766   end.
     2767   run load-ruleset-context in this-procedure ( input p-ruleset-id).
     2768   if return-value = "return" then return ''.
     2769    define variable Card1 as class Dis-card_ no-undo .
     2770   Card1 = new Dis-card_( input parparentproc, input p-parent-handle, input p-log-handle, input this-procedure:handle, input p-cont-handle, input v-current-lock, input v-current-wait, input v-save) .
     2771    define variable Tot-sum-host1 as class Dis-tot_host no-undo .
     2772   Tot-sum-host1 = new Dis-tot_host( input parparentproc, input p-parent-handle, input p-log-handle, input this-procedure:handle, input p-cont-handle, input v-current-lock, input v-current-wait, input v-save) .
     2773    define variable Discount-host1 as class Discount_host no-undo .
     2774   Discount-host1 = new Discount_host( input parparentproc, input p-parent-handle, input p-log-handle, input this-procedure:handle, input p-cont-handle, input v-current-lock, input v-current-wait, input v-save, input 26) .
     2775    define variable v-netto-sum1 as  decimal no-undo .
     2776   if not this-procedure:persistent then do:
     2777     run proc-main in this-procedure ( input p-type
     2778                                 ,input p-emitent-host-code ) no-error .
     2779     if error-status:error then do:
     2780         run garbcoll_clear in this-procedure .
     2781         undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     2782     end.
     2783     run garbcoll_clear in this-procedure .
     2784     empty temp-table temp-dis-rule.
     2785   end.
     2786   procedure proc-main :
     2787   define input parameter p-type like ub.dis-card.type no-undo .
     2788   define input parameter p-emitent-host-code like ub.dis-card.emitent-host-code no-undo .
     2789   _main:
     2790   do
     2791   on error undo, return error return-value
     2792   :
     2793   assign
     2794   v-emitent-host-code = p-emitent-host-code
     2795   v-type = p-type.
     2796     _d-card:
     2797     for each temp-d-card where
     2798             temp-d-card.type = p-type
     2799         and temp-d-card.emitent-host-code = p-emitent-host-code
     2800     break
     2801     by temp-d-card.d-card
     2802     On error undo _d-card, retry _d-card:
     2803       if temp-d-card.d-card = '_' then next.
     2804       num-rec = num-rec + 1.
     2805       if retry then do:
     2806         if p-ruleset-id = 5 then do:
     2807           num-rec-calc-err = num-rec-calc-err + 1.
     2808           undo _d-card, next _d-card .
     2809         end.
     2810         else do:
     2811           undo _main, return error return-value .
     2812         end.
     2813       end.
     2814       assign
     2815       v-current-d-card = temp-d-card.d-card
     2816       v-netto-sum1 = 0
     2817       .
     2818      IF  Card1:find_dis-card_( INPUT v-current-d-card) = true  THEN do:
     2819       IF  Tot-sum-host1:find_Dis-tot_host( INPUT v-current-d-card, INPUT v-current-host-code) = true  THEN do:
     2820         IF  p-r-b = "rubl" AND p-is-over = false  THEN do:
     2821            v-netto-sum1 = Tot-sum-host1:pay-tot-rubl .
     2822         end.
     2823         IF  p-r-b = "rubl" AND p-is-over = true  THEN do:
     2824            v-netto-sum1 = Tot-sum-host1:pay-tot-rubl_byf# .
     2825         end.
     2826         IF  p-r-b = "base" AND p-is-over = false  THEN do:
     2827            v-netto-sum1 = Tot-sum-host1:pay-tot-base .
     2828         end.
     2829         IF  p-r-b = "base" AND p-is-over = true  THEN do:
     2830            v-netto-sum1 = Tot-sum-host1:pay-tot-base_byf# .
     2831         end.
     2832       end.
     2833      end.
     2834     IF  Discount-host1:find_Discount_host( INPUT v-current-d-card, INPUT v-current-host-code) = false  THEN do:
     2835       IF  Discount-host1:create_Discount_host( INPUT v-current-d-card, INPUT v-current-host-code) = false  THEN do:
     2836         undo _main, return error v-last-error-message .
     2837       end.
     2838     end.
     2839    Discount-host1:d-pcnt = dis-rule_00057( INPUT p-rule-num-host, INPUT v-current-doc-date, INPUT v-current-doc-time, INPUT v-netto-sum1) .
     2840    IF  Discount-host1:Discount_hostsave( ) = false  THEN do:
     2841      undo _main, return error v-last-error-message .
     2842   end.
     2843   Card1:Dis-card_release_ ( ) .
     2844   Tot-sum-host1:Dis-tot_hostrelease_ ( ) .
     2845   Discount-host1:Discount_hostrelease_ ( ) .
     2846         num-rec-ok = num-rec-ok + 1.
     2847         if p-ruleset-id = 5 then do:
     2848           run set-num-rec in p-parent-handle ( input num-rec
     2849                                               ,input num-rec-calc-err
     2850                                               ,input num-rec-value-err
     2851                                               ,input num-rec-ok
     2852                                               ,input no
     2853                                               ) no-error .
     2854         end.
     2855       end.
     2856       if p-ruleset-id = 5 then do:
     2857         run set-num-rec in p-parent-handle ( input num-rec
     2858                                             ,input num-rec-calc-err
     2859                                             ,input num-rec-value-err
     2860                                             ,input num-rec-ok
     2861                                             ,input yes
     2862                                             ) no-error .
     2863       end.
     2864     end.
     2865   end procedure.
     2866   procedure load-ruleset-context :
     2867   define input parameter p-ruleset-id as integer no-undo .
     2868   define buffer buf_rule-call-param for ub.rule-call-param.
     2869   define buffer buf_dis-rule for ub.dis-rule.
     2870     do
     2871     on error undo, return error
     2872     :
     2873    find first buf_rule-call-param no-lock where
     2874   buf_rule-call-param.codex_id = p-codex-id
     2875   and buf_rule-call-param.ruleset_id = p-ruleset-id
     2876   and buf_rule-call-param.call_id = p-call-id
     2877   and buf_rule-call-param.order_id = p-order-id
     2878   and buf_rule-call-param.rule_id = p-rule-id
     2879   and buf_rule-call-param.param-name = "p-r-b"
     2880    no-error.
     2881   if available buf_rule-call-param then do:
     2882   assign p-r-b = buf_rule-call-param.param-value-character.
     2883   end.
     2884    find first buf_rule-call-param no-lock where
     2885   buf_rule-call-param.codex_id = p-codex-id
     2886   and buf_rule-call-param.ruleset_id = p-ruleset-id
     2887   and buf_rule-call-param.call_id = p-call-id
     2888   and buf_rule-call-param.order_id = p-order-id
     2889   and buf_rule-call-param.rule_id = p-rule-id
     2890   and buf_rule-call-param.param-name = "p-is-over"
     2891    no-error.
     2892   if available buf_rule-call-param then do:
     2893   assign p-is-over = buf_rule-call-param.param-value-logical.
     2894   end.
     2895    for each buf_rule-call-param no-lock where
     2896   buf_rule-call-param.codex_id = p-codex-id
     2897   and buf_rule-call-param.ruleset_id = p-ruleset-id
     2898   and buf_rule-call-param.call_id = p-call-id
     2899   and buf_rule-call-param.order_id = p-order-id
     2900   and buf_rule-call-param.rule_id = p-rule-id
     2901   and buf_rule-call-param.param-name = "p-rule-num-host"
     2902   and buf_rule-call-param.p-index > 0,
     2903     first Buf_dis-rule no-lock where
     2904           buf_dis-rule.rule-num = buf_rule-call-param.param-value-integer:
     2905     find first temp-dis-rule no-lock where
     2906               temp-dis-rule.rule-num = buf_dis-rule.rule-num no-error.
     2907     if not available temp-dis-rule then do:
     2908       create temp-dis-rule.
     2909       buffer-copy buf_dis-rule to temp-dis-rule.
     2910       release temp-dis-rule.
     2911     end.
     2912   end.
     2913       assign
     2914       vh_dis-card-sale_obj = buffer temp-d-card:handle
     2915       .
     2916       case p-ruleset-id:
     2917         when 1 then do:
     2918           assign
     2919           v-sign = 1
     2920           v-current-host-code = p-host-code
     2921           v-current-obj-type = p-obj-type
     2922           v-current-obj-code = p-obj-code
     2923           v-current-db-num = g#db-num
     2924           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     2925           v-current-doc-code = p-doc-code
     2926           v-current-doc-date = p-doc-date
     2927           v-current-doc-fact-date = p-fact-date
     2928           v-current-date = p-doc-date
     2929           v-current-fact-date = p-fact-date
     2930           .
     2931         end.
     2932         when 2 then do:
     2933           assign
     2934           v-sign = -1
     2935           v-current-host-code = p-host-code
     2936           v-current-obj-type = p-obj-type
     2937           v-current-obj-code = p-obj-code
     2938           v-current-db-num = g#db-num
     2939           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     2940           v-current-doc-code = p-doc-code
     2941           v-current-doc-date = p-doc-date
     2942           v-current-doc-fact-date = p-fact-date
     2943           v-current-date = p-doc-date
     2944           v-current-fact-date = p-fact-date
     2945           .
     2946         end.
     2947         when 3
     2948         or when 6
     2949         then do:
     2950           assign
     2951           v-sign = 1
     2952           v-current-host-code = p-host-code
     2953           v-current-obj-type = p-obj-type
     2954           v-current-obj-code = p-obj-code
     2955           v-current-db-num = g#db-num
     2956           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     2957           v-current-doc-code = p-doc-code
     2958           v-current-doc-date = p-doc-date
     2959           v-current-doc-time = 0
     2960           v-current-doc-fact-date = p-fact-date
     2961           v-current-date = p-doc-date
     2962           v-current-fact-date = p-fact-date
     2963           .
     2964         end.
     2965         when 4 then do:
     2966           assign
     2967           v-sign = -1
     2968           v-current-host-code = p-host-code
     2969           v-current-obj-type = p-obj-type
     2970           v-current-obj-code = p-obj-code
     2971           v-current-db-num = g#db-num
     2972           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     2973           v-current-doc-code = p-doc-code
     2974           v-current-doc-date = p-doc-date
     2975           v-current-doc-time = 0
     2976           v-current-doc-fact-date = p-fact-date
     2977           v-current-date = p-doc-date
     2978           v-current-fact-date = p-fact-date
     2979           .
     2980         end.
     2981         otherwise do:
     2982           undo, return error substitute("Неверный вызов &1 для набора правил &2", vss-workfile , p-ruleset-id).
     2983         end.
     2984       end case.
     2985       find first temp-dis-rule no-lock where
     2986                   temp-dis-rule.host-code = v-current-host-code
     2987               and temp-dis-rule.obj-type = ''
     2988               and temp-dis-rule.obj-code = 0 no-error.
     2989       if not available temp-dis-rule then do:
     2990         empty temp-table temp-dis-rule.
     2991         return "return".
     2992       end.
     2993       p-rule-num-host = temp-dis-rule.rule-num.
     2994     end.
     2995   end procedure.
     2996   procedure delete-procedure :
     2997     do
     2998     on error undo, return error
     2999     :
     3000         run garbcoll_clear in this-procedure .
     3001     end.
     3002   end procedure.
