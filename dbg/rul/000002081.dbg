     1748   define temp-table temp-rule-call-param no-undo like ub.rule-call-param.
     1749   define buffer buf_temp-rule-call-param for temp-rule-call-param.
     1750   define buffer buf_temp-cmd for temp-cmd.
     1751   define buffer buf_dis-card-sale_obj for temp-d-card.
     1752   define variable vh_dis-card-sale_obj as handle no-undo .
     1753   define temp-table temp-dis-rule no-undo like ub.dis-rule.
     1754    define variable p-r-b as character no-undo.
     1755    define variable p-is-over as logical no-undo.
     1756    define variable p-rule-num-host as integer no-undo.
     1757   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1758   procedure discardh_write-dis-card-rul  :
     1759   define parameter buffer buf_dis-card for ub.dis-card .
     1760   define input parameter p-type as character no-undo .
     1761   define input parameter p-emitent-host-code as integer no-undo .
     1762   define input parameter p-action as integer no-undo .
     1763   define variable v-date as date      no-undo.
     1764   define variable v-time  as integer   no-undo.
     1765   define variable v-rec-ord1 as integer no-undo .
     1766   define variable v-rec-ord2 as integer no-undo .
     1767   define variable v-rec-ord3 as integer no-undo .
     1768   define variable v-rec-hno as integer no-undo .
     1769   define buffer buf_c-dc-hist for ub.c-dc-hist.
     1770   define buffer buf_c-dis-card for ub.c-dis-card.
     1771   define buffer buf_temp-hist-nws-option for temp-hist-nws-option.
     1772   define buffer last_temp-hist-nws-option for temp-hist-nws-option.
     1773   do
     1774   on error undo, return error
     1775   :
     1776     if not available buf_dis-card then do:
     1777       message
     1778         vss-workfile vss-revision vss-description skip
     1779         "Ошибка задания входных параметров" skip
     1780         "Не определена ДК" skip
     1781         view-as alert-box error .
     1782       undo, return error .
     1783     end.
     1784     find first buf_temp-hist-nws-option where
     1785               buf_temp-hist-nws-option.table-name = 'dis-card':U
     1786           and buf_temp-hist-nws-option.db-num = g#db-num
     1787           and buf_temp-hist-nws-option.key#_one = 2
     1788           and buf_temp-hist-nws-option.charkey_one = p-type
     1789           and buf_temp-hist-nws-option.host-code = p-emitent-host-code no-error .
     1790     if not available buf_temp-hist-nws-option then do:
     1791       find first last_temp-hist-nws-option where
     1792                last_temp-hist-nws-option.db-num = g#db-num
     1793             and last_temp-hist-nws-option.hn-id < 0 no-error.
     1794       create buf_temp-hist-nws-option.
     1795       assign
     1796       buf_temp-hist-nws-option.db-num = g#db-num
     1797       buf_temp-hist-nws-option.hn-id = (if available last_temp-hist-nws-option
     1798                                   then - (abs(last_temp-hist-nws-option.hn-id) + 1)
     1799                                   else -1 )
     1800       buf_temp-hist-nws-option.table-name = 'dis-card':U
     1801       buf_temp-hist-nws-option.key#_one = 2
     1802       buf_temp-hist-nws-option.charkey_one = p-type
     1803       buf_temp-hist-nws-option.host-code = p-emitent-host-code
     1804       buf_temp-hist-nws-option.smart-nws = integer('-1':U)
     1805       .
     1806   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1807   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option-record in g#lib-nws
     1808     (input  g#db-num
     1809     ,input  buffer buf_temp-hist-nws-option:handle
     1810     )  .
     1811     end.
     1812     if not g#news
     1813     and buf_temp-hist-nws-option.hist-from-prim < 0 then do:
     1814       return.
     1815     end.
     1816     if g#news
     1817     and buf_temp-hist-nws-option.nws-to-hist < 0 then do:
     1818       return.
     1819     end.
     1820     run cur-time in this-procedure(output v-date, output v-time).
     1821     create buf_c-dis-card.
     1822     buffer-copy buf_dis-card to buf_c-dis-card
     1823     assign
     1824     buf_c-dis-card.d-card             = buf_dis-card.d-card
     1825     buf_c-dis-card.card-num           = buf_dis-card.card-num
     1826     buf_c-dis-card.chip-num           = next-value (s-dc-chip, ub)
     1827     buf_c-dis-card.corr-time          = v-time
     1828     buf_c-dis-card.corr-user-db-num   = g#db-num
     1829     buf_c-dis-card.corr-user-name     = (if g#news
     1830                                           then (chr(4) +  'СПН':U)
     1831                                           else (if g#esys
     1832                                                 then (chr(4) +  'ВС':U)
     1833                                                 else g#userid
     1834                                               )
     1835                                           )
     1836     buf_c-dis-card.corr-date          = v-date
     1837     .
     1838     create buf_c-dc-hist.
     1839     buffer-copy buf_c-dis-card to buf_c-dc-hist
     1840     assign
     1841     buf_c-dc-hist.action =  p-action
     1842     buf_c-dc-hist.subject = 'dis-card':U
     1843     buf_c-dc-hist.host-code =  buf_dis-card.emitent-host-code
     1844     buf_c-dc-hist.is-news = g#news
     1845     buf_c-dc-hist.source-type = p-doc-type
     1846     buf_c-dc-hist.source-ref = (if p-doc-type = '':U
     1847                                  then '':U
     1848                                  else p-doc-code)
     1849     .
     1850     if g#db-num > 0
     1851     or (g#db-num = 0
     1852         and buf_temp-hist-nws-option.hist-to-nws >= 0)
     1853     then do:
     1854       run add-dump in p-cmd-proc-handle                                                                           (input p-cmd-code                                                                                         ,input 'c-dis-card':U                                                                                          ,input '+update'                                                                                         ,input buffer buf_c-dis-card:handle                                                                                    ,input ''                                                                                         ,output v-rec-ord2                                                                                         ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                     delete procedure p-cmd-proc-handle .                                                                        undo , return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'c-dis-card':U                                                                                                ,p-cmd-code                                                                                               ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
     1855       run add-dump in p-cmd-proc-handle                                                                           (input p-cmd-code                                                                                         ,input 'c-dc-hist':U                                                                                          ,input '+update'                                                                                         ,input buffer buf_c-dc-hist:handle                                                                                    ,input ''                                                                                         ,output v-rec-ord3                                                                                         ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                     delete procedure p-cmd-proc-handle .                                                                        undo , return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'c-dc-hist':U                                                                                                ,p-cmd-code                                                                                               ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
     1856       if g#db-num = 0 then do:
     1857         run create-smart-route-link in this-procedure ( input 'c-dis-card':U
     1858                                                       ,input buffer buf_c-dis-card:handle
     1859                                                       ,input buf_dis-card.d-card
     1860                                                       ,input v-rec-ord2
     1861                                                       ,input no
     1862                                                       ).
     1863         run create-smart-route-link in this-procedure ( input 'c-dc-hist':U
     1864                                                       ,input buffer buf_c-dc-hist:handle
     1865                                                       ,input buf_dis-card.d-card
     1866                                                       ,input v-rec-ord3
     1867                                                       ,input no
     1868                                                       ).
     1869         run create-smart-route in this-procedure  ( input buf_dis-card.d-card
     1870                                                   ,input -1).
     1871       end.
     1872     end.
