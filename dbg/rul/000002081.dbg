     1720   define variable v-current-db-num as integer no-undo .
     1721   define variable v-current-doc-code as character no-undo .
     1722   define variable v-current-doc-date as date no-undo .
     1723   define variable v-current-doc-time as integer no-undo .
     1724   define variable v-current-doc-fact-date as date no-undo .
     1725   define variable v-current-date as date no-undo .
     1726   define variable v-current-fact-date as date no-undo .
     1727   define variable v-current-doc-type as character no-undo .
     1728   define variable v-last-error-message as character no-undo .
     1729   define variable v-emitent-host-code as integer no-undo .
     1730   define variable v-type as character no-undo .
     1731   define variable v-esys-cmd-proc-handle as handle no-undo .
     1732   define variable v-esys-cmd-code as integer no-undo .
     1733   define variable v-sign as integer no-undo .
     1734   define variable num-rec as integer no-undo .
     1735   define variable num-rec-calc-err as integer no-undo .
     1736   define variable num-rec-value-err as integer no-undo .
