     2497   procedure get-db-list-for-d-card3 :
     2498   define input parameter p-d-card as character no-undo .
     2499   define variable v-current-db-processed as logical no-undo .
     2500   define buffer buf_clients  for ub.clients.
     2501   define buffer buf_dis-obj for ub.dis-obj.
     2502   define buffer buf_temp-smart-route for temp-smart-route.
     2503     do
     2504     on error undo, return error return-value
     2505     :
     2506       for each buf_dis-obj no-lock where
     2507               buf_dis-obj.d-card = p-d-card,
     2508          first buf_clients no-lock where
     2509               buf_clients.obj-type = buf_dis-obj.obj-type
     2510           and buf_clients.obj-code = buf_dis-obj.obj-code
     2511       break by
     2512       buf_clients.db-num:
     2513         if first-of(buf_Clients.db-num) then do:
     2514           find first buf_temp-smart-route no-lock where
     2515                 buf_temp-smart-route.key-field = p-d-card
     2516             and buf_temp-smart-route.db-num = buf_clients.db-num
     2517                 no-error.
     2518           if available buf_temp-smart-route then return.
     2519           create buf_temp-smart-route.
     2520           assign
     2521           buf_temp-smart-route.key-field = p-d-card
     2522           buf_temp-smart-route.db-num = buf_clients.db-num
     2523           .
     2524           if buf_clients.db-num = g#db-num then do:
     2525             v-current-db-processed = yes.
     2526           end.
     2527         end.
     2528       end.
     2529       if not v-current-db-processed then do:
     2530         find first buf_temp-smart-route no-lock where
     2531               buf_temp-smart-route.key-field = p-d-card
     2532           and buf_temp-smart-route.db-num = g#db-num
     2533               no-error.
     2534         if not available buf_temp-smart-route then do:
     2535           create buf_temp-smart-route.
     2536           assign
     2537           buf_temp-smart-route.key-field = p-d-card
     2538           buf_temp-smart-route.db-num = g#db-num
     2539           .
     2540         end.
     2541       end.
     2542     end.
     2543   end procedure.
