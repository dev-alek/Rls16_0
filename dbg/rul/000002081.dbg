     1163   procedure library-cls_get-handle :
     1164   define input parameter p-library-name as character no-undo .
     1165   define output parameter p-library-handle as handle no-undo .
     1166     do
     1167     on error undo, return error
     1168     :
     1169       CASE p-library-name:
     1170         when "library" then do:
     1171           if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end.
     1172           p-library-handle = g#library.
     1173         end.
     1174         when "library2" then do:
     1175           if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end.
     1176           p-library-handle = g#library2.
     1177         end.
     1178       end case.
     1179     end.
     1180   end procedure.
     1181   def var vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1182   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1183   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1184   define variable tempcxml_v-num_ as integer no-undo .
