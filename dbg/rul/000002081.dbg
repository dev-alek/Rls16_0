     2565   FUNCTION DIS-TIME-RULE_00002 returns logical ( input p-time-rule-num as integer, input p-date as date, input p-time as integer):
     2566   define buffer buf_dis-time-rule for ub.dis-time-rule.
     2567   find first buf_dis-time-rule no-lock where
     2568             buf_dis-time-rule.time-rule-num = p-time-rule-num no-error.
     2569   if available buf_dis-time-rule
     2570   and buf_dis-time-rule.sts = integer ('0':U) then do:
     2571     if buf_dis-time-rule.time-from <= p-time
     2572     and buf_dis-time-rule.time-to >= p-time then do:
     2573       return yes.
     2574     end.
     2575   end.
     2576   return no.
     2577   end function.
     2578   FUNCTION DIS-TIME-RULE_00003 returns logical ( input p-time-rule-num as integer, input p-date as date, input p-time as integer):
