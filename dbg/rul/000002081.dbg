     2212   procedure get-db-list-for-d-card2 :
     2213   define input parameter p-d-card as character no-undo .
     2214   define variable v-current-db-processed as logical no-undo .
     2215   define buffer buf_clients  for ub.clients.
     2216   define buffer buf_dis-obj for ub.dis-obj.
     2217   define buffer buf_temp-smart-route for temp-smart-route.
     2218     do
     2219     on error undo, return error return-value
     2220     :
     2221       for each buf_dis-obj no-lock where
     2222               buf_dis-obj.d-card = p-d-card,
     2223          first buf_clients no-lock where
     2224               buf_clients.obj-type = buf_dis-obj.obj-type
     2225           and buf_clients.obj-code = buf_dis-obj.obj-code
     2226       break by
     2227       buf_clients.db-num:
     2228         if first-of(buf_Clients.db-num) then do:
     2229           find first buf_temp-smart-route no-lock where
     2230                 buf_temp-smart-route.key-field = p-d-card
     2231             and buf_temp-smart-route.db-num = buf_clients.db-num
     2232                 no-error.
     2233           if available buf_temp-smart-route then return.
     2234           create buf_temp-smart-route.
     2235           assign
     2236           buf_temp-smart-route.key-field = p-d-card
     2237           buf_temp-smart-route.db-num = buf_clients.db-num
     2238           .
     2239           if buf_clients.db-num = g#db-num then do:
     2240             v-current-db-processed = yes.
     2241           end.
     2242         end.
     2243       end.
     2244       if not v-current-db-processed then do:
     2245         find first buf_temp-smart-route no-lock where
     2246               buf_temp-smart-route.key-field = p-d-card
     2247           and buf_temp-smart-route.db-num = g#db-num  no-error.
     2248         if not available buf_temp-smart-route then do:
