     2073   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2074   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
     2075   run gbl/getobjsrvhndl.p (input-output ObjSrv).
     2076   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2077   function context_get-thobj-es return logical
     2078   (
     2079      input p-esys-id as integer
     2080     ,input p-eobj-type as character
     2081     ,input p-eobj-code as integer
     2082     ,output p-obj-type as character
     2083     ,output p-obj-code as integer
     2084   ):
     2085      define variable v-value-list as character no-undo .
     2086      define variable v-field-list as character no-undo .
     2087      define buffer buf_clients for ub.clients.
     2088      define buffer buf_ext-classif for ub.ext-classif.
     2089      find first buf_ext-classif no-lock where
     2090                buf_ext-classif.classif-name = 'clients-esys':U
     2091            and buf_ext-classif.classif-subject = 'clients':U
     2092            and buf_ext-classif.db-num = 0
     2093            and buf_Ext-classif.key#_one = p-esys-id
     2094            and buf_Ext-classif.charkey_one = p-eobj-type
     2095            and buf_Ext-classif.key#_two = p-eobj-code no-error .
     2096      if available buf_Ext-classif
     2097      then do:
     2098         ObjSrv:Lib:KeyRec:GenKeyFv (
     2099                                         input buf_Ext-classif.uniq-key-rec
     2100                                         ,output v-field-list
     2101                                         ,output v-value-list).
     2102         assign
     2103            p-obj-type = entry(lookup("obj-type":U
     2104                                     , v-field-list
     2105                                     , chr(3))
     2106                                     , v-value-list, chr(3))
     2107            p-obj-code = integer(entry(lookup("obj-code":U
     2108                                            , v-field-list
     2109                                            , chr(3))
     2110                                      , v-value-list
     2111                                      , chr(3)))
     2112         no-error .
     2113      end.
     2114      if     available buf_ext-classif
     2115         and (p-obj-type = 'маг':U
     2116              or
     2117              p-obj-type = 'скл':U
     2118              )
     2119         and (p-obj-code > 0 and p-obj-code <= 99999)
     2120      then do:
     2121         find first buf_clients no-lock where
     2122                    buf_clients.obj-type = p-obj-type
     2123                and buf_clients.obj-code = p-obj-code no-error.
     2124         if available buf_clients then do:
     2125            return yes.
     2126         end.
     2127         else do:
     2128            assign
     2129               p-obj-type = '':U
     2130               p-obj-code = 0
     2131            .
     2132            return no.
     2133         end.
     2134      end.
     2135      else do:
     2136         assign
     2137            p-obj-type = '':U
     2138            p-obj-code = 0
     2139         .
     2140         return no.
     2141      end.
     2142   end.
     2143   on delete of this-procedure do:
     2144     run delete-procedure in this-procedure .
     2145   end.
     2146   run load-ruleset-context in this-procedure ( input p-ruleset-id) no-error .
     2147   if error-status:error
     2148   or return-value = "return" then return.
     2149    define variable ImpData1 as class Route-data_ no-undo .
     2150   ImpData1 = new Route-data_( input parparentproc, input p-parent-handle, input p-log-handle, input this-procedure:handle, input v_dataseth, input v-xmlh) .
     2151   if not this-procedure:persistent then do:
     2152     run proc-main in this-procedure  no-error .
     2153     if error-status:error then do:
     2154         run delete-procedure in this-procedure .
     2155         undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     2156     end.
     2157     run delete-procedure in this-procedure .
     2158   end.
     2159   procedure proc-main :
     2160   define variable v-ii as integer   no-undo .
     2161   define variable v-line-num      as   integer              no-undo .
     2162   define variable v-present       as   logical              no-undo .
     2163   define variable v-pay-type-code like ub.pay-type.obj-code no-undo .
     2164   define variable v-pay-type-name like ub.pay-type.obj-name no-undo .
     2165   define buffer buf_ext-system for ub.ext-system.
     2166   _main:
     2167   do
     2168   on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2169   on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
     2170   on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
     2171   :
     2172   run write-log  in p-log-handle (
     2173                                    input 0
     2174                                  , "&DLine").
     2175     run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute(".............Импорт данных по видам оплат из ВС")).                      assign v-view-log = yes.
     2176     run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Импорт данных по видам оплат из файла &1", file-name)).                      assign v-view-log = yes.
     2177       find first buf_ext-system no-lock where
     2178                 buf_ext-system.esys-id = p-esys-id
     2179             and buf_ext-system.db-num = 0 no-error.
     2180       if not available buf_ext-system
     2181       or not (buf_ext-system.esys-type  = integer('3':U)) then do:
     2182              run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не найдена ВС &1 или она не имеет типа ORACLE RETAIL", p-esys-id)).                      assign v-view-log = yes.
     2183          undo _main, return error ''.
     2184       end.
     2185     do v-ii = 1 to num-entries(v-ds-read-order):
     2186       find first buf_temp-xml-tables where
     2187                 buf_temp-xml-tables.tbl-name = entry(v-ii, v-ds-read-order)
     2188           and  buf_temp-xml-tables.gate-handle_ = v_dataseth.
     2189     create query v_qh.
     2190     glog = v_qh:set-buffers( buf_temp-xml-tables.tbl-handle_) no-error.
     2191     if error-status:error
     2192     or
     2193     not glog then do:
     2194                   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при попытке получить записи &1&2&3&2&4"                                                                 , buf_temp-xml-tables.tbl-name                                                                 , chr(10)                                                                 , error-status:get-message(1)                                                                 , return-value)).                      assign v-view-log = yes.
     2195      undo _main, return error ''.
     2196     end.
     2197     glog = v_qh:query-prepare( substitute( "for each &1 by &1.line-num", buf_temp-xml-tables.tbl-name)) no-error .
     2198     if error-status:error
     2199     or
     2200     not glog then do:
     2201                   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при попытке получить записи &1&2&3&2&4"                                                                 , buf_temp-xml-tables.tbl-name                                                                 , chr(10)                                                                 , error-status:get-message(1)                                                                 , return-value)).                      assign v-view-log = yes.
     2202           if valid-handle(v_qh) then do:
     2203             delete object v_qh no-error.
     2204           end.
     2205      undo _main, return error ''.
     2206     end.
     2207     glog = v_qh:query-open no-error .
     2208     if error-status:error
     2209     or
     2210     not glog then do:
     2211                   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при попытке получить записи &1&2&3&2&4"                                                                 , buf_temp-xml-tables.tbl-name                                                                 , chr(10)                                                                 , error-status:get-message(1)                                                                 , return-value)).                      assign v-view-log = yes.
     2212           if valid-handle(v_qh) then do:
     2213             delete object v_qh no-error.
     2214           end.
     2215       undo _main, return error ''.
     2216     end.
     2217     _stroka:
     2218     REPEAT:
     2219       if buf_temp-xml-tables.is-parent
     2220       then do:
     2221         num-rec = num-rec + 1.
     2222       end.
     2223       v-retry-action = 0 .
     2224       _release:
     2225       do on error undo, retry:
     2226         if  retry then do:
     2227           v-retry-action = v-retry-action + 1.
     2228                           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при импорте записи &5 &1&2&3&2&4"                                                                     , buf_temp-xml-tables.tbl-name                                                                     , num-rec                                                                     , chr(10)                                                                     , error-status:get-message(1)                                                                     , return-value)).                      assign v-view-log = yes.
     2229               if valid-handle(v_qh) then do:
     2230                 delete object v_qh no-error.
     2231               end.
     2232           undo _main, return error ''.
     2233         end.
     2234         if v-retry-action < 1 then do:
     2235               ImpData1:Route-data_dump ( ) .
     2236         end.
     2237         end.
     2238       _rule:
     2239         do on error undo _rule, retry _rule:
     2240           if retry then do:
     2241                         run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("&1&2&3", error-status:get-message(1), chr(10), return-value)).                      assign v-view-log = yes.
     2242             if valid-handle(v_qh) then do:
     2243               delete object v_qh no-error.
     2244             end.
     2245             undo _main, return error ''.
     2246           end.
     2247           else do:
     2248           v_qh:get-next().
     2249           IF v_qh:query-off-end then leave _stroka.
     2250             IF  ImpData1:current-tbl-name( ) = 'pay-type':U  THEN do:
     2251               trans_save:
     2252               do transaction
     2253               on error  undo trans_save, retry trans_save
     2254               on stop   undo trans_save, retry trans_save
     2255               on endkey undo trans_save, retry trans_save
     2256               :
     2257                 if retry then do:
     2258                   if return-value <> '' then do:
     2259                                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка разбора/приема данных по ставке налога из ВС:&1&2&1&3", chr(10), return-value, error-status :get-message( 1 ) )).                      assign v-view-log = yes.
     2260                   end.
     2261                   run set-err-type in p-cont-handle
     2262                     ( input v-err-type
     2263                     ) no-error.
     2264                   run delete-procedure in this-procedure .
     2265                   undo _main, return error ''.
     2266                 end.
     2267                 assign
     2268                   v-line-num      = ImpData1:route-data_get-field-integer  ( input 'pay-type':U, input "line-num":U )
     2269                   v-pay-type-code = ImpData1:route-data_get-field-integer  ( input 'pay-type':U, input "obj-code":U)
     2270                   v-pay-type-name = ImpData1:route-data_get-field-character( input 'pay-type':U, input "obj-name":U)
     2271                 .
     2272                 run get-xcnf_check-imp-rec in p-cont-handle
     2273                   ( input "create"
     2274                   , input p-esys-id
     2275                   , input 0
     2276                   , input g#db-num
     2277                   , input v-pck-num
     2278                   , input substitute( "&1,&2", v-line-num, v-pay-type-code )
     2279                   , output v-present
     2280                   ) no-error.
     2281                 if error-status:error then do:
     2282                   if return-value <> '' then do:
     2283                                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка идентификации принимаемых данных по ставке налога из ВС:&1&2", chr(10), return-value )).                      assign v-view-log = yes.
     2284                   end.
     2285                   run set-err-type in p-cont-handle
     2286                     ( input v-err-type
     2287                     ) no-error.
     2288                   undo _main, return error ''.
     2289                 end.
     2290                 if v-present = true then do:
     2291                   leave trans_save .
     2292                 end.
     2293                 run proc-save-pay-type in this-procedure
     2294                   ( input v-pay-type-code
     2295                   , input v-pay-type-name
     2296                   ) no-error .
     2297                 if error-status:error then do:
     2298                   if return-value <> '' then do:
     2299                                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при сохранении данных по ставке налога при приеме данных из ВС:&1&2", chr(10), return-value )).                      assign v-view-log = yes.
     2300                   end.
     2301                   run set-err-type in p-cont-handle
     2302                     ( input v-err-type
     2303                     ) no-error.
     2304                   run delete-procedure in this-procedure .
     2305                   undo _main, return error ''.
     2306                 end.
     2307                 else do:
     2308                   assign
     2309                     num-rec-ok2 = num-rec-ok2 + 1
     2310                   .
     2311                 end.
     2312               end.
     2313             end.
     2314         end.
     2315       end.
     2316       v-retry-action = 0 .
     2317       _release:
     2318       do on error undo, retry:
     2319         if  retry then do:
     2320           v-retry-action = v-retry-action + 1.
     2321                     run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("&1&2&3", error-status:get-message(1), chr(10), v-last-error-message )).                      assign v-view-log = yes.
     2322           undo _main, return error ''.
     2323         end.
     2324         if v-retry-action < 1 then do:
     2325               ImpData1:Route-data_dump ( ) .
     2326         end.
     2327         end.
     2328             if v-retry-action = 0
     2329             and buf_temp-xml-tables.is-parent
     2330             then do:
     2331           num-rec-ok = num-rec-ok + 1.
     2332         end.
     2333         run write-counter in p-log-handle ( input substitute("Прочитано записей: &1, из них удачно: &2", num-rec, num-rec-ok)).
     2334       end.
     2335           if not v-stop
     2336           and buf_temp-xml-tables.is-parent
     2337           then do:
     2338         num-rec = num-rec - 1.
     2339       end.
     2340       v_qh:query-close().
     2341       if valid-handle(v_qh) then do:
     2342         delete object v_qh.
     2343       end.
     2344     end.
     2345         run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Прочитано записей: &1, из них удачно обработано: &2", num-rec, num-rec-ok2)).                      assign v-view-log = yes.
     2346   end.
     2347   end procedure.
     2348   procedure load-ruleset-context :
     2349   define input parameter p-ruleset-id as integer no-undo .
     2350   define buffer buf_rule-call-param for ub.rule-call-param.
     2351   define variable v-itop as integer   no-undo .
     2352   define variable v-ichild as integer   no-undo .
     2353   define buffer buf_ext-system for ub.ext-system.
     2354     do
     2355     on error undo, return error
     2356     :
     2357    find first buf_rule-call-param no-lock where
     2358   buf_rule-call-param.codex_id = p-codex-id
     2359   and buf_rule-call-param.ruleset_id = p-ruleset-id
     2360   and buf_rule-call-param.call_id = p-call-id
     2361   and buf_rule-call-param.order_id = p-order-id
     2362   and buf_rule-call-param.rule_id = p-rule-id
     2363   and buf_rule-call-param.param-name = "p-xsd-file"
     2364    no-error.
     2365   if available buf_rule-call-param then do:
     2366   assign p-xsd-file = buf_rule-call-param.param-value-character.
     2367   end.
     2368    find first buf_rule-call-param no-lock where
     2369   buf_rule-call-param.codex_id = p-codex-id
     2370   and buf_rule-call-param.ruleset_id = p-ruleset-id
     2371   and buf_rule-call-param.call_id = p-call-id
     2372   and buf_rule-call-param.order_id = p-order-id
     2373   and buf_rule-call-param.rule_id = p-rule-id
     2374   and buf_rule-call-param.param-name = "p-esys-id"
     2375    no-error.
     2376   if available buf_rule-call-param then do:
     2377   assign p-esys-id = buf_rule-call-param.param-value-integer.
     2378   end.
     2379       case p-ruleset-id:
     2380         when 4 then do:
     2381           assign
     2382           v-sign = 1
     2383           v-current-host-code = p-host-code
     2384           v-current-obj-type = p-obj-type
     2385           v-current-obj-code = p-obj-code
     2386           v-current-doc-code = p-doc-code
     2387           v-current-db-num = g#db-num
     2388           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     2389           file-name  = entry(1, p-process-file-name, chr(4))
     2390           v_dataseth = handle(entry(2, p-process-file-name, chr(4)))
     2391           v-xmlh = buffer buf_temp-xml-tables:handle
     2392           v-esys-id = integer(p-doc-code)
     2393           v-extension = entry(num-entries(file-name, "."), file-name, ".")
     2394           v-pck-num = integer(entry(3, p-process-file-name, chr(4)))
     2395           log-file-name = entry(4, p-process-file-name, chr(4))
     2396           no-error
     2397           .
     2398           if error-status:error then do:
     2399                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибки параметров&1&2 ..."                                         , chr(10)                                         , error-status:get-message(1) )).                      assign v-view-log = yes.
     2400             undo, return error substitute("Ошибки параметров&1&2 ..."                                         , chr(10)                                         , error-status:get-message(1) ).
     2401           end.
     2402           find first buf_ext-system no-lock where
     2403                     buf_ext-system.esys-id = v-esys-id
     2404                 and buf_ext-system.db-num = 0 no-error .
     2405           if not available buf_ext-system then do:
     2406                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не найдена ВС &1&2пропускаем ..."                                         , v-esys-id                                         , chr(10)                                         )).                      assign v-view-log = yes.
     2407             undo, return error substitute("Не найдена ВС &1&2пропускаем ..."                                         , v-esys-id                                         , chr(10)                                         ).
     2408           end.
     2409           if v-extension = ''
     2410           or lookup(v-extension, "dat") = 0 then do:
     2411                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Файл &1 имеет недопустимое расширение &3&2пропускаем ..."                                         ,file-name                                         , chr(10)                                         , v-extension                                         )).                      assign v-view-log = yes.
     2412             undo, return error substitute("Файл &1 имеет недопустимое расширение &3&2пропускаем ..."                                         ,file-name                                         , chr(10)                                         , v-extension                                         ).
     2413           end.
     2414           _top-buffers:
     2415           do v-itop = 1 to v_dataseth:num-top-buffers:
     2416             if v_dataseth:get-top-buffer(v-itop):table = "header_" then do:
     2417               next _top-buffers.
     2418             end.
     2419             assign
     2420             v-ds-read-order = v-ds-read-order +
     2421                               (if v-ds-read-order = '':U then '':U else chr(44)) +
     2422                               v_dataseth:get-top-buffer(v-itop):table
     2423                               .
     2424             do v-ichild = 1 to v_dataseth:get-top-buffer(v-itop):num-child-relations:
     2425               assign
     2426               v-ds-read-order = v-ds-read-order + chr(44) + v_dataseth:get-top-buffer(v-itop):get-child-relation(v-ichild):child-buffer:name.
     2427             end.
     2428           end.
     2429         end.
     2430         otherwise do:
     2431           undo, return error "Неправильный вызов".
     2432         end.
     2433       end case.
     2434     end.
     2435   end procedure.
     2436   procedure delete-procedure :
     2437     do
     2438     on error  undo, return error substitute( "&1 (delete-procedure). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2439     on stop   undo, return error substitute( "&1 (delete-procedure). stop", vss-workfile )
     2440     on endkey undo, return error substitute( "&1 (delete-procedure). endkey", vss-workfile )
     2441     :
     2442         run clear_tt in this-procedure .
     2443         run garbcoll_clear in this-procedure .
     2444     end.
     2445   end procedure.
     2446   procedure proc-save-pay-type :
     2447     define input  parameter p-pay-type-code like ub.pay-type.obj-code no-undo .
     2448     define input  parameter p-pay-type-name like ub.pay-type.obj-name no-undo .
     2449     do
     2450     on error  undo, return error substitute( "&1 (proc-save-pay-type). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2451     on stop   undo, return error substitute( "&1 (proc-save-pay-type). stop", vss-workfile )
     2452     on endkey undo, return error substitute( "&1 (proc-save-pay-type). endkey", vss-workfile )
     2453     :
     2454       define buffer buf_pay-type for ub.pay-type .
     2455       define variable v-rid  as recid     no-undo .
     2456       define variable v-mode as character no-undo .
     2457       find first buf_pay-type exclusive-lock
     2458         where buf_pay-type.obj-code = p-pay-type-code
     2459         no-error .
     2460       if available buf_pay-type then do:
     2461         assign
     2462           v-mode = 'ИЗМЕНЕНИЕ':U
     2463           v-rid  = recid( buf_pay-type )
     2464         .
     2465       end.
     2466       else do:
     2467         assign
     2468           v-mode = 'ДОБАВЛЕНИЕ':U
     2469           v-rid  = ?
     2470         .
     2471       end.
     2472       run ref/paytype1.p
     2473         ( input-output v-rid
     2474         , input v-mode
     2475         , input true
     2476         , input p-pay-type-code
     2477         , input p-pay-type-name
     2478         ) no-error.
     2479       if error-status:error then do:
     2480         undo, return error substitute( "&1 (proc-save-pay-type). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)) .
     2481       end.
     2482     end.
     2483   end procedure.
