     2061   function 00200004_get-error-message returns character :
     2062   define variable v-ii as integer no-undo .
     2063   define variable v-mess as character no-undo .
     2064   DO v-ii = 1 TO ERROR-STATUS:NUM-MESSAGES:
     2065       v-mess = substitute("&1&2ош &3"
     2066                           ,v-mess
     2067                           ,chr(10)
     2068                           ,ERROR-STATUS:GET-MESSAGE(v-ii)).
     2069   END.
     2070   end function.
     2071     define variable p-esys-id  as integer no-undo.
