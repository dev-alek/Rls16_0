     2374       then do:
     2375         if connected("ub") = true
     2376         then do:
     2377           define variable v-cntxt-db-num        as integer   no-undo .
     2378           define variable v-cntxt-userid        as character no-undo .
     2379           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2380                                             , OUTPUT v-cntxt-userid
     2381                                             ) .
     2382           run gbl/wndsizew.p
     2383             (input  v-cntxt-db-num
     2384             ,input  v-cntxt-userid
     2385             ,input  v-diasize-proc-name
     2386             ,input  'width':u
     2387             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2388             ) .
     2389         end.
     2390       end.
     2391     end.
     2392     assign
     2393       v-diasize-change-size = false
     2394     .
     2395   end procedure.
     2396   procedure diasize_set-width :
     2397     define input  parameter p-new-width  as decimal   no-undo .
     2398     define input  parameter p-move-resize as logical   no-undo .
     2399     do
     2400     on error undo, return error return-value
     2401     :
     2402       run diasize_change-width in this-procedure
     2403         (input  (p-new-width - frame Dialog-Frame :width)
     2404         ,input  p-move-resize
     2405         ) .
     2406     end.
     2407   end procedure.
     2408   procedure diasize_position-resize-button :
     2409     do with frame Dialog-Frame
     2410     :
     2411       hide v-diasize-resize-button .
     2412       assign
     2413         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2414                     - 1
     2415                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2416         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2417                     - 1
     2418                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2419       .
     2420       view v-diasize-resize-button .
     2421     end.
     2422   end procedure.
     2423   on alt-right anywhere
     2424   do:
     2425     run diasize_change-width in this-procedure
     2426       (input 1
     2427       ,input true
     2428       ) .
     2429     return no-apply .
     2430   end.
     2431   on alt-left anywhere
     2432   do:
     2433     run diasize_change-width in this-procedure
     2434       (input -1
     2435       ,input true
     2436       ) .
     2437     return no-apply .
     2438   end.
     2439   on alt-down anywhere
     2440   do:
     2441     run diasize_change-height in this-procedure
     2442       (input 1
     2443       ,input true
     2444       ) .
     2445     return no-apply .
     2446   end.
     2447   on alt-up anywhere
     2448   do:
     2449     run diasize_change-height in this-procedure
     2450       (input -1
     2451       ,input true
     2452       ) .
     2453     return no-apply .
     2454   end.
     2455   on alt-enter of frame Dialog-Frame
     2456   do:
     2457     run diasize_maximize in this-procedure
     2458       (input  ?
     2459       ).
     2460     return no-apply .
     2461   end.
     2462   procedure diasize_end-move :
     2463     do
     2464     on error undo, return error return-value
     2465     :
     2466       define variable v-row-delta as decimal   no-undo .
     2467       define variable v-col-delta as decimal   no-undo .
     2468       define variable v-new-row as decimal   no-undo .
     2469       define variable v-new-col as decimal   no-undo .
     2470       assign
     2471         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2472         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2473       .
     2474       assign
     2475         v-row-delta = v-new-row - frame Dialog-Frame :height
     2476         v-col-delta = v-new-col - frame Dialog-Frame :width
     2477       .
     2478       run diasize_change-height in this-procedure
     2479         (input v-row-delta
     2480         ,input true
     2481         ) .
     2482       run diasize_change-width in this-procedure
     2483         (input v-col-delta
     2484         ,input true
     2485         ) .
     2486     end.
     2487   end procedure.
     2488   procedure diasize_maximize :
     2489     define input  parameter p-action as logical   no-undo .
     2490     do
     2491     on error undo, return error return-value
     2492     :
     2493       if p-action = ?
     2494       then do:
     2495         if v-diasize-need-maximize = true
     2496         then do:
     2497           assign
     2498             p-action = true
     2499           .
     2500         end.
     2501         else do:
     2502           assign
     2503             p-action = false
     2504           .
     2505         end.
     2506       end.
     2507       if p-action = true
     2508       then do:
     2509         run diasize_change-height in this-procedure
     2510           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2511               - frame Dialog-Frame :height-chars
     2512           ,input true
     2513           ) .
     2514         run diasize_change-width in this-procedure
     2515           (input session :width-chars
     2516               - frame Dialog-Frame :width-chars
     2517           ,input true
     2518           ) .
     2519         assign
     2520           v-diasize-need-maximize = false
     2521         .
     2522       end.
     2523       else do:
     2524         run diasize_change-width in this-procedure
     2525           (input v-diasize-orig-frame-width
     2526               - frame Dialog-Frame :width-chars
     2527           ,input true
     2528           ) .
     2529         run diasize_change-height in this-procedure
     2530           (input v-diasize-orig-frame-height
     2531               - frame Dialog-Frame :height-chars
     2532           ,input true
     2533           ) .
     2534         assign
     2535           v-diasize-need-maximize = true
     2536         .
     2537       end.
     2538     end.
     2539   end procedure.
     2540   procedure diasize_restore-orig-size :
     2541     do
     2542     on error undo, return error return-value
     2543     :
     2544       assign
     2545         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2546         v-diasize-current-frame-height = frame Dialog-Frame :height
     2547       .
     2548       run diasize_set-height in this-procedure
     2549         (input  v-diasize-orig-frame-height
     2550         ,input  true
     2551         ) .
     2552       run diasize_set-width in this-procedure
     2553         (input  v-diasize-orig-frame-width
     2554         ,input  true
     2555         ) .
     2556     end.
     2557   end procedure.
     2558   procedure diasize_restore-current-size :
     2559     do
     2560     on error undo, return error return-value
     2561     :
     2562       run diasize_set-height in this-procedure
     2563         (input  v-diasize-current-frame-height
     2564         ,input  true
     2565         ) .
     2566       run diasize_set-width in this-procedure
     2567         (input  v-diasize-current-frame-width
     2568         ,input  true
     2569         ) .
     2570     end.
     2571   end procedure.
     2572   procedure diasize_set-browse-handle :
     2573     define input  parameter p-browse-handle as handle   no-undo .
     2574     define buffer buf_temp-browse-handle for temp-browse-handle .
     2575     do
     2576     on error undo, return error return-value
     2577     :
     2578       assign
     2579         v-diasize-browse-handle = p-browse-handle
     2580       .
     2581       for each buf_temp-browse-handle
     2582       on error undo, return error return-value
     2583       :
     2584         delete buf_temp-browse-handle .
     2585       end.
     2586     end.
     2587   end procedure.
     2588   procedure diasize_add_browse :
     2589     define input  parameter p-browse-type   as character no-undo .
     2590     define input  parameter p-browse-handle as handle    no-undo .
     2591     define buffer buf_temp-browse-handle for temp-browse-handle .
     2592     do
     2593     on error undo, return error return-value
     2594     :
     2595       assign
     2596         v-diasize-browse-number = v-diasize-browse-number + 1
     2597       .
     2598       create buf_temp-browse-handle .
     2599       assign
     2600         buf_temp-browse-handle.browse-type   = p-browse-type
     2601         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2602         buf_temp-browse-handle.browse-handle = p-browse-handle
     2603       .
     2604     end.
     2605   end procedure.
     2606   procedure diasize_init :
     2607     define variable v-default-value    as logical   no-undo .
     2608     define variable v-restore-saved    as logical   no-undo .
     2609     define variable v-resize-value-str as character no-undo .
     2610     do
     2611     on error undo, return error return-value
     2612     :
     2613       do with frame Dialog-Frame
     2614       :
     2615         assign
     2616           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2617           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2618           v-diasize-browse-handle     = browse BR-rcp :handle
     2619         .
     2620         create button v-diasize-resize-button
     2621         assign
     2622           parent        = frame Dialog-Frame :first-child
     2623           label         = "s"
     2624           height-pixels = 16
     2625           width-pixels  = 16
     2626           visible       = true
     2627           sensitive     = true
     2628           movable       = true
     2629           triggers:
     2630             on end-move persistent run diasize_end-move in this-procedure .
     2631           end triggers.
     2632         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2633         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2634         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2635         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2636         assign
     2637           v-diasize-wndmax = false
     2638         .
     2639         if connected("ub") = true
     2640         then do:
     2641           define variable v-cntxt-db-num        as integer   no-undo .
     2642           define variable v-cntxt-userid        as character no-undo .
     2643           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2644                                             , OUTPUT v-cntxt-userid
     2645                                             ) .
     2646           run gbl/wndpar_r.p
     2647             (input  v-cntxt-db-num
     2648             ,input  v-cntxt-userid
     2649             ,input  'wndmax':U
     2650             ,output v-diasize-wndmax
     2651             ,output v-default-value
     2652             ) .
     2653         end.
     2654         assign
     2655           v-diasize-wndstore = false
     2656         .
     2657         if connected("ub") = true
     2658         then do:
     2659           run gbl/wndpar_r.p
     2660             (input  v-cntxt-db-num
     2661             ,input  v-cntxt-userid
     2662             ,input  'wndstore':U
     2663             ,output v-diasize-wndstore
     2664             ,output v-default-value
     2665             ) .
     2666         end.
     2667         assign
     2668           v-diasize-proc-name = entry(1, program-name(2), '.')
     2669         .
     2670         if v-diasize-wndstore = true
     2671         then do:
     2672           assign
     2673             v-restore-saved = false
     2674           .
     2675           if connected("ub") = true
     2676           then do:
     2677             run gbl/wndsizer.p
     2678               (input  v-cntxt-db-num
     2679               ,input  v-cntxt-userid
     2680               ,input  v-diasize-proc-name
     2681               ,input  'height':u
     2682               ,output v-resize-value-str
     2683               ) .
     2684             if v-resize-value-str <> '':U
     2685             then do:
     2686               run diasize_change-height in this-procedure
     2687                 (input  integer(v-resize-value-str)
     2688                 ,input  true
     2689                 ) .
     2690               assign
     2691                 v-restore-saved = true
     2692               .
     2693             end.
     2694           end.
     2695           if connected("ub") = true
     2696           then do:
     2697             run gbl/wndsizer.p
     2698               (input  v-cntxt-db-num
     2699               ,input  v-cntxt-userid
     2700               ,input  v-diasize-proc-name
     2701               ,input  'width':u
     2702               ,output v-resize-value-str
     2703               ) .
     2704             if v-resize-value-str <> '':U
     2705             then do:
     2706               run diasize_change-width in this-procedure
     2707                 (input  integer(v-resize-value-str)
     2708                 ,input  true
     2709                 ) .
     2710               assign
     2711                 v-restore-saved = true
     2712               .
     2713             end.
     2714           end.
     2715           if v-restore-saved <> true
     2716           then do:
     2717             if v-diasize-wndmax = true
     2718             then do:
     2719               run diasize_maximize in this-procedure
     2720                 (input  true
     2721                 ) .
     2722             end.
     2723           end.
     2724         end.
     2725         else do:
     2726           if v-diasize-wndmax = true
     2727           then do:
     2728             run diasize_maximize in this-procedure
     2729               (input  true
     2730               ) .
     2731           end.
     2732         end.
     2733       end.
     2734     end.
     2735   end procedure.
     2736   procedure diasize_need-full-display :
     2737     define output parameter p-need-full-display as logical   no-undo .
     2738     do
     2739     on error undo, return error return-value
     2740     :
     2741       assign
     2742         p-need-full-display = v-diasize-need-full-display
     2743       .
     2744       assign
     2745         v-diasize-need-full-display = false
     2746       .
     2747     end.
     2748   end procedure.
     2749   procedure get-context :
     2750      define output parameter p-db-num as integer          no-undo.
     2751      define output parameter p-user-id as character        no-undo.
     2752      define variable v-login               as character    no-undo.
     2753      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2754      define buffer buf_user-login  for ub.user-login .
     2755      do
     2756      on error undo, return error
     2757      :
     2758            FIND FIRST buf_sys-ctrl no-lock.
     2759            ASSIGN
     2760               v-login = USERID("ub")
     2761               p-db-num = buf_sys-ctrl.db-num
     2762            .
     2763            FIND FIRST buf_user-login
     2764                 WHERE buf_user-login.db-num = p-db-num
     2765                   AND buf_user-login.user-login = v-login
     2766                 no-lock
     2767                 no-error
     2768                 .
     2769            IF AVAILABLE buf_user-login
     2770            THEN DO:
     2771               assign
     2772                  p-user-id = buf_user-login.user-id
     2773               .
     2774            END.
     2775      end.
     2776   end procedure.
     2777       run diasize_init in this-procedure .
     2778   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2779   procedure rcps_get-profile-id :
     2780   define output parameter p-local-profile-id as integer no-undo .
     2781   do
     2782   on error undo, return error:
     2783   p-local-profile-id = p-profile-id.
     2784   end.
     2785   end procedure.
     2786   PROCEDURE rcps_fill-table :
     2787   define input parameter p-clear-params as logical no-undo .
     2788   if p-clear-params then do:
     2789   FOR EACH tt-rule-call-param:
     2790       DELETE tt-rule-call-param.
     2791   END.
     2792   end.
     2793    FOR EACH tt0-rule-call-param:
     2794      IF p-mode <> 'ДОБАВЛЕНИЕ':U THEN DO:
     2795        IF p-call-id <> '':U and p-call-id <> tt0-rule-call-param.call_id THEN do:
     2796           NEXT.
     2797        end.
     2798        IF p-codex-id <> 0 and p-codex-id <> tt0-rule-call-param.codex_id THEN do:
     2799          NEXT.
     2800        end.
     2801        IF p-ruleset-id <> 0 and p-ruleset-id <> tt0-rule-call-param.ruleset_id THEN do:
     2802          NEXT.
     2803        end.
     2804        IF p-rule-id <> 0 and p-rule-id <> tt0-rule-call-param.RULE_id THEN do:
     2805          NEXT.
     2806        end.
     2807        IF p-order-id <> ? and p-order-id <> tt0-rule-call-param.order_id THEN do:
     2808          NEXT.
     2809        end.
     2810      END.
     2811      if lookup("hidden", tt0-rule-call-param.param-3-data-type) > 0 then do:
     2812        next.
     2813      end.
     2814      IF p-list-mode = 'rp-rule-param':U
     2815      or p-list-mode = 'rp-rule-param':U  + chr(44) + 'все':U
     2816      THEN DO:
     2817         IF p-profile-id <> 0 AND p-profile-id <> tt0-rule-call-param.profile_id THEN do:
     2818           NEXT.
     2819         end.
     2820         IF p-once-more <> ? AND p-once-more <> tt0-rule-call-param.once-more THEN do:
     2821           NEXT.
     2822         end.
     2823      END.
     2824      CREATE tt-rule-call-param.
     2825      BUFFER-COPY tt0-rule-call-param TO tt-rule-call-param.
     2826   END.
     2827   END PROCEDURE.
     2828   procedure rcps_get-value :
     2829   DEFINE INPUT PARAMETER p-profile-id AS integer NO-UNDO.
     2830   DEFINE INPUT PARAMETER p-once-more AS integer NO-UNDO.
     2831   DEFINE INPUT PARAMETER p-call-id AS CHARACTER NO-UNDO.
     2832   DEFINE INPUT PARAMETER p-rp-param-name AS CHARACTER NO-UNDO.
     2833   DEFINE INPUT-output PARAMETER pp-index AS integer NO-UNDO.
     2834   DEFINE output parameter p-value-character AS CHARACTER NO-UNDO.
     2835   DEFINE output parameter p-value-date AS date NO-UNDO.
     2836   DEFINE output parameter p-value-decimal AS decimal NO-UNDO.
     2837   DEFINE output parameter p-value-integer AS integer NO-UNDO.
     2838   DEFINE output parameter p-value-logical AS logical NO-UNDO.
     2839   define variable v-current-index as integer no-undo init -1.
     2840   define variable v-start as logical no-undo init yes.
     2841   DEFINE BUFFER buf_ruledict-param FOR ub.ruledict-param.
     2842   DEFINE BUFFER buf_rp-rule-param FOR ub.rp-rule-param.
     2843   DEFINE BUFFER buf_tt-rule-call-param FOR tt-rule-call-param.
     2844   DEFINE BUFFER buf_term_tt-rule-call-param FOR tt-rule-call-param.
     2845   do
     2846   on error undo, return error
     2847   :
     2848   FOR FIRST buf_rp-rule-param WHERE
     2849         buf_rp-rule-param.profile_id = p-profile-id
     2850     AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     2851   , each buf_tt-rule-call-param WHERE
     2852      buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     2853   AND buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     2854   AND buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     2855   AND buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     2856   AND buf_tt-rule-call-param.p-index >= pp-index
     2857    ,each buf_term_tt-rule-call-param where
     2858          buf_term_tt-rule-call-param.call_id = buf_tt-rule-call-param.call_id
     2859      and buf_term_tt-rule-call-param.codex_id = buf_tt-rule-call-param.codex_id
     2860      and buf_term_tt-rule-call-param.ruleset_id = buf_tt-rule-call-param.ruleset_id
     2861      and buf_term_tt-rule-call-param.order_id = buf_tt-rule-call-param.order_id
     2862      and buf_term_tt-rule-call-param.param-name = buf_tt-rule-call-param.param-name
     2863      and buf_term_tt-rule-call-param.p-index = buf_tt-rule-call-param.p-index
     2864     by buf_term_tt-rule-call-param.call_id
     2865     by buf_term_tt-rule-call-param.codex_id
     2866     by buf_term_tt-rule-call-param.ruleset_id
     2867     by buf_term_tt-rule-call-param.order_id
     2868     by buf_term_tt-rule-call-param.param-name
     2869     by buf_term_tt-rule-call-param.p-index :
     2870       if v-start
     2871       then do:
     2872         assign
     2873         pp-index = buf_term_tt-rule-call-param.p-index
     2874         p-value-character = buf_term_tt-rule-call-param.param-value-character
     2875         p-value-date      = buf_term_tt-rule-call-param.param-value-date
     2876         p-value-decimal   = buf_term_tt-rule-call-param.param-value-decimal
     2877         p-value-integer   = buf_term_tt-rule-call-param.param-value-integer
     2878         p-value-logical   = buf_term_tt-rule-call-param.param-value-logical
     2879         v-start = no
     2880         .
     2881       end.
     2882       else do:
     2883         if buf_term_tt-rule-call-param.p-index > pp-index then do:
     2884           v-current-index = buf_term_tt-rule-call-param.p-index.
     2885           leave.
     2886         end.
     2887             end.
     2888     end.
     2889     pp-index = v-current-index.
     2890   end.
     2891   end procedure.
     2892   PROCEDURE rcps_proc-b-add :
     2893   DEFINE INPUT PARAMETER p-profile-id AS integer NO-UNDO.
     2894   DEFINE INPUT PARAMETER p-once-more AS integer NO-UNDO.
     2895   DEFINE INPUT PARAMETER p-call-id AS CHARACTER NO-UNDO.
     2896   DEFINE INPUT PARAMETER p-rp-param-name AS CHARACTER NO-UNDO.
     2897   DEFINE INPUT PARAMETER p-index AS integer NO-UNDO.
     2898   define variable v-ind as integer no-undo .
     2899   define buffer buf_tt-rule-call-param for tt-rule-call-param.
     2900   define buffer buf0_tt-rule-call-param for tt-rule-call-param.
     2901   define buffer buf2_tt-rule-call-param for tt-rule-call-param.
     2902   define buffer buf_rp-rule-param for ub.rp-rule-param.
     2903   FOR FIRST buf_rp-rule-param WHERE
     2904             buf_rp-rule-param.profile_id = p-profile-id
     2905         AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     2906       , first buf0_tt-rule-call-param WHERE
     2907          buf0_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     2908      AND buf0_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     2909      AND buf0_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     2910      AND buf0_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name:
     2911     LEAVE.
     2912   END.
     2913   IF NOT AVAILABLE buf0_tt-rule-call-param THEN do:
     2914     BELL.
     2915     RETURN.
     2916   END.
     2917   for each buf_rp-rule-param where
     2918           buf_rp-rule-param.rp-param-name = p-rp-param-name
     2919       and buf_rp-rule-param.profile_id = p-profile-id,
     2920       first buf_tt-rule-call-param where
     2921           buf_tt-rule-call-param.call_id = buf0_tt-rule-call-param.call_id
     2922       and buf_tt-rule-call-param.profile_id = buf_rp-rule-param.profile_id
     2923       and buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     2924       and buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     2925       and buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     2926       and buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     2927       and buf_tt-rule-call-param.once-more = buf0_tt-rule-call-param.once-more
     2928       and buf_tt-rule-call-param.p-index = p-index:
     2929     RETURN.
     2930   END.
     2931   IF lookup("LIST", buf0_tt-rule-call-param.param-3-data-type) = 0
     2932   and lookup("SORTED-LIST", buf0_tt-rule-call-param.param-3-data-type) = 0
     2933   THEN DO:
     2934     BELL.
     2935     RETURN.
     2936   END.
     2937   IF buf0_tt-rule-call-param.p-index <> 0 THEN DO:
     2938     BELL.
     2939     RETURN.
     2940   END.
     2941   find last buf_tt-rule-call-param where
     2942            buf_tt-rule-call-param.call_id = buf0_tt-rule-call-param.call_id
     2943        and buf_tt-rule-call-param.codex_id = buf0_tt-rule-call-param.codex_id
     2944        and buf_tt-rule-call-param.ruleset_id = buf0_tt-rule-call-param.ruleset_id
     2945        and buf_tt-rule-call-param.order_id = buf0_tt-rule-call-param.order_id
     2946        and buf_tt-rule-call-param.param-name = buf0_tt-rule-call-param.param-name no-error .
     2947   if available buf_tt-rule-call-param
     2948   and (lookup("LIST", buf_tt-rule-call-param.param-3-data-type) > 0
     2949        or
     2950        lookup("SORTED-LIST", buf_tt-rule-call-param.param-3-data-type) > 0
     2951        )
     2952   and buf_tt-rule-call-param.p-index > 0 then do:
     2953     v-ind = buf_tt-rule-call-param.p-index.
     2954   end.
     2955   for each buf_rp-rule-param where
     2956           buf_rp-rule-param.rp-param-name = p-rp-param-name
     2957       and buf_rp-rule-param.profile_id = p-profile-id,
     2958       first buf_tt-rule-call-param where
     2959           buf_tt-rule-call-param.call_id = buf0_tt-rule-call-param.call_id
     2960       and buf_tt-rule-call-param.profile_id = buf_rp-rule-param.profile_id
     2961       and buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     2962       and buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     2963       and buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     2964       and buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     2965       and buf_tt-rule-call-param.once-more = buf0_tt-rule-call-param.once-more
     2966       and buf_tt-rule-call-param.p-index = 0
     2967   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2968   on stop   undo, return error substitute( "&1. stop", vss-workfile )
     2969   on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     2970   :
     2971     create buf2_tt-rule-call-param.
     2972     buffer-copy buf_tt-rule-call-param
     2973     except p-index
     2974     to buf2_tt-rule-call-param
     2975     assign
     2976     buf2_tt-rule-call-param.p-index = v-ind + 1
     2977     .
     2978   end.
     2979   END PROCEDURE.
     2980   PROCEDURE rcps_proc-b-del :
     2981   DEFINE INPUT PARAMETER p-profile-id AS integer NO-UNDO.
     2982   DEFINE INPUT PARAMETER p-once-more AS integer NO-UNDO.
     2983   DEFINE INPUT PARAMETER p-call-id AS CHARACTER NO-UNDO.
     2984   DEFINE INPUT PARAMETER p-rp-param-name AS CHARACTER NO-UNDO.
     2985   DEFINE INPUT PARAMETER pp-index AS integer NO-UNDO.
     2986   define variable v-ind as integer no-undo .
     2987   define variable v-once-more as integer no-undo .
     2988   define variable v-call-id as character no-undo .
     2989   define buffer buf0_tt-rule-call-param for tt-rule-call-param.
     2990   define buffer buf_tt-rule-call-param for tt-rule-call-param.
     2991   define buffer buf_rp-rule-param for ub.rp-rule-param.
     2992   if pp-index = 0 then do:
     2993     undo, return error substitute("Нельзя удалять корневой параметр &1 (индекс = 0)", p-rp-param-name).
     2994   end.
     2995   FOR first buf_rp-rule-param WHERE
     2996             buf_rp-rule-param.profile_id = p-profile-id
     2997         AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     2998       , first buf0_tt-rule-call-param WHERE
     2999          buf0_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3000      AND buf0_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3001      AND buf0_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3002      AND buf0_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     3003      AND buf0_tt-rule-call-param.p-index = pp-index
     3004      :
     3005     LEAVE.
     3006   END.
     3007   IF NOT AVAILABLE buf0_tt-rule-call-param THEN do:
     3008     FOR first buf_rp-rule-param WHERE
     3009               buf_rp-rule-param.profile_id = p-profile-id
     3010           AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     3011         , last buf0_tt-rule-call-param WHERE
     3012           buf0_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3013       AND buf0_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3014       AND buf0_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3015       AND buf0_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     3016       AND buf0_tt-rule-call-param.p-index > pp-index :
     3017       leave.
     3018     end.
     3019     IF NOT AVAILABLE buf0_tt-rule-call-param THEN do:
     3020     return "not-found".
     3021     end.
     3022     else do:
     3023       return ''.
     3024     end.
     3025   END.
     3026   IF lookup("LIST", buf0_tt-rule-call-param.param-3-data-type) = 0
     3027   and lookup("SORTED-LIST", buf0_tt-rule-call-param.param-3-data-type) = 0
     3028   THEN DO:
     3029     undo, return error substitute("Можно удалять только параметры типа LIST и SORTED-LIST").
     3030   END.
     3031   IF lookup("READ-ONLY", buf0_tt-rule-call-param.param-3-data-type) > 0 THEN DO:
     3032     undo, return error substitute("Нельзя удалять  параметры типа READ-ONLY").
     3033   END.
     3034   for each buf_rp-rule-param where
     3035           buf_rp-rule-param.rp-param-name = buf_rp-rule-param.rp-param-name
     3036       and buf_rp-rule-param.profile_id = buf_rp-rule-param.profile_id,
     3037       each buf_tt-rule-call-param where
     3038           buf_tt-rule-call-param.call_id = p-call-id
     3039       and buf_tt-rule-call-param.profile_id = buf_rp-rule-param.profile_id
     3040       and buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3041       and buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3042       and buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3043       and buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     3044       and buf_tt-rule-call-param.once-more = p-once-more
     3045       and buf_tt-rule-call-param.p-index = pp-index
     3046   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3047   on stop   undo, return error substitute( "&1. stop", vss-workfile )
     3048   on endkey undo, return error substitute( "&1. endkey", vss-workfile ):
     3049       DELETE buf_tt-rule-call-param.
     3050   end.
     3051   return ''.
     3052   END PROCEDURE.
     3053   PROCEDURE rcps_proc-save0 :
     3054   FOR EACH tt-rule-call-param
     3055   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3056   on stop   undo , return error substitute( "&1. stop", vss-workfile )
     3057   on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     3058   :
     3059      find  FIRST tt0-rule-call-param NO-LOCK WHERE
     3060               tt0-rule-call-param.codex_id = tt-rule-call-param.codex_id
     3061          AND  tt0-rule-call-param.ruleset_id = tt-rule-call-param.ruleset_id
     3062          AND tt0-rule-call-param.call_id = tt-rule-call-param.call_id
     3063          AND tt0-rule-call-param.order_id = tt-rule-call-param.order_id
     3064          AND tt0-rule-call-param.param-name = tt-rule-call-param.param-name
     3065          AND tt0-rule-call-param.p-index = tt-rule-call-param.p-index no-error .
     3066      if not available tt0-rule-call-param
     3067      and (lookup("LIST", tt-rule-call-param.param-3-data-type) > 0
     3068           OR
     3069           lookup("SORTED-LIST", tt-rule-call-param.param-3-data-type) > 0
     3070           )
     3071      and tt-rule-call-param.p-index > 0 then do:
     3072        create tt0-rule-call-param.
     3073      end.
     3074      BUFFER-COPY tt-rule-call-param TO tt0-rule-call-param.
     3075   END.
     3076   FOR EACH tt0-rule-call-param
     3077   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3078   on stop   undo , return error substitute( "&1. stop", vss-workfile )
     3079   on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     3080   :
     3081     if tt0-rule-call-param.p-index = 0 then next.
     3082     if lookup("hidden", tt0-rule-call-param.param-3-data-type) > 0 then next.
     3083     find  FIRST tt-rule-call-param NO-LOCK WHERE
     3084             tt-rule-call-param.codex_id = tt0-rule-call-param.codex_id
     3085         AND tt-rule-call-param.ruleset_id = tt0-rule-call-param.ruleset_id
     3086         AND tt-rule-call-param.call_id = tt0-rule-call-param.call_id
     3087         AND tt-rule-call-param.order_id = tt0-rule-call-param.order_id
     3088         AND tt-rule-call-param.param-name = tt0-rule-call-param.param-name
     3089         AND tt-rule-call-param.p-index = tt0-rule-call-param.p-index no-error .
     3090     if not available tt-rule-call-param
     3091     and (lookup("LIST", tt0-rule-call-param.param-3-data-type) > 0
     3092         OR
     3093         lookup("SORTED-LIST", tt0-rule-call-param.param-3-data-type) > 0
     3094         )
     3095     and tt0-rule-call-param.p-index > 0
     3096     then do:
     3097        IF p-call-id <> '':U and p-call-id <> tt0-rule-call-param.call_id THEN do:
     3098           NEXT.
     3099        end.
     3100        IF p-codex-id <> 0 and p-codex-id <> tt0-rule-call-param.codex_id THEN do:
     3101          NEXT.
     3102        end.
     3103        IF p-ruleset-id <> 0 and p-ruleset-id <> tt0-rule-call-param.ruleset_id THEN do:
     3104          NEXT.
     3105        end.
     3106        IF p-rule-id <> 0 and p-rule-id <> tt0-rule-call-param.RULE_id THEN do:
     3107          NEXT.
     3108        end.
     3109        IF p-order-id <> ? and p-order-id <> tt0-rule-call-param.order_id THEN do:
     3110          NEXT.
     3111        end.
     3112       IF p-list-mode = 'rp-rule-param':U
     3113       or p-list-mode = 'rp-rule-param':U  + chr(44) + 'все':U
     3114       THEN DO:
     3115         IF p-profile-id <> 0 AND p-profile-id <> tt0-rule-call-param.profile_id THEN do:
     3116           NEXT.
     3117         end.
     3118         IF p-once-more <> ? AND p-once-more <> tt0-rule-call-param.once-more THEN do:
     3119           NEXT.
     3120         end.
     3121       end.
     3122       delete tt0-rule-call-param.
     3123     end.
     3124   end.
     3125   END PROCEDURE.
     3126   PROCEDURE rcps_set-value :
     3127   DEFINE INPUT PARAMETER p-profile-id AS integer NO-UNDO.
     3128   DEFINE INPUT PARAMETER p-once-more AS integer NO-UNDO.
     3129   DEFINE INPUT PARAMETER p-call-id AS CHARACTER NO-UNDO.
     3130   DEFINE INPUT PARAMETER p-rp-param-name AS CHARACTER NO-UNDO.
     3131   DEFINE INPUT PARAMETER pp-index AS integer NO-UNDO.
     3132   DEFINE INPUT parameter p-value-character AS CHARACTER NO-UNDO.
     3133   DEFINE INPUT parameter p-value-date AS date NO-UNDO.
     3134   DEFINE INPUT parameter p-value-decimal AS decimal NO-UNDO.
     3135   DEFINE INPUT parameter p-value-integer AS integer NO-UNDO.
     3136   DEFINE INPUT parameter p-value-logical AS logical NO-UNDO.
     3137   DEFINE VARIABLE v-codex-id AS integer NO-UNDO.
     3138   DEFINE VARIABLE v-ruleset-id AS integer NO-UNDO.
     3139   DEFINE VARIABLE v-order-id AS integer NO-UNDO.
     3140   DEFINE VARIABLE V-param-name AS character NO-UNDO.
     3141   define variable v-found as logical no-undo .
     3142   DEFINE BUFFER buf_tt-rule-call-param FOR tt-rule-call-param.
     3143   DEFINE BUFFER buf_rp-rule-param FOR ub.rp-rule-param.
     3144   FOR FIRST buf_rp-rule-param WHERE
     3145             buf_rp-rule-param.profile_id = p-profile-id
     3146         AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     3147       , first buf_tt-rule-call-param WHERE
     3148          buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3149      AND buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3150      AND buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3151      AND buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name:
     3152     ASSIGN
     3153     v-codex-id = buf_tt-rule-call-param.codex_id
     3154     v-ruleset-id = buf_tt-rule-call-param.ruleset_id
     3155     v-order-id = buf_tt-rule-call-param.order_id
     3156     V-PARAM-NAME = buf_tt-rule-call-param.PARAM-NAME
     3157     .
     3158     LEAVE.
     3159   END.
     3160   CASE p-list-mode:
     3161     WHEN 'rp-rule-param':U THEN DO:
     3162       if pp-index > 0
     3163       then do:
     3164         FOR EACH  buf_rp-rule-param NO-LOCK where
     3165             buf_rp-rule-param.profile_id = p-profile-id
     3166             AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     3167             ,EACH buf_tt-rule-call-param WHERE
     3168                 buf_tt-rule-call-param.profile_id = p-profile-id
     3169             AND buf_tt-rule-call-param.once-more = p-once-more
     3170             AND buf_tt-rule-call-param.call_id = p-CALL-id
     3171             AND buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3172             AND buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3173             AND buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3174             AND buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     3175             AND buf_tt-rule-call-param.p-index = pp-index
     3176         ON error undo, return error :
     3177           v-found = yes.
     3178         end.
     3179       end.
     3180       if not v-found then do:
     3181         run rcps_proc-b-add in this-procedure (
     3182                                                  input p-profile-id
     3183                                                 ,input p-once-more
     3184                                                 ,input p-call-id
     3185                                                 ,
     3186                                                  input p-rp-param-name
     3187                                                 ,input pp-index).
     3188       end.
     3189       FOR EACH  buf_rp-rule-param NO-LOCK where
     3190           buf_rp-rule-param.profile_id = p-profile-id
     3191           AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     3192           ,EACH buf_tt-rule-call-param WHERE
     3193               buf_tt-rule-call-param.profile_id = p-profile-id
     3194           AND buf_tt-rule-call-param.once-more = p-once-more
     3195           AND buf_tt-rule-call-param.call_id = p-CALL-id
     3196           AND buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3197           AND buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3198           AND buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3199           AND buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     3200           AND buf_tt-rule-call-param.p-index = pp-index
     3201         ON error undo, return error :
     3202         assign
     3203         buf_tt-rule-call-param.param-value-character = p-value-character
     3204         buf_tt-rule-call-param.param-value-date      = p-value-date
     3205         buf_tt-rule-call-param.param-value-decimal   = p-value-decimal
     3206         buf_tt-rule-call-param.param-value-integer   = p-value-integer
     3207         buf_tt-rule-call-param.param-value-logical   = p-value-logical
     3208         .
     3209       END.
     3210     END.
     3211     WHEN 'rule-call-param':U THEN DO:
     3212       FIND FIRST buf_tt-rule-call-param WHERE
     3213           buf_tt-rule-call-param.call_id = p-call-id
     3214       AND buf_tt-rule-call-param.codex_id = v-codex-id
     3215       AND buf_tt-rule-call-param.ruleset_id = v-ruleset-id
     3216       AND buf_tt-rule-call-param.order_id = v-order-id
     3217       AND buf_tt-rule-call-param.param-name = V-PARAM-NAME
     3218       AND buf_tt-rule-call-param.p-index = pp-index.
     3219       assign
     3220       buf_tt-rule-call-param.param-value-character = p-value-character
     3221       buf_tt-rule-call-param.param-value-date      = p-value-date
     3222       buf_tt-rule-call-param.param-value-decimal   = p-value-decimal
     3223       buf_tt-rule-call-param.param-value-integer   = p-value-integer
     3224       buf_tt-rule-call-param.param-value-logical   = p-value-logical
     3225       .
     3226     END.
     3227   END CASE.
     3228   END PROCEDURE.
