     2034     if p-change-value > 0
     2035     then do:
     2036       if frame Dialog-Frame :width + p-change-value >
     2037           session :width-chars
     2038       then do:
     2039         assign
     2040           p-change-value = session :width-chars - frame Dialog-Frame :width
     2041         .
     2042         if p-change-value <= 0
     2043         then do:
     2044           run diasize_position-resize-button in this-procedure .
     2045           return .
     2046         end.
     2047       end.
     2048     end.
     2049     if p-change-value < 0
     2050     then do:
     2051       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2052       then do:
     2053         assign
     2054           p-change-value = v-diasize-orig-frame-width
     2055                          - frame Dialog-Frame :width
     2056         .
     2057         if p-change-value >= 0
     2058         then do:
     2059           run diasize_position-resize-button in this-procedure .
     2060           return .
     2061         end.
     2062       end.
     2063     end.
     2064     if p-change-value >= 0
     2065     then do:
     2066       assign
     2067         v-change-sign = 1
     2068       .
     2069     end.
     2070     else do:
     2071       assign
     2072         v-change-sign = -1
     2073       .
     2074     end.
     2075     assign
     2076       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2077     .
     2078     if p-change-value = 0
     2079     then do:
     2080       run diasize_position-resize-button in this-procedure .
     2081       return .
