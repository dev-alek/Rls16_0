     1300        SIZE 3.6 BY 1.03.
     1301   DEFINE VARIABLE e-shops AS CHARACTER
     1302        VIEW-AS EDITOR SCROLLBAR-VERTICAL NO-BOX
     1303        SIZE 40.8 BY 3.37
     1304        FGCOLOR 1  NO-UNDO.
     1305   DEFINE VARIABLE f-list-name AS CHARACTER FORMAT "X(256)":U
     1306         VIEW-AS TEXT
     1307        SIZE 60.5 BY .67
     1308        FGCOLOR 4  NO-UNDO.
     1309   DEFINE VARIABLE v-list-id AS CHARACTER FORMAT "X(256)":U
     1310        LABEL "Список или макрос"
     1311        VIEW-AS FILL-IN
     1312        SIZE 12 BY 1
     1313        BGCOLOR 8 FGCOLOR 4  NO-UNDO.
     1314   DEFINE VARIABLE rs-action AS CHARACTER INITIAL "U"
     1315        VIEW-AS RADIO-SET VERTICAL
     1316        RADIO-BUTTONS
     1317             "Передача", "U",
     1318   "Удаление", "D"
     1319        SIZE 16 BY 2.13 NO-UNDO.
     1320   DEFINE VARIABLE rs-method AS CHARACTER
     1321        VIEW-AS RADIO-SET VERTICAL
     1322        RADIO-BUTTONS
     1323             "файл списка товаров", "gds-list",
     1324   "файл макроса формирования списка товаров", "gds-list-macro"
     1325        SIZE 65 BY 2 NO-UNDO.
     1326   DEFINE VARIABLE SelectObject AS INTEGER
     1327        VIEW-AS RADIO-SET VERTICAL
     1328        RADIO-BUTTONS
     1329             "все объекты БД", 1,
     1330   "объекты выборочно", 3
     1331        SIZE 28 BY 2.67 NO-UNDO.
     1332   DEFINE RECTANGLE rct-obj
     1333        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1334        SIZE 79 BY 4.27.
     1335   DEFINE QUERY BR-rcp FOR
     1336         X_ruledict-param,
     1337         X_rp-rule-param,
     1338         tt-rule-call-param,
     1339         TERM_tt-rule-call-param SCROLLING.
     1340   DEFINE BROWSE BR-rcp
     1341     QUERY BR-rcp DISPLAY
     1342         X_rp-rule-param.rp-param-name COLUMN-LABEL "Название пар-ра!профайла" FORMAT "X(20)" width 16
     1343   term_tt-rule-call-param.codex_id COLUMN-LABEL "Кодекс"
     1344   term_tt-rule-call-param.ruleset_id COLUMN-LABEL "Набор"
     1345   term_tt-rule-call-param.order_id  COLUMN-LABEL "Порядок!вызова"
     1346   term_tt-rule-call-param.rule_id  COLUMN-LABEL "Правило"
     1347   term_tt-rule-call-param.profile_id  COLUMN-LABEL "Профайл"
     1348   term_tt-rule-call-param.once-more COLUMN-LABEL "№!Привязки"
     1349   (if lookup (term_tt-rule-call-param.param-data-type, 'character,date,datetime,datetime-tz,decimal,integer,void,logical,memptr,raw,recid,rowid,widget-handle,handle,blob,clob,class,com-handle,longchar,int64':U) > 0 then entry (lookup (term_tt-rule-call-param.param-data-type, 'character,date,datetime,datetime-tz,decimal,integer,void,logical,memptr,raw,recid,rowid,widget-handle,handle,blob,clob,class,com-handle,longchar,int64':U), 'строка,дата,дата-время,дата-время-з,десятичное,целое,пусто,логическое,память,двоичные,номер записи,Номер Записи,ссылка,ссылка,Больш.бин.объект,Больш.стр.объект,Объект,COM-объект,Длинная строка,64Целое':U) else term_tt-rule-call-param.param-data-type) COLUMN-LABEL "Тип пар-ра" FORMAT "X(12)"
     1350   term_tt-rule-call-param.param-num COLUMN-LABEL "№!пар-ра" FORMAT ">9"
     1351   TERM_tt-rule-call-param.p-index COLUMN-LABEL "Инд!екс" FORMAT ">9"
     1352   term_tt-rule-call-param.param-name COLUMN-LABEL "Название пар-ра!правила" FORMAT "X(16)"
     1353   term_tt-rule-call-param.param-label COLUMN-LABEL "Название пар-ра" FORMAT "X(255)" WIDTH 30
     1354   entry (lookup (term_tt-rule-call-param.param-mode, 'input,output,input-output,buffer,input table,output table,input-output table':u), 'вх,вых,вх-вых,курсор,вх табл,вых табл,вх/вых табл':u) COLUMN-LABEL "Вид!пар-ра"
     1355   get-param-value( INPUT term_tt-rule-call-param.param-data-type
     1356                   ,INPUT term_tt-rule-call-param.param-2-data-type
     1357                   ,INPUT term_tt-rule-call-param.param-3-data-type
     1358                   ,INPUT TERM_tt-rule-call-param.p-index
     1359                   ,INPUT term_tt-rule-call-param.param-value-character
     1360                   ,INPUT term_tt-rule-call-param.param-value-date
     1361                   ,INPUT term_tt-rule-call-param.param-value-decimal
     1362                   ,INPUT term_tt-rule-call-param.param-value-integer
     1363                   ,INPUT term_tt-rule-call-param.param-value-logical) COLUMN-LABEL "Значение" FORMAT "X(255)" WIDTH 26
     1364   (IF term_tt-rule-call-param.param-data-type = 'character':U
     1365    THEN term_tt-rule-call-param.param-value-character
     1366    ELSE '':U) COLUMN-LABEL "Значение!(строковое)" FORMAT "X(26)"
     1367   (IF term_tt-rule-call-param.param-data-type = 'date':U
     1368   THEN STRING(term_tt-rule-call-param.param-value-date, "99/99/9999")
     1369   ELSE '':U)    COLUMN-LABEL "Значение!(Дата)" FORMAT "X(10)" WIDTH 12
     1370   (IF term_tt-rule-call-param.param-data-type = 'decimal':U
     1371   THEN STRING(term_tt-rule-call-param.param-value-decimal)
     1372   ELSE '':U) COLUMN-LABEL "Значение!(Десятичное)"   FORMAT "X(16)"
     1373   (IF term_tt-rule-call-param.param-data-type = 'integer':U
     1374   THEN STRING(term_tt-rule-call-param.param-value-integer)
     1375   ELSE '':U) COLUMN-LABEL "Значение!(Целое)" FORMAT "X(10)"
     1376   (IF term_tt-rule-call-param.param-data-type = 'logical':U
     1377   THEN STRING(term_tt-rule-call-param.param-value-logical, "+/-")
     1378   ELSE '':U) COLUMN-LABEL "Значение!(Логическое)" FORMAT "X(2)"
     1379   calldscr(tt-rule-call-param.call_id) COLUMN-LABEL  "Точка вызова" FORMAT "X(40)"
     1380       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 6.27
     1381            FONT 4 ROW-HEIGHT-CHARS .67 FIT-LAST-COLUMN.
     1382   DEFINE FRAME Dialog-Frame
     1383        B-exit AT ROW 1 COL 1
     1384        b-quit AT ROW 1 COL 11
     1385        B-Help AT ROW 1 COL 95
     1386        rs-method AT ROW 4 COL 2 NO-LABEL WIDGET-ID 48
     1387        rs-action AT ROW 4.2 COL 75.5 NO-LABEL WIDGET-ID 44
     1388        v-list-id AT ROW 7.4 COL 19 COLON-ALIGNED WIDGET-ID 64
     1389        b-lob-sel AT ROW 7.4 COL 33 WIDGET-ID 62
     1390        e-shops AT ROW 9 COL 39 NO-LABEL WIDGET-ID 54
     1391        SelectObject AT ROW 10.07 COL 4.5 NO-LABEL WIDGET-ID 58
     1392        button-obj AT ROW 11.4 COL 34 WIDGET-ID 52
     1393        BR-rcp AT ROW 16.97 COL 1 WIDGET-ID 100
     1394        f-list-name AT ROW 7.4 COL 35 COLON-ALIGNED NO-LABEL WIDGET-ID 66
     1395        "Объекты для пересылки" VIEW-AS TEXT
     1396             SIZE 33.5 BY 1.07 AT ROW 9 COL 4 WIDGET-ID 72
     1397             FGCOLOR 4
     1398        "Метод формирования списка товаров" VIEW-AS TEXT
     1399             SIZE 46 BY .8 AT ROW 2.87 COL 2 WIDGET-ID 68
     1400             FGCOLOR 4
     1401        "Действие" VIEW-AS TEXT
     1402             SIZE 12 BY 1 AT ROW 2.6 COL 75 WIDGET-ID 70
     1403             FGCOLOR 4
     1404        rct-obj AT ROW 8.73 COL 2 WIDGET-ID 56
     1405        SPACE(18.00) SKIP(10.25)
     1406       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1407            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1408            TITLE ""
     1409            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
     1410   ASSIGN
     1411          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1412          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1413   ASSIGN
     1414          BR-rcp:HIDDEN  IN FRAME Dialog-Frame                = TRUE.
     1415   ASSIGN
     1416          e-shops:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     1417   ASSIGN
     1418          v-list-id:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     1419   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1420   DO:
     1421     APPLY "END-ERROR":U TO SELF.
     1422   END.
     1423   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
     1424   DO:
     1425     RUN proc-save IN THIS-PROCEDURE  NO-ERROR.
     1426     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1427   END.
     1428   ON CHOOSE OF b-lob-sel IN FRAME Dialog-Frame
     1429   DO:
     1430   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     1431   DEFINE BUFFER buf_clob-bind FOR ub.clob-bind.
     1432   ASSIGN
     1433   rs-method.
     1434   run ref/clobbnds.w ( input parparentproc
     1435                       ,input this-procedure:handle
     1436                       ,input 'b-sel,b-add,managed'
     1437                       ,input "uniq-key-rec"
     1438                       ,input ""
     1439                       ,input rs-method
     1440                       ,input 'gds-list'
     1441                       ,input -1
     1442                       ,input-output v-rid-list) no-error.
     1443   if v-rid-list = '' then do:
     1444    return NO-apply.
     1445   end.
     1446   find first buf_clob-bind no-lock where
     1447             recid(buf_clob-bind) = integer(v-rid-list) .
     1448    v-list-id = buf_clob-bind.field-name_.
     1449    f-list-name = buf_clob-bind.descr.
     1450    DISPlay
     1451    f-list-name
     1452    v-list-id WITH FRAME Dialog-Frame.
     1453   END.
     1454   ON CHOOSE OF button-obj IN FRAME Dialog-Frame
     1455   DO:
     1456     define variable v-old-selectobject as integer no-undo .
     1457     assign
     1458     v-old-selectobject = SelectObject
     1459     SelectObject.
     1460     run select-objects-proc in this-procedure ( v-save-objects ) no-error.
     1461     if error-status:error then do:
     1462       assign
     1463       selectobject = v-old-selectobject
     1464       .
     1465       display
     1466       selectobject
     1467       with frame Dialog-Frame .
     1468     end.
     1469   END.
     1470   ON VALUE-CHANGED OF rs-method IN FRAME Dialog-Frame
     1471   DO:
     1472     ASSIGN
     1473     rs-method.
     1474     v-list-id = ''.
     1475     DISPLAY
     1476     v-list-id WITH FRAME Dialog-Frame.
     1477   END.
     1478   ON VALUE-CHANGED OF SelectObject IN FRAME Dialog-Frame
     1479   DO:
     1480     if selectObject <> integer(selectobject:screen-value) then do:
     1481   v-save-objects = no.
     1482     end.
     1483     Assign SelectObject.
     1484   run select-objects-proc in this-procedure ( input v-save-objects).
     1485   run val-obj in this-procedure .
     1486   END.
     1487   ON ROW-DISPLAY OF br-rcp IN frame Dialog-Frame
     1488   DO:
     1489     IF AVAIL tt-rule-call-param THEN DO:
     1490       RUN rcps_set-row-color IN THIS-PROCEDURE ( INPUT term_tt-rule-call-param.param-data-type).
     1491     END.
     1492   END.
     1493   ON f6 anywhere DO:
     1494     ASSIGN
     1495     br-rcp:VISIBLE IN FRAME Dialog-Frame = (NOT br-rcp:VISIBLE IN FRAME Dialog-Frame)
     1496     .
     1497   END.
     1498   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1499   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1500   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1501   on help of frame Dialog-Frame
     1502   do:
     1503     run gbl/app_help.p
     1504       (input this-procedure :file-name
     1505       ,input ''
     1506       ,input ?
     1507       ) no-error.
     1508     if error-status :error then do:
     1509       message
     1510         "Ошибка при вызове помощи"
     1511         error-status :get-message(1)
     1512         view-as alert-box .
     1513     end.
     1514   end.
     1515   run minbtn-set in this-procedure .
     1516   on choose of b-help in frame Dialog-Frame
     1517   do:
     1518     apply "help":u to frame Dialog-Frame .
     1519   end.
     1520   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1521   procedure minbtn-set :
     1522       do
     1523           on error undo, return error return-value
     1524           :
     1525           define variable ii              as integer       no-undo .
     1526           define variable fh              as widget-handle no-undo .
     1527           define variable hh              as widget-handle no-undo .
     1528           define variable v-h             as handle        extent 4 no-undo .
     1529           define variable v-name-button   as character     no-undo .
     1530           define variable v-help-old-x    as decimal       no-undo .
     1531           define variable v-help-old-y    as decimal       no-undo .
     1532           define variable v-help-old-size as decimal       no-undo .
     1533           define variable v-frame-width   as decimal       no-undo .
     1534           define variable jj              as integer       no-undo .
     1535           do
     1536               on error undo, return error
     1537               :
     1538               assign
     1539                   v-frame-width = frame Dialog-Frame:width - 0.3
     1540                   fh            = frame Dialog-Frame:first-child
     1541                   hh            = fh:first-child
     1542                   ii            = 1
     1543                   .
     1544               do while valid-handle(hh):
     1545                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1546                   do:
     1547                       case lc(hh:name) :
     1548                           when "b-help" then
     1549                               do:
     1550                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1551                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1552                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1553                                   hh:TOOLTIP = "Помощь" .
     1554                                   v-help-old-x = hh:column .
     1555                                   v-help-old-y = hh:row    .
     1556                                   v-help-old-size = hh:width .
     1557                                   hh:width-chars = 2.5 .
     1558                               end.
     1559                           when "b-print" then
     1560                               do:
     1561                                   hh:load-image("cmp/b-print.bmp":u) .
     1562                                   hh:TOOLTIP = "Печать" .
     1563                                   v-h[ii] = hh:handle .
     1564                                   ii = ii + 1 .
     1565                                   hh:width-chars = 3 .
     1566                               end.
     1567                           when "b-history" or
     1568                           when "b-hist" then
     1569                               do:
     1570                                   hh:load-image("cmp/b-hist.bmp":u) .
     1571                                   hh:TOOLTIP = "История" .
     1572                                   v-h[ii] = hh:handle .
     1573                                   ii = ii + 1 .
     1574                                   hh:width-chars = 3 .
     1575                               end.
     1576                           when "b-sch" then
     1577                               do:
     1578                                   hh:load-image("cmp/b-sch.bmp":u) .
     1579                                   hh:TOOLTIP = "Установка Фильтра" .
     1580                                   v-h[ii] = hh:handle .
     1581                                   ii = ii + 1 .
     1582                                   hh:width-chars = 3 .
     1583                               end.
     1584                           when "b-hist-user" then
     1585                               do:
     1586                                   hh:load-image("cmp/b-hist.bmp":u) .
     1587                                   hh:TOOLTIP = "История пользователя" .
     1588                                   ii = ii + 1 .
     1589                               end.
     1590                       end case.
     1591                   end.
     1592                   hh = hh:next-sibling.
     1593               end.
     1594               b-help:column = v-frame-width - b-help:width-chars.
     1595               jj = 0.
     1596               repeat ii = 4 to 1 by -1 :
     1597                   if valid-handle (v-h[ii] ) then
     1598                   do:
     1599                       jj  = jj + 1 .
     1600                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1601                       v-h[ii]:row    = v-help-old-y .
     1602                   end.
     1603               end.
     1604           end.
     1605       end.
     1606   end procedure.
     1607   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1608   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1609   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1610   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1611   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1612   define variable v-diasize-current-frame-height as decimal   no-undo .
     1613   define variable v-diasize-change-size          as logical   no-undo .
     1614   define variable v-diasize-resize-button        as handle    no-undo .
     1615   define variable v-diasize-wndmax               as logical   no-undo .
     1616   define variable v-diasize-wndstore             as logical   no-undo .
     1617   define variable v-diasize-proc-name            as character no-undo .
     1618   define variable v-diasize-browse-handle        as handle    no-undo .
     1619   define variable v-diasize-browse-number        as integer   no-undo .
     1620   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1621   define temp-table temp-diasize-handle no-undo
     1622     field handle-value  as handle
     1623     field save-position as decimal
     1624     index xpk is primary unique handle-value
     1625     .
     1626   define temp-table temp-browse-handle no-undo
     1627     field browse-type   as character
     1628     field browse-number as integer
     1629     field browse-handle as handle
     1630     field original-size as decimal
     1631     index xpk is primary unique browse-type browse-number
     1632     index xie browse-type browse-handle
     1633   .
     1634   procedure diasize_change-height :
     1635     define input  parameter p-change-value  as decimal   no-undo .
     1636     define input  parameter p-move-resize   as logical   no-undo .
     1637     define variable v-field-group-handle    as handle    no-undo .
     1638     define variable v-object-handle         as handle    no-undo .
     1639     define variable v-frame-height          as decimal   no-undo .
     1640     define variable v-frame-virtual-height  as decimal   no-undo .
     1641     define variable v-browse-height         as decimal   no-undo .
     1642     define variable v-window-height         as decimal   no-undo .
     1643     define variable v-window-virtual-height as decimal   no-undo .
     1644     define variable v-change-sign           as integer   no-undo .
     1645     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1646     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1647     if p-change-value > 0
     1648     then do:
     1649       if frame Dialog-Frame :height + p-change-value
     1650           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1651       then do:
     1652         assign
     1653           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1654                           - (frame Dialog-Frame :height-chars)
     1655         .
     1656         if p-change-value <= 0
     1657         then do:
     1658           run diasize_position-resize-button in this-procedure .
     1659           return .
     1660         end.
     1661       end.
     1662     end.
     1663     if p-change-value < 0
     1664     then do:
     1665       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1666       then do:
     1667         assign
     1668           p-change-value = v-diasize-orig-frame-height
     1669                          - (frame Dialog-Frame :height-chars)
     1670         .
     1671         if p-change-value >= 0
     1672         then do:
     1673           run diasize_position-resize-button in this-procedure .
     1674           return .
     1675         end.
     1676       end.
     1677     end.
     1678     if p-change-value >= 0
     1679     then do:
     1680       assign
     1681         v-change-sign = 1
     1682       .
     1683     end.
     1684     else do:
     1685       assign
     1686         v-change-sign = -1
     1687       .
     1688     end.
     1689     assign
     1690       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1691     .
     1692     if p-change-value = 0
     1693     then do:
     1694       run diasize_position-resize-button in this-procedure .
     1695       return .
     1696     end.
     1697     move_block:
     1698     do
     1699     on error undo move_block, retry move_block
     1700     :
     1701       if retry
     1702       then do:
     1703         do
     1704         on error undo move_block, leave move_block
     1705         :
     1706           if p-change-value > 0
     1707           then do:
     1708             for each buf_temp-diasize-handle
     1709             on error undo, next
     1710             :
     1711               assign
     1712                 v-object-handle = buf_temp-diasize-handle.handle-value
     1713               .
     1714               if v-object-handle <> v-diasize-resize-button
     1715               then do:
     1716                 assign
     1717                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1718                 .
     1719               end.
     1720             end.
     1721             assign
     1722               v-diasize-browse-handle :height = v-browse-height
     1723             .
     1724             for each buf_temp-browse-handle
     1725               where buf_temp-browse-handle.browse-type = 'height':u
     1726             on error undo, next
     1727             :
     1728               assign
     1729                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1730               .
     1731             end.
     1732             assign
     1733               frame Dialog-Frame :height = v-frame-height
     1734             .
     1735             if frame Dialog-Frame :scrollable = true
     1736             then do:
     1737               assign
     1738                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1739               .
     1740             end.
     1741             run diasize_position-resize-button in this-procedure .
     1742           end.
     1743           else do:
     1744             if frame Dialog-Frame :scrollable = true
     1745             then do:
     1746               assign
     1747                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1748               .
     1749             end.
     1750             assign
     1751               frame Dialog-Frame :height = v-frame-height
     1752             .
     1753             assign
     1754               v-diasize-browse-handle :height = v-browse-height
     1755             .
     1756             for each buf_temp-browse-handle
