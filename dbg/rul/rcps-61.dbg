     3761   rs-action
     3762   rs-method
     3763   selectobject WHEN (p-mode <> 'ПРОСМОТР':U and v-running-mode)
     3764   button-obj  WHEN (p-mode <> 'ПРОСМОТР':U and v-running-mode)
     3765   b-lob-sel  WHEN p-mode <> 'ПРОСМОТР':U
     3766   e-shops
     3767   WITH FRAME Dialog-Frame.
     3768   VIEW FRAME Dialog-Frame.
     3769   IF p-mode = 'ПРОСМОТР':U THEN DO:
     3770      ASSIGN
     3771      b-quit:COLUMN = 1
     3772      b-quit:LABEL = "&Выход".
     3773      HIDE
     3774      b-exit
     3775      IN FRAME Dialog-Frame.
     3776   END.
     3777   ASSIGN
     3778   FRAME Dialog-Frame:TITLE = substitute("Параметры передачи/удаления на кассу/с кассы списка товаров по профайлу &1", p-profile-id).
     3779   APPLY "ENTRY" to e-shops.
     3780   APPLY "CTRL-HOME" to e-shops.
     3781   END PROCEDURE.
     3782   PROCEDURE proc-save :
     3783   define variable v-ii as integer   no-undo .
     3784   assign
     3785   frame Dialog-Frame
     3786   rs-action
     3787   rs-method
     3788   v-list-id
     3789   selectobject
     3790   .
     3791   RUN rcps_set-value IN THIS-PROCEDURE (
     3792                                   INPUT p-profile-id
     3793                                   ,INPUT p-once-more
     3794                                   ,INPUT p-call-id
     3795                                   ,INPUT "p-method"
     3796                                   ,INPUT 0
     3797                                   ,INPUT rs-method
     3798                                   ,INPUT ?
     3799                                   ,INPUT 0.0
     3800                                   ,INPUT 0
     3801                                   ,INPUT NO
     3802                                   ).
     3803   case rs-method:
     3804     when 'list':U then do:
     3805       RUN rcps_set-value IN THIS-PROCEDURE (
     3806                                       INPUT p-profile-id
     3807                                       ,INPUT p-once-more
     3808                                       ,INPUT p-call-id
     3809                                       ,INPUT "p-list"
     3810                                       ,INPUT 0
     3811                                       ,INPUT substitute("gds-list_&1", v-list-id)
     3812                                       ,INPUT ?
     3813                                       ,INPUT 0.0
     3814                                       ,INPUT 0
     3815                                       ,INPUT NO
     3816                                       ).
     3817       RUN rcps_set-value IN THIS-PROCEDURE (
     3818                                       INPUT p-profile-id
     3819                                       ,INPUT p-once-more
     3820                                       ,INPUT p-call-id
     3821                                       ,INPUT "p-list-macro"
     3822                                       ,INPUT 0
     3823                                       ,INPUT "_"
     3824                                       ,INPUT ?
     3825                                       ,INPUT 0.0
     3826                                       ,INPUT 0
     3827                                       ,INPUT NO
     3828                                       ).
     3829     end.
     3830     when 'list-macro':U then do:
     3831       RUN rcps_set-value IN THIS-PROCEDURE (
     3832                                       INPUT p-profile-id
     3833                                       ,INPUT p-once-more
     3834                                       ,INPUT p-call-id
     3835                                       ,INPUT "p-list-macro"
     3836                                       ,INPUT 0
     3837                                       ,INPUT substitute("gds-list_&1", v-list-id)
     3838                                       ,INPUT ?
     3839                                       ,INPUT 0.0
     3840                                       ,INPUT 0
     3841                                       ,INPUT NO
     3842                                       ).
     3843       RUN rcps_set-value IN THIS-PROCEDURE (
     3844                                       INPUT p-profile-id
     3845                                       ,INPUT p-once-more
     3846                                       ,INPUT p-call-id
     3847                                       ,INPUT "p-list"
     3848                                       ,INPUT 0
     3849                                       ,INPUT "_"
     3850                                       ,INPUT ?
     3851                                       ,INPUT 0.0
     3852                                       ,INPUT 0
     3853                                       ,INPUT NO
     3854                                       ).
     3855     end.
     3856   end case.
     3857   RUN rcps_set-value IN THIS-PROCEDURE (
     3858                                   INPUT p-profile-id
     3859                                   ,INPUT p-once-more
     3860                                   ,INPUT p-call-id
     3861                                   ,INPUT "p-action"
     3862                                   ,INPUT 0
     3863                                   ,INPUT rs-action
     3864                                   ,INPUT ?
     3865                                   ,INPUT 0.0
     3866                                   ,INPUT 0
     3867                                   ,INPUT NO
     3868                                   ).
     3869   case selectobject:
     3870     when integer(string(-1)) then do:
     3871      v-ii = 0.
     3872      for each obj-list :
     3873       v-ii = v-ii + 1.
     3874       RUN rcps_set-value IN THIS-PROCEDURE (
     3875                                       INPUT p-profile-id
     3876                                       ,INPUT p-once-more
     3877                                       ,INPUT p-call-id
     3878                                       ,INPUT "p-shops"
     3879                                       ,INPUT v-ii
     3880                                       ,INPUT ''
     3881                                       ,INPUT ?
     3882                                       ,INPUT 0.0
     3883                                       ,INPUT obj-list.obj-code
     3884                                       ,INPUT NO
     3885                                       ).
     3886      end.
     3887       RUN rcps_set-value IN THIS-PROCEDURE (
     3888                                       INPUT p-profile-id
     3889                                       ,INPUT p-once-more
     3890                                       ,INPUT p-call-id
     3891                                       ,INPUT "p-host-code"
     3892                                       ,INPUT 0
     3893                                       ,INPUT ''
     3894                                       ,INPUT ?
     3895                                       ,INPUT 0.0
     3896                                       ,INPUT 0
     3897                                       ,INPUT NO
     3898                                       ).
     3899     end.
     3900     when integer(string(0)) then do:
     3901       for each obj-list:
     3902         delete obj-list.
     3903       end.
     3904       RUN rcps_set-value IN THIS-PROCEDURE (
     3905                                       INPUT p-profile-id
     3906                                       ,INPUT p-once-more
     3907                                       ,INPUT p-call-id
     3908                                       ,INPUT "p-host-code"
     3909                                       ,INPUT 0
     3910                                       ,INPUT ''
     3911                                       ,INPUT ?
     3912                                       ,INPUT 0.0
     3913                                       ,INPUT 0
     3914                                       ,INPUT NO
     3915                                       ).
     3916     end.
     3917   end case.
     3918   v-ii = v-ii + 1.
     3919   do while true:
     3920     run rcps_proc-b-del in this-procedure  (
     3921                                            INPUT p-profile-id
     3922                                           ,INPUT p-once-more
     3923                                           ,INPUT p-call-id
     3924                                           ,input "p-shops"
     3925                                           ,input v-ii) no-error.
     3926     if error-status:error
     3927     or return-value = "not-found" then leave.
     3928     v-ii = v-ii + 1.
     3929   end.
     3930   run rcps_proc-save0 in this-procedure .
     3931   END PROCEDURE.
     3932   PROCEDURE select-objects-proc :
     3933   define input parameter p-save-objects as logical no-undo .
     3934   define variable v-ii as integer   no-undo .
     3935   define variable v-rid-list as character no-undo .
     3936   define variable glog AS LOGICAL no-undo .
     3937   define variable v-obj-db-num as integer no-undo .
     3938   define buffer buf_sysconf for ub.sysconf.
     3939   define buffer buf_shop for ub.shop.
     3940   ASSIGN
     3941   e-shops:SCREEN-VALUE IN FRAME Dialog-Frame = ''.
     3942   case selectobject :
     3943     when integer(string(0)) then   do:
     3944       for each obj-list :
     3945         delete obj-list.
     3946       end.
     3947       if v-running-mode then do:
     3948         for each buf_shop no-lock:
     3949   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3950   run create_obj-list in this-procedure
     3951    ( input 'маг':U ,
     3952      input buf_shop.obj-code )
     3953      .
     3954   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3955   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     3956     (input  'маг':U
     3957     ,input  buf_shop.obj-code
     3958     ,output v-obj-db-num
     3959     )  .
     3960           if v-obj-db-num = v-cntxt-db-num then do:
     3961             find first obj-list where
     3962                   obj-list.obj-code = buf_shop.obj-code
     3963                 and obj-list.obj-type = 'маг':U.
     3964             glog = e-shops:INSERT-STRING ( display-shop(
     3965                                                         buf_shop.obj-code
     3966                                                         , obj-list.obj-name )) in frame Dialog-Frame .
     3967             glog = e-shops:INSERT-STRING ( chr(10) ) in frame Dialog-Frame .
     3968           end.
     3969         end.
     3970       end.
     3971     end.
     3972     when integer(string(-1)) then do:
     3973       for each obj-list :
     3974         if p-save-objects then do:
     3975           find first buf_shop no-lock where
     3976                     buf_shop.obj-code = obj-list.obj-code no-error.
     3977           if available buf_shop then do:
     3978             v-rid-list = v-rid-list + (if v-rid-list = '' then '' else chr(44)) + string(recID(BUF_SHOP)).
     3979           end.
     3980         end.
     3981         delete obj-list.
     3982       end.
     3983       v-save-objects = yes.
     3984       run adm/shops.w ( input parparentproc
     3985                         ,input "b-sel,b-mark"
     3986                         ,input-output v-rid-list
     3987                         ,no ) no-error.
     3988       if v-rid-list <> '' then do:
     3989         do v-ii = 1 to num-entries(v-rid-list):
     3990           find first buf_shop no-lock where
     3991                     recid(buf_shop) = integer(entry(v-ii, v-rid-list)) no-error.
     3992           if available buf_shop then do:
     3993   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3994   run create_obj-list in this-procedure
     3995    ( input 'маг':U ,
     3996      input buf_shop.obj-code )
     3997      .
     3998   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3999   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     4000     (input  'маг':U
     4001     ,input  buf_shop.obj-code
     4002     ,output v-obj-db-num
     4003     )  .
     4004             if v-obj-db-num <> v-cntxt-db-num then do:
     4005               message
     4006               substitute("&1&2принадлежит другой БД - пропускаю ...", 'маг':U, buf_shop.obj-code)
     4007               view-as alert-box .
     4008               next.
     4009             end.
     4010             find first obj-list where
     4011                   obj-list.obj-code = buf_shop.obj-code
     4012                and obj-list.obj-type = 'маг':U.
     4013             glog = e-shops:INSERT-STRING ( display-shop(
     4014                                                        buf_shop.obj-code
     4015                                                        , obj-list.obj-name )) in frame Dialog-Frame .
     4016              glog = e-shops:INSERT-STRING ( chr(10) ) in frame Dialog-Frame .
     4017           end.
     4018         end.
     4019       end.
     4020       else do:
     4021         undo, return error .
     4022       end.
     4023     end.
     4024   end case.
     4025   END PROCEDURE.
     4026   PROCEDURE val-obj :
     4027   If SelectObject:SCREEN-VALUE IN FRAME Dialog-Frame = STRING(string(-1))
     4028    THEN  do:
     4029     enable
     4030     BUTTON-obj
     4031     with frame Dialog-Frame .
     4032   end.
     4033   else do:
     4034     Disable
     4035     BUTTON-obj
     4036     with frame Dialog-Frame .
     4037   end.
     4038   END PROCEDURE.
