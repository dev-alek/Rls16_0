     3265   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3266   PROCEDURE rcps_MyEnable0 :
     3267   DEFINE VARIABLE v-ii AS INTEGER NO-UNDO.
     3268   DEFINE VARIABLE v-ch0 AS widget-handle NO-UNDO.
     3269   ASSIGN
     3270   term_tt-rule-call-param.param-label:RESIZABLE IN browse br-rcp = YES
     3271   X_rp-rule-param.rp-param-name:RESIZABLE IN browse br-rcp = YES
     3272   .
     3273   ASSIGN
     3274   v-ch0 = br-rcp:FIRST-COLUMN IN FRAME Dialog-Frame.
     3275   REPEAT WHILE valid-handle(v-ch0):
     3276      IF v-ch0:LABEL = "Значение!(строковое)" THEN DO:
     3277        v-ch[1] = v-ch0.
     3278        v-ch0:VISIBLE = NO.
     3279      END.
     3280      IF v-ch0:LABEL = "Значение!(Дата)" THEN DO:
     3281        v-ch[2] = v-ch0.
     3282        v-ch0:VISIBLE = NO.
     3283      END.
     3284      IF v-ch0:LABEL = "Значение!(Десятичное)" THEN DO:
     3285        v-ch[3] = v-ch0.
     3286        v-ch0:VISIBLE = NO.
     3287      END.
     3288      IF v-ch0:LABEL = "Значение!(Целое)" THEN DO:
     3289        v-ch[4] = v-ch0.
     3290        v-ch0:VISIBLE = NO.
     3291      END.
     3292      IF v-ch0:LABEL = "Значение!(Логическое)" THEN DO:
     3293        v-ch[5] = v-ch0.
     3294        v-ch0:VISIBLE = NO.
     3295      END.
     3296      IF v-ch0:LABEL = "Точка вызова" THEN DO:
     3297        v-ch[6] = v-ch0.
     3298      END.
     3299      IF v-ch0:LABEL = "Значение" THEN
     3300      v-ch0:RESIZABLE = YES.
     3301      v-ch0 = v-ch0:NEXT-COLUMN.
     3302   END.
     3303   assign
     3304   X_rp-rule-param.rp-param-name:resizable in browse br-rcp = yes
     3305   term_tt-rule-call-param.param-name:resizable in browse br-rcp = yes
     3306   term_tt-rule-call-param.param-label:resizable in browse br-rcp = yes
     3307   .
     3308   CASE p-list-mode:
     3309     WHEN 'rule-call-param':U THEN DO:
     3310        ASSIGN
     3311        X_rp-rule-param.rp-param-name:VISIBLE IN BROWSE br-rcp = NO
     3312        .
     3313     END.
     3314     WHEN 'rp-rule-param':U
     3315     or
     3316     when 'rp-rule-param':U + chr(44) + 'все':U
     3317     THEN DO:
     3318       assign
     3319       term_tt-rule-call-param.codex_id:VISIBLE IN BROWSE br-rcp = NO
     3320       term_tt-rule-call-param.ruleset_id:VISIBLE IN BROWSE br-rcp = NO
     3321       term_tt-rule-call-param.rule_id:VISIBLE IN BROWSE br-rcp = NO
     3322       term_tt-rule-call-param.order_id:VISIBLE IN BROWSE br-rcp = NO
     3323       term_tt-rule-call-param.param-name:VISIBLE IN BROWSE br-rcp = NO
     3324       term_tt-rule-call-param.param-num:VISIBLE IN BROWSE br-rcp = NO
     3325       .
     3326     END.
     3327   END CASE.
     3328    IF p-call-id <> '':U THEN DO:
     3329      v-ch[6]:VISIBLE = NO.
     3330    END.
     3331     IF p-profile-id <> 0 THEN DO:
     3332      term_tt-rule-call-param.profile_id :VISIBLE IN BROWSE br-rcp= NO.
     3333    END.
     3334     IF p-rule-id <> 0 THEN DO:
     3335      term_tt-rule-call-param.RULE_id :VISIBLE IN BROWSE br-rcp= NO.
     3336    END.
     3337     IF p-once-more <> 0 THEN DO:
     3338      term_tt-rule-call-param.once-more :VISIBLE IN BROWSE br-rcp= NO.
     3339    END.
     3340   END PROCEDURE.
     3341   PROCEDURE rcps_Openbr :
     3342   CASE p-list-mode:
     3343     WHEN 'rp-rule-param':U THEN DO:
     3344         OPEN QUERY br-rcp
     3345         FOR EACH  X_ruledict-param NO-LOCK WHERE X_ruledict-param.entry-id = v-rcps-entry-id
     3346             ,FIRST X_rp-rule-param WHERE
     3347                 X_rp-rule-param.profile_id = p-profile-id
     3348             AND X_rp-rule-param.rp-param-name = X_ruledict-param.param-name
     3349           , first tt-rule-call-param WHERE
     3350              tt-rule-call-param.codex_id = X_rp-rule-param.codex_id
     3351          AND tt-rule-call-param.ruleset_id = X_rp-rule-param.ruleset_id
     3352          AND tt-rule-call-param.rule_id = X_rp-rule-param.rule_id
     3353          AND tt-rule-call-param.param-name = X_rp-rule-param.rule-param-name
     3354            ,each term_tt-rule-call-param where
     3355                  term_tt-rule-call-param.call_id = tt-rule-call-param.call_id
     3356              and term_tt-rule-call-param.codex_id = tt-rule-call-param.codex_id
     3357              and term_tt-rule-call-param.ruleset_id = tt-rule-call-param.ruleset_id
     3358              and term_tt-rule-call-param.order_id = tt-rule-call-param.order_id
     3359              and term_tt-rule-call-param.param-name = tt-rule-call-param.param-name
     3360         BY tt-rule-call-param.call_id
     3361         BY tt-rule-call-param.codex_id
     3362         BY tt-rule-call-param.ruleset_id
     3363         BY tt-rule-call-param.order_id
     3364         BY tt-rule-call-param.param-num.
     3365     END.
     3366   END CASE.
     3367   apply "ENTRY" to br-rcp in frame Dialog-Frame .
     3368   APPLy "VALUE-CHANGED" to br-rcp.
     3369   END PROCEDURE.
     3370   PROCEDURE rcps_proc-b-chg PRIVATE :
     3371   DEFINE VARIABLE v-rec1 AS Rowid NO-UNDO.
     3372   DEFINE VARIABLE v-rec2 AS Rowid NO-UNDO.
     3373   DEFINE VARIABLE v-rec3 AS Rowid NO-UNDO.
     3374   DEFINE VARIABLE v-rec4 AS Rowid NO-UNDO.
     3375   define variable v-param-data-type as character no-undo .
     3376   define variable v-rid-list as character no-undo .
     3377   IF NOT AVAILABLE TERM_tt-rule-call-param  THEN DO:
     3378     RETURN ERROR.
     3379   END.
     3380   ASSIGN
     3381   v-rec1 = rowid(X_ruledict-param)
     3382   v-rec2 = rowid(X_rp-rule-param)
     3383   v-rec3 = Rowid(tt-rule-call-param)
     3384   v-rec4 = Rowid(term_tt-rule-call-param)
     3385   .
     3386   run rcps_openbr in this-procedure .
     3387   REPOSITION br-rcp TO Rowid v-rec1, v-rec2,v-rec3, v-rec4 NO-ERROR.
     3388   IF ERROR-STATUS:ERROR THEN DO:
     3389     REPOSITION br-rcp TO ROW 1 NO-ERROR.
     3390   END.
     3391   APPLY "ENTRY" TO br-rcp in frame Dialog-Frame .
     3392   APPLY "VALUE-CHANGED" TO br-rcp in frame Dialog-Frame .
     3393   END PROCEDURE.
     3394   PROCEDURE rcps_set-row-color :
     3395   DEFINE INPUT PARAMETER p-data-type AS CHARACTER NO-UNDO.
     3396   ASSIGN
     3397   v-ch[1]:FGCOLOR = GREY_COLOR
     3398   v-ch[1]:BGCOLOR = GREY_Color
     3399   v-ch[1]:PFCOLOR = GREY_Color
     3400   v-ch[2]:FGCOLOR = GREY_COLOR
     3401   v-ch[2]:BGCOLOR = GREY_Color
     3402   v-ch[2]:PFCOLOR = GREY_Color
     3403   v-ch[3]:FGCOLOR = GREY_COLOR
     3404   v-ch[3]:BGCOLOR = GREY_Color
     3405   v-ch[3]:PFCOLOR = GREY_Color
     3406   v-ch[4]:FGCOLOR = GREY_COLOR
     3407   v-ch[4]:BGCOLOR = GREY_Color
     3408   v-ch[4]:PFCOLOR = GREY_Color
     3409   v-ch[5]:FGCOLOR = GREY_COLOR
     3410   v-ch[5]:BGCOLOR = GREY_Color
     3411   v-ch[5]:PFCOLOR = GREY_Color
     3412   .
     3413   CASE entry(1, p-data-type):
     3414        WHEN 'character':U THEN DO:
     3415         ASSIGN
     3416         v-ch[1]:FGCOLOR = BLACK_COLOR
     3417         v-ch[1]:BGCOLOR = WHITE_Color.
     3418       END.
     3419       WHEN 'decimal':U THEN DO:
     3420         ASSIGN
     3421         v-ch[3]:FGCOLOR = BLACK_COLOR
     3422         v-ch[3]:BGCOLOR = WHITE_Color.
     3423       END.
     3424       WHEN 'integer':U THEN DO:
     3425         ASSIGN
     3426         v-ch[4]:FGCOLOR = BLACK_COLOR
     3427         v-ch[4]:BGCOLOR = WHITE_Color.
     3428       END.
     3429       WHEN 'date':U THEN DO:
     3430         ASSIGN
     3431         v-ch[2]:FGCOLOR = BLACK_COLOR
     3432         v-ch[2]:BGCOLOR = WHITE_Color.
     3433        END.
     3434        WHEN 'logical':U THEN DO:
     3435          ASSIGN
     3436          v-ch[5]:FGCOLOR = BLACK_COLOR
     3437          v-ch[5]:BGCOLOR = WHITE_Color.
     3438        END.
     3439   END CASE.
     3440   END PROCEDURE.
     3441   MAIN-BLOCK:
     3442   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3443      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3444   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3445     run mainmenu_getcntxt in parparentproc
     3446       (output v-cntxt-db-num
     3447       ,output v-cntxt-userid
     3448       ,output v-cntxt-level
     3449       ,output v-cntxt-host-code-obj
     3450       ,output v-cntxt-obj-type
     3451       ,output v-cntxt-obj-code
     3452       ,output v-cntxt-db-num-obj
     3453       ,output v-cntxt-is-admin
     3454       ) .
     3455      run gbl/dftempl.p ( input 'rp-rule-param':U
     3456                        , output v-dflt-rec) no-error.
     3457       if error-status:error then dO:
     3458         message
     3459         vss-workfile vss-revision vss-description skip
     3460         "Невозможно найти recid template записи в таблице rp-rule-param"
     3461         view-as alert-box error .
     3462         return error.
     3463       end.
     3464       run gbl/dftempl.p ( input 'ruledict-param':U
     3465                         , output v-rp-dflt-rec) no-error.
     3466        if error-status:error then dO:
     3467          message
     3468          vss-workfile vss-revision vss-description skip
     3469          "Невозможно найти recid template записи в таблице ruledict-param"
     3470          view-as alert-box error .
     3471          return error.
     3472        end.
     3473     IF p-list-mode = 'rp-rule-param':U
     3474     THEN DO:
     3475       FIND FIRST buf_rule-profile NO-LOCK WHERE
     3476                 buf_rule-profile.profile_id = p-profile-id.
     3477       run gen-key-rec in this-procedure ( input 'rule-profile':U
     3478                                       ,input buffer buf_rule-profile:handle
     3479                                       ,output v-uniq-key-rec).
     3480       FIND FIRST buf_ruledict NO-LOCK WHERE
     3481                 buf_ruledict.entry-type = 'rule-profile':U
     3482          AND  buf_ruledict.uniq-key-rec = v-uniq-key-rec.
     3483       v-rcps-entry-id = buf_ruledict.entry-id.
     3484     END.
     3485     ELSE DO:
     3486        MESSAGE
     3487        substitute("Неверное значение параметра p-list-mode=&1", p-list-mode)
     3488        VIEW-AS alert-box.
     3489     END.
     3490     if lookup("cb_thbjrumr_is-running", this-procedure:instantiating-procedure:internal-entries) > 0 then do:
     3491     define variable v-cbh as handle no-undo .
     3492        v-cbh = this-procedure:instantiating-procedure .
     3493       run cb_thbjrumr_is-running in v-cbh ( output v-running-mode) no-error.
     3494     end.
     3495     if p-call-id begins 'schedule':U then do:
     3496       v-running-mode = yes.
     3497     end.
     3498     RUN rcps_fill-table IN THIS-PROCEDURE ( input yes).
     3499     RUN Myenable in THIS-PROCEDURE.
     3500     WAIT-FOR GO OF FRAME Dialog-Frame.
     3501   END.
     3502   RUN disable_UI.
     3503   PROCEDURE disable_UI :
     3504     HIDE FRAME Dialog-Frame.
     3505   END PROCEDURE.
     3506   PROCEDURE enable_UI :
     3507     DISPLAY rs-method rs-action v-list-id e-shops SelectObject f-list-name
     3508         WITH FRAME Dialog-Frame.
     3509     ENABLE B-exit b-quit B-Help rct-obj rs-method rs-action b-lob-sel
     3510            SelectObject button-obj BR-rcp f-list-name
     3511         WITH FRAME Dialog-Frame.
     3512     VIEW FRAME Dialog-Frame.
     3513   END PROCEDURE.
     3514   PROCEDURE MyEnable :
     3515   define variable v-list as character no-undo .
     3516   define variable glog as logical no-undo .
     3517   define variable v-index-id as integer no-undo .
     3518   define variable v-value-character as character no-undo .
     3519   define variable v-value-date as date no-undo .
     3520   define variable v-value-decimal as decimal no-undo .
     3521   define variable v-value-integer as integer no-undo .
     3522   define variable v-value-logical as logical no-undo .
     3523   define variable v-shop-code as integer no-undo .
     3524   define buffer buf_shop for ub.shop.
     3525   define buffer buf_clob-bind for ub.clob-bind.
     3526   run rcps_Myenable0 in this-procedure .
     3527   v-index-id = 0.
     3528   RUN rcps_get-value IN THIS-PROCEDURE (
     3529                                    INPUT p-profile-id
     3530                                   ,INPUT p-once-more
     3531                                   ,INPUT p-call-id
     3532                                   ,INPUT "p-list"
     3533                                   ,INPUT-output v-index-id
     3534                                   ,output v-list
     3535                                   ,output v-value-date
     3536                                   ,output v-value-decimal
     3537                                   ,output v-value-integer
     3538                                   ,output v-value-logical
     3539                                   ).
     3540   v-index-id = 0.
     3541   RUN rcps_get-value IN THIS-PROCEDURE (
     3542                                    INPUT p-profile-id
     3543                                   ,INPUT p-once-more
     3544                                   ,INPUT p-call-id
     3545                                   ,INPUT "p-list-macro"
     3546                                   ,INPUT-output v-index-id
     3547                                   ,output v-list-macro
     3548                                   ,output v-value-date
     3549                                   ,output v-value-decimal
     3550                                   ,output v-value-integer
     3551                                   ,output v-value-logical
     3552                                   ).
     3553   v-index-id = 0.
     3554   RUN rcps_get-value IN THIS-PROCEDURE (
     3555                                    INPUT p-profile-id
     3556                                   ,INPUT p-once-more
     3557                                   ,INPUT p-call-id
     3558                                   ,INPUT "p-method"
     3559                                   ,INPUT-output v-index-id
     3560                                   ,output rs-method
     3561                                   ,output v-value-date
     3562                                   ,output v-value-decimal
     3563                                   ,output v-value-integer
     3564                                   ,output v-value-logical
     3565                                   ).
     3566   v-index-id = 0.
     3567   RUN rcps_get-value IN THIS-PROCEDURE (
     3568                                    INPUT p-profile-id
     3569                                   ,INPUT p-once-more
     3570                                   ,INPUT p-call-id
     3571                                   ,INPUT "p-action"
     3572                                   ,INPUT-output v-index-id
     3573                                   ,output rs-action
     3574                                   ,output v-value-date
     3575                                   ,output v-value-decimal
     3576                                   ,output v-value-integer
     3577                                   ,output v-value-logical
     3578                                   ).
     3579   v-index-id = 0.
     3580   do while v-index-id >= 0 :
     3581     RUN rcps_get-value IN THIS-PROCEDURE (
     3582                                      INPUT p-profile-id
     3583                                     ,INPUT p-once-more
     3584                                     ,INPUT p-call-id
     3585                                     ,INPUT "p-shops"
     3586                                     ,INPUT-output v-index-id
     3587                                     ,output v-value-character
     3588                                     ,output v-value-date
     3589                                     ,output v-value-decimal
     3590                                     ,output v-shop-code
     3591                                     ,output v-value-logical
     3592                                     ) no-error .
     3593     if error-status:error then v-index-id = -1.
     3594     else do:
     3595   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3596   run create_obj-list in this-procedure
     3597    ( input 'маг':U ,
     3598      input v-shop-code )
     3599      .
     3600       find first obj-list where
     3601             obj-list.obj-code = v-shop-code
     3602           and obj-list.obj-type = 'маг':U no-error.
     3603       if available obj-list then do:
     3604         glog = e-shops:INSERT-STRING ( display-shop(v-shop-code
     3605                                                     ,obj-list.obj-name )) in frame Dialog-Frame .
     3606         glog = e-shops:INSERT-STRING ( chr(10) ) in frame Dialog-Frame .
     3607       end.
     3608     end.
     3609   end.
     3610   ASSIGN
     3611   term_tt-rule-call-param.param-label:RESIZABLE IN browse br-rcp = YES
     3612   X_rp-rule-param.rp-param-name:RESIZABLE IN browse br-rcp = YES
     3613   .
     3614   case rs-method:
     3615     when 'list':U then do:
     3616       if num-entries(v-list, "_") > 1 then do:
     3617         find first buf_clob-bind no-lock where
     3618                   buf_clob-bind.resource-type = rs-method
     3619               and buf_clob-bind.uniq-key-rec = "gds-list"
     3620               and buf_clob-bind.field-name_ = entry(2, v-list, "_") no-error.
     3621         if available buf_clob-bind then do:
     3622           f-list-name = buf_clob-bind.descr.
     3623           v-list-id = buf_clob-bind.field-name_.
     3624         end.
     3625       end.
     3626       else do:
     3627         v-list-id = ''.
     3628       end.
     3629     end.
     3630     when 'list-macro':U then do:
     3631       if num-entries(v-list-macro, "_") > 1 then do:
     3632         find first buf_clob-bind no-lock where
     3633                   buf_clob-bind.resource-type = rs-method
     3634               and buf_clob-bind.uniq-key-rec = "gds-list"
     3635               and buf_clob-bind.field-name_ = entry(2, v-list-macro, "_") no-error.
     3636         if available buf_clob-bind then do:
     3637           f-list-name = buf_clob-bind.descr.
     3638           v-list-id = buf_clob-bind.field-name_.
     3639         end.
     3640       end.
     3641       else do:
     3642         v-list-id = ''.
     3643       end.
     3644     end.
     3645   end case.
     3646   DISPlay
     3647   f-list-name
     3648   v-list-id WITH FRAME Dialog-Frame.
     3649   rs-method:radio-buttons in frame Dialog-Frame = 'Список':U + chr(44) + 'list':U + chr(44) +
     3650   'Макрос формир списка':U + chr(44) + 'list-macro':U .
     3651   DEFINE VARIABLE v-ch0 AS widget-handle NO-UNDO.
     3652   ASSIGN
     3653   v-ch0 = br-rcp:FIRST-COLUMN IN FRAME Dialog-Frame.
     3654   REPEAT WHILE valid-handle(v-ch0):
     3655      IF v-ch0:LABEL = "Значение!(строковое)" THEN DO:
     3656        v-ch[1] = v-ch0.
     3657        v-ch0:VISIBLE = NO.
     3658      END.
     3659      IF v-ch0:LABEL = "Значение!(Дата)" THEN DO:
     3660        v-ch[2] = v-ch0.
     3661        v-ch0:VISIBLE = NO.
     3662      END.
     3663      IF v-ch0:LABEL = "Значение!(Десятичное)" THEN DO:
     3664        v-ch[3] = v-ch0.
     3665        v-ch0:VISIBLE = NO.
     3666      END.
     3667      IF v-ch0:LABEL = "Значение!(Целое)" THEN DO:
     3668        v-ch[4] = v-ch0.
     3669        v-ch0:VISIBLE = NO.
     3670      END.
     3671      IF v-ch0:LABEL = "Значение!(Логическое)" THEN DO:
     3672        v-ch[5] = v-ch0.
     3673        v-ch0:VISIBLE = NO.
     3674      END.
     3675      IF v-ch0:LABEL = "Точка вызова" THEN DO:
     3676        v-ch[6] = v-ch0.
     3677      END.
     3678      IF v-ch0:LABEL = "Значение" THEN
     3679      v-ch0:RESIZABLE = YES.
     3680      v-ch0 = v-ch0:NEXT-COLUMN.
     3681   END.
     3682   assign
     3683   X_rp-rule-param.rp-param-name:resizable in browse br-rcp = yes
     3684   term_tt-rule-call-param.param-name:resizable in browse br-rcp = yes
     3685   term_tt-rule-call-param.param-label:resizable in browse br-rcp = yes
     3686   .
     3687   CASE p-list-mode:
     3688     WHEN 'rule-call-param':U THEN DO:
     3689        ASSIGN
     3690        X_rp-rule-param.rp-param-name:VISIBLE IN BROWSE br-rcp = NO
     3691        .
     3692     END.
     3693     WHEN 'rp-rule-param':U
     3694     or
     3695     when 'rp-rule-param':U + chr(44) + 'все':U
     3696     THEN DO:
     3697       assign
     3698       term_tt-rule-call-param.codex_id:VISIBLE IN BROWSE br-rcp = NO
     3699       term_tt-rule-call-param.ruleset_id:VISIBLE IN BROWSE br-rcp = NO
     3700       term_tt-rule-call-param.rule_id:VISIBLE IN BROWSE br-rcp = NO
     3701       term_tt-rule-call-param.order_id:VISIBLE IN BROWSE br-rcp = NO
     3702       term_tt-rule-call-param.param-name:VISIBLE IN BROWSE br-rcp = NO
     3703       term_tt-rule-call-param.param-num:VISIBLE IN BROWSE br-rcp = NO
     3704       .
     3705     END.
     3706   END CASE.
     3707    IF p-call-id <> '':U THEN DO:
     3708      v-ch[6]:VISIBLE = NO.
     3709    END.
     3710     IF p-profile-id <> 0 THEN DO:
     3711      term_tt-rule-call-param.profile_id :VISIBLE IN BROWSE br-rcp= NO.
     3712    END.
     3713     IF p-rule-id <> 0 THEN DO:
     3714      term_tt-rule-call-param.RULE_id :VISIBLE IN BROWSE br-rcp= NO.
     3715    END.
     3716     IF p-once-more <> 0 THEN DO:
     3717      term_tt-rule-call-param.once-more :VISIBLE IN BROWSE br-rcp= NO.
     3718    END.
     3719   VIEW FRAME Dialog-Frame.
     3720   selectobject:RADIO-BUTTONS IN FRAME Dialog-Frame =
     3721       'Все' + chr(44) + string(0) + chr(44) +
     3722       'Выборочно' + chr(44) + string(-1).
     3723   if can-find(first obj-list) then do:
     3724     selectobject = integer(string(-1)).
     3725   end.
     3726   else do:
     3727     selectobject =integer( string(0)).
     3728     define variable v-obj-db-num as integer no-undo .
     3729     if v-running-mode then do:
     3730       for each buf_shop no-lock:
     3731   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3732   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     3733     (input  'маг':U
     3734     ,input  buf_shop.obj-code
     3735     ,output v-obj-db-num
     3736     )  .
     3737         if v-obj-db-num <> v-cntxt-db-num then next.
     3738   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3739   run create_obj-list in this-procedure
     3740    ( input 'маг':U ,
     3741      input buf_shop.obj-code )
     3742      .
     3743         find first obj-list where
     3744             obj-list.obj-code = buf_shop.obj-code
     3745           and obj-list.obj-type = 'маг':U.
     3746         glog = e-shops:INSERT-STRING ( display-shop(buf_shop.obj-code
     3747                                                   , obj-list.obj-name )) in frame Dialog-Frame .
     3748         glog = e-shops:INSERT-STRING ( chr(10) ) in frame Dialog-Frame .
     3749       end.
     3750     end.
     3751   end.
     3752   display
     3753   selectobject
     3754   rs-action
     3755   rs-method
     3756   v-list-id
     3757   with frame Dialog-Frame .
     3758   ENABLE
     3759   B-exit WHEN p-mode <> 'ПРОСМОТР':U
