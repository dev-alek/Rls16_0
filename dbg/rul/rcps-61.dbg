     1182   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1183   function prepare-path returns character ( input p-nonprepared-path as character ):
     1184   define variable v-prepared-path as character no-undo .
     1185   assign
     1186   v-prepared-path = replace(p-nonprepared-path, chr(92), chr(47))
     1187   v-prepared-path = right-trim(v-prepared-path, chr(47))
     1188   .
     1189   return v-prepared-path.
     1190   END FUNCTION.
     1191   function prepare-path2 returns character ( input p-nonprepared-path as character ):
     1192   define variable v-prepared-path as character no-undo .
     1193   assign
     1194   v-prepared-path = replace(p-nonprepared-path, chr(47), chr(92))
     1195   v-prepared-path = right-trim(v-prepared-path, chr(92))
     1196   .
     1197   return v-prepared-path.
     1198   END FUNCTION.
     1199   function quote-spaces returns character ( input p-full-path as character):
     1200   define variable v-ii as integer no-undo .
     1201   define variable v-result as character no-undo .
     1202   do v-ii = 1 to num-entries(p-full-path, chr(92)):
     1203     v-result = v-result + (if v-ii = 1 then '' else chr(92)) +
     1204                (if index(entry(v-ii, p-full-path, chr(92)), chr(32)) > 0
     1205                then  substitute("&1&2&1", chr(34), entry(v-ii, p-full-path, chr(92)))
     1206                else entry(v-ii, p-full-path, chr(92))
     1207                )
     1208     .
     1209   end.
     1210   return v-result.
     1211   end function.
     1212   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1213   def
     1214   new shared
     1215   temp-table  obj-list no-undo
     1216     field obj-type like ub.clients.obj-type
     1217     field obj-code like ub.clients.obj-code
     1218     field obj-name like ub.clients.obj-name
     1219     field obj-id   as integer
     1220     field db-num   as integer
     1221     index pi is primary unique obj-id
     1222     index ie1 obj-type obj-code
     1223     index ie2 obj-name
     1224   .
     1225   procedure create_obj-list :
     1226      define input parameter p-obj-type like ub.clients.obj-type no-undo .
     1227      define input parameter p-obj-code like ub.clients.obj-code no-undo .
     1228      do
     1229      on error undo, return error return-value
     1230      :
     1231         define buffer cli-obj for ub.clients .
     1232         define variable p-var as integer no-undo .
     1233         define buffer buf_obj-list for obj-list .
     1234         find last buf_obj-list  use-index pi no-error .
     1235         if available buf_obj-list
     1236         then
     1237            p-var = buf_obj-list.obj-id + 1.
     1238         else
     1239            p-var = 1.
     1240         find first cli-obj where
     1241                   cli-obj.obj-type = p-obj-type
     1242               and cli-obj.obj-code = p-obj-code
     1243         no-lock no-error.
     1244         if available cli-obj
     1245         then do:
     1246            create buf_obj-list.
     1247            assign
     1248               buf_obj-list.obj-id   = p-var
     1249               buf_obj-list.obj-code = cli-obj.obj-code
     1250               buf_obj-list.obj-type = cli-obj.obj-type
     1251               buf_obj-list.obj-name = cli-obj.obj-name
     1252               buf_obj-list.db-num   = cli-obj.db-num
     1253            .
     1254         end.
     1255      end.
     1256   end.
     1257   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1258     define variable v-cntxt-db-num        as integer   no-undo .
     1259     define variable v-cntxt-userid        as character no-undo .
     1260     define variable v-cntxt-level         as character no-undo .
     1261     define variable v-cntxt-host-code-obj as integer   no-undo .
     1262     define variable v-cntxt-obj-type      as character no-undo .
     1263     define variable v-cntxt-obj-code      as integer   no-undo .
     1264     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1265     define variable v-cntxt-is-admin      as logical   no-undo .
     1266   define new global shared variable g#library  as handle no-undo .
     1267   define new global shared variable g#library2 as handle no-undo .
     1268   FUNCTION display-shop returns character ( input p-obj-code as integer, input p-obj-name as character):
     1269   define variable v-string as character no-undo .
     1270   v-string = substitute("&1   &2",  string(p-obj-code, ">>>>9"), p-obj-name).
     1271   return v-string.
     1272   end function.
     1273   define variable v-save-objects as logical no-undo init yes.
     1274   define variable v-list as character no-undo .
     1275   define variable v-list-macro as character no-undo .
     1276   define variable v-running-mode as logical no-undo .
     1277   DEFINE BUTTON B-exit AUTO-GO
     1278        LABEL "&Ввод"
     1279        SIZE 10 BY 1
     1280        BGCOLOR 8 .
