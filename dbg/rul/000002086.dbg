     3706   procedure fbrlib_get-default-pay-code :
     3707   define input parameter p-obj-type   as character        no-undo.
     3708   define input parameter p-obj-code   as integer          no-undo.
     3709   define output parameter p-pay-code  as integer          no-undo.
     3710   define variable v-host-code as integer no-undo .
     3711   define buffer buf_shop          for ub.shop.
     3712   define buffer buf_store         for ub.store.
     3713   define buffer buf_sysconf       for ub.sysconf.
     3714   do
     3715   for buf_shop
     3716     , buf_store
     3717     , buf_sysconf
     3718   on error undo, return error
     3719   :
     3720     case p-obj-type  :
     3721       when 'маг':U then do:
     3722           find first buf_shop no-lock
     3723                 where buf_shop.obj-code = p-obj-code
     3724           no-error.
     3725           if available buf_shop
     3726           then do:
     3727               assign
     3728                   p-pay-code = buf_shop.fbr-pay
     3729               .
     3730           end.
     3731       end.
     3732       when 'скл':U then do:
     3733           find first buf_store no-lock
     3734                 where buf_store.obj-code = p-obj-code
     3735           no-error.
     3736           if available buf_store
     3737           then do:
     3738               assign
     3739                   p-pay-code = buf_store.fbr-pay
     3740               .
     3741           end.
     3742       end.
     3743     end case.
     3744     if p-pay-code = ?
     3745     or p-pay-code = 0
     3746     then do:
     3747   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3748   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3749     (input  p-obj-type
     3750     ,input  p-obj-code
     3751     ,output v-host-code
     3752     )  .
     3753         find first buf_sysconf no-lock
     3754               where buf_sysconf.host-code = v-host-code
     3755         no-error.
     3756         if available buf_sysconf
     3757         then do:
     3758             assign
     3759                 p-pay-code = buf_sysconf.fbr-pay
     3760             .
     3761         end.
     3762     end.
     3763     if p-pay-code = ?
     3764     or p-pay-code = 0
     3765     then do:
     3766   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3767   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdnpay in g#library
     3768     (input  p-obj-type
     3769     ,input  p-obj-code
     3770     ,output p-pay-code
     3771     )  .
     3772     end.
     3773   end.
     3774   end procedure.
     3775   procedure fbrlib-fill-and-check-temp_fbrlib_recipe :
     3776   do
     3777   on error undo, return error
     3778   :
     3779   define input parameter p-fbr-doc-code as character    no-undo.
     3780       define variable vss-description as character    no-undo init "fbrlib-fill-and-check-temp_fbrlib_recipe: ".
     3781       define variable v-gds-name      as character    no-undo.
     3782       define buffer buf_fbr-doc               for ub.fbr-doc.
     3783       define buffer buf_fbr-line              for ub.fbr-line.
     3784       define buffer buf_temp_fbrlib_recipe    for temp_fbrlib_recipe.
     3785       define buffer buf_out_temp_fbrlib_recipe    for temp_fbrlib_recipe.
     3786       find first buf_fbr-doc no-lock
     3787            where buf_fbr-doc.doc-code = p-fbr-doc-code
     3788       .
     3789       for each buf_temp_fbrlib_recipe
     3790       :
     3791           delete buf_temp_fbrlib_recipe.
     3792       end.
     3793       for each buf_fbr-line no-lock
     3794          where buf_fbr-line.doc-code = p-fbr-doc-code
     3795       :
     3796           find first buf_temp_fbrlib_recipe
     3797                where buf_temp_fbrlib_recipe.recipe-code = buf_fbr-line.recipe-code
     3798           no-error.
     3799           if not available buf_temp_fbrlib_recipe
     3800           then do:
     3801               create buf_temp_fbrlib_recipe.
     3802               assign
     3803                   buf_temp_fbrlib_recipe.recipe-code = buf_fbr-line.recipe-code
     3804                   buf_temp_fbrlib_recipe.fbr-doc-code = buf_fbr-line.doc-code
     3805               .
     3806           end.
     3807       end.
     3808       for each buf_temp_fbrlib_recipe
     3809       :
     3810           assign
     3811               buf_temp_fbrlib_recipe.count-income                = 0
     3812               buf_temp_fbrlib_recipe.qnty-income                 = 0
     3813               buf_temp_fbrlib_recipe.sum-income-sale             = 0
     3814               buf_temp_fbrlib_recipe.sum-income-cost-base        = 0
     3815               buf_temp_fbrlib_recipe.sum-income-cost-rubl        = 0
     3816               buf_temp_fbrlib_recipe.sum-income-vat-cost-base    = 0
     3817               buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl    = 0
     3818               buf_temp_fbrlib_recipe.count-write-off             = 0
     3819               buf_temp_fbrlib_recipe.qnty-write-off              = 0
     3820               buf_temp_fbrlib_recipe.sum-write-off-sale          = 0
     3821               buf_temp_fbrlib_recipe.sum-write-off-cost-base     = 0
     3822               buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     = 0
     3823               buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base = 0
     3824               buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl = 0
     3825           .
     3826           for each buf_fbr-line no-lock
     3827              where buf_fbr-line.doc-code     = p-fbr-doc-code
     3828                and buf_fbr-line.trn-type     = 'при':U
     3829                and buf_fbr-line.recipe-code  = buf_temp_fbrlib_recipe.recipe-code
     3830           :
     3831               if ( buf_fbr-line.price-base   = ?
     3832                   or buf_fbr-line.price-rubl = ?
     3833                   or buf_fbr-line.price-base <= 0
     3834                   or buf_fbr-line.price-rubl <= 0 )
     3835               and buf_fbr-line.fact-qnty <> 0
     3836               and buf_fbr-line.rsrv-qnty <> ?
     3837               and buf_fbr-doc.is-free    = no
     3838               then do:
     3839   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3840   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
     3841     (input  buf_fbr-line.artic
     3842     ,input  buf_fbr-line.prod-type
     3843     ,input  buf_fbr-line.prod-code
     3844     ,output v-gds-name
     3845     ) no-error .
     3846                   if error-status :error
     3847                   then do:
     3848                       assign
     3849                           v-gds-name = ""
     3850                       .
     3851                   end.
     3852                   undo, return error  substitute("&1 В документе пр-ва &2 учетная цена не определена или нулевая!&3Рецепт &4&3Товар: &5 &6"
     3853                                                 ,vss-description
     3854                                                 ,buf_fbr-doc.doc-code
     3855                                                 ,chr(10)
     3856                                                 ,buf_fbr-line.recipe-code
     3857                                                 ,buf_fbr-line.artic
     3858                                                 ,v-gds-name).
     3859               end.
     3860               assign
     3861                   buf_temp_fbrlib_recipe.count-income             = buf_temp_fbrlib_recipe.count-income + 1
     3862                   buf_temp_fbrlib_recipe.qnty-income              = buf_temp_fbrlib_recipe.qnty-income
     3863                                                                   + buf_fbr-line.fact-qnty
     3864                   buf_temp_fbrlib_recipe.sum-income-sale          = buf_temp_fbrlib_recipe.sum-income-sale
     3865                                                                   + buf_fbr-line.price-sale * buf_fbr-line.fact-qnty
     3866               .
     3867               if buf_fbr-line.is-waste = no
     3868               then do:
     3869                   assign
     3870                       buf_temp_fbrlib_recipe.sum-income-cost-base     = buf_temp_fbrlib_recipe.sum-income-cost-base
     3871                                                                       + buf_fbr-line.price-sum-base
     3872                       buf_temp_fbrlib_recipe.sum-income-cost-rubl     = buf_temp_fbrlib_recipe.sum-income-cost-rubl
     3873                                                                       + buf_fbr-line.price-sum-rubl
     3874                       buf_temp_fbrlib_recipe.sum-income-vat-cost-base = buf_temp_fbrlib_recipe.sum-income-vat-cost-base
     3875                                                                       + buf_fbr-line.price-sum-vat-base
     3876                       buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl = buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
     3877                                                                       + buf_fbr-line.price-sum-vat-rubl
     3878                   .
     3879               end.
     3880           end.
     3881           for each buf_fbr-line no-lock
     3882              where buf_fbr-line.doc-code     = p-fbr-doc-code
     3883                and buf_fbr-line.trn-type     = 'спи':U
     3884                and buf_fbr-line.recipe-code  = buf_temp_fbrlib_recipe.recipe-code
     3885           :
     3886               if ( buf_fbr-line.price-base   = ?
     3887                   or buf_fbr-line.price-rubl = ?
     3888                   or buf_fbr-line.price-base <= 0
     3889                   or buf_fbr-line.price-rubl <= 0 )
     3890               and buf_fbr-line.fact-qnty <> 0
     3891               and buf_fbr-line.rsrv-qnty <> ?
     3892               and buf_fbr-doc.is-free    = no
     3893               and buf_fbr-doc.status_    = 'разрешен':U
     3894               then do:
     3895   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3896   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
     3897     (input  buf_fbr-line.artic
     3898     ,input  buf_fbr-line.prod-type
     3899     ,input  buf_fbr-line.prod-code
     3900     ,output v-gds-name
     3901     ) no-error .
     3902                   if error-status :error
     3903                   then do:
     3904                       assign
     3905                           v-gds-name = ""
     3906                       .
     3907                   end.
     3908                   undo, return error  substitute("&1 В документе пр-ва &2 учетная цена не определена или нулевая!&3Рецепт &4&3Товар: &5 &6"
     3909                                                 ,vss-description
     3910                                                 ,buf_fbr-doc.doc-code
     3911                                                 ,chr(10)
     3912                                                 ,buf_fbr-line.recipe-code
     3913                                                 ,buf_fbr-line.artic
     3914                                                 ,v-gds-name).
     3915               end.
     3916               assign
     3917                   buf_temp_fbrlib_recipe.count-write-off             = buf_temp_fbrlib_recipe.count-write-off + 1
     3918                   buf_temp_fbrlib_recipe.qnty-write-off              = buf_temp_fbrlib_recipe.qnty-write-off
     3919                                                                   + buf_fbr-line.fact-qnty
     3920                   buf_temp_fbrlib_recipe.sum-write-off-sale          = buf_temp_fbrlib_recipe.sum-write-off-sale
     3921                                                                   + buf_fbr-line.price-sale * buf_fbr-line.fact-qnty
     3922               .
     3923               if buf_fbr-line.is-waste = no
     3924               then do:
     3925                   assign
     3926                       buf_temp_fbrlib_recipe.sum-write-off-cost-base     = buf_temp_fbrlib_recipe.sum-write-off-cost-base
     3927                                                                       + buf_fbr-line.price-sum-base
     3928                       buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     = buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
     3929                                                                       + buf_fbr-line.price-sum-rubl
     3930                       buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base = buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     3931                                                                       + buf_fbr-line.price-sum-vat-base
     3932                       buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl = buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     3933                                                                       + buf_fbr-line.price-sum-vat-rubl
     3934                   .
     3935               end.
     3936           end.
     3937           if buf_fbr-doc.status_    = 'разрешен':U
     3938           and ( abs( buf_temp_fbrlib_recipe.sum-write-off-cost-base     - buf_temp_fbrlib_recipe.sum-income-cost-base     ) > 0.01
     3939           or abs( buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     - buf_temp_fbrlib_recipe.sum-income-cost-rubl     ) > 0.01
     3940           or abs( buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base - buf_temp_fbrlib_recipe.sum-income-vat-cost-base ) > 0.01
     3941           or abs( buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl - buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl ) > 0.01
     3942               )
     3943           then do:
     3944            undo, return error
     3945               substitute("В документе пр-ва &1 Не совпадают суммы учетных цен для списанного и оприходованного по рецепту товара.&2" +
     3946                           "Рецепт: &3&2&4&4по списанному товару&4по оприходованному товару&2"  +
     3947                           "Сумма в баз.вал.&4&5&4&4&6&2" +
     3948                           "Сумма в &9.&4&7&4&4&8&2"
     3949                          , buf_fbr-doc.doc-code
     3950                          , chr(10)
     3951                          , buf_temp_fbrlib_recipe.recipe-code
     3952                          , chr(9)
     3953                          , buf_temp_fbrlib_recipe.sum-write-off-cost-base
     3954                          , buf_temp_fbrlib_recipe.sum-income-cost-base
     3955                          , buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
     3956                          , buf_temp_fbrlib_recipe.sum-income-cost-rubl
     3957                          , "руб"
     3958                          )
     3959              +
     3960              substitute("НДС в баз.вал.&1&2&1&1&3&4" +
     3961                         "НДС в &7.&1&5&1&1&6&4"
     3962                        ,  chr(9)
     3963                        ,buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     3964                        ,buf_temp_fbrlib_recipe.sum-income-vat-cost-base
     3965                        ,chr(10)
     3966                        ,buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     3967                        ,buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
     3968                        ,"руб"
     3969                        )       .
     3970           end.
     3971       end.
     3972   end.
     3973   end procedure.
     3974   procedure fbrlib-fill-sum-fbr-doc :
     3975   do
     3976   on error undo, return error
     3977   :
     3978   define input parameter p-fbr-doc-recid  as recid        no-undo.
     3979   define input parameter p-mode           as character    no-undo.
     3980       define variable vss-description as character init "fbrlib-fill-sum-fbr-doc: "  no-undo.
     3981       define buffer buf_fbr-doc           for ub.fbr-doc.
     3982       define buffer buf_fbr-line          for ub.fbr-line.
     3983       define buffer buf_temp_fbrlib_recipe   for temp_fbrlib_recipe.
     3984       define variable v-in-count          as integer       no-undo.
     3985       define variable v-out-count         as integer       no-undo.
     3986       find first buf_fbr-doc exclusive-lock
     3987            where recid ( buf_fbr-doc ) = p-fbr-doc-recid
     3988       .
     3989       find first buf_temp_fbrlib_recipe no-error.
     3990       if not available buf_temp_fbrlib_recipe
     3991       then do:
     3992           run fbrlib-fill-and-check-temp_fbrlib_recipe in this-procedure (
     3993               input buf_fbr-doc.doc-code
     3994           ) no-error.
     3995           if error-status :error
     3996           then do:
     3997               undo, return error substitute("&1 Ошибка расчета сумм при заполнении шапки документа производства.&2&3&2&4"
     3998                                              , vss-description
     3999                                              , chr(10)
     4000                                              , error-status:get-message(1)
     4001                                              , return-value ).
     4002           end.
     4003       end.
     4004       assign
     4005           v-in-count                  = 0
     4006           buf_fbr-doc.in-qnty         = 0
     4007           buf_fbr-doc.in-sale         = 0
     4008           buf_fbr-doc.in-base         = 0
     4009           buf_fbr-doc.in-rubl         = 0
     4010           buf_fbr-doc.in-vat-base     = 0
     4011           buf_fbr-doc.in-vat-rubl     = 0
     4012           v-out-count                 = 0
     4013           buf_fbr-doc.out-qnty        = 0
     4014           buf_fbr-doc.out-sale        = 0
     4015           buf_fbr-doc.out-base        = 0
     4016           buf_fbr-doc.out-rubl        = 0
     4017           buf_fbr-doc.out-vat-base    = 0
     4018           buf_fbr-doc.out-vat-rubl    = 0
     4019       .
     4020       for each buf_temp_fbrlib_recipe
     4021       :
     4022           assign
     4023               v-in-count                  = v-in-count                + buf_temp_fbrlib_recipe.count-income
     4024               buf_fbr-doc.in-qnty         = buf_fbr-doc.in-qnty       + buf_temp_fbrlib_recipe.qnty-income
     4025               buf_fbr-doc.in-sale         = buf_fbr-doc.in-sale       + buf_temp_fbrlib_recipe.sum-income-sale
     4026               buf_fbr-doc.in-base         = buf_fbr-doc.in-base       + buf_temp_fbrlib_recipe.sum-income-cost-base
     4027               buf_fbr-doc.in-rubl         = buf_fbr-doc.in-rubl       + buf_temp_fbrlib_recipe.sum-income-cost-rubl
     4028               buf_fbr-doc.in-vat-base     = buf_fbr-doc.in-vat-base   + buf_temp_fbrlib_recipe.sum-income-vat-cost-base
     4029               buf_fbr-doc.in-vat-rubl     = buf_fbr-doc.in-vat-rubl   + buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
     4030               v-out-count                 = v-out-count               + buf_temp_fbrlib_recipe.count-write-off
     4031               buf_fbr-doc.out-qnty        = buf_fbr-doc.out-qnty      + buf_temp_fbrlib_recipe.qnty-write-off
     4032               buf_fbr-doc.out-sale        = buf_fbr-doc.out-sale      + buf_temp_fbrlib_recipe.sum-write-off-sale
     4033               buf_fbr-doc.out-base        = buf_fbr-doc.out-base      + buf_temp_fbrlib_recipe.sum-write-off-cost-base
     4034               buf_fbr-doc.out-rubl        = buf_fbr-doc.out-rubl      + buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
     4035               buf_fbr-doc.out-vat-base    = buf_fbr-doc.out-vat-base  + buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     4036               buf_fbr-doc.out-vat-rubl    = buf_fbr-doc.out-vat-rubl  + buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     4037           .
     4038       end.
     4039       if ( abs (buf_fbr-doc.in-rubl - buf_fbr-doc.out-rubl) <= 0.01
     4040       and   abs (buf_fbr-doc.in-base - buf_fbr-doc.out-base) <= 0.01 )
     4041       or p-mode <> 'факт':U
     4042       then do:
     4043           if substring( buf_fbr-doc.PS, 1, 1 ) = "@"
     4044           then do:
     4045               assign
     4046                   buf_fbr-doc.PS = "@ Строк полученных товаров : "
     4047                                   + string( v-out-count, ">>>,>>9" )
     4048                                   + chr(10) + "Строк исходных товаров : "
     4049                                   + string( v-in-count, ">>>,>>9" )
     4050               .
     4051           end.
     4052       end.
     4053       else do:
     4054         undo, return error substitute("В док-те пр-ва &1 не совпадают суммы списанных и оприходованных товаров.&2" +
     4055                                       "Сумма списанных товаров в &3 - &4&2" +
     4056                                       "Сумма оприходованных товаров в &3 - &5&2" +
     4057                                       "Сумма оприходованных товаров в &3 - &6&2" +
     4058                                       "Сумма списанных товаров в баз.вал. - &7&2" +
     4059                                       "Сумма оприходованных товаров в баз.вал. - &8&2"
     4060                                       , buf_fbr-doc.doc-code
     4061                                       , chr(10)
     4062                                       , "рублях"
     4063                                       , round( buf_fbr-doc.out-rubl, 2 )
     4064                                       , round( buf_fbr-doc.in-rubl,  2 )
     4065                                       , round( buf_fbr-doc.in-rubl,  2 )
     4066                                       , round( buf_fbr-doc.out-base, 2 )
     4067                                       , round( buf_fbr-doc.in-base,  2 )).
     4068       end.
     4069   end.
     4070   end procedure.
     4071   procedure fbrlib-calc-prices :
     4072   do
     4073   on error undo, return error
     4074   :
     4075   define input parameter p-fbr-line-recid as recid        no-undo.
     4076   define input parameter p-price-obj-type as character    no-undo.
     4077   define input parameter p-price-obj-code as integer      no-undo.
     4078   define output parameter p-current-price as decimal      no-undo.
     4079       define variable v-void          as decimal       no-undo.
     4080       define variable v-void-char     as character     no-undo.
     4081       define variable v-gds-code      as integer       no-undo.
     4082       define variable v-b-code        as integer       no-undo.
     4083       define buffer buf_fbr-doc   for ub.fbr-doc.
     4084       define buffer buf_fbr-line  for ub.fbr-line.
     4085       define buffer buf_gds-prt   for ub.gds-prt.
     4086       define buffer buf_bar-code  for ub.bar-code.
     4087       find first buf_fbr-line no-lock
     4088           where recid( buf_fbr-line ) = p-fbr-line-recid
     4089       .
     4090   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4091   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     4092     (input  buf_fbr-line.artic
     4093     ,input  buf_fbr-line.prod-type
     4094     ,input  buf_fbr-line.prod-code
     4095     ,output v-gds-code
     4096     ) no-error .
     4097       if error-status :error
     4098       then do:
     4099         undo, return error substitute("&1 &2 &3&4Ошибка определения кода товара (артикул &7).&4&5&4&6"
     4100                                         ,vss-workfile
     4101                                         ,vss-revision
     4102                                         ,vss-description
     4103                                         ,chr(10)
     4104                                         , error-status:get-message(1)
     4105                                         , return-value
     4106                                         , buf_fbr-line.artic
     4107                                         ).
     4108       end.
     4109   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     4110     (input  v-gds-code
     4111     ,input  ?
     4112     ,output v-b-code
     4113     ) no-error .
     4114       if error-status :error
     4115       then do:
     4116         undo, return error substitute("&1 &2 &3&4Ошибка определения основного бар-кода товара (код товара) &7.&4&5&4&6"
     4117                                         ,vss-workfile
     4118                                         ,vss-revision
     4119                                         ,vss-description
     4120                                         ,chr(10)
     4121                                         , error-status:get-message(1)
     4122                                         , return-value
     4123                                         , v-gds-code
     4124                                         ).
     4125       end.
     4126       if buf_fbr-line.is-calc = no
     4127       then do:
     4128   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4129   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     4130     (input  p-price-obj-type
     4131     ,input  p-price-obj-code
     4132     ,input  v-b-code
     4133     ,input  0
     4134     ,input  0
     4135     ,output v-void-char
     4136     ,output p-current-price
     4137     ,output v-void
     4138     ,output v-void
     4139     ) no-error .
     4140           if error-status :error
     4141           then do:
     4142             undo, return error substitute("&1 &2 &3&4Ошибка определения продажной цены основного бар-кода товара (код товара) &7.&4&5&4&6"
     4143                                             ,vss-workfile
     4144                                             ,vss-revision
     4145                                             ,vss-description
     4146                                             ,chr(10)
     4147                                             , error-status:get-message(1)
     4148                                             , return-value
     4149                                             , v-gds-code
     4150                                             ).
     4151           end.
     4152       end.
     4153       else do:
     4154           assign
     4155               p-current-price = buf_fbr-line.price-sale
     4156           .
     4157       end.
     4158   end.
     4159   end procedure.
     4160   procedure fbrlib-put-in-order-recipe :
     4161   do
     4162   on error undo, return error
     4163   :
     4164   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     4165       define variable v-recipe-counter    as integer          no-undo.
     4166       define variable v-recipe-amount     as integer init 0   no-undo.
     4167       define variable v-child-counter     as integer          no-undo.
     4168       define variable v-is-call-cycle     as logical          no-undo.
     4169       define variable v-str as character     no-undo.
     4170       define buffer buf_in_fbr-line       for ub.fbr-line.
     4171       define buffer buf_dress_fbr-line    for ub.fbr-line.
     4172       define buffer buf_fbr-line          for ub.fbr-line.
     4173       define buffer buf_recipe-gds        for ub.recipe-gds.
     4174       define buffer buf_recipe            for ub.recipe.
     4175       for each temp_recipe-childs-qnty
     4176       :
     4177           delete temp_recipe-childs-qnty.
     4178       end.
     4179       for each temp_recipe-childs
     4180       :
     4181           delete temp_recipe-childs.
     4182       end.
     4183       for each temp_recipe-order
     4184       :
     4185           delete temp_recipe-order.
     4186       end.
     4187       for each buf_fbr-line no-lock
     4188          where buf_fbr-line.doc-code = p-fbr-doc-doc-code
     4189       on error undo, return error
     4190       :
     4191           find first temp_recipe-childs-qnty
     4192                where temp_recipe-childs-qnty.recipe-code = buf_fbr-line.recipe-code
     4193           no-error.
     4194           if not available temp_recipe-childs-qnty
     4195           then do:
     4196               create temp_recipe-childs-qnty.
     4197               assign
     4198                   v-recipe-amount                     = v-recipe-amount + 1
     4199                   temp_recipe-childs-qnty.recipe-code = buf_fbr-line.recipe-code
     4200                   temp_recipe-childs-qnty.order       = v-recipe-amount
     4201                   temp_recipe-childs-qnty.childs-qnty = 0
     4202                   v-child-counter                     = 0
     4203               .
     4204           end.
     4205       end.
     4206       for each buf_in_fbr-line no-lock
     4207          where buf_in_fbr-line.doc-code = p-fbr-doc-doc-code
     4208            and buf_in_fbr-line.trn-type = 'спи':U
     4209       on error undo, return error
     4210       :
     4211           for each buf_dress_fbr-line no-lock
     4212              where buf_dress_fbr-line.doc-code    = p-fbr-doc-doc-code
     4213                and buf_dress_fbr-line.trn-type    = 'при':U
     4214                and buf_dress_fbr-line.artic       = buf_in_fbr-line.artic
     4215                and buf_dress_fbr-line.prod-type   = buf_in_fbr-line.prod-type
     4216                and buf_dress_fbr-line.prod-code   = buf_in_fbr-line.prod-code
     4217           on error undo, return error
     4218           :
     4219               find first buf_recipe no-lock
     4220                    where buf_recipe.recipe-code = buf_dress_fbr-line.recipe-code
     4221               .
     4222               if buf_in_fbr-line.is-comp = yes
     4223               then do:
     4224                   find last temp_recipe-childs-qnty
     4225                       where temp_recipe-childs-qnty.recipe-code = buf_in_fbr-line.recipe-code
     4226                   .
     4227                   assign
     4228                       temp_recipe-childs-qnty.childs-qnty = temp_recipe-childs-qnty.childs-qnty + 1
     4229                   .
     4230                   create temp_recipe-childs.
     4231                   assign
     4232                       temp_recipe-childs.recipe-code          = buf_in_fbr-line.recipe-code
     4233                       temp_recipe-childs.child-code           = temp_recipe-childs-qnty.childs-qnty
     4234                       temp_recipe-childs.child-recipe-code    = buf_dress_fbr-line.recipe-code
     4235                   .
     4236               end.
     4237               else do:
     4238               end.
     4239           end.
     4240       end.
     4241       for each buf_in_fbr-line no-lock
     4242          where buf_in_fbr-line.doc-code = p-fbr-doc-doc-code
     4243            and buf_in_fbr-line.trn-type = 'при':U
     4244       on error undo, return error
     4245       :
     4246           find first buf_recipe no-lock
     4247                where buf_recipe.recipe-code = buf_in_fbr-line.recipe-code
     4248           no-error.
     4249           if buf_in_fbr-line.is-comp = no
     4250           then do:
     4251           end.
     4252           else do:
     4253               for each buf_recipe-gds no-lock
     4254               where buf_recipe-gds.recipe-code = buf_in_fbr-line.recipe-code
     4255               :
     4256                   for each buf_fbr-line no-lock
     4257                   where buf_fbr-line.doc-code    = p-fbr-doc-doc-code
     4258                       and buf_fbr-line.trn-type    = 'при':U
     4259                       and buf_fbr-line.artic       = buf_recipe-gds.artic
     4260                       and buf_fbr-line.prod-type   = buf_recipe-gds.prod-type
     4261                       and buf_fbr-line.prod-code   = buf_recipe-gds.prod-code
     4262                   on error undo, return error
     4263                   :
     4264                       find first buf_recipe no-lock
     4265                            where buf_recipe.recipe-code = buf_fbr-line.recipe-code
     4266                       .
     4267                       if buf_recipe.recipe-type = 'разделка':U
     4268                       then do:
     4269                       end.
     4270                       else do:
     4271                           find last temp_recipe-childs-qnty
     4272                               where temp_recipe-childs-qnty.recipe-code = buf_in_fbr-line.recipe-code
     4273                           .
     4274                           assign
     4275                               temp_recipe-childs-qnty.childs-qnty = temp_recipe-childs-qnty.childs-qnty + 1
     4276                           .
     4277                           create temp_recipe-childs.
     4278                           assign
     4279                               temp_recipe-childs.recipe-code          = buf_in_fbr-line.recipe-code
     4280                               temp_recipe-childs.child-code           = temp_recipe-childs-qnty.childs-qnty
     4281                               temp_recipe-childs.child-recipe-code    = buf_fbr-line.recipe-code
     4282                           .
     4283                       end.
     4284                   end.
     4285               end.
     4286           end.
     4287       end.
     4288       for each temp_recipe-order
     4289       on error undo, return error
     4290       :
     4291           delete temp_recipe-order.
     4292       end.
     4293       assign
     4294           v-fbrlib-recipe-order = 0
     4295       .
     4296       do v-recipe-counter = 1 to v-recipe-amount
     4297       on error undo, return error
     4298       :
     4299           run fbrlib-add-recipe-in-tmp-order in this-procedure (
     4300                 input v-recipe-counter
     4301               , input 0
     4302               , output v-is-call-cycle
     4303           ).
     4304           if v-is-call-cycle = yes
     4305           then do:
     4306               message
     4307                       "Достигнут максимальный уровень вложенности рецептов."
     4308                   skip(1)
     4309                   skip "Невозможно упорядочить рецепты."
     4310                   skip(1)
     4311                   skip "Необходимо изменить структуру рецептов,"
     4312                   skip "используемых при формировании"
     4313                   skip "данного документа производства."
     4314               view-as alert-box error
     4315               title "Невозможно рассчитать документ производства".
     4316               for each temp_recipe-childs-qnty
     4317               :
     4318                   delete temp_recipe-childs-qnty.
     4319               end.
     4320               for each temp_recipe-childs
     4321               :
     4322                   delete temp_recipe-childs.
     4323               end.
     4324               for each temp_recipe-order
     4325               :
     4326                   delete temp_recipe-order.
     4327               end.
     4328               for each temp_recipe-order
     4329               on error undo, return error
     4330               :
     4331                   delete temp_recipe-order.
     4332               end.
     4333               for each temp_fbrlib_recipe
     4334               on error undo, return error
     4335               :
     4336                   delete temp_recipe-order.
     4337               end.
     4338               undo, return error.
     4339           end.
     4340       end.
     4341   end.
     4342   end procedure.
     4343   procedure fbrlib-add-recipe-in-tmp-order :
     4344   do
     4345   on error undo, return error
     4346   :
     4347   define input parameter p-order              as integer      no-undo.
     4348   define input parameter p-call-counter       as integer      no-undo.
     4349   define output parameter p-is-call-cycle     as logical      no-undo.
     4350       define variable v-nodes-counter     as integer       no-undo.
     4351       define buffer buf_c_temp_recipe-childs-qnty for temp_recipe-childs-qnty.
     4352       define buffer buf_temp_recipe-childs-qnty   for temp_recipe-childs-qnty.
     4353       define buffer buf_temp_recipe-childs        for temp_recipe-childs     .
     4354       define buffer buf_temp_recipe-order         for temp_recipe-order.
     4355       assign
     4356           p-call-counter = p-call-counter + 1
     4357       .
     4358       if p-call-counter > 50
     4359       then do:
     4360           assign
     4361               p-is-call-cycle = yes
     4362           .
     4363       end.
     4364       else do:
     4365           find first buf_temp_recipe-childs-qnty
     4366                where buf_temp_recipe-childs-qnty.order = p-order
     4367           .
     4368           find first buf_temp_recipe-order
     4369                where buf_temp_recipe-order.recipe-code = buf_temp_recipe-childs-qnty.recipe-code
     4370           no-error.
     4371           if not available buf_temp_recipe-order
     4372           then do:
     4373               do v-nodes-counter = 1 to buf_temp_recipe-childs-qnty.childs-qnty
     4374               :
     4375                   find first buf_temp_recipe-childs
     4376                        where buf_temp_recipe-childs.recipe-code = buf_temp_recipe-childs-qnty.recipe-code
     4377                          and buf_temp_recipe-childs.child-code  = v-nodes-counter
     4378                   .
     4379                   find first buf_c_temp_recipe-childs-qnty
     4380                        where buf_c_temp_recipe-childs-qnty.recipe-code = buf_temp_recipe-childs.child-recipe-code
     4381                   .
     4382                   run fbrlib-add-recipe-in-tmp-order in this-procedure (
     4383                         input buf_c_temp_recipe-childs-qnty.order
     4384                       , input p-call-counter
     4385                       , output p-is-call-cycle
     4386                   ).
     4387                   if p-is-call-cycle = yes
     4388                   then do:
     4389                       return.
     4390                   end.
     4391               end.
     4392               assign
     4393                   v-fbrlib-recipe-order = v-fbrlib-recipe-order + 1
     4394               .
     4395               create buf_temp_recipe-order.
     4396               assign
     4397                   buf_temp_recipe-order.recipe-code   = buf_temp_recipe-childs-qnty.recipe-code
     4398                   buf_temp_recipe-order.order         = v-fbrlib-recipe-order
     4399               .
     4400           end.
     4401       end.
     4402   end.
     4403   end procedure.
     4404   procedure fbrlib-get-trn-type :
     4405   define input parameter p-recipe-code    as character    no-undo.
     4406   define input parameter p-goods-recid    as recid        no-undo.
     4407   define input parameter p-is-integration as logical      no-undo.
     4408   define output parameter p-is-comp       as logical      no-undo.
     4409   define output parameter p-trn-type      as character    no-undo.
     4410   define buffer buf_recipe    for ub.recipe.
     4411   define buffer buf_goods     for ub.goods.
     4412   do
     4413   for buf_recipe
     4414     , buf_goods
     4415   on error undo, return error
     4416   :
     4417       find first buf_goods no-lock
     4418            where recid( buf_goods ) = p-goods-recid
     4419       .
     4420       find first buf_recipe no-lock
     4421            where buf_recipe.recipe-code = p-recipe-code
     4422       no-error.
     4423       if not available buf_recipe
     4424       then do:
     4425           assign
     4426               p-is-comp = no
     4427               p-trn-type = "":U
     4428           .
     4429           undo, return.
     4430       end.
     4431       if  buf_recipe.artic        = buf_goods.artic
     4432       and buf_recipe.prod-type    = buf_goods.prod-type
     4433       and buf_recipe.prod-code    = buf_goods.prod-code
     4434       then do:
     4435           assign
     4436               p-is-comp = yes
     4437           .
     4438       end.
     4439       else do:
     4440           assign
     4441               p-is-comp = no
     4442           .
     4443       end.
     4444       case buf_recipe.recipe-type
     4445       :
     4446           when 'производство':U
     4447           then do:
     4448               if p-is-comp = yes
     4449               then do:
     4450                   assign
     4451                       p-trn-type = 'при':U
     4452                   .
     4453               end.
     4454               else do:
     4455                   assign
     4456                       p-trn-type = 'спи':U
     4457                   .
     4458               end.
     4459           end.
     4460           when 'альтернатива':U
     4461           then do:
     4462               if p-is-comp = yes
     4463               then do:
     4464                   assign
     4465                       p-trn-type = 'при':U
     4466                   .
     4467               end.
     4468               else do:
     4469                   assign
     4470                       p-trn-type = 'спи':U
     4471                   .
     4472               end.
     4473           end.
     4474           when 'разделка':U
     4475           then do:
     4476               if p-is-comp = no
     4477               then do:
     4478                   assign
     4479                       p-trn-type = 'при':U
     4480                   .
     4481               end.
     4482               else do:
     4483                   assign
     4484                       p-trn-type = 'спи':U
     4485                   .
     4486               end.
     4487           end.
     4488           when 'комплектация':U
     4489           then do:
     4490               if p-is-integration = ?
     4491               then do:
     4492                   message
     4493                       "Выберите тип операции по рецепту комплектации:"
     4494                       skip (2) "YES - комплектация"
     4495                       skip     "NO - разукомплектация"
     4496                   view-as alert-box question
     4497                   buttons YES-NO
     4498                   update p-is-integration.
     4499               end.
     4500               if p-is-integration = yes
     4501               then do:
     4502                   if p-is-comp = yes
     4503                   then do:
     4504                       assign
     4505                           p-trn-type = 'при':U
     4506                       .
     4507                   end.
     4508                   else do:
     4509                       assign
     4510                           p-trn-type = 'спи':U
     4511                       .
     4512                   end.
     4513               end.
     4514               else do:
     4515                   if p-is-comp = yes
     4516                   then do:
     4517                       assign
     4518                           p-trn-type = 'спи':U
     4519                       .
     4520                   end.
     4521                   else do:
     4522                       assign
     4523                           p-trn-type = 'при':U
     4524                       .
     4525                   end.
     4526               end.
     4527           end.
     4528       end case.
     4529   end.
     4530   end procedure.
     4531   procedure fbrlib-get-mark :
     4532   define input parameter p-recipe-code    as character    no-undo.
     4533   define output parameter p-mark          as logical    no-undo.
     4534   define buffer buf_goods-attr     for ub.goods-attr.
     4535   define buffer buf_recipe-gds for ub.recipe-gds .
     4536       for each buf_recipe-gds no-lock where buf_recipe-gds.recipe-code = p-recipe-code,
     4537            first buf_goods-attr no-lock where buf_goods-attr.gds-code = buf_recipe-gds.gds-code and
     4538                                               buf_goods-attr.attr-code = 'mark-type':U:
     4539            if buf_goods-attr.attr-value <> "" and buf_goods-attr.attr-value <> "not-type" then do:
     4540               p-mark = true .
     4541               return .
     4542            end.
     4543       end.
     4544   end procedure.
     4545   procedure fbrlib-check-temp-tables :
     4546   do
     4547   on error undo, return error
     4548   :
     4549   define input parameter p-title  as character    no-undo.
     4550       define variable v-str               as character        no-undo.
     4551       assign
     4552           v-str = v-str + chr(10) + "temp_recipe-childs-qnty:" + chr(10)
     4553       .
     4554       for each temp_recipe-childs-qnty
     4555       on error undo, return error
     4556       :
     4557           assign
     4558               v-str   = v-str + string( temp_recipe-childs-qnty.recipe-code )
     4559                       + "   " + string( temp_recipe-childs-qnty.childs-qnty )
     4560                       + "   " + string( temp_recipe-childs-qnty.order )
     4561                       + chr(10)
     4562           .
     4563       end.
     4564       assign
     4565           v-str = v-str + "temp_recipe-childs:" + chr(10)
     4566       .
     4567       for each temp_recipe-childs
     4568       on error undo, return error
     4569       :
     4570           assign
     4571               v-str   = v-str + string( temp_recipe-childs.recipe-code )
     4572                       + "   " + string( temp_recipe-childs.child-code )
     4573                       + "   " + string( temp_recipe-childs.child-recipe-code )
     4574                       + chr(10)
     4575           .
     4576       end.
     4577       assign
     4578           v-str = v-str + chr(10) + "temp_recipe-order:" + chr(10)
     4579       .
     4580       for each temp_recipe-order
     4581       on error undo, return error
     4582       :
     4583           assign
     4584               v-str   = v-str + string( temp_recipe-order.recipe-code )
     4585                       + "   " + string( temp_recipe-order.order )
     4586                       + chr(10)
     4587           .
     4588       end.
     4589       assign
     4590           v-str = v-str + chr(10) + "temp_fbrlib_recipe:" + chr(10)
     4591       .
     4592       run writelog in this-procedure ( input "fbr.log", input 0, input p-title ).
     4593       run writelog in this-procedure ( input "fbr.log", input 0, input v-str ).
     4594       for each temp_fbrlib_recipe
     4595       on error undo, return error
     4596       :
     4597           assign
     4598               v-str   = "recipe-code: "                   + string( temp_fbrlib_recipe.recipe-code                 )
     4599                       + "   " + "count-income: "                  + string( temp_fbrlib_recipe.count-income                )
     4600                       + "   " + "qnty-income: "                   + string( temp_fbrlib_recipe.qnty-income                 )
     4601                       + "   " + "sum-income-sale: "               + string( temp_fbrlib_recipe.sum-income-sale             )
     4602                       + "   " + "sum-income-cost-base: "          + string( temp_fbrlib_recipe.sum-income-cost-base        )
     4603                       + "   " + "sum-income-cost-rubl: "          + string( temp_fbrlib_recipe.sum-income-cost-rubl        )
     4604                       + "   " + "sum-income-vat-cost-base: "      + string( temp_fbrlib_recipe.sum-income-vat-cost-base    )
     4605                       + "   " + "sum-income-vat-cost-rubl: "      + string( temp_fbrlib_recipe.sum-income-vat-cost-rubl    )
     4606                       + "   " + "count-write-off: "               + string( temp_fbrlib_recipe.count-write-off             )
     4607                       + "   " + "qnty-write-off: "                + string( temp_fbrlib_recipe.qnty-write-off              )
     4608                       + "   " + "sum-write-off-sale: "            + string( temp_fbrlib_recipe.sum-write-off-sale          )
     4609                       + "   " + "sum-write-off-cost-base: "       + string( temp_fbrlib_recipe.sum-write-off-cost-base     )
     4610                       + "   " + "sum-write-off-cost-rubl: "       + string( temp_fbrlib_recipe.sum-write-off-cost-rubl     )
     4611                       + "   " + "sum-write-off-vat-cost-base: "   + string( temp_fbrlib_recipe.sum-write-off-vat-cost-base )
     4612                       + "   " + "sum-write-off-vat-cost-rubl: "   + string( temp_fbrlib_recipe.sum-write-off-vat-cost-rubl )
     4613                       + chr(10)
     4614           .
     4615           run writelog in this-procedure ( input "fbr.log", input 0, input v-str ).
     4616       end.
     4617   end.
     4618   end procedure.
     4619   procedure fbrlib-s-coeff-value :
     4620   define input  parameter p-gds-code    as integer        no-undo.
     4621   define input  parameter p-date        as date           no-undo.
     4622   define input  parameter p-obj-type    as character      no-undo.
     4623   define input  parameter p-obj-code    as integer        no-undo.
     4624   define output parameter p-coeff-value as decimal        no-undo.
     4625   define variable vss-description as character init "fbrlib-s-coeff-value-01: определяет значение сезонного коэффициента" no-undo.
     4626       define variable v-date          as date         no-undo.
     4627       define variable v-host-code     as integer      no-undo.
     4628       define buffer buf_goods       for ub.goods.
     4629       define buffer buf_fbr-gds-obj for ub.fbr-gds-obj.
     4630       define buffer buf_clients     for ub.clients.
     4631       define buffer buf_s-coeff     for ub.s-coeff.
     4632   do
     4633   for buf_goods
     4634     , buf_fbr-gds-obj
     4635     , buf_clients
     4636     , buf_s-coeff
     4637   on error undo, return error return-value
     4638   :
     4639       find first buf_goods no-lock
     4640            where buf_goods.gds-code = p-gds-code
     4641       no-error .
     4642       if not available buf_goods
     4643       then do:
     4644          undo, return error substitute("Ошибка при определении сезонного коэффициента - не найден товар с кодом &1", p-gds-code).
     4645       end.
     4646       find first buf_clients no-lock
     4647            where buf_clients.obj-type = p-obj-type
     4648              and buf_clients.obj-code = p-obj-code
     4649       no-error.
     4650       if not available buf_clients
     4651       then do:
     4652          undo, return error substitute("Ошибка при определении сезонного коэффициента - не найден объект &1&2", p-obj-type, p-obj-code).
     4653       end.
     4654       assign
     4655           v-date = date(month(p-date), day(p-date), Year(01/01/1996))
     4656       .
     4657       find first buf_fbr-gds-obj no-lock
     4658            where buf_fbr-gds-obj.gds-code = p-gds-code
     4659              and buf_fbr-gds-obj.obj-type = p-obj-type
     4660              and buf_fbr-gds-obj.obj-code = p-obj-code
     4661       no-error.
     4662       if not available buf_fbr-gds-obj
     4663       or buf_fbr-gds-obj.is-season = no
     4664       then do:
     4665           assign
     4666               p-coeff-value = 0
     4667           .
     4668           return.
     4669       end.
     4670   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4671   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     4672     (input  p-obj-type
     4673     ,input  p-obj-code
     4674     ,output v-host-code
     4675     )  .
     4676       find last buf_s-coeff no-lock
     4677           where buf_s-coeff.gds-code = p-gds-code
     4678             and buf_s-coeff.host-code = v-host-code
     4679             and buf_s-coeff.obj-type = p-obj-type
     4680             and buf_s-coeff.obj-code = p-obj-code
     4681             and buf_s-coeff.s-date <= v-date
     4682       no-error.
     4683       if available buf_s-coeff
     4684       then do:
     4685           assign
     4686               p-coeff-value = buf_s-coeff.coeff-value
     4687           .
     4688           return.
     4689       end.
     4690       find last buf_s-coeff no-lock
     4691           where buf_s-coeff.gds-code = p-gds-code
     4692             and buf_s-coeff.host-code = v-host-code
     4693             and buf_s-coeff.obj-type = "":U
     4694             and buf_s-coeff.obj-code = 0
     4695             and buf_s-coeff.s-date <= v-date
     4696       no-error.
     4697       if available buf_s-coeff
     4698       then do:
     4699           assign
     4700               p-coeff-value = buf_s-coeff.coeff-value
     4701           .
     4702           return.
     4703       end.
     4704       find last buf_s-coeff no-lock
     4705           where buf_s-coeff.gds-code = p-gds-code
     4706             and buf_s-coeff.host-code = 0
     4707             and buf_s-coeff.obj-type = "":U
     4708             and buf_s-coeff.obj-code = 0
     4709             and buf_s-coeff.s-date <= v-date
     4710       no-error.
     4711       if available buf_s-coeff
     4712       then do:
     4713           assign
     4714               p-coeff-value = buf_s-coeff.coeff-value
     4715           .
     4716       end.
     4717       else do:
     4718           assign
     4719               p-coeff-value = 0
     4720           .
     4721       end.
     4722   end.
     4723   end procedure.
     4724   procedure fbrlib_create-fbr-recipe-gds :
     4725   define input parameter p-doc-code         as character      no-undo.
     4726   define input parameter p-recipe-code      as character      no-undo.
     4727   define input parameter p-prod-type        as character      no-undo.
     4728   define input parameter p-prod-code        as integer        no-undo.
     4729   define input parameter p-artic            as character      no-undo.
     4730   define input parameter p-gds-code         as integer        no-undo.
     4731   define input parameter p-is-waste         as logical        no-undo.
     4732   define input parameter p-proc-number      as integer        no-undo.
     4733   define input parameter p-obj-date         as date           no-undo.
     4734   define input parameter p-obj-type         as character      no-undo.
     4735   define input parameter p-obj-code         as integer        no-undo.
     4736   define input parameter p-calc-method      as decimal        no-undo.
     4737   define input parameter p-coeff-waste      as decimal        no-undo.
     4738   define input parameter p-orig-qnty        as decimal        no-undo.
     4739   define input parameter p-orig-brutto-qnty as decimal        no-undo.
     4740       define variable v-coeff-season  as decimal      no-undo.
     4741       define variable v-void-decimal  as decimal      no-undo.
     4742       define variable v-void-integer  as integer      no-undo.
     4743       define variable v-recipe-type   as character    no-undo.
     4744       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     4745       define buffer buf_goods             for ub.goods.
     4746       define buffer buf_recipe            for ub.recipe.
     4747   do
     4748   for buf_fbr-recipe-gds
     4749     , buf_recipe
     4750     , buf_goods
     4751   on error undo, return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     4752   :
     4753       find first buf_fbr-recipe-gds exclusive-lock
     4754            where buf_fbr-recipe-gds.doc-code    = p-doc-code
     4755              and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     4756              and buf_fbr-recipe-gds.prod-type   = p-prod-type
     4757              and buf_fbr-recipe-gds.prod-code   = p-prod-code
     4758              and buf_fbr-recipe-gds.artic       = p-artic
     4759       no-error.
     4760       if not available buf_fbr-recipe-gds
     4761       then do:
     4762           create buf_fbr-recipe-gds.
     4763           assign
     4764               buf_fbr-recipe-gds.doc-code           = p-doc-code
     4765               buf_fbr-recipe-gds.recipe-code        = p-recipe-code
     4766               buf_fbr-recipe-gds.prod-type          = p-prod-type
     4767               buf_fbr-recipe-gds.prod-code          = p-prod-code
     4768               buf_fbr-recipe-gds.artic              = p-artic
     4769               buf_fbr-recipe-gds.gds-code           = p-gds-code
     4770               buf_fbr-recipe-gds.is-waste           = p-is-waste
     4771               buf_fbr-recipe-gds.proc-number        = p-proc-number
     4772               buf_fbr-recipe-gds.recipe-qnty        = p-orig-qnty
     4773               buf_fbr-recipe-gds.recipe-brutto-qnty = p-orig-brutto-qnty
     4774           .
     4775           find first buf_goods no-lock
     4776                where buf_goods.prod-type = buf_fbr-recipe-gds.prod-type
     4777                  and buf_goods.prod-code = buf_fbr-recipe-gds.prod-code
     4778                  and buf_goods.artic     = buf_fbr-recipe-gds.artic
     4779           .
     4780           run fbrlib-s-coeff-value in this-procedure (
     4781                 input buf_goods.gds-code
     4782               , input p-obj-date
     4783               , input p-obj-type
     4784               , input p-obj-code
     4785               , output v-coeff-season
     4786           ) no-error.
     4787           if error-status:error
     4788           then do:
     4789               return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)).
     4790           end.
     4791           assign
     4792               buf_fbr-recipe-gds.qnty         = p-orig-qnty
     4793               buf_fbr-recipe-gds.coeff-value  = v-coeff-season
     4794               buf_fbr-recipe-gds.coeff-waste  = p-coeff-waste
     4795           .
     4796           run fbrlib-get-recipe-type in this-procedure (
     4797                 input buf_fbr-recipe-gds.doc-code
     4798               , input buf_fbr-recipe-gds.recipe-code
     4799               , output v-recipe-type
     4800           ).
     4801           if v-recipe-type <> 'производство':U
     4802           then do:
     4803               assign
     4804                   buf_fbr-recipe-gds.coeff-value  = 0
     4805                   buf_fbr-recipe-gds.coeff-waste  = 0
     4806                   buf_fbr-recipe-gds.calc-method  = 1
     4807                   buf_fbr-recipe-gds.brutto-qnty  = buf_fbr-recipe-gds.qnty
     4808               .
     4809           end.
     4810           else do:
     4811               run fbrlib-calc-brutto in this-procedure (
     4812                     input v-recipe-type
     4813                   , input buf_fbr-recipe-gds.qnty
     4814                   , input buf_fbr-recipe-gds.coeff-value
     4815                   , input buf_fbr-recipe-gds.coeff-waste
     4816                   , input 0
     4817                   , input 3
     4818                   , output v-void-decimal
     4819                   , output v-void-decimal
     4820                   , output buf_fbr-recipe-gds.brutto-qnty
     4821                   , output v-void-integer
     4822               ).
     4823               assign
     4824                   buf_fbr-recipe-gds.calc-method  = p-calc-method
     4825               .
     4826               run fbrlib-calc-brutto in this-procedure (
     4827                     input v-recipe-type
     4828                   , input buf_fbr-recipe-gds.qnty
     4829                   , input buf_fbr-recipe-gds.coeff-value
     4830                   , input buf_fbr-recipe-gds.coeff-waste
     4831                   , input buf_fbr-recipe-gds.brutto-qnty
     4832                   , input buf_fbr-recipe-gds.calc-method
     4833                   , output buf_fbr-recipe-gds.qnty
     4834                   , output v-void-decimal
     4835                   , output v-void-decimal
     4836                   , output v-void-integer
     4837               ).
     4838           end.
     4839       end.
     4840   end.
     4841   end procedure.
     4842   procedure fbrlib-set-default-recipe :
     4843   define input parameter p-obj-type   as character    no-undo.
     4844   define input parameter p-obj-code   as integer      no-undo.
     4845   define input parameter p-gds-code   as integer      no-undo.
     4846       define variable v-artic             as character    no-undo.
     4847       define variable v-prod-type         as character    no-undo.
     4848       define variable v-prod-code         as character    no-undo.
     4849       define variable v-recipe-code       as character    no-undo.
     4850       define variable v-fbr-gds-obj-recid as recid        no-undo.
     4851       define variable v-recipe-found      as logical      no-undo.
     4852       define buffer buf_recipe        for ub.recipe.
     4853       define buffer buf_other_recipe  for ub.recipe.
     4854       define buffer buf_goods         for ub.goods.
     4855       define buffer buf_fbr-gds-obj   for ub.fbr-gds-obj.
     4856   do
     4857   for buf_recipe
     4858     , buf_goods
     4859     , buf_fbr-gds-obj
     4860   on error undo, return error
     4861   :
     4862       find first buf_goods no-lock
     4863            where buf_goods.gds-code = p-gds-code
     4864       .
     4865       run fbrlib-get-obj-recipe in this-procedure (
     4866             input p-obj-type
     4867           , input p-obj-code
     4868           , input p-gds-code
     4869           , output v-recipe-code
     4870       ).
     4871       if v-recipe-code <> ""
     4872       then do:
     4873           find first buf_recipe no-lock
     4874               where buf_recipe.recipe-code = v-recipe-code
     4875           no-error.
     4876           if not available buf_recipe
     4877           then do:
     4878               assign
     4879                   v-recipe-code = ""
     4880               .
     4881           end.
     4882       end.
     4883       if v-recipe-code = ""
     4884       then do:
     4885           find first buf_fbr-gds-obj exclusive-lock
     4886                where buf_fbr-gds-obj.obj-type = p-obj-type
     4887                  and buf_fbr-gds-obj.obj-code = p-obj-code
     4888                  and buf_fbr-gds-obj.gds-code = p-gds-code
     4889           no-error.
     4890           if not available buf_fbr-gds-obj
     4891           then do:
     4892               run ref/fgdsobj1.p (
     4893                     input-output v-fbr-gds-obj-recid
     4894                   , input 'ДОБАВЛЕНИЕ':U
     4895                   , input no
     4896                   , input p-gds-code
     4897                   , input p-obj-type
     4898                   , input p-obj-code
     4899                   , input 0
     4900                   , input ""
     4901                   , input 0
     4902                   , input no
     4903                   , input no
     4904                   , input no
     4905                   , input no
     4906                   , input no
     4907                   , input no
     4908               ) no-error.
     4909               if error-status:error
     4910               then do:
     4911                   message
     4912                           vss-workfile vss-revision vss-description
     4913                       skip "Ошибка изменения атрибутов товара на объекте"
     4914                       skip return-value
     4915                       skip trim(error-status :get-message(1))
     4916                               trim(error-status :get-message(2))
     4917                               trim(error-status :get-message(3))
     4918                   view-as alert-box error.
     4919                   undo, return error .
     4920               end.
     4921               find first buf_fbr-gds-obj exclusive-lock
     4922                    where recid( buf_fbr-gds-obj ) = v-fbr-gds-obj-recid
     4923               .
     4924           end.
     4925           assign
     4926               v-recipe-found = no
     4927           .
     4928           for first buf_recipe no-lock
     4929               where buf_recipe.obj-type    = p-obj-type
     4930                 and buf_recipe.obj-code    = p-obj-code
     4931                 and buf_recipe.artic       = buf_goods.artic
     4932                 and buf_recipe.prod-type   = buf_goods.prod-type
     4933                 and buf_recipe.prod-code   = buf_goods.prod-code
     4934                 and buf_recipe.recipe-type = 'производство':U
     4935                 or (
     4936                     buf_recipe.obj-type    = ""
     4937                 and buf_recipe.obj-code    = 0
     4938                 and buf_recipe.artic       = buf_goods.artic
     4939                 and buf_recipe.prod-type   = buf_goods.prod-type
     4940                 and buf_recipe.prod-code   = buf_goods.prod-code
     4941                 and buf_recipe.recipe-type = 'производство':U
     4942                     )
     4943           :
     4944               assign
     4945                   v-recipe-found = yes
     4946                   buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     4947               .
     4948           end.
     4949           if v-recipe-found = no
     4950           then do:
     4951               for first buf_recipe no-lock
     4952                   where buf_recipe.obj-type    = p-obj-type
     4953                     and buf_recipe.obj-code    = p-obj-code
     4954                     and buf_recipe.artic       = buf_goods.artic
     4955                     and buf_recipe.prod-type   = buf_goods.prod-type
     4956                     and buf_recipe.prod-code   = buf_goods.prod-code
     4957                     and buf_recipe.recipe-type <> 'альтернатива':U
     4958                     or (
     4959                         buf_recipe.obj-type    = ""
     4960                     and buf_recipe.obj-code    = 0
     4961                     and buf_recipe.artic       = buf_goods.artic
     4962                     and buf_recipe.prod-type   = buf_goods.prod-type
     4963                     and buf_recipe.prod-code   = buf_goods.prod-code
     4964                     and buf_recipe.recipe-type <> 'альтернатива':U
     4965                         )
     4966               :
     4967                   assign
     4968                       v-recipe-found = yes
     4969                       buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     4970                   .
     4971               end.
     4972               if v-recipe-found = no
     4973               then do:
     4974                   for first buf_recipe no-lock
     4975                       where buf_recipe.obj-type    = p-obj-type
     4976                         and buf_recipe.obj-code    = p-obj-code
     4977                         and buf_recipe.artic       = buf_goods.artic
     4978                         and buf_recipe.prod-type   = buf_goods.prod-type
     4979                         and buf_recipe.prod-code   = buf_goods.prod-code
     4980                         or (
     4981                             buf_recipe.obj-type    = ""
     4982                         and buf_recipe.obj-code    = 0
     4983                         and buf_recipe.artic       = buf_goods.artic
     4984                         and buf_recipe.prod-type   = buf_goods.prod-type
     4985                         and buf_recipe.prod-code   = buf_goods.prod-code
     4986                             )
     4987                   :
     4988                       assign
     4989                           v-recipe-found = yes
     4990                           buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     4991                       .
     4992                   end.
     4993                   if v-recipe-found = no
     4994                   then do:
     4995                       assign
     4996                           buf_fbr-gds-obj.default-recipe-code = ""
     4997                       .
     4998                   end.
     4999               end.
     5000           end.
     5001       end.
     5002   end.
     5003   end procedure.
     5004   procedure fbrlib-get-obj-recipe :
     5005   define input parameter p-obj-type       as character    no-undo.
     5006   define input parameter p-obj-code       as integer      no-undo.
     5007   define input parameter p-gds-code       as integer      no-undo.
     5008   define output parameter p-recipe-code   as character    no-undo.
     5009       define buffer buf_fbr-gds-obj   for ub.fbr-gds-obj.
     5010   do
     5011   for buf_fbr-gds-obj
     5012   on error undo, return error
     5013   :
     5014       find first buf_fbr-gds-obj no-lock
     5015            where buf_fbr-gds-obj.obj-type = p-obj-type
     5016              and buf_fbr-gds-obj.obj-code = p-obj-code
     5017              and buf_fbr-gds-obj.gds-code = p-gds-code
     5018       no-error.
     5019       if available buf_fbr-gds-obj
     5020       then do:
     5021           assign
     5022               p-recipe-code = buf_fbr-gds-obj.default-recipe-code
     5023           .
     5024       end.
     5025       else do:
     5026           assign
     5027               p-recipe-code = ""
     5028           .
     5029       end.
     5030   end.
     5031   end procedure.
     5032   procedure fbrlib-create-or-update-recipe-gds :
     5033   define input parameter p-recipe-code    as character        no-undo.
     5034   define input parameter p-gds-code       as integer          no-undo.
     5035   define input parameter p-is-waste       as logical          no-undo.
     5036   define input parameter p-qnty           as decimal          no-undo.
     5037   define input parameter p-proc-number    as integer          no-undo.
     5038   define input parameter p-nws-self       as logical          no-undo.
     5039       define variable v-max-proc-num  as integer      no-undo.
     5040       define variable v-recipe-type   as character    no-undo.
     5041       define buffer buf_goods             for ub.goods.
     5042       define buffer buf_recipe-gds        for ub.recipe-gds.
     5043       define buffer buf_recipe            for ub.recipe.
     5044       define buffer buf_proc_recipe-gds   for ub.recipe-gds.
     5045   do
     5046   for buf_goods
     5047     , buf_recipe-gds
     5048     , buf_recipe
     5049     , buf_proc_recipe-gds
     5050   on error undo, return error
     5051   :
     5052       find first buf_recipe no-lock
     5053            where buf_recipe.recipe-code = p-recipe-code
     5054       .
     5055       find first buf_goods no-lock
     5056            where buf_goods.gds-code = p-gds-code
     5057       .
     5058       find first buf_recipe-gds
     5059            where buf_recipe-gds.recipe-code = p-recipe-code
     5060              and buf_recipe-gds.prod-type   = buf_goods.prod-type
     5061              and buf_recipe-gds.prod-code   = buf_goods.prod-code
     5062              and buf_recipe-gds.artic       = buf_goods.artic
     5063       no-error.
     5064       if not available buf_recipe-gds
     5065       then do:
     5066           create buf_recipe-gds.
     5067           assign
     5068               buf_recipe-gds.recipe-code = p-recipe-code
     5069               buf_recipe-gds.gds-code    = p-gds-code
     5070               buf_recipe-gds.prod-type   = buf_goods.prod-type
     5071               buf_recipe-gds.prod-code   = buf_goods.prod-code
     5072               buf_recipe-gds.artic       = buf_goods.artic
     5073           .
     5074           assign
     5075               buf_recipe-gds.is-waste    = no
     5076               buf_recipe-gds.qnty        = 0
     5077               buf_recipe-gds.coeff-waste = 0
     5078               buf_recipe-gds.brutto-qnty = 0
     5079               buf_recipe-gds.proc-number = 0
     5080               buf_recipe-gds.nws-self    = no
     5081           .
     5082       end.
     5083       assign
     5084           buf_recipe-gds.is-waste    = p-is-waste
     5085       .
     5086       run fbrlib-get-recipe-type in this-procedure (
     5087             input "":U
     5088           , input buf_recipe-gds.recipe-code
     5089           , output v-recipe-type
     5090       ).
     5091       if v-recipe-type <> 'производство':U
     5092       then do:
     5093           assign
     5094               buf_recipe-gds.calc-method = 1
     5095               buf_recipe-gds.qnty        = p-qnty
     5096               buf_recipe-gds.brutto-qnty = p-qnty
     5097               buf_recipe-gds.coeff-waste = 0
     5098           .
     5099       end.
     5100       else do:
     5101           assign
     5102               buf_recipe-gds.calc-method = 1
     5103               buf_recipe-gds.brutto-qnty = p-qnty
     5104           .
     5105           run fbrlib-calc-brutto in this-procedure (
     5106                 input v-recipe-type
     5107               , input 0
     5108               , input 0
     5109               , input buf_recipe-gds.coeff-waste
     5110               , input buf_recipe-gds.brutto-qnty
     5111               , input 1
     5112               , output buf_recipe-gds.qnty
     5113               , output buf_recipe-gds.coeff-waste
     5114               , output buf_recipe-gds.brutto-qnty
     5115               , output buf_recipe-gds.calc-method
     5116           ).
     5117       end.
     5118       assign
     5119           buf_recipe-gds.nws-self    = p-nws-self
     5120       .
     5121       if buf_recipe.recipe-type = 'альтернатива':U
     5122       and buf_recipe-gds.proc-number <> 0
     5123       then do:
     5124       end.
     5125       else do:
     5126           if p-proc-number <> 0
     5127           then do:
     5128               assign
     5129                   buf_recipe-gds.proc-number = p-proc-number
     5130               .
     5131           end.
     5132           else do:
     5133               assign
     5134                   v-max-proc-num = 0
     5135               .
     5136               for each buf_proc_recipe-gds no-lock
     5137                  where buf_proc_recipe-gds.recipe-code = p-recipe-code
     5138               :
     5139                   if recid( buf_proc_recipe-gds ) <> recid( buf_recipe-gds )
     5140                   then do:
     5141                       assign
     5142                           v-max-proc-num = ( if v-max-proc-num < buf_proc_recipe-gds.proc-number then buf_proc_recipe-gds.proc-number else v-max-proc-num )
     5143                       .
     5144                   end.
     5145               end.
     5146               assign
     5147                   buf_recipe-gds.proc-number = v-max-proc-num + 1
     5148               .
     5149           end.
     5150       end.
     5151   end.
     5152   end procedure.
     5153   PROCEDURE fbrlib-create-or-update-recipe :
     5154   define input parameter p-mode               as character    no-undo.
     5155   define input parameter p-obj-type           as character    no-undo.
     5156   define input parameter p-obj-code           as integer      no-undo.
     5157   define input parameter p-recipe-code        as character    no-undo.
     5158   define input parameter p-recipe-type        as character    no-undo.
     5159   define input parameter p-gds-code           as integer      no-undo.
     5160   define input parameter p-name               as character    no-undo.
     5161   define input parameter p-design             as character    no-undo.
     5162   define input parameter p-order              as integer      no-undo.
     5163   define input parameter p-quality            as character    no-undo.
     5164   define input parameter p-ref-num            as character    no-undo.
     5165   define input parameter p-technique          as character    no-undo.
     5166   define input parameter p-template           as character    no-undo.
     5167   define input parameter p-qnty               as decimal      no-undo.
     5168   define input parameter p-portion-qnty       as integer      no-undo.
     5169   define input parameter p-portion-weight     as decimal      no-undo.
     5170   define output parameter p-new-recipe-code   as character    no-undo.
     5171       define variable v-host-code         as integer      no-undo.
     5172       define variable v-fbr-gds-obj-recid as recid        no-undo.
     5173       define buffer buf_recipe    for ub.recipe.
     5174       define buffer buf_goods     for ub.goods.
     5175   do
     5176   for buf_recipe
     5177     , buf_goods
     5178   on error undo, return error
     5179   :
     5180       if p-mode <> 'ДОБАВЛЕНИЕ':U
     5181       and p-mode <> 'ИЗМЕНЕНИЕ':U
     5182       then do:
     5183           message
     5184               skip "Ошибка задания типа операции для создания или измения рецепта."
     5185               skip (1)
     5186               skip "Задан тип операции:" p-mode
     5187           view-as alert-box error.
     5188           undo, return error .
     5189       end.
     5190       if p-recipe-code = ""
     5191       then do:
     5192   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5193   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     5194     (input  p-obj-type
     5195     ,input  p-obj-code
     5196     ,output v-host-code
     5197     )  .
     5198           find first buf_goods no-lock
     5199                where buf_goods.gds-code = p-gds-code
     5200           .
     5201           create buf_recipe .
     5202           run fbrcode-gen-recipe-code in this-procedure (
     5203                 input p-obj-type
     5204               , input p-obj-code
     5205               , output buf_recipe.recipe-code
     5206           ).
     5207           assign
     5208               buf_recipe.artic               = buf_goods.artic
     5209               buf_recipe.prod-type           = buf_goods.prod-type
     5210               buf_recipe.prod-code           = buf_goods.prod-code
     5211               buf_recipe.recipe-type         = p-recipe-type
     5212               buf_recipe.recipe-name         = ( if p-name = "" then buf_goods.gds-name else p-name )
     5213               buf_recipe.gds-code            = p-gds-code
     5214               buf_recipe.host-code           = v-host-code
     5215               buf_recipe.obj-type            = p-obj-type
     5216               buf_recipe.obj-code            = p-obj-code
     5217               buf_recipe.recipe-design       = ""
     5218               buf_recipe.recipe-order        = 0
     5219               buf_recipe.recipe-quality      = ""
     5220               buf_recipe.recipe-ref-num      = ""
     5221               buf_recipe.recipe-technique    = ""
     5222               buf_recipe.recipe-template     = ""
     5223               buf_recipe.qnty                = 1.0
     5224               buf_recipe.portion-qnty        = 1
     5225               buf_recipe.portion-weight      = 0
     5226           .
     5227       end.
     5228       if p-name <> ""
     5229       then do:
     5230           assign
     5231               buf_recipe.recipe-name = p-name
     5232           .
     5233       end.
     5234       assign
     5235           buf_recipe.recipe-design       = p-design
     5236           buf_recipe.recipe-order        = p-order
     5237           buf_recipe.recipe-quality      = p-quality
     5238           buf_recipe.recipe-ref-num      = p-ref-num
     5239           buf_recipe.recipe-technique    = p-technique
     5240           buf_recipe.recipe-template     = p-template
     5241           buf_recipe.qnty                = p-qnty
     5242           buf_recipe.portion-qnty        = p-portion-qnty
     5243           buf_recipe.portion-weight      = p-portion-weight
     5244       .
     5245       assign
     5246           p-new-recipe-code = buf_recipe.recipe-code
     5247       .
     5248       run fbrlib-set-default-recipe in this-procedure (
     5249             input p-obj-type
     5250           , input p-obj-code
     5251           , input buf_goods.gds-code
     5252       ).
     5253   end.
     5254   END PROCEDURE.
     5255   PROCEDURE fbrlib-delete-fact-fbr-doc :
     5256   define input parameter parparentproc-handle as widget-handle no-undo .
     5257   define input parameter p-doc-code   as character no-undo.
     5258   define input parameter p-chip-num   like ub.c-trn-doc.chip-num no-undo .
     5259       define variable v-shift-on      as logical      no-undo.
     5260       define variable v-shift-date    as date         no-undo.
     5261       define variable v-shift-num     as integer      no-undo.
     5262       define variable v-shift-name    as character    no-undo.
     5263       define variable v-obj-date      as date         no-undo.
     5264       define variable v-chip-num      as integer      no-undo.
     5265       define buffer buf_fbr-doc       for ub.fbr-doc.
     5266       define buffer buf_fbr-line      for ub.fbr-line.
     5267       define buffer buf_c-fbr-doc     for ub.c-fbr-doc.
     5268       define buffer buf_fbr-recipe     for ub.fbr-recipe.
     5269       define buffer buf_fbr-recipe-gds for ub.fbr-recipe-gds.
     5270       define buffer buf_marking-lines for ub.marking-lines .
     5271       define buffer buf_marking       for ub.marking .
     5272       define buffer buf_goods         for ub.goods .
     5273   do
     5274   for buf_fbr-doc
     5275     , buf_fbr-line
     5276     , buf_c-fbr-doc
     5277     , buf_fbr-recipe
     5278     , buf_fbr-recipe-gds
     5279     , buf_goods
     5280     , buf_marking
     5281     , buf_marking-lines
     5282   on error undo, return error
     5283   :
     5284   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5285     define variable v-cntxt-db-num        as integer   no-undo .
     5286     define variable v-cntxt-userid        as character no-undo .
     5287     define variable v-cntxt-level         as character no-undo .
     5288     define variable v-cntxt-host-code-obj as integer   no-undo .
     5289     define variable v-cntxt-obj-type      as character no-undo .
     5290     define variable v-cntxt-obj-code      as integer   no-undo .
     5291     define variable v-cntxt-db-num-obj    as integer   no-undo .
     5292     define variable v-cntxt-is-admin      as logical   no-undo .
     5293   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5294     run mainmenu_getcntxt in parparentproc-handle
     5295       (output v-cntxt-db-num
     5296       ,output v-cntxt-userid
     5297       ,output v-cntxt-level
     5298       ,output v-cntxt-host-code-obj
     5299       ,output v-cntxt-obj-type
     5300       ,output v-cntxt-obj-code
     5301       ,output v-cntxt-db-num-obj
     5302       ,output v-cntxt-is-admin
     5303       ) .
     5304       if search ("delfbr.err") <> ?
     5305       then do:
     5306           os-delete "delfbr.err".
     5307       end.
     5308     _del-block:
     5309       do transaction
     5310     on error undo _del-block, return error return-value
     5311     on endkey undo _del-block , return error return-value
     5312     on stop undo _del-block , return error return-value
     5313       :
     5314           find first buf_fbr-doc exclusive-lock
     5315                where buf_fbr-doc.doc-code = p-doc-code
     5316           no-error.
     5317           if not available buf_fbr-doc
     5318           then do:
     5319         undo _del-block, return error substitute("&1 &2 &3&4Не найден документ производства &5 для удаления."
     5320                                           ,vss-workfile
     5321                                           ,vss-revision
     5322                                           ,vss-description
     5323                                           ,chr(10)
     5324                                           , p-doc-code).
     5325           end.
     5326           run fbrlib-delete-fact-trn-doc in this-procedure (
     5327               input parparentproc-handle
     5328              ,input p-doc-code
     5329              ,input 'при':U
     5330              ,input p-chip-num
     5331              ,output v-chip-num
     5332           ) no-error.
     5333           if error-status :error
     5334           then do:
     5335               run fbrlib-print-del-error-message in this-procedure .
     5336         undo _del-block, return error.
     5337           end.
     5338           assign
     5339           p-chip-num = (if p-chip-num = ?
     5340                         then v-chip-num
     5341                         else p-chip-num).
     5342           run fbrlib-delete-fact-trn-doc in this-procedure (
     5343               input parparentproc-handle
     5344              ,input p-doc-code
     5345              ,input 'рас':U
     5346              ,input p-chip-num
     5347              ,output v-chip-num
     5348           ) no-error.
     5349           if error-status :error
     5350           then do:
     5351               run fbrlib-print-del-error-message in this-procedure .
     5352         undo _del-block, return error.
     5353           end.
     5354           run fbrlib-delete-fact-trn-doc in this-procedure (
     5355               input parparentproc-handle
     5356              ,input p-doc-code
     5357              ,input 'спи':U
     5358              ,input p-chip-num
     5359              ,output v-chip-num
     5360           ) no-error.
     5361           if error-status :error
     5362           then do:
     5363               run fbrlib-print-del-error-message in this-procedure .
     5364         undo _del-block, return error.
     5365           end.
     5366           create buf_c-fbr-doc.
     5367           buffer-copy buf_fbr-doc to buf_c-fbr-doc.
     5368   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5369   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     5370     (input  buf_fbr-doc.obj-type
     5371     ,input  buf_fbr-doc.obj-code
     5372     ,output v-obj-date
     5373     ) no-error .
     5374           if error-status :error
     5375           or v-obj-date = ?
     5376           then do:
     5377         undo _del-block, return error "Нет текущей даты на объекте документа.".
     5378           end.
     5379   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5380   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     5381     (input  buf_fbr-doc.obj-type
     5382     ,input  buf_fbr-doc.obj-code
     5383     ,input  'shift-on=request'
     5384     ,output v-shift-on
     5385     )  .
     5386           if v-shift-on
     5387           then do:
     5388   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5389   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curshift in g#library
     5390     (input  buf_fbr-doc.obj-type
     5391     ,input  buf_fbr-doc.obj-code
     5392     ,output v-shift-date
     5393     ,output v-shift-num
     5394     ,output v-shift-name
     5395     ) no-error .
     5396               if error-status :error
     5397               then do:
     5398           undo _del-block, return error "Ошибка при поиске текущей смены на объекте".
     5399               end.
     5400           end.
     5401           else do:
     5402               assign
     5403                   v-shift-date = ?
     5404                   v-shift-num  = ?
     5405                   v-shift-name = ?
     5406               .
     5407           end.
     5408           define variable v-today       as date         no-undo.
     5409           define variable v-time        as integer      no-undo.
     5410           run cur-time in this-procedure (
     5411                 output v-today
     5412               , output v-time
     5413           ).
     5414           assign
     5415               buf_c-fbr-doc.chip-num         = (if p-chip-num <> ? then p-chip-num else next-value( s-corr-chip, ub  ))
     5416               buf_c-fbr-doc.corr-user-name   = v-cntxt-userid
     5417               buf_c-fbr-doc.corr-user-db-num = v-cntxt-db-num
     5418               buf_c-fbr-doc.corr-date        = v-today
     5419               buf_c-fbr-doc.corr-time        = v-time
     5420               buf_c-fbr-doc.corr-shift-date  = v-shift-date
     5421               buf_c-fbr-doc.corr-shift-num   = v-shift-num
     5422               buf_c-fbr-doc.corr-shift-name  = v-shift-name
     5423               buf_c-fbr-doc.is-del           = yes
     5424           .
     5425           assign
     5426               buf_fbr-doc.is-del = yes
     5427           .
     5428           for each buf_fbr-line exclusive-lock
     5429              where buf_fbr-line.doc-code = p-doc-code
     5430       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     5431       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     5432       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     5433           :
     5434               for first buf_goods no-lock where buf_goods.artic      = buf_fbr-line.artic
     5435                                             and buf_goods.prod-type  = buf_fbr-line.prod-type
     5436                                             and buf_goods.prod-code  = buf_fbr-line.prod-code,
     5437               each buf_marking-lines exclusive-lock where buf_marking-lines.gds-code = buf_goods.gds-code
     5438                                                       and buf_marking-lines.obj-type = buf_fbr-doc.obj-type
     5439                                                       and buf_marking-lines.obj-code = buf_fbr-doc.obj-code
     5440                                                       and buf_marking-lines.in-code  = "manufacturing"
     5441                                                       and buf_marking-lines.out-code = buf_fbr-line.doc-code
     5442                                                       and buf_marking-lines.part-code = buf_fbr-line.recipe-code
     5443                                                       and buf_marking-lines.prt-code = 0
     5444               :
     5445                 for first buf_marking exclusive-lock where buf_marking.mark begins buf_marking-lines.mark :
     5446                   assign
     5447                     buf_marking.sts = objSrv:Env:Marking:Sts:Mark:UsedInProduction:KeyIntDB when buf_fbr-line.is-comp
     5448                   .
     5449                 end .
     5450                 delete buf_marking-lines.
     5451               end .
     5452               delete buf_fbr-line.
     5453           end.
     5454           for each buf_fbr-recipe exclusive-lock
     5455              where buf_fbr-recipe.doc-code = p-doc-code
     5456       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     5457       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     5458       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     5459           :
     5460               delete buf_fbr-recipe.
     5461           end.
     5462           for each buf_fbr-recipe-gds exclusive-lock
     5463              where buf_fbr-recipe-gds.doc-code = p-doc-code
     5464       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     5465       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     5466       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     5467           :
     5468               delete buf_fbr-recipe-gds.
     5469           end.
     5470           delete buf_fbr-doc.
     5471       end.
     5472   end.
     5473   END PROCEDURE.
     5474   PROCEDURE fbrlib-del-trn-doc :
     5475   do
     5476   on error undo, return error
     5477   :
     5478   define input parameter parparentproc        as widget-handle no-undo .
     5479   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     5480   define input parameter p-trn-doc-type       as character    no-undo.
     5481   define input parameter p-phchip-num         like ub.c-trn-doc.chip-num no-undo .
     5482   define output parameter p-chip-num           like ub.c-trn-doc.chip-num no-undo .
     5483       define variable v-trn-doc-doc-code  as character     no-undo.
     5484       define buffer buf_trn-doc       for ub.trn-doc.
     5485   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5486     define variable v-cntxt-db-num        as integer   no-undo .
     5487     define variable v-cntxt-userid        as character no-undo .
     5488     define variable v-cntxt-level         as character no-undo .
     5489     define variable v-cntxt-host-code-obj as integer   no-undo .
     5490     define variable v-cntxt-obj-type      as character no-undo .
     5491     define variable v-cntxt-obj-code      as integer   no-undo .
     5492     define variable v-cntxt-db-num-obj    as integer   no-undo .
     5493     define variable v-cntxt-is-admin      as logical   no-undo .
     5494   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5495     run mainmenu_getcntxt in parparentproc
     5496       (output v-cntxt-db-num
     5497       ,output v-cntxt-userid
     5498       ,output v-cntxt-level
     5499       ,output v-cntxt-host-code-obj
     5500       ,output v-cntxt-obj-type
     5501       ,output v-cntxt-obj-code
     5502       ,output v-cntxt-db-num-obj
     5503       ,output v-cntxt-is-admin
     5504       ) .
     5505       run fbrcode-trn-doc in this-procedure (
     5506             input 'производство':U
     5507           , input p-fbr-doc-doc-code
     5508           , input p-trn-doc-type
     5509           , output v-trn-doc-doc-code
     5510       ).
     5511       find first buf_trn-doc no-lock
     5512            where buf_trn-doc.doc-code = v-trn-doc-doc-code
     5513       no-error.
     5514       if available buf_trn-doc
     5515       then do:
     5516           run str/del-doc.p (
     5517                 input parparentproc
     5518               , input buf_trn-doc.doc-code
     5519               , input v-cntxt-db-num
     5520               , input "del-doc.err"
     5521               , input ?
     5522               , input p-fbr-doc-doc-code
     5523               , input v-cntxt-userid
     5524               , input 0
     5525               , input p-phchip-num
     5526               , output p-chip-num
     5527           ) no-error.
     5528           if error-status :error
     5529           then do:
     5530             undo, return error substitute("Не удалось удалить складской документ &1, созданный по документу производства &2.&3&4&3&5"
     5531                                           ,v-trn-doc-doc-code
     5532                                           ,p-fbr-doc-doc-code
     5533                                           , chr(10)
     5534                                           , error-status:get-message(1)
     5535                                           , return-value ).
     5536           end.
     5537       end.
     5538   end.
     5539   END PROCEDURE.
     5540   PROCEDURE fbrlib-delete-fact-trn-doc :
     5541   define input parameter parparentproc    as widget-handle    no-undo.
     5542   define input parameter p-fbr-doc-code   as character        no-undo.
     5543   define input parameter p-doc-type       as character    no-undo.
     5544   define input parameter p-ph-chip-num       like ub.c-trn-doc.chip-num no-undo .
     5545   define output parameter p-chip-num      like ub.c-trn-doc.chip-num no-undo .
     5546       define variable v-doc-code          as character        no-undo.
     5547       define variable v-ext-doc-type      as character        no-undo.
     5548       define variable v-trn-doc-recid     as recid            no-undo.
     5549       define variable varchip-code        as integer          no-undo.
     5550       define variable varchip-code2       as integer          no-undo.
     5551       define variable v-chip-counter      as integer          no-undo.
     5552       define buffer buf_trn-doc       for ub.trn-doc.
     5553       define buffer buf_pri_trn-doc   for ub.trn-doc.
     5554       define buffer buf_cons_trn-doc  for ub.trn-doc.
     5555   do
     5556   for buf_trn-doc
     5557     , buf_pri_trn-doc
     5558     , buf_cons_trn-doc
     5559   on error undo, return error
     5560   :
     5561   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5562     define variable v-cntxt-db-num        as integer   no-undo .
     5563     define variable v-cntxt-userid        as character no-undo .
     5564     define variable v-cntxt-level         as character no-undo .
     5565     define variable v-cntxt-host-code-obj as integer   no-undo .
     5566     define variable v-cntxt-obj-type      as character no-undo .
     5567     define variable v-cntxt-obj-code      as integer   no-undo .
     5568     define variable v-cntxt-db-num-obj    as integer   no-undo .
     5569     define variable v-cntxt-is-admin      as logical   no-undo .
     5570   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5571     run mainmenu_getcntxt in parparentproc
     5572       (output v-cntxt-db-num
     5573       ,output v-cntxt-userid
     5574       ,output v-cntxt-level
     5575       ,output v-cntxt-host-code-obj
     5576       ,output v-cntxt-obj-type
     5577       ,output v-cntxt-obj-code
     5578       ,output v-cntxt-db-num-obj
     5579       ,output v-cntxt-is-admin
     5580       ) .
     5581       run fbrcode-trn-doc in this-procedure (
     5582             input 'производство':U
     5583           , input p-fbr-doc-code
     5584           , input p-doc-type
     5585           , output v-doc-code
     5586       ).
     5587       find first buf_trn-doc no-lock
     5588            where buf_trn-doc.doc-code = v-doc-code
     5589       no-error.
     5590       if not available buf_trn-doc
     5591       then do:
     5592           if p-doc-type <> 'спи':U
     5593           then do:
     5594               message
     5595                   "Не найден документ '" p-doc-type "'"
     5596                   "по документу производства " p-fbr-doc-code
     5597               view-as alert-box.
     5598               undo, return error.
     5599           end.
     5600           else do:
     5601           end.
     5602       end.
     5603       else do:
     5604           assign
     5605               v-trn-doc-recid = recid( buf_trn-doc )
     5606               v-ext-doc-type  = buf_trn-doc.ext-doc-type
     5607           .
     5608           if v-ext-doc-type = 'ev':U
     5609           then do:
     5610               find first buf_pri_trn-doc no-lock
     5611                    where buf_pri_trn-doc.out-code     = v-doc-code
     5612                      and buf_pri_trn-doc.ext-doc-type = 'iv':U
     5613               no-error.
     5614               if available buf_pri_trn-doc
     5615               then do:
     5616                   run str/del-doc.p (
     5617                         input parparentproc
     5618                       , input buf_pri_trn-doc.doc-code
     5619                       , input v-cntxt-db-num
     5620                       , input "delfbr.err"
     5621                       , input ?
     5622                       , input p-fbr-doc-code
     5623                       , input v-cntxt-userid
     5624                       , input 0
     5625                       , input (if p-ph-chip-num <> ?
     5626                               then p-ph-chip-num
     5627                               else (if varchip-code <> 0
     5628                                   then varchip-code
     5629                                   else ?)
     5630                               )
     5631                       , output varchip-code2
     5632                   ) no-error.
     5633                   if error-status :error
     5634                   then do:
     5635                     undo, return error substitute("Ошибка при удалении складского документа &1, созданный по документу производства &2.&3&4&3&5"
     5636                                                   ,buf_pri_trn-doc.doc-code
     5637                                                   ,p-fbr-doc-code
     5638                                                   , chr(10)
     5639                                                   , error-status:get-message(1)
     5640                                                   , return-value ).
     5641                   end.
     5642               end.
     5643           end.
     5644           define buffer buf_out_trn-doc       for ub.trn-doc.
     5645           if p-doc-type = 'при':U
     5646           then do:
     5647               assign
     5648                   v-chip-counter = 0
     5649               .
     5650               for each buf_out_trn-doc exclusive-lock
     5651                  where buf_out_trn-doc.out-code = buf_trn-doc.doc-code
     5652               on error undo, return error
     5653               :
     5654                   assign
     5655                       v-chip-counter = v-chip-counter + 1
     5656                   .
     5657                   if v-chip-counter > 1
     5658                   then do:
     5659                       assign
     5660                           varchip-code = varchip-code2
     5661                       .
     5662                   end.
     5663                   run str/del-doc.p (
     5664                         input parparentproc
     5665                       , input buf_out_trn-doc.doc-code
     5666                       , input v-cntxt-db-num
     5667                       , input "delfbr.err"
     5668                       , input ?
     5669                       , input p-fbr-doc-code
     5670                       , input v-cntxt-userid
     5671                       , input 0
     5672                       , input (if p-ph-chip-num <> ?
     5673                               then p-ph-chip-num
     5674                               else (if varchip-code <> 0
     5675                                   then varchip-code
     5676                                   else ?)
     5677                               )
     5678                       , output varchip-code2
     5679                   ) no-error.
     5680                   if error-status :error
     5681                   then do:
     5682                     undo, return error substitute("Ошибка при удалении складского документа &1, связанного со складским документов прихода &2, созданный по документу производства &3.&4&5&4&6"
     5683                                                   ,buf_out_trn-doc.doc-code
     5684                                                   ,buf_trn-doc.doc-code
     5685                                                   ,p-fbr-doc-code
     5686                                                   , chr(10)
     5687                                                   , error-status:get-message(1)
     5688                                                   , return-value ).
     5689                   end.
     5690               end.
     5691           end.
     5692           run str/del-doc.p (
     5693                 input parparentproc
     5694               , input buf_trn-doc.doc-code
     5695               , input v-cntxt-db-num
     5696               , input "delfbr.err"
     5697               , input ?
     5698               , input p-fbr-doc-code
     5699               , input v-cntxt-userid
     5700               , input 0
     5701               , input (if p-ph-chip-num <> ?
     5702                        then p-ph-chip-num
     5703                        else (if varchip-code <> 0
     5704                              then varchip-code
     5705                              else ?)
     5706                        )
     5707               , output varchip-code2
     5708           ) no-error.
     5709           if error-status :error
     5710           then do:
     5711               undo, return error substitute("Ошибка при удалении складского документа &1, созданный по документу производства &2.&3&4&3&5"
     5712                                             ,buf_trn-doc.doc-code
     5713                                             ,p-fbr-doc-code
     5714                                             , chr(10)
     5715                                             , error-status:get-message(1)
     5716                                             , return-value ).
     5717           end.
     5718           if p-doc-type = 'рас':U
     5719           or p-doc-type = 'спи':U
     5720           then do:
     5721               assign
     5722                   v-chip-counter = 0
     5723               .
     5724               for each buf_cons_trn-doc no-lock
     5725                  where buf_cons_trn-doc.out-code      = v-doc-code
     5726                    and buf_cons_trn-doc.ext-doc-type  = 'pc':U
     5727               :
     5728                   assign
     5729                       v-trn-doc-recid = recid( buf_cons_trn-doc )
     5730                       v-chip-counter = v-chip-counter + 1
     5731                   .
     5732                   assign
     5733                   varchip-code = if v-chip-counter = 2
     5734                                  then varchip-code2
     5735                                  else varchip-code.
     5736                   run str/del-doc.p (
     5737                         input parparentproc
     5738                       , input buf_cons_trn-doc.doc-code
     5739                       , input v-cntxt-db-num
     5740                       , input "delfbr.err"
     5741                       , input ?
     5742                       , input ?
     5743                       , input v-cntxt-userid
     5744                       , input 0
     5745                       , input (if p-ph-chip-num <> ?
     5746                                then p-ph-chip-num
     5747                                else ( if v-chip-counter = 1
     5748                                       then ?
     5749                                       else varchip-code )
     5750                                )
     5751                       , output varchip-code2
     5752                   ) no-error.
     5753                   if error-status :error
     5754                   then do:
     5755                       undo, return error substitute("Ошибка при удалении складского документа смены типа приобретения &1, созданный по документу производства &2.&3&4&3&5"
     5756                                                     ,buf_cons_trn-doc.doc-code
     5757                                                     ,p-fbr-doc-code
     5758                                                     , chr(10)
     5759                                                     , error-status:get-message(1)
     5760                                                     , return-value ).
     5761                   end.
     5762                   assign
     5763                       p-chip-num = varchip-code2
     5764                   .
     5765               end.
     5766           end.
     5767           assign
     5768               p-chip-num = varchip-code2
     5769           .
     5770       end.
     5771   end.
     5772   END PROCEDURE.
     5773   PROCEDURE fbrlib-print-del-error-message :
     5774   do
     5775   on error undo, return error
     5776   :
     5777       define variable v-user-action   as character    no-undo.
     5778       define variable v-printed       as logical      no-undo.
     5779       message
     5780           vss-workfile vss-revision vss-description
     5781           skip "Ошибка при удалении документа."
     5782           skip return-value
     5783           skip trim(error-status :get-message(1))
     5784           skip trim(error-status :get-message(2))
     5785           skip trim(error-status :get-message(3))
     5786       view-as alert-box error.
     5787       if search ("delfbr.err") <> ?
     5788       then do:
     5789         run gbl/prnfilen.w
     5790           (input  "Ошибки при удалении документа производства"
     5791           ,input  0
     5792           ,input  "delfbr.err"
     5793           ,input  7
     5794           ,output v-user-action
     5795           ,output v-printed
     5796           ).
     5797       end.
     5798   end.
     5799   END PROCEDURE.
     5800   procedure fbrlib-calc-brutto :
     5801   define input parameter p-recipe-type        as character        no-undo.
     5802   define input parameter p-netto              as decimal          no-undo.
     5803   define input parameter p-coeff-value        as decimal          no-undo.
     5804   define input parameter p-coeff-waste        as decimal          no-undo.
     5805   define input parameter p-brutto             as decimal          no-undo.
     5806   define input parameter p-calc-method        as integer          no-undo.
     5807   define output parameter p-new-netto         as decimal          no-undo.
     5808   define output parameter p-new-coeff-waste   as decimal          no-undo.
     5809   define output parameter p-new-brutto        as decimal          no-undo.
     5810   define output parameter p-new-calc-method   as integer          no-undo.
     5811   do
     5812   on error undo, return error
     5813   :
     5814       if p-recipe-type <> 'производство':U
     5815       then do:
     5816           assign
     5817               p-new-coeff-waste = 0
     5818               p-new-calc-method = 1
     5819               p-new-netto       = ( if p-calc-method = 1 then p-brutto else p-netto )
     5820               p-new-brutto      = ( if p-calc-method = 1 then p-brutto else p-netto )
     5821           .
     5822       end.
     5823       else do:
     5824           assign
     5825               p-new-calc-method = p-calc-method
     5826           .
     5827           if p-coeff-waste = 0
     5828           then do:
     5829               assign
     5830                   p-coeff-value = 0
     5831               .
     5832           end.
     5833           case p-calc-method
     5834           :
     5835               when 1
     5836               then do:
     5837                   assign
     5838                       p-new-netto         = p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100
     5839                       p-new-coeff-waste   = p-coeff-waste
     5840                       p-new-brutto        = p-brutto
     5841                   .
     5842               end.
     5843               when 2
     5844               then do:
     5845                   assign
     5846                       p-new-netto         = p-netto
     5847                       p-new-coeff-waste   = 100 - p-coeff-value - ( 100 * p-netto / p-brutto )
     5848                       p-new-brutto        = p-brutto
     5849                   .
     5850               end.
     5851               when 3
     5852               then do:
     5853                   assign
     5854                       p-new-netto         = p-netto
     5855                       p-new-coeff-waste   = p-coeff-waste
     5856                       p-new-brutto        = 100 * p-netto / ( 100 - p-coeff-value - p-coeff-waste )
     5857                   .
     5858               end.
     5859               otherwise do:
     5860                   define variable v-yesno    as logical      no-undo.
     5861                   assign
     5862                       v-yesno = yes
     5863                   .
     5864                   message
     5865                       "Неверный метод для расчета брутто, нетто и процента потерь."
     5866                       skip "Значение метода должно быть 1, 2 или 3."
     5867                       skip(1)
     5868                       skip "Заданное значение:" p-calc-method
     5869                       skip(1)
     5870                       skip "Установить значение метода расчета 1"
     5871                       skip "(расчет нетто по брутто и проценту потерь)?"
     5872                   view-as alert-box warning
     5873                   buttons yes-no
     5874                   title "Неверное значение метода пересчета в строках документа-производства"
     5875                   update v-yesno
     5876                   .
     5877                   if v-yesno = yes
     5878                   then do:
     5879                       assign
     5880                           p-new-calc-method   = 1
     5881                           p-new-netto         = p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100
     5882                           p-new-coeff-waste   = p-coeff-waste
     5883                           p-new-brutto        = p-brutto
     5884                       .
     5885                   end.
     5886                   else do:
     5887                       message
     5888                               vss-workfile vss-revision vss-description
     5889                           skip(1)
     5890                           skip "Ошибка расчета брутто, нетто и процента потерь."
     5891                           skip return-value
     5892                           skip trim(error-status :get-message(1))
     5893                               trim(error-status :get-message(2))
     5894                               trim(error-status :get-message(3))
     5895                       view-as alert-box error
     5896                       title "Неверное значение метода расчета"
     5897                       .
     5898                       undo, return error .
     5899                   end.
     5900               end.
     5901           end case.
     5902       end.
     5903   end.
     5904   end procedure.
     5905   procedure fbrlib-check-brutto :
     5906   define input parameter p-recipe-type        as character        no-undo.
     5907   define input parameter p-netto              as decimal          no-undo.
     5908   define input parameter p-coeff-value        as decimal          no-undo.
     5909   define input parameter p-coeff-waste        as decimal          no-undo.
     5910   define input parameter p-brutto             as decimal          no-undo.
     5911   define input parameter p-calc-method        as integer          no-undo.
     5912   define output parameter p-error-message     as character        no-undo.
     5913   define output parameter p-not-good          as logical          no-undo.
     5914   do
     5915   on error undo, return error
     5916   :
     5917       if p-recipe-type <> 'производство':U
     5918       then do:
     5919           if p-netto <> p-brutto
     5920           or p-coeff-waste <> 0
     5921           then do:
     5922               assign
     5923                   p-not-good      = yes
     5924                   p-error-message = substitute( "Во всех рецептах кроме рецепта производства должно выполняться:&1брутто = нетто и процент потерь = 0.&1&1Тип рецепта: &2&1Брутто: &3&1Нетто: &4&1Процент потерь: &5"
     5925                                           , chr(10), p-recipe-type, p-brutto, p-netto, p-coeff-waste )
     5926               .
     5927           end.
     5928       end.
     5929       else do:
     5930           if p-coeff-waste = 0
     5931           then do:
     5932               assign
     5933                   p-coeff-value = 0
     5934               .
     5935           end.
     5936           case p-calc-method
     5937           :
     5938               when 1
     5939               then do:
     5940                   if round( p-netto, 9 ) <> round( p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100, 9 )
     5941                   then do:
     5942                       assign
     5943                           p-not-good      = yes
     5944                           p-error-message = substitute( "Ошибка расчета нетто ( &2 ) &1 по брутто ( &3 ) &1 и процентам потерь ( &4, &5 )."
     5945                                                   , chr(10), p-netto, p-brutto, p-coeff-value, p-coeff-waste )
     5946                       .
     5947                   end.
     5948               end.
     5949               when 2
     5950               then do:
     5951                   if round( p-coeff-waste, 9 ) <> round( 100 - p-coeff-value - ( 100 * p-netto / p-brutto ), 9 )
     5952                   then do:
     5953                       assign
     5954                           p-not-good      = yes
     5955                           p-error-message =  substitute( "Ошибка расчета процента потерь ( &2 ) &1 по нетто ( &3 ) &1 брутто ( &4 ) &1 и cезонному проценту ( &5 )."
     5956                                                   , chr(10), p-coeff-waste, p-netto, p-brutto, p-coeff-value )
     5957                       .
     5958                   end.
     5959               end.
     5960               when 3
     5961               then do:
     5962                   if round( p-brutto, 9 ) <> round( 100 * p-netto / ( 100 - p-coeff-value - p-coeff-waste ), 9 )
     5963                   then do:
     5964                       assign
     5965                           p-not-good      = yes
     5966                           p-error-message = substitute( "Ошибка расчета брутто ( &3 ) &1 по нетто ( &2 ) &1 и процентам потерь ( &4, &5 )."
     5967                                                   , chr(10), p-netto, p-brutto, p-coeff-value, p-coeff-waste )
     5968                       .
     5969                   end.
     5970               end.
     5971               otherwise do:
     5972                   assign
     5973                       p-not-good      = yes
     5974                       p-error-message = substitute( "Ошибка ввода метода расчета ( &1 ).", p-calc-method )
     5975                   .
     5976               end.
     5977           end case.
     5978       end.
     5979   end.
     5980   end procedure.
     5981   procedure fbrlib-check-fbr-recipe :
     5982   define input parameter p-doc-code       as character        no-undo.
     5983   define input parameter p-recipe-code    as character        no-undo.
     5984   define output parameter p-is-correct    as logical          no-undo.
     5985       define variable v-comp-factor    as decimal      no-undo.
     5986       define buffer buf_fbr-recipe        for ub.fbr-recipe.
     5987       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     5988       define buffer buf_fbr-line          for ub.fbr-line.
     5989   do
     5990   for buf_fbr-recipe
     5991     , buf_fbr-recipe-gds
     5992     , buf_fbr-line
     5993   on error undo, return error
     5994   :
     5995       assign
     5996           p-is-correct = yes
     5997       .
     5998       find first buf_fbr-recipe no-lock
     5999            where buf_fbr-recipe.doc-code    = p-doc-code
     6000              and buf_fbr-recipe.recipe-code = p-recipe-code no-error
     6001       .
     6002       if not available buf_fbr-recipe then do:
     6003         undo, return error substitute("Не найден рецепт (fbr-recipe) с кодом &1 для  документа пр-ва &2", p-recipe-code, p-doc-code).
     6004       end.
     6005       if buf_fbr-recipe.recipe-type = 'альтернатива':U
     6006       then do:
     6007       end.
     6008       else do:
     6009           find first buf_fbr-line no-lock
     6010                where buf_fbr-line.doc-code    = buf_fbr-recipe.doc-code
     6011                  and buf_fbr-line.is-comp     = yes
     6012                  and buf_fbr-line.recipe-code = buf_fbr-recipe.recipe-code
     6013                  and buf_fbr-line.artic       = buf_fbr-recipe.artic
     6014                  and buf_fbr-line.prod-type   = buf_fbr-recipe.prod-type
     6015                  and buf_fbr-line.prod-code   = buf_fbr-recipe.prod-code
     6016           .
     6017           assign
     6018               v-comp-factor = buf_fbr-line.fact-qnty / buf_fbr-recipe.qnty
     6019           .
     6020           recipe-line-cycle:
     6021           for each buf_fbr-recipe-gds no-lock
     6022              where buf_fbr-recipe-gds.doc-code    = p-doc-code
     6023                and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     6024           on error undo, return error
     6025           :
     6026               find first buf_fbr-line no-lock
     6027                    where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     6028                      and buf_fbr-line.is-comp     = no
     6029                      and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     6030                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     6031                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     6032                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     6033               .
     6034               if absolute( buf_fbr-line.fact-qnty / buf_fbr-recipe-gds.brutto-qnty - v-comp-factor ) > 0.000000001
     6035               then do:
     6036                   assign
     6037                       p-is-correct = no
     6038                   .
     6039                   leave recipe-line-cycle.
     6040               end.
     6041           end.
     6042       end.
     6043   end.
     6044   end procedure.
     6045   procedure fbrlib-get-recipe-type :
     6046   define input parameter p-fbr-doc-code   as character        no-undo.
     6047   define input parameter p-recipe-code    as character        no-undo.
     6048   define output parameter p-recipe-type   as character        no-undo.
     6049       define buffer buf_recipe        for ub.recipe.
     6050       define buffer buf_fbr-recipe    for ub.fbr-recipe.
     6051   do
     6052   for buf_recipe
     6053     , buf_fbr-recipe
     6054   on error undo, return error
     6055   :
     6056       if p-fbr-doc-code = ""
     6057       then do:
     6058           find first buf_recipe no-lock
     6059                where buf_recipe.recipe-code = p-recipe-code
     6060           no-error.
     6061           if available buf_recipe
     6062           then do:
     6063               assign
     6064                   p-recipe-type = buf_recipe.recipe-type
     6065               .
     6066           end.
     6067           else do:
     6068               assign
     6069                   p-recipe-type = "":U
     6070               .
     6071           end.
     6072       end.
     6073       else do:
     6074           find first buf_fbr-recipe no-lock
     6075                where buf_fbr-recipe.doc-code      = p-fbr-doc-code
     6076                  and buf_fbr-recipe.recipe-code   = p-recipe-code
     6077           no-error.
     6078           if available buf_fbr-recipe
     6079           then do:
     6080               assign
     6081                   p-recipe-type = buf_fbr-recipe.recipe-type
     6082               .
     6083           end.
     6084           else do:
     6085               assign
     6086                   p-recipe-type = "":U
     6087               .
     6088           end.
     6089       end.
     6090   end.
     6091   end procedure.
     6092   PROCEDURE calc-comp-from-ingr :
     6093   define input parameter p-fbr-v-fbr-doc-line-recid           as recid        no-undo.
     6094   define input parameter p-fact-qnty                          as decimal      no-undo.
     6095   define output parameter p-comp-fbr-v-fbr-doc-line-recid     as recid        no-undo.
     6096   define output parameter p-comp-qnty                         as decimal      no-undo.
     6097       define variable v-ingr-qnty     as decimal       no-undo.
     6098       define buffer buf_i_fbr-line    for ub.fbr-line.
     6099       define buffer buf_fbr-line      for ub.fbr-line.
     6100       define buffer buf_recipe        for ub.fbr-recipe.
     6101       define buffer buf_recipe-gds    for ub.fbr-recipe-gds.
     6102   do
     6103   for buf_i_fbr-line
     6104     , buf_fbr-line
     6105     , buf_recipe
     6106     , buf_recipe-gds
     6107   on error undo, return error
     6108   :
     6109       find first buf_i_fbr-line no-lock
     6110            where recid( buf_i_fbr-line ) = p-fbr-v-fbr-doc-line-recid
     6111       .
     6112       find first buf_recipe no-lock
     6113            where buf_recipe.doc-code      = buf_i_fbr-line.doc-code
     6114              and buf_recipe.recipe-code   = buf_i_fbr-line.recipe-code
     6115       no-error.
     6116       if not available buf_recipe
     6117       then do:
     6118           message
     6119                   vss-workfile vss-revision vss-description
     6120               skip "В строке производства не указан рецепт."
     6121               skip "Невозможно рассчитать количество составного товара."
     6122               skip return-value
     6123               skip trim(error-status :get-message(1))
     6124                   trim(error-status :get-message(2))
     6125                   trim(error-status :get-message(3))
     6126           view-as alert-box error.
     6127           undo, return error .
     6128       end.
     6129       if buf_recipe.recipe-type = 'альтернатива':U
     6130       then do:
     6131           for each buf_fbr-line no-lock
     6132              where buf_fbr-line.doc-code    = buf_i_fbr-line.doc-code
     6133                and buf_fbr-line.trn-type    = buf_i_fbr-line.trn-type
     6134                and buf_fbr-line.recipe-code = buf_i_fbr-line.recipe-code
     6135           on error undo, return error
     6136           :
     6137               find first buf_recipe-gds no-lock
     6138                    where buf_recipe-gds.doc-code    = buf_i_fbr-line.doc-code
     6139                      and buf_recipe-gds.recipe-code = buf_i_fbr-line.recipe-code
     6140                      and buf_recipe-gds.artic       = buf_fbr-line.artic
     6141                      and buf_recipe-gds.prod-type   = buf_fbr-line.prod-type
     6142                      and buf_recipe-gds.prod-code   = buf_fbr-line.prod-code
     6143               .
     6144               assign
     6145                   p-comp-qnty         = p-comp-qnty       + ( buf_fbr-line.fact-qnty * buf_recipe-gds.brutto-qnty )
     6146               .
     6147           end.
     6148           assign
     6149               p-comp-qnty         = p-comp-qnty       / buf_recipe.qnty
     6150           .
     6151       end.
     6152       else do:
     6153           find first buf_recipe-gds no-lock
     6154                where buf_recipe-gds.doc-code    = buf_i_fbr-line.doc-code
     6155                  and buf_recipe-gds.recipe-code = buf_i_fbr-line.recipe-code
     6156                  and buf_recipe-gds.artic       = buf_i_fbr-line.artic
     6157                  and buf_recipe-gds.prod-type   = buf_i_fbr-line.prod-type
     6158                  and buf_recipe-gds.prod-code   = buf_i_fbr-line.prod-code
     6159           .
     6160           assign
     6161               p-comp-qnty = p-fact-qnty / buf_recipe-gds.brutto-qnty * buf_recipe.qnty
     6162           .
     6163       end.
     6164       find first buf_fbr-line no-lock
     6165            where buf_fbr-line.doc-code    = buf_i_fbr-line.doc-code
     6166              and buf_fbr-line.is-comp     = yes
     6167              and buf_fbr-line.recipe-code = buf_i_fbr-line.recipe-code
     6168       .
     6169       assign
     6170           p-comp-fbr-v-fbr-doc-line-recid = recid( buf_fbr-line )
     6171       .
     6172   end.
     6173   END PROCEDURE.
     6174   PROCEDURE get-temp_dressing-ingr-used-qnty :
     6175   define input parameter p-recipe-code    as character    no-undo.
     6176   define input parameter p-gds-code       as integer      no-undo.
     6177   define output parameter p-line-qnty     as decimal      no-undo.
     6178   define output parameter p-used-qnty     as decimal      no-undo.
     6179   define output parameter p-recipe-qnty   as decimal      no-undo.
     6180       define buffer buf_temp_dressing-ingr    for temp_dressing-ingr.
     6181   do
     6182   for buf_temp_dressing-ingr
     6183   on error undo, return error
     6184   :
     6185       find first buf_temp_dressing-ingr no-lock
     6186            where buf_temp_dressing-ingr.recipe-code = p-recipe-code
     6187              and buf_temp_dressing-ingr.gds-code    = p-gds-code
     6188       no-error.
     6189       if available buf_temp_dressing-ingr
     6190       then do:
     6191           assign
     6192               p-line-qnty     = buf_temp_dressing-ingr.line-qnty
     6193               p-used-qnty     = buf_temp_dressing-ingr.used-qnty
     6194               p-recipe-qnty   = buf_temp_dressing-ingr.recipe-qnty
     6195           .
     6196       end.
     6197       else do:
     6198           assign
     6199               p-line-qnty     = 0
     6200               p-used-qnty     = 0
     6201               p-recipe-qnty   = 0
     6202           .
     6203       end.
     6204   end.
     6205   END PROCEDURE.
     6206   PROCEDURE fbrlib_adjust-recipe :
     6207   do
     6208   on error undo, return error
     6209   :
     6210   define input parameter parparentproc as widget-handle no-undo .
     6211   define input parameter p-fbrhist-handle as handle no-undo .
     6212   define input parameter p-doc-code       as character    no-undo.
     6213   define input parameter p-recipe-code    as character    no-undo.
     6214   define input parameter p-price-sale-obj-type as character no-undo .
     6215   define input parameter p-price-sale-obj-code as integer no-undo .
     6216       define variable v-recipe-qnty       as decimal      no-undo.
     6217       define variable v-comp-qnty         as decimal      no-undo.
     6218       define variable v-recipe-gds-qnty   as decimal      no-undo.
     6219       define variable v-ingr-qnty         as decimal      no-undo.
     6220       define variable v-qnty              as decimal      no-undo.
     6221       define variable v-coeff-waste       as decimal      no-undo.
     6222       define variable v-brutto-qnty       as decimal      no-undo.
     6223       define buffer buf_fbr-recipe        for ub.fbr-recipe.
     6224       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     6225       define buffer buf_fbr-line          for ub.fbr-line.
     6226       define buffer buf_el_fbr-recipe-gds for ub.fbr-recipe-gds.
     6227       find first buf_fbr-recipe no-lock
     6228            where buf_fbr-recipe.doc-code      = p-doc-code
     6229              and buf_fbr-recipe.recipe-code   = p-recipe-code
     6230       .
     6231       assign
     6232           v-recipe-qnty = buf_fbr-recipe.qnty
     6233       .
     6234       find first buf_fbr-line no-lock
     6235            where buf_fbr-line.doc-code    = p-doc-code
     6236              and buf_fbr-line.is-comp     = yes
     6237              and buf_fbr-line.recipe-code = p-recipe-code
     6238       .
     6239       assign
     6240           v-comp-qnty = buf_fbr-line.fact-qnty
     6241       .
     6242       if buf_fbr-recipe.recipe-type = 'альтернатива':U
     6243       then do:
     6244       end.
     6245       else do:
     6246           for each buf_fbr-recipe-gds no-lock
     6247              where buf_fbr-recipe-gds.doc-code    = p-doc-code
     6248                and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     6249           on error undo, return error
     6250           :
     6251               find first buf_fbr-line no-lock
     6252                    where buf_fbr-line.doc-code    = p-doc-code
     6253                      and buf_fbr-line.is-comp     = no
     6254                      and buf_fbr-line.recipe-code = p-recipe-code
     6255                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     6256                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     6257                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     6258               .
     6259               if buf_fbr-line.fact-qnty / v-comp-qnty <> buf_fbr-recipe-gds.brutto-qnty / v-recipe-qnty
     6260               then do:
     6261                   do transaction
     6262                   on error undo, return error
     6263                   :
     6264                       find first buf_el_fbr-recipe-gds exclusive-lock
     6265                            where recid( buf_el_fbr-recipe-gds ) = recid( buf_fbr-recipe-gds )
     6266                       .
     6267                       assign
     6268                           buf_el_fbr-recipe-gds.calc-method   = 1
     6269                           buf_el_fbr-recipe-gds.brutto-qnty   = buf_fbr-line.fact-qnty * v-recipe-qnty / v-comp-qnty
     6270                       .
     6271                       run fbrlib-calc-brutto in this-procedure (
     6272                             input buf_fbr-recipe.recipe-type
     6273                           , input 0
     6274                           , input buf_el_fbr-recipe-gds.coeff-value
     6275                           , input buf_el_fbr-recipe-gds.coeff-waste
     6276                           , input buf_el_fbr-recipe-gds.brutto-qnty
     6277                           , input 1
     6278                           , output buf_el_fbr-recipe-gds.qnty
     6279                           , output buf_el_fbr-recipe-gds.coeff-waste
     6280                           , output buf_el_fbr-recipe-gds.brutto-qnty
     6281                           , output buf_el_fbr-recipe-gds.calc-method
     6282                       ).
     6283                   end.
     6284               end.
     6285           end.
     6286           run fbrlib_adjust-doc-lines in this-procedure (
     6287                 input parparentproc
     6288               , input p-fbrhist-handle
     6289               , input p-doc-code
     6290               , input p-recipe-code
     6291               , input p-price-sale-obj-type
     6292               , input p-price-sale-obj-code
     6293           ).
     6294       end.
     6295   end.
     6296   END PROCEDURE.
     6297   PROCEDURE fbrlib_adjust-doc-lines :
     6298   define input parameter parparentproc as widget-handle no-undo .
     6299   define input parameter p-fbrhist-handle as handle no-undo .
     6300   define input parameter p-doc-code       as character    no-undo.
     6301   define input parameter p-recipe-code    as character    no-undo.
     6302   define input parameter p-price-sale-obj-type as character no-undo .
     6303   define input parameter p-price-sale-obj-code as integer no-undo .
     6304   define variable v-comp-qnty         as decimal      no-undo.
     6305   define variable v-trn-type          as character    no-undo.
     6306   define variable v-ingr-qnty         as decimal      no-undo.
     6307   define variable v-recipe-qnty       as decimal      no-undo.
     6308   define variable v-fbr-v-fbr-doc-line-recid    as recid        no-undo.
     6309   define buffer buf_fbr-recipe        for ub.fbr-recipe.
     6310   define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     6311   define buffer buf_fbr-line          for ub.fbr-line.
     6312   define buffer buf_coeff_fbr-line    for ub.fbr-line.
     6313   define buffer buf_goods             for ub.goods.
     6314   define buffer buf_fbr-doc           for ub.fbr-doc.
     6315   do
     6316   for buf_fbr-recipe
     6317     , buf_fbr-recipe-gds
     6318     , buf_fbr-line
     6319     , buf_coeff_fbr-line
     6320     , buf_goods
     6321     , buf_fbr-doc
     6322   on error undo, return error
     6323   :
     6324       find first buf_fbr-line no-lock
     6325            where buf_fbr-line.doc-code      = p-doc-code
     6326              and buf_fbr-line.is-comp       = yes
     6327              and buf_fbr-line.recipe-code   = p-recipe-code
     6328       .
     6329       find first buf_fbr-doc no-lock
     6330            where buf_fbr-doc.doc-code      = p-doc-code
     6331       .
     6332       assign
     6333           v-comp-qnty = buf_fbr-line.fact-qnty
     6334           v-trn-type  = buf_fbr-line.trn-type
     6335       .
     6336       find first buf_fbr-recipe no-lock
     6337            where buf_fbr-recipe.doc-code    = p-doc-code
     6338              and buf_fbr-recipe.recipe-code = p-recipe-code
     6339       .
     6340       assign
     6341       v-recipe-qnty = buf_fbr-recipe.qnty
     6342       .
     6343       do transaction
     6344       on error undo, return error
     6345       :
     6346           for each buf_fbr-recipe-gds no-lock
     6347              where buf_fbr-recipe-gds.doc-code      = p-doc-code
     6348                and buf_fbr-recipe-gds.recipe-code   = p-recipe-code
     6349           on error undo, return error
     6350           :
     6351               find first buf_fbr-line no-lock
     6352                    where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     6353                      and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     6354                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     6355                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     6356                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     6357               no-error.
     6358               if not available buf_fbr-line
     6359               then do:
     6360                   find first buf_goods no-lock
     6361                        where buf_goods.artic      = buf_fbr-recipe-gds.artic
     6362                          and buf_goods.prod-type  = buf_fbr-recipe-gds.prod-type
     6363                          and buf_goods.prod-code  = buf_fbr-recipe-gds.prod-code
     6364                   .
     6365                   run str/fbr-crln.p (
     6366                         input parparentproc
     6367                       , input recid( buf_fbr-doc )
     6368                       , input recid( buf_goods )
     6369                       , input buf_fbr-recipe-gds.recipe-code
     6370                       , input v-trn-type
     6371                       , input no
     6372                       , input no
     6373                       , input buf_fbr-doc.obj-type
     6374                       , input buf_fbr-doc.obj-code
     6375                       , output v-fbr-v-fbr-doc-line-recid
     6376                   ).
     6377                   find first buf_fbr-line no-lock
     6378                        where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     6379                          and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     6380                          and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     6381                          and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     6382                          and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     6383                   no-error.
     6384                   if not available buf_fbr-line
     6385                   then do:
     6386                       undo, return error substitute("Не удалось создать строку документа производства &1 &2&3&4"
     6387                                                      , p-doc-code
     6388                                                      , buf_fbr-recipe-gds.artic
     6389                                                      , buf_fbr-recipe-gds.prod-type
     6390                                                      , buf_fbr-recipe-gds.prod-code).
     6391                   end.
     6392               end.
     6393               find first buf_coeff_fbr-line exclusive-lock
     6394                    where recid( buf_coeff_fbr-line ) = recid( buf_fbr-line )
     6395               .
     6396               if buf_coeff_fbr-line.calc-method <> buf_fbr-recipe-gds.calc-method
     6397               or buf_coeff_fbr-line.coeff-value <> buf_fbr-recipe-gds.coeff-value
     6398               or buf_coeff_fbr-line.coeff-waste <> buf_fbr-recipe-gds.coeff-waste
     6399               then do:
     6400                   assign
     6401                       buf_coeff_fbr-line.calc-method = buf_fbr-recipe-gds.calc-method
     6402                       buf_coeff_fbr-line.coeff-value = buf_fbr-recipe-gds.coeff-value
     6403                       buf_coeff_fbr-line.coeff-waste = buf_fbr-recipe-gds.coeff-waste
     6404                   .
     6405               end.
     6406           end.
     6407       end.
     6408       define variable v-need-goods    as logical       no-undo.
     6409       define variable v-need-goods-list       as character     no-undo.
     6410       define variable v-need-goods-qnty-list  as character     no-undo.
     6411       find first buf_fbr-line no-lock
     6412            where buf_fbr-line.doc-code    = buf_fbr-doc.doc-code
     6413              and buf_fbr-line.is-comp     = yes
     6414              and buf_fbr-line.recipe-code = p-recipe-code
     6415       .
     6416       run str/fbr-qnty.p (
     6417             input parparentproc
     6418           , input p-fbrhist-handle
     6419           , input recid( buf_fbr-doc )
     6420           , input recid( buf_fbr-line )
     6421           , input no
     6422           , input "ingr"
     6423           , input no
     6424           , input p-price-sale-obj-type
     6425           , input p-price-sale-obj-code
     6426           , input no
     6427           , input no
     6428           , input no
     6429           , output v-need-goods
     6430           , output v-need-goods-list
     6431           , output v-need-goods-qnty-list
     6432       ).
     6433   end.
     6434   END PROCEDURE.
     6435   procedure fbrlib_check-before-close :
     6436   define input parameter p-doc-code as character no-undo .
     6437   define variable same-sale as decimal no-undo .
     6438   define variable is-waste as logical no-undo .
     6439   define variable fix-price as logical no-undo .
     6440   define buffer buf_fbr-doc for ub.fbr-doc.
     6441   define buffer buf_fbr-line for ub.fbr-line.
     6442   define buffer buf_goods for ub.goods.
     6443   define buffer buf_fbr-gds-obj for ub.fbr-gds-obj.
     6444   do
     6445   on error undo, return error
     6446   :
     6447     for each buf_fbr-line no-lock
     6448         where buf_fbr-line.doc-code = p-doc-code
     6449       , each buf_goods no-lock
     6450         where buf_goods.artic     = buf_fbr-line.artic
     6451           and buf_goods.prod-type = buf_fbr-line.prod-type
     6452           and buf_goods.prod-code = buf_fbr-line.prod-code
     6453     break by buf_fbr-line.prod-type
     6454           by buf_fbr-line.prod-code
     6455           by buf_fbr-line.artic
     6456     :
     6457       if first-of (buf_fbr-line.artic)
     6458       then do:
     6459         assign
     6460         same-sale = buf_fbr-line.price-sale
     6461         is-waste = (buf_fbr-line.rsrv-qnty = ?)
     6462         fix-price = buf_fbr-line.is-calc
     6463         .
     6464       end.
     6465       if same-sale <> buf_fbr-line.price-sale
     6466       then do:
     6467           undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа с этим товаром должна быть указана одна и та же цена продажи."
     6468                                         ,p-doc-code
     6469                                         ,buf_goods.artic
     6470                                         ,buf_goods.gds-name
     6471                                         ,chr(10)).
     6472       end.
     6473       if fix-price <> buf_fbr-line.is-calc then do:
     6474           undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа с этим товаром цена должна быть фиксирована или нет."
     6475                                         ,p-doc-code
     6476                                         ,buf_goods.artic
     6477                                         ,buf_goods.gds-name
     6478                                         ,chr(10)).
     6479       end.
     6480       if is-waste <> (buf_fbr-line.rsrv-qnty = ?)
     6481       then do:
     6482         undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа этот товар должен быть отходом либо не отходом."
     6483                                         ,p-doc-code
     6484                                         ,buf_goods.artic
     6485                                         ,buf_goods.gds-name
     6486                                         ,chr(10)).
     6487       end.
     6488       if buf_fbr-line.rsrv-qnty <> ?
     6489       and buf_goods.gds-type <> 'у':U
     6490       and ( buf_fbr-line.price-sale <= 0 or buf_fbr-line.price-sale = ?  )
     6491       and buf_fbr-line.fact-qnty <> 0
     6492       then do:
     6493         if buf_fbr-line.trn-type     = 'при':U  then for first buf_fbr-doc where buf_fbr-doc.doc-code =  p-doc-code no-lock:
     6494           if  can-find(first buf_fbr-gds-obj no-lock where
     6495                   buf_fbr-gds-obj.gds-code = buf_goods.gds-code
     6496               AND buf_fbr-gds-obj.obj-type = buf_fbr-doc.obj-type
     6497               AND buf_fbr-gds-obj.obj-code = buf_fbr-doc.obj-code
     6498               and buf_fbr-gds-obj.is-null-price  )  then .
     6499                     else undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4Рецепт &5&4Неправильная (нулевая) цена продажи."
     6500                                         ,p-doc-code
     6501                                         ,buf_goods.artic
     6502                                         ,buf_goods.gds-name
     6503                                         ,chr(10)
     6504                                         ,buf_fbr-line.recipe-code
     6505                                         ).
     6506         end.
     6507         else undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4Рецепт &5&4Неправильная (нулевая) цена продажи."
     6508                                         ,p-doc-code
     6509                                         ,buf_goods.artic
     6510                                         ,buf_goods.gds-name
     6511                                         ,chr(10)
     6512                                         ,buf_fbr-line.recipe-code
     6513                                         ).
     6514       end.
     6515     end.
     6516   end.
     6517   end procedure.
     6518   define variable vss-include-info41 as character format "X(65)" no-undo
     6519   initial "@(#)$Workfile$ $Revision$".
     6520   define temp-table temp_fbrcode-doc-code no-undo
     6521       field rec-type      as character
     6522       field doc-code      as character
     6523       field obj-type      as character
     6524       field obj-code      as integer
     6525       field cli-type      as character
     6526       field cli-code      as integer
     6527       field ext-doc-type  as character
     6528       field doc-type      as character
     6529       field order         as integer
     6530       index pi is primary unique rec-type doc-code
     6531       index od order
     6532   .
     6533   procedure fbrcode-gen-recipe-code :
     6534   do
     6535   on error undo, return error
     6536   :
     6537   define input parameter p-obj-type           as character    no-undo.
     6538   define input parameter p-obj-code           as integer      no-undo.
     6539   define output parameter p-recipe-code       as character    no-undo.
     6540       assign
     6541           p-recipe-code   = string( next-value( s-recipe, ub ) )
     6542                               + "-"
     6543                               + trim( string( p-obj-code, ">>>>9" ) )
     6544                               + substring( p-obj-type, ( if g#language = "RUS" then 1 else 2 ), 1 )
     6545       .
     6546   end.
     6547   end procedure.
     6548   procedure fbrcode-is-from-object :
     6549   do
     6550   on error undo, return error
     6551   :
     6552   define input parameter p-doc-code           as character    no-undo.
     6553   define input parameter p-obj-type           as character    no-undo.
     6554   define input parameter p-obj-code           as integer      no-undo.
     6555   define output parameter p-is-from-object    as logical      no-undo.
     6556       if num-entries( p-doc-code, "-" ) < 2
     6557       or entry( 2, p-doc-code, "-" ) <> trim (string (p-obj-code, ">>>>9"))
     6558                                       + substring( p-obj-type, ( if g#language = "RUS" then 1 else 2 ), 1 )
     6559       then do:
     6560           assign
     6561               p-is-from-object = no
     6562           .
     6563       end.
     6564       else do:
     6565           assign
     6566               p-is-from-object = yes
     6567           .
     6568       end.
     6569   end.
     6570   end procedure.
     6571   procedure fbrcode-trn-doc :
     6572   do
     6573   on error undo, return error
     6574   :
     6575       define input parameter p-out-doc-type       as character    no-undo.
     6576       define input parameter p-out-code           as character    no-undo.
     6577       define input parameter p-trn-doc-out-type   as character    no-undo.
     6578       define output parameter p-trn-doc-doc-code  as character   no-undo.
     6579       case p-out-doc-type:
     6580           when 'производство':U
     6581           then do:
     6582               case p-trn-doc-out-type :
     6583                   when 'рас':U
     6584                   then do:
     6585                       assign
     6586                           p-trn-doc-doc-code = p-out-code
     6587                       .
     6588                   end.
     6589                   when 'при':U
     6590                   then do:
     6591                       assign
     6592                           p-trn-doc-doc-code = replace ( p-out-code, "-", "=" )
     6593                       .
     6594                   end.
     6595                   when 'спи':U
     6596                   then do:
     6597                       assign
     6598                           p-trn-doc-doc-code = replace ( p-out-code, "-", "*" )
     6599                       .
     6600                   end.
     6601                   otherwise do:
     6602                       assign
     6603                           p-trn-doc-doc-code = ""
     6604                       .
     6605                       undo, return error "Не может быть обработан тип складского документа '"
     6606                                           + p-trn-doc-out-type + "' во входных параметрах".
     6607                   end.
     6608               end case.
     6609           end.
     6610           otherwise do:
     6611               assign
     6612                   p-trn-doc-doc-code = ""
     6613               .
     6614               undo, return error "Не может быть обработан тип внешнего документа '"
     6615                                   + p-out-doc-type + "' во входных параметрах".
     6616           end.
     6617       end case.
     6618   end.
     6619   end procedure.
     6620   procedure fbrcode-fill-fbr-by-sale-or-pln :
     6621   define input parameter p-main-doc-code      as character        no-undo.
     6622       define variable v-order    as integer      no-undo.
     6623       define buffer buf_fbr-doc               for ub.fbr-doc.
     6624       define buffer buf_trn-doc               for ub.trn-doc.
     6625       define buffer buf_temp_fbrcode-doc-code for temp_fbrcode-doc-code.
     6626   do
     6627   for buf_fbr-doc
     6628     , buf_trn-doc
     6629     , buf_temp_fbrcode-doc-code
     6630   on error undo, return error
     6631   :
     6632       for each buf_temp_fbrcode-doc-code
     6633       on error undo, return error
     6634       :
     6635           delete buf_temp_fbrcode-doc-code.
     6636       end.
     6637       assign
     6638           v-order = 0
     6639       .
     6640       for each buf_fbr-doc no-lock
     6641          where buf_fbr-doc.out-code = p-main-doc-code
     6642       on error undo, return error
     6643       :
     6644           create buf_temp_fbrcode-doc-code.
     6645           assign
     6646               buf_temp_fbrcode-doc-code.rec-type      = 'производство':U
     6647               buf_temp_fbrcode-doc-code.doc-code      = buf_fbr-doc.doc-code
     6648               buf_temp_fbrcode-doc-code.ext-doc-type  = "":U
     6649               buf_temp_fbrcode-doc-code.obj-type      = buf_fbr-doc.obj-type
     6650               buf_temp_fbrcode-doc-code.obj-code      = buf_fbr-doc.obj-code
     6651               buf_temp_fbrcode-doc-code.cli-type      = buf_fbr-doc.obj-type
     6652               buf_temp_fbrcode-doc-code.cli-code      = buf_fbr-doc.obj-code
     6653               buf_temp_fbrcode-doc-code.doc-type      = buf_fbr-doc.doc-type
     6654           .
     6655           for each buf_trn-doc no-lock
     6656              where buf_trn-doc.out-code = buf_fbr-doc.doc-code
     6657           by buf_trn-doc.fact-order
     6658           on error undo, return error
     6659           :
     6660               if buf_trn-doc.ext-doc-type = 'em':U
     6661               or buf_trn-doc.ext-doc-type = 'im':U
     6662               or buf_trn-doc.ext-doc-type = 'wm':U
     6663               or buf_trn-doc.ext-doc-type = 'ev':U
     6664               then do:
     6665                   assign
     6666                       v-order = v-order + 1
     6667                   .
     6668                   create buf_temp_fbrcode-doc-code.
     6669                   assign
     6670                       buf_temp_fbrcode-doc-code.doc-code      = buf_trn-doc.doc-code
     6671                       buf_temp_fbrcode-doc-code.rec-type      = 'скл':U
     6672                       buf_temp_fbrcode-doc-code.ext-doc-type  = buf_trn-doc.ext-doc-type
     6673                       buf_temp_fbrcode-doc-code.obj-type      = buf_trn-doc.obj-type
     6674                       buf_temp_fbrcode-doc-code.obj-code      = buf_trn-doc.obj-code
     6675                       buf_temp_fbrcode-doc-code.cli-type      = buf_trn-doc.cli-type
     6676                       buf_temp_fbrcode-doc-code.cli-code      = buf_trn-doc.cli-code
     6677                       buf_temp_fbrcode-doc-code.doc-type      = buf_trn-doc.doc-type
     6678                       buf_temp_fbrcode-doc-code.order         = v-order
     6679                   .
     6680               end.
     6681           end.
     6682           assign
     6683               v-order  = v-order + 1
     6684           .
     6685           find first buf_temp_fbrcode-doc-code
     6686                where buf_temp_fbrcode-doc-code.rec-type = 'производство':U
     6687                  and buf_temp_fbrcode-doc-code.doc-code = buf_fbr-doc.doc-code
     6688           .
     6689           assign
     6690               buf_temp_fbrcode-doc-code.order = v-order
     6691           .
     6692       end.
     6693       for each buf_trn-doc no-lock
     6694          where buf_trn-doc.out-code = p-main-doc-code
     6695       by buf_trn-doc.fact-order
     6696       on error undo, return error
     6697       :
     6698           assign
     6699               v-order = v-order + 1
     6700           .
     6701           create buf_temp_fbrcode-doc-code.
     6702           assign
     6703               buf_temp_fbrcode-doc-code.doc-code      = buf_trn-doc.doc-code
     6704               buf_temp_fbrcode-doc-code.rec-type      = 'маг':U
     6705               buf_temp_fbrcode-doc-code.ext-doc-type  = buf_trn-doc.ext-doc-type
     6706               buf_temp_fbrcode-doc-code.obj-type      = buf_trn-doc.obj-type
     6707               buf_temp_fbrcode-doc-code.obj-code      = buf_trn-doc.obj-code
     6708               buf_temp_fbrcode-doc-code.cli-type      = buf_trn-doc.cli-type
     6709               buf_temp_fbrcode-doc-code.cli-code      = buf_trn-doc.cli-code
     6710               buf_temp_fbrcode-doc-code.doc-type      = buf_trn-doc.doc-type
     6711               buf_temp_fbrcode-doc-code.order         = v-order
     6712           .
     6713       end.
     6714   end.
     6715   end procedure.
     6716   procedure fbrcode-get-final-doc :
     6717   define input parameter p-main-doc-code      as character        no-undo.
     6718   define output parameter p-income-doc-code   as character        no-undo.
     6719       define variable v-main-obj-type    as character    no-undo.
     6720       define variable v-main-obj-code    as integer      no-undo.
     6721       define buffer buf_trn-doc               for ub.trn-doc.
     6722       define buffer buf_temp_fbrcode-doc-code for temp_fbrcode-doc-code.
     6723   do
     6724   for buf_trn-doc
     6725   on error undo, return error
     6726   :
     6727       run fbrcode-fill-fbr-by-sale-or-pln in this-procedure (
     6728           input p-main-doc-code
     6729       ).
     6730       find first buf_trn-doc no-lock
     6731            where buf_trn-doc.doc-code = p-main-doc-code
     6732       .
     6733       assign
     6734           v-main-obj-type = buf_trn-doc.obj-type
     6735           v-main-obj-code = buf_trn-doc.obj-code
     6736       .
     6737       find first buf_temp_fbrcode-doc-code
     6738            where buf_temp_fbrcode-doc-code.ext-doc-type = 'ev':U
     6739              and buf_temp_fbrcode-doc-code.cli-type     = v-main-obj-type
     6740              and buf_temp_fbrcode-doc-code.cli-code     = v-main-obj-code
     6741       no-error.
     6742       if available buf_temp_fbrcode-doc-code
     6743       then do:
     6744           find first buf_trn-doc no-lock
     6745                where buf_trn-doc.out-code     = buf_temp_fbrcode-doc-code.doc-code
     6746                  and buf_trn-doc.ext-doc-type = 'iv':U
     6747           .
     6748           assign
     6749               p-income-doc-code = buf_trn-doc.doc-code
     6750           .
     6751       end.
     6752       else do:
     6753           find first buf_temp_fbrcode-doc-code
     6754                where buf_temp_fbrcode-doc-code.ext-doc-type = 'im':U
     6755                  and buf_temp_fbrcode-doc-code.obj-type     = v-main-obj-type
     6756                  and buf_temp_fbrcode-doc-code.obj-code     = v-main-obj-code
     6757           no-error.
     6758           if available buf_temp_fbrcode-doc-code
     6759           then do:
     6760               assign
     6761                   p-income-doc-code = buf_temp_fbrcode-doc-code.doc-code
     6762               .
     6763           end.
     6764           else do:
     6765               assign
     6766                   p-income-doc-code = "":U
     6767               .
     6768           end.
     6769       end.
     6770   end.
     6771   end procedure.
     6772   define variable v-current-recipe-code like recipe.recipe-code no-undo .
     6773   define variable v-current-gds-code  like ub.goods.gds-code no-undo .
     6774   define variable v-current-rcp-gds-code like ub.goods.gds-code no-undo .
     6775   define variable v-current-host-code as integer no-undo .
     6776   define variable v-current-obj-type as character no-undo .
     6777   define variable v-current-obj-code as integer no-undo .
     6778   define variable v-current-lock as integer no-undo .
     6779   define variable v-current-wait as integer no-undo .
     6780   define variable v-save as integer no-undo .
     6781   define variable log-file-name                as character      no-undo init "process-clients.txt".
     6782   define variable v-view-log                   as logical        no-undo .
     6783   define variable v-stop                       as logical        no-undo .
     6784   define variable v-current-db-num as integer no-undo .
     6785   define variable v-current-date as date no-undo .
     6786   define variable v-sign as integer no-undo .
     6787   define variable file-name as char.
     6788   define variable num-rec as integer no-undo .
     6789   define variable num-rec-ok as integer no-undo .
     6790   define variable v-full-path        as character no-undo .
     6791   define variable v-path             as character no-undo .
     6792   define variable v-file-name        as character no-undo .
     6793   define variable v-file-name-no-ext as character no-undo .
     6794   define variable v-file-name-ext    as character no-undo .
     6795   define variable v-end-new-line     as logical no-undo .
     6796   define variable v-last-error-message as character no-undo .
     6797   define variable v-retry-action as integer no-undo .
     6798   define variable v_dataseth as handle no-undo .
     6799   define variable v-xmlh as handle no-undo .
     6800   define variable v_qh as handle no-undo .
     6801   define variable glog as logical no-undo .
     6802   define variable v-sys-recipe-code like ub.recipe.recipe-code no-undo .
     6803   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6804   procedure set-error :
     6805   define input parameter p-mess as character no-undo .
     6806     do
     6807     on error undo, return error
     6808     :
     6809        assign
     6810        v-last-error-message = p-mess.
     6811     end.
     6812   end procedure.
     6813   define buffer buf_temp-cmd for temp-cmd.
     6814   define shared temp-table tt0-rule-call-param no-undo like ub.rule-call-param.
     6815   define temp-table temp-recipe_ no-undo like ub.recipe.
     6816   define temp-table temp-recipe-gds_ no-undo like ub.recipe-gds
     6817   field rcp-gds-code like recipe-gds.gds-code.
     6818   define buffer buf_temp-xml-tables for temp-xml-tables.
     6819   define buffer buf_temp-recipe_ for temp-recipe_.
     6820   define buffer buf_temp-recipe-gds_ for temp-recipe-gds_.
     6821   function 00200003_get-error-message returns character :
     6822   define variable v-ii as integer no-undo .
     6823   define variable v-mess as character no-undo .
     6824   DO v-ii = 1 TO ERROR-STATUS:NUM-MESSAGES:
     6825       v-mess = substitute("&1&2ош &3"
     6826                           ,v-mess
     6827                           ,chr(10)
     6828                           ,ERROR-STATUS:GET-MESSAGE(v-ii)).
     6829   END.
     6830   return v-mess.
     6831   end function.
     6832   function 00200003_after-import_f returns logical ( input p-cli-type as character, input p-cli-code as integer):
     6833     run 00200003_after-import in this-procedure ( input p-cli-type, input p-cli-code) no-error.
     6834     run set-error in this-procedure ( input return-value ).
     6835     return not (error-status:error).
     6836   end function.
     6837   define variable p-xsd-file as character no-undo.
     6838   on delete of this-procedure do:
     6839     run delete-procedure in this-procedure .
     6840     run gate-clear in this-procedure ( input v_dataseth, input v-xmlh) no-error.
     6841   end.
     6842   run load-ruleset-context in this-procedure ( input p-ruleset-id) no-error .
     6843   if error-status:error
     6844   or return-value = "return" then return.
     6845   define variable ImpData1 as class Route-data_ no-undo .
     6846   ImpData1 = new Route-data_( input parparentproc, input p-parent-handle, input p-log-handle, input this-procedure:handle, input v_dataseth, input v-xmlh) .
     6847   if not this-procedure:persistent then do:
     6848     run proc-main in this-procedure no-error .
     6849     if error-status:error then do:
     6850         run delete-procedure in this-procedure .
     6851         undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     6852     end.
     6853     run delete-procedure in this-procedure .
     6854   end.
     6855   procedure proc-main :
     6856   define variable v-current-upper-node-code as integer no-undo .
     6857   define variable v-current-node-name as character no-undo .
     6858   define variable v-rid as recid no-undo .
     6859   define variable v-current-tbl-name as character no-undo .
     6860   define buffer buf_temp-rel-handle for temp-rel-handle.
     6861   define variable glog as logical no-undo .
     6862   define variable v_child-qh as handle no-undo .
     6863   define variable v-current-firm-code as integer no-undo .
     6864   _main:
     6865   do
     6866   on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     6867   on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
     6868   on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
     6869   :
     6870   run write-log  in p-log-handle (
     6871                                    input 0
     6872                                  , "&DLine").
     6873   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Импорт рецептов из файла &1", file-name)).
     6874   run tmpreldf_get-relations in this-procedure ( input  v_dataseth).
     6875   for each buf_temp-xml-tables where
     6876           buf_temp-xml-tables.order >= 0
     6877       and buf_temp-xml-tables.is-parent = yes
     6878           :
     6879     if buf_temp-xml-tables.tbl-name = "THheader" then next.
     6880     create query v_qh.
     6881     glog = v_qh:set-buffers( buf_temp-xml-tables.tbl-handle_) no-error.
     6882     if error-status:error
     6883     or
     6884     not glog then do:
     6885           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при попытке получить записи &1&2&3&2&4"                                 , buf_temp-xml-tables.tbl-name                                 , chr(10)                                 , error-status:get-message(1)                                 , return-value)).
     6886       v-view-log = yes.
     6887       undo _main, return error ''.
     6888     end.
     6889     glog = v_qh:query-prepare( substitute( "for each &1 ", buf_temp-xml-tables.tbl-name)) no-error .
     6890     if error-status:error
     6891     or
     6892     not glog then do:
     6893           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при попытке получить записи &1&2&3&2&4"                                 , buf_temp-xml-tables.tbl-name                                 , chr(10)                                 , error-status:get-message(1)                                 , return-value)).
     6894       v-view-log = yes.
     6895       undo _main, return error ''.
     6896     end.
     6897     glog = v_qh:query-open no-error .
     6898     if error-status:error
     6899     or
     6900     not glog then do:
     6901           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при попытке получить записи &1&2&3&2&4"                               , buf_temp-xml-tables.tbl-name                               , chr(10)                               , error-status:get-message(1)                               , return-value)).
     6902       v-view-log = yes.
     6903       undo _main, return error ''.
     6904     end.
     6905       _stroka:
     6906       REPEAT:
     6907         if buf_temp-xml-tables.is-parent = yes then do:
     6908           num-rec = num-rec + 1.
     6909         end.
     6910         v-retry-action = 0 .
     6911        _release:
     6912         do on error undo, retry:
     6913           if  retry then do:
     6914             v-retry-action = v-retry-action + 1.
     6915                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при импорте записи &5 &1&2&3&2&4"                                     , buf_temp-xml-tables.tbl-name                                     , num-rec                                     , chr(10)                                     , error-status:get-message(1)                                     , return-value)).
     6916             v-view-log = yes.
     6917           end.
     6918         if v-retry-action < 1 then do:
     6919                   ImpData1:Route-data_dump ( ) .
     6920         end.
     6921         end.
     6922         _rule:
     6923          do on error undo _rule, retry _rule:
     6924            if retry then do:
     6925                        run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("&1&2&3"                                       , error-status:get-message(1)                                       , chr(10)                                       , return-value)).
     6926             v-view-log = yes.
     6927              next _stroka.
     6928            end.
     6929            else do:
     6930             v_qh:get-next().
     6931             IF v_qh:query-off-end then leave _stroka.
     6932             assign
     6933             v-current-tbl-name = ''
     6934             v-current-tbl-name = ImpData1:current-tbl-name( ) no-error .
     6935             case v-current-tbl-name :
     6936               when "recipe"  THEN do:
     6937                 v-current-recipe-code = ImpData1:route-data_get-field-character( input "recipe", input "recipe-code") .
     6938                 v-current-gds-code = ImpData1:route-data_get-field-integer( input "recipe", input "gds-code") .
     6939                 find first buf_temp-recipe_ where
     6940                           buf_temp-recipe_.recipe-code = v-current-recipe-code
     6941                       and buf_temp-recipe_.gds-code = v-current-gds-code no-error.
     6942                 if not available buf_temp-recipe_ then do:
     6943                   create  buf_temp-recipe_.
     6944                   assign
     6945                   buf_temp-recipe_.recipe-code = v-current-recipe-code
     6946                   buf_temp-recipe_.gds-code = v-current-gds-code
     6947                   .
     6948                 end.
     6949                 find first ub.goods where ub.goods.gds-code = buf_temp-recipe_.gds-code no-lock no-error.
     6950                 if not available ub.goods then do:
     6951                                   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не найден товар : &1&2. Рецепт &3"                                               , buf_temp-recipe_.gds-code                                               , chr(10)                                               ,v-current-recipe-code )).
     6952                   next _stroka.
     6953                 end.
     6954                 assign  buf_temp-recipe_.artic = ub.goods.artic
     6955                         buf_temp-recipe_.prod-type = ub.goods.prod-type
     6956                         buf_temp-recipe_.prod-code = ub.goods.prod-code
     6957                 .
     6958                 assign
     6959                 glog = buffer buf_temp-recipe_:handle:buffer-copy(ImpData1:route-data_get-record("recipe"), "recipe-code,gds-code") no-error.
     6960                 if not glog
     6961                 or error-status:error then do:
     6962                                   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не удалось получить данные записи <recipe>: &1&2&3"                                               , error-status:get-message(1)                                               , chr(10)                                               , return-value)).
     6963                   next _stroka.
     6964                 end.
     6965                 _rel:
     6966                 for each buf_temp-rel-handle where
     6967                         buf_temp-rel-handle.parent-buffer_ = v-current-tbl-name:
     6968                   run tmpreld2_query in this-procedure ( buffer buf_temp-rel-handle, input-output v_child-qh) no-error.
     6969                   if error-status:error then do:
     6970                                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input return-value).
     6971                     undo _rule, retry _rule.
     6972                   end.
     6973                     _child:
     6974                     repeat:
     6975                     v_child-qh:get-next().
     6976                     IF v_child-qh:query-off-end then do:
     6977                       delete object v_child-qh no-error.
     6978                       next _rel.
     6979                     end.
     6980                     case buf_temp-rel-handle.child-buffer_:
     6981                       when "recipe-gds"
     6982                       THEN do:
     6983                       v-current-rcp-gds-code = ImpData1:route-data_get-field-integer( buffer buf_temp-rel-handle:handle, input buf_temp-rel-handle.child-buffer_, input "rcp-gds-code") .
     6984                         find first ub.goods where ub.goods.gds-code = v-current-rcp-gds-code no-lock no-error.
     6985                         if not available ub.goods then do:
     6986                                                   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не найден товар : &1&2. Рецепт &3"                                                       , v-current-rcp-gds-code                                                       , chr(10)                                                       ,v-current-recipe-code )).
     6987                           next _stroka.
     6988                         end.
     6989                         find first buf_temp-recipe-gds_ where
     6990                                   buf_temp-recipe-gds_.recipe-code = v-current-recipe-code
     6991                                 and  buf_temp-recipe-gds_.gds-code = v-current-gds-code
     6992                                 and  buf_temp-recipe-gds_.rcp-gds-code = v-current-rcp-gds-code
     6993                         no-error.
     6994                         if not available buf_temp-recipe-gds_ then do:
     6995                           create  buf_temp-recipe-gds_.
     6996                           assign
     6997                                buf_temp-recipe-gds_.recipe-code = v-current-recipe-code
     6998                                buf_temp-recipe-gds_.gds-code = v-current-gds-code
     6999                                buf_temp-recipe-gds_.rcp-gds-code = v-current-rcp-gds-code
     7000                                buf_temp-recipe-gds_.artic = ub.goods.artic
     7001                                buf_temp-recipe-gds_.prod-type = ub.goods.prod-type
     7002                                buf_temp-recipe-gds_.prod-code = ub.goods.prod-code
     7003                           .
     7004                         end.
     7005                         assign
     7006                         glog = buffer buf_temp-recipe-gds_:handle:buffer-copy(buf_temp-rel-handle.child-buffer-handle
     7007                                                                         ,"recipe-code,gds-code,rcp-gds-code"
     7008                                                                       ) no-error.
     7009                         if not glog
     7010                         or error-status:error then do:
     7011                                                   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не удалось получить данные записи <&4>: &1&2&3"                                                     , error-status:get-message(1)                                                     , chr(10)                                                     , return-value                                                     , buf_temp-rel-handle.child-buffer_)).
     7012                           undo _rule, retry _rule.
     7013                         end.
     7014                         release buf_temp-recipe-gds_.
     7015                       end.
     7016                     end case.
     7017                   end.
     7018                   delete object v_child-qh no-error.
     7019                 end.
     7020                 run check-recipe(
     7021                 buf_temp-recipe_.recipe-code,
     7022                 buf_temp-recipe_.recipe-name,
     7023                 buf_temp-recipe_.qnty,
     7024                 buf_temp-recipe_.portion-qnty,
     7025                 buf_temp-recipe_.portion-weight,
     7026                 buf_temp-recipe_.recipe-ref-num,
     7027                 buf_temp-recipe_.recipe-technique,
     7028                 output  glog,
     7029                 output  v-last-error-message
     7030                 ) no-error.
     7031                 if error-status:error  or  glog then do:
     7032                                   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при проверке рецепта &4.&2&1&2&3"                                           , error-status:get-message(1)                                           , chr(10)                                           , return-value +  v-last-error-message                                           ,buf_temp-recipe_.recipe-code)).
     7033                   v-view-log = yes.
     7034                   next _stroka.
     7035                 end.
     7036                 run create-new-recipe(output v-sys-recipe-code) no-error.
     7037                 if error-status:error then do:
     7038                                   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("&1&2&3"                                           , error-status:get-message(1)                                           , chr(10)                                           , return-value)).
     7039                   v-view-log = yes.
     7040                   next _stroka.
     7041                 end.
     7042                 for each temp-recipe-gds_ where
     7043                 temp-recipe-gds_.recipe-code = v-current-recipe-code
     7044                 by temp-recipe-gds_.proc-number :
     7045                   run fbrlib-create-or-update-recipe-gds in this-procedure (
     7046                         input v-sys-recipe-code
     7047                       , input temp-recipe-gds_.rcp-gds-code
     7048                       , input temp-recipe-gds_.is-waste
     7049                       , input temp-recipe-gds_.qnty
     7050                       , input temp-recipe-gds_.proc-number
     7051                       , input no
     7052                   ) no-error.
     7053                   if error-status:error then do:
     7054                                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("&1&2&3"                                             , error-status:get-message(1)                                             , chr(10)                                             , return-value)).
     7055                     v-view-log = yes.
     7056                     next _stroka.
     7057                   end.
     7058                 end.
     7059                 if available buf_temp-recipe_ then delete buf_temp-recipe_.
     7060                 if available buf_temp-recipe-gds_ then empty temp-table buf_temp-recipe-gds_.
     7061               end.
     7062             end case.
     7063             if error-status:error then do:
     7064                           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("&1&2&3"                                       , error-status:get-message(1)                                       , chr(10)                                       , return-value)).
     7065               v-view-log = yes.
     7066               next _stroka.
     7067             end.
     7068           end.
     7069         end.
     7070         v-retry-action = 0 .
     7071        _release:
     7072         do on error undo, retry:
     7073           if  retry then do:
     7074             v-retry-action = v-retry-action + 1.
     7075                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("&1&2&3"                                     , error-status:get-message(1)                                     , chr(10)                                     , v-last-error-message )).
     7076             v-view-log = yes.
     7077           end.
     7078         if v-retry-action < 1 then do:
     7079                   ImpData1:Route-data_dump ( ) .
     7080         end.
     7081         end.
     7082         if v-retry-action = 0 then do:
     7083           if buf_temp-xml-tables.is-parent = yes then do:
     7084             num-rec-ok = num-rec-ok + 1.
     7085           end.
     7086         end.
     7087         run write-counter in p-log-handle ( input substitute("Обработано строк: &1, из них удачно: &2", num-rec, num-rec-ok)).
     7088         process events.
     7089         run get-stop-state in p-log-handle ( output v-stop) no-error .
     7090         if v-stop then do:
     7091             run write-log-and-file in p-log-handle (
     7092                                                     input 1
     7093                                                   , input log-file-name
     7094                                                   , input 1
     7095                                                   , input substitute("Процесс импорта прерван пользователем")).
     7096            leave _stroka.
     7097         end.
     7098       end.
     7099       if not v-stop then do:
     7100         if buf_temp-xml-tables.is-parent = yes then do:
     7101           num-rec = num-rec - 1.
     7102         end.
     7103       end.
     7104       v_qh:query-close().
     7105       if valid-handle(v_qh) then do:
     7106         delete object v_qh.
     7107       end.
     7108     end.
     7109       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Обработано строк: &1, из них удачно: &2", num-rec, num-rec-ok)).
     7110   end.
     7111   end procedure.
     7112   procedure load-ruleset-context :
     7113   define input parameter p-ruleset-id as integer no-undo .
     7114   define buffer buf_rule-call-param for tt0-rule-call-param.
     7115   do
     7116   on error undo, return error
     7117   :
     7118     find first buf_rule-call-param no-lock where
     7119   buf_rule-call-param.codex_id = p-codex-id
     7120   and buf_rule-call-param.ruleset_id = p-ruleset-id
     7121   and buf_rule-call-param.call_id = p-call-id
     7122   and buf_rule-call-param.order_id = p-order-id
     7123   and buf_rule-call-param.rule_id = p-rule-id
     7124   and buf_rule-call-param.param-name = "p-xsd-file"
     7125    no-error.
     7126   if available buf_rule-call-param then do:
     7127   assign p-xsd-file = buf_rule-call-param.param-value-character.
     7128   end.
     7129       case p-ruleset-id:
     7130         when 3 then do:
     7131           assign
     7132           v-sign = 1
     7133           v-current-host-code = p-host-code
     7134           v-current-obj-type = p-obj-type
     7135           v-current-obj-code = p-obj-code
     7136           v-current-db-num = g#db-num
     7137           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     7138           file-name  = entry(1, p-process-file-name, chr(4))
     7139           v-xmlh = buffer buf_temp-xml-tables:handle:table-handle:default-buffer-handle
     7140           .
     7141           run rul/rum-xmli.p  (
     7142                                input parparentproc
     7143                               ,input p-log-handle
     7144                               ,input file-name
     7145                               ,input p-profile-id
     7146                               ,input p-xsd-file
     7147                               ,input 0
     7148                               ,input 0
     7149                               ,input-output v_dataseth
     7150                               ,input-output v-xmlh
     7151                               ) no-error.
     7152           if error-status:error then do:
     7153             undo, return error substitute("&1&2&3"
     7154                                             , error-status:get-message(1)
     7155                                             , chr(10)
     7156                                             , return-value ).
     7157           end.
     7158           v-xmlh = buffer buf_temp-xml-tables:handle.
     7159         end.
     7160         otherwise do:
     7161           undo, return error "Неправильный вызов".
     7162         end.
     7163       end case.
     7164     end.
     7165   end procedure.
     7166   procedure delete-procedure :
     7167     do
     7168     on error undo, return error
     7169     :
     7170         for each temp-recipe_:
     7171           delete temp-recipe_.
     7172         end.
     7173         run garbcoll_clear in this-procedure .
     7174     end.
     7175   end procedure.
     7176   procedure 00120003_after-import :
     7177   define input  parameter p-obj-type as character no-undo .
     7178   define input  parameter p-obj-code as integer no-undo .
     7179   end procedure.
     7180   PROCEDURE check-recipe :
     7181   do
     7182   on error undo, return error
     7183   :
     7184   define input parameter p-recipe-code        as character    no-undo.
     7185   define input parameter p-recipe-name        as character    no-undo.
     7186   define input parameter p-recipe-qnty        as decimal      no-undo.
     7187   define input parameter p-portion-qnty       as decimal      no-undo.
     7188   define input parameter p-portion-weight     as decimal      no-undo.
     7189   define input parameter p-recipe-ref-num     as character    no-undo.
     7190   define input parameter p-recipe-technique   as character    no-undo.
     7191   define output parameter p-bad-data          as logical      no-undo.
     7192   define output parameter p-error-text        as character    no-undo.
     7193       define variable v-gds-code              as integer      no-undo.
     7194       define variable v-unit-base             as character    no-undo.
     7195       define variable v-is-goods              as logical      no-undo.
     7196       define variable v-empty-scale           as logical      no-undo.
     7197       define variable v-ingr-count            as integer      no-undo.
     7198       define variable v-waste-count           as integer      no-undo.
     7199       define variable v-sum-gds-qnty          as decimal      no-undo.
     7200       define variable v-sum-gds-brutto-qnty   as decimal      no-undo.
     7201       define buffer buf_units             for units.
     7202       define buffer buf_other_recipe-gds  for recipe-gds.
     7203       .
     7204   define variable vss-include-info43 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7205   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     7206     (input  buf_temp-recipe_.artic
     7207     ,input  buf_temp-recipe_.prod-type
     7208     ,input  buf_temp-recipe_.prod-code
     7209     ,input  'empty-scale=request':u
     7210     ,output v-empty-scale
     7211     )  .
     7212   define variable vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7213   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     7214     (input  buf_temp-recipe_.artic
     7215     ,input  buf_temp-recipe_.prod-type
     7216     ,input  buf_temp-recipe_.prod-code
     7217     ,output v-gds-code
     7218     )  .
     7219   define variable vss-include-info45 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7220   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run unitbase in g#library
     7221     (input  v-gds-code
     7222     ,output v-unit-base
     7223     )  .
     7224       find first buf_units no-lock
     7225            where buf_units.unit-name = v-unit-base
     7226       .
     7227       if p-portion-qnty < 1
     7228       and buf_temp-recipe_.recipe-type = 'производство':U
     7229       then do:
     7230           assign
     7231               p-bad-data   = yes
     7232               p-error-text = "Количество порций не может быть меньше 1."
     7233           .
     7234           undo, return.
     7235       end.
     7236       if lookup( 'шту':U, buf_units.type ) > 0
     7237       and buf_temp-recipe_.recipe-type = 'производство':U
     7238       then do:
     7239           if p-portion-qnty <> p-recipe-qnty
     7240           then do:
     7241               assign
     7242                   p-bad-data   = yes
     7243                   p-error-text = "Для штучного товара количество порций "
     7244                                  + chr(10) + "должно быть равно количеству товара рецепта."
     7245               .
     7246               undo, return.
     7247           end.
     7248       end.
     7249       if p-recipe-name = ?
     7250       or p-recipe-name = ""
     7251       then do:
     7252           assign
     7253               p-bad-data   = yes
     7254               p-error-text = "Название рецепта не может быть пустым."
     7255           .
     7256           undo, return.
     7257       end.
     7258       if v-empty-scale = no
     7259       then do:
     7260           assign
     7261               p-bad-data   = yes
     7262               p-error-text = "В рецепте могут быть только товары без шкал."
     7263           .
     7264           undo, return.
     7265       end.
     7266       if ( buf_temp-recipe_.recipe-type = 'производство':U
     7267         or buf_temp-recipe_.recipe-type = 'комплектация':U
     7268         or buf_temp-recipe_.recipe-type = 'альтернатива':U )
     7269       and ( p-recipe-qnty <= 0
     7270          or p-recipe-qnty = ? )
     7271       then do:
     7272           assign
     7273               p-bad-data   = yes
     7274               p-error-text = "Количество составного товара рецепта должно быть больше 0."
     7275           .
     7276           undo, return.
     7277       end.
     7278       if lookup( 'шту':U, buf_units.type ) > 0
     7279       and ( truncate( p-recipe-qnty, 0 ) - p-recipe-qnty ) <> 0
     7280       and buf_temp-recipe_.recipe-type <> 'альтернатива':U
     7281       then do:
     7282           assign
     7283               p-bad-data   = yes
     7284               p-error-text = "Товар рецепта штучный, его количество не может быть дробным."
     7285           .
     7286           undo, return.
     7287       end.
     7288   define variable vss-include-info46 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7289   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     7290     (input  buf_temp-recipe_.artic
     7291     ,input  buf_temp-recipe_.prod-type
     7292     ,input  buf_temp-recipe_.prod-code
     7293     ,input  'gds-goods=request':u
     7294     ,output v-is-goods
     7295     )  .
     7296       if buf_temp-recipe_.recipe-type = 'комплектация':U
     7297       and lookup( 'шту':U, buf_units.type ) = 0
     7298       and v-is-goods = yes
     7299       then do:
     7300           assign
     7301               p-bad-data   = yes
     7302               p-error-text = "Рецепт на комплектацию может быть составлен только для штучного товара."
     7303           .
     7304           undo, return.
     7305       end.
     7306       if buf_temp-recipe_.recipe-type = 'разделка':U
     7307       and lookup( 'вес':U, buf_units.type ) = 0
     7308       and v-is-goods = yes
     7309       then do:
     7310           assign
     7311               p-bad-data   = yes
     7312               p-error-text = "Рецепт на разделку может быть составлен только для весового товара."
     7313           .
     7314           undo, return.
     7315       end.
     7316       if lookup( 'сер':U, buf_units.type ) > 0
     7317       then do:
     7318           assign
     7319               p-bad-data   = yes
     7320               p-error-text = "Для серийного товара не может быть составлен рецепт."
     7321           .
     7322           undo, return.
     7323       end.
     7324       assign
     7325           v-ingr-count = 0
     7326       .
     7327       for each buf_temp-recipe-gds_
     7328          where buf_temp-recipe-gds_.recipe-code = buf_temp-recipe_.recipe-code
     7329       :
     7330           if buf_temp-recipe-gds_.qnty = 0
     7331           and buf_temp-recipe_.recipe-type <> 'разделка':U
     7332           then do:
     7333               assign
     7334                   p-bad-data   = yes
     7335                   p-error-text = "Нулевое количество товара в строке рецепта."
     7336                                   + chr(10) + "Артикул товара:" + buf_temp-recipe-gds_.artic
     7337               .
     7338               undo, return.
     7339           end.
     7340           if  buf_temp-recipe-gds_.artic     = buf_temp-recipe_.artic
     7341           and buf_temp-recipe-gds_.prod-type = buf_temp-recipe_.prod-type
     7342           and buf_temp-recipe-gds_.prod-code = buf_temp-recipe_.prod-code
     7343           then do:
     7344               assign
     7345                   p-bad-data   = yes
     7346                   p-error-text = "Строка рецепта не может содержать тот же товар, что и сам рецепт."
     7347               .
     7348               undo, return.
     7349           end.
     7350   define variable vss-include-info47 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7351   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     7352     (input  buf_temp-recipe-gds_.artic
     7353     ,input  buf_temp-recipe-gds_.prod-type
     7354     ,input  buf_temp-recipe-gds_.prod-code
     7355     ,output v-gds-code
     7356     )  .
     7357   define variable vss-include-info48 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7358   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run unitbase in g#library
     7359     (input  v-gds-code
     7360     ,output v-unit-base
     7361     )  .
     7362           find first buf_units no-lock
     7363                where buf_units.unit-name = v-unit-base
     7364           .
     7365           if lookup( 'шту':U, buf_units.type ) > 0
     7366           and ( truncate( buf_temp-recipe-gds_.qnty, 0 ) - buf_temp-recipe-gds_.qnty ) <> 0
     7367           and buf_temp-recipe_.recipe-type <> 'альтернатива':U
     7368           then do:
     7369               assign
     7370                   p-bad-data   = yes
     7371                   p-error-text = "Товар-ингредиент штучный, его количество не может быть дробным."
     7372               .
     7373               undo, return.
     7374           end.
     7375   define variable vss-include-info49 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7376   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     7377     (input  buf_temp-recipe-gds_.artic
     7378     ,input  buf_temp-recipe-gds_.prod-type
     7379     ,input  buf_temp-recipe-gds_.prod-code
     7380     ,input  'gds-goods=request':u
     7381     ,output v-is-goods
     7382     )  .
     7383           if buf_temp-recipe_.recipe-type = 'комплектация':U
     7384           and lookup( 'шту':U, buf_units.type ) = 0
     7385           and v-is-goods = yes
     7386           then do:
     7387               assign
     7388                   p-bad-data   = yes
     7389                   p-error-text = "В рецепте на комплектацию должен быть только штучный товар."
     7390               .
     7391               undo, return.
     7392           end.
     7393           if buf_temp-recipe_.recipe-type = 'разделка':U
     7394           and lookup( 'вес':U, buf_units.type ) = 0
     7395           and v-is-goods = yes
     7396           then do:
     7397               assign
     7398                   p-bad-data   = yes
     7399                   p-error-text = "В рецепте на разделку должен быть только весовой товар."
     7400               .
     7401               undo, return.
     7402           end.
     7403           if lookup( 'сер':U, buf_units.type ) > 0
     7404           then do:
     7405               assign
     7406                   p-bad-data   = yes
     7407                   p-error-text = "В рецепте не может быть серийного товара."
     7408               .
     7409               undo, return.
     7410           end.
     7411           if lookup( 'топ':U, buf_units.type ) > 0
     7412           then do:
     7413               find first buf_other_recipe-gds
     7414                    where buf_other_recipe-gds.artic        = buf_temp-recipe-gds_.artic
     7415                      and buf_other_recipe-gds.prod-type    = buf_temp-recipe-gds_.prod-type
     7416                      and buf_other_recipe-gds.prod-code    = buf_temp-recipe-gds_.prod-code
     7417                      and buf_other_recipe-gds.recipe-code  <> buf_temp-recipe-gds_.recipe-code
     7418               no-error.
     7419               if available buf_other_recipe-gds
     7420               then do:
     7421                   assign
     7422                       p-bad-data   = yes
     7423                       p-error-text = "Сервисный элемент может входить только в один рецепт."
     7424                   .
     7425                   undo, return.
     7426               end.
     7427           end.
     7428           if ( buf_temp-recipe_.recipe-type <> 'топливо':U
     7429               and lookup( 'топ':U, buf_units.type ) > 0 )
     7430           or ( buf_temp-recipe_.recipe-type = 'топливо':U
     7431               and lookup( 'топ':U, buf_units.type ) = 0 )
     7432           then do:
     7433               assign
     7434                   p-bad-data   = yes
     7435                   p-error-text = "Топливный товар (услуга) может входить только в топливный рецепт."
     7436               .
     7437               undo, return.
     7438           end.
     7439           assign
     7440               v-ingr-count = v-ingr-count + 1
     7441           .
     7442           if buf_temp-recipe-gds_.is-waste = yes
     7443           then do:
     7444               assign
     7445                   v-waste-count = v-waste-count + 1
     7446               .
     7447           end.
     7448           assign
     7449               v-sum-gds-qnty          = v-sum-gds-qnty        + buf_temp-recipe-gds_.qnty
     7450           .
     7451       end.
     7452       if buf_temp-recipe_.recipe-type = 'разделка':U
     7453       and v-sum-gds-qnty <> ?
     7454       and v-sum-gds-qnty <> buf_temp-recipe_.qnty
     7455       then do:
     7456           assign
     7457               p-bad-data   = yes
     7458               p-error-text = "В рецепте разделки сумма количеств ингредиентов"
     7459                           + chr(10) + "не равна количеству составного товара."
     7460           .
     7461           undo, return.
     7462       end.
     7463       if v-ingr-count = 0
     7464       then do:
     7465           assign
     7466               p-bad-data   = yes
     7467               p-error-text = "В рецепте нет ни одной строки."
     7468           .
     7469           undo, return.
     7470       end.
     7471       if buf_temp-recipe_.recipe-type = 'топливо':U
     7472       and v-ingr-count <> 1
     7473       then do:
     7474           assign
     7475               p-bad-data   = yes
     7476               p-error-text = "В топливном рецепте должна быть ровно 1 строка."
     7477           .
     7478           undo, return.
     7479       end.
     7480       if buf_temp-recipe_.recipe-type = 'разделка':U
     7481       and v-ingr-count = 1
     7482       then do:
     7483           assign
     7484               p-bad-data   = yes
     7485               p-error-text = "В рецепте разделки не может быть только 1 строка."
     7486           .
     7487           undo, return.
     7488       end.
     7489       if v-ingr-count = v-waste-count
     7490       then do:
     7491           assign
     7492               p-bad-data   = yes
     7493               p-error-text = "Рецепт не может состоять из одних отходов."
     7494           .
     7495           undo, return.
     7496       end.
     7497       if   buf_temp-recipe_.host-code <> 0 then do:
     7498         find first ub.clients where
     7499             ub.clients.obj-type = buf_temp-recipe_.obj-type
     7500             and ub.clients.obj-code = buf_temp-recipe_.obj-code
     7501             and ub.clients.host-code = buf_temp-recipe_.host-code
     7502             no-lock no-error.
     7503         if not available ub.clients then do:
     7504           assign
     7505               p-bad-data   = yes
     7506               p-error-text = substitute("Не найден объект &1&2 для фирмы &3.")
     7507           .
     7508           undo, return.
     7509         end.
     7510       end.
     7511   end.
     7512   END PROCEDURE.
     7513   PROCEDURE create-new-recipe :
     7514   define output parameter p-sys-recipe-code like ub.recipe.recipe-code.
     7515   do
     7516   on error undo, return error
     7517   :
     7518   find first ub.goods where ub.goods.gds-code = buf_temp-recipe_.gds-code no-lock no-error.
     7519   if not available ub.goods then do:
     7520     return error substitute("Не найден товар &1,p-gds-code").
     7521   end.
     7522   define buffer buf_recipe        for recipe.
     7523       create buf_recipe .
     7524       assign
     7525           buf_recipe.recipe-code   = string( next-value( s-recipe, ub ) )
     7526           buf_recipe.recipe-type         = buf_temp-recipe_.recipe-type
     7527           buf_recipe.recipe-name         = ub.goods.gds-name
     7528           buf_recipe.qnty                = 1.0
     7529           buf_recipe.portion-qnty        = 1
     7530           buf_recipe.gds-code            = buf_temp-recipe_.gds-code
     7531           buf_recipe.is-default          = buf_temp-recipe_.is-default
     7532           buf_recipe.artic               = ub.goods.artic
     7533           buf_recipe.prod-type           = ub.goods.prod-type
     7534           buf_recipe.prod-code           = ub.goods.prod-code
     7535           buf_recipe.host-code           = buf_temp-recipe_.host-code
     7536           buf_recipe.obj-type            = if buf_temp-recipe_.host-code = 0 then '' else buf_temp-recipe_.obj-type
     7537           buf_recipe.obj-code            = if buf_temp-recipe_.host-code = 0 then 0 else buf_temp-recipe_.obj-code
     7538           buf_recipe.recipe-design       = buf_temp-recipe_.recipe-design
     7539           buf_recipe.recipe-order        = 0
     7540           buf_recipe.recipe-quality      = buf_temp-recipe_.recipe-quality
     7541           buf_recipe.recipe-ref-num      = buf_temp-recipe_.recipe-ref-num
     7542           buf_recipe.recipe-technique    = buf_temp-recipe_.recipe-technique
     7543       .
     7544   p-sys-recipe-code = buf_recipe.recipe-code.
     7545   end.
     7546   END PROCEDURE.
