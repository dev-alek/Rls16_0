     1618   THesys-id
     1619   THrcvd
     1620   .
     1621   procedure get-header-by-rec :
     1622   define input  parameter p-gate-rec as character no-undo .
     1623   define output parameter p-tth as handle no-undo .
     1624   define variable v-ii as integer   no-undo .
     1625   define variable glog as logical   no-undo .
     1626   define variable v-rowid as rowid no-undo .
     1627   define variable v-tbl-name as character no-undo .
     1628   define variable v-longchar as longchar no-undo .
     1629   define variable v-txmlh as handle no-undo .
     1630   define buffer buf_clob-data for ub.clob-data.
     1631   main-block:
     1632   do
     1633   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info12, return-value, chr(10), error-status :get-message (1))
     1634   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info12 )
     1635   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info12 )
     1636   :
     1637     run gen-row-keyr in  this-procedure  (
     1638                                           input  p-gate-rec
     1639                                           ,input  ?
     1640                                           ,input  "ub"
     1641                                           ,input  ?
     1642                                           ,input  NO-LOCK
     1643                                           ,output v-rowid
     1644                                           ,output v-tbl-name   ) no-error.
     1645       find first buf_clob-data no-lock where
     1646                 rowid(buf_clob-data) = v-rowid  no-error.
     1647       if not available buf_clob-data then do:
     1648         undo, return error substitute("Не найден CLOB  &1"
     1649                                         , p-gate-rec
     1650                                         ).
     1651       end.
     1652       assign
     1653       v-longchar = buf_clob-data.cdata
     1654       .
     1655       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1656       if error-status :error then do:
     1657         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1658       end.
     1659       create temp-table p-tth .
     1660       glog = p-tth:READ-XMLSCHEMA( "LONGCHAR"
     1661                                     , v-longchar
     1662                                     , ?
     1663                                     , ?
     1664                                     , ?
     1665                                     ) no-error.
     1666       v-longchar = '':U.
     1667       define variable v-esm as character no-undo .
     1668       v-esm = error-status:get-message(1).
     1669       if error-status :error
     1670       or not glog
     1671       then do:
     1672         delete object p-tth no-error.
     1673         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     1674                                    , p-gate-rec
     1675                                    , buf_clob-data.file-name_
     1676                                    , chr(10)
     1677                                    , v-esm
     1678                                     ).
     1679       end.
     1680   end.
     1681   end procedure.
     1682   // { bge/getoxmlh.i } 23/VIII-2018 xmllib.i и tmpcxmlh.i вставлены напрямую
     1683   define variable vss-include-info13 as character format "X(65)" no-undo
     1684   initial "@(#)$Workfile$ $Revision$".
     1685   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1686   define stream stmXMLOut.
     1687   define stream stmXMLLog.
     1688   define stream strXMLIn.
     1689   define temp-table temp_xmllib_rec-list no-undo
     1690       field recName       as character
     1691       field recLevel      as integer
     1692       field recOpenLine   as integer
     1693       field recCloseLine  as integer
     1694       field closed        as logical
     1695       index pi is primary unique
     1696           recName
     1697           recLevel
     1698       index cl
     1699           closed
     1700   .
     1701   define temp-table temp_xmllib_rec-fld-list no-undo
     1702       field recName       as character
     1703       field recLevel      as integer
     1704       field fldName       as character
     1705       field fldOpenLine   as integer
     1706       field fldCloseLine  as integer
     1707       field closed        as logical
     1708       index pi is primary unique
     1709           recName
     1710           recLevel
     1711           fldName
     1712       index fn
     1713           fldName
     1714       index cl
     1715           closed
     1716   .
     1717   define temp-table temp_xmllib_rec no-undo
     1718       field rec-key       as integer
     1719       field recLevel      as integer
     1720       field recOpenLine   as integer
     1721       field recCloseLine  as integer
     1722       field recName       as character
     1723       field closed        as logical
     1724       index pi is primary unique
     1725           rec-key
     1726       index nm
     1727           recName
     1728           closed
     1729           rec-key
     1730       index cl
     1731           closed
     1732       index rlv
     1733           recName
     1734           recLevel
     1735           closed
     1736           rec-key
     1737   .
     1738   define temp-table temp_xmllib_rec-fld no-undo
     1739       field fld-key       as integer
     1740       field rec-key       as integer
     1741       field fldOpenLine   as integer
     1742       field fldCloseLine  as integer
     1743       field fldName       as character
     1744       field fldValue      as character
     1745       field closed        as logical
     1746       index pi is primary unique
     1747           fld-key
     1748       index nm
     1749           rec-key
     1750           fldName
     1751           closed
     1752           fld-key
     1753       index cl
     1754           closed
     1755   .
     1756   define variable v-xmllib-rec-key            as integer      no-undo .
     1757   define variable v-xmllib-rec-fld-key        as integer      no-undo .
     1758   define variable v-xmllib-dirname            as character    no-undo .
     1759   define variable v-xmllib-filename           as character    no-undo .
     1760   define variable v-xmllib-log-filename       as character    no-undo .
     1761   define variable v-xmllib-log-handle         as handle       no-undo .
     1762   define variable v-xmllib-log-proc-name      as character    no-undo .
     1763   define variable v-xmllib-error-status       as logical      no-undo .
     1764   define variable v-xmllib-sax-reader-handle  as handle       no-undo .
     1765   define variable v-xmllib-prg-bar-handle     as handle       no-undo .
     1766   define variable v-xmllib-codepage-convert   as logical      no-undo .
     1767   define variable v-xmllib-codepage-source    as character    no-undo .
     1768   define variable v-xmllib-codepage-target    as character    no-undo .
     1769   procedure xmllib-clear-parse-data :
     1770   do
     1771   on error undo, return error
     1772   :
     1773       empty temp-table temp_xmllib_rec-list.
     1774       empty temp-table temp_xmllib_rec-fld-list.
     1775       empty temp-table temp_xmllib_rec.
     1776       empty temp-table temp_xmllib_rec-fld.
     1777   end.
     1778   end procedure.
     1779   procedure xmllib-add-rec-fld :
     1780   define input parameter p-rec-name       as character        no-undo.
     1781   define input parameter p-rec-fld-name   as character        no-undo.
     1782       define buffer buf_rec-list        for temp_xmllib_rec-list.
     1783       define buffer buf_rec-fld-list    for temp_xmllib_rec-fld-list.
     1784   do
     1785   for buf_rec-list
     1786     , buf_rec-fld-list
     1787   on error undo, return error
     1788   :
     1789       find first buf_rec-list
     1790            where buf_rec-list.recName = p-rec-name
     1791       no-error.
     1792       if not available buf_rec-list
     1793       then do:
     1794           create buf_rec-list.
     1795           assign
     1796               buf_rec-list.recName        = p-rec-name
     1797               buf_rec-list.recOpenLine    = 0
     1798               buf_rec-list.recCloseLine   = 0
     1799               buf_rec-list.closed         = yes
     1800           .
     1801       end.
     1802       find first buf_rec-fld-list
     1803            where buf_rec-fld-list.recName = p-rec-name
     1804              and buf_rec-fld-list.fldName = p-rec-fld-name
     1805       no-error.
     1806       if not available buf_rec-fld-list
     1807       then do:
     1808           create buf_rec-fld-list.
     1809           assign
     1810               buf_rec-fld-list.recName        = p-rec-name
     1811               buf_rec-fld-list.fldName        = p-rec-fld-name
     1812               buf_rec-fld-list.fldOpenLine    = 0
     1813               buf_rec-fld-list.fldCloseLine   = 0
     1814               buf_rec-fld-list.closed         = yes
     1815           .
     1816       end.
     1817   end.
     1818   end procedure.
     1819   procedure xmllib-tag-open:
     1820   define input parameter v-tag-level  as integer      no-undo.
     1821   define input parameter v-tag-name   as character    no-undo.
     1822   define input parameter v-tag-value  as character    no-undo.
     1823   do
     1824   on error undo, return error
     1825   :
     1826       assign
     1827           v-tag-name = trim( v-tag-name )
     1828       .
     1829       put stream stmXMLOut unformatted
     1830           substitute( "&1&2<&3&4&5>"
     1831               , chr(10)
     1832               , fill(" ", 4 * v-tag-level)
     1833               , v-tag-name
     1834               , ( if v-tag-value = "":U or v-tag-value = ? then "":U else " ":U )
     1835               , v-tag-value
     1836           )
     1837       .
     1838   end.
     1839   end procedure.
     1840   procedure xmllib-tag-put:
     1841   define input parameter v-tag-level      as integer      no-undo.
     1842   define input parameter v-tag-name       as character    no-undo.
     1843   define input parameter v-tag-value      as character    no-undo.
     1844   define input parameter v-empty-mode     as integer      no-undo.
     1845   do
     1846   on error undo, return error
     1847   :
     1848       assign
     1849           v-tag-name = trim( v-tag-name )
     1850       .
     1851       if  v-empty-mode = 1
     1852       or (v-empty-mode = 0 and (v-tag-value <> "":U and v-tag-value <> ?) )
     1853       or (v-empty-mode = 2 and (v-tag-value <> "":U and v-tag-value <> ? and v-tag-value <> "0":U))
     1854       or (v-empty-mode = 3 and (v-tag-value <> "":U and v-tag-value <> ? and caps(v-tag-value) <> "no":U))
     1855       then do:
     1856           run xmlchar-encode in this-procedure (
     1857                 input v-tag-value
     1858               , output v-tag-value
     1859           ).
     1860           put stream stmXMLOut unformatted
     1861               substitute( "&1&2<&3>&4</&3>"
     1862                   , chr(10)
     1863                   , fill(" ":U, 4 * v-tag-level)
     1864                   , v-tag-name
     1865                   , v-tag-value
     1866               )
     1867           .
     1868       end.
     1869   end.
     1870   end procedure.
     1871   procedure xmllib-tag-put-null :
     1872   define input parameter p-tag-level  as integer      no-undo.
     1873   define input parameter p-tag-name   as character    no-undo.
     1874   do
     1875   on error undo, return error
     1876   :
     1877       assign
     1878           p-tag-name = trim( p-tag-name )
     1879       .
     1880       put stream stmXMLOut unformatted
     1881           substitute( '&1&2<&3 nil="true" /&3>'
     1882               , chr(10)
     1883               , fill(" ":U, 4 * p-tag-level)
     1884               , p-tag-name
     1885           )
     1886       .
     1887   end.
     1888   end procedure.
     1889   procedure xmllib-tag-close:
     1890   define input parameter v-tag-level as integer      no-undo.
     1891   define input parameter v-tag-name  as character    no-undo.
     1892   do
     1893   on error undo, return error
     1894   :
     1895       assign
     1896           v-tag-name = trim( v-tag-name )
     1897       .
     1898       put stream stmXMLOut unformatted
     1899           substitute( "&1&2</&3>"
     1900               , chr(10)
     1901               , fill( " ":U, 4 * v-tag-level)
     1902               , v-tag-name
     1903           )
     1904       .
     1905   end.
     1906   end procedure.
     1907   procedure xmllib-write-log:
     1908   define input parameter v-filename   as character    no-undo.
     1909   define input parameter v-log-level  as integer      no-undo.
     1910   define input parameter v-out-string as character    no-undo.
     1911   do
     1912   on error undo, return error
     1913   :
     1914       output stream stmXMLLog to value( v-filename ) append.
     1915       put stream stmXMLLog unformatted
     1916           chr(10)
     1917       .
     1918       put stream stmXMLLog unformatted
     1919           ( if v-log-level = 0
     1920             or v-out-string = "&DLine":U
     1921             or v-out-string = "&Line":U
     1922             then "":U
     1923             else cur-time-string-sec() + " ":U )
     1924       .
     1925       put stream stmXMLLog unformatted
     1926           ( if v-out-string = "&Line":U
     1927             then fill( "-":U, 80 )
     1928             else if v-out-string = "&DLine":U
     1929                  then fill( "=":U, 80 )
     1930                  else v-out-string )
     1931       .
     1932       output stream stmXMLLog close.
     1933   end.
     1934   end procedure.
     1935   procedure xmllib-write-edt:
     1936   define input parameter v-editor-handle    as handle       no-undo.
     1937   define input parameter v-log-level        as integer      no-undo.
     1938   define input parameter v-out-string       as character    no-undo.
     1939   do
     1940   on error undo, return error
     1941   :
     1942       if valid-handle ( v-editor-handle )
     1943       then do:
     1944           v-editor-handle :move-to-eof().
     1945           v-editor-handle :insert-string( ( if v-log-level = 0
     1946                                             or v-out-string = "&DLine":U
     1947                                             or v-out-string = "&Line":U
     1948                                             then "":U
     1949                                             else cur-time-string-sec() + " ":U
     1950                                         ) ).
     1951           v-editor-handle :insert-string( ( if v-out-string = "&Line":U
     1952                                             then fill( "-":U, 80 )
     1953                                             else if v-out-string = "&DLine":U then fill("=":U, 80)
     1954                                             else fill( " ":U, v-log-level) + v-out-string
     1955                                         ) ).
     1956           v-editor-handle :insert-string( chr(10) ).
     1957       end.
     1958   end.
     1959   end procedure.
     1960   procedure xmllib-show-cnt:
     1961   define input parameter v-fillin-handle     as handle   no-undo.
     1962   do
     1963   on error undo, return error
     1964   :
     1965       if valid-handle( v-fillin-handle )
     1966       then do:
     1967           assign
     1968               v-fillin-handle :visible = true
     1969           .
     1970       end.
     1971   end.
     1972   end procedure.
     1973   procedure xmllib-hide-cnt:
     1974   define input parameter v-fillin-handle     as handle   no-undo.
     1975   do
     1976   on error undo, return error
     1977   :
     1978       if valid-handle( v-fillin-handle )
     1979       then do:
     1980           assign v-fillin-handle :visible = false.
     1981       end.
     1982   end.
     1983   end procedure.
     1984   procedure xmllib-write-cnt:
     1985   define input parameter v-fillin-handle    as handle       no-undo.
     1986   define input parameter v-fillin-string    as character    no-undo.
     1987   do
     1988   on error undo, return error
     1989   :
     1990       if valid-handle( v-fillin-handle )
     1991       then do:
     1992           assign
     1993               v-fillin-handle :SCREEN-value = v-fillin-string
     1994           .
     1995       end.
     1996   end.
     1997   end procedure.
     1998   procedure xmllib-write-header:
     1999   define input parameter p-first-file     as logical      no-undo.
     2000   define input parameter p-xml-file-name  as character    no-undo.
     2001   define input parameter p-list-file-name as character    no-undo.
     2002   define input parameter p-file-number    as integer      no-undo.
     2003   define input parameter p-have-prev      as logical      no-undo.
     2004   define input parameter p-prev-filename  as character    no-undo.
     2005   define input parameter p-parameter-list as character    no-undo.
     2006       define variable v-counter    as integer        no-undo.
     2007   do
     2008   on error undo, return error
     2009   :
     2010       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     2011       put stream stmXMLOut unformatted
     2012           "<?xml version='1.0' encoding='windows-1251'?>"
     2013       .
     2014       run xmllib-tag-open( input 0, input "root"          , input "":U ).
     2015       run xmllib-tag-open( input 0, input "THheader"        , input "":U ).
     2016       run xmllib-tag-put( input 1 , input "THfileName"      , input p-xml-file-name + "xml":U  , input 0 ).
     2017       run xmllib-tag-put( input 1 , input "THfileNumber"    , input string( p-file-number     ), input 0 ).
     2018       run xmllib-tag-put( input 1 , input "THhavePrev"      , input string( p-have-prev       ), input 3 ).
     2019       run xmllib-tag-put( input 1 , input "THprevFileName"  , input p-prev-filename            , input 0 ).
     2020       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     2021       :
     2022           run xmllib-tag-put(
     2023                 input 1
     2024               , input entry( 2 * v-counter, p-parameter-list )
     2025               , input entry( 2 * v-counter + 1, p-parameter-list )
     2026               , input 0
     2027           ).
     2028       end.
     2029       run xmllib-tag-close( input 0, input "THheader" ).
     2030       output stream stmXMLOut close.
     2031       if p-list-file-name <> "":U
     2032       then do:
     2033           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     2034           if p-first-file = yes
     2035           then do:
     2036               put stream stmXMLOut unformatted
     2037                   "<?xml version='1.0' encoding='windows-1251'?>"
     2038               .
     2039               run xmllib-tag-open( input 0, input "OpenXML", input "" ).
     2040           end.
     2041           run xmllib-tag-open( input 1, input "THfile", input "" ).
     2042           run xmllib-tag-put( input 2, input "THfileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     2043           run xmllib-tag-put( input 2, input "THfileNumber"     , input string( p-file-number     ), input 0 ).
     2044           run xmllib-tag-put( input 2, input "THhavePrev"       , input string( p-have-prev       ), input 3 ).
     2045           run xmllib-tag-put( input 2, input "THprevFileName"   , input p-prev-filename            , input 0 ).
     2046           do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     2047           :
     2048               run xmllib-tag-put(
     2049                   input 2
     2050                   , input entry( 2 * v-counter, p-parameter-list )
     2051                   , input entry( 2 * v-counter + 1, p-parameter-list )
     2052                   , input 0
     2053               ).
     2054           end.
     2055           run xmllib-tag-close( input 1, input "THfile" ).
     2056           output stream stmXMLOut close.
     2057       end.
     2058   end.
     2059   end procedure.
     2060   procedure xmllib-write-footer:
     2061   define input parameter p-last-file      as logical      no-undo.
     2062   define input parameter p-xml-file-name  as character    no-undo.
     2063   define input parameter p-list-file-name as character    no-undo.
     2064   define input parameter p-have-next      as logical      no-undo.
     2065   define input parameter p-next-file-name as character    no-undo.
     2066       define variable v-error-num     as integer           no-undo.
     2067   do
     2068   on error undo, return error
     2069   :
     2070       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     2071       if p-have-next = yes
     2072       then do:
     2073           run xmllib-tag-open( input 0, input "footer", "" ).
     2074           run xmllib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     2075           run xmllib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     2076           run xmllib-tag-close( input 0, input "footer" ).
     2077       end.
     2078       run xmllib-tag-close( input 0, input "root" ).
     2079       output stream stmXMLOut close.
     2080       run bge/os_copy.p (
     2081             input "M"
     2082           , input p-xml-file-name + "tmp"
     2083           , input p-xml-file-name + "xml"
     2084           , output v-error-num
     2085       ).
     2086       if p-last-file = yes
     2087       and p-list-file-name <> "":U
     2088       then do:
     2089           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     2090               run xmllib-tag-close( input 0, input "OpenXML" ).
     2091           output stream stmXMLOut close.
     2092           run bge/os_copy.p (
     2093                 input "M"
     2094               , input p-list-file-name + "tmp"
     2095               , input p-list-file-name + "xml":U
     2096               , output v-error-num
     2097           ).
     2098       end.
     2099   end.
     2100   end procedure.
     2101   procedure xmllib-filename :
     2102   define input parameter p-subdir             as character        no-undo.
     2103   define input parameter p-prefix             as character    no-undo.
     2104   define output parameter p-xml-file-name     as character    no-undo.
     2105   define output parameter p-log-file-name     as character    no-undo.
     2106   define output parameter p-list-file-name    as character    no-undo.
     2107       define variable v-home-dir  as character    no-undo.
     2108       define variable v-error-num as integer      no-undo.
     2109   do
     2110   on error undo, return error
     2111   :
     2112       get-key-value section "OXML" key "oxml-dir" value v-home-dir.
     2113       if v-home-dir = ?
     2114       then do:
     2115           message
     2116             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     2117             skip "Нет параметра oxml-dir в секции [OXML]."
     2118             skip(1)
     2119             skip "Обратитесь к администратору."
     2120           view-as alert-box error.
     2121           undo, return error .
     2122       end.
     2123       if p-subdir <> "":U
     2124       then do:
     2125           assign
     2126               v-home-dir = substitute( "&1/out/&2", v-home-dir, p-subdir )
     2127           .
     2128       end.
     2129       run gbl/dir-cre.p (
     2130           input v-home-dir
     2131       ) no-error.
     2132       if error-status :error
     2133       then do:
     2134           message
     2135             skip "Неверно задан каталог экспорта в ini-файле."
     2136             skip "Не удаётся создать каталог, указанный параметром"
     2137             skip "oxml-dir в секции [OXML]."
     2138             skip(1)
     2139             skip "Обратитесь к администратору."
     2140           view-as alert-box error.
     2141           undo, return error .
     2142       end.
     2143       run bge/genfname.p (
     2144             input v-home-dir
     2145           , input p-prefix
     2146           , input ""
     2147           , input "xml"
     2148           , input "tmp"
     2149           , output p-xml-file-name
     2150       ).
     2151       assign
     2152           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     2153           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     2154           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     2155       .
     2156   end.
     2157   end procedure.
     2158   procedure xmllib-check-file-size :
     2159   define input parameter p-out-filename   as character    no-undo.
     2160   define output parameter p-is-big        as logical      no-undo.
     2161       define variable v-current-position    as integer        no-undo.
     2162   do
     2163   on error undo, return error
     2164   :
     2165       assign
     2166           v-current-position = seek( stmXMLOut )
     2167       .
     2168       if v-current-position / 1024 / 1024  >= 100
     2169       then do:
     2170           assign
     2171               p-is-big = yes
     2172           .
     2173       end.
     2174   end.
     2175   end procedure.
     2176   procedure xmllib-parse-file :
     2177   define input parameter p-full-filename      as character        no-undo.
     2178       define variable v-num-dirs              as integer      no-undo .
     2179       define variable v-str                   as character    no-undo .
     2180       define variable v-str-count             as int64        no-undo .
     2181   do
     2182   on error undo, return error
     2183   :
     2184       assign
     2185           v-num-dirs              = num-entries( p-full-filename,"\/":U )
     2186           v-xmllib-error-status   = no
     2187       .
     2188       if v-num-dirs > 1
     2189       then do:
     2190           assign
     2191               v-xmllib-filename = entry( v-num-dirs, p-full-filename, "\/":U )
     2192               v-xmllib-dirname  = substring( p-full-filename, 1, length( p-full-filename ) - length( v-xmllib-filename ) - 1 )
     2193           .
     2194       end.
     2195       else do:
     2196           assign
     2197               v-xmllib-filename = p-full-filename
     2198               v-xmllib-dirname  = "":U
     2199           .
     2200       end.
     2201       if valid-handle(v-xmllib-prg-bar-handle)
     2202       then do:
     2203   if session :set-wait-state( "compiler" ) then.
     2204         input stream strXMLIn from value(p-full-filename) .
     2205         repeat
     2206         :
     2207           import stream strXMLIn unformatted v-str no-error .
     2208           assign
     2209             v-str-count = v-str-count + 1
     2210           .
     2211         end.
     2212         input stream strXMLIn close .
     2213   if session :set-wait-state( "" ) then.
     2214         run prg-bar_init-cb-handle in this-procedure ( input v-xmllib-prg-bar-handle ) .
     2215         run prg-bar_new in this-procedure ( input 1 , input v-str-count) .
     2216         run prg-bar_show in this-procedure .
     2217       end.
     2218       create sax-reader v-xmllib-sax-reader-handle.
     2219       v-xmllib-sax-reader-handle :set-input-source( "FILE":U, p-full-filename ).
     2220       v-xmllib-sax-reader-handle :sax-parse( ) no-error.
     2221       if error-status :error
     2222       then do:
     2223           run xmllib-parse-error in this-procedure ( input substitute("&1 &2 &3&4Ошибка обработки XML файла.&4&5&4&5&4&7&4&8"
     2224                                                                       ,vss-workfile
     2225                                                                       ,vss-revision
     2226                                                                       ,vss-description
     2227                                                                       ,chr(10)
     2228                                                                       ,return-value
     2229                                                                       ,trim(error-status :get-message(1))
     2230                                                                       ,trim(error-status :get-message(2))
     2231                                                                       ,trim(error-status :get-message(3)))
     2232                                                     ).
     2233           undo, return error .
     2234       end.
     2235       if v-xmllib-error-status <> no
     2236       then do:
     2237           run xmllib-parse-error in this-procedure (
     2238               input "*** При обработке XML файла были ошибки."
     2239           ).
     2240           delete object v-xmllib-sax-reader-handle.
     2241       end.
     2242       delete object v-xmllib-sax-reader-handle.
     2243       if valid-handle(v-xmllib-prg-bar-handle)
     2244       then do:
     2245         run prg-bar_delete in this-procedure .
     2246       end.
     2247   end.
     2248   end procedure.
     2249   procedure xmllib-parse-progressive :
     2250   define input parameter p-full-filename      as character no-undo .
     2251   define input parameter p-pack-data          as memptr no-undo .
     2252   define input parameter p-parse-first        as logical no-undo .
     2253   define input parameter p-first-err          as logical no-undo .
     2254   define output parameter p-parse-status as integer no-undo .
     2255   define variable v-num-dirs              as integer no-undo .
     2256   define variable glog                    as logical no-undo .
     2257   define variable v-pack-size             as int64 no-undo .
     2258   do
     2259   on error undo, return error
     2260   :
     2261     if p-parse-first then do:
     2262       if valid-handle(v-xmllib-sax-reader-handle)
     2263       then do:
     2264       end.
     2265       assign
     2266           v-num-dirs              = num-entries( p-full-filename,"\/":U )
     2267           v-xmllib-error-status   = no
     2268       .
     2269       if v-num-dirs > 1
     2270       then do:
     2271           assign
     2272               v-xmllib-filename = entry( v-num-dirs, p-full-filename, "\/":U )
     2273               v-xmllib-dirname  = substring( p-full-filename, 1, length( p-full-filename ) - length( v-xmllib-filename ) - 1 )
     2274           .
     2275       end.
     2276       else do:
     2277           assign
     2278               v-xmllib-filename = p-full-filename
     2279               v-xmllib-dirname  = "":U
     2280           .
     2281       end.
     2282       create sax-reader v-xmllib-sax-reader-handle.
     2283       v-pack-size = get-size (p-pack-data) .
     2284       if v-pack-size > 0 then
     2285         glog = v-xmllib-sax-reader-handle :set-input-source( "MEMPTR":U, p-pack-data ) no-error.
     2286       else
     2287         glog = v-xmllib-sax-reader-handle :set-input-source( "FILE":U, p-full-filename ) no-error.
     2288       if error-status :error
     2289       or not glog
     2290       then do:
     2291         delete object v-xmllib-sax-reader-handle.
     2292         run xmllib-parse-error in this-procedure ( input substitute("&1 &2 &3&4Ошибка обработки XML файла.&4&5&4&5&4&7&4&8"
     2293                                                                     ,vss-workfile
     2294                                                                     ,vss-revision
     2295                                                                     ,vss-description
     2296                                                                     ,chr(10)
     2297                                                                     ,return-value
     2298                                                                     ,trim(error-status :get-message(1))
     2299                                                                     ,trim(error-status :get-message(2))
     2300                                                                     ,trim(error-status :get-message(3)) )
     2301                                                   ).
     2302         undo, return error .
     2303       end.
     2304       v-xmllib-sax-reader-handle :sax-parse-first( ) no-error.
     2305     end.
     2306     else do:
     2307       v-xmllib-sax-reader-handle :sax-parse-next( ) no-error.
     2308     end.
     2309     if error-status :error
     2310     then do:
     2311       delete object v-xmllib-sax-reader-handle.
     2312       run xmllib-parse-error in this-procedure ( input substitute("&1 &2 &3&4Ошибка обработки XML файла.&4&5&4&5&4&7&4&8"
     2313                                                                   ,vss-workfile
     2314                                                                   ,vss-revision
     2315                                                                   ,vss-description
     2316                                                                   ,chr(10)
     2317                                                                   ,return-value
     2318                                                                   ,trim(error-status :get-message(1))
     2319                                                                   ,trim(error-status :get-message(2))
     2320                                                                   ,trim(error-status :get-message(3)) )
     2321                                                 ).
     2322       undo, return error .
     2323     end.
     2324     if v-xmllib-error-status <> no
     2325     then do:
     2326       run xmllib-parse-error in this-procedure (
     2327           input "*** При обработке XML файла были ошибки."
     2328       ).
     2329       if p-first-err then do:
     2330         delete object v-xmllib-sax-reader-handle.
     2331       end.
     2332       else do:
     2333         v-xmllib-error-status = no.
     2334       end.
     2335     end.
     2336     if v-xmllib-sax-reader-handle:parse-status = SAX-COMPLETE  then do:
     2337       p-parse-status = SAX-COMPLETE.
     2338       delete object v-xmllib-sax-reader-handle.
     2339       return '':U.
     2340     end.
     2341     else do:
     2342       p-parse-status = v-xmllib-sax-reader-handle:parse-status.
     2343       return '':U.
     2344     end.
     2345   end.
     2346   end procedure.
     2347   procedure StartElement :
     2348   define input parameter p-name-space     as character        no-undo.
     2349   define input parameter p-local-name     as character        no-undo.
     2350   define input parameter p-q-name         as character        no-undo.
     2351   define input parameter p-attributes     as handle           no-undo.
     2352       define buffer buf_rec             for temp_xmllib_rec.
     2353       define buffer buf_rec-fld         for temp_xmllib_rec-fld.
     2354       define buffer buf_rec-list        for temp_xmllib_rec-list.
     2355       define buffer buf_rec-fld-list    for temp_xmllib_rec-fld-list.
     2356   do
     2357   for buf_rec
     2358     , buf_rec-fld
     2359     , buf_rec-list
     2360     , buf_rec-fld-list
     2361   on error undo, return error
     2362   :
     2363       if valid-handle(v-xmllib-prg-bar-handle)
     2364       then do:
     2365         run prg-bar_stepto in this-procedure ( input SELF:LOCATOR-LINE-NUMBER ) .
     2366       end.
     2367       find first buf_rec-list
     2368            where buf_rec-list.recName = p-q-name
     2369       no-error.
     2370       if available buf_rec-list
     2371       then do:
     2372           if buf_rec-list.closed = no
     2373           then do:
     2374               find first buf_rec-fld-list
     2375                    where buf_rec-fld-list.recName = buf_rec-list.recName
     2376                      and buf_rec-fld-list.fldName = p-q-name
     2377               no-error.
     2378               if available buf_rec-fld-list
     2379               and buf_rec-list.recName = buf_rec-fld-list.recName
     2380               then do:
     2381                   if buf_rec-fld-list.closed = no
     2382                   then do:
     2383                       run xmllib-parse-error in this-procedure (
     2384                           input substitute( "Ошибка 1 открытия поля <&1> записи <&2>: Поле с этим именем уже открыто на строке &3."
     2385                                           , p-q-name
     2386                                           , p-q-name
     2387                                           , buf_rec-fld-list.fldOpenLine
     2388                                           )
     2389                       ).
     2390                   end.
     2391                   else do:
     2392                       run xmllib-parse-rec-fld-open in this-procedure (
     2393                             input buf_rec-list.recName
     2394                           , input buf_rec-list.recLevel
     2395                           , input buf_rec-fld-list.fldName
     2396                       ).
     2397                       assign
     2398                           buf_rec-fld-list.closed         = no
     2399                           buf_rec-fld-list.fldOpenLine    = v-xmllib-sax-reader-handle :locator-line-number
     2400                           buf_rec-fld-list.fldCloseLine   = 0
     2401                       .
     2402                   end.
     2403               end.
     2404               else do:
     2405                   assign
     2406                       buf_rec-list.recLevel = buf_rec-list.recLevel + 1
     2407                   .
     2408                   run xmllib-parse-rec-open in this-procedure (
     2409                         input buf_rec-list.recName
     2410                       , input buf_rec-list.recLevel
     2411                   ).
     2412                   assign
     2413                       buf_rec-list.closed         = no
     2414                       buf_rec-list.recOpenLine    = v-xmllib-sax-reader-handle :locator-line-number
     2415                       buf_rec-list.recCloseLine   = 0
     2416                   .
     2417               end.
     2418           end.
     2419           else do:
     2420               run xmllib-parse-rec-open in this-procedure (
     2421                     input buf_rec-list.recName
     2422                   , input buf_rec-list.recLevel
     2423               ).
     2424               assign
     2425                   buf_rec-list.closed         = no
     2426                   buf_rec-list.recOpenLine    = v-xmllib-sax-reader-handle :locator-line-number
     2427                   buf_rec-list.recCloseLine   = 0
     2428               .
     2429           end.
     2430       end.
     2431       else do:
     2432           open-record:
     2433           for each buf_rec-fld-list
     2434              where buf_rec-fld-list.fldName = p-q-name
     2435           :
     2436               find first buf_rec-list
     2437                    where buf_rec-list.recName = buf_rec-fld-list.recName
     2438                      and buf_rec-list.closed  = no
     2439               no-error.
     2440               if available buf_rec-list
     2441               then do:
     2442                   run xmllib-parse-rec-fld-open in this-procedure (
     2443                         input buf_rec-list.recName
     2444                       , input buf_rec-list.recLevel
     2445                       , input buf_rec-fld-list.fldName
     2446                   ).
     2447                   assign
     2448                       buf_rec-fld-list.recLevel       = buf_rec-list.recLevel
     2449                       buf_rec-fld-list.closed         = no
     2450                       buf_rec-fld-list.fldOpenLine    = v-xmllib-sax-reader-handle :locator-line-number
     2451                       buf_rec-fld-list.fldCloseLine   = 0
     2452                   .
     2453                   leave open-record.
     2454               end.
     2455           end.
     2456       end.
     2457   end.
     2458   end procedure.
     2459   procedure Characters :
     2460   define input parameter p-char-data  as memptr.
     2461   define input parameter p-numchars   as integer.
     2462       define variable v-data-string    as character    no-undo.
     2463       define variable v-cp-utf8           as integer no-undo init 65001 .
     2464       define variable v-cp-windows1251    as integer no-undo init 1251 .
     2465       define buffer buf_xmllib_rec             for temp_xmllib_rec.
     2466       define buffer buf_xmllib_rec-fld         for temp_xmllib_rec-fld.
     2467       define buffer buf_xmllib_rec-list        for temp_xmllib_rec-list.
     2468       define buffer buf_xmllib_rec-fld-list    for temp_xmllib_rec-fld-list.
     2469   do
     2470   for buf_xmllib_rec
     2471     , buf_xmllib_rec-fld
     2472     , buf_xmllib_rec-list
     2473     , buf_xmllib_rec-fld-list
     2474   on error undo, return error
     2475   :
     2476       find first buf_xmllib_rec-list
     2477            where buf_xmllib_rec-list.closed = no
     2478       no-error.
     2479       if available buf_xmllib_rec-list
     2480       then do:
     2481           find first buf_xmllib_rec-fld-list
     2482                where buf_xmllib_rec-fld-list.closed = no
     2483           no-error.
     2484           if available buf_xmllib_rec-fld-list
     2485           and buf_xmllib_rec-fld-list.recName  = buf_xmllib_rec-list.recName
     2486           and buf_xmllib_rec-fld-list.recLevel = buf_xmllib_rec-list.recLevel
     2487           then do:
     2488               find last buf_xmllib_rec
     2489                   where buf_xmllib_rec.recName  = buf_xmllib_rec-list.recName
     2490                     and buf_xmllib_rec.recLevel = buf_xmllib_rec-list.recLevel
     2491                     and buf_xmllib_rec.closed   = no
     2492               use-index nm
     2493               no-error.
     2494               if available buf_xmllib_rec
     2495               then do:
     2496                   find last buf_xmllib_rec-fld
     2497                       where buf_xmllib_rec-fld.rec-key = buf_xmllib_rec.rec-key
     2498                         and buf_xmllib_rec-fld.fldName = buf_xmllib_rec-fld-list.fldName
     2499                         and buf_xmllib_rec-fld.closed = no
     2500                   use-index nm
     2501                   no-error.
     2502                   if available buf_xmllib_rec-fld
     2503                   then do:
     2504                       assign
     2505                           v-data-string = get-string( p-char-data, 1, get-size( p-char-data ) )
     2506                       .
     2507                       if v-xmllib-codepage-convert = yes
     2508                       then do:
     2509                         assign
     2510                             v-data-string = codepage-convert( v-data-string , v-xmllib-codepage-target , v-xmllib-codepage-source )
     2511                         .
     2512                       end.
     2513                       run xmlchar-decode in this-procedure (
     2514                           input v-data-string
     2515                           , output v-data-string
     2516                       ).
     2517                       assign
     2518                           buf_xmllib_rec-fld.fldValue = trim( substitute( "&1&2", buf_xmllib_rec-fld.fldValue, v-data-string ) )
     2519                       .
     2520                   end.
     2521               end.
     2522           end.
     2523       end.
     2524   end.
     2525   end procedure.
     2526   procedure EndElement :
     2527   define input parameter p-name-space     as character        no-undo.
     2528   define input parameter p-local-name     as character        no-undo.
     2529   define input parameter p-q-name         as character        no-undo.
     2530       define buffer buf_rec             for temp_xmllib_rec.
     2531       define buffer buf_rec-fld         for temp_xmllib_rec-fld.
     2532       define buffer buf_rec-list        for temp_xmllib_rec-list.
     2533       define buffer buf_rec-fld-list    for temp_xmllib_rec-fld-list.
     2534   do
     2535   for buf_rec
     2536     , buf_rec-fld
     2537     , buf_rec-list
     2538     , buf_rec-fld-list
     2539   on error undo, return error
     2540   :
     2541       find last buf_rec-list
     2542           where buf_rec-list.recName = p-q-name
     2543       use-index pi
     2544       no-error.
     2545       if available buf_rec-list
     2546       then do:
     2547           if buf_rec-list.closed = yes
     2548           then do:
     2549               run xmllib-parse-error in this-procedure (
     2550                   input substitute( "Ошибка закрытия записи или поля <&1>: Нет метки открытой записи."
     2551                                   , p-q-name
     2552                                   )
     2553               ).
     2554           end.
     2555           else do:
     2556               find last buf_rec
     2557                   where buf_rec.recName  = buf_rec-list.recName
     2558                     and buf_rec.recLevel = buf_rec-list.recLevel
     2559                     and buf_rec.closed   = no
     2560               use-index nm
     2561               no-error.
     2562               if not available buf_rec
     2563               then do:
     2564                   run xmllib-parse-error in this-procedure (
     2565                       input substitute( "Ошибка закрытия записи или поля <&1> уровня &2: Нет открытой записи."
     2566                                       , p-q-name
     2567                                       , buf_rec-list.recLevel
     2568                                       )
     2569                   ).
     2570               end.
     2571               else do:
     2572                   find first buf_rec-fld-list
     2573                        where buf_rec-fld-list.recName  = buf_rec.recName
     2574                          and buf_rec-fld-list.recLevel = buf_rec.recLevel
     2575                          and buf_rec-fld-list.fldName  = p-q-name
     2576                          and buf_rec-fld-list.closed   = no
     2577                   no-error.
     2578                   if not available buf_rec-fld-list
     2579                   then do:
     2580                       if buf_rec.recName <> p-q-name
     2581                       then do:
     2582                           run xmllib-parse-error in this-procedure (
     2583                               input substitute( "Ошибка закрытия записи <&1>: Имя открытой записи не совпадает с именем метки."
     2584                                               , buf_rec.recName
     2585                                               )
     2586                           ).
     2587                       end.
     2588                       else do:
     2589                           assign
     2590                               buf_rec.closed              = yes
     2591                               buf_rec.recCloseLine        = v-xmllib-sax-reader-handle :locator-line-number
     2592                               buf_rec-list.recCloseLine   = v-xmllib-sax-reader-handle :locator-line-number
     2593                           .
     2594                           if buf_rec-list.recLevel > 0
     2595                           then do:
     2596                               assign
     2597                                   buf_rec-list.recLevel = buf_rec-list.recLevel - 1
     2598                               .
     2599                               for each buf_rec-fld-list
     2600                                  where buf_rec-fld-list.recName = buf_rec-list.recName
     2601                               :
     2602                                   assign
     2603                                       buf_rec-fld-list.recLevel = buf_rec-fld-list.recLevel - 1
     2604                                   .
     2605                               end.
     2606                           end.
     2607                           else do:
     2608                               assign
     2609                                   buf_rec-list.closed         = yes
     2610                               .
     2611                           end.
     2612                       end.
     2613                   end.
     2614                   else do:
     2615                       find last buf_rec-fld
     2616                           where buf_rec-fld.rec-key = buf_rec.rec-key
     2617                             and buf_rec-fld.fldName = buf_rec-fld-list.fldName
     2618                             and buf_rec-fld.closed  = no
     2619                       use-index nm
     2620                       no-error.
     2621                       if not available buf_rec-fld
     2622                       then do:
     2623                           run xmllib-parse-error in this-procedure (
     2624                               input substitute( "Ошибка 2 закрытия поля <&1>: Не найдено открытое поле с этим именем в записи <&2> уровня &3."
     2625                                               , buf_rec-fld-list.fldName
     2626                                               , buf_rec.recName
     2627                                               , buf_rec.recLevel
     2628                                               )
     2629                           ).
     2630                       end.
     2631                       else do:
     2632                           assign
     2633                               buf_rec-fld.closed              = yes
     2634                               buf_rec-fld-list.closed         = yes
     2635                               buf_rec-fld.fldCloseLine        = v-xmllib-sax-reader-handle :locator-line-number
     2636                               buf_rec-fld-list.fldCloseLine   = v-xmllib-sax-reader-handle :locator-line-number
     2637                           .
     2638                       end.
     2639                   end.
     2640               end.
     2641           end.
     2642       end.
     2643       else do:
     2644           close-field-rec:
     2645           for each buf_rec-fld-list
     2646              where buf_rec-fld-list.fldName = p-q-name
     2647           :
     2648               find first buf_rec-list
     2649                    where buf_rec-list.recName  = buf_rec-fld-list.recName
     2650                      and buf_rec-list.recLevel = buf_rec-fld-list.recLevel
     2651                      and buf_rec-list.closed   = no
     2652               no-error.
     2653               if available buf_rec-list
     2654               then do:
     2655                   find last buf_rec
     2656                       where buf_rec.recName  = buf_rec-list.recName
     2657                         and buf_rec.recLevel = buf_rec-list.recLevel
     2658                         and buf_rec.closed   = no
     2659                   use-index nm
     2660                   no-error.
     2661                   if not available buf_rec
     2662                   then do:
     2663                       run xmllib-parse-error in this-procedure (
     2664                           input substitute( "Ошибка закрытия поля <&1>: Нет открытой записи."
     2665                                           , p-q-name
     2666                                           )
     2667                       ).
     2668                   end.
     2669                   else do:
     2670                       find last buf_rec-fld
     2671                           where buf_rec-fld.rec-key = buf_rec.rec-key
     2672                             and buf_rec-fld.fldName = buf_rec-fld-list.fldName
     2673                             and buf_rec-fld.closed  = no
     2674                       use-index nm
     2675                       no-error.
     2676                       if not available buf_rec-fld
     2677                       then do:
     2678                           run xmllib-parse-error in this-procedure (
     2679                               input substitute( "Ошибка 1 закрытия поля <&1>: Не найдено открытое поле с этим именем в записи <&2> уровня &3."
     2680                                               , buf_rec-fld-list.fldName
     2681                                               , buf_rec.recName
     2682                                               , buf_rec.recLevel
     2683                                               )
     2684                           ).
     2685                       end.
     2686                       else do:
     2687                           assign
     2688                               buf_rec-fld.closed              = yes
     2689                               buf_rec-fld-list.closed         = yes
     2690                               buf_rec-fld.fldCloseLine        = v-xmllib-sax-reader-handle :locator-line-number
     2691                               buf_rec-fld-list.fldCloseLine   = v-xmllib-sax-reader-handle :locator-line-number
     2692                           .
     2693                       end.
     2694                   end.
     2695                   leave close-field-rec.
     2696               end.
     2697           end.
     2698       end.
     2699   end.
     2700   end procedure.
     2701   procedure Error :
     2702   define input parameter p-error-message     as character        no-undo.
     2703   do
     2704   on error undo, return error
     2705   :
     2706       run xmllib-parse-error in this-procedure (
     2707           input p-error-message
     2708       ).
     2709       assign
     2710           v-xmllib-error-status = yes
     2711       .
     2712   end.
     2713   end procedure.
     2714   procedure xmllib-parse-error :
     2715   define input parameter p-err-message    as character        no-undo.
     2716   do
     2717   on error undo, return error
     2718   :
     2719       if valid-handle(v-xmllib-log-handle) then do:
     2720         run value(v-xmllib-log-proc-name) in  v-xmllib-log-handle
     2721                  (input substitute("&1Файл:    &2 &3&1Строка &4&1&5"
     2722                                    ,chr(10)
     2723                                    ,v-xmllib-dirname
     2724                                    ,v-xmllib-filename
     2725                                    ,(if valid-handle(v-xmllib-sax-reader-handle)
     2726                                      then v-xmllib-sax-reader-handle :locator-line-number
     2727                                      else ?)
     2728                                    ,p-err-message)).
     2729       end.
     2730       else do:
     2731         if v-xmllib-log-filename = "":U
     2732         then do:
     2733             message
     2734                     vss-workfile vss-revision vss-description
     2735                 skip "Файл:   " v-xmllib-dirname v-xmllib-filename
     2736                 skip "Строка: " (if valid-handle(v-xmllib-sax-reader-handle)
     2737                                  then v-xmllib-sax-reader-handle :locator-line-number
     2738                                  else ?)
     2739                 skip(1)
     2740                 skip p-err-message
     2741                 skip return-value
     2742                 skip trim( error-status :get-message( 1 ) )
     2743                     trim( error-status :get-message( 2 ) )
     2744                     trim( error-status :get-message( 3 ) )
     2745             view-as alert-box error.
     2746             undo, return error.
     2747         end.
     2748         else do:
     2749           output to value( v-xmllib-log-filename ).
     2750           put unformatted
     2751               substitute( "&1&2", chr(10), p-err-message )
     2752           .
     2753           output close.
     2754         end.
     2755       end.
     2756   end.
     2757   end procedure.
     2758   procedure xmllib-set-log-filename :
     2759   define input parameter p-log-filename   as character        no-undo.
     2760   do
     2761   on error undo, return error
     2762   :
     2763       run gbl/fileapnd.p (
     2764             input p-log-filename
     2765           , input "":U
     2766           , input 10
     2767       ) no-error.
     2768       if error-status :error
     2769       then do:
     2770           assign
     2771               v-xmllib-log-filename = "":U
     2772           .
     2773       end.
     2774       else do:
     2775           assign
     2776               v-xmllib-log-filename = p-log-filename
     2777           .
     2778       end.
     2779   end.
     2780   end procedure.
     2781   procedure xmllib-set-log-handle :
     2782   define input parameter p-log-handle    as handle        no-undo.
     2783   define input parameter p-log-proc-name as character no-undo .
     2784   do
     2785   on error undo, return error
     2786   :
     2787       if valid-handle(p-log-handle)
     2788       and lookup(p-log-proc-name, p-log-handle:internal-entries) > 0
     2789       then do:
     2790         assign
     2791         v-xmllib-log-handle    = p-log-handle
     2792         v-xmllib-log-proc-name = p-log-proc-name
     2793         .
     2794       end.
     2795       else do:
     2796         assign
     2797         v-xmllib-log-handle    = ?
     2798         v-xmllib-log-proc-name = '':U
     2799         .
     2800       end.
     2801   end.
     2802   end procedure.
     2803   procedure xmllib-set-prg-bar-handle :
     2804   define input parameter p-handle    as handle        no-undo.
     2805   do
     2806   on error undo, return error
     2807   :
     2808       if valid-handle(p-handle)
     2809       then do:
     2810         assign
     2811           v-xmllib-prg-bar-handle = p-handle
     2812         .
     2813       end.
     2814       else do:
     2815         assign
     2816           v-xmllib-prg-bar-handle = ?
     2817         .
     2818       end.
     2819   end.
     2820   end procedure.
     2821   procedure xmllib-set-codepage-convert :
     2822     define input  parameter p-codepage-source as character no-undo .
     2823     define input  parameter p-codepage-target as character no-undo .
     2824   do
     2825   on error undo, return error return-value
     2826   :
     2827     if ( p-codepage-source <> "" and p-codepage-target <> "" )
     2828     then do:
     2829       assign
     2830         v-xmllib-codepage-convert = yes
     2831         v-xmllib-codepage-source  = p-codepage-source
     2832         v-xmllib-codepage-target  = p-codepage-target
     2833       .
     2834     end.
     2835     else do:
     2836       assign
     2837         v-xmllib-codepage-convert = no
     2838         v-xmllib-codepage-source  = ""
     2839         v-xmllib-codepage-target  = ""
     2840       .
     2841     end.
     2842   end.
     2843   end procedure.
     2844   procedure xmllib-parse-rec-open :
     2845   define input parameter p-rec-name   as character        no-undo.
     2846   define input parameter p-rec-level  as integer          no-undo.
     2847       define buffer buf_temp_xmllib_rec       for temp_xmllib_rec.
     2848   do
     2849   for buf_temp_xmllib_rec
     2850   on error undo, return error
     2851   :
     2852        find first buf_temp_xmllib_rec
     2853            where buf_temp_xmllib_rec.recName = p-rec-name
     2854              and buf_temp_xmllib_rec.recLevel = p-rec-level
     2855              and buf_temp_xmllib_rec.closed  = no
     2856       use-index nm
     2857       no-error.
     2858       if available buf_temp_xmllib_rec
     2859       then do:
     2860           run xmllib-parse-error in this-procedure (
     2861               input substitute( "Ошибка 2 открытия записи <&1>: Запись с этим именем и уровнем &2 уже открыта на строке &3."
     2862                               , p-rec-name
     2863                               , p-rec-level
     2864                               , buf_temp_xmllib_rec.recOpenLine
     2865                               )
     2866           ).
     2867       end.
     2868       else do:
     2869           assign
     2870               v-xmllib-rec-key    = v-xmllib-rec-key + 1
     2871           .
     2872           create buf_temp_xmllib_rec.
     2873           assign
     2874               buf_temp_xmllib_rec.rec-key         = v-xmllib-rec-key
     2875               buf_temp_xmllib_rec.recOpenLine     = v-xmllib-sax-reader-handle :locator-line-number
     2876               buf_temp_xmllib_rec.recCloseLine    = 0
     2877               buf_temp_xmllib_rec.recName         = p-rec-name
     2878               buf_temp_xmllib_rec.recLevel        = p-rec-level
     2879               buf_temp_xmllib_rec.closed          = no
     2880           .
     2881       end.
     2882   end.
     2883   end procedure.
     2884   procedure xmllib-parse-rec-fld-open :
     2885   define input parameter p-rec-name   as character        no-undo.
     2886   define input parameter p-rec-level  as integer          no-undo.
     2887   define input parameter p-fld-name   as character        no-undo.
     2888       define buffer buf_temp_xmllib_rec       for temp_xmllib_rec.
     2889       define buffer buf_temp_xmllib_rec-fld   for temp_xmllib_rec-fld.
     2890   do
     2891   for buf_temp_xmllib_rec
     2892     , buf_temp_xmllib_rec-fld
     2893   on error undo, return error substitute( "Ошибка в xmllib-parse-rec-fld-open. &1. &2. &3"
     2894                                           , return-value
     2895                                           , trim( error-status :get-message( 1 ) )
     2896                                           , trim( error-status :get-message( 2 ) ) )
     2897   :
     2898       find last buf_temp_xmllib_rec
     2899           where buf_temp_xmllib_rec.recName   = p-rec-name
     2900             and buf_temp_xmllib_rec.recLevel  = p-rec-level
     2901             and buf_temp_xmllib_rec.closed    = no
     2902       use-index nm
     2903       no-error.
     2904       if not available buf_temp_xmllib_rec
     2905       then do:
     2906           run xmllib-parse-error in this-procedure (
     2907               input substitute( "Ошибка 2 открытия поля <&2> в записи <&1> уровня &3: Нет открытой записи."
     2908                               , p-rec-name
     2909                               , p-fld-name
     2910                               , p-rec-level
     2911                               )
     2912           ).
     2913       end.
     2914       else do:
     2915           find last buf_temp_xmllib_rec-fld
     2916               where buf_temp_xmllib_rec-fld.rec-key  = buf_temp_xmllib_rec.rec-key
     2917                 and buf_temp_xmllib_rec-fld.fldName  = p-fld-name
     2918                 and buf_temp_xmllib_rec-fld.closed   = no
     2919           use-index nm
     2920           no-error.
     2921           if available buf_temp_xmllib_rec-fld
     2922           then do:
     2923               run xmllib-parse-error in this-procedure (
     2924                   input substitute( "Ошибка 3 открытия поля <&2> в записи <&1>: Поле с этим именем уже открыто на строке &3."
     2925                                   , p-rec-name
     2926                                   , p-fld-name
     2927                                   , buf_temp_xmllib_rec-fld.fldOpenLine
     2928                                   )
     2929               ).
     2930           end.
     2931           else do:
     2932               assign
     2933                   v-xmllib-rec-fld-key    = v-xmllib-rec-fld-key + 1
     2934               .
     2935               create buf_temp_xmllib_rec-fld.
     2936               assign
     2937                   buf_temp_xmllib_rec-fld.fld-key         = v-xmllib-rec-fld-key
     2938                   buf_temp_xmllib_rec-fld.rec-key         = buf_temp_xmllib_rec.rec-key
     2939                   buf_temp_xmllib_rec-fld.fldOpenLine     = v-xmllib-sax-reader-handle :locator-line-number
     2940                   buf_temp_xmllib_rec-fld.fldCloseLine    = 0
     2941                   buf_temp_xmllib_rec-fld.fldName         = p-fld-name
     2942                   buf_temp_xmllib_rec-fld.closed          = no
     2943               .
     2944           end.
     2945       end.
     2946   end.
     2947   end procedure.
     2948   // { bge/tmpcxmlh.i } 23/VIII-2018 - уже было вставлено
     2949   define variable vss-include-info15 as character format "X(65)" no-undo
     2950   initial "@(#)$Workfile$ $Revision$".
     2951   procedure xmlchar-test :
