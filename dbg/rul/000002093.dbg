     3164   define buffer buf_ord-chain for ub.ord-chain.
     3165   define buffer buf_ord-doc-rcv for ub.ord-doc-rcv.
     3166   define buffer buf_esys-route for ub.esys-route.
     3167   define buffer buf_edi-status for ub.edi-status.
     3168   define buffer buf_clients for ub.clients.
     3169   _status:
     3170   do transaction
     3171   on error  undo _status, retry _status
     3172   on stop   undo _status, retry _status
     3173   on endkey undo _status, retry _status
     3174   :
     3175     if retry then do:
     3176           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка:&1&2&1&3&1&4", chr(10), error-status:get-message(1) , return-value, v-mess)).                      assign v-view-log = yes.
     3177       assign
     3178       v-view-log = yes.
     3179       undo _status, return error substitute("Ошибка:&1&2&1&3&1&4", chr(10), error-status:get-message(1) , return-value, v-mess).
     3180     end.
     3181     else do:
     3182       run write-log  in p-log-handle (
     3183                                       input 0
     3184                                     , "&DLine").
     3185             run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute(".............Импорт подтверждений из ВС")).                      assign v-view-log = yes.
     3186       find first statusReport.
     3187       num-rec = num-rec + 1.
     3188       v-execute = yes.
     3189       case statusReport.documentType:
     3190           when "ORDERS" then do:
     3191               for each buf_edi-status no-lock where
     3192                       buf_edi-status.tbl-name = 'ord-doc':U
     3193                   and buf_edi-status.doc-code = statusReport.documentNumber
     3194               by buf_edi-status.tbl-name
     3195               by buf_edi-status.doc-code
     3196               by buf_edi-status.date-status
     3197               by buf_edi-status.time-status
     3198               :
     3199                 if buf_edi-status.state = '1':U or buf_edi-status.state = '12':U then do:
     3200                   v-dump-ord-int64 = int64(cr-edist_get-mess-key-value(buf_edi-status.mess-id, 'route':U)).
     3201                   leave.
     3202                 end.
     3203               end.
     3204               if statusReport.state = "fail" then do :
     3205                   find first buf_ord-doc no-lock where
     3206                             buf_ord-doc.doc-code = statusReport.documentNumber no-error.
     3207                   if not available buf_ord-doc then do:
     3208                     v-mess = substitute("Не найден заказ поставщику с номером &1", statusReport.documentNumber).
     3209                     undo _status, retry _status.
     3210                   end.
     3211                   assign
     3212                   v-tbl-name = 'ord-doc':U
     3213                   v-doc-code = buf_ord-doc.doc-code
     3214                   v-trn-code = ''
     3215                   v-ord-int1 = integer('13':U)
     3216                   .
     3217               end.
     3218               else do :
     3219                   case statusReport.stage :
     3220                       when "processing" then do :
     3221                           v-execute = no.
     3222                           find first buf_esys-route no-lock where
     3223                                 buf_esys-route.esr-dump-ord   = v-dump-ord-int64
     3224                             and buf_esys-route.esys-id   = v-esys-id
     3225                             and buf_esys-route.db-num   = 0  no-error.
     3226                             if available buf_esys-route then do:
     3227                               v-edist-mess = ''.
     3228                               v-edist-mess = cr-edist_add-edist-mess( v-edist-mess, 'pack-num':U, string(buf_esys-route.esr-last-pack) + "->").
     3229                               run update-edi-state-light in this-procedure ( input buf_edi-status.tbl-name
     3230                                                                             ,input buf_edi-status.doc-code
     3231                                                                             ,input buf_edi-status.date-status
     3232                                                                             ,input buf_edi-status.time-status
     3233                                                                             ,input buf_edi-status.state
     3234                                                                             ,input buf_edi-status.err-code
     3235                                                                             ,input buf_edi-status.des-err
     3236                                                                             ,input v-edist-mess
     3237                                                                             )
     3238                                                                             .
     3239                               run get-xcnf_create-temp-esys-pck-rcvd in p-cont-handle (
     3240                                                                                         input v-esys-id
     3241                                                                                       ,input buf_esys-route.esr-last-pack
     3242                                                                                       ,input v-crc-pack
     3243                                                                                       ,input yes
     3244                                                                                       ,input 1
     3245                                                                                       ,input 1
     3246                                                                                       ,input today
     3247                                                                                       ,input integer(entry(1, statusReport.v-time, ":")) * 3600 +
     3248                                                                                               integer(entry(2, statusReport.v-time, ":")) * 60
     3249                                                                                       ,input statusReport.v-time
     3250                                                                                       ) .
     3251                               run cur-time in this-procedure ( output v-today, output v-time).
     3252                               run get-xcnf_create-temp-esys-pck-sent in p-cont-handle (
     3253                                                                                         input v-esys-id
     3254                                                                                       ,input integer(v-pack-num-chr)
     3255                                                                                       ,input v-crc-pack
     3256                                                                                       ,input yes
     3257                                                                                       ,input 1
     3258                                                                                       ,input 1
     3259                                                                                       ,input v-today
     3260                                                                                       ,input v-time
     3261                                                                                       ,input string(v-time, "HH:MM:SS")
     3262                                                                                       ) .
     3263                             end.
     3264                       end.
     3265                       when "delivery" then do :
     3266                           find first buf_ord-doc no-lock where
     3267                                     buf_ord-doc.doc-code = statusReport.documentNumber no-error.
     3268                           if not available buf_ord-doc then do:
     3269                             v-mess = substitute("Не найден заказ поставщику с номером &1", statusReport.documentNumber).
     3270                             undo _status, retry _status.
     3271                           end.
     3272                           assign
     3273                           v-tbl-name = 'ord-doc':U
     3274                           v-doc-code = buf_ord-doc.doc-code
     3275                           v-trn-code = ''
     3276                           v-ord-int1 = integer('12':U)
     3277                           .
     3278                       end.
     3279                       when "read" then do :
     3280                           find first buf_ord-doc no-lock where
     3281                                     buf_ord-doc.doc-code = statusReport.documentNumber no-error.
     3282                           if not available buf_ord-doc then do:
     3283                             v-mess = substitute("Не найден заказ поставщику с номером &1", statusReport.documentNumber).
     3284                             undo _status, retry _status.
     3285                           end.
     3286                           assign
     3287                           v-tbl-name = 'ord-doc':U
     3288                           v-doc-code = buf_ord-doc.doc-code
     3289                           v-trn-code = ''
     3290                           v-ord-int1 = integer('2':U)
     3291                           .
     3292                       end.
     3293                       otherwise do :
     3294                          v-mess = substitute("Получено непредусмотренное подтверждение. stage = &1", statusReport.stage).
     3295                          undo _status, retry _status.
     3296                       end.
     3297                   end case.
     3298               end.
     3299           end.
     3300           when "RECADV" then do:
     3301               for each buf_edi-status no-lock where
     3302                       buf_edi-status.tbl-name = 'trn-doc':U
     3303                   and buf_edi-status.doc-code = statusReport.documentNumber
     3304               by buf_edi-status.tbl-name
     3305               by buf_edi-status.doc-code
     3306               by buf_edi-status.date-status
     3307               by buf_edi-status.time-status
     3308               :
     3309                 if buf_edi-status.state = '9':U then do:
     3310                   v-dump-ord-int64 = int64(cr-edist_get-mess-key-value(buf_edi-status.mess-id, 'route':U)).
     3311                   leave.
     3312                 end.
     3313               end.
     3314               find first buf_trn-doc no-lock where
     3315                          buf_trn-doc.doc-code = statusReport.documentNumber no-error.
     3316               if not available buf_trn-doc then do:
     3317                 v-mess = substitute("Не найдена приходная накладная с номером &1, на которую пришло подтверждение", statusReport.documentNumber).
     3318                 undo _status, retry _status.
     3319               end.
     3320               find first buf_ord-chain   no-lock where
     3321                          buf_ord-chain.rel-doc-code = buf_trn-doc.doc-code
     3322                      and buf_ord-chain.rel-doc-type = "trn"
     3323                      and buf_ord-chain.doc-type = "rcv" no-error .
     3324               if not available buf_ord-chain then do:
     3325                 v-mess = substitute("Не найдена цепочка поставок к заказу для накладной прихода с номером &1", statusReport.documentNumber).
     3326                 undo _status, retry _status.
     3327               end.
     3328               find first buf_ord-doc-rcv no-lock where
     3329                         buf_ord-doc-rcv.rcv-code = buf_ord-chain.doc-code no-error .
     3330               if not available buf_ord-doc-rcv then do:
     3331                 v-mess = substitute("Не найдена поставка для приходной накладной с номером &1", statusReport.documentNumber).
     3332                 undo _status, retry _status.
     3333               end.
     3334               find first buf_ord-doc no-lock where
     3335                         buf_ord-doc.doc-code = buf_ord-doc-rcv.doc-code no-error .
     3336               if not available buf_ord-doc then do:
     3337                 v-mess = substitute("Не найден заказ по которому была приходная накладная с номером &1", statusReport.documentNumber).
     3338                 undo _status, retry _status.
     3339               end.
     3340               assign
     3341               v-tbl-name = 'trn-doc':U
     3342               v-doc-code = buf_trn-doc.doc-code
     3343               v-trn-code = entry(1, buf_ord-doc-rcv.sub-par, chr(4)).
     3344               v-ord-int1 = (if statusReport.state = "ok" then integer('11':U) else integer('13':U))
     3345               .
     3346           end.
     3347           otherwise do:
     3348             v-mess = substitute("Получено непредусмотренное подтверждение на документ типа &1", statusReport.documentType).
     3349             undo _status, retry _status.
     3350           end.
     3351       end case .
     3352       if statusReport.stage <> "processing" then do :
     3353         assign
     3354         v-cli-type = buf_ord-doc.cli-type
     3355         v-cli-code = buf_ord-doc.cli-code
     3356         v-ps = buf_ord-doc.ps
     3357         .
     3358         assign
     3359         glog = status-is-edi ( input yes
     3360                             , input buf_ord-doc.cli-type
     3361                             , input buf_ord-doc.cli-code
     3362                             , input buf_ord-doc.obj-type
     3363                             , input buf_ord-doc.obj-code
     3364                             , output v-dm-edi
     3365                             ) no-error.
     3366         if not glog = yes then do:
     3367           v-mess = substitute("Нет обмена Документами по EDI для поставщика &1&2 и &3&4 в БД &5)"
     3368                             , buf_ord-doc.cli-type
     3369                             , buf_ord-doc.cli-code
     3370                             , buf_ord-doc.obj-type
     3371                             , buf_ord-doc.obj-code
     3372                             , g#db-num).
     3373           undo _status, retry _status.
     3374         end.
     3375         if v-execute then do:
     3376           run edocsord_edi-import in this-procedure (
     3377                                                   buffer buf_ord-doc
     3378                                                 ,input entry(1, buf_ord-doc.cli-out-doc, chr(4))
     3379                                                 ,input v-trn-code
     3380                                                 ,input v-ord-int1
     3381                                                 ,input buf_ord-doc.ship-date
     3382                                                 ,input buf_ord-doc.ps
     3383                                                 ,input v-pack-num-chr
     3384                                                 ,input statusReport.messageId
     3385                                                 ,output v-ps
     3386                                                 ,output v-new-st
     3387                                                 ) no-error.
     3388           if error-status:error then do:
     3389             if return-value <> '' then do:
     3390               v-mess = substitute("Ошибка при изменении статуса заказа при приеме данных:&1&2", chr(10), return-value ).
     3391               undo _status, retry _status.
     3392             end.
     3393           end.
     3394         end.
     3395         if not error-status:error
     3396         or not v-execute then do:
     3397           v-edist-mess = ''.
     3398           v-edist-mess = cr-edist_add-edist-mess( v-edist-mess, 'pack-num':U, "->" + v-pack-num-chr).
     3399           v-edist-mess = cr-edist_add-edist-mess( v-edist-mess, 'ediiterchangeid':U, statusReport.messageId).
     3400           v-date-status = ?.
     3401           run create-edi-state in this-procedure (
     3402                                                   input v-tbl-name
     3403                                                 , input v-doc-code
     3404                                                 , input v-cli-type
     3405                                                 , input v-cli-code
     3406                                                 , input 'ИЗМЕНЕНИЕ':U
     3407                                                 , input v-ord-int1
     3408                                                 , input integer('0':U)
     3409                                                 , input v-PS
     3410                                                 , input v-edist-mess
     3411                                                 , input integer('2':U)
     3412                                                 , input-output v-date-status
     3413                                                 , input-output v-time-status
     3414                                                 ).
     3415           run cur-time in this-procedure ( output v-today, output v-time).
     3416           run get-xcnf_create-temp-esys-pck-sent in p-cont-handle (
     3417                                                                     input v-esys-id
     3418                                                                   ,input integer(v-pack-num-chr)
     3419                                                                   ,input v-crc-pack
     3420                                                                   ,input yes
     3421                                                                   ,input 1
     3422                                                                   ,input 1
     3423                                                                   ,input v-today
     3424                                                                   ,input v-time
     3425                                                                   ,input string(v-time, "HH:MM:SS")
     3426                                                                   ) .
     3427           find first buf_esys-route no-lock where
     3428                     buf_esys-route.esr-dump-ord   = v-dump-ord-int64
     3429                 and buf_esys-route.esys-id   = v-esys-id
     3430                 and buf_esys-route.db-num   = 0  no-error.
     3431           if available buf_esys-route then do:
     3432                   run get-xcnf_create-temp-esys-pck-rcvd in p-cont-handle (
     3433                                                                             input v-esys-id
     3434                                                                           ,input buf_esys-route.esr-last-pack
     3435                                                                           ,input v-crc-pack
     3436                                                                           ,input yes
     3437                                                                           ,input 1
     3438                                                                           ,input 1
     3439                                                                           ,input today
     3440                                                                           ,input integer(entry(1, statusReport.v-time, ":")) * 3600 +
     3441                                                                                   integer(entry(2, statusReport.v-time, ":")) * 60
     3442                                                                           ,input statusReport.v-time
     3443                                                                           ) no-error.
     3444           end.
     3445         end.
     3446       end.
     3447       if v-new-st <> ? then do:
     3448         num-rec-ok = num-rec-ok + 1.
     3449       end.
     3450     end.
     3451     run write-counter in p-log-handle ( input substitute("Прочитано записей: &1, из них удачно: &2", num-rec, num-rec-ok)).
     3452   end.
     3453   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Прочитано записей: &1, из них удачно обработано: &2", num-rec, num-rec-ok)).                      assign v-view-log = yes.
     3454   end procedure.
     3455   PROCEDURE GetChildren:
     3456   DEFINE INPUT PARAMETER hParent AS HANDLE NO-UNDO.
     3457   DEFINE INPUT PARAMETER level AS INTEGER NO-UNDO.
     3458   DEFINE VARIABLE i AS INTEGER NO-UNDO.
     3459   DEFINE VARIABLE hNoderef AS HANDLE NO-UNDO.
     3460   DEFINE VARIABLE hText AS HANDLE NO-UNDO.
     3461   CREATE X-NODEREF hNoderef.
     3462   CREATE X-NODEREF hText .
     3463   REPEAT i = 1 TO hParent:NUM-CHILDREN:
     3464       good = hParent:GET-CHILD(hNoderef,i).
     3465       IF NOT good THEN
     3466           LEAVE.
     3467       IF hNoderef:SUBTYPE <> "element" THEN
     3468           NEXT.
     3469       hNoderef:GET-CHILD(hText, 1) .
     3470       IF hNoderef:NAME = "reportDateTime" THEN
     3471           assign statusReport.reportDateTime = hText:node-value .
     3472       IF hNoderef:NAME = "reportRecipient" THEN
     3473           assign statusReport.reportRecipient = hText:node-value .
     3474       IF hNoderef:NAME = "messageId" THEN
     3475           assign statusReport.messageId = hText:node-value .
     3476       IF hNoderef:NAME = "messageSender" THEN
     3477           assign statusReport.messageSender = hText:node-value .
     3478       IF hNoderef:NAME = "messageRecepient" THEN
     3479           assign statusReport.messageRecepient = hText:node-value .
     3480       IF hNoderef:NAME = "documentType" THEN
     3481           assign statusReport.documentType = hText:node-value .
     3482       IF hNoderef:NAME = "documentNumber" THEN
     3483           assign statusReport.documentNumber = hText:node-value .
     3484       IF hNoderef:NAME = "documentDate" THEN
     3485           assign statusReport.documentDate = (hText:node-value) .
     3486       IF hNoderef:NAME = "dateTime" THEN
     3487           assign
     3488               statusReport.v-date = (substring(hText:node-value, 1, 10))
     3489               statusReport.v-time = substring(hText:node-value, 12, 8)
     3490           .
     3491       IF hNoderef:NAME = "stage" THEN
     3492           assign statusReport.stage = hText:node-value .
     3493       IF hNoderef:NAME = "state" THEN
     3494           assign statusReport.state = hText:node-value .
     3495       RUN GetChildren(hNoderef, (level + 1)).
     3496   END.
     3497   DELETE OBJECT hNoderef.
     3498   DELETE OBJECT hText.
     3499   END PROCEDURE.
     3500   procedure load-ruleset-context :
     3501   define input parameter p-ruleset-id as integer no-undo .
     3502   define variable glog as logical no-undo .
     3503   define buffer buf_rule-call-param for ub.rule-call-param.
     3504   define buffer buf_esys-pck-keys for ub.esys-pck-keys.
     3505   define buffer buf_ext-system for ub.ext-system.
     3506     do
     3507     on error undo, return error
     3508     :
     3509    find first buf_rule-call-param no-lock where
     3510   buf_rule-call-param.codex_id = p-codex-id
     3511   and buf_rule-call-param.ruleset_id = p-ruleset-id
     3512   and buf_rule-call-param.call_id = p-call-id
     3513   and buf_rule-call-param.order_id = p-order-id
     3514   and buf_rule-call-param.rule_id = p-rule-id
     3515   and buf_rule-call-param.param-name = "p-xsd-file"
     3516    no-error.
     3517   if available buf_rule-call-param then do:
     3518   assign p-xsd-file = buf_rule-call-param.param-value-character.
     3519   end.
     3520       case p-ruleset-id:
     3521         when 4 then do:
     3522           assign
     3523           v-sign = 1
     3524           v-current-host-code = p-host-code
     3525           v-current-obj-type = p-obj-type
     3526           v-current-obj-code = p-obj-code
     3527           v-current-doc-code = p-doc-code
     3528           v-current-db-num = g#db-num
     3529           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     3530           file-name  = entry(1, p-process-file-name, chr(4))
     3531           v_dataseth = handle(entry(2, p-process-file-name, chr(4)))
     3532           v-xmlh = buffer buf_temp-xml-tables:handle
     3533           v-esys-id = integer(trim(p-doc-code))
     3534           v-pack-num-chr = entry(3, p-process-file-name, chr(4))
     3535           no-error
     3536          .
     3537           find first buf_ext-system no-lock where
     3538                     buf_ext-system.esys-id = v-esys-id
     3539                 and buf_ext-system.db-num = 0 no-error .
     3540           if not available buf_ext-system
     3541           or buf_ext-system.esys-type <> integer('9':U)
     3542           then do:
     3543                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не найдена ВС &1&2пропускаем ..."                                         , v-esys-id                                         , chr(10)                                         )).                      assign v-view-log = yes.
     3544             undo, return error substitute("Не найдена ВС &1&2пропускаем ..."                                         , v-esys-id                                         , chr(10)                                         ).
     3545           end.
     3546           empty temp-table statusReport .
     3547           CREATE X-DOCUMENT hDoc.
     3548           CREATE X-NODEREF hRoot.
     3549           hDoc:LOAD("file",file-name,FALSE).
     3550           hDoc:GET-DOCUMENT-ELEMENT(hRoot).
     3551           create statusReport .
     3552           RUN GetChildren(hRoot, 1).
     3553           DELETE OBJECT hDoc.
     3554           DELETE OBJECT hRoot.
     3555         end.
     3556         otherwise do:
     3557           undo, return error "Неправильный вызов".
     3558         end.
     3559       end case.
     3560     end.
     3561   end procedure.
     3562   procedure delete-procedure :
     3563     do
     3564     on error undo, return error
     3565     :
     3566         run garbcoll_clear in this-procedure .
     3567     end.
     3568   end procedure.
     3569   procedure delete-ord-list :
     3570   define input parameter p-doc-code as character no-undo .
     3571   define input parameter p-cli-out-doc as character no-undo .
     3572   define input parameter p-trn-doc as character no-undo .
     3573   define input parameter p-is-trn as logical no-undo .
     3574   define buffer buf_ord-list for ord-list.
     3575   find first buf_ord-list where
     3576             buf_ord-list.doc-code = p-doc-code
     3577         and buf_ord-list.trn-doc = p-trn-doc
     3578            no-error .
     3579   if available buf_ord-list then delete buf_ord-list.
     3580   end procedure.
