     1132   procedure get-gate-file-name :
     1133   define input parameter p-gate-rec as character no-undo .
     1134   define output  parameter p-gate-file-name as character no-undo .
     1135   define buffer buf_clob-data for ub.clob-data.
     1136   define variable v-tbl-row as rowid no-undo .
     1137   define variable v-tbl-name as character no-undo .
     1138   run gen-row-keyr in this-procedure ( input p-gate-rec
     1139                                       ,input ?
     1140                                       ,input "ub"
     1141                                       ,input ?
     1142                                       ,input no-lock
     1143                                       ,output v-tbl-row
     1144                                       ,output v-tbl-name) no-error.
     1145   if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     1146                                                           ,vss-include-info10
     1147                                                           ,p-gate-rec).
     1148   find first buf_clob-data no-lock where
     1149             rowid(buf_clob-data) = v-tbl-row no-error.
     1150   if not available buf_clob-data then do:
     1151     if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     1152                                                             ,vss-include-info10
     1153                                                             ,p-gate-rec).
     1154   end.
     1155   p-gate-file-name = buf_clob-data.file-name.
     1156   end procedure.
     1157   procedure get-gate-rec :
     1158   define input  parameter p-gate-name as character no-undo .
     1159   define output parameter p-gate-rec as character no-undo .
     1160   define buffer buf_clob-bind for ub.clob-bind.
     1161   define buffer buf_clob-data for ub.clob-data.
     1162   main-block:
     1163   do
     1164   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info10, return-value, chr(10), error-status :get-message (1))
     1165   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info10 )
     1166   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info10 )
     1167   :
     1168       find first buf_clob-bind no-lock where
     1169                 buf_clob-bind.uniq-key-rec = p-gate-name
     1170             and buf_clob-bind.field-name = '':U
     1171             and buf_clob-bind.part-num = 1
     1172             and buf_clob-bind.resource-type = 'gate':U
     1173             no-error.
     1174       if not available buf_clob-bind then do:
     1175         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     1176                                         , p-gate-name
     1177                                         ).
     1178       end.
     1179       find first buf_clob-data no-lock where
     1180                 buf_clob-data.db-num = buf_clob-bind.db-num
     1181             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     1182       if not available buf_clob-data then do:
     1183         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1184                                         , buf_clob-bind.db-num
     1185                                         , buf_clob-bind.int64-id
     1186                                         , p-gate-name
     1187                                         ).
     1188       end.
     1189       run gen-key-rec in this-procedure ( input 'clob-data':U
     1190                                 ,input buffer buf_clob-data:handle
     1191                                 ,output p-gate-rec).
     1192   end.
     1193   end procedure.
     1194   procedure get-gate-by-name :
     1195   define input  parameter p-gate-name as character no-undo .
     1196   define output parameter p-gate-rec as character no-undo .
     1197   define output parameter p-dsh as handle no-undo .
     1198   define input-output  parameter p-xmlh as handle no-undo .
     1199   define variable v-ii as integer   no-undo .
     1200   define variable glog as logical   no-undo .
     1201   define variable v-longchar as longchar no-undo .
     1202   define variable v-txmlh as handle no-undo .
     1203   define variable v-db-num as integer no-undo .
     1204   define variable v-int64-id as int64 no-undo .
     1205   define buffer buf_clob-bind for ub.clob-bind.
     1206   define buffer buf_clob-data for ub.clob-data.
     1207   main-block:
     1208   do
     1209   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info10, return-value, chr(10), error-status :get-message (1))
     1210   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info10 )
     1211   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info10 )
     1212   :
     1213       find first buf_clob-bind no-lock where
     1214                 buf_clob-bind.uniq-key-rec = p-gate-name
     1215             and buf_clob-bind.field-name = '':U
     1216             and buf_clob-bind.part-num = 1
     1217             and buf_clob-bind.resource-type = 'gate':U
     1218             no-error.
     1219       if not available buf_clob-bind then do:
     1220         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     1221                                         , p-gate-name
     1222                                         ).
     1223       end.
     1224       find first buf_clob-data no-lock where
     1225                 buf_clob-data.db-num = buf_clob-bind.db-num
     1226             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     1227       if not available buf_clob-data then do:
     1228         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1229                                         , buf_clob-bind.db-num
     1230                                         , buf_clob-bind.int64-id
     1231                                         , p-gate-name
     1232                                         ).
     1233       end.
     1234       assign
     1235       v-longchar = buf_clob-data.cdata
     1236       .
     1237       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1238       if error-status :error then do:
     1239         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1240       end.
     1241       create dataset p-dsh .
     1242       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1243                                     , v-longchar
     1244                                     , ?
     1245                                     , ?
     1246                                     , ?
     1247                                     ) no-error.
     1248       v-longchar = '':U.
     1249       if error-status :error
     1250       or not glog
     1251       then do:
     1252         undo, return error substitute("Не удалось прочитать XML-схему &1 из БД:&2&3", p-gate-name, chr(10), error-status:get-message(1) ).
     1253       end.
     1254       if not valid-handle(p-xmlh)
     1255       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1256         create temp-table v-txmlh.
     1257         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1258         v-txmlh:temp-table-prepare("temp-xml-tables").
     1259         p-xmlh = v-txmlh:default-buffer-handle.
     1260       end.
     1261       run gen-key-rec in this-procedure ( input 'clob-data':U
     1262                                 ,input buffer buf_clob-data:handle
     1263                                 ,output p-gate-rec).
     1264       do v-ii = 1 to p-dsh:num-buffers:
     1265         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1266         if not p-xmlh:available then do:
     1267           p-xmlh:buffer-create().
     1268           assign
     1269           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1270           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1271           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1272           p-xmlh::gate-handle_ = p-dsh
     1273           p-xmlh::uniq-gate-rec = p-gate-rec
     1274           p-xmlh::gate-name = p-dsh:name
     1275           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1276           .
     1277           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1278             assign
     1279             p-xmlh::order = -3.
     1280           end.
     1281         end.
     1282       end.
     1283   end.
     1284   end procedure.
     1285   procedure get-gate-by-rec :
     1286   define input  parameter p-gate-rec as character no-undo .
     1287   define output parameter p-dsh as handle no-undo .
     1288   define input-output  parameter p-xmlh as handle no-undo .
     1289   define input-output parameter p-longchar  as longchar no-undo .
     1290   define variable v-ii as integer   no-undo .
     1291   define variable glog as logical   no-undo .
     1292   define variable v-rowid as rowid no-undo .
     1293   define variable v-tbl-name as character no-undo .
     1294   define variable v-longchar as longchar no-undo .
     1295   define variable v-txmlh as handle no-undo .
     1296   define buffer buf_clob-data for ub.clob-data.
     1297   main-block:
     1298   do
     1299   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info10, return-value, chr(10), error-status :get-message (1))
     1300   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info10 )
     1301   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info10 )
     1302   :
     1303     run gen-row-keyr in this-procedure (
     1304                                           input  p-gate-rec
     1305                                           ,input  ?
     1306                                           ,input  "ub"
     1307                                           ,input  ?
     1308                                           ,input  NO-LOCK
     1309                                           ,output v-rowid
     1310                                           ,output v-tbl-name   ) no-error.
     1311       find first buf_clob-data no-lock where
     1312                 rowid(buf_clob-data) = v-rowid  no-error.
     1313       if not available buf_clob-data then do:
     1314         undo, return error substitute("Не найден CLOB  &1"
     1315                                         , p-gate-rec
     1316                                         ).
     1317       end.
     1318       assign
     1319       v-longchar = buf_clob-data.cdata
     1320       .
     1321       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1322       if error-status :error then do:
     1323         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1324       end.
     1325       create dataset p-dsh .
     1326       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1327                                     , v-longchar
     1328                                     , ?
     1329                                     , ?
     1330                                     , ?
     1331                                     ) no-error.
     1332       define variable v-esm as character no-undo .
     1333       v-esm = error-status:get-message(1) .
     1334       if p-longchar <> ? then do:
     1335         p-longchar = v-longchar.
     1336       end.
     1337       v-longchar = '':U.
     1338       if error-status :error
     1339       or not glog
     1340       then do:
     1341         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     1342                                      , p-gate-rec
     1343                                      , p-gate-rec
     1344                                      , v-esm
     1345                                      ).
     1346       end.
     1347       p-dsh:private-data = buf_clob-data.file-name_ + chr(4) + p-gate-rec.
     1348       if not valid-handle(p-xmlh)
     1349       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1350         create temp-table v-txmlh.
     1351         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1352         v-txmlh:temp-table-prepare("temp-xml-tables").
     1353         p-xmlh = v-txmlh:default-buffer-handle.
     1354       end.
     1355       do v-ii = 1 to p-dsh:num-buffers:
     1356         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1357         if not p-xmlh:available then do:
     1358           p-xmlh:buffer-create().
     1359           assign
     1360           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1361           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1362           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1363           p-xmlh::gate-handle_ = p-dsh
     1364           p-xmlh::uniq-gate-rec = p-gate-rec
     1365           p-xmlh::gate-name = p-dsh:name
     1366           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1367           .
     1368           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1369             assign
     1370             p-xmlh::order = -3.
     1371           end.
     1372           p-xmlh:buffer-release().
     1373         end.
     1374       end.
     1375   end.
     1376   end procedure.
     1377   procedure get-gate-by-file :
     1378   define input  parameter p-schema-file-name as character no-undo .
     1379   define input  parameter p-gate-rec as character no-undo .
     1380   define output parameter p-dsh as handle no-undo .
     1381   define input-output  parameter p-xmlh as handle no-undo .
     1382   define variable v-ii as integer   no-undo .
     1383   define variable glog as logical   no-undo .
     1384   define variable v-rowid as rowid no-undo .
     1385   define variable v-tbl-name as character no-undo .
     1386   define variable v-longchar as longchar no-undo .
     1387   define variable v-txmlh as handle no-undo .
     1388   main-block:
     1389   do
     1390   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info10, return-value, chr(10), error-status :get-message (1))
     1391   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info10 )
     1392   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info10 )
     1393   :
     1394       COPY-LOB
     1395       FROM  FILE p-schema-file-name
     1396       TO  OBJECT v-longchar
     1397       no-convert
     1398       NO-ERROR .
     1399       if error-status :error then do:
     1400           undo, return error substitute("Не удалось считать файл схемы &1 в память&2&3"
     1401                                     , p-schema-file-name
     1402                                 , chr(10)
     1403                                 , error-status:get-message(1) ).
     1404       end.
     1405       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1406       if error-status :error then do:
     1407         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, p-schema-file-name, chr(10), error-status:get-message(1) , return-value ).
     1408       end.
     1409       create dataset p-dsh .
     1410       glog = p-dsh:READ-XMLSCHEMA( "longchar"
     1411                                     , v-longchar
     1412                                     , ?
     1413                                     , ?
     1414                                     , ?
     1415                                     ) no-error.
     1416       v-longchar = ''.
     1417       if error-status :error
     1418       or not glog
     1419       then do:
     1420         undo, return error substitute("Не удалось прочитать XML-схему из файла &1&2&3"
     1421                                      , p-schema-file-name
     1422                                      ,chr(10)
     1423                                      , error-status:get-message(1)
     1424                                      ).
     1425       end.
     1426       if not valid-handle(p-xmlh)
     1427       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1428         create temp-table v-txmlh.
     1429         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1430         v-txmlh:temp-table-prepare("temp-xml-tables").
     1431         p-xmlh = v-txmlh:default-buffer-handle.
     1432       end.
     1433       do v-ii = 1 to p-dsh:num-buffers:
     1434         p-xmlh:find-first(substitute(' where tbl-name = "&1" and  uniq-gate-rec = "&2" '
     1435                                      ,p-dsh:get-buffer-handle(v-ii):name
     1436                                      ,p-gate-rec
     1437                                      )) no-error.
     1438         if not p-xmlh:available then do:
     1439           p-xmlh:buffer-create().
     1440           assign
     1441           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):table
     1442           p-xmlh::uniq-gate-rec = p-gate-rec
     1443           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1444           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1445           p-xmlh::gate-handle_ = p-dsh
     1446           p-xmlh::gate-name = p-dsh:name
     1447           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1448           .
     1449           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1450             assign
     1451             p-xmlh::order = -3.
     1452           end.
     1453           p-xmlh:buffer-release().
     1454         end.
     1455       end.
     1456   end.
     1457   end procedure.
     1458   procedure gate-clear :
     1459   define input  parameter p-dsh as handle no-undo .
     1460   define input  parameter p-xmlh as handle no-undo .
     1461   define variable v-dsh as handle no-undo .
     1462   define variable v-th as handle no-undo .
     1463     do
     1464     on error undo, return error return-value
     1465     :
     1466       if valid-handle(p-dsh) then do:
     1467         delete object p-dsh.
     1468         v-dsh = p-dsh.
     1469         p-dsh = ?.
     1470       end.
     1471       repeat while true:
     1472         p-xmlh:find-first( substitute( " where gate-handle_ = &1 ", v-dsh)
     1473                            , share-lock) no-error.
     1474         if p-xmlh:available then do:
     1475           assign
     1476           v-th = p-xmlh:buffer-field("table-handle_"):buffer-value.
     1477           if valid-handle(p-xmlh:buffer-field("table-handle_"))
     1478           and valid-handle(v-th)
     1479           and v-th:dynamic = yes
     1480           then do:
     1481             delete object p-xmlh:buffer-field("table-handle_"):buffer-value.
     1482             p-xmlh:buffer-field("table-handle_"):buffer-value = ?.
     1483           end.
     1484           p-xmlh:buffer-delete().
     1485         end.
     1486         else do:
     1487           leave.
     1488         end.
     1489       end.
     1490       if p-xmlh:dynamic = yes
     1491       and valid-handle(p-xmlh)
     1492       then do:
     1493         delete object p-xmlh:table-handle.
     1494         p-xmlh = ?.
     1495       end.
     1496       v-dsh = ?.
     1497     end.
     1498   end procedure.
     1499   procedure all-gates-clear :
     1500   define parameter buffer buf_temp-xml-tables for temp-xml-tables.
     1501   do
     1502   on error undo, return error
     1503   :
     1504     for each buf_temp-xml-tables
     1505     break
     1506     by buf_temp-xml-tables.uniq-gate-rec
     1507     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1508     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1509     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1510     :
     1511         if first-of(buf_temp-xml-tables.uniq-gate-rec) then do:
     1512           delete object buf_temp-xml-tables.gate-handle_.
     1513           buf_temp-xml-tables.gate-handle_ = ?.
     1514         end.
     1515         if valid-handle(buf_temp-xml-tables.table-handle_)
     1516         and buf_temp-xml-tables.table-handle_:dynamic = no
     1517         then do:
     1518           delete object buf_temp-xml-tables.table-handle_.
     1519           buf_temp-xml-tables.table-handle_ = ?.
     1520         end.
     1521         delete buf_temp-xml-tables.
     1522     end.
     1523   end.
     1524   end procedure.
     1525   procedure fix-schemalocation :
     1526   define input-output  parameter p-longchar as longchar no-undo .
     1527   DEFINE VARIABLE hdoc AS HANDLE.
     1528   DEFINE VARIABLE hroot AS HANDLE.
     1529   DEFINE VARIABLE hnode-child AS HANDLE.
     1530   DEFINE VARIABLE hnode-attr AS HANDLE.
     1531   define variable v-jj as integer   no-undo .
     1532   define variable ok as logical   no-undo .
     1533   define variable v-path1                    as character                no-undo .
     1534   DEFINE VARIABLE v-full-path1               as character                no-undo .
     1535   DEFINE VARIABLE v-file-name1               as character                no-undo .
     1536   DEFINE VARIABLE v-file-name-no-ext1        as character                no-undo .
     1537   DEFINE VARIABLE v-file-name-ext1           as character                no-undo .
     1538   define variable v-schema-location          as character                no-undo .
     1539   do
     1540   on error undo, return error return-value
     1541   :
     1542     CREATE X-DOCUMENT hdoc.
     1543     CREATE X-noderef hroot.
     1544     CREATE X-noderef hnode-child.
     1545     CREATE X-noderef hnode-attr.
     1546     hdoc:load("longchar", p-longchar, no) no-error.
     1547     iF ERROR-STATUS:GET-MESSAGE(1) <> '' THEN message ERROR-STATUS:GET-MESSAGE(1) view-as alert-box .
     1548     hdoc:get-document-element(hroot).
     1549     _repeat:
     1550     REPEAT v-jj = 1 TO hroot:NUM-CHILDREN:
     1551       ok = hroot:GET-CHILD(hNode-Child, v-jj).
     1552       if not ok then next.
     1553       if hNode-Child:local-name = "include"
     1554       then do:
     1555         ok = hNode-Child:GET-ATTRIBUTE-NODE( hnode-attr, "schemaLocation" ).
     1556           v-schema-location = hnode-attr:node-value.
     1557           run gbl/filename.p (
     1558                           input "exe/" + hnode-attr:node-value
     1559                         ,output v-full-path1
     1560                         ,output v-path1
     1561                         ,output v-file-name1
     1562                         ,output v-file-name-no-ext1
     1563                         ,output v-file-name-ext1
     1564                         ) no-error .
     1565           if error-status :error then do:
     1566             delete object hnode-attr.
     1567             delete object hnode-child.
     1568             delete object hroot.
     1569             delete object hdoc.
     1570             undo, return error substitute("Не удалось определить расположение схемы &1", v-schema-location).
     1571           end.
     1572         ok = hNode-Child:sET-ATTRIBUTE(  "schemaLocation", v-full-path1 ).
     1573         leave  _repeat.
     1574       end.
     1575     END.
     1576     hdoc:save("longchar", p-longchar).
     1577     delete object hnode-attr.
     1578     delete object hnode-child.
     1579     delete object hroot.
     1580     delete object hdoc.
     1581   end.
     1582   end procedure.
     1583   procedure gate-clb_fill-xml-tables :
     1584   define input parameter p-dsh as handle no-undo .
     1585   define input-output parameter p-xmlh as handle no-undo .
     1586   define variable v-ii as integer no-undo .
     1587     do
     1588     on error undo, return error
     1589     :
     1590       do v-ii = 1 to p-dsh:num-buffers:
     1591         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1592         if not p-xmlh:available then do:
     1593           p-xmlh:buffer-create().
     1594           assign
     1595           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1596           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1597           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1598           p-xmlh::gate-handle_ = p-dsh
     1599           p-xmlh::uniq-gate-rec = entry(2, p-dsh:private-data, chr(4))
     1600           p-xmlh::gate-name = p-dsh:name
     1601           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1602           .
     1603           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1604             assign
     1605             p-xmlh::order = -3.
     1606           end.
     1607           p-xmlh:buffer-release().
     1608         end.
     1609       end.
     1610     end.
     1611   end procedure.
     1612   procedure all-gates-empty :
     1613   define buffer buf_temp-xml-tables for temp-xml-tables.
     1614   do
     1615   on error undo, return error
     1616   :
     1617     for each buf_temp-xml-tables
     1618     break
     1619     by buf_temp-xml-tables.uniq-gate-rec
     1620     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1621     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1622     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1623     :
     1624       if valid-handle(buf_temp-xml-tables.tbl-handle_) then do:
     1625         buf_temp-xml-tables.tbl-handle_:empty-temp-table().
     1626       end.
     1627     end.
     1628   end.
     1629   end procedure.
     1630   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1631   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1632   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1633   procedure proc-ord-code :
     1634   define input  parameter  p-type as character no-undo .
     1635   define input  parameter  v-cntxt-db-num   as integer   no-undo .
     1636   define input  parameter  v-cntxt-obj-type as character no-undo .
     1637   define input  parameter  v-cntxt-obj-code as integer   no-undo .
     1638   define input  parameter  p-i-doc    as character no-undo .
     1639   define output parameter  p-ord-doc  as character no-undo .
     1640   define variable          v-idop     as character no-undo .
     1641     do
     1642     on error undo, return error return-value
     1643     :
     1644   case p-type :
     1645       when "main-no-ver" then do:
     1646         if  (v-cntxt-db-num <> 0) then
     1647           p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (v-cntxt-obj-code, ">>>>9")) + substring (v-cntxt-obj-type, (if g#language = "RUS" then 1 else 2), 1).
     1648         else
     1649           p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-".
     1650       end.
     1651       when "main" then do:
     1652             do while true:
     1653             if  (v-cntxt-db-num <> 0) then
     1654               p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (v-cntxt-obj-code, ">>>>9")) + substring (v-cntxt-obj-type, (if g#language = "RUS" then 1 else 2), 1).
     1655             else
     1656               p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-".
     1657             if not can-find (ub.ord-doc where ub.ord-doc.doc-code = p-ord-doc no-lock) then leave.
     1658             End.
     1659       end.
     1660       when "chip" then do:
     1661         assign
     1662           v-idop = p-i-doc .
     1663         do while true :
     1664           if index (v-idop , ".") = 0 then
     1665             v-idop  = replace (v-idop , "-", "-1.").
     1666           else
     1667             v-idop  =
     1668             substring (v-idop , 1, index (v-idop, "-")) +
     1669             string (integer (substring (v-idop, index (v-idop, "-") + 1, index (v-idop, ".") - index (v-idop, "-") - 1)) + 1) +
     1670             substring (v-idop, index (v-idop, ".")).
     1671           if not can-find (ub.ord-doc where ub.ord-doc.doc-code = v-idop no-lock) then leave.
     1672         end.
     1673         assign
     1674           p-ord-doc = v-idop.
     1675       end.
     1676   end case.
     1677     end.
     1678   end procedure.
     1679   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1680   def var vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1681   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1682   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1683   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1684   procedure ordlineattr-value :
     1685     do
     1686     on error undo, return error return-value
     1687     :
     1688       define input  parameter p-doc-code like ub.ord-line-attr.doc-code   no-undo .
     1689       define input  parameter p-gds-code like ub.ord-line-attr.gds-code   no-undo .
     1690       define input  parameter p-code     like ub.ord-line-attr.attr-code  no-undo .
     1691       define output parameter p-value    like ub.ord-line-attr.attr-value no-undo .
     1692       define output parameter p-type     as character no-undo .
     1693       define buffer buf_ord-line-attr for ub.ord-line-attr .
     1694       define variable v-format         as character no-undo .
     1695       define variable v-fillin_width   as integer   no-undo .
     1696       define variable v-fillin_height  as integer   no-undo .
     1697       define variable v-label          as character no-undo .
     1698       define variable v-user-can-edit  as logical   no-undo .
     1699       define variable v-output-display as logical   no-undo .
     1700       define variable v-other          as character no-undo .
     1701       define variable v-proc           as character no-undo .
     1702       define variable v-func           as character no-undo .
     1703       define variable v-sort           as integer   no-undo .
     1704       run ordlineattr-code in this-procedure
     1705         (input  p-code
     1706         ,output p-type
     1707         ,output v-format
     1708         ,output v-fillin_width
     1709         ,output v-fillin_height
     1710         ,output v-label
     1711         ,output v-user-can-edit
     1712         ,output v-output-display
     1713         ,output v-proc
     1714         ,output v-func
     1715         ,output v-sort
     1716         ,output v-other
     1717         ) no-error .
     1718       if error-status :error then do:
     1719         undo, return error return-value .
     1720       end.
     1721       find first buf_ord-line-attr no-lock
     1722         where buf_ord-line-attr.doc-code  = p-doc-code
     1723           and buf_ord-line-attr.gds-code  = p-gds-code
     1724           and buf_ord-line-attr.attr-code = p-code
     1725         no-error .
     1726       if avail buf_ord-line-attr then do:
     1727         assign
     1728           p-value =  buf_ord-line-attr.attr-value
     1729         .
     1730       end.
     1731       else do:
     1732         assign
     1733           p-value = if p-type = 'L':U then "no":U else ""
     1734         .
     1735       end.
     1736     end.
     1737   end procedure.
     1738   procedure ordlineattr-write :
     1739     do
     1740     on error undo, return error return-value
     1741     :
     1742       define input parameter p-doc-code like ub.ord-line-attr.doc-code   no-undo .
     1743       define input parameter p-gds-code like ub.ord-line-attr.gds-code   no-undo .
     1744       define input parameter p-code     like ub.ord-line-attr.attr-code  no-undo .
     1745       define input parameter p-value    like ub.ord-line-attr.attr-value no-undo .
     1746       define buffer buf_ord-line-attr for ub.ord-line-attr .
     1747       define variable v-type           as character no-undo .
     1748       define variable v-format         as character no-undo .
     1749       define variable v-fillin_width   as integer   no-undo .
     1750       define variable v-fillin_height  as integer   no-undo .
     1751       define variable v-label          as character no-undo .
     1752       define variable v-user-can-edit  as logical   no-undo .
     1753       define variable v-output-display as logical   no-undo .
     1754       define variable v-other          as character no-undo .
     1755       define variable v-proc           as character no-undo .
     1756       define variable v-func           as character no-undo .
     1757       define variable v-sort           as integer   no-undo .
     1758       run ordlineattr-code in this-procedure
     1759         (input  p-code
     1760         ,output v-type
     1761         ,output v-format
     1762         ,output v-fillin_width
     1763         ,output v-fillin_height
     1764         ,output v-label
     1765         ,output v-user-can-edit
     1766         ,output v-output-display
     1767         ,output v-proc
     1768         ,output v-func
     1769         ,output v-sort
     1770         ,output v-other
     1771         ) no-error .
     1772       if error-status :error then do:
     1773         message
     1774           vss-workfile vss-revision vss-description skip
     1775           error-status :get-message(1) skip
     1776           return-value skip
     1777           ""
     1778           view-as alert-box error
     1779         .
     1780         undo, return error return-value .
     1781       end.
     1782       find first buf_ord-line-attr exclusive-lock
     1783         where buf_ord-line-attr.doc-code  = p-doc-code
     1784           and buf_ord-line-attr.gds-code  = p-gds-code
     1785           and buf_ord-line-attr.attr-code = p-code
     1786         no-error .
     1787       if not available buf_ord-line-attr then do:
     1788         create buf_ord-line-attr .
     1789         assign
     1790           buf_ord-line-attr.doc-code   = p-doc-code
     1791           buf_ord-line-attr.gds-code   = p-gds-code
     1792           buf_ord-line-attr.attr-code  = p-code
     1793         .
     1794       end.
     1795       assign
     1796         buf_ord-line-attr.attr-value = p-value
     1797       .
     1798   end.
     1799   end procedure.
     1800   procedure ordlineattr-exist :
     1801     do
     1802     on error undo, return error return-value
     1803     :
     1804       define input parameter p-doc-code like ub.ord-line-attr.doc-code   no-undo .
     1805       define input parameter p-gds-code like ub.ord-line-attr.gds-code   no-undo .
     1806       define input parameter p-code     like ub.ord-line-attr.attr-code  no-undo .
     1807       define output parameter p-exist   as logical  no-undo .
     1808       define buffer buf_ord-line-attr for ub.ord-line-attr .
     1809       define variable v-type           as character no-undo .
     1810       define variable v-format         as character no-undo .
     1811       define variable v-fillin_width   as integer   no-undo .
     1812       define variable v-fillin_height  as integer   no-undo .
     1813       define variable v-label          as character no-undo .
     1814       define variable v-user-can-edit  as logical   no-undo .
     1815       define variable v-output-display as logical   no-undo .
     1816       define variable v-other          as character no-undo .
     1817       define variable v-proc           as character no-undo .
     1818       define variable v-func           as character no-undo .
     1819       define variable v-sort           as integer   no-undo .
     1820       run ordlineattr-code in this-procedure
     1821         (input  p-code
     1822         ,output v-type
     1823         ,output v-format
     1824         ,output v-fillin_width
     1825         ,output v-fillin_height
     1826         ,output v-label
     1827         ,output v-user-can-edit
     1828         ,output v-output-display
     1829         ,output v-proc
     1830         ,output v-func
     1831         ,output v-sort
     1832         ,output v-other
     1833         ) no-error .
     1834       if error-status :error then do:
     1835         undo, return error return-value .
     1836       end.
     1837       find first buf_ord-line-attr no-lock
     1838         where buf_ord-line-attr.doc-code  = p-doc-code
     1839           and buf_ord-line-attr.gds-code = p-gds-code
     1840           and buf_ord-line-attr.attr-code = p-code
     1841         no-error .
     1842       if  available buf_ord-line-attr then do:
     1843         p-exist = yes.
     1844       end.
     1845     end.
     1846   end procedure.
     1847   procedure ordlineattr-delete :
     1848     do
     1849     on error undo, return error return-value
     1850     :
     1851       define input parameter p-doc-code like ub.ord-line-attr.doc-code   no-undo .
     1852       define input parameter p-gds-code like ub.ord-line-attr.gds-code   no-undo .
     1853       define input parameter p-code     like ub.ord-line-attr.attr-code  no-undo .
     1854       define output parameter p-deleted  as logical no-undo.
     1855       define buffer buf_ord-line-attr for ub.ord-line-attr .
     1856       define variable v-type           as character no-undo .
     1857       define variable v-format         as character no-undo .
     1858       define variable v-fillin_width   as integer   no-undo .
     1859       define variable v-fillin_height  as integer   no-undo .
     1860       define variable v-label          as character no-undo .
     1861       define variable v-user-can-edit  as logical   no-undo .
     1862       define variable v-output-display as logical   no-undo .
     1863       define variable v-proc           as character no-undo .
     1864       define variable v-func           as character no-undo .
     1865       define variable v-sort           as integer   no-undo .
     1866       define variable v-other          as character no-undo .
     1867       run ordlineattr-code in this-procedure
     1868         (input  p-code
     1869         ,output v-type
     1870         ,output v-format
     1871         ,output v-fillin_width
     1872         ,output v-fillin_height
     1873         ,output v-label
     1874         ,output v-user-can-edit
     1875         ,output v-output-display
     1876         ,output v-proc
     1877         ,output v-func
     1878         ,output v-sort
     1879         ,output v-other
     1880         ) no-error .
     1881       if error-status :error then do:
     1882         undo, return error return-value .
     1883       end.
     1884       find first buf_ord-line-attr exclusive-lock
     1885         where buf_ord-line-attr.doc-code  = p-doc-code
     1886           and buf_ord-line-attr.gds-code  = p-gds-code
     1887           and buf_ord-line-attr.attr-code = p-code
     1888         no-error NO-WAIT.
     1889       if not available buf_ord-line-attr then do:
     1890         p-deleted = no.
     1891       end.
     1892       else do:
     1893         delete buf_ord-line-attr.
     1894         p-deleted = yes.
     1895       end.
     1896     end.
     1897   end procedure.
     1898   procedure ordlineattr-code :
     1899     do on error undo, return error return-value
     1900     :
     1901       define input  parameter p-code           as character no-undo .
     1902       define output parameter p-type           as character no-undo .
     1903       define output parameter p-format         as character no-undo .
     1904       define output parameter p-fillin_width   as integer   no-undo .
     1905       define output parameter p-fillin_height  as integer   no-undo .
     1906       define output parameter p-label          as character no-undo .
     1907       define output parameter p-user-can-edit  as logical   no-undo .
     1908       define output parameter p-output-display as logical   no-undo .
     1909       define output parameter p-proc           as character no-undo .
     1910       define output parameter p-func           as character no-undo .
     1911       define output parameter p-sort           as integer   no-undo .
     1912       define output parameter p-other          as character no-undo .
     1913       case p-code :
     1914               when 'cycle-cli-qnty':U then do:     assign     p-label          = "Количество"     p-type           = 'D':U      p-format         = ">>>>>>>>>>>>>>>9.999"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "Количество"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
     1915               when 'ord-EAN13':U then do:     assign     p-label          = "EAN в EDI"     p-type           = 'C':U      p-format         = "X(13)"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "EAN в EDI"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
     1916         otherwise do:
     1917           undo, return error "неизвестный атрибут строки заказа" + " " + p-code .
     1918         end.
     1919       end.
     1920     end.
     1921   end procedure.
     1922   FUNCTION cr-edist_get-mess-mean returns character ( input p-mess as character):
     1923   define variable v-ii as integer   no-undo .
     1924   define variable v-dop as character no-undo .
     1925   define variable v-dop1 as character no-undo .
     1926   define variable v-mess as character no-undo .
     1927   do v-ii = 1 to num-entries(p-mess, chr(4) ):
     1928     v-dop = entry(v-ii, p-mess, chr(4) ).
     1929     case entry(1, v-dop, "="):
     1930       when 'pack-num':U then do:
     1931         v-dop1 =  substitute("&1 &2", 'Пакет', entry(2, v-dop, "=")).
     1932       end.
     1933       when 'route':U then do:
     1934         v-dop1 =  substitute("&1 &2", 'Рут':U, entry(2, v-dop, "=")).
     1935       end.
     1936       when 'ediiterchangeid':U then do:
     1937         v-dop1 =  substitute("&1 &2", 'ediiterchangeid':U, entry(2, v-dop, "=")).
     1938       end.
     1939       when 'price-up':U then do:
     1940         v-dop1 =  substitute("&1 &2", 'Цена':U, entry(2, v-dop, "=")).
     1941       end.
     1942       when 'price-down':U then do:
     1943         v-dop1 =  substitute("&1 &2", 'Цена':U, entry(2, v-dop, "=")).
     1944       end.
     1945       when 'vat-change':U then do:
     1946         v-dop1 =  substitute("&1 &2", 'НДС':U, entry(2, v-dop, "=")).
     1947       end.
     1948       when 'ps':U then do:
     1949         v-dop1 =  substitute("&1 &2", ' ':U, entry(2, v-dop, "=")).
     1950       end.
     1951       when 'info':U then do:
     1952         v-dop1 =  substitute("&1 &2", 'Инф:':U, entry(2, v-dop, "=")).
     1953       end.
     1954       when 'qnty-up':U then do:
     1955         v-dop1 =  substitute("&1 &2", 'Кол-во':U, entry(2, v-dop, "=")).
     1956       end.
     1957       when 'qnty-down':U then do:
     1958         v-dop1 =  substitute("&1 &2", 'Кол-во':U, entry(2, v-dop, "=")).
     1959       end.
     1960       when 'bstr-change':U then do:
     1961         v-dop1 =  substitute("&1 &2", 'Штрихкод:':U, entry(2, v-dop, "=")).
     1962       end.
     1963       when 'shipdate-change':U then do:
     1964         v-dop1 =  substitute("&1 &2", 'Дата отгрузки:':U, entry(2, v-dop, "=")).
     1965       end.
     1966       when 'clioutdoc-change':U then do:
     1967         v-dop1 =  substitute("&1 &2", '№ заказа по пост-ку:':U, entry(2, v-dop, "=")).
     1968       end.
     1969     end case.
     1970     v-mess  = v-mess + (if v-mess = '' then '' else chr(32)) + v-dop1.
     1971   end.
     1972   return v-mess.
     1973   end function.
     1974   FUNCTION cr-edist_get-error-mean returns character ( input p-mess as character):
     1975   define variable v-ii as integer   no-undo .
     1976   define variable v-dop as character no-undo .
     1977   define variable v-dop1 as character no-undo .
     1978   define variable v-mess as character no-undo .
     1979   do v-ii = 1 to num-entries(p-mess, chr(4) ):
     1980     v-dop = entry(v-ii, p-mess, chr(4) ).
     1981     case entry(1, v-dop, "="):
     1982       when 'pack-num':U then do:
     1983         v-dop1 =  substitute("&1 &2", 'Пакет', entry(2, v-dop, "=")).
     1984       end.
     1985       when 'route':U then do:
     1986         v-dop1 =  substitute("&1 &2", 'Рут':U, entry(2, v-dop, "=")).
     1987       end.
     1988       when 'ediiterchangeid':U then do:
     1989         v-dop1 =  substitute("&1 &2", 'ediiterchangeid':U, entry(2, v-dop, "=")).
     1990       end.
     1991       when 'price-up':U then do:
     1992         v-dop1 =  substitute("&1 &2", 'Цена':U, entry(2, v-dop, "=")).
     1993       end.
     1994       when 'price-down':U then do:
     1995         v-dop1 =  substitute("&1 &2", 'Цена':U, entry(2, v-dop, "=")).
     1996       end.
     1997       when 'vat-change':U then do:
     1998         v-dop1 =  substitute("&1 &2", 'НДС':U, entry(2, v-dop, "=")).
     1999       end.
     2000       when 'ps':U then do:
     2001         v-dop1 =  substitute("&1 &2", ' ':U, entry(2, v-dop, "=")).
     2002       end.
     2003       when 'info':U then do:
     2004         v-dop1 =  substitute("&1 &2", 'Инф:':U, entry(2, v-dop, "=")).
     2005       end.
     2006       when 'qnty-up':U then do:
     2007         v-dop1 =  substitute("&1 &2", 'Кол-во':U, entry(2, v-dop, "=")).
     2008       end.
     2009       when 'qnty-down':U then do:
     2010         v-dop1 =  substitute("&1 &2", 'Кол-во':U, entry(2, v-dop, "=")).
     2011       end.
     2012       when 'bstr-change':U then do:
     2013         v-dop1 =  substitute("&1 &2", 'Штрихкод:':U, entry(2, v-dop, "=")).
     2014       end.
     2015       when 'shipdate-change':U then do:
     2016         v-dop1 =  substitute("&1 &2", 'Дата отгрузки:':U, entry(2, v-dop, "=")).
     2017       end.
     2018       when 'clioutdoc-change':U then do:
     2019         v-dop1 =  substitute("&1 &2", '№ заказа по пост-ку:':U, entry(2, v-dop, "=")).
     2020       end.
     2021     end case.
     2022     v-mess  = v-mess + (if v-mess = '' then '' else chr(4)) + v-dop1.
     2023   end.
     2024   return v-mess.
     2025   end function.
     2026   FUNCTION cr-edist_get-mess-key-value returns character ( input p-mess as character, input p-key as character):
     2027   define variable v-ii as integer   no-undo .
     2028   define variable v-dop as character no-undo .
     2029   define variable v-dop1 as character no-undo .
     2030   define variable v-value as character no-undo .
     2031   do v-ii = 1 to num-entries(p-mess, chr(4) ):
     2032     v-dop = entry(v-ii, p-mess, chr(4) ).
     2033     if entry(1, v-dop, "=") = p-key then do:
     2034       return entry(2, v-dop, "=").
     2035     end.
     2036   end.
     2037   return v-value.
     2038   end function.
     2039   FUNCTION cr-edist_add-edist-mess returns character ( input p-mess as character
     2040                                                        ,input p-key as character
     2041                                                        ,input p-value as character):
     2042   define variable v-dop as character no-undo .
     2043   define variable v-modificator as character no-undo .
     2044   assign
     2045   v-modificator = entry(2, p-key, "-") no-error .
     2046   case v-modificator:
     2047     when "up" then do:
     2048       v-dop = substitute("&1=&2<&3", p-key, entry(1, p-value, chr(4)) , entry(2, p-value, chr(4))).
     2049     end.
     2050     when "down" then do:
     2051       v-dop = substitute("&1=&2>&3", p-key, entry(1, p-value, chr(4)) , entry(2, p-value, chr(4))).
     2052     end.
     2053     when "change" then do:
     2054       v-dop = substitute("&1=&2 ->&3", p-key, entry(1, p-value, chr(4)) , entry(2, p-value, chr(4))).
     2055     end.
     2056     otherwise do:
     2057       v-dop = substitute("&1=&2", p-key, p-value).
     2058     end.
     2059   end case.
     2060   if p-mess = ''
     2061   or p-mess = ? then do:
     2062     return v-dop .
     2063   end.
     2064   else do:
     2065     return substitute("&1&2&3", p-mess, chr(4), v-dop).
     2066   end.
     2067   end function.
     2068   procedure create-edi-state :
     2069   define input  parameter p-tbl-name   as character no-undo .
     2070   define input  parameter p-doc-code   as character no-undo .
     2071   define input  parameter p-cli-type   as character no-undo .
     2072   define input  parameter p-cli-code   as integer   no-undo .
     2073   define input  parameter p-act        as character no-undo .
     2074   define input  parameter p-state      as character no-undo .
     2075   define input  parameter p-err        as integer   no-undo .
     2076   define input  parameter p-des        as character no-undo .
     2077   define input  parameter p-mess       as character no-undo .
     2078   define input  parameter p-dm         as integer  no-undo .
     2079   define input-output parameter p-date       as date no-undo .
     2080   define input-output parameter p-time       as integer no-undo .
     2081   define buffer buf_EDI-status for ub.EDI-status  .
     2082   define variable v-time as integer   no-undo .
     2083   define variable v-date as date   no-undo .
     2084   do
     2085   on error undo, return error return-value
     2086   :
     2087     if p-date = ? then do:
     2088       run cur-time in this-procedure ( output v-date, output v-time).
     2089     end.
     2090     else do:
     2091       assign
     2092       v-date = p-date
     2093       v-time = p-time
     2094       .
     2095     end.
     2096     find first buf_edi-status exclusive-lock where
     2097                 buf_edi-status.date-status = v-date
     2098             and buf_edi-status.time-status = v-time
     2099             and buf_edi-status.tbl-name    = p-tbl-name
     2100             and buf_edi-status.doc-code    = p-doc-code no-error .
     2101     if not available buf_edi-status  then do:
     2102       create buf_edi-status.
     2103     end.
     2104     assign
     2105     buf_edi-status.act         = p-act        .
     2106     buf_edi-status.cli-type    = p-cli-type   .
     2107     buf_edi-status.cli-code    = p-cli-code   .
     2108     buf_edi-status.des-err     = buf_edi-status.des-err + (if buf_edi-status.des-err = '' then '' else chr(4)) + p-des        .
     2109     buf_edi-status.doc-code    = p-doc-code   .
     2110     buf_edi-status.err-code    = p-err        .
     2111     buf_edi-status.mess-id     = buf_edi-status.mess-id + (if buf_edi-status.mess-id = '' then '' else chr(4)) + p-mess       .
     2112     buf_edi-status.state       = p-state      .
     2113     buf_edi-status.tbl-name    = p-tbl-name   .
     2114     buf_edi-status.date-status = v-date       .
     2115     buf_edi-status.time-status = v-time       .
     2116     buf_edi-status.whole-send-news = p-dm     .
     2117     buf_edi-status.user-name   = (if g#news then (chr(4) +  'СПН':U)
     2118                                       else (if g#esys
     2119                                             then (chr(4) +  'ВС':U)
     2120                                             else g#userid)
     2121                                       )       .
     2122     assign
     2123     p-date = buf_edi-status.date-status
     2124     p-time = buf_edi-status.time-status
     2125     .
     2126   end.
     2127   end procedure.
     2128   procedure update-edi-state-light :
     2129   define input  parameter p-tbl-name   as character no-undo .
     2130   define input  parameter p-doc-code   as character no-undo .
     2131   define input  parameter p-date-status as date no-undo .
     2132   define input  parameter p-time-status as integer no-undo .
     2133   define input  parameter p-state      as character no-undo .
     2134   define input  parameter p-err        as integer   no-undo .
     2135   define input  parameter p-des        as character no-undo .
     2136   define input  parameter p-mess       as character no-undo .
     2137   define buffer buf_edi-status for ub.edi-status.
     2138   do
     2139   on error undo, return error
     2140   :
     2141     find first buf_edi-status exclusive-lock where
     2142                 buf_edi-status.date-status = p-date-status
     2143             and buf_edi-status.time-status = p-time-status
     2144             and buf_edi-status.tbl-name    = p-tbl-name
     2145             and buf_edi-status.doc-code    = p-doc-code no-error .
     2146     if available buf_edi-status  then do:
     2147       assign
     2148       buf_edi-status.des-err     = p-des        .
     2149       buf_edi-status.err-code    = p-err        .
     2150       buf_edi-status.mess-id     = p-mess       .
     2151       buf_edi-status.state       = p-state      .
     2152     end.
     2153   end.
     2154   end procedure.
     2155   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2156   PROCEDURE write-bonus :
     2157   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     2158   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     2159   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     2160   define input  parameter v-bonus as decimal   no-undo .
     2161     do
     2162     on error undo, return error return-value
     2163     :
     2164       find first ub.contract-specif-attr exclusive-lock  where
     2165                  ub.contract-specif-attr.contract-num = p-contract-num  and
     2166                  ub.contract-specif-attr.host-code    = p-host-code     and
     2167                  ub.contract-specif-attr.gds-code     = p-gds-code      and
     2168                  ub.contract-specif-attr.attr-code    = 'bonus':U
     2169                 no-error .
     2170         if not available ub.contract-specif-attr then do:
     2171            create ub.contract-specif-attr .
     2172            assign
     2173                 ub.contract-specif-attr.contract-num = p-contract-num
     2174                 ub.contract-specif-attr.host-code    = p-host-code
     2175                 ub.contract-specif-attr.gds-code     = p-gds-code
     2176                 ub.contract-specif-attr.attr-code    = 'bonus':U
     2177            .
     2178         end.
     2179         ub.contract-specif-attr.attr-value  = string (v-bonus) .
     2180   end.
     2181   END PROCEDURE.
     2182   PROCEDURE read-bonus :
     2183   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     2184   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     2185   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     2186   define output parameter v-bonus as decimal   no-undo .
     2187     do
     2188     on error undo, return error return-value
     2189     :
     2190   find first ub.contract-specif-attr no-lock  where
     2191              ub.contract-specif-attr.contract-num = p-contract-num  and
     2192              ub.contract-specif-attr.host-code    = p-host-code     and
     2193              ub.contract-specif-attr.gds-code     = p-gds-code      and
     2194              ub.contract-specif-attr.attr-code    = 'bonus':U
     2195              no-error .
     2196      if available ub.contract-specif-attr then  v-bonus = decimal (ub.contract-specif-attr.attr-value ) .
     2197                                           else  v-bonus = 0 .
     2198   end.
     2199   END PROCEDURE.
     2200   PROCEDURE write-prc-min :
     2201   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     2202   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     2203   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     2204   define input  parameter v-prc-min        as decimal   no-undo .
     2205     do
     2206     on error undo, return error return-value
     2207     :
     2208       find first ub.contract-specif-attr exclusive-lock  where
     2209                 ub.contract-specif-attr.contract-num = p-contract-num  and
     2210                 ub.contract-specif-attr.host-code    = p-host-code     and
     2211                 ub.contract-specif-attr.gds-code     = p-gds-code      and
     2212                 ub.contract-specif-attr.attr-code    = 'prc-min':U
     2213                 no-error .
     2214         if not available ub.contract-specif-attr then do:
     2215            create ub.contract-specif-attr .
     2216            assign
     2217                 ub.contract-specif-attr.contract-num = p-contract-num
     2218                 ub.contract-specif-attr.host-code    = p-host-code
     2219                 ub.contract-specif-attr.gds-code     = p-gds-code
     2220                 ub.contract-specif-attr.attr-code    = 'prc-min':U
     2221                 ub.contract-specif-attr.attr-value  = string (v-prc-min)
     2222            .
     2223         end.
     2224         else do:
     2225            ub.contract-specif-attr.attr-value  = string (v-prc-min) .
     2226         end.
     2227       find first ub.contract-specif exclusive-lock where
     2228           ub.contract-specif.contract-num = p-contract-num and
     2229           ub.contract-specif.host-code    = p-host-code    and
     2230           ub.contract-specif.gds-code     = p-gds-code.
     2231           ub.contract-specif.whole-send-news  = ub.contract-specif.whole-send-news + 1.
     2232   end.
     2233   END PROCEDURE.
     2234   PROCEDURE read-prc-min :
     2235   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     2236   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     2237   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     2238   define output parameter v-prc-min as decimal   no-undo .
     2239     do
     2240     on error undo, return error return-value
     2241     :
     2242   find first ub.contract-specif-attr no-lock  where
     2243              ub.contract-specif-attr.contract-num = p-contract-num  and
     2244              ub.contract-specif-attr.host-code    = p-host-code     and
     2245              ub.contract-specif-attr.gds-code     = p-gds-code      and
     2246              ub.contract-specif-attr.attr-code    = 'prc-min':U
     2247              no-error .
     2248      if available ub.contract-specif-attr then  v-prc-min = decimal (ub.contract-specif-attr.attr-value ) .
     2249                                           else  v-prc-min = 0 .
     2250   end.
     2251   END PROCEDURE.
     2252   PROCEDURE write-retro-bonus :
     2253   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     2254   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     2255   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     2256   define input  parameter v-retro-bonus as character   no-undo .
     2257     do
     2258     on error undo, return error return-value
     2259     :
     2260       find first ub.contract-specif-attr exclusive-lock  where
     2261                 ub.contract-specif-attr.contract-num = p-contract-num  and
     2262                 ub.contract-specif-attr.host-code    = p-host-code     and
     2263                 ub.contract-specif-attr.gds-code     = p-gds-code      and
     2264                 ub.contract-specif-attr.attr-code    = "retro-bonus"
     2265                 no-error .
     2266         if not available ub.contract-specif-attr then do:
     2267            create ub.contract-specif-attr .
     2268            assign
     2269                 ub.contract-specif-attr.contract-num = p-contract-num
     2270                 ub.contract-specif-attr.host-code    = p-host-code
     2271                 ub.contract-specif-attr.gds-code     = p-gds-code
     2272                 ub.contract-specif-attr.attr-code    = "retro-bonus"
     2273            .
     2274            ub.contract-specif-attr.attr-value  = v-retro-bonus no-error.
     2275            if error-status:error then
     2276               message "Превышен допустимый объем информации о ретро-бонусах. Удалите исторические или неактуальны периоды" view-as alert-box error.
     2277         end.
     2278         else do:
     2279            ub.contract-specif-attr.attr-value  = v-retro-bonus no-error.
     2280            if error-status:error then
     2281               message "Превышен допустимый объем информации о ретро-бонусах. Удалите исторические или неактуальны периоды" view-as alert-box error.
     2282         end.
     2283       find first ub.contract-specif exclusive-lock where
     2284           ub.contract-specif.contract-num = p-contract-num and
     2285           ub.contract-specif.host-code    = p-host-code    and
     2286           ub.contract-specif.gds-code     = p-gds-code.
     2287           ub.contract-specif.whole-send-news  = ub.contract-specif.whole-send-news + 1.
     2288   end.
     2289   END PROCEDURE.
     2290   PROCEDURE read-retro-bonus :
     2291   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     2292   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     2293   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     2294   define output parameter v-retro-bonus as character   no-undo .
     2295     do
     2296     on error undo, return error return-value
     2297     :
     2298   find first ub.contract-specif-attr no-lock  where
     2299              ub.contract-specif-attr.contract-num = p-contract-num  and
     2300              ub.contract-specif-attr.host-code    = p-host-code     and
     2301              ub.contract-specif-attr.gds-code     = p-gds-code      and
     2302              ub.contract-specif-attr.attr-code    = "retro-bonus"
     2303              no-error .
     2304      if available ub.contract-specif-attr then  v-retro-bonus = ub.contract-specif-attr.attr-value  .
     2305                                           else  v-retro-bonus = "" .
