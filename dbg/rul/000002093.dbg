     1016       assign
     1017       temp-nws-outline.charkeY_one = p-charkey_one
     1018       temp-nws-outline.charkeY_two = p-charkey_two
     1019       temp-nws-outline.charkeY_three = p-charkey_three
     1020       temp-nws-outline.key#_one = p-key#_one
     1021       temp-nws-outline.key#_two = p-key#_two
     1022       temp-nws-outline.key#_three = p-key#_three
     1023       temp-nws-outline.no-id = v-no-id
     1024       temp-nws-outline.outline-type = p-outline-type
     1025       .
     1026                                   run add-dump in p-cmd-proc-handle                                                                           (input p-cmd-code                                                                                         ,input 'nws-outline':U                                                                                          ,input '+update'                                                                                         ,input (buffer temp-nws-outline:handle)                                                                                    ,input ''                                                                                         ,output v-rec-ord                                                                                         ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                     delete procedure p-cmd-proc-handle .                                                                        undo , return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'nws-outline':U                                                                                                ,p-cmd-code                                                                                               ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
     1027       run  create-smart-route in this-procedure (
     1028                                                   input ('nws-outline':U + chr(4) + string(temp-nws-outline.no-id))
     1029                                                  ,input -1).
     1030       run create-smart-route-link in this-procedure (
     1031                                                      input 'nws-outline':U
     1032                                                     ,input (buffer temp-nws-outline:handle)
     1033                                                     ,input ('nws-outline':U + chr(4) + string(temp-nws-outline.no-id))
     1034                                                     ,input v-rec-ord
     1035                                                     ,input no
     1036                                                     ).
     1037     end.
     1038   end procedure.
     1039   procedure create-no-route :
     1040   define input parameter p-rec-ord as integer no-undo .
     1041   define input parameter p-db-num as integer no-undo .
     1042   define buffer buf_temp-no-route for temp-no-route.
     1043   do
     1044   on error undo, return error
     1045   :
     1046      find first buf_temp-no-route where
     1047                 buf_temp-no-route.rec-ord = p-rec-ord
     1048              and buf_temp-no-route.db-num = p-db-num no-error .
     1049      if not available buf_temp-no-route then do:
     1050        create buf_temp-no-route.
     1051        assign
     1052        buf_temp-no-route.rec-ord = p-rec-ord
     1053        buf_temp-no-route.db-num = p-db-num
     1054        .
     1055      end.
     1056   end.
     1057   end procedure.
     1058   procedure clear-from-rec-ord :
     1059   define input parameter p-rec-ord as integer no-undo .
     1060   define buffer buf_temp-no-route for temp-no-route.
     1061   define buffer buf_temp-smart-link for temp-smart-link.
     1062   do
     1063   on error undo, return error
     1064   :
     1065   for each buf_temp-no-route where
     1066           buf_temp-no-route.rec-ord > p-rec-ord:
     1067     delete buf_temp-no-route.
     1068   end.
     1069   for each buf_temp-smart-link where
     1070           buf_temp-smart-link.rec-ord > p-rec-ord:
     1071      delete buf_temp-smart-link.
     1072   end.
     1073   end.
     1074   end procedure.
