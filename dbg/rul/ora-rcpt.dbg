     1724             (input p-esys-cmd-code
     1725             ) no-error.
     1726         if error-status :error
     1727         then do:
     1728            delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при удалении команды с кодом &1&2&3&2&4"
     1729                                                              , p-cmd-code
     1730                                                              , chr(10)
     1731                                                              , error-status:get-message(1)
     1732                                                              , return-value
     1733                                                              )).
     1734            return no .
     1735         end.
     1736         delete procedure p-esys-cmd-proc-handle no-error.
     1737         return yes.
     1738      end.
     1739      else do:
     1740         delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при удалении команды с кодом &1&2&3&2&4"
     1741                                                       , p-cmd-code
     1742                                                       , chr(10)
     1743                                                       , error-status:get-message(1)
     1744                                                       , return-value
     1745                                                       )).
     1746         return no .
     1747      end.
     1748   end.
     1749   define temp-table receipt no-undo
     1750   field exch_file_name as character
     1751   field exch_file_date as character
     1752   field file_proc_date as character
     1753   field error as character
     1754   field prot_file_name as character
     1755   index pi is unique primary
     1756   exch_file_name
     1757   .
     1758   define temp-table ne-receipt no-undo
     1759   field exch_file_name as character
     1760   field exch_file_date as character
     1761   field file_proc_date as character
     1762   index pi is unique primary
     1763   exch_file_name
     1764   .
     1765   FUNCTION ora-rcpt_get-rcpt-name returns character ( input p-file-name as character):
     1766   define variable v-file-name as character no-undo .
     1767   assign
     1768   v-file-name = substitute("&1-&2_&3"
     1769                             ,entry(2, entry(1, p-file-name, "_"), "-")
     1770                             ,entry(1, entry(1, p-file-name, "_"), "-")
     1771                             ,entry(2, p-file-name, "_")) no-error.
     1772   if error-status:error then v-file-name = p-file-name.
     1773   return v-file-name.
     1774   END FUNCTION.
     1775   define variable p-xsd-file as character no-undo .
     1776   define variable v-last-error-message as character no-undo .
     1777   define variable v-es as logical no-undo .
     1778   define variable v-esm as character no-undo .
     1779   define variable v-rv as character no-undo .
     1780   define variable v-esys-cmd-proc-handle as handle no-undo .
     1781   define variable v-esys-cmd-code as integer no-undo .
     1782   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1783   procedure set-error :
     1784   define input parameter p-mess as character no-undo .
     1785     do
     1786     on error undo, return error
     1787     :
     1788        assign
     1789        v-last-error-message = p-mess.
     1790     end.
     1791   end procedure.
     1792   define variable ExpData1 as class Route-data_ no-undo .
     1793   ExpData1 = new Route-data_( input parparentproc, input p-parent-handle, input p-log-handle, input this-procedure:handle) .
     1794   run proc-main in this-procedure no-error .
     1795   if error-status:error then do:
     1796     v-esm = error-status :get-message (1).
     1797     v-es = error-status:error .
     1798     v-rv = return-value .
     1799   end.
     1800   run garbcoll_clear in this-procedure .
     1801   procedure proc-main :
     1802   define variable v-custom-pack-name as character no-undo .
     1803   DEFINE VARIABLE v-today as date no-undo .
     1804   DEFINE VARIABLE v-time as integer no-undo .
     1805   define variable v-ii as integer no-undo .
     1806   define variable v-log-file-name as character no-undo .
     1807   main-block:
     1808   do
     1809   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1810   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1811   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1812   :
     1813     run cur-time in this-procedure ( output v-today, output v-time).
     1814     v-custom-pack-name = ora-rcpt_get-rcpt-name(entry((num-entries(p-file-name, ".") - 1), p-file-name, ".")).
     1815     if p-error-type = '' then do:
     1816       p-xsd-file = "exe/ornercpt.xsd".
     1817       create ne-receipt.
     1818       assign
     1819       ne-receipt.exch_file_name = p-file-name
     1820       ne-receipt.exch_file_date = p-file-date-time
     1821       ne-receipt.file_proc_date = string(datetime(v-today, mtime), "99/99/9999 HH:MM:SS")
     1822       .
     1823     end.
     1824     else do:
     1825       assign
     1826       v-log-file-name = replace(p-log-file-name, chr(47), chr(92))
     1827       p-xsd-file = "exe/ora-rcpt.xsd"
     1828       no-error.
     1829       if error-status:error then do:
     1830         undo main-block, return error substitute("Не удалось преобразовать имена файлов:&1&2"
     1831                                                  , chr(10)
     1832                                                  , error-status:get-message(1) ) .
     1833       end.
     1834       create receipt.
     1835       assign
     1836       receipt.exch_file_name = p-file-name
     1837       receipt.exch_file_date = p-file-date-time
     1838       receipt.file_proc_date = string(datetime(v-today, mtime), "99/99/9999 HH:MM:SS")
     1839       receipt.error  = p-error-type
     1840       v-ii = num-entries(v-log-file-name, chr(92))
     1841       receipt.prot_file_name = entry(v-ii, v-log-file-name, chr(92))
     1842       .
     1843     end.
     1844     IF  ExpData1:route-data_read-xmlschema( INPUT p-xsd-file) = false  THEN do:
     1845       undo main-block, return error v-last-error-message .
     1846     end.
     1847     IF  context_begin-esys-command( input string(p-esys-id), input-output v-esys-cmd-proc-handle, output v-esys-cmd-code) = false  THEN do:
     1848       undo main-block, return error v-last-error-message .
     1849     end.
     1850     ExpData1:route-data_create-record( INPUT "receipt") .
     1851     if p-error-type = '' then do:
     1852       ExpData1:route-data_copy-record( INPUT "receipt", INPUT  (buffer ne-receipt:handle) ) .
     1853     end.
     1854     else do:
     1855       ExpData1:route-data_copy-record( INPUT "receipt", INPUT  (buffer receipt:handle) ) .
     1856     end.
     1857     IF ExpData1:esys-add-dump( INPUT "receipt", INPUT v-esys-cmd-proc-handle, INPUT v-esys-cmd-code, '+update') = false  THEN do:
     1858       undo main-block, return error v-last-error-message .
     1859     end.
     1860       ExpData1:Route-data_clear-data ( ) .
     1861     IF  context_set-custom-esys-pck-name(  input v-esys-cmd-proc-handle, input v-esys-cmd-code, input v-custom-pack-name + '.ACK') = false  THEN do:
     1862       undo main-block, return error v-last-error-message .
     1863     end.
     1864     IF  context_send-esys-command( input string(p-esys-id), input v-esys-cmd-proc-handle, input v-esys-cmd-code, input g#userid) = false  THEN do:
     1865       undo main-block, return error v-last-error-message .
     1866     end.
     1867   end.
     1868   end procedure.
