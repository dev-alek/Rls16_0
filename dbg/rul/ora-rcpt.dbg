     1715   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1716   function context_delete-command return logical
     1717   (
     1718       input p-esys-cmd-proc-handle as handle
     1719      ,input p-esys-cmd-code as integer
     1720   ):
