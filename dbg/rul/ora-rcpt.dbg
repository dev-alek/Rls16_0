     1692                                                                ,input p-custom-pck-name) no-error .
     1693         if error-status :error
     1694         then do:
     1695            delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при установке спец имени пакета для отсылки во внешнюю систему команды с кодом &1&2&3&2&4"
     1696                                                        , p-cmd-code
     1697                                                        , chr(10)
     1698                                                        , error-status:get-message(1)
     1699                                                        , return-value
     1700                                                        )).
     1701            return no .
     1702         end.
     1703         return yes.
     1704      end.
     1705      else do:
     1706         delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при установке спец имени пакета для отсылки во внешнюю систему команды с кодом &1&2&3&2&4"
     1707                                                       , p-cmd-code
     1708                                                       , chr(10)
     1709                                                       , error-status:get-message(1)
     1710                                                       , return-value
