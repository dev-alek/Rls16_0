        1   using Ibs.Th.Rul.Route-data_.
        2   block-level on error undo, throw.
        3   define input parameter parparentproc as widget-handle no-undo .
        4   define input parameter p-parent-handle as handle no-undo .
        5   define input parameter p-log-handle  as handle no-undo .
        6   define input parameter p-cmd-proc-handle as handle no-undo .
        7   define input parameter p-cmd-code  as integer no-undo .
        8   define input parameter p-esys-id as integer no-undo .
        9   define input parameter p-pack-num as integer no-undo .
       10   define input parameter p-file-name as character no-undo .
       11   define input parameter p-file-date-time as character no-undo .
       12   define input parameter p-log-file-name as character no-undo .
       13   define input parameter p-error-type as character no-undo .
       14   define variable vss-revision    as character no-undo init "$Revision$":U .
       15   define variable vss-author      as character no-undo init "$Author$":U .
       16   define variable vss-date        as character no-undo init "$Date$":U .
       17   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       18   define variable vss-archive     as character no-undo init "$Archive$":U .
       19   define variable vss-description as character no-undo init "Создание кваитанции для ВС типа Oracle Retail".
       20   procedure vss-get-info :
       21     define output parameter p-vss-revision    like vss-revision    no-undo .
       22     define output parameter p-vss-author      like vss-author      no-undo .
       23     define output parameter p-vss-date        like vss-date        no-undo .
       24     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       25     define output parameter p-vss-archive     like vss-archive     no-undo .
       26     define output parameter p-vss-description like vss-description no-undo .
       27     assign
       28       p-vss-revision    = vss-revision
       29       p-vss-author      = vss-author
       30       p-vss-date        = vss-date
       31       p-vss-workfile    = vss-workfile
       32       p-vss-archive     = vss-archive
       33       p-vss-description = vss-description
       34     .
       35   end procedure.
       36   procedure vss-get-parameters :
       37     define output parameter p-vss-parameters as character no-undo .
       38   end procedure.
       39   define new global shared variable g#vssrevis-logger as handle    no-undo .
       40   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       41   define variable v-vssrevis-logger                   as handle    no-undo .
       42   procedure vss-logevent :
       43     define input  parameter p-extra-paramters as character no-undo .
       44     define variable v-vssrevis-parameters as character no-undo .
       45     do
       46     on error undo, return error return-value
       47     :
       48       if  valid-handle(v-vssrevis-logger)
       49       and v-vssrevis-logger :get-signature("logevent") <> ""
       50       then do:
       51         run vss-get-parameters in this-procedure
       52           (output v-vssrevis-parameters
       53           ).
       54         run logevent in v-vssrevis-logger
       55           (input vss-workfile
       56           ,input vss-revision
       57           ,input v-vssrevis-parameters
       58           ,input p-extra-paramters
       59           ).
       60       end.
       61     end.
       62   end procedure.
       63   assign
       64     v-vssrevis-logger = g#vssrevis-logger
       65   .
       66   if  valid-handle(v-vssrevis-logger)
       67   and v-vssrevis-logger :get-signature("logevent") <> ""
       68   then do:
       69     assign
       70       v-vssrevis-logevent = true
       71     .
       72     run vss-logevent in this-procedure (input vss-description) .
       73   end.
       74   define new global shared variable g#language as character no-undo .
       75   if g#language <> '' and g#language <> 'rus':U then do:
       76     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       77   end.
       78   define new global shared variable g#library  as handle no-undo .
       79   define new global shared variable g#library2 as handle no-undo .
       80   define   shared variable g#auto as logical no-undo.
       81   define   shared variable g#news as logical no-undo.
       82   define   shared variable g#oxml as logical no-undo.
       83   define   shared variable g#esys as logical no-undo.
       84   define   shared variable g#news-source-db as integer no-undo.
       85   define   shared variable g#esys-source-esys as integer no-undo.
       86   define   shared variable g#db-num as integer   no-undo .
       87   define   shared variable g#userid as character no-undo .
       88   define   shared variable g#passwd as character no-undo .
       89   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       90   define  variable garbcoll_ii as integer no-undo .
       91   define  temp-table temp-gc no-undo
       92   field ii as integer
       93   field obj-r as handle
       94   field cn as character
       95   index pi is unique primary
       96   ii
       97   index icn
       98   cn.
       99   procedure garbcoll_create-gc-entry :
      100   define input parameter p-cn as character no-undo .
      101   define input parameter p-obj-r as handle no-undo .
      102     do
      103     on error undo, return error
      104     :
      105       create temp-gc.
      106       assign
      107       temp-gc.ii = garbcoll_ii
      108       garbcoll_ii = garbcoll_ii + 1
      109       temp-gc.cn = p-cn
      110       temp-gc.obj-r = p-obj-r
      111       .
      112     end.
      113   end procedure.
      114   procedure garbcoll_clear :
      115     do
      116     on error undo, return error
      117     :
      118       for each temp-gc:
      119         delete object temp-gc.obj-r.
      120         delete temp-gc.
      121       end.
      122     end.
      123   end procedure.
      124   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      125   procedure cur-time :
      126      define output parameter p-today as date      no-undo .
      127      define output parameter p-time  as integer   no-undo .
      128     do
      129     on error undo, return error
      130     :
      131       define variable v-date1 as date      no-undo .
      132       define variable v-date2 as date      no-undo .
      133       define variable v-time  as integer   no-undo .
      134       assign
      135         v-date1 = today
      136         v-time  = time
      137         v-date2 = today
      138       .
      139       if v-date1 <> v-date2
      140       then do:
      141         assign
      142           v-date1 = today
      143           v-time  = v-time
      144         .
      145       end.
      146       assign
      147         p-today = v-date1
      148         p-time  = v-time
      149       .
      150     end.
      151   end.
      152   function cur-time-date returns character
      153   :
      154     return string(today, '99/99/9999':U) .
      155   end.
      156   function cur-time-mjd returns decimal
      157   :
      158     define variable v-date as date      no-undo .
      159     define variable v-time as integer   no-undo .
      160     run cur-time in this-procedure
      161       (output v-date
      162       ,output v-time
      163       ) .
      164     return integer(v-date) - 2400002 + (v-time / 86400) .
      165   end.
      166   function cur-time-get-ending-index returns integer
      167   (input p-number as integer
      168   )
      169   :
      170     if p-number < 0
      171     or p-number = ?
      172     then do:
      173       return 1 .
      174     end.
      175     define variable v-rest as integer   no-undo .
      176     assign
      177       p-number = p-number modulo 100
      178     .
      179     if p-number < 20
      180     then do:
      181       assign
      182         v-rest = p-number
      183       .
      184     end.
      185     else do:
      186       assign
      187         v-rest = p-number modulo 10
      188       .
      189     end.
      190     case v-rest :
      191       when 1
      192       then do:
      193         return 2 .
      194       end.
      195       when 2 or
      196       when 3 or
      197       when 4
      198       then do:
      199         return 3 .
      200       end.
      201       otherwise do:
      202         return 1 .
      203       end.
      204     end case .
      205   end.
      206   procedure cur-time-mjd-to-date :
      207      define input  parameter i-mjd-diff as decimal no-undo.
      208      define output parameter o-Date     as date    no-undo.
      209      define output parameter o-Time     as integer no-undo.
      210      define variable v-day-number as integer   no-undo .
      211      if    i-mjd-diff < 0
      212         or i-mjd-diff = ?
      213      then do:
      214         return "?" .
      215      end.
      216      assign
      217         v-day-number = truncate(i-mjd-diff,0).
      218         o-Date = date(v-day-number + 2400002).
      219         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      220     .
      221   end.
      222   function cur-time-mjd-to-string returns character
      223   (input p-mjd-diff as decimal
      224   )
      225   :
      226     define variable v-day-number as integer   no-undo .
      227     define variable v-seconds    as integer   no-undo .
      228     define variable v-hour       as integer   no-undo .
      229     define variable v-min        as integer   no-undo .
      230     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      231     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      232     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      233     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      234     if p-mjd-diff < 0
      235     or p-mjd-diff = ?
      236     then do:
      237       return "?" .
      238     end.
      239     assign
      240       v-day-number = integer(truncate(p-mjd-diff,0))
      241       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      242     .
      243     if v-seconds > 86400
      244     then do:
      245       assign
      246         v-seconds = 86400 - 1
      247       .
      248     end.
      249     if v-seconds < 0
      250     then do:
      251       assign
      252         v-seconds = 0
      253       .
      254     end.
      255     assign
      256       v-hour = truncate(v-seconds / 3600, 0)
      257     .
      258     assign
      259       v-seconds = v-seconds modulo 3600
      260     .
      261     assign
      262       v-min = truncate(v-seconds / 60, 0)
      263     .
      264     assign
      265       v-seconds = v-seconds modulo 60
      266     .
      267     return
      268         (if v-day-number <> 0
      269           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      270           else ""
      271         )
      272       + (if v-day-number <> 0 or v-hour <> 0
      273           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      274           else ""
      275         )
      276       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      277           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      278           else ""
      279         )
      280       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      281       .
      282   end.
      283   function cur-time-string returns character
      284   :
      285     define variable v-date as date      no-undo .
      286     define variable v-time as integer   no-undo .
      287     run cur-time in this-procedure
      288       (output v-date
      289       ,output v-time
      290       ) .
      291     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      292   end.
      293   function cur-time-string-sec returns character
      294   :
      295     define variable v-date as date      no-undo .
      296     define variable v-time as integer   no-undo .
      297     run cur-time in this-procedure
      298       (output v-date
      299       ,output v-time
      300       ) .
      301     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      302   end.
      303   function cur-time-custom  returns character
      304   (input p-prefix as character
      305   ,input p-date-format as character
      306   ,input p-delimiter as character
      307   ,input p-time-format as character
      308   ,input p-suffix as character
      309   )
      310   :
      311     define variable v-date as date      no-undo .
      312     define variable v-time as integer   no-undo .
      313     run cur-time in this-procedure
      314       (output v-date
      315       ,output v-time
      316       ) .
      317     return
      318       p-prefix
      319       + string(v-date, p-date-format)
      320       + p-delimiter
      321       + string(v-time, p-time-format)
      322       + p-suffix
      323       .
      324   end.
      325   function cur-time-print  returns character
      326   :
      327     define variable v-date as date      no-undo .
      328     define variable v-time as integer   no-undo .
      329     run cur-time in this-procedure
      330       (output v-date
      331       ,output v-time
      332       ) .
      333     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      334   end.
      335   function cur-time-datetime returns datetime
      336   :
      337     define variable v-char as character no-undo .
      338     define variable v-datetime as datetime no-undo .
      339     v-char = cur-time-string().
      340     v-datetime = datetime(v-char).
      341     return  v-datetime.
      342   end.
      343   function cur-time-string-msec returns character
      344   :
      345     define variable v-date as datetime  no-undo .
      346     v-date = now.
      347     return string(v-date) .
      348   end.
      349   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      350   define new global shared variable g#lib-nws as handle no-undo .
      351   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      352   define new shared temp-table temp-hist-nws-option no-undo
      353   like ub.hist-nws-option
      354   .
      355   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      356   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      357   define variable tempcxml_v-num_ as integer no-undo .
      358   define  temp-table temp-xml-tables no-undo
      359   field order as integer
      360   field tbl-name as character
      361   field tbl-handle_ as handle
      362   field table-handle_ as handle
      363   field uniq-gate-rec as character
      364   field gate-name as character
      365   field gate-handle_ as handle
      366   field is-parent as logical
      367   index pi is unique primary
      368   uniq-gate-rec
      369   tbl-name
      370   index iorder
      371   order
      372   index gr
      373   uniq-gate-rec
      374   index gh
      375   gate-handle_
      376   index iparent
      377   is-parent
      378   .
      379   define  temp-table temp-xml-records no-undo
      380   field tbl-name as character
      381   field uniq-key-rec as character
      382   index pi is unique primary
      383   tbl-name
      384   uniq-key-rec
      385   .
      386   def var vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      387   procedure gen-key-rec :
      388     define input  parameter p-tbl-name    as character no-undo.
      389     define input  parameter p-bh_tbl-name as handle    no-undo.
      390     define output parameter p-key-rec     as character no-undo.
      391     do
      392     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      393     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      394     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      395     :
      396       define variable fh               as handle    no-undo .
      397       define variable v-ok             as logical   no-undo .
      398       define variable v-inform         as character no-undo .
      399       define variable v-ind            as integer   no-undo .
      400       define variable v-idx-field-qnty as integer   no-undo .
      401       if p-tbl-name = ?
      402         or p-tbl-name = "":U
      403       then do:
      404         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info6 ).
      405       end.
      406       if not p-bh_tbl-name:available then do:
      407         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info6, p-tbl-name ).
      408       end.
      409       assign
      410         p-key-rec = p-tbl-name
      411         v-inform  = p-bh_tbl-name:index-information(1)
      412         v-ind     = 2
      413       .
      414       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      415       on error undo, return error
      416       :
      417         assign
      418           v-inform = p-bh_tbl-name:index-information( v-ind )
      419           v-ind    = v-ind + 1
      420         .
      421       end.
      422       if v-inform = ?
      423         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      424         or entry( 3, v-inform, ",":U ) <> "1":U
      425       then do:
      426         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info6, p-tbl-name ).
      427       end.
      428       else do:
      429         assign
      430           v-idx-field-qnty = num-entries( v-inform ) - 4
      431         .
      432         if v-idx-field-qnty < 2 then do:
      433           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info6, v-inform, p-tbl-name ).
      434         end.
      435         do v-ind = 1 to v-idx-field-qnty by 2
      436         on error undo, return error
      437         :
      438           assign
      439             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      440             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      441           .
      442         end.
      443       end.
      444       if p-key-rec = ? then do:
      445         assign
      446           p-key-rec = "":U
      447         .
      448         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info6, p-tbl-name ).
      449       end.
      450     end.
      451     return.
      452   end procedure.
      453   procedure gen-where-keyr-tab :
      454     define input  parameter i-tableSerach as character no-undo.
      455     define input  parameter i-tablekey   as character  no-undo.
      456     define input  parameter p-key-rec    as character  no-undo.
      457     define input  parameter p-key-handle as handle     no-undo .
      458     define input  parameter p-db-name    as character  no-undo .
      459     define input  parameter p-tt-handle  as handle     no-undo .
      460     define output parameter o-Where      as character  no-undo.
      461     do
      462     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      463     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      464     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      465     :
      466       define variable v-full-tbl-name  as character no-undo .
      467       define variable bh_tbl-name      as handle    no-undo .
      468       define variable fh_key           as handle    no-undo .
      469       define variable fh_search        as handle    no-undo .
      470       define variable v-field-num      as integer   no-undo .
      471       define variable v-count-fld      as integer   no-undo .
      472       define variable v-inform         as character no-undo .
      473       define variable v-ind            as integer   no-undo .
      474       define variable v-idx-field-qnty as integer   no-undo .
      475       define variable v-field-name     as character no-undo .
      476       define variable v-field-val      as character no-undo .
      477       define variable v-word-link      as character no-undo .
      478       define variable vTable           as character no-undo.
      479       define variable bh_tbl-key       as handle    no-undo .
      480       assign
      481         p-key-rec = trim( p-key-rec )
      482       .
      483       if p-key-handle <> ? then do:
      484         if not valid-handle(p-key-handle)
      485            or p-key-handle:type <> "buffer"
      486         then do:
      487           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info6 ).
      488         end.
      489         if num-entries( p-key-rec, chr(3) ) > 1
      490           or p-key-rec = ?
      491           or p-key-rec = "":U
      492         then do:
      493           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info6, p-key-rec ).
      494         end.
      495       end.
      496       else do:
      497         if p-key-rec = ?
      498           or p-key-rec = "":U
      499         then do:
      500           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info6 ).
      501         end.
      502       end.
      503       assign
      504         vTable = entry( 1 , p-key-rec, chr(3) )
      505       .
      506       if p-tt-handle <> ?
      507         and ( not valid-handle(p-tt-handle)
      508               or p-tt-handle:type <> "buffer"
      509             )
      510       then do:
      511         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info6, vTable, chr(10) ).
      512       end.
      513       if p-tt-handle = ? then do:
      514         assign
      515           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      516         .
      517         create buffer bh_tbl-name for table v-full-tbl-name .
      518       end.
      519       else do:
      520         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      521       end.
      522       assign
      523         v-inform = bh_tbl-name:index-information(1)
      524         v-ind    = 2
      525       .
      526       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      527       on error undo, return error
      528       :
      529         assign
      530           v-inform = bh_tbl-name:index-information( v-ind )
      531           v-ind    = v-ind + 1
      532         .
      533       end.
      534       if v-inform = ?
      535         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      536         or entry( 3, v-inform, ",":U ) <> "1":U
      537       then do:
      538         delete object bh_tbl-name no-error.
      539         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info6, vTable ).
      540       end.
      541       assign
      542         v-idx-field-qnty = num-entries( v-inform ) - 4
      543       .
      544       if v-idx-field-qnty < 2 then do:
      545         delete object bh_tbl-name no-error.
      546         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info6, v-inform, vTable ).
      547       end.
      548       assign
      549         o-where     = "where":U
      550         v-word-link = "":U
      551         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      552         v-count-fld = 0
      553       .
      554       if i-tablekey ne "" and i-tablekey ne ?
      555       then do:
      556         assign
      557           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      558         .
      559         create buffer bh_tbl-key for table v-full-tbl-name .
      560       end.
      561       if i-tableSerach ne "" and i-tableSerach ne ?
      562       then do:
      563         delete object bh_tbl-name no-error.
      564         assign
      565           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      566         .
      567         create buffer bh_tbl-name for table v-full-tbl-name .
      568       end.
      569       block_where:
      570       do v-ind = 1 to v-idx-field-qnty by 2
      571       on error undo, return error
      572       :
      573         assign
      574           v-count-fld = v-count-fld + 1
      575         .
      576         if p-key-handle = ?
      577           and v-count-fld > v-field-num
      578         then do:
      579           leave block_where.
      580         end.
      581         define variable VfieldKeyTable as handle no-undo.
      582         assign
      583           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      584           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      585         .
      586         if     bh_tbl-key ne ?
      587         then do:
      588            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      589            if VfieldKeyTable eq ?
      590            then next block_where.
      591         end.
      592         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      593         then
      594            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      595         else
      596            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      597         if p-key-handle = ? then do:
      598           assign
      599             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      600           .
      601         end.
      602         else do:
      603           assign
      604             fh_key = p-key-handle:buffer-field( v-field-name )
      605           .
      606           if fh_key = ?
      607             or not valid-handle( fh_key )
      608           then do:
      609             delete object bh_tbl-name.
      610             if     bh_tbl-key ne ?
      611             then
      612                delete object bh_tbl-key.
      613             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info6, p-key-handle:name, v-field-name ).
      614           end.
      615           assign
      616             v-field-val = fh_key:buffer-value
      617           .
      618         end.
      619         if fh_search:data-type ="character":U then do:
      620           assign
      621             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      622             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      623             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      624             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      625             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      626             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      627             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      628             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      629             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      630             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      631             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      632             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      633             v-field-val = substitute( '"&1"', v-field-val )
      634           .
      635         end.
      636         assign
      637           o-where = substitute( "&1 &2", o-where, v-field-val )
      638         .
      639         if v-word-link = "":U then do:
      640           assign
      641             v-word-link = "and":U
      642           .
      643         end.
      644       end.
      645       delete object bh_tbl-name.
      646       if     bh_tbl-key ne ?
      647       then
      648          delete object bh_tbl-key.
      649       if p-key-handle = ?
      650         and v-count-fld <> v-field-num
      651       then do:
      652         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info6, vTable ).
      653       end.
      654     end.
      655   end procedure.
      656   procedure gen-hn-keyr-tab :
      657     define input  parameter i-tableSerach as character no-undo.
      658     define input  parameter i-tablekey   as character no-undo.
      659     define input  parameter p-key-rec    as character no-undo.
      660     define input  parameter p-key-handle as handle    no-undo .
      661     define input  parameter p-db-name    as character no-undo .
      662     define input  parameter p-tt-handle  as handle    no-undo .
      663     define input  parameter p-stts-lock  as integer   no-undo .
      664     define output parameter o-hn         as handle    no-undo.
      665     define variable v-full-tbl-name as character no-undo.
      666     define variable v-where         as character no-undo.
      667     define variable bh_tbl-name     as handle    no-undo.
      668     define variable vTable          as character no-undo.
      669     do
      670     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      671     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      672     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      673         run gen-where-keyr-tab(i-tableSerach,
      674                                i-tablekey,
      675                                p-key-rec,
      676                                p-key-handle,
      677                                p-db-name,
      678                                p-tt-handle,
      679                                output v-where).
      680         if i-tableSerach ne "" and i-tableSerach ne ?
      681         then do:
      682            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      683            create buffer bh_tbl-name for table v-full-tbl-name .
      684         end.
      685         else do:
      686            if p-tt-handle = ? then do:
      687               assign
      688                  vTable = entry( 1 , p-key-rec, chr(3) )
      689               .
      690               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      691               create buffer bh_tbl-name for table v-full-tbl-name .
      692            end.
      693            else do:
      694               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      695            end.
      696         end.
      697         if p-tt-handle = ? then do:
      698            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      699         end.
      700         else do:
      701            bh_tbl-name:find-first( v-where ) no-error .
      702         end.
      703         o-hn = bh_tbl-name.
      704      end.
      705   end procedure.
      706   procedure gen-hn-keyr :
      707     define input  parameter p-key-rec    as character no-undo.
      708     define input  parameter p-key-handle as handle    no-undo .
      709     define input  parameter p-db-name    as character no-undo .
      710     define input  parameter p-tt-handle  as handle    no-undo .
      711     define input  parameter p-stts-lock  as integer   no-undo .
      712     define output parameter o-hn         as handle    no-undo.
      713     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      714   end.
      715   procedure gen-row-keyr :
      716     define input  parameter p-key-rec    as character no-undo.
      717     define input  parameter p-key-handle as handle    no-undo .
      718     define input  parameter p-db-name    as character no-undo .
      719     define input  parameter p-tt-handle  as handle    no-undo .
      720     define input  parameter p-stts-lock  as integer   no-undo .
      721     define output parameter p-tbl-row    as rowid     no-undo.
      722     define output parameter p-tbl-name   as character no-undo.
      723     define variable vHn as handle no-undo.
      724       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      725       p-tbl-row = if vHn:available then vHn:rowid else ?.
      726       p-tbl-name =  vHn:table.
      727       delete object vHn no-error.
      728     if p-tbl-row = ? then do:
      729       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info6, p-tbl-name, p-key-rec ).
      730     end.
      731     else do:
      732       return.
      733     end.
      734   end procedure.
      735   procedure gen-key-fv :
      736     define input  parameter p-key-rec    as character no-undo .
      737     define output parameter p-field-list as character no-undo .
      738     define output parameter p-value-list as character no-undo.
      739     do
      740     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      741     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      742     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      743     :
      744       define variable v-full-tbl-name  as character no-undo .
      745       define variable bh_tbl-name      as handle    no-undo .
      746       define variable v-tbl-name       as character no-undo .
      747       define variable v-field-num      as integer   no-undo .
      748       define variable v-count-fld      as integer   no-undo .
      749       define variable v-inform         as character no-undo .
      750       define variable v-ind            as integer   no-undo .
      751       define variable v-idx-field-qnty as integer   no-undo .
      752       define variable v-delim-key      as character no-undo .
      753       if p-key-rec = ?
      754         or p-key-rec = "":U
      755       then do:
      756         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info6 ).
      757       end.
      758       assign
      759         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      760         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      761       .
      762       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      763       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info6 ).
      764       assign
      765         v-inform = bh_tbl-name:index-information(1)
      766         v-ind    = 2
      767       .
      768       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      769       on error undo, return error
      770       :
      771         assign
      772           v-inform = bh_tbl-name:index-information( v-ind )
      773           v-ind    = v-ind + 1
      774         .
      775       end.
      776       if v-inform = ?
      777         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      778         or entry( 3, v-inform, ",":U ) <> "1":U
      779       then do:
      780         delete object bh_tbl-name no-error.
      781         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info6, v-tbl-name ).
      782       end.
      783       assign
      784         v-idx-field-qnty = num-entries( v-inform ) - 4
      785       .
      786       if v-idx-field-qnty < 2 then do:
      787         delete object bh_tbl-name no-error.
      788         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info6, v-inform, v-tbl-name ).
      789       end.
      790       assign
      791         p-field-list = "":U
      792         p-value-list = "":U
      793         v-delim-key  = "":U
      794         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      795         v-count-fld  = 0
      796       .
      797       block_where:
      798       do v-ind = 1 to v-idx-field-qnty by 2
      799       on error undo, return error
      800       :
      801         assign
      802           v-count-fld = v-count-fld + 1
      803         .
      804         if v-count-fld > v-field-num then do:
      805           leave block_where.
      806         end.
      807         assign
      808           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      809           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      810         .
      811         if v-ind = 1 then do:
      812           assign
      813             v-delim-key = chr(3)
      814           .
      815         end.
      816       end.
      817       delete object bh_tbl-name.
      818       if v-count-fld <> v-field-num then do:
      819         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info6, v-tbl-name ).
      820       end.
      821     end.
      822   end procedure.
      823   procedure gen-key-field :
      824     define input  parameter p-table      as character no-undo .
      825     define output parameter p-field-list as character no-undo .
      826     do
      827     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      828     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      829     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      830     :
      831       define variable v-full-tbl-name  as character no-undo .
      832       define variable bh_tbl-name      as handle    no-undo .
      833       define variable v-tbl-name       as character no-undo .
      834       define variable v-field-num      as integer   no-undo .
      835       define variable v-count-fld      as integer   no-undo .
      836       define variable v-inform         as character no-undo .
      837       define variable v-ind            as integer   no-undo .
      838       define variable v-idx-field-qnty as integer   no-undo .
      839       define variable v-delim-key      as character no-undo .
      840       if p-table = ?
      841         or p-table = "":U
      842       then do:
      843         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info6 ).
      844       end.
      845       assign
      846         v-tbl-name      = p-table
      847         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      848       .
      849       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      850       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info6 ).
      851       assign
      852         v-inform = bh_tbl-name:index-information(1)
      853         v-ind    = 2
      854       .
      855       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      856       on error undo, return error
      857       :
      858         assign
      859           v-inform = bh_tbl-name:index-information( v-ind )
      860           v-ind    = v-ind + 1
      861         .
      862       end.
      863       if v-inform = ?
      864         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      865         or entry( 3, v-inform, ",":U ) <> "1":U
      866       then do:
      867         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info6, v-tbl-name ).
      868       end.
      869       assign
      870         v-idx-field-qnty = num-entries( v-inform ) - 4
      871       .
      872       if v-idx-field-qnty < 2 then do:
      873         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info6, v-inform, v-tbl-name ).
      874       end.
      875       assign
      876         p-field-list = "":U
      877         v-delim-key  = "":U
      878         v-count-fld  = 0
      879       .
      880       block_where:
      881       do v-ind = 1 to v-idx-field-qnty by 2
      882       on error undo, return error
      883       :
      884         assign
      885           v-count-fld = v-count-fld + 1
      886         .
      887         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      888         if v-ind = 1 then do:
      889           assign
      890             v-delim-key = chr(3)
      891           .
      892         end.
      893       end.
      894       delete object bh_tbl-name.
      895     end.
      896   end procedure.
      897   procedure get-gate-file-name :
      898   define input parameter p-gate-rec as character no-undo .
      899   define output  parameter p-gate-file-name as character no-undo .
      900   define buffer buf_clob-data for ub.clob-data.
      901   define variable v-tbl-row as rowid no-undo .
      902   define variable v-tbl-name as character no-undo .
      903   run gen-row-keyr in this-procedure ( input p-gate-rec
      904                                       ,input ?
      905                                       ,input "ub"
      906                                       ,input ?
      907                                       ,input no-lock
      908                                       ,output v-tbl-row
      909                                       ,output v-tbl-name) no-error.
      910   if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
      911                                                           ,vss-include-info4
      912                                                           ,p-gate-rec).
      913   find first buf_clob-data no-lock where
      914             rowid(buf_clob-data) = v-tbl-row no-error.
      915   if not available buf_clob-data then do:
      916     if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
      917                                                             ,vss-include-info4
      918                                                             ,p-gate-rec).
      919   end.
      920   p-gate-file-name = buf_clob-data.file-name.
      921   end procedure.
      922   procedure get-gate-rec :
      923   define input  parameter p-gate-name as character no-undo .
      924   define output parameter p-gate-rec as character no-undo .
      925   define buffer buf_clob-bind for ub.clob-bind.
      926   define buffer buf_clob-data for ub.clob-data.
      927   main-block:
      928   do
      929   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message (1))
      930   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info4 )
      931   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info4 )
      932   :
      933       find first buf_clob-bind no-lock where
      934                 buf_clob-bind.uniq-key-rec = p-gate-name
      935             and buf_clob-bind.field-name = '':U
      936             and buf_clob-bind.part-num = 1
      937             and buf_clob-bind.resource-type = 'gate':U
      938             no-error.
      939       if not available buf_clob-bind then do:
      940         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
      941                                         , p-gate-name
      942                                         ).
      943       end.
      944       find first buf_clob-data no-lock where
      945                 buf_clob-data.db-num = buf_clob-bind.db-num
      946             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
      947       if not available buf_clob-data then do:
      948         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
      949                                         , buf_clob-bind.db-num
      950                                         , buf_clob-bind.int64-id
      951                                         , p-gate-name
      952                                         ).
      953       end.
      954       run gen-key-rec in this-procedure ( input 'clob-data':U
      955                                 ,input buffer buf_clob-data:handle
      956                                 ,output p-gate-rec).
      957   end.
      958   end procedure.
      959   procedure get-gate-by-name :
      960   define input  parameter p-gate-name as character no-undo .
      961   define output parameter p-gate-rec as character no-undo .
      962   define output parameter p-dsh as handle no-undo .
      963   define input-output  parameter p-xmlh as handle no-undo .
      964   define variable v-ii as integer   no-undo .
      965   define variable glog as logical   no-undo .
      966   define variable v-longchar as longchar no-undo .
      967   define variable v-txmlh as handle no-undo .
      968   define variable v-db-num as integer no-undo .
      969   define variable v-int64-id as int64 no-undo .
      970   define buffer buf_clob-bind for ub.clob-bind.
      971   define buffer buf_clob-data for ub.clob-data.
      972   main-block:
      973   do
      974   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message (1))
      975   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info4 )
      976   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info4 )
      977   :
      978       find first buf_clob-bind no-lock where
      979                 buf_clob-bind.uniq-key-rec = p-gate-name
      980             and buf_clob-bind.field-name = '':U
      981             and buf_clob-bind.part-num = 1
      982             and buf_clob-bind.resource-type = 'gate':U
      983             no-error.
      984       if not available buf_clob-bind then do:
      985         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
      986                                         , p-gate-name
      987                                         ).
      988       end.
      989       find first buf_clob-data no-lock where
      990                 buf_clob-data.db-num = buf_clob-bind.db-num
      991             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
      992       if not available buf_clob-data then do:
      993         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
      994                                         , buf_clob-bind.db-num
      995                                         , buf_clob-bind.int64-id
      996                                         , p-gate-name
      997                                         ).
      998       end.
      999       assign
     1000       v-longchar = buf_clob-data.cdata
     1001       .
     1002       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1003       if error-status :error then do:
     1004         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1005       end.
     1006       create dataset p-dsh .
     1007       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1008                                     , v-longchar
     1009                                     , ?
     1010                                     , ?
     1011                                     , ?
     1012                                     ) no-error.
     1013       v-longchar = '':U.
     1014       if error-status :error
     1015       or not glog
     1016       then do:
     1017         undo, return error substitute("Не удалось прочитать XML-схему &1 из БД:&2&3", p-gate-name, chr(10), error-status:get-message(1) ).
     1018       end.
     1019       if not valid-handle(p-xmlh)
     1020       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1021         create temp-table v-txmlh.
     1022         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1023         v-txmlh:temp-table-prepare("temp-xml-tables").
     1024         p-xmlh = v-txmlh:default-buffer-handle.
     1025       end.
     1026       run gen-key-rec in this-procedure ( input 'clob-data':U
     1027                                 ,input buffer buf_clob-data:handle
     1028                                 ,output p-gate-rec).
     1029       do v-ii = 1 to p-dsh:num-buffers:
     1030         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1031         if not p-xmlh:available then do:
     1032           p-xmlh:buffer-create().
     1033           assign
     1034           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1035           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1036           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1037           p-xmlh::gate-handle_ = p-dsh
     1038           p-xmlh::uniq-gate-rec = p-gate-rec
     1039           p-xmlh::gate-name = p-dsh:name
     1040           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1041           .
     1042           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1043             assign
     1044             p-xmlh::order = -3.
     1045           end.
     1046         end.
     1047       end.
     1048   end.
     1049   end procedure.
     1050   procedure get-gate-by-rec :
     1051   define input  parameter p-gate-rec as character no-undo .
     1052   define output parameter p-dsh as handle no-undo .
     1053   define input-output  parameter p-xmlh as handle no-undo .
     1054   define input-output parameter p-longchar  as longchar no-undo .
     1055   define variable v-ii as integer   no-undo .
     1056   define variable glog as logical   no-undo .
     1057   define variable v-rowid as rowid no-undo .
     1058   define variable v-tbl-name as character no-undo .
     1059   define variable v-longchar as longchar no-undo .
     1060   define variable v-txmlh as handle no-undo .
     1061   define buffer buf_clob-data for ub.clob-data.
     1062   main-block:
     1063   do
     1064   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message (1))
     1065   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info4 )
     1066   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info4 )
     1067   :
     1068     run gen-row-keyr in this-procedure (
     1069                                           input  p-gate-rec
     1070                                           ,input  ?
     1071                                           ,input  "ub"
     1072                                           ,input  ?
     1073                                           ,input  NO-LOCK
     1074                                           ,output v-rowid
     1075                                           ,output v-tbl-name   ) no-error.
     1076       find first buf_clob-data no-lock where
     1077                 rowid(buf_clob-data) = v-rowid  no-error.
     1078       if not available buf_clob-data then do:
     1079         undo, return error substitute("Не найден CLOB  &1"
     1080                                         , p-gate-rec
     1081                                         ).
     1082       end.
     1083       assign
     1084       v-longchar = buf_clob-data.cdata
     1085       .
     1086       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1087       if error-status :error then do:
     1088         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1089       end.
     1090       create dataset p-dsh .
     1091       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1092                                     , v-longchar
     1093                                     , ?
     1094                                     , ?
     1095                                     , ?
     1096                                     ) no-error.
     1097       define variable v-esm as character no-undo .
     1098       v-esm = error-status:get-message(1) .
     1099       if p-longchar <> ? then do:
     1100         p-longchar = v-longchar.
     1101       end.
     1102       v-longchar = '':U.
     1103       if error-status :error
     1104       or not glog
     1105       then do:
     1106         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     1107                                      , p-gate-rec
     1108                                      , p-gate-rec
     1109                                      , v-esm
     1110                                      ).
     1111       end.
     1112       p-dsh:private-data = buf_clob-data.file-name_ + chr(4) + p-gate-rec.
     1113       if not valid-handle(p-xmlh)
     1114       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1115         create temp-table v-txmlh.
     1116         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1117         v-txmlh:temp-table-prepare("temp-xml-tables").
     1118         p-xmlh = v-txmlh:default-buffer-handle.
     1119       end.
     1120       do v-ii = 1 to p-dsh:num-buffers:
     1121         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1122         if not p-xmlh:available then do:
     1123           p-xmlh:buffer-create().
     1124           assign
     1125           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1126           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1127           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1128           p-xmlh::gate-handle_ = p-dsh
     1129           p-xmlh::uniq-gate-rec = p-gate-rec
     1130           p-xmlh::gate-name = p-dsh:name
     1131           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1132           .
     1133           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1134             assign
     1135             p-xmlh::order = -3.
     1136           end.
     1137           p-xmlh:buffer-release().
     1138         end.
     1139       end.
     1140   end.
     1141   end procedure.
     1142   procedure get-gate-by-file :
     1143   define input  parameter p-schema-file-name as character no-undo .
     1144   define input  parameter p-gate-rec as character no-undo .
     1145   define output parameter p-dsh as handle no-undo .
     1146   define input-output  parameter p-xmlh as handle no-undo .
     1147   define variable v-ii as integer   no-undo .
     1148   define variable glog as logical   no-undo .
     1149   define variable v-rowid as rowid no-undo .
     1150   define variable v-tbl-name as character no-undo .
     1151   define variable v-longchar as longchar no-undo .
     1152   define variable v-txmlh as handle no-undo .
     1153   main-block:
     1154   do
     1155   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message (1))
     1156   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info4 )
     1157   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info4 )
     1158   :
     1159       COPY-LOB
     1160       FROM  FILE p-schema-file-name
     1161       TO  OBJECT v-longchar
     1162       no-convert
     1163       NO-ERROR .
     1164       if error-status :error then do:
     1165           undo, return error substitute("Не удалось считать файл схемы &1 в память&2&3"
     1166                                     , p-schema-file-name
     1167                                 , chr(10)
     1168                                 , error-status:get-message(1) ).
     1169       end.
     1170       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1171       if error-status :error then do:
     1172         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, p-schema-file-name, chr(10), error-status:get-message(1) , return-value ).
     1173       end.
     1174       create dataset p-dsh .
     1175       glog = p-dsh:READ-XMLSCHEMA( "longchar"
     1176                                     , v-longchar
     1177                                     , ?
     1178                                     , ?
     1179                                     , ?
     1180                                     ) no-error.
     1181       v-longchar = ''.
     1182       if error-status :error
     1183       or not glog
     1184       then do:
     1185         undo, return error substitute("Не удалось прочитать XML-схему из файла &1&2&3"
     1186                                      , p-schema-file-name
     1187                                      ,chr(10)
     1188                                      , error-status:get-message(1)
     1189                                      ).
     1190       end.
     1191       if not valid-handle(p-xmlh)
     1192       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1193         create temp-table v-txmlh.
     1194         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1195         v-txmlh:temp-table-prepare("temp-xml-tables").
     1196         p-xmlh = v-txmlh:default-buffer-handle.
     1197       end.
     1198       do v-ii = 1 to p-dsh:num-buffers:
     1199         p-xmlh:find-first(substitute(' where tbl-name = "&1" and  uniq-gate-rec = "&2" '
     1200                                      ,p-dsh:get-buffer-handle(v-ii):name
     1201                                      ,p-gate-rec
     1202                                      )) no-error.
     1203         if not p-xmlh:available then do:
     1204           p-xmlh:buffer-create().
     1205           assign
     1206           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):table
     1207           p-xmlh::uniq-gate-rec = p-gate-rec
     1208           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1209           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1210           p-xmlh::gate-handle_ = p-dsh
     1211           p-xmlh::gate-name = p-dsh:name
     1212           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1213           .
     1214           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1215             assign
     1216             p-xmlh::order = -3.
     1217           end.
     1218           p-xmlh:buffer-release().
     1219         end.
     1220       end.
     1221   end.
     1222   end procedure.
     1223   procedure gate-clear :
     1224   define input  parameter p-dsh as handle no-undo .
     1225   define input  parameter p-xmlh as handle no-undo .
     1226   define variable v-dsh as handle no-undo .
     1227   define variable v-th as handle no-undo .
     1228     do
     1229     on error undo, return error return-value
     1230     :
     1231       if valid-handle(p-dsh) then do:
     1232         delete object p-dsh.
     1233         v-dsh = p-dsh.
     1234         p-dsh = ?.
     1235       end.
     1236       repeat while true:
     1237         p-xmlh:find-first( substitute( " where gate-handle_ = &1 ", v-dsh)
     1238                            , share-lock) no-error.
     1239         if p-xmlh:available then do:
     1240           assign
     1241           v-th = p-xmlh:buffer-field("table-handle_"):buffer-value.
     1242           if valid-handle(p-xmlh:buffer-field("table-handle_"))
     1243           and valid-handle(v-th)
     1244           and v-th:dynamic = yes
     1245           then do:
     1246             delete object p-xmlh:buffer-field("table-handle_"):buffer-value.
     1247             p-xmlh:buffer-field("table-handle_"):buffer-value = ?.
     1248           end.
     1249           p-xmlh:buffer-delete().
     1250         end.
     1251         else do:
     1252           leave.
     1253         end.
     1254       end.
     1255       if p-xmlh:dynamic = yes
     1256       and valid-handle(p-xmlh)
     1257       then do:
     1258         delete object p-xmlh:table-handle.
     1259         p-xmlh = ?.
     1260       end.
     1261       v-dsh = ?.
     1262     end.
     1263   end procedure.
     1264   procedure all-gates-clear :
     1265   define parameter buffer buf_temp-xml-tables for temp-xml-tables.
     1266   do
     1267   on error undo, return error
     1268   :
     1269     for each buf_temp-xml-tables
     1270     break
     1271     by buf_temp-xml-tables.uniq-gate-rec
     1272     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1273     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1274     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1275     :
     1276         if first-of(buf_temp-xml-tables.uniq-gate-rec) then do:
     1277           delete object buf_temp-xml-tables.gate-handle_.
     1278           buf_temp-xml-tables.gate-handle_ = ?.
     1279         end.
     1280         if valid-handle(buf_temp-xml-tables.table-handle_)
     1281         and buf_temp-xml-tables.table-handle_:dynamic = no
     1282         then do:
     1283           delete object buf_temp-xml-tables.table-handle_.
     1284           buf_temp-xml-tables.table-handle_ = ?.
     1285         end.
     1286         delete buf_temp-xml-tables.
     1287     end.
     1288   end.
     1289   end procedure.
     1290   procedure fix-schemalocation :
     1291   define input-output  parameter p-longchar as longchar no-undo .
     1292   DEFINE VARIABLE hdoc AS HANDLE.
     1293   DEFINE VARIABLE hroot AS HANDLE.
     1294   DEFINE VARIABLE hnode-child AS HANDLE.
     1295   DEFINE VARIABLE hnode-attr AS HANDLE.
     1296   define variable v-jj as integer   no-undo .
     1297   define variable ok as logical   no-undo .
     1298   define variable v-path1                    as character                no-undo .
     1299   DEFINE VARIABLE v-full-path1               as character                no-undo .
     1300   DEFINE VARIABLE v-file-name1               as character                no-undo .
     1301   DEFINE VARIABLE v-file-name-no-ext1        as character                no-undo .
     1302   DEFINE VARIABLE v-file-name-ext1           as character                no-undo .
     1303   define variable v-schema-location          as character                no-undo .
     1304   do
     1305   on error undo, return error return-value
     1306   :
     1307     CREATE X-DOCUMENT hdoc.
     1308     CREATE X-noderef hroot.
     1309     CREATE X-noderef hnode-child.
     1310     CREATE X-noderef hnode-attr.
     1311     hdoc:load("longchar", p-longchar, no) no-error.
     1312     iF ERROR-STATUS:GET-MESSAGE(1) <> '' THEN message ERROR-STATUS:GET-MESSAGE(1) view-as alert-box .
     1313     hdoc:get-document-element(hroot).
     1314     _repeat:
     1315     REPEAT v-jj = 1 TO hroot:NUM-CHILDREN:
     1316       ok = hroot:GET-CHILD(hNode-Child, v-jj).
     1317       if not ok then next.
     1318       if hNode-Child:local-name = "include"
     1319       then do:
     1320         ok = hNode-Child:GET-ATTRIBUTE-NODE( hnode-attr, "schemaLocation" ).
     1321           v-schema-location = hnode-attr:node-value.
     1322           run gbl/filename.p (
     1323                           input "exe/" + hnode-attr:node-value
     1324                         ,output v-full-path1
     1325                         ,output v-path1
     1326                         ,output v-file-name1
     1327                         ,output v-file-name-no-ext1
     1328                         ,output v-file-name-ext1
     1329                         ) no-error .
     1330           if error-status :error then do:
     1331             delete object hnode-attr.
     1332             delete object hnode-child.
     1333             delete object hroot.
     1334             delete object hdoc.
     1335             undo, return error substitute("Не удалось определить расположение схемы &1", v-schema-location).
     1336           end.
     1337         ok = hNode-Child:sET-ATTRIBUTE(  "schemaLocation", v-full-path1 ).
     1338         leave  _repeat.
     1339       end.
     1340     END.
     1341     hdoc:save("longchar", p-longchar).
     1342     delete object hnode-attr.
     1343     delete object hnode-child.
     1344     delete object hroot.
     1345     delete object hdoc.
     1346   end.
     1347   end procedure.
     1348   procedure gate-clb_fill-xml-tables :
     1349   define input parameter p-dsh as handle no-undo .
     1350   define input-output parameter p-xmlh as handle no-undo .
     1351   define variable v-ii as integer no-undo .
     1352     do
     1353     on error undo, return error
     1354     :
     1355       do v-ii = 1 to p-dsh:num-buffers:
     1356         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1357         if not p-xmlh:available then do:
     1358           p-xmlh:buffer-create().
     1359           assign
     1360           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1361           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1362           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1363           p-xmlh::gate-handle_ = p-dsh
     1364           p-xmlh::uniq-gate-rec = entry(2, p-dsh:private-data, chr(4))
     1365           p-xmlh::gate-name = p-dsh:name
     1366           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1367           .
     1368           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1369             assign
     1370             p-xmlh::order = -3.
     1371           end.
     1372           p-xmlh:buffer-release().
     1373         end.
     1374       end.
     1375     end.
     1376   end procedure.
     1377   procedure all-gates-empty :
     1378   define buffer buf_temp-xml-tables for temp-xml-tables.
     1379   do
     1380   on error undo, return error
     1381   :
     1382     for each buf_temp-xml-tables
     1383     break
     1384     by buf_temp-xml-tables.uniq-gate-rec
     1385     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1386     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1387     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1388     :
     1389       if valid-handle(buf_temp-xml-tables.tbl-handle_) then do:
     1390         buf_temp-xml-tables.tbl-handle_:empty-temp-table().
     1391       end.
     1392     end.
     1393   end.
     1394   end procedure.
     1395   def var vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1396   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1397   define new global shared variable g#attr-lib  as handle no-undo .
     1398   define variable v-attr-lib-variable as handle no-undo .
     1399   procedure ext-system-attr-code :
     1400     define input  parameter p-code           as character no-undo .
     1401     define output parameter p-type           as character no-undo .
     1402     define output parameter p-format         as character no-undo .
     1403     define output parameter p-label          as character no-undo .
     1404     define output parameter p-user-can-edit  as logical   no-undo .
     1405     define output parameter p-output-display as logical   no-undo .
     1406     define output parameter p-other          as character no-undo .
     1407     do
     1408     on error undo, return error
     1409     :
     1410           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run ext-system-attr-code in g#attr-lib
     1411         (input  p-code
     1412         ,output p-type
     1413         ,output p-format
     1414         ,output p-label
     1415         ,output p-user-can-edit
     1416         ,output p-output-display
     1417         ,output p-other
     1418         ) no-error .
     1419       if error-status :error
     1420       then do:
     1421         undo, return error return-value .
     1422       end.
     1423     end.
     1424   end procedure.
     1425   procedure ext-system-attr-tooltip :
     1426     define input  parameter p-code    as character no-undo .
     1427     define output parameter p-tooltip as character no-undo .
     1428     define output parameter p-label   as character no-undo .
     1429     do
     1430     on error undo, return error
     1431     :
     1432           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run ext-system-attr-tooltip in g#attr-lib
     1433         (input  p-code
     1434         ,output p-tooltip
     1435         ,output p-label
     1436         ) no-error .
     1437       if error-status :error
     1438       then do:
     1439         undo, return error return-value .
     1440       end.
     1441     end.
     1442   end procedure.
     1443   procedure ext-system-attr-value :
     1444     define input  parameter p-esys-id   like ub.ext-system-attr.esys-id    no-undo .
     1445     define input  parameter p-db-num    like ub.ext-system-attr.db-num     no-undo .
     1446     define input  parameter p-code      like ub.ext-system-attr.esya-attr-code  no-undo .
     1447     define output parameter p-value     like ub.ext-system-attr.esya-attr-value no-undo .
