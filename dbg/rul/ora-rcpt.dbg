     1602   function context_begin-esys-command return logical
     1603   (
     1604       input p-esys-id-list as character
     1605      ,input-output p-esys-cmd-proc-handle as handle
     1606      ,output p-esys-cmd-code as integer
     1607   ):
     1608      if not valid-handle(p-esys-cmd-proc-handle )
     1609      then do:
     1610        run nws/cmd-bush.p persistent set p-esys-cmd-proc-handle no-error .
     1611        if error-status :error
     1612        then do:
     1613           delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( substitute("&1 &2 &3&4Ошибка при запуске процедуры cmd-bush.p&4" +
     1614                                              "&5&4&6"
     1615                                              ,vss-workfile
     1616                                              ,vss-revision
     1617                                              ,vss-description
     1618                                              ,chr(10)
     1619                                              ,error-status:get-message(1)
     1620                                              ,return-value )).
     1621        end.
     1622        run begin-create-command in p-esys-cmd-proc-handle
     1623          (input 'cmd-esys-general':U
     1624          ,input p-esys-id-list
     1625          ,output p-esys-cmd-code
     1626          ) no-error.
     1627        if error-status :error
     1628        then do:
     1629          delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при создании команды &1&2&3&1&4"
     1630                                                           , 'cmd-esys-general':U
     1631                                                           , error-status:get-message(1)
     1632                                                           , return-value
     1633                                                           )).
     1634          return no .
     1635        end.
     1636        return yes.
     1637      end.
     1638   end.
     1639   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1640   function context_send-esys-command return logical
     1641   (
     1642       input p-esys-id-list as character
     1643      ,input p-esys-cmd-proc-handle as handle
     1644      ,input p-esys-cmd-code as integer
     1645      ,input p-user-id as character
     1646   ):
     1647      define variable v-dmp-ord-int64 as int64 no-undo .
     1648      if valid-handle(p-esys-cmd-proc-handle )
     1649      then do:
     1650         run send-command-esys in p-esys-cmd-proc-handle
     1651             (input p-esys-cmd-code
     1652             ,input p-esys-id-list
     1653             ,input p-user-id
     1654             ,output v-dmp-ord-int64
     1655             ) no-error.
     1656         if error-status :error
     1657         then do:
     1658            delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при отсылке во внешнюю систему &1 команды с кодом &2&3&4&3&5"
     1659                                                           , p-esys-id-list
     1660                                                           , p-cmd-code
     1661                                                           , chr(10)
     1662                                                           , error-status:get-message(1)
     1663                                                           , return-value
     1664                                                           )).
     1665            return no .
     1666         end.
     1667         delete procedure p-esys-cmd-proc-handle no-error.
     1668         return yes.
     1669      end.
     1670      else do:
     1671         delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при отсылке во внешнюю систему &1 команды с кодом &2&3&4&3&5"
     1672                                                       , p-esys-id-list
     1673                                                       , p-cmd-code
     1674                                                       , chr(10)
     1675                                                       , error-status:get-message(1)
     1676                                                       , return-value
     1677                                                       )).
     1678         return no .
     1679      end.
     1680   end.
     1681   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1682   function context_set-custom-esys-pck-name return logical
     1683   (
