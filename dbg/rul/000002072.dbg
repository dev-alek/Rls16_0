     1832   if valid-handle(chWorkBook) then
     1833   RELEASE OBJECT chWorkBook no-error.
     1834         chExcelApplication:Quit() no-error.
     1835   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1836   if valid-handle(chExcelApplication) then
     1837   RELEASE OBJECT chExcelApplication no-error.
     1838         return error substitute("Ошибка при импорте из файла &1:&2&3"
     1839                                 , p-filename
     1840                                 , chr(10)
     1841                                 , error-status:get-message(1)
     1842                                 ).
     1843       end.
     1844       v-line-num = v-line-num + 1.
     1845       p-num-rec = p-num-rec + 1.
     1846       p-bh:buffer-create().
     1847       if valid-handle(v-lnfh) then do:
     1848         v-lnfh:buffer-value = v-line-num.
     1849       end.
     1850       do v-ii = 1 to v-num-fields:
     1851         v-text = ''.
     1852         assign
     1853         v-text = chWorkSheet:range( substitute("&1&2", dyneximp_excel-col-name(v-ii), v-row)):text
     1854         .
     1855         if p-order = '' then do:
     1856           assign
     1857           v-fh = p-bh:buffer-field(v-ii)
     1858           no-error
     1859           .
     1860         end.
     1861         else do:
     1862           assign
     1863           v-fh = p-bh:buffer-field(entry(v-ii, p-order))
     1864           no-error
     1865           .
     1866         end.
     1867         if error-status:error
