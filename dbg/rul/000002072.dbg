        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-parent-handle as handle no-undo .
        4   define input parameter p-log-handle  as handle no-undo .
        5   define input parameter p-cont-handle  as handle no-undo .
        6   define input parameter p-codex-id as integer no-undo .
        7   define input parameter p-ruleset-id as integer no-undo .
        8   define input parameter p-call-id as character no-undo .
        9   define input parameter p-order-id as integer no-undo .
       10   define input parameter p-rule-id as integer no-undo .
       11   define input parameter p-profile-id as integer no-undo .
       12   define input parameter p-is-dynamic as logical no-undo .
       13   define input parameter p-doc-type as character no-undo .
       14   define input parameter p-host-code like ub.sysconf.host-code no-undo .
       15   define input parameter p-obj-type like ub.clients.obj-type no-undo .
       16   define input parameter p-obj-code like ub.clients.obj-code no-undo .
       17   define input parameter p-doc-code as character no-undo .
       18   define input parameter p-process-file-name as character no-undo .
       19   define input parameter p-save       as integer no-undo .
       20   define input parameter v-curr-r-b   as character no-undo .
       21   define input parameter p-cmd-proc-handle as handle no-undo .
       22   define input parameter p-cmd-code  as integer no-undo .
       23   define variable vss-revision    as character no-undo init "$Revision$":U .
       24   define variable vss-author      as character no-undo init "$Author$":U .
       25   define variable vss-date        as character no-undo init "$Date$":U .
       26   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       27   define variable vss-archive     as character no-undo init "$Archive$":U .
       28   define variable vss-description as character no-undo init "Импорт спецификации".
       29   procedure vss-get-info :
       30     define output parameter p-vss-revision    like vss-revision    no-undo .
       31     define output parameter p-vss-author      like vss-author      no-undo .
       32     define output parameter p-vss-date        like vss-date        no-undo .
       33     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       34     define output parameter p-vss-archive     like vss-archive     no-undo .
       35     define output parameter p-vss-description like vss-description no-undo .
       36     assign
       37       p-vss-revision    = vss-revision
       38       p-vss-author      = vss-author
       39       p-vss-date        = vss-date
       40       p-vss-workfile    = vss-workfile
       41       p-vss-archive     = vss-archive
       42       p-vss-description = vss-description
       43     .
       44   end procedure.
       45   procedure vss-get-parameters :
       46     define output parameter p-vss-parameters as character no-undo .
       47   end procedure.
       48   define new global shared variable g#vssrevis-logger as handle    no-undo .
       49   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       50   define variable v-vssrevis-logger                   as handle    no-undo .
       51   procedure vss-logevent :
       52     define input  parameter p-extra-paramters as character no-undo .
       53     define variable v-vssrevis-parameters as character no-undo .
       54     do
       55     on error undo, return error return-value
       56     :
       57       if  valid-handle(v-vssrevis-logger)
       58       and v-vssrevis-logger :get-signature("logevent") <> ""
       59       then do:
       60         run vss-get-parameters in this-procedure
       61           (output v-vssrevis-parameters
       62           ).
       63         run logevent in v-vssrevis-logger
       64           (input vss-workfile
       65           ,input vss-revision
       66           ,input v-vssrevis-parameters
       67           ,input p-extra-paramters
       68           ).
       69       end.
       70     end.
       71   end procedure.
       72   assign
       73     v-vssrevis-logger = g#vssrevis-logger
       74   .
       75   if  valid-handle(v-vssrevis-logger)
       76   and v-vssrevis-logger :get-signature("logevent") <> ""
       77   then do:
       78     assign
       79       v-vssrevis-logevent = true
       80     .
       81     run vss-logevent in this-procedure (input vss-description) .
       82   end.
       83   define new global shared variable g#language as character no-undo .
       84   if g#language <> '' and g#language <> 'rus':U then do:
       85     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       86   end.
       87   define new global shared variable g#library  as handle no-undo .
       88   define new global shared variable g#library2 as handle no-undo .
       89   define   shared variable g#auto as logical no-undo.
       90   define   shared variable g#news as logical no-undo.
       91   define   shared variable g#oxml as logical no-undo.
       92   define   shared variable g#esys as logical no-undo.
       93   define   shared variable g#news-source-db as integer no-undo.
       94   define   shared variable g#esys-source-esys as integer no-undo.
       95   define   shared variable g#db-num as integer   no-undo .
       96   define   shared variable g#userid as character no-undo .
       97   define   shared variable g#passwd as character no-undo .
       98   define new global shared variable g#libbcrcn as handle no-undo .
       99   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      100   procedure gen-key-rec :
      101     define input  parameter p-tbl-name    as character no-undo.
      102     define input  parameter p-bh_tbl-name as handle    no-undo.
      103     define output parameter p-key-rec     as character no-undo.
      104     do
      105     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      106     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      107     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      108     :
      109       define variable fh               as handle    no-undo .
      110       define variable v-ok             as logical   no-undo .
      111       define variable v-inform         as character no-undo .
      112       define variable v-ind            as integer   no-undo .
      113       define variable v-idx-field-qnty as integer   no-undo .
      114       if p-tbl-name = ?
      115         or p-tbl-name = "":U
      116       then do:
      117         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info0 ).
      118       end.
      119       if not p-bh_tbl-name:available then do:
      120         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info0, p-tbl-name ).
      121       end.
      122       assign
      123         p-key-rec = p-tbl-name
      124         v-inform  = p-bh_tbl-name:index-information(1)
      125         v-ind     = 2
      126       .
      127       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      128       on error undo, return error
      129       :
      130         assign
      131           v-inform = p-bh_tbl-name:index-information( v-ind )
      132           v-ind    = v-ind + 1
      133         .
      134       end.
      135       if v-inform = ?
      136         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      137         or entry( 3, v-inform, ",":U ) <> "1":U
      138       then do:
      139         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, p-tbl-name ).
      140       end.
      141       else do:
      142         assign
      143           v-idx-field-qnty = num-entries( v-inform ) - 4
      144         .
      145         if v-idx-field-qnty < 2 then do:
      146           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, p-tbl-name ).
      147         end.
      148         do v-ind = 1 to v-idx-field-qnty by 2
      149         on error undo, return error
      150         :
      151           assign
      152             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      153             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      154           .
      155         end.
      156       end.
      157       if p-key-rec = ? then do:
      158         assign
      159           p-key-rec = "":U
      160         .
      161         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info0, p-tbl-name ).
      162       end.
      163     end.
      164     return.
      165   end procedure.
      166   procedure gen-where-keyr-tab :
      167     define input  parameter i-tableSerach as character no-undo.
      168     define input  parameter i-tablekey   as character  no-undo.
      169     define input  parameter p-key-rec    as character  no-undo.
      170     define input  parameter p-key-handle as handle     no-undo .
      171     define input  parameter p-db-name    as character  no-undo .
      172     define input  parameter p-tt-handle  as handle     no-undo .
      173     define output parameter o-Where      as character  no-undo.
      174     do
      175     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      176     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      177     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      178     :
      179       define variable v-full-tbl-name  as character no-undo .
      180       define variable bh_tbl-name      as handle    no-undo .
      181       define variable fh_key           as handle    no-undo .
      182       define variable fh_search        as handle    no-undo .
      183       define variable v-field-num      as integer   no-undo .
      184       define variable v-count-fld      as integer   no-undo .
      185       define variable v-inform         as character no-undo .
      186       define variable v-ind            as integer   no-undo .
      187       define variable v-idx-field-qnty as integer   no-undo .
      188       define variable v-field-name     as character no-undo .
      189       define variable v-field-val      as character no-undo .
      190       define variable v-word-link      as character no-undo .
      191       define variable vTable           as character no-undo.
      192       define variable bh_tbl-key       as handle    no-undo .
      193       assign
      194         p-key-rec = trim( p-key-rec )
      195       .
      196       if p-key-handle <> ? then do:
      197         if not valid-handle(p-key-handle)
      198            or p-key-handle:type <> "buffer"
      199         then do:
      200           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info0 ).
      201         end.
      202         if num-entries( p-key-rec, chr(3) ) > 1
      203           or p-key-rec = ?
      204           or p-key-rec = "":U
      205         then do:
      206           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info0, p-key-rec ).
      207         end.
      208       end.
      209       else do:
      210         if p-key-rec = ?
      211           or p-key-rec = "":U
      212         then do:
      213           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info0 ).
      214         end.
      215       end.
      216       assign
      217         vTable = entry( 1 , p-key-rec, chr(3) )
      218       .
      219       if p-tt-handle <> ?
      220         and ( not valid-handle(p-tt-handle)
      221               or p-tt-handle:type <> "buffer"
      222             )
      223       then do:
      224         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info0, vTable, chr(10) ).
      225       end.
      226       if p-tt-handle = ? then do:
      227         assign
      228           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      229         .
      230         create buffer bh_tbl-name for table v-full-tbl-name .
      231       end.
      232       else do:
      233         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      234       end.
      235       assign
      236         v-inform = bh_tbl-name:index-information(1)
      237         v-ind    = 2
      238       .
      239       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      240       on error undo, return error
      241       :
      242         assign
      243           v-inform = bh_tbl-name:index-information( v-ind )
      244           v-ind    = v-ind + 1
      245         .
      246       end.
      247       if v-inform = ?
      248         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      249         or entry( 3, v-inform, ",":U ) <> "1":U
      250       then do:
      251         delete object bh_tbl-name no-error.
      252         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info0, vTable ).
      253       end.
      254       assign
      255         v-idx-field-qnty = num-entries( v-inform ) - 4
      256       .
      257       if v-idx-field-qnty < 2 then do:
      258         delete object bh_tbl-name no-error.
      259         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, vTable ).
      260       end.
      261       assign
      262         o-where     = "where":U
      263         v-word-link = "":U
      264         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      265         v-count-fld = 0
      266       .
      267       if i-tablekey ne "" and i-tablekey ne ?
      268       then do:
      269         assign
      270           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      271         .
      272         create buffer bh_tbl-key for table v-full-tbl-name .
      273       end.
      274       if i-tableSerach ne "" and i-tableSerach ne ?
      275       then do:
      276         delete object bh_tbl-name no-error.
      277         assign
      278           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      279         .
      280         create buffer bh_tbl-name for table v-full-tbl-name .
      281       end.
      282       block_where:
      283       do v-ind = 1 to v-idx-field-qnty by 2
      284       on error undo, return error
      285       :
      286         assign
      287           v-count-fld = v-count-fld + 1
      288         .
      289         if p-key-handle = ?
      290           and v-count-fld > v-field-num
      291         then do:
      292           leave block_where.
      293         end.
      294         define variable VfieldKeyTable as handle no-undo.
      295         assign
      296           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      297           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      298         .
      299         if     bh_tbl-key ne ?
      300         then do:
      301            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      302            if VfieldKeyTable eq ?
      303            then next block_where.
      304         end.
      305         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      306         then
      307            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      308         else
      309            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      310         if p-key-handle = ? then do:
      311           assign
      312             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      313           .
      314         end.
      315         else do:
      316           assign
      317             fh_key = p-key-handle:buffer-field( v-field-name )
      318           .
      319           if fh_key = ?
      320             or not valid-handle( fh_key )
      321           then do:
      322             delete object bh_tbl-name.
      323             if     bh_tbl-key ne ?
      324             then
      325                delete object bh_tbl-key.
      326             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info0, p-key-handle:name, v-field-name ).
      327           end.
      328           assign
      329             v-field-val = fh_key:buffer-value
      330           .
      331         end.
      332         if fh_search:data-type ="character":U then do:
      333           assign
      334             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      335             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      336             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      337             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      338             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      339             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      340             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      341             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      342             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      343             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      344             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      345             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      346             v-field-val = substitute( '"&1"', v-field-val )
      347           .
      348         end.
      349         assign
      350           o-where = substitute( "&1 &2", o-where, v-field-val )
      351         .
      352         if v-word-link = "":U then do:
      353           assign
      354             v-word-link = "and":U
      355           .
      356         end.
      357       end.
      358       delete object bh_tbl-name.
      359       if     bh_tbl-key ne ?
      360       then
      361          delete object bh_tbl-key.
      362       if p-key-handle = ?
      363         and v-count-fld <> v-field-num
      364       then do:
      365         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info0, vTable ).
      366       end.
      367     end.
      368   end procedure.
      369   procedure gen-hn-keyr-tab :
      370     define input  parameter i-tableSerach as character no-undo.
      371     define input  parameter i-tablekey   as character no-undo.
      372     define input  parameter p-key-rec    as character no-undo.
      373     define input  parameter p-key-handle as handle    no-undo .
      374     define input  parameter p-db-name    as character no-undo .
      375     define input  parameter p-tt-handle  as handle    no-undo .
      376     define input  parameter p-stts-lock  as integer   no-undo .
      377     define output parameter o-hn         as handle    no-undo.
      378     define variable v-full-tbl-name as character no-undo.
      379     define variable v-where         as character no-undo.
      380     define variable bh_tbl-name     as handle    no-undo.
      381     define variable vTable          as character no-undo.
      382     do
      383     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      384     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      385     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      386         run gen-where-keyr-tab(i-tableSerach,
      387                                i-tablekey,
      388                                p-key-rec,
      389                                p-key-handle,
      390                                p-db-name,
      391                                p-tt-handle,
      392                                output v-where).
      393         if i-tableSerach ne "" and i-tableSerach ne ?
      394         then do:
      395            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      396            create buffer bh_tbl-name for table v-full-tbl-name .
      397         end.
      398         else do:
      399            if p-tt-handle = ? then do:
      400               assign
      401                  vTable = entry( 1 , p-key-rec, chr(3) )
      402               .
      403               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      404               create buffer bh_tbl-name for table v-full-tbl-name .
      405            end.
      406            else do:
      407               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      408            end.
      409         end.
      410         if p-tt-handle = ? then do:
      411            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      412         end.
      413         else do:
      414            bh_tbl-name:find-first( v-where ) no-error .
      415         end.
      416         o-hn = bh_tbl-name.
      417      end.
      418   end procedure.
      419   procedure gen-hn-keyr :
      420     define input  parameter p-key-rec    as character no-undo.
      421     define input  parameter p-key-handle as handle    no-undo .
      422     define input  parameter p-db-name    as character no-undo .
      423     define input  parameter p-tt-handle  as handle    no-undo .
      424     define input  parameter p-stts-lock  as integer   no-undo .
      425     define output parameter o-hn         as handle    no-undo.
      426     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      427   end.
      428   procedure gen-row-keyr :
      429     define input  parameter p-key-rec    as character no-undo.
      430     define input  parameter p-key-handle as handle    no-undo .
      431     define input  parameter p-db-name    as character no-undo .
      432     define input  parameter p-tt-handle  as handle    no-undo .
      433     define input  parameter p-stts-lock  as integer   no-undo .
      434     define output parameter p-tbl-row    as rowid     no-undo.
      435     define output parameter p-tbl-name   as character no-undo.
      436     define variable vHn as handle no-undo.
      437       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      438       p-tbl-row = if vHn:available then vHn:rowid else ?.
      439       p-tbl-name =  vHn:table.
      440       delete object vHn no-error.
      441     if p-tbl-row = ? then do:
      442       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info0, p-tbl-name, p-key-rec ).
      443     end.
      444     else do:
      445       return.
      446     end.
      447   end procedure.
      448   procedure gen-key-fv :
      449     define input  parameter p-key-rec    as character no-undo .
      450     define output parameter p-field-list as character no-undo .
      451     define output parameter p-value-list as character no-undo.
      452     do
      453     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      454     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      455     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      456     :
      457       define variable v-full-tbl-name  as character no-undo .
      458       define variable bh_tbl-name      as handle    no-undo .
      459       define variable v-tbl-name       as character no-undo .
      460       define variable v-field-num      as integer   no-undo .
      461       define variable v-count-fld      as integer   no-undo .
      462       define variable v-inform         as character no-undo .
      463       define variable v-ind            as integer   no-undo .
      464       define variable v-idx-field-qnty as integer   no-undo .
      465       define variable v-delim-key      as character no-undo .
      466       if p-key-rec = ?
      467         or p-key-rec = "":U
      468       then do:
      469         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info0 ).
      470       end.
      471       assign
      472         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      473         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      474       .
      475       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      476       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info0 ).
      477       assign
      478         v-inform = bh_tbl-name:index-information(1)
      479         v-ind    = 2
      480       .
      481       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      482       on error undo, return error
      483       :
      484         assign
      485           v-inform = bh_tbl-name:index-information( v-ind )
      486           v-ind    = v-ind + 1
      487         .
      488       end.
      489       if v-inform = ?
      490         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      491         or entry( 3, v-inform, ",":U ) <> "1":U
      492       then do:
      493         delete object bh_tbl-name no-error.
      494         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, v-tbl-name ).
      495       end.
      496       assign
      497         v-idx-field-qnty = num-entries( v-inform ) - 4
      498       .
      499       if v-idx-field-qnty < 2 then do:
      500         delete object bh_tbl-name no-error.
      501         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, v-tbl-name ).
      502       end.
      503       assign
      504         p-field-list = "":U
      505         p-value-list = "":U
      506         v-delim-key  = "":U
      507         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      508         v-count-fld  = 0
      509       .
      510       block_where:
      511       do v-ind = 1 to v-idx-field-qnty by 2
      512       on error undo, return error
      513       :
      514         assign
      515           v-count-fld = v-count-fld + 1
      516         .
      517         if v-count-fld > v-field-num then do:
      518           leave block_where.
      519         end.
      520         assign
      521           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      522           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      523         .
      524         if v-ind = 1 then do:
      525           assign
      526             v-delim-key = chr(3)
      527           .
      528         end.
      529       end.
      530       delete object bh_tbl-name.
      531       if v-count-fld <> v-field-num then do:
      532         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info0, v-tbl-name ).
      533       end.
      534     end.
      535   end procedure.
      536   procedure gen-key-field :
      537     define input  parameter p-table      as character no-undo .
      538     define output parameter p-field-list as character no-undo .
      539     do
      540     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      541     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      542     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      543     :
      544       define variable v-full-tbl-name  as character no-undo .
      545       define variable bh_tbl-name      as handle    no-undo .
      546       define variable v-tbl-name       as character no-undo .
      547       define variable v-field-num      as integer   no-undo .
      548       define variable v-count-fld      as integer   no-undo .
      549       define variable v-inform         as character no-undo .
      550       define variable v-ind            as integer   no-undo .
      551       define variable v-idx-field-qnty as integer   no-undo .
      552       define variable v-delim-key      as character no-undo .
      553       if p-table = ?
      554         or p-table = "":U
      555       then do:
      556         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info0 ).
      557       end.
      558       assign
      559         v-tbl-name      = p-table
      560         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      561       .
      562       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      563       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info0 ).
      564       assign
      565         v-inform = bh_tbl-name:index-information(1)
      566         v-ind    = 2
      567       .
      568       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      569       on error undo, return error
      570       :
      571         assign
      572           v-inform = bh_tbl-name:index-information( v-ind )
      573           v-ind    = v-ind + 1
      574         .
      575       end.
      576       if v-inform = ?
      577         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      578         or entry( 3, v-inform, ",":U ) <> "1":U
      579       then do:
      580         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, v-tbl-name ).
      581       end.
      582       assign
      583         v-idx-field-qnty = num-entries( v-inform ) - 4
      584       .
      585       if v-idx-field-qnty < 2 then do:
      586         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, v-tbl-name ).
      587       end.
      588       assign
      589         p-field-list = "":U
      590         v-delim-key  = "":U
      591         v-count-fld  = 0
      592       .
      593       block_where:
      594       do v-ind = 1 to v-idx-field-qnty by 2
      595       on error undo, return error
      596       :
      597         assign
      598           v-count-fld = v-count-fld + 1
      599         .
      600         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      601         if v-ind = 1 then do:
      602           assign
      603             v-delim-key = chr(3)
      604           .
      605         end.
      606       end.
      607       delete object bh_tbl-name.
      608     end.
      609   end procedure.
