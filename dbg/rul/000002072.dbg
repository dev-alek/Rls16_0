     1779       return error substitute("Количества строк в шапке файла &1 задано равным &2, номер последней строки в листе=&3,&4диапазон данных на листе задан неверно или данных нет."
     1780                               , p-filename
     1781                               , p-start-row - 1
     1782                               , v-last-row
     1783                               , chr(10)
     1784                               ).
     1785     end.
