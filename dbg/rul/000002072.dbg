     1661   end procedure.
     1662   procedure dyneximp_import-excel:
     1663   define input parameter p-filename as character no-undo .
     1664   define input parameter p-start-row as integer no-undo .
     1665   define input parameter p-bh as handle no-undo .
     1666   define input parameter p-order as character no-undo .
     1667   define input parameter p-except-field-list as character no-undo .
     1668   define input parameter p-line-num-field as character no-undo .
     1669   define input parameter p-call-handle as handle no-undo .
     1670   define input parameter p-err-proc as character no-undo .
     1671   define output parameter p-num-rec as integer no-undo .
     1672   define output parameter p-num-rec-ok as integer no-undo .
     1673   define variable chExcelApplication as com-handle no-undo .
     1674   define variable chWorkbook         as com-handle no-undo .
     1675   define variable chWorksheet        as com-handle no-undo .
