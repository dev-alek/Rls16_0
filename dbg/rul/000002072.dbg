     1798       return error substitute("В файле &1 не удалось определить диапазон данных по столбцу крайней используемой ячейки."
     1799                               , p-filename
     1800                               ).
     1801     end.
     1802     if v-last-column < v-num-fields then do:
     1803   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1804   if valid-handle(chWorkSheet) then
     1805   RELEASE OBJECT chWorkSheet no-error.
     1806   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1807   if valid-handle(chWorkBook) then
     1808   RELEASE OBJECT chWorkBook no-error.
     1809       chExcelApplication:Quit() no-error.
     1810   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1811   if valid-handle(chExcelApplication) then
     1812   RELEASE OBJECT chExcelApplication no-error.
     1813       return error substitute("В файле &1 количество используемых столбцов = &2, а количество заданных для импорта полей =&3."
     1814                               , p-filename
     1815                               , v-last-column
     1816                               , v-num-fields
     1817                               ).
     1818     end.
     1819     chWorkSheet:Columns("A:Z"):Select.
     1820     chExcelApplication:Selection:Columns:AutoFit.
     1821     _row:
     1822     do v-row = p-start-row to v-last-row
     1823     on error  undo _row, retry
     1824     on stop   undo _row, retry
     1825     on endkey undo _row, retry
     1826     :
     1827       if retry then do:
     1828   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1829   if valid-handle(chWorkSheet) then
     1830   RELEASE OBJECT chWorkSheet no-error.
