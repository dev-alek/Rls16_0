     2601   procedure load-ruleset-context :
     2602   define input parameter p-ruleset-id as integer no-undo .
     2603   define buffer buf_rule-call-param for tt0-rule-call-param.
     2604   define buffer buf_contract for ub.contract.
     2605   do
     2606   on error undo, return error
     2607   :
     2608     find first buf_rule-call-param no-lock where
     2609   buf_rule-call-param.codex_id = p-codex-id
     2610   and buf_rule-call-param.ruleset_id = p-ruleset-id
     2611   and buf_rule-call-param.call_id = p-call-id
     2612   and buf_rule-call-param.order_id = p-order-id
     2613   and buf_rule-call-param.rule_id = p-rule-id
     2614   and buf_rule-call-param.param-name = "p-delimiter"
     2615    no-error.
     2616   if available buf_rule-call-param then do:
     2617   assign p-delimiter = buf_rule-call-param.param-value-character.
     2618   end.
     2619     find first buf_rule-call-param no-lock where
     2620   buf_rule-call-param.codex_id = p-codex-id
     2621   and buf_rule-call-param.ruleset_id = p-ruleset-id
     2622   and buf_rule-call-param.call_id = p-call-id
     2623   and buf_rule-call-param.order_id = p-order-id
     2624   and buf_rule-call-param.rule_id = p-rule-id
     2625   and buf_rule-call-param.param-name = "p-start-row"
     2626    no-error.
     2627   if available buf_rule-call-param then do:
     2628   assign p-start-row = buf_rule-call-param.param-value-integer.
     2629   end.
     2630       case p-ruleset-id:
     2631         when 224
     2632         or
     2633         when 226
     2634         then do:
     2635           assign
     2636           v-current-host-code = p-host-code
     2637           v-contract-code = integer(p-doc-code)
     2638           file-name  = p-process-file-name
     2639           .
     2640           find first buf_contract exclusive-lock where
     2641                     buf_contract.host-code = v-current-host-code
     2642                 and buf_contract.contract-code = v-contract-code no-error.
     2643           if not available  buf_contract then do:
     2644              undo, return error substitute("Не найден договор № &1 (по фирме &2)", v-contract-code, v-current-host-code).
     2645           end.
     2646           assign
     2647           v-contract-cli-type = buf_contract.cli-type
     2648           v-contract-cli-code = buf_contract.cli-code
     2649           .
     2650         end.
     2651         otherwise do:
     2652         end.
     2653       end case.
     2654       assign
