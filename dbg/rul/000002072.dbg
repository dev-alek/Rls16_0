     1770   if valid-handle(chWorkSheet) then
     1771   RELEASE OBJECT chWorkSheet no-error.
     1772   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1773   if valid-handle(chWorkBook) then
