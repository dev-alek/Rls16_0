     1688   define variable v-dop as character no-undo .
     1689   define variable v-excel-general-format as character no-undo .
     1690   define variable v-excel-short-date as character no-undo .
     1691   define variable v-excel-dec-separ as character no-undo .
     1692   define variable v-excel-th-separ as character no-undo .
     1693   define variable v-excel-date-separ as character no-undo .
     1694   main-block:
     1695   do
     1696   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1697   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1698   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1699   :
     1700     if p-bh:type <> "buffer" then do:
     1701       return error "Для импорта передан handle неверного типа".
     1702     end.
     1703     if p-order = '' then do:
     1704       v-num-fields = p-bh:num-fields.
     1705     end.
     1706     else do:
     1707       v-num-fields = num-entries(p-order) .
     1708       if v-num-fields > p-bh:num-fields then do:
     1709         return error  substitute("В переданной последовательности полей &1 число полей больше, чем в таблице &2, буффер которой передан"
     1710                                 , p-order
     1711                                 , p-bh:name
     1712                                 ).
     1713       end.
     1714     end.
     1715     if p-line-num-field <> '' then do:
     1716       assign
     1717       v-lnfh = p-bh:buffer-field(p-line-num-field)
     1718       no-error .
     1719       if not valid-handle(v-lnfh) then do:
     1720         return error substitute("Нет поля &1 в таблице &2, буфер которой передан", p-line-num-field, p-bh:name).
     1721       end.
     1722     end.
     1723     create "Excel.Application" chExcelApplication no-error.
     1724       if error-status :error then do:
     1725           message
     1726           "Ошибка при запуске Excel" skip
     1727           error-status :get-message(1) skip
     1728           view-as alert-box error .
     1729           undo, return error .
     1730       end.
     1731     assign
     1732     chExcelApplication:interactive     = false
     1733     chExcelApplication:ScreenUpdating  = false
     1734     chExcelApplication:visible         = false
     1735     chExcelApplication:DisplayAlerts   = false
     1736     .
     1737     assign
     1738     v-excel-general-format =  chExcelApplication:International(26  )
     1739     v-excel-short-date =  chExcelApplication:International(32  )
     1740     v-excel-dec-separ = chExcelApplication:International(3  )
     1741     v-excel-th-separ = chExcelApplication:International(4  )
     1742     v-excel-date-separ = chExcelApplication:International(17  )
     1743     no-error
     1744     .
     1745     chWorkBook   = chExcelApplication:WorkBooks:open( p-filename ).
     1746     chWorkSheet  = chExcelApplication:Sheets:item (1).
     1747     assign
     1748     v-last-row = chWorkSheet:Cells:SpecialCells(11):Row
     1749     v-last-column = chWorkSheet:Cells:SpecialCells(11):Column
     1750     no-error .
