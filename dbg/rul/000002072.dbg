     1484   if valid-handle(chExcelApplication) then
     1485   RELEASE OBJECT chExcelApplication no-error.
     1486           delete object v-qh.
     1487           return error substitute("В переданной последовательности полей &1 указано несуществующее в таблице &2 поле &3"
     1488                                   , p-order
     1489                                   , p-bh:name
     1490                                   , entry(v-ii, p-order)
     1491                                   ).
     1492         end.
     1493         if v-row = v-head-row then do:
     1494           if v-ii = 1 then do:
     1495             create query v-qh.
     1496             v-qh:set-buffers(p-bh).
     1497             v-qh:query-prepare( substitute(" for each &1 ", p-bh:name )) .
     1498             v-qh:query-open().
     1499           end.
     1500           if v-head-row > 0 then do:
     1501             assign
     1502             chWorkSheet:range( substitute("&1&2", dyneximp_excel-col-name(v-ii), v-head-row)):value = v-fh:column-label
     1503             no-error
     1504             .
     1505           end.
     1506           chWorkSheet:Columns( substitute("&1:&1", dyneximp_excel-col-name(v-ii), dyneximp_excel-col-name(v-ii))):Select.
     1507           case v-fh:data-type:
     1508             when 'character':U then do:
     1509               chExcelApplication:Selection:NumberFormat = "@".
     1510             end.
     1511             when 'date':U then do:
     1512               case v-excel-short-date:
     1513                 when string(0) then do:
     1514                   chExcelApplication:Selection:NumberFormat = substitute("mm&1dd&1yyyy", v-excel-date-separ).
     1515                 end.
     1516                 when string(1) then do:
     1517                   chExcelApplication:Selection:NumberFormat = substitute("dd&1mm&1yyyy", v-excel-date-separ).
     1518                 end.
     1519                 when string(2) then do:
     1520                   chExcelApplication:Selection:NumberFormat = substitute("yyyy&1mm&1dddd", v-excel-date-separ).
     1521                 end.
     1522               end case.
     1523             end.
     1524             when 'decimal':U then do:
     1525               chExcelApplication:Selection:NumberFormat = replace(substitute("0.&1"
     1526                                                                             , fill(string(0), length(entry(2, v-fh:format, ".")))
     1527                                                                             ), ".", v-excel-dec-separ).
     1528             end.
     1529             when 'integer':U then do:
     1530               chExcelApplication:Selection:NumberFormat = "0".
     1531             end.
     1532             when 'logical':U then do:
     1533               chExcelApplication:Selection:NumberFormat = "@".
     1534             end.
     1535           end case.
     1536         end.
     1537         else do:
     1538           if v-ii = 1 then do:
     1539             v-qh:get-next() no-error.
     1540             if v-qh:query-off-end then do:
     1541               p-num-rec = p-num-rec - 1.
     1542               leave _row.
     1543             end.
     1544           end.
     1545           v-print = yes.
     1546           case v-fh:data-type:
     1547             when 'character':U then do:
     1548               if v-fh:buffer-value = ? then do:
     1549                 v-text = chr(63).
     1550               end.
     1551               else do:
     1552                 assign
     1553                 v-text = v-fh:buffer-value
     1554                 .
     1555               end.
     1556             end.
     1557             when 'date':U then do:
     1558               if v-fh:buffer-value = ? then do:
     1559                 v-print = no.
     1560               end.
     1561               else do:
     1562                 assign
     1563                 v-dop = string(v-fh:buffer-value, "99/99/9999")
     1564                 .
     1565                 case v-excel-short-date:
     1566                   when string(0) then do:
     1567                     assign
     1568                     v-text = v-dop.
     1569                   end.
     1570                   when string(1) then do:
     1571                     assign
     1572                     v-text = entry(2, v-dop, chr(47)) + chr(47) +
     1573                             entry(1, v-dop, chr(47)) + chr(47) +
     1574                             entry(3, v-dop, chr(47))
     1575                     no-error
     1576                     .
     1577                   end.
     1578                   when string(2) then do:
     1579                     assign
     1580                     v-text = entry(3, v-dop, chr(47)) + chr(47) +
     1581                             entry(1, v-dop, chr(47)) + chr(47) +
     1582                             entry(2, v-dop, chr(47))
     1583                     no-error
     1584                     .
     1585                   end.
     1586                 end case.
     1587               end.
     1588             end.
     1589             when 'decimal':U then do:
     1590               if v-fh:buffer-value = ? then do:
     1591                 v-print = no.
     1592               end.
     1593               else do:
     1594                 assign
     1595                 v-dop = string(v-fh:buffer-value)
     1596                 v-text = replace(v-dop, ".", chr(1))
     1597                 v-text = replace(v-dop, ",", chr(2))
     1598                 v-text = replace(v-dop, chr(1), v-excel-dec-separ)
     1599                 v-text = replace(v-dop, chr(2), v-excel-th-separ)
     1600                 .
     1601               end.
     1602             end.
     1603             when 'integer':U then do:
     1604               if v-fh:buffer-value = ? then do:
     1605                 v-print = no.
     1606               end.
     1607               else do:
     1608                 assign
     1609                 v-text = string(v-fh:buffer-value)
     1610                 .
     1611               end.
     1612             end.
     1613             when 'logical':U then do:
     1614               if v-fh:buffer-value = ? then do:
     1615                 v-print = no.
     1616               end.
     1617               assign
     1618               v-text = string(v-fh:buffer-value, "true/false")
     1619               no-error
     1620               .
     1621             end.
     1622           end case.
     1623         end.
     1624         if v-print then do:
     1625           assign
     1626           chWorkSheet:range( substitute("&1&2", dyneximp_excel-col-name(v-ii), v-row)):value = v-text
     1627           no-error
     1628           .
     1629           if error-status:error then do:
     1630             run value(p-err-proc) in p-call-handle ( input substitute("Ошибка при импорте поля &1 (&5) из строки &2:&3&4"
     1631                                             , v-fh:column-label
     1632                                             , v-row
     1633                                             , chr(10)
     1634                                             , error-status:get-message(1)
     1635                                             , v-fh:name
     1636                                             )) no-error .
     1637             next _row.
     1638           end.
     1639         end.
     1640       end.
     1641       if v-row > v-head-row then do:
