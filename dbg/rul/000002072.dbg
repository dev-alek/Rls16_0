      653   PROCEDURE write-bonus :
      654   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
      655   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
      656   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
      657   define input  parameter v-bonus as decimal   no-undo .
      658     do
      659     on error undo, return error return-value
      660     :
      661       find first ub.contract-specif-attr exclusive-lock  where
      662                  ub.contract-specif-attr.contract-num = p-contract-num  and
      663                  ub.contract-specif-attr.host-code    = p-host-code     and
      664                  ub.contract-specif-attr.gds-code     = p-gds-code      and
      665                  ub.contract-specif-attr.attr-code    = 'bonus':U
      666                 no-error .
      667         if not available ub.contract-specif-attr then do:
      668            create ub.contract-specif-attr .
      669            assign
      670                 ub.contract-specif-attr.contract-num = p-contract-num
      671                 ub.contract-specif-attr.host-code    = p-host-code
      672                 ub.contract-specif-attr.gds-code     = p-gds-code
      673                 ub.contract-specif-attr.attr-code    = 'bonus':U
      674            .
      675         end.
      676         ub.contract-specif-attr.attr-value  = string (v-bonus) .
      677   end.
      678   END PROCEDURE.
      679   PROCEDURE read-bonus :
      680   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
      681   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
      682   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
      683   define output parameter v-bonus as decimal   no-undo .
      684     do
      685     on error undo, return error return-value
      686     :
      687   find first ub.contract-specif-attr no-lock  where
      688              ub.contract-specif-attr.contract-num = p-contract-num  and
      689              ub.contract-specif-attr.host-code    = p-host-code     and
      690              ub.contract-specif-attr.gds-code     = p-gds-code      and
      691              ub.contract-specif-attr.attr-code    = 'bonus':U
      692              no-error .
      693      if available ub.contract-specif-attr then  v-bonus = decimal (ub.contract-specif-attr.attr-value ) .
      694                                           else  v-bonus = 0 .
      695   end.
      696   END PROCEDURE.
      697   PROCEDURE write-prc-min :
      698   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
      699   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
      700   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
      701   define input  parameter v-prc-min        as decimal   no-undo .
      702     do
      703     on error undo, return error return-value
      704     :
      705       find first ub.contract-specif-attr exclusive-lock  where
      706                 ub.contract-specif-attr.contract-num = p-contract-num  and
      707                 ub.contract-specif-attr.host-code    = p-host-code     and
      708                 ub.contract-specif-attr.gds-code     = p-gds-code      and
      709                 ub.contract-specif-attr.attr-code    = 'prc-min':U
      710                 no-error .
      711         if not available ub.contract-specif-attr then do:
      712            create ub.contract-specif-attr .
      713            assign
      714                 ub.contract-specif-attr.contract-num = p-contract-num
      715                 ub.contract-specif-attr.host-code    = p-host-code
      716                 ub.contract-specif-attr.gds-code     = p-gds-code
      717                 ub.contract-specif-attr.attr-code    = 'prc-min':U
      718                 ub.contract-specif-attr.attr-value  = string (v-prc-min)
      719            .
      720         end.
      721         else do:
      722            ub.contract-specif-attr.attr-value  = string (v-prc-min) .
      723         end.
      724       find first ub.contract-specif exclusive-lock where
      725           ub.contract-specif.contract-num = p-contract-num and
      726           ub.contract-specif.host-code    = p-host-code    and
      727           ub.contract-specif.gds-code     = p-gds-code.
      728           ub.contract-specif.whole-send-news  = ub.contract-specif.whole-send-news + 1.
      729   end.
      730   END PROCEDURE.
      731   PROCEDURE read-prc-min :
      732   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
      733   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
      734   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
      735   define output parameter v-prc-min as decimal   no-undo .
      736     do
      737     on error undo, return error return-value
      738     :
      739   find first ub.contract-specif-attr no-lock  where
      740              ub.contract-specif-attr.contract-num = p-contract-num  and
      741              ub.contract-specif-attr.host-code    = p-host-code     and
      742              ub.contract-specif-attr.gds-code     = p-gds-code      and
      743              ub.contract-specif-attr.attr-code    = 'prc-min':U
      744              no-error .
      745      if available ub.contract-specif-attr then  v-prc-min = decimal (ub.contract-specif-attr.attr-value ) .
      746                                           else  v-prc-min = 0 .
      747   end.
      748   END PROCEDURE.
      749   PROCEDURE write-retro-bonus :
      750   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
      751   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
      752   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
      753   define input  parameter v-retro-bonus as character   no-undo .
      754     do
      755     on error undo, return error return-value
      756     :
      757       find first ub.contract-specif-attr exclusive-lock  where
      758                 ub.contract-specif-attr.contract-num = p-contract-num  and
      759                 ub.contract-specif-attr.host-code    = p-host-code     and
      760                 ub.contract-specif-attr.gds-code     = p-gds-code      and
      761                 ub.contract-specif-attr.attr-code    = "retro-bonus"
      762                 no-error .
      763         if not available ub.contract-specif-attr then do:
      764            create ub.contract-specif-attr .
      765            assign
      766                 ub.contract-specif-attr.contract-num = p-contract-num
      767                 ub.contract-specif-attr.host-code    = p-host-code
      768                 ub.contract-specif-attr.gds-code     = p-gds-code
      769                 ub.contract-specif-attr.attr-code    = "retro-bonus"
      770            .
      771            ub.contract-specif-attr.attr-value  = v-retro-bonus no-error.
      772            if error-status:error then
      773               message "Превышен допустимый объем информации о ретро-бонусах. Удалите исторические или неактуальны периоды" view-as alert-box error.
      774         end.
      775         else do:
      776            ub.contract-specif-attr.attr-value  = v-retro-bonus no-error.
      777            if error-status:error then
      778               message "Превышен допустимый объем информации о ретро-бонусах. Удалите исторические или неактуальны периоды" view-as alert-box error.
      779         end.
      780       find first ub.contract-specif exclusive-lock where
      781           ub.contract-specif.contract-num = p-contract-num and
      782           ub.contract-specif.host-code    = p-host-code    and
      783           ub.contract-specif.gds-code     = p-gds-code.
      784           ub.contract-specif.whole-send-news  = ub.contract-specif.whole-send-news + 1.
      785   end.
      786   END PROCEDURE.
      787   PROCEDURE read-retro-bonus :
      788   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
      789   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
      790   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
      791   define output parameter v-retro-bonus as character   no-undo .
      792     do
      793     on error undo, return error return-value
      794     :
      795   find first ub.contract-specif-attr no-lock  where
      796              ub.contract-specif-attr.contract-num = p-contract-num  and
      797              ub.contract-specif-attr.host-code    = p-host-code     and
      798              ub.contract-specif-attr.gds-code     = p-gds-code      and
      799              ub.contract-specif-attr.attr-code    = "retro-bonus"
      800              no-error .
      801      if available ub.contract-specif-attr then  v-retro-bonus = ub.contract-specif-attr.attr-value  .
      802                                           else  v-retro-bonus = "" .
      803   end.
      804   END PROCEDURE.
      805   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      806   procedure SpecGr-gds-code-yes :
      807   define input  parameter p-gds-code   as integer   no-undo .
      808   define input  parameter p-node-code  as integer   no-undo .
      809   define input  parameter p-contract-num         as integer   no-undo .
      810   define input  parameter p-host-code     as integer   no-undo .
      811   define output parameter p-ask        as logical   no-undo .
      812   define buffer buf_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
      813   define buffer buf1_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
      814   define buffer buf_goods   for ub.goods  .
      815   define buffer buf_gds-grp for ub.gds-grp  .
      816   define variable v-grp-qnty as integer   no-undo .
      817   define variable v-grp-lim as integer   no-undo .
      818     do
      819     on error undo, return error return-value
      820     :
      821   p-ask = ? .
      822   find first buf_goods no-lock where buf_goods.gds-code = p-gds-code .
      823   find first buf_gds-grp-obj-attr no-lock where
      824              buf_gds-grp-obj-attr.attr-code = 'LimSpecGr':U and
      825              buf_gds-grp-obj-attr.obj-type  = string(p-contract-num) and
      826              buf_gds-grp-obj-attr.obj-code  = p-host-code and
      827              buf_gds-grp-obj-attr.host-code = 0 and
      828              buf_gds-grp-obj-attr.node-code = p-node-code no-error .
      829   if error-status :error then do:
      830     p-ask = true .
      831     return .
      832   end.
      833   if buf_gds-grp-obj-attr.attr-value  = "0" then do:
      834     p-ask = false  .
      835     return .
      836   end.
      837     if buf_gds-grp-obj-attr.attr-value  = "" or
      838       buf_gds-grp-obj-attr.attr-value  = ?  or
      839       buf_gds-grp-obj-attr.attr-value  = "?" then do:
      840       find first buf_gds-grp no-lock where
      841                   buf_gds-grp.node-code = p-node-code no-error .
      842         if available buf_gds-grp  then do:
      843             if buf_gds-grp.upper-code = 0 then do:
      844                 p-ask = true .
      845                 return .
      846             end.
      847             else do:
      848                 run SpecGr-gds-code-yes (
      849                    input   p-gds-code
      850                   ,input   buf_gds-grp.upper-code
      851                   ,input   p-contract-num
      852                   ,input   p-host-code
      853                   ,output  p-ask
      854                   ).
      855                 if p-ask <> ? then return .
      856           end.
      857         end.
      858     end.
      859     else do:
      860       v-grp-lim = int (buf_gds-grp-obj-attr.attr-value) no-error  .
      861       if v-grp-lim > 0 then do:
      862           v-grp-qnty = 0 .
      863           find first buf1_gds-grp-obj-attr no-lock where
      864                      buf1_gds-grp-obj-attr.attr-code = 'QntySpecGr':U and
      865                      buf1_gds-grp-obj-attr.obj-type  = string(p-contract-num) and
      866                      buf1_gds-grp-obj-attr.obj-code  = p-host-code and
      867                      buf1_gds-grp-obj-attr.host-code = 0 and
      868                      buf1_gds-grp-obj-attr.node-code = p-node-code no-error .
      869           if available buf1_gds-grp-obj-attr then do:
      870             v-grp-qnty = int(buf1_gds-grp-obj-attr.attr-value) .
      871           end.
      872           if v-grp-lim >= v-grp-qnty + 1 then p-ask = true .
      873           else p-ask = false .
      874           return .
      875       end.
      876     end.
      877     end.
      878   end procedure.
      879   procedure recalc-gds-SpecGr :
      880   define input  parameter p-action     as character no-undo .
      881   define input  parameter p-node-code  as integer   no-undo .
      882   define input  parameter p-contract-num         as integer   no-undo .
      883   define input  parameter p-host-code     as integer   no-undo .
      884   define buffer buf_gds-grp for ub.gds-grp  .
      885   define buffer curr_gds-grp for ub.gds-grp  .
      886   define buffer buf1_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
      887   define variable kk as character no-undo .
      888     do
      889     on error undo, return error return-value
      890     :
      891       find first buf1_gds-grp-obj-attr exclusive-lock where
      892                  buf1_gds-grp-obj-attr.attr-code = 'QntySpecGr':U and
      893                  buf1_gds-grp-obj-attr.obj-type  = string(p-contract-num) and
      894                  buf1_gds-grp-obj-attr.obj-code  = p-host-code and
      895                  buf1_gds-grp-obj-attr.host-code = 0 and
      896                  buf1_gds-grp-obj-attr.node-code = p-node-code
      897                  no-error .
      898       if available buf1_gds-grp-obj-attr then do:
      899          if p-action = '+' then  do:
      900             kk = string( int( buf1_gds-grp-obj-attr.attr-value ) + 1 ).
      901          end.
      902          else do:
      903             kk = string( int( buf1_gds-grp-obj-attr.attr-value ) - 1 ).
      904          end.
      905          buf1_gds-grp-obj-attr.attr-value = kk .
      906       end.
      907       else do:
      908           if p-action = '+' then  do:
      909               create buf1_gds-grp-obj-attr .
      910                 assign
      911                   buf1_gds-grp-obj-attr.attr-code  = 'QntySpecGr':U
      912                   buf1_gds-grp-obj-attr.obj-type   = string(p-contract-num)
      913                   buf1_gds-grp-obj-attr.obj-code   = p-host-code
      914                   buf1_gds-grp-obj-attr.host-code  = 0
      915                   buf1_gds-grp-obj-attr.node-code  = p-node-code
      916                   buf1_gds-grp-obj-attr.attr-value = "1"
      917                 .
      918           end.
      919       end.
      920      FIND FIRST curr_gds-grp WHERE
      921                 curr_gds-grp.node-code = p-node-code
      922           NO-LOCK NO-ERROR.
      923      if AVAILABLE curr_gds-grp AND curr_gds-grp.upper-code > 0 then do:
      924         run recalc-gds-SpecGr (p-action ,curr_gds-grp.upper-code,p-contract-num,p-host-code ) .
      925      end.
      926     end.
      927   end procedure.
      928   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      929   procedure contrcth_write-hist :
      930   define input parameter p-host-code as integer no-undo .
      931   define input parameter p-contract-code as integer no-undo .
      932   define variable p-sys-time   as character no-undo .
      933   define buffer buf_contract for ub.contract.
      934   define buffer buf_c-contract for c-contract.
      935   do
      936   on error undo, return error
      937   :
      938     find first buf_contract exclusive-lock where
      939                 buf_contract.host-code = p-host-code
      940             and buf_contract.contract-code = p-contract-code .
      941     create buf_c-contract .
      942     BUFFER-COPY buf_contract TO buf_c-contract .
      943   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      944   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdburt in g#library
      945     (output buf_contract.user-db-num
      946     ,output buf_contract.user-name
      947     ,output buf_contract.spec-date
      948     ,output p-sys-time
      949     ,output buf_contract.spec-time
      950     )  .
      951     assign
      952     buf_c-contract.chip-num         = next-value (s-corr-chip, ub)
      953     buf_c-contract.corr-user-db-num = buf_contract.user-db-num
      954     buf_c-contract.corr-user-name   = buf_contract.user-name
      955     buf_c-contract.corr-date        = buf_contract.spec-date
      956     buf_c-contract.corr-time        = buf_contract.spec-time
      957     .
      958   end.
      959   end procedure.
      960   define variable file-name as character no-undo .
      961   define variable p-delimiter as character no-undo.
      962   define variable p-start-row as integer no-undo.
      963   define variable log-file-name                as character      no-undo init "process-edoc.txt".
      964   define variable v-view-log                   as logical        no-undo .
      965   define variable v-stop                       as logical        no-undo .
      966   define variable v-rid                        as recid          no-undo .
      967   define stream InStream.
      968   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      969   FUNCTION dyneximp_export returns character (
      970                                                 INPUT p-bh  AS HANDLE
      971                                                ,INPUT p-delim   AS CHARACTER
      972                                                ,input p-order as character
      973                                                ,input p-except-field-list as character
      974                                                ):
      975   define variable v-fh    AS HANDLE no-undo .
      976   define variable v-ii    AS INTEGER no-undo .
      977   define variable iextnt  as integer no-undo .
      978   define variable v-char   as character no-undo .
      979   define variable carray  as character no-undo .
      980   define variable v-result as character no-undo .
      981   define variable v-num-fields as integer no-undo .
      982   if p-bh:type <> "buffer" then do:
      983     return ?.
      984   end.
      985   if p-order = '' then do:
      986     v-num-fields = p-bh:num-fields.
      987   end.
      988   else do:
      989     v-num-fields = num-entries(p-order).
      990     if v-num-fields > p-bh:num-fields then do:
      991       return ?.
      992     end.
      993   end.
      994   _do:
      995   do v-ii = 1 to v-num-fields:
      996     if p-order = '' then do:
      997       assign
      998       v-fh = p-bh:buffer-field(v-ii)
      999       no-error
     1000       .
     1001     end.
     1002     else do:
     1003       assign
     1004       v-fh = p-bh:buffer-field(entry(v-ii, p-order))
     1005       no-error
     1006       .
     1007     end.
     1008     if error-status:error
     1009     or not valid-handle(v-fh) then do:
     1010     return ?.
     1011     end.
     1012     if lookup(v-fh:name, p-except-field-list) > 0 then next _do.
     1013     if v-fh:extent = 0 then do:
     1014       assign
     1015       v-char = (if v-fh:buffer-value = ?
     1016                 then chr(63)
     1017                 else (if v-fh:data-type = 'character':U
     1018                       then (if p-delim = chr(32)
     1019                             then quoter(v-fh:buffer-value)
     1020                             else string(v-fh:buffer-value))
     1021                       else (if v-fh:data-type = 'raw':U
     1022                             then ( if p-delim = chr(32)
     1023                                    then (chr(34) + string(v-fh:buffer-value) + chr(34))
     1024                                    else string(v-fh:buffer-value) )
     1025                             else string(v-fh:buffer-value)
     1026                             )
     1027                      )
     1028                 )
     1029        v-result = (if v-ii = 1
     1030                    then v-char
     1031                    else v-result + p-delim + v-char)
     1032        .
     1033     end.
     1034     else do:
     1035       do iextnt = 1 to v-fh:extent:
     1036         assign
     1037         v-char = (if v-fh:buffer-value(iextnt) = ?
     1038                   then chr(63)
     1039                   else (if v-fh:data-type = 'character':U
     1040                         then (if p-delim = chr(32)
     1041                               then quoter(v-fh:buffer-value(iextnt))
     1042                               else string(v-fh:buffer-value(iextnt))
     1043                               )
     1044                         else (if v-fh:data-type = 'raw':U
     1045                              then (if p-delim = chr(32)
     1046                                    then (chr(34) + string(v-fh:buffer-value(iextnt)) + chr(34))
     1047                                    else string(v-fh:buffer-value(iextnt)))
     1048                              else string(v-fh:buffer-value(iextnt))
     1049                              )
     1050                         )
     1051                  )
     1052         carray = (if iextnt = 1
     1053                   then v-char
     1054                  else carray + p-delim + v-char)
     1055         .
     1056       end.
     1057       assign
     1058       v-result = (if v-ii = 1
     1059                   then carray
     1060                  else v-result + p-delim + carray)
     1061       .
     1062     end.
     1063   end.
     1064   return v-result.
     1065   end FUNCTION.
     1066   procedure dyneximp_dump-import  :
     1067   define input parameter p-bh as handle no-undo .
     1068   define input parameter p-order as character no-undo .
     1069   define input parameter p-except-field-list as character no-undo .
     1070   define input parameter p-line-num-field as character no-undo .
     1071   define input parameter p-call-handle as handle no-undo .
     1072   define input parameter p-err-proc as character no-undo .
     1073   define output parameter p-num-rec as integer no-undo .
     1074   define output parameter p-num-rec-ok as integer no-undo .
     1075   define variable v-import  as character   no-undo extent 512.
     1076   define variable v-iimp    as integer     no-undo .
     1077   define variable v-ii      as integer     no-undo .
     1078   define variable v-iextnt    as integer     no-undo .
     1079   define variable v-fh      as handle      no-undo .
     1080   define variable v-result  as logical no-undo .
     1081   define variable v-line-num as integer no-undo .
     1082   define variable v-lnfh as handle no-undo .
     1083   define variable glog as logical no-undo .
     1084   define variable v-num-fields as integer no-undo .
     1085   if p-bh:type <> "buffer" then do:
     1086     return error substitute("Неверный тип handle передан процедуре").
     1087   end.
     1088   if p-line-num-field <> '' then do:
     1089     assign
     1090     v-lnfh = p-bh:buffer-field(p-line-num-field)
     1091     no-error .
     1092     if not valid-handle(v-lnfh) then do:
     1093       return error substitute("Нет поля &1 в таблице &2, буфер которой передан", p-line-num-field, p-bh:name).
     1094     end.
     1095   end.
     1096   if p-order = '' then do:
     1097     v-num-fields = p-bh:num-fields.
     1098   end.
     1099   else do:
     1100     v-num-fields = num-entries(p-order).
     1101   end.
     1102   if v-num-fields > p-bh:num-fields then do:
     1103     return error substitute("В переданной последовательности полей &1 число полей больше, чем в таблице &2, буффер которой передан"
     1104                              , p-order
     1105                              , p-bh:name
     1106                              ).
     1107   end.
     1108   _repeat:
     1109   repeat:
     1110     assign
     1111     v-import = ""
     1112     v-iimp = 0
     1113     v-line-num = v-line-num + 1
     1114     .
     1115     import stream Instream v-import.
     1116     p-num-rec = p-num-rec + 1.
     1117     p-bh:buffer-create().
     1118     if valid-handle(v-lnfh) then do:
     1119       v-lnfh:buffer-value = v-line-num.
     1120     end.
     1121     _do:
     1122     do v-ii = 1 to v-num-fields:
     1123       if p-order = '' then do:
     1124         assign
     1125         v-fh = p-bh:buffer-field(v-ii)
     1126         no-error
     1127         .
     1128       end.
     1129       else do:
     1130         assign
     1131         v-fh = p-bh:buffer-field(entry(v-ii, p-order))
     1132         no-error
     1133         .
     1134       end.
     1135       if error-status:error
     1136       or not valid-handle(v-fh) then do:
     1137         return error substitute("В переданной последовательности полей &1 указано несуществующее в таблице &2 поле &3"
     1138                                 , p-order
     1139                                 , p-bh:name
     1140                                 , entry(v-ii, p-order)
     1141                                 ).
     1142       end.
     1143       if lookup(v-fh:name, p-except-field-list) > 0 then next _do.
     1144       if v-fh:extent = 0 then do:
     1145         assign
     1146         v-iimp = v-iimp + 1
     1147         v-fh:buffer-value = v-import[v-iimp]
     1148         no-error
     1149         .
     1150         if error-status:error then do:
     1151           p-bh:buffer-delete().
     1152           run value(p-err-proc) in p-call-handle ( input substitute("Ошибка при импорте поля &1 (&5) записи из строки &2&3&4"
     1153                                                                   , v-fh:column-label
     1154                                                                   , v-line-num
     1155                                                                   , chr(10)
     1156                                                                   , error-status:get-message(1)
     1157                                                                   , v-fh:name
     1158                                                                   )
     1159                                                                   )
     1160                                                                   .
     1161           next _repeat.
     1162         end.
     1163       end.
     1164       else do:
     1165         do v-iextnt = 1 to v-fh:extent:
     1166           assign
     1167           v-iimp = v-iimp + 1
     1168           v-fh:buffer-value(v-iextnt) = v-import[v-iimp]
     1169           no-error
     1170           .
     1171           if error-status:error then do:
     1172             p-bh:buffer-delete().
     1173             run value(p-err-proc) in p-call-handle ( input substitute("Ошибка при импорте поля &1 (&5) записи из строки &2&3&4"
     1174                                                                     , v-fh:column-label
     1175                                                                     , v-line-num
     1176                                                                     , chr(10)
     1177                                                                     , error-status:get-message(1)
     1178                                                                     , v-fh:name
     1179                                                                     )
     1180                                                                     )
     1181                                                                   .
     1182             next _repeat.
     1183           end.
     1184         end.
     1185       end.
     1186     end.
     1187     assign
     1188     glog = p-bh:buffer-validate()
     1189     no-error
     1190     .
     1191     if error-status:error then do:
     1192       p-bh:buffer-delete().
     1193       run value(p-err-proc) in p-call-handle ( substitute("Ошибка при импорте записи из строки &1&2&3"
     1194                                                   , v-line-num
     1195                                                   , chr(10)
     1196                                                   , error-status:get-message(1) )) no-error .
     1197       next _repeat.
     1198     end.
     1199     p-num-rec-ok = p-num-rec-ok + 1.
     1200   end.
     1201   end procedure.
     1202   function dyneximp_import returns logical (
     1203                                              input p-bh as handle
     1204                                             ,input p-delim as character
     1205                                             ,input p-str as character
     1206                                             ,input p-order as character
     1207                                             ,input p-except-field-list as character
     1208                                             ,output p-mes as character
     1209                                             ):
     1210   define variable v-entries as integer no-undo .
     1211   define variable v-num-fields as integer no-undo .
     1212   define variable v-except-fields as integer no-undo .
     1213   define variable v-ii as integer no-undo .
     1214   define variable v-fh as handle no-undo .
     1215   define variable v-iimp as integer no-undo .
     1216   define variable v-iextnt as integer no-undo .
     1217   define variable v-created as logical no-undo .
     1218   if p-bh:type <> "buffer" then do:
     1219     p-mes = "Для импорта передан handle неверного типа".
     1220     return no.
     1221   end.
     1222   if p-order = '' then do:
     1223     v-num-fields = p-bh:num-fields.
     1224   end.
     1225   else do:
     1226     v-num-fields = num-entries(p-order) .
     1227     if v-num-fields > p-bh:num-fields then do:
     1228       p-mes =  substitute("В переданной последовательности полей &1 число полей больше, чем в таблице &2, буффер которой передан"
     1229                               , p-order
     1230                               , p-bh:name
     1231                               ).
     1232       return no.
     1233     end.
     1234   end.
     1235   v-entries = num-entries(p-str, p-delim).
     1236   v-except-fields = (if p-except-field-list = '' then 0 else num-entries(p-except-field-list)).
     1237   if v-entries < v-num-fields - v-except-fields then do:
     1238     p-mes = substitute("Количество полей в строке импорта (&1) с учетом разделителя (&2) меньше количества выбранных полей (&3)"
     1239                        , num-entries(p-str, p-delim)
     1240                        , p-delim
     1241                        , v-num-fields
     1242                       )
     1243                      .
     1244     return no.
     1245   end.
     1246   if p-bh:available = no then do:
     1247     v-created = yes.
     1248     p-bh:buffer-create().
     1249   end.
     1250   do v-ii = 1 to v-num-fields:
     1251     if p-order = '' then do:
     1252       assign
     1253       v-fh = p-bh:buffer-field(v-ii)
     1254       no-error
     1255       .
     1256     end.
     1257     else do:
     1258       assign
     1259       v-fh = p-bh:buffer-field(entry(v-ii, p-order))
     1260       no-error
     1261       .
     1262     end.
     1263     if error-status:error
     1264     or not valid-handle(v-fh) then do:
     1265       p-mes = substitute("В переданной последовательности полей &1 указано несуществующее в таблице &2 поле &3"
     1266                               , p-order
     1267                               , p-bh:name
     1268                               , entry(v-ii, p-order)
     1269                               ).
     1270       if v-created then do:
     1271         p-bh:buffer-delete().
     1272       end.
     1273       return no.
     1274     end.
     1275     if v-fh:extent = 0 then do:
     1276       assign
     1277       v-iimp = v-iimp + 1
     1278       .
     1279       if v-iimp > v-entries - v-except-fields then do:
     1280         p-mes = substitute("Количество полей в строке импорта (&1) с учетом разделителя (&2) меньше количества выбранных полей (&3) "
     1281                           , num-entries(p-str, p-delim)
     1282                           , p-delim
     1283                           , v-num-fields
     1284                           )
     1285                             .
     1286         if v-created then do:
     1287           p-bh:buffer-delete().
     1288         end.
     1289         return no.
     1290       end.
     1291       assign
     1292       v-fh:buffer-value = entry(v-iimp, p-str, p-delim)
     1293       no-error
     1294       .
     1295       if error-status:error then do:
     1296         if v-created then do:
     1297           p-bh:buffer-delete().
     1298         end.
     1299         p-mes = substitute("Ошибка при импорте поля номер &1:&2&3"
     1300                            , v-iimp
     1301                            ,chr(10)
     1302                            , error-status:get-message(1) ).
     1303         return no.
     1304       end.
     1305     end.
     1306     else do:
     1307       do v-iextnt = 1 to v-fh:extent:
     1308         assign
     1309         v-iimp = v-iimp + 1
     1310         .
     1311         if v-iimp > v-entries - v-except-fields then do:
     1312           p-mes = substitute("Количество полей в строке импорта (&1) с учетом разделителя (&2) меньше количества выбранных полей (&3) "
     1313                             , num-entries(p-str, p-delim)
     1314                             , p-delim
     1315                             , v-num-fields
     1316                             )
     1317                               .
     1318           if v-created then do:
     1319             p-bh:buffer-delete().
     1320           end.
     1321           return no.
     1322         end.
     1323         assign
     1324         v-fh:buffer-value(v-iextnt) = entry(v-iimp, p-str, p-delim)
     1325         no-error
     1326         .
     1327         if error-status:error then do:
     1328           if v-created then do:
     1329             p-bh:buffer-delete().
     1330           end.
     1331           p-mes = substitute("Ошибка при импорте поля номер &1:&2&3"
     1332                             , v-iimp
     1333                             ,chr(10)
     1334                             , error-status:get-message(1) ).
     1335           return no.
     1336         end.
     1337       end.
     1338     end.
     1339   end.
     1340   return yes.
     1341   end function.
     1342   function dyneximp_excel-col-name returns character ( input p-col as integer):
     1343   define variable v-str as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWZYX".
     1344   return substring(v-str, p-col, 1).
     1345   end.
     1346   procedure dyneximp_export-excel :
     1347   define input parameter p-filename as character no-undo .
     1348   define input parameter p-start-row as integer no-undo .
     1349   define input parameter p-bh as handle no-undo .
     1350   define input parameter p-order as character no-undo .
     1351   define input parameter p-except-field-list as character no-undo .
     1352   define input parameter p-call-handle as handle no-undo .
     1353   define input parameter p-err-proc as character no-undo .
     1354   define output parameter p-num-rec as integer no-undo .
     1355   define output parameter p-num-rec-ok as integer no-undo .
     1356   define variable chExcelApplication as com-handle no-undo .
     1357   define variable chWorkbook         as com-handle no-undo .
     1358   define variable chWorksheet        as com-handle no-undo .
     1359   define variable chRange            as com-handle no-undo .
     1360   define variable v-last-row as integer no-undo .
     1361   define variable v-last-column as integer no-undo .
     1362   define variable v-row as integer no-undo .
     1363   define variable v-head-row as integer no-undo .
     1364   define variable v-num-fields as integer no-undo .
     1365   define variable v-ii as integer no-undo .
     1366   DEFINE VARIABLE v-dec-separ      as character no-undo .
     1367   DEFINE VARIABLE v-th-separ       as character no-undo .
     1368   define variable v-line-num as integer no-undo .
     1369   define variable v-lnfh as handle no-undo .
     1370   define variable v-fh as handle no-undo .
     1371   define variable v-text as character no-undo .
     1372   define variable v-dop as character no-undo .
     1373   define variable v-excel-general-format as character no-undo .
     1374   define variable v-excel-short-date as character no-undo .
     1375   define variable v-excel-dec-separ as character no-undo .
     1376   define variable v-excel-th-separ as character no-undo .
     1377   define variable v-excel-date-separ as character no-undo .
     1378   define variable v-qh as handle no-undo .
     1379   define variable v-print as logical no-undo .
     1380   main-block:
     1381   do
     1382   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1383   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1384   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1385   :
     1386     if p-bh:type <> "buffer" then do:
     1387       return error "Для экспорта передан handle неверного типа".
     1388     end.
     1389     if p-order = '' then do:
     1390       v-num-fields = p-bh:num-fields.
     1391     end.
     1392     else do:
     1393       v-num-fields = num-entries(p-order) .
     1394       if v-num-fields > p-bh:num-fields then do:
     1395         return error  substitute("В переданной последовательности полей &1 число полей больше, чем в таблице &2, буффер которой передан"
     1396                                 , p-order
     1397                                 , p-bh:name
     1398                                 ).
     1399       end.
     1400     end.
     1401     create "Excel.Application" chExcelApplication no-error.
     1402       if error-status :error then do:
     1403           message
     1404           "Ошибка при запуске Excel" skip
     1405           error-status :get-message(1) skip
     1406           view-as alert-box error .
     1407           undo, return error .
     1408       end.
     1409     assign
     1410     chExcelApplication:interactive     = false
     1411     chExcelApplication:ScreenUpdating  = false
     1412     chExcelApplication:visible         = false
     1413     chExcelApplication:DisplayAlerts   = false
     1414     .
     1415     assign
     1416     v-excel-general-format =  chExcelApplication:International(26  )
     1417     v-excel-short-date =  chExcelApplication:International(32  )
     1418     v-excel-dec-separ = chExcelApplication:International(3  )
     1419     v-excel-th-separ = chExcelApplication:International(4  )
     1420     v-excel-date-separ = chExcelApplication:International(17  )
     1421     no-error
     1422     .
     1423     v-head-row = maximum(p-start-row - 1, 0).
     1424     v-row = v-head-row - 1.
     1425     chExcelApplication:WorkBooks:Add().
     1426     chWorkbook = chExcelApplication:WorkBooks:Item(1).
     1427     chWorksheet = chWorkbook:ActiveSheet.
     1428     if v-head-row > 0 then do:
     1429       chWorkSheet:Rows(substitute("&1:&1", v-head-row)):Select.
     1430       chExcelApplication:Selection:Font:Bold = True.
     1431     end.
     1432     _row:
     1433     do while true
     1434     on error  undo _row, retry
     1435     on stop   undo _row, retry
     1436     on endkey undo _row, retry
     1437     :
     1438       if retry then do:
     1439   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1440   if valid-handle(chWorkSheet) then
     1441   RELEASE OBJECT chWorkSheet no-error.
     1442   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1443   if valid-handle(chWorkBook) then
     1444   RELEASE OBJECT chWorkBook no-error.
     1445         chExcelApplication:Quit() no-error.
     1446   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1447   if valid-handle(chExcelApplication) then
     1448   RELEASE OBJECT chExcelApplication no-error.
     1449         delete object v-qh no-error.
     1450         return error substitute("Ошибка при экспорте в файл &1:&2&3"
     1451                                 , p-filename
     1452                                 , chr(10)
     1453                                 , error-status:get-message(1)
     1454                                 ).
     1455       end.
     1456       v-row = v-row + 1.
     1457       if v-row > v-head-row then do:
     1458         p-num-rec = p-num-rec + 1.
     1459       end.
     1460       do v-ii = 1 to v-num-fields:
     1461         v-text = ''.
     1462         if p-order = '' then do:
     1463           assign
     1464           v-fh = p-bh:buffer-field(v-ii)
     1465           no-error
     1466           .
     1467         end.
     1468         else do:
     1469           assign
     1470           v-fh = p-bh:buffer-field(entry(v-ii, p-order))
     1471           no-error
     1472           .
     1473         end.
     1474         if error-status:error
     1475         or not valid-handle(v-fh) then do:
     1476   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1477   if valid-handle(chWorkSheet) then
     1478   RELEASE OBJECT chWorkSheet no-error.
     1479   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1480   if valid-handle(chWorkBook) then
     1481   RELEASE OBJECT chWorkBook no-error.
     1482           chExcelApplication:Quit() no-error.
