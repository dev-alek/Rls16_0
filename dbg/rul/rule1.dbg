        1   block-level on error undo, throw.
        2   define input parameter        p-mode as character no-undo .
        3   define input parameter        p-silent as logical no-undo .
        4   define input-output parameter p-rec  as recid     no-undo .
        5   define input parameter        p-rule-id as integer no-undo .
        6   define input parameter        p-codex-id as integer no-undo .
        7   define input parameter        p-upper-rule-id as integer no-undo .
        8   define input parameter        p-root-rule-id as integer no-undo .
        9   define input parameter        p-reusable-params as character no-undo .
       10   define input parameter        p-salience as integer no-undo .
       11   define input parameter        p-name       as character no-undo .
       12   define input parameter        p-documentation  as character no-undo .
       13   define input parameter        p-no-save-mode as integer no-undo .
       14   define input parameter        p-hidden-content as integer no-undo .
       15   define input parameter        p-image-file-name as character no-undo .
       16   define temp-table tt-rule no-undo like ub.rule
       17   field level as integer.
       18   DEFINE INPUT PARAMETER TABLE FOR tt-rule.
       19   define temp-table tt-rule-script no-undo like ub.rule-script
       20   field level as integer
       21   field gen-order as character
       22   field upper_rule_id as integer
       23   .
       24   DEFINE INPUT PARAMETER TABLE FOR tt-rule-script.
       25   define temp-table tt-rule-i-script no-undo like ub.rule-i-script.
       26   DEFINE INPUT PARAMETER TABLE FOR tt-rule-i-script.
       27   define temp-table tt-ruledict-param no-undo like ub.ruledict-param.
       28   DEFINE INPUT PARAMETER TABLE FOR tt-ruledict-param.
       29   define variable vss-revision    as character no-undo init "$Revision$":U .
       30   define variable vss-author      as character no-undo init "$Author$":U .
       31   define variable vss-date        as character no-undo init "$Date$":U .
       32   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       33   define variable vss-archive     as character no-undo init "$Archive$":U .
       34   define variable vss-description as character no-undo init "Сохранение rule".
       35   procedure vss-get-info :
       36     define output parameter p-vss-revision    like vss-revision    no-undo .
       37     define output parameter p-vss-author      like vss-author      no-undo .
       38     define output parameter p-vss-date        like vss-date        no-undo .
       39     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       40     define output parameter p-vss-archive     like vss-archive     no-undo .
       41     define output parameter p-vss-description like vss-description no-undo .
       42     assign
       43       p-vss-revision    = vss-revision
       44       p-vss-author      = vss-author
       45       p-vss-date        = vss-date
       46       p-vss-workfile    = vss-workfile
       47       p-vss-archive     = vss-archive
       48       p-vss-description = vss-description
       49     .
       50   end procedure.
       51   procedure vss-get-parameters :
       52     define output parameter p-vss-parameters as character no-undo .
       53   end procedure.
       54   define new global shared variable g#vssrevis-logger as handle    no-undo .
       55   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       56   define variable v-vssrevis-logger                   as handle    no-undo .
       57   procedure vss-logevent :
       58     define input  parameter p-extra-paramters as character no-undo .
       59     define variable v-vssrevis-parameters as character no-undo .
       60     do
       61     on error undo, return error return-value
       62     :
       63       if  valid-handle(v-vssrevis-logger)
       64       and v-vssrevis-logger :get-signature("logevent") <> ""
       65       then do:
       66         run vss-get-parameters in this-procedure
       67           (output v-vssrevis-parameters
       68           ).
       69         run logevent in v-vssrevis-logger
       70           (input vss-workfile
       71           ,input vss-revision
       72           ,input v-vssrevis-parameters
       73           ,input p-extra-paramters
       74           ).
       75       end.
       76     end.
       77   end procedure.
       78   assign
       79     v-vssrevis-logger = g#vssrevis-logger
       80   .
       81   if  valid-handle(v-vssrevis-logger)
       82   and v-vssrevis-logger :get-signature("logevent") <> ""
       83   then do:
       84     assign
       85       v-vssrevis-logevent = true
       86     .
       87     run vss-logevent in this-procedure (input vss-description) .
       88   end.
       89   define new global shared variable g#language as character no-undo .
       90   if g#language <> '' and g#language <> 'rus':U then do:
       91     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       92   end.
       93   define new global shared variable g#library  as handle no-undo .
       94   define new global shared variable g#library2 as handle no-undo .
       95   define   shared variable g#auto as logical no-undo.
       96   define   shared variable g#news as logical no-undo.
       97   define   shared variable g#oxml as logical no-undo.
       98   define   shared variable g#esys as logical no-undo.
       99   define   shared variable g#news-source-db as integer no-undo.
      100   define   shared variable g#esys-source-esys as integer no-undo.
      101   define   shared variable g#db-num as integer   no-undo .
      102   define   shared variable g#userid as character no-undo .
      103   define   shared variable g#passwd as character no-undo .
      104   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      105   procedure gen-key-rec :
      106     define input  parameter p-tbl-name    as character no-undo.
      107     define input  parameter p-bh_tbl-name as handle    no-undo.
      108     define output parameter p-key-rec     as character no-undo.
      109     do
      110     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      111     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      112     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      113     :
      114       define variable fh               as handle    no-undo .
      115       define variable v-ok             as logical   no-undo .
      116       define variable v-inform         as character no-undo .
      117       define variable v-ind            as integer   no-undo .
      118       define variable v-idx-field-qnty as integer   no-undo .
      119       if p-tbl-name = ?
      120         or p-tbl-name = "":U
      121       then do:
      122         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info0 ).
      123       end.
      124       if not p-bh_tbl-name:available then do:
      125         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info0, p-tbl-name ).
      126       end.
      127       assign
      128         p-key-rec = p-tbl-name
      129         v-inform  = p-bh_tbl-name:index-information(1)
      130         v-ind     = 2
      131       .
      132       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      133       on error undo, return error
      134       :
      135         assign
      136           v-inform = p-bh_tbl-name:index-information( v-ind )
      137           v-ind    = v-ind + 1
      138         .
      139       end.
      140       if v-inform = ?
      141         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      142         or entry( 3, v-inform, ",":U ) <> "1":U
      143       then do:
      144         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, p-tbl-name ).
      145       end.
      146       else do:
      147         assign
      148           v-idx-field-qnty = num-entries( v-inform ) - 4
      149         .
      150         if v-idx-field-qnty < 2 then do:
      151           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, p-tbl-name ).
      152         end.
      153         do v-ind = 1 to v-idx-field-qnty by 2
      154         on error undo, return error
      155         :
      156           assign
      157             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      158             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      159           .
      160         end.
      161       end.
      162       if p-key-rec = ? then do:
      163         assign
      164           p-key-rec = "":U
      165         .
      166         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info0, p-tbl-name ).
      167       end.
      168     end.
      169     return.
      170   end procedure.
      171   procedure gen-where-keyr-tab :
      172     define input  parameter i-tableSerach as character no-undo.
      173     define input  parameter i-tablekey   as character  no-undo.
      174     define input  parameter p-key-rec    as character  no-undo.
      175     define input  parameter p-key-handle as handle     no-undo .
      176     define input  parameter p-db-name    as character  no-undo .
      177     define input  parameter p-tt-handle  as handle     no-undo .
      178     define output parameter o-Where      as character  no-undo.
      179     do
      180     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      181     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      182     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      183     :
      184       define variable v-full-tbl-name  as character no-undo .
      185       define variable bh_tbl-name      as handle    no-undo .
      186       define variable fh_key           as handle    no-undo .
      187       define variable fh_search        as handle    no-undo .
      188       define variable v-field-num      as integer   no-undo .
      189       define variable v-count-fld      as integer   no-undo .
      190       define variable v-inform         as character no-undo .
      191       define variable v-ind            as integer   no-undo .
      192       define variable v-idx-field-qnty as integer   no-undo .
      193       define variable v-field-name     as character no-undo .
      194       define variable v-field-val      as character no-undo .
      195       define variable v-word-link      as character no-undo .
      196       define variable vTable           as character no-undo.
      197       define variable bh_tbl-key       as handle    no-undo .
      198       assign
      199         p-key-rec = trim( p-key-rec )
      200       .
      201       if p-key-handle <> ? then do:
      202         if not valid-handle(p-key-handle)
      203            or p-key-handle:type <> "buffer"
      204         then do:
      205           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info0 ).
      206         end.
      207         if num-entries( p-key-rec, chr(3) ) > 1
      208           or p-key-rec = ?
      209           or p-key-rec = "":U
      210         then do:
      211           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info0, p-key-rec ).
      212         end.
      213       end.
      214       else do:
      215         if p-key-rec = ?
      216           or p-key-rec = "":U
      217         then do:
      218           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info0 ).
      219         end.
      220       end.
      221       assign
      222         vTable = entry( 1 , p-key-rec, chr(3) )
      223       .
      224       if p-tt-handle <> ?
      225         and ( not valid-handle(p-tt-handle)
      226               or p-tt-handle:type <> "buffer"
      227             )
      228       then do:
      229         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info0, vTable, chr(10) ).
      230       end.
      231       if p-tt-handle = ? then do:
      232         assign
      233           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      234         .
      235         create buffer bh_tbl-name for table v-full-tbl-name .
      236       end.
      237       else do:
      238         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      239       end.
      240       assign
      241         v-inform = bh_tbl-name:index-information(1)
      242         v-ind    = 2
      243       .
      244       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      245       on error undo, return error
      246       :
      247         assign
      248           v-inform = bh_tbl-name:index-information( v-ind )
      249           v-ind    = v-ind + 1
      250         .
      251       end.
      252       if v-inform = ?
      253         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      254         or entry( 3, v-inform, ",":U ) <> "1":U
      255       then do:
      256         delete object bh_tbl-name no-error.
      257         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info0, vTable ).
      258       end.
      259       assign
      260         v-idx-field-qnty = num-entries( v-inform ) - 4
      261       .
      262       if v-idx-field-qnty < 2 then do:
      263         delete object bh_tbl-name no-error.
      264         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, vTable ).
      265       end.
      266       assign
      267         o-where     = "where":U
      268         v-word-link = "":U
      269         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      270         v-count-fld = 0
      271       .
      272       if i-tablekey ne "" and i-tablekey ne ?
      273       then do:
      274         assign
      275           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      276         .
      277         create buffer bh_tbl-key for table v-full-tbl-name .
      278       end.
      279       if i-tableSerach ne "" and i-tableSerach ne ?
      280       then do:
      281         delete object bh_tbl-name no-error.
      282         assign
      283           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      284         .
      285         create buffer bh_tbl-name for table v-full-tbl-name .
      286       end.
      287       block_where:
      288       do v-ind = 1 to v-idx-field-qnty by 2
      289       on error undo, return error
      290       :
      291         assign
      292           v-count-fld = v-count-fld + 1
      293         .
      294         if p-key-handle = ?
      295           and v-count-fld > v-field-num
      296         then do:
      297           leave block_where.
      298         end.
      299         define variable VfieldKeyTable as handle no-undo.
      300         assign
      301           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      302           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      303         .
      304         if     bh_tbl-key ne ?
      305         then do:
      306            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      307            if VfieldKeyTable eq ?
      308            then next block_where.
      309         end.
      310         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      311         then
      312            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      313         else
      314            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      315         if p-key-handle = ? then do:
      316           assign
      317             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      318           .
      319         end.
      320         else do:
      321           assign
      322             fh_key = p-key-handle:buffer-field( v-field-name )
      323           .
      324           if fh_key = ?
      325             or not valid-handle( fh_key )
      326           then do:
      327             delete object bh_tbl-name.
      328             if     bh_tbl-key ne ?
      329             then
      330                delete object bh_tbl-key.
      331             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info0, p-key-handle:name, v-field-name ).
      332           end.
      333           assign
      334             v-field-val = fh_key:buffer-value
      335           .
      336         end.
      337         if fh_search:data-type ="character":U then do:
      338           assign
      339             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      340             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      341             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      342             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      343             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      344             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      345             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      346             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      347             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      348             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      349             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      350             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      351             v-field-val = substitute( '"&1"', v-field-val )
      352           .
      353         end.
      354         assign
      355           o-where = substitute( "&1 &2", o-where, v-field-val )
      356         .
      357         if v-word-link = "":U then do:
      358           assign
      359             v-word-link = "and":U
      360           .
      361         end.
      362       end.
      363       delete object bh_tbl-name.
      364       if     bh_tbl-key ne ?
      365       then
      366          delete object bh_tbl-key.
      367       if p-key-handle = ?
      368         and v-count-fld <> v-field-num
      369       then do:
      370         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info0, vTable ).
      371       end.
      372     end.
      373   end procedure.
      374   procedure gen-hn-keyr-tab :
      375     define input  parameter i-tableSerach as character no-undo.
      376     define input  parameter i-tablekey   as character no-undo.
      377     define input  parameter p-key-rec    as character no-undo.
      378     define input  parameter p-key-handle as handle    no-undo .
      379     define input  parameter p-db-name    as character no-undo .
      380     define input  parameter p-tt-handle  as handle    no-undo .
      381     define input  parameter p-stts-lock  as integer   no-undo .
      382     define output parameter o-hn         as handle    no-undo.
      383     define variable v-full-tbl-name as character no-undo.
      384     define variable v-where         as character no-undo.
      385     define variable bh_tbl-name     as handle    no-undo.
      386     define variable vTable          as character no-undo.
      387     do
      388     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      389     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      390     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      391         run gen-where-keyr-tab(i-tableSerach,
      392                                i-tablekey,
      393                                p-key-rec,
      394                                p-key-handle,
      395                                p-db-name,
      396                                p-tt-handle,
      397                                output v-where).
      398         if i-tableSerach ne "" and i-tableSerach ne ?
      399         then do:
      400            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      401            create buffer bh_tbl-name for table v-full-tbl-name .
      402         end.
      403         else do:
      404            if p-tt-handle = ? then do:
      405               assign
      406                  vTable = entry( 1 , p-key-rec, chr(3) )
      407               .
      408               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      409               create buffer bh_tbl-name for table v-full-tbl-name .
      410            end.
      411            else do:
      412               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      413            end.
      414         end.
      415         if p-tt-handle = ? then do:
      416            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      417         end.
      418         else do:
      419            bh_tbl-name:find-first( v-where ) no-error .
      420         end.
      421         o-hn = bh_tbl-name.
      422      end.
      423   end procedure.
      424   procedure gen-hn-keyr :
      425     define input  parameter p-key-rec    as character no-undo.
      426     define input  parameter p-key-handle as handle    no-undo .
      427     define input  parameter p-db-name    as character no-undo .
      428     define input  parameter p-tt-handle  as handle    no-undo .
      429     define input  parameter p-stts-lock  as integer   no-undo .
      430     define output parameter o-hn         as handle    no-undo.
      431     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      432   end.
      433   procedure gen-row-keyr :
      434     define input  parameter p-key-rec    as character no-undo.
      435     define input  parameter p-key-handle as handle    no-undo .
      436     define input  parameter p-db-name    as character no-undo .
      437     define input  parameter p-tt-handle  as handle    no-undo .
      438     define input  parameter p-stts-lock  as integer   no-undo .
      439     define output parameter p-tbl-row    as rowid     no-undo.
      440     define output parameter p-tbl-name   as character no-undo.
      441     define variable vHn as handle no-undo.
      442       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      443       p-tbl-row = if vHn:available then vHn:rowid else ?.
      444       p-tbl-name =  vHn:table.
      445       delete object vHn no-error.
      446     if p-tbl-row = ? then do:
      447       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info0, p-tbl-name, p-key-rec ).
      448     end.
      449     else do:
      450       return.
      451     end.
      452   end procedure.
      453   procedure gen-key-fv :
      454     define input  parameter p-key-rec    as character no-undo .
      455     define output parameter p-field-list as character no-undo .
      456     define output parameter p-value-list as character no-undo.
      457     do
      458     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      459     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      460     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      461     :
      462       define variable v-full-tbl-name  as character no-undo .
      463       define variable bh_tbl-name      as handle    no-undo .
      464       define variable v-tbl-name       as character no-undo .
      465       define variable v-field-num      as integer   no-undo .
      466       define variable v-count-fld      as integer   no-undo .
      467       define variable v-inform         as character no-undo .
      468       define variable v-ind            as integer   no-undo .
      469       define variable v-idx-field-qnty as integer   no-undo .
      470       define variable v-delim-key      as character no-undo .
      471       if p-key-rec = ?
      472         or p-key-rec = "":U
      473       then do:
      474         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info0 ).
      475       end.
      476       assign
      477         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      478         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      479       .
      480       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      481       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info0 ).
      482       assign
      483         v-inform = bh_tbl-name:index-information(1)
      484         v-ind    = 2
      485       .
      486       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      487       on error undo, return error
      488       :
      489         assign
      490           v-inform = bh_tbl-name:index-information( v-ind )
      491           v-ind    = v-ind + 1
      492         .
      493       end.
      494       if v-inform = ?
      495         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      496         or entry( 3, v-inform, ",":U ) <> "1":U
      497       then do:
      498         delete object bh_tbl-name no-error.
      499         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, v-tbl-name ).
      500       end.
      501       assign
      502         v-idx-field-qnty = num-entries( v-inform ) - 4
      503       .
      504       if v-idx-field-qnty < 2 then do:
      505         delete object bh_tbl-name no-error.
      506         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, v-tbl-name ).
      507       end.
      508       assign
      509         p-field-list = "":U
      510         p-value-list = "":U
      511         v-delim-key  = "":U
      512         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      513         v-count-fld  = 0
      514       .
      515       block_where:
      516       do v-ind = 1 to v-idx-field-qnty by 2
      517       on error undo, return error
      518       :
      519         assign
      520           v-count-fld = v-count-fld + 1
      521         .
      522         if v-count-fld > v-field-num then do:
      523           leave block_where.
      524         end.
      525         assign
      526           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      527           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      528         .
      529         if v-ind = 1 then do:
      530           assign
      531             v-delim-key = chr(3)
      532           .
      533         end.
      534       end.
      535       delete object bh_tbl-name.
      536       if v-count-fld <> v-field-num then do:
      537         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info0, v-tbl-name ).
      538       end.
      539     end.
      540   end procedure.
      541   procedure gen-key-field :
      542     define input  parameter p-table      as character no-undo .
      543     define output parameter p-field-list as character no-undo .
      544     do
      545     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      546     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      547     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      548     :
      549       define variable v-full-tbl-name  as character no-undo .
      550       define variable bh_tbl-name      as handle    no-undo .
      551       define variable v-tbl-name       as character no-undo .
      552       define variable v-field-num      as integer   no-undo .
      553       define variable v-count-fld      as integer   no-undo .
      554       define variable v-inform         as character no-undo .
      555       define variable v-ind            as integer   no-undo .
      556       define variable v-idx-field-qnty as integer   no-undo .
      557       define variable v-delim-key      as character no-undo .
      558       if p-table = ?
      559         or p-table = "":U
      560       then do:
      561         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info0 ).
      562       end.
      563       assign
      564         v-tbl-name      = p-table
      565         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      566       .
      567       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      568       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info0 ).
      569       assign
      570         v-inform = bh_tbl-name:index-information(1)
      571         v-ind    = 2
      572       .
      573       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      574       on error undo, return error
      575       :
      576         assign
      577           v-inform = bh_tbl-name:index-information( v-ind )
      578           v-ind    = v-ind + 1
      579         .
      580       end.
      581       if v-inform = ?
      582         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      583         or entry( 3, v-inform, ",":U ) <> "1":U
      584       then do:
      585         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, v-tbl-name ).
      586       end.
      587       assign
      588         v-idx-field-qnty = num-entries( v-inform ) - 4
      589       .
      590       if v-idx-field-qnty < 2 then do:
      591         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, v-tbl-name ).
      592       end.
      593       assign
      594         p-field-list = "":U
      595         v-delim-key  = "":U
      596         v-count-fld  = 0
      597       .
      598       block_where:
      599       do v-ind = 1 to v-idx-field-qnty by 2
      600       on error undo, return error
      601       :
      602         assign
      603           v-count-fld = v-count-fld + 1
      604         .
      605         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      606         if v-ind = 1 then do:
      607           assign
      608             v-delim-key = chr(3)
      609           .
      610         end.
      611       end.
      612       delete object bh_tbl-name.
      613     end.
      614   end procedure.
      615   define variable v-mess as character no-undo .
      616   define variable v-entry as character no-undo .
      617   define variable glog as logical no-undo .
      618   define variable v-entry-id as integer no-undo .
      619   define variable v-uniq-key-rec as character no-undo .
      620   define variable v-num-params as integer no-undo .
      621   define variable v-is-admin-mode as logical no-undo .
      622   define buffer buf_rule for ub.rule.
      623   define buffer buf_rule-by-profile for ub.rule-by-profile.
      624   define buffer buf_rule-by-call for ub.rule-by-call.
      625   define buffer buf_ruleset for ub.ruleset.
      626   define buffer buf_rule-script for ub.rule-script.
      627   define buffer buf_rule-i-script for ub.rule-i-script.
      628   define buffer tree_rule for ub.rule.
      629   define buffer buf_ruledict for ub.ruledict.
      630   define buffer last_ruledict for ub.ruledict.
      631   define buffer buf_ruledict-param for ub.ruledict-param.
      632   if num-entries(p-mode) > 1 then do:
      633     assign
      634     v-is-admin-mode = logical(entry(2, p-mode)) no-error .
      635     p-mode = entry(1, p-mode).
      636   end.
      637   if p-mode <> 'ДОБАВЛЕНИЕ':U
      638   AND p-mode <> 'ИЗМЕНЕНИЕ':U then do:
      639     message vss-workfile vss-revision vss-description skip
      640             "Неверный параметр p-mode - " p-mode
      641     view-as alert-box error .
      642     return error '':u.
      643   end.
      644   if g#db-num <> 0 then do:
      645     message vss-workfile vss-revision vss-description skip
      646             "Запрещено вызывать процедуру в УБД"
      647     view-as alert-box error .
      648     return error '':u.
      649   end.
      650   _main:
      651   do for buf_rule
      652   on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      653   on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
      654   on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
      655   :
      656     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      657       find first buf_rule no-lock where
      658                buf_rule.rule_id = p-rule-id no-error.
      659       if available buf_rule then do:
      660         assign
      661         v-mess = "Уже существует провило c таким id".
      662         run err-mess in this-procedure ( input-output v-mess).
      663         return error (if p-silent = yes then v-mess else '':U).
      664       end.
      665       create buf_rule.
      666       assign
      667       buf_rule.rule_id = p-rule-id
      668       buf_rule.upper_rule_id = p-upper-rule-id
      669       buf_rule.root_rule_id = p-root-rule-id
      670       buf_rule.codex_id = p-codex-id
      671       buf_rule.sts = integer('-10':U)
      672       .
      673       run gen-key-rec in this-procedure ( input 'rule':U
      674                                           ,input buffer buf_rule:handle
      675                                           ,output v-uniq-key-rec).
      676       assign
      677       buf_rule.uniq-key-rec = v-uniq-key-rec
      678       .
      679       find first buf_ruledict where
      680                 buf_ruledict.entry-type = 'rule':U
      681             and buf_ruledict.uniq-key-rec =  v-uniq-key-rec no-error.
      682       if not available buf_ruledict then do:
      683         find last last_ruledict no-lock use-index pi.
      684         create buf_ruledict.
      685         assign
      686         buf_ruledict.entry-type = 'rule':U
      687         buf_ruledict.uniq-key-rec = v-uniq-key-rec
      688         buf_ruledict.entry-id = last_ruledict.entry-id + 1
      689         buf_ruledict.language = "ABL"
      690         .
      691       end.
      692       assign
      693       buf_ruledict.script-al = string(buf_rule.rule_id, "999999999":U)
      694       buf_ruledict.script-nl = buf_rule.name
      695       v-entry-id = buf_ruledict.entry-id
      696       .
      697     end.
      698     if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      699       find first buf_rule exclusive-lock where
      700                 recid(buf_rule) = p-rec .
      701       if buf_rule.sts = integer('99':U)
      702       or buf_rule.sts = integer('98':U)
      703       then do:
      704         assign
      705         v-mess = substitute("Правило находится в статусе &1, изменение невозможно"
      706                            , entry (lookup (string(buf_rule.sts), '-1,-10,0,1,99,98':U), 'готов,нов,исп,удал,удаление,запр.удал':U)
      707                            ).
      708         run err-mess in this-procedure ( input-output v-mess).
      709         return error (if p-silent = yes then v-mess else '':U).
      710       end.
      711       find first buf_ruledict where
      712                 buf_ruledict.entry-type = 'rule':U
      713             and buf_ruledict.uniq-key-rec =  buf_rule.uniq-key-rec no-error.
      714       IF NOT AVAILABLE BUF_RULEDICT THEN DO:
      715         assign
      716         v-mess = substitute("Не найден термин в словаре для правила").
      717         run err-mess in this-procedure ( input-output v-mess).
      718         return error (if p-silent = yes then v-mess else '':U).
      719       END.
      720       v-entry-id = buf_ruledict.entry-id.
      721       if buf_rule.sts <> integer('-10':U) then do:
      722         if p-silent then do:
      723           assign
      724           v-mess = substitute("Правило находится в статусе &1, изменение невозможно"
      725                                , entry (lookup (string(buf_rule.sts), '-1,-10,0,1,99,98':U), 'готов,нов,исп,удал,удаление,запр.удал':U)
      726                                ).
      727           run err-mess in this-procedure ( input-output v-mess).
      728           return error (if p-silent = yes then v-mess else '':U).
      729         end.
      730         else do:
      731           message
      732           substitute("Правило находится в статусе &1, можно изменить только название и описание правила&2" +
      733                      "Продолжить?"
      734                      , entry (lookup (string(buf_rule.sts), '-1,-10,0,1,99,98':U), 'готов,нов,исп,удал,удаление,запр.удал':U)
      735                      , chr(10)
      736                      )
      737           view-as alert-box question buttons YES-NO update glog.
      738           if not glog then do:
      739             return.
      740           end.
      741         end.
      742       end.
      743       if buf_rule.rule_id <> p-rule-id
      744       or buf_rule.upper_rule_id <> p-upper-rule-id
      745       or buf_rule.codex_id <> p-codex-id
      746       or buf_rule.root_rule_id <> p-root-rule-id
      747       then do:
      748         assign
      749         v-mess = substitute("Для уже существующего правила невозможно изменение id, id правила-родителя, id корневого правила и кодекса&1" +
      750                                 "старое значение id, id правила-родителя, корневого правила и кодекса: &2, &3, &4 и &5"
      751                                 , chr(10)
      752                                 , buf_rule.rule_id
      753                                 , buf_rule.upper_rule_id
      754                                 , buf_rule.root_rule_id
      755                                 , buf_rule.codex_id
      756                                 )
      757         .
      758         run err-mess in this-procedure ( input-output v-mess).
      759         return error (if p-silent = yes then v-mess else '':U).
      760       end.
      761       if buf_rule.reusable-params <> p-reusable-params
      762       and buf_rule.reusable-params = "0" then do:
      763         find first buf_rule-by-call no-lock where
      764                   buf_rule-by-call.rule_id = buf_rule.rule_id no-error.
      765         if available buf_rule-by-call then do:
      766           assign
      767           v-mess = substitute("Для уже существующего правила невозможно изменение свойства <ВЫПОЛНЯЕТСЯ МНОГОКРАТНО>,&1" +
      768                                   "если существуют вызовы этого правила"
      769                                   , chr(10)
      770                                   )
      771           .
      772           run err-mess in this-procedure ( input-output v-mess).
      773           return error (if p-silent = yes then v-mess else 'reusable':U).
      774         end.
      775       end.
      776     end.
      777     find first buf_ruleset no-lock where
      778               buf_ruleset.codex_id = p-codex-id
      779             and buf_ruleset.ruleset_id = 0 no-error.
      780     if not available buf_ruleset then do:
      781       assign
      782       v-mess = substitute("Не найден кодекс &1", p-codex-id
      783                               )
      784       .
      785       run err-mess in this-procedure ( input-output v-mess).
      786       return error (if p-silent = yes then v-mess else 'CODEX_ID':U).
      787     end.
      788     if p-upper-rule-id = 0
      789     and p-salience <> 0 THEN DO:
      790       assign
      791       v-mess = substitute("Для корневого правила порядок выполнения всегда должен = 0"
      792                               )
      793       .
      794       run err-mess in this-procedure ( input-output v-mess).
      795       return error (if p-silent = yes then v-mess else 'salience':U).
      796     END.
      797     assign
      798     buf_rule.name = p-name
      799     buf_rule.documentation = p-documentation
      800     buf_rule.image-file-name = p-image-file-name
      801     buf_rule.reusable-params = (if buf_rule.sts = integer('-10':U) or v-is-admin-mode
      802                         then p-reusable-params
      803                         else buf_rule.reusable-params)
      804     buf_rule.salience = (if buf_rule.sts = integer('-10':U)
      805                          then p-salience
      806                          else buf_rule.salience)
      807     buf_rule.no-save-mode = (if buf_rule.sts = integer('-10':U)
      808                             then p-no-save-mode
      809                             else buf_rule.no-save-mode)
      810     buf_rule.hidden-content = p-hidden-content
      811     .
      812     if v-is-admin-mode or buf_rule.sts = integer('-10':U)  then do:
      813       for each tt-rule
      814       on error undo _main, return error  substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      815       :
      816         find first tree_rule where
      817                   tree_rule.rule_id = tt-rule.rule_Id no-error.
      818         if not available tree_rule then do:
      819           create tree_rule.
      820         end.
      821         if tt-rule.rule_id <> p-rule-id then
      822         buffer-copy tt-rule to tree_rule.
      823       end.
      824       for each tree_rule where tree_rule.root_rule_id = buf_rule.rule_id
      825       on error undo _main, return error  substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      826       :
      827         find first tt-rule where
      828                   tt-rule.rule_id = tree_rule.rule_Id no-error.
      829         if not available tt-rule then do:
      830           delete tree_rule.
      831         end.
      832       end.
      833       for each tt-ruledict-param
      834       on error undo _main, return error  substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      835       :
      836         find first buf_ruledict-param where
      837                   buf_ruledict-param.entry-id = v-entry-id
      838               and buf_ruledict-param.param-num = tt-ruledict-param.param-num
      839                no-error.
      840         if not available buf_ruledict-param then do:
      841           create buf_ruledict-param.
      842         end.
      843         buffer-copy tt-ruledict-param
      844         except entry-id
      845         to buf_ruledict-param
      846         assign
      847         buf_ruledict-param.entry-id = v-entry-id
      848         tt-ruledict-param.entry-id = v-entry-id
      849         .
      850       end.
      851       assign
      852       v-num-params = 0.
      853       for each buf_ruledict-param where buf_ruledict-param.entry-id = v-entry-id
      854       on error undo _main, return error  substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      855       :
      856         find first tt-ruledict-param where
      857                   tt-ruledict-param.entry-id = buf_ruledict-param.entry-id
      858               and tt-ruledict-param.param-num = buf_ruledict-param.param-num
      859                no-error.
      860         if not available tt-ruledict-param then do:
      861           delete buf_ruledict-param.
      862         end.
      863         assign
      864         v-num-params = v-num-params + 1
      865         .
      866       end.
      867       buf_rule.num-params = string(v-num-params)
      868       .
      869       for each tt-rule-i-script
      870       on error undo _main, return error  substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      871       :
      872         find first buf_rule-i-script where
      873                   buf_rule-i-script.root_rule_id = tt-rule-i-script.root_rule_id
      874               and buf_rule-i-script.i-script-name = tt-rule-i-script.i-script-name
      875               and buf_rule-i-script.script_id = tt-rule-i-script.script_id no-error.
      876         if not available buf_rule-i-script then do:
      877           create buf_rule-i-script.
      878         end.
      879         buffer-copy tt-rule-i-script to buf_rule-i-script.
      880       end.
      881       for each buf_rule-i-script where buf_rule-i-script.root_rule_i = buf_rule.rule_id
      882       on error undo _main, return error  substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      883       :
      884         find first tt-rule-i-script where
      885                   tt-rule-i-script.root_rule_id = buf_rule-i-script.root_rule_id
      886               and tt-rule-i-script.i-script-name = buf_rule-i-script.i-script-name
      887               and tt-rule-i-script.script_id = buf_rule-i-script.script_id no-error.
      888         if not available tt-rule-i-script then do:
      889           delete buf_rule-i-script.
      890         end.
      891       end.
      892       for each tt-rule-script
      893       on error undo _main, return error  substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      894       :
      895         find first buf_rule-script where
      896                 buf_rule-script.script_id = tt-rule-script.script_id
      897               and buf_rule-script.language = tt-rule-script.language no-error.
      898         if not available buf_rule-script then do:
      899           create buf_rule-script.
      900         end.
      901         buffer-copy tt-rule-script to buf_rule-script.
      902       end.
      903       for each buf_rule-script where buf_rule-script.root_rule_id = buf_rule.rule_id
      904       on error undo _main, return error  substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      905       :
      906         find first tt-rule-script where
      907                  tt-rule-script.script_id = buf_rule-script.script_id
      908               and tt-rule-script.language = buf_rule-script.language no-error.
      909         if not available tt-rule-script then do:
      910           delete buf_rule-script.
      911         end.
      912       end.
      913     end.
      914     p-rec = recid(buf_rule).
      915   end.
      916   PROCEDURE err-mess:
      917     DEFINE INPUT-OUTPUT PARAMETER p-mess as character No-UNDO.
      918     CASE p-silent:
      919       when yes then do:
      920         assign
      921         p-mess = substitute("Правило: id &1:&2&3"
      922                            , p-rule-id
      923                            , chr(10)
      924                            , p-mess)
      925         .
      926       end.
      927       when no then do:
      928         message
      929         p-mess
      930         view-as alert-box error .
      931       end.
      932     end.
      933   END PROCEDURE.
