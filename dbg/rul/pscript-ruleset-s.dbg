     4410   PROCEDURE proc-b-add-chg :
     4411   define input parameter p-add as logical no-undo .
     4412   define variable v-rid-list as character no-undo .
     4413   define variable v-rec as recid no-undo .
     4414   define variable v-ok as logical no-undo .
     4415   define variable v-is-dynamic as logical no-undo .
     4416   define variable v-ii as integer no-undo .
     4417   define buffer buf_prop-script for dictdb.prop-script.
     4418   define buffer buf_prop-ruleset for dictdb.prop-ruleset.
     4419   CASE p-add:
     4420     when yes then do:
     4421       if p-list-mode = "ruleset" then do:
     4422         run rul/prop-ruleset-s.w ( input parparentproc
     4423                               ,input "b-sel"
     4424                               ,input "ruleset"
     4425                               ,input p-codex-id
     4426                               ,input p-ruleset-id
     4427                               ,input 0
     4428                               ,input-output v-rid-list
     4429                               ) no-error.
     4430         if v-rid-list = '':U then do:
     4431           return.
     4432         end.
     4433         find first buf_prop-ruleset no-lock where
     4434                   recid(buf_prop-ruleset) = integer(v-rid-list).
     4435         run rul/prop-script-s.w ( input parparentproc
     4436                               ,input "b-sel"
     4437                               ,input "dtm-code"
     4438                               ,input '':U
     4439                               ,input buf_prop-ruleset.dtm-code
     4440                               ,input '':U
     4441                               ,input '':U
     4442                               ,input-output v-rid-list) no-error.
     4443         if v-rid-list = '':U then do:
     4444           return.
     4445         end.
     4446         do v-ii = 1 to num-entries( v-rid-list):
     4447           find first buf_prop-script no-lock where
     4448                     recid(buf_prop-script) = integer(entry(v-ii, v-rid-list)).
     4449           run rul/pscript-ruleset1.p ( input 'ДОБАВЛЕНИЕ':U
     4450                                     ,input no
     4451                                     ,input-output v-rec
     4452                                     ,input  p-codex-id
     4453                                     ,input  p-ruleset-id
     4454                                     ,input buf_prop-script.dtm-code
     4455                                     ,input buf_prop-script.language
     4456                                     ,input buf_prop-script.script-name
     4457                                     ,input buf_prop-script.revis_id
     4458                                     ) no-error.
     4459           if error-status:error then do:
     4460             undo, return error .
     4461           end.
     4462         end.
     4463       end.
     4464       if p-list-mode = "dtm-code" then do:
     4465         run rul/prop-ruleset-s.w ( input parparentproc
     4466                               ,input "b-sel"
     4467                               ,input "dtm-code"
     4468                               ,input 0
     4469                               ,input 0
     4470                               ,input p-dtm-code
     4471                               ,input-output v-rid-list
     4472                               ) no-error.
     4473         if v-rid-list = '':U then do:
     4474           return.
     4475         end.
     4476         find first buf_prop-ruleset no-lock where
     4477                   recid(buf_prop-ruleset) = integer(v-rid-list).
     4478         run rul/prop-script-s.w ( input parparentproc
     4479                               ,input "b-sel,b-mark"
     4480                               ,input "dtm-code"
     4481                               ,input '':U
     4482                               ,input buf_prop-ruleset.dtm-code
     4483                               ,input '':U
     4484                               ,input '':U
     4485                               ,input-output v-rid-list) no-error.
     4486         if v-rid-list = '':U then do:
     4487           return.
     4488         end.
     4489         do v-ii = 1 to num-entries( v-rid-list):
     4490           find first buf_prop-script no-lock where
     4491                     recid(buf_prop-script) = integer(entry(v-ii, v-rid-list)).
     4492           run rul/pscript-ruleset1.p ( input 'ДОБАВЛЕНИЕ':U
     4493                                     ,input no
     4494                                     ,input-output v-rec
     4495                                     ,input  buf_prop-ruleset.codex_id
     4496                                     ,input  buf_prop-ruleset.ruleset_id
     4497                                     ,input  buf_prop-script.dtm-code
     4498                                     ,input buf_prop-script.language
     4499                                     ,input buf_prop-script.script-name
     4500                                     ,input buf_prop-script.revis_id
     4501                                     ) no-error.
     4502           if error-status:error then do:
     4503             undo, return error .
     4504           end.
     4505         end.
     4506       end.
     4507       if p-list-mode = "script-name" then do:
     4508         run rul/prop-ruleset-s.w ( input parparentproc
     4509                               ,input "b-sel,b-mark"
     4510                               ,input "dtm-code"
     4511                               ,input 0
     4512                               ,input 0
     4513                               ,input p-dtm-code
     4514                               ,input-output v-rid-list
     4515                               ) no-error.
     4516         if v-rid-list = '':U then do:
     4517           return.
     4518         end.
     4519         find first buf_prop-script no-lock where
     4520                   buf_prop-script.dtm-code = p-dtm-code
     4521              and  buf_prop-script.language = p-language
     4522              and  buf_prop-script.script-name = p-script-name.
     4523         do v-ii = 1 to num-entries( v-rid-list):
     4524           find first buf_prop-ruleset no-lock where
     4525                     recid(buf_prop-ruleset) = integer(entry(v-ii, v-rid-list)).
     4526           run rul/pscript-ruleset1.p ( input 'ДОБАВЛЕНИЕ':U
     4527                                     ,input no
     4528                                     ,input-output v-rec
     4529                                     ,input buf_prop-ruleset.codex_id
     4530                                     ,input buf_prop-ruleset.ruleset_id
     4531                                     ,input buf_prop-script.dtm-code
     4532                                     ,input buf_prop-script.language
     4533                                     ,input buf_prop-script.script-name
     4534                                     ,input buf_prop-script.revis_id
     4535                                     ) no-error.
     4536           if error-status:error then do:
     4537             undo, return error .
     4538           end.
     4539         end.
     4540       end.
     4541       run openbr in this-procedure ( input yes, input no, input '':U).
     4542       reposition br-pscript-ruleset to recid v-rec no-error.
     4543       APPLY "ENTRY" to browse br-pscript-ruleset.
     4544     end.
     4545   end.
     4546   END PROCEDURE.
     4547   PROCEDURE proc-b-sch :
