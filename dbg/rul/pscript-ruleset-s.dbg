     4558   run fltfield-add in this-procedure('ruleset_id', 'Набор правил', '',
     4559   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4560   run fltfield-add in this-procedure('language', 'Язык', '',
     4561   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4562   run fltfield-add in this-procedure('dtm-code', 'Код объекта-операнда', '',
     4563   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4564   run fltfield-add in this-procedure('script-name', 'Скрипт', '',
     4565   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4566   run fltfield-add in this-procedure('revis_id', 'Версия скрипта', '',
     4567   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4568   Filter-Block:
     4569   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     4570       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     4571       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     4572     run gbl/filter.w ( INPUT parparentproc
     4573                      , INPUT filter-point + chr(4) + filter-point-label
     4574                      , INPUT tbl
     4575                      , INPUT join-tbl
     4576                      , INPUT fld
     4577                      , INPUT lab
     4578                      , INPUT spr
     4579                      , INPUT dim ).
     4580     RUN OpenBr IN THIS-PROCEDURE (INPUT yes
     4581                                  ,INPUT no
     4582                                  ,INPUT '':U).
     4583   end.
     4584   END PROCEDURE.
     4585   PROCEDURE proc-find-script-name :
     4586   define input parameter p-next as logical no-undo.
     4587   define input parameter p-script-name AS CHARACTER no-undo.
     4588   define input parameter p-find-option AS CHARACTER no-undo.
     4589   define variable old-word-script-name as character no-undo .
     4590   define variable v-w-script-name as character no-undo .
     4591   assign
     4592   frame Dialog-Frame f-script-name.
     4593   assign
     4594   p-script-name = replace(p-script-name, chr(34), "":U)
     4595   p-script-name = replace(p-script-name, chr(39), chr(39) + chr(39))
     4596   v-w-script-name = p-script-name
     4597   p-script-name = chr(34) + p-script-name + chr(34).
     4598   CASE p-find-option:
     4599     WHEN "begins" THEN DO:
     4600       old-word-script-name = p-word-script-name.
     4601       p-word-script-name = '':U.
     4602       v-doc-rec = ?.
     4603       if old-word-script-name <> p-word-script-name then do:
     4604         run OpenBr in this-procedure
     4605             (input yes
     4606             ,input no
     4607             ,input '':U
     4608             ).
     4609       end.
     4610       run OpenBr in this-procedure
     4611           (input false
     4612           ,input p-next
     4613           ,input substitute("and X_pscript-ruleset.script-name contains &1 "
     4614             , p-script-name)
     4615           ).
     4616     END.
     4617     WHEN "contains":U  THEN DO:
     4618       p-word-script-name = p-script-name.
     4619       run OpenBr in this-procedure
     4620           (input yes
     4621           ,input no
     4622           ,input '':U
     4623           ).
     4624     END.
     4625   END CASE.
     4626   apply "entry":u to f-script-name in frame Dialog-Frame .
     4627   END PROCEDURE.
     4628   FUNCTION get-translation RETURNS CHARACTER
     4629     ( INPUT p-uniq-key-rec AS character ) :
     4630   DEFINE BUFFER buf_ruledict FOR ub.ruledict.
     4631   FIND FIRST buf_ruledict NO-LOCK WHERE
     4632             buf_ruledict.entry-type = 'prop-script':U
     4633       AND   buf_ruledict.uniq-key-rec = p-uniq-key-rec NO-ERROR.
     4634   IF AVAILABLE buf_ruledict THEN DO:
     4635      RETURN buf_ruledict.script-nl.
     4636   END.
     4637   ELSE DO:
     4638       RETURN '':U.
     4639   END.
     4640   END FUNCTION.
