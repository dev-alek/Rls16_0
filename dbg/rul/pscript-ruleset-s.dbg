     1371   procedure diasize_set-height :
     1372     define input  parameter p-new-height  as decimal   no-undo .
     1373     define input  parameter p-move-resize as logical   no-undo .
     1374     do
     1375     on error undo, return error return-value
     1376     :
     1377       run diasize_change-height in this-procedure
     1378         (input  (p-new-height - frame Dialog-Frame :height)
     1379         ,input  p-move-resize
     1380         ) .
     1381     end.
     1382   end procedure.
     1383   procedure diasize_change-width :
     1384     define input  parameter p-change-value as decimal   no-undo .
     1385     define input  parameter p-move-resize  as logical   no-undo .
     1386     define variable v-field-group-handle   as handle    no-undo .
     1387     define variable v-object-handle        as handle    no-undo .
