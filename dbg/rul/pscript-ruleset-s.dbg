     1394     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1395     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1396     if p-change-value > 0
     1397     then do:
     1398       if frame Dialog-Frame :width + p-change-value >
     1399           session :width-chars
     1400       then do:
     1401         assign
     1402           p-change-value = session :width-chars - frame Dialog-Frame :width
     1403         .
     1404         if p-change-value <= 0
     1405         then do:
     1406           run diasize_position-resize-button in this-procedure .
     1407           return .
     1408         end.
     1409       end.
     1410     end.
     1411     if p-change-value < 0
     1412     then do:
     1413       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1414       then do:
     1415         assign
     1416           p-change-value = v-diasize-orig-frame-width
     1417                          - frame Dialog-Frame :width
     1418         .
     1419         if p-change-value >= 0
     1420         then do:
     1421           run diasize_position-resize-button in this-procedure .
     1422           return .
     1423         end.
     1424       end.
     1425     end.
     1426     if p-change-value >= 0
     1427     then do:
     1428       assign
     1429         v-change-sign = 1
     1430       .
     1431     end.
     1432     else do:
     1433       assign
     1434         v-change-sign = -1
     1435       .
     1436     end.
     1437     assign
