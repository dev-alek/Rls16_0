     1646           or error-status :get-message(1) <> ""
     1647           then do:
     1648             undo move_block, retry move_block .
     1649           end.
     1650         end.
     1651         for each buf_temp-diasize-handle
     1652         on error undo move_block, retry move_block
     1653         :
     1654           assign
     1655             v-object-handle = buf_temp-diasize-handle.handle-value
     1656           .
     1657           if v-object-handle <> v-diasize-resize-button
     1658           then do:
     1659             assign
     1660               v-object-handle :col = v-object-handle :col + p-change-value
     1661               no-error .
     1662             if error-status :error
     1663             or error-status :get-message(1) <> ""
     1664             then do:
     1665               undo move_block, retry move_block .
     1666             end.
     1667           end.
     1668         end.
     1669       end.
     1670       else do:
     1671         for each buf_temp-diasize-handle
     1672         on error undo move_block, retry move_block
     1673         :
     1674           assign
     1675             v-object-handle = buf_temp-diasize-handle.handle-value
     1676           .
     1677           if v-object-handle <> v-diasize-resize-button
     1678           then do:
     1679             assign
     1680               v-object-handle :col = v-object-handle :col + p-change-value
     1681               no-error .
     1682             if error-status :error
     1683             or error-status :get-message(1) <> ""
     1684             then do:
     1685               undo move_block, retry move_block .
     1686             end.
     1687           end.
     1688         end.
     1689         for each buf_temp-browse-handle
     1690           where buf_temp-browse-handle.browse-type = 'width':u
     1691         on error undo move_block, retry move_block
     1692         :
     1693           assign
     1694             buf_temp-browse-handle.browse-handle :width
     1695               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1696             no-error .
     1697           if error-status :error
     1698           or error-status :get-message(1) <> ""
     1699           then do:
     1700             undo move_block, retry move_block .
     1701           end.
     1702         end.
     1703         assign
     1704           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1705           no-error .
     1706         if error-status :error
     1707         or error-status :get-message(1) <> ""
     1708         then do:
     1709           undo move_block, retry move_block.
     1710         end.
     1711         assign
     1712           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1713         no-error .
     1714         if error-status :error
     1715         or error-status :get-message(1) <> ""
     1716         then do:
     1717           undo move_block, retry move_block.
     1718         end.
     1719         if frame Dialog-Frame :scrollable = true
     1720         then do:
     1721           assign
     1722             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1723           no-error .
     1724           if error-status :error
     1725           or error-status :get-message(1) <> ""
     1726           then do:
     1727             undo move_block, retry move_block.
     1728           end.
     1729         end.
     1730       end.
     1731       if p-move-resize
     1732       then do:
     1733         run diasize_position-resize-button in this-procedure .
     1734       end.
     1735       if v-diasize-wndstore = true
     1736       then do:
     1737         if connected("ub") = true
     1738         then do:
     1739           define variable v-cntxt-db-num        as integer   no-undo .
     1740           define variable v-cntxt-userid        as character no-undo .
     1741           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1742                                             , OUTPUT v-cntxt-userid
     1743                                             ) .
     1744           run gbl/wndsizew.p
     1745             (input  v-cntxt-db-num
     1746             ,input  v-cntxt-userid
     1747             ,input  v-diasize-proc-name
     1748             ,input  'width':u
     1749             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1750             ) .
     1751         end.
     1752       end.
     1753     end.
     1754     assign
     1755       v-diasize-change-size = false
     1756     .
     1757   end procedure.
     1758   procedure diasize_set-width :
     1759     define input  parameter p-new-width  as decimal   no-undo .
     1760     define input  parameter p-move-resize as logical   no-undo .
     1761     do
     1762     on error undo, return error return-value
     1763     :
     1764       run diasize_change-width in this-procedure
     1765         (input  (p-new-width - frame Dialog-Frame :width)
     1766         ,input  p-move-resize
     1767         ) .
     1768     end.
     1769   end procedure.
     1770   procedure diasize_position-resize-button :
     1771     do with frame Dialog-Frame
     1772     :
     1773       hide v-diasize-resize-button .
     1774       assign
     1775         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1776                     - 1
     1777                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1778         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1779                     - 1
     1780                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1781       .
     1782       view v-diasize-resize-button .
     1783     end.
     1784   end procedure.
     1785   on alt-right anywhere
     1786   do:
     1787     run diasize_change-width in this-procedure
     1788       (input 1
     1789       ,input true
     1790       ) .
     1791     return no-apply .
     1792   end.
     1793   on alt-left anywhere
     1794   do:
     1795     run diasize_change-width in this-procedure
     1796       (input -1
     1797       ,input true
     1798       ) .
     1799     return no-apply .
     1800   end.
     1801   on alt-down anywhere
     1802   do:
     1803     run diasize_change-height in this-procedure
     1804       (input 1
     1805       ,input true
     1806       ) .
     1807     return no-apply .
     1808   end.
     1809   on alt-up anywhere
     1810   do:
     1811     run diasize_change-height in this-procedure
     1812       (input -1
     1813       ,input true
     1814       ) .
     1815     return no-apply .
     1816   end.
     1817   on alt-enter of frame Dialog-Frame
     1818   do:
     1819     run diasize_maximize in this-procedure
     1820       (input  ?
     1821       ).
     1822     return no-apply .
     1823   end.
     1824   procedure diasize_end-move :
     1825     do
     1826     on error undo, return error return-value
     1827     :
     1828       define variable v-row-delta as decimal   no-undo .
     1829       define variable v-col-delta as decimal   no-undo .
     1830       define variable v-new-row as decimal   no-undo .
     1831       define variable v-new-col as decimal   no-undo .
     1832       assign
     1833         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1834         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1835       .
     1836       assign
     1837         v-row-delta = v-new-row - frame Dialog-Frame :height
     1838         v-col-delta = v-new-col - frame Dialog-Frame :width
     1839       .
     1840       run diasize_change-height in this-procedure
     1841         (input v-row-delta
     1842         ,input true
     1843         ) .
     1844       run diasize_change-width in this-procedure
     1845         (input v-col-delta
     1846         ,input true
     1847         ) .
     1848     end.
     1849   end procedure.
     1850   procedure diasize_maximize :
     1851     define input  parameter p-action as logical   no-undo .
     1852     do
     1853     on error undo, return error return-value
     1854     :
     1855       if p-action = ?
     1856       then do:
     1857         if v-diasize-need-maximize = true
     1858         then do:
     1859           assign
     1860             p-action = true
     1861           .
     1862         end.
     1863         else do:
     1864           assign
     1865             p-action = false
     1866           .
     1867         end.
     1868       end.
     1869       if p-action = true
     1870       then do:
     1871         run diasize_change-height in this-procedure
     1872           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1873               - frame Dialog-Frame :height-chars
     1874           ,input true
     1875           ) .
     1876         run diasize_change-width in this-procedure
     1877           (input session :width-chars
     1878               - frame Dialog-Frame :width-chars
     1879           ,input true
     1880           ) .
     1881         assign
     1882           v-diasize-need-maximize = false
     1883         .
     1884       end.
     1885       else do:
     1886         run diasize_change-width in this-procedure
     1887           (input v-diasize-orig-frame-width
     1888               - frame Dialog-Frame :width-chars
     1889           ,input true
     1890           ) .
     1891         run diasize_change-height in this-procedure
     1892           (input v-diasize-orig-frame-height
     1893               - frame Dialog-Frame :height-chars
     1894           ,input true
     1895           ) .
     1896         assign
     1897           v-diasize-need-maximize = true
     1898         .
     1899       end.
     1900     end.
     1901   end procedure.
     1902   procedure diasize_restore-orig-size :
     1903     do
     1904     on error undo, return error return-value
     1905     :
     1906       assign
     1907         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1908         v-diasize-current-frame-height = frame Dialog-Frame :height
     1909       .
     1910       run diasize_set-height in this-procedure
     1911         (input  v-diasize-orig-frame-height
     1912         ,input  true
     1913         ) .
     1914       run diasize_set-width in this-procedure
     1915         (input  v-diasize-orig-frame-width
     1916         ,input  true
     1917         ) .
     1918     end.
     1919   end procedure.
     1920   procedure diasize_restore-current-size :
     1921     do
     1922     on error undo, return error return-value
     1923     :
     1924       run diasize_set-height in this-procedure
     1925         (input  v-diasize-current-frame-height
     1926         ,input  true
     1927         ) .
     1928       run diasize_set-width in this-procedure
     1929         (input  v-diasize-current-frame-width
     1930         ,input  true
     1931         ) .
     1932     end.
     1933   end procedure.
     1934   procedure diasize_set-browse-handle :
     1935     define input  parameter p-browse-handle as handle   no-undo .
     1936     define buffer buf_temp-browse-handle for temp-browse-handle .
     1937     do
     1938     on error undo, return error return-value
     1939     :
     1940       assign
     1941         v-diasize-browse-handle = p-browse-handle
     1942       .
     1943       for each buf_temp-browse-handle
     1944       on error undo, return error return-value
     1945       :
     1946         delete buf_temp-browse-handle .
     1947       end.
     1948     end.
     1949   end procedure.
     1950   procedure diasize_add_browse :
     1951     define input  parameter p-browse-type   as character no-undo .
     1952     define input  parameter p-browse-handle as handle    no-undo .
     1953     define buffer buf_temp-browse-handle for temp-browse-handle .
     1954     do
     1955     on error undo, return error return-value
     1956     :
     1957       assign
     1958         v-diasize-browse-number = v-diasize-browse-number + 1
     1959       .
     1960       create buf_temp-browse-handle .
     1961       assign
     1962         buf_temp-browse-handle.browse-type   = p-browse-type
     1963         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1964         buf_temp-browse-handle.browse-handle = p-browse-handle
     1965       .
     1966     end.
     1967   end procedure.
     1968   procedure diasize_init :
     1969     define variable v-default-value    as logical   no-undo .
     1970     define variable v-restore-saved    as logical   no-undo .
     1971     define variable v-resize-value-str as character no-undo .
     1972     do
     1973     on error undo, return error return-value
     1974     :
     1975       do with frame Dialog-Frame
     1976       :
     1977         assign
     1978           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1979           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1980           v-diasize-browse-handle     = browse br-pscript-ruleset :handle
     1981         .
     1982         create button v-diasize-resize-button
     1983         assign
     1984           parent        = frame Dialog-Frame :first-child
     1985           label         = "s"
     1986           height-pixels = 16
     1987           width-pixels  = 16
     1988           visible       = true
     1989           sensitive     = true
     1990           movable       = true
     1991           triggers:
     1992             on end-move persistent run diasize_end-move in this-procedure .
     1993           end triggers.
     1994         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1995         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1996         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1997         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1998         assign
     1999           v-diasize-wndmax = false
     2000         .
     2001         if connected("ub") = true
     2002         then do:
     2003           define variable v-cntxt-db-num        as integer   no-undo .
     2004           define variable v-cntxt-userid        as character no-undo .
     2005           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2006                                             , OUTPUT v-cntxt-userid
     2007                                             ) .
     2008           run gbl/wndpar_r.p
     2009             (input  v-cntxt-db-num
     2010             ,input  v-cntxt-userid
     2011             ,input  'wndmax':U
     2012             ,output v-diasize-wndmax
     2013             ,output v-default-value
     2014             ) .
     2015         end.
     2016         assign
     2017           v-diasize-wndstore = false
     2018         .
     2019         if connected("ub") = true
     2020         then do:
     2021           run gbl/wndpar_r.p
     2022             (input  v-cntxt-db-num
     2023             ,input  v-cntxt-userid
     2024             ,input  'wndstore':U
     2025             ,output v-diasize-wndstore
     2026             ,output v-default-value
     2027             ) .
     2028         end.
     2029         assign
     2030           v-diasize-proc-name = entry(1, program-name(2), '.')
     2031         .
     2032         if v-diasize-wndstore = true
     2033         then do:
     2034           assign
     2035             v-restore-saved = false
     2036           .
     2037           if connected("ub") = true
     2038           then do:
     2039             run gbl/wndsizer.p
     2040               (input  v-cntxt-db-num
     2041               ,input  v-cntxt-userid
     2042               ,input  v-diasize-proc-name
     2043               ,input  'height':u
     2044               ,output v-resize-value-str
     2045               ) .
     2046             if v-resize-value-str <> '':U
     2047             then do:
     2048               run diasize_change-height in this-procedure
     2049                 (input  integer(v-resize-value-str)
     2050                 ,input  true
     2051                 ) .
     2052               assign
     2053                 v-restore-saved = true
     2054               .
     2055             end.
     2056           end.
     2057           if connected("ub") = true
     2058           then do:
     2059             run gbl/wndsizer.p
     2060               (input  v-cntxt-db-num
     2061               ,input  v-cntxt-userid
     2062               ,input  v-diasize-proc-name
     2063               ,input  'width':u
     2064               ,output v-resize-value-str
     2065               ) .
     2066             if v-resize-value-str <> '':U
     2067             then do:
     2068               run diasize_change-width in this-procedure
     2069                 (input  integer(v-resize-value-str)
     2070                 ,input  true
     2071                 ) .
     2072               assign
     2073                 v-restore-saved = true
     2074               .
     2075             end.
     2076           end.
     2077           if v-restore-saved <> true
     2078           then do:
     2079             if v-diasize-wndmax = true
     2080             then do:
     2081               run diasize_maximize in this-procedure
     2082                 (input  true
     2083                 ) .
     2084             end.
     2085           end.
     2086         end.
     2087         else do:
     2088           if v-diasize-wndmax = true
     2089           then do:
     2090             run diasize_maximize in this-procedure
     2091               (input  true
     2092               ) .
     2093           end.
     2094         end.
     2095       end.
     2096     end.
     2097   end procedure.
     2098   procedure diasize_need-full-display :
     2099     define output parameter p-need-full-display as logical   no-undo .
     2100     do
     2101     on error undo, return error return-value
     2102     :
     2103       assign
     2104         p-need-full-display = v-diasize-need-full-display
     2105       .
     2106       assign
     2107         v-diasize-need-full-display = false
     2108       .
     2109     end.
     2110   end procedure.
     2111   procedure get-context :
     2112      define output parameter p-db-num as integer          no-undo.
     2113      define output parameter p-user-id as character        no-undo.
     2114      define variable v-login               as character    no-undo.
     2115      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2116      define buffer buf_user-login  for ub.user-login .
     2117      do
     2118      on error undo, return error
     2119      :
     2120            FIND FIRST buf_sys-ctrl no-lock.
     2121            ASSIGN
     2122               v-login = USERID("ub")
     2123               p-db-num = buf_sys-ctrl.db-num
     2124            .
     2125            FIND FIRST buf_user-login
     2126                 WHERE buf_user-login.db-num = p-db-num
     2127                   AND buf_user-login.user-login = v-login
     2128                 no-lock
     2129                 no-error
     2130                 .
     2131            IF AVAILABLE buf_user-login
     2132            THEN DO:
     2133               assign
     2134                  p-user-id = buf_user-login.user-id
     2135               .
     2136            END.
     2137      end.
     2138   end procedure.
     2139       run diasize_init in this-procedure .
     2140   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2141   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2142   MAIN-BLOCK:
     2143   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2144      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2145   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2146     run mainmenu_getcntxt in parparentproc
     2147       (output v-cntxt-db-num
     2148       ,output v-cntxt-userid
     2149       ,output v-cntxt-level
     2150       ,output v-cntxt-host-code-obj
     2151       ,output v-cntxt-obj-type
     2152       ,output v-cntxt-obj-code
     2153       ,output v-cntxt-db-num-obj
     2154       ,output v-cntxt-is-admin
     2155       ) .
     2156     v-rid-list = p-rid-list.
     2157     run Myenable in this-procedure .
     2158     WAIT-FOR GO OF FRAME Dialog-Frame.
     2159   END.
     2160   RUN disable_UI.
     2161   PROCEDURE disable_UI :
     2162     HIDE FRAME Dialog-Frame.
     2163   END PROCEDURE.
     2164   PROCEDURE enable_UI :
     2165     DISPLAY rs-language cb-pscript-ruleset rs-find f-script-name mark-num
     2166         WITH FRAME Dialog-Frame.
     2167     ENABLE b-quit b-mark b-sel b-add b-chg b-del b-lkp b-sch B-Help rs-language
     2168            cb-pscript-ruleset rs-find f-script-name br-pscript-ruleset mark-num
     2169         WITH FRAME Dialog-Frame.
     2170     VIEW FRAME Dialog-Frame.
     2171     OPEN QUERY br-pscript-ruleset FOR EACH X_pscript-ruleset NO-LOCK,        FIRST X_prop-script no-lock,        FIRST X_prop-head NO-LOCK.
     2172   END PROCEDURE.
     2173   PROCEDURE MyEnable :
     2174   DEFINE VARIABLE v-dtm-label AS CHARACTER no-undo.
     2175   DEFINE VARIABLE v-h AS handle NO-UNDO.
     2176   DEFINE BUFFER buf_prop-ruleset FOR ub.prop-ruleset.
     2177   DEFINE BUFFER buf_prop-head FOR ub.prop-head.
     2178   ASSIGN
     2179   v-h = br-pscript-ruleset:FIRST-COLUMN IN FRAME Dialog-Frame
     2180   cb-pscript-ruleset:DELIMITER in FRAME Dialog-Frame = "|"
     2181   cb-pscript-ruleset:LIST-ITEM-PAIRS  = "|-1":U
     2182   rs-language:RADIO-BUTTONS IN FRAME Dialog-Frame = "ABL" + chr(44) + "ABL" + chr(44) +
     2183                                                    "rus" + chr(44) + "rus"
     2184   rs-find = "contains"
     2185   .
     2186   DO while valid-handle(v-h) :
     2187     if v-h:LABEL = "Перевод" then do:
     2188       v-h:RESIZABLE = YES.
     2189       leave.
     2190     end.
     2191     ELSE DO:
     2192       v-h = v-h:NEXT-COLUMN.
     2193     END.
     2194   END.
     2195   if not (p-list-mode = "dtm-code" or p-list-mode = "script-name") then do:
     2196     _prop-ruleset:
     2197     FOR EACH buf_prop-ruleset NO-LOCK WHERE
     2198             buf_prop-ruleset.codex_id = p-codex-id
     2199     BREAK BY buf_prop-ruleset.dtm-code:
     2200       IF first-of(buf_prop-ruleset.dtm-CODE) THEN DO:
     2201         FIND FIRST buf_prop-head NO-LOCK WHERE
     2202                     buf_prop-head.dtm-code = buf_prop-ruleset.dtm-code NO-ERROR.
     2203         IF NOT AVAILABLE buf_prop-head THEN DO:
     2204             NEXT _prop-ruleset.
     2205         END.
     2206         v-dtm-label = replace(buf_prop-head.prop-label, "|", chr(32)).
     2207         cb-pscript-ruleset:ADD-LAST(v-dtm-label, string(buf_prop-ruleset.dtm-code)) IN FRAME Dialog-Frame.
     2208       END.
     2209     END.
     2210     ASSIGN
     2211     cb-pscript-ruleset = "-1".
     2212   end.
     2213   assign
     2214   X_prop-head.prop-name :resizable in browse br-pscript-ruleset = yes
     2215   X_prop-head.prop-label:resizable in browse br-pscript-ruleset = yes
     2216   X_pscript-ruleset.script-name:resizable in browse br-pscript-ruleset = yes.
     2217   ENABLE
     2218   b-quit
     2219   b-add when ((p-list-mode = "ruleset"
     2220                or p-list-mode = "dtm-code"
     2221                or p-list-mode = "script-name"
     2222                ) and v-cntxt-db-num = 0 and lookup("b-add", bttns) > 0)
     2223   b-del when (v-cntxt-db-num = 0  and lookup("b-add", bttns) > 0)
     2224   b-lkp
     2225   B-Help
     2226   b-sch
     2227   b-mark when lookup("b-mark", bttns) > 0
     2228   b-sel when lookup("b-sel", bttns) > 0
     2229   br-pscript-ruleset
     2230   cb-pscript-ruleset when not (p-list-mode = "dtm-code" or p-list-mode = "script-name")
     2231   f-script-name
     2232   rs-find
     2233   WITH FRAME Dialog-Frame.
     2234   VIEW FRAME Dialog-Frame.
     2235   if (p-list-mode = "dtm-code" or p-list-mode = "script-name") then do:
