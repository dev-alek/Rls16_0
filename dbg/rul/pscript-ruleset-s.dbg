      862   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      863   on help of frame Dialog-Frame
      864   do:
      865     run gbl/app_help.p
      866       (input this-procedure :file-name
      867       ,input ''
      868       ,input ?
      869       ) no-error.
      870     if error-status :error then do:
      871       message
      872         "Ошибка при вызове помощи"
      873         error-status :get-message(1)
      874         view-as alert-box .
      875     end.
      876   end.
      877   run minbtn-set in this-procedure .
      878   on choose of b-help in frame Dialog-Frame
      879   do:
