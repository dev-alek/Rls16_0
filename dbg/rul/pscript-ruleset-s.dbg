        1   DEFINE BUFFER X_prop-head FOR ub.prop-head.
        2   DEFINE BUFFER X_prop-script FOR ub.prop-script.
        3   DEFINE BUFFER X_pscript-ruleset FOR ub.pscript-ruleset.
        4   define input parameter parparentproc as widget-handle no-undo .
        5   define input parameter bttns as character no-undo.
        6   DEFINE INPUT PARAMETER p-list-mode AS CHARACTER NO-UNDO.
        7   DEFINE INPUT PARAMETER p-codex-id AS INTEGER NO-UNDO.
        8   DEFINE INPUT PARAMETER p-ruleset-id AS INTEGER NO-UNDO.
        9   DEFINE INPUT PARAMETER p-dtm-code AS INTEGER NO-UNDO.
       10   define input parameter p-language as character no-undo .
       11   define input parameter p-script-name as character no-undo .
       12   define input-output parameter p-rid-list as character no-undo.
       13   define variable vss-revision    as character no-undo init "$Revision$":U .
       14   define variable vss-author      as character no-undo init "$Author$":U .
       15   define variable vss-date        as character no-undo init "$Date$":U .
       16   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       17   define variable vss-archive     as character no-undo init "$Archive$":U .
       18   define variable vss-description as character no-undo init "Список pscript-ruleset".
       19   procedure vss-get-info :
       20     define output parameter p-vss-revision    like vss-revision    no-undo .
       21     define output parameter p-vss-author      like vss-author      no-undo .
       22     define output parameter p-vss-date        like vss-date        no-undo .
       23     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       24     define output parameter p-vss-archive     like vss-archive     no-undo .
       25     define output parameter p-vss-description like vss-description no-undo .
       26     assign
       27       p-vss-revision    = vss-revision
       28       p-vss-author      = vss-author
       29       p-vss-date        = vss-date
       30       p-vss-workfile    = vss-workfile
       31       p-vss-archive     = vss-archive
       32       p-vss-description = vss-description
       33     .
       34   end procedure.
       35   procedure vss-get-parameters :
       36     define output parameter p-vss-parameters as character no-undo .
       37   end procedure.
       38   define new global shared variable g#vssrevis-logger as handle    no-undo .
       39   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       40   define variable v-vssrevis-logger                   as handle    no-undo .
       41   procedure vss-logevent :
       42     define input  parameter p-extra-paramters as character no-undo .
       43     define variable v-vssrevis-parameters as character no-undo .
       44     do
       45     on error undo, return error return-value
       46     :
       47       if  valid-handle(v-vssrevis-logger)
       48       and v-vssrevis-logger :get-signature("logevent") <> ""
       49       then do:
       50         run vss-get-parameters in this-procedure
       51           (output v-vssrevis-parameters
       52           ).
       53         run logevent in v-vssrevis-logger
       54           (input vss-workfile
       55           ,input vss-revision
       56           ,input v-vssrevis-parameters
       57           ,input p-extra-paramters
       58           ).
       59       end.
       60     end.
       61   end procedure.
       62   assign
       63     v-vssrevis-logger = g#vssrevis-logger
       64   .
       65   if  valid-handle(v-vssrevis-logger)
       66   and v-vssrevis-logger :get-signature("logevent") <> ""
       67   then do:
       68     assign
       69       v-vssrevis-logevent = true
       70     .
       71     run vss-logevent in this-procedure (input vss-description) .
       72   end.
       73   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       74   define variable v-waitfram-action01         as character   no-undo .
       75   define variable v-waitfram-action02         as character   no-undo .
       76   define variable v-waitfram-action03         as character   no-undo .
       77   define variable mWaitFramTextBeg            as character   no-undo.
       78   define variable mWaitFramTextEnd            as character   no-undo.
       79   define variable mWaitFramView               as logical     no-undo.
       80   define variable mWaitProcEvent              as logical     no-undo init yes.
       81   define variable mWaitFramInterval           as integer     no-undo init 1 .
       82   define variable mWaitFramStop               as logical     no-undo.
       83   define variable mWaitFramStopUser           as logical     no-undo.
       84   define variable mWaitFramStopTimeOut        as logical     no-undo.
       85   define variable mWaitFramStartProc          as datetime-tz no-undo.
       86   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       87   define button B-WaitFramStop auto-end-key
       88        label "Стоп"
       89        size 10 by 1 tooltip "Остоновить процесс".
       90   define button B-viewProcInfo
       91        label "Информация"
       92        size 15 by 1 tooltip "Информация о процесс".
       93   define frame waitfram
       94     v-waitfram-action01 format "x(72)" no-label skip
       95     v-waitfram-action02 format "x(72)" no-label skip
       96     v-waitfram-action03 format "x(72)" no-label skip
       97     B-viewProcInfo
       98     B-WaitFramStop at row 4 col 30
       99     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      100     .
      101   define new global shared variable mBatchMode as logical no-undo init ?.
      102   define variable mFramBachModHandle as handle no-undo.
      103   mFramBachModHandle = frame waitfram:handle.
      104   define variable mFameOldVis as logical no-undo.
      105   define variable mVisCUrentVin as logical no-undo.
      106   if session:batch-mode
      107   then
      108      mBatchMode = yes.
      109   if mBatchMode = ? then do:
      110     mVisCUrentVin = current-window:visible.
      111     mFameOldVis = mFramBachModHandle:visible.
      112     mFramBachModHandle:visible  = yes.
      113     mBatchMode = mFramBachModHandle:visible ne yes.
      114     mFramBachModHandle:visible = mFameOldVis.
      115     current-window:visible = mVisCUrentVin.
      116   end.
      117    if  log-manager:logfile-name ne ?
      118     then DO:
      119         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      120         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      121         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      122     end.
      123   on choose of B-WaitFramStop in frame waitfram
      124   do:
      125     mWaitFramStop = yes.
      126     mWaitFramStopUser = yes.
      127   end.
      128   function waitfram-check-timeout returns logical():
      129      define variable vtime as int64 no-undo.
      130      if mWaitFramStopTimeOut
      131      then
      132         return yes.
      133      vtime = ( now - mWaitFramStartProc ) / 1000 .
      134      if     mWaitFramTimeOut ne ?
      135         and mWaitFramTimeOut ne 0
      136         and mWaitFramTimeOut lt vtime
      137      then do:
      138         mWaitFramStopTimeOut = yes.
      139      end.
      140      return mWaitFramStopTimeOut.
      141   end.
      142   procedure waitfram-hide :
      143     if not session:batch-mode
      144     then do
      145     on error undo, return error return-value
      146     :
      147       pause 0 before-hide .
      148       if not mBatchMode then
      149         hide frame waitfram .
      150     if     not mWaitFramView
      151        and mWaitProcEvent
      152     then
      153       process events .
      154     end.
      155   end procedure.
      156   procedure waitfram-show :
      157     define input  parameter p-message as character no-undo .
      158     define variable v-left-margin as integer   no-undo .
      159     if not session:batch-mode
      160     then do
      161     on error undo, return error return-value
      162     :
      163       if length(p-message) <= 70 then do:
      164         assign
      165           v-left-margin = integer((70 - length(p-message)) / 2)
      166         .
      167         assign
      168           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      169         .
      170         assign
      171           v-waitfram-action01 = " "
      172           v-waitfram-action02 = " "
      173                                    + fill(" ", v-left-margin)
      174                                    + p-message
      175           v-waitfram-action03 = " "
      176         .
      177       end.
      178       else do:
      179         define variable vRindex1 as integer no-undo.
      180         define variable vRindex2 as integer no-undo.
      181         vRindex1 = r-index(p-message," ",70).
      182         if vRindex1 = 0
      183         then
      184            vRindex1 = 70.
      185         if length(p-message)  <= vRindex1 + 70 then do:
      186           assign
      187             v-waitfram-action01 = " "
      188             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      189             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      190           .
      191         end.
      192         else do:
      193           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      194           if vRindex2 <= vRindex1
      195           then
      196              vRindex2 = vRindex1 + 70.
      197           assign
      198             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      199             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      200             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      201           .
      202         end.
      203       end.
      204       B-viewProcInfo:visible   in frame waitfram = no.
      205       B-viewProcInfo:sensitive in frame waitfram = no.
      206       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      207       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      208       if  (   mWaitFramView
      209          or  mWaitProcEvent)
      210          and not mBatchMode
      211       then
      212          display
      213             v-waitfram-action01 skip
      214             v-waitfram-action02 skip
      215             v-waitfram-action03 skip
      216          with frame waitfram .
      217       if     mWaitFramView
      218          then do:
      219             if     mWaitFramInterval ne ?
      220                and not mBatchMode
      221             then
      222                wait-for go of frame waitfram pause mWaitFramInterval.
      223          end.
      224          else
      225             if     mWaitProcEvent
      226                and not mBatchMode
      227             then
      228                process events .
      229     end.
      230   end procedure.
      231      procedure waitfram-show-this:
      232         define input  parameter iInterval as int64 no-undo.
      233         define variable vtime as int64 no-undo.
      234         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      235         mWaitFramInterval = iInterval.
      236         run waitfram-show (substitute("&1&2 &3&4" ,
      237                                       mWaitFramTextBeg ,
      238                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      239                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      240                                       mWaitFramTextEnd
      241                                      )
      242                           ).
      243      end.
      244      procedure WaitFramRunPause:
      245         define input  parameter iInterval as dec no-undo.
      246         define variable vStart  as datetime-tz no-undo.
      247         define variable vend    as datetime-tz no-undo.
      248         define variable vint as int64 no-undo.
      249         define variable vOk as logical no-undo.
      250         vStart = now.
      251         vend   = vStart.
      252         publish "WaitFramPause" (iInterval,output vOk).
      253         vend   =  now.
      254         vint = vend - vStart.
      255         vint = iInterval - vint / 1000.
      256         if     not mWaitFramStop
      257            and (   vint > 0
      258                 or (    not vOk
      259                     and iInterval eq ?
      260                     )
      261                 )
      262         then
      263            run waitfram-show-this (iInterval).
      264         vend   =  now.
      265         vint = vend - vStart.
      266         vint = iInterval - vint / 1000.
      267         if     not mWaitFramStop
      268            and vint > 0
      269         then do:
      270            run gbl/pause.p (vint * 1000).
      271         end.
      272         if iInterval ne ?
      273         then
      274            publish "WaitFramStop".
      275         waitfram-check-timeout().
      276      end.
      277      procedure WaitFramWaitFor:
      278         define input  parameter iInterval as dec no-undo.
      279         assign
      280            mWaitFramStartProc   = now
      281            mWaitFramStopUser    = no
      282            mWaitFramStopTimeOut = no
      283         .
      284         block-wait:
      285         do while not mWaitFramStop:
      286            run WaitFramRunPause (iInterval).
      287            if  waitfram-check-timeout()
      288            then do:
      289               leave block-wait.
      290            end.
      291         end.
      292         run waitfram-hide.
      293      end.
      294   procedure waitfram-join :
      295     define input  parameter p-line-1  as character no-undo .
      296     define input  parameter p-line-2  as character no-undo .
      297     define input  parameter p-line-3  as character no-undo .
      298     define output parameter p-message as character no-undo .
      299     do
      300     on error undo, return error return-value
      301     :
      302       assign
      303         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      304                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      305                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      306       .
      307     end.
      308   end procedure.
      309   function waitfram-join-function returns character
      310     (input p-line-1 as character
      311     ,input p-line-2 as character
      312     ,input p-line-3 as character
      313     ).
      314     define variable v-message as character no-undo .
      315     run waitfram-join in this-procedure
      316       (input  p-line-1
      317       ,input  p-line-2
      318       ,input  p-line-3
      319       ,output v-message
      320       ) .
      321     return v-message .
      322   end function .
      323   define new global shared variable g#language as character no-undo .
      324   if g#language <> '' and g#language <> 'rus':U then do:
      325     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      326   end.
      327   procedure proc-alt-shift-f2:
      328     if not ibs.th.gbl.gbl-var:rcode
      329   then
      330     run gbl\inidebug.p .
      331   end.
      332   procedure proc-alt-shift-f3:
      333     run gbl/prvssinf.p
      334       ( input this-procedure
      335       ) .
      336   end.
      337   define variable v-inform-launched as logical no-undo initial false .
      338   procedure proc-alt-shift-f4:
      339     define variable v-action as character no-undo .
      340     if v-inform-launched = false then do:
      341       assign
      342         v-inform-launched = true
      343       .
      344       run gbl/d-inform.w
      345         (  input self
      346         ,  input this-procedure
      347         , output v-action
      348         ) no-error .
      349       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      350       assign
      351         v-inform-launched = false
      352       .
      353     end.
      354   end.
      355   procedure proc-alt-f1:
      356     run gbl/corrhelp.p
      357       (input this-procedure
      358       ) .
      359   end .
      360   on alt-shift-f2 anywhere do:
      361     run proc-alt-shift-f2.
      362   end.
      363   on alt-shift-f3 anywhere do:
      364     run proc-alt-shift-f3 in this-procedure .
      365   end.
      366   on alt-shift-f4 anywhere do:
      367     run proc-alt-shift-f4 in this-procedure.
      368   end.
      369   on alt-f1 anywhere do:
      370     run proc-alt-f1 in this-procedure .
      371   end.
      372   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      373     define variable v-cntxt-db-num        as integer   no-undo .
      374     define variable v-cntxt-userid        as character no-undo .
      375     define variable v-cntxt-level         as character no-undo .
      376     define variable v-cntxt-host-code-obj as integer   no-undo .
      377     define variable v-cntxt-obj-type      as character no-undo .
      378     define variable v-cntxt-obj-code      as integer   no-undo .
      379     define variable v-cntxt-db-num-obj    as integer   no-undo .
      380     define variable v-cntxt-is-admin      as logical   no-undo .
      381   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      382   FUNCTION mark-string RETURNS CHARACTER
      383     ( input p-recid as recid, input mark-list as character  ) :
      384     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      385   END FUNCTION.
      386   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      387   define variable c-point  as character no-undo .
      388   define variable tbl      as character no-undo .
      389   define variable join-tbl as character no-undo .
      390   define variable fld      as character no-undo .
      391   define variable lab      as character no-undo .
      392   define variable spr      as character no-undo .
      393   define variable dim      as character no-undo .
      394   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      395   procedure fltfield-clear :
      396     define output parameter loc-fld as character no-undo.
      397     define output parameter loc-lab as character no-undo .
      398     define output parameter loc-spr as character no-undo .
      399     define output parameter loc-dim as character no-undo .
      400     assign
      401       loc-fld = ""
      402       loc-lab = ""
      403       loc-spr = ""
      404       loc-dim = "0"
      405     .
      406   end procedure .
      407   procedure fltfield-add :
      408     define input        parameter par-fld as character no-undo.
      409     define input        parameter par-lab as character no-undo .
      410     define input        parameter par-spr as character no-undo .
      411     define input-output parameter loc-fld as character no-undo.
      412     define input-output parameter loc-lab as character no-undo .
      413     define input-output parameter loc-spr as character no-undo .
      414     define input-output parameter loc-dim as character no-undo .
      415     do
      416     on error undo, return error
      417     :
      418       assign
      419       loc-fld = if loc-dim = '0'
      420                 then par-fld
      421                 else (loc-fld + chr(44) + par-fld)
      422       loc-lab = if loc-dim = '0'
      423                 then par-lab
      424                 else (loc-lab + chr(44) + par-lab)
      425       loc-spr = if loc-dim = '0'
      426                 then par-spr
      427                 else (loc-spr + chr(44) + par-spr)
      428       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      429                 string(integer(if num-entries(loc-dim) > 1
      430                               then entry(2, loc-dim)
      431                               else entry(1, loc-dim)
      432                               ) + 1)
      433       no-error
      434       .
      435     end.
      436   end procedure.
      437   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      438   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      439   procedure fltopend_fltopend :
      440   define input parameter p-parent-handle as handle no-undo .
      441   define input parameter p-qh as handle no-undo .
      442   define input parameter p-flt-open-open-query  as character no-undo .
      443   define input parameter p-where-cond as character no-undo .
      444   define input parameter p-use-indFIRST-query-tail as character no-undo .
      445   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      446   define input parameter p-indexed-reposition as character no-undo .
      447     do
      448     on error undo, return error
      449     :
      450   define variable v-prepare-string as character no-undo .
      451   define variable glog as logical no-undo .
      452   assign
      453   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      454                      p-where-cond + chr(32)  +
      455                      p-use-indFIRST-query-tail + chr(32) +
      456                      p-use-ind-sort-clmn-by + chr(32) +
      457                      p-indexed-reposition
      458   .
      459   assign
      460   glog = p-qh:query-prepare(v-prepare-string) no-error .
      461   if not glog
      462   or error-status:error then do:
      463     message error-status:get-message(1) view-as alert-box .
      464     undo, return error .
      465   end.
      466   assign
      467   glog = p-qh:query-open no-error .
      468   if not glog
      469   or error-status:error then do:
      470     message error-status:get-message(1) view-as alert-box .
      471     undo, return error .
      472   end.
      473     end.
      474   end procedure.
      475   procedure fltopend_fltfindd :
      476   define input parameter p-parent-handle as handle no-undo .
      477   define input parameter p-qh as handle no-undo .
      478   define input parameter p-rowid as rowid no-undo .
      479   define input parameter p-next as logical no-undo .
      480   define input parameter p-lock as integer no-undo .
      481   define input parameter p-bh as handle no-undo .
      482   define input parameter p-where-cond as character no-undo .
      483   define input parameter p-use-index-phrase as character no-undo .
      484   define variable glog as logical no-undo .
      485   define variable v-qh as handle no-undo .
      486   define variable v-bh as handle no-undo .
      487   define variable v-recid as recid no-undo .
      488   define variable v-prepare-string as character no-undo .
      489   do
      490   on error undo, return error
      491   on stop undo, return error
      492   :
      493     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      494     create buffer v-bh for table p-bh buffer-name p-bh:name.
      495     create query v-qh.
      496     v-qh:set-buffers(v-bh).
      497     v-prepare-string = substitute("for each &1 &2 &3"
      498                                     ,v-bh:name
      499                                     ,p-where-cond
      500                                     ,p-use-index-phrase).
      501     glog = v-qh:query-prepare(v-prepare-string) no-error.
      502     if not glog then do:
      503       delete object v-qh.
      504       delete object v-bh.
      505       undo, return error .
      506     end.
      507     glog = v-qh:query-open no-error .
      508     if not glog then do:
      509       delete object v-qh.
      510       delete object v-bh.
      511       undo, return error .
      512     end.
      513     if p-next then do:
      514       v-qh:reposition-to-rowid(p-rowid) no-error .
      515       glog = v-qh:get-next( p-lock) no-error .
      516       glog = v-qh:get-next( p-lock) no-error .
      517       if not glog or v-qh:query-off-end = yes then do:
      518         glog = v-qh:get-first( p-lock) no-error .
      519       end.
      520     end.
      521     else do:
      522       glog = v-qh:get-first( p-lock) no-error .
      523     end.
      524     v-recid = v-bh:recid no-error .
      525     delete object v-qh.
      526     delete object v-bh.
      527     return string(v-recid) .
      528   end.
      529   end procedure.
      530   procedure fltopend_fltfindq :
      531   define input parameter p-parent-handle as handle no-undo .
      532   define input parameter p-qh as handle no-undo .
      533   define input parameter p-next as logical no-undo .
      534   define input parameter p-lock as integer no-undo .
      535   define input parameter p-flt-open-open-query  as character no-undo .
      536   define input parameter p-where-cond as character no-undo .
      537   define input parameter p-use-indFIRST-query-tail as character no-undo .
      538   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      539   define input parameter p-indexed-reposition as character no-undo .
      540   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      541   define variable glog as logical no-undo .
      542   define variable v-qh as handle no-undo .
      543   define variable v-bh as handle no-undo extent 18.
      544   define variable v-rowid as rowid no-undo extent 18.
      545   define variable v-ii as integer no-undo .
      546   define variable v-prepare-string as character no-undo .
      547   do
      548   on error undo, return error
      549   on stop undo, return error
      550   :
      551     create query v-qh.
      552     do v-ii = 1 to p-qh:num-buffers:
      553       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      554       assign
      555       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      556       no-error.
      557       v-qh:add-buffer(v-bh[v-ii]).
      558     end.
      559     assign
      560     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      561                       p-where-cond + chr(32)  +
      562                       p-use-indFIRST-query-tail + chr(32) +
      563                       p-use-ind-sort-clmn-by + chr(32) +
      564                       p-indexed-reposition
      565     .
      566     glog = v-qh:query-prepare( v-prepare-string) no-error .
      567     if not glog then do:
      568       delete object v-qh.
      569       do v-ii = 1 to p-qh:num-buffers:
      570         delete object v-bh[v-ii].
      571       end.
      572       undo, return error .
      573     end.
      574     glog = v-qh:query-open no-error .
      575     if not glog then do:
      576       delete object v-qh.
      577       do v-ii = 1 to p-qh:num-buffers:
      578         delete object v-bh[v-ii].
      579       end.
      580       undo, return error .
      581     end.
      582     if p-next then do:
      583       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      584       glog = v-qh:get-next( p-lock) no-error .
      585       glog = v-qh:get-next( p-lock) no-error .
      586       if not glog or v-qh:query-off-end = yes then do:
      587         glog = v-qh:get-first( p-lock) no-error .
      588       end.
      589     end.
      590     else do:
      591       glog = v-qh:get-first( p-lock) no-error .
      592     end.
      593     do v-ii = 1 to p-qh:num-buffers:
      594       assign
      595       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
      596       no-error.
      597     end.
      598     delete object v-qh.
      599     do v-ii = 1 to p-qh:num-buffers:
      600       delete object v-bh[v-ii].
      601     end.
      602   end.
      603   end procedure.
      604   DEFINE VARIABLE v-doc-rec AS RECID NO-UNDO.
      605   define variable sort-column-name as character no-undo .
      606   define variable filter-point-label as character no-undo init "Привязка скриптов к наборам правил" .
      607   define variable filter-point0 as character no-undo init "pscript-ruleset-s" .
      608   define variable filter-point as character no-undo init "pscript-ruleset-s" .
      609   DEFINE VARIABLE p-word-script-name AS CHARACTER NO-UNDO.
      610   define variable v-rid-list as character no-undo .
      611   FUNCTION get-translation RETURNS CHARACTER
      612     ( INPUT p-uniq-key-rec AS character )  FORWARD.
      613   DEFINE BUTTON b-add
      614        LABEL "&Добавить"
      615        SIZE 10 BY 1.
      616   DEFINE BUTTON b-chg
      617        LABEL "&Изменить"
      618        SIZE 10 BY 1.
      619   DEFINE BUTTON b-del
      620        LABEL "&Удалить"
      621        SIZE 10 BY 1.
      622   DEFINE BUTTON B-Help
      623        LABEL "Помо&щь"
      624        SIZE 3 BY 1
      625        BGCOLOR 8 .
      626   DEFINE BUTTON b-lkp
      627        LABEL "&Просмотр"
      628        SIZE 10 BY 1.
      629   DEFINE BUTTON b-mark
      630        LABEL "&*"
      631        SIZE 4 BY 1.
      632   DEFINE BUTTON b-quit AUTO-END-KEY
      633        LABEL "&Выход"
      634        SIZE 10 BY 1
      635        BGCOLOR 8 .
      636   DEFINE BUTTON b-sch
      637        LABEL "&Фильтр"
      638        SIZE 3 BY 1.
      639   DEFINE BUTTON b-sel AUTO-GO
      640        LABEL "Выбор"
      641        SIZE 10 BY 1.
      642   DEFINE VARIABLE cb-pscript-ruleset AS CHARACTER FORMAT "X(256)":U
      643        LABEL "Объект-операнд"
      644        VIEW-AS COMBO-BOX INNER-LINES 10
      645        LIST-ITEM-PAIRS "Item 1","Item 1"
      646        DROP-DOWN-LIST
      647        SIZE 80.5 BY 1 NO-UNDO.
      648   DEFINE VARIABLE f-script-name AS CHARACTER FORMAT "X(256)":U
      649        VIEW-AS FILL-IN
      650        SIZE 73.5 BY 1 NO-UNDO.
      651   DEFINE VARIABLE mark-num AS INTEGER FORMAT "->,>>>,>>9":U INITIAL 0
      652         VIEW-AS TEXT
      653        SIZE 9 BY .67
      654        FGCOLOR 10  NO-UNDO.
      655   DEFINE VARIABLE rs-find AS CHARACTER INITIAL "begins"
      656        VIEW-AS RADIO-SET HORIZONTAL
      657        RADIO-BUTTONS
      658             "Нач.назв.", "begins",
      659   "Нач.слова", "contains"
      660        SIZE 23 BY 1 NO-UNDO.
      661   DEFINE VARIABLE rs-language AS CHARACTER
      662        VIEW-AS RADIO-SET HORIZONTAL
      663        RADIO-BUTTONS
      664             "Item 1", "1",
      665   "Item 2", "2"
      666        SIZE 24 BY 1 NO-UNDO.
      667   DEFINE QUERY br-pscript-ruleset FOR
      668         X_pscript-ruleset,
      669         X_prop-script,
      670         X_prop-head SCROLLING.
      671   DEFINE BROWSE br-pscript-ruleset
      672     QUERY br-pscript-ruleset NO-LOCK DISPLAY
      673         mark-string(recid(X_pscript-ruleset), v-rid-list) Format "X(1)" COLUMN-LABEL "*"
      674   X_pscript-ruleset.codex_id COLUMN-LABEL "Кодекс!правил" FORMAT ">>>>>>>>9"
      675   X_pscript-ruleset.ruleset_id COLUMN-LABEL "Набор!правил" FORMAT ">>>>>>>>9"
      676   X_pscript-ruleset.dtm-code COLUMN-LABEL "Код!объекта" FORMAT ">>>>>>>>9"
      677   X_pscript-ruleset.revis_id COLUMN-LABEL "Версия" FORMAT ">>>>>>9"
      678   X_pscript-ruleset.script-name COLUMN-LABEL "Имя скрипта" format "X(255)"
      679         width 45
      680   get-translation(X_prop-script.uniq-key-rec) COLUMN-LABEL "Перевод" FORMAT "X(255)":U
      681           WIDTH 40
      682   X_prop-head.prop-name COLUMN-LABEL "Имя объекта" format "X(32)"
      683   X_prop-head.prop-label COLUMN-LABEL "Лейбл объекта" format "X(255)"
      684       width 45
      685       WITH NO-ROW-MARKERS SEPARATORS SIZE 97 BY 17.53 FIT-LAST-COLUMN.
      686   DEFINE FRAME Dialog-Frame
      687        b-quit AT ROW 1 COL 1
      688        b-mark AT ROW 1 COL 24 WIDGET-ID 12
      689        b-sel AT ROW 1 COL 28 WIDGET-ID 10
      690        b-add AT ROW 1 COL 38 WIDGET-ID 2
      691        b-chg AT ROW 1 COL 48 WIDGET-ID 4
      692        b-del AT ROW 1 COL 58 WIDGET-ID 8
      693        b-lkp AT ROW 1 COL 68 WIDGET-ID 6
      694        b-sch AT ROW 1 COL 92 WIDGET-ID 48
      695        B-Help AT ROW 1 COL 95
      696        rs-language AT ROW 2 COL 21 NO-LABEL WIDGET-ID 52
      697        cb-pscript-ruleset AT ROW 3 COL 2 WIDGET-ID 46
      698        rs-find AT ROW 4 COL 1.5 NO-LABEL WIDGET-ID 56
      699        f-script-name AT ROW 4 COL 23 COLON-ALIGNED NO-LABEL WIDGET-ID 50
      700        br-pscript-ruleset AT ROW 5 COL 1.5 WIDGET-ID 100
      701        mark-num AT ROW 1 COL 13 COLON-ALIGNED NO-LABEL WIDGET-ID 14
      702        SPACE(74.50) SKIP(21.20)
      703       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      704            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      705            TITLE "Привязка скриптов объектов-операндов к наборам правил"
      706            CANCEL-BUTTON b-quit.
      707   ASSIGN
      708          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      709          FRAME Dialog-Frame:HIDDEN           = TRUE.
      710   ON GO OF FRAME Dialog-Frame
      711   DO:
      712     p-rid-list = v-rid-list.
      713   END.
      714   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      715   DO:
      716     APPLY "END-ERROR":U TO SELF.
      717   END.
      718   ON CHOOSE OF b-add IN FRAME Dialog-Frame
      719   DO:
      720     run proc-b-add-chg in this-procedure ( input yes) no-error.
      721     if error-status:error then return no-apply.
      722   END.
      723   ON CHOOSE OF b-del IN FRAME Dialog-Frame
      724   DO:
      725     define variable v-rec as recid no-undo.
      726     define variable glog as logical no-undo.
      727     if not available X_pscript-ruleset then return no-apply.
      728     v-rec = recid(X_pscript-ruleset).
      729     message "Вы уверены, что хотите удалить привязку скрипта к набору правил?"
      730     view-as alert-box question buttons yes-no  update glog.
      731     if not glog then return no-apply.
      732     run rul/pscript-ruleset3.p ( input no
      733                                  ,input v-rec
      734                                   ) no-error.
      735     if error-status:error then return no-apply.
      736     Run Openbr in this-procedure ( input yes, input no, input '':U).
      737   END.
      738   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
      739   DO:
      740     define variable v-rec as recid no-undo.
      741     if not available X_pscript-ruleset then return no-apply.
      742     v-rec = recid(X_pscript-ruleset).
      743     run rul/prop-script-i.w ( input parparentproc
      744                          ,input 'ПРОСМОТР':U
      745                          ,input X_pscript-ruleset.dtm-code
      746                          ,input X_pscript-ruleset.language
      747                          ,input X_pscript-ruleset.script-name
      748                          ,input X_pscript-ruleset.revis_id
      749                          ,input-output v-rec) no-error.
      750   END.
      751   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
      752   DO:
      753       define variable glog as logical no-undo .
      754     if available X_pscript-ruleset then do:
      755   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      756   define variable v-str-recid8 as character no-undo .
      757   define variable v-num-entry8 as integer   no-undo .
      758   assign
      759     v-str-recid8 = trim( string( recid( X_pscript-ruleset ) , "->>>>>>>>>>>9":U ) )
      760     v-num-entry8 = lookup( v-str-recid8 , v-rid-list )
      761   .
      762   if v-num-entry8 > 0 then do:
      763     assign
      764       entry( v-num-entry8, v-rid-list ) = "":U
      765       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
      766     .
      767   end.
      768   else do:
      769     assign
      770       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid8
      771     .
      772   end.
      773     glog = br-pscript-ruleset:refresh() .
      774     if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
      775         glog = br-pscript-ruleset:select-next-row ().
      776         apply "VALUE-CHANGED" to br-pscript-ruleset in frame Dialog-Frame.
      777     end.
      778     if num-entries( v-rid-list ) = 0
      779     then
      780         hide mark-num in frame Dialog-Frame.
      781     else
      782         disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
      783   end.
      784   apply "entry" to br-pscript-ruleset in frame Dialog-Frame.
      785   END.
      786   ON CHOOSE OF b-sch IN FRAME Dialog-Frame
      787   DO:
      788     RUN proc-b-sch IN THIS-PROCEDURE NO-ERROR.
      789     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      790   END.
      791   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
      792   DO:
      793     if available X_pscript-ruleset then do:
      794       if  ( v-rid-list = "" ) or b-mark:sensitive = no
      795       then  v-rid-list = string( recid( X_pscript-ruleset ) ) .
      796     end.
      797   END.
      798   ON VALUE-CHANGED OF cb-pscript-ruleset IN FRAME Dialog-Frame
      799   DO:
      800     ASSIGN cb-pscript-ruleset.
      801     RUN Openbr IN THIS-PROCEDURE ( input yes, input no, input '':U).
      802   END.
      803   ON CTRL-J OF f-script-name IN FRAME Dialog-Frame
      804   DO:
      805       run proc-find-script-name in this-procedure ( input YES
      806                                                    ,input frame Dialog-Frame f-script-name
      807                                                    ,INPUT rs-find) no-error.
      808     if error-status:error then return no-apply.
      809   END.
      810   ON RETURN OF f-script-name IN FRAME Dialog-Frame
      811   DO:
      812     run proc-find-script-name in this-procedure ( input NO
      813                                                 , input frame Dialog-Frame f-script-name
      814                                                 , INPUT rs-find) no-error.
      815     if error-status:error then return no-apply.
      816   END.
      817   ON VALUE-CHANGED OF rs-find IN FRAME Dialog-Frame
      818   DO:
      819     ASSIGN
      820     rs-find.
      821     apply "ENTRY" to f-script-name.
      822   END.
      823   ON VALUE-CHANGED OF rs-language IN FRAME Dialog-Frame
      824   DO:
      825     ASSIGN
      826     rs-language.
      827     CASE rs-language:
      828       WHEN "ABL" THEN DO:
      829         X_pscript-ruleset.script-name:VISIBLE IN browse br-pscript-ruleset = YES.
      830       END.
      831       WHEN "rus" THEN DO:
      832         X_pscript-ruleset.script-name:VISIBLE IN browse br-pscript-ruleset = NO.
      833       END.
      834     END CASE.
      835   END.
      836   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      837   on f5 of frame Dialog-Frame anywhere
      838   do:
      839      v-doc-rec = recid(X_pscript-ruleset).    RUn OpenBR in this-procedure ( input yes, input no, input '':U).  REPOSITION br-pscript-ruleset to recid v-doc-rec No-ERROR.   apply 'value-changed' to br-pscript-ruleset.
      840       apply "VALUE-CHANGED" to br-pscript-ruleset.
      841   end.
      842   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      843   procedure set-filter-name :
      844   define input parameter p-filter-name as character no-undo .
