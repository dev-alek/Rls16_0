     1355                                             , OUTPUT v-cntxt-userid
     1356                                             ) .
     1357           run gbl/wndsizew.p
     1358             (input  v-cntxt-db-num
     1359             ,input  v-cntxt-userid
     1360             ,input  v-diasize-proc-name
     1361             ,input  'height':u
