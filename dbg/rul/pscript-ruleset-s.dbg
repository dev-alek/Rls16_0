      881   end.
      882   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      883   procedure minbtn-set :
      884       do
      885           on error undo, return error return-value
      886           :
      887           define variable ii              as integer       no-undo .
      888           define variable fh              as widget-handle no-undo .
      889           define variable hh              as widget-handle no-undo .
      890           define variable v-h             as handle        extent 4 no-undo .
      891           define variable v-name-button   as character     no-undo .
      892           define variable v-help-old-x    as decimal       no-undo .
      893           define variable v-help-old-y    as decimal       no-undo .
      894           define variable v-help-old-size as decimal       no-undo .
      895           define variable v-frame-width   as decimal       no-undo .
      896           define variable jj              as integer       no-undo .
      897           do
      898               on error undo, return error
      899               :
      900               assign
      901                   v-frame-width = frame Dialog-Frame:width - 0.3
      902                   fh            = frame Dialog-Frame:first-child
      903                   hh            = fh:first-child
      904                   ii            = 1
      905                   .
      906               do while valid-handle(hh):
      907                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      908                   do:
      909                       case lc(hh:name) :
      910                           when "b-help" then
      911                               do:
      912                                   hh:load-image-up("cmp/b-help.bmp":u) .
      913                                   hh:load-image-down("cmp/b-help.bmp":u) .
      914                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      915                                   hh:TOOLTIP = "Помощь" .
      916                                   v-help-old-x = hh:column .
      917                                   v-help-old-y = hh:row    .
      918                                   v-help-old-size = hh:width .
      919                                   hh:width-chars = 2.5 .
      920                               end.
      921                           when "b-print" then
      922                               do:
      923                                   hh:load-image("cmp/b-print.bmp":u) .
      924                                   hh:TOOLTIP = "Печать" .
      925                                   v-h[ii] = hh:handle .
      926                                   ii = ii + 1 .
      927                                   hh:width-chars = 3 .
      928                               end.
      929                           when "b-history" or
      930                           when "b-hist" then
      931                               do:
      932                                   hh:load-image("cmp/b-hist.bmp":u) .
      933                                   hh:TOOLTIP = "История" .
      934                                   v-h[ii] = hh:handle .
      935                                   ii = ii + 1 .
      936                                   hh:width-chars = 3 .
      937                               end.
      938                           when "b-sch" then
      939                               do:
      940                                   hh:load-image("cmp/b-sch.bmp":u) .
      941                                   hh:TOOLTIP = "Установка Фильтра" .
      942                                   v-h[ii] = hh:handle .
      943                                   ii = ii + 1 .
      944                                   hh:width-chars = 3 .
      945                               end.
      946                           when "b-hist-user" then
      947                               do:
      948                                   hh:load-image("cmp/b-hist.bmp":u) .
      949                                   hh:TOOLTIP = "История пользователя" .
      950                                   ii = ii + 1 .
      951                               end.
      952                       end case.
      953                   end.
      954                   hh = hh:next-sibling.
      955               end.
      956               b-help:column = v-frame-width - b-help:width-chars.
      957               jj = 0.
      958               repeat ii = 4 to 1 by -1 :
      959                   if valid-handle (v-h[ii] ) then
      960                   do:
      961                       jj  = jj + 1 .
      962                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      963                       v-h[ii]:row    = v-help-old-y .
      964                   end.
      965               end.
      966           end.
      967       end.
      968   end procedure.
      969   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      970   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      971   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      972   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      973   define variable v-diasize-current-frame-width  as decimal   no-undo .
      974   define variable v-diasize-current-frame-height as decimal   no-undo .
      975   define variable v-diasize-change-size          as logical   no-undo .
      976   define variable v-diasize-resize-button        as handle    no-undo .
      977   define variable v-diasize-wndmax               as logical   no-undo .
      978   define variable v-diasize-wndstore             as logical   no-undo .
      979   define variable v-diasize-proc-name            as character no-undo .
      980   define variable v-diasize-browse-handle        as handle    no-undo .
      981   define variable v-diasize-browse-number        as integer   no-undo .
      982   define variable v-diasize-need-full-display    as logical   no-undo init false .
      983   define temp-table temp-diasize-handle no-undo
      984     field handle-value  as handle
      985     field save-position as decimal
      986     index xpk is primary unique handle-value
      987     .
      988   define temp-table temp-browse-handle no-undo
      989     field browse-type   as character
      990     field browse-number as integer
      991     field browse-handle as handle
      992     field original-size as decimal
      993     index xpk is primary unique browse-type browse-number
      994     index xie browse-type browse-handle
      995   .
      996   procedure diasize_change-height :
      997     define input  parameter p-change-value  as decimal   no-undo .
      998     define input  parameter p-move-resize   as logical   no-undo .
      999     define variable v-field-group-handle    as handle    no-undo .
     1000     define variable v-object-handle         as handle    no-undo .
     1001     define variable v-frame-height          as decimal   no-undo .
     1002     define variable v-frame-virtual-height  as decimal   no-undo .
     1003     define variable v-browse-height         as decimal   no-undo .
     1004     define variable v-window-height         as decimal   no-undo .
     1005     define variable v-window-virtual-height as decimal   no-undo .
     1006     define variable v-change-sign           as integer   no-undo .
     1007     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1008     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1009     if p-change-value > 0
     1010     then do:
     1011       if frame Dialog-Frame :height + p-change-value
     1012           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1013       then do:
     1014         assign
     1015           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1016                           - (frame Dialog-Frame :height-chars)
     1017         .
     1018         if p-change-value <= 0
     1019         then do:
     1020           run diasize_position-resize-button in this-procedure .
     1021           return .
     1022         end.
     1023       end.
     1024     end.
     1025     if p-change-value < 0
     1026     then do:
     1027       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1028       then do:
     1029         assign
     1030           p-change-value = v-diasize-orig-frame-height
     1031                          - (frame Dialog-Frame :height-chars)
     1032         .
     1033         if p-change-value >= 0
     1034         then do:
     1035           run diasize_position-resize-button in this-procedure .
     1036           return .
     1037         end.
     1038       end.
     1039     end.
     1040     if p-change-value >= 0
     1041     then do:
     1042       assign
     1043         v-change-sign = 1
     1044       .
     1045     end.
     1046     else do:
     1047       assign
     1048         v-change-sign = -1
     1049       .
     1050     end.
     1051     assign
     1052       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1053     .
     1054     if p-change-value = 0
     1055     then do:
     1056       run diasize_position-resize-button in this-procedure .
     1057       return .
     1058     end.
     1059     move_block:
     1060     do
     1061     on error undo move_block, retry move_block
     1062     :
     1063       if retry
     1064       then do:
     1065         do
     1066         on error undo move_block, leave move_block
     1067         :
     1068           if p-change-value > 0
     1069           then do:
     1070             for each buf_temp-diasize-handle
     1071             on error undo, next
     1072             :
     1073               assign
     1074                 v-object-handle = buf_temp-diasize-handle.handle-value
     1075               .
     1076               if v-object-handle <> v-diasize-resize-button
     1077               then do:
     1078                 assign
     1079                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1080                 .
     1081               end.
     1082             end.
