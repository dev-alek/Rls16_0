        1   block-level on error undo, throw.
        2   define input parameter p-silent as logical no-undo .
        3   define input parameter p-rec as recid no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision$":U .
        5   define variable vss-author      as character no-undo init "$Author$":U .
        6   define variable vss-date        as character no-undo init "$Date$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        8   define variable vss-archive     as character no-undo init "$Archive$":U .
        9   define variable vss-description as character no-undo init "Удаление rule-by-profile".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define variable v-mess as character no-undo .
       69   define buffer buf_rule-by-profile  for dictdb.rule-by-profile.
       70   define buffer buf_rule  for ub.rule.
       71   define buffer buf_rp-by-call for ub.rp-by-call.
       72   define buffer buf_rp-rule-param for ub.rp-rule-param.
       73   main-block:
       74   do
       75   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
       76   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
       77   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
       78   :
       79     find first buf_rule-by-profile exclusive-lock where
       80             recid(buf_rule-by-profile) = p-rec .
       81     find first buf_rp-by-call where
       82              buf_rp-by-call.profile_id = buf_rule-by-profile.profile_id no-error.
       83     if available buf_rp-by-call then do:
       84       v-mess = substitute("Есть привязки к профайлу &1 (&2) удаление запрещено"
       85                           , buf_rp-by-call.profile_id
       86                           , buf_rp-by-call.call_id).
       87      run err-mess in this-procedure ( input-output v-mess) .
       88      undo main-block, return error (if p-silent = yes then v-mess else '':U).
       89     end.
       90     find first buf_rule no-lock where
       91               buf_rule.rule_id = buf_rule-by-profile.rule_id no-error.
       92     if available buf_rule then do:
       93       find  current buf_rule exclusive-lock .
       94     end.
       95     for each buf_rp-rule-param where
       96             buf_rp-rule-param.profile_id = buf_rule-by-profile.profile_id
       97             and buf_rp-rule-param.codex_id = buf_rule-by-profile.codex_id
       98             and buf_rp-rule-param.ruleset_id = buf_rule-by-profile.ruleset_id
       99             and buf_rp-rule-param.rp_order_id = buf_rule-by-profile.rp_order_id
      100             and buf_rp-rule-param.rule_id = buf_rule-by-profile.rule_id
      101     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      102     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      103     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      104     :
      105       delete buf_rp-rule-param.
      106     end.
      107     delete buf_rule-by-profile no-error.
      108     if error-status:error then do:
      109       v-mess = substitute("Ошибка при удалении: &1&2&3"
      110                            , error-status:get-message(1)
      111                            , chr(10)
      112                            , return-value ).
      113      run err-mess in this-procedure ( input-output v-mess) .
      114      undo main-block, return error (if p-silent = yes then v-mess else '':U).
      115     end.
      116     if available buf_rule then do:
      117       define variable v-ok as logical no-undo .
      118       run trg/rule-chk.p ( input 'удаление':U
      119                           ,input buf_rule.rule_id
      120                           ,output v-ok
      121                           ,output v-mess
      122                           ) no-error.
      123       if not error-status:error
      124       and not v-ok then do:
      125         if buf_rule.sts <> integer('-1':U) then do:
      126           buf_rule.sts = integer('-1':U).
      127         end.
      128       end.
      129     end.
      130   end.
      131   PROCEDURE err-mess:
      132     DEFINE INPUT-OUTPUT PARAMETER p-mess as character No-UNDO.
      133     CASE p-silent:
      134       when yes then do:
      135         assign
      136         p-mess = substitute("Привязка правила к профайлу:&1профайл &2 кодекс &3 набор &4 порядок вызова &5 № правила &6:&1&6"
      137                            , chr(10)
      138                            , buf_rule-by-profile.profile_id
      139                            , buf_rule-by-profile.codex_id
      140                            , buf_rule-by-profile.ruleset_id
      141                            , buf_rule-by-profile.rule_id
      142                            , buf_rule-by-profile.rp_order_id
      143                            , p-mess)
      144         .
      145       end.
      146       when no then do:
      147         message
      148         p-mess
      149         view-as alert-box error .
      150       end.
      151     end.
      152   END PROCEDURE.
