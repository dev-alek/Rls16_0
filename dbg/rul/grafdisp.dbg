        1   block-level on error undo, throw.
        2   DEFINE INPUT PARAMETER p-rule-id AS INTEGER NO-UNDO.
        3   define input parameter p-language as character no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision$":U .
        5   define variable vss-author      as character no-undo init "$Author$":U .
        6   define variable vss-date        as character no-undo init "$Date$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        8   define variable vss-archive     as character no-undo init "$Archive$":U .
        9   define variable vss-description as character no-undo init "".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define   shared variable g#auto as logical no-undo.
       71   define   shared variable g#news as logical no-undo.
       72   define   shared variable g#oxml as logical no-undo.
       73   define   shared variable g#esys as logical no-undo.
       74   define   shared variable g#news-source-db as integer no-undo.
       75   define   shared variable g#esys-source-esys as integer no-undo.
       76   define   shared variable g#db-num as integer   no-undo .
       77   define   shared variable g#userid as character no-undo .
       78   define   shared variable g#passwd as character no-undo .
       79   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       80   define temp-table temp-string no-undo
       81   field v-string as character
       82   field string-num as integer
       83   index pi is unique primary string-num.
       84   procedure temp-string_clear :
       85     define buffer buf_temp-string for temp-string .
       86     do
       87     on error undo, return error return-value
       88     :
       89       for each buf_temp-string
       90       on error undo, return error
       91       :
       92         delete buf_temp-string.
       93       end.
       94     end.
       95   end procedure.
       96   procedure temp-string_write :
       97     define input  parameter p-v-string    as character no-undo .
       98     define variable v-string-num as integer no-undo .
       99     define buffer buf_temp-string for temp-string .
      100     do
      101     on error undo, return error return-value
      102     :
      103       find last buf_temp-string no-error .
      104       if not available buf_temp-string then do:
      105         create buf_temp-string .
      106         assign
      107         buf_temp-string.string-num     = 1
      108         buf_temp-string.v-string       = p-v-string
      109         .
      110       end.
      111       else do:
      112         v-string-num = buf_temp-string.string-num.
      113         create buf_temp-string .
      114         assign
      115         buf_temp-string.string-num = v-string-num + 1
      116         buf_temp-string.v-string = p-v-string
      117         .
      118       end.
      119     end.
      120   end procedure.
      121   procedure temp-string_read :
      122     define input  parameter p-string-num    as integer   no-undo .
      123     define output parameter p-v-string      as character no-undo .
      124     define buffer buf_temp-string for temp-string .
      125     do
      126     on error undo, return error return-value
      127     :
      128       find first buf_temp-string
      129         where buf_temp-string.string-num     = p-string-num
      130         no-error .
      131       if available buf_temp-string then do:
      132         assign
      133           p-v-string = buf_temp-string.v-string
      134         .
      135       end.
      136       else do:
      137         assign
      138           p-v-string = '':U
      139         .
      140       end.
      141     end.
      142   end procedure.
      143   procedure temp-string_append :
      144     define input  parameter p-string-num  as integer   no-undo .
      145     define input  parameter p-v-string    as character no-undo .
      146     define input  parameter p-append-char as character no-undo .
      147     define buffer buf_temp-string for temp-string .
      148     do
      149     on error undo, return error return-value
      150     :
      151       find first buf_temp-string
      152            where buf_temp-string.string-num = p-string-num
      153         no-error .
      154       if not available buf_temp-string then do:
      155         create buf_temp-string .
      156         assign
      157           buf_temp-string.string-num  = p-string-num
      158           buf_temp-string.v-string    = p-v-string
      159         .
      160       end.
      161       else do:
      162           assign
      163           buf_temp-string.v-string = buf_temp-string.v-string + p-append-char + p-v-string
      164           .
      165       end.
      166     end.
      167   end procedure.
      168   procedure temp-string_get-last-num:
      169   define output parameter p-string-num  as integer   no-undo .
      170   define buffer buf_temp-string for temp-string .
      171   find last buf_temp-string no-error.
      172   if available buf_temp-string then do:
      173     p-string-num = buf_temp-string.string-num.
      174   end.
      175   end procedure.
      176   procedure temp-string_delete-range:
      177   define input parameter p-first-string-num  as integer   no-undo .
      178   define input parameter p-last-string-num  as integer   no-undo .
      179   define buffer buf_temp-string for temp-string .
      180   for each buf_temp-string where
      181           buf_temp-string.string-num >= p-first-string-num
      182       and buf_temp-string.string-num <= p-last-string-num:
      183     delete buf_temp-string.
      184   end.
      185   end procedure.
      186   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      187   DEFINE TEMP-TABLE tt-rule NO-UNDO LIKE ub.rule
      188          field level as integer.
      189   DEFINE TEMP-TABLE tt-rule-script NO-UNDO LIKE ub.rule-script
      190          field level as integer
      191          field gen-order as character
      192          field upper_rule_id as integer
      193          field start-script_id as integer
      194          field end-script_id as integer
      195          field edge-type as character
      196          .
      197   define temp-table temp-rule-i-script no-undo
      198   like ub.rule-i-script.
      199   PROCEDURE fill-tables :
      200   DEFINE INPUT PARAMETER p-rule-id AS INTEGER NO-UNDO.
      201   DEFINE INPUT PARAMETER p-root-rule-id AS INTEGER NO-UNDO.
      202   DEFINE INPUT-OUTPUT PARAMETER p-level AS INTEGER NO-UNDO.
      203   DEFINE INPUT PARAMETER p-gen-order AS character NO-UNDO.
      204   DEFINE BUFFER buf_rule FOR ub.RULE.
      205   DEFINE BUFFER buf_rule-script FOR ub.RULE-script.
      206   DEFINE BUFFER buf_tt-rule FOR tt-RULE.
      207   DEFINE BUFFER buf_tt-rule-script FOR tt-RULE-script.
      208   if p-level = 0 then do:
      209     find first buf_rule where
      210               buf_rule.rule_id = p-root-rule-id.
      211     create buf_tt-rule.
      212     buffer-copy buf_rule to buf_tt-rule.
      213     release buf_tt-rule.
      214   end.
      215   p-level = p-level + 1.
      216   FOR EACH buf_rule NO-LOCK WHERE
      217           buf_rule.UPPER_rule_id = p-rule-id:
      218      find first buf_tt-rule where
      219               buf_tt-rule.rule_id = buf_rule.rule_id no-error.
      220      if not available buf_tt-rule then do:
      221       CREATE buf_tt-rule.
      222       buffer-copy buf_rule to buf_tt-rule.
      223       ASSIGN
      224       buf_tt-rule.root_rule_id = p-root-rule-id
      225       .
      226      end.
      227      buf_tt-rule.level = p-level.
      228      RUN fill-tables IN THIS-PROCEDURE (  INPUT buf_tt-rule.RULE_id
      229                                          ,INPUT p-root-rule-id
      230                                          ,INPUT-OUTPUT p-level
      231                                          ,INPUT (p-gen-order +
      232                                           STRING(p-level, "99") +
      233                                           STRING(buf_tt-rule.salience, "999"))).
      234   END.
      235   FOR EACH buf_rule-script NO-LOCK WHERE
      236           buf_rule-script.rule_id = p-rule-id:
      237      find first buf_tt-rule-script where
      238               buf_tt-rule-script.script_id = buf_rule-script.script_id
      239          AND  buf_tt-rule-script.LANGUAGE = buf_rule-script.LANGUAGE
      240          no-error.
      241      if not available buf_tt-rule-script
      242      then do:
      243       find first buf_tt-rule no-lock where
      244                 buf_tt-rule.rule_id = buf_rule-script.rule_id.
      245       CREATE buf_tt-rule-script.
      246       buffer-copy buf_rule-script to buf_tt-rule-script.
      247       ASSIGN
      248       buf_tt-rule-script.root_rule_id = p-root-rule-id
      249       buf_tt-rule-script.upper_rule_id = buf_tt-rule.upper_rule_id
      250       .
      251      end.
      252      assign
      253      buf_tt-rule-script.level = p-level
      254      buf_tt-rule-script.gen-order = p-gen-order +
      255                                     STRING(buf_tt-rule-script.level, "99") +
      256                                     STRING(buf_tt-rule-script.salience, "999").
      257      .
      258   END.
      259   p-level = p-level - 1.
      260   END PROCEDURE.
      261   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      262   define temp-table temp-edge no-undo
      263   field from-script_id as integer
      264   field to-script_id as integer
      265   field edge-type as character
      266   index pi is unique primary
      267   from-script_id
      268   to-script_id
      269   .
      270   function break-string-for-dot returns character (input p-string as character, input p-line-length AS INTEGER):
      271   define variable v-string as character no-undo .
      272   define variable v-output-string as character no-undo .
      273   define variable v-entry as character no-undo .
      274   define variable v-index as integer no-undo .
      275   v-string = p-string.
      276   v-output-string = p-string.
      277   do while length(v-string) > p-line-length :
      278     ASSIGN
      279     v-entry = substring(v-string, 1, p-line-length)
      280     v-index = r-index(v-entry, chr(32)).
      281     if v-index > 0
      282     and v-index <= p-line-length then do:
      283        assign
      284        v-output-string = v-output-string + substring(v-entry, 1, v-index - 1)  + '\N'.
      285        v-string = substring(v-string, v-index + 1)
      286        no-error.
      287        if error-status:error then leave.
      288     end.
      289     ELSE DO:
      290         assign
      291         v-output-string = v-output-string + v-entry.
      292         v-string = substring(v-string, 71)
      293         no-error.
      294     END.
      295   end.
      296   return v-output-string.
      297   end.
      298   PROCEDURE DISPLAY-RULE :
      299   define INPUT parameter p-rule-id AS integer no-undo.
      300   define input parameter p-upper-rule-id as integer no-undo .
      301   define input parameter p-language as character no-undo.
      302   define input-output parameter p-level as integer no-undo .
      303   define variable v-exist-condition-script as logical no-undo .
      304   define variable v-exist-rule-script as logical no-undo .
      305   define variable v-main-seq as character no-undo .
      306   define variable v-prev-node as character no-undo .
      307   define variable v-current-node as character no-undo .
      308   define variable v-next-node as character no-undo .
      309   define variable v-bottom-node as character no-undo .
      310   define variable v-top-node as character no-undo .
      311   define variable v-edge-label as logical no-undo .
      312   define variable v-language as character no-undo .
      313   define variable v-upper-rule-id as integer no-undo .
      314   define variable v-rule-id as integer no-undo .
      315   define variable v-salience as integer no-undo .
      316   define variable v-gen-order as character no-undo .
      317   define variable v-goto-text as character no-undo .
      318   define variable v-goto-rule as character no-undo .
      319   define buffer buf_rule for ub.rule.
      320   define buffer buf_upper-rule for ub.rule.
      321   define buffer buf_upper-rule-script for ub.rule-script.
      322   define buffer buf_down-rule for ub.rule.
      323   define buffer buf2_rule-script for ub.rule-script.
      324   define buffer buf3_rule-script for ub.rule-script.
      325   define buffer buf2_rule for ub.rule.
      326   define buffer buf_rule-script for ub.rule-script.
      327   define buffer buf_prop-script for ub.prop-script.
      328   define buffer buf_rule-i-script for ub.rule-i-script.
      329   define buffer buf_tt-rule-script for tt-rule-script.
      330   define buffer buf_temp-edge for temp-edge.
      331   define buffer buf_tt-rule for tt-rule.
      332   CASE p-language:
      333     WHEN "ABL" THEN DO:
      334       find first buf_rule no-lock where
      335                 buf_rule.rule_id = p-rule-id.
      336       if buf_rule.hidden-content > 0 then do:
      337         run temp-string_write in this-procedure ( input substitute("/* содержимое скрыто*/")).
      338         return.
      339       end.
      340       if p-upper-rule-id = 0 then do:
      341         run temp-string_write in this-procedure ( input substitute("/* &1", buf_Rule.name)).
      342         run temp-string_write in this-procedure ( input substitute("&1 */", buf_Rule.documentation)).
      343         run temp-string_write in this-procedure ( input '':U).
      344       end.
      345       else do:
      346         run temp-string_write in this-procedure ( input substitute("/* salience &1 in upper-rule-id &2*/"
      347                                                                   , buf_rule.salience
      348                                                                   , buf_rule.upper_rule_id
      349                                                                   )).
      350       end.
      351       run temp-string_write in this-procedure ( input  substitute("&1_&2:&3&1do:"
      352                                                                   ,fill( chr(32), p-level * 2)
      353                                                                   ,p-rule-id
      354                                                                   ,chr(10))).
      355       FOR EACH buf_rule-script NO-LOCK WHERE
      356         buf_rule-script.RULE_id = p-RULE-id
      357         AND buf_rule-script.LANGUAGE = p-language
      358       by buf_rule-script.salience :
      359         if buf_rule-script.script-type = 'COND':U then do:
      360           run temp-string_write in this-procedure (input  substitute("&1/* salience &2 rule_id &3*/"
      361                                                                      ,fill(chr(32), 70)
      362                                                                      ,buf_rule-script.salience
      363                                                                      ,buf_rule-script.rule_ID
      364                                                                      ) ).
      365           run temp-string_write in this-procedure (input  substitute("&1IF &2  THEN do:   "
      366                                                                       ,fill( chr(32), p-level * 2)
      367                                                                       ,replace(buf_rule-script.script, (chr(38) + chr(38)), chr(38))
      368                                                                       )).
      369           .
      370           assign
      371           v-exist-rule-script = yes
      372           .
      373         end.
      374         if buf_rule-script.script-type = 'CYCLE-COND':U then do:
      375           run temp-string_write in this-procedure (input  substitute("&1/* salience &2 rule_id &3*/"
      376                                                                      ,fill(chr(32), 70)
      377                                                                      ,buf_rule-script.salience
      378                                                                      ,buf_rule-script.rule_ID
      379                                                                      ) ).
      380           run temp-string_write in this-procedure (input  substitute("&1DO WHILE &2 :   "
      381                                                                       ,fill( chr(32), p-level * 2)
      382                                                                       ,replace(buf_rule-script.script, (chr(38) + chr(38)), chr(38))
      383                                                                       )).
      384           .
      385           assign
      386           v-exist-rule-script = yes
      387           .
      388         end.
      389         if buf_rule-script.script-type = 'CONS':U
      390         or buf_rule-script.script-type = 'GOTO':U
      391         then do:
      392           run temp-string_write in this-procedure ( input  substitute("&1/* Salience &2 rule_id &3*/"
      393                                                                        ,fill(chr(32), 70)
      394                                                                        ,buf_rule-script.salience
      395                                                                        ,buf_rule-script.rule_id
      396                                                                        )).
      397           find first buf_rule-i-script no-lock where
      398                     buf_rule-i-script.root_rule_id = buf_rule.root_rule_id
      399                and  buf_rule-i-script.script_id = buf_rule-script.script_id
      400                and  buf_rule-i-script.i-script-type = 'variable':U no-error.
      401           if available buf_rule-i-script then do:
      402             run temp-string_write in this-procedure ( input  substitute("/*&1&2 .*/"
      403                                                                         ,fill( chr(32), p-level * 2)
      404                                                                         ,replace(buf_rule-script.script, (chr(38) + chr(38)), chr(38))
      405                                                                         )).
      406           end.
      407           else do:
      408             run temp-string_write in this-procedure ( input  substitute("&1&2 ."
      409                                                                   ,fill( chr(32), p-level * 2)
      410                                                                   ,replace(buf_rule-script.script, (chr(38) + chr(38)), chr(38))
      411                                                                   )).
      412           end.
      413         end.
      414         if buf_rule-script.script-type = 'RULE':U
      415         or buf_rule-script.script-type = 'ELSE-RULE':U
      416         then do:
      417           find first buf_rule no-lock where
      418                   buf_rule.upper_rule_id = p-rule-id
      419               and buf_rule.salience = buf_rule-script.salience no-error .
      420           if not available buf_rule then do:
      421             message
      422             substitute("Не найдено правило &1 вышестояшего уровня к скрипту типа &2:&3№ скрипта &4, порядок &5"
      423                        , p-rule-id
      424                        , buf_rule-script.script-type
      425                        , chr(10)
      426                        , buf_rule-script.script_id
      427                        , buf_rule-script.salience )
      428             view-as alert-box error .
      429             return.
      430           end.
      431           if buf_rule-script.script-type = 'ELSE-RULE':U then do:
      432             run temp-string_write in this-procedure ( input substitute("&1else do: /*rule &2*/"
      433                                                                         ,fill( chr(32), p-level * 2)
      434                                                                         ,buf_rule.rule_id)).
      435             assign
      436             v-exist-rule-script = yes
      437             .
      438           end.
      439           p-level = p-level + 1.
      440           run display-rule ( input buf_rule.rule_id, input buf_rule.upper_rule_id, input p-language, input-output p-level).
      441           p-level = p-level - 1.
      442           if v-exist-rule-script then do:
      443             run temp-string_write in this-procedure ( input substitute("&1end. /*of rule &2*/"
      444                                                                         ,fill( chr(32), p-level * 2)
      445                                                                         ,buf_rule.rule_id)).
      446             v-exist-rule-script = no.
      447           end.
      448         end.
      449       END.
      450       if v-exist-rule-script then do:
      451         run temp-string_write in this-procedure ( input substitute("&1end.&2end. /*of rule &3*/"
      452                                                                     ,fill( chr(32), p-level * 2)
      453                                                                     ,chr(10)
      454                                                                     ,p-rule-id)).
      455       end.
      456       else do:
      457         run temp-string_write in this-procedure ( input substitute("&1&2end. /*of rule &3*/"
      458                                                                     ,chr(10)
      459                                                                     ,fill( chr(32), p-level * 2)
      460                                                                     ,p-rule-id)).
      461       end.
      462     END.
      463     WHEN "rus"
      464     or
      465     when "rus-ext"
      466     THEN DO:
      467       find first buf_rule no-lock where
      468                 buf_rule.rule_id = p-rule-id.
      469       if p-upper-rule-id = 0 then do:
      470         run temp-string_write in this-procedure ( input buf_rule.name ).
      471         run temp-string_write in this-procedure ( input buf_rule.documentation ).
      472         run temp-string_write in this-procedure ( input '':U).
      473         if buf_rule.hidden-content > 0 then do:
      474           run temp-string_write in this-procedure ( input "НЕЛЬЗЯ ПРОСМОТРЕТЬ СОДЕРЖИМОЕ ПРАВИЛА").
      475           return.
      476         end.
      477       end.
      478       else do:
      479         if p-language = "rus-ext" then do:
      480           run temp-string_write in this-procedure ( input substitute("&1/* порядок &2 правила &3 */"
      481                                                                     ,fill(chr(32), 70)
      482                                                                     ,buf_rule.salience
      483                                                                     ,buf_rule.upper_rule_id
      484                                                                     )).
      485         end.
      486       end.
      487       run temp-string_write in this-procedure ( input substitute("_Правило &1:",  p-RULE-id)).
      488       FOR EACH buf_rule-script NO-LOCK WHERE
      489               buf_rule-script.RULE_id = p-rULE-id
      490           AND buf_rule-script.LANGUAGE = "rus":
      491        if buf_rule-script.script-type = 'COND':U then do:
      492           if p-language = "rus-ext" then do:
      493             run temp-string_write in this-procedure ( input  substitute("&1/* порядок &2 правила &3*/"
      494                                                                         ,fill(chr(32), 70)
      495                                                                         ,buf_rule-script.salience
      496                                                                         ,buf_rule-script.rule_id
      497                                                                         )).
      498           end.
      499           run temp-string_write in this-procedure ( input  substitute("&1Если &2 тогда: "
      500                                                                         ,fill( chr(32), p-level * 2)
      501                                                                         ,buf_rule-script.script )).
      502           assign
      503           v-exist-rule-script = yes
      504           .
      505         end.
      506        if buf_rule-script.script-type = 'CYCLE-COND':U then do:
      507           if p-language = "rus-ext" then do:
      508             run temp-string_write in this-procedure ( input  substitute("&1/* порядок &2 правила &3*/"
      509                                                                         ,fill(chr(32), 70)
      510                                                                         ,buf_rule-script.salience
      511                                                                         ,buf_rule-script.rule_id
      512                                                                         )).
      513           end.
      514           run temp-string_write in this-procedure ( input  substitute("&1ПОКА &2: "
      515                                                                         ,fill( chr(32), p-level * 2)
      516                                                                         ,buf_rule-script.script )).
      517           assign
      518           v-exist-rule-script = yes
      519           .
      520         end.
      521         if buf_rule-script.script-type = 'RULE':U
      522         or buf_rule-script.script-type = 'ELSE-RULE':U
      523         then do:
      524           find first buf_rule no-lock where
      525                   buf_rule.upper_rule_id = p-rule-id
      526               and buf_rule.salience = buf_rule-script.salience no-error .
      527           if not available buf_rule then do:
      528             message
      529             substitute("Не найдено правило &1 вышестояшего уровня к скрипту типа &2:&3№ скрипта &4, порядок &5"
      530                        , p-rule-id
      531                        , buf_rule-script.script-type
      532                        , chr(10)
      533                        , buf_rule-script.script_id
      534                        , buf_rule-script.salience )
      535             view-as alert-box error .
      536             return.
      537           end.
      538           if buf_rule-script.script-type = 'ELSE-RULE':U then do:
      539             run temp-string_write in this-procedure ( input substitute("&1ИНАЧЕ: /*правило &2*/"
      540                                                                         ,fill( chr(32), p-level * 2)
      541                                                                         ,buf_rule.rule_id)).
      542             assign
      543             v-exist-rule-script = yes
      544             .
      545           end.
      546           p-level = p-level + 1.
      547           run display-rule ( input buf_rule.rule_id, input buf_rule.upper_rule_id, input p-language, input-output p-level).
      548           p-level = p-level - 1.
      549         end.
      550         if buf_rule-script.script-type = 'CONS':U
      551         or buf_rule-script.script-type = 'GOTO':U
      552         then do:
      553           if p-language = "rus-ext" then do:
      554             run temp-string_write in this-procedure ( input substitute("&1/* порядок &2 правила &3*/"
      555                                                                         ,fill(chr(32), 70)
      556                                                                         ,buf_rule-script.salience
      557                                                                         ,buf_rule-script.rule_id
      558                                                                         )).
      559           end.
      560           run temp-string_write in this-procedure ( input substitute("&1&2 ;"
      561                                                                       ,fill( chr(32), p-level * 2)
      562                                                                       ,buf_rule-script.script )).
      563         end.
      564       END.
      565       if v-exist-rule-script then do:
      566         run temp-string_write in this-procedure ( input substitute("&1. /* конец правила &2 */"
      567                                                                       ,fill( chr(32), p-level * 2)
      568                                                                       ,p-rule-id) ).
      569       end.
      570       else do:
      571         run temp-string_write in this-procedure ( input substitute("&1. /* конец правила &2 */"
      572                                                                       ,fill( chr(32), p-level * 2)
      573                                                                       ,p-rule-id) ).
      574       end.
      575     END.
      576     when "DOT2-rus":U
      577     or
      578     when "DOT2-ABL":U then do:
      579       v-language = entry(2, p-language, "-").
      580       find first buf_rule no-lock where
      581                 buf_rule.rule_id = p-rule-id.
      582       if p-upper-rule-id = 0 then do:
      583         run temp-string_write in this-procedure ( input  substitute('Rule&1_&2_&3 [shape=ellipse , fillcolor=pink, style="rounded,filled",  label="Правило&4\n&1_&2_&3"];'
      584                                                                   , buf_rule.rule_id
      585                                                                   , buf_rule.upper_rule_id
      586                                                                   , buf_rule.salience
      587                                                                   , (if buf_rule.hidden-content > 0 then " (содержимое скрыто) " else "")
      588                                                                   )
      589                                                                   ).
      590         if buf_rule.hidden-content > 0 then do:
      591           return.
      592         end.
      593       end.
      594       else do:
      595       end.
      596       FOR EACH buf_rule-script NO-LOCK WHERE
      597               buf_rule-script.RULE_id = p-rULE-id
      598           AND buf_rule-script.LANGUAGE = v-language:
      599         if buf_rule-script.script-type = 'COND':U then do:
      600           run temp-string_write in this-procedure ( input   substitute('Condition&1_&2 [shape=diamond, fillcolor=yellow, style="rounded,filled", label="&3?"];'
      601                                                                       , buf_rule-script.rule_id
      602                                                                       , buf_rule-script.salience
      603                                                                       , replace(replace(replace(buf_rule-script.script, chr(34), "&#34;":U), "~~n", "\n"), chr(10), "\n")
      604                                                                       )).
      605         end.
      606         if buf_rule-script.script-type = 'CYCLE-COND':U then do:
      607           run temp-string_write in this-procedure ( input   substitute('Cyclecondition&1_&2 [shape=trapezium, fillcolor=yellowgreen, style="rounded,filled", label="&3?"];'
      608                                                                       , buf_rule-script.rule_id
      609                                                                       , buf_rule-script.salience
      610                                                                       , replace(replace(replace(buf_rule-script.script, chr(34), "&#34;":U), "~~n", "\n"), chr(10), "\n")
      611                                                                       )).
      612         end.
      613         if buf_rule-script.script-type = 'CONS':U then do:
      614           run temp-string_write in this-procedure ( input   substitute('Consequence&1_&2 [shape=box, fillcolor=lightgrey, style="rounded,filled", label="&3"];'
      615                                                                       , buf_rule-script.rule_id
      616                                                                       , buf_rule-script.salience
      617                                                                       , replace(replace(replace(buf_rule-script.script, chr(34), "&#34;":U), "~~n", "\n"), chr(10), "\n")
      618                                                                       )).
      619         end.
      620         if buf_rule-script.script-type = 'GOTO':U then do:
      621           run temp-string_write in this-procedure ( input   substitute('Goto&1_&2 [shape=invtriangle, fillcolor=pink, style="rounded,filled", label="&3"];'
      622                                                                       , buf_rule-script.rule_id
      623                                                                       , buf_rule-script.salience
      624                                                                       , replace(replace(replace(buf_rule-script.script, chr(34), "&#34;":U), "~~n", "\n"), chr(10), "\n")
      625                                                                       )).
      626         end.
      627         if buf_rule-script.script-type = 'RULE':U
      628         or buf_rule-script.script-type = 'ELSE-RULE':U
      629         then do:
      630           find first buf_down-rule no-lock where
      631                     buf_down-rule.upper_rule_id = p-rule-id
      632                 and buf_down-rule.salience = buf_rule-script.salience.
      633           p-level = p-level + 1.
      634           run display-rule ( input buf_down-rule.rule_id
      635                            , input buf_down-rule.upper_rule_id
      636                            , input p-language
      637                            , input-output p-level).
      638           p-level = p-level - 1.
      639         end.
      640       end.
      641       if p-upper-rule-id = 0 then do:
      642         run temp-string_write in this-procedure ( input substitute('End_Rule&1 [shape=ellipse , fillcolor=pink, style="rounded,filled", label="Конец\nправила &1"];'
      643                                                                     , p-rule-id)).
      644       end.
      645       if p-upper-rule-id = 0 then do:
      646         run temp-string_write in this-procedure ( input substitute("~}")).
      647       end.
      648      end.
      649       when "DOT1-rus"
      650       or
      651       when "DOT1-ABL"
      652       then do:
      653           DEFINE VARIABLE v-level AS INTEGER NO-UNDO.
      654           define variable v-start-script-id as integer no-undo .
      655           define variable v-end-script-id as integer no-undo .
      656           define variable v-script-type as character no-undo .
      657           define buffer buf2_tt-rule for tt-rule.
      658           v-language = entry(2, p-language, "-").
      659           find first buf_rule no-lock where
      660                     buf_rule.rule_id = p-rule-id.
      661           if p-upper-rule-id = 0 then do:
      662             RUN fill-tables IN THIS-PROCEDURE (  INPUT buf_rule.RULE_id
      663                                             ,INPUT buf_rule.root_RULE_id
      664                                             ,INPUT-OUTPUT v-level
      665                                             ,INPUT "") no-error.
      666             run temp-string_write in this-procedure ( input substitute("digraph rule&1 ~{", p-rule-id)).
      667             run temp-string_write in this-procedure ( input substitute('node [fontsize=12];')).
      668             run temp-string_write in this-procedure ( input substitute('nodesep=0.30;')).
      669             run temp-string_write in this-procedure ( input substitute('ranksep=0.30;')).
      670             if buf_rule.hidden-content > 0 then do:
      671               return.
      672             end.
      673             _tt-rule:
      674             for each buf_tt-rule no-lock where
      675                     buf_tt-rule.root_rule_id = buf_rule.root_rule_id:
      676               if buf_tt-rule.rule_id = buf_tt-rule.root_rule_id then do:
      677                 find first buf_tt-rule-script where
      678                           buf_tt-rule.rule_id = buf_tt-rule.rule_id.
      679                 assign
      680                 v-start-script-id = buf_tt-rule-script.script_id
      681                 v-end-script-id = -1
      682                 .
      683               end.
      684               else do:
      685                 find first buf_tt-rule-script no-lock where
      686                         buf_tt-rule-script.rule_id = buf_tt-rule.upper_rule_id
      687                     and buf_tt-rule-script.salience = buf_tt-rule.salience.
      688                 assign
      689                 v-salience = buf_tt-rule-script.salience
      690                 v-script-type = buf_tt-rule-script.script-type
      691                 .
      692                 find last buf_tt-rule-script no-lock where
      693                         buf_tt-rule-script.rule_id = buf_tt-rule.upper_rule_id
      694                     and buf_tt-rule-script.salience < buf_tt-rule.salience
      695                     and buf_tt-rule-script.script-type <> 'RULE':U
      696                     and buf_tt-rule-script.script-type <> 'ELSE-RULE':U
      697                     .
      698                 assign
      699                 v-start-script-id = buf_tt-rule-script.script_id.
      700                 find first buf2_tt-rule where
      701                           buf2_tt-rule.rule_id = buf_tt-rule.rule_id.
      702                 assign
      703                 v-salience = buf_tt-rule.salience
      704                 v-rule-id = buf_tt-rule.upper_rule_id
      705                 .
      706                 _TTT:
      707                 do while true:
      708                   find first buf_tt-rule-script no-lock where
      709                           buf_tt-rule-script.rule_id = v-rule-id
      710                       and buf_tt-rule-script.salience > v-salience
      711                       and buf_tt-rule-script.script-type <>  'RULE':U
      712                       and buf_tt-rule-script.script-type <>  'ELSE-RULE':U
      713                       no-error
      714                       .
      715                   if not available buf_tt-rule-script then do:
      716                     if buf2_tt-rule.upper_rule_id = 0 then do:
      717                       v-end-script-id = -1.
      718                       leave _ttt.
      719                     end.
      720                     else do:
      721                       find first buf2_tt-rule where
      722                                 buf2_tt-rule.rule_id = v-rule-id.
      723                       assign
      724                       v-salience = buf2_tt-rule.salience
      725                       v-rule-id = buf2_tt-rule.upper_rule_id
      726                       .
      727                     end.
      728                   end.
      729                   else do:
      730                     assign
      731                     v-end-script-id = buf_tt-rule-script.script_id.
      732                     leave _ttt.
      733                   end.
      734                 end.
      735                 for each buf_tt-rule-script where
      736                         buf_tt-rule-script.rule_id = buf_tt-rule.rule_id:
      737                   assign
      738                   buf_tt-rule-script.start-script_id = v-start-script-id
      739                   buf_tt-rule-script.end-script_id = v-end-script-id
      740                   buf_tt-rule-script.edge-type = (if v-script-type = 'RULE':U
      741                                                   then "yes"
      742                                                   else "no")
      743                   .
      744                 end.
      745               end.
      746             end.
      747           end.
      748           if p-upper-rule-id = 0 then do:
      749             assign
      750             v-prev-node =  substitute("Rule&1_&2_&3"
      751                                     , buf_rule.rule_id
      752                                     , buf_rule.upper_rule_id
      753                                     , buf_rule.salience
      754                                     ).
      755             for each buf_tt-rule-script by
      756                   buf_tt-rule-script.gen-order:
      757               create buf_temp-edge.
      758               assign
      759               buf_temp-edge.from-script_id = 0
      760               buf_temp-edge.to-script_id = buf_tt-rule-script.script_id
      761               buf_temp-edge.edge-type = "":U
      762               .
      763               release buf_temp-edge.
      764               leave.
      765             end.
      766           end.
      767           FOR EACH buf_rule-script NO-LOCK WHERE
      768                   buf_rule-script.RULE_id = p-rULE-id
      769               AND buf_rule-script.LANGUAGE = v-language:
      770             if buf_rule-script.script-type = 'RULE':U
      771             or buf_rule-script.script-type = 'ELSE-RULE':U
      772             then do:
      773               find first buf_down-rule no-lock where
      774                         buf_down-rule.upper_rule_id = p-rule-id
      775                     and buf_down-rule.salience = buf_rule-script.salience no-error .
      776               if error-status :error then do:
      777               end.
      778               p-level = p-level + 1.
      779               run display-rule ( input buf_down-rule.rule_id, input buf_down-rule.upper_rule_id, input p-language, input-output p-level).
      780               p-level = p-level - 1.
      781             end.
      782             run create-temp-edge in this-procedure ( buffer buf_rule-script
      783                                                     ,input v-language
      784                                                     ,output v-current-node
      785                                                     ).
      786             _temp-edge:
      787             for each buf_temp-edge where
      788                     buf_temp-edge.from-script_id = buf_rule-script.script_id:
      789               if buf_temp-edge.to-script_id = -1 then do:
      790                 assign
      791                 v-next-node =  substitute("End_Rule&1"
      792                                   , buf_rule-script.root_rule_id
      793                                   ).
      794               end.
      795               else do:
      796                 find first buf_tt-rule-script where buf_tt-rule-script.script_id = buf_temp-edge.to-script_id no-error .
      797                 if not available buf_tt-rule-script then do:
      798                   next _temp-edge.
      799                 end.
      800                 case buf_tt-rule-script.script-type:
      801                   when 'CONS':U then do:
      802                     assign
      803                     v-next-node  = substitute("Consequence&1_&2"
      804                                         , buf_tt-rule-script.rule_id
      805                                         , buf_tt-rule-script.salience).
      806                   end.
      807                   when 'GOTO':U then do:
      808                     assign
      809                     v-next-node  = substitute("Goto&1_&2"
      810                                         , buf_tt-rule-script.rule_id
      811                                         , buf_tt-rule-script.salience).
      812                   end.
      813                   when 'COND':U then do:
      814                     assign
      815                     v-next-node  = substitute("Condition&1_&2"
      816                                         , buf_tt-rule-script.rule_id
      817                                         , buf_tt-rule-script.salience).
      818                   end.
      819                   when 'CYCLE-COND':U then do:
      820                     assign
      821                     v-next-node  = substitute("Cyclecondition&1_&2"
      822                                         , buf_tt-rule-script.rule_id
      823                                         , buf_tt-rule-script.salience).
      824                   end.
      825                   when 'ELSE-RULE':U then do:
      826                     next _temp-edge.
      827                   end.
      828                 end case.
      829               end.
      830               if can-find(first temp-edge where
      831                               temp-edge.from-script_id = 0
      832                           and temp-edge.to-script_id = buf_rule-script.script_id) then do:
      833                 run temp-string_write in this-procedure ( input substitute("&1 -> &2"
      834                                                                             ,v-prev-node
      835                                                                             ,v-current-node
      836                                                                             )).
      837               end.
      838               run temp-string_write in this-procedure ( input substitute("&1 -> &2&3"
      839                                                                           ,v-current-node
      840                                                                           ,v-next-node
      841                                                       ,(if buf_temp-edge.edge-type = ""
      842                                                         then "":U
      843                                                         else substitute('[taillabel="&1"]'
      844                                                                         , buf_temp-edge.edge-type)
      845                                                         )
      846                                                                           )).
      847             end.
      848           end.
      849         end.
      850   END CASE.
      851   END procedure.
      852   procedure create-temp-edge :
      853   define parameter buffer buf_rule-script for ub.rule-script.
      854   define input parameter p-language as character no-undo .
      855   define output parameter p-current-node as character no-undo .
      856   define variable v-salience as integer no-undo .
      857   define variable v-rule-id as integer no-undo .
      858   define variable v-gen-order as character no-undo .
      859   define variable v-goto-text as character no-undo .
      860   define variable v-goto-rule as character no-undo .
      861   define variable v-ii as integer no-undo .
      862   define variable v-script-id as integer no-undo .
      863   define variable v-script-type as character no-undo .
      864   define variable v-int as integer no-undo .
      865   define buffer buf_tt-rule-script for tt-rule-script.
      866   define buffer buf_tt-rule for tt-rule.
      867   define buffer buf_temp-edge for temp-edge.
      868   define buffer buf2_rule for ub.rule.
      869   do
      870   on error undo, return error
      871   :
      872     case buf_rule-script.script-type:
      873       when 'COND':U then do:
      874         assign
      875         p-current-node  = substitute("Condition&1_&2"
      876                           , buf_rule-script.rule_id
      877                           , buf_rule-script.salience).
      878        for each buf_tt-rule-script where
      879                 buf_tt-rule-script.start-script_id = buf_rule-script.script_id
      880             and buf_tt-rule-script.edge-type = "yes"
      881         by buf_tt-rule-script.gen-order:
      882           create buf_temp-edge.
      883           assign
      884           buf_temp-edge.from-script_id = buf_rule-script.script_id
      885           buf_temp-edge.to-script_id = buf_tt-rule-script.script_id
      886           buf_temp-edge.edge-type = buf_tt-rule-script.edge-type
      887           .
      888           leave.
      889        end.
      890        for each buf_tt-rule-script where
      891                 buf_tt-rule-script.start-script_id = buf_rule-script.script_id
      892             and buf_tt-rule-script.edge-type = "no"
      893         by buf_tt-rule-script.gen-order:
      894           create buf_temp-edge.
      895           assign
      896           buf_temp-edge.from-script_id = buf_rule-script.script_id
      897           buf_temp-edge.to-script_id = buf_tt-rule-script.script_id
      898           buf_temp-edge.edge-type = buf_tt-rule-script.edge-type
      899           .
      900           leave.
      901        end.
      902        if not available buf_tt-rule-script then do:
      903         assign
      904         v-rule-id = buf_rule-script.rule_id
      905         v-salience = buf_rule-script.salience
      906         .
      907         find first buf_tt-rule-script where
      908                   buf_tt-rule-script.rule_id = v-rule-id
      909               and buf_tt-rule-script.salience > v-salience
      910               and buf_tt-rule-script.script-type <> 'RULE':U
      911               and buf_tt-rule-script.script-type <> 'ELSE-RULE':U
      912               no-error.
      913         if not available buf_tt-rule-script then do:
      914           if buf_rule-script.rule_id = buf_rule-script.root_rule_id then do:
      915             create buf_temp-edge.
      916             assign
      917             buf_temp-edge.from-script_id = buf_rule-script.script_id
      918             buf_temp-edge.to-script_id = -1
      919             buf_temp-edge.edge-type = "no"
      920             .
      921           end.
      922           else do:
      923             find first buf_tt-rule-script where
      924                       buf_tt-rule-script.script_id = buf_rule-script.script_id.
      925             create buf_temp-edge.
      926             assign
      927             buf_temp-edge.from-script_id = buf_rule-script.script_id
      928             buf_temp-edge.to-script_id = buf_tt-rule-script.end-script_id
      929             buf_temp-edge.edge-type = "no"
      930             .
      931           end.
      932         end.
      933         else do:
      934           create buf_temp-edge.
      935           assign
      936           buf_temp-edge.from-script_id = buf_rule-script.script_id
      937           buf_temp-edge.to-script_id = buf_tt-rule-script.script_id
      938           buf_temp-edge.edge-type = "no"
      939           .
      940         end.
      941        end.
      942       end.
      943       when 'CYCLE-COND':U then do:
      944         assign
      945         p-current-node  = substitute("Cyclecondition&1_&2"
      946                           , buf_rule-script.rule_id
      947                           , buf_rule-script.salience).
      948        for each buf_tt-rule-script where
      949                 buf_tt-rule-script.start-script_id = buf_rule-script.script_id
      950             and buf_tt-rule-script.edge-type = "yes"
      951         by buf_tt-rule-script.gen-order:
      952           v-ii = v-ii + 1.
      953           if v-ii = 1 then do:
      954             create buf_temp-edge.
      955             assign
      956             buf_temp-edge.from-script_id = buf_rule-script.script_id
      957             buf_temp-edge.to-script_id = buf_tt-rule-script.script_id
      958             buf_temp-edge.edge-type = buf_tt-rule-script.edge-type
      959             .
      960           end.
      961           assign
      962           v-script-id = buf_tt-rule-script.script_id
      963           v-script-type = buf_tt-rule-script.script-type
      964           v-rule-id = buf_tt-rule-script.rule_id
      965           v-salience = buf_tt-rule-script.salience
      966           .
      967         end.
      968         _cont:
      969         do while true:
      970           if v-script-type <> 'RULE':U
      971           and v-script-type <> 'ELSE-RULE':U then do:
      972             create buf_temp-edge.
      973             assign
      974             buf_temp-edge.to-script_id = buf_rule-script.script_id
      975             buf_temp-edge.from-script_id = v-script-id
      976             buf_temp-edge.edge-type = "continue"
      977             .
      978             leave _cont.
      979           end.
      980           find first buf_tt-rule where
      981                     buf_tt-rule.upper_rule_id = v-rule-id
      982                 and buf_tt-rule.salience = v-salience.
      983           for each buf_tt-rule-script where
      984                   buf_tt-rule-script.rule_id = buf_tt-rule.rule_id
      985           by buf_tt-rule-script.gen-order:
      986             assign
      987             v-script-id = buf_tt-rule-script.script_id
      988             v-script-type = buf_tt-rule-script.script-type
      989             v-rule-id = buf_tt-rule-script.rule_id
      990             v-salience = buf_tt-rule-script.salience
      991             .
      992           end.
      993         end.
      994       end.
      995       when 'CONS':U
      996       then do:
      997         assign
      998         p-current-node  = substitute("Consequence&1_&2"
      999                             , buf_rule-script.rule_id
     1000                             , buf_rule-script.salience).
     1001         assign
     1002         v-rule-id = buf_rule-script.rule_id
     1003         v-salience = buf_rule-script.salience
     1004         .
     1005         find first buf_tt-rule-script where
     1006                   buf_tt-rule-script.rule_id = v-rule-id
     1007               and buf_tt-rule-script.salience > v-salience no-error.
     1008         if not available buf_tt-rule-script then do:
     1009           if buf_rule-script.rule_id = buf_rule-script.root_rule_id then do:
     1010             create buf_temp-edge.
     1011             assign
     1012             buf_temp-edge.from-script_id = buf_rule-script.script_id
     1013             buf_temp-edge.to-script_id = -1
     1014             buf_temp-edge.edge-type = ""
     1015             .
     1016           end.
     1017           else do:
     1018             find first buf_tt-rule-script where
     1019                       buf_tt-rule-script.script_id = buf_rule-script.script_id.
     1020             create buf_temp-edge.
     1021             assign
     1022             buf_temp-edge.from-script_id = buf_rule-script.script_id
     1023             buf_temp-edge.to-script_id = buf_tt-rule-script.end-script_id
     1024             buf_temp-edge.edge-type = ""
     1025             .
     1026           end.
     1027         end.
     1028         else do:
     1029           create buf_temp-edge.
     1030           assign
     1031           buf_temp-edge.from-script_id = buf_rule-script.script_id
     1032           buf_temp-edge.to-script_id = buf_tt-rule-script.script_id
     1033           buf_temp-edge.edge-type = ""
     1034           .
     1035         end.
     1036       end.
     1037       when 'GOTO':U then do:
     1038         assign
     1039         p-current-node  = substitute("Goto&1_&2"
     1040                             , buf_rule-script.rule_id
     1041                             , buf_rule-script.salience).
     1042         find first buf_tt-rule-script where
     1043                 buf_tt-rule-script.rule_id = buf_rule-script.rule_id
     1044             and buf_tt-rule-script.language = "ABL"
     1045             and buf_tt-rule-script.salience = buf_rule-script.salience.
     1046         v-goto-text = trim(buf_tt-rule-script.script, chr(32)).
     1047         if v-goto-text begins "leave":U then do:
     1048           v-goto-rule = trim(trim(replace(v-goto-text, "leave":U, "":U), chr(32)), "_":U).
     1049           if v-goto-rule = string(buf_rule-script.root_rule_id) then do:
     1050             create buf_temp-edge.
     1051             assign
     1052             buf_temp-edge.from-script_id = buf_rule-script.script_id
     1053             buf_temp-edge.to-script_id =  -1
     1054             buf_temp-edge.edge-type = ""
     1055             .
     1056           end.
     1057           else do:
     1058             assign
     1059             v-int = integer(v-goto-rule) no-error.
     1060             if not error-status:error then do:
     1061               find first buf_tt-rule-script where
     1062                           buf_tt-rule-script.upper_rule_id = v-int .
     1063               create buf_temp-edge.
     1064               assign
     1065               buf_temp-edge.from-script_id = buf_rule-script.script_id
     1066               buf_temp-edge.to-script_id = buf_tt-rule-script.end-script_id
     1067               buf_temp-edge.edge-type = "leave"
     1068               .
     1069             end.
     1070           end.
     1071         end.
     1072         if v-goto-text begins "next":U then do:
     1073           v-goto-rule = trim(replace(v-goto-text, "next":U, "":U), chr(32)).
     1074           if v-goto-rule = substitute("_&1", buf_rule-script.root_rule_id) then do:
     1075             find first buf_tt-rule-script where
     1076                       buf_tt-rule-script.rule_id = buf_rule-script.root_rule_id.
     1077             create buf_temp-edge.
     1078             assign
     1079             buf_temp-edge.from-script_id = buf_rule-script.script_id
     1080             buf_temp-edge.to-script_id = buf_tt-rule-script.script_id
     1081             buf_temp-edge.edge-type = ""
     1082             .
     1083           end.
     1084           else do:
     1085             assign
     1086             v-int = integer(trim(v-goto-rule, "_")) no-error.
     1087             if not error-status:error then do:
     1088               find first buf_tt-rule-script where
     1089                           buf_tt-rule-script.upper_rule_id = v-int .
     1090               create buf_temp-edge.
     1091               assign
     1092               buf_temp-edge.from-script_id = buf_rule-script.script_id
     1093               buf_temp-edge.to-script_id = buf_tt-rule-script.end-script_id
     1094               buf_temp-edge.edge-type = "next"
     1095               .
     1096             end.
     1097             else do:
     1098               create buf_temp-edge.
     1099               assign
     1100               buf_temp-edge.from-script_id = buf_rule-script.script_id
     1101               buf_temp-edge.to-script_id = -1
     1102               buf_temp-edge.edge-type = "next"
     1103               .
     1104             end.
     1105           end.
     1106         end.
     1107       end.
     1108     end case.
     1109   end.
     1110   end procedure.
     1111   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1112   procedure display-prop-script :
     1113   define parameter buffer buf_prop-script for ub.prop-script.
     1114     do
     1115     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1116     :
     1117       if buf_prop-script.script-type = 'ifunction':U then do:
     1118         run temp-string_write in this-procedure ( input buf_prop-script.script-body ).
     1119       end.
     1120       else do:
     1121         if lookup(buf_prop-script.proc-type, 'class,data-member,property,method,constructor,destructor':u) > 0 then do:
     1122         end.
     1123         else do:
     1124           run temp-string_write in this-procedure ( input buf_prop-script.script-head ).
     1125           run temp-string_write in this-procedure ( input buf_prop-script.script-body ).
     1126           run temp-string_write in this-procedure ( input buf_prop-script.script-foot ).
     1127         end.
     1128       end.
     1129     end.
     1130   end procedure.
     1131   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1132   procedure display-rule-call-params :
     1133   define input parameter p-mode as character no-undo .
     1134   define input parameter p-codex-id as integer no-undo .
     1135   define input parameter p-ruleset-id as integer no-undo .
     1136   define input parameter p-call-id as character no-undo .
     1137   define input parameter p-once-more as integer no-undo .
     1138   define input parameter p-order-id as integer no-undo .
     1139   define input parameter p-handle as handle no-undo .
     1140   define buffer buf_rule-call-param for ub.rule-call-param.
     1141   define variable v-string as character no-undo .
     1142   do
     1143   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1144   :
     1145     run temp-string_write in p-handle ( input "ПАРАМЕТРЫ").
     1146     if p-mode = "text"
     1147     or p-mode = "text-temp"
     1148     then do:
     1149       run temp-string_write in p-handle ( input "").
     1150     end.
     1151     _rr:
     1152     for each buf_rule-call-param no-lock where
     1153             buf_rule-call-param.codex_id = p-codex-id
     1154         and buf_rule-call-param.ruleset_id = p-ruleset-id
     1155         and buf_rule-call-param.call_id = p-call-id
     1156         and buf_rule-call-param.order_id = p-order-id:
     1157       if p-once-more >= 0 and
     1158       buf_rule-call-param.once-more <> p-once-more then next.
     1159       v-string = '':U.
     1160       if lookup("LIST", buf_rule-call-param.param-3-data-type) > 0 then do:
     1161         if buf_rule-call-param.p-index = 0 then do:
     1162           assign
     1163           v-string = buf_rule-call-param.param-label +  chr(32)  + "=".
     1164           run temp-string_write in p-handle ( input v-string).
     1165           next _rr.
     1166         end.
     1167         else do:
     1168           assign
     1169           v-string = fill( chr(32), length(buf_rule-call-param.param-label) + 2).
     1170         end.
     1171       end.
     1172       else do:
     1173         assign
     1174         v-string = buf_rule-call-param.param-label +  chr(32)  + "=".
     1175       end.
     1176       CASE buf_rule-call-param.param-data-type:
     1177         when 'character':U then do:
     1178           v-string = v-string + buf_rule-call-param.param-value-character.
     1179         end.
     1180         when 'date':U then do:
     1181           v-string = v-string + string(buf_rule-call-param.param-value-date, "99/99/9999").
     1182         end.
     1183         when 'logical':U then do:
     1184           v-string = v-string + string(buf_rule-call-param.param-value-logical, "ДА/НЕТ").
     1185         end.
     1186         when 'decimal':U then do:
     1187           v-string = v-string + string(buf_rule-call-param.param-value-decimal).
     1188         end.
     1189         when 'integer':U then do:
     1190           v-string = v-string + string(buf_rule-call-param.param-value-integer).
     1191         end.
     1192       END CASE.
     1193       run temp-string_write in p-handle ( input v-string).
     1194     end.
     1195     if p-mode = "text"
     1196     or p-mode = "text-temp"
     1197     then do:
     1198       run temp-string_write in p-handle ( input "").
     1199     end.
     1200   end.
     1201   end procedure.
     1202   def var vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1203   procedure gen-key-rec :
     1204     define input  parameter p-tbl-name    as character no-undo.
     1205     define input  parameter p-bh_tbl-name as handle    no-undo.
     1206     define output parameter p-key-rec     as character no-undo.
     1207     do
     1208     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1209     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     1210     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     1211     :
     1212       define variable fh               as handle    no-undo .
     1213       define variable v-ok             as logical   no-undo .
     1214       define variable v-inform         as character no-undo .
     1215       define variable v-ind            as integer   no-undo .
     1216       define variable v-idx-field-qnty as integer   no-undo .
     1217       if p-tbl-name = ?
     1218         or p-tbl-name = "":U
     1219       then do:
     1220         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info5 ).
     1221       end.
     1222       if not p-bh_tbl-name:available then do:
     1223         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info5, p-tbl-name ).
     1224       end.
     1225       assign
     1226         p-key-rec = p-tbl-name
     1227         v-inform  = p-bh_tbl-name:index-information(1)
     1228         v-ind     = 2
     1229       .
     1230       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1231       on error undo, return error
     1232       :
     1233         assign
     1234           v-inform = p-bh_tbl-name:index-information( v-ind )
     1235           v-ind    = v-ind + 1
     1236         .
     1237       end.
     1238       if v-inform = ?
     1239         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1240         or entry( 3, v-inform, ",":U ) <> "1":U
     1241       then do:
     1242         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, p-tbl-name ).
     1243       end.
     1244       else do:
     1245         assign
     1246           v-idx-field-qnty = num-entries( v-inform ) - 4
     1247         .
     1248         if v-idx-field-qnty < 2 then do:
     1249           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, p-tbl-name ).
     1250         end.
     1251         do v-ind = 1 to v-idx-field-qnty by 2
     1252         on error undo, return error
     1253         :
     1254           assign
     1255             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     1256             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     1257           .
     1258         end.
     1259       end.
     1260       if p-key-rec = ? then do:
     1261         assign
     1262           p-key-rec = "":U
     1263         .
     1264         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info5, p-tbl-name ).
     1265       end.
     1266     end.
     1267     return.
     1268   end procedure.
     1269   procedure gen-where-keyr-tab :
     1270     define input  parameter i-tableSerach as character no-undo.
     1271     define input  parameter i-tablekey   as character  no-undo.
     1272     define input  parameter p-key-rec    as character  no-undo.
     1273     define input  parameter p-key-handle as handle     no-undo .
     1274     define input  parameter p-db-name    as character  no-undo .
     1275     define input  parameter p-tt-handle  as handle     no-undo .
     1276     define output parameter o-Where      as character  no-undo.
     1277     do
     1278     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1279     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1280     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     1281     :
     1282       define variable v-full-tbl-name  as character no-undo .
     1283       define variable bh_tbl-name      as handle    no-undo .
     1284       define variable fh_key           as handle    no-undo .
     1285       define variable fh_search        as handle    no-undo .
     1286       define variable v-field-num      as integer   no-undo .
     1287       define variable v-count-fld      as integer   no-undo .
     1288       define variable v-inform         as character no-undo .
     1289       define variable v-ind            as integer   no-undo .
     1290       define variable v-idx-field-qnty as integer   no-undo .
     1291       define variable v-field-name     as character no-undo .
     1292       define variable v-field-val      as character no-undo .
     1293       define variable v-word-link      as character no-undo .
     1294       define variable vTable           as character no-undo.
     1295       define variable bh_tbl-key       as handle    no-undo .
     1296       assign
     1297         p-key-rec = trim( p-key-rec )
     1298       .
     1299       if p-key-handle <> ? then do:
     1300         if not valid-handle(p-key-handle)
     1301            or p-key-handle:type <> "buffer"
     1302         then do:
     1303           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info5 ).
     1304         end.
     1305         if num-entries( p-key-rec, chr(3) ) > 1
     1306           or p-key-rec = ?
     1307           or p-key-rec = "":U
     1308         then do:
     1309           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info5, p-key-rec ).
     1310         end.
     1311       end.
     1312       else do:
     1313         if p-key-rec = ?
     1314           or p-key-rec = "":U
     1315         then do:
     1316           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info5 ).
     1317         end.
     1318       end.
     1319       assign
     1320         vTable = entry( 1 , p-key-rec, chr(3) )
     1321       .
     1322       if p-tt-handle <> ?
     1323         and ( not valid-handle(p-tt-handle)
     1324               or p-tt-handle:type <> "buffer"
     1325             )
     1326       then do:
     1327         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info5, vTable, chr(10) ).
     1328       end.
     1329       if p-tt-handle = ? then do:
     1330         assign
     1331           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     1332         .
     1333         create buffer bh_tbl-name for table v-full-tbl-name .
     1334       end.
     1335       else do:
     1336         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1337       end.
     1338       assign
     1339         v-inform = bh_tbl-name:index-information(1)
     1340         v-ind    = 2
     1341       .
     1342       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1343       on error undo, return error
     1344       :
     1345         assign
     1346           v-inform = bh_tbl-name:index-information( v-ind )
     1347           v-ind    = v-ind + 1
     1348         .
     1349       end.
     1350       if v-inform = ?
     1351         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1352         or entry( 3, v-inform, ",":U ) <> "1":U
     1353       then do:
     1354         delete object bh_tbl-name no-error.
     1355         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info5, vTable ).
     1356       end.
     1357       assign
     1358         v-idx-field-qnty = num-entries( v-inform ) - 4
     1359       .
     1360       if v-idx-field-qnty < 2 then do:
     1361         delete object bh_tbl-name no-error.
     1362         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, vTable ).
     1363       end.
     1364       assign
     1365         o-where     = "where":U
     1366         v-word-link = "":U
     1367         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     1368         v-count-fld = 0
     1369       .
     1370       if i-tablekey ne "" and i-tablekey ne ?
     1371       then do:
     1372         assign
     1373           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     1374         .
     1375         create buffer bh_tbl-key for table v-full-tbl-name .
     1376       end.
     1377       if i-tableSerach ne "" and i-tableSerach ne ?
     1378       then do:
     1379         delete object bh_tbl-name no-error.
     1380         assign
     1381           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     1382         .
     1383         create buffer bh_tbl-name for table v-full-tbl-name .
     1384       end.
     1385       block_where:
     1386       do v-ind = 1 to v-idx-field-qnty by 2
     1387       on error undo, return error
     1388       :
     1389         assign
     1390           v-count-fld = v-count-fld + 1
     1391         .
     1392         if p-key-handle = ?
     1393           and v-count-fld > v-field-num
     1394         then do:
     1395           leave block_where.
     1396         end.
     1397         define variable VfieldKeyTable as handle no-undo.
     1398         assign
     1399           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1400           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     1401         .
     1402         if     bh_tbl-key ne ?
     1403         then do:
     1404            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     1405            if VfieldKeyTable eq ?
     1406            then next block_where.
     1407         end.
     1408         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     1409         then
     1410            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     1411         else
     1412            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     1413         if p-key-handle = ? then do:
     1414           assign
     1415             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     1416           .
     1417         end.
     1418         else do:
     1419           assign
     1420             fh_key = p-key-handle:buffer-field( v-field-name )
     1421           .
     1422           if fh_key = ?
     1423             or not valid-handle( fh_key )
     1424           then do:
     1425             delete object bh_tbl-name.
     1426             if     bh_tbl-key ne ?
     1427             then
     1428                delete object bh_tbl-key.
     1429             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info5, p-key-handle:name, v-field-name ).
     1430           end.
     1431           assign
     1432             v-field-val = fh_key:buffer-value
     1433           .
     1434         end.
     1435         if fh_search:data-type ="character":U then do:
     1436           assign
     1437             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1438             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1439             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1440             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1441             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1442             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1443             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1444             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1445             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1446             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1447             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1448             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1449             v-field-val = substitute( '"&1"', v-field-val )
     1450           .
     1451         end.
     1452         assign
     1453           o-where = substitute( "&1 &2", o-where, v-field-val )
     1454         .
     1455         if v-word-link = "":U then do:
     1456           assign
     1457             v-word-link = "and":U
     1458           .
     1459         end.
     1460       end.
     1461       delete object bh_tbl-name.
     1462       if     bh_tbl-key ne ?
     1463       then
     1464          delete object bh_tbl-key.
     1465       if p-key-handle = ?
     1466         and v-count-fld <> v-field-num
     1467       then do:
     1468         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info5, vTable ).
     1469       end.
     1470     end.
     1471   end procedure.
     1472   procedure gen-hn-keyr-tab :
     1473     define input  parameter i-tableSerach as character no-undo.
     1474     define input  parameter i-tablekey   as character no-undo.
     1475     define input  parameter p-key-rec    as character no-undo.
     1476     define input  parameter p-key-handle as handle    no-undo .
     1477     define input  parameter p-db-name    as character no-undo .
     1478     define input  parameter p-tt-handle  as handle    no-undo .
     1479     define input  parameter p-stts-lock  as integer   no-undo .
     1480     define output parameter o-hn         as handle    no-undo.
     1481     define variable v-full-tbl-name as character no-undo.
     1482     define variable v-where         as character no-undo.
     1483     define variable bh_tbl-name     as handle    no-undo.
     1484     define variable vTable          as character no-undo.
     1485     do
     1486     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1487     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1488     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1489         run gen-where-keyr-tab(i-tableSerach,
     1490                                i-tablekey,
     1491                                p-key-rec,
     1492                                p-key-handle,
     1493                                p-db-name,
     1494                                p-tt-handle,
     1495                                output v-where).
     1496         if i-tableSerach ne "" and i-tableSerach ne ?
     1497         then do:
     1498            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1499            create buffer bh_tbl-name for table v-full-tbl-name .
     1500         end.
     1501         else do:
     1502            if p-tt-handle = ? then do:
     1503               assign
     1504                  vTable = entry( 1 , p-key-rec, chr(3) )
     1505               .
     1506               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1507               create buffer bh_tbl-name for table v-full-tbl-name .
     1508            end.
     1509            else do:
     1510               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1511            end.
     1512         end.
     1513         if p-tt-handle = ? then do:
     1514            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1515         end.
     1516         else do:
     1517            bh_tbl-name:find-first( v-where ) no-error .
     1518         end.
     1519         o-hn = bh_tbl-name.
     1520      end.
     1521   end procedure.
     1522   procedure gen-hn-keyr :
     1523     define input  parameter p-key-rec    as character no-undo.
     1524     define input  parameter p-key-handle as handle    no-undo .
     1525     define input  parameter p-db-name    as character no-undo .
     1526     define input  parameter p-tt-handle  as handle    no-undo .
     1527     define input  parameter p-stts-lock  as integer   no-undo .
     1528     define output parameter o-hn         as handle    no-undo.
     1529     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1530   end.
     1531   procedure gen-row-keyr :
     1532     define input  parameter p-key-rec    as character no-undo.
     1533     define input  parameter p-key-handle as handle    no-undo .
     1534     define input  parameter p-db-name    as character no-undo .
     1535     define input  parameter p-tt-handle  as handle    no-undo .
     1536     define input  parameter p-stts-lock  as integer   no-undo .
     1537     define output parameter p-tbl-row    as rowid     no-undo.
     1538     define output parameter p-tbl-name   as character no-undo.
     1539     define variable vHn as handle no-undo.
     1540       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1541       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1542       p-tbl-name =  vHn:table.
     1543       delete object vHn no-error.
     1544     if p-tbl-row = ? then do:
     1545       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info5, p-tbl-name, p-key-rec ).
     1546     end.
     1547     else do:
     1548       return.
     1549     end.
     1550   end procedure.
     1551   procedure gen-key-fv :
     1552     define input  parameter p-key-rec    as character no-undo .
     1553     define output parameter p-field-list as character no-undo .
     1554     define output parameter p-value-list as character no-undo.
     1555     do
     1556     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1557     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1558     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1559     :
     1560       define variable v-full-tbl-name  as character no-undo .
     1561       define variable bh_tbl-name      as handle    no-undo .
     1562       define variable v-tbl-name       as character no-undo .
     1563       define variable v-field-num      as integer   no-undo .
     1564       define variable v-count-fld      as integer   no-undo .
     1565       define variable v-inform         as character no-undo .
     1566       define variable v-ind            as integer   no-undo .
     1567       define variable v-idx-field-qnty as integer   no-undo .
     1568       define variable v-delim-key      as character no-undo .
     1569       if p-key-rec = ?
     1570         or p-key-rec = "":U
     1571       then do:
     1572         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info5 ).
     1573       end.
     1574       assign
     1575         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1576         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1577       .
     1578       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1579       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info5 ).
     1580       assign
     1581         v-inform = bh_tbl-name:index-information(1)
     1582         v-ind    = 2
     1583       .
     1584       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1585       on error undo, return error
     1586       :
     1587         assign
     1588           v-inform = bh_tbl-name:index-information( v-ind )
     1589           v-ind    = v-ind + 1
     1590         .
     1591       end.
     1592       if v-inform = ?
     1593         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1594         or entry( 3, v-inform, ",":U ) <> "1":U
     1595       then do:
     1596         delete object bh_tbl-name no-error.
     1597         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, v-tbl-name ).
     1598       end.
     1599       assign
     1600         v-idx-field-qnty = num-entries( v-inform ) - 4
     1601       .
     1602       if v-idx-field-qnty < 2 then do:
     1603         delete object bh_tbl-name no-error.
     1604         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, v-tbl-name ).
     1605       end.
     1606       assign
     1607         p-field-list = "":U
     1608         p-value-list = "":U
     1609         v-delim-key  = "":U
     1610         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1611         v-count-fld  = 0
     1612       .
     1613       block_where:
     1614       do v-ind = 1 to v-idx-field-qnty by 2
     1615       on error undo, return error
     1616       :
     1617         assign
     1618           v-count-fld = v-count-fld + 1
     1619         .
     1620         if v-count-fld > v-field-num then do:
     1621           leave block_where.
     1622         end.
     1623         assign
     1624           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1625           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1626         .
     1627         if v-ind = 1 then do:
     1628           assign
     1629             v-delim-key = chr(3)
     1630           .
     1631         end.
     1632       end.
     1633       delete object bh_tbl-name.
     1634       if v-count-fld <> v-field-num then do:
     1635         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info5, v-tbl-name ).
     1636       end.
     1637     end.
     1638   end procedure.
     1639   procedure gen-key-field :
     1640     define input  parameter p-table      as character no-undo .
     1641     define output parameter p-field-list as character no-undo .
     1642     do
     1643     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1644     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1645     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1646     :
     1647       define variable v-full-tbl-name  as character no-undo .
     1648       define variable bh_tbl-name      as handle    no-undo .
     1649       define variable v-tbl-name       as character no-undo .
     1650       define variable v-field-num      as integer   no-undo .
     1651       define variable v-count-fld      as integer   no-undo .
     1652       define variable v-inform         as character no-undo .
     1653       define variable v-ind            as integer   no-undo .
     1654       define variable v-idx-field-qnty as integer   no-undo .
     1655       define variable v-delim-key      as character no-undo .
     1656       if p-table = ?
     1657         or p-table = "":U
     1658       then do:
     1659         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info5 ).
     1660       end.
     1661       assign
     1662         v-tbl-name      = p-table
     1663         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1664       .
     1665       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1666       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info5 ).
     1667       assign
     1668         v-inform = bh_tbl-name:index-information(1)
     1669         v-ind    = 2
     1670       .
     1671       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1672       on error undo, return error
     1673       :
     1674         assign
     1675           v-inform = bh_tbl-name:index-information( v-ind )
     1676           v-ind    = v-ind + 1
     1677         .
     1678       end.
     1679       if v-inform = ?
     1680         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1681         or entry( 3, v-inform, ",":U ) <> "1":U
     1682       then do:
     1683         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, v-tbl-name ).
     1684       end.
     1685       assign
     1686         v-idx-field-qnty = num-entries( v-inform ) - 4
     1687       .
     1688       if v-idx-field-qnty < 2 then do:
     1689         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, v-tbl-name ).
     1690       end.
     1691       assign
     1692         p-field-list = "":U
     1693         v-delim-key  = "":U
     1694         v-count-fld  = 0
     1695       .
     1696       block_where:
     1697       do v-ind = 1 to v-idx-field-qnty by 2
     1698       on error undo, return error
     1699       :
     1700         assign
     1701           v-count-fld = v-count-fld + 1
     1702         .
     1703         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1704         if v-ind = 1 then do:
     1705           assign
     1706             v-delim-key = chr(3)
     1707           .
     1708         end.
     1709       end.
     1710       delete object bh_tbl-name.
     1711     end.
     1712   end procedure.
     1713   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1714   define variable v-waitfram-action01         as character   no-undo .
     1715   define variable v-waitfram-action02         as character   no-undo .
     1716   define variable v-waitfram-action03         as character   no-undo .
     1717   define variable mWaitFramTextBeg            as character   no-undo.
     1718   define variable mWaitFramTextEnd            as character   no-undo.
     1719   define variable mWaitFramView               as logical     no-undo.
     1720   define variable mWaitProcEvent              as logical     no-undo init yes.
     1721   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1722   define variable mWaitFramStop               as logical     no-undo.
     1723   define variable mWaitFramStopUser           as logical     no-undo.
     1724   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1725   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1726   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1727   define button B-WaitFramStop auto-end-key
     1728        label "Стоп"
     1729        size 10 by 1 tooltip "Остоновить процесс".
     1730   define button B-viewProcInfo
     1731        label "Информация"
     1732        size 15 by 1 tooltip "Информация о процесс".
     1733   define frame waitfram
     1734     v-waitfram-action01 format "x(72)" no-label skip
     1735     v-waitfram-action02 format "x(72)" no-label skip
     1736     v-waitfram-action03 format "x(72)" no-label skip
     1737     B-viewProcInfo
     1738     B-WaitFramStop at row 4 col 30
     1739     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1740     .
     1741   define new global shared variable mBatchMode as logical no-undo init ?.
     1742   define variable mFramBachModHandle as handle no-undo.
     1743   mFramBachModHandle = frame waitfram:handle.
     1744   define variable mFameOldVis as logical no-undo.
     1745   define variable mVisCUrentVin as logical no-undo.
     1746   if session:batch-mode
     1747   then
     1748      mBatchMode = yes.
     1749   if mBatchMode = ? then do:
     1750     mVisCUrentVin = current-window:visible.
     1751     mFameOldVis = mFramBachModHandle:visible.
     1752     mFramBachModHandle:visible  = yes.
     1753     mBatchMode = mFramBachModHandle:visible ne yes.
     1754     mFramBachModHandle:visible = mFameOldVis.
     1755     current-window:visible = mVisCUrentVin.
     1756   end.
     1757    if  log-manager:logfile-name ne ?
     1758     then DO:
     1759         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1760         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1761         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1762     end.
     1763   on choose of B-WaitFramStop in frame waitfram
     1764   do:
     1765     mWaitFramStop = yes.
     1766     mWaitFramStopUser = yes.
     1767   end.
     1768   function waitfram-check-timeout returns logical():
     1769      define variable vtime as int64 no-undo.
     1770      if mWaitFramStopTimeOut
     1771      then
     1772         return yes.
     1773      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1774      if     mWaitFramTimeOut ne ?
     1775         and mWaitFramTimeOut ne 0
     1776         and mWaitFramTimeOut lt vtime
     1777      then do:
     1778         mWaitFramStopTimeOut = yes.
     1779      end.
     1780      return mWaitFramStopTimeOut.
     1781   end.
     1782   procedure waitfram-hide :
     1783     if not session:batch-mode
     1784     then do
     1785     on error undo, return error return-value
     1786     :
     1787       pause 0 before-hide .
     1788       if not mBatchMode then
     1789         hide frame waitfram .
     1790     if     not mWaitFramView
     1791        and mWaitProcEvent
     1792     then
     1793       process events .
     1794     end.
     1795   end procedure.
     1796   procedure waitfram-show :
     1797     define input  parameter p-message as character no-undo .
     1798     define variable v-left-margin as integer   no-undo .
     1799     if not session:batch-mode
     1800     then do
     1801     on error undo, return error return-value
     1802     :
     1803       if length(p-message) <= 70 then do:
     1804         assign
     1805           v-left-margin = integer((70 - length(p-message)) / 2)
     1806         .
     1807         assign
     1808           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1809         .
     1810         assign
     1811           v-waitfram-action01 = " "
     1812           v-waitfram-action02 = " "
     1813                                    + fill(" ", v-left-margin)
     1814                                    + p-message
     1815           v-waitfram-action03 = " "
     1816         .
     1817       end.
     1818       else do:
     1819         define variable vRindex1 as integer no-undo.
     1820         define variable vRindex2 as integer no-undo.
     1821         vRindex1 = r-index(p-message," ",70).
     1822         if vRindex1 = 0
     1823         then
     1824            vRindex1 = 70.
     1825         if length(p-message)  <= vRindex1 + 70 then do:
     1826           assign
     1827             v-waitfram-action01 = " "
     1828             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1829             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1830           .
     1831         end.
     1832         else do:
     1833           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1834           if vRindex2 <= vRindex1
     1835           then
     1836              vRindex2 = vRindex1 + 70.
     1837           assign
     1838             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1839             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1840             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1841           .
     1842         end.
     1843       end.
     1844       B-viewProcInfo:visible   in frame waitfram = no.
     1845       B-viewProcInfo:sensitive in frame waitfram = no.
     1846       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1847       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1848       if  (   mWaitFramView
     1849          or  mWaitProcEvent)
     1850          and not mBatchMode
     1851       then
     1852          display
     1853             v-waitfram-action01 skip
     1854             v-waitfram-action02 skip
     1855             v-waitfram-action03 skip
     1856          with frame waitfram .
     1857       if     mWaitFramView
     1858          then do:
     1859             if     mWaitFramInterval ne ?
     1860                and not mBatchMode
     1861             then
     1862                wait-for go of frame waitfram pause mWaitFramInterval.
     1863          end.
     1864          else
     1865             if     mWaitProcEvent
     1866                and not mBatchMode
     1867             then
     1868                process events .
     1869     end.
     1870   end procedure.
     1871      procedure waitfram-show-this:
     1872         define input  parameter iInterval as int64 no-undo.
     1873         define variable vtime as int64 no-undo.
     1874         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1875         mWaitFramInterval = iInterval.
     1876         run waitfram-show (substitute("&1&2 &3&4" ,
     1877                                       mWaitFramTextBeg ,
     1878                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1879                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1880                                       mWaitFramTextEnd
     1881                                      )
     1882                           ).
     1883      end.
     1884      procedure WaitFramRunPause:
     1885         define input  parameter iInterval as dec no-undo.
     1886         define variable vStart  as datetime-tz no-undo.
     1887         define variable vend    as datetime-tz no-undo.
     1888         define variable vint as int64 no-undo.
     1889         define variable vOk as logical no-undo.
     1890         vStart = now.
     1891         vend   = vStart.
     1892         publish "WaitFramPause" (iInterval,output vOk).
     1893         vend   =  now.
     1894         vint = vend - vStart.
     1895         vint = iInterval - vint / 1000.
     1896         if     not mWaitFramStop
     1897            and (   vint > 0
     1898                 or (    not vOk
     1899                     and iInterval eq ?
     1900                     )
     1901                 )
     1902         then
     1903            run waitfram-show-this (iInterval).
     1904         vend   =  now.
     1905         vint = vend - vStart.
     1906         vint = iInterval - vint / 1000.
     1907         if     not mWaitFramStop
     1908            and vint > 0
     1909         then do:
     1910            run gbl/pause.p (vint * 1000).
     1911         end.
     1912         if iInterval ne ?
     1913         then
     1914            publish "WaitFramStop".
     1915         waitfram-check-timeout().
     1916      end.
     1917      procedure WaitFramWaitFor:
     1918         define input  parameter iInterval as dec no-undo.
     1919         assign
     1920            mWaitFramStartProc   = now
     1921            mWaitFramStopUser    = no
     1922            mWaitFramStopTimeOut = no
     1923         .
     1924         block-wait:
     1925         do while not mWaitFramStop:
     1926            run WaitFramRunPause (iInterval).
     1927            if  waitfram-check-timeout()
     1928            then do:
     1929               leave block-wait.
     1930            end.
     1931         end.
     1932         run waitfram-hide.
     1933      end.
     1934   procedure waitfram-join :
     1935     define input  parameter p-line-1  as character no-undo .
     1936     define input  parameter p-line-2  as character no-undo .
     1937     define input  parameter p-line-3  as character no-undo .
     1938     define output parameter p-message as character no-undo .
     1939     do
     1940     on error undo, return error return-value
     1941     :
     1942       assign
     1943         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1944                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1945                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1946       .
     1947     end.
     1948   end procedure.
     1949   function waitfram-join-function returns character
     1950     (input p-line-1 as character
     1951     ,input p-line-2 as character
     1952     ,input p-line-3 as character
     1953     ).
     1954     define variable v-message as character no-undo .
     1955     run waitfram-join in this-procedure
     1956       (input  p-line-1
     1957       ,input  p-line-2
     1958       ,input  p-line-3
     1959       ,output v-message
     1960       ) .
     1961     return v-message .
     1962   end function .
     1963   define variable v-level as integer no-undo .
     1964   define buffer buf_TEMP-STRING  for temp-string.
     1965   define variable v-cmdln as character no-undo .
     1966   define variable err-file as character no-undo .
     1967   define variable res as character no-undo .
     1968   define variable v-short-file-name as character no-undo .
     1969   define variable v-path                    as character                no-undo .
     1970   DEFINE VARIABLE v-full-path               as character                no-undo .
     1971   DEFINE VARIABLE v-file-name               as character                no-undo .
     1972   DEFINE VARIABLE v-file-name-cmd           as character                no-undo .
     1973   DEFINE VARIABLE v-file-name-dot           as character                no-undo .
     1974   DEFINE VARIABLE v-file-name-gif           as character                no-undo .
     1975   define variable v-file-name-html          as character                no-undo .
     1976   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
     1977   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
     1978   define stream outstream .
     1979   main-block:
     1980   do
     1981   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1982   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1983   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1984   :
     1985     run temp-string_clear in this-procedure .
     1986     run display-rule in this-procedure ( input p-rule-id
     1987                                     , input 0
     1988                                     , input substitute("DOT1-&1", p-language)
     1989                                     , input-output v-level).
     1990     run display-rule in this-procedure ( input p-rule-id
     1991                                     , input 0
     1992                                     , input substitute("DOT2-&1", p-language)
     1993                                     , input-output v-level).
     1994     output stream outstream to value( substitute( "&1.dot" ,string(p-rule-id, "999999999"))) convert target "UTF-8" .
     1995     for each buf_temp-string
     1996     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1997     :
     1998     put stream outstream unformatted buf_temp-string.v-string chr(10).
     1999     end.
     2000     output stream outstream close.
     2001     run gbl/_tmpfile.p ( input ""
     2002                         ,input  ""
     2003                         ,output err-file) .
     2004     assign
     2005     v-short-file-name = string(p-rule-id, "999999999") + ".dot"
     2006     .
     2007     run gbl/filename.p (
     2008                    input  v-short-file-name
     2009                   ,output v-file-name-dot
     2010                   ,output v-path
     2011                   ,output v-file-name
     2012                   ,output v-file-name-no-ext
     2013                   ,output v-file-name-ext
     2014                   ) no-error .
     2015     if error-status:error then do:
     2016       message
     2017       return-value
     2018       view-as alert-box ERROR.
     2019       return.
     2020     end.
     2021     run rep/killspac.p ( input-output v-file-name-dot).
     2022     assign
     2023     v-file-name-gif = replace(v-file-name-dot, ".dot", ".gif")
     2024     .
     2025     assign
     2026     v-short-file-name = "exe/graphviz/dot.exe".
     2027     run gbl/filename.p (
     2028                    input  v-short-file-name
     2029                   ,output v-file-name-cmd
     2030                   ,output v-path
     2031                   ,output v-file-name
     2032                   ,output v-file-name-no-ext
     2033                   ,output v-file-name-ext
     2034                   ) no-error .
     2035     if error-status:error then do:
     2036       message
     2037       return-value
     2038       view-as alert-box ERROR.
     2039       return.
     2040     end.
     2041     assign
     2042     err-file = err-file + ".err":u
     2043     v-cmdln = substitute('"&1" -Tgif &2 -o &3 -Gcharset=UTF-8 > &4'
     2044                          ,v-file-name-cmd
     2045                          ,v-file-name-dot
     2046                          ,v-file-name-gif
     2047                          ,err-file
     2048                          ).
     2049     .
     2050     run gbl/syn.p
     2051       (input v-cmdln
     2052       ,input "":U
     2053       ,input "Ждите! Идет форматирование файла..."
     2054       ,output res
     2055       ) no-error .
     2056     run waitfram-hide in this-procedure .
     2057     run gbl/filename.p (
     2058                    input  v-file-name-gif
     2059                   ,output v-full-path
     2060                   ,output v-path
     2061                   ,output v-file-name
     2062                   ,output v-file-name-no-ext
     2063                   ,output v-file-name-ext
     2064                   ) no-error .
     2065     if error-status:error then do:
     2066       message
     2067       return-value
     2068       view-as alert-box ERROR.
     2069       return.
     2070     end.
     2071     run rep/killspac.p ( input-output v-full-path).
     2072     v-file-name-html = replace(v-file-name-dot, ".dot", ".html").
     2073     output stream Outstream to value(v-file-name-html).
     2074     put stream Outstream unformatted
     2075     substitute('<IMG SRC="&1.gif" ALT="ПРАВИЛО &2">', string(p-rule-id, "999999999"), p-rule-id)
     2076     skip.
     2077     output stream Outstream close.
     2078     run gbl/open_url.p ( input  v-file-name-html) no-error .
     2079     if search("grafdisp.dbg") = ? then do:
     2080       os-delete value(v-file-name-dot).
     2081     end.
     2082     os-delete value(err-file).
     2083   end.
