        1   block-level on error undo, throw.
        2   define input  parameter p-rule-id1 as integer no-undo .
        3   define output parameter p-rule-id2 as integer no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision$":U .
        5   define variable vss-author      as character no-undo init "$Author$":U .
        6   define variable vss-date        as character no-undo init "$Date$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        8   define variable vss-archive     as character no-undo init "$Archive$":U .
        9   define variable vss-description as character no-undo init "Копирование правил ".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       69   define variable v-waitfram-action01         as character   no-undo .
       70   define variable v-waitfram-action02         as character   no-undo .
       71   define variable v-waitfram-action03         as character   no-undo .
       72   define variable mWaitFramTextBeg            as character   no-undo.
       73   define variable mWaitFramTextEnd            as character   no-undo.
       74   define variable mWaitFramView               as logical     no-undo.
       75   define variable mWaitProcEvent              as logical     no-undo init yes.
       76   define variable mWaitFramInterval           as integer     no-undo init 1 .
       77   define variable mWaitFramStop               as logical     no-undo.
       78   define variable mWaitFramStopUser           as logical     no-undo.
       79   define variable mWaitFramStopTimeOut        as logical     no-undo.
       80   define variable mWaitFramStartProc          as datetime-tz no-undo.
       81   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       82   define button B-WaitFramStop auto-end-key
       83        label "Стоп"
       84        size 10 by 1 tooltip "Остоновить процесс".
       85   define button B-viewProcInfo
       86        label "Информация"
       87        size 15 by 1 tooltip "Информация о процесс".
       88   define frame waitfram
       89     v-waitfram-action01 format "x(72)" no-label skip
       90     v-waitfram-action02 format "x(72)" no-label skip
       91     v-waitfram-action03 format "x(72)" no-label skip
       92     B-viewProcInfo
       93     B-WaitFramStop at row 4 col 30
       94     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       95     .
       96   define new global shared variable mBatchMode as logical no-undo init ?.
       97   define variable mFramBachModHandle as handle no-undo.
       98   mFramBachModHandle = frame waitfram:handle.
       99   define variable mFameOldVis as logical no-undo.
      100   define variable mVisCUrentVin as logical no-undo.
      101   if session:batch-mode
      102   then
      103      mBatchMode = yes.
      104   if mBatchMode = ? then do:
      105     mVisCUrentVin = current-window:visible.
      106     mFameOldVis = mFramBachModHandle:visible.
      107     mFramBachModHandle:visible  = yes.
      108     mBatchMode = mFramBachModHandle:visible ne yes.
      109     mFramBachModHandle:visible = mFameOldVis.
      110     current-window:visible = mVisCUrentVin.
      111   end.
      112    if  log-manager:logfile-name ne ?
      113     then DO:
      114         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      115         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      116         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      117     end.
      118   on choose of B-WaitFramStop in frame waitfram
      119   do:
      120     mWaitFramStop = yes.
      121     mWaitFramStopUser = yes.
      122   end.
      123   function waitfram-check-timeout returns logical():
      124      define variable vtime as int64 no-undo.
      125      if mWaitFramStopTimeOut
      126      then
      127         return yes.
      128      vtime = ( now - mWaitFramStartProc ) / 1000 .
      129      if     mWaitFramTimeOut ne ?
      130         and mWaitFramTimeOut ne 0
      131         and mWaitFramTimeOut lt vtime
      132      then do:
      133         mWaitFramStopTimeOut = yes.
      134      end.
      135      return mWaitFramStopTimeOut.
      136   end.
      137   procedure waitfram-hide :
      138     if not session:batch-mode
      139     then do
      140     on error undo, return error return-value
      141     :
      142       pause 0 before-hide .
      143       if not mBatchMode then
      144         hide frame waitfram .
      145     if     not mWaitFramView
      146        and mWaitProcEvent
      147     then
      148       process events .
      149     end.
      150   end procedure.
      151   procedure waitfram-show :
      152     define input  parameter p-message as character no-undo .
      153     define variable v-left-margin as integer   no-undo .
      154     if not session:batch-mode
      155     then do
      156     on error undo, return error return-value
      157     :
      158       if length(p-message) <= 70 then do:
      159         assign
      160           v-left-margin = integer((70 - length(p-message)) / 2)
      161         .
      162         assign
      163           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      164         .
      165         assign
      166           v-waitfram-action01 = " "
      167           v-waitfram-action02 = " "
      168                                    + fill(" ", v-left-margin)
      169                                    + p-message
      170           v-waitfram-action03 = " "
      171         .
      172       end.
      173       else do:
      174         define variable vRindex1 as integer no-undo.
      175         define variable vRindex2 as integer no-undo.
      176         vRindex1 = r-index(p-message," ",70).
      177         if vRindex1 = 0
      178         then
      179            vRindex1 = 70.
      180         if length(p-message)  <= vRindex1 + 70 then do:
      181           assign
      182             v-waitfram-action01 = " "
      183             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      184             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      185           .
      186         end.
      187         else do:
      188           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      189           if vRindex2 <= vRindex1
      190           then
      191              vRindex2 = vRindex1 + 70.
      192           assign
      193             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      194             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      195             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      196           .
      197         end.
      198       end.
      199       B-viewProcInfo:visible   in frame waitfram = no.
      200       B-viewProcInfo:sensitive in frame waitfram = no.
      201       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      202       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      203       if  (   mWaitFramView
      204          or  mWaitProcEvent)
      205          and not mBatchMode
      206       then
      207          display
      208             v-waitfram-action01 skip
      209             v-waitfram-action02 skip
      210             v-waitfram-action03 skip
      211          with frame waitfram .
      212       if     mWaitFramView
      213          then do:
      214             if     mWaitFramInterval ne ?
      215                and not mBatchMode
      216             then
      217                wait-for go of frame waitfram pause mWaitFramInterval.
      218          end.
      219          else
      220             if     mWaitProcEvent
      221                and not mBatchMode
      222             then
      223                process events .
      224     end.
      225   end procedure.
      226      procedure waitfram-show-this:
      227         define input  parameter iInterval as int64 no-undo.
      228         define variable vtime as int64 no-undo.
      229         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      230         mWaitFramInterval = iInterval.
      231         run waitfram-show (substitute("&1&2 &3&4" ,
      232                                       mWaitFramTextBeg ,
      233                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      234                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      235                                       mWaitFramTextEnd
      236                                      )
      237                           ).
      238      end.
      239      procedure WaitFramRunPause:
      240         define input  parameter iInterval as dec no-undo.
      241         define variable vStart  as datetime-tz no-undo.
      242         define variable vend    as datetime-tz no-undo.
      243         define variable vint as int64 no-undo.
      244         define variable vOk as logical no-undo.
      245         vStart = now.
      246         vend   = vStart.
      247         publish "WaitFramPause" (iInterval,output vOk).
      248         vend   =  now.
      249         vint = vend - vStart.
      250         vint = iInterval - vint / 1000.
      251         if     not mWaitFramStop
      252            and (   vint > 0
      253                 or (    not vOk
      254                     and iInterval eq ?
      255                     )
      256                 )
      257         then
      258            run waitfram-show-this (iInterval).
      259         vend   =  now.
      260         vint = vend - vStart.
      261         vint = iInterval - vint / 1000.
      262         if     not mWaitFramStop
      263            and vint > 0
      264         then do:
      265            run gbl/pause.p (vint * 1000).
      266         end.
      267         if iInterval ne ?
      268         then
      269            publish "WaitFramStop".
      270         waitfram-check-timeout().
      271      end.
      272      procedure WaitFramWaitFor:
      273         define input  parameter iInterval as dec no-undo.
      274         assign
      275            mWaitFramStartProc   = now
      276            mWaitFramStopUser    = no
      277            mWaitFramStopTimeOut = no
      278         .
      279         block-wait:
      280         do while not mWaitFramStop:
      281            run WaitFramRunPause (iInterval).
      282            if  waitfram-check-timeout()
      283            then do:
      284               leave block-wait.
      285            end.
      286         end.
      287         run waitfram-hide.
      288      end.
      289   procedure waitfram-join :
      290     define input  parameter p-line-1  as character no-undo .
      291     define input  parameter p-line-2  as character no-undo .
      292     define input  parameter p-line-3  as character no-undo .
      293     define output parameter p-message as character no-undo .
      294     do
      295     on error undo, return error return-value
      296     :
      297       assign
      298         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      299                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      300                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      301       .
      302     end.
      303   end procedure.
      304   function waitfram-join-function returns character
      305     (input p-line-1 as character
      306     ,input p-line-2 as character
      307     ,input p-line-3 as character
      308     ).
      309     define variable v-message as character no-undo .
      310     run waitfram-join in this-procedure
      311       (input  p-line-1
      312       ,input  p-line-2
      313       ,input  p-line-3
      314       ,output v-message
      315       ) .
      316     return v-message .
      317   end function .
      318   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      319   procedure gen-key-rec :
      320     define input  parameter p-tbl-name    as character no-undo.
      321     define input  parameter p-bh_tbl-name as handle    no-undo.
      322     define output parameter p-key-rec     as character no-undo.
      323     do
      324     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      325     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      326     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      327     :
      328       define variable fh               as handle    no-undo .
      329       define variable v-ok             as logical   no-undo .
      330       define variable v-inform         as character no-undo .
      331       define variable v-ind            as integer   no-undo .
      332       define variable v-idx-field-qnty as integer   no-undo .
      333       if p-tbl-name = ?
      334         or p-tbl-name = "":U
      335       then do:
      336         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info1 ).
      337       end.
      338       if not p-bh_tbl-name:available then do:
      339         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info1, p-tbl-name ).
      340       end.
      341       assign
      342         p-key-rec = p-tbl-name
      343         v-inform  = p-bh_tbl-name:index-information(1)
      344         v-ind     = 2
      345       .
      346       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      347       on error undo, return error
      348       :
      349         assign
      350           v-inform = p-bh_tbl-name:index-information( v-ind )
      351           v-ind    = v-ind + 1
      352         .
      353       end.
      354       if v-inform = ?
      355         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      356         or entry( 3, v-inform, ",":U ) <> "1":U
      357       then do:
      358         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, p-tbl-name ).
      359       end.
      360       else do:
      361         assign
      362           v-idx-field-qnty = num-entries( v-inform ) - 4
      363         .
      364         if v-idx-field-qnty < 2 then do:
      365           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, p-tbl-name ).
      366         end.
      367         do v-ind = 1 to v-idx-field-qnty by 2
      368         on error undo, return error
      369         :
      370           assign
      371             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      372             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      373           .
      374         end.
      375       end.
      376       if p-key-rec = ? then do:
      377         assign
      378           p-key-rec = "":U
      379         .
      380         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info1, p-tbl-name ).
      381       end.
      382     end.
      383     return.
      384   end procedure.
      385   procedure gen-where-keyr-tab :
      386     define input  parameter i-tableSerach as character no-undo.
      387     define input  parameter i-tablekey   as character  no-undo.
      388     define input  parameter p-key-rec    as character  no-undo.
      389     define input  parameter p-key-handle as handle     no-undo .
      390     define input  parameter p-db-name    as character  no-undo .
      391     define input  parameter p-tt-handle  as handle     no-undo .
      392     define output parameter o-Where      as character  no-undo.
      393     do
      394     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      395     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      396     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      397     :
      398       define variable v-full-tbl-name  as character no-undo .
      399       define variable bh_tbl-name      as handle    no-undo .
      400       define variable fh_key           as handle    no-undo .
      401       define variable fh_search        as handle    no-undo .
      402       define variable v-field-num      as integer   no-undo .
      403       define variable v-count-fld      as integer   no-undo .
      404       define variable v-inform         as character no-undo .
      405       define variable v-ind            as integer   no-undo .
      406       define variable v-idx-field-qnty as integer   no-undo .
      407       define variable v-field-name     as character no-undo .
      408       define variable v-field-val      as character no-undo .
      409       define variable v-word-link      as character no-undo .
      410       define variable vTable           as character no-undo.
      411       define variable bh_tbl-key       as handle    no-undo .
      412       assign
      413         p-key-rec = trim( p-key-rec )
      414       .
      415       if p-key-handle <> ? then do:
      416         if not valid-handle(p-key-handle)
      417            or p-key-handle:type <> "buffer"
      418         then do:
      419           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info1 ).
      420         end.
      421         if num-entries( p-key-rec, chr(3) ) > 1
      422           or p-key-rec = ?
      423           or p-key-rec = "":U
      424         then do:
      425           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info1, p-key-rec ).
      426         end.
      427       end.
      428       else do:
      429         if p-key-rec = ?
      430           or p-key-rec = "":U
      431         then do:
      432           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      433         end.
      434       end.
      435       assign
      436         vTable = entry( 1 , p-key-rec, chr(3) )
      437       .
      438       if p-tt-handle <> ?
      439         and ( not valid-handle(p-tt-handle)
      440               or p-tt-handle:type <> "buffer"
      441             )
      442       then do:
      443         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info1, vTable, chr(10) ).
      444       end.
      445       if p-tt-handle = ? then do:
      446         assign
      447           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      448         .
      449         create buffer bh_tbl-name for table v-full-tbl-name .
      450       end.
      451       else do:
      452         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      453       end.
      454       assign
      455         v-inform = bh_tbl-name:index-information(1)
      456         v-ind    = 2
      457       .
      458       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      459       on error undo, return error
      460       :
      461         assign
      462           v-inform = bh_tbl-name:index-information( v-ind )
      463           v-ind    = v-ind + 1
      464         .
      465       end.
      466       if v-inform = ?
      467         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      468         or entry( 3, v-inform, ",":U ) <> "1":U
      469       then do:
      470         delete object bh_tbl-name no-error.
      471         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info1, vTable ).
      472       end.
      473       assign
      474         v-idx-field-qnty = num-entries( v-inform ) - 4
      475       .
      476       if v-idx-field-qnty < 2 then do:
      477         delete object bh_tbl-name no-error.
      478         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, vTable ).
      479       end.
      480       assign
      481         o-where     = "where":U
      482         v-word-link = "":U
      483         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      484         v-count-fld = 0
      485       .
      486       if i-tablekey ne "" and i-tablekey ne ?
      487       then do:
      488         assign
      489           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      490         .
      491         create buffer bh_tbl-key for table v-full-tbl-name .
      492       end.
      493       if i-tableSerach ne "" and i-tableSerach ne ?
      494       then do:
      495         delete object bh_tbl-name no-error.
      496         assign
      497           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      498         .
      499         create buffer bh_tbl-name for table v-full-tbl-name .
      500       end.
      501       block_where:
      502       do v-ind = 1 to v-idx-field-qnty by 2
      503       on error undo, return error
      504       :
      505         assign
      506           v-count-fld = v-count-fld + 1
      507         .
      508         if p-key-handle = ?
      509           and v-count-fld > v-field-num
      510         then do:
      511           leave block_where.
      512         end.
      513         define variable VfieldKeyTable as handle no-undo.
      514         assign
      515           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      516           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      517         .
      518         if     bh_tbl-key ne ?
      519         then do:
      520            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      521            if VfieldKeyTable eq ?
      522            then next block_where.
      523         end.
      524         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      525         then
      526            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      527         else
      528            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      529         if p-key-handle = ? then do:
      530           assign
      531             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      532           .
      533         end.
      534         else do:
      535           assign
      536             fh_key = p-key-handle:buffer-field( v-field-name )
      537           .
      538           if fh_key = ?
      539             or not valid-handle( fh_key )
      540           then do:
      541             delete object bh_tbl-name.
      542             if     bh_tbl-key ne ?
      543             then
      544                delete object bh_tbl-key.
      545             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info1, p-key-handle:name, v-field-name ).
      546           end.
      547           assign
      548             v-field-val = fh_key:buffer-value
      549           .
      550         end.
      551         if fh_search:data-type ="character":U then do:
      552           assign
      553             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      554             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      555             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      556             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      557             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      558             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      559             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      560             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      561             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      562             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      563             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      564             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      565             v-field-val = substitute( '"&1"', v-field-val )
      566           .
      567         end.
      568         assign
      569           o-where = substitute( "&1 &2", o-where, v-field-val )
      570         .
      571         if v-word-link = "":U then do:
      572           assign
      573             v-word-link = "and":U
      574           .
      575         end.
      576       end.
      577       delete object bh_tbl-name.
      578       if     bh_tbl-key ne ?
      579       then
      580          delete object bh_tbl-key.
      581       if p-key-handle = ?
      582         and v-count-fld <> v-field-num
      583       then do:
      584         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info1, vTable ).
      585       end.
      586     end.
      587   end procedure.
      588   procedure gen-hn-keyr-tab :
      589     define input  parameter i-tableSerach as character no-undo.
      590     define input  parameter i-tablekey   as character no-undo.
      591     define input  parameter p-key-rec    as character no-undo.
      592     define input  parameter p-key-handle as handle    no-undo .
      593     define input  parameter p-db-name    as character no-undo .
      594     define input  parameter p-tt-handle  as handle    no-undo .
      595     define input  parameter p-stts-lock  as integer   no-undo .
      596     define output parameter o-hn         as handle    no-undo.
      597     define variable v-full-tbl-name as character no-undo.
      598     define variable v-where         as character no-undo.
      599     define variable bh_tbl-name     as handle    no-undo.
      600     define variable vTable          as character no-undo.
      601     do
      602     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      603     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      604     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      605         run gen-where-keyr-tab(i-tableSerach,
      606                                i-tablekey,
      607                                p-key-rec,
      608                                p-key-handle,
      609                                p-db-name,
      610                                p-tt-handle,
      611                                output v-where).
      612         if i-tableSerach ne "" and i-tableSerach ne ?
      613         then do:
      614            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      615            create buffer bh_tbl-name for table v-full-tbl-name .
      616         end.
      617         else do:
      618            if p-tt-handle = ? then do:
      619               assign
      620                  vTable = entry( 1 , p-key-rec, chr(3) )
      621               .
      622               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      623               create buffer bh_tbl-name for table v-full-tbl-name .
      624            end.
      625            else do:
      626               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      627            end.
      628         end.
      629         if p-tt-handle = ? then do:
      630            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      631         end.
      632         else do:
      633            bh_tbl-name:find-first( v-where ) no-error .
      634         end.
      635         o-hn = bh_tbl-name.
      636      end.
      637   end procedure.
      638   procedure gen-hn-keyr :
      639     define input  parameter p-key-rec    as character no-undo.
      640     define input  parameter p-key-handle as handle    no-undo .
      641     define input  parameter p-db-name    as character no-undo .
      642     define input  parameter p-tt-handle  as handle    no-undo .
      643     define input  parameter p-stts-lock  as integer   no-undo .
      644     define output parameter o-hn         as handle    no-undo.
      645     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      646   end.
      647   procedure gen-row-keyr :
      648     define input  parameter p-key-rec    as character no-undo.
      649     define input  parameter p-key-handle as handle    no-undo .
      650     define input  parameter p-db-name    as character no-undo .
      651     define input  parameter p-tt-handle  as handle    no-undo .
      652     define input  parameter p-stts-lock  as integer   no-undo .
      653     define output parameter p-tbl-row    as rowid     no-undo.
      654     define output parameter p-tbl-name   as character no-undo.
      655     define variable vHn as handle no-undo.
      656       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      657       p-tbl-row = if vHn:available then vHn:rowid else ?.
      658       p-tbl-name =  vHn:table.
      659       delete object vHn no-error.
      660     if p-tbl-row = ? then do:
      661       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info1, p-tbl-name, p-key-rec ).
      662     end.
      663     else do:
      664       return.
      665     end.
      666   end procedure.
      667   procedure gen-key-fv :
      668     define input  parameter p-key-rec    as character no-undo .
      669     define output parameter p-field-list as character no-undo .
      670     define output parameter p-value-list as character no-undo.
      671     do
      672     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      673     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      674     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      675     :
      676       define variable v-full-tbl-name  as character no-undo .
      677       define variable bh_tbl-name      as handle    no-undo .
      678       define variable v-tbl-name       as character no-undo .
      679       define variable v-field-num      as integer   no-undo .
      680       define variable v-count-fld      as integer   no-undo .
      681       define variable v-inform         as character no-undo .
      682       define variable v-ind            as integer   no-undo .
      683       define variable v-idx-field-qnty as integer   no-undo .
      684       define variable v-delim-key      as character no-undo .
      685       if p-key-rec = ?
      686         or p-key-rec = "":U
      687       then do:
      688         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      689       end.
      690       assign
      691         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      692         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      693       .
      694       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      695       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info1 ).
      696       assign
      697         v-inform = bh_tbl-name:index-information(1)
      698         v-ind    = 2
      699       .
      700       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      701       on error undo, return error
      702       :
      703         assign
      704           v-inform = bh_tbl-name:index-information( v-ind )
      705           v-ind    = v-ind + 1
      706         .
      707       end.
      708       if v-inform = ?
      709         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      710         or entry( 3, v-inform, ",":U ) <> "1":U
      711       then do:
      712         delete object bh_tbl-name no-error.
      713         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      714       end.
      715       assign
      716         v-idx-field-qnty = num-entries( v-inform ) - 4
      717       .
      718       if v-idx-field-qnty < 2 then do:
      719         delete object bh_tbl-name no-error.
      720         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      721       end.
      722       assign
      723         p-field-list = "":U
      724         p-value-list = "":U
      725         v-delim-key  = "":U
      726         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      727         v-count-fld  = 0
      728       .
      729       block_where:
      730       do v-ind = 1 to v-idx-field-qnty by 2
      731       on error undo, return error
      732       :
      733         assign
      734           v-count-fld = v-count-fld + 1
      735         .
      736         if v-count-fld > v-field-num then do:
      737           leave block_where.
      738         end.
      739         assign
      740           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      741           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      742         .
      743         if v-ind = 1 then do:
      744           assign
      745             v-delim-key = chr(3)
      746           .
      747         end.
      748       end.
      749       delete object bh_tbl-name.
      750       if v-count-fld <> v-field-num then do:
      751         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info1, v-tbl-name ).
      752       end.
      753     end.
      754   end procedure.
      755   procedure gen-key-field :
      756     define input  parameter p-table      as character no-undo .
      757     define output parameter p-field-list as character no-undo .
      758     do
      759     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      760     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      761     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      762     :
      763       define variable v-full-tbl-name  as character no-undo .
      764       define variable bh_tbl-name      as handle    no-undo .
      765       define variable v-tbl-name       as character no-undo .
      766       define variable v-field-num      as integer   no-undo .
      767       define variable v-count-fld      as integer   no-undo .
      768       define variable v-inform         as character no-undo .
      769       define variable v-ind            as integer   no-undo .
      770       define variable v-idx-field-qnty as integer   no-undo .
      771       define variable v-delim-key      as character no-undo .
      772       if p-table = ?
      773         or p-table = "":U
      774       then do:
      775         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info1 ).
      776       end.
      777       assign
      778         v-tbl-name      = p-table
      779         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      780       .
      781       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      782       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info1 ).
      783       assign
      784         v-inform = bh_tbl-name:index-information(1)
      785         v-ind    = 2
      786       .
      787       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      788       on error undo, return error
      789       :
      790         assign
      791           v-inform = bh_tbl-name:index-information( v-ind )
      792           v-ind    = v-ind + 1
      793         .
      794       end.
      795       if v-inform = ?
      796         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      797         or entry( 3, v-inform, ",":U ) <> "1":U
      798       then do:
      799         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      800       end.
      801       assign
      802         v-idx-field-qnty = num-entries( v-inform ) - 4
      803       .
      804       if v-idx-field-qnty < 2 then do:
      805         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      806       end.
      807       assign
      808         p-field-list = "":U
      809         v-delim-key  = "":U
      810         v-count-fld  = 0
      811       .
      812       block_where:
      813       do v-ind = 1 to v-idx-field-qnty by 2
      814       on error undo, return error
      815       :
      816         assign
      817           v-count-fld = v-count-fld + 1
      818         .
      819         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      820         if v-ind = 1 then do:
      821           assign
      822             v-delim-key = chr(3)
      823           .
      824         end.
      825       end.
      826       delete object bh_tbl-name.
      827     end.
      828   end procedure.
      829   define variable v-for-script-rule-id as integer no-undo .
      830   define variable v1-entry-id as integer no-undo .
      831   define variable v2-entry-id as integer no-undo .
      832   define variable v-uniq-key-rec as character no-undo .
      833   define buffer buf1_rule for ub.rule.
      834   define buffer buf2_rule for ub.rule.
      835   define buffer tree1_rule for ub.rule.
      836   define buffer tree2_rule for ub.rule.
      837   define buffer buf1_rule-script for ub.rule-script.
      838   define buffer buf2_rule-script for ub.rule-script.
      839   define buffer buf1r_rule-script for ub.rule-script.
      840   define buffer buf2r_rule-script for ub.rule-script.
      841   define buffer buf1_rule-i-script for ub.rule-i-script.
      842   define buffer buf2_rule-i-script for ub.rule-i-script.
      843   define buffer buf1_rule-by-set for ub.rule-by-set.
      844   define buffer buf2_rule-by-set for ub.rule-by-set.
      845   define buffer buf1_ruledict for ub.ruledict.
      846   define buffer buf2_ruledict for ub.ruledict.
      847   define buffer last_ruledict for ub.ruledict.
      848   define buffer buf1_ruledict-param for ub.ruledict-param.
      849   define buffer buf2_ruledict-param for ub.ruledict-param.
      850   define temp-table temp-rule no-undo
      851   field rule_id1 as integer
      852   field rule_id2 as integer
      853   index pi is unique primary
      854   rule_id1.
      855   define buffer tree_temp-rule for temp-rule.
      856   define buffer upper_temp-rule for temp-rule.
      857   run waitfram-show in this-procedure ( input "Ждите..." ).
      858   main-block:
      859   do
      860   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)):
      861     find first buf1_rule exclusive-lock where
      862               buf1_rule.rule_id = p-rule-id1 .
      863     if buf1_rule.root_rule_id <> buf1_rule.rule_id then do:
      864        undo main-block, return error substitute( "&1. &2Скопировать можно только корневое правило", vss-workfile, chr(10) ).
      865     end.
      866     create buf2_rule.
      867     buffer-copy buf1_rule
      868     except rule_id sts uniq-key-rec root_rule_id
      869     to buf2_rule
      870     assign
      871     buf2_rule.rule_id = next-value(s-rule-id, ub)
      872     buf2_rule.sts = integer('-10':U)
      873     buf2_rule.root_rule_id = buf2_rule.rule_id
      874     .
      875     create temp-rule.
      876     assign
      877     temp-rule.rule_id1 = buf1_rule.rule_id
      878     temp-rule.rule_id2 = buf2_rule.rule_id
      879     .
      880     release temp-rule.
      881     for each tree1_rule where
      882             tree1_rule.root_rule_id =  buf1_rule.rule_id
      883     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      884     :
      885       find first tree_temp-rule no-lock where
      886                 tree_temp-rule.rule_id1 = tree1_rule.rule_id  no-error.
      887       if not available tree_temp-rule then do:
      888         create tree_temp-rule.
      889         assign
      890         tree_temp-rule.rule_id1 = tree1_rule.rule_id
      891         tree_temp-rule.rule_id2 = next-value(s-rule-id, ub)
      892         .
      893       end.
      894       IF tree1_rule.rule_id <> buf1_rule.rule_id then do:
      895         find first upper_temp-rule no-lock where
      896                   upper_temp-rule.rule_id1 = tree1_rule.upper_rule_id  no-error.
      897         if not available upper_temp-rule then do:
      898           create upper_temp-rule.
      899           assign
      900           upper_temp-rule.rule_id1 = tree1_rule.upper_rule_id
      901           upper_temp-rule.rule_id2 = next-value(s-rule-id, ub)
      902           .
      903         end.
      904         create tree2_rule.
      905         buffer-copy tree1_rule
      906         except rule_id sts uniq-key-rec upper_rule_id root_rule_id
      907         to tree2_rule
      908         assign
      909         tree2_rule.rule_id = tree_temp-rule.rule_id2
      910         tree2_rule.root_rule_id = buf2_rule.rule_id
      911         tree2_rule.upper_rule_id = upper_temp-rule.rule_id2
      912         buf2_rule.sts = integer('-10':U)
      913         v-for-script-rule-id = tree2_rule.rule_id
      914         .
      915       end.
      916       else do:
      917         v-for-script-rule-id = buf2_rule.rule_id.
      918       end.
      919       for each buf1_rule-script where
      920               buf1_rule-script.rule_id = tree1_rule.rule_id
      921          and  buf1_rule-script.language = "ABL"
      922       on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      923       :
      924         create buf2_rule-script.
      925         buffer-copy buf1_rule-script
      926         except rule_id root_rule_id
      927         to buf2_rule-script
      928         assign
      929         buf2_rule-script.script_id = next-value(s-rule-script-id, ub)
      930         buf2_rule-script.rule_id = v-for-script-rule-id
      931         buf2_rule-script.root_rule_id = buf2_rule.rule_id
      932         .
      933         if buf1_rule-script.language = "ABL" then do:
      934           for each buf1_rule-i-script where
      935                   buf1_rule-i-script.root_rule_id = buf1_rule.rule_id
      936               and buf1_rule-i-script.script_id = buf1_rule-script.script_id
      937           on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      938           :
      939             create buf2_rule-i-script.
      940             buffer-copy buf1_rule-i-script
      941             except script_id root_rule_id
      942             to buf2_rule-i-script
      943             assign
      944             buf2_rule-i-script.script_id = buf2_rule-script.script_id
      945             buf2_rule-i-script.root_rule_id = buf2_rule.rule_id
      946             .
      947           end.
      948         end.
      949         find first buf1r_rule-script where
      950                   buf1r_rule-script.script_id = buf1_rule-script.script_id
      951               and buf1r_rule-script.language = "RUS" no-error .
      952         if available buf1r_rule-script then do:
      953           create buf2r_rule-script.
      954           buffer-copy buf1r_rule-script
      955           except rule_id root_rule_id script_id
      956           to buf2r_rule-script
      957           assign
      958           buf2r_rule-script.script_id = buf2_rule-script.script_id
      959           buf2r_rule-script.rule_id =  buf2_rule-script.rule_id
      960           buf2r_rule-script.root_rule_id = buf2_rule.rule_id
      961           .
      962         end.
      963       end.
      964     end.
      965     find first buf1_ruledict no-lock where
      966             buf1_ruledict.entry-type = 'rule':U
      967         and buf1_ruledict.uniq-key-rec = buf1_rule.uniq-key-rec .
      968     assign
      969     v1-entry-id = buf1_ruledict.entry-id.
      970     run gen-key-rec in this-procedure ( input 'rule':U
      971                                         ,input buffer buf2_rule:handle
      972                                         ,output v-uniq-key-rec).
      973     assign
      974     buf2_rule.uniq-key-rec = v-uniq-key-rec
      975     .
      976     find first buf2_ruledict where
      977               buf2_ruledict.entry-type = 'rule':U
      978           and buf2_ruledict.uniq-key-rec =  v-uniq-key-rec no-error.
      979     if not available buf2_ruledict then do:
      980       find last last_ruledict no-lock use-index pi.
      981       create buf2_ruledict.
      982       assign
      983       buf2_ruledict.entry-type = 'rule':U
      984       buf2_ruledict.uniq-key-rec = v-uniq-key-rec
      985       buf2_ruledict.entry-id = last_ruledict.entry-id + 1
      986       buf2_ruledict.language = "ABL"
      987       v2-entry-id = buf2_ruledict.entry-id
      988       .
      989     end.
      990     for each buf1_ruledict-param where
      991             buf1_ruledict-param.entry-id = v1-entry-id
      992         on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      993         :
      994       create buf2_ruledict-param.
      995       buffer-copy buf1_ruledict-param
      996       except entry-id
      997       to buf2_ruledict-param
      998       assign
      999       buf2_ruledict-param.entry-id = v2-entry-id
     1000       .
     1001     end.
     1002     p-rule-id2 = buf2_rule.rule_id.
     1003   end.
     1004   run waitfram-hide in this-procedure .
