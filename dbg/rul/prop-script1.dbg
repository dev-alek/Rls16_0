        1   block-level on error undo, throw.
        2   define input parameter        p-mode as character no-undo .
        3   define input parameter        p-silent as logical no-undo .
        4   define input-output parameter p-rec  as recid     no-undo .
        5   define input parameter        p-dtm-code as integer no-undo .
        6   define input parameter        p-language as character no-undo .
        7   define input parameter        p-script-name   as character no-undo .
        8   define input parameter        p-revis-id as integer no-undo .
        9   define input parameter        p-script-label as character no-undo .
       10   define input parameter        p-class-dtm-code as integer no-undo .
       11   define input parameter        p-documentation as character no-undo .
       12   define input parameter        p-proc-type as character no-undo .
       13   define input parameter        p-script-type as character no-undo .
       14   define input parameter        p-script-value-type as character no-undo .
       15   define input parameter        p-script-head as character no-undo .
       16   define input parameter        p-script-body as character no-undo .
       17   define input parameter        p-script-foot as character no-undo .
       18   define input parameter        p-signature as character no-undo .
       19   define input parameter        p-hidden_  as logical no-undo .
       20   define variable vss-revision    as character no-undo init "$Revision$":U .
       21   define variable vss-author      as character no-undo init "$Author$":U .
       22   define variable vss-date        as character no-undo init "$Date$":U .
       23   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       24   define variable vss-archive     as character no-undo init "$Archive$":U .
       25   define variable vss-description as character no-undo init "Сохранение prop-script".
       26   procedure vss-get-info :
       27     define output parameter p-vss-revision    like vss-revision    no-undo .
       28     define output parameter p-vss-author      like vss-author      no-undo .
       29     define output parameter p-vss-date        like vss-date        no-undo .
       30     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       31     define output parameter p-vss-archive     like vss-archive     no-undo .
       32     define output parameter p-vss-description like vss-description no-undo .
       33     assign
       34       p-vss-revision    = vss-revision
       35       p-vss-author      = vss-author
       36       p-vss-date        = vss-date
       37       p-vss-workfile    = vss-workfile
       38       p-vss-archive     = vss-archive
       39       p-vss-description = vss-description
       40     .
       41   end procedure.
       42   procedure vss-get-parameters :
       43     define output parameter p-vss-parameters as character no-undo .
       44   end procedure.
       45   define new global shared variable g#vssrevis-logger as handle    no-undo .
       46   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       47   define variable v-vssrevis-logger                   as handle    no-undo .
       48   procedure vss-logevent :
       49     define input  parameter p-extra-paramters as character no-undo .
       50     define variable v-vssrevis-parameters as character no-undo .
       51     do
       52     on error undo, return error return-value
       53     :
       54       if  valid-handle(v-vssrevis-logger)
       55       and v-vssrevis-logger :get-signature("logevent") <> ""
       56       then do:
       57         run vss-get-parameters in this-procedure
       58           (output v-vssrevis-parameters
       59           ).
       60         run logevent in v-vssrevis-logger
       61           (input vss-workfile
       62           ,input vss-revision
       63           ,input v-vssrevis-parameters
       64           ,input p-extra-paramters
       65           ).
       66       end.
       67     end.
       68   end procedure.
       69   assign
       70     v-vssrevis-logger = g#vssrevis-logger
       71   .
       72   if  valid-handle(v-vssrevis-logger)
       73   and v-vssrevis-logger :get-signature("logevent") <> ""
       74   then do:
       75     assign
       76       v-vssrevis-logevent = true
       77     .
       78     run vss-logevent in this-procedure (input vss-description) .
       79   end.
       80   define new global shared variable g#language as character no-undo .
       81   if g#language <> '' and g#language <> 'rus':U then do:
       82     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       83   end.
       84   define new global shared variable g#library  as handle no-undo .
       85   define new global shared variable g#library2 as handle no-undo .
       86   define   shared variable g#auto as logical no-undo.
       87   define   shared variable g#news as logical no-undo.
       88   define   shared variable g#oxml as logical no-undo.
       89   define   shared variable g#esys as logical no-undo.
       90   define   shared variable g#news-source-db as integer no-undo.
       91   define   shared variable g#esys-source-esys as integer no-undo.
       92   define   shared variable g#db-num as integer   no-undo .
       93   define   shared variable g#userid as character no-undo .
       94   define   shared variable g#passwd as character no-undo .
       95   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       96   procedure signalib_fill-signature :
       97   define input parameter p-script-name as character no-undo .
       98   define input parameter p-script-head as character no-undo .
       99   define input parameter p-proc-type as character no-undo .
      100   DEFINE OUTPUT PARAMETER p-signature AS CHARACTER NO-UNDO.
      101   define variable v-ii as integer no-undo .
      102   define variable v-signature as character no-undo .
      103   define variable v-params as character no-undo .
      104   define variable v-entry as character no-undo .
      105   do
      106   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      107   :
      108     CASE p-proc-type:
      109       when 'class':U then do:
      110         p-signature = substitute("CLASS,,,,").
      111       end.
      112       when 'constructor':U then do:
      113         p-signature = substitute("CONSTRUCTOR,PUBLIC,,,void,").
      114       end.
      115       when 'destructor':U then do:
      116         p-signature = substitute("DESTRUCTOR,PUBLIC,,,void").
      117       end.
      118       when 'data-member':U then do:
      119         p-signature = substitute("DATA-MEMBER,PUBLIC," ).
      120       end.
      121       when 'property':U then do:
      122         p-signature = substitute("PROPERTY,PUBLIC,,").
      123       end.
      124       when 'method':U then do:
      125         assign
      126         p-signature = entry(1, p-script-head, "(")
      127         p-signature = replace(p-signature, chr(32) + chr(32) , chr(32) )
      128         p-signature = 'method':U + chr(44) + entry(2, p-signature, chr(32)) +
      129                                                chr(44) + entry(3, p-signature, chr(32)) +
      130                                                chr(44) + (if num-entries(p-signature, chr(32)) > 4
      131                                                                 then  entry(5, p-signature, chr(32))
      132                                                                 else '':U) +
      133                                                chr(44) + (if num-entries(p-signature, chr(32)) > 5
      134                                                                 then  entry(6, p-signature, chr(32))
      135                                                                 else '':U)
      136         .
      137         assign
      138         v-params = trim(entry(2, p-script-head , "(":U), ")") no-error
      139         .
      140         ASSIGN
      141         v-params = REPLACE(v-params, ")", "":U)
      142         v-params = REPLACE(v-params, ":", "":U)
      143         .
      144         if v-params <> '':U then do:
      145           do v-ii = 1 to num-entries(v-params):
      146               assign
      147               v-entry = trim(entry(v-ii, v-params), chr(32) )
      148               v-entry =  replace(v-entry, " as ", chr(32))
      149               v-entry =  replace(v-entry, "ub.", chr(32))
      150               v-entry =  replace(v-entry, " for ", "")
      151               v-entry = replace (v-entry, chr(32) + chr(32) , chr(32) )
      152               p-signature = p-signature + chr(44) + v-entry.
      153           end.
      154         end.
      155         else do:
      156           p-signature = p-signature + chr(44).
      157         end.
      158       end.
      159       when 'function':U then do:
      160         assign
      161         p-signature = entry(1, p-script-head, "(")
      162         p-signature = replace(p-signature, chr(32) + chr(32) , chr(32) )
      163         p-signature = replace(p-signature, "returns", "":U )
      164         p-signature = replace(p-signature, chr(32) + chr(32) , chr(32) )
      165         p-signature = 'function':U + chr(44) + entry(3, p-signature, chr(32))
      166         p-signature = trim(p-signature, ':')
      167         .
      168         assign
      169         v-params = trim(entry(2, p-script-head , "(":U), ")") no-error
      170         .
      171         ASSIGN
      172         v-params = REPLACE(v-params, ")", "":U)
      173         v-params = REPLACE(v-params, ":", "":U)
      174         .
      175         if v-params <> '':U then do:
      176           do v-ii = 1 to num-entries(v-params):
      177               assign
      178               v-entry = trim(entry(v-ii, v-params), chr(32) )
      179               v-entry =  replace(v-entry, " as ", chr(32))
      180               v-entry =  replace(v-entry, "ub.", chr(32))
      181               v-entry =  replace(v-entry, " for ", "")
      182               v-entry = replace (v-entry, chr(32) + chr(32) , chr(32) )
      183               p-signature = p-signature + chr(44) + v-entry.
      184           end.
      185         end.
      186         else do:
      187           p-signature = p-signature + chr(44).
      188         end.
      189       end.
      190     END CASE.
      191   end.
      192   end procedure.
      193   FUNCTION signalib_get-params-from-signa returns character ( input p-proc-type as character
      194                                                              ,input p-signature-string as character):
      195   define variable v-param-string as character no-undo .
      196   v-param-string = p-signature-string.
      197   case p-proc-type:
      198     when 'function':U
      199     or
      200     when 'procedure':U then do:
      201       entry(1, v-param-string) = '':U.
      202       if num-entries(v-param-string) > 1 then
      203       entry(2, v-param-string) = '':U.
      204       v-param-string = left-trim( v-param-string, chr(44)).
      205     end.
      206     when 'method':U
      207     or when 'constructor':U
      208     then do:
      209       entry(1, v-param-string) = '':U.
      210       entry(2, v-param-string) = '':U.
      211       entry(3, v-param-string) = '':U.
      212       entry(4, v-param-string) = '':U.
      213       entry(5, v-param-string) = '':U.
      214       v-param-string = left-trim( v-param-string, chr(44)).
      215     end.
      216     otherwise do:
      217       v-param-string = '':U.
      218     end.
      219   end case.
      220   return v-param-string.
      221   end function.
      222   procedure signalib_write-rdp :
      223   define input parameter p-entry-id as integer no-undo .
      224   define input parameter p-language as character no-undo .
      225   define input parameter p-signature-param as character no-undo .
      226   define variable v-ii as integer no-undo .
      227   define buffer buf_ruledict-param for ub.ruledict-param.
      228   do
      229   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      230   :
      231     for each buf_ruledict-param where
      232             buf_ruledict-param.entry-id = p-entry-id
      233         and buf_ruledict-param.language = p-language
      234     on error undo, return error:
      235         delete buf_ruledict-param.
      236     end.
      237     do v-ii = 1 to num-entries(p-signature-param):
      238       create buf_ruledict-param.
      239       assign
      240       buf_ruledict-param.entry-id = p-entry-id
      241       buf_ruledict-param.language = 'ABL':U
      242       buf_ruledict-param.param-num = v-ii
      243       buf_ruledict-param.param-mode = entry(1, entry(v-ii, p-signature-param), chr(32) )
      244       buf_ruledict-param.param-name = entry(2, entry(v-ii, p-signature-param), chr(32) )
      245       buf_ruledict-param.param-data-type = entry(3, entry(v-ii, p-signature-param), chr(32) )
      246       .
      247     end.
      248   end.
      249   end procedure.
      250   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      251   procedure gen-key-rec :
      252     define input  parameter p-tbl-name    as character no-undo.
      253     define input  parameter p-bh_tbl-name as handle    no-undo.
      254     define output parameter p-key-rec     as character no-undo.
      255     do
      256     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      257     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      258     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      259     :
      260       define variable fh               as handle    no-undo .
      261       define variable v-ok             as logical   no-undo .
      262       define variable v-inform         as character no-undo .
      263       define variable v-ind            as integer   no-undo .
      264       define variable v-idx-field-qnty as integer   no-undo .
      265       if p-tbl-name = ?
      266         or p-tbl-name = "":U
      267       then do:
      268         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info1 ).
      269       end.
      270       if not p-bh_tbl-name:available then do:
      271         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info1, p-tbl-name ).
      272       end.
      273       assign
      274         p-key-rec = p-tbl-name
      275         v-inform  = p-bh_tbl-name:index-information(1)
      276         v-ind     = 2
      277       .
      278       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      279       on error undo, return error
      280       :
      281         assign
      282           v-inform = p-bh_tbl-name:index-information( v-ind )
      283           v-ind    = v-ind + 1
      284         .
      285       end.
      286       if v-inform = ?
      287         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      288         or entry( 3, v-inform, ",":U ) <> "1":U
      289       then do:
      290         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, p-tbl-name ).
      291       end.
      292       else do:
      293         assign
      294           v-idx-field-qnty = num-entries( v-inform ) - 4
      295         .
      296         if v-idx-field-qnty < 2 then do:
      297           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, p-tbl-name ).
      298         end.
      299         do v-ind = 1 to v-idx-field-qnty by 2
      300         on error undo, return error
      301         :
      302           assign
      303             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      304             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      305           .
      306         end.
      307       end.
      308       if p-key-rec = ? then do:
      309         assign
      310           p-key-rec = "":U
      311         .
      312         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info1, p-tbl-name ).
      313       end.
      314     end.
      315     return.
      316   end procedure.
      317   procedure gen-where-keyr-tab :
      318     define input  parameter i-tableSerach as character no-undo.
      319     define input  parameter i-tablekey   as character  no-undo.
      320     define input  parameter p-key-rec    as character  no-undo.
      321     define input  parameter p-key-handle as handle     no-undo .
      322     define input  parameter p-db-name    as character  no-undo .
      323     define input  parameter p-tt-handle  as handle     no-undo .
      324     define output parameter o-Where      as character  no-undo.
      325     do
      326     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      327     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      328     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      329     :
      330       define variable v-full-tbl-name  as character no-undo .
      331       define variable bh_tbl-name      as handle    no-undo .
      332       define variable fh_key           as handle    no-undo .
      333       define variable fh_search        as handle    no-undo .
      334       define variable v-field-num      as integer   no-undo .
      335       define variable v-count-fld      as integer   no-undo .
      336       define variable v-inform         as character no-undo .
      337       define variable v-ind            as integer   no-undo .
      338       define variable v-idx-field-qnty as integer   no-undo .
      339       define variable v-field-name     as character no-undo .
      340       define variable v-field-val      as character no-undo .
      341       define variable v-word-link      as character no-undo .
      342       define variable vTable           as character no-undo.
      343       define variable bh_tbl-key       as handle    no-undo .
      344       assign
      345         p-key-rec = trim( p-key-rec )
      346       .
      347       if p-key-handle <> ? then do:
      348         if not valid-handle(p-key-handle)
      349            or p-key-handle:type <> "buffer"
      350         then do:
      351           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info1 ).
      352         end.
      353         if num-entries( p-key-rec, chr(3) ) > 1
      354           or p-key-rec = ?
      355           or p-key-rec = "":U
      356         then do:
      357           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info1, p-key-rec ).
      358         end.
      359       end.
      360       else do:
      361         if p-key-rec = ?
      362           or p-key-rec = "":U
      363         then do:
      364           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      365         end.
      366       end.
      367       assign
      368         vTable = entry( 1 , p-key-rec, chr(3) )
      369       .
      370       if p-tt-handle <> ?
      371         and ( not valid-handle(p-tt-handle)
      372               or p-tt-handle:type <> "buffer"
      373             )
      374       then do:
      375         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info1, vTable, chr(10) ).
      376       end.
      377       if p-tt-handle = ? then do:
      378         assign
      379           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      380         .
      381         create buffer bh_tbl-name for table v-full-tbl-name .
      382       end.
      383       else do:
      384         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      385       end.
      386       assign
      387         v-inform = bh_tbl-name:index-information(1)
      388         v-ind    = 2
      389       .
      390       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      391       on error undo, return error
      392       :
      393         assign
      394           v-inform = bh_tbl-name:index-information( v-ind )
      395           v-ind    = v-ind + 1
      396         .
      397       end.
      398       if v-inform = ?
      399         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      400         or entry( 3, v-inform, ",":U ) <> "1":U
      401       then do:
      402         delete object bh_tbl-name no-error.
      403         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info1, vTable ).
      404       end.
      405       assign
      406         v-idx-field-qnty = num-entries( v-inform ) - 4
      407       .
      408       if v-idx-field-qnty < 2 then do:
      409         delete object bh_tbl-name no-error.
      410         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, vTable ).
      411       end.
      412       assign
      413         o-where     = "where":U
      414         v-word-link = "":U
      415         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      416         v-count-fld = 0
      417       .
      418       if i-tablekey ne "" and i-tablekey ne ?
      419       then do:
      420         assign
      421           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      422         .
      423         create buffer bh_tbl-key for table v-full-tbl-name .
      424       end.
      425       if i-tableSerach ne "" and i-tableSerach ne ?
      426       then do:
      427         delete object bh_tbl-name no-error.
      428         assign
      429           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      430         .
      431         create buffer bh_tbl-name for table v-full-tbl-name .
      432       end.
      433       block_where:
      434       do v-ind = 1 to v-idx-field-qnty by 2
      435       on error undo, return error
      436       :
      437         assign
      438           v-count-fld = v-count-fld + 1
      439         .
      440         if p-key-handle = ?
      441           and v-count-fld > v-field-num
      442         then do:
      443           leave block_where.
      444         end.
      445         define variable VfieldKeyTable as handle no-undo.
      446         assign
      447           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      448           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      449         .
      450         if     bh_tbl-key ne ?
      451         then do:
      452            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      453            if VfieldKeyTable eq ?
      454            then next block_where.
      455         end.
      456         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      457         then
      458            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      459         else
      460            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      461         if p-key-handle = ? then do:
      462           assign
      463             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      464           .
      465         end.
      466         else do:
      467           assign
      468             fh_key = p-key-handle:buffer-field( v-field-name )
      469           .
      470           if fh_key = ?
      471             or not valid-handle( fh_key )
      472           then do:
      473             delete object bh_tbl-name.
      474             if     bh_tbl-key ne ?
      475             then
      476                delete object bh_tbl-key.
      477             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info1, p-key-handle:name, v-field-name ).
      478           end.
      479           assign
      480             v-field-val = fh_key:buffer-value
      481           .
      482         end.
      483         if fh_search:data-type ="character":U then do:
      484           assign
      485             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      486             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      487             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      488             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      489             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      490             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      491             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      492             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      493             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      494             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      495             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      496             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      497             v-field-val = substitute( '"&1"', v-field-val )
      498           .
      499         end.
      500         assign
      501           o-where = substitute( "&1 &2", o-where, v-field-val )
      502         .
      503         if v-word-link = "":U then do:
      504           assign
      505             v-word-link = "and":U
      506           .
      507         end.
      508       end.
      509       delete object bh_tbl-name.
      510       if     bh_tbl-key ne ?
      511       then
      512          delete object bh_tbl-key.
      513       if p-key-handle = ?
      514         and v-count-fld <> v-field-num
      515       then do:
      516         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info1, vTable ).
      517       end.
      518     end.
      519   end procedure.
      520   procedure gen-hn-keyr-tab :
      521     define input  parameter i-tableSerach as character no-undo.
      522     define input  parameter i-tablekey   as character no-undo.
      523     define input  parameter p-key-rec    as character no-undo.
      524     define input  parameter p-key-handle as handle    no-undo .
      525     define input  parameter p-db-name    as character no-undo .
      526     define input  parameter p-tt-handle  as handle    no-undo .
      527     define input  parameter p-stts-lock  as integer   no-undo .
      528     define output parameter o-hn         as handle    no-undo.
      529     define variable v-full-tbl-name as character no-undo.
      530     define variable v-where         as character no-undo.
      531     define variable bh_tbl-name     as handle    no-undo.
      532     define variable vTable          as character no-undo.
      533     do
      534     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      535     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      536     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      537         run gen-where-keyr-tab(i-tableSerach,
      538                                i-tablekey,
      539                                p-key-rec,
      540                                p-key-handle,
      541                                p-db-name,
      542                                p-tt-handle,
      543                                output v-where).
      544         if i-tableSerach ne "" and i-tableSerach ne ?
      545         then do:
      546            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      547            create buffer bh_tbl-name for table v-full-tbl-name .
      548         end.
      549         else do:
      550            if p-tt-handle = ? then do:
      551               assign
      552                  vTable = entry( 1 , p-key-rec, chr(3) )
      553               .
      554               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      555               create buffer bh_tbl-name for table v-full-tbl-name .
      556            end.
      557            else do:
      558               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      559            end.
      560         end.
      561         if p-tt-handle = ? then do:
      562            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      563         end.
      564         else do:
      565            bh_tbl-name:find-first( v-where ) no-error .
      566         end.
      567         o-hn = bh_tbl-name.
      568      end.
      569   end procedure.
      570   procedure gen-hn-keyr :
      571     define input  parameter p-key-rec    as character no-undo.
      572     define input  parameter p-key-handle as handle    no-undo .
      573     define input  parameter p-db-name    as character no-undo .
      574     define input  parameter p-tt-handle  as handle    no-undo .
      575     define input  parameter p-stts-lock  as integer   no-undo .
      576     define output parameter o-hn         as handle    no-undo.
      577     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      578   end.
      579   procedure gen-row-keyr :
      580     define input  parameter p-key-rec    as character no-undo.
      581     define input  parameter p-key-handle as handle    no-undo .
      582     define input  parameter p-db-name    as character no-undo .
      583     define input  parameter p-tt-handle  as handle    no-undo .
      584     define input  parameter p-stts-lock  as integer   no-undo .
      585     define output parameter p-tbl-row    as rowid     no-undo.
      586     define output parameter p-tbl-name   as character no-undo.
      587     define variable vHn as handle no-undo.
      588       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      589       p-tbl-row = if vHn:available then vHn:rowid else ?.
      590       p-tbl-name =  vHn:table.
      591       delete object vHn no-error.
      592     if p-tbl-row = ? then do:
      593       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info1, p-tbl-name, p-key-rec ).
      594     end.
      595     else do:
      596       return.
      597     end.
      598   end procedure.
      599   procedure gen-key-fv :
      600     define input  parameter p-key-rec    as character no-undo .
      601     define output parameter p-field-list as character no-undo .
      602     define output parameter p-value-list as character no-undo.
      603     do
      604     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      605     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      606     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      607     :
      608       define variable v-full-tbl-name  as character no-undo .
      609       define variable bh_tbl-name      as handle    no-undo .
      610       define variable v-tbl-name       as character no-undo .
      611       define variable v-field-num      as integer   no-undo .
      612       define variable v-count-fld      as integer   no-undo .
      613       define variable v-inform         as character no-undo .
      614       define variable v-ind            as integer   no-undo .
      615       define variable v-idx-field-qnty as integer   no-undo .
      616       define variable v-delim-key      as character no-undo .
      617       if p-key-rec = ?
      618         or p-key-rec = "":U
      619       then do:
      620         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      621       end.
      622       assign
      623         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      624         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      625       .
      626       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      627       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info1 ).
      628       assign
      629         v-inform = bh_tbl-name:index-information(1)
      630         v-ind    = 2
      631       .
      632       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      633       on error undo, return error
      634       :
      635         assign
      636           v-inform = bh_tbl-name:index-information( v-ind )
      637           v-ind    = v-ind + 1
      638         .
      639       end.
      640       if v-inform = ?
      641         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      642         or entry( 3, v-inform, ",":U ) <> "1":U
      643       then do:
      644         delete object bh_tbl-name no-error.
      645         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      646       end.
      647       assign
      648         v-idx-field-qnty = num-entries( v-inform ) - 4
      649       .
      650       if v-idx-field-qnty < 2 then do:
      651         delete object bh_tbl-name no-error.
      652         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      653       end.
      654       assign
      655         p-field-list = "":U
      656         p-value-list = "":U
      657         v-delim-key  = "":U
      658         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      659         v-count-fld  = 0
      660       .
      661       block_where:
      662       do v-ind = 1 to v-idx-field-qnty by 2
      663       on error undo, return error
      664       :
      665         assign
      666           v-count-fld = v-count-fld + 1
      667         .
      668         if v-count-fld > v-field-num then do:
      669           leave block_where.
      670         end.
      671         assign
      672           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      673           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      674         .
      675         if v-ind = 1 then do:
      676           assign
      677             v-delim-key = chr(3)
      678           .
      679         end.
      680       end.
      681       delete object bh_tbl-name.
      682       if v-count-fld <> v-field-num then do:
      683         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info1, v-tbl-name ).
      684       end.
      685     end.
      686   end procedure.
      687   procedure gen-key-field :
      688     define input  parameter p-table      as character no-undo .
      689     define output parameter p-field-list as character no-undo .
      690     do
      691     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      692     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      693     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      694     :
      695       define variable v-full-tbl-name  as character no-undo .
      696       define variable bh_tbl-name      as handle    no-undo .
      697       define variable v-tbl-name       as character no-undo .
      698       define variable v-field-num      as integer   no-undo .
      699       define variable v-count-fld      as integer   no-undo .
      700       define variable v-inform         as character no-undo .
      701       define variable v-ind            as integer   no-undo .
      702       define variable v-idx-field-qnty as integer   no-undo .
      703       define variable v-delim-key      as character no-undo .
      704       if p-table = ?
      705         or p-table = "":U
      706       then do:
      707         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info1 ).
      708       end.
      709       assign
      710         v-tbl-name      = p-table
      711         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      712       .
      713       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      714       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info1 ).
      715       assign
      716         v-inform = bh_tbl-name:index-information(1)
      717         v-ind    = 2
      718       .
      719       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      720       on error undo, return error
      721       :
      722         assign
      723           v-inform = bh_tbl-name:index-information( v-ind )
      724           v-ind    = v-ind + 1
      725         .
      726       end.
      727       if v-inform = ?
      728         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      729         or entry( 3, v-inform, ",":U ) <> "1":U
      730       then do:
      731         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      732       end.
      733       assign
      734         v-idx-field-qnty = num-entries( v-inform ) - 4
      735       .
      736       if v-idx-field-qnty < 2 then do:
      737         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      738       end.
      739       assign
      740         p-field-list = "":U
      741         v-delim-key  = "":U
      742         v-count-fld  = 0
      743       .
      744       block_where:
      745       do v-ind = 1 to v-idx-field-qnty by 2
      746       on error undo, return error
      747       :
      748         assign
      749           v-count-fld = v-count-fld + 1
      750         .
      751         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      752         if v-ind = 1 then do:
      753           assign
      754             v-delim-key = chr(3)
      755           .
      756         end.
      757       end.
      758       delete object bh_tbl-name.
      759     end.
      760   end procedure.
      761   define variable v-mess as character no-undo .
      762   define variable v-entry as character no-undo .
      763   define variable v-param-string as character no-undo .
      764   define variable v-signature as character no-undo .
      765   define variable v-signature0 as character no-undo .
      766   define variable v-region-nl as character no-undo .
      767   define variable v-script-label as character no-undo .
      768   define variable v-uniq-key-rec as character no-undo .
      769   define variable v-revis-id as integer no-undo .
      770   define variable glog as logical no-undo .
      771   define buffer buf_prop-head  for ub.prop-head.
      772   define buffer buf2_prop-head  for ub.prop-head.
      773   define buffer buf_prop-script for ub.prop-script.
      774   define buffer last_ruledict for ub.ruledict.
      775   define buffer first_ruledict for ub.ruledict.
      776   define buffer buf_ruledict for ub.ruledict.
      777   define buffer last_prop-script for ub.prop-script.
      778   define buffer buf_rule-i-script for ub.rule-i-script.
      779   if p-mode <> 'ДОБАВЛЕНИЕ':U
      780   AND p-mode <> 'ИЗМЕНЕНИЕ':U then do:
      781     message vss-workfile vss-revision vss-description skip
      782             "Неверный параметр p-mode - " p-mode
      783     view-as alert-box error .
      784     return error '':u.
      785   end.
      786   if g#db-num <> 0 then do:
      787     message vss-workfile vss-revision vss-description skip
      788             "Запрещено вызывать процедуру в УБД"
      789     view-as alert-box error .
      790     return error '':u.
      791   end.
      792   _main:
      793   do for buf_prop-script
      794   on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      795   on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
      796   on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
      797   :
      798     v-revis-id = p-revis-id.
      799     if p-language = '':U
      800     or p-script-name = '':U then do:
      801       assign
      802       v-mess = "Не задан язык и/или имя скрипта".
      803       run err-mess in this-procedure ( input-output v-mess).
      804       return error (if p-silent = yes then v-mess else '':U).
      805     end.
      806     if lookup(p-proc-type, 'procedure,function,extern,dll-entry,main,class,data-member,property,method,constructor,destructor':u) = 0
      807     and p-proc-type <> '':U
      808     then do:
      809       assign
      810       v-mess = substitute("Неверное значение типа процедуры: &1", p-proc-type).
      811       run err-mess in this-procedure ( input-output v-mess).
      812       return error (if p-silent = yes then v-mess else 'proc-type':U).
      813     end.
      814     if lookup(p-script-type, 'set,get,get-ifunction,get-set,find,define_b,define_tt,define_h,create,function,ifunction,variable':u) = 0
      815     and p-script-type <> '':U
      816     then do:
      817       assign
      818       v-mess = substitute("Неверное значение типа скрипта: &1", p-script-type).
      819       run err-mess in this-procedure ( input-output v-mess).
      820       return error (if p-silent = yes then v-mess else 'script-type':U).
      821     end.
      822     if lookup(entry(1, p-script-value-type), 'character,date,decimal,integer,logical':U + chr(44) +
      823                                              'void':U + chr(44) +
      824                                              'handle':U
      825                                              ) = 0
      826     and p-proc-type <> '':U
      827     then do:
      828       assign
      829       v-mess = substitute("Неверное значение типа возвращаемых данных для скрипта: &1", p-script-value-type).
      830       run err-mess in this-procedure ( input-output v-mess).
      831       return error (if p-silent = yes then v-mess else 'script-value-type':U).
      832     end.
      833     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      834       find first buf_prop-script no-lock where
      835                 buf_prop-script.dtm-code = p-dtm-code
      836             and buf_prop-script.language = p-language
      837             and buf_prop-script.script-name = p-script-name
      838             and buf_prop-script.revis_id = p-revis-id no-error.
      839       if available buf_prop-script then do:
      840         assign
      841         v-mess = "Уже существует prop-script с таким именем для такого объекта, языка, Версии".
      842         run err-mess in this-procedure ( input-output v-mess).
      843         return error (if p-silent = yes then v-mess else '':U).
      844       end.
      845       if p-dtm-code <> 0 then do:
      846         find first buf_prop-head no-lock where
      847                   buf_prop-head.dtm-code = p-dtm-code no-error.
      848         if not available buf_prop-head then do:
      849           assign
      850           v-mess = substitute("Не существует Объект-операнд &1", p-dtm-code).
      851           run err-mess in this-procedure ( input-output v-mess).
      852           return error (if p-silent = yes then v-mess else '':U).
      853         end.
      854       end.
      855       create buf_prop-script.
      856       assign
      857       buf_prop-script.dtm-code = p-dtm-code
      858       buf_prop-script.language = p-language
      859       buf_prop-script.script-name = p-script-name
      860       .
      861     end.
      862     if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      863       find first buf_prop-script exclusive-lock where
      864                 recid(buf_prop-script) = p-rec .
      865       if buf_prop-script.dtm-code <> p-dtm-code
      866       or buf_prop-script.language <> p-language
      867       or buf_prop-script.script-name <> p-script-name
      868       or buf_prop-script.revis_id <> p-revis-id
      869       then do:
      870         assign
      871         v-mess = substitute("Для уже существующего prop-script невозможно изменение Объекта, Языка, имени, версии&1" +
      872                                 "старые значения объекта, языка, имени и версии: &2, &3, &4 &5"
      873                                 , chr(10)
      874                                 , buf_prop-script.dtm-code
      875                                 , buf_prop-script.language
      876                                 , buf_prop-script.script-name
      877                                 )
      878         .
      879         run err-mess in this-procedure ( input-output v-mess).
      880         return error (if p-silent = yes then v-mess else '':U).
      881       end.
      882       if p-class-dtm-code <> p-dtm-code then do:
      883         find first buf2_prop-head no-lock where
      884                   buf2_prop-head.dtm-code = p-class-dtm-code no-error.
      885         if not available buf2_prop-head then do:
      886           assign
      887           v-mess = substitute("Не существует Объект-операнд обслуживающего класса &1", p-class-dtm-code).
      888           run err-mess in this-procedure ( input-output v-mess).
      889           return error (if p-silent = yes then v-mess else '':U).
      890         end.
      891       end.
      892       find first buf_rule-i-script no-lock where
      893                 buf_rule-i-script.dtm-code = p-dtm-code
      894            and  buf_rule-i-script.class-dtm-code = p-class-dtm-code
      895            and  buf_rule-i-script.script-name = p-script-name
      896            and  buf_rule-i-script.script-type = p-script-type
      897            and  buf_rule-i-script.revis_id = p-revis-id no-error.
      898       if available buf_rule-i-script then do:
      899         if not p-silent then do:
      900            message
      901            "Скрипт данной версии входит в правила" skip
      902            "Хотите создать скрипт новой версии?"
      903            view-as alert-box question buttons YES-NO update glog.
      904         end.
      905         else do:
      906           glog = yes.
      907         end.
      908         if not glog then do:
      909           return.
      910         end.
      911         find last last_prop-script no-lock where
      912                 last_prop-script.dtm-code = p-dtm-code
      913             and last_prop-script.language = p-language
      914             and last_prop-script.script-name = p-script-name no-error.
      915         if available last_prop-script then do:
      916           v-revis-id =  last_prop-script.revis_id + 1.
      917         end.
      918         else do:
      919           v-revis-id =  0.
      920         end.
      921       end.
      922     end.
      923     if p-proc-type <> '':U then do:
      924       if (p-signature begins "@") then do:
      925         assign
      926         v-signature = left-trim(p-signature, "@")
      927         v-signature0 = p-signature
      928         .
      929       end.
      930       else do:
      931         run signalib_fill-signature in this-procedure ( input p-script-name
      932                                             ,input p-script-head
      933                                             ,input p-proc-type
      934                                             ,output v-signature) no-error.
      935         if error-status:error then do:
      936           assign
      937           v-mess = substitute("Ошибки при заполнении сигнатуры&1&2&1&3"
      938                              , chr(10)
      939                              , error-status:get-message(1)
      940                              , return-value
      941                              ).
      942           run err-mess in this-procedure ( input-output v-mess).
      943           return error (if p-silent = yes then v-mess else '':U).
      944         end.
      945         v-signature0 = v-signature.
      946       end.
      947     end.
      948     if p-script-label = '':U then do:
      949       if p-dtm-code > 0
      950       then do:
      951         find first buf_prop-head no-lock where
      952                   buf_prop-head.dtm-code = p-dtm-code .
      953         if index(p-script-name, "_host@") > 0
      954         or index(p-script-name, "_host@#") > 0
      955         or r-index(p-script-name, "_host") = length(entry(1, p-script-name, "(")) - 4 then do:
      956           v-region-nl = "_Фирма".
      957         end.
      958         if index(p-script-name, "_obj@") > 0
      959         or index(p-script-name, "_obj@#") > 0
      960         or r-index(p-script-name, "_obj") = length(entry(1, p-script-name, "(")) - 3 then do:
      961           v-region-nl = "_Объект".
      962         end.
      963         if index(p-script-name, "_@") > 0
      964         or index(p-script-name, "_@#") > 0
      965         or r-index(p-script-name, "_") = length(entry(1, p-script-name, "(")) then do:
      966           v-region-nl = "_".
      967         end.
      968         if index(p-script-name, "@":U) > 0 then do:
      969           v-script-label = buf_prop-head.prop-label + v-region-nl + '.':U + p-script-label.
      970         end.
      971         else do:
      972           v-script-label = buf_prop-head.prop-label + v-region-nl.
      973         end.
      974       end.
      975       else do:
      976         v-script-label = p-script-label.
      977       end.
      978       if p-script-type = 'set':U
      979       then do:
      980         assign
      981         v-script-label = substitute ('&1 = &&1', v-script-label).
      982       end.
      983       if p-script-type = 'create':U then do:
      984         assign
      985         v-script-label = substitute ('&1.Создать', v-script-label).
      986       end.
      987     end.
      988     else do:
      989       v-script-label = p-script-label.
      990     end.
      991     assign
      992     buf_prop-script.class-dtm-code = p-class-dtm-code
      993     buf_prop-script.documentation = p-documentation
      994     buf_prop-script.proc-type     = p-proc-type
      995     buf_prop-script.script-type   = p-script-type
      996     buf_prop-script.script-value-type    = p-script-value-type
      997     buf_prop-script.script-head   = p-script-head
      998     buf_prop-script.script-body   = p-script-body
      999     buf_prop-script.script-foot   = p-script-foot
     1000     buf_prop-script.signature     = v-signature0
     1001     buf_prop-script.revis_id      = v-revis-id
     1002     buf_prop-script.hidden_       = p-hidden_
     1003     p-rec = recid(buf_prop-script)
     1004     .
     1005     run gen-key-rec in this-procedure (
     1006                                         input 'prop-script':U
     1007                                         ,input  buffer buf_prop-script:handle
     1008                                         ,output v-uniq-key-rec
     1009                                         ).
     1010     assign
     1011     buf_prop-script.uniq-key-rec = v-uniq-key-rec
     1012     .
     1013     find first buf_ruledict where
     1014               buf_ruledict.entry-type  = 'prop-script':U
     1015           and buf_ruledict.uniq-key-rec  = v-uniq-key-rec no-error.
     1016     if not available buf_ruledict then do:
     1017       find first first_ruledict exclusive-lock use-index pi.
     1018       find last last_ruledict no-lock use-index pi.
     1019       create buf_ruledict.
     1020       assign
     1021       buf_ruledict.entry-type = 'prop-script':U
     1022       buf_ruledict.uniq-key-rec = v-uniq-key-rec
     1023       buf_ruledict.entry-id = last_ruledict.entry-id + 1
     1024       buf_ruledict.language = "ABL"
     1025       .
     1026     end.
     1027     assign
     1028     buf_ruledict.script-al = p-script-name
     1029     buf_ruledict.script-nl = v-script-label
     1030     .
     1031     assign
     1032     v-param-string = signalib_get-params-from-signa( input p-proc-type, input v-signature).
     1033     if v-param-string <> '':U then do:
     1034       run signalib_write-rdp  in this-procedure ( input buf_ruledict.entry-id
     1035                                       ,input "ABL":U
     1036                                       ,input v-param-string
     1037                                       ) .
     1038     end.
     1039   end.
     1040   PROCEDURE err-mess:
     1041     DEFINE INPUT-OUTPUT PARAMETER p-mess as character No-UNDO.
     1042     CASE p-silent:
     1043       when yes then do:
     1044         assign
     1045         p-mess = substitute("Скрипт: объект-операнд &1 язык: &2: скрипт &3 версия &4:&5&6"
     1046                            , p-dtm-code
     1047                            , p-language
     1048                            , p-script-name
     1049                            , p-revis-id
     1050                            , chr(10)
     1051                            , p-mess)
     1052         .
     1053       end.
     1054       when no then do:
     1055         message
     1056         p-mess
     1057         view-as alert-box error .
     1058       end.
     1059     end.
     1060   END PROCEDURE.
