     2307   procedure proc-main :
     2308   _main:
     2309   do
     2310   on error undo, return error substitute( "&1&2&3&2&4", return-value, chr(10), error-status :get-message (1), v-last-error-message)
     2311   :
     2312     define variable v-ii as integer no-undo .
     2313     define variable v-uniq-key-rec as character no-undo .
     2314     define variable v-cli-uniq-key-rec as character no-undo .
     2315     define variable v-err as logical no-undo .
     2316     define variable v-custom-pack-name as character no-undo .
     2317     define variable v-success as logical   no-undo .
     2318     define variable v-datetimechar as character no-undo .
     2319     define variable v-dump-ord-int64 as int64 no-undo .
     2320     define variable v-status_           as character  no-undo .
     2321     define variable v-flag              as logical    no-undo .
     2322     define variable v-doc-num           as character  no-undo .
     2323     define variable v-dklink-doc-type   as integer    no-undo .
     2324     define variable v-agentid           as integer    no-undo .
     2325     define variable v-ext-doc-type      as character  no-undo .
     2326     define variable v-price-doc-obj-type  as character  no-undo .
     2327     define variable v-price-doc-obj-code  as integer    no-undo .
     2328     define variable v-obj-db-num        as integer    no-undo .
     2329     define variable v-obj-uniq-key-rec  as character  no-undo .
     2330     define variable v-b-code            as integer    no-undo .
     2331     define variable v-main-b-code       as integer    no-undo .
     2332     define variable v-gds-name-full     as character  no-undo .
     2333     define variable v-node-name         as character  no-undo .
     2334     define variable v-agnt-id           as integer    no-undo .
     2335     define variable v-obj-type          as character  no-undo .
     2336     define variable v-obj-code          as integer    no-undo .
     2337     define variable v-tot-rubl          as decimal    no-undo .
     2338     define variable v-ext-num           as character  no-undo .
     2339     define variable v-table-name        as character  no-undo .
     2340     define variable v-cli-type          as character  no-undo .
     2341     define variable v-cli-code          as integer    no-undo .
     2342     define variable v-cli-id            as integer    no-undo .
     2343     define variable v-obj-id            as integer    no-undo .
     2344     define variable v-from-store-id     as integer    no-undo .
     2345     define variable v-to-store-id       as integer    no-undo .
     2346     define variable v-p-date            as datetime-tz  no-undo .
     2347     define variable v-ext-artic         as character  no-undo .
     2348     define buffer buf_clients for ub.clients.
     2349     define buffer buf_ext-classif for ub.ext-classif.
     2350     define buffer buf_trn-doc for ub.trn-doc .
     2351     define buffer buf_gds-dtl for ub.gds-dtl.
     2352     define buffer buf_doc-line for ub.doc-line.
     2353     define buffer buf_gds-prt for ub.gds-prt.
     2354     define buffer buf_goods for ub.goods.
     2355     define buffer buf_ext-artic for ub.ext-artic.
     2356     define buffer buf_ext-system for ub.ext-system.
     2357     define variable expObj as class expsubject no-undo .
     2358     define variable subTank as class tank no-undo .
     2359     if v-has-newbh then do:
     2360       v-doc-num  = v-newbh:buffer-field("pl-code"):buffer-value.
     2361     end.
     2362     else do:
     2363       v-doc-num  = v-oldbh:buffer-field("pl-code"):buffer-value.
     2364     end.
     2365     IF  context_begin-esys-command( input string(v-esys-id-list), input-output v-esys-cmd-proc-handle, output v-esys-cmd-code) = false  THEN do:
     2366       undo _main, return error v-last-error-message .
     2367     end.
     2368     expObj = new expsubject ().
     2369     subTank = new tank ().
     2370     subTank:pl-code = v-doc-num.
     2371     expObj:GetContent(subTank) no-error.
     2372     if error-status:error
     2373     then
     2374        undo _main, return error expObj:Msg.
     2375         IF ExpData1:esys-add-dump-data ( INPUT expObj:Data,
     2376                                          INPUT v-esys-cmd-proc-handle,
     2377                                          INPUT v-esys-cmd-code,
     2378                                          ('+update' + chr(4) + expObj:InitSecTag +
     2379                                           (if expObj:sendTableName <> ""
     2380                                            then substitute("&1&2&3&4",chr(4),
     2381                                                            expObj:sendTableName,
     2382                                                            if expObj:sendOldRowid <> ? then substitute("&1&2",chr(3),expObj:sendOldRowid) else "",
     2383                                                            if expObj:sendNewRowid <> ? then substitute("&1&2",chr(3),expObj:sendNewRowid) else "")
     2384                                            else ""))) = false  THEN do:
     2385           undo _main, return error v-last-error-message .
     2386         end.
     2387         IF  context_set-custom-esys-pck-name(  input v-esys-cmd-proc-handle, input v-esys-cmd-code, input v-custom-pack-name) = false  THEN do:
     2388           undo _main, return error v-last-error-message .
     2389         end.
     2390         v-dump-ord-int64 = context_send-esys-command( input v-esys-id-list
     2391                                     , input v-esys-cmd-proc-handle
     2392                                     , input v-esys-cmd-code
     2393                                     , input g#userid).
     2394         if v-dump-ord-int64 = 0 THEN do:
     2395           undo _main, return error v-last-error-message .
     2396         end.
     2397         num-rec-ok = num-rec-ok + 1.
     2398           ExpData1:Route-data_clear-data ( ) .
     2399   end.
     2400   end procedure.
     2401   procedure load-ruleset-context :
     2402   define input parameter p-ruleset-id as integer    no-undo .
     2403   define variable v-flag              as logical    no-undo .
     2404   define variable v-ii                as integer    no-undo .
     2405   define variable v-changes-list2     as character  no-undo .
     2406   define variable v-obj-db-num        as integer    no-undo .
     2407   define variable v-is-waiting-status as logical    no-undo .
     2408   define variable v-direction         as character  no-undo .
     2409   define variable v-direction-2       as character  no-undo .
     2410   define variable v-waiting-status    as character  no-undo .
     2411   define variable v-ext-doc-type      as character  no-undo .
     2412   define buffer buf_rule-call-param for ub.rule-call-param.
     2413   define buffer buf_ext-system for ub.ext-system.
     2414   define buffer buf_clients for ub.clients.
     2415   do
     2416   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2417   on stop   undo, return error substitute( "&1. stop", vss-workfile )
     2418   on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     2419   :
     2420     assign
     2421       v-oldbh = widget-handle (entry(2, p-doc-code, chr(4)))
     2422       v-newbh = widget-handle (entry(3, p-doc-code, chr(4)))
     2423       v-changes-list = entry(4, p-doc-code, chr(4))
     2424       file-name  = p-process-file-name
     2425       v-has-oldbh = valid-handle(v-oldbh) and v-oldbh:available
     2426       v-has-newbh = valid-handle(v-newbh) and v-newbh:available
     2427     .
     2428     if not v-has-newbh
     2429     and not v-has-oldbh then do:
     2430       undo, return error substitute("Не определено ни одного буфера - ни старый, ни новый").
     2431     end.
     2432     if not v-has-oldbh
     2433     and v-changes-list  = '' then do:
     2434        undo, return error substitute("Не определен старый буфер и список изменений").
     2435     end.
     2436     case p-ruleset-id:
     2437       when 100 then do:
     2438         if v-has-newbh
     2439         and v-newbh:table <> 'place':U and v-newbh:table <> 'pl-gds':U and v-newbh:table <> 'pl-level':U and v-newbh:table <> 'pl-level-mm':U then do:
     2440           undo, return error substitute("Передан неверный буфер вместо буфера для &1",  'place':U).
     2441         end.
     2442         if v-has-oldbh
     2443         and v-oldbh:table <> 'place':U and v-oldbh:table <> 'pl-gds':U and v-oldbh:table <> 'pl-level':U and v-newbh:table <> 'pl-level-mm':U then do:
     2444           undo, return error substitute("Передан неверный буфер вместо буфера для &1",  'place':U).
     2445         end.
     2446       end.
     2447       otherwise do:
     2448         undo, return error substitute("Неверный вызов &1 для набора правил &2", vss-workfile , p-ruleset-id).
     2449       end.
     2450     end case.
     2451       if num-entries(v-direction, chr(4)) > 1 then do:
     2452       v-direction-2 = entry(2, v-direction, chr(4)).
     2453       v-direction = entry(1, v-direction, chr(4)).
     2454       if v-direction-2 <> "to"
     2455       and v-direction-2 <> "from" then return "return".
     2456       if v-direction = '<открытие документа>':U
     2457       and v-direction-2 = "to" then return "return".
     2458     end.
     2459     if v-direction = '<открытие документа>':U
     2460     or v-direction = 'удаление':U
     2461     or (v-direction = '<закрытие документа>':U and v-newbh::status_ = 'факт':U )
     2462     then do:
     2463       v-action = 'D':U.
     2464     end.
     2465     else do:
     2466       v-action = 'U':U.
     2467     end.
     2468     for each buf_rule-call-param no-lock where
     2469     buf_rule-call-param.codex_id = p-codex-id
     2470     and buf_rule-call-param.ruleset_id = p-ruleset-id
     2471     and buf_rule-call-param.call_id = p-call-id
     2472     and buf_rule-call-param.order_id = p-order-id
     2473     and buf_rule-call-param.rule_id = p-rule-id
     2474     and buf_rule-call-param.param-name = "p-esys-id",
     2475       first buf_ext-system no-lock where
     2476             buf_Ext-system.esys-id = buf_rule-call-param.param-value-integer
     2477         and buf_Ext-system.db-num = 0
     2478         and buf_Ext-system.esys-have-export = yes
     2479         and buf_Ext-system.esys-db-num-exp = g#db-num:
     2480       v-esys-id-list = v-esys-id-list + (if v-esys-id-list = '' then '' else chr(1)) + string(buf_ext-system.esys-id).
     2481     end.
     2482     if v-esys-id-list = '' then return "return".
     2483     find first buf_rule-call-param no-lock where
     2484   buf_rule-call-param.codex_id = p-codex-id
     2485   and buf_rule-call-param.ruleset_id = p-ruleset-id
     2486   and buf_rule-call-param.call_id = p-call-id
     2487   and buf_rule-call-param.order_id = p-order-id
     2488   and buf_rule-call-param.rule_id = p-rule-id
     2489   and buf_rule-call-param.param-name = "p-xsd-file"
     2490    no-error.
     2491   if available buf_rule-call-param then do:
     2492     assign p-xsd-file = buf_rule-call-param.param-value-character.
     2493   end.
     2494   end.
     2495   end procedure.
