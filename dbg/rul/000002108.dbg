       25   define input parameter p-cmd-code  as integer no-undo .
       26   define variable vss-revision    as character no-undo init "$Revision: 22985a2af0a7, 1166, rls $":U .
       27   define variable vss-author      as character no-undo init "$Author: EShklyar $":U .
       28   define variable vss-date        as character no-undo init "$Date: Thu Dec 14 02:20:26 2017 +0300 $":U .
       29   define variable vss-workfile    as character no-undo init "$Workfile: 000002108.p $":U .
