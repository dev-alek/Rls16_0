     3191   define buffer buf_temp-cmd for temp-cmd.
     3192   define shared temp-table tt0-rule-call-param no-undo like ub.rule-call-param.
     3193    define variable p-esys-id-list as integer no-undo.
     3194    define variable p-xsd-file as character no-undo.
     3195   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3196   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
     3197   run gbl/getobjsrvhndl.p (input-output ObjSrv).
     3198   function context_begin-esys-command return logical
     3199   (
     3200       input p-esys-id-list as character
     3201      ,input-output p-esys-cmd-proc-handle as handle
     3202      ,output p-esys-cmd-code as integer
     3203   ):
     3204      if not valid-handle(p-esys-cmd-proc-handle )
     3205      then do:
     3206        run nws/cmd-bush.p persistent set p-esys-cmd-proc-handle no-error .
     3207        if error-status :error
     3208        then do:
     3209           delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( substitute("&1 &2 &3&4Ошибка при запуске процедуры cmd-bush.p&4" +
     3210                                              "&5&4&6"
     3211                                              ,vss-workfile
     3212                                              ,vss-revision
     3213                                              ,vss-description
     3214                                              ,chr(10)
     3215                                              ,error-status:get-message(1)
     3216                                              ,return-value )).
     3217        end.
     3218        run begin-create-command in p-esys-cmd-proc-handle
     3219          (input 'cmd-esys-general':U
     3220          ,input p-esys-id-list
     3221          ,output p-esys-cmd-code
     3222          ) no-error.
     3223        if error-status :error
     3224        then do:
     3225          delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при создании команды &1&2&3&1&4"
     3226                                                           , 'cmd-esys-general':U
     3227                                                           , error-status:get-message(1)
     3228                                                           , return-value
     3229                                                           )).
     3230          return no .
     3231        end.
     3232        return yes.
     3233      end.
     3234   end.
     3235   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3236   function context_send-esys-command return logical
     3237   (
     3238       input p-esys-id-list as character
     3239      ,input p-esys-cmd-proc-handle as handle
     3240      ,input p-esys-cmd-code as integer
     3241      ,input p-user-id as character
     3242   ):
     3243      define variable v-dmp-ord-int64 as int64 no-undo .
     3244      if valid-handle(p-esys-cmd-proc-handle )
     3245      then do:
     3246         run send-command-esys in p-esys-cmd-proc-handle
     3247             (input p-esys-cmd-code
     3248             ,input p-esys-id-list
     3249             ,input p-user-id
     3250             ,output v-dmp-ord-int64
     3251             ) no-error.
     3252         if error-status :error
     3253         then do:
     3254            delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при отсылке во внешнюю систему &1 команды с кодом &2&3&4&3&5"
     3255                                                           , p-esys-id-list
     3256                                                           , p-cmd-code
     3257                                                           , chr(10)
     3258                                                           , error-status:get-message(1)
     3259                                                           , return-value
     3260                                                           )).
     3261            return no .
     3262         end.
     3263         delete procedure p-esys-cmd-proc-handle no-error.
     3264         return yes.
     3265      end.
     3266      else do:
     3267         delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при отсылке во внешнюю систему &1 команды с кодом &2&3&4&3&5"
     3268                                                       , p-esys-id-list
     3269                                                       , p-cmd-code
     3270                                                       , chr(10)
     3271                                                       , error-status:get-message(1)
     3272                                                       , return-value
     3273                                                       )).
     3274         return no .
     3275      end.
     3276   end.
     3277   on delete of this-procedure do:
     3278     run garbcoll_clear in this-procedure .
     3279   end.
     3280   run load-ruleset-context in this-procedure ( input p-ruleset-id) no-error.
     3281   if error-status:error then do:
     3282     undo, return error return-value .
     3283   end.
     3284   define variable ExpData1 as class Route-data_ no-undo .
     3285   ExpData1 = new Route-data_( input parparentproc, input p-parent-handle, input p-log-handle, input this-procedure:handle) .
     3286   if not this-procedure:persistent then do:
     3287     run proc-main in this-procedure no-error .
     3288     if error-status:error then do:
     3289         for each temp-goods-attr:
     3290           delete temp-goods-attr.
     3291         end.
     3292         run garbcoll_clear in this-procedure .
     3293         undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     3294     end.
     3295     run garbcoll_clear in this-procedure .
     3296   end.
     3297   procedure proc-main :
     3298   _main:
     3299   do
     3300   on error undo, return error substitute( "&1&2&3&2&4", return-value, chr(10), error-status :get-message (1), v-last-error-message)
     3301   :
     3302     define variable v-attr-list as character no-undo .
     3303     define variable v-ii as integer no-undo .
     3304     define variable v-is-global as logical no-undo .
     3305     define variable v-is-scaleable as logical no-undo .
     3306     define variable v-is-weight as logical no-undo .
     3307     define variable v-is-petrolium as logical no-undo .
     3308     define buffer buf_goods for ub.goods.
     3309     define buffer buf_bar-code for ub.bar-code.
     3310     define buffer buf_prod-bc for ub.prod-bc.
     3311     define buffer locked_goods-attr for ub.goods-attr.
     3312     define buffer buf_clients for ub.clients.
     3313     define buffer buf_gds-prt for ub.gds-prt.
     3314     define buffer buf_fbr-gds-grp for ub.fbr-gds-grp.
     3315     define buffer buf_temp-fbr-gds-grp for temp-fbr-gds-grp.
     3316     define buffer buf_ext-system for ub.ext-system.
     3317     _stroka:
     3318     for each gds-list
     3319     break
     3320     by gds-list.gds-code
     3321     On error undo _stroka, next _stroka
     3322     :
     3323       assign
     3324       v-current-gds-code = gds-list.gds-code
     3325       v-current-artic = gds-list.artic
     3326       v-current-prod-type = gds-list.prod-type
     3327       v-current-prod-code = gds-list.prod-code
     3328       num-rec = num-rec + 1
     3329       v-is-global = no
     3330       .
     3331       for each temp-goods-attr :
     3332         delete temp-goods-attr.
     3333       end.
     3334       IF num-rec = 1
     3335       or num-rec modulo v-pck-num-rec = 1
     3336       THEN do:
     3337         IF  ExpData1:route-data_read-xmlschema( INPUT p-xsd-file) = false  THEN do:
     3338           undo _main, return error v-last-error-message .
     3339         end.
     3340         IF  context_begin-esys-command( input v-esys-id-list-start, input-output v-esys-cmd-proc-handle, output v-esys-cmd-code) = false  THEN do:
     3341           undo _main, return error v-last-error-message .
     3342         end.
     3343       end.
     3344       if p-save >= 0 then do:
     3345         find first buf_goods exclusive-lock where
     3346                   buf_goods.gds-code = gds-list.gds-code no-error.
     3347       end.
     3348       else do:
     3349         find first buf_goods no-lock where
     3350                   buf_goods.gds-code = gds-list.gds-code no-error.
     3351       end.
     3352       if not available buf_goods then do:
     3353               run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не найден содержащийся в списке товар с кодом &1", gds-list.gds-code)).                      assign v-view-log = yes.
     3354         next _stroka.
     3355       end.
     3356       find first buf_clients no-lock where
     3357                 buf_clients.obj-type = buf_goods.prod-type
     3358             and buf_clients.obj-code = buf_goods.prod-code no-error.
     3359       if not available buf_clients then do:
     3360               run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Для товара с кодом &1 не найден производитель &2&3"                                   , gds-list.gds-code                                   , buf_goods.prod-type                                   , buf_goods.prod-code)).                      assign v-view-log = yes.
     3361         next _stroka.
     3362       end.
     3363       find first buf_gds-prt no-lock WHERE
     3364                 buf_gds-prt.upper-code = buf_goods.prt-root NO-error.
     3365       if not available buf_gds-prt then do:
     3366               run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Для товара с кодом &1 не найден корень ШКАЛЫ ПРИЗНАКОВ с кодом &2"                                   , gds-list.gds-code                                   , buf_goods.prt-root                                   )).                      assign v-view-log = yes.
     3367         next _stroka.
     3368       end.
     3369       if buf_goods.fbr-grp-code <> ?
     3370       and buf_goods.fbr-grp-code <> 0 then do:
     3371         find first buf_fbr-gds-grp no-lock where
     3372                 buf_fbr-gds-grp.obj-type = "":U
     3373             AND buf_fbr-gds-grp.obj-code = 0
     3374             AND buf_fbr-gds-grp.node-code = buf_goods.fbr-grp-code no-error .
     3375         if not available buf_fbr-gds-grp then do:
     3376                   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Для товара с кодом &1 не найдена группа блюд &2"                                     , gds-list.gds-code                                     , buf_goods.fbr-grp-code)).                      assign v-view-log = yes.
     3377           next _stroka.
     3378         end.
     3379         create buf_temp-fbr-gds-grp.
     3380         buffer-copy buf_fbr-gds-grp to buf_temp-fbr-gds-grp.
     3381         run fbrglib-get-full-name in this-procedure (
     3382                                                        input ''
     3383                                                       ,input 0
     3384                                                       ,input buf_goods.fbr-grp-code
     3385                                                       ,output buf_temp-fbr-gds-grp.f-name).
     3386       end.
     3387       if p-save >= 0 then do:
     3388         Find first locked_goods-attr exclusive-lock  where
     3389                 locked_goods-attr.gds-code = v-current-gds-code
     3390             and locked_goods-attr.attr-code = 'lock':U
     3391             no-error no-wait.
     3392         if not available locked_goods-attr
     3393         and not locked locked_goods-attr then do:
     3394           create locked_goods-attr.
     3395           assign
     3396           locked_goods-attr.gds-code =  v-current-gds-code
     3397           locked_goods-attr.attr-code = 'lock':U
     3398           .
     3399         end.
     3400         if locked locked_goods-attr then do:
     3401           Find first locked_goods-attr exclusive-lock  where
     3402                 locked_goods-attr.gds-code = v-current-gds-code
     3403             and locked_goods-attr.attr-code = 'lock':U
     3404             no-error .
     3405         end.
     3406       end.
     3407       v-attr-list = 'alcohol-prod':U + chr(4) +
     3408                     'fasovka':U + chr(4) +
     3409                     '15x80':U + chr(4)  +
     3410                     '8x50':U + chr(4) +
     3411                     '6x50':U .
     3412       do v-ii = 1 to num-entries(v-attr-list):
     3413         create temp-goods-attr.
     3414         assign
     3415         temp-goods-attr.gds-code = v-current-gds-code
     3416         temp-goods-attr.attr-code  = entry(v-ii, v-attr-list)
     3417         .
     3418         run gds-attr-copy-to  in this-procedure (
     3419                                                 input  v-current-gds-code
     3420                                                 ,input  entry(v-ii, v-attr-list)
     3421                                                 ,input (buffer temp-goods-attr:handle)
     3422                                                 ) no-error.
     3423       end.
     3424       empty temp-table tt-tax.
     3425       run ref/dtaxgdss.p (
     3426                     input yes
     3427                    ,input buf_goods.unit-base
     3428                    ,input buf_goods.grp-code
     3429                    ,input recid(buf_goods)
     3430                    ,input recid(buf_goods)
     3431                    ,input 0
     3432                    ,input ''
     3433                    ,input 0
     3434                     ) no-error.
     3435       if error-status:error then do:
     3436                   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input return-value).                      assign v-view-log = yes.
     3437           next _stroka.
     3438       end.
     3439       ExpData1:route-data_create-record( INPUT "goods-01") .
     3440       ExpData1:route-data_copy-record( INPUT "goods-01", INPUT  (buffer buf_goods:handle) ) .
     3441       for each temp-goods-attr:
     3442         ExpData1:route-data_copy-field( INPUT "goods-01"
     3443                                        , INPUT ("attr-" + temp-goods-attr.attr-code)
     3444                                        , INPUT (buffer temp-goods-attr:handle:buffer-field("attr-value")) ) .
     3445       end.
     3446       ExpData1:route-data_copy-field( INPUT "goods-01"
     3447                                       , INPUT "prod-name"
     3448                                       , INPUT (buffer buf_clients:handle:buffer-field("obj-name")) ) .
     3449       ExpData1:route-data_copy-field( INPUT "goods-01"
     3450                                       , INPUT "fbr-grp-name"
     3451                                       , INPUT (buffer buf_temp-fbr-gds-grp:handle:buffer-field("f-name")) ) .
     3452       if available buf_temp-fbr-gds-grp then
     3453       delete buf_temp-fbr-gds-grp.
     3454       ExpData1:route-data_copy-field( INPUT "goods-01"
     3455                                       , INPUT "prt-root-name"
     3456                                       , INPUT (buffer buf_gds-prt:handle:buffer-field("node-name")) ) .
     3457       find first tt-tax no-lock where
     3458                 tt-tax.tax-code = integer('1':U).
     3459       ExpData1:route-data_copy-field( INPUT "goods-01"
     3460                                       , INPUT "vat-pc"
     3461                                       , INPUT (buffer tt-tax:buffer-field("rate-value")) ) .
     3462       IF  ExpData1:esys-add-dump( INPUT "goods-01", INPUT v-esys-cmd-proc-handle, INPUT v-esys-cmd-code, '+update') = false  THEN do:
     3463         undo _main, return error v-last-error-message .
     3464       end.
     3465       _bar-code:
     3466       for each buf_bar-code share-lock where
     3467               buf_bar-code.gds-code = v-current-gds-code
     3468       on error  undo _stroka, next _stroka
     3469       on stop   undo _stroka, next _stroka
     3470       on endkey undo _stroka, next _stroka
     3471       :
     3472         if buf_bar-code.in-code <> '':U
     3473         or buf_bar-code.part-code <> '':U then next _bar-code.
     3474         find first buf_gds-prt no-lock where
     3475                   buf_gds-prt.node-code = buf_bar-code.node-code no-error.
     3476         if not available buf_gds-prt then do:
     3477                   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Для товара с кодом &1 не найден узел ШКАЛЫ ПРИЗНАКОВ с кодом &2"                                     , gds-list.gds-code                                     , buf_bar-code.node-code                                     )).                      assign v-view-log = yes.
     3478           next _stroka.
     3479         end.
     3480         ExpData1:route-data_create-record( INPUT "bar-code-01") .
     3481         ExpData1:route-data_copy-record( INPUT "bar-code-01", INPUT  (buffer buf_bar-code:handle) ) .
     3482          ExpData1:route-data_copy-field( INPUT "bar-code-01"
     3483                                         , INPUT "node-name"
     3484                                         , INPUT (buffer buf_gds-prt:handle:buffer-field("f-name")) ) .
     3485         IF  ExpData1:esys-add-dump( INPUT "bar-code-01", INPUT v-esys-cmd-proc-handle, INPUT v-esys-cmd-code, '+update') = false  THEN do:
     3486           undo _main, return error v-last-error-message .
     3487         end.
     3488         _prod-bc:
     3489         for each buf_prod-bc share-lock where
     3490                 buf_prod-bc.b-code = buf_bar-code.b-code
     3491         on error  undo _stroka, next _stroka
     3492         on stop   undo _stroka, next _stroka
     3493         on endkey undo _stroka, next _stroka
     3494         :
     3495   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3496   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbcat in g#library
     3497     (buffer buf_prod-bc
     3498     ,input  'global=request':U
     3499     ,output v-is-global
     3500     ) no-error .
     3501   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3502   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbcat in g#library
     3503     (buffer buf_prod-bc
     3504     ,input  'weight=request':U
     3505     ,output v-is-weight
     3506     ) no-error .
     3507   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3508   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbcat in g#library
     3509     (buffer buf_prod-bc
     3510     ,input  'petrolium=request':U
     3511     ,output v-is-petrolium
     3512     ) no-error .
     3513   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3514   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbcat in g#library
     3515     (buffer buf_prod-bc
     3516     ,input  'scaleable=request':U
     3517     ,output v-is-scaleable
     3518     ) no-error .
     3519           if not v-is-global
     3520           or v-is-scaleable
     3521           or v-is-petrolium
     3522           or v-is-weight
     3523           then next _prod-bc.
     3524           ExpData1:route-data_create-record( INPUT "prod-bc-01") .
     3525           ExpData1:route-data_copy-record( INPUT "prod-bc-01", INPUT  (buffer buf_prod-bc:handle) ) .
     3526           IF  ExpData1:esys-add-dump( INPUT "prod-bc-01", INPUT v-esys-cmd-proc-handle, INPUT v-esys-cmd-code, '+update') = false  THEN do:
     3527             undo _main, return error v-last-error-message .
     3528           end.
     3529         end.
     3530       end.
     3531       num-rec-ok = num-rec-ok + 1.
     3532       run write-counter in p-log-handle ( input substitute("Обработано товаров списка: &1, из них удачно: &2", num-rec, num-rec-ok)).
     3533       run get-stop-state in p-log-handle ( output v-stop) no-error .
     3534       if v-stop then do:
     3535           run write-log-and-file in p-log-handle (
     3536                                                   input 1
     3537                                                 , input log-file-name
     3538                                                 , input 1
     3539                                                 , input substitute("Процесс прерван пользователем")).
     3540           leave _stroka.
     3541       end.
     3542       if last( gds-list.gds-code)
     3543       or num-rec modulo v-pck-num-rec = 0
     3544       then do:
     3545         IF  context_send-esys-command( input v-esys-id-list-start, input v-esys-cmd-proc-handle, input v-esys-cmd-code, input g#userid) = false  THEN do:
     3546           undo _main, return error v-last-error-message .
     3547         end.
     3548               ExpData1:Route-data_clear-data ( ) .
     3549       end.
     3550     end.
     3551     ExpData1:route-data_clear-xmlschema ( ).
     3552     run write-log-and-file in p-log-handle (
     3553           input 1
     3554         , input log-file-name
     3555         , input 1
     3556         , input substitute("Обработано товаров списка: &1, из них удачно: &2", num-rec, num-rec-ok)).
     3557   end.
     3558   end procedure.
     3559   procedure load-ruleset-context :
     3560   define input parameter p-ruleset-id as integer no-undo .
     3561   define buffer buf_rule-call-param for tt0-rule-call-param.
     3562   define buffer buf_ext-system for ub.ext-system.
     3563     do
     3564     on error undo, return error
     3565     :
     3566   for each buf_rule-call-param no-lock where
     3567   buf_rule-call-param.codex_id = p-codex-id
     3568   and buf_rule-call-param.ruleset_id = p-ruleset-id
     3569   and buf_rule-call-param.call_id = p-call-id
     3570   and buf_rule-call-param.order_id = p-order-id
     3571   and buf_rule-call-param.rule_id = p-rule-id
     3572   and buf_rule-call-param.param-name = "p-esys-id-list",
     3573     first buf_ext-system no-lock where
     3574           buf_Ext-system.esys-id = buf_rule-call-param.param-value-integer
     3575       and buf_Ext-system.db-num = 0
     3576       and buf_Ext-system.esys-have-export = yes
     3577       and buf_Ext-system.esys-db-num-exp = g#db-num:
     3578     v-esys-id-list-start = v-esys-id-list-start + (if v-esys-id-list-start = '' then '' else chr(1)) + string(buf_ext-system.esys-id).
     3579     assign
     3580     v-pck-num-rec = min(v-pck-num-rec, (if buf_ext-system.esys-max-p-size > 0
     3581                                         then buf_ext-system.esys-max-p-size
     3582                                         else v-pck-num-rec)).
     3583   end.
     3584   if v-esys-id-list-start = '' then return "return".
     3585    find first buf_rule-call-param no-lock where
     3586   buf_rule-call-param.codex_id = p-codex-id
     3587   and buf_rule-call-param.ruleset_id = p-ruleset-id
     3588   and buf_rule-call-param.call_id = p-call-id
     3589   and buf_rule-call-param.order_id = p-order-id
     3590   and buf_rule-call-param.rule_id = p-rule-id
     3591   and buf_rule-call-param.param-name = "p-xsd-file"
     3592    no-error.
     3593   if available buf_rule-call-param then do:
     3594   assign p-xsd-file = buf_rule-call-param.param-value-character.
     3595   end.
     3596       case p-ruleset-id:
     3597         when 1 then do:
     3598           assign
     3599           v-sign = 1
     3600           v-current-host-code = p-host-code
     3601           v-current-obj-type = p-obj-type
     3602           v-current-obj-code = p-obj-code
     3603           v-current-db-num = g#db-num
     3604           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     3605           file-name  = p-process-file-name
     3606           .
     3607         end.
     3608       end case.
     3609     end.
     3610   end procedure.
