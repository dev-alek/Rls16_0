     2193   define variable vss-include-info12 as character format "X(65)" no-undo
     2194   initial "@(#)$Workfile$ $Revision$".
     2195   define temp-table temp_fbrglib_grp no-undo
     2196       field sel           as character
     2197       field full-name     as character
     2198       field out-code      as integer
     2199       field sort-name     as character
     2200       field node-code     as integer
     2201       field upper-code    as integer
     2202       field name          as character
     2203       field level         as integer
     2204       field mark          as character
     2205       field obj-type      as character
     2206       field obj-code      as integer
     2207       field global-code   as integer
     2208       index pi is primary unique obj-type obj-code sort-name
     2209       index fn obj-type obj-code full-name
     2210       index nc is unique obj-type obj-code node-code
     2211       index sl obj-type obj-code sel
     2212       index uc obj-type obj-code upper-code
     2213   .
     2214   define temp-table temp_fbrglib_found-grp no-undo
     2215       field full-name   as character
     2216       field sort-name   as character
     2217       field node-code   as integer
     2218       field level       as integer
     2219       field is-terminal as logical
     2220       field obj-type      as character
     2221       field obj-code      as integer
     2222       index pi is primary unique obj-type obj-code sort-name
     2223       index fn obj-type obj-code full-name
     2224       index lv obj-type obj-code level
     2225       index it obj-type obj-code is-terminal
     2226   .
     2227   define temp-table temp_found-result-nodelist no-undo
     2228       field node-code     as integer
     2229       field processed     as logical
     2230       field sort-name     as character
     2231       field full-name     as character
     2232       index pi is primary unique node-code
     2233       index ps processed
     2234   .
     2235   procedure fbrglib-get-sort-name :
     2236   do
     2237   on error undo, return error
     2238   :
     2239   define input parameter p-obj-type   as character    no-undo.
     2240   define input parameter p-obj-code   as integer      no-undo.
     2241   define input parameter p-node-code  as integer      no-undo.
     2242   define output parameter p-sort-name as character    no-undo.
     2243       define variable v-upper-code    as integer           no-undo.
     2244       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     2245       define buffer buf_upper_fbr-gds-grp for ub.fbr-gds-grp.
     2246       find first buf_fbr-gds-grp no-lock
     2247            where buf_fbr-gds-grp.obj-type  = p-obj-type
     2248              and buf_fbr-gds-grp.obj-code  = p-obj-code
     2249              and buf_fbr-gds-grp.node-code = p-node-code
     2250       no-error.
     2251       if not available buf_fbr-gds-grp
     2252       then do:
     2253           undo, return error "fbrglib-get-sort-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     2254       end.
     2255       assign
     2256           p-sort-name  = ""
     2257           v-upper-code = 1
     2258       .
     2259       do while true
     2260       on error undo, return error "fbrglib-get-sort-name: Ошибка составления полного имени группы"
     2261       :
     2262           assign
     2263               p-sort-name  = buf_fbr-gds-grp.node-name
     2264                            + (if p-sort-name <> "" then chr(2) else "")
     2265                            + p-sort-name
     2266               v-upper-code = buf_fbr-gds-grp.upper-code
     2267           .
     2268           if buf_fbr-gds-grp.upper-code = 1
     2269           then do:
     2270               leave.
     2271           end.
     2272           find first buf_fbr-gds-grp no-lock
     2273                where buf_fbr-gds-grp.obj-type  = p-obj-type
     2274                  and buf_fbr-gds-grp.obj-code  = p-obj-code
     2275                  and buf_fbr-gds-grp.node-code = v-upper-code
     2276           no-error.
     2277           if not available buf_fbr-gds-grp
     2278           then do:
     2279               undo, return error "fbrglib-get-sort-name: Не найдена группа товаров с кодом "
     2280                                   + string( v-upper-code )
     2281                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     2282           end.
     2283       end.
     2284   end.
     2285   end procedure.
     2286   procedure fbrglib-get-full-name :
     2287   do
     2288   on error undo, return error
     2289   :
     2290   define input parameter p-obj-type   as character    no-undo.
     2291   define input parameter p-obj-code   as integer      no-undo.
     2292   define input parameter p-node-code  as integer      no-undo.
     2293   define output parameter p-full-name as character    no-undo.
     2294       define variable v-upper-code    as integer           no-undo.
     2295       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     2296       define buffer buf_upper_fbr-gds-grp for ub.fbr-gds-grp.
     2297       if p-node-code = 1
     2298       then do:
     2299           assign
     2300               p-full-name = ""
     2301           .
     2302       end.
     2303       else do:
     2304           find first buf_fbr-gds-grp no-lock
     2305                where buf_fbr-gds-grp.obj-type  = p-obj-type
     2306                  and buf_fbr-gds-grp.obj-code  = p-obj-code
     2307                  and buf_fbr-gds-grp.node-code = p-node-code
     2308           no-error.
     2309           if not available buf_fbr-gds-grp
     2310           then do:
     2311               undo, return error "fbrglib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     2312           end.
     2313           assign
     2314               p-full-name  = ""
     2315               v-upper-code = 1
     2316           .
     2317           do while true
     2318           on error undo, return error "fbrglib-get-full-name: Ошибка составления полного имени группы"
     2319           :
     2320               assign
     2321                   p-full-name  = buf_fbr-gds-grp.node-name
     2322                               + (if p-full-name <> "" then chr(47) else "")
     2323                               + p-full-name
     2324                   v-upper-code = buf_fbr-gds-grp.upper-code
     2325               .
     2326               if buf_fbr-gds-grp.upper-code = 1
     2327               then do:
     2328                   leave.
     2329               end.
     2330               find first buf_fbr-gds-grp no-lock
     2331                    where buf_fbr-gds-grp.obj-type  = p-obj-type
     2332                      and buf_fbr-gds-grp.obj-code  = p-obj-code
     2333                      and buf_fbr-gds-grp.node-code = v-upper-code
     2334               no-error.
     2335               if not available buf_fbr-gds-grp
     2336               then do:
     2337                   undo, return error "fbrglib-get-full-name: Не найдена группа товаров с кодом "
     2338                                       + string( v-upper-code )
     2339                                       + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     2340               end.
     2341           end.
     2342           assign
     2343               p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     2344           .
     2345       end.
     2346   end.
     2347   end procedure.
     2348   procedure fbrglib-get-root-code :
     2349   do
     2350   on error undo, return error
     2351   :
     2352   define output parameter p-root-code as integer      no-undo.
     2353       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     2354       find first buf_fbr-gds-grp no-lock
     2355            where buf_fbr-gds-grp.upper-code = 0
     2356       no-error .
     2357       if not available buf_fbr-gds-grp
     2358       then do:
     2359           undo, return error .
     2360       end.
     2361       else do:
     2362           assign
     2363               p-root-code = buf_fbr-gds-grp.node-code
     2364           .
     2365       end.
     2366   end.
     2367   end procedure.
     2368   procedure fbrglib-find-grp-by-full-name :
     2369   do
     2370   on error undo, return error
     2371   :
     2372   define input parameter p-obj-type     as character    no-undo.
     2373   define input parameter p-obj-code     as integer      no-undo.
     2374   define input parameter p-search-name  as character    no-undo.
     2375   define input parameter p-fill-path    as logical      no-undo.
     2376       define variable v-upper-code    as integer          no-undo.
     2377       define variable v-not-found     as logical init yes no-undo.
     2378       define variable v-counter       as integer           no-undo.
     2379       define variable v-level         as integer           no-undo.
     2380       define variable v-full-name     as character         no-undo.
     2381       define variable v-sort-name     as character         no-undo.
     2382       define variable v-node-name     as character      no-undo.
     2383       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     2384       assign
     2385           p-search-name = replace( p-search-name, chr(47), chr(2) )
     2386       .
     2387       run fbrglib-get-root-code ( output v-upper-code ) no-error .
     2388       if error-status :error
     2389       then do:
     2390           undo, return error "fbrglib-find-grp-by-full-name: Ошибка при поиске корневого узла".
     2391       end.
     2392       assign
     2393           v-full-name  = ""
     2394           v-level      = num-entries( p-search-name, chr(2) )
     2395       .
     2396       for each temp_fbrglib_found-grp
     2397       :
     2398           delete temp_fbrglib_found-grp.
     2399       end.
     2400       start-name-analyze:
     2401       do v-counter = 1 to v-level
     2402       :
     2403           if v-counter < v-level
     2404           then do:
     2405               assign
     2406                   v-node-name = entry( v-counter, p-search-name, chr(2) )
     2407               .
     2408               find first buf_fbr-gds-grp no-lock
     2409                    where buf_fbr-gds-grp.obj-type   = p-obj-type
     2410                      and buf_fbr-gds-grp.obj-code   = p-obj-code
     2411                      and buf_fbr-gds-grp.upper-code = v-upper-code
     2412                      and buf_fbr-gds-grp.node-name  = v-node-name
     2413               no-error .
     2414               if not available buf_fbr-gds-grp
     2415               then do:
     2416                   assign
     2417                       v-full-name  = p-search-name
     2418                       v-sort-name  = p-search-name
     2419                   .
     2420                   return error "fbrglib-find-grp-by-full-name: не найдена группа " + entry( v-level, p-search-name, chr(47) ).
     2421               end.
     2422               else do:
     2423                   assign
     2424                       v-full-name = v-full-name + ( if v-full-name = "" then "" else chr(47) )        + buf_fbr-gds-grp.node-name
     2425                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_fbr-gds-grp.node-name
     2426                       v-upper-code = buf_fbr-gds-grp.node-code
     2427                   .
     2428                   if p-fill-path = yes
     2429                   then do:
     2430                       create temp_fbrglib_found-grp.
     2431                       assign
     2432                           temp_fbrglib_found-grp.full-name = v-full-name + chr(47)
     2433                           temp_fbrglib_found-grp.sort-name = v-sort-name
     2434                           temp_fbrglib_found-grp.node-code = v-upper-code
     2435                           temp_fbrglib_found-grp.level     = v-counter
     2436                           temp_fbrglib_found-grp.obj-type  = p-obj-type
     2437                           temp_fbrglib_found-grp.obj-code  = p-obj-code
     2438                       .
     2439                   end.
     2440               end.
     2441           end.
     2442           else do:
     2443               for each buf_fbr-gds-grp no-lock
     2444                  where buf_fbr-gds-grp.obj-type   = p-obj-type
     2445                    and buf_fbr-gds-grp.obj-code   = p-obj-code
     2446                    and buf_fbr-gds-grp.upper-code = v-upper-code
     2447                    and buf_fbr-gds-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
     2448               :
     2449                   assign
     2450                       v-not-found = no
     2451                   .
     2452                   create temp_fbrglib_found-grp.
     2453                   assign
     2454                       temp_fbrglib_found-grp.full-name = v-full-name
     2455                                                           + (if v-full-name = "" then "" else chr(47) )
     2456                                                           + buf_fbr-gds-grp.node-name + chr(47)
     2457                       temp_fbrglib_found-grp.sort-name = v-sort-name
     2458                                                           + ( if v-sort-name = "" then "" else chr(2) )
     2459                                                           + buf_fbr-gds-grp.node-name
     2460                       temp_fbrglib_found-grp.node-code = buf_fbr-gds-grp.node-code
     2461                       temp_fbrglib_found-grp.level     = v-level
     2462                       temp_fbrglib_found-grp.obj-type  = p-obj-type
     2463                       temp_fbrglib_found-grp.obj-code  = p-obj-code
     2464                   .
     2465               end.
     2466               if v-not-found = yes
     2467               then do:
     2468                   assign
     2469                       v-full-name  = p-search-name
     2470                       v-sort-name  = p-search-name
     2471                   .
     2472                   for each temp_fbrglib_found-grp
     2473                   :
     2474                       delete temp_fbrglib_found-grp.
     2475                   end.
     2476                   return error "fbrglib-find-grp-by-full-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
     2477               end.
     2478           end.
     2479       end.
     2480   end.
     2481   end procedure.
     2482   procedure fbrglib-find-all-subgroup :
     2483   do
     2484   on error undo, return error
     2485   :
     2486   define input parameter p-start-obj-type     as character    no-undo.
     2487   define input parameter p-start-obj-code     as integer      no-undo.
     2488   define input parameter p-start-node-code    as integer      no-undo.
     2489   define input parameter p-terminal-only      as logical      no-undo.
     2490       define variable v-start-full-name   as character     no-undo.
     2491       define variable v-start-sort-name   as character     no-undo.
     2492       define variable v-not-found         as logical       no-undo.
     2493       define variable v-is-terminal       as logical       no-undo.
     2494       define buffer buf_fbr-gds-grp           for ub.fbr-gds-grp.
     2495       create temp_found-result-nodelist.
     2496       assign
     2497           temp_found-result-nodelist.node-code = p-start-node-code
     2498           temp_found-result-nodelist.processed = no
     2499       .
     2500       run fbrglib-get-full-name in this-procedure (
     2501             input p-start-obj-type
     2502           , input p-start-obj-code
     2503           , input p-start-node-code
     2504           , output v-start-full-name
     2505       ).
     2506       run fbrglib-get-full-name in this-procedure (
     2507             input p-start-obj-type
     2508           , input p-start-obj-code
     2509           , input p-start-node-code
     2510           , output v-start-sort-name
     2511       ).
     2512       process-nodes:
     2513       do while yes
     2514       :
     2515           find first temp_found-result-nodelist
     2516                where temp_found-result-nodelist.node-code = p-start-node-code
     2517           .
     2518           assign
     2519               temp_found-result-nodelist.processed = yes
     2520           .
     2521           for each buf_fbr-gds-grp no-lock
     2522              where buf_fbr-gds-grp.obj-type   = p-start-obj-type
     2523                and buf_fbr-gds-grp.obj-code   = p-start-obj-code
     2524                and buf_fbr-gds-grp.upper-code = p-start-node-code
     2525           on error undo, return error
     2526           :
     2527               run fbrglib-is-terminal in this-procedure (
     2528                     input buf_fbr-gds-grp.obj-type
     2529                   , input buf_fbr-gds-grp.obj-code
     2530                   , input buf_fbr-gds-grp.node-code
     2531                   , output v-is-terminal
     2532               ).
     2533               if v-is-terminal = yes
     2534               then do:
     2535                   create temp_fbrglib_found-grp.
     2536                   assign
     2537                       temp_fbrglib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     2538                                                           chr(47) + buf_fbr-gds-grp.node-name + chr(47)
     2539                       temp_fbrglib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     2540                                                           chr(2) + buf_fbr-gds-grp.node-name + chr(2)
     2541                       temp_fbrglib_found-grp.node-code   = buf_fbr-gds-grp.node-code
     2542                       temp_fbrglib_found-grp.is-terminal = yes
     2543                       temp_fbrglib_found-grp.obj-type  = p-start-obj-type
     2544                       temp_fbrglib_found-grp.obj-code  = p-start-obj-code
     2545                   .
     2546               end.
     2547               else do:
     2548                   create temp_found-result-nodelist.
     2549                   assign
     2550                       temp_found-result-nodelist.node-code = buf_fbr-gds-grp.node-code
     2551                       temp_found-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
     2552                                                              chr(47) + buf_fbr-gds-grp.node-name + chr(47)
     2553                       temp_found-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
     2554                                                              chr(2) + buf_fbr-gds-grp.node-name + chr(2)
     2555                       temp_found-result-nodelist.processed = no
     2556                   .
     2557                   if p-terminal-only = no
     2558                   then do:
     2559                       create temp_fbrglib_found-grp.
     2560                       assign
     2561                           temp_fbrglib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     2562                                                               chr(47) + buf_fbr-gds-grp.node-name + chr(47)
     2563                           temp_fbrglib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     2564                                                               chr(2) + buf_fbr-gds-grp.node-name + chr(2)
     2565                           temp_fbrglib_found-grp.node-code   = buf_fbr-gds-grp.node-code
     2566                           temp_fbrglib_found-grp.is-terminal = no
     2567                           temp_fbrglib_found-grp.obj-type  = p-start-obj-type
     2568                           temp_fbrglib_found-grp.obj-code  = p-start-obj-code
     2569                       .
     2570                   end.
     2571               end.
     2572           end.
     2573           find first temp_found-result-nodelist
     2574                where temp_found-result-nodelist.processed = no
     2575           no-error.
     2576           if not available temp_found-result-nodelist
     2577           then do:
     2578               leave process-nodes.
     2579           end.
     2580           else do:
     2581               assign
     2582                   p-start-node-code = temp_found-result-nodelist.node-code
     2583                   v-start-full-name = temp_found-result-nodelist.full-name
     2584                   v-start-sort-name = temp_found-result-nodelist.sort-name
     2585               .
     2586           end.
     2587       end.
     2588   end.
     2589   end procedure.
     2590   procedure fbrglib-expand-name :
     2591   do
     2592   on error undo, return error
     2593   :
     2594   define input parameter p-obj-type   as character    no-undo.
     2595   define input parameter p-obj-code   as integer      no-undo.
     2596   define input parameter p-start-name as character    no-undo.
     2597   define output parameter p-end-name  as character    no-undo.
     2598       define variable v-is-terminal     as logical           no-undo.
     2599       define buffer buf_temp_fbrglib_found-grp     for temp_fbrglib_found-grp.
     2600       run fbrglib-find-grp-by-full-name in this-procedure (
     2601             input p-obj-type
     2602           , input p-obj-code
     2603           , input p-start-name
     2604           , input no
     2605       ) no-error.
     2606       run fbrglib-get-max-substring in this-procedure (
     2607              input p-obj-type
     2608           ,  input p-obj-code
     2609           ,  input length( p-start-name )
     2610           , output p-end-name
     2611       ) no-error .
     2612       if error-status :error
     2613       then do:
     2614           assign
     2615               p-end-name = ""
     2616           .
     2617       end.
     2618       else do:
     2619           find first temp_fbrglib_found-grp
     2620                where temp_fbrglib_found-grp.full-name = p-end-name
     2621                   AND temp_fbrglib_found-grp.obj-type  = p-obj-type
     2622                   AND temp_fbrglib_found-grp.obj-code  = p-obj-code
     2623                        no-error.
     2624           if available temp_fbrglib_found-grp
     2625           then do:
     2626               find first buf_temp_fbrglib_found-grp
     2627                    where buf_temp_fbrglib_found-grp.full-name begins p-end-name
     2628                      and recid( buf_temp_fbrglib_found-grp ) <> recid( temp_fbrglib_found-grp )
     2629                   AND temp_fbrglib_found-grp.obj-type  = p-obj-type
     2630                   AND temp_fbrglib_found-grp.obj-code  = p-obj-code
     2631               no-error.
     2632               if not available buf_temp_fbrglib_found-grp
     2633               then do:
     2634                   run fbrglib-is-terminal in this-procedure (
     2635                         input p-obj-type
     2636                       , input p-obj-code
     2637                       , input temp_fbrglib_found-grp.node-code
     2638                       , output v-is-terminal
     2639                   ).
     2640               end.
     2641           end.
     2642       end.
     2643   end.
     2644   end procedure.
     2645   procedure fbrglib-get-max-substring :
     2646   do
     2647   on error undo, return error
     2648   :
     2649   define input parameter p-obj-type as character no-undo .
     2650   define input parameter p-obj-code as integer no-undo .
     2651   define input parameter p-min-substring-length   as integer      no-undo.
     2652   define output parameter p-substring             as character    no-undo.
     2653           define variable v-char-counter  as integer           no-undo.
     2654           define variable v-current-char  as character         no-undo.
     2655           define variable v-names-counter  as integer           no-undo.
     2656           define variable v-base-string   as character         no-undo.
     2657           assign
     2658               v-char-counter  = p-min-substring-length
     2659           .
     2660           find first temp_fbrglib_found-grp  where
     2661                      temp_fbrglib_found-grp.obj-type  = p-obj-type
     2662                   AND temp_fbrglib_found-grp.obj-code  = p-obj-code
     2663           no-error.
     2664           if not available temp_fbrglib_found-grp
     2665           then do:
     2666               undo, return error "fbrglib-get-max-substring: Нет строк для вычисления общей подстроки".
     2667           end.
     2668           else do:
     2669               assign
     2670                   v-base-string = temp_fbrglib_found-grp.full-name
     2671               .
     2672               counter-block:
     2673               do while yes
     2674               on error undo, return error "fbrglib-get-max-substring: Ошибка вычисления продолжения имени группы."
     2675               :
     2676                   assign
     2677                       v-char-counter  = v-char-counter + 1
     2678                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
     2679                       v-names-counter = 0
     2680                   .
     2681                   compare-block:
     2682                   for each temp_fbrglib_found-grp
     2683                   where temp_fbrglib_found-grp.obj-type  = p-obj-type
     2684                   AND temp_fbrglib_found-grp.obj-code  = p-obj-code
     2685                   :
     2686                       assign
     2687                           v-names-counter = v-names-counter + 1
     2688                       .
     2689                       if v-names-counter = 1
     2690                       then do:
     2691                           next compare-block.
     2692                       end.
     2693                       if substring( temp_fbrglib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
     2694                       then do:
     2695                           leave counter-block.
     2696                       end.
     2697                   end.
     2698                   if v-names-counter = 1
     2699                   then do:
     2700                       assign
     2701                           p-substring = v-base-string
     2702                       .
     2703                       return.
     2704                   end.
     2705               end.
     2706               assign
     2707                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
     2708               .
     2709           end.
     2710   end.
     2711   end procedure.
     2712   procedure fbrglib-is-terminal :
     2713   do
     2714   on error undo, return error "Ошибка процедуры fbrglib-is-terminal"
     2715   :
     2716   define input parameter p-obj-type       as character    no-undo.
     2717   define input parameter p-obj-code       as integer      no-undo.
     2718   define input parameter p-node-code      as integer      no-undo.
     2719   define output parameter p-is-terminal   as logical      no-undo.
     2720       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     2721       find first buf_fbr-gds-grp no-lock
     2722            where buf_fbr-gds-grp.obj-type   = p-obj-type
     2723              and buf_fbr-gds-grp.obj-code   = p-obj-code
     2724              and buf_fbr-gds-grp.upper-code = p-node-code
     2725       no-error .
     2726       if not available buf_fbr-gds-grp
     2727       then do:
     2728           assign
     2729               p-is-terminal = yes
     2730           .
     2731       end.
     2732       else do:
     2733           assign
     2734               p-is-terminal = no
     2735           .
     2736       end.
     2737   end.
     2738   end procedure.
     2739   procedure fbrglib-have-goods :
     2740   do
     2741   on error undo, return error
     2742   :
     2743   define input parameter p-obj-type           as character    no-undo.
     2744   define input parameter p-obj-code           as integer      no-undo.
     2745   define input parameter p-node-code          as integer      no-undo.
     2746   define output parameter p-have-fbr-gds-obj  as logical      no-undo.
     2747       define buffer buf_fbr-gds-obj         for ub.fbr-gds-obj.
     2748       find first buf_fbr-gds-obj no-lock
     2749            where buf_fbr-gds-obj.obj-type     = p-obj-type
     2750              and buf_fbr-gds-obj.obj-code     = p-obj-code
     2751              and buf_fbr-gds-obj.fbr-grp-code = p-node-code
     2752       no-error .
     2753       if available buf_fbr-gds-obj
     2754       then do:
     2755           assign
     2756               p-have-fbr-gds-obj = yes
     2757           .
     2758       end.
     2759       else do:
     2760           assign
     2761               p-have-fbr-gds-obj = no
     2762           .
     2763       end.
     2764   end.
     2765   end procedure.
     2766   procedure fbrglib-find-by-substring :
     2767   do
     2768   on error undo, return error
     2769   :
     2770   define input parameter p-start-obj-type     as character    no-undo.
     2771   define input parameter p-start-obj-code     as integer      no-undo.
     2772   define input parameter p-start-code         as integer      no-undo.
     2773   define input parameter p-full-search-string as character    no-undo.
     2774   define output parameter p-found-code        as integer      no-undo.
     2775   define output parameter p-full-name         as character    no-undo.
     2776       define variable v-start-code     as integer           no-undo.
     2777       define variable v-found          as logical  init no  no-undo.
     2778       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     2779       search-grp:
     2780       for each buf_fbr-gds-grp no-lock
     2781           where buf_fbr-gds-grp.obj-type  = p-start-obj-type
     2782             and buf_fbr-gds-grp.obj-code  = p-start-obj-code
     2783             and buf_fbr-gds-grp.node-code > p-start-code
     2784       :
     2785           if index( buf_fbr-gds-grp.node-name, p-full-search-string ) <> 0
     2786           then do:
     2787               assign
     2788                   p-found-code = buf_fbr-gds-grp.node-code
     2789                   v-found      = yes
     2790               .
     2791               run fbrglib-get-full-name in this-procedure (
     2792                     input p-start-obj-type
     2793                   , input p-start-obj-code
     2794                   , input p-found-code
     2795                   , output p-full-name
     2796               ) no-error .
     2797               if error-status :error
     2798               then do:
     2799                   undo, return error "fbrglib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
     2800               end.
     2801               leave search-grp.
     2802           end.
     2803       end.
     2804       if v-found = yes
     2805       then do:
     2806       end.
     2807       else do:
     2808           assign
     2809               p-full-name  = ""
     2810               p-found-code = 0
     2811           .
     2812       end.
     2813   end.
     2814   end procedure.
     2815   procedure fbrglib-analyze-grp-name :
     2816   do
     2817   on error undo, return error
     2818   :
     2819   define input parameter p-grp-name       as character            no-undo.
     2820   define input parameter p-obj-type       as character            no-undo.
     2821   define input parameter p-obj-code       as integer              no-undo.
     2822   define input parameter p-upper-code     as integer              no-undo.
     2823   define output parameter p-error-message as character init ""    no-undo.
     2824       define variable v-char-list     as character    no-undo.
     2825       define variable v-char-counter  as integer      no-undo.
     2826       define variable v-full-name     as character    no-undo.
     2827       if p-grp-name = "" then do:
     2828           assign
     2829               p-error-message = "Название группы не может быть пустым.".
     2830           .
     2831       end.
     2832       else do:
     2833           assign
     2834               v-char-list = "47,92,58,63,34,60,62,171,187,183"
     2835           .
     2836           do v-char-counter = 1 to num-entries( v-char-list )
     2837           :
     2838               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
     2839               then do:
     2840                   assign
     2841                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
     2842                   .
     2843                   return.
     2844               end.
     2845           end.
     2846           run fbrglib-get-full-name in this-procedure (
     2847                 input p-obj-type
     2848               , input p-obj-code
     2849               , input p-upper-code
     2850               , output v-full-name
     2851           ) no-error .
     2852           if error-status :error
     2853           then do:
     2854               undo, return error "fbrglib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
     2855           end.
     2856           if length( v-full-name ) + 1 + length( p-grp-name ) > 120
     2857           then do:
     2858               assign
     2859                   p-error-message = 'Полное название группы не может содержать более 120 символов.'
     2860               .
     2861           end.
     2862       end.
     2863   end.
     2864   end procedure.
     2865   procedure fbrglib-delete-grp :
     2866   do
     2867   on error undo, return error
     2868   :
     2869   define input parameter p-obj-type   as character    no-undo.
     2870   define input parameter p-obj-code   as integer      no-undo.
     2871   define input parameter p-node-code  as integer      no-undo.
     2872   define output parameter p-deleted   as logical      no-undo.
     2873       define variable v-have-goods    as logical        no-undo.
     2874       define variable v-yesno         as logical        no-undo.
     2875       define variable v-upper-code    as integer        no-undo.
     2876       define variable v-root-code     as integer        no-undo.
     2877       define buffer buf_fbr-gds-grp           for ub.fbr-gds-grp.
     2878       define buffer buf_fbr-gds-obj           for ub.fbr-gds-obj.
     2879       define buffer buf_second_fbr-gds-grp    for ub.fbr-gds-grp.
     2880       run fbrglib-get-root-code in this-procedure (
     2881           output v-root-code
     2882       ) no-error.
     2883       if error-status :error
     2884       then do:
     2885           undo, return error "Не найден корневой узел." + chr(10) + return-value.
     2886       end.
     2887       if p-node-code = v-root-code
     2888       then do:
     2889           message
     2890               "Корневую группу удалить невозможно."
     2891           view-as alert-box error.
     2892           assign
     2893               p-deleted = no
     2894           .
     2895           undo, return.
     2896       end.
     2897       find first buf_fbr-gds-grp no-lock
     2898            where buf_fbr-gds-grp.obj-type     = p-obj-type
     2899              and buf_fbr-gds-grp.obj-code     = p-obj-code
     2900              and buf_fbr-gds-grp.upper-code   = p-node-code
     2901       no-error.
     2902       if available buf_fbr-gds-grp
     2903       then do:
     2904           message
     2905               "Не терминальную группу удалить невозможно."
     2906           view-as alert-box error.
     2907           assign
     2908               p-deleted = no
     2909           .
     2910           undo, return.
     2911       end.
     2912       find first buf_fbr-gds-grp no-lock
     2913            where buf_fbr-gds-grp.obj-type     = p-obj-type
     2914              and buf_fbr-gds-grp.obj-code     = p-obj-code
     2915              and buf_fbr-gds-grp.node-code    = p-node-code
     2916       .
     2917       assign
     2918           v-upper-code = buf_fbr-gds-grp.upper-code
     2919       .
     2920       run fbrglib-have-goods in this-procedure (
     2921             input p-obj-type
     2922           , input p-obj-code
     2923           , input p-node-code
     2924           , output v-have-goods
     2925       ).
     2926       if v-have-goods = yes
     2927       then do:
     2928           find first buf_second_fbr-gds-grp no-lock
     2929                where buf_second_fbr-gds-grp.obj-type      = buf_fbr-gds-grp.obj-type
     2930                  and buf_second_fbr-gds-grp.obj-code      = buf_fbr-gds-grp.obj-code
     2931                  and buf_second_fbr-gds-grp.upper-code    = buf_fbr-gds-grp.upper-code
     2932                  and recid( buf_second_fbr-gds-grp )      <> recid( buf_fbr-gds-grp )
     2933           no-error.
     2934           if available buf_second_fbr-gds-grp
     2935           then do:
     2936               message
     2937                   "В группе есть товары,"
     2938                   skip "которые нельзя перенести в родительскую группу,"
     2939                   skip "потому что у родительской группы есть еще одна подгруппа."
     2940                   skip(1)
     2941                   skip "Перенесите товары в другую группу"
     2942                   skip "или удалите все остальные подгруппы родительской группы."
     2943               view-as alert-box error.
     2944               assign
     2945                   p-deleted = no
     2946               .
     2947               undo, return.
     2948           end.
     2949           message
     2950               "В группе есть товары."
     2951               skip "После удаления группы"
     2952               skip "все ее товары будут привязаны"
     2953               skip "к ее родительской группе."
     2954               skip(1)
     2955               skip "Удалить группу?"
     2956           view-as alert-box warning
     2957           buttons yes-no
     2958           title "Удаление группы"
     2959           update v-yesno
     2960           .
     2961           if v-yesno = yes
     2962           then do:
     2963               do transaction
     2964               on error undo, return error
     2965               :
     2966                   for each buf_fbr-gds-obj exclusive-lock
     2967                      where buf_fbr-gds-obj.obj-type     = p-obj-type
     2968                        and buf_fbr-gds-obj.obj-code     = p-obj-code
     2969                        and buf_fbr-gds-obj.fbr-grp-code = p-node-code
     2970                   on error undo, return error
     2971                   :
     2972                       assign
     2973                           buf_fbr-gds-obj.fbr-grp-code = v-upper-code
     2974                       .
     2975                   end.
     2976               end.
     2977               do transaction
     2978               on error undo, return error
     2979               :
     2980                   find current buf_fbr-gds-grp exclusive-lock .
     2981                   delete buf_fbr-gds-grp no-error .
     2982                   if error-status:error then do:
     2983                     undo, return error return-value .
     2984                   end.
     2985               end.
     2986           end.
     2987       end.
     2988       else do:
     2989           message
     2990               "Имя группы: " buf_fbr-gds-grp.node-name
     2991               "Код группы: " buf_fbr-gds-grp.node-code
     2992               skip(1)
     2993               skip "Удалить группу?"
     2994           view-as alert-box warning
     2995           buttons yes-no
     2996           title "Удаление группы"
     2997           update v-yesno
     2998           .
     2999           if v-yesno = yes
     3000           then do:
     3001               do transaction
     3002               on error undo, return error
     3003               :
     3004                   find current buf_fbr-gds-grp exclusive-lock .
     3005                   delete buf_fbr-gds-grp no-error.
     3006                   if error-status:error then do:
     3007                     undo, return error return-value .
     3008                   end.
     3009               end.
     3010           end.
     3011       end.
     3012   end.
     3013   end procedure.
     3014   procedure fbrglib-add-grp :
     3015   do
     3016   on error undo, return error
     3017   :
     3018   define input parameter p-obj-type       as character    no-undo.
     3019   define input parameter p-obj-code       as integer      no-undo.
     3020   define input parameter p-node-code      as integer      no-undo.
     3021   define input parameter p-interface      as logical      no-undo.
     3022   define input parameter p-node-name      as character    no-undo.
     3023   define input parameter p-out-code       as integer      no-undo.
     3024   define input parameter p-global-code    as integer      no-undo.
     3025   define output parameter p-new-node-code as integer      no-undo.
     3026   define output parameter p-cancel        as logical      no-undo.
     3027       define variable v-have-goods    as logical  no-undo.
     3028       define variable v-host-code     as integer        no-undo.
     3029       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     3030       define buffer bf_fbr-gds-grp        for ub.fbr-gds-grp.
     3031       define buffer buf_fbr-gds-obj       for ub.fbr-gds-obj.
     3032       run fbrglib-have-goods in this-procedure (
     3033             input p-obj-type
     3034           , input p-obj-code
     3035           , input p-node-code
     3036           , output v-have-goods
     3037       ) no-error .
     3038       if error-status :error
     3039       then do:
     3040           message
     3041                    vss-workfile vss-revision vss-description
     3042               skip "Ошибка определения наличия товаров в группе."
     3043               skip return-value
     3044               skip trim(error-status :get-message(1))
     3045                    trim(error-status :get-message(2))
     3046                    trim(error-status :get-message(3))
     3047           view-as alert-box error.
     3048           undo, return error .
     3049       end.
     3050   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3051   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3052     (input  p-obj-type
     3053     ,input  p-obj-code
     3054     ,output v-host-code
     3055     )  .
     3056       find first buf_fbr-gds-grp no-lock where
     3057                 buf_fbr-gds-grp.upper-code = p-node-code
     3058             AND buf_fbr-gds-grp.obj-type   = p-obj-type
     3059             AND buf_fbr-gds-grp.obj-code   = p-obj-code
     3060             AND buf_fbr-gds-grp.node-name  = p-node-name no-error .
     3061       if available buf_fbr-gds-grp then do:
     3062           if p-node-code <> 1 then do:
     3063             find first buf_fbr-gds-grp no-lock where
     3064                       buf_fbr-gds-grp.node-code = p-node-code
     3065                   AND buf_fbr-gds-grp.obj-type   = p-obj-type
     3066                   AND buf_fbr-gds-grp.obj-code   = p-obj-code  .
     3067           end.
     3068                   message
     3069           "Для объекта" p-obj-type p-obj-code
     3070           "уже есть группа блюд" p-node-name "в подгруппе" (if p-node-code = 1 then "БЛЮДА" else buf_Fbr-gds-grp.node-name)
     3071           view-as alert-box error .
     3072           undo, return error .
     3073       end.
     3074       do transaction
     3075       on error undo, return error
     3076       :
     3077           create buf_fbr-gds-grp.
     3078           assign
     3079               buf_fbr-gds-grp.node-code   = next-value( s-gds-grp, ub )
     3080               p-new-node-code             = buf_fbr-gds-grp.node-code
     3081               buf_fbr-gds-grp.upper-code  = p-node-code
     3082               buf_fbr-gds-grp.host-code   = v-host-code
     3083               buf_fbr-gds-grp.obj-type    = p-obj-type
     3084               buf_fbr-gds-grp.obj-code    = p-obj-code
     3085               buf_fbr-gds-grp.node-name    = ""
     3086               buf_fbr-gds-grp.out-code    = 0
     3087           .
     3088           if p-interface then do:
     3089             run ref/fbrggrpd.w (
     3090                   input parparentproc
     3091                 , input 'ИЗМЕНЕНИЕ':U
     3092                 , input p-obj-type
     3093                 , input p-obj-code
     3094                 , input buf_fbr-gds-grp.node-code
     3095                 , input buf_fbr-gds-grp.upper-code
     3096                 , input buf_fbr-gds-grp.node-name
     3097                 , input buf_fbr-gds-grp.out-code
     3098                 , output buf_fbr-gds-grp.node-name
     3099                 , output buf_fbr-gds-grp.out-code
     3100                 , output p-cancel
     3101             ).
     3102             if p-cancel = yes
     3103             then do:
     3104                 delete buf_fbr-gds-grp.
     3105                 undo, return.
     3106             end.
     3107           end.
     3108           else do:
     3109             find first bf_fbr-gds-grp no-lock
     3110                 where bf_fbr-gds-grp.obj-type   = p-obj-type
     3111                   and bf_fbr-gds-grp.obj-code   = p-obj-code
     3112                   and bf_fbr-gds-grp.out-code   = p-out-code
     3113             no-error.
     3114             assign
     3115             buf_fbr-gds-grp.node-name    = p-node-name
     3116             buf_fbr-gds-grp.global-code  = p-global-code
     3117             buf_fbr-gds-grp.out-code     = (if available bf_fbr-gds-grp then 0 else p-out-code)
     3118             .
     3119           end.
     3120           if v-have-goods = yes
     3121           then do:
     3122               for each buf_fbr-gds-obj exclusive-lock
     3123                  where buf_fbr-gds-obj.obj-type      = p-obj-type
     3124                    and buf_fbr-gds-obj.obj-code      = p-obj-code
     3125                    and buf_fbr-gds-obj.fbr-grp-code  = p-node-code
     3126               on error undo, return error
     3127               :
     3128                   assign
     3129                       buf_fbr-gds-obj.fbr-grp-code = p-new-node-code
     3130                   .
     3131               end.
     3132           end.
     3133       end.
     3134   end.
     3135   end procedure.
     3136     define new shared temp-table  tt-tax no-undo
     3137   field tax-code    like ub.tax.tax-code
     3138   FIELD individual  like ub.tax.individual
     3139   FIELD tax-name    like ub.tax.tax-name format "X(12)" column-label "Налог"
     3140   field rate-code   like ub.tax-rate.rate-code
     3141   FIELD rate-name   like ub.tax-rate.rate-name FORMAT "X(12)"
     3142   FIELD tax-type    like ub.tax.tax-type
     3143   field rate-value  like ub.tax-rate-value.rate-value
     3144   FIELD tax-rate-gds-rc  as recid
     3145   FIELD to-cashdesk like ub.tax.to-cashdesk
     3146   FIELD fact-date like ub.tax-rate-value.fact-date
     3147   FIELD fact-order like ub.tax-rate-value.fact-order
     3148   FIELD next-order like ub.tax-rate-value.fact-order
     3149   FIELD corr-user-name like ub.tax-rate-gds.corr-user-name
     3150   FIELD corr-user-db-num   like ub.tax-rate-gds.corr-user-db-num
     3151   FIELD corr-date like ub.tax-rate-gds.corr-date
     3152   FIELD corr-time like ub.tax-rate-gds.corr-time
     3153   index tax-code is unique primary tax-code fact-order descending rate-code.
     3154   define temp-table temp-goods-attr no-undo like ub.goods-attr.
     3155   define temp-table temp-fbr-gds-grp no-undo like ub.fbr-gds-grp
     3156   field f-name as character .
     3157   define variable v-current-gds-code as integer no-undo .
     3158   define variable v-current-artic as character no-undo .
     3159   define variable v-current-prod-type as character no-undo .
     3160   define variable v-current-prod-code as integer no-undo .
     3161   define variable v-current-host-code as integer no-undo .
     3162   define variable v-current-obj-type as character no-undo .
     3163   define variable v-current-obj-code as integer no-undo .
     3164   define variable v-current-lock as integer no-undo .
     3165   define variable v-current-wait as integer no-undo .
     3166   define variable v-save as integer no-undo .
     3167   define variable v-esys-cmd-proc-handle as handle no-undo .
     3168   define variable v-esys-cmd-code as integer no-undo .
     3169   define variable log-file-name                as character      no-undo init "process-gds-list.txt".
     3170   define variable v-view-log                   as logical        no-undo .
     3171   define variable v-stop                       as logical        no-undo .
     3172   define variable v-current-db-num as integer no-undo .
     3173   define variable v-last-error-message as character no-undo .
     3174   define variable file-name as char.
     3175   define variable v-sign as integer no-undo .
     3176   define variable v-gate-rec as character no-undo .
     3177   define variable num-rec as integer no-undo .
     3178   define variable num-rec-ok as integer no-undo .
     3179   define variable v-esys-id-list-start as character no-undo .
     3180   define variable v-pck-num-rec as integer no-undo init 1000.
     3181   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3182   procedure set-error :
