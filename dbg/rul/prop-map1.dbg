        1   block-level on error undo, throw.
        2   define input parameter        p-mode as character no-undo .
        3   define input parameter        p-silent as logical no-undo .
        4   define input-output parameter p-rec  as recid     no-undo .
        5   define input parameter        p-dtm-code as integer no-undo .
        6   define input parameter        p-node-code            as integer no-undo .
        7   define input parameter        p-upper-node-code      as integer no-undo .
        8   define input parameter        p-upper-node-name      as character no-undo .
        9   define input parameter        p-node-type            as integer no-undo .
       10   define input parameter        p-is-collection        as logical no-undo .
       11   define input parameter        p-rw-option            as character no-undo .
       12   define input parameter        p-node-name            as character no-undo .
       13   define input parameter        p-node-label           as character no-undo .
       14   define input parameter        p-node-value-type      as character no-undo .
       15   define input parameter        p-node-format          as character no-undo .
       16   define input parameter        p-node-description     as character no-undo .
       17   define input parameter        p-is-term              as logical no-undo .
       18   define input parameter        p-init-value-character as character no-undo .
       19   define input parameter        p-init-value-date      as date no-undo .
       20   define input parameter        p-init-value-decimal   as decimal no-undo .
       21   define input parameter        p-init-value-integer   as integer no-undo .
       22   define input parameter        p-init-value-logical   as logical no-undo .
       23   define variable vss-revision    as character no-undo init "$Revision$":U .
       24   define variable vss-author      as character no-undo init "$Author$":U .
       25   define variable vss-date        as character no-undo init "$Date$":U .
       26   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       27   define variable vss-archive     as character no-undo init "$Archive$":U .
       28   define variable vss-description as character no-undo init "Сохранение prop-map".
       29   procedure vss-get-info :
       30     define output parameter p-vss-revision    like vss-revision    no-undo .
       31     define output parameter p-vss-author      like vss-author      no-undo .
       32     define output parameter p-vss-date        like vss-date        no-undo .
       33     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       34     define output parameter p-vss-archive     like vss-archive     no-undo .
       35     define output parameter p-vss-description like vss-description no-undo .
       36     assign
       37       p-vss-revision    = vss-revision
       38       p-vss-author      = vss-author
       39       p-vss-date        = vss-date
       40       p-vss-workfile    = vss-workfile
       41       p-vss-archive     = vss-archive
       42       p-vss-description = vss-description
       43     .
       44   end procedure.
       45   procedure vss-get-parameters :
       46     define output parameter p-vss-parameters as character no-undo .
       47   end procedure.
       48   define new global shared variable g#vssrevis-logger as handle    no-undo .
       49   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       50   define variable v-vssrevis-logger                   as handle    no-undo .
       51   procedure vss-logevent :
       52     define input  parameter p-extra-paramters as character no-undo .
       53     define variable v-vssrevis-parameters as character no-undo .
       54     do
       55     on error undo, return error return-value
       56     :
       57       if  valid-handle(v-vssrevis-logger)
       58       and v-vssrevis-logger :get-signature("logevent") <> ""
       59       then do:
       60         run vss-get-parameters in this-procedure
       61           (output v-vssrevis-parameters
       62           ).
       63         run logevent in v-vssrevis-logger
       64           (input vss-workfile
       65           ,input vss-revision
       66           ,input v-vssrevis-parameters
       67           ,input p-extra-paramters
       68           ).
       69       end.
       70     end.
       71   end procedure.
       72   assign
       73     v-vssrevis-logger = g#vssrevis-logger
       74   .
       75   if  valid-handle(v-vssrevis-logger)
       76   and v-vssrevis-logger :get-signature("logevent") <> ""
       77   then do:
       78     assign
       79       v-vssrevis-logevent = true
       80     .
       81     run vss-logevent in this-procedure (input vss-description) .
       82   end.
       83   define new global shared variable g#language as character no-undo .
       84   if g#language <> '' and g#language <> 'rus':U then do:
       85     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       86   end.
       87   define new global shared variable g#library  as handle no-undo .
       88   define new global shared variable g#library2 as handle no-undo .
       89   define   shared variable g#auto as logical no-undo.
       90   define   shared variable g#news as logical no-undo.
       91   define   shared variable g#oxml as logical no-undo.
       92   define   shared variable g#esys as logical no-undo.
       93   define   shared variable g#news-source-db as integer no-undo.
       94   define   shared variable g#esys-source-esys as integer no-undo.
       95   define   shared variable g#db-num as integer   no-undo .
       96   define   shared variable g#userid as character no-undo .
       97   define   shared variable g#passwd as character no-undo .
       98   define variable v-mess as character no-undo .
       99   define variable v-entry as character no-undo .
      100   define buffer buf_prop-map for ub.prop-map.
      101   define buffer buf2_prop-map for ub.prop-map.
      102   define buffer buf_prop-head for ub.prop-head.
      103   define buffer last_prop-map for ub.prop-map.
      104   if p-mode <> 'ДОБАВЛЕНИЕ':U
      105   AND p-mode <> 'ИЗМЕНЕНИЕ':U then do:
      106     message vss-workfile vss-revision vss-description skip
      107             "Неверный параметр p-mode - " p-mode
      108     view-as alert-box error .
      109     return error '':u.
      110   end.
      111   if g#db-num <> 0 then do:
      112     message vss-workfile vss-revision vss-description skip
      113             "Запрещено вызывать процедуру в УБД"
      114     view-as alert-box error .
      115     return error '':u.
      116   end.
      117   _main:
      118   do for buf_prop-map
      119   on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      120   on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
      121   on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
      122   :
      123     if p-dtm-code = 0 then do:
      124       assign
      125       v-mess = "Код объекта-операнда не может = 0".
      126       run err-mess in this-procedure ( input-output v-mess).
      127       return error (if p-silent = yes then v-mess else 'dtm-code':U).
      128     end.
      129     find first buf_prop-head no-lock where
      130               buf_prop-head.dtm-code = p-dtm-code no-error.
      131     if not available buf_prop-head then do:
      132       assign
      133       v-mess = "Неверный код объекта-операнда".
      134       run err-mess in this-procedure ( input-output v-mess).
      135       return error (if p-silent = yes then v-mess else 'dtm-code':U).
      136     end.
      137     if p-node-name = '':u then do:
      138       assign
      139       v-mess = "Имя свойства не может быть пустым".
      140       run err-mess in this-procedure ( input-output v-mess).
      141       return error (if p-silent = yes then v-mess else 'prop-name':U).
      142     end.
      143     if p-node-label = '':u then do:
      144       assign
      145       v-mess = "Лейбл свойства не может быть пустым".
      146       run err-mess in this-procedure ( input-output v-mess).
      147       return error (if p-silent = yes then v-mess else 'node-label':U).
      148     end.
      149     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      150       find first buf_prop-map no-lock where
      151             buf_prop-map.dtm-code = p-dtm-code
      152         and buf_prop-map.node-code = p-node-code no-error.
      153       if available buf_prop-map then do:
      154         assign
      155         v-mess = "Уже существует свойство c таким кодом для данного объекта".
      156         run err-mess in this-procedure ( input-output v-mess).
      157         return error (if p-silent = yes then v-mess else 'node-code':U).
      158       end.
      159       find first buf_prop-map no-lock where
      160             buf_prop-map.node-name = p-node-name
      161         and buf_prop-map.dtm-code = p-dtm-code no-error.
      162       if available buf_prop-map
      163       and buf_prop-map.node-code <> p-node-code
      164       then do:
      165         assign
      166         v-mess = "Уже существует свойство с таким именем для данного объекта".
      167         run err-mess in this-procedure ( input-output v-mess).
      168         return error (if p-silent = yes then v-mess else 'node-name':U).
      169       end.
      170       create buf_prop-map.
      171       assign
      172       buf_prop-map.dtm-code = p-dtm-code
      173       buf_prop-map.node-code = p-node-code
      174       .
      175     end.
      176     if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      177       find first buf_prop-map exclusive-lock where
      178                 recid(buf_prop-map) = p-rec .
      179       if buf_prop-map.dtm-code <> p-dtm-code
      180       or buf_prop-map.node-code <> p-node-code
      181       then do:
      182         assign
      183         v-mess = substitute("Для уже существующего свойства невозможно изменение кода и принадлежности к объекту&1" +
      184                                 "старые значения кода объекта и кода свойства: &2 и &3"
      185                                 , chr(10)
      186                                 , buf_prop-map.dtm-code
      187                                 , buf_prop-map.node-code
      188                                 )
      189         .
      190         run err-mess in this-procedure ( input-output v-mess).
      191         return error (if p-silent = yes then v-mess else 'dtm-code':U).
      192       end.
      193       find first buf2_prop-map no-lock where
      194             buf2_prop-map.node-name = p-node-name
      195         and buf2_prop-map.dtm-code = p-dtm-code
      196         no-error.
      197       if available buf2_prop-map
      198       and buf2_prop-map.node-code <> p-node-code
      199       then do:
      200         assign
      201         v-mess = "Уже существует свойство c таким именем для данного объекта операнда".
      202         run err-mess in this-procedure ( input-output v-mess).
      203         return error (if p-silent = yes then v-mess else 'node-name':U).
      204       end.
      205     end.
      206     if p-mode = 'ДОБАВЛЕНИЕ':U
      207     or (p-mode = 'ИЗМЕНЕНИЕ':U and buf_prop-map.ordinal = 0) then do:
      208       find last last_prop-map no-lock where
      209               last_prop-map.dtm-code = p-dtm-code
      210           and last_prop-map.upper-node-code = p-upper-node-code no-error.
      211     end.
      212     assign
      213     buf_prop-map.node-name            = p-node-name
      214     buf_prop-map.node-label           = p-node-label
      215     buf_prop-map.upper-node-code      = p-upper-node-code
      216     buf_prop-map.upper-node-name      = p-upper-node-name
      217     buf_prop-map.node-type            = p-node-type
      218     buf_prop-map.is-collection        = p-is-collection
      219     buf_prop-map.rw-option            = p-rw-option
      220     buf_prop-map.node-value-type      = p-node-value-type
      221     buf_prop-map.node-format          = p-node-format
      222     buf_prop-map.node-description     = p-node-description
      223     buf_prop-map.is-term              = p-is-term
      224     buf_prop-map.init-value-character = p-init-value-character
      225     buf_prop-map.init-value-date      = p-init-value-date
      226     buf_prop-map.init-value-decimal   = p-init-value-decimal
      227     buf_prop-map.init-value-integer   = p-init-value-integer
      228     buf_prop-map.init-value-logical   = p-init-value-logical
      229     buf_prop-map.ordinal              = (if available  last_prop-map
      230                                          then last_prop-map.ordinal + 1
      231                                          else 1)
      232     p-rec = recid(buf_prop-map)
      233     .
      234     release buf_prop-head no-error.
      235     if error-status:error then do:
      236         assign
      237         v-mess = substitute("Ошибка при сохранении записи:&1&2&1&3", chr(10), error-status:get-message(1) , return-value ).
      238         run err-mess in this-procedure ( input-output v-mess).
      239         return error (if p-silent = yes then v-mess else 'prop-name':U).
      240     end.
      241   end.
      242   PROCEDURE err-mess:
      243     DEFINE INPUT-OUTPUT PARAMETER p-mess as character No-UNDO.
      244     CASE p-silent:
      245       when yes then do:
      246         assign
      247         p-mess = substitute("Свойство объекта: код объекта &1 код свойства &2:&3 &4"
      248                            , p-dtm-code
      249                            , p-node-code
      250                            , chr(10)
      251                            , p-mess
      252                            )
      253         .
      254       end.
      255       when no then do:
      256         message
      257         p-mess
      258         view-as alert-box error .
      259       end.
      260     end.
      261   END PROCEDURE.
