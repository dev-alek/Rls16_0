     3420   procedure set-error :
     3421   define input parameter p-mess as character no-undo .
     3422     do
     3423     on error undo, return error
     3424     :
     3425        assign
     3426        v-last-error-message = p-mess.
     3427     end.
     3428   end procedure.
     3429   define buffer buf_temp-cmd for temp-cmd.
     3430   define buffer buf_temp-xml-tables for temp-xml-tables.
     3431   function 00200004_get-error-message returns character :
     3432   define variable v-ii as integer no-undo .
     3433   define variable v-mess as character no-undo .
     3434   DO v-ii = 1 TO ERROR-STATUS:NUM-MESSAGES:
     3435       v-mess = substitute("&1&2ош &3"
     3436                           ,v-mess
     3437                           ,chr(10)
     3438                           ,ERROR-STATUS:GET-MESSAGE(v-ii)).
     3439   END.
     3440   return v-mess.
     3441   end function.
     3442   function 00200004_after-import_f returns logical ( input p-d-card as character):
     3443     run 00200004_after-import in this-procedure ( input p-d-card) no-error.
     3444     run set-error in this-procedure ( input return-value ).
     3445     return not (error-status:error).
     3446   end function.
     3447   define variable p-esys-id as integer no-undo .
     3448   define variable p-xsd-file as character no-undo.
     3449   on delete of this-procedure do:
     3450     run delete-procedure in this-procedure .
     3451     run gate-clear in this-procedure ( input v_dataseth, input v-xmlh) no-error.
     3452   end.
     3453   run load-ruleset-context in this-procedure ( input p-ruleset-id) no-error .
     3454   if error-status:error
     3455   or return-value = "return" then return error.
     3456   define variable ImpData1 as class Route-data_ no-undo .
     3457   ImpData1 = new Route-data_( input parparentproc, input p-parent-handle, input p-log-handle, input this-procedure:handle, input v_dataseth, input v-xmlh) .
     3458   if not this-procedure:persistent then do:
     3459     run proc-main in this-procedure no-error .
     3460     if error-status:error then do:
     3461         run delete-procedure in this-procedure .
     3462         undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     3463     end.
     3464     run delete-procedure in this-procedure .
     3465   end.
     3466   procedure proc-main :
     3467   define variable v-current-code-bank as integer no-undo .
     3468   define variable v-bank-name as character no-undo .
     3469   define variable v-short-name as character no-undo .
     3470   define variable v-bik as character no-undo .
     3471   define variable v-addres as character no-undo .
     3472   define variable v-bank-city as character no-undo .
     3473   define variable v-ps as character no-undo .
     3474   define variable v-mode as character no-undo .
     3475   define variable v-line-num as integer no-undo .
     3476   define variable v-present as logical no-undo .
     3477   define variable v-line-status_ as character no-undo .
     3478   define variable v-rec as recid no-undo .
     3479   define variable v-rid as recid no-undo .
     3480   define buffer buf_fin-bank for ub.fin-bank.
     3481   define buffer buf_sysconf for ub.sysconf.
     3482   _main:
     3483   do transaction
     3484   on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3485   on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
     3486   on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
     3487   :
     3488   run write-log  in p-log-handle (
     3489                                    input 0
     3490                                  , "&DLine").
     3491     run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute(".............Импорт данных по банкам из ВС")).
     3492   run write-log-and-file in p-log-handle (
     3493         input 1
     3494       , input log-file-name
     3495       , input 1
     3496       , input substitute("Импорт данных по банкам из файла &1", file-name)).
     3497   for each buf_temp-xml-tables where buf_temp-xml-tables.order >= 0:
     3498     create query v_qh.
     3499     glog = v_qh:set-buffers( buf_temp-xml-tables.tbl-handle_) no-error.
     3500     if error-status:error
     3501     or
     3502     not glog then do:
     3503           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при попытке получить записи &1&2&3&2&4"                                                             , buf_temp-xml-tables.tbl-name                                                             , chr(10)                                                             , error-status:get-message(1)                                                             , return-value)).
     3504       undo _main, return error ''.
     3505     end.
     3506     glog = v_qh:query-prepare( substitute( "for each &1 by &1.line-num", buf_temp-xml-tables.tbl-name)) no-error .
     3507     if error-status:error
     3508     or
     3509     not glog then do:
     3510           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при попытке получить записи &1&2&3&2&4"                                                             , buf_temp-xml-tables.tbl-name                                                             , chr(10)                                                             , error-status:get-message(1)                                                             , return-value)).
     3511       if valid-handle(v_qh) then do:
     3512         delete object v_qh no-error.
     3513       end.
     3514       undo _main, return error ''.
     3515     end.
     3516     glog = v_qh:query-open no-error .
     3517     if error-status:error
     3518     or not glog then do:
     3519       run write-log-and-file in p-log-handle (
     3520                                               input 1
     3521                                             , input log-file-name
     3522                                             , input 1
     3523                                             , input substitute("Ошибка при попытке получить записи &1&2&3&2&4"
     3524                                                               , buf_temp-xml-tables.tbl-name
     3525                                                               , chr(10)
     3526                                                               , error-status:get-message(1)
     3527                                                               , return-value)).
     3528       if valid-handle(v_qh) then do:
     3529         delete object v_qh no-error.
     3530       end.
     3531       undo _main, return error ''.
     3532     end.
     3533       _stroka:
     3534       REPEAT:
     3535         v-retry-action = 0 .
     3536        _release:
     3537         do on error undo, retry:
     3538           if  retry then do:
     3539             v-retry-action = v-retry-action + 1.
     3540                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при импорте записи &5 &1&2&3&2&4"                                                                   , buf_temp-xml-tables.tbl-name                                                                   , num-rec                                                                   , chr(10)                                                                   , error-status:get-message(1)                                                                   , return-value)).
     3541             if valid-handle(v_qh) then do:
     3542               delete object v_qh no-error.
     3543             end.
     3544             undo _main, return error ''.
     3545           end.
     3546         if v-retry-action < 1 then do:
     3547                   ImpData1:Route-data_dump ( ) .
     3548         end.
     3549         end.
     3550         _rule:
     3551          do on error undo _rule, retry _rule:
     3552            if retry then do:
     3553              if valid-handle(v_qh) then do:
     3554                delete object v_qh no-error.
     3555              end.
     3556                         run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("&1&2&3"                                       , error-status:get-message(1)                                       , chr(10)                                       , return-value)).
     3557              undo _main, return error ''.
     3558            end.
     3559            else do:
     3560             v_qh:get-next().
     3561             IF v_qh:query-off-end then leave _stroka.
     3562             IF ImpData1:current-tbl-name( ) = 'fin-bank':U  THEN do:
     3563               _tr:
     3564               do
     3565               on error undo _rule, retry _rule
     3566               :
     3567                 v-current-code-bank = 0.
     3568                 v-line-num = ImpData1:route-data_get-field-integer( input 'fin-bank':U, input "line-num") .
     3569                 v-present = no.
     3570                 num-rec = num-rec + 1.
     3571                 v-current-code-bank = ImpData1:route-data_get-field-integer( input 'fin-bank':U, input "code-bank") .
     3572                 v-bank-name = ImpData1:route-data_get-field-character( input 'fin-bank':U, input "bank-name") .
     3573                 v-short-name = ImpData1:route-data_get-field-character( input 'fin-bank':U, input "short-name") .
     3574                 v-bik = ImpData1:route-data_get-field-character( input 'fin-bank':U, input "bik") .
     3575                 v-addres = ImpData1:route-data_get-field-character( input 'fin-bank':U, input "addres") .
     3576                 v-bank-city = ImpData1:route-data_get-field-character( input 'fin-bank':U, input "bank-city") .
     3577                 for each buf_sysconf no-lock
     3578                 on error  undo _rule, retry _rule
     3579                 on stop   undo _rule, retry _rule
     3580                 on endkey undo _rule, retry _rule
     3581                 :
     3582                   find first buf_fin-bank share-lock where
     3583                             buf_fin-bank.host-code = buf_sysconf.host-code
     3584                         and buf_fin-bank.code-bank = v-current-code-bank no-error.
     3585                    if available buf_fin-bank then do:
     3586                      v-rid = recid(buf_fin-bank).
     3587                      v-mode = 'ИЗМЕНЕНИЕ':U.
     3588                    end.
     3589                    else do:
     3590                      v-rid = ?.
     3591                      v-mode = 'ДОБАВЛЕНИЕ-ИМПОРТ':U.
     3592                    end.
     3593                   run ref/finbank1.p (
     3594                                       input-output v-rid
     3595                                       ,input v-mode
     3596                                       ,input yes
     3597                                       ,input ""
     3598                                       ,input "":U
     3599                                       ,input buf_sysconf.host-code
     3600                                       ,input v-current-code-bank
     3601                                       ,input v-addres
     3602                                       ,input v-bank-city
     3603                                       ,input (if v-mode = 'ДОБАВЛЕНИЕ-ИМПОРТ':U then '' else buf_fin-bank.addres1)
     3604                                       ,input v-bank-name
     3605                                       ,input v-bik
     3606                                       ,input (if v-mode = 'ДОБАВЛЕНИЕ-ИМПОРТ':U then '' else buf_fin-bank.cor-acc)
     3607                                       ,input (if v-mode = 'ДОБАВЛЕНИЕ-ИМПОРТ':U then '' else buf_fin-bank.e-mail)
     3608                                       ,input (if v-mode = 'ДОБАВЛЕНИЕ-ИМПОРТ':U then '' else buf_fin-bank.fax)
     3609                                       ,input (if v-mode = 'ДОБАВЛЕНИЕ-ИМПОРТ':U then '' else buf_fin-bank.inn)
     3610                                       ,input (if v-mode = 'ДОБАВЛЕНИЕ-ИМПОРТ':U then '' else buf_fin-bank.kpp)
     3611                                       ,input (if v-mode = 'ДОБАВЛЕНИЕ-ИМПОРТ':U then '' else buf_fin-bank.licenz)
     3612                                       ,input (if v-mode = 'ДОБАВЛЕНИЕ-ИМПОРТ':U then '' else buf_fin-bank.okato)
     3613                                       ,input (if v-mode = 'ДОБАВЛЕНИЕ-ИМПОРТ':U then '' else buf_fin-bank.okonx)
     3614                                       ,input (if v-mode = 'ДОБАВЛЕНИЕ-ИМПОРТ':U then '' else buf_fin-bank.okpo)
     3615                                       ,input (if v-mode = 'ДОБАВЛЕНИЕ-ИМПОРТ':U then '' else buf_fin-bank.otdel)
     3616                                       ,input (if v-mode = 'ДОБАВЛЕНИЕ-ИМПОРТ':U then '' else buf_fin-bank.phone)
     3617                                       ,input v-ps
     3618                                       ,input (if v-mode = 'ДОБАВЛЕНИЕ-ИМПОРТ':U then '' else buf_fin-bank.rkc)
     3619                                       ,input v-short-name
     3620                                       ,input (if v-mode = 'ДОБАВЛЕНИЕ-ИМПОРТ':U then '' else buf_fin-bank.cl-bank)
     3621                                       )
     3622                                       no-error.
     3623                 end.
     3624                 if error-status:error then do:
     3625                                   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Запись &1: &2&3&4"                                              , v-line-num                                             , error-status:get-message(1)                                             , chr(10)                                             , return-value)).
     3626                   run set-err-type in p-cont-handle
     3627                     ( input 'PROCESSING'
     3628                     ) no-error.
     3629                   if valid-handle(v_qh) then do:
     3630                     delete object v_qh no-error.
     3631                   end.
     3632                   undo _rule, retry _rule .
     3633                 end.
     3634               end.
     3635             end.
     3636           end.
     3637         end.
     3638         v-retry-action = 0 .
     3639        _release:
     3640         do on error undo, retry:
     3641           if  retry then do:
     3642             v-retry-action = v-retry-action + 1.
     3643                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("&1&2&3"                                       , error-status:get-message(1)                                       , chr(10)                                       , v-last-error-message )).
     3644             undo _main, return error ''.
     3645           end.
     3646         if v-retry-action < 1 then do:
     3647                   ImpData1:Route-data_dump ( ) .
     3648         end.
     3649         end.
     3650         if v-retry-action = 0 then do:
     3651           num-rec-ok = num-rec-ok + 1.
     3652         end.
     3653         run write-counter in p-log-handle ( input substitute("Обработано записей: &1, из них удачно: &2", num-rec, num-rec-ok)).
     3654       end.
     3655       v_qh:query-close().
     3656       if valid-handle(v_qh) then do:
     3657         delete object v_qh.
     3658       end.
     3659     end.
     3660     run write-log-and-file in p-log-handle (
     3661           input 1
     3662         , input log-file-name
     3663         , input 1
     3664         , input substitute("Обработано записей: &1, из них удачно: &2", num-rec, num-rec-ok)).
     3665   end.
     3666   end procedure.
     3667   procedure load-ruleset-context :
     3668   define input parameter p-ruleset-id as integer no-undo .
     3669   define buffer buf_rule-call-param for ub.rule-call-param.
     3670   define buffer buf_ext-system for ub.ext-system.
     3671   do
     3672   on error undo, return error
     3673   :
     3674    find first buf_rule-call-param no-lock where
     3675   buf_rule-call-param.codex_id = p-codex-id
     3676   and buf_rule-call-param.ruleset_id = p-ruleset-id
     3677   and buf_rule-call-param.call_id = p-call-id
     3678   and buf_rule-call-param.order_id = p-order-id
     3679   and buf_rule-call-param.rule_id = p-rule-id
     3680   and buf_rule-call-param.param-name = "p-esys-id"
     3681    no-error.
     3682   if available buf_rule-call-param then do:
     3683   assign p-esys-id = buf_rule-call-param.param-value-integer.
     3684   end.
     3685       find first buf_rule-call-param no-lock where
     3686   buf_rule-call-param.codex_id = p-codex-id
     3687   and buf_rule-call-param.ruleset_id = p-ruleset-id
     3688   and buf_rule-call-param.call_id = p-call-id
     3689   and buf_rule-call-param.order_id = p-order-id
     3690   and buf_rule-call-param.rule_id = p-rule-id
     3691   and buf_rule-call-param.param-name = "p-xsd-file"
     3692    no-error.
     3693   if available buf_rule-call-param then do:
     3694   assign p-xsd-file = buf_rule-call-param.param-value-character.
     3695   end.
     3696       case p-ruleset-id:
     3697         when 4 then do:
     3698           assign
     3699           v-sign = 1
     3700           v-current-host-code = p-host-code
     3701           v-current-obj-type = p-obj-type
     3702           v-current-obj-code = p-obj-code
     3703           v-current-db-num = g#db-num
     3704           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     3705           file-name  = entry(1, p-process-file-name, chr(4))
     3706           v_dataseth = handle(entry(2, p-process-file-name, chr(4)))
     3707           v-xmlh = buffer buf_temp-xml-tables:handle
     3708           v-esys-id = integer(p-doc-code)
     3709           v-extension = entry(num-entries(file-name, "."), file-name, ".")
     3710           v-pck-num = integer(entry(3, p-process-file-name, chr(4)))
     3711           log-file-name = entry(4, p-process-file-name, chr(4))
     3712           no-error
     3713           .
     3714           if error-status:error then do:
     3715                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибки параметров&1&2 ..."                                         , chr(10)                                         , error-status:get-message(1) )).
     3716             undo, return error substitute("Ошибки параметров&1&2 ..."                                         , chr(10)                                         , error-status:get-message(1) ).
     3717           end.
     3718           find first buf_ext-system no-lock where
     3719                     buf_ext-system.esys-id = v-esys-id
     3720                 and buf_ext-system.db-num = 0 no-error .
     3721           if not available buf_ext-system then do:
     3722                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не найдена ВС &1&2 ..."                                         , v-esys-id                                         , chr(10)                                         )).
     3723             undo, return error substitute("Не найдена ВС &1&2 ..."                                         , v-esys-id                                         , chr(10)                                         ).
     3724           end.
     3725           if v-extension = ''
     3726           or lookup(v-extension, "dat") = 0 then do:
     3727                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Файл &1 имеет недопустимое расширение &3&2 ..."                                         ,file-name                                         , chr(10)                                         , v-extension                                         )).
     3728             undo, return error substitute("Файл &1 имеет недопустимое расширение &3&2 ..."                                         ,file-name                                         , chr(10)                                         , v-extension                                         ).
     3729           end.
     3730         end.
     3731         otherwise do:
     3732           undo, return error "Неправильный вызов".
     3733         end.
     3734       end case.
     3735     end.
     3736   end procedure.
     3737   procedure delete-procedure :
     3738     do
     3739     on error undo, return error
     3740     :
     3741         run garbcoll_clear in this-procedure .
     3742     end.
     3743   end procedure.
