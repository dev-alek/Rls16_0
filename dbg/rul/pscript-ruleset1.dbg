        1   block-level on error undo, throw.
        2   define input parameter        p-mode as character no-undo .
        3   define input parameter        p-silent as logical no-undo .
        4   define input-output parameter p-rec  as recid     no-undo .
        5   define input parameter        p-codex-id as integer no-undo .
        6   define input parameter        p-ruleset-id as integer no-undo .
        7   define input parameter        p-dtm-code as integer no-undo .
        8   define input parameter        p-language as character no-undo .
        9   define input parameter        p-script-name as character no-undo .
       10   define input parameter        p-revis-id as integer no-undo .
       11   define variable vss-revision    as character no-undo init "$Revision$":U .
       12   define variable vss-author      as character no-undo init "$Author$":U .
       13   define variable vss-date        as character no-undo init "$Date$":U .
       14   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       15   define variable vss-archive     as character no-undo init "$Archive$":U .
       16   define variable vss-description as character no-undo init "Сохранение привязки prop-script к ruleset".
       17   procedure vss-get-info :
       18     define output parameter p-vss-revision    like vss-revision    no-undo .
       19     define output parameter p-vss-author      like vss-author      no-undo .
       20     define output parameter p-vss-date        like vss-date        no-undo .
       21     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       22     define output parameter p-vss-archive     like vss-archive     no-undo .
       23     define output parameter p-vss-description like vss-description no-undo .
       24     assign
       25       p-vss-revision    = vss-revision
       26       p-vss-author      = vss-author
       27       p-vss-date        = vss-date
       28       p-vss-workfile    = vss-workfile
       29       p-vss-archive     = vss-archive
       30       p-vss-description = vss-description
       31     .
       32   end procedure.
       33   procedure vss-get-parameters :
       34     define output parameter p-vss-parameters as character no-undo .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75   define new global shared variable g#library  as handle no-undo .
       76   define new global shared variable g#library2 as handle no-undo .
       77   define   shared variable g#auto as logical no-undo.
       78   define   shared variable g#news as logical no-undo.
       79   define   shared variable g#oxml as logical no-undo.
       80   define   shared variable g#esys as logical no-undo.
       81   define   shared variable g#news-source-db as integer no-undo.
       82   define   shared variable g#esys-source-esys as integer no-undo.
       83   define   shared variable g#db-num as integer   no-undo .
       84   define   shared variable g#userid as character no-undo .
       85   define   shared variable g#passwd as character no-undo .
       86   define variable v-mess as character no-undo .
       87   define variable v-entry as character no-undo .
       88   define buffer buf_ruleset for ub.ruleset.
       89   define buffer buf_pscript-ruleset for ub.pscript-ruleset.
       90   define buffer buf_prop-script for ub.prop-script.
       91   if p-mode <> 'ДОБАВЛЕНИЕ':U
       92   then do:
       93     message vss-workfile vss-revision vss-description skip
       94             "Неверный параметр p-mode - " p-mode
       95     view-as alert-box error .
       96     return error '':u.
       97   end.
       98   _main:
       99   do for buf_ruleset
      100   on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      101   on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
      102   on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
      103   :
      104     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      105       find first buf_ruleset no-lock where
      106                 buf_ruleset.codex_id = p-codex-id
      107             and buf_ruleset.ruleset_id = p-ruleset-id no-error.
      108       if not available buf_ruleset then do:
      109         assign
      110         v-mess = "Не найден ruleset c таким кодексом и набором правил".
      111         run err-mess in this-procedure ( input-output v-mess).
      112         return error (if p-silent = yes then v-mess else '':U).
      113       end.
      114       find first buf_prop-script no-lock where
      115                 buf_prop-script.dtm-code = p-dtm-code
      116             and buf_prop-script.language = p-language
      117             and buf_prop-script.script-name = p-script-name
      118             and buf_prop-script.revis_id = p-revis-id   no-error.
      119       if not available buf_prop-script then do:
      120         assign
      121         v-mess = substitute("Не найден prop-script c кодом объекта &1, язык &2&3 название &4 версия &5"
      122                              , p-dtm-code
      123                              , p-language
      124                              , p-script-name
      125                              , p-revis-id
      126                              ).
      127         run err-mess in this-procedure ( input-output v-mess).
      128         return error (if p-silent = yes then v-mess else '':U).
      129       end.
      130       find first buf_pscript-ruleset no-lock where
      131                 buf_pscript-ruleset.codex_id = p-codex-id
      132             and buf_pscript-ruleset.ruleset_id = p-ruleset-id
      133             and buf_pscript-ruleset.dtm-code = p-dtm-code
      134             and buf_pscript-ruleset.language = p-language
      135             and buf_pscript-ruleset.script-name = p-script-name
      136             and buf_pscript-ruleset.revis_id = p-revis-id no-error.
      137       if available buf_pscript-ruleset then do:
      138         assign
      139         v-mess = substitute("Уже есть привязка скипта &1 к кодексу &2 набору правил &3"
      140                             , p-script-name
      141                             , p-codex-id
      142                             , p-ruleset-id
      143                            ).
      144         run err-mess in this-procedure ( input-output v-mess).
      145         return error (if p-silent = yes then v-mess else '':U).
      146       end.
      147       create buf_pscript-ruleset.
      148       assign
      149       buf_pscript-ruleset.codex_id = p-codex-id
      150       buf_pscript-ruleset.ruleset_id = p-ruleset-id
      151       buf_pscript-ruleset.dtm-code = p-dtm-code
      152       buf_pscript-ruleset.language = p-language
      153       buf_pscript-ruleset.script-name = p-script-name
      154       buf_pscript-ruleset.revis_id = p-revis-id
      155       .
      156     end.
      157   end.
      158   PROCEDURE err-mess:
      159     DEFINE INPUT-OUTPUT PARAMETER p-mess as character No-UNDO.
      160     CASE p-silent:
      161       when yes then do:
      162         assign
      163         p-mess = substitute("Привязка СКРИПТА к набору правил кодекс: &1 набор правил: &2&3объект &4 язык &5 название &6&1&7"
      164                            , chr(10)
      165                            , p-codex-id
      166                            , p-ruleset-id
      167                            , p-dtm-code
      168                            , p-language
      169                            , p-script-name
      170                            , p-mess)
      171         .
      172       end.
      173       when no then do:
      174         message
      175         p-mess
      176         view-as alert-box error .
      177       end.
      178     end.
      179   END PROCEDURE.
