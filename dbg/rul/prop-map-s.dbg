        1   DEFINE BUFFER X_prop-head FOR ub.prop-head.
        2   DEFINE BUFFER X_prop-map FOR ub.prop-map.
        3   define input parameter parparentproc as widget-handle no-undo .
        4   define input parameter bttns as character no-undo.
        5   DEFINE INPUT PARAMETER p-list-mode AS CHARACTER NO-UNDO.
        6   DEFINE INPUT PARAMETER p-dtm-code AS integer NO-UNDO.
        7   define input-output parameter p-rid-list as character no-undo.
        8   define variable vss-revision    as character no-undo init "$Revision$":U .
        9   define variable vss-author      as character no-undo init "$Author$":U .
       10   define variable vss-date        as character no-undo init "$Date$":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       12   define variable vss-archive     as character no-undo init "$Archive$":U .
       13   define variable vss-description as character no-undo init "Список  хранимых свойств объектов-операндов RUM".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       69   define variable v-waitfram-action01         as character   no-undo .
       70   define variable v-waitfram-action02         as character   no-undo .
       71   define variable v-waitfram-action03         as character   no-undo .
       72   define variable mWaitFramTextBeg            as character   no-undo.
       73   define variable mWaitFramTextEnd            as character   no-undo.
       74   define variable mWaitFramView               as logical     no-undo.
       75   define variable mWaitProcEvent              as logical     no-undo init yes.
       76   define variable mWaitFramInterval           as integer     no-undo init 1 .
       77   define variable mWaitFramStop               as logical     no-undo.
       78   define variable mWaitFramStopUser           as logical     no-undo.
       79   define variable mWaitFramStopTimeOut        as logical     no-undo.
       80   define variable mWaitFramStartProc          as datetime-tz no-undo.
       81   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       82   define button B-WaitFramStop auto-end-key
       83        label "Стоп"
       84        size 10 by 1 tooltip "Остоновить процесс".
       85   define button B-viewProcInfo
       86        label "Информация"
       87        size 15 by 1 tooltip "Информация о процесс".
       88   define frame waitfram
       89     v-waitfram-action01 format "x(72)" no-label skip
       90     v-waitfram-action02 format "x(72)" no-label skip
       91     v-waitfram-action03 format "x(72)" no-label skip
       92     B-viewProcInfo
       93     B-WaitFramStop at row 4 col 30
       94     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       95     .
       96   define new global shared variable mBatchMode as logical no-undo init ?.
       97   define variable mFramBachModHandle as handle no-undo.
       98   mFramBachModHandle = frame waitfram:handle.
       99   define variable mFameOldVis as logical no-undo.
      100   define variable mVisCUrentVin as logical no-undo.
      101   if session:batch-mode
      102   then
      103      mBatchMode = yes.
      104   if mBatchMode = ? then do:
      105     mVisCUrentVin = current-window:visible.
      106     mFameOldVis = mFramBachModHandle:visible.
      107     mFramBachModHandle:visible  = yes.
      108     mBatchMode = mFramBachModHandle:visible ne yes.
      109     mFramBachModHandle:visible = mFameOldVis.
      110     current-window:visible = mVisCUrentVin.
      111   end.
      112    if  log-manager:logfile-name ne ?
      113     then DO:
      114         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      115         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      116         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      117     end.
      118   on choose of B-WaitFramStop in frame waitfram
      119   do:
      120     mWaitFramStop = yes.
      121     mWaitFramStopUser = yes.
      122   end.
      123   function waitfram-check-timeout returns logical():
      124      define variable vtime as int64 no-undo.
      125      if mWaitFramStopTimeOut
      126      then
      127         return yes.
      128      vtime = ( now - mWaitFramStartProc ) / 1000 .
      129      if     mWaitFramTimeOut ne ?
      130         and mWaitFramTimeOut ne 0
      131         and mWaitFramTimeOut lt vtime
      132      then do:
      133         mWaitFramStopTimeOut = yes.
      134      end.
      135      return mWaitFramStopTimeOut.
      136   end.
      137   procedure waitfram-hide :
      138     if not session:batch-mode
      139     then do
      140     on error undo, return error return-value
      141     :
      142       pause 0 before-hide .
      143       if not mBatchMode then
      144         hide frame waitfram .
      145     if     not mWaitFramView
      146        and mWaitProcEvent
      147     then
      148       process events .
      149     end.
      150   end procedure.
      151   procedure waitfram-show :
      152     define input  parameter p-message as character no-undo .
      153     define variable v-left-margin as integer   no-undo .
      154     if not session:batch-mode
      155     then do
      156     on error undo, return error return-value
      157     :
      158       if length(p-message) <= 70 then do:
      159         assign
      160           v-left-margin = integer((70 - length(p-message)) / 2)
      161         .
      162         assign
      163           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      164         .
      165         assign
      166           v-waitfram-action01 = " "
      167           v-waitfram-action02 = " "
      168                                    + fill(" ", v-left-margin)
      169                                    + p-message
      170           v-waitfram-action03 = " "
      171         .
      172       end.
      173       else do:
      174         define variable vRindex1 as integer no-undo.
      175         define variable vRindex2 as integer no-undo.
      176         vRindex1 = r-index(p-message," ",70).
      177         if vRindex1 = 0
      178         then
      179            vRindex1 = 70.
      180         if length(p-message)  <= vRindex1 + 70 then do:
      181           assign
      182             v-waitfram-action01 = " "
      183             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      184             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      185           .
      186         end.
      187         else do:
      188           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      189           if vRindex2 <= vRindex1
      190           then
      191              vRindex2 = vRindex1 + 70.
      192           assign
      193             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      194             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      195             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      196           .
      197         end.
      198       end.
      199       B-viewProcInfo:visible   in frame waitfram = no.
      200       B-viewProcInfo:sensitive in frame waitfram = no.
      201       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      202       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      203       if  (   mWaitFramView
      204          or  mWaitProcEvent)
      205          and not mBatchMode
      206       then
      207          display
      208             v-waitfram-action01 skip
      209             v-waitfram-action02 skip
      210             v-waitfram-action03 skip
      211          with frame waitfram .
      212       if     mWaitFramView
      213          then do:
      214             if     mWaitFramInterval ne ?
      215                and not mBatchMode
      216             then
      217                wait-for go of frame waitfram pause mWaitFramInterval.
      218          end.
      219          else
      220             if     mWaitProcEvent
      221                and not mBatchMode
      222             then
      223                process events .
      224     end.
      225   end procedure.
      226      procedure waitfram-show-this:
      227         define input  parameter iInterval as int64 no-undo.
      228         define variable vtime as int64 no-undo.
      229         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      230         mWaitFramInterval = iInterval.
      231         run waitfram-show (substitute("&1&2 &3&4" ,
      232                                       mWaitFramTextBeg ,
      233                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      234                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      235                                       mWaitFramTextEnd
      236                                      )
      237                           ).
      238      end.
      239      procedure WaitFramRunPause:
      240         define input  parameter iInterval as dec no-undo.
      241         define variable vStart  as datetime-tz no-undo.
      242         define variable vend    as datetime-tz no-undo.
      243         define variable vint as int64 no-undo.
      244         define variable vOk as logical no-undo.
      245         vStart = now.
      246         vend   = vStart.
      247         publish "WaitFramPause" (iInterval,output vOk).
      248         vend   =  now.
      249         vint = vend - vStart.
      250         vint = iInterval - vint / 1000.
      251         if     not mWaitFramStop
      252            and (   vint > 0
      253                 or (    not vOk
      254                     and iInterval eq ?
      255                     )
      256                 )
      257         then
      258            run waitfram-show-this (iInterval).
      259         vend   =  now.
      260         vint = vend - vStart.
      261         vint = iInterval - vint / 1000.
      262         if     not mWaitFramStop
      263            and vint > 0
      264         then do:
      265            run gbl/pause.p (vint * 1000).
      266         end.
      267         if iInterval ne ?
      268         then
      269            publish "WaitFramStop".
      270         waitfram-check-timeout().
      271      end.
      272      procedure WaitFramWaitFor:
      273         define input  parameter iInterval as dec no-undo.
      274         assign
      275            mWaitFramStartProc   = now
      276            mWaitFramStopUser    = no
      277            mWaitFramStopTimeOut = no
      278         .
      279         block-wait:
      280         do while not mWaitFramStop:
      281            run WaitFramRunPause (iInterval).
      282            if  waitfram-check-timeout()
      283            then do:
      284               leave block-wait.
      285            end.
      286         end.
      287         run waitfram-hide.
      288      end.
      289   procedure waitfram-join :
      290     define input  parameter p-line-1  as character no-undo .
      291     define input  parameter p-line-2  as character no-undo .
      292     define input  parameter p-line-3  as character no-undo .
      293     define output parameter p-message as character no-undo .
      294     do
      295     on error undo, return error return-value
      296     :
      297       assign
      298         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      299                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      300                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      301       .
      302     end.
      303   end procedure.
      304   function waitfram-join-function returns character
      305     (input p-line-1 as character
      306     ,input p-line-2 as character
      307     ,input p-line-3 as character
      308     ).
      309     define variable v-message as character no-undo .
      310     run waitfram-join in this-procedure
      311       (input  p-line-1
      312       ,input  p-line-2
      313       ,input  p-line-3
      314       ,output v-message
      315       ) .
      316     return v-message .
      317   end function .
      318   define new global shared variable g#language as character no-undo .
      319   if g#language <> '' and g#language <> 'rus':U then do:
      320     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      321   end.
      322   procedure proc-alt-shift-f2:
      323     if not ibs.th.gbl.gbl-var:rcode
      324   then
      325     run gbl\inidebug.p .
      326   end.
      327   procedure proc-alt-shift-f3:
      328     run gbl/prvssinf.p
      329       ( input this-procedure
      330       ) .
      331   end.
      332   define variable v-inform-launched as logical no-undo initial false .
      333   procedure proc-alt-shift-f4:
      334     define variable v-action as character no-undo .
      335     if v-inform-launched = false then do:
      336       assign
      337         v-inform-launched = true
      338       .
      339       run gbl/d-inform.w
      340         (  input self
      341         ,  input this-procedure
      342         , output v-action
      343         ) no-error .
      344       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      345       assign
      346         v-inform-launched = false
      347       .
      348     end.
      349   end.
      350   procedure proc-alt-f1:
      351     run gbl/corrhelp.p
      352       (input this-procedure
      353       ) .
      354   end .
      355   on alt-shift-f2 anywhere do:
      356     run proc-alt-shift-f2.
      357   end.
      358   on alt-shift-f3 anywhere do:
      359     run proc-alt-shift-f3 in this-procedure .
      360   end.
      361   on alt-shift-f4 anywhere do:
      362     run proc-alt-shift-f4 in this-procedure.
      363   end.
      364   on alt-f1 anywhere do:
      365     run proc-alt-f1 in this-procedure .
      366   end.
      367   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      368     define variable v-cntxt-db-num        as integer   no-undo .
      369     define variable v-cntxt-userid        as character no-undo .
      370     define variable v-cntxt-level         as character no-undo .
      371     define variable v-cntxt-host-code-obj as integer   no-undo .
      372     define variable v-cntxt-obj-type      as character no-undo .
      373     define variable v-cntxt-obj-code      as integer   no-undo .
      374     define variable v-cntxt-db-num-obj    as integer   no-undo .
      375     define variable v-cntxt-is-admin      as logical   no-undo .
      376   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      377   FUNCTION mark-string RETURNS CHARACTER
      378     ( input p-recid as recid, input mark-list as character  ) :
      379     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      380   END FUNCTION.
      381   DEFINE VARIABLE v-doc-rec AS RECID NO-UNDO.
      382   DEFINE VARIABL link-option AS CHARACTER NO-UNDO.
      383   define variable v-rid-list as character no-undo .
      384   DEFINE MENU MENU-b-link
      385          MENU-ITEM m_prop-head    LABEL "Объект"
      386          MENU-ITEM m_prop-script  LABEL "Скприпты"      .
      387   DEFINE BUTTON b-add
      388        LABEL "&Добавить"
      389        SIZE 10 BY 1.
      390   DEFINE BUTTON b-chg
      391        LABEL "&Изменить"
      392        SIZE 10 BY 1.
      393   DEFINE BUTTON b-del
      394        LABEL "&Удалить"
      395        SIZE 10 BY 1.
      396   DEFINE BUTTON B-Help
      397        LABEL "Помо&щь"
      398        SIZE 10 BY 1
      399        BGCOLOR 8 .
      400   DEFINE BUTTON b-links
      401        LABEL "Связи"
      402        SIZE 10 BY 1.
      403   DEFINE BUTTON b-lkp
      404        LABEL "&Просмотр"
      405        SIZE 10 BY 1.
      406   DEFINE BUTTON b-mark
      407        LABEL "&*"
      408        SIZE 4 BY 1.
      409   DEFINE BUTTON b-quit AUTO-END-KEY
      410        LABEL "&Выход"
      411        SIZE 10 BY 1
      412        BGCOLOR 8 .
      413   DEFINE BUTTON b-sel AUTO-GO
      414        LABEL "Выбор"
      415        SIZE 10 BY 1.
      416   DEFINE VARIABLE mark-num AS INTEGER FORMAT "->,>>>,>>9":U INITIAL 0
      417         VIEW-AS TEXT
      418        SIZE 9 BY .67
      419        FGCOLOR 10  NO-UNDO.
      420   DEFINE QUERY br-prop-map FOR
      421         X_prop-map,
      422         X_prop-head SCROLLING.
      423   DEFINE BROWSE br-prop-map
      424     QUERY br-prop-map NO-LOCK DISPLAY
      425         mark-string(recid(X_prop-map), v-rid-list) Format "X(1)" COLUMN-LABEL "*"
      426   X_prop-head.dtm-code COLUMN-LABEL "Код объекта" FORMAT ">>>>>>>>9"
      427   X_prop-map.node-code COLUMN-LABEL "Код свойства" FORMAT ">>>>>>>>9"
      428   X_prop-map.node-name COLUMN-LABEL "Имя свойства" format "X(255)" width 32
      429   X_prop-map.node-label COLUMN-LABEL "Лейбл свойства" format "X(255)" width 32
      430   X_prop-map.node-value-type COLUMN-LABEL "Тип знач." format "X(20)"
      431   X_prop-map.rw-option COLUMN-LABEL "RW" format "X(6)"
      432   X_prop-head.prop-name COLUMN-LABEL "Имя объекта" format "X(255)" width 32
      433   X_prop-head.prop-label COLUMN-LABEL "Лейбл объекта" format "X(255)" width 45
      434       WITH NO-ROW-MARKERS SEPARATORS SIZE 97 BY 20.53 FIT-LAST-COLUMN.
      435   DEFINE FRAME Dialog-Frame
      436        b-quit AT ROW 1 COL 1
      437        b-mark AT ROW 1 COL 24 WIDGET-ID 12
      438        b-sel AT ROW 1 COL 28 WIDGET-ID 10
      439        b-add AT ROW 1 COL 38 WIDGET-ID 2
      440        b-chg AT ROW 1 COL 48 WIDGET-ID 4
      441        b-del AT ROW 1 COL 58 WIDGET-ID 8
      442        b-lkp AT ROW 1 COL 68 WIDGET-ID 6
      443        b-links AT ROW 1 COL 78 WIDGET-ID 16
      444        B-Help AT ROW 1 COL 88
      445        br-prop-map AT ROW 2.33 COL 1.5 WIDGET-ID 100
      446        mark-num AT ROW 1 COL 13 COLON-ALIGNED NO-LABEL WIDGET-ID 14
      447        SPACE(74.50) SKIP(21.20)
      448       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      449            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      450            TITLE "Хранимые свойства объектов"
      451            CANCEL-BUTTON b-quit.
      452   ASSIGN
      453          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      454          FRAME Dialog-Frame:HIDDEN           = TRUE.
      455   ASSIGN
      456          b-links:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-b-link:HANDLE.
      457   ON GO OF FRAME Dialog-Frame
      458   DO:
      459     p-rid-list = v-rid-list.
      460   END.
      461   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      462   DO:
      463     APPLY "END-ERROR":U TO SELF.
      464   END.
      465   ON CHOOSE OF b-add IN FRAME Dialog-Frame
      466   DO:
      467    define variable v-rec as recid no-undo.
      468     run rul/prop-map-i.w ( input parparentproc
      469                          ,input 'ДОБАВЛЕНИЕ':U
      470                          ,input (if p-list-mode = "dtm-code" then p-dtm-code else 0)
      471                          ,input 0
      472                          ,input-output v-rec) no-error.
      473     if v-rec <> ? then do:
      474       RUN openbr IN THIS-PROCEDURE.
      475       reposition br-prop-map to recid v-rec no-error.
      476       apply "ENTRY" to br-prop-map.
      477     end.
      478   END.
      479   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
      480   DO:
      481     define variable v-rec as recid no-undo.
      482     if not available X_prop-map then return no-apply.
      483     v-rec = recid(X_prop-map).
      484     run rul/prop-map-i.w ( input parparentproc
      485                          ,input 'ИЗМЕНЕНИЕ':U
      486                          ,input X_prop-map.dtm-code
      487                          ,input X_prop-map.node-code
      488                          ,input-output v-rec) no-error.
      489     if v-rec <> ? then do:
      490        br-prop-map:refresh().
      491     end.
      492   END.
      493   ON CHOOSE OF b-del IN FRAME Dialog-Frame
      494   DO:
      495     define variable v-rec as recid no-undo.
      496     define variable glog as logical no-undo.
      497     if not available X_prop-map then return no-apply.
      498     v-rec = recid(X_prop-map).
      499     message "Вы уверены, что хотите удалить Свойство?"
      500     view-as alert-box QUESTION buttons YES-No update glog .
      501     if not glog then return no-apply.
      502    run rul/prop-map3.p ( input no
      503                          ,input v-rec) no-error.
      504    if error-status:error then return no-apply.
      505    run Openbr in this-procedure .
      506   END.
      507   ON CHOOSE OF b-links IN FRAME Dialog-Frame
      508   DO:
      509     define variable v-rec as recid no-undo.
      510     if not available X_prop-map then return no-apply.
      511     IF link-option = '':U THEN DO:
      512       run gbl/pop-up.p ( INPUT SELF :handle, input no ) no-error.
      513       if error-status :error then do: return no-apply. end.
      514     end.
      515     if link-option = "":U then do:
      516         return no-apply.
      517     end.
      518     run proc-b-link IN THIS-PROCEDURE ( INPUT link-option).
      519   END.
      520   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
      521   DO:
      522     define variable v-rec as recid no-undo.
      523     if not available X_prop-map then return no-apply.
      524     run proc-b-lkp IN THIS-PROCEDURE.
      525   END.
      526   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
      527   DO:
      528     define variable glog as logical no-undo .
      529     if available X_prop-map then do:
      530   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      531   define variable v-str-recid4 as character no-undo .
      532   define variable v-num-entry4 as integer   no-undo .
      533   assign
      534     v-str-recid4 = trim( string( recid( X_prop-map ) , "->>>>>>>>>>>9":U ) )
      535     v-num-entry4 = lookup( v-str-recid4 , v-rid-list )
      536   .
      537   if v-num-entry4 > 0 then do:
      538     assign
      539       entry( v-num-entry4, v-rid-list ) = "":U
      540       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
      541     .
      542   end.
      543   else do:
      544     assign
      545       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid4
      546     .
      547   end.
      548     glog = br-prop-map:refresh() .
      549     if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
      550         glog = br-prop-map:select-next-row ().
      551         apply "VALUE-CHANGED" to br-prop-map in frame Dialog-Frame.
      552     end.
      553     if num-entries( v-rid-list ) = 0
      554     then
      555         hide mark-num in frame Dialog-Frame.
      556     else
      557         disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
      558   end.
      559   apply "entry" to br-prop-map in frame Dialog-Frame.
      560   END.
      561   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
      562   DO:
      563     if available X_prop-map then do:
      564       if  ( v-rid-list = "" ) or b-mark:sensitive = no
      565       then  v-rid-list = string( recid( X_prop-map ) ) .
      566     end.
      567   END.
      568   ON CHOOSE OF MENU-ITEM m_prop-head
      569   DO:
      570       ASSIGN
      571     link-option = 'prop-head':U.
      572     run proc-b-link IN THIS-PROCEDURE ( INPUT link-option) NO-ERROR.
      573     ASSIGN
      574     link-option = '':U.
      575     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      576   END.
      577   ON CHOOSE OF MENU-ITEM m_prop-script
      578   DO:
      579       ASSIGN
      580     link-option = 'prop-script':U.
      581     run proc-b-link IN THIS-PROCEDURE ( INPUT link-option) NO-ERROR.
      582     ASSIGN
      583     link-option = '':U.
      584     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      585   END.
      586   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      587   on f5 of frame Dialog-Frame anywhere
      588   do:
      589      v-doc-rec = recid(X_prop-map).    run OpenBR in this-procedure.  REPOSITION br-prop-map to recid v-doc-rec No-ERROR.   apply 'value-changed' to br-prop-map.
      590       apply "VALUE-CHANGED" to br-prop-map.
      591   end.
      592   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      593   on help of frame Dialog-Frame
      594   do:
      595     run gbl/app_help.p
      596       (input this-procedure :file-name
      597       ,input ''
      598       ,input ?
      599       ) no-error.
      600     if error-status :error then do:
      601       message
      602         "Ошибка при вызове помощи"
      603         error-status :get-message(1)
      604         view-as alert-box .
      605     end.
      606   end.
      607   run minbtn-set in this-procedure .
      608   on choose of b-help in frame Dialog-Frame
      609   do:
      610     apply "help":u to frame Dialog-Frame .
      611   end.
      612   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      613   procedure minbtn-set :
      614       do
      615           on error undo, return error return-value
      616           :
      617           define variable ii              as integer       no-undo .
      618           define variable fh              as widget-handle no-undo .
      619           define variable hh              as widget-handle no-undo .
      620           define variable v-h             as handle        extent 4 no-undo .
      621           define variable v-name-button   as character     no-undo .
      622           define variable v-help-old-x    as decimal       no-undo .
      623           define variable v-help-old-y    as decimal       no-undo .
      624           define variable v-help-old-size as decimal       no-undo .
      625           define variable v-frame-width   as decimal       no-undo .
      626           define variable jj              as integer       no-undo .
      627           do
      628               on error undo, return error
      629               :
      630               assign
      631                   v-frame-width = frame Dialog-Frame:width - 0.3
      632                   fh            = frame Dialog-Frame:first-child
      633                   hh            = fh:first-child
      634                   ii            = 1
      635                   .
      636               do while valid-handle(hh):
      637                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      638                   do:
      639                       case lc(hh:name) :
      640                           when "b-help" then
      641                               do:
      642                                   hh:load-image-up("cmp/b-help.bmp":u) .
      643                                   hh:load-image-down("cmp/b-help.bmp":u) .
      644                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      645                                   hh:TOOLTIP = "Помощь" .
      646                                   v-help-old-x = hh:column .
      647                                   v-help-old-y = hh:row    .
      648                                   v-help-old-size = hh:width .
      649                                   hh:width-chars = 2.5 .
      650                               end.
      651                           when "b-print" then
      652                               do:
      653                                   hh:load-image("cmp/b-print.bmp":u) .
      654                                   hh:TOOLTIP = "Печать" .
      655                                   v-h[ii] = hh:handle .
      656                                   ii = ii + 1 .
      657                                   hh:width-chars = 3 .
      658                               end.
      659                           when "b-history" or
      660                           when "b-hist" then
      661                               do:
      662                                   hh:load-image("cmp/b-hist.bmp":u) .
      663                                   hh:TOOLTIP = "История" .
      664                                   v-h[ii] = hh:handle .
      665                                   ii = ii + 1 .
      666                                   hh:width-chars = 3 .
      667                               end.
      668                           when "b-sch" then
      669                               do:
      670                                   hh:load-image("cmp/b-sch.bmp":u) .
      671                                   hh:TOOLTIP = "Установка Фильтра" .
      672                                   v-h[ii] = hh:handle .
      673                                   ii = ii + 1 .
      674                                   hh:width-chars = 3 .
      675                               end.
      676                           when "b-hist-user" then
      677                               do:
      678                                   hh:load-image("cmp/b-hist.bmp":u) .
      679                                   hh:TOOLTIP = "История пользователя" .
      680                                   ii = ii + 1 .
      681                               end.
      682                       end case.
      683                   end.
      684                   hh = hh:next-sibling.
      685               end.
      686               b-help:column = v-frame-width - b-help:width-chars.
      687               jj = 0.
      688               repeat ii = 4 to 1 by -1 :
      689                   if valid-handle (v-h[ii] ) then
      690                   do:
      691                       jj  = jj + 1 .
      692                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      693                       v-h[ii]:row    = v-help-old-y .
      694                   end.
      695               end.
      696           end.
      697       end.
      698   end procedure.
      699   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      700   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      701   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      702   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      703   define variable v-diasize-current-frame-width  as decimal   no-undo .
      704   define variable v-diasize-current-frame-height as decimal   no-undo .
      705   define variable v-diasize-change-size          as logical   no-undo .
      706   define variable v-diasize-resize-button        as handle    no-undo .
      707   define variable v-diasize-wndmax               as logical   no-undo .
      708   define variable v-diasize-wndstore             as logical   no-undo .
      709   define variable v-diasize-proc-name            as character no-undo .
      710   define variable v-diasize-browse-handle        as handle    no-undo .
      711   define variable v-diasize-browse-number        as integer   no-undo .
      712   define variable v-diasize-need-full-display    as logical   no-undo init false .
      713   define temp-table temp-diasize-handle no-undo
      714     field handle-value  as handle
      715     field save-position as decimal
      716     index xpk is primary unique handle-value
      717     .
      718   define temp-table temp-browse-handle no-undo
      719     field browse-type   as character
      720     field browse-number as integer
      721     field browse-handle as handle
      722     field original-size as decimal
      723     index xpk is primary unique browse-type browse-number
      724     index xie browse-type browse-handle
      725   .
      726   procedure diasize_change-height :
      727     define input  parameter p-change-value  as decimal   no-undo .
      728     define input  parameter p-move-resize   as logical   no-undo .
      729     define variable v-field-group-handle    as handle    no-undo .
      730     define variable v-object-handle         as handle    no-undo .
      731     define variable v-frame-height          as decimal   no-undo .
      732     define variable v-frame-virtual-height  as decimal   no-undo .
      733     define variable v-browse-height         as decimal   no-undo .
      734     define variable v-window-height         as decimal   no-undo .
      735     define variable v-window-virtual-height as decimal   no-undo .
      736     define variable v-change-sign           as integer   no-undo .
      737     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      738     define buffer buf_temp-browse-handle  for temp-browse-handle .
      739     if p-change-value > 0
      740     then do:
      741       if frame Dialog-Frame :height + p-change-value
      742           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      743       then do:
      744         assign
      745           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      746                           - (frame Dialog-Frame :height-chars)
      747         .
      748         if p-change-value <= 0
      749         then do:
      750           run diasize_position-resize-button in this-procedure .
      751           return .
      752         end.
      753       end.
      754     end.
      755     if p-change-value < 0
      756     then do:
      757       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      758       then do:
      759         assign
      760           p-change-value = v-diasize-orig-frame-height
      761                          - (frame Dialog-Frame :height-chars)
      762         .
      763         if p-change-value >= 0
      764         then do:
      765           run diasize_position-resize-button in this-procedure .
      766           return .
      767         end.
      768       end.
      769     end.
      770     if p-change-value >= 0
      771     then do:
      772       assign
      773         v-change-sign = 1
      774       .
      775     end.
      776     else do:
      777       assign
      778         v-change-sign = -1
      779       .
      780     end.
      781     assign
      782       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      783     .
      784     if p-change-value = 0
      785     then do:
      786       run diasize_position-resize-button in this-procedure .
      787       return .
      788     end.
      789     move_block:
      790     do
      791     on error undo move_block, retry move_block
      792     :
      793       if retry
      794       then do:
      795         do
      796         on error undo move_block, leave move_block
      797         :
      798           if p-change-value > 0
      799           then do:
      800             for each buf_temp-diasize-handle
      801             on error undo, next
      802             :
      803               assign
      804                 v-object-handle = buf_temp-diasize-handle.handle-value
      805               .
      806               if v-object-handle <> v-diasize-resize-button
      807               then do:
      808                 assign
      809                   v-object-handle :row = buf_temp-diasize-handle.save-position
      810                 .
      811               end.
      812             end.
      813             assign
      814               v-diasize-browse-handle :height = v-browse-height
      815             .
      816             for each buf_temp-browse-handle
      817               where buf_temp-browse-handle.browse-type = 'height':u
      818             on error undo, next
      819             :
      820               assign
      821                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      822               .
      823             end.
      824             assign
      825               frame Dialog-Frame :height = v-frame-height
      826             .
      827             if frame Dialog-Frame :scrollable = true
      828             then do:
      829               assign
      830                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      831               .
      832             end.
      833             run diasize_position-resize-button in this-procedure .
      834           end.
      835           else do:
      836             if frame Dialog-Frame :scrollable = true
      837             then do:
      838               assign
      839                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      840               .
      841             end.
      842             assign
      843               frame Dialog-Frame :height = v-frame-height
      844             .
      845             assign
      846               v-diasize-browse-handle :height = v-browse-height
      847             .
      848             for each buf_temp-browse-handle
      849               where buf_temp-browse-handle.browse-type = 'height':u
      850             on error undo, next
      851             :
      852               assign
      853                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      854               .
      855             end.
      856             for each buf_temp-diasize-handle
      857             on error undo, next
      858             :
      859               assign
      860                 v-object-handle = buf_temp-diasize-handle.handle-value
      861               .
      862               if v-object-handle <> v-diasize-resize-button
      863               then do:
      864                 assign
      865                   v-object-handle :row = buf_temp-diasize-handle.save-position
      866                 .
      867               end.
      868             end.
      869             run diasize_position-resize-button in this-procedure .
      870           end.
      871           assign
      872             v-diasize-change-size = false
      873           .
      874           leave move_block .
      875         end.
      876       end.
      877       assign
      878         v-diasize-need-full-display = true
      879       .
      880       if v-diasize-change-size = false
      881       then do:
      882         assign
      883           v-diasize-change-size = true
      884         .
      885       end.
      886       else do:
      887         return .
      888       end.
      889       assign
      890         v-frame-height = frame Dialog-Frame :height
      891         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      892         v-browse-height = v-diasize-browse-handle :height
      893       .
      894       for each buf_temp-browse-handle
      895         where buf_temp-browse-handle.browse-type = 'height':u
      896       :
      897         assign
      898           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      899         .
      900       end.
      901       for each buf_temp-diasize-handle
      902       :
      903         delete buf_temp-diasize-handle .
      904       end.
      905       assign
      906         v-field-group-handle = frame Dialog-Frame :first-child
      907       .
      908       do while valid-handle(v-field-group-handle)
      909       :
      910         assign
      911           v-object-handle = v-field-group-handle :first-child
      912         .
      913         do while valid-handle(v-object-handle)
      914         :
      915           if  v-object-handle <> v-diasize-browse-handle :handle
      916           and can-query(v-object-handle, "row")
      917           and can-query(v-object-handle, "height")
      918           and ( v-object-handle :row > v-diasize-browse-handle :row )
      919           then do:
      920             find first buf_temp-browse-handle
      921               where buf_temp-browse-handle.browse-type   = 'height':u
      922                 and buf_temp-browse-handle.browse-handle = v-object-handle
      923               no-error .
      924             if available buf_temp-browse-handle
      925             then do:
      926             end.
      927             else do:
      928               create buf_temp-diasize-handle .
      929               assign
      930                 buf_temp-diasize-handle.handle-value  = v-object-handle
      931                 buf_temp-diasize-handle.save-position = v-object-handle :row
      932               .
      933             end.
      934           end.
      935           assign
      936             v-object-handle = v-object-handle :next-sibling
      937           .
      938         end.
      939         assign
      940           v-field-group-handle = v-field-group-handle :next-sibling
      941         .
      942       end.
      943       do with frame Dialog-Frame
      944       :
      945         hide v-diasize-resize-button .
      946         assign
      947           v-diasize-resize-button :row    = 1
      948           v-diasize-resize-button :column = 1
      949         .
      950       end.
      951       if p-change-value > 0
      952       then do:
      953         if frame Dialog-Frame :scrollable = true
      954         then do:
      955           assign
      956             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      957             no-error .
      958           if error-status :error
      959           or error-status :get-message(1) <> ""
      960           then do:
      961             undo move_block, retry move_block .
      962           end.
      963         end.
      964         assign
      965           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      966           no-error .
      967         if error-status :error
      968         or error-status :get-message(1) <> ""
      969         then do:
      970           undo move_block, retry move_block .
      971         end.
      972         assign
      973           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      974           no-error .
      975         if error-status :error
      976         or error-status :get-message(1) <> ""
      977         then do:
      978           undo move_block, retry move_block .
      979         end.
      980         for each buf_temp-browse-handle
      981           where buf_temp-browse-handle.browse-type = 'height':u
      982         on error undo move_block, retry move_block
      983         :
      984           assign
      985             buf_temp-browse-handle.browse-handle :height
      986               = buf_temp-browse-handle.browse-handle :height + p-change-value
      987             no-error .
      988           if error-status :error
      989           or error-status :get-message(1) <> ""
      990           then do:
      991             undo move_block, retry move_block .
      992           end.
      993         end.
      994         for each buf_temp-diasize-handle
      995         on error undo move_block, retry move_block
      996         :
      997           assign
      998             v-object-handle = buf_temp-diasize-handle.handle-value
      999           .
     1000           if v-object-handle <> v-diasize-resize-button
     1001           then do:
     1002             assign
     1003               v-object-handle :row = v-object-handle :row + p-change-value
     1004               no-error .
     1005             if error-status :error
     1006             or error-status :get-message(1) <> ""
     1007             then do:
     1008               undo move_block, retry move_block .
     1009             end.
     1010           end.
     1011         end.
     1012       end.
     1013       else do:
     1014         for each buf_temp-diasize-handle
     1015         on error undo move_block, retry move_block
     1016         :
     1017           assign
     1018             v-object-handle = buf_temp-diasize-handle.handle-value
     1019           .
     1020           if v-object-handle <> v-diasize-resize-button
     1021           then do:
     1022             assign
     1023               v-object-handle :row = v-object-handle :row + p-change-value
     1024               no-error .
     1025             if error-status :error
     1026             or error-status :get-message(1) <> ""
     1027             then do:
     1028               undo move_block, retry move_block .
     1029             end.
     1030           end.
     1031         end.
     1032         assign
     1033           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1034           no-error .
     1035         if error-status :error
     1036         or error-status :get-message(1) <> ""
     1037         then do:
     1038           undo move_block, retry move_block .
     1039         end.
     1040         for each buf_temp-browse-handle
     1041           where buf_temp-browse-handle.browse-type = 'height':u
     1042         on error undo move_block, retry move_block
     1043         :
     1044           assign
     1045             buf_temp-browse-handle.browse-handle :height
     1046               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1047             no-error .
     1048           if error-status :error
     1049           or error-status :get-message(1) <> ""
     1050           then do:
     1051             undo move_block, retry move_block .
     1052           end.
     1053         end.
     1054         assign
     1055           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1056           no-error .
     1057         if error-status :error
     1058         or error-status :get-message(1) <> ""
     1059         then do:
     1060           undo move_block, retry move_block .
     1061         end.
     1062         if frame Dialog-Frame :scrollable = true
     1063         then do:
     1064           assign
     1065             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1066             no-error .
     1067           if error-status :error
     1068           or error-status :get-message(1) <> ""
     1069           then do:
     1070             undo move_block, retry move_block .
     1071           end.
     1072         end.
     1073       end.
     1074       if p-move-resize = true
     1075       then do:
     1076         run diasize_position-resize-button in this-procedure .
     1077       end.
     1078       if v-diasize-wndstore = true
     1079       then do:
     1080         if connected("ub") = true
     1081         then do:
     1082           define variable v-cntxt-db-num        as integer   no-undo .
     1083           define variable v-cntxt-userid        as character no-undo .
     1084           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1085                                             , OUTPUT v-cntxt-userid
     1086                                             ) .
     1087           run gbl/wndsizew.p
     1088             (input  v-cntxt-db-num
     1089             ,input  v-cntxt-userid
     1090             ,input  v-diasize-proc-name
     1091             ,input  'height':u
     1092             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1093             ) .
     1094         end.
     1095       end.
     1096     end.
     1097     assign
     1098       v-diasize-change-size = false
     1099     .
     1100   end procedure.
     1101   procedure diasize_set-height :
     1102     define input  parameter p-new-height  as decimal   no-undo .
     1103     define input  parameter p-move-resize as logical   no-undo .
     1104     do
     1105     on error undo, return error return-value
     1106     :
     1107       run diasize_change-height in this-procedure
     1108         (input  (p-new-height - frame Dialog-Frame :height)
     1109         ,input  p-move-resize
     1110         ) .
     1111     end.
     1112   end procedure.
     1113   procedure diasize_change-width :
     1114     define input  parameter p-change-value as decimal   no-undo .
     1115     define input  parameter p-move-resize  as logical   no-undo .
     1116     define variable v-field-group-handle   as handle    no-undo .
     1117     define variable v-object-handle        as handle    no-undo .
     1118     define variable v-frame-width          as decimal   no-undo .
     1119     define variable v-frame-virtual-width  as decimal   no-undo .
     1120     define variable v-browse-width         as decimal   no-undo .
     1121     define variable v-window-width         as decimal   no-undo .
     1122     define variable v-window-virtual-width as decimal   no-undo .
     1123     define variable v-change-sign          as integer   no-undo .
     1124     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1125     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1126     if p-change-value > 0
     1127     then do:
     1128       if frame Dialog-Frame :width + p-change-value >
     1129           session :width-chars
     1130       then do:
     1131         assign
     1132           p-change-value = session :width-chars - frame Dialog-Frame :width
     1133         .
     1134         if p-change-value <= 0
     1135         then do:
     1136           run diasize_position-resize-button in this-procedure .
     1137           return .
     1138         end.
     1139       end.
     1140     end.
     1141     if p-change-value < 0
     1142     then do:
     1143       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1144       then do:
     1145         assign
     1146           p-change-value = v-diasize-orig-frame-width
     1147                          - frame Dialog-Frame :width
     1148         .
     1149         if p-change-value >= 0
     1150         then do:
     1151           run diasize_position-resize-button in this-procedure .
     1152           return .
     1153         end.
     1154       end.
     1155     end.
     1156     if p-change-value >= 0
     1157     then do:
     1158       assign
     1159         v-change-sign = 1
     1160       .
     1161     end.
     1162     else do:
     1163       assign
     1164         v-change-sign = -1
     1165       .
     1166     end.
     1167     assign
     1168       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1169     .
     1170     if p-change-value = 0
     1171     then do:
     1172       run diasize_position-resize-button in this-procedure .
     1173       return .
     1174     end.
     1175     move_block:
     1176     do
     1177     on error undo move_block, leave move_block
     1178     :
     1179       if retry
     1180       then do:
     1181         do
     1182         on error undo move_block, leave move_block
     1183         :
     1184           if p-change-value > 0
     1185           then do:
     1186             for each buf_temp-diasize-handle
     1187             on error undo, next
     1188             :
     1189               assign
     1190                 v-object-handle = buf_temp-diasize-handle.handle-value
     1191               .
     1192               if v-object-handle <> v-diasize-resize-button
     1193               then do:
     1194                 assign
     1195                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1196                 .
     1197               end.
     1198             end.
     1199             assign
     1200               v-diasize-browse-handle :width = v-browse-width
     1201             .
     1202             for each buf_temp-browse-handle
     1203               where buf_temp-browse-handle.browse-type = 'width':u
     1204             on error undo, next
     1205             :
     1206               assign
     1207                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1208               .
     1209             end.
     1210             assign
     1211               frame Dialog-Frame :width = v-frame-width
     1212             .
     1213             if frame Dialog-Frame :scrollable = true
     1214             then do:
     1215               assign
     1216                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1217               .
     1218             end.
     1219             run diasize_position-resize-button in this-procedure .
     1220           end.
     1221           else do:
     1222             if frame Dialog-Frame :scrollable = true
     1223             then do:
     1224               assign
     1225                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1226               .
     1227             end.
     1228             assign
     1229               frame Dialog-Frame :width = v-frame-width
     1230             .
     1231             for each buf_temp-browse-handle
     1232               where buf_temp-browse-handle.browse-type = 'width':u
     1233             on error undo, next
     1234             :
     1235               assign
     1236                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1237               .
     1238             end.
     1239             assign
     1240               v-diasize-browse-handle :width = v-browse-width
     1241             .
     1242             for each buf_temp-diasize-handle
     1243             on error undo, next
     1244             :
     1245               assign
     1246                 v-object-handle = buf_temp-diasize-handle.handle-value
     1247               .
     1248               if v-object-handle <> v-diasize-resize-button
     1249               then do:
     1250                 assign
     1251                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1252                 .
     1253               end.
     1254             end.
     1255             run diasize_position-resize-button in this-procedure .
     1256           end.
     1257           assign
     1258             v-diasize-change-size = false
     1259           .
     1260           leave move_block .
     1261         end.
     1262       end.
     1263       assign
     1264         v-diasize-need-full-display = true
     1265       .
     1266       if v-diasize-change-size = false
     1267       then do:
     1268         assign
     1269           v-diasize-change-size = true
     1270         .
     1271       end.
     1272       else do:
     1273         return .
     1274       end.
     1275       assign
     1276         v-frame-width = frame Dialog-Frame :width
     1277         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1278         v-browse-width = v-diasize-browse-handle :width
     1279       .
     1280       for each buf_temp-browse-handle
     1281         where buf_temp-browse-handle.browse-type = 'width':u
     1282       :
     1283         assign
     1284           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1285         .
     1286       end.
     1287       for each buf_temp-diasize-handle
     1288       :
     1289         delete buf_temp-diasize-handle .
     1290       end.
     1291       assign
     1292         v-field-group-handle = frame Dialog-Frame :first-child
     1293       .
     1294       do while valid-handle(v-field-group-handle)
     1295       :
     1296         assign
     1297           v-object-handle = v-field-group-handle :first-child
     1298         .
     1299         do while valid-handle(v-object-handle)
     1300         :
     1301           if  v-object-handle <> v-diasize-browse-handle :handle
     1302           and v-object-handle <> v-diasize-resize-button
     1303           and can-query(v-object-handle, "row")
     1304           and can-query(v-object-handle, "height")
     1305           and ( v-object-handle :col + v-object-handle :width
     1306                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1307               )
     1308           then do:
     1309             find first buf_temp-browse-handle
     1310               where buf_temp-browse-handle.browse-type   = 'width':u
     1311                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1312               no-error .
     1313             if available buf_temp-browse-handle
     1314             then do:
     1315             end.
     1316             else do:
     1317               create buf_temp-diasize-handle .
     1318               assign
     1319                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1320                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1321               .
     1322             end.
     1323           end.
     1324           assign
     1325             v-object-handle = v-object-handle :next-sibling
     1326           .
     1327         end.
     1328         assign
     1329           v-field-group-handle = v-field-group-handle :next-sibling
     1330         .
     1331       end.
     1332       do with frame Dialog-Frame
     1333       :
     1334         hide v-diasize-resize-button .
     1335         v-diasize-resize-button :row = 1.
     1336         v-diasize-resize-button :column = 1.
     1337       end.
     1338       if p-change-value > 0
     1339       then do:
     1340         if frame Dialog-Frame :scrollable = true
     1341         then do:
     1342           assign
     1343             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1344             no-error .
     1345           if error-status :error
     1346           or error-status :get-message(1) <> ""
     1347           then do:
     1348             undo move_block, retry move_block.
     1349           end.
     1350         end.
     1351         assign
     1352           frame Dialog-Frame :width = v-frame-width + p-change-value
     1353           no-error .
     1354         if error-status :error
     1355         or error-status :get-message(1) <> ""
     1356         then do:
     1357           undo move_block, retry move_block.
     1358         end.
     1359         assign
     1360           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1361         no-error .
     1362         if error-status :error
     1363         or error-status :get-message(1) <> ""
     1364         then do:
     1365           undo move_block, retry move_block.
     1366         end.
     1367         for each buf_temp-browse-handle
     1368           where buf_temp-browse-handle.browse-type = 'width':u
     1369         on error undo move_block, retry move_block
     1370         :
     1371           assign
     1372             buf_temp-browse-handle.browse-handle :width
     1373               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1374             no-error .
     1375           if error-status :error
     1376           or error-status :get-message(1) <> ""
     1377           then do:
     1378             undo move_block, retry move_block .
     1379           end.
     1380         end.
     1381         for each buf_temp-diasize-handle
     1382         on error undo move_block, retry move_block
     1383         :
     1384           assign
     1385             v-object-handle = buf_temp-diasize-handle.handle-value
     1386           .
     1387           if v-object-handle <> v-diasize-resize-button
     1388           then do:
     1389             assign
     1390               v-object-handle :col = v-object-handle :col + p-change-value
     1391               no-error .
     1392             if error-status :error
     1393             or error-status :get-message(1) <> ""
     1394             then do:
     1395               undo move_block, retry move_block .
     1396             end.
     1397           end.
     1398         end.
     1399       end.
     1400       else do:
     1401         for each buf_temp-diasize-handle
     1402         on error undo move_block, retry move_block
     1403         :
     1404           assign
     1405             v-object-handle = buf_temp-diasize-handle.handle-value
     1406           .
     1407           if v-object-handle <> v-diasize-resize-button
     1408           then do:
     1409             assign
     1410               v-object-handle :col = v-object-handle :col + p-change-value
     1411               no-error .
     1412             if error-status :error
     1413             or error-status :get-message(1) <> ""
     1414             then do:
     1415               undo move_block, retry move_block .
     1416             end.
     1417           end.
     1418         end.
     1419         for each buf_temp-browse-handle
     1420           where buf_temp-browse-handle.browse-type = 'width':u
     1421         on error undo move_block, retry move_block
     1422         :
     1423           assign
     1424             buf_temp-browse-handle.browse-handle :width
     1425               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1426             no-error .
     1427           if error-status :error
     1428           or error-status :get-message(1) <> ""
     1429           then do:
     1430             undo move_block, retry move_block .
     1431           end.
     1432         end.
     1433         assign
     1434           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1435           no-error .
     1436         if error-status :error
     1437         or error-status :get-message(1) <> ""
     1438         then do:
     1439           undo move_block, retry move_block.
     1440         end.
     1441         assign
     1442           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1443         no-error .
     1444         if error-status :error
     1445         or error-status :get-message(1) <> ""
     1446         then do:
     1447           undo move_block, retry move_block.
     1448         end.
     1449         if frame Dialog-Frame :scrollable = true
     1450         then do:
     1451           assign
     1452             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1453           no-error .
     1454           if error-status :error
     1455           or error-status :get-message(1) <> ""
     1456           then do:
     1457             undo move_block, retry move_block.
     1458           end.
     1459         end.
     1460       end.
     1461       if p-move-resize
     1462       then do:
     1463         run diasize_position-resize-button in this-procedure .
     1464       end.
     1465       if v-diasize-wndstore = true
     1466       then do:
     1467         if connected("ub") = true
     1468         then do:
     1469           define variable v-cntxt-db-num        as integer   no-undo .
     1470           define variable v-cntxt-userid        as character no-undo .
     1471           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1472                                             , OUTPUT v-cntxt-userid
     1473                                             ) .
     1474           run gbl/wndsizew.p
     1475             (input  v-cntxt-db-num
     1476             ,input  v-cntxt-userid
     1477             ,input  v-diasize-proc-name
     1478             ,input  'width':u
     1479             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1480             ) .
     1481         end.
     1482       end.
     1483     end.
     1484     assign
     1485       v-diasize-change-size = false
     1486     .
     1487   end procedure.
     1488   procedure diasize_set-width :
     1489     define input  parameter p-new-width  as decimal   no-undo .
     1490     define input  parameter p-move-resize as logical   no-undo .
     1491     do
     1492     on error undo, return error return-value
     1493     :
     1494       run diasize_change-width in this-procedure
     1495         (input  (p-new-width - frame Dialog-Frame :width)
     1496         ,input  p-move-resize
     1497         ) .
     1498     end.
     1499   end procedure.
     1500   procedure diasize_position-resize-button :
     1501     do with frame Dialog-Frame
     1502     :
     1503       hide v-diasize-resize-button .
     1504       assign
     1505         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1506                     - 1
     1507                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1508         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1509                     - 1
     1510                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1511       .
     1512       view v-diasize-resize-button .
     1513     end.
     1514   end procedure.
     1515   on alt-right anywhere
     1516   do:
     1517     run diasize_change-width in this-procedure
     1518       (input 1
     1519       ,input true
     1520       ) .
     1521     return no-apply .
     1522   end.
     1523   on alt-left anywhere
     1524   do:
     1525     run diasize_change-width in this-procedure
     1526       (input -1
     1527       ,input true
     1528       ) .
     1529     return no-apply .
     1530   end.
     1531   on alt-down anywhere
     1532   do:
     1533     run diasize_change-height in this-procedure
     1534       (input 1
     1535       ,input true
     1536       ) .
     1537     return no-apply .
     1538   end.
     1539   on alt-up anywhere
     1540   do:
     1541     run diasize_change-height in this-procedure
     1542       (input -1
     1543       ,input true
     1544       ) .
     1545     return no-apply .
     1546   end.
     1547   on alt-enter of frame Dialog-Frame
     1548   do:
     1549     run diasize_maximize in this-procedure
     1550       (input  ?
     1551       ).
     1552     return no-apply .
     1553   end.
     1554   procedure diasize_end-move :
     1555     do
     1556     on error undo, return error return-value
     1557     :
     1558       define variable v-row-delta as decimal   no-undo .
     1559       define variable v-col-delta as decimal   no-undo .
     1560       define variable v-new-row as decimal   no-undo .
     1561       define variable v-new-col as decimal   no-undo .
     1562       assign
     1563         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1564         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1565       .
     1566       assign
     1567         v-row-delta = v-new-row - frame Dialog-Frame :height
     1568         v-col-delta = v-new-col - frame Dialog-Frame :width
     1569       .
     1570       run diasize_change-height in this-procedure
     1571         (input v-row-delta
     1572         ,input true
     1573         ) .
     1574       run diasize_change-width in this-procedure
     1575         (input v-col-delta
     1576         ,input true
     1577         ) .
     1578     end.
     1579   end procedure.
     1580   procedure diasize_maximize :
     1581     define input  parameter p-action as logical   no-undo .
     1582     do
     1583     on error undo, return error return-value
     1584     :
     1585       if p-action = ?
     1586       then do:
     1587         if v-diasize-need-maximize = true
     1588         then do:
     1589           assign
     1590             p-action = true
     1591           .
     1592         end.
     1593         else do:
     1594           assign
     1595             p-action = false
     1596           .
     1597         end.
     1598       end.
     1599       if p-action = true
     1600       then do:
     1601         run diasize_change-height in this-procedure
     1602           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1603               - frame Dialog-Frame :height-chars
     1604           ,input true
     1605           ) .
     1606         run diasize_change-width in this-procedure
     1607           (input session :width-chars
     1608               - frame Dialog-Frame :width-chars
     1609           ,input true
     1610           ) .
     1611         assign
     1612           v-diasize-need-maximize = false
     1613         .
     1614       end.
     1615       else do:
     1616         run diasize_change-width in this-procedure
     1617           (input v-diasize-orig-frame-width
     1618               - frame Dialog-Frame :width-chars
     1619           ,input true
     1620           ) .
     1621         run diasize_change-height in this-procedure
     1622           (input v-diasize-orig-frame-height
     1623               - frame Dialog-Frame :height-chars
     1624           ,input true
     1625           ) .
     1626         assign
     1627           v-diasize-need-maximize = true
     1628         .
     1629       end.
     1630     end.
     1631   end procedure.
     1632   procedure diasize_restore-orig-size :
     1633     do
     1634     on error undo, return error return-value
     1635     :
     1636       assign
     1637         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1638         v-diasize-current-frame-height = frame Dialog-Frame :height
     1639       .
     1640       run diasize_set-height in this-procedure
     1641         (input  v-diasize-orig-frame-height
     1642         ,input  true
     1643         ) .
     1644       run diasize_set-width in this-procedure
     1645         (input  v-diasize-orig-frame-width
     1646         ,input  true
     1647         ) .
     1648     end.
     1649   end procedure.
     1650   procedure diasize_restore-current-size :
     1651     do
     1652     on error undo, return error return-value
     1653     :
     1654       run diasize_set-height in this-procedure
     1655         (input  v-diasize-current-frame-height
     1656         ,input  true
     1657         ) .
     1658       run diasize_set-width in this-procedure
     1659         (input  v-diasize-current-frame-width
     1660         ,input  true
     1661         ) .
     1662     end.
     1663   end procedure.
     1664   procedure diasize_set-browse-handle :
     1665     define input  parameter p-browse-handle as handle   no-undo .
     1666     define buffer buf_temp-browse-handle for temp-browse-handle .
     1667     do
     1668     on error undo, return error return-value
     1669     :
     1670       assign
     1671         v-diasize-browse-handle = p-browse-handle
     1672       .
     1673       for each buf_temp-browse-handle
     1674       on error undo, return error return-value
     1675       :
     1676         delete buf_temp-browse-handle .
     1677       end.
     1678     end.
     1679   end procedure.
     1680   procedure diasize_add_browse :
     1681     define input  parameter p-browse-type   as character no-undo .
     1682     define input  parameter p-browse-handle as handle    no-undo .
     1683     define buffer buf_temp-browse-handle for temp-browse-handle .
     1684     do
     1685     on error undo, return error return-value
     1686     :
     1687       assign
     1688         v-diasize-browse-number = v-diasize-browse-number + 1
     1689       .
     1690       create buf_temp-browse-handle .
     1691       assign
     1692         buf_temp-browse-handle.browse-type   = p-browse-type
     1693         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1694         buf_temp-browse-handle.browse-handle = p-browse-handle
     1695       .
     1696     end.
     1697   end procedure.
     1698   procedure diasize_init :
     1699     define variable v-default-value    as logical   no-undo .
     1700     define variable v-restore-saved    as logical   no-undo .
     1701     define variable v-resize-value-str as character no-undo .
     1702     do
     1703     on error undo, return error return-value
     1704     :
     1705       do with frame Dialog-Frame
     1706       :
     1707         assign
     1708           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1709           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1710           v-diasize-browse-handle     = browse br-prop-map :handle
     1711         .
     1712         create button v-diasize-resize-button
     1713         assign
     1714           parent        = frame Dialog-Frame :first-child
     1715           label         = "s"
     1716           height-pixels = 16
     1717           width-pixels  = 16
     1718           visible       = true
     1719           sensitive     = true
     1720           movable       = true
     1721           triggers:
     1722             on end-move persistent run diasize_end-move in this-procedure .
     1723           end triggers.
     1724         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1725         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1726         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1727         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1728         assign
     1729           v-diasize-wndmax = false
     1730         .
     1731         if connected("ub") = true
     1732         then do:
     1733           define variable v-cntxt-db-num        as integer   no-undo .
     1734           define variable v-cntxt-userid        as character no-undo .
     1735           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1736                                             , OUTPUT v-cntxt-userid
     1737                                             ) .
     1738           run gbl/wndpar_r.p
     1739             (input  v-cntxt-db-num
     1740             ,input  v-cntxt-userid
     1741             ,input  'wndmax':U
     1742             ,output v-diasize-wndmax
     1743             ,output v-default-value
     1744             ) .
     1745         end.
     1746         assign
     1747           v-diasize-wndstore = false
     1748         .
     1749         if connected("ub") = true
     1750         then do:
     1751           run gbl/wndpar_r.p
     1752             (input  v-cntxt-db-num
     1753             ,input  v-cntxt-userid
     1754             ,input  'wndstore':U
     1755             ,output v-diasize-wndstore
     1756             ,output v-default-value
     1757             ) .
     1758         end.
     1759         assign
     1760           v-diasize-proc-name = entry(1, program-name(2), '.')
     1761         .
     1762         if v-diasize-wndstore = true
     1763         then do:
     1764           assign
     1765             v-restore-saved = false
     1766           .
     1767           if connected("ub") = true
     1768           then do:
     1769             run gbl/wndsizer.p
     1770               (input  v-cntxt-db-num
     1771               ,input  v-cntxt-userid
     1772               ,input  v-diasize-proc-name
     1773               ,input  'height':u
     1774               ,output v-resize-value-str
     1775               ) .
     1776             if v-resize-value-str <> '':U
     1777             then do:
     1778               run diasize_change-height in this-procedure
     1779                 (input  integer(v-resize-value-str)
     1780                 ,input  true
     1781                 ) .
     1782               assign
     1783                 v-restore-saved = true
     1784               .
     1785             end.
     1786           end.
     1787           if connected("ub") = true
     1788           then do:
     1789             run gbl/wndsizer.p
     1790               (input  v-cntxt-db-num
     1791               ,input  v-cntxt-userid
     1792               ,input  v-diasize-proc-name
     1793               ,input  'width':u
     1794               ,output v-resize-value-str
     1795               ) .
     1796             if v-resize-value-str <> '':U
     1797             then do:
     1798               run diasize_change-width in this-procedure
     1799                 (input  integer(v-resize-value-str)
     1800                 ,input  true
     1801                 ) .
     1802               assign
     1803                 v-restore-saved = true
     1804               .
     1805             end.
     1806           end.
     1807           if v-restore-saved <> true
     1808           then do:
     1809             if v-diasize-wndmax = true
     1810             then do:
     1811               run diasize_maximize in this-procedure
     1812                 (input  true
     1813                 ) .
     1814             end.
     1815           end.
     1816         end.
     1817         else do:
     1818           if v-diasize-wndmax = true
     1819           then do:
     1820             run diasize_maximize in this-procedure
     1821               (input  true
     1822               ) .
     1823           end.
     1824         end.
     1825       end.
     1826     end.
     1827   end procedure.
     1828   procedure diasize_need-full-display :
     1829     define output parameter p-need-full-display as logical   no-undo .
     1830     do
     1831     on error undo, return error return-value
     1832     :
     1833       assign
     1834         p-need-full-display = v-diasize-need-full-display
     1835       .
     1836       assign
     1837         v-diasize-need-full-display = false
     1838       .
     1839     end.
     1840   end procedure.
     1841   procedure get-context :
     1842      define output parameter p-db-num as integer          no-undo.
     1843      define output parameter p-user-id as character        no-undo.
     1844      define variable v-login               as character    no-undo.
     1845      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1846      define buffer buf_user-login  for ub.user-login .
     1847      do
     1848      on error undo, return error
     1849      :
     1850            FIND FIRST buf_sys-ctrl no-lock.
     1851            ASSIGN
     1852               v-login = USERID("ub")
     1853               p-db-num = buf_sys-ctrl.db-num
     1854            .
     1855            FIND FIRST buf_user-login
     1856                 WHERE buf_user-login.db-num = p-db-num
     1857                   AND buf_user-login.user-login = v-login
     1858                 no-lock
     1859                 no-error
     1860                 .
     1861            IF AVAILABLE buf_user-login
     1862            THEN DO:
     1863               assign
     1864                  p-user-id = buf_user-login.user-id
     1865               .
     1866            END.
     1867      end.
     1868   end procedure.
     1869       run diasize_init in this-procedure .
     1870   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1871   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1872   MAIN-BLOCK:
     1873   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1874      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1875     v-rid-list = p-rid-list.
     1876   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1877     run mainmenu_getcntxt in parparentproc
     1878       (output v-cntxt-db-num
     1879       ,output v-cntxt-userid
     1880       ,output v-cntxt-level
     1881       ,output v-cntxt-host-code-obj
     1882       ,output v-cntxt-obj-type
     1883       ,output v-cntxt-obj-code
     1884       ,output v-cntxt-db-num-obj
     1885       ,output v-cntxt-is-admin
     1886       ) .
     1887     run Myenable in this-procedure .
     1888     WAIT-FOR GO OF FRAME Dialog-Frame.
     1889   END.
     1890   RUN disable_UI.
     1891   PROCEDURE disable_UI :
     1892     HIDE FRAME Dialog-Frame.
     1893   END PROCEDURE.
     1894   PROCEDURE enable_UI :
     1895     DISPLAY mark-num
     1896         WITH FRAME Dialog-Frame.
     1897     ENABLE b-quit b-mark b-sel b-add b-chg b-del b-lkp b-links B-Help br-prop-map
     1898            mark-num
     1899         WITH FRAME Dialog-Frame.
     1900     VIEW FRAME Dialog-Frame.
     1901     OPEN QUERY br-prop-map FOR EACH X_prop-map NO-LOCK,        FIRST X_prop-head NO-LOCK  indexed-reposition.
     1902   END PROCEDURE.
     1903   PROCEDURE MyEnable :
     1904   assign
     1905   X_prop-map.node-name:resizable in browse br-prop-map = yes
     1906   X_prop-map.node-label:resizable in browse br-prop-map = yes
     1907   X_prop-head.prop-name:resizable in browse br-prop-map = yes
     1908   X_prop-head.prop-label:resizable in browse br-prop-map = yes
     1909   b-links:MENU-MOUSE in frame Dialog-Frame = 1
     1910   .
     1911   ENABLE
     1912   b-quit
     1913   b-add when (v-cntxt-db-num = 0 and lookup("b-add", bttns) > 0)
     1914   b-chg when (v-cntxt-db-num = 0 and lookup("b-add", bttns) > 0)
     1915   b-del when (v-cntxt-db-num = 0 and lookup("b-add", bttns) > 0)
     1916   b-lkp
     1917   b-links
     1918   B-Help
     1919   b-mark when lookup("b-mark", bttns) > 0
     1920   b-sel when lookup("b-sel", bttns) > 0
     1921   br-prop-map
     1922   WITH FRAME Dialog-Frame.
     1923   VIEW FRAME Dialog-Frame.
     1924   run openbr in this-procedure .
     1925   END PROCEDURE.
     1926   PROCEDURE Openbr :
     1927   CASE p-list-mode:
     1928     WHEN 'все':U THEN DO:
     1929       frame Dialog-Frame:title = "Свойства объектов-операндов".
     1930       OPEN QUERY br-prop-map
     1931       FOR EACH X_prop-map NO-LOCK,
     1932           FIRST X_prop-head NO-LOCK WHERE
     1933                X_prop-head.dtm-code = X_prop-map.dtm-code INDEXED-REPOSITION.
     1934     END.
     1935     WHEN "dtm-code" THEN DO:
     1936       frame Dialog-Frame:title = substitute("Свойства объектов-операндов для объекта-операнда &1", p-dtm-code).
     1937       OPEN QUERY br-prop-map
     1938       FOR EACH X_prop-map NO-LOCK WHERE X_prop-map.dtm-code = p-dtm-code,
     1939           FIRST X_prop-head NO-LOCK WHERE
     1940                X_prop-head.dtm-code = X_prop-map.dtm-code INDEXED-REPOSITION.
     1941     END.
     1942   END CASE.
     1943   END PROCEDURE.
     1944   PROCEDURE proc-b-link :
     1945   DEFINE INPUT PARAMETER p-option AS CHARACTER NO-UNDO.
     1946   DEFINE VARIABLE v-rec AS RECID NO-UNDO.
     1947   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     1948   CASE p-option:
     1949     WHEN 'prop-head':U THEN DO:
     1950       v-rec = recid(X_prop-head).
     1951       run rul/prop-head-i.w ( input parparentproc
     1952                              ,input 'ПРОСМОТР':U
     1953                              ,input X_prop-head.dtm-code
     1954                              ,input-output v-rec) no-error.
     1955     END.
     1956     WHEN 'prop-script':U THEN DO:
     1957       run rul/prop-script-s.w (
     1958                              input parparentproc
     1959                             ,INPUT (if (v-cntxt-db-num = 0 and lookup("b-add", bttns) > 0)
     1960                                     then 'b-add'
     1961                                     else '':U)
     1962                             ,INPUT "dtm-code"
     1963                             ,INPUT '':U
     1964                             ,INPUT X_prop-head.dtm-code
     1965                             ,INPUT "":U
     1966                             ,INPUT "":U
     1967                              ,INPUT-OUTPUT v-rid-list) NO-ERROR.
     1968     END.
     1969   END CASE.
     1970   END PROCEDURE.
     1971   PROCEDURE proc-b-lkp :
     1972   DEFINE VARIABLE v-rec AS RECID NO-UNDO.
     1973   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     1974       v-rec = recid(X_prop-head).
     1975       run rul/prop-map-i.w ( input parparentproc
     1976                              ,input 'ПРОСМОТР':U
     1977                              ,input X_prop-map.dtm-code
     1978                              ,input X_prop-map.node-code
     1979                              ,input-output v-rec) no-error.
     1980   END PROCEDURE.
