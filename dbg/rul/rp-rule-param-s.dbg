        1   DEFINE BUFFER X_rp-rule-param FOR ub.rp-rule-param.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter bttns as character no-undo.
        4   define input parameter p-list-mode as character no-undo .
        5   define input parameter p-profile-id as integer no-undo .
        6   define input parameter p-codex-id as integer no-undo .
        7   define input parameter p-ruleset-id as integer no-undo .
        8   define input parameter p-rp-order-id as integer no-undo .
        9   define input parameter p-rule-id as integer no-undo .
       10   define input-output parameter p-rid-list as character no-undo.
       11   define variable vss-revision    as character no-undo init "$Revision$":U .
       12   define variable vss-author      as character no-undo init "$Author$":U .
       13   define variable vss-date        as character no-undo init "$Date$":U .
       14   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       15   define variable vss-archive     as character no-undo init "$Archive$":U .
       16   define variable vss-description as character no-undo init "Список rp-rule-param".
       17   procedure vss-get-info :
       18     define output parameter p-vss-revision    like vss-revision    no-undo .
       19     define output parameter p-vss-author      like vss-author      no-undo .
       20     define output parameter p-vss-date        like vss-date        no-undo .
       21     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       22     define output parameter p-vss-archive     like vss-archive     no-undo .
       23     define output parameter p-vss-description like vss-description no-undo .
       24     assign
       25       p-vss-revision    = vss-revision
       26       p-vss-author      = vss-author
       27       p-vss-date        = vss-date
       28       p-vss-workfile    = vss-workfile
       29       p-vss-archive     = vss-archive
       30       p-vss-description = vss-description
       31     .
       32   end procedure.
       33   procedure vss-get-parameters :
       34     define output parameter p-vss-parameters as character no-undo .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       72   define variable v-waitfram-action01         as character   no-undo .
       73   define variable v-waitfram-action02         as character   no-undo .
       74   define variable v-waitfram-action03         as character   no-undo .
       75   define variable mWaitFramTextBeg            as character   no-undo.
       76   define variable mWaitFramTextEnd            as character   no-undo.
       77   define variable mWaitFramView               as logical     no-undo.
       78   define variable mWaitProcEvent              as logical     no-undo init yes.
       79   define variable mWaitFramInterval           as integer     no-undo init 1 .
       80   define variable mWaitFramStop               as logical     no-undo.
       81   define variable mWaitFramStopUser           as logical     no-undo.
       82   define variable mWaitFramStopTimeOut        as logical     no-undo.
       83   define variable mWaitFramStartProc          as datetime-tz no-undo.
       84   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       85   define button B-WaitFramStop auto-end-key
       86        label "Стоп"
       87        size 10 by 1 tooltip "Остоновить процесс".
       88   define button B-viewProcInfo
       89        label "Информация"
       90        size 15 by 1 tooltip "Информация о процесс".
       91   define frame waitfram
       92     v-waitfram-action01 format "x(72)" no-label skip
       93     v-waitfram-action02 format "x(72)" no-label skip
       94     v-waitfram-action03 format "x(72)" no-label skip
       95     B-viewProcInfo
       96     B-WaitFramStop at row 4 col 30
       97     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       98     .
       99   define new global shared variable mBatchMode as logical no-undo init ?.
      100   define variable mFramBachModHandle as handle no-undo.
      101   mFramBachModHandle = frame waitfram:handle.
      102   define variable mFameOldVis as logical no-undo.
      103   define variable mVisCUrentVin as logical no-undo.
      104   if session:batch-mode
      105   then
      106      mBatchMode = yes.
      107   if mBatchMode = ? then do:
      108     mVisCUrentVin = current-window:visible.
      109     mFameOldVis = mFramBachModHandle:visible.
      110     mFramBachModHandle:visible  = yes.
      111     mBatchMode = mFramBachModHandle:visible ne yes.
      112     mFramBachModHandle:visible = mFameOldVis.
      113     current-window:visible = mVisCUrentVin.
      114   end.
      115    if  log-manager:logfile-name ne ?
      116     then DO:
      117         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      118         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      119         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      120     end.
      121   on choose of B-WaitFramStop in frame waitfram
      122   do:
      123     mWaitFramStop = yes.
      124     mWaitFramStopUser = yes.
      125   end.
      126   function waitfram-check-timeout returns logical():
      127      define variable vtime as int64 no-undo.
      128      if mWaitFramStopTimeOut
      129      then
      130         return yes.
      131      vtime = ( now - mWaitFramStartProc ) / 1000 .
      132      if     mWaitFramTimeOut ne ?
      133         and mWaitFramTimeOut ne 0
      134         and mWaitFramTimeOut lt vtime
      135      then do:
      136         mWaitFramStopTimeOut = yes.
      137      end.
      138      return mWaitFramStopTimeOut.
      139   end.
      140   procedure waitfram-hide :
      141     if not session:batch-mode
      142     then do
      143     on error undo, return error return-value
      144     :
      145       pause 0 before-hide .
      146       if not mBatchMode then
      147         hide frame waitfram .
      148     if     not mWaitFramView
      149        and mWaitProcEvent
      150     then
      151       process events .
      152     end.
      153   end procedure.
      154   procedure waitfram-show :
      155     define input  parameter p-message as character no-undo .
      156     define variable v-left-margin as integer   no-undo .
      157     if not session:batch-mode
      158     then do
      159     on error undo, return error return-value
      160     :
      161       if length(p-message) <= 70 then do:
      162         assign
      163           v-left-margin = integer((70 - length(p-message)) / 2)
      164         .
      165         assign
      166           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      167         .
      168         assign
      169           v-waitfram-action01 = " "
      170           v-waitfram-action02 = " "
      171                                    + fill(" ", v-left-margin)
      172                                    + p-message
      173           v-waitfram-action03 = " "
      174         .
      175       end.
      176       else do:
      177         define variable vRindex1 as integer no-undo.
      178         define variable vRindex2 as integer no-undo.
      179         vRindex1 = r-index(p-message," ",70).
      180         if vRindex1 = 0
      181         then
      182            vRindex1 = 70.
      183         if length(p-message)  <= vRindex1 + 70 then do:
      184           assign
      185             v-waitfram-action01 = " "
      186             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      187             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      188           .
      189         end.
      190         else do:
      191           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      192           if vRindex2 <= vRindex1
      193           then
      194              vRindex2 = vRindex1 + 70.
      195           assign
      196             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      197             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      198             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      199           .
      200         end.
      201       end.
      202       B-viewProcInfo:visible   in frame waitfram = no.
      203       B-viewProcInfo:sensitive in frame waitfram = no.
      204       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      205       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      206       if  (   mWaitFramView
      207          or  mWaitProcEvent)
      208          and not mBatchMode
      209       then
      210          display
      211             v-waitfram-action01 skip
      212             v-waitfram-action02 skip
      213             v-waitfram-action03 skip
      214          with frame waitfram .
      215       if     mWaitFramView
      216          then do:
      217             if     mWaitFramInterval ne ?
      218                and not mBatchMode
      219             then
      220                wait-for go of frame waitfram pause mWaitFramInterval.
      221          end.
      222          else
      223             if     mWaitProcEvent
      224                and not mBatchMode
      225             then
      226                process events .
      227     end.
      228   end procedure.
      229      procedure waitfram-show-this:
      230         define input  parameter iInterval as int64 no-undo.
      231         define variable vtime as int64 no-undo.
      232         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      233         mWaitFramInterval = iInterval.
      234         run waitfram-show (substitute("&1&2 &3&4" ,
      235                                       mWaitFramTextBeg ,
      236                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      237                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      238                                       mWaitFramTextEnd
      239                                      )
      240                           ).
      241      end.
      242      procedure WaitFramRunPause:
      243         define input  parameter iInterval as dec no-undo.
      244         define variable vStart  as datetime-tz no-undo.
      245         define variable vend    as datetime-tz no-undo.
      246         define variable vint as int64 no-undo.
      247         define variable vOk as logical no-undo.
      248         vStart = now.
      249         vend   = vStart.
      250         publish "WaitFramPause" (iInterval,output vOk).
      251         vend   =  now.
      252         vint = vend - vStart.
      253         vint = iInterval - vint / 1000.
      254         if     not mWaitFramStop
      255            and (   vint > 0
      256                 or (    not vOk
      257                     and iInterval eq ?
      258                     )
      259                 )
      260         then
      261            run waitfram-show-this (iInterval).
      262         vend   =  now.
      263         vint = vend - vStart.
      264         vint = iInterval - vint / 1000.
      265         if     not mWaitFramStop
      266            and vint > 0
      267         then do:
      268            run gbl/pause.p (vint * 1000).
      269         end.
      270         if iInterval ne ?
      271         then
      272            publish "WaitFramStop".
      273         waitfram-check-timeout().
      274      end.
      275      procedure WaitFramWaitFor:
      276         define input  parameter iInterval as dec no-undo.
      277         assign
      278            mWaitFramStartProc   = now
      279            mWaitFramStopUser    = no
      280            mWaitFramStopTimeOut = no
      281         .
      282         block-wait:
      283         do while not mWaitFramStop:
      284            run WaitFramRunPause (iInterval).
      285            if  waitfram-check-timeout()
      286            then do:
      287               leave block-wait.
      288            end.
      289         end.
      290         run waitfram-hide.
      291      end.
      292   procedure waitfram-join :
      293     define input  parameter p-line-1  as character no-undo .
      294     define input  parameter p-line-2  as character no-undo .
      295     define input  parameter p-line-3  as character no-undo .
      296     define output parameter p-message as character no-undo .
      297     do
      298     on error undo, return error return-value
      299     :
      300       assign
      301         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      302                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      303                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      304       .
      305     end.
      306   end procedure.
      307   function waitfram-join-function returns character
      308     (input p-line-1 as character
      309     ,input p-line-2 as character
      310     ,input p-line-3 as character
      311     ).
      312     define variable v-message as character no-undo .
      313     run waitfram-join in this-procedure
      314       (input  p-line-1
      315       ,input  p-line-2
      316       ,input  p-line-3
      317       ,output v-message
      318       ) .
      319     return v-message .
      320   end function .
      321   define new global shared variable g#language as character no-undo .
      322   if g#language <> '' and g#language <> 'rus':U then do:
      323     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      324   end.
      325   procedure proc-alt-shift-f2:
      326     if not ibs.th.gbl.gbl-var:rcode
      327   then
      328     run gbl\inidebug.p .
      329   end.
      330   procedure proc-alt-shift-f3:
      331     run gbl/prvssinf.p
      332       ( input this-procedure
      333       ) .
      334   end.
      335   define variable v-inform-launched as logical no-undo initial false .
      336   procedure proc-alt-shift-f4:
      337     define variable v-action as character no-undo .
      338     if v-inform-launched = false then do:
      339       assign
      340         v-inform-launched = true
      341       .
      342       run gbl/d-inform.w
      343         (  input self
      344         ,  input this-procedure
      345         , output v-action
      346         ) no-error .
      347       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      348       assign
      349         v-inform-launched = false
      350       .
      351     end.
      352   end.
      353   procedure proc-alt-f1:
      354     run gbl/corrhelp.p
      355       (input this-procedure
      356       ) .
      357   end .
      358   on alt-shift-f2 anywhere do:
      359     run proc-alt-shift-f2.
      360   end.
      361   on alt-shift-f3 anywhere do:
      362     run proc-alt-shift-f3 in this-procedure .
      363   end.
      364   on alt-shift-f4 anywhere do:
      365     run proc-alt-shift-f4 in this-procedure.
      366   end.
      367   on alt-f1 anywhere do:
      368     run proc-alt-f1 in this-procedure .
      369   end.
      370   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      371   FUNCTION mark-string RETURNS CHARACTER
      372     ( input p-recid as recid, input mark-list as character  ) :
      373     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      374   END FUNCTION.
      375   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      376     define variable v-cntxt-db-num        as integer   no-undo .
      377     define variable v-cntxt-userid        as character no-undo .
      378     define variable v-cntxt-level         as character no-undo .
      379     define variable v-cntxt-host-code-obj as integer   no-undo .
      380     define variable v-cntxt-obj-type      as character no-undo .
      381     define variable v-cntxt-obj-code      as integer   no-undo .
      382     define variable v-cntxt-db-num-obj    as integer   no-undo .
      383     define variable v-cntxt-is-admin      as logical   no-undo .
      384   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      385   procedure gen-key-rec :
      386     define input  parameter p-tbl-name    as character no-undo.
      387     define input  parameter p-bh_tbl-name as handle    no-undo.
      388     define output parameter p-key-rec     as character no-undo.
      389     do
      390     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      391     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      392     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      393     :
      394       define variable fh               as handle    no-undo .
      395       define variable v-ok             as logical   no-undo .
      396       define variable v-inform         as character no-undo .
      397       define variable v-ind            as integer   no-undo .
      398       define variable v-idx-field-qnty as integer   no-undo .
      399       if p-tbl-name = ?
      400         or p-tbl-name = "":U
      401       then do:
      402         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info3 ).
      403       end.
      404       if not p-bh_tbl-name:available then do:
      405         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info3, p-tbl-name ).
      406       end.
      407       assign
      408         p-key-rec = p-tbl-name
      409         v-inform  = p-bh_tbl-name:index-information(1)
      410         v-ind     = 2
      411       .
      412       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      413       on error undo, return error
      414       :
      415         assign
      416           v-inform = p-bh_tbl-name:index-information( v-ind )
      417           v-ind    = v-ind + 1
      418         .
      419       end.
      420       if v-inform = ?
      421         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      422         or entry( 3, v-inform, ",":U ) <> "1":U
      423       then do:
      424         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, p-tbl-name ).
      425       end.
      426       else do:
      427         assign
      428           v-idx-field-qnty = num-entries( v-inform ) - 4
      429         .
      430         if v-idx-field-qnty < 2 then do:
      431           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, p-tbl-name ).
      432         end.
      433         do v-ind = 1 to v-idx-field-qnty by 2
      434         on error undo, return error
      435         :
      436           assign
      437             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      438             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      439           .
      440         end.
      441       end.
      442       if p-key-rec = ? then do:
      443         assign
      444           p-key-rec = "":U
      445         .
      446         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info3, p-tbl-name ).
      447       end.
      448     end.
      449     return.
      450   end procedure.
      451   procedure gen-where-keyr-tab :
      452     define input  parameter i-tableSerach as character no-undo.
      453     define input  parameter i-tablekey   as character  no-undo.
      454     define input  parameter p-key-rec    as character  no-undo.
      455     define input  parameter p-key-handle as handle     no-undo .
      456     define input  parameter p-db-name    as character  no-undo .
      457     define input  parameter p-tt-handle  as handle     no-undo .
      458     define output parameter o-Where      as character  no-undo.
      459     do
      460     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      461     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      462     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      463     :
      464       define variable v-full-tbl-name  as character no-undo .
      465       define variable bh_tbl-name      as handle    no-undo .
      466       define variable fh_key           as handle    no-undo .
      467       define variable fh_search        as handle    no-undo .
      468       define variable v-field-num      as integer   no-undo .
      469       define variable v-count-fld      as integer   no-undo .
      470       define variable v-inform         as character no-undo .
      471       define variable v-ind            as integer   no-undo .
      472       define variable v-idx-field-qnty as integer   no-undo .
      473       define variable v-field-name     as character no-undo .
      474       define variable v-field-val      as character no-undo .
      475       define variable v-word-link      as character no-undo .
      476       define variable vTable           as character no-undo.
      477       define variable bh_tbl-key       as handle    no-undo .
      478       assign
      479         p-key-rec = trim( p-key-rec )
      480       .
      481       if p-key-handle <> ? then do:
      482         if not valid-handle(p-key-handle)
      483            or p-key-handle:type <> "buffer"
      484         then do:
      485           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info3 ).
      486         end.
      487         if num-entries( p-key-rec, chr(3) ) > 1
      488           or p-key-rec = ?
      489           or p-key-rec = "":U
      490         then do:
      491           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info3, p-key-rec ).
      492         end.
      493       end.
      494       else do:
      495         if p-key-rec = ?
      496           or p-key-rec = "":U
      497         then do:
      498           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      499         end.
      500       end.
      501       assign
      502         vTable = entry( 1 , p-key-rec, chr(3) )
      503       .
      504       if p-tt-handle <> ?
      505         and ( not valid-handle(p-tt-handle)
      506               or p-tt-handle:type <> "buffer"
      507             )
      508       then do:
      509         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info3, vTable, chr(10) ).
      510       end.
      511       if p-tt-handle = ? then do:
      512         assign
      513           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      514         .
      515         create buffer bh_tbl-name for table v-full-tbl-name .
      516       end.
      517       else do:
      518         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      519       end.
      520       assign
      521         v-inform = bh_tbl-name:index-information(1)
      522         v-ind    = 2
      523       .
      524       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      525       on error undo, return error
      526       :
      527         assign
      528           v-inform = bh_tbl-name:index-information( v-ind )
      529           v-ind    = v-ind + 1
      530         .
      531       end.
      532       if v-inform = ?
      533         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      534         or entry( 3, v-inform, ",":U ) <> "1":U
      535       then do:
      536         delete object bh_tbl-name no-error.
      537         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info3, vTable ).
      538       end.
      539       assign
      540         v-idx-field-qnty = num-entries( v-inform ) - 4
      541       .
      542       if v-idx-field-qnty < 2 then do:
      543         delete object bh_tbl-name no-error.
      544         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, vTable ).
      545       end.
      546       assign
      547         o-where     = "where":U
      548         v-word-link = "":U
      549         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      550         v-count-fld = 0
      551       .
      552       if i-tablekey ne "" and i-tablekey ne ?
      553       then do:
      554         assign
      555           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      556         .
      557         create buffer bh_tbl-key for table v-full-tbl-name .
      558       end.
      559       if i-tableSerach ne "" and i-tableSerach ne ?
      560       then do:
      561         delete object bh_tbl-name no-error.
      562         assign
      563           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      564         .
      565         create buffer bh_tbl-name for table v-full-tbl-name .
      566       end.
      567       block_where:
      568       do v-ind = 1 to v-idx-field-qnty by 2
      569       on error undo, return error
      570       :
      571         assign
      572           v-count-fld = v-count-fld + 1
      573         .
      574         if p-key-handle = ?
      575           and v-count-fld > v-field-num
      576         then do:
      577           leave block_where.
      578         end.
      579         define variable VfieldKeyTable as handle no-undo.
      580         assign
      581           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      582           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      583         .
      584         if     bh_tbl-key ne ?
      585         then do:
      586            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      587            if VfieldKeyTable eq ?
      588            then next block_where.
      589         end.
      590         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      591         then
      592            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      593         else
      594            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      595         if p-key-handle = ? then do:
      596           assign
      597             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      598           .
      599         end.
      600         else do:
      601           assign
      602             fh_key = p-key-handle:buffer-field( v-field-name )
      603           .
      604           if fh_key = ?
      605             or not valid-handle( fh_key )
      606           then do:
      607             delete object bh_tbl-name.
      608             if     bh_tbl-key ne ?
      609             then
      610                delete object bh_tbl-key.
      611             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info3, p-key-handle:name, v-field-name ).
      612           end.
      613           assign
      614             v-field-val = fh_key:buffer-value
      615           .
      616         end.
      617         if fh_search:data-type ="character":U then do:
      618           assign
      619             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      620             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      621             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      622             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      623             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      624             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      625             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      626             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      627             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      628             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      629             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      630             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      631             v-field-val = substitute( '"&1"', v-field-val )
      632           .
      633         end.
      634         assign
      635           o-where = substitute( "&1 &2", o-where, v-field-val )
      636         .
      637         if v-word-link = "":U then do:
      638           assign
      639             v-word-link = "and":U
      640           .
      641         end.
      642       end.
      643       delete object bh_tbl-name.
      644       if     bh_tbl-key ne ?
      645       then
      646          delete object bh_tbl-key.
      647       if p-key-handle = ?
      648         and v-count-fld <> v-field-num
      649       then do:
      650         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info3, vTable ).
      651       end.
      652     end.
      653   end procedure.
      654   procedure gen-hn-keyr-tab :
      655     define input  parameter i-tableSerach as character no-undo.
      656     define input  parameter i-tablekey   as character no-undo.
      657     define input  parameter p-key-rec    as character no-undo.
      658     define input  parameter p-key-handle as handle    no-undo .
      659     define input  parameter p-db-name    as character no-undo .
      660     define input  parameter p-tt-handle  as handle    no-undo .
      661     define input  parameter p-stts-lock  as integer   no-undo .
      662     define output parameter o-hn         as handle    no-undo.
      663     define variable v-full-tbl-name as character no-undo.
      664     define variable v-where         as character no-undo.
      665     define variable bh_tbl-name     as handle    no-undo.
      666     define variable vTable          as character no-undo.
      667     do
      668     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      669     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      670     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      671         run gen-where-keyr-tab(i-tableSerach,
      672                                i-tablekey,
      673                                p-key-rec,
      674                                p-key-handle,
      675                                p-db-name,
      676                                p-tt-handle,
      677                                output v-where).
      678         if i-tableSerach ne "" and i-tableSerach ne ?
      679         then do:
      680            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      681            create buffer bh_tbl-name for table v-full-tbl-name .
      682         end.
      683         else do:
      684            if p-tt-handle = ? then do:
      685               assign
      686                  vTable = entry( 1 , p-key-rec, chr(3) )
      687               .
      688               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      689               create buffer bh_tbl-name for table v-full-tbl-name .
      690            end.
      691            else do:
      692               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      693            end.
      694         end.
      695         if p-tt-handle = ? then do:
      696            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      697         end.
      698         else do:
      699            bh_tbl-name:find-first( v-where ) no-error .
      700         end.
      701         o-hn = bh_tbl-name.
      702      end.
      703   end procedure.
      704   procedure gen-hn-keyr :
      705     define input  parameter p-key-rec    as character no-undo.
      706     define input  parameter p-key-handle as handle    no-undo .
      707     define input  parameter p-db-name    as character no-undo .
      708     define input  parameter p-tt-handle  as handle    no-undo .
      709     define input  parameter p-stts-lock  as integer   no-undo .
      710     define output parameter o-hn         as handle    no-undo.
      711     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      712   end.
      713   procedure gen-row-keyr :
      714     define input  parameter p-key-rec    as character no-undo.
      715     define input  parameter p-key-handle as handle    no-undo .
      716     define input  parameter p-db-name    as character no-undo .
      717     define input  parameter p-tt-handle  as handle    no-undo .
      718     define input  parameter p-stts-lock  as integer   no-undo .
      719     define output parameter p-tbl-row    as rowid     no-undo.
      720     define output parameter p-tbl-name   as character no-undo.
      721     define variable vHn as handle no-undo.
      722       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      723       p-tbl-row = if vHn:available then vHn:rowid else ?.
      724       p-tbl-name =  vHn:table.
      725       delete object vHn no-error.
      726     if p-tbl-row = ? then do:
      727       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info3, p-tbl-name, p-key-rec ).
      728     end.
      729     else do:
      730       return.
      731     end.
      732   end procedure.
      733   procedure gen-key-fv :
      734     define input  parameter p-key-rec    as character no-undo .
      735     define output parameter p-field-list as character no-undo .
      736     define output parameter p-value-list as character no-undo.
      737     do
      738     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      739     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      740     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      741     :
      742       define variable v-full-tbl-name  as character no-undo .
      743       define variable bh_tbl-name      as handle    no-undo .
      744       define variable v-tbl-name       as character no-undo .
      745       define variable v-field-num      as integer   no-undo .
      746       define variable v-count-fld      as integer   no-undo .
      747       define variable v-inform         as character no-undo .
      748       define variable v-ind            as integer   no-undo .
      749       define variable v-idx-field-qnty as integer   no-undo .
      750       define variable v-delim-key      as character no-undo .
      751       if p-key-rec = ?
      752         or p-key-rec = "":U
      753       then do:
      754         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      755       end.
      756       assign
      757         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      758         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      759       .
      760       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      761       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info3 ).
      762       assign
      763         v-inform = bh_tbl-name:index-information(1)
      764         v-ind    = 2
      765       .
      766       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      767       on error undo, return error
      768       :
      769         assign
      770           v-inform = bh_tbl-name:index-information( v-ind )
      771           v-ind    = v-ind + 1
      772         .
      773       end.
      774       if v-inform = ?
      775         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      776         or entry( 3, v-inform, ",":U ) <> "1":U
      777       then do:
      778         delete object bh_tbl-name no-error.
      779         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
      780       end.
      781       assign
      782         v-idx-field-qnty = num-entries( v-inform ) - 4
      783       .
      784       if v-idx-field-qnty < 2 then do:
      785         delete object bh_tbl-name no-error.
      786         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
      787       end.
      788       assign
      789         p-field-list = "":U
      790         p-value-list = "":U
      791         v-delim-key  = "":U
      792         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      793         v-count-fld  = 0
      794       .
      795       block_where:
      796       do v-ind = 1 to v-idx-field-qnty by 2
      797       on error undo, return error
      798       :
      799         assign
      800           v-count-fld = v-count-fld + 1
      801         .
      802         if v-count-fld > v-field-num then do:
      803           leave block_where.
      804         end.
      805         assign
      806           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      807           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      808         .
      809         if v-ind = 1 then do:
      810           assign
      811             v-delim-key = chr(3)
      812           .
      813         end.
      814       end.
      815       delete object bh_tbl-name.
      816       if v-count-fld <> v-field-num then do:
      817         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info3, v-tbl-name ).
      818       end.
      819     end.
      820   end procedure.
      821   procedure gen-key-field :
      822     define input  parameter p-table      as character no-undo .
      823     define output parameter p-field-list as character no-undo .
      824     do
      825     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      826     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      827     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      828     :
      829       define variable v-full-tbl-name  as character no-undo .
      830       define variable bh_tbl-name      as handle    no-undo .
      831       define variable v-tbl-name       as character no-undo .
      832       define variable v-field-num      as integer   no-undo .
      833       define variable v-count-fld      as integer   no-undo .
      834       define variable v-inform         as character no-undo .
      835       define variable v-ind            as integer   no-undo .
      836       define variable v-idx-field-qnty as integer   no-undo .
      837       define variable v-delim-key      as character no-undo .
      838       if p-table = ?
      839         or p-table = "":U
      840       then do:
      841         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info3 ).
      842       end.
      843       assign
      844         v-tbl-name      = p-table
      845         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      846       .
      847       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      848       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info3 ).
      849       assign
      850         v-inform = bh_tbl-name:index-information(1)
      851         v-ind    = 2
      852       .
      853       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      854       on error undo, return error
      855       :
      856         assign
      857           v-inform = bh_tbl-name:index-information( v-ind )
      858           v-ind    = v-ind + 1
      859         .
      860       end.
      861       if v-inform = ?
      862         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      863         or entry( 3, v-inform, ",":U ) <> "1":U
      864       then do:
      865         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
      866       end.
      867       assign
      868         v-idx-field-qnty = num-entries( v-inform ) - 4
      869       .
      870       if v-idx-field-qnty < 2 then do:
      871         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
      872       end.
      873       assign
      874         p-field-list = "":U
      875         v-delim-key  = "":U
      876         v-count-fld  = 0
      877       .
      878       block_where:
      879       do v-ind = 1 to v-idx-field-qnty by 2
      880       on error undo, return error
      881       :
      882         assign
      883           v-count-fld = v-count-fld + 1
      884         .
      885         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      886         if v-ind = 1 then do:
      887           assign
      888             v-delim-key = chr(3)
      889           .
      890         end.
      891       end.
      892       delete object bh_tbl-name.
      893     end.
      894   end procedure.
      895   DEFINE VARIABLE v-doc-rec AS RECID NO-UNDO.
      896   DEFINE VARIABLE link-option AS CHARACTER NO-UNDO.
      897   define variable v-rid-list as character no-undo .
      898   DEFINE TEMP-TABLE tt0-rule-call-param NO-UNDO LIKE ub.rule-call-param.
      899   define temp-table for-copy-rp-rule-param no-undo like ub.rp-rule-param.
      900   DEFINE MENU MENU-b-link
      901          MENU-ITEM m_rule         LABEL "Правила"
      902          MENU-ITEM m_rule-profile LABEL "Профайл"       .
      903   DEFINE BUTTON b-chg
      904        LABEL "&Изменить"
      905        SIZE 10 BY 1.
      906   DEFINE BUTTON B-Help
      907        LABEL "Помо&щь"
      908        SIZE 3 BY 1
      909        BGCOLOR 8 .
      910   DEFINE BUTTON b-link
      911        LABEL "Связи"
      912        SIZE 10 BY 1.
      913   DEFINE BUTTON b-mark
      914        LABEL "&*"
      915        SIZE 4 BY 1.
      916   DEFINE BUTTON b-quit AUTO-END-KEY
      917        LABEL "&Выход"
      918        SIZE 10 BY 1
      919        BGCOLOR 8 .
      920   DEFINE BUTTON b-sel AUTO-GO
      921        LABEL "Выбор"
      922        SIZE 10 BY 1.
      923   DEFINE VARIABLE mark-num AS INTEGER FORMAT "->,>>>,>>9":U INITIAL 0
      924         VIEW-AS TEXT
      925        SIZE 9 BY .67
      926        FGCOLOR 10  NO-UNDO.
      927   DEFINE QUERY br-rp-rule-param FOR
      928         X_rp-rule-param SCROLLING.
      929   DEFINE BROWSE br-rp-rule-param
      930   QUERY br-rp-rule-param NO-LOCK DISPLAY
      931         mark-string(recid(X_rp-rule-param), v-rid-list) Format "X(1)" COLUMN-LABEL "*"
      932   X_rp-rule-param.profile_id COLUMN-LABEL "ID" FORMAT ">>>>>>>>9"
      933   X_rp-rule-param.codex_id COLUMN-LABEL "Кодекс" FORMAT ">>>>>>>>9"
      934   X_rp-rule-param.ruleset_id COLUMN-LABEL "Набор!правил" FORMAT ">>>>>>>>9"
      935   X_rp-rule-param.rp_order_id COLUMN-LABEL "Порядок!вызова" FORMAT ">>>>>>>>9"
      936   X_rp-rule-param.rule-param-name COLUMN-LABEL "Имя!пар-ра!в правиле" FORMAT "X(32)"
      937   X_rp-rule-param.rp-param-name COLUMN-LABEL "Имя!пар-ра!в профайле" FORMAT "X(32)"
      938       WITH NO-ROW-MARKERS SEPARATORS SIZE 97 BY 20.54 FIT-LAST-COLUMN.
      939   DEFINE FRAME Dialog-Frame
      940        b-quit AT ROW 1 COL 1
      941        b-mark AT ROW 1 COL 24 WIDGET-ID 12
      942        b-sel AT ROW 1 COL 28 WIDGET-ID 10
      943        b-chg AT ROW 1 COL 48 WIDGET-ID 4
      944        b-link AT ROW 1 COL 78 WIDGET-ID 16
      945        B-Help AT ROW 1 COL 95
      946        br-rp-rule-param AT ROW 2.25 COL 1.5 WIDGET-ID 100
      947        mark-num AT ROW 1 COL 13 COLON-ALIGNED NO-LABEL WIDGET-ID 14
      948        SPACE(74.50) SKIP(21.20)
      949       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      950            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      951            TITLE ""
      952            CANCEL-BUTTON b-quit.
      953   ASSIGN
      954          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      955          FRAME Dialog-Frame:HIDDEN           = TRUE.
      956   ASSIGN
      957          b-link:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-b-link:HANDLE.
      958   ON GO OF FRAME Dialog-Frame
      959   DO:
      960     p-rid-list = v-rid-list.
      961   END.
      962   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      963   DO:
      964     APPLY "END-ERROR":U TO SELF.
      965   END.
      966   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
      967   DO:
      968     RUN proc-b-chg IN THIS-PROCEDURE NO-ERROR.
      969     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      970   END.
      971   ON CHOOSE OF b-link IN FRAME Dialog-Frame
      972   DO:
      973   IF NOT AVAILABLE X_rp-rule-param THEN RETURN NO-APPLY.
      974   IF link-option = '':U THEN DO:
      975      run gbl/pop-up.p ( INPUT SELF:handle, input no ) no-error.
      976      if error-status :error then do: return no-apply. end.
      977   end.
      978   if link-option = "":U then do:
      979         return no-apply.
      980   end.
      981   run proc-b-link IN THIS-PROCEDURE ( INPUT link-option) NO-ERROR.
      982   IF ERROR-STATUS:ERROR THEN DO:
      983       link-option = '':U.
      984       RETURN NO-APPLY.
      985   END.
      986   link-option = '':U.
      987   END.
      988   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
      989   DO:
      990       define variable glog as logical no-undo .
      991     if available X_rp-rule-param then do:
      992   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      993   define variable v-str-recid5 as character no-undo .
      994   define variable v-num-entry5 as integer   no-undo .
      995   assign
      996     v-str-recid5 = trim( string( recid( X_rp-rule-param ) , "->>>>>>>>>>>9":U ) )
      997     v-num-entry5 = lookup( v-str-recid5 , v-rid-list )
      998   .
      999   if v-num-entry5 > 0 then do:
     1000     assign
     1001       entry( v-num-entry5, v-rid-list ) = "":U
     1002       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1003     .
     1004   end.
     1005   else do:
     1006     assign
     1007       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid5
     1008     .
     1009   end.
     1010     glog = br-rp-rule-param:refresh() .
     1011     if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1012         glog = br-rp-rule-param:select-next-row ().
     1013         apply "VALUE-CHANGED" to br-rp-rule-param in frame Dialog-Frame.
     1014     end.
     1015     if num-entries( v-rid-list ) = 0
     1016     then
     1017         hide mark-num in frame Dialog-Frame.
     1018     else
     1019         disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1020   end.
     1021   apply "entry" to br-rp-rule-param in frame Dialog-Frame.
     1022   END.
     1023   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     1024   DO:
     1025     if available X_rp-rule-param then do:
     1026       if  ( v-rid-list = "" ) or b-mark:sensitive = no
     1027       then  v-rid-list = string( recid( X_rp-rule-param ) ) .
     1028     end.
     1029   END.
     1030   ON CHOOSE OF MENU-ITEM m_rule
     1031   DO:
     1032     ASSIGN
     1033     link-option = 'rule':U.
     1034     RUN proc-b-link IN THIS-PROCEDURE ( INPUT link-option) NO-ERROR.
     1035     IF ERROR-STATUS:ERROR THEN DO:
     1036         link-option = '':U.
     1037         RETURN NO-APPLY.
     1038     END.
     1039     link-option = '':U.
     1040   END.
     1041   ON CHOOSE OF MENU-ITEM m_rule-profile
     1042   DO:
     1043       ASSIGN
     1044     link-option = 'rule-profile':U.
     1045     RUN proc-b-link IN THIS-PROCEDURE ( INPUT link-option) NO-ERROR.
     1046     IF ERROR-STATUS:ERROR THEN DO:
     1047         link-option = '':U.
     1048         RETURN NO-APPLY.
     1049     END.
     1050     link-option = '':U.
     1051   END.
     1052   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1053   on f5 of frame Dialog-Frame anywhere
     1054   do:
     1055      v-doc-rec = recid(X_rp-rule-param).    RUn OpenBR in this-procedure.  REPOSITION br-rp-rule-param to recid v-doc-rec No-ERROR.   apply 'value-changed' to br-rp-rule-param.
     1056       apply "VALUE-CHANGED" to br-rp-rule-param.
     1057   end.
     1058   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1059   on help of frame Dialog-Frame
     1060   do:
     1061     run gbl/app_help.p
     1062       (input this-procedure :file-name
     1063       ,input ''
     1064       ,input ?
     1065       ) no-error.
     1066     if error-status :error then do:
     1067       message
     1068         "Ошибка при вызове помощи"
     1069         error-status :get-message(1)
     1070         view-as alert-box .
     1071     end.
     1072   end.
     1073   run minbtn-set in this-procedure .
     1074   on choose of b-help in frame Dialog-Frame
     1075   do:
     1076     apply "help":u to frame Dialog-Frame .
     1077   end.
     1078   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1079   procedure minbtn-set :
     1080       do
     1081           on error undo, return error return-value
     1082           :
     1083           define variable ii              as integer       no-undo .
     1084           define variable fh              as widget-handle no-undo .
     1085           define variable hh              as widget-handle no-undo .
     1086           define variable v-h             as handle        extent 4 no-undo .
     1087           define variable v-name-button   as character     no-undo .
     1088           define variable v-help-old-x    as decimal       no-undo .
     1089           define variable v-help-old-y    as decimal       no-undo .
     1090           define variable v-help-old-size as decimal       no-undo .
     1091           define variable v-frame-width   as decimal       no-undo .
     1092           define variable jj              as integer       no-undo .
     1093           do
     1094               on error undo, return error
     1095               :
     1096               assign
     1097                   v-frame-width = frame Dialog-Frame:width - 0.3
     1098                   fh            = frame Dialog-Frame:first-child
     1099                   hh            = fh:first-child
     1100                   ii            = 1
     1101                   .
     1102               do while valid-handle(hh):
     1103                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1104                   do:
     1105                       case lc(hh:name) :
     1106                           when "b-help" then
     1107                               do:
     1108                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1109                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1110                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1111                                   hh:TOOLTIP = "Помощь" .
     1112                                   v-help-old-x = hh:column .
     1113                                   v-help-old-y = hh:row    .
     1114                                   v-help-old-size = hh:width .
     1115                                   hh:width-chars = 2.5 .
     1116                               end.
     1117                           when "b-print" then
     1118                               do:
     1119                                   hh:load-image("cmp/b-print.bmp":u) .
     1120                                   hh:TOOLTIP = "Печать" .
     1121                                   v-h[ii] = hh:handle .
     1122                                   ii = ii + 1 .
     1123                                   hh:width-chars = 3 .
     1124                               end.
     1125                           when "b-history" or
     1126                           when "b-hist" then
     1127                               do:
     1128                                   hh:load-image("cmp/b-hist.bmp":u) .
     1129                                   hh:TOOLTIP = "История" .
     1130                                   v-h[ii] = hh:handle .
     1131                                   ii = ii + 1 .
     1132                                   hh:width-chars = 3 .
     1133                               end.
     1134                           when "b-sch" then
     1135                               do:
     1136                                   hh:load-image("cmp/b-sch.bmp":u) .
     1137                                   hh:TOOLTIP = "Установка Фильтра" .
     1138                                   v-h[ii] = hh:handle .
     1139                                   ii = ii + 1 .
     1140                                   hh:width-chars = 3 .
     1141                               end.
     1142                           when "b-hist-user" then
     1143                               do:
     1144                                   hh:load-image("cmp/b-hist.bmp":u) .
     1145                                   hh:TOOLTIP = "История пользователя" .
     1146                                   ii = ii + 1 .
     1147                               end.
     1148                       end case.
     1149                   end.
     1150                   hh = hh:next-sibling.
     1151               end.
     1152               b-help:column = v-frame-width - b-help:width-chars.
     1153               jj = 0.
     1154               repeat ii = 4 to 1 by -1 :
     1155                   if valid-handle (v-h[ii] ) then
     1156                   do:
     1157                       jj  = jj + 1 .
     1158                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1159                       v-h[ii]:row    = v-help-old-y .
     1160                   end.
     1161               end.
     1162           end.
     1163       end.
     1164   end procedure.
     1165   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1166   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1167   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1168   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1169   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1170   define variable v-diasize-current-frame-height as decimal   no-undo .
     1171   define variable v-diasize-change-size          as logical   no-undo .
     1172   define variable v-diasize-resize-button        as handle    no-undo .
     1173   define variable v-diasize-wndmax               as logical   no-undo .
     1174   define variable v-diasize-wndstore             as logical   no-undo .
     1175   define variable v-diasize-proc-name            as character no-undo .
     1176   define variable v-diasize-browse-handle        as handle    no-undo .
     1177   define variable v-diasize-browse-number        as integer   no-undo .
     1178   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1179   define temp-table temp-diasize-handle no-undo
     1180     field handle-value  as handle
     1181     field save-position as decimal
     1182     index xpk is primary unique handle-value
     1183     .
     1184   define temp-table temp-browse-handle no-undo
     1185     field browse-type   as character
     1186     field browse-number as integer
     1187     field browse-handle as handle
     1188     field original-size as decimal
     1189     index xpk is primary unique browse-type browse-number
     1190     index xie browse-type browse-handle
     1191   .
     1192   procedure diasize_change-height :
     1193     define input  parameter p-change-value  as decimal   no-undo .
     1194     define input  parameter p-move-resize   as logical   no-undo .
     1195     define variable v-field-group-handle    as handle    no-undo .
     1196     define variable v-object-handle         as handle    no-undo .
     1197     define variable v-frame-height          as decimal   no-undo .
     1198     define variable v-frame-virtual-height  as decimal   no-undo .
     1199     define variable v-browse-height         as decimal   no-undo .
     1200     define variable v-window-height         as decimal   no-undo .
     1201     define variable v-window-virtual-height as decimal   no-undo .
     1202     define variable v-change-sign           as integer   no-undo .
     1203     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1204     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1205     if p-change-value > 0
     1206     then do:
     1207       if frame Dialog-Frame :height + p-change-value
     1208           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1209       then do:
     1210         assign
     1211           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1212                           - (frame Dialog-Frame :height-chars)
     1213         .
     1214         if p-change-value <= 0
     1215         then do:
     1216           run diasize_position-resize-button in this-procedure .
     1217           return .
     1218         end.
     1219       end.
     1220     end.
     1221     if p-change-value < 0
     1222     then do:
     1223       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1224       then do:
     1225         assign
     1226           p-change-value = v-diasize-orig-frame-height
     1227                          - (frame Dialog-Frame :height-chars)
     1228         .
     1229         if p-change-value >= 0
     1230         then do:
     1231           run diasize_position-resize-button in this-procedure .
     1232           return .
     1233         end.
     1234       end.
     1235     end.
     1236     if p-change-value >= 0
     1237     then do:
     1238       assign
     1239         v-change-sign = 1
     1240       .
     1241     end.
     1242     else do:
     1243       assign
     1244         v-change-sign = -1
     1245       .
     1246     end.
     1247     assign
     1248       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1249     .
     1250     if p-change-value = 0
     1251     then do:
     1252       run diasize_position-resize-button in this-procedure .
     1253       return .
     1254     end.
     1255     move_block:
     1256     do
     1257     on error undo move_block, retry move_block
     1258     :
     1259       if retry
     1260       then do:
     1261         do
     1262         on error undo move_block, leave move_block
     1263         :
     1264           if p-change-value > 0
     1265           then do:
     1266             for each buf_temp-diasize-handle
     1267             on error undo, next
     1268             :
     1269               assign
     1270                 v-object-handle = buf_temp-diasize-handle.handle-value
     1271               .
     1272               if v-object-handle <> v-diasize-resize-button
     1273               then do:
     1274                 assign
     1275                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1276                 .
     1277               end.
     1278             end.
     1279             assign
     1280               v-diasize-browse-handle :height = v-browse-height
     1281             .
     1282             for each buf_temp-browse-handle
     1283               where buf_temp-browse-handle.browse-type = 'height':u
     1284             on error undo, next
     1285             :
     1286               assign
     1287                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1288               .
     1289             end.
     1290             assign
     1291               frame Dialog-Frame :height = v-frame-height
     1292             .
     1293             if frame Dialog-Frame :scrollable = true
     1294             then do:
     1295               assign
     1296                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1297               .
     1298             end.
     1299             run diasize_position-resize-button in this-procedure .
     1300           end.
     1301           else do:
     1302             if frame Dialog-Frame :scrollable = true
     1303             then do:
     1304               assign
     1305                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1306               .
     1307             end.
     1308             assign
     1309               frame Dialog-Frame :height = v-frame-height
     1310             .
     1311             assign
     1312               v-diasize-browse-handle :height = v-browse-height
     1313             .
     1314             for each buf_temp-browse-handle
     1315               where buf_temp-browse-handle.browse-type = 'height':u
     1316             on error undo, next
     1317             :
     1318               assign
     1319                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1320               .
     1321             end.
     1322             for each buf_temp-diasize-handle
     1323             on error undo, next
     1324             :
     1325               assign
     1326                 v-object-handle = buf_temp-diasize-handle.handle-value
     1327               .
     1328               if v-object-handle <> v-diasize-resize-button
     1329               then do:
     1330                 assign
     1331                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1332                 .
     1333               end.
     1334             end.
     1335             run diasize_position-resize-button in this-procedure .
     1336           end.
     1337           assign
     1338             v-diasize-change-size = false
     1339           .
     1340           leave move_block .
     1341         end.
     1342       end.
     1343       assign
     1344         v-diasize-need-full-display = true
     1345       .
     1346       if v-diasize-change-size = false
     1347       then do:
     1348         assign
     1349           v-diasize-change-size = true
     1350         .
     1351       end.
     1352       else do:
     1353         return .
     1354       end.
     1355       assign
     1356         v-frame-height = frame Dialog-Frame :height
     1357         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1358         v-browse-height = v-diasize-browse-handle :height
     1359       .
     1360       for each buf_temp-browse-handle
     1361         where buf_temp-browse-handle.browse-type = 'height':u
     1362       :
     1363         assign
     1364           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1365         .
     1366       end.
     1367       for each buf_temp-diasize-handle
     1368       :
     1369         delete buf_temp-diasize-handle .
     1370       end.
     1371       assign
     1372         v-field-group-handle = frame Dialog-Frame :first-child
     1373       .
     1374       do while valid-handle(v-field-group-handle)
     1375       :
     1376         assign
     1377           v-object-handle = v-field-group-handle :first-child
     1378         .
     1379         do while valid-handle(v-object-handle)
     1380         :
     1381           if  v-object-handle <> v-diasize-browse-handle :handle
     1382           and can-query(v-object-handle, "row")
     1383           and can-query(v-object-handle, "height")
     1384           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1385           then do:
     1386             find first buf_temp-browse-handle
     1387               where buf_temp-browse-handle.browse-type   = 'height':u
     1388                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1389               no-error .
     1390             if available buf_temp-browse-handle
     1391             then do:
     1392             end.
     1393             else do:
     1394               create buf_temp-diasize-handle .
     1395               assign
     1396                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1397                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1398               .
     1399             end.
     1400           end.
     1401           assign
     1402             v-object-handle = v-object-handle :next-sibling
     1403           .
     1404         end.
     1405         assign
     1406           v-field-group-handle = v-field-group-handle :next-sibling
     1407         .
     1408       end.
     1409       do with frame Dialog-Frame
     1410       :
     1411         hide v-diasize-resize-button .
     1412         assign
     1413           v-diasize-resize-button :row    = 1
     1414           v-diasize-resize-button :column = 1
     1415         .
     1416       end.
     1417       if p-change-value > 0
     1418       then do:
     1419         if frame Dialog-Frame :scrollable = true
     1420         then do:
     1421           assign
     1422             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1423             no-error .
     1424           if error-status :error
     1425           or error-status :get-message(1) <> ""
     1426           then do:
     1427             undo move_block, retry move_block .
     1428           end.
     1429         end.
     1430         assign
     1431           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1432           no-error .
     1433         if error-status :error
     1434         or error-status :get-message(1) <> ""
     1435         then do:
     1436           undo move_block, retry move_block .
     1437         end.
     1438         assign
     1439           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1440           no-error .
     1441         if error-status :error
     1442         or error-status :get-message(1) <> ""
     1443         then do:
     1444           undo move_block, retry move_block .
     1445         end.
     1446         for each buf_temp-browse-handle
     1447           where buf_temp-browse-handle.browse-type = 'height':u
     1448         on error undo move_block, retry move_block
     1449         :
     1450           assign
     1451             buf_temp-browse-handle.browse-handle :height
     1452               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1453             no-error .
     1454           if error-status :error
     1455           or error-status :get-message(1) <> ""
     1456           then do:
     1457             undo move_block, retry move_block .
     1458           end.
     1459         end.
     1460         for each buf_temp-diasize-handle
     1461         on error undo move_block, retry move_block
     1462         :
     1463           assign
     1464             v-object-handle = buf_temp-diasize-handle.handle-value
     1465           .
     1466           if v-object-handle <> v-diasize-resize-button
     1467           then do:
     1468             assign
     1469               v-object-handle :row = v-object-handle :row + p-change-value
     1470               no-error .
     1471             if error-status :error
     1472             or error-status :get-message(1) <> ""
     1473             then do:
     1474               undo move_block, retry move_block .
     1475             end.
     1476           end.
     1477         end.
     1478       end.
     1479       else do:
     1480         for each buf_temp-diasize-handle
     1481         on error undo move_block, retry move_block
     1482         :
     1483           assign
     1484             v-object-handle = buf_temp-diasize-handle.handle-value
     1485           .
     1486           if v-object-handle <> v-diasize-resize-button
     1487           then do:
     1488             assign
     1489               v-object-handle :row = v-object-handle :row + p-change-value
     1490               no-error .
     1491             if error-status :error
     1492             or error-status :get-message(1) <> ""
     1493             then do:
     1494               undo move_block, retry move_block .
     1495             end.
     1496           end.
     1497         end.
     1498         assign
     1499           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1500           no-error .
     1501         if error-status :error
     1502         or error-status :get-message(1) <> ""
     1503         then do:
     1504           undo move_block, retry move_block .
     1505         end.
     1506         for each buf_temp-browse-handle
     1507           where buf_temp-browse-handle.browse-type = 'height':u
     1508         on error undo move_block, retry move_block
     1509         :
     1510           assign
     1511             buf_temp-browse-handle.browse-handle :height
     1512               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1513             no-error .
     1514           if error-status :error
     1515           or error-status :get-message(1) <> ""
     1516           then do:
     1517             undo move_block, retry move_block .
     1518           end.
     1519         end.
     1520         assign
     1521           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1522           no-error .
     1523         if error-status :error
     1524         or error-status :get-message(1) <> ""
     1525         then do:
     1526           undo move_block, retry move_block .
     1527         end.
     1528         if frame Dialog-Frame :scrollable = true
     1529         then do:
     1530           assign
     1531             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1532             no-error .
     1533           if error-status :error
     1534           or error-status :get-message(1) <> ""
     1535           then do:
     1536             undo move_block, retry move_block .
     1537           end.
     1538         end.
     1539       end.
     1540       if p-move-resize = true
     1541       then do:
     1542         run diasize_position-resize-button in this-procedure .
     1543       end.
     1544       if v-diasize-wndstore = true
     1545       then do:
     1546         if connected("ub") = true
     1547         then do:
     1548           define variable v-cntxt-db-num        as integer   no-undo .
     1549           define variable v-cntxt-userid        as character no-undo .
     1550           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1551                                             , OUTPUT v-cntxt-userid
     1552                                             ) .
     1553           run gbl/wndsizew.p
     1554             (input  v-cntxt-db-num
     1555             ,input  v-cntxt-userid
     1556             ,input  v-diasize-proc-name
     1557             ,input  'height':u
     1558             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1559             ) .
     1560         end.
     1561       end.
     1562     end.
     1563     assign
     1564       v-diasize-change-size = false
     1565     .
     1566   end procedure.
     1567   procedure diasize_set-height :
     1568     define input  parameter p-new-height  as decimal   no-undo .
     1569     define input  parameter p-move-resize as logical   no-undo .
     1570     do
     1571     on error undo, return error return-value
     1572     :
     1573       run diasize_change-height in this-procedure
     1574         (input  (p-new-height - frame Dialog-Frame :height)
     1575         ,input  p-move-resize
     1576         ) .
     1577     end.
     1578   end procedure.
     1579   procedure diasize_change-width :
     1580     define input  parameter p-change-value as decimal   no-undo .
     1581     define input  parameter p-move-resize  as logical   no-undo .
     1582     define variable v-field-group-handle   as handle    no-undo .
     1583     define variable v-object-handle        as handle    no-undo .
     1584     define variable v-frame-width          as decimal   no-undo .
     1585     define variable v-frame-virtual-width  as decimal   no-undo .
     1586     define variable v-browse-width         as decimal   no-undo .
     1587     define variable v-window-width         as decimal   no-undo .
     1588     define variable v-window-virtual-width as decimal   no-undo .
     1589     define variable v-change-sign          as integer   no-undo .
     1590     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1591     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1592     if p-change-value > 0
     1593     then do:
     1594       if frame Dialog-Frame :width + p-change-value >
     1595           session :width-chars
     1596       then do:
     1597         assign
     1598           p-change-value = session :width-chars - frame Dialog-Frame :width
     1599         .
     1600         if p-change-value <= 0
     1601         then do:
     1602           run diasize_position-resize-button in this-procedure .
     1603           return .
     1604         end.
     1605       end.
     1606     end.
     1607     if p-change-value < 0
     1608     then do:
     1609       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1610       then do:
     1611         assign
     1612           p-change-value = v-diasize-orig-frame-width
     1613                          - frame Dialog-Frame :width
     1614         .
     1615         if p-change-value >= 0
     1616         then do:
     1617           run diasize_position-resize-button in this-procedure .
     1618           return .
     1619         end.
     1620       end.
     1621     end.
     1622     if p-change-value >= 0
     1623     then do:
     1624       assign
     1625         v-change-sign = 1
     1626       .
     1627     end.
     1628     else do:
     1629       assign
     1630         v-change-sign = -1
     1631       .
     1632     end.
     1633     assign
     1634       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1635     .
     1636     if p-change-value = 0
     1637     then do:
     1638       run diasize_position-resize-button in this-procedure .
     1639       return .
     1640     end.
     1641     move_block:
     1642     do
     1643     on error undo move_block, leave move_block
     1644     :
     1645       if retry
     1646       then do:
     1647         do
     1648         on error undo move_block, leave move_block
     1649         :
     1650           if p-change-value > 0
     1651           then do:
     1652             for each buf_temp-diasize-handle
     1653             on error undo, next
     1654             :
     1655               assign
     1656                 v-object-handle = buf_temp-diasize-handle.handle-value
     1657               .
     1658               if v-object-handle <> v-diasize-resize-button
     1659               then do:
     1660                 assign
     1661                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1662                 .
     1663               end.
     1664             end.
     1665             assign
     1666               v-diasize-browse-handle :width = v-browse-width
     1667             .
     1668             for each buf_temp-browse-handle
     1669               where buf_temp-browse-handle.browse-type = 'width':u
     1670             on error undo, next
     1671             :
     1672               assign
     1673                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1674               .
     1675             end.
     1676             assign
     1677               frame Dialog-Frame :width = v-frame-width
     1678             .
     1679             if frame Dialog-Frame :scrollable = true
     1680             then do:
     1681               assign
     1682                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1683               .
     1684             end.
     1685             run diasize_position-resize-button in this-procedure .
     1686           end.
     1687           else do:
     1688             if frame Dialog-Frame :scrollable = true
     1689             then do:
     1690               assign
     1691                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1692               .
     1693             end.
     1694             assign
     1695               frame Dialog-Frame :width = v-frame-width
     1696             .
     1697             for each buf_temp-browse-handle
     1698               where buf_temp-browse-handle.browse-type = 'width':u
     1699             on error undo, next
     1700             :
     1701               assign
     1702                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1703               .
     1704             end.
     1705             assign
     1706               v-diasize-browse-handle :width = v-browse-width
     1707             .
     1708             for each buf_temp-diasize-handle
     1709             on error undo, next
     1710             :
     1711               assign
     1712                 v-object-handle = buf_temp-diasize-handle.handle-value
     1713               .
     1714               if v-object-handle <> v-diasize-resize-button
     1715               then do:
     1716                 assign
     1717                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1718                 .
     1719               end.
     1720             end.
     1721             run diasize_position-resize-button in this-procedure .
     1722           end.
     1723           assign
     1724             v-diasize-change-size = false
     1725           .
     1726           leave move_block .
     1727         end.
     1728       end.
     1729       assign
     1730         v-diasize-need-full-display = true
     1731       .
     1732       if v-diasize-change-size = false
     1733       then do:
     1734         assign
     1735           v-diasize-change-size = true
     1736         .
     1737       end.
     1738       else do:
     1739         return .
     1740       end.
     1741       assign
     1742         v-frame-width = frame Dialog-Frame :width
     1743         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1744         v-browse-width = v-diasize-browse-handle :width
     1745       .
     1746       for each buf_temp-browse-handle
     1747         where buf_temp-browse-handle.browse-type = 'width':u
     1748       :
     1749         assign
     1750           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1751         .
     1752       end.
     1753       for each buf_temp-diasize-handle
     1754       :
     1755         delete buf_temp-diasize-handle .
     1756       end.
     1757       assign
     1758         v-field-group-handle = frame Dialog-Frame :first-child
     1759       .
     1760       do while valid-handle(v-field-group-handle)
     1761       :
     1762         assign
     1763           v-object-handle = v-field-group-handle :first-child
     1764         .
     1765         do while valid-handle(v-object-handle)
     1766         :
     1767           if  v-object-handle <> v-diasize-browse-handle :handle
     1768           and v-object-handle <> v-diasize-resize-button
     1769           and can-query(v-object-handle, "row")
     1770           and can-query(v-object-handle, "height")
     1771           and ( v-object-handle :col + v-object-handle :width
     1772                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1773               )
     1774           then do:
     1775             find first buf_temp-browse-handle
     1776               where buf_temp-browse-handle.browse-type   = 'width':u
     1777                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1778               no-error .
     1779             if available buf_temp-browse-handle
     1780             then do:
     1781             end.
     1782             else do:
     1783               create buf_temp-diasize-handle .
     1784               assign
     1785                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1786                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1787               .
     1788             end.
     1789           end.
     1790           assign
     1791             v-object-handle = v-object-handle :next-sibling
     1792           .
     1793         end.
     1794         assign
     1795           v-field-group-handle = v-field-group-handle :next-sibling
     1796         .
     1797       end.
     1798       do with frame Dialog-Frame
     1799       :
     1800         hide v-diasize-resize-button .
     1801         v-diasize-resize-button :row = 1.
     1802         v-diasize-resize-button :column = 1.
     1803       end.
     1804       if p-change-value > 0
     1805       then do:
     1806         if frame Dialog-Frame :scrollable = true
     1807         then do:
     1808           assign
     1809             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1810             no-error .
     1811           if error-status :error
     1812           or error-status :get-message(1) <> ""
     1813           then do:
     1814             undo move_block, retry move_block.
     1815           end.
     1816         end.
     1817         assign
     1818           frame Dialog-Frame :width = v-frame-width + p-change-value
     1819           no-error .
     1820         if error-status :error
     1821         or error-status :get-message(1) <> ""
     1822         then do:
     1823           undo move_block, retry move_block.
     1824         end.
     1825         assign
     1826           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1827         no-error .
     1828         if error-status :error
     1829         or error-status :get-message(1) <> ""
     1830         then do:
     1831           undo move_block, retry move_block.
     1832         end.
     1833         for each buf_temp-browse-handle
     1834           where buf_temp-browse-handle.browse-type = 'width':u
     1835         on error undo move_block, retry move_block
     1836         :
     1837           assign
     1838             buf_temp-browse-handle.browse-handle :width
     1839               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1840             no-error .
     1841           if error-status :error
     1842           or error-status :get-message(1) <> ""
     1843           then do:
     1844             undo move_block, retry move_block .
     1845           end.
     1846         end.
     1847         for each buf_temp-diasize-handle
     1848         on error undo move_block, retry move_block
     1849         :
     1850           assign
     1851             v-object-handle = buf_temp-diasize-handle.handle-value
     1852           .
     1853           if v-object-handle <> v-diasize-resize-button
     1854           then do:
     1855             assign
     1856               v-object-handle :col = v-object-handle :col + p-change-value
     1857               no-error .
     1858             if error-status :error
     1859             or error-status :get-message(1) <> ""
     1860             then do:
     1861               undo move_block, retry move_block .
     1862             end.
     1863           end.
     1864         end.
     1865       end.
     1866       else do:
     1867         for each buf_temp-diasize-handle
     1868         on error undo move_block, retry move_block
     1869         :
     1870           assign
     1871             v-object-handle = buf_temp-diasize-handle.handle-value
     1872           .
     1873           if v-object-handle <> v-diasize-resize-button
     1874           then do:
     1875             assign
     1876               v-object-handle :col = v-object-handle :col + p-change-value
     1877               no-error .
     1878             if error-status :error
     1879             or error-status :get-message(1) <> ""
     1880             then do:
     1881               undo move_block, retry move_block .
     1882             end.
     1883           end.
     1884         end.
     1885         for each buf_temp-browse-handle
     1886           where buf_temp-browse-handle.browse-type = 'width':u
     1887         on error undo move_block, retry move_block
     1888         :
     1889           assign
     1890             buf_temp-browse-handle.browse-handle :width
     1891               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1892             no-error .
     1893           if error-status :error
     1894           or error-status :get-message(1) <> ""
     1895           then do:
     1896             undo move_block, retry move_block .
     1897           end.
     1898         end.
     1899         assign
     1900           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1901           no-error .
     1902         if error-status :error
     1903         or error-status :get-message(1) <> ""
     1904         then do:
     1905           undo move_block, retry move_block.
     1906         end.
     1907         assign
     1908           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1909         no-error .
     1910         if error-status :error
     1911         or error-status :get-message(1) <> ""
     1912         then do:
     1913           undo move_block, retry move_block.
     1914         end.
     1915         if frame Dialog-Frame :scrollable = true
     1916         then do:
     1917           assign
     1918             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1919           no-error .
     1920           if error-status :error
     1921           or error-status :get-message(1) <> ""
     1922           then do:
     1923             undo move_block, retry move_block.
     1924           end.
     1925         end.
     1926       end.
     1927       if p-move-resize
     1928       then do:
     1929         run diasize_position-resize-button in this-procedure .
     1930       end.
     1931       if v-diasize-wndstore = true
     1932       then do:
     1933         if connected("ub") = true
     1934         then do:
     1935           define variable v-cntxt-db-num        as integer   no-undo .
     1936           define variable v-cntxt-userid        as character no-undo .
     1937           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1938                                             , OUTPUT v-cntxt-userid
     1939                                             ) .
     1940           run gbl/wndsizew.p
     1941             (input  v-cntxt-db-num
     1942             ,input  v-cntxt-userid
     1943             ,input  v-diasize-proc-name
     1944             ,input  'width':u
     1945             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1946             ) .
     1947         end.
     1948       end.
     1949     end.
     1950     assign
     1951       v-diasize-change-size = false
     1952     .
     1953   end procedure.
     1954   procedure diasize_set-width :
     1955     define input  parameter p-new-width  as decimal   no-undo .
     1956     define input  parameter p-move-resize as logical   no-undo .
     1957     do
     1958     on error undo, return error return-value
     1959     :
     1960       run diasize_change-width in this-procedure
     1961         (input  (p-new-width - frame Dialog-Frame :width)
     1962         ,input  p-move-resize
     1963         ) .
     1964     end.
     1965   end procedure.
     1966   procedure diasize_position-resize-button :
     1967     do with frame Dialog-Frame
     1968     :
     1969       hide v-diasize-resize-button .
     1970       assign
     1971         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1972                     - 1
     1973                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1974         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1975                     - 1
     1976                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1977       .
     1978       view v-diasize-resize-button .
     1979     end.
     1980   end procedure.
     1981   on alt-right anywhere
     1982   do:
     1983     run diasize_change-width in this-procedure
     1984       (input 1
     1985       ,input true
     1986       ) .
     1987     return no-apply .
     1988   end.
     1989   on alt-left anywhere
     1990   do:
     1991     run diasize_change-width in this-procedure
     1992       (input -1
     1993       ,input true
     1994       ) .
     1995     return no-apply .
     1996   end.
     1997   on alt-down anywhere
     1998   do:
     1999     run diasize_change-height in this-procedure
     2000       (input 1
     2001       ,input true
     2002       ) .
     2003     return no-apply .
     2004   end.
     2005   on alt-up anywhere
     2006   do:
     2007     run diasize_change-height in this-procedure
     2008       (input -1
     2009       ,input true
     2010       ) .
     2011     return no-apply .
     2012   end.
     2013   on alt-enter of frame Dialog-Frame
     2014   do:
     2015     run diasize_maximize in this-procedure
     2016       (input  ?
     2017       ).
     2018     return no-apply .
     2019   end.
     2020   procedure diasize_end-move :
     2021     do
     2022     on error undo, return error return-value
     2023     :
     2024       define variable v-row-delta as decimal   no-undo .
     2025       define variable v-col-delta as decimal   no-undo .
     2026       define variable v-new-row as decimal   no-undo .
     2027       define variable v-new-col as decimal   no-undo .
     2028       assign
     2029         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2030         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2031       .
     2032       assign
     2033         v-row-delta = v-new-row - frame Dialog-Frame :height
     2034         v-col-delta = v-new-col - frame Dialog-Frame :width
     2035       .
     2036       run diasize_change-height in this-procedure
     2037         (input v-row-delta
     2038         ,input true
     2039         ) .
     2040       run diasize_change-width in this-procedure
     2041         (input v-col-delta
     2042         ,input true
     2043         ) .
     2044     end.
     2045   end procedure.
     2046   procedure diasize_maximize :
     2047     define input  parameter p-action as logical   no-undo .
     2048     do
     2049     on error undo, return error return-value
     2050     :
     2051       if p-action = ?
     2052       then do:
     2053         if v-diasize-need-maximize = true
     2054         then do:
     2055           assign
     2056             p-action = true
     2057           .
     2058         end.
     2059         else do:
     2060           assign
     2061             p-action = false
     2062           .
     2063         end.
     2064       end.
     2065       if p-action = true
     2066       then do:
     2067         run diasize_change-height in this-procedure
     2068           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2069               - frame Dialog-Frame :height-chars
     2070           ,input true
     2071           ) .
     2072         run diasize_change-width in this-procedure
     2073           (input session :width-chars
     2074               - frame Dialog-Frame :width-chars
     2075           ,input true
     2076           ) .
     2077         assign
     2078           v-diasize-need-maximize = false
     2079         .
     2080       end.
     2081       else do:
     2082         run diasize_change-width in this-procedure
     2083           (input v-diasize-orig-frame-width
     2084               - frame Dialog-Frame :width-chars
     2085           ,input true
     2086           ) .
     2087         run diasize_change-height in this-procedure
     2088           (input v-diasize-orig-frame-height
     2089               - frame Dialog-Frame :height-chars
     2090           ,input true
     2091           ) .
     2092         assign
     2093           v-diasize-need-maximize = true
     2094         .
     2095       end.
     2096     end.
     2097   end procedure.
     2098   procedure diasize_restore-orig-size :
     2099     do
     2100     on error undo, return error return-value
     2101     :
     2102       assign
     2103         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2104         v-diasize-current-frame-height = frame Dialog-Frame :height
     2105       .
     2106       run diasize_set-height in this-procedure
     2107         (input  v-diasize-orig-frame-height
     2108         ,input  true
     2109         ) .
     2110       run diasize_set-width in this-procedure
     2111         (input  v-diasize-orig-frame-width
     2112         ,input  true
     2113         ) .
     2114     end.
     2115   end procedure.
     2116   procedure diasize_restore-current-size :
     2117     do
     2118     on error undo, return error return-value
     2119     :
     2120       run diasize_set-height in this-procedure
     2121         (input  v-diasize-current-frame-height
     2122         ,input  true
     2123         ) .
     2124       run diasize_set-width in this-procedure
     2125         (input  v-diasize-current-frame-width
     2126         ,input  true
     2127         ) .
     2128     end.
     2129   end procedure.
     2130   procedure diasize_set-browse-handle :
     2131     define input  parameter p-browse-handle as handle   no-undo .
     2132     define buffer buf_temp-browse-handle for temp-browse-handle .
     2133     do
     2134     on error undo, return error return-value
     2135     :
     2136       assign
     2137         v-diasize-browse-handle = p-browse-handle
     2138       .
     2139       for each buf_temp-browse-handle
     2140       on error undo, return error return-value
     2141       :
     2142         delete buf_temp-browse-handle .
     2143       end.
     2144     end.
     2145   end procedure.
     2146   procedure diasize_add_browse :
     2147     define input  parameter p-browse-type   as character no-undo .
     2148     define input  parameter p-browse-handle as handle    no-undo .
     2149     define buffer buf_temp-browse-handle for temp-browse-handle .
     2150     do
     2151     on error undo, return error return-value
     2152     :
     2153       assign
     2154         v-diasize-browse-number = v-diasize-browse-number + 1
     2155       .
     2156       create buf_temp-browse-handle .
     2157       assign
     2158         buf_temp-browse-handle.browse-type   = p-browse-type
     2159         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2160         buf_temp-browse-handle.browse-handle = p-browse-handle
     2161       .
     2162     end.
     2163   end procedure.
     2164   procedure diasize_init :
     2165     define variable v-default-value    as logical   no-undo .
     2166     define variable v-restore-saved    as logical   no-undo .
     2167     define variable v-resize-value-str as character no-undo .
     2168     do
     2169     on error undo, return error return-value
     2170     :
     2171       do with frame Dialog-Frame
     2172       :
     2173         assign
     2174           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2175           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2176           v-diasize-browse-handle     = browse br-rp-rule-param :handle
     2177         .
     2178         create button v-diasize-resize-button
     2179         assign
     2180           parent        = frame Dialog-Frame :first-child
     2181           label         = "s"
     2182           height-pixels = 16
     2183           width-pixels  = 16
     2184           visible       = true
     2185           sensitive     = true
     2186           movable       = true
     2187           triggers:
     2188             on end-move persistent run diasize_end-move in this-procedure .
     2189           end triggers.
     2190         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2191         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2192         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2193         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2194         assign
     2195           v-diasize-wndmax = false
     2196         .
     2197         if connected("ub") = true
     2198         then do:
     2199           define variable v-cntxt-db-num        as integer   no-undo .
     2200           define variable v-cntxt-userid        as character no-undo .
     2201           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2202                                             , OUTPUT v-cntxt-userid
     2203                                             ) .
     2204           run gbl/wndpar_r.p
     2205             (input  v-cntxt-db-num
     2206             ,input  v-cntxt-userid
     2207             ,input  'wndmax':U
     2208             ,output v-diasize-wndmax
     2209             ,output v-default-value
     2210             ) .
     2211         end.
     2212         assign
     2213           v-diasize-wndstore = false
     2214         .
     2215         if connected("ub") = true
     2216         then do:
     2217           run gbl/wndpar_r.p
     2218             (input  v-cntxt-db-num
     2219             ,input  v-cntxt-userid
     2220             ,input  'wndstore':U
     2221             ,output v-diasize-wndstore
     2222             ,output v-default-value
     2223             ) .
     2224         end.
     2225         assign
     2226           v-diasize-proc-name = entry(1, program-name(2), '.')
     2227         .
     2228         if v-diasize-wndstore = true
     2229         then do:
     2230           assign
     2231             v-restore-saved = false
     2232           .
     2233           if connected("ub") = true
     2234           then do:
     2235             run gbl/wndsizer.p
     2236               (input  v-cntxt-db-num
     2237               ,input  v-cntxt-userid
     2238               ,input  v-diasize-proc-name
     2239               ,input  'height':u
     2240               ,output v-resize-value-str
     2241               ) .
     2242             if v-resize-value-str <> '':U
     2243             then do:
     2244               run diasize_change-height in this-procedure
     2245                 (input  integer(v-resize-value-str)
     2246                 ,input  true
     2247                 ) .
     2248               assign
     2249                 v-restore-saved = true
     2250               .
     2251             end.
     2252           end.
     2253           if connected("ub") = true
     2254           then do:
     2255             run gbl/wndsizer.p
     2256               (input  v-cntxt-db-num
     2257               ,input  v-cntxt-userid
     2258               ,input  v-diasize-proc-name
     2259               ,input  'width':u
     2260               ,output v-resize-value-str
     2261               ) .
     2262             if v-resize-value-str <> '':U
     2263             then do:
     2264               run diasize_change-width in this-procedure
     2265                 (input  integer(v-resize-value-str)
     2266                 ,input  true
     2267                 ) .
     2268               assign
     2269                 v-restore-saved = true
     2270               .
     2271             end.
     2272           end.
     2273           if v-restore-saved <> true
     2274           then do:
     2275             if v-diasize-wndmax = true
     2276             then do:
     2277               run diasize_maximize in this-procedure
     2278                 (input  true
     2279                 ) .
     2280             end.
     2281           end.
     2282         end.
     2283         else do:
     2284           if v-diasize-wndmax = true
     2285           then do:
     2286             run diasize_maximize in this-procedure
     2287               (input  true
     2288               ) .
     2289           end.
     2290         end.
     2291       end.
     2292     end.
     2293   end procedure.
     2294   procedure diasize_need-full-display :
     2295     define output parameter p-need-full-display as logical   no-undo .
     2296     do
     2297     on error undo, return error return-value
     2298     :
     2299       assign
     2300         p-need-full-display = v-diasize-need-full-display
     2301       .
     2302       assign
     2303         v-diasize-need-full-display = false
     2304       .
     2305     end.
     2306   end procedure.
     2307   procedure get-context :
     2308      define output parameter p-db-num as integer          no-undo.
     2309      define output parameter p-user-id as character        no-undo.
     2310      define variable v-login               as character    no-undo.
     2311      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2312      define buffer buf_user-login  for ub.user-login .
     2313      do
     2314      on error undo, return error
     2315      :
     2316            FIND FIRST buf_sys-ctrl no-lock.
     2317            ASSIGN
     2318               v-login = USERID("ub")
     2319               p-db-num = buf_sys-ctrl.db-num
     2320            .
     2321            FIND FIRST buf_user-login
     2322                 WHERE buf_user-login.db-num = p-db-num
     2323                   AND buf_user-login.user-login = v-login
     2324                 no-lock
     2325                 no-error
     2326                 .
     2327            IF AVAILABLE buf_user-login
     2328            THEN DO:
     2329               assign
     2330                  p-user-id = buf_user-login.user-id
     2331               .
     2332            END.
     2333      end.
     2334   end procedure.
     2335       run diasize_init in this-procedure .
     2336   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2337   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2338   MAIN-BLOCK:
     2339   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2340      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2341   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2342     run mainmenu_getcntxt in parparentproc
     2343       (output v-cntxt-db-num
     2344       ,output v-cntxt-userid
     2345       ,output v-cntxt-level
     2346       ,output v-cntxt-host-code-obj
     2347       ,output v-cntxt-obj-type
     2348       ,output v-cntxt-obj-code
     2349       ,output v-cntxt-db-num-obj
     2350       ,output v-cntxt-is-admin
     2351       ) .
     2352     run Myenable in this-procedure .
     2353     v-rid-list = p-rid-list.
     2354     WAIT-FOR GO OF FRAME Dialog-Frame.
     2355   END.
     2356   RUN disable_UI.
     2357   PROCEDURE disable_UI :
     2358     HIDE FRAME Dialog-Frame.
     2359   END PROCEDURE.
     2360   PROCEDURE enable_UI :
     2361     DISPLAY mark-num
     2362         WITH FRAME Dialog-Frame.
     2363     ENABLE b-quit b-mark b-sel b-chg b-link B-Help br-rp-rule-param mark-num
     2364         WITH FRAME Dialog-Frame.
     2365     VIEW FRAME Dialog-Frame.
     2366     RUN openbr IN THIS-PROCEDURE.
     2367   END PROCEDURE.
     2368   PROCEDURE MyEnable :
     2369   ASSIGN
     2370   b-link:MENU-MOUSE IN FRAME Dialog-Frame = 1
     2371   .
     2372   ENABLE
     2373   b-quit
     2374   b-chg when (lookup("b-chg", bttns) > 0 and v-cntxt-db-num = 0)
     2375   B-Help
     2376   b-mark when lookup("b-mark", bttns) > 0
     2377   b-sel when lookup("b-sel", bttns) > 0
     2378   b-link
     2379   br-rp-rule-param
     2380   WITH FRAME Dialog-Frame.
     2381   VIEW FRAME Dialog-Frame.
     2382   run Openbr in this-procedure .
     2383   END PROCEDURE.
     2384   PROCEDURE Openbr :
     2385   CASE p-list-mode:
     2386      when 'все':U then do:
     2387         frame Dialog-Frame :title = "Все профайлы".
     2388         OPEN QUERY br-rp-rule-param FOR EACH X_rp-rule-param NO-LOCK INDEXED-REPOSITION.
     2389      end.
     2390      when "profile-id" THEN do:
     2391         frame Dialog-Frame :title = substitute("Профайл &1", p-profile-id).
     2392         OPEN QUERY br-rp-rule-param
     2393         FOR EACH X_rp-rule-param NO-LOCK where
     2394                  X_rp-rule-param.profile_id = p-profile-id
     2395         by X_rp-rule-param.profile_id
     2396        INDEXED-REPOSITION
     2397         .
     2398      end.
     2399      when "rule-id" THEN do:
     2400         frame Dialog-Frame :title = substitute("Профайл &1 Кодекс &2 Набор правил &3 Порядок вызова &4 Правило &5"
     2401                                                 , p-profile-id
     2402                                                 , p-codex-id
     2403                                                 ,p-ruleset-id
     2404                                                 ,p-rp-order-id
     2405                                                 ,p-rule-id
     2406                                                 ).
     2407         OPEN QUERY br-rp-rule-param
     2408         FOR EACH X_rp-rule-param NO-LOCK where
     2409                  X_rp-rule-param.profile_id = p-profile-id
     2410              and X_rp-rule-param.codex_id = p-codex-id
     2411              and X_rp-rule-param.ruleset_id = p-ruleset-id
     2412              and X_rp-rule-param.rp_order_id = p-rp-order-id
     2413              and X_rp-rule-param.rule_id = p-rule-id
     2414         by X_rp-rule-param.profile_id
     2415        INDEXED-REPOSITION
     2416         .
     2417      end.
     2418   end case.
     2419   END PROCEDURE.
     2420   PROCEDURE proc-b-chg :
     2421   define variable v-rid-list as character no-undo .
     2422   define variable v-uniq-key-rec as character no-undo .
     2423   define buffer buf_ruledict for ub.ruledict.
     2424   define buffer buf_ruledict-param for ub.ruledict-param.
     2425   define buffer buf_rule-profile for ub.rule-profile.
     2426   define buffer buf_rp-rule-param for ub.rp-rule-param.
     2427   define buffer buf2_rp-rule-param for ub.rp-rule-param.
     2428   if not available X_rp-rule-param then return no-apply.
     2429   find first buf_rp-rule-param where
     2430         recid(buf_rp-rule-param) = recid(X_rp-rule-param).
     2431   find first buf_rule-profile where
     2432         buf_rule-profile.profile_id = X_rp-rule-param.profile_id.
     2433   run gen-key-rec in this-procedure ( input 'rule-profile':U
     2434                                     ,input buffer buf_rule-profile:handle
     2435                                     ,output v-uniq-key-rec).
     2436   find first buf_ruledict where
     2437         buf_ruledict.entry-type = 'rule-profile':U
     2438     and buf_ruledict.uniq-key-rec = v-uniq-key-rec.
     2439   run rul/ruledict-param-s.w ( INPUT parparentproc
     2440                           ,input this-procedure:handle
     2441                           ,INPUT "b-sel"
     2442                           ,INPUT "entry-id"
     2443                           ,INPUT buf_ruledict.entry-id
     2444                           ,input 'rule-profile':U
     2445                           ,INPUT-OUTPUT v-rid-list) NO-ERROR.
     2446   IF ERROR-STATUS:ERROR
     2447   or v-rid-list = '':U
     2448   THEN DO:
     2449   UNDO, RETURN no-apply.
     2450   END.
     2451   find first buf_ruledict-param no-lock where
     2452          recid( buf_ruledict-param) = integer(v-rid-list) no-error.
     2453   if available buf_ruledict-param then do transaction:
     2454    create for-copy-rp-rule-param .
     2455    buffer-copy buf_rp-rule-param
     2456    except rp-param-name
     2457    to for-copy-rp-rule-param
     2458    assign
     2459    for-copy-rp-rule-param.rp-param-name = buf_ruledict-param.param-name.
     2460    delete buf_rp-rule-param.
     2461    create buf2_rp-rule-param.
     2462    buffer-copy for-copy-rp-rule-param to buf2_rp-rule-param.
     2463    delete for-copy-rp-rule-param.
     2464    release buf2_rp-rule-param.
     2465   end.
     2466   br-rp-rule-param:refresh() in frame Dialog-Frame .
     2467   END PROCEDURE.
     2468   PROCEDURE proc-b-link :
     2469   DEFINE INPUT PARAMETER p-option AS CHARACTER NO-UNDO.
     2470   DEFINE variable v-rid-list AS CHARACTER NO-undo.
     2471   DEFINE variable v-rec AS recid NO-undo.
     2472   DEFINE variable v-uniq-key-rec AS CHARACTER NO-undo.
     2473   define buffer buf_rule-by-call for ub.rule-by-call.
     2474   define buffer buf_ruledict for ub.ruledict.
     2475   define buffer buf_rule-call-param for ub.rule-call-param.
     2476   CASE p-option:
     2477     WHEN 'rule':U THEN DO:
     2478       run rul/rule-i.w ( INPUT parparentproc
     2479                                 ,INPUT 'ПРОСМОТР':U
     2480                                 ,INPUT X_rp-rule-param.rule_id
     2481                                 ,INPUT-OUTPUT v-rec) NO-ERROR.
     2482     END.
     2483     WHEN 'rule-profile':U THEN DO:
     2484       run rul/rule-profile-i.w ( INPUT parparentproc
     2485                               ,INPUT 'ПРОСМОТР':U
     2486                               ,INPUT X_rp-rule-param.profile_id
     2487                               ,INPUT-OUTPUT v-rec
     2488                               ) NO-ERROR.
     2489     END.
     2490      WHEN 'rule-call-param':U THEN DO:
     2491       for each tt0-rule-call-param:
     2492         delete tt0-rule-call-param.
     2493       end.
     2494       FOR each buf_rule-by-call no-lock where
     2495               buf_rule-by-call.profile_id = X_rp-rule-param.profile_id,
     2496              each buf_rule-call-param no-lock where
     2497                 buf_Rule-call-param.call#_id = buf_rule-by-call.call#_id
     2498             and buf_Rule-call-param.codex_id = buf_rule-by-call.codex_id
     2499             and buf_Rule-call-param.ruleset_id = buf_rule-by-call.ruleset_id
     2500             and buf_Rule-call-param.order_id = buf_rule-by-call.order_id:
     2501           create tt0-rule-call-param.
     2502           buffer-copy buf_rule-call-param to tt0-rule-call-param.
     2503       end.
     2504       run ref/rulercps.w ( INPUT parparentproc
     2505                           ,input this-procedure:handle
     2506                           ,INPUT "":U
     2507                           ,input 'ПРОСМОТР':U
     2508                           ,input 'rp-rule-param':U
     2509                           ,input X_rp-rule-param.profile_id
     2510                           ,input ?
     2511                           ,input '':U
     2512                           ,input 0
     2513                           ,input 0
     2514                           ,input ?
     2515                           ,input 0
     2516                           ,input substitute("Параметры вызова профайла &1"
     2517                                             , X_rp-rule-param.profile_id
     2518                                             )
     2519                           ,input-output table tt0-rule-call-param ) no-error.
     2520     END.
     2521   END CASE.
     2522   END PROCEDURE.
