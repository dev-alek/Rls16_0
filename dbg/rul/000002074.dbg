        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-parent-handle as handle no-undo .
        4   define input parameter p-log-handle  as handle no-undo .
        5   define input parameter p-cont-handle  as handle no-undo .
        6   define input parameter p-codex-id as integer no-undo .
        7   define input parameter p-ruleset-id as integer no-undo .
        8   define input parameter p-call-id as character no-undo .
        9   define input parameter p-order-id as integer no-undo .
       10   define input parameter p-rule-id as integer no-undo .
       11   define input parameter p-profile-id as integer no-undo .
       12   define input parameter p-is-dynamic as logical no-undo .
       13   define input parameter p-doc-type as character no-undo .
       14   define input parameter p-host-code like ub.sysconf.host-code no-undo .
       15   define input parameter p-obj-type like ub.clients.obj-type no-undo .
       16   define input parameter p-obj-code like ub.clients.obj-code no-undo .
       17   define input parameter p-doc-code as character no-undo .
       18   define input parameter p-process-file-name as character no-undo .
       19   define input parameter p-save       as integer no-undo .
       20   define input parameter v-curr-r-b   as character no-undo .
       21   define input parameter p-cmd-proc-handle as handle no-undo .
       22   define input parameter p-cmd-code  as integer no-undo .
       23   define variable vss-revision    as character no-undo init "$Revision$":U .
       24   define variable vss-author      as character no-undo init "$Author$":U .
       25   define variable vss-date        as character no-undo init "$Date$":U .
       26   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       27   define variable vss-archive     as character no-undo init "$Archive$":U .
       28   define variable vss-description as character no-undo init "Библиотека процедур для работы с кодексом 18 набор правил 4".
       29   procedure vss-get-info :
       30     define output parameter p-vss-revision    like vss-revision    no-undo .
       31     define output parameter p-vss-author      like vss-author      no-undo .
       32     define output parameter p-vss-date        like vss-date        no-undo .
       33     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       34     define output parameter p-vss-archive     like vss-archive     no-undo .
       35     define output parameter p-vss-description like vss-description no-undo .
       36     assign
       37       p-vss-revision    = vss-revision
       38       p-vss-author      = vss-author
       39       p-vss-date        = vss-date
       40       p-vss-workfile    = vss-workfile
       41       p-vss-archive     = vss-archive
       42       p-vss-description = vss-description
       43     .
       44   end procedure.
       45   procedure vss-get-parameters :
       46     define output parameter p-vss-parameters as character no-undo .
       47   end procedure.
       48   define new global shared variable g#vssrevis-logger as handle    no-undo .
       49   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       50   define variable v-vssrevis-logger                   as handle    no-undo .
       51   procedure vss-logevent :
       52     define input  parameter p-extra-paramters as character no-undo .
       53     define variable v-vssrevis-parameters as character no-undo .
       54     do
       55     on error undo, return error return-value
       56     :
       57       if  valid-handle(v-vssrevis-logger)
       58       and v-vssrevis-logger :get-signature("logevent") <> ""
       59       then do:
       60         run vss-get-parameters in this-procedure
       61           (output v-vssrevis-parameters
       62           ).
       63         run logevent in v-vssrevis-logger
       64           (input vss-workfile
       65           ,input vss-revision
       66           ,input v-vssrevis-parameters
       67           ,input p-extra-paramters
       68           ).
       69       end.
       70     end.
       71   end procedure.
       72   assign
       73     v-vssrevis-logger = g#vssrevis-logger
       74   .
       75   if  valid-handle(v-vssrevis-logger)
       76   and v-vssrevis-logger :get-signature("logevent") <> ""
       77   then do:
       78     assign
       79       v-vssrevis-logevent = true
       80     .
       81     run vss-logevent in this-procedure (input vss-description) .
       82   end.
       83   define new global shared variable g#language as character no-undo .
       84   if g#language <> '' and g#language <> 'rus':U then do:
       85     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       86   end.
       87   define new global shared variable g#library  as handle no-undo .
       88   define new global shared variable g#library2 as handle no-undo .
       89   define   shared variable g#auto as logical no-undo.
       90   define   shared variable g#news as logical no-undo.
       91   define   shared variable g#oxml as logical no-undo.
       92   define   shared variable g#esys as logical no-undo.
       93   define   shared variable g#news-source-db as integer no-undo.
       94   define   shared variable g#esys-source-esys as integer no-undo.
       95   define   shared variable g#db-num as integer   no-undo .
       96   define   shared variable g#userid as character no-undo .
       97   define   shared variable g#passwd as character no-undo .
       98   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       99   define  variable garbcoll_ii as integer no-undo .
      100   define  temp-table temp-gc no-undo
      101   field ii as integer
      102   field obj-r as handle
      103   field cn as character
      104   index pi is unique primary
      105   ii
      106   index icn
      107   cn.
      108   procedure garbcoll_create-gc-entry :
      109   define input parameter p-cn as character no-undo .
      110   define input parameter p-obj-r as handle no-undo .
      111     do
      112     on error undo, return error
      113     :
      114       create temp-gc.
      115       assign
      116       temp-gc.ii = garbcoll_ii
      117       garbcoll_ii = garbcoll_ii + 1
      118       temp-gc.cn = p-cn
      119       temp-gc.obj-r = p-obj-r
      120       .
      121     end.
      122   end procedure.
      123   procedure garbcoll_clear :
      124     do
      125     on error undo, return error
      126     :
      127       for each temp-gc:
      128         delete object temp-gc.obj-r.
      129         delete temp-gc.
      130       end.
      131     end.
      132   end procedure.
      133   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      134   procedure cur-time :
      135      define output parameter p-today as date      no-undo .
      136      define output parameter p-time  as integer   no-undo .
      137     do
      138     on error undo, return error
      139     :
      140       define variable v-date1 as date      no-undo .
      141       define variable v-date2 as date      no-undo .
      142       define variable v-time  as integer   no-undo .
      143       assign
      144         v-date1 = today
      145         v-time  = time
      146         v-date2 = today
      147       .
      148       if v-date1 <> v-date2
      149       then do:
      150         assign
      151           v-date1 = today
      152           v-time  = v-time
      153         .
      154       end.
      155       assign
      156         p-today = v-date1
      157         p-time  = v-time
      158       .
      159     end.
      160   end.
      161   function cur-time-date returns character
      162   :
      163     return string(today, '99/99/9999':U) .
      164   end.
      165   function cur-time-mjd returns decimal
      166   :
      167     define variable v-date as date      no-undo .
      168     define variable v-time as integer   no-undo .
      169     run cur-time in this-procedure
      170       (output v-date
      171       ,output v-time
      172       ) .
      173     return integer(v-date) - 2400002 + (v-time / 86400) .
      174   end.
      175   function cur-time-get-ending-index returns integer
      176   (input p-number as integer
      177   )
      178   :
      179     if p-number < 0
      180     or p-number = ?
      181     then do:
      182       return 1 .
      183     end.
      184     define variable v-rest as integer   no-undo .
      185     assign
      186       p-number = p-number modulo 100
      187     .
      188     if p-number < 20
      189     then do:
      190       assign
      191         v-rest = p-number
      192       .
      193     end.
      194     else do:
      195       assign
      196         v-rest = p-number modulo 10
      197       .
      198     end.
      199     case v-rest :
      200       when 1
      201       then do:
      202         return 2 .
      203       end.
      204       when 2 or
      205       when 3 or
      206       when 4
      207       then do:
      208         return 3 .
      209       end.
      210       otherwise do:
      211         return 1 .
      212       end.
      213     end case .
      214   end.
      215   procedure cur-time-mjd-to-date :
      216      define input  parameter i-mjd-diff as decimal no-undo.
      217      define output parameter o-Date     as date    no-undo.
      218      define output parameter o-Time     as integer no-undo.
      219      define variable v-day-number as integer   no-undo .
      220      if    i-mjd-diff < 0
      221         or i-mjd-diff = ?
      222      then do:
      223         return "?" .
      224      end.
      225      assign
      226         v-day-number = truncate(i-mjd-diff,0).
      227         o-Date = date(v-day-number + 2400002).
      228         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      229     .
      230   end.
      231   function cur-time-mjd-to-string returns character
      232   (input p-mjd-diff as decimal
      233   )
      234   :
      235     define variable v-day-number as integer   no-undo .
      236     define variable v-seconds    as integer   no-undo .
      237     define variable v-hour       as integer   no-undo .
      238     define variable v-min        as integer   no-undo .
      239     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      240     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      241     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      242     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      243     if p-mjd-diff < 0
      244     or p-mjd-diff = ?
      245     then do:
      246       return "?" .
      247     end.
      248     assign
      249       v-day-number = integer(truncate(p-mjd-diff,0))
      250       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      251     .
      252     if v-seconds > 86400
      253     then do:
      254       assign
      255         v-seconds = 86400 - 1
      256       .
      257     end.
      258     if v-seconds < 0
      259     then do:
      260       assign
      261         v-seconds = 0
      262       .
      263     end.
      264     assign
      265       v-hour = truncate(v-seconds / 3600, 0)
      266     .
      267     assign
      268       v-seconds = v-seconds modulo 3600
      269     .
      270     assign
      271       v-min = truncate(v-seconds / 60, 0)
      272     .
      273     assign
      274       v-seconds = v-seconds modulo 60
      275     .
      276     return
      277         (if v-day-number <> 0
      278           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      279           else ""
      280         )
      281       + (if v-day-number <> 0 or v-hour <> 0
      282           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      283           else ""
      284         )
      285       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      286           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      287           else ""
      288         )
      289       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      290       .
      291   end.
      292   function cur-time-string returns character
      293   :
      294     define variable v-date as date      no-undo .
      295     define variable v-time as integer   no-undo .
      296     run cur-time in this-procedure
      297       (output v-date
      298       ,output v-time
      299       ) .
      300     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      301   end.
      302   function cur-time-string-sec returns character
      303   :
      304     define variable v-date as date      no-undo .
      305     define variable v-time as integer   no-undo .
      306     run cur-time in this-procedure
      307       (output v-date
      308       ,output v-time
      309       ) .
      310     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      311   end.
      312   function cur-time-custom  returns character
      313   (input p-prefix as character
      314   ,input p-date-format as character
      315   ,input p-delimiter as character
      316   ,input p-time-format as character
      317   ,input p-suffix as character
      318   )
      319   :
      320     define variable v-date as date      no-undo .
      321     define variable v-time as integer   no-undo .
      322     run cur-time in this-procedure
      323       (output v-date
      324       ,output v-time
      325       ) .
      326     return
      327       p-prefix
      328       + string(v-date, p-date-format)
      329       + p-delimiter
      330       + string(v-time, p-time-format)
      331       + p-suffix
      332       .
      333   end.
      334   function cur-time-print  returns character
      335   :
      336     define variable v-date as date      no-undo .
      337     define variable v-time as integer   no-undo .
      338     run cur-time in this-procedure
      339       (output v-date
      340       ,output v-time
      341       ) .
      342     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      343   end.
      344   function cur-time-datetime returns datetime
      345   :
      346     define variable v-char as character no-undo .
      347     define variable v-datetime as datetime no-undo .
      348     v-char = cur-time-string().
      349     v-datetime = datetime(v-char).
      350     return  v-datetime.
      351   end.
      352   function cur-time-string-msec returns character
      353   :
      354     define variable v-date as datetime  no-undo .
      355     v-date = now.
      356     return string(v-date) .
      357   end.
      358   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      359   define shared temp-table ord-list no-undo
      360   field host-code  like ub.ord-doc.host-code
      361   field cli-type   like ub.ord-doc.cli-type
      362   field cli-code   like ub.ord-doc.cli-code
      363   field doc-date   like ub.ord-doc.doc-date
      364   field doc-code   like ub.ord-doc.doc-code
      365   field obj-type   like ub.ord-doc.obj-type
      366   field obj-code   like ub.ord-doc.obj-code
      367   field fact-num   like ub.ord-doc.fact-num
      368   field fact-date  like ub.ord-doc.fact-date
      369   field shift-date like ub.ord-doc.shift-date
      370   field shift-num  like ub.ord-doc.shift-num
      371   field shift-name like ub.ord-doc.shift-name
      372   field ord-int1   like ub.ord-doc.ord-int1
      373   field cli-out-doc like ub.ord-doc.cli-out-doc
      374   field ship-date  like ub.ord-doc.ship-date
      375   field ship-time  like ub.ord-doc.ship-time
      376   field status_    as character
      377   field trn-doc    as character
      378   field fact-order as decimal
      379   field is-trn-doc as logical
      380   field doc-type   like ub.ord-doc.doc-type
      381   field sel-order  as integer
      382   field znak       as integer
      383   field to-del     as logical
      384   field ps         as character
      385   field dm         as integer
      386   field charkey_one as character
      387   index xpk is primary unique doc-code doc-type trn-doc
      388   index xfact fact-num
      389   index xfact-date fact-date
      390   index sel-order sel-order
      391   index znak-order znak sel-order
      392   .
      393   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      394   define new global shared variable g#lib-nws as handle no-undo .
      395   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      396   def var vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      397   procedure gen-key-rec :
      398     define input  parameter p-tbl-name    as character no-undo.
      399     define input  parameter p-bh_tbl-name as handle    no-undo.
      400     define output parameter p-key-rec     as character no-undo.
      401     do
      402     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      403     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      404     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      405     :
      406       define variable fh               as handle    no-undo .
      407       define variable v-ok             as logical   no-undo .
      408       define variable v-inform         as character no-undo .
      409       define variable v-ind            as integer   no-undo .
      410       define variable v-idx-field-qnty as integer   no-undo .
      411       if p-tbl-name = ?
      412         or p-tbl-name = "":U
      413       then do:
      414         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info5 ).
      415       end.
      416       if not p-bh_tbl-name:available then do:
      417         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info5, p-tbl-name ).
      418       end.
      419       assign
      420         p-key-rec = p-tbl-name
      421         v-inform  = p-bh_tbl-name:index-information(1)
      422         v-ind     = 2
      423       .
      424       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      425       on error undo, return error
      426       :
      427         assign
      428           v-inform = p-bh_tbl-name:index-information( v-ind )
      429           v-ind    = v-ind + 1
      430         .
      431       end.
      432       if v-inform = ?
      433         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      434         or entry( 3, v-inform, ",":U ) <> "1":U
      435       then do:
      436         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, p-tbl-name ).
      437       end.
      438       else do:
      439         assign
      440           v-idx-field-qnty = num-entries( v-inform ) - 4
      441         .
      442         if v-idx-field-qnty < 2 then do:
      443           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, p-tbl-name ).
      444         end.
      445         do v-ind = 1 to v-idx-field-qnty by 2
      446         on error undo, return error
      447         :
      448           assign
      449             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      450             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      451           .
      452         end.
      453       end.
      454       if p-key-rec = ? then do:
      455         assign
      456           p-key-rec = "":U
      457         .
      458         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info5, p-tbl-name ).
      459       end.
      460     end.
      461     return.
      462   end procedure.
      463   procedure gen-where-keyr-tab :
      464     define input  parameter i-tableSerach as character no-undo.
      465     define input  parameter i-tablekey   as character  no-undo.
      466     define input  parameter p-key-rec    as character  no-undo.
      467     define input  parameter p-key-handle as handle     no-undo .
      468     define input  parameter p-db-name    as character  no-undo .
      469     define input  parameter p-tt-handle  as handle     no-undo .
      470     define output parameter o-Where      as character  no-undo.
      471     do
      472     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      473     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      474     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      475     :
      476       define variable v-full-tbl-name  as character no-undo .
      477       define variable bh_tbl-name      as handle    no-undo .
      478       define variable fh_key           as handle    no-undo .
      479       define variable fh_search        as handle    no-undo .
      480       define variable v-field-num      as integer   no-undo .
      481       define variable v-count-fld      as integer   no-undo .
      482       define variable v-inform         as character no-undo .
      483       define variable v-ind            as integer   no-undo .
      484       define variable v-idx-field-qnty as integer   no-undo .
      485       define variable v-field-name     as character no-undo .
      486       define variable v-field-val      as character no-undo .
      487       define variable v-word-link      as character no-undo .
      488       define variable vTable           as character no-undo.
      489       define variable bh_tbl-key       as handle    no-undo .
      490       assign
      491         p-key-rec = trim( p-key-rec )
      492       .
      493       if p-key-handle <> ? then do:
      494         if not valid-handle(p-key-handle)
      495            or p-key-handle:type <> "buffer"
      496         then do:
      497           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info5 ).
      498         end.
      499         if num-entries( p-key-rec, chr(3) ) > 1
      500           or p-key-rec = ?
      501           or p-key-rec = "":U
      502         then do:
      503           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info5, p-key-rec ).
      504         end.
      505       end.
      506       else do:
      507         if p-key-rec = ?
      508           or p-key-rec = "":U
      509         then do:
      510           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info5 ).
      511         end.
      512       end.
      513       assign
      514         vTable = entry( 1 , p-key-rec, chr(3) )
      515       .
      516       if p-tt-handle <> ?
      517         and ( not valid-handle(p-tt-handle)
      518               or p-tt-handle:type <> "buffer"
      519             )
      520       then do:
      521         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info5, vTable, chr(10) ).
      522       end.
      523       if p-tt-handle = ? then do:
      524         assign
      525           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      526         .
      527         create buffer bh_tbl-name for table v-full-tbl-name .
      528       end.
      529       else do:
      530         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      531       end.
      532       assign
      533         v-inform = bh_tbl-name:index-information(1)
      534         v-ind    = 2
      535       .
      536       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      537       on error undo, return error
      538       :
      539         assign
      540           v-inform = bh_tbl-name:index-information( v-ind )
      541           v-ind    = v-ind + 1
      542         .
      543       end.
      544       if v-inform = ?
      545         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      546         or entry( 3, v-inform, ",":U ) <> "1":U
      547       then do:
      548         delete object bh_tbl-name no-error.
      549         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info5, vTable ).
      550       end.
      551       assign
      552         v-idx-field-qnty = num-entries( v-inform ) - 4
      553       .
      554       if v-idx-field-qnty < 2 then do:
      555         delete object bh_tbl-name no-error.
      556         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, vTable ).
      557       end.
      558       assign
      559         o-where     = "where":U
      560         v-word-link = "":U
      561         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      562         v-count-fld = 0
      563       .
      564       if i-tablekey ne "" and i-tablekey ne ?
      565       then do:
      566         assign
      567           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      568         .
      569         create buffer bh_tbl-key for table v-full-tbl-name .
      570       end.
      571       if i-tableSerach ne "" and i-tableSerach ne ?
      572       then do:
      573         delete object bh_tbl-name no-error.
      574         assign
      575           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      576         .
      577         create buffer bh_tbl-name for table v-full-tbl-name .
      578       end.
      579       block_where:
      580       do v-ind = 1 to v-idx-field-qnty by 2
      581       on error undo, return error
      582       :
      583         assign
      584           v-count-fld = v-count-fld + 1
      585         .
      586         if p-key-handle = ?
      587           and v-count-fld > v-field-num
      588         then do:
      589           leave block_where.
      590         end.
      591         define variable VfieldKeyTable as handle no-undo.
      592         assign
      593           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      594           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      595         .
      596         if     bh_tbl-key ne ?
      597         then do:
      598            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      599            if VfieldKeyTable eq ?
      600            then next block_where.
      601         end.
      602         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      603         then
      604            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      605         else
      606            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      607         if p-key-handle = ? then do:
      608           assign
      609             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      610           .
      611         end.
      612         else do:
      613           assign
      614             fh_key = p-key-handle:buffer-field( v-field-name )
      615           .
      616           if fh_key = ?
      617             or not valid-handle( fh_key )
      618           then do:
      619             delete object bh_tbl-name.
      620             if     bh_tbl-key ne ?
      621             then
      622                delete object bh_tbl-key.
      623             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info5, p-key-handle:name, v-field-name ).
      624           end.
      625           assign
      626             v-field-val = fh_key:buffer-value
      627           .
      628         end.
      629         if fh_search:data-type ="character":U then do:
      630           assign
      631             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      632             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      633             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      634             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      635             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      636             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      637             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      638             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      639             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      640             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      641             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      642             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      643             v-field-val = substitute( '"&1"', v-field-val )
      644           .
      645         end.
      646         assign
      647           o-where = substitute( "&1 &2", o-where, v-field-val )
      648         .
      649         if v-word-link = "":U then do:
      650           assign
      651             v-word-link = "and":U
      652           .
      653         end.
      654       end.
      655       delete object bh_tbl-name.
      656       if     bh_tbl-key ne ?
      657       then
      658          delete object bh_tbl-key.
      659       if p-key-handle = ?
      660         and v-count-fld <> v-field-num
      661       then do:
      662         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info5, vTable ).
      663       end.
      664     end.
      665   end procedure.
      666   procedure gen-hn-keyr-tab :
      667     define input  parameter i-tableSerach as character no-undo.
      668     define input  parameter i-tablekey   as character no-undo.
      669     define input  parameter p-key-rec    as character no-undo.
      670     define input  parameter p-key-handle as handle    no-undo .
      671     define input  parameter p-db-name    as character no-undo .
      672     define input  parameter p-tt-handle  as handle    no-undo .
      673     define input  parameter p-stts-lock  as integer   no-undo .
      674     define output parameter o-hn         as handle    no-undo.
      675     define variable v-full-tbl-name as character no-undo.
      676     define variable v-where         as character no-undo.
      677     define variable bh_tbl-name     as handle    no-undo.
      678     define variable vTable          as character no-undo.
      679     do
      680     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      681     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      682     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      683         run gen-where-keyr-tab(i-tableSerach,
      684                                i-tablekey,
      685                                p-key-rec,
      686                                p-key-handle,
      687                                p-db-name,
      688                                p-tt-handle,
      689                                output v-where).
      690         if i-tableSerach ne "" and i-tableSerach ne ?
      691         then do:
      692            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      693            create buffer bh_tbl-name for table v-full-tbl-name .
      694         end.
      695         else do:
      696            if p-tt-handle = ? then do:
      697               assign
      698                  vTable = entry( 1 , p-key-rec, chr(3) )
      699               .
      700               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      701               create buffer bh_tbl-name for table v-full-tbl-name .
      702            end.
      703            else do:
      704               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      705            end.
      706         end.
      707         if p-tt-handle = ? then do:
      708            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      709         end.
      710         else do:
      711            bh_tbl-name:find-first( v-where ) no-error .
      712         end.
      713         o-hn = bh_tbl-name.
      714      end.
      715   end procedure.
      716   procedure gen-hn-keyr :
      717     define input  parameter p-key-rec    as character no-undo.
      718     define input  parameter p-key-handle as handle    no-undo .
      719     define input  parameter p-db-name    as character no-undo .
      720     define input  parameter p-tt-handle  as handle    no-undo .
      721     define input  parameter p-stts-lock  as integer   no-undo .
      722     define output parameter o-hn         as handle    no-undo.
      723     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      724   end.
      725   procedure gen-row-keyr :
      726     define input  parameter p-key-rec    as character no-undo.
      727     define input  parameter p-key-handle as handle    no-undo .
      728     define input  parameter p-db-name    as character no-undo .
      729     define input  parameter p-tt-handle  as handle    no-undo .
      730     define input  parameter p-stts-lock  as integer   no-undo .
      731     define output parameter p-tbl-row    as rowid     no-undo.
      732     define output parameter p-tbl-name   as character no-undo.
      733     define variable vHn as handle no-undo.
      734       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      735       p-tbl-row = if vHn:available then vHn:rowid else ?.
      736       p-tbl-name =  vHn:table.
      737       delete object vHn no-error.
      738     if p-tbl-row = ? then do:
      739       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info5, p-tbl-name, p-key-rec ).
      740     end.
      741     else do:
      742       return.
      743     end.
      744   end procedure.
      745   procedure gen-key-fv :
      746     define input  parameter p-key-rec    as character no-undo .
      747     define output parameter p-field-list as character no-undo .
      748     define output parameter p-value-list as character no-undo.
      749     do
      750     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      751     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      752     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      753     :
      754       define variable v-full-tbl-name  as character no-undo .
      755       define variable bh_tbl-name      as handle    no-undo .
      756       define variable v-tbl-name       as character no-undo .
      757       define variable v-field-num      as integer   no-undo .
      758       define variable v-count-fld      as integer   no-undo .
      759       define variable v-inform         as character no-undo .
      760       define variable v-ind            as integer   no-undo .
      761       define variable v-idx-field-qnty as integer   no-undo .
      762       define variable v-delim-key      as character no-undo .
      763       if p-key-rec = ?
      764         or p-key-rec = "":U
      765       then do:
      766         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info5 ).
      767       end.
      768       assign
      769         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      770         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      771       .
      772       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      773       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info5 ).
      774       assign
      775         v-inform = bh_tbl-name:index-information(1)
      776         v-ind    = 2
      777       .
      778       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      779       on error undo, return error
      780       :
      781         assign
      782           v-inform = bh_tbl-name:index-information( v-ind )
      783           v-ind    = v-ind + 1
      784         .
      785       end.
      786       if v-inform = ?
      787         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      788         or entry( 3, v-inform, ",":U ) <> "1":U
      789       then do:
      790         delete object bh_tbl-name no-error.
      791         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, v-tbl-name ).
      792       end.
      793       assign
      794         v-idx-field-qnty = num-entries( v-inform ) - 4
      795       .
      796       if v-idx-field-qnty < 2 then do:
      797         delete object bh_tbl-name no-error.
      798         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, v-tbl-name ).
      799       end.
      800       assign
      801         p-field-list = "":U
      802         p-value-list = "":U
      803         v-delim-key  = "":U
      804         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      805         v-count-fld  = 0
      806       .
      807       block_where:
      808       do v-ind = 1 to v-idx-field-qnty by 2
      809       on error undo, return error
      810       :
      811         assign
      812           v-count-fld = v-count-fld + 1
      813         .
      814         if v-count-fld > v-field-num then do:
      815           leave block_where.
      816         end.
      817         assign
      818           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      819           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      820         .
      821         if v-ind = 1 then do:
      822           assign
      823             v-delim-key = chr(3)
      824           .
      825         end.
      826       end.
      827       delete object bh_tbl-name.
      828       if v-count-fld <> v-field-num then do:
      829         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info5, v-tbl-name ).
      830       end.
      831     end.
      832   end procedure.
      833   procedure gen-key-field :
      834     define input  parameter p-table      as character no-undo .
      835     define output parameter p-field-list as character no-undo .
      836     do
      837     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      838     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      839     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      840     :
      841       define variable v-full-tbl-name  as character no-undo .
      842       define variable bh_tbl-name      as handle    no-undo .
      843       define variable v-tbl-name       as character no-undo .
      844       define variable v-field-num      as integer   no-undo .
      845       define variable v-count-fld      as integer   no-undo .
      846       define variable v-inform         as character no-undo .
      847       define variable v-ind            as integer   no-undo .
      848       define variable v-idx-field-qnty as integer   no-undo .
      849       define variable v-delim-key      as character no-undo .
      850       if p-table = ?
      851         or p-table = "":U
      852       then do:
      853         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info5 ).
      854       end.
      855       assign
      856         v-tbl-name      = p-table
      857         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      858       .
      859       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      860       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info5 ).
      861       assign
      862         v-inform = bh_tbl-name:index-information(1)
      863         v-ind    = 2
      864       .
      865       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      866       on error undo, return error
      867       :
      868         assign
      869           v-inform = bh_tbl-name:index-information( v-ind )
      870           v-ind    = v-ind + 1
      871         .
      872       end.
      873       if v-inform = ?
      874         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      875         or entry( 3, v-inform, ",":U ) <> "1":U
      876       then do:
      877         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, v-tbl-name ).
      878       end.
      879       assign
      880         v-idx-field-qnty = num-entries( v-inform ) - 4
      881       .
      882       if v-idx-field-qnty < 2 then do:
      883         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, v-tbl-name ).
      884       end.
      885       assign
      886         p-field-list = "":U
      887         v-delim-key  = "":U
      888         v-count-fld  = 0
      889       .
      890       block_where:
      891       do v-ind = 1 to v-idx-field-qnty by 2
      892       on error undo, return error
      893       :
      894         assign
      895           v-count-fld = v-count-fld + 1
      896         .
      897         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      898         if v-ind = 1 then do:
      899           assign
      900             v-delim-key = chr(3)
      901           .
      902         end.
      903       end.
      904       delete object bh_tbl-name.
      905     end.
      906   end procedure.
      907   define SHARED temp-table temp-cmd no-undo
      908   field cmd-code as integer
      909   field db-list as character
      910   index pi is unique primary
      911   db-list
      912   index icmd
      913   cmd-code
      914   .
      915   define SHARED temp-table temp-smart-route no-undo
      916   field key-field as character
      917   field db-num as integer
      918   index pi is unique primary
      919   key-field
      920   db-num
      921   .
      922   define SHARED temp-table temp-no-route no-undo
      923   field rec-ord as integer
      924   field db-num as integer
      925   index pi is unique primary
      926   db-num
      927   rec-ord
      928   index iro
      929   rec-ord
      930   .
      931   define SHARED temp-table temp-smart-link no-undo
      932   field uniq-key-rec as character
      933   field key-field as character
      934   field rec-ord as integer
      935   field is-smart as logical
      936   index pi is unique primary
      937   key-field
      938   uniq-key-rec
      939   rec-ord
      940   index iu
      941   uniq-key-rec
      942   index iro
      943   rec-ord
      944   .
      945   define SHARED temp-table temp-nws-outline no-undo
      946   like ub.nws-outline.
      947   procedure create-smart-route :
      948   define input parameter p-key-field as character no-undo .
      949   define input parameter p-db-num as integer no-undo .
      950   define buffer buf_temp-smart-route for temp-smart-route.
      951     do
      952     on error undo, return error
      953     :
      954       find first buf_temp-smart-route where
      955                 buf_temp-smart-route.key-field = p-key-field
      956             and buf_temp-smart-route.db-num = p-db-num no-error.
      957       if not available buf_temp-smart-route then do:
      958         create buf_temp-smart-route.
      959         assign
      960         buf_temp-smart-route.key-field = p-key-field
      961         buf_temp-smart-route.db-num = p-db-num
      962         .
      963       end.
      964     end.
      965   end procedure.
      966   procedure create-smart-route-link :
      967   define input parameter p-tbl-name as character no-undo .
      968   define input parameter p-bh_tbl-name as handle no-undo .
      969   define input parameter p-key-field as character no-undo .
      970   define input parameter p-rec-ord as integer no-undo .
      971   define input parameter p-is-smart as logical no-undo .
      972   define variable v-key-rec as character no-undo .
      973   define buffer buf_temp-smart-link for temp-smart-link.
      974     do
      975     on error undo, return error
      976     :
      977       run gen-key-rec in this-procedure ( input p-tbl-name
      978                                          ,input p-bh_tbl-name
      979                                          ,output v-key-rec     ).
      980      find first buf_temp-smart-link where
      981                 buf_temp-smart-link.uniq-key-rec = v-key-rec
      982              and buf_temp-smart-link.key-field = p-key-field
      983              and buf_temp-smart-link.rec-ord = p-rec-ord
      984              no-error .
      985      if not available buf_temp-smart-link then do:
      986        create buf_temp-smart-link.
      987        assign
      988        buf_temp-smart-link.uniq-key-rec = v-key-rec
      989        buf_temp-smart-link.key-field = p-key-field
      990        buf_temp-smart-link.rec-ord = p-rec-ord
      991        buf_temp-smart-link.is-smart = p-is-smart
      992        .
      993      end.
      994     end.
      995   end procedure.
      996   procedure create-nws-outline :
      997   define input parameter p-cmd-proc-handle as handle no-undo .
      998   define input parameter p-cmd-code as integer no-undo .
      999   define input parameter p-outline-type as character no-undo .
     1000   define input parameter p-charkey_one as character no-undo .
     1001   define input parameter p-charkey_two as character no-undo .
     1002   define input parameter p-charkey_three as character no-undo .
     1003   define input parameter p-key#_one as integer no-undo .
     1004   define input parameter p-key#_two as integer no-undo .
     1005   define input parameter p-key#_three as integer no-undo .
     1006   define variable v-no-id as integer no-undo .
     1007   define variable v-rec-ord as integer no-undo .
     1008     do
     1009     on error undo, return error return-value
     1010     :
     1011       find last temp-nws-outline use-index pi no-error .
     1012       v-no-id = (if available temp-nws-outline
     1013                  then (temp-nws-outline.no-id  + 1)
     1014                  else 1).
