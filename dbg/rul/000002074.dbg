     3116   function 00180004_get-error-message returns character :
     3117   define variable v-ii as integer no-undo .
     3118   define variable v-mess as character no-undo .
     3119   DO v-ii = 1 TO ERROR-STATUS:NUM-MESSAGES:
     3120       v-mess = substitute("&1&2ош &3"
     3121                           ,v-mess
     3122                           ,chr(10)
     3123                           ,ERROR-STATUS:GET-MESSAGE(v-ii)).
     3124   END.
     3125   end function.
     3126     define variable p-xsd-file as character no-undo.
     3127   on delete of this-procedure do:
     3128     run delete-procedure in this-procedure .
     3129   end.
     3130   run load-ruleset-context in this-procedure ( input p-ruleset-id) no-error .
     3131   if error-status:error
     3132   or return-value = "return" then return.
     3133   if not this-procedure:persistent then do:
     3134     run proc-main in this-procedure  no-error .
     3135     if error-status:error then do:
     3136         run delete-procedure in this-procedure .
     3137               run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute( "&1. &2&3&4", vss-workfile, v-rv, chr(10), v-esm)).                      assign v-view-log = yes.
     3138         undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     3139     end.
     3140     run delete-procedure in this-procedure .
     3141   end.
