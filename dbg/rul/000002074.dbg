     1080   procedure library-cls_get-handle :
     1081   define input parameter p-library-name as character no-undo .
     1082   define output parameter p-library-handle as handle no-undo .
     1083     do
     1084     on error undo, return error
     1085     :
     1086       CASE p-library-name:
     1087         when "library" then do:
     1088           if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end.
     1089           p-library-handle = g#library.
     1090         end.
     1091         when "library2" then do:
     1092           if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end.
     1093           p-library-handle = g#library2.
     1094         end.
     1095       end case.
     1096     end.
     1097   end procedure.
