     2211              ub.contract-specif-attr.gds-code     = p-gds-code      and
     2212              ub.contract-specif-attr.attr-code    = 'bonus':U
     2213              no-error .
     2214      if available ub.contract-specif-attr then  v-bonus = decimal (ub.contract-specif-attr.attr-value ) .
     2215                                           else  v-bonus = 0 .
     2216   end.
     2217   END PROCEDURE.
