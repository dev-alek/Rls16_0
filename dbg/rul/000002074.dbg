     3166   define buffer buf_ord-doc-rcv for ub.ord-doc-rcv.
     3167   define buffer buf_esys-route for ub.esys-route.
     3168   define buffer buf_edi-status for ub.edi-status.
     3169   define buffer buf_clients for ub.clients.
     3170   _status:
     3171   do transaction
     3172   on error  undo _status, retry _status
     3173   on stop   undo _status, retry _status
     3174   on endkey undo _status, retry _status
     3175   :
     3176     if retry then do:
     3177           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка:&1&2&1&3&1&4", chr(10), error-status:get-message(1) , return-value, v-mess)).                      assign v-view-log = yes.
     3178       assign
     3179       v-view-log = yes.
     3180       undo _status, return error substitute("Ошибка:&1&2&1&3&1&4", chr(10), error-status:get-message(1) , return-value, v-mess).
     3181     end.
     3182     else do:
     3183       run write-log  in p-log-handle (
     3184                                       input 0
     3185                                     , "&DLine").
     3186             run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute(".............Импорт подтверждений из ВС")).                      assign v-view-log = yes.
     3187       find first status_-t.
     3188       num-rec = num-rec + 1.
     3189       if status_-t.status_ = 0 then do:
     3190         case status_-t.messageclass:
     3191           when "ORDERS" then do:
     3192               for each buf_edi-status no-lock where
     3193                       buf_edi-status.tbl-name = 'ord-doc':U
     3194                   and buf_edi-status.doc-code = status_-t.customericid
     3195               by buf_edi-status.tbl-name
     3196               by buf_edi-status.doc-code
     3197               by buf_edi-status.date-status
     3198               by buf_edi-status.time-status
     3199               :
     3200                 if buf_edi-status.state = '1':U then do:
     3201                   v-dump-ord-int64 = int64(cr-edist_get-mess-key-value(buf_edi-status.mess-id, 'route':U)).
     3202                   leave.
     3203                 end.
     3204               end.
     3205           end.
     3206           when "ORDRSP" then do:
     3207               for each buf_edi-status no-lock where
     3208                       buf_edi-status.tbl-name = 'ord-doc':U
     3209                   and buf_edi-status.doc-code = status_-t.customericid
     3210               by buf_edi-status.tbl-name
     3211               by buf_edi-status.doc-code
     3212               by buf_edi-status.date-status
     3213               by buf_edi-status.time-status
     3214               :
     3215                 if buf_edi-status.state = '4':U
     3216                 or buf_edi-status.state = '5':U
     3217                 then do:
     3218                   v-dump-ord-int64 = int64(cr-edist_get-mess-key-value(buf_edi-status.mess-id, 'route':U)).
     3219                   leave.
     3220                 end.
     3221               end.
     3222           end.
     3223           when "RECADV" then do:
     3224               for each buf_edi-status no-lock where
     3225                       buf_edi-status.tbl-name = 'trn-doc':U
     3226                   and buf_edi-status.doc-code = status_-t.customericid
     3227               by buf_edi-status.tbl-name
     3228               by buf_edi-status.doc-code
     3229               by buf_edi-status.date-status
     3230               by buf_edi-status.time-status
     3231               :
     3232                 if buf_edi-status.state = '9':U then do:
     3233                   v-dump-ord-int64 = int64(cr-edist_get-mess-key-value(buf_edi-status.mess-id, 'route':U)).
     3234                   leave.
     3235                 end.
     3236               end.
     3237           end.
     3238           otherwise do:
     3239             v-mess = substitute("Получено непредусмотренное подтверждение на документ типа &1", status_-t.messageclass).
     3240             undo _status, retry _status.
     3241           end.
     3242         end case.
     3243         find first buf_esys-route no-lock where
     3244             buf_esys-route.esr-dump-ord   = v-dump-ord-int64
     3245         and buf_esys-route.esys-id   = v-esys-id
     3246         and buf_esys-route.db-num   = 0  no-error.
     3247         if available buf_esys-route then do:
     3248           v-edist-mess = ''.
     3249           v-edist-mess = cr-edist_add-edist-mess( v-edist-mess, 'pack-num':U, string(buf_esys-route.esr-last-pack) + "->").
     3250           run update-edi-state-light in this-procedure ( input buf_edi-status.tbl-name
     3251                                                         ,input buf_edi-status.doc-code
     3252                                                         ,input buf_edi-status.date-status
     3253                                                         ,input buf_edi-status.time-status
     3254                                                         ,input buf_edi-status.state
     3255                                                         ,input buf_edi-status.err-code
     3256                                                         ,input buf_edi-status.des-err
     3257                                                         ,input v-edist-mess
     3258                                                         )
     3259                                                         .
     3260           run get-xcnf_create-temp-esys-pck-rcvd in p-cont-handle (
     3261                                                                     input v-esys-id
     3262                                                                   ,input buf_esys-route.esr-last-pack
     3263                                                                   ,input v-crc-pack
     3264                                                                   ,input yes
     3265                                                                   ,input 1
     3266                                                                   ,input 1
     3267                                                                   ,input status_-t.datein
     3268                                                                   ,input integer(entry(1, status_-t.timein, ":")) * 3600 +
     3269                                                                           integer(entry(2, status_-t.timein, ":")) * 60
     3270                                                                   ,input status_-t.timein
     3271                                                                   ) .
     3272           run cur-time in this-procedure ( output v-today, output v-time).
     3273           run get-xcnf_create-temp-esys-pck-sent in p-cont-handle (
     3274                                                                     input v-esys-id
     3275                                                                   ,input integer(v-pack-num-chr)
     3276                                                                   ,input v-crc-pack
     3277                                                                   ,input yes
     3278                                                                   ,input 1
     3279                                                                   ,input 1
     3280                                                                   ,input v-today
     3281                                                                   ,input v-time
     3282                                                                   ,input string(v-time, "HH:MM:SS")
     3283                                                                   ) .
     3284         end.
     3285       end.
     3286       else do:
     3287         v-execute = yes.
     3288         case status_-t.messageclass:
     3289           when "ORDERS" then do:
     3290             find first buf_ord-doc no-lock where
     3291                       buf_ord-doc.doc-code = status_-t.customericid no-error.
     3292             if not available buf_ord-doc then do:
     3293               v-mess = substitute("Не найден заказ поставщику с номером &1", status_-t.customericid).
     3294               undo _status, retry _status.
     3295             end.
     3296             assign
     3297             v-tbl-name = 'ord-doc':U
     3298             v-doc-code = buf_ord-doc.doc-code
     3299             v-trn-code = ''
     3300             v-ord-int1 = integer('2':U)
     3301             .
     3302           end.
     3303           when "ORDRSP" then do:
     3304             find first buf_ext-classif no-lock where
     3305                       buf_ext-classif.classif-subject = 'clients':U
     3306                   and buf_ext-classif.classif-name = 'GLN':U
     3307                   and buf_ext-classif.charkey_one = status_-t.to_  no-error.
     3308             if not available buf_ext-classif then do:
     3309               v-mess = substitute("Не найден контрагент с кодом GLN &1", status_-t.from_).
     3310               undo _status, retry _status.
     3311             end.
     3312             run gen-row-keyr in this-procedure ( input buf_ext-classif.uniq-key-rec
     3313                                                 ,input  ?
     3314                                                 ,input "ub"
     3315                                                 ,input ?
     3316                                                 ,input no-lock
     3317                                                 ,output v-tbl-row
     3318                                                 ,output v-tbl-name) no-error.
     3319             if error-status:error then do:
     3320               v-mess = substitute("Ошибка при поиске клиента по uniq-key-rec &1&2&3&2&4"
     3321                                 , v-tbl-row
     3322                                 , chr(10)
     3323                                 , error-status:get-message(1)
     3324                                 , return-value
     3325                                 ).
     3326               undo _status, retry _status.
     3327             end.
     3328             find first buf_clients no-lock where
     3329                       rowid(buf_clients) = v-tbl-row no-error.
     3330             if not available buf_clients then do:
     3331               v-mess = substitute("Не найден клиент с rowid &1"
     3332                                 , v-tbl-row
     3333                                 ).
     3334               undo _status, retry _status.
     3335             end.
     3336             find first buf_ord-doc no-lock where
     3337                     buf_ord-doc.cli-type =  buf_clients.obj-type
     3338                 and buf_ord-doc.cli-code =  buf_clients.obj-code
     3339                 and entry(1, buf_ord-doc.cli-out-doc, chr(4)) = status_-t.customericid no-error.
     3340             if not available buf_ord-doc then do:
     3341               v-mess = substitute("Не найден заказ поставщику &1&2 (GLN &3), с номером подтверждения заказа &1"
     3342                                    , buf_clients.obj-type
     3343                                    , buf_clients.obj-code
     3344                                    , status_-t.customericid).
     3345               undo _status, retry _status.
     3346             end.
     3347             assign
     3348             v-tbl-name = 'ord-doc':U
     3349             v-doc-code = buf_ord-doc.doc-code
     3350             v-ord-int1 = buf_ord-doc.ord-int1
     3351             v-trn-code = ''
     3352             v-execute = no
     3353             .
     3354           end.
     3355           when "RECADV" then do:
     3356             find first buf_trn-doc no-lock where
     3357                       buf_trn-doc.doc-code = status_-t.customericid no-error.
     3358             if not available buf_trn-doc then do:
     3359               v-mess = substitute("Не найдена приходная накладная с номером &1, на которую пришло подтверждение", status_-t.customericid).
     3360               undo _status, retry _status.
     3361             end.
     3362             find first buf_ord-chain   no-lock where
     3363                       buf_ord-chain.rel-doc-code = buf_trn-doc.doc-code
     3364                   and buf_ord-chain.rel-doc-type = "trn"
     3365                   and buf_ord-chain.doc-type = "rcv" no-error .
     3366             if not available buf_ord-chain then do:
     3367               v-mess = substitute("Не найдена цепочка поставок к заказу для накладной прихода с номером &1", status_-t.customericid).
     3368               undo _status, retry _status.
     3369             end.
     3370             find first buf_ord-doc-rcv no-lock where
     3371                       buf_ord-doc-rcv.rcv-code = buf_ord-chain.doc-code no-error .
     3372             if not available buf_ord-doc-rcv then do:
     3373               v-mess = substitute("Не найдена поставка для приходной накладной с номером &1", status_-t.customericid).
     3374               undo _status, retry _status.
     3375             end.
     3376             find first buf_ord-doc no-lock where
     3377                       buf_ord-doc.doc-code = buf_ord-doc-rcv.doc-code no-error .
     3378             if not available buf_ord-doc then do:
     3379               v-mess = substitute("Не найден заказ по которому была приходная накладная с номером &1", status_-t.customericid).
     3380               undo _status, retry _status.
     3381             end.
     3382             assign
     3383             v-tbl-name = 'trn-doc':U
     3384             v-doc-code = buf_trn-doc.doc-code
     3385             v-trn-code = entry(1, buf_ord-doc-rcv.sub-par, chr(4)).
     3386             v-ord-int1 = integer('11':U)
     3387             .
     3388           end.
     3389           otherwise do:
     3390             v-mess = substitute("Получено непредусмотренное подтверждение на документ типа &1", status_-t.messageclass).
     3391             undo _status, retry _status.
     3392           end.
     3393         end case.
     3394         assign
     3395         v-cli-type = buf_ord-doc.cli-type
     3396         v-cli-code = buf_ord-doc.cli-code
     3397         v-ps = buf_ord-doc.ps
     3398         .
     3399         assign
     3400         glog = status-is-edi ( input yes
     3401                             , input buf_ord-doc.cli-type
     3402                             , input buf_ord-doc.cli-code
     3403                             , input buf_ord-doc.obj-type
     3404                             , input buf_ord-doc.obj-code
     3405                             , output v-dm-edi
     3406                             ) no-error.
     3407         if not glog = yes then do:
     3408           v-mess = substitute("Нет обмена Документами по EXITE-EDI для поставщика &1&2 и &3&4 в БД &5)"
     3409                             , buf_ord-doc.cli-type
     3410                             , buf_ord-doc.cli-code
     3411                             , buf_ord-doc.obj-type
     3412                             , buf_ord-doc.obj-code
     3413                             , g#db-num).
     3414           undo _status, retry _status.
     3415         end.
     3416         if v-execute then do:
     3417         run edocsord_edi-import in this-procedure (
     3418                                                 buffer buf_ord-doc
     3419                                               ,input entry(1, buf_ord-doc.cli-out-doc, chr(4))
     3420                                               ,input v-trn-code
     3421                                               ,input v-ord-int1
     3422                                               ,input buf_ord-doc.ship-date
     3423                                               ,input buf_ord-doc.ps
     3424                                               ,input v-pack-num-chr
     3425                                               ,input status_-t.exiteicid
     3426                                               ,output v-ps
     3427                                               ,output v-new-st
     3428                                               ) no-error.
     3429         if error-status:error then do:
     3430           if return-value <> '' then do:
     3431             v-mess = substitute("Ошибка при изменении статуса заказа при приеме данных:&1&2", chr(10), return-value ).
     3432             undo _status, retry _status.
     3433           end.
     3434         end.
     3435         end.
     3436         if not error-status:error
     3437         or not v-execute then do:
     3438           v-edist-mess = ''.
     3439           v-edist-mess = cr-edist_add-edist-mess( v-edist-mess, 'pack-num':U, "->" + v-pack-num-chr).
     3440           v-edist-mess = cr-edist_add-edist-mess( v-edist-mess, 'ediiterchangeid':U, status_-t.EXiteICID).
     3441           v-date-status = ?.
     3442           run create-edi-state in this-procedure (
     3443                                                   input v-tbl-name
     3444                                                 , input v-doc-code
     3445                                                 , input v-cli-type
     3446                                                 , input v-cli-code
     3447                                                 , input 'ИЗМЕНЕНИЕ':U
     3448                                                 , input v-ord-int1
     3449                                                 , input integer('0':U)
     3450                                                 , input v-PS
     3451                                                 , input v-edist-mess
     3452                                                 , input integer('2':U)
     3453                                                 , input-output v-date-status
     3454                                                 , input-output v-time-status
     3455                                                 ).
     3456           run cur-time in this-procedure ( output v-today, output v-time).
     3457           run get-xcnf_create-temp-esys-pck-sent in p-cont-handle (
     3458                                                                     input v-esys-id
     3459                                                                   ,input integer(v-pack-num-chr)
     3460                                                                   ,input v-crc-pack
     3461                                                                   ,input yes
     3462                                                                   ,input 1
     3463                                                                   ,input 1
     3464                                                                   ,input v-today
     3465                                                                   ,input v-time
     3466                                                                   ,input string(v-time, "HH:MM:SS")
     3467                                                                   ) .
     3468         end.
     3469       end.
     3470       if v-new-st <> ? then do:
     3471         num-rec-ok = num-rec-ok + 1.
     3472       end.
     3473     end.
     3474     run write-counter in p-log-handle ( input substitute("Прочитано записей: &1, из них удачно: &2", num-rec, num-rec-ok)).
     3475   end.
     3476   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Прочитано записей: &1, из них удачно обработано: &2", num-rec, num-rec-ok)).                      assign v-view-log = yes.
     3477   end procedure.
     3478   procedure load-ruleset-context :
     3479   define input parameter p-ruleset-id as integer no-undo .
     3480   define variable glog as logical no-undo .
     3481   define buffer buf_rule-call-param for ub.rule-call-param.
     3482   define buffer buf_esys-pck-keys for ub.esys-pck-keys.
     3483   define buffer buf_ext-system for ub.ext-system.
     3484     do
     3485     on error undo, return error
     3486     :
     3487    find first buf_rule-call-param no-lock where
     3488   buf_rule-call-param.codex_id = p-codex-id
     3489   and buf_rule-call-param.ruleset_id = p-ruleset-id
     3490   and buf_rule-call-param.call_id = p-call-id
     3491   and buf_rule-call-param.order_id = p-order-id
     3492   and buf_rule-call-param.rule_id = p-rule-id
     3493   and buf_rule-call-param.param-name = "p-xsd-file"
     3494    no-error.
     3495   if available buf_rule-call-param then do:
     3496   assign p-xsd-file = buf_rule-call-param.param-value-character.
     3497   end.
     3498       case p-ruleset-id:
     3499         when 4 then do:
     3500           assign
     3501           v-sign = 1
     3502           v-current-host-code = p-host-code
     3503           v-current-obj-type = p-obj-type
     3504           v-current-obj-code = p-obj-code
     3505           v-current-doc-code = p-doc-code
     3506           v-current-db-num = g#db-num
     3507           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     3508           file-name  = entry(1, p-process-file-name, chr(4))
     3509           v_dataseth = handle(entry(2, p-process-file-name, chr(4)))
     3510           v-xmlh = buffer buf_temp-xml-tables:handle
     3511           v-esys-id = integer(p-doc-code)
     3512           v-pack-num-chr = entry(3, p-process-file-name, chr(4))
     3513           no-error
     3514          .
     3515           find first buf_ext-system no-lock where
     3516                     buf_ext-system.esys-id = v-esys-id
     3517                 and buf_ext-system.db-num = 0 no-error .
     3518           if not available buf_ext-system
     3519           or buf_ext-system.esys-type <> integer('9':U)
     3520           then do:
     3521                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не найдена ВС &1&2пропускаем ..."                                         , v-esys-id                                         , chr(10)                                         )).                      assign v-view-log = yes.
     3522             undo, return error substitute("Не найдена ВС &1&2пропускаем ..."                                         , v-esys-id                                         , chr(10)                                         ).
     3523           end.
     3524           glog = dataset status__-t:handle:copy-dataset(v_dataseth
     3525                                              , no
     3526                                              , yes
     3527                                              , no
     3528                                              , ""
     3529                                              , no
     3530                                              ) no-error.
     3531           if error-status:error
     3532           or not glog then do:
     3533                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка копирования импортируемых данных для дальнейшей обработки&1&2"                                         , chr(10)                                         , error-status:get-message(1)                                         )).                      assign v-view-log = yes.
     3534             undo, return error substitute("Ошибка копирования импортируемых данных для дальнейшей обработки&1&2"                                         , chr(10)                                         , error-status:get-message(1)                                         ).
     3535           end.
     3536         end.
     3537         otherwise do:
     3538           undo, return error "Неправильный вызов".
     3539         end.
     3540       end case.
     3541     end.
     3542   end procedure.
     3543   procedure delete-procedure :
     3544     do
     3545     on error undo, return error
     3546     :
     3547         run garbcoll_clear in this-procedure .
     3548     end.
     3549   end procedure.
     3550   procedure delete-ord-list :
     3551   define input parameter p-doc-code as character no-undo .
     3552   define input parameter p-cli-out-doc as character no-undo .
     3553   define input parameter p-trn-doc as character no-undo .
     3554   define input parameter p-is-trn as logical no-undo .
     3555   define buffer buf_ord-list for ord-list.
     3556   find first buf_ord-list where
     3557             buf_ord-list.doc-code = p-doc-code
     3558         and buf_ord-list.trn-doc = p-trn-doc
     3559            no-error .
     3560   if available buf_ord-list then delete buf_ord-list.
     3561   end procedure.
