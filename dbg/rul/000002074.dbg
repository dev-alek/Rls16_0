     1132   procedure get-gate-file-name :
     1133   define input parameter p-gate-rec as character no-undo .
     1134   define output  parameter p-gate-file-name as character no-undo .
     1135   define buffer buf_clob-data for ub.clob-data.
     1136   define variable v-tbl-row as rowid no-undo .
     1137   define variable v-tbl-name as character no-undo .
     1138   run gen-row-keyr in this-procedure ( input p-gate-rec
     1139                                       ,input ?
     1140                                       ,input "ub"
     1141                                       ,input ?
     1142                                       ,input no-lock
     1143                                       ,output v-tbl-row
     1144                                       ,output v-tbl-name) no-error.
     1145   if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     1146                                                           ,vss-include-info10
     1147                                                           ,p-gate-rec).
     1148   find first buf_clob-data no-lock where
     1149             rowid(buf_clob-data) = v-tbl-row no-error.
     1150   if not available buf_clob-data then do:
     1151     if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     1152                                                             ,vss-include-info10
     1153                                                             ,p-gate-rec).
     1154   end.
     1155   p-gate-file-name = buf_clob-data.file-name.
     1156   end procedure.
     1157   procedure get-gate-rec :
     1158   define input  parameter p-gate-name as character no-undo .
     1159   define output parameter p-gate-rec as character no-undo .
     1160   define buffer buf_clob-bind for ub.clob-bind.
     1161   define buffer buf_clob-data for ub.clob-data.
     1162   main-block:
     1163   do
     1164   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info10, return-value, chr(10), error-status :get-message (1))
     1165   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info10 )
     1166   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info10 )
     1167   :
     1168       find first buf_clob-bind no-lock where
     1169                 buf_clob-bind.uniq-key-rec = p-gate-name
     1170             and buf_clob-bind.field-name = '':U
     1171             and buf_clob-bind.part-num = 1
     1172             and buf_clob-bind.resource-type = 'gate':U
     1173             no-error.
     1174       if not available buf_clob-bind then do:
     1175         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     1176                                         , p-gate-name
     1177                                         ).
     1178       end.
     1179       find first buf_clob-data no-lock where
     1180                 buf_clob-data.db-num = buf_clob-bind.db-num
     1181             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     1182       if not available buf_clob-data then do:
     1183         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1184                                         , buf_clob-bind.db-num
     1185                                         , buf_clob-bind.int64-id
     1186                                         , p-gate-name
     1187                                         ).
     1188       end.
     1189       run gen-key-rec in this-procedure ( input 'clob-data':U
     1190                                 ,input buffer buf_clob-data:handle
     1191                                 ,output p-gate-rec).
     1192   end.
     1193   end procedure.
     1194   procedure get-gate-by-name :
     1195   define input  parameter p-gate-name as character no-undo .
     1196   define output parameter p-gate-rec as character no-undo .
     1197   define output parameter p-dsh as handle no-undo .
     1198   define input-output  parameter p-xmlh as handle no-undo .
     1199   define variable v-ii as integer   no-undo .
     1200   define variable glog as logical   no-undo .
     1201   define variable v-longchar as longchar no-undo .
     1202   define variable v-txmlh as handle no-undo .
     1203   define variable v-db-num as integer no-undo .
     1204   define variable v-int64-id as int64 no-undo .
     1205   define buffer buf_clob-bind for ub.clob-bind.
     1206   define buffer buf_clob-data for ub.clob-data.
     1207   main-block:
     1208   do
     1209   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info10, return-value, chr(10), error-status :get-message (1))
     1210   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info10 )
     1211   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info10 )
     1212   :
     1213       find first buf_clob-bind no-lock where
     1214                 buf_clob-bind.uniq-key-rec = p-gate-name
     1215             and buf_clob-bind.field-name = '':U
     1216             and buf_clob-bind.part-num = 1
     1217             and buf_clob-bind.resource-type = 'gate':U
     1218             no-error.
     1219       if not available buf_clob-bind then do:
     1220         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     1221                                         , p-gate-name
     1222                                         ).
     1223       end.
     1224       find first buf_clob-data no-lock where
     1225                 buf_clob-data.db-num = buf_clob-bind.db-num
     1226             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     1227       if not available buf_clob-data then do:
     1228         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1229                                         , buf_clob-bind.db-num
     1230                                         , buf_clob-bind.int64-id
     1231                                         , p-gate-name
     1232                                         ).
     1233       end.
     1234       assign
     1235       v-longchar = buf_clob-data.cdata
     1236       .
     1237       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1238       if error-status :error then do:
     1239         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1240       end.
     1241       create dataset p-dsh .
     1242       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1243                                     , v-longchar
     1244                                     , ?
     1245                                     , ?
     1246                                     , ?
     1247                                     ) no-error.
     1248       v-longchar = '':U.
     1249       if error-status :error
     1250       or not glog
     1251       then do:
     1252         undo, return error substitute("Не удалось прочитать XML-схему &1 из БД:&2&3", p-gate-name, chr(10), error-status:get-message(1) ).
     1253       end.
     1254       if not valid-handle(p-xmlh)
     1255       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1256         create temp-table v-txmlh.
     1257         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1258         v-txmlh:temp-table-prepare("temp-xml-tables").
     1259         p-xmlh = v-txmlh:default-buffer-handle.
     1260       end.
     1261       run gen-key-rec in this-procedure ( input 'clob-data':U
     1262                                 ,input buffer buf_clob-data:handle
     1263                                 ,output p-gate-rec).
     1264       do v-ii = 1 to p-dsh:num-buffers:
     1265         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1266         if not p-xmlh:available then do:
     1267           p-xmlh:buffer-create().
     1268           assign
     1269           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1270           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1271           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1272           p-xmlh::gate-handle_ = p-dsh
     1273           p-xmlh::uniq-gate-rec = p-gate-rec
     1274           p-xmlh::gate-name = p-dsh:name
     1275           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1276           .
     1277           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1278             assign
     1279             p-xmlh::order = -3.
     1280           end.
     1281         end.
     1282       end.
     1283   end.
     1284   end procedure.
     1285   procedure get-gate-by-rec :
     1286   define input  parameter p-gate-rec as character no-undo .
     1287   define output parameter p-dsh as handle no-undo .
     1288   define input-output  parameter p-xmlh as handle no-undo .
     1289   define input-output parameter p-longchar  as longchar no-undo .
     1290   define variable v-ii as integer   no-undo .
     1291   define variable glog as logical   no-undo .
     1292   define variable v-rowid as rowid no-undo .
     1293   define variable v-tbl-name as character no-undo .
     1294   define variable v-longchar as longchar no-undo .
     1295   define variable v-txmlh as handle no-undo .
     1296   define buffer buf_clob-data for ub.clob-data.
     1297   main-block:
     1298   do
     1299   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info10, return-value, chr(10), error-status :get-message (1))
     1300   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info10 )
     1301   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info10 )
     1302   :
     1303     run gen-row-keyr in this-procedure (
     1304                                           input  p-gate-rec
     1305                                           ,input  ?
     1306                                           ,input  "ub"
     1307                                           ,input  ?
     1308                                           ,input  NO-LOCK
     1309                                           ,output v-rowid
     1310                                           ,output v-tbl-name   ) no-error.
     1311       find first buf_clob-data no-lock where
     1312                 rowid(buf_clob-data) = v-rowid  no-error.
     1313       if not available buf_clob-data then do:
     1314         undo, return error substitute("Не найден CLOB  &1"
     1315                                         , p-gate-rec
     1316                                         ).
     1317       end.
     1318       assign
     1319       v-longchar = buf_clob-data.cdata
     1320       .
     1321       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1322       if error-status :error then do:
     1323         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1324       end.
     1325       create dataset p-dsh .
     1326       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1327                                     , v-longchar
     1328                                     , ?
     1329                                     , ?
     1330                                     , ?
     1331                                     ) no-error.
     1332       define variable v-esm as character no-undo .
     1333       v-esm = error-status:get-message(1) .
     1334       if p-longchar <> ? then do:
     1335         p-longchar = v-longchar.
     1336       end.
     1337       v-longchar = '':U.
     1338       if error-status :error
     1339       or not glog
     1340       then do:
     1341         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     1342                                      , p-gate-rec
     1343                                      , p-gate-rec
     1344                                      , v-esm
     1345                                      ).
     1346       end.
     1347       p-dsh:private-data = buf_clob-data.file-name_ + chr(4) + p-gate-rec.
     1348       if not valid-handle(p-xmlh)
     1349       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1350         create temp-table v-txmlh.
     1351         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1352         v-txmlh:temp-table-prepare("temp-xml-tables").
     1353         p-xmlh = v-txmlh:default-buffer-handle.
     1354       end.
     1355       do v-ii = 1 to p-dsh:num-buffers:
     1356         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1357         if not p-xmlh:available then do:
     1358           p-xmlh:buffer-create().
     1359           assign
     1360           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1361           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1362           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1363           p-xmlh::gate-handle_ = p-dsh
     1364           p-xmlh::uniq-gate-rec = p-gate-rec
     1365           p-xmlh::gate-name = p-dsh:name
     1366           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1367           .
     1368           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1369             assign
     1370             p-xmlh::order = -3.
     1371           end.
     1372           p-xmlh:buffer-release().
     1373         end.
     1374       end.
     1375   end.
     1376   end procedure.
     1377   procedure get-gate-by-file :
     1378   define input  parameter p-schema-file-name as character no-undo .
     1379   define input  parameter p-gate-rec as character no-undo .
     1380   define output parameter p-dsh as handle no-undo .
     1381   define input-output  parameter p-xmlh as handle no-undo .
     1382   define variable v-ii as integer   no-undo .
     1383   define variable glog as logical   no-undo .
     1384   define variable v-rowid as rowid no-undo .
     1385   define variable v-tbl-name as character no-undo .
     1386   define variable v-longchar as longchar no-undo .
     1387   define variable v-txmlh as handle no-undo .
     1388   main-block:
     1389   do
     1390   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info10, return-value, chr(10), error-status :get-message (1))
     1391   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info10 )
     1392   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info10 )
     1393   :
     1394       COPY-LOB
     1395       FROM  FILE p-schema-file-name
     1396       TO  OBJECT v-longchar
     1397       no-convert
     1398       NO-ERROR .
     1399       if error-status :error then do:
     1400           undo, return error substitute("Не удалось считать файл схемы &1 в память&2&3"
     1401                                     , p-schema-file-name
     1402                                 , chr(10)
     1403                                 , error-status:get-message(1) ).
     1404       end.
     1405       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1406       if error-status :error then do:
     1407         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, p-schema-file-name, chr(10), error-status:get-message(1) , return-value ).
     1408       end.
     1409       create dataset p-dsh .
     1410       glog = p-dsh:READ-XMLSCHEMA( "longchar"
     1411                                     , v-longchar
     1412                                     , ?
     1413                                     , ?
     1414                                     , ?
     1415                                     ) no-error.
     1416       v-longchar = ''.
     1417       if error-status :error
     1418       or not glog
     1419       then do:
     1420         undo, return error substitute("Не удалось прочитать XML-схему из файла &1&2&3"
     1421                                      , p-schema-file-name
     1422                                      ,chr(10)
     1423                                      , error-status:get-message(1)
     1424                                      ).
     1425       end.
     1426       if not valid-handle(p-xmlh)
     1427       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1428         create temp-table v-txmlh.
     1429         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1430         v-txmlh:temp-table-prepare("temp-xml-tables").
     1431         p-xmlh = v-txmlh:default-buffer-handle.
     1432       end.
     1433       do v-ii = 1 to p-dsh:num-buffers:
     1434         p-xmlh:find-first(substitute(' where tbl-name = "&1" and  uniq-gate-rec = "&2" '
     1435                                      ,p-dsh:get-buffer-handle(v-ii):name
     1436                                      ,p-gate-rec
     1437                                      )) no-error.
     1438         if not p-xmlh:available then do:
     1439           p-xmlh:buffer-create().
     1440           assign
     1441           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):table
     1442           p-xmlh::uniq-gate-rec = p-gate-rec
     1443           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1444           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1445           p-xmlh::gate-handle_ = p-dsh
     1446           p-xmlh::gate-name = p-dsh:name
     1447           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1448           .
     1449           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1450             assign
     1451             p-xmlh::order = -3.
     1452           end.
     1453           p-xmlh:buffer-release().
     1454         end.
     1455       end.
     1456   end.
     1457   end procedure.
     1458   procedure gate-clear :
     1459   define input  parameter p-dsh as handle no-undo .
     1460   define input  parameter p-xmlh as handle no-undo .
     1461   define variable v-dsh as handle no-undo .
     1462   define variable v-th as handle no-undo .
     1463     do
     1464     on error undo, return error return-value
     1465     :
     1466       if valid-handle(p-dsh) then do:
     1467         delete object p-dsh.
     1468         v-dsh = p-dsh.
     1469         p-dsh = ?.
     1470       end.
     1471       repeat while true:
     1472         p-xmlh:find-first( substitute( " where gate-handle_ = &1 ", v-dsh)
     1473                            , share-lock) no-error.
     1474         if p-xmlh:available then do:
     1475           assign
     1476           v-th = p-xmlh:buffer-field("table-handle_"):buffer-value.
     1477           if valid-handle(p-xmlh:buffer-field("table-handle_"))
     1478           and valid-handle(v-th)
     1479           and v-th:dynamic = yes
     1480           then do:
     1481             delete object p-xmlh:buffer-field("table-handle_"):buffer-value.
     1482             p-xmlh:buffer-field("table-handle_"):buffer-value = ?.
     1483           end.
     1484           p-xmlh:buffer-delete().
     1485         end.
     1486         else do:
     1487           leave.
     1488         end.
     1489       end.
     1490       if p-xmlh:dynamic = yes
     1491       and valid-handle(p-xmlh)
     1492       then do:
     1493         delete object p-xmlh:table-handle.
     1494         p-xmlh = ?.
     1495       end.
     1496       v-dsh = ?.
     1497     end.
     1498   end procedure.
     1499   procedure all-gates-clear :
     1500   define parameter buffer buf_temp-xml-tables for temp-xml-tables.
     1501   do
     1502   on error undo, return error
     1503   :
     1504     for each buf_temp-xml-tables
     1505     break
     1506     by buf_temp-xml-tables.uniq-gate-rec
     1507     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1508     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1509     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1510     :
     1511         if first-of(buf_temp-xml-tables.uniq-gate-rec) then do:
     1512           delete object buf_temp-xml-tables.gate-handle_.
     1513           buf_temp-xml-tables.gate-handle_ = ?.
     1514         end.
     1515         if valid-handle(buf_temp-xml-tables.table-handle_)
     1516         and buf_temp-xml-tables.table-handle_:dynamic = no
     1517         then do:
     1518           delete object buf_temp-xml-tables.table-handle_.
     1519           buf_temp-xml-tables.table-handle_ = ?.
     1520         end.
     1521         delete buf_temp-xml-tables.
     1522     end.
     1523   end.
     1524   end procedure.
     1525   procedure fix-schemalocation :
     1526   define input-output  parameter p-longchar as longchar no-undo .
     1527   DEFINE VARIABLE hdoc AS HANDLE.
     1528   DEFINE VARIABLE hroot AS HANDLE.
     1529   DEFINE VARIABLE hnode-child AS HANDLE.
     1530   DEFINE VARIABLE hnode-attr AS HANDLE.
     1531   define variable v-jj as integer   no-undo .
     1532   define variable ok as logical   no-undo .
     1533   define variable v-path1                    as character                no-undo .
     1534   DEFINE VARIABLE v-full-path1               as character                no-undo .
     1535   DEFINE VARIABLE v-file-name1               as character                no-undo .
     1536   DEFINE VARIABLE v-file-name-no-ext1        as character                no-undo .
     1537   DEFINE VARIABLE v-file-name-ext1           as character                no-undo .
     1538   define variable v-schema-location          as character                no-undo .
     1539   do
     1540   on error undo, return error return-value
     1541   :
     1542     CREATE X-DOCUMENT hdoc.
     1543     CREATE X-noderef hroot.
     1544     CREATE X-noderef hnode-child.
     1545     CREATE X-noderef hnode-attr.
     1546     hdoc:load("longchar", p-longchar, no) no-error.
     1547     iF ERROR-STATUS:GET-MESSAGE(1) <> '' THEN message ERROR-STATUS:GET-MESSAGE(1) view-as alert-box .
     1548     hdoc:get-document-element(hroot).
     1549     _repeat:
     1550     REPEAT v-jj = 1 TO hroot:NUM-CHILDREN:
     1551       ok = hroot:GET-CHILD(hNode-Child, v-jj).
     1552       if not ok then next.
     1553       if hNode-Child:local-name = "include"
     1554       then do:
     1555         ok = hNode-Child:GET-ATTRIBUTE-NODE( hnode-attr, "schemaLocation" ).
     1556           v-schema-location = hnode-attr:node-value.
     1557           run gbl/filename.p (
     1558                           input "exe/" + hnode-attr:node-value
     1559                         ,output v-full-path1
     1560                         ,output v-path1
     1561                         ,output v-file-name1
     1562                         ,output v-file-name-no-ext1
     1563                         ,output v-file-name-ext1
     1564                         ) no-error .
     1565           if error-status :error then do:
     1566             delete object hnode-attr.
     1567             delete object hnode-child.
     1568             delete object hroot.
     1569             delete object hdoc.
     1570             undo, return error substitute("Не удалось определить расположение схемы &1", v-schema-location).
     1571           end.
     1572         ok = hNode-Child:sET-ATTRIBUTE(  "schemaLocation", v-full-path1 ).
     1573         leave  _repeat.
     1574       end.
     1575     END.
     1576     hdoc:save("longchar", p-longchar).
     1577     delete object hnode-attr.
     1578     delete object hnode-child.
     1579     delete object hroot.
     1580     delete object hdoc.
     1581   end.
     1582   end procedure.
     1583   procedure gate-clb_fill-xml-tables :
     1584   define input parameter p-dsh as handle no-undo .
     1585   define input-output parameter p-xmlh as handle no-undo .
     1586   define variable v-ii as integer no-undo .
     1587     do
     1588     on error undo, return error
     1589     :
     1590       do v-ii = 1 to p-dsh:num-buffers:
     1591         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1592         if not p-xmlh:available then do:
     1593           p-xmlh:buffer-create().
     1594           assign
     1595           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1596           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1597           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1598           p-xmlh::gate-handle_ = p-dsh
     1599           p-xmlh::uniq-gate-rec = entry(2, p-dsh:private-data, chr(4))
     1600           p-xmlh::gate-name = p-dsh:name
     1601           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1602           .
     1603           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1604             assign
     1605             p-xmlh::order = -3.
     1606           end.
     1607           p-xmlh:buffer-release().
     1608         end.
     1609       end.
     1610     end.
     1611   end procedure.
     1612   procedure all-gates-empty :
     1613   define buffer buf_temp-xml-tables for temp-xml-tables.
     1614   do
     1615   on error undo, return error
     1616   :
     1617     for each buf_temp-xml-tables
     1618     break
     1619     by buf_temp-xml-tables.uniq-gate-rec
     1620     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1621     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1622     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1623     :
     1624       if valid-handle(buf_temp-xml-tables.tbl-handle_) then do:
     1625         buf_temp-xml-tables.tbl-handle_:empty-temp-table().
     1626       end.
     1627     end.
     1628   end.
     1629   end procedure.
     1630   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1631   define temp-table Status_-t  no-undo
     1632   field EXiteICID  as character
     1633   field CustomerICID  as character
     1634   field From_ as character
     1635   field To_  as character
     1636   field Status_ as integer
     1637   field DateIn as date
     1638   field TimeIn as character
     1639   field DateOut as date
     1640   field TimeOut as character
     1641   field SizeInBytes as integer
     1642   field MessageClass as character
     1643   index pi is unique primary EXiteICID
     1644   .
     1645   define dataset Status__-t
     1646   for
     1647   Status_-t
     1648   .
     1649   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1650   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1651   procedure proc-ord-code :
     1652   define input  parameter  p-type as character no-undo .
     1653   define input  parameter  v-cntxt-db-num   as integer   no-undo .
     1654   define input  parameter  v-cntxt-obj-type as character no-undo .
     1655   define input  parameter  v-cntxt-obj-code as integer   no-undo .
     1656   define input  parameter  p-i-doc    as character no-undo .
     1657   define output parameter  p-ord-doc  as character no-undo .
     1658   define variable          v-idop     as character no-undo .
     1659     do
     1660     on error undo, return error return-value
     1661     :
     1662   case p-type :
     1663       when "main-no-ver" then do:
     1664         if  (v-cntxt-db-num <> 0) then
     1665           p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (v-cntxt-obj-code, ">>>>9")) + substring (v-cntxt-obj-type, (if g#language = "RUS" then 1 else 2), 1).
     1666         else
     1667           p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-".
     1668       end.
     1669       when "main" then do:
     1670             do while true:
     1671             if  (v-cntxt-db-num <> 0) then
     1672               p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (v-cntxt-obj-code, ">>>>9")) + substring (v-cntxt-obj-type, (if g#language = "RUS" then 1 else 2), 1).
     1673             else
     1674               p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-".
     1675             if not can-find (ub.ord-doc where ub.ord-doc.doc-code = p-ord-doc no-lock) then leave.
     1676             End.
     1677       end.
     1678       when "chip" then do:
     1679         assign
     1680           v-idop = p-i-doc .
     1681         do while true :
     1682           if index (v-idop , ".") = 0 then
     1683             v-idop  = replace (v-idop , "-", "-1.").
     1684           else
     1685             v-idop  =
     1686             substring (v-idop , 1, index (v-idop, "-")) +
     1687             string (integer (substring (v-idop, index (v-idop, "-") + 1, index (v-idop, ".") - index (v-idop, "-") - 1)) + 1) +
     1688             substring (v-idop, index (v-idop, ".")).
     1689           if not can-find (ub.ord-doc where ub.ord-doc.doc-code = v-idop no-lock) then leave.
     1690         end.
     1691         assign
     1692           p-ord-doc = v-idop.
     1693       end.
     1694   end case.
     1695     end.
     1696   end procedure.
     1697   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1698   def var vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1699   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1700   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1701   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1702   procedure ordlineattr-value :
     1703     do
     1704     on error undo, return error return-value
     1705     :
     1706       define input  parameter p-doc-code like ub.ord-line-attr.doc-code   no-undo .
     1707       define input  parameter p-gds-code like ub.ord-line-attr.gds-code   no-undo .
     1708       define input  parameter p-code     like ub.ord-line-attr.attr-code  no-undo .
     1709       define output parameter p-value    like ub.ord-line-attr.attr-value no-undo .
     1710       define output parameter p-type     as character no-undo .
     1711       define buffer buf_ord-line-attr for ub.ord-line-attr .
     1712       define variable v-format         as character no-undo .
     1713       define variable v-fillin_width   as integer   no-undo .
     1714       define variable v-fillin_height  as integer   no-undo .
     1715       define variable v-label          as character no-undo .
     1716       define variable v-user-can-edit  as logical   no-undo .
     1717       define variable v-output-display as logical   no-undo .
     1718       define variable v-other          as character no-undo .
     1719       define variable v-proc           as character no-undo .
     1720       define variable v-func           as character no-undo .
     1721       define variable v-sort           as integer   no-undo .
     1722       run ordlineattr-code in this-procedure
     1723         (input  p-code
     1724         ,output p-type
     1725         ,output v-format
     1726         ,output v-fillin_width
     1727         ,output v-fillin_height
     1728         ,output v-label
     1729         ,output v-user-can-edit
     1730         ,output v-output-display
     1731         ,output v-proc
     1732         ,output v-func
     1733         ,output v-sort
     1734         ,output v-other
     1735         ) no-error .
     1736       if error-status :error then do:
     1737         undo, return error return-value .
     1738       end.
     1739       find first buf_ord-line-attr no-lock
     1740         where buf_ord-line-attr.doc-code  = p-doc-code
     1741           and buf_ord-line-attr.gds-code  = p-gds-code
     1742           and buf_ord-line-attr.attr-code = p-code
     1743         no-error .
     1744       if avail buf_ord-line-attr then do:
     1745         assign
     1746           p-value =  buf_ord-line-attr.attr-value
     1747         .
     1748       end.
     1749       else do:
     1750         assign
     1751           p-value = if p-type = 'L':U then "no":U else ""
     1752         .
     1753       end.
     1754     end.
     1755   end procedure.
     1756   procedure ordlineattr-write :
     1757     do
     1758     on error undo, return error return-value
     1759     :
     1760       define input parameter p-doc-code like ub.ord-line-attr.doc-code   no-undo .
     1761       define input parameter p-gds-code like ub.ord-line-attr.gds-code   no-undo .
     1762       define input parameter p-code     like ub.ord-line-attr.attr-code  no-undo .
     1763       define input parameter p-value    like ub.ord-line-attr.attr-value no-undo .
     1764       define buffer buf_ord-line-attr for ub.ord-line-attr .
     1765       define variable v-type           as character no-undo .
     1766       define variable v-format         as character no-undo .
     1767       define variable v-fillin_width   as integer   no-undo .
     1768       define variable v-fillin_height  as integer   no-undo .
     1769       define variable v-label          as character no-undo .
     1770       define variable v-user-can-edit  as logical   no-undo .
     1771       define variable v-output-display as logical   no-undo .
     1772       define variable v-other          as character no-undo .
     1773       define variable v-proc           as character no-undo .
     1774       define variable v-func           as character no-undo .
     1775       define variable v-sort           as integer   no-undo .
     1776       run ordlineattr-code in this-procedure
     1777         (input  p-code
     1778         ,output v-type
     1779         ,output v-format
     1780         ,output v-fillin_width
     1781         ,output v-fillin_height
     1782         ,output v-label
     1783         ,output v-user-can-edit
     1784         ,output v-output-display
     1785         ,output v-proc
     1786         ,output v-func
     1787         ,output v-sort
     1788         ,output v-other
     1789         ) no-error .
     1790       if error-status :error then do:
     1791         message
     1792           vss-workfile vss-revision vss-description skip
     1793           error-status :get-message(1) skip
     1794           return-value skip
     1795           ""
     1796           view-as alert-box error
     1797         .
     1798         undo, return error return-value .
     1799       end.
     1800       find first buf_ord-line-attr exclusive-lock
     1801         where buf_ord-line-attr.doc-code  = p-doc-code
     1802           and buf_ord-line-attr.gds-code  = p-gds-code
     1803           and buf_ord-line-attr.attr-code = p-code
     1804         no-error .
     1805       if not available buf_ord-line-attr then do:
     1806         create buf_ord-line-attr .
     1807         assign
     1808           buf_ord-line-attr.doc-code   = p-doc-code
     1809           buf_ord-line-attr.gds-code   = p-gds-code
     1810           buf_ord-line-attr.attr-code  = p-code
     1811         .
     1812       end.
     1813       assign
     1814         buf_ord-line-attr.attr-value = p-value
     1815       .
     1816   end.
     1817   end procedure.
     1818   procedure ordlineattr-exist :
     1819     do
     1820     on error undo, return error return-value
     1821     :
     1822       define input parameter p-doc-code like ub.ord-line-attr.doc-code   no-undo .
     1823       define input parameter p-gds-code like ub.ord-line-attr.gds-code   no-undo .
     1824       define input parameter p-code     like ub.ord-line-attr.attr-code  no-undo .
     1825       define output parameter p-exist   as logical  no-undo .
     1826       define buffer buf_ord-line-attr for ub.ord-line-attr .
     1827       define variable v-type           as character no-undo .
     1828       define variable v-format         as character no-undo .
     1829       define variable v-fillin_width   as integer   no-undo .
     1830       define variable v-fillin_height  as integer   no-undo .
     1831       define variable v-label          as character no-undo .
     1832       define variable v-user-can-edit  as logical   no-undo .
     1833       define variable v-output-display as logical   no-undo .
     1834       define variable v-other          as character no-undo .
     1835       define variable v-proc           as character no-undo .
     1836       define variable v-func           as character no-undo .
     1837       define variable v-sort           as integer   no-undo .
     1838       run ordlineattr-code in this-procedure
     1839         (input  p-code
     1840         ,output v-type
     1841         ,output v-format
     1842         ,output v-fillin_width
     1843         ,output v-fillin_height
     1844         ,output v-label
     1845         ,output v-user-can-edit
     1846         ,output v-output-display
     1847         ,output v-proc
     1848         ,output v-func
     1849         ,output v-sort
     1850         ,output v-other
     1851         ) no-error .
     1852       if error-status :error then do:
     1853         undo, return error return-value .
     1854       end.
     1855       find first buf_ord-line-attr no-lock
     1856         where buf_ord-line-attr.doc-code  = p-doc-code
     1857           and buf_ord-line-attr.gds-code = p-gds-code
     1858           and buf_ord-line-attr.attr-code = p-code
     1859         no-error .
     1860       if  available buf_ord-line-attr then do:
     1861         p-exist = yes.
     1862       end.
     1863     end.
     1864   end procedure.
     1865   procedure ordlineattr-delete :
     1866     do
     1867     on error undo, return error return-value
     1868     :
     1869       define input parameter p-doc-code like ub.ord-line-attr.doc-code   no-undo .
     1870       define input parameter p-gds-code like ub.ord-line-attr.gds-code   no-undo .
     1871       define input parameter p-code     like ub.ord-line-attr.attr-code  no-undo .
     1872       define output parameter p-deleted  as logical no-undo.
     1873       define buffer buf_ord-line-attr for ub.ord-line-attr .
     1874       define variable v-type           as character no-undo .
     1875       define variable v-format         as character no-undo .
     1876       define variable v-fillin_width   as integer   no-undo .
     1877       define variable v-fillin_height  as integer   no-undo .
     1878       define variable v-label          as character no-undo .
     1879       define variable v-user-can-edit  as logical   no-undo .
     1880       define variable v-output-display as logical   no-undo .
     1881       define variable v-proc           as character no-undo .
     1882       define variable v-func           as character no-undo .
     1883       define variable v-sort           as integer   no-undo .
     1884       define variable v-other          as character no-undo .
     1885       run ordlineattr-code in this-procedure
     1886         (input  p-code
     1887         ,output v-type
     1888         ,output v-format
     1889         ,output v-fillin_width
     1890         ,output v-fillin_height
     1891         ,output v-label
     1892         ,output v-user-can-edit
     1893         ,output v-output-display
     1894         ,output v-proc
     1895         ,output v-func
     1896         ,output v-sort
     1897         ,output v-other
     1898         ) no-error .
     1899       if error-status :error then do:
     1900         undo, return error return-value .
     1901       end.
     1902       find first buf_ord-line-attr exclusive-lock
     1903         where buf_ord-line-attr.doc-code  = p-doc-code
     1904           and buf_ord-line-attr.gds-code  = p-gds-code
     1905           and buf_ord-line-attr.attr-code = p-code
     1906         no-error NO-WAIT.
     1907       if not available buf_ord-line-attr then do:
     1908         p-deleted = no.
     1909       end.
     1910       else do:
     1911         delete buf_ord-line-attr.
     1912         p-deleted = yes.
     1913       end.
     1914     end.
     1915   end procedure.
     1916   procedure ordlineattr-code :
     1917     do on error undo, return error return-value
     1918     :
     1919       define input  parameter p-code           as character no-undo .
     1920       define output parameter p-type           as character no-undo .
     1921       define output parameter p-format         as character no-undo .
     1922       define output parameter p-fillin_width   as integer   no-undo .
     1923       define output parameter p-fillin_height  as integer   no-undo .
     1924       define output parameter p-label          as character no-undo .
     1925       define output parameter p-user-can-edit  as logical   no-undo .
     1926       define output parameter p-output-display as logical   no-undo .
     1927       define output parameter p-proc           as character no-undo .
     1928       define output parameter p-func           as character no-undo .
     1929       define output parameter p-sort           as integer   no-undo .
     1930       define output parameter p-other          as character no-undo .
     1931       case p-code :
     1932               when 'cycle-cli-qnty':U then do:     assign     p-label          = "Количество"     p-type           = 'D':U      p-format         = ">>>>>>>>>>>>>>>9.999"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "Количество"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
     1933               when 'ord-EAN13':U then do:     assign     p-label          = "EAN в EDI"     p-type           = 'C':U      p-format         = "X(13)"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "EAN в EDI"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
     1934         otherwise do:
     1935           undo, return error "неизвестный атрибут строки заказа" + " " + p-code .
     1936         end.
     1937       end.
     1938     end.
     1939   end procedure.
     1940   FUNCTION cr-edist_get-mess-mean returns character ( input p-mess as character):
     1941   define variable v-ii as integer   no-undo .
     1942   define variable v-dop as character no-undo .
     1943   define variable v-dop1 as character no-undo .
     1944   define variable v-mess as character no-undo .
     1945   do v-ii = 1 to num-entries(p-mess, chr(4) ):
     1946     v-dop = entry(v-ii, p-mess, chr(4) ).
     1947     case entry(1, v-dop, "="):
     1948       when 'pack-num':U then do:
     1949         v-dop1 =  substitute("&1 &2", 'Пакет', entry(2, v-dop, "=")).
     1950       end.
     1951       when 'route':U then do:
     1952         v-dop1 =  substitute("&1 &2", 'Рут':U, entry(2, v-dop, "=")).
     1953       end.
     1954       when 'ediiterchangeid':U then do:
     1955         v-dop1 =  substitute("&1 &2", 'ediiterchangeid':U, entry(2, v-dop, "=")).
     1956       end.
     1957       when 'price-up':U then do:
     1958         v-dop1 =  substitute("&1 &2", 'Цена':U, entry(2, v-dop, "=")).
     1959       end.
     1960       when 'price-down':U then do:
     1961         v-dop1 =  substitute("&1 &2", 'Цена':U, entry(2, v-dop, "=")).
     1962       end.
     1963       when 'vat-change':U then do:
     1964         v-dop1 =  substitute("&1 &2", 'НДС':U, entry(2, v-dop, "=")).
     1965       end.
     1966       when 'ps':U then do:
     1967         v-dop1 =  substitute("&1 &2", ' ':U, entry(2, v-dop, "=")).
     1968       end.
     1969       when 'info':U then do:
     1970         v-dop1 =  substitute("&1 &2", 'Инф:':U, entry(2, v-dop, "=")).
     1971       end.
     1972       when 'qnty-up':U then do:
     1973         v-dop1 =  substitute("&1 &2", 'Кол-во':U, entry(2, v-dop, "=")).
     1974       end.
     1975       when 'qnty-down':U then do:
     1976         v-dop1 =  substitute("&1 &2", 'Кол-во':U, entry(2, v-dop, "=")).
     1977       end.
     1978       when 'bstr-change':U then do:
     1979         v-dop1 =  substitute("&1 &2", 'Штрихкод:':U, entry(2, v-dop, "=")).
     1980       end.
     1981       when 'shipdate-change':U then do:
     1982         v-dop1 =  substitute("&1 &2", 'Дата отгрузки:':U, entry(2, v-dop, "=")).
     1983       end.
     1984       when 'clioutdoc-change':U then do:
     1985         v-dop1 =  substitute("&1 &2", '№ заказа по пост-ку:':U, entry(2, v-dop, "=")).
     1986       end.
     1987     end case.
     1988     v-mess  = v-mess + (if v-mess = '' then '' else chr(32)) + v-dop1.
     1989   end.
     1990   return v-mess.
     1991   end function.
     1992   FUNCTION cr-edist_get-error-mean returns character ( input p-mess as character):
     1993   define variable v-ii as integer   no-undo .
     1994   define variable v-dop as character no-undo .
     1995   define variable v-dop1 as character no-undo .
     1996   define variable v-mess as character no-undo .
     1997   do v-ii = 1 to num-entries(p-mess, chr(4) ):
     1998     v-dop = entry(v-ii, p-mess, chr(4) ).
     1999     case entry(1, v-dop, "="):
     2000       when 'pack-num':U then do:
     2001         v-dop1 =  substitute("&1 &2", 'Пакет', entry(2, v-dop, "=")).
     2002       end.
     2003       when 'route':U then do:
     2004         v-dop1 =  substitute("&1 &2", 'Рут':U, entry(2, v-dop, "=")).
     2005       end.
     2006       when 'ediiterchangeid':U then do:
     2007         v-dop1 =  substitute("&1 &2", 'ediiterchangeid':U, entry(2, v-dop, "=")).
     2008       end.
     2009       when 'price-up':U then do:
     2010         v-dop1 =  substitute("&1 &2", 'Цена':U, entry(2, v-dop, "=")).
     2011       end.
     2012       when 'price-down':U then do:
     2013         v-dop1 =  substitute("&1 &2", 'Цена':U, entry(2, v-dop, "=")).
     2014       end.
     2015       when 'vat-change':U then do:
     2016         v-dop1 =  substitute("&1 &2", 'НДС':U, entry(2, v-dop, "=")).
     2017       end.
     2018       when 'ps':U then do:
     2019         v-dop1 =  substitute("&1 &2", ' ':U, entry(2, v-dop, "=")).
     2020       end.
     2021       when 'info':U then do:
     2022         v-dop1 =  substitute("&1 &2", 'Инф:':U, entry(2, v-dop, "=")).
     2023       end.
     2024       when 'qnty-up':U then do:
     2025         v-dop1 =  substitute("&1 &2", 'Кол-во':U, entry(2, v-dop, "=")).
     2026       end.
     2027       when 'qnty-down':U then do:
     2028         v-dop1 =  substitute("&1 &2", 'Кол-во':U, entry(2, v-dop, "=")).
     2029       end.
     2030       when 'bstr-change':U then do:
     2031         v-dop1 =  substitute("&1 &2", 'Штрихкод:':U, entry(2, v-dop, "=")).
     2032       end.
     2033       when 'shipdate-change':U then do:
     2034         v-dop1 =  substitute("&1 &2", 'Дата отгрузки:':U, entry(2, v-dop, "=")).
     2035       end.
     2036       when 'clioutdoc-change':U then do:
     2037         v-dop1 =  substitute("&1 &2", '№ заказа по пост-ку:':U, entry(2, v-dop, "=")).
     2038       end.
     2039     end case.
     2040     v-mess  = v-mess + (if v-mess = '' then '' else chr(4)) + v-dop1.
     2041   end.
     2042   return v-mess.
     2043   end function.
     2044   FUNCTION cr-edist_get-mess-key-value returns character ( input p-mess as character, input p-key as character):
     2045   define variable v-ii as integer   no-undo .
     2046   define variable v-dop as character no-undo .
     2047   define variable v-dop1 as character no-undo .
     2048   define variable v-value as character no-undo .
     2049   do v-ii = 1 to num-entries(p-mess, chr(4) ):
     2050     v-dop = entry(v-ii, p-mess, chr(4) ).
     2051     if entry(1, v-dop, "=") = p-key then do:
     2052       return entry(2, v-dop, "=").
     2053     end.
     2054   end.
     2055   return v-value.
     2056   end function.
     2057   FUNCTION cr-edist_add-edist-mess returns character ( input p-mess as character
     2058                                                        ,input p-key as character
     2059                                                        ,input p-value as character):
     2060   define variable v-dop as character no-undo .
     2061   define variable v-modificator as character no-undo .
     2062   assign
     2063   v-modificator = entry(2, p-key, "-") no-error .
     2064   case v-modificator:
     2065     when "up" then do:
     2066       v-dop = substitute("&1=&2<&3", p-key, entry(1, p-value, chr(4)) , entry(2, p-value, chr(4))).
     2067     end.
     2068     when "down" then do:
     2069       v-dop = substitute("&1=&2>&3", p-key, entry(1, p-value, chr(4)) , entry(2, p-value, chr(4))).
     2070     end.
     2071     when "change" then do:
     2072       v-dop = substitute("&1=&2 ->&3", p-key, entry(1, p-value, chr(4)) , entry(2, p-value, chr(4))).
     2073     end.
     2074     otherwise do:
     2075       v-dop = substitute("&1=&2", p-key, p-value).
     2076     end.
     2077   end case.
     2078   if p-mess = ''
     2079   or p-mess = ? then do:
     2080     return v-dop .
     2081   end.
     2082   else do:
     2083     return substitute("&1&2&3", p-mess, chr(4), v-dop).
     2084   end.
     2085   end function.
     2086   procedure create-edi-state :
     2087   define input  parameter p-tbl-name   as character no-undo .
     2088   define input  parameter p-doc-code   as character no-undo .
     2089   define input  parameter p-cli-type   as character no-undo .
     2090   define input  parameter p-cli-code   as integer   no-undo .
     2091   define input  parameter p-act        as character no-undo .
     2092   define input  parameter p-state      as character no-undo .
     2093   define input  parameter p-err        as integer   no-undo .
     2094   define input  parameter p-des        as character no-undo .
     2095   define input  parameter p-mess       as character no-undo .
     2096   define input  parameter p-dm         as integer  no-undo .
     2097   define input-output parameter p-date       as date no-undo .
     2098   define input-output parameter p-time       as integer no-undo .
     2099   define buffer buf_EDI-status for ub.EDI-status  .
     2100   define variable v-time as integer   no-undo .
     2101   define variable v-date as date   no-undo .
     2102   do
     2103   on error undo, return error return-value
     2104   :
     2105     if p-date = ? then do:
     2106       run cur-time in this-procedure ( output v-date, output v-time).
     2107     end.
     2108     else do:
     2109       assign
     2110       v-date = p-date
     2111       v-time = p-time
     2112       .
     2113     end.
     2114     find first buf_edi-status exclusive-lock where
     2115                 buf_edi-status.date-status = v-date
     2116             and buf_edi-status.time-status = v-time
     2117             and buf_edi-status.tbl-name    = p-tbl-name
     2118             and buf_edi-status.doc-code    = p-doc-code no-error .
     2119     if not available buf_edi-status  then do:
     2120       create buf_edi-status.
     2121     end.
     2122     assign
     2123     buf_edi-status.act         = p-act        .
     2124     buf_edi-status.cli-type    = p-cli-type   .
     2125     buf_edi-status.cli-code    = p-cli-code   .
     2126     buf_edi-status.des-err     = buf_edi-status.des-err + (if buf_edi-status.des-err = '' then '' else chr(4)) + p-des        .
     2127     buf_edi-status.doc-code    = p-doc-code   .
     2128     buf_edi-status.err-code    = p-err        .
     2129     buf_edi-status.mess-id     = buf_edi-status.mess-id + (if buf_edi-status.mess-id = '' then '' else chr(4)) + p-mess       .
     2130     buf_edi-status.state       = p-state      .
     2131     buf_edi-status.tbl-name    = p-tbl-name   .
     2132     buf_edi-status.date-status = v-date       .
     2133     buf_edi-status.time-status = v-time       .
     2134     buf_edi-status.whole-send-news = p-dm     .
     2135     buf_edi-status.user-name   = (if g#news then (chr(4) +  'СПН':U)
     2136                                       else (if g#esys
     2137                                             then (chr(4) +  'ВС':U)
     2138                                             else g#userid)
     2139                                       )       .
     2140     assign
     2141     p-date = buf_edi-status.date-status
     2142     p-time = buf_edi-status.time-status
     2143     .
     2144   end.
     2145   end procedure.
     2146   procedure update-edi-state-light :
     2147   define input  parameter p-tbl-name   as character no-undo .
     2148   define input  parameter p-doc-code   as character no-undo .
     2149   define input  parameter p-date-status as date no-undo .
     2150   define input  parameter p-time-status as integer no-undo .
     2151   define input  parameter p-state      as character no-undo .
     2152   define input  parameter p-err        as integer   no-undo .
     2153   define input  parameter p-des        as character no-undo .
     2154   define input  parameter p-mess       as character no-undo .
     2155   define buffer buf_edi-status for ub.edi-status.
     2156   do
     2157   on error undo, return error
     2158   :
     2159     find first buf_edi-status exclusive-lock where
     2160                 buf_edi-status.date-status = p-date-status
     2161             and buf_edi-status.time-status = p-time-status
     2162             and buf_edi-status.tbl-name    = p-tbl-name
     2163             and buf_edi-status.doc-code    = p-doc-code no-error .
     2164     if available buf_edi-status  then do:
     2165       assign
     2166       buf_edi-status.des-err     = p-des        .
     2167       buf_edi-status.err-code    = p-err        .
     2168       buf_edi-status.mess-id     = p-mess       .
     2169       buf_edi-status.state       = p-state      .
     2170     end.
     2171   end.
     2172   end procedure.
     2173   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2174   PROCEDURE write-bonus :
     2175   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     2176   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     2177   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     2178   define input  parameter v-bonus as decimal   no-undo .
     2179     do
     2180     on error undo, return error return-value
     2181     :
     2182       find first ub.contract-specif-attr exclusive-lock  where
     2183                  ub.contract-specif-attr.contract-num = p-contract-num  and
     2184                  ub.contract-specif-attr.host-code    = p-host-code     and
     2185                  ub.contract-specif-attr.gds-code     = p-gds-code      and
     2186                  ub.contract-specif-attr.attr-code    = 'bonus':U
     2187                 no-error .
     2188         if not available ub.contract-specif-attr then do:
     2189            create ub.contract-specif-attr .
     2190            assign
     2191                 ub.contract-specif-attr.contract-num = p-contract-num
     2192                 ub.contract-specif-attr.host-code    = p-host-code
     2193                 ub.contract-specif-attr.gds-code     = p-gds-code
     2194                 ub.contract-specif-attr.attr-code    = 'bonus':U
     2195            .
     2196         end.
     2197         ub.contract-specif-attr.attr-value  = string (v-bonus) .
     2198   end.
     2199   END PROCEDURE.
     2200   PROCEDURE read-bonus :
