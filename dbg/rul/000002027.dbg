     5799               ( input ""            ,
     5800                 input 'Накладная':U ,
     5801                 input v1               ,
     5802                 input v2               ,
     5803                 input v3               ,
     5804                 input v-doc-code       ,
     5805                 input ""               ,
     5806                 input p-gds-code       ,
     5807                 input p-artic          ,
