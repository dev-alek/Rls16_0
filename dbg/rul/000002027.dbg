     4488     output  p-type-increase      ,
     4489     output  p-value-rmethod      ,
     4490     output  p-type-rmethod
     4491     ) no-error .
     4492     if error-status :error then do:
     4493        message vss-workfile vss-revision vss-description skip
     4494        "Ошибка процедуры поиска наценки по группе товара на объекте" skip
     4495        error-status :get-message(1) .
     4496     end.
     4497     g-g = false .
     4498     find first buf-goods no-lock where buf-goods.gds-code =  p-gds-code no-error .
     4499     if error-status :error then message
     4500       vss-workfile vss-revision vss-description skip
     4501       error-status :get-message(1) skip
     4502       return-value skip
     4503       ""
     4504       view-as alert-box error
     4505     .
     4506     case p-calc-method:
     4507       when 'Единая':U or
     4508       when 'Отсутствует':U or
     4509       when 'Не-считать':U or
     4510       when 'Откат_цен':U
     4511       then do:
     4512          p-increase-pc  = 0  .
     4513          p-round-method = 'Отключено':U .
     4514       end.
     4515       when 'Товар':U then do:
     4516         case buf-goods.calc-method:
     4517           when 'Группа':U then do:
     4518             find buf-gds-grp no-lock where
     4519                  buf-gds-grp.node-code = buf-goods.grp-code.
     4520              assign
     4521               p-increase-pc  = loc-grp-increase-pc
     4522               p-round-method = loc-grp-round-method
     4523               p-round-base   = loc-grp-round-base
     4524               g-g = true
     4525              .
     4526           end.
     4527           otherwise do:
     4528              p-increase-pc  =  loc-increase-pc .
     4529           end.
     4530         end case.
     4531         if g-g = false then do:
     4532             run gdsoattr-value
     4533                ( input 'round-method':U ,
     4534                  input p-gds-code ,
     4535                  input x_obj-group.obj-type ,
     4536                  input x_obj-group.obj-code ,
     4537                  output loc-rez ,
     4538                  output t-type
     4539                  ) no-error  .
     4540                 if error-status :error then message
     4541                   vss-workfile vss-revision vss-description skip
     4542                   error-status :get-message(1) skip
     4543                   "gdsoattr-value"
     4544                   view-as alert-box error .
     4545             case NUM-ENTRIES (loc-rez," ") :
     4546                 when 0 then do:
     4547                 end.
     4548                 when 1 then do:
     4549                   p-round-method = loc-rez .
     4550                   p-round-base   = 0 .
     4551                 end.
     4552                 when 2 then do:
     4553                   p-round-method = entry(1 , loc-rez, " " ).
     4554                   p-round-base   = decimal(entry(2 , loc-rez, " " )) .
     4555                 end.
     4556                 otherwise do:
     4557                   p-round-method = entry(1 , loc-rez, " " ).
     4558                   p-round-base   = decimal(entry(NUM-ENTRIES (loc-rez," ") , loc-rez, " " )) .
     4559                 end.
     4560             end case.
     4561         end.
     4562       end.
     4563     end case.
