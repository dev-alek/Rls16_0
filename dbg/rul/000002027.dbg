     4300   PROCEDURE read-retro-bonus :
     4301   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     4302   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     4303   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     4304   define output parameter v-retro-bonus as character   no-undo .
     4305     do
     4306     on error undo, return error return-value
     4307     :
     4308   find first ub.contract-specif-attr no-lock  where
     4309              ub.contract-specif-attr.contract-num = p-contract-num  and
     4310              ub.contract-specif-attr.host-code    = p-host-code     and
     4311              ub.contract-specif-attr.gds-code     = p-gds-code      and
     4312              ub.contract-specif-attr.attr-code    = "retro-bonus"
     4313              no-error .
     4314      if available ub.contract-specif-attr then  v-retro-bonus = ub.contract-specif-attr.attr-value  .
     4315                                           else  v-retro-bonus = "" .
     4316   end.
     4317   END PROCEDURE.
     4318   define variable v-str1 as character no-undo .
     4319   FUNCTION fnc-base-price-doc RETURN decimal
     4320     ( local-bc as integer, p-recid as recid ).
     4321   define buffer   base-price       for ub.price-doc-forming-gds .
     4322   define variable local-main-code like ub.bar-code.b-code no-undo.
     4323   define variable local-base-code like ub.bar-code.b-code no-undo.
     4324   define buffer   buf_main-pdf     for ub.price-doc-forming .
     4325   find first buf_main-pdf no-lock where recid (buf_main-pdf) = p-recid .
     4326     run prc-base-code in this-procedure (input local-bc, output local-base-code).
     4327     find base-price no-lock where
     4328          base-price.pdf-id = buf_main-pdf.pdf-id and
     4329          base-price.pdf-db = buf_main-pdf.pdf-db and
     4330          base-price.plt-id = buf_main-pdf.plt-id and
     4331          base-price.plt-db-num = buf_main-pdf.plt-db-num and
     4332          base-price.b-code  = local-base-code
     4333          no-error.
     4334     if not available base-price then do:
     4335       run prc-main-code in this-procedure
     4336          ( input local-bc, output local-main-code ).
     4337       find  base-price no-lock where
     4338             base-price.pdf-id = buf_main-pdf.pdf-id and
     4339             base-price.pdf-db = buf_main-pdf.pdf-db and
     4340             base-price.plt-id = buf_main-pdf.plt-id and
     4341             base-price.plt-db-num = buf_main-pdf.plt-db-num and
     4342             base-price.b-code  = local-main-code
     4343             no-error.
     4344     end.
     4345     if available base-price then
     4346       return (base-price.price-sale-doc).
     4347     else
     4348       return (?).
     4349   END FUNCTION.
