     6919             buf-price-list.plt-db-num = buf-price-doc-forming.plt-db-num and
     6920             buf-price-list.b-code     <> p-main-code and
     6921             buf-price-list.artic       = buf-goods.artic  and
     6922             buf-price-list.prod-type   = buf-goods.prod-type and
     6923             buf-price-list.prod-code   = buf-goods.prod-code
     6924             ,
     6925       first buf-bar-code no-lock where
     6926             buf-bar-code.b-code   = buf-price-list.b-code and
     6927             buf-bar-code.unit-cli <> buf-goods.unit-base:
     6928      run create-calc-bc in this-procedure
     6929          ( input  recid( new-price-doc-forming )
     6930           ,input  p-calc-method
