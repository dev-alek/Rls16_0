     7095             buf-price-list.prod-code   = buf-goods.prod-code ,
     7096       first buf-bar-code no-lock where
     7097             buf-bar-code.b-code   = buf-price-list.b-code and
     7098             buf-bar-code.unit-cli = buf-goods.unit-base and
     7099             buf-bar-code.in-code <> "" ,
     7100       first buf_parts no-lock where
     7101             buf_parts.out-code    = 'free-zone':U and
