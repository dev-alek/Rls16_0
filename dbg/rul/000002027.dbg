     5893                       view-as alert-box information .
     5894           end.
     5895       end.
     5896      when 'Отсутствует':U or
     5897      when "" then do:
     5898         run str/mplnovat.p
     5899           ( input  'Отсутствует':U    ,
     5900             input  table x_obj-group ,
     5901             input  p-b-code    ,
     5902             input  p-artic     ,
     5903             input  p-prod-type ,
     5904             input  p-prod-code ,
     5905             input  0 ,
     5906             input  v-doc-code ,
