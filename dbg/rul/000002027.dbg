     7206   procedure create-calc-bc :
     7207   define input parameter  v-new-recid as recid no-undo .
     7208   define input parameter  p-calc-method  as character no-undo .
     7209   define input parameter  p-increase-pc  as decimal   no-undo .
     7210   define input parameter  round-method as character no-undo .
     7211   define input parameter  round-base   as decimal   no-undo .
     7212   define input parameter  p-b-code     as integer   no-undo .
     7213   define input parameter  p-gds-code   as integer   no-undo .
     7214   define input parameter  p-artic      as character no-undo .
     7215   define input parameter  p-prod-type  as character no-undo .
     7216   define input parameter  p-prod-code  as integer   no-undo .
     7217   define input parameter  v-base-rate  as decimal   no-undo .
     7218   define input parameter  v-base-scale as decimal   no-undo .
     7219   define input parameter  v-exch-scale as decimal   no-undo .
     7220   define input parameter  v-exch-rate  as decimal   no-undo .
     7221   define input parameter  v-doc-code   as character no-undo .
     7222   define input parameter  v-common-price as decimal   no-undo .
     7223   define input parameter  v-copy-type as character no-undo .
     7224   define input parameter  v-copy-code as integer   no-undo .
     7225   define input-output parameter v-line-num as integer   no-undo .
     7226   define input-output parameter v-sec     as integer   no-undo .
     7227   define buffer buf_price-doc-forming for ub.price-doc-forming  .
     7228   define variable v-price-calc-base as decimal   no-undo .
     7229   define variable v-price-calc-doc  as decimal   no-undo .
     7230   define variable v-price-calc-rubl as decimal   no-undo .
     7231   define variable v-price-prev-base as decimal   no-undo .
     7232   define variable v-price-prev-doc  as decimal   no-undo .
     7233   define variable v-price-prev-rubl as decimal   no-undo .
     7234   define variable v-price-sale-base as decimal   no-undo .
     7235   define variable v-price-sale-doc  as decimal   no-undo .
     7236   define variable v-price-sale-rubl as decimal   no-undo .
     7237   define variable v-road-tax-base   as decimal   no-undo .
     7238   define variable v-road-tax-doc    as decimal   no-undo .
     7239   define variable v-road-tax-rubl   as decimal   no-undo .
     7240   define variable v-excise-base     as decimal   no-undo .
     7241   define variable v-excise-doc      as decimal   no-undo .
     7242   define variable v-excise-rubl     as decimal   no-undo .
     7243   define variable v-vat-pc          as decimal   no-undo .
     7244   define variable v-slt-pc          as decimal   no-undo .
     7245   define variable v-prev-doc-code   as character no-undo .
     7246   define variable v-d-pcnt as decimal   no-undo .
     7247     do
     7248     on error undo, return error return-value
     7249     :
     7250     find  buf_price-doc-forming no-lock where
     7251           recid(buf_price-doc-forming) = v-new-recid no-error .
     7252      if error-status :error then return error error-status :get-message(1) .
     7253      v-line-num = v-line-num + 1.
     7254      run calc-price-line  in this-procedure (
     7255        input  p-calc-method
     7256      , input  p-increase-pc
     7257      , input  round-method
     7258      , input  round-base
     7259      , input  p-b-code
     7260      , input  p-gds-code
