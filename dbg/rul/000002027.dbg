     2204        where buf_goods.gds-code = p-gds-code
     2205   .
     2206   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2207     (input  p-gds-code
     2208     ,input  ?
     2209     ,output v-b-code
     2210     ) no-error .
     2211   if error-status :error
     2212   then do:
     2213       message
     2214           "Не найден основной бар-код"
     2215           skip "для товара "
     2216           skip string(buf_goods.artic)
     2217           skip buf_goods.gds-name
     2218       view-as alert-box
     2219       title "Ошибка при выполнении prcreate.i".
     2220       undo, return error .
     2221   end.
     2222   find first buf_bar-code no-lock
     2223        where buf_bar-code.b-code = v-b-code
     2224   no-error.
     2225   if error-status :error
