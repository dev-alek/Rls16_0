     5088            return-value skip
     5089            "main-road-taxs"
     5090            view-as alert-box error
     5091          .
     5092       end.
     5093     if p-exch-scale = 0  or  p-exch-scale = ?  then do:
     5094       return error "Не определен курс валюты документа" .
     5095     end.
     5096     if p-base-scale = 0  or  p-base-scale = ?  then do:
     5097        return error "Не определен курс базовой валюты " .
     5098     end.
     5099   if v-base = false then var-pr-r-b = "rubl":U .
     5100                     else var-pr-r-b =  "base":U .
     5101       if var-pr-r-b = "rubl":U then do:
     5102           case p-calc-method :
     5103            when 'ПорогПр-НДС':U then do:
     5104               message 3.
     5105            end.
     5106            when 'ПорогПр+НДС':U then do:
     5107                message 4.
     5108            end.
     5109            when 'Производит':U then do:
     5110               p-price-sale-rubl  =  cost-rubl * (1 + p-increase-pc / 100)   .
     5111            end.
     5112            when 'Произв-НДС':U then do:
     5113               p-price-sale-rubl  =  cost-rubl * (1 + p-increase-pc / 100) * (1 +  p-vat-pc / 100)  .
     5114            end.
     5115            otherwise do:
     5116               p-price-sale-rubl  =  cost-rubl * (1 + p-increase-pc / 100) .
     5117            end.
     5118           end case.
     5119           assign
     5120             p-price-calc-rubl  =  cost-rubl
     5121             p-road-tax-rubl    =  cur-rt-rubl
     5122             p-price-calc-doc   =  p-price-calc-rubl / p-exch-rate * p-exch-scale
     5123             p-price-sale-doc   =  p-price-sale-rubl / p-exch-rate * p-exch-scale
     5124             p-road-tax-doc     =  p-road-tax-rubl   / p-exch-rate * p-exch-scale
     5125           .
     5126       end.
     5127       else dO:
     5128            case p-calc-method :
     5129            when 'ПорогПр-НДС':U then do:
     5130               message 5.
     5131            end.
     5132            when 'ПорогПр+НДС':U then do:
     5133                message 6.
     5134            end.
     5135            when 'Производит':U then do:
     5136               p-price-sale-base  =  cost-base * (1 + p-increase-pc / 100) .
     5137            end.
     5138            when 'Произв-НДС':U then do:
     5139               p-price-sale-base  =  cost-base * (1 + p-increase-pc / 100) * (1 + p-vat-pc / 100)  .
     5140            end.
     5141            otherwise do:
     5142               p-price-sale-base  =  cost-base * (1 + p-increase-pc / 100) .
     5143            end.
     5144            end case.
     5145           assign
     5146             p-price-calc-base  =  cost-base
     5147             p-road-tax-base    =  cur-rt-base
     5148             p-price-calc-rubl  =  p-price-calc-base * p-base-rate / p-base-scale
     5149             p-price-sale-rubl  =  p-price-sale-base * p-base-rate / p-base-scale
     5150             p-road-tax-rubl    =  p-road-tax-base   * p-base-rate / p-base-scale
     5151             p-price-calc-doc   =  p-price-calc-rubl / p-exch-rate * p-exch-scale
     5152             p-price-sale-doc   =  p-price-sale-rubl / p-exch-rate * p-exch-scale
     5153             p-road-tax-doc     =  p-road-tax-rubl   / p-exch-rate * p-exch-scale
     5154           .
     5155       end.
     5156   case p-round-method :
     5157     when '9-окончание':U then do:
     5158       if p-price-sale-doc < 29 then do:
     5159         if (p-price-sale-doc - truncate (p-price-sale-doc, 0)) <> 0 then do:
     5160           assign
     5161             p-price-sale-doc = truncate (p-price-sale-doc, 0) + 1
     5162           .
     5163         end.
     5164       end.
     5165       else do:
     5166         if (p-price-sale-doc modulo 10) < 3 then do:
     5167           assign
     5168             p-price-sale-doc = (p-price-sale-doc - (p-price-sale-doc modulo 100))
     5169                 + ( truncate (((p-price-sale-doc modulo 100) / 10), 0)
     5170                   - 1 ) * 10
     5171                 + 9
     5172           .
     5173         end.
     5174         else do:
     5175           assign
     5176             p-price-sale-doc = (p-price-sale-doc - (p-price-sale-doc modulo 100))
     5177                 + ( truncate (((p-price-sale-doc modulo 100) / 10), 0)
     5178                   ) * 10
     5179                 + 9
     5180           .
     5181         end.
     5182         assign
     5183           p-price-sale-doc = round (p-price-sale-doc, 0)
     5184         .
     5185       end.
     5186     end.
     5187     when '9-99окончание':U then do:
     5188       if p-price-sale-doc < p-round-base then do:
     5189         assign
     5190           p-price-sale-doc = truncate (p-price-sale-doc, 0) + 0.99
     5191         .
     5192       end.
     5193       else do:
     5194         assign
     5195           p-price-sale-doc = truncate (p-price-sale-doc / 10 , 0) * 10 + 9.99
     5196         .
     5197       end.
     5198     end.
     5199     when 'Без-дробных':U then do:
     5200       assign
     5201         p-price-sale-doc = round (p-price-sale-doc, 0)
     5202       .
     5203     end.
     5204     when 'Произвольно':U then do:
     5205       if p-round-base <> 0 then do:
     5206         assign
     5207           p-price-sale-doc = round (p-price-sale-doc / p-round-base, 0) * p-round-base
     5208         .
     5209         if p-price-sale-doc = 0 then do:
     5210           assign
     5211             p-price-sale-doc = p-round-base
     5212           .
     5213         end.
     5214       end.
     5215     end.
     5216     when 'Вверх':U then do:
     5217       if p-round-base <> 0 then do:
     5218         if truncate ( p-price-sale-doc / p-round-base, 0 ) <> (p-price-sale-doc / p-round-base) then do:
     5219           assign
     5220             p-price-sale-doc = truncate (p-price-sale-doc / p-round-base, 0) * p-round-base + p-round-base
     5221           .
     5222         end.
     5223       end.
     5224       if p-price-sale-doc = 0 then do:
     5225         assign
     5226           p-price-sale-doc = p-round-base
     5227         .
     5228       end.
     5229     end.
     5230     when 'Коэффициент':U then do:
     5231       if p-round-base <> 0 then do:
     5232         assign
     5233           p-price-sale-doc = p-price-sale-doc * p-round-base
     5234         .
     5235       end.
     5236     end.
     5237     when 'Отключено':U then do:
     5238     end.
     5239     otherwise do:
     5240       message
     5241         vss-workfile vss-revision vss-description skip
     5242         "Неизвестный метод округления продажной цены" skip
     5243         "round-method" p-round-method skip
     5244         "round-base"   p-round-base   skip
     5245         "price"        p-price-sale-doc             skip
     5246         view-as alert-box error .
     5247     end.
     5248   end.
     5249       if error-status :error then do:
     5250       message
     5251         error-status :get-message(1) skip
     5252         return-value skip
     5253         "pr-99"
     5254         view-as alert-box error
     5255       .
     5256       end.
     5257     p-price-calc-rubl = p-price-calc-doc * p-exch-rate / p-exch-scale .
     5258     p-price-sale-rubl = p-price-sale-doc * p-exch-rate / p-exch-scale .
     5259     p-road-tax-rubl   = p-road-tax-doc   * p-exch-rate / p-exch-scale .
     5260     p-price-prev-rubl = p-price-prev-doc * p-exch-rate / p-exch-scale .
     5261     p-price-calc-base = p-price-calc-rubl / p-base-rate * p-base-scale .
     5262     p-price-sale-base = p-price-sale-rubl / p-base-rate * p-base-scale .
     5263     p-road-tax-base   = p-road-tax-rubl   / p-base-rate * p-base-scale .
     5264     p-price-prev-base = p-price-prev-rubl / p-base-rate * p-base-scale .
     5265     define buffer bufold_price-doc-forming for ub.price-doc-forming  .
     5266     find first bufold_price-doc-forming where  recid(bufold_price-doc-forming) = v1-recid no-lock no-error .
     5267     p-prev-doc-code = if available bufold_price-doc-forming
     5268                          then (string(bufold_price-doc-forming.pdf-id) + " БД" + string(bufold_price-doc-forming.pdf-db))
     5269                          else "" .
     5270     end.
     5271   end procedure.
