     2980   procedure grp-obj-notcorr-value :
     2981   do
     2982   on error undo, return error
     2983   :
     2984   define input parameter p-node-code             as integer      no-undo.
     2985   define input parameter p-obj-type              as character    no-undo.
     2986   define input parameter p-obj-code              as integer      no-undo.
     2987   define output parameter p-notcorr              as character    no-undo init ?.
     2988   define output parameter p-range-notcorr     as integer      no-undo.
     2989   define output parameter p-exists-notcorr    as logical      no-undo.
     2990   define variable v-host-code as integer      no-undo.
     2991   DEFINE VARIABLE v-found as logical no-undo .
     2992   DEFINE VARIABLE v-exists as logical no-undo .
     2993   DEFINE VARIABLE v-range as integer no-undo .
     2994   DEFINE VARIABLE jj as integer no-undo .
     2995   DEFINE VARIABLE v-notcorr-found as logical no-undo .
     2996   DEFINE VARIABLE v-notcorr-value as char      no-undo.
     2997   define buffer buf_gds-grp for ub.gds-grp.
     2998   define buffer buf_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
     2999   find first buf_gds-grp no-lock where
     3000              buf_gds-grp.node-code = p-node-code no-error .
     3001   if not avail buf_gds-grp and p-node-code <> 0 then do:
     3002     message
     3003       vss-workfile vss-revision vss-description
     3004       skip "Не удалось найти группу товаров с кодом" p-node-code
     3005       view-as alert-box error .
     3006     undo, return error .
     3007   end.
     3008   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3009   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3010     (input  p-obj-type
     3011     ,input  p-obj-code
     3012     ,output v-host-code
     3013     ) no-error .
     3014   if error-status :error
     3015   then do:
     3016       message
     3017         vss-workfile vss-revision vss-description
     3018         skip "Не удалось найти фирму объекта"
     3019         skip p-obj-type p-obj-code
     3020         skip return-value
     3021         skip trim(error-status :get-message(1))
     3022       view-as alert-box error.
     3023       undo, return error .
     3024   end.
     3025   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
     3026   do while v-found = no and jj < 2:
     3027     if v-range <> 3 then do:
     3028       find first buf_gds-grp-obj no-lock
     3029           where buf_gds-grp-obj.node-code = p-node-code
     3030             and buf_gds-grp-obj.host-code = v-host-code
     3031             and buf_gds-grp-obj.obj-type  = p-obj-type
     3032             and buf_gds-grp-obj.obj-code  = p-obj-code
     3033       no-error .
     3034     end.
     3035     if v-range = 3 or not available buf_gds-grp-obj
     3036     then do:
     3037        if v-range <> 2 then do:
     3038           find first buf_gds-grp-obj no-lock
     3039               where buf_gds-grp-obj.node-code = p-node-code
     3040                 and buf_gds-grp-obj.host-code = v-host-code
     3041                 and buf_gds-grp-obj.obj-type  = ""
     3042                 and buf_gds-grp-obj.obj-code  = 0
     3043           no-error .
     3044         end.
     3045         if v-range = 2 or not available buf_gds-grp-obj
     3046         then do:
     3047             if v-range <> 1 then do:
     3048               find first buf_gds-grp-obj no-lock
     3049                   where buf_gds-grp-obj.node-code = p-node-code
     3050                   and buf_gds-grp-obj.host-code = 0
     3051                   and buf_gds-grp-obj.obj-type  = ""
     3052                   and buf_gds-grp-obj.obj-code  = 0
     3053               no-error .
     3054             end.
     3055             if v-range = 1 or not available buf_gds-grp-obj
     3056             then do:
     3057                 assign
     3058                     v-exists = no
     3059                 .
     3060             end.
     3061             else do:
     3062                 assign
     3063                     v-exists = yes
     3064                     v-range = 1
     3065                 .
     3066             end.
     3067         end.
     3068         else do:
     3069             assign
     3070                 v-exists = yes
     3071                 v-range  = 2
     3072             .
     3073         end.
     3074     end.
     3075     else do:
     3076         assign
     3077             v-exists = yes
     3078             v-range  = 3
     3079         .
     3080     end.
     3081     if available buf_gds-grp-obj
     3082     then do:
     3083       find first buf_gds-grp-obj-attr no-lock
     3084         where buf_gds-grp-obj-attr.node-code   = p-node-code
     3085           and buf_gds-grp-obj-attr.host-code   = buf_gds-grp-obj.host-code
     3086           and buf_gds-grp-obj-attr.obj-type    = buf_gds-grp-obj.obj-type
     3087           and buf_gds-grp-obj-attr.obj-code    = buf_gds-grp-obj.obj-code
     3088           and buf_gds-grp-obj-attr.attr-code   = 'NotCorrOP':U
     3089         no-error .
     3090       if available buf_gds-grp-obj-attr then do:
     3091         assign
     3092           v-notcorr-value = (if buf_gds-grp-obj-attr.attr-value = '' then ? else buf_gds-grp-obj-attr.attr-value)
     3093         .
     3094       end.
     3095       else do:
     3096         assign
     3097           v-notcorr-value = ?
     3098         .
     3099       end.
     3100       assign
     3101       p-exists-notcorr = (if v-notcorr-value <> ? and p-notcorr = ?
     3102                           then yes
     3103                           else p-exists-notcorr)
     3104       p-range-notcorr = if p-exists-notcorr and p-notcorr = ?
     3105                         then v-range
     3106                         else p-range-notcorr
     3107       p-notcorr   =  if p-exists-notcorr and  p-notcorr = ?
     3108                         then v-notcorr-value
     3109                         else p-notcorr
     3110       v-found =  (p-exists-notcorr ) or (v-range <= 1)
     3111       jj = jj + 1
     3112       .
     3113     end.
     3114     else do:
     3115       assign
     3116       v-found =  (p-exists-notcorr  ) or (v-range <= 1)
     3117       jj = jj + 1
     3118       .
     3119     end.
     3120   end.
     3121   end.
     3122   end procedure.
     3123   define variable vss-include-info36 as character format "X(65)" no-undo
     3124   initial "@(#)$Workfile$ $Revision$".
     3125   procedure grplib-get-full-name :
     3126      define input parameter p-node-code  as integer      no-undo.
     3127      define output parameter p-full-name as character    no-undo.
     3128      do
     3129   on error undo, return error
     3130   :
     3131       define variable v-upper-code    as integer           no-undo.
     3132       define buffer buf_gds-grp       for ub.gds-grp.
     3133       define buffer buf_upper_gds-grp for ub.gds-grp.
     3134       find first buf_gds-grp no-lock
     3135            where buf_gds-grp.node-code = p-node-code
     3136       no-error.
     3137       if not available buf_gds-grp
     3138       then do:
     3139           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     3140       end.
     3141       assign
     3142           p-full-name  = ""
     3143           v-upper-code = 1
     3144       .
     3145       do while buf_gds-grp.upper-code <> 0
     3146       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     3147       :
     3148           assign
     3149               p-full-name  = buf_gds-grp.node-name
     3150                            + (if p-full-name <> "" then chr(47) else "")
     3151                            + p-full-name
     3152               v-upper-code = buf_gds-grp.upper-code
     3153           .
     3154           find first buf_gds-grp no-lock
     3155                where buf_gds-grp.node-code = v-upper-code
     3156           no-error.
     3157           if not available buf_gds-grp
     3158           then do:
     3159               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     3160                                   + string( v-upper-code )
     3161                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     3162           end.
     3163       end.
     3164       assign
     3165       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     3166       .
     3167   end.
     3168   end .
     3169   procedure grplib-get-node-from-full-name :
     3170   define input parameter p-full-name as character no-undo .
     3171   define output parameter p-node-code as integer no-undo .
     3172   define variable v-ii as integer no-undo .
     3173   define variable v-upper-code as integer no-undo .
     3174   define variable v-root-code as integer no-undo .
     3175   define variable v-entry as character no-undo .
     3176   define buffer buf_gds-grp       for ub.gds-grp.
     3177   do
     3178   on error undo, return error
     3179   :
     3180     find first buf_gds-grp no-lock
     3181         where buf_gds-grp.upper-code = 0
     3182     no-error .
     3183     if not available buf_gds-grp
     3184     then do:
     3185         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     3186     end.
     3187     else do:
     3188       assign
     3189       v-root-code = buf_gds-grp.node-code
     3190       .
     3191     end.
     3192     v-upper-code = v-root-code.
     3193     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     3194       assign
     3195       v-entry = entry(v-ii, p-full-name, chr(47)).
     3196       if v-entry = '' then leave.
     3197       find first buf_gds-grp no-lock where
     3198                 buf_gds-grp.node-name = v-entry
     3199             and buf_gds-grp.upper-code = v-upper-code
     3200             no-error.
     3201       if not available buf_gds-grp then do:
     3202         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     3203       end.
     3204       else do:
     3205         p-node-code = buf_gds-grp.node-code.
     3206         v-upper-code = buf_gds-grp.node-code.
     3207       end.
     3208     end.
     3209   end.
     3210   end .
