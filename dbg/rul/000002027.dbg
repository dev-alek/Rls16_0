     6899           recid(new-price-doc-forming) = new-recid .
     6900     find  buf-bar-code no-lock where
     6901           buf-bar-code.b-code = p-main-code.
     6902     find  buf-goods no-lock where
     6903           buf-goods.gds-code = buf-bar-code.gds-code.
     6904     find  buf-price-doc-forming-gds no-lock  where
     6905           buf-price-doc-forming-gds.pdf-id = buf-price-doc-forming.pdf-id and
     6906           buf-price-doc-forming-gds.plt-id = buf-price-doc-forming.plt-id and
     6907           buf-price-doc-forming-gds.pdf-db     = buf-price-doc-forming.pdf-db and
     6908           buf-price-doc-forming-gds.plt-db-num = buf-price-doc-forming.plt-db-num and
     6909           buf-price-doc-forming-gds.b-code  = p-main-code no-error .
     6910     if error-status :error then return .
     6911     find  buf-gds-prt no-lock where
     6912           buf-gds-prt.node-code = buf-bar-code.node-code.
     6913   if par-pr-altex = "yes" and
     6914      par-pr-notls = "yes" then do:
     6915   for each  buf-price-list where
     6916             buf-price-list.pdf-id = buf-price-doc-forming.pdf-id and
