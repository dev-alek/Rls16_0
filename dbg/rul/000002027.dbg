     2367         ub.price-doc-forming.plt-db-num   = p-plt-db-num
     2368         ub.price-doc-forming.pdf-id       = next-value ( s-pdf , ub)
     2369         ub.price-doc-forming.pdf-db       = v-cntxt-db-num
     2370         ub.price-doc-forming.base-rate    = v-base-rate
     2371         ub.price-doc-forming.base-scale   = v-base-scale
     2372         ub.price-doc-forming.db-num-chg   = v-cntxt-db-num
