     9354   procedure del-doc-line :
     9355   define input  parameter p-recid as recid no-undo .
     9356     do
     9357     on error undo, return error return-value
     9358     :
     9359     find first ub.price-doc-forming-gds exclusive-lock where
     9360          recid ( ub.price-doc-forming-gds ) = p-recid  no-error .
     9361      if available ub.price-doc-forming-gds then do:
     9362         delete ub.price-doc-forming-gds no-error .
     9363      end.
     9364     end.
     9365   end procedure.
     9366   def var vss-include-info90 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9367   procedure check-use-bar-code :
     9368     define input  parameter p-b-code    like ub.bar-code.b-code no-undo .
     9369     do
     9370     on error  undo, return error substitute( "&1. &2&3&4", vss-include-info90, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     9371     on stop   undo, return error substitute( "&1. stop", vss-include-info90 )
     9372     on endkey undo, return error substitute( "&1. endkey", vss-include-info90 )
     9373     :
     9374       define buffer buf_bar-code for ub.bar-code .
     9375       find first buf_bar-code no-lock
     9376         where buf_bar-code.b-code     = p-b-code
     9377         no-error .
     9378       if not available buf_bar-code then do:
     9379         return error substitute( "&1 (check-use-bar-code). Не найден бар-код &2", vss-include-info90, p-b-code ) .
     9380       end.
     9381       if buf_bar-code.stts = integer('99':U) then do:
     9382         return error substitute( "&1 (check-use-bar-code). Нельзя использовать бар-код &2&3"
     9383                                 + "Выполняется удаление бар-кода"
     9384                                 ,vss-include-info90
     9385                                 ,p-b-code
     9386                                 ,chr(10)
     9387                               ) .
     9388       end.
     9389       if buf_bar-code.stts = integer('79':U) then do:
     9390         return error substitute( "&1 (check-use-bar-code). Нельзя использовать бар-код &2&3"
     9391                                 + "Бар-код выключен"
     9392                                 ,vss-include-info90
     9393                                 ,p-b-code
     9394                                 ,chr(10)
     9395                               ) .
     9396       end.
     9397       return .
     9398     end.
     9399   end procedure.
