     5844                  b_price-doc-forming.pdf-db     = integer(entry(2,v-doc-code,"|"))
     5845                  no-error .
     5846         find b_price-doc-forming-gds no-lock where
     5847              b_price-doc-forming-gds.b-code     = p-b-code and
     5848              b_price-doc-forming-gds.plt-db-num = b_price-doc-forming.plt-db-num and
     5849              b_price-doc-forming-gds.plt-id     = b_price-doc-forming.plt-id and
     5850              b_price-doc-forming-gds.pdf-id     = b_price-doc-forming.pdf-id and
     5851              b_price-doc-forming-gds.pdf-db     = b_price-doc-forming.pdf-db
     5852              no-error.
     5853         if available b_price-doc-forming-gds then
     5854           assign
     5855             p-new-calc-method = 'ДокФормЦены':U + " " + v-doc-code
     5856             cur-rt-base = b_price-doc-forming-gds.road-tax-base
     5857             cur-rt-rubl = b_price-doc-forming-gds.road-tax-rubl
     5858             cost-rubl   = b_price-doc-forming-gds.price-sale-rubl
     5859             cost-base   = b_price-doc-forming-gds.price-sale-base
     5860             .
     5861         else
     5862           message "Нет строки в ДНЦ :" integer(entry(1,v-doc-code,"|")) integer(entry(2,v-doc-code,"|")) skip
     5863                   "для товара :" skip
     5864                    "Бар-код" p-b-code     skip
     5865                    "Артикул" p-artic      skip
     5866                     p-prod-type  skip
     5867                     p-prod-code  skip
     5868                   "- расчет невозможен."
     5869                   view-as alert-box information .
     5870       end.
     5871       when 'Единая':U then do:
     5872           assign
     5873             p-new-calc-method = 'Единая':U + " " + string(common-price)
     5874             cost-rubl = common-price
     5875             cost-base = common-price
     5876             .
     5877       end.
     5878       when 'Объект':U then do:
     5879       find first buf_gds-obj no-lock where
     5880                  buf_gds-obj.gds-code = p-gds-code and
     5881                  buf_gds-obj.obj-type = v-copy-type and
     5882                  buf_gds-obj.obj-code = v-copy-code no-error .
     5883           if available buf_gds-obj then do:
