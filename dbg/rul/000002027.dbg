     2309           buf_price-list.main-price  = (buf_bar-code.b-code = v-main-bar-code )
     2310           buf_price-list.calc-method = 'Отсутствует':U
     2311           buf_price-list.obj-type    = buf_price-doc.obj-type
     2312           buf_price-list.obj-code    = buf_price-doc.obj-code
     2313           buf_price-list.price-sale  = p-price-sale
     2314           buf_price-list.vat-pc      = local_vat-pc
     2315           buf_price-list.slt-pc      = local_slt-pc
     2316           p-update                   = no
