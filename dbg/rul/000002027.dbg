     6045         :
     6046   define variable vss-include-info67 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6047   ASSIGN
     6048      i-gl-Host-Code      = 0
     6049      i-gl-Contract-Code  = 0
     6050      i-gl-Extent3        = 0
     6051      .
     6052   RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
     6053       INPUT  v-cntxt-host-code-obj,
     6054       INPUT  buf_contract.contract-code,
     6055       OUTPUT i-gl-Extent3
     6056      ).
     6057   IF i-gl-Extent3[1] = 2 THEN DO:
     6058      ASSIGN
     6059         i-gl-Host-Code      = i-gl-Extent3[2]
     6060         i-gl-Contract-Code  = i-gl-Extent3[3]
     6061         .
     6062   END. ELSE DO:
     6063      ASSIGN
     6064         i-gl-Host-Code      = v-cntxt-host-code-obj
     6065         i-gl-Contract-Code  = buf_contract.contract-code
     6066         .
     6067   END.
     6068   FOR EACH
     6069       buf_contract-specif
     6070        NO-LOCK
     6071        WHERE
     6072            buf_contract-specif.Host-code    = i-gl-Host-Code
     6073        AND buf_contract-specif.Contract-num = i-gl-Contract-Code
     6074              :
     6075               if buf_contract-specif.gds-code = p-gds-code then do:
     6076                 assign
     6077                   v-num-specif = v-num-specif + 1
     6078                   v-contract-code = buf_contract.contract-code
     6079                 .
     6080               end.
     6081           end.
     6082         end.
     6083         if v-num-specif > 1 then do:
     6084            run str/gds-cnts.w
     6085               (input parparentproc
     6086               ,input p-gds-code
     6087               , "b-sel":U
     6088               ,output v-spis
     6089             ) no-error.
     6090           find first buf_contract-specif no-lock
     6091           where recid(buf_contract-specif) = integer(v-spis)
     6092             no-error.
     6093             if available buf_contract-specif then do:
     6094                 run read-bonus (
     6095                     input  buf_contract-specif.contract-num  ,
     6096                     input  buf_contract-specif.host-code     ,
     6097                     input  buf_contract-specif.gds-code      ,
     6098                     output v-bonus  ) .
     6099                 assign
     6100                   cost-rubl = buf_contract-specif.price-cli
     6101                   cost-base = buf_contract-specif.price-cli / p-base-rate * p-base-scale
     6102                   p-new-calc-method = 'Спецификация':U
     6103                 .
     6104                 if v-bonus <> ? and v-bonus <> 0 then do:
     6105                    assign
     6106                    cost-rubl = cost-rubl + ( cost-rubl * v-bonus / 100 )
     6107                    cost-base = cost-base + ( cost-base * v-bonus / 100 )
     6108                    .
     6109                 end.
     6110             end.
     6111             else do:
     6112               message "Не найдена спецификация с recid " v-spis skip
     6113                       "для товара с артикулом " p-artic skip
     6114                       "на объекте " x_obj-group.obj-type x_obj-group.obj-code skip
     6115                       view-as alert-box information .
     6116             end.
     6117         end.
     6118         if v-num-specif = 0 then do:
     6119             message "Не найдена ни одна спецификация" skip
     6120                     "для товара с артикулом " p-artic skip
     6121                     "на объекте " x_obj-group.obj-type x_obj-group.obj-code skip
     6122                     view-as alert-box information .
     6123         end.
     6124         if v-num-specif = 1 then do:
     6125   define variable vss-include-info68 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6126   ASSIGN
     6127      i-gl-Host-Code      = 0
     6128      i-gl-Contract-Code  = 0
     6129      i-gl-Extent3        = 0
     6130      .
     6131   RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
     6132       INPUT  v-cntxt-host-code-obj,
     6133       INPUT  v-contract-code,
     6134       OUTPUT i-gl-Extent3
     6135      ).
     6136   IF i-gl-Extent3[1] = 2 THEN DO:
     6137      ASSIGN
     6138         i-gl-Host-Code      = i-gl-Extent3[2]
     6139         i-gl-Contract-Code  = i-gl-Extent3[3]
     6140         .
     6141   END. ELSE DO:
     6142      ASSIGN
     6143         i-gl-Host-Code      = v-cntxt-host-code-obj
     6144         i-gl-Contract-Code  = v-contract-code
     6145         .
     6146   END.
     6147   FOR EACH
     6148       buf_contract-specif
     6149        NO-LOCK
     6150        WHERE
     6151            buf_contract-specif.Host-code    = i-gl-Host-Code
     6152        AND buf_contract-specif.Contract-num = i-gl-Contract-Code
     6153               :
     6154               if buf_contract-specif.gds-code = p-gds-code then do:
     6155                 run read-bonus (
     6156                     input  buf_contract-specif.contract-num  ,
     6157                     input  buf_contract-specif.host-code     ,
     6158                     input  buf_contract-specif.gds-code      ,
     6159                     output v-bonus  ) .
     6160                 assign
     6161                   cost-rubl = buf_contract-specif.price-cli
     6162                   cost-base = buf_contract-specif.price-cli / p-base-rate * p-base-scale
     6163                   p-new-calc-method = 'Спецификация':U
     6164                 .
     6165                 if v-bonus <> ? and v-bonus <> 0 then do:
     6166                    assign
     6167                    cost-rubl = cost-rubl + ( cost-rubl * v-bonus / 100 )
     6168                    cost-base = cost-base + ( cost-base * v-bonus / 100 )
     6169                    .
     6170                 end.
     6171               end.
     6172             end.
     6173         end.
     6174      end.
     6175      otherwise do:
     6176        message  "Не просчитывается метод p-calc-method = " p-calc-method  skip
     6177                  p-new-calc-method  skip
     6178                 "p-price-prev-doc " p-price-prev-doc  skip
     6179                 "mpl-lib ERR !!! " skip
     6180                 'артикул ' p-artic skip
     6181                 view-as alert-box information .
     6182      end.
     6183    end case.
     6184   run main-road-taxs in this-procedure
     6185     ( input p-artic     ,
     6186       input p-prod-type ,
     6187       input p-prod-code ,
     6188       input-output cur-rt-base ,
     6189       input-output cur-rt-rubl )
     6190       .
     6191     if p-exch-scale = 0  or  p-exch-scale = ?  then do:
     6192       return error "Не определен курс валюты документа" .
     6193     end.
     6194     if p-base-scale = 0  or  p-base-scale = ?  then do:
     6195        return error "Не определен курс базовой валюты " .
     6196     end.
     6197   if v-base = false then var-pr-r-b = "rubl":U .
     6198                     else var-pr-r-b =  "base":U .
     6199       if var-pr-r-b = "rubl":U then do:
     6200            case p-calc-method :
     6201            when 'ПорогПр-НДС':U then do:
     6202               p-price-sale-rubl  =  cost-rubl + (cost-rubl * p-vat-pc / 100)  .
     6203            end.
     6204            when 'ПорогПр+НДС':U then do:
     6205               p-price-sale-rubl  =  cost-rubl .
     6206            end.
     6207            when  'Производит':U then do:
     6208               p-price-sale-rubl  =  cost-rubl * (1 + p-increase-pc / 100)  .
     6209            end.
     6210            when  'Произв-НДС':U then do:
     6211               p-price-sale-rubl  =  cost-rubl * (1 + p-increase-pc / 100) * (1 + p-vat-pc / 100)   .
     6212            end.
     6213            otherwise do:
     6214               p-price-sale-rubl  =  cost-rubl * (1 + p-increase-pc / 100) .
     6215            end.
     6216           end case.
     6217           assign
     6218             p-price-calc-rubl  =  cost-rubl
     6219             p-road-tax-rubl    =  cur-rt-rubl
     6220             p-price-calc-doc   =  p-price-calc-rubl / p-exch-rate * p-exch-scale
     6221             p-price-sale-doc   =  p-price-sale-rubl / p-exch-rate * p-exch-scale
     6222             p-road-tax-doc     =  p-road-tax-rubl   / p-exch-rate * p-exch-scale
     6223           .
     6224       end.
     6225       else do:
     6226            case p-calc-method:
     6227               when 'ПорогПр-НДС':U then do:
     6228                   p-price-sale-base  =  cost-base + (cost-base * p-vat-pc / 100)  .
     6229               end.
     6230               when 'ПорогПр+НДС':U then do:
     6231                   p-price-sale-base  =  cost-base .
     6232               end.
     6233               when 'Производит':U then do:
     6234                   p-price-sale-base  =  cost-base * (1 + p-increase-pc / 100)  .
     6235               end.
     6236               when 'Произв-НДС':U then do:
     6237                   p-price-sale-base  =  cost-base * (1 + p-increase-pc / 100) * (1 + p-vat-pc / 100)  .
     6238               end.
     6239               otherwise do:
     6240                   p-price-sale-base  =  cost-base * (1 + p-increase-pc / 100) .
     6241               end.
     6242            end case.
     6243           assign
     6244             p-price-calc-base  =  cost-base
     6245             p-road-tax-base    =  cur-rt-base
     6246             p-price-calc-rubl  =  p-price-calc-base * p-base-rate / p-base-scale
     6247             p-price-sale-rubl  =  p-price-sale-base * p-base-rate / p-base-scale
     6248             p-road-tax-rubl    =  p-road-tax-base   * p-base-rate / p-base-scale
     6249             p-price-calc-doc   =  p-price-calc-rubl / p-exch-rate * p-exch-scale
     6250             p-price-sale-doc   =  p-price-sale-rubl / p-exch-rate * p-exch-scale
     6251             p-road-tax-doc     =  p-road-tax-rubl   / p-exch-rate * p-exch-scale
     6252           .
     6253       end.
     6254      if p-price-sale-doc <> 0 then do:
     6255   case p-round-method :
     6256     when '9-окончание':U then do:
     6257       if p-price-sale-doc < 29 then do:
     6258         if (p-price-sale-doc - truncate (p-price-sale-doc, 0)) <> 0 then do:
     6259           assign
     6260             p-price-sale-doc = truncate (p-price-sale-doc, 0) + 1
     6261           .
     6262         end.
     6263       end.
     6264       else do:
     6265         if (p-price-sale-doc modulo 10) < 3 then do:
     6266           assign
     6267             p-price-sale-doc = (p-price-sale-doc - (p-price-sale-doc modulo 100))
     6268                 + ( truncate (((p-price-sale-doc modulo 100) / 10), 0)
     6269                   - 1 ) * 10
     6270                 + 9
     6271           .
     6272         end.
     6273         else do:
     6274           assign
     6275             p-price-sale-doc = (p-price-sale-doc - (p-price-sale-doc modulo 100))
     6276                 + ( truncate (((p-price-sale-doc modulo 100) / 10), 0)
     6277                   ) * 10
     6278                 + 9
     6279           .
     6280         end.
     6281         assign
     6282           p-price-sale-doc = round (p-price-sale-doc, 0)
     6283         .
     6284       end.
     6285     end.
     6286     when '9-99окончание':U then do:
     6287       if p-price-sale-doc < p-round-base then do:
     6288         assign
     6289           p-price-sale-doc = truncate (p-price-sale-doc, 0) + 0.99
     6290         .
     6291       end.
     6292       else do:
     6293         assign
     6294           p-price-sale-doc = truncate (p-price-sale-doc / 10 , 0) * 10 + 9.99
     6295         .
     6296       end.
     6297     end.
     6298     when 'Без-дробных':U then do:
     6299       assign
     6300         p-price-sale-doc = round (p-price-sale-doc, 0)
     6301       .
     6302     end.
     6303     when 'Произвольно':U then do:
     6304       if p-round-base <> 0 then do:
     6305         assign
     6306           p-price-sale-doc = round (p-price-sale-doc / p-round-base, 0) * p-round-base
     6307         .
     6308         if p-price-sale-doc = 0 then do:
     6309           assign
     6310             p-price-sale-doc = p-round-base
     6311           .
     6312         end.
     6313       end.
     6314     end.
     6315     when 'Вверх':U then do:
     6316       if p-round-base <> 0 then do:
     6317         if truncate ( p-price-sale-doc / p-round-base, 0 ) <> (p-price-sale-doc / p-round-base) then do:
     6318           assign
     6319             p-price-sale-doc = truncate (p-price-sale-doc / p-round-base, 0) * p-round-base + p-round-base
     6320           .
     6321         end.
     6322       end.
     6323       if p-price-sale-doc = 0 then do:
     6324         assign
     6325           p-price-sale-doc = p-round-base
     6326         .
     6327       end.
     6328     end.
     6329     when 'Коэффициент':U then do:
     6330       if p-round-base <> 0 then do:
     6331         assign
     6332           p-price-sale-doc = p-price-sale-doc * p-round-base
     6333         .
     6334       end.
     6335     end.
     6336     when 'Отключено':U then do:
     6337     end.
     6338     otherwise do:
     6339       message
     6340         vss-workfile vss-revision vss-description skip
     6341         "Неизвестный метод округления продажной цены" skip
     6342         "round-method" p-round-method skip
     6343         "round-base"   p-round-base   skip
     6344         "price"        p-price-sale-doc             skip
     6345         view-as alert-box error .
     6346     end.
     6347   end.
     6348     end.
     6349     assign
     6350       p-price-calc-rubl = p-price-calc-doc * p-exch-rate / p-exch-scale
     6351       p-price-sale-rubl = p-price-sale-doc * p-exch-rate / p-exch-scale
     6352       p-road-tax-rubl   = p-road-tax-doc   * p-exch-rate / p-exch-scale
     6353       p-price-prev-rubl = p-price-prev-doc * p-exch-rate / p-exch-scale
     6354      .
     6355     assign
     6356       p-price-calc-base = p-price-calc-rubl / p-base-rate * p-base-scale
     6357       p-price-sale-base = p-price-sale-rubl / p-base-rate * p-base-scale
     6358       p-road-tax-base   = p-road-tax-rubl   / p-base-rate * p-base-scale
     6359       p-price-prev-base = p-price-prev-rubl / p-base-rate * p-base-scale
     6360     .
     6361     define buffer bufold_price-doc-forming for ub.price-doc-forming  .
     6362     find first bufold_price-doc-forming where  recid(bufold_price-doc-forming) = v1-recid no-lock no-error .
     6363     p-prev-doc-code = if available bufold_price-doc-forming
     6364                          then (string(bufold_price-doc-forming.pdf-id) + " БД" + string(bufold_price-doc-forming.pdf-db))
     6365                          else "" .
     6366   END PROCEDURE.
     6367   PROCEDURE create-line :
     6368   define input  parameter p-plt-db-num        like ub.price-doc-forming-gds.plt-db-num  no-undo .
     6369   define input  parameter p-plt-id            like ub.price-doc-forming-gds.plt-id      no-undo .
     6370   define input  parameter p-pdf-db            like ub.price-doc-forming-gds.pdf-db      no-undo .
     6371   define input  parameter p-pdf-id            like ub.price-doc-forming-gds.pdf-id  no-undo .
     6372   define input  parameter p-line-num          like ub.price-doc-forming-gds.line-num no-undo .
     6373   define input  parameter p-b-code            like ub.price-doc-forming-gds.b-code   no-undo .
     6374   define input  parameter p-artic             like ub.price-doc-forming-gds.artic    no-undo .
     6375   define input  parameter p-prod-type         like ub.price-doc-forming-gds.prod-type no-undo .
     6376   define input  parameter p-prod-code         like ub.price-doc-forming-gds.prod-code no-undo .
     6377   define input  parameter p-calc-method       like ub.price-doc-forming-gds.calc-method  no-undo .
     6378   define input  parameter p-d-pcnt            like ub.price-doc-forming-gds.d-pcnt       no-undo .
     6379   define input  parameter p-have-start-period like ub.price-doc-forming-gds.have-start-period no-undo .
     6380   define input  parameter p-start-date        like ub.price-doc-forming-gds.start-date        no-undo .
     6381   define input  parameter p-start-shift-date  like ub.price-doc-forming-gds.start-shift-date  no-undo .
     6382   define input  parameter p-start-shift-name  like ub.price-doc-forming-gds.start-shift-name  no-undo .
     6383   define input  parameter p-start-shift-num   like ub.price-doc-forming-gds.start-shift-num   no-undo .
     6384   define input  parameter p-start-sys-date    like ub.price-doc-forming-gds.start-sys-date    no-undo .
     6385   define input  parameter p-start-sys-time    like ub.price-doc-forming-gds.start-sys-time    no-undo .
     6386   define input  parameter p-have-end-period   like ub.price-doc-forming-gds.have-end-period   no-undo .
     6387   define input  parameter p-end-date          like ub.price-doc-forming-gds.end-date          no-undo .
     6388   define input  parameter p-end-shift-date    like ub.price-doc-forming-gds.end-shift-date    no-undo .
     6389   define input  parameter p-end-shift-name    like ub.price-doc-forming-gds.end-shift-name    no-undo .
     6390   define input  parameter p-end-shift-num     like ub.price-doc-forming-gds.end-shift-num     no-undo .
     6391   define input  parameter p-end-sys-date      like ub.price-doc-forming-gds.end-sys-date      no-undo .
     6392   define input  parameter p-end-sys-time      like ub.price-doc-forming-gds.end-sys-time      no-undo .
     6393   define input  parameter p-price-calc-base   like ub.price-doc-forming-gds.price-calc-base   no-undo .
     6394   define input  parameter p-price-calc-doc    like ub.price-doc-forming-gds.price-calc-doc    no-undo .
     6395   define input  parameter p-price-calc-rubl   like ub.price-doc-forming-gds.price-calc-rubl   no-undo .
     6396   define input  parameter p-price-prev-base   like ub.price-doc-forming-gds.price-prev-base   no-undo .
     6397   define input  parameter p-price-prev-doc    like ub.price-doc-forming-gds.price-prev-doc    no-undo .
     6398   define input  parameter p-price-prev-rubl   like ub.price-doc-forming-gds.price-prev-rubl   no-undo .
     6399   define input  parameter p-price-sale-base   like ub.price-doc-forming-gds.price-sale-base   no-undo .
     6400   define input  parameter p-price-sale-doc    like ub.price-doc-forming-gds.price-sale-doc    no-undo .
     6401   define input  parameter p-price-sale-rubl   like ub.price-doc-forming-gds.price-sale-rubl   no-undo .
     6402   define input  parameter p-road-tax-base     like ub.price-doc-forming-gds.road-tax-base     no-undo .
     6403   define input  parameter p-road-tax-doc      like ub.price-doc-forming-gds.road-tax-doc      no-undo .
     6404   define input  parameter p-road-tax-rubl     like ub.price-doc-forming-gds.road-tax-rubl     no-undo .
     6405   define input  parameter p-excise-base       like ub.price-doc-forming-gds.excise-base       no-undo .
     6406   define input  parameter p-excise-doc        like ub.price-doc-forming-gds.excise-doc        no-undo .
     6407   define input  parameter p-excise-rubl       like ub.price-doc-forming-gds.excise-rubl       no-undo .
     6408   define input  parameter p-vat-pc            like ub.price-doc-forming-gds.vat-pc            no-undo .
     6409   define input  parameter p-slt-pc            like ub.price-doc-forming-gds.slt-pc            no-undo .
     6410   define input  parameter p-prev-doc-code     as character no-undo .
     6411   define input  parameter p-stts              like ub.price-doc-forming-gds.stts              no-undo .
     6412   define input-output parameter  v-sec        as integer   no-undo .
     6413     run check-use-bar-code ( p-b-code ) no-error .
     6414     if error-status :error then do:
     6415       message
     6416         return-value skip
     6417         "Ошибка !"
     6418         view-as alert-box error
     6419       .
     6420       undo, return error return-value.
     6421     end.
     6422   find first ub.price-doc-forming-gds exclusive-lock where
     6423              ub.price-doc-forming-gds.plt-db-num  =  p-plt-db-num and
     6424              ub.price-doc-forming-gds.plt-id      =  p-plt-id     and
     6425              ub.price-doc-forming-gds.pdf-db      =  p-pdf-db     and
     6426              ub.price-doc-forming-gds.pdf-id      =  p-pdf-id     and
     6427              ub.price-doc-forming-gds.b-code      =  p-b-code     no-error .
     6428       if not available ub.price-doc-forming-gds then
     6429       do:
     6430         create ub.price-doc-forming-gds .
     6431          assign
     6432           ub.price-doc-forming-gds.plt-db-num = p-plt-db-num
     6433           ub.price-doc-forming-gds.plt-id     = p-plt-id
     6434           ub.price-doc-forming-gds.pdf-db     = p-pdf-db
     6435           ub.price-doc-forming-gds.pdf-id     = p-pdf-id
     6436           ub.price-doc-forming-gds.b-code     = p-b-code
     6437           ub.price-doc-forming-gds.line-num   = p-line-num
     6438          .
     6439       end.
     6440     assign
     6441       ub.price-doc-forming-gds.artic            = p-artic
     6442       ub.price-doc-forming-gds.prod-type        = p-prod-type
     6443       ub.price-doc-forming-gds.prod-code        = p-prod-code
     6444       ub.price-doc-forming-gds.calc-method      = p-calc-method
     6445       ub.price-doc-forming-gds.d-pcnt            = p-d-pcnt
     6446       ub.price-doc-forming-gds.have-start-period = p-have-start-period
     6447       ub.price-doc-forming-gds.start-date       = p-start-date
     6448       ub.price-doc-forming-gds.start-shift-date = p-start-shift-date
     6449       ub.price-doc-forming-gds.start-shift-name = p-start-shift-name
     6450       ub.price-doc-forming-gds.start-shift-num  = p-start-shift-num
     6451       ub.price-doc-forming-gds.start-sys-date   = p-start-sys-date
     6452       ub.price-doc-forming-gds.start-sys-time   = p-start-sys-time
     6453       ub.price-doc-forming-gds.have-end-period  = p-have-end-period
     6454       ub.price-doc-forming-gds.end-date         = p-end-date
     6455       ub.price-doc-forming-gds.end-shift-date   = p-end-shift-date
     6456       ub.price-doc-forming-gds.end-shift-name   = p-end-shift-name
     6457       ub.price-doc-forming-gds.end-shift-num    = p-end-shift-num
     6458       ub.price-doc-forming-gds.end-sys-date     = p-end-sys-date
     6459       ub.price-doc-forming-gds.end-sys-time     = p-end-sys-time
     6460       ub.price-doc-forming-gds.price-calc-base  = p-price-calc-base
     6461       ub.price-doc-forming-gds.price-calc-doc   = p-price-calc-doc
     6462       ub.price-doc-forming-gds.price-calc-rubl  = p-price-calc-rubl
     6463       ub.price-doc-forming-gds.price-prev-base  = p-price-prev-base
     6464       ub.price-doc-forming-gds.price-prev-doc   = p-price-prev-doc
     6465       ub.price-doc-forming-gds.price-prev-rubl  = p-price-prev-rubl
     6466       ub.price-doc-forming-gds.road-tax-base    = p-road-tax-base
     6467       ub.price-doc-forming-gds.road-tax-doc     = p-road-tax-doc
     6468       ub.price-doc-forming-gds.road-tax-rubl    = p-road-tax-rubl
     6469       ub.price-doc-forming-gds.excise-base      = p-excise-base
     6470       ub.price-doc-forming-gds.excise-doc       = p-excise-doc
     6471       ub.price-doc-forming-gds.excise-rubl      = p-excise-rubl
     6472       ub.price-doc-forming-gds.vat-pc           = p-vat-pc
     6473       ub.price-doc-forming-gds.slt-pc           = p-slt-pc
     6474       ub.price-doc-forming-gds.prev-doc-code    = p-prev-doc-code
     6475       ub.price-doc-forming-gds.stts             = p-stts
     6476       ub.price-doc-forming-gds.price-sale-base  = p-price-sale-base
     6477       ub.price-doc-forming-gds.price-sale-doc   = p-price-sale-doc
     6478       ub.price-doc-forming-gds.price-sale-rubl  = p-price-sale-rubl
     6479       .
     6480     run ref/h-pdfgds.p
     6481       ( buffer ub.price-doc-forming-gds ,
     6482         input p-price-sale-doc ,
     6483         input-output v-sec
     6484         ) .
     6485   END PROCEDURE.
     6486   PROCEDURE last-num :
     6487   define input  parameter p-recid as recid no-undo .
     6488   define output parameter p-last-id as integer   no-undo .
     6489   define buffer buf2_price-doc-forming     for ub.price-doc-forming  .
     6490   define buffer buf2_price-doc-forming-gds for ub.price-doc-forming-gds  .
     6491   find first buf2_price-doc-forming no-lock where recid(buf2_price-doc-forming) = p-recid no-error .
     6492         if error-status :error then do:
     6493           p-last-id = ? .
     6494           return .
     6495         end.
     6496       for each buf2_price-doc-forming-gds no-lock  where
     6497               buf2_price-doc-forming-gds.plt-id     = buf2_price-doc-forming.plt-id     and
     6498               buf2_price-doc-forming-gds.plt-db-num = buf2_price-doc-forming.plt-db-num and
     6499               buf2_price-doc-forming-gds.pdf-id     = buf2_price-doc-forming.pdf-id     and
     6500               buf2_price-doc-forming-gds.pdf-db     = buf2_price-doc-forming.pdf-db
     6501               by buf2_price-doc-forming-gds.line-num
     6502               :
     6503               p-last-id = buf2_price-doc-forming-gds.line-num .
     6504       end.
     6505   END PROCEDURE.
     6506   PROCEDURE calc-price-alt :
     6507   define input parameter bc         like ub.bar-code.b-code   no-undo.
     6508   define input parameter p-recid as recid no-undo .
     6509   define input parameter d-pcnt as decimal   no-undo .
     6510   define input parameter r-method   as character no-undo .
     6511   define input parameter r-base     as decimal   no-undo .
     6512   define output parameter pa-price-sale-base  as decimal   no-undo .
     6513   define output parameter pa-price-sale-doc   as decimal   no-undo .
     6514   define output parameter pa-price-sale-rubl  as decimal   no-undo .
     6515   pr-alt:
     6516   do on error undo pr-alt, return error:
     6517     if r-method = ? or
     6518        r-base = ? then do:
     6519       message
     6520         "Не задан способ округления для расчета зависящих от нее неосновных цен." skip
     6521         "Код:" bc skip
     6522         view-as alert-box error.
     6523       undo pr-alt, return error.
     6524     end.
     6525   define buffer buf_bar-code for ub.bar-code  .
     6526   define buffer buf_main_bar-code for ub.bar-code  .
     6527   define buffer buf_main_price-doc-forming for ub.price-doc-forming  .
     6528   define buffer buf_main_price-doc-forming-gds for ub.price-doc-forming-gds  .
     6529   find first buf_main_price-doc-forming no-lock where recid(buf_main_price-doc-forming) = p-recid  no-error .
     6530   if error-status :error then
     6531   message
     6532     vss-workfile vss-revision vss-description skip
     6533     error-status :get-message(1) skip
     6534     return-value skip
     6535     "Ошибка "
     6536     view-as alert-box error
     6537   .
     6538   find first buf_bar-code no-lock where
     6539              buf_bar-code.b-code = bc no-error .
     6540   if error-status :error then
     6541   message
     6542     vss-workfile vss-revision vss-description skip
     6543     error-status :get-message(1) skip
     6544     return-value skip
     6545     "3"
     6546     view-as alert-box error
     6547   .
     6548         assign
     6549           pa-price-sale-doc = fnc-base-price-doc ( input bc , input p-recid ) *
     6550                               buf_bar-code.cli-base-rate *
     6551                               (1 - d-pcnt / 100)
     6552                                 .
     6553     if pa-price-sale-doc <> 0 then do:
     6554   case r-method :
     6555     when '9-окончание':U then do:
     6556       if pa-price-sale-doc < 29 then do:
     6557         if (pa-price-sale-doc - truncate (pa-price-sale-doc, 0)) <> 0 then do:
     6558           assign
     6559             pa-price-sale-doc = truncate (pa-price-sale-doc, 0) + 1
     6560           .
     6561         end.
     6562       end.
     6563       else do:
     6564         if (pa-price-sale-doc modulo 10) < 3 then do:
     6565           assign
     6566             pa-price-sale-doc = (pa-price-sale-doc - (pa-price-sale-doc modulo 100))
     6567                 + ( truncate (((pa-price-sale-doc modulo 100) / 10), 0)
     6568                   - 1 ) * 10
     6569                 + 9
     6570           .
     6571         end.
     6572         else do:
     6573           assign
     6574             pa-price-sale-doc = (pa-price-sale-doc - (pa-price-sale-doc modulo 100))
     6575                 + ( truncate (((pa-price-sale-doc modulo 100) / 10), 0)
     6576                   ) * 10
     6577                 + 9
     6578           .
     6579         end.
     6580         assign
     6581           pa-price-sale-doc = round (pa-price-sale-doc, 0)
     6582         .
     6583       end.
     6584     end.
     6585     when '9-99окончание':U then do:
     6586       if pa-price-sale-doc < r-base then do:
     6587         assign
     6588           pa-price-sale-doc = truncate (pa-price-sale-doc, 0) + 0.99
     6589         .
     6590       end.
     6591       else do:
     6592         assign
     6593           pa-price-sale-doc = truncate (pa-price-sale-doc / 10 , 0) * 10 + 9.99
     6594         .
     6595       end.
     6596     end.
     6597     when 'Без-дробных':U then do:
     6598       assign
     6599         pa-price-sale-doc = round (pa-price-sale-doc, 0)
     6600       .
     6601     end.
     6602     when 'Произвольно':U then do:
     6603       if r-base <> 0 then do:
     6604         assign
     6605           pa-price-sale-doc = round (pa-price-sale-doc / r-base, 0) * r-base
     6606         .
     6607         if pa-price-sale-doc = 0 then do:
     6608           assign
     6609             pa-price-sale-doc = r-base
     6610           .
     6611         end.
     6612       end.
     6613     end.
     6614     when 'Вверх':U then do:
     6615       if r-base <> 0 then do:
     6616         if truncate ( pa-price-sale-doc / r-base, 0 ) <> (pa-price-sale-doc / r-base) then do:
     6617           assign
     6618             pa-price-sale-doc = truncate (pa-price-sale-doc / r-base, 0) * r-base + r-base
     6619           .
     6620         end.
     6621       end.
     6622       if pa-price-sale-doc = 0 then do:
     6623         assign
     6624           pa-price-sale-doc = r-base
     6625         .
     6626       end.
     6627     end.
     6628     when 'Коэффициент':U then do:
     6629       if r-base <> 0 then do:
     6630         assign
     6631           pa-price-sale-doc = pa-price-sale-doc * r-base
     6632         .
     6633       end.
     6634     end.
     6635     when 'Отключено':U then do:
     6636     end.
     6637     otherwise do:
     6638       message
     6639         vss-workfile vss-revision vss-description skip
     6640         "Неизвестный метод округления продажной цены" skip
     6641         "round-method" r-method skip
     6642         "round-base"   r-base   skip
     6643         "price"        pa-price-sale-doc             skip
     6644         view-as alert-box error .
     6645     end.
     6646   end.
     6647     end.
     6648     pa-price-sale-rubl = pa-price-sale-doc * buf_main_price-doc-forming.exch-rate / buf_main_price-doc-forming.exch-scale .
     6649     pa-price-sale-base = pa-price-sale-rubl / buf_main_price-doc-forming.base-rate * buf_main_price-doc-forming.base-scale .
     6650   end.
     6651   END PROCEDURE.
     6652   procedure calc-price-discnt :
     6653     do
     6654     on error undo, return error return-value
     6655     :
     6656   define input parameter p-recid as recid no-undo .
     6657   define input parameter bc    like ub.bar-code.b-code   no-undo.
     6658   define buffer buf-price-doc-forming             for ub.price-doc-forming.
     6659   define buffer buf-price-doc-forming-gds for ub.price-doc-forming-gds.
     6660   define buffer buf-bar-code                      for ub.bar-code.
     6661   define buffer buf-goods                         for ub.goods.
     6662   define buffer old-price-doc-forming-gds         for ub.price-doc-forming-gds.
     6663   define variable pr-rec   as   recid                     no-undo.
     6664   define variable pr-c-b-r like ub.bar-code.cli-base-rate no-undo.
     6665   pr-discnt:
     6666   do on error undo pr-discnt, return error:
     6667     find  buf-price-doc-forming no-lock where
     6668           recid(buf-price-doc-forming) = p-recid .
     6669     find  buf-bar-code no-lock where
     6670           buf-bar-code.b-code = bc.
     6671     find  buf-goods no-lock where
     6672           buf-goods.gds-code = buf-bar-code.gds-code.
     6673     find  buf-price-doc-forming-gds exclusive-lock where
     6674           buf-price-doc-forming-gds.pdf-id = buf-price-doc-forming.pdf-id and
     6675           buf-price-doc-forming-gds.plt-id = buf-price-doc-forming.plt-id and
     6676           buf-price-doc-forming-gds.pdf-db     = buf-price-doc-forming.pdf-db and
     6677           buf-price-doc-forming-gds.plt-db-num = buf-price-doc-forming.plt-db-num and
     6678           buf-price-doc-forming-gds.b-code  = bc.
     6679      if available buf-price-doc-forming-gds then do:
     6680         buf-price-doc-forming-gds.d-pcnt =
     6681         (1 - buf-price-doc-forming-gds.price-sale-doc /
     6682               fnc-base-price-doc ( buf-bar-code.b-code, p-recid ) /
     6683               buf-bar-code.cli-base-rate) * 100 .
     6684      end.
     6685   end.
     6686     end.
     6687   end procedure.
     6688   procedure calc-price-sub :
     6689   define  input  parameter bc           like ub.price-doc-forming-gds.b-code no-undo.
     6690   define  input  parameter p-recid      as recid no-undo .
     6691   define  input  parameter calc-method  as character         no-undo.
     6692   define  input  parameter increase-pc  as decimal           no-undo.
     6693   define  input  parameter round-method as character         no-undo.
     6694   define  input  parameter round-base   as decimal           no-undo.
     6695   define  input  parameter doc-code     as character no-undo .
     6696   define  input  parameter common-price as decimal   no-undo .
     6697   define  input  parameter copy-type    as character no-undo .
     6698   define  input  parameter copy-code    as integer   no-undo .
     6699   define  output parameter calc-rec     as recid             no-undo.
     6700   define  buffer buf-price-doc-forming-gds for ub.price-doc-forming-gds.
     6701   define  buffer buf-bar-code              for ub.bar-code.
     6702   define  buffer buf-goods                 for ub.goods.
     6703   define  buffer buf-gds-prt               for ub.gds-prt.
     6704   define  buffer buf-gds-grp               for ub.gds-grp.
     6705   define  buffer buf-price-doc-forming     for ub.price-doc-forming.
     6706   calc-sub:
     6707   do on error undo calc-sub, return error:
     6708     find  buf-price-doc-forming no-lock where
     6709           recid (buf-price-doc-forming) =  p-recid .
     6710     find  buf-bar-code no-lock where
     6711           buf-bar-code.b-code = bc.
     6712     find  buf-goods no-lock where
     6713           buf-goods.gds-code = buf-bar-code.gds-code.
     6714     find  buf-gds-prt no-lock where
     6715           buf-gds-prt.node-code = buf-bar-code.node-code.
     6716     find  buf-price-doc-forming-gds where
     6717           buf-price-doc-forming-gds.pdf-id    = buf-price-doc-forming.pdf-id and
     6718           buf-price-doc-forming-gds.plt-id    = buf-price-doc-forming.plt-id and
     6719           buf-price-doc-forming-gds.pdf-db    = buf-price-doc-forming.pdf-db and
     6720           buf-price-doc-forming-gds.plt-db-num  = buf-price-doc-forming.plt-db-num and
     6721           buf-price-doc-forming-gds.b-code      = bc no-error .
     6722     calc-rec = recid (buf-price-doc-forming-gds).
     6723     if buf-gds-prt.upper-code = buf-goods.prt-root and  buf-goods.unit-base = buf-bar-code.unit-cli  then do:
     6724       for each  buf-price-doc-forming-gds exclusive-lock where
     6725                 buf-price-doc-forming-gds.pdf-id    = buf-price-doc-forming.pdf-id and
     6726                 buf-price-doc-forming-gds.plt-id    = buf-price-doc-forming.plt-id and
     6727                 buf-price-doc-forming-gds.pdf-db    = buf-price-doc-forming.pdf-db and
     6728                 buf-price-doc-forming-gds.plt-db-num    = buf-price-doc-forming.plt-db-num and
     6729                 buf-price-doc-forming-gds.artic      = buf-goods.artic and
     6730                 buf-price-doc-forming-gds.prod-type  = buf-goods.prod-type and
     6731                 buf-price-doc-forming-gds.prod-code  = buf-goods.prod-code,
     6732           first buf-bar-code no-lock where
     6733                 buf-bar-code.b-code   = buf-price-doc-forming-gds.b-code and
     6734                 buf-bar-code.unit-cli = buf-goods.unit-base ,
     6735           first buf-gds-prt no-lock where
     6736                 buf-gds-prt.node-code = buf-bar-code.node-code and
     6737                 buf-gds-prt.upper-code <> buf-goods.prt-root
     6738           on error undo calc-sub, return error:
     6739             run calc-price-line  in this-procedure
     6740               ( input  calc-method
     6741               , input  increase-pc
     6742               , input  round-method
     6743               , input  round-base
     6744               , input  buf-bar-code.b-code
     6745               , input  buf-goods.gds-code
     6746               , input  buf-goods.artic
     6747               , input  buf-goods.prod-type
     6748               , input  buf-goods.prod-code
     6749               , input  buf-price-doc-forming.base-rate
     6750               , input  buf-price-doc-forming.base-scale
     6751               , input  buf-price-doc-forming.exch-scale
     6752               , input  buf-price-doc-forming.exch-rate
     6753               , input  doc-code
     6754               , input  common-price
     6755               , input  copy-type
     6756               , input  copy-code
     6757               , output buf-price-doc-forming-gds.calc-method
     6758               , output buf-price-doc-forming-gds.price-calc-base
     6759               , output buf-price-doc-forming-gds.price-calc-doc
     6760               , output buf-price-doc-forming-gds.price-calc-rubl
     6761               , output buf-price-doc-forming-gds.price-prev-base
     6762               , output buf-price-doc-forming-gds.price-prev-doc
     6763               , output buf-price-doc-forming-gds.price-prev-rubl
     6764               , output buf-price-doc-forming-gds.price-sale-base
     6765               , output buf-price-doc-forming-gds.price-sale-doc
     6766               , output buf-price-doc-forming-gds.price-sale-rubl
     6767               , output buf-price-doc-forming-gds.road-tax-base
     6768               , output buf-price-doc-forming-gds.road-tax-doc
     6769               , output buf-price-doc-forming-gds.road-tax-rubl
     6770               , output buf-price-doc-forming-gds.excise-base
     6771               , output buf-price-doc-forming-gds.excise-doc
     6772               , output buf-price-doc-forming-gds.excise-rubl
     6773               , output buf-price-doc-forming-gds.vat-pc
     6774               , output buf-price-doc-forming-gds.slt-pc
     6775               , output buf-price-doc-forming-gds.prev-doc-code
     6776               , output buf-price-doc-forming-gds.d-pcnt
     6777               ) no-error .
     6778             if error-status :error then do :
     6779               message
     6780                 vss-workfile vss-revision vss-description skip
     6781                 error-status :get-message(1) skip
     6782                 return-value skip
     6783                 "calc-price-line"
     6784                 view-as alert-box error
     6785               .
     6786               undo calc-sub, return error.
     6787               end.
     6788         calc-rec = recid (buf-price-doc-forming-gds).
     6789       end.
     6790       for each  buf-price-doc-forming-gds exclusive-lock where
     6791                 buf-price-doc-forming-gds.pdf-id    = buf-price-doc-forming.pdf-id and
     6792                 buf-price-doc-forming-gds.plt-id    = buf-price-doc-forming.plt-id and
     6793                 buf-price-doc-forming-gds.pdf-db    = buf-price-doc-forming.pdf-db and
     6794                 buf-price-doc-forming-gds.plt-db-num    = buf-price-doc-forming.plt-db-num and
     6795                 buf-price-doc-forming-gds.artic      = buf-goods.artic and
     6796                 buf-price-doc-forming-gds.prod-type  = buf-goods.prod-type and
     6797                 buf-price-doc-forming-gds.prod-code  = buf-goods.prod-code,
     6798           first buf-bar-code no-lock where
     6799                 buf-bar-code.b-code    = buf-price-doc-forming-gds.b-code and
     6800                 buf-bar-code.unit-cli <> buf-goods.unit-base ,
     6801           first buf-gds-prt no-lock where
     6802                 buf-gds-prt.node-code = buf-bar-code.node-code
     6803           on error undo calc-sub, return error:
     6804       end.
     6805     end.
     6806     else do:
     6807     end.
     6808   end.
     6809   end procedure.
     6810   procedure calc-base-update :
     6811   define input parameter bc           like ub.bar-code.b-code   no-undo.
     6812   define input parameter p-recid      as recid no-undo .
     6813   define input parameter round-method as character    no-undo.
     6814   define input parameter round-base   as decimal      no-undo.
     6815   define buffer alt-bar-code              for ub.bar-code.
     6816   define buffer alt-price-doc-forming-gds for ub.price-doc-forming-gds.
     6817   define buffer buf-bar-code              for ub.bar-code.
     6818   define buffer buf-goods                 for ub.goods.
     6819   define buffer buf-price-doc-forming     for ub.price-doc-forming  .
     6820   calc-base:
     6821   do on error undo calc-base, return error :
     6822     find  buf-price-doc-forming no-lock where
     6823           recid (buf-price-doc-forming) =  p-recid .
     6824     find  buf-bar-code no-lock where
     6825           buf-bar-code.b-code = bc.
     6826     find  buf-goods no-lock where
     6827           buf-goods.gds-code = buf-bar-code.gds-code.
     6828     for each  alt-bar-code no-lock where
     6829               alt-bar-code.gds-code  = buf-bar-code.gds-code and
     6830               alt-bar-code.node-code = buf-bar-code.node-code and
     6831               alt-bar-code.part-code = buf-bar-code.part-code and
     6832               alt-bar-code.in-code   = buf-bar-code.in-code and
     6833               alt-bar-code.unit-cli <> buf-goods.unit-base,
     6834         each  alt-price-doc-forming-gds exclusive-lock where
     6835               alt-price-doc-forming-gds.pdf-id      = buf-price-doc-forming.pdf-id and
     6836               alt-price-doc-forming-gds.plt-id      = buf-price-doc-forming.plt-id and
     6837               alt-price-doc-forming-gds.pdf-db      = buf-price-doc-forming.pdf-db and
     6838               alt-price-doc-forming-gds.plt-db-num  = buf-price-doc-forming.plt-db-num and
     6839               alt-price-doc-forming-gds.b-code      = alt-bar-code.b-code
     6840         on error undo calc-base, return error:
     6841     run calc-price-alt in this-procedure
     6842         ( input  alt-price-doc-forming-gds.b-code
     6843         , input  p-recid
     6844         , input  alt-price-doc-forming-gds.d-pcnt
     6845         , input  round-method
     6846         , input  round-base
     6847         , output alt-price-doc-forming-gds.price-sale-base
     6848         , output alt-price-doc-forming-gds.price-sale-doc
     6849         , output alt-price-doc-forming-gds.price-sale-rubl
     6850         ) no-error .
     6851       if error-status:error then do:
     6852       message
     6853         vss-workfile vss-revision vss-description skip
     6854         error-status :get-message(1) skip
     6855         return-value skip
     6856         "calc-price-alt"
     6857         view-as alert-box error
     6858       .
     6859         undo calc-base, return error.
     6860       end.
     6861     end.
     6862   end.
     6863   end procedure.
     6864   define temp-table temp-exp-partbc no-undo
     6865   field b-code  as integer
     6866   index pi b-code
     6867   .
     6868   procedure expose-prt :
     6869   define input  parameter p-calc-method  as character no-undo .
     6870   define input  parameter p-increase-pc as decimal   no-undo .
     6871   define input  parameter p-main-code    like ub.goods.gds-code    no-undo.
     6872   define input  parameter old-recid      as recid no-undo .
     6873   define input  parameter new-recid      as recid no-undo .
     6874   define input  parameter p-round-method as character no-undo .
