     9737   define variable vss-include-info92 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9738   procedure last-incom-S :
     9739   define input parameter  p-artic      like ub.gds-obj.artic      no-undo .
     9740   define input parameter  p-prod-type  like ub.gds-obj.prod-type  no-undo .
     9741   define input parameter  p-prod-code  like ub.gds-obj.prod-code  no-undo .
     9742   define output parameter p-in-code   as character no-undo .
     9743   define output parameter p-obj-type  as character no-undo .
     9744   define output parameter p-obj-code  as integer   no-undo .
     9745     do
     9746     on error undo, return error return-value
     9747     :
     9748     define buffer buf_trn-doc for ub.trn-doc .
     9749     define buffer buf_gds-obj for ub.gds-obj  .
     9750     do
     9751     on error undo, return error
     9752     :
     9753       assign
     9754         p-in-code  = ""
     9755         p-obj-type = ""
     9756         p-obj-code = 0
     9757       .
     9758        for each x_obj-group ,
     9759         each buf_gds-obj no-lock
     9760         where buf_gds-obj.obj-type  = x_obj-group.obj-type
     9761           and buf_gds-obj.obj-code  = x_obj-group.obj-code
     9762           and buf_gds-obj.artic     = p-artic
     9763           and buf_gds-obj.prod-type = p-prod-type
     9764           and buf_gds-obj.prod-code = p-prod-code
     9765       , first buf_trn-doc no-lock
     9766         where buf_trn-doc.doc-code = buf_gds-obj.in-code
     9767           and buf_trn-doc.status_  = 'факт':U
     9768       on error undo, return error
     9769       by buf_trn-doc.fact-order descending
     9770       :
     9771         assign
     9772           p-in-code  = buf_gds-obj.in-code
     9773           p-obj-type = buf_gds-obj.obj-type
     9774           p-obj-code = buf_gds-obj.obj-code
     9775         .
     9776         leave .
     9777       end.
     9778     end.
     9779     end.
     9780   end procedure.
     9781   procedure main-road-tax :
     9782   def input param p-obj-type  like ub.gds-obj.obj-type  no-undo .
     9783   def input param p-obj-code  like ub.gds-obj.obj-code  no-undo .
     9784   def input param p-artic     like ub.gds-obj.artic     no-undo .
     9785   def input param p-prod-type like ub.gds-obj.prod-type no-undo .
     9786   def input param p-prod-code like ub.gds-obj.prod-code no-undo .
     9787   def input-output param p-road-tax-base as decimal no-undo .
     9788   def input-output param p-road-tax-rubl as decimal no-undo .
     9789   define buffer     buff-goods    for ub.goods   .
     9790   define buffer     buf_gds-obj   for ub.gds-obj .
     9791   define buffer     buf_parts     for ub.parts   .
     9792       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     9793       define buffer   in-vatp-parts    for ub.parts   .
     9794       define buffer   in-vatp-doc      for ub.trn-doc .
     9795       define buffer   in-vatp-goods    for ub.goods   .
     9796       define buffer   in-vatp-sysconf  for ub.sysconf .
     9797       define buffer   in-vatp_doc-attr for ub.doc-attr.
     9798       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     9799       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     9800       define variable varinvprb                  as   character              no-undo.
     9801       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     9802       define variable cli-base-rate              as   decimal                no-undo.
     9803       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     9804       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     9805       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     9806       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     9807       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     9808       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     9809       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     9810       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     9811       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     9812       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     9813       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     9814       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     9815       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     9816       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     9817       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     9818       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     9819       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     9820       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     9821       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     9822       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     9823       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     9824       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     9825       define variable varinvatp-envd             as   character              no-undo.
     9826       define variable varinvatp-type             as   character              no-undo.
     9827   define buffer buf_trn-doc for ub.trn-doc  .
     9828   define buffer buf_doc-line for ub.doc-line .
     9829   define variable   is-petrolium  as logical             no-undo.
     9830   define variable   is-pieces     as logical             no-undo.
     9831   define variable v-last-in-code  like ub.gds-obj.in-code  no-undo .
     9832   define variable v-last-obj-type like ub.gds-obj.obj-type no-undo .
     9833   define variable v-last-obj-code like ub.gds-obj.obj-code no-undo .
     9834   def var v-rec as recid no-undo.
     9835   def var t-ret as logical no-undo .
     9836   def var v-total-avrg-base as decimal no-undo .
     9837   def var v-total-avrg-rubl as decimal no-undo .
     9838   def var v-total-avrg-qnty as decimal no-undo .
     9839   def var v-total-road-tax-base     as decimal no-undo .
     9840   def var v-total-road-tax-rubl     as decimal no-undo .
     9841   def var v-all-total-road-tax-base as decimal no-undo .
     9842   def var v-all-total-road-tax-rubl as decimal no-undo .
     9843   assign
     9844     p-road-tax-base = ?
     9845     p-road-tax-rubl = ?
     9846     .
     9847     Find first buff-goods no-lock where
     9848           buff-goods.artic     = p-artic and
     9849           buff-goods.prod-type = p-prod-type and
     9850           buff-goods.prod-code = p-prod-code
     9851           no-error .
     9852         if available buff-goods then do:
     9853              v-rec = recid (buff-goods).
     9854              t-ret =  session:SET-WAIT-STATE("GENERAL") .
     9855   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     9856     (
     9857        input p-artic
     9858     ,  input p-prod-type
     9859     ,  input p-prod-code
     9860     , output is-petrolium
     9861     , output is-pieces
     9862     ) .
     9863              t-ret =  session:SET-WAIT-STATE("") .
     9864              if not ( hvrdtax( v-rec ) = true and  is-petrolium = false  )   then  do:
     9865                 assign
     9866                   p-road-tax-base = ?
     9867                   p-road-tax-rubl = ?
     9868                   .
     9869                 return.
     9870              end.
     9871         end.
     9872         assign
     9873             v-total-avrg-qnty = 0
     9874             v-total-road-tax-base =  0
     9875             v-total-road-tax-rubl =  0
     9876             v-all-total-road-tax-base =  0
     9877             v-all-total-road-tax-rubl =  0
     9878             .
     9879         for each x_obj-group,
     9880            each buf_parts no-lock
     9881           where buf_parts.obj-type  = x_obj-group.obj-type
     9882             and buf_parts.obj-code  = x_obj-group.obj-code
     9883             and buf_parts.artic     = p-artic
     9884             and buf_parts.prod-type = p-prod-type
     9885             and buf_parts.prod-code = p-prod-code
     9886             and buf_parts.status_   = no
     9887             and buf_parts.out-code  = 'free-zone':U
     9888             and buf_parts.qnty      > 0
     9889         on error undo, return error
     9890         :
     9891            v-total-avrg-qnty = v-total-avrg-qnty + buf_parts.fact-qnty.
     9892   assign
     9893     price-rubl-with-tax-loc = buf_parts.price-rubl
     9894     price-base-with-tax-loc = buf_parts.price-base
     9895   .
     9896   define variable vss-include-info93 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     9897   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     9898     (output varinvprb
     9899     )  .
     9900     if buf_parts.out-code = 'free-zone':U     or
     9901        buf_parts.out-code = 'out-zone':U   or
     9902        buf_parts.doc-type = 'акт':U then do:
     9903       assign
     9904         in-vatp-have-vat-slt = yes.
     9905     end.
     9906     else do:
     9907       find first in-vatp_doc-attr no-lock
     9908         where in-vatp_doc-attr.doc-code  = buf_parts.out-code
     9909           and in-vatp_doc-attr.attr-code = 'envd':U
