     5645     end.
     5646   define variable vss-include-info64 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5647   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bc-mpl in g#library2
     5648     (input  buf_price-list-type.gop-id
     5649     ,input  buf_price-list-type.gop-db-num
     5650     ,input  p-b-code
     5651     ,input  0
     5652     ,input  0
     5653     ,output v1-recid
     5654     ,output p-price-prev-doc
     5655     ,output v1-cur-rt
     5656     ,output v1-cur-ex
     5657     ) no-error .
     5658       if error-status :error then
     5659       message
     5660         vss-workfile vss-revision vss-description skip
     5661         error-status :get-message(1) skip
     5662         return-value skip
     5663         "bc-mpl"
     5664         view-as alert-box error
     5665       .
     5666   define buffer old1_price-doc-forming     for ub.price-doc-forming  .
     5667   define buffer old1_price-doc-forming-gds for ub.price-doc-forming-gds  .
     5668   find first old1_price-doc-forming no-lock where
     5669              recid(old1_price-doc-forming) = v1-recid no-error .
     5670   find first old1_price-doc-forming-gds no-lock where
     5671              old1_price-doc-forming-gds.pdf-db      = old1_price-doc-forming.pdf-db      and
     5672              old1_price-doc-forming-gds.pdf-id      = old1_price-doc-forming.pdf-id      and
     5673              old1_price-doc-forming-gds.plt-db-num  = old1_price-doc-forming.plt-db-num  and
     5674              old1_price-doc-forming-gds.plt-id      = old1_price-doc-forming.plt-id      and
     5675              old1_price-doc-forming-gds.b-code      = p-b-code
     5676              no-error .
     5677   if available old1_price-doc-forming-gds then do:
     5678      p-d-pcnt = old1_price-doc-forming-gds.d-pcnt .
     5679   end.
     5680   else do:
     5681     p-d-pcnt = 0 .
     5682   end.
     5683   case p-calc-method :
     5684      when 'Новая':U or
     5685      when 'Не-считать':U then do:
     5686       assign
     5687         p-new-calc-method = p-calc-method
     5688         cost-rubl = ?
     5689         cost-base = ?
     5690       .
     5691         if available buf_price-doc-forming then do:
     5692           assign
     5693             v-pdf-id      = buf_price-doc-forming.pdf-id
     5694             v-pdf-db-num  = buf_price-doc-forming.pdf-db
     5695             v-plt-id2     = buf_price-doc-forming.plt-id
     5696             v-plt-db-num2 = buf_price-doc-forming.plt-db-num
     5697           .
     5698           find first buf_buf_price-doc-forming-gds no-lock where
     5699                 buf_buf_price-doc-forming-gds.pdf-id =  v-pdf-id and
     5700                 buf_buf_price-doc-forming-gds.pdf-db =  v-pdf-db-num and
     5701                 buf_buf_price-doc-forming-gds.plt-id =  v-plt-id2     and
     5702                 buf_buf_price-doc-forming-gds.plt-db-num =  v-plt-db-num2 and
     5703                 buf_buf_price-doc-forming-gds.b-code =  p-b-code
     5704                 no-error .
     5705               if available buf_buf_price-doc-forming-gds then do:
     5706                   assign
     5707                     cost-rubl = buf_buf_price-doc-forming-gds.price-sale-rubl
     5708                     cost-base = buf_buf_price-doc-forming-gds.price-sale-base
     5709                   .
     5710               end.
     5711         end.
     5712      end.
     5713      when 'УчетнаяS':U  or
     5714      when 'Учет-рзрвS':U  or
     5715      when 'ПриходнаяS':U
     5716      then do:
     5717         run str/sgdsavrg.p
     5718         (   input  p-calc-method    ,
     5719             input  table x_obj-group ,
     5720             input  p-b-code    ,
     5721             input  p-artic     ,
