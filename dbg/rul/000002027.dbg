     5813                 input (if buf_trn-doc.ext-doc-type = 'ie':U then buf_doc-line.price-base else buf_gds-dtl.price-base ) ,
     5814                 output cost-base       ,
     5815                 output v4
     5816                 ) no-error .
     5817             end.
     5818             if not error-status :error then
     5819                 assign
     5820                   p-new-calc-method = 'Накладная':U + " " + v-doc-code
     5821                .
     5822       end.
     5823       when 'Переоценка':U then do:
     5824         find prev-list where
