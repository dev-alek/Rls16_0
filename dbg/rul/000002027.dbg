     2682   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2683   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2684   DEFINE VARIABLE v-S_CONTRACT               AS CHARACTER NO-UNDO INITIAL "".
     2685   DEFINE VARIABLE v-S_CODE_LAST_MASTER_NUM   AS CHARACTER NO-UNDO INITIAL "".
     2686   DEFINE VARIABLE v-DELIM_CHR_3              AS CHARACTER NO-UNDO INITIAL "".
     2687   ASSIGN
     2688      v-S_CONTRACT                = "Contract":U
     2689      v-S_CODE_LAST_MASTER_NUM    = "LastMasterNum":U
     2690      v-DELIM_CHR_3               = ","
     2691      .
     2692   DEFINE VARIABLE i-gl-Host-Code      AS INTEGER NO-UNDO INITIAL 0.
     2693   DEFINE VARIABLE i-gl-Contract-Code  AS INTEGER NO-UNDO INITIAL 0.
     2694   DEFINE VARIABLE i-gl-Extent3        AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
     2695   FUNCTION Can-Find-Spec RETURN LOGICAL (
     2696      INPUT iHost-Code    AS INTEGER,
     2697      INPUT iContract-Num AS INTEGER,
     2698      INPUT iGds-Code     AS INTEGER ):
     2699      DEFINE BUFFER buf_Spec FOR ub.Contract-Specif.
     2700      DEFINE VARIABLE iTmp-Host-Code     AS INTEGER NO-UNDO INITIAL 0.
     2701      DEFINE VARIABLE iTmp-Contract-Num  AS INTEGER NO-UNDO INITIAL 0.
     2702      DEFINE VARIABLE iTmp-Extent3       AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
     2703      DEFINE VARIABLE lRet               AS LOGICAL NO-UNDO INITIAL FALSE.
     2704      RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
     2705          INPUT  iHost-Code,
     2706          INPUT  iContract-Num,
     2707          OUTPUT iTmp-Extent3
     2708          ).
     2709      IF iTmp-Extent3[1] = 2 THEN DO:
     2710         ASSIGN
     2711            iTmp-Host-Code      = iTmp-Extent3[2]
     2712            iTmp-Contract-Num   = iTmp-Extent3[3]
     2713            .
     2714      END. ELSE DO:
     2715         ASSIGN
     2716            iTmp-Host-Code      = iHost-Code
     2717            iTmp-Contract-Num   = iContract-Num
     2718            .
     2719      END.
     2720      IF iGds-Code = ? THEN DO:
     2721         ASSIGN
     2722            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
     2723                                  buf_Spec.Host-Code     = iTmp-Host-Code
     2724                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
     2725                           ).
     2726      END. ELSE DO:
     2727            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
     2728                                  buf_Spec.Host-Code     = iTmp-Host-Code
     2729                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
     2730                              AND buf_Spec.Gds-Code      = iGds-Code
     2731                            ).
     2732      END.
     2733      RETURN (lRet).
     2734   END FUNCTION.
     2735   PROCEDURE MS-Contract-EXTENT-3:
     2736      DEFINE INPUT  PARAMETER i-Host-Code     AS INTEGER NO-UNDO.
     2737      DEFINE INPUT  PARAMETER i-Contract-Code AS INTEGER NO-UNDO.
     2738      DEFINE OUTPUT PARAMETER i-Ret           AS INTEGER NO-UNDO EXTENT 3 INITIAL 0.
     2739      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-Classif.
     2740      DEFINE BUFFER buf_Cont        FOR ub.Contract.
     2741      DEFINE BUFFER buf_Cont-2      FOR ub.Contract.
     2742      FIND FIRST buf_Cont-2 WHERE
     2743                 buf_Cont-2.Host-Code      = i-Host-Code
     2744             AND buf_Cont-2.Contract-Code  = i-Contract-Code
     2745           NO-LOCK NO-ERROR.
     2746      IF NOT AVAILABLE buf_Cont-2 THEN DO:
     2747         RETURN.
     2748      END.
     2749      FOR FIRST buf_Ext-Classif WHERE
     2750                buf_Ext-Classif.Classif-name = v-S_CONTRACT
     2751           AND  buf_Ext-Classif.CharKey_One  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     2752                                               STRING(i-Contract-code)
     2753           AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     2754          NO-LOCK,
     2755          EACH buf_Cont WHERE
     2756               buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
     2757           AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     2758          NO-LOCK:
     2759          ASSIGN
     2760             i-Ret[1] = 1
     2761             i-Ret[2] = buf_Cont.Host-code
     2762             i-Ret[3] = buf_Cont.Contract-code
     2763             .
     2764          LEAVE.
     2765      END.
     2766      IF i-Ret[1] <> 1 THEN DO:
     2767         FOR FIRST buf_Ext-Classif WHERE
     2768                   buf_Ext-Classif.Classif-name = v-S_CONTRACT
     2769              AND  buf_Ext-Classif.CharKey_Two  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     2770                                                  STRING(i-Contract-code)
     2771              AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     2772             NO-LOCK,
     2773             EACH buf_Cont WHERE
     2774                  buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     2775              AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     2776             NO-LOCK:
     2777             ASSIGN
     2778                i-Ret[1] = 2
     2779                i-Ret[2] = buf_Cont.Host-code
     2780                i-Ret[3] = buf_Cont.Contract-code
     2781                .
     2782             LEAVE.
     2783         END.
     2784      END.
     2785      RETURN.
     2786   END PROCEDURE.
