     4612       new_vat-pc = new_vat-pc + string(local_vat-pc) + chr(4) .
     4613       new_round  = new_round  + string(p-increase-pc) + "% " +  string(p-round-method) + "^" +  string(p-round-base)   + chr(4) .
     4614       loc_round  = string(p-increase-pc) + "% " +  string(p-round-method) + "^" +  string(p-round-base)  .
     4615       find current buf_price-doc-forming no-lock no-error .
     4616       if not available buf_price-doc-forming then do:
     4617        message
     4618          vss-workfile vss-revision vss-description skip
     4619          error-status :get-message(1) skip
     4620          return-value skip
