     7676   procedure main-road-taxs :
     7677   define input param p-artic     like ub.gds-obj.artic     no-undo .
     7678   define input param p-prod-type like ub.gds-obj.prod-type no-undo .
     7679   define input param p-prod-code like ub.gds-obj.prod-code no-undo .
     7680   define input-output param p-road-tax-base as decimal no-undo .
     7681   define input-output param p-road-tax-rubl as decimal no-undo .
     7682       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     7683       define buffer   in-vatp-parts    for ub.parts   .
     7684       define buffer   in-vatp-doc      for ub.trn-doc .
     7685       define buffer   in-vatp-goods    for ub.goods   .
     7686       define buffer   in-vatp-sysconf  for ub.sysconf .
     7687       define buffer   in-vatp_doc-attr for ub.doc-attr.
     7688       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     7689       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     7690       define variable varinvprb                  as   character              no-undo.
     7691       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     7692       define variable cli-base-rate              as   decimal                no-undo.
     7693       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     7694       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     7695       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     7696       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     7697       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     7698       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     7699       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     7700       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     7701       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     7702       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     7703       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     7704       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     7705       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     7706       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     7707       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     7708       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     7709       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     7710       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     7711       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     7712       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     7713       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     7714       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     7715       define variable varinvatp-envd             as   character              no-undo.
     7716       define variable varinvatp-type             as   character              no-undo.
     7717     do
     7718     on error undo, return error return-value
     7719     :
     7720   define buffer buff-goods   for ub.goods    .
     7721   define buffer buf_gds-obj  for ub.gds-obj  .
     7722   define buffer buf_parts    for ub.parts    .
     7723   define buffer buf_trn-doc  for ub.trn-doc  .
     7724   define buffer buf_doc-line for ub.doc-line .
     7725   define variable is-petrolium as logical   no-undo .
     7726   define variable is-pieces   as  logical   no-undo .
     7727   define variable p-in-code   as  character no-undo .
     7728   define variable p-obj-type  as  character no-undo .
     7729   define variable p-obj-code  as  integer   no-undo .
     7730   define variable v-rec as recid no-undo .
     7731   define variable t-ret as logical no-undo .
     7732   define variable v-total-avrg-base as decimal no-undo .
     7733   define variable v-total-avrg-rubl as decimal no-undo .
     7734   define variable v-total-avrg-qnty as decimal no-undo .
     7735   define variable v-total-road-tax-base     as decimal no-undo .
     7736   define variable v-total-road-tax-rubl     as decimal no-undo .
     7737   define variable v-all-total-road-tax-base as decimal no-undo .
     7738   define variable v-all-total-road-tax-rubl as decimal no-undo .
     7739   assign
     7740     p-road-tax-base = 0
     7741     p-road-tax-rubl = 0
     7742     .
     7743     Find first buff-goods no-lock where
     7744                buff-goods.artic     = p-artic and
     7745                buff-goods.prod-type = p-prod-type and
     7746                buff-goods.prod-code = p-prod-code
     7747         no-error .
     7748         if available buff-goods then do:
     7749            v-rec = recid (buff-goods).
     7750            t-ret =  session:SET-WAIT-STATE("GENERAL") .
     7751   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     7752     (
     7753        input p-artic
     7754     ,  input p-prod-type
     7755     ,  input p-prod-code
     7756     , output is-petrolium
