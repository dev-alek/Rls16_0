     4270       find first ub.contract-specif-attr exclusive-lock  where
     4271                 ub.contract-specif-attr.contract-num = p-contract-num  and
     4272                 ub.contract-specif-attr.host-code    = p-host-code     and
     4273                 ub.contract-specif-attr.gds-code     = p-gds-code      and
     4274                 ub.contract-specif-attr.attr-code    = "retro-bonus"
     4275                 no-error .
