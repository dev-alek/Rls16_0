    10077      end.
    10078   ASSIGN
    10079             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
    10080       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
    10081   .
    10082                         Assign
    10083                             p-road-tax-rubl =  road-tax-rubl-loc
    10084                             p-road-tax-base =  road-tax-base-loc
    10085                             .
    10086                         end.
    10087       end.
    10088   end procedure.
    10089   define temp-table temp-pdf no-undo like ub.price-doc-forming-gds .
    10090   define temp-table temp-tt no-undo
    10091   field b-code as integer
    10092   field gds-code as integer
    10093   field price-sale as decimal
    10094   index pi b-code.
    10095   define variable v-current-doc-code as character no-undo .
    10096   define variable v-current-host-code as integer no-undo .
    10097   define variable v-current-obj-type as character no-undo .
    10098   define variable v-current-obj-code as integer no-undo .
    10099   define variable v-current-lock as integer no-undo .
    10100   define variable v-current-wait as integer no-undo .
    10101   define variable v-current-pdf-id as integer no-undo .
    10102   define variable v-current-pdf-db-num as integer no-undo .
    10103   define variable v-save as integer no-undo .
    10104   define variable v-esys-cmd-proc-handle as handle no-undo .
    10105   define variable v-esys-cmd-code as integer no-undo .
    10106   define variable log-file-name                as character      no-undo init "pdf-clos.txt".
    10107   define variable v-view-log                   as logical        no-undo .
    10108   define variable v-stop                       as logical        no-undo .
    10109   define variable v-current-db-num as integer no-undo .
    10110   define variable v-last-error-message as character no-undo .
    10111   define variable vartemp-char as character no-undo .
    10112   define variable file-name as char.
    10113   define variable v-sign as integer no-undo .
    10114   define variable num-rec as integer no-undo .
    10115   define variable num-rec-ok as integer no-undo .
    10116   define variable v-type as character no-undo .
    10117   define variable l-res as integer no-undo .
    10118   define variable v-es as logical no-undo .
    10119   define variable v-esm as character no-undo .
    10120   define variable v-rv as character no-undo .
    10121   define variable v-code-attr as character no-undo .
    10122   define variable vss-include-info95 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10123   procedure write-to-screen :
    10124   define input param p-str as character no-undo .
    10125   run write-log-and-file in p-log-handle (
    10126         input 1
    10127       , input log-file-name
    10128       , input 1
    10129       , input p-str).
    10130   end procedure.
    10131   procedure write-to-log :
    10132   define input param p-str as character no-undo .
    10133   run write-log-and-file in p-log-handle (
    10134         input 1
    10135       , input log-file-name
    10136       , input 1
    10137       , input p-str).
    10138   end procedure.
    10139   procedure write-to-log-notime :
    10140   define input param p-str as character no-undo .
    10141   run write-log-and-file in p-log-handle (
    10142         input 1
    10143       , input log-file-name
    10144       , input 1
    10145       , input p-str).
    10146   end procedure.
    10147   define variable vss-include-info96 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10148   procedure set-error :
    10149   define input parameter p-mess as character no-undo .
    10150     do
    10151     on error undo, return error
    10152     :
    10153        assign
    10154        v-last-error-message = p-mess.
    10155     end.
    10156   end procedure.
    10157   define buffer buf_temp-cmd for temp-cmd.
    10158     define variable p-tpl as character no-undo.
    10159     define variable p-coeff as decimal no-undo .
    10160   on delete of this-procedure do:
    10161     run garbcoll_clear in this-procedure .
    10162   end.
    10163   run load-ruleset-context in this-procedure ( input p-ruleset-id) no-error.
    10164   if error-status:error then do:
    10165     undo, return error return-value .
    10166   end.
    10167   if not this-procedure:persistent then do:
    10168     run proc-main in this-procedure no-error .
    10169     if error-status:error then do:
    10170       v-esm = error-status :get-message (1).
    10171       v-es = error-status:error .
    10172       v-rv = return-value .
    10173     end.
    10174   define variable vss-include-info97 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10175   if v-view-log
    10176   and not g#news
    10177   and not g#auto
    10178   then do:
    10179     message
    10180     '!!!При выполнении произошли ошибки!!!'  skip
    10181     "!!!Внимательно прочитайте Log-file!!"
    10182     view-as alert-box error .
    10183        define variable v-user-action98   as character no-undo .
    10184     define variable v-printed98       as logical   no-undo .
    10185     run gbl/prnfilen.w
    10186       (input  ('!!!При выполнении произошли ошибки!!!')
    10187       ,input  0
    10188       ,input  (string("./":U) + log-file-name)
    10189       ,input  7
    10190       ,output v-user-action98
    10191       ,output v-printed98
    10192       ) .
    10193   end.
    10194   if v-view-log = true
    10195   and (g#news
    10196   or g#auto)
    10197   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
    10198   then do:
    10199      run cb_set-view-log in p-parent-handle ( input yes).
    10200   end.
    10201     if v-es then do:
    10202         run garbcoll_clear in this-procedure .
    10203         undo, return error substitute( "&1. &2&3&4", vss-workfile, v-rv, chr(10), v-esm).
    10204     end.
    10205     run garbcoll_clear in this-procedure .
    10206   end.
    10207   procedure proc-main :
    10208   _main:
    10209   do
    10210   on error undo, return error substitute( "&1&2&3&2&4", return-value, chr(10), error-status :get-message (1), v-last-error-message)
    10211   :
    10212     define variable v-ii as integer no-undo .
    10213     define variable v-loc-file-name as character no-undo .
    10214     define variable v-err as logical no-undo .
    10215     define variable v-success as logical   no-undo .
    10216     run write-log  in p-log-handle (
    10217                                     input 0
    10218                                   , "&DLine").
    10219   define variable v-is-n as logical   no-undo .
    10220   define buffer ver_price-doc  for ub.price-doc  .
    10221   define buffer ver_price-list for ub.price-list  .
    10222     for each pdf-list :
    10223       v-is-n = false .
    10224       for each ver_price-doc no-lock where
    10225                ver_price-doc.pdf-id      = pdf-list.pdf-id    and
    10226                ver_price-doc.pdf-db      = pdf-list.pdf-db    and
    10227                ver_price-doc.plt-id      = pdf-list.plt-id    and
    10228                ver_price-doc.plt-db-num  = pdf-list.plt-db-num
    10229                :
    10230        for each ver_price-list no-lock where
    10231                 ver_price-list.doc-num =  ver_price-doc.doc-num and
    10232                 ver_price-list.main-price = false
    10233                 :
    10234                 v-is-n  = true .
    10235         end.
    10236       end.
    10237    end.
    10238     if v-is-n = false then return .
    10239       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute(".............Скидочные ДНЦ")).
    10240     _stroka:
    10241     for each pdf-list
    10242     On error undo _stroka, next _stroka
    10243     :
    10244     v-is-n = false .
    10245     for each ver_price-doc no-lock where
    10246               ver_price-doc.pdf-id     = pdf-list.pdf-id     and
    10247               ver_price-doc.pdf-db     = pdf-list.pdf-db     and
    10248               ver_price-doc.plt-id     = pdf-list.plt-id     and
    10249               ver_price-doc.plt-db-num = pdf-list.plt-db-num :
    10250           for each ver_price-list no-lock where
    10251                     ver_price-list.doc-num =  ver_price-doc.doc-num and
    10252                     ver_price-list.main-price = false
    10253                     :
    10254                     v-is-n  = true .
    10255             end.
    10256     end.
    10257     if v-is-n = false then next .
    10258       assign
    10259       v-current-pdf-id     = pdf-list.pdf-id
    10260       v-current-pdf-db-num = pdf-list.pdf-db
    10261       num-rec = num-rec + 1
    10262       .
    10263           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute ("Обработка ДНЦ &1 &2", pdf-list.pdf-id , pdf-list.pdf-db)).
    10264       if v-err then next.
    10265        run exec-proc ( pdf-list.pdf-id , pdf-list.pdf-db , pdf-list.plt-id , pdf-list.plt-db-num ) no-error .
    10266        if error-status :error then do:
    10267           undo, return error return-value .
    10268        end.
    10269        release pdf-list.
    10270       num-rec-ok = num-rec-ok + 1.
    10271       run write-counter  in p-log-handle ( input substitute("Обработано ДНЦ списка : &1, из них удачно: &2", num-rec, num-rec-ok )).
    10272       run get-stop-state in p-log-handle ( output v-stop) no-error .
    10273       if v-stop then do:
    10274                   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Процесс прерван пользователем")).
    10275           leave _stroka.
    10276       end.
    10277     end.
    10278       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Обработано ДНЦ списка : &1, из них удачно: &2", num-rec, num-rec-ok)).
    10279   end.
    10280   end procedure.
    10281   procedure load-ruleset-context :
    10282   define input parameter p-ruleset-id as integer no-undo .
    10283   define buffer buf_rule-call-param for ub.rule-call-param.
    10284     do
    10285     on error undo, return error
    10286     :
    10287     find first buf_rule-call-param no-lock where
    10288   buf_rule-call-param.codex_id = p-codex-id
    10289   and buf_rule-call-param.ruleset_id = p-ruleset-id
    10290   and buf_rule-call-param.call_id = p-call-id
    10291   and buf_rule-call-param.order_id = p-order-id
    10292   and buf_rule-call-param.rule_id = p-rule-id
    10293   and buf_rule-call-param.param-name = "p-tpl"
    10294    no-error.
    10295   if available buf_rule-call-param then do:
    10296   assign p-tpl = buf_rule-call-param.param-value-character.
    10297   end.
    10298     find first buf_rule-call-param no-lock where
    10299   buf_rule-call-param.codex_id = p-codex-id
    10300   and buf_rule-call-param.ruleset_id = p-ruleset-id
    10301   and buf_rule-call-param.call_id = p-call-id
    10302   and buf_rule-call-param.order_id = p-order-id
    10303   and buf_rule-call-param.rule_id = p-rule-id
    10304   and buf_rule-call-param.param-name = "p-coeff"
    10305    no-error.
    10306   if available buf_rule-call-param then do:
    10307      assign p-coeff = buf_rule-call-param.param-value-decimal.
    10308   end.
    10309       case p-ruleset-id:
    10310         when 1
    10311         then do:
    10312           assign
    10313           v-current-host-code = p-host-code
    10314           v-current-obj-type = p-obj-type
    10315           v-current-obj-code = p-obj-code
    10316           v-current-db-num = g#db-num
    10317           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
    10318           .
    10319         end.
    10320       end case.
    10321     end.
    10322   end procedure.
    10323   procedure exec-proc :
    10324   define input  parameter p-pdf-id     as integer   no-undo .
    10325   define input  parameter p-pdf-db     as integer   no-undo .
    10326   define input  parameter p-plt-id     as integer   no-undo .
    10327   define input  parameter p-plt-db-num as integer   no-undo .
    10328   define buffer buf_pdf-gds for ub.price-doc-forming-gds  .
    10329   define buffer buf_price-doc for ub.price-doc  .
    10330   define buffer buf_price-list-type for ub.price-list-type  .
    10331   define variable v-dis-plt-id as integer   no-undo .
    10332   define variable v-dis-plt-db as integer   no-undo .
    10333   define variable v-exs-obj as logical   no-undo .
    10334   do
    10335     on error undo, return error return-value
    10336     :
    10337       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Формирование скидочных ДНЦ по ТПЛ &1" , p-tpl)).
    10338     assign
    10339       v-dis-plt-id = int(entry(1,p-tpl,"-"))
    10340       v-dis-plt-db = int(entry(2,p-tpl,"-"))
    10341     no-error .
    10342       if p-coeff = 0  or p-coeff = ? then do:
    10343                   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не верно задан коэффициент в настройках машины правил"  )).
    10344           return error return-value .
    10345       end.
    10346       find first buf_price-list-type no-lock where
    10347                  buf_price-list-type.plt-id = v-dis-plt-id and
    10348                  buf_price-list-type.plt-db = v-dis-plt-db no-error .
    10349        if error-status :error then do:
    10350                   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не найден ТПЛ &1(&2)  для порождения ДНЦ :  &3 &4 "  ,v-dis-plt-id,v-dis-plt-db, return-value , error-status :get-message(1)  )).
    10351           return error return-value .
    10352        end.
    10353        if buf_price-list-type.stts  =  int('1':U)  then do:
    10354                   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("ТПЛ &1(&2) Удален !!! пропускаем "  ,v-dis-plt-id,v-dis-plt-db  )).
    10355           return  .
    10356        end.
    10357        run metod-gop-obj in this-procedure (
    10358           g#db-num ,
    10359           buf_price-list-type.gop-id   ,
    10360           buf_price-list-type.gop-db-num  ) no-error .
    10361           if error-status :error then do:
    10362                           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Сбор оъектов по  ТПЛ &1(&2) : &3 &4 "  ,v-dis-plt-id,v-dis-plt-db, return-value , error-status :get-message(1)  )).
    10363               return error return-value .
    10364           end.
    10365     v-exs-obj = false .
    10366     for each buf_price-doc no-lock where
    10367         buf_price-doc.pdf-id     = p-pdf-id    and
    10368         buf_price-doc.pdf-db     = p-pdf-db    and
    10369         buf_price-doc.plt-id     = p-plt-id    and
    10370         buf_price-doc.plt-db-num = p-plt-db-num :
    10371          find first x_obj-group where
    10372                     x_obj-group.obj-type = buf_price-doc.obj-type and
    10373                     x_obj-group.obj-code = buf_price-doc.obj-code no-error .
    10374           if available x_obj-group then do:
    10375              v-exs-obj = true .
    10376              leave.
    10377           end.
    10378      end.
    10379       if v-exs-obj = false then do:
    10380                   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("По ТПЛ &1(&2) скидочные ДНЦ созданы не будут"  ,v-dis-plt-id,v-dis-plt-db, return-value , error-status :get-message(1)  )).
    10381           return .
    10382       end.
    10383     for each buf_price-doc no-lock where
    10384         buf_price-doc.pdf-id     = p-pdf-id    and
    10385         buf_price-doc.pdf-db     = p-pdf-db    and
    10386         buf_price-doc.plt-id     = p-plt-id    and
    10387         buf_price-doc.plt-db-num = p-plt-db-num :
    10388          find first x_obj-group where
    10389                     x_obj-group.obj-type = buf_price-doc.obj-type and
    10390                     x_obj-group.obj-code = buf_price-doc.obj-code no-error .
    10391           if not available x_obj-group then do:
    10392              next.
    10393           end.
    10394         empty temp-table temp-tt .
    10395         empty temp-table temp-pdf .
    10396         run create-pdf-from-tpl (buf_price-doc.doc-num,v-dis-plt-id,v-dis-plt-db) no-error .
    10397         if error-status :error then do:
    10398                   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Переоценка &1 -> Скидочный ТПЛ &2(&3): ошибка &4 &5" ,buf_price-doc.doc-num,v-dis-plt-id,v-dis-plt-db, return-value , error-status :get-message(1)  )).
    10399           return error return-value .
    10400         end.
    10401     end.
    10402   end.
    10403   end procedure.
    10404   procedure create-pdf-from-tpl :
    10405   define input  parameter p-doc-num as character no-undo .
    10406   define input  parameter p-dis-plt-id as integer   no-undo .
    10407   define input  parameter p-dis-plt-db as integer   no-undo .
    10408   define buffer buf_price-list for ub.price-list  .
    10409   define buffer buf_goods      for ub.goods  .
    10410   define buffer buf_bar-code   for ub.bar-code  .
    10411   define buffer neos_price-list for ub.price-list  .
    10412   define buffer neos_bar-code   for ub.bar-code  .
    10413   define buffer buf_price-doc for ub.price-doc  .
    10414   define buffer buf_doc-attr for ub.doc-attr  .
    10415   define variable v-cli-base-rate      as decimal   no-undo .
    10416   define variable v-price-cli-base-rate as decimal   no-undo .
    10417   define variable v-new-price-sale as decimal   no-undo .
    10418   define variable v-pdf-id     as integer   no-undo .
    10419   define variable v-pdf-db-num as integer   no-undo .
    10420   define variable v-str as character no-undo .
    10421     do
    10422     on error undo, return error return-value
    10423     :
    10424     find first  buf_price-doc no-lock where
    10425                 buf_price-doc.doc-num   =  p-doc-num no-error .
    10426      for each buf_price-list no-lock where
    10427               buf_price-list.doc-num   =  p-doc-num and
    10428               buf_price-list.main-price = true ,
    10429         first buf_bar-code no-lock where
    10430               buf_bar-code.b-code = buf_price-list.b-code ,
    10431         first buf_goods no-lock where
    10432               buf_goods.gds-code = buf_bar-code.gds-code :
    10433               v-cli-base-rate  = 0 .
    10434               v-price-cli-base-rate  = 0 .
    10435               for each neos_price-list no-lock where
    10436                        neos_price-list.doc-num    =  p-doc-num and
    10437                        neos_price-list.artic     = buf_goods.artic and
    10438                        neos_price-list.prod-type = buf_goods.prod-type and
    10439                        neos_price-list.prod-code = buf_goods.prod-code and
    10440                        neos_price-list.main-price = false  ,
    10441                   first neos_bar-code no-lock where
    10442                         neos_bar-code.b-code     = neos_price-list.b-code and
    10443                         neos_bar-code.unit-cli   <> buf_goods.unit-base
    10444                         by neos_bar-code.cli-base-rate descending
    10445                         by neos_price-list.price-sale    :
    10446                           v-cli-base-rate        = neos_bar-code.cli-base-rate.
    10447                           v-price-cli-base-rate  = neos_price-list.price-sale.
    10448                           leave .
    10449              end.
    10450           if v-cli-base-rate  = 0 or  v-price-cli-base-rate  = 0 then next.
    10451           v-new-price-sale = p-coeff * ( v-price-cli-base-rate / v-cli-base-rate ) .
    10452           run new-pdf-line-tt ( buf_price-list.b-code , v-new-price-sale, buf_goods.gds-code ) .
    10453       end.
    10454       define buffer bbb_price-doc-forming-gds for ub.price-doc-forming-gds  .
    10455       for each bbb_price-doc-forming-gds no-lock where
    10456                bbb_price-doc-forming-gds.plt-id = buf_price-doc.plt-id and
    10457                bbb_price-doc-forming-gds.plt-db = buf_price-doc.plt-db and
    10458                bbb_price-doc-forming-gds.pdf-db = buf_price-doc.pdf-db and
    10459                bbb_price-doc-forming-gds.pdf-id = buf_price-doc.pdf-id ,
    10460          first buf_price-list no-lock where
    10461                buf_price-list.doc-num    = buf_price-doc.doc-num and
    10462                buf_price-list.b-code     = bbb_price-doc-forming-gds.b-code  and
    10463                buf_price-list.price-type = ""                    and
    10464                buf_price-list.main-price = false
    10465                :
    10466              create temp-pdf.
    10467              buffer-copy bbb_price-doc-forming-gds to temp-pdf .
    10468       end.
    10469       run new-pdf (
    10470             input buf_price-doc.doc-num
    10471           , input  p-dis-plt-id
    10472           , input  p-dis-plt-db
    10473           , output v-pdf-id
    10474           , output v-pdf-db-num
    10475           ) no-error .
    10476         if error-status :error then do:
    10477                   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при создании   ДНЦ: &1(&2) &3 &4 ",v-pdf-id, v-pdf-db-num, return-value , error-status :get-message(1))) .
    10478           undo, return error return-value .
    10479         end.
    10480       run make-attr-objexcl (
    10481             v-pdf-id
    10482           , v-pdf-db-num
    10483           , p-dis-plt-id
    10484           , p-dis-plt-db
    10485           , buf_price-doc.obj-type
    10486           , buf_price-doc.obj-code   ).
    10487           v-str = string(p-dis-plt-id) + "," + string(p-dis-plt-dB) + "," + string(v-pdf-id) + "," + string(v-pdf-db-num) .
    10488           v-code-attr =  'relprpdf':U + chr(4) + string(p-dis-plt-id) + chr(4) + string(p-dis-plt-dB) .
    10489       find first buf_doc-attr exclusive-lock where
    10490                  buf_doc-attr.doc-code  = buf_price-doc.doc-num and
    10491                  buf_doc-attr.attr-code = v-code-attr no-error.
    10492       if not available buf_doc-attr then do:
    10493         create buf_doc-attr.
    10494         assign buf_doc-attr.doc-code  = buf_price-doc.doc-num
    10495                buf_doc-attr.attr-code = v-code-attr .
    10496       end.
    10497       assign buf_doc-attr.attr-value = v-str.
    10498   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdatothn in g#trdcalib ( input buf_price-doc.doc-num ,
    10499                          input v-code-attr
    10500                          ) no-error .
    10501         if error-status :error then do:
    10502                   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при обработке атрибута  ДНЦ: &1(&2) переоценка :&3 &4 &5 &6",v-pdf-id, v-pdf-db-num, buf_price-doc.doc-num , return-value , error-status :get-message(1) , v-code-attr)) .
    10503           undo, return error return-value .
    10504         end.
    10505               run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Создано ДНЦ &1(&2)", v-pdf-id, v-pdf-db-num )).
    10506     end.
    10507   end procedure.
    10508   procedure make-attr-objexcl :
    10509   define input  parameter p-pdf-id     as integer   no-undo .
    10510   define input  parameter p-pdf-db-num as integer   no-undo .
    10511   define input  parameter p-plt-id     as integer   no-undo .
    10512   define input  parameter p-plt-db-num as integer   no-undo .
    10513   define input  parameter p-obj-type   as character no-undo .
    10514   define input  parameter p-obj-code   as integer   no-undo .
    10515   define buffer buf_x_obj-group for x_obj-group  .
    10516     do
    10517     on error undo, return error return-value
    10518     :
    10519         for each  buf_x_obj-group no-lock where
    10520         NOT ( buf_x_obj-group.obj-code = p-obj-code and
    10521               buf_x_obj-group.obj-type = p-obj-type  ) :
    10522         run ins-pdf-attr-objdel (
    10523             p-pdf-id ,
    10524             p-pdf-db-num ,
    10525             p-plt-id     ,
    10526             p-plt-db-num ,
    10527             buf_x_obj-group.obj-type ,
    10528             buf_x_obj-group.obj-code
    10529             ) .
    10530          end.
    10531     end.
    10532   end procedure.
    10533   procedure new-pdf-line-tt :
    10534   define input  parameter p-b-code   as integer   no-undo .
    10535   define input  parameter p-price-sale as decimal   no-undo .
    10536   define input  parameter p-gds-code   as integer   no-undo .
    10537     do
    10538     on error undo, return error return-value
    10539     :
    10540       create temp-tt.
    10541       assign
    10542         temp-tt.gds-code   = p-gds-code
    10543         temp-tt.b-code     = p-b-code
    10544         temp-tt.price-sale = p-price-sale
    10545       .
    10546     end.
    10547   end procedure.
    10548   procedure new-pdf :
    10549   define input  parameter p-doc-code as character no-undo .
    10550   define input  parameter p-dis-plt-id as integer   no-undo .
    10551   define input  parameter p-dis-plt-db as integer   no-undo .
    10552   define output parameter p-pdf-id     as integer   no-undo .
    10553   define output parameter p-pdf-db-num as integer   no-undo .
    10554   define variable v-counter as integer   no-undo .
    10555   define variable v-sec as integer   no-undo .
    10556   define buffer buf_goods for ub.goods  .
    10557     do
    10558     on error undo, return error return-value
    10559     :
    10560            assign
    10561             p-pdf-id     = next-value ( s-pdf , ub)
    10562             p-pdf-db-num = g#db-num
    10563            .
    10564            find first ub.price-list-type no-lock where
    10565                       ub.price-list-type.plt-id = p-dis-plt-id and
    10566                       ub.price-list-type.plt-db = p-dis-plt-db  no-error .
    10567            if error-status :error then do:
    10568                                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("4. ошибка &1 &2", return-value,  error-status :get-message(1) )).
    10569                     return error return-value .
    10570            end.
    10571            create ub.price-doc-forming .
    10572            assign
    10573               ub.price-doc-forming.plt-id       = p-dis-plt-id
    10574               ub.price-doc-forming.plt-db-num   = p-dis-plt-db
    10575               ub.price-doc-forming.pdf-id       = p-pdf-id
    10576               ub.price-doc-forming.pdf-db       = p-pdf-db-num
    10577               ub.price-doc-forming.stts         = integer('0':U)
    10578               ub.price-doc-forming.sys-date     = today
    10579               ub.price-doc-forming.sys-time     = time
    10580               ub.price-doc-forming.sys-time-chr = string ( ub.price-doc-forming.sys-time , "hh:mm" )
    10581               ub.price-doc-forming.who          = g#userid
    10582               ub.price-doc-forming.des          = substitute("Скидочный ДНЦ по шаблону скидок &1 cоздан по ПЕРЕОЦЕНКЕ &2 по неосновным кодам " ,ub.price-list-type.ban-discnt , p-doc-code)
    10583               ub.price-doc-forming.name         = substitute("Скидочный ДНЦ:&1 cоздан по ПЕРЕОЦЕНКЕ &2" ,ub.price-list-type.ban-discnt , p-doc-code)
    10584               ub.price-doc-forming.main-pdf-id  = ub.price-doc-forming.pdf-id
    10585               ub.price-doc-forming.main-pdf-db  = ub.price-doc-forming.pdf-db
    10586               ub.price-doc-forming.out-code     = p-doc-code
    10587            .
    10588      find first buf_price-doc-forming  exclusive-lock where recid (buf_price-doc-forming) =  recid ( ub.price-doc-forming ) no-error .
    10589         if error-status :error then do:
    10590                   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("3. ошибка &1 &2", return-value,  error-status :get-message(1) )).
    10591           return error return-value .
    10592         end.
    10593       v-counter = 0.
    10594       for each temp-tt :
    10595           v-counter = v-counter + 1.
    10596           find first buf_goods no-lock where buf_goods.gds-code = temp-tt.gds-code .
    10597           run create-line-pdf-mpl-lib (
    10598                input buf_price-doc-forming.plt-db-num
    10599               ,input buf_price-doc-forming.plt-id
    10600               ,input buf_price-doc-forming.pdf-db
    10601               ,input buf_price-doc-forming.pdf-id
    10602               ,input v-counter
    10603               ,input temp-tt.b-code
    10604               ,input buf_goods.artic
    10605               ,input buf_goods.prod-type
    10606               ,input buf_goods.prod-code
    10607               ,input ""
    10608               ,input 0
    10609               ,input temp-tt.price-sale
    10610               ,input ""
    10611               ,input 0
    10612               ,input-output v-sec ) no-error .
    10613                   if error-status :error then do:
    10614                                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("1. ошибка &1 &2", return-value,  error-status :get-message(1) )).
    10615                     return error return-value .
    10616                   end.
    10617       end.
    10618       for each temp-pdf :
    10619           v-counter = v-counter + 1.
    10620           create ub.price-doc-forming-gds.
    10621           buffer-copy temp-pdf to ub.price-doc-forming-gds
    10622           assign
    10623             ub.price-doc-forming-gds.plt-db-num = buf_price-doc-forming.plt-db-num
    10624             ub.price-doc-forming-gds.plt-id     = buf_price-doc-forming.plt-id
    10625             ub.price-doc-forming-gds.pdf-db     = buf_price-doc-forming.pdf-db
    10626             ub.price-doc-forming-gds.pdf-id     = buf_price-doc-forming.pdf-id
    10627             ub.price-doc-forming-gds.line-num   = v-counter
    10628           .
    10629       end.
    10630       ub.price-doc-forming.stts  = integer('4':U).
    10631       release buf_price-doc-forming no-error .
    10632         if error-status :error then do:
    10633                   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("2. ошибка &1 &2", return-value,  error-status :get-message(1) )).
    10634           return error return-value .
    10635         end.
    10636     end.
    10637   end procedure.
