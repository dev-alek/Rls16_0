     7957                   vat-rubl-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / buf_doc-line.fact-qnty   else 0
     7958           slt-rubl-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / buf_doc-line.fact-qnty   else 0
     7959           vat-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc)))
     7960           slt-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))).
     7961         if road-tax-base-loc  = ? then road-tax-base-loc  = 0.
     7962         if road-tax-rubl-loc  = ? then road-tax-rubl-loc  = 0.
     7963         if transport-base-loc = ? then transport-base-loc = 0.
     7964         if transport-rubl-loc = ? then transport-rubl-loc = 0.
     7965         if other-base-loc     = ? then other-base-loc     = 0.
     7966         if other-rubl-loc     = ? then other-rubl-loc     = 0.
     7967         assign
     7968           transport-cli-loc      = 0
     7969           other-cli-loc          = 0
     7970           road-tax-cli-loc       = ?
     7971           vat-cli-loc            = ?
     7972           slt-cli-loc            = ?
     7973           price-cli-with-tax-loc = ?.
     7974      end.
     7975   ASSIGN
     7976             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     7977       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     7978   .
     7979                 assign
     7980                   p-road-tax-rubl =  road-tax-rubl-loc
     7981                   p-road-tax-base =  road-tax-base-loc
     7982                   .
     7983               end.
     7984         end.
     7985     end.
     7986   end procedure.
     7987   procedure calc-sigma :
     7988    do
     7989    on error undo, return error return-value
     7990    :
     7991   define input parameter l-bcode like ub.price-list.b-code no-undo .
     7992   define input-output parameter new-price as decimal no-undo .
     7993   define input parameter l-host as integer no-undo .
     7994   define input parameter l-code as integer no-undo .
     7995   define input parameter l-type as character no-undo .
     7996   define output parameter p-ret as logical no-undo .
     7997   define variable conf-par     as character no-undo.
     7998   define variable par-type     as character no-undo.
     7999   define variable i-sigma as decimal no-undo .
     8000   define variable cur-pr like ub.price-list.price-sale no-undo.
     8001   define variable cur-rt like ub.price-list.road-tax   no-undo.
     8002   define variable cur-ex like ub.price-list.excise     no-undo.
     8003   define variable cur-dn like ub.price-list.doc-num    no-undo.
     8004   define variable old-price as decimal no-undo .
     8005   p-ret = true  .
     8006   if par-pr-sigma <> ? and par-pr-sigma <> "" and par-pr-sigma <> "0" then do:
     8007   define variable vss-include-info73 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8008   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     8009     (input  l-type
     8010     ,input  l-code
     8011     ,input  l-bcode
     8012     ,input  0
     8013     ,input  0
     8014     ,output cur-dn
     8015     ,output cur-pr
     8016     ,output cur-rt
     8017     ,output cur-ex
     8018     )  .
     8019   old-price = cur-pr .
     8020   if old-price =  new-price then do:
     8021      p-ret = true .
     8022      return.
     8023   end.
     8024      i-sigma = decimal(par-pr-sigma) .
     8025      if ( 100 * ABSOLUTE( old-price - new-price ) / old-price ) <= i-sigma then do:
     8026          p-ret = false .
     8027          new-price = old-price.
     8028          end.
     8029      else p-ret = true .
     8030   end.
     8031    end.
     8032   end procedure.
     8033   define variable vss-include-info74 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8034   define variable var-pr-r-b as character no-undo .
     8035   define variable v-str2 as character no-undo .
     8036   define variable vss-include-info75 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     8037   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     8038     (output var-pr-r-b
     8039     )  .
     8040   function f-base-code return integer ( p-b-code as integer ).
     8041     define variable main-b-code as integer   no-undo .
     8042     define buffer buf_bar-code for ub.bar-code  .
     8043     find first buf_bar-code no-lock where
     8044               buf_bar-code.b-code = p-b-code no-error .
     8045   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     8046     (input  buf_bar-code.gds-code
     8047     ,input  ?
     8048     ,output main-b-code
     8049     )  .
     8050     return (main-b-code).
     8051   end function.
     8052   function fnc-cost-pc return decimal (buffer local-price-list for ub.price-doc-forming-gds ).
     8053     define variable f-cost     as decimal no-undo .
     8054     define variable f-cost-pc  as decimal no-undo .
     8055     define variable v-qnty     as decimal no-undo .
     8056     define variable v-sum      as decimal no-undo .
     8057     define variable fact_price as decimal no-undo .
     8058     find first ub.goods where ub.goods.artic     = local-price-list.artic and
     8059                               ub.goods.prod-type = local-price-list.prod-type and
     8060                               ub.goods.prod-code = local-price-list.prod-code no-lock
     8061                               no-error .
     8062     assign
     8063       v-sum  =  0
     8064       v-qnty =  0
     8065       .
     8066     for each x_obj-group :
     8067         find ub.gds-obj no-lock where
     8068             ub.gds-obj.gds-code = ub.goods.gds-code and
     8069             ub.gds-obj.obj-type = x_obj-group.obj-type and
     8070             ub.gds-obj.obj-code = x_obj-group.obj-code no-error.
     8071         if  available ub.gds-obj then
     8072           if ub.goods.gds-type = 'т':U then
     8073             assign
     8074               v-sum  = v-sum  + ( if var-pr-r-b = "rubl" then ub.gds-obj.avrg-rubl else ub.gds-obj.avrg-base) * ub.gds-obj.avrg-qnty
     8075               v-qnty =  v-qnty + ub.gds-obj.avrg-qnty
     8076               .
     8077             else  v-sum = ?.
     8078         else v-sum = ?.
     8079     end.
     8080     f-cost = v-sum / v-qnty .
     8081     fact_price = if var-pr-r-b = "rubl" then local-price-list.price-sale-rubl else local-price-list.price-sale-base .
     8082     f-cost-pc = ( round ( fact_price / f-cost , 2 ) -  1 ) * 100.
     8083     return (f-cost-pc).
     8084   end function.
     8085   function fnc-pr-pc return decimal (buffer local-price-list for ub.price-doc-forming-gds ).
     8086   define variable f-pr     as decimal no-undo .
     8087   define variable f-pr-pc  as decimal no-undo.
     8088   define variable v-qnty as decimal   no-undo .
     8089   define variable v-sum as decimal   no-undo .
     8090   define variable fact_price as decimal   no-undo .
     8091   find first ub.goods where ub.goods.artic = local-price-list.artic and
     8092                          ub.goods.prod-type = local-price-list.prod-type and
     8093                          ub.goods.prod-code = local-price-list.prod-code no-lock  no-error .
     8094    assign
     8095      v-sum  =  0
     8096      v-qnty =  0
     8097      .
     8098   for each x_obj-group :
     8099   find ub.gds-obj no-lock where
     8100        ub.gds-obj.gds-code = ub.goods.gds-code and
     8101        ub.gds-obj.obj-type = x_obj-group.obj-type and
     8102        ub.gds-obj.obj-code = x_obj-group.obj-code  no-error .
     8103   if  available ub.gds-obj then do:
     8104     if ub.goods.gds-type = 'т':U then
     8105       assign
     8106         f-pr = (if var-pr-r-b = "rubl" then ub.gds-obj.last-rubl else ub.gds-obj.last-base)
     8107         .
     8108       else f-pr = ?.
     8109   end.
     8110   else f-pr = ?.
     8111   end.
     8112     fact_price = if var-pr-r-b = "rubl" then local-price-list.price-sale-rubl else local-price-list.price-sale-base .
     8113     f-pr-pc = ( round( fact_price / f-pr , 2 ) - 1 ) * 100 .
     8114     return (f-pr-pc).
     8115   end function.
     8116   function fnc-cost return decimal (buffer local-price-list for ub.price-doc-forming-gds).
     8117   define variable f-cost   as decimal no-undo .
     8118   find first  x_obj-group.
     8119   find first ub.goods where ub.goods.artic = local-price-list.artic and
     8120                          ub.goods.prod-type = local-price-list.prod-type and
     8121                          ub.goods.prod-code = local-price-list.prod-code no-lock  no-error .
     8122   find ub.gds-obj no-lock where
     8123        ub.gds-obj.gds-code = ub.goods.gds-code  and
     8124        ub.gds-obj.obj-type = x_obj-group.obj-type and
     8125        ub.gds-obj.obj-code = x_obj-group.obj-code
     8126        no-error.
     8127   if  available ub.gds-obj then
     8128     if ub.goods.gds-type = 'т':U then
     8129       assign
     8130         f-cost = if var-pr-r-b = "rubl" then ub.gds-obj.avrg-rubl else ub.gds-obj.avrg-base
     8131         .
     8132       else  f-cost = ?.
     8133   else f-cost = ?.
     8134     return ( f-cost ).
     8135   end function.
     8136   function fnc-pr return decimal (buffer local-price-list for ub.price-doc-forming-gds).
     8137   define variable f-pr   as decimal no-undo .
     8138   find first x_obj-group .
     8139   find first ub.goods where ub.goods.artic = local-price-list.artic and
     8140                          ub.goods.prod-type = local-price-list.prod-type and
     8141                          ub.goods.prod-code = local-price-list.prod-code no-lock  no-error .
     8142   find ub.gds-obj no-lock where
     8143        ub.gds-obj.gds-code = ub.goods.gds-code and
     8144        ub.gds-obj.obj-type = x_obj-group.obj-type and
     8145        ub.gds-obj.obj-code = x_obj-group.obj-code
     8146        no-error.
     8147   if  available ub.gds-obj then
     8148     if ub.goods.gds-type = 'т':U then
     8149       assign
     8150         f-pr = if var-pr-r-b = "rubl" then ub.gds-obj.last-rubl  else ub.gds-obj.last-base
     8151         .
     8152       else  f-pr = ?.
     8153   else f-pr = ?.
     8154      return ( f-pr ).
     8155   end function.
     8156   procedure make-fact-order-lib3 :
     8157   define input  parameter p-recid as recid no-undo .
     8158   define output parameter p-fact-order-sys-from as decimal   no-undo .
     8159   define output parameter p-fact-order-sys-to   as decimal   no-undo .
     8160   define buffer buf_price-doc-forming for ub.price-doc-forming  .
     8161   define buffer buf_price-list-type for ub.price-list-type  .
     8162   define variable v-shift-end-fact-order as decimal no-undo .
     8163   define variable v-day-end-fact-order   as decimal no-undo .
     8164   define variable v-fact-order           as decimal no-undo .
     8165     do
     8166     on error undo, return error return-value
     8167     :
     8168   find first buf_price-doc-forming  no-lock where recid(buf_price-doc-forming ) = p-recid no-error .
     8169     if error-status :error then return error error-status :get-message(1) .
     8170   find first buf_price-list-type  no-lock where
     8171              buf_price-list-type.plt-id = buf_price-doc-forming.plt-id and
     8172              buf_price-list-type.plt-db-num = buf_price-doc-forming.plt-db-num no-error .
     8173     if error-status :error then return error error-status :get-message(1) .
     8174    if buf_price-doc-forming.have-start-period = 1 then do:
     8175       case buf_price-list-type.work-date :
     8176         when int('1':U)  then
     8177           do :
     8178              run day-begin-fact-order
     8179                   ( buf_price-doc-forming.start-date ,
     8180                    output p-fact-order-sys-from ) no-error .
     8181                    if error-status :error then
     8182                    return error substitute ( "Ошибка из day-begin-fact-order &1 &2" ,
     8183                                               error-status :get-message(1) ,
     8184                                               return-value ).
     8185           end.
     8186         when int('2':U)   then
     8187           do :
     8188             run factord (
     8189                input   buf_price-doc-forming.start-shift-date
     8190               ,input   buf_price-doc-forming.sys-time
     8191               ,input   1
     8192               ,input   buf_price-doc-forming.start-shift-date
     8193               ,input   buf_price-doc-forming.start-shift-num
     8194               ,input   true
     8195               ,output  p-fact-order-sys-from
     8196               ,output  v-shift-end-fact-order
     8197               ,output  v-day-end-fact-order
     8198               ) no-error  .
     8199               if error-status :error then
     8200                    return error substitute ( "Ошибка из factord &1 &2" ,
     8201                                               error-status :get-message(1) ,
     8202                                               return-value ).
     8203           end.
     8204         when int('3':U)   then
     8205           do :
     8206             run factord (
     8207               input    buf_price-doc-forming.start-sys-date
     8208               ,input   buf_price-doc-forming.start-sys-time
     8209               ,input   (if buf_price-doc-forming.start-sys-time = 0 or buf_price-doc-forming.start-sys-time = ? then 1 else buf_price-doc-forming.start-sys-time )
     8210               ,input   ?
     8211               ,input   ?
     8212               ,input   false
     8213               ,output  p-fact-order-sys-from
     8214               ,output  v-shift-end-fact-order
     8215               ,output  v-day-end-fact-order
     8216               ) no-error .
     8217               if error-status :error then
     8218                    return error substitute ( "Ошибка из factord  - дата сервера &1 &2" ,
     8219                                               error-status :get-message(1) ,
     8220                                               return-value ).
     8221           end.
     8222       end case.
     8223     end.
     8224    if buf_price-doc-forming.have-end-period = 1 then do:
     8225       case buf_price-list-type.work-date :
     8226         when int('1':U)   then
     8227           do :
     8228              run factord-end-day
     8229                 ( buf_price-doc-forming.end-date ,
     8230                   output p-fact-order-sys-to ) no-error .
     8231                   if error-status :error then
     8232                    return error substitute ( "Ошибка из factord-end-day дата на объекте на конец периода &1 &2" ,
     8233                                               error-status :get-message(1) ,
     8234                                               return-value ).
     8235           end.
     8236         when int('2':U)   then
     8237           do :
     8238             run factord (
     8239                input   buf_price-doc-forming.end-shift-date
     8240               ,input   buf_price-doc-forming.sys-time
     8241               ,input   1
     8242               ,input   buf_price-doc-forming.end-shift-date
     8243               ,input   buf_price-doc-forming.end-shift-num
     8244               ,input   true
     8245               ,output  v-fact-order
     8246               ,output  p-fact-order-sys-to
     8247               ,output  v-day-end-fact-order
     8248               ) no-error .
     8249               if error-status :error then
     8250                 return error substitute ( "Ошибка из factord сменная дата на конец &1 &2" ,
     8251                                           error-status :get-message(1) ,
     8252                                           return-value ).
     8253           end.
     8254         when int('3':U)   then
     8255           do :
     8256             run factord (
     8257                input   buf_price-doc-forming.end-sys-date
     8258               ,input   buf_price-doc-forming.end-sys-time
     8259               ,input   (if buf_price-doc-forming.end-sys-time  = 0 or buf_price-doc-forming.end-sys-time = ? then 1 else buf_price-doc-forming.end-sys-time )
     8260               ,input   ?
     8261               ,input   ?
     8262               ,input   false
     8263               ,output  p-fact-order-sys-to
     8264               ,output  v-shift-end-fact-order
     8265               ,output  v-day-end-fact-order
     8266               ) no-error .
     8267               if error-status :error then
     8268                 return error substitute ( "Ошибка из factord  - дата сервера &1 &2" ,
     8269                                           error-status :get-message(1) ,
     8270                                           return-value ).
     8271           end.
     8272       end case.
     8273     end.
     8274     end.
     8275   end procedure.
     8276   procedure ver-dfc-mpl-lib3 :
     8277   define input  parameter p-recid as recid no-undo .
     8278   define buffer buf_price-doc-forming for ub.price-doc-forming  .
     8279   define buffer buf_price-list-type for ub.price-list-type  .
     8280   define buffer buf_price-doc-forming-gds for ub.price-doc-forming-gds  .
     8281   define buffer buf_price-doc-forming-gds-qnty for ub.price-doc-forming-gds-qnty  .
     8282   define buffer buf_price-doc-sum  for ub.price-doc-forming-gds-sum  .
     8283   define buffer buf_price-doc-forming-gds-tnv  for ub.price-doc-forming-gds-tnv  .
     8284   define variable v-fact-order-sys-from   as decimal   no-undo .
     8285   define variable v-fact-order-sys-to     as decimal   no-undo .
     8286     do
     8287     on error undo, return error return-value
     8288    :
     8289   find first buf_price-doc-forming  no-lock where recid(buf_price-doc-forming ) = p-recid no-error .
     8290     if error-status :error then return error error-status :get-message(1) .
     8291   find first buf_price-list-type  no-lock where
     8292              buf_price-list-type.plt-id = buf_price-doc-forming.plt-id and
     8293              buf_price-list-type.plt-db-num = buf_price-doc-forming.plt-db-num no-error .
     8294     if error-status :error then return error error-status :get-message(1) .
     8295     if buf_price-list-type.stts = integer('1':U) then do:
     8296        return error substitute(" ТПЛ &1 в статусе УДАЛЕН ! Закрывать с ним новые ДНЦ нельзя !" , buf_price-list-type.name )  .
     8297     end.
     8298     if buf_price-list-type.bgr-id > 0 then do:
     8299         find ub.buyer-group where
     8300               ub.buyer-group.stts       = 0  and
     8301               ub.buyer-group.bgr-db-num = buf_price-list-type.bgr-db-num and
     8302               ub.buyer-group.bgr-id     = buf_price-list-type.bgr-id
     8303               no-lock no-error .
     8304         if not available ub.buyer-group then
     8305         return error substitute(" ТПЛ &1 содержит некорректную группу по покупателям &2(&3) !" , buf_price-list-type.name,buf_price-list-type.bgr-id,buf_price-list-type.bgr-db-num )  .
     8306     end.
     8307     if buf_price-list-type.sgr-id > 0 then do:
     8308         find ub.sum-group where
     8309               ub.sum-group.stts       = 0  and
     8310               ub.sum-group.sgr-db-num = buf_price-list-type.sgr-db-num and
     8311               ub.sum-group.sgr-id     = buf_price-list-type.sgr-id
     8312               no-lock no-error .
     8313         if not available ub.sum-group then
     8314         return error substitute(" ТПЛ &1 содержит некорректную суммовую группу &2(&3) !" , buf_price-list-type.name,buf_price-list-type.sgr-id,buf_price-list-type.sgr-db-num )  .
     8315     end.
     8316     if buf_price-list-type.qgr-id > 0 then do:
     8317         find ub.qnty-group where
     8318              ub.qnty-group.stts       = 0  and
     8319              ub.qnty-group.qgr-db-num = buf_price-list-type.qgr-db-num and
     8320              ub.qnty-group.qgr-id     = buf_price-list-type.qgr-id
     8321              no-lock no-error .
     8322         if not available ub.qnty-group then
     8323         return error substitute(" ТПЛ &1 содержит некорректную количественную группу &2(&3) !" , buf_price-list-type.name,buf_price-list-type.qgr-id,buf_price-list-type.qgr-db-num )  .
     8324     end.
     8325     if buf_price-list-type.tog-id > 0 then do:
     8326         find ub.turnover-group where
     8327              ub.turnover-group.stts       = 0  and
     8328              ub.turnover-group.tog-db-num = buf_price-list-type.tog-db-num and
     8329              ub.turnover-group.tog-id     = buf_price-list-type.tog-id
     8330             no-lock no-error .
     8331         if not available ub.turnover-group then
     8332         return error substitute(" ТПЛ &1 содержит некорректную группу по оборотам &2(&3) !" , buf_price-list-type.name , buf_price-list-type.tog-id , buf_price-list-type.tog-db-num )  .
     8333     end.
     8334     if buf_price-list-type.gop-id > 0 then do:
     8335         find ub.grp-obj-price where
     8336               ub.grp-obj-price.stts       = 0  and
     8337               ub.grp-obj-price.gop-db-num = buf_price-list-type.gop-db-num and
     8338               ub.grp-obj-price.gop-id     = buf_price-list-type.gop-id
     8339               no-lock no-error .
     8340         if not available ub.grp-obj-price then
     8341         return error substitute(" ТПЛ &1 содержит некорректную группу по объектам &2(&3) !" , buf_price-list-type.name,buf_price-list-type.gop-id,buf_price-list-type.gop-db-num )  .
     8342     end.
     8343     if buf_price-list-type.gop-id-for-calc-turnover > 0 then do:
     8344         find ub.grp-obj-price where
     8345               ub.grp-obj-price.stts       = 0  and
     8346               ub.grp-obj-price.gop-db-num = buf_price-list-type.gop-db-num-for-calc-turnover and
     8347               ub.grp-obj-price.gop-id     = buf_price-list-type.gop-id-for-calc-turnover
     8348               no-lock no-error .
     8349         if not available ub.grp-obj-price then
     8350         return error substitute(" ТПЛ &1 содержит некорректную группу по объектам &2(&3) !" , buf_price-list-type.name,buf_price-list-type.gop-id-for-calc-turnover,buf_price-list-type.gop-db-num-for-calc-turnover )  .
     8351     end.
     8352      if buf_price-doc-forming.have-start-period = integer(true) then do:
     8353         case buf_price-list-type.work-date :
     8354             when int('1':U)     then
     8355               do :
     8356                  if buf_price-doc-forming.start-date = ? then return error "Не задана дата начала действия цен !" .
     8357               end.
     8358             when int('2':U)   then
     8359               do :
     8360                   if buf_price-doc-forming.start-shift-date = ? then return error "Не задана сменная дата начала действия цен !" .
     8361                   if buf_price-doc-forming.start-shift-num  = ? or
     8362                      buf_price-doc-forming.start-shift-num = 0  then return error "Не задан порядок смены начала действия цен !" .
     8363               end.
     8364             when int('3':U)     then
     8365               do :
     8366                   if buf_price-doc-forming.start-sys-date = ? then return error "Не задана дата начала действия цен !" .
     8367                   if buf_price-doc-forming.start-sys-time = ? then return error "Не задано время начала действия цен !" .
     8368               end.
     8369         end case.
     8370      end.
     8371      if buf_price-doc-forming.have-end-period = integer(true) then do:
     8372         case buf_price-list-type.work-date :
     8373             when int('1':U)     then
     8374               do :
     8375                  if buf_price-doc-forming.end-date = ? then return error "Не задана дата окончания действия цен !" .
     8376               end.
     8377             when int('2':U)   then
     8378               do :
     8379                   if buf_price-doc-forming.end-shift-date = ? then return error "Не задана сменная дата окончания действия цен !" .
     8380                   if buf_price-doc-forming.end-shift-num  = ? or
     8381                      buf_price-doc-forming.end-shift-num = 0  then return error "Не задан порядок смены окончания  действия цен !" .
     8382               end.
     8383             when int('3':U)     then
     8384               do :
     8385                   if buf_price-doc-forming.end-sys-date = ? then return error "Не задана дата окончания действия цен !" .
     8386                   if buf_price-doc-forming.end-sys-time = ? then return error "Не задано время окончания действия цен !" .
     8387               end.
     8388         end case.
     8389      end.
     8390      if buf_price-doc-forming.have-start-period = integer(true) and
     8391         buf_price-doc-forming.have-end-period = integer(true) then do:
     8392         case buf_price-list-type.work-date :
     8393             when int('1':U)     then
     8394               do :
     8395                  if buf_price-doc-forming.end-date < buf_price-doc-forming.start-date then return error "Не верно задан интервал дат !" .
     8396               end.
     8397             when int('2':U)   then
     8398               do :
     8399                   if buf_price-doc-forming.end-shift-date < buf_price-doc-forming.start-shift-date then return error "Не верно задан интервал дат !" .
     8400                   if buf_price-doc-forming.end-shift-date = buf_price-doc-forming.start-shift-date then do:
     8401                      if buf_price-doc-forming.end-shift-num < buf_price-doc-forming.start-shift-num then return error "Не верно задан интервал смен !" .
     8402                   end.
     8403               end.
     8404             when int('3':U)     then
     8405               do :
     8406                   if buf_price-doc-forming.end-sys-date < buf_price-doc-forming.start-sys-date then return error "Не верно задан интервал дат !" .
     8407                   if buf_price-doc-forming.end-sys-date = buf_price-doc-forming.start-sys-date then do:
     8408                      if buf_price-doc-forming.end-sys-time < buf_price-doc-forming.start-sys-time then return error "Не верно задан интервал времени !" .
     8409                   end.
     8410               end.
     8411         end case.
     8412      end.
     8413   if buf_price-doc-forming.name = "" then return error "Не задано название ДНЦ !" .
     8414   if buf_price-list-type.main = false then do:
     8415       run make-fact-order-lib3 in this-procedure
     8416           ( input  p-recid ,
     8417             output v-fact-order-sys-from ,
     8418             output v-fact-order-sys-to   ) .
     8419   end.
     8420   define variable old-price as decimal   no-undo .
     8421   define variable v-kol-rec as integer   no-undo .
     8422   define variable v-gds-null-price as character no-undo initial "" .
     8423   define variable v-type as character no-undo .
     8424   v-kol-rec = 0.
     8425   for each buf_price-doc-forming-gds no-lock where
     8426            buf_price-doc-forming-gds.plt-id     = buf_price-doc-forming.plt-id      and
     8427            buf_price-doc-forming-gds.plt-db-num = buf_price-doc-forming.plt-db-num  and
     8428            buf_price-doc-forming-gds.pdf-id     = buf_price-doc-forming.pdf-id      and
     8429            buf_price-doc-forming-gds.pdf-db     = buf_price-doc-forming.pdf-db      :
     8430       find first ub.bar-code no-lock where
     8431                  ub.bar-code.b-code = buf_price-doc-forming-gds.b-code no-error .
     8432                  if error-status :error then return error substitute ("Не найден бар-код &1" ,  buf_price-doc-forming-gds.b-code ) .
     8433       find first ub.goods no-lock where
     8434                  ub.goods.artic = buf_price-doc-forming-gds.artic         and
     8435                  ub.goods.prod-type = buf_price-doc-forming-gds.prod-type and
     8436                  ub.goods.prod-code = buf_price-doc-forming-gds.prod-code no-error .
     8437                  if error-status :error then return error substitute ("Не найден товар &1 &2 &3" ,  buf_price-doc-forming-gds.artic , buf_price-doc-forming-gds.prod-type ,buf_price-doc-forming-gds.prod-code) .
     8438       if ub.bar-code.gds-code <> ub.goods.gds-code then return error substitute ("Бар-код &4 не соответствует товару &1 &2 &3" ,  buf_price-doc-forming-gds.artic , buf_price-doc-forming-gds.prod-type ,buf_price-doc-forming-gds.prod-code, buf_price-doc-forming-gds.b-code ) .
     8439       run gds-attr-value in this-procedure (input ub.goods.gds-code
     8440                                            ,input 'null-price':U
     8441                                            ,output v-gds-null-price
     8442                                            ,output v-type ) no-error .
     8443       if buf_price-doc-forming-gds.price-sale-doc   = ? or (buf_price-doc-forming-gds.price-sale-doc   = 0 and not logical(v-gds-null-price) )
     8444                   then return error substitute ("Продажная цена по товару &1 &2 &3 = &4" ,  buf_price-doc-forming-gds.artic , buf_price-doc-forming-gds.prod-type ,buf_price-doc-forming-gds.prod-code, buf_price-doc-forming-gds.price-sale-doc  ) .
     8445       if buf_price-doc-forming-gds.price-sale-rubl  = ? or (buf_price-doc-forming-gds.price-sale-rubl  = 0 and not logical(v-gds-null-price) )
     8446                   then return error substitute ("Продажная цена по товару &1 &2 &3 = &4" ,  buf_price-doc-forming-gds.artic , buf_price-doc-forming-gds.prod-type ,buf_price-doc-forming-gds.prod-code, buf_price-doc-forming-gds.price-sale-rubl ) .
     8447       if buf_price-doc-forming-gds.price-sale-base  = ? or (buf_price-doc-forming-gds.price-sale-base  = 0 and not logical(v-gds-null-price) )
     8448                   then return error substitute ("Продажная цена по товару &1 &2 &3 = &4" ,  buf_price-doc-forming-gds.artic , buf_price-doc-forming-gds.prod-type ,buf_price-doc-forming-gds.prod-code, buf_price-doc-forming-gds.price-sale-base ) .
     8449       if buf_price-doc-forming-gds.slt-pc = ? then return error substitute ("НсП по товару &1 &2 &3 не определен" ,  buf_price-doc-forming-gds.artic , buf_price-doc-forming-gds.prod-type ,buf_price-doc-forming-gds.prod-code) .
     8450       if buf_price-doc-forming-gds.vat-pc = ? then return error substitute ("НДС по товару &1 &2 &3 не определен" ,  buf_price-doc-forming-gds.artic , buf_price-doc-forming-gds.prod-type ,buf_price-doc-forming-gds.prod-code) .
     8451   old-price = ? .
     8452     for each buf_price-doc-forming-gds-qnty no-lock where
     8453              buf_price-doc-forming-gds-qnty.plt-id = buf_price-doc-forming-gds.plt-id and
     8454              buf_price-doc-forming-gds-qnty.plt-db-num = buf_price-doc-forming-gds.plt-db-num and
     8455              buf_price-doc-forming-gds-qnty.pdf-id = buf_price-doc-forming-gds.pdf-id and
     8456              buf_price-doc-forming-gds-qnty.pdf-db = buf_price-doc-forming-gds.pdf-db and
     8457              buf_price-doc-forming-gds-qnty.b-code = buf_price-doc-forming-gds.b-code
     8458              by buf_price-doc-forming-gds-qnty.ggr-qnty :
     8459              if old-price < buf_price-doc-forming-gds-qnty.price-sale-doc and old-price <> ? then do:
     8460                 return error substitute ("Цена по товару &1 &2 &3 по категории количество покупки >= &4  больше предыдущей категории (&5 и  &6)" ,  buf_price-doc-forming-gds.artic , buf_price-doc-forming-gds.prod-type ,buf_price-doc-forming-gds.prod-code, buf_price-doc-forming-gds-qnty.ggr-qnty ,old-price , buf_price-doc-forming-gds-qnty.price-sale-doc) .
     8461              end.
     8462              old-price = buf_price-doc-forming-gds-qnty.price-sale-doc .
     8463     end.
     8464   old-price = ? .
     8465     for each buf_price-doc-sum no-lock where
     8466              buf_price-doc-sum.plt-id     = buf_price-doc-forming-gds.plt-id and
     8467              buf_price-doc-sum.plt-db-num = buf_price-doc-forming-gds.plt-db-num and
     8468              buf_price-doc-sum.pdf-id     = buf_price-doc-forming-gds.pdf-id and
     8469              buf_price-doc-sum.pdf-db     = buf_price-doc-forming-gds.pdf-db and
     8470              buf_price-doc-sum.b-code     = buf_price-doc-forming-gds.b-code
     8471              by buf_price-doc-sum.ssg-summa
     8472              :
     8473              if old-price < buf_price-doc-sum.price-sale-doc and old-price <> ? then do:
     8474                 return error substitute ("Цена по товару &1 &2 &3 по категории сумма покупки >= &4  больше предыдущей категории (&5 и  &6)" ,  buf_price-doc-forming-gds.artic , buf_price-doc-forming-gds.prod-type ,buf_price-doc-forming-gds.prod-code, buf_price-doc-sum.ssg-summa , old-price , buf_price-doc-sum.price-sale-doc) .
     8475              end.
     8476              old-price = buf_price-doc-sum.price-sale-doc .
     8477     end.
     8478   old-price = ? .
     8479     for each buf_price-doc-forming-gds-tnv no-lock where
     8480              buf_price-doc-forming-gds-tnv.plt-id     = buf_price-doc-forming-gds.plt-id and
     8481              buf_price-doc-forming-gds-tnv.plt-db-num = buf_price-doc-forming-gds.plt-db-num and
     8482              buf_price-doc-forming-gds-tnv.pdf-id     = buf_price-doc-forming-gds.pdf-id and
     8483              buf_price-doc-forming-gds-tnv.pdf-db     = buf_price-doc-forming-gds.pdf-db and
     8484              buf_price-doc-forming-gds-tnv.b-code     = buf_price-doc-forming-gds.b-code
     8485              by buf_price-doc-forming-gds-tnv.ttg-summa :
     8486              if old-price < buf_price-doc-forming-gds-tnv.price-sale-doc and old-price <> ? then do:
     8487                 return error substitute ("Цена по товару &1 &2 &3 по категории сумма оборота покупателя >= &4  больше предыдущей категории (&5 и  &6)" ,  buf_price-doc-forming-gds.artic , buf_price-doc-forming-gds.prod-type ,buf_price-doc-forming-gds.prod-code, buf_price-doc-forming-gds-tnv.ttg-summa ,old-price , buf_price-doc-forming-gds-tnv.price-sale-doc) .
     8488              end.
     8489              old-price = buf_price-doc-forming-gds-tnv.price-sale-doc .
     8490     end.
     8491     define buffer old_price-doc-forming for ub.price-doc-forming  .
     8492     define buffer old_price-doc-forming-gds for ub.price-doc-forming-gds  .
     8493     define buffer old_price-all for ub.price-all.
     8494     if buf_price-list-type.main = false then do:
     8495        for each old_price-doc-forming no-lock where
     8496                 old_price-doc-forming.plt-id     = buf_price-list-type.plt-id     and
     8497                 old_price-doc-forming.plt-db-num = buf_price-list-type.plt-db-num and
     8498                 old_price-doc-forming.stts       = integer('3':U)  ,
     8499                 each old_price-doc-forming-gds no-lock where
     8500                       old_price-doc-forming-gds.plt-id     = buf_price-list-type.plt-id      and
     8501                       old_price-doc-forming-gds.plt-db-num = buf_price-list-type.plt-db-num  and
     8502                       old_price-doc-forming-gds.pdf-id     = old_price-doc-forming.pdf-id    and
     8503                       old_price-doc-forming-gds.pdf-db     = old_price-doc-forming.pdf-db    and
     8504                       old_price-doc-forming-gds.b-code     = buf_price-doc-forming-gds.b-code :
     8505                for each old_price-all no-lock where
     8506                         old_price-all.plt-id     = old_price-doc-forming-gds.plt-id      and
     8507                         old_price-all.plt-db-num = old_price-doc-forming-gds.plt-db-num  and
     8508                         old_price-all.pdf-id     = old_price-doc-forming-gds.pdf-id      and
     8509                         old_price-all.pdf-db     = old_price-doc-forming-gds.pdf-db      and
     8510                         old_price-all.b-code     = old_price-doc-forming-gds.b-code      and
     8511                         old_price-all.fact-order-sys-to   >= v-fact-order-sys-from       and
     8512                         old_price-all.fact-order-sys-from <= v-fact-order-sys-to         :
     8513                        return error substitute ("По товару &1 &2 &3 есть цена &6 в пересекающийся период с таким же приоритетом &7 (ДНЦ &4 &5) " ,
     8514                                                  buf_price-doc-forming-gds.artic ,
     8515                                                  buf_price-doc-forming-gds.prod-type ,
     8516                                                  buf_price-doc-forming-gds.prod-code,
     8517                                                  old_price-all.pdf-id ,
     8518                                                  old_price-all.pdf-db ,
     8519                                                  old_price-doc-forming-gds.price-sale-doc ,
     8520                                                  old_price-all.plt-priority
     8521                                                  ) .
     8522                end.
     8523        end.
     8524        end.
     8525       assign v-kol-rec = v-kol-rec + 1 .
     8526   end.
     8527     run ver-pr-equ-qS in this-procedure
     8528       ( input buf_price-doc-forming.plt-id ,
     8529         input buf_price-doc-forming.plt-db-num,
     8530         input buf_price-doc-forming.pdf-id ,
     8531         input buf_price-doc-forming.pdf-db
     8532         ) no-error .
     8533     if error-status :error then  return error  "Ошибка при удалении строки ДНЦ "   .
     8534   if v-kol-rec = 0 then return error "no-records":U.
     8535   end.
     8536   end procedure.
     8537   procedure ver-pr-equ-qS :
     8538   define input parameter  p-plt-id      as integer   no-undo .
     8539   define input parameter  p-plt-db-num  as integer   no-undo .
     8540   define input parameter  p-pdf-id      as integer   no-undo .
     8541   define input parameter  p-pdf-db      as integer   no-undo .
     8542     do
     8543     on error undo, return error return-value
     8544     :
     8545   define variable  l-doc-num2   like ub.price-list.doc-num    no-undo .
     8546   define buffer pdf_price-list  for ub.price-doc-forming-gds .
     8547   define buffer pp_price-list   for ub.price-doc-forming-gds .
     8548   define buffer main_price-list for ub.price-doc-forming-gds .
     8549   define buffer alt_price-list  for ub.price-doc-forming-gds .
     8550   define buffer buf1-bar-code   for ub.bar-code .
     8551   define buffer buf2-bar-code   for ub.bar-code .
     8552   define buffer buf_goods for ub.goods  .
     8553   define buffer buf2_goods for ub.goods  .
     8554   define variable v-num as integer init 0 no-undo .
     8555   define variable bbb   as logical no-undo .
     8556   define variable l-price-sale like ub.price-list.price-sale no-undo .
     8557   define variable l-road-tax   like ub.price-list.road-tax   no-undo .
     8558   define variable l-excise     like ub.price-list.excise     no-undo .
     8559   define variable l-ok          as logical no-undo .
     8560   define variable check-par     as logical no-undo .
     8561   define variable main-b-code   as integer no-undo .
     8562   define variable par-pr-equ-dq as integer no-undo .
     8563   define variable v-price-sale  as decimal no-undo .
     8564   define variable vss-include-info76 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8565   empty temp-table thbjattr_thbj-attr.
     8566   run adm/shattri.p (
     8567      input "get":U
     8568     ,input v-cntxt-obj-type
     8569     ,input v-cntxt-obj-code
     8570     ,input 'overval':U
     8571     ,input  ""
     8572     ,output v-value-character
     8573     ,output v-value-date
     8574     ,output v-value-decimal
     8575     ,output v-value-integer
     8576     ,output v-value-logical
     8577     ,output par-type
     8578     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     8579     ) no-error .
     8580   for each thbjattr_thbj-attr :
     8581       if thbjattr_thbj-attr.prop-code = 'pr-equ-dq':U then par-pr-equ-dq = thbjattr_thbj-attr.property-value-integer .
     8582   end.
     8583   if par-pr-equ-dq = 1 then return .
     8584   for each pdf_price-list exclusive-lock where
     8585            pdf_price-list.plt-id     = p-plt-id     and
     8586            pdf_price-list.plt-db-num = p-plt-db-num and
     8587            pdf_price-list.pdf-id     = p-pdf-id     and
     8588            pdf_price-list.pdf-db     = p-pdf-db     by pdf_price-list.line-num
     8589           :
     8590       if not (pdf_price-list.b-code     = f-base-code (pdf_price-list.b-code) ) then next .
     8591       check-par = false .
     8592      find first x_obj-group no-error .
     8593   define variable vss-include-info77 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
