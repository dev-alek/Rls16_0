     2227       message
     2228           "Не найдена запись bar-code"
     2229           skip "для товара "
     2230           skip string(buf_goods.artic)
     2231           skip buf_goods.gds-name
     2232           skip "С основным бар-кодом"
     2233           skip string(v-b-code)
     2234       view-as alert-box
     2235       title "Ошибка при выполнении prcreate.i".
     2236       undo, return error .
     2237   end.
     2238   find first buf_root_gds-prt no-lock
     2239        where buf_root_gds-prt.upper-code = buf_goods.prt-root
     2240   .
     2241   if buf_root_gds-prt.node-name <> '_Пустая шкала':U
     2242     and buf_bar-code.in-code <> ""
     2243   then do:
     2244       message
     2245           "Не допускается создавать спец. цены на партии для товаров с непустой шкалой!" skip (2)
     2246           "Артикул:" buf_goods.artic "Код:" buf_goods.gds-code buf_goods.gds-name
     2247           view-as alert-box error.
     2248       undo, return error.
     2249   end.
     2250   find first buf_gds-prt no-lock
     2251        where buf_gds-prt.node-code = buf_bar-code.node-code
     2252   .
     2253   find first buf_price-list
     2254        where buf_price-list.doc-num = buf_price-doc.doc-num
     2255          and buf_price-list.b-code  = v-b-code
     2256   no-error.
     2257   if available buf_price-list
     2258   then do:
     2259       message "Строка с товаром арт." buf_price-list.artic " уже есть в данной переоценке."
     2260          skip "  Цена:   " buf_price-list.price-sale
     2261          skip "Цена будет изменена"
