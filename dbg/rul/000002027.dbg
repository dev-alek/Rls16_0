     2390   procedure prcreate-new-price-doc-forming-gds :
     2391   define input  parameter p-price-doc-forming-recid as recid  no-undo.
     2392   define input  parameter p-obj-type   as character no-undo .
     2393   define input  parameter p-obj-code   as integer   no-undo .
     2394   define input  parameter par-pr-notls as character no-undo .
     2395   define input  parameter par-pr-altex as character no-undo .
     2396   define input  parameter par-pr-sclex as character no-undo .
     2397   define input  parameter p-line-num    as integer   no-undo .
     2398   define input  parameter p-gds-code    as integer   no-undo .
     2399   define input  parameter p-price-sale  as decimal   no-undo .
     2400   define buffer buf_price-doc-forming for ub.price-doc-forming  .
     2401   define buffer buf_goods for ub.goods  .
     2402   define buffer buf_bar-code for ub.bar-code  .
     2403   define buffer main_bar-code for ub.bar-code  .
     2404   define variable main-b-code as integer   no-undo .
     2405   define variable v-sec as integer   no-undo .
     2406     do
     2407     on error undo, return error return-value
     2408     :
     2409   define variable v-cur-dn as character no-undo .
     2410   define variable v-cur-pr as decimal   no-undo .
     2411   define variable v-cur-rt as decimal   no-undo .
     2412   define variable v-cur-ex as decimal   no-undo .
     2413   find first buf_price-doc-forming no-lock where
     2414              recid(buf_price-doc-forming) = p-price-doc-forming-recid  no-error .
     2415              if error-status :error then return error .
     2416   find first buf_goods no-lock where
     2417              buf_goods.gds-code  = p-gds-code no-error .
     2418              if error-status :error then return error .
     2419   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2420     (input  buf_goods.gds-code
     2421     ,input  ?
     2422     ,output main-b-code
     2423     ) no-error .
     2424   run check-use-bar-code (main-b-code) no-error .
     2425   if error-status :error then return .
     2426   run create-line-pdf-mpl-lib (
     2427        input buf_price-doc-forming.plt-db-num
     2428       ,input buf_price-doc-forming.plt-id
     2429       ,input buf_price-doc-forming.pdf-db
     2430       ,input buf_price-doc-forming.pdf-id
     2431       ,input p-line-num
     2432       ,input main-b-code
     2433       ,input buf_goods.artic
     2434       ,input buf_goods.prod-type
     2435       ,input buf_goods.prod-code
     2436       ,input ""
     2437       ,input 0
     2438       ,input p-price-sale
     2439       ,input ""
     2440       ,input 0
     2441      ,input-output v-sec ) no-error .
     2442      if error-status :error  then do:
     2443        message
     2444          vss-workfile vss-revision vss-description skip
     2445          error-status :get-message(1) skip
     2446          return-value skip
     2447          "2"
     2448          view-as alert-box error
     2449        .
     2450      end.
     2451   define buffer old_price-list for ub.price-list  .
     2452   if par-pr-notls = "yes" then do:
     2453   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2454   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     2455     (input  p-obj-type
     2456     ,input  p-obj-code
     2457     ,input  main-b-code
     2458     ,input  0
     2459     ,input  0
     2460     ,output v-cur-dn
     2461     ,output v-cur-pr
     2462     ,output v-cur-rt
     2463     ,output v-cur-ex
     2464     )  .
     2465   end.
     2466   if par-pr-altex = "yes" and
     2467      par-pr-notls = "yes" then do:
     2468       if v-cur-dn <> "" then do:
     2469           for each old_price-list no-lock where
     2470                    old_price-list.doc-num = v-cur-dn and
     2471                    old_price-list.artic      = buf_goods.artic and
     2472                    old_price-list.prod-type  = buf_goods.prod-type and
     2473                    old_price-list.prod-code  = buf_goods.prod-code and
     2474                    old_price-list.main-price = no,
     2475                   first buf_bar-code no-lock where
     2476                         buf_bar-code.b-code   = old_price-list.b-code and
     2477                         buf_bar-code.unit-cli <> buf_goods.unit-base
     2478                         :
     2479                          run check-use-bar-code (buf_bar-code.b-code) no-error .
     2480                          if error-status :error then next.
     2481                    run create-line-pdf-mpl-lib (
     2482                          input buf_price-doc-forming.plt-db-num
     2483                         ,input buf_price-doc-forming.plt-id
     2484                         ,input buf_price-doc-forming.pdf-db
     2485                         ,input buf_price-doc-forming.pdf-id
     2486                         ,input p-line-num
     2487                         ,input old_price-list.b-code
     2488                         ,input buf_goods.artic
     2489                         ,input buf_goods.prod-type
     2490                         ,input buf_goods.prod-code
     2491                         ,input ""
     2492                         ,input 0
     2493                         ,input old_price-list.price-sale
     2494                         ,input ""
     2495                         ,input 0
     2496                        ,input-output v-sec ) no-error .
     2497           end.
     2498       end.
     2499   end.
     2500   if par-pr-sclex = "yes" and
     2501      par-pr-notls = "yes" then do:
     2502       if v-cur-dn <> "" then do:
     2503           for each old_price-list no-lock where
     2504                    old_price-list.doc-num    = v-cur-dn and
     2505                    old_price-list.artic      = buf_goods.artic and
     2506                    old_price-list.prod-type  = buf_goods.prod-type and
     2507                    old_price-list.prod-code  = buf_goods.prod-code and
     2508                    old_price-list.main-price = no,
     2509                   first buf_bar-code no-lock where
     2510                         buf_bar-code.b-code   = old_price-list.b-code and
     2511                         buf_bar-code.in-code  = "" and
     2512                         buf_bar-code.unit-cli = buf_goods.unit-base
     2513                         :
     2514                          run check-use-bar-code (buf_bar-code.b-code) no-error .
     2515                          if error-status :error then next.
     2516                    run create-line-pdf-mpl-lib (
     2517                          input buf_price-doc-forming.plt-db-num
     2518                         ,input buf_price-doc-forming.plt-id
     2519                         ,input buf_price-doc-forming.pdf-db
     2520                         ,input buf_price-doc-forming.pdf-id
     2521                         ,input p-line-num
     2522                         ,input old_price-list.b-code
     2523                         ,input buf_goods.artic
     2524                         ,input buf_goods.prod-type
     2525                         ,input buf_goods.prod-code
     2526                         ,input ""
     2527                         ,input 0
     2528                         ,input old_price-list.price-sale
     2529                         ,input ""
     2530                         ,input 0
     2531                       ,input-output v-sec ) no-error .
     2532           end.
     2533       end.
     2534   end.
     2535   end.
     2536   end procedure.
     2537   procedure copy_new_price-doc-forming :
     2538   define input  parameter       p-recid      as recid no-undo .
     2539   define input-output parameter p-plt-db-num as integer   no-undo .
     2540   define input-output parameter p-plt-id     as integer   no-undo .
     2541   define output parameter       p-pdf-db-num as integer   no-undo .
     2542   define output parameter       p-pdf-id     as integer   no-undo .
     2543   define buffer buf_price-list-type        for ub.price-list-type  .
     2544   define buffer buf_price-doc-forming      for ub.price-doc-forming .
     2545   define buffer buf_price-doc-forming-attr for ub.price-doc-forming-attr .
     2546   define buffer buf_price-doc-forming-gds  for ub.price-doc-forming-gds .
     2547   define buffer buf_pd-forming-gds-attr    for ub.price-doc-forming-gdsattr .
     2548   define variable v-host-code  as integer   no-undo .
     2549   define variable v-base-rate  as decimal   no-undo .
     2550   define variable v-base-scale as integer   no-undo .
     2551   define variable v-exch-rate  as decimal   no-undo .
     2552   define variable v-exch-scale as integer   no-undo .
     2553   define variable v-base as logical   no-undo .
     2554   define variable v-name as character no-undo .
     2555     do
     2556     on error undo, return error return-value
     2557     :
     2558   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2559   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rbisbase in g#library
     2560     (output v-base
     2561     )  .
     2562   find first buf_price-list-type no-lock where
     2563              buf_price-list-type.plt-db-num = p-plt-db-num and
     2564              buf_price-list-type.plt-id     = p-plt-id no-error .
     2565   if error-status :error then return error "Не найден ТПЛ".
     2566   if buf_price-list-type.stts <> 0 then return error "ТПЛ удален" .
     2567   find first buf_price-doc-forming  no-lock where recid(buf_price-doc-forming )  = p-recid no-error .
     2568       if available buf_price-doc-forming then do :
     2569           assign
     2570             v-base-rate  = buf_price-doc-forming.base-rate
     2571             v-base-scale = buf_price-doc-forming.base-scale
     2572             v-name       =  substitute("Скопировано с ДНЦ &1 &2",  buf_price-doc-forming.pdf-id , trim(buf_price-doc-forming.name)  )
     2573           .
     2574       end.
     2575       else do:
     2576           assign
     2577             v-base-rate  = 1
     2578             v-base-scale = 1
     2579             v-name       = "Автосоздание"
     2580           .
     2581       end.
     2582      create ub.price-doc-forming.
     2583      assign
     2584         ub.price-doc-forming.plt-id       = p-plt-id
     2585         ub.price-doc-forming.plt-db-num   = p-plt-db-num
     2586         ub.price-doc-forming.pdf-id       = next-value ( s-pdf , ub)
     2587         ub.price-doc-forming.pdf-db       = v-cntxt-db-num
     2588         ub.price-doc-forming.base-rate    = v-base-rate
     2589         ub.price-doc-forming.base-scale   = v-base-scale
     2590         ub.price-doc-forming.db-num-chg   = v-cntxt-db-num
     2591         ub.price-doc-forming.exch-rate    = if v-base then v-base-rate else 1
     2592         ub.price-doc-forming.exch-scale   = if v-base then v-base-scale else 1
     2593         ub.price-doc-forming.stts         = 0
     2594         ub.price-doc-forming.sys-date     = today
     2595         ub.price-doc-forming.sys-time     = time
     2596         ub.price-doc-forming.sys-time-chr = string ( ub.price-doc-forming.sys-time , "hh:mm" )
     2597         ub.price-doc-forming.who          = v-cntxt-userid
     2598         ub.price-doc-forming.name         = v-name
     2599      .
     2600      assign
     2601       p-pdf-db-num  = ub.price-doc-forming.pdf-db
     2602       p-pdf-id      = ub.price-doc-forming.pdf-id
     2603       p-plt-db-num  = ub.price-doc-forming.plt-db-num
     2604       p-plt-id      = ub.price-doc-forming.plt-id
     2605      .
     2606     end.
     2607     if not available buf_price-doc-forming then return .
     2608   for each buf_price-doc-forming-attr no-lock where
     2609            buf_price-doc-forming-attr.pdf-db      = buf_price-doc-forming.pdf-db       and
     2610            buf_price-doc-forming-attr.pdf-id      = buf_price-doc-forming.pdf-id       and
     2611            buf_price-doc-forming-attr.plt-db-num  = buf_price-doc-forming.plt-db-num   and
     2612            buf_price-doc-forming-attr.plt-id      = buf_price-doc-forming.plt-id       :
     2613       create ub.price-doc-forming-attr.
     2614       buffer-copy buf_price-doc-forming-attr to ub.price-doc-forming-attr
     2615       assign
     2616         ub.price-doc-forming-attr.plt-db-num  = p-plt-db-num
     2617         ub.price-doc-forming-attr.plt-id      = p-plt-id
     2618         ub.price-doc-forming-attr.pdf-db     = p-pdf-db-num
     2619         ub.price-doc-forming-attr.pdf-id      = p-pdf-id
     2620         .
     2621   end.
     2622   for each buf_price-doc-forming-gds no-lock where
     2623            buf_price-doc-forming-gds.pdf-db      = buf_price-doc-forming.pdf-db       and
     2624            buf_price-doc-forming-gds.pdf-id      = buf_price-doc-forming.pdf-id       and
     2625            buf_price-doc-forming-gds.plt-db-num  = buf_price-doc-forming.plt-db-num   and
     2626            buf_price-doc-forming-gds.plt-id      = buf_price-doc-forming.plt-id       :
     2627       create ub.price-doc-forming-gds.
     2628       buffer-copy buf_price-doc-forming-gds to ub.price-doc-forming-gds
     2629       assign
     2630         ub.price-doc-forming-gds.plt-db-num  = p-plt-db-num
     2631         ub.price-doc-forming-gds.plt-id      = p-plt-id
     2632         ub.price-doc-forming-gds.pdf-db      = p-pdf-db-num
     2633         ub.price-doc-forming-gds.pdf-id      = p-pdf-id
     2634       .
     2635   end.
     2636   for each buf_pd-forming-gds-attr no-lock where
     2637            buf_pd-forming-gds-attr.pdf-db      = buf_price-doc-forming.pdf-db       and
     2638            buf_pd-forming-gds-attr.pdf-id      = buf_price-doc-forming.pdf-id       and
     2639            buf_pd-forming-gds-attr.plt-db-num  = buf_price-doc-forming.plt-db-num   and
     2640            buf_pd-forming-gds-attr.plt-id      = buf_price-doc-forming.plt-id       :
     2641       create ub.price-doc-forming-gdsattr.
     2642       buffer-copy buf_pd-forming-gds-attr to ub.price-doc-forming-gdsattr
     2643       assign
     2644         ub.price-doc-forming-gdsattr.plt-db-num  = p-plt-db-num
     2645         ub.price-doc-forming-gdsattr.plt-id      = p-plt-id
     2646         ub.price-doc-forming-gdsattr.pdf-db      = p-pdf-db-num
     2647         ub.price-doc-forming-gdsattr.pdf-id      = p-pdf-id
     2648       .
     2649   end.
     2650   end procedure.
     2651   define variable par-pr-incpc as character no-undo.
     2652   define variable par-pr-rndmt as character no-undo.
     2653   define variable par-pr-rndbs as character no-undo.
     2654   define variable par-pr-clt-q as character no-undo.
     2655   define variable par-pr-dpl-q as character no-undo.
