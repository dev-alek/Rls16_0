     7265      , input  v-base-scale
     7266      , input  v-exch-scale
     7267      , input  v-exch-rate
     7268      , input  v-doc-code
     7269      , input  v-common-price
     7270      , input  v-copy-type
     7271      , input  v-copy-code
     7272      , output p-calc-method
