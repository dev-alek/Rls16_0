     5415     if error-status :error then message
     5416       vss-workfile vss-revision vss-description skip
     5417       error-status :get-message(1) skip
     5418       return-value skip
     5419       ""
     5420       view-as alert-box error
     5421     .
     5422     case p-calc-method:
     5423       when 'Единая':U or
     5424       when 'Отсутствует':U or
     5425       when 'Не-считать':U or
     5426       when 'Откат_цен':U
     5427       then do:
     5428          p-increase-pc  = 0  .
     5429          p-round-method = 'Отключено':U .
     5430       end.
     5431       when 'Товар':U then do:
     5432         case buf-goods.calc-method:
     5433           when 'Группа':U then do:
     5434             find buf-gds-grp no-lock where
     5435                  buf-gds-grp.node-code = buf-goods.grp-code.
     5436              p-increase-pc  = loc-grp-increase-pc .
     5437              p-round-method = loc-grp-round-method .
     5438              p-round-base   = loc-grp-round-base .
     5439              g-g = true  .
     5440           end.
     5441           otherwise do:
     5442              p-increase-pc  =  loc-increase-pc .
     5443           end.
     5444         end case.
     5445         if g-g = false then do:
     5446             run gdsoattr-value
     5447                ( input 'round-method':U ,
     5448                  input p-gds-code ,
     5449                  input x_obj-group.obj-type ,
     5450                  input x_obj-group.obj-code ,
     5451                  output loc-rez ,
     5452                  output t-type
     5453                  ) no-error  .
     5454                 if error-status :error then message
     5455                   vss-workfile vss-revision vss-description skip
     5456                   error-status :get-message(1) skip
     5457                   "gdsoattr-value"
     5458                   view-as alert-box error .
     5459             case NUM-ENTRIES (loc-rez," ") :
     5460                 when 0 then do:
     5461                 end.
     5462                 when 1 then do:
     5463                   p-round-method = loc-rez .
     5464                   p-round-base   = 0 .
     5465                 end.
     5466                 when 2 then do:
     5467                   p-round-method = entry(1 , loc-rez, " " ).
     5468                   p-round-base   = decimal(entry(2 , loc-rez, " " )) .
     5469                 end.
     5470                 otherwise do:
     5471                   p-round-method = entry(1 , loc-rez, " " ).
     5472                   p-round-base   = decimal(entry(NUM-ENTRIES (loc-rez," ") , loc-rez, " " )) .
     5473                 end.
     5474             end case.
     5475         end.
     5476       end.
     5477     end case.
