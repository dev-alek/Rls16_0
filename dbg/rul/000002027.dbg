     4628     v-plt-db-num = p-plt-db
     4629     p-new-calc-method = p-calc-method
     4630   .
     4631   run re-define in this-procedure (
     4632       input-output p-calc-method
     4633     , input p-gds-code
     4634     ) no-error .
     4635     if error-status :error then do:
     4636        message
     4637          vss-workfile vss-revision vss-description skip
     4638          error-status :get-message(1) skip
     4639          return-value skip
     4640          "re-define"
     4641          view-as alert-box error
     4642        .
     4643     end.
     4644     define variable v-sps as character no-undo .
     4645   v-sps =
     4646    "Товар,
     4647   Группа,
     4648   Учетная,
     4649   Учет-объект,
     4650   Учет-резерв,
     4651   Приходная,
     4652   Прих-объект,
     4653   Начальная,
     4654   Старая,
     4655   Новая,
     4656   Объект,
     4657   Накладная,
     4658   Накл-безНДС,
     4659   Учет-безНДС,
     4660   Стар-безНДС,
     4661   Переоценка,
     4662   ДокФормЦены,
     4663   Отсутствует,
     4664   Признак,
     4665   Специальная,
     4666   Не-считать,
     4667   Основная,
     4668   Единая,
     4669   Учет+накл,
     4670   Уч+накл-НДС,
     4671   НсП,
     4672   НсП+накл,
     4673   УчетнаяS,
     4674   Учет-рзрвS,
     4675   ПриходнаяS,
     4676   Учет-НДСS,
     4677   Производит,
     4678   Произв-НДС,
     4679   ПорогПр-НДС,
     4680   ПорогПр+НДС,
     4681   Откат_цен"
     4682     .
     4683   if lookup ( p-calc-method , v-sps )  = 0 then  do:
     4684       p-calc-method = entry (1,p-calc-method, " ") no-error .
     4685       if error-status :error then message p-calc-method.
     4686   end.
     4687   define variable v-i as integer   no-undo init 0.
     4688     for each  x_obj-group :
     4689         v-i = v-i + 1.
     4690         if entry( v-i, new_round , chr(4) ) <> string ( loc_round ) then do:
     4691             message "На выбранных объектах используются разные параметры Наценки и округления ! Для расчета выбран" string ( loc_round ) skip "для товара  "
     4692             skip
     4693             "код     :" p-gds-code  skip
     4694             "бар-код :" p-b-code    skip
     4695             "артикул :" p-artic     skip
     4696             "производитель :" p-prod-type        p-prod-code
     4697             view-as alert-box information .
     4698             leave.
     4699         end.
     4700         if entry( v-i, new_vat-pc , chr(4) ) <> string ( local_vat-pc ) then do:
     4701             message "На выбранных объектах используются разные НДС ! Для расчета выбран" string ( local_vat-pc ) "%" skip "для товара  "
     4702             skip
     4703             "код     :" p-gds-code  skip
     4704             "бар-код :" p-b-code    skip
     4705             "артикул :" p-artic     skip
     4706             "производитель :" p-prod-type        p-prod-code
     4707             view-as alert-box information .
     4708             leave.
     4709         end.
     4710         if entry( v-i, new_slt-pc , chr(4) ) <> string ( local_slt-pc ) then do:
     4711             message "На выбранных объектах используются разные НсП ! Для расчета выбран" string ( local_slt-pc )
     4712             skip
     4713             "код     :" p-gds-code   skip
     4714             "бар-код :" p-b-code    skip
     4715             "артикул :" p-artic             skip
     4716             "производитель :" p-prod-type        p-prod-code
     4717             view-as alert-box information .
     4718             leave.
     4719         end.
     4720     end.
     4721   assign
     4722     p-vat-pc  = local_vat-pc
     4723     p-slt-pc  = local_slt-pc
     4724   .
     4725   find first buf_price-list-type no-lock where
     4726              buf_price-list-type.plt-id     = v-plt-id    and
     4727              buf_price-list-type.plt-db-num = v-plt-db-num
     4728              no-error .
     4729      if error-status :error then do:
     4730       message
     4731         vss-workfile vss-revision vss-description skip
     4732         error-status :get-message(1) skip
     4733         return-value skip
     4734         "q5"
     4735         view-as alert-box error
     4736       .
