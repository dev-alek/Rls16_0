     7376   procedure re-define :
     7377   define input-output parameter p-calc-method      as character no-undo .
     7378   define input        parameter p-gds-code         as integer   no-undo .
     7379     do
     7380     on error undo, return error return-value
     7381     :
     7382   define buffer buf_goods for ub.goods  .
     7383   define buffer buf_gds-grp for ub.gds-grp  .
     7384       case p-calc-method :
     7385         when 'Товар':U then do:
     7386              find first buf_goods no-lock where buf_goods.gds-code = p-gds-code no-error .
     7387                   case buf_goods.calc-method:
     7388                     when 'Группа':U then do:
     7389                       find first buf_gds-grp no-lock where
     7390                                  buf_gds-grp.node-code = buf_goods.grp-code no-error .
     7391                       p-calc-method  = buf_gds-grp.calc-method.
     7392                     end.
     7393                   otherwise do:
     7394                       p-calc-method  =  buf_goods.calc-method .
     7395                   end.
     7396                   end case.
     7397              run  re-define in this-procedure (
     7398                         input-output  p-calc-method ,
     7399                         input p-gds-code )  .
     7400         end.
     7401         when 'Группа':U then do:
     7402              find first buf_goods no-lock where buf_goods.gds-code = p-gds-code no-error .
     7403              find first buf_gds-grp no-lock where
     7404                         buf_gds-grp.node-code = buf_goods.grp-code no-error .
     7405              run re-define in this-procedure (
     7406                         input-output buf_gds-grp.calc-method ,
     7407                         input p-gds-code )  .
     7408         end.
     7409         when 'Учетная':U or
     7410         when 'Учет-объект':U then do:
     7411              p-calc-method = 'УчетнаяS':U .
     7412         end.
     7413         when 'Учет-резерв':U then do:
     7414              p-calc-method = 'Учет-рзрвS':U.
     7415         end.
     7416         when 'Приходная':U or
     7417         when 'Прих-объект':U then do:
     7418              p-calc-method = 'ПриходнаяS':U.
     7419         end.
     7420         when 'Учет-безНДС':U then do:
     7421              p-calc-method = 'Учет-НДСS':U .
     7422         end.
     7423       end case.
     7424     end.
     7425   end procedure.
     7426   procedure create-line-pdf-mpl-lib :
     7427   define input  parameter  p-plt-db-num as integer   no-undo .
