     4226            assign
     4227                 ub.contract-specif-attr.contract-num = p-contract-num
     4228                 ub.contract-specif-attr.host-code    = p-host-code
     4229                 ub.contract-specif-attr.gds-code     = p-gds-code
     4230                 ub.contract-specif-attr.attr-code    = 'prc-min':U
     4231                 ub.contract-specif-attr.attr-value  = string (v-prc-min)
     4232            .
     4233         end.
     4234         else do:
     4235            ub.contract-specif-attr.attr-value  = string (v-prc-min) .
     4236         end.
     4237       find first ub.contract-specif exclusive-lock where
     4238           ub.contract-specif.contract-num = p-contract-num and
