     1984   function hvrdtax return logical (input parrecid as recid):
     1985   define variable varresult as logical no-undo.
     1986   run hvrdtax-proc (input parrecid, output varresult).
     1987   return varresult.
     1988   end function.
     1989   procedure hvrdtax-proc:
     1990   define input  parameter parrecid  as recid   no-undo.
     1991   define output parameter parresult as logical no-undo.
     1992   define buffer bf_goods for ub.goods.
     1993   define buffer bf_units for ub.units.
     1994   define buffer rt_tax   for ub.tax.
     1995   find first rt_tax   where rt_tax.tax-code    = integer('3':U) no-lock no-error.
     1996   find first bf_goods where recid(bf_goods)    = parrecid              no-lock.
     1997   find first bf_units where bf_units.unit-name = bf_goods.unit-base    no-lock.
     1998   if available rt_tax and
     1999       can-find(first ub.tax-units No-LOCK WHERE
     2000                      ub.tax-units.tax-code = rt_tax.tax-code AND
     2001                      LOOKUP(ub.tax-units.type, bf_units.type) > 0) then assign parresult = yes.
     2002                                                       else assign parresult = no.
     2003   end procedure.
     2004   define buffer buf_price-doc-forming for ub.price-doc-forming  .
     2005   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2006   FUNCTION fnc-base-price RETURN decimal (local-bc      as integer,
     2007                                           local-doc-num as char).
     2008   define buffer base-price        for ub.price-list.
     2009   define variable local-main-code like ub.bar-code.b-code no-undo.
     2010   define variable local-base-code like ub.bar-code.b-code no-undo.
     2011     run prc-base-code (input local-bc, output local-base-code).
     2012     find base-price no-lock where
     2013          base-price.doc-num = local-doc-num and
     2014          base-price.b-code  = local-base-code and
     2015          base-price.price-type = "" no-error.
     2016     if not available base-price then do:
     2017       run prc-main-code (input local-bc, output local-main-code).
     2018       find  base-price no-lock where
     2019             base-price.doc-num = local-doc-num and
     2020             base-price.b-code  = local-main-code and
     2021             base-price.price-type = "" no-error.
     2022     end.
     2023     if available base-price then
     2024       return (base-price.price-sale).
     2025     else
     2026       return (?).
     2027   END FUNCTION.
     2028   procedure prc-main-code:
     2029   define input  parameter local-bc        like ub.bar-code.b-code no-undo.
     2030   define output parameter local-main-code like ub.bar-code.b-code no-undo.
     2031   define buffer local-bar-code        for ub.bar-code.
     2032   define buffer local-goods           for ub.goods.
     2033   define buffer main-code             for ub.bar-code.
     2034   define buffer main-prt              for ub.gds-prt.
     2035     local-main-code = ?.
     2036     find local-bar-code no-lock where
     2037          local-bar-code.b-code = local-bc no-error.
     2038     if not available local-bar-code then
     2039       return.
     2040     find local-goods no-lock where
     2041          local-goods.gds-code = local-bar-code.gds-code.
     2042     find first  main-prt no-lock where
     2043                 main-prt.upper-code = local-goods.prt-root.
     2044     find  main-code no-lock where
     2045           main-code.gds-code  = local-bar-code.gds-code and
     2046           main-code.in-code   = "" and
     2047           main-code.part-code = "" and
     2048           main-code.unit-cli  = local-goods.unit-base and
     2049           main-code.node-code = main-prt.node-code.
     2050     local-main-code = main-code.b-code.
     2051   end procedure.
     2052   procedure prc-base-code:
     2053   define input  parameter local-bc        like ub.bar-code.b-code no-undo.
     2054   define output parameter local-base-code like ub.bar-code.b-code no-undo.
     2055   define buffer local-bar-code for ub.bar-code.
     2056   define buffer local-goods    for ub.goods.
     2057   define buffer base-code      for ub.bar-code.
     2058     local-base-code = ?.
     2059     find local-bar-code no-lock where
     2060          local-bar-code.b-code = local-bc no-error.
     2061     if not available local-bar-code then
     2062       return.
     2063     find local-goods no-lock where
     2064          local-goods.gds-code = local-bar-code.gds-code.
     2065     find base-code no-lock where
     2066          base-code.gds-code  = local-bar-code.gds-code and
     2067          base-code.node-code = local-bar-code.node-code and
     2068          base-code.in-code   = local-bar-code.in-code and
     2069          base-code.part-code = local-bar-code.part-code and
     2070          base-code.unit-cli  = local-goods.unit-base.
     2071     local-base-code = base-code.b-code.
     2072   end procedure.
     2073   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2074   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2075   procedure prcreate-new-price-doc :
