     7038                 free_parts.out-code  = 'free-zone':U       and
     7039                 free_parts.rsrv-free = true               and
     7040                 free_parts.status_   = false              and
     7041                 free_parts.obj-type  = bf_parts.obj-type  and
     7042                 free_parts.obj-code  = bf_parts.obj-code  and
     7043                 free_parts.artic     = bf_parts.artic     and
