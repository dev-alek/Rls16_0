     7291      , output v-d-pcnt
     7292      ) no-error .
     7293      if error-status :error then
     7294      message
     7295        vss-workfile vss-revision vss-description skip
     7296        error-status :get-message(1) skip
     7297        return-value skip
     7298        "123calc-price-line"
     7299        "p-calc-method     "  p-calc-method     skip
     7300        "p-increase-pc     "  p-increase-pc     skip
     7301        "round-method      "    round-method    skip
     7302        "round-base        "    round-base      skip
     7303        "p-b-code          "    p-b-code        skip
     7304        "p-gds-code        "    p-gds-code      skip
     7305        "p-artic           "    p-artic         skip
     7306        "p-prod-type       "    p-prod-type     skip
     7307        "p-prod-code       "    p-prod-code     skip
     7308        "v-base-rate       "   v-base-rate     skip
