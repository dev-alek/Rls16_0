     4290            if error-status:error then
     4291               message "Превышен допустимый объем информации о ретро-бонусах. Удалите исторические или неактуальны периоды" view-as alert-box error.
     4292         end.
     4293       find first ub.contract-specif exclusive-lock where
     4294           ub.contract-specif.contract-num = p-contract-num and
