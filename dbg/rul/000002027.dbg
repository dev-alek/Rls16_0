     5550   p-new-calc-method = p-calc-method .
     5551   run re-define in this-procedure (
     5552       input-output p-calc-method
     5553     , input p-gds-code
     5554     ) .
     5555     define variable v-sps as character no-undo .
     5556   v-sps =
     5557    "Товар,
     5558   Группа,
     5559   Учетная,
     5560   Учет-объект,
     5561   Учет-резерв,
     5562   Приходная,
     5563   Прих-объект,
     5564   Начальная,
     5565   Старая,
     5566   Новая,
     5567   Объект,
     5568   Накладная,
     5569   Накл-безНДС,
     5570   Учет-безНДС,
     5571   Стар-безНДС,
     5572   Переоценка,
     5573   ДокФормЦены,
     5574   Отсутствует,
     5575   Признак,
     5576   Специальная,
     5577   Не-считать,
     5578   Основная,
     5579   Единая,
     5580   Учет+накл,
     5581   Уч+накл-НДС,
     5582   НсП,
     5583   НсП+накл,
     5584   УчетнаяS,
     5585   Учет-рзрвS,
     5586   ПриходнаяS,
     5587   Учет-НДСS,
     5588   Откат_цен,
     5589   Спецификация
     5590   "
     5591     .
     5592   if lookup ( p-calc-method , v-sps )  = 0 then  do:
     5593       p-calc-method = entry (1,p-calc-method, " ") no-error .
     5594       if error-status :error then message p-calc-method.
     5595   end.
     5596   define variable v-i as integer   no-undo init 0.
     5597     for each  x_obj-group :
     5598         v-i = v-i + 1.
     5599         if entry( v-i, new_round , chr(4) ) <> string ( loc_round ) then do:
     5600             message "На выбранных объектах используются разные параметры Наценки и округления ! Для расчета выбран" string ( loc_round ) skip "для товара  "
     5601             skip
     5602             "код     :" p-gds-code  skip
     5603             "бар-код :" p-b-code    skip
     5604             "артикул :" p-artic     skip
     5605             "производитель :" p-prod-type        p-prod-code
     5606             view-as alert-box information .
     5607             leave.
     5608         end.
     5609         if entry( v-i, new_vat-pc , chr(4) ) <> string ( local_vat-pc ) then do:
     5610             message "На выбранных объектах используются разные НДС ! Для расчета выбран" string ( local_vat-pc ) "%" skip "для товара  "
     5611             skip
     5612             "код     :" p-gds-code  skip
     5613             "бар-код :" p-b-code    skip
     5614             "артикул :" p-artic     skip
     5615             "производитель :" p-prod-type        p-prod-code
     5616             view-as alert-box information .
     5617             leave.
     5618         end.
     5619         if entry( v-i, new_slt-pc , chr(4) ) <> string ( local_slt-pc ) then do:
     5620             message "На выбранных объектах используются разные НсП ! Для расчета выбран" string ( local_slt-pc )
     5621             skip
     5622             "код     :" p-gds-code   skip
     5623             "бар-код :" p-b-code    skip
     5624             "артикул :" p-artic             skip
     5625             "производитель :" p-prod-type        p-prod-code
     5626             view-as alert-box information .
     5627             leave.
     5628         end.
     5629     end.
     5630   p-vat-pc  = local_vat-pc .
     5631   p-slt-pc  = local_slt-pc .
     5632     if available buf_price-doc-forming then do:
     5633        find first buf_price-list-type no-lock where
     5634                   buf_price-list-type.plt-id     = buf_price-doc-forming.plt-id    and
     5635                   buf_price-list-type.plt-db-num = buf_price-doc-forming.plt-db-num
     5636                   no-error .
     5637        if error-status :error then return error return-value .
     5638     end.
     5639     else do:
     5640   find first buf_price-list-type no-lock where
     5641              buf_price-list-type.plt-id     = v-plt-id    and
