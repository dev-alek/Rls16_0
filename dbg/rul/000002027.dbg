     5756      when 'Накладная':U then do:
     5757           find first buf_trn-doc no-lock where buf_trn-doc.doc-code = v-doc-code no-error .
     5758           find first buf_doc-line  no-lock where
     5759                     buf_doc-line.doc-code = v-doc-code      and
     5760                     buf_doc-line.artic    = p-artic         and
     5761                     buf_doc-line.prod-type   = p-prod-type  and
     5762                     buf_doc-line.prod-code   = p-prod-code no-error .
     5763           find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     5764           find first buf_gds-dtl no-lock where
     5765                      buf_gds-dtl.doc-code  = v-doc-code   and
     5766                      buf_gds-dtl.artic     = p-artic      and
     5767                      buf_gds-dtl.prod-type = p-prod-type  and
     5768                      buf_gds-dtl.prod-code = p-prod-code  and
     5769                      buf_gds-dtl.prt-code  = buf_bar-code.node-code no-error .
     5770           assign
     5771             v1 = recid (buf_trn-doc)
     5772             v2 = recid (buf_doc-line)
     5773             v3 = recid (buf_gds-dtl)
     5774             v4  = buf_gds-dtl.prt-code
     5775             no-error .
