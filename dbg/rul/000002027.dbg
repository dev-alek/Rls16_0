     4473        "Ошибка метода поиска наценки товара на объекте" skip
     4474        error-status :get-message(1) .
     4475     end.
     4476   run gds-attr-margin-value
     4477   ( input   p-gds-code           ,
     4478     input   x_obj-group.obj-type ,
     4479     input   x_obj-group.obj-code ,
     4480     output  p-prc-min            ,
