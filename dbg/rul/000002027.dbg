     5727             output cur-rt-rubl
     5728             ).
     5729      end.
     5730      when 'Учет-НДСS':U or
     5731      when 'Накл-безНДС':U or
     5732      when 'Стар-безНДС':U or
     5733      when 'Старая':U or
