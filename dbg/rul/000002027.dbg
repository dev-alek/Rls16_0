        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-parent-handle as handle no-undo .
        4   define input parameter p-log-handle  as handle no-undo .
        5   define input parameter p-cont-handle  as handle no-undo .
        6   define input parameter p-codex-id as integer no-undo .
        7   define input parameter p-ruleset-id as integer no-undo .
        8   define input parameter p-call-id as character no-undo .
        9   define input parameter p-order-id as integer no-undo .
       10   define input parameter p-rule-id as integer no-undo .
       11   define input parameter p-profile-id as integer no-undo .
       12   define input parameter p-is-dynamic as logical no-undo .
       13   define input parameter p-doc-type as character no-undo .
       14   define input parameter p-host-code like ub.sysconf.host-code no-undo .
       15   define input parameter p-obj-type like ub.clients.obj-type no-undo .
       16   define input parameter p-obj-code like ub.clients.obj-code no-undo .
       17   define input parameter p-doc-code as character no-undo .
       18   define input parameter p-plt-id as integer no-undo .
       19   define input parameter p-plt-db-num as integer no-undo .
       20   define input parameter p-pdf-id as integer no-undo .
       21   define input parameter p-pdf-db-num as integer no-undo .
       22   define input parameter p-process-file-name as character no-undo .
       23   define input parameter p-save       as integer no-undo .
       24   define input parameter v-curr-r-b   as character no-undo .
       25   define input parameter p-cmd-proc-handle as handle no-undo .
       26   define input parameter p-cmd-code  as integer no-undo .
       27   define variable vss-revision    as character no-undo init "$Revision$":U .
       28   define variable vss-author      as character no-undo init "$Author$":U .
       29   define variable vss-date        as character no-undo init "$Date$":U .
       30   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       31   define variable vss-archive     as character no-undo init "$Archive$":U .
       32   define variable vss-description as character no-undo init "Библиотека процедур для работы с кодексом 18, набор 1".
       33   define variable v-pricewithvat as decimal   no-undo .
       34   define variable v-prod-vat     as decimal   no-undo .
       35   procedure vss-get-info :
       36     define output parameter p-vss-revision    like vss-revision    no-undo .
       37     define output parameter p-vss-author      like vss-author      no-undo .
       38     define output parameter p-vss-date        like vss-date        no-undo .
       39     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       40     define output parameter p-vss-archive     like vss-archive     no-undo .
       41     define output parameter p-vss-description like vss-description no-undo .
       42     assign
       43       p-vss-revision    = vss-revision
       44       p-vss-author      = vss-author
       45       p-vss-date        = vss-date
       46       p-vss-workfile    = vss-workfile
       47       p-vss-archive     = vss-archive
       48       p-vss-description = vss-description
       49     .
       50   end procedure.
       51   procedure vss-get-parameters :
       52     define output parameter p-vss-parameters as character no-undo .
       53   end procedure.
       54   define new global shared variable g#vssrevis-logger as handle    no-undo .
       55   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       56   define variable v-vssrevis-logger                   as handle    no-undo .
       57   procedure vss-logevent :
       58     define input  parameter p-extra-paramters as character no-undo .
       59     define variable v-vssrevis-parameters as character no-undo .
       60     do
       61     on error undo, return error return-value
       62     :
       63       if  valid-handle(v-vssrevis-logger)
       64       and v-vssrevis-logger :get-signature("logevent") <> ""
       65       then do:
       66         run vss-get-parameters in this-procedure
       67           (output v-vssrevis-parameters
       68           ).
       69         run logevent in v-vssrevis-logger
       70           (input vss-workfile
       71           ,input vss-revision
       72           ,input v-vssrevis-parameters
       73           ,input p-extra-paramters
       74           ).
       75       end.
       76     end.
       77   end procedure.
       78   assign
       79     v-vssrevis-logger = g#vssrevis-logger
       80   .
       81   if  valid-handle(v-vssrevis-logger)
       82   and v-vssrevis-logger :get-signature("logevent") <> ""
       83   then do:
       84     assign
       85       v-vssrevis-logevent = true
       86     .
       87     run vss-logevent in this-procedure (input vss-description) .
       88   end.
       89   define new global shared variable g#language as character no-undo .
       90   if g#language <> '' and g#language <> 'rus':U then do:
       91     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       92   end.
       93   define new global shared variable g#library  as handle no-undo .
       94   define new global shared variable g#library2 as handle no-undo .
       95   define   shared variable g#auto as logical no-undo.
       96   define   shared variable g#news as logical no-undo.
       97   define   shared variable g#oxml as logical no-undo.
       98   define   shared variable g#esys as logical no-undo.
       99   define   shared variable g#news-source-db as integer no-undo.
      100   define   shared variable g#esys-source-esys as integer no-undo.
      101   define   shared variable g#db-num as integer   no-undo .
      102   define   shared variable g#userid as character no-undo .
      103   define   shared variable g#passwd as character no-undo .
      104   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      105   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      106   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      107   define variable par-type          as character no-undo.
      108   define variable v-value-character as character no-undo .
      109   define variable v-value-date      as date      no-undo .
      110   define variable v-value-decimal   as decimal   no-undo .
      111   define variable v-value-integer   as integer   no-undo .
      112   define variable v-value-logical   as logical   no-undo .
      113   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      114   define  variable garbcoll_ii as integer no-undo .
      115   define  temp-table temp-gc no-undo
      116   field ii as integer
      117   field obj-r as handle
      118   field cn as character
      119   index pi is unique primary
      120   ii
      121   index icn
      122   cn.
      123   procedure garbcoll_create-gc-entry :
      124   define input parameter p-cn as character no-undo .
      125   define input parameter p-obj-r as handle no-undo .
      126     do
      127     on error undo, return error
      128     :
      129       create temp-gc.
      130       assign
      131       temp-gc.ii = garbcoll_ii
      132       garbcoll_ii = garbcoll_ii + 1
      133       temp-gc.cn = p-cn
      134       temp-gc.obj-r = p-obj-r
      135       .
      136     end.
      137   end procedure.
      138   procedure garbcoll_clear :
      139     do
      140     on error undo, return error
      141     :
      142       for each temp-gc:
      143         delete object temp-gc.obj-r.
      144         delete temp-gc.
      145       end.
      146     end.
      147   end procedure.
      148   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      149   procedure cur-time :
      150      define output parameter p-today as date      no-undo .
      151      define output parameter p-time  as integer   no-undo .
      152     do
      153     on error undo, return error
      154     :
      155       define variable v-date1 as date      no-undo .
      156       define variable v-date2 as date      no-undo .
      157       define variable v-time  as integer   no-undo .
      158       assign
      159         v-date1 = today
      160         v-time  = time
      161         v-date2 = today
      162       .
      163       if v-date1 <> v-date2
      164       then do:
      165         assign
      166           v-date1 = today
      167           v-time  = v-time
      168         .
      169       end.
      170       assign
      171         p-today = v-date1
      172         p-time  = v-time
      173       .
      174     end.
      175   end.
      176   function cur-time-date returns character
      177   :
      178     return string(today, '99/99/9999':U) .
      179   end.
      180   function cur-time-mjd returns decimal
      181   :
      182     define variable v-date as date      no-undo .
      183     define variable v-time as integer   no-undo .
      184     run cur-time in this-procedure
      185       (output v-date
      186       ,output v-time
      187       ) .
      188     return integer(v-date) - 2400002 + (v-time / 86400) .
      189   end.
      190   function cur-time-get-ending-index returns integer
      191   (input p-number as integer
      192   )
      193   :
      194     if p-number < 0
      195     or p-number = ?
      196     then do:
      197       return 1 .
      198     end.
      199     define variable v-rest as integer   no-undo .
      200     assign
      201       p-number = p-number modulo 100
      202     .
      203     if p-number < 20
      204     then do:
      205       assign
      206         v-rest = p-number
      207       .
      208     end.
      209     else do:
      210       assign
      211         v-rest = p-number modulo 10
      212       .
      213     end.
      214     case v-rest :
      215       when 1
      216       then do:
      217         return 2 .
      218       end.
      219       when 2 or
      220       when 3 or
      221       when 4
      222       then do:
      223         return 3 .
      224       end.
      225       otherwise do:
      226         return 1 .
      227       end.
      228     end case .
      229   end.
      230   procedure cur-time-mjd-to-date :
      231      define input  parameter i-mjd-diff as decimal no-undo.
      232      define output parameter o-Date     as date    no-undo.
      233      define output parameter o-Time     as integer no-undo.
      234      define variable v-day-number as integer   no-undo .
      235      if    i-mjd-diff < 0
      236         or i-mjd-diff = ?
      237      then do:
      238         return "?" .
      239      end.
      240      assign
      241         v-day-number = truncate(i-mjd-diff,0).
      242         o-Date = date(v-day-number + 2400002).
      243         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      244     .
      245   end.
      246   function cur-time-mjd-to-string returns character
      247   (input p-mjd-diff as decimal
      248   )
      249   :
      250     define variable v-day-number as integer   no-undo .
      251     define variable v-seconds    as integer   no-undo .
      252     define variable v-hour       as integer   no-undo .
      253     define variable v-min        as integer   no-undo .
      254     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      255     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      256     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      257     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      258     if p-mjd-diff < 0
      259     or p-mjd-diff = ?
      260     then do:
      261       return "?" .
      262     end.
      263     assign
      264       v-day-number = integer(truncate(p-mjd-diff,0))
      265       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      266     .
      267     if v-seconds > 86400
      268     then do:
      269       assign
      270         v-seconds = 86400 - 1
      271       .
      272     end.
      273     if v-seconds < 0
      274     then do:
      275       assign
      276         v-seconds = 0
      277       .
      278     end.
      279     assign
      280       v-hour = truncate(v-seconds / 3600, 0)
      281     .
      282     assign
      283       v-seconds = v-seconds modulo 3600
      284     .
      285     assign
      286       v-min = truncate(v-seconds / 60, 0)
      287     .
      288     assign
      289       v-seconds = v-seconds modulo 60
      290     .
      291     return
      292         (if v-day-number <> 0
      293           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      294           else ""
      295         )
      296       + (if v-day-number <> 0 or v-hour <> 0
      297           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      298           else ""
      299         )
      300       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      301           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      302           else ""
      303         )
      304       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      305       .
      306   end.
      307   function cur-time-string returns character
      308   :
      309     define variable v-date as date      no-undo .
      310     define variable v-time as integer   no-undo .
      311     run cur-time in this-procedure
      312       (output v-date
      313       ,output v-time
      314       ) .
      315     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      316   end.
      317   function cur-time-string-sec returns character
      318   :
      319     define variable v-date as date      no-undo .
      320     define variable v-time as integer   no-undo .
      321     run cur-time in this-procedure
      322       (output v-date
      323       ,output v-time
      324       ) .
      325     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      326   end.
      327   function cur-time-custom  returns character
      328   (input p-prefix as character
      329   ,input p-date-format as character
      330   ,input p-delimiter as character
      331   ,input p-time-format as character
      332   ,input p-suffix as character
      333   )
      334   :
      335     define variable v-date as date      no-undo .
      336     define variable v-time as integer   no-undo .
      337     run cur-time in this-procedure
      338       (output v-date
      339       ,output v-time
      340       ) .
      341     return
      342       p-prefix
      343       + string(v-date, p-date-format)
      344       + p-delimiter
      345       + string(v-time, p-time-format)
      346       + p-suffix
      347       .
      348   end.
      349   function cur-time-print  returns character
      350   :
      351     define variable v-date as date      no-undo .
      352     define variable v-time as integer   no-undo .
      353     run cur-time in this-procedure
      354       (output v-date
      355       ,output v-time
      356       ) .
      357     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      358   end.
      359   function cur-time-datetime returns datetime
      360   :
      361     define variable v-char as character no-undo .
      362     define variable v-datetime as datetime no-undo .
      363     v-char = cur-time-string().
      364     v-datetime = datetime(v-char).
      365     return  v-datetime.
      366   end.
      367   function cur-time-string-msec returns character
      368   :
      369     define variable v-date as datetime  no-undo .
      370     v-date = now.
      371     return string(v-date) .
      372   end.
      373   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      374   define new global shared variable g#lib-nws as handle no-undo .
      375   define new global shared variable g#lib-trn  as handle no-undo .
      376   define new global shared variable g#lib-trn2 as handle no-undo .
      377   define new global shared variable g#lib-trn3 as handle no-undo .
      378   define new global shared variable g#lib-trn4 as handle no-undo .
      379   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      380   def var vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      381   procedure gen-key-rec :
      382     define input  parameter p-tbl-name    as character no-undo.
      383     define input  parameter p-bh_tbl-name as handle    no-undo.
      384     define output parameter p-key-rec     as character no-undo.
      385     do
      386     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      387     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      388     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      389     :
      390       define variable fh               as handle    no-undo .
      391       define variable v-ok             as logical   no-undo .
      392       define variable v-inform         as character no-undo .
      393       define variable v-ind            as integer   no-undo .
      394       define variable v-idx-field-qnty as integer   no-undo .
      395       if p-tbl-name = ?
      396         or p-tbl-name = "":U
      397       then do:
      398         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info6 ).
      399       end.
      400       if not p-bh_tbl-name:available then do:
      401         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info6, p-tbl-name ).
      402       end.
      403       assign
      404         p-key-rec = p-tbl-name
      405         v-inform  = p-bh_tbl-name:index-information(1)
      406         v-ind     = 2
      407       .
      408       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      409       on error undo, return error
      410       :
      411         assign
      412           v-inform = p-bh_tbl-name:index-information( v-ind )
      413           v-ind    = v-ind + 1
      414         .
      415       end.
      416       if v-inform = ?
      417         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      418         or entry( 3, v-inform, ",":U ) <> "1":U
      419       then do:
      420         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info6, p-tbl-name ).
      421       end.
      422       else do:
      423         assign
      424           v-idx-field-qnty = num-entries( v-inform ) - 4
      425         .
      426         if v-idx-field-qnty < 2 then do:
      427           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info6, v-inform, p-tbl-name ).
      428         end.
      429         do v-ind = 1 to v-idx-field-qnty by 2
      430         on error undo, return error
      431         :
      432           assign
      433             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      434             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      435           .
      436         end.
      437       end.
      438       if p-key-rec = ? then do:
      439         assign
      440           p-key-rec = "":U
      441         .
      442         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info6, p-tbl-name ).
      443       end.
      444     end.
      445     return.
      446   end procedure.
      447   procedure gen-where-keyr-tab :
      448     define input  parameter i-tableSerach as character no-undo.
      449     define input  parameter i-tablekey   as character  no-undo.
      450     define input  parameter p-key-rec    as character  no-undo.
      451     define input  parameter p-key-handle as handle     no-undo .
      452     define input  parameter p-db-name    as character  no-undo .
      453     define input  parameter p-tt-handle  as handle     no-undo .
      454     define output parameter o-Where      as character  no-undo.
      455     do
      456     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      457     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      458     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      459     :
      460       define variable v-full-tbl-name  as character no-undo .
      461       define variable bh_tbl-name      as handle    no-undo .
      462       define variable fh_key           as handle    no-undo .
      463       define variable fh_search        as handle    no-undo .
      464       define variable v-field-num      as integer   no-undo .
      465       define variable v-count-fld      as integer   no-undo .
      466       define variable v-inform         as character no-undo .
      467       define variable v-ind            as integer   no-undo .
      468       define variable v-idx-field-qnty as integer   no-undo .
      469       define variable v-field-name     as character no-undo .
      470       define variable v-field-val      as character no-undo .
      471       define variable v-word-link      as character no-undo .
      472       define variable vTable           as character no-undo.
      473       define variable bh_tbl-key       as handle    no-undo .
      474       assign
      475         p-key-rec = trim( p-key-rec )
      476       .
      477       if p-key-handle <> ? then do:
      478         if not valid-handle(p-key-handle)
      479            or p-key-handle:type <> "buffer"
      480         then do:
      481           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info6 ).
      482         end.
      483         if num-entries( p-key-rec, chr(3) ) > 1
      484           or p-key-rec = ?
      485           or p-key-rec = "":U
      486         then do:
      487           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info6, p-key-rec ).
      488         end.
      489       end.
      490       else do:
      491         if p-key-rec = ?
      492           or p-key-rec = "":U
      493         then do:
      494           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info6 ).
      495         end.
      496       end.
      497       assign
      498         vTable = entry( 1 , p-key-rec, chr(3) )
      499       .
      500       if p-tt-handle <> ?
      501         and ( not valid-handle(p-tt-handle)
      502               or p-tt-handle:type <> "buffer"
      503             )
      504       then do:
      505         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info6, vTable, chr(10) ).
      506       end.
      507       if p-tt-handle = ? then do:
      508         assign
      509           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      510         .
      511         create buffer bh_tbl-name for table v-full-tbl-name .
      512       end.
      513       else do:
      514         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      515       end.
      516       assign
      517         v-inform = bh_tbl-name:index-information(1)
      518         v-ind    = 2
      519       .
      520       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      521       on error undo, return error
      522       :
      523         assign
      524           v-inform = bh_tbl-name:index-information( v-ind )
      525           v-ind    = v-ind + 1
      526         .
      527       end.
      528       if v-inform = ?
      529         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      530         or entry( 3, v-inform, ",":U ) <> "1":U
      531       then do:
      532         delete object bh_tbl-name no-error.
      533         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info6, vTable ).
      534       end.
      535       assign
      536         v-idx-field-qnty = num-entries( v-inform ) - 4
      537       .
      538       if v-idx-field-qnty < 2 then do:
      539         delete object bh_tbl-name no-error.
      540         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info6, v-inform, vTable ).
      541       end.
      542       assign
      543         o-where     = "where":U
      544         v-word-link = "":U
      545         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      546         v-count-fld = 0
      547       .
      548       if i-tablekey ne "" and i-tablekey ne ?
      549       then do:
      550         assign
      551           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      552         .
      553         create buffer bh_tbl-key for table v-full-tbl-name .
      554       end.
      555       if i-tableSerach ne "" and i-tableSerach ne ?
      556       then do:
      557         delete object bh_tbl-name no-error.
      558         assign
      559           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      560         .
      561         create buffer bh_tbl-name for table v-full-tbl-name .
      562       end.
      563       block_where:
      564       do v-ind = 1 to v-idx-field-qnty by 2
      565       on error undo, return error
      566       :
      567         assign
      568           v-count-fld = v-count-fld + 1
      569         .
      570         if p-key-handle = ?
      571           and v-count-fld > v-field-num
      572         then do:
      573           leave block_where.
      574         end.
      575         define variable VfieldKeyTable as handle no-undo.
      576         assign
      577           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      578           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      579         .
      580         if     bh_tbl-key ne ?
      581         then do:
      582            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      583            if VfieldKeyTable eq ?
      584            then next block_where.
      585         end.
      586         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      587         then
      588            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      589         else
      590            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      591         if p-key-handle = ? then do:
      592           assign
      593             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      594           .
      595         end.
      596         else do:
      597           assign
      598             fh_key = p-key-handle:buffer-field( v-field-name )
      599           .
      600           if fh_key = ?
      601             or not valid-handle( fh_key )
      602           then do:
      603             delete object bh_tbl-name.
      604             if     bh_tbl-key ne ?
      605             then
      606                delete object bh_tbl-key.
      607             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info6, p-key-handle:name, v-field-name ).
      608           end.
      609           assign
      610             v-field-val = fh_key:buffer-value
      611           .
      612         end.
      613         if fh_search:data-type ="character":U then do:
      614           assign
      615             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      616             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      617             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      618             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      619             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      620             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      621             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      622             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      623             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      624             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      625             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      626             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      627             v-field-val = substitute( '"&1"', v-field-val )
      628           .
      629         end.
      630         assign
      631           o-where = substitute( "&1 &2", o-where, v-field-val )
      632         .
      633         if v-word-link = "":U then do:
      634           assign
      635             v-word-link = "and":U
      636           .
      637         end.
      638       end.
      639       delete object bh_tbl-name.
      640       if     bh_tbl-key ne ?
      641       then
      642          delete object bh_tbl-key.
      643       if p-key-handle = ?
      644         and v-count-fld <> v-field-num
      645       then do:
      646         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info6, vTable ).
      647       end.
      648     end.
      649   end procedure.
      650   procedure gen-hn-keyr-tab :
      651     define input  parameter i-tableSerach as character no-undo.
      652     define input  parameter i-tablekey   as character no-undo.
      653     define input  parameter p-key-rec    as character no-undo.
      654     define input  parameter p-key-handle as handle    no-undo .
      655     define input  parameter p-db-name    as character no-undo .
      656     define input  parameter p-tt-handle  as handle    no-undo .
      657     define input  parameter p-stts-lock  as integer   no-undo .
      658     define output parameter o-hn         as handle    no-undo.
      659     define variable v-full-tbl-name as character no-undo.
      660     define variable v-where         as character no-undo.
      661     define variable bh_tbl-name     as handle    no-undo.
      662     define variable vTable          as character no-undo.
      663     do
      664     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      665     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      666     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      667         run gen-where-keyr-tab(i-tableSerach,
      668                                i-tablekey,
      669                                p-key-rec,
      670                                p-key-handle,
      671                                p-db-name,
      672                                p-tt-handle,
      673                                output v-where).
      674         if i-tableSerach ne "" and i-tableSerach ne ?
      675         then do:
      676            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      677            create buffer bh_tbl-name for table v-full-tbl-name .
      678         end.
      679         else do:
      680            if p-tt-handle = ? then do:
      681               assign
      682                  vTable = entry( 1 , p-key-rec, chr(3) )
      683               .
      684               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      685               create buffer bh_tbl-name for table v-full-tbl-name .
      686            end.
      687            else do:
      688               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      689            end.
      690         end.
      691         if p-tt-handle = ? then do:
      692            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      693         end.
      694         else do:
      695            bh_tbl-name:find-first( v-where ) no-error .
      696         end.
      697         o-hn = bh_tbl-name.
      698      end.
      699   end procedure.
      700   procedure gen-hn-keyr :
      701     define input  parameter p-key-rec    as character no-undo.
      702     define input  parameter p-key-handle as handle    no-undo .
      703     define input  parameter p-db-name    as character no-undo .
      704     define input  parameter p-tt-handle  as handle    no-undo .
      705     define input  parameter p-stts-lock  as integer   no-undo .
      706     define output parameter o-hn         as handle    no-undo.
      707     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      708   end.
      709   procedure gen-row-keyr :
      710     define input  parameter p-key-rec    as character no-undo.
      711     define input  parameter p-key-handle as handle    no-undo .
      712     define input  parameter p-db-name    as character no-undo .
      713     define input  parameter p-tt-handle  as handle    no-undo .
      714     define input  parameter p-stts-lock  as integer   no-undo .
      715     define output parameter p-tbl-row    as rowid     no-undo.
      716     define output parameter p-tbl-name   as character no-undo.
      717     define variable vHn as handle no-undo.
      718       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      719       p-tbl-row = if vHn:available then vHn:rowid else ?.
      720       p-tbl-name =  vHn:table.
      721       delete object vHn no-error.
      722     if p-tbl-row = ? then do:
      723       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info6, p-tbl-name, p-key-rec ).
      724     end.
      725     else do:
      726       return.
      727     end.
      728   end procedure.
      729   procedure gen-key-fv :
      730     define input  parameter p-key-rec    as character no-undo .
      731     define output parameter p-field-list as character no-undo .
      732     define output parameter p-value-list as character no-undo.
      733     do
      734     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      735     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      736     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      737     :
      738       define variable v-full-tbl-name  as character no-undo .
      739       define variable bh_tbl-name      as handle    no-undo .
      740       define variable v-tbl-name       as character no-undo .
      741       define variable v-field-num      as integer   no-undo .
      742       define variable v-count-fld      as integer   no-undo .
      743       define variable v-inform         as character no-undo .
      744       define variable v-ind            as integer   no-undo .
      745       define variable v-idx-field-qnty as integer   no-undo .
      746       define variable v-delim-key      as character no-undo .
      747       if p-key-rec = ?
      748         or p-key-rec = "":U
      749       then do:
      750         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info6 ).
      751       end.
      752       assign
      753         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      754         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      755       .
      756       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      757       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info6 ).
      758       assign
      759         v-inform = bh_tbl-name:index-information(1)
      760         v-ind    = 2
      761       .
      762       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      763       on error undo, return error
      764       :
      765         assign
      766           v-inform = bh_tbl-name:index-information( v-ind )
      767           v-ind    = v-ind + 1
      768         .
      769       end.
      770       if v-inform = ?
      771         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      772         or entry( 3, v-inform, ",":U ) <> "1":U
      773       then do:
      774         delete object bh_tbl-name no-error.
      775         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info6, v-tbl-name ).
      776       end.
      777       assign
      778         v-idx-field-qnty = num-entries( v-inform ) - 4
      779       .
      780       if v-idx-field-qnty < 2 then do:
      781         delete object bh_tbl-name no-error.
      782         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info6, v-inform, v-tbl-name ).
      783       end.
      784       assign
      785         p-field-list = "":U
      786         p-value-list = "":U
      787         v-delim-key  = "":U
      788         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      789         v-count-fld  = 0
      790       .
      791       block_where:
      792       do v-ind = 1 to v-idx-field-qnty by 2
      793       on error undo, return error
      794       :
      795         assign
      796           v-count-fld = v-count-fld + 1
      797         .
      798         if v-count-fld > v-field-num then do:
      799           leave block_where.
      800         end.
      801         assign
      802           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      803           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      804         .
      805         if v-ind = 1 then do:
      806           assign
      807             v-delim-key = chr(3)
      808           .
      809         end.
      810       end.
      811       delete object bh_tbl-name.
      812       if v-count-fld <> v-field-num then do:
      813         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info6, v-tbl-name ).
      814       end.
      815     end.
      816   end procedure.
      817   procedure gen-key-field :
      818     define input  parameter p-table      as character no-undo .
      819     define output parameter p-field-list as character no-undo .
      820     do
      821     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      822     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      823     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      824     :
      825       define variable v-full-tbl-name  as character no-undo .
      826       define variable bh_tbl-name      as handle    no-undo .
      827       define variable v-tbl-name       as character no-undo .
      828       define variable v-field-num      as integer   no-undo .
      829       define variable v-count-fld      as integer   no-undo .
      830       define variable v-inform         as character no-undo .
      831       define variable v-ind            as integer   no-undo .
      832       define variable v-idx-field-qnty as integer   no-undo .
      833       define variable v-delim-key      as character no-undo .
      834       if p-table = ?
      835         or p-table = "":U
      836       then do:
      837         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info6 ).
      838       end.
      839       assign
      840         v-tbl-name      = p-table
      841         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      842       .
      843       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      844       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info6 ).
      845       assign
      846         v-inform = bh_tbl-name:index-information(1)
      847         v-ind    = 2
      848       .
      849       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      850       on error undo, return error
      851       :
      852         assign
      853           v-inform = bh_tbl-name:index-information( v-ind )
      854           v-ind    = v-ind + 1
      855         .
      856       end.
      857       if v-inform = ?
      858         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      859         or entry( 3, v-inform, ",":U ) <> "1":U
      860       then do:
      861         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info6, v-tbl-name ).
      862       end.
      863       assign
      864         v-idx-field-qnty = num-entries( v-inform ) - 4
      865       .
      866       if v-idx-field-qnty < 2 then do:
      867         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info6, v-inform, v-tbl-name ).
      868       end.
      869       assign
      870         p-field-list = "":U
      871         v-delim-key  = "":U
      872         v-count-fld  = 0
      873       .
      874       block_where:
      875       do v-ind = 1 to v-idx-field-qnty by 2
      876       on error undo, return error
      877       :
      878         assign
      879           v-count-fld = v-count-fld + 1
      880         .
      881         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      882         if v-ind = 1 then do:
      883           assign
      884             v-delim-key = chr(3)
      885           .
      886         end.
      887       end.
      888       delete object bh_tbl-name.
      889     end.
      890   end procedure.
      891   define shared temp-table temp-cmd no-undo
      892   field cmd-code as integer
      893   field db-list as character
      894   index pi is unique primary
      895   db-list
      896   index icmd
      897   cmd-code
      898   .
      899   define shared temp-table temp-smart-route no-undo
      900   field key-field as character
      901   field db-num as integer
      902   index pi is unique primary
      903   key-field
      904   db-num
      905   .
      906   define shared temp-table temp-no-route no-undo
      907   field rec-ord as integer
      908   field db-num as integer
      909   index pi is unique primary
      910   db-num
      911   rec-ord
      912   index iro
      913   rec-ord
      914   .
      915   define shared temp-table temp-smart-link no-undo
      916   field uniq-key-rec as character
      917   field key-field as character
      918   field rec-ord as integer
      919   field is-smart as logical
      920   index pi is unique primary
      921   key-field
      922   uniq-key-rec
      923   rec-ord
      924   index iu
      925   uniq-key-rec
      926   index iro
      927   rec-ord
      928   .
      929   define shared temp-table temp-nws-outline no-undo
      930   like ub.nws-outline.
      931   procedure create-smart-route :
      932   define input parameter p-key-field as character no-undo .
      933   define input parameter p-db-num as integer no-undo .
      934   define buffer buf_temp-smart-route for temp-smart-route.
      935     do
      936     on error undo, return error
      937     :
      938       find first buf_temp-smart-route where
      939                 buf_temp-smart-route.key-field = p-key-field
      940             and buf_temp-smart-route.db-num = p-db-num no-error.
      941       if not available buf_temp-smart-route then do:
      942         create buf_temp-smart-route.
      943         assign
      944         buf_temp-smart-route.key-field = p-key-field
      945         buf_temp-smart-route.db-num = p-db-num
      946         .
      947       end.
      948     end.
      949   end procedure.
      950   procedure create-smart-route-link :
      951   define input parameter p-tbl-name as character no-undo .
      952   define input parameter p-bh_tbl-name as handle no-undo .
      953   define input parameter p-key-field as character no-undo .
      954   define input parameter p-rec-ord as integer no-undo .
      955   define input parameter p-is-smart as logical no-undo .
      956   define variable v-key-rec as character no-undo .
      957   define buffer buf_temp-smart-link for temp-smart-link.
      958     do
      959     on error undo, return error
      960     :
      961       run gen-key-rec in this-procedure ( input p-tbl-name
      962                                          ,input p-bh_tbl-name
      963                                          ,output v-key-rec     ).
      964      find first buf_temp-smart-link where
      965                 buf_temp-smart-link.uniq-key-rec = v-key-rec
      966              and buf_temp-smart-link.key-field = p-key-field
      967              and buf_temp-smart-link.rec-ord = p-rec-ord
      968              no-error .
      969      if not available buf_temp-smart-link then do:
      970        create buf_temp-smart-link.
      971        assign
      972        buf_temp-smart-link.uniq-key-rec = v-key-rec
      973        buf_temp-smart-link.key-field = p-key-field
      974        buf_temp-smart-link.rec-ord = p-rec-ord
      975        buf_temp-smart-link.is-smart = p-is-smart
      976        .
      977      end.
      978     end.
      979   end procedure.
      980   procedure create-nws-outline :
      981   define input parameter p-cmd-proc-handle as handle no-undo .
      982   define input parameter p-cmd-code as integer no-undo .
      983   define input parameter p-outline-type as character no-undo .
      984   define input parameter p-charkey_one as character no-undo .
      985   define input parameter p-charkey_two as character no-undo .
      986   define input parameter p-charkey_three as character no-undo .
      987   define input parameter p-key#_one as integer no-undo .
      988   define input parameter p-key#_two as integer no-undo .
      989   define input parameter p-key#_three as integer no-undo .
      990   define variable v-no-id as integer no-undo .
      991   define variable v-rec-ord as integer no-undo .
      992     do
      993     on error undo, return error return-value
      994     :
      995       find last temp-nws-outline use-index pi no-error .
      996       v-no-id = (if available temp-nws-outline
      997                  then (temp-nws-outline.no-id  + 1)
      998                  else 1).
      999       create temp-nws-outline.
     1000       assign
     1001       temp-nws-outline.charkeY_one = p-charkey_one
     1002       temp-nws-outline.charkeY_two = p-charkey_two
     1003       temp-nws-outline.charkeY_three = p-charkey_three
     1004       temp-nws-outline.key#_one = p-key#_one
     1005       temp-nws-outline.key#_two = p-key#_two
     1006       temp-nws-outline.key#_three = p-key#_three
     1007       temp-nws-outline.no-id = v-no-id
     1008       temp-nws-outline.outline-type = p-outline-type
     1009       .
     1010                                   run add-dump in p-cmd-proc-handle                                                                           (input p-cmd-code                                                                                         ,input 'nws-outline':U                                                                                          ,input '+update'                                                                                         ,input (buffer temp-nws-outline:handle)                                                                                    ,input ''                                                                                         ,output v-rec-ord                                                                                         ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                     delete procedure p-cmd-proc-handle .                                                                        undo , return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'nws-outline':U                                                                                                ,p-cmd-code                                                                                               ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
     1011       run  create-smart-route in this-procedure (
     1012                                                   input ('nws-outline':U + chr(4) + string(temp-nws-outline.no-id))
     1013                                                  ,input -1).
     1014       run create-smart-route-link in this-procedure (
     1015                                                      input 'nws-outline':U
     1016                                                     ,input (buffer temp-nws-outline:handle)
     1017                                                     ,input ('nws-outline':U + chr(4) + string(temp-nws-outline.no-id))
     1018                                                     ,input v-rec-ord
     1019                                                     ,input no
     1020                                                     ).
     1021     end.
     1022   end procedure.
     1023   procedure create-no-route :
     1024   define input parameter p-rec-ord as integer no-undo .
     1025   define input parameter p-db-num as integer no-undo .
     1026   define buffer buf_temp-no-route for temp-no-route.
     1027   do
     1028   on error undo, return error
     1029   :
     1030      find first buf_temp-no-route where
     1031                 buf_temp-no-route.rec-ord = p-rec-ord
     1032              and buf_temp-no-route.db-num = p-db-num no-error .
     1033      if not available buf_temp-no-route then do:
     1034        create buf_temp-no-route.
     1035        assign
     1036        buf_temp-no-route.rec-ord = p-rec-ord
     1037        buf_temp-no-route.db-num = p-db-num
     1038        .
     1039      end.
     1040   end.
     1041   end procedure.
     1042   procedure clear-from-rec-ord :
     1043   define input parameter p-rec-ord as integer no-undo .
     1044   define buffer buf_temp-no-route for temp-no-route.
     1045   define buffer buf_temp-smart-link for temp-smart-link.
     1046   do
     1047   on error undo, return error
     1048   :
     1049   for each buf_temp-no-route where
     1050           buf_temp-no-route.rec-ord > p-rec-ord:
     1051     delete buf_temp-no-route.
     1052   end.
     1053   for each buf_temp-smart-link where
     1054           buf_temp-smart-link.rec-ord > p-rec-ord:
     1055      delete buf_temp-smart-link.
     1056   end.
     1057   end.
     1058   end procedure.
     1059   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1060   define shared temp-table temp-hist-nws-option no-undo
     1061   like ub.hist-nws-option
     1062   .
     1063   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1064   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1065   define variable tempcxml_v-num_ as integer no-undo .
     1066   define  temp-table temp-xml-tables no-undo
     1067   field order as integer
     1068   field tbl-name as character
     1069   field tbl-handle_ as handle
     1070   field table-handle_ as handle
     1071   field uniq-gate-rec as character
     1072   field gate-name as character
     1073   field gate-handle_ as handle
     1074   field is-parent as logical
     1075   index pi is unique primary
     1076   uniq-gate-rec
     1077   tbl-name
     1078   index iorder
     1079   order
     1080   index gr
     1081   uniq-gate-rec
     1082   index gh
     1083   gate-handle_
     1084   index iparent
     1085   is-parent
     1086   .
     1087   define  temp-table temp-xml-records no-undo
     1088   field tbl-name as character
     1089   field uniq-key-rec as character
     1090   index pi is unique primary
     1091   tbl-name
     1092   uniq-key-rec
     1093   .
     1094   def var vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1095   procedure get-gate-file-name :
     1096   define input parameter p-gate-rec as character no-undo .
     1097   define output  parameter p-gate-file-name as character no-undo .
     1098   define buffer buf_clob-data for ub.clob-data.
     1099   define variable v-tbl-row as rowid no-undo .
     1100   define variable v-tbl-name as character no-undo .
     1101   run gen-row-keyr in this-procedure ( input p-gate-rec
     1102                                       ,input ?
     1103                                       ,input "ub"
     1104                                       ,input ?
     1105                                       ,input no-lock
     1106                                       ,output v-tbl-row
     1107                                       ,output v-tbl-name) no-error.
     1108   if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     1109                                                           ,vss-include-info8
     1110                                                           ,p-gate-rec).
     1111   find first buf_clob-data no-lock where
     1112             rowid(buf_clob-data) = v-tbl-row no-error.
     1113   if not available buf_clob-data then do:
     1114     if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     1115                                                             ,vss-include-info8
     1116                                                             ,p-gate-rec).
     1117   end.
     1118   p-gate-file-name = buf_clob-data.file-name.
     1119   end procedure.
     1120   procedure get-gate-rec :
     1121   define input  parameter p-gate-name as character no-undo .
     1122   define output parameter p-gate-rec as character no-undo .
     1123   define buffer buf_clob-bind for ub.clob-bind.
     1124   define buffer buf_clob-data for ub.clob-data.
     1125   main-block:
     1126   do
     1127   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info8, return-value, chr(10), error-status :get-message (1))
     1128   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info8 )
     1129   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info8 )
     1130   :
     1131       find first buf_clob-bind no-lock where
     1132                 buf_clob-bind.uniq-key-rec = p-gate-name
     1133             and buf_clob-bind.field-name = '':U
     1134             and buf_clob-bind.part-num = 1
     1135             and buf_clob-bind.resource-type = 'gate':U
     1136             no-error.
     1137       if not available buf_clob-bind then do:
     1138         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     1139                                         , p-gate-name
     1140                                         ).
     1141       end.
     1142       find first buf_clob-data no-lock where
     1143                 buf_clob-data.db-num = buf_clob-bind.db-num
     1144             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     1145       if not available buf_clob-data then do:
     1146         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1147                                         , buf_clob-bind.db-num
     1148                                         , buf_clob-bind.int64-id
     1149                                         , p-gate-name
     1150                                         ).
     1151       end.
     1152       run gen-key-rec in this-procedure ( input 'clob-data':U
     1153                                 ,input buffer buf_clob-data:handle
     1154                                 ,output p-gate-rec).
     1155   end.
     1156   end procedure.
     1157   procedure get-gate-by-name :
     1158   define input  parameter p-gate-name as character no-undo .
     1159   define output parameter p-gate-rec as character no-undo .
     1160   define output parameter p-dsh as handle no-undo .
     1161   define input-output  parameter p-xmlh as handle no-undo .
     1162   define variable v-ii as integer   no-undo .
     1163   define variable glog as logical   no-undo .
     1164   define variable v-longchar as longchar no-undo .
     1165   define variable v-txmlh as handle no-undo .
     1166   define variable v-db-num as integer no-undo .
     1167   define variable v-int64-id as int64 no-undo .
     1168   define buffer buf_clob-bind for ub.clob-bind.
     1169   define buffer buf_clob-data for ub.clob-data.
     1170   main-block:
     1171   do
     1172   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info8, return-value, chr(10), error-status :get-message (1))
     1173   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info8 )
     1174   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info8 )
     1175   :
     1176       find first buf_clob-bind no-lock where
     1177                 buf_clob-bind.uniq-key-rec = p-gate-name
     1178             and buf_clob-bind.field-name = '':U
     1179             and buf_clob-bind.part-num = 1
     1180             and buf_clob-bind.resource-type = 'gate':U
     1181             no-error.
     1182       if not available buf_clob-bind then do:
     1183         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     1184                                         , p-gate-name
     1185                                         ).
     1186       end.
     1187       find first buf_clob-data no-lock where
     1188                 buf_clob-data.db-num = buf_clob-bind.db-num
     1189             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     1190       if not available buf_clob-data then do:
     1191         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1192                                         , buf_clob-bind.db-num
     1193                                         , buf_clob-bind.int64-id
     1194                                         , p-gate-name
     1195                                         ).
     1196       end.
     1197       assign
     1198       v-longchar = buf_clob-data.cdata
     1199       .
     1200       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1201       if error-status :error then do:
     1202         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1203       end.
     1204       create dataset p-dsh .
     1205       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1206                                     , v-longchar
     1207                                     , ?
     1208                                     , ?
     1209                                     , ?
     1210                                     ) no-error.
     1211       v-longchar = '':U.
     1212       if error-status :error
     1213       or not glog
     1214       then do:
     1215         undo, return error substitute("Не удалось прочитать XML-схему &1 из БД:&2&3", p-gate-name, chr(10), error-status:get-message(1) ).
     1216       end.
     1217       if not valid-handle(p-xmlh)
     1218       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1219         create temp-table v-txmlh.
     1220         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1221         v-txmlh:temp-table-prepare("temp-xml-tables").
     1222         p-xmlh = v-txmlh:default-buffer-handle.
     1223       end.
     1224       run gen-key-rec in this-procedure ( input 'clob-data':U
     1225                                 ,input buffer buf_clob-data:handle
     1226                                 ,output p-gate-rec).
     1227       do v-ii = 1 to p-dsh:num-buffers:
     1228         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1229         if not p-xmlh:available then do:
     1230           p-xmlh:buffer-create().
     1231           assign
     1232           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1233           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1234           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1235           p-xmlh::gate-handle_ = p-dsh
     1236           p-xmlh::uniq-gate-rec = p-gate-rec
     1237           p-xmlh::gate-name = p-dsh:name
     1238           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1239           .
     1240           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1241             assign
     1242             p-xmlh::order = -3.
     1243           end.
     1244         end.
     1245       end.
     1246   end.
     1247   end procedure.
     1248   procedure get-gate-by-rec :
     1249   define input  parameter p-gate-rec as character no-undo .
     1250   define output parameter p-dsh as handle no-undo .
     1251   define input-output  parameter p-xmlh as handle no-undo .
     1252   define input-output parameter p-longchar  as longchar no-undo .
     1253   define variable v-ii as integer   no-undo .
     1254   define variable glog as logical   no-undo .
     1255   define variable v-rowid as rowid no-undo .
     1256   define variable v-tbl-name as character no-undo .
     1257   define variable v-longchar as longchar no-undo .
     1258   define variable v-txmlh as handle no-undo .
     1259   define buffer buf_clob-data for ub.clob-data.
     1260   main-block:
     1261   do
     1262   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info8, return-value, chr(10), error-status :get-message (1))
     1263   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info8 )
     1264   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info8 )
     1265   :
     1266     run gen-row-keyr in this-procedure (
     1267                                           input  p-gate-rec
     1268                                           ,input  ?
     1269                                           ,input  "ub"
     1270                                           ,input  ?
     1271                                           ,input  NO-LOCK
     1272                                           ,output v-rowid
     1273                                           ,output v-tbl-name   ) no-error.
     1274       find first buf_clob-data no-lock where
     1275                 rowid(buf_clob-data) = v-rowid  no-error.
     1276       if not available buf_clob-data then do:
     1277         undo, return error substitute("Не найден CLOB  &1"
     1278                                         , p-gate-rec
     1279                                         ).
     1280       end.
     1281       assign
     1282       v-longchar = buf_clob-data.cdata
     1283       .
     1284       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1285       if error-status :error then do:
     1286         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1287       end.
     1288       create dataset p-dsh .
     1289       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1290                                     , v-longchar
     1291                                     , ?
     1292                                     , ?
     1293                                     , ?
     1294                                     ) no-error.
     1295       define variable v-esm as character no-undo .
     1296       v-esm = error-status:get-message(1) .
     1297       if p-longchar <> ? then do:
     1298         p-longchar = v-longchar.
     1299       end.
     1300       v-longchar = '':U.
     1301       if error-status :error
     1302       or not glog
     1303       then do:
     1304         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     1305                                      , p-gate-rec
     1306                                      , p-gate-rec
     1307                                      , v-esm
     1308                                      ).
     1309       end.
     1310       p-dsh:private-data = buf_clob-data.file-name_ + chr(4) + p-gate-rec.
     1311       if not valid-handle(p-xmlh)
     1312       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1313         create temp-table v-txmlh.
     1314         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1315         v-txmlh:temp-table-prepare("temp-xml-tables").
     1316         p-xmlh = v-txmlh:default-buffer-handle.
     1317       end.
     1318       do v-ii = 1 to p-dsh:num-buffers:
     1319         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1320         if not p-xmlh:available then do:
     1321           p-xmlh:buffer-create().
     1322           assign
     1323           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1324           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1325           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1326           p-xmlh::gate-handle_ = p-dsh
     1327           p-xmlh::uniq-gate-rec = p-gate-rec
     1328           p-xmlh::gate-name = p-dsh:name
     1329           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1330           .
     1331           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1332             assign
     1333             p-xmlh::order = -3.
     1334           end.
     1335           p-xmlh:buffer-release().
     1336         end.
     1337       end.
     1338   end.
     1339   end procedure.
     1340   procedure get-gate-by-file :
     1341   define input  parameter p-schema-file-name as character no-undo .
     1342   define input  parameter p-gate-rec as character no-undo .
     1343   define output parameter p-dsh as handle no-undo .
     1344   define input-output  parameter p-xmlh as handle no-undo .
     1345   define variable v-ii as integer   no-undo .
     1346   define variable glog as logical   no-undo .
     1347   define variable v-rowid as rowid no-undo .
     1348   define variable v-tbl-name as character no-undo .
     1349   define variable v-longchar as longchar no-undo .
     1350   define variable v-txmlh as handle no-undo .
     1351   main-block:
     1352   do
     1353   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info8, return-value, chr(10), error-status :get-message (1))
     1354   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info8 )
     1355   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info8 )
     1356   :
     1357       COPY-LOB
     1358       FROM  FILE p-schema-file-name
     1359       TO  OBJECT v-longchar
     1360       no-convert
     1361       NO-ERROR .
     1362       if error-status :error then do:
     1363           undo, return error substitute("Не удалось считать файл схемы &1 в память&2&3"
     1364                                     , p-schema-file-name
     1365                                 , chr(10)
     1366                                 , error-status:get-message(1) ).
     1367       end.
     1368       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1369       if error-status :error then do:
     1370         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, p-schema-file-name, chr(10), error-status:get-message(1) , return-value ).
     1371       end.
     1372       create dataset p-dsh .
     1373       glog = p-dsh:READ-XMLSCHEMA( "longchar"
     1374                                     , v-longchar
     1375                                     , ?
     1376                                     , ?
     1377                                     , ?
     1378                                     ) no-error.
     1379       v-longchar = ''.
     1380       if error-status :error
     1381       or not glog
     1382       then do:
     1383         undo, return error substitute("Не удалось прочитать XML-схему из файла &1&2&3"
     1384                                      , p-schema-file-name
     1385                                      ,chr(10)
     1386                                      , error-status:get-message(1)
     1387                                      ).
     1388       end.
     1389       if not valid-handle(p-xmlh)
     1390       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1391         create temp-table v-txmlh.
     1392         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1393         v-txmlh:temp-table-prepare("temp-xml-tables").
     1394         p-xmlh = v-txmlh:default-buffer-handle.
     1395       end.
     1396       do v-ii = 1 to p-dsh:num-buffers:
     1397         p-xmlh:find-first(substitute(' where tbl-name = "&1" and  uniq-gate-rec = "&2" '
     1398                                      ,p-dsh:get-buffer-handle(v-ii):name
     1399                                      ,p-gate-rec
     1400                                      )) no-error.
     1401         if not p-xmlh:available then do:
     1402           p-xmlh:buffer-create().
     1403           assign
     1404           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):table
     1405           p-xmlh::uniq-gate-rec = p-gate-rec
     1406           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1407           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1408           p-xmlh::gate-handle_ = p-dsh
     1409           p-xmlh::gate-name = p-dsh:name
     1410           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1411           .
     1412           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1413             assign
     1414             p-xmlh::order = -3.
     1415           end.
     1416           p-xmlh:buffer-release().
     1417         end.
     1418       end.
     1419   end.
     1420   end procedure.
     1421   procedure gate-clear :
     1422   define input  parameter p-dsh as handle no-undo .
     1423   define input  parameter p-xmlh as handle no-undo .
     1424   define variable v-dsh as handle no-undo .
     1425   define variable v-th as handle no-undo .
     1426     do
     1427     on error undo, return error return-value
     1428     :
     1429       if valid-handle(p-dsh) then do:
     1430         delete object p-dsh.
     1431         v-dsh = p-dsh.
     1432         p-dsh = ?.
     1433       end.
     1434       repeat while true:
     1435         p-xmlh:find-first( substitute( " where gate-handle_ = &1 ", v-dsh)
     1436                            , share-lock) no-error.
     1437         if p-xmlh:available then do:
     1438           assign
     1439           v-th = p-xmlh:buffer-field("table-handle_"):buffer-value.
     1440           if valid-handle(p-xmlh:buffer-field("table-handle_"))
     1441           and valid-handle(v-th)
     1442           and v-th:dynamic = yes
     1443           then do:
     1444             delete object p-xmlh:buffer-field("table-handle_"):buffer-value.
     1445             p-xmlh:buffer-field("table-handle_"):buffer-value = ?.
     1446           end.
     1447           p-xmlh:buffer-delete().
     1448         end.
     1449         else do:
     1450           leave.
     1451         end.
     1452       end.
     1453       if p-xmlh:dynamic = yes
     1454       and valid-handle(p-xmlh)
     1455       then do:
     1456         delete object p-xmlh:table-handle.
     1457         p-xmlh = ?.
     1458       end.
     1459       v-dsh = ?.
     1460     end.
     1461   end procedure.
     1462   procedure all-gates-clear :
     1463   define parameter buffer buf_temp-xml-tables for temp-xml-tables.
     1464   do
     1465   on error undo, return error
     1466   :
     1467     for each buf_temp-xml-tables
     1468     break
     1469     by buf_temp-xml-tables.uniq-gate-rec
     1470     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1471     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1472     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1473     :
     1474         if first-of(buf_temp-xml-tables.uniq-gate-rec) then do:
     1475           delete object buf_temp-xml-tables.gate-handle_.
     1476           buf_temp-xml-tables.gate-handle_ = ?.
     1477         end.
     1478         if valid-handle(buf_temp-xml-tables.table-handle_)
     1479         and buf_temp-xml-tables.table-handle_:dynamic = no
     1480         then do:
     1481           delete object buf_temp-xml-tables.table-handle_.
     1482           buf_temp-xml-tables.table-handle_ = ?.
     1483         end.
     1484         delete buf_temp-xml-tables.
     1485     end.
     1486   end.
     1487   end procedure.
     1488   procedure fix-schemalocation :
     1489   define input-output  parameter p-longchar as longchar no-undo .
     1490   DEFINE VARIABLE hdoc AS HANDLE.
     1491   DEFINE VARIABLE hroot AS HANDLE.
     1492   DEFINE VARIABLE hnode-child AS HANDLE.
     1493   DEFINE VARIABLE hnode-attr AS HANDLE.
     1494   define variable v-jj as integer   no-undo .
     1495   define variable ok as logical   no-undo .
     1496   define variable v-path1                    as character                no-undo .
     1497   DEFINE VARIABLE v-full-path1               as character                no-undo .
     1498   DEFINE VARIABLE v-file-name1               as character                no-undo .
     1499   DEFINE VARIABLE v-file-name-no-ext1        as character                no-undo .
     1500   DEFINE VARIABLE v-file-name-ext1           as character                no-undo .
     1501   define variable v-schema-location          as character                no-undo .
     1502   do
     1503   on error undo, return error return-value
     1504   :
     1505     CREATE X-DOCUMENT hdoc.
     1506     CREATE X-noderef hroot.
     1507     CREATE X-noderef hnode-child.
     1508     CREATE X-noderef hnode-attr.
     1509     hdoc:load("longchar", p-longchar, no) no-error.
     1510     iF ERROR-STATUS:GET-MESSAGE(1) <> '' THEN message ERROR-STATUS:GET-MESSAGE(1) view-as alert-box .
     1511     hdoc:get-document-element(hroot).
     1512     _repeat:
     1513     REPEAT v-jj = 1 TO hroot:NUM-CHILDREN:
     1514       ok = hroot:GET-CHILD(hNode-Child, v-jj).
     1515       if not ok then next.
     1516       if hNode-Child:local-name = "include"
     1517       then do:
     1518         ok = hNode-Child:GET-ATTRIBUTE-NODE( hnode-attr, "schemaLocation" ).
     1519           v-schema-location = hnode-attr:node-value.
     1520           run gbl/filename.p (
     1521                           input "exe/" + hnode-attr:node-value
     1522                         ,output v-full-path1
     1523                         ,output v-path1
     1524                         ,output v-file-name1
     1525                         ,output v-file-name-no-ext1
     1526                         ,output v-file-name-ext1
     1527                         ) no-error .
     1528           if error-status :error then do:
     1529             delete object hnode-attr.
     1530             delete object hnode-child.
     1531             delete object hroot.
     1532             delete object hdoc.
     1533             undo, return error substitute("Не удалось определить расположение схемы &1", v-schema-location).
     1534           end.
     1535         ok = hNode-Child:sET-ATTRIBUTE(  "schemaLocation", v-full-path1 ).
     1536         leave  _repeat.
     1537       end.
     1538     END.
     1539     hdoc:save("longchar", p-longchar).
     1540     delete object hnode-attr.
     1541     delete object hnode-child.
     1542     delete object hroot.
     1543     delete object hdoc.
     1544   end.
     1545   end procedure.
     1546   procedure gate-clb_fill-xml-tables :
     1547   define input parameter p-dsh as handle no-undo .
     1548   define input-output parameter p-xmlh as handle no-undo .
     1549   define variable v-ii as integer no-undo .
     1550     do
     1551     on error undo, return error
     1552     :
     1553       do v-ii = 1 to p-dsh:num-buffers:
     1554         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1555         if not p-xmlh:available then do:
     1556           p-xmlh:buffer-create().
     1557           assign
     1558           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1559           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1560           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1561           p-xmlh::gate-handle_ = p-dsh
     1562           p-xmlh::uniq-gate-rec = entry(2, p-dsh:private-data, chr(4))
     1563           p-xmlh::gate-name = p-dsh:name
     1564           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1565           .
     1566           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1567             assign
     1568             p-xmlh::order = -3.
     1569           end.
     1570           p-xmlh:buffer-release().
     1571         end.
     1572       end.
     1573     end.
     1574   end procedure.
     1575   procedure all-gates-empty :
     1576   define buffer buf_temp-xml-tables for temp-xml-tables.
     1577   do
     1578   on error undo, return error
     1579   :
     1580     for each buf_temp-xml-tables
     1581     break
     1582     by buf_temp-xml-tables.uniq-gate-rec
     1583     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1584     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1585     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1586     :
     1587       if valid-handle(buf_temp-xml-tables.tbl-handle_) then do:
     1588         buf_temp-xml-tables.tbl-handle_:empty-temp-table().
     1589       end.
     1590     end.
     1591   end.
     1592   end procedure.
     1593   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1594   define shared temp-table pdf-list no-undo like ub.price-doc-forming
     1595   field to-del     as logical
     1596   field order-num  as integer
     1597   index pi  is primary unique plt-id plt-db-num pdf-id pdf-db
     1598   index oi order-num
     1599   .
     1600   def var vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1601   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1602   define temp-table x_obj-group no-undo like ub.clients  .
     1603   define temp-table x_grp-obj-price no-undo like ub.grp-obj-price .
     1604   procedure metod-gop-obj :
     1605     do
     1606     on error undo, return error return-value
     1607     :
     1608   define input  parameter p-cntxt-db-num as integer   no-undo .
     1609   define input  parameter p-gop-id       as integer   no-undo .
     1610   define input  parameter p-gop-db-num   as integer   no-undo .
     1611   define buffer buf1_clients for ub.clients  .
     1612   define buffer buf_db-grp-obj-price   for ub.db-grp-obj-price  .
     1613   define buffer buf_host-grp-obj-price for ub.host-grp-obj-price  .
     1614   define buffer buf_obj-grp-obj-price  for ub.obj-grp-obj-price  .
     1615   for each  x_obj-group : delete x_obj-group. end.
     1616   if p-gop-id = 0 or p-gop-id = ?  then do:
     1617      if p-cntxt-db-num = 0  then do:
     1618           for each buf1_clients no-lock where
     1619                   (buf1_clients.obj-type = 'маг':U  or
     1620                    buf1_clients.obj-type = 'скл':U  )
     1621                   and
     1622                   buf1_clients.db-num >= 0  and
     1623                   buf1_clients.stts = 0
     1624                   :
     1625             create x_obj-group .
     1626             assign
     1627               x_obj-group.obj-code   = buf1_clients.obj-code
     1628               x_obj-group.obj-type   = buf1_clients.obj-type
     1629               x_obj-group.obj-name   = buf1_clients.obj-name
     1630               x_obj-group.db-num     = buf1_clients.db-num
     1631             .
     1632           end.
     1633      end.
     1634      else do:
     1635           for each buf1_clients no-lock where
     1636                   (buf1_clients.obj-type = 'маг':U  or
     1637                    buf1_clients.obj-type = 'скл':U  ) and
     1638                    buf1_clients.db-num = p-cntxt-db-num  and
     1639                    buf1_clients.stts = 0
     1640                   :
     1641             create x_obj-group .
     1642             assign
     1643               x_obj-group.obj-code   = buf1_clients.obj-code
     1644               x_obj-group.obj-type   = buf1_clients.obj-type
     1645               x_obj-group.obj-name   = buf1_clients.obj-name
     1646               x_obj-group.db-num     = buf1_clients.db-num
     1647             .
     1648           end.
     1649      end.
     1650   end.
     1651   else do:
     1652         for each buf_db-grp-obj-price  where
     1653                 buf_db-grp-obj-price.gop-id     = p-gop-id and
     1654                 buf_db-grp-obj-price.gop-db-num = p-gop-db-num and
     1655                 buf_db-grp-obj-price.stts = 0  no-lock :
     1656           for each buf1_clients no-lock where
     1657                  (buf1_clients.obj-type = 'маг':U  or
     1658                   buf1_clients.obj-type = 'скл':U  ) and
     1659                   buf1_clients.db-num = buf_db-grp-obj-price.dgo-db-num  and
     1660                   buf1_clients.stts = 0
     1661                   :
     1662             create x_obj-group .
     1663             assign
     1664               x_obj-group.obj-code   = buf1_clients.obj-code
     1665               x_obj-group.obj-type   = buf1_clients.obj-type
     1666               x_obj-group.obj-name   = buf1_clients.obj-name
     1667               x_obj-group.db-num     = buf1_clients.db-num
     1668             .
     1669           end.
     1670         end.
     1671       for each buf_host-grp-obj-price where
     1672               buf_host-grp-obj-price.gop-id     = p-gop-id and
     1673               buf_host-grp-obj-price.gop-db-num = p-gop-db-num and
     1674               buf_host-grp-obj-price.stts = 0
     1675               no-lock :
     1676         for each buf1_clients no-lock where
     1677                (buf1_clients.obj-type = 'маг':U  or
     1678                 buf1_clients.obj-type = 'скл':U  ) and
     1679                 buf1_clients.host-code = buf_host-grp-obj-price.host-code and
     1680                 buf1_clients.stts = 0
     1681                 :
     1682             find first x_obj-group no-lock  where
     1683                       x_obj-group.obj-code   = buf1_clients.obj-code and
     1684                       x_obj-group.obj-type   = buf1_clients.obj-type no-error .
     1685             if not available  x_obj-group then   create x_obj-group .
     1686             assign
     1687               x_obj-group.obj-code   = buf1_clients.obj-code
     1688               x_obj-group.obj-type   = buf1_clients.obj-type
     1689               x_obj-group.obj-name   = buf1_clients.obj-name
     1690               x_obj-group.db-num     = buf1_clients.db-num
     1691             .
     1692         end.
     1693       end.
     1694       for each buf_obj-grp-obj-price where
     1695               buf_obj-grp-obj-price.gop-id     = p-gop-id and
     1696               buf_obj-grp-obj-price.gop-db-num = p-gop-db-num and
     1697               buf_obj-grp-obj-price.stts = 0
     1698               no-lock :
     1699         for each buf1_clients no-lock where
     1700                   buf1_clients.obj-type = buf_obj-grp-obj-price.obj-type and
     1701                   buf1_clients.obj-code = buf_obj-grp-obj-price.obj-code and
     1702                   buf1_clients.stts     = 0
     1703                   :
     1704             find first  x_obj-group no-lock  where
     1705                         x_obj-group.obj-code   = buf1_clients.obj-code and
     1706                         x_obj-group.obj-type   = buf1_clients.obj-type no-error .
     1707             if not available  x_obj-group then   create x_obj-group .
     1708             assign
     1709               x_obj-group.obj-code   = buf1_clients.obj-code
     1710               x_obj-group.obj-type   = buf1_clients.obj-type
     1711               x_obj-group.obj-name   = buf1_clients.obj-name
     1712               x_obj-group.db-num     = buf1_clients.db-num
     1713             .
     1714         end.
     1715       end.
     1716   end.
     1717   end.
     1718   end procedure.
     1719   procedure metod-obj-in-gop :
     1720   define input  parameter p-curr-db-num as integer   no-undo .
     1721   define input  parameter p-obj-type as character no-undo .
     1722   define input  parameter p-obj-code as integer   no-undo .
     1723   define buffer buf_grp-obj-price for ub.grp-obj-price  .
     1724     do
     1725     on error undo, return error return-value
     1726     :
     1727       empty temp-table x_grp-obj-price.
     1728       for each buf_grp-obj-price where
     1729                buf_grp-obj-price.stts = 0
     1730                no-lock :
     1731                  run metod-gop-obj (p-curr-db-num , buf_grp-obj-price.gop-id ,buf_grp-obj-price.gop-db-num) .
     1732                  for each x_obj-group where
     1733                           x_obj-group.obj-type = p-obj-type and
     1734                           x_obj-group.obj-code = p-obj-code :
     1735                       create  x_grp-obj-price.
     1736                       buffer-copy buf_grp-obj-price to x_grp-obj-price .
     1737                  end.
     1738       end.
     1739     end.
     1740   end procedure.
     1741   procedure metod-delobj-usr :
     1742   define input  parameter p-pdf-id  as integer   no-undo .
     1743   define input  parameter p-pdf-db  as integer   no-undo .
     1744   define input  parameter p-plt-id  as integer   no-undo .
     1745   define input  parameter p-plt-db-num as integer   no-undo .
     1746   define buffer buf_price-doc-forming-attr for ub.price-doc-forming-attr  .
     1747     do
     1748     on error undo, return error return-value
     1749     :
     1750   for each buf_price-doc-forming-attr no-lock  where
     1751            buf_price-doc-forming-attr.pdf-id =     p-pdf-id and
     1752            buf_price-doc-forming-attr.pdf-db =     p-pdf-db and
     1753            buf_price-doc-forming-attr.plt-id =     p-plt-id and
     1754            buf_price-doc-forming-attr.plt-db-num = p-plt-db-num and
     1755            buf_price-doc-forming-attr.attr-code begins "obj" :
     1756      for each x_obj-group  where
     1757               x_obj-group.obj-type = substring(buf_price-doc-forming-attr.attr-code,4,3) and
     1758               x_obj-group.obj-code = int(substring(buf_price-doc-forming-attr.attr-code,7,20)) :
     1759        delete x_obj-group.
     1760      end.
     1761   end.
     1762     if not can-find (first x_obj-group) then do:
     1763        return "nullobj" .
     1764     end.
     1765   end.
     1766   end procedure.
     1767   procedure metod-obj-pdf :
     1768   define input  parameter p-cntxt-db-num as integer   no-undo .
     1769   define input  parameter p-pdf-id     like ub.price-doc-forming.pdf-id   no-undo .
     1770   define input  parameter p-pdf-db-num like ub.price-doc-forming.pdf-db   no-undo .
     1771   define input  parameter p-plt-id     like ub.price-doc-forming.plt-id   no-undo .
     1772   define input  parameter p-plt-db-num like ub.price-doc-forming.plt-db-num  no-undo .
     1773   define buffer buf_price-list-type for ub.price-list-type  .
     1774   define buffer buf_price-doc-forming for ub.price-doc-forming  .
     1775     do
     1776     on error undo, return error return-value
     1777     :
     1778    for each  x_obj-group : delete x_obj-group. end.
     1779    find first buf_price-list-type no-lock where
     1780               buf_price-list-type.plt-id = p-plt-id and
     1781               buf_price-list-type.plt-db-num = p-plt-db-num no-error .
     1782   if error-status :error then return error return-value .
     1783    find first buf_price-doc-forming no-lock where
     1784               buf_price-doc-forming.plt-id     = p-plt-id and
     1785               buf_price-doc-forming.plt-db-num = p-plt-db-num and
     1786               buf_price-doc-forming.pdf-id     = p-pdf-id and
     1787               buf_price-doc-forming.pdf-db     = p-pdf-db-num
     1788               no-error .
     1789   if error-status :error then return error return-value .
     1790     run metod-gop-obj in this-procedure (
     1791         p-cntxt-db-num,
     1792         buf_price-list-type.gop-id ,
     1793         buf_price-list-type.gop-db-num
     1794         ) no-error .
     1795     run metod-delobj-usr in this-procedure (
     1796       buf_price-doc-forming.pdf-id ,
     1797       buf_price-doc-forming.pdf-db ,
     1798       buf_price-doc-forming.plt-id ,
     1799       buf_price-doc-forming.plt-db-num
     1800       ) no-error .
     1801     end.
     1802   end procedure.
     1803   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1804   procedure del-pdf-attr-objdel :
     1805   define input  parameter p-pdf-id     as integer   no-undo .
     1806   define input  parameter p-pdf-db-num as integer   no-undo .
     1807   define input  parameter p-plt-id     as integer   no-undo .
     1808   define input  parameter p-plt-db-num as integer   no-undo .
     1809   define input  parameter p-obj-type   as character no-undo .
     1810   define input  parameter p-obj-code   as integer   no-undo .
     1811   define buffer buf_price-doc-forming-attr for ub.price-doc-forming-attr  .
     1812     do
     1813     on error undo, return error return-value
     1814     :
     1815     find first buf_price-doc-forming-attr exclusive-lock where
     1816                buf_price-doc-forming-attr.pdf-id     = p-pdf-id      and
     1817                buf_price-doc-forming-attr.pdf-db     = p-pdf-db-num  and
     1818                buf_price-doc-forming-attr.plt-id     = p-plt-id      and
     1819                buf_price-doc-forming-attr.plt-db-num = p-plt-db-num  and
     1820                buf_price-doc-forming-attr.attr-code  = "obj" + p-obj-type + string(p-obj-code)
     1821                no-error .
     1822         if available buf_price-doc-forming-attr then do:
     1823            delete buf_price-doc-forming-attr .
     1824         end.
     1825     end.
     1826   end procedure.
     1827   procedure ins-pdf-attr-objdel :
     1828   define input  parameter p-pdf-id     as integer   no-undo .
     1829   define input  parameter p-pdf-db-num as integer   no-undo .
     1830   define input  parameter p-plt-id     as integer   no-undo .
     1831   define input  parameter p-plt-db-num as integer   no-undo .
     1832   define input  parameter p-obj-type   as character no-undo .
     1833   define input  parameter p-obj-code   as integer   no-undo .
     1834   define buffer buf_price-doc-forming-attr for ub.price-doc-forming-attr  .
     1835     do
     1836     on error undo, return error return-value
     1837     :
     1838     find first buf_price-doc-forming-attr exclusive-lock where
     1839                buf_price-doc-forming-attr.pdf-id     = p-pdf-id      and
     1840                buf_price-doc-forming-attr.pdf-db     = p-pdf-db-num  and
     1841                buf_price-doc-forming-attr.plt-id     = p-plt-id      and
     1842                buf_price-doc-forming-attr.plt-db-num = p-plt-db-num  and
     1843                buf_price-doc-forming-attr.attr-code  = "obj" + p-obj-type + string(p-obj-code)
     1844                no-error .
     1845         if not available  buf_price-doc-forming-attr then do:
     1846            create buf_price-doc-forming-attr.
     1847            assign
     1848                buf_price-doc-forming-attr.pdf-id     = p-pdf-id
     1849                buf_price-doc-forming-attr.pdf-db     = p-pdf-db-num
     1850                buf_price-doc-forming-attr.plt-id     = p-plt-id
     1851                buf_price-doc-forming-attr.plt-db-num = p-plt-db-num
     1852                buf_price-doc-forming-attr.attr-code  = "obj" + p-obj-type + string(p-obj-code)
     1853                buf_price-doc-forming-attr.attr-value = ""
     1854            .
     1855         end.
     1856     end.
     1857   end procedure.
     1858   procedure ex-pdf-attr-objdel :
     1859   define input  parameter p-pdf-id     as integer   no-undo .
     1860   define input  parameter p-pdf-db-num as integer   no-undo .
     1861   define input  parameter p-plt-id     as integer   no-undo .
     1862   define input  parameter p-plt-db-num as integer   no-undo .
     1863   define input  parameter p-obj-type   as character no-undo .
     1864   define input  parameter p-obj-code   as integer   no-undo .
     1865   define output parameter p-exist      as logical   no-undo .
     1866   define buffer buf_price-doc-forming-attr for ub.price-doc-forming-attr  .
     1867     do
     1868     on error undo, return error return-value
     1869     :
     1870     p-exist = false .
     1871     find first buf_price-doc-forming-attr exclusive-lock where
     1872                buf_price-doc-forming-attr.pdf-id     = p-pdf-id      and
     1873                buf_price-doc-forming-attr.pdf-db     = p-pdf-db-num  and
     1874                buf_price-doc-forming-attr.plt-id     = p-plt-id      and
     1875                buf_price-doc-forming-attr.plt-db-num = p-plt-db-num  and
     1876                buf_price-doc-forming-attr.attr-code  = "obj" + p-obj-type + string(p-obj-code)
     1877                no-error .
     1878         if available buf_price-doc-forming-attr then do:
     1879            p-exist = true .
     1880         end.
     1881     end.
     1882   end procedure.
     1883   procedure pdf-exist :
     1884   define input  parameter p-pdf-id     as integer   no-undo .
     1885   define input  parameter p-pdf-db-num as integer   no-undo .
     1886   define input  parameter p-plt-id     as integer   no-undo .
     1887   define input  parameter p-plt-db-num as integer   no-undo .
     1888   define input  parameter p-attr-code as character no-undo .
     1889   define output parameter p-exist      as logical   no-undo .
     1890   define buffer buf_price-doc-forming-attr for ub.price-doc-forming-attr  .
     1891     do
     1892     on error undo, return error return-value
     1893     :
     1894     p-exist = false .
     1895     find first buf_price-doc-forming-attr exclusive-lock where
     1896                buf_price-doc-forming-attr.pdf-id     = p-pdf-id      and
     1897                buf_price-doc-forming-attr.pdf-db     = p-pdf-db-num  and
     1898                buf_price-doc-forming-attr.plt-id     = p-plt-id      and
     1899                buf_price-doc-forming-attr.plt-db-num = p-plt-db-num  and
     1900                buf_price-doc-forming-attr.attr-code  = p-attr-code
     1901                no-error .
     1902         if available buf_price-doc-forming-attr then do:
     1903            p-exist = true .
     1904         end.
     1905     end.
     1906   end procedure.
     1907   procedure pdf-write :
     1908   define input  parameter p-pdf-id     as integer   no-undo .
     1909   define input  parameter p-pdf-db-num as integer   no-undo .
     1910   define input  parameter p-plt-id     as integer   no-undo .
     1911   define input  parameter p-plt-db-num as integer   no-undo .
     1912   define input  parameter p-attr-code as character no-undo .
     1913   define input  parameter p-attr-value as character no-undo .
     1914   define buffer buf_price-doc-forming-attr for ub.price-doc-forming-attr  .
     1915     do
     1916     on error undo, return error return-value
     1917     :
     1918     find first buf_price-doc-forming-attr exclusive-lock where
     1919                buf_price-doc-forming-attr.pdf-id     = p-pdf-id      and
     1920                buf_price-doc-forming-attr.pdf-db     = p-pdf-db-num  and
     1921                buf_price-doc-forming-attr.plt-id     = p-plt-id      and
     1922                buf_price-doc-forming-attr.plt-db-num = p-plt-db-num  and
     1923                buf_price-doc-forming-attr.attr-code  = p-attr-code
     1924                no-error .
     1925         if not available buf_price-doc-forming-attr then do:
     1926            create buf_price-doc-forming-attr.
     1927            assign
     1928                buf_price-doc-forming-attr.pdf-id     = p-pdf-id
     1929                buf_price-doc-forming-attr.pdf-db     = p-pdf-db-num
     1930                buf_price-doc-forming-attr.plt-id     = p-plt-id
     1931                buf_price-doc-forming-attr.plt-db-num = p-plt-db-num
     1932                buf_price-doc-forming-attr.attr-code  = p-attr-code
     1933            .
     1934         end.
     1935         buf_price-doc-forming-attr.attr-value = p-attr-value .
     1936     end.
     1937   end procedure.
