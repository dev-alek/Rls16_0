     5914             output cur-rt-rubl
     5915             ).
     5916             cost-rubl = vd * p-exch-rate / p-exch-scale .
     5917             cost-base = cost-rubl / p-base-rate * p-base-scale .
     5918             p-new-calc-method = 'Отсутствует':U .
     5919      end.
     5920      when 'Основная':U then do:
     5921      end.
