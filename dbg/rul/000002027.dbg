     3315   PROCEDURE cre-pr-list:
     3316   define input  parameter bc      like ub.price-list.b-code no-undo.
     3317   define input  parameter new-num like ub.price-doc.doc-num no-undo.
     3318   define output parameter new-rec as recid             no-undo.
     3319   define buffer buf-price-list for ub.price-list.
     3320   define buffer buf-price-doc  for ub.price-doc.
     3321   define buffer buf-bar-code   for ub.bar-code.
     3322   define buffer buf-goods      for ub.goods.
     3323   define buffer buf-gds-prt    for ub.gds-prt.
     3324   define buffer root-gds-prt   for ub.gds-prt.
     3325   define variable cur-pr like ub.price-list.price-sale no-undo.
     3326   define variable cur-rt like ub.price-list.road-tax   no-undo.
     3327   define variable cur-ex like ub.price-list.excise     no-undo.
     3328   define variable cur-dn like ub.price-list.doc-num    no-undo.
     3329   define variable local_vat-pc like ub.price-list.vat-pc    no-undo.
     3330   define variable local_slt-pc like ub.price-list.slt-pc    no-undo.
     3331   define variable cur-rt-base as decimal no-undo .
     3332   define variable cur-rt-rubl as decimal no-undo .
     3333   define variable p-hostcode as int no-undo .
     3334   define variable v-line-num as integer no-undo .
     3335   define variable v-skip-del-gds as logical no-undo initial no .
     3336   cre-pr:
     3337   do on error undo cre-pr, return error:
     3338     find  buf-bar-code no-lock where
     3339           buf-bar-code.b-code = bc.
     3340     run check-use-bar-code ( buf-bar-code.b-code ) no-error .
     3341     if error-status :error then do:
     3342       message
     3343         return-value skip
     3344         "Ошибка !"
     3345         view-as alert-box error
     3346       .
     3347       undo cre-pr, return.
     3348     end.
     3349     find  buf-goods no-lock where
     3350           buf-goods.gds-code = buf-bar-code.gds-code.
     3351     find first root-gds-prt no-lock where
     3352               root-gds-prt.upper-code = buf-goods.prt-root.
     3353     if root-gds-prt.node-name <> '_Пустая шкала':U and
     3354       buf-bar-code.in-code <> "" then do:
     3355       message
     3356         "Не допускается создавать спец. цены на партии для товаров с непустой шкалой!" skip (2)
     3357         "Артикул:" buf-goods.artic "Код:" buf-goods.gds-code buf-goods.gds-name
     3358         view-as alert-box error.
     3359       undo cre-pr, return.
     3360     end.
     3361     find  buf-gds-prt no-lock where
     3362           buf-gds-prt.node-code = buf-bar-code.node-code.
     3363     if buf-goods.stts <> 0 and not v-skip-del-gds then do:
     3364       message
     3365         "Не допускается создавать цены на удаленные товары!" skip (2)
     3366         "Артикул:" buf-goods.artic "Код:" buf-goods.gds-code buf-goods.gds-name
     3367         view-as alert-box error.
     3368       undo cre-pr, return.
     3369     end.
     3370     find  buf-price-doc where
     3371           buf-price-doc.doc-num = new-num.
     3372   define variable v-ret as logical no-undo .
     3373      run ver-modificator-price-is-null (
     3374             input    buf-goods.artic        ,
     3375             input    buf-goods.prod-type    ,
     3376             input    buf-goods.prod-code    ,
     3377             input    buf-price-doc.obj-type   ,
     3378             input    buf-price-doc.obj-code   ,
     3379             output   v-ret ).
     3380         if v-ret = false then dO:
     3381             message
     3382               "Не допускается создавать цены на модификаторы с нулевой ценой !" skip (2)
     3383               "Артикул:" buf-goods.artic "Код:" buf-goods.gds-code buf-goods.gds-name
     3384               view-as alert-box error.
     3385             undo cre-pr, return.
     3386           end.
     3387   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3388   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3389     (input  buf-price-doc.obj-type
     3390     ,input  buf-price-doc.obj-code
     3391     ,output p-hostcode
     3392     ) no-error .
     3393   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3394   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     3395     (input  buf-goods.gds-code
     3396     ,input  '1':U
     3397     ,input  ?
     3398     ,input  p-hostcode
     3399     ,input  buf-price-doc.obj-type
     3400     ,input  buf-price-doc.obj-code
     3401     ,output local_vat-pc
     3402     ) no-error .
     3403   define variable vss-include-info41 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3404   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     3405     (input  buf-goods.gds-code
     3406     ,input  '2':U
     3407     ,input  ?
     3408     ,input  p-hostcode
     3409     ,input  buf-price-doc.obj-type
     3410     ,input  buf-price-doc.obj-code
     3411     ,output local_slt-pc
     3412     ) no-error .
     3413   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3414   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     3415     (input  buf-price-doc.obj-type
     3416     ,input  buf-price-doc.obj-code
     3417     ,input  bc
     3418     ,input  0
     3419     ,input  0
     3420     ,output cur-dn
     3421     ,output cur-pr
     3422     ,output cur-rt
     3423     ,output cur-ex
     3424     ) no-error .
     3425     find first buf-price-list where
     3426               buf-price-list.b-code  = buf-bar-code.b-code and
     3427               buf-price-list.doc-num = new-num  and
     3428               buf-price-list.price-type = ""    no-error .
     3429     if not available buf-price-list then do:
     3430       run calc-price-line-num (input  new-num , output v-line-num) .
     3431       create buf-price-list.
     3432       assign
     3433         buf-price-list.line-num  = v-line-num
     3434         buf-price-list.b-code    = buf-bar-code.b-code
     3435         buf-price-list.doc-num   = buf-price-doc.doc-num
     3436         buf-price-list.prod-type = buf-goods.prod-type
     3437         buf-price-list.prod-code = buf-goods.prod-code
     3438         buf-price-list.artic     = buf-goods.artic
     3439         buf-price-list.obj-type  = buf-price-doc.obj-type
     3440         buf-price-list.obj-code  = buf-price-doc.obj-code
     3441         buf-price-list.vat-pc    = local_vat-pc
     3442         buf-price-list.slt-pc    = local_slt-pc
     3443         buf-price-list.price-prev = cur-pr
     3444         .
     3445       if  buf-gds-prt.upper-code = buf-goods.prt-root and
     3446           buf-bar-code.in-code   = "" and
     3447           buf-bar-code.part-code = "" and
     3448           buf-bar-code.unit-cli  = buf-goods.unit-base then do:
     3449         buf-price-list.main-price = yes.
     3450         if cur-pr <> ? then do:
     3451           run exp-prt (input buf-goods.gds-code,
     3452                       input cur-dn,
     3453                       input new-num,
     3454                       output new-rec) no-error.
     3455           if error-status :error then do:
     3456             message
     3457               "Ошибка вызова процедуры разворота специальных и неосновных цен."
     3458               view-as alert-box error.
     3459             undo cre-pr, return error.
     3460           end.
     3461         end.
     3462       end.
     3463       else do:
     3464         if buf-bar-code.unit-cli <> buf-goods.unit-base then do:
     3465           buf-price-list.d-pcnt = ?.
     3466         end.
     3467         buf-price-list.main-price = no.
     3468       end.
     3469     end.
     3470   end.
     3471   new-rec = recid (buf-price-list).
     3472   END PROCEDURE.
     3473   procedure calc-price-line-num :
     3474    do
     3475    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     3476    :
     3477   define input parameter p-doc-num as character no-undo .
     3478   define output parameter p-num  as integer no-undo .
     3479   define variable v-fact as integer no-undo .
     3480   define buffer buf_1_price-list for ub.price-list .
     3481   p-num = 1 .
     3482   find last  buf_1_price-list no-lock where
     3483              buf_1_price-list.doc-num = p-doc-num use-index line-num no-error .
     3484              if available buf_1_price-list then
     3485                   assign
     3486                     v-fact = buf_1_price-list.line-num
     3487                   .
     3488   v-fact = v-fact + 1.
     3489   if v-fact <> ? then if p-num < v-fact then p-num = v-fact .
     3490    end.
     3491   end procedure.
     3492   PROCEDURE del-pr-list:
     3493   define input parameter bc    like ub.bar-code.b-code   no-undo.
     3494   define input parameter d-num like ub.price-doc.doc-num no-undo.
     3495   define input parameter round-method as character         no-undo.
     3496   define input parameter round-base   as decimal      no-undo.
     3497   define buffer buf-price-list for ub.price-list.
     3498   define buffer buf-bar-code   for ub.bar-code.
     3499   define buffer buf-goods      for ub.goods.
     3500   define variable l-ov-on as logical no-undo .
     3501   del-pr:
     3502   do on error undo del-pr, return error:
     3503     find first  buf-price-list no-lock where
     3504                 buf-price-list.doc-num    = d-num and
     3505                 buf-price-list.b-code     = bc and
     3506                 buf-price-list.price-type = "" no-error.
     3507     if not available buf-price-list then
     3508       undo del-pr, return error.
     3509     find  buf-goods no-lock where
     3510           buf-goods.prod-type = buf-price-list.prod-type and
     3511           buf-goods.prod-code = buf-price-list.prod-code and
     3512           buf-goods.artic     = buf-price-list.artic.
     3513     if buf-price-list.main-price then do:
     3514       for each  buf-price-list exclusive-lock where
     3515                 buf-price-list.doc-num   = d-num and
     3516                 buf-price-list.artic     = buf-goods.artic and
     3517                 buf-price-list.prod-type = buf-goods.prod-type and
     3518                 buf-price-list.prod-code = buf-goods.prod-code,
     3519           first buf-bar-code no-lock where
     3520                 buf-bar-code.b-code = buf-price-list.b-code
     3521       on error undo del-pr, return error:
     3522   define variable vss-include-info43 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3523   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     3524     (input  ub.buf-price-list.obj-type
     3525     ,input  ub.buf-price-list.obj-code
     3526     ,input  ub.buf-price-list.artic
     3527     ,input  ub.buf-price-list.prod-type
     3528     ,input  ub.buf-price-list.prod-code
     3529     ,input  'ov-on=request:exclusive'
     3530     ,output l-ov-on
     3531     ) no-error .
     3532         if error-status:error then do:
     3533           message
     3534             vss-workfile vss-revision vss-description skip
     3535             "Ошибка получения признака товара на объекте" skip
     3536             error-status :get-message(1) skip
     3537             return-value skip
     3538             view-as alert-box error .
     3539         end.
     3540         if l-ov-on then do:
     3541   define variable vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3542   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     3543     (input  ub.buf-price-list.obj-type
     3544     ,input  ub.buf-price-list.obj-code
     3545     ,input  ub.buf-price-list.artic
     3546     ,input  ub.buf-price-list.prod-type
     3547     ,input  ub.buf-price-list.prod-code
     3548     ,input  'ov-on=false'
     3549     ,output l-ov-on
     3550     ) no-error .
     3551           if error-status :error then do:
     3552           end.
     3553          end.
     3554         delete buf-price-list.
     3555       end.
     3556     end.
     3557     else do:
     3558       find  buf-bar-code no-lock where
     3559             buf-bar-code.b-code = buf-price-list.b-code.
     3560       if buf-bar-code.unit-cli <> buf-goods.unit-base then do:
     3561         message
     3562           "Нельзя удалить неосновную цену." skip
     3563           "Неосновная цена (скидка) не может быть неопределенной." skip
     3564           "Код:" bc skip
     3565           "Переоценка:" d-num
     3566           view-as alert-box error.
     3567         undo del-pr, return error.
     3568       end.
     3569       find current buf-price-list exclusive-lock no-error .
     3570       delete buf-price-list.
     3571       run calc-base-upd (input buf-bar-code.b-code,
     3572                         input d-num,
     3573                         input round-method,
     3574                         input round-base) no-error.
     3575       if error-status :error then
     3576         undo del-pr, return error.
     3577     end.
     3578   end.
     3579   END PROCEDURE.
     3580   PROCEDURE calc-base-upd:
     3581   define input parameter bc    like ub.bar-code.b-code   no-undo.
     3582   define input parameter d-num like ub.price-doc.doc-num no-undo.
     3583   define input parameter round-method as character         no-undo.
     3584   define input parameter round-base   as decimal      no-undo.
     3585   define buffer alt-bar-code   for ub.bar-code.
     3586   define buffer alt-price-list for ub.price-list.
     3587   define buffer buf-bar-code   for ub.bar-code.
     3588   define buffer buf-goods      for ub.goods.
     3589   calc-base:
     3590   do on error undo calc-base, return error:
     3591     find  buf-bar-code no-lock where
     3592           buf-bar-code.b-code = bc.
     3593     find  buf-goods no-lock where
     3594           buf-goods.gds-code = buf-bar-code.gds-code.
     3595     for each  alt-bar-code no-lock where
     3596               alt-bar-code.gds-code  = buf-bar-code.gds-code and
     3597               alt-bar-code.node-code = buf-bar-code.node-code and
     3598               alt-bar-code.part-code = buf-bar-code.part-code and
     3599               alt-bar-code.in-code   = buf-bar-code.in-code and
     3600               alt-bar-code.unit-cli <> buf-goods.unit-base,
     3601         each  alt-price-list where
     3602               alt-price-list.doc-num    = d-num and
     3603               alt-price-list.b-code     = alt-bar-code.b-code and
     3604               alt-price-list.price-type = ""
     3605         on error undo calc-base, return error:
     3606       run calc-pr-alt (input d-num,
     3607                       input alt-bar-code.b-code,
     3608                       input round-method,
     3609                       input round-base) no-error.
     3610       if error-status:error then
     3611         undo calc-base, return error.
     3612     end.
     3613   end.
     3614   END PROCEDURE.
     3615   PROCEDURE calc-pr-alt:
     3616   define input parameter d-num like ub.price-doc.doc-num no-undo.
     3617   define input parameter bc    like ub.bar-code.b-code   no-undo.
     3618   define input parameter r-method as character             no-undo.
     3619   define input parameter r-base   as decimal              no-undo.
     3620   define buffer buf-price-doc  for ub.price-doc.
     3621   define buffer buf-price-list for ub.price-list.
     3622   define buffer buf-bar-code   for ub.bar-code.
     3623   define buffer buf-goods      for ub.goods.
     3624   define buffer old-price-list for ub.price-list.
     3625   define variable pr-rec   as   recid                  no-undo.
     3626   define variable pr-c-b-r like ub.bar-code.cli-base-rate no-undo.
     3627   pr-alt:
     3628   do on error undo pr-alt, return error:
     3629     if r-method = ? or
     3630        r-base = ? then do:
     3631       message
     3632         "Нельзя удалить основную цену." skip
     3633         "Не задан способ округления для расчета зависящих от нее неосновных цен." skip
     3634         "Код:" bc skip
     3635         "Переоценка:" d-num
     3636         view-as alert-box error.
     3637       undo pr-alt, return error.
     3638     end.
     3639     find  buf-price-doc where
     3640           buf-price-doc.doc-num = d-num.
     3641     find  buf-bar-code no-lock where
     3642           buf-bar-code.b-code = bc.
     3643     find  buf-goods no-lock where
     3644           buf-goods.gds-code = buf-bar-code.gds-code.
     3645     find  buf-price-list where
     3646           buf-price-list.doc-num = buf-price-doc.doc-num and
     3647           buf-price-list.b-code  = bc.
     3648     if buf-price-list.d-pcnt = ? then do:
     3649   define variable vss-include-info45 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3650   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     3651     (input  buf-price-doc.obj-type
     3652     ,input  buf-price-doc.obj-code
     3653     ,input  bc
     3654     ,input  0
     3655     ,input  0
     3656     ,output pr-rec
     3657     ,output pr-c-b-r
     3658     )  .
     3659       find old-price-list no-lock where
     3660           recid (old-price-list) = pr-rec no-error.
     3661       if available old-price-list and
     3662         old-price-list.b-code = bc then
     3663         buf-price-list.d-pcnt = old-price-list.d-pcnt.
     3664       else
     3665         buf-price-list.d-pcnt = 0.
     3666     end.
     3667      if buf-price-list.d-pcnt = ? then do:
     3668         assign
     3669           buf-price-list.price-sale =   if available old-price-list then old-price-list.price-sale else 0
     3670           buf-price-list.calc-method =  'Не-считать':U + 'Основная':U
     3671           .
     3672     end.
     3673     else do:
     3674         assign
     3675           buf-price-list.price-sale =   fnc-base-price (buf-bar-code.b-code, buf-price-list.doc-num) *
     3676                                         buf-bar-code.cli-base-rate *
     3677                                         (1 - buf-price-list.d-pcnt / 100)
     3678           buf-price-list.calc-method =  'Основная':U
     3679           .
     3680   case r-method :
     3681     when '9-окончание':U then do:
     3682       if buf-price-list.price-sale < 29 then do:
     3683         if (buf-price-list.price-sale - truncate (buf-price-list.price-sale, 0)) <> 0 then do:
     3684           assign
     3685             buf-price-list.price-sale = truncate (buf-price-list.price-sale, 0) + 1
     3686           .
     3687         end.
     3688       end.
     3689       else do:
     3690         if (buf-price-list.price-sale modulo 10) < 3 then do:
     3691           assign
     3692             buf-price-list.price-sale = (buf-price-list.price-sale - (buf-price-list.price-sale modulo 100))
     3693                 + ( truncate (((buf-price-list.price-sale modulo 100) / 10), 0)
     3694                   - 1 ) * 10
     3695                 + 9
     3696           .
     3697         end.
     3698         else do:
     3699           assign
     3700             buf-price-list.price-sale = (buf-price-list.price-sale - (buf-price-list.price-sale modulo 100))
     3701                 + ( truncate (((buf-price-list.price-sale modulo 100) / 10), 0)
     3702                   ) * 10
     3703                 + 9
     3704           .
     3705         end.
     3706         assign
     3707           buf-price-list.price-sale = round (buf-price-list.price-sale, 0)
     3708         .
     3709       end.
     3710     end.
     3711     when '9-99окончание':U then do:
     3712       if buf-price-list.price-sale < r-base then do:
     3713         assign
     3714           buf-price-list.price-sale = truncate (buf-price-list.price-sale, 0) + 0.99
     3715         .
     3716       end.
     3717       else do:
     3718         assign
     3719           buf-price-list.price-sale = truncate (buf-price-list.price-sale / 10 , 0) * 10 + 9.99
     3720         .
     3721       end.
     3722     end.
     3723     when 'Без-дробных':U then do:
     3724       assign
     3725         buf-price-list.price-sale = round (buf-price-list.price-sale, 0)
     3726       .
     3727     end.
     3728     when 'Произвольно':U then do:
     3729       if r-base <> 0 then do:
     3730         assign
     3731           buf-price-list.price-sale = round (buf-price-list.price-sale / r-base, 0) * r-base
     3732         .
     3733         if buf-price-list.price-sale = 0 then do:
     3734           assign
     3735             buf-price-list.price-sale = r-base
     3736           .
     3737         end.
     3738       end.
     3739     end.
     3740     when 'Вверх':U then do:
     3741       if r-base <> 0 then do:
     3742         if truncate ( buf-price-list.price-sale / r-base, 0 ) <> (buf-price-list.price-sale / r-base) then do:
     3743           assign
     3744             buf-price-list.price-sale = truncate (buf-price-list.price-sale / r-base, 0) * r-base + r-base
     3745           .
     3746         end.
     3747       end.
     3748       if buf-price-list.price-sale = 0 then do:
     3749         assign
     3750           buf-price-list.price-sale = r-base
     3751         .
     3752       end.
     3753     end.
     3754     when 'Коэффициент':U then do:
     3755       if r-base <> 0 then do:
     3756         assign
     3757           buf-price-list.price-sale = buf-price-list.price-sale * r-base
     3758         .
     3759       end.
     3760     end.
     3761     when 'Отключено':U then do:
     3762     end.
     3763     otherwise do:
     3764       message
     3765         vss-workfile vss-revision vss-description skip
     3766         "Неизвестный метод округления продажной цены" skip
     3767         "round-method" r-method skip
     3768         "round-base"   r-base   skip
     3769         "price"        buf-price-list.price-sale             skip
     3770         view-as alert-box error .
     3771     end.
     3772   end.
     3773     end.
     3774   end.
     3775   END PROCEDURE.
     3776   PROCEDURE calc-pr-discnt:
     3777   define input parameter d-num like ub.price-doc.doc-num no-undo.
     3778   define input parameter bc    like ub.bar-code.b-code   no-undo.
     3779   define buffer buf-price-doc  for ub.price-doc.
     3780   define buffer buf-price-list for ub.price-list.
     3781   define buffer buf-bar-code   for ub.bar-code.
     3782   define buffer buf-goods      for ub.goods.
     3783   define buffer old-price-list for ub.price-list.
     3784   define variable pr-rec   as   recid                  no-undo.
     3785   define variable pr-c-b-r like ub.bar-code.cli-base-rate no-undo.
     3786   pr-discnt:
     3787   do on error undo pr-discnt, return error:
     3788     find  buf-price-doc where
     3789           buf-price-doc.doc-num = d-num.
     3790     find  buf-bar-code no-lock where
     3791           buf-bar-code.b-code = bc.
     3792     find  buf-goods no-lock where
     3793           buf-goods.gds-code = buf-bar-code.gds-code.
     3794     find  buf-price-list where
     3795           buf-price-list.doc-num = buf-price-doc.doc-num and
     3796           buf-price-list.b-code  = bc.
     3797     buf-price-list.d-pcnt = (1 -
     3798                              buf-price-list.price-sale /
     3799                              fnc-base-price (buf-bar-code.b-code, buf-price-list.doc-num) /
     3800                              buf-bar-code.cli-base-rate) *
     3801                              100
     3802                              .
     3803   end.
     3804   END PROCEDURE.
     3805   PROCEDURE calc-pr-sub :
     3806   define  input  parameter bc             like ub.price-list.b-code no-undo.
     3807   define  input  parameter d-num          like ub.price-doc.doc-num no-undo.
     3808   define  input  parameter calc-method  as character    no-undo.
     3809   define  input  parameter increase-pc  as decimal      no-undo.
     3810   define  input  parameter round-method as character    no-undo.
     3811   define  input  parameter round-base   as decimal      no-undo.
     3812   define  output parameter calc-rec     as recid        no-undo.
     3813   define  buffer buf-price-list for ub.price-list.
     3814   define  buffer buf-bar-code   for ub.bar-code.
     3815   define  buffer buf-goods      for ub.goods.
     3816   define  buffer buf-gds-prt    for ub.gds-prt.
     3817   define  buffer buf-gds-grp    for ub.gds-grp.
     3818   define  buffer buf-price-doc  for ub.price-doc.
     3819   calc-sub:
     3820   do on error undo calc-sub, return error:
     3821     find  buf-bar-code no-lock where
     3822           buf-bar-code.b-code = bc.
     3823     find  buf-goods no-lock where
     3824           buf-goods.gds-code = buf-bar-code.gds-code.
     3825     find  buf-gds-prt no-lock where
     3826           buf-gds-prt.node-code = buf-bar-code.node-code.
     3827     find  buf-price-list where
     3828           buf-price-list.doc-num    = d-num and
     3829           buf-price-list.b-code     = bc and
     3830           buf-price-list.price-type = "".
     3831     find  buf-price-doc where
     3832           buf-price-doc.doc-num = d-num.
     3833     calc-rec = recid (buf-price-list).
     3834     if buf-price-list.main-price then do:
     3835       for each  buf-price-list where
     3836                 buf-price-list.doc-num    = buf-price-doc.doc-num and
     3837                 buf-price-list.main-price = no and
     3838                 buf-price-list.artic      = buf-goods.artic and
     3839                 buf-price-list.prod-type  = buf-goods.prod-type and
     3840                 buf-price-list.prod-code  = buf-goods.prod-code,
     3841           first buf-bar-code no-lock where
     3842                 buf-bar-code.b-code   = buf-price-list.b-code and
     3843                 buf-bar-code.unit-cli = buf-goods.unit-base
     3844           on error undo calc-sub, return error:
     3845         run calc-pr-list (input  buf-bar-code.b-code,
     3846                           input  buf-price-list.doc-num,
     3847                           input  calc-method,
     3848                           input  increase-pc,
     3849                           input  round-method,
     3850                           input  round-base,
     3851                           input ? ,
     3852                           input ? ,
     3853                           input ? ,
     3854                           input ? ,
     3855                           output calc-rec) no-error.
     3856         if error-status :error then
     3857           undo calc-sub, return error.
     3858         calc-rec = recid (buf-price-list).
     3859       end.
     3860       for each  buf-price-list where
     3861                 buf-price-list.doc-num    = buf-price-doc.doc-num and
     3862                 buf-price-list.main-price = no and
     3863                 buf-price-list.artic      = buf-goods.artic and
     3864                 buf-price-list.prod-type  = buf-goods.prod-type and
     3865                 buf-price-list.prod-code  = buf-goods.prod-code,
     3866           first buf-bar-code no-lock where
     3867                 buf-bar-code.b-code    = buf-price-list.b-code and
     3868                 buf-bar-code.unit-cli <> buf-goods.unit-base
     3869           on error undo calc-sub, return error:
     3870         run calc-pr-alt (input buf-price-doc.doc-num,
     3871                         input buf-bar-code.b-code,
     3872                         input round-method,
     3873                         input round-base) no-error.
     3874         if error-status :error then
     3875           undo calc-sub, return error.
     3876       end.
     3877     end.
     3878     else do:
     3879       run calc-base-upd (input buf-bar-code.b-code,
     3880                         input buf-price-doc.doc-num,
     3881                         input round-method,
     3882                         input round-base) no-error.
     3883       if error-status :error then
     3884         undo calc-sub, return error.
     3885     end.
     3886   end.
     3887   END PROCEDURE.
     3888   procedure ver-pr-nogds :
     3889   define input  parameter p-gds-code      as integer   no-undo .
     3890   define input  parameter p-par-pr-nogds  as character no-undo .
     3891   define output parameter p-not           as logical   no-undo .
     3892   define output parameter p-str           as character no-undo .
     3893   define buffer buf_goods for ub.goods  .
     3894   define variable nn as integer   no-undo .
     3895   define variable ii as integer   no-undo .
     3896   define variable v-namegrp as character no-undo .
     3897     do
     3898     on error undo, return error return-value
     3899     :
     3900     if p-par-pr-nogds = "1" then do:
     3901        assign
     3902         p-not = true
     3903         p-str = ""
     3904        .
     3905        return .
     3906     end.
     3907     assign
     3908       p-not = false
     3909       p-str = ""
     3910     .
     3911     find first buf_goods no-lock where
     3912                buf_goods.gds-code = p-gds-code no-error .
     3913     nn = num-entries(par-pr-nogds-long,chr(4)) .
     3914     repeat ii = 1 to nn:
     3915        v-namegrp = entry(ii , par-pr-nogds-long , chr(4) ) no-error .
     3916        if buf_goods.grp-name  begins v-namegrp  then do:
     3917           assign
     3918             p-not = true
     3919             p-str = substitute ( "Товар &1 &2 &3  может быть включен в ДНЦ из-за исключения запрета по группе : &4"  , buf_goods.artic, buf_goods.gds-name , buf_goods.grp-name , v-namegrp )
     3920           .
     3921           leave .
     3922        end.
     3923     end.
     3924     end.
     3925   end procedure.
     3926   define variable vss-include-info46 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3927   define variable vss-include-info47 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3928   define temp-table tt-level-dis-attr no-undo
     3929         field attr-code   like global-state-attr.attr-code
     3930         field attr-value  like global-state-attr.attr-value
     3931         index pi   attr-value descending
     3932         index pi1 is unique attr-value
     3933               attr-code .
     3934   procedure lvldsc-byattr :
     3935   define input  parameter p-attr-code  as character no-undo .
     3936   define input  parameter p-attr-value as character no-undo .
     3937   define output parameter p-val1       as decimal   no-undo .
     3938   define output parameter p-val2       as decimal   no-undo .
     3939   define output parameter p-prc        as decimal   no-undo .
     3940     do
     3941     on error undo, return error return-value
     3942     :
     3943     define variable v-str1 as character no-undo .
     3944     v-str1 = trim ( p-attr-code , 'level-discnt':U ) .
     3945     v-str1 = trim ( v-str1 , chr(4) ) .
     3946    run lvldsc-bytt (
     3947         input   v-str1
     3948       , input   p-attr-value
     3949       , output  p-val1
     3950       , output  p-val2
     3951       , output  p-prc )
     3952         no-error .
     3953     end.
     3954   end procedure.
     3955   procedure lvldsc-bytt :
     3956   define input  parameter p-attr-code as character no-undo .
     3957   define input  parameter p-attr-value as character no-undo .
     3958   define output parameter p-val1 as decimal   no-undo .
     3959   define output parameter p-val2 as decimal   no-undo .
     3960   define output parameter p-prc  as decimal   no-undo .
     3961   define variable v-str1 as character no-undo .
     3962     do
     3963     on error undo, return error return-value
     3964     :
     3965     assign
     3966        v-str1 = trim ( p-attr-code , "[]()" )
     3967        p-val1 = decimal(entry(1,v-str1, ";"))
     3968        p-val2 = decimal(entry(2,v-str1, ";"))
     3969        p-prc  = decimal(p-attr-value)
     3970        no-error
     3971     .
     3972     end.
     3973   end procedure.
     3974   procedure level-dis-value :
     3975   define input  parameter p-price-prod as decimal   no-undo .
     3976   define input  parameter p-b-code     as integer   no-undo .
     3977   define input  parameter p-obj-type   as character no-undo .
     3978   define input  parameter p-obj-code   as integer   no-undo .
     3979   define output parameter p-prc as decimal   no-undo .
     3980   define variable v-level-dis-attr as character no-undo .
     3981   define variable v-type as character no-undo .
     3982   define variable v-val1 as decimal   no-undo .
     3983   define variable v-val2 as decimal   no-undo .
     3984   define variable v-prc  as decimal   no-undo .
     3985   define variable ix     as integer   no-undo .
     3986   do
     3987    on error undo, return error return-value
     3988    :
     3989   define buffer buf_goods for ub.goods  .
     3990   define buffer buf_bar-code for ub.bar-code  .
     3991   find first buf_bar-code no-lock where
     3992              buf_bar-code.b-code = p-b-code
     3993              no-error .
     3994   find first buf_goods no-lock where
     3995              buf_goods.gds-code = buf_bar-code.gds-code
     3996              no-error .
     3997   run ggoattr-value (
     3998      input   buf_goods.grp-code
     3999     ,input   v-cntxt-host-code-obj
     4000     ,input   p-obj-type
     4001     ,input   p-obj-code
     4002     ,input   'level-dis':U
     4003     ,output  v-level-dis-attr
     4004     ,output  v-type ) no-error .
     4005   repeat ix = 1 to num-entries (v-level-dis-attr, chr(4)) - 1 :
     4006     create
     4007       tt-level-dis-attr
     4008     .
     4009     tt-level-dis-attr.attr-code = entry (1, entry (ix, v-level-dis-attr, chr(4)), chr(44)) .
     4010     tt-level-dis-attr.attr-value = entry (2, entry (ix, v-level-dis-attr, chr(4)), chr(44)) .
     4011   end.
     4012   p-prc = 0 .
     4013     if p-price-prod = 0 then do:
     4014         for each tt-level-dis-attr no-lock
     4015                 :
     4016               run lvldsc-bytt (
     4017                 input   tt-level-dis-attr.attr-code
     4018               , input   tt-level-dis-attr.attr-value
     4019               , output  v-val1
     4020               , output  v-val2
     4021               , output  v-prc  )
     4022               .
     4023               if v-val1  = 0  then do:
     4024                  p-prc = v-prc .
     4025                 leave.
     4026               end.
     4027         end.
     4028     end.
     4029     else do:
     4030         for each tt-level-dis-attr no-lock
     4031                 :
     4032               run lvldsc-bytt (
     4033                 input   tt-level-dis-attr.attr-code
     4034               , input   tt-level-dis-attr.attr-value
     4035               , output  v-val1
     4036               , output  v-val2
     4037               , output  v-prc  )
     4038               .
     4039               if p-price-prod   > v-val1 and
     4040                  p-price-prod  <= v-val2 then do:
     4041                  p-prc = v-prc .
     4042                 leave.
     4043               end.
     4044         end.
     4045     end.
     4046   for each tt-level-dis-attr no-lock. delete tt-level-dis-attr. end.
     4047    end.
     4048   end procedure.
     4049   procedure calc-price-levelprod :
     4050   define input  parameter p-mode     as integer   no-undo .
     4051   define input  parameter p-rb       as character no-undo .
     4052   define input  parameter p-b-code   as integer   no-undo .
     4053   define input  parameter p-obj-type as character no-undo .
     4054   define input  parameter p-obj-code as integer   no-undo .
     4055   define output parameter p-price-sale as decimal   no-undo .
     4056   define output parameter p-descript-calc as character no-undo .
     4057   define variable  v-PriceWithoutVat as decimal   no-undo init 0.
     4058   define variable  v-PriceWithVat    as decimal   no-undo init 0.
     4059   define variable  v-prod-vat        as decimal   no-undo init 0.
     4060   define variable  v-discnt          as decimal   no-undo init 0.
     4061   define buffer buf_goods for ub.goods  .
     4062   define buffer buf_bar-code for ub.bar-code  .
     4063   define buffer buf_parts for ub.parts  .
     4064   define variable v-part-code as character no-undo .
     4065   define variable v-in-code   as character no-undo .
     4066     do
     4067     on error undo, return error return-value
     4068     :
     4069   define variable vss-include-info48 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4070   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run proprice in g#library
     4071   (  input  p-b-code
     4072    , input  p-obj-type
     4073    , input  p-obj-code
     4074    , output v-PriceWithoutVat
     4075    , output v-PriceWithVat
     4076    , output v-prod-vat
     4077    , output v-part-code
     4078    , output v-in-code
     4079           ) no-error .
     4080         if error-status :error then do:
     4081           return error "Нет цены производителя!".
     4082         end.
     4083   find first buf_bar-code no-lock where
     4084              buf_bar-code.b-code = p-b-code
     4085              no-error .
     4086   find first buf_goods no-lock where
     4087              buf_goods.gds-code = buf_bar-code.gds-code
     4088              no-error .
     4089   find first buf_parts no-lock where
     4090              buf_parts.artic      = buf_goods.artic        and
     4091              buf_parts.prod-type  = buf_goods.prod-type    and
     4092              buf_parts.prod-code  = buf_goods.prod-code    and
     4093              buf_parts.in-code    = buf_bar-code.in-code   and
     4094              buf_parts.out-code   = buf_bar-code.in-code   and
     4095              buf_parts.part-code  = buf_bar-code.part-code
     4096              no-error .
     4097               if error-status :error then do:
     4098                   find first buf_parts no-lock where
     4099                             buf_parts.artic      = buf_goods.artic        and
     4100                             buf_parts.prod-type  = buf_goods.prod-type    and
     4101                             buf_parts.prod-code  = buf_goods.prod-code    and
     4102                             buf_parts.in-code    = v-in-code              and
     4103                             buf_parts.out-code   = v-in-code              and
     4104                             buf_parts.part-code  = v-part-code
     4105                             no-error .
     4106                   if error-status :error then do:
     4107                      message
     4108                       substitute("Нет цены производителя !  &1 &2&3&4&5"  ,
     4109                                   v-in-code,
     4110                                   v-part-code ,
     4111                                   buf_goods.artic   ,
     4112                                   buf_goods.prod-type,
     4113                                   buf_goods.prod-code ) .
     4114                      return error "Нет цены производителя !!!".
     4115                   end.
     4116               end.
     4117   run level-dis-value ( input (if p-mode = 2 then v-PriceWithoutVat else v-PriceWithVat) , input p-b-code, input p-obj-type, input p-obj-code, output v-discnt ) no-error .
     4118   define variable v-postWithoutVat-rubl as decimal   no-undo .
     4119   define variable v-postWithoutVat-base as decimal   no-undo .
     4120      case p-mode :
     4121       when 1 then do:
     4122          if p-rb = "rubl" then do:
     4123             p-price-sale = buf_parts.price-rubl + ( MINIMUM ( buf_parts.price-rubl , v-PriceWithVat ) * v-discnt / 100 ).
     4124          end.
     4125          else do:
     4126             p-price-sale = buf_parts.price-base + ( MINIMUM ( v-PriceWithVat , buf_parts.price-base ) * v-discnt / 100 ).
     4127          end.
     4128       end.
     4129       when 2 then do:
     4130         if p-rb = "rubl" then do:
     4131           v-postWithoutVat-rubl =  buf_parts.price-rubl - (buf_parts.price-rubl * buf_parts.vat-pc / (100 + buf_parts.vat-pc) ).
     4132           p-price-sale = v-postWithoutVat-rubl + ( MINIMUM ( v-PriceWithoutVat , v-postWithoutVat-rubl ) * v-discnt / 100 ) .
     4133         end.
     4134         else do:
     4135           v-postWithoutVat-base = buf_parts.price-base - (buf_parts.price-base * buf_parts.vat-pc / ( 100 + buf_parts.vat-pc) ) .
     4136           p-price-sale = v-postWithoutVat-base + ( MINIMUM ( v-PriceWithoutVat, v-postWithoutVat-base) * v-discnt / 100 ) .
     4137         end.
     4138       end.
     4139      end case.
     4140   p-descript-calc =
     4141     string(p-mode) + '_Элементы расчета: ' +  chr(10)  +
     4142     buf_goods.gds-name                  +  chr(10) +
     4143     buf_goods.artic +
     4144     buf_goods.prod-type +
     4145     string(buf_goods.prod-code)         + chr(10) +
     4146     "бар-код " +  string(p-b-code)      + chr(10)  +
     4147     'ПН    ' + v-in-code  +
     4148     ' серия ' + v-part-code             +  chr(10)  + chr(10) +
     4149     'Цена поставщика без ндс    '  + string((buf_parts.price-rubl - (buf_parts.price-rubl * buf_parts.vat-pc / (100 + buf_parts.vat-pc) ) ))  + chr(10) +
     4150     'Цена поставщика   c ндс    '  + string ( buf_parts.price-rubl )  + chr(10) +
     4151     'Цена производителя без ндс ' +  string( v-PriceWithoutVat)       + chr(10) +
     4152     'Цена производителя   c ндс ' +  string( v-PriceWithVat  )        + chr(10) +
     4153     chr(10) +
     4154     "% пороговой наценки        "  + string(v-discnt)                 + chr(10) +
     4155     chr(10) +
     4156     "сумма наценки от произв без ндс "  + string( v-PriceWithoutVat * v-discnt / 100 ) +  chr(10) +
     4157     "сумма наценки от произв   с ндс "  + string( v-PriceWithVat * v-discnt / 100 )    +  chr(10)  +
     4158     chr(10) +
     4159     string(p-price-sale)                                                               +  chr(10) +
     4160     (if p-mode = 1 then substitute("ПорогПр+НДС  &1 + ( min(&2или &1) * &3 / 100 )  = &4 " , buf_parts.price-rubl , v-PriceWithVat , v-discnt , p-price-sale)
     4161     else                substitute("ПорогПр-НДС  &1 - ( &1 * &2 / 100 ) + ( min(&3 или &6 ) * &4 / 100 ) = &5 и еще накручивается НДС " , buf_parts.price-rubl , buf_parts.vat-pc , v-PriceWithoutVat , v-discnt , p-price-sale , v-postWithoutVat-rubl))
     4162   .
     4163     end.
     4164   end procedure.
     4165   define variable vss-include-info49 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4166   PROCEDURE write-bonus :
     4167   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     4168   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     4169   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     4170   define input  parameter v-bonus as decimal   no-undo .
     4171     do
     4172     on error undo, return error return-value
     4173     :
     4174       find first ub.contract-specif-attr exclusive-lock  where
     4175                  ub.contract-specif-attr.contract-num = p-contract-num  and
     4176                  ub.contract-specif-attr.host-code    = p-host-code     and
     4177                  ub.contract-specif-attr.gds-code     = p-gds-code      and
     4178                  ub.contract-specif-attr.attr-code    = 'bonus':U
     4179                 no-error .
     4180         if not available ub.contract-specif-attr then do:
     4181            create ub.contract-specif-attr .
     4182            assign
     4183                 ub.contract-specif-attr.contract-num = p-contract-num
     4184                 ub.contract-specif-attr.host-code    = p-host-code
     4185                 ub.contract-specif-attr.gds-code     = p-gds-code
     4186                 ub.contract-specif-attr.attr-code    = 'bonus':U
     4187            .
     4188         end.
     4189         ub.contract-specif-attr.attr-value  = string (v-bonus) .
     4190   end.
     4191   END PROCEDURE.
     4192   PROCEDURE read-bonus :
     4193   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     4194   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     4195   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     4196   define output parameter v-bonus as decimal   no-undo .
     4197     do
     4198     on error undo, return error return-value
     4199     :
     4200   find first ub.contract-specif-attr no-lock  where
     4201              ub.contract-specif-attr.contract-num = p-contract-num  and
     4202              ub.contract-specif-attr.host-code    = p-host-code     and
     4203              ub.contract-specif-attr.gds-code     = p-gds-code      and
     4204              ub.contract-specif-attr.attr-code    = 'bonus':U
     4205              no-error .
     4206      if available ub.contract-specif-attr then  v-bonus = decimal (ub.contract-specif-attr.attr-value ) .
     4207                                           else  v-bonus = 0 .
     4208   end.
     4209   END PROCEDURE.
     4210   PROCEDURE write-prc-min :
