     5792                 input (if buf_trn-doc.ext-doc-type = 'ie':U then buf_doc-line.price-base else buf_gds-dtl.price-base ) ,
     5793                 output cost-rubl       ,
     5794                 output v4
     5795                 ) no-error .
     5796             end.
     5797             else do:
