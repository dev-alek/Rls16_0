        1   block-level on error undo, throw.
        2   define input parameter p-silent as logical no-undo .
        3   define input parameter p-rec as recid no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision$":U .
        5   define variable vss-author      as character no-undo init "$Author$":U .
        6   define variable vss-date        as character no-undo init "$Date$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        8   define variable vss-archive     as character no-undo init "$Archive$":U .
        9   define variable vss-description as character no-undo init "Удаление prop-head".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define variable v-mess as character no-undo .
       69   define buffer buf_prop-head  for dictdb.prop-head.
       70   define buffer buf_prop-ruleset  for dictdb.prop-ruleset.
       71   define buffer buf_prop-script for ub.prop-script.
       72   define buffer buf_prop-map for ub.prop-map.
       73   define buffer buf_ruledict for ub.ruledict.
       74   define buffer buf_ruledict-param for ub.ruledict-param.
       75   main-block:
       76   do
       77   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
       78   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
       79   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
       80   :
       81     find first buf_prop-head exclusive-lock where
       82             recid(buf_prop-head) = p-rec .
       83     find first buf_prop-ruleset no-lock where
       84               buf_prop-ruleset.dtm-code = buf_prop-head.dtm-code no-error.
       85     if available buf_prop-ruleset then do:
       86       v-mess = substitute("Невозможно удалить ОБЪЕКТ-ОПЕРАНД &1&2" +
       87                  "СУЩЕСТВУЕТ привязка к кодексу или набору правил &3&4"
       88                  , buf_prop-head.dtm-code
       89                  , chr(10)
       90                  , buf_prop-ruleset.codex_id
       91                  , buf_prop-ruleset.ruleset_id
       92                  ).
       93      run err-mess in this-procedure ( input-output v-mess) .
       94      undo, return error (if p-silent = yes then v-mess else '':U).
       95     end.
       96     find first buf_prop-map no-lock where
       97               buf_prop-map.dtm-code = buf_prop-head.dtm-code no-error.
       98     if available buf_prop-map then do:
       99       v-mess = substitute("Невозможно удалить ОБЪЕКТ-ОПЕРАНД &1&2" +
      100                  "СУЩЕСТВУЕТ маппинг  с node-code &3"
      101                  , buf_prop-head.dtm-code
      102                  , chr(10)
      103                  , buf_prop-map.node-code
      104                  ).
      105      run err-mess in this-procedure ( input-output v-mess) .
      106      undo, return error (if p-silent = yes then v-mess else '':U).
      107     end.
      108     find first buf_prop-script no-lock where
      109               buf_prop-script.dtm-code = buf_prop-head.dtm-code  no-error.
      110     if available buf_prop-script  then do:
      111       v-mess = substitute("Невозможно удалить ОБЪЕКТ-ОПЕРАНД&1" +
      112                  "существует СКРИПТ &2 &3"
      113                  , chr(10)
      114                  , buf_prop-script.language
      115                  , buf_prop-script.script-name).
      116      run err-mess in this-procedure ( input-output v-mess) .
      117      undo, return error (if p-silent = yes then v-mess else '':U).
      118     end.
      119     for each buf_ruledict where
      120             buf_ruledict.uniq-key-rec = buf_prop-head.uniq-key-rec
      121     on error undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)):
      122      for each buf_ruledict-param where
      123              buf_ruledict-param.entry-id = buf_ruledict.entry-id
      124      on error undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)):
      125         delete buf_ruledict-param.
      126      end.
      127      delete buf_Ruledict.
      128     end.
      129     delete buf_prop-head no-error.
      130     if error-status:error then do:
      131       v-mess = substitute("Ошибка при удалении: &1&2&3"
      132                            , error-status:get-message(1)
      133                            , chr(10)
      134                            , return-value ).
      135      run err-mess in this-procedure ( input-output v-mess) .
      136      undo main-block, return error (if p-silent = yes then v-mess else '':U).
      137     end.
      138   end.
      139   PROCEDURE err-mess:
      140     DEFINE INPUT-OUTPUT PARAMETER p-mess as character No-UNDO.
      141     CASE p-silent:
      142       when yes then do:
      143         assign
      144         p-mess = substitute("Объект-операнд: код объекта &1:&2&3"
      145                            , buf_prop-head.dtm-code
      146                            , chr(10)
      147                            , p-mess)
      148         .
      149       end.
      150       when no then do:
      151         message
      152         p-mess
      153         view-as alert-box error .
      154       end.
      155     end.
      156   END PROCEDURE.
