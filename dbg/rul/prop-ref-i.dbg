     2070   MAIN-BLOCK:
     2071   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2072      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2073      ON stop UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK   :
     2074     if p-dtm-code > 0 then do:
     2075       find first buf_prop-head no-lock where
     2076                           buf_prop-head.dtm-code = p-dtm-code no-error .
     2077       if not available buf_prop-head then do:
     2078         message
     2079         vss-workfile vss-revision vss-description skip
     2080         substitute("Неверное значение параметра p-dtm-code=&1", p-dtm-code)
     2081         view-as alert-box error .
     2082         undo, return error .
     2083       end.
     2084     end.
     2085     IF p-mode = 'ДОБАВЛЕНИЕ':U THEN DO:
     2086       FIND FIRST first_prop-ref EXCLUSIVE-LOCK.
     2087       CREATE tt-prop-ref.
     2088       ASSIGN
     2089       tt-prop-ref.caller_id = p-caller-id
     2090       tt-prop-ref.dtm-code = p-dtm-code
     2091       tt-prop-ref.ref-type = (if available buf_prop-head
     2092                               then buf_prop-head.ref-type
     2093                               else '':U)
     2094       .
     2095     END.
     2096     else do:
     2097       IF p-mode = 'ИЗМЕНЕНИЕ':U THEN DO:
     2098         FIND FIRST LOCKED_prop-ref EXCLUSIVE-LOCK WHERE
     2099                   LOCKED_prop-ref.dt-code = p-dt-code .
     2100       END.
     2101       IF p-mode = 'ПРОСМОТР':U THEN DO:
     2102           FIND FIRST LOCKED_prop-ref no-LOCK WHERE
     2103                     LOCKED_prop-ref.dt-code = p-dt-code NO-ERROR.
     2104       END.
     2105       create tt-prop-ref.
     2106       buffer-copy locked_prop-ref to tt-prop-ref.
     2107     end.
     2108     RUN Myenable.
     2109     WAIT-FOR GO OF FRAME Dialog-Frame.
     2110   END.
     2111   RUN disable_UI.
     2112   PROCEDURE change-ref-type :
     2113   DEFINE INPUT PARAMETER p-ref-type AS CHARACTER NO-UNDO.
     2114   DEFINE VARIABLE glog AS logical NO-UNDO.
     2115   DEFINE VARIABLE date-1 AS date NO-UNDO.
     2116   DEFINE VARIABLE date-2 AS date NO-UNDO.
     2117   DEFINE VARIABLE v-dop AS character NO-UNDO.
     2118   DEFINE VARIABLE v-dop1 AS character NO-UNDO.
     2119   DEFINE VARIABLE v-dop2 AS character NO-UNDO.
     2120   DEFINE VARIABLE v-m AS integer NO-UNDO.
     2121   DEFINE VARIABLE v-y AS integer NO-UNDO.
     2122   DEFINE VARIABLE v-today as date no-undo .
     2123   DEFINE VARIABLE v-time as integer no-undo .
     2124   DEFINE VARIABLE v-ii as integer no-undo .
     2125   DEFINE VARIABLE v-ref-type as character no-undo .
     2126   DO v-ii = 1 TO NUM-ENTRIES(p-ref-type, ":"):
     2127   ASSIGN
     2128   v-ref-type = ENTRY(v-ii, p-ref-type, ":")
     2129   .
     2130   CASE v-ref-type:
     2131     WHEN 'esys':U THEN DO:
     2132         enable
     2133         b-esys
     2134         WITH FRAME Dialog-Frame.
     2135         DISABLE
     2136         tt-prop-ref.caller_id
     2137         WITH FRAME Dialog-Frame.
     2138         HIDE
     2139         tt-prop-ref.caller_id
     2140         b-main-part
     2141         in FRAME Dialog-Frame.
     2142     END.
     2143     WHEN 'period':U THEN DO:
     2144       run cur-time in this-procedure ( output v-today, output v-time).
     2145       ASSIGN
     2146       v-m = MONTH(v-today)
     2147       v-y = YEAR(v-today)
     2148       .
     2149       IF v-m = 12  THEN DO:
     2150           ASSIGN
     2151           v-m = 1
     2152           v-y = v-y + 1
     2153           .
     2154       END.
     2155       ELSE DO:
     2156           ASSIGN
     2157           v-m = v-m + 1
     2158           .
     2159       END.
     2160       date-1 = DATE( v-m, 1, v-y).
     2161       IF v-m = 12  THEN DO:
     2162           ASSIGN
     2163           v-m = 1
     2164           v-y = v-y + 1
     2165           .
     2166       END.
     2167       ELSE DO:
     2168           ASSIGN
     2169           v-m = v-m + 1
     2170           .
     2171       END.
     2172       ASSIGN
     2173       date-2 = DATE( v-m, 1, v-y)
     2174       date-2 = date-2 - 1
     2175       .
     2176       run gbl/get-per.w ( output glog
     2177                     , input-output date-1
     2178                     , input-output date-2) .
     2179       IF NOT glog THEN RETURN NO-APPLY.
     2180       IF date-1 <= v-today
     2181         OR date-2 <= v-today THEN DO:
     2182           MESSAGE
     2183           "Нельзя ввести частный итог для текущего периода времени"
     2184           VIEW-AS ALERT-BOX ERROR.
     2185           UNDO, RETURN ERROR.
     2186       END.
     2187       ASSIGN
     2188       v-dop1 = propreft-date-to-string(date-1) + '-' + propreft-date-to-string(date-1)
     2189       v-dop2 = propreft-date-to-string(date-2) + '-' + propreft-date-to-string(date-2)
     2190       v-dop = propreft-date-to-string(date-1) + '-' + propreft-date-to-string(date-2)
     2191       .
     2192       f-date-from = date-1.
     2193       f-date-to = date-2.
     2194        DISPLAY
     2195        tt-prop-ref.caller_id
     2196        WITH FRAME Dialog-Frame.
     2197        enable
     2198        tt-prop-ref.caller_id WHEN p-mode <> 'ПРОСМОТР':U
     2199        WITH FRAME Dialog-Frame.
     2200        hIDE
     2201        b-main-part
     2202        in FRAME Dialog-Frame.
     2203     END.
     2204     when 'sel-goods':U then do:
     2205       DISABLE
     2206       tt-prop-ref.caller_id
     2207       WITH FRAME Dialog-Frame.
     2208       HIDE
     2209       tt-prop-ref.caller_id
     2210       b-main-part
     2211       in FRAME Dialog-Frame.
     2212     end.
     2213     when 'one-ptrl':U then do:
     2214       DISABLE
     2215       tt-prop-ref.caller_id
     2216       WITH FRAME Dialog-Frame.
     2217       HIDE
     2218       tt-prop-ref.caller_id
     2219       in FRAME Dialog-Frame.
     2220       display
     2221       b-main-part
     2222       with frame Dialog-Frame .
     2223     end.
     2224   END CASE.
     2225   END.
     2226   ASSIGN
     2227   tt-prop-ref.sum-id = v-dop.
     2228   DISPLAY
     2229   tt-prop-ref.sum-id
     2230   WITH FRAME Dialog-Frame.
     2231   END PROCEDURE.
     2232   PROCEDURE disable_UI :
     2233     HIDE FRAME Dialog-Frame.
     2234   END PROCEDURE.
     2235   PROCEDURE display-ref-type :
     2236   DEFINE INPUT PARAMETER p-ref-type AS CHARACTER NO-UNDO.
     2237   DEFINE INPUT PARAMETER p-prop-name AS CHARACTER NO-UNDO.
     2238   DEFINE VARIABLE v-ref-type as character no-undo .
     2239   DEFINE VARIABLE v-ii AS integer no-undo .
     2240   HIDE
     2241   f-date-from
     2242   IN FRAME Dialog-Frame.
     2243   HIDE
     2244   f-date-from f-date-to f-prefix f-sum-id-main-part b-main-part f-esys-id b-esys tt-prop-ref.Caller_id
     2245   IN FRAME Dialog-Frame.
     2246   DO v-ii = 1 TO NUM-ENTRIES(p-ref-type, ":"):
     2247   ASSIGN
     2248   v-ref-type = ENTRY(v-ii, p-ref-type, ":")
     2249   .
     2250   CASE v-ref-type:
     2251    WHEN 'esys':U THEN DO:
     2252       display
     2253       f-esys-id
     2254       WITH FRAME Dialog-Frame.
     2255       IF p-mode = 'ДОБАВЛЕНИЕ':U THEN DO:
     2256         ENABLE
     2257         b-esys
     2258         WITH FRAME Dialog-Frame.
     2259       END.
     2260     END.
     2261     WHEN 'period':U THEN DO:
     2262       DISPLAY
     2263       f-date-from f-date-to
     2264       tt-prop-ref.Caller_id
     2265       WITH FRAME Dialog-Frame.
     2266       IF p-mode = 'ДОБАВЛЕНИЕ':U THEN DO:
     2267          ENABLE
     2268          f-date-from
     2269          f-date-to
     2270          WITH FRAME Dialog-Frame.
     2271       END.
     2272       hide
     2273       b-main-part in FRAME Dialog-Frame.
     2274     END.
     2275     WHEN 'sel-goods':U THEN DO:
     2276       DISPLAY
     2277       "G":U @ f-prefix f-sum-id-main-part
     2278       WITH FRAME Dialog-Frame.
     2279       IF p-mode = 'ДОБАВЛЕНИЕ':U THEN DO:
     2280         ENABLE
     2281         f-sum-id-main-part
     2282         WITH FRAME Dialog-Frame.
     2283       END.
     2284       HIDE
     2285       b-main-part IN FRAME Dialog-Frame.
     2286     END.
     2287     WHEN 'one-ptrl':U THEN DO:
     2288       DISABLE
     2289       tt-prop-ref.caller_id
     2290       WITH FRAME Dialog-Frame.
     2291       DISPLAY
     2292       "petrol":U @ f-prefix f-sum-id-main-part b-main-part
     2293       WITH FRAME Dialog-Frame.
     2294       IF p-mode = 'ДОБАВЛЕНИЕ':U THEN DO:
     2295         enable
     2296         b-main-part
     2297         WITH FRAME Dialog-Frame.
     2298       END.
     2299     END.
     2300     WHEN 'blank':U THEN DO:
     2301         DISPLAY
     2302         p-prop-name @ f-prefix
     2303         WITH FRAME Dialog-Frame.
     2304     END.
     2305   END CASE.
     2306   END.
     2307   END PROCEDURE.
     2308   PROCEDURE enable_UI :
     2309     OPEN QUERY Dialog-Frame FOR EACH tt-prop-ref SHARE-LOCK.
     2310     GET FIRST Dialog-Frame.
     2311     DISPLAY f-date-from f-date-to f-prefix f-sum-id-main-part f-esys-id
     2312             f-prop-name
     2313         WITH FRAME Dialog-Frame.
     2314     IF AVAILABLE tt-prop-ref THEN
     2315       DISPLAY tt-prop-ref.dt-code tt-prop-ref.ref-type tt-prop-ref.sum-id
     2316             tt-prop-ref.dtm-code tt-prop-ref.Caller_id
     2317         WITH FRAME Dialog-Frame.
     2318     ENABLE B-exit b-quit B-Help tt-prop-ref.dt-code tt-prop-ref.ref-type
     2319            tt-prop-ref.sum-id f-date-from f-date-to f-prefix f-sum-id-main-part
     2320            b-main-part f-esys-id b-esys tt-prop-ref.dtm-code b-prop-head
     2321            f-prop-name tt-prop-ref.Caller_id
     2322         WITH FRAME Dialog-Frame.
     2323     VIEW FRAME Dialog-Frame.
     2324   END PROCEDURE.
     2325   PROCEDURE MyEnable :
     2326   DEFINE VARIABLE v-ii AS INTEGER NO-UNDO.
     2327   DEFINE VARIABLE v-dop AS CHARACTER NO-UNDO.
     2328   define variable dops as character no-undo .
     2329   define variable dopst as character no-undo .
     2330   DEFINE BUFFER buf_prop-head FOR ub.prop-head.
     2331   DO v-ii = 1 TO NUM-ENTRIES('blank,period,sel-goods,one-ptrl':U):
     2332      ASSIGN
     2333      v-dop = v-dop + ENTRY(v-ii, '_,Период дат,Опред.товары,Вид топлива':U) + chr(44) +
     2334              ENTRY(v-ii, 'blank,period,sel-goods,one-ptrl':U) + chr(44).
     2335   END.
     2336   ASSIGN
     2337   v-dop = TRIM(v-dop, chr(44)).
     2338   ASSIGN
     2339   tt-prop-ref.ref-type:radio-buttons IN FRAME Dialog-Frame = v-dop.
     2340   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     2341     (input  'is-elved'
     2342     ,input  ''
     2343     ,input  ''
     2344     ,input  0
     2345     ,input  ''
     2346     ,input  ''
     2347     ,input  ''
     2348     ,input  no
     2349     ,output dops
     2350     ,output dopst
     2351     ) no-error .
     2352   if error-status:error
     2353   or logical(dops) = no then do:
     2354     is-elved = no.
     2355   end.
     2356   dops = ''.
     2357   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     2358     (input  'is-ef'
     2359     ,input  ''
     2360     ,input  ''
     2361     ,input  0
     2362     ,input  ''
     2363     ,input  ''
     2364     ,input  ''
     2365     ,input  no
     2366     ,output dops
     2367     ,output dopst
     2368     ) no-error .
     2369   if error-status:error
     2370   or logical(dops) = no then do:
     2371     is-ef = no.
     2372   end.
     2373   if is-elved = no
     2374   and is-ef = no then do:
     2375     tt-prop-ref.ref-type:disable(radio-label('one-ptrl':U
     2376                                 , tt-prop-ref.ref-type:radio-buttons IN FRAME Dialog-Frame)) in frame Dialog-Frame .
     2377   end.
     2378   IF p-mode = 'ДОБАВЛЕНИЕ':U
     2379   and tt-prop-ref.dtm-code = 0
     2380   THEN DO:
     2381      f-prop-name = chr(63).
     2382   END.
     2383   ELSE DO:
     2384     FIND FIRST buf_prop-head NO-LOCK WHERE
     2385               buf_prop-head.dtm-CODE = tt-prop-ref.dtm-code.
     2386    f-prop-name = buf_prop-head.prop-label.
     2387   END.
     2388   DISPLAY
     2389   f-prop-name
     2390   WITH FRAME Dialog-Frame.
     2391   IF AVAILABLE tt-prop-ref THEN
     2392   DISPLAY
     2393   tt-prop-ref.dt-code
     2394   tt-prop-ref.dtm-code
     2395   tt-prop-ref.sum-id
     2396   tt-prop-ref.caller_id
     2397   tt-prop-ref.ref-type
     2398   WITH FRAME Dialog-Frame.
     2399   ENABLE
     2400   B-exit WHEN p-mode <> 'ПРОСМОТР':U
     2401   b-quit
     2402   B-Help
     2403   tt-prop-ref.sum-id  WHEN p-mode <> 'ПРОСМОТР':U AND p-mode <> 'ДОБАВЛЕНИЕ':U
     2404   tt-prop-ref.caller_id  WHEN p-mode <> 'ПРОСМОТР':U
     2405   b-prop-head WHEN p-mode = 'ДОБАВЛЕНИЕ':U and tt-prop-ref.dtm-code = 0
     2406   WITH FRAME Dialog-Frame .
     2407   VIEW FRAME Dialog-Frame .
     2408   if tt-prop-ref.dtm-code > 0
     2409   and p-mode = 'ДОБАВЛЕНИЕ':U then do:
     2410     apply "VALUE-CHANGED" to tt-prop-ref.ref-type.
     2411     RUN display-ref-type IN THIS-PROCEDURE ( INPUT tt-prop-ref.ref-type, (if available buf_prop-head then buf_prop-head.prop-name else '')).
     2412   end.
     2413   hide
     2414   f-esys-id
     2415   b-esys
     2416   in frame Dialog-Frame .
     2417   END PROCEDURE.
     2418   PROCEDURE proc-esys-id :
     2419   DEFINE INPUT PARAMETER p-ref-type AS character NO-UNDO.
     2420   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     2421   define variable v-uniq-key-rec as character no-undo .
     2422   define variable v-tbl-row as rowid no-undo .
     2423   define variable v-tbl-name as character no-undo .
     2424   define variable v-ok as logical no-undo .
     2425   define variable v-value-integer as integer no-undo .
     2426   define buffer buf_ext-system for ub.ext-system.
     2427   DEFINE BUFFER buf_goods FOR ub.goods.
     2428   CASE entry(1, p-ref-type, ":"):
     2429       WHEN 'esys':U THEN DO:
     2430         find first buf_ext-system no-lock where
     2431                     buf_ext-system.db-num = 0
     2432                 and buf_ext-system.esys-id = integer(replace(entry(1, p-ref-type, ":"), "es", "")) no-error.
     2433         if available buf_ext-system THEN DO:
     2434             run gen-key-rec in this-procedure (
     2435                                                 input 'ext-system':U
     2436                                                 ,input buffer buf_ext-system:handle
     2437                                                 ,output v-uniq-key-rec) .
     2438         END.
     2439         run bge/oxmlexts.p (
     2440               input parparentproc
     2441             , input 2
     2442             , input substitute("esys-type > &1", '0':U)
     2443             , input v-uniq-key-rec
     2444             , output v-rid-list
     2445             , output v-ok
     2446         ).
     2447         if v-ok then do:
     2448           run gen-row-keyr in this-procedure
     2449             ( input v-rid-list
     2450              ,input ?
     2451              ,input "ub"
     2452              ,input ?
     2453              ,input no-lock
     2454              ,output v-tbl-row
     2455              ,output v-tbl-name
     2456            ).
     2457           find first buf_ext-system no-lock where
     2458                     rowid(buf_ext-system) = v-tbl-row.
     2459           if not (buf_ext-system.esys-type > integer('0':U)) then do:
     2460             message
     2461             "Нужно выбрать ВНЕШНЮЮ СИСТЕМУ типа СПЕЦИАЛЬНЫЙ"
     2462             view-as alert-box error .
     2463             undo, return error.
     2464           end.
     2465           assign
     2466           v-value-integer = buf_Ext-system.esys-id.
     2467           ASSIGN
     2468           f-esys-id = SUBSTITUTE("es&1", buf_Ext-system.esys-id).
     2469           DISPLAY f-esys-id
     2470           WITH FRAME Dialog-Frame.
     2471       END.
     2472     END.
     2473   END CASE.
     2474   END PROCEDURE.
     2475   PROCEDURE proc-main-part :
     2476   DEFINE INPUT PARAMETER p-ref-type AS character NO-UNDO.
     2477   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     2478   DEFINE BUFFER buf_goods FOR ub.goods.
     2479   CASE p-ref-type:
     2480       WHEN 'one-ptrl':U THEN DO:
     2481         run ref/petrlref.p ( INPUT parparentproc
     2482                             ,INPUT "b-sel"
     2483                             ,OUTPUT v-rid-list ) NO-ERROR.
     2484         IF ERROR-STATUS:ERROR
     2485         OR v-rid-list = '':U THEN DO:
     2486            UNDO, RETURN ERROR.
     2487         END.
     2488         FIND FIRST buf_goods no-lock WHERE
     2489                   RECID(buf_goods) = INTEGER(v-rid-list) NO-ERROR.
     2490         IF ERROR-STATUS:ERROR THEN UNDO, RETURN ERROR.
     2491         ASSIGN
     2492         f-sum-id-main-part = string(buf_goods.gds-code).
     2493         DISPLAY f-sum-id-main-part
     2494         WITH FRAME Dialog-Frame.
     2495       END.
     2496   END CASE.
     2497   END PROCEDURE.
     2498   PROCEDURE proc-save :
     2499   DEFINE VARIABLE v-rec AS recID  NO-UNDO.
     2500   IF p-mode = 'ПРОСМОТР':U THEN DO:
     2501       RETURN.
     2502   END.
     2503   DEFINE VARIABLE v-ii AS INTEGER NO-UNDO.
     2504   DEFINE VARIABLE v-sum-id AS CHARACTER NO-UNDO.
     2505   DEFINE VARIABLE v-sum-id-all AS CHARACTER NO-UNDO.
     2506   DO v-ii = 1 TO NUM-ENTRIES(tt-prop-ref.ref-type, ":"):
     2507     CASE entry(v-ii, tt-prop-ref.ref-type, ":"):
     2508       WHEN 'esys':U THEN DO:
     2509         ASSIGN
     2510         FRAME Dialog-Frame
     2511         f-esys-id.
     2512         v-sum-id = f-esys-id.
     2513       END.
     2514       WHEN 'period':U THEN DO:
     2515         ASSIGN
     2516         FRAME Dialog-Frame
     2517         f-date-from
     2518         f-date-to
     2519         .
     2520        if f-date-from = ?
     2521         or f-date-to = ? then do:
     2522           message
     2523           "Не выбраны дата(-ы) начала/конца периода!"
     2524           view-as alert-box error .
     2525           undo, return error .
     2526         end.
     2527         v-sum-id = SUBSTITUTE("&1/&2/&3-&4/&5/&6"
     2528                                         ,string(YEAR(f-date-from), "9999")
     2529                                         ,string(MONTH(f-date-from), "99")
     2530                                         ,string(DAY(f-date-from), "99")
     2531                                         ,string(YEAR(f-date-to), "9999")
     2532                                         ,string(MONTH(f-date-to), "99")
     2533                                         ,string(DAY(f-date-to), "99")).
     2534       END.
     2535       WHEN 'sel-goods':U THEN DO:
     2536         ASSIGN
     2537         f-sum-id-main-part.
     2538         v-sum-id = SUBSTITUTE("&1-&2"
     2539                                         ,f-prefix:SCREEN-VALUE
     2540                                         ,f-sum-id-main-part
     2541                                         ).
     2542       END.
     2543       WHEN 'one-ptrl':U THEN DO:
     2544         if not is-elved
     2545         and not is-ef
     2546         then do:
     2547            message
     2548            'В Вашей конфигурации нельзя добавлять итоги(срезы) типа ТОПЛИВО,' skip
     2549            'так как не включены конфигурационные параметры is-elved и/или is-ef'
     2550            view-as alert-box error .
     2551            undo, return error .
     2552         end.
     2553         ASSIGN
     2554         f-sum-id-main-part.
     2555         v-sum-id = SUBSTITUTE("&1-&2"
     2556                                         ,f-prefix:SCREEN-VALUE
     2557                                         ,f-sum-id-main-part
     2558                                         ).
     2559       END.
     2560       WHEN 'blank':U THEN DO:
     2561         v-sum-id = SUBSTITUTE("&1"
     2562                                         ,f-prefix:SCREEN-VALUE
     2563                                         ).
     2564       END.
     2565     END CASE.
     2566     v-sum-id-all = v-sum-id-all + (IF v-sum-id-all = "":U THEN '':U ELSE ":") + v-sum-id.
     2567   END.
     2568   ASSIGN
     2569   FRAME Dialog-Frame
     2570   tt-prop-ref.dt-code
     2571   tt-prop-ref.dtm-code
     2572   tt-prop-ref.caller_id
     2573   tt-prop-ref.ref-type
     2574   tt-prop-ref.sum-id = v-sum-id-all
     2575   .
     2576   run rul/prop-ref1.p ( INPUT p-mode
     2577                   ,INPUT NO
     2578                   ,INPUT-OUTPUT v-rec
     2579                   ,INPUT tt-prop-ref.dt-code
     2580                   ,INPUT tt-prop-ref.sum-id
     2581                   ,INPUT tt-prop-ref.dtm-code
     2582                   ,INPUT tt-prop-ref.caller_id
     2583                   ,INPUT tt-prop-ref.ref-type
     2584                   ) no-error.
     2585   if error-status:error then do:
     2586   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2587   define variable fh as widget-handle no-undo .
     2588   define variable hh as widget-handle no-undo .
     2589   define variable rv as character no-undo .
     2590   assign
     2591   rv = entry(1, return-value , chr(4)).
     2592   if rv <> "":U then do:
     2593     assign
     2594     fh = frame Dialog-Frame:first-child
     2595     hh = fh:first-child
     2596     .
     2597     do while valid-handle(hh):
     2598       if hh:name = rv then do:
     2599         APPLY "ENTRY" to hh.
     2600         undo ,
     2601         return error.
     2602       end.
     2603       hh = hh:next-sibling.
     2604     end.
     2605   end.
     2606     undo, return error.
     2607   end.
     2608   p-rec = v-rec.
     2609   END PROCEDURE.
