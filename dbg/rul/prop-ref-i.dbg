        1   DEFINE BUFFER locked_prop-ref FOR ub.prop-ref.
        2   DEFINE TEMP-TABLE tt-prop-ref NO-UNDO LIKE ub.prop-ref.
        3   DEFINE INPUT PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO.
        4   DEFINE INPUT PARAMETER p-mode AS CHARACTER NO-UNDO.
        5   define input parameter p-dtm-code as integer no-undo .
        6   DEFINE INPUT PARAMETER p-dt-code AS INTEGER NO-UNDO.
        7   DEFINE INPUT PARAMETER p-caller-id AS character NO-UNDO.
        8   DEFINE INPUT-OUTPUT PARAMETER p-rec AS RECID NO-UNDO.
        9   define variable vss-revision    as character no-undo init "$Revision$":U .
       10   define variable vss-author      as character no-undo init "$Author$":U .
       11   define variable vss-date        as character no-undo init "$Date$":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       13   define variable vss-archive     as character no-undo init "$Archive$":U .
       14   define variable vss-description as character no-undo init "Карточка prop-ref".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       70   define variable v-waitfram-action01         as character   no-undo .
       71   define variable v-waitfram-action02         as character   no-undo .
       72   define variable v-waitfram-action03         as character   no-undo .
       73   define variable mWaitFramTextBeg            as character   no-undo.
       74   define variable mWaitFramTextEnd            as character   no-undo.
       75   define variable mWaitFramView               as logical     no-undo.
       76   define variable mWaitProcEvent              as logical     no-undo init yes.
       77   define variable mWaitFramInterval           as integer     no-undo init 1 .
       78   define variable mWaitFramStop               as logical     no-undo.
       79   define variable mWaitFramStopUser           as logical     no-undo.
       80   define variable mWaitFramStopTimeOut        as logical     no-undo.
       81   define variable mWaitFramStartProc          as datetime-tz no-undo.
       82   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       83   define button B-WaitFramStop auto-end-key
       84        label "Стоп"
       85        size 10 by 1 tooltip "Остоновить процесс".
       86   define button B-viewProcInfo
       87        label "Информация"
       88        size 15 by 1 tooltip "Информация о процесс".
       89   define frame waitfram
       90     v-waitfram-action01 format "x(72)" no-label skip
       91     v-waitfram-action02 format "x(72)" no-label skip
       92     v-waitfram-action03 format "x(72)" no-label skip
       93     B-viewProcInfo
       94     B-WaitFramStop at row 4 col 30
       95     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       96     .
       97   define new global shared variable mBatchMode as logical no-undo init ?.
       98   define variable mFramBachModHandle as handle no-undo.
       99   mFramBachModHandle = frame waitfram:handle.
      100   define variable mFameOldVis as logical no-undo.
      101   define variable mVisCUrentVin as logical no-undo.
      102   if session:batch-mode
      103   then
      104      mBatchMode = yes.
      105   if mBatchMode = ? then do:
      106     mVisCUrentVin = current-window:visible.
      107     mFameOldVis = mFramBachModHandle:visible.
      108     mFramBachModHandle:visible  = yes.
      109     mBatchMode = mFramBachModHandle:visible ne yes.
      110     mFramBachModHandle:visible = mFameOldVis.
      111     current-window:visible = mVisCUrentVin.
      112   end.
      113    if  log-manager:logfile-name ne ?
      114     then DO:
      115         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      116         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      117         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      118     end.
      119   on choose of B-WaitFramStop in frame waitfram
      120   do:
      121     mWaitFramStop = yes.
      122     mWaitFramStopUser = yes.
      123   end.
      124   function waitfram-check-timeout returns logical():
      125      define variable vtime as int64 no-undo.
      126      if mWaitFramStopTimeOut
      127      then
      128         return yes.
      129      vtime = ( now - mWaitFramStartProc ) / 1000 .
      130      if     mWaitFramTimeOut ne ?
      131         and mWaitFramTimeOut ne 0
      132         and mWaitFramTimeOut lt vtime
      133      then do:
      134         mWaitFramStopTimeOut = yes.
      135      end.
      136      return mWaitFramStopTimeOut.
      137   end.
      138   procedure waitfram-hide :
      139     if not session:batch-mode
      140     then do
      141     on error undo, return error return-value
      142     :
      143       pause 0 before-hide .
      144       if not mBatchMode then
      145         hide frame waitfram .
      146     if     not mWaitFramView
      147        and mWaitProcEvent
      148     then
      149       process events .
      150     end.
      151   end procedure.
      152   procedure waitfram-show :
      153     define input  parameter p-message as character no-undo .
      154     define variable v-left-margin as integer   no-undo .
      155     if not session:batch-mode
      156     then do
      157     on error undo, return error return-value
      158     :
      159       if length(p-message) <= 70 then do:
      160         assign
      161           v-left-margin = integer((70 - length(p-message)) / 2)
      162         .
      163         assign
      164           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      165         .
      166         assign
      167           v-waitfram-action01 = " "
      168           v-waitfram-action02 = " "
      169                                    + fill(" ", v-left-margin)
      170                                    + p-message
      171           v-waitfram-action03 = " "
      172         .
      173       end.
      174       else do:
      175         define variable vRindex1 as integer no-undo.
      176         define variable vRindex2 as integer no-undo.
      177         vRindex1 = r-index(p-message," ",70).
      178         if vRindex1 = 0
      179         then
      180            vRindex1 = 70.
      181         if length(p-message)  <= vRindex1 + 70 then do:
      182           assign
      183             v-waitfram-action01 = " "
      184             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      185             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      186           .
      187         end.
      188         else do:
      189           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      190           if vRindex2 <= vRindex1
      191           then
      192              vRindex2 = vRindex1 + 70.
      193           assign
      194             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      195             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      196             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      197           .
      198         end.
      199       end.
      200       B-viewProcInfo:visible   in frame waitfram = no.
      201       B-viewProcInfo:sensitive in frame waitfram = no.
      202       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      203       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      204       if  (   mWaitFramView
      205          or  mWaitProcEvent)
      206          and not mBatchMode
      207       then
      208          display
      209             v-waitfram-action01 skip
      210             v-waitfram-action02 skip
      211             v-waitfram-action03 skip
      212          with frame waitfram .
      213       if     mWaitFramView
      214          then do:
      215             if     mWaitFramInterval ne ?
      216                and not mBatchMode
      217             then
      218                wait-for go of frame waitfram pause mWaitFramInterval.
      219          end.
      220          else
      221             if     mWaitProcEvent
      222                and not mBatchMode
      223             then
      224                process events .
      225     end.
      226   end procedure.
      227      procedure waitfram-show-this:
      228         define input  parameter iInterval as int64 no-undo.
      229         define variable vtime as int64 no-undo.
      230         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      231         mWaitFramInterval = iInterval.
      232         run waitfram-show (substitute("&1&2 &3&4" ,
      233                                       mWaitFramTextBeg ,
      234                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      235                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      236                                       mWaitFramTextEnd
      237                                      )
      238                           ).
      239      end.
      240      procedure WaitFramRunPause:
      241         define input  parameter iInterval as dec no-undo.
      242         define variable vStart  as datetime-tz no-undo.
      243         define variable vend    as datetime-tz no-undo.
      244         define variable vint as int64 no-undo.
      245         define variable vOk as logical no-undo.
      246         vStart = now.
      247         vend   = vStart.
      248         publish "WaitFramPause" (iInterval,output vOk).
      249         vend   =  now.
      250         vint = vend - vStart.
      251         vint = iInterval - vint / 1000.
      252         if     not mWaitFramStop
      253            and (   vint > 0
      254                 or (    not vOk
      255                     and iInterval eq ?
      256                     )
      257                 )
      258         then
      259            run waitfram-show-this (iInterval).
      260         vend   =  now.
      261         vint = vend - vStart.
      262         vint = iInterval - vint / 1000.
      263         if     not mWaitFramStop
      264            and vint > 0
      265         then do:
      266            run gbl/pause.p (vint * 1000).
      267         end.
      268         if iInterval ne ?
      269         then
      270            publish "WaitFramStop".
      271         waitfram-check-timeout().
      272      end.
      273      procedure WaitFramWaitFor:
      274         define input  parameter iInterval as dec no-undo.
      275         assign
      276            mWaitFramStartProc   = now
      277            mWaitFramStopUser    = no
      278            mWaitFramStopTimeOut = no
      279         .
      280         block-wait:
      281         do while not mWaitFramStop:
      282            run WaitFramRunPause (iInterval).
      283            if  waitfram-check-timeout()
      284            then do:
      285               leave block-wait.
      286            end.
      287         end.
      288         run waitfram-hide.
      289      end.
      290   procedure waitfram-join :
      291     define input  parameter p-line-1  as character no-undo .
      292     define input  parameter p-line-2  as character no-undo .
      293     define input  parameter p-line-3  as character no-undo .
      294     define output parameter p-message as character no-undo .
      295     do
      296     on error undo, return error return-value
      297     :
      298       assign
      299         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      300                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      301                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      302       .
      303     end.
      304   end procedure.
      305   function waitfram-join-function returns character
      306     (input p-line-1 as character
      307     ,input p-line-2 as character
      308     ,input p-line-3 as character
      309     ).
      310     define variable v-message as character no-undo .
      311     run waitfram-join in this-procedure
      312       (input  p-line-1
      313       ,input  p-line-2
      314       ,input  p-line-3
      315       ,output v-message
      316       ) .
      317     return v-message .
      318   end function .
      319   define new global shared variable g#language as character no-undo .
      320   if g#language <> '' and g#language <> 'rus':U then do:
      321     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      322   end.
      323   define new global shared variable g#library  as handle no-undo .
      324   define new global shared variable g#library2 as handle no-undo .
      325   procedure proc-alt-shift-f2:
      326     if not ibs.th.gbl.gbl-var:rcode
      327   then
      328     run gbl\inidebug.p .
      329   end.
      330   procedure proc-alt-shift-f3:
      331     run gbl/prvssinf.p
      332       ( input this-procedure
      333       ) .
      334   end.
      335   define variable v-inform-launched as logical no-undo initial false .
      336   procedure proc-alt-shift-f4:
      337     define variable v-action as character no-undo .
      338     if v-inform-launched = false then do:
      339       assign
      340         v-inform-launched = true
      341       .
      342       run gbl/d-inform.w
      343         (  input self
      344         ,  input this-procedure
      345         , output v-action
      346         ) no-error .
      347       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      348       assign
      349         v-inform-launched = false
      350       .
      351     end.
      352   end.
      353   procedure proc-alt-f1:
      354     run gbl/corrhelp.p
      355       (input this-procedure
      356       ) .
      357   end .
      358   on alt-shift-f2 anywhere do:
      359     run proc-alt-shift-f2.
      360   end.
      361   on alt-shift-f3 anywhere do:
      362     run proc-alt-shift-f3 in this-procedure .
      363   end.
      364   on alt-shift-f4 anywhere do:
      365     run proc-alt-shift-f4 in this-procedure.
      366   end.
      367   on alt-f1 anywhere do:
      368     run proc-alt-f1 in this-procedure .
      369   end.
      370   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      371   FUNCTION propreft-Date-to-String returns character(input  p-date as date):
      372   define variable v-date-str as character no-undo .
      373   assign
      374   v-date-str = string(YEAR(p-date), "9999":U) + chr(47) +
      375                string(Month(p-date), "99":U) + chr(47) +
      376                string(DAY(p-date), "99":U).
      377   return v-date-str.
      378   END FUNCTION.
      379   function propreft-string-to-date returns date ( input p-string  as character):
      380     define variable v-date as date no-undo .
      381     assign
      382     v-date = date(integer(substring(p-string, 6, 2))
      383                   ,integer(substring(p-string, 9, 2))
      384                   ,integer(substring(p-string, 1, 4))
      385                  ) no-error .
      386     if error-status:error then return ?.
      387     return v-date.
      388   END FUNCTION.
      389   FUNCTION propreft-petrol-to-String returns character(input  p-gds-code as integer):
      390   define variable v-date-str as character no-undo .
      391   assign
      392   v-date-str = substitute("petrol-&1", p-gds-code).
      393   return v-date-str.
      394   END FUNCTION.
      395   FUNCTION propreft-string-to-petrol returns integer(input  p-string as character):
      396   define variable v-gds-code as integer no-undo .
      397   assign
      398   v-gds-code = integer(entry(2, p-string, "-")) no-error.
      399   return v-gds-code.
      400   END FUNCTION.
      401   def var vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      402   procedure gen-key-rec :
      403     define input  parameter p-tbl-name    as character no-undo.
      404     define input  parameter p-bh_tbl-name as handle    no-undo.
      405     define output parameter p-key-rec     as character no-undo.
      406     do
      407     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      408     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      409     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      410     :
      411       define variable fh               as handle    no-undo .
      412       define variable v-ok             as logical   no-undo .
      413       define variable v-inform         as character no-undo .
      414       define variable v-ind            as integer   no-undo .
      415       define variable v-idx-field-qnty as integer   no-undo .
      416       if p-tbl-name = ?
      417         or p-tbl-name = "":U
      418       then do:
      419         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info2 ).
      420       end.
      421       if not p-bh_tbl-name:available then do:
      422         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info2, p-tbl-name ).
      423       end.
      424       assign
      425         p-key-rec = p-tbl-name
      426         v-inform  = p-bh_tbl-name:index-information(1)
      427         v-ind     = 2
      428       .
      429       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      430       on error undo, return error
      431       :
      432         assign
      433           v-inform = p-bh_tbl-name:index-information( v-ind )
      434           v-ind    = v-ind + 1
      435         .
      436       end.
      437       if v-inform = ?
      438         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      439         or entry( 3, v-inform, ",":U ) <> "1":U
      440       then do:
      441         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, p-tbl-name ).
      442       end.
      443       else do:
      444         assign
      445           v-idx-field-qnty = num-entries( v-inform ) - 4
      446         .
      447         if v-idx-field-qnty < 2 then do:
      448           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, p-tbl-name ).
      449         end.
      450         do v-ind = 1 to v-idx-field-qnty by 2
      451         on error undo, return error
      452         :
      453           assign
      454             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      455             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      456           .
      457         end.
      458       end.
      459       if p-key-rec = ? then do:
      460         assign
      461           p-key-rec = "":U
      462         .
      463         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info2, p-tbl-name ).
      464       end.
      465     end.
      466     return.
      467   end procedure.
      468   procedure gen-where-keyr-tab :
      469     define input  parameter i-tableSerach as character no-undo.
      470     define input  parameter i-tablekey   as character  no-undo.
      471     define input  parameter p-key-rec    as character  no-undo.
      472     define input  parameter p-key-handle as handle     no-undo .
      473     define input  parameter p-db-name    as character  no-undo .
      474     define input  parameter p-tt-handle  as handle     no-undo .
      475     define output parameter o-Where      as character  no-undo.
      476     do
      477     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      478     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      479     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      480     :
      481       define variable v-full-tbl-name  as character no-undo .
      482       define variable bh_tbl-name      as handle    no-undo .
      483       define variable fh_key           as handle    no-undo .
      484       define variable fh_search        as handle    no-undo .
      485       define variable v-field-num      as integer   no-undo .
      486       define variable v-count-fld      as integer   no-undo .
      487       define variable v-inform         as character no-undo .
      488       define variable v-ind            as integer   no-undo .
      489       define variable v-idx-field-qnty as integer   no-undo .
      490       define variable v-field-name     as character no-undo .
      491       define variable v-field-val      as character no-undo .
      492       define variable v-word-link      as character no-undo .
      493       define variable vTable           as character no-undo.
      494       define variable bh_tbl-key       as handle    no-undo .
      495       assign
      496         p-key-rec = trim( p-key-rec )
      497       .
      498       if p-key-handle <> ? then do:
      499         if not valid-handle(p-key-handle)
      500            or p-key-handle:type <> "buffer"
      501         then do:
      502           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info2 ).
      503         end.
      504         if num-entries( p-key-rec, chr(3) ) > 1
      505           or p-key-rec = ?
      506           or p-key-rec = "":U
      507         then do:
      508           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info2, p-key-rec ).
      509         end.
      510       end.
      511       else do:
      512         if p-key-rec = ?
      513           or p-key-rec = "":U
      514         then do:
      515           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info2 ).
      516         end.
      517       end.
      518       assign
      519         vTable = entry( 1 , p-key-rec, chr(3) )
      520       .
      521       if p-tt-handle <> ?
      522         and ( not valid-handle(p-tt-handle)
      523               or p-tt-handle:type <> "buffer"
      524             )
      525       then do:
      526         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info2, vTable, chr(10) ).
      527       end.
      528       if p-tt-handle = ? then do:
      529         assign
      530           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      531         .
      532         create buffer bh_tbl-name for table v-full-tbl-name .
      533       end.
      534       else do:
      535         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      536       end.
      537       assign
      538         v-inform = bh_tbl-name:index-information(1)
      539         v-ind    = 2
      540       .
      541       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      542       on error undo, return error
      543       :
      544         assign
      545           v-inform = bh_tbl-name:index-information( v-ind )
      546           v-ind    = v-ind + 1
      547         .
      548       end.
      549       if v-inform = ?
      550         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      551         or entry( 3, v-inform, ",":U ) <> "1":U
      552       then do:
      553         delete object bh_tbl-name no-error.
      554         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info2, vTable ).
      555       end.
      556       assign
      557         v-idx-field-qnty = num-entries( v-inform ) - 4
      558       .
      559       if v-idx-field-qnty < 2 then do:
      560         delete object bh_tbl-name no-error.
      561         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, vTable ).
      562       end.
      563       assign
      564         o-where     = "where":U
      565         v-word-link = "":U
      566         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      567         v-count-fld = 0
      568       .
      569       if i-tablekey ne "" and i-tablekey ne ?
      570       then do:
      571         assign
      572           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      573         .
      574         create buffer bh_tbl-key for table v-full-tbl-name .
      575       end.
      576       if i-tableSerach ne "" and i-tableSerach ne ?
      577       then do:
      578         delete object bh_tbl-name no-error.
      579         assign
      580           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      581         .
      582         create buffer bh_tbl-name for table v-full-tbl-name .
      583       end.
      584       block_where:
      585       do v-ind = 1 to v-idx-field-qnty by 2
      586       on error undo, return error
      587       :
      588         assign
      589           v-count-fld = v-count-fld + 1
      590         .
      591         if p-key-handle = ?
      592           and v-count-fld > v-field-num
      593         then do:
      594           leave block_where.
      595         end.
      596         define variable VfieldKeyTable as handle no-undo.
      597         assign
      598           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      599           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      600         .
      601         if     bh_tbl-key ne ?
      602         then do:
      603            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      604            if VfieldKeyTable eq ?
      605            then next block_where.
      606         end.
      607         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      608         then
      609            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      610         else
      611            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      612         if p-key-handle = ? then do:
      613           assign
      614             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      615           .
      616         end.
      617         else do:
      618           assign
      619             fh_key = p-key-handle:buffer-field( v-field-name )
      620           .
      621           if fh_key = ?
      622             or not valid-handle( fh_key )
      623           then do:
      624             delete object bh_tbl-name.
      625             if     bh_tbl-key ne ?
      626             then
      627                delete object bh_tbl-key.
      628             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info2, p-key-handle:name, v-field-name ).
      629           end.
      630           assign
      631             v-field-val = fh_key:buffer-value
      632           .
      633         end.
      634         if fh_search:data-type ="character":U then do:
      635           assign
      636             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      637             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      638             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      639             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      640             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      641             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      642             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      643             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      644             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      645             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      646             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      647             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      648             v-field-val = substitute( '"&1"', v-field-val )
      649           .
      650         end.
      651         assign
      652           o-where = substitute( "&1 &2", o-where, v-field-val )
      653         .
      654         if v-word-link = "":U then do:
      655           assign
      656             v-word-link = "and":U
      657           .
      658         end.
      659       end.
      660       delete object bh_tbl-name.
      661       if     bh_tbl-key ne ?
      662       then
      663          delete object bh_tbl-key.
      664       if p-key-handle = ?
      665         and v-count-fld <> v-field-num
      666       then do:
      667         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info2, vTable ).
      668       end.
      669     end.
      670   end procedure.
      671   procedure gen-hn-keyr-tab :
      672     define input  parameter i-tableSerach as character no-undo.
      673     define input  parameter i-tablekey   as character no-undo.
      674     define input  parameter p-key-rec    as character no-undo.
      675     define input  parameter p-key-handle as handle    no-undo .
      676     define input  parameter p-db-name    as character no-undo .
      677     define input  parameter p-tt-handle  as handle    no-undo .
      678     define input  parameter p-stts-lock  as integer   no-undo .
      679     define output parameter o-hn         as handle    no-undo.
      680     define variable v-full-tbl-name as character no-undo.
      681     define variable v-where         as character no-undo.
      682     define variable bh_tbl-name     as handle    no-undo.
      683     define variable vTable          as character no-undo.
      684     do
      685     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      686     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      687     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      688         run gen-where-keyr-tab(i-tableSerach,
      689                                i-tablekey,
      690                                p-key-rec,
      691                                p-key-handle,
      692                                p-db-name,
      693                                p-tt-handle,
      694                                output v-where).
      695         if i-tableSerach ne "" and i-tableSerach ne ?
      696         then do:
      697            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      698            create buffer bh_tbl-name for table v-full-tbl-name .
      699         end.
      700         else do:
      701            if p-tt-handle = ? then do:
      702               assign
      703                  vTable = entry( 1 , p-key-rec, chr(3) )
      704               .
      705               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      706               create buffer bh_tbl-name for table v-full-tbl-name .
      707            end.
      708            else do:
      709               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      710            end.
      711         end.
      712         if p-tt-handle = ? then do:
      713            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      714         end.
      715         else do:
      716            bh_tbl-name:find-first( v-where ) no-error .
      717         end.
      718         o-hn = bh_tbl-name.
      719      end.
      720   end procedure.
      721   procedure gen-hn-keyr :
      722     define input  parameter p-key-rec    as character no-undo.
      723     define input  parameter p-key-handle as handle    no-undo .
      724     define input  parameter p-db-name    as character no-undo .
      725     define input  parameter p-tt-handle  as handle    no-undo .
      726     define input  parameter p-stts-lock  as integer   no-undo .
      727     define output parameter o-hn         as handle    no-undo.
      728     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      729   end.
      730   procedure gen-row-keyr :
      731     define input  parameter p-key-rec    as character no-undo.
      732     define input  parameter p-key-handle as handle    no-undo .
      733     define input  parameter p-db-name    as character no-undo .
      734     define input  parameter p-tt-handle  as handle    no-undo .
      735     define input  parameter p-stts-lock  as integer   no-undo .
      736     define output parameter p-tbl-row    as rowid     no-undo.
      737     define output parameter p-tbl-name   as character no-undo.
      738     define variable vHn as handle no-undo.
      739       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      740       p-tbl-row = if vHn:available then vHn:rowid else ?.
      741       p-tbl-name =  vHn:table.
      742       delete object vHn no-error.
      743     if p-tbl-row = ? then do:
      744       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info2, p-tbl-name, p-key-rec ).
      745     end.
      746     else do:
      747       return.
      748     end.
      749   end procedure.
      750   procedure gen-key-fv :
      751     define input  parameter p-key-rec    as character no-undo .
      752     define output parameter p-field-list as character no-undo .
      753     define output parameter p-value-list as character no-undo.
      754     do
      755     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      756     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      757     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      758     :
      759       define variable v-full-tbl-name  as character no-undo .
      760       define variable bh_tbl-name      as handle    no-undo .
      761       define variable v-tbl-name       as character no-undo .
      762       define variable v-field-num      as integer   no-undo .
      763       define variable v-count-fld      as integer   no-undo .
      764       define variable v-inform         as character no-undo .
      765       define variable v-ind            as integer   no-undo .
      766       define variable v-idx-field-qnty as integer   no-undo .
      767       define variable v-delim-key      as character no-undo .
      768       if p-key-rec = ?
      769         or p-key-rec = "":U
      770       then do:
      771         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info2 ).
      772       end.
      773       assign
      774         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      775         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      776       .
      777       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      778       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info2 ).
      779       assign
      780         v-inform = bh_tbl-name:index-information(1)
      781         v-ind    = 2
      782       .
      783       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      784       on error undo, return error
      785       :
      786         assign
      787           v-inform = bh_tbl-name:index-information( v-ind )
      788           v-ind    = v-ind + 1
      789         .
      790       end.
      791       if v-inform = ?
      792         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      793         or entry( 3, v-inform, ",":U ) <> "1":U
      794       then do:
      795         delete object bh_tbl-name no-error.
      796         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, v-tbl-name ).
      797       end.
      798       assign
      799         v-idx-field-qnty = num-entries( v-inform ) - 4
      800       .
      801       if v-idx-field-qnty < 2 then do:
      802         delete object bh_tbl-name no-error.
      803         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, v-tbl-name ).
      804       end.
      805       assign
      806         p-field-list = "":U
      807         p-value-list = "":U
      808         v-delim-key  = "":U
      809         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      810         v-count-fld  = 0
      811       .
      812       block_where:
      813       do v-ind = 1 to v-idx-field-qnty by 2
      814       on error undo, return error
      815       :
      816         assign
      817           v-count-fld = v-count-fld + 1
      818         .
      819         if v-count-fld > v-field-num then do:
      820           leave block_where.
      821         end.
      822         assign
      823           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      824           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      825         .
      826         if v-ind = 1 then do:
      827           assign
      828             v-delim-key = chr(3)
      829           .
      830         end.
      831       end.
      832       delete object bh_tbl-name.
      833       if v-count-fld <> v-field-num then do:
      834         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info2, v-tbl-name ).
      835       end.
      836     end.
      837   end procedure.
      838   procedure gen-key-field :
      839     define input  parameter p-table      as character no-undo .
      840     define output parameter p-field-list as character no-undo .
      841     do
      842     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      843     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      844     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      845     :
      846       define variable v-full-tbl-name  as character no-undo .
      847       define variable bh_tbl-name      as handle    no-undo .
      848       define variable v-tbl-name       as character no-undo .
      849       define variable v-field-num      as integer   no-undo .
      850       define variable v-count-fld      as integer   no-undo .
      851       define variable v-inform         as character no-undo .
      852       define variable v-ind            as integer   no-undo .
      853       define variable v-idx-field-qnty as integer   no-undo .
      854       define variable v-delim-key      as character no-undo .
      855       if p-table = ?
      856         or p-table = "":U
      857       then do:
      858         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info2 ).
      859       end.
      860       assign
      861         v-tbl-name      = p-table
      862         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      863       .
      864       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      865       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info2 ).
      866       assign
      867         v-inform = bh_tbl-name:index-information(1)
      868         v-ind    = 2
      869       .
      870       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      871       on error undo, return error
      872       :
      873         assign
      874           v-inform = bh_tbl-name:index-information( v-ind )
      875           v-ind    = v-ind + 1
      876         .
      877       end.
      878       if v-inform = ?
      879         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      880         or entry( 3, v-inform, ",":U ) <> "1":U
      881       then do:
      882         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, v-tbl-name ).
      883       end.
      884       assign
      885         v-idx-field-qnty = num-entries( v-inform ) - 4
      886       .
      887       if v-idx-field-qnty < 2 then do:
      888         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, v-tbl-name ).
      889       end.
      890       assign
      891         p-field-list = "":U
      892         v-delim-key  = "":U
      893         v-count-fld  = 0
      894       .
      895       block_where:
      896       do v-ind = 1 to v-idx-field-qnty by 2
      897       on error undo, return error
      898       :
      899         assign
      900           v-count-fld = v-count-fld + 1
      901         .
      902         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      903         if v-ind = 1 then do:
      904           assign
      905             v-delim-key = chr(3)
      906           .
      907         end.
      908       end.
      909       delete object bh_tbl-name.
      910     end.
      911   end procedure.
      912   function diff-list returns character (
      913     input parfirst-list  as character,
      914     input parsecond-list as character,
      915     input pardelim       as character).
      916     if pardelim = ""
      917     or pardelim = ?
      918     then do:
      919       assign
      920         pardelim = ","
      921       .
      922     end.
      923     def var ind as integer no-undo .
      924     def var v-elem as character no-undo .
      925     def var v-result-list as character no-undo init "".
      926     def var v-num-parfirst-list as integer no-undo .
      927     assign
      928       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      929     .
      930     do ind = 1 to v-num-parfirst-list
      931     :
      932       assign
      933         v-elem = entry(ind, parfirst-list, pardelim)
      934       .
      935       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      936         assign
      937           v-result-list = v-result-list
      938                         + (if v-result-list > "" then pardelim else "")
      939                         + v-elem
      940         .
      941       end.
      942     end.
      943     return v-result-list .
      944   end function.
      945   function add-list returns character (
      946    input parfirst-list  as character,
      947    input parsecond-list as character,
      948    input pardelim       as character).
      949     if pardelim = ""
      950     or pardelim = ?
      951     then do:
      952       assign
      953         pardelim = ","
      954       .
      955     end.
      956     def var ind as integer no-undo .
      957     def var v-elem as character no-undo .
      958     def var v-result-list as character no-undo init "".
      959     def var v-num-parfirst-list as integer no-undo .
      960     assign
      961       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      962     .
      963     do ind = 1 to v-num-parfirst-list
      964     :
      965       assign
      966         v-elem = entry(ind, parfirst-list, pardelim)
      967       .
      968       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      969         assign
      970           v-result-list = v-result-list
      971                         + (if v-result-list > "" then pardelim else "")
      972                         + v-elem
      973         .
      974       end.
      975     end.
      976     def var v-num-parsecond-list as integer no-undo .
      977     assign
      978       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      979     .
      980     do ind = 1 to v-num-parsecond-list
      981     :
      982       assign
      983         v-elem = entry(ind, parsecond-list, pardelim)
      984       .
      985       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      986         assign
      987           v-result-list = v-result-list
      988                         + (if v-result-list > "" then pardelim else "")
      989                         + v-elem
      990         .
      991       end.
      992     end.
      993     return v-result-list .
      994   end function.
      995   function cross-list returns character (
      996    input parfirst-list  as character,
      997    input parsecond-list as character,
      998    input pardelim       as character).
      999     if pardelim = ""
     1000     or pardelim = ?
     1001     then do:
     1002       assign
     1003         pardelim = ","
     1004       .
     1005     end.
     1006     def var ind as integer no-undo .
     1007     def var v-elem as character no-undo .
     1008     def var v-result-list as character no-undo init "".
     1009     def var v-num-parfirst-list as integer no-undo .
     1010     assign
     1011       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
     1012     .
     1013     do ind = 1 to v-num-parfirst-list
     1014     :
     1015       assign
     1016         v-elem = entry(ind, parfirst-list, pardelim)
     1017       .
     1018       if lookup(v-elem, v-result-list, pardelim) = 0
     1019       and lookup(v-elem, parsecond-list, pardelim) > 0
     1020       then do:
     1021         assign
     1022           v-result-list = v-result-list
     1023                         + (if v-result-list > "" then pardelim else "")
     1024                         + v-elem
     1025         .
     1026       end.
     1027     end.
     1028     return v-result-list .
     1029   end function.
     1030   function radio-label returns character (
     1031    input par-rs-value  as character,
     1032    input par-rs-radio-buttons as character)
     1033    .
     1034    DEFINE variable v-result-label as character no-undo.
     1035    assign
     1036    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
     1037                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
     1038                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
     1039                             ), par-rs-radio-buttons
     1040                           )
     1041    v-result-label = REPLACE(v-result-label, "&":U, "":U)
     1042    .
     1043   return v-result-label.
     1044   end function.
     1045   function m-radio-label returns character (
     1046    input par-rs-value  as character,
     1047    input par-rs-radio-buttons as character,
     1048    input par-delim as character
     1049    )
     1050    .
     1051    DEFINE variable v-result-label as character no-undo.
     1052    assign
     1053    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
     1054                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
     1055                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
     1056                             ), par-rs-radio-buttons, par-delim
     1057                           )
     1058    v-result-label = REPLACE(v-result-label, "&":U, "":U)
     1059    .
     1060   return v-result-label.
     1061   end function.
     1062   FUNCTION mixlist returns character
     1063   (
     1064    input parfirst-list  as character
     1065    ,input parsecond-list as character
     1066    ,input pardelim       as character
     1067    ,input pardelim-result as character ) :
     1068     if pardelim = ""
     1069     or pardelim = ?
     1070     then do:
     1071       assign
     1072         pardelim = ","
     1073       .
     1074     end.
     1075     def var ind as integer no-undo .
     1076     def var v-elem1 as character no-undo .
     1077     def var v-elem2 as character no-undo .
     1078     def var v-result-list as character no-undo init "".
     1079     do ind = 1 to num-entries(parfirst-list, pardelim)
     1080     :
     1081       assign
     1082         v-elem1 = entry(ind, parfirst-list, pardelim)
     1083         v-elem2 = entry(ind, parsecond-list, pardelim)
     1084       .
     1085         assign
     1086           v-result-list = v-result-list
     1087                         + (if v-result-list > "" then pardelim-result else "")
     1088                         + v-elem1 + pardelim-result + v-elem2
     1089         .
     1090     end.
     1091     return v-result-list .
     1092   END FUNCTION.
     1093   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1094   procedure cur-time :
     1095      define output parameter p-today as date      no-undo .
     1096      define output parameter p-time  as integer   no-undo .
     1097     do
     1098     on error undo, return error
     1099     :
     1100       define variable v-date1 as date      no-undo .
     1101       define variable v-date2 as date      no-undo .
     1102       define variable v-time  as integer   no-undo .
     1103       assign
     1104         v-date1 = today
     1105         v-time  = time
     1106         v-date2 = today
     1107       .
     1108       if v-date1 <> v-date2
     1109       then do:
     1110         assign
     1111           v-date1 = today
     1112           v-time  = v-time
     1113         .
     1114       end.
     1115       assign
     1116         p-today = v-date1
     1117         p-time  = v-time
     1118       .
     1119     end.
     1120   end.
     1121   function cur-time-date returns character
     1122   :
     1123     return string(today, '99/99/9999':U) .
     1124   end.
     1125   function cur-time-mjd returns decimal
     1126   :
     1127     define variable v-date as date      no-undo .
     1128     define variable v-time as integer   no-undo .
     1129     run cur-time in this-procedure
     1130       (output v-date
     1131       ,output v-time
     1132       ) .
     1133     return integer(v-date) - 2400002 + (v-time / 86400) .
     1134   end.
     1135   function cur-time-get-ending-index returns integer
     1136   (input p-number as integer
     1137   )
     1138   :
     1139     if p-number < 0
     1140     or p-number = ?
     1141     then do:
     1142       return 1 .
     1143     end.
     1144     define variable v-rest as integer   no-undo .
     1145     assign
     1146       p-number = p-number modulo 100
     1147     .
     1148     if p-number < 20
     1149     then do:
     1150       assign
     1151         v-rest = p-number
     1152       .
     1153     end.
     1154     else do:
     1155       assign
     1156         v-rest = p-number modulo 10
     1157       .
     1158     end.
     1159     case v-rest :
     1160       when 1
     1161       then do:
     1162         return 2 .
     1163       end.
     1164       when 2 or
     1165       when 3 or
     1166       when 4
     1167       then do:
     1168         return 3 .
     1169       end.
     1170       otherwise do:
     1171         return 1 .
     1172       end.
     1173     end case .
     1174   end.
     1175   procedure cur-time-mjd-to-date :
     1176      define input  parameter i-mjd-diff as decimal no-undo.
     1177      define output parameter o-Date     as date    no-undo.
     1178      define output parameter o-Time     as integer no-undo.
     1179      define variable v-day-number as integer   no-undo .
     1180      if    i-mjd-diff < 0
     1181         or i-mjd-diff = ?
     1182      then do:
     1183         return "?" .
     1184      end.
     1185      assign
     1186         v-day-number = truncate(i-mjd-diff,0).
     1187         o-Date = date(v-day-number + 2400002).
     1188         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1189     .
     1190   end.
     1191   function cur-time-mjd-to-string returns character
     1192   (input p-mjd-diff as decimal
     1193   )
     1194   :
     1195     define variable v-day-number as integer   no-undo .
     1196     define variable v-seconds    as integer   no-undo .
     1197     define variable v-hour       as integer   no-undo .
     1198     define variable v-min        as integer   no-undo .
     1199     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1200     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1201     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1202     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1203     if p-mjd-diff < 0
     1204     or p-mjd-diff = ?
     1205     then do:
     1206       return "?" .
     1207     end.
     1208     assign
     1209       v-day-number = integer(truncate(p-mjd-diff,0))
     1210       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1211     .
     1212     if v-seconds > 86400
     1213     then do:
     1214       assign
     1215         v-seconds = 86400 - 1
     1216       .
     1217     end.
     1218     if v-seconds < 0
     1219     then do:
     1220       assign
     1221         v-seconds = 0
     1222       .
     1223     end.
     1224     assign
     1225       v-hour = truncate(v-seconds / 3600, 0)
     1226     .
     1227     assign
     1228       v-seconds = v-seconds modulo 3600
     1229     .
     1230     assign
     1231       v-min = truncate(v-seconds / 60, 0)
     1232     .
     1233     assign
     1234       v-seconds = v-seconds modulo 60
     1235     .
     1236     return
     1237         (if v-day-number <> 0
     1238           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1239           else ""
     1240         )
     1241       + (if v-day-number <> 0 or v-hour <> 0
     1242           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1243           else ""
     1244         )
     1245       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1246           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1247           else ""
     1248         )
     1249       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1250       .
     1251   end.
     1252   function cur-time-string returns character
     1253   :
     1254     define variable v-date as date      no-undo .
     1255     define variable v-time as integer   no-undo .
     1256     run cur-time in this-procedure
     1257       (output v-date
     1258       ,output v-time
     1259       ) .
     1260     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1261   end.
     1262   function cur-time-string-sec returns character
     1263   :
     1264     define variable v-date as date      no-undo .
     1265     define variable v-time as integer   no-undo .
     1266     run cur-time in this-procedure
     1267       (output v-date
     1268       ,output v-time
     1269       ) .
     1270     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1271   end.
     1272   function cur-time-custom  returns character
     1273   (input p-prefix as character
     1274   ,input p-date-format as character
     1275   ,input p-delimiter as character
     1276   ,input p-time-format as character
     1277   ,input p-suffix as character
     1278   )
     1279   :
     1280     define variable v-date as date      no-undo .
     1281     define variable v-time as integer   no-undo .
     1282     run cur-time in this-procedure
     1283       (output v-date
     1284       ,output v-time
     1285       ) .
     1286     return
     1287       p-prefix
     1288       + string(v-date, p-date-format)
     1289       + p-delimiter
     1290       + string(v-time, p-time-format)
     1291       + p-suffix
     1292       .
     1293   end.
     1294   function cur-time-print  returns character
     1295   :
     1296     define variable v-date as date      no-undo .
     1297     define variable v-time as integer   no-undo .
     1298     run cur-time in this-procedure
     1299       (output v-date
     1300       ,output v-time
     1301       ) .
     1302     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1303   end.
     1304   function cur-time-datetime returns datetime
     1305   :
     1306     define variable v-char as character no-undo .
     1307     define variable v-datetime as datetime no-undo .
     1308     v-char = cur-time-string().
     1309     v-datetime = datetime(v-char).
     1310     return  v-datetime.
     1311   end.
     1312   function cur-time-string-msec returns character
     1313   :
     1314     define variable v-date as datetime  no-undo .
     1315     v-date = now.
     1316     return string(v-date) .
     1317   end.
     1318   define variable is-elved as logical no-undo init yes.
     1319   define variable is-ef as logical no-undo init yes.
     1320   DEFINE BUFFER FIRST_prop-ref FOR dictdb.prop-ref.
     1321   DEFINE BUFFER buf_prop-ref FOR dictdb.prop-ref.
     1322   define buffer buf_prop-head for ub.prop-head.
     1323   DEFINE BUTTON b-esys
     1324        IMAGE-UP FILE "btn-down-arrow":U
     1325        IMAGE-DOWN FILE "btn-down-arrow":U
     1326        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1327        LABEL ""
     1328        SIZE 3 BY 1.
     1329   DEFINE BUTTON B-exit AUTO-GO
     1330        LABEL "&Ввод"
     1331        SIZE 10 BY 1
     1332        BGCOLOR 8 .
     1333   DEFINE BUTTON B-Help
     1334        LABEL "Помо&щь"
     1335        SIZE 3 BY 1
     1336        BGCOLOR 8 .
     1337   DEFINE BUTTON b-main-part
     1338        IMAGE-UP FILE "btn-down-arrow":U
     1339        IMAGE-DOWN FILE "btn-down-arrow":U
     1340        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1341        LABEL ""
     1342        SIZE 3 BY 1.
     1343   DEFINE BUTTON b-prop-head
     1344        IMAGE-UP FILE "btn-down-arrow":U
     1345        IMAGE-DOWN FILE "btn-down-arrow":U
     1346        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1347        LABEL ""
     1348        SIZE 3 BY 1.
     1349   DEFINE BUTTON b-quit AUTO-END-KEY
     1350        LABEL "&Отмена"
     1351        SIZE 10 BY 1
     1352        BGCOLOR 8 .
     1353   DEFINE VARIABLE f-date-from AS DATE FORMAT "99/99/9999":U
     1354        LABEL "C"
     1355        VIEW-AS FILL-IN
     1356        SIZE 14 BY 1 NO-UNDO.
     1357   DEFINE VARIABLE f-date-to AS DATE FORMAT "99/99/9999":U
     1358        LABEL "По"
     1359        VIEW-AS FILL-IN
     1360        SIZE 14 BY 1 NO-UNDO.
     1361   DEFINE VARIABLE f-esys-id AS CHARACTER FORMAT "X(256)":U
     1362        LABEL "Код внешней системы"
     1363        VIEW-AS FILL-IN
     1364        SIZE 9 BY 1.07 NO-UNDO.
     1365   DEFINE VARIABLE f-prefix AS CHARACTER FORMAT "X(256)":U
     1366        VIEW-AS FILL-IN NATIVE
     1367        SIZE 15.5 BY 1
     1368        FGCOLOR 4  NO-UNDO.
     1369   DEFINE VARIABLE f-prop-name AS CHARACTER FORMAT "X(256)":U
     1370        VIEW-AS FILL-IN NATIVE
     1371        SIZE 97.5 BY 1
     1372        FGCOLOR 4  NO-UNDO.
     1373   DEFINE VARIABLE f-sum-id-main-part AS CHARACTER FORMAT "X(256)":U
     1374        VIEW-AS FILL-IN NATIVE
     1375        SIZE 19 BY 1 NO-UNDO.
     1376   DEFINE QUERY Dialog-Frame FOR
     1377         tt-prop-ref SCROLLING.
     1378   DEFINE FRAME Dialog-Frame
     1379        B-exit AT ROW 1 COL 1
     1380        b-quit AT ROW 1 COL 11
     1381        B-Help AT ROW 1 COL 95
     1382        tt-prop-ref.dt-code AT ROW 3.27 COL 50.5 COLON-ALIGNED WIDGET-ID 2
     1383             LABEL "Код"
     1384             VIEW-AS FILL-IN
     1385             SIZE 14 BY 1
     1386        tt-prop-ref.ref-type AT ROW 3.67 COL 1 NO-LABEL WIDGET-ID 12
     1387             VIEW-AS RADIO-SET VERTICAL
     1388             RADIO-BUTTONS
     1389                       "item1", "item1":U
     1390             SIZE 22.5 BY 7.9
     1391        tt-prop-ref.sum-id AT ROW 4.57 COL 50.5 COLON-ALIGNED WIDGET-ID 4
     1392             LABEL "Мнемонический идентификатор" FORMAT "X(255)"
     1393             VIEW-AS FILL-IN
     1394             SIZE 40 BY 1
     1395        f-date-from AT ROW 6 COL 50.5 COLON-ALIGNED WIDGET-ID 18
     1396        f-date-to AT ROW 6 COL 69 COLON-ALIGNED WIDGET-ID 20
     1397        f-prefix AT ROW 7.27 COL 50.5 COLON-ALIGNED NO-LABEL WIDGET-ID 22
     1398        f-sum-id-main-part AT ROW 7.27 COL 66.5 COLON-ALIGNED NO-LABEL WIDGET-ID 24
     1399        b-main-part AT ROW 7.27 COL 88 WIDGET-ID 26
     1400        f-esys-id AT ROW 8.47 COL 50.5 COLON-ALIGNED WIDGET-ID 28
     1401        b-esys AT ROW 8.47 COL 62.5 WIDGET-ID 30
     1402        tt-prop-ref.dtm-code AT ROW 10.6 COL 50.5 COLON-ALIGNED WIDGET-ID 6
     1403             LABEL "Код объекта-операнда"
     1404             VIEW-AS FILL-IN
     1405             SIZE 15.5 BY 1
     1406        b-prop-head AT ROW 10.6 COL 69 WIDGET-ID 8
     1407        f-prop-name AT ROW 12.2 COL 1.5 NO-LABEL WIDGET-ID 16
     1408        tt-prop-ref.Caller_id AT ROW 13.7 COL 16.5 COLON-ALIGNED WIDGET-ID 10
     1409             LABEL "доп.идент-тор"
     1410             VIEW-AS FILL-IN NATIVE
     1411             SIZE 63 BY 1
     1412        "Тип итогов (среза)" VIEW-AS TEXT
     1413             SIZE 26 BY 1 AT ROW 2.5 COL 1.5 WIDGET-ID 14
     1414        SPACE(71.50) SKIP(11.82)
     1415       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1416            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1417            TITLE "Срез данных по ДК"
     1418            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
     1419   ASSIGN
     1420          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1421          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1422   ASSIGN
     1423          f-date-from:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1424   ASSIGN
     1425          f-date-to:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1426   ASSIGN
     1427          f-prefix:HIDDEN IN FRAME Dialog-Frame           = TRUE
     1428          f-prefix:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     1429   ASSIGN
     1430          f-prop-name:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     1431   ASSIGN
     1432          f-sum-id-main-part:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1433   ASSIGN
     1434          tt-prop-ref.ref-type:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1435   ON GO OF FRAME Dialog-Frame
     1436   DO:
     1437       RUN proc-save IN THIS-PROCEDURE NO-ERROR.
     1438     IF ERROR-STATUS:ERROR THEN DO:
     1439         RETURN NO-APPLY.
     1440     END.
     1441   END.
     1442   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1443   DO:
     1444     APPLY "END-ERROR":U TO SELF.
     1445   END.
     1446   ON CHOOSE OF b-esys IN FRAME Dialog-Frame
     1447   DO:
     1448     IF tt-prop-ref.dtm-code =?
     1449     OR tt-prop-ref.dtm-code = 0 THEN DO:
     1450        MESSAGE
     1451        "Не выбран Объект-операнд"
     1452         VIEW-AS ALERT-BOX ERROR.
     1453        RETURN NO-APPLY.
     1454     END.
     1455     RUN proc-esys-id IN THIS-PROCEDURE ( INPUT tt-prop-ref.ref-type) NO-ERROR.
     1456     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1457   END.
     1458   ON CHOOSE OF b-main-part IN FRAME Dialog-Frame
     1459   DO:
     1460     IF tt-prop-ref.dtm-code =?
     1461     OR tt-prop-ref.dtm-code = 0 THEN DO:
     1462        MESSAGE
     1463        "Не выбран Объект-операнд"
     1464         VIEW-AS ALERT-BOX ERROR.
     1465        RETURN NO-APPLY.
     1466     END.
     1467     RUN proc-main-part IN THIS-PROCEDURE ( INPUT tt-prop-ref.ref-type) NO-ERROR.
     1468     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1469   END.
     1470   ON CHOOSE OF b-prop-head IN FRAME Dialog-Frame
     1471   DO:
     1472   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     1473   DEFINE BUFFER buf_prop-head FOR ub.prop-head.
     1474   FIND FIRST buf_prop-head NO-LOCK WHERE
     1475             buf_prop-head.dtm-code = tt-prop-ref.dtm-code NO-ERROR.
     1476   IF AVAILABLE buf_prop-head THEN DO:
     1477      v-rid-list = string(RECID(buf_prop-head)).
     1478   END.
     1479     run rul/prop-head-s.w ( INPUT parparentproc
     1480                            ,INPUT "b-sel"
     1481                            ,INPUT "general-view"
     1482                            ,input 'dc-storage':U
     1483                            ,INPUT-OUTPUT v-rid-list ) NO-ERROR.
     1484     IF v-rid-list <> '':U THEN DO:
     1485        FIND FIRST buf_prop-head NO-LOCK WHERE
     1486                  recid(buf_prop-head) = INTEGER(v-rid-list).
     1487        IF buf_prop-head.ref-type = '':U  THEN DO:
     1488           MESSAGE
     1489           "Для данного объекта операнда не предусмотрено создание срезов данных"
     1490           VIEW-AS ALERT-BOX ERROR.
     1491           UNDO, RETURN NO-APPLY.
     1492        END.
     1493        ASSIGN
     1494        tt-prop-ref.dtm-code = buf_prop-head.dtm-code
     1495        f-prop-name = buf_prop-head.prop-label
     1496        tt-prop-ref.ref-type = buf_prop-head.ref-type
     1497        .
     1498        DISPLAY
     1499        tt-prop-ref.dtm-code
     1500        f-prop-name
     1501        tt-prop-ref.ref-type
     1502        WITH FRAME Dialog-Frame.
     1503        RUN display-ref-type IN THIS-PROCEDURE ( INPUT tt-prop-ref.ref-type, INPUT buf_prop-head.prop-name).
     1504     END.
     1505   END.
     1506   ON VALUE-CHANGED OF tt-prop-ref.ref-type IN FRAME Dialog-Frame
     1507   DO:
     1508     ASSIGN
     1509     tt-prop-ref.ref-type.
     1510     if p-mode <> 'ПРОСМОТР':U then do:
     1511       RUN change-ref-type IN THIS-PROCEDURE ( INPUT tt-prop-ref.ref-type) NO-ERROR.
     1512       IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1513     end.
     1514   END.
     1515   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1516   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1517   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1518   on help of frame Dialog-Frame
     1519   do:
     1520     run gbl/app_help.p
     1521       (input this-procedure :file-name
     1522       ,input ''
     1523       ,input ?
     1524       ) no-error.
     1525     if error-status :error then do:
     1526       message
     1527         "Ошибка при вызове помощи"
     1528         error-status :get-message(1)
     1529         view-as alert-box .
     1530     end.
     1531   end.
     1532   run minbtn-set in this-procedure .
     1533   on choose of b-help in frame Dialog-Frame
     1534   do:
     1535     apply "help":u to frame Dialog-Frame .
     1536   end.
     1537   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1538   procedure minbtn-set :
     1539       do
     1540           on error undo, return error return-value
     1541           :
     1542           define variable ii              as integer       no-undo .
     1543           define variable fh              as widget-handle no-undo .
     1544           define variable hh              as widget-handle no-undo .
     1545           define variable v-h             as handle        extent 4 no-undo .
     1546           define variable v-name-button   as character     no-undo .
     1547           define variable v-help-old-x    as decimal       no-undo .
     1548           define variable v-help-old-y    as decimal       no-undo .
     1549           define variable v-help-old-size as decimal       no-undo .
     1550           define variable v-frame-width   as decimal       no-undo .
     1551           define variable jj              as integer       no-undo .
     1552           do
     1553               on error undo, return error
     1554               :
     1555               assign
     1556                   v-frame-width = frame Dialog-Frame:width - 0.3
     1557                   fh            = frame Dialog-Frame:first-child
     1558                   hh            = fh:first-child
     1559                   ii            = 1
     1560                   .
     1561               do while valid-handle(hh):
     1562                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1563                   do:
     1564                       case lc(hh:name) :
     1565                           when "b-help" then
     1566                               do:
     1567                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1568                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1569                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1570                                   hh:TOOLTIP = "Помощь" .
     1571                                   v-help-old-x = hh:column .
     1572                                   v-help-old-y = hh:row    .
     1573                                   v-help-old-size = hh:width .
     1574                                   hh:width-chars = 2.5 .
     1575                               end.
     1576                           when "b-print" then
     1577                               do:
     1578                                   hh:load-image("cmp/b-print.bmp":u) .
     1579                                   hh:TOOLTIP = "Печать" .
     1580                                   v-h[ii] = hh:handle .
     1581                                   ii = ii + 1 .
     1582                                   hh:width-chars = 3 .
     1583                               end.
     1584                           when "b-history" or
     1585                           when "b-hist" then
     1586                               do:
     1587                                   hh:load-image("cmp/b-hist.bmp":u) .
     1588                                   hh:TOOLTIP = "История" .
     1589                                   v-h[ii] = hh:handle .
     1590                                   ii = ii + 1 .
     1591                                   hh:width-chars = 3 .
     1592                               end.
     1593                           when "b-sch" then
     1594                               do:
     1595                                   hh:load-image("cmp/b-sch.bmp":u) .
     1596                                   hh:TOOLTIP = "Установка Фильтра" .
     1597                                   v-h[ii] = hh:handle .
     1598                                   ii = ii + 1 .
     1599                                   hh:width-chars = 3 .
     1600                               end.
     1601                           when "b-hist-user" then
     1602                               do:
     1603                                   hh:load-image("cmp/b-hist.bmp":u) .
     1604                                   hh:TOOLTIP = "История пользователя" .
     1605                                   ii = ii + 1 .
     1606                               end.
     1607                       end case.
     1608                   end.
     1609                   hh = hh:next-sibling.
     1610               end.
     1611               b-help:column = v-frame-width - b-help:width-chars.
     1612               jj = 0.
     1613               repeat ii = 4 to 1 by -1 :
     1614                   if valid-handle (v-h[ii] ) then
     1615                   do:
     1616                       jj  = jj + 1 .
     1617                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1618                       v-h[ii]:row    = v-help-old-y .
     1619                   end.
     1620               end.
     1621           end.
     1622       end.
     1623   end procedure.
     1624   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1625   on ' ' of f-date-from in frame Dialog-Frame
     1626   do:
     1627     if (can-query (self, "sensitive")
     1628        and
     1629        self :sensitive = true
     1630        )
     1631     or (can-query (self, "read-only")
     1632        and
     1633        self :read-only = false
     1634        )
     1635     then do:
     1636       assign
     1637         self :screen-value = ?
     1638       .
     1639     end.
     1640     return no-apply.
     1641   end.
     1642   on delete-character of f-date-from in frame Dialog-Frame
     1643   do:
     1644     if (can-query (self, "sensitive")
     1645        and
     1646        self :sensitive = true
     1647        )
     1648     or (can-query (self, "read-only")
     1649        and
     1650        self :read-only = false
     1651        )
     1652     then do:
     1653       assign
     1654         self :screen-value = ?
     1655       .
     1656     end.
     1657     return no-apply.
     1658   end.
     1659   on ctrl-d of f-date-from in frame Dialog-Frame
     1660   do:
     1661     define variable v-curr-sv-date as date no-undo .
     1662     if (can-query (self, "sensitive")
     1663        and
     1664        self :sensitive = true
     1665        )
     1666     or (can-query (self, "read-only")
     1667        and
     1668        self :read-only = false
     1669        )
     1670     then do:
     1671       if self :handle <> focus :handle
     1672       then do:
     1673         apply "entry":u to self .
     1674       end.
     1675       run gbl/getcurdt.p
     1676         (output v-curr-sv-date
     1677         ) .
     1678       assign
     1679         self :screen-value = string(v-curr-sv-date) .
     1680       .
     1681     end.
     1682     return no-apply.
     1683   end.
     1684   on ctrl-b of f-date-from in frame Dialog-Frame
     1685   do:
     1686     if (can-query (self, "sensitive")
     1687        and
     1688        self :sensitive = true
     1689        )
     1690     or (can-query (self, "read-only")
     1691        and
     1692        self :read-only = false
     1693        )
     1694     then do:
     1695       if self :handle <> focus :handle
     1696       then do:
     1697         apply "entry":u to self .
     1698       end.
     1699       define variable v-curr-sv-date as date no-undo .
     1700       define variable v-new-sv-date  as date no-undo .
     1701       assign
     1702         v-curr-sv-date = date(self :screen-value) no-error
     1703       .
     1704       if v-curr-sv-date = ?
     1705       then do:
     1706         run gbl/getcurdt.p
     1707           (output v-curr-sv-date
     1708           ) .
     1709       end.
     1710       if v-curr-sv-date <> ?
     1711       then do:
     1712         assign
     1713           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     1714         .
     1715         assign
     1716           self :screen-value = string(v-new-sv-date) .
     1717         .
     1718       end.
     1719     end.
     1720     return no-apply .
     1721   end.
     1722   on ctrl-e of f-date-from in frame Dialog-Frame
     1723   do:
     1724     if (can-query (self, "sensitive")
     1725        and
     1726        self :sensitive = true
     1727        )
     1728     or (can-query (self, "read-only")
     1729        and
     1730        self :read-only = false
     1731        )
     1732     then do:
     1733       if self :handle <> focus :handle
     1734       then do:
     1735         apply "entry":u to self .
     1736       end.
     1737       define variable v-curr-sv-date as date no-undo .
     1738       define variable v-new-sv-date  as date no-undo .
     1739       assign
     1740         v-curr-sv-date = date(self :screen-value) no-error
     1741       .
     1742       if v-curr-sv-date = ?
     1743       then do:
     1744         run gbl/getcurdt.p
     1745           (output v-curr-sv-date
     1746           ) .
     1747       end.
     1748       if v-curr-sv-date <> ?
     1749       then do:
     1750         run gbl/lastdate.p
     1751           (input  v-curr-sv-date
     1752           ,output v-new-sv-date
     1753           ).
     1754         assign
     1755           self :screen-value = string(v-new-sv-date) .
     1756         .
     1757       end.
     1758     end.
     1759     return no-apply .
     1760   end.
     1761   on ctrl-f of f-date-from in frame Dialog-Frame
     1762   do:
     1763     if (can-query (self, "sensitive")
     1764        and
     1765        self :sensitive = true
     1766        )
     1767     or (can-query (self, "read-only")
     1768        and
     1769        self :read-only = false
     1770        )
     1771     then do:
     1772       if self :handle <> focus :handle
     1773       then do:
     1774         apply "entry":u to self .
     1775       end.
     1776       define variable v-ok            as logical   no-undo .
     1777       define variable v-curr-sv-date  as date      no-undo .
     1778       define variable v-description   as character no-undo .
     1779       assign
     1780         v-curr-sv-date = date(self :screen-value) no-error
     1781       .
     1782       if v-curr-sv-date = ?
     1783       then do:
     1784         run gbl/getcurdt.p
     1785           (output v-curr-sv-date
     1786           ) .
     1787       end.
     1788       if v-curr-sv-date <> ?
     1789       then do:
     1790         run gbl/d-inpday.w
     1791           (input ?
     1792           ,input "Выбор даты"
     1793           ,input v-description
     1794           ,input ""
     1795           ,input-output v-curr-sv-date
     1796           ,output v-ok
     1797           ).
     1798         if v-ok = true
     1799         then do:
     1800           assign
     1801             self :screen-value = string(v-curr-sv-date) .
     1802           .
     1803         end.
     1804       end.
     1805     end.
     1806     return no-apply .
     1807   end.
     1808     define MENU m-ed-date7
     1809       MENU-ITEM m-ed-date7-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
     1810       MENU-ITEM m-ed-date7-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
     1811       MENU-ITEM m-ed-date7-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
     1812       MENU-ITEM m-ed-date7-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
     1813       .
     1814     if f-date-from :POPUP-MENU in frame Dialog-Frame = ?
     1815     then do:
     1816       ASSIGN
     1817         f-date-from :POPUP-MENU in frame Dialog-Frame = MENU m-ed-date7 :HANDLE
     1818         f-date-from :MENU-MOUSE in frame Dialog-Frame = 3
     1819       .
     1820     end.
     1821     define variable v-label-handle7 as handle no-undo .
     1822     assign
     1823       v-label-handle7 = f-date-from :side-label-handle in frame Dialog-Frame
     1824     .
     1825     if valid-handle (v-label-handle7)
     1826     then do:
     1827       if v-label-handle7 :tooltip = ""
     1828       or v-label-handle7 :tooltip = ?
     1829       then do:
     1830         assign
     1831           v-label-handle7 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
     1832         .
     1833       end.
     1834     end.
     1835     ON CHOOSE OF MENU-ITEM m-ed-date7-1 in menu m-ed-date7 DO:
     1836       apply "ctrl-b":U to f-date-from in frame Dialog-Frame .
     1837     END.
     1838     ON CHOOSE OF MENU-ITEM m-ed-date7-2 in menu m-ed-date7 DO:
     1839       apply "ctrl-d":U to f-date-from in frame Dialog-Frame .
     1840     END.
     1841     ON CHOOSE OF MENU-ITEM m-ed-date7-3 in menu m-ed-date7 DO:
     1842       apply "ctrl-e":U to f-date-from in frame Dialog-Frame .
     1843     END.
     1844     ON CHOOSE OF MENU-ITEM m-ed-date7-4 in menu m-ed-date7 DO:
     1845       apply "ctrl-f":U to f-date-from in frame Dialog-Frame .
     1846     END.
