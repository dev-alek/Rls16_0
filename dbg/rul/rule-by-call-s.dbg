     1552               where buf_temp-browse-handle.browse-type   = 'height':u
     1553                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1554               no-error .
     1555             if available buf_temp-browse-handle
     1556             then do:
     1557             end.
