     1420     move_block:
     1421     do
     1422     on error undo move_block, retry move_block
     1423     :
     1424       if retry
     1425       then do:
     1426         do
     1427         on error undo move_block, leave move_block
     1428         :
     1429           if p-change-value > 0
     1430           then do:
     1431             for each buf_temp-diasize-handle
     1432             on error undo, next
     1433             :
     1434               assign
     1435                 v-object-handle = buf_temp-diasize-handle.handle-value
     1436               .
