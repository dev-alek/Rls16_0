     1994         or error-status :get-message(1) <> ""
     1995         then do:
     1996           undo move_block, retry move_block.
     1997         end.
     1998         for each buf_temp-browse-handle
     1999           where buf_temp-browse-handle.browse-type = 'width':u
     2000         on error undo move_block, retry move_block
     2001         :
     2002           assign
     2003             buf_temp-browse-handle.browse-handle :width
     2004               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2005             no-error .
