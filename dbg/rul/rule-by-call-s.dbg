        1   DEFINE BUFFER X_rule FOR ub.rule.
        2   DEFINE BUFFER X_rule-by-call FOR ub.rule-by-call.
        3   DEFINE BUFFER X_ruleset FOR ub.ruleset.
        4   define input parameter parparentproc as widget-handle no-undo .
        5   define input parameter bttns as character no-undo.
        6   DEFINE INPUT PARAMETER p-list-mode AS CHARACTER NO-UNDO.
        7   DEFINE INPUT PARAMETER p-call-id AS character NO-UNDO.
        8   DEFINE INPUT PARAMETER p-codex-id AS INTEGER NO-UNDO.
        9   DEFINE INPUT PARAMETER p-ruleset-id AS INTEGER NO-UNDO.
       10   DEFINE INPUT PARAMETER p-rule-id AS INTEGER NO-UNDO.
       11   define input-output parameter p-rid-list as character no-undo.
       12   define variable vss-revision    as character no-undo init "$Revision$":U .
       13   define variable vss-author      as character no-undo init "$Author$":U .
       14   define variable vss-date        as character no-undo init "$Date$":U .
       15   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       16   define variable vss-archive     as character no-undo init "$Archive$":U .
       17   define variable vss-description as character no-undo init "Список rule-by-call".
       18   procedure vss-get-info :
       19     define output parameter p-vss-revision    like vss-revision    no-undo .
       20     define output parameter p-vss-author      like vss-author      no-undo .
       21     define output parameter p-vss-date        like vss-date        no-undo .
       22     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       23     define output parameter p-vss-archive     like vss-archive     no-undo .
       24     define output parameter p-vss-description like vss-description no-undo .
       25     assign
       26       p-vss-revision    = vss-revision
       27       p-vss-author      = vss-author
       28       p-vss-date        = vss-date
       29       p-vss-workfile    = vss-workfile
       30       p-vss-archive     = vss-archive
       31       p-vss-description = vss-description
       32     .
       33   end procedure.
       34   procedure vss-get-parameters :
       35     define output parameter p-vss-parameters as character no-undo .
       36   end procedure.
       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       73   define variable v-waitfram-action01         as character   no-undo .
       74   define variable v-waitfram-action02         as character   no-undo .
       75   define variable v-waitfram-action03         as character   no-undo .
       76   define variable mWaitFramTextBeg            as character   no-undo.
       77   define variable mWaitFramTextEnd            as character   no-undo.
       78   define variable mWaitFramView               as logical     no-undo.
       79   define variable mWaitProcEvent              as logical     no-undo init yes.
       80   define variable mWaitFramInterval           as integer     no-undo init 1 .
       81   define variable mWaitFramStop               as logical     no-undo.
       82   define variable mWaitFramStopUser           as logical     no-undo.
       83   define variable mWaitFramStopTimeOut        as logical     no-undo.
       84   define variable mWaitFramStartProc          as datetime-tz no-undo.
       85   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       86   define button B-WaitFramStop auto-end-key
       87        label "Стоп"
       88        size 10 by 1 tooltip "Остоновить процесс".
       89   define button B-viewProcInfo
       90        label "Информация"
       91        size 15 by 1 tooltip "Информация о процесс".
       92   define frame waitfram
       93     v-waitfram-action01 format "x(72)" no-label skip
       94     v-waitfram-action02 format "x(72)" no-label skip
       95     v-waitfram-action03 format "x(72)" no-label skip
       96     B-viewProcInfo
       97     B-WaitFramStop at row 4 col 30
       98     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       99     .
      100   define new global shared variable mBatchMode as logical no-undo init ?.
      101   define variable mFramBachModHandle as handle no-undo.
      102   mFramBachModHandle = frame waitfram:handle.
      103   define variable mFameOldVis as logical no-undo.
      104   define variable mVisCUrentVin as logical no-undo.
      105   if session:batch-mode
      106   then
      107      mBatchMode = yes.
      108   if mBatchMode = ? then do:
      109     mVisCUrentVin = current-window:visible.
      110     mFameOldVis = mFramBachModHandle:visible.
      111     mFramBachModHandle:visible  = yes.
      112     mBatchMode = mFramBachModHandle:visible ne yes.
      113     mFramBachModHandle:visible = mFameOldVis.
      114     current-window:visible = mVisCUrentVin.
      115   end.
      116    if  log-manager:logfile-name ne ?
      117     then DO:
      118         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      119         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      120         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      121     end.
      122   on choose of B-WaitFramStop in frame waitfram
      123   do:
      124     mWaitFramStop = yes.
      125     mWaitFramStopUser = yes.
      126   end.
      127   function waitfram-check-timeout returns logical():
      128      define variable vtime as int64 no-undo.
      129      if mWaitFramStopTimeOut
      130      then
      131         return yes.
      132      vtime = ( now - mWaitFramStartProc ) / 1000 .
      133      if     mWaitFramTimeOut ne ?
      134         and mWaitFramTimeOut ne 0
      135         and mWaitFramTimeOut lt vtime
      136      then do:
      137         mWaitFramStopTimeOut = yes.
      138      end.
      139      return mWaitFramStopTimeOut.
      140   end.
      141   procedure waitfram-hide :
      142     if not session:batch-mode
      143     then do
      144     on error undo, return error return-value
      145     :
      146       pause 0 before-hide .
      147       if not mBatchMode then
      148         hide frame waitfram .
      149     if     not mWaitFramView
      150        and mWaitProcEvent
      151     then
      152       process events .
      153     end.
      154   end procedure.
      155   procedure waitfram-show :
      156     define input  parameter p-message as character no-undo .
      157     define variable v-left-margin as integer   no-undo .
      158     if not session:batch-mode
      159     then do
      160     on error undo, return error return-value
      161     :
      162       if length(p-message) <= 70 then do:
      163         assign
      164           v-left-margin = integer((70 - length(p-message)) / 2)
      165         .
      166         assign
      167           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      168         .
      169         assign
      170           v-waitfram-action01 = " "
      171           v-waitfram-action02 = " "
      172                                    + fill(" ", v-left-margin)
      173                                    + p-message
      174           v-waitfram-action03 = " "
      175         .
      176       end.
      177       else do:
      178         define variable vRindex1 as integer no-undo.
      179         define variable vRindex2 as integer no-undo.
      180         vRindex1 = r-index(p-message," ",70).
      181         if vRindex1 = 0
      182         then
      183            vRindex1 = 70.
      184         if length(p-message)  <= vRindex1 + 70 then do:
      185           assign
      186             v-waitfram-action01 = " "
      187             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      188             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      189           .
      190         end.
      191         else do:
      192           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      193           if vRindex2 <= vRindex1
      194           then
      195              vRindex2 = vRindex1 + 70.
      196           assign
      197             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      198             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      199             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      200           .
      201         end.
      202       end.
      203       B-viewProcInfo:visible   in frame waitfram = no.
      204       B-viewProcInfo:sensitive in frame waitfram = no.
      205       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      206       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      207       if  (   mWaitFramView
      208          or  mWaitProcEvent)
      209          and not mBatchMode
      210       then
      211          display
      212             v-waitfram-action01 skip
      213             v-waitfram-action02 skip
      214             v-waitfram-action03 skip
      215          with frame waitfram .
      216       if     mWaitFramView
      217          then do:
      218             if     mWaitFramInterval ne ?
      219                and not mBatchMode
      220             then
      221                wait-for go of frame waitfram pause mWaitFramInterval.
      222          end.
      223          else
      224             if     mWaitProcEvent
      225                and not mBatchMode
      226             then
      227                process events .
      228     end.
      229   end procedure.
      230      procedure waitfram-show-this:
      231         define input  parameter iInterval as int64 no-undo.
      232         define variable vtime as int64 no-undo.
      233         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      234         mWaitFramInterval = iInterval.
      235         run waitfram-show (substitute("&1&2 &3&4" ,
      236                                       mWaitFramTextBeg ,
      237                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      238                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      239                                       mWaitFramTextEnd
      240                                      )
      241                           ).
      242      end.
      243      procedure WaitFramRunPause:
      244         define input  parameter iInterval as dec no-undo.
      245         define variable vStart  as datetime-tz no-undo.
      246         define variable vend    as datetime-tz no-undo.
      247         define variable vint as int64 no-undo.
      248         define variable vOk as logical no-undo.
      249         vStart = now.
      250         vend   = vStart.
      251         publish "WaitFramPause" (iInterval,output vOk).
      252         vend   =  now.
      253         vint = vend - vStart.
      254         vint = iInterval - vint / 1000.
      255         if     not mWaitFramStop
      256            and (   vint > 0
      257                 or (    not vOk
      258                     and iInterval eq ?
      259                     )
      260                 )
      261         then
      262            run waitfram-show-this (iInterval).
      263         vend   =  now.
      264         vint = vend - vStart.
      265         vint = iInterval - vint / 1000.
      266         if     not mWaitFramStop
      267            and vint > 0
      268         then do:
      269            run gbl/pause.p (vint * 1000).
      270         end.
      271         if iInterval ne ?
      272         then
      273            publish "WaitFramStop".
      274         waitfram-check-timeout().
      275      end.
      276      procedure WaitFramWaitFor:
      277         define input  parameter iInterval as dec no-undo.
      278         assign
      279            mWaitFramStartProc   = now
      280            mWaitFramStopUser    = no
      281            mWaitFramStopTimeOut = no
      282         .
      283         block-wait:
      284         do while not mWaitFramStop:
      285            run WaitFramRunPause (iInterval).
      286            if  waitfram-check-timeout()
      287            then do:
      288               leave block-wait.
      289            end.
      290         end.
      291         run waitfram-hide.
      292      end.
      293   procedure waitfram-join :
      294     define input  parameter p-line-1  as character no-undo .
      295     define input  parameter p-line-2  as character no-undo .
      296     define input  parameter p-line-3  as character no-undo .
      297     define output parameter p-message as character no-undo .
      298     do
      299     on error undo, return error return-value
      300     :
      301       assign
      302         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      303                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      304                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      305       .
      306     end.
      307   end procedure.
      308   function waitfram-join-function returns character
      309     (input p-line-1 as character
      310     ,input p-line-2 as character
      311     ,input p-line-3 as character
      312     ).
      313     define variable v-message as character no-undo .
      314     run waitfram-join in this-procedure
      315       (input  p-line-1
      316       ,input  p-line-2
      317       ,input  p-line-3
      318       ,output v-message
      319       ) .
      320     return v-message .
      321   end function .
      322   define new global shared variable g#language as character no-undo .
      323   if g#language <> '' and g#language <> 'rus':U then do:
      324     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      325   end.
      326   procedure proc-alt-shift-f2:
      327     if not ibs.th.gbl.gbl-var:rcode
      328   then
      329     run gbl\inidebug.p .
      330   end.
      331   procedure proc-alt-shift-f3:
      332     run gbl/prvssinf.p
      333       ( input this-procedure
      334       ) .
      335   end.
      336   define variable v-inform-launched as logical no-undo initial false .
      337   procedure proc-alt-shift-f4:
      338     define variable v-action as character no-undo .
      339     if v-inform-launched = false then do:
      340       assign
      341         v-inform-launched = true
      342       .
      343       run gbl/d-inform.w
      344         (  input self
      345         ,  input this-procedure
      346         , output v-action
      347         ) no-error .
      348       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      349       assign
      350         v-inform-launched = false
      351       .
      352     end.
      353   end.
      354   procedure proc-alt-f1:
      355     run gbl/corrhelp.p
      356       (input this-procedure
      357       ) .
      358   end .
      359   on alt-shift-f2 anywhere do:
      360     run proc-alt-shift-f2.
      361   end.
      362   on alt-shift-f3 anywhere do:
      363     run proc-alt-shift-f3 in this-procedure .
      364   end.
      365   on alt-shift-f4 anywhere do:
      366     run proc-alt-shift-f4 in this-procedure.
      367   end.
      368   on alt-f1 anywhere do:
      369     run proc-alt-f1 in this-procedure .
      370   end.
      371   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      372     define variable v-cntxt-db-num        as integer   no-undo .
      373     define variable v-cntxt-userid        as character no-undo .
      374     define variable v-cntxt-level         as character no-undo .
      375     define variable v-cntxt-host-code-obj as integer   no-undo .
      376     define variable v-cntxt-obj-type      as character no-undo .
      377     define variable v-cntxt-obj-code      as integer   no-undo .
      378     define variable v-cntxt-db-num-obj    as integer   no-undo .
      379     define variable v-cntxt-is-admin      as logical   no-undo .
      380   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      381   FUNCTION mark-string RETURNS CHARACTER
      382     ( input p-recid as recid, input mark-list as character  ) :
      383     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      384   END FUNCTION.
      385   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      386   procedure gen-key-rec :
      387     define input  parameter p-tbl-name    as character no-undo.
      388     define input  parameter p-bh_tbl-name as handle    no-undo.
      389     define output parameter p-key-rec     as character no-undo.
      390     do
      391     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      392     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      393     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      394     :
      395       define variable fh               as handle    no-undo .
      396       define variable v-ok             as logical   no-undo .
      397       define variable v-inform         as character no-undo .
      398       define variable v-ind            as integer   no-undo .
      399       define variable v-idx-field-qnty as integer   no-undo .
      400       if p-tbl-name = ?
      401         or p-tbl-name = "":U
      402       then do:
      403         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info3 ).
      404       end.
      405       if not p-bh_tbl-name:available then do:
      406         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info3, p-tbl-name ).
      407       end.
      408       assign
      409         p-key-rec = p-tbl-name
      410         v-inform  = p-bh_tbl-name:index-information(1)
      411         v-ind     = 2
      412       .
      413       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      414       on error undo, return error
      415       :
      416         assign
      417           v-inform = p-bh_tbl-name:index-information( v-ind )
      418           v-ind    = v-ind + 1
      419         .
      420       end.
      421       if v-inform = ?
      422         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      423         or entry( 3, v-inform, ",":U ) <> "1":U
      424       then do:
      425         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, p-tbl-name ).
      426       end.
      427       else do:
      428         assign
      429           v-idx-field-qnty = num-entries( v-inform ) - 4
      430         .
      431         if v-idx-field-qnty < 2 then do:
      432           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, p-tbl-name ).
      433         end.
      434         do v-ind = 1 to v-idx-field-qnty by 2
      435         on error undo, return error
      436         :
      437           assign
      438             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      439             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      440           .
      441         end.
      442       end.
      443       if p-key-rec = ? then do:
      444         assign
      445           p-key-rec = "":U
      446         .
      447         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info3, p-tbl-name ).
      448       end.
      449     end.
      450     return.
      451   end procedure.
      452   procedure gen-where-keyr-tab :
      453     define input  parameter i-tableSerach as character no-undo.
      454     define input  parameter i-tablekey   as character  no-undo.
      455     define input  parameter p-key-rec    as character  no-undo.
      456     define input  parameter p-key-handle as handle     no-undo .
      457     define input  parameter p-db-name    as character  no-undo .
      458     define input  parameter p-tt-handle  as handle     no-undo .
      459     define output parameter o-Where      as character  no-undo.
      460     do
      461     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      462     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      463     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      464     :
      465       define variable v-full-tbl-name  as character no-undo .
      466       define variable bh_tbl-name      as handle    no-undo .
      467       define variable fh_key           as handle    no-undo .
      468       define variable fh_search        as handle    no-undo .
      469       define variable v-field-num      as integer   no-undo .
      470       define variable v-count-fld      as integer   no-undo .
      471       define variable v-inform         as character no-undo .
      472       define variable v-ind            as integer   no-undo .
      473       define variable v-idx-field-qnty as integer   no-undo .
      474       define variable v-field-name     as character no-undo .
      475       define variable v-field-val      as character no-undo .
      476       define variable v-word-link      as character no-undo .
      477       define variable vTable           as character no-undo.
      478       define variable bh_tbl-key       as handle    no-undo .
      479       assign
      480         p-key-rec = trim( p-key-rec )
      481       .
      482       if p-key-handle <> ? then do:
      483         if not valid-handle(p-key-handle)
      484            or p-key-handle:type <> "buffer"
      485         then do:
      486           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info3 ).
      487         end.
      488         if num-entries( p-key-rec, chr(3) ) > 1
      489           or p-key-rec = ?
      490           or p-key-rec = "":U
      491         then do:
      492           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info3, p-key-rec ).
      493         end.
      494       end.
      495       else do:
      496         if p-key-rec = ?
      497           or p-key-rec = "":U
      498         then do:
      499           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      500         end.
      501       end.
      502       assign
      503         vTable = entry( 1 , p-key-rec, chr(3) )
      504       .
      505       if p-tt-handle <> ?
      506         and ( not valid-handle(p-tt-handle)
      507               or p-tt-handle:type <> "buffer"
      508             )
      509       then do:
      510         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info3, vTable, chr(10) ).
      511       end.
      512       if p-tt-handle = ? then do:
      513         assign
      514           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      515         .
      516         create buffer bh_tbl-name for table v-full-tbl-name .
      517       end.
      518       else do:
      519         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      520       end.
      521       assign
      522         v-inform = bh_tbl-name:index-information(1)
      523         v-ind    = 2
      524       .
      525       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      526       on error undo, return error
      527       :
      528         assign
      529           v-inform = bh_tbl-name:index-information( v-ind )
      530           v-ind    = v-ind + 1
      531         .
      532       end.
      533       if v-inform = ?
      534         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      535         or entry( 3, v-inform, ",":U ) <> "1":U
      536       then do:
      537         delete object bh_tbl-name no-error.
      538         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info3, vTable ).
      539       end.
      540       assign
      541         v-idx-field-qnty = num-entries( v-inform ) - 4
      542       .
      543       if v-idx-field-qnty < 2 then do:
      544         delete object bh_tbl-name no-error.
      545         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, vTable ).
      546       end.
      547       assign
      548         o-where     = "where":U
      549         v-word-link = "":U
      550         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      551         v-count-fld = 0
      552       .
      553       if i-tablekey ne "" and i-tablekey ne ?
      554       then do:
      555         assign
      556           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      557         .
      558         create buffer bh_tbl-key for table v-full-tbl-name .
      559       end.
      560       if i-tableSerach ne "" and i-tableSerach ne ?
      561       then do:
      562         delete object bh_tbl-name no-error.
      563         assign
      564           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      565         .
      566         create buffer bh_tbl-name for table v-full-tbl-name .
      567       end.
      568       block_where:
      569       do v-ind = 1 to v-idx-field-qnty by 2
      570       on error undo, return error
      571       :
      572         assign
      573           v-count-fld = v-count-fld + 1
      574         .
      575         if p-key-handle = ?
      576           and v-count-fld > v-field-num
      577         then do:
      578           leave block_where.
      579         end.
      580         define variable VfieldKeyTable as handle no-undo.
      581         assign
      582           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      583           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      584         .
      585         if     bh_tbl-key ne ?
      586         then do:
      587            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      588            if VfieldKeyTable eq ?
      589            then next block_where.
      590         end.
      591         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      592         then
      593            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      594         else
      595            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      596         if p-key-handle = ? then do:
      597           assign
      598             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      599           .
      600         end.
      601         else do:
      602           assign
      603             fh_key = p-key-handle:buffer-field( v-field-name )
      604           .
      605           if fh_key = ?
      606             or not valid-handle( fh_key )
      607           then do:
      608             delete object bh_tbl-name.
      609             if     bh_tbl-key ne ?
      610             then
      611                delete object bh_tbl-key.
      612             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info3, p-key-handle:name, v-field-name ).
      613           end.
      614           assign
      615             v-field-val = fh_key:buffer-value
      616           .
      617         end.
      618         if fh_search:data-type ="character":U then do:
      619           assign
      620             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      621             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      622             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      623             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      624             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      625             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      626             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      627             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      628             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      629             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      630             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      631             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      632             v-field-val = substitute( '"&1"', v-field-val )
      633           .
      634         end.
      635         assign
      636           o-where = substitute( "&1 &2", o-where, v-field-val )
      637         .
      638         if v-word-link = "":U then do:
      639           assign
      640             v-word-link = "and":U
      641           .
      642         end.
      643       end.
      644       delete object bh_tbl-name.
      645       if     bh_tbl-key ne ?
      646       then
      647          delete object bh_tbl-key.
      648       if p-key-handle = ?
      649         and v-count-fld <> v-field-num
      650       then do:
      651         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info3, vTable ).
      652       end.
      653     end.
      654   end procedure.
      655   procedure gen-hn-keyr-tab :
      656     define input  parameter i-tableSerach as character no-undo.
      657     define input  parameter i-tablekey   as character no-undo.
      658     define input  parameter p-key-rec    as character no-undo.
      659     define input  parameter p-key-handle as handle    no-undo .
      660     define input  parameter p-db-name    as character no-undo .
      661     define input  parameter p-tt-handle  as handle    no-undo .
      662     define input  parameter p-stts-lock  as integer   no-undo .
      663     define output parameter o-hn         as handle    no-undo.
      664     define variable v-full-tbl-name as character no-undo.
      665     define variable v-where         as character no-undo.
      666     define variable bh_tbl-name     as handle    no-undo.
      667     define variable vTable          as character no-undo.
      668     do
      669     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      670     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      671     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      672         run gen-where-keyr-tab(i-tableSerach,
      673                                i-tablekey,
      674                                p-key-rec,
      675                                p-key-handle,
      676                                p-db-name,
      677                                p-tt-handle,
      678                                output v-where).
      679         if i-tableSerach ne "" and i-tableSerach ne ?
      680         then do:
      681            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      682            create buffer bh_tbl-name for table v-full-tbl-name .
      683         end.
      684         else do:
      685            if p-tt-handle = ? then do:
      686               assign
      687                  vTable = entry( 1 , p-key-rec, chr(3) )
      688               .
      689               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      690               create buffer bh_tbl-name for table v-full-tbl-name .
      691            end.
      692            else do:
      693               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      694            end.
      695         end.
      696         if p-tt-handle = ? then do:
      697            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      698         end.
      699         else do:
      700            bh_tbl-name:find-first( v-where ) no-error .
      701         end.
      702         o-hn = bh_tbl-name.
      703      end.
      704   end procedure.
      705   procedure gen-hn-keyr :
      706     define input  parameter p-key-rec    as character no-undo.
      707     define input  parameter p-key-handle as handle    no-undo .
      708     define input  parameter p-db-name    as character no-undo .
      709     define input  parameter p-tt-handle  as handle    no-undo .
      710     define input  parameter p-stts-lock  as integer   no-undo .
      711     define output parameter o-hn         as handle    no-undo.
      712     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      713   end.
      714   procedure gen-row-keyr :
      715     define input  parameter p-key-rec    as character no-undo.
      716     define input  parameter p-key-handle as handle    no-undo .
      717     define input  parameter p-db-name    as character no-undo .
      718     define input  parameter p-tt-handle  as handle    no-undo .
      719     define input  parameter p-stts-lock  as integer   no-undo .
      720     define output parameter p-tbl-row    as rowid     no-undo.
      721     define output parameter p-tbl-name   as character no-undo.
      722     define variable vHn as handle no-undo.
      723       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      724       p-tbl-row = if vHn:available then vHn:rowid else ?.
      725       p-tbl-name =  vHn:table.
      726       delete object vHn no-error.
      727     if p-tbl-row = ? then do:
      728       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info3, p-tbl-name, p-key-rec ).
      729     end.
      730     else do:
      731       return.
      732     end.
      733   end procedure.
      734   procedure gen-key-fv :
      735     define input  parameter p-key-rec    as character no-undo .
      736     define output parameter p-field-list as character no-undo .
      737     define output parameter p-value-list as character no-undo.
      738     do
      739     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      740     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      741     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      742     :
      743       define variable v-full-tbl-name  as character no-undo .
      744       define variable bh_tbl-name      as handle    no-undo .
      745       define variable v-tbl-name       as character no-undo .
      746       define variable v-field-num      as integer   no-undo .
      747       define variable v-count-fld      as integer   no-undo .
      748       define variable v-inform         as character no-undo .
      749       define variable v-ind            as integer   no-undo .
      750       define variable v-idx-field-qnty as integer   no-undo .
      751       define variable v-delim-key      as character no-undo .
      752       if p-key-rec = ?
      753         or p-key-rec = "":U
      754       then do:
      755         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      756       end.
      757       assign
      758         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      759         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      760       .
      761       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      762       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info3 ).
      763       assign
      764         v-inform = bh_tbl-name:index-information(1)
      765         v-ind    = 2
      766       .
      767       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      768       on error undo, return error
      769       :
      770         assign
      771           v-inform = bh_tbl-name:index-information( v-ind )
      772           v-ind    = v-ind + 1
      773         .
      774       end.
      775       if v-inform = ?
      776         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      777         or entry( 3, v-inform, ",":U ) <> "1":U
      778       then do:
      779         delete object bh_tbl-name no-error.
      780         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
      781       end.
      782       assign
      783         v-idx-field-qnty = num-entries( v-inform ) - 4
      784       .
      785       if v-idx-field-qnty < 2 then do:
      786         delete object bh_tbl-name no-error.
      787         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
      788       end.
      789       assign
      790         p-field-list = "":U
      791         p-value-list = "":U
      792         v-delim-key  = "":U
      793         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      794         v-count-fld  = 0
      795       .
      796       block_where:
      797       do v-ind = 1 to v-idx-field-qnty by 2
      798       on error undo, return error
      799       :
      800         assign
      801           v-count-fld = v-count-fld + 1
      802         .
      803         if v-count-fld > v-field-num then do:
      804           leave block_where.
      805         end.
      806         assign
      807           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      808           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      809         .
      810         if v-ind = 1 then do:
      811           assign
      812             v-delim-key = chr(3)
      813           .
      814         end.
      815       end.
      816       delete object bh_tbl-name.
      817       if v-count-fld <> v-field-num then do:
      818         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info3, v-tbl-name ).
      819       end.
      820     end.
      821   end procedure.
      822   procedure gen-key-field :
      823     define input  parameter p-table      as character no-undo .
      824     define output parameter p-field-list as character no-undo .
      825     do
      826     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      827     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      828     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      829     :
      830       define variable v-full-tbl-name  as character no-undo .
      831       define variable bh_tbl-name      as handle    no-undo .
      832       define variable v-tbl-name       as character no-undo .
      833       define variable v-field-num      as integer   no-undo .
      834       define variable v-count-fld      as integer   no-undo .
      835       define variable v-inform         as character no-undo .
      836       define variable v-ind            as integer   no-undo .
      837       define variable v-idx-field-qnty as integer   no-undo .
      838       define variable v-delim-key      as character no-undo .
      839       if p-table = ?
      840         or p-table = "":U
      841       then do:
      842         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info3 ).
      843       end.
      844       assign
      845         v-tbl-name      = p-table
      846         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      847       .
      848       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      849       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info3 ).
      850       assign
      851         v-inform = bh_tbl-name:index-information(1)
      852         v-ind    = 2
      853       .
      854       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      855       on error undo, return error
      856       :
      857         assign
      858           v-inform = bh_tbl-name:index-information( v-ind )
      859           v-ind    = v-ind + 1
      860         .
      861       end.
      862       if v-inform = ?
      863         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      864         or entry( 3, v-inform, ",":U ) <> "1":U
      865       then do:
      866         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
      867       end.
      868       assign
      869         v-idx-field-qnty = num-entries( v-inform ) - 4
      870       .
      871       if v-idx-field-qnty < 2 then do:
      872         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
      873       end.
      874       assign
      875         p-field-list = "":U
      876         v-delim-key  = "":U
      877         v-count-fld  = 0
      878       .
      879       block_where:
      880       do v-ind = 1 to v-idx-field-qnty by 2
      881       on error undo, return error
      882       :
      883         assign
      884           v-count-fld = v-count-fld + 1
      885         .
      886         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      887         if v-ind = 1 then do:
      888           assign
      889             v-delim-key = chr(3)
      890           .
      891         end.
      892       end.
      893       delete object bh_tbl-name.
      894     end.
      895   end procedure.
      896   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      897   def var vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      898   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      899   FUNCTION get-region RETURNS CHARACTER
      900     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
      901     define variable par-region as character no-undo.
      902     if parhost-code = 0 and
      903          parobj-type = "":U and
      904          parobj-code = 0 then do:
      905          par-region = "Глобально".
      906          return par-region.
      907       end.
      908       if parobj-type = 'орг':U then do:
      909          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
      910          return par-region.
      911       end.
      912       if parobj-type = 'регион':U
      913       then do:
      914          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      915          return par-region.
      916       end.
      917       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      918       return par-region.
      919   END FUNCTION.
      920   FUNCTION get-objregion RETURNS CHARACTER
      921     (  input parobj-type as character, input parobj-code as integer ) :
      922     define variable par-region as character no-undo.
      923     if  parobj-type = "":U and
      924         parobj-code = 0
      925     then do:
      926        par-region = "Глобально".
      927     end.
      928     else if parobj-type = 'орг':U
      929     then do:
      930        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
      931     end.
      932     else if parobj-type = 'регион':U
      933     then do:
      934        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      935     end.
      936     else
      937        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      938     return par-region.
      939   END FUNCTION.
      940   FUNCTION calldscr returns character ( input p-call-id as character):
      941   define variable v-descr as character no-undo .
      942   define variable v-field-list as character no-undo .
      943   define variable v-value-list as character no-undo.
      944   define variable v-prop-label as character no-undo .
      945   define variable v-node-label as character no-undo .
      946   define variable v-dt-code as integer no-undo .
      947   define variable v-host-code as integer no-undo .
      948   define variable v-obj-type as character no-undo .
      949   define variable v-obj-code as integer no-undo .
      950   define variable v-label as character no-undo .
      951   define variable v-node-code as integer no-undo .
      952   define buffer buf_prop-head for ub.prop-head.
      953   define buffer buf_prop-ref for ub.prop-ref.
      954   define buffer buf_prop-map for ub.prop-map.
      955   run gen-key-fv in this-procedure ( input p-call-id
      956                                     ,output v-field-list
      957                                     ,output v-value-list) no-error .
      958   if error-status:error then return p-call-id.
      959   CASE entry(1, p-call-id, chr(3)):
      960     when 'dis-card-type':U then do:
      961       v-descr = substitute("Тип ДК: эмитент &1 тип: &2"
      962                            ,integer(entry(lookup("emitent-host-code", v-field-list, chr(3)), v-value-list, chr(3)) )
      963                            ,entry(lookup("type", v-field-list, chr(3)), v-value-list, chr(3))
      964                            ).
      965     end.
      966     when 'dis-card':U then do:
      967       v-descr = substitute("ДК: № &1"
      968                            ,entry(lookup("d-card", v-field-list, chr(3)), v-value-list, chr(3))
      969                            ).
      970     end.
      971     when 'dis-card-property':U then do:
      972       v-dt-code = integer(entry(lookup("dt-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
      973       v-node-code = integer(entry(lookup("node-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
      974       v-host-code = integer(entry(lookup("host-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
      975       v-obj-type = entry(lookup("obj-type", v-field-list, chr(3)), v-value-list, chr(3)) .
      976       v-obj-code = integer(entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
      977       find first buf_prop-ref no-lock where
      978                 buf_prop-ref.dt-code = v-dt-code no-error .
      979       if available buf_prop-ref then do:
      980         find first buf_prop-head no-lock where
      981                   buf_prop-head.dtm-code = buf_prop-ref.dtm-code no-error .
      982         v-prop-label = buf_prop-head.prop-label.
      983         find first buf_prop-map no-lock where
      984                   buf_prop-map.dtm-code = buf_prop-ref.dtm-code
      985               and buf_prop-map.node-code = v-node-code no-error .
      986         if available buf_prop-map then do:
      987           v-label = buf_prop-map.node-label.
      988         end.
      989       end.
      990       v-descr = substitute("ДК: № &1 &2:&3 &4"
      991                            ,entry(lookup("d-card", v-field-list, chr(3)), v-value-list, chr(3))
      992                            ,v-prop-label
      993                            ,v-label
      994                            ,get-region(v-host-code, v-obj-type, v-obj-code)
      995                            ).
      996     end.
      997     when 'clients':U then do:
      998       v-descr = substitute("&1&2"
      999                            ,entry(lookup("obj-type", v-field-list, chr(3)), v-value-list, chr(3))
     1000                            ,integer(entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3)) )
     1001                            ).
     1002     end.
     1003     when 'ext-system':U then do:
     1004       v-descr = substitute("Внешняя система &1"
     1005                            ,integer(entry(lookup("esys-id", v-field-list, chr(3)), v-value-list, chr(3)))
     1006                            ).
     1007     end.
     1008     WHEN 'thbj-attr':U then do:
     1009       if entry(lookup("upper-prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rum':U
     1010       or entry(lookup("upper-prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rum_obj':U
     1011       then do:
     1012         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'goods':U then do:
     1013           v-descr = "Операции с товарами".
     1014         end.
     1015         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'clients':U then do:
     1016           v-descr = "Операции с клиентами".
     1017         end.
     1018         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'gds-grp':U then do:
     1019           v-descr = "Операции с группами товаров".
     1020         end.
     1021         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'cli-grp':U then do:
     1022           v-descr = "Операции с группами клиентов".
     1023         end.
     1024         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'chk-doc_ibs-th':U then do:
     1025           v-descr = "Операции с чеками на POS IBS-TH".
     1026         end.
     1027         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'chk-doc_ibs-th-mob':U then do:
     1028           v-descr = "Операции с чеками на POS IBS-TH-MOB".
     1029         end.
     1030         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'edoc':U then do:
     1031           v-descr = "Операции в системе электронного документооборота".
     1032         end.
     1033         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'thref':U then do:
     1034           v-descr = "Операции со справочниками".
     1035         end.
     1036         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'pdf':U then do:
     1037           v-descr = "Операции с ДНЦ и переоценками".
     1038         end.
     1039         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rep':U then do:
     1040           v-descr = "Отчеты".
     1041         end.
     1042         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'ord':U then do:
     1043           v-descr = "Операции с заказами".
     1044         end.
     1045       end.
     1046     end.
     1047     when 'cash-desk':U then do:
     1048       v-descr = substitute("БД &1 Маг &2 Касса № &4 &3"
     1049                            ,entry(lookup("db-num", v-field-list, chr(3)), v-value-list, chr(3))
     1050                            ,entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3))
     1051                            ,entry(lookup("cash-num", v-field-list, chr(3)), v-value-list, chr(3))
     1052                            ,entry(lookup("pos-type", v-field-list, chr(3)), v-value-list, chr(3))
     1053                            ).
     1054     end.
     1055     when 'ext-file':U then do:
     1056       v-descr = substitute("БД &1 Файл № &3 (из БД &2)"
     1057                            ,entry(lookup("db-num", v-field-list, chr(3)), v-value-list, chr(3))
     1058                            ,entry(lookup("from-db-num", v-field-list, chr(3)), v-value-list, chr(3))
     1059                            ,entry(lookup("file-num", v-field-list, chr(3)), v-value-list, chr(3))
     1060                            ).
     1061     end.
     1062   end case.
     1063   return v-descr.
     1064   end function.
     1065   DEFINE VARIABLE v-doc-rec AS RECID NO-UNDO.
     1066   define variable v-rid-list as character no-undo .
     1067   DEFINE BUTTON b-chg
     1068        LABEL "&Изменить"
     1069        SIZE 10 BY 1.
     1070   DEFINE BUTTON B-Help
     1071        LABEL "Помо&щь"
     1072        SIZE 3 BY 1
     1073        BGCOLOR 8 .
     1074   DEFINE BUTTON b-lkp
     1075        LABEL "&Просмотр"
     1076        SIZE 10 BY 1.
     1077   DEFINE BUTTON b-mark
     1078        LABEL "&*"
     1079        SIZE 4 BY 1.
     1080   DEFINE BUTTON b-quit AUTO-END-KEY
     1081        LABEL "&Выход"
     1082        SIZE 10 BY 1
     1083        BGCOLOR 8 .
     1084   DEFINE BUTTON b-sel AUTO-GO
     1085        LABEL "Выбор"
     1086        SIZE 10 BY 1.
     1087   DEFINE VARIABLE EDITOR-1 AS CHARACTER
     1088        VIEW-AS EDITOR NO-WORD-WRAP SCROLLBAR-HORIZONTAL SCROLLBAR-VERTICAL
     1089        SIZE 98 BY 3.37 NO-UNDO.
     1090   DEFINE VARIABLE EDITOR-2 AS CHARACTER
     1091        VIEW-AS EDITOR NO-WORD-WRAP SCROLLBAR-HORIZONTAL SCROLLBAR-VERTICAL
     1092        SIZE 98 BY 2.87 NO-UNDO.
     1093   DEFINE VARIABLE mark-num AS INTEGER FORMAT "->,>>>,>>9":U INITIAL 0
     1094         VIEW-AS TEXT
     1095        SIZE 9 BY .67
     1096        FGCOLOR 10  NO-UNDO.
     1097   DEFINE QUERY br-rule-by-call FOR
     1098         X_rule-by-call,
     1099         X_ruleset,
     1100         X_rule SCROLLING.
     1101   DEFINE BROWSE br-rule-by-call
     1102     QUERY br-rule-by-call NO-LOCK DISPLAY
     1103         mark-string(recid(X_rule-by-call), v-rid-list) Format "X(1)" COLUMN-LABEL "*"
     1104   X_rule-by-call.call_id COLUMN-LABEL "Точка вызова" FORMAT "X(255)" WIDTH 45
     1105   X_rule-by-call.call#_id COLUMN-LABEL "Точка вызова" FORMAT ">>>>>>>>9"
     1106   X_rule-by-call.codex_id COLUMN-LABEL "Кодекс!правил" FORMAT ">>>>>>>>9"
     1107   X_rule-by-call.ruleset_id COLUMN-LABEL "Набор!правил" FORMAT ">>>>>>>>9"
     1108   X_rule-by-call.order_id COLUMN-LABEL "Порядок!вызова" FORMAT ">>>>>>>>9"
     1109   X_ruleset.name COLUMN-LABEL "Кодекс/набор правил" FORMAT "X(255)" WIDTH 45
     1110   X_rule-by-call.rule_id COLUMN-LABEL "№ правила" FORMAT ">>>>>>>>9"
     1111   X_rule.name COLUMN-LABEL "Правило" FORMAT "X(255)"  WIDTH 45
     1112   X_rule-by-call.is_dynamic COLUMN-LABEL "Отклю!чемое" FORMAT "+/"
     1113   X_rule-by-call.can-calc COLUMN-LABEL "Включено" FORMAT "+/"
     1114   X_rule-by-call.profile_id COLUMN-LABEL "Профайл" FORMAT ">>>>>>>>9"
     1115   X_rule-by-call.once-more COLUMN-LABEL "№ привязки" FORMAT ">9"
     1116       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 14 FIT-LAST-COLUMN.
     1117   DEFINE FRAME Dialog-Frame
     1118        b-quit AT ROW 1 COL 1
     1119        b-mark AT ROW 1 COL 24 WIDGET-ID 12
     1120        b-sel AT ROW 1 COL 28 WIDGET-ID 10
     1121        b-chg AT ROW 1 COL 48 WIDGET-ID 4
     1122        b-lkp AT ROW 1 COL 68 WIDGET-ID 6
     1123        B-Help AT ROW 1 COL 95
     1124        br-rule-by-call AT ROW 2.33 COL 1 WIDGET-ID 100
     1125        EDITOR-2 AT ROW 16.5 COL 1 NO-LABEL WIDGET-ID 18
     1126        EDITOR-1 AT ROW 19.5 COL 1 NO-LABEL WIDGET-ID 16
     1127        mark-num AT ROW 1 COL 13 COLON-ALIGNED NO-LABEL WIDGET-ID 14
     1128        SPACE(75.24) SKIP(21.21)
     1129       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1130            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1131            TITLE "Привязка правил к точкам вызова"
     1132            CANCEL-BUTTON b-quit.
     1133   ASSIGN
     1134          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1135          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1136   ON GO OF FRAME Dialog-Frame
     1137   DO:
     1138     p-rid-list = v-rid-list.
     1139   END.
     1140   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1141   DO:
     1142     APPLY "END-ERROR":U TO SELF.
     1143   END.
     1144   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
     1145   DO:
     1146     define variable v-rec as recid no-undo.
     1147     if not available X_rule-by-call then return no-apply.
     1148     run proc-b-chg in this-procedure no-error.
     1149     if error-status:error then return no-apply.
     1150   END.
     1151   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
     1152   DO:
     1153     define variable v-rec as recid no-undo.
     1154     if not available X_rule-by-call then return no-apply.
     1155     v-rec = recid(X_rule-by-call).
     1156     run rul/rule-by-call-i.w ( input parparentproc
     1157                          ,input 'ПРОСМОТР':U
     1158                          ,input X_rule-by-call.CALL#_id
     1159                          ,input X_rule-by-call.codex_id
     1160                          ,input X_rule-by-call.ruleset_id
     1161                          ,input X_rule-by-call.order_id
     1162                          ,input-output v-rec) no-error.
     1163   END.
     1164   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
     1165   DO:
     1166       define variable glog as logical no-undo .
     1167     if available X_rule-by-call then do:
     1168   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1169   define variable v-str-recid8 as character no-undo .
     1170   define variable v-num-entry8 as integer   no-undo .
     1171   assign
     1172     v-str-recid8 = trim( string( recid( X_rule-by-call ) , "->>>>>>>>>>>9":U ) )
     1173     v-num-entry8 = lookup( v-str-recid8 , v-rid-list )
     1174   .
     1175   if v-num-entry8 > 0 then do:
     1176     assign
     1177       entry( v-num-entry8, v-rid-list ) = "":U
     1178       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1179     .
     1180   end.
     1181   else do:
     1182     assign
     1183       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid8
     1184     .
     1185   end.
     1186     glog = br-rule-by-call:refresh() .
     1187     if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1188         glog = br-rule-by-call:select-next-row ().
     1189         apply "VALUE-CHANGED" to br-rule-by-call in frame Dialog-Frame.
     1190     end.
     1191     if num-entries( v-rid-list ) = 0
     1192     then
     1193         hide mark-num in frame Dialog-Frame.
     1194     else
     1195         disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1196   end.
     1197   apply "entry" to br-rule-by-call in frame Dialog-Frame.
     1198   END.
     1199   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     1200   DO:
     1201     if available X_rule-by-call then do:
     1202       if  ( v-rid-list = "" ) or b-mark:sensitive = no
     1203       then  v-rid-list = string( recid( X_rule-by-call ) ) .
     1204     end.
     1205   END.
     1206   ON VALUE-CHANGED OF br-rule-by-call IN FRAME Dialog-Frame
     1207   DO:
     1208       IF AVAILABLE X_rule THEN DO:
     1209       editor-1:SCREEN-VALUE = X_rule.documentation.
     1210       editor-2:SCREEN-VALUE = X_rule-by-call.algo-des.
     1211     END.
     1212     ELSE DO:
     1213       editor-1:SCREEN-VALUE = '':U.
     1214       editor-2:SCREEN-VALUE = '':U.
     1215     END.
     1216   END.
     1217   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1218   on f5 of frame Dialog-Frame anywhere
     1219   do:
     1220      v-doc-rec = recid(X_rule-by-call).    RUn OpenBR in this-procedure.  REPOSITION br-rule-by-call to recid v-doc-rec No-ERROR.   apply 'value-changed' to br-rule-by-call.
     1221       apply "VALUE-CHANGED" to br-rule-by-call.
     1222   end.
     1223   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1224   on help of frame Dialog-Frame
     1225   do:
     1226     run gbl/app_help.p
     1227       (input this-procedure :file-name
     1228       ,input ''
     1229       ,input ?
     1230       ) no-error.
     1231     if error-status :error then do:
     1232       message
     1233         "Ошибка при вызове помощи"
     1234         error-status :get-message(1)
     1235         view-as alert-box .
     1236     end.
     1237   end.
     1238   run minbtn-set in this-procedure .
     1239   on choose of b-help in frame Dialog-Frame
     1240   do:
     1241     apply "help":u to frame Dialog-Frame .
     1242   end.
     1243   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1244   procedure minbtn-set :
     1245       do
     1246           on error undo, return error return-value
     1247           :
     1248           define variable ii              as integer       no-undo .
     1249           define variable fh              as widget-handle no-undo .
     1250           define variable hh              as widget-handle no-undo .
     1251           define variable v-h             as handle        extent 4 no-undo .
     1252           define variable v-name-button   as character     no-undo .
     1253           define variable v-help-old-x    as decimal       no-undo .
     1254           define variable v-help-old-y    as decimal       no-undo .
     1255           define variable v-help-old-size as decimal       no-undo .
     1256           define variable v-frame-width   as decimal       no-undo .
     1257           define variable jj              as integer       no-undo .
     1258           do
     1259               on error undo, return error
     1260               :
     1261               assign
     1262                   v-frame-width = frame Dialog-Frame:width - 0.3
     1263                   fh            = frame Dialog-Frame:first-child
     1264                   hh            = fh:first-child
     1265                   ii            = 1
     1266                   .
     1267               do while valid-handle(hh):
     1268                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1269                   do:
     1270                       case lc(hh:name) :
     1271                           when "b-help" then
     1272                               do:
     1273                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1274                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1275                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1276                                   hh:TOOLTIP = "Помощь" .
     1277                                   v-help-old-x = hh:column .
     1278                                   v-help-old-y = hh:row    .
     1279                                   v-help-old-size = hh:width .
     1280                                   hh:width-chars = 2.5 .
     1281                               end.
     1282                           when "b-print" then
     1283                               do:
     1284                                   hh:load-image("cmp/b-print.bmp":u) .
     1285                                   hh:TOOLTIP = "Печать" .
     1286                                   v-h[ii] = hh:handle .
     1287                                   ii = ii + 1 .
     1288                                   hh:width-chars = 3 .
     1289                               end.
     1290                           when "b-history" or
     1291                           when "b-hist" then
     1292                               do:
     1293                                   hh:load-image("cmp/b-hist.bmp":u) .
     1294                                   hh:TOOLTIP = "История" .
     1295                                   v-h[ii] = hh:handle .
     1296                                   ii = ii + 1 .
     1297                                   hh:width-chars = 3 .
     1298                               end.
     1299                           when "b-sch" then
     1300                               do:
     1301                                   hh:load-image("cmp/b-sch.bmp":u) .
     1302                                   hh:TOOLTIP = "Установка Фильтра" .
     1303                                   v-h[ii] = hh:handle .
     1304                                   ii = ii + 1 .
     1305                                   hh:width-chars = 3 .
     1306                               end.
     1307                           when "b-hist-user" then
     1308                               do:
     1309                                   hh:load-image("cmp/b-hist.bmp":u) .
     1310                                   hh:TOOLTIP = "История пользователя" .
     1311                                   ii = ii + 1 .
     1312                               end.
     1313                       end case.
     1314                   end.
     1315                   hh = hh:next-sibling.
     1316               end.
     1317               b-help:column = v-frame-width - b-help:width-chars.
     1318               jj = 0.
     1319               repeat ii = 4 to 1 by -1 :
     1320                   if valid-handle (v-h[ii] ) then
     1321                   do:
     1322                       jj  = jj + 1 .
     1323                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1324                       v-h[ii]:row    = v-help-old-y .
     1325                   end.
     1326               end.
     1327           end.
     1328       end.
     1329   end procedure.
     1330   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1331   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1332   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1333   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1334   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1335   define variable v-diasize-current-frame-height as decimal   no-undo .
     1336   define variable v-diasize-change-size          as logical   no-undo .
     1337   define variable v-diasize-resize-button        as handle    no-undo .
     1338   define variable v-diasize-wndmax               as logical   no-undo .
     1339   define variable v-diasize-wndstore             as logical   no-undo .
     1340   define variable v-diasize-proc-name            as character no-undo .
     1341   define variable v-diasize-browse-handle        as handle    no-undo .
     1342   define variable v-diasize-browse-number        as integer   no-undo .
     1343   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1344   define temp-table temp-diasize-handle no-undo
     1345     field handle-value  as handle
     1346     field save-position as decimal
     1347     index xpk is primary unique handle-value
     1348     .
     1349   define temp-table temp-browse-handle no-undo
     1350     field browse-type   as character
     1351     field browse-number as integer
     1352     field browse-handle as handle
     1353     field original-size as decimal
     1354     index xpk is primary unique browse-type browse-number
     1355     index xie browse-type browse-handle
     1356   .
     1357   procedure diasize_change-height :
     1358     define input  parameter p-change-value  as decimal   no-undo .
     1359     define input  parameter p-move-resize   as logical   no-undo .
     1360     define variable v-field-group-handle    as handle    no-undo .
     1361     define variable v-object-handle         as handle    no-undo .
     1362     define variable v-frame-height          as decimal   no-undo .
     1363     define variable v-frame-virtual-height  as decimal   no-undo .
     1364     define variable v-browse-height         as decimal   no-undo .
     1365     define variable v-window-height         as decimal   no-undo .
     1366     define variable v-window-virtual-height as decimal   no-undo .
     1367     define variable v-change-sign           as integer   no-undo .
     1368     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1369     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1370     if p-change-value > 0
     1371     then do:
     1372       if frame Dialog-Frame :height + p-change-value
     1373           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1374       then do:
     1375         assign
     1376           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1377                           - (frame Dialog-Frame :height-chars)
     1378         .
     1379         if p-change-value <= 0
     1380         then do:
     1381           run diasize_position-resize-button in this-procedure .
     1382           return .
     1383         end.
     1384       end.
     1385     end.
     1386     if p-change-value < 0
     1387     then do:
     1388       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1389       then do:
     1390         assign
     1391           p-change-value = v-diasize-orig-frame-height
     1392                          - (frame Dialog-Frame :height-chars)
     1393         .
     1394         if p-change-value >= 0
     1395         then do:
     1396           run diasize_position-resize-button in this-procedure .
     1397           return .
     1398         end.
     1399       end.
     1400     end.
     1401     if p-change-value >= 0
     1402     then do:
     1403       assign
     1404         v-change-sign = 1
     1405       .
     1406     end.
     1407     else do:
     1408       assign
     1409         v-change-sign = -1
     1410       .
     1411     end.
     1412     assign
     1413       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1414     .
     1415     if p-change-value = 0
     1416     then do:
