     1713           define variable v-cntxt-db-num        as integer   no-undo .
     1714           define variable v-cntxt-userid        as character no-undo .
     1715           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1716                                             , OUTPUT v-cntxt-userid
     1717                                             ) .
     1718           run gbl/wndsizew.p
     1719             (input  v-cntxt-db-num
     1720             ,input  v-cntxt-userid
     1721             ,input  v-diasize-proc-name
     1722             ,input  'height':u
     1723             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1724             ) .
     1725         end.
     1726       end.
     1727     end.
     1728     assign
     1729       v-diasize-change-size = false
     1730     .
     1731   end procedure.
     1732   procedure diasize_set-height :
     1733     define input  parameter p-new-height  as decimal   no-undo .
     1734     define input  parameter p-move-resize as logical   no-undo .
     1735     do
     1736     on error undo, return error return-value
     1737     :
     1738       run diasize_change-height in this-procedure
     1739         (input  (p-new-height - frame Dialog-Frame :height)
     1740         ,input  p-move-resize
     1741         ) .
     1742     end.
     1743   end procedure.
     1744   procedure diasize_change-width :
     1745     define input  parameter p-change-value as decimal   no-undo .
     1746     define input  parameter p-move-resize  as logical   no-undo .
     1747     define variable v-field-group-handle   as handle    no-undo .
     1748     define variable v-object-handle        as handle    no-undo .
     1749     define variable v-frame-width          as decimal   no-undo .
     1750     define variable v-frame-virtual-width  as decimal   no-undo .
     1751     define variable v-browse-width         as decimal   no-undo .
     1752     define variable v-window-width         as decimal   no-undo .
     1753     define variable v-window-virtual-width as decimal   no-undo .
     1754     define variable v-change-sign          as integer   no-undo .
     1755     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1756     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1757     if p-change-value > 0
     1758     then do:
     1759       if frame Dialog-Frame :width + p-change-value >
     1760           session :width-chars
     1761       then do:
     1762         assign
     1763           p-change-value = session :width-chars - frame Dialog-Frame :width
     1764         .
     1765         if p-change-value <= 0
     1766         then do:
     1767           run diasize_position-resize-button in this-procedure .
     1768           return .
     1769         end.
     1770       end.
     1771     end.
     1772     if p-change-value < 0
     1773     then do:
     1774       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1775       then do:
     1776         assign
     1777           p-change-value = v-diasize-orig-frame-width
     1778                          - frame Dialog-Frame :width
     1779         .
     1780         if p-change-value >= 0
     1781         then do:
     1782           run diasize_position-resize-button in this-procedure .
     1783           return .
     1784         end.
     1785       end.
     1786     end.
     1787     if p-change-value >= 0
     1788     then do:
     1789       assign
     1790         v-change-sign = 1
     1791       .
     1792     end.
     1793     else do:
     1794       assign
     1795         v-change-sign = -1
     1796       .
     1797     end.
     1798     assign
     1799       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1800     .
     1801     if p-change-value = 0
     1802     then do:
     1803       run diasize_position-resize-button in this-procedure .
     1804       return .
     1805     end.
     1806     move_block:
