     1966         v-diasize-resize-button :row = 1.
     1967         v-diasize-resize-button :column = 1.
     1968       end.
     1969       if p-change-value > 0
     1970       then do:
     1971         if frame Dialog-Frame :scrollable = true
     1972         then do:
     1973           assign
