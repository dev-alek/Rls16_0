     1438               then do:
     1439                 assign
     1440                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1441                 .
     1442               end.
     1443             end.
     1444             assign
     1445               v-diasize-browse-handle :height = v-browse-height
     1446             .
