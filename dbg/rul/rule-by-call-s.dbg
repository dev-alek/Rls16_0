     2022               no-error .
     2023             if error-status :error
     2024             or error-status :get-message(1) <> ""
     2025             then do:
     2026               undo move_block, retry move_block .
     2027             end.
     2028           end.
     2029         end.
     2030       end.
     2031       else do:
     2032         for each buf_temp-diasize-handle
     2033         on error undo move_block, retry move_block
     2034         :
     2035           assign
     2036             v-object-handle = buf_temp-diasize-handle.handle-value
     2037           .
     2038           if v-object-handle <> v-diasize-resize-button
     2039           then do:
     2040             assign
     2041               v-object-handle :col = v-object-handle :col + p-change-value
     2042               no-error .
     2043             if error-status :error
     2044             or error-status :get-message(1) <> ""
     2045             then do:
     2046               undo move_block, retry move_block .
     2047             end.
     2048           end.
     2049         end.
     2050         for each buf_temp-browse-handle
     2051           where buf_temp-browse-handle.browse-type = 'width':u
     2052         on error undo move_block, retry move_block
     2053         :
     2054           assign
     2055             buf_temp-browse-handle.browse-handle :width
     2056               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2057             no-error .
     2058           if error-status :error
     2059           or error-status :get-message(1) <> ""
     2060           then do:
     2061             undo move_block, retry move_block .
     2062           end.
     2063         end.
     2064         assign
     2065           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2066           no-error .
     2067         if error-status :error
     2068         or error-status :get-message(1) <> ""
     2069         then do:
     2070           undo move_block, retry move_block.
     2071         end.
     2072         assign
     2073           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2074         no-error .
     2075         if error-status :error
     2076         or error-status :get-message(1) <> ""
     2077         then do:
     2078           undo move_block, retry move_block.
     2079         end.
     2080         if frame Dialog-Frame :scrollable = true
     2081         then do:
     2082           assign
     2083             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2084           no-error .
     2085           if error-status :error
     2086           or error-status :get-message(1) <> ""
     2087           then do:
     2088             undo move_block, retry move_block.
     2089           end.
     2090         end.
     2091       end.
     2092       if p-move-resize
     2093       then do:
     2094         run diasize_position-resize-button in this-procedure .
     2095       end.
     2096       if v-diasize-wndstore = true
     2097       then do:
     2098         if connected("ub") = true
     2099         then do:
     2100           define variable v-cntxt-db-num        as integer   no-undo .
     2101           define variable v-cntxt-userid        as character no-undo .
     2102           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2103                                             , OUTPUT v-cntxt-userid
     2104                                             ) .
     2105           run gbl/wndsizew.p
     2106             (input  v-cntxt-db-num
     2107             ,input  v-cntxt-userid
     2108             ,input  v-diasize-proc-name
     2109             ,input  'width':u
     2110             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2111             ) .
     2112         end.
     2113       end.
     2114     end.
     2115     assign
     2116       v-diasize-change-size = false
     2117     .
     2118   end procedure.
     2119   procedure diasize_set-width :
     2120     define input  parameter p-new-width  as decimal   no-undo .
     2121     define input  parameter p-move-resize as logical   no-undo .
     2122     do
     2123     on error undo, return error return-value
     2124     :
     2125       run diasize_change-width in this-procedure
     2126         (input  (p-new-width - frame Dialog-Frame :width)
     2127         ,input  p-move-resize
     2128         ) .
     2129     end.
     2130   end procedure.
     2131   procedure diasize_position-resize-button :
     2132     do with frame Dialog-Frame
     2133     :
     2134       hide v-diasize-resize-button .
     2135       assign
     2136         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2137                     - 1
     2138                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2139         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2140                     - 1
     2141                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2142       .
     2143       view v-diasize-resize-button .
     2144     end.
     2145   end procedure.
     2146   on alt-right anywhere
     2147   do:
     2148     run diasize_change-width in this-procedure
     2149       (input 1
     2150       ,input true
     2151       ) .
     2152     return no-apply .
     2153   end.
     2154   on alt-left anywhere
     2155   do:
     2156     run diasize_change-width in this-procedure
     2157       (input -1
     2158       ,input true
     2159       ) .
     2160     return no-apply .
     2161   end.
     2162   on alt-down anywhere
     2163   do:
     2164     run diasize_change-height in this-procedure
     2165       (input 1
     2166       ,input true
     2167       ) .
     2168     return no-apply .
     2169   end.
     2170   on alt-up anywhere
     2171   do:
     2172     run diasize_change-height in this-procedure
     2173       (input -1
     2174       ,input true
     2175       ) .
     2176     return no-apply .
     2177   end.
     2178   on alt-enter of frame Dialog-Frame
     2179   do:
     2180     run diasize_maximize in this-procedure
     2181       (input  ?
     2182       ).
     2183     return no-apply .
     2184   end.
     2185   procedure diasize_end-move :
     2186     do
     2187     on error undo, return error return-value
     2188     :
     2189       define variable v-row-delta as decimal   no-undo .
     2190       define variable v-col-delta as decimal   no-undo .
     2191       define variable v-new-row as decimal   no-undo .
     2192       define variable v-new-col as decimal   no-undo .
     2193       assign
     2194         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2195         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2196       .
     2197       assign
     2198         v-row-delta = v-new-row - frame Dialog-Frame :height
     2199         v-col-delta = v-new-col - frame Dialog-Frame :width
     2200       .
     2201       run diasize_change-height in this-procedure
     2202         (input v-row-delta
     2203         ,input true
     2204         ) .
     2205       run diasize_change-width in this-procedure
     2206         (input v-col-delta
     2207         ,input true
     2208         ) .
     2209     end.
     2210   end procedure.
     2211   procedure diasize_maximize :
     2212     define input  parameter p-action as logical   no-undo .
     2213     do
     2214     on error undo, return error return-value
     2215     :
     2216       if p-action = ?
     2217       then do:
     2218         if v-diasize-need-maximize = true
     2219         then do:
     2220           assign
     2221             p-action = true
     2222           .
     2223         end.
     2224         else do:
     2225           assign
     2226             p-action = false
     2227           .
     2228         end.
     2229       end.
     2230       if p-action = true
     2231       then do:
     2232         run diasize_change-height in this-procedure
     2233           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2234               - frame Dialog-Frame :height-chars
     2235           ,input true
     2236           ) .
     2237         run diasize_change-width in this-procedure
     2238           (input session :width-chars
     2239               - frame Dialog-Frame :width-chars
     2240           ,input true
     2241           ) .
     2242         assign
     2243           v-diasize-need-maximize = false
     2244         .
     2245       end.
     2246       else do:
     2247         run diasize_change-width in this-procedure
     2248           (input v-diasize-orig-frame-width
     2249               - frame Dialog-Frame :width-chars
     2250           ,input true
     2251           ) .
     2252         run diasize_change-height in this-procedure
     2253           (input v-diasize-orig-frame-height
     2254               - frame Dialog-Frame :height-chars
     2255           ,input true
     2256           ) .
     2257         assign
     2258           v-diasize-need-maximize = true
     2259         .
     2260       end.
     2261     end.
     2262   end procedure.
     2263   procedure diasize_restore-orig-size :
     2264     do
     2265     on error undo, return error return-value
     2266     :
     2267       assign
     2268         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2269         v-diasize-current-frame-height = frame Dialog-Frame :height
     2270       .
     2271       run diasize_set-height in this-procedure
     2272         (input  v-diasize-orig-frame-height
     2273         ,input  true
     2274         ) .
     2275       run diasize_set-width in this-procedure
     2276         (input  v-diasize-orig-frame-width
     2277         ,input  true
     2278         ) .
     2279     end.
     2280   end procedure.
     2281   procedure diasize_restore-current-size :
     2282     do
     2283     on error undo, return error return-value
     2284     :
     2285       run diasize_set-height in this-procedure
     2286         (input  v-diasize-current-frame-height
     2287         ,input  true
     2288         ) .
     2289       run diasize_set-width in this-procedure
     2290         (input  v-diasize-current-frame-width
     2291         ,input  true
     2292         ) .
     2293     end.
     2294   end procedure.
     2295   procedure diasize_set-browse-handle :
     2296     define input  parameter p-browse-handle as handle   no-undo .
     2297     define buffer buf_temp-browse-handle for temp-browse-handle .
     2298     do
     2299     on error undo, return error return-value
     2300     :
     2301       assign
     2302         v-diasize-browse-handle = p-browse-handle
     2303       .
     2304       for each buf_temp-browse-handle
     2305       on error undo, return error return-value
     2306       :
     2307         delete buf_temp-browse-handle .
     2308       end.
     2309     end.
     2310   end procedure.
     2311   procedure diasize_add_browse :
     2312     define input  parameter p-browse-type   as character no-undo .
     2313     define input  parameter p-browse-handle as handle    no-undo .
     2314     define buffer buf_temp-browse-handle for temp-browse-handle .
     2315     do
     2316     on error undo, return error return-value
     2317     :
     2318       assign
     2319         v-diasize-browse-number = v-diasize-browse-number + 1
     2320       .
     2321       create buf_temp-browse-handle .
     2322       assign
     2323         buf_temp-browse-handle.browse-type   = p-browse-type
     2324         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2325         buf_temp-browse-handle.browse-handle = p-browse-handle
     2326       .
     2327     end.
     2328   end procedure.
     2329   procedure diasize_init :
     2330     define variable v-default-value    as logical   no-undo .
     2331     define variable v-restore-saved    as logical   no-undo .
     2332     define variable v-resize-value-str as character no-undo .
     2333     do
     2334     on error undo, return error return-value
     2335     :
     2336       do with frame Dialog-Frame
     2337       :
     2338         assign
     2339           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2340           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2341           v-diasize-browse-handle     = browse br-rule-by-call :handle
     2342         .
     2343         create button v-diasize-resize-button
     2344         assign
     2345           parent        = frame Dialog-Frame :first-child
     2346           label         = "s"
     2347           height-pixels = 16
     2348           width-pixels  = 16
     2349           visible       = true
     2350           sensitive     = true
     2351           movable       = true
     2352           triggers:
     2353             on end-move persistent run diasize_end-move in this-procedure .
     2354           end triggers.
     2355         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2356         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2357         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2358         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2359         assign
     2360           v-diasize-wndmax = false
     2361         .
     2362         if connected("ub") = true
     2363         then do:
     2364           define variable v-cntxt-db-num        as integer   no-undo .
     2365           define variable v-cntxt-userid        as character no-undo .
     2366           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2367                                             , OUTPUT v-cntxt-userid
     2368                                             ) .
     2369           run gbl/wndpar_r.p
     2370             (input  v-cntxt-db-num
     2371             ,input  v-cntxt-userid
     2372             ,input  'wndmax':U
     2373             ,output v-diasize-wndmax
     2374             ,output v-default-value
     2375             ) .
     2376         end.
     2377         assign
     2378           v-diasize-wndstore = false
     2379         .
     2380         if connected("ub") = true
     2381         then do:
     2382           run gbl/wndpar_r.p
     2383             (input  v-cntxt-db-num
     2384             ,input  v-cntxt-userid
     2385             ,input  'wndstore':U
     2386             ,output v-diasize-wndstore
     2387             ,output v-default-value
     2388             ) .
     2389         end.
     2390         assign
     2391           v-diasize-proc-name = entry(1, program-name(2), '.')
     2392         .
     2393         if v-diasize-wndstore = true
     2394         then do:
     2395           assign
     2396             v-restore-saved = false
     2397           .
     2398           if connected("ub") = true
     2399           then do:
     2400             run gbl/wndsizer.p
     2401               (input  v-cntxt-db-num
     2402               ,input  v-cntxt-userid
     2403               ,input  v-diasize-proc-name
     2404               ,input  'height':u
     2405               ,output v-resize-value-str
     2406               ) .
     2407             if v-resize-value-str <> '':U
     2408             then do:
     2409               run diasize_change-height in this-procedure
     2410                 (input  integer(v-resize-value-str)
     2411                 ,input  true
     2412                 ) .
     2413               assign
     2414                 v-restore-saved = true
     2415               .
     2416             end.
     2417           end.
     2418           if connected("ub") = true
     2419           then do:
     2420             run gbl/wndsizer.p
     2421               (input  v-cntxt-db-num
     2422               ,input  v-cntxt-userid
     2423               ,input  v-diasize-proc-name
     2424               ,input  'width':u
     2425               ,output v-resize-value-str
     2426               ) .
     2427             if v-resize-value-str <> '':U
     2428             then do:
     2429               run diasize_change-width in this-procedure
     2430                 (input  integer(v-resize-value-str)
     2431                 ,input  true
     2432                 ) .
     2433               assign
     2434                 v-restore-saved = true
     2435               .
     2436             end.
     2437           end.
     2438           if v-restore-saved <> true
     2439           then do:
     2440             if v-diasize-wndmax = true
     2441             then do:
     2442               run diasize_maximize in this-procedure
     2443                 (input  true
     2444                 ) .
     2445             end.
     2446           end.
     2447         end.
     2448         else do:
     2449           if v-diasize-wndmax = true
     2450           then do:
     2451             run diasize_maximize in this-procedure
     2452               (input  true
     2453               ) .
     2454           end.
     2455         end.
     2456       end.
     2457     end.
     2458   end procedure.
     2459   procedure diasize_need-full-display :
     2460     define output parameter p-need-full-display as logical   no-undo .
     2461     do
     2462     on error undo, return error return-value
     2463     :
     2464       assign
     2465         p-need-full-display = v-diasize-need-full-display
     2466       .
     2467       assign
     2468         v-diasize-need-full-display = false
     2469       .
     2470     end.
     2471   end procedure.
     2472   procedure get-context :
     2473      define output parameter p-db-num as integer          no-undo.
     2474      define output parameter p-user-id as character        no-undo.
     2475      define variable v-login               as character    no-undo.
     2476      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2477      define buffer buf_user-login  for ub.user-login .
     2478      do
     2479      on error undo, return error
     2480      :
     2481            FIND FIRST buf_sys-ctrl no-lock.
     2482            ASSIGN
     2483               v-login = USERID("ub")
     2484               p-db-num = buf_sys-ctrl.db-num
     2485            .
     2486            FIND FIRST buf_user-login
     2487                 WHERE buf_user-login.db-num = p-db-num
     2488                   AND buf_user-login.user-login = v-login
     2489                 no-lock
     2490                 no-error
     2491                 .
     2492            IF AVAILABLE buf_user-login
     2493            THEN DO:
     2494               assign
     2495                  p-user-id = buf_user-login.user-id
     2496               .
     2497            END.
     2498      end.
     2499   end procedure.
     2500       run diasize_init in this-procedure .
     2501   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2502   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2503   MAIN-BLOCK:
     2504   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2505      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2506   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2507     run mainmenu_getcntxt in parparentproc
     2508       (output v-cntxt-db-num
     2509       ,output v-cntxt-userid
     2510       ,output v-cntxt-level
     2511       ,output v-cntxt-host-code-obj
     2512       ,output v-cntxt-obj-type
     2513       ,output v-cntxt-obj-code
     2514       ,output v-cntxt-db-num-obj
     2515       ,output v-cntxt-is-admin
     2516       ) .
     2517     v-rid-list = p-rid-list.
     2518     run Myenable in this-procedure .
     2519     WAIT-FOR GO OF FRAME Dialog-Frame.
     2520   END.
     2521   RUN disable_UI.
     2522   PROCEDURE disable_UI :
     2523     HIDE FRAME Dialog-Frame.
     2524   END PROCEDURE.
     2525   PROCEDURE enable_UI :
     2526     DISPLAY EDITOR-2 EDITOR-1 mark-num
     2527         WITH FRAME Dialog-Frame.
     2528     ENABLE b-quit b-mark b-sel b-chg b-lkp B-Help br-rule-by-call EDITOR-2
     2529            EDITOR-1 mark-num
     2530         WITH FRAME Dialog-Frame.
     2531     VIEW FRAME Dialog-Frame.
     2532     OPEN QUERY br-rule-by-call FOR EACH X_rule-by-call,        FIRST X_ruleset,        FIRST X_rule.
     2533   END PROCEDURE.
     2534   PROCEDURE MyEnable :
     2535   assign
     2536   X_rule.name:resizable in browse br-rule-by-call = yes
     2537   X_ruleset.name:resizable in browse br-rule-by-call = yes
     2538   X_ruleset.name:visible in browse br-rule-by-call = (p-list-mode <> "codex" and p-list-mode <> "ruleset")
     2539   X_rule.name:visible in browse br-rule-by-call = (p-list-mode <> "rule")
     2540   .
     2541   ENABLE
     2542   b-quit
     2543   b-chg WHEN (LOOKUP("b-add", bttns) > 0 AND v-cntxt-db-num = 0)
     2544   b-lkp
     2545   B-Help
     2546   b-mark when lookup("b-mark", bttns) > 0
     2547   b-sel when lookup("b-sel", bttns) > 0
     2548   br-rule-by-call
     2549   WITH FRAME Dialog-Frame.
     2550   VIEW FRAME Dialog-Frame.
     2551   run Openbr in this-procedure .
     2552   APPLY "VALUE-CHANGED" to br-rule-by-call.
     2553   END PROCEDURE.
     2554   PROCEDURE Openbr :
     2555   CASE p-list-mode:
     2556     WHEN 'все':U THEN DO:
     2557       frame Dialog-Frame :title = "Все вызовы всех правил".
     2558       OPEN QUERY br-rule-by-call
     2559       FOR EACH X_rule-by-call NO-LOCK
     2560         , FIRST X_ruleset NO-LOCK WHERE
     2561                 X_ruleset.codex_id = X_rule-by-call.codex_id
     2562             AND X_ruleset.ruleset_id = X_rule-by-call.ruleset_id
     2563         , FIRST X_rule NO-LOCK  where
     2564                 X_rule.RULE_id = X_rule.RULE_id
     2565       INDEXED-REPOSITION.
     2566     END.
     2567     WHEN "call_id" THEN DO:
     2568       frame Dialog-Frame :title = substitute("Вызовы правил в точке вызова &1", calldscr( p-call-id)).
     2569       if p-codex-id > 0 then do:
     2570         frame Dialog-Frame :title = substitute("&1: кодекс &2", frame Dialog-Frame :title, p-codex-id).
     2571       end.
     2572       if p-ruleset-id > 0 then do:
     2573         frame Dialog-Frame :title = substitute("&1: набор правил &2", frame Dialog-Frame :title, p-ruleset-id).
     2574       end.
     2575       if p-rule-id > 0 then do:
     2576         frame Dialog-Frame :title = substitute("&1: правило &2", frame Dialog-Frame :title, p-rule-id).
     2577       end.
     2578       OPEN QUERY br-rule-by-call
     2579       FOR EACH X_rule-by-call NO-LOCK where
     2580                X_rule-by-call.call_Id = p-call-Id
     2581            and (p-codex-id = 0 or X_rule-by-call.codex_id = p-codex-id)
     2582            and (p-ruleset-id = 0 or X_rule-by-call.ruleset_id = p-ruleset-id)
     2583            and (p-rule-id = 0 or X_rule-by-call.rule_id = p-rule-id)
     2584         , FIRST X_ruleset NO-LOCK WHERE
     2585                 X_ruleset.codex_id = X_rule-by-call.codex_id
     2586             AND X_ruleset.ruleset_id = X_rule-by-call.ruleset_id
     2587         , FIRST X_rule NO-LOCK  where
     2588                 X_rule.RULE_id = X_rule.RULE_id
     2589       INDEXED-REPOSITION.
     2590     END.
     2591     WHEN "ruleset" THEN DO:
     2592       frame Dialog-Frame :title = substitute("Вызовы правил для &1 набора правил &2", p-codex-id, p-ruleset-id).
     2593       OPEN QUERY br-rule-by-call
     2594       FOR EACH X_rule-by-call NO-LOCK WHERE
     2595                X_rule-by-call.codex_id = p-codex-id
     2596            AND X_rule-by-call.ruleset_id = p-codex-id
     2597           , FIRST X_ruleset NO-LOCK WHERE
     2598                   X_ruleset.codex_id = X_rule-by-call.codex_id
     2599               AND X_ruleset.ruleset_id = X_rule-by-call.ruleset_id
     2600           , FIRST X_rule NO-LOCK  where
     2601                   X_rule.RULE_id = X_rule.RULE_id
     2602           INDEXED-REPOSITION.
     2603     END.
     2604     WHEN "codex" THEN DO:
     2605       frame Dialog-Frame :title = substitute("Вызовы правил для кодекса правил &1", p-codex-id).
     2606       OPEN QUERY br-rule-by-call
     2607       FOR EACH X_rule-by-call NO-LOCK WHERE
     2608                X_rule-by-call.codex_id = p-codex-id
     2609           , FIRST X_ruleset NO-LOCK WHERE
     2610                   X_ruleset.codex_id = X_rule-by-call.codex_id
     2611               AND X_ruleset.ruleset_id = X_rule-by-call.ruleset_id
     2612           , FIRST X_rule NO-LOCK  where
     2613                   X_rule.RULE_id = X_rule.RULE_id
     2614           INDEXED-REPOSITION.
     2615     END.
     2616     WHEN "rule" THEN DO:
     2617       frame Dialog-Frame :title = substitute("Вызовы правила &1", p-rule-id).
     2618       OPEN QUERY br-rule-by-call
     2619       FOR EACH X_rule-by-call NO-LOCK WHERE
     2620               X_rule-by-call.rule_id = p-rule-id
     2621           , FIRST X_ruleset NO-LOCK WHERE
     2622                   X_ruleset.codex_id = X_rule-by-call.codex_id
     2623               AND X_ruleset.ruleset_id = X_rule-by-call.ruleset_id
     2624           , FIRST X_rule NO-LOCK  where
     2625                   X_rule.RULE_id = X_rule.RULE_id
     2626           INDEXED-REPOSITION.
     2627    END.
     2628   END CASE.
     2629   END PROCEDURE.
     2630   PROCEDURE proc-b-chg :
     2631   DEFINE VARIABLE v-rec AS RECID NO-UNDO.
     2632   run rul/rule-by-call-i.w ( input parparentproc
     2633                        ,input 'ИЗМЕНЕНИЕ':U
     2634                        ,input X_rule-by-call.CALL#_id
     2635                        ,input X_rule-by-call.codex_id
     2636                        ,input X_rule-by-call.ruleset_id
     2637                        ,input X_rule-by-call.order_id
     2638                        ,input-output v-rec) no-error.
     2639   if error-status:error then do:
     2640     undo, return error .
     2641   end.
     2642   run openbr in this-procedure .
     2643   reposition br-rule-by-call to recid v-rec no-error.
     2644   APPLY "ENTRY" to browse br-rule-by-call.
     2645   END PROCEDURE.
