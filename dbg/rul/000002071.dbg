     1894   for each buf_rule-call-param no-lock where
     1895   buf_rule-call-param.codex_id = p-codex-id
     1896   and buf_rule-call-param.ruleset_id = p-ruleset-id
     1897   and buf_rule-call-param.call_id = p-call-id
     1898   and buf_rule-call-param.order_id = p-order-id
     1899   and buf_rule-call-param.rule_id = p-rule-id
     1900   and buf_rule-call-param.param-name = "p-fields"
     1901   and buf_rule-call-param.p-index > 0
     1902   by buf_rule-call-param.p-index
     1903   :
     1904     v-order = v-order + (if v-order = '' then '' else chr(44)) + entry(2, buf_rule-call-param.param-value-character, ".").
     1905   end.
     1906   run write-log  in p-log-handle (
     1907                                    input 0
     1908                                  , "&DLine").
     1909   if p-ruleset-id = 223 then do:
     1910       run write-log-and-file in p-log-handle (             input 1           , input log-file-name           , input 1           , input substitute("Экспорт данных в файл &1", file-name)).
     1911     output stream Outstream to value(file-name).
     1912   end.
     1913   else do:
     1914       run write-log-and-file in p-log-handle (             input 1           , input log-file-name           , input 1           , input substitute("Подготовка данных для экспорта")).
     1915   end.
     1916   _stroka:
     1917   for each buf_contract-specif no-lock where
     1918           buf_contract-specif.host-code = v-current-host-code
     1919       and buf_contract-specif.contract-num = v-contract-code
     1920   on error  undo _stroka, retry
     1921   on stop   undo _stroka, retry
     1922   on endkey undo _stroka, retry
     1923   :
     1924     if retry then do:
     1925       my-mess = substitute("&1 (товар &2)", v-mess, buf_contract-specif.gds-code).
     1926           run write-log-and-file in p-log-handle (             input 1           , input log-file-name           , input 1           , input v-mess).
     1927       v-view-log = yes.
     1928       next _stroka.
     1929     end.
     1930     num-rec = num-rec + 1.
     1931     find first buf_goods no-lock where
     1932               buf_goods.gds-code = buf_contract-specif.gds-code no-error.
     1933     if not available buf_goods then do:
     1934       v-mess = substitute("Не найден товар с кодом &1!", buf_contract-specif.gds-code).
     1935       v-view-log = yes.
     1936       undo _stroka, retry _stroka.
     1937     end.
     1938     run read-bonus in this-procedure ( input buf_contract-specif.contract-num
     1939                                       , input buf_contract-specif.host-code
     1940                                       , input buf_contract-specif.gds-code
     1941                                       , output v-bonus
     1942                                       ) no-error .
     1943     if error-status:error then do:
     1944       v-mess = substitute("Ошибка при попытке получения значения бонуса!&1&2&1&4"
     1945                             ,chr(10)
     1946                             , error-status:get-message(1)
     1947                             , return-value
     1948                             ).
     1949       v-view-log = yes.
     1950       undo _stroka, retry _stroka.
     1951     end.
     1952     run read-prc-min in this-procedure ( input buf_contract-specif.contract-num
     1953                                       , input buf_contract-specif.host-code
     1954                                       , input buf_contract-specif.gds-code
     1955                                       , output v-prc-min
     1956                                       ) no-error .
     1957     if error-status:error then do:
     1958       v-mess = substitute("Ошибка при попытке получения значения % отклонения в меньшую сторону!&1&2&1&4"
     1959                             ,chr(10)
     1960                             , error-status:get-message(1)
     1961                             , return-value
     1962                             ).
     1963       v-view-log = yes.
     1964       undo _stroka, retry _stroka.
     1965     end.
     1966   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1967     (input  buf_contract-specif.gds-code
     1968     ,input  ?
     1969     ,output v-bar-code
     1970     ) no-error .
     1971     if error-status:error then do:
     1972       v-mess = substitute("Ошибка при попытке получения корневого бар-кода товара!&1&2&1&4"
     1973                             ,chr(10)
     1974                             , error-status:get-message(1)
     1975                             , return-value
     1976                             ).
     1977       v-view-log = yes.
     1978       undo _stroka, retry _stroka.
     1979     end.
     1980     find first buf_ext-artic where
     1981               buf_ext-artic.cli-type   = v-contract-cli-type
     1982           and buf_ext-artic.cli-code   = v-contract-cli-code
     1983           and buf_ext-artic.gds-code   = buf_contract-specif.gds-code
     1984           and buf_ext-artic.status_    <> 'удал':U no-error .
     1985     ASSIGN
     1986        v-cList-DopBK = "".
     1987     FOR EACH buf_prod-bc WHERE
     1988              buf_prod-bc.b-code = v-bar-code
     1989         NO-LOCK:
     1990         ASSIGN
     1991            v-cList-DopBK = v-cList-DopBK + (IF v-cList-DopBK = "" THEN "" ELSE "," ) + buf_prod-bc.b-str.
     1992     END.
     1993     FIND FIRST buf_Clients WHERE
     1994                buf_Clients.obj-type = buf_contract-specif.prod-type
     1995            AND buf_Clients.obj-code = buf_contract-specif.prod-code
     1996          NO-LOCK NO-ERROR.
     1997     create cntspcie.
     1998     assign
     1999     cntspcie.line-num = num-rec
     2000     cntspcie.artic  = buf_contract-specif.artic
     2001     cntspcie.prod-type  = buf_contract-specif.prod-type
     2002     cntspcie.prod-code  = buf_contract-specif.prod-code
     2003     cntspcie.price-cli  = buf_contract-specif.price-cli
     2004     cntspcie.prc        = buf_contract-specif.prc
     2005     cntspcie.qnty       = buf_contract-specif.qnty
     2006     cntspcie.cli-base-rate = buf_contract-specif.cli-base-rate
     2007     cntspcie.vat-type   = buf_contract-specif.vat-type
     2008     cntspcie.vat-pc     = buf_contract-specif.vat-pc
     2009     cntspcie.gds-name   = buf_goods.gds-name
     2010     cntspcie.qnty-cart  = buf_goods.qnty-cart
     2011     cntspcie.ext-artic  = (if available buf_ext-artic
     2012                             then buf_ext-artic.ext-artic
     2013                             else '')
     2014     cntspcie.price-sale = v-price-sale
     2015     cntspcie.b-str      = v-cList-DopBK
     2016     cntspcie.bonus      =  v-bonus
     2017     CntSpcIE.DeadLine   = buf_Goods.DeadLine
     2018     CntSpcIE.Obj-Name   = (IF AVAILABLE buf_Clients THEN buf_Clients.Obj-Name ELSE "" )
     2019     cntspcie.prc-min    = v-prc-min
     2020     .
     2021     if p-ruleset-id = 223 then do:
     2022       v-str = dyneximp_export  (
     2023                                 INPUT v-cntspcie
     2024                                 ,INPUT p-delimiter
     2025                                 ,input v-order
     2026                                 ,input ''
     2027                                 ) no-error.
     2028       if error-status:error then do:
     2029         v-mess = substitute("Строчка &1 не проэкспортирована!&2&3"
     2030                               ,num-rec
     2031                               ,chr(10)
     2032                               ,v-mess).
     2033         v-view-log = yes.
     2034         undo _stroka, retry _stroka.
     2035       end.
     2036       put stream outstream unformatted v-str skip.
     2037       num-rec-ok = num-rec-ok + 1.
     2038       run show-counter in p-log-handle .
     2039       run write-counter in p-log-handle (substitute("Просмотрено &1 из них экспортировано &2"
     2040                                                   , num-rec
     2041                                                   , num-rec-ok
     2042                                                   )) no-error.
     2043       delete cntspcie.
     2044       run get-stop-state in p-log-handle (
     2045           output v-stop
     2046       ).
     2047       if v-stop then do:
     2048         leave _stroka.
     2049       end.
     2050     end.
     2051     else do:
     2052       release cntspcie.
     2053     end.
     2054   end.
     2055   if v-stop then do:
     2056       run write-log-and-file in p-log-handle (             input 1           , input log-file-name           , input 1           , input v-mess).
     2057     v-view-log = yes.
     2058   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2059   if v-view-log
     2060   and not g#news
     2061   and not g#auto
     2062   then do:
     2063     message
     2064     '!!!При экспорте информации произошли ошибки!!!'  skip
     2065     "!!!Внимательно прочитайте Log-file!!"
     2066     view-as alert-box error .
     2067        define variable v-user-action37   as character no-undo .
     2068     define variable v-printed37       as logical   no-undo .
     2069     run gbl/prnfilen.w
     2070       (input  ('!!!При экспорте информации произошли ошибки!!!')
     2071       ,input  0
     2072       ,input  (string("./":U) + 'process-edoc.txt')
     2073       ,input  7
     2074       ,output v-user-action37
     2075       ,output v-printed37
     2076       ) .
     2077   end.
     2078   if v-view-log = true
     2079   and (g#news
     2080   or g#auto)
     2081   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
     2082   then do:
     2083      run cb_set-view-log in p-parent-handle ( input yes).
     2084   end.
     2085   if not v-view-log and search("cdviewlg_do-not-delete-log-file.txt") = ? then do:
     2086     OS-DELETE value(string("./":U) + 'process-edoc.txt').
     2087   end.
     2088                           return.
     2089   end.
     2090   if p-ruleset-id = 223 then do:
     2091     output stream Outstream close.
     2092       run write-log-and-file in p-log-handle (             input 1           , input log-file-name           , input 1           , input substitute("Запись данных в файл &1 завершена: из &2 записей успешно записано &3"                         , file-name                         , num-rec                           , num-rec-ok                         )).
     2093   end.
     2094   num-rec = 0.
     2095   if p-ruleset-id = 225 then do:
     2096     run dyneximp_export-excel in this-procedure (
     2097                                                 input file-name
     2098                                                ,input p-start-row
     2099                                                ,input v-cntspcie
     2100                                                ,input v-order
     2101                                                ,input ''
     2102                                                ,input this-procedure:handle
     2103                                                ,input "cb_err"
     2104                                                ,output num-rec
     2105                                                ,output num-rec-ok
     2106                                                ) no-error.
     2107     output stream Outstream close.
     2108       run write-log-and-file in p-log-handle (             input 1           , input log-file-name           , input 1           , input substitute("Запись данных в файл &1 завершена: из &2 записей успешно записано &3"                         , file-name                         , num-rec                           , num-rec-ok                         )).
     2109   end.
     2110   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2111   if v-view-log
     2112   and not g#news
     2113   and not g#auto
     2114   then do:
     2115     message
     2116     '!!!При экспорте информации произошли ошибки!!!'  skip
     2117     "!!!Внимательно прочитайте Log-file!!"
     2118     view-as alert-box error .
     2119        define variable v-user-action39   as character no-undo .
     2120     define variable v-printed39       as logical   no-undo .
     2121     run gbl/prnfilen.w
     2122       (input  ('!!!При экспорте информации произошли ошибки!!!')
     2123       ,input  0
     2124       ,input  (string("./":U) + 'process-edoc.txt')
     2125       ,input  7
     2126       ,output v-user-action39
     2127       ,output v-printed39
     2128       ) .
     2129   end.
     2130   if v-view-log = true
     2131   and (g#news
     2132   or g#auto)
     2133   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
     2134   then do:
     2135      run cb_set-view-log in p-parent-handle ( input yes).
     2136   end.
     2137   if not v-view-log and search("cdviewlg_do-not-delete-log-file.txt") = ? then do:
     2138     OS-DELETE value(string("./":U) + 'process-edoc.txt').
     2139   end.
     2140                           return.
     2141   procedure load-ruleset-context :
     2142   define input parameter p-ruleset-id as integer no-undo .
     2143   define buffer buf_rule-call-param for tt0-rule-call-param.
     2144   define buffer buf_contract for ub.contract.
     2145   do
     2146   on error undo, return error
     2147   :
     2148     find first buf_rule-call-param no-lock where
     2149   buf_rule-call-param.codex_id = p-codex-id
     2150   and buf_rule-call-param.ruleset_id = p-ruleset-id
     2151   and buf_rule-call-param.call_id = p-call-id
     2152   and buf_rule-call-param.order_id = p-order-id
     2153   and buf_rule-call-param.rule_id = p-rule-id
     2154   and buf_rule-call-param.param-name = "p-delimiter"
     2155    no-error.
     2156   if available buf_rule-call-param then do:
     2157   assign p-delimiter = buf_rule-call-param.param-value-character.
     2158   end.
     2159     find first buf_rule-call-param no-lock where
     2160   buf_rule-call-param.codex_id = p-codex-id
     2161   and buf_rule-call-param.ruleset_id = p-ruleset-id
     2162   and buf_rule-call-param.call_id = p-call-id
     2163   and buf_rule-call-param.order_id = p-order-id
     2164   and buf_rule-call-param.rule_id = p-rule-id
     2165   and buf_rule-call-param.param-name = "p-start-row"
     2166    no-error.
     2167   if available buf_rule-call-param then do:
     2168   assign p-start-row = buf_rule-call-param.param-value-integer.
     2169   end.
     2170       case p-ruleset-id:
     2171         when 223
     2172         or
     2173         when 225
     2174         then do:
     2175           assign
     2176           v-current-host-code = p-host-code
     2177           v-contract-code = integer(p-doc-code)
     2178           file-name  = p-process-file-name
     2179           .
     2180           find first buf_contract exclusive-lock where
     2181                     buf_contract.host-code = v-current-host-code
     2182                 and buf_contract.contract-code = v-contract-code no-error.
     2183           if not available  buf_contract then do:
     2184              undo, return error substitute("Не найден договор № &1 (по фирме &2)", v-contract-code, v-current-host-code).
     2185           end.
     2186           assign
     2187           v-contract-cli-type = buf_contract.cli-type
     2188           v-contract-cli-code = buf_contract.cli-code
     2189           .
     2190         end.
     2191         otherwise do:
     2192         end.
     2193       end case.
     2194       assign
     2195       file-name            = p-process-file-name
     2196       .
     2197   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2198   define variable varscales-pref-type40 as character no-undo.
     2199   varscales-pref  = ?.
     2200   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     2201     (input  'sclspref':u
     2202     ,input  '':u
     2203     ,input  '':u
     2204     ,input  0
     2205     ,input  '':u
     2206     ,input  '':u
     2207     ,input  '':u
     2208     ,input  no
     2209     ,output varscales-pref
     2210     ,output varscales-pref-type40
     2211     ) no-error .
     2212   if varscales-pref = ? then do:
     2213     assign
     2214     varscales-pref = '21,23,25':U.
     2215   end.
     2216   define variable varpgscales-pref-type40 as character no-undo.
     2217   varpgscales-pref  = ?.
     2218   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     2219     (input  'scpgpref':u
     2220     ,input  '':u
     2221     ,input  '':u
     2222     ,input  0
     2223     ,input  '':u
     2224     ,input  '':u
     2225     ,input  '':u
     2226     ,input  no
     2227     ,output varpgscales-pref
     2228     ,output varpgscales-pref-type40
     2229     ) no-error .
     2230   if varpgscales-pref = ? then do:
     2231     assign
     2232     varpgscales-pref = '24IIIIIQQ000C,28IIIIIQQQ00C':U.
     2233   end.
     2234     end.
     2235   end procedure.
     2236   procedure cb_err :
     2237   define input parameter p-err-mess as character no-undo .
     2238   do
     2239   on error undo, return error
     2240   :
     2241       run write-log-and-file in p-log-handle (             input 1           , input log-file-name           , input 1           , input p-err-mess).
     2242     v-view-log = yes.
     2243   end.
     2244   end procedure.
