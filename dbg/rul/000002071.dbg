     1727                                   , entry(v-ii, p-order)
     1728                                   ).
     1729         end.
     1730         case v-fh:data-type:
     1731           when 'character':U then do:
     1732             assign
     1733             v-fh:buffer-value =  v-text
     1734             no-error
     1735             .
     1736           end.
     1737           when 'date':U then do:
     1738             assign
     1739             v-dop = replace(v-text, v-excel-date-separ, chr(47))
