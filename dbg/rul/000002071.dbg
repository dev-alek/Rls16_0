     1550     end.
     1551     else do:
     1552       v-num-fields = num-entries(p-order) .
     1553       if v-num-fields > p-bh:num-fields then do:
     1554         return error  substitute("В переданной последовательности полей &1 число полей больше, чем в таблице &2, буффер которой передан"
     1555                                 , p-order
     1556                                 , p-bh:name
     1557                                 ).
     1558       end.
     1559     end.
     1560     if p-line-num-field <> '' then do:
     1561       assign
     1562       v-lnfh = p-bh:buffer-field(p-line-num-field)
     1563       no-error .
     1564       if not valid-handle(v-lnfh) then do:
     1565         return error substitute("Нет поля &1 в таблице &2, буфер которой передан", p-line-num-field, p-bh:name).
     1566       end.
     1567     end.
     1568     create "Excel.Application" chExcelApplication no-error.
     1569       if error-status :error then do:
     1570           message
