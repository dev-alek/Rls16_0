     1472           no-error
     1473           .
     1474           if error-status:error then do:
     1475             run value(p-err-proc) in p-call-handle ( input substitute("Ошибка при импорте поля &1 (&5) из строки &2:&3&4"
     1476                                             , v-fh:column-label
