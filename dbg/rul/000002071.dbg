     1746                                          ,integer(entry(2, v-dop, chr(47)))
     1747                                          ,integer(entry(3, v-dop, chr(47)))
     1748                                          )
     1749                 no-error
     1750                 .
     1751               end.
     1752               when string(1) then do:
     1753                 assign
     1754                 v-fh:buffer-value =  date(integer(entry(2, v-dop, chr(47)))
     1755                                          ,integer(entry(1, v-dop, chr(47)))
     1756                                          ,integer(entry(3, v-dop, chr(47)))
     1757                                          )
     1758                 no-error
     1759                 .
     1760               end.
     1761               when string(2) then do:
     1762                 assign
     1763                 v-fh:buffer-value =  date(integer(entry(2, v-dop, chr(47)))
     1764                                          ,integer(entry(3, v-dop, chr(47)))
     1765                                          ,integer(entry(1, v-dop, chr(47)))
     1766                                          )
     1767                 no-error
     1768                 .
     1769               end.
     1770             end case.
     1771           end.
     1772           when 'decimal':U then do:
