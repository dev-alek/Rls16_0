     1706         else do:
     1707           assign
     1708           v-fh = p-bh:buffer-field(entry(v-ii, p-order))
     1709           no-error
     1710           .
     1711         end.
     1712         if error-status:error
     1713         or not valid-handle(v-fh) then do:
     1714   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
