      652   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      653   PROCEDURE write-bonus :
      654   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
      655   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
      656   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
      657   define input  parameter v-bonus as decimal   no-undo .
      658     do
      659     on error undo, return error return-value
      660     :
      661       find first ub.contract-specif-attr exclusive-lock  where
      662                  ub.contract-specif-attr.contract-num = p-contract-num  and
      663                  ub.contract-specif-attr.host-code    = p-host-code     and
      664                  ub.contract-specif-attr.gds-code     = p-gds-code      and
      665                  ub.contract-specif-attr.attr-code    = 'bonus':U
      666                 no-error .
      667         if not available ub.contract-specif-attr then do:
      668            create ub.contract-specif-attr .
      669            assign
      670                 ub.contract-specif-attr.contract-num = p-contract-num
      671                 ub.contract-specif-attr.host-code    = p-host-code
      672                 ub.contract-specif-attr.gds-code     = p-gds-code
      673                 ub.contract-specif-attr.attr-code    = 'bonus':U
      674            .
      675         end.
      676         ub.contract-specif-attr.attr-value  = string (v-bonus) .
      677   end.
      678   END PROCEDURE.
      679   PROCEDURE read-bonus :
      680   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
      681   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
      682   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
      683   define output parameter v-bonus as decimal   no-undo .
      684     do
      685     on error undo, return error return-value
      686     :
      687   find first ub.contract-specif-attr no-lock  where
      688              ub.contract-specif-attr.contract-num = p-contract-num  and
      689              ub.contract-specif-attr.host-code    = p-host-code     and
      690              ub.contract-specif-attr.gds-code     = p-gds-code      and
      691              ub.contract-specif-attr.attr-code    = 'bonus':U
      692              no-error .
      693      if available ub.contract-specif-attr then  v-bonus = decimal (ub.contract-specif-attr.attr-value ) .
      694                                           else  v-bonus = 0 .
      695   end.
      696   END PROCEDURE.
      697   PROCEDURE write-prc-min :
      698   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
      699   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
      700   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
      701   define input  parameter v-prc-min        as decimal   no-undo .
      702     do
      703     on error undo, return error return-value
      704     :
      705       find first ub.contract-specif-attr exclusive-lock  where
      706                 ub.contract-specif-attr.contract-num = p-contract-num  and
      707                 ub.contract-specif-attr.host-code    = p-host-code     and
      708                 ub.contract-specif-attr.gds-code     = p-gds-code      and
      709                 ub.contract-specif-attr.attr-code    = 'prc-min':U
      710                 no-error .
      711         if not available ub.contract-specif-attr then do:
      712            create ub.contract-specif-attr .
      713            assign
      714                 ub.contract-specif-attr.contract-num = p-contract-num
      715                 ub.contract-specif-attr.host-code    = p-host-code
      716                 ub.contract-specif-attr.gds-code     = p-gds-code
      717                 ub.contract-specif-attr.attr-code    = 'prc-min':U
      718                 ub.contract-specif-attr.attr-value  = string (v-prc-min)
      719            .
      720         end.
      721         else do:
      722            ub.contract-specif-attr.attr-value  = string (v-prc-min) .
      723         end.
      724       find first ub.contract-specif exclusive-lock where
      725           ub.contract-specif.contract-num = p-contract-num and
      726           ub.contract-specif.host-code    = p-host-code    and
      727           ub.contract-specif.gds-code     = p-gds-code.
      728           ub.contract-specif.whole-send-news  = ub.contract-specif.whole-send-news + 1.
      729   end.
      730   END PROCEDURE.
      731   PROCEDURE read-prc-min :
      732   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
      733   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
      734   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
      735   define output parameter v-prc-min as decimal   no-undo .
      736     do
      737     on error undo, return error return-value
      738     :
      739   find first ub.contract-specif-attr no-lock  where
      740              ub.contract-specif-attr.contract-num = p-contract-num  and
      741              ub.contract-specif-attr.host-code    = p-host-code     and
      742              ub.contract-specif-attr.gds-code     = p-gds-code      and
      743              ub.contract-specif-attr.attr-code    = 'prc-min':U
      744              no-error .
      745      if available ub.contract-specif-attr then  v-prc-min = decimal (ub.contract-specif-attr.attr-value ) .
      746                                           else  v-prc-min = 0 .
      747   end.
      748   END PROCEDURE.
      749   PROCEDURE write-retro-bonus :
      750   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
      751   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
      752   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
      753   define input  parameter v-retro-bonus as character   no-undo .
      754     do
      755     on error undo, return error return-value
      756     :
      757       find first ub.contract-specif-attr exclusive-lock  where
      758                 ub.contract-specif-attr.contract-num = p-contract-num  and
      759                 ub.contract-specif-attr.host-code    = p-host-code     and
      760                 ub.contract-specif-attr.gds-code     = p-gds-code      and
      761                 ub.contract-specif-attr.attr-code    = "retro-bonus"
      762                 no-error .
      763         if not available ub.contract-specif-attr then do:
      764            create ub.contract-specif-attr .
      765            assign
      766                 ub.contract-specif-attr.contract-num = p-contract-num
      767                 ub.contract-specif-attr.host-code    = p-host-code
      768                 ub.contract-specif-attr.gds-code     = p-gds-code
      769                 ub.contract-specif-attr.attr-code    = "retro-bonus"
      770            .
      771            ub.contract-specif-attr.attr-value  = v-retro-bonus no-error.
      772            if error-status:error then
      773               message "Превышен допустимый объем информации о ретро-бонусах. Удалите исторические или неактуальны периоды" view-as alert-box error.
      774         end.
      775         else do:
      776            ub.contract-specif-attr.attr-value  = v-retro-bonus no-error.
      777            if error-status:error then
      778               message "Превышен допустимый объем информации о ретро-бонусах. Удалите исторические или неактуальны периоды" view-as alert-box error.
      779         end.
      780       find first ub.contract-specif exclusive-lock where
      781           ub.contract-specif.contract-num = p-contract-num and
      782           ub.contract-specif.host-code    = p-host-code    and
      783           ub.contract-specif.gds-code     = p-gds-code.
      784           ub.contract-specif.whole-send-news  = ub.contract-specif.whole-send-news + 1.
      785   end.
      786   END PROCEDURE.
      787   PROCEDURE read-retro-bonus :
      788   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
      789   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
      790   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
      791   define output parameter v-retro-bonus as character   no-undo .
      792     do
      793     on error undo, return error return-value
      794     :
      795   find first ub.contract-specif-attr no-lock  where
      796              ub.contract-specif-attr.contract-num = p-contract-num  and
      797              ub.contract-specif-attr.host-code    = p-host-code     and
      798              ub.contract-specif-attr.gds-code     = p-gds-code      and
      799              ub.contract-specif-attr.attr-code    = "retro-bonus"
      800              no-error .
      801      if available ub.contract-specif-attr then  v-retro-bonus = ub.contract-specif-attr.attr-value  .
      802                                           else  v-retro-bonus = "" .
      803   end.
      804   END PROCEDURE.
      805   define variable file-name as character no-undo .
      806   define variable p-delimiter as character no-undo.
      807   define variable p-start-row as integer no-undo.
      808   define variable log-file-name                as character      no-undo init "process-edoc.txt".
      809   define variable v-view-log                   as logical        no-undo .
      810   define variable v-stop                       as logical        no-undo .
      811   define variable v-rid                        as recid          no-undo .
      812   define stream Outstream.
      813   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      814   FUNCTION dyneximp_export returns character (
      815                                                 INPUT p-bh  AS HANDLE
      816                                                ,INPUT p-delim   AS CHARACTER
      817                                                ,input p-order as character
      818                                                ,input p-except-field-list as character
      819                                                ):
      820   define variable v-fh    AS HANDLE no-undo .
      821   define variable v-ii    AS INTEGER no-undo .
      822   define variable iextnt  as integer no-undo .
      823   define variable v-char   as character no-undo .
      824   define variable carray  as character no-undo .
      825   define variable v-result as character no-undo .
      826   define variable v-num-fields as integer no-undo .
      827   if p-bh:type <> "buffer" then do:
      828     return ?.
      829   end.
      830   if p-order = '' then do:
      831     v-num-fields = p-bh:num-fields.
      832   end.
      833   else do:
      834     v-num-fields = num-entries(p-order).
      835     if v-num-fields > p-bh:num-fields then do:
      836       return ?.
      837     end.
      838   end.
      839   _do:
      840   do v-ii = 1 to v-num-fields:
      841     if p-order = '' then do:
      842       assign
      843       v-fh = p-bh:buffer-field(v-ii)
      844       no-error
      845       .
      846     end.
      847     else do:
      848       assign
      849       v-fh = p-bh:buffer-field(entry(v-ii, p-order))
      850       no-error
      851       .
      852     end.
      853     if error-status:error
      854     or not valid-handle(v-fh) then do:
      855     return ?.
      856     end.
      857     if lookup(v-fh:name, p-except-field-list) > 0 then next _do.
      858     if v-fh:extent = 0 then do:
      859       assign
      860       v-char = (if v-fh:buffer-value = ?
      861                 then chr(63)
      862                 else (if v-fh:data-type = 'character':U
      863                       then (if p-delim = chr(32)
      864                             then quoter(v-fh:buffer-value)
      865                             else string(v-fh:buffer-value))
      866                       else (if v-fh:data-type = 'raw':U
      867                             then ( if p-delim = chr(32)
      868                                    then (chr(34) + string(v-fh:buffer-value) + chr(34))
      869                                    else string(v-fh:buffer-value) )
      870                             else string(v-fh:buffer-value)
      871                             )
      872                      )
      873                 )
      874        v-result = (if v-ii = 1
      875                    then v-char
      876                    else v-result + p-delim + v-char)
      877        .
      878     end.
      879     else do:
      880       do iextnt = 1 to v-fh:extent:
      881         assign
      882         v-char = (if v-fh:buffer-value(iextnt) = ?
      883                   then chr(63)
      884                   else (if v-fh:data-type = 'character':U
      885                         then (if p-delim = chr(32)
      886                               then quoter(v-fh:buffer-value(iextnt))
      887                               else string(v-fh:buffer-value(iextnt))
      888                               )
      889                         else (if v-fh:data-type = 'raw':U
      890                              then (if p-delim = chr(32)
      891                                    then (chr(34) + string(v-fh:buffer-value(iextnt)) + chr(34))
      892                                    else string(v-fh:buffer-value(iextnt)))
      893                              else string(v-fh:buffer-value(iextnt))
      894                              )
      895                         )
      896                  )
      897         carray = (if iextnt = 1
      898                   then v-char
      899                  else carray + p-delim + v-char)
      900         .
      901       end.
      902       assign
      903       v-result = (if v-ii = 1
      904                   then carray
      905                  else v-result + p-delim + carray)
      906       .
      907     end.
      908   end.
      909   return v-result.
      910   end FUNCTION.
      911   procedure dyneximp_dump-import  :
      912   define input parameter p-bh as handle no-undo .
      913   define input parameter p-order as character no-undo .
      914   define input parameter p-except-field-list as character no-undo .
      915   define input parameter p-line-num-field as character no-undo .
      916   define input parameter p-call-handle as handle no-undo .
      917   define input parameter p-err-proc as character no-undo .
      918   define output parameter p-num-rec as integer no-undo .
      919   define output parameter p-num-rec-ok as integer no-undo .
      920   define variable v-import  as character   no-undo extent 512.
      921   define variable v-iimp    as integer     no-undo .
      922   define variable v-ii      as integer     no-undo .
      923   define variable v-iextnt    as integer     no-undo .
      924   define variable v-fh      as handle      no-undo .
      925   define variable v-result  as logical no-undo .
      926   define variable v-line-num as integer no-undo .
      927   define variable v-lnfh as handle no-undo .
      928   define variable glog as logical no-undo .
      929   define variable v-num-fields as integer no-undo .
      930   if p-bh:type <> "buffer" then do:
      931     return error substitute("Неверный тип handle передан процедуре").
      932   end.
      933   if p-line-num-field <> '' then do:
      934     assign
      935     v-lnfh = p-bh:buffer-field(p-line-num-field)
      936     no-error .
      937     if not valid-handle(v-lnfh) then do:
      938       return error substitute("Нет поля &1 в таблице &2, буфер которой передан", p-line-num-field, p-bh:name).
      939     end.
      940   end.
      941   if p-order = '' then do:
      942     v-num-fields = p-bh:num-fields.
      943   end.
      944   else do:
      945     v-num-fields = num-entries(p-order).
      946   end.
      947   if v-num-fields > p-bh:num-fields then do:
      948     return error substitute("В переданной последовательности полей &1 число полей больше, чем в таблице &2, буффер которой передан"
      949                              , p-order
      950                              , p-bh:name
      951                              ).
      952   end.
      953   _repeat:
      954   repeat:
      955     assign
      956     v-import = ""
      957     v-iimp = 0
      958     v-line-num = v-line-num + 1
      959     .
      960     import stream Outstream v-import.
      961     p-num-rec = p-num-rec + 1.
      962     p-bh:buffer-create().
      963     if valid-handle(v-lnfh) then do:
      964       v-lnfh:buffer-value = v-line-num.
      965     end.
      966     _do:
      967     do v-ii = 1 to v-num-fields:
      968       if p-order = '' then do:
      969         assign
      970         v-fh = p-bh:buffer-field(v-ii)
      971         no-error
      972         .
      973       end.
      974       else do:
      975         assign
      976         v-fh = p-bh:buffer-field(entry(v-ii, p-order))
      977         no-error
      978         .
      979       end.
      980       if error-status:error
      981       or not valid-handle(v-fh) then do:
      982         return error substitute("В переданной последовательности полей &1 указано несуществующее в таблице &2 поле &3"
      983                                 , p-order
      984                                 , p-bh:name
      985                                 , entry(v-ii, p-order)
      986                                 ).
      987       end.
      988       if lookup(v-fh:name, p-except-field-list) > 0 then next _do.
      989       if v-fh:extent = 0 then do:
      990         assign
      991         v-iimp = v-iimp + 1
      992         v-fh:buffer-value = v-import[v-iimp]
      993         no-error
      994         .
      995         if error-status:error then do:
      996           p-bh:buffer-delete().
      997           run value(p-err-proc) in p-call-handle ( input substitute("Ошибка при импорте поля &1 (&5) записи из строки &2&3&4"
      998                                                                   , v-fh:column-label
      999                                                                   , v-line-num
     1000                                                                   , chr(10)
     1001                                                                   , error-status:get-message(1)
     1002                                                                   , v-fh:name
     1003                                                                   )
     1004                                                                   )
     1005                                                                   .
     1006           next _repeat.
     1007         end.
     1008       end.
     1009       else do:
     1010         do v-iextnt = 1 to v-fh:extent:
     1011           assign
     1012           v-iimp = v-iimp + 1
     1013           v-fh:buffer-value(v-iextnt) = v-import[v-iimp]
     1014           no-error
     1015           .
     1016           if error-status:error then do:
     1017             p-bh:buffer-delete().
     1018             run value(p-err-proc) in p-call-handle ( input substitute("Ошибка при импорте поля &1 (&5) записи из строки &2&3&4"
     1019                                                                     , v-fh:column-label
     1020                                                                     , v-line-num
     1021                                                                     , chr(10)
     1022                                                                     , error-status:get-message(1)
     1023                                                                     , v-fh:name
     1024                                                                     )
     1025                                                                     )
     1026                                                                   .
     1027             next _repeat.
     1028           end.
     1029         end.
     1030       end.
     1031     end.
     1032     assign
     1033     glog = p-bh:buffer-validate()
     1034     no-error
     1035     .
     1036     if error-status:error then do:
     1037       p-bh:buffer-delete().
     1038       run value(p-err-proc) in p-call-handle ( substitute("Ошибка при импорте записи из строки &1&2&3"
     1039                                                   , v-line-num
     1040                                                   , chr(10)
     1041                                                   , error-status:get-message(1) )) no-error .
     1042       next _repeat.
     1043     end.
     1044     p-num-rec-ok = p-num-rec-ok + 1.
     1045   end.
     1046   end procedure.
     1047   function dyneximp_import returns logical (
     1048                                              input p-bh as handle
     1049                                             ,input p-delim as character
     1050                                             ,input p-str as character
     1051                                             ,input p-order as character
     1052                                             ,input p-except-field-list as character
     1053                                             ,output p-mes as character
     1054                                             ):
     1055   define variable v-entries as integer no-undo .
     1056   define variable v-num-fields as integer no-undo .
     1057   define variable v-except-fields as integer no-undo .
     1058   define variable v-ii as integer no-undo .
     1059   define variable v-fh as handle no-undo .
     1060   define variable v-iimp as integer no-undo .
     1061   define variable v-iextnt as integer no-undo .
     1062   define variable v-created as logical no-undo .
     1063   if p-bh:type <> "buffer" then do:
     1064     p-mes = "Для импорта передан handle неверного типа".
     1065     return no.
     1066   end.
     1067   if p-order = '' then do:
     1068     v-num-fields = p-bh:num-fields.
     1069   end.
     1070   else do:
     1071     v-num-fields = num-entries(p-order) .
     1072     if v-num-fields > p-bh:num-fields then do:
     1073       p-mes =  substitute("В переданной последовательности полей &1 число полей больше, чем в таблице &2, буффер которой передан"
     1074                               , p-order
     1075                               , p-bh:name
     1076                               ).
     1077       return no.
     1078     end.
     1079   end.
     1080   v-entries = num-entries(p-str, p-delim).
     1081   v-except-fields = (if p-except-field-list = '' then 0 else num-entries(p-except-field-list)).
     1082   if v-entries < v-num-fields - v-except-fields then do:
     1083     p-mes = substitute("Количество полей в строке импорта (&1) с учетом разделителя (&2) меньше количества выбранных полей (&3)"
     1084                        , num-entries(p-str, p-delim)
     1085                        , p-delim
     1086                        , v-num-fields
     1087                       )
     1088                      .
     1089     return no.
     1090   end.
     1091   if p-bh:available = no then do:
     1092     v-created = yes.
     1093     p-bh:buffer-create().
     1094   end.
     1095   do v-ii = 1 to v-num-fields:
     1096     if p-order = '' then do:
     1097       assign
     1098       v-fh = p-bh:buffer-field(v-ii)
     1099       no-error
     1100       .
     1101     end.
     1102     else do:
     1103       assign
     1104       v-fh = p-bh:buffer-field(entry(v-ii, p-order))
     1105       no-error
     1106       .
     1107     end.
     1108     if error-status:error
     1109     or not valid-handle(v-fh) then do:
     1110       p-mes = substitute("В переданной последовательности полей &1 указано несуществующее в таблице &2 поле &3"
     1111                               , p-order
     1112                               , p-bh:name
     1113                               , entry(v-ii, p-order)
     1114                               ).
     1115       if v-created then do:
     1116         p-bh:buffer-delete().
     1117       end.
     1118       return no.
     1119     end.
     1120     if v-fh:extent = 0 then do:
     1121       assign
     1122       v-iimp = v-iimp + 1
     1123       .
     1124       if v-iimp > v-entries - v-except-fields then do:
     1125         p-mes = substitute("Количество полей в строке импорта (&1) с учетом разделителя (&2) меньше количества выбранных полей (&3) "
     1126                           , num-entries(p-str, p-delim)
     1127                           , p-delim
     1128                           , v-num-fields
     1129                           )
     1130                             .
     1131         if v-created then do:
     1132           p-bh:buffer-delete().
     1133         end.
     1134         return no.
     1135       end.
     1136       assign
     1137       v-fh:buffer-value = entry(v-iimp, p-str, p-delim)
     1138       no-error
     1139       .
     1140       if error-status:error then do:
     1141         if v-created then do:
     1142           p-bh:buffer-delete().
     1143         end.
     1144         p-mes = substitute("Ошибка при импорте поля номер &1:&2&3"
     1145                            , v-iimp
     1146                            ,chr(10)
     1147                            , error-status:get-message(1) ).
     1148         return no.
     1149       end.
     1150     end.
     1151     else do:
     1152       do v-iextnt = 1 to v-fh:extent:
     1153         assign
     1154         v-iimp = v-iimp + 1
     1155         .
     1156         if v-iimp > v-entries - v-except-fields then do:
     1157           p-mes = substitute("Количество полей в строке импорта (&1) с учетом разделителя (&2) меньше количества выбранных полей (&3) "
     1158                             , num-entries(p-str, p-delim)
     1159                             , p-delim
     1160                             , v-num-fields
     1161                             )
     1162                               .
     1163           if v-created then do:
     1164             p-bh:buffer-delete().
     1165           end.
     1166           return no.
     1167         end.
     1168         assign
     1169         v-fh:buffer-value(v-iextnt) = entry(v-iimp, p-str, p-delim)
     1170         no-error
     1171         .
     1172         if error-status:error then do:
     1173           if v-created then do:
     1174             p-bh:buffer-delete().
     1175           end.
     1176           p-mes = substitute("Ошибка при импорте поля номер &1:&2&3"
     1177                             , v-iimp
     1178                             ,chr(10)
     1179                             , error-status:get-message(1) ).
     1180           return no.
     1181         end.
     1182       end.
     1183     end.
     1184   end.
     1185   return yes.
     1186   end function.
     1187   function dyneximp_excel-col-name returns character ( input p-col as integer):
     1188   define variable v-str as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWZYX".
     1189   return substring(v-str, p-col, 1).
     1190   end.
     1191   procedure dyneximp_export-excel :
     1192   define input parameter p-filename as character no-undo .
     1193   define input parameter p-start-row as integer no-undo .
     1194   define input parameter p-bh as handle no-undo .
     1195   define input parameter p-order as character no-undo .
     1196   define input parameter p-except-field-list as character no-undo .
     1197   define input parameter p-call-handle as handle no-undo .
     1198   define input parameter p-err-proc as character no-undo .
     1199   define output parameter p-num-rec as integer no-undo .
     1200   define output parameter p-num-rec-ok as integer no-undo .
     1201   define variable chExcelApplication as com-handle no-undo .
     1202   define variable chWorkbook         as com-handle no-undo .
     1203   define variable chWorksheet        as com-handle no-undo .
     1204   define variable chRange            as com-handle no-undo .
     1205   define variable v-last-row as integer no-undo .
     1206   define variable v-last-column as integer no-undo .
     1207   define variable v-row as integer no-undo .
     1208   define variable v-head-row as integer no-undo .
     1209   define variable v-num-fields as integer no-undo .
     1210   define variable v-ii as integer no-undo .
     1211   DEFINE VARIABLE v-dec-separ      as character no-undo .
     1212   DEFINE VARIABLE v-th-separ       as character no-undo .
     1213   define variable v-line-num as integer no-undo .
     1214   define variable v-lnfh as handle no-undo .
     1215   define variable v-fh as handle no-undo .
     1216   define variable v-text as character no-undo .
     1217   define variable v-dop as character no-undo .
     1218   define variable v-excel-general-format as character no-undo .
     1219   define variable v-excel-short-date as character no-undo .
     1220   define variable v-excel-dec-separ as character no-undo .
     1221   define variable v-excel-th-separ as character no-undo .
     1222   define variable v-excel-date-separ as character no-undo .
     1223   define variable v-qh as handle no-undo .
     1224   define variable v-print as logical no-undo .
     1225   main-block:
     1226   do
     1227   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1228   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1229   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1230   :
     1231     if p-bh:type <> "buffer" then do:
     1232       return error "Для экспорта передан handle неверного типа".
     1233     end.
     1234     if p-order = '' then do:
     1235       v-num-fields = p-bh:num-fields.
     1236     end.
     1237     else do:
     1238       v-num-fields = num-entries(p-order) .
     1239       if v-num-fields > p-bh:num-fields then do:
     1240         return error  substitute("В переданной последовательности полей &1 число полей больше, чем в таблице &2, буффер которой передан"
     1241                                 , p-order
     1242                                 , p-bh:name
     1243                                 ).
     1244       end.
     1245     end.
     1246     create "Excel.Application" chExcelApplication no-error.
     1247       if error-status :error then do:
     1248           message
     1249           "Ошибка при запуске Excel" skip
     1250           error-status :get-message(1) skip
     1251           view-as alert-box error .
     1252           undo, return error .
     1253       end.
     1254     assign
     1255     chExcelApplication:interactive     = false
     1256     chExcelApplication:ScreenUpdating  = false
     1257     chExcelApplication:visible         = false
     1258     chExcelApplication:DisplayAlerts   = false
     1259     .
     1260     assign
     1261     v-excel-general-format =  chExcelApplication:International(26  )
     1262     v-excel-short-date =  chExcelApplication:International(32  )
     1263     v-excel-dec-separ = chExcelApplication:International(3  )
     1264     v-excel-th-separ = chExcelApplication:International(4  )
     1265     v-excel-date-separ = chExcelApplication:International(17  )
     1266     no-error
     1267     .
     1268     v-head-row = maximum(p-start-row - 1, 0).
     1269     v-row = v-head-row - 1.
     1270     chExcelApplication:WorkBooks:Add().
     1271     chWorkbook = chExcelApplication:WorkBooks:Item(1).
     1272     chWorksheet = chWorkbook:ActiveSheet.
     1273     if v-head-row > 0 then do:
     1274       chWorkSheet:Rows(substitute("&1:&1", v-head-row)):Select.
     1275       chExcelApplication:Selection:Font:Bold = True.
     1276     end.
     1277     _row:
     1278     do while true
     1279     on error  undo _row, retry
     1280     on stop   undo _row, retry
     1281     on endkey undo _row, retry
     1282     :
     1283       if retry then do:
     1284   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1285   if valid-handle(chWorkSheet) then
     1286   RELEASE OBJECT chWorkSheet no-error.
     1287   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1288   if valid-handle(chWorkBook) then
     1289   RELEASE OBJECT chWorkBook no-error.
     1290         chExcelApplication:Quit() no-error.
     1291   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1292   if valid-handle(chExcelApplication) then
     1293   RELEASE OBJECT chExcelApplication no-error.
     1294         delete object v-qh no-error.
     1295         return error substitute("Ошибка при экспорте в файл &1:&2&3"
     1296                                 , p-filename
     1297                                 , chr(10)
     1298                                 , error-status:get-message(1)
     1299                                 ).
     1300       end.
     1301       v-row = v-row + 1.
     1302       if v-row > v-head-row then do:
     1303         p-num-rec = p-num-rec + 1.
     1304       end.
     1305       do v-ii = 1 to v-num-fields:
     1306         v-text = ''.
     1307         if p-order = '' then do:
     1308           assign
     1309           v-fh = p-bh:buffer-field(v-ii)
     1310           no-error
     1311           .
     1312         end.
     1313         else do:
     1314           assign
     1315           v-fh = p-bh:buffer-field(entry(v-ii, p-order))
     1316           no-error
     1317           .
     1318         end.
     1319         if error-status:error
     1320         or not valid-handle(v-fh) then do:
     1321   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1322   if valid-handle(chWorkSheet) then
     1323   RELEASE OBJECT chWorkSheet no-error.
     1324   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1325   if valid-handle(chWorkBook) then
     1326   RELEASE OBJECT chWorkBook no-error.
     1327           chExcelApplication:Quit() no-error.
     1328   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1329   if valid-handle(chExcelApplication) then
     1330   RELEASE OBJECT chExcelApplication no-error.
     1331           delete object v-qh.
     1332           return error substitute("В переданной последовательности полей &1 указано несуществующее в таблице &2 поле &3"
     1333                                   , p-order
     1334                                   , p-bh:name
     1335                                   , entry(v-ii, p-order)
     1336                                   ).
     1337         end.
     1338         if v-row = v-head-row then do:
     1339           if v-ii = 1 then do:
     1340             create query v-qh.
     1341             v-qh:set-buffers(p-bh).
     1342             v-qh:query-prepare( substitute(" for each &1 ", p-bh:name )) .
     1343             v-qh:query-open().
     1344           end.
     1345           if v-head-row > 0 then do:
     1346             assign
     1347             chWorkSheet:range( substitute("&1&2", dyneximp_excel-col-name(v-ii), v-head-row)):value = v-fh:column-label
     1348             no-error
     1349             .
     1350           end.
     1351           chWorkSheet:Columns( substitute("&1:&1", dyneximp_excel-col-name(v-ii), dyneximp_excel-col-name(v-ii))):Select.
     1352           case v-fh:data-type:
     1353             when 'character':U then do:
     1354               chExcelApplication:Selection:NumberFormat = "@".
     1355             end.
     1356             when 'date':U then do:
     1357               case v-excel-short-date:
     1358                 when string(0) then do:
     1359                   chExcelApplication:Selection:NumberFormat = substitute("mm&1dd&1yyyy", v-excel-date-separ).
     1360                 end.
     1361                 when string(1) then do:
     1362                   chExcelApplication:Selection:NumberFormat = substitute("dd&1mm&1yyyy", v-excel-date-separ).
     1363                 end.
     1364                 when string(2) then do:
     1365                   chExcelApplication:Selection:NumberFormat = substitute("yyyy&1mm&1dddd", v-excel-date-separ).
     1366                 end.
     1367               end case.
     1368             end.
     1369             when 'decimal':U then do:
     1370               chExcelApplication:Selection:NumberFormat = replace(substitute("0.&1"
     1371                                                                             , fill(string(0), length(entry(2, v-fh:format, ".")))
     1372                                                                             ), ".", v-excel-dec-separ).
     1373             end.
     1374             when 'integer':U then do:
     1375               chExcelApplication:Selection:NumberFormat = "0".
     1376             end.
     1377             when 'logical':U then do:
     1378               chExcelApplication:Selection:NumberFormat = "@".
     1379             end.
     1380           end case.
     1381         end.
     1382         else do:
     1383           if v-ii = 1 then do:
     1384             v-qh:get-next() no-error.
     1385             if v-qh:query-off-end then do:
     1386               p-num-rec = p-num-rec - 1.
     1387               leave _row.
     1388             end.
     1389           end.
     1390           v-print = yes.
     1391           case v-fh:data-type:
     1392             when 'character':U then do:
     1393               if v-fh:buffer-value = ? then do:
     1394                 v-text = chr(63).
     1395               end.
     1396               else do:
     1397                 assign
     1398                 v-text = v-fh:buffer-value
     1399                 .
     1400               end.
     1401             end.
     1402             when 'date':U then do:
     1403               if v-fh:buffer-value = ? then do:
     1404                 v-print = no.
     1405               end.
     1406               else do:
     1407                 assign
     1408                 v-dop = string(v-fh:buffer-value, "99/99/9999")
     1409                 .
     1410                 case v-excel-short-date:
     1411                   when string(0) then do:
     1412                     assign
     1413                     v-text = v-dop.
     1414                   end.
     1415                   when string(1) then do:
     1416                     assign
     1417                     v-text = entry(2, v-dop, chr(47)) + chr(47) +
     1418                             entry(1, v-dop, chr(47)) + chr(47) +
     1419                             entry(3, v-dop, chr(47))
     1420                     no-error
     1421                     .
     1422                   end.
     1423                   when string(2) then do:
     1424                     assign
     1425                     v-text = entry(3, v-dop, chr(47)) + chr(47) +
     1426                             entry(1, v-dop, chr(47)) + chr(47) +
     1427                             entry(2, v-dop, chr(47))
     1428                     no-error
     1429                     .
     1430                   end.
     1431                 end case.
     1432               end.
     1433             end.
     1434             when 'decimal':U then do:
     1435               if v-fh:buffer-value = ? then do:
     1436                 v-print = no.
     1437               end.
     1438               else do:
     1439                 assign
     1440                 v-dop = string(v-fh:buffer-value)
     1441                 v-text = replace(v-dop, ".", chr(1))
     1442                 v-text = replace(v-dop, ",", chr(2))
     1443                 v-text = replace(v-dop, chr(1), v-excel-dec-separ)
     1444                 v-text = replace(v-dop, chr(2), v-excel-th-separ)
     1445                 .
     1446               end.
     1447             end.
     1448             when 'integer':U then do:
     1449               if v-fh:buffer-value = ? then do:
     1450                 v-print = no.
     1451               end.
     1452               else do:
     1453                 assign
     1454                 v-text = string(v-fh:buffer-value)
     1455                 .
     1456               end.
     1457             end.
     1458             when 'logical':U then do:
     1459               if v-fh:buffer-value = ? then do:
     1460                 v-print = no.
     1461               end.
     1462               assign
     1463               v-text = string(v-fh:buffer-value, "true/false")
     1464               no-error
     1465               .
     1466             end.
     1467           end case.
     1468         end.
     1469         if v-print then do:
     1470           assign
