     1270   PROCEDURE rcps_fill-table :
     1271   define input parameter p-clear-params as logical no-undo .
     1272   if p-clear-params then do:
     1273   FOR EACH tt-rule-call-param:
     1274       DELETE tt-rule-call-param.
     1275   END.
     1276   end.
     1277    FOR EACH tt0-rule-call-param:
     1278      IF p-mode <> 'ДОБАВЛЕНИЕ':U THEN DO:
     1279        IF p-call-id <> '':U and p-call-id <> tt0-rule-call-param.call_id THEN do:
     1280           NEXT.
     1281        end.
     1282        IF p-codex-id <> 0 and p-codex-id <> tt0-rule-call-param.codex_id THEN do:
     1283          NEXT.
     1284        end.
     1285        IF p-ruleset-id <> 0 and p-ruleset-id <> tt0-rule-call-param.ruleset_id THEN do:
     1286          NEXT.
     1287        end.
     1288        IF p-rule-id <> 0 and p-rule-id <> tt0-rule-call-param.RULE_id THEN do:
     1289          NEXT.
     1290        end.
     1291        IF p-order-id <> ? and p-order-id <> tt0-rule-call-param.order_id THEN do:
     1292          NEXT.
     1293        end.
     1294      END.
     1295      if lookup("hidden", tt0-rule-call-param.param-3-data-type) > 0 then do:
     1296        next.
     1297      end.
     1298      IF p-list-mode = 'rp-rule-param':U
     1299      or p-list-mode = 'rp-rule-param':U  + chr(44) + 'все':U
     1300      THEN DO:
     1301         IF p-profile-id <> 0 AND p-profile-id <> tt0-rule-call-param.profile_id THEN do:
     1302           NEXT.
     1303         end.
     1304         IF p-once-more <> ? AND p-once-more <> tt0-rule-call-param.once-more THEN do:
     1305           NEXT.
     1306         end.
     1307      END.
     1308      CREATE tt-rule-call-param.
     1309      BUFFER-COPY tt0-rule-call-param TO tt-rule-call-param.
     1310   END.
     1311   END PROCEDURE.
     1312   procedure rcps_get-value :
     1313   DEFINE INPUT PARAMETER p-rp-param-name AS CHARACTER NO-UNDO.
     1314   DEFINE INPUT-output PARAMETER pp-index AS integer NO-UNDO.
     1315   DEFINE output parameter p-value-character AS CHARACTER NO-UNDO.
     1316   DEFINE output parameter p-value-date AS date NO-UNDO.
     1317   DEFINE output parameter p-value-decimal AS decimal NO-UNDO.
     1318   DEFINE output parameter p-value-integer AS integer NO-UNDO.
     1319   DEFINE output parameter p-value-logical AS logical NO-UNDO.
     1320   define variable v-current-index as integer no-undo init -1.
     1321   define variable v-start as logical no-undo init yes.
     1322   DEFINE BUFFER buf_ruledict-param FOR ub.ruledict-param.
     1323   DEFINE BUFFER buf_rp-rule-param FOR ub.rp-rule-param.
     1324   DEFINE BUFFER buf_tt-rule-call-param FOR tt-rule-call-param.
     1325   DEFINE BUFFER buf_term_tt-rule-call-param FOR tt-rule-call-param.
     1326   do
     1327   on error undo, return error
     1328   :
     1329   FOR FIRST buf_rp-rule-param WHERE
     1330         buf_rp-rule-param.profile_id = p-profile-id
     1331     AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     1332   , each buf_tt-rule-call-param WHERE
     1333      buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     1334   AND buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     1335   AND buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     1336   AND buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     1337   AND buf_tt-rule-call-param.p-index >= pp-index
     1338    ,each buf_term_tt-rule-call-param where
     1339          buf_term_tt-rule-call-param.call_id = buf_tt-rule-call-param.call_id
     1340      and buf_term_tt-rule-call-param.codex_id = buf_tt-rule-call-param.codex_id
     1341      and buf_term_tt-rule-call-param.ruleset_id = buf_tt-rule-call-param.ruleset_id
     1342      and buf_term_tt-rule-call-param.order_id = buf_tt-rule-call-param.order_id
     1343      and buf_term_tt-rule-call-param.param-name = buf_tt-rule-call-param.param-name
     1344      and buf_term_tt-rule-call-param.p-index = buf_tt-rule-call-param.p-index
     1345     by buf_term_tt-rule-call-param.call_id
     1346     by buf_term_tt-rule-call-param.codex_id
     1347     by buf_term_tt-rule-call-param.ruleset_id
     1348     by buf_term_tt-rule-call-param.order_id
     1349     by buf_term_tt-rule-call-param.param-name
     1350     by buf_term_tt-rule-call-param.p-index :
     1351       if v-start
     1352       then do:
     1353         assign
     1354         pp-index = buf_term_tt-rule-call-param.p-index
     1355         p-value-character = buf_term_tt-rule-call-param.param-value-character
     1356         p-value-date      = buf_term_tt-rule-call-param.param-value-date
     1357         p-value-decimal   = buf_term_tt-rule-call-param.param-value-decimal
     1358         p-value-integer   = buf_term_tt-rule-call-param.param-value-integer
     1359         p-value-logical   = buf_term_tt-rule-call-param.param-value-logical
     1360         v-start = no
     1361         .
     1362       end.
     1363       else do:
     1364         if buf_term_tt-rule-call-param.p-index > pp-index then do:
     1365           v-current-index = buf_term_tt-rule-call-param.p-index.
     1366           leave.
     1367         end.
     1368             end.
     1369     end.
     1370     pp-index = v-current-index.
     1371   end.
     1372   end procedure.
     1373   PROCEDURE rcps_proc-b-add :
     1374   DEFINE INPUT PARAMETER p-rp-param-name AS CHARACTER NO-UNDO.
     1375   DEFINE INPUT PARAMETER p-index AS integer NO-UNDO.
     1376   define variable v-ind as integer no-undo .
     1377   define buffer buf_tt-rule-call-param for tt-rule-call-param.
     1378   define buffer buf0_tt-rule-call-param for tt-rule-call-param.
     1379   define buffer buf2_tt-rule-call-param for tt-rule-call-param.
     1380   define buffer buf_rp-rule-param for ub.rp-rule-param.
     1381   FOR FIRST buf_rp-rule-param WHERE
     1382             buf_rp-rule-param.profile_id = p-profile-id
     1383         AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     1384       , first buf0_tt-rule-call-param WHERE
     1385          buf0_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     1386      AND buf0_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     1387      AND buf0_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     1388      AND buf0_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name:
     1389     LEAVE.
     1390   END.
     1391   IF NOT AVAILABLE buf0_tt-rule-call-param THEN do:
     1392     BELL.
     1393     RETURN.
     1394   END.
     1395   for each buf_rp-rule-param where
     1396           buf_rp-rule-param.rp-param-name = p-rp-param-name
     1397       and buf_rp-rule-param.profile_id = p-profile-id,
     1398       first buf_tt-rule-call-param where
     1399           buf_tt-rule-call-param.call_id = buf0_tt-rule-call-param.call_id
     1400       and buf_tt-rule-call-param.profile_id = buf_rp-rule-param.profile_id
     1401       and buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     1402       and buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     1403       and buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     1404       and buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     1405       and buf_tt-rule-call-param.once-more = buf0_tt-rule-call-param.once-more
     1406       and buf_tt-rule-call-param.p-index = p-index:
     1407     RETURN.
     1408   END.
     1409   IF lookup("LIST", buf0_tt-rule-call-param.param-3-data-type) = 0
     1410   and lookup("SORTED-LIST", buf0_tt-rule-call-param.param-3-data-type) = 0
     1411   THEN DO:
     1412     BELL.
     1413     RETURN.
     1414   END.
     1415   IF buf0_tt-rule-call-param.p-index <> 0 THEN DO:
     1416     BELL.
     1417     RETURN.
     1418   END.
     1419   find last buf_tt-rule-call-param where
     1420            buf_tt-rule-call-param.call_id = buf0_tt-rule-call-param.call_id
     1421        and buf_tt-rule-call-param.codex_id = buf0_tt-rule-call-param.codex_id
     1422        and buf_tt-rule-call-param.ruleset_id = buf0_tt-rule-call-param.ruleset_id
     1423        and buf_tt-rule-call-param.order_id = buf0_tt-rule-call-param.order_id
     1424        and buf_tt-rule-call-param.param-name = buf0_tt-rule-call-param.param-name no-error .
     1425   if available buf_tt-rule-call-param
     1426   and (lookup("LIST", buf_tt-rule-call-param.param-3-data-type) > 0
     1427        or
     1428        lookup("SORTED-LIST", buf_tt-rule-call-param.param-3-data-type) > 0
     1429        )
     1430   and buf_tt-rule-call-param.p-index > 0 then do:
     1431     v-ind = buf_tt-rule-call-param.p-index.
     1432   end.
     1433   for each buf_rp-rule-param where
     1434           buf_rp-rule-param.rp-param-name = p-rp-param-name
     1435       and buf_rp-rule-param.profile_id = p-profile-id,
     1436       first buf_tt-rule-call-param where
     1437           buf_tt-rule-call-param.call_id = buf0_tt-rule-call-param.call_id
     1438       and buf_tt-rule-call-param.profile_id = buf_rp-rule-param.profile_id
     1439       and buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     1440       and buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     1441       and buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     1442       and buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     1443       and buf_tt-rule-call-param.once-more = buf0_tt-rule-call-param.once-more
     1444       and buf_tt-rule-call-param.p-index = 0
     1445   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1446   on stop   undo, return error substitute( "&1. stop", vss-workfile )
     1447   on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     1448   :
     1449     create buf2_tt-rule-call-param.
     1450     buffer-copy buf_tt-rule-call-param
     1451     except p-index
     1452     to buf2_tt-rule-call-param
     1453     assign
     1454     buf2_tt-rule-call-param.p-index = v-ind + 1
     1455     .
     1456   end.
     1457   END PROCEDURE.
     1458   PROCEDURE rcps_proc-b-del :
     1459   DEFINE INPUT PARAMETER p-rp-param-name AS CHARACTER NO-UNDO.
     1460   DEFINE INPUT PARAMETER pp-index AS integer NO-UNDO.
     1461   define variable v-ind as integer no-undo .
     1462   define variable v-once-more as integer no-undo .
     1463   define variable v-call-id as character no-undo .
     1464   define buffer buf0_tt-rule-call-param for tt-rule-call-param.
     1465   define buffer buf_tt-rule-call-param for tt-rule-call-param.
     1466   define buffer buf_rp-rule-param for ub.rp-rule-param.
     1467   if pp-index = 0 then do:
     1468     undo, return error substitute("Нельзя удалять корневой параметр &1 (индекс = 0)", p-rp-param-name).
     1469   end.
     1470   FOR first buf_rp-rule-param WHERE
     1471             buf_rp-rule-param.profile_id = p-profile-id
     1472         AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     1473       , first buf0_tt-rule-call-param WHERE
     1474          buf0_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     1475      AND buf0_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     1476      AND buf0_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     1477      AND buf0_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     1478      AND buf0_tt-rule-call-param.p-index = pp-index
     1479      :
     1480     LEAVE.
     1481   END.
     1482   IF NOT AVAILABLE buf0_tt-rule-call-param THEN do:
     1483     FOR first buf_rp-rule-param WHERE
     1484               buf_rp-rule-param.profile_id = p-profile-id
     1485           AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     1486         , last buf0_tt-rule-call-param WHERE
     1487           buf0_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     1488       AND buf0_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     1489       AND buf0_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     1490       AND buf0_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     1491       AND buf0_tt-rule-call-param.p-index > pp-index :
     1492       leave.
     1493     end.
     1494     IF NOT AVAILABLE buf0_tt-rule-call-param THEN do:
     1495     return "not-found".
     1496     end.
     1497     else do:
     1498       return ''.
     1499     end.
     1500   END.
     1501   IF lookup("LIST", buf0_tt-rule-call-param.param-3-data-type) = 0
     1502   and lookup("SORTED-LIST", buf0_tt-rule-call-param.param-3-data-type) = 0
     1503   THEN DO:
     1504     undo, return error substitute("Можно удалять только параметры типа LIST и SORTED-LIST").
     1505   END.
     1506   IF lookup("READ-ONLY", buf0_tt-rule-call-param.param-3-data-type) > 0 THEN DO:
     1507     undo, return error substitute("Нельзя удалять  параметры типа READ-ONLY").
     1508   END.
     1509   for each buf_rp-rule-param where
     1510           buf_rp-rule-param.rp-param-name = buf_rp-rule-param.rp-param-name
     1511       and buf_rp-rule-param.profile_id = buf_rp-rule-param.profile_id,
     1512       each buf_tt-rule-call-param where
     1513           buf_tt-rule-call-param.call_id = p-call-id
     1514       and buf_tt-rule-call-param.profile_id = buf_rp-rule-param.profile_id
     1515       and buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     1516       and buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     1517       and buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     1518       and buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     1519       and buf_tt-rule-call-param.once-more = p-once-more
     1520       and buf_tt-rule-call-param.p-index = pp-index
     1521   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1522   on stop   undo, return error substitute( "&1. stop", vss-workfile )
     1523   on endkey undo, return error substitute( "&1. endkey", vss-workfile ):
     1524       DELETE buf_tt-rule-call-param.
     1525   end.
     1526   return ''.
     1527   END PROCEDURE.
     1528   PROCEDURE rcps_proc-save0 :
     1529   FOR EACH tt-rule-call-param
     1530   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1531   on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1532   on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1533   :
     1534      find  FIRST tt0-rule-call-param NO-LOCK WHERE
     1535               tt0-rule-call-param.codex_id = tt-rule-call-param.codex_id
     1536          AND  tt0-rule-call-param.ruleset_id = tt-rule-call-param.ruleset_id
     1537          AND tt0-rule-call-param.call_id = tt-rule-call-param.call_id
     1538          AND tt0-rule-call-param.order_id = tt-rule-call-param.order_id
     1539          AND tt0-rule-call-param.param-name = tt-rule-call-param.param-name
     1540          AND tt0-rule-call-param.p-index = tt-rule-call-param.p-index no-error .
     1541      if not available tt0-rule-call-param
     1542      and (lookup("LIST", tt-rule-call-param.param-3-data-type) > 0
     1543           OR
     1544           lookup("SORTED-LIST", tt-rule-call-param.param-3-data-type) > 0
     1545           )
     1546      and tt-rule-call-param.p-index > 0 then do:
     1547        create tt0-rule-call-param.
     1548      end.
     1549      BUFFER-COPY tt-rule-call-param TO tt0-rule-call-param.
     1550   END.
     1551   FOR EACH tt0-rule-call-param
     1552   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1553   on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1554   on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1555   :
     1556     if tt0-rule-call-param.p-index = 0 then next.
     1557     if lookup("hidden", tt0-rule-call-param.param-3-data-type) > 0 then next.
     1558     find  FIRST tt-rule-call-param NO-LOCK WHERE
     1559             tt-rule-call-param.codex_id = tt0-rule-call-param.codex_id
     1560         AND tt-rule-call-param.ruleset_id = tt0-rule-call-param.ruleset_id
     1561         AND tt-rule-call-param.call_id = tt0-rule-call-param.call_id
     1562         AND tt-rule-call-param.order_id = tt0-rule-call-param.order_id
     1563         AND tt-rule-call-param.param-name = tt0-rule-call-param.param-name
     1564         AND tt-rule-call-param.p-index = tt0-rule-call-param.p-index no-error .
     1565     if not available tt-rule-call-param
     1566     and (lookup("LIST", tt0-rule-call-param.param-3-data-type) > 0
     1567         OR
     1568         lookup("SORTED-LIST", tt0-rule-call-param.param-3-data-type) > 0
     1569         )
     1570     and tt0-rule-call-param.p-index > 0
     1571     then do:
     1572        IF p-call-id <> '':U and p-call-id <> tt0-rule-call-param.call_id THEN do:
     1573           NEXT.
     1574        end.
     1575        IF p-codex-id <> 0 and p-codex-id <> tt0-rule-call-param.codex_id THEN do:
     1576          NEXT.
     1577        end.
     1578        IF p-ruleset-id <> 0 and p-ruleset-id <> tt0-rule-call-param.ruleset_id THEN do:
     1579          NEXT.
     1580        end.
     1581        IF p-rule-id <> 0 and p-rule-id <> tt0-rule-call-param.RULE_id THEN do:
     1582          NEXT.
     1583        end.
     1584        IF p-order-id <> ? and p-order-id <> tt0-rule-call-param.order_id THEN do:
     1585          NEXT.
     1586        end.
     1587       IF p-list-mode = 'rp-rule-param':U
     1588       or p-list-mode = 'rp-rule-param':U  + chr(44) + 'все':U
     1589       THEN DO:
     1590         IF p-profile-id <> 0 AND p-profile-id <> tt0-rule-call-param.profile_id THEN do:
     1591           NEXT.
     1592         end.
     1593         IF p-once-more <> ? AND p-once-more <> tt0-rule-call-param.once-more THEN do:
     1594           NEXT.
     1595         end.
     1596       end.
     1597       delete tt0-rule-call-param.
     1598     end.
     1599   end.
     1600   END PROCEDURE.
     1601   PROCEDURE rcps_set-value :
     1602   DEFINE INPUT PARAMETER p-rp-param-name AS CHARACTER NO-UNDO.
     1603   DEFINE INPUT PARAMETER pp-index AS integer NO-UNDO.
     1604   DEFINE INPUT parameter p-value-character AS CHARACTER NO-UNDO.
     1605   DEFINE INPUT parameter p-value-date AS date NO-UNDO.
     1606   DEFINE INPUT parameter p-value-decimal AS decimal NO-UNDO.
     1607   DEFINE INPUT parameter p-value-integer AS integer NO-UNDO.
     1608   DEFINE INPUT parameter p-value-logical AS logical NO-UNDO.
     1609   DEFINE VARIABLE v-codex-id AS integer NO-UNDO.
     1610   DEFINE VARIABLE v-ruleset-id AS integer NO-UNDO.
     1611   DEFINE VARIABLE v-order-id AS integer NO-UNDO.
     1612   DEFINE VARIABLE V-param-name AS character NO-UNDO.
     1613   define variable v-found as logical no-undo .
     1614   DEFINE BUFFER buf_tt-rule-call-param FOR tt-rule-call-param.
     1615   DEFINE BUFFER buf_rp-rule-param FOR ub.rp-rule-param.
     1616   FOR FIRST buf_rp-rule-param WHERE
     1617             buf_rp-rule-param.profile_id = p-profile-id
     1618         AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     1619       , first buf_tt-rule-call-param WHERE
     1620          buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     1621      AND buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     1622      AND buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     1623      AND buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name:
     1624     ASSIGN
     1625     v-codex-id = buf_tt-rule-call-param.codex_id
     1626     v-ruleset-id = buf_tt-rule-call-param.ruleset_id
     1627     v-order-id = buf_tt-rule-call-param.order_id
     1628     V-PARAM-NAME = buf_tt-rule-call-param.PARAM-NAME
     1629     .
     1630     LEAVE.
     1631   END.
     1632   CASE p-list-mode:
     1633     WHEN 'rp-rule-param':U THEN DO:
     1634       if pp-index > 0
     1635       then do:
     1636         FOR EACH  buf_rp-rule-param NO-LOCK where
     1637             buf_rp-rule-param.profile_id = p-profile-id
     1638             AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     1639             ,EACH buf_tt-rule-call-param WHERE
     1640                 buf_tt-rule-call-param.profile_id = p-profile-id
     1641             AND buf_tt-rule-call-param.once-more = p-once-more
     1642             AND buf_tt-rule-call-param.call_id = p-CALL-id
     1643             AND buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     1644             AND buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     1645             AND buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     1646             AND buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     1647             AND buf_tt-rule-call-param.p-index = pp-index
     1648         ON error undo, return error :
     1649           v-found = yes.
     1650         end.
     1651       end.
     1652       if not v-found then do:
     1653         run rcps_proc-b-add in this-procedure (
     1654                                                  input p-rp-param-name
     1655                                                 ,input pp-index).
     1656       end.
     1657       FOR EACH  buf_rp-rule-param NO-LOCK where
     1658           buf_rp-rule-param.profile_id = p-profile-id
     1659           AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     1660           ,EACH buf_tt-rule-call-param WHERE
     1661               buf_tt-rule-call-param.profile_id = p-profile-id
     1662           AND buf_tt-rule-call-param.once-more = p-once-more
     1663           AND buf_tt-rule-call-param.call_id = p-CALL-id
     1664           AND buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     1665           AND buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     1666           AND buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     1667           AND buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     1668           AND buf_tt-rule-call-param.p-index = pp-index
     1669         ON error undo, return error :
     1670         assign
     1671         buf_tt-rule-call-param.param-value-character = p-value-character
     1672         buf_tt-rule-call-param.param-value-date      = p-value-date
     1673         buf_tt-rule-call-param.param-value-decimal   = p-value-decimal
     1674         buf_tt-rule-call-param.param-value-integer   = p-value-integer
     1675         buf_tt-rule-call-param.param-value-logical   = p-value-logical
     1676         .
     1677       END.
     1678     END.
     1679     WHEN 'rule-call-param':U THEN DO:
     1680       FIND FIRST buf_tt-rule-call-param WHERE
     1681           buf_tt-rule-call-param.call_id = p-call-id
     1682       AND buf_tt-rule-call-param.codex_id = v-codex-id
     1683       AND buf_tt-rule-call-param.ruleset_id = v-ruleset-id
     1684       AND buf_tt-rule-call-param.order_id = v-order-id
     1685       AND buf_tt-rule-call-param.param-name = V-PARAM-NAME
     1686       AND buf_tt-rule-call-param.p-index = pp-index.
     1687       assign
     1688       buf_tt-rule-call-param.param-value-character = p-value-character
     1689       buf_tt-rule-call-param.param-value-date      = p-value-date
     1690       buf_tt-rule-call-param.param-value-decimal   = p-value-decimal
     1691       buf_tt-rule-call-param.param-value-integer   = p-value-integer
     1692       buf_tt-rule-call-param.param-value-logical   = p-value-logical
     1693       .
     1694     END.
     1695   END CASE.
     1696   END PROCEDURE.
     1697   procedure rcps_get-rule-on-off :
     1698   define input parameter p-codex-id as integer no-undo .
     1699   define input parameter p-ruleset-id as integer no-undo .
     1700   define input parameter p-rule-id as integer no-undo .
     1701   define input parameter p-profile-id as integer no-undo .
     1702   define input parameter p-once-more as integer no-undo .
     1703   define output parameter p-on-off as logical no-undo .
     1704   if valid-handle(p-call-handle)
     1705   and lookup("rcpscont_get-rule-on-off", p-call-handle:internal-entries) > 0 then do:
     1706     run rcpscont_get-rule-on-off in p-call-handle (
     1707                                              input p-codex-id
     1708                                             ,input p-ruleset-id
     1709                                             ,input p-rule-id
     1710                                             ,input p-profile-id
     1711                                             ,input p-once-more
     1712                                             ,output p-on-off) no-error.
     1713   end.
     1714   end procedure.
     1715   procedure rcps_set-rule-on-off :
     1716   define input parameter p-codex-id as integer no-undo .
     1717   define input parameter p-ruleset-id as integer no-undo .
     1718   define input parameter p-rule-id as integer no-undo .
     1719   define input parameter p-profile-id as integer no-undo .
     1720   define input parameter p-once-more as integer no-undo .
     1721   define input parameter p-on-off as logical no-undo .
     1722   if valid-handle(p-call-handle)
     1723   and lookup("rcpscont_get-rule-on-off", p-call-handle:internal-entries) > 0 then do:
     1724     run rcpscont_set-rule-on-off in p-call-handle (
     1725                                              input p-codex-id
     1726                                             ,input p-ruleset-id
     1727                                             ,input p-rule-id
     1728                                             ,input p-profile-id
     1729                                             ,input p-once-more
     1730                                             ,input p-on-off) no-error.
     1731   end.
     1732   end procedure.
     1733   define variable v-ii as integer no-undo .
     1734   define variable v-obj-type as character no-undo .
     1735   define variable v-keys as character no-undo .
     1736   define buffer find_rp-by-call for ub.rp-by-call.
     1737   IF p-list-mode = 'rp-rule-param':U
     1738   or p-list-mode = 'rp-rule-param':U  + chr(44) + 'все':U
     1739   THEN DO:
     1740     FIND FIRST buf_rule-profile NO-LOCK WHERE
     1741               buf_rule-profile.profile_id = p-profile-id.
     1742     run gen-key-rec in this-procedure ( input 'rule-profile':U
     1743                                     ,input buffer buf_rule-profile:handle
     1744                                     ,output v-uniq-key-rec).
     1745     FIND FIRST buf_ruledict NO-LOCK WHERE
     1746               buf_ruledict.entry-type = 'rule-profile':U
     1747         AND  buf_ruledict.uniq-key-rec = v-uniq-key-rec.
     1748     v-rcps-entry-id = buf_ruledict.entry-id.
     1749   END.
     1750   RUN rcps_fill-table IN THIS-PROCEDURE ( input yes).
     1751   define variable v-index-id as integer no-undo .
     1752   define variable v-value-character as character no-undo .
     1753   define variable v-value-date as date no-undo .
     1754   define variable v-value-decimal as decimal no-undo .
     1755   define variable v-value-integer as integer no-undo .
     1756   define variable v-value-logical as logical no-undo .
     1757   define variable v-price-type as integer no-undo .
     1758   define variable v-r-b as character no-undo .
     1759   define variable custom-par as character no-undo .
     1760   custom-par = substitute("params-only=yes,params-only-mode=&1,parent-handle=&2,call=rp-by-call"
     1761                         , p-mode
     1762                         , this-procedure:handle)   .
     1763   custom-par = "all,"  + chr(44) +
     1764                 substitute("X-SET_val_TYPE=&1", 1) + chr(44) +
     1765                custom-par.
     1766   run rep/dreport.p
     1767       ( input parparentproc
     1768       , input 'ibs.th.rep.eddinam'
     1769       , input "Движение денежных средств":U
     1770       , input 0
     1771       , input ""
     1772       , input "2"
     1773       , input ""
     1774       , input "1"
     1775       , input custom-par
     1776       , input NO
     1777       ).
     1778   run rcps_proc-save0 in this-procedure .
