     1241     Col-name[250]=   'IP':U
     1242     Col-name[251]=   'IQ':U
     1243     Col-name[252]=   'IR':U
     1244     Col-name[253]=   'IS':U
     1245     Col-name[254]=   'IT':U
     1246     Col-name[255]=   'IU':U
     1247     Col-name[256]=   'IV':U
     1248     .
     1249    end.
     1250   end procedure.
     1251   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1252   DEFINE VARIABLE v-ch AS WIDGET-HANDLE NO-UNDO EXTENT 6.
     1253   DEFINE VARIABLE v-dflt-rec AS RECID NO-UNDO.
     1254   DEFINE VARIABLE v-rp-dflt-rec AS RECID NO-UNDO.
     1255   DEFINE VARIABLE v-rcps-entry-id AS INTEGER NO-UNDO.
     1256   DEFINE VARIABLE v-uniq-key-rec AS character NO-UNDO.
     1257   DEFINE VARIABLE rule-display-option AS CHARACTER NO-UNDO.
     1258   DEFINE BUFFER buf_Rule-profile FOR ub.rule-profile.
     1259   DEFINE BUFFER buf_Ruledict FOR ub.ruledict.
     1260   DEFINE BUFFER call_tt-rule-call-param FOR tt-rule-call-param.
     1261   define buffer term_tt-rule-call-param for tt-rule-call-param.
     1262   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1263   procedure rcps_get-profile-id :
     1264   define output parameter p-local-profile-id as integer no-undo .
     1265   do
     1266   on error undo, return error:
     1267   p-local-profile-id = p-profile-id.
