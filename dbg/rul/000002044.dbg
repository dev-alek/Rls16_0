     1605     define variable p-xsd-file as character no-undo.
     1606   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1607   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
     1608   run gbl/getobjsrvhndl.p (input-output ObjSrv).
     1609   function context_begin-esys-command return logical
     1610   (
     1611       input p-esys-id-list as character
     1612      ,input-output p-esys-cmd-proc-handle as handle
     1613      ,output p-esys-cmd-code as integer
     1614   ):
     1615      if not valid-handle(p-esys-cmd-proc-handle )
     1616      then do:
     1617        run nws/cmd-bush.p persistent set p-esys-cmd-proc-handle no-error .
     1618        if error-status :error
     1619        then do:
     1620           delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( substitute("&1 &2 &3&4Ошибка при запуске процедуры cmd-bush.p&4" +
     1621                                              "&5&4&6"
     1622                                              ,vss-workfile
     1623                                              ,vss-revision
     1624                                              ,vss-description
     1625                                              ,chr(10)
     1626                                              ,error-status:get-message(1)
     1627                                              ,return-value )).
     1628        end.
     1629        run begin-create-command in p-esys-cmd-proc-handle
     1630          (input 'cmd-esys-general':U
     1631          ,input p-esys-id-list
     1632          ,output p-esys-cmd-code
     1633          ) no-error.
     1634        if error-status :error
     1635        then do:
     1636          delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при создании команды &1&2&3&1&4"
     1637                                                           , 'cmd-esys-general':U
     1638                                                           , error-status:get-message(1)
     1639                                                           , return-value
     1640                                                           )).
     1641          return no .
     1642        end.
     1643        return yes.
     1644      end.
     1645   end.
     1646   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1647   function context_send-esys-command return logical
     1648   (
     1649       input p-esys-id-list as character
     1650      ,input p-esys-cmd-proc-handle as handle
     1651      ,input p-esys-cmd-code as integer
     1652      ,input p-user-id as character
     1653   ):
     1654      define variable v-dmp-ord-int64 as int64 no-undo .
     1655      if valid-handle(p-esys-cmd-proc-handle )
     1656      then do:
     1657         run send-command-esys in p-esys-cmd-proc-handle
     1658             (input p-esys-cmd-code
     1659             ,input p-esys-id-list
     1660             ,input p-user-id
     1661             ,output v-dmp-ord-int64
     1662             ) no-error.
     1663         if error-status :error
     1664         then do:
     1665            delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при отсылке во внешнюю систему &1 команды с кодом &2&3&4&3&5"
     1666                                                           , p-esys-id-list
     1667                                                           , p-cmd-code
     1668                                                           , chr(10)
     1669                                                           , error-status:get-message(1)
     1670                                                           , return-value
     1671                                                           )).
     1672            return no .
     1673         end.
     1674         delete procedure p-esys-cmd-proc-handle no-error.
     1675         return yes.
     1676      end.
     1677      else do:
     1678         delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при отсылке во внешнюю систему &1 команды с кодом &2&3&4&3&5"
     1679                                                       , p-esys-id-list
     1680                                                       , p-cmd-code
     1681                                                       , chr(10)
     1682                                                       , error-status:get-message(1)
     1683                                                       , return-value
     1684                                                       )).
     1685         return no .
     1686      end.
     1687   end.
     1688   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1689   function context_delete-command return logical
     1690   (
     1691       input p-esys-cmd-proc-handle as handle
     1692      ,input p-esys-cmd-code as integer
     1693   ):
     1694      if valid-handle(p-esys-cmd-proc-handle )
     1695      then do:
     1696         run delete-command in p-esys-cmd-proc-handle
     1697             (input p-esys-cmd-code
     1698             ) no-error.
     1699         if error-status :error
     1700         then do:
     1701            delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при удалении команды с кодом &1&2&3&2&4"
     1702                                                              , p-cmd-code
     1703                                                              , chr(10)
     1704                                                              , error-status:get-message(1)
     1705                                                              , return-value
     1706                                                              )).
     1707            return no .
     1708         end.
     1709         delete procedure p-esys-cmd-proc-handle no-error.
     1710         return yes.
     1711      end.
     1712      else do:
     1713         delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при удалении команды с кодом &1&2&3&2&4"
     1714                                                       , p-cmd-code
     1715                                                       , chr(10)
     1716                                                       , error-status:get-message(1)
     1717                                                       , return-value
     1718                                                       )).
     1719         return no .
     1720      end.
     1721   end.
     1722   on delete of this-procedure do:
     1723     run garbcoll_clear in this-procedure .
     1724   end.
     1725   run load-ruleset-context in this-procedure ( input p-ruleset-id) no-error.
     1726   if error-status:error then do:
     1727     undo, return error return-value .
     1728   end.
     1729   if return-value = "return" then return ''.
     1730   define variable ExpData1 as class Route-data_ no-undo .
     1731   if (valid-handle(g#lib-gate) <> true) then do:   run gbl/lib-gate.p persistent no-error .   if error-status :error or (valid-handle(g#lib-gate) <> true) then do:     message       "Error starting gbl/lib-gate.p" skip       g#lib-gate skip       g#lib-gate :type skip       g#lib-gate :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-gate_route-data_ in g#lib-gate
     1732   (
     1733      input parparentproc
     1734     ,input p-parent-handle
     1735     ,input p-log-handle
     1736     ,input this-procedure:handle
     1737     ,output ExpData1
     1738   )
     1739         .
     1740   if not this-procedure:persistent then do:
     1741     run proc-main in this-procedure no-error .
     1742     if error-status:error then do:
     1743       v-esm = error-status :get-message (1).
     1744       v-es = error-status:error .
     1745       v-rv = return-value .
     1746     end.
     1747     if v-es then do:
     1748         run garbcoll_clear in this-procedure .
     1749         undo, return error substitute( "&1. &2&3&4", vss-workfile, v-rv, chr(10), v-esm).
     1750     end.
     1751     run garbcoll_clear in this-procedure .
     1752   end.
     1753   procedure proc-main :
     1754   _main:
     1755   do
     1756   on error undo, return error substitute( "&1&2&3&2&4", return-value, chr(10), error-status :get-message (1), v-last-error-message)
     1757   :
     1758   define variable v-err as logical no-undo .
     1759   define variable v-gds-code as integer no-undo .
     1760   define variable v-b-code as integer no-undo .
     1761   define variable v-unit-cli as character no-undo .
     1762   define variable v-cli-base-rate as decimal no-undo .
     1763   define variable v-gds-name as character no-undo .
     1764   define variable v-alpha1 as character no-undo .
     1765   define variable v-b-str as character no-undo .
     1766   define variable v-bc-on-type as character no-undo .
     1767   define variable varscales-pref as character no-undo .
     1768   define variable varpgscales-pref as character no-undo .
     1769   define variable v-ii as integer no-undo .
     1770   define variable v-b-str-list as character no-undo .
     1771   define variable v-in-code as character no-undo .
     1772   define variable v-node-code as integer no-undo .
     1773   define variable v-nodename as character no-undo .
     1774   define variable v-need-part-b-code as logical no-undo .
     1775   define buffer buf_bar-code for ub.bar-code.
     1776   define buffer buf_goods for ub.goods.
     1777   define buffer buf_gds-prt for ub.gds-prt.
     1778     IF  ExpData1:route-data_push-xmlschema( INPUT p-xsd-file ) = false  THEN do:
     1779       undo _main, return error v-last-error-message .
     1780     end.
     1781     case p-ruleset-id:
     1782       when 6 then do:
     1783         assign
     1784         v-gds-code = (if v-has-newbh
     1785                       then v-newbh:buffer-field("gds-code"):buffer-value
     1786                       else v-oldbh:buffer-field("gds-code"):buffer-value
     1787                       )
     1788         v-b-code = (if v-has-newbh
     1789                     then v-newbh:buffer-field("b-code"):buffer-value
     1790                     else v-oldbh:buffer-field("b-code"):buffer-value
     1791                     )
     1792         v-cli-base-rate = (if v-has-newbh
     1793                     then v-newbh:buffer-field("cli-base-rate"):buffer-value
     1794                     else v-oldbh:buffer-field("cli-base-rate"):buffer-value
     1795                     )
     1796         v-unit-cli = (if v-has-newbh
     1797                     then v-newbh:buffer-field("unit-cli"):buffer-value
     1798                     else v-oldbh:buffer-field("unit-cli"):buffer-value
     1799                     )
     1800         v-in-code = (if v-has-newbh
     1801                     then v-newbh:buffer-field("in-code"):buffer-value
     1802                     else v-oldbh:buffer-field("in-code"):buffer-value
     1803                     )
     1804         v-node-code = (if v-has-newbh
     1805                     then v-newbh:buffer-field("node-code"):buffer-value
     1806                     else v-oldbh:buffer-field("node-code"):buffer-value
     1807                     )
     1808         .
     1809         if v-in-code <> '' then do:
     1810           run dtlpbcod_need-part-b-code in this-procedure ( input v-gds-code
     1811                                                  , input v-esys-id-list
     1812                                                  , output v-need-part-b-code
     1813                                                ) no-error.
     1814           if v-need-part-b-code = no then return ''.
     1815         end.
     1816         find first buf_gds-prt no-lock where
     1817                   buf_gds-prt.node-code = v-node-code no-error.
     1818         if error-status:error then do:
     1819           v-err-mess = substitute("Неизвестный код признака &1 у баркода &1 товар &3"
     1820                                   , v-node-code
     1821                                   , v-b-code
     1822                                   , v-gds-code
     1823                                   ).
     1824           undo _main, return error v-err-mess .
     1825         end.
     1826         if not (buf_gds-prt.root = yes
     1827            or buf_gds-prt.is-term = yes) then do:
     1828           return ''.
     1829         end.
     1830         assign
     1831         v-nodename = buf_gds-prt.f-name.
     1832         IF  context_begin-esys-command( input v-esys-id-list
     1833                                       , input-output v-esys-cmd-proc-handle
     1834                                       , output v-esys-cmd-code) = false  THEN do:
     1835           undo _main, return error v-last-error-message .
     1836         end.
     1837         ExpData1:route-data_create-record( INPUT "barcodes") .
     1838         IF ExpData1:esys-add-dump( INPUT "barcodes", INPUT v-esys-cmd-proc-handle, INPUT v-esys-cmd-code, '_dump-order=Rec_ID') = false  THEN do:
     1839           v-err-mess = substitute("Ошибка при маршрутизации записи по товару с кодом  &1:&2&3"
     1840                                   , v-gds-code
     1841                                   , chr(10)
     1842                                   , v-last-error-message
     1843                                   ).
     1844           undo _main, return error v-last-error-message .
     1845         end.
     1846         ExpData1:route-data_copy-field-character( INPUT "barcodes", "BC", INPUT  string(v-b-code) ) .
     1847         ExpData1:route-data_copy-field-integer( INPUT "barcodes", "GoodsID", INPUT  v-gds-code ) .
     1848         ExpData1:route-data_copy-field-decimal( INPUT "barcodes", "Price", INPUT  0 ) .
     1849         ExpData1:route-data_copy-field-character( INPUT "barcodes", "Unit", INPUT  v-unit-cli ) .
     1850         ExpData1:route-data_copy-field-decimal( INPUT "barcodes", "CUnit", INPUT  v-cli-base-rate ) .
     1851         ExpData1:route-data_copy-field-character( INPUT "barcodes", "Action", INPUT  v-action ) .
     1852         ExpData1:route-data_copy-field-character( INPUT "barcodes", "NodeName", INPUT  v-nodename ) .
     1853         IF ExpData1:esys-add-dump( INPUT "barcodes", INPUT v-esys-cmd-proc-handle, INPUT v-esys-cmd-code, '+update') = false  THEN do:
     1854           v-err-mess = substitute("Ошибка при маршрутизации записи баркода/ДопБК с кодом &1:&2&3"
     1855                                   , v-newbh::b-code
     1856                                   , chr(10)
     1857                                   , v-last-error-message
     1858                                   ).
     1859           undo _main, return error v-last-error-message .
     1860         end.
     1861         IF  context_send-esys-command( input v-esys-id-list
     1862                                     , input v-esys-cmd-proc-handle
     1863                                     , input v-esys-cmd-code
     1864                                     , input g#userid) = false  THEN do:
     1865           undo _main, return error v-last-error-message .
     1866         end.
     1867               ExpData1:Route-data_clear-data ( ) .
     1868       end.
     1869       when 7 then do:
     1870         assign
     1871         v-b-code = (if v-has-newbh
     1872                     then v-newbh:buffer-field("b-code"):buffer-value
     1873                     else v-oldbh:buffer-field("b-code"):buffer-value
     1874                     )
     1875         v-b-str = (if v-has-newbh
     1876                     then v-newbh:buffer-field("b-str"):buffer-value
     1877                     else v-oldbh:buffer-field("b-str"):buffer-value
     1878                     )
     1879         v-bc-on-type = (if v-has-newbh
     1880                         then v-newbh:buffer-field("bc-on-type"):buffer-value
     1881                         else v-oldbh:buffer-field("bc-on-type"):buffer-value
     1882                         )
     1883         .
     1884         find first buf_bar-code no-lock where
     1885                   buf_bar-code.b-code = v-b-code no-error.
     1886         if not available buf_bar-code then do:
     1887           v-err-mess = substitute("Неизвестный баркод &1 для ДопБК &2"
     1888                                   , v-b-code
     1889                                   , v-b-str
     1890                                   ).
     1891           undo _main, return error v-err-mess .
     1892         end.
     1893         find first buf_gds-prt no-lock where
     1894                   buf_gds-prt.node-code = buf_bar-code.node-code no-error.
     1895         if error-status:error then do:
     1896           v-err-mess = substitute("Неизвестный код признака &1 у баркода &1 товар &3"
     1897                                   , v-node-code
     1898                                   , v-b-code
     1899                                   , v-gds-code
     1900                                   ).
     1901           undo _main, return error v-err-mess .
     1902         end.
     1903         if not (buf_gds-prt.root = yes
     1904            or buf_gds-prt.is-term = yes) then do:
     1905           return ''.
     1906         end.
     1907         assign
     1908         v-nodename = buf_gds-prt.f-name.
     1909         assign
     1910         v-unit-cli = buf_bar-code.unit-cli
     1911         v-gds-code = buf_bar-code.gds-code
     1912         v-cli-base-rate = buf_bar-code.cli-base-rate
     1913         .
     1914         if v-bc-on-type = 'sclc':U
     1915         or v-bc-on-type = 'scgb':U
     1916         or v-bc-on-type = 'pglc':U then do:
     1917   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1918   define variable varscales-pref-type18 as character no-undo.
     1919   varscales-pref  = ?.
     1920   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     1921     (input  'sclspref':u
     1922     ,input  '':u
     1923     ,input  '':u
     1924     ,input  0
     1925     ,input  '':u
     1926     ,input  '':u
     1927     ,input  '':u
     1928     ,input  no
     1929     ,output varscales-pref
     1930     ,output varscales-pref-type18
     1931     ) no-error .
     1932   if varscales-pref = ? then do:
     1933     assign
     1934     varscales-pref = '21,23,25':U.
     1935   end.
     1936   define variable varpgscales-pref-type18 as character no-undo.
     1937   varpgscales-pref  = ?.
     1938   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     1939     (input  'scpgpref':u
     1940     ,input  '':u
     1941     ,input  '':u
     1942     ,input  0
     1943     ,input  '':u
     1944     ,input  '':u
     1945     ,input  '':u
     1946     ,input  no
     1947     ,output varpgscales-pref
     1948     ,output varpgscales-pref-type18
     1949     ) no-error .
     1950   if varpgscales-pref = ? then do:
     1951     assign
     1952     varpgscales-pref = '24IIIIIQQ000C,28IIIIIQQQ00C':U.
     1953   end.
     1954           case v-bc-on-type:
     1955             when 'sclc':U
     1956             or
     1957             when 'scgb':U then do:
     1958               do v-ii = 1 to num-entries(varscales-pref):
     1959                  assign
     1960                  v-b-str-list = v-b-str-list +
     1961                                (if v-b-str-list = '' then '' else chr(44)) +
     1962                                entry(v-ii, varscales-pref) + v-b-str.
     1963               end.
     1964             end.
     1965             when 'pglc':U then do:
     1966               return ''.
     1967             end.
     1968             otherwise do:
     1969               v-b-str-list = v-b-str.
     1970             end.
     1971           end case.
     1972         end.
     1973         else do:
     1974           v-b-str-list = v-b-str.
     1975         end.
     1976         IF  context_begin-esys-command( input v-esys-id-list
     1977                                       , input-output v-esys-cmd-proc-handle
     1978                                       , output v-esys-cmd-code) = false  THEN do:
     1979           undo _main, return error v-last-error-message .
     1980         end.
     1981         do v-ii = 1 to num-entries(v-b-str-list):
     1982           ExpData1:route-data_create-record( INPUT "barcodes") .
     1983           IF ExpData1:esys-add-dump( INPUT "barcodes", INPUT v-esys-cmd-proc-handle, INPUT v-esys-cmd-code, '_dump-order=Rec_ID') = false  THEN do:
     1984             v-err-mess = substitute("Ошибка при маршрутизации записи ДопБК &1 (баркод &2):&3&4"
     1985                                     , v-b-str
     1986                                     , v-b-code
     1987                                     , chr(10)
     1988                                     , v-last-error-message
     1989                                     ).
     1990             undo _main, return error v-last-error-message .
     1991           end.
     1992           ExpData1:route-data_copy-field-character( INPUT "barcodes", "BC", INPUT  entry(v-ii, v-b-str-list) ) .
     1993           ExpData1:route-data_copy-field-integer( INPUT "barcodes", "GoodsID", INPUT  v-gds-code ) .
     1994           ExpData1:route-data_copy-field-decimal( INPUT "barcodes", "Price", INPUT  0 ) .
     1995           ExpData1:route-data_copy-field-character( INPUT "barcodes", "Unit", INPUT  v-unit-cli ) .
     1996           ExpData1:route-data_copy-field-decimal( INPUT "barcodes", "CUnit", INPUT  v-cli-base-rate) .
     1997           ExpData1:route-data_copy-field-character( INPUT "barcodes", "Action", INPUT  v-action ) .
     1998           ExpData1:route-data_copy-field-character( INPUT "barcodes", "NodeName", INPUT  v-nodename ) .
     1999           IF ExpData1:esys-add-dump( INPUT "barcodes", INPUT v-esys-cmd-proc-handle, INPUT v-esys-cmd-code, '+update') = false  THEN do:
     2000             v-err-mess = substitute("Ошибка при маршрутизации записи ДопБК &1 (баркод &2):&3&4"
     2001                                     , v-b-str
     2002                                     , v-b-code
     2003                                     , chr(10)
     2004                                     , v-last-error-message
     2005                                     ).
     2006             undo _main, return error v-last-error-message .
     2007           end.
     2008         end.
     2009         IF  context_send-esys-command( input v-esys-id-list
     2010                                     , input v-esys-cmd-proc-handle
     2011                                     , input v-esys-cmd-code
     2012                                     , input g#userid) = false  THEN do:
     2013           undo _main, return error v-last-error-message .
     2014         end.
     2015       end.
     2016     end case.
     2017       ExpData1:Route-data_clear-data ( ) .
     2018   end.
     2019   end procedure.
     2020   procedure load-ruleset-context :
     2021   define input parameter p-ruleset-id as integer no-undo .
     2022   define variable v-flag as logical no-undo .
     2023   define variable v-ii as integer no-undo .
     2024   define variable v-changes-list2 as character no-undo .
     2025   define buffer buf_rule-call-param for ub.rule-call-param.
     2026   define buffer buf_ext-system for ub.ext-system.
     2027   do
     2028   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2029   on stop   undo , return error substitute( "&1. stop", vss-workfile )
     2030   on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     2031   :
     2032     assign
     2033     v-oldbh = widget-handle (entry(2, p-doc-code, chr(4)))
     2034     v-newbh = widget-handle (entry(3, p-doc-code, chr(4)))
     2035     v-changes-list = entry(4, p-doc-code, chr(4))
     2036     file-name  = p-process-file-name
     2037     v-has-oldbh = valid-handle(v-oldbh) and v-oldbh:available
     2038     v-has-newbh = valid-handle(v-newbh) and v-newbh:available
     2039     .
     2040     if not v-has-newbh
     2041     and not v-has-oldbh then do:
     2042       undo, return error substitute("Не определено ни одного буфера - ни старый, ни новый").
     2043     end.
     2044     if not v-has-oldbh
     2045     and v-changes-list  = '' then do:
     2046        undo, return error substitute("Не определен старый буфер и список изменений").
     2047     end.
     2048     case p-ruleset-id:
     2049       when 6 then do:
     2050         if v-has-newbh
     2051         and v-newbh:table <> 'bar-code':U
     2052         and v-newbh:table <> "temp-" + 'bar-code':U
     2053         then do:
     2054           undo, return error substitute("Передан неверный буфер вместо буфера для &1",  'bar-code':U).
     2055         end.
     2056         if v-changes-list = ''
     2057         and v-has-newbh
     2058         and v-has-oldbh
     2059         then do:
     2060           v-changes-list2 = "b-code,cli-base-rate".
     2061           do v-ii = 1 to num-entries(v-changes-list2 ):
     2062             if v-oldbh:buffer-field(entry(v-ii, v-changes-list2)):buffer-value <> v-newbh:buffer-field(entry(v-ii, v-changes-list2)):buffer-value then do:
     2063               v-flag = yes.
     2064               leave.
     2065             end.
     2066           end.
     2067           if not v-flag then return "return".
     2068         end.
     2069         else do:
     2070           if v-has-newbh then do:
     2071             if lookup("b-code", v-changes-list) = 0
     2072             and lookup("cli-base-rate", v-changes-list) = 0
     2073             and not(v-newbh:new) then do:
     2074               return 'return'.
     2075             end.
     2076           end.
     2077         end.
     2078         if not v-has-newbh then do:
     2079           v-action = 'D':U.
     2080         end.
     2081         else do:
     2082           v-action = 'U':U.
     2083         end.
     2084       end.
     2085       when 7 then do:
     2086         if v-has-newbh
     2087         and v-newbh:table <> 'prod-bc':U
     2088         and v-newbh:table <> "temp-" + 'prod-bc':U
     2089         then do:
     2090           undo, return error substitute("Передан неверный буфер вместо буфера для &1",  'prod-bc':U).
     2091         end.
     2092         if v-changes-list = ''
     2093         and v-has-newbh
     2094         and v-has-oldbh
     2095         then do:
     2096           v-changes-list2 = "b-code,b-str,bc-on".
     2097           do v-ii = 1 to num-entries(v-changes-list2 ):
     2098             if v-oldbh:buffer-field(entry(v-ii, v-changes-list2)):buffer-value <> v-newbh:buffer-field(entry(v-ii, v-changes-list2)):buffer-value then do:
     2099               v-flag = yes.
     2100               leave.
     2101             end.
     2102           end.
     2103           if not v-flag then return "return".
     2104         end.
     2105         else do:
     2106           if v-has-newbh then do:
     2107             if lookup("b-code", v-changes-list) = 0
     2108             and lookup("b-str", v-changes-list) = 0
     2109             and lookup("bc-on", v-changes-list) = 0
     2110             and not(v-newbh:new) then do:
     2111               return 'return'.
     2112             end.
     2113           end.
     2114         end.
     2115         if not v-has-newbh
     2116         or (v-has-newbh
     2117             and v-has-oldbh
     2118             and v-newbh::bc-on = no
     2119             and v-oldbh::bc-on = yes)
     2120         then do:
     2121           v-action = 'D':U.
     2122         end.
     2123         else do:
     2124           v-action = 'U':U.
     2125         end.
     2126       end.
     2127       otherwise do:
     2128         undo, return error substitute("Неверный вызов &1 для набора правил &2", vss-workfile , p-ruleset-id).
     2129       end.
     2130     end case.
     2131     for each buf_rule-call-param no-lock where
     2132     buf_rule-call-param.codex_id = p-codex-id
     2133     and buf_rule-call-param.ruleset_id = p-ruleset-id
     2134     and buf_rule-call-param.call_id = p-call-id
     2135     and buf_rule-call-param.order_id = p-order-id
     2136     and buf_rule-call-param.rule_id = p-rule-id
     2137     and buf_rule-call-param.param-name = "p-esys-id-list",
     2138       first buf_ext-system no-lock where
     2139             buf_Ext-system.esys-id = buf_rule-call-param.param-value-integer
     2140         and buf_Ext-system.db-num = 0
     2141         and buf_Ext-system.esys-have-export = yes
     2142         and buf_Ext-system.esys-db-num-exp = g#db-num:
     2143       v-esys-id-list = v-esys-id-list + (if v-esys-id-list = '' then '' else chr(1)) + string(buf_ext-system.esys-id).
     2144     end.
     2145     if v-esys-id-list = '' then return "return".
     2146     find first buf_rule-call-param no-lock where
     2147   buf_rule-call-param.codex_id = p-codex-id
     2148   and buf_rule-call-param.ruleset_id = p-ruleset-id
     2149   and buf_rule-call-param.call_id = p-call-id
     2150   and buf_rule-call-param.order_id = p-order-id
     2151   and buf_rule-call-param.rule_id = p-rule-id
     2152   and buf_rule-call-param.param-name = "p-xsd-file"
     2153    no-error.
     2154   if available buf_rule-call-param then do:
     2155     assign p-xsd-file = buf_rule-call-param.param-value-character.
     2156   end.
     2157   end.
     2158   end procedure.
