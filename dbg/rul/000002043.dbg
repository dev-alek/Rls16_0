     1539   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1540   procedure set-error :
     1541   define input parameter p-mess as character no-undo .
     1542     do
     1543     on error undo, return error
     1544     :
     1545        assign
     1546        v-last-error-message = p-mess.
     1547     end.
     1548   end procedure.
     1549     define variable p-xsd-file as character no-undo.
     1550   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1551   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
     1552   run gbl/getobjsrvhndl.p (input-output ObjSrv).
     1553   function context_begin-esys-command return logical
     1554   (
     1555       input p-esys-id-list as character
     1556      ,input-output p-esys-cmd-proc-handle as handle
     1557      ,output p-esys-cmd-code as integer
     1558   ):
     1559      if not valid-handle(p-esys-cmd-proc-handle )
     1560      then do:
     1561        run nws/cmd-bush.p persistent set p-esys-cmd-proc-handle no-error .
     1562        if error-status :error
     1563        then do:
     1564           delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( substitute("&1 &2 &3&4Ошибка при запуске процедуры cmd-bush.p&4" +
     1565                                              "&5&4&6"
     1566                                              ,vss-workfile
     1567                                              ,vss-revision
     1568                                              ,vss-description
     1569                                              ,chr(10)
     1570                                              ,error-status:get-message(1)
     1571                                              ,return-value )).
     1572        end.
     1573        run begin-create-command in p-esys-cmd-proc-handle
     1574          (input 'cmd-esys-general':U
     1575          ,input p-esys-id-list
     1576          ,output p-esys-cmd-code
     1577          ) no-error.
     1578        if error-status :error
     1579        then do:
     1580          delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при создании команды &1&2&3&1&4"
     1581                                                           , 'cmd-esys-general':U
     1582                                                           , error-status:get-message(1)
     1583                                                           , return-value
     1584                                                           )).
     1585          return no .
     1586        end.
     1587        return yes.
     1588      end.
     1589   end.
     1590   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1591   function context_send-esys-command return logical
     1592   (
     1593       input p-esys-id-list as character
     1594      ,input p-esys-cmd-proc-handle as handle
     1595      ,input p-esys-cmd-code as integer
     1596      ,input p-user-id as character
     1597   ):
     1598      define variable v-dmp-ord-int64 as int64 no-undo .
     1599      if valid-handle(p-esys-cmd-proc-handle )
     1600      then do:
     1601         run send-command-esys in p-esys-cmd-proc-handle
     1602             (input p-esys-cmd-code
     1603             ,input p-esys-id-list
     1604             ,input p-user-id
     1605             ,output v-dmp-ord-int64
     1606             ) no-error.
     1607         if error-status :error
     1608         then do:
     1609            delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при отсылке во внешнюю систему &1 команды с кодом &2&3&4&3&5"
     1610                                                           , p-esys-id-list
     1611                                                           , p-cmd-code
     1612                                                           , chr(10)
     1613                                                           , error-status:get-message(1)
     1614                                                           , return-value
     1615                                                           )).
     1616            return no .
     1617         end.
     1618         delete procedure p-esys-cmd-proc-handle no-error.
     1619         return yes.
     1620      end.
     1621      else do:
     1622         delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при отсылке во внешнюю систему &1 команды с кодом &2&3&4&3&5"
     1623                                                       , p-esys-id-list
     1624                                                       , p-cmd-code
     1625                                                       , chr(10)
     1626                                                       , error-status:get-message(1)
     1627                                                       , return-value
     1628                                                       )).
     1629         return no .
     1630      end.
     1631   end.
     1632   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1633   function context_delete-command return logical
     1634   (
     1635       input p-esys-cmd-proc-handle as handle
     1636      ,input p-esys-cmd-code as integer
     1637   ):
     1638      if valid-handle(p-esys-cmd-proc-handle )
     1639      then do:
     1640         run delete-command in p-esys-cmd-proc-handle
     1641             (input p-esys-cmd-code
     1642             ) no-error.
     1643         if error-status :error
     1644         then do:
     1645            delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при удалении команды с кодом &1&2&3&2&4"
     1646                                                              , p-cmd-code
     1647                                                              , chr(10)
     1648                                                              , error-status:get-message(1)
     1649                                                              , return-value
     1650                                                              )).
     1651            return no .
     1652         end.
     1653         delete procedure p-esys-cmd-proc-handle no-error.
     1654         return yes.
     1655      end.
     1656      else do:
     1657         delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при удалении команды с кодом &1&2&3&2&4"
     1658                                                       , p-cmd-code
     1659                                                       , chr(10)
     1660                                                       , error-status:get-message(1)
     1661                                                       , return-value
     1662                                                       )).
     1663         return no .
     1664      end.
     1665   end.
     1666   on delete of this-procedure do:
     1667     run garbcoll_clear in this-procedure .
     1668   end.
     1669   run load-ruleset-context in this-procedure ( input p-ruleset-id) no-error.
     1670   if error-status:error then do:
     1671     undo, return error return-value .
     1672   end.
     1673   if return-value = "return" then return ''.
     1674   define variable ExpData1 as class Route-data_ no-undo .
     1675   if (valid-handle(g#lib-gate) <> true) then do:   run gbl/lib-gate.p persistent no-error .   if error-status :error or (valid-handle(g#lib-gate) <> true) then do:     message       "Error starting gbl/lib-gate.p" skip       g#lib-gate skip       g#lib-gate :type skip       g#lib-gate :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-gate_route-data_ in g#lib-gate
     1676   (
     1677      input parparentproc
     1678     ,input p-parent-handle
     1679     ,input p-log-handle
     1680     ,input this-procedure:handle
     1681     ,output ExpData1
     1682   )
     1683         .
     1684   if not this-procedure:persistent then do:
     1685     run proc-main in this-procedure no-error .
     1686     if error-status:error then do:
     1687       v-esm = error-status :get-message (1).
     1688       v-es = error-status:error .
     1689       v-rv = return-value .
     1690     end.
     1691     if v-es then do:
     1692         run garbcoll_clear in this-procedure .
     1693         undo, return error substitute( "&1. &2&3&4", vss-workfile, v-rv, chr(10), v-esm).
     1694     end.
     1695     run garbcoll_clear in this-procedure .
     1696   end.
     1697   procedure proc-main :
     1698   _main:
     1699   do
     1700   on error undo, return error substitute( "&1&2&3&2&4", return-value, chr(10), error-status :get-message (1), v-last-error-message)
     1701   on stop undo, return error substitute( "&1&2&3&2&4", return-value, chr(10), error-status :get-message (1), v-last-error-message)
     1702   :
     1703   define variable v-err      as logical   no-undo .
     1704   define variable v-gds-code as integer   no-undo .
     1705   define variable v-gds-name as character no-undo .
     1706   define variable v-producer as character no-undo .
     1707   define buffer buf_goods    for ub.goods.
     1708   define buffer buf_clients  for ub.clients.
     1709     IF  ExpData1:route-data_push-xmlschema( INPUT p-xsd-file ) = false  THEN do:
     1710       undo _main, return error v-last-error-message .
     1711     end.
     1712     IF  context_begin-esys-command( input v-esys-id-list
     1713                                   , input-output v-esys-cmd-proc-handle
     1714                                   , output v-esys-cmd-code) = false  THEN do:
     1715       undo _main, return error v-last-error-message .
     1716     end.
     1717     v-gds-code = v-newbh:buffer-field("gds-code"):buffer-value.
     1718     v-gds-name = v-newbh:buffer-field("gds-name"):buffer-value.
     1719     ExpData1:route-data_create-record( INPUT "goods") .
     1720     IF ExpData1:esys-add-dump( INPUT "goods", INPUT v-esys-cmd-proc-handle, INPUT v-esys-cmd-code, '_dump-order=Rec_ID') = false  THEN do:
     1721       v-err-mess = substitute("Ошибка при маршрутизации записи по товару с кодом  &1:&2&3"
     1722                               , v-gds-code
     1723                               , chr(10)
     1724                               , v-last-error-message
     1725                               ).
     1726       undo _main, return error v-last-error-message .
     1727     end.
     1728     find first buf_goods no-lock where
     1729               buf_goods.gds-code = v-gds-code no-error.
     1730     if not available buf_goods then do:
     1731         undo _main, return error substitute("Не найден товар с кодом &1", v-gds-code).
     1732     end.
     1733     assign
     1734       v-action = if buf_goods.stts = 0 then 'U':U else 'D':U
     1735     .
     1736     assign
     1737       v-producer = ""
     1738     .
     1739     find first buf_clients no-lock
     1740           where buf_clients.obj-code = buf_goods.prod-code
     1741             and buf_clients.obj-type = buf_goods.prod-type
     1742             and buf_clients.is-prod  = yes
     1743             no-error.
     1744             if available buf_clients then do:
     1745               assign
     1746                 v-producer = buf_clients.obj-name
     1747               .
     1748             end.
     1749     ExpData1:route-data_copy-field( INPUT "goods", "ID", INPUT  v-newbh:buffer-field("gds-code")) .
     1750     ExpData1:route-data_copy-field( INPUT "goods", "Name", INPUT  v-newbh:buffer-field("gds-name")).
     1751     ExpData1:route-data_copy-field( INPUT "goods", "Baseunit", INPUT  v-newbh:buffer-field("unit-base") ).
     1752     ExpData1:route-data_copy-field( INPUT "goods", "CountryID", INPUT  v-newbh:buffer-field("alpha1") ) .
     1753     ExpData1:route-data_copy-field-decimal( INPUT "goods", "Baseprice", INPUT  0.0 ) .
     1754     ExpData1:route-data_copy-field-character( INPUT "goods", "Action", INPUT  v-action ) .
     1755     ExpData1:route-data_copy-field-character( INPUT "goods", "Producer", INPUT  v-producer ) .
     1756     IF ExpData1:esys-add-dump( INPUT "goods", INPUT v-esys-cmd-proc-handle, INPUT v-esys-cmd-code, '+update') = false  THEN do:
     1757       v-err-mess = substitute("Ошибка при маршрутизации записи товара с кодом &1:&2&3"
     1758                               , v-gds-code
     1759                               , chr(10)
     1760                               , v-last-error-message
     1761                               ).
     1762       undo _main, return error v-last-error-message .
     1763     end.
     1764     IF  context_send-esys-command( input v-esys-id-list
     1765                                 , input v-esys-cmd-proc-handle
     1766                                 , input v-esys-cmd-code
     1767                                 , input g#userid) = false  THEN do:
     1768       undo _main, return error v-last-error-message .
     1769     end.
     1770       ExpData1:Route-data_clear-data ( ) .
     1771   end.
     1772   end procedure.
     1773   procedure load-ruleset-context :
     1774   define input parameter p-ruleset-id as integer no-undo .
     1775   define variable v-flag as logical no-undo .
     1776   define variable v-ii as integer no-undo .
     1777   define variable v-changes-list2 as character no-undo .
     1778   define buffer buf_rule-call-param for ub.rule-call-param.
     1779   define buffer buf_ext-system for ub.ext-system.
     1780   do
     1781   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1782   on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1783   on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1784   :
     1785     assign
     1786     v-oldbh = widget-handle (entry(2, p-doc-code, chr(4)))
     1787     v-newbh = widget-handle (entry(3, p-doc-code, chr(4)))
     1788     v-changes-list = entry(4, p-doc-code, chr(4))
     1789     file-name  = p-process-file-name
     1790     v-has-oldbh = valid-handle(v-oldbh) and v-oldbh:available
     1791     v-has-newbh = valid-handle(v-newbh) and v-newbh:available
     1792     .
     1793     if not v-has-newbh then do:
     1794       undo, return error substitute("Не определен новый буфер").
     1795     end.
     1796     if not v-has-newbh
     1797     and not v-has-oldbh then do:
     1798       undo, return error substitute("Не определено ни одного буфера - ни старый, ни новый").
     1799     end.
     1800     if not v-has-oldbh
     1801     and v-changes-list  = '' then do:
     1802        undo, return error substitute("Не определен старый буфер и список изменений").
     1803     end.
     1804     case p-ruleset-id:
     1805       when 5 then do:
     1806         if v-has-newbh
     1807         and v-newbh:table <> 'goods':U then do:
     1808           undo, return error substitute("Передан неверный буфер вместо буфера для &1",  'goods':U).
     1809         end.
     1810       end.
     1811       otherwise do:
     1812         undo, return error substitute("Неверный вызов &1 для набора правил &2", vss-workfile , p-ruleset-id).
     1813       end.
     1814     end case.
     1815     if v-changes-list = '' then do:
     1816       v-changes-list2 = "gds-name,alpha1,unit-base,stts".
     1817       do v-ii = 1 to num-entries(v-changes-list2 ):
     1818         if v-oldbh:buffer-field(entry(v-ii, v-changes-list2)):buffer-value <> v-newbh:buffer-field(entry(v-ii, v-changes-list2)):buffer-value then do:
     1819            v-flag = yes.
     1820            leave.
     1821         end.
     1822       end.
     1823       if not v-flag then return "return".
     1824     end.
     1825     else do:
     1826       if lookup("gds-name", v-changes-list) = 0
     1827       and lookup("alpha1", v-changes-list) = 0
     1828       and lookup("unit-base", v-changes-list) = 0
     1829       and lookup("stts", v-changes-list) = 0
     1830       and not(v-newbh:new) then do:
     1831         return 'return'.
     1832       end.
     1833     end.
     1834     for each buf_rule-call-param no-lock where
     1835     buf_rule-call-param.codex_id = p-codex-id
     1836     and buf_rule-call-param.ruleset_id = p-ruleset-id
     1837     and buf_rule-call-param.call_id = p-call-id
     1838     and buf_rule-call-param.order_id = p-order-id
     1839     and buf_rule-call-param.rule_id = p-rule-id
     1840     and buf_rule-call-param.param-name = "p-esys-id-list",
     1841       first buf_ext-system no-lock where
     1842             buf_Ext-system.esys-id = buf_rule-call-param.param-value-integer
     1843         and buf_Ext-system.db-num = 0
     1844         and buf_Ext-system.esys-have-export = yes
     1845         and buf_Ext-system.esys-db-num-exp = g#db-num:
     1846       v-esys-id-list = v-esys-id-list + (if v-esys-id-list = '' then '' else chr(1)) + string(buf_ext-system.esys-id).
     1847     end.
     1848     if v-esys-id-list = '' then return "return".
     1849     find first buf_rule-call-param no-lock where
     1850   buf_rule-call-param.codex_id = p-codex-id
     1851   and buf_rule-call-param.ruleset_id = p-ruleset-id
     1852   and buf_rule-call-param.call_id = p-call-id
     1853   and buf_rule-call-param.order_id = p-order-id
     1854   and buf_rule-call-param.rule_id = p-rule-id
     1855   and buf_rule-call-param.param-name = "p-xsd-file"
     1856    no-error.
     1857   if available buf_rule-call-param then do:
     1858     assign p-xsd-file = buf_rule-call-param.param-value-character.
     1859   end.
     1860   end.
     1861   end procedure.
