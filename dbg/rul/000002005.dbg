     5207     do
     5208     on error undo, return error
     5209     :
     5210           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdspoatr-name in g#attr-lib
     5211         (input  p-code
     5212         ,output p-type
     5213         ,output p-format
     5214         ,output p-label
     5215         ,output p-user-can-edit
     5216         ,output p-output-display
     5217         ,output p-other
     5218         ) no-error .
