     5143   define variable v-file-name-ext    as character no-undo .
     5144   define variable v-end-new-line     as logical no-undo .
     5145   define variable v-last-error-message as character no-undo .
     5146   define variable v-retry-action as integer no-undo .
     5147   define variable v_dataseth as handle no-undo .
     5148   define variable v-xmlh as handle no-undo .
     5149   define variable v-last-rec-ord as integer no-undo .
     5150   define variable dif-nam1 as logical no-undo init yes.
     5151   define variable dif-nam2 as logical no-undo init no.
     5152   define variable dif-pdbc as logical no-undo init no.
     5153   define variable unq-artc as logical no-undo init no.
     5154   define variable is-prt  as logical no-undo .
     5155   define variable is-jwlr as logical no-undo.
     5156   define variable is-bttl as logical no-undo.
     5157   define variable is-ptrl as logical no-undo.
     5158   define variable custvalue      as character no-undo.
