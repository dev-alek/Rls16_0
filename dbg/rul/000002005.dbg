     1797   define variable v-xmllib-log-handle         as handle       no-undo .
     1798   define variable v-xmllib-log-proc-name      as character    no-undo .
     1799   define variable v-xmllib-error-status       as logical      no-undo .
     1800   define variable v-xmllib-sax-reader-handle  as handle       no-undo .
     1801   define variable v-xmllib-prg-bar-handle     as handle       no-undo .
     1802   define variable v-xmllib-codepage-convert   as logical      no-undo .
     1803   define variable v-xmllib-codepage-source    as character    no-undo .
     1804   define variable v-xmllib-codepage-target    as character    no-undo .
     1805   procedure xmllib-clear-parse-data :
     1806   do
     1807   on error undo, return error
     1808   :
     1809       empty temp-table temp_xmllib_rec-list.
     1810       empty temp-table temp_xmllib_rec-fld-list.
     1811       empty temp-table temp_xmllib_rec.
     1812       empty temp-table temp_xmllib_rec-fld.
     1813   end.
     1814   end procedure.
     1815   procedure xmllib-add-rec-fld :
     1816   define input parameter p-rec-name       as character        no-undo.
     1817   define input parameter p-rec-fld-name   as character        no-undo.
     1818       define buffer buf_rec-list        for temp_xmllib_rec-list.
     1819       define buffer buf_rec-fld-list    for temp_xmllib_rec-fld-list.
     1820   do
     1821   for buf_rec-list
     1822     , buf_rec-fld-list
     1823   on error undo, return error
     1824   :
     1825       find first buf_rec-list
     1826            where buf_rec-list.recName = p-rec-name
     1827       no-error.
     1828       if not available buf_rec-list
     1829       then do:
     1830           create buf_rec-list.
     1831           assign
     1832               buf_rec-list.recName        = p-rec-name
     1833               buf_rec-list.recOpenLine    = 0
     1834               buf_rec-list.recCloseLine   = 0
     1835               buf_rec-list.closed         = yes
     1836           .
     1837       end.
     1838       find first buf_rec-fld-list
     1839            where buf_rec-fld-list.recName = p-rec-name
     1840              and buf_rec-fld-list.fldName = p-rec-fld-name
     1841       no-error.
     1842       if not available buf_rec-fld-list
     1843       then do:
     1844           create buf_rec-fld-list.
     1845           assign
     1846               buf_rec-fld-list.recName        = p-rec-name
     1847               buf_rec-fld-list.fldName        = p-rec-fld-name
     1848               buf_rec-fld-list.fldOpenLine    = 0
     1849               buf_rec-fld-list.fldCloseLine   = 0
     1850               buf_rec-fld-list.closed         = yes
     1851           .
     1852       end.
     1853   end.
     1854   end procedure.
     1855   procedure xmllib-tag-open:
     1856   define input parameter v-tag-level  as integer      no-undo.
     1857   define input parameter v-tag-name   as character    no-undo.
     1858   define input parameter v-tag-value  as character    no-undo.
     1859   do
     1860   on error undo, return error
     1861   :
     1862       assign
     1863           v-tag-name = trim( v-tag-name )
     1864       .
     1865       put stream stmXMLOut unformatted
     1866           substitute( "&1&2<&3&4&5>"
     1867               , chr(10)
     1868               , fill(" ", 4 * v-tag-level)
     1869               , v-tag-name
     1870               , ( if v-tag-value = "":U or v-tag-value = ? then "":U else " ":U )
     1871               , v-tag-value
     1872           )
     1873       .
     1874   end.
     1875   end procedure.
     1876   procedure xmllib-tag-put:
     1877   define input parameter v-tag-level      as integer      no-undo.
     1878   define input parameter v-tag-name       as character    no-undo.
     1879   define input parameter v-tag-value      as character    no-undo.
     1880   define input parameter v-empty-mode     as integer      no-undo.
     1881   do
     1882   on error undo, return error
     1883   :
     1884       assign
     1885           v-tag-name = trim( v-tag-name )
     1886       .
     1887       if  v-empty-mode = 1
     1888       or (v-empty-mode = 0 and (v-tag-value <> "":U and v-tag-value <> ?) )
     1889       or (v-empty-mode = 2 and (v-tag-value <> "":U and v-tag-value <> ? and v-tag-value <> "0":U))
     1890       or (v-empty-mode = 3 and (v-tag-value <> "":U and v-tag-value <> ? and caps(v-tag-value) <> "no":U))
     1891       then do:
     1892           run xmlchar-encode in this-procedure (
     1893                 input v-tag-value
     1894               , output v-tag-value
     1895           ).
     1896           put stream stmXMLOut unformatted
     1897               substitute( "&1&2<&3>&4</&3>"
     1898                   , chr(10)
     1899                   , fill(" ":U, 4 * v-tag-level)
     1900                   , v-tag-name
     1901                   , v-tag-value
     1902               )
     1903           .
     1904       end.
     1905   end.
     1906   end procedure.
     1907   procedure xmllib-tag-put-null :
     1908   define input parameter p-tag-level  as integer      no-undo.
     1909   define input parameter p-tag-name   as character    no-undo.
     1910   do
     1911   on error undo, return error
     1912   :
     1913       assign
     1914           p-tag-name = trim( p-tag-name )
     1915       .
     1916       put stream stmXMLOut unformatted
     1917           substitute( '&1&2<&3 nil="true" /&3>'
     1918               , chr(10)
     1919               , fill(" ":U, 4 * p-tag-level)
     1920               , p-tag-name
     1921           )
     1922       .
     1923   end.
     1924   end procedure.
     1925   procedure xmllib-tag-close:
     1926   define input parameter v-tag-level as integer      no-undo.
     1927   define input parameter v-tag-name  as character    no-undo.
     1928   do
     1929   on error undo, return error
     1930   :
     1931       assign
     1932           v-tag-name = trim( v-tag-name )
     1933       .
     1934       put stream stmXMLOut unformatted
     1935           substitute( "&1&2</&3>"
     1936               , chr(10)
     1937               , fill( " ":U, 4 * v-tag-level)
     1938               , v-tag-name
     1939           )
     1940       .
     1941   end.
     1942   end procedure.
     1943   procedure xmllib-write-log:
     1944   define input parameter v-filename   as character    no-undo.
     1945   define input parameter v-log-level  as integer      no-undo.
     1946   define input parameter v-out-string as character    no-undo.
     1947   do
     1948   on error undo, return error
     1949   :
     1950       output stream stmXMLLog to value( v-filename ) append.
     1951       put stream stmXMLLog unformatted
     1952           chr(10)
     1953       .
     1954       put stream stmXMLLog unformatted
     1955           ( if v-log-level = 0
     1956             or v-out-string = "&DLine":U
     1957             or v-out-string = "&Line":U
     1958             then "":U
     1959             else cur-time-string-sec() + " ":U )
     1960       .
     1961       put stream stmXMLLog unformatted
     1962           ( if v-out-string = "&Line":U
     1963             then fill( "-":U, 80 )
     1964             else if v-out-string = "&DLine":U
     1965                  then fill( "=":U, 80 )
     1966                  else v-out-string )
     1967       .
     1968       output stream stmXMLLog close.
     1969   end.
     1970   end procedure.
     1971   procedure xmllib-write-edt:
     1972   define input parameter v-editor-handle    as handle       no-undo.
     1973   define input parameter v-log-level        as integer      no-undo.
     1974   define input parameter v-out-string       as character    no-undo.
     1975   do
     1976   on error undo, return error
     1977   :
     1978       if valid-handle ( v-editor-handle )
     1979       then do:
     1980           v-editor-handle :move-to-eof().
     1981           v-editor-handle :insert-string( ( if v-log-level = 0
     1982                                             or v-out-string = "&DLine":U
     1983                                             or v-out-string = "&Line":U
     1984                                             then "":U
     1985                                             else cur-time-string-sec() + " ":U
     1986                                         ) ).
     1987           v-editor-handle :insert-string( ( if v-out-string = "&Line":U
     1988                                             then fill( "-":U, 80 )
     1989                                             else if v-out-string = "&DLine":U then fill("=":U, 80)
     1990                                             else fill( " ":U, v-log-level) + v-out-string
     1991                                         ) ).
     1992           v-editor-handle :insert-string( chr(10) ).
     1993       end.
     1994   end.
     1995   end procedure.
     1996   procedure xmllib-show-cnt:
     1997   define input parameter v-fillin-handle     as handle   no-undo.
     1998   do
     1999   on error undo, return error
     2000   :
     2001       if valid-handle( v-fillin-handle )
     2002       then do:
     2003           assign
     2004               v-fillin-handle :visible = true
     2005           .
     2006       end.
     2007   end.
     2008   end procedure.
     2009   procedure xmllib-hide-cnt:
     2010   define input parameter v-fillin-handle     as handle   no-undo.
     2011   do
     2012   on error undo, return error
     2013   :
     2014       if valid-handle( v-fillin-handle )
     2015       then do:
     2016           assign v-fillin-handle :visible = false.
     2017       end.
     2018   end.
     2019   end procedure.
     2020   procedure xmllib-write-cnt:
     2021   define input parameter v-fillin-handle    as handle       no-undo.
     2022   define input parameter v-fillin-string    as character    no-undo.
     2023   do
     2024   on error undo, return error
     2025   :
     2026       if valid-handle( v-fillin-handle )
     2027       then do:
     2028           assign
     2029               v-fillin-handle :SCREEN-value = v-fillin-string
     2030           .
     2031       end.
     2032   end.
     2033   end procedure.
     2034   procedure xmllib-write-header:
     2035   define input parameter p-first-file     as logical      no-undo.
     2036   define input parameter p-xml-file-name  as character    no-undo.
     2037   define input parameter p-list-file-name as character    no-undo.
     2038   define input parameter p-file-number    as integer      no-undo.
     2039   define input parameter p-have-prev      as logical      no-undo.
     2040   define input parameter p-prev-filename  as character    no-undo.
     2041   define input parameter p-parameter-list as character    no-undo.
     2042       define variable v-counter    as integer        no-undo.
     2043   do
     2044   on error undo, return error
     2045   :
     2046       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     2047       put stream stmXMLOut unformatted
     2048           "<?xml version='1.0' encoding='windows-1251'?>"
     2049       .
     2050       run xmllib-tag-open( input 0, input "root"          , input "":U ).
     2051       run xmllib-tag-open( input 0, input "THheader"        , input "":U ).
     2052       run xmllib-tag-put( input 1 , input "THfileName"      , input p-xml-file-name + "xml":U  , input 0 ).
     2053       run xmllib-tag-put( input 1 , input "THfileNumber"    , input string( p-file-number     ), input 0 ).
     2054       run xmllib-tag-put( input 1 , input "THhavePrev"      , input string( p-have-prev       ), input 3 ).
     2055       run xmllib-tag-put( input 1 , input "THprevFileName"  , input p-prev-filename            , input 0 ).
     2056       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     2057       :
     2058           run xmllib-tag-put(
     2059                 input 1
     2060               , input entry( 2 * v-counter, p-parameter-list )
     2061               , input entry( 2 * v-counter + 1, p-parameter-list )
     2062               , input 0
     2063           ).
     2064       end.
     2065       run xmllib-tag-close( input 0, input "THheader" ).
     2066       output stream stmXMLOut close.
     2067       if p-list-file-name <> "":U
     2068       then do:
     2069           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     2070           if p-first-file = yes
     2071           then do:
     2072               put stream stmXMLOut unformatted
     2073                   "<?xml version='1.0' encoding='windows-1251'?>"
     2074               .
     2075               run xmllib-tag-open( input 0, input "OpenXML", input "" ).
     2076           end.
     2077           run xmllib-tag-open( input 1, input "THfile", input "" ).
     2078           run xmllib-tag-put( input 2, input "THfileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     2079           run xmllib-tag-put( input 2, input "THfileNumber"     , input string( p-file-number     ), input 0 ).
     2080           run xmllib-tag-put( input 2, input "THhavePrev"       , input string( p-have-prev       ), input 3 ).
     2081           run xmllib-tag-put( input 2, input "THprevFileName"   , input p-prev-filename            , input 0 ).
     2082           do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     2083           :
     2084               run xmllib-tag-put(
     2085                   input 2
     2086                   , input entry( 2 * v-counter, p-parameter-list )
     2087                   , input entry( 2 * v-counter + 1, p-parameter-list )
     2088                   , input 0
     2089               ).
     2090           end.
     2091           run xmllib-tag-close( input 1, input "THfile" ).
     2092           output stream stmXMLOut close.
     2093       end.
     2094   end.
     2095   end procedure.
     2096   procedure xmllib-write-footer:
     2097   define input parameter p-last-file      as logical      no-undo.
     2098   define input parameter p-xml-file-name  as character    no-undo.
     2099   define input parameter p-list-file-name as character    no-undo.
     2100   define input parameter p-have-next      as logical      no-undo.
     2101   define input parameter p-next-file-name as character    no-undo.
     2102       define variable v-error-num     as integer           no-undo.
     2103   do
     2104   on error undo, return error
     2105   :
     2106       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     2107       if p-have-next = yes
     2108       then do:
     2109           run xmllib-tag-open( input 0, input "footer", "" ).
     2110           run xmllib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     2111           run xmllib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     2112           run xmllib-tag-close( input 0, input "footer" ).
     2113       end.
     2114       run xmllib-tag-close( input 0, input "root" ).
     2115       output stream stmXMLOut close.
     2116       run bge/os_copy.p (
     2117             input "M"
     2118           , input p-xml-file-name + "tmp"
     2119           , input p-xml-file-name + "xml"
     2120           , output v-error-num
     2121       ).
     2122       if p-last-file = yes
     2123       and p-list-file-name <> "":U
     2124       then do:
     2125           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     2126               run xmllib-tag-close( input 0, input "OpenXML" ).
     2127           output stream stmXMLOut close.
     2128           run bge/os_copy.p (
     2129                 input "M"
     2130               , input p-list-file-name + "tmp"
     2131               , input p-list-file-name + "xml":U
     2132               , output v-error-num
     2133           ).
     2134       end.
     2135   end.
     2136   end procedure.
     2137   procedure xmllib-filename :
     2138   define input parameter p-subdir             as character        no-undo.
     2139   define input parameter p-prefix             as character    no-undo.
     2140   define output parameter p-xml-file-name     as character    no-undo.
     2141   define output parameter p-log-file-name     as character    no-undo.
     2142   define output parameter p-list-file-name    as character    no-undo.
     2143       define variable v-home-dir  as character    no-undo.
     2144       define variable v-error-num as integer      no-undo.
     2145   do
     2146   on error undo, return error
     2147   :
     2148       get-key-value section "OXML" key "oxml-dir" value v-home-dir.
     2149       if v-home-dir = ?
     2150       then do:
     2151           message
     2152             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     2153             skip "Нет параметра oxml-dir в секции [OXML]."
     2154             skip(1)
     2155             skip "Обратитесь к администратору."
     2156           view-as alert-box error.
     2157           undo, return error .
     2158       end.
     2159       if p-subdir <> "":U
     2160       then do:
     2161           assign
     2162               v-home-dir = substitute( "&1/out/&2", v-home-dir, p-subdir )
     2163           .
     2164       end.
     2165       run gbl/dir-cre.p (
     2166           input v-home-dir
     2167       ) no-error.
     2168       if error-status :error
     2169       then do:
     2170           message
     2171             skip "Неверно задан каталог экспорта в ini-файле."
     2172             skip "Не удаётся создать каталог, указанный параметром"
     2173             skip "oxml-dir в секции [OXML]."
     2174             skip(1)
     2175             skip "Обратитесь к администратору."
     2176           view-as alert-box error.
     2177           undo, return error .
     2178       end.
     2179       run bge/genfname.p (
     2180             input v-home-dir
     2181           , input p-prefix
     2182           , input ""
     2183           , input "xml"
     2184           , input "tmp"
     2185           , output p-xml-file-name
     2186       ).
     2187       assign
     2188           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     2189           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     2190           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     2191       .
     2192   end.
     2193   end procedure.
     2194   procedure xmllib-check-file-size :
     2195   define input parameter p-out-filename   as character    no-undo.
     2196   define output parameter p-is-big        as logical      no-undo.
     2197       define variable v-current-position    as integer        no-undo.
     2198   do
     2199   on error undo, return error
     2200   :
     2201       assign
     2202           v-current-position = seek( stmXMLOut )
     2203       .
     2204       if v-current-position / 1024 / 1024  >= 100
     2205       then do:
     2206           assign
     2207               p-is-big = yes
     2208           .
     2209       end.
     2210   end.
     2211   end procedure.
     2212   procedure xmllib-parse-file :
     2213   define input parameter p-full-filename      as character        no-undo.
     2214       define variable v-num-dirs              as integer      no-undo .
     2215       define variable v-str                   as character    no-undo .
     2216       define variable v-str-count             as int64        no-undo .
     2217   do
     2218   on error undo, return error
     2219   :
     2220       assign
     2221           v-num-dirs              = num-entries( p-full-filename,"\/":U )
     2222           v-xmllib-error-status   = no
     2223       .
     2224       if v-num-dirs > 1
     2225       then do:
     2226           assign
     2227               v-xmllib-filename = entry( v-num-dirs, p-full-filename, "\/":U )
     2228               v-xmllib-dirname  = substring( p-full-filename, 1, length( p-full-filename ) - length( v-xmllib-filename ) - 1 )
     2229           .
     2230       end.
     2231       else do:
     2232           assign
     2233               v-xmllib-filename = p-full-filename
     2234               v-xmllib-dirname  = "":U
     2235           .
     2236       end.
     2237       if valid-handle(v-xmllib-prg-bar-handle)
     2238       then do:
     2239   if session :set-wait-state( "compiler" ) then.
     2240         input stream strXMLIn from value(p-full-filename) .
     2241         repeat
     2242         :
     2243           import stream strXMLIn unformatted v-str no-error .
     2244           assign
     2245             v-str-count = v-str-count + 1
     2246           .
     2247         end.
     2248         input stream strXMLIn close .
     2249   if session :set-wait-state( "" ) then.
     2250         run prg-bar_init-cb-handle in this-procedure ( input v-xmllib-prg-bar-handle ) .
     2251         run prg-bar_new in this-procedure ( input 1 , input v-str-count) .
     2252         run prg-bar_show in this-procedure .
     2253       end.
     2254       create sax-reader v-xmllib-sax-reader-handle.
     2255       v-xmllib-sax-reader-handle :set-input-source( "FILE":U, p-full-filename ).
     2256       v-xmllib-sax-reader-handle :sax-parse( ) no-error.
     2257       if error-status :error
     2258       then do:
     2259           run xmllib-parse-error in this-procedure ( input substitute("&1 &2 &3&4Ошибка обработки XML файла.&4&5&4&5&4&7&4&8"
     2260                                                                       ,vss-workfile
     2261                                                                       ,vss-revision
     2262                                                                       ,vss-description
     2263                                                                       ,chr(10)
     2264                                                                       ,return-value
     2265                                                                       ,trim(error-status :get-message(1))
     2266                                                                       ,trim(error-status :get-message(2))
     2267                                                                       ,trim(error-status :get-message(3)))
     2268                                                     ).
     2269           undo, return error .
     2270       end.
     2271       if v-xmllib-error-status <> no
     2272       then do:
     2273           run xmllib-parse-error in this-procedure (
     2274               input "*** При обработке XML файла были ошибки."
     2275           ).
     2276           delete object v-xmllib-sax-reader-handle.
     2277       end.
     2278       delete object v-xmllib-sax-reader-handle.
     2279       if valid-handle(v-xmllib-prg-bar-handle)
     2280       then do:
     2281         run prg-bar_delete in this-procedure .
     2282       end.
     2283   end.
     2284   end procedure.
     2285   procedure xmllib-parse-progressive :
     2286   define input parameter p-full-filename      as character no-undo .
     2287   define input parameter p-pack-data          as memptr no-undo .
     2288   define input parameter p-parse-first        as logical no-undo .
     2289   define input parameter p-first-err          as logical no-undo .
     2290   define output parameter p-parse-status as integer no-undo .
     2291   define variable v-num-dirs              as integer no-undo .
     2292   define variable glog                    as logical no-undo .
     2293   define variable v-pack-size             as int64 no-undo .
     2294   do
     2295   on error undo, return error
     2296   :
     2297     if p-parse-first then do:
     2298       if valid-handle(v-xmllib-sax-reader-handle)
     2299       then do:
     2300       end.
     2301       assign
     2302           v-num-dirs              = num-entries( p-full-filename,"\/":U )
     2303           v-xmllib-error-status   = no
     2304       .
     2305       if v-num-dirs > 1
     2306       then do:
     2307           assign
     2308               v-xmllib-filename = entry( v-num-dirs, p-full-filename, "\/":U )
     2309               v-xmllib-dirname  = substring( p-full-filename, 1, length( p-full-filename ) - length( v-xmllib-filename ) - 1 )
     2310           .
     2311       end.
     2312       else do:
     2313           assign
     2314               v-xmllib-filename = p-full-filename
     2315               v-xmllib-dirname  = "":U
     2316           .
     2317       end.
     2318       create sax-reader v-xmllib-sax-reader-handle.
     2319       v-pack-size = get-size (p-pack-data) .
     2320       if v-pack-size > 0 then
     2321         glog = v-xmllib-sax-reader-handle :set-input-source( "MEMPTR":U, p-pack-data ) no-error.
     2322       else
     2323         glog = v-xmllib-sax-reader-handle :set-input-source( "FILE":U, p-full-filename ) no-error.
     2324       if error-status :error
     2325       or not glog
     2326       then do:
     2327         delete object v-xmllib-sax-reader-handle.
     2328         run xmllib-parse-error in this-procedure ( input substitute("&1 &2 &3&4Ошибка обработки XML файла.&4&5&4&5&4&7&4&8"
     2329                                                                     ,vss-workfile
     2330                                                                     ,vss-revision
     2331                                                                     ,vss-description
     2332                                                                     ,chr(10)
     2333                                                                     ,return-value
     2334                                                                     ,trim(error-status :get-message(1))
     2335                                                                     ,trim(error-status :get-message(2))
     2336                                                                     ,trim(error-status :get-message(3)) )
     2337                                                   ).
     2338         undo, return error .
     2339       end.
     2340       v-xmllib-sax-reader-handle :sax-parse-first( ) no-error.
     2341     end.
     2342     else do:
     2343       v-xmllib-sax-reader-handle :sax-parse-next( ) no-error.
     2344     end.
     2345     if error-status :error
     2346     then do:
     2347       delete object v-xmllib-sax-reader-handle.
     2348       run xmllib-parse-error in this-procedure ( input substitute("&1 &2 &3&4Ошибка обработки XML файла.&4&5&4&5&4&7&4&8"
     2349                                                                   ,vss-workfile
     2350                                                                   ,vss-revision
     2351                                                                   ,vss-description
     2352                                                                   ,chr(10)
     2353                                                                   ,return-value
     2354                                                                   ,trim(error-status :get-message(1))
     2355                                                                   ,trim(error-status :get-message(2))
     2356                                                                   ,trim(error-status :get-message(3)) )
     2357                                                 ).
     2358       undo, return error .
     2359     end.
     2360     if v-xmllib-error-status <> no
     2361     then do:
     2362       run xmllib-parse-error in this-procedure (
     2363           input "*** При обработке XML файла были ошибки."
     2364       ).
     2365       if p-first-err then do:
     2366         delete object v-xmllib-sax-reader-handle.
     2367       end.
     2368       else do:
     2369         v-xmllib-error-status = no.
     2370       end.
     2371     end.
     2372     if v-xmllib-sax-reader-handle:parse-status = SAX-COMPLETE  then do:
     2373       p-parse-status = SAX-COMPLETE.
     2374       delete object v-xmllib-sax-reader-handle.
     2375       return '':U.
     2376     end.
     2377     else do:
     2378       p-parse-status = v-xmllib-sax-reader-handle:parse-status.
     2379       return '':U.
     2380     end.
     2381   end.
     2382   end procedure.
     2383   procedure StartElement :
     2384   define input parameter p-name-space     as character        no-undo.
     2385   define input parameter p-local-name     as character        no-undo.
     2386   define input parameter p-q-name         as character        no-undo.
     2387   define input parameter p-attributes     as handle           no-undo.
     2388       define buffer buf_rec             for temp_xmllib_rec.
     2389       define buffer buf_rec-fld         for temp_xmllib_rec-fld.
     2390       define buffer buf_rec-list        for temp_xmllib_rec-list.
     2391       define buffer buf_rec-fld-list    for temp_xmllib_rec-fld-list.
     2392   do
     2393   for buf_rec
     2394     , buf_rec-fld
     2395     , buf_rec-list
     2396     , buf_rec-fld-list
     2397   on error undo, return error
     2398   :
     2399       if valid-handle(v-xmllib-prg-bar-handle)
     2400       then do:
     2401         run prg-bar_stepto in this-procedure ( input SELF:LOCATOR-LINE-NUMBER ) .
     2402       end.
     2403       find first buf_rec-list
     2404            where buf_rec-list.recName = p-q-name
     2405       no-error.
     2406       if available buf_rec-list
     2407       then do:
     2408           if buf_rec-list.closed = no
     2409           then do:
     2410               find first buf_rec-fld-list
     2411                    where buf_rec-fld-list.recName = buf_rec-list.recName
     2412                      and buf_rec-fld-list.fldName = p-q-name
     2413               no-error.
     2414               if available buf_rec-fld-list
     2415               and buf_rec-list.recName = buf_rec-fld-list.recName
     2416               then do:
     2417                   if buf_rec-fld-list.closed = no
     2418                   then do:
     2419                       run xmllib-parse-error in this-procedure (
     2420                           input substitute( "Ошибка 1 открытия поля <&1> записи <&2>: Поле с этим именем уже открыто на строке &3."
     2421                                           , p-q-name
     2422                                           , p-q-name
     2423                                           , buf_rec-fld-list.fldOpenLine
     2424                                           )
     2425                       ).
     2426                   end.
     2427                   else do:
     2428                       run xmllib-parse-rec-fld-open in this-procedure (
     2429                             input buf_rec-list.recName
     2430                           , input buf_rec-list.recLevel
     2431                           , input buf_rec-fld-list.fldName
     2432                       ).
     2433                       assign
     2434                           buf_rec-fld-list.closed         = no
     2435                           buf_rec-fld-list.fldOpenLine    = v-xmllib-sax-reader-handle :locator-line-number
     2436                           buf_rec-fld-list.fldCloseLine   = 0
     2437                       .
     2438                   end.
     2439               end.
     2440               else do:
     2441                   assign
     2442                       buf_rec-list.recLevel = buf_rec-list.recLevel + 1
     2443                   .
     2444                   run xmllib-parse-rec-open in this-procedure (
     2445                         input buf_rec-list.recName
     2446                       , input buf_rec-list.recLevel
     2447                   ).
     2448                   assign
     2449                       buf_rec-list.closed         = no
     2450                       buf_rec-list.recOpenLine    = v-xmllib-sax-reader-handle :locator-line-number
     2451                       buf_rec-list.recCloseLine   = 0
     2452                   .
     2453               end.
     2454           end.
     2455           else do:
     2456               run xmllib-parse-rec-open in this-procedure (
     2457                     input buf_rec-list.recName
     2458                   , input buf_rec-list.recLevel
     2459               ).
     2460               assign
     2461                   buf_rec-list.closed         = no
     2462                   buf_rec-list.recOpenLine    = v-xmllib-sax-reader-handle :locator-line-number
     2463                   buf_rec-list.recCloseLine   = 0
     2464               .
     2465           end.
     2466       end.
     2467       else do:
     2468           open-record:
     2469           for each buf_rec-fld-list
     2470              where buf_rec-fld-list.fldName = p-q-name
     2471           :
     2472               find first buf_rec-list
     2473                    where buf_rec-list.recName = buf_rec-fld-list.recName
     2474                      and buf_rec-list.closed  = no
     2475               no-error.
     2476               if available buf_rec-list
     2477               then do:
     2478                   run xmllib-parse-rec-fld-open in this-procedure (
     2479                         input buf_rec-list.recName
     2480                       , input buf_rec-list.recLevel
     2481                       , input buf_rec-fld-list.fldName
     2482                   ).
     2483                   assign
     2484                       buf_rec-fld-list.recLevel       = buf_rec-list.recLevel
     2485                       buf_rec-fld-list.closed         = no
     2486                       buf_rec-fld-list.fldOpenLine    = v-xmllib-sax-reader-handle :locator-line-number
     2487                       buf_rec-fld-list.fldCloseLine   = 0
     2488                   .
     2489                   leave open-record.
     2490               end.
     2491           end.
     2492       end.
     2493   end.
     2494   end procedure.
     2495   procedure Characters :
     2496   define input parameter p-char-data  as memptr.
     2497   define input parameter p-numchars   as integer.
     2498       define variable v-data-string    as character    no-undo.
     2499       define variable v-cp-utf8           as integer no-undo init 65001 .
     2500       define variable v-cp-windows1251    as integer no-undo init 1251 .
     2501       define buffer buf_xmllib_rec             for temp_xmllib_rec.
     2502       define buffer buf_xmllib_rec-fld         for temp_xmllib_rec-fld.
     2503       define buffer buf_xmllib_rec-list        for temp_xmllib_rec-list.
     2504       define buffer buf_xmllib_rec-fld-list    for temp_xmllib_rec-fld-list.
     2505   do
     2506   for buf_xmllib_rec
     2507     , buf_xmllib_rec-fld
     2508     , buf_xmllib_rec-list
     2509     , buf_xmllib_rec-fld-list
     2510   on error undo, return error
     2511   :
     2512       find first buf_xmllib_rec-list
     2513            where buf_xmllib_rec-list.closed = no
     2514       no-error.
     2515       if available buf_xmllib_rec-list
     2516       then do:
     2517           find first buf_xmllib_rec-fld-list
     2518                where buf_xmllib_rec-fld-list.closed = no
     2519           no-error.
     2520           if available buf_xmllib_rec-fld-list
     2521           and buf_xmllib_rec-fld-list.recName  = buf_xmllib_rec-list.recName
     2522           and buf_xmllib_rec-fld-list.recLevel = buf_xmllib_rec-list.recLevel
     2523           then do:
     2524               find last buf_xmllib_rec
     2525                   where buf_xmllib_rec.recName  = buf_xmllib_rec-list.recName
     2526                     and buf_xmllib_rec.recLevel = buf_xmllib_rec-list.recLevel
     2527                     and buf_xmllib_rec.closed   = no
     2528               use-index nm
     2529               no-error.
     2530               if available buf_xmllib_rec
     2531               then do:
     2532                   find last buf_xmllib_rec-fld
     2533                       where buf_xmllib_rec-fld.rec-key = buf_xmllib_rec.rec-key
     2534                         and buf_xmllib_rec-fld.fldName = buf_xmllib_rec-fld-list.fldName
     2535                         and buf_xmllib_rec-fld.closed = no
     2536                   use-index nm
     2537                   no-error.
     2538                   if available buf_xmllib_rec-fld
     2539                   then do:
     2540                       assign
     2541                           v-data-string = get-string( p-char-data, 1, get-size( p-char-data ) )
     2542                       .
     2543                       if v-xmllib-codepage-convert = yes
     2544                       then do:
     2545                         assign
     2546                             v-data-string = codepage-convert( v-data-string , v-xmllib-codepage-target , v-xmllib-codepage-source )
     2547                         .
     2548                       end.
     2549                       run xmlchar-decode in this-procedure (
     2550                           input v-data-string
     2551                           , output v-data-string
     2552                       ).
     2553                       assign
     2554                           buf_xmllib_rec-fld.fldValue = trim( substitute( "&1&2", buf_xmllib_rec-fld.fldValue, v-data-string ) )
     2555                       .
     2556                   end.
     2557               end.
     2558           end.
     2559       end.
     2560   end.
     2561   end procedure.
     2562   procedure EndElement :
     2563   define input parameter p-name-space     as character        no-undo.
     2564   define input parameter p-local-name     as character        no-undo.
     2565   define input parameter p-q-name         as character        no-undo.
     2566       define buffer buf_rec             for temp_xmllib_rec.
     2567       define buffer buf_rec-fld         for temp_xmllib_rec-fld.
     2568       define buffer buf_rec-list        for temp_xmllib_rec-list.
     2569       define buffer buf_rec-fld-list    for temp_xmllib_rec-fld-list.
     2570   do
     2571   for buf_rec
     2572     , buf_rec-fld
     2573     , buf_rec-list
     2574     , buf_rec-fld-list
     2575   on error undo, return error
     2576   :
     2577       find last buf_rec-list
     2578           where buf_rec-list.recName = p-q-name
     2579       use-index pi
     2580       no-error.
     2581       if available buf_rec-list
     2582       then do:
     2583           if buf_rec-list.closed = yes
     2584           then do:
     2585               run xmllib-parse-error in this-procedure (
     2586                   input substitute( "Ошибка закрытия записи или поля <&1>: Нет метки открытой записи."
     2587                                   , p-q-name
     2588                                   )
     2589               ).
     2590           end.
     2591           else do:
     2592               find last buf_rec
     2593                   where buf_rec.recName  = buf_rec-list.recName
     2594                     and buf_rec.recLevel = buf_rec-list.recLevel
     2595                     and buf_rec.closed   = no
     2596               use-index nm
     2597               no-error.
     2598               if not available buf_rec
     2599               then do:
     2600                   run xmllib-parse-error in this-procedure (
     2601                       input substitute( "Ошибка закрытия записи или поля <&1> уровня &2: Нет открытой записи."
     2602                                       , p-q-name
     2603                                       , buf_rec-list.recLevel
     2604                                       )
     2605                   ).
     2606               end.
     2607               else do:
     2608                   find first buf_rec-fld-list
     2609                        where buf_rec-fld-list.recName  = buf_rec.recName
     2610                          and buf_rec-fld-list.recLevel = buf_rec.recLevel
     2611                          and buf_rec-fld-list.fldName  = p-q-name
     2612                          and buf_rec-fld-list.closed   = no
     2613                   no-error.
     2614                   if not available buf_rec-fld-list
     2615                   then do:
     2616                       if buf_rec.recName <> p-q-name
     2617                       then do:
     2618                           run xmllib-parse-error in this-procedure (
     2619                               input substitute( "Ошибка закрытия записи <&1>: Имя открытой записи не совпадает с именем метки."
     2620                                               , buf_rec.recName
     2621                                               )
     2622                           ).
     2623                       end.
     2624                       else do:
     2625                           assign
     2626                               buf_rec.closed              = yes
     2627                               buf_rec.recCloseLine        = v-xmllib-sax-reader-handle :locator-line-number
     2628                               buf_rec-list.recCloseLine   = v-xmllib-sax-reader-handle :locator-line-number
     2629                           .
     2630                           if buf_rec-list.recLevel > 0
     2631                           then do:
     2632                               assign
     2633                                   buf_rec-list.recLevel = buf_rec-list.recLevel - 1
     2634                               .
     2635                               for each buf_rec-fld-list
     2636                                  where buf_rec-fld-list.recName = buf_rec-list.recName
     2637                               :
     2638                                   assign
     2639                                       buf_rec-fld-list.recLevel = buf_rec-fld-list.recLevel - 1
     2640                                   .
     2641                               end.
     2642                           end.
     2643                           else do:
     2644                               assign
     2645                                   buf_rec-list.closed         = yes
     2646                               .
     2647                           end.
     2648                       end.
     2649                   end.
     2650                   else do:
     2651                       find last buf_rec-fld
     2652                           where buf_rec-fld.rec-key = buf_rec.rec-key
     2653                             and buf_rec-fld.fldName = buf_rec-fld-list.fldName
     2654                             and buf_rec-fld.closed  = no
     2655                       use-index nm
     2656                       no-error.
     2657                       if not available buf_rec-fld
     2658                       then do:
     2659                           run xmllib-parse-error in this-procedure (
     2660                               input substitute( "Ошибка 2 закрытия поля <&1>: Не найдено открытое поле с этим именем в записи <&2> уровня &3."
     2661                                               , buf_rec-fld-list.fldName
     2662                                               , buf_rec.recName
     2663                                               , buf_rec.recLevel
     2664                                               )
     2665                           ).
     2666                       end.
     2667                       else do:
     2668                           assign
     2669                               buf_rec-fld.closed              = yes
     2670                               buf_rec-fld-list.closed         = yes
     2671                               buf_rec-fld.fldCloseLine        = v-xmllib-sax-reader-handle :locator-line-number
     2672                               buf_rec-fld-list.fldCloseLine   = v-xmllib-sax-reader-handle :locator-line-number
     2673                           .
     2674                       end.
     2675                   end.
     2676               end.
     2677           end.
     2678       end.
     2679       else do:
     2680           close-field-rec:
     2681           for each buf_rec-fld-list
     2682              where buf_rec-fld-list.fldName = p-q-name
     2683           :
     2684               find first buf_rec-list
     2685                    where buf_rec-list.recName  = buf_rec-fld-list.recName
     2686                      and buf_rec-list.recLevel = buf_rec-fld-list.recLevel
     2687                      and buf_rec-list.closed   = no
     2688               no-error.
     2689               if available buf_rec-list
     2690               then do:
     2691                   find last buf_rec
     2692                       where buf_rec.recName  = buf_rec-list.recName
     2693                         and buf_rec.recLevel = buf_rec-list.recLevel
     2694                         and buf_rec.closed   = no
     2695                   use-index nm
     2696                   no-error.
     2697                   if not available buf_rec
     2698                   then do:
     2699                       run xmllib-parse-error in this-procedure (
     2700                           input substitute( "Ошибка закрытия поля <&1>: Нет открытой записи."
     2701                                           , p-q-name
     2702                                           )
     2703                       ).
     2704                   end.
     2705                   else do:
     2706                       find last buf_rec-fld
     2707                           where buf_rec-fld.rec-key = buf_rec.rec-key
     2708                             and buf_rec-fld.fldName = buf_rec-fld-list.fldName
     2709                             and buf_rec-fld.closed  = no
     2710                       use-index nm
     2711                       no-error.
     2712                       if not available buf_rec-fld
     2713                       then do:
     2714                           run xmllib-parse-error in this-procedure (
     2715                               input substitute( "Ошибка 1 закрытия поля <&1>: Не найдено открытое поле с этим именем в записи <&2> уровня &3."
     2716                                               , buf_rec-fld-list.fldName
     2717                                               , buf_rec.recName
     2718                                               , buf_rec.recLevel
     2719                                               )
     2720                           ).
     2721                       end.
     2722                       else do:
     2723                           assign
     2724                               buf_rec-fld.closed              = yes
     2725                               buf_rec-fld-list.closed         = yes
     2726                               buf_rec-fld.fldCloseLine        = v-xmllib-sax-reader-handle :locator-line-number
     2727                               buf_rec-fld-list.fldCloseLine   = v-xmllib-sax-reader-handle :locator-line-number
     2728                           .
     2729                       end.
     2730                   end.
     2731                   leave close-field-rec.
     2732               end.
     2733           end.
     2734       end.
     2735   end.
     2736   end procedure.
     2737   procedure Error :
     2738   define input parameter p-error-message     as character        no-undo.
     2739   do
     2740   on error undo, return error
     2741   :
     2742       run xmllib-parse-error in this-procedure (
     2743           input p-error-message
     2744       ).
     2745       assign
     2746           v-xmllib-error-status = yes
     2747       .
     2748   end.
     2749   end procedure.
     2750   procedure xmllib-parse-error :
     2751   define input parameter p-err-message    as character        no-undo.
     2752   do
     2753   on error undo, return error
     2754   :
     2755       if valid-handle(v-xmllib-log-handle) then do:
     2756         run value(v-xmllib-log-proc-name) in  v-xmllib-log-handle
     2757                  (input substitute("&1Файл:    &2 &3&1Строка &4&1&5"
     2758                                    ,chr(10)
     2759                                    ,v-xmllib-dirname
     2760                                    ,v-xmllib-filename
     2761                                    ,(if valid-handle(v-xmllib-sax-reader-handle)
     2762                                      then v-xmllib-sax-reader-handle :locator-line-number
     2763                                      else ?)
     2764                                    ,p-err-message)).
     2765       end.
     2766       else do:
     2767         if v-xmllib-log-filename = "":U
     2768         then do:
     2769             message
     2770                     vss-workfile vss-revision vss-description
     2771                 skip "Файл:   " v-xmllib-dirname v-xmllib-filename
     2772                 skip "Строка: " (if valid-handle(v-xmllib-sax-reader-handle)
     2773                                  then v-xmllib-sax-reader-handle :locator-line-number
     2774                                  else ?)
     2775                 skip(1)
     2776                 skip p-err-message
     2777                 skip return-value
     2778                 skip trim( error-status :get-message( 1 ) )
     2779                     trim( error-status :get-message( 2 ) )
     2780                     trim( error-status :get-message( 3 ) )
     2781             view-as alert-box error.
     2782             undo, return error.
     2783         end.
     2784         else do:
     2785           output to value( v-xmllib-log-filename ).
     2786           put unformatted
     2787               substitute( "&1&2", chr(10), p-err-message )
     2788           .
     2789           output close.
     2790         end.
     2791       end.
     2792   end.
     2793   end procedure.
     2794   procedure xmllib-set-log-filename :
     2795   define input parameter p-log-filename   as character        no-undo.
     2796   do
     2797   on error undo, return error
     2798   :
     2799       run gbl/fileapnd.p (
     2800             input p-log-filename
     2801           , input "":U
     2802           , input 10
     2803       ) no-error.
     2804       if error-status :error
     2805       then do:
     2806           assign
     2807               v-xmllib-log-filename = "":U
     2808           .
     2809       end.
     2810       else do:
     2811           assign
     2812               v-xmllib-log-filename = p-log-filename
     2813           .
     2814       end.
     2815   end.
     2816   end procedure.
     2817   procedure xmllib-set-log-handle :
     2818   define input parameter p-log-handle    as handle        no-undo.
     2819   define input parameter p-log-proc-name as character no-undo .
     2820   do
     2821   on error undo, return error
     2822   :
     2823       if valid-handle(p-log-handle)
     2824       and lookup(p-log-proc-name, p-log-handle:internal-entries) > 0
     2825       then do:
     2826         assign
     2827         v-xmllib-log-handle    = p-log-handle
     2828         v-xmllib-log-proc-name = p-log-proc-name
     2829         .
     2830       end.
     2831       else do:
     2832         assign
     2833         v-xmllib-log-handle    = ?
     2834         v-xmllib-log-proc-name = '':U
     2835         .
     2836       end.
     2837   end.
     2838   end procedure.
     2839   procedure xmllib-set-prg-bar-handle :
     2840   define input parameter p-handle    as handle        no-undo.
     2841   do
     2842   on error undo, return error
     2843   :
     2844       if valid-handle(p-handle)
     2845       then do:
     2846         assign
     2847           v-xmllib-prg-bar-handle = p-handle
     2848         .
     2849       end.
     2850       else do:
     2851         assign
     2852           v-xmllib-prg-bar-handle = ?
     2853         .
     2854       end.
     2855   end.
     2856   end procedure.
     2857   procedure xmllib-set-codepage-convert :
     2858     define input  parameter p-codepage-source as character no-undo .
     2859     define input  parameter p-codepage-target as character no-undo .
     2860   do
     2861   on error undo, return error return-value
     2862   :
     2863     if ( p-codepage-source <> "" and p-codepage-target <> "" )
     2864     then do:
     2865       assign
     2866         v-xmllib-codepage-convert = yes
     2867         v-xmllib-codepage-source  = p-codepage-source
     2868         v-xmllib-codepage-target  = p-codepage-target
     2869       .
     2870     end.
     2871     else do:
     2872       assign
     2873         v-xmllib-codepage-convert = no
     2874         v-xmllib-codepage-source  = ""
     2875         v-xmllib-codepage-target  = ""
     2876       .
     2877     end.
     2878   end.
     2879   end procedure.
     2880   procedure xmllib-parse-rec-open :
     2881   define input parameter p-rec-name   as character        no-undo.
     2882   define input parameter p-rec-level  as integer          no-undo.
     2883       define buffer buf_temp_xmllib_rec       for temp_xmllib_rec.
     2884   do
     2885   for buf_temp_xmllib_rec
     2886   on error undo, return error
     2887   :
     2888        find first buf_temp_xmllib_rec
     2889            where buf_temp_xmllib_rec.recName = p-rec-name
     2890              and buf_temp_xmllib_rec.recLevel = p-rec-level
     2891              and buf_temp_xmllib_rec.closed  = no
     2892       use-index nm
     2893       no-error.
     2894       if available buf_temp_xmllib_rec
     2895       then do:
     2896           run xmllib-parse-error in this-procedure (
     2897               input substitute( "Ошибка 2 открытия записи <&1>: Запись с этим именем и уровнем &2 уже открыта на строке &3."
     2898                               , p-rec-name
     2899                               , p-rec-level
     2900                               , buf_temp_xmllib_rec.recOpenLine
     2901                               )
     2902           ).
     2903       end.
     2904       else do:
     2905           assign
     2906               v-xmllib-rec-key    = v-xmllib-rec-key + 1
     2907           .
     2908           create buf_temp_xmllib_rec.
     2909           assign
     2910               buf_temp_xmllib_rec.rec-key         = v-xmllib-rec-key
     2911               buf_temp_xmllib_rec.recOpenLine     = v-xmllib-sax-reader-handle :locator-line-number
     2912               buf_temp_xmllib_rec.recCloseLine    = 0
     2913               buf_temp_xmllib_rec.recName         = p-rec-name
     2914               buf_temp_xmllib_rec.recLevel        = p-rec-level
     2915               buf_temp_xmllib_rec.closed          = no
     2916           .
     2917       end.
     2918   end.
     2919   end procedure.
     2920   procedure xmllib-parse-rec-fld-open :
     2921   define input parameter p-rec-name   as character        no-undo.
     2922   define input parameter p-rec-level  as integer          no-undo.
     2923   define input parameter p-fld-name   as character        no-undo.
     2924       define buffer buf_temp_xmllib_rec       for temp_xmllib_rec.
     2925       define buffer buf_temp_xmllib_rec-fld   for temp_xmllib_rec-fld.
     2926   do
     2927   for buf_temp_xmllib_rec
     2928     , buf_temp_xmllib_rec-fld
     2929   on error undo, return error substitute( "Ошибка в xmllib-parse-rec-fld-open. &1. &2. &3"
     2930                                           , return-value
     2931                                           , trim( error-status :get-message( 1 ) )
     2932                                           , trim( error-status :get-message( 2 ) ) )
     2933   :
     2934       find last buf_temp_xmllib_rec
     2935           where buf_temp_xmllib_rec.recName   = p-rec-name
     2936             and buf_temp_xmllib_rec.recLevel  = p-rec-level
     2937             and buf_temp_xmllib_rec.closed    = no
     2938       use-index nm
     2939       no-error.
     2940       if not available buf_temp_xmllib_rec
     2941       then do:
     2942           run xmllib-parse-error in this-procedure (
     2943               input substitute( "Ошибка 2 открытия поля <&2> в записи <&1> уровня &3: Нет открытой записи."
     2944                               , p-rec-name
     2945                               , p-fld-name
     2946                               , p-rec-level
     2947                               )
     2948           ).
     2949       end.
     2950       else do:
     2951           find last buf_temp_xmllib_rec-fld
     2952               where buf_temp_xmllib_rec-fld.rec-key  = buf_temp_xmllib_rec.rec-key
     2953                 and buf_temp_xmllib_rec-fld.fldName  = p-fld-name
     2954                 and buf_temp_xmllib_rec-fld.closed   = no
     2955           use-index nm
     2956           no-error.
     2957           if available buf_temp_xmllib_rec-fld
     2958           then do:
     2959               run xmllib-parse-error in this-procedure (
     2960                   input substitute( "Ошибка 3 открытия поля <&2> в записи <&1>: Поле с этим именем уже открыто на строке &3."
     2961                                   , p-rec-name
     2962                                   , p-fld-name
     2963                                   , buf_temp_xmllib_rec-fld.fldOpenLine
     2964                                   )
     2965               ).
     2966           end.
     2967           else do:
