     1657   procedure get-header-by-rec :
     1658   define input  parameter p-gate-rec as character no-undo .
     1659   define output parameter p-tth as handle no-undo .
     1660   define variable v-ii as integer   no-undo .
     1661   define variable glog as logical   no-undo .
     1662   define variable v-rowid as rowid no-undo .
     1663   define variable v-tbl-name as character no-undo .
     1664   define variable v-longchar as longchar no-undo .
     1665   define variable v-txmlh as handle no-undo .
     1666   define buffer buf_clob-data for ub.clob-data.
     1667   main-block:
     1668   do
     1669   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info14, return-value, chr(10), error-status :get-message (1))
     1670   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info14 )
     1671   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info14 )
     1672   :
     1673     run gen-row-keyr in  this-procedure  (
     1674                                           input  p-gate-rec
     1675                                           ,input  ?
     1676                                           ,input  "ub"
     1677                                           ,input  ?
     1678                                           ,input  NO-LOCK
     1679                                           ,output v-rowid
     1680                                           ,output v-tbl-name   ) no-error.
     1681       find first buf_clob-data no-lock where
     1682                 rowid(buf_clob-data) = v-rowid  no-error.
     1683       if not available buf_clob-data then do:
     1684         undo, return error substitute("Не найден CLOB  &1"
     1685                                         , p-gate-rec
     1686                                         ).
     1687       end.
     1688       assign
     1689       v-longchar = buf_clob-data.cdata
     1690       .
     1691       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1692       if error-status :error then do:
     1693         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1694       end.
     1695       create temp-table p-tth .
     1696       glog = p-tth:READ-XMLSCHEMA( "LONGCHAR"
     1697                                     , v-longchar
     1698                                     , ?
     1699                                     , ?
     1700                                     , ?
     1701                                     ) no-error.
     1702       v-longchar = '':U.
     1703       define variable v-esm as character no-undo .
     1704       v-esm = error-status:get-message(1).
     1705       if error-status :error
     1706       or not glog
     1707       then do:
     1708         delete object p-tth no-error.
     1709         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     1710                                    , p-gate-rec
     1711                                    , buf_clob-data.file-name_
     1712                                    , chr(10)
     1713                                    , v-esm
     1714                                     ).
     1715       end.
     1716   end.
     1717   end procedure.
     1718   // { bge/getoxmlh.i } 23/VIII-2018 xmllib.i и tmpcxmlh.i вставлены напрямую
     1719   define variable vss-include-info15 as character format "X(65)" no-undo
     1720   initial "@(#)$Workfile$ $Revision$".
     1721   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1722   define stream stmXMLOut.
     1723   define stream stmXMLLog.
     1724   define stream strXMLIn.
     1725   define temp-table temp_xmllib_rec-list no-undo
