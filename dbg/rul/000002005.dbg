     1792   define variable v-xmllib-rec-key            as integer      no-undo .
     1793   define variable v-xmllib-rec-fld-key        as integer      no-undo .
     1794   define variable v-xmllib-dirname            as character    no-undo .
     1795   define variable v-xmllib-filename           as character    no-undo .
