     5349   procedure gds-ind1 :
     5350   main-block:
     5351     do
     5352   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     5353   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     5354   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     5355     :
     5356   define input-output parameter p-doc-rec  as recid no-undo.
     5357   define input  parameter p-gds-code                   like  ub.gds-obj-prop.gds-code no-undo.
     5358   define input  parameter p-obj-type                   like  ub.gds-obj-prop.obj-type no-undo.
     5359   define input  parameter p-obj-code                   like  ub.gds-obj-prop.obj-code no-undo.
     5360   define input  parameter p-gdop-igt                   like  ub.gds-obj-prop.gdop-igt no-undo.
     5361   define input  parameter p-gdop-assort-min            like  ub.gds-obj-prop.gdop-assort-min  no-undo.
     5362   define input  parameter p-gdop-min-stock             like  ub.gds-obj-prop.gdop-min-stock   no-undo.
     5363   define input  parameter p-grop-level-always-presence like  ub.gds-obj-prop.grop-level-always-presence  no-undo.
     5364   define input  parameter p-grop-max-stock             like  ub.gds-obj-prop.grop-max-stock              no-undo.
     5365   define input  parameter p-grop-min-order             like  ub.gds-obj-prop.grop-min-order              no-undo.
     5366   DEFINE INPUT  PARAMETER TABLE  FOR tt0-gds-obj-prop-attr.
     5367   define buffer buf_tt0-gds-obj-prop-attr for tt0-gds-obj-prop-attr.
     5368   define buffer bufs_gds-obj-prop for ub.gds-obj-prop.
     5369   define variable v-db-num like ub.db.db-num no-undo .
     5370   define variable v-db-num-obj like ub.db.db-num no-undo .
     5371   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5372   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     5373     (output v-db-num
     5374     )  .
     5375   define variable v-date as date no-undo .
     5376   define variable v-time as integer no-undo .
     5377   run cur-time in this-procedure(output v-date, output v-time).
     5378     find first bufs_gds-obj-prop exclusive-lock where
     5379               bufs_gds-obj-prop.gds-code          = p-gds-code   and
     5380               bufs_gds-obj-prop.obj-type          = p-obj-type   and
     5381               bufs_gds-obj-prop.obj-code          = p-obj-code  no-error .
     5382       if not available bufs_gds-obj-prop then do:
     5383           create bufs_gds-obj-prop.
     5384           assign
     5385               bufs_gds-obj-prop.gds-code           = p-gds-code
     5386               bufs_gds-obj-prop.grop-date-update   = v-date
     5387               bufs_gds-obj-prop.grop-time-update   = v-time
     5388               bufs_gds-obj-prop.grop-db-num-update = v-db-num
     5389               bufs_gds-obj-prop.obj-type           = p-obj-type
     5390               bufs_gds-obj-prop.obj-code           = p-obj-code
     5391           no-error .
     5392           if error-status :error then message "Ошибка при создании записи" error-status :error error-status :get-message(1) .
     5393       end.
     5394   if  p-gdop-igt                     <> ? then    bufs_gds-obj-prop.gdop-igt                   = p-gdop-igt.
     5395   if  p-gdop-assort-min              <> ? then    bufs_gds-obj-prop.gdop-assort-min            = p-gdop-assort-min.
     5396   if  p-gdop-min-stock               <> ? then    bufs_gds-obj-prop.gdop-min-stock             = p-gdop-min-stock  .
     5397   if  p-grop-level-always-presence   <> ? then    bufs_gds-obj-prop.grop-level-always-presence = p-grop-level-always-presence.
     5398   if  p-grop-max-stock               <> ? then    bufs_gds-obj-prop.grop-max-stock             = p-grop-max-stock           .
     5399   if  p-grop-min-order               <> ? then    bufs_gds-obj-prop.grop-min-order             = p-grop-min-order           .
     5400         p-doc-rec = recid(bufs_gds-obj-prop)    .
     5401   for each buf_tt0-gds-obj-prop-attr
     5402   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     5403   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     5404   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     5405   :
     5406     if buf_tt0-gds-obj-prop-attr.attr-value <> ?
     5407     and lookup(buf_tt0-gds-obj-prop-attr.attr-code, 'CorrIztDel':u) = 0
     5408     then do:
     5409       run gdspoatr-write in this-procedure (
     5410                                               input p-gds-code
     5411                                               ,input p-obj-type
     5412                                               ,input p-obj-code
     5413                                               ,input buf_tt0-gds-obj-prop-attr.attr-code
     5414                                               ,input buf_tt0-gds-obj-prop-attr.attr-value
     5415                                               ).
     5416     end.
     5417   end.
     5418   end.
     5419   end procedure.
     5420   define buffer bb_alc-type-gds for ub.alc-type-gds.
     5421   define buffer buf_goods for ub.goods.
     5422   define buffer buf_temp-goods-attr_ for temp-goods-attr.
     5423   function 00110003_get-error-message returns character :
     5424   define variable v-ii as integer no-undo .
     5425   define variable v-mess as character no-undo .
     5426   DO v-ii = 1 TO ERROR-STATUS:NUM-MESSAGES:
     5427       v-mess = substitute("&1&2ош &3"
     5428                           ,v-mess
     5429                           ,chr(10)
     5430                           ,ERROR-STATUS:GET-MESSAGE(v-ii)).
     5431   END.
     5432   return v-mess.
     5433   end function.
     5434   function 00110003_after-import_f returns logical ( input p-d-card as character):
     5435     run 00110003_after-import in this-procedure ( input p-d-card) no-error.
     5436     run set-error in this-procedure ( input return-value ).
     5437     return not (error-status:error).
     5438   end function.
     5439   define variable p-xsd-file as character no-undo.
     5440   on delete of this-procedure do:
     5441     run delete-procedure in this-procedure .
     5442     run gate-clear in this-procedure ( input v_dataseth, input v-xmlh) no-error.
     5443   end.
     5444   run load-ruleset-context in this-procedure ( input p-ruleset-id) no-error .
     5445   if error-status:error
     5446   or return-value = "return" then return.
     5447   define variable ImpData1 as class Route-data_ no-undo .
     5448   ImpData1 = new Route-data_( input parparentproc, input p-parent-handle, input p-log-handle, input this-procedure:handle, input v_dataseth, input v-xmlh) .
     5449   if not this-procedure:persistent then do:
     5450     run proc-main in this-procedure no-error .
     5451     if error-status:error then do:
     5452         run delete-procedure in this-procedure .
     5453         undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     5454     end.
     5455     run delete-procedure in this-procedure .
     5456   end.
     5457   procedure proc-main :
     5458   define variable v-rid as recid no-undo .
     5459   define variable v-current-tbl-name as character no-undo .
     5460   define variable v_qh as handle no-undo .
     5461   define variable v_child-qh as handle no-undo .
     5462   define variable glog as logical no-undo .
     5463   define variable v-ii as integer no-undo .
     5464   define variable v-current-b-code as integer no-undo .
     5465   define variable v-current-b-str as character no-undo .
     5466   define variable v-attr-list as character no-undo .
     5467   define variable v-attr-value as character no-undo .
     5468   define buffer buf_temp-goods_ for temp-goods_.
     5469   define buffer buf_temp-bar-code_ for temp-bar-code_.
     5470   define buffer buf_temp-prod-bc_ for temp-prod-bc_.
     5471   define buffer buf_temp-rel-handle for temp-rel-handle.
     5472   _main:
     5473   do
     5474   on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     5475   on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
     5476   on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
     5477   :
     5478   v-attr-list = 'alcohol-prod':U + chr(4) +
     5479                 'fasovka':U + chr(4) +
     5480                 '15x80':U + chr(4)  +
     5481                 '8x50':U + chr(4) +
     5482                 '6x50':U .
     5483   run write-log  in p-log-handle (
     5484                                    input 0
     5485                                  , "&DLine").
     5486   run write-log-and-file in p-log-handle (
     5487         input 1
     5488       , input log-file-name
     5489       , input 1
     5490       , input substitute("Импорт данных по товарам из файла &1", file-name)).
     5491   for each buf_temp-xml-tables where
     5492           buf_temp-xml-tables.order >= 0
     5493       and buf_temp-xml-tables.is-parent = yes
     5494           :
     5495     if buf_temp-xml-tables.tbl-name = "THheader" then next.
     5496     create query v_qh.
     5497     glog = v_qh:set-buffers( buf_temp-xml-tables.tbl-handle_) no-error.
     5498     if error-status:error
     5499     or
     5500     not glog then do:
     5501           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при попытке получить записи &1&2&3"                               , buf_temp-xml-tables.tbl-name                               , chr(10)                               , error-status:get-message(1))).
     5502       v-view-log = yes.
     5503       undo _main, return error ''.
     5504     end.
     5505     glog = v_qh:query-prepare( substitute( "for each &1 ", buf_temp-xml-tables.tbl-name)) no-error .
     5506     if error-status:error
     5507     or
     5508     not glog then do:
     5509           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при попытке получить записи &1&2&3"                               , buf_temp-xml-tables.tbl-name                                , chr(10)                               , error-status:get-message(1))).
     5510       v-view-log = yes.
     5511       undo _main, return error ''.
     5512     end.
     5513     glog = v_qh:query-open no-error .
     5514     if error-status:error
     5515     or
     5516     not glog then do:
     5517           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при попытке получить записи &1&2&3"                                 , buf_temp-xml-tables.tbl-name                                 , chr(10)                                 , error-status:get-message(1))).
     5518       v-view-log = yes.
     5519       undo _main, return error ''.
     5520     end.
     5521       _stroka:
     5522       REPEAT:
     5523         num-rec = num-rec + 1.
     5524         v-retry-action = 0 .
     5525        _release:
     5526         do on error undo, retry:
     5527           if  retry then do:
     5528             v-retry-action = v-retry-action + 1.
     5529                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при импорте записи &5 &1&2&3&2&4"                                       , buf_temp-xml-tables.tbl-name                                       , num-rec                                       , chr(10)                                       , error-status:get-message(1)                                       , return-value)).
     5530             v-view-log = yes.
     5531           end.
     5532           if v-retry-action < 1 then do:
     5533                       ImpData1:Route-data_dump ( ) .
     5534           end.
     5535         end.
     5536         _rule:
     5537          do on error undo _rule, retry _rule:
     5538            if retry then do:
     5539                          run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("&1&2&3"                                           , error-status:get-message(1)                                         , chr(10)                                         , return-value)).
     5540               v-view-log = yes.
     5541              next _stroka.
     5542            end.
     5543            else do:
     5544             v_qh:get-next().
     5545             IF v_qh:query-off-end then leave _stroka.
     5546             assign
     5547             v-current-tbl-name = ''
     5548             v-current-tbl-name = ImpData1:current-tbl-name( ) no-error .
     5549             case v-current-tbl-name :
     5550               when "goods-01"  THEN do:
     5551                 empty temp-table buf_temp-goods_.
     5552                 empty temp-table buf_temp-bar-code_.
     5553                 empty temp-table buf_temp-prod-bc_.
     5554                 empty temp-table buf_temp-goods-attr_.
     5555                 empty temp-table buf_tt0-gds-obj-prop_.
     5556                 empty temp-table buf_tt0-gds-obj-prop-attr_.
     5557                 v-current-gds-code = ImpData1:route-data_get-field-integer( input "goods-01", input "gds-code") .
     5558                 v-current-mode = ImpData1:route-data_get-field-character( input "goods-01", input "mode") .
     5559                 v-current-artic = ImpData1:route-data_get-field-character( input "goods-01", input "artic") .
     5560                 v-current-prod-type = ImpData1:route-data_get-field-character( input "goods-01", input "prod-type") .
     5561                 v-current-prod-code = ImpData1:route-data_get-field-integer( input "goods-01", input "prod-code") .
     5562                 find first buf_goods no-lock where
     5563                           buf_goods.gds-code = v-current-gds-code no-error.
     5564                 if available buf_goods and v-current-mode = 'add':U then do:
     5565                                   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Уже есть товар с кодом &1. Пропускаем ...", v-current-gds-code)).
     5566                   next _stroka.
     5567                 end.
     5568                 if not available buf_goods then do:
     5569                   find first buf_goods no-lock where
     5570                              buf_goods.artic     = v-current-artic     and
     5571                              buf_goods.prod-type = v-current-prod-type and
     5572                              buf_goods.prod-code = v-current-prod-code no-error.
     5573                   if not available buf_goods and v-current-mode = 'upd':U then do :
     5574                                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не найден товар с артикулом &1 для изменения. Пропускаем ...", v-current-artic)).
     5575                     next _stroka.
     5576                   end.
     5577                   if available buf_goods and v-current-mode = 'add':U then do:
     5578                                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Уже есть товар с артикулом &1 для изменения. Пропускаем ...", v-current-artic)).
     5579                     next _stroka.
     5580                   end.
     5581                 end.
     5582                 find first buf_temp-goods_ where
     5583                           buf_temp-goods_.gds-code = v-current-gds-code no-error.
     5584                 if not available buf_temp-goods_ then do:
     5585                   find first buf_temp-goods_ where
     5586                            buf_temp-goods_.artic = v-current-artic
     5587                        and buf_temp-goods_.prod-type = v-current-prod-type
     5588                        and buf_temp-goods_.prod-code = v-current-prod-code
     5589                        no-error.
     5590                   if not available buf_temp-goods_ then do:
     5591                     create  buf_temp-goods_.
     5592                     assign
     5593                     buf_temp-goods_.gds-code = v-current-gds-code
     5594                     buf_temp-goods_.artic = v-current-artic
     5595                     buf_temp-goods_.prod-type = v-current-prod-type
     5596                     buf_temp-goods_.prod-code = v-current-prod-code
     5597                     .
     5598                   end.
     5599                 end.
     5600                 assign
     5601                 glog = buffer buf_temp-goods_:handle:buffer-copy(ImpData1:route-data_get-record("goods-01"), "gds-code,artic,prod-type,prod-code") no-error.
     5602                 if not glog
     5603                 or error-status:error then do:
     5604                                   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не удалось получить данные записи <goods-01>: &1&2&3"                                                                         , error-status:get-message(1)                                                                         , chr(10)                                                                         , return-value)).
     5605                   v-view-log = yes.
     5606                   next _stroka.
     5607                 end.
     5608                 if v-current-mode = 'add' then do :
     5609                   if buf_temp-goods_.grp-code = 0 or buf_temp-goods_.grp-code = ? then do :
     5610                                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input "Не указан код группы. Пропускаем...").
     5611                     next _stroka.
     5612                   end.
     5613                   if buf_temp-goods_.alpha1 = ""  or buf_temp-goods_.alpha1 = ?   then do :
     5614                                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input "Не указан код страны. Пропускаем...").
     5615                     next _stroka.
     5616                   end.
     5617                   if buf_temp-goods_.unit-base = "" or buf_temp-goods_.unit-base = ? then do :
     5618                                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input "Не указана единица измерения. Пропускаем...").
     5619                     next _stroka.
     5620                   end.
     5621                   if buf_temp-goods_.prt-root = ? then do :
     5622                                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input "Не указана шкала. Пропускаем...").
     5623                     next _stroka.
     5624                   end.
     5625                   if buf_temp-goods_.gds-name = "" or buf_temp-goods_.gds-name = ? then do :
     5626                                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input "Не указано название. Пропускаем...").
     5627                     next _stroka.
     5628                   end.
     5629                 end.
     5630                 do v-ii = 1 to num-entries(v-attr-list, chr(4)):
     5631                   v-attr-value = ImpData1:route-data_get-field-character( input "goods-01", input ("attr-" + entry(v-ii, v-attr-list, chr(4)))) .
     5632                   if v-attr-value <> ? then do:
     5633                     create buf_temp-goods-attr_.
     5634                     assign
     5635                     buf_temp-goods-attr_.gds-code = v-current-gds-code
     5636                     buf_temp-goods-attr_.attr-code  = entry(v-ii, v-attr-list, chr(4) )
     5637                     buf_temp-goods-attr_.attr-value = v-attr-value
     5638                     .
     5639                   end.
     5640                 end.
     5641                 release buf_temp-goods_ .
     5642                 for each buf_temp-rel-handle where
     5643                         buf_temp-rel-handle.parent-buffer_ = v-current-tbl-name:
     5644                   run tmpreld2_query in this-procedure ( buffer buf_temp-rel-handle, input-output v_child-qh) no-error.
     5645                   if error-status:error then do:
     5646                                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не удалось получить записи &1 для &2&3&4&3&5"                                               , buf_temp-rel-handle.child-buffer_                                               , v-current-tbl-name                                               , chr(10)                                               , error-status:get-message(1)                                                , return-value )).
     5647                     v-view-log = yes.
     5648                   end.
     5649                   _child:
     5650                   repeat:
     5651                     v_child-qh:get-next().
     5652                     IF v_child-qh:query-off-end then leave _child.
     5653                     _child-stroka:
     5654                     do on error undo _child-stroka, retry _child-stroka:
     5655                       if retry then do:
     5656                                                 run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("&1&2&3"                                                       , error-status:get-message(1)                                                     , chr(10)                                                     , return-value)).
     5657                           v-view-log = yes.
     5658                         next _stroka.
     5659                       end.
     5660                       else do:
     5661                         case buf_temp-rel-handle.child-buffer_:
     5662                           when "bar-code-01"
     5663                           THEN do:
     5664                             v-current-b-code = ImpData1:route-data_get-field-integer( buffer buf_temp-rel-handle:handle, input buf_temp-rel-handle.CHILD-BUFFER_, input "b-code") .
     5665                             find first buf_temp-bar-code_ where
     5666                                       buf_temp-bar-code_.b-code = v-current-b-code no-error.
     5667                             if not available buf_temp-bar-code_ then do:
     5668                               create  buf_temp-bar-code_.
     5669                               assign
     5670                               buf_temp-bar-code_.b-code = v-current-b-code
     5671                               .
     5672                             end.
     5673                             assign
     5674                             glog = buffer buf_temp-bar-code_:handle:buffer-copy( buf_temp-rel-handle.child-buffer-handle
     5675                                                                               , "b-code") no-error.
     5676                             if not glog
     5677                             or error-status:error then do:
     5678                                                           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не удалось получить данные записи <bar-code-01>: &1&2&3"                                                         , error-status:get-message(1)                                                         , chr(10)                                                         , return-value)).
     5679                               v-view-log = yes.
     5680                               next _stroka.
     5681                             end.
     5682                             release buf_temp-bar-code_ .
     5683                           end.
     5684                           when "prod-bc-01"
     5685                           THEN do:
     5686                             v-current-b-code = ImpData1:route-data_get-field-integer( buffer buf_temp-rel-handle:handle, input buf_temp-rel-handle.CHILD-BUFFER_, input "b-code") .
     5687                             v-current-b-str = ImpData1:route-data_get-field-character( buffer buf_temp-rel-handle:handle, input buf_temp-rel-handle.CHILD-BUFFER_, input "b-str") .
     5688                             find first buf_temp-prod-bc_ where
     5689                                       buf_temp-prod-bc_.b-code = v-current-b-code
     5690                                   and buf_temp-prod-bc_.b-str = v-current-b-str    no-error.
     5691                             if not available buf_temp-prod-bc_ then do:
     5692                               create  buf_temp-prod-bc_.
     5693                               assign
     5694                               buf_temp-prod-bc_.b-code = v-current-b-code
     5695                               buf_temp-prod-bc_.b-str = v-current-b-str
     5696                               .
     5697                             end.
     5698                             assign
     5699                             glog = buffer buf_temp-prod-bc_:handle:buffer-copy(buf_temp-rel-handle.child-buffer-handle
     5700                                                                             , "b-code,b-str") no-error.
     5701                             if not glog
     5702                             or error-status:error then do:
     5703                                                           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не удалось получить данные записи <prod-bc-01>: &1&2&3"                                                         , error-status:get-message(1)                                                         , chr(10)                                                         , return-value)).
     5704                               v-view-log = yes.
     5705                               next _stroka.
     5706                             end.
     5707                             release buf_temp-prod-bc_ .
     5708                           end.
     5709                           when "gds-obj-prop" then do:
     5710                             v-prop-obj-code = ImpData1:route-data_get-field-integer( buffer buf_temp-rel-handle:handle, input buf_temp-rel-handle.CHILD-BUFFER_, input "obj-code") .
     5711                             v-prop-obj-type = ImpData1:route-data_get-field-character( buffer buf_temp-rel-handle:handle, input buf_temp-rel-handle.CHILD-BUFFER_, input "obj-type") .
     5712                             find first  buf_tt0-gds-obj-prop_ where
     5713                                        buf_tt0-gds-obj-prop_.obj-type = v-prop-obj-type
     5714                                   and  buf_tt0-gds-obj-prop_.obj-code = v-prop-obj-code    no-error.
     5715                             if not available buf_tt0-gds-obj-prop_ then do:
     5716                               create  buf_tt0-gds-obj-prop_.
     5717                               assign
     5718                               buf_tt0-gds-obj-prop_.obj-type = v-prop-obj-type
     5719                               buf_tt0-gds-obj-prop_.obj-code = v-prop-obj-code
     5720                               buf_tt0-gds-obj-prop_.gds-code = v-current-gds-code
     5721                               .
     5722                             end.
     5723                             assign
     5724                             glog = buffer buf_tt0-gds-obj-prop_:handle:buffer-copy(buf_temp-rel-handle.child-buffer-handle
     5725                                                                             , "gds-code,obj-type,obj-code") no-error.
     5726                             if not glog
     5727                             or error-status:error then do:
     5728                                                           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не удалось получить данные записи <gds-obj-prop>: &1&2&3"                                                         , error-status:get-message(1)                                                         , chr(10)                                                         , return-value)).
     5729                               v-view-log = yes.
     5730                               next _stroka.
     5731                             end.
     5732                             release buf_temp-prod-bc_ .
     5733                           end.
     5734                         end case.
     5735                       end.
     5736                     end.
     5737                   end.
     5738                   delete object v_child-qh no-error.
     5739                 end.
     5740                 run proc-save in this-procedure no-error.
     5741                 if error-status:error then do:
     5742                                   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при  проверке и/или сохранении данных по товару с кодом &1", v-current-gds-code)).
     5743                   v-view-log = yes.
     5744                   next _stroka.
     5745                 end.
     5746               end.
     5747             end case.
     5748             if error-status:error then do:
     5749                           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("&1&2&3"                                               , error-status:get-message(1)                                         , chr(10)                                         , return-value)).
     5750               v-view-log = yes.
     5751               next _stroka.
     5752             end.
     5753           end.
     5754         end.
     5755         v-retry-action = 0 .
     5756        _release:
     5757         do on error undo, retry:
     5758           if  retry then do:
     5759             v-retry-action = v-retry-action + 1.
     5760                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("&1&2&3"                                             , error-status:get-message(1)                                       , chr(10)                                       , v-last-error-message)).
     5761             v-view-log = yes.
     5762           end.
     5763           if v-retry-action < 1 then do:
     5764                       ImpData1:Route-data_dump ( ) .
     5765           end.
     5766         end.
     5767         if v-retry-action = 0 then do:
     5768           num-rec-ok = num-rec-ok + 1.
     5769         end.
     5770         run write-counter in p-log-handle ( input substitute("Обработано записей <goods-01> : &1, из них удачно: &2", num-rec, num-rec-ok)).
     5771         process events.
     5772         run get-stop-state in p-log-handle ( output v-stop) no-error .
     5773         if v-stop then do:
     5774                   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Процесс импорта прерван пользователем")).
     5775           v-view-log = yes.
     5776           leave _stroka.
     5777         end.
     5778       end.
     5779       if not v-stop then do:
     5780         num-rec = num-rec - 1.
     5781       end.
     5782       v_qh:query-close().
     5783       if valid-handle(v_qh) then do:
     5784         delete object v_qh.
     5785       end.
     5786     end.
     5787       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Обработано строк: &1, из них удачно: &2", num-rec, num-rec-ok)).
     5788   end.
     5789   end procedure.
     5790   procedure load-ruleset-context :
     5791   define input parameter p-ruleset-id as integer no-undo .
     5792   define buffer buf_rule-call-param for tt0-rule-call-param.
     5793   do
     5794   on error undo, return error
     5795   :
     5796   run proc-settings in this-procedure (
     5797    input-output unq-artc
     5798   ,input-output dif-nam1
     5799   ,input-output dif-nam2
     5800   ,input-output dif-pdbc
     5801   ,input-output custvalue
     5802   ,input-output is-prt
     5803   ,input-output is-jwlr
     5804   ,input-output is-bttl
     5805   ,input-output is-ptrl
     5806   ) no-error .
     5807   if error-status:error then undo, return error return-value .
     5808     find first buf_rule-call-param no-lock where
     5809   buf_rule-call-param.codex_id = p-codex-id
     5810   and buf_rule-call-param.ruleset_id = p-ruleset-id
     5811   and buf_rule-call-param.call_id = p-call-id
     5812   and buf_rule-call-param.order_id = p-order-id
     5813   and buf_rule-call-param.rule_id = p-rule-id
     5814   and buf_rule-call-param.param-name = "p-xsd-file"
     5815    no-error.
     5816   if available buf_rule-call-param then do:
     5817   assign p-xsd-file = buf_rule-call-param.param-value-character.
     5818   end.
     5819       case p-ruleset-id:
     5820         when 3 then do:
     5821           assign
     5822           v-sign = 1
     5823           v-current-host-code = p-host-code
     5824           v-current-obj-type = p-obj-type
     5825           v-current-obj-code = p-obj-code
     5826           v-current-db-num = g#db-num
     5827           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     5828           file-name  = entry(1, p-process-file-name, chr(4))
     5829           v-xmlh = buffer buf_temp-xml-tables:handle:table-handle:default-buffer-handle
     5830           .
     5831           run rul/rum-xmli.p  (
     5832                                input parparentproc
     5833                               ,input p-log-handle
     5834                               ,input file-name
     5835                               ,input p-profile-id
     5836                               ,input p-xsd-file
     5837                               ,input 0
     5838                               ,input 0
     5839                               ,input-output v_dataseth
     5840                               ,input-output v-xmlh
     5841                               ) no-error.
     5842           if error-status:error then do:
     5843             undo, return error substitute("&1&2&3"
     5844                                             , error-status:get-message(1)
     5845                                             , chr(10)
     5846                                             , return-value ).
     5847           end.
     5848           v-xmlh = buffer buf_temp-xml-tables:handle.
     5849           run tmpreldf_get-relations in this-procedure ( input  v_dataseth).
     5850         end.
     5851         otherwise do:
     5852           undo, return error "Неправильный вызов".
     5853         end.
     5854       end case.
     5855     end.
     5856   end procedure.
     5857   procedure delete-procedure :
     5858     do
     5859     on error undo, return error
     5860     :
     5861         for each temp-goods_:
     5862           delete temp-goods_.
     5863         end.
     5864         for each temp-prod-bc_:
     5865           delete temp-prod-bc_.
     5866         end.
     5867         for each temp-bar-code_:
     5868           delete temp-bar-code_.
     5869         end.
     5870         run garbcoll_clear in this-procedure .
     5871     end.
     5872   end procedure.
     5873   procedure 00110003_after-import :
     5874   define input  parameter p-gds-code as integer no-undo .
     5875   define buffer buf_gds-list for gds-list.
     5876   find first buf_gds-list where
     5877             buf_gds-list.gds-code = p-gds-code no-error
     5878   .
     5879   if available buf_gds-list then
     5880   delete buf_gds-list.
     5881   end procedure.
     5882   procedure proc-save :
     5883   define variable v-fbr-gds-grp-f-name as character no-undo .
     5884   define variable v-gds-rec as recid no-undo .
     5885   define variable nbc as integer no-undo .
     5886   define variable v-err-mess as character no-undo .
     5887   define variable v-rid as integer no-undo .
     5888   define variable v-b-str as character no-undo .
     5889   define buffer buf_temp-goods_ for temp-goods_.
     5890   define buffer buf_temp-bar-code_ for temp-bar-code_.
     5891   define buffer buf_temp-prod-bc_ for temp-prod-bc_.
     5892   define buffer buf_gds-prt for ub.gds-prt.
     5893   define buffer bc_gds-prt for ub.gds-prt.
     5894   define buffer buf_clients for ub.clients.
     5895   define buffer buf_fbr-gds-grp for ub.fbr-gds-grp.
     5896   main-block:
     5897   do transaction
     5898   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     5899   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     5900   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     5901   :
     5902     if retry then do:
     5903       empty temp-table buf_temp-goods_.
     5904       empty temp-table buf_temp-bar-code_.
     5905       empty temp-table buf_temp-prod-bc_.
     5906             run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input v-err-mess).
     5907        return error ''.
     5908     end.
     5909     else do:
     5910       find first buf_temp-goods_.
     5911       find first buf_clients no-lock where
     5912                 buf_clients.obj-type = buf_temp-goods_.prod-type
     5913             and buf_clients.obj-code = buf_temp-goods_.prod-code no-error .
     5914       if not available buf_clients
     5915       or buf_clients.obj-name <> buf_temp-goods_.prod-name then do:
     5916         v-err-mess =  substitute("Не найден производитель &1&2 для товара c кодом &3&4или его наименование не совпадает с наименованием производителя в товаре&4(&5)"
     5917                                       , buf_temp-goods_.prod-type
     5918                                       , buf_temp-goods_.prod-code
     5919                                       , buf_temp-goods_.gds-code
     5920                                       ,chr(10)
     5921                                       , buf_temp-goods_.prod-name).
     5922         undo main-block, retry main-block.
     5923       end.
     5924       find first buf_gds-prt no-lock WHERE
     5925                 buf_gds-prt.upper-code = buf_temp-goods_.prt-root no-error.
     5926       if not available buf_gds-prt
     5927       or buf_gds-prt.node-name <> buf_temp-goods_.prt-root-name
     5928       then do:
     5929         v-err-mess = substitute("Не найден корень шкалы  &1 для товара с кодом &2&3или его название не совпадает с названием корня шкалы в товаре (&4)"
     5930                                       , buf_temp-goods_.prt-root
     5931                                       , buf_temp-goods_.gds-code
     5932                                       ,chr(10)
     5933                                       , buf_temp-goods_.prt-root-name).
     5934         undo main-block, retry main-block.
     5935       end.
     5936       v-fbr-gds-grp-f-name = ''.
     5937       release buf_fbr-gds-grp no-error.
     5938       if buf_temp-goods_.fbr-grp-code <> 0
     5939       and buf_temp-goods_.fbr-grp-code <> ? then do:
     5940         find first buf_fbr-gds-grp no-lock where
     5941                   buf_fbr-gds-grp.node-code = buf_temp-goods_.fbr-grp-code no-error.
     5942         if available buf_fbr-gds-grp  then do:
     5943           run fbrglib-get-full-name in this-procedure (
     5944                                                           input ''
     5945                                                         ,input 0
     5946                                                         ,input buf_fbr-gds-grp.node-code
     5947                                                         ,output v-fbr-gds-grp-f-name).
     5948         end.
     5949         if not available buf_fbr-gds-grp
     5950         or v-fbr-gds-grp-f-name <> buf_temp-goods_.fbr-grp-name then do:
     5951           v-err-mess = substitute("Не найдена группа блюд  &1 для товара с кодом &2&3или ее полное название не совпадает с названием группы блюд в товаре (&4)"
     5952                                         , buf_temp-goods_.fbr-grp-code
     5953                                         , buf_temp-goods_.gds-code
     5954                                         ,chr(10)
     5955                                         , buf_temp-goods_.fbr-grp-name).
     5956           undo main-block, retry main-block.
     5957         end.
     5958       end.
     5959       for each buf_temp-bar-code_:
     5960         find first bc_gds-prt no-lock where
     5961                   bc_gds-prt.node-code = buf_temp-bar-code_.node-code no-error.
     5962         if not available bc_gds-prt
     5963         or buf_temp-bar-code_.node-name <> bc_gds-prt.f-name
     5964         then do:
     5965           v-err-mess = substitute("Не найден узел шкалы  &1 для бар-кода &2 товара с кодом &3&4" +
     5966                                         "или его полное название не совпадает с названием узла шкалы в бар-коде (&5)&4"
     5967                                         , buf_temp-bar-code_.node-code
     5968                                         , buf_temp-bar-code_.b-code
     5969                                         , buf_temp-goods_.gds-code
     5970                                         ,chr(10)
     5971                                         , buf_temp-bar-code_.node-name).
     5972           undo main-block, retry main-block.
     5973         end.
     5974       end.
     5975       assign
     5976       nbc = 0
     5977       .
     5978       v-gds-rec = recid(buf_goods) no-error.
     5979       for each tt-tax:
     5980         delete tt-tax.
     5981       end.
     5982       run ref/dtaxgdss.p (
     5983             input yes
     5984           , input   buf_temp-goods_.unit-base
     5985           , input   buf_temp-goods_.grp-code
     5986           , input ?
     5987           , input ?
     5988           , input   0
     5989           , input    ''
     5990           , input   0
     5991             ) no-error.
     5992       if error-status:error then do:
     5993         v-err-mess = substitute("Ошибки при определении налогов на товар:&1&2&1&3"
     5994                                   , chr(10)
     5995                                   , error-status:get-message(1)
     5996                                   , return-value ).
     5997         undo main-block, retry main-block.
     5998       end.
     5999       run ref/goods01.p (
     6000                     input parparentproc
     6001                     ,input if v-current-mode = 'add':U then 'ДОБАВЛЕНИЕ':U else 'ИЗМЕНЕНИЕ':U
     6002                     ,input no
     6003                     ,input 2
     6004                     ,input no
     6005                     ,input yes
     6006                     ,input yes
     6007                     ,input yes
     6008                     ,input no
     6009                     ,input v-current-host-code
     6010                     ,input v-current-obj-type
     6011                     ,input v-current-obj-code
     6012                     ,input (buf_temp-goods_.gds-type = 'т':U)
     6013                     ,input ?
     6014                     ,input buf_temp-goods_.gds-code
     6015                     ,input buf_temp-goods_.artic
     6016                     ,input buf_temp-goods_.prod-type
     6017                     ,input buf_temp-goods_.prod-code
     6018                     ,input buf_gds-prt.node-code
     6019                     ,input buf_temp-goods_.grp-code
     6020                     ,input buf_temp-goods_.gds-name
     6021                     ,input ''
     6022                     ,input buf_temp-goods_.engl-name
     6023                     ,input buf_temp-goods_.label-name
     6024                     ,input buf_temp-goods_.chk-name
     6025                     ,input buf_temp-goods_.alpha1
     6026                     ,input buf_temp-goods_.unit-base
     6027                     ,input buf_temp-goods_.unit-cli
     6028                     ,INPUT buf_temp-goods_.max-rate
     6029                     ,INPUT buf_temp-goods_.min-rate
     6030                     ,INPUT buf_temp-goods_.cli-base-rate
     6031                     ,input buf_temp-goods_.qnty-cart
     6032                     ,input buf_temp-goods_.ms-base
     6033                     ,input buf_temp-goods_.wt-base
     6034                     ,input buf_temp-goods_.ms-cart
     6035                     ,input buf_temp-goods_.wt-cart
     6036                     ,input buf_temp-goods_.calc-method
     6037                     ,input buf_temp-goods_.increase-pc
     6038                     ,input buf_temp-goods_.Negative-rest
     6039                     ,input 0.0
     6040                     ,input 0.0
     6041                     ,input buf_temp-goods_.okdp
     6042                     ,input buf_temp-goods_.destin
     6043                     ,input buf_temp-goods_.attrib
     6044                     ,input buf_temp-goods_.user-rule
     6045                     ,input buf_temp-goods_.sert
     6046                     ,input buf_temp-goods_.struct
     6047                     ,input buf_temp-goods_.deadline
     6048                     ,input buf_temp-goods_.cond-keep-code
     6049                     ,input buf_temp-goods_.sort
     6050                     ,input buf_temp-goods_.proof
     6051                     ,input buf_temp-goods_.normal-wastage
     6052                     ,input buf_temp-goods_.normal-waste
     6053                     ,input buf_temp-goods_.tnved
     6054                     ,input buf_temp-goods_.nationality
     6055                     ,input buf_temp-goods_.unit-cst
     6056                     ,input buf_temp-goods_.cst-base-rate
     6057                     ,input (if available buf_fbr-gds-grp then buf_fbr-gds-grp.node-code else ?)
     6058                     ,input buf_temp-goods_.PS
     6059                     ,input unq-artc
     6060                     ,input is-jwlr
     6061                     ,input is-bttl
     6062                     ,input is-ptrl
     6063                     ,input custvalue
     6064                     ,input dif-nam1
     6065                     ,input dif-nam2
     6066                     ,input FALSE
     6067                     ,input if (buf_temp-goods_.gds-code = 0 or buf_temp-goods_.gds-code = ?) then 0    else 2
     6068                     ,input-output v-gds-rec
     6069                     ,output nbc
     6070                     ) no-error .
     6071       if error-status:error then do:
     6072         v-err-mess = substitute("Ошибки при сохранении товара c кодом &1:&2&3&2&4"
     6073                                 , buf_temp-goods_.gds-code
     6074                                 , chr(10)
     6075                                 , error-status:get-message(1)
     6076                                 , return-value ).
     6077         undo main-block, retry main-block.
     6078       end.
     6079       find first buf_goods share-lock where
     6080                 recid(buf_goods) = v-gds-rec .
     6081       for each buf_temp-goods-attr_ where
     6082               buf_temp-goods-attr_.gds-code = buf_temp-goods_.gds-code
     6083       on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     6084       on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     6085       on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     6086       :
     6087         run gds-attr-write in this-procedure (
     6088                                                input buf_goods.gds-code
     6089                                               ,input buf_temp-goods-attr_.attr-code
     6090                                               ,input buf_temp-goods-attr_.attr-value
     6091                                               ) no-error.
     6092         if error-status:error then do:
     6093           v-err-mess = substitute("Ошибки при сохранении атрибута товара:&1&2&1&3"
     6094                                   , chr(10)
     6095                                   , error-status:get-message(1)
     6096                                   , return-value ).
     6097           undo main-block, retry main-block.
     6098         end.
     6099       end.
     6100       find first buf_temp-bar-code_ where
     6101                 buf_temp-bar-code_.gds-code = buf_temp-goods_.gds-code
     6102             and buf_temp-bar-code_.unit-cli = buf_temp-goods_.unit-base
     6103             and buf_temp-bar-code_.node-code = buf_gds-prt.node-code
     6104             and buf_temp-bar-code_.in-code = ''
     6105             and buf_temp-bar-code_.part-code = '' no-error.
     6106       for each buf_temp-bar-code_ where
     6107               buf_temp-goods_.gds-code = buf_temp-goods_.gds-code
     6108       on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     6109       on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     6110       on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     6111       :
     6112         if buf_temp-bar-code_.b-code <> buf_temp-bar-code_.gds-code then do:
     6113           run ref/barcode1.p (
     6114             input ('ДОБАВЛЕНИЕ':U + chr(44) + 'ДОБАВЛЕНИЕ-ИМПОРТ':U)
     6115           ,input yes
     6116           ,input buf_temp-bar-code_.b-code
     6117           ,input buf_temp-bar-code_.gds-code
     6118           ,input buf_temp-bar-code_.node-code
     6119           ,input '':U
     6120           ,input '':U
     6121           ,input buf_temp-bar-code_.unit-cli
     6122           ,input buf_temp-bar-code_.cli-base-rate
     6123           ,output v-rid
     6124           )
     6125           no-error.
     6126         end.
     6127         for each buf_temp-prod-bc_ where
     6128                 buf_temp-prod-bc_.b-code = buf_temp-bar-code_.b-code
     6129         on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     6130         on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     6131         on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     6132         :
     6133             v-b-str = buf_temp-prod-bc_.b-str.
     6134             run trg/prod-bc1.p (
     6135                                 input parparentproc
     6136                               ,input yes
     6137                               ,input no
     6138                               ,input no
     6139                               ,input no
     6140                               ,input ''
     6141                               ,input ''
     6142                               ,buffer buf_goods
     6143                               ,input buf_temp-bar-code_.b-code
     6144                               ,input-output v-b-str
     6145                               ,output v-rid
     6146                           ) no-error .
     6147             if error-status :error then do:
     6148               v-err-mess = substitute("Ошибка при сохранении prod-bc &1 (бар-код &2) &3&4&3&5"
     6149                                         , buf_temp-prod-bc_.b-str
     6150                                         , buf_temp-prod-bc_.b-code
     6151                                         , chr(10)
     6152                                         , error-status:get-message(1)
     6153                                         , return-value
     6154                                         ).
     6155               undo main-block, retry main-block.
     6156             end.
     6157         end.
     6158       end.
     6159         for each buf_tt0-gds-obj-prop_  where
     6160         buf_tt0-gds-obj-prop_.gds-code = buf_temp-goods_.gds-code
     6161         on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     6162         on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     6163         on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     6164         :
     6165             run gds-ind1
     6166                 (input-output v-recid
     6167                 ,buf_tt0-gds-obj-prop_.gds-code
     6168                 ,buf_tt0-gds-obj-prop_.obj-type
     6169                 ,buf_tt0-gds-obj-prop_.obj-code
     6170                 ,buf_tt0-gds-obj-prop_.gdop-igt
     6171                 ,buf_tt0-gds-obj-prop_.gdop-assort-min
     6172                 ,buf_tt0-gds-obj-prop_.gdop-min-stock
     6173                 ,buf_tt0-gds-obj-prop_.grop-level-always-presence
     6174                 ,buf_tt0-gds-obj-prop_.grop-max-stock
     6175                 ,buf_tt0-gds-obj-prop_.grop-min-order
     6176                 ,input table tt0-gds-obj-prop-attr
     6177                 ) no-error .
     6178             if error-status :error then  do:
     6179               v-err-mess =  error-status :get-message(1) + return-value .
     6180               undo main-block, retry main-block.
     6181             end.
     6182         end.
     6183         if   buf_temp-goods_.alc-type-code > 0 then do:
     6184           if not can-find(first ub.alc-type where ub.alc-type.alc-type-inner-code = buf_temp-goods_.alc-type-code  no-lock) then do:
     6185                       v-err-mess = substitute("Не найден вид алкогольной продукции &1. Товар &2) &3&4&3&5"
     6186                                         , buf_temp-goods_.alc-type-code
     6187                                         , buf_temp-goods_.gds-code
     6188                                         , chr(10)
     6189                                         , error-status:get-message(1)
     6190                                         , return-value
     6191                                         ).
     6192               undo main-block, retry main-block.
     6193           end.
     6194                   find first bb_alc-type-gds no-lock
     6195                        where bb_alc-type-gds.gds-code            = buf_temp-goods_.gds-code
     6196                          and bb_alc-type-gds.alc-type-inner-code = buf_temp-goods_.alc-type-code
     6197                          and bb_alc-type-gds.create-user-db-num  = v-current-db-num no-error.
     6198                   if not available bb_alc-type-gds then do :
     6199                     create bb_alc-type-gds.
     6200                     assign
     6201                         bb_alc-type-gds.gds-code            = buf_temp-goods_.gds-code
     6202                         bb_alc-type-gds.alc-type-inner-code = buf_temp-goods_.alc-type-code
     6203                         bb_alc-type-gds.create-user-db-num  = v-current-db-num
     6204                     .
     6205                     release  bb_alc-type-gds no-error.
     6206                     if error-status :error then  do:
     6207                       v-err-mess =  error-status :get-message(1) + return-value .
     6208                       undo main-block, retry main-block.
     6209                     end.
     6210                   end.
     6211         end.
     6212         if buf_temp-goods_.alc-type-code = ? then do :
     6213                   find first bb_alc-type-gds exclusive-lock
     6214                        where bb_alc-type-gds.gds-code            = buf_temp-goods_.gds-code
     6215                          and bb_alc-type-gds.create-user-db-num  = v-current-db-num no-error.
     6216                   if available bb_alc-type-gds then do :
     6217                     delete bb_alc-type-gds no-error.
     6218                     if error-status :error then  do:
     6219                       v-err-mess =  error-status :get-message(1) + return-value .
     6220                       undo main-block, retry main-block.
     6221                     end.
     6222                   end.
     6223         end.
     6224     end.
     6225   end.
     6226   end procedure.
     6227   PROCEDURE proc-settings:
     6228   define input-output parameter par-unq-artc as logical no-undo.
     6229   define input-output parameter par-dif-nam1 as logical no-undo.
     6230   define input-output parameter par-dif-nam2 as logical no-undo.
     6231   define input-output parameter par-dif-pdbc as logical no-undo .
     6232   define input-output parameter par-custvalue as character no-undo .
     6233   define input-output parameter par-is-prt  as logical no-undo .
     6234   define input-output parameter par-is-jwlr as logical no-undo .
     6235   define input-output parameter par-is-bttl as logical no-undo .
     6236   define input-output parameter par-is-ptrl as logical no-undo .
     6237   define variable conf-par as character no-undo .
     6238   define variable par-type as character no-undo .
     6239   define variable v-param-type as character no-undo .
     6240   define variable v-value-character as character no-undo .
     6241   define variable v-value-date as date no-undo .
     6242   define variable v-value-decimal as decimal no-undo .
     6243   define variable v-value-integer as INTEGER no-undo .
     6244   define variable v-value-logical AS LOGICAL no-undo .
     6245   define variable v-tth as handle no-undo .
     6246   assign
     6247   v-tth = buffer thbjattr_thbj-attr:table-handle .
     6248   do
     6249   on error undo, return error
     6250   :
     6251   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     6252     (input  'is-prt'
     6253     ,input  0
     6254     ,input  ''
     6255     ,input  0
     6256     ,input  ''
     6257     ,input  ''
     6258     ,input  ''
     6259     ,input  no
     6260     ,output conf-par
     6261     ,output par-type
     6262     ) no-error .
     6263   par-is-prt = (IF error-status:error or conf-par <> "yes" then no else yes).
     6264   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     6265     (input  'is-jwlr'
     6266     ,input  ''
     6267     ,input  ''
     6268     ,input  0
     6269     ,input  ''
     6270     ,input  ''
     6271     ,input  ''
     6272     ,input  no
     6273     ,output conf-par
     6274     ,output par-type
     6275     ) no-error .
     6276   assign
     6277   par-is-jwlr = (conf-par = "yes":U) no-error
     6278   .
     6279   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     6280     (input  'is-bttl'
     6281     ,input  ''
     6282     ,input  ''
     6283     ,input  0
     6284     ,input  ''
     6285     ,input  ''
     6286     ,input  ''
     6287     ,input  no
     6288     ,output conf-par
     6289     ,output par-type
     6290     ) no-error .
     6291   assign
     6292   par-is-bttl = (conf-par = "yes":U) no-error
     6293   .
     6294   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     6295     (input  'is-ptrl'
     6296     ,input  ''
     6297     ,input  ''
     6298     ,input  0
     6299     ,input  ''
     6300     ,input  ''
     6301     ,input  ''
     6302     ,input  no
     6303     ,output conf-par
     6304     ,output par-type
     6305     ) no-error .
     6306   assign
     6307   par-is-ptrl = (conf-par = "yes":U) no-error
     6308   .
     6309   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     6310     (input  'is-custm'
     6311     ,input  ''
     6312     ,input  ''
     6313     ,input  0
     6314     ,input  ''
     6315     ,input  ''
     6316     ,input  ''
     6317     ,input  no
     6318     ,output par-custvalue
     6319     ,output par-type
     6320     ) no-error .
     6321   for each thbjattr_thbj-attr:
     6322     delete thbjattr_thbj-attr.
     6323   end.
     6324   run adm/shattri.p (
     6325         input "get":U
     6326       ,input  '':U
     6327       ,input  0
     6328       ,input  'gds-ref':U
     6329       ,input  "":U
     6330       ,output v-value-character
     6331       ,output v-value-date
     6332       ,output v-value-decimal
     6333       ,output v-value-integer
     6334       ,output v-value-logical
     6335       ,output v-param-type
     6336       ,INPUT-OUTPUT table-handle v-tth
     6337       ) no-error .
     6338   IF error-status:error then do:
     6339     delete object v-tth.
     6340     undo, return error
     6341     substitute("Ошибка при получении опций работы со справочником товаров:&1&2 &3"
     6342               , chr(10)
     6343               , error-status:get-message(1)
     6344               , return-value ).
     6345   end.
     6346   for each thbjattr_thbj-attr  where
     6347           thbjattr_thbj-attr.obj-type = '':U
     6348       and thbjattr_thbj-attr.obj-code = 0
     6349       and thbjattr_thbj-attr.upper-prop-code = 'gds-ref':U
     6350   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     6351   :
     6352     case thbjattr_thbj-attr.prop-code:
     6353       when 'dif-nam1':U then do:
     6354         par-dif-nam1 = thbjattr_thbj-attr.property-value-logical.
     6355       end.
     6356       when 'dif-nam2':U then do:
     6357         par-dif-nam2 = thbjattr_thbj-attr.property-value-logical.
     6358       end.
     6359       when 'dif-pdbc':U then do:
     6360         par-dif-pdbc = thbjattr_thbj-attr.property-value-logical.
     6361       end.
     6362       when 'unq-artc':U then do:
     6363         par-unq-artc = thbjattr_thbj-attr.property-value-logical.
     6364       end.
     6365     end case.
     6366   end.
     6367   end.
     6368   END PROCEDURE.
