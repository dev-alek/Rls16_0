     2974                   buf_temp_xmllib_rec-fld.rec-key         = buf_temp_xmllib_rec.rec-key
     2975                   buf_temp_xmllib_rec-fld.fldOpenLine     = v-xmllib-sax-reader-handle :locator-line-number
     2976                   buf_temp_xmllib_rec-fld.fldCloseLine    = 0
     2977                   buf_temp_xmllib_rec-fld.fldName         = p-fld-name
     2978                   buf_temp_xmllib_rec-fld.closed          = no
