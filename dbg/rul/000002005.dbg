     5289   procedure gdspoatr-exist :
     5290     define input  parameter p-gds-code like ub.gds-obj-prop-attr.gds-code   no-undo .
     5291     define input  parameter p-obj-type like ub.gds-obj-prop-attr.obj-type   no-undo .
     5292     define input  parameter p-obj-code like ub.gds-obj-prop-attr.obj-code   no-undo .
     5293     define input  parameter p-code     like ub.gds-obj-prop-attr.attr-code  no-undo .
     5294     define output parameter p-exist    as logical no-undo .
     5295     do
     5296     on error undo, return error
     5297     :
     5298           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdspoatr-exist in g#attr-lib
     5299         (input  p-gds-code
     5300         ,input  p-obj-type
     5301         ,input  p-obj-code
     5302         ,input  p-code
     5303         ,output p-exist
     5304         ) no-error .
     5305       if error-status :error
     5306       then do:
     5307         undo, return error return-value .
     5308       end.
     5309     end.
     5310   end procedure.
     5311   procedure gdspoatr-delete :
     5312     define input  parameter p-gds-code like ub.gds-obj-prop-attr.gds-code   no-undo .
     5313     define input  parameter p-obj-type like ub.gds-obj-prop-attr.obj-type   no-undo .
     5314     define input  parameter p-obj-code like ub.gds-obj-prop-attr.obj-code   no-undo .
     5315     define input  parameter p-code     like ub.gds-obj-prop-attr.attr-code  no-undo .
     5316     define output parameter p-deleted  as logical no-undo .
     5317     do
     5318     on error undo, return error
     5319     :
     5320           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdspoatr-delete in g#attr-lib
     5321         (input  p-gds-code
     5322         ,input  p-obj-type
     5323         ,input  p-obj-code
     5324         ,input  p-code
     5325         ,output p-deleted
     5326         ) no-error .
     5327       if error-status :error
     5328       then do:
     5329         undo, return error return-value .
     5330       end.
     5331     end.
     5332   end procedure.
     5333   procedure gdspoatr-copy :
     5334     define input  parameter p-code as character no-undo .
     5335     define output parameter p-copy as logical   no-undo .
     5336     do
     5337     on error undo, return error
     5338     :
     5339           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdspoatr-copy in g#attr-lib
     5340         (input  p-code
     5341         ,output p-copy
     5342         ) no-error .
