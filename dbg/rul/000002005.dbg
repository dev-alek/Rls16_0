     3195                           .
     3196                       end.
     3197                       when chr(4)
     3198                       then do:
     3199                           assign
     3200                               p-out-string = p-out-string + " ":U
     3201                           .
     3202                       end.
     3203                       when chr(5)
     3204                       then do:
     3205                           assign
     3206                               p-out-string = p-out-string + " ":U
     3207                           .
     3208                       end.
     3209                       when chr(6)
     3210                       then do:
     3211                           assign
     3212                               p-out-string = p-out-string + " ":U
     3213                           .
     3214                       end.
     3215                       when chr(7)
     3216                       then do:
     3217                           assign
     3218                               p-out-string = p-out-string + " ":U
     3219                           .
     3220                       end.
     3221                       when chr(8)
     3222                       then do:
     3223                           assign
     3224                               p-out-string = p-out-string + " ":U
     3225                           .
     3226                       end.
     3227                       when chr(9)
     3228                       then do:
     3229                           assign
     3230                               p-out-string = p-out-string + " ":U
     3231                           .
     3232                       end.
     3233                       when chr(29)
     3234                       then do:
     3235                           assign
     3236                               p-out-string = p-out-string + " ":U
