     3261   end .
     3262   procedure xmlchar-decode :
     3263   define input parameter p-in-string      as character        no-undo.
     3264   define output parameter p-out-string    as character        no-undo.
     3265       define variable v-position      as integer      no-undo.
     3266       define variable v-last-position as integer      no-undo.
     3267       define variable v-temp-integer  as integer      no-undo.
     3268       define variable v-current-char  as character    no-undo.
     3269       define variable v-next-char     as character    no-undo.
     3270       define variable v-success       as logical      no-undo.
     3271   do
     3272   on error undo, return error
     3273   :
     3274       assign
     3275           p-out-string = "":U
     3276           v-position   = 0
     3277       .
     3278       replace-cycle:
     3279       do while yes
     3280       on error undo, return error
     3281       :
     3282           assign
     3283               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     3284           .
     3285           if v-last-position <= v-position
     3286           then do:
     3287               if v-position = 0
     3288               then do:
     3289                   assign
     3290                       p-out-string = p-in-string
     3291                   .
     3292               end.
     3293               else do:
     3294                   assign
     3295                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     3296                   .
     3297               end.
     3298               leave replace-cycle.
     3299           end.
     3300           else do:
     3301               assign
     3302                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     3303                   v-position      = v-last-position
     3304                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     3305               .
     3306               if v-current-char = "#":U
     3307               then do:
     3308                   assign
     3309                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     3310                   .
     3311                   if v-last-position > 0
     3312                   then do:
     3313                       run xmlchar-read-integer in this-procedure
     3314                        (
     3315                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     3316                           , output v-temp-integer
     3317                           , output v-success
     3318                       ).
     3319                       if v-success = yes
     3320                       and v-temp-integer >= 1
     3321                       and v-temp-integer <= 255
     3322                       then do:
     3323                           assign
     3324                               p-out-string = p-out-string + chr( v-temp-integer )
     3325                               v-position   = v-last-position + 1
     3326                           .
     3327                       end.
     3328                       else do:
     3329                           assign
     3330                               p-out-string = p-out-string + "&":U
     3331                               v-position   = v-position   + 1
     3332                           .
     3333                       end.
     3334                   end.
     3335                   else do:
     3336                       assign
     3337                           p-out-string = p-out-string + "&":U
     3338                           v-position   = v-position   + 1
     3339                       .
     3340                   end.
     3341               end.
     3342               else do:
     3343                   case substring( p-in-string, v-position + 1, 3 )
     3344                   :
     3345                       when "lt;":U
     3346                       then do:
     3347                           assign
     3348                               p-out-string = p-out-string + "<":U
     3349                               v-position   = v-position   + 3
     3350                           .
     3351                       end.
     3352                       when "gt;":U
     3353                       then do:
     3354                           assign
     3355                               p-out-string = p-out-string + ">":U
     3356                               v-position   = v-position   + 3
     3357                           .
     3358                       end.
     3359                       otherwise do:
     3360                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     3361                           then do:
     3362                               assign
     3363                                   p-out-string = p-out-string + "&":U
     3364                                   v-position   = v-position   + 4
     3365                               .
     3366                           end.
     3367                           else do:
     3368                               case substring( p-in-string, v-position + 1, 5 )
     3369                               :
     3370                                   when "quot;":U
     3371                                   then do:
     3372                                       assign
     3373                                           p-out-string = p-out-string + '"':U
     3374                                           v-position   = v-position   + 5
     3375                                       .
     3376                                   end.
     3377                                   when "apos;":U
     3378                                   then do:
     3379                                       assign
     3380                                           p-out-string = p-out-string + "'":U
     3381                                           v-position   = v-position   + 5
     3382                                       .
     3383                                   end.
     3384                                   otherwise do:
     3385                                       assign
     3386                                           p-out-string = p-out-string + "&":U
     3387                                       .
     3388                                   end.
     3389                               end case.
     3390                           end.
     3391                       end.
     3392                   end case.
     3393               end.
     3394           end.
     3395       end.
     3396   end.
     3397   end .
     3398   procedure xmlchar-read-integer :
     3399   define input parameter p-input-string      as character        no-undo.
     3400   define output parameter p-output-integer   as integer          no-undo.
     3401   define output parameter p-success       as logical          no-undo.
     3402   do
     3403   on error undo, return error
     3404   :
     3405       assign
     3406           p-output-integer = integer( p-input-string )
     3407       no-error.
     3408       if error-status :error
     3409       then do:
     3410           assign
     3411               p-success           = no
     3412               p-output-integer    = 0
     3413           .
     3414       end.
     3415       else do:
     3416           assign
     3417               p-success           = yes
     3418           .
     3419       end.
     3420   end.
     3421   end.
     3422   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3423   define temp-table temp-rel-handle no-undo
     3424   field dh as handle
     3425   field ii as integer
     3426   field active_ as logical
     3427   field child-buffer_ as character
     3428   field parent-buffer_ as character
     3429   field child-buffer-handle as handle
     3430   field parent-buffer-handle as handle
     3431   field name_ as character
     3432   field nested_ as logical
     3433   field relation-fields_ as character
     3434   field reposition_ as logical
     3435   field type_ as character
     3436   field query_ as handle
     3437   field where-string_ as character
     3438   field tbl-handle_ as handle
     3439   index pi is unique primary
     3440   ii
     3441   index iparentname parent-buffer_ child-buffer_
     3442   index iparenthandle parent-buffer-handle child-buffer-handle
     3443   .
     3444   procedure tmpreldf_get-relations :
     3445   define input parameter p-dataseth as handle no-undo .
     3446   define variable v-ii as integer no-undo .
     3447   define buffer buf_temp-rel-handle for temp-rel-handle.
     3448   do
     3449   on error undo, return error
     3450   :
     3451     if not valid-handle(p-dataseth)
     3452     or p-dataseth:type <> "DATASET"
     3453     then do:
     3454       return error substitute("Не определен dataset с handle &1", p-dataseth).
     3455     end.
     3456     for each buf_temp-rel-handle where
     3457             buf_temp-rel-handle.dh = p-dataseth:
     3458       delete buf_temp-rel-handle.
     3459     end.
     3460     do v-ii = 1 to p-dataseth:num-relations:
     3461       create buf_temp-rel-handle.
     3462       assign
     3463       buf_temp-rel-handle.ii = v-ii
     3464       buf_temp-rel-handle.dh = p-dataseth
     3465       buf_temp-rel-handle.active_ = p-dataseth:get-relation(v-ii):active
     3466       buf_temp-rel-handle.child-buffer_ = p-dataseth:get-relation(v-ii):child-buffer:name
     3467       buf_temp-rel-handle.parent-buffer_ = p-dataseth:get-relation(v-ii):parent-buffer:name
     3468       buf_temp-rel-handle.child-buffer-handle = p-dataseth:get-relation(v-ii):child-buffer
     3469       buf_temp-rel-handle.tbl-handle_ = buf_temp-rel-handle.child-buffer-handle
     3470       buf_temp-rel-handle.parent-buffer-handle = p-dataseth:get-relation(v-ii):parent-buffer
     3471       buf_temp-rel-handle.name_ = p-dataseth:get-relation(v-ii):name
     3472       buf_temp-rel-handle.nested_ = p-dataseth:get-relation(v-ii):nested
     3473       buf_temp-rel-handle.relation-fields_ = p-dataseth:get-relation(v-ii):relation-fields
     3474       buf_temp-rel-handle.reposition_ = p-dataseth:get-relation(v-ii):reposition
     3475       buf_temp-rel-handle.type_ = p-dataseth:get-relation(v-ii):type
     3476       buf_temp-rel-handle.query_ = p-dataseth:get-relation(v-ii):query
     3477       buf_temp-rel-handle.where-string_ = p-dataseth:get-relation(v-ii):where-string
     3478       .
     3479     end.
     3480   end.
     3481   end procedure.
     3482   procedure tmpreldf_set-relations :
     3483   define input parameter p-srcdataseth as handle no-undo .
     3484   define input parameter p-trgdataseth as handle no-undo .
     3485   define variable gh as handle no-undo .
     3486   define buffer buf_temp-rel-handle for temp-rel-handle.
     3487   do
     3488   on error undo, return error
     3489   :
     3490     if not valid-handle(p-srcdataseth)
     3491     or p-srcdataseth:type <> "DATASET"
     3492     then do:
     3493       return error substitute("Не определен dataset-источник с handle &1", p-srcdataseth).
     3494     end.
     3495     if not valid-handle(p-trgdataseth)
     3496     or p-trgdataseth:type <> "DATASET"
     3497     then do:
     3498       return error substitute("Не определен dataset-приемник с handle &1", p-trgdataseth).
     3499     end.
     3500     for each buf_temp-rel-handle no-lock where
     3501             buf_temp-rel-handle.dh = p-srcdataseth
     3502     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3503     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     3504     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     3505     :
     3506       gh = p-trgdataseth:ADD-RELATION ( buf_temp-rel-handle.parent-buffer-handle
     3507                                         , buf_temp-rel-handle.child-buffer-handle
     3508                                         , buf_temp-rel-handle.relation-fields_
     3509                                         , buf_temp-rel-handle.reposition_
     3510                                         , buf_temp-rel-handle.nested_).
     3511      if error-status:error
     3512      or not valid-handle(gh) then do:
     3513        undo, return error substitute("Ошибка при добавлении relation &1 в dataset &2", buf_temp-rel-handle.name, p-trgdataseth:name).
     3514      end.
     3515     end.
     3516   end.
     3517   end procedure.
     3518   procedure tmpreld2_query :
     3519   define  parameter buffer buf_temp-rel-handle for temp-rel-handle.
     3520   define input-output parameter p-child-qh as handle no-undo .
     3521   define variable glog as logical no-undo .
     3522   define variable v-mess as character no-undo .
     3523   _main:
     3524   do
     3525   on error undo, return error
     3526   :
     3527     create query p-child-qh .
     3528     glog = p-child-qh:set-buffers( buf_temp-rel-handle.child-buffer-handle) no-error.
     3529     if error-status:error
     3530     or
     3531     not glog then do:
     3532       v-mess = substitute("Ошибка при попытке получить записи &1&2&3"
     3533                           , buf_temp-rel-handle.child-buffer_
     3534                           , chr(10)
     3535                           , error-status:get-message(1)
     3536                           ).
     3537       delete object p-child-qh no-error.
     3538       undo _main, return error v-mess.
     3539     end.
     3540     glog = p-child-qh:query-prepare( substitute( "for each &1 &2 "
     3541                                               , buf_temp-rel-handle.child-buffer_
     3542                                               , buf_temp-rel-handle.where-string_
     3543                                               )) no-error .
     3544     if error-status:error
     3545     or
     3546     not glog then do:
     3547       v-mess =  substitute("Ошибка при попытке получить записи &1&2&3"
     3548                           , buf_temp-rel-handle.child-buffer_
     3549                           , chr(10)
     3550                           , error-status:get-message(1)
     3551                           ).
     3552       delete object p-child-qh no-error.
     3553       undo _main, return error v-mess.
     3554     end.
     3555     glog = p-child-qh:query-open no-error .
     3556     if error-status:error
     3557     or
     3558     not glog then do:
     3559       v-mess = substitute("Ошибка при попытке получить записи &1&2&3"
     3560                           , buf_temp-rel-handle.child-buffer_
     3561                           , chr(10)
     3562                           , error-status:get-message(1)
     3563                           ).
     3564       delete object p-child-qh no-error.
     3565       undo _main, return error v-mess.
     3566     end.
