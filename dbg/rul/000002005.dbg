     3006   procedure xmlchar-encode :
     3007   define input parameter p-in-string      as character        no-undo.
     3008   define output parameter p-out-string    as character        no-undo.
     3009       define variable v-position      as integer      no-undo.
     3010       define variable v-current-char  as character    no-undo.
     3011   do
     3012   on error undo, return error
     3013   :
     3014       assign
     3015           p-out-string = "":U
     3016       .
     3017       case p-in-string
     3018       :
     3019           when ?
     3020           then do:
     3021               assign
     3022                   p-out-string = "?":U
     3023               .
     3024           end.
     3025           when "?":U
     3026           then do:
     3027               assign
     3028                   p-out-string = "&#63;":U
     3029               .
     3030           end.
     3031           otherwise do:
     3032               do v-position = 1 to length( p-in-string )
     3033               :
     3034                   assign
     3035                       v-current-char = substring( p-in-string, v-position, 1 )
     3036                   .
     3037                   case v-current-char
     3038                   :
     3039                       when "&":U
     3040                       then do:
     3041                           assign
     3042                               p-out-string = p-out-string + "&amp;":U
     3043                           .
     3044                       end.
     3045                       when ">":U
     3046                       then do:
     3047                           assign
     3048                               p-out-string = p-out-string + "&gt;":U
     3049                           .
     3050                       end.
     3051                       when "<":U
     3052                       then do:
     3053                           assign
     3054                               p-out-string = p-out-string + "&lt;":U
     3055                           .
     3056                       end.
     3057                       when "'":U
     3058                       then do:
     3059                           assign
     3060                               p-out-string = p-out-string + "&apos;":U
     3061                           .
     3062                       end.
     3063                       when '"':U
     3064                       then do:
     3065                           assign
     3066                               p-out-string = p-out-string + "&quot;":U
     3067                           .
     3068                       end.
     3069                       when chr(1)
     3070                       then do:
     3071                           assign
     3072                               p-out-string = p-out-string + "":U
     3073                           .
     3074                       end.
     3075                       when chr(2)
     3076                       then do:
     3077                           assign
     3078                               p-out-string = p-out-string + "":U
     3079                           .
     3080                       end.
     3081                       when chr(3)
     3082                       then do:
     3083                           assign
     3084                               p-out-string = p-out-string + "":U
     3085                           .
     3086                       end.
     3087                       when chr(4)
     3088                       then do:
     3089                           assign
     3090                               p-out-string = p-out-string + "":U
     3091                           .
     3092                       end.
     3093                       when chr(5)
     3094                       then do:
     3095                           assign
     3096                               p-out-string = p-out-string + "":U
     3097                           .
     3098                       end.
     3099                       when chr(6)
     3100                       then do:
     3101                           assign
     3102                               p-out-string = p-out-string + "":U
     3103                           .
     3104                       end.
     3105                       when chr(7)
     3106                       then do:
     3107                           assign
     3108                               p-out-string = p-out-string + "":U
     3109                           .
     3110                       end.
     3111                       when chr(8)
     3112                       then do:
     3113                           assign
     3114                               p-out-string = p-out-string + "":U
     3115                           .
     3116                       end.
     3117                       when chr(9)
     3118                       then do:
     3119                           assign
     3120                               p-out-string = p-out-string + "":U
     3121                           .
     3122                       end.
     3123                       when chr(29)
     3124                       then do:
     3125                           assign
     3126                               p-out-string = p-out-string + "":U
     3127                           .
     3128                       end.
     3129                       when chr(10)
     3130                       then do:
     3131                           assign
     3132                               p-out-string = p-out-string + "&#10;":U
     3133                           .
     3134                       end.
     3135                       when chr(13)
     3136                       then do:
     3137                           assign
     3138                               p-out-string = p-out-string + "&#13;":U
     3139                           .
     3140                       end.
     3141                       otherwise do:
     3142                           assign
     3143                               p-out-string = p-out-string + v-current-char
     3144                           .
     3145                       end.
     3146                   end case.
     3147               end.
     3148           end.
     3149       end case.
     3150   end.
     3151   end .
     3152   procedure xmlchar-encode-1c :
