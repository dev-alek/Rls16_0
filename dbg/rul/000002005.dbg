     5189   define variable v-grop-level-always-presence like  ub.gds-obj-prop.grop-level-always-presence  no-undo.
     5190   define variable v-grop-max-stock             like  ub.gds-obj-prop.grop-max-stock              no-undo.
     5191   define variable v-grop-min-order             like  ub.gds-obj-prop.grop-min-order              no-undo.
     5192   DEFINE TEMP-TABLE tt0-gds-obj-prop NO-UNDO LIKE ub.gds-obj-prop.
     5193   DEFINE TEMP-TABLE tt0-gds-obj-prop-attr NO-UNDO LIKE ub.gds-obj-prop-attr.
     5194   define buffer buf_tt0-gds-obj-prop_ for  tt0-gds-obj-prop.
     5195   define buffer buf_tt0-gds-obj-prop-attr_ for  tt0-gds-obj-prop-attr.
     5196   define variable v-recid as recid no-undo.
