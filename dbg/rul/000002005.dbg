     5267   procedure gdspoatr-write :
     5268     define input parameter p-gds-code like ub.gds-obj-prop-attr.gds-code   no-undo .
     5269     define input parameter p-obj-type like ub.gds-obj-prop-attr.obj-type   no-undo .
     5270     define input parameter p-obj-code like ub.gds-obj-prop-attr.obj-code   no-undo .
