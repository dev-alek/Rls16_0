     4176   define variable vss-include-info22 as character format "X(65)" no-undo
     4177   initial "@(#)$Workfile$ $Revision$".
     4178   define temp-table temp_fbrglib_grp no-undo
     4179       field sel           as character
     4180       field full-name     as character
     4181       field out-code      as integer
     4182       field sort-name     as character
     4183       field node-code     as integer
     4184       field upper-code    as integer
     4185       field name          as character
     4186       field level         as integer
     4187       field mark          as character
     4188       field obj-type      as character
     4189       field obj-code      as integer
     4190       field global-code   as integer
     4191       index pi is primary unique obj-type obj-code sort-name
     4192       index fn obj-type obj-code full-name
     4193       index nc is unique obj-type obj-code node-code
     4194       index sl obj-type obj-code sel
     4195       index uc obj-type obj-code upper-code
     4196   .
     4197   define temp-table temp_fbrglib_found-grp no-undo
     4198       field full-name   as character
     4199       field sort-name   as character
     4200       field node-code   as integer
     4201       field level       as integer
     4202       field is-terminal as logical
     4203       field obj-type      as character
     4204       field obj-code      as integer
     4205       index pi is primary unique obj-type obj-code sort-name
     4206       index fn obj-type obj-code full-name
     4207       index lv obj-type obj-code level
     4208       index it obj-type obj-code is-terminal
     4209   .
     4210   define temp-table temp_found-result-nodelist no-undo
     4211       field node-code     as integer
     4212       field processed     as logical
     4213       field sort-name     as character
     4214       field full-name     as character
     4215       index pi is primary unique node-code
     4216       index ps processed
     4217   .
     4218   procedure fbrglib-get-sort-name :
     4219   do
     4220   on error undo, return error
     4221   :
     4222   define input parameter p-obj-type   as character    no-undo.
     4223   define input parameter p-obj-code   as integer      no-undo.
     4224   define input parameter p-node-code  as integer      no-undo.
     4225   define output parameter p-sort-name as character    no-undo.
     4226       define variable v-upper-code    as integer           no-undo.
     4227       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     4228       define buffer buf_upper_fbr-gds-grp for ub.fbr-gds-grp.
     4229       find first buf_fbr-gds-grp no-lock
     4230            where buf_fbr-gds-grp.obj-type  = p-obj-type
     4231              and buf_fbr-gds-grp.obj-code  = p-obj-code
     4232              and buf_fbr-gds-grp.node-code = p-node-code
     4233       no-error.
     4234       if not available buf_fbr-gds-grp
     4235       then do:
     4236           undo, return error "fbrglib-get-sort-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     4237       end.
     4238       assign
     4239           p-sort-name  = ""
     4240           v-upper-code = 1
     4241       .
     4242       do while true
     4243       on error undo, return error "fbrglib-get-sort-name: Ошибка составления полного имени группы"
     4244       :
     4245           assign
     4246               p-sort-name  = buf_fbr-gds-grp.node-name
     4247                            + (if p-sort-name <> "" then chr(2) else "")
     4248                            + p-sort-name
     4249               v-upper-code = buf_fbr-gds-grp.upper-code
     4250           .
     4251           if buf_fbr-gds-grp.upper-code = 1
     4252           then do:
     4253               leave.
     4254           end.
     4255           find first buf_fbr-gds-grp no-lock
     4256                where buf_fbr-gds-grp.obj-type  = p-obj-type
     4257                  and buf_fbr-gds-grp.obj-code  = p-obj-code
     4258                  and buf_fbr-gds-grp.node-code = v-upper-code
     4259           no-error.
     4260           if not available buf_fbr-gds-grp
     4261           then do:
     4262               undo, return error "fbrglib-get-sort-name: Не найдена группа товаров с кодом "
     4263                                   + string( v-upper-code )
     4264                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     4265           end.
     4266       end.
     4267   end.
     4268   end procedure.
     4269   procedure fbrglib-get-full-name :
     4270   do
     4271   on error undo, return error
     4272   :
     4273   define input parameter p-obj-type   as character    no-undo.
     4274   define input parameter p-obj-code   as integer      no-undo.
     4275   define input parameter p-node-code  as integer      no-undo.
     4276   define output parameter p-full-name as character    no-undo.
     4277       define variable v-upper-code    as integer           no-undo.
     4278       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     4279       define buffer buf_upper_fbr-gds-grp for ub.fbr-gds-grp.
     4280       if p-node-code = 1
     4281       then do:
     4282           assign
     4283               p-full-name = ""
     4284           .
     4285       end.
     4286       else do:
     4287           find first buf_fbr-gds-grp no-lock
     4288                where buf_fbr-gds-grp.obj-type  = p-obj-type
     4289                  and buf_fbr-gds-grp.obj-code  = p-obj-code
     4290                  and buf_fbr-gds-grp.node-code = p-node-code
     4291           no-error.
     4292           if not available buf_fbr-gds-grp
     4293           then do:
     4294               undo, return error "fbrglib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     4295           end.
     4296           assign
     4297               p-full-name  = ""
     4298               v-upper-code = 1
     4299           .
     4300           do while true
     4301           on error undo, return error "fbrglib-get-full-name: Ошибка составления полного имени группы"
     4302           :
     4303               assign
     4304                   p-full-name  = buf_fbr-gds-grp.node-name
     4305                               + (if p-full-name <> "" then chr(47) else "")
     4306                               + p-full-name
     4307                   v-upper-code = buf_fbr-gds-grp.upper-code
     4308               .
     4309               if buf_fbr-gds-grp.upper-code = 1
     4310               then do:
     4311                   leave.
     4312               end.
     4313               find first buf_fbr-gds-grp no-lock
     4314                    where buf_fbr-gds-grp.obj-type  = p-obj-type
     4315                      and buf_fbr-gds-grp.obj-code  = p-obj-code
     4316                      and buf_fbr-gds-grp.node-code = v-upper-code
     4317               no-error.
     4318               if not available buf_fbr-gds-grp
     4319               then do:
     4320                   undo, return error "fbrglib-get-full-name: Не найдена группа товаров с кодом "
     4321                                       + string( v-upper-code )
     4322                                       + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     4323               end.
     4324           end.
     4325           assign
     4326               p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     4327           .
     4328       end.
     4329   end.
     4330   end procedure.
     4331   procedure fbrglib-get-root-code :
     4332   do
     4333   on error undo, return error
     4334   :
     4335   define output parameter p-root-code as integer      no-undo.
     4336       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     4337       find first buf_fbr-gds-grp no-lock
     4338            where buf_fbr-gds-grp.upper-code = 0
     4339       no-error .
     4340       if not available buf_fbr-gds-grp
     4341       then do:
     4342           undo, return error .
     4343       end.
     4344       else do:
     4345           assign
     4346               p-root-code = buf_fbr-gds-grp.node-code
     4347           .
     4348       end.
     4349   end.
     4350   end procedure.
     4351   procedure fbrglib-find-grp-by-full-name :
     4352   do
     4353   on error undo, return error
     4354   :
     4355   define input parameter p-obj-type     as character    no-undo.
     4356   define input parameter p-obj-code     as integer      no-undo.
     4357   define input parameter p-search-name  as character    no-undo.
     4358   define input parameter p-fill-path    as logical      no-undo.
     4359       define variable v-upper-code    as integer          no-undo.
     4360       define variable v-not-found     as logical init yes no-undo.
     4361       define variable v-counter       as integer           no-undo.
     4362       define variable v-level         as integer           no-undo.
     4363       define variable v-full-name     as character         no-undo.
     4364       define variable v-sort-name     as character         no-undo.
     4365       define variable v-node-name     as character      no-undo.
     4366       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     4367       assign
     4368           p-search-name = replace( p-search-name, chr(47), chr(2) )
     4369       .
     4370       run fbrglib-get-root-code ( output v-upper-code ) no-error .
     4371       if error-status :error
     4372       then do:
     4373           undo, return error "fbrglib-find-grp-by-full-name: Ошибка при поиске корневого узла".
     4374       end.
     4375       assign
     4376           v-full-name  = ""
     4377           v-level      = num-entries( p-search-name, chr(2) )
     4378       .
     4379       for each temp_fbrglib_found-grp
     4380       :
     4381           delete temp_fbrglib_found-grp.
     4382       end.
     4383       start-name-analyze:
     4384       do v-counter = 1 to v-level
     4385       :
     4386           if v-counter < v-level
     4387           then do:
     4388               assign
     4389                   v-node-name = entry( v-counter, p-search-name, chr(2) )
     4390               .
     4391               find first buf_fbr-gds-grp no-lock
     4392                    where buf_fbr-gds-grp.obj-type   = p-obj-type
     4393                      and buf_fbr-gds-grp.obj-code   = p-obj-code
     4394                      and buf_fbr-gds-grp.upper-code = v-upper-code
     4395                      and buf_fbr-gds-grp.node-name  = v-node-name
     4396               no-error .
     4397               if not available buf_fbr-gds-grp
     4398               then do:
     4399                   assign
     4400                       v-full-name  = p-search-name
     4401                       v-sort-name  = p-search-name
     4402                   .
     4403                   return error "fbrglib-find-grp-by-full-name: не найдена группа " + entry( v-level, p-search-name, chr(47) ).
     4404               end.
     4405               else do:
     4406                   assign
     4407                       v-full-name = v-full-name + ( if v-full-name = "" then "" else chr(47) )        + buf_fbr-gds-grp.node-name
     4408                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_fbr-gds-grp.node-name
     4409                       v-upper-code = buf_fbr-gds-grp.node-code
     4410                   .
     4411                   if p-fill-path = yes
     4412                   then do:
     4413                       create temp_fbrglib_found-grp.
     4414                       assign
     4415                           temp_fbrglib_found-grp.full-name = v-full-name + chr(47)
     4416                           temp_fbrglib_found-grp.sort-name = v-sort-name
     4417                           temp_fbrglib_found-grp.node-code = v-upper-code
     4418                           temp_fbrglib_found-grp.level     = v-counter
     4419                           temp_fbrglib_found-grp.obj-type  = p-obj-type
     4420                           temp_fbrglib_found-grp.obj-code  = p-obj-code
     4421                       .
     4422                   end.
     4423               end.
     4424           end.
     4425           else do:
     4426               for each buf_fbr-gds-grp no-lock
     4427                  where buf_fbr-gds-grp.obj-type   = p-obj-type
     4428                    and buf_fbr-gds-grp.obj-code   = p-obj-code
     4429                    and buf_fbr-gds-grp.upper-code = v-upper-code
     4430                    and buf_fbr-gds-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
     4431               :
     4432                   assign
     4433                       v-not-found = no
     4434                   .
     4435                   create temp_fbrglib_found-grp.
     4436                   assign
     4437                       temp_fbrglib_found-grp.full-name = v-full-name
     4438                                                           + (if v-full-name = "" then "" else chr(47) )
     4439                                                           + buf_fbr-gds-grp.node-name + chr(47)
     4440                       temp_fbrglib_found-grp.sort-name = v-sort-name
     4441                                                           + ( if v-sort-name = "" then "" else chr(2) )
     4442                                                           + buf_fbr-gds-grp.node-name
     4443                       temp_fbrglib_found-grp.node-code = buf_fbr-gds-grp.node-code
     4444                       temp_fbrglib_found-grp.level     = v-level
     4445                       temp_fbrglib_found-grp.obj-type  = p-obj-type
     4446                       temp_fbrglib_found-grp.obj-code  = p-obj-code
     4447                   .
     4448               end.
     4449               if v-not-found = yes
     4450               then do:
     4451                   assign
     4452                       v-full-name  = p-search-name
     4453                       v-sort-name  = p-search-name
     4454                   .
     4455                   for each temp_fbrglib_found-grp
     4456                   :
     4457                       delete temp_fbrglib_found-grp.
     4458                   end.
     4459                   return error "fbrglib-find-grp-by-full-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
     4460               end.
     4461           end.
     4462       end.
     4463   end.
     4464   end procedure.
     4465   procedure fbrglib-find-all-subgroup :
     4466   do
     4467   on error undo, return error
     4468   :
     4469   define input parameter p-start-obj-type     as character    no-undo.
     4470   define input parameter p-start-obj-code     as integer      no-undo.
     4471   define input parameter p-start-node-code    as integer      no-undo.
     4472   define input parameter p-terminal-only      as logical      no-undo.
     4473       define variable v-start-full-name   as character     no-undo.
     4474       define variable v-start-sort-name   as character     no-undo.
     4475       define variable v-not-found         as logical       no-undo.
     4476       define variable v-is-terminal       as logical       no-undo.
     4477       define buffer buf_fbr-gds-grp           for ub.fbr-gds-grp.
     4478       create temp_found-result-nodelist.
     4479       assign
     4480           temp_found-result-nodelist.node-code = p-start-node-code
     4481           temp_found-result-nodelist.processed = no
     4482       .
     4483       run fbrglib-get-full-name in this-procedure (
     4484             input p-start-obj-type
     4485           , input p-start-obj-code
     4486           , input p-start-node-code
     4487           , output v-start-full-name
     4488       ).
     4489       run fbrglib-get-full-name in this-procedure (
     4490             input p-start-obj-type
     4491           , input p-start-obj-code
     4492           , input p-start-node-code
     4493           , output v-start-sort-name
     4494       ).
     4495       process-nodes:
     4496       do while yes
     4497       :
     4498           find first temp_found-result-nodelist
     4499                where temp_found-result-nodelist.node-code = p-start-node-code
     4500           .
     4501           assign
     4502               temp_found-result-nodelist.processed = yes
     4503           .
     4504           for each buf_fbr-gds-grp no-lock
     4505              where buf_fbr-gds-grp.obj-type   = p-start-obj-type
     4506                and buf_fbr-gds-grp.obj-code   = p-start-obj-code
     4507                and buf_fbr-gds-grp.upper-code = p-start-node-code
     4508           on error undo, return error
     4509           :
     4510               run fbrglib-is-terminal in this-procedure (
     4511                     input buf_fbr-gds-grp.obj-type
     4512                   , input buf_fbr-gds-grp.obj-code
     4513                   , input buf_fbr-gds-grp.node-code
     4514                   , output v-is-terminal
     4515               ).
     4516               if v-is-terminal = yes
     4517               then do:
     4518                   create temp_fbrglib_found-grp.
     4519                   assign
     4520                       temp_fbrglib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     4521                                                           chr(47) + buf_fbr-gds-grp.node-name + chr(47)
     4522                       temp_fbrglib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     4523                                                           chr(2) + buf_fbr-gds-grp.node-name + chr(2)
     4524                       temp_fbrglib_found-grp.node-code   = buf_fbr-gds-grp.node-code
     4525                       temp_fbrglib_found-grp.is-terminal = yes
     4526                       temp_fbrglib_found-grp.obj-type  = p-start-obj-type
     4527                       temp_fbrglib_found-grp.obj-code  = p-start-obj-code
     4528                   .
     4529               end.
     4530               else do:
     4531                   create temp_found-result-nodelist.
     4532                   assign
     4533                       temp_found-result-nodelist.node-code = buf_fbr-gds-grp.node-code
     4534                       temp_found-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
     4535                                                              chr(47) + buf_fbr-gds-grp.node-name + chr(47)
     4536                       temp_found-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
     4537                                                              chr(2) + buf_fbr-gds-grp.node-name + chr(2)
     4538                       temp_found-result-nodelist.processed = no
     4539                   .
     4540                   if p-terminal-only = no
     4541                   then do:
     4542                       create temp_fbrglib_found-grp.
     4543                       assign
     4544                           temp_fbrglib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     4545                                                               chr(47) + buf_fbr-gds-grp.node-name + chr(47)
     4546                           temp_fbrglib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     4547                                                               chr(2) + buf_fbr-gds-grp.node-name + chr(2)
     4548                           temp_fbrglib_found-grp.node-code   = buf_fbr-gds-grp.node-code
     4549                           temp_fbrglib_found-grp.is-terminal = no
     4550                           temp_fbrglib_found-grp.obj-type  = p-start-obj-type
     4551                           temp_fbrglib_found-grp.obj-code  = p-start-obj-code
     4552                       .
     4553                   end.
     4554               end.
     4555           end.
     4556           find first temp_found-result-nodelist
     4557                where temp_found-result-nodelist.processed = no
     4558           no-error.
     4559           if not available temp_found-result-nodelist
     4560           then do:
     4561               leave process-nodes.
     4562           end.
     4563           else do:
     4564               assign
     4565                   p-start-node-code = temp_found-result-nodelist.node-code
     4566                   v-start-full-name = temp_found-result-nodelist.full-name
     4567                   v-start-sort-name = temp_found-result-nodelist.sort-name
     4568               .
     4569           end.
     4570       end.
     4571   end.
     4572   end procedure.
     4573   procedure fbrglib-expand-name :
     4574   do
     4575   on error undo, return error
     4576   :
     4577   define input parameter p-obj-type   as character    no-undo.
     4578   define input parameter p-obj-code   as integer      no-undo.
     4579   define input parameter p-start-name as character    no-undo.
     4580   define output parameter p-end-name  as character    no-undo.
     4581       define variable v-is-terminal     as logical           no-undo.
     4582       define buffer buf_temp_fbrglib_found-grp     for temp_fbrglib_found-grp.
     4583       run fbrglib-find-grp-by-full-name in this-procedure (
     4584             input p-obj-type
     4585           , input p-obj-code
     4586           , input p-start-name
     4587           , input no
     4588       ) no-error.
     4589       run fbrglib-get-max-substring in this-procedure (
     4590              input p-obj-type
     4591           ,  input p-obj-code
     4592           ,  input length( p-start-name )
     4593           , output p-end-name
     4594       ) no-error .
     4595       if error-status :error
     4596       then do:
     4597           assign
     4598               p-end-name = ""
     4599           .
     4600       end.
     4601       else do:
     4602           find first temp_fbrglib_found-grp
     4603                where temp_fbrglib_found-grp.full-name = p-end-name
     4604                   AND temp_fbrglib_found-grp.obj-type  = p-obj-type
     4605                   AND temp_fbrglib_found-grp.obj-code  = p-obj-code
     4606                        no-error.
     4607           if available temp_fbrglib_found-grp
     4608           then do:
     4609               find first buf_temp_fbrglib_found-grp
     4610                    where buf_temp_fbrglib_found-grp.full-name begins p-end-name
     4611                      and recid( buf_temp_fbrglib_found-grp ) <> recid( temp_fbrglib_found-grp )
     4612                   AND temp_fbrglib_found-grp.obj-type  = p-obj-type
     4613                   AND temp_fbrglib_found-grp.obj-code  = p-obj-code
     4614               no-error.
     4615               if not available buf_temp_fbrglib_found-grp
     4616               then do:
     4617                   run fbrglib-is-terminal in this-procedure (
     4618                         input p-obj-type
     4619                       , input p-obj-code
     4620                       , input temp_fbrglib_found-grp.node-code
     4621                       , output v-is-terminal
     4622                   ).
     4623               end.
     4624           end.
     4625       end.
     4626   end.
     4627   end procedure.
     4628   procedure fbrglib-get-max-substring :
     4629   do
     4630   on error undo, return error
     4631   :
     4632   define input parameter p-obj-type as character no-undo .
     4633   define input parameter p-obj-code as integer no-undo .
     4634   define input parameter p-min-substring-length   as integer      no-undo.
     4635   define output parameter p-substring             as character    no-undo.
     4636           define variable v-char-counter  as integer           no-undo.
     4637           define variable v-current-char  as character         no-undo.
     4638           define variable v-names-counter  as integer           no-undo.
     4639           define variable v-base-string   as character         no-undo.
     4640           assign
     4641               v-char-counter  = p-min-substring-length
     4642           .
     4643           find first temp_fbrglib_found-grp  where
     4644                      temp_fbrglib_found-grp.obj-type  = p-obj-type
     4645                   AND temp_fbrglib_found-grp.obj-code  = p-obj-code
     4646           no-error.
     4647           if not available temp_fbrglib_found-grp
     4648           then do:
     4649               undo, return error "fbrglib-get-max-substring: Нет строк для вычисления общей подстроки".
     4650           end.
     4651           else do:
     4652               assign
     4653                   v-base-string = temp_fbrglib_found-grp.full-name
     4654               .
     4655               counter-block:
     4656               do while yes
     4657               on error undo, return error "fbrglib-get-max-substring: Ошибка вычисления продолжения имени группы."
     4658               :
     4659                   assign
     4660                       v-char-counter  = v-char-counter + 1
     4661                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
     4662                       v-names-counter = 0
     4663                   .
     4664                   compare-block:
     4665                   for each temp_fbrglib_found-grp
     4666                   where temp_fbrglib_found-grp.obj-type  = p-obj-type
     4667                   AND temp_fbrglib_found-grp.obj-code  = p-obj-code
     4668                   :
     4669                       assign
     4670                           v-names-counter = v-names-counter + 1
     4671                       .
     4672                       if v-names-counter = 1
     4673                       then do:
     4674                           next compare-block.
     4675                       end.
     4676                       if substring( temp_fbrglib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
     4677                       then do:
     4678                           leave counter-block.
     4679                       end.
     4680                   end.
     4681                   if v-names-counter = 1
     4682                   then do:
     4683                       assign
     4684                           p-substring = v-base-string
     4685                       .
     4686                       return.
     4687                   end.
     4688               end.
     4689               assign
     4690                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
     4691               .
     4692           end.
     4693   end.
     4694   end procedure.
     4695   procedure fbrglib-is-terminal :
     4696   do
     4697   on error undo, return error "Ошибка процедуры fbrglib-is-terminal"
     4698   :
     4699   define input parameter p-obj-type       as character    no-undo.
     4700   define input parameter p-obj-code       as integer      no-undo.
     4701   define input parameter p-node-code      as integer      no-undo.
     4702   define output parameter p-is-terminal   as logical      no-undo.
     4703       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     4704       find first buf_fbr-gds-grp no-lock
     4705            where buf_fbr-gds-grp.obj-type   = p-obj-type
     4706              and buf_fbr-gds-grp.obj-code   = p-obj-code
     4707              and buf_fbr-gds-grp.upper-code = p-node-code
     4708       no-error .
     4709       if not available buf_fbr-gds-grp
     4710       then do:
     4711           assign
     4712               p-is-terminal = yes
     4713           .
     4714       end.
     4715       else do:
     4716           assign
     4717               p-is-terminal = no
     4718           .
     4719       end.
     4720   end.
     4721   end procedure.
     4722   procedure fbrglib-have-goods :
     4723   do
     4724   on error undo, return error
     4725   :
     4726   define input parameter p-obj-type           as character    no-undo.
     4727   define input parameter p-obj-code           as integer      no-undo.
     4728   define input parameter p-node-code          as integer      no-undo.
     4729   define output parameter p-have-fbr-gds-obj  as logical      no-undo.
     4730       define buffer buf_fbr-gds-obj         for ub.fbr-gds-obj.
     4731       find first buf_fbr-gds-obj no-lock
     4732            where buf_fbr-gds-obj.obj-type     = p-obj-type
     4733              and buf_fbr-gds-obj.obj-code     = p-obj-code
     4734              and buf_fbr-gds-obj.fbr-grp-code = p-node-code
     4735       no-error .
     4736       if available buf_fbr-gds-obj
     4737       then do:
     4738           assign
     4739               p-have-fbr-gds-obj = yes
     4740           .
     4741       end.
     4742       else do:
     4743           assign
     4744               p-have-fbr-gds-obj = no
     4745           .
     4746       end.
     4747   end.
     4748   end procedure.
     4749   procedure fbrglib-find-by-substring :
     4750   do
     4751   on error undo, return error
     4752   :
     4753   define input parameter p-start-obj-type     as character    no-undo.
     4754   define input parameter p-start-obj-code     as integer      no-undo.
     4755   define input parameter p-start-code         as integer      no-undo.
     4756   define input parameter p-full-search-string as character    no-undo.
     4757   define output parameter p-found-code        as integer      no-undo.
     4758   define output parameter p-full-name         as character    no-undo.
     4759       define variable v-start-code     as integer           no-undo.
     4760       define variable v-found          as logical  init no  no-undo.
     4761       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     4762       search-grp:
     4763       for each buf_fbr-gds-grp no-lock
     4764           where buf_fbr-gds-grp.obj-type  = p-start-obj-type
     4765             and buf_fbr-gds-grp.obj-code  = p-start-obj-code
     4766             and buf_fbr-gds-grp.node-code > p-start-code
     4767       :
     4768           if index( buf_fbr-gds-grp.node-name, p-full-search-string ) <> 0
     4769           then do:
     4770               assign
     4771                   p-found-code = buf_fbr-gds-grp.node-code
     4772                   v-found      = yes
     4773               .
     4774               run fbrglib-get-full-name in this-procedure (
     4775                     input p-start-obj-type
     4776                   , input p-start-obj-code
     4777                   , input p-found-code
     4778                   , output p-full-name
     4779               ) no-error .
     4780               if error-status :error
     4781               then do:
     4782                   undo, return error "fbrglib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
     4783               end.
     4784               leave search-grp.
     4785           end.
     4786       end.
     4787       if v-found = yes
     4788       then do:
     4789       end.
     4790       else do:
     4791           assign
     4792               p-full-name  = ""
     4793               p-found-code = 0
     4794           .
     4795       end.
     4796   end.
     4797   end procedure.
     4798   procedure fbrglib-analyze-grp-name :
     4799   do
     4800   on error undo, return error
     4801   :
     4802   define input parameter p-grp-name       as character            no-undo.
     4803   define input parameter p-obj-type       as character            no-undo.
     4804   define input parameter p-obj-code       as integer              no-undo.
     4805   define input parameter p-upper-code     as integer              no-undo.
     4806   define output parameter p-error-message as character init ""    no-undo.
     4807       define variable v-char-list     as character    no-undo.
     4808       define variable v-char-counter  as integer      no-undo.
     4809       define variable v-full-name     as character    no-undo.
     4810       if p-grp-name = "" then do:
     4811           assign
     4812               p-error-message = "Название группы не может быть пустым.".
     4813           .
     4814       end.
     4815       else do:
     4816           assign
     4817               v-char-list = "47,92,58,63,34,60,62,171,187,183"
     4818           .
     4819           do v-char-counter = 1 to num-entries( v-char-list )
     4820           :
     4821               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
     4822               then do:
     4823                   assign
     4824                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
     4825                   .
     4826                   return.
     4827               end.
     4828           end.
     4829           run fbrglib-get-full-name in this-procedure (
     4830                 input p-obj-type
     4831               , input p-obj-code
     4832               , input p-upper-code
     4833               , output v-full-name
     4834           ) no-error .
     4835           if error-status :error
     4836           then do:
     4837               undo, return error "fbrglib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
     4838           end.
     4839           if length( v-full-name ) + 1 + length( p-grp-name ) > 120
     4840           then do:
     4841               assign
     4842                   p-error-message = 'Полное название группы не может содержать более 120 символов.'
     4843               .
     4844           end.
     4845       end.
     4846   end.
     4847   end procedure.
     4848   procedure fbrglib-delete-grp :
     4849   do
     4850   on error undo, return error
     4851   :
     4852   define input parameter p-obj-type   as character    no-undo.
     4853   define input parameter p-obj-code   as integer      no-undo.
     4854   define input parameter p-node-code  as integer      no-undo.
     4855   define output parameter p-deleted   as logical      no-undo.
     4856       define variable v-have-goods    as logical        no-undo.
     4857       define variable v-yesno         as logical        no-undo.
     4858       define variable v-upper-code    as integer        no-undo.
     4859       define variable v-root-code     as integer        no-undo.
     4860       define buffer buf_fbr-gds-grp           for ub.fbr-gds-grp.
     4861       define buffer buf_fbr-gds-obj           for ub.fbr-gds-obj.
     4862       define buffer buf_second_fbr-gds-grp    for ub.fbr-gds-grp.
     4863       run fbrglib-get-root-code in this-procedure (
     4864           output v-root-code
     4865       ) no-error.
     4866       if error-status :error
     4867       then do:
     4868           undo, return error "Не найден корневой узел." + chr(10) + return-value.
     4869       end.
     4870       if p-node-code = v-root-code
     4871       then do:
     4872           message
     4873               "Корневую группу удалить невозможно."
     4874           view-as alert-box error.
     4875           assign
     4876               p-deleted = no
     4877           .
     4878           undo, return.
     4879       end.
     4880       find first buf_fbr-gds-grp no-lock
     4881            where buf_fbr-gds-grp.obj-type     = p-obj-type
     4882              and buf_fbr-gds-grp.obj-code     = p-obj-code
     4883              and buf_fbr-gds-grp.upper-code   = p-node-code
     4884       no-error.
     4885       if available buf_fbr-gds-grp
     4886       then do:
     4887           message
     4888               "Не терминальную группу удалить невозможно."
     4889           view-as alert-box error.
     4890           assign
     4891               p-deleted = no
     4892           .
     4893           undo, return.
     4894       end.
     4895       find first buf_fbr-gds-grp no-lock
     4896            where buf_fbr-gds-grp.obj-type     = p-obj-type
     4897              and buf_fbr-gds-grp.obj-code     = p-obj-code
     4898              and buf_fbr-gds-grp.node-code    = p-node-code
     4899       .
     4900       assign
     4901           v-upper-code = buf_fbr-gds-grp.upper-code
     4902       .
     4903       run fbrglib-have-goods in this-procedure (
     4904             input p-obj-type
     4905           , input p-obj-code
     4906           , input p-node-code
     4907           , output v-have-goods
     4908       ).
     4909       if v-have-goods = yes
     4910       then do:
     4911           find first buf_second_fbr-gds-grp no-lock
     4912                where buf_second_fbr-gds-grp.obj-type      = buf_fbr-gds-grp.obj-type
     4913                  and buf_second_fbr-gds-grp.obj-code      = buf_fbr-gds-grp.obj-code
     4914                  and buf_second_fbr-gds-grp.upper-code    = buf_fbr-gds-grp.upper-code
     4915                  and recid( buf_second_fbr-gds-grp )      <> recid( buf_fbr-gds-grp )
     4916           no-error.
     4917           if available buf_second_fbr-gds-grp
     4918           then do:
     4919               message
     4920                   "В группе есть товары,"
     4921                   skip "которые нельзя перенести в родительскую группу,"
     4922                   skip "потому что у родительской группы есть еще одна подгруппа."
     4923                   skip(1)
     4924                   skip "Перенесите товары в другую группу"
     4925                   skip "или удалите все остальные подгруппы родительской группы."
     4926               view-as alert-box error.
     4927               assign
     4928                   p-deleted = no
     4929               .
     4930               undo, return.
     4931           end.
     4932           message
     4933               "В группе есть товары."
     4934               skip "После удаления группы"
     4935               skip "все ее товары будут привязаны"
     4936               skip "к ее родительской группе."
     4937               skip(1)
     4938               skip "Удалить группу?"
     4939           view-as alert-box warning
     4940           buttons yes-no
     4941           title "Удаление группы"
     4942           update v-yesno
     4943           .
     4944           if v-yesno = yes
     4945           then do:
     4946               do transaction
     4947               on error undo, return error
     4948               :
     4949                   for each buf_fbr-gds-obj exclusive-lock
     4950                      where buf_fbr-gds-obj.obj-type     = p-obj-type
     4951                        and buf_fbr-gds-obj.obj-code     = p-obj-code
     4952                        and buf_fbr-gds-obj.fbr-grp-code = p-node-code
     4953                   on error undo, return error
     4954                   :
     4955                       assign
     4956                           buf_fbr-gds-obj.fbr-grp-code = v-upper-code
     4957                       .
     4958                   end.
     4959               end.
     4960               do transaction
     4961               on error undo, return error
     4962               :
     4963                   find current buf_fbr-gds-grp exclusive-lock .
     4964                   delete buf_fbr-gds-grp no-error .
     4965                   if error-status:error then do:
     4966                     undo, return error return-value .
     4967                   end.
     4968               end.
     4969           end.
     4970       end.
     4971       else do:
     4972           message
     4973               "Имя группы: " buf_fbr-gds-grp.node-name
     4974               "Код группы: " buf_fbr-gds-grp.node-code
     4975               skip(1)
     4976               skip "Удалить группу?"
     4977           view-as alert-box warning
     4978           buttons yes-no
     4979           title "Удаление группы"
     4980           update v-yesno
     4981           .
     4982           if v-yesno = yes
     4983           then do:
     4984               do transaction
     4985               on error undo, return error
     4986               :
     4987                   find current buf_fbr-gds-grp exclusive-lock .
     4988                   delete buf_fbr-gds-grp no-error.
     4989                   if error-status:error then do:
     4990                     undo, return error return-value .
     4991                   end.
     4992               end.
     4993           end.
     4994       end.
     4995   end.
     4996   end procedure.
     4997   procedure fbrglib-add-grp :
     4998   do
     4999   on error undo, return error
     5000   :
     5001   define input parameter p-obj-type       as character    no-undo.
     5002   define input parameter p-obj-code       as integer      no-undo.
     5003   define input parameter p-node-code      as integer      no-undo.
     5004   define input parameter p-interface      as logical      no-undo.
     5005   define input parameter p-node-name      as character    no-undo.
     5006   define input parameter p-out-code       as integer      no-undo.
     5007   define input parameter p-global-code    as integer      no-undo.
     5008   define output parameter p-new-node-code as integer      no-undo.
     5009   define output parameter p-cancel        as logical      no-undo.
     5010       define variable v-have-goods    as logical  no-undo.
     5011       define variable v-host-code     as integer        no-undo.
     5012       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     5013       define buffer bf_fbr-gds-grp        for ub.fbr-gds-grp.
     5014       define buffer buf_fbr-gds-obj       for ub.fbr-gds-obj.
     5015       run fbrglib-have-goods in this-procedure (
     5016             input p-obj-type
     5017           , input p-obj-code
     5018           , input p-node-code
     5019           , output v-have-goods
     5020       ) no-error .
     5021       if error-status :error
     5022       then do:
     5023           message
     5024                    vss-workfile vss-revision vss-description
     5025               skip "Ошибка определения наличия товаров в группе."
     5026               skip return-value
     5027               skip trim(error-status :get-message(1))
     5028                    trim(error-status :get-message(2))
     5029                    trim(error-status :get-message(3))
     5030           view-as alert-box error.
     5031           undo, return error .
     5032       end.
     5033   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5034   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     5035     (input  p-obj-type
     5036     ,input  p-obj-code
     5037     ,output v-host-code
     5038     )  .
     5039       find first buf_fbr-gds-grp no-lock where
     5040                 buf_fbr-gds-grp.upper-code = p-node-code
     5041             AND buf_fbr-gds-grp.obj-type   = p-obj-type
     5042             AND buf_fbr-gds-grp.obj-code   = p-obj-code
     5043             AND buf_fbr-gds-grp.node-name  = p-node-name no-error .
     5044       if available buf_fbr-gds-grp then do:
     5045           if p-node-code <> 1 then do:
     5046             find first buf_fbr-gds-grp no-lock where
     5047                       buf_fbr-gds-grp.node-code = p-node-code
     5048                   AND buf_fbr-gds-grp.obj-type   = p-obj-type
     5049                   AND buf_fbr-gds-grp.obj-code   = p-obj-code  .
     5050           end.
     5051                   message
     5052           "Для объекта" p-obj-type p-obj-code
     5053           "уже есть группа блюд" p-node-name "в подгруппе" (if p-node-code = 1 then "БЛЮДА" else buf_Fbr-gds-grp.node-name)
     5054           view-as alert-box error .
     5055           undo, return error .
     5056       end.
     5057       do transaction
     5058       on error undo, return error
     5059       :
     5060           create buf_fbr-gds-grp.
     5061           assign
     5062               buf_fbr-gds-grp.node-code   = next-value( s-gds-grp, ub )
     5063               p-new-node-code             = buf_fbr-gds-grp.node-code
     5064               buf_fbr-gds-grp.upper-code  = p-node-code
     5065               buf_fbr-gds-grp.host-code   = v-host-code
     5066               buf_fbr-gds-grp.obj-type    = p-obj-type
     5067               buf_fbr-gds-grp.obj-code    = p-obj-code
     5068               buf_fbr-gds-grp.node-name    = ""
     5069               buf_fbr-gds-grp.out-code    = 0
     5070           .
     5071           if p-interface then do:
     5072             run ref/fbrggrpd.w (
     5073                   input parparentproc
     5074                 , input 'ИЗМЕНЕНИЕ':U
     5075                 , input p-obj-type
     5076                 , input p-obj-code
     5077                 , input buf_fbr-gds-grp.node-code
     5078                 , input buf_fbr-gds-grp.upper-code
     5079                 , input buf_fbr-gds-grp.node-name
     5080                 , input buf_fbr-gds-grp.out-code
     5081                 , output buf_fbr-gds-grp.node-name
     5082                 , output buf_fbr-gds-grp.out-code
     5083                 , output p-cancel
     5084             ).
     5085             if p-cancel = yes
     5086             then do:
     5087                 delete buf_fbr-gds-grp.
     5088                 undo, return.
     5089             end.
     5090           end.
     5091           else do:
     5092             find first bf_fbr-gds-grp no-lock
     5093                 where bf_fbr-gds-grp.obj-type   = p-obj-type
     5094                   and bf_fbr-gds-grp.obj-code   = p-obj-code
     5095                   and bf_fbr-gds-grp.out-code   = p-out-code
     5096             no-error.
     5097             assign
     5098             buf_fbr-gds-grp.node-name    = p-node-name
     5099             buf_fbr-gds-grp.global-code  = p-global-code
     5100             buf_fbr-gds-grp.out-code     = (if available bf_fbr-gds-grp then 0 else p-out-code)
     5101             .
     5102           end.
     5103           if v-have-goods = yes
     5104           then do:
     5105               for each buf_fbr-gds-obj exclusive-lock
     5106                  where buf_fbr-gds-obj.obj-type      = p-obj-type
     5107                    and buf_fbr-gds-obj.obj-code      = p-obj-code
     5108                    and buf_fbr-gds-obj.fbr-grp-code  = p-node-code
     5109               on error undo, return error
     5110               :
     5111                   assign
     5112                       buf_fbr-gds-obj.fbr-grp-code = p-new-node-code
     5113                   .
     5114               end.
     5115           end.
     5116       end.
     5117   end.
     5118   end procedure.
     5119   define variable v-current-gds-code as integer no-undo .
     5120   define variable v-current-mode as character no-undo .
     5121   define variable v-current-artic as character no-undo .
     5122   define variable v-current-prod-type as character no-undo .
