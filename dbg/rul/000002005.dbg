     2987   procedure xmlchar-test :
     2988   define input parameter p-in-string          as character        no-undo.
     2989   define output parameter p-out-string-enc    as character        no-undo.
     2990   define output parameter p-out-string-dec    as character        no-undo.
     2991   do
     2992   on error undo, return error
     2993   :
     2994          run xmlchar-encode in this-procedure
     2995       (
     2996             input p-in-string
     2997           , output p-out-string-enc
     2998       ).
     2999          run xmlchar-decode in this-procedure
     3000       (
