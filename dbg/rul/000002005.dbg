     3154   define output parameter p-out-string    as character        no-undo.
     3155       define variable v-position      as integer      no-undo.
     3156       define variable v-current-char  as character    no-undo.
     3157   do
     3158   on error undo, return error
     3159   :
     3160       assign
     3161           p-out-string = "":U
     3162       .
     3163       case p-in-string
     3164       :
     3165           when ?
     3166           then do:
     3167               assign
     3168                   p-out-string = "?":U
     3169               .
     3170           end.
     3171           otherwise do:
     3172               do v-position = 1 to length( p-in-string )
     3173               :
     3174                   assign
