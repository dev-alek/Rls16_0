     1210   function context_begin-esys-command return logical
     1211   (
     1212       input p-esys-id-list as character
     1213      ,input-output p-esys-cmd-proc-handle as handle
     1214      ,output p-esys-cmd-code as integer
     1215   ):
     1216      if not valid-handle(p-esys-cmd-proc-handle )
     1217      then do:
     1218        run nws/cmd-bush.p persistent set p-esys-cmd-proc-handle no-error .
     1219        if error-status :error
     1220        then do:
     1221           delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( substitute("&1 &2 &3&4Ошибка при запуске процедуры cmd-bush.p&4" +
     1222                                              "&5&4&6"
     1223                                              ,vss-workfile
     1224                                              ,vss-revision
     1225                                              ,vss-description
     1226                                              ,chr(10)
     1227                                              ,error-status:get-message(1)
     1228                                              ,return-value )).
     1229        end.
     1230        run begin-create-command in p-esys-cmd-proc-handle
     1231          (input 'cmd-esys-general':U
     1232          ,input p-esys-id-list
     1233          ,output p-esys-cmd-code
     1234          ) no-error.
     1235        if error-status :error
     1236        then do:
     1237          delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при создании команды &1&2&3&1&4"
     1238                                                           , 'cmd-esys-general':U
     1239                                                           , error-status:get-message(1)
     1240                                                           , return-value
     1241                                                           )).
     1242          return no .
     1243        end.
     1244        return yes.
     1245      end.
     1246   end.
     1247   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1248   function context_send-esys-command return int64
