     1266            delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при отсылке во внешнюю систему &1 команды с кодом &2&3&4&3&5"
     1267                                                           , p-esys-id-list
     1268                                                           , p-cmd-code
     1269                                                           , chr(10)
     1270                                                           , error-status:get-message(1)
     1271                                                           , return-value
     1272                                                           )).
     1273            return 0.
     1274         end.
     1275         delete procedure p-esys-cmd-proc-handle no-error.
     1276         return v-dmp-ord-int64.
     1277      end.
     1278      else do:
     1279         delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при отсылке во внешнюю систему &1 команды с кодом &2&3&4&3&5"
     1280                                                       , p-esys-id-list
     1281                                                       , p-cmd-code
     1282                                                       , chr(10)
