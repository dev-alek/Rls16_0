     1360   run load-ruleset-context in this-procedure ( input p-ruleset-id) no-error.
     1361   if error-status:error then undo, return error return-value .
     1362   define variable ExpData1 as class Route-data_ no-undo .
     1363   ExpData1 = new Route-data_( input parparentproc, input p-parent-handle, input p-log-handle, input this-procedure:handle) .
     1364   define variable v-DATA as memptr no-undo.
     1365   if not this-procedure:persistent then do:
     1366     run proc-main in this-procedure no-error .
     1367     if error-status:error then do:
     1368       v-esm = error-status :get-message (1).
     1369       v-es = error-status:error .
     1370       v-rv = return-value .
     1371     end.
     1372     if v-es then do:
     1373               run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute( "&1. &2&3&4", vss-workfile, v-rv, chr(10), v-esm)).
     1374         run garbcoll_clear in this-procedure .
     1375         undo, return error substitute( "&1. &2&3&4", vss-workfile, v-rv, chr(10), v-esm).
     1376     end.
     1377     run garbcoll_clear in this-procedure .
     1378   end.
     1379   procedure proc-main :
     1380   define variable expObj  as class expsubject no-undo .
     1381   define variable subObj  as class shift no-undo .
     1382   define variable subObj2 as class check no-undo .
     1383   define variable v-doc-rowid      as rowid  no-undo .
     1384   define variable v-sht-status     as character no-undo .
     1385   define variable v-fld-sht-status as handle no-undo .
     1386   define variable v-custom-pack-name as character no-undo .
     1387   define variable v-dump-ord-int64   as int64 no-undo .
     1388   define buffer buf_shift-obj   for ub.shift-obj .
     1389   define buffer buf_chk-doc   for ub.chk-doc.
     1390   _main:
     1391   do
     1392   on error undo, return error substitute( "&1&2&3&2&4", return-value, chr(10), error-status :get-message (1), v-last-error-message)
     1393   :
     1394   if v-has-newbh and v-newbh:table <> "chk-doc" then do:
     1395     if v-has-newbh then do:
     1396       v-doc-rowid = v-newbh:rowid .
     1397       v-fld-sht-status = v-newbh:BUFFER-FIELD ("status_") .
     1398       if not valid-handle(v-fld-sht-status) and v-newbh:table <> "chk-doc" then undo _main, return error "не найдено поле shift-obj.status_" .
     1399        v-sht-status = v-fld-sht-status:BUFFER-VALUE ( ) .
     1400     end.
     1401     else do:
     1402       v-doc-rowid = v-oldbh:rowid .
     1403       return .
     1404     end.
     1405     if (v-sht-status = 'зкр':U) or (v-sht-status = 'тек':U) then do:
     1406     IF not context_begin-esys-command( input string(v-esys-id-list), input-output v-esys-cmd-proc-handle, output v-esys-cmd-code) THEN
     1407       undo _main, return error v-last-error-message .
     1408       subObj = new shift ().
     1409       subObj:KeyRowid = v-doc-rowid.
     1410       expObj = new expsubject ().
     1411       expObj:GetContent(subObj) no-error.
     1412       if error-status:error then
     1413       do:
     1414         undo _main, return error expObj:Msg .
     1415       end.
     1416       IF not ExpData1:esys-add-dump-data ( INPUT expObj:Data
     1417                                          , INPUT v-esys-cmd-proc-handle
     1418                                          , INPUT v-esys-cmd-code
     1419                                          , '+update' + chr(4) + expObj:InitSecTag +
     1420                                          (if expObj:sendTableName <> ""
     1421                                             then substitute("&1&2&3&4",chr(4),
     1422                                                             expObj:sendTableName,
     1423                                                             if expObj:sendOldRowid <> ? then substitute("&1&2",chr(3),expObj:sendOldRowid) else "",
     1424                                                             if expObj:sendNewRowid <> ? then substitute("&1&2",chr(3),expObj:sendNewRowid) else "")
     1425                                           else "")) THEN
     1426         undo _main, return error v-last-error-message .
     1427     IF not context_set-custom-esys-pck-name(  input v-esys-cmd-proc-handle, input v-esys-cmd-code, input v-custom-pack-name) THEN
     1428       undo _main, return error v-last-error-message .
     1429     v-dump-ord-int64 = context_send-esys-command( input v-esys-id-list
     1430                                     , input v-esys-cmd-proc-handle
     1431                                     , input v-esys-cmd-code
     1432                                     , input g#userid).
     1433     if v-dump-ord-int64 = 0 THEN
     1434       undo _main, return error v-last-error-message .
     1435     end.
     1436       ExpData1:Route-data_clear-data ( ) .
     1437     if (v-sht-status = 'зкр':U) then do:
     1438     for first buf_shift-obj no-lock
     1439         where rowid(buf_shift-obj)  = v-doc-rowid
     1440           and buf_shift-obj.status_ = 'зкр':U :
     1441       subObj2 = new check ().
     1442       IF not context_begin-esys-command( input string(v-esys-id-list)
     1443                                        , input-output v-esys-cmd-proc-handle
     1444                                        , output v-esys-cmd-code) THEN
     1445         undo _main, return error v-last-error-message .
     1446       subObj2:BufHandle = buffer buf_shift-obj:HANDLE .
     1447       expObj:GetContent(subObj2) no-error.
     1448       if error-status:error then
     1449       do:
     1450         undo _main, return error expObj:Msg .
     1451       end.
     1452       IF not ExpData1:esys-add-dump-data ( INPUT expObj:Data
     1453                                          , INPUT v-esys-cmd-proc-handle
     1454                                          , INPUT v-esys-cmd-code
     1455                                          , '+update' + chr(4) + expObj:InitSecTag +
     1456                                            (if expObj:sendTableName <> ""
     1457                                               then substitute("&1&2&3&4",chr(4),
     1458                                                             expObj:sendTableName,
     1459                                                             if expObj:sendOldRowid <> ? then substitute("&1&2",chr(3),expObj:sendOldRowid) else "",
     1460                                                             if expObj:sendNewRowid <> ? then substitute("&1&2",chr(3),expObj:sendNewRowid) else "")
     1461                                             else "")) THEN
     1462         undo _main, return error v-last-error-message .
     1463       IF not context_set-custom-esys-pck-name(  input v-esys-cmd-proc-handle
     1464                                               , input v-esys-cmd-code
     1465                                               , input v-custom-pack-name) THEN
     1466         undo _main, return error v-last-error-message .
     1467       v-dump-ord-int64 = context_send-esys-command( input v-esys-id-list
     1468                                     , input v-esys-cmd-proc-handle
     1469                                     , input v-esys-cmd-code
     1470                                     , input g#userid).
     1471       if v-dump-ord-int64 = 0 THEN
     1472         undo _main, return error v-last-error-message .
     1473           ExpData1:Route-data_clear-data ( ) .
     1474     end.
     1475     end.
     1476       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute( "Успешно. ")).
     1477     num-rec-ok = num-rec-ok + 1.
     1478   end.
     1479   if v-has-newbh and v-newbh:table = "chk-doc" then do:
     1480       IF not context_begin-esys-command( input string(v-esys-id-list),
     1481                                          input-output v-esys-cmd-proc-handle,
     1482                                          output v-esys-cmd-code) THEN
     1483       undo _main, return error v-last-error-message .
     1484        subObj2 = new check ().
     1485        expObj = new expsubject ().
     1486        subObj2:BufHandle = v-newbh:handle.
     1487        expObj:GetContent(subObj2).
     1488       IF not ExpData1:esys-add-dump-data ( INPUT expObj:Data
     1489                                          , INPUT v-esys-cmd-proc-handle
     1490                                          , INPUT v-esys-cmd-code
     1491                                          , '+update' + chr(4) + expObj:InitSecTag +
     1492                                            (if expObj:sendTableName <> ""
     1493                                               then substitute("&1&2&3&4",chr(4),
     1494                                                             expObj:sendTableName,
     1495                                                             if expObj:sendOldRowid <> ? then substitute("&1&2",chr(3),expObj:sendOldRowid) else "",
     1496                                                             if expObj:sendNewRowid <> ? then substitute("&1&2",chr(3),expObj:sendNewRowid) else "")
     1497                                             else "")) THEN
     1498       undo _main, return error v-last-error-message .
     1499       v-dump-ord-int64 = context_send-esys-command( input v-esys-id-list
     1500                                     , input v-esys-cmd-proc-handle
     1501                                     , input v-esys-cmd-code
     1502                                     , input g#userid).
     1503       if v-dump-ord-int64 = 0 THEN undo _main, return error v-last-error-message .
     1504           ExpData1:Route-data_clear-data ( ) .
     1505           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute( "Успешно. ")).
     1506       num-rec-ok = num-rec-ok + 1.
     1507   end.
     1508   end.
     1509   end procedure.
     1510   procedure load-ruleset-context :
     1511   define input parameter p-ruleset-id as integer    no-undo .
     1512   define variable v-direction         as character  no-undo .
     1513   define variable v-direction-2       as character  no-undo .
     1514   define variable v-is-waiting-status as logical    no-undo .
     1515   define buffer buf_rule-call-param for ub.rule-call-param.
     1516   define buffer buf_ext-system for ub.ext-system.
     1517   do
     1518   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1519   on stop   undo, return error substitute( "&1. stop", vss-workfile )
     1520   on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     1521   :
     1522     assign
     1523       v-oldbh = widget-handle (entry(2, p-doc-code, chr(4)))
     1524       v-newbh = widget-handle (entry(3, p-doc-code, chr(4)))
     1525       v-changes-list = entry(4, p-doc-code, chr(4))
     1526       file-name  = p-process-file-name
     1527       v-has-oldbh = valid-handle(v-oldbh) and v-oldbh:available
     1528       v-has-newbh = valid-handle(v-newbh) and v-newbh:available
     1529     .
     1530     if not v-has-newbh
     1531     and not v-has-oldbh then do:
     1532       undo, return error substitute("Не определено ни одного буфера - ни старый, ни новый").
     1533     end.
     1534     if not v-has-oldbh
     1535     and v-changes-list  = '' then do:
     1536        undo, return error substitute("Не определен старый буфер и список изменений").
     1537     end.
     1538     case p-ruleset-id:
     1539       when 140 then do:
     1540         if v-has-newbh
     1541         and v-newbh:table <> 'shift-obj':U AND v-newbh:table <> "chk-doc" then do:
     1542           undo, return error substitute("Передан неверный буфер [&1] вместо буфера для &2", v-newbh:table, 'shift-obj':U).
     1543         end.
     1544         if v-has-oldbh
     1545         and v-oldbh:table <> 'shift-obj':U and v-oldbh:table <> "tt-shift" AND  v-oldbh:table <> "chk-doc" then do:
     1546           undo, return error substitute("Передан неверный буфер [&1] вместо буфера для &2", v-oldbh:table, 'shift-obj':U).
     1547         end.
     1548       end.
     1549       otherwise do:
     1550         undo, return error substitute("Неверный вызов &1 для набора правил &2", vss-workfile , p-ruleset-id).
     1551       end.
     1552     end case.
     1553     for each buf_rule-call-param no-lock where
     1554     buf_rule-call-param.codex_id = p-codex-id
     1555     and buf_rule-call-param.ruleset_id = p-ruleset-id
     1556     and buf_rule-call-param.call_id = p-call-id
     1557     and buf_rule-call-param.order_id = p-order-id
     1558     and buf_rule-call-param.rule_id = p-rule-id
     1559     and buf_rule-call-param.param-name = "p-esys-id",
     1560       first buf_ext-system no-lock where
     1561             buf_Ext-system.esys-id = buf_rule-call-param.param-value-integer
     1562         and buf_Ext-system.db-num = 0
     1563         and buf_Ext-system.esys-have-export = yes
     1564         and buf_Ext-system.esys-db-num-exp = g#db-num:
     1565       v-esys-id-list = v-esys-id-list + (if v-esys-id-list = '' then '' else chr(1)) + string(buf_ext-system.esys-id).
     1566     end.
     1567     if v-esys-id-list = '' then return "return".
     1568     find first buf_rule-call-param no-lock where
     1569   buf_rule-call-param.codex_id = p-codex-id
     1570   and buf_rule-call-param.ruleset_id = p-ruleset-id
     1571   and buf_rule-call-param.call_id = p-call-id
     1572   and buf_rule-call-param.order_id = p-order-id
     1573   and buf_rule-call-param.rule_id = p-rule-id
     1574   and buf_rule-call-param.param-name = "p-xsd-file"
     1575    no-error.
     1576   if available buf_rule-call-param then do:
     1577     assign p-xsd-file = buf_rule-call-param.param-value-character.
     1578   end.
     1579   end.
     1580   end procedure.
