        1   using Ibs.Th.Rul.Route-data_.
        2   using ibs.th.bge.1crn.export.expsubject from propath.
        3   using ibs.th.bge.1crn.subjects.check from propath.
        4   using ibs.th.bge.1crn.subjects.shift from propath.
        5   block-level on error undo, throw.
        6   define input parameter parparentproc as widget-handle no-undo .
        7   define input parameter p-parent-handle as handle no-undo .
        8   define input parameter p-log-handle  as handle no-undo .
        9   define input parameter p-cont-handle  as handle no-undo .
       10   define input parameter p-codex-id as integer no-undo .
       11   define input parameter p-ruleset-id as integer no-undo .
       12   define input parameter p-call-id as character no-undo .
       13   define input parameter p-order-id as integer no-undo .
       14   define input parameter p-rule-id as integer no-undo .
       15   define input parameter p-profile-id as integer no-undo .
       16   define input parameter p-is-dynamic as logical no-undo .
       17   define input parameter p-doc-type as character no-undo .
       18   define input parameter p-host-code like ub.sysconf.host-code no-undo .
       19   define input parameter p-obj-type like ub.clients.obj-type no-undo .
       20   define input parameter p-obj-code like ub.clients.obj-code no-undo .
       21   define input parameter p-doc-code as character no-undo .
       22   define input parameter p-process-file-name as character no-undo .
       23   define input parameter p-save       as integer no-undo .
       24   define input parameter v-curr-r-b   as character no-undo .
       25   define input parameter p-cmd-proc-handle as handle no-undo .
       26   define input parameter p-cmd-code  as integer no-undo .
       27   define variable vss-revision    as character no-undo init "$Revision: 39d83991554b, 1501, rls $":U .
       28   define variable vss-author      as character no-undo init "$Author: SMMolotkov $":U .
       29   define variable vss-date        as character no-undo init "$Date: Thu Aug 30 10:41:48 2018 +0300 $":U .
       30   define variable vss-workfile    as character no-undo init "$Workfile: 000002103.p $":U .
       31   define variable vss-archive     as character no-undo init "$Archive: rul/000002103.p $":U .
       32   define variable vss-description as character no-undo init "Библиотека процедур для работы с кодексом 18, набор 2".
       33   procedure vss-get-info :
       34     define output parameter p-vss-revision    like vss-revision    no-undo .
       35     define output parameter p-vss-author      like vss-author      no-undo .
       36     define output parameter p-vss-date        like vss-date        no-undo .
       37     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       38     define output parameter p-vss-archive     like vss-archive     no-undo .
       39     define output parameter p-vss-description like vss-description no-undo .
       40     assign
       41       p-vss-revision    = vss-revision
       42       p-vss-author      = vss-author
       43       p-vss-date        = vss-date
       44       p-vss-workfile    = vss-workfile
       45       p-vss-archive     = vss-archive
       46       p-vss-description = vss-description
       47     .
       48   end procedure.
       49   procedure vss-get-parameters :
       50     define output parameter p-vss-parameters as character no-undo .
       51   end procedure.
       52   define new global shared variable g#vssrevis-logger as handle    no-undo .
       53   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       54   define variable v-vssrevis-logger                   as handle    no-undo .
       55   procedure vss-logevent :
       56     define input  parameter p-extra-paramters as character no-undo .
       57     define variable v-vssrevis-parameters as character no-undo .
       58     do
       59     on error undo, return error return-value
       60     :
       61       if  valid-handle(v-vssrevis-logger)
       62       and v-vssrevis-logger :get-signature("logevent") <> ""
       63       then do:
       64         run vss-get-parameters in this-procedure
       65           (output v-vssrevis-parameters
       66           ).
       67         run logevent in v-vssrevis-logger
       68           (input vss-workfile
       69           ,input vss-revision
       70           ,input v-vssrevis-parameters
       71           ,input p-extra-paramters
       72           ).
       73       end.
       74     end.
       75   end procedure.
       76   assign
       77     v-vssrevis-logger = g#vssrevis-logger
       78   .
       79   if  valid-handle(v-vssrevis-logger)
       80   and v-vssrevis-logger :get-signature("logevent") <> ""
       81   then do:
       82     assign
       83       v-vssrevis-logevent = true
       84     .
       85     run vss-logevent in this-procedure (input vss-description) .
       86   end.
       87   define new global shared variable g#language as character no-undo .
       88   if g#language <> '' and g#language <> 'rus':U then do:
       89     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       90   end.
       91   define new global shared variable g#library  as handle no-undo .
       92   define new global shared variable g#library2 as handle no-undo .
       93   define   shared variable g#auto as logical no-undo.
       94   define   shared variable g#news as logical no-undo.
       95   define   shared variable g#oxml as logical no-undo.
       96   define   shared variable g#esys as logical no-undo.
       97   define   shared variable g#news-source-db as integer no-undo.
       98   define   shared variable g#esys-source-esys as integer no-undo.
       99   define   shared variable g#db-num as integer   no-undo .
      100   define   shared variable g#userid as character no-undo .
      101   define   shared variable g#passwd as character no-undo .
      102   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      103   define  variable garbcoll_ii as integer no-undo .
      104   define  temp-table temp-gc no-undo
      105   field ii as integer
      106   field obj-r as handle
      107   field cn as character
      108   index pi is unique primary
      109   ii
      110   index icn
      111   cn.
      112   procedure garbcoll_create-gc-entry :
      113   define input parameter p-cn as character no-undo .
      114   define input parameter p-obj-r as handle no-undo .
      115     do
      116     on error undo, return error
      117     :
      118       create temp-gc.
      119       assign
      120       temp-gc.ii = garbcoll_ii
      121       garbcoll_ii = garbcoll_ii + 1
      122       temp-gc.cn = p-cn
      123       temp-gc.obj-r = p-obj-r
      124       .
      125     end.
      126   end procedure.
      127   procedure garbcoll_clear :
      128     do
      129     on error undo, return error
      130     :
      131       for each temp-gc:
      132         delete object temp-gc.obj-r.
      133         delete temp-gc.
      134       end.
      135     end.
      136   end procedure.
      137   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      138   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      139   define variable tempcxml_v-num_ as integer no-undo .
      140   define  temp-table temp-xml-tables no-undo
      141   field order as integer
      142   field tbl-name as character
      143   field tbl-handle_ as handle
      144   field table-handle_ as handle
      145   field uniq-gate-rec as character
      146   field gate-name as character
      147   field gate-handle_ as handle
      148   field is-parent as logical
      149   index pi is unique primary
      150   uniq-gate-rec
      151   tbl-name
      152   index iorder
      153   order
      154   index gr
      155   uniq-gate-rec
      156   index gh
      157   gate-handle_
      158   index iparent
      159   is-parent
      160   .
      161   define  temp-table temp-xml-records no-undo
      162   field tbl-name as character
      163   field uniq-key-rec as character
      164   index pi is unique primary
      165   tbl-name
      166   uniq-key-rec
      167   .
      168   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      169   procedure gen-key-rec :
      170     define input  parameter p-tbl-name    as character no-undo.
      171     define input  parameter p-bh_tbl-name as handle    no-undo.
      172     define output parameter p-key-rec     as character no-undo.
      173     do
      174     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      175     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      176     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      177     :
      178       define variable fh               as handle    no-undo .
      179       define variable v-ok             as logical   no-undo .
      180       define variable v-inform         as character no-undo .
      181       define variable v-ind            as integer   no-undo .
      182       define variable v-idx-field-qnty as integer   no-undo .
      183       if p-tbl-name = ?
      184         or p-tbl-name = "":U
      185       then do:
      186         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info3 ).
      187       end.
      188       if not p-bh_tbl-name:available then do:
      189         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info3, p-tbl-name ).
      190       end.
      191       assign
      192         p-key-rec = p-tbl-name
      193         v-inform  = p-bh_tbl-name:index-information(1)
      194         v-ind     = 2
      195       .
      196       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      197       on error undo, return error
      198       :
      199         assign
      200           v-inform = p-bh_tbl-name:index-information( v-ind )
      201           v-ind    = v-ind + 1
      202         .
      203       end.
      204       if v-inform = ?
      205         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      206         or entry( 3, v-inform, ",":U ) <> "1":U
      207       then do:
      208         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, p-tbl-name ).
      209       end.
      210       else do:
      211         assign
      212           v-idx-field-qnty = num-entries( v-inform ) - 4
      213         .
      214         if v-idx-field-qnty < 2 then do:
      215           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, p-tbl-name ).
      216         end.
      217         do v-ind = 1 to v-idx-field-qnty by 2
      218         on error undo, return error
      219         :
      220           assign
      221             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      222             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      223           .
      224         end.
      225       end.
      226       if p-key-rec = ? then do:
      227         assign
      228           p-key-rec = "":U
      229         .
      230         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info3, p-tbl-name ).
      231       end.
      232     end.
      233     return.
      234   end procedure.
      235   procedure gen-where-keyr-tab :
      236     define input  parameter i-tableSerach as character no-undo.
      237     define input  parameter i-tablekey   as character  no-undo.
      238     define input  parameter p-key-rec    as character  no-undo.
      239     define input  parameter p-key-handle as handle     no-undo .
      240     define input  parameter p-db-name    as character  no-undo .
      241     define input  parameter p-tt-handle  as handle     no-undo .
      242     define output parameter o-Where      as character  no-undo.
      243     do
      244     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      245     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      246     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      247     :
      248       define variable v-full-tbl-name  as character no-undo .
      249       define variable bh_tbl-name      as handle    no-undo .
      250       define variable fh_key           as handle    no-undo .
      251       define variable fh_search        as handle    no-undo .
      252       define variable v-field-num      as integer   no-undo .
      253       define variable v-count-fld      as integer   no-undo .
      254       define variable v-inform         as character no-undo .
      255       define variable v-ind            as integer   no-undo .
      256       define variable v-idx-field-qnty as integer   no-undo .
      257       define variable v-field-name     as character no-undo .
      258       define variable v-field-val      as character no-undo .
      259       define variable v-word-link      as character no-undo .
      260       define variable vTable           as character no-undo.
      261       define variable bh_tbl-key       as handle    no-undo .
      262       assign
      263         p-key-rec = trim( p-key-rec )
      264       .
      265       if p-key-handle <> ? then do:
      266         if not valid-handle(p-key-handle)
      267            or p-key-handle:type <> "buffer"
      268         then do:
      269           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info3 ).
      270         end.
      271         if num-entries( p-key-rec, chr(3) ) > 1
      272           or p-key-rec = ?
      273           or p-key-rec = "":U
      274         then do:
      275           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info3, p-key-rec ).
      276         end.
      277       end.
      278       else do:
      279         if p-key-rec = ?
      280           or p-key-rec = "":U
      281         then do:
      282           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      283         end.
      284       end.
      285       assign
      286         vTable = entry( 1 , p-key-rec, chr(3) )
      287       .
      288       if p-tt-handle <> ?
      289         and ( not valid-handle(p-tt-handle)
      290               or p-tt-handle:type <> "buffer"
      291             )
      292       then do:
      293         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info3, vTable, chr(10) ).
      294       end.
      295       if p-tt-handle = ? then do:
      296         assign
      297           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      298         .
      299         create buffer bh_tbl-name for table v-full-tbl-name .
      300       end.
      301       else do:
      302         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      303       end.
      304       assign
      305         v-inform = bh_tbl-name:index-information(1)
      306         v-ind    = 2
      307       .
      308       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      309       on error undo, return error
      310       :
      311         assign
      312           v-inform = bh_tbl-name:index-information( v-ind )
      313           v-ind    = v-ind + 1
      314         .
      315       end.
      316       if v-inform = ?
      317         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      318         or entry( 3, v-inform, ",":U ) <> "1":U
      319       then do:
      320         delete object bh_tbl-name no-error.
      321         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info3, vTable ).
      322       end.
      323       assign
      324         v-idx-field-qnty = num-entries( v-inform ) - 4
      325       .
      326       if v-idx-field-qnty < 2 then do:
      327         delete object bh_tbl-name no-error.
      328         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, vTable ).
      329       end.
      330       assign
      331         o-where     = "where":U
      332         v-word-link = "":U
      333         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      334         v-count-fld = 0
      335       .
      336       if i-tablekey ne "" and i-tablekey ne ?
      337       then do:
      338         assign
      339           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      340         .
      341         create buffer bh_tbl-key for table v-full-tbl-name .
      342       end.
      343       if i-tableSerach ne "" and i-tableSerach ne ?
      344       then do:
      345         delete object bh_tbl-name no-error.
      346         assign
      347           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      348         .
      349         create buffer bh_tbl-name for table v-full-tbl-name .
      350       end.
      351       block_where:
      352       do v-ind = 1 to v-idx-field-qnty by 2
      353       on error undo, return error
      354       :
      355         assign
      356           v-count-fld = v-count-fld + 1
      357         .
      358         if p-key-handle = ?
      359           and v-count-fld > v-field-num
      360         then do:
      361           leave block_where.
      362         end.
      363         define variable VfieldKeyTable as handle no-undo.
      364         assign
      365           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      366           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      367         .
      368         if     bh_tbl-key ne ?
      369         then do:
      370            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      371            if VfieldKeyTable eq ?
      372            then next block_where.
      373         end.
      374         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      375         then
      376            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      377         else
      378            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      379         if p-key-handle = ? then do:
      380           assign
      381             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      382           .
      383         end.
      384         else do:
      385           assign
      386             fh_key = p-key-handle:buffer-field( v-field-name )
      387           .
      388           if fh_key = ?
      389             or not valid-handle( fh_key )
      390           then do:
      391             delete object bh_tbl-name.
      392             if     bh_tbl-key ne ?
      393             then
      394                delete object bh_tbl-key.
      395             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info3, p-key-handle:name, v-field-name ).
      396           end.
      397           assign
      398             v-field-val = fh_key:buffer-value
      399           .
      400         end.
      401         if fh_search:data-type ="character":U then do:
      402           assign
      403             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      404             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      405             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      406             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      407             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      408             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      409             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      410             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      411             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      412             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      413             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      414             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      415             v-field-val = substitute( '"&1"', v-field-val )
      416           .
      417         end.
      418         assign
      419           o-where = substitute( "&1 &2", o-where, v-field-val )
      420         .
      421         if v-word-link = "":U then do:
      422           assign
      423             v-word-link = "and":U
      424           .
      425         end.
      426       end.
      427       delete object bh_tbl-name.
      428       if     bh_tbl-key ne ?
      429       then
      430          delete object bh_tbl-key.
      431       if p-key-handle = ?
      432         and v-count-fld <> v-field-num
      433       then do:
      434         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info3, vTable ).
      435       end.
      436     end.
      437   end procedure.
      438   procedure gen-hn-keyr-tab :
      439     define input  parameter i-tableSerach as character no-undo.
      440     define input  parameter i-tablekey   as character no-undo.
      441     define input  parameter p-key-rec    as character no-undo.
      442     define input  parameter p-key-handle as handle    no-undo .
      443     define input  parameter p-db-name    as character no-undo .
      444     define input  parameter p-tt-handle  as handle    no-undo .
      445     define input  parameter p-stts-lock  as integer   no-undo .
      446     define output parameter o-hn         as handle    no-undo.
      447     define variable v-full-tbl-name as character no-undo.
      448     define variable v-where         as character no-undo.
      449     define variable bh_tbl-name     as handle    no-undo.
      450     define variable vTable          as character no-undo.
      451     do
      452     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      453     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      454     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      455         run gen-where-keyr-tab(i-tableSerach,
      456                                i-tablekey,
      457                                p-key-rec,
      458                                p-key-handle,
      459                                p-db-name,
      460                                p-tt-handle,
      461                                output v-where).
      462         if i-tableSerach ne "" and i-tableSerach ne ?
      463         then do:
      464            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      465            create buffer bh_tbl-name for table v-full-tbl-name .
      466         end.
      467         else do:
      468            if p-tt-handle = ? then do:
      469               assign
      470                  vTable = entry( 1 , p-key-rec, chr(3) )
      471               .
      472               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      473               create buffer bh_tbl-name for table v-full-tbl-name .
      474            end.
      475            else do:
      476               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      477            end.
      478         end.
      479         if p-tt-handle = ? then do:
      480            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      481         end.
      482         else do:
      483            bh_tbl-name:find-first( v-where ) no-error .
      484         end.
      485         o-hn = bh_tbl-name.
      486      end.
      487   end procedure.
      488   procedure gen-hn-keyr :
      489     define input  parameter p-key-rec    as character no-undo.
      490     define input  parameter p-key-handle as handle    no-undo .
      491     define input  parameter p-db-name    as character no-undo .
      492     define input  parameter p-tt-handle  as handle    no-undo .
      493     define input  parameter p-stts-lock  as integer   no-undo .
      494     define output parameter o-hn         as handle    no-undo.
      495     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      496   end.
      497   procedure gen-row-keyr :
      498     define input  parameter p-key-rec    as character no-undo.
      499     define input  parameter p-key-handle as handle    no-undo .
      500     define input  parameter p-db-name    as character no-undo .
      501     define input  parameter p-tt-handle  as handle    no-undo .
      502     define input  parameter p-stts-lock  as integer   no-undo .
      503     define output parameter p-tbl-row    as rowid     no-undo.
      504     define output parameter p-tbl-name   as character no-undo.
      505     define variable vHn as handle no-undo.
      506       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      507       p-tbl-row = if vHn:available then vHn:rowid else ?.
      508       p-tbl-name =  vHn:table.
      509       delete object vHn no-error.
      510     if p-tbl-row = ? then do:
      511       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info3, p-tbl-name, p-key-rec ).
      512     end.
      513     else do:
      514       return.
      515     end.
      516   end procedure.
      517   procedure gen-key-fv :
      518     define input  parameter p-key-rec    as character no-undo .
      519     define output parameter p-field-list as character no-undo .
      520     define output parameter p-value-list as character no-undo.
      521     do
      522     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      523     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      524     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      525     :
      526       define variable v-full-tbl-name  as character no-undo .
      527       define variable bh_tbl-name      as handle    no-undo .
      528       define variable v-tbl-name       as character no-undo .
      529       define variable v-field-num      as integer   no-undo .
      530       define variable v-count-fld      as integer   no-undo .
      531       define variable v-inform         as character no-undo .
      532       define variable v-ind            as integer   no-undo .
      533       define variable v-idx-field-qnty as integer   no-undo .
      534       define variable v-delim-key      as character no-undo .
      535       if p-key-rec = ?
      536         or p-key-rec = "":U
      537       then do:
      538         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      539       end.
      540       assign
      541         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      542         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      543       .
      544       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      545       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info3 ).
      546       assign
      547         v-inform = bh_tbl-name:index-information(1)
      548         v-ind    = 2
      549       .
      550       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      551       on error undo, return error
      552       :
      553         assign
      554           v-inform = bh_tbl-name:index-information( v-ind )
      555           v-ind    = v-ind + 1
      556         .
      557       end.
      558       if v-inform = ?
      559         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      560         or entry( 3, v-inform, ",":U ) <> "1":U
      561       then do:
      562         delete object bh_tbl-name no-error.
      563         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
      564       end.
      565       assign
      566         v-idx-field-qnty = num-entries( v-inform ) - 4
      567       .
      568       if v-idx-field-qnty < 2 then do:
      569         delete object bh_tbl-name no-error.
      570         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
      571       end.
      572       assign
      573         p-field-list = "":U
      574         p-value-list = "":U
      575         v-delim-key  = "":U
      576         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      577         v-count-fld  = 0
      578       .
      579       block_where:
      580       do v-ind = 1 to v-idx-field-qnty by 2
      581       on error undo, return error
      582       :
      583         assign
      584           v-count-fld = v-count-fld + 1
      585         .
      586         if v-count-fld > v-field-num then do:
      587           leave block_where.
      588         end.
      589         assign
      590           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      591           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      592         .
      593         if v-ind = 1 then do:
      594           assign
      595             v-delim-key = chr(3)
      596           .
      597         end.
      598       end.
      599       delete object bh_tbl-name.
      600       if v-count-fld <> v-field-num then do:
      601         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info3, v-tbl-name ).
      602       end.
      603     end.
      604   end procedure.
      605   procedure gen-key-field :
      606     define input  parameter p-table      as character no-undo .
      607     define output parameter p-field-list as character no-undo .
      608     do
      609     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      610     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      611     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      612     :
      613       define variable v-full-tbl-name  as character no-undo .
      614       define variable bh_tbl-name      as handle    no-undo .
      615       define variable v-tbl-name       as character no-undo .
      616       define variable v-field-num      as integer   no-undo .
      617       define variable v-count-fld      as integer   no-undo .
      618       define variable v-inform         as character no-undo .
      619       define variable v-ind            as integer   no-undo .
      620       define variable v-idx-field-qnty as integer   no-undo .
      621       define variable v-delim-key      as character no-undo .
      622       if p-table = ?
      623         or p-table = "":U
      624       then do:
      625         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info3 ).
      626       end.
      627       assign
      628         v-tbl-name      = p-table
      629         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      630       .
      631       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      632       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info3 ).
      633       assign
      634         v-inform = bh_tbl-name:index-information(1)
      635         v-ind    = 2
      636       .
      637       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      638       on error undo, return error
      639       :
      640         assign
      641           v-inform = bh_tbl-name:index-information( v-ind )
      642           v-ind    = v-ind + 1
      643         .
      644       end.
      645       if v-inform = ?
      646         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      647         or entry( 3, v-inform, ",":U ) <> "1":U
      648       then do:
      649         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
      650       end.
      651       assign
      652         v-idx-field-qnty = num-entries( v-inform ) - 4
      653       .
      654       if v-idx-field-qnty < 2 then do:
      655         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
      656       end.
      657       assign
      658         p-field-list = "":U
      659         v-delim-key  = "":U
      660         v-count-fld  = 0
      661       .
      662       block_where:
      663       do v-ind = 1 to v-idx-field-qnty by 2
      664       on error undo, return error
      665       :
      666         assign
      667           v-count-fld = v-count-fld + 1
      668         .
      669         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      670         if v-ind = 1 then do:
      671           assign
      672             v-delim-key = chr(3)
      673           .
      674         end.
      675       end.
      676       delete object bh_tbl-name.
      677     end.
      678   end procedure.
      679   procedure get-gate-file-name :
      680   define input parameter p-gate-rec as character no-undo .
      681   define output  parameter p-gate-file-name as character no-undo .
      682   define buffer buf_clob-data for ub.clob-data.
      683   define variable v-tbl-row as rowid no-undo .
      684   define variable v-tbl-name as character no-undo .
      685   run gen-row-keyr in this-procedure ( input p-gate-rec
      686                                       ,input ?
      687                                       ,input "ub"
      688                                       ,input ?
      689                                       ,input no-lock
      690                                       ,output v-tbl-row
      691                                       ,output v-tbl-name) no-error.
      692   if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
      693                                                           ,vss-include-info1
      694                                                           ,p-gate-rec).
      695   find first buf_clob-data no-lock where
      696             rowid(buf_clob-data) = v-tbl-row no-error.
      697   if not available buf_clob-data then do:
      698     if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
      699                                                             ,vss-include-info1
      700                                                             ,p-gate-rec).
      701   end.
      702   p-gate-file-name = buf_clob-data.file-name.
      703   end procedure.
      704   procedure get-gate-rec :
      705   define input  parameter p-gate-name as character no-undo .
      706   define output parameter p-gate-rec as character no-undo .
      707   define buffer buf_clob-bind for ub.clob-bind.
      708   define buffer buf_clob-data for ub.clob-data.
      709   main-block:
      710   do
      711   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info1, return-value, chr(10), error-status :get-message (1))
      712   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info1 )
      713   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info1 )
      714   :
      715       find first buf_clob-bind no-lock where
      716                 buf_clob-bind.uniq-key-rec = p-gate-name
      717             and buf_clob-bind.field-name = '':U
      718             and buf_clob-bind.part-num = 1
      719             and buf_clob-bind.resource-type = 'gate':U
      720             no-error.
      721       if not available buf_clob-bind then do:
      722         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
      723                                         , p-gate-name
      724                                         ).
      725       end.
      726       find first buf_clob-data no-lock where
      727                 buf_clob-data.db-num = buf_clob-bind.db-num
      728             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
      729       if not available buf_clob-data then do:
      730         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
      731                                         , buf_clob-bind.db-num
      732                                         , buf_clob-bind.int64-id
      733                                         , p-gate-name
      734                                         ).
      735       end.
      736       run gen-key-rec in this-procedure ( input 'clob-data':U
      737                                 ,input buffer buf_clob-data:handle
      738                                 ,output p-gate-rec).
      739   end.
      740   end procedure.
      741   procedure get-gate-by-name :
      742   define input  parameter p-gate-name as character no-undo .
      743   define output parameter p-gate-rec as character no-undo .
      744   define output parameter p-dsh as handle no-undo .
      745   define input-output  parameter p-xmlh as handle no-undo .
      746   define variable v-ii as integer   no-undo .
      747   define variable glog as logical   no-undo .
      748   define variable v-longchar as longchar no-undo .
      749   define variable v-txmlh as handle no-undo .
      750   define variable v-db-num as integer no-undo .
      751   define variable v-int64-id as int64 no-undo .
      752   define buffer buf_clob-bind for ub.clob-bind.
      753   define buffer buf_clob-data for ub.clob-data.
      754   main-block:
      755   do
      756   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info1, return-value, chr(10), error-status :get-message (1))
      757   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info1 )
      758   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info1 )
      759   :
      760       find first buf_clob-bind no-lock where
      761                 buf_clob-bind.uniq-key-rec = p-gate-name
      762             and buf_clob-bind.field-name = '':U
      763             and buf_clob-bind.part-num = 1
      764             and buf_clob-bind.resource-type = 'gate':U
      765             no-error.
      766       if not available buf_clob-bind then do:
      767         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
      768                                         , p-gate-name
      769                                         ).
      770       end.
      771       find first buf_clob-data no-lock where
      772                 buf_clob-data.db-num = buf_clob-bind.db-num
      773             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
      774       if not available buf_clob-data then do:
      775         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
      776                                         , buf_clob-bind.db-num
      777                                         , buf_clob-bind.int64-id
      778                                         , p-gate-name
      779                                         ).
      780       end.
      781       assign
      782       v-longchar = buf_clob-data.cdata
      783       .
      784       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
      785       if error-status :error then do:
      786         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
      787       end.
      788       create dataset p-dsh .
      789       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
      790                                     , v-longchar
      791                                     , ?
      792                                     , ?
      793                                     , ?
      794                                     ) no-error.
      795       v-longchar = '':U.
      796       if error-status :error
      797       or not glog
      798       then do:
      799         undo, return error substitute("Не удалось прочитать XML-схему &1 из БД:&2&3", p-gate-name, chr(10), error-status:get-message(1) ).
      800       end.
      801       if not valid-handle(p-xmlh)
      802       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
      803         create temp-table v-txmlh.
      804         v-txmlh:create-like(buffer temp-xml-tables:handle).
      805         v-txmlh:temp-table-prepare("temp-xml-tables").
      806         p-xmlh = v-txmlh:default-buffer-handle.
      807       end.
      808       run gen-key-rec in this-procedure ( input 'clob-data':U
      809                                 ,input buffer buf_clob-data:handle
      810                                 ,output p-gate-rec).
      811       do v-ii = 1 to p-dsh:num-buffers:
      812         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
      813         if not p-xmlh:available then do:
      814           p-xmlh:buffer-create().
      815           assign
      816           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
      817           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
      818           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
      819           p-xmlh::gate-handle_ = p-dsh
      820           p-xmlh::uniq-gate-rec = p-gate-rec
      821           p-xmlh::gate-name = p-dsh:name
      822           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
      823           .
      824           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
      825             assign
      826             p-xmlh::order = -3.
      827           end.
      828         end.
      829       end.
      830   end.
      831   end procedure.
      832   procedure get-gate-by-rec :
      833   define input  parameter p-gate-rec as character no-undo .
      834   define output parameter p-dsh as handle no-undo .
      835   define input-output  parameter p-xmlh as handle no-undo .
      836   define input-output parameter p-longchar  as longchar no-undo .
      837   define variable v-ii as integer   no-undo .
      838   define variable glog as logical   no-undo .
      839   define variable v-rowid as rowid no-undo .
      840   define variable v-tbl-name as character no-undo .
      841   define variable v-longchar as longchar no-undo .
      842   define variable v-txmlh as handle no-undo .
      843   define buffer buf_clob-data for ub.clob-data.
      844   main-block:
      845   do
      846   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info1, return-value, chr(10), error-status :get-message (1))
      847   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info1 )
      848   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info1 )
      849   :
      850     run gen-row-keyr in this-procedure (
      851                                           input  p-gate-rec
      852                                           ,input  ?
      853                                           ,input  "ub"
      854                                           ,input  ?
      855                                           ,input  NO-LOCK
      856                                           ,output v-rowid
      857                                           ,output v-tbl-name   ) no-error.
      858       find first buf_clob-data no-lock where
      859                 rowid(buf_clob-data) = v-rowid  no-error.
      860       if not available buf_clob-data then do:
      861         undo, return error substitute("Не найден CLOB  &1"
      862                                         , p-gate-rec
      863                                         ).
      864       end.
      865       assign
      866       v-longchar = buf_clob-data.cdata
      867       .
      868       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
      869       if error-status :error then do:
      870         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
      871       end.
      872       create dataset p-dsh .
      873       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
      874                                     , v-longchar
      875                                     , ?
      876                                     , ?
      877                                     , ?
      878                                     ) no-error.
      879       define variable v-esm as character no-undo .
      880       v-esm = error-status:get-message(1) .
      881       if p-longchar <> ? then do:
      882         p-longchar = v-longchar.
      883       end.
      884       v-longchar = '':U.
      885       if error-status :error
      886       or not glog
      887       then do:
      888         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
      889                                      , p-gate-rec
      890                                      , p-gate-rec
      891                                      , v-esm
      892                                      ).
      893       end.
      894       p-dsh:private-data = buf_clob-data.file-name_ + chr(4) + p-gate-rec.
      895       if not valid-handle(p-xmlh)
      896       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
      897         create temp-table v-txmlh.
      898         v-txmlh:create-like(buffer temp-xml-tables:handle).
      899         v-txmlh:temp-table-prepare("temp-xml-tables").
      900         p-xmlh = v-txmlh:default-buffer-handle.
      901       end.
      902       do v-ii = 1 to p-dsh:num-buffers:
      903         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
      904         if not p-xmlh:available then do:
      905           p-xmlh:buffer-create().
      906           assign
      907           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
      908           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
      909           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
      910           p-xmlh::gate-handle_ = p-dsh
      911           p-xmlh::uniq-gate-rec = p-gate-rec
      912           p-xmlh::gate-name = p-dsh:name
      913           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
      914           .
      915           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
      916             assign
      917             p-xmlh::order = -3.
      918           end.
      919           p-xmlh:buffer-release().
      920         end.
      921       end.
      922   end.
      923   end procedure.
      924   procedure get-gate-by-file :
      925   define input  parameter p-schema-file-name as character no-undo .
      926   define input  parameter p-gate-rec as character no-undo .
      927   define output parameter p-dsh as handle no-undo .
      928   define input-output  parameter p-xmlh as handle no-undo .
      929   define variable v-ii as integer   no-undo .
      930   define variable glog as logical   no-undo .
      931   define variable v-rowid as rowid no-undo .
      932   define variable v-tbl-name as character no-undo .
      933   define variable v-longchar as longchar no-undo .
      934   define variable v-txmlh as handle no-undo .
      935   main-block:
      936   do
      937   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info1, return-value, chr(10), error-status :get-message (1))
      938   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info1 )
      939   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info1 )
      940   :
      941       COPY-LOB
      942       FROM  FILE p-schema-file-name
      943       TO  OBJECT v-longchar
      944       no-convert
      945       NO-ERROR .
      946       if error-status :error then do:
      947           undo, return error substitute("Не удалось считать файл схемы &1 в память&2&3"
      948                                     , p-schema-file-name
      949                                 , chr(10)
      950                                 , error-status:get-message(1) ).
      951       end.
      952       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
      953       if error-status :error then do:
      954         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, p-schema-file-name, chr(10), error-status:get-message(1) , return-value ).
      955       end.
      956       create dataset p-dsh .
      957       glog = p-dsh:READ-XMLSCHEMA( "longchar"
      958                                     , v-longchar
      959                                     , ?
      960                                     , ?
      961                                     , ?
      962                                     ) no-error.
      963       v-longchar = ''.
      964       if error-status :error
      965       or not glog
      966       then do:
      967         undo, return error substitute("Не удалось прочитать XML-схему из файла &1&2&3"
      968                                      , p-schema-file-name
      969                                      ,chr(10)
      970                                      , error-status:get-message(1)
      971                                      ).
      972       end.
      973       if not valid-handle(p-xmlh)
      974       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
      975         create temp-table v-txmlh.
      976         v-txmlh:create-like(buffer temp-xml-tables:handle).
      977         v-txmlh:temp-table-prepare("temp-xml-tables").
      978         p-xmlh = v-txmlh:default-buffer-handle.
      979       end.
      980       do v-ii = 1 to p-dsh:num-buffers:
      981         p-xmlh:find-first(substitute(' where tbl-name = "&1" and  uniq-gate-rec = "&2" '
      982                                      ,p-dsh:get-buffer-handle(v-ii):name
      983                                      ,p-gate-rec
      984                                      )) no-error.
      985         if not p-xmlh:available then do:
      986           p-xmlh:buffer-create().
      987           assign
      988           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):table
      989           p-xmlh::uniq-gate-rec = p-gate-rec
      990           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
      991           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
      992           p-xmlh::gate-handle_ = p-dsh
      993           p-xmlh::gate-name = p-dsh:name
      994           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
      995           .
      996           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
      997             assign
      998             p-xmlh::order = -3.
      999           end.
     1000           p-xmlh:buffer-release().
     1001         end.
     1002       end.
     1003   end.
     1004   end procedure.
     1005   procedure gate-clear :
     1006   define input  parameter p-dsh as handle no-undo .
     1007   define input  parameter p-xmlh as handle no-undo .
     1008   define variable v-dsh as handle no-undo .
     1009   define variable v-th as handle no-undo .
     1010     do
     1011     on error undo, return error return-value
     1012     :
     1013       if valid-handle(p-dsh) then do:
     1014         delete object p-dsh.
     1015         v-dsh = p-dsh.
     1016         p-dsh = ?.
     1017       end.
     1018       repeat while true:
     1019         p-xmlh:find-first( substitute( " where gate-handle_ = &1 ", v-dsh)
     1020                            , share-lock) no-error.
     1021         if p-xmlh:available then do:
     1022           assign
     1023           v-th = p-xmlh:buffer-field("table-handle_"):buffer-value.
     1024           if valid-handle(p-xmlh:buffer-field("table-handle_"))
     1025           and valid-handle(v-th)
     1026           and v-th:dynamic = yes
     1027           then do:
     1028             delete object p-xmlh:buffer-field("table-handle_"):buffer-value.
     1029             p-xmlh:buffer-field("table-handle_"):buffer-value = ?.
     1030           end.
     1031           p-xmlh:buffer-delete().
     1032         end.
     1033         else do:
     1034           leave.
     1035         end.
     1036       end.
     1037       if p-xmlh:dynamic = yes
     1038       and valid-handle(p-xmlh)
     1039       then do:
     1040         delete object p-xmlh:table-handle.
     1041         p-xmlh = ?.
     1042       end.
     1043       v-dsh = ?.
     1044     end.
     1045   end procedure.
     1046   procedure all-gates-clear :
     1047   define parameter buffer buf_temp-xml-tables for temp-xml-tables.
     1048   do
     1049   on error undo, return error
     1050   :
     1051     for each buf_temp-xml-tables
     1052     break
     1053     by buf_temp-xml-tables.uniq-gate-rec
     1054     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1055     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1056     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1057     :
     1058         if first-of(buf_temp-xml-tables.uniq-gate-rec) then do:
     1059           delete object buf_temp-xml-tables.gate-handle_.
     1060           buf_temp-xml-tables.gate-handle_ = ?.
     1061         end.
     1062         if valid-handle(buf_temp-xml-tables.table-handle_)
     1063         and buf_temp-xml-tables.table-handle_:dynamic = no
     1064         then do:
     1065           delete object buf_temp-xml-tables.table-handle_.
     1066           buf_temp-xml-tables.table-handle_ = ?.
     1067         end.
     1068         delete buf_temp-xml-tables.
     1069     end.
     1070   end.
     1071   end procedure.
     1072   procedure fix-schemalocation :
     1073   define input-output  parameter p-longchar as longchar no-undo .
     1074   DEFINE VARIABLE hdoc AS HANDLE.
     1075   DEFINE VARIABLE hroot AS HANDLE.
     1076   DEFINE VARIABLE hnode-child AS HANDLE.
     1077   DEFINE VARIABLE hnode-attr AS HANDLE.
     1078   define variable v-jj as integer   no-undo .
     1079   define variable ok as logical   no-undo .
     1080   define variable v-path1                    as character                no-undo .
     1081   DEFINE VARIABLE v-full-path1               as character                no-undo .
     1082   DEFINE VARIABLE v-file-name1               as character                no-undo .
     1083   DEFINE VARIABLE v-file-name-no-ext1        as character                no-undo .
     1084   DEFINE VARIABLE v-file-name-ext1           as character                no-undo .
     1085   define variable v-schema-location          as character                no-undo .
     1086   do
     1087   on error undo, return error return-value
     1088   :
     1089     CREATE X-DOCUMENT hdoc.
     1090     CREATE X-noderef hroot.
     1091     CREATE X-noderef hnode-child.
     1092     CREATE X-noderef hnode-attr.
     1093     hdoc:load("longchar", p-longchar, no) no-error.
     1094     iF ERROR-STATUS:GET-MESSAGE(1) <> '' THEN message ERROR-STATUS:GET-MESSAGE(1) view-as alert-box .
     1095     hdoc:get-document-element(hroot).
     1096     _repeat:
     1097     REPEAT v-jj = 1 TO hroot:NUM-CHILDREN:
     1098       ok = hroot:GET-CHILD(hNode-Child, v-jj).
     1099       if not ok then next.
     1100       if hNode-Child:local-name = "include"
     1101       then do:
     1102         ok = hNode-Child:GET-ATTRIBUTE-NODE( hnode-attr, "schemaLocation" ).
     1103           v-schema-location = hnode-attr:node-value.
     1104           run gbl/filename.p (
     1105                           input "exe/" + hnode-attr:node-value
     1106                         ,output v-full-path1
     1107                         ,output v-path1
     1108                         ,output v-file-name1
     1109                         ,output v-file-name-no-ext1
     1110                         ,output v-file-name-ext1
     1111                         ) no-error .
     1112           if error-status :error then do:
     1113             delete object hnode-attr.
     1114             delete object hnode-child.
     1115             delete object hroot.
     1116             delete object hdoc.
     1117             undo, return error substitute("Не удалось определить расположение схемы &1", v-schema-location).
     1118           end.
     1119         ok = hNode-Child:sET-ATTRIBUTE(  "schemaLocation", v-full-path1 ).
     1120         leave  _repeat.
     1121       end.
     1122     END.
     1123     hdoc:save("longchar", p-longchar).
     1124     delete object hnode-attr.
     1125     delete object hnode-child.
     1126     delete object hroot.
     1127     delete object hdoc.
     1128   end.
     1129   end procedure.
     1130   procedure gate-clb_fill-xml-tables :
     1131   define input parameter p-dsh as handle no-undo .
     1132   define input-output parameter p-xmlh as handle no-undo .
     1133   define variable v-ii as integer no-undo .
     1134     do
     1135     on error undo, return error
     1136     :
     1137       do v-ii = 1 to p-dsh:num-buffers:
     1138         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1139         if not p-xmlh:available then do:
     1140           p-xmlh:buffer-create().
     1141           assign
     1142           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1143           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1144           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1145           p-xmlh::gate-handle_ = p-dsh
     1146           p-xmlh::uniq-gate-rec = entry(2, p-dsh:private-data, chr(4))
     1147           p-xmlh::gate-name = p-dsh:name
     1148           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1149           .
     1150           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1151             assign
     1152             p-xmlh::order = -3.
     1153           end.
     1154           p-xmlh:buffer-release().
     1155         end.
     1156       end.
     1157     end.
     1158   end procedure.
     1159   procedure all-gates-empty :
     1160   define buffer buf_temp-xml-tables for temp-xml-tables.
     1161   do
     1162   on error undo, return error
     1163   :
     1164     for each buf_temp-xml-tables
     1165     break
     1166     by buf_temp-xml-tables.uniq-gate-rec
     1167     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1168     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1169     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1170     :
     1171       if valid-handle(buf_temp-xml-tables.tbl-handle_) then do:
     1172         buf_temp-xml-tables.tbl-handle_:empty-temp-table().
     1173       end.
     1174     end.
     1175   end.
     1176   end procedure.
