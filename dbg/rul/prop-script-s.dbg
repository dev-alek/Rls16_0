     3356     (input filter-point
     3357     ,output flt-rec-26
     3358     ,output filter-name-26
     3359     ,output where-phrase-26
     3360     ,output sort-phrase-26
     3361     ,output where-phrase-rus-26
     3362     ,output sort-phrase-rus-26
     3363     ).
     3364   if p-open-query then do:
     3365       run set-filter-name in this-procedure
     3366         (INPUT filter-name-26
     3367         ) no-error .
     3368     assign
     3369       l-filter-open-26 = false
     3370     .
     3371     if flt-rec-26 <> ?
     3372       or sort-column-phrase > ""
     3373     then do:
     3374       define variable  parameter-2-26 as character no-undo .
     3375       define variable  parameter-3-26 as character no-undo .
     3376       define variable  parameter-4-26 as character no-undo .
     3377       define variable  parameter-5-26 as character no-undo .
     3378       define variable  parameter-6-26 as character no-undo .
     3379       define variable  parameter-7-26 as character no-undo .
     3380         assign
     3381         parameter-3-26 =
     3382                                 "FOR EACH X_prop-script"
     3383         parameter-4-26 =
     3384           (
     3385             if (" X_prop-script.dtm-code = p-dtm-code                               and X_prop-script.script-name contains p-word-script-name " + " " + where-phrase-26) <> ""
     3386             then  substitute('X_prop-script.dtm-code = &1                               and X_prop-script.script-name contains &2&3&2 ', p-dtm-code, chr(34), p-word-script-name) + " " + where-phrase-26
     3387             else "true"
     3388           )
     3389         parameter-5-26 = (" " + "" + " " + "")
     3390         parameter-6-26 = if sort-phrase-26 = ''
     3391                              then
     3392           (
     3393           " " + "  " +
     3394             " " + sort-column-phrase +
     3395           " " + "  "
     3396           )
     3397                              else
     3398           (
     3399           " " + "  " +
     3400             " " + sort-column-phrase +
     3401           " " + sort-phrase-26
     3402           )
     3403         parameter-7-26 =
     3404           " indexed-reposition  "
     3405       .
     3406       do
     3407       on stop undo, leave
     3408       on error undo, leave
     3409       :
     3410         assign
     3411           l-disable-where-26 =
     3412             (" X_prop-script.dtm-code = p-dtm-code                               and X_prop-script.script-name contains p-word-script-name " + " " + where-phrase-26 = "")
     3413         .
     3414         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3415                             ,input QUERY br-prop-script:handle
     3416                             ,input parameter-3-26
     3417                             ,input parameter-4-26
     3418                             ,input parameter-5-26
     3419                             ,input parameter-6-26
     3420                             ,input parameter-7-26
     3421                             )
     3422         .
     3423         assign
     3424           l-filter-open-26 = true
     3425         .
     3426       end.
     3427       if l-filter-open-26 = false then do:
     3428         message
     3429           "Ошибка при фильтрации / сортировке" skip
     3430           "Будут показаны записи без учета фильтра" skip
     3431           view-as alert-box .
     3432       end.
     3433       else do:
     3434           assign
     3435             l-query-was-opened = true
     3436           .
     3437       end.
     3438     end.
     3439     if l-filter-open-26 = false then do:
     3440       OPEN QUERY br-prop-script FOR EACH X_prop-script
     3441         where  X_prop-script.dtm-code = p-dtm-code                               and X_prop-script.script-name contains p-word-script-name
     3442         indexed-reposition
     3443     .
     3444         assign
     3445           l-query-was-opened = true
     3446         .
     3447     end.
     3448   end.
     3449   else do:
     3450     assign
     3451       v-doc-rec = recid( X_prop-script )
     3452     .
     3453     do
     3454     on stop undo, leave
     3455     on error undo, leave
     3456     :
     3457       if QUERY br-prop-script:handle:get-buffer-handle(1) = (buffer X_prop-script:handle) then do:
     3458         assign
     3459         parameter-2-26 = (if p-find-next then "true":u else "false":u )
     3460         parameter-4-26 =
     3461           "where ":u +  substitute('X_prop-script.dtm-code = &1                               and X_prop-script.script-name contains &2&3&2 ', p-dtm-code, chr(34), p-word-script-name) + " ":u + where-phrase-26 + " ":u + p-find-condition + " " + ""
     3462         parameter-5-26 = "  "
     3463       .
     3464         run fltopend_fltfindd in this-procedure  (
     3465                             input this-procedure:handle
     3466                             ,input QUERY br-prop-script:handle
     3467                             ,input rowid(X_prop-script)
     3468                             ,input logical(parameter-2-26)
     3469                             ,input no-lock
     3470                             ,input (buffer X_prop-script:handle)
     3471                             ,input parameter-4-26
     3472                             ,input parameter-5-26
     3473                             ) no-error.
     3474         .
     3475         assign
     3476           v-doc-rec = integer(return-value)
     3477           v-fltopend-rowid[1] = ?
     3478         .
     3479       end.
     3480       else do:
     3481         assign
     3482         parameter-2-26 = (if p-find-next then "true":u else "false":u )
     3483         parameter-3-26 =  "FOR EACH X_prop-script"
     3484         parameter-4-26 =
     3485           (
     3486             if (" X_prop-script.dtm-code = p-dtm-code                               and X_prop-script.script-name contains p-word-script-name " + " " + where-phrase-26) <> ""
     3487             then  substitute('X_prop-script.dtm-code = &1                               and X_prop-script.script-name contains &2&3&2 ', p-dtm-code, chr(34), p-word-script-name) + " " + where-phrase-26
     3488             else "true"
     3489           )
     3490         parameter-5-26 = (" " + "" + " " + "" + " " + p-find-condition)
     3491         parameter-6-26 = if sort-phrase-26 = ''
     3492                              then
     3493           (
     3494           " " + "  " +
     3495             " " + sort-column-phrase +
     3496           " " + "  "
     3497           )
     3498                              else
     3499           (
     3500           " " + "  " +
     3501             " " + sort-column-phrase +
     3502           " " + sort-phrase-26
     3503           )
     3504         parameter-7-26 =
     3505           " indexed-reposition  "
     3506       .
     3507         run fltopend_fltfindq in this-procedure  (
     3508                             input this-procedure:handle
     3509                             ,input QUERY br-prop-script:handle
     3510                             ,input logical(parameter-2-26)
     3511                             ,input no-lock
     3512                             ,input parameter-3-26
     3513                             ,input parameter-4-26
     3514                             ,input parameter-5-26
     3515                             ,input parameter-6-26
     3516                             ,input parameter-7-26
     3517                             ,output v-fltopend-rowid
     3518                             ) no-error.
     3519         .
     3520         v-doc-rec = ?.
     3521       end.
     3522       assign
     3523         l-query-was-opened = true
     3524       .
     3525     end.
     3526   end.
     3527     run waitfram-hide in this-procedure .
     3528         END.
     3529     END.
     3530   END CASE.
     3531   if not p-open-query
     3532   and v-doc-rec <> ? then
     3533   REPOSITION br-prop-script to recid v-doc-rec No-ERROR.
     3534   if not p-open-query and v-fltopend-rowid[1] <> ? then
     3535   query br-prop-script:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
     3536   run waitfram-hide in this-procedure.
     3537   APPLY "VALUE-CHANGED" TO br-prop-script in frame Dialog-Frame.
     3538   APPLY "ENTRY" TO br-prop-script.
     3539   END PROCEDURE.
     3540   PROCEDURE proc-b-link :
     3541   DEFINE INPUT PARAMETER p-option AS CHARACTER no-undo.
     3542   DEFINE VARIABLE V-RID-LIST AS CHARACTER NO-UNDO.
     3543   DEFINE BUFFER buf_ruledict FOR ub.ruledict.
     3544   DEFINE BUFFER buf_ruledict-param FOR ub.ruledict-param.
     3545   CASE p-option:
     3546       WHEN 'rule-i-script':U THEN DO:
     3547         run rul/rule-i-script-s.w ( input parparentproc
     3548                                ,INPUT "":U
     3549                                ,input "SCRIPT-NAME"
     3550                                ,input 0
     3551                                ,INPUT x_PROP-SCRIPT.SCRIPT-TYPE
     3552                                ,INPUT x_PROP-SCRIPT.SCRIPT-NAME
     3553                                ,input-output v-RID-LIST) no-error.
     3554       END.
     3555       WHEN 'pscript-ruleset':U THEN DO:
     3556       run rul/pscript-ruleset-s.w ( input parparentproc
     3557                                ,INPUT (IF LOOKUP("B-ADD", BTTNS) > 0
     3558                                        AND P-LIST-MODE = "DTM-CODE"
     3559                                        THEN "b-add":U
     3560                                        ELSE '':u)
     3561                                ,input "script-name"
     3562                                ,input 0
     3563                                ,input 0
     3564                                ,INPUT X_prop-script.dtm-code
     3565                                ,INPUT X_prop-script.language
     3566                                ,INPUT X_prop-script.script-name
     3567                                ,input-output v-RID-LIST) no-error.
     3568       END.
     3569       WHEN 'ruledict-param':U THEN DO:
     3570         FIND FIRST buf_ruledict no-lock WHERE
     3571                   buf_ruledict.entry-type = 'prop-script':U
     3572              AND  buf_ruledict.uniq-key-rec = X_prop-script.uniq-key-rec NO-ERROR.
     3573         IF NOT AVAILABLE buf_ruledict  THEN DO:
     3574           MESSAGE
     3575           "Еще отсутствует в словаре"
     3576           VIEW-AS ALERT-BOX.
     3577           RETURN error.
     3578         END.
     3579         find first buf_ruledict-param no-lock where
     3580                   buf_ruledict-param.entry-id = buf_ruledict.entry-id no-error.
     3581         if not available buf_ruledict-param then do:
     3582           message
     3583           "Нет параметров!"
     3584           view-as alert-box error .
     3585           undo, return no-apply .
     3586         end.
     3587         run rul/ruledict-param-s.w ( INPUT parparentproc
     3588                                      ,input ?
     3589                                      ,INPUT (IF LOOKUP("B-ADD", BTTNS) > 0
     3590                                              AND P-LIST-MODE = "DTM-CODE"
     3591                                              THEN "b-add":U
     3592                                              ELSE '':u)
     3593                                      ,INPUT "entry-id"
     3594                                      ,INPUT buf_ruledict.entry-id
     3595                                      ,input 'prop-script':U
     3596                                      ,INPUT-OUTPUT v-rid-list) NO-ERROR.
     3597     END.
     3598   END CASE.
     3599   END PROCEDURE.
     3600   PROCEDURE proc-b-sch :
     3601   assign
     3602     tbl = 'prop-script'
     3603     join-tbl = 'X_prop-script'
     3604     fld = ""
     3605     lab = ""
     3606     spr = ""
     3607     dim = '0'
     3608     .
     3609   run fltfield-add in this-procedure('dtm-code', 'Код объекта-операнда', '',
     3610   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3611   run fltfield-add in this-procedure('class-dtm-code', 'Код объекта-операнда обслуживающего класса', '',
     3612   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3613   run fltfield-add in this-procedure('script-name', 'Название', '',
     3614   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3615   run fltfield-add in this-procedure('documentation', 'Описание', '',
     3616   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3617   run fltfield-add in this-procedure('signature', 'Сигнатура', '',
     3618   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3619   run fltfield-add in this-procedure('proc-type', 'Тип процелуры', '',
     3620   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3621   run fltfield-add in this-procedure('script-type', 'Тип скрипта', '',
     3622   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3623   Filter-Block:
     3624   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     3625       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     3626       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     3627     run gbl/filter.w ( INPUT parparentproc
     3628                      , INPUT filter-point + chr(4) + filter-point-label
     3629                      , INPUT tbl
     3630                      , INPUT join-tbl
     3631                      , INPUT fld
     3632                      , INPUT lab
     3633                      , INPUT spr
     3634                      , INPUT dim ).
     3635     RUN OpenBr IN THIS-PROCEDURE (INPUT yes
     3636                                  ,INPUT no
     3637                                  ,INPUT '':U).
     3638   end.
     3639   END PROCEDURE.
     3640   PROCEDURE proc-find-script-name :
     3641   define input parameter p-next as logical no-undo.
     3642   define input parameter p-script-name AS CHARACTER no-undo.
     3643   define input parameter p-find-option AS CHARACTER no-undo.
     3644   define variable old-word-script-name as character no-undo .
     3645   define variable v-w-script-name as character no-undo .
     3646   assign
     3647   frame Dialog-Frame f-script-name.
     3648   assign
     3649   p-script-name = replace(p-script-name, chr(34), "":U)
     3650   p-script-name = replace(p-script-name, chr(39), chr(39) + chr(39))
     3651   v-w-script-name = p-script-name
     3652   p-script-name = chr(34) + p-script-name + chr(34).
     3653   CASE p-find-option:
     3654     WHEN "begins" THEN DO:
     3655       old-word-script-name = p-word-script-name.
     3656       p-word-script-name = '':U.
     3657       v-doc-rec = ?.
     3658       if old-word-script-name <> p-word-script-name then do:
     3659         run OpenBr in this-procedure
     3660             (input yes
     3661             ,input no
     3662             ,input '':U
     3663             ).
     3664       end.
     3665       run OpenBr in this-procedure
     3666           (input no
     3667           ,input p-next
     3668           ,input substitute("and X_prop-script.script-name begins &1 "
     3669             , p-script-name)
     3670           ).
     3671     END.
     3672     WHEN "contains" THEN DO:
     3673       p-word-script-name = v-w-script-name.
     3674           run OpenBr in this-procedure
     3675               (input yes
     3676               ,input NO
     3677               ,input '':U
     3678               ).
     3679     END.
     3680   END CASE.
     3681   apply "entry":u to f-script-name in frame Dialog-Frame .
     3682   END PROCEDURE.
     3683   FUNCTION get-translation RETURNS CHARACTER
     3684     ( INPUT p-uniq-key-rec AS character ) :
     3685   DEFINE BUFFER buf_ruledict FOR ub.ruledict.
     3686   FIND FIRST buf_ruledict NO-LOCK WHERE
     3687             buf_ruledict.entry-type = 'prop-script':U
     3688       AND   buf_ruledict.uniq-key-rec = p-uniq-key-rec NO-ERROR.
     3689   IF AVAILABLE buf_ruledict THEN DO:
     3690      RETURN buf_ruledict.script-nl.
     3691   END.
     3692   ELSE DO:
     3693       RETURN '':U.
     3694   END.
     3695   END FUNCTION.
