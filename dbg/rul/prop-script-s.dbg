     2781     run waitfram-show in this-procedure
     2782       (input "ЖДИТЕ ..."
     2783       ).
     2784   run gbl/flt-get.p
     2785     (input filter-point
     2786     ,output flt-rec-20
     2787     ,output filter-name-20
     2788     ,output where-phrase-20
     2789     ,output sort-phrase-20
