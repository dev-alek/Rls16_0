        1   DEFINE BUFFER X_prop-script FOR ub.prop-script.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter bttns as character no-undo.
        4   define input parameter p-list-mode as character no-undo .
        5   define input parameter p-language as character no-undo .
        6   define input parameter p-dtm-code as integer no-undo .
        7   define input parameter p-proc-type as character no-undo .
        8   define input parameter p-script-type as character no-undo .
        9   define input-output parameter p-rid-list as character no-undo.
       10   define variable vss-revision    as character no-undo init "$Revision$":U .
       11   define variable vss-author      as character no-undo init "$Author$":U .
       12   define variable vss-date        as character no-undo init "$Date$":U .
       13   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       14   define variable vss-archive     as character no-undo init "$Archive$":U .
       15   define variable vss-description as character no-undo init "Список prop-script".
       16   procedure vss-get-info :
       17     define output parameter p-vss-revision    like vss-revision    no-undo .
       18     define output parameter p-vss-author      like vss-author      no-undo .
       19     define output parameter p-vss-date        like vss-date        no-undo .
       20     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       21     define output parameter p-vss-archive     like vss-archive     no-undo .
       22     define output parameter p-vss-description like vss-description no-undo .
       23     assign
       24       p-vss-revision    = vss-revision
       25       p-vss-author      = vss-author
       26       p-vss-date        = vss-date
       27       p-vss-workfile    = vss-workfile
       28       p-vss-archive     = vss-archive
       29       p-vss-description = vss-description
       30     .
       31   end procedure.
       32   procedure vss-get-parameters :
       33     define output parameter p-vss-parameters as character no-undo .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       71   define variable v-waitfram-action01         as character   no-undo .
       72   define variable v-waitfram-action02         as character   no-undo .
       73   define variable v-waitfram-action03         as character   no-undo .
       74   define variable mWaitFramTextBeg            as character   no-undo.
       75   define variable mWaitFramTextEnd            as character   no-undo.
       76   define variable mWaitFramView               as logical     no-undo.
       77   define variable mWaitProcEvent              as logical     no-undo init yes.
       78   define variable mWaitFramInterval           as integer     no-undo init 1 .
       79   define variable mWaitFramStop               as logical     no-undo.
       80   define variable mWaitFramStopUser           as logical     no-undo.
       81   define variable mWaitFramStopTimeOut        as logical     no-undo.
       82   define variable mWaitFramStartProc          as datetime-tz no-undo.
       83   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       84   define button B-WaitFramStop auto-end-key
       85        label "Стоп"
       86        size 10 by 1 tooltip "Остоновить процесс".
       87   define button B-viewProcInfo
       88        label "Информация"
       89        size 15 by 1 tooltip "Информация о процесс".
       90   define frame waitfram
       91     v-waitfram-action01 format "x(72)" no-label skip
       92     v-waitfram-action02 format "x(72)" no-label skip
       93     v-waitfram-action03 format "x(72)" no-label skip
       94     B-viewProcInfo
       95     B-WaitFramStop at row 4 col 30
       96     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       97     .
       98   define new global shared variable mBatchMode as logical no-undo init ?.
       99   define variable mFramBachModHandle as handle no-undo.
      100   mFramBachModHandle = frame waitfram:handle.
      101   define variable mFameOldVis as logical no-undo.
      102   define variable mVisCUrentVin as logical no-undo.
      103   if session:batch-mode
      104   then
      105      mBatchMode = yes.
      106   if mBatchMode = ? then do:
      107     mVisCUrentVin = current-window:visible.
      108     mFameOldVis = mFramBachModHandle:visible.
      109     mFramBachModHandle:visible  = yes.
      110     mBatchMode = mFramBachModHandle:visible ne yes.
      111     mFramBachModHandle:visible = mFameOldVis.
      112     current-window:visible = mVisCUrentVin.
      113   end.
      114    if  log-manager:logfile-name ne ?
      115     then DO:
      116         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      117         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      118         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      119     end.
      120   on choose of B-WaitFramStop in frame waitfram
      121   do:
      122     mWaitFramStop = yes.
      123     mWaitFramStopUser = yes.
      124   end.
      125   function waitfram-check-timeout returns logical():
      126      define variable vtime as int64 no-undo.
      127      if mWaitFramStopTimeOut
      128      then
      129         return yes.
      130      vtime = ( now - mWaitFramStartProc ) / 1000 .
      131      if     mWaitFramTimeOut ne ?
      132         and mWaitFramTimeOut ne 0
      133         and mWaitFramTimeOut lt vtime
      134      then do:
      135         mWaitFramStopTimeOut = yes.
      136      end.
      137      return mWaitFramStopTimeOut.
      138   end.
      139   procedure waitfram-hide :
      140     if not session:batch-mode
      141     then do
      142     on error undo, return error return-value
      143     :
      144       pause 0 before-hide .
      145       if not mBatchMode then
      146         hide frame waitfram .
      147     if     not mWaitFramView
      148        and mWaitProcEvent
      149     then
      150       process events .
      151     end.
      152   end procedure.
      153   procedure waitfram-show :
      154     define input  parameter p-message as character no-undo .
      155     define variable v-left-margin as integer   no-undo .
      156     if not session:batch-mode
      157     then do
      158     on error undo, return error return-value
      159     :
      160       if length(p-message) <= 70 then do:
      161         assign
      162           v-left-margin = integer((70 - length(p-message)) / 2)
      163         .
      164         assign
      165           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      166         .
      167         assign
      168           v-waitfram-action01 = " "
      169           v-waitfram-action02 = " "
      170                                    + fill(" ", v-left-margin)
      171                                    + p-message
      172           v-waitfram-action03 = " "
      173         .
      174       end.
      175       else do:
      176         define variable vRindex1 as integer no-undo.
      177         define variable vRindex2 as integer no-undo.
      178         vRindex1 = r-index(p-message," ",70).
      179         if vRindex1 = 0
      180         then
      181            vRindex1 = 70.
      182         if length(p-message)  <= vRindex1 + 70 then do:
      183           assign
      184             v-waitfram-action01 = " "
      185             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      186             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      187           .
      188         end.
      189         else do:
      190           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      191           if vRindex2 <= vRindex1
      192           then
      193              vRindex2 = vRindex1 + 70.
      194           assign
      195             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      196             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      197             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      198           .
      199         end.
      200       end.
      201       B-viewProcInfo:visible   in frame waitfram = no.
      202       B-viewProcInfo:sensitive in frame waitfram = no.
      203       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      204       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      205       if  (   mWaitFramView
      206          or  mWaitProcEvent)
      207          and not mBatchMode
      208       then
      209          display
      210             v-waitfram-action01 skip
      211             v-waitfram-action02 skip
      212             v-waitfram-action03 skip
      213          with frame waitfram .
      214       if     mWaitFramView
      215          then do:
      216             if     mWaitFramInterval ne ?
      217                and not mBatchMode
      218             then
      219                wait-for go of frame waitfram pause mWaitFramInterval.
      220          end.
      221          else
      222             if     mWaitProcEvent
      223                and not mBatchMode
      224             then
      225                process events .
      226     end.
      227   end procedure.
      228      procedure waitfram-show-this:
      229         define input  parameter iInterval as int64 no-undo.
      230         define variable vtime as int64 no-undo.
      231         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      232         mWaitFramInterval = iInterval.
      233         run waitfram-show (substitute("&1&2 &3&4" ,
      234                                       mWaitFramTextBeg ,
      235                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      236                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      237                                       mWaitFramTextEnd
      238                                      )
      239                           ).
      240      end.
      241      procedure WaitFramRunPause:
      242         define input  parameter iInterval as dec no-undo.
      243         define variable vStart  as datetime-tz no-undo.
      244         define variable vend    as datetime-tz no-undo.
      245         define variable vint as int64 no-undo.
      246         define variable vOk as logical no-undo.
      247         vStart = now.
      248         vend   = vStart.
      249         publish "WaitFramPause" (iInterval,output vOk).
      250         vend   =  now.
      251         vint = vend - vStart.
      252         vint = iInterval - vint / 1000.
      253         if     not mWaitFramStop
      254            and (   vint > 0
      255                 or (    not vOk
      256                     and iInterval eq ?
      257                     )
      258                 )
      259         then
      260            run waitfram-show-this (iInterval).
      261         vend   =  now.
      262         vint = vend - vStart.
      263         vint = iInterval - vint / 1000.
      264         if     not mWaitFramStop
      265            and vint > 0
      266         then do:
      267            run gbl/pause.p (vint * 1000).
      268         end.
      269         if iInterval ne ?
      270         then
      271            publish "WaitFramStop".
      272         waitfram-check-timeout().
      273      end.
      274      procedure WaitFramWaitFor:
      275         define input  parameter iInterval as dec no-undo.
      276         assign
      277            mWaitFramStartProc   = now
      278            mWaitFramStopUser    = no
      279            mWaitFramStopTimeOut = no
      280         .
      281         block-wait:
      282         do while not mWaitFramStop:
      283            run WaitFramRunPause (iInterval).
      284            if  waitfram-check-timeout()
      285            then do:
      286               leave block-wait.
      287            end.
      288         end.
      289         run waitfram-hide.
      290      end.
      291   procedure waitfram-join :
      292     define input  parameter p-line-1  as character no-undo .
      293     define input  parameter p-line-2  as character no-undo .
      294     define input  parameter p-line-3  as character no-undo .
      295     define output parameter p-message as character no-undo .
      296     do
      297     on error undo, return error return-value
      298     :
      299       assign
      300         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      301                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      302                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      303       .
      304     end.
      305   end procedure.
      306   function waitfram-join-function returns character
      307     (input p-line-1 as character
      308     ,input p-line-2 as character
      309     ,input p-line-3 as character
      310     ).
      311     define variable v-message as character no-undo .
      312     run waitfram-join in this-procedure
      313       (input  p-line-1
      314       ,input  p-line-2
      315       ,input  p-line-3
      316       ,output v-message
      317       ) .
      318     return v-message .
      319   end function .
      320   define new global shared variable g#language as character no-undo .
      321   if g#language <> '' and g#language <> 'rus':U then do:
      322     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      323   end.
      324   procedure proc-alt-shift-f2:
      325     if not ibs.th.gbl.gbl-var:rcode
      326   then
      327     run gbl\inidebug.p .
      328   end.
      329   procedure proc-alt-shift-f3:
      330     run gbl/prvssinf.p
      331       ( input this-procedure
      332       ) .
      333   end.
      334   define variable v-inform-launched as logical no-undo initial false .
      335   procedure proc-alt-shift-f4:
      336     define variable v-action as character no-undo .
      337     if v-inform-launched = false then do:
      338       assign
      339         v-inform-launched = true
      340       .
      341       run gbl/d-inform.w
      342         (  input self
      343         ,  input this-procedure
      344         , output v-action
      345         ) no-error .
      346       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      347       assign
      348         v-inform-launched = false
      349       .
      350     end.
      351   end.
      352   procedure proc-alt-f1:
      353     run gbl/corrhelp.p
      354       (input this-procedure
      355       ) .
      356   end .
      357   on alt-shift-f2 anywhere do:
      358     run proc-alt-shift-f2.
      359   end.
      360   on alt-shift-f3 anywhere do:
      361     run proc-alt-shift-f3 in this-procedure .
      362   end.
      363   on alt-shift-f4 anywhere do:
      364     run proc-alt-shift-f4 in this-procedure.
      365   end.
      366   on alt-f1 anywhere do:
      367     run proc-alt-f1 in this-procedure .
      368   end.
      369   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      370     define variable v-cntxt-db-num        as integer   no-undo .
      371     define variable v-cntxt-userid        as character no-undo .
      372     define variable v-cntxt-level         as character no-undo .
      373     define variable v-cntxt-host-code-obj as integer   no-undo .
      374     define variable v-cntxt-obj-type      as character no-undo .
      375     define variable v-cntxt-obj-code      as integer   no-undo .
      376     define variable v-cntxt-db-num-obj    as integer   no-undo .
      377     define variable v-cntxt-is-admin      as logical   no-undo .
      378   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      379   FUNCTION mark-string RETURNS CHARACTER
      380     ( input p-recid as recid, input mark-list as character  ) :
      381     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      382   END FUNCTION.
      383   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      384   define variable c-point  as character no-undo .
      385   define variable tbl      as character no-undo .
      386   define variable join-tbl as character no-undo .
      387   define variable fld      as character no-undo .
      388   define variable lab      as character no-undo .
      389   define variable spr      as character no-undo .
      390   define variable dim      as character no-undo .
      391   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      392   procedure fltfield-clear :
      393     define output parameter loc-fld as character no-undo.
      394     define output parameter loc-lab as character no-undo .
      395     define output parameter loc-spr as character no-undo .
      396     define output parameter loc-dim as character no-undo .
      397     assign
      398       loc-fld = ""
      399       loc-lab = ""
      400       loc-spr = ""
      401       loc-dim = "0"
      402     .
      403   end procedure .
      404   procedure fltfield-add :
      405     define input        parameter par-fld as character no-undo.
      406     define input        parameter par-lab as character no-undo .
      407     define input        parameter par-spr as character no-undo .
      408     define input-output parameter loc-fld as character no-undo.
      409     define input-output parameter loc-lab as character no-undo .
      410     define input-output parameter loc-spr as character no-undo .
      411     define input-output parameter loc-dim as character no-undo .
      412     do
      413     on error undo, return error
      414     :
      415       assign
      416       loc-fld = if loc-dim = '0'
      417                 then par-fld
      418                 else (loc-fld + chr(44) + par-fld)
      419       loc-lab = if loc-dim = '0'
      420                 then par-lab
      421                 else (loc-lab + chr(44) + par-lab)
      422       loc-spr = if loc-dim = '0'
      423                 then par-spr
      424                 else (loc-spr + chr(44) + par-spr)
      425       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      426                 string(integer(if num-entries(loc-dim) > 1
      427                               then entry(2, loc-dim)
      428                               else entry(1, loc-dim)
      429                               ) + 1)
      430       no-error
      431       .
      432     end.
      433   end procedure.
      434   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      435   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      436   procedure fltopend_fltopend :
      437   define input parameter p-parent-handle as handle no-undo .
      438   define input parameter p-qh as handle no-undo .
      439   define input parameter p-flt-open-open-query  as character no-undo .
      440   define input parameter p-where-cond as character no-undo .
      441   define input parameter p-use-indFIRST-query-tail as character no-undo .
      442   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      443   define input parameter p-indexed-reposition as character no-undo .
      444     do
      445     on error undo, return error
      446     :
      447   define variable v-prepare-string as character no-undo .
      448   define variable glog as logical no-undo .
      449   assign
      450   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      451                      p-where-cond + chr(32)  +
      452                      p-use-indFIRST-query-tail + chr(32) +
      453                      p-use-ind-sort-clmn-by + chr(32) +
      454                      p-indexed-reposition
      455   .
      456   assign
      457   glog = p-qh:query-prepare(v-prepare-string) no-error .
      458   if not glog
      459   or error-status:error then do:
      460     message error-status:get-message(1) view-as alert-box .
      461     undo, return error .
      462   end.
      463   assign
      464   glog = p-qh:query-open no-error .
      465   if not glog
      466   or error-status:error then do:
      467     message error-status:get-message(1) view-as alert-box .
      468     undo, return error .
      469   end.
      470     end.
      471   end procedure.
      472   procedure fltopend_fltfindd :
      473   define input parameter p-parent-handle as handle no-undo .
      474   define input parameter p-qh as handle no-undo .
      475   define input parameter p-rowid as rowid no-undo .
      476   define input parameter p-next as logical no-undo .
      477   define input parameter p-lock as integer no-undo .
      478   define input parameter p-bh as handle no-undo .
      479   define input parameter p-where-cond as character no-undo .
      480   define input parameter p-use-index-phrase as character no-undo .
      481   define variable glog as logical no-undo .
      482   define variable v-qh as handle no-undo .
      483   define variable v-bh as handle no-undo .
      484   define variable v-recid as recid no-undo .
      485   define variable v-prepare-string as character no-undo .
      486   do
      487   on error undo, return error
      488   on stop undo, return error
      489   :
      490     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      491     create buffer v-bh for table p-bh buffer-name p-bh:name.
      492     create query v-qh.
      493     v-qh:set-buffers(v-bh).
      494     v-prepare-string = substitute("for each &1 &2 &3"
      495                                     ,v-bh:name
      496                                     ,p-where-cond
      497                                     ,p-use-index-phrase).
      498     glog = v-qh:query-prepare(v-prepare-string) no-error.
      499     if not glog then do:
      500       delete object v-qh.
      501       delete object v-bh.
      502       undo, return error .
      503     end.
      504     glog = v-qh:query-open no-error .
      505     if not glog then do:
      506       delete object v-qh.
      507       delete object v-bh.
      508       undo, return error .
      509     end.
      510     if p-next then do:
      511       v-qh:reposition-to-rowid(p-rowid) no-error .
      512       glog = v-qh:get-next( p-lock) no-error .
      513       glog = v-qh:get-next( p-lock) no-error .
      514       if not glog or v-qh:query-off-end = yes then do:
      515         glog = v-qh:get-first( p-lock) no-error .
      516       end.
      517     end.
      518     else do:
      519       glog = v-qh:get-first( p-lock) no-error .
      520     end.
      521     v-recid = v-bh:recid no-error .
      522     delete object v-qh.
      523     delete object v-bh.
      524     return string(v-recid) .
      525   end.
      526   end procedure.
      527   procedure fltopend_fltfindq :
      528   define input parameter p-parent-handle as handle no-undo .
      529   define input parameter p-qh as handle no-undo .
      530   define input parameter p-next as logical no-undo .
      531   define input parameter p-lock as integer no-undo .
      532   define input parameter p-flt-open-open-query  as character no-undo .
      533   define input parameter p-where-cond as character no-undo .
      534   define input parameter p-use-indFIRST-query-tail as character no-undo .
      535   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      536   define input parameter p-indexed-reposition as character no-undo .
      537   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      538   define variable glog as logical no-undo .
      539   define variable v-qh as handle no-undo .
      540   define variable v-bh as handle no-undo extent 18.
      541   define variable v-rowid as rowid no-undo extent 18.
      542   define variable v-ii as integer no-undo .
      543   define variable v-prepare-string as character no-undo .
      544   do
      545   on error undo, return error
      546   on stop undo, return error
      547   :
      548     create query v-qh.
      549     do v-ii = 1 to p-qh:num-buffers:
      550       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      551       assign
      552       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      553       no-error.
      554       v-qh:add-buffer(v-bh[v-ii]).
      555     end.
      556     assign
      557     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      558                       p-where-cond + chr(32)  +
      559                       p-use-indFIRST-query-tail + chr(32) +
      560                       p-use-ind-sort-clmn-by + chr(32) +
      561                       p-indexed-reposition
      562     .
      563     glog = v-qh:query-prepare( v-prepare-string) no-error .
      564     if not glog then do:
      565       delete object v-qh.
      566       do v-ii = 1 to p-qh:num-buffers:
      567         delete object v-bh[v-ii].
      568       end.
      569       undo, return error .
      570     end.
      571     glog = v-qh:query-open no-error .
      572     if not glog then do:
      573       delete object v-qh.
      574       do v-ii = 1 to p-qh:num-buffers:
      575         delete object v-bh[v-ii].
      576       end.
      577       undo, return error .
      578     end.
      579     if p-next then do:
      580       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      581       glog = v-qh:get-next( p-lock) no-error .
      582       glog = v-qh:get-next( p-lock) no-error .
      583       if not glog or v-qh:query-off-end = yes then do:
      584         glog = v-qh:get-first( p-lock) no-error .
      585       end.
      586     end.
      587     else do:
      588       glog = v-qh:get-first( p-lock) no-error .
      589     end.
      590     do v-ii = 1 to p-qh:num-buffers:
      591       assign
      592       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
      593       no-error.
      594     end.
      595     delete object v-qh.
      596     do v-ii = 1 to p-qh:num-buffers:
      597       delete object v-bh[v-ii].
      598     end.
      599   end.
      600   end procedure.
      601   DEFINE VARIABLE v-doc-rec AS RECID NO-UNDO.
      602   DEFINE VARIABLE link-option AS CHARACTER NO-UNDO.
      603   define variable sort-column-name as character no-undo .
      604   define variable filter-point-label as character no-undo init "Скрипты RULE-машины" .
      605   define variable filter-point0 as character no-undo init "prop-script-s" .
      606   define variable filter-point as character no-undo init "prop-script-s" .
      607   DEFINE VARIABLE p-word-script-name AS CHARACTER NO-UNDO.
      608   define variable v-rid-list as character no-undo .
      609   FUNCTION get-translation RETURNS CHARACTER
      610     ( INPUT p-uniq-key-rec AS character )  FORWARD.
      611   DEFINE MENU MENU-b-link
      612          MENU-ITEM m_pscript-ruleset LABEL "Привязка к наборам правил"
      613          MENU-ITEM m_rule-i-script LABEL "Привязка к правилам"
      614          MENU-ITEM m_ruledict-param LABEL "Параметры"     .
      615   DEFINE BUTTON b-add
      616        LABEL "&Добавить"
      617        SIZE 10 BY 1.
      618   DEFINE BUTTON b-chg
      619        LABEL "&Изменить"
      620        SIZE 10 BY 1.
      621   DEFINE BUTTON b-copy
      622        LABEL "&Копировать"
      623        SIZE 10 BY 1.
      624   DEFINE BUTTON b-del
      625        LABEL "&Удалить"
      626        SIZE 10 BY 1.
      627   DEFINE BUTTON B-Help
      628        LABEL "Помо&щь"
      629        SIZE 3 BY 1
      630        BGCOLOR 8 .
      631   DEFINE BUTTON b-link
      632        LABEL "Связи"
      633        SIZE 10 BY 1.
      634   DEFINE BUTTON b-lkp
      635        LABEL "&Просмотр"
      636        SIZE 10 BY 1.
      637   DEFINE BUTTON b-mark
      638        LABEL "&*"
      639        SIZE 4 BY 1.
      640   DEFINE BUTTON b-quit AUTO-END-KEY
      641        LABEL "&Выход"
      642        SIZE 10 BY 1
      643        BGCOLOR 8 .
      644   DEFINE BUTTON b-sch
      645        LABEL "&Фильтр"
      646        SIZE 3 BY 1.
      647   DEFINE BUTTON b-sel AUTO-GO
      648        LABEL "Выбор"
      649        SIZE 10 BY 1.
      650   DEFINE VARIABLE cb-prop-head AS CHARACTER FORMAT "X(256)":U
      651        LABEL "Объект-операнд"
      652        VIEW-AS COMBO-BOX INNER-LINES 10
      653        LIST-ITEM-PAIRS "Item 1","Item 1"
      654        DROP-DOWN-LIST
      655        SIZE 80.5 BY 1 NO-UNDO.
      656   DEFINE VARIABLE f-script-name AS CHARACTER FORMAT "X(256)":U
      657        VIEW-AS FILL-IN
      658        SIZE 73 BY 1 NO-UNDO.
      659   DEFINE VARIABLE mark-num AS INTEGER FORMAT "->,>>>,>>9":U INITIAL ?
      660         VIEW-AS TEXT
      661        SIZE 9 BY .67
      662        FGCOLOR 10  NO-UNDO.
      663   DEFINE VARIABLE rs-find AS CHARACTER INITIAL "begins"
      664        VIEW-AS RADIO-SET HORIZONTAL
      665        RADIO-BUTTONS
      666             "Нач.назв.", "begins",
      667   "Нач.слова", "contains"
      668        SIZE 23 BY 1 NO-UNDO.
      669   DEFINE VARIABLE rs-language AS CHARACTER
      670        VIEW-AS RADIO-SET HORIZONTAL
      671        RADIO-BUTTONS
      672             "Item 1", "1",
      673   "Item 2", "2"
      674        SIZE 24 BY 1 NO-UNDO.
      675   DEFINE QUERY br-prop-script FOR
      676         X_prop-script SCROLLING.
      677   DEFINE BROWSE br-prop-script
      678     QUERY br-prop-script NO-LOCK DISPLAY
      679         mark-string(recid(X_prop-script), v-rid-list) Format "X(1)" COLUMN-LABEL "*"
      680   X_prop-script.dtm-code format ">9"
      681   X_prop-script.class-dtm-code format ">9" COLUMN-LABEL "Код!класса"
      682   X_prop-script.language COLUMN-LABEL "lang" FORMAT "X(3)":U
      683       WIDTH 3
      684   X_prop-script.script-name COLUMN-LABEL "Скрипт" FORMAT "X(255)":U
      685       WIDTH 40
      686   get-translation(X_prop-script.uniq-key-rec) COLUMN-LABEL "Перевод" FORMAT "X(255)":U
      687             WIDTH 40
      688   entry(1, X_prop-script.script-value-type) COLUMN-LABEL "Тип!знач" FORMAT "X(12)":U
      689       WIDTH 10
      690   (IF NUM-ENTRIES(X_prop-script.script-value-type) > 1
      691    THEN entry(2, X_prop-script.script-value-type)
      692    ELSE '':U) COLUMN-LABEL "Объектн.!знач" FORMAT "X(12)":U
      693           WIDTH 10
      694   X_prop-script.script-type FORMAT "X(255)":U
      695       WIDTH 15
      696   X_prop-script.proc-type FORMAT "X(255)":U
      697       WIDTH 15
      698   X_prop-script.revis_id FORMAT ">>>>>>>>9":U
      699       WITH NO-ROW-MARKERS SEPARATORS SIZE 97 BY 17.54 FIT-LAST-COLUMN.
      700   DEFINE FRAME Dialog-Frame
      701        b-quit AT ROW 1 COL 1
      702        b-mark AT ROW 1 COL 24 WIDGET-ID 12
      703        b-sel AT ROW 1 COL 28 WIDGET-ID 10
      704        b-add AT ROW 1 COL 38 WIDGET-ID 2
      705        b-chg AT ROW 1 COL 48 WIDGET-ID 4
      706        b-del AT ROW 1 COL 58 WIDGET-ID 8
      707        b-lkp AT ROW 1 COL 68 WIDGET-ID 6
      708        b-link AT ROW 1 COL 78 WIDGET-ID 16
      709        b-sch AT ROW 1 COL 92 WIDGET-ID 20
      710        B-Help AT ROW 1 COL 95
      711        rs-language AT ROW 2 COL 21 NO-LABEL WIDGET-ID 48
      712        b-copy AT ROW 2 COL 48 WIDGET-ID 56
      713        cb-prop-head AT ROW 3 COL 1.5 WIDGET-ID 46
      714        rs-find AT ROW 4 COL 1.5 NO-LABEL WIDGET-ID 52
      715        f-script-name AT ROW 4 COL 25 NO-LABEL WIDGET-ID 18
      716        br-prop-script AT ROW 5 COL 1.5 WIDGET-ID 100
      717        mark-num AT ROW 1 COL 13 COLON-ALIGNED NO-LABEL WIDGET-ID 14
      718        SPACE(74.50) SKIP(21.52)
      719       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      720            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      721            TITLE ""
      722            CANCEL-BUTTON b-quit.
      723   ASSIGN
      724          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      725          FRAME Dialog-Frame:HIDDEN           = TRUE.
      726   ASSIGN
      727          b-link:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-b-link:HANDLE.
      728   ON GO OF FRAME Dialog-Frame
      729   DO:
      730     p-rid-list = v-rid-list.
      731   END.
      732   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      733   DO:
      734     APPLY "END-ERROR":U TO SELF.
      735   END.
      736   ON CHOOSE OF b-add IN FRAME Dialog-Frame
      737   DO:
      738    define variable v-rec as recid no-undo.
      739     run rul/prop-script-i.w (  input parparentproc
      740                               ,input 'ДОБАВЛЕНИЕ':U
      741                               ,INPUT p-dtm-code
      742                               ,input "ABL"
      743                               ,input '':U
      744                               ,input 0
      745                               ,input-output v-rec) no-error.
      746     if v-rec <> ? then do:
      747       run openbr in this-procedure ( input yes, input no, input '':U).
      748       reposition br-prop-script to recid v-rec no-error.
      749     end.
      750   END.
      751   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
      752   DO:
      753     define variable v-rec as recid no-undo.
      754     if not available X_prop-script then return no-apply.
      755     v-rec = recid(X_prop-script).
      756     run rul/prop-script-i.w ( input parparentproc
      757                          ,input 'ИЗМЕНЕНИЕ':U
      758                          ,INPUT X_prop-script.dtm-code
      759                          ,input X_prop-script.language
      760                          ,input X_prop-script.script-name
      761                          ,input X_prop-script.revis_id
      762                          ,input-output v-rec) no-error.
      763     if v-rec <> ? then do:
      764        br-prop-script:refresh().
      765     end.
      766   END.
      767   ON CHOOSE OF b-copy IN FRAME Dialog-Frame
      768   DO:
      769      define variable v-rec as recid no-undo.
      770      if not available X_prop-script then return no-apply.
      771      v-rec = recid(X_prop-script).
      772      run rul/prop-script-i.w (  input parparentproc
      773                                ,input 'КОПИРОВАНИЕ':U
      774                                ,INPUT X_prop-script.dtm-code
      775                                ,input "ABL"
      776                                ,input X_prop-script.script-name
      777                                ,input X_prop-script.revis_id
      778                                ,input-output v-rec) no-error.
      779      if v-rec <> ? then do:
      780        run openbr in this-procedure ( input yes, input no, input '':U).
      781        reposition br-prop-script to recid v-rec no-error.
      782      end.
      783   END.
      784   ON CHOOSE OF b-del IN FRAME Dialog-Frame
      785   DO:
      786     define variable v-rec as recid no-undo.
      787     define variable glog as logical no-undo.
      788     if not available X_prop-script then return no-apply.
      789     v-rec = recid(X_prop-script).
      790     message "Вы уверены, что хотите удалить скрипт?"
      791     view-as alert-box question buttons yes-no update glog.
      792     if not glog then return no-apply.
      793    run rul/prop-script3.p ( input no
      794                            ,input v-rec
      795                            ) no-error.
      796    if error-status:error then return no-apply.
      797    run openbr in this-procedure ( input yes, input no, input '':U).
      798    END.
      799   ON CHOOSE OF b-link IN FRAME Dialog-Frame
      800   DO:
      801     IF NOT AVAILABLE X_prop-script THEN RETURN NO-APPLY.
      802     IF link-option = '':U  THEN DO:
      803       run gbl/pop-up.p ( input self :handle, input no ) no-error.
      804       if error-status :error then do: return no-apply. end.
      805     end.
      806     if link-option = "":U then do:
      807         return no-apply.
      808     end.
      809     RUN proc-b-link IN THIS-PROCEDURE ( INPUT link-option) NO-ERROR.
      810     IF ERROR-STATUS:ERROR THEN DO:
      811        link-option = '':U.
      812        RETURN NO-APPLY.
      813     END.
      814     link-option = '':U.
      815   END.
      816   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
      817   DO:
      818     define variable v-rec as recid no-undo.
      819     if not available X_prop-script then return no-apply.
      820     v-rec = recid(X_prop-script).
      821     run rul/prop-script-i.w ( input parparentproc
      822                          ,input 'ПРОСМОТР':U
      823                          ,INPUT X_prop-script.dtm-code
      824                          ,input X_prop-script.language
      825                          ,input X_prop-script.script-name
      826                          ,input X_prop-script.revis_id
      827                          ,input-output v-rec) no-error.
      828   END.
      829   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
      830   DO:
      831     define variable loc#log as logical no-undo .
      832     if available X_prop-script then do:
      833   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      834   define variable v-str-recid8 as character no-undo .
      835   define variable v-num-entry8 as integer   no-undo .
      836   assign
      837     v-str-recid8 = trim( string( recid( X_prop-script ) , "->>>>>>>>>>>9":U ) )
      838     v-num-entry8 = lookup( v-str-recid8 , v-rid-list )
      839   .
      840   if v-num-entry8 > 0 then do:
      841     assign
      842       entry( v-num-entry8, v-rid-list ) = "":U
      843       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
      844     .
      845   end.
      846   else do:
      847     assign
      848       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid8
      849     .
      850   end.
      851       loc#log = br-prop-script:refresh() .
      852       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
      853           loc#log = br-prop-script:select-next-row ().
      854           apply "VALUE-CHANGED" to br-prop-script in frame Dialog-Frame.
      855       end.
      856       if num-entries( v-rid-list ) = 0
      857       then
      858           hide mark-num in frame Dialog-Frame.
      859       else
      860           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
      861     end.
      862     apply "entry" to br-prop-script in frame Dialog-Frame.
      863   END.
      864   ON CHOOSE OF b-sch IN FRAME Dialog-Frame
      865   DO:
      866       RUN proc-b-sch IN THIS-PROCEDURE NO-ERROR.
      867     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      868   END.
      869   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
      870   DO:
      871     if available X_prop-script then do:
      872       if  ( v-rid-list = "" ) or b-mark:sensitive = no
      873       then  v-rid-list = string( recid( X_prop-script ) ) .
      874     end.
      875   END.
      876   ON VALUE-CHANGED OF cb-prop-head IN FRAME Dialog-Frame
      877   DO:
      878     ASSIGN cb-prop-head.
      879     RUN Openbr IN THIS-PROCEDURE ( input yes, input no, input '':U).
      880   END.
      881   ON CTRL-J OF f-script-name IN FRAME Dialog-Frame
      882   DO:
      883     run proc-find-script-name in this-procedure ( input YES
      884                                                 , input frame Dialog-Frame f-script-name
      885                                                 , INPUT rs-find) no-error.
      886     if error-status:error then return no-apply.
      887   END.
      888   ON RETURN OF f-script-name IN FRAME Dialog-Frame
      889   DO:
      890     run proc-find-script-name in this-procedure ( input no
      891                                                 , input frame Dialog-Frame f-script-name
      892                                                 , INPUT rs-find) no-error.
      893     if error-status:error then return no-apply.
      894   END.
      895   ON CHOOSE OF MENU-ITEM m_pscript-ruleset
      896   DO:
      897       IF NOT AVAILABLE X_prop-script THEN RETURN NO-APPLY.
      898     ASSIGN
      899     link-option = 'pscript-ruleset':U.
      900     RUN proc-b-link IN THIS-PROCEDURE ( INPUT link-option) NO-ERROR.
      901     IF error-status:ERROR THEN DO:
      902        link-option = '':U.
      903        RETURN NO-APPLY.
      904     END.
      905     link-option = '':U.
      906   END.
      907   ON CHOOSE OF MENU-ITEM m_rule-i-script
      908   DO:
      909     IF NOT AVAILABLE X_prop-script THEN RETURN NO-APPLY.
      910     ASSIGN
      911     link-option = 'rule-i-script':U.
      912     RUN proc-b-link IN THIS-PROCEDURE ( INPUT link-option) NO-ERROR.
      913     IF error-status:ERROR THEN DO:
      914        link-option = '':U.
      915        RETURN NO-APPLY.
      916     END.
      917     link-option = '':U.
      918   END.
      919   ON CHOOSE OF MENU-ITEM m_ruledict-param
      920   DO:
      921        IF NOT AVAILABLE X_prop-script THEN RETURN NO-APPLY.
      922     ASSIGN
      923     link-option = 'ruledict-param':U.
      924     RUN proc-b-link IN THIS-PROCEDURE ( INPUT link-option) NO-ERROR.
      925     IF error-status:ERROR THEN DO:
      926        link-option = '':U.
      927        RETURN NO-APPLY.
      928     END.
      929     link-option = '':U.
      930   END.
      931   ON VALUE-CHANGED OF rs-find IN FRAME Dialog-Frame
      932   DO:
      933     ASSIGN
      934     rs-find.
      935     apply "ENTRY" to f-script-name.
      936   END.
      937   ON VALUE-CHANGED OF rs-language IN FRAME Dialog-Frame
      938   DO:
      939     ASSIGN
      940     rs-language.
      941     CASE rs-language:
      942       WHEN "ABL" THEN DO:
      943         X_prop-script.script-name:VISIBLE IN browse br-prop-script = YES.
      944       END.
      945       WHEN "rus" THEN DO:
      946         X_prop-script.script-name:VISIBLE IN browse br-prop-script = NO.
      947       END.
      948     END CASE.
      949   END.
      950   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      951   on f5 of frame Dialog-Frame anywhere
      952   do:
      953      v-doc-rec = recid(X_prop-script).    RUn OpenBR in this-procedure ( input yes, input no, input '':U).  REPOSITION br-prop-script to recid v-doc-rec No-ERROR.   apply 'value-changed' to br-prop-script.
      954       apply "VALUE-CHANGED" to br-prop-script.
      955   end.
      956   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      957   on help of frame Dialog-Frame
      958   do:
      959     run gbl/app_help.p
      960       (input this-procedure :file-name
      961       ,input ''
      962       ,input ?
      963       ) no-error.
      964     if error-status :error then do:
      965       message
      966         "Ошибка при вызове помощи"
      967         error-status :get-message(1)
      968         view-as alert-box .
      969     end.
      970   end.
      971   run minbtn-set in this-procedure .
      972   on choose of b-help in frame Dialog-Frame
      973   do:
      974     apply "help":u to frame Dialog-Frame .
      975   end.
      976   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      977   procedure minbtn-set :
      978       do
      979           on error undo, return error return-value
      980           :
      981           define variable ii              as integer       no-undo .
      982           define variable fh              as widget-handle no-undo .
      983           define variable hh              as widget-handle no-undo .
      984           define variable v-h             as handle        extent 4 no-undo .
      985           define variable v-name-button   as character     no-undo .
      986           define variable v-help-old-x    as decimal       no-undo .
      987           define variable v-help-old-y    as decimal       no-undo .
      988           define variable v-help-old-size as decimal       no-undo .
      989           define variable v-frame-width   as decimal       no-undo .
      990           define variable jj              as integer       no-undo .
      991           do
      992               on error undo, return error
      993               :
      994               assign
      995                   v-frame-width = frame Dialog-Frame:width - 0.3
      996                   fh            = frame Dialog-Frame:first-child
      997                   hh            = fh:first-child
      998                   ii            = 1
      999                   .
     1000               do while valid-handle(hh):
     1001                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1002                   do:
     1003                       case lc(hh:name) :
     1004                           when "b-help" then
     1005                               do:
     1006                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1007                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1008                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1009                                   hh:TOOLTIP = "Помощь" .
     1010                                   v-help-old-x = hh:column .
     1011                                   v-help-old-y = hh:row    .
     1012                                   v-help-old-size = hh:width .
     1013                                   hh:width-chars = 2.5 .
     1014                               end.
     1015                           when "b-print" then
     1016                               do:
     1017                                   hh:load-image("cmp/b-print.bmp":u) .
     1018                                   hh:TOOLTIP = "Печать" .
     1019                                   v-h[ii] = hh:handle .
     1020                                   ii = ii + 1 .
     1021                                   hh:width-chars = 3 .
     1022                               end.
     1023                           when "b-history" or
     1024                           when "b-hist" then
     1025                               do:
     1026                                   hh:load-image("cmp/b-hist.bmp":u) .
     1027                                   hh:TOOLTIP = "История" .
     1028                                   v-h[ii] = hh:handle .
     1029                                   ii = ii + 1 .
     1030                                   hh:width-chars = 3 .
     1031                               end.
     1032                           when "b-sch" then
     1033                               do:
     1034                                   hh:load-image("cmp/b-sch.bmp":u) .
     1035                                   hh:TOOLTIP = "Установка Фильтра" .
     1036                                   v-h[ii] = hh:handle .
     1037                                   ii = ii + 1 .
     1038                                   hh:width-chars = 3 .
     1039                               end.
     1040                           when "b-hist-user" then
     1041                               do:
     1042                                   hh:load-image("cmp/b-hist.bmp":u) .
     1043                                   hh:TOOLTIP = "История пользователя" .
     1044                                   ii = ii + 1 .
     1045                               end.
     1046                       end case.
     1047                   end.
     1048                   hh = hh:next-sibling.
     1049               end.
     1050               b-help:column = v-frame-width - b-help:width-chars.
     1051               jj = 0.
     1052               repeat ii = 4 to 1 by -1 :
     1053                   if valid-handle (v-h[ii] ) then
     1054                   do:
     1055                       jj  = jj + 1 .
     1056                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1057                       v-h[ii]:row    = v-help-old-y .
     1058                   end.
     1059               end.
     1060           end.
     1061       end.
     1062   end procedure.
     1063   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1064   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1065   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1066   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1067   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1068   define variable v-diasize-current-frame-height as decimal   no-undo .
     1069   define variable v-diasize-change-size          as logical   no-undo .
     1070   define variable v-diasize-resize-button        as handle    no-undo .
     1071   define variable v-diasize-wndmax               as logical   no-undo .
     1072   define variable v-diasize-wndstore             as logical   no-undo .
     1073   define variable v-diasize-proc-name            as character no-undo .
     1074   define variable v-diasize-browse-handle        as handle    no-undo .
     1075   define variable v-diasize-browse-number        as integer   no-undo .
     1076   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1077   define temp-table temp-diasize-handle no-undo
     1078     field handle-value  as handle
     1079     field save-position as decimal
     1080     index xpk is primary unique handle-value
     1081     .
     1082   define temp-table temp-browse-handle no-undo
     1083     field browse-type   as character
     1084     field browse-number as integer
     1085     field browse-handle as handle
     1086     field original-size as decimal
     1087     index xpk is primary unique browse-type browse-number
     1088     index xie browse-type browse-handle
     1089   .
     1090   procedure diasize_change-height :
     1091     define input  parameter p-change-value  as decimal   no-undo .
     1092     define input  parameter p-move-resize   as logical   no-undo .
     1093     define variable v-field-group-handle    as handle    no-undo .
     1094     define variable v-object-handle         as handle    no-undo .
     1095     define variable v-frame-height          as decimal   no-undo .
     1096     define variable v-frame-virtual-height  as decimal   no-undo .
     1097     define variable v-browse-height         as decimal   no-undo .
     1098     define variable v-window-height         as decimal   no-undo .
     1099     define variable v-window-virtual-height as decimal   no-undo .
     1100     define variable v-change-sign           as integer   no-undo .
     1101     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1102     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1103     if p-change-value > 0
     1104     then do:
     1105       if frame Dialog-Frame :height + p-change-value
     1106           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1107       then do:
     1108         assign
     1109           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1110                           - (frame Dialog-Frame :height-chars)
     1111         .
     1112         if p-change-value <= 0
     1113         then do:
     1114           run diasize_position-resize-button in this-procedure .
     1115           return .
     1116         end.
     1117       end.
     1118     end.
     1119     if p-change-value < 0
     1120     then do:
     1121       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1122       then do:
     1123         assign
     1124           p-change-value = v-diasize-orig-frame-height
     1125                          - (frame Dialog-Frame :height-chars)
     1126         .
     1127         if p-change-value >= 0
     1128         then do:
     1129           run diasize_position-resize-button in this-procedure .
     1130           return .
     1131         end.
     1132       end.
     1133     end.
     1134     if p-change-value >= 0
     1135     then do:
     1136       assign
     1137         v-change-sign = 1
     1138       .
     1139     end.
     1140     else do:
     1141       assign
     1142         v-change-sign = -1
     1143       .
     1144     end.
     1145     assign
     1146       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1147     .
     1148     if p-change-value = 0
     1149     then do:
     1150       run diasize_position-resize-button in this-procedure .
     1151       return .
     1152     end.
     1153     move_block:
     1154     do
     1155     on error undo move_block, retry move_block
     1156     :
     1157       if retry
     1158       then do:
     1159         do
     1160         on error undo move_block, leave move_block
     1161         :
     1162           if p-change-value > 0
     1163           then do:
     1164             for each buf_temp-diasize-handle
     1165             on error undo, next
     1166             :
     1167               assign
     1168                 v-object-handle = buf_temp-diasize-handle.handle-value
     1169               .
     1170               if v-object-handle <> v-diasize-resize-button
     1171               then do:
     1172                 assign
     1173                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1174                 .
     1175               end.
     1176             end.
     1177             assign
     1178               v-diasize-browse-handle :height = v-browse-height
     1179             .
     1180             for each buf_temp-browse-handle
     1181               where buf_temp-browse-handle.browse-type = 'height':u
     1182             on error undo, next
     1183             :
     1184               assign
     1185                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1186               .
     1187             end.
     1188             assign
     1189               frame Dialog-Frame :height = v-frame-height
     1190             .
     1191             if frame Dialog-Frame :scrollable = true
     1192             then do:
     1193               assign
     1194                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1195               .
     1196             end.
     1197             run diasize_position-resize-button in this-procedure .
     1198           end.
     1199           else do:
     1200             if frame Dialog-Frame :scrollable = true
     1201             then do:
     1202               assign
     1203                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1204               .
     1205             end.
     1206             assign
     1207               frame Dialog-Frame :height = v-frame-height
     1208             .
     1209             assign
     1210               v-diasize-browse-handle :height = v-browse-height
     1211             .
     1212             for each buf_temp-browse-handle
     1213               where buf_temp-browse-handle.browse-type = 'height':u
     1214             on error undo, next
     1215             :
     1216               assign
     1217                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1218               .
     1219             end.
     1220             for each buf_temp-diasize-handle
     1221             on error undo, next
     1222             :
     1223               assign
     1224                 v-object-handle = buf_temp-diasize-handle.handle-value
     1225               .
     1226               if v-object-handle <> v-diasize-resize-button
     1227               then do:
     1228                 assign
     1229                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1230                 .
     1231               end.
     1232             end.
     1233             run diasize_position-resize-button in this-procedure .
     1234           end.
     1235           assign
     1236             v-diasize-change-size = false
     1237           .
     1238           leave move_block .
     1239         end.
     1240       end.
     1241       assign
     1242         v-diasize-need-full-display = true
     1243       .
     1244       if v-diasize-change-size = false
     1245       then do:
     1246         assign
     1247           v-diasize-change-size = true
     1248         .
     1249       end.
     1250       else do:
     1251         return .
     1252       end.
     1253       assign
     1254         v-frame-height = frame Dialog-Frame :height
     1255         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1256         v-browse-height = v-diasize-browse-handle :height
     1257       .
     1258       for each buf_temp-browse-handle
     1259         where buf_temp-browse-handle.browse-type = 'height':u
     1260       :
     1261         assign
     1262           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1263         .
     1264       end.
     1265       for each buf_temp-diasize-handle
     1266       :
     1267         delete buf_temp-diasize-handle .
     1268       end.
     1269       assign
     1270         v-field-group-handle = frame Dialog-Frame :first-child
     1271       .
     1272       do while valid-handle(v-field-group-handle)
     1273       :
     1274         assign
     1275           v-object-handle = v-field-group-handle :first-child
     1276         .
     1277         do while valid-handle(v-object-handle)
     1278         :
     1279           if  v-object-handle <> v-diasize-browse-handle :handle
     1280           and can-query(v-object-handle, "row")
     1281           and can-query(v-object-handle, "height")
     1282           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1283           then do:
     1284             find first buf_temp-browse-handle
     1285               where buf_temp-browse-handle.browse-type   = 'height':u
     1286                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1287               no-error .
     1288             if available buf_temp-browse-handle
     1289             then do:
     1290             end.
     1291             else do:
     1292               create buf_temp-diasize-handle .
     1293               assign
     1294                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1295                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1296               .
     1297             end.
     1298           end.
     1299           assign
     1300             v-object-handle = v-object-handle :next-sibling
     1301           .
     1302         end.
     1303         assign
     1304           v-field-group-handle = v-field-group-handle :next-sibling
     1305         .
     1306       end.
     1307       do with frame Dialog-Frame
     1308       :
     1309         hide v-diasize-resize-button .
     1310         assign
     1311           v-diasize-resize-button :row    = 1
     1312           v-diasize-resize-button :column = 1
     1313         .
     1314       end.
     1315       if p-change-value > 0
     1316       then do:
     1317         if frame Dialog-Frame :scrollable = true
     1318         then do:
     1319           assign
     1320             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1321             no-error .
     1322           if error-status :error
     1323           or error-status :get-message(1) <> ""
     1324           then do:
     1325             undo move_block, retry move_block .
     1326           end.
     1327         end.
     1328         assign
     1329           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1330           no-error .
     1331         if error-status :error
     1332         or error-status :get-message(1) <> ""
     1333         then do:
     1334           undo move_block, retry move_block .
     1335         end.
     1336         assign
     1337           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1338           no-error .
     1339         if error-status :error
     1340         or error-status :get-message(1) <> ""
     1341         then do:
     1342           undo move_block, retry move_block .
     1343         end.
     1344         for each buf_temp-browse-handle
     1345           where buf_temp-browse-handle.browse-type = 'height':u
     1346         on error undo move_block, retry move_block
     1347         :
     1348           assign
     1349             buf_temp-browse-handle.browse-handle :height
     1350               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1351             no-error .
     1352           if error-status :error
     1353           or error-status :get-message(1) <> ""
     1354           then do:
     1355             undo move_block, retry move_block .
     1356           end.
     1357         end.
     1358         for each buf_temp-diasize-handle
     1359         on error undo move_block, retry move_block
     1360         :
     1361           assign
     1362             v-object-handle = buf_temp-diasize-handle.handle-value
     1363           .
     1364           if v-object-handle <> v-diasize-resize-button
     1365           then do:
     1366             assign
     1367               v-object-handle :row = v-object-handle :row + p-change-value
     1368               no-error .
     1369             if error-status :error
     1370             or error-status :get-message(1) <> ""
     1371             then do:
     1372               undo move_block, retry move_block .
     1373             end.
     1374           end.
     1375         end.
     1376       end.
     1377       else do:
     1378         for each buf_temp-diasize-handle
     1379         on error undo move_block, retry move_block
     1380         :
     1381           assign
     1382             v-object-handle = buf_temp-diasize-handle.handle-value
     1383           .
     1384           if v-object-handle <> v-diasize-resize-button
     1385           then do:
     1386             assign
     1387               v-object-handle :row = v-object-handle :row + p-change-value
     1388               no-error .
     1389             if error-status :error
     1390             or error-status :get-message(1) <> ""
     1391             then do:
     1392               undo move_block, retry move_block .
     1393             end.
     1394           end.
     1395         end.
     1396         assign
     1397           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1398           no-error .
     1399         if error-status :error
     1400         or error-status :get-message(1) <> ""
     1401         then do:
     1402           undo move_block, retry move_block .
     1403         end.
     1404         for each buf_temp-browse-handle
     1405           where buf_temp-browse-handle.browse-type = 'height':u
     1406         on error undo move_block, retry move_block
     1407         :
     1408           assign
     1409             buf_temp-browse-handle.browse-handle :height
     1410               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1411             no-error .
     1412           if error-status :error
     1413           or error-status :get-message(1) <> ""
     1414           then do:
     1415             undo move_block, retry move_block .
     1416           end.
     1417         end.
     1418         assign
     1419           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1420           no-error .
     1421         if error-status :error
     1422         or error-status :get-message(1) <> ""
     1423         then do:
     1424           undo move_block, retry move_block .
     1425         end.
     1426         if frame Dialog-Frame :scrollable = true
     1427         then do:
     1428           assign
     1429             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1430             no-error .
     1431           if error-status :error
     1432           or error-status :get-message(1) <> ""
     1433           then do:
     1434             undo move_block, retry move_block .
     1435           end.
     1436         end.
     1437       end.
     1438       if p-move-resize = true
     1439       then do:
     1440         run diasize_position-resize-button in this-procedure .
     1441       end.
     1442       if v-diasize-wndstore = true
     1443       then do:
     1444         if connected("ub") = true
     1445         then do:
     1446           define variable v-cntxt-db-num        as integer   no-undo .
     1447           define variable v-cntxt-userid        as character no-undo .
     1448           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1449                                             , OUTPUT v-cntxt-userid
     1450                                             ) .
     1451           run gbl/wndsizew.p
     1452             (input  v-cntxt-db-num
     1453             ,input  v-cntxt-userid
     1454             ,input  v-diasize-proc-name
     1455             ,input  'height':u
     1456             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1457             ) .
     1458         end.
     1459       end.
     1460     end.
     1461     assign
     1462       v-diasize-change-size = false
     1463     .
     1464   end procedure.
     1465   procedure diasize_set-height :
     1466     define input  parameter p-new-height  as decimal   no-undo .
     1467     define input  parameter p-move-resize as logical   no-undo .
     1468     do
     1469     on error undo, return error return-value
     1470     :
     1471       run diasize_change-height in this-procedure
     1472         (input  (p-new-height - frame Dialog-Frame :height)
     1473         ,input  p-move-resize
     1474         ) .
     1475     end.
     1476   end procedure.
     1477   procedure diasize_change-width :
     1478     define input  parameter p-change-value as decimal   no-undo .
     1479     define input  parameter p-move-resize  as logical   no-undo .
     1480     define variable v-field-group-handle   as handle    no-undo .
     1481     define variable v-object-handle        as handle    no-undo .
     1482     define variable v-frame-width          as decimal   no-undo .
     1483     define variable v-frame-virtual-width  as decimal   no-undo .
     1484     define variable v-browse-width         as decimal   no-undo .
     1485     define variable v-window-width         as decimal   no-undo .
     1486     define variable v-window-virtual-width as decimal   no-undo .
     1487     define variable v-change-sign          as integer   no-undo .
     1488     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1489     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1490     if p-change-value > 0
     1491     then do:
     1492       if frame Dialog-Frame :width + p-change-value >
     1493           session :width-chars
     1494       then do:
     1495         assign
     1496           p-change-value = session :width-chars - frame Dialog-Frame :width
     1497         .
     1498         if p-change-value <= 0
     1499         then do:
     1500           run diasize_position-resize-button in this-procedure .
     1501           return .
     1502         end.
     1503       end.
     1504     end.
     1505     if p-change-value < 0
     1506     then do:
     1507       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1508       then do:
     1509         assign
     1510           p-change-value = v-diasize-orig-frame-width
     1511                          - frame Dialog-Frame :width
     1512         .
     1513         if p-change-value >= 0
     1514         then do:
     1515           run diasize_position-resize-button in this-procedure .
     1516           return .
     1517         end.
     1518       end.
     1519     end.
     1520     if p-change-value >= 0
     1521     then do:
     1522       assign
     1523         v-change-sign = 1
     1524       .
     1525     end.
     1526     else do:
     1527       assign
     1528         v-change-sign = -1
     1529       .
     1530     end.
     1531     assign
     1532       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1533     .
     1534     if p-change-value = 0
     1535     then do:
     1536       run diasize_position-resize-button in this-procedure .
     1537       return .
     1538     end.
     1539     move_block:
     1540     do
     1541     on error undo move_block, leave move_block
     1542     :
     1543       if retry
     1544       then do:
     1545         do
     1546         on error undo move_block, leave move_block
     1547         :
     1548           if p-change-value > 0
     1549           then do:
     1550             for each buf_temp-diasize-handle
     1551             on error undo, next
     1552             :
     1553               assign
     1554                 v-object-handle = buf_temp-diasize-handle.handle-value
     1555               .
     1556               if v-object-handle <> v-diasize-resize-button
     1557               then do:
     1558                 assign
     1559                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1560                 .
     1561               end.
     1562             end.
     1563             assign
     1564               v-diasize-browse-handle :width = v-browse-width
     1565             .
     1566             for each buf_temp-browse-handle
     1567               where buf_temp-browse-handle.browse-type = 'width':u
     1568             on error undo, next
     1569             :
     1570               assign
     1571                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1572               .
     1573             end.
     1574             assign
     1575               frame Dialog-Frame :width = v-frame-width
     1576             .
     1577             if frame Dialog-Frame :scrollable = true
     1578             then do:
     1579               assign
     1580                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1581               .
     1582             end.
     1583             run diasize_position-resize-button in this-procedure .
     1584           end.
     1585           else do:
     1586             if frame Dialog-Frame :scrollable = true
     1587             then do:
     1588               assign
     1589                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1590               .
     1591             end.
     1592             assign
     1593               frame Dialog-Frame :width = v-frame-width
     1594             .
     1595             for each buf_temp-browse-handle
     1596               where buf_temp-browse-handle.browse-type = 'width':u
     1597             on error undo, next
     1598             :
     1599               assign
     1600                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1601               .
     1602             end.
     1603             assign
     1604               v-diasize-browse-handle :width = v-browse-width
     1605             .
     1606             for each buf_temp-diasize-handle
     1607             on error undo, next
     1608             :
     1609               assign
     1610                 v-object-handle = buf_temp-diasize-handle.handle-value
     1611               .
     1612               if v-object-handle <> v-diasize-resize-button
     1613               then do:
     1614                 assign
     1615                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1616                 .
     1617               end.
     1618             end.
     1619             run diasize_position-resize-button in this-procedure .
     1620           end.
     1621           assign
     1622             v-diasize-change-size = false
     1623           .
     1624           leave move_block .
     1625         end.
     1626       end.
     1627       assign
     1628         v-diasize-need-full-display = true
     1629       .
     1630       if v-diasize-change-size = false
     1631       then do:
     1632         assign
     1633           v-diasize-change-size = true
     1634         .
     1635       end.
     1636       else do:
     1637         return .
     1638       end.
     1639       assign
     1640         v-frame-width = frame Dialog-Frame :width
     1641         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1642         v-browse-width = v-diasize-browse-handle :width
     1643       .
     1644       for each buf_temp-browse-handle
     1645         where buf_temp-browse-handle.browse-type = 'width':u
     1646       :
     1647         assign
     1648           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1649         .
     1650       end.
     1651       for each buf_temp-diasize-handle
     1652       :
     1653         delete buf_temp-diasize-handle .
     1654       end.
     1655       assign
     1656         v-field-group-handle = frame Dialog-Frame :first-child
     1657       .
     1658       do while valid-handle(v-field-group-handle)
     1659       :
     1660         assign
     1661           v-object-handle = v-field-group-handle :first-child
     1662         .
     1663         do while valid-handle(v-object-handle)
     1664         :
     1665           if  v-object-handle <> v-diasize-browse-handle :handle
     1666           and v-object-handle <> v-diasize-resize-button
     1667           and can-query(v-object-handle, "row")
     1668           and can-query(v-object-handle, "height")
     1669           and ( v-object-handle :col + v-object-handle :width
     1670                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1671               )
     1672           then do:
     1673             find first buf_temp-browse-handle
     1674               where buf_temp-browse-handle.browse-type   = 'width':u
     1675                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1676               no-error .
     1677             if available buf_temp-browse-handle
     1678             then do:
     1679             end.
     1680             else do:
     1681               create buf_temp-diasize-handle .
     1682               assign
     1683                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1684                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1685               .
     1686             end.
     1687           end.
     1688           assign
     1689             v-object-handle = v-object-handle :next-sibling
     1690           .
     1691         end.
     1692         assign
     1693           v-field-group-handle = v-field-group-handle :next-sibling
     1694         .
     1695       end.
     1696       do with frame Dialog-Frame
     1697       :
     1698         hide v-diasize-resize-button .
     1699         v-diasize-resize-button :row = 1.
     1700         v-diasize-resize-button :column = 1.
     1701       end.
     1702       if p-change-value > 0
     1703       then do:
     1704         if frame Dialog-Frame :scrollable = true
     1705         then do:
     1706           assign
     1707             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1708             no-error .
     1709           if error-status :error
     1710           or error-status :get-message(1) <> ""
     1711           then do:
     1712             undo move_block, retry move_block.
     1713           end.
     1714         end.
     1715         assign
     1716           frame Dialog-Frame :width = v-frame-width + p-change-value
     1717           no-error .
     1718         if error-status :error
     1719         or error-status :get-message(1) <> ""
     1720         then do:
     1721           undo move_block, retry move_block.
     1722         end.
     1723         assign
     1724           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1725         no-error .
     1726         if error-status :error
     1727         or error-status :get-message(1) <> ""
     1728         then do:
     1729           undo move_block, retry move_block.
     1730         end.
     1731         for each buf_temp-browse-handle
     1732           where buf_temp-browse-handle.browse-type = 'width':u
     1733         on error undo move_block, retry move_block
     1734         :
     1735           assign
     1736             buf_temp-browse-handle.browse-handle :width
     1737               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1738             no-error .
     1739           if error-status :error
     1740           or error-status :get-message(1) <> ""
     1741           then do:
     1742             undo move_block, retry move_block .
     1743           end.
     1744         end.
     1745         for each buf_temp-diasize-handle
     1746         on error undo move_block, retry move_block
     1747         :
     1748           assign
     1749             v-object-handle = buf_temp-diasize-handle.handle-value
     1750           .
     1751           if v-object-handle <> v-diasize-resize-button
     1752           then do:
     1753             assign
     1754               v-object-handle :col = v-object-handle :col + p-change-value
     1755               no-error .
     1756             if error-status :error
     1757             or error-status :get-message(1) <> ""
     1758             then do:
     1759               undo move_block, retry move_block .
     1760             end.
     1761           end.
     1762         end.
     1763       end.
     1764       else do:
     1765         for each buf_temp-diasize-handle
     1766         on error undo move_block, retry move_block
     1767         :
     1768           assign
     1769             v-object-handle = buf_temp-diasize-handle.handle-value
     1770           .
     1771           if v-object-handle <> v-diasize-resize-button
     1772           then do:
     1773             assign
     1774               v-object-handle :col = v-object-handle :col + p-change-value
     1775               no-error .
     1776             if error-status :error
     1777             or error-status :get-message(1) <> ""
     1778             then do:
     1779               undo move_block, retry move_block .
     1780             end.
     1781           end.
     1782         end.
     1783         for each buf_temp-browse-handle
     1784           where buf_temp-browse-handle.browse-type = 'width':u
     1785         on error undo move_block, retry move_block
     1786         :
     1787           assign
     1788             buf_temp-browse-handle.browse-handle :width
     1789               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1790             no-error .
     1791           if error-status :error
     1792           or error-status :get-message(1) <> ""
     1793           then do:
     1794             undo move_block, retry move_block .
     1795           end.
     1796         end.
     1797         assign
     1798           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1799           no-error .
     1800         if error-status :error
     1801         or error-status :get-message(1) <> ""
     1802         then do:
     1803           undo move_block, retry move_block.
     1804         end.
     1805         assign
     1806           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1807         no-error .
     1808         if error-status :error
     1809         or error-status :get-message(1) <> ""
     1810         then do:
     1811           undo move_block, retry move_block.
     1812         end.
     1813         if frame Dialog-Frame :scrollable = true
     1814         then do:
     1815           assign
     1816             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1817           no-error .
     1818           if error-status :error
     1819           or error-status :get-message(1) <> ""
     1820           then do:
     1821             undo move_block, retry move_block.
     1822           end.
     1823         end.
     1824       end.
     1825       if p-move-resize
     1826       then do:
     1827         run diasize_position-resize-button in this-procedure .
     1828       end.
     1829       if v-diasize-wndstore = true
     1830       then do:
     1831         if connected("ub") = true
     1832         then do:
     1833           define variable v-cntxt-db-num        as integer   no-undo .
     1834           define variable v-cntxt-userid        as character no-undo .
     1835           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1836                                             , OUTPUT v-cntxt-userid
     1837                                             ) .
     1838           run gbl/wndsizew.p
     1839             (input  v-cntxt-db-num
     1840             ,input  v-cntxt-userid
     1841             ,input  v-diasize-proc-name
     1842             ,input  'width':u
     1843             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1844             ) .
     1845         end.
     1846       end.
     1847     end.
     1848     assign
     1849       v-diasize-change-size = false
     1850     .
     1851   end procedure.
     1852   procedure diasize_set-width :
     1853     define input  parameter p-new-width  as decimal   no-undo .
     1854     define input  parameter p-move-resize as logical   no-undo .
     1855     do
     1856     on error undo, return error return-value
     1857     :
     1858       run diasize_change-width in this-procedure
     1859         (input  (p-new-width - frame Dialog-Frame :width)
     1860         ,input  p-move-resize
     1861         ) .
     1862     end.
     1863   end procedure.
     1864   procedure diasize_position-resize-button :
     1865     do with frame Dialog-Frame
     1866     :
     1867       hide v-diasize-resize-button .
     1868       assign
     1869         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1870                     - 1
     1871                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1872         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1873                     - 1
     1874                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1875       .
     1876       view v-diasize-resize-button .
     1877     end.
     1878   end procedure.
     1879   on alt-right anywhere
     1880   do:
     1881     run diasize_change-width in this-procedure
     1882       (input 1
     1883       ,input true
     1884       ) .
     1885     return no-apply .
     1886   end.
     1887   on alt-left anywhere
     1888   do:
     1889     run diasize_change-width in this-procedure
     1890       (input -1
     1891       ,input true
     1892       ) .
     1893     return no-apply .
     1894   end.
     1895   on alt-down anywhere
     1896   do:
     1897     run diasize_change-height in this-procedure
     1898       (input 1
     1899       ,input true
     1900       ) .
     1901     return no-apply .
     1902   end.
     1903   on alt-up anywhere
     1904   do:
     1905     run diasize_change-height in this-procedure
     1906       (input -1
     1907       ,input true
     1908       ) .
     1909     return no-apply .
     1910   end.
     1911   on alt-enter of frame Dialog-Frame
     1912   do:
     1913     run diasize_maximize in this-procedure
     1914       (input  ?
     1915       ).
     1916     return no-apply .
     1917   end.
     1918   procedure diasize_end-move :
     1919     do
     1920     on error undo, return error return-value
     1921     :
     1922       define variable v-row-delta as decimal   no-undo .
     1923       define variable v-col-delta as decimal   no-undo .
     1924       define variable v-new-row as decimal   no-undo .
     1925       define variable v-new-col as decimal   no-undo .
     1926       assign
     1927         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1928         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1929       .
     1930       assign
     1931         v-row-delta = v-new-row - frame Dialog-Frame :height
     1932         v-col-delta = v-new-col - frame Dialog-Frame :width
     1933       .
     1934       run diasize_change-height in this-procedure
     1935         (input v-row-delta
     1936         ,input true
     1937         ) .
     1938       run diasize_change-width in this-procedure
     1939         (input v-col-delta
     1940         ,input true
     1941         ) .
     1942     end.
     1943   end procedure.
     1944   procedure diasize_maximize :
     1945     define input  parameter p-action as logical   no-undo .
     1946     do
     1947     on error undo, return error return-value
     1948     :
     1949       if p-action = ?
     1950       then do:
     1951         if v-diasize-need-maximize = true
     1952         then do:
     1953           assign
     1954             p-action = true
     1955           .
     1956         end.
     1957         else do:
     1958           assign
     1959             p-action = false
     1960           .
     1961         end.
     1962       end.
     1963       if p-action = true
     1964       then do:
     1965         run diasize_change-height in this-procedure
     1966           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1967               - frame Dialog-Frame :height-chars
     1968           ,input true
     1969           ) .
     1970         run diasize_change-width in this-procedure
     1971           (input session :width-chars
     1972               - frame Dialog-Frame :width-chars
     1973           ,input true
     1974           ) .
     1975         assign
     1976           v-diasize-need-maximize = false
     1977         .
     1978       end.
     1979       else do:
     1980         run diasize_change-width in this-procedure
     1981           (input v-diasize-orig-frame-width
     1982               - frame Dialog-Frame :width-chars
     1983           ,input true
     1984           ) .
     1985         run diasize_change-height in this-procedure
     1986           (input v-diasize-orig-frame-height
     1987               - frame Dialog-Frame :height-chars
     1988           ,input true
     1989           ) .
     1990         assign
     1991           v-diasize-need-maximize = true
     1992         .
     1993       end.
     1994     end.
     1995   end procedure.
     1996   procedure diasize_restore-orig-size :
     1997     do
     1998     on error undo, return error return-value
     1999     :
     2000       assign
     2001         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2002         v-diasize-current-frame-height = frame Dialog-Frame :height
     2003       .
     2004       run diasize_set-height in this-procedure
     2005         (input  v-diasize-orig-frame-height
     2006         ,input  true
     2007         ) .
     2008       run diasize_set-width in this-procedure
     2009         (input  v-diasize-orig-frame-width
     2010         ,input  true
     2011         ) .
     2012     end.
     2013   end procedure.
     2014   procedure diasize_restore-current-size :
     2015     do
     2016     on error undo, return error return-value
     2017     :
     2018       run diasize_set-height in this-procedure
     2019         (input  v-diasize-current-frame-height
     2020         ,input  true
     2021         ) .
     2022       run diasize_set-width in this-procedure
     2023         (input  v-diasize-current-frame-width
     2024         ,input  true
     2025         ) .
     2026     end.
     2027   end procedure.
     2028   procedure diasize_set-browse-handle :
     2029     define input  parameter p-browse-handle as handle   no-undo .
     2030     define buffer buf_temp-browse-handle for temp-browse-handle .
     2031     do
     2032     on error undo, return error return-value
     2033     :
     2034       assign
     2035         v-diasize-browse-handle = p-browse-handle
     2036       .
     2037       for each buf_temp-browse-handle
     2038       on error undo, return error return-value
     2039       :
     2040         delete buf_temp-browse-handle .
     2041       end.
     2042     end.
     2043   end procedure.
     2044   procedure diasize_add_browse :
     2045     define input  parameter p-browse-type   as character no-undo .
     2046     define input  parameter p-browse-handle as handle    no-undo .
     2047     define buffer buf_temp-browse-handle for temp-browse-handle .
     2048     do
     2049     on error undo, return error return-value
     2050     :
     2051       assign
     2052         v-diasize-browse-number = v-diasize-browse-number + 1
     2053       .
     2054       create buf_temp-browse-handle .
     2055       assign
     2056         buf_temp-browse-handle.browse-type   = p-browse-type
     2057         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2058         buf_temp-browse-handle.browse-handle = p-browse-handle
     2059       .
     2060     end.
     2061   end procedure.
     2062   procedure diasize_init :
     2063     define variable v-default-value    as logical   no-undo .
     2064     define variable v-restore-saved    as logical   no-undo .
     2065     define variable v-resize-value-str as character no-undo .
     2066     do
     2067     on error undo, return error return-value
     2068     :
     2069       do with frame Dialog-Frame
     2070       :
     2071         assign
     2072           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2073           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2074           v-diasize-browse-handle     = browse br-prop-script :handle
     2075         .
     2076         create button v-diasize-resize-button
     2077         assign
     2078           parent        = frame Dialog-Frame :first-child
     2079           label         = "s"
     2080           height-pixels = 16
     2081           width-pixels  = 16
     2082           visible       = true
     2083           sensitive     = true
     2084           movable       = true
     2085           triggers:
     2086             on end-move persistent run diasize_end-move in this-procedure .
     2087           end triggers.
     2088         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2089         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2090         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2091         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2092         assign
     2093           v-diasize-wndmax = false
     2094         .
     2095         if connected("ub") = true
     2096         then do:
     2097           define variable v-cntxt-db-num        as integer   no-undo .
     2098           define variable v-cntxt-userid        as character no-undo .
     2099           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2100                                             , OUTPUT v-cntxt-userid
     2101                                             ) .
     2102           run gbl/wndpar_r.p
     2103             (input  v-cntxt-db-num
     2104             ,input  v-cntxt-userid
     2105             ,input  'wndmax':U
     2106             ,output v-diasize-wndmax
     2107             ,output v-default-value
     2108             ) .
     2109         end.
     2110         assign
     2111           v-diasize-wndstore = false
     2112         .
     2113         if connected("ub") = true
     2114         then do:
     2115           run gbl/wndpar_r.p
     2116             (input  v-cntxt-db-num
     2117             ,input  v-cntxt-userid
     2118             ,input  'wndstore':U
     2119             ,output v-diasize-wndstore
     2120             ,output v-default-value
     2121             ) .
     2122         end.
     2123         assign
     2124           v-diasize-proc-name = entry(1, program-name(2), '.')
     2125         .
     2126         if v-diasize-wndstore = true
     2127         then do:
     2128           assign
     2129             v-restore-saved = false
     2130           .
     2131           if connected("ub") = true
     2132           then do:
     2133             run gbl/wndsizer.p
     2134               (input  v-cntxt-db-num
     2135               ,input  v-cntxt-userid
     2136               ,input  v-diasize-proc-name
     2137               ,input  'height':u
     2138               ,output v-resize-value-str
     2139               ) .
     2140             if v-resize-value-str <> '':U
     2141             then do:
     2142               run diasize_change-height in this-procedure
     2143                 (input  integer(v-resize-value-str)
     2144                 ,input  true
     2145                 ) .
     2146               assign
     2147                 v-restore-saved = true
     2148               .
     2149             end.
     2150           end.
     2151           if connected("ub") = true
     2152           then do:
     2153             run gbl/wndsizer.p
     2154               (input  v-cntxt-db-num
     2155               ,input  v-cntxt-userid
     2156               ,input  v-diasize-proc-name
     2157               ,input  'width':u
     2158               ,output v-resize-value-str
     2159               ) .
     2160             if v-resize-value-str <> '':U
     2161             then do:
     2162               run diasize_change-width in this-procedure
     2163                 (input  integer(v-resize-value-str)
     2164                 ,input  true
     2165                 ) .
     2166               assign
     2167                 v-restore-saved = true
     2168               .
     2169             end.
     2170           end.
     2171           if v-restore-saved <> true
     2172           then do:
     2173             if v-diasize-wndmax = true
     2174             then do:
     2175               run diasize_maximize in this-procedure
     2176                 (input  true
     2177                 ) .
     2178             end.
     2179           end.
     2180         end.
     2181         else do:
     2182           if v-diasize-wndmax = true
     2183           then do:
     2184             run diasize_maximize in this-procedure
     2185               (input  true
     2186               ) .
     2187           end.
     2188         end.
     2189       end.
     2190     end.
     2191   end procedure.
     2192   procedure diasize_need-full-display :
     2193     define output parameter p-need-full-display as logical   no-undo .
     2194     do
     2195     on error undo, return error return-value
     2196     :
     2197       assign
     2198         p-need-full-display = v-diasize-need-full-display
     2199       .
     2200       assign
     2201         v-diasize-need-full-display = false
     2202       .
     2203     end.
     2204   end procedure.
     2205   procedure get-context :
     2206      define output parameter p-db-num as integer          no-undo.
     2207      define output parameter p-user-id as character        no-undo.
     2208      define variable v-login               as character    no-undo.
     2209      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2210      define buffer buf_user-login  for ub.user-login .
     2211      do
     2212      on error undo, return error
     2213      :
     2214            FIND FIRST buf_sys-ctrl no-lock.
     2215            ASSIGN
     2216               v-login = USERID("ub")
     2217               p-db-num = buf_sys-ctrl.db-num
     2218            .
     2219            FIND FIRST buf_user-login
     2220                 WHERE buf_user-login.db-num = p-db-num
     2221                   AND buf_user-login.user-login = v-login
     2222                 no-lock
     2223                 no-error
     2224                 .
     2225            IF AVAILABLE buf_user-login
     2226            THEN DO:
     2227               assign
     2228                  p-user-id = buf_user-login.user-id
     2229               .
     2230            END.
     2231      end.
     2232   end procedure.
     2233       run diasize_init in this-procedure .
     2234   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2235   procedure set-filter-name :
     2236   define input parameter p-filter-name as character no-undo .
     2237     do with frame Dialog-Frame:
     2238       if p-filter-name > "" then do:
     2239         assign
     2240           frame Dialog-Frame:title
     2241             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     2242         .
     2243         assign
     2244           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     2245         .
     2246       end.
     2247       else do:
     2248         assign
     2249           b-sch :tooltip = ""
     2250         .
     2251       end.
     2252     end.
     2253   end procedure.
     2254   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2255   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2256   MAIN-BLOCK:
     2257   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2258      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2259   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2260     run mainmenu_getcntxt in parparentproc
     2261       (output v-cntxt-db-num
     2262       ,output v-cntxt-userid
     2263       ,output v-cntxt-level
     2264       ,output v-cntxt-host-code-obj
     2265       ,output v-cntxt-obj-type
     2266       ,output v-cntxt-obj-code
     2267       ,output v-cntxt-db-num-obj
     2268       ,output v-cntxt-is-admin
     2269       ) .
     2270     v-rid-list = p-rid-list.
     2271     RUN Myenable in this-procedure .
     2272     WAIT-FOR GO OF FRAME Dialog-Frame.
     2273   END.
     2274   RUN disable_UI.
     2275   PROCEDURE disable_UI :
     2276     HIDE FRAME Dialog-Frame.
     2277   END PROCEDURE.
     2278   PROCEDURE enable_UI :
     2279     DISPLAY rs-language cb-prop-head rs-find f-script-name mark-num
     2280         WITH FRAME Dialog-Frame.
     2281     ENABLE b-quit b-mark b-sel b-add b-chg b-del b-lkp b-link b-sch B-Help
     2282            rs-language b-copy cb-prop-head rs-find f-script-name br-prop-script
     2283            mark-num
     2284         WITH FRAME Dialog-Frame.
     2285     VIEW FRAME Dialog-Frame.
     2286     OPEN QUERY br-prop-script FOR EACH X_prop-script NO-LOCK.
     2287   END PROCEDURE.
     2288   PROCEDURE MyEnable :
     2289   DEFINE VARIABLE v-dtm-label AS CHARACTER NO-UNDO.
     2290   DEFINE VARIABLE v-h AS handle NO-UNDO.
     2291   DEFINE BUFFER buf_prop-ruleset FOR ub.prop-ruleset.
     2292   DEFINE BUFFER buf_prop-head FOR ub.prop-head.
     2293   assign
     2294   cb-prop-head:DELIMITER in FRAME Dialog-Frame = "|"
     2295   cb-prop-head:list-item-pairs =  " |-1"
     2296   X_prop-script.script-name:resizable in browse br-prop-script = yes
     2297   X_prop-script.script-type:resizable in browse br-prop-script = yes
     2298   X_prop-script.proc-type:resizable in browse br-prop-script = yes
     2299   b-link:MENU-MOUSE IN FRAME Dialog-Frame = 1
     2300   v-h = br-prop-script:FIRST-COLUMN IN FRAME Dialog-Frame
     2301   rs-language:RADIO-BUTTONS IN FRAME Dialog-Frame = "ABL" + chr(44) + "ABL" + chr(44) +
     2302                                                    "rus" + chr(44) + "rus"
     2303   rs-find = "begins"
     2304   .
     2305   DO while valid-handle(v-h) :
     2306     if v-h:LABEL = "Перевод" then do:
     2307       v-h:RESIZABLE = YES.
     2308       leave.
     2309     end.
     2310     ELSE DO:
     2311       v-h = v-h:NEXT-COLUMN.
     2312     END.
     2313   END.
     2314   if not (p-list-mode = "dtm-code") then do:
     2315     _prop-ruleset:
     2316     FOR EACH buf_prop-ruleset NO-LOCK WHERE
     2317    BREAK BY buf_prop-ruleset.dtm-code:
     2318       IF first-of(buf_prop-ruleset.dtm-CODE) THEN DO:
     2319         FIND FIRST buf_prop-head NO-LOCK WHERE
     2320                     buf_prop-head.dtm-code = buf_prop-ruleset.dtm-code NO-ERROR.
     2321         IF NOT AVAILABLE buf_prop-head THEN DO:
     2322             NEXT _prop-ruleset.
     2323         END.
     2324         v-dtm-label = replace(buf_prop-head.prop-label, "|", chr(32)).
     2325         cb-prop-head:ADD-LAST(v-dtm-label, string(buf_prop-ruleset.dtm-code)) IN FRAME Dialog-Frame.
     2326       END.
     2327     END.
     2328     ASSIGN
     2329     cb-prop-head = "-1".
     2330   end.
     2331   ENABLE
     2332   b-quit
     2333   b-add WHEN (p-list-mode = "dtm-code" and lookup("b-add", bttns) > 0 and v-cntxt-db-num = 0)
     2334   b-copy when (lookup("b-add", bttns) > 0 and v-cntxt-db-num = 0)
     2335   b-chg when (lookup("b-add", bttns) > 0 and v-cntxt-db-num = 0)
     2336   b-del when (lookup("b-add", bttns) > 0 and v-cntxt-db-num = 0)
     2337   b-lkp
     2338   B-Help
     2339   b-mark when lookup("b-mark", bttns) > 0
     2340   b-sel when lookup("b-sel", bttns) > 0
     2341   b-link
     2342   b-sch
     2343   br-prop-script
     2344   f-script-name
     2345   cb-prop-head when not (p-list-mode = "dtm-code")
     2346   rs-language
     2347   rs-find
     2348   WITH FRAME Dialog-Frame.
     2349   VIEW FRAME Dialog-Frame.
     2350   if (p-list-mode = "dtm-code") then do:
     2351     hide
     2352     cb-prop-head
     2353     in frame Dialog-Frame .
     2354   end.
     2355   RUN Openbr IN THIS-PROCEDURE ( input yes, input no, input '':U).
     2356   END PROCEDURE.
     2357   PROCEDURE Openbr :
     2358   define input  parameter p-open-query     as logical   no-undo .
     2359   define input  parameter p-find-next      as logical   no-undo .
     2360   define input  parameter p-find-condition as character no-undo .
     2361   define variable l-query-was-opened as logical no-undo .
     2362   run waitfram-show in this-procedure ("Ждите...").
     2363   define variable sort-column-phrase as character no-undo .
     2364   case sort-column-name :
     2365     when "" then do:
     2366       assign
     2367         sort-column-phrase = ""
     2368       .
     2369     end.
     2370     otherwise do:
     2371       assign
     2372         sort-column-phrase = "by " + sort-column-name
     2373       .
     2374     end.
     2375   end case.
     2376   define variable l-open-query as logical   no-undo .
     2377   filter-point = filter-point0 + p-list-mode.
     2378   CASE p-list-mode :
     2379     WHEN 'все':U        THEN DO:
     2380       if cb-prop-head = string(-1 ) then do:
     2381         assign filter-point-label = substitute("Все скрипты")
     2382         .
     2383         if p-open-query then do:
     2384           assign
     2385           frame Dialog-Frame:title = filter-point-label
     2386           .
     2387         end.
     2388         IF p-word-script-name = '':U  THEN DO:
     2389   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2390   define variable  l-disable-where-16  as logical   no-undo .
     2391   define variable  l-filter-open-16    as logical   .
     2392   define variable  flt-rec-16       as recid     no-undo .
     2393   define variable  filter-name-16      as character no-undo .
     2394   define variable  where-phrase-16     as character no-undo .
     2395   define variable  sort-phrase-16      as character no-undo .
     2396   define variable  where-phrase-rus-16 as character no-undo .
     2397   define variable  sort-phrase-rus-16  as character no-undo .
     2398     run waitfram-show in this-procedure
     2399       (input "ЖДИТЕ ..."
     2400       ).
     2401   run gbl/flt-get.p
     2402     (input filter-point
     2403     ,output flt-rec-16
     2404     ,output filter-name-16
     2405     ,output where-phrase-16
     2406     ,output sort-phrase-16
     2407     ,output where-phrase-rus-16
     2408     ,output sort-phrase-rus-16
     2409     ).
     2410   if p-open-query then do:
     2411       run set-filter-name in this-procedure
     2412         (INPUT filter-name-16
     2413         ) no-error .
     2414     assign
     2415       l-filter-open-16 = false
     2416     .
     2417     if flt-rec-16 <> ?
     2418       or sort-column-phrase > ""
     2419     then do:
     2420       define variable  parameter-2-16 as character no-undo .
     2421       define variable  parameter-3-16 as character no-undo .
     2422       define variable  parameter-4-16 as character no-undo .
     2423       define variable  parameter-5-16 as character no-undo .
     2424       define variable  parameter-6-16 as character no-undo .
     2425       define variable  parameter-7-16 as character no-undo .
     2426         assign
     2427         parameter-3-16 =
     2428                                 "FOR EACH X_prop-script"
     2429         parameter-4-16 =
     2430           (
     2431             if (" true  " + " " + where-phrase-16) <> ""
     2432             then " true  " + " " + where-phrase-16
     2433             else "true"
     2434           )
     2435         parameter-5-16 = (" " + "" + " " + "")
     2436         parameter-6-16 = if sort-phrase-16 = ''
     2437                              then
     2438           (
     2439           " " + "  " +
     2440             " " + sort-column-phrase +
     2441           " " + "  "
     2442           )
     2443                              else
     2444           (
     2445           " " + "  " +
     2446             " " + sort-column-phrase +
     2447           " " + sort-phrase-16
     2448           )
     2449         parameter-7-16 =
     2450           " indexed-reposition  "
     2451       .
     2452       do
     2453       on stop undo, leave
     2454       on error undo, leave
     2455       :
     2456         assign
     2457           l-disable-where-16 =
     2458             (" true  " + " " + where-phrase-16 = "")
     2459         .
     2460         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     2461                             ,input QUERY br-prop-script:handle
     2462                             ,input parameter-3-16
     2463                             ,input parameter-4-16
     2464                             ,input parameter-5-16
     2465                             ,input parameter-6-16
     2466                             ,input parameter-7-16
     2467                             )
     2468         .
     2469         assign
     2470           l-filter-open-16 = true
     2471         .
     2472       end.
     2473       if l-filter-open-16 = false then do:
     2474         message
     2475           "Ошибка при фильтрации / сортировке" skip
     2476           "Будут показаны записи без учета фильтра" skip
     2477           view-as alert-box .
     2478       end.
     2479       else do:
     2480           assign
     2481             l-query-was-opened = true
     2482           .
     2483       end.
     2484     end.
     2485     if l-filter-open-16 = false then do:
     2486       OPEN QUERY br-prop-script FOR EACH X_prop-script
     2487         where  true
     2488         indexed-reposition
     2489     .
     2490         assign
     2491           l-query-was-opened = true
     2492         .
     2493     end.
     2494   end.
     2495   else do:
     2496     assign
     2497       v-doc-rec = recid( X_prop-script )
     2498     .
     2499     do
     2500     on stop undo, leave
     2501     on error undo, leave
     2502     :
     2503       if QUERY br-prop-script:handle:get-buffer-handle(1) = (buffer X_prop-script:handle) then do:
     2504         assign
     2505         parameter-2-16 = (if p-find-next then "true":u else "false":u )
     2506         parameter-4-16 =
     2507           "where ":u + " true  " + " ":u + where-phrase-16 + " ":u + p-find-condition + " " + ""
     2508         parameter-5-16 = "  "
     2509       .
     2510         run fltopend_fltfindd in this-procedure  (
     2511                             input this-procedure:handle
     2512                             ,input QUERY br-prop-script:handle
     2513                             ,input rowid(X_prop-script)
     2514                             ,input logical(parameter-2-16)
     2515                             ,input no-lock
     2516                             ,input (buffer X_prop-script:handle)
     2517                             ,input parameter-4-16
     2518                             ,input parameter-5-16
     2519                             ) no-error.
     2520         .
     2521         assign
     2522           v-doc-rec = integer(return-value)
     2523           v-fltopend-rowid[1] = ?
     2524         .
     2525       end.
     2526       else do:
     2527         assign
     2528         parameter-2-16 = (if p-find-next then "true":u else "false":u )
     2529         parameter-3-16 =  "FOR EACH X_prop-script"
     2530         parameter-4-16 =
     2531           (
     2532             if (" true  " + " " + where-phrase-16) <> ""
     2533             then " true  " + " " + where-phrase-16
     2534             else "true"
     2535           )
     2536         parameter-5-16 = (" " + "" + " " + "" + " " + p-find-condition)
     2537         parameter-6-16 = if sort-phrase-16 = ''
     2538                              then
     2539           (
     2540           " " + "  " +
     2541             " " + sort-column-phrase +
     2542           " " + "  "
     2543           )
     2544                              else
     2545           (
     2546           " " + "  " +
     2547             " " + sort-column-phrase +
     2548           " " + sort-phrase-16
     2549           )
     2550         parameter-7-16 =
     2551           " indexed-reposition  "
     2552       .
     2553         run fltopend_fltfindq in this-procedure  (
     2554                             input this-procedure:handle
     2555                             ,input QUERY br-prop-script:handle
     2556                             ,input logical(parameter-2-16)
     2557                             ,input no-lock
     2558                             ,input parameter-3-16
     2559                             ,input parameter-4-16
     2560                             ,input parameter-5-16
     2561                             ,input parameter-6-16
     2562                             ,input parameter-7-16
     2563                             ,output v-fltopend-rowid
     2564                             ) no-error.
     2565         .
     2566         v-doc-rec = ?.
     2567       end.
     2568       assign
     2569         l-query-was-opened = true
     2570       .
     2571     end.
     2572   end.
     2573     run waitfram-hide in this-procedure .
     2574         END.
     2575         ELSE DO:
     2576   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2577   define variable  l-disable-where-18  as logical   no-undo .
