     2596     ).
     2597   if p-open-query then do:
     2598       run set-filter-name in this-procedure
     2599         (INPUT filter-name-18
     2600         ) no-error .
     2601     assign
     2602       l-filter-open-18 = false
     2603     .
     2604     if flt-rec-18 <> ?
     2605       or sort-column-phrase > ""
     2606     then do:
     2607       define variable  parameter-2-18 as character no-undo .
     2608       define variable  parameter-3-18 as character no-undo .
     2609       define variable  parameter-4-18 as character no-undo .
     2610       define variable  parameter-5-18 as character no-undo .
     2611       define variable  parameter-6-18 as character no-undo .
     2612       define variable  parameter-7-18 as character no-undo .
     2613         assign
     2614         parameter-3-18 =
     2615                                 "FOR EACH X_prop-script"
     2616         parameter-4-18 =
     2617           (
     2618             if (" X_prop-script.script-name contains p-word-script-name " + " " + where-phrase-18) <> ""
     2619             then  substitute('X_prop-script.script-name contains &1&2&1', chr(34), p-word-script-name ) + " " + where-phrase-18
     2620             else "true"
     2621           )
     2622         parameter-5-18 = (" " + "" + " " + "")
     2623         parameter-6-18 = if sort-phrase-18 = ''
     2624                              then
     2625           (
     2626           " " + "  " +
     2627             " " + sort-column-phrase +
