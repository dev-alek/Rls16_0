     2770         end.
     2771         IF p-word-script-name = '':U  THEN DO:
     2772   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2773   define variable  l-disable-where-20  as logical   no-undo .
     2774   define variable  l-filter-open-20    as logical   .
