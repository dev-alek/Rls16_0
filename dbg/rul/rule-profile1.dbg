        1   block-level on error undo, throw.
        2   define input parameter        p-mode as character no-undo .
        3   define input parameter        p-silent as logical no-undo .
        4   define input-output parameter p-rec  as recid     no-undo .
        5   define input parameter        p-profile-id as integer no-undo .
        6   define input parameter        p-profile-type as character no-undo .
        7   define input parameter        p-name       as character no-undo .
        8   define input parameter        p-is_dynamic as logical no-undo .
        9   define input parameter        p-documentation as character no-undo .
       10   define input parameter        p-param-code as character no-undo .
       11   define input parameter        p-param-value as character no-undo .
       12   define input parameter        p-short-name as character no-undo .
       13   define input parameter        p-action-head-code as integer no-undo .
       14   define input parameter        p-action-item-id as character no-undo .
       15   define input parameter        p-action-item-context as character no-undo .
       16   define input parameter        p-custom-param-form as integer no-undo .
       17   define input parameter        p-reusable-params as character no-undo .
       18   define input parameter        p-parent-feature as integer no-undo .
       19   define temp-table tt-ruledict-param no-undo like ub.ruledict-param.
       20   DEFINE INPUT PARAMETER TABLE FOR tt-ruledict-param.
       21   define variable vss-revision    as character no-undo init "$Revision$":U .
       22   define variable vss-author      as character no-undo init "$Author$":U .
       23   define variable vss-date        as character no-undo init "$Date$":U .
       24   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       25   define variable vss-archive     as character no-undo init "$Archive$":U .
       26   define variable vss-description as character no-undo init "Сохранение rule-profile".
       27   procedure vss-get-info :
       28     define output parameter p-vss-revision    like vss-revision    no-undo .
       29     define output parameter p-vss-author      like vss-author      no-undo .
       30     define output parameter p-vss-date        like vss-date        no-undo .
       31     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       32     define output parameter p-vss-archive     like vss-archive     no-undo .
       33     define output parameter p-vss-description like vss-description no-undo .
       34     assign
       35       p-vss-revision    = vss-revision
       36       p-vss-author      = vss-author
       37       p-vss-date        = vss-date
       38       p-vss-workfile    = vss-workfile
       39       p-vss-archive     = vss-archive
       40       p-vss-description = vss-description
       41     .
       42   end procedure.
       43   procedure vss-get-parameters :
       44     define output parameter p-vss-parameters as character no-undo .
       45   end procedure.
       46   define new global shared variable g#vssrevis-logger as handle    no-undo .
       47   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       48   define variable v-vssrevis-logger                   as handle    no-undo .
       49   procedure vss-logevent :
       50     define input  parameter p-extra-paramters as character no-undo .
       51     define variable v-vssrevis-parameters as character no-undo .
       52     do
       53     on error undo, return error return-value
       54     :
       55       if  valid-handle(v-vssrevis-logger)
       56       and v-vssrevis-logger :get-signature("logevent") <> ""
       57       then do:
       58         run vss-get-parameters in this-procedure
       59           (output v-vssrevis-parameters
       60           ).
       61         run logevent in v-vssrevis-logger
       62           (input vss-workfile
       63           ,input vss-revision
       64           ,input v-vssrevis-parameters
       65           ,input p-extra-paramters
       66           ).
       67       end.
       68     end.
       69   end procedure.
       70   assign
       71     v-vssrevis-logger = g#vssrevis-logger
       72   .
       73   if  valid-handle(v-vssrevis-logger)
       74   and v-vssrevis-logger :get-signature("logevent") <> ""
       75   then do:
       76     assign
       77       v-vssrevis-logevent = true
       78     .
       79     run vss-logevent in this-procedure (input vss-description) .
       80   end.
       81   define new global shared variable g#language as character no-undo .
       82   if g#language <> '' and g#language <> 'rus':U then do:
       83     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       84   end.
       85   define new global shared variable g#library  as handle no-undo .
       86   define new global shared variable g#library2 as handle no-undo .
       87   define   shared variable g#auto as logical no-undo.
       88   define   shared variable g#news as logical no-undo.
       89   define   shared variable g#oxml as logical no-undo.
       90   define   shared variable g#esys as logical no-undo.
       91   define   shared variable g#news-source-db as integer no-undo.
       92   define   shared variable g#esys-source-esys as integer no-undo.
       93   define   shared variable g#db-num as integer   no-undo .
       94   define   shared variable g#userid as character no-undo .
       95   define   shared variable g#passwd as character no-undo .
       96   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       97   procedure gen-key-rec :
       98     define input  parameter p-tbl-name    as character no-undo.
       99     define input  parameter p-bh_tbl-name as handle    no-undo.
      100     define output parameter p-key-rec     as character no-undo.
      101     do
      102     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      103     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      104     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      105     :
      106       define variable fh               as handle    no-undo .
      107       define variable v-ok             as logical   no-undo .
      108       define variable v-inform         as character no-undo .
      109       define variable v-ind            as integer   no-undo .
      110       define variable v-idx-field-qnty as integer   no-undo .
      111       if p-tbl-name = ?
      112         or p-tbl-name = "":U
      113       then do:
      114         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info0 ).
      115       end.
      116       if not p-bh_tbl-name:available then do:
      117         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info0, p-tbl-name ).
      118       end.
      119       assign
      120         p-key-rec = p-tbl-name
      121         v-inform  = p-bh_tbl-name:index-information(1)
      122         v-ind     = 2
      123       .
      124       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      125       on error undo, return error
      126       :
      127         assign
      128           v-inform = p-bh_tbl-name:index-information( v-ind )
      129           v-ind    = v-ind + 1
      130         .
      131       end.
      132       if v-inform = ?
      133         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      134         or entry( 3, v-inform, ",":U ) <> "1":U
      135       then do:
      136         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, p-tbl-name ).
      137       end.
      138       else do:
      139         assign
      140           v-idx-field-qnty = num-entries( v-inform ) - 4
      141         .
      142         if v-idx-field-qnty < 2 then do:
      143           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, p-tbl-name ).
      144         end.
      145         do v-ind = 1 to v-idx-field-qnty by 2
      146         on error undo, return error
      147         :
      148           assign
      149             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      150             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      151           .
      152         end.
      153       end.
      154       if p-key-rec = ? then do:
      155         assign
      156           p-key-rec = "":U
      157         .
      158         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info0, p-tbl-name ).
      159       end.
      160     end.
      161     return.
      162   end procedure.
      163   procedure gen-where-keyr-tab :
      164     define input  parameter i-tableSerach as character no-undo.
      165     define input  parameter i-tablekey   as character  no-undo.
      166     define input  parameter p-key-rec    as character  no-undo.
      167     define input  parameter p-key-handle as handle     no-undo .
      168     define input  parameter p-db-name    as character  no-undo .
      169     define input  parameter p-tt-handle  as handle     no-undo .
      170     define output parameter o-Where      as character  no-undo.
      171     do
      172     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      173     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      174     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      175     :
      176       define variable v-full-tbl-name  as character no-undo .
      177       define variable bh_tbl-name      as handle    no-undo .
      178       define variable fh_key           as handle    no-undo .
      179       define variable fh_search        as handle    no-undo .
      180       define variable v-field-num      as integer   no-undo .
      181       define variable v-count-fld      as integer   no-undo .
      182       define variable v-inform         as character no-undo .
      183       define variable v-ind            as integer   no-undo .
      184       define variable v-idx-field-qnty as integer   no-undo .
      185       define variable v-field-name     as character no-undo .
      186       define variable v-field-val      as character no-undo .
      187       define variable v-word-link      as character no-undo .
      188       define variable vTable           as character no-undo.
      189       define variable bh_tbl-key       as handle    no-undo .
      190       assign
      191         p-key-rec = trim( p-key-rec )
      192       .
      193       if p-key-handle <> ? then do:
      194         if not valid-handle(p-key-handle)
      195            or p-key-handle:type <> "buffer"
      196         then do:
      197           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info0 ).
      198         end.
      199         if num-entries( p-key-rec, chr(3) ) > 1
      200           or p-key-rec = ?
      201           or p-key-rec = "":U
      202         then do:
      203           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info0, p-key-rec ).
      204         end.
      205       end.
      206       else do:
      207         if p-key-rec = ?
      208           or p-key-rec = "":U
      209         then do:
      210           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info0 ).
      211         end.
      212       end.
      213       assign
      214         vTable = entry( 1 , p-key-rec, chr(3) )
      215       .
      216       if p-tt-handle <> ?
      217         and ( not valid-handle(p-tt-handle)
      218               or p-tt-handle:type <> "buffer"
      219             )
      220       then do:
      221         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info0, vTable, chr(10) ).
      222       end.
      223       if p-tt-handle = ? then do:
      224         assign
      225           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      226         .
      227         create buffer bh_tbl-name for table v-full-tbl-name .
      228       end.
      229       else do:
      230         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      231       end.
      232       assign
      233         v-inform = bh_tbl-name:index-information(1)
      234         v-ind    = 2
      235       .
      236       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      237       on error undo, return error
      238       :
      239         assign
      240           v-inform = bh_tbl-name:index-information( v-ind )
      241           v-ind    = v-ind + 1
      242         .
      243       end.
      244       if v-inform = ?
      245         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      246         or entry( 3, v-inform, ",":U ) <> "1":U
      247       then do:
      248         delete object bh_tbl-name no-error.
      249         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info0, vTable ).
      250       end.
      251       assign
      252         v-idx-field-qnty = num-entries( v-inform ) - 4
      253       .
      254       if v-idx-field-qnty < 2 then do:
      255         delete object bh_tbl-name no-error.
      256         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, vTable ).
      257       end.
      258       assign
      259         o-where     = "where":U
      260         v-word-link = "":U
      261         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      262         v-count-fld = 0
      263       .
      264       if i-tablekey ne "" and i-tablekey ne ?
      265       then do:
      266         assign
      267           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      268         .
      269         create buffer bh_tbl-key for table v-full-tbl-name .
      270       end.
      271       if i-tableSerach ne "" and i-tableSerach ne ?
      272       then do:
      273         delete object bh_tbl-name no-error.
      274         assign
      275           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      276         .
      277         create buffer bh_tbl-name for table v-full-tbl-name .
      278       end.
      279       block_where:
      280       do v-ind = 1 to v-idx-field-qnty by 2
      281       on error undo, return error
      282       :
      283         assign
      284           v-count-fld = v-count-fld + 1
      285         .
      286         if p-key-handle = ?
      287           and v-count-fld > v-field-num
      288         then do:
      289           leave block_where.
      290         end.
      291         define variable VfieldKeyTable as handle no-undo.
      292         assign
      293           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      294           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      295         .
      296         if     bh_tbl-key ne ?
      297         then do:
      298            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      299            if VfieldKeyTable eq ?
      300            then next block_where.
      301         end.
      302         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      303         then
      304            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      305         else
      306            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      307         if p-key-handle = ? then do:
      308           assign
      309             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      310           .
      311         end.
      312         else do:
      313           assign
      314             fh_key = p-key-handle:buffer-field( v-field-name )
      315           .
      316           if fh_key = ?
      317             or not valid-handle( fh_key )
      318           then do:
      319             delete object bh_tbl-name.
      320             if     bh_tbl-key ne ?
      321             then
      322                delete object bh_tbl-key.
      323             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info0, p-key-handle:name, v-field-name ).
      324           end.
      325           assign
      326             v-field-val = fh_key:buffer-value
      327           .
      328         end.
      329         if fh_search:data-type ="character":U then do:
      330           assign
      331             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      332             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      333             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      334             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      335             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      336             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      337             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      338             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      339             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      340             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      341             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      342             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      343             v-field-val = substitute( '"&1"', v-field-val )
      344           .
      345         end.
      346         assign
      347           o-where = substitute( "&1 &2", o-where, v-field-val )
      348         .
      349         if v-word-link = "":U then do:
      350           assign
      351             v-word-link = "and":U
      352           .
      353         end.
      354       end.
      355       delete object bh_tbl-name.
      356       if     bh_tbl-key ne ?
      357       then
      358          delete object bh_tbl-key.
      359       if p-key-handle = ?
      360         and v-count-fld <> v-field-num
      361       then do:
      362         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info0, vTable ).
      363       end.
      364     end.
      365   end procedure.
      366   procedure gen-hn-keyr-tab :
      367     define input  parameter i-tableSerach as character no-undo.
      368     define input  parameter i-tablekey   as character no-undo.
      369     define input  parameter p-key-rec    as character no-undo.
      370     define input  parameter p-key-handle as handle    no-undo .
      371     define input  parameter p-db-name    as character no-undo .
      372     define input  parameter p-tt-handle  as handle    no-undo .
      373     define input  parameter p-stts-lock  as integer   no-undo .
      374     define output parameter o-hn         as handle    no-undo.
      375     define variable v-full-tbl-name as character no-undo.
      376     define variable v-where         as character no-undo.
      377     define variable bh_tbl-name     as handle    no-undo.
      378     define variable vTable          as character no-undo.
      379     do
      380     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      381     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      382     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      383         run gen-where-keyr-tab(i-tableSerach,
      384                                i-tablekey,
      385                                p-key-rec,
      386                                p-key-handle,
      387                                p-db-name,
      388                                p-tt-handle,
      389                                output v-where).
      390         if i-tableSerach ne "" and i-tableSerach ne ?
      391         then do:
      392            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      393            create buffer bh_tbl-name for table v-full-tbl-name .
      394         end.
      395         else do:
      396            if p-tt-handle = ? then do:
      397               assign
      398                  vTable = entry( 1 , p-key-rec, chr(3) )
      399               .
      400               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      401               create buffer bh_tbl-name for table v-full-tbl-name .
      402            end.
      403            else do:
      404               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      405            end.
      406         end.
      407         if p-tt-handle = ? then do:
      408            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      409         end.
      410         else do:
      411            bh_tbl-name:find-first( v-where ) no-error .
      412         end.
      413         o-hn = bh_tbl-name.
      414      end.
      415   end procedure.
      416   procedure gen-hn-keyr :
      417     define input  parameter p-key-rec    as character no-undo.
      418     define input  parameter p-key-handle as handle    no-undo .
      419     define input  parameter p-db-name    as character no-undo .
      420     define input  parameter p-tt-handle  as handle    no-undo .
      421     define input  parameter p-stts-lock  as integer   no-undo .
      422     define output parameter o-hn         as handle    no-undo.
      423     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      424   end.
      425   procedure gen-row-keyr :
      426     define input  parameter p-key-rec    as character no-undo.
      427     define input  parameter p-key-handle as handle    no-undo .
      428     define input  parameter p-db-name    as character no-undo .
      429     define input  parameter p-tt-handle  as handle    no-undo .
      430     define input  parameter p-stts-lock  as integer   no-undo .
      431     define output parameter p-tbl-row    as rowid     no-undo.
      432     define output parameter p-tbl-name   as character no-undo.
      433     define variable vHn as handle no-undo.
      434       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      435       p-tbl-row = if vHn:available then vHn:rowid else ?.
      436       p-tbl-name =  vHn:table.
      437       delete object vHn no-error.
      438     if p-tbl-row = ? then do:
      439       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info0, p-tbl-name, p-key-rec ).
      440     end.
      441     else do:
      442       return.
      443     end.
      444   end procedure.
      445   procedure gen-key-fv :
      446     define input  parameter p-key-rec    as character no-undo .
      447     define output parameter p-field-list as character no-undo .
      448     define output parameter p-value-list as character no-undo.
      449     do
      450     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      451     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      452     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      453     :
      454       define variable v-full-tbl-name  as character no-undo .
      455       define variable bh_tbl-name      as handle    no-undo .
      456       define variable v-tbl-name       as character no-undo .
      457       define variable v-field-num      as integer   no-undo .
      458       define variable v-count-fld      as integer   no-undo .
      459       define variable v-inform         as character no-undo .
      460       define variable v-ind            as integer   no-undo .
      461       define variable v-idx-field-qnty as integer   no-undo .
      462       define variable v-delim-key      as character no-undo .
      463       if p-key-rec = ?
      464         or p-key-rec = "":U
      465       then do:
      466         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info0 ).
      467       end.
      468       assign
      469         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      470         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      471       .
      472       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      473       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info0 ).
      474       assign
      475         v-inform = bh_tbl-name:index-information(1)
      476         v-ind    = 2
      477       .
      478       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      479       on error undo, return error
      480       :
      481         assign
      482           v-inform = bh_tbl-name:index-information( v-ind )
      483           v-ind    = v-ind + 1
      484         .
      485       end.
      486       if v-inform = ?
      487         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      488         or entry( 3, v-inform, ",":U ) <> "1":U
      489       then do:
      490         delete object bh_tbl-name no-error.
      491         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, v-tbl-name ).
      492       end.
      493       assign
      494         v-idx-field-qnty = num-entries( v-inform ) - 4
      495       .
      496       if v-idx-field-qnty < 2 then do:
      497         delete object bh_tbl-name no-error.
      498         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, v-tbl-name ).
      499       end.
      500       assign
      501         p-field-list = "":U
      502         p-value-list = "":U
      503         v-delim-key  = "":U
      504         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      505         v-count-fld  = 0
      506       .
      507       block_where:
      508       do v-ind = 1 to v-idx-field-qnty by 2
      509       on error undo, return error
      510       :
      511         assign
      512           v-count-fld = v-count-fld + 1
      513         .
      514         if v-count-fld > v-field-num then do:
      515           leave block_where.
      516         end.
      517         assign
      518           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      519           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      520         .
      521         if v-ind = 1 then do:
      522           assign
      523             v-delim-key = chr(3)
      524           .
      525         end.
      526       end.
      527       delete object bh_tbl-name.
      528       if v-count-fld <> v-field-num then do:
      529         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info0, v-tbl-name ).
      530       end.
      531     end.
      532   end procedure.
      533   procedure gen-key-field :
      534     define input  parameter p-table      as character no-undo .
      535     define output parameter p-field-list as character no-undo .
      536     do
      537     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      538     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      539     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      540     :
      541       define variable v-full-tbl-name  as character no-undo .
      542       define variable bh_tbl-name      as handle    no-undo .
      543       define variable v-tbl-name       as character no-undo .
      544       define variable v-field-num      as integer   no-undo .
      545       define variable v-count-fld      as integer   no-undo .
      546       define variable v-inform         as character no-undo .
      547       define variable v-ind            as integer   no-undo .
      548       define variable v-idx-field-qnty as integer   no-undo .
      549       define variable v-delim-key      as character no-undo .
      550       if p-table = ?
      551         or p-table = "":U
      552       then do:
      553         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info0 ).
      554       end.
      555       assign
      556         v-tbl-name      = p-table
      557         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      558       .
      559       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      560       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info0 ).
      561       assign
      562         v-inform = bh_tbl-name:index-information(1)
      563         v-ind    = 2
      564       .
      565       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      566       on error undo, return error
      567       :
      568         assign
      569           v-inform = bh_tbl-name:index-information( v-ind )
      570           v-ind    = v-ind + 1
      571         .
      572       end.
      573       if v-inform = ?
      574         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      575         or entry( 3, v-inform, ",":U ) <> "1":U
      576       then do:
      577         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, v-tbl-name ).
      578       end.
      579       assign
      580         v-idx-field-qnty = num-entries( v-inform ) - 4
      581       .
      582       if v-idx-field-qnty < 2 then do:
      583         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, v-tbl-name ).
      584       end.
      585       assign
      586         p-field-list = "":U
      587         v-delim-key  = "":U
      588         v-count-fld  = 0
      589       .
      590       block_where:
      591       do v-ind = 1 to v-idx-field-qnty by 2
      592       on error undo, return error
      593       :
      594         assign
      595           v-count-fld = v-count-fld + 1
      596         .
      597         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      598         if v-ind = 1 then do:
      599           assign
      600             v-delim-key = chr(3)
      601           .
      602         end.
      603       end.
      604       delete object bh_tbl-name.
      605     end.
      606   end procedure.
      607   define variable v-mess as character no-undo .
      608   define variable v-entry as character no-undo .
      609   define variable v-uniq-key-rec as character no-undo .
      610   define variable v-entry-id as integer no-undo .
      611   define buffer buf_rule-profile for ub.rule-profile.
      612   define buffer buf_rule-by-profile for ub.rule-by-profile.
      613   define buffer buf_ruledict for ub.ruledict.
      614   define buffer last_ruledict for ub.ruledict.
      615   define buffer buf_ruledict-param for ub.ruledict-param.
      616   define buffer buf_tt-ruledict-param for tt-ruledict-param.
      617   if p-mode <> 'ДОБАВЛЕНИЕ':U
      618   AND p-mode <> 'ИЗМЕНЕНИЕ':U then do:
      619     message vss-workfile vss-revision vss-description skip
      620             "Неверный параметр p-mode - " p-mode
      621     view-as alert-box error .
      622     return error '':u.
      623   end.
      624   if g#db-num <> 0 then do:
      625     message vss-workfile vss-revision vss-description skip
      626             "Запрещено вызывать процедуру в УБД"
      627     view-as alert-box error .
      628     return error '':u.
      629   end.
      630   _main:
      631   do for buf_rule-profile
      632   on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      633   on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
      634   on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
      635   :
      636     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      637       find first buf_rule-profile no-lock where
      638                buf_rule-profile.profile_id = p-profile-id no-error.
      639       if available buf_rule-profile then do:
      640         assign
      641         v-mess = "Уже существует профайл c таким id".
      642         run err-mess in this-procedure ( input-output v-mess).
      643         return error (if p-silent = yes then v-mess else '':U).
      644       end.
      645       if lookup( p-profile-type, 'dis-card-type,goods,clients,gds-grp,cli-grp,chk-doc_IBS-TH,chk-doc_IBS-TH-MOB,edoc,thref,pdf,rep,ord,cmb,fdoc':U) = 0 then do:
      646         assign
      647         v-mess = substitute("Неверный тип профайла &1", p-profile-type).
      648         run err-mess in this-procedure ( input-output v-mess).
      649         return error (if p-silent = yes then v-mess else '':U).
      650       end.
      651       create buf_rule-profile.
      652       assign
      653       buf_rule-profile.profile_id = p-profile-id
      654       buf_rule-profile.profile-type = p-profile-type
      655       .
      656       run gen-key-rec in this-procedure ( input 'rule-profile':U
      657                                           ,input buffer buf_rule-profile:handle
      658                                           ,output v-uniq-key-rec).
      659       find first buf_ruledict where
      660                 buf_ruledict.entry-type = 'rule-profile':U
      661             and buf_ruledict.uniq-key-rec =  v-uniq-key-rec no-error.
      662       if not available buf_ruledict then do:
      663         find last last_ruledict no-lock use-index pi.
      664         create buf_ruledict.
      665         assign
      666         buf_ruledict.entry-type = 'rule-profile':U
      667         buf_ruledict.uniq-key-rec = v-uniq-key-rec
      668         buf_ruledict.entry-id = last_ruledict.entry-id + 1
      669         buf_ruledict.language = "ABL"
      670         .
      671       end.
      672       assign
      673       buf_ruledict.script-al = string(buf_rule-profile.profile_id, "999999999":U)
      674       buf_ruledict.script-nl = buf_rule-profile.name
      675       v-entry-id = buf_ruledict.entry-id
      676       .
      677     end.
      678     if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      679       find first buf_rule-profile exclusive-lock where
      680                 recid(buf_rule-profile) = p-rec .
      681       if buf_rule-profile.profile_id <> p-profile-id
      682       then do:
      683         assign
      684         v-mess = substitute("Для уже существующего профайла невозможно изменение id&1" +
      685                                 "старое значение id: &2"
      686                                 , chr(10)
      687                                 , buf_rule-profile.profile_id)
      688         .
      689         run err-mess in this-procedure ( input-output v-mess).
      690         return error (if p-silent = yes then v-mess else '':U).
      691       end.
      692       if buf_rule-profile.profile-type <> p-profile-type then do:
      693         find first buf_rule-by-profile no-lock where
      694                   buf_rule-by-profile.profile_id = buf_rule-profile.profile_id no-error.
      695         if available buf_rule-by-profile then do:
      696         assign
      697         v-mess = substitute("Для уже существующего профайла невозможно изменение типа,&1" +
      698                                 "если имеется привязанное правило:&1" +
      699                                 "старое значение типа &2"
      700                                 , chr(10)
      701                                 , buf_rule-profile.profile-type
      702                                 )
      703         .
      704         run err-mess in this-procedure ( input-output v-mess).
      705         return error (if p-silent = yes then v-mess else '':U).
      706         end.
      707       end.
      708       run gen-key-rec in this-procedure ( input 'rule-profile':U
      709                                           ,input buffer buf_rule-profile:handle
      710                                           ,output v-uniq-key-rec).
      711       find first buf_ruledict where
      712                 buf_ruledict.entry-type = 'rule-profile':U
      713             and buf_ruledict.uniq-key-rec =  v-uniq-key-rec no-error.
      714       IF NOT AVAILABLE BUF_RULEDICT THEN DO:
      715         assign
      716         v-mess = substitute("Не найден термин в словаре для профайла").
      717         run err-mess in this-procedure ( input-output v-mess).
      718         return error (if p-silent = yes then v-mess else '':U).
      719       END.
      720       v-entry-id = buf_ruledict.entry-id.
      721       if buf_rule-profile.parent-feature = integer('0':U)
      722       and p-parent-feature = integer('1':U)
      723       and can-find (first ub.rp-by-call no-lock where
      724                         ub.rp-by-call.parent-profile_id = 0
      725                     and ub.rp-by-call.profile_id = p-profile-id)
      726       then do:
      727         assign
      728         v-mess = substitute("Нельзя поменять СОЧЕТАЕМОСТЬ - у профайла есть привязки").
      729         run err-mess in this-procedure ( input-output v-mess).
      730         return error (if p-silent = yes then v-mess else '':U).
      731       end.
      732     end.
      733     if lookup(string(p-parent-feature), '0,1':U) = 0 then do:
      734       assign
      735       v-mess = substitute("Неверное значение СОЧЕТАЕМОСТИ для профайла").
      736       run err-mess in this-procedure ( input-output v-mess).
      737       return error (if p-silent = yes then v-mess else '':U).
      738     end.
      739     assign
      740     buf_rule-profile.name = p-name
      741     buf_rule-profile.is_dynamic = p-is_dynamic
      742     buf_rule-profile.profile-type = p-profile-type
      743     buf_rule-profile.documentation = p-documentation
      744     buf_rule-profile.param-code = p-param-code
      745     buf_rule-profile.param-value = p-param-value
      746     buf_rule-profile.short-name = p-short-name
      747     buf_rule-profile.action-head-code  = action-head-code
      748     buf_rule-profile.action-item-id = p-action-item-id
      749     buf_rule-profile.action-item-context = p-action-item-context
      750     buf_rule-profile.custom-param-form = p-custom-param-form
      751     buf_rule-profile.reusable-params = p-reusable-params
      752     buf_rule-profile.parent-feature = p-parent-feature
      753     p-rec = recid(buf_rule-profile)
      754     .
      755     for each tt-ruledict-param
      756     on error undo _main, return error  substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      757     :
      758       find first buf_ruledict-param where
      759                 buf_ruledict-param.entry-id = v-entry-id
      760             and buf_ruledict-param.param-num = tt-ruledict-param.param-num
      761               no-error.
      762       if not available buf_ruledict-param then do:
      763         create buf_ruledict-param.
      764       end.
      765       buffer-copy tt-ruledict-param
      766       except entry-id
      767       to buf_ruledict-param
      768       assign
      769       buf_ruledict-param.entry-id = v-entry-id
      770       tt-ruledict-param.entry-id = v-entry-id
      771       .
      772       if buf_ruledict-param.param-data-type = 'character':U
      773       and buf_ruledict-param.param-2-data-type = "xsd"
      774       then do:
      775          run rul/rdp-clob.p ( buffer buf_ruledict-param
      776                              ,input p-mode) no-error.
      777          if error-status:error then  do:
      778            v-mess = substitute("Не удалось сохранить CLOB &1:&2&3&2&4"
      779                               ,buf_ruledict-param.init-value-character
      780                               ,chr(10)
      781                               , error-status:get-message(1)
      782                               , return-value ).
      783            run err-mess in this-procedure ( input-output v-mess).
      784            return error (if p-silent = yes then v-mess else '':U).
      785          end.
      786       end.
      787     end.
      788     for each buf_ruledict-param where buf_ruledict-param.entry-id = v-entry-id
      789     on error undo _main, return error  substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      790     :
      791       find first tt-ruledict-param where
      792                 tt-ruledict-param.entry-id = buf_ruledict-param.entry-id
      793             and tt-ruledict-param.param-num = buf_ruledict-param.param-num
      794               no-error.
      795       if not available tt-ruledict-param then do:
      796         if buf_ruledict-param.param-data-type = 'character':U
      797         and buf_ruledict-param.param-2-data-type = "xsd"
      798         then do:
      799           find first buf_tt-ruledict-param where
      800                     buf_tt-ruledict-param.param-data-type = 'character':U
      801                 and buf_tt-ruledict-param.param-2-data-type = "xsd"
      802                 and buf_tt-ruledict-param.init-value-character = tt-ruledict-param.init-value-character
      803                 and recid(buf_tt-ruledict-param) = recid(tt-ruledict-param ) no-error.
      804           if not available buf_tt-ruledict-param then do:
      805           run rul/rdp-clob.p ( buffer buf_ruledict-param
      806                               ,input 'удаление':U) no-error.
      807           if error-status:error then do:
      808             v-mess = substitute("Не удалось удалить CLOB &1:&2&3&2&4"
      809                                 ,buf_ruledict-param.init-value-character
      810                                 ,chr(10)
      811                                 , error-status:get-message(1)
      812                                 , return-value ).
      813             run err-mess in this-procedure ( input-output v-mess).
      814             return error (if p-silent = yes then v-mess else '':U).
      815           end.
      816         end.
      817         end.
      818         delete buf_ruledict-param.
      819       end.
      820     end.
      821   end.
      822   PROCEDURE err-mess:
      823     DEFINE INPUT-OUTPUT PARAMETER p-mess as character No-UNDO.
      824     CASE p-silent:
      825       when yes then do:
      826         assign
      827         p-mess = substitute("Профайл: id &1:&2&3"
      828                            , p-profile-id
      829                            , chr(10)
      830                            , p-mess)
      831         .
      832       end.
      833       when no then do:
      834         message
      835         p-mess
      836         view-as alert-box error .
      837       end.
      838     end.
      839   END PROCEDURE.
