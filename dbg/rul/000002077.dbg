     3208     v-edist-mess2 = cr-edist_add-edist-mess( v-edist-mess2, 'ediiterchangeid':U, p-ediinterchangeid).
     3209     run create-edi-state in this-procedure (
     3210       input 'ord-doc-rcv':U
     3211     , input buf_ord-doc-rcv.rcv-code
     3212     , input buf_ord-doc-rcv.cli-type
     3213     , input buf_ord-doc-rcv.cli-code
     3214     , input 'ДОБАВЛЕНИЕ':U
     3215     , input '7':U
     3216     , input (if v-ps <> ''
     3217             then integer('4':U)
     3218             else integer('0':U) )
     3219     , input v-edist-mess
     3220     , input v-edist-mess2
     3221     , input integer('2':U)
     3222     , input-output v-date
     3223     , input-output v-time
     3224     ).
     3225     if v-desadv-DELIVERYNOTENUMBER <> ? AND v-desadv-DELIVERYNOTENUMBER <> "" then do:
     3226       create ord-rcv-attr.
