     3576     end.
     3577   end procedure.
     3578   define buffer buf_temp-cmd for temp-cmd.
     3579   define temp-table temp-rule-call-param no-undo like ub.rule-call-param.
     3580   define buffer buf_temp-rule-call-param for temp-rule-call-param.
     3581   define buffer buf_temp-xml-tables for temp-xml-tables.
     3582   define variable log-file-name                as character      no-undo init "process-edoc.txt".
     3583   define variable v-view-log                   as logical        no-undo .
     3584   define variable v-stop                       as logical        no-undo .
     3585   function 00180008_get-error-message returns character :
     3586   define variable v-ii as integer no-undo .
     3587   define variable v-mess as character no-undo .
     3588   DO v-ii = 1 TO ERROR-STATUS:NUM-MESSAGES:
     3589       v-mess = substitute("&1&2ош &3"
     3590                           ,v-mess
     3591                           ,chr(10)
     3592                           ,ERROR-STATUS:GET-MESSAGE(v-ii)).
     3593   END.
     3594   end function.
     3595     define variable p-xsd-file as character no-undo.
     3596   on delete of this-procedure do:
     3597     run delete-procedure in this-procedure .
     3598   end.
     3599   run load-ruleset-context in this-procedure ( input p-ruleset-id) no-error .
     3600   if error-status:error
     3601   or return-value = "return" then return.
     3602   if not this-procedure:persistent then do:
     3603     run proc-main in this-procedure  no-error .
     3604     if error-status:error then do:
     3605         v-esm = error-status :get-message (1).
     3606         v-es = error-status:error .
     3607         v-rv = return-value .
     3608         run delete-procedure in this-procedure .
     3609               run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute( "&1. &2&3&4", vss-workfile, v-rv, chr(10), v-esm)).                      assign v-view-log = yes.
     3610         undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     3611     end.
     3612     run delete-procedure in this-procedure .
     3613   end.
     3614   procedure proc-main :
     3615   define variable v-ii as integer   no-undo .
     3616   define variable v-mess as character no-undo .
     3617   define variable v-doc-uniq-key-rec as character no-undo .
     3618   define variable v-tbl-row as rowid no-undo .
     3619   define variable v-tbl-name as character no-undo .
     3620   define variable v-trn-code as character no-undo .
     3621   define variable v-dump-ord-int64 as int64 no-undo .
     3622   define variable v-trn-doc as character no-undo .
     3623   define variable v-new-ps as character no-undo .
     3624   define variable v-new-st as integer no-undo .
     3625   define variable v-cli-out-doc as character no-undo .
     3626   define variable v-edist-mess as character no-undo .
     3627   define variable v-cli-type as character no-undo .
     3628   define variable v-cli-code as integer no-undo .
     3629   define variable v-date-status as date no-undo .
     3630   define variable v-time-status as integer no-undo .
     3631   define variable v-transport-cli-type as character no-undo .
     3632   define variable v-transport-cli-code as integer no-undo .
     3633   define variable v-transport-type-code as logical no-undo .
     3634   DEFINE VARIABLE v-today as date no-undo .
     3635   DEFINE VARIABLE v-time as integer no-undo .
     3636   define variable v-crc-pack as character no-undo .
     3637   define buffer buf_clients for ub.clients.
     3638   define buffer buf_ord-doc for ub.ord-doc.
     3639   define buffer buf_ext-classif for ub.ext-classif.
     3640   _desadv:
     3641   do transaction
     3642   on error  undo _desadv, retry _desadv
     3643   on stop   undo _desadv, retry _desadv
     3644   on endkey undo _desadv, retry _desadv
     3645   :
     3646     if retry then do:
     3647       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при импорте поставок по  заказу &1 из ВС &2&3&4"                                 ,v-current-doc-code                                 , v-esys-id                                  , chr(10)                                 , v-mess)).                      assign v-view-log = yes.
     3648       assign
     3649       v-view-log = yes.
     3650       undo _desadv, return error.
     3651     end.
     3652     else do:
     3653   run write-log  in p-log-handle (
     3654                                    input 0
     3655                                  , "&DLine").
     3656     run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute(".............Импорт поставок из ВС")).                      assign v-view-log = yes.
     3657       find first desadv-t.
     3658       num-rec = num-rec + 1.
     3659       find first buf_ord-doc exclusive-lock where
     3660                 buf_ord-doc.doc-code = desadv-t.ordernumber no-error.
     3661       if not available buf_ord-doc then do:
     3662         v-mess =  substitute("Не найден заказ поставщику с номером &1", desadv-t.ordernumber).
     3663         assign v-view-log = yes.
     3664         undo _desadv, retry _desadv.
     3665       end.
     3666       assign
     3667       v-current-doc-code = buf_ord-doc.doc-code
     3668       v-cli-type = buf_ord-doc.cli-type
     3669       v-cli-code = buf_ord-doc.cli-code
     3670       .
     3671       find first head-t where
     3672                 head-t.number = desadv-t.number no-error.
     3673       v-ediinterchangeid = (if available head-t then head-t.EDIINTERCHANGEID else '').
     3674       assign
     3675       glog = status-is-edi ( input yes
     3676                           , input buf_ord-doc.cli-type
     3677                           , input buf_ord-doc.cli-code
     3678                           , input buf_ord-doc.obj-type
     3679                           , input buf_ord-doc.obj-code
     3680                           , output v-dm-edi
     3681                           ) no-error.
     3682       if not glog = yes then do:
     3683         v-mess = substitute("Нет обмена Документами по EXITE-EDI для поставщика &1&2 и &3&4 в БД &5)"
     3684                           , buf_ord-doc.cli-type
     3685                           , buf_ord-doc.cli-code
     3686                           , buf_ord-doc.obj-type
     3687                           , buf_ord-doc.obj-code
     3688                           , g#db-num).
     3689         undo _desadv, retry _desadv.
     3690       end.
     3691       assign
     3692       v-transport-type-code = get-type-code-from-gln ( input head-t.logisticpartner
     3693                                                       , output v-transport-cli-type
     3694                                                       , output v-transport-cli-code
     3695                                                       ) no-error.
     3696       run edocsord_edi-import in this-procedure (
     3697                                               buffer buf_ord-doc
     3698                                             ,input buf_ord-doc.cli-out-doc
     3699                                             ,input desadv-t.number + chr(4) +
     3700                                                     string(desadv-t.date, "99/99/9999") +
     3701                                                     (if v-transport-type-code then (chr(4) + substitute("&1&2", v-transport-cli-type,
     3702                                                                                                                       v-transport-cli-code ))
     3703                                                                             else "" )
     3704                                             ,input integer('7':U)
     3705                                             ,input (if desadv-t.deliverydate = ?
     3706                                                     then buf_ord-doc.ship-date
     3707                                                     else desadv-t.deliverydate)
     3708                                             ,input buf_ord-doc.ps
     3709                                             ,input v-pack-num-chr
     3710                                             ,input v-ediinterchangeid
     3711                                             ,output v-new-ps
     3712                                             ,output v-new-st
     3713                                             ) no-error.
     3714       if error-status:error then do:
     3715         if return-value <> '' then do:
     3716           v-mess = substitute("Ошибка при изменении статуса заказа при приеме данных:&1&2", chr(10), return-value ).
     3717           undo _desadv, retry _desadv.
     3718         end.
     3719       end.
     3720       else do:
     3721         if v-new-st = ? then do:
     3722           define variable v-tmp-file as character no-undo .
     3723           run gbl/_tmpfile.p ( input "mes":U  , input ".txt":U, output v-tmp-file ).
     3724           COPY-LOB  FROM OBJECT cr-edist_full-mess
     3725           TO FILE v-tmp-file NO-ERROR.
     3726           cr-edist_full-mess = ''.
     3727           run send-msg-to-email in parparentproc
     3728               ( input substitute( "ТН БД &1. Ошибка EDI при импорте пакета &2 из ВС &3"
     3729                                   , g#db-num
     3730                                   , v-pack-num-chr
     3731                                   , v-esys-id )
     3732               ,input substitute("Пакет принят без сохранения данных в БД. См. EDI-информацию по заказу &1&2"
     3733                                 , buf_ord-doc.doc-code
     3734                                 , chr(10)
     3735                                 )
     3736               ,input v-tmp-file
     3737               ) no-error .
     3738           os-delete value(v-tmp-file).
     3739         end.
     3740         v-rv = return-value .
     3741         v-edist-mess = ''.
     3742         v-edist-mess = cr-edist_add-edist-mess( v-edist-mess, 'pack-num':U, "->" + v-pack-num-chr ).
     3743         v-edist-mess = cr-edist_add-edist-mess( v-edist-mess, 'ediiterchangeid':U, (if available head-t then head-t.EDIINTERCHANGEID else '') ).
     3744         v-date-status = ?.
     3745         run create-edi-state in this-procedure (
     3746                                                 input 'ord-doc':U
     3747                                               , input buf_ord-doc.doc-code
     3748                                               , input buf_ord-doc.cli-type
     3749                                               , input buf_ord-doc.cli-code
     3750                                               , input 'ИЗМЕНЕНИЕ':U
     3751                                               , input (if v-new-st = ? then -1 else buf_ord-doc.ord-int1)
     3752                                               , input (if v-new-st = ?
     3753                                                        then  integer('4':U)
     3754                                                        else integer('0':U))
     3755                                               , input buf_ord-doc.PS
     3756                                               , input v-edist-mess
     3757                                               , input integer('2':U)
     3758                                               , input-output v-date-status
     3759                                               , input-output v-time-status
     3760                                               ).
     3761         if v-new-st = ? then do:
     3762                   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input v-rv).                      assign v-view-log = yes.
     3763         end.
     3764         _edist:
     3765         for each temp-edi-status
     3766         on error  undo _edist, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3767         on stop   undo _edist, return error substitute( "&1. stop", vss-workfile )
     3768         on endkey undo _edist, return error substitute( "&1. endkey", vss-workfile )
     3769         :
     3770           v-edist-mess = temp-edi-status.mess.
     3771           v-edist-mess = cr-edist_add-edist-mess( v-edist-mess, 'pack-num':U, "->" + v-pack-num-chr ).
     3772           v-edist-mess = cr-edist_add-edist-mess( v-edist-mess, 'ediiterchangeid':U, (if available head-t then head-t.EDIINTERCHANGEID else '') ).
     3773           run create-edi-state in this-procedure (
     3774                                                   input temp-edi-status.tbl-name
     3775                                                 , input (if temp-edi-status.tbl-name = 'ord-line-rcv':U
     3776                                                         then v-new-ps
     3777                                                         else temp-edi-status.doc-code)
     3778                                                 , input temp-edi-status.cli-type
     3779                                                 , input temp-edi-status.cli-code
     3780                                                 , input temp-edi-status.act
     3781                                                 , input (if v-new-st = ? then -1 else buf_ord-doc.ord-int1)
     3782                                                 , input temp-edi-status.err-code
     3783                                                 , input temp-edi-status.des-err
     3784                                                 , input v-edist-mess
     3785                                                 , input integer('2':U)
     3786                                                 , input-output v-date-status
     3787                                                 , input-output v-time-status
     3788                                                 ).
     3789         end.
     3790         if v-new-st <> ? then do:
     3791           run cur-time in this-procedure ( output v-today, output v-time).
     3792           run get-xcnf_create-temp-esys-pck-sent in p-cont-handle (
     3793                                                                     input v-esys-id
     3794                                                                   ,input integer(v-pack-num-chr)
     3795                                                                   ,input v-crc-pack
     3796                                                                   ,input yes
     3797                                                                   ,input 1
     3798                                                                   ,input 1
     3799                                                                   ,input v-today
     3800                                                                   ,input v-time
     3801                                                                   ,input string(v-time, "HH:MM:SS")
     3802                                                                   ) .
     3803           num-rec-ok = num-rec-ok + 1.
     3804         end.
     3805       end.
     3806     end.
     3807     run write-counter in p-log-handle ( input substitute("Прочитано записей: &1, из них удачно: &2", num-rec, num-rec-ok)).
     3808   end.
     3809   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Прочитано записей: &1, из них удачно обработано: &2", num-rec, num-rec-ok)).                      assign v-view-log = yes.
     3810   end procedure.
     3811   procedure load-ruleset-context :
     3812   define input parameter p-ruleset-id as integer no-undo .
     3813   define variable glog as logical no-undo .
     3814   define buffer buf_rule-call-param for ub.rule-call-param.
     3815   define buffer buf_esys-pck-keys for ub.esys-pck-keys.
     3816   define buffer buf_ext-system for ub.ext-system.
     3817     do
     3818     on error undo, return error
     3819     :
     3820    find first buf_rule-call-param no-lock where
     3821   buf_rule-call-param.codex_id = p-codex-id
     3822   and buf_rule-call-param.ruleset_id = p-ruleset-id
     3823   and buf_rule-call-param.call_id = p-call-id
     3824   and buf_rule-call-param.order_id = p-order-id
     3825   and buf_rule-call-param.rule_id = p-rule-id
     3826   and buf_rule-call-param.param-name = "p-xsd-file"
     3827    no-error.
     3828   if available buf_rule-call-param then do:
     3829   assign p-xsd-file = buf_rule-call-param.param-value-character.
     3830   end.
     3831       case p-ruleset-id:
     3832         when 8 then do:
     3833           assign
     3834           v-sign = 1
     3835           v-current-host-code = p-host-code
     3836           v-current-obj-type = p-obj-type
     3837           v-current-obj-code = p-obj-code
     3838           v-current-doc-code = p-doc-code
     3839           v-current-db-num = g#db-num
     3840           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     3841           file-name  = entry(1, p-process-file-name, chr(4))
     3842           v_dataseth = handle(entry(2, p-process-file-name, chr(4)))
     3843           v-xmlh = buffer buf_temp-xml-tables:handle
     3844           v-esys-id = integer(p-doc-code)
     3845           v-pack-num-chr = entry(3, p-process-file-name, chr(4))
     3846           no-error
     3847          .
     3848           find first buf_ext-system no-lock where
     3849                     buf_ext-system.esys-id = v-esys-id
     3850                 and buf_ext-system.db-num = 0 no-error .
     3851           if not available buf_ext-system
     3852           or buf_ext-system.esys-type <> integer('9':U)
     3853           then do:
     3854                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не найдена ВС &1&2пропускаем ..."                                         , v-esys-id                                         , chr(10)                                         )).                      assign v-view-log = yes.
     3855             undo, return error substitute("Не найдена ВС &1&2пропускаем ..."                                         , v-esys-id                                         , chr(10)                                         ).
     3856           end.
     3857           glog = dataset desadv_-t:handle:copy-dataset(v_dataseth
     3858                                              , no
     3859                                              , yes
     3860                                              , no
     3861                                              , ""
     3862                                              , no
     3863                                              ) no-error.
     3864           if error-status:error
     3865           or not glog then do:
     3866                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка копирования импортируемых данных для дальнейшей обработки&1&2"                                         , chr(10)                                         , error-status:get-message(1)                                         )).                      assign v-view-log = yes.
     3867             undo, return error substitute("Ошибка копирования импортируемых данных для дальнейшей обработки&1&2"                                         , chr(10)                                         , error-status:get-message(1)                                         ).
     3868           end.
     3869         end.
     3870         otherwise do:
     3871           undo, return error "Неправильный вызов".
     3872         end.
     3873       end case.
     3874     end.
     3875   end procedure.
     3876   procedure delete-procedure :
     3877     do
     3878     on error undo, return error
     3879     :
     3880         run garbcoll_clear in this-procedure .
     3881     end.
     3882   end procedure.
