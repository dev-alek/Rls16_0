     1680   data-relation r3 for HEAD-t, POSITION-t  relation-fields ( NUMBER, positionnumber, number, positionnumber ) nested
     1681   .
     1682   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1683   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1684   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1685   procedure ordlineattr-value :
     1686     do
     1687     on error undo, return error return-value
     1688     :
     1689       define input  parameter p-doc-code like ub.ord-line-attr.doc-code   no-undo .
     1690       define input  parameter p-gds-code like ub.ord-line-attr.gds-code   no-undo .
     1691       define input  parameter p-code     like ub.ord-line-attr.attr-code  no-undo .
     1692       define output parameter p-value    like ub.ord-line-attr.attr-value no-undo .
     1693       define output parameter p-type     as character no-undo .
     1694       define buffer buf_ord-line-attr for ub.ord-line-attr .
     1695       define variable v-format         as character no-undo .
     1696       define variable v-fillin_width   as integer   no-undo .
     1697       define variable v-fillin_height  as integer   no-undo .
     1698       define variable v-label          as character no-undo .
     1699       define variable v-user-can-edit  as logical   no-undo .
     1700       define variable v-output-display as logical   no-undo .
     1701       define variable v-other          as character no-undo .
     1702       define variable v-proc           as character no-undo .
     1703       define variable v-func           as character no-undo .
     1704       define variable v-sort           as integer   no-undo .
     1705       run ordlineattr-code in this-procedure
     1706         (input  p-code
     1707         ,output p-type
     1708         ,output v-format
     1709         ,output v-fillin_width
     1710         ,output v-fillin_height
     1711         ,output v-label
     1712         ,output v-user-can-edit
     1713         ,output v-output-display
     1714         ,output v-proc
     1715         ,output v-func
     1716         ,output v-sort
     1717         ,output v-other
     1718         ) no-error .
     1719       if error-status :error then do:
     1720         undo, return error return-value .
     1721       end.
     1722       find first buf_ord-line-attr no-lock
     1723         where buf_ord-line-attr.doc-code  = p-doc-code
     1724           and buf_ord-line-attr.gds-code  = p-gds-code
     1725           and buf_ord-line-attr.attr-code = p-code
     1726         no-error .
     1727       if avail buf_ord-line-attr then do:
     1728         assign
     1729           p-value =  buf_ord-line-attr.attr-value
     1730         .
     1731       end.
     1732       else do:
     1733         assign
     1734           p-value = if p-type = 'L':U then "no":U else ""
     1735         .
     1736       end.
     1737     end.
     1738   end procedure.
     1739   procedure ordlineattr-write :
     1740     do
     1741     on error undo, return error return-value
     1742     :
     1743       define input parameter p-doc-code like ub.ord-line-attr.doc-code   no-undo .
     1744       define input parameter p-gds-code like ub.ord-line-attr.gds-code   no-undo .
     1745       define input parameter p-code     like ub.ord-line-attr.attr-code  no-undo .
     1746       define input parameter p-value    like ub.ord-line-attr.attr-value no-undo .
     1747       define buffer buf_ord-line-attr for ub.ord-line-attr .
     1748       define variable v-type           as character no-undo .
     1749       define variable v-format         as character no-undo .
     1750       define variable v-fillin_width   as integer   no-undo .
     1751       define variable v-fillin_height  as integer   no-undo .
     1752       define variable v-label          as character no-undo .
     1753       define variable v-user-can-edit  as logical   no-undo .
     1754       define variable v-output-display as logical   no-undo .
     1755       define variable v-other          as character no-undo .
     1756       define variable v-proc           as character no-undo .
     1757       define variable v-func           as character no-undo .
     1758       define variable v-sort           as integer   no-undo .
     1759       run ordlineattr-code in this-procedure
     1760         (input  p-code
     1761         ,output v-type
     1762         ,output v-format
     1763         ,output v-fillin_width
     1764         ,output v-fillin_height
     1765         ,output v-label
     1766         ,output v-user-can-edit
     1767         ,output v-output-display
     1768         ,output v-proc
     1769         ,output v-func
     1770         ,output v-sort
     1771         ,output v-other
     1772         ) no-error .
     1773       if error-status :error then do:
     1774         message
     1775           vss-workfile vss-revision vss-description skip
     1776           error-status :get-message(1) skip
     1777           return-value skip
     1778           ""
     1779           view-as alert-box error
     1780         .
     1781         undo, return error return-value .
     1782       end.
     1783       find first buf_ord-line-attr exclusive-lock
     1784         where buf_ord-line-attr.doc-code  = p-doc-code
     1785           and buf_ord-line-attr.gds-code  = p-gds-code
     1786           and buf_ord-line-attr.attr-code = p-code
     1787         no-error .
     1788       if not available buf_ord-line-attr then do:
     1789         create buf_ord-line-attr .
     1790         assign
     1791           buf_ord-line-attr.doc-code   = p-doc-code
     1792           buf_ord-line-attr.gds-code   = p-gds-code
     1793           buf_ord-line-attr.attr-code  = p-code
     1794         .
     1795       end.
     1796       assign
     1797         buf_ord-line-attr.attr-value = p-value
     1798       .
     1799   end.
     1800   end procedure.
     1801   procedure ordlineattr-exist :
     1802     do
     1803     on error undo, return error return-value
     1804     :
     1805       define input parameter p-doc-code like ub.ord-line-attr.doc-code   no-undo .
     1806       define input parameter p-gds-code like ub.ord-line-attr.gds-code   no-undo .
     1807       define input parameter p-code     like ub.ord-line-attr.attr-code  no-undo .
     1808       define output parameter p-exist   as logical  no-undo .
     1809       define buffer buf_ord-line-attr for ub.ord-line-attr .
     1810       define variable v-type           as character no-undo .
     1811       define variable v-format         as character no-undo .
     1812       define variable v-fillin_width   as integer   no-undo .
     1813       define variable v-fillin_height  as integer   no-undo .
     1814       define variable v-label          as character no-undo .
     1815       define variable v-user-can-edit  as logical   no-undo .
     1816       define variable v-output-display as logical   no-undo .
     1817       define variable v-other          as character no-undo .
     1818       define variable v-proc           as character no-undo .
     1819       define variable v-func           as character no-undo .
     1820       define variable v-sort           as integer   no-undo .
     1821       run ordlineattr-code in this-procedure
     1822         (input  p-code
     1823         ,output v-type
     1824         ,output v-format
     1825         ,output v-fillin_width
     1826         ,output v-fillin_height
     1827         ,output v-label
     1828         ,output v-user-can-edit
     1829         ,output v-output-display
     1830         ,output v-proc
     1831         ,output v-func
     1832         ,output v-sort
     1833         ,output v-other
     1834         ) no-error .
     1835       if error-status :error then do:
     1836         undo, return error return-value .
     1837       end.
     1838       find first buf_ord-line-attr no-lock
     1839         where buf_ord-line-attr.doc-code  = p-doc-code
     1840           and buf_ord-line-attr.gds-code = p-gds-code
     1841           and buf_ord-line-attr.attr-code = p-code
     1842         no-error .
     1843       if  available buf_ord-line-attr then do:
     1844         p-exist = yes.
     1845       end.
     1846     end.
     1847   end procedure.
     1848   procedure ordlineattr-delete :
     1849     do
     1850     on error undo, return error return-value
     1851     :
     1852       define input parameter p-doc-code like ub.ord-line-attr.doc-code   no-undo .
     1853       define input parameter p-gds-code like ub.ord-line-attr.gds-code   no-undo .
     1854       define input parameter p-code     like ub.ord-line-attr.attr-code  no-undo .
     1855       define output parameter p-deleted  as logical no-undo.
     1856       define buffer buf_ord-line-attr for ub.ord-line-attr .
     1857       define variable v-type           as character no-undo .
     1858       define variable v-format         as character no-undo .
     1859       define variable v-fillin_width   as integer   no-undo .
     1860       define variable v-fillin_height  as integer   no-undo .
     1861       define variable v-label          as character no-undo .
     1862       define variable v-user-can-edit  as logical   no-undo .
     1863       define variable v-output-display as logical   no-undo .
     1864       define variable v-proc           as character no-undo .
     1865       define variable v-func           as character no-undo .
     1866       define variable v-sort           as integer   no-undo .
     1867       define variable v-other          as character no-undo .
     1868       run ordlineattr-code in this-procedure
     1869         (input  p-code
     1870         ,output v-type
     1871         ,output v-format
     1872         ,output v-fillin_width
     1873         ,output v-fillin_height
     1874         ,output v-label
     1875         ,output v-user-can-edit
     1876         ,output v-output-display
     1877         ,output v-proc
     1878         ,output v-func
     1879         ,output v-sort
     1880         ,output v-other
     1881         ) no-error .
     1882       if error-status :error then do:
     1883         undo, return error return-value .
     1884       end.
     1885       find first buf_ord-line-attr exclusive-lock
     1886         where buf_ord-line-attr.doc-code  = p-doc-code
     1887           and buf_ord-line-attr.gds-code  = p-gds-code
     1888           and buf_ord-line-attr.attr-code = p-code
     1889         no-error NO-WAIT.
     1890       if not available buf_ord-line-attr then do:
     1891         p-deleted = no.
     1892       end.
     1893       else do:
     1894         delete buf_ord-line-attr.
     1895         p-deleted = yes.
     1896       end.
     1897     end.
     1898   end procedure.
     1899   procedure ordlineattr-code :
     1900     do on error undo, return error return-value
     1901     :
     1902       define input  parameter p-code           as character no-undo .
     1903       define output parameter p-type           as character no-undo .
     1904       define output parameter p-format         as character no-undo .
     1905       define output parameter p-fillin_width   as integer   no-undo .
     1906       define output parameter p-fillin_height  as integer   no-undo .
     1907       define output parameter p-label          as character no-undo .
     1908       define output parameter p-user-can-edit  as logical   no-undo .
     1909       define output parameter p-output-display as logical   no-undo .
     1910       define output parameter p-proc           as character no-undo .
     1911       define output parameter p-func           as character no-undo .
     1912       define output parameter p-sort           as integer   no-undo .
     1913       define output parameter p-other          as character no-undo .
     1914       case p-code :
     1915               when 'cycle-cli-qnty':U then do:     assign     p-label          = "Количество"     p-type           = 'D':U      p-format         = ">>>>>>>>>>>>>>>9.999"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "Количество"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
     1916               when 'ord-EAN13':U then do:     assign     p-label          = "EAN в EDI"     p-type           = 'C':U      p-format         = "X(13)"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "EAN в EDI"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
     1917         otherwise do:
     1918           undo, return error "неизвестный атрибут строки заказа" + " " + p-code .
     1919         end.
     1920       end.
     1921     end.
     1922   end procedure.
     1923   FUNCTION cr-edist_get-mess-mean returns character ( input p-mess as character):
     1924   define variable v-ii as integer   no-undo .
     1925   define variable v-dop as character no-undo .
     1926   define variable v-dop1 as character no-undo .
     1927   define variable v-mess as character no-undo .
     1928   do v-ii = 1 to num-entries(p-mess, chr(4) ):
     1929     v-dop = entry(v-ii, p-mess, chr(4) ).
     1930     case entry(1, v-dop, "="):
     1931       when 'pack-num':U then do:
     1932         v-dop1 =  substitute("&1 &2", 'Пакет', entry(2, v-dop, "=")).
     1933       end.
     1934       when 'route':U then do:
     1935         v-dop1 =  substitute("&1 &2", 'Рут':U, entry(2, v-dop, "=")).
     1936       end.
     1937       when 'ediiterchangeid':U then do:
     1938         v-dop1 =  substitute("&1 &2", 'ediiterchangeid':U, entry(2, v-dop, "=")).
     1939       end.
     1940       when 'price-up':U then do:
     1941         v-dop1 =  substitute("&1 &2", 'Цена':U, entry(2, v-dop, "=")).
     1942       end.
     1943       when 'price-down':U then do:
     1944         v-dop1 =  substitute("&1 &2", 'Цена':U, entry(2, v-dop, "=")).
     1945       end.
     1946       when 'vat-change':U then do:
     1947         v-dop1 =  substitute("&1 &2", 'НДС':U, entry(2, v-dop, "=")).
     1948       end.
     1949       when 'ps':U then do:
     1950         v-dop1 =  substitute("&1 &2", ' ':U, entry(2, v-dop, "=")).
     1951       end.
     1952       when 'info':U then do:
     1953         v-dop1 =  substitute("&1 &2", 'Инф:':U, entry(2, v-dop, "=")).
     1954       end.
     1955       when 'qnty-up':U then do:
     1956         v-dop1 =  substitute("&1 &2", 'Кол-во':U, entry(2, v-dop, "=")).
     1957       end.
     1958       when 'qnty-down':U then do:
     1959         v-dop1 =  substitute("&1 &2", 'Кол-во':U, entry(2, v-dop, "=")).
     1960       end.
     1961       when 'bstr-change':U then do:
     1962         v-dop1 =  substitute("&1 &2", 'Штрихкод:':U, entry(2, v-dop, "=")).
     1963       end.
     1964       when 'shipdate-change':U then do:
     1965         v-dop1 =  substitute("&1 &2", 'Дата отгрузки:':U, entry(2, v-dop, "=")).
     1966       end.
     1967       when 'clioutdoc-change':U then do:
     1968         v-dop1 =  substitute("&1 &2", '№ заказа по пост-ку:':U, entry(2, v-dop, "=")).
     1969       end.
     1970     end case.
     1971     v-mess  = v-mess + (if v-mess = '' then '' else chr(32)) + v-dop1.
     1972   end.
     1973   return v-mess.
     1974   end function.
     1975   FUNCTION cr-edist_get-error-mean returns character ( input p-mess as character):
     1976   define variable v-ii as integer   no-undo .
     1977   define variable v-dop as character no-undo .
     1978   define variable v-dop1 as character no-undo .
     1979   define variable v-mess as character no-undo .
     1980   do v-ii = 1 to num-entries(p-mess, chr(4) ):
     1981     v-dop = entry(v-ii, p-mess, chr(4) ).
     1982     case entry(1, v-dop, "="):
     1983       when 'pack-num':U then do:
     1984         v-dop1 =  substitute("&1 &2", 'Пакет', entry(2, v-dop, "=")).
     1985       end.
     1986       when 'route':U then do:
     1987         v-dop1 =  substitute("&1 &2", 'Рут':U, entry(2, v-dop, "=")).
     1988       end.
     1989       when 'ediiterchangeid':U then do:
     1990         v-dop1 =  substitute("&1 &2", 'ediiterchangeid':U, entry(2, v-dop, "=")).
     1991       end.
     1992       when 'price-up':U then do:
     1993         v-dop1 =  substitute("&1 &2", 'Цена':U, entry(2, v-dop, "=")).
     1994       end.
     1995       when 'price-down':U then do:
     1996         v-dop1 =  substitute("&1 &2", 'Цена':U, entry(2, v-dop, "=")).
     1997       end.
     1998       when 'vat-change':U then do:
     1999         v-dop1 =  substitute("&1 &2", 'НДС':U, entry(2, v-dop, "=")).
     2000       end.
     2001       when 'ps':U then do:
     2002         v-dop1 =  substitute("&1 &2", ' ':U, entry(2, v-dop, "=")).
     2003       end.
     2004       when 'info':U then do:
     2005         v-dop1 =  substitute("&1 &2", 'Инф:':U, entry(2, v-dop, "=")).
     2006       end.
     2007       when 'qnty-up':U then do:
     2008         v-dop1 =  substitute("&1 &2", 'Кол-во':U, entry(2, v-dop, "=")).
     2009       end.
     2010       when 'qnty-down':U then do:
     2011         v-dop1 =  substitute("&1 &2", 'Кол-во':U, entry(2, v-dop, "=")).
     2012       end.
     2013       when 'bstr-change':U then do:
     2014         v-dop1 =  substitute("&1 &2", 'Штрихкод:':U, entry(2, v-dop, "=")).
     2015       end.
     2016       when 'shipdate-change':U then do:
     2017         v-dop1 =  substitute("&1 &2", 'Дата отгрузки:':U, entry(2, v-dop, "=")).
     2018       end.
     2019       when 'clioutdoc-change':U then do:
     2020         v-dop1 =  substitute("&1 &2", '№ заказа по пост-ку:':U, entry(2, v-dop, "=")).
     2021       end.
     2022     end case.
     2023     v-mess  = v-mess + (if v-mess = '' then '' else chr(4)) + v-dop1.
     2024   end.
     2025   return v-mess.
     2026   end function.
     2027   FUNCTION cr-edist_get-mess-key-value returns character ( input p-mess as character, input p-key as character):
     2028   define variable v-ii as integer   no-undo .
     2029   define variable v-dop as character no-undo .
     2030   define variable v-dop1 as character no-undo .
     2031   define variable v-value as character no-undo .
     2032   do v-ii = 1 to num-entries(p-mess, chr(4) ):
     2033     v-dop = entry(v-ii, p-mess, chr(4) ).
     2034     if entry(1, v-dop, "=") = p-key then do:
     2035       return entry(2, v-dop, "=").
     2036     end.
     2037   end.
     2038   return v-value.
     2039   end function.
     2040   FUNCTION cr-edist_add-edist-mess returns character ( input p-mess as character
     2041                                                        ,input p-key as character
     2042                                                        ,input p-value as character):
     2043   define variable v-dop as character no-undo .
     2044   define variable v-modificator as character no-undo .
     2045   assign
     2046   v-modificator = entry(2, p-key, "-") no-error .
     2047   case v-modificator:
     2048     when "up" then do:
     2049       v-dop = substitute("&1=&2<&3", p-key, entry(1, p-value, chr(4)) , entry(2, p-value, chr(4))).
     2050     end.
     2051     when "down" then do:
     2052       v-dop = substitute("&1=&2>&3", p-key, entry(1, p-value, chr(4)) , entry(2, p-value, chr(4))).
     2053     end.
     2054     when "change" then do:
     2055       v-dop = substitute("&1=&2 ->&3", p-key, entry(1, p-value, chr(4)) , entry(2, p-value, chr(4))).
     2056     end.
     2057     otherwise do:
     2058       v-dop = substitute("&1=&2", p-key, p-value).
     2059     end.
     2060   end case.
     2061   if p-mess = ''
     2062   or p-mess = ? then do:
     2063     return v-dop .
     2064   end.
     2065   else do:
     2066     return substitute("&1&2&3", p-mess, chr(4), v-dop).
     2067   end.
     2068   end function.
     2069   procedure create-edi-state :
     2070   define input  parameter p-tbl-name   as character no-undo .
     2071   define input  parameter p-doc-code   as character no-undo .
     2072   define input  parameter p-cli-type   as character no-undo .
     2073   define input  parameter p-cli-code   as integer   no-undo .
     2074   define input  parameter p-act        as character no-undo .
     2075   define input  parameter p-state      as character no-undo .
     2076   define input  parameter p-err        as integer   no-undo .
     2077   define input  parameter p-des        as character no-undo .
     2078   define input  parameter p-mess       as character no-undo .
     2079   define input  parameter p-dm         as integer  no-undo .
     2080   define input-output parameter p-date       as date no-undo .
     2081   define input-output parameter p-time       as integer no-undo .
     2082   define buffer buf_EDI-status for ub.EDI-status  .
     2083   define variable v-time as integer   no-undo .
     2084   define variable v-date as date   no-undo .
     2085   do
     2086   on error undo, return error return-value
     2087   :
     2088     if p-date = ? then do:
     2089       run cur-time in this-procedure ( output v-date, output v-time).
     2090     end.
     2091     else do:
     2092       assign
     2093       v-date = p-date
     2094       v-time = p-time
     2095       .
     2096     end.
     2097     find first buf_edi-status exclusive-lock where
     2098                 buf_edi-status.date-status = v-date
     2099             and buf_edi-status.time-status = v-time
     2100             and buf_edi-status.tbl-name    = p-tbl-name
     2101             and buf_edi-status.doc-code    = p-doc-code no-error .
     2102     if not available buf_edi-status  then do:
     2103       create buf_edi-status.
     2104     end.
     2105     assign
     2106     buf_edi-status.act         = p-act        .
     2107     buf_edi-status.cli-type    = p-cli-type   .
     2108     buf_edi-status.cli-code    = p-cli-code   .
     2109     buf_edi-status.des-err     = buf_edi-status.des-err + (if buf_edi-status.des-err = '' then '' else chr(4)) + p-des        .
     2110     buf_edi-status.doc-code    = p-doc-code   .
     2111     buf_edi-status.err-code    = p-err        .
     2112     buf_edi-status.mess-id     = buf_edi-status.mess-id + (if buf_edi-status.mess-id = '' then '' else chr(4)) + p-mess       .
     2113     buf_edi-status.state       = p-state      .
     2114     buf_edi-status.tbl-name    = p-tbl-name   .
     2115     buf_edi-status.date-status = v-date       .
     2116     buf_edi-status.time-status = v-time       .
     2117     buf_edi-status.whole-send-news = p-dm     .
     2118     buf_edi-status.user-name   = (if g#news then (chr(4) +  'СПН':U)
     2119                                       else (if g#esys
     2120                                             then (chr(4) +  'ВС':U)
     2121                                             else g#userid)
     2122                                       )       .
     2123     assign
     2124     p-date = buf_edi-status.date-status
     2125     p-time = buf_edi-status.time-status
     2126     .
     2127   end.
     2128   end procedure.
