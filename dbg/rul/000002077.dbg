     3175     buf_ord-doc-rcv.ord-int2  = 0
     3176     buf_ord-doc-rcv.whole-send-news = buf_ord-doc.whole-send-news
     3177     buf_ord-doc-rcv.transport-cli-type = (if substring(p-transport-cli-type-code, 1, 3) = 'орг':U
     3178                                           or substring(p-transport-cli-type-code, 1, 3) = 'чел':U
     3179                                           then substring(p-transport-cli-type-code, 1, 3)
     3180                                           else '')
     3181     buf_ord-doc-rcv.transport-cli-code = (if substring(p-transport-cli-type-code, 1, 3) = 'орг':U
     3182                                           or substring(p-transport-cli-type-code, 1, 3) = 'чел':U
     3183                                           then integer(substring(p-transport-cli-type-code, 4))
     3184                                           else 0)
     3185     p-rcv-code = loc-rcv-num
     3186     .
