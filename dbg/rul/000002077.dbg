        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-parent-handle as handle no-undo .
        4   define input parameter p-log-handle  as handle no-undo .
        5   define input parameter p-cont-handle  as handle no-undo .
        6   define input parameter p-codex-id as integer no-undo .
        7   define input parameter p-ruleset-id as integer no-undo .
        8   define input parameter p-call-id as character no-undo .
        9   define input parameter p-order-id as integer no-undo .
       10   define input parameter p-rule-id as integer no-undo .
       11   define input parameter p-profile-id as integer no-undo .
       12   define input parameter p-is-dynamic as logical no-undo .
       13   define input parameter p-doc-type as character no-undo .
       14   define input parameter p-host-code like ub.sysconf.host-code no-undo .
       15   define input parameter p-obj-type like ub.clients.obj-type no-undo .
       16   define input parameter p-obj-code like ub.clients.obj-code no-undo .
       17   define input parameter p-doc-code as character no-undo .
       18   define input parameter p-process-file-name as character no-undo .
       19   define input parameter p-save       as integer no-undo .
       20   define input parameter v-curr-r-b   as character no-undo .
       21   define input parameter p-cmd-proc-handle as handle no-undo .
       22   define input parameter p-cmd-code  as integer no-undo .
       23   define variable vss-revision    as character no-undo init "$Revision$":U .
       24   define variable vss-author      as character no-undo init "$Author$":U .
       25   define variable vss-date        as character no-undo init "$Date$":U .
       26   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       27   define variable vss-archive     as character no-undo init "$Archive$":U .
       28   define variable vss-description as character no-undo init "Библиотека процедур для работы с кодексом 18 набор правил 8".
       29   procedure vss-get-info :
       30     define output parameter p-vss-revision    like vss-revision    no-undo .
       31     define output parameter p-vss-author      like vss-author      no-undo .
       32     define output parameter p-vss-date        like vss-date        no-undo .
       33     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       34     define output parameter p-vss-archive     like vss-archive     no-undo .
       35     define output parameter p-vss-description like vss-description no-undo .
       36     assign
       37       p-vss-revision    = vss-revision
       38       p-vss-author      = vss-author
       39       p-vss-date        = vss-date
       40       p-vss-workfile    = vss-workfile
       41       p-vss-archive     = vss-archive
       42       p-vss-description = vss-description
       43     .
       44   end procedure.
       45   procedure vss-get-parameters :
       46     define output parameter p-vss-parameters as character no-undo .
       47   end procedure.
       48   define new global shared variable g#vssrevis-logger as handle    no-undo .
       49   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       50   define variable v-vssrevis-logger                   as handle    no-undo .
       51   procedure vss-logevent :
       52     define input  parameter p-extra-paramters as character no-undo .
       53     define variable v-vssrevis-parameters as character no-undo .
       54     do
       55     on error undo, return error return-value
       56     :
       57       if  valid-handle(v-vssrevis-logger)
       58       and v-vssrevis-logger :get-signature("logevent") <> ""
       59       then do:
       60         run vss-get-parameters in this-procedure
       61           (output v-vssrevis-parameters
       62           ).
       63         run logevent in v-vssrevis-logger
       64           (input vss-workfile
       65           ,input vss-revision
       66           ,input v-vssrevis-parameters
       67           ,input p-extra-paramters
       68           ).
       69       end.
       70     end.
       71   end procedure.
       72   assign
       73     v-vssrevis-logger = g#vssrevis-logger
       74   .
       75   if  valid-handle(v-vssrevis-logger)
       76   and v-vssrevis-logger :get-signature("logevent") <> ""
       77   then do:
       78     assign
       79       v-vssrevis-logevent = true
       80     .
       81     run vss-logevent in this-procedure (input vss-description) .
       82   end.
       83   define new global shared variable g#language as character no-undo .
       84   if g#language <> '' and g#language <> 'rus':U then do:
       85     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       86   end.
       87   define new global shared variable g#library  as handle no-undo .
       88   define new global shared variable g#library2 as handle no-undo .
       89   define   shared variable g#auto as logical no-undo.
       90   define   shared variable g#news as logical no-undo.
       91   define   shared variable g#oxml as logical no-undo.
       92   define   shared variable g#esys as logical no-undo.
       93   define   shared variable g#news-source-db as integer no-undo.
       94   define   shared variable g#esys-source-esys as integer no-undo.
       95   define   shared variable g#db-num as integer   no-undo .
       96   define   shared variable g#userid as character no-undo .
       97   define   shared variable g#passwd as character no-undo .
       98   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       99   define  variable garbcoll_ii as integer no-undo .
      100   define  temp-table temp-gc no-undo
      101   field ii as integer
      102   field obj-r as handle
      103   field cn as character
      104   index pi is unique primary
      105   ii
      106   index icn
      107   cn.
      108   procedure garbcoll_create-gc-entry :
      109   define input parameter p-cn as character no-undo .
      110   define input parameter p-obj-r as handle no-undo .
      111     do
      112     on error undo, return error
      113     :
      114       create temp-gc.
      115       assign
      116       temp-gc.ii = garbcoll_ii
      117       garbcoll_ii = garbcoll_ii + 1
      118       temp-gc.cn = p-cn
      119       temp-gc.obj-r = p-obj-r
      120       .
      121     end.
      122   end procedure.
      123   procedure garbcoll_clear :
      124     do
      125     on error undo, return error
      126     :
      127       for each temp-gc:
      128         delete object temp-gc.obj-r.
      129         delete temp-gc.
      130       end.
      131     end.
      132   end procedure.
      133   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      134   procedure cur-time :
      135      define output parameter p-today as date      no-undo .
      136      define output parameter p-time  as integer   no-undo .
      137     do
      138     on error undo, return error
      139     :
      140       define variable v-date1 as date      no-undo .
      141       define variable v-date2 as date      no-undo .
      142       define variable v-time  as integer   no-undo .
      143       assign
      144         v-date1 = today
      145         v-time  = time
      146         v-date2 = today
      147       .
      148       if v-date1 <> v-date2
      149       then do:
      150         assign
      151           v-date1 = today
      152           v-time  = v-time
      153         .
      154       end.
      155       assign
      156         p-today = v-date1
      157         p-time  = v-time
      158       .
      159     end.
      160   end.
      161   function cur-time-date returns character
      162   :
      163     return string(today, '99/99/9999':U) .
      164   end.
      165   function cur-time-mjd returns decimal
      166   :
      167     define variable v-date as date      no-undo .
      168     define variable v-time as integer   no-undo .
      169     run cur-time in this-procedure
      170       (output v-date
      171       ,output v-time
      172       ) .
      173     return integer(v-date) - 2400002 + (v-time / 86400) .
      174   end.
      175   function cur-time-get-ending-index returns integer
      176   (input p-number as integer
      177   )
      178   :
      179     if p-number < 0
      180     or p-number = ?
      181     then do:
      182       return 1 .
      183     end.
      184     define variable v-rest as integer   no-undo .
      185     assign
      186       p-number = p-number modulo 100
      187     .
      188     if p-number < 20
      189     then do:
      190       assign
      191         v-rest = p-number
      192       .
      193     end.
      194     else do:
      195       assign
      196         v-rest = p-number modulo 10
      197       .
      198     end.
      199     case v-rest :
      200       when 1
      201       then do:
      202         return 2 .
      203       end.
      204       when 2 or
      205       when 3 or
      206       when 4
      207       then do:
      208         return 3 .
      209       end.
      210       otherwise do:
      211         return 1 .
      212       end.
      213     end case .
      214   end.
      215   procedure cur-time-mjd-to-date :
      216      define input  parameter i-mjd-diff as decimal no-undo.
      217      define output parameter o-Date     as date    no-undo.
      218      define output parameter o-Time     as integer no-undo.
      219      define variable v-day-number as integer   no-undo .
      220      if    i-mjd-diff < 0
      221         or i-mjd-diff = ?
      222      then do:
      223         return "?" .
      224      end.
      225      assign
      226         v-day-number = truncate(i-mjd-diff,0).
      227         o-Date = date(v-day-number + 2400002).
      228         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      229     .
      230   end.
      231   function cur-time-mjd-to-string returns character
      232   (input p-mjd-diff as decimal
      233   )
      234   :
      235     define variable v-day-number as integer   no-undo .
      236     define variable v-seconds    as integer   no-undo .
      237     define variable v-hour       as integer   no-undo .
      238     define variable v-min        as integer   no-undo .
      239     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      240     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      241     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      242     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      243     if p-mjd-diff < 0
      244     or p-mjd-diff = ?
      245     then do:
      246       return "?" .
      247     end.
      248     assign
      249       v-day-number = integer(truncate(p-mjd-diff,0))
      250       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      251     .
      252     if v-seconds > 86400
      253     then do:
      254       assign
      255         v-seconds = 86400 - 1
      256       .
      257     end.
      258     if v-seconds < 0
      259     then do:
      260       assign
      261         v-seconds = 0
      262       .
      263     end.
      264     assign
      265       v-hour = truncate(v-seconds / 3600, 0)
      266     .
      267     assign
      268       v-seconds = v-seconds modulo 3600
      269     .
      270     assign
      271       v-min = truncate(v-seconds / 60, 0)
      272     .
      273     assign
      274       v-seconds = v-seconds modulo 60
      275     .
      276     return
      277         (if v-day-number <> 0
      278           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      279           else ""
      280         )
      281       + (if v-day-number <> 0 or v-hour <> 0
      282           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      283           else ""
      284         )
      285       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      286           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      287           else ""
      288         )
      289       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      290       .
      291   end.
      292   function cur-time-string returns character
      293   :
      294     define variable v-date as date      no-undo .
      295     define variable v-time as integer   no-undo .
      296     run cur-time in this-procedure
      297       (output v-date
      298       ,output v-time
      299       ) .
      300     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      301   end.
      302   function cur-time-string-sec returns character
      303   :
      304     define variable v-date as date      no-undo .
      305     define variable v-time as integer   no-undo .
      306     run cur-time in this-procedure
      307       (output v-date
      308       ,output v-time
      309       ) .
      310     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      311   end.
      312   function cur-time-custom  returns character
      313   (input p-prefix as character
      314   ,input p-date-format as character
      315   ,input p-delimiter as character
      316   ,input p-time-format as character
      317   ,input p-suffix as character
      318   )
      319   :
      320     define variable v-date as date      no-undo .
      321     define variable v-time as integer   no-undo .
      322     run cur-time in this-procedure
      323       (output v-date
      324       ,output v-time
      325       ) .
      326     return
      327       p-prefix
      328       + string(v-date, p-date-format)
      329       + p-delimiter
      330       + string(v-time, p-time-format)
      331       + p-suffix
      332       .
      333   end.
      334   function cur-time-print  returns character
      335   :
      336     define variable v-date as date      no-undo .
      337     define variable v-time as integer   no-undo .
      338     run cur-time in this-procedure
      339       (output v-date
      340       ,output v-time
      341       ) .
      342     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      343   end.
      344   function cur-time-datetime returns datetime
      345   :
      346     define variable v-char as character no-undo .
      347     define variable v-datetime as datetime no-undo .
      348     v-char = cur-time-string().
      349     v-datetime = datetime(v-char).
      350     return  v-datetime.
      351   end.
      352   function cur-time-string-msec returns character
      353   :
      354     define variable v-date as datetime  no-undo .
      355     v-date = now.
      356     return string(v-date) .
      357   end.
      358   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      359   define new global shared variable g#lib-nws as handle no-undo .
      360   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      361   def var vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      362   procedure gen-key-rec :
      363     define input  parameter p-tbl-name    as character no-undo.
      364     define input  parameter p-bh_tbl-name as handle    no-undo.
      365     define output parameter p-key-rec     as character no-undo.
      366     do
      367     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      368     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      369     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      370     :
      371       define variable fh               as handle    no-undo .
      372       define variable v-ok             as logical   no-undo .
      373       define variable v-inform         as character no-undo .
      374       define variable v-ind            as integer   no-undo .
      375       define variable v-idx-field-qnty as integer   no-undo .
      376       if p-tbl-name = ?
      377         or p-tbl-name = "":U
      378       then do:
      379         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info4 ).
      380       end.
      381       if not p-bh_tbl-name:available then do:
      382         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info4, p-tbl-name ).
      383       end.
      384       assign
      385         p-key-rec = p-tbl-name
      386         v-inform  = p-bh_tbl-name:index-information(1)
      387         v-ind     = 2
      388       .
      389       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      390       on error undo, return error
      391       :
      392         assign
      393           v-inform = p-bh_tbl-name:index-information( v-ind )
      394           v-ind    = v-ind + 1
      395         .
      396       end.
      397       if v-inform = ?
      398         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      399         or entry( 3, v-inform, ",":U ) <> "1":U
      400       then do:
      401         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, p-tbl-name ).
      402       end.
      403       else do:
      404         assign
      405           v-idx-field-qnty = num-entries( v-inform ) - 4
      406         .
      407         if v-idx-field-qnty < 2 then do:
      408           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, p-tbl-name ).
      409         end.
      410         do v-ind = 1 to v-idx-field-qnty by 2
      411         on error undo, return error
      412         :
      413           assign
      414             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      415             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      416           .
      417         end.
      418       end.
      419       if p-key-rec = ? then do:
      420         assign
      421           p-key-rec = "":U
      422         .
      423         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info4, p-tbl-name ).
      424       end.
      425     end.
      426     return.
      427   end procedure.
      428   procedure gen-where-keyr-tab :
      429     define input  parameter i-tableSerach as character no-undo.
      430     define input  parameter i-tablekey   as character  no-undo.
      431     define input  parameter p-key-rec    as character  no-undo.
      432     define input  parameter p-key-handle as handle     no-undo .
      433     define input  parameter p-db-name    as character  no-undo .
      434     define input  parameter p-tt-handle  as handle     no-undo .
      435     define output parameter o-Where      as character  no-undo.
      436     do
      437     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      438     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      439     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      440     :
      441       define variable v-full-tbl-name  as character no-undo .
      442       define variable bh_tbl-name      as handle    no-undo .
      443       define variable fh_key           as handle    no-undo .
      444       define variable fh_search        as handle    no-undo .
      445       define variable v-field-num      as integer   no-undo .
      446       define variable v-count-fld      as integer   no-undo .
      447       define variable v-inform         as character no-undo .
      448       define variable v-ind            as integer   no-undo .
      449       define variable v-idx-field-qnty as integer   no-undo .
      450       define variable v-field-name     as character no-undo .
      451       define variable v-field-val      as character no-undo .
      452       define variable v-word-link      as character no-undo .
      453       define variable vTable           as character no-undo.
      454       define variable bh_tbl-key       as handle    no-undo .
      455       assign
      456         p-key-rec = trim( p-key-rec )
      457       .
      458       if p-key-handle <> ? then do:
      459         if not valid-handle(p-key-handle)
      460            or p-key-handle:type <> "buffer"
      461         then do:
      462           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info4 ).
      463         end.
      464         if num-entries( p-key-rec, chr(3) ) > 1
      465           or p-key-rec = ?
      466           or p-key-rec = "":U
      467         then do:
      468           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info4, p-key-rec ).
      469         end.
      470       end.
      471       else do:
      472         if p-key-rec = ?
      473           or p-key-rec = "":U
      474         then do:
      475           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info4 ).
      476         end.
      477       end.
      478       assign
      479         vTable = entry( 1 , p-key-rec, chr(3) )
      480       .
      481       if p-tt-handle <> ?
      482         and ( not valid-handle(p-tt-handle)
      483               or p-tt-handle:type <> "buffer"
      484             )
      485       then do:
      486         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info4, vTable, chr(10) ).
      487       end.
      488       if p-tt-handle = ? then do:
      489         assign
      490           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      491         .
      492         create buffer bh_tbl-name for table v-full-tbl-name .
      493       end.
      494       else do:
      495         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      496       end.
      497       assign
      498         v-inform = bh_tbl-name:index-information(1)
      499         v-ind    = 2
      500       .
      501       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      502       on error undo, return error
      503       :
      504         assign
      505           v-inform = bh_tbl-name:index-information( v-ind )
      506           v-ind    = v-ind + 1
      507         .
      508       end.
      509       if v-inform = ?
      510         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      511         or entry( 3, v-inform, ",":U ) <> "1":U
      512       then do:
      513         delete object bh_tbl-name no-error.
      514         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info4, vTable ).
      515       end.
      516       assign
      517         v-idx-field-qnty = num-entries( v-inform ) - 4
      518       .
      519       if v-idx-field-qnty < 2 then do:
      520         delete object bh_tbl-name no-error.
      521         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, vTable ).
      522       end.
      523       assign
      524         o-where     = "where":U
      525         v-word-link = "":U
      526         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      527         v-count-fld = 0
      528       .
      529       if i-tablekey ne "" and i-tablekey ne ?
      530       then do:
      531         assign
      532           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      533         .
      534         create buffer bh_tbl-key for table v-full-tbl-name .
      535       end.
      536       if i-tableSerach ne "" and i-tableSerach ne ?
      537       then do:
      538         delete object bh_tbl-name no-error.
      539         assign
      540           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      541         .
      542         create buffer bh_tbl-name for table v-full-tbl-name .
      543       end.
      544       block_where:
      545       do v-ind = 1 to v-idx-field-qnty by 2
      546       on error undo, return error
      547       :
      548         assign
      549           v-count-fld = v-count-fld + 1
      550         .
      551         if p-key-handle = ?
      552           and v-count-fld > v-field-num
      553         then do:
      554           leave block_where.
      555         end.
      556         define variable VfieldKeyTable as handle no-undo.
      557         assign
      558           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      559           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      560         .
      561         if     bh_tbl-key ne ?
      562         then do:
      563            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      564            if VfieldKeyTable eq ?
      565            then next block_where.
      566         end.
      567         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      568         then
      569            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      570         else
      571            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      572         if p-key-handle = ? then do:
      573           assign
      574             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      575           .
      576         end.
      577         else do:
      578           assign
      579             fh_key = p-key-handle:buffer-field( v-field-name )
      580           .
      581           if fh_key = ?
      582             or not valid-handle( fh_key )
      583           then do:
      584             delete object bh_tbl-name.
      585             if     bh_tbl-key ne ?
      586             then
      587                delete object bh_tbl-key.
      588             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info4, p-key-handle:name, v-field-name ).
      589           end.
      590           assign
      591             v-field-val = fh_key:buffer-value
      592           .
      593         end.
      594         if fh_search:data-type ="character":U then do:
      595           assign
      596             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      597             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      598             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      599             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      600             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      601             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      602             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      603             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      604             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      605             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      606             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      607             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      608             v-field-val = substitute( '"&1"', v-field-val )
      609           .
      610         end.
      611         assign
      612           o-where = substitute( "&1 &2", o-where, v-field-val )
      613         .
      614         if v-word-link = "":U then do:
      615           assign
      616             v-word-link = "and":U
      617           .
      618         end.
      619       end.
      620       delete object bh_tbl-name.
      621       if     bh_tbl-key ne ?
      622       then
      623          delete object bh_tbl-key.
      624       if p-key-handle = ?
      625         and v-count-fld <> v-field-num
      626       then do:
      627         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info4, vTable ).
      628       end.
      629     end.
      630   end procedure.
      631   procedure gen-hn-keyr-tab :
      632     define input  parameter i-tableSerach as character no-undo.
      633     define input  parameter i-tablekey   as character no-undo.
      634     define input  parameter p-key-rec    as character no-undo.
      635     define input  parameter p-key-handle as handle    no-undo .
      636     define input  parameter p-db-name    as character no-undo .
      637     define input  parameter p-tt-handle  as handle    no-undo .
      638     define input  parameter p-stts-lock  as integer   no-undo .
      639     define output parameter o-hn         as handle    no-undo.
      640     define variable v-full-tbl-name as character no-undo.
      641     define variable v-where         as character no-undo.
      642     define variable bh_tbl-name     as handle    no-undo.
      643     define variable vTable          as character no-undo.
      644     do
      645     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      646     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      647     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      648         run gen-where-keyr-tab(i-tableSerach,
      649                                i-tablekey,
      650                                p-key-rec,
      651                                p-key-handle,
      652                                p-db-name,
      653                                p-tt-handle,
      654                                output v-where).
      655         if i-tableSerach ne "" and i-tableSerach ne ?
      656         then do:
      657            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      658            create buffer bh_tbl-name for table v-full-tbl-name .
      659         end.
      660         else do:
      661            if p-tt-handle = ? then do:
      662               assign
      663                  vTable = entry( 1 , p-key-rec, chr(3) )
      664               .
      665               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      666               create buffer bh_tbl-name for table v-full-tbl-name .
      667            end.
      668            else do:
      669               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      670            end.
      671         end.
      672         if p-tt-handle = ? then do:
      673            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      674         end.
      675         else do:
      676            bh_tbl-name:find-first( v-where ) no-error .
      677         end.
      678         o-hn = bh_tbl-name.
      679      end.
      680   end procedure.
      681   procedure gen-hn-keyr :
      682     define input  parameter p-key-rec    as character no-undo.
      683     define input  parameter p-key-handle as handle    no-undo .
      684     define input  parameter p-db-name    as character no-undo .
      685     define input  parameter p-tt-handle  as handle    no-undo .
      686     define input  parameter p-stts-lock  as integer   no-undo .
      687     define output parameter o-hn         as handle    no-undo.
      688     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      689   end.
      690   procedure gen-row-keyr :
      691     define input  parameter p-key-rec    as character no-undo.
      692     define input  parameter p-key-handle as handle    no-undo .
      693     define input  parameter p-db-name    as character no-undo .
      694     define input  parameter p-tt-handle  as handle    no-undo .
      695     define input  parameter p-stts-lock  as integer   no-undo .
      696     define output parameter p-tbl-row    as rowid     no-undo.
      697     define output parameter p-tbl-name   as character no-undo.
      698     define variable vHn as handle no-undo.
      699       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      700       p-tbl-row = if vHn:available then vHn:rowid else ?.
      701       p-tbl-name =  vHn:table.
      702       delete object vHn no-error.
      703     if p-tbl-row = ? then do:
      704       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info4, p-tbl-name, p-key-rec ).
      705     end.
      706     else do:
      707       return.
      708     end.
      709   end procedure.
      710   procedure gen-key-fv :
      711     define input  parameter p-key-rec    as character no-undo .
      712     define output parameter p-field-list as character no-undo .
      713     define output parameter p-value-list as character no-undo.
      714     do
      715     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      716     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      717     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      718     :
      719       define variable v-full-tbl-name  as character no-undo .
      720       define variable bh_tbl-name      as handle    no-undo .
      721       define variable v-tbl-name       as character no-undo .
      722       define variable v-field-num      as integer   no-undo .
      723       define variable v-count-fld      as integer   no-undo .
      724       define variable v-inform         as character no-undo .
      725       define variable v-ind            as integer   no-undo .
      726       define variable v-idx-field-qnty as integer   no-undo .
      727       define variable v-delim-key      as character no-undo .
      728       if p-key-rec = ?
      729         or p-key-rec = "":U
      730       then do:
      731         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info4 ).
      732       end.
      733       assign
      734         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      735         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      736       .
      737       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      738       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info4 ).
      739       assign
      740         v-inform = bh_tbl-name:index-information(1)
      741         v-ind    = 2
      742       .
      743       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      744       on error undo, return error
      745       :
      746         assign
      747           v-inform = bh_tbl-name:index-information( v-ind )
      748           v-ind    = v-ind + 1
      749         .
      750       end.
      751       if v-inform = ?
      752         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      753         or entry( 3, v-inform, ",":U ) <> "1":U
      754       then do:
      755         delete object bh_tbl-name no-error.
      756         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, v-tbl-name ).
      757       end.
      758       assign
      759         v-idx-field-qnty = num-entries( v-inform ) - 4
      760       .
      761       if v-idx-field-qnty < 2 then do:
      762         delete object bh_tbl-name no-error.
      763         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, v-tbl-name ).
      764       end.
      765       assign
      766         p-field-list = "":U
      767         p-value-list = "":U
      768         v-delim-key  = "":U
      769         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      770         v-count-fld  = 0
      771       .
      772       block_where:
      773       do v-ind = 1 to v-idx-field-qnty by 2
      774       on error undo, return error
      775       :
      776         assign
      777           v-count-fld = v-count-fld + 1
      778         .
      779         if v-count-fld > v-field-num then do:
      780           leave block_where.
      781         end.
      782         assign
      783           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      784           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      785         .
      786         if v-ind = 1 then do:
      787           assign
      788             v-delim-key = chr(3)
      789           .
      790         end.
      791       end.
      792       delete object bh_tbl-name.
      793       if v-count-fld <> v-field-num then do:
      794         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info4, v-tbl-name ).
      795       end.
      796     end.
      797   end procedure.
      798   procedure gen-key-field :
      799     define input  parameter p-table      as character no-undo .
      800     define output parameter p-field-list as character no-undo .
      801     do
      802     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      803     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      804     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      805     :
      806       define variable v-full-tbl-name  as character no-undo .
      807       define variable bh_tbl-name      as handle    no-undo .
      808       define variable v-tbl-name       as character no-undo .
      809       define variable v-field-num      as integer   no-undo .
      810       define variable v-count-fld      as integer   no-undo .
      811       define variable v-inform         as character no-undo .
      812       define variable v-ind            as integer   no-undo .
      813       define variable v-idx-field-qnty as integer   no-undo .
      814       define variable v-delim-key      as character no-undo .
      815       if p-table = ?
      816         or p-table = "":U
      817       then do:
      818         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info4 ).
      819       end.
      820       assign
      821         v-tbl-name      = p-table
      822         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      823       .
      824       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      825       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info4 ).
      826       assign
      827         v-inform = bh_tbl-name:index-information(1)
      828         v-ind    = 2
      829       .
      830       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      831       on error undo, return error
      832       :
      833         assign
      834           v-inform = bh_tbl-name:index-information( v-ind )
      835           v-ind    = v-ind + 1
      836         .
      837       end.
      838       if v-inform = ?
      839         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      840         or entry( 3, v-inform, ",":U ) <> "1":U
      841       then do:
      842         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, v-tbl-name ).
      843       end.
      844       assign
      845         v-idx-field-qnty = num-entries( v-inform ) - 4
      846       .
      847       if v-idx-field-qnty < 2 then do:
      848         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, v-tbl-name ).
      849       end.
      850       assign
      851         p-field-list = "":U
      852         v-delim-key  = "":U
      853         v-count-fld  = 0
      854       .
      855       block_where:
      856       do v-ind = 1 to v-idx-field-qnty by 2
      857       on error undo, return error
      858       :
      859         assign
      860           v-count-fld = v-count-fld + 1
      861         .
      862         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      863         if v-ind = 1 then do:
      864           assign
      865             v-delim-key = chr(3)
      866           .
      867         end.
      868       end.
      869       delete object bh_tbl-name.
      870     end.
      871   end procedure.
      872   define SHARED temp-table temp-cmd no-undo
      873   field cmd-code as integer
      874   field db-list as character
      875   index pi is unique primary
      876   db-list
      877   index icmd
      878   cmd-code
      879   .
      880   define SHARED temp-table temp-smart-route no-undo
      881   field key-field as character
      882   field db-num as integer
      883   index pi is unique primary
      884   key-field
      885   db-num
      886   .
      887   define SHARED temp-table temp-no-route no-undo
      888   field rec-ord as integer
      889   field db-num as integer
      890   index pi is unique primary
      891   db-num
      892   rec-ord
      893   index iro
      894   rec-ord
      895   .
      896   define SHARED temp-table temp-smart-link no-undo
      897   field uniq-key-rec as character
      898   field key-field as character
      899   field rec-ord as integer
      900   field is-smart as logical
      901   index pi is unique primary
      902   key-field
      903   uniq-key-rec
      904   rec-ord
      905   index iu
      906   uniq-key-rec
      907   index iro
      908   rec-ord
      909   .
      910   define SHARED temp-table temp-nws-outline no-undo
      911   like ub.nws-outline.
      912   procedure create-smart-route :
      913   define input parameter p-key-field as character no-undo .
      914   define input parameter p-db-num as integer no-undo .
      915   define buffer buf_temp-smart-route for temp-smart-route.
      916     do
      917     on error undo, return error
      918     :
      919       find first buf_temp-smart-route where
      920                 buf_temp-smart-route.key-field = p-key-field
      921             and buf_temp-smart-route.db-num = p-db-num no-error.
      922       if not available buf_temp-smart-route then do:
      923         create buf_temp-smart-route.
      924         assign
      925         buf_temp-smart-route.key-field = p-key-field
      926         buf_temp-smart-route.db-num = p-db-num
      927         .
      928       end.
      929     end.
      930   end procedure.
      931   procedure create-smart-route-link :
      932   define input parameter p-tbl-name as character no-undo .
      933   define input parameter p-bh_tbl-name as handle no-undo .
      934   define input parameter p-key-field as character no-undo .
      935   define input parameter p-rec-ord as integer no-undo .
      936   define input parameter p-is-smart as logical no-undo .
      937   define variable v-key-rec as character no-undo .
      938   define buffer buf_temp-smart-link for temp-smart-link.
      939     do
      940     on error undo, return error
      941     :
      942       run gen-key-rec in this-procedure ( input p-tbl-name
      943                                          ,input p-bh_tbl-name
      944                                          ,output v-key-rec     ).
      945      find first buf_temp-smart-link where
      946                 buf_temp-smart-link.uniq-key-rec = v-key-rec
      947              and buf_temp-smart-link.key-field = p-key-field
      948              and buf_temp-smart-link.rec-ord = p-rec-ord
      949              no-error .
      950      if not available buf_temp-smart-link then do:
      951        create buf_temp-smart-link.
      952        assign
      953        buf_temp-smart-link.uniq-key-rec = v-key-rec
      954        buf_temp-smart-link.key-field = p-key-field
      955        buf_temp-smart-link.rec-ord = p-rec-ord
      956        buf_temp-smart-link.is-smart = p-is-smart
      957        .
      958      end.
      959     end.
      960   end procedure.
      961   procedure create-nws-outline :
      962   define input parameter p-cmd-proc-handle as handle no-undo .
      963   define input parameter p-cmd-code as integer no-undo .
      964   define input parameter p-outline-type as character no-undo .
      965   define input parameter p-charkey_one as character no-undo .
      966   define input parameter p-charkey_two as character no-undo .
      967   define input parameter p-charkey_three as character no-undo .
      968   define input parameter p-key#_one as integer no-undo .
      969   define input parameter p-key#_two as integer no-undo .
      970   define input parameter p-key#_three as integer no-undo .
      971   define variable v-no-id as integer no-undo .
      972   define variable v-rec-ord as integer no-undo .
      973     do
      974     on error undo, return error return-value
      975     :
      976       find last temp-nws-outline use-index pi no-error .
      977       v-no-id = (if available temp-nws-outline
      978                  then (temp-nws-outline.no-id  + 1)
      979                  else 1).
      980       create temp-nws-outline.
      981       assign
      982       temp-nws-outline.charkeY_one = p-charkey_one
      983       temp-nws-outline.charkeY_two = p-charkey_two
      984       temp-nws-outline.charkeY_three = p-charkey_three
      985       temp-nws-outline.key#_one = p-key#_one
      986       temp-nws-outline.key#_two = p-key#_two
      987       temp-nws-outline.key#_three = p-key#_three
      988       temp-nws-outline.no-id = v-no-id
      989       temp-nws-outline.outline-type = p-outline-type
      990       .
      991                                   run add-dump in p-cmd-proc-handle                                                                           (input p-cmd-code                                                                                         ,input 'nws-outline':U                                                                                          ,input '+update'                                                                                         ,input (buffer temp-nws-outline:handle)                                                                                    ,input ''                                                                                         ,output v-rec-ord                                                                                         ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                     delete procedure p-cmd-proc-handle .                                                                        undo , return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'nws-outline':U                                                                                                ,p-cmd-code                                                                                               ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
      992       run  create-smart-route in this-procedure (
      993                                                   input ('nws-outline':U + chr(4) + string(temp-nws-outline.no-id))
      994                                                  ,input -1).
      995       run create-smart-route-link in this-procedure (
      996                                                      input 'nws-outline':U
      997                                                     ,input (buffer temp-nws-outline:handle)
      998                                                     ,input ('nws-outline':U + chr(4) + string(temp-nws-outline.no-id))
      999                                                     ,input v-rec-ord
     1000                                                     ,input no
     1001                                                     ).
     1002     end.
     1003   end procedure.
     1004   procedure create-no-route :
     1005   define input parameter p-rec-ord as integer no-undo .
     1006   define input parameter p-db-num as integer no-undo .
     1007   define buffer buf_temp-no-route for temp-no-route.
     1008   do
     1009   on error undo, return error
     1010   :
     1011      find first buf_temp-no-route where
     1012                 buf_temp-no-route.rec-ord = p-rec-ord
     1013              and buf_temp-no-route.db-num = p-db-num no-error .
     1014      if not available buf_temp-no-route then do:
     1015        create buf_temp-no-route.
     1016        assign
     1017        buf_temp-no-route.rec-ord = p-rec-ord
     1018        buf_temp-no-route.db-num = p-db-num
     1019        .
     1020      end.
     1021   end.
     1022   end procedure.
     1023   procedure clear-from-rec-ord :
     1024   define input parameter p-rec-ord as integer no-undo .
     1025   define buffer buf_temp-no-route for temp-no-route.
     1026   define buffer buf_temp-smart-link for temp-smart-link.
     1027   do
     1028   on error undo, return error
     1029   :
     1030   for each buf_temp-no-route where
     1031           buf_temp-no-route.rec-ord > p-rec-ord:
     1032     delete buf_temp-no-route.
     1033   end.
     1034   for each buf_temp-smart-link where
     1035           buf_temp-smart-link.rec-ord > p-rec-ord:
     1036      delete buf_temp-smart-link.
     1037   end.
     1038   end.
     1039   end procedure.
     1040   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1041   define shared temp-table temp-hist-nws-option no-undo
     1042   like ub.hist-nws-option
     1043   .
     1044   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1045   procedure library-cls_get-handle :
     1046   define input parameter p-library-name as character no-undo .
     1047   define output parameter p-library-handle as handle no-undo .
     1048     do
     1049     on error undo, return error
     1050     :
     1051       CASE p-library-name:
     1052         when "library" then do:
     1053           if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end.
     1054           p-library-handle = g#library.
     1055         end.
     1056         when "library2" then do:
     1057           if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end.
     1058           p-library-handle = g#library2.
     1059         end.
     1060       end case.
     1061     end.
     1062   end procedure.
     1063   def var vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1064   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1065   define variable tempcxml_v-num_ as integer no-undo .
     1066   define shared temp-table temp-xml-tables no-undo
     1067   field order as integer
     1068   field tbl-name as character
     1069   field tbl-handle_ as handle
     1070   field table-handle_ as handle
     1071   field uniq-gate-rec as character
     1072   field gate-name as character
     1073   field gate-handle_ as handle
     1074   field is-parent as logical
     1075   index pi is unique primary
     1076   uniq-gate-rec
     1077   tbl-name
     1078   index iorder
     1079   order
     1080   index gr
     1081   uniq-gate-rec
     1082   index gh
     1083   gate-handle_
     1084   index iparent
     1085   is-parent
     1086   .
     1087   define shared temp-table temp-xml-records no-undo
     1088   field tbl-name as character
     1089   field uniq-key-rec as character
     1090   index pi is unique primary
     1091   tbl-name
     1092   uniq-key-rec
     1093   .
     1094   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1095   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1096   def var vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1097   procedure get-gate-file-name :
     1098   define input parameter p-gate-rec as character no-undo .
     1099   define output  parameter p-gate-file-name as character no-undo .
     1100   define buffer buf_clob-data for ub.clob-data.
     1101   define variable v-tbl-row as rowid no-undo .
     1102   define variable v-tbl-name as character no-undo .
     1103   run gen-row-keyr in this-procedure ( input p-gate-rec
     1104                                       ,input ?
     1105                                       ,input "ub"
     1106                                       ,input ?
     1107                                       ,input no-lock
     1108                                       ,output v-tbl-row
     1109                                       ,output v-tbl-name) no-error.
     1110   if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     1111                                                           ,vss-include-info9
     1112                                                           ,p-gate-rec).
     1113   find first buf_clob-data no-lock where
     1114             rowid(buf_clob-data) = v-tbl-row no-error.
     1115   if not available buf_clob-data then do:
     1116     if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     1117                                                             ,vss-include-info9
     1118                                                             ,p-gate-rec).
     1119   end.
     1120   p-gate-file-name = buf_clob-data.file-name.
     1121   end procedure.
     1122   procedure get-gate-rec :
     1123   define input  parameter p-gate-name as character no-undo .
     1124   define output parameter p-gate-rec as character no-undo .
     1125   define buffer buf_clob-bind for ub.clob-bind.
     1126   define buffer buf_clob-data for ub.clob-data.
     1127   main-block:
     1128   do
     1129   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info9, return-value, chr(10), error-status :get-message (1))
     1130   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info9 )
     1131   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info9 )
     1132   :
     1133       find first buf_clob-bind no-lock where
     1134                 buf_clob-bind.uniq-key-rec = p-gate-name
     1135             and buf_clob-bind.field-name = '':U
     1136             and buf_clob-bind.part-num = 1
     1137             and buf_clob-bind.resource-type = 'gate':U
     1138             no-error.
     1139       if not available buf_clob-bind then do:
     1140         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     1141                                         , p-gate-name
     1142                                         ).
     1143       end.
     1144       find first buf_clob-data no-lock where
     1145                 buf_clob-data.db-num = buf_clob-bind.db-num
     1146             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     1147       if not available buf_clob-data then do:
     1148         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1149                                         , buf_clob-bind.db-num
     1150                                         , buf_clob-bind.int64-id
     1151                                         , p-gate-name
     1152                                         ).
     1153       end.
     1154       run gen-key-rec in this-procedure ( input 'clob-data':U
     1155                                 ,input buffer buf_clob-data:handle
     1156                                 ,output p-gate-rec).
     1157   end.
     1158   end procedure.
     1159   procedure get-gate-by-name :
     1160   define input  parameter p-gate-name as character no-undo .
     1161   define output parameter p-gate-rec as character no-undo .
     1162   define output parameter p-dsh as handle no-undo .
     1163   define input-output  parameter p-xmlh as handle no-undo .
     1164   define variable v-ii as integer   no-undo .
     1165   define variable glog as logical   no-undo .
     1166   define variable v-longchar as longchar no-undo .
     1167   define variable v-txmlh as handle no-undo .
     1168   define variable v-db-num as integer no-undo .
     1169   define variable v-int64-id as int64 no-undo .
     1170   define buffer buf_clob-bind for ub.clob-bind.
     1171   define buffer buf_clob-data for ub.clob-data.
     1172   main-block:
     1173   do
     1174   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info9, return-value, chr(10), error-status :get-message (1))
     1175   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info9 )
     1176   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info9 )
     1177   :
     1178       find first buf_clob-bind no-lock where
     1179                 buf_clob-bind.uniq-key-rec = p-gate-name
     1180             and buf_clob-bind.field-name = '':U
     1181             and buf_clob-bind.part-num = 1
     1182             and buf_clob-bind.resource-type = 'gate':U
     1183             no-error.
     1184       if not available buf_clob-bind then do:
     1185         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     1186                                         , p-gate-name
     1187                                         ).
     1188       end.
     1189       find first buf_clob-data no-lock where
     1190                 buf_clob-data.db-num = buf_clob-bind.db-num
     1191             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     1192       if not available buf_clob-data then do:
     1193         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1194                                         , buf_clob-bind.db-num
     1195                                         , buf_clob-bind.int64-id
     1196                                         , p-gate-name
     1197                                         ).
     1198       end.
     1199       assign
     1200       v-longchar = buf_clob-data.cdata
     1201       .
     1202       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1203       if error-status :error then do:
     1204         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1205       end.
     1206       create dataset p-dsh .
     1207       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1208                                     , v-longchar
     1209                                     , ?
     1210                                     , ?
     1211                                     , ?
     1212                                     ) no-error.
     1213       v-longchar = '':U.
     1214       if error-status :error
     1215       or not glog
     1216       then do:
     1217         undo, return error substitute("Не удалось прочитать XML-схему &1 из БД:&2&3", p-gate-name, chr(10), error-status:get-message(1) ).
     1218       end.
     1219       if not valid-handle(p-xmlh)
     1220       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1221         create temp-table v-txmlh.
     1222         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1223         v-txmlh:temp-table-prepare("temp-xml-tables").
     1224         p-xmlh = v-txmlh:default-buffer-handle.
     1225       end.
     1226       run gen-key-rec in this-procedure ( input 'clob-data':U
     1227                                 ,input buffer buf_clob-data:handle
     1228                                 ,output p-gate-rec).
     1229       do v-ii = 1 to p-dsh:num-buffers:
     1230         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1231         if not p-xmlh:available then do:
     1232           p-xmlh:buffer-create().
     1233           assign
     1234           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1235           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1236           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1237           p-xmlh::gate-handle_ = p-dsh
     1238           p-xmlh::uniq-gate-rec = p-gate-rec
     1239           p-xmlh::gate-name = p-dsh:name
     1240           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1241           .
     1242           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1243             assign
     1244             p-xmlh::order = -3.
     1245           end.
     1246         end.
     1247       end.
     1248   end.
     1249   end procedure.
     1250   procedure get-gate-by-rec :
     1251   define input  parameter p-gate-rec as character no-undo .
     1252   define output parameter p-dsh as handle no-undo .
     1253   define input-output  parameter p-xmlh as handle no-undo .
     1254   define input-output parameter p-longchar  as longchar no-undo .
     1255   define variable v-ii as integer   no-undo .
     1256   define variable glog as logical   no-undo .
     1257   define variable v-rowid as rowid no-undo .
     1258   define variable v-tbl-name as character no-undo .
     1259   define variable v-longchar as longchar no-undo .
     1260   define variable v-txmlh as handle no-undo .
     1261   define buffer buf_clob-data for ub.clob-data.
     1262   main-block:
     1263   do
     1264   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info9, return-value, chr(10), error-status :get-message (1))
     1265   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info9 )
     1266   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info9 )
     1267   :
     1268     run gen-row-keyr in this-procedure (
     1269                                           input  p-gate-rec
     1270                                           ,input  ?
     1271                                           ,input  "ub"
     1272                                           ,input  ?
     1273                                           ,input  NO-LOCK
     1274                                           ,output v-rowid
     1275                                           ,output v-tbl-name   ) no-error.
     1276       find first buf_clob-data no-lock where
     1277                 rowid(buf_clob-data) = v-rowid  no-error.
     1278       if not available buf_clob-data then do:
     1279         undo, return error substitute("Не найден CLOB  &1"
     1280                                         , p-gate-rec
     1281                                         ).
     1282       end.
     1283       assign
     1284       v-longchar = buf_clob-data.cdata
     1285       .
     1286       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1287       if error-status :error then do:
     1288         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1289       end.
     1290       create dataset p-dsh .
     1291       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1292                                     , v-longchar
     1293                                     , ?
     1294                                     , ?
     1295                                     , ?
     1296                                     ) no-error.
     1297       define variable v-esm as character no-undo .
     1298       v-esm = error-status:get-message(1) .
     1299       if p-longchar <> ? then do:
     1300         p-longchar = v-longchar.
     1301       end.
     1302       v-longchar = '':U.
     1303       if error-status :error
     1304       or not glog
     1305       then do:
     1306         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     1307                                      , p-gate-rec
     1308                                      , p-gate-rec
     1309                                      , v-esm
     1310                                      ).
     1311       end.
     1312       p-dsh:private-data = buf_clob-data.file-name_ + chr(4) + p-gate-rec.
     1313       if not valid-handle(p-xmlh)
     1314       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1315         create temp-table v-txmlh.
     1316         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1317         v-txmlh:temp-table-prepare("temp-xml-tables").
     1318         p-xmlh = v-txmlh:default-buffer-handle.
     1319       end.
     1320       do v-ii = 1 to p-dsh:num-buffers:
     1321         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1322         if not p-xmlh:available then do:
     1323           p-xmlh:buffer-create().
     1324           assign
     1325           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1326           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1327           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1328           p-xmlh::gate-handle_ = p-dsh
     1329           p-xmlh::uniq-gate-rec = p-gate-rec
     1330           p-xmlh::gate-name = p-dsh:name
     1331           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1332           .
     1333           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1334             assign
     1335             p-xmlh::order = -3.
     1336           end.
     1337           p-xmlh:buffer-release().
     1338         end.
     1339       end.
     1340   end.
     1341   end procedure.
     1342   procedure get-gate-by-file :
     1343   define input  parameter p-schema-file-name as character no-undo .
     1344   define input  parameter p-gate-rec as character no-undo .
     1345   define output parameter p-dsh as handle no-undo .
     1346   define input-output  parameter p-xmlh as handle no-undo .
     1347   define variable v-ii as integer   no-undo .
     1348   define variable glog as logical   no-undo .
     1349   define variable v-rowid as rowid no-undo .
     1350   define variable v-tbl-name as character no-undo .
     1351   define variable v-longchar as longchar no-undo .
     1352   define variable v-txmlh as handle no-undo .
     1353   main-block:
     1354   do
     1355   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info9, return-value, chr(10), error-status :get-message (1))
     1356   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info9 )
     1357   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info9 )
     1358   :
     1359       COPY-LOB
     1360       FROM  FILE p-schema-file-name
     1361       TO  OBJECT v-longchar
     1362       no-convert
     1363       NO-ERROR .
     1364       if error-status :error then do:
     1365           undo, return error substitute("Не удалось считать файл схемы &1 в память&2&3"
     1366                                     , p-schema-file-name
     1367                                 , chr(10)
     1368                                 , error-status:get-message(1) ).
     1369       end.
     1370       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1371       if error-status :error then do:
     1372         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, p-schema-file-name, chr(10), error-status:get-message(1) , return-value ).
     1373       end.
     1374       create dataset p-dsh .
     1375       glog = p-dsh:READ-XMLSCHEMA( "longchar"
     1376                                     , v-longchar
     1377                                     , ?
     1378                                     , ?
     1379                                     , ?
     1380                                     ) no-error.
     1381       v-longchar = ''.
     1382       if error-status :error
     1383       or not glog
     1384       then do:
     1385         undo, return error substitute("Не удалось прочитать XML-схему из файла &1&2&3"
     1386                                      , p-schema-file-name
     1387                                      ,chr(10)
     1388                                      , error-status:get-message(1)
     1389                                      ).
     1390       end.
     1391       if not valid-handle(p-xmlh)
     1392       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1393         create temp-table v-txmlh.
     1394         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1395         v-txmlh:temp-table-prepare("temp-xml-tables").
     1396         p-xmlh = v-txmlh:default-buffer-handle.
     1397       end.
     1398       do v-ii = 1 to p-dsh:num-buffers:
     1399         p-xmlh:find-first(substitute(' where tbl-name = "&1" and  uniq-gate-rec = "&2" '
     1400                                      ,p-dsh:get-buffer-handle(v-ii):name
     1401                                      ,p-gate-rec
     1402                                      )) no-error.
     1403         if not p-xmlh:available then do:
     1404           p-xmlh:buffer-create().
     1405           assign
     1406           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):table
     1407           p-xmlh::uniq-gate-rec = p-gate-rec
     1408           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1409           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1410           p-xmlh::gate-handle_ = p-dsh
     1411           p-xmlh::gate-name = p-dsh:name
     1412           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1413           .
     1414           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1415             assign
     1416             p-xmlh::order = -3.
     1417           end.
     1418           p-xmlh:buffer-release().
     1419         end.
     1420       end.
     1421   end.
     1422   end procedure.
     1423   procedure gate-clear :
     1424   define input  parameter p-dsh as handle no-undo .
     1425   define input  parameter p-xmlh as handle no-undo .
     1426   define variable v-dsh as handle no-undo .
     1427   define variable v-th as handle no-undo .
     1428     do
     1429     on error undo, return error return-value
     1430     :
     1431       if valid-handle(p-dsh) then do:
     1432         delete object p-dsh.
     1433         v-dsh = p-dsh.
     1434         p-dsh = ?.
     1435       end.
     1436       repeat while true:
     1437         p-xmlh:find-first( substitute( " where gate-handle_ = &1 ", v-dsh)
     1438                            , share-lock) no-error.
     1439         if p-xmlh:available then do:
     1440           assign
     1441           v-th = p-xmlh:buffer-field("table-handle_"):buffer-value.
     1442           if valid-handle(p-xmlh:buffer-field("table-handle_"))
     1443           and valid-handle(v-th)
     1444           and v-th:dynamic = yes
     1445           then do:
     1446             delete object p-xmlh:buffer-field("table-handle_"):buffer-value.
     1447             p-xmlh:buffer-field("table-handle_"):buffer-value = ?.
     1448           end.
     1449           p-xmlh:buffer-delete().
     1450         end.
     1451         else do:
     1452           leave.
     1453         end.
     1454       end.
     1455       if p-xmlh:dynamic = yes
     1456       and valid-handle(p-xmlh)
     1457       then do:
     1458         delete object p-xmlh:table-handle.
     1459         p-xmlh = ?.
     1460       end.
     1461       v-dsh = ?.
     1462     end.
     1463   end procedure.
     1464   procedure all-gates-clear :
     1465   define parameter buffer buf_temp-xml-tables for temp-xml-tables.
     1466   do
     1467   on error undo, return error
     1468   :
     1469     for each buf_temp-xml-tables
     1470     break
     1471     by buf_temp-xml-tables.uniq-gate-rec
     1472     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1473     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1474     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1475     :
     1476         if first-of(buf_temp-xml-tables.uniq-gate-rec) then do:
     1477           delete object buf_temp-xml-tables.gate-handle_.
     1478           buf_temp-xml-tables.gate-handle_ = ?.
     1479         end.
     1480         if valid-handle(buf_temp-xml-tables.table-handle_)
     1481         and buf_temp-xml-tables.table-handle_:dynamic = no
     1482         then do:
     1483           delete object buf_temp-xml-tables.table-handle_.
     1484           buf_temp-xml-tables.table-handle_ = ?.
     1485         end.
     1486         delete buf_temp-xml-tables.
     1487     end.
     1488   end.
     1489   end procedure.
     1490   procedure fix-schemalocation :
     1491   define input-output  parameter p-longchar as longchar no-undo .
     1492   DEFINE VARIABLE hdoc AS HANDLE.
     1493   DEFINE VARIABLE hroot AS HANDLE.
     1494   DEFINE VARIABLE hnode-child AS HANDLE.
     1495   DEFINE VARIABLE hnode-attr AS HANDLE.
     1496   define variable v-jj as integer   no-undo .
     1497   define variable ok as logical   no-undo .
     1498   define variable v-path1                    as character                no-undo .
     1499   DEFINE VARIABLE v-full-path1               as character                no-undo .
     1500   DEFINE VARIABLE v-file-name1               as character                no-undo .
     1501   DEFINE VARIABLE v-file-name-no-ext1        as character                no-undo .
     1502   DEFINE VARIABLE v-file-name-ext1           as character                no-undo .
     1503   define variable v-schema-location          as character                no-undo .
     1504   do
     1505   on error undo, return error return-value
     1506   :
     1507     CREATE X-DOCUMENT hdoc.
     1508     CREATE X-noderef hroot.
     1509     CREATE X-noderef hnode-child.
     1510     CREATE X-noderef hnode-attr.
     1511     hdoc:load("longchar", p-longchar, no) no-error.
     1512     iF ERROR-STATUS:GET-MESSAGE(1) <> '' THEN message ERROR-STATUS:GET-MESSAGE(1) view-as alert-box .
     1513     hdoc:get-document-element(hroot).
     1514     _repeat:
     1515     REPEAT v-jj = 1 TO hroot:NUM-CHILDREN:
     1516       ok = hroot:GET-CHILD(hNode-Child, v-jj).
     1517       if not ok then next.
     1518       if hNode-Child:local-name = "include"
     1519       then do:
     1520         ok = hNode-Child:GET-ATTRIBUTE-NODE( hnode-attr, "schemaLocation" ).
     1521           v-schema-location = hnode-attr:node-value.
     1522           run gbl/filename.p (
     1523                           input "exe/" + hnode-attr:node-value
     1524                         ,output v-full-path1
     1525                         ,output v-path1
     1526                         ,output v-file-name1
     1527                         ,output v-file-name-no-ext1
     1528                         ,output v-file-name-ext1
     1529                         ) no-error .
     1530           if error-status :error then do:
     1531             delete object hnode-attr.
     1532             delete object hnode-child.
     1533             delete object hroot.
     1534             delete object hdoc.
     1535             undo, return error substitute("Не удалось определить расположение схемы &1", v-schema-location).
     1536           end.
     1537         ok = hNode-Child:sET-ATTRIBUTE(  "schemaLocation", v-full-path1 ).
     1538         leave  _repeat.
     1539       end.
     1540     END.
     1541     hdoc:save("longchar", p-longchar).
     1542     delete object hnode-attr.
     1543     delete object hnode-child.
     1544     delete object hroot.
     1545     delete object hdoc.
     1546   end.
     1547   end procedure.
     1548   procedure gate-clb_fill-xml-tables :
     1549   define input parameter p-dsh as handle no-undo .
     1550   define input-output parameter p-xmlh as handle no-undo .
     1551   define variable v-ii as integer no-undo .
     1552     do
     1553     on error undo, return error
     1554     :
     1555       do v-ii = 1 to p-dsh:num-buffers:
     1556         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1557         if not p-xmlh:available then do:
     1558           p-xmlh:buffer-create().
     1559           assign
     1560           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1561           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1562           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1563           p-xmlh::gate-handle_ = p-dsh
     1564           p-xmlh::uniq-gate-rec = entry(2, p-dsh:private-data, chr(4))
     1565           p-xmlh::gate-name = p-dsh:name
     1566           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1567           .
     1568           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1569             assign
     1570             p-xmlh::order = -3.
     1571           end.
     1572           p-xmlh:buffer-release().
     1573         end.
     1574       end.
     1575     end.
     1576   end procedure.
     1577   procedure all-gates-empty :
     1578   define buffer buf_temp-xml-tables for temp-xml-tables.
     1579   do
     1580   on error undo, return error
     1581   :
     1582     for each buf_temp-xml-tables
     1583     break
     1584     by buf_temp-xml-tables.uniq-gate-rec
     1585     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1586     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1587     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1588     :
     1589       if valid-handle(buf_temp-xml-tables.tbl-handle_) then do:
     1590         buf_temp-xml-tables.tbl-handle_:empty-temp-table().
     1591       end.
     1592     end.
     1593   end.
     1594   end procedure.
     1595   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
