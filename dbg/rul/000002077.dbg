     3198     buf_ord-doc.status_ = (if buf_ord-doc.status_ = 'новый':U
     3199                           then 'поставка':U
     3200                           else buf_ord-doc.status_)
     3201     .
     3202     DEFINE VARIABLE v-date as date no-undo .
