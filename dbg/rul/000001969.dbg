     3536   procedure xmllib-set-codepage-convert :
     3537     define input  parameter p-codepage-source as character no-undo .
     3538     define input  parameter p-codepage-target as character no-undo .
     3539   do
     3540   on error undo, return error return-value
     3541   :
     3542     if ( p-codepage-source <> "" and p-codepage-target <> "" )
     3543     then do:
     3544       assign
     3545         v-xmllib-codepage-convert = yes
     3546         v-xmllib-codepage-source  = p-codepage-source
     3547         v-xmllib-codepage-target  = p-codepage-target
     3548       .
     3549     end.
     3550     else do:
     3551       assign
     3552         v-xmllib-codepage-convert = no
     3553         v-xmllib-codepage-source  = ""
     3554         v-xmllib-codepage-target  = ""
     3555       .
     3556     end.
     3557   end.
     3558   end procedure.
     3559   procedure xmllib-parse-rec-open :
     3560   define input parameter p-rec-name   as character        no-undo.
     3561   define input parameter p-rec-level  as integer          no-undo.
     3562       define buffer buf_temp_xmllib_rec       for temp_xmllib_rec.
     3563   do
     3564   for buf_temp_xmllib_rec
     3565   on error undo, return error
     3566   :
     3567        find first buf_temp_xmllib_rec
     3568            where buf_temp_xmllib_rec.recName = p-rec-name
     3569              and buf_temp_xmllib_rec.recLevel = p-rec-level
     3570              and buf_temp_xmllib_rec.closed  = no
     3571       use-index nm
     3572       no-error.
     3573       if available buf_temp_xmllib_rec
     3574       then do:
     3575           run xmllib-parse-error in this-procedure (
     3576               input substitute( "Ошибка 2 открытия записи <&1>: Запись с этим именем и уровнем &2 уже открыта на строке &3."
     3577                               , p-rec-name
     3578                               , p-rec-level
     3579                               , buf_temp_xmllib_rec.recOpenLine
     3580                               )
     3581           ).
     3582       end.
     3583       else do:
     3584           assign
     3585               v-xmllib-rec-key    = v-xmllib-rec-key + 1
     3586           .
     3587           create buf_temp_xmllib_rec.
     3588           assign
     3589               buf_temp_xmllib_rec.rec-key         = v-xmllib-rec-key
     3590               buf_temp_xmllib_rec.recOpenLine     = v-xmllib-sax-reader-handle :locator-line-number
     3591               buf_temp_xmllib_rec.recCloseLine    = 0
     3592               buf_temp_xmllib_rec.recName         = p-rec-name
     3593               buf_temp_xmllib_rec.recLevel        = p-rec-level
     3594               buf_temp_xmllib_rec.closed          = no
     3595           .
     3596       end.
     3597   end.
     3598   end procedure.
     3599   procedure xmllib-parse-rec-fld-open :
     3600   define input parameter p-rec-name   as character        no-undo.
     3601   define input parameter p-rec-level  as integer          no-undo.
     3602   define input parameter p-fld-name   as character        no-undo.
     3603       define buffer buf_temp_xmllib_rec       for temp_xmllib_rec.
     3604       define buffer buf_temp_xmllib_rec-fld   for temp_xmllib_rec-fld.
     3605   do
     3606   for buf_temp_xmllib_rec
     3607     , buf_temp_xmllib_rec-fld
     3608   on error undo, return error substitute( "Ошибка в xmllib-parse-rec-fld-open. &1. &2. &3"
     3609                                           , return-value
     3610                                           , trim( error-status :get-message( 1 ) )
     3611                                           , trim( error-status :get-message( 2 ) ) )
     3612   :
     3613       find last buf_temp_xmllib_rec
     3614           where buf_temp_xmllib_rec.recName   = p-rec-name
     3615             and buf_temp_xmllib_rec.recLevel  = p-rec-level
     3616             and buf_temp_xmllib_rec.closed    = no
     3617       use-index nm
     3618       no-error.
     3619       if not available buf_temp_xmllib_rec
     3620       then do:
     3621           run xmllib-parse-error in this-procedure (
     3622               input substitute( "Ошибка 2 открытия поля <&2> в записи <&1> уровня &3: Нет открытой записи."
     3623                               , p-rec-name
     3624                               , p-fld-name
     3625                               , p-rec-level
     3626                               )
     3627           ).
     3628       end.
     3629       else do:
     3630           find last buf_temp_xmllib_rec-fld
     3631               where buf_temp_xmllib_rec-fld.rec-key  = buf_temp_xmllib_rec.rec-key
     3632                 and buf_temp_xmllib_rec-fld.fldName  = p-fld-name
     3633                 and buf_temp_xmllib_rec-fld.closed   = no
     3634           use-index nm
     3635           no-error.
     3636           if available buf_temp_xmllib_rec-fld
     3637           then do:
     3638               run xmllib-parse-error in this-procedure (
     3639                   input substitute( "Ошибка 3 открытия поля <&2> в записи <&1>: Поле с этим именем уже открыто на строке &3."
     3640                                   , p-rec-name
     3641                                   , p-fld-name
     3642                                   , buf_temp_xmllib_rec-fld.fldOpenLine
     3643                                   )
     3644               ).
     3645           end.
     3646           else do:
     3647               assign
     3648                   v-xmllib-rec-fld-key    = v-xmllib-rec-fld-key + 1
     3649               .
     3650               create buf_temp_xmllib_rec-fld.
     3651               assign
     3652                   buf_temp_xmllib_rec-fld.fld-key         = v-xmllib-rec-fld-key
     3653                   buf_temp_xmllib_rec-fld.rec-key         = buf_temp_xmllib_rec.rec-key
     3654                   buf_temp_xmllib_rec-fld.fldOpenLine     = v-xmllib-sax-reader-handle :locator-line-number
     3655                   buf_temp_xmllib_rec-fld.fldCloseLine    = 0
     3656                   buf_temp_xmllib_rec-fld.fldName         = p-fld-name
     3657                   buf_temp_xmllib_rec-fld.closed          = no
     3658               .
     3659           end.
     3660       end.
     3661   end.
     3662   end procedure.
