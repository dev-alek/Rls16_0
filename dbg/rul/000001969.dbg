     3918                       when chr(10)
     3919                       then do:
     3920                           assign
     3921                               p-out-string = p-out-string + " ":U
     3922                           .
     3923                       end.
     3924                       when chr(13)
     3925                       then do:
     3926                           assign
     3927                               p-out-string = p-out-string + " ":U
     3928                           .
     3929                       end.
     3930                       otherwise do:
     3931                           assign
     3932                               p-out-string = p-out-string + v-current-char
     3933                           .
