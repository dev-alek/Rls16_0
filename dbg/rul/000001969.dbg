     3938       end case.
     3939   end.
     3940   end .
     3941   procedure xmlchar-decode :
     3942   define input parameter p-in-string      as character        no-undo.
     3943   define output parameter p-out-string    as character        no-undo.
     3944       define variable v-position      as integer      no-undo.
     3945       define variable v-last-position as integer      no-undo.
     3946       define variable v-temp-integer  as integer      no-undo.
     3947       define variable v-current-char  as character    no-undo.
     3948       define variable v-next-char     as character    no-undo.
     3949       define variable v-success       as logical      no-undo.
     3950   do
     3951   on error undo, return error
     3952   :
     3953       assign
     3954           p-out-string = "":U
     3955           v-position   = 0
     3956       .
     3957       replace-cycle:
     3958       do while yes
     3959       on error undo, return error
     3960       :
     3961           assign
     3962               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     3963           .
     3964           if v-last-position <= v-position
     3965           then do:
     3966               if v-position = 0
     3967               then do:
     3968                   assign
     3969                       p-out-string = p-in-string
     3970                   .
     3971               end.
     3972               else do:
     3973                   assign
     3974                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     3975                   .
     3976               end.
     3977               leave replace-cycle.
     3978           end.
     3979           else do:
     3980               assign
     3981                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     3982                   v-position      = v-last-position
     3983                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     3984               .
     3985               if v-current-char = "#":U
     3986               then do:
     3987                   assign
     3988                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     3989                   .
     3990                   if v-last-position > 0
     3991                   then do:
     3992                       run xmlchar-read-integer in this-procedure
     3993                        (
     3994                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     3995                           , output v-temp-integer
     3996                           , output v-success
     3997                       ).
     3998                       if v-success = yes
     3999                       and v-temp-integer >= 1
     4000                       and v-temp-integer <= 255
     4001                       then do:
     4002                           assign
     4003                               p-out-string = p-out-string + chr( v-temp-integer )
     4004                               v-position   = v-last-position + 1
     4005                           .
     4006                       end.
     4007                       else do:
     4008                           assign
     4009                               p-out-string = p-out-string + "&":U
     4010                               v-position   = v-position   + 1
     4011                           .
     4012                       end.
     4013                   end.
     4014                   else do:
     4015                       assign
     4016                           p-out-string = p-out-string + "&":U
     4017                           v-position   = v-position   + 1
     4018                       .
     4019                   end.
     4020               end.
     4021               else do:
     4022                   case substring( p-in-string, v-position + 1, 3 )
     4023                   :
     4024                       when "lt;":U
     4025                       then do:
     4026                           assign
     4027                               p-out-string = p-out-string + "<":U
     4028                               v-position   = v-position   + 3
     4029                           .
     4030                       end.
     4031                       when "gt;":U
     4032                       then do:
     4033                           assign
     4034                               p-out-string = p-out-string + ">":U
     4035                               v-position   = v-position   + 3
     4036                           .
     4037                       end.
     4038                       otherwise do:
     4039                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     4040                           then do:
     4041                               assign
     4042                                   p-out-string = p-out-string + "&":U
     4043                                   v-position   = v-position   + 4
     4044                               .
     4045                           end.
     4046                           else do:
     4047                               case substring( p-in-string, v-position + 1, 5 )
     4048                               :
     4049                                   when "quot;":U
     4050                                   then do:
     4051                                       assign
     4052                                           p-out-string = p-out-string + '"':U
     4053                                           v-position   = v-position   + 5
     4054                                       .
     4055                                   end.
     4056                                   when "apos;":U
     4057                                   then do:
     4058                                       assign
     4059                                           p-out-string = p-out-string + "'":U
     4060                                           v-position   = v-position   + 5
     4061                                       .
     4062                                   end.
     4063                                   otherwise do:
     4064                                       assign
     4065                                           p-out-string = p-out-string + "&":U
     4066                                       .
     4067                                   end.
     4068                               end case.
     4069                           end.
     4070                       end.
     4071                   end case.
     4072               end.
     4073           end.
     4074       end.
     4075   end.
     4076   end .
     4077   procedure xmlchar-read-integer :
     4078   define input parameter p-input-string      as character        no-undo.
     4079   define output parameter p-output-integer   as integer          no-undo.
     4080   define output parameter p-success       as logical          no-undo.
     4081   do
     4082   on error undo, return error
     4083   :
     4084       assign
     4085           p-output-integer = integer( p-input-string )
     4086       no-error.
     4087       if error-status :error
     4088       then do:
     4089           assign
     4090               p-success           = no
     4091               p-output-integer    = 0
     4092           .
     4093       end.
     4094       else do:
     4095           assign
     4096               p-success           = yes
     4097           .
     4098       end.
     4099   end.
     4100   end.
