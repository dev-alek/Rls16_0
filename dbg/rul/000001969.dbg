     3666   procedure xmlchar-test :
     3667   define input parameter p-in-string          as character        no-undo.
     3668   define output parameter p-out-string-enc    as character        no-undo.
     3669   define output parameter p-out-string-dec    as character        no-undo.
     3670   do
     3671   on error undo, return error
     3672   :
     3673          run xmlchar-encode in this-procedure
     3674       (
     3675             input p-in-string
     3676           , output p-out-string-enc
     3677       ).
     3678          run xmlchar-decode in this-procedure
     3679       (
     3680             input p-out-string-enc
     3681           , output p-out-string-dec
     3682       ).
     3683   end.
     3684   end .
     3685   procedure xmlchar-encode :
     3686   define input parameter p-in-string      as character        no-undo.
     3687   define output parameter p-out-string    as character        no-undo.
     3688       define variable v-position      as integer      no-undo.
     3689       define variable v-current-char  as character    no-undo.
     3690   do
     3691   on error undo, return error
     3692   :
     3693       assign
     3694           p-out-string = "":U
     3695       .
     3696       case p-in-string
     3697       :
     3698           when ?
     3699           then do:
     3700               assign
     3701                   p-out-string = "?":U
     3702               .
     3703           end.
     3704           when "?":U
     3705           then do:
     3706               assign
     3707                   p-out-string = "&#63;":U
     3708               .
     3709           end.
     3710           otherwise do:
     3711               do v-position = 1 to length( p-in-string )
     3712               :
     3713                   assign
     3714                       v-current-char = substring( p-in-string, v-position, 1 )
     3715                   .
     3716                   case v-current-char
     3717                   :
     3718                       when "&":U
     3719                       then do:
     3720                           assign
     3721                               p-out-string = p-out-string + "&amp;":U
     3722                           .
     3723                       end.
     3724                       when ">":U
     3725                       then do:
     3726                           assign
     3727                               p-out-string = p-out-string + "&gt;":U
     3728                           .
     3729                       end.
     3730                       when "<":U
     3731                       then do:
     3732                           assign
     3733                               p-out-string = p-out-string + "&lt;":U
     3734                           .
     3735                       end.
     3736                       when "'":U
     3737                       then do:
     3738                           assign
     3739                               p-out-string = p-out-string + "&apos;":U
     3740                           .
     3741                       end.
     3742                       when '"':U
     3743                       then do:
     3744                           assign
     3745                               p-out-string = p-out-string + "&quot;":U
     3746                           .
     3747                       end.
     3748                       when chr(1)
     3749                       then do:
     3750                           assign
     3751                               p-out-string = p-out-string + "":U
     3752                           .
     3753                       end.
     3754                       when chr(2)
     3755                       then do:
     3756                           assign
     3757                               p-out-string = p-out-string + "":U
     3758                           .
     3759                       end.
     3760                       when chr(3)
     3761                       then do:
     3762                           assign
     3763                               p-out-string = p-out-string + "":U
     3764                           .
     3765                       end.
     3766                       when chr(4)
     3767                       then do:
     3768                           assign
     3769                               p-out-string = p-out-string + "":U
     3770                           .
     3771                       end.
     3772                       when chr(5)
     3773                       then do:
     3774                           assign
     3775                               p-out-string = p-out-string + "":U
     3776                           .
     3777                       end.
     3778                       when chr(6)
     3779                       then do:
     3780                           assign
     3781                               p-out-string = p-out-string + "":U
     3782                           .
     3783                       end.
     3784                       when chr(7)
     3785                       then do:
     3786                           assign
     3787                               p-out-string = p-out-string + "":U
     3788                           .
     3789                       end.
     3790                       when chr(8)
     3791                       then do:
     3792                           assign
     3793                               p-out-string = p-out-string + "":U
     3794                           .
     3795                       end.
     3796                       when chr(9)
     3797                       then do:
     3798                           assign
     3799                               p-out-string = p-out-string + "":U
     3800                           .
     3801                       end.
     3802                       when chr(29)
     3803                       then do:
     3804                           assign
     3805                               p-out-string = p-out-string + "":U
     3806                           .
     3807                       end.
     3808                       when chr(10)
     3809                       then do:
     3810                           assign
     3811                               p-out-string = p-out-string + "&#10;":U
     3812                           .
     3813                       end.
     3814                       when chr(13)
     3815                       then do:
     3816                           assign
     3817                               p-out-string = p-out-string + "&#13;":U
     3818                           .
     3819                       end.
     3820                       otherwise do:
     3821                           assign
     3822                               p-out-string = p-out-string + v-current-char
     3823                           .
     3824                       end.
     3825                   end case.
     3826               end.
     3827           end.
     3828       end case.
     3829   end.
     3830   end .
     3831   procedure xmlchar-encode-1c :
