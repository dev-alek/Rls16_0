     2336   procedure get-header-by-rec :
     2337   define input  parameter p-gate-rec as character no-undo .
     2338   define output parameter p-tth as handle no-undo .
     2339   define variable v-ii as integer   no-undo .
     2340   define variable glog as logical   no-undo .
     2341   define variable v-rowid as rowid no-undo .
     2342   define variable v-tbl-name as character no-undo .
     2343   define variable v-longchar as longchar no-undo .
     2344   define variable v-txmlh as handle no-undo .
     2345   define buffer buf_clob-data for ub.clob-data.
     2346   main-block:
     2347   do
     2348   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info16, return-value, chr(10), error-status :get-message (1))
     2349   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info16 )
     2350   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info16 )
     2351   :
     2352     run gen-row-keyr in  this-procedure  (
     2353                                           input  p-gate-rec
     2354                                           ,input  ?
     2355                                           ,input  "ub"
     2356                                           ,input  ?
     2357                                           ,input  NO-LOCK
     2358                                           ,output v-rowid
     2359                                           ,output v-tbl-name   ) no-error.
     2360       find first buf_clob-data no-lock where
     2361                 rowid(buf_clob-data) = v-rowid  no-error.
     2362       if not available buf_clob-data then do:
     2363         undo, return error substitute("Не найден CLOB  &1"
     2364                                         , p-gate-rec
     2365                                         ).
     2366       end.
     2367       assign
     2368       v-longchar = buf_clob-data.cdata
     2369       .
     2370       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     2371       if error-status :error then do:
     2372         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     2373       end.
     2374       create temp-table p-tth .
     2375       glog = p-tth:READ-XMLSCHEMA( "LONGCHAR"
     2376                                     , v-longchar
     2377                                     , ?
     2378                                     , ?
     2379                                     , ?
     2380                                     ) no-error.
     2381       v-longchar = '':U.
     2382       define variable v-esm as character no-undo .
     2383       v-esm = error-status:get-message(1).
     2384       if error-status :error
     2385       or not glog
     2386       then do:
     2387         delete object p-tth no-error.
     2388         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     2389                                    , p-gate-rec
     2390                                    , buf_clob-data.file-name_
     2391                                    , chr(10)
     2392                                    , v-esm
     2393                                     ).
     2394       end.
     2395   end.
     2396   end procedure.
