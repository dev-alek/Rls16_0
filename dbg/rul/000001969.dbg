     4120   define variable v-file-name-no-ext as character no-undo .
     4121   define variable v-file-name-ext    as character no-undo .
     4122   define variable v-end-new-line     as logical no-undo .
     4123   define variable v-last-error-message as character no-undo .
     4124   define variable v-retry-action as integer no-undo .
     4125   define variable v_dataseth as handle no-undo .
     4126   define variable v-xmlh as handle no-undo .
     4127   define variable v_qh as handle no-undo .
     4128   define variable glog as logical no-undo .
     4129   define variable v-last-rec-ord as integer no-undo .
     4130   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4131   procedure set-error :
     4132   define input parameter p-mess as character no-undo .
     4133     do
     4134     on error undo, return error
     4135     :
     4136        assign
     4137        v-last-error-message = p-mess.
     4138     end.
     4139   end procedure.
     4140   define buffer buf_temp-cmd for temp-cmd.
     4141   define temp-table temp-gds-grp_ no-undo like ub.gds-grp.
     4142   define buffer buf_temp-xml-tables for temp-xml-tables.
     4143   define shared temp-table tt0-rule-call-param no-undo like ub.rule-call-param.
     4144   function 00130003_get-error-message returns character :
     4145   define variable v-ii as integer no-undo .
     4146   define variable v-mess as character no-undo .
     4147   DO v-ii = 1 TO ERROR-STATUS:NUM-MESSAGES:
     4148       v-mess = substitute("&1&2ош &3"
     4149                           ,v-mess
     4150                           ,chr(10)
     4151                           ,ERROR-STATUS:GET-MESSAGE(v-ii)).
     4152   END.
     4153   return v-mess.
     4154   end function.
     4155   function 00130003_after-import_f returns logical ( input p-d-card as character):
     4156     run 00130003_after-import in this-procedure ( input p-d-card) no-error.
     4157     run set-error in this-procedure ( input return-value ).
     4158     return not (error-status:error).
     4159   end function.
     4160   define variable p-xsd-file as character no-undo.
     4161   on delete of this-procedure do:
     4162     run delete-procedure in this-procedure .
     4163     run gate-clear in this-procedure ( input v_dataseth, input v-xmlh) no-error.
     4164   end.
     4165   run load-ruleset-context in this-procedure ( input p-ruleset-id) no-error .
     4166   if error-status:error
     4167   or return-value = "return" then return.
     4168   define variable ImpData1 as class Route-data_ no-undo .
     4169   ImpData1 = new Route-data_( input parparentproc, input p-parent-handle, input p-log-handle, input this-procedure:handle, input v_dataseth, input v-xmlh) .
     4170   if not this-procedure:persistent then do:
     4171     run proc-main in this-procedure no-error .
     4172     if error-status:error then do:
     4173         run delete-procedure in this-procedure .
     4174         undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     4175     end.
     4176     run delete-procedure in this-procedure .
     4177   end.
     4178   procedure proc-main :
     4179   define variable v-current-upper-node-code as integer no-undo .
     4180   define variable v-current-node-name as character no-undo .
     4181   define variable v-calc-method as character no-undo .
     4182   define variable v-increase-pc as decimal no-undo .
     4183   define variable v-print-code  as character no-undo .
     4184   define variable v-round-method as character no-undo .
     4185   define variable v-base as decimal no-undo .
     4186   define variable v-rid as recid no-undo .
     4187   _main:
     4188   do
     4189   on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4190   on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
     4191   on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
     4192   :
     4193   run write-log  in p-log-handle (
     4194                                    input 0
     4195                                  , "&DLine").
     4196   run write-log-and-file in p-log-handle (
     4197         input 1
     4198       , input log-file-name
     4199       , input 1
     4200       , input substitute("Импорт данных по группам товаров из файла &1", file-name)).
     4201   for each buf_temp-xml-tables where buf_temp-xml-tables.order >= 0:
     4202     if buf_temp-xml-tables.tbl-name = "THheader" then next.
     4203     create query v_qh.
     4204     glog = v_qh:set-buffers( buf_temp-xml-tables.tbl-handle_) no-error.
     4205     if error-status:error
     4206     or
     4207     not glog then do:
     4208       run write-log-and-file in p-log-handle (
     4209                                               input 1
     4210                                             , input log-file-name
     4211                                             , input 1
     4212                                             , input substitute("Ошибка при попытке получить записи &1&2&3&2&4"
     4213                                                               , buf_temp-xml-tables.tbl-name
     4214                                                               , chr(10)
     4215                                                               , error-status:get-message(1)
     4216                                                               , return-value)).
     4217       undo _main, return error ''.
     4218     end.
     4219     glog = v_qh:query-prepare( substitute( "for each &1 ", buf_temp-xml-tables.tbl-name)) no-error .
     4220     if error-status:error
     4221     or
     4222     not glog then do:
     4223       run write-log-and-file in p-log-handle (
     4224                                               input 1
     4225                                             , input log-file-name
     4226                                             , input 1
     4227                                             , input substitute("Ошибка при попытке получить записи &1&2&3&2&4"
     4228                                                               , buf_temp-xml-tables.tbl-name
     4229                                                               , chr(10)
     4230                                                               , error-status:get-message(1)
     4231                                                               , return-value)).
     4232       undo _main, return error ''.
     4233     end.
     4234     glog = v_qh:query-open no-error .
     4235     if error-status:error
     4236     or
     4237     not glog then do:
     4238       run write-log-and-file in p-log-handle (
     4239                                               input 1
     4240                                             , input log-file-name
     4241                                             , input 1
     4242                                             , input substitute("Ошибка при попытке получить записи &1&2&3&2&4"
     4243                                                               , buf_temp-xml-tables.tbl-name
     4244                                                               , chr(10)
     4245                                                               , error-status:get-message(1)
     4246                                                               , return-value)).
     4247       undo _main, return error ''.
     4248     end.
     4249       _stroka:
     4250       REPEAT:
     4251         num-rec = num-rec + 1.
     4252         v-retry-action = 0 .
     4253        _release:
     4254         do on error undo, retry:
     4255           if  retry then do:
     4256             v-retry-action = v-retry-action + 1.
     4257             run write-log-and-file in p-log-handle (
     4258                                                     input 1
     4259                                                   , input log-file-name
     4260                                                   , input 1
     4261                                                   , input substitute("Ошибка при импорте записи &5 &1&2&3&2&4"
     4262                                                                     , buf_temp-xml-tables.tbl-name
     4263                                                                     , num-rec
     4264                                                                     , chr(10)
     4265                                                                     , error-status:get-message(1)
     4266                                                                     , return-value)).
     4267           end.
     4268   if v-retry-action < 1 then do:
     4269   ImpData1:Route-data_dump ( ) .
     4270   end.
     4271         end.
     4272         _rule:
     4273          do on error undo _rule, retry _rule:
     4274            if retry then do:
     4275               run write-log-and-file in p-log-handle (
     4276                                                       input 1
     4277                                                     , input log-file-name
     4278                                                     , input 1
     4279                                                     , input substitute("&1&2&3"
     4280                                                                       , error-status:get-message(1)
     4281                                                                       , chr(10)
     4282                                                                       , return-value)).
     4283              next _stroka.
     4284            end.
     4285            else do:
     4286             v_qh:get-next().
     4287             IF v_qh:query-off-end then leave _stroka.
     4288             IF  ImpData1:current-tbl-name( ) = "gds-grp-01"  THEN do:
     4289               v-current-node-code = ImpData1:route-data_get-field-integer( input "gds-grp-01", input "node-code") .
     4290               v-current-upper-node-code = ImpData1:route-data_get-field-integer( input "gds-grp-01", input "upper-code") .
     4291               v-current-node-name = ImpData1:route-data_get-field-character( input "gds-grp-01", input "node-name") .
     4292               v-calc-method = ImpData1:route-data_get-field-character( input "gds-grp-01", input "calc-method") .
     4293               v-round-method = ImpData1:route-data_get-field-character( input "gds-grp-01", input "round-method") .
     4294               v-print-code = ImpData1:route-data_get-field-character( input "gds-grp-01", input "print-code") .
     4295               v-increase-pc = ImpData1:route-data_get-field-decimal( input "gds-grp-01", input "increase-pc") .
     4296               v-base = ImpData1:route-data_get-field-decimal( input "gds-grp-01", input "round-coef") .
     4297               run ref/gdsgrp01.p ( input 'ДОБАВЛЕНИЕ':U
     4298                                   ,input yes
     4299                                   ,input yes
     4300                                   ,input yes
     4301                                   ,input-output v-current-node-code
     4302                                   ,input-output v-current-upper-node-code
     4303                                   ,input v-current-node-name
     4304                                   ,input v-calc-method
     4305                                   ,input v-increase-pc
     4306                                   ,input v-print-code
     4307                                   ,input v-round-method
     4308                                   ,input v-base
     4309                                   ,output v-rid ) no-error.
     4310               if error-status:error then do:
     4311                 run write-log-and-file in p-log-handle (
     4312                                                         input 1
     4313                                                       , input log-file-name
     4314                                                       , input 1
     4315                                                       , input substitute("&1&2&3"
     4316                                                                         , error-status:get-message(1)
     4317                                                                         , chr(10)
     4318                                                                         , return-value)).
     4319                 next _stroka.
     4320               end.
     4321             end.
     4322           end.
     4323         end.
     4324         v-retry-action = 0 .
     4325        _release:
     4326         do on error undo, retry:
     4327           if  retry then do:
     4328             v-retry-action = v-retry-action + 1.
     4329             run write-log-and-file in p-log-handle (
     4330                                                     input 1
     4331                                                   , input log-file-name
     4332                                                   , input 1
     4333                                                   , input substitute("&1&2&3"
     4334                                                                     , error-status:get-message(1)
     4335                                                                     , chr(10)
     4336                                                                     , v-last-error-message )).
     4337           end.
     4338   if v-retry-action < 1 then do:
     4339   ImpData1:Route-data_dump ( ) .
     4340   end.
     4341         end.
     4342         if v-retry-action = 0 then do:
     4343           num-rec-ok = num-rec-ok + 1.
     4344         end.
     4345         run write-counter in p-log-handle ( input substitute("Обработано строк: &1, из них удачно: &2", num-rec, num-rec-ok)).
     4346         process events.
     4347         run get-stop-state in p-log-handle ( output v-stop) no-error .
     4348         if v-stop then do:
     4349             run write-log-and-file in p-log-handle (
     4350                                                     input 1
     4351                                                   , input log-file-name
     4352                                                   , input 1
     4353                                                   , input substitute("Процесс импорта прерван пользователем")).
     4354            leave _stroka.
     4355         end.
     4356       end.
     4357       if not v-stop then do:
     4358         num-rec = num-rec - 1.
     4359       end.
     4360       v_qh:query-close().
     4361       if valid-handle(v_qh) then do:
     4362         delete object v_qh.
     4363       end.
     4364     end.
     4365     run write-log-and-file in p-log-handle (
     4366           input 1
     4367         , input log-file-name
     4368         , input 1
     4369         , input substitute("Обработано строк: &1, из них удачно: &2", num-rec, num-rec-ok)).
     4370   end.
     4371   end procedure.
     4372   procedure load-ruleset-context :
     4373   define input parameter p-ruleset-id as integer no-undo .
     4374   define buffer buf_rule-call-param for tt0-rule-call-param.
     4375   do
     4376   on error undo, return error
     4377   :
     4378     find first buf_rule-call-param no-lock where
     4379   buf_rule-call-param.codex_id = p-codex-id
     4380   and buf_rule-call-param.ruleset_id = p-ruleset-id
     4381   and buf_rule-call-param.call_id = p-call-id
     4382   and buf_rule-call-param.order_id = p-order-id
     4383   and buf_rule-call-param.rule_id = p-rule-id
     4384   and buf_rule-call-param.param-name = "p-xsd-file"
     4385    no-error.
     4386   if available buf_rule-call-param then do:
     4387   assign p-xsd-file = buf_rule-call-param.param-value-character.
     4388   end.
     4389       case p-ruleset-id:
     4390         when 3 then do:
     4391           assign
     4392           v-sign = 1
     4393           v-current-host-code = p-host-code
     4394           v-current-obj-type = p-obj-type
     4395           v-current-obj-code = p-obj-code
     4396           v-current-db-num = g#db-num
     4397           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     4398           file-name  = entry(1, p-process-file-name, chr(4))
     4399           v-xmlh = buffer buf_temp-xml-tables:handle:table-handle:default-buffer-handle
     4400           .
     4401           run rul/rum-xmli.p  (
     4402                                input parparentproc
     4403                               ,input p-log-handle
     4404                               ,input file-name
     4405                               ,input p-profile-id
     4406                               ,input p-xsd-file
     4407                               ,input 0
     4408                               ,input 0
     4409                               ,input-output v_dataseth
     4410                               ,input-output v-xmlh
     4411                               ) no-error.
     4412           if error-status:error then do:
     4413             undo, return error substitute("&1&2&3"
     4414                                             , error-status:get-message(1)
     4415                                             , chr(10)
     4416                                             , return-value ).
     4417           end.
     4418           v-xmlh = buffer buf_temp-xml-tables:handle.
     4419         end.
     4420         otherwise do:
     4421           undo, return error "Неправильный вызов".
     4422         end.
     4423       end case.
     4424     end.
     4425   end procedure.
     4426   procedure create_gds-grp_:
     4427   define input parameter p-node-code as integer no-undo .
     4428   define buffer buf_temp-gds-grp_ for temp-gds-grp_.
     4429   find first buf_temp-gds-grp_ where
     4430             buf_temp-gds-grp_.node-code = p-node-code no-error .
     4431   if not available buf_temp-gds-grp_ then do:
     4432     create buf_temp-gds-grp_.
     4433     assign
     4434     buf_temp-gds-grp_.node-code = p-node-code
     4435     .
     4436   end.
     4437   end procedure.
     4438   procedure can-find_gds-grp_  :
     4439   define input parameter p-node-code as integer no-undo .
     4440   define output parameter p-find as logical no-undo .
     4441   find first temp-gds-grp_ where
     4442                        temp-gds-grp_.node-code = p-node-code no-error.
     4443   p-find = available temp-gds-grp_.
     4444   end procedure.
     4445   procedure delete-procedure :
     4446     do
     4447     on error undo, return error
     4448     :
     4449         for each temp-gds-grp_:
     4450           delete temp-gds-grp_.
     4451         end.
     4452         run garbcoll_clear in this-procedure .
     4453     end.
     4454   end procedure.
     4455   procedure 00130003_after-import :
     4456   define input  parameter p-node-code as integer no-undo .
     4457   define buffer buf_ggrp-list for ggrp-list.
     4458   find first buf_ggrp-list where buf_ggrp-list.node-code = p-node-code.
     4459   delete buf_ggrp-list.
     4460   end procedure.
